    );
}

export fn Compilerˉparseˉdataˉdeclaration(
    Input: bytes,
    Token: Compilerˉsourceˉtoken
) -> Compilerˉsourceˉdeclaration {
    let Afterˉkeyword: Compilerˉparseˉstep = Compilerˉparseˉconsume(Input, Token.Offset, Token.Line, Token.Column, Compilerˉtokenˉkind.Data);
    if Afterˉkeyword.Status != Compilerˉparseˉstatus.Valid {
        return Compilerˉsourceˉdeclarationˉfailure(Afterˉkeyword, Compilerˉsourceˉdeclarationˉkind.Data, false, Token.Offset, Token.Offset, 0u32);
    }
    let Name: Compilerˉsourceˉtoken = Compilerˉlexˉnextˉvalidated(Input, Afterˉkeyword.Nextˉoffset, Afterˉkeyword.Nextˉline, Afterˉkeyword.Nextˉcolumn);
    let Afterˉname: Compilerˉparseˉstep = Compilerˉparseˉconsume(Input, Afterˉkeyword.Nextˉoffset, Afterˉkeyword.Nextˉline, Afterˉkeyword.Nextˉcolumn, Compilerˉtokenˉkind.Identifier);
    if Afterˉname.Status != Compilerˉparseˉstatus.Valid {
        return Compilerˉsourceˉdeclarationˉfailure(Afterˉname, Compilerˉsourceˉdeclarationˉkind.Data, false, Token.Offset, Name.Offset, Name.Length);
    }
    let Afterˉcolon: Compilerˉparseˉstep = Compilerˉparseˉconsume(Input, Afterˉname.Nextˉoffset, Afterˉname.Nextˉline, Afterˉname.Nextˉcolumn, Compilerˉtokenˉkind.Colon);
    if Afterˉcolon.Status != Compilerˉparseˉstatus.Valid {
        return Compilerˉsourceˉdeclarationˉfailure(Afterˉcolon, Compilerˉsourceˉdeclarationˉkind.Data, false, Token.Offset, Name.Offset, Name.Length);
    }
    let Type: Compilerˉparseˉstep = Compilerˉparseˉtype(Input, Afterˉcolon.Nextˉoffset, Afterˉcolon.Nextˉline, Afterˉcolon.Nextˉcolumn, false, true);
    if Type.Status != Compilerˉparseˉstatus.Valid {
        return Compilerˉsourceˉdeclarationˉfailure(Type, Compilerˉsourceˉdeclarationˉkind.Data, false, Token.Offset, Name.Offset, Name.Length);
    }
    var Dataˉtypeˉvalid: bool = Type.Typeˉkind == Compilerˉsourceˉtypeˉkind.Text;
    if Type.Typeˉkind == Compilerˉsourceˉtypeˉkind.Bytes { Dataˉtypeˉvalid = true; }
    if Type.Typeˉkind == Compilerˉsourceˉtypeˉkind.I32ˉarray { Dataˉtypeˉvalid = true; }
    if !Dataˉtypeˉvalid {
        let Invalidˉdataˉtoken: Compilerˉsourceˉtoken = Compilerˉlexˉnextˉvalidated(Input, Afterˉcolon.Nextˉoffset, Afterˉcolon.Nextˉline, Afterˉcolon.Nextˉcolumn);
        let Invalidˉdataˉstep: Compilerˉparseˉstep = Compilerˉparseˉstepˉfromˉtoken(Compilerˉparseˉstatus.Invalidˉdataˉtype, Invalidˉdataˉtoken, Compilerˉtokenˉkind.Text);
        return Compilerˉsourceˉdeclarationˉfailure(Invalidˉdataˉstep, Compilerˉsourceˉdeclarationˉkind.Data, false, Token.Offset, Name.Offset, Name.Length);
    }
    let Afterˉequals: Compilerˉparseˉstep = Compilerˉparseˉconsume(Input, Type.Nextˉoffset, Type.Nextˉline, Type.Nextˉcolumn, Compilerˉtokenˉkind.Equals);
    if Afterˉequals.Status != Compilerˉparseˉstatus.Valid {
        return Compilerˉsourceˉdeclarationˉfailure(Afterˉequals, Compilerˉsourceˉdeclarationˉkind.Data, false, Token.Offset, Name.Offset, Name.Length);
    }
    let Valueˉstart: Compilerˉsourceˉtoken = Compilerˉlexˉnextˉvalidated(Input, Afterˉequals.Nextˉoffset, Afterˉequals.Nextˉline, Afterˉequals.Nextˉcolumn);
    var Value: Compilerˉparseˉstep = Compilerˉparseˉstepˉvalid(Afterˉequals.Nextˉoffset, Afterˉequals.Nextˉline, Afterˉequals.Nextˉcolumn, Type.Typeˉkind, 0u32);
    if Type.Typeˉkind == Compilerˉsourceˉtypeˉkind.Text {
        Value = Compilerˉparseˉconsume(Input, Afterˉequals.Nextˉoffset, Afterˉequals.Nextˉline, Afterˉequals.Nextˉcolumn, Compilerˉtokenˉkind.String);
    }
    if Type.Typeˉkind == Compilerˉsourceˉtypeˉkind.I32ˉarray {
        Value = Compilerˉparseˉi32ˉarray(Input, Afterˉequals.Nextˉoffset, Afterˉequals.Nextˉline, Afterˉequals.Nextˉcolumn);
    }
    if Type.Typeˉkind == Compilerˉsourceˉtypeˉkind.Bytes {
        Value = Compilerˉparseˉbytesˉarray(Input, Afterˉequals.Nextˉoffset, Afterˉequals.Nextˉline, Afterˉequals.Nextˉcolumn);
    }
    if Value.Status != Compilerˉparseˉstatus.Valid {
        return Compilerˉsourceˉdeclarationˉfailure(Value, Compilerˉsourceˉdeclarationˉkind.Data, false, Token.Offset, Name.Offset, Name.Length);
    }
    let End: Compilerˉparseˉstep = Compilerˉparseˉconsume(Input, Value.Nextˉoffset, Value.Nextˉline, Value.Nextˉcolumn, Compilerˉtokenˉkind.Semicolon);
    if End.Status != Compilerˉparseˉstatus.Valid {
        return Compilerˉsourceˉdeclarationˉfailure(End, Compilerˉsourceˉdeclarationˉkind.Data, false, Token.Offset, Name.Offset, Name.Length);
    }
    return Compilerˉsourceˉdeclarationˉmake(
        Compilerˉparseˉstatus.Valid,
        Compilerˉlexˉstatus.Valid,
        Compilerˉsourceˉdeclarationˉkind.Data,
        false,
        Name.Offset,
        Name.Length,
        Token.Offset,
        End.Nextˉoffset,
        Valueˉstart.Offset,
        Value.Nextˉoffset,
        Value.Items,
        End.Nextˉoffset,
        End.Nextˉline,
        End.Nextˉcolumn,
        End.Nextˉoffset,
        End.Nextˉline,
        End.Nextˉcolumn,
        Compilerˉtokenˉkind.End,
        Compilerˉtokenˉkind.End
    );
}

export fn Compilerˉparseˉrecordˉdeclaration(
    Input: bytes,
    Token: Compilerˉsourceˉtoken
) -> Compilerˉsourceˉdeclaration {
    let Afterˉkeyword: Compilerˉparseˉstep = Compilerˉparseˉconsume(Input, Token.Offset, Token.Line, Token.Column, Compilerˉtokenˉkind.Record);
    if Afterˉkeyword.Status != Compilerˉparseˉstatus.Valid { return Compilerˉsourceˉdeclarationˉfailure(Afterˉkeyword, Compilerˉsourceˉdeclarationˉkind.Record, false, Token.Offset, Token.Offset, 0u32); }
    let Name: Compilerˉsourceˉtoken = Compilerˉlexˉnextˉvalidated(Input, Afterˉkeyword.Nextˉoffset, Afterˉkeyword.Nextˉline, Afterˉkeyword.Nextˉcolumn);
    let Afterˉname: Compilerˉparseˉstep = Compilerˉparseˉconsume(Input, Afterˉkeyword.Nextˉoffset, Afterˉkeyword.Nextˉline, Afterˉkeyword.Nextˉcolumn, Compilerˉtokenˉkind.Identifier);
    if Afterˉname.Status != Compilerˉparseˉstatus.Valid { return Compilerˉsourceˉdeclarationˉfailure(Afterˉname, Compilerˉsourceˉdeclarationˉkind.Record, false, Token.Offset, Name.Offset, Name.Length); }
    let Bodyˉstart: Compilerˉsourceˉtoken = Compilerˉlexˉnextˉvalidated(Input, Afterˉname.Nextˉoffset, Afterˉname.Nextˉline, Afterˉname.Nextˉcolumn);
    let Afterˉbrace: Compilerˉparseˉstep = Compilerˉparseˉconsume(Input, Afterˉname.Nextˉoffset, Afterˉname.Nextˉline, Afterˉname.Nextˉcolumn, Compilerˉtokenˉkind.Leftˉbrace);
    if Afterˉbrace.Status != Compilerˉparseˉstatus.Valid { return Compilerˉsourceˉdeclarationˉfailure(Afterˉbrace, Compilerˉsourceˉdeclarationˉkind.Record, false, Token.Offset, Name.Offset, Name.Length); }
    var Cursor: u32 = Afterˉbrace.Nextˉoffset;
    var Currentˉline: u32 = Afterˉbrace.Nextˉline;
    var Currentˉcolumn: u32 = Afterˉbrace.Nextˉcolumn;
    var Fields: u32 = 0u32;
    var Reading: bool = true;
    while Reading {
        let Current: Compilerˉsourceˉtoken = Compilerˉlexˉnextˉvalidated(Input, Cursor, Currentˉline, Currentˉcolumn);
        if Current.Kind == Compilerˉtokenˉkind.Rightˉbrace {
            Reading = false;
        } else {
            let Fieldˉname: Compilerˉparseˉstep = Compilerˉparseˉconsume(Input, Cursor, Currentˉline, Currentˉcolumn, Compilerˉtokenˉkind.Identifier);
            if Fieldˉname.Status != Compilerˉparseˉstatus.Valid { return Compilerˉsourceˉdeclarationˉfailure(Fieldˉname, Compilerˉsourceˉdeclarationˉkind.Record, false, Token.Offset, Name.Offset, Name.Length); }
            let Fieldˉcolon: Compilerˉparseˉstep = Compilerˉparseˉconsume(Input, Fieldˉname.Nextˉoffset, Fieldˉname.Nextˉline, Fieldˉname.Nextˉcolumn, Compilerˉtokenˉkind.Colon);
            if Fieldˉcolon.Status != Compilerˉparseˉstatus.Valid { return Compilerˉsourceˉdeclarationˉfailure(Fieldˉcolon, Compilerˉsourceˉdeclarationˉkind.Record, false, Token.Offset, Name.Offset, Name.Length); }
            let Fieldˉtype: Compilerˉparseˉstep = Compilerˉparseˉtype(Input, Fieldˉcolon.Nextˉoffset, Fieldˉcolon.Nextˉline, Fieldˉcolon.Nextˉcolumn, false, false);
            if Fieldˉtype.Status != Compilerˉparseˉstatus.Valid { return Compilerˉsourceˉdeclarationˉfailure(Fieldˉtype, Compilerˉsourceˉdeclarationˉkind.Record, false, Token.Offset, Name.Offset, Name.Length); }
            let Fieldˉend: Compilerˉparseˉstep = Compilerˉparseˉconsume(Input, Fieldˉtype.Nextˉoffset, Fieldˉtype.Nextˉline, Fieldˉtype.Nextˉcolumn, Compilerˉtokenˉkind.Semicolon);
            if Fieldˉend.Status != Compilerˉparseˉstatus.Valid { return Compilerˉsourceˉdeclarationˉfailure(Fieldˉend, Compilerˉsourceˉdeclarationˉkind.Record, false, Token.Offset, Name.Offset, Name.Length); }
            Fields = Fields + 1u32;
            if Fields > 64u32 {
                let Fieldˉlimit: Compilerˉparseˉstep = Compilerˉparseˉstepˉfromˉtoken(Compilerˉparseˉstatus.Itemˉlimit, Current, Compilerˉtokenˉkind.Rightˉbrace);
                return Compilerˉsourceˉdeclarationˉfailure(Fieldˉlimit, Compilerˉsourceˉdeclarationˉkind.Record, false, Token.Offset, Name.Offset, Name.Length);
            }
            Cursor = Fieldˉend.Nextˉoffset;
            Currentˉline = Fieldˉend.Nextˉline;
            Currentˉcolumn = Fieldˉend.Nextˉcolumn;
        }
    }
    let End: Compilerˉparseˉstep = Compilerˉparseˉconsume(Input, Cursor, Currentˉline, Currentˉcolumn, Compilerˉtokenˉkind.Rightˉbrace);
    if End.Status != Compilerˉparseˉstatus.Valid { return Compilerˉsourceˉdeclarationˉfailure(End, Compilerˉsourceˉdeclarationˉkind.Record, false, Token.Offset, Name.Offset, Name.Length); }
