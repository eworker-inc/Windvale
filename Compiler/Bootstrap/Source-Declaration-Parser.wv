) -> Compilerˉsourceˉdeclaration {
    let Afterˉkeyword: Compilerˉparseˉstep = Compilerˉparseˉconsume(Input, Token.Offset, Token.Line, Token.Column, Compilerˉtokenˉkind.Enum);
    if Afterˉkeyword.Status != Compilerˉparseˉstatus.Valid { return Compilerˉsourceˉdeclarationˉfailure(Afterˉkeyword, Compilerˉsourceˉdeclarationˉkind.Enum, false, Token.Offset, Token.Offset, 0u32); }
    let Name: Compilerˉsourceˉtoken = Compilerˉlexˉnextˉvalidated(Input, Afterˉkeyword.Nextˉoffset, Afterˉkeyword.Nextˉline, Afterˉkeyword.Nextˉcolumn);
    let Afterˉname: Compilerˉparseˉstep = Compilerˉparseˉconsume(Input, Afterˉkeyword.Nextˉoffset, Afterˉkeyword.Nextˉline, Afterˉkeyword.Nextˉcolumn, Compilerˉtokenˉkind.Identifier);
    if Afterˉname.Status != Compilerˉparseˉstatus.Valid { return Compilerˉsourceˉdeclarationˉfailure(Afterˉname, Compilerˉsourceˉdeclarationˉkind.Enum, false, Token.Offset, Name.Offset, Name.Length); }
    let Bodyˉstart: Compilerˉsourceˉtoken = Compilerˉlexˉnextˉvalidated(Input, Afterˉname.Nextˉoffset, Afterˉname.Nextˉline, Afterˉname.Nextˉcolumn);
    let Afterˉbrace: Compilerˉparseˉstep = Compilerˉparseˉconsume(Input, Afterˉname.Nextˉoffset, Afterˉname.Nextˉline, Afterˉname.Nextˉcolumn, Compilerˉtokenˉkind.Leftˉbrace);
    if Afterˉbrace.Status != Compilerˉparseˉstatus.Valid { return Compilerˉsourceˉdeclarationˉfailure(Afterˉbrace, Compilerˉsourceˉdeclarationˉkind.Enum, false, Token.Offset, Name.Offset, Name.Length); }
    var Cursor: u32 = Afterˉbrace.Nextˉoffset;
    var Currentˉline: u32 = Afterˉbrace.Nextˉline;
    var Currentˉcolumn: u32 = Afterˉbrace.Nextˉcolumn;
    var Members: u32 = 0u32;
    var Reading: bool = true;
    while Reading {
        let Current: Compilerˉsourceˉtoken = Compilerˉlexˉnextˉvalidated(Input, Cursor, Currentˉline, Currentˉcolumn);
        if Current.Kind == Compilerˉtokenˉkind.Rightˉbrace {
            Reading = false;
        } else {
            let Memberˉname: Compilerˉparseˉstep = Compilerˉparseˉconsume(Input, Cursor, Currentˉline, Currentˉcolumn, Compilerˉtokenˉkind.Identifier);
            if Memberˉname.Status != Compilerˉparseˉstatus.Valid { return Compilerˉsourceˉdeclarationˉfailure(Memberˉname, Compilerˉsourceˉdeclarationˉkind.Enum, false, Token.Offset, Name.Offset, Name.Length); }
            let Memberˉequals: Compilerˉparseˉstep = Compilerˉparseˉconsume(Input, Memberˉname.Nextˉoffset, Memberˉname.Nextˉline, Memberˉname.Nextˉcolumn, Compilerˉtokenˉkind.Equals);
            if Memberˉequals.Status != Compilerˉparseˉstatus.Valid { return Compilerˉsourceˉdeclarationˉfailure(Memberˉequals, Compilerˉsourceˉdeclarationˉkind.Enum, false, Token.Offset, Name.Offset, Name.Length); }
            let Memberˉvalue: Compilerˉsourceˉtoken = Compilerˉlexˉnextˉvalidated(Input, Memberˉequals.Nextˉoffset, Memberˉequals.Nextˉline, Memberˉequals.Nextˉcolumn);
            let Afterˉvalue: Compilerˉparseˉstep = Compilerˉparseˉconsume(Input, Memberˉequals.Nextˉoffset, Memberˉequals.Nextˉline, Memberˉequals.Nextˉcolumn, Compilerˉtokenˉkind.Integer);
            if Afterˉvalue.Status != Compilerˉparseˉstatus.Valid { return Compilerˉsourceˉdeclarationˉfailure(Afterˉvalue, Compilerˉsourceˉdeclarationˉkind.Enum, false, Token.Offset, Name.Offset, Name.Length); }
            if Memberˉvalue.Numericˉkind != Compilerˉnumericˉkind.I32 {
                let Invalidˉmember: Compilerˉparseˉstep = Compilerˉparseˉstepˉfromˉtoken(Compilerˉparseˉstatus.Invalidˉliteral, Memberˉvalue, Compilerˉtokenˉkind.Integer);
                return Compilerˉsourceˉdeclarationˉfailure(Invalidˉmember, Compilerˉsourceˉdeclarationˉkind.Enum, false, Token.Offset, Name.Offset, Name.Length);
            }
            let Memberˉend: Compilerˉparseˉstep = Compilerˉparseˉconsume(Input, Afterˉvalue.Nextˉoffset, Afterˉvalue.Nextˉline, Afterˉvalue.Nextˉcolumn, Compilerˉtokenˉkind.Semicolon);
            if Memberˉend.Status != Compilerˉparseˉstatus.Valid { return Compilerˉsourceˉdeclarationˉfailure(Memberˉend, Compilerˉsourceˉdeclarationˉkind.Enum, false, Token.Offset, Name.Offset, Name.Length); }
            Members = Members + 1u32;
            if Members > 256u32 {
                let Memberˉlimit: Compilerˉparseˉstep = Compilerˉparseˉstepˉfromˉtoken(Compilerˉparseˉstatus.Itemˉlimit, Current, Compilerˉtokenˉkind.Rightˉbrace);
                return Compilerˉsourceˉdeclarationˉfailure(Memberˉlimit, Compilerˉsourceˉdeclarationˉkind.Enum, false, Token.Offset, Name.Offset, Name.Length);
            }
            Cursor = Memberˉend.Nextˉoffset;
            Currentˉline = Memberˉend.Nextˉline;
            Currentˉcolumn = Memberˉend.Nextˉcolumn;
        }
    }
    let End: Compilerˉparseˉstep = Compilerˉparseˉconsume(Input, Cursor, Currentˉline, Currentˉcolumn, Compilerˉtokenˉkind.Rightˉbrace);
    if End.Status != Compilerˉparseˉstatus.Valid { return Compilerˉsourceˉdeclarationˉfailure(End, Compilerˉsourceˉdeclarationˉkind.Enum, false, Token.Offset, Name.Offset, Name.Length); }
    return Compilerˉsourceˉdeclarationˉmake(Compilerˉparseˉstatus.Valid, Compilerˉlexˉstatus.Valid, Compilerˉsourceˉdeclarationˉkind.Enum, false, Name.Offset, Name.Length, Token.Offset, End.Nextˉoffset, Bodyˉstart.Offset, End.Nextˉoffset, Members, End.Nextˉoffset, End.Nextˉline, End.Nextˉcolumn, End.Nextˉoffset, End.Nextˉline, End.Nextˉcolumn, Compilerˉtokenˉkind.End, Compilerˉtokenˉkind.End);
}

export fn Compilerˉparseˉfunctionˉdeclaration(
    Input: bytes,
    Token: Compilerˉsourceˉtoken
) -> Compilerˉsourceˉdeclaration {
    var Isˉexported: bool = false;
    var Cursor: u32 = Token.Offset;
    var Currentˉline: u32 = Token.Line;
    var Currentˉcolumn: u32 = Token.Column;
    if Token.Kind == Compilerˉtokenˉkind.Export {
        Isˉexported = true;
        let Afterˉexport: Compilerˉparseˉstep = Compilerˉparseˉconsume(Input, Cursor, Currentˉline, Currentˉcolumn, Compilerˉtokenˉkind.Export);
        if Afterˉexport.Status != Compilerˉparseˉstatus.Valid { return Compilerˉsourceˉdeclarationˉfailure(Afterˉexport, Compilerˉsourceˉdeclarationˉkind.Function, true, Token.Offset, Token.Offset, 0u32); }
        Cursor = Afterˉexport.Nextˉoffset;
        Currentˉline = Afterˉexport.Nextˉline;
        Currentˉcolumn = Afterˉexport.Nextˉcolumn;
    }
    let Afterˉfn: Compilerˉparseˉstep = Compilerˉparseˉconsume(Input, Cursor, Currentˉline, Currentˉcolumn, Compilerˉtokenˉkind.Fn);
    if Afterˉfn.Status != Compilerˉparseˉstatus.Valid { return Compilerˉsourceˉdeclarationˉfailure(Afterˉfn, Compilerˉsourceˉdeclarationˉkind.Function, Isˉexported, Token.Offset, Token.Offset, 0u32); }
    let Name: Compilerˉsourceˉtoken = Compilerˉlexˉnextˉvalidated(Input, Afterˉfn.Nextˉoffset, Afterˉfn.Nextˉline, Afterˉfn.Nextˉcolumn);
    let Afterˉname: Compilerˉparseˉstep = Compilerˉparseˉconsume(Input, Afterˉfn.Nextˉoffset, Afterˉfn.Nextˉline, Afterˉfn.Nextˉcolumn, Compilerˉtokenˉkind.Identifier);
    if Afterˉname.Status != Compilerˉparseˉstatus.Valid { return Compilerˉsourceˉdeclarationˉfailure(Afterˉname, Compilerˉsourceˉdeclarationˉkind.Function, Isˉexported, Token.Offset, Name.Offset, Name.Length); }
    let Afterˉleft: Compilerˉparseˉstep = Compilerˉparseˉconsume(Input, Afterˉname.Nextˉoffset, Afterˉname.Nextˉline, Afterˉname.Nextˉcolumn, Compilerˉtokenˉkind.Leftˉparenthesis);
    if Afterˉleft.Status != Compilerˉparseˉstatus.Valid { return Compilerˉsourceˉdeclarationˉfailure(Afterˉleft, Compilerˉsourceˉdeclarationˉkind.Function, Isˉexported, Token.Offset, Name.Offset, Name.Length); }
    Cursor = Afterˉleft.Nextˉoffset;
    Currentˉline = Afterˉleft.Nextˉline;
    Currentˉcolumn = Afterˉleft.Nextˉcolumn;
    var Parameters: u32 = 0u32;
    var Reading: bool = true;
    while Reading {
        let Current: Compilerˉsourceˉtoken = Compilerˉlexˉnextˉvalidated(Input, Cursor, Currentˉline, Currentˉcolumn);
        if Current.Kind == Compilerˉtokenˉkind.Rightˉparenthesis {
            Reading = false;
        } else {
            let Parameterˉname: Compilerˉparseˉstep = Compilerˉparseˉconsume(Input, Cursor, Currentˉline, Currentˉcolumn, Compilerˉtokenˉkind.Identifier);
            if Parameterˉname.Status != Compilerˉparseˉstatus.Valid { return Compilerˉsourceˉdeclarationˉfailure(Parameterˉname, Compilerˉsourceˉdeclarationˉkind.Function, Isˉexported, Token.Offset, Name.Offset, Name.Length); }
            let Parameterˉcolon: Compilerˉparseˉstep = Compilerˉparseˉconsume(Input, Parameterˉname.Nextˉoffset, Parameterˉname.Nextˉline, Parameterˉname.Nextˉcolumn, Compilerˉtokenˉkind.Colon);
            if Parameterˉcolon.Status != Compilerˉparseˉstatus.Valid { return Compilerˉsourceˉdeclarationˉfailure(Parameterˉcolon, Compilerˉsourceˉdeclarationˉkind.Function, Isˉexported, Token.Offset, Name.Offset, Name.Length); }
            let Parameterˉtype: Compilerˉparseˉstep = Compilerˉparseˉtype(Input, Parameterˉcolon.Nextˉoffset, Parameterˉcolon.Nextˉline, Parameterˉcolon.Nextˉcolumn, false, false);
            if Parameterˉtype.Status != Compilerˉparseˉstatus.Valid { return Compilerˉsourceˉdeclarationˉfailure(Parameterˉtype, Compilerˉsourceˉdeclarationˉkind.Function, Isˉexported, Token.Offset, Name.Offset, Name.Length); }
            Parameters = Parameters + 1u32;
            if Parameters > 64u32 {
                let Parameterˉlimit: Compilerˉparseˉstep = Compilerˉparseˉstepˉfromˉtoken(Compilerˉparseˉstatus.Itemˉlimit, Current, Compilerˉtokenˉkind.Rightˉparenthesis);
                return Compilerˉsourceˉdeclarationˉfailure(Parameterˉlimit, Compilerˉsourceˉdeclarationˉkind.Function, Isˉexported, Token.Offset, Name.Offset, Name.Length);
            }
            Cursor = Parameterˉtype.Nextˉoffset;
            Currentˉline = Parameterˉtype.Nextˉline;
            Currentˉcolumn = Parameterˉtype.Nextˉcolumn;
            let Separator: Compilerˉsourceˉtoken = Compilerˉlexˉnextˉvalidated(Input, Cursor, Currentˉline, Currentˉcolumn);
            if Separator.Kind == Compilerˉtokenˉkind.Comma {
                Cursor = Separator.Nextˉoffset;
                Currentˉline = Separator.Nextˉline;
                Currentˉcolumn = Separator.Nextˉcolumn;
            } else {
                Reading = false;
            }
        }
    }
    let Afterˉright: Compilerˉparseˉstep = Compilerˉparseˉconsume(Input, Cursor, Currentˉline, Currentˉcolumn, Compilerˉtokenˉkind.Rightˉparenthesis);
    if Afterˉright.Status != Compilerˉparseˉstatus.Valid { return Compilerˉsourceˉdeclarationˉfailure(Afterˉright, Compilerˉsourceˉdeclarationˉkind.Function, Isˉexported, Token.Offset, Name.Offset, Name.Length); }
    let Afterˉarrow: Compilerˉparseˉstep = Compilerˉparseˉconsume(Input, Afterˉright.Nextˉoffset, Afterˉright.Nextˉline, Afterˉright.Nextˉcolumn, Compilerˉtokenˉkind.Arrow);
    if Afterˉarrow.Status != Compilerˉparseˉstatus.Valid { return Compilerˉsourceˉdeclarationˉfailure(Afterˉarrow, Compilerˉsourceˉdeclarationˉkind.Function, Isˉexported, Token.Offset, Name.Offset, Name.Length); }
    let Returnˉtype: Compilerˉparseˉstep = Compilerˉparseˉtype(Input, Afterˉarrow.Nextˉoffset, Afterˉarrow.Nextˉline, Afterˉarrow.Nextˉcolumn, true, false);
    if Returnˉtype.Status != Compilerˉparseˉstatus.Valid { return Compilerˉsourceˉdeclarationˉfailure(Returnˉtype, Compilerˉsourceˉdeclarationˉkind.Function, Isˉexported, Token.Offset, Name.Offset, Name.Length); }
    let Bodyˉstart: Compilerˉsourceˉtoken = Compilerˉlexˉnextˉvalidated(Input, Returnˉtype.Nextˉoffset, Returnˉtype.Nextˉline, Returnˉtype.Nextˉcolumn);
    let Body: Compilerˉparseˉstep = Compilerˉparseˉskipˉblock(Input, Returnˉtype.Nextˉoffset, Returnˉtype.Nextˉline, Returnˉtype.Nextˉcolumn);
    if Body.Status != Compilerˉparseˉstatus.Valid { return Compilerˉsourceˉdeclarationˉfailure(Body, Compilerˉsourceˉdeclarationˉkind.Function, Isˉexported, Token.Offset, Name.Offset, Name.Length); }
    return Compilerˉsourceˉdeclarationˉmake(Compilerˉparseˉstatus.Valid, Compilerˉlexˉstatus.Valid, Compilerˉsourceˉdeclarationˉkind.Function, Isˉexported, Name.Offset, Name.Length, Token.Offset, Body.Nextˉoffset, Bodyˉstart.Offset, Body.Nextˉoffset, Parameters, Body.Nextˉoffset, Body.Nextˉline, Body.Nextˉcolumn, Body.Nextˉoffset, Body.Nextˉline, Body.Nextˉcolumn, Compilerˉtokenˉkind.End, Compilerˉtokenˉkind.End);
}

export fn Compilerˉparseˉheaderˉvalidated(Input: bytes) -> Compilerˉsourceˉheader {
    let Afterˉmodule: Compilerˉparseˉstep = Compilerˉparseˉconsume(Input, 0u32, 1u32, 1u32, Compilerˉtokenˉkind.Module);
    if Afterˉmodule.Status != Compilerˉparseˉstatus.Valid {
        return Compilerˉsourceˉheader(Afterˉmodule.Status, Afterˉmodule.Lexicalˉstatus, Compilerˉsourceˉprofile.None, 0u32, 0u32, Afterˉmodule.Nextˉoffset, Afterˉmodule.Nextˉline, Afterˉmodule.Nextˉcolumn, Afterˉmodule.Failureˉoffset, Afterˉmodule.Failureˉline, Afterˉmodule.Failureˉcolumn, Afterˉmodule.Expected, Afterˉmodule.Found);
    }
    let Name: Compilerˉsourceˉtoken = Compilerˉlexˉnextˉvalidated(Input, Afterˉmodule.Nextˉoffset, Afterˉmodule.Nextˉline, Afterˉmodule.Nextˉcolumn);
    let Afterˉname: Compilerˉparseˉstep = Compilerˉparseˉconsume(Input, Afterˉmodule.Nextˉoffset, Afterˉmodule.Nextˉline, Afterˉmodule.Nextˉcolumn, Compilerˉtokenˉkind.Identifier);
    if Afterˉname.Status != Compilerˉparseˉstatus.Valid {
        return Compilerˉsourceˉheader(Afterˉname.Status, Afterˉname.Lexicalˉstatus, Compilerˉsourceˉprofile.None, Name.Offset, Name.Length, Afterˉname.Nextˉoffset, Afterˉname.Nextˉline, Afterˉname.Nextˉcolumn, Afterˉname.Failureˉoffset, Afterˉname.Failureˉline, Afterˉname.Failureˉcolumn, Afterˉname.Expected, Afterˉname.Found);
    }
    let Afterˉprofile: Compilerˉparseˉstep = Compilerˉparseˉconsume(Input, Afterˉname.Nextˉoffset, Afterˉname.Nextˉline, Afterˉname.Nextˉcolumn, Compilerˉtokenˉkind.Profile);
    if Afterˉprofile.Status != Compilerˉparseˉstatus.Valid {
        return Compilerˉsourceˉheader(Afterˉprofile.Status, Afterˉprofile.Lexicalˉstatus, Compilerˉsourceˉprofile.None, Name.Offset, Name.Length, Afterˉprofile.Nextˉoffset, Afterˉprofile.Nextˉline, Afterˉprofile.Nextˉcolumn, Afterˉprofile.Failureˉoffset, Afterˉprofile.Failureˉline, Afterˉprofile.Failureˉcolumn, Afterˉprofile.Expected, Afterˉprofile.Found);
    }
    let Profileˉtoken: Compilerˉsourceˉtoken = Compilerˉlexˉnextˉvalidated(Input, Afterˉprofile.Nextˉoffset, Afterˉprofile.Nextˉline, Afterˉprofile.Nextˉcolumn);
    var Profile: Compilerˉsourceˉprofile = Compilerˉsourceˉprofile.None;
    if Profileˉtoken.Kind == Compilerˉtokenˉkind.Portable { Profile = Compilerˉsourceˉprofile.Portable; }
    if Profileˉtoken.Kind == Compilerˉtokenˉkind.Hosted { Profile = Compilerˉsourceˉprofile.Hosted; }
    if Profileˉtoken.Kind == Compilerˉtokenˉkind.System { Profile = Compilerˉsourceˉprofile.System; }
    if Profile == Compilerˉsourceˉprofile.None {
        let Badˉprofile: Compilerˉparseˉstep = Compilerˉparseˉstepˉfromˉtoken(Compilerˉparseˉstatus.Invalidˉprofile, Profileˉtoken, Compilerˉtokenˉkind.Portable);
        return Compilerˉsourceˉheader(Badˉprofile.Status, Badˉprofile.Lexicalˉstatus, Profile, Name.Offset, Name.Length, Badˉprofile.Nextˉoffset, Badˉprofile.Nextˉline, Badˉprofile.Nextˉcolumn, Badˉprofile.Failureˉoffset, Badˉprofile.Failureˉline, Badˉprofile.Failureˉcolumn, Badˉprofile.Expected, Badˉprofile.Found);
    }
    let End: Compilerˉparseˉstep = Compilerˉparseˉconsume(Input, Profileˉtoken.Nextˉoffset, Profileˉtoken.Nextˉline, Profileˉtoken.Nextˉcolumn, Compilerˉtokenˉkind.Semicolon);
    if End.Status != Compilerˉparseˉstatus.Valid {
        return Compilerˉsourceˉheader(End.Status, End.Lexicalˉstatus, Profile, Name.Offset, Name.Length, End.Nextˉoffset, End.Nextˉline, End.Nextˉcolumn, End.Failureˉoffset, End.Failureˉline, End.Failureˉcolumn, End.Expected, End.Found);
    }
    return Compilerˉsourceˉheader(Compilerˉparseˉstatus.Valid, Compilerˉlexˉstatus.Valid, Profile, Name.Offset, Name.Length, End.Nextˉoffset, End.Nextˉline, End.Nextˉcolumn, End.Nextˉoffset, End.Nextˉline, End.Nextˉcolumn, Compilerˉtokenˉkind.End, Compilerˉtokenˉkind.End);
}

export fn Compilerˉparseˉheader(Input: bytes) -> Compilerˉsourceˉheader {
    let Scan: Compilerˉsourceˉscan = Compilerˉlexˉsource(Input);
    if Scan.Status != Compilerˉlexˉstatus.Valid {
        return Compilerˉsourceˉheader(Compilerˉparseˉstatus.Lexicalˉerror, Scan.Status, Compilerˉsourceˉprofile.None, 0u32, 0u32, Scan.Endˉoffset, Scan.Endˉline, Scan.Endˉcolumn, Scan.Failureˉoffset, Scan.Failureˉline, Scan.Failureˉcolumn, Compilerˉtokenˉkind.End, Compilerˉtokenˉkind.Bad);
    }
    return Compilerˉparseˉheaderˉvalidated(Input);
}

export fn Compilerˉparseˉnextˉdeclarationˉvalidated(
    Input: bytes,
    Offset: u32,
    Line: u32,
    Column: u32,
    Sawˉnonˉimport: bool
) -> Compilerˉsourceˉdeclaration {
    let Token: Compilerˉsourceˉtoken = Compilerˉlexˉnextˉvalidated(Input, Offset, Line, Column);
    if Token.Status != Compilerˉlexˉstatus.Valid {
        let Lexical: Compilerˉparseˉstep = Compilerˉparseˉstepˉfromˉtoken(Compilerˉparseˉstatus.Lexicalˉerror, Token, Compilerˉtokenˉkind.End);
        return Compilerˉsourceˉdeclarationˉfailure(Lexical, Compilerˉsourceˉdeclarationˉkind.End, false, Offset, Offset, 0u32);
    }
    if Token.Kind == Compilerˉtokenˉkind.End {
        return Compilerˉsourceˉdeclarationˉmake(Compilerˉparseˉstatus.Valid, Compilerˉlexˉstatus.Valid, Compilerˉsourceˉdeclarationˉkind.End, false, Token.Offset, 0u32, Token.Offset, Token.Offset, Token.Offset, Token.Offset, 0u32, Token.Nextˉoffset, Token.Nextˉline, Token.Nextˉcolumn, Token.Offset, Token.Line, Token.Column, Compilerˉtokenˉkind.End, Compilerˉtokenˉkind.End);
    }
    if Token.Kind == Compilerˉtokenˉkind.Import {
        if Sawˉnonˉimport {
            let Late: Compilerˉparseˉstep = Compilerˉparseˉstepˉfromˉtoken(Compilerˉparseˉstatus.Importˉafterˉdeclaration, Token, Compilerˉtokenˉkind.End);
            return Compilerˉsourceˉdeclarationˉfailure(Late, Compilerˉsourceˉdeclarationˉkind.Import, false, Token.Offset, Token.Offset, 0u32);
        }
        return Compilerˉparseˉimportˉdeclaration(Input, Token);
    }
    if Token.Kind == Compilerˉtokenˉkind.Capability { return Compilerˉparseˉcapabilityˉdeclaration(Input, Token); }
    if Token.Kind == Compilerˉtokenˉkind.Data { return Compilerˉparseˉdataˉdeclaration(Input, Token); }
    if Token.Kind == Compilerˉtokenˉkind.Record { return Compilerˉparseˉrecordˉdeclaration(Input, Token); }
    if Token.Kind == Compilerˉtokenˉkind.Enum { return Compilerˉparseˉenumˉdeclaration(Input, Token); }
    if Token.Kind == Compilerˉtokenˉkind.Export { return Compilerˉparseˉfunctionˉdeclaration(Input, Token); }
    if Token.Kind == Compilerˉtokenˉkind.Fn { return Compilerˉparseˉfunctionˉdeclaration(Input, Token); }
    let Unexpected: Compilerˉparseˉstep = Compilerˉparseˉstepˉfromˉtoken(Compilerˉparseˉstatus.Unexpectedˉdeclaration, Token, Compilerˉtokenˉkind.Import);
    return Compilerˉsourceˉdeclarationˉfailure(Unexpected, Compilerˉsourceˉdeclarationˉkind.End, false, Token.Offset, Token.Offset, 0u32);
}

export fn Compilerˉparseˉnextˉdeclaration(
    Input: bytes,
    Offset: u32,
    Line: u32,
    Column: u32,
    Sawˉnonˉimport: bool
) -> Compilerˉsourceˉdeclaration {
    let Scan: Compilerˉsourceˉscan = Compilerˉlexˉsource(Input);
    if Scan.Status != Compilerˉlexˉstatus.Valid {
        let Lexical: Compilerˉparseˉstep = Compilerˉparseˉstepˉfailure(Compilerˉparseˉstatus.Lexicalˉerror, Scan.Status, Scan.Failureˉoffset, Scan.Failureˉline, Scan.Failureˉcolumn, Compilerˉtokenˉkind.End, Compilerˉtokenˉkind.Bad);
        return Compilerˉsourceˉdeclarationˉfailure(Lexical, Compilerˉsourceˉdeclarationˉkind.End, false, Offset, Offset, 0u32);
    }
    return Compilerˉparseˉnextˉdeclarationˉvalidated(Input, Offset, Line, Column, Sawˉnonˉimport);
}

export fn Compilerˉsourceˉsummaryˉfromˉfailure(
    Header: Compilerˉsourceˉheader,
    Declaration: Compilerˉsourceˉdeclaration,
    Imports: u32,
    Capabilities: u32,
    Data: u32,
    Records: u32,
    Enums: u32,
    Functions: u32,
    Tokens: u32
) -> Compilerˉsourceˉmoduleˉsummary {
    return Compilerˉsourceˉmoduleˉsummary(
        Declaration.Status,
        Declaration.Lexicalˉstatus,
        Header.Profile,
        Header.Nameˉoffset,
        Header.Nameˉlength,
        Imports,
        Capabilities,
        Data,
        Records,
        Enums,
        Functions,
        Tokens,
        Declaration.Nextˉoffset,
        Declaration.Nextˉline,
        Declaration.Nextˉcolumn,
        Declaration.Failureˉoffset,
        Declaration.Failureˉline,
        Declaration.Failureˉcolumn,
        Declaration.Expected,
        Declaration.Found
    );
}

export fn Compilerˉparseˉsource(Input: bytes) -> Compilerˉsourceˉmoduleˉsummary {
    let Scan: Compilerˉsourceˉscan = Compilerˉlexˉsource(Input);
    if Scan.Status != Compilerˉlexˉstatus.Valid {
        return Compilerˉsourceˉmoduleˉsummary(Compilerˉparseˉstatus.Lexicalˉerror, Scan.Status, Compilerˉsourceˉprofile.None, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32, Scan.Tokens, Scan.Endˉoffset, Scan.Endˉline, Scan.Endˉcolumn, Scan.Failureˉoffset, Scan.Failureˉline, Scan.Failureˉcolumn, Compilerˉtokenˉkind.End, Compilerˉtokenˉkind.Bad);
    }
    let Header: Compilerˉsourceˉheader = Compilerˉparseˉheaderˉvalidated(Input);
    if Header.Status != Compilerˉparseˉstatus.Valid {
        return Compilerˉsourceˉmoduleˉsummary(Header.Status, Header.Lexicalˉstatus, Header.Profile, Header.Nameˉoffset, Header.Nameˉlength, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32, Scan.Tokens, Header.Nextˉoffset, Header.Nextˉline, Header.Nextˉcolumn, Header.Failureˉoffset, Header.Failureˉline, Header.Failureˉcolumn, Header.Expected, Header.Found);
    }
    var Cursor: u32 = Header.Nextˉoffset;
    var Currentˉline: u32 = Header.Nextˉline;
    var Currentˉcolumn: u32 = Header.Nextˉcolumn;
    var Imports: u32 = 0u32;
    var Capabilities: u32 = 0u32;
    var Data: u32 = 0u32;
    var Records: u32 = 0u32;
    var Enums: u32 = 0u32;
    var Functions: u32 = 0u32;
    var Declarations: u32 = 0u32;
    var Sawˉnonˉimport: bool = false;
    var Reading: bool = true;
    while Reading {
        let Declaration: Compilerˉsourceˉdeclaration = Compilerˉparseˉnextˉdeclarationˉvalidated(Input, Cursor, Currentˉline, Currentˉcolumn, Sawˉnonˉimport);
        if Declaration.Status != Compilerˉparseˉstatus.Valid {
            return Compilerˉsourceˉsummaryˉfromˉfailure(Header, Declaration, Imports, Capabilities, Data, Records, Enums, Functions, Scan.Tokens);
        }
        if Declaration.Kind == Compilerˉsourceˉdeclarationˉkind.End {
            Reading = false;
        } else {
            Declarations = Declarations + 1u32;
            if Declarations > 4096u32 {
                let Limitˉstep: Compilerˉparseˉstep = Compilerˉparseˉstepˉfailure(Compilerˉparseˉstatus.Itemˉlimit, Compilerˉlexˉstatus.Valid, Declaration.Declarationˉoffset, Declaration.Failureˉline, Declaration.Failureˉcolumn, Compilerˉtokenˉkind.End, Declaration.Found);
                let Limitˉdeclaration: Compilerˉsourceˉdeclaration = Compilerˉsourceˉdeclarationˉfailure(Limitˉstep, Declaration.Kind, Declaration.Isˉexported, Declaration.Declarationˉoffset, Declaration.Nameˉoffset, Declaration.Nameˉlength);
                return Compilerˉsourceˉsummaryˉfromˉfailure(Header, Limitˉdeclaration, Imports, Capabilities, Data, Records, Enums, Functions, Scan.Tokens);
            }
            if Declaration.Kind == Compilerˉsourceˉdeclarationˉkind.Import { Imports = Imports + 1u32; }
            if Declaration.Kind == Compilerˉsourceˉdeclarationˉkind.Capability { Capabilities = Capabilities + 1u32; }
            if Declaration.Kind == Compilerˉsourceˉdeclarationˉkind.Data { Data = Data + 1u32; }
            if Declaration.Kind == Compilerˉsourceˉdeclarationˉkind.Record { Records = Records + 1u32; }
            if Declaration.Kind == Compilerˉsourceˉdeclarationˉkind.Enum { Enums = Enums + 1u32; }
            if Declaration.Kind == Compilerˉsourceˉdeclarationˉkind.Function { Functions = Functions + 1u32; }
            if Declaration.Kind != Compilerˉsourceˉdeclarationˉkind.Import { Sawˉnonˉimport = true; }
            Cursor = Declaration.Nextˉoffset;
            Currentˉline = Declaration.Nextˉline;
            Currentˉcolumn = Declaration.Nextˉcolumn;
        }
    }
    return Compilerˉsourceˉmoduleˉsummary(Compilerˉparseˉstatus.Valid, Compilerˉlexˉstatus.Valid, Header.Profile, Header.Nameˉoffset, Header.Nameˉlength, Imports, Capabilities, Data, Records, Enums, Functions, Scan.Tokens, Cursor, Currentˉline, Currentˉcolumn, Cursor, Currentˉline, Currentˉcolumn, Compilerˉtokenˉkind.End, Compilerˉtokenˉkind.End);
}

export fn Compilerˉparseˉdeclarationˉat(
    Input: bytes,
    Wanted: u32
) -> Compilerˉsourceˉdeclaration {
    let Header: Compilerˉsourceˉheader = Compilerˉparseˉheader(Input);
    if Header.Status != Compilerˉparseˉstatus.Valid {
        let Failure: Compilerˉparseˉstep = Compilerˉparseˉstepˉfailure(Header.Status, Header.Lexicalˉstatus, Header.Failureˉoffset, Header.Failureˉline, Header.Failureˉcolumn, Header.Expected, Header.Found);
        return Compilerˉsourceˉdeclarationˉfailure(Failure, Compilerˉsourceˉdeclarationˉkind.End, false, Header.Failureˉoffset, Header.Failureˉoffset, 0u32);
    }
    var Cursor: u32 = Header.Nextˉoffset;
    var Currentˉline: u32 = Header.Nextˉline;
    var Currentˉcolumn: u32 = Header.Nextˉcolumn;
    var Sawˉnonˉimport: bool = false;
    var Index: u32 = 0u32;
    var Declaration: Compilerˉsourceˉdeclaration = Compilerˉparseˉnextˉdeclarationˉvalidated(Input, Cursor, Currentˉline, Currentˉcolumn, Sawˉnonˉimport);
    while Index < Wanted {
        if Declaration.Status != Compilerˉparseˉstatus.Valid { return Declaration; }
        if Declaration.Kind == Compilerˉsourceˉdeclarationˉkind.End { return Declaration; }
        if Declaration.Kind != Compilerˉsourceˉdeclarationˉkind.Import { Sawˉnonˉimport = true; }
        Cursor = Declaration.Nextˉoffset;
        Currentˉline = Declaration.Nextˉline;
        Currentˉcolumn = Declaration.Nextˉcolumn;
        Declaration = Compilerˉparseˉnextˉdeclarationˉvalidated(Input, Cursor, Currentˉline, Currentˉcolumn, Sawˉnonˉimport);
        Index = Index + 1u32;
    }
    return Declaration;
}
