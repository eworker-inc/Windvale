module Compilerˉsourceˉdeclarationˉparser profile portable;

import Compilerˉsourceˉlexer;

enum Compilerˉparseˉstatus {
    Valid = 0;
    Lexicalˉerror = 1;
    Expectedˉtoken = 2;
    Invalidˉprofile = 3;
    Importˉafterˉdeclaration = 4;
    Unexpectedˉdeclaration = 5;
    Invalidˉtype = 6;
    Invalidˉdataˉtype = 7;
    Invalidˉliteral = 8;
    Nestingˉlimit = 9;
    Itemˉlimit = 10;
}

enum Compilerˉsourceˉprofile {
    None = 0;
    Portable = 1;
    Hosted = 2;
    System = 3;
}

enum Compilerˉsourceˉtypeˉkind {
    Unknown = 0;
    I32 = 1;
    U8 = 2;
    U32 = 3;
    Bool = 4;
    Text = 5;
    Bytes = 6;
    Void = 7;
    Named = 8;
    I32ˉarray = 9;
}

enum Compilerˉsourceˉdeclarationˉkind {
    End = 0;
    Import = 1;
    Capability = 2;
    Data = 3;
    Record = 4;
    Enum = 5;
    Function = 6;
}

record Compilerˉparseˉstep {
    Status: Compilerˉparseˉstatus;
    Lexicalˉstatus: Compilerˉlexˉstatus;
    Nextˉoffset: u32;
    Nextˉline: u32;
    Nextˉcolumn: u32;
    Failureˉoffset: u32;
    Failureˉline: u32;
    Failureˉcolumn: u32;
    Expected: Compilerˉtokenˉkind;
    Found: Compilerˉtokenˉkind;
    Typeˉkind: Compilerˉsourceˉtypeˉkind;
    Items: u32;
}

record Compilerˉsourceˉheader {
    Status: Compilerˉparseˉstatus;
    Lexicalˉstatus: Compilerˉlexˉstatus;
    Profile: Compilerˉsourceˉprofile;
    Nameˉoffset: u32;
    Nameˉlength: u32;
    Nextˉoffset: u32;
    Nextˉline: u32;
    Nextˉcolumn: u32;
    Failureˉoffset: u32;
    Failureˉline: u32;
    Failureˉcolumn: u32;
    Expected: Compilerˉtokenˉkind;
    Found: Compilerˉtokenˉkind;
}

record Compilerˉsourceˉdeclaration {
    Status: Compilerˉparseˉstatus;
    Lexicalˉstatus: Compilerˉlexˉstatus;
    Kind: Compilerˉsourceˉdeclarationˉkind;
    Isˉexported: bool;
    Nameˉoffset: u32;
    Nameˉlength: u32;
    Declarationˉoffset: u32;
    Declarationˉlength: u32;
    Bodyˉoffset: u32;
    Bodyˉlength: u32;
    Items: u32;
    Nextˉoffset: u32;
    Nextˉline: u32;
    Nextˉcolumn: u32;
    Failureˉoffset: u32;
    Failureˉline: u32;
    Failureˉcolumn: u32;
    Expected: Compilerˉtokenˉkind;
    Found: Compilerˉtokenˉkind;
}

record Compilerˉsourceˉmoduleˉsummary {
    Status: Compilerˉparseˉstatus;
    Lexicalˉstatus: Compilerˉlexˉstatus;
    Profile: Compilerˉsourceˉprofile;
    Nameˉoffset: u32;
    Nameˉlength: u32;
    Imports: u32;
    Capabilities: u32;
    Data: u32;
    Records: u32;
    Enums: u32;
    Functions: u32;
    Tokens: u32;
    Endˉoffset: u32;
    Endˉline: u32;
    Endˉcolumn: u32;
    Failureˉoffset: u32;
    Failureˉline: u32;
    Failureˉcolumn: u32;
    Expected: Compilerˉtokenˉkind;
    Found: Compilerˉtokenˉkind;
}

export fn Compilerˉparseˉstepˉvalid(
    Offset: u32,
    Line: u32,
    Column: u32,
    Typeˉkind: Compilerˉsourceˉtypeˉkind,
    Items: u32
) -> Compilerˉparseˉstep {
    return Compilerˉparseˉstep(
        Compilerˉparseˉstatus.Valid,
        Compilerˉlexˉstatus.Valid,
        Offset,
        Line,
        Column,
        Offset,
        Line,
        Column,
        Compilerˉtokenˉkind.End,
        Compilerˉtokenˉkind.End,
        Typeˉkind,
        Items
    );
}

export fn Compilerˉparseˉstepˉfailure(
    Status: Compilerˉparseˉstatus,
    Lexicalˉstatus: Compilerˉlexˉstatus,
    Offset: u32,
    Line: u32,
    Column: u32,
    Expected: Compilerˉtokenˉkind,
    Found: Compilerˉtokenˉkind
) -> Compilerˉparseˉstep {
    return Compilerˉparseˉstep(
        Status,
        Lexicalˉstatus,
        Offset,
        Line,
        Column,
        Offset,
        Line,
        Column,
        Expected,
        Found,
        Compilerˉsourceˉtypeˉkind.Unknown,
        0u32
    );
}

export fn Compilerˉparseˉstepˉfromˉtoken(
    Status: Compilerˉparseˉstatus,
    Token: Compilerˉsourceˉtoken,
    Expected: Compilerˉtokenˉkind
) -> Compilerˉparseˉstep {
    if Token.Status != Compilerˉlexˉstatus.Valid {
        return Compilerˉparseˉstepˉfailure(
            Compilerˉparseˉstatus.Lexicalˉerror,
            Token.Status,
            Token.Failureˉoffset,
            Token.Failureˉline,
            Token.Failureˉcolumn,
            Expected,
            Token.Kind
        );
    }
    return Compilerˉparseˉstepˉfailure(
        Status,
        Compilerˉlexˉstatus.Valid,
        Token.Offset,
        Token.Line,
        Token.Column,
        Expected,
        Token.Kind
    );
}

export fn Compilerˉparseˉconsume(
    Input: bytes,
    Offset: u32,
    Line: u32,
    Column: u32,
    Expected: Compilerˉtokenˉkind
) -> Compilerˉparseˉstep {
    let Token: Compilerˉsourceˉtoken = Compilerˉlexˉnextˉvalidated(Input, Offset, Line, Column);
    if Token.Status != Compilerˉlexˉstatus.Valid {
        return Compilerˉparseˉstepˉfromˉtoken(
            Compilerˉparseˉstatus.Lexicalˉerror,
            Token,
            Expected
        );
    }
    if Token.Kind != Expected {
        return Compilerˉparseˉstepˉfromˉtoken(
            Compilerˉparseˉstatus.Expectedˉtoken,
            Token,
            Expected
        );
    }
    return Compilerˉparseˉstepˉvalid(
        Token.Nextˉoffset,
        Token.Nextˉline,
        Token.Nextˉcolumn,
        Compilerˉsourceˉtypeˉkind.Unknown,
        0u32
    );
}

export fn Compilerˉparseˉqualifiedˉname(
    Input: bytes,
    Offset: u32,
    Line: u32,
    Column: u32,
    Allowˉlength: bool
) -> Compilerˉparseˉstep {
    let First: Compilerˉsourceˉtoken = Compilerˉlexˉnextˉvalidated(Input, Offset, Line, Column);
    if First.Status != Compilerˉlexˉstatus.Valid {
        return Compilerˉparseˉstepˉfromˉtoken(
            Compilerˉparseˉstatus.Lexicalˉerror,
            First,
            Compilerˉtokenˉkind.Identifier
        );
    }
    var Firstˉaccepted: bool = First.Kind == Compilerˉtokenˉkind.Identifier;
    if Allowˉlength {
        if First.Kind == Compilerˉtokenˉkind.Length { Firstˉaccepted = true; }
    }
    if !Firstˉaccepted {
        return Compilerˉparseˉstepˉfromˉtoken(
            Compilerˉparseˉstatus.Expectedˉtoken,
            First,
            Compilerˉtokenˉkind.Identifier
        );
    }
    var Cursor: u32 = First.Nextˉoffset;
    var Currentˉline: u32 = First.Nextˉline;
    var Currentˉcolumn: u32 = First.Nextˉcolumn;
    var Parts: u32 = 1u32;
    var Reading: bool = true;
    while Reading {
        let Current: Compilerˉsourceˉtoken = Compilerˉlexˉnextˉvalidated(
            Input,
            Cursor,
            Currentˉline,
            Currentˉcolumn
        );
        if Current.Status != Compilerˉlexˉstatus.Valid {
            return Compilerˉparseˉstepˉfromˉtoken(
                Compilerˉparseˉstatus.Lexicalˉerror,
                Current,
                Compilerˉtokenˉkind.Identifier
            );
        }
        if Current.Kind != Compilerˉtokenˉkind.Dot {
            Reading = false;
        } else {
            let Part: Compilerˉsourceˉtoken = Compilerˉlexˉnextˉvalidated(
                Input,
                Current.Nextˉoffset,
                Current.Nextˉline,
                Current.Nextˉcolumn
            );
            if Part.Status != Compilerˉlexˉstatus.Valid {
                return Compilerˉparseˉstepˉfromˉtoken(
                    Compilerˉparseˉstatus.Lexicalˉerror,
                    Part,
                    Compilerˉtokenˉkind.Identifier
                );
            }
            if Part.Kind != Compilerˉtokenˉkind.Identifier {
                return Compilerˉparseˉstepˉfromˉtoken(
                    Compilerˉparseˉstatus.Expectedˉtoken,
                    Part,
                    Compilerˉtokenˉkind.Identifier
                );
            }
            Parts = Parts + 1u32;
            if Parts > 16u32 {
                return Compilerˉparseˉstepˉfromˉtoken(
                    Compilerˉparseˉstatus.Itemˉlimit,
                    Part,
                    Compilerˉtokenˉkind.Identifier
                );
            }
            Cursor = Part.Nextˉoffset;
            Currentˉline = Part.Nextˉline;
            Currentˉcolumn = Part.Nextˉcolumn;
        }
    }
    return Compilerˉparseˉstepˉvalid(
        Cursor,
        Currentˉline,
        Currentˉcolumn,
        Compilerˉsourceˉtypeˉkind.Unknown,
        Parts
    );
}

export fn Compilerˉparseˉtype(
    Input: bytes,
    Offset: u32,
    Line: u32,
    Column: u32,
    Allowˉvoid: bool,
    Allowˉarray: bool
) -> Compilerˉparseˉstep {
    let Token: Compilerˉsourceˉtoken = Compilerˉlexˉnextˉvalidated(Input, Offset, Line, Column);
    if Token.Status != Compilerˉlexˉstatus.Valid {
        return Compilerˉparseˉstepˉfromˉtoken(
            Compilerˉparseˉstatus.Lexicalˉerror,
            Token,
            Compilerˉtokenˉkind.Identifier
        );
    }
    if Allowˉarray {
        if Token.Kind == Compilerˉtokenˉkind.Leftˉbracket {
            let Arrayˉelement: Compilerˉparseˉstep = Compilerˉparseˉconsume(
                Input,
                Token.Nextˉoffset,
                Token.Nextˉline,
                Token.Nextˉcolumn,
                Compilerˉtokenˉkind.I32
            );
            if Arrayˉelement.Status != Compilerˉparseˉstatus.Valid { return Arrayˉelement; }
            let Arrayˉend: Compilerˉparseˉstep = Compilerˉparseˉconsume(
                Input,
                Arrayˉelement.Nextˉoffset,
                Arrayˉelement.Nextˉline,
                Arrayˉelement.Nextˉcolumn,
                Compilerˉtokenˉkind.Rightˉbracket
            );
            if Arrayˉend.Status != Compilerˉparseˉstatus.Valid { return Arrayˉend; }
            return Compilerˉparseˉstepˉvalid(
                Arrayˉend.Nextˉoffset,
                Arrayˉend.Nextˉline,
                Arrayˉend.Nextˉcolumn,
                Compilerˉsourceˉtypeˉkind.I32ˉarray,
                0u32
            );
        }
    }
    var Kind: Compilerˉsourceˉtypeˉkind = Compilerˉsourceˉtypeˉkind.Unknown;
    if Token.Kind == Compilerˉtokenˉkind.I32 { Kind = Compilerˉsourceˉtypeˉkind.I32; }
    if Token.Kind == Compilerˉtokenˉkind.U8 { Kind = Compilerˉsourceˉtypeˉkind.U8; }
    if Token.Kind == Compilerˉtokenˉkind.U32 { Kind = Compilerˉsourceˉtypeˉkind.U32; }
    if Token.Kind == Compilerˉtokenˉkind.Bool { Kind = Compilerˉsourceˉtypeˉkind.Bool; }
    if Token.Kind == Compilerˉtokenˉkind.Text { Kind = Compilerˉsourceˉtypeˉkind.Text; }
    if Token.Kind == Compilerˉtokenˉkind.Bytes { Kind = Compilerˉsourceˉtypeˉkind.Bytes; }
    if Token.Kind == Compilerˉtokenˉkind.Identifier { Kind = Compilerˉsourceˉtypeˉkind.Named; }
    if Allowˉvoid {
        if Token.Kind == Compilerˉtokenˉkind.Void { Kind = Compilerˉsourceˉtypeˉkind.Void; }
    }
    if Kind == Compilerˉsourceˉtypeˉkind.Unknown {
        return Compilerˉparseˉstepˉfromˉtoken(
            Compilerˉparseˉstatus.Invalidˉtype,
            Token,
            Compilerˉtokenˉkind.Identifier
        );
    }
    return Compilerˉparseˉstepˉvalid(
        Token.Nextˉoffset,
        Token.Nextˉline,
        Token.Nextˉcolumn,
        Kind,
        0u32
    );
}

export fn Compilerˉparseˉi32ˉarray(
    Input: bytes,
    Offset: u32,
    Line: u32,
    Column: u32
) -> Compilerˉparseˉstep {
    let Start: Compilerˉparseˉstep = Compilerˉparseˉconsume(
        Input,
        Offset,
        Line,
        Column,
        Compilerˉtokenˉkind.Leftˉbracket
    );
    if Start.Status != Compilerˉparseˉstatus.Valid { return Start; }
    var Cursor: u32 = Start.Nextˉoffset;
    var Currentˉline: u32 = Start.Nextˉline;
    var Currentˉcolumn: u32 = Start.Nextˉcolumn;
    var Items: u32 = 0u32;
    var Reading: bool = true;
    while Reading {
        var Current: Compilerˉsourceˉtoken = Compilerˉlexˉnextˉvalidated(
            Input,
            Cursor,
            Currentˉline,
            Currentˉcolumn
        );
        if Current.Status != Compilerˉlexˉstatus.Valid {
            return Compilerˉparseˉstepˉfromˉtoken(
                Compilerˉparseˉstatus.Lexicalˉerror,
                Current,
                Compilerˉtokenˉkind.Integer
            );
        }
        if Current.Kind == Compilerˉtokenˉkind.Rightˉbracket {
            Reading = false;
        } else {
            if Current.Kind == Compilerˉtokenˉkind.Minus {
                Current = Compilerˉlexˉnextˉvalidated(
                    Input,
                    Current.Nextˉoffset,
                    Current.Nextˉline,
                    Current.Nextˉcolumn
                );
            }
            if Current.Kind != Compilerˉtokenˉkind.Integer {
                return Compilerˉparseˉstepˉfromˉtoken(
                    Compilerˉparseˉstatus.Invalidˉliteral,
                    Current,
                    Compilerˉtokenˉkind.Integer
                );
            }
            if Current.Numericˉkind != Compilerˉnumericˉkind.I32 {
                return Compilerˉparseˉstepˉfromˉtoken(
                    Compilerˉparseˉstatus.Invalidˉliteral,
                    Current,
                    Compilerˉtokenˉkind.Integer
                );
            }
            Items = Items + 1u32;
            if Items > 262144u32 {
                return Compilerˉparseˉstepˉfromˉtoken(
                    Compilerˉparseˉstatus.Itemˉlimit,
                    Current,
                    Compilerˉtokenˉkind.Rightˉbracket
                );
            }
            Cursor = Current.Nextˉoffset;
            Currentˉline = Current.Nextˉline;
            Currentˉcolumn = Current.Nextˉcolumn;
            let Separator: Compilerˉsourceˉtoken = Compilerˉlexˉnextˉvalidated(
                Input,
                Cursor,
                Currentˉline,
                Currentˉcolumn
            );
            if Separator.Kind == Compilerˉtokenˉkind.Comma {
                Cursor = Separator.Nextˉoffset;
                Currentˉline = Separator.Nextˉline;
                Currentˉcolumn = Separator.Nextˉcolumn;
            } else {
                Reading = false;
            }
        }
    }
    let End: Compilerˉparseˉstep = Compilerˉparseˉconsume(
        Input,
        Cursor,
        Currentˉline,
        Currentˉcolumn,
        Compilerˉtokenˉkind.Rightˉbracket
    );
    if End.Status != Compilerˉparseˉstatus.Valid { return End; }
    return Compilerˉparseˉstepˉvalid(
        End.Nextˉoffset,
        End.Nextˉline,
        End.Nextˉcolumn,
        Compilerˉsourceˉtypeˉkind.I32ˉarray,
        Items
    );
}

export fn Compilerˉparseˉbytesˉarray(
    Input: bytes,
    Offset: u32,
    Line: u32,
    Column: u32
) -> Compilerˉparseˉstep {
    let Start: Compilerˉparseˉstep = Compilerˉparseˉconsume(
        Input,
        Offset,
        Line,
        Column,
        Compilerˉtokenˉkind.Leftˉbracket
    );
    if Start.Status != Compilerˉparseˉstatus.Valid { return Start; }
    var Cursor: u32 = Start.Nextˉoffset;
    var Currentˉline: u32 = Start.Nextˉline;
    var Currentˉcolumn: u32 = Start.Nextˉcolumn;
    var Items: u32 = 0u32;
    var Reading: bool = true;
    while Reading {
        let Current: Compilerˉsourceˉtoken = Compilerˉlexˉnextˉvalidated(
            Input,
            Cursor,
            Currentˉline,
            Currentˉcolumn
        );
        if Current.Status != Compilerˉlexˉstatus.Valid {
            return Compilerˉparseˉstepˉfromˉtoken(
                Compilerˉparseˉstatus.Lexicalˉerror,
                Current,
                Compilerˉtokenˉkind.Integer
            );
        }
        if Current.Kind == Compilerˉtokenˉkind.Rightˉbracket {
            Reading = false;
        } else {
            if Current.Kind != Compilerˉtokenˉkind.Integer {
                return Compilerˉparseˉstepˉfromˉtoken(
                    Compilerˉparseˉstatus.Invalidˉliteral,
                    Current,
                    Compilerˉtokenˉkind.Integer
                );
            }
            var Literalˉvalid: bool = false;
            if Current.Numericˉkind == Compilerˉnumericˉkind.U8 { Literalˉvalid = true; }
            if Current.Numericˉkind == Compilerˉnumericˉkind.I32 {
                if Current.Numericˉvalue <= 255u32 { Literalˉvalid = true; }
            }
            if !Literalˉvalid {
                return Compilerˉparseˉstepˉfromˉtoken(
                    Compilerˉparseˉstatus.Invalidˉliteral,
                    Current,
                    Compilerˉtokenˉkind.Integer
                );
            }
            Items = Items + 1u32;
            if Items > 262144u32 {
                return Compilerˉparseˉstepˉfromˉtoken(
                    Compilerˉparseˉstatus.Itemˉlimit,
                    Current,
                    Compilerˉtokenˉkind.Rightˉbracket
                );
            }
            Cursor = Current.Nextˉoffset;
            Currentˉline = Current.Nextˉline;
            Currentˉcolumn = Current.Nextˉcolumn;
            let Separator: Compilerˉsourceˉtoken = Compilerˉlexˉnextˉvalidated(
                Input,
                Cursor,
                Currentˉline,
                Currentˉcolumn
            );
            if Separator.Kind == Compilerˉtokenˉkind.Comma {
                Cursor = Separator.Nextˉoffset;
                Currentˉline = Separator.Nextˉline;
                Currentˉcolumn = Separator.Nextˉcolumn;
            } else {
                Reading = false;
            }
        }
    }
    let End: Compilerˉparseˉstep = Compilerˉparseˉconsume(
        Input,
        Cursor,
        Currentˉline,
        Currentˉcolumn,
        Compilerˉtokenˉkind.Rightˉbracket
    );
    if End.Status != Compilerˉparseˉstatus.Valid { return End; }
    return Compilerˉparseˉstepˉvalid(
        End.Nextˉoffset,
        End.Nextˉline,
        End.Nextˉcolumn,
        Compilerˉsourceˉtypeˉkind.Bytes,
        Items
    );
}

export fn Compilerˉparseˉskipˉblock(
    Input: bytes,
    Offset: u32,
    Line: u32,
    Column: u32
) -> Compilerˉparseˉstep {
    let Start: Compilerˉparseˉstep = Compilerˉparseˉconsume(
        Input,
        Offset,
        Line,
        Column,
        Compilerˉtokenˉkind.Leftˉbrace
    );
    if Start.Status != Compilerˉparseˉstatus.Valid { return Start; }
    var Cursor: u32 = Start.Nextˉoffset;
    var Currentˉline: u32 = Start.Nextˉline;
    var Currentˉcolumn: u32 = Start.Nextˉcolumn;
    var Depth: u32 = 1u32;
    var Tokens: u32 = 0u32;
    while Depth > 0u32 {
        let Current: Compilerˉsourceˉtoken = Compilerˉlexˉnextˉvalidated(
            Input,
            Cursor,
            Currentˉline,
            Currentˉcolumn
        );
        if Current.Status != Compilerˉlexˉstatus.Valid {
            return Compilerˉparseˉstepˉfromˉtoken(
                Compilerˉparseˉstatus.Lexicalˉerror,
                Current,
                Compilerˉtokenˉkind.Rightˉbrace
            );
        }
        if Current.Kind == Compilerˉtokenˉkind.End {
            return Compilerˉparseˉstepˉfromˉtoken(
                Compilerˉparseˉstatus.Expectedˉtoken,
                Current,
                Compilerˉtokenˉkind.Rightˉbrace
            );
        }
        if Current.Kind == Compilerˉtokenˉkind.Leftˉbrace {
            Depth = Depth + 1u32;
            if Depth > 64u32 {
                return Compilerˉparseˉstepˉfromˉtoken(
                    Compilerˉparseˉstatus.Nestingˉlimit,
                    Current,
                    Compilerˉtokenˉkind.Rightˉbrace
                );
            }
        }
        if Current.Kind == Compilerˉtokenˉkind.Rightˉbrace { Depth = Depth - 1u32; }
        Tokens = Tokens + 1u32;
        Cursor = Current.Nextˉoffset;
        Currentˉline = Current.Nextˉline;
        Currentˉcolumn = Current.Nextˉcolumn;
    }
    return Compilerˉparseˉstepˉvalid(
        Cursor,
        Currentˉline,
        Currentˉcolumn,
        Compilerˉsourceˉtypeˉkind.Unknown,
        Tokens
    );
}

export fn Compilerˉsourceˉdeclarationˉmake(
    Status: Compilerˉparseˉstatus,
    Lexicalˉstatus: Compilerˉlexˉstatus,
    Kind: Compilerˉsourceˉdeclarationˉkind,
    Isˉexported: bool,
    Nameˉoffset: u32,
    Nameˉlength: u32,
    Declarationˉoffset: u32,
    Declarationˉend: u32,
    Bodyˉoffset: u32,
    Bodyˉend: u32,
    Items: u32,
    Nextˉoffset: u32,
    Nextˉline: u32,
    Nextˉcolumn: u32,
    Failureˉoffset: u32,
    Failureˉline: u32,
    Failureˉcolumn: u32,
    Expected: Compilerˉtokenˉkind,
    Found: Compilerˉtokenˉkind
) -> Compilerˉsourceˉdeclaration {
    return Compilerˉsourceˉdeclaration(
        Status,
        Lexicalˉstatus,
        Kind,
        Isˉexported,
        Nameˉoffset,
        Nameˉlength,
        Declarationˉoffset,
        Declarationˉend - Declarationˉoffset,
        Bodyˉoffset,
        Bodyˉend - Bodyˉoffset,
        Items,
        Nextˉoffset,
        Nextˉline,
        Nextˉcolumn,
        Failureˉoffset,
        Failureˉline,
        Failureˉcolumn,
        Expected,
        Found
    );
}

export fn Compilerˉsourceˉdeclarationˉfailure(
    Step: Compilerˉparseˉstep,
    Kind: Compilerˉsourceˉdeclarationˉkind,
    Isˉexported: bool,
    Declarationˉoffset: u32,
    Nameˉoffset: u32,
    Nameˉlength: u32
) -> Compilerˉsourceˉdeclaration {
    return Compilerˉsourceˉdeclarationˉmake(
        Step.Status,
        Step.Lexicalˉstatus,
        Kind,
        Isˉexported,
        Nameˉoffset,
        Nameˉlength,
        Declarationˉoffset,
        Declarationˉoffset,
        Declarationˉoffset,
        Declarationˉoffset,
        0u32,
        Step.Nextˉoffset,
        Step.Nextˉline,
        Step.Nextˉcolumn,
        Step.Failureˉoffset,
        Step.Failureˉline,
        Step.Failureˉcolumn,
        Step.Expected,
        Step.Found
    );
}

export fn Compilerˉparseˉimportˉdeclaration(
    Input: bytes,
    Token: Compilerˉsourceˉtoken
) -> Compilerˉsourceˉdeclaration {
    let Afterˉkeyword: Compilerˉparseˉstep = Compilerˉparseˉconsume(
        Input,
        Token.Offset,
        Token.Line,
        Token.Column,
        Compilerˉtokenˉkind.Import
    );
    if Afterˉkeyword.Status != Compilerˉparseˉstatus.Valid {
        return Compilerˉsourceˉdeclarationˉfailure(
            Afterˉkeyword,
            Compilerˉsourceˉdeclarationˉkind.Import,
            false,
            Token.Offset,
            Token.Offset,
            0u32
        );
    }
    let Name: Compilerˉsourceˉtoken = Compilerˉlexˉnextˉvalidated(
        Input,
        Afterˉkeyword.Nextˉoffset,
        Afterˉkeyword.Nextˉline,
        Afterˉkeyword.Nextˉcolumn
    );
    let Afterˉname: Compilerˉparseˉstep = Compilerˉparseˉconsume(
        Input,
        Afterˉkeyword.Nextˉoffset,
        Afterˉkeyword.Nextˉline,
        Afterˉkeyword.Nextˉcolumn,
        Compilerˉtokenˉkind.Identifier
    );
    if Afterˉname.Status != Compilerˉparseˉstatus.Valid {
        return Compilerˉsourceˉdeclarationˉfailure(
            Afterˉname,
            Compilerˉsourceˉdeclarationˉkind.Import,
            false,
            Token.Offset,
            Name.Offset,
            Name.Length
        );
    }
    let End: Compilerˉparseˉstep = Compilerˉparseˉconsume(
        Input,
        Afterˉname.Nextˉoffset,
        Afterˉname.Nextˉline,
        Afterˉname.Nextˉcolumn,
        Compilerˉtokenˉkind.Semicolon
    );
    if End.Status != Compilerˉparseˉstatus.Valid {
        return Compilerˉsourceˉdeclarationˉfailure(
            End,
            Compilerˉsourceˉdeclarationˉkind.Import,
            false,
            Token.Offset,
            Name.Offset,
            Name.Length
        );
    }
    return Compilerˉsourceˉdeclarationˉmake(
        Compilerˉparseˉstatus.Valid,
        Compilerˉlexˉstatus.Valid,
        Compilerˉsourceˉdeclarationˉkind.Import,
        false,
        Name.Offset,
        Name.Length,
        Token.Offset,
        End.Nextˉoffset,
        Token.Offset,
        Token.Offset,
        0u32,
        End.Nextˉoffset,
        End.Nextˉline,
        End.Nextˉcolumn,
        End.Nextˉoffset,
        End.Nextˉline,
        End.Nextˉcolumn,
        Compilerˉtokenˉkind.End,
        Compilerˉtokenˉkind.End
    );
}

export fn Compilerˉparseˉcapabilityˉdeclaration(
    Input: bytes,
