export fn Main() -> bytes {
    let Count: Nativeˉstencilˉresult =
        Nativeˉstencilˉprocessˉargumentˉcount(Argumentˉcountˉobject);
    if Count.Status != Nativeˉstencilˉstatus.Valid {
        return Bytesˉslice(Argumentˉcountˉobject, 0u32, 0u32);
    }

    let Argument: Nativeˉstencilˉresult =
        Nativeˉstencilˉprocessˉargument(Argumentˉobject);
    if Argument.Status != Nativeˉstencilˉstatus.Valid {
        return Bytesˉslice(Argumentˉobject, 0u32, 0u32);
    }

    return Bytesˉconcat(Count.Value, Argument.Value);
}
