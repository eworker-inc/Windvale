module Compilerˉsourceˉgraph profile portable;

import Compilerˉsourceˉset;
import Foundationˉbyteˉconstruction;

enum Compilerˉsourceˉgraphˉstatus {
    Valid = 0;
    Sourceˉset = 1;
    Duplicateˉimport = 2;
    Missingˉimport = 3;
    Cycle = 4;
    Unreachable = 5;
}

record Compilerˉsourceˉgraphˉmatch {
    Found: bool;
    Index: u32;
}

record Compilerˉsourceˉgraphˉwalk {
    Status: Compilerˉsourceˉgraphˉstatus;
    State: bytes;
    Count: u32;
    Changed: bool;
    Failureˉmodule: u32;
    Failureˉtarget: u32;
    Failureˉoffset: u32;
    Failureˉline: u32;
    Failureˉcolumn: u32;
}

record Compilerˉsourceˉgraphˉsummary {
    Status: Compilerˉsourceˉgraphˉstatus;
    Sourceˉsetˉstatus: Compilerˉsourceˉsetˉstatus;
    Modules: u32;
    Imports: u32;
    Reachable: u32;
    Failureˉmodule: u32;
    Failureˉtarget: u32;
    Failureˉoffset: u32;
    Failureˉline: u32;
    Failureˉcolumn: u32;
}

export fn Compilerˉsourceˉgraphˉstate(Count: u32) -> bytes {
    let Result: Foundationˉbytesˉresult = Foundationˉbytesˉrepeat(0u8, Count);
    return Result.Value;
}

export fn Compilerˉsourceˉgraphˉmark(State: bytes, Index: u32) -> bytes {
    let Result: Foundationˉbytesˉresult = Foundationˉbytesˉreplace(
        State,
        Index,
        1u32,
        Bytesˉfromˉu8(1u8)
    );
    return Result.Value;
}

export fn Compilerˉsourceˉgraphˉsummaryˉfailure(
    Status: Compilerˉsourceˉgraphˉstatus,
    Sourceˉsetˉstatus: Compilerˉsourceˉsetˉstatus,
    Modules: u32,
    Imports: u32,
    Reachable: u32,
    Module: u32,
    Target: u32,
    Offset: u32,
    Line: u32,
    Column: u32
) -> Compilerˉsourceˉgraphˉsummary {
    return Compilerˉsourceˉgraphˉsummary(
        Status,
        Sourceˉsetˉstatus,
        Modules,
        Imports,
        Reachable,
        Module,
        Target,
        Offset,
        Line,
        Column
    );
}

export fn Compilerˉsourceˉgraphˉwalkˉfailure(
    Status: Compilerˉsourceˉgraphˉstatus,
    State: bytes,
    Count: u32,
    Module: u32,
    Target: u32,
    Offset: u32,
    Line: u32,
    Column: u32
) -> Compilerˉsourceˉgraphˉwalk {
    return Compilerˉsourceˉgraphˉwalk(
        Status,
        State,
        Count,
        false,
        Module,
        Target,
        Offset,
        Line,
        Column
    );
}

export fn Compilerˉsourceˉgraphˉfind(
    Input: bytes,
    Scan: Compilerˉsourceˉsetˉscan,
    Nameˉsource: bytes,
    Nameˉoffset: u32,
    Nameˉlength: u32
) -> Compilerˉsourceˉgraphˉmatch {
    var Index: u32 = 0u32;
    while Index < Scan.Modules {
        let View: Compilerˉsourceˉsetˉview = Compilerˉsourceˉsetˉmodule(Input, Scan, Index);
        let Header: Compilerˉsourceˉheader = Compilerˉparseˉheaderˉvalidated(View.Source);
        if Compilerˉsourceˉspansˉcompare(
            Nameˉsource,
            Nameˉoffset,
            Nameˉlength,
            View.Source,
            Header.Nameˉoffset,
            Header.Nameˉlength
        ) == 0 {
            return Compilerˉsourceˉgraphˉmatch(true, Index);
        }
        Index = Index + 1u32;
    }
    return Compilerˉsourceˉgraphˉmatch(false, Scan.Modules);
}

export fn Compilerˉsourceˉgraphˉimportˉisˉduplicate(
    Source: bytes,
    Header: Compilerˉsourceˉheader,
    Current: Compilerˉsourceˉdeclaration
) -> bool {
    var Cursor: u32 = Header.Nextˉoffset;
    var Currentˉline: u32 = Header.Nextˉline;
    var Currentˉcolumn: u32 = Header.Nextˉcolumn;
    while Cursor < Current.Declarationˉoffset {
        let Prior: Compilerˉsourceˉdeclaration = Compilerˉparseˉnextˉdeclarationˉvalidated(
            Source,
            Cursor,
            Currentˉline,
            Currentˉcolumn,
            false
        );
        if Prior.Kind != Compilerˉsourceˉdeclarationˉkind.Import { return false; }
        if Prior.Declarationˉoffset >= Current.Declarationˉoffset { return false; }
        if Compilerˉsourceˉspansˉcompare(
            Source,
            Prior.Nameˉoffset,
            Prior.Nameˉlength,
            Source,
            Current.Nameˉoffset,
            Current.Nameˉlength
        ) == 0 {
            return true;
        }
        Cursor = Prior.Nextˉoffset;
        Currentˉline = Prior.Nextˉline;
        Currentˉcolumn = Prior.Nextˉcolumn;
    }
    return false;
}

export fn Compilerˉsourceˉgraphˉexpand(
    Input: bytes,
    Scan: Compilerˉsourceˉsetˉscan,
    State: bytes,
    Reachable: u32
) -> Compilerˉsourceˉgraphˉwalk {
    var Nextˉstate: bytes = State;
    var Nextˉreachable: u32 = Reachable;
    var Changed: bool = false;
    var Index: u32 = 0u32;
    while Index < Scan.Modules {
        if Bytesˉreadˉu8(Nextˉstate, Index) != 0u8 {
            let View: Compilerˉsourceˉsetˉview = Compilerˉsourceˉsetˉmodule(Input, Scan, Index);
            let Source: bytes = View.Source;
            let Header: Compilerˉsourceˉheader = Compilerˉparseˉheaderˉvalidated(Source);
            var Cursor: u32 = Header.Nextˉoffset;
            var Currentˉline: u32 = Header.Nextˉline;
            var Currentˉcolumn: u32 = Header.Nextˉcolumn;
            var Reading: bool = true;
            while Reading {
                let Declaration: Compilerˉsourceˉdeclaration = Compilerˉparseˉnextˉdeclarationˉvalidated(
                    Source,
                    Cursor,
                    Currentˉline,
                    Currentˉcolumn,
                    false
                );
                if Declaration.Kind != Compilerˉsourceˉdeclarationˉkind.Import {
                    Reading = false;
                } else {
                    let Position: Compilerˉsourceˉposition = Compilerˉbodyˉpositionˉbetween(
                        Source,
                        Cursor,
                        Currentˉline,
                        Currentˉcolumn,
                        Declaration.Nameˉoffset
                    );
                    if Compilerˉsourceˉgraphˉimportˉisˉduplicate(Source, Header, Declaration) {
                        return Compilerˉsourceˉgraphˉwalkˉfailure(
                            Compilerˉsourceˉgraphˉstatus.Duplicateˉimport,
                            Nextˉstate,
                            Nextˉreachable,
                            Index,
                            Scan.Modules,
                            Declaration.Nameˉoffset,
                            Position.Line,
                            Position.Column
                        );
                    }
                    let Target: Compilerˉsourceˉgraphˉmatch = Compilerˉsourceˉgraphˉfind(
                        Input,
                        Scan,
                        Source,
                        Declaration.Nameˉoffset,
                        Declaration.Nameˉlength
                    );
                    if !Target.Found {
                        return Compilerˉsourceˉgraphˉwalkˉfailure(
                            Compilerˉsourceˉgraphˉstatus.Missingˉimport,
                            Nextˉstate,
                            Nextˉreachable,
                            Index,
                            Scan.Modules,
                            Declaration.Nameˉoffset,
                            Position.Line,
                            Position.Column
                        );
                    }
                    if Bytesˉreadˉu8(Nextˉstate, Target.Index) == 0u8 {
                        Nextˉstate = Compilerˉsourceˉgraphˉmark(Nextˉstate, Target.Index);
                        Nextˉreachable = Nextˉreachable + 1u32;
                        Changed = true;
                    }
                    Cursor = Declaration.Nextˉoffset;
                    Currentˉline = Declaration.Nextˉline;
                    Currentˉcolumn = Declaration.Nextˉcolumn;
                }
            }
        }
        Index = Index + 1u32;
    }
    return Compilerˉsourceˉgraphˉwalk(
        Compilerˉsourceˉgraphˉstatus.Valid,
        Nextˉstate,
        Nextˉreachable,
        Changed,
        Scan.Modules,
        Scan.Modules,
        Bytesˉlength(Input),
        0u32,
        0u32
    );
}

export fn Compilerˉsourceˉgraphˉimportˉcount(
    Input: bytes,
    Scan: Compilerˉsourceˉsetˉscan
) -> u32 {
    var Imports: u32 = 0u32;
    var Index: u32 = 0u32;
    while Index < Scan.Modules {
        let View: Compilerˉsourceˉsetˉview = Compilerˉsourceˉsetˉmodule(Input, Scan, Index);
        let Source: bytes = View.Source;
        let Header: Compilerˉsourceˉheader = Compilerˉparseˉheaderˉvalidated(Source);
        var Cursor: u32 = Header.Nextˉoffset;
        var Currentˉline: u32 = Header.Nextˉline;
        var Currentˉcolumn: u32 = Header.Nextˉcolumn;
        var Reading: bool = true;
        while Reading {
            let Declaration: Compilerˉsourceˉdeclaration = Compilerˉparseˉnextˉdeclarationˉvalidated(
                Source,
                Cursor,
                Currentˉline,
                Currentˉcolumn,
                false
            );
            if Declaration.Kind != Compilerˉsourceˉdeclarationˉkind.Import {
                Reading = false;
            } else {
                Imports = Imports + 1u32;
                Cursor = Declaration.Nextˉoffset;
                Currentˉline = Declaration.Nextˉline;
                Currentˉcolumn = Declaration.Nextˉcolumn;
            }
        }
        Index = Index + 1u32;
    }
    return Imports;
}

export fn Compilerˉsourceˉgraphˉhasˉincoming(
    Input: bytes,
    Scan: Compilerˉsourceˉsetˉscan,
    Removed: bytes,
    Candidate: u32
) -> bool {
    let Candidateˉview: Compilerˉsourceˉsetˉview = Compilerˉsourceˉsetˉmodule(Input, Scan, Candidate);
    let Candidateˉheader: Compilerˉsourceˉheader = Compilerˉparseˉheaderˉvalidated(Candidateˉview.Source);
    var Index: u32 = 0u32;
    while Index < Scan.Modules {
        if Bytesˉreadˉu8(Removed, Index) == 0u8 {
            let View: Compilerˉsourceˉsetˉview = Compilerˉsourceˉsetˉmodule(Input, Scan, Index);
            let Source: bytes = View.Source;
            let Header: Compilerˉsourceˉheader = Compilerˉparseˉheaderˉvalidated(Source);
            var Cursor: u32 = Header.Nextˉoffset;
            var Currentˉline: u32 = Header.Nextˉline;
            var Currentˉcolumn: u32 = Header.Nextˉcolumn;
            var Reading: bool = true;
            while Reading {
                let Declaration: Compilerˉsourceˉdeclaration = Compilerˉparseˉnextˉdeclarationˉvalidated(
                    Source,
                    Cursor,
                    Currentˉline,
                    Currentˉcolumn,
                    false
                );
                if Declaration.Kind != Compilerˉsourceˉdeclarationˉkind.Import {
                    Reading = false;
                } else {
                    if Compilerˉsourceˉspansˉcompare(
                        Source,
                        Declaration.Nameˉoffset,
                        Declaration.Nameˉlength,
                        Candidateˉview.Source,
                        Candidateˉheader.Nameˉoffset,
                        Candidateˉheader.Nameˉlength
                    ) == 0 {
                        return true;
                    }
                    Cursor = Declaration.Nextˉoffset;
                    Currentˉline = Declaration.Nextˉline;
                    Currentˉcolumn = Declaration.Nextˉcolumn;
                }
            }
        }
        Index = Index + 1u32;
    }
    return false;
}

export fn Compilerˉsourceˉgraphˉcycleˉfailure(
    Input: bytes,
    Scan: Compilerˉsourceˉsetˉscan,
    Imports: u32
) -> Compilerˉsourceˉgraphˉsummary {
    var Start: u32 = 0u32;
    while Start < Scan.Modules {
        var Frontier: bytes = Compilerˉsourceˉgraphˉmark(
            Compilerˉsourceˉgraphˉstate(Scan.Modules),
            Start
        );
        var Step: u32 = 0u32;
        while Step < Scan.Modules {
            var Next: bytes = Compilerˉsourceˉgraphˉstate(Scan.Modules);
            var Sawˉedge: bool = false;
            var Index: u32 = 0u32;
            while Index < Scan.Modules {
                if Bytesˉreadˉu8(Frontier, Index) != 0u8 {
                    let View: Compilerˉsourceˉsetˉview = Compilerˉsourceˉsetˉmodule(Input, Scan, Index);
                    let Source: bytes = View.Source;
                    let Header: Compilerˉsourceˉheader = Compilerˉparseˉheaderˉvalidated(Source);
                    var Cursor: u32 = Header.Nextˉoffset;
                    var Currentˉline: u32 = Header.Nextˉline;
                    var Currentˉcolumn: u32 = Header.Nextˉcolumn;
                    var Reading: bool = true;
                    while Reading {
                        let Declaration: Compilerˉsourceˉdeclaration = Compilerˉparseˉnextˉdeclarationˉvalidated(
                            Source,
                            Cursor,
                            Currentˉline,
                            Currentˉcolumn,
                            false
                        );
                        if Declaration.Kind != Compilerˉsourceˉdeclarationˉkind.Import {
                            Reading = false;
                        } else {
                            let Target: Compilerˉsourceˉgraphˉmatch = Compilerˉsourceˉgraphˉfind(
                                Input,
                                Scan,
                                Source,
                                Declaration.Nameˉoffset,
                                Declaration.Nameˉlength
                            );
                            if Target.Index == Start {
                                let Position: Compilerˉsourceˉposition = Compilerˉbodyˉpositionˉbetween(
                                    Source,
                                    Cursor,
                                    Currentˉline,
                                    Currentˉcolumn,
                                    Declaration.Nameˉoffset
                                );
                                return Compilerˉsourceˉgraphˉsummaryˉfailure(
                                    Compilerˉsourceˉgraphˉstatus.Cycle,
                                    Compilerˉsourceˉsetˉstatus.Valid,
                                    Scan.Modules,
                                    Imports,
                                    Scan.Modules,
                                    Index,
                                    Start,
                                    Declaration.Nameˉoffset,
                                    Position.Line,
                                    Position.Column
                                );
                            }
                            if Bytesˉreadˉu8(Next, Target.Index) == 0u8 {
                                Next = Compilerˉsourceˉgraphˉmark(Next, Target.Index);
                            }
                            Sawˉedge = true;
                            Cursor = Declaration.Nextˉoffset;
                            Currentˉline = Declaration.Nextˉline;
                            Currentˉcolumn = Declaration.Nextˉcolumn;
                        }
                    }
                }
                Index = Index + 1u32;
            }
            if !Sawˉedge { Step = Scan.Modules; } else {
                Frontier = Next;
                Step = Step + 1u32;
            }
        }
        Start = Start + 1u32;
    }
    return Compilerˉsourceˉgraphˉsummaryˉfailure(
        Compilerˉsourceˉgraphˉstatus.Cycle,
        Compilerˉsourceˉsetˉstatus.Valid,
        Scan.Modules,
        Imports,
        Scan.Modules,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32
    );
}

export fn Compilerˉvalidateˉsourceˉgraph(Input: bytes) -> Compilerˉsourceˉgraphˉsummary {
    let Setˉsummary: Compilerˉsourceˉsetˉsummary = Compilerˉvalidateˉsourceˉset(Input);
    if Setˉsummary.Status != Compilerˉsourceˉsetˉstatus.Valid {
        return Compilerˉsourceˉgraphˉsummaryˉfailure(
            Compilerˉsourceˉgraphˉstatus.Sourceˉset,
            Setˉsummary.Status,
            Setˉsummary.Modules,
            Setˉsummary.Imports,
            0u32,
            Setˉsummary.Failureˉmodule,
            Setˉsummary.Modules,
            Setˉsummary.Failureˉoffset,
            Setˉsummary.Failureˉline,
            Setˉsummary.Failureˉcolumn
        );
    }

    let Scan: Compilerˉsourceˉsetˉscan = Compilerˉscanˉsourceˉset(Input);
    var State: bytes = Compilerˉsourceˉgraphˉmark(
        Compilerˉsourceˉgraphˉstate(Scan.Modules),
        0u32
    );
    var Reachable: u32 = 1u32;
    var Pass: u32 = 0u32;
    var Expanding: bool = true;
    while Expanding {
        let Walk: Compilerˉsourceˉgraphˉwalk = Compilerˉsourceˉgraphˉexpand(
            Input,
            Scan,
            State,
            Reachable
        );
        if Walk.Status != Compilerˉsourceˉgraphˉstatus.Valid {
            return Compilerˉsourceˉgraphˉsummaryˉfailure(
                Walk.Status,
                Compilerˉsourceˉsetˉstatus.Valid,
                Scan.Modules,
                Setˉsummary.Imports,
                Walk.Count,
                Walk.Failureˉmodule,
                Walk.Failureˉtarget,
                Walk.Failureˉoffset,
                Walk.Failureˉline,
                Walk.Failureˉcolumn
            );
        }
        State = Walk.State;
        Reachable = Walk.Count;
        Pass = Pass + 1u32;
        if !Walk.Changed { Expanding = false; }
        if Pass >= Scan.Modules { Expanding = false; }
    }

    var Index: u32 = 1u32;
    while Index < Scan.Modules {
        if Bytesˉreadˉu8(State, Index) == 0u8 {
            let View: Compilerˉsourceˉsetˉview = Compilerˉsourceˉsetˉmodule(Input, Scan, Index);
            let Header: Compilerˉsourceˉheader = Compilerˉparseˉheaderˉvalidated(View.Source);
            let Position: Compilerˉsourceˉposition = Compilerˉbodyˉpositionˉbetween(
                View.Source,
                0u32,
                1u32,
                1u32,
                Header.Nameˉoffset
            );
            return Compilerˉsourceˉgraphˉsummaryˉfailure(
                Compilerˉsourceˉgraphˉstatus.Unreachable,
                Compilerˉsourceˉsetˉstatus.Valid,
                Scan.Modules,
                Setˉsummary.Imports,
                Reachable,
                Index,
                Index,
                Header.Nameˉoffset,
                Position.Line,
                Position.Column
            );
        }
        Index = Index + 1u32;
    }

    let Imports: u32 = Compilerˉsourceˉgraphˉimportˉcount(Input, Scan);
    var Removed: bytes = Compilerˉsourceˉgraphˉstate(Scan.Modules);
    var Removedˉcount: u32 = 0u32;
    while Removedˉcount < Scan.Modules {
        var Candidate: u32 = 0u32;
        var Selected: u32 = Scan.Modules;
        while Candidate < Scan.Modules {
            if Bytesˉreadˉu8(Removed, Candidate) == 0u8 {
                if !Compilerˉsourceˉgraphˉhasˉincoming(Input, Scan, Removed, Candidate) {
                    Selected = Candidate;
                    Candidate = Scan.Modules;
                } else {
                    Candidate = Candidate + 1u32;
                }
            } else {
                Candidate = Candidate + 1u32;
            }
        }
        if Selected == Scan.Modules {
            return Compilerˉsourceˉgraphˉcycleˉfailure(Input, Scan, Imports);
        }
        Removed = Compilerˉsourceˉgraphˉmark(Removed, Selected);
        Removedˉcount = Removedˉcount + 1u32;
    }

    return Compilerˉsourceˉgraphˉsummary(
        Compilerˉsourceˉgraphˉstatus.Valid,
        Compilerˉsourceˉsetˉstatus.Valid,
        Scan.Modules,
        Imports,
        Reachable,
        Scan.Modules,
        Scan.Modules,
        Bytesˉlength(Input),
        0u32,
        0u32
    );
}
