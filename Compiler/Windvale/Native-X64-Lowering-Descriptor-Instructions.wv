module Compilerˉnativeˉx64ˉloweringˉdescriptorˉinstructions profile portable;

import Compilerˉnativeˉx64ˉloweringˉdata as Staticˉdata;
import Compilerˉnativeˉx64ˉloweringˉdescriptors as Descriptors;
import Compilerˉnativeˉx64ˉloweringˉlayout as Layout;
import Compilerˉnativeˉx64ˉloweringˉruntimeˉdescriptors as Runtimeˉdescriptors;
import Compilerˉnativeˉx64ˉloweringˉbytesˉconcatenation as Bytesˉconcatenation;

data U32ˉfromˉu8ˉtemplate: bytes = [
    139, 132, 36, 0, 0, 0, 0,
    137, 132, 36, 0, 0, 0, 0
];

data U32ˉdivideˉtemplate: bytes = [
    139, 132, 36, 0, 0, 0, 0,
    139, 140, 36, 0, 0, 0, 0,
    133, 201, 15, 132, 0, 0, 0, 0,
    49, 210, 247, 241,
    137, 132, 36, 0, 0, 0, 0
];

data U32ˉremainderˉtemplate: bytes = [
    139, 132, 36, 0, 0, 0, 0,
    139, 140, 36, 0, 0, 0, 0,
    133, 201, 15, 132, 0, 0, 0, 0,
    49, 210, 247, 241, 137, 208,
    137, 132, 36, 0, 0, 0, 0
];

data U32ˉbitwiseˉandˉtemplate: bytes = [
    139, 132, 36, 0, 0, 0, 0,
    139, 140, 36, 0, 0, 0, 0,
    33, 200,
    137, 132, 36, 0, 0, 0, 0
];

data U32ˉbitwiseˉorˉtemplate: bytes = [
    139, 132, 36, 0, 0, 0, 0,
    139, 140, 36, 0, 0, 0, 0,
    9, 200,
    137, 132, 36, 0, 0, 0, 0
];

data U32ˉbitwiseˉxorˉtemplate: bytes = [
    139, 132, 36, 0, 0, 0, 0,
    139, 140, 36, 0, 0, 0, 0,
    49, 200,
    137, 132, 36, 0, 0, 0, 0
];

data U32ˉbitwiseˉnotˉtemplate: bytes = [
    139, 132, 36, 0, 0, 0, 0,
    247, 208,
    137, 132, 36, 0, 0, 0, 0
];

data U32ˉshiftˉleftˉtemplate: bytes = [
    139, 132, 36, 0, 0, 0, 0,
    139, 140, 36, 0, 0, 0, 0,
    131, 249, 32,
    15, 131, 0, 0, 0, 0,
    211, 224,
    137, 132, 36, 0, 0, 0, 0
];

data U32ˉshiftˉrightˉtemplate: bytes = [
    139, 132, 36, 0, 0, 0, 0,
    139, 140, 36, 0, 0, 0, 0,
    131, 249, 32,
    15, 131, 0, 0, 0, 0,
    211, 232,
    137, 132, 36, 0, 0, 0, 0
];

data Scalarˉaddˉtemplate: bytes = [
    139, 132, 36, 0, 0, 0, 0,
    139, 140, 36, 0, 0, 0, 0,
    1, 200,
    15, 128, 0, 0, 0, 0,
    137, 132, 36, 0, 0, 0, 0
];

data I32ˉmultiplyˉtemplate: bytes = [
    139, 132, 36, 0, 0, 0, 0,
    139, 140, 36, 0, 0, 0, 0,
    15, 175, 193,
    15, 128, 0, 0, 0, 0,
    137, 132, 36, 0, 0, 0, 0
];

data U32ˉmultiplyˉtemplate: bytes = [
    139, 132, 36, 0, 0, 0, 0,
    139, 140, 36, 0, 0, 0, 0,
    247, 225, 133, 210,
    15, 133, 0, 0, 0, 0,
    137, 132, 36, 0, 0, 0, 0
];

export record Compilerˉnativeˉx64ˉdescriptorˉinstruction {
    Input: bytes;
    Offset: u32;
    Opcode: u8;
    Boundsˉtarget: u32;
    Runtimeˉtarget: u32;
    Invalidˉutf8ˉtarget: u32;
    Divisionˉbyˉzeroˉtarget: u32;
}

export record Compilerˉnativeˉx64ˉdescriptorˉlayout {
    Locals: u32;
    I32ˉslots: u32;
    Boolˉslots: u32;
    Textˉslots: u32;
    U8ˉslots: u32;
    U32ˉslots: u32;
    Bytesˉslots: u32;
}

export record Compilerˉnativeˉx64ˉdescriptorˉstate {
    Result: bytes;
    Stackˉtypes: bytes;
    Stackˉslots: bytes;
    Stackˉdepth: u32;
    Nextˉi32: u32;
    Nextˉbool: u32;
    Nextˉtext: u32;
    Nextˉu8: u32;
    Nextˉu32: u32;
    Nextˉbytes: u32;
}

fn Valueˉslot(
    Shape: Compilerˉnativeˉx64ˉdescriptorˉlayout,
    Type: u8,
    Index: u32
) -> u32 {
    return Layout.Compilerˉnativeˉx64ˉlayoutˉvalueˉslot(
        Shape.Locals,
        Shape.I32ˉslots,
        Shape.Boolˉslots,
        Shape.Textˉslots,
        Shape.U8ˉslots,
        Shape.U32ˉslots,
        Shape.Bytesˉslots,
        Type,
        Index
    );
}

fn Patchˉu32(Input: bytes, Offset: u32, Value: u32) -> bytes {
    var Output: bytes = Bytesˉslice(Input, 0u32, Offset);
    Output = Bytesˉconcat(Output, Bytesˉfromˉu32ˉlittle(Value));
    return Bytesˉconcat(
        Output,
        Bytesˉslice(Input, Offset + 4u32, Bytesˉlength(Input) - Offset - 4u32)
    );
}

fn Replaceˉu8(Input: bytes, Offset: u32, Value: u8) -> bytes {
    var Output: bytes = Bytesˉslice(Input, 0u32, Offset);
    Output = Bytesˉconcat(Output, Bytesˉfromˉu8(Value));
    return Bytesˉconcat(
        Output,
        Bytesˉslice(Input, Offset + 1u32, Bytesˉlength(Input) - Offset - 1u32)
    );
}

export fn Compilerˉnativeˉx64ˉemitˉscalarˉarithmetic(
    Result: bytes,
    Opcode: u8,
    Left: u32,
    Right: u32,
    Target: u32,
    Failureˉtarget: u32
) -> bytes {
    if U32ˉfromˉu8(Opcode) <= 22u32 {
        var Arithmetic: bytes = Scalarˉaddˉtemplate;
        var Branchˉoffset: u32 = 18u32;
        var Branchˉend: u32 = 22u32;
        var Storeˉoffset: u32 = 25u32;
        if Opcode == 17u8 || Opcode == 21u8 {
            Arithmetic = Replaceˉu8(Arithmetic, 14u32, 41u8);
        }
        if Opcode == 20u8 || Opcode == 21u8 {
            Arithmetic = Replaceˉu8(Arithmetic, 17u32, 130u8);
        }
        if Opcode == 18u8 {
            Arithmetic = I32ˉmultiplyˉtemplate;
            Branchˉoffset = 19u32;
            Branchˉend = 23u32;
            Storeˉoffset = 26u32;
        }
        if Opcode == 22u8 {
            Arithmetic = U32ˉmultiplyˉtemplate;
            Branchˉoffset = 20u32;
            Branchˉend = 24u32;
            Storeˉoffset = 27u32;
        }
        Arithmetic = Patchˉu32(Arithmetic, 3u32, Left * 16u32);
        Arithmetic = Patchˉu32(Arithmetic, 10u32, Right * 16u32);
        Arithmetic = Patchˉu32(
            Arithmetic,
            Branchˉoffset,
            Failureˉtarget - Bytesˉlength(Result) - Branchˉend
        );
        Arithmetic = Patchˉu32(Arithmetic, Storeˉoffset, Target * 16u32);
        return Bytesˉconcat(Result, Arithmetic);
    }
    var Machine: bytes = U32ˉbitwiseˉandˉtemplate;
    if Opcode == 174u8 { Machine = U32ˉbitwiseˉorˉtemplate; }
    if Opcode == 175u8 { Machine = U32ˉbitwiseˉxorˉtemplate; }
    if Opcode == 176u8 {
        Machine = Patchˉu32(U32ˉbitwiseˉnotˉtemplate, 3u32, Left * 16u32);
        Machine = Patchˉu32(Machine, 12u32, Target * 16u32);
        return Bytesˉconcat(Result, Machine);
    }
    if Opcode == 177u8 { Machine = U32ˉshiftˉleftˉtemplate; }
    if Opcode == 178u8 { Machine = U32ˉshiftˉrightˉtemplate; }
    Machine = Patchˉu32(Machine, 3u32, Left * 16u32);
    Machine = Patchˉu32(Machine, 10u32, Right * 16u32);
    if Opcode == 177u8 || Opcode == 178u8 {
        Machine = Patchˉu32(
            Machine,
            19u32,
            Failureˉtarget - Bytesˉlength(Result) - 23u32
        );
        Machine = Patchˉu32(Machine, 28u32, Target * 16u32);
    } else {
        Machine = Patchˉu32(Machine, 19u32, Target * 16u32);
    }
    return Bytesˉconcat(Result, Machine);
}

export fn Compilerˉnativeˉx64ˉu32ˉfromˉu8ˉbytes() -> u32 {
    return 24u32;
}

fn Emitˉu32ˉfromˉu8ˉmachineˉcode(
    Result: bytes,
    Source: u32,
    Target: u32
) -> bytes {
    var Instruction: bytes = U32ˉfromˉu8ˉtemplate;
    Instruction = Patchˉu32(Instruction, 3u32, Source * 16u32);
    Instruction = Patchˉu32(Instruction, 10u32, Target * 16u32);
    return Bytesˉconcat(Result, Instruction);
}

export fn Compilerˉnativeˉx64ˉu32ˉdivisionˉbytes(Opcode: u8) -> u32 {
    if Opcode == 161u8 { return 43u32; }
    return 45u32;
}

fn Emitˉu32ˉdivision(
    Instruction: Compilerˉnativeˉx64ˉdescriptorˉinstruction,
    Shape: Compilerˉnativeˉx64ˉdescriptorˉlayout,
    State: Compilerˉnativeˉx64ˉdescriptorˉstate
) -> Compilerˉnativeˉx64ˉdescriptorˉstate {
    let Right: u32 = Bytesˉreadˉu32ˉlittle(
        State.Stackˉslots,
        (State.Stackˉdepth - 1u32) * 4u32
    );
    let Left: u32 = Bytesˉreadˉu32ˉlittle(
        State.Stackˉslots,
        (State.Stackˉdepth - 2u32) * 4u32
    );
    let Target: u32 = Valueˉslot(Shape, 5u8, State.Nextˉu32);
    var Machine: bytes = U32ˉdivideˉtemplate;
    var Storeˉoffset: u32 = 29u32;
    if Instruction.Opcode == 162u8 {
        Machine = U32ˉremainderˉtemplate;
        Storeˉoffset = 31u32;
    }
    Machine = Patchˉu32(Machine, 3u32, Left * 16u32);
    Machine = Patchˉu32(Machine, 10u32, Right * 16u32);
    Machine = Patchˉu32(
        Machine,
        18u32,
        Instruction.Divisionˉbyˉzeroˉtarget - Bytesˉlength(State.Result) - 22u32
    );
    Machine = Patchˉu32(Machine, Storeˉoffset, Target * 16u32);
    let Depth: u32 = State.Stackˉdepth - 2u32;
    return Compilerˉnativeˉx64ˉdescriptorˉstate(
        Bytesˉconcat(State.Result, Machine),
        Bytesˉconcat(
            Bytesˉslice(State.Stackˉtypes, 0u32, Depth),
            Bytesˉfromˉu8(5u8)
        ),
        Bytesˉconcat(
            Bytesˉslice(State.Stackˉslots, 0u32, Depth * 4u32),
            Bytesˉfromˉu32ˉlittle(Target)
        ),
        Depth + 1u32,
        State.Nextˉi32,
        State.Nextˉbool,
        State.Nextˉtext,
        State.Nextˉu8,
        State.Nextˉu32 + 1u32,
        State.Nextˉbytes
    );
}

fn Emitˉconstant(
    Instruction: Compilerˉnativeˉx64ˉdescriptorˉinstruction,
    Shape: Compilerˉnativeˉx64ˉdescriptorˉlayout,
    Data: Staticˉdata.Compilerˉnativeˉx64ˉdata,
    State: Compilerˉnativeˉx64ˉdescriptorˉstate
) -> Compilerˉnativeˉx64ˉdescriptorˉstate {
    let Dataˉindex: u32 = Bytesˉreadˉu32ˉlittle(
        Instruction.Input,
        Instruction.Offset + 1u32
    );
    var Type: u8 = 3u8;
    var Index: u32 = State.Nextˉtext;
    if Instruction.Opcode == 10u8 {
        Type = 6u8;
        Index = State.Nextˉbytes;
    }
    let Slot: u32 = Valueˉslot(Shape, Type, Index);
    let Result: bytes = Descriptors.Compilerˉnativeˉx64ˉemitˉdescriptorˉconstant(
        State.Result,
        Slot,
        Staticˉdata.Compilerˉnativeˉx64ˉdataˉlength(Data, Dataˉindex)
    );
    var Nextˉtext: u32 = State.Nextˉtext;
    var Nextˉbytes: u32 = State.Nextˉbytes;
    if Type == 3u8 {
        Nextˉtext = Nextˉtext + 1u32;
    } else {
        Nextˉbytes = Nextˉbytes + 1u32;
    }
    return Compilerˉnativeˉx64ˉdescriptorˉstate(
        Result,
        Bytesˉconcat(State.Stackˉtypes, Bytesˉfromˉu8(Type)),
        Bytesˉconcat(State.Stackˉslots, Bytesˉfromˉu32ˉlittle(Slot)),
        State.Stackˉdepth + 1u32,
        State.Nextˉi32,
        State.Nextˉbool,
        Nextˉtext,
        State.Nextˉu8,
        State.Nextˉu32,
        Nextˉbytes
    );
}

fn Emitˉlength(
    Shape: Compilerˉnativeˉx64ˉdescriptorˉlayout,
    State: Compilerˉnativeˉx64ˉdescriptorˉstate
) -> Compilerˉnativeˉx64ˉdescriptorˉstate {
    let Source: u32 = Bytesˉreadˉu32ˉlittle(
        State.Stackˉslots,
        (State.Stackˉdepth - 1u32) * 4u32
    );
    let Depth: u32 = State.Stackˉdepth - 1u32;
    let Target: u32 = Valueˉslot(Shape, 5u8, State.Nextˉu32);
    return Compilerˉnativeˉx64ˉdescriptorˉstate(
        Descriptors.Compilerˉnativeˉx64ˉemitˉdescriptorˉlength(
            State.Result,
            Source,
            Target
        ),
        Bytesˉconcat(
            Bytesˉslice(State.Stackˉtypes, 0u32, Depth),
            Bytesˉfromˉu8(5u8)
        ),
        Bytesˉconcat(
            Bytesˉslice(State.Stackˉslots, 0u32, Depth * 4u32),
            Bytesˉfromˉu32ˉlittle(Target)
        ),
        Depth + 1u32,
        State.Nextˉi32,
        State.Nextˉbool,
        State.Nextˉtext,
        State.Nextˉu8,
        State.Nextˉu32 + 1u32,
        State.Nextˉbytes
    );
}

fn Emitˉslice(
    Instruction: Compilerˉnativeˉx64ˉdescriptorˉinstruction,
    Shape: Compilerˉnativeˉx64ˉdescriptorˉlayout,
    State: Compilerˉnativeˉx64ˉdescriptorˉstate
) -> Compilerˉnativeˉx64ˉdescriptorˉstate {
    let Source: u32 = Bytesˉreadˉu32ˉlittle(
        State.Stackˉslots,
        (State.Stackˉdepth - 3u32) * 4u32
    );
    let Offset: u32 = Bytesˉreadˉu32ˉlittle(
        State.Stackˉslots,
        (State.Stackˉdepth - 2u32) * 4u32
    );
    let Length: u32 = Bytesˉreadˉu32ˉlittle(
        State.Stackˉslots,
        (State.Stackˉdepth - 1u32) * 4u32
    );
    let Depth: u32 = State.Stackˉdepth - 3u32;
    let Target: u32 = Valueˉslot(Shape, 6u8, State.Nextˉbytes);
    return Compilerˉnativeˉx64ˉdescriptorˉstate(
        Descriptors.Compilerˉnativeˉx64ˉemitˉdescriptorˉslice(
            State.Result,
            Source,
            Offset,
            Length,
            Target,
            Instruction.Boundsˉtarget
        ),
        Bytesˉconcat(
            Bytesˉslice(State.Stackˉtypes, 0u32, Depth),
            Bytesˉfromˉu8(6u8)
        ),
        Bytesˉconcat(
            Bytesˉslice(State.Stackˉslots, 0u32, Depth * 4u32),
            Bytesˉfromˉu32ˉlittle(Target)
        ),
        Depth + 1u32,
        State.Nextˉi32,
        State.Nextˉbool,
        State.Nextˉtext,
        State.Nextˉu8,
        State.Nextˉu32,
        State.Nextˉbytes + 1u32
    );
}

fn Emitˉread(
    Instruction: Compilerˉnativeˉx64ˉdescriptorˉinstruction,
    Shape: Compilerˉnativeˉx64ˉdescriptorˉlayout,
    State: Compilerˉnativeˉx64ˉdescriptorˉstate
) -> Compilerˉnativeˉx64ˉdescriptorˉstate {
    let Source: u32 = Bytesˉreadˉu32ˉlittle(
        State.Stackˉslots,
        (State.Stackˉdepth - 2u32) * 4u32
    );
    let Offset: u32 = Bytesˉreadˉu32ˉlittle(
        State.Stackˉslots,
        (State.Stackˉdepth - 1u32) * 4u32
    );
    var Type: u8 = 5u8;
    var Index: u32 = State.Nextˉu32;
    if Instruction.Opcode == 13u8 {
        Type = 4u8;
        Index = State.Nextˉu8;
    }
    if Instruction.Opcode == 114u8 {
        Type = 1u8;
        Index = State.Nextˉi32;
    }
    let Depth: u32 = State.Stackˉdepth - 2u32;
    let Target: u32 = Valueˉslot(Shape, Type, Index);
    var Nextˉi32: u32 = State.Nextˉi32;
    var Nextˉu8: u32 = State.Nextˉu8;
    var Nextˉu32: u32 = State.Nextˉu32;
    if Type == 1u8 { Nextˉi32 = Nextˉi32 + 1u32; }
    if Type == 4u8 { Nextˉu8 = Nextˉu8 + 1u32; }
    if Type == 5u8 { Nextˉu32 = Nextˉu32 + 1u32; }
    return Compilerˉnativeˉx64ˉdescriptorˉstate(
        Descriptors.Compilerˉnativeˉx64ˉemitˉdescriptorˉread(
            State.Result,
            Source,
            Offset,
            Target,
            Instruction.Opcode,
            Instruction.Boundsˉtarget
        ),
        Bytesˉconcat(
            Bytesˉslice(State.Stackˉtypes, 0u32, Depth),
            Bytesˉfromˉu8(Type)
        ),
        Bytesˉconcat(
            Bytesˉslice(State.Stackˉslots, 0u32, Depth * 4u32),
            Bytesˉfromˉu32ˉlittle(Target)
        ),
        Depth + 1u32,
        Nextˉi32,
        State.Nextˉbool,
        State.Nextˉtext,
        Nextˉu8,
        Nextˉu32,
        State.Nextˉbytes
    );
}

fn Emitˉutf8(
    Shape: Compilerˉnativeˉx64ˉdescriptorˉlayout,
    State: Compilerˉnativeˉx64ˉdescriptorˉstate
) -> Compilerˉnativeˉx64ˉdescriptorˉstate {
    let Source: u32 = Bytesˉreadˉu32ˉlittle(
        State.Stackˉslots,
        (State.Stackˉdepth - 1u32) * 4u32
    );
    let Depth: u32 = State.Stackˉdepth - 1u32;
    let Target: u32 = Valueˉslot(Shape, 6u8, State.Nextˉbytes);
    return Compilerˉnativeˉx64ˉdescriptorˉstate(
        Descriptors.Compilerˉnativeˉx64ˉemitˉdescriptorˉcopy(
            State.Result,
            Source,
            Target
        ),
        Bytesˉconcat(
            Bytesˉslice(State.Stackˉtypes, 0u32, Depth),
            Bytesˉfromˉu8(6u8)
        ),
        Bytesˉconcat(
            Bytesˉslice(State.Stackˉslots, 0u32, Depth * 4u32),
            Bytesˉfromˉu32ˉlittle(Target)
        ),
        Depth + 1u32,
        State.Nextˉi32,
        State.Nextˉbool,
        State.Nextˉtext,
        State.Nextˉu8,
        State.Nextˉu32,
        State.Nextˉbytes + 1u32
    );
}

fn Emitˉtextˉconcat(
    Instruction: Compilerˉnativeˉx64ˉdescriptorˉinstruction,
    Shape: Compilerˉnativeˉx64ˉdescriptorˉlayout,
    State: Compilerˉnativeˉx64ˉdescriptorˉstate
) -> Compilerˉnativeˉx64ˉdescriptorˉstate {
    let Left: u32 = Bytesˉreadˉu32ˉlittle(
        State.Stackˉslots,
        (State.Stackˉdepth - 2u32) * 4u32
    );
    let Right: u32 = Bytesˉreadˉu32ˉlittle(
        State.Stackˉslots,
        (State.Stackˉdepth - 1u32) * 4u32
    );
    let Depth: u32 = State.Stackˉdepth - 2u32;
    let Target: u32 = Valueˉslot(Shape, 3u8, State.Nextˉtext);
    return Compilerˉnativeˉx64ˉdescriptorˉstate(
        Runtimeˉdescriptors.Compilerˉnativeˉx64ˉemitˉtextˉconcat(
            State.Result,
            Left,
            Right,
            Target,
            Instruction.Runtimeˉtarget
        ),
        Bytesˉconcat(
            Bytesˉslice(State.Stackˉtypes, 0u32, Depth),
            Bytesˉfromˉu8(3u8)
        ),
        Bytesˉconcat(
            Bytesˉslice(State.Stackˉslots, 0u32, Depth * 4u32),
            Bytesˉfromˉu32ˉlittle(Target)
        ),
        Depth + 1u32,
        State.Nextˉi32,
        State.Nextˉbool,
        State.Nextˉtext + 1u32,
        State.Nextˉu8,
        State.Nextˉu32,
        State.Nextˉbytes
    );
}

fn Emitˉbytesˉconcat(
    Instruction: Compilerˉnativeˉx64ˉdescriptorˉinstruction,
    Shape: Compilerˉnativeˉx64ˉdescriptorˉlayout,
    State: Compilerˉnativeˉx64ˉdescriptorˉstate
) -> Compilerˉnativeˉx64ˉdescriptorˉstate {
    let Left: u32 = Bytesˉreadˉu32ˉlittle(
        State.Stackˉslots,
        (State.Stackˉdepth - 2u32) * 4u32
    );
    let Right: u32 = Bytesˉreadˉu32ˉlittle(
        State.Stackˉslots,
        (State.Stackˉdepth - 1u32) * 4u32
    );
    let Depth: u32 = State.Stackˉdepth - 2u32;
    let Target: u32 = Valueˉslot(Shape, 6u8, State.Nextˉbytes);
    return Compilerˉnativeˉx64ˉdescriptorˉstate(
        Bytesˉconcatenation.Compilerˉnativeˉx64ˉemitˉbytesˉconcat(
            State.Result,
            Left,
            Right,
            Target,
            Instruction.Runtimeˉtarget
        ),
        Bytesˉconcat(
            Bytesˉslice(State.Stackˉtypes, 0u32, Depth),
            Bytesˉfromˉu8(6u8)
        ),
        Bytesˉconcat(
            Bytesˉslice(State.Stackˉslots, 0u32, Depth * 4u32),
            Bytesˉfromˉu32ˉlittle(Target)
        ),
        Depth + 1u32,
        State.Nextˉi32,
        State.Nextˉbool,
        State.Nextˉtext,
        State.Nextˉu8,
        State.Nextˉu32,
        State.Nextˉbytes + 1u32
    );
}

fn Emitˉruntimeˉunary(
    Instruction: Compilerˉnativeˉx64ˉdescriptorˉinstruction,
    Shape: Compilerˉnativeˉx64ˉdescriptorˉlayout,
    State: Compilerˉnativeˉx64ˉdescriptorˉstate
) -> Compilerˉnativeˉx64ˉdescriptorˉstate {
    let Source: u32 = Bytesˉreadˉu32ˉlittle(
        State.Stackˉslots,
        (State.Stackˉdepth - 1u32) * 4u32
    );
    let Depth: u32 = State.Stackˉdepth - 1u32;
    var Type: u8 = 3u8;
    var Index: u32 = State.Nextˉtext;
    if Instruction.Opcode == 115u8 {
        Type = 2u8;
        Index = State.Nextˉbool;
    }
    let Target: u32 = Valueˉslot(Shape, Type, Index);
    var Result: bytes = State.Result;
    if Instruction.Opcode == 112u8 {
        Result = Runtimeˉdescriptors.Compilerˉnativeˉx64ˉemitˉu32ˉformat(
            Result,
            Source,
            Target,
            Instruction.Runtimeˉtarget
        );
    }
    if Instruction.Opcode == 115u8 {
        Result = Runtimeˉdescriptors.Compilerˉnativeˉx64ˉemitˉtextˉutf8ˉisˉvalid(
            Result,
            Source,
            Target,
            Instruction.Runtimeˉtarget
        );
    }
    if Instruction.Opcode == 116u8 {
        Result = Runtimeˉdescriptors.Compilerˉnativeˉx64ˉemitˉtextˉfromˉutf8(
            Result,
            Source,
            Target,
            Instruction.Runtimeˉtarget,
            Instruction.Invalidˉutf8ˉtarget
        );
    }
    if Instruction.Opcode == 117u8 {
        Result = Runtimeˉdescriptors.Compilerˉnativeˉx64ˉemitˉtextˉquote(
            Result,
            Source,
            Target,
            Instruction.Runtimeˉtarget
        );
    }
    var Nextˉbool: u32 = State.Nextˉbool;
    var Nextˉtext: u32 = State.Nextˉtext;
    if Type == 2u8 {
        Nextˉbool = Nextˉbool + 1u32;
    } else {
        Nextˉtext = Nextˉtext + 1u32;
    }
    return Compilerˉnativeˉx64ˉdescriptorˉstate(
        Result,
        Bytesˉconcat(
            Bytesˉslice(State.Stackˉtypes, 0u32, Depth),
            Bytesˉfromˉu8(Type)
        ),
        Bytesˉconcat(
            Bytesˉslice(State.Stackˉslots, 0u32, Depth * 4u32),
            Bytesˉfromˉu32ˉlittle(Target)
        ),
        Depth + 1u32,
        State.Nextˉi32,
        Nextˉbool,
        Nextˉtext,
        State.Nextˉu8,
        State.Nextˉu32,
        State.Nextˉbytes
    );
}

fn Emitˉbyteˉconstruction(
    Instruction: Compilerˉnativeˉx64ˉdescriptorˉinstruction,
    Shape: Compilerˉnativeˉx64ˉdescriptorˉlayout,
    State: Compilerˉnativeˉx64ˉdescriptorˉstate
) -> Compilerˉnativeˉx64ˉdescriptorˉstate {
    let Source: u32 = Bytesˉreadˉu32ˉlittle(
        State.Stackˉslots,
        (State.Stackˉdepth - 1u32) * 4u32
    );
    let Depth: u32 = State.Stackˉdepth - 1u32;
    let Target: u32 = Valueˉslot(Shape, 6u8, State.Nextˉbytes);
    var Result: bytes = State.Result;
    if Instruction.Opcode == 120u8 {
        Result = Bytesˉconcatenation.Compilerˉnativeˉx64ˉemitˉbytesˉfromˉu8(
            Result, Source, Target, Instruction.Runtimeˉtarget
        );
    } else if Instruction.Opcode == 121u8 {
        Result =
            Bytesˉconcatenation.Compilerˉnativeˉx64ˉemitˉbytesˉfromˉu16ˉlittle(
                Result, Source, Target, Instruction.Runtimeˉtarget
            );
    } else {
        Result =
            Bytesˉconcatenation.Compilerˉnativeˉx64ˉemitˉbytesˉfromˉ32ˉlittle(
                Result, Source, Target, Instruction.Runtimeˉtarget
            );
    }
    return Compilerˉnativeˉx64ˉdescriptorˉstate(
        Result,
        Bytesˉconcat(
            Bytesˉslice(State.Stackˉtypes, 0u32, Depth),
            Bytesˉfromˉu8(6u8)
        ),
        Bytesˉconcat(
            Bytesˉslice(State.Stackˉslots, 0u32, Depth * 4u32),
            Bytesˉfromˉu32ˉlittle(Target)
        ),
        Depth + 1u32,
        State.Nextˉi32,
        State.Nextˉbool,
        State.Nextˉtext,
        State.Nextˉu8,
        State.Nextˉu32,
        State.Nextˉbytes + 1u32
    );
}

fn Emitˉu32ˉfromˉu8(
    Shape: Compilerˉnativeˉx64ˉdescriptorˉlayout,
    State: Compilerˉnativeˉx64ˉdescriptorˉstate
) -> Compilerˉnativeˉx64ˉdescriptorˉstate {
    let Source: u32 = Bytesˉreadˉu32ˉlittle(
        State.Stackˉslots,
        (State.Stackˉdepth - 1u32) * 4u32
    );
    let Target: u32 = Valueˉslot(Shape, 5u8, State.Nextˉu32);
    let Result: bytes = Emitˉu32ˉfromˉu8ˉmachineˉcode(
        State.Result,
        Source,
        Target
    );
    return Compilerˉnativeˉx64ˉdescriptorˉstate(
        Result,
        Replaceˉu8(
            State.Stackˉtypes,
            State.Stackˉdepth - 1u32,
            5u8
        ),
        Patchˉu32(
            State.Stackˉslots,
            (State.Stackˉdepth - 1u32) * 4u32,
            Target
        ),
        State.Stackˉdepth,
        State.Nextˉi32,
        State.Nextˉbool,
        State.Nextˉtext,
        State.Nextˉu8,
        State.Nextˉu32 + 1u32,
        State.Nextˉbytes
    );
}

export fn Compilerˉnativeˉx64ˉemitˉdescriptorˉinstruction(
    Instruction: Compilerˉnativeˉx64ˉdescriptorˉinstruction,
    Shape: Compilerˉnativeˉx64ˉdescriptorˉlayout,
    Data: Staticˉdata.Compilerˉnativeˉx64ˉdata,
    State: Compilerˉnativeˉx64ˉdescriptorˉstate
) -> Compilerˉnativeˉx64ˉdescriptorˉstate {
    if Instruction.Opcode == 3u8 || Instruction.Opcode == 10u8 {
        return Emitˉconstant(Instruction, Shape, Data, State);
    }
    if Instruction.Opcode == 11u8 { return Emitˉlength(Shape, State); }
    if Instruction.Opcode == 12u8 {
        return Emitˉslice(Instruction, Shape, State);
    }
    if Instruction.Opcode == 13u8 || Instruction.Opcode == 14u8 ||
        Instruction.Opcode == 15u8 || Instruction.Opcode == 114u8 {
        return Emitˉread(Instruction, Shape, State);
    }
    if Instruction.Opcode == 113u8 {
        return Emitˉtextˉconcat(Instruction, Shape, State);
    }
    if Instruction.Opcode == 118u8 {
        return Emitˉu32ˉfromˉu8(Shape, State);
    }
    if Instruction.Opcode == 161u8 || Instruction.Opcode == 162u8 {
        return Emitˉu32ˉdivision(Instruction, Shape, State);
    }
    if Instruction.Opcode == 119u8 {
        return Emitˉbytesˉconcat(Instruction, Shape, State);
    }
    if Instruction.Opcode == 120u8 || Instruction.Opcode == 121u8 ||
        Instruction.Opcode == 122u8 ||
        Instruction.Opcode == 123u8 {
        return Emitˉbyteˉconstruction(Instruction, Shape, State);
    }
    if Instruction.Opcode == 112u8 || Instruction.Opcode == 115u8 ||
        Instruction.Opcode == 116u8 ||
        Instruction.Opcode == 117u8 {
        return Emitˉruntimeˉunary(Instruction, Shape, State);
    }
    return Emitˉutf8(Shape, State);
}
