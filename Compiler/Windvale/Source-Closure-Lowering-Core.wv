module Compilerˉsourceˉclosureˉlowering profile portable;

export enum Compilerˉsourceˉclosureˉloweringˉstatus {
    Valid = 0;
    Invalidˉevidence = 1;
    Instanceˉlimit = 2;
    Retainedˉlimit = 3;
    Estimatedˉlimit = 4;
    Invalidˉsite = 5;
    Invalidˉtype = 6;
    Invalidˉcaptures = 7;
}

export record Compilerˉsourceˉclosureˉcatalog {
    Status: Compilerˉsourceˉclosureˉloweringˉstatus;
    Evidence: bytes;
}

export record Compilerˉsourceˉclosureˉadmission {
    Status: Compilerˉsourceˉclosureˉloweringˉstatus;
    Catalogˉevidence: bytes;
    Instance: u32;
    Reused: bool;
}

const CLOSURE_CATALOG_HEADER_BYTES: u32 = 24u32;
const CLOSURE_CATALOG_ENTRY_BYTES: u32 = 24u32;
const CLOSURE_CATALOG_INSTANCE_LIMIT: u32 = 256u32;
const CLOSURE_CATALOG_CAPTURE_LIMIT: u32 = 64u32;
const CLOSURE_CATALOG_RETAINED_LIMIT: u32 = 8192u32;
const CLOSURE_CATALOG_ESTIMATED_LIMIT: u32 = 16777216u32;

fn Compilerˉsourceˉclosureˉloweringˉsentinel() -> u32 {
    return 4294967295u32;
}

fn Compilerˉsourceˉclosureˉloweringˉappendˉu32(
    Input: bytes,
    Value: u32
) -> bytes {
    return Bytesˉconcat(Input, Bytesˉfromˉu32ˉlittle(Value));
}

fn Compilerˉsourceˉclosureˉcatalogˉheader(
    Instances: u32,
    Maximumˉcaptures: u32,
    Retainedˉbytes: u32,
    Estimatedˉbytes: u32
) -> bytes {
    var Result: bytes = Textˉtoˉutf8("WVCL");
    Result = Bytesˉconcat(Result, Bytesˉfromˉu16ˉlittle(1u32));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu16ˉlittle(0u32));
    Result = Compilerˉsourceˉclosureˉloweringˉappendˉu32(
        Result, Instances
    );
    Result = Compilerˉsourceˉclosureˉloweringˉappendˉu32(
        Result, Maximumˉcaptures
    );
    Result = Compilerˉsourceˉclosureˉloweringˉappendˉu32(
        Result, Retainedˉbytes
    );
    return Compilerˉsourceˉclosureˉloweringˉappendˉu32(
        Result, Estimatedˉbytes
    );
}

fn Compilerˉsourceˉclosureˉcatalogˉvalue(
    Status: Compilerˉsourceˉclosureˉloweringˉstatus,
    Evidence: bytes
) -> Compilerˉsourceˉclosureˉcatalog {
    return Compilerˉsourceˉclosureˉcatalog(Status, Evidence);
}

fn Compilerˉsourceˉclosureˉadmissionˉvalue(
    Status: Compilerˉsourceˉclosureˉloweringˉstatus,
    Evidence: bytes,
    Instance: u32,
    Reused: bool
) -> Compilerˉsourceˉclosureˉadmission {
    return Compilerˉsourceˉclosureˉadmission(
        Status, Evidence, Instance, Reused
    );
}

export fn Compilerˉsourceˉclosureˉcatalogˉempty(
) -> Compilerˉsourceˉclosureˉcatalog {
    return Compilerˉsourceˉclosureˉcatalogˉvalue(
        Compilerˉsourceˉclosureˉloweringˉstatus.Valid,
        Compilerˉsourceˉclosureˉcatalogˉheader(
            0u32, 0u32, CLOSURE_CATALOG_HEADER_BYTES, 0u32
        )
    );
}

export fn Compilerˉsourceˉclosureˉcatalogˉinstances(
    Catalog: Compilerˉsourceˉclosureˉcatalog
) -> u32 {
    if Bytesˉlength(Catalog.Evidence) < CLOSURE_CATALOG_HEADER_BYTES {
        return 0u32;
    }
    return Bytesˉreadˉu32ˉlittle(Catalog.Evidence, 8u32);
}

fn Compilerˉsourceˉclosureˉcatalogˉentryˉcursor(
    Catalog: Compilerˉsourceˉclosureˉcatalog,
    Instance: u32
) -> u32 {
    if Instance >= Compilerˉsourceˉclosureˉcatalogˉinstances(Catalog) {
        return Compilerˉsourceˉclosureˉloweringˉsentinel();
    }
    return CLOSURE_CATALOG_HEADER_BYTES +
        Instance * CLOSURE_CATALOG_ENTRY_BYTES;
}

fn Compilerˉsourceˉclosureˉsiteˉisˉequal(
    Evidence: bytes,
    Cursor: u32,
    Module: u32,
    Parentˉfunction: u32,
    Offset: u32,
    Length: u32
) -> bool {
    return Bytesˉreadˉu32ˉlittle(Evidence, Cursor) == Module &&
        Bytesˉreadˉu32ˉlittle(Evidence, Cursor + 4u32) ==
            Parentˉfunction &&
        Bytesˉreadˉu32ˉlittle(Evidence, Cursor + 8u32) == Offset &&
        Bytesˉreadˉu32ˉlittle(Evidence, Cursor + 12u32) == Length;
}

export fn Compilerˉsourceˉclosureˉcatalogˉisˉvalid(
    Catalog: Compilerˉsourceˉclosureˉcatalog
) -> bool {
    let Length: u32 = Bytesˉlength(Catalog.Evidence);
    if Catalog.Status != Compilerˉsourceˉclosureˉloweringˉstatus.Valid ||
        Length < CLOSURE_CATALOG_HEADER_BYTES ||
        Length > CLOSURE_CATALOG_RETAINED_LIMIT {
        return false;
    }
    if Bytesˉreadˉu8(Catalog.Evidence, 0u32) != 87u8 ||
        Bytesˉreadˉu8(Catalog.Evidence, 1u32) != 86u8 ||
        Bytesˉreadˉu8(Catalog.Evidence, 2u32) != 67u8 ||
        Bytesˉreadˉu8(Catalog.Evidence, 3u32) != 76u8 ||
        Bytesˉreadˉu16ˉlittle(Catalog.Evidence, 4u32) != 1u32 ||
        Bytesˉreadˉu16ˉlittle(Catalog.Evidence, 6u32) != 0u32 {
        return false;
    }
    let Instances: u32 = Bytesˉreadˉu32ˉlittle(
        Catalog.Evidence, 8u32
    );
    let Maximumˉcaptures: u32 = Bytesˉreadˉu32ˉlittle(
        Catalog.Evidence, 12u32
    );
    let Retainedˉbytes: u32 = Bytesˉreadˉu32ˉlittle(
        Catalog.Evidence, 16u32
    );
    let Estimatedˉbytes: u32 = Bytesˉreadˉu32ˉlittle(
        Catalog.Evidence, 20u32
    );
    if Instances > CLOSURE_CATALOG_INSTANCE_LIMIT ||
        Maximumˉcaptures > CLOSURE_CATALOG_CAPTURE_LIMIT ||
        Retainedˉbytes != Length ||
        Estimatedˉbytes > CLOSURE_CATALOG_ESTIMATED_LIMIT ||
        Length != CLOSURE_CATALOG_HEADER_BYTES +
            Instances * CLOSURE_CATALOG_ENTRY_BYTES {
        return false;
    }
    var Exactˉmaximum: u32 = 0u32;
    var Exactˉestimated: u32 = 0u32;
    var Instance: u32 = 0u32;
    while Instance < Instances {
        let Cursor: u32 = CLOSURE_CATALOG_HEADER_BYTES +
            Instance * CLOSURE_CATALOG_ENTRY_BYTES;
        let Module: u32 = Bytesˉreadˉu32ˉlittle(
            Catalog.Evidence, Cursor
        );
        let Parentˉfunction: u32 = Bytesˉreadˉu32ˉlittle(
            Catalog.Evidence, Cursor + 4u32
        );
        let Offset: u32 = Bytesˉreadˉu32ˉlittle(
            Catalog.Evidence, Cursor + 8u32
        );
        let Sourceˉlength: u32 = Bytesˉreadˉu32ˉlittle(
            Catalog.Evidence, Cursor + 12u32
        );
        let Functionˉtype: u32 = Bytesˉreadˉu32ˉlittle(
            Catalog.Evidence, Cursor + 16u32
        );
        let Captures: u32 = Bytesˉreadˉu32ˉlittle(
            Catalog.Evidence, Cursor + 20u32
        );
        if Module == Compilerˉsourceˉclosureˉloweringˉsentinel() ||
            Parentˉfunction ==
                Compilerˉsourceˉclosureˉloweringˉsentinel() ||
            Functionˉtype >= CLOSURE_CATALOG_INSTANCE_LIMIT ||
            Sourceˉlength == 0u32 ||
            Sourceˉlength > 4294967295u32 - Offset ||
            Captures == 0u32 ||
            Captures > CLOSURE_CATALOG_CAPTURE_LIMIT ||
            Sourceˉlength >
                CLOSURE_CATALOG_ESTIMATED_LIMIT - Exactˉestimated {
            return false;
        }
        var Prior: u32 = 0u32;
        while Prior < Instance {
            let Priorˉcursor: u32 = CLOSURE_CATALOG_HEADER_BYTES +
                Prior * CLOSURE_CATALOG_ENTRY_BYTES;
            if Compilerˉsourceˉclosureˉsiteˉisˉequal(
                    Catalog.Evidence, Priorˉcursor,
                    Module, Parentˉfunction, Offset, Sourceˉlength
                ) {
                return false;
            }
            Prior = Prior + 1u32;
        }
        if Captures > Exactˉmaximum { Exactˉmaximum = Captures; }
        Exactˉestimated = Exactˉestimated + Sourceˉlength;
        Instance = Instance + 1u32;
    }
    return Maximumˉcaptures == Exactˉmaximum &&
        Estimatedˉbytes == Exactˉestimated;
}

fn Compilerˉsourceˉclosureˉcatalogˉentry(
    Module: u32,
    Parentˉfunction: u32,
    Offset: u32,
    Length: u32,
    Functionˉtype: u32,
    Captures: u32
) -> bytes {
    var Result: bytes = Bytesˉfromˉu32ˉlittle(Module);
    Result = Compilerˉsourceˉclosureˉloweringˉappendˉu32(
        Result, Parentˉfunction
    );
    Result = Compilerˉsourceˉclosureˉloweringˉappendˉu32(Result, Offset);
    Result = Compilerˉsourceˉclosureˉloweringˉappendˉu32(Result, Length);
    Result = Compilerˉsourceˉclosureˉloweringˉappendˉu32(
        Result, Functionˉtype
    );
    return Compilerˉsourceˉclosureˉloweringˉappendˉu32(
        Result, Captures
    );
}

export fn Compilerˉsourceˉclosureˉcatalogˉadmit(
    Catalog: Compilerˉsourceˉclosureˉcatalog,
    Modules: u32,
    Functions: u32,
    Sourceˉbytes: u32,
    Functionˉtypes: u32,
    Module: u32,
    Parentˉfunction: u32,
    Offset: u32,
    Length: u32,
    Functionˉtype: u32,
    Captures: u32
) -> Compilerˉsourceˉclosureˉadmission {
    if !Compilerˉsourceˉclosureˉcatalogˉisˉvalid(Catalog) {
        return Compilerˉsourceˉclosureˉadmissionˉvalue(
            Compilerˉsourceˉclosureˉloweringˉstatus.Invalidˉevidence,
            Catalog.Evidence,
            Compilerˉsourceˉclosureˉloweringˉsentinel(), false
        );
    }
    if Modules == 0u32 || Functions == 0u32 || Module >= Modules ||
        Parentˉfunction >= Functions || Length == 0u32 ||
        Offset >= Sourceˉbytes || Length > Sourceˉbytes - Offset {
        return Compilerˉsourceˉclosureˉadmissionˉvalue(
            Compilerˉsourceˉclosureˉloweringˉstatus.Invalidˉsite,
            Catalog.Evidence,
            Compilerˉsourceˉclosureˉloweringˉsentinel(), false
        );
    }
    if Functionˉtypes == 0u32 ||
        Functionˉtypes > CLOSURE_CATALOG_INSTANCE_LIMIT ||
        Functionˉtype >= Functionˉtypes {
        return Compilerˉsourceˉclosureˉadmissionˉvalue(
            Compilerˉsourceˉclosureˉloweringˉstatus.Invalidˉtype,
            Catalog.Evidence,
            Compilerˉsourceˉclosureˉloweringˉsentinel(), false
        );
    }
    if Captures == 0u32 || Captures > CLOSURE_CATALOG_CAPTURE_LIMIT {
        return Compilerˉsourceˉclosureˉadmissionˉvalue(
            Compilerˉsourceˉclosureˉloweringˉstatus.Invalidˉcaptures,
            Catalog.Evidence,
            Compilerˉsourceˉclosureˉloweringˉsentinel(), false
        );
    }
    let Instances: u32 =
        Compilerˉsourceˉclosureˉcatalogˉinstances(Catalog);
    var Instance: u32 = 0u32;
    while Instance < Instances {
        let Cursor: u32 =
            Compilerˉsourceˉclosureˉcatalogˉentryˉcursor(
                Catalog, Instance
            );
        if Compilerˉsourceˉclosureˉsiteˉisˉequal(
                Catalog.Evidence, Cursor,
                Module, Parentˉfunction, Offset, Length
            ) {
            if Bytesˉreadˉu32ˉlittle(
                    Catalog.Evidence, Cursor + 16u32
                ) != Functionˉtype ||
                Bytesˉreadˉu32ˉlittle(
                    Catalog.Evidence, Cursor + 20u32
                ) != Captures {
                return Compilerˉsourceˉclosureˉadmissionˉvalue(
                    Compilerˉsourceˉclosureˉloweringˉstatus.Invalidˉsite,
                    Catalog.Evidence,
                    Compilerˉsourceˉclosureˉloweringˉsentinel(), false
                );
            }
            return Compilerˉsourceˉclosureˉadmissionˉvalue(
                Compilerˉsourceˉclosureˉloweringˉstatus.Valid,
                Catalog.Evidence, Instance, true
            );
        }
        Instance = Instance + 1u32;
    }
    if Instances >= CLOSURE_CATALOG_INSTANCE_LIMIT {
        return Compilerˉsourceˉclosureˉadmissionˉvalue(
            Compilerˉsourceˉclosureˉloweringˉstatus.Instanceˉlimit,
            Catalog.Evidence,
            Compilerˉsourceˉclosureˉloweringˉsentinel(), false
        );
    }
    if Bytesˉlength(Catalog.Evidence) >
            CLOSURE_CATALOG_RETAINED_LIMIT -
                CLOSURE_CATALOG_ENTRY_BYTES {
        return Compilerˉsourceˉclosureˉadmissionˉvalue(
            Compilerˉsourceˉclosureˉloweringˉstatus.Retainedˉlimit,
            Catalog.Evidence,
            Compilerˉsourceˉclosureˉloweringˉsentinel(), false
        );
    }
    let Priorˉestimated: u32 = Bytesˉreadˉu32ˉlittle(
        Catalog.Evidence, 20u32
    );
    if Length > CLOSURE_CATALOG_ESTIMATED_LIMIT - Priorˉestimated {
        return Compilerˉsourceˉclosureˉadmissionˉvalue(
            Compilerˉsourceˉclosureˉloweringˉstatus.Estimatedˉlimit,
            Catalog.Evidence,
            Compilerˉsourceˉclosureˉloweringˉsentinel(), false
        );
    }
    var Maximumˉcaptures: u32 = Bytesˉreadˉu32ˉlittle(
        Catalog.Evidence, 12u32
    );
    if Captures > Maximumˉcaptures { Maximumˉcaptures = Captures; }
    let Payload: bytes = Bytesˉconcat(
        Bytesˉslice(
            Catalog.Evidence, CLOSURE_CATALOG_HEADER_BYTES,
            Bytesˉlength(Catalog.Evidence) - CLOSURE_CATALOG_HEADER_BYTES
        ),
        Compilerˉsourceˉclosureˉcatalogˉentry(
            Module, Parentˉfunction, Offset, Length,
            Functionˉtype, Captures
        )
    );
    let Evidence: bytes = Bytesˉconcat(
        Compilerˉsourceˉclosureˉcatalogˉheader(
            Instances + 1u32,
            Maximumˉcaptures,
            CLOSURE_CATALOG_HEADER_BYTES + Bytesˉlength(Payload),
            Priorˉestimated + Length
        ),
        Payload
    );
    let Result: Compilerˉsourceˉclosureˉcatalog =
        Compilerˉsourceˉclosureˉcatalogˉvalue(
            Compilerˉsourceˉclosureˉloweringˉstatus.Valid, Evidence
        );
    if !Compilerˉsourceˉclosureˉcatalogˉisˉvalid(Result) {
        return Compilerˉsourceˉclosureˉadmissionˉvalue(
            Compilerˉsourceˉclosureˉloweringˉstatus.Invalidˉevidence,
            Catalog.Evidence,
            Compilerˉsourceˉclosureˉloweringˉsentinel(), false
        );
    }
    return Compilerˉsourceˉclosureˉadmissionˉvalue(
        Compilerˉsourceˉclosureˉloweringˉstatus.Valid,
        Evidence, Instances, false
    );
}

export fn Compilerˉsourceˉclosureˉcatalogˉfromˉadmission(
    Admission: Compilerˉsourceˉclosureˉadmission
) -> Compilerˉsourceˉclosureˉcatalog {
    return Compilerˉsourceˉclosureˉcatalog(
        Admission.Status, Admission.Catalogˉevidence
    );
}

export fn Compilerˉsourceˉclosureˉcatalogˉmodule(
    Catalog: Compilerˉsourceˉclosureˉcatalog,
    Instance: u32
) -> u32 {
    let Cursor: u32 = Compilerˉsourceˉclosureˉcatalogˉentryˉcursor(
        Catalog, Instance
    );
    if Cursor == Compilerˉsourceˉclosureˉloweringˉsentinel() {
        return Compilerˉsourceˉclosureˉloweringˉsentinel();
    }
    return Bytesˉreadˉu32ˉlittle(Catalog.Evidence, Cursor);
}

export fn Compilerˉsourceˉclosureˉcatalogˉparentˉfunction(
    Catalog: Compilerˉsourceˉclosureˉcatalog,
    Instance: u32
) -> u32 {
    let Cursor: u32 = Compilerˉsourceˉclosureˉcatalogˉentryˉcursor(
        Catalog, Instance
    );
    if Cursor == Compilerˉsourceˉclosureˉloweringˉsentinel() {
        return Compilerˉsourceˉclosureˉloweringˉsentinel();
    }
    return Bytesˉreadˉu32ˉlittle(Catalog.Evidence, Cursor + 4u32);
}

export fn Compilerˉsourceˉclosureˉcatalogˉoffset(
    Catalog: Compilerˉsourceˉclosureˉcatalog,
    Instance: u32
) -> u32 {
    let Cursor: u32 = Compilerˉsourceˉclosureˉcatalogˉentryˉcursor(
        Catalog, Instance
    );
    if Cursor == Compilerˉsourceˉclosureˉloweringˉsentinel() {
        return Compilerˉsourceˉclosureˉloweringˉsentinel();
    }
    return Bytesˉreadˉu32ˉlittle(Catalog.Evidence, Cursor + 8u32);
}

export fn Compilerˉsourceˉclosureˉcatalogˉlength(
    Catalog: Compilerˉsourceˉclosureˉcatalog,
    Instance: u32
) -> u32 {
    let Cursor: u32 = Compilerˉsourceˉclosureˉcatalogˉentryˉcursor(
        Catalog, Instance
    );
    if Cursor == Compilerˉsourceˉclosureˉloweringˉsentinel() {
        return 0u32;
    }
    return Bytesˉreadˉu32ˉlittle(Catalog.Evidence, Cursor + 12u32);
}

export fn Compilerˉsourceˉclosureˉcatalogˉfunctionˉtype(
    Catalog: Compilerˉsourceˉclosureˉcatalog,
    Instance: u32
) -> u32 {
    let Cursor: u32 = Compilerˉsourceˉclosureˉcatalogˉentryˉcursor(
        Catalog, Instance
    );
    if Cursor == Compilerˉsourceˉclosureˉloweringˉsentinel() {
        return Compilerˉsourceˉclosureˉloweringˉsentinel();
    }
    return Bytesˉreadˉu32ˉlittle(Catalog.Evidence, Cursor + 16u32);
}

export fn Compilerˉsourceˉclosureˉcatalogˉcaptures(
    Catalog: Compilerˉsourceˉclosureˉcatalog,
    Instance: u32
) -> u32 {
    let Cursor: u32 = Compilerˉsourceˉclosureˉcatalogˉentryˉcursor(
        Catalog, Instance
    );
    if Cursor == Compilerˉsourceˉclosureˉloweringˉsentinel() {
        return 0u32;
    }
    return Bytesˉreadˉu32ˉlittle(Catalog.Evidence, Cursor + 20u32);
}

export fn Compilerˉsourceˉclosureˉcatalogˉtarget(
    Baseˉfunctions: u32,
    Instance: u32
) -> u32 {
    if Instance >= CLOSURE_CATALOG_INSTANCE_LIMIT ||
        Baseˉfunctions > 4294967295u32 - Instance {
        return Compilerˉsourceˉclosureˉloweringˉsentinel();
    }
    return Baseˉfunctions + Instance;
}
