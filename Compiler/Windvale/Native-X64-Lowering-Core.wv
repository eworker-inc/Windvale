        );
    }
    if Opcode == 221u8 {
        return Unsafeˉscratch.Compilerˉnativeˉx64ˉunsafeˉscratchˉlengthˉbytes(
            Bytesˉreadˉu16ˉlittle(Input, 6u32)
        );
    }
    if Opcode == 222u8 {
        return Unsafeˉwriteˉregion.Compilerˉnativeˉx64ˉunsafeˉwriteˉregionˉbytes(
            Bytesˉreadˉu16ˉlittle(Input, 6u32)
        );
    }
    if Opcode == 223u8 {
        if Bytesˉreadˉu16ˉlittle(Input, 6u32) == 38u32 { return 61u32; }
        return 45u32;
