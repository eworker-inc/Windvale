                                                            let Returnˉtypeˉindex: u32 =
                                                                Nominalˉtypes.Compilerˉnativeˉx64ˉrecordˉtypeˉindex(
                                                                    Function.Returnˉtype
                                                                );
                                                            Bodyˉbytes = Bodyˉbytes +
                                                                Records.Compilerˉnativeˉx64ˉrecordˉreturnˉbytes(
                                                                    Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉitemˉcount(
                                                                        Types,
                                                                        Returnˉtypeˉindex
                                                                    ),
                                                                    Nominalˉtypes.Compilerˉnativeˉx64ˉrecordˉhasˉdescriptors(
                                                                        Input,
                                                                        Types,
                                                                        Returnˉtypeˉindex
                                                                    )
                                                                );
                                                        } else {
                                                        if Isˉmain {
                                                            Bodyˉbytes = Bodyˉbytes + 30u32;
                                                        } else {
                                                            Bodyˉbytes = Bodyˉbytes + 28u32;
                                                        }
                                                        }
                                                    }
                                                }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        }
                        }
                    }
                }
            }
        }
        }
        if Depth > Maximum { Maximum = Depth; }
        Cursor = Next;
    }
    if Terminator == 0u8 {
        if Depth != 0u32 { return Compilerˉnativeˉx64ˉinvalidˉblock(); }
        if End == Length { return Compilerˉnativeˉx64ˉinvalidˉblock(); }
    }
    return Compilerˉnativeˉx64ˉblockˉanalysis(
        true,
        End,
        I32ˉvalues,
        Boolˉvalues,
        Textˉvalues,
        U8ˉvalues,
        U32ˉvalues,
        Bytesˉvalues,
        Enumˉvalues,
        Recordˉvalues,
        Maximum,
        Bodyˉbytes,
        Terminator,
        Target
    );
}

export fn Compilerˉnativeˉx64ˉanalyzeˉcontrolˉcode(
    Input: bytes,
    Section: Compilerˉnativeˉx64ˉsection,
    Function: Compilerˉnativeˉx64ˉfunction,
    Isˉmain: bool,
    Callableˉfunctions: u32,
    Callˉdirectory: bytes,
    Data: Staticˉdata.Compilerˉnativeˉx64ˉdata,
    Types: Nominalˉtypes.Compilerˉnativeˉx64ˉtypes,
    Capabilityˉtable: Nativeˉcapabilities.Compilerˉnativeˉx64ˉcapabilities
) -> Compilerˉnativeˉx64ˉcontrolˉanalysis {
    if Section.Payloadˉlength != Function.Codeˉlength {
        return Compilerˉnativeˉx64ˉemptyˉcontrolˉanalysis(Input);
    }
    let Length: u32 = Section.Payloadˉlength;
    var Instructionsˉmap: bytes = Compilerˉnativeˉx64ˉzeroˉmap(Input, Length);
    var Leaders: bytes = Compilerˉnativeˉx64ˉzeroˉmap(Input, Length);
    Leaders = Compilerˉnativeˉx64ˉreplaceˉbyte(Leaders, 0u32, 1u8);
    var Instructionˉcount: u32 = 0u32;
    var Cursor: u32 = 0u32;
    while Cursor < Length {
        let Opcode: u8 = Bytesˉreadˉu8(Input, Section.Payloadˉoffset + Cursor);
        let Size: u32 = Compilerˉnativeˉx64ˉinstructionˉsize(Opcode);
        if Size == 0u32 {
            return Compilerˉnativeˉx64ˉemptyˉcontrolˉanalysis(Input);
        }
        if Size > Length - Cursor {
            return Compilerˉnativeˉx64ˉemptyˉcontrolˉanalysis(Input);
        }
        if Opcode == 2u8 {
            if U32ˉfromˉu8(
                Bytesˉreadˉu8(Input, Section.Payloadˉoffset + Cursor + 1u32)
            ) > 1u32 {
                return Compilerˉnativeˉx64ˉemptyˉcontrolˉanalysis(Input);
            }
        }
        Instructionˉcount = Instructionˉcount + 1u32;
        if Instructionˉcount > 1024u32 {
            return Compilerˉnativeˉx64ˉemptyˉcontrolˉanalysis(Input);
        }
        Instructionsˉmap = Compilerˉnativeˉx64ˉreplaceˉbyte(
            Instructionsˉmap,
            Cursor,
            1u8
        );
        let Next: u32 = Cursor + Size;
        if Opcode == 48u8 {
            let Jumpˉtarget: u32 = Bytesˉreadˉu32ˉlittle(
                Input,
                Section.Payloadˉoffset + Cursor + 1u32
            );
            if Jumpˉtarget >= Length {
                return Compilerˉnativeˉx64ˉemptyˉcontrolˉanalysis(Input);
            }
            Leaders = Compilerˉnativeˉx64ˉreplaceˉbyte(
                Leaders,
                Jumpˉtarget,
                1u8
            );
        }
        if Opcode == 49u8 {
            let Branchˉtarget: u32 = Bytesˉreadˉu32ˉlittle(
                Input,
                Section.Payloadˉoffset + Cursor + 1u32
            );
            if Branchˉtarget >= Length {
                return Compilerˉnativeˉx64ˉemptyˉcontrolˉanalysis(Input);
            }
            if Next >= Length {
                return Compilerˉnativeˉx64ˉemptyˉcontrolˉanalysis(Input);
            }
            Leaders = Compilerˉnativeˉx64ˉreplaceˉbyte(
                Leaders,
                Branchˉtarget,
                1u8
            );
            Leaders = Compilerˉnativeˉx64ˉreplaceˉbyte(Leaders, Next, 1u8);
        }
        Cursor = Next;
    }

    var Blocks: u32 = 0u32;
    Cursor = 0u32;
    while Cursor < Length {
        if Bytesˉreadˉu8(Leaders, Cursor) == 1u8 {
            if Bytesˉreadˉu8(Instructionsˉmap, Cursor) != 1u8 {
                return Compilerˉnativeˉx64ˉemptyˉcontrolˉanalysis(Input);
            }
            Blocks = Blocks + 1u32;
        }
        Cursor = Cursor + 1u32;
    }

    var I32ˉslots: u32 = 0u32;
    var Boolˉslots: u32 = 0u32;
    var Textˉslots: u32 = 0u32;
    var U8ˉslots: u32 = 0u32;
    var U32ˉslots: u32 = 0u32;
    var Bytesˉslots: u32 = 0u32;
    var Enumˉslots: u32 = 0u32;
    var Recordˉslots: u32 = 0u32;
    var Maximumˉstack: u32 = 0u32;
    var Bodyˉbytes: u32 = 0u32;
    Cursor = 0u32;
    while Cursor < Length {
        if Bytesˉreadˉu8(Leaders, Cursor) != 1u8 {
            return Compilerˉnativeˉx64ˉemptyˉcontrolˉanalysis(Input);
        }
        let Block: Compilerˉnativeˉx64ˉblockˉanalysis =
            Compilerˉnativeˉx64ˉanalyzeˉblock(
                Input,
                Section,
                Function,
                Leaders,
                Instructionsˉmap,
                Cursor,
                Isˉmain,
                Callableˉfunctions,
                Callˉdirectory,
                Data,
                Types,
                Capabilityˉtable
            );
        if !Block.Valid {
            return Compilerˉnativeˉx64ˉemptyˉcontrolˉanalysis(Input);
        }
        if Block.I32ˉvalues > I32ˉslots { I32ˉslots = Block.I32ˉvalues; }
        if Block.Boolˉvalues > Boolˉslots { Boolˉslots = Block.Boolˉvalues; }
        if Block.Textˉvalues > Textˉslots { Textˉslots = Block.Textˉvalues; }
        if Block.U8ˉvalues > U8ˉslots { U8ˉslots = Block.U8ˉvalues; }
        if Block.U32ˉvalues > U32ˉslots { U32ˉslots = Block.U32ˉvalues; }
        if Block.Bytesˉvalues > Bytesˉslots { Bytesˉslots = Block.Bytesˉvalues; }
        if Block.Enumˉvalues > Enumˉslots { Enumˉslots = Block.Enumˉvalues; }
        if Block.Recordˉvalues > Recordˉslots {
            Recordˉslots = Block.Recordˉvalues;
        }
        if Block.Maximumˉstack > Maximumˉstack {
            Maximumˉstack = Block.Maximumˉstack;
        }
        Bodyˉbytes = Bodyˉbytes + Block.Bodyˉbytes;
        Cursor = Block.Next;
    }

    var Reachable: bytes = Compilerˉnativeˉx64ˉzeroˉmap(Input, Length);
    Reachable = Compilerˉnativeˉx64ˉreplaceˉbyte(Reachable, 0u32, 1u8);
    var Reachˉiteration: u32 = 0u32;
    while Reachˉiteration < Blocks {
        Cursor = 0u32;
        while Cursor < Length {
            let Reachˉblock: Compilerˉnativeˉx64ˉblockˉanalysis =
                Compilerˉnativeˉx64ˉanalyzeˉblock(
                    Input,
                    Section,
                    Function,
                    Leaders,
                    Instructionsˉmap,
                    Cursor,
                    Isˉmain,
                    Callableˉfunctions,
                    Callˉdirectory,
                    Data,
                    Types,
                    Capabilityˉtable
                );
            if Bytesˉreadˉu8(Reachable, Cursor) == 1u8 {
                if Reachˉblock.Terminator == 0u8 {
                    Reachable = Compilerˉnativeˉx64ˉreplaceˉbyte(
                        Reachable,
                        Reachˉblock.Next,
                        1u8
                    );
                }
                if Reachˉblock.Terminator == 1u8 {
                    Reachable = Compilerˉnativeˉx64ˉreplaceˉbyte(
                        Reachable,
                        Reachˉblock.Target,
                        1u8
                    );
                }
                if Reachˉblock.Terminator == 2u8 {
                    Reachable = Compilerˉnativeˉx64ˉreplaceˉbyte(
                        Reachable,
                        Reachˉblock.Next,
                        1u8
                    );
                    Reachable = Compilerˉnativeˉx64ˉreplaceˉbyte(
                        Reachable,
                        Reachˉblock.Target,
                        1u8
                    );
                }
            }
            Cursor = Reachˉblock.Next;
        }
        Reachˉiteration = Reachˉiteration + 1u32;
    }
    Cursor = 0u32;
    while Cursor < Length {
        if Bytesˉreadˉu8(Leaders, Cursor) == 1u8 {
            if Bytesˉreadˉu8(Reachable, Cursor) != 1u8 {
                return Compilerˉnativeˉx64ˉemptyˉcontrolˉanalysis(Input);
            }
        }
        Cursor = Cursor + 1u32;
    }
    if Maximumˉstack != Function.Maximumˉstack {
        return Compilerˉnativeˉx64ˉemptyˉcontrolˉanalysis(Input);
    }
    var Hasˉrecords: bool = Recordˉslots > 0u32 ||
        Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉisˉrecord(
            Function.Returnˉtype
        );
    var Local: u32 = 0u32;
    while Local < Function.Locals {
        if Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉisˉrecord(
            Bytesˉreadˉu8(Function.Localˉtypes, Local)
        ) { Hasˉrecords = true; }
        Local = Local + 1u32;
    }
    var Storage: Recordˉstorage.Compilerˉnativeˉx64ˉrecordˉstorage =
        Recordˉstorage.Compilerˉnativeˉx64ˉemptyˉrecordˉstorage(Input);
    if Hasˉrecords {
        Storage = Recordˉstorage.Compilerˉnativeˉx64ˉrecordˉstorageˉread(
            Input,
            Section.Payloadˉoffset,
            Section.Payloadˉlength,
            Function.Parameters,
            Function.Returnˉtype,
            Function.Localˉtypes,
            Callˉdirectory,
            Types,
            Blocks,
            Leaders
        );
        if !Storage.Valid {
            return Compilerˉnativeˉx64ˉemptyˉcontrolˉanalysis(Input);
        }
        if Storage.Recordˉvalues != Recordˉslots {
            return Compilerˉnativeˉx64ˉemptyˉcontrolˉanalysis(Input);
        }
    }
    if Function.Locals + I32ˉslots + Boolˉslots + Textˉslots + U8ˉslots +
        U32ˉslots + Bytesˉslots + Enumˉslots + Recordˉslots +
        Storage.Persistentˉfields + Storage.Scratchˉfields +
        Compilerˉnativeˉx64ˉhiddenˉrecordˉslots(Function.Returnˉtype) >
        2048u32 {
        return Compilerˉnativeˉx64ˉemptyˉcontrolˉanalysis(Input);
    }
    return Compilerˉnativeˉx64ˉcontrolˉanalysis(
        true,
        I32ˉslots,
        Boolˉslots,
        Textˉslots,
        U8ˉslots,
        U32ˉslots,
        Bytesˉslots,
        Enumˉslots,
        Recordˉslots,
        Blocks,
        Instructionˉcount,
        Bodyˉbytes,
        Maximumˉstack,
        Leaders,
        Storage.Persistentˉoffsets,
        Storage.Scratchˉoffsets,
        Storage.Persistentˉfields,
        Storage.Scratchˉfields
    );
}

export fn Compilerˉnativeˉx64ˉappendˉi32(Result: bytes, Value: i32) -> bytes {
    return Bytesˉconcat(Result, Bytesˉfromˉi32ˉlittle(Value));
}

export fn Compilerˉnativeˉx64ˉappendˉbyte(Result: bytes, Value: u8) -> bytes {
    return Bytesˉconcat(Result, Bytesˉfromˉu8(Value));
}

export fn Compilerˉnativeˉx64ˉappendˉu32(Result: bytes, Value: u32) -> bytes {
    return Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Value));
}

export fn Compilerˉnativeˉx64ˉemitˉframe(
    Result: bytes,
    Subtract: bool,
    Frameˉbytes: u32
) -> bytes {
    var Output: bytes = Compilerˉnativeˉx64ˉappendˉbyte(Result, 72u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 129u8);
    if Subtract {
        Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 236u8);
    } else {
        Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 196u8);
    }
    return Compilerˉnativeˉx64ˉappendˉu32(Output, Frameˉbytes);
}

export fn Compilerˉnativeˉx64ˉemitˉloadˉeax(
    Result: bytes,
    Offset: u32
) -> bytes {
    var Output: bytes = Compilerˉnativeˉx64ˉappendˉbyte(Result, 139u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 132u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 36u8);
    return Compilerˉnativeˉx64ˉappendˉu32(Output, Offset);
}

export fn Compilerˉnativeˉx64ˉemitˉloadˉecx(
    Result: bytes,
    Offset: u32
) -> bytes {
    var Output: bytes = Compilerˉnativeˉx64ˉappendˉbyte(Result, 139u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 140u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 36u8);
    return Compilerˉnativeˉx64ˉappendˉu32(Output, Offset);
}

export fn Compilerˉnativeˉx64ˉemitˉstoreˉeax(
    Result: bytes,
    Offset: u32
) -> bytes {
    var Output: bytes = Compilerˉnativeˉx64ˉappendˉbyte(Result, 137u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 132u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 36u8);
    return Compilerˉnativeˉx64ˉappendˉu32(Output, Offset);
}

export fn Compilerˉnativeˉx64ˉemitˉloadˉargument(
    Result: bytes,
    Argument: u32,
    Offset: u32
) -> bytes {
    var Output: bytes = Result;
    if Argument < 2u32 {
        Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 68u8);
    }
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 139u8);
    if Argument == 0u32 {
        Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 132u8);
    }
    if Argument == 1u32 {
        Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 140u8);
    }
    if Argument == 2u32 {
        Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 140u8);
    }
    if Argument == 3u32 {
        Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 148u8);
    }
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 36u8);
    return Compilerˉnativeˉx64ˉappendˉu32(Output, Offset);
}

export fn Compilerˉnativeˉx64ˉemitˉstoreˉargument(
    Result: bytes,
    Argument: u32,
    Offset: u32
) -> bytes {
    var Output: bytes = Result;
    if Argument < 2u32 {
        Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 68u8);
    }
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 137u8);
    if Argument == 0u32 {
        Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 132u8);
    }
    if Argument == 1u32 {
        Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 140u8);
    }
    if Argument == 2u32 {
        Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 140u8);
    }
    if Argument == 3u32 {
        Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 148u8);
    }
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 36u8);
    return Compilerˉnativeˉx64ˉappendˉu32(Output, Offset);
}

export fn Compilerˉnativeˉx64ˉemitˉrestore(Result: bytes) -> bytes {
    var Output: bytes = Compilerˉnativeˉx64ˉappendˉbyte(Result, 73u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 255u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 194u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 65u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 95u8);
    return Compilerˉnativeˉx64ˉappendˉbyte(Output, 195u8);
}

export fn Compilerˉnativeˉx64ˉemitˉrestoreˉfor(
    Result: bytes,
    Restoreˉcontext: bool
) -> bytes {
    var Output: bytes = Compilerˉnativeˉx64ˉappendˉbyte(Result, 73u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 255u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 194u8);
    if Restoreˉcontext {
        Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 65u8);
        Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 95u8);
    }
    return Compilerˉnativeˉx64ˉappendˉbyte(Output, 195u8);
}

export fn Compilerˉnativeˉx64ˉemitˉcharge(
    Result: bytes,
    Target: u32
) -> bytes {
    var Output: bytes = Compilerˉnativeˉx64ˉappendˉbyte(Result, 73u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 131u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 235u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 1u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 15u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 130u8);
    return Compilerˉnativeˉx64ˉappendˉu32(
        Output,
        Target - Bytesˉlength(Output) - 4u32
    );
}

export fn Compilerˉnativeˉx64ˉemitˉoverflowˉbranch(
    Result: bytes,
    Target: u32
) -> bytes {
    var Output: bytes = Compilerˉnativeˉx64ˉappendˉbyte(Result, 15u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 128u8);
    return Compilerˉnativeˉx64ˉappendˉu32(
        Output,
        Target - Bytesˉlength(Output) - 4u32
    );
}

export fn Compilerˉnativeˉx64ˉemitˉunsignedˉoverflowˉbranch(
    Result: bytes,
    Target: u32
) -> bytes {
    var Output: bytes = Compilerˉnativeˉx64ˉappendˉbyte(Result, 15u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 130u8);
    return Compilerˉnativeˉx64ˉappendˉu32(
        Output,
        Target - Bytesˉlength(Output) - 4u32
    );
}

export fn Compilerˉnativeˉx64ˉemitˉstatus(
    Result: bytes,
    Frameˉbytes: u32,
    Statusˉhigh: u32
) -> bytes {
    var Output: bytes = Compilerˉnativeˉx64ˉemitˉframe(
        Result,
        false,
        Frameˉbytes
    );
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 73u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 255u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 194u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 72u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 184u8);
    Output = Compilerˉnativeˉx64ˉappendˉu32(Output, 0u32);
    Output = Compilerˉnativeˉx64ˉappendˉu32(Output, Statusˉhigh);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 65u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 95u8);
    return Compilerˉnativeˉx64ˉappendˉbyte(Output, 195u8);
}

export fn Compilerˉnativeˉx64ˉemitˉstatusˉfor(
    Result: bytes,
    Frameˉbytes: u32,
    Statusˉhigh: u32,
    Restoreˉcontext: bool
) -> bytes {
    var Output: bytes = Compilerˉnativeˉx64ˉemitˉframe(
        Result,
        false,
        Frameˉbytes
    );
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 73u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 255u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 194u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 72u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 184u8);
    Output = Compilerˉnativeˉx64ˉappendˉu32(Output, 0u32);
    Output = Compilerˉnativeˉx64ˉappendˉu32(Output, Statusˉhigh);
    if Restoreˉcontext {
        Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 65u8);
        Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 95u8);
    }
    return Compilerˉnativeˉx64ˉappendˉbyte(Output, 195u8);
}

export fn Compilerˉnativeˉx64ˉemitˉcode(
    Input: bytes,
    Section: Compilerˉnativeˉx64ˉsection,
    Function: Compilerˉnativeˉx64ˉfunction,
    Analysis: Compilerˉnativeˉx64ˉanalysis
) -> bytes {
    let Slots: u32 = Function.Locals + Analysis.Values;
    let Frameˉbytes: u32 = Slots * 16u32;
    let Prologueˉbytes: u32 = 32u32 + Slots * 28u32;
    let Propagateˉoffset: u32 = Prologueˉbytes + Analysis.Bodyˉbytes;
    let Overflowˉoffset: u32 = Propagateˉoffset + 13u32;
    let Instructionˉlimitˉoffset: u32 = Overflowˉoffset + 23u32;
    let Depthˉoffset: u32 = Overflowˉoffset + 161u32;
    var Result: bytes = Compilerˉnativeˉx64ˉempty(Input);

    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 65u8);
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 87u8);
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 73u8);
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 137u8);
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 215u8);
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 77u8);
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 139u8);
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 95u8);
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 8u8);
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 77u8);
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 139u8);
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 87u8);
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 16u8);
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 73u8);
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 131u8);
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 234u8);
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 1u8);
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 15u8);
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 130u8);
    Result = Compilerˉnativeˉx64ˉappendˉu32(
        Result,
        Depthˉoffset - Bytesˉlength(Result) - 4u32
    );
    Result = Compilerˉnativeˉx64ˉemitˉframe(Result, true, Frameˉbytes);
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 49u8);
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 192u8);
    var Zeroˉoffset: u32 = 0u32;
    while Zeroˉoffset < Frameˉbytes {
        Result = Compilerˉnativeˉx64ˉemitˉstoreˉeax(Result, Zeroˉoffset);
        Zeroˉoffset = Zeroˉoffset + 4u32;
    }

    var Stack: bytes = Compilerˉnativeˉx64ˉempty(Input);
    var Stackˉdepth: u32 = 0u32;
    var Nextˉvalue: u32 = 0u32;
    var Cursor: u32 = 0u32;
    while Cursor < Section.Payloadˉlength {
        let Opcode: u8 = Bytesˉreadˉu8(Input, Section.Payloadˉoffset + Cursor);
        Result = Compilerˉnativeˉx64ˉemitˉcharge(
            Result,
            Instructionˉlimitˉoffset
        );
        if Opcode == 1u8 {
            Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 184u8);
            Result = Compilerˉnativeˉx64ˉappendˉi32(
                Result,
                Bytesˉreadˉi32ˉlittle(Input, Section.Payloadˉoffset + Cursor + 1u32)
            );
            Result = Compilerˉnativeˉx64ˉemitˉstoreˉeax(
                Result,
                (Function.Locals + Nextˉvalue) * 16u32
            );
            Stack = Bytesˉconcat(Stack, Bytesˉfromˉu32ˉlittle(Nextˉvalue));
            Stackˉdepth = Stackˉdepth + 1u32;
            Nextˉvalue = Nextˉvalue + 1u32;
            Cursor = Cursor + 5u32;
        } else {
            if Opcode == 4u8 {
                let Loadˉlocal: u32 = Bytesˉreadˉu32ˉlittle(
                    Input,
                    Section.Payloadˉoffset + Cursor + 1u32
                );
                Result = Compilerˉnativeˉx64ˉemitˉloadˉeax(
                    Result,
                    Loadˉlocal * 16u32
                );
                Result = Compilerˉnativeˉx64ˉemitˉstoreˉeax(
                    Result,
                    (Function.Locals + Nextˉvalue) * 16u32
                );
                Stack = Bytesˉconcat(Stack, Bytesˉfromˉu32ˉlittle(Nextˉvalue));
                Stackˉdepth = Stackˉdepth + 1u32;
                Nextˉvalue = Nextˉvalue + 1u32;
                Cursor = Cursor + 5u32;
            } else {
                if Opcode == 5u8 {
                    let Storeˉlocal: u32 = Bytesˉreadˉu32ˉlittle(
                        Input,
                        Section.Payloadˉoffset + Cursor + 1u32
                    );
                    let Storeˉvalue: u32 = Bytesˉreadˉu32ˉlittle(
                        Stack,
                        (Stackˉdepth - 1u32) * 4u32
                    );
                    Stackˉdepth = Stackˉdepth - 1u32;
                    Stack = Bytesˉslice(Stack, 0u32, Stackˉdepth * 4u32);
                    Result = Compilerˉnativeˉx64ˉemitˉloadˉeax(
                        Result,
                        (Function.Locals + Storeˉvalue) * 16u32
                    );
                    Result = Compilerˉnativeˉx64ˉemitˉstoreˉeax(
                        Result,
                        Storeˉlocal * 16u32
                    );
                    Cursor = Cursor + 5u32;
                } else {
                    if Opcode == 16u8 {
                        let Addˉright: u32 = Bytesˉreadˉu32ˉlittle(
                            Stack,
                            (Stackˉdepth - 1u32) * 4u32
                        );
                        let Addˉleft: u32 = Bytesˉreadˉu32ˉlittle(
                            Stack,
                            (Stackˉdepth - 2u32) * 4u32
                        );
                        Stackˉdepth = Stackˉdepth - 2u32;
                        Stack = Bytesˉslice(Stack, 0u32, Stackˉdepth * 4u32);
                        Result = Compilerˉnativeˉx64ˉemitˉloadˉeax(
                            Result,
                            (Function.Locals + Addˉleft) * 16u32
                        );
                        Result = Compilerˉnativeˉx64ˉemitˉloadˉecx(
                            Result,
                            (Function.Locals + Addˉright) * 16u32
                        );
                        Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 1u8);
                        Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 200u8);
                        Result = Compilerˉnativeˉx64ˉemitˉoverflowˉbranch(
                            Result,
                            Overflowˉoffset
                        );
                        Result = Compilerˉnativeˉx64ˉemitˉstoreˉeax(
                            Result,
                            (Function.Locals + Nextˉvalue) * 16u32
                        );
                        Stack = Bytesˉconcat(
                            Stack,
                            Bytesˉfromˉu32ˉlittle(Nextˉvalue)
                        );
                        Stackˉdepth = Stackˉdepth + 1u32;
                        Nextˉvalue = Nextˉvalue + 1u32;
                        Cursor = Cursor + 1u32;
                    } else {
                        if Opcode == 17u8 {
                            let Subtractˉright: u32 = Bytesˉreadˉu32ˉlittle(
                                Stack,
                                (Stackˉdepth - 1u32) * 4u32
                            );
                            let Subtractˉleft: u32 = Bytesˉreadˉu32ˉlittle(
                                Stack,
                                (Stackˉdepth - 2u32) * 4u32
                            );
                            Stackˉdepth = Stackˉdepth - 2u32;
                            Stack = Bytesˉslice(Stack, 0u32, Stackˉdepth * 4u32);
                            Result = Compilerˉnativeˉx64ˉemitˉloadˉeax(
                                Result,
                                (Function.Locals + Subtractˉleft) * 16u32
                            );
                            Result = Compilerˉnativeˉx64ˉemitˉloadˉecx(
                                Result,
                                (Function.Locals + Subtractˉright) * 16u32
                            );
                            Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 41u8);
                            Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 200u8);
                            Result = Compilerˉnativeˉx64ˉemitˉoverflowˉbranch(
                                Result,
                                Overflowˉoffset
                            );
                            Result = Compilerˉnativeˉx64ˉemitˉstoreˉeax(
                                Result,
                                (Function.Locals + Nextˉvalue) * 16u32
                            );
                            Stack = Bytesˉconcat(
                                Stack,
                                Bytesˉfromˉu32ˉlittle(Nextˉvalue)
                            );
                            Stackˉdepth = Stackˉdepth + 1u32;
                            Nextˉvalue = Nextˉvalue + 1u32;
                            Cursor = Cursor + 1u32;
                        } else {
                            if Opcode == 18u8 {
                                let Multiplyˉright: u32 = Bytesˉreadˉu32ˉlittle(
                                    Stack,
                                    (Stackˉdepth - 1u32) * 4u32
                                );
                                let Multiplyˉleft: u32 = Bytesˉreadˉu32ˉlittle(
                                    Stack,
                                    (Stackˉdepth - 2u32) * 4u32
                                );
                                Stackˉdepth = Stackˉdepth - 2u32;
                                Stack = Bytesˉslice(Stack, 0u32, Stackˉdepth * 4u32);
                                Result = Compilerˉnativeˉx64ˉemitˉloadˉeax(
                                    Result,
                                    (Function.Locals + Multiplyˉleft) * 16u32
                                );
                                Result = Compilerˉnativeˉx64ˉemitˉloadˉecx(
                                    Result,
                                    (Function.Locals + Multiplyˉright) * 16u32
                                );
                                Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 15u8);
                                Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 175u8);
                                Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 193u8);
                                Result = Compilerˉnativeˉx64ˉemitˉoverflowˉbranch(
                                    Result,
                                    Overflowˉoffset
                                );
                                Result = Compilerˉnativeˉx64ˉemitˉstoreˉeax(
                                    Result,
                                    (Function.Locals + Nextˉvalue) * 16u32
                                );
                                Stack = Bytesˉconcat(
                                    Stack,
                                    Bytesˉfromˉu32ˉlittle(Nextˉvalue)
                                );
                                Stackˉdepth = Stackˉdepth + 1u32;
                                Nextˉvalue = Nextˉvalue + 1u32;
                                Cursor = Cursor + 1u32;
                            } else {
                                if Opcode == 19u8 {
                                    let Negateˉvalue: u32 = Bytesˉreadˉu32ˉlittle(
                                        Stack,
                                        (Stackˉdepth - 1u32) * 4u32
                                    );
                                    Stackˉdepth = Stackˉdepth - 1u32;
                                    Stack = Bytesˉslice(
                                        Stack,
                                        0u32,
                                        Stackˉdepth * 4u32
                                    );
                                    Result = Compilerˉnativeˉx64ˉemitˉloadˉeax(
                                        Result,
                                        (Function.Locals + Negateˉvalue) * 16u32
                                    );
                                    Result = Compilerˉnativeˉx64ˉappendˉbyte(
                                        Result,
                                        247u8
                                    );
                                    Result = Compilerˉnativeˉx64ˉappendˉbyte(
                                        Result,
                                        216u8
                                    );
                                    Result = Compilerˉnativeˉx64ˉemitˉoverflowˉbranch(
                                        Result,
                                        Overflowˉoffset
                                    );
                                    Result = Compilerˉnativeˉx64ˉemitˉstoreˉeax(
                                        Result,
                                        (Function.Locals + Nextˉvalue) * 16u32
                                    );
                                    Stack = Bytesˉconcat(
                                        Stack,
                                        Bytesˉfromˉu32ˉlittle(Nextˉvalue)
                                    );
                                    Stackˉdepth = Stackˉdepth + 1u32;
                                    Nextˉvalue = Nextˉvalue + 1u32;
                                    Cursor = Cursor + 1u32;
                                } else {
                                    let Returnˉvalue: u32 = Bytesˉreadˉu32ˉlittle(
                                        Stack,
                                        (Stackˉdepth - 1u32) * 4u32
                                    );
                                    Stackˉdepth = Stackˉdepth - 1u32;
                                    Stack = Bytesˉslice(
                                        Stack,
                                        0u32,
                                        Stackˉdepth * 4u32
                                    );
                                    Result = Compilerˉnativeˉx64ˉemitˉloadˉeax(
                                        Result,
                                        (Function.Locals + Returnˉvalue) * 16u32
                                    );
                                    Result = Compilerˉnativeˉx64ˉemitˉframe(
                                        Result,
                                        false,
                                        Frameˉbytes
                                    );
                                    Result = Compilerˉnativeˉx64ˉemitˉrestore(Result);
                                    Cursor = Cursor + 1u32;
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    Result = Compilerˉnativeˉx64ˉemitˉframe(Result, false, Frameˉbytes);
    Result = Compilerˉnativeˉx64ˉemitˉrestore(Result);
    Result = Compilerˉnativeˉx64ˉemitˉstatus(Result, Frameˉbytes, 1u32);
    Result = Compilerˉnativeˉx64ˉemitˉstatus(Result, Frameˉbytes, 2u32);
    Result = Compilerˉnativeˉx64ˉemitˉstatus(Result, Frameˉbytes, 4u32);
    Result = Compilerˉnativeˉx64ˉemitˉstatus(Result, Frameˉbytes, 6u32);
    Result = Compilerˉnativeˉx64ˉemitˉstatus(Result, Frameˉbytes, 5u32);
    Result = Compilerˉnativeˉx64ˉemitˉstatus(Result, Frameˉbytes, 8u32);
    Result = Compilerˉnativeˉx64ˉemitˉstatus(Result, Frameˉbytes, 7u32);
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 73u8);
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 255u8);
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 194u8);
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 72u8);
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 184u8);
    Result = Compilerˉnativeˉx64ˉappendˉu32(Result, 0u32);
    Result = Compilerˉnativeˉx64ˉappendˉu32(Result, 3u32);
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 65u8);
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 95u8);
    return Compilerˉnativeˉx64ˉappendˉbyte(Result, 195u8);
}

export fn Compilerˉnativeˉx64ˉemittedˉbytes(
    Input: bytes,
    Offset: u32,
    Opcode: u8,
    Isˉmain: bool,
    Callˉparameters: u32,
    Callˉtarget: u32,
    Callˉdirectory: bytes,
    Localˉtype: u8,
    Functionˉreturnˉtype: u8,
    Types: Nominalˉtypes.Compilerˉnativeˉx64ˉtypes,
    Capabilityˉtable: Nativeˉcapabilities.Compilerˉnativeˉx64ˉcapabilities
) -> u32 {
    if Opcode == 1u8 { return 22u32; }
    if Opcode == 2u8 { return 22u32; }
    if Opcode == 3u8 || Opcode == 10u8 {
        return Descriptors.Compilerˉnativeˉx64ˉdescriptorˉconstantˉbytes();
    }
    if Opcode == 4u8 || Opcode == 5u8 {
        if Localˉtype == 3u8 || Localˉtype == 6u8 {
            return Descriptors.Compilerˉnativeˉx64ˉdescriptorˉcopyˉbytes();
        }
        if Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉisˉrecord(Localˉtype) {
            return Records.Compilerˉnativeˉx64ˉrecordˉcopyˉbytes(
                Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉitemˉcount(
                    Types,
                    Nominalˉtypes.Compilerˉnativeˉx64ˉrecordˉtypeˉindex(
                        Localˉtype
                    )
                )
            );
        }
        return 24u32;
    }
    if Opcode == 6u8 { return 22u32; }
    if Opcode == 7u8 { return 45u32; }
    if Opcode == 8u8 { return 22u32; }
    if Opcode == 9u8 { return 22u32; }
    if Opcode == 11u8 {
        return Descriptors.Compilerˉnativeˉx64ˉdescriptorˉlengthˉbytes();
    }
    if Opcode == 12u8 {
        return Descriptors.Compilerˉnativeˉx64ˉdescriptorˉsliceˉbytes();
    }
    if Opcode == 13u8 || Opcode == 14u8 || Opcode == 15u8 ||
        Opcode == 114u8 {
        return Descriptors.Compilerˉnativeˉx64ˉdescriptorˉreadˉbytes(Opcode);
    }
    if Opcode == 113u8 {
        return Runtimeˉdescriptors.Compilerˉnativeˉx64ˉtextˉconcatˉbytes();
    }
    if Opcode == 115u8 {
        return Runtimeˉdescriptors.Compilerˉnativeˉx64ˉtextˉutf8ˉisˉvalidˉbytes();
    }
    if Opcode == 116u8 {
        return Runtimeˉdescriptors.Compilerˉnativeˉx64ˉtextˉfromˉutf8ˉbytes();
    }
    if Opcode == 117u8 {
        return Runtimeˉdescriptors.Compilerˉnativeˉx64ˉtextˉquoteˉbytes();
    }
    if Opcode == 119u8 {
        return Bytesˉconcatenation.Compilerˉnativeˉx64ˉbytesˉconcatˉbytes();
    }
    if Opcode == 124u8 {
        return Descriptors.Compilerˉnativeˉx64ˉdescriptorˉcopyˉbytes();
    }
    if Opcode == 16u8 { return 39u32; }
    if Opcode == 17u8 { return 39u32; }
    if Opcode == 18u8 { return 40u32; }
    if Opcode == 19u8 { return 32u32; }
    if Opcode == 20u8 { return 39u32; }
    if Compilerˉnativeˉx64ˉisˉi32ˉcomparison(Opcode) { return 39u32; }
    if Compilerˉnativeˉx64ˉisˉboolˉcomparison(Opcode) { return 39u32; }
    if Compilerˉnativeˉx64ˉisˉu32ˉcomparison(Opcode) { return 39u32; }
    if Compilerˉnativeˉx64ˉisˉu8ˉcomparison(Opcode) { return 39u32; }
    if Opcode == 104u8 {
        return Records.Compilerˉnativeˉx64ˉrecordˉcreateˉbytes(
            Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉitemˉcount(
                Types,
                Bytesˉreadˉu32ˉlittle(Input, Offset + 1u32)
            )
        );
    }
    if Opcode == 105u8 {
        return Records.Compilerˉnativeˉx64ˉrecordˉfieldˉbytes();
    }
    if Opcode == 106u8 {
        return Enums.Compilerˉnativeˉx64ˉenumˉconstantˉbytes();
    }
    if Compilerˉnativeˉx64ˉisˉenumˉcomparison(Opcode) {
        return Enums.Compilerˉnativeˉx64ˉenumˉcomparisonˉbytes();
    }
    if Opcode == 109u8 {
        return Enums.Compilerˉnativeˉx64ˉenumˉnameˉbytes();
    }
    if Opcode == 40u8 { return 27u32; }
    if Opcode == 48u8 { return 15u32; }
    if Opcode == 49u8 { return 30u32; }
    if Opcode == 64u8 {
        if Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉisˉrecord(
            Layout.Compilerˉnativeˉx64ˉlayoutˉreturnˉtype(
                Callˉdirectory,
                Callˉtarget
            )
        ) {
            return Records.Compilerˉnativeˉx64ˉrecordˉcallˉbytes(
                Bytesˉslice(
                    Callˉdirectory,
                    Callˉtarget * Layout.Compilerˉnativeˉx64ˉlayoutˉentryˉbytes() + 12u32,
                    Callˉparameters
                )
            );
        }
        return 38u32 +
            Compilerˉnativeˉx64ˉscalarˉargumentˉbytes(Callˉparameters);
    }
    if Opcode == 65u8 {
        let Capabilityˉkind: u8 =
            Nativeˉcapabilities.Compilerˉnativeˉx64ˉcapabilityˉkind(
            Capabilityˉtable,
            Bytesˉreadˉu32ˉlittle(Input, Offset + 1u32)
        );
        if Capabilityˉkind ==
            Nativeˉcapabilities.Compilerˉnativeˉx64ˉprocessˉargumentˉkind() {
            return Nativeˉcapabilities.Compilerˉnativeˉx64ˉprocessˉargumentˉbytes();
        }
        if Capabilityˉkind ==
            Nativeˉcapabilities.Compilerˉnativeˉx64ˉfileˉreadˉbytesˉkind() {
            return Nativeˉcapabilities.Compilerˉnativeˉx64ˉfileˉreadˉbytesˉbytes();
        }
        return Nativeˉcapabilities.Compilerˉnativeˉx64ˉprocessˉargumentˉcountˉbytes();
    }
    if Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉisˉrecord(
        Functionˉreturnˉtype
    ) {
        let Returnˉtypeˉindex: u32 =
            Nominalˉtypes.Compilerˉnativeˉx64ˉrecordˉtypeˉindex(
                Functionˉreturnˉtype
            );
        return Records.Compilerˉnativeˉx64ˉrecordˉreturnˉbytes(
            Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉitemˉcount(
                Types,
                Returnˉtypeˉindex
            ),
            Nominalˉtypes.Compilerˉnativeˉx64ˉrecordˉhasˉdescriptors(
                Input,
                Types,
                Returnˉtypeˉindex
            )
        );
    }
    if Isˉmain { return 30u32; }
    return 28u32;
}

export fn Compilerˉnativeˉx64ˉblockˉid(Leaders: bytes, Offset: u32) -> u32 {
    var Id: u32 = 0u32;
    var Cursor: u32 = 0u32;
    while Cursor < Offset {
        if Bytesˉreadˉu8(Leaders, Cursor) == 1u8 { Id = Id + 1u32; }
        Cursor = Cursor + 1u32;
    }
    return Id;
}

export fn Compilerˉnativeˉx64ˉbuildˉblockˉoffsets(
    Input: bytes,
    Section: Compilerˉnativeˉx64ˉsection,
    Leaders: bytes,
    Prologueˉbytes: u32,
    Isˉmain: bool,
    Callˉdirectory: bytes,
    Function: Compilerˉnativeˉx64ˉfunction,
    Types: Nominalˉtypes.Compilerˉnativeˉx64ˉtypes,
    Capabilityˉtable: Nativeˉcapabilities.Compilerˉnativeˉx64ˉcapabilities
) -> bytes {
    var Result: bytes = Compilerˉnativeˉx64ˉempty(Input);
    var Machine: u32 = Prologueˉbytes;
    var Cursor: u32 = 0u32;
    while Cursor < Section.Payloadˉlength {
        if Bytesˉreadˉu8(Leaders, Cursor) == 1u8 {
            Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Machine));
        }
        let Opcode: u8 = Bytesˉreadˉu8(Input, Section.Payloadˉoffset + Cursor);
        var Callˉparameters: u32 = 0u32;
        var Callˉtarget: u32 = 0u32;
        var Localˉtype: u8 = 0u8;
        if Opcode == 4u8 || Opcode == 5u8 {
            Localˉtype = Bytesˉreadˉu8(
                Function.Localˉtypes,
                Bytesˉreadˉu32ˉlittle(
                    Input,
                    Section.Payloadˉoffset + Cursor + 1u32
                )
            );
        }
        if Opcode == 64u8 {
            Callˉtarget = Bytesˉreadˉu32ˉlittle(
                Input,
                Section.Payloadˉoffset + Cursor + 1u32
            );
            Callˉparameters = Layout.Compilerˉnativeˉx64ˉlayoutˉparameters(
                Callˉdirectory,
                Callˉtarget
            );
        }
        Machine = Machine + Compilerˉnativeˉx64ˉemittedˉbytes(
            Input,
            Section.Payloadˉoffset + Cursor,
            Opcode,
            Isˉmain,
            Callˉparameters,
            Callˉtarget,
            Callˉdirectory,
            Localˉtype,
            Function.Returnˉtype,
            Types,
            Capabilityˉtable
        );
        Cursor = Cursor + Compilerˉnativeˉx64ˉinstructionˉsize(Opcode);
    }
    return Result;
}

export fn Compilerˉnativeˉx64ˉcollectˉdataˉrelocations(
    Input: bytes,
    Section: Compilerˉnativeˉx64ˉsection,
    Function: Compilerˉnativeˉx64ˉfunction,
    Analysis: Compilerˉnativeˉx64ˉcontrolˉanalysis,
    Isˉmain: bool,
    Codeˉbase: u32,
    Callˉdirectory: bytes,
    Types: Nominalˉtypes.Compilerˉnativeˉx64ˉtypes,
    Capabilityˉtable: Nativeˉcapabilities.Compilerˉnativeˉx64ˉcapabilities
) -> bytes {
    let Slots: u32 = Function.Locals + Analysis.I32ˉslots +
        Analysis.Boolˉslots + Analysis.Textˉslots + Analysis.U8ˉslots +
        Analysis.U32ˉslots + Analysis.Bytesˉslots + Analysis.Enumˉslots +
        Analysis.Recordˉslots + Analysis.Recordˉpersistentˉfields +
        Analysis.Recordˉscratchˉfields +
        Compilerˉnativeˉx64ˉhiddenˉrecordˉslots(Function.Returnˉtype);
    var Prologueˉbase: u32 = 19u32;
    if Isˉmain { Prologueˉbase = 32u32; }
    if Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉisˉrecord(
        Function.Returnˉtype
    ) { Prologueˉbase = 10u32; }
    var Machine: u32 = Prologueˉbase + Slots * 28u32 +
        Compilerˉnativeˉx64ˉscalarˉargumentˉbytes(Function.Parameters);
    var Result: bytes = Compilerˉnativeˉx64ˉempty(Input);
    var Cursor: u32 = 0u32;
    while Cursor < Section.Payloadˉlength {
        let Opcode: u8 = Bytesˉreadˉu8(Input, Section.Payloadˉoffset + Cursor);
        var Callˉparameters: u32 = 0u32;
        var Callˉtarget: u32 = 0u32;
        var Localˉtype: u8 = 0u8;
        if Opcode == 4u8 || Opcode == 5u8 {
            Localˉtype = Bytesˉreadˉu8(
                Function.Localˉtypes,
                Bytesˉreadˉu32ˉlittle(
                    Input,
                    Section.Payloadˉoffset + Cursor + 1u32
                )
            );
        }
        if Opcode == 64u8 {
            Callˉtarget = Bytesˉreadˉu32ˉlittle(
                Input,
                Section.Payloadˉoffset + Cursor + 1u32
            );
            Callˉparameters = Layout.Compilerˉnativeˉx64ˉlayoutˉparameters(
                Callˉdirectory,
                Callˉtarget
            );
        }
        if Opcode == 7u8 {
            Result = Bytesˉconcat(
                Result,
                Bytesˉfromˉu32ˉlittle(Codeˉbase + Machine + 31u32)
            );
            Result = Bytesˉconcat(
                Result,
                Bytesˉfromˉu32ˉlittle(Bytesˉreadˉu32ˉlittle(
                    Input,
                    Section.Payloadˉoffset + Cursor + 1u32
                ))
            );
        }
        if Opcode == 3u8 || Opcode == 10u8 {
            Result = Bytesˉconcat(
                Result,
                Bytesˉfromˉu32ˉlittle(Codeˉbase + Machine + 13u32)
            );
            Result = Bytesˉconcat(
                Result,
                Bytesˉfromˉu32ˉlittle(Bytesˉreadˉu32ˉlittle(
                    Input,
                    Section.Payloadˉoffset + Cursor + 1u32
                ))
            );
        }
        Machine = Machine + Compilerˉnativeˉx64ˉemittedˉbytes(
            Input,
            Section.Payloadˉoffset + Cursor,
            Opcode,
            Isˉmain,
            Callˉparameters,
            Callˉtarget,
            Callˉdirectory,
            Localˉtype,
            Function.Returnˉtype,
            Types,
            Capabilityˉtable
        );
        Cursor = Cursor + Compilerˉnativeˉx64ˉinstructionˉsize(Opcode);
    }
    return Result;
}

export fn Compilerˉnativeˉx64ˉmachineˉtarget(
    Leaders: bytes,
    Blockˉoffsets: bytes,
    Wvbˉoffset: u32
) -> u32 {
    return Bytesˉreadˉu32ˉlittle(
        Blockˉoffsets,
        Compilerˉnativeˉx64ˉblockˉid(Leaders, Wvbˉoffset) * 4u32
    );
}

fn Compilerˉnativeˉx64ˉhiddenˉrecordˉslots(
    Returnˉtype: u8
) -> u32 {
    if Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉisˉrecord(Returnˉtype) {
        return 1u32;
    }
    return 0u32;
}

export fn Compilerˉnativeˉx64ˉrelativeˉu32(
    Target: u32,
    Origin: u32
) -> u32 {
    if Target >= Origin { return Target - Origin; }
    let Magnitude: u32 = Origin - Target;
    return 4294967295u32 - Magnitude + 1u32;
}

export fn Compilerˉnativeˉx64ˉemitˉjump(
    Result: bytes,
    Target: u32
) -> bytes {
    var Output: bytes = Compilerˉnativeˉx64ˉappendˉbyte(Result, 233u8);
    return Compilerˉnativeˉx64ˉappendˉu32(
        Output,
        Compilerˉnativeˉx64ˉrelativeˉu32(
            Target,
            Bytesˉlength(Output) + 4u32
        )
    );
}

export fn Compilerˉnativeˉx64ˉcomparisonˉcondition(Opcode: u8) -> u8 {
    if Opcode == 32u8 { return 148u8; }
    if Opcode == 33u8 { return 149u8; }
    if Opcode == 34u8 { return 156u8; }
    if Opcode == 35u8 { return 158u8; }
    if Opcode == 36u8 { return 159u8; }
    if Opcode == 37u8 { return 157u8; }
    if Opcode == 38u8 { return 148u8; }
    if Opcode == 96u8 { return 148u8; }
    if Opcode == 97u8 { return 149u8; }
    if Opcode == 98u8 { return 146u8; }
    if Opcode == 99u8 { return 150u8; }
    if Opcode == 100u8 { return 151u8; }
    if Opcode == 101u8 { return 147u8; }
    if Opcode == 102u8 { return 148u8; }
    if Opcode == 103u8 { return 149u8; }
    return 149u8;
}

export fn Compilerˉnativeˉx64ˉemitˉcomparison(
    Result: bytes,
    Leftˉslot: u32,
    Rightˉslot: u32,
    Condition: u8,
    Resultˉslot: u32
) -> bytes {
    var Output: bytes = Compilerˉnativeˉx64ˉemitˉloadˉeax(
        Result,
        Leftˉslot * 16u32
    );
    Output = Compilerˉnativeˉx64ˉemitˉloadˉecx(Output, Rightˉslot * 16u32);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 57u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 200u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 15u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, Condition);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 192u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 15u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 182u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 192u8);
    return Compilerˉnativeˉx64ˉemitˉstoreˉeax(
        Output,
        Resultˉslot * 16u32
    );
}

export fn Compilerˉnativeˉx64ˉemitˉconditionalˉbranch(
    Result: bytes,
    Conditionˉslot: u32,
    Trueˉtarget: u32,
    Falseˉtarget: u32
) -> bytes {
    var Output: bytes = Compilerˉnativeˉx64ˉemitˉloadˉeax(
        Result,
        Conditionˉslot * 16u32
    );
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 133u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 192u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 15u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 133u8);
    Output = Compilerˉnativeˉx64ˉappendˉu32(
        Output,
        Compilerˉnativeˉx64ˉrelativeˉu32(
            Trueˉtarget,
            Bytesˉlength(Output) + 4u32
        )
    );
    return Compilerˉnativeˉx64ˉemitˉjump(Output, Falseˉtarget);
}

fn Compilerˉnativeˉx64ˉemitˉrecordˉstep(
    Input: bytes,
    Offset: u32,
    Opcode: u8,
    Function: Compilerˉnativeˉx64ˉfunction,
    Analysis: Compilerˉnativeˉx64ˉcontrolˉanalysis,
    Types: Nominalˉtypes.Compilerˉnativeˉx64ˉtypes,
    State: Recordˉinstructions.Compilerˉnativeˉx64ˉrecordˉstate
) -> Recordˉinstructions.Compilerˉnativeˉx64ˉrecordˉstate {
    let Recordˉbase: u32 = Function.Locals + Analysis.I32ˉslots +
        Analysis.Boolˉslots + Analysis.Textˉslots + Analysis.U8ˉslots +
        Analysis.U32ˉslots + Analysis.Bytesˉslots + Analysis.Enumˉslots;
    let Persistentˉbase: u32 = Recordˉbase + Analysis.Recordˉslots;
    return Recordˉinstructions.Compilerˉnativeˉx64ˉemitˉrecordˉinstruction(
        Recordˉinstructions.Compilerˉnativeˉx64ˉrecordˉinstruction(
            Input,
            Offset,
            Opcode
        ),
        Recordˉinstructions.Compilerˉnativeˉx64ˉrecordˉlayout(
            Function.Locals,
            Analysis.I32ˉslots,
            Analysis.Boolˉslots,
            Analysis.Textˉslots,
            Analysis.U8ˉslots,
            Analysis.U32ˉslots,
            Analysis.Bytesˉslots,
            Recordˉbase,
            Persistentˉbase,
            Persistentˉbase + Analysis.Recordˉpersistentˉfields
        ),
        Function.Localˉtypes,
        Types,
        Recordˉstorage.Compilerˉnativeˉx64ˉrecordˉstorage(
            true,
            Analysis.Recordˉpersistentˉoffsets,
            Analysis.Recordˉscratchˉoffsets,
            Analysis.Recordˉpersistentˉfields,
            Analysis.Recordˉscratchˉfields,
            Analysis.Recordˉslots
        ),
        State
    );
}

fn Compilerˉnativeˉx64ˉemitˉcallˉstep(
    Target: u32,
    Function: Compilerˉnativeˉx64ˉfunction,
    Analysis: Compilerˉnativeˉx64ˉcontrolˉanalysis,
    Callˉdirectory: bytes,
    Codeˉbase: u32,
    Propagateˉoffset: u32,
    State: Callˉinstructions.Compilerˉnativeˉx64ˉcallˉstate
) -> Callˉinstructions.Compilerˉnativeˉx64ˉcallˉstate {
    let Recordˉbase: u32 = Function.Locals + Analysis.I32ˉslots +
        Analysis.Boolˉslots + Analysis.Textˉslots + Analysis.U8ˉslots +
        Analysis.U32ˉslots + Analysis.Bytesˉslots + Analysis.Enumˉslots;
    return Callˉinstructions.Compilerˉnativeˉx64ˉemitˉcallˉinstruction(
        Target,
        Callˉinstructions.Compilerˉnativeˉx64ˉcallˉlayout(
            Function.Locals,
            Analysis.I32ˉslots,
            Analysis.Boolˉslots,
            Analysis.Textˉslots,
            Analysis.U8ˉslots,
            Analysis.U32ˉslots,
            Analysis.Bytesˉslots,
            Recordˉbase,
            Recordˉbase + Analysis.Recordˉslots +
                Analysis.Recordˉpersistentˉfields
        ),
        Recordˉstorage.Compilerˉnativeˉx64ˉrecordˉstorage(
            true,
            Analysis.Recordˉpersistentˉoffsets,
            Analysis.Recordˉscratchˉoffsets,
            Analysis.Recordˉpersistentˉfields,
            Analysis.Recordˉscratchˉfields,
            Analysis.Recordˉslots
        ),
        Callˉdirectory,
        Codeˉbase,
        Propagateˉoffset,
        State
    );
}

export fn Compilerˉnativeˉx64ˉemitˉcontrolˉcode(
    Input: bytes,
    Section: Compilerˉnativeˉx64ˉsection,
    Function: Compilerˉnativeˉx64ˉfunction,
    Analysis: Compilerˉnativeˉx64ˉcontrolˉanalysis,
    Isˉmain: bool,
    Codeˉbase: u32,
    Callˉdirectory: bytes,
    Data: Staticˉdata.Compilerˉnativeˉx64ˉdata,
    Types: Nominalˉtypes.Compilerˉnativeˉx64ˉtypes,
    Capabilityˉtable: Nativeˉcapabilities.Compilerˉnativeˉx64ˉcapabilities
) -> bytes {
    let Slots: u32 = Function.Locals + Analysis.I32ˉslots +
        Analysis.Boolˉslots + Analysis.Textˉslots + Analysis.U8ˉslots +
        Analysis.U32ˉslots + Analysis.Bytesˉslots + Analysis.Enumˉslots +
        Analysis.Recordˉslots + Analysis.Recordˉpersistentˉfields +
        Analysis.Recordˉscratchˉfields +
        Compilerˉnativeˉx64ˉhiddenˉrecordˉslots(Function.Returnˉtype);
    let Frameˉbytes: u32 = Slots * 16u32;
    var Prologueˉbase: u32 = 19u32;
    if Isˉmain { Prologueˉbase = 32u32; }
    if Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉisˉrecord(
        Function.Returnˉtype
    ) { Prologueˉbase = 10u32; }
    let Parameterˉbytes: u32 =
        Compilerˉnativeˉx64ˉscalarˉargumentˉbytes(Function.Parameters);
    let Prologueˉbytes: u32 = Prologueˉbase + Slots * 28u32 + Parameterˉbytes;
    let Propagateˉoffset: u32 = Prologueˉbytes + Analysis.Bodyˉbytes;
    var Restoreˉbytes: u32 = 11u32;
    var Statusˉbytes: u32 = 21u32;
    if Isˉmain {
        Restoreˉbytes = 13u32;
        Statusˉbytes = 23u32;
    }
    let Overflowˉoffset: u32 = Propagateˉoffset + Restoreˉbytes;
    let Instructionˉlimitˉoffset: u32 = Overflowˉoffset + Statusˉbytes;
    let Boundsˉoffset: u32 = Overflowˉoffset + Statusˉbytes * 2u32;
    let Byteˉboundsˉoffset: u32 = Overflowˉoffset + Statusˉbytes * 3u32;
    let Runtimeˉserviceˉoffset: u32 = Overflowˉoffset + Statusˉbytes * 4u32;
    let Invalidˉutf8ˉoffset: u32 = Overflowˉoffset + Statusˉbytes * 5u32;
    let Depthˉoffset: u32 = Overflowˉoffset + Statusˉbytes * 7u32;
    let Blockˉoffsets: bytes = Compilerˉnativeˉx64ˉbuildˉblockˉoffsets(
        Input,
        Section,
        Analysis.Leaders,
        Prologueˉbytes,
        Isˉmain,
        Callˉdirectory,
        Function,
        Types,
        Capabilityˉtable
    );
    var Result: bytes = Compilerˉnativeˉx64ˉempty(Input);

    if Isˉmain {
        Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 65u8);
        Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 87u8);
        Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 73u8);
        Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 137u8);
        Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 215u8);
        Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 77u8);
        Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 139u8);
        Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 95u8);
        Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 8u8);
        Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 77u8);
        Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 139u8);
        Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 87u8);
        Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 16u8);
    }
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 73u8);
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 131u8);
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 234u8);
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 1u8);
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 15u8);
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 130u8);
    Result = Compilerˉnativeˉx64ˉappendˉu32(
        Result,
        Depthˉoffset - Bytesˉlength(Result) - 4u32
    );
    Result = Compilerˉnativeˉx64ˉemitˉframe(Result, true, Frameˉbytes);
    let Returnsˉrecord: bool =
        Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉisˉrecord(
            Function.Returnˉtype
        );
    let Hiddenˉrecordˉslot: u32 = Slots -
        Compilerˉnativeˉx64ˉhiddenˉrecordˉslots(Function.Returnˉtype);
    if Returnsˉrecord {
        Result = Records.Compilerˉnativeˉx64ˉemitˉhiddenˉrecordˉresult(
            Result,
            Hiddenˉrecordˉslot
        );
    }
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 49u8);
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 192u8);
    var Zeroˉoffset: u32 = 0u32;
    while Zeroˉoffset < Frameˉbytes {
        if !Returnsˉrecord || Zeroˉoffset < Hiddenˉrecordˉslot * 16u32 ||
            Zeroˉoffset >= Hiddenˉrecordˉslot * 16u32 + 16u32 {
            Result = Compilerˉnativeˉx64ˉemitˉstoreˉeax(
                Result,
                Zeroˉoffset
            );
        }
        Zeroˉoffset = Zeroˉoffset + 4u32;
    }
    if Returnsˉrecord {
        Result = Records.Compilerˉnativeˉx64ˉemitˉrecordˉcheckpoint(
            Result,
            Hiddenˉrecordˉslot
        );
    }
    var Parameter: u32 = 0u32;
    while Parameter < Function.Parameters {
        if Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉisˉrecord(
            Bytesˉreadˉu8(Function.Localˉtypes, Parameter)
        ) {
            Result = Records.Compilerˉnativeˉx64ˉemitˉrecordˉparameter(
                Result,
                Parameter,
                Parameter
            );
        } else {
            Result = Compilerˉnativeˉx64ˉemitˉstoreˉargument(
                Result,
                Parameter,
                Parameter * 16u32
            );
        }
        Parameter = Parameter + 1u32;
    }

    var Stackˉtypes: bytes = Compilerˉnativeˉx64ˉempty(Input);
    var Stackˉslots: bytes = Compilerˉnativeˉx64ˉempty(Input);
    var Stackˉdepth: u32 = 0u32;
    var Nextˉi32: u32 = 0u32;
    var Nextˉbool: u32 = 0u32;
    var Nextˉtext: u32 = 0u32;
    var Nextˉu8: u32 = 0u32;
    var Nextˉu32: u32 = 0u32;
    var Nextˉbytes: u32 = 0u32;
    var Nextˉenum: u32 = 0u32;
    var Nextˉrecord: u32 = 0u32;
    var Cursor: u32 = 0u32;
    while Cursor < Section.Payloadˉlength {
        if Bytesˉreadˉu8(Analysis.Leaders, Cursor) == 1u8 {
            Stackˉtypes = Compilerˉnativeˉx64ˉempty(Input);
            Stackˉslots = Compilerˉnativeˉx64ˉempty(Input);
            Stackˉdepth = 0u32;
            Nextˉi32 = 0u32;
            Nextˉbool = 0u32;
            Nextˉtext = 0u32;
            Nextˉu8 = 0u32;
            Nextˉu32 = 0u32;
            Nextˉbytes = 0u32;
            Nextˉenum = 0u32;
            Nextˉrecord = 0u32;
        }
        let Opcode: u8 = Bytesˉreadˉu8(Input, Section.Payloadˉoffset + Cursor);
        Result = Compilerˉnativeˉx64ˉemitˉcharge(
            Result,
            Instructionˉlimitˉoffset
        );
        if Compilerˉnativeˉx64ˉdescriptorˉoperation(Opcode) {
            let Descriptorˉstate:
                Descriptorˉinstructions.Compilerˉnativeˉx64ˉdescriptorˉstate =
                Descriptorˉinstructions.Compilerˉnativeˉx64ˉemitˉdescriptorˉinstruction(
                    Descriptorˉinstructions.Compilerˉnativeˉx64ˉdescriptorˉinstruction(
                        Input,
                        Section.Payloadˉoffset + Cursor,
                        Opcode,
                        Byteˉboundsˉoffset,
                        Runtimeˉserviceˉoffset,
                        Invalidˉutf8ˉoffset
                    ),
                    Descriptorˉinstructions.Compilerˉnativeˉx64ˉdescriptorˉlayout(
                        Function.Locals,
                        Analysis.I32ˉslots,
                        Analysis.Boolˉslots,
                        Analysis.Textˉslots,
                        Analysis.U8ˉslots,
                        Analysis.U32ˉslots,
                        Analysis.Bytesˉslots
                    ),
                    Data,
                    Descriptorˉinstructions.Compilerˉnativeˉx64ˉdescriptorˉstate(
                        Result,
                        Stackˉtypes,
                        Stackˉslots,
                        Stackˉdepth,
                        Nextˉi32,
                        Nextˉbool,
                        Nextˉtext,
                        Nextˉu8,
                        Nextˉu32,
                        Nextˉbytes
                    )
                );
            Result = Descriptorˉstate.Result;
            Stackˉtypes = Descriptorˉstate.Stackˉtypes;
            Stackˉslots = Descriptorˉstate.Stackˉslots;
            Stackˉdepth = Descriptorˉstate.Stackˉdepth;
            Nextˉi32 = Descriptorˉstate.Nextˉi32;
            Nextˉbool = Descriptorˉstate.Nextˉbool;
            Nextˉtext = Descriptorˉstate.Nextˉtext;
            Nextˉu8 = Descriptorˉstate.Nextˉu8;
            Nextˉu32 = Descriptorˉstate.Nextˉu32;
            Nextˉbytes = Descriptorˉstate.Nextˉbytes;
        }
        if Compilerˉnativeˉx64ˉnominalˉoperation(Opcode) {
            let Enumˉstate: Enumˉinstructions.Compilerˉnativeˉx64ˉenumˉstate =
                Enumˉinstructions.Compilerˉnativeˉx64ˉemitˉenumˉinstruction(
                    Enumˉinstructions.Compilerˉnativeˉx64ˉenumˉinstruction(
                        Input,
                        Section.Payloadˉoffset + Cursor,
                        Opcode,
                        Runtimeˉserviceˉoffset
                    ),
                    Enumˉinstructions.Compilerˉnativeˉx64ˉenumˉlayout(
                        Function.Locals,
                        Analysis.I32ˉslots,
                        Analysis.Boolˉslots,
                        Analysis.Textˉslots,
                        Analysis.U8ˉslots,
                        Analysis.U32ˉslots,
                        Analysis.Bytesˉslots
                    ),
                    Types,
                    Enumˉinstructions.Compilerˉnativeˉx64ˉenumˉstate(
                        Result,
                        Stackˉtypes,
                        Stackˉslots,
                        Stackˉdepth,
                        Nextˉbool,
                        Nextˉtext,
                        Nextˉenum
                    )
                );
            Result = Enumˉstate.Result;
            Stackˉtypes = Enumˉstate.Stackˉtypes;
            Stackˉslots = Enumˉstate.Stackˉslots;
            Stackˉdepth = Enumˉstate.Stackˉdepth;
            Nextˉbool = Enumˉstate.Nextˉbool;
            Nextˉtext = Enumˉstate.Nextˉtext;
            Nextˉenum = Enumˉstate.Nextˉenum;
        }
        var Hasˉrecordˉinstruction: bool =
            Compilerˉnativeˉx64ˉrecordˉoperation(Opcode);
        if Opcode == 4u8 || Opcode == 5u8 {
            let Recordˉlocal: u32 = Bytesˉreadˉu32ˉlittle(
                Input,
                Section.Payloadˉoffset + Cursor + 1u32
            );
            if Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉisˉrecord(
                Bytesˉreadˉu8(Function.Localˉtypes, Recordˉlocal)
            ) { Hasˉrecordˉinstruction = true; }
        }
        if Hasˉrecordˉinstruction {
            let Recordˉstate:
                Recordˉinstructions.Compilerˉnativeˉx64ˉrecordˉstate =
                Compilerˉnativeˉx64ˉemitˉrecordˉstep(
                    Input,
                    Section.Payloadˉoffset + Cursor,
                    Opcode,
                    Function,
                    Analysis,
                    Types,
                    Recordˉinstructions.Compilerˉnativeˉx64ˉrecordˉstate(
                        Result,
                        Stackˉtypes,
                        Stackˉslots,
                        Stackˉdepth,
                        Nextˉi32,
                        Nextˉbool,
                        Nextˉtext,
                        Nextˉu8,
                        Nextˉu32,
                        Nextˉbytes,
                        Nextˉenum,
                        Nextˉrecord
                    )
                );
            Result = Recordˉstate.Result;
            Stackˉtypes = Recordˉstate.Stackˉtypes;
            Stackˉslots = Recordˉstate.Stackˉslots;
            Stackˉdepth = Recordˉstate.Stackˉdepth;
            Nextˉi32 = Recordˉstate.Nextˉi32;
            Nextˉbool = Recordˉstate.Nextˉbool;
            Nextˉtext = Recordˉstate.Nextˉtext;
            Nextˉu8 = Recordˉstate.Nextˉu8;
            Nextˉu32 = Recordˉstate.Nextˉu32;
            Nextˉbytes = Recordˉstate.Nextˉbytes;
            Nextˉenum = Recordˉstate.Nextˉenum;
            Nextˉrecord = Recordˉstate.Nextˉrecord;
        }
        if Opcode == 6u8 || Opcode == 7u8 {
            let Staticˉdataˉstate:
                Staticˉdataˉinstructions.Compilerˉnativeˉx64ˉstaticˉdataˉstate =
                Staticˉdataˉinstructions.Compilerˉnativeˉx64ˉemitˉstaticˉdataˉinstruction(
                    Staticˉdataˉinstructions.Compilerˉnativeˉx64ˉstaticˉdataˉinstruction(
                        Input,
                        Section.Payloadˉoffset + Cursor,
                        Opcode,
                        Boundsˉoffset
                    ),
                    Function.Locals,
                    Data,
                    Staticˉdataˉinstructions.Compilerˉnativeˉx64ˉstaticˉdataˉstate(
                        Result,
                        Stackˉtypes,
                        Stackˉslots,
                        Stackˉdepth,
                        Nextˉi32
                    )
                );
            Result = Staticˉdataˉstate.Result;
            Stackˉtypes = Staticˉdataˉstate.Stackˉtypes;
            Stackˉslots = Staticˉdataˉstate.Stackˉslots;
            Stackˉdepth = Staticˉdataˉstate.Stackˉdepth;
            Nextˉi32 = Staticˉdataˉstate.Nextˉi32;
        }
        if Opcode == 65u8 {
            let Capabilityˉindex: u32 = Bytesˉreadˉu32ˉlittle(
                Input,
                Section.Payloadˉoffset + Cursor + 1u32
            );
            let Capabilityˉkind: u8 =
                Nativeˉcapabilities.Compilerˉnativeˉx64ˉcapabilityˉkind(
                Capabilityˉtable,
                Capabilityˉindex
            );
            let Capabilityˉstate:
                Nativeˉcapabilities.Compilerˉnativeˉx64ˉcapabilityˉstate =
                Nativeˉcapabilities.Compilerˉnativeˉx64ˉemitˉcapability(
                    Capabilityˉkind,
                    Result,
                    Stackˉtypes,
                    Stackˉslots,
                    Stackˉdepth,
                    Nextˉtext,
                    Nextˉu32,
                    Nextˉbytes,
                    Function.Locals,
                    Analysis.I32ˉslots,
                    Analysis.Boolˉslots,
                    Analysis.Textˉslots,
                    Analysis.U8ˉslots,
                    Analysis.U32ˉslots,
                    Analysis.Bytesˉslots,
                    Runtimeˉserviceˉoffset
                );
            Result = Capabilityˉstate.Result;
            Stackˉtypes = Capabilityˉstate.Stackˉtypes;
            Stackˉslots = Capabilityˉstate.Stackˉslots;
            Stackˉdepth = Capabilityˉstate.Stackˉdepth;
            Nextˉtext = Capabilityˉstate.Nextˉtext;
            Nextˉu32 = Capabilityˉstate.Nextˉu32;
            Nextˉbytes = Capabilityˉstate.Nextˉbytes;
        } else {
        if Opcode == 1u8 || Opcode == 8u8 || Opcode == 9u8 {
            var Constantˉtype: u8 = 1u8;
            var Constantˉindex: u32 = Nextˉi32;
            if Opcode == 8u8 {
                Constantˉtype = 4u8;
                Constantˉindex = Nextˉu8;
            }
            if Opcode == 9u8 {
                Constantˉtype = 5u8;
                Constantˉindex = Nextˉu32;
            }
            let Constantˉslot: u32 =
                Layout.Compilerˉnativeˉx64ˉlayoutˉvalueˉslot(
                    Function.Locals,
                    Analysis.I32ˉslots,
                    Analysis.Boolˉslots,
                    Analysis.Textˉslots,
                    Analysis.U8ˉslots,
                    Analysis.U32ˉslots,
                    Analysis.Bytesˉslots,
                    Constantˉtype,
                    Constantˉindex
                );
            Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 184u8);
            if Opcode == 1u8 {
                Result = Compilerˉnativeˉx64ˉappendˉi32(
                    Result,
                    Bytesˉreadˉi32ˉlittle(
                        Input,
                        Section.Payloadˉoffset + Cursor + 1u32
                    )
                );
            }
            if Opcode == 8u8 {
                Result = Compilerˉnativeˉx64ˉappendˉu32(
                    Result,
                    U32ˉfromˉu8(Bytesˉreadˉu8(
                        Input,
                        Section.Payloadˉoffset + Cursor + 1u32
                    ))
                );
            }
            if Opcode == 9u8 {
                Result = Compilerˉnativeˉx64ˉappendˉu32(
                    Result,
                    Bytesˉreadˉu32ˉlittle(
                        Input,
                        Section.Payloadˉoffset + Cursor + 1u32
                    )
                );
            }
            Result = Compilerˉnativeˉx64ˉemitˉstoreˉeax(
                Result,
                Constantˉslot * 16u32
            );
            Stackˉtypes = Bytesˉconcat(
                Stackˉtypes,
                Bytesˉfromˉu8(Constantˉtype)
            );
            Stackˉslots = Bytesˉconcat(
                Stackˉslots,
                Bytesˉfromˉu32ˉlittle(Constantˉslot)
            );
            Stackˉdepth = Stackˉdepth + 1u32;
            if Constantˉtype == 1u8 { Nextˉi32 = Nextˉi32 + 1u32; }
            if Constantˉtype == 4u8 { Nextˉu8 = Nextˉu8 + 1u32; }
            if Constantˉtype == 5u8 { Nextˉu32 = Nextˉu32 + 1u32; }
        } else {
            if Opcode == 2u8 {
                let Boolˉconstantˉslot: u32 =
                    Function.Locals + Analysis.I32ˉslots + Nextˉbool;
                Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 184u8);
                Result = Compilerˉnativeˉx64ˉappendˉu32(
                    Result,
                    U32ˉfromˉu8(Bytesˉreadˉu8(
                        Input,
                        Section.Payloadˉoffset + Cursor + 1u32
