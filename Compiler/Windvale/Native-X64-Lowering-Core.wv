        Compilerˉnativeˉx64ˉempty(Input)
    );
}

export fn Compilerˉnativeˉx64ˉrangeˉisˉvalid(
    Total: u32,
    Offset: u32,
    Length: u32
) -> bool {
    if Offset > Total { return false; }
    return Length <= Total - Offset;
}

export fn Compilerˉnativeˉx64ˉidentifierˉisˉvalid(
    Input: bytes,
    Offset: u32,
    Length: u32
) -> bool {
    let Total: u32 = Bytesˉlength(Input);
    if Length == 0u32 { return false; }
    if Length > 255u32 { return false; }
    if !Compilerˉnativeˉx64ˉrangeˉisˉvalid(Total, Offset, Length) {
        return false;
    }
    let End: u32 = Offset + Length;
    var Cursor: u32 = Offset;
    var Wordˉstart: bool = true;
    while Cursor < End {
        let Current: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(Input, Cursor));
        var Valid: bool = false;
        if Current >= 65u32 {
            if Current <= 90u32 { Valid = true; }
        }
        if Current >= 97u32 {
            if Current <= 122u32 { Valid = true; }
        }
        if Current == 95u32 { Valid = true; }
        if !Wordˉstart {
            if Current >= 48u32 {
                if Current <= 57u32 { Valid = true; }
            }
        }
        if Valid {
            Wordˉstart = false;
            Cursor = Cursor + 1u32;
        } else {
            if Wordˉstart { return false; }
            if Current != 203u32 { return false; }
            if Cursor + 1u32 >= End { return false; }
            if Bytesˉreadˉu8(Input, Cursor + 1u32) != 137u8 { return false; }
            Wordˉstart = true;
            Cursor = Cursor + 2u32;
        }
    }
    return !Wordˉstart;
}

export fn Compilerˉnativeˉx64ˉreadˉsection(
    Input: bytes,
    Cursor: u32,
    Kind: u8
) -> Compilerˉnativeˉx64ˉsection {
    let Total: u32 = Bytesˉlength(Input);
    if !Compilerˉnativeˉx64ˉrangeˉisˉvalid(Total, Cursor, 8u32) {
        return Compilerˉnativeˉx64ˉsection(false, 0u32, 0u32, 0u32);
    }
    if Bytesˉreadˉu8(Input, Cursor) != Kind {
        return Compilerˉnativeˉx64ˉsection(false, 0u32, 0u32, 0u32);
    }
    if Bytesˉreadˉu8(Input, Cursor + 1u32) != 0u8 {
        return Compilerˉnativeˉx64ˉsection(false, 0u32, 0u32, 0u32);
    }
    if Bytesˉreadˉu16ˉlittle(Input, Cursor + 2u32) != 0u32 {
        return Compilerˉnativeˉx64ˉsection(false, 0u32, 0u32, 0u32);
    }
    let Payloadˉlength: u32 = Bytesˉreadˉu32ˉlittle(Input, Cursor + 4u32);
    let Payloadˉoffset: u32 = Cursor + 8u32;
    if !Compilerˉnativeˉx64ˉrangeˉisˉvalid(
        Total,
        Payloadˉoffset,
        Payloadˉlength
    ) {
        return Compilerˉnativeˉx64ˉsection(false, 0u32, 0u32, 0u32);
    }
    return Compilerˉnativeˉx64ˉsection(
        true,
        Payloadˉoffset,
        Payloadˉlength,
        Payloadˉoffset + Payloadˉlength
    );
}

export fn Compilerˉnativeˉx64ˉinvalidˉstructure()
    -> Compilerˉnativeˉx64ˉstructure {
    return Compilerˉnativeˉx64ˉstructure(
        false,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32
    );
}

export fn Compilerˉnativeˉx64ˉreadˉstructure(Input: bytes)
    -> Compilerˉnativeˉx64ˉstructure {
    let Total: u32 = Bytesˉlength(Input);
    if Total < 12u32 { return Compilerˉnativeˉx64ˉinvalidˉstructure(); }
    if Bytesˉreadˉu8(Input, 0u32) != 87u8 {
        return Compilerˉnativeˉx64ˉinvalidˉstructure();
    }
    if Bytesˉreadˉu8(Input, 1u32) != 86u8 {
        return Compilerˉnativeˉx64ˉinvalidˉstructure();
    }
    if Bytesˉreadˉu8(Input, 2u32) != 66u8 {
        return Compilerˉnativeˉx64ˉinvalidˉstructure();
    }
    if Bytesˉreadˉu8(Input, 3u32) != 49u8 {
        return Compilerˉnativeˉx64ˉinvalidˉstructure();
    }
    if Bytesˉreadˉu16ˉlittle(Input, 4u32) != 1u32 {
        return Compilerˉnativeˉx64ˉinvalidˉstructure();
    }
    let Minor: u32 = Bytesˉreadˉu16ˉlittle(Input, 6u32);
    if Minor != 11u32 && Minor != 30u32 && Minor != 31u32 && Minor != 33u32 {
        return Compilerˉnativeˉx64ˉinvalidˉstructure();
    }
    if Bytesˉreadˉu32ˉlittle(Input, 8u32) != 7u32 {
        return Compilerˉnativeˉx64ˉinvalidˉstructure();
    }

    let Module: Compilerˉnativeˉx64ˉsection =
        Compilerˉnativeˉx64ˉreadˉsection(Input, 12u32, 1u8);
    if !Module.Valid { return Compilerˉnativeˉx64ˉinvalidˉstructure(); }
    let Capabilities: Compilerˉnativeˉx64ˉsection =
        Compilerˉnativeˉx64ˉreadˉsection(Input, Module.Nextˉoffset, 2u8);
    if !Capabilities.Valid { return Compilerˉnativeˉx64ˉinvalidˉstructure(); }
    let Data: Compilerˉnativeˉx64ˉsection =
        Compilerˉnativeˉx64ˉreadˉsection(Input, Capabilities.Nextˉoffset, 3u8);
    if !Data.Valid { return Compilerˉnativeˉx64ˉinvalidˉstructure(); }
    let Functions: Compilerˉnativeˉx64ˉsection =
        Compilerˉnativeˉx64ˉreadˉsection(Input, Data.Nextˉoffset, 4u8);
    if !Functions.Valid { return Compilerˉnativeˉx64ˉinvalidˉstructure(); }
    let Code: Compilerˉnativeˉx64ˉsection =
        Compilerˉnativeˉx64ˉreadˉsection(Input, Functions.Nextˉoffset, 5u8);
    if !Code.Valid { return Compilerˉnativeˉx64ˉinvalidˉstructure(); }
    let Exports: Compilerˉnativeˉx64ˉsection =
        Compilerˉnativeˉx64ˉreadˉsection(Input, Code.Nextˉoffset, 6u8);
    if !Exports.Valid { return Compilerˉnativeˉx64ˉinvalidˉstructure(); }
    let Types: Compilerˉnativeˉx64ˉsection =
        Compilerˉnativeˉx64ˉreadˉsection(Input, Exports.Nextˉoffset, 7u8);
    if !Types.Valid { return Compilerˉnativeˉx64ˉinvalidˉstructure(); }
    if Types.Nextˉoffset != Total {
        return Compilerˉnativeˉx64ˉinvalidˉstructure();
    }
    return Compilerˉnativeˉx64ˉstructure(
        true,
        Module.Payloadˉoffset,
        Module.Payloadˉlength,
        Capabilities.Payloadˉoffset,
        Capabilities.Payloadˉlength,
        Data.Payloadˉoffset,
        Data.Payloadˉlength,
        Functions.Payloadˉoffset,
        Functions.Payloadˉlength,
        Code.Payloadˉoffset,
        Code.Payloadˉlength,
        Exports.Payloadˉoffset,
        Exports.Payloadˉlength,
        Types.Payloadˉoffset,
        Types.Payloadˉlength
    );
}

export fn Compilerˉnativeˉx64ˉmainˉnameˉat(Input: bytes, Offset: u32) -> bool {
    if Bytesˉreadˉu8(Input, Offset) != 77u8 { return false; }
    if Bytesˉreadˉu8(Input, Offset + 1u32) != 97u8 { return false; }
    if Bytesˉreadˉu8(Input, Offset + 2u32) != 105u8 { return false; }
    return Bytesˉreadˉu8(Input, Offset + 3u32) == 110u8;
}

export fn Compilerˉnativeˉx64ˉmoduleˉisˉvalid(
    Input: bytes,
    Section: Compilerˉnativeˉx64ˉsection,
    Minor: u32
) -> bool {
    if Section.Payloadˉlength < 6u32 { return false; }
    let Nameˉlength: u32 =
        Bytesˉreadˉu32ˉlittle(Input, Section.Payloadˉoffset + 1u32);
    if Nameˉlength > Section.Payloadˉlength - 6u32 { return false; }
    if !Compilerˉnativeˉx64ˉidentifierˉisˉvalid(
        Input,
        Section.Payloadˉoffset + 5u32,
        Nameˉlength
    ) { return false; }
    let Metadata: Nativeˉmetadata.Compilerˉnativeˉx64ˉmetadata =
        Nativeˉmetadata.Compilerˉnativeˉx64ˉmetadataˉread(
            Input,
            Section.Payloadˉoffset + 5u32 + Nameˉlength,
            Section.Payloadˉoffset + Section.Payloadˉlength,
            Bytesˉreadˉu8(Input, Section.Payloadˉoffset),
            Minor
        );
    return Metadata.Valid;
}

export fn Compilerˉnativeˉx64ˉinvalidˉfunction()
    -> Compilerˉnativeˉx64ˉfunction {
    return Compilerˉnativeˉx64ˉfunction(
        false,
        0u32,
        0u32,
        0u32,
        0u8,
        0u32,
        Textˉtoˉutf8(""),
        Textˉtoˉutf8(""),
        0u32,
        0u32
    );
}

export fn Compilerˉnativeˉx64ˉreadˉfunctionˉat(
    Input: bytes,
    Cursor: u32,
    Limit: u32,
    Requireˉmain: bool,
    Types: Nominalˉtypes.Compilerˉnativeˉx64ˉtypes
) -> Compilerˉnativeˉx64ˉfunction {
    let Total: u32 = Bytesˉlength(Input);
    if Limit > Total { return Compilerˉnativeˉx64ˉinvalidˉfunction(); }
    if Cursor > Limit { return Compilerˉnativeˉx64ˉinvalidˉfunction(); }
    if Limit - Cursor < 25u32 {
        return Compilerˉnativeˉx64ˉinvalidˉfunction();
    }
    let Nameˉlength: u32 = Bytesˉreadˉu32ˉlittle(Input, Cursor);
    if Nameˉlength == 0u32 { return Compilerˉnativeˉx64ˉinvalidˉfunction(); }
    if Nameˉlength > 255u32 { return Compilerˉnativeˉx64ˉinvalidˉfunction(); }
    if Nameˉlength > Limit - Cursor - 25u32 {
        return Compilerˉnativeˉx64ˉinvalidˉfunction();
    }
    let Nameˉoffset: u32 = Cursor + 4u32;
    if !Compilerˉnativeˉx64ˉidentifierˉisˉvalid(
        Input,
        Nameˉoffset,
        Nameˉlength
    ) {
        return Compilerˉnativeˉx64ˉinvalidˉfunction();
    }
    if Requireˉmain {
        if Nameˉlength != 4u32 {
            return Compilerˉnativeˉx64ˉinvalidˉfunction();
        }
        if !Compilerˉnativeˉx64ˉmainˉnameˉat(Input, Nameˉoffset) {
            return Compilerˉnativeˉx64ˉinvalidˉfunction();
        }
    } else {
        if Nameˉlength == 4u32 {
            if Compilerˉnativeˉx64ˉmainˉnameˉat(Input, Nameˉoffset) {
                return Compilerˉnativeˉx64ˉinvalidˉfunction();
            }
        }
    }
    let Signature: u32 = Nameˉoffset + Nameˉlength;
    let Parameters: u32 = Bytesˉreadˉu32ˉlittle(Input, Signature);
    if Parameters > Layout.Compilerˉnativeˉx64ˉlayoutˉparameterˉlimit() {
        return Compilerˉnativeˉx64ˉinvalidˉfunction();
    }
    if Requireˉmain {
        if Parameters > 1u32 {
            return Compilerˉnativeˉx64ˉinvalidˉfunction();
        }
    }
    let Parameterˉtypesˉoffset: u32 = Signature + 4u32;
    var Signatureˉcursor: u32 = Parameterˉtypesˉoffset;
    var Parameterˉtypes: bytes = Compilerˉnativeˉx64ˉempty(Input);
    var Parameterˉtypeˉidentities: bytes =
        Compilerˉnativeˉx64ˉempty(Input);
    var Parameter: u32 = 0u32;
    while Parameter < Parameters {
        let Parameterˉshape: Nominalˉtypes.Compilerˉnativeˉx64ˉshape =
            Nominalˉtypes.Compilerˉnativeˉx64ˉshapeˉread(
                Input,
                Signatureˉcursor,
                Limit,
                Types
            );
        if !Parameterˉshape.Valid {
            return Compilerˉnativeˉx64ˉinvalidˉfunction();
        }
        if !Compilerˉnativeˉx64ˉsignatureˉtypeˉisˉsupported(
            Parameterˉshape.Type
        ) {
            return Compilerˉnativeˉx64ˉinvalidˉfunction();
        }
        Parameterˉtypes = Bytesˉconcat(
            Parameterˉtypes,
            Bytesˉfromˉu8(Parameterˉshape.Type)
        );
        Parameterˉtypeˉidentities = Bytesˉconcat(
            Parameterˉtypeˉidentities,
            Bytesˉfromˉu32ˉlittle(Parameterˉshape.Identity)
        );
        Signatureˉcursor = Parameterˉshape.Next;
        Parameter = Parameter + 1u32;
    }
    if Requireˉmain && Parameters == 1u32 &&
        Bytesˉreadˉu32ˉlittle(Parameterˉtypeˉidentities, 0u32) != 25u32 {
        return Compilerˉnativeˉx64ˉinvalidˉfunction();
    }
    let Returnˉshape: Nominalˉtypes.Compilerˉnativeˉx64ˉshape =
        Nominalˉtypes.Compilerˉnativeˉx64ˉreturnˉshapeˉread(
            Input,
            Signatureˉcursor,
            Limit,
            Types
        );
    if !Returnˉshape.Valid {
        return Compilerˉnativeˉx64ˉinvalidˉfunction();
    }
    let Returnˉtype: u8 = Returnˉshape.Type;
    if Returnˉtype != 0u8 &&
        !Compilerˉnativeˉx64ˉsignatureˉtypeˉisˉsupported(Returnˉtype) {
        return Compilerˉnativeˉx64ˉinvalidˉfunction();
    }
    if Requireˉmain {
        if Returnˉtype != 1u8 && Returnˉtype != 6u8 {
            return Compilerˉnativeˉx64ˉinvalidˉfunction();
        }
    }
    if !Compilerˉnativeˉx64ˉrangeˉisˉvalid(
        Limit,
        Returnˉshape.Next,
        4u32
    ) {
        return Compilerˉnativeˉx64ˉinvalidˉfunction();
    }
    let Declaredˉlocals: u32 = Bytesˉreadˉu32ˉlittle(
        Input,
        Returnˉshape.Next
    );
    if Declaredˉlocals >= 2048u32 {
        return Compilerˉnativeˉx64ˉinvalidˉfunction();
    }
    let Locals: u32 = Parameters + Declaredˉlocals;
    if Locals >= 2048u32 {
        return Compilerˉnativeˉx64ˉinvalidˉfunction();
    }
    let Declaredˉtypesˉoffset: u32 = Returnˉshape.Next + 4u32;
    var Declaredˉtypes: bytes = Compilerˉnativeˉx64ˉempty(Input);
    var Declaredˉtypeˉidentities: bytes =
        Compilerˉnativeˉx64ˉempty(Input);
    var Declaredˉcursor: u32 = Declaredˉtypesˉoffset;
    var Local: u32 = 0u32;
    while Local < Declaredˉlocals {
        let Localˉshape: Nominalˉtypes.Compilerˉnativeˉx64ˉshape =
            Nominalˉtypes.Compilerˉnativeˉx64ˉshapeˉread(
                Input,
                Declaredˉcursor,
                Limit,
                Types
            );
        if !Localˉshape.Valid {
            return Compilerˉnativeˉx64ˉinvalidˉfunction();
        }
        if !Compilerˉnativeˉx64ˉlocalˉtypeˉisˉsupported(
            Localˉshape.Type
        ) { return Compilerˉnativeˉx64ˉinvalidˉfunction(); }
        Declaredˉtypes = Bytesˉconcat(
            Declaredˉtypes,
            Bytesˉfromˉu8(Localˉshape.Type)
        );
        Declaredˉtypeˉidentities = Bytesˉconcat(
            Declaredˉtypeˉidentities,
            Bytesˉfromˉu32ˉlittle(Localˉshape.Identity)
        );
        Declaredˉcursor = Localˉshape.Next;
        Local = Local + 1u32;
    }
    let Metadata: u32 = Declaredˉcursor;
    if !Compilerˉnativeˉx64ˉrangeˉisˉvalid(Limit, Metadata, 12u32) {
        return Compilerˉnativeˉx64ˉinvalidˉfunction();
    }
    let Codeˉoffset: u32 = Bytesˉreadˉu32ˉlittle(Input, Metadata);
    let Codeˉlength: u32 = Bytesˉreadˉu32ˉlittle(Input, Metadata + 4u32);
    let Maximumˉstack: u32 = Bytesˉreadˉu32ˉlittle(Input, Metadata + 8u32);
    if Codeˉlength == 0u32 { return Compilerˉnativeˉx64ˉinvalidˉfunction(); }
    if Codeˉlength > 131072u32 { return Compilerˉnativeˉx64ˉinvalidˉfunction(); }
    if Maximumˉstack > 1024u32 { return Compilerˉnativeˉx64ˉinvalidˉfunction(); }
    return Compilerˉnativeˉx64ˉfunction(
        true,
        Metadata + 12u32,
        Codeˉoffset,
        Parameters,
        Returnˉtype,
        Locals,
        Bytesˉconcat(
            Parameterˉtypes,
            Declaredˉtypes
        ),
        Bytesˉconcat(
            Parameterˉtypeˉidentities,
            Declaredˉtypeˉidentities
        ),
        Codeˉlength,
        Maximumˉstack
    );
}

export fn Compilerˉnativeˉx64ˉexportˉisˉsupported(
    Input: bytes,
    Section: Compilerˉnativeˉx64ˉsection,
    Target: u32
) -> bool {
    if Section.Payloadˉlength != 17u32 { return false; }
    let Offset: u32 = Section.Payloadˉoffset;
    if Bytesˉreadˉu32ˉlittle(Input, Offset) != 1u32 { return false; }
    if Bytesˉreadˉu32ˉlittle(Input, Offset + 4u32) != 4u32 { return false; }
    if !Compilerˉnativeˉx64ˉmainˉnameˉat(Input, Offset + 8u32) {
        return false;
    }
    if Bytesˉreadˉu8(Input, Offset + 12u32) != 1u8 { return false; }
    return Bytesˉreadˉu32ˉlittle(Input, Offset + 13u32) == Target;
}

export fn Compilerˉnativeˉx64ˉemptyˉanalysis()
    -> Compilerˉnativeˉx64ˉanalysis {
    return Compilerˉnativeˉx64ˉanalysis(
        false,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32
    );
}

export fn Compilerˉnativeˉx64ˉanalyzeˉcode(
    Input: bytes,
    Section: Compilerˉnativeˉx64ˉsection,
    Function: Compilerˉnativeˉx64ˉfunction
) -> Compilerˉnativeˉx64ˉanalysis {
    if Section.Payloadˉlength != Function.Codeˉlength {
        return Compilerˉnativeˉx64ˉemptyˉanalysis();
    }
    var Stack: bytes = Compilerˉnativeˉx64ˉempty(Input);
    var Stackˉdepth: u32 = 0u32;
    var Maximumˉstack: u32 = 0u32;
    var Values: u32 = 0u32;
    var Instructions: u32 = 0u32;
    var Bodyˉbytes: u32 = 0u32;
    var Returnˉvalue: u32 = 0u32;
    var Returned: bool = false;
    var Cursor: u32 = 0u32;
    while Cursor < Section.Payloadˉlength {
        if Returned { return Compilerˉnativeˉx64ˉemptyˉanalysis(); }
        let Opcode: u8 = Bytesˉreadˉu8(Input, Section.Payloadˉoffset + Cursor);
        Instructions = Instructions + 1u32;
        if Instructions > 32768u32 {
            return Compilerˉnativeˉx64ˉemptyˉanalysis();
        }
        if Opcode == 1u8 {
            if Section.Payloadˉlength - Cursor < 5u32 {
                return Compilerˉnativeˉx64ˉemptyˉanalysis();
            }
            Stack = Bytesˉconcat(Stack, Bytesˉfromˉu32ˉlittle(Values));
            Stackˉdepth = Stackˉdepth + 1u32;
            Values = Values + 1u32;
            Bodyˉbytes = Bodyˉbytes + 22u32;
            Cursor = Cursor + 5u32;
        } else {
            if Opcode == 4u8 || Opcode == 205u8 {
                if Section.Payloadˉlength - Cursor < 5u32 {
                    return Compilerˉnativeˉx64ˉemptyˉanalysis();
                }
                let Loadˉindex: u32 = Bytesˉreadˉu32ˉlittle(
                    Input,
                    Section.Payloadˉoffset + Cursor + 1u32
                );
                if Loadˉindex >= Function.Locals {
                    return Compilerˉnativeˉx64ˉemptyˉanalysis();
                }
                Stack = Bytesˉconcat(Stack, Bytesˉfromˉu32ˉlittle(Values));
                Stackˉdepth = Stackˉdepth + 1u32;
                Values = Values + 1u32;
                Bodyˉbytes = Bodyˉbytes + 24u32;
                Cursor = Cursor + 5u32;
            } else {
                if Opcode == 5u8 {
                    if Section.Payloadˉlength - Cursor < 5u32 {
                        return Compilerˉnativeˉx64ˉemptyˉanalysis();
                    }
                    let Storeˉindex: u32 = Bytesˉreadˉu32ˉlittle(
                        Input,
                        Section.Payloadˉoffset + Cursor + 1u32
                    );
                    if Storeˉindex >= Function.Locals {
                        return Compilerˉnativeˉx64ˉemptyˉanalysis();
                    }
                    if Stackˉdepth == 0u32 {
                        return Compilerˉnativeˉx64ˉemptyˉanalysis();
                    }
                    Stackˉdepth = Stackˉdepth - 1u32;
                    Stack = Bytesˉslice(Stack, 0u32, Stackˉdepth * 4u32);
                    Bodyˉbytes = Bodyˉbytes + 24u32;
                    Cursor = Cursor + 5u32;
                } else {
                    if Opcode == 16u8 {
                        if Stackˉdepth < 2u32 {
                            return Compilerˉnativeˉx64ˉemptyˉanalysis();
                        }
                        Stackˉdepth = Stackˉdepth - 2u32;
                        Stack = Bytesˉslice(Stack, 0u32, Stackˉdepth * 4u32);
                        Stack = Bytesˉconcat(Stack, Bytesˉfromˉu32ˉlittle(Values));
                        Stackˉdepth = Stackˉdepth + 1u32;
                        Values = Values + 1u32;
                        Bodyˉbytes = Bodyˉbytes + 39u32;
                        Cursor = Cursor + 1u32;
                    } else {
                        if Opcode == 17u8 {
                            if Stackˉdepth < 2u32 {
                                return Compilerˉnativeˉx64ˉemptyˉanalysis();
                            }
                            Stackˉdepth = Stackˉdepth - 2u32;
                            Stack = Bytesˉslice(Stack, 0u32, Stackˉdepth * 4u32);
                            Stack = Bytesˉconcat(Stack, Bytesˉfromˉu32ˉlittle(Values));
                            Stackˉdepth = Stackˉdepth + 1u32;
                            Values = Values + 1u32;
                            Bodyˉbytes = Bodyˉbytes + 39u32;
                            Cursor = Cursor + 1u32;
                        } else {
                            if Opcode == 18u8 {
                                if Stackˉdepth < 2u32 {
                                    return Compilerˉnativeˉx64ˉemptyˉanalysis();
                                }
                                Stackˉdepth = Stackˉdepth - 2u32;
                                Stack = Bytesˉslice(Stack, 0u32, Stackˉdepth * 4u32);
                                Stack = Bytesˉconcat(Stack, Bytesˉfromˉu32ˉlittle(Values));
                                Stackˉdepth = Stackˉdepth + 1u32;
                                Values = Values + 1u32;
                                Bodyˉbytes = Bodyˉbytes + 40u32;
                                Cursor = Cursor + 1u32;
                            } else {
                                if Opcode == 19u8 {
                                    if Stackˉdepth == 0u32 {
                                        return Compilerˉnativeˉx64ˉemptyˉanalysis();
                                    }
                                    Stackˉdepth = Stackˉdepth - 1u32;
                                    Stack = Bytesˉslice(Stack, 0u32, Stackˉdepth * 4u32);
                                    Stack = Bytesˉconcat(
                                        Stack,
                                        Bytesˉfromˉu32ˉlittle(Values)
                                    );
                                    Stackˉdepth = Stackˉdepth + 1u32;
                                    Values = Values + 1u32;
                                    Bodyˉbytes = Bodyˉbytes + 32u32;
                                    Cursor = Cursor + 1u32;
                                } else {
                                    if Opcode != 81u8 {
                                        return Compilerˉnativeˉx64ˉemptyˉanalysis();
                                    }
                                    if Stackˉdepth != 1u32 {
                                        return Compilerˉnativeˉx64ˉemptyˉanalysis();
                                    }
                                    Returnˉvalue = Bytesˉreadˉu32ˉlittle(Stack, 0u32);
                                    Stackˉdepth = 0u32;
                                    Stack = Compilerˉnativeˉx64ˉempty(Input);
                                    Bodyˉbytes = Bodyˉbytes + 30u32;
                                    Cursor = Cursor + 1u32;
                                    Returned = true;
                                }
                            }
                        }
                    }
                }
            }
        }
        if Stackˉdepth > Maximumˉstack { Maximumˉstack = Stackˉdepth; }
        if Values > 2048u32 - Function.Locals {
            return Compilerˉnativeˉx64ˉemptyˉanalysis();
        }
    }
    if !Returned { return Compilerˉnativeˉx64ˉemptyˉanalysis(); }
    if Maximumˉstack != Function.Maximumˉstack {
        return Compilerˉnativeˉx64ˉemptyˉanalysis();
    }
    return Compilerˉnativeˉx64ˉanalysis(
        true,
        Values,
        Instructions,
        Bodyˉbytes,
        Returnˉvalue,
        Maximumˉstack
    );
}

fn Compilerˉnativeˉx64ˉfailureˉcontrolˉanalysis(Input: bytes, Detail: u32)
    -> Compilerˉnativeˉx64ˉcontrolˉanalysis {
    return Compilerˉnativeˉx64ˉcontrolˉanalysis(
        false,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        Detail,
        false,
        false,
        0u32,
        Compilerˉnativeˉx64ˉempty(Input),
        Compilerˉnativeˉx64ˉempty(Input),
        Compilerˉnativeˉx64ˉempty(Input),
        Compilerˉnativeˉx64ˉempty(Input),
        Compilerˉnativeˉx64ˉempty(Input),
        0u32,
        0u32
    );
}

export fn Compilerˉnativeˉx64ˉemptyˉcontrolˉanalysis(Input: bytes)
    -> Compilerˉnativeˉx64ˉcontrolˉanalysis {
    return Compilerˉnativeˉx64ˉfailureˉcontrolˉanalysis(Input, 0u32);
}

export fn Compilerˉnativeˉx64ˉinvalidˉblock()
    -> Compilerˉnativeˉx64ˉblockˉanalysis {
    return Compilerˉnativeˉx64ˉblockˉanalysis(
        false,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u8,
        0u32
    );
}

fn Compilerˉnativeˉx64ˉblockˉvalueˉstate(
    Stack: bytes,
    Depth: u32,
    I32ˉvalues: u32,
    Boolˉvalues: u32,
    Textˉvalues: u32,
    U8ˉvalues: u32,
    U32ˉvalues: u32,
    Bytesˉvalues: u32,
    Enumˉvalues: u32,
    Recordˉvalues: u32,
    Bodyˉbytes: u32
) -> bytes {
    var Result: bytes = Bytesˉfromˉu8(1u8);
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Depth));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(I32ˉvalues));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Boolˉvalues));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Textˉvalues));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(U8ˉvalues));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(U32ˉvalues));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Bytesˉvalues));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Enumˉvalues));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Recordˉvalues));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Bodyˉbytes));
    return Bytesˉconcat(Result, Stack);
}

fn Compilerˉnativeˉx64ˉblockˉvalueˉstateˉisˉvalid(State: bytes)
    -> bool {
    if Bytesˉlength(State) < 41u32 || Bytesˉreadˉu8(State, 0u32) != 1u8 {
        return false;
    }
    return Bytesˉreadˉu32ˉlittle(State, 1u32) == Bytesˉlength(State) - 41u32;
}

fn Compilerˉnativeˉx64ˉblockˉvalueˉstateˉstack(State: bytes)
    -> bytes {
    return Bytesˉslice(State, 41u32, Bytesˉlength(State) - 41u32);
}

fn Compilerˉnativeˉx64ˉinvalidˉblockˉvalueˉstate(Input: bytes)
    -> bytes {
    return Compilerˉnativeˉx64ˉempty(Input);
}

export fn Compilerˉnativeˉx64ˉzeroˉmap(Input: bytes, Length: u32) -> bytes {
    var Result: bytes = Compilerˉnativeˉx64ˉempty(Input);
    var Chunk: bytes = Bytesˉfromˉu8(0u8);
    var Remaining: u32 = Length;
    while Remaining > 0u32 {
        if Remaining % 2u32 == 1u32 {
            Result = Bytesˉconcat(Result, Chunk);
        }
        Remaining = Remaining / 2u32;
        if Remaining > 0u32 {
            Chunk = Bytesˉconcat(Chunk, Chunk);
        }
    }
    return Result;
}

fn Compilerˉnativeˉx64ˉsetˉmapˉbyte(
    Input: bytes,
    Index: u32
) -> bytes {
    return Bytesˉconcat(
        Bytesˉconcat(
            Bytesˉslice(Input, 0u32, Index),
            Bytesˉfromˉu8(1u8)
        ),
        Bytesˉslice(
            Input,
            Index + 1u32,
            Bytesˉlength(Input) - Index - 1u32
        )
    );
}

fn Compilerˉnativeˉx64ˉleaderˉmap(
    Input: bytes,
    Leaderˉoffsets: bytes,
    Length: u32
) -> bytes {
    if Bytesˉlength(Leaderˉoffsets) % 4u32 != 0u32 {
        return Compilerˉnativeˉx64ˉempty(Input);
    }
    var Result: bytes = Compilerˉnativeˉx64ˉzeroˉmap(Input, Length);
    var Cursor: u32 = 0u32;
    while Cursor < Bytesˉlength(Leaderˉoffsets) {
        let Leader: u32 = Bytesˉreadˉu32ˉlittle(Leaderˉoffsets, Cursor);
        if Leader < Length {
            Result = Compilerˉnativeˉx64ˉsetˉmapˉbyte(Result, Leader);
        }
        Cursor = Cursor + 4u32;
    }
    return Result;
}

export fn Compilerˉnativeˉx64ˉscalarˉtypeˉisˉsupported(Type: u8) -> bool {
    if Type == 1u8 { return true; }
    if Type == 2u8 { return true; }
    if Type == 4u8 { return true; }
    if Type == 5u8 { return true; }
    return Type == 10u8;
}

export fn Compilerˉnativeˉx64ˉsignatureˉtypeˉisˉsupported(Type: u8) -> bool {
    if Compilerˉnativeˉx64ˉscalarˉtypeˉisˉsupported(Type) { return true; }
    if Descriptorˉcalls.Compilerˉnativeˉx64ˉtypeˉisˉdescriptor(Type) {
        return true;
    }
    if Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉisˉenum(Type) { return true; }
    return Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉisˉrecord(Type);
}

export fn Compilerˉnativeˉx64ˉlocalˉtypeˉisˉsupported(Type: u8) -> bool {
    if Compilerˉnativeˉx64ˉscalarˉtypeˉisˉsupported(Type) { return true; }
    if Type == 3u8 { return true; }
    if Type == 6u8 { return true; }
    if Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉisˉcallable(Type) {
        return true;
    }
    if Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉisˉenum(Type) { return true; }
    return Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉisˉrecord(Type);
}

export fn Compilerˉnativeˉx64ˉdescriptorˉoperation(Opcode: u8) -> bool {
    let Numeric: u32 = U32ˉfromˉu8(Opcode);
    if Opcode == 3u8 { return true; }
    if Opcode == 10u8 { return true; }
    if Numeric >= 11u32 {
        if Numeric <= 15u32 { return true; }
    }
    if Opcode == 110u8 { return true; }
    if Opcode == 112u8 { return true; }
    if Opcode == 113u8 { return true; }
    if Opcode == 114u8 { return true; }
    if Opcode == 115u8 { return true; }
    if Opcode == 116u8 { return true; }
    if Opcode == 117u8 { return true; }
    if Opcode == 118u8 { return true; }
    if Opcode == 119u8 { return true; }
    if Opcode == 120u8 { return true; }
    if Opcode == 121u8 { return true; }
    if Opcode == 122u8 { return true; }
    if Opcode == 123u8 { return true; }
    if Opcode == 124u8 { return true; }
    if Opcode == 125u8 { return true; }
    if Opcode == 189u8 { return true; }
    if Opcode == 190u8 { return true; }
    return Opcode == 191u8;
}

export fn Compilerˉnativeˉx64ˉnominalˉoperation(Opcode: u8) -> bool {
    let Numeric: u32 = U32ˉfromˉu8(Opcode);
    if Numeric < 106u32 { return false; }
    return Numeric <= 109u32;
}

export fn Compilerˉnativeˉx64ˉrecordˉoperation(Opcode: u8) -> bool {
    if Opcode == 104u8 { return true; }
    return Opcode == 105u8;
}

export fn Compilerˉnativeˉx64ˉvariantˉoperation(Opcode: u8) -> bool {
    let Numeric: u32 = U32ˉfromˉu8(Opcode);
    if Numeric >= 151u32 && Numeric <= 153u32 { return true; }
    return Opcode == 196u8;
}

export fn Compilerˉnativeˉx64ˉisˉi32ˉcomparison(Opcode: u8) -> bool {
    let Numeric: u32 = U32ˉfromˉu8(Opcode);
    if Numeric < 32u32 { return false; }
    return Numeric <= 37u32;
}

export fn Compilerˉnativeˉx64ˉisˉboolˉcomparison(Opcode: u8) -> bool {
    let Numeric: u32 = U32ˉfromˉu8(Opcode);
    if Numeric < 38u32 { return false; }
    return Numeric <= 39u32;
}

export fn Compilerˉnativeˉx64ˉisˉu32ˉcomparison(Opcode: u8) -> bool {
    let Numeric: u32 = U32ˉfromˉu8(Opcode);
    if Numeric < 96u32 { return false; }
    return Numeric <= 101u32;
}

export fn Compilerˉnativeˉx64ˉisˉu8ˉcomparison(Opcode: u8) -> bool {
    let Numeric: u32 = U32ˉfromˉu8(Opcode);
    if Numeric < 102u32 { return false; }
    return Numeric <= 103u32;
}

export fn Compilerˉnativeˉx64ˉisˉu64ˉcomparison(Opcode: u8) -> bool {
    let Numeric: u32 = U32ˉfromˉu8(Opcode);
    if Numeric < 143u32 { return false; }
    return Numeric <= 148u32;
}

export fn Compilerˉnativeˉx64ˉisˉu64ˉbitwise(Opcode: u8) -> bool {
    let Numeric: u32 = U32ˉfromˉu8(Opcode);
    if Numeric < 179u32 { return false; }
    return Numeric <= 184u32;
}

export fn Compilerˉnativeˉx64ˉisˉenumˉcomparison(Opcode: u8) -> bool {
    if Opcode == 107u8 { return true; }
    return Opcode == 108u8;
}

export fn Compilerˉnativeˉx64ˉinstructionˉsize(Opcode: u8) -> u32 {
    let Numeric: u32 = U32ˉfromˉu8(Opcode);
    if Opcode == 1u8 { return 5u32; }
    if Opcode == 2u8 { return 2u32; }
    if Opcode == 3u8 { return 5u32; }
    if Opcode == 4u8 { return 5u32; }
    if Opcode == 5u8 { return 5u32; }
    if Opcode == 6u8 { return 5u32; }
    if Opcode == 7u8 { return 5u32; }
    if Opcode == 8u8 { return 2u32; }
    if Opcode == 9u8 { return 5u32; }
    if Opcode == 10u8 { return 5u32; }
    if Numeric >= 11u32 {
        if Numeric <= 15u32 { return 1u32; }
    }
    if Numeric >= 16u32 {
        if Numeric <= 22u32 { return 1u32; }
    }
    if Compilerˉnativeˉx64ˉisˉi32ˉcomparison(Opcode) { return 1u32; }
    if Compilerˉnativeˉx64ˉisˉboolˉcomparison(Opcode) { return 1u32; }
    if Compilerˉnativeˉx64ˉisˉu32ˉcomparison(Opcode) { return 1u32; }
    if Compilerˉnativeˉx64ˉisˉu8ˉcomparison(Opcode) { return 1u32; }
    if Opcode == 129u8 { return 9u32; }
    if Numeric >= 134u32 && Numeric <= 136u32 { return 1u32; }
    if Compilerˉnativeˉx64ˉisˉu64ˉcomparison(Opcode) { return 1u32; }
    if Compilerˉnativeˉx64ˉrecordˉoperation(Opcode) { return 5u32; }
    if Opcode == 106u8 { return 9u32; }
    if Compilerˉnativeˉx64ˉisˉenumˉcomparison(Opcode) { return 1u32; }
    if Opcode == 109u8 { return 1u32; }
    if Compilerˉnativeˉx64ˉvariantˉoperation(Opcode) { return 9u32; }
    if Opcode == 40u8 { return 1u32; }
    if Opcode == 48u8 { return 5u32; }
    if Opcode == 49u8 { return 5u32; }
    if Opcode == 64u8 { return 5u32; }
    if Opcode == 65u8 { return 5u32; }
    if Opcode == 81u8 { return 1u32; }
    if Opcode == 110u8 { return 1u32; }
    if Opcode == 112u8 { return 1u32; }
    if Opcode == 113u8 { return 1u32; }
    if Opcode == 114u8 { return 1u32; }
    if Opcode == 115u8 { return 1u32; }
    if Opcode == 116u8 { return 1u32; }
    if Opcode == 117u8 { return 1u32; }
    if Opcode == 118u8 { return 1u32; }
    if Opcode == 119u8 { return 1u32; }
    if Opcode == 120u8 { return 1u32; }
    if Opcode == 121u8 { return 1u32; }
    if Opcode == 122u8 { return 1u32; }
    if Opcode == 123u8 { return 1u32; }
    if Opcode == 124u8 { return 1u32; }
    if Opcode == 125u8 { return 1u32; }
    if Opcode == 161u8 { return 1u32; }
    if Opcode == 162u8 { return 1u32; }
    if Opcode == 165u8 || Opcode == 166u8 { return 1u32; }
    if Numeric >= 173u32 {
        if Numeric <= 178u32 { return 1u32; }
    }
    if Opcode == 189u8 || Opcode == 190u8 || Opcode == 191u8 { return 1u32; }
    if Opcode == 211u8 { return 9u32; }
    if Opcode == 212u8 { return 5u32; }
    if Opcode == 213u8 { return 13u32; }
    if Opcode == 196u8 { return 9u32; }
    if Opcode == 205u8 { return 5u32; }
    if Opcode == 220u8 { return 13u32; }
    if Compilerˉnativeˉx64ˉisˉu64ˉbitwise(Opcode) { return 1u32; }
    return 0u32;
}

fn Compilerˉnativeˉx64ˉcodeˉusesˉsha256(
    Input: bytes,
    Codeˉoffset: u32,
    Codeˉlength: u32
) -> bool {
    var Cursor: u32 = 0u32;
    while Cursor < Codeˉlength {
        let Opcode: u8 = Bytesˉreadˉu8(Input, Codeˉoffset + Cursor);
        if Opcode == 125u8 { return true; }
        let Size: u32 = Compilerˉnativeˉx64ˉinstructionˉsize(Opcode);
        if Size == 0u32 || Size > Codeˉlength - Cursor { return false; }
        Cursor = Cursor + Size;
    }
    return false;
}

fn Compilerˉnativeˉx64ˉcallableˉversionˉisˉvalid(
    Input: bytes,
    Codeˉoffset: u32,
    Codeˉlength: u32,
    Minor: u32,
    Profile: u8,
    Types: Nominalˉtypes.Compilerˉnativeˉx64ˉtypes
) -> bool {
    var Callableˉtypes: u32 = 0u32;
    var Typeˉindex: u32 = 0u32;
    while Typeˉindex < Types.Count {
        if Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉkind(
            Types, Typeˉindex
        ) == 8u8 {
            if Nominalˉtypes.Compilerˉnativeˉx64ˉcallableˉprofile(
                Input, Types, Typeˉindex
            ) != Profile {
                return false;
            }
            Callableˉtypes = Callableˉtypes + 1u32;
        }
        Typeˉindex = Typeˉindex + 1u32;
    }

    var Referencesˉandˉcalls: u32 = 0u32;
    var Closures: u32 = 0u32;
    var Cursor: u32 = 0u32;
    while Cursor < Codeˉlength {
        let Opcode: u8 = Bytesˉreadˉu8(Input, Codeˉoffset + Cursor);
        let Size: u32 = Compilerˉnativeˉx64ˉinstructionˉsize(Opcode);
        if Size == 0u32 || Size > Codeˉlength - Cursor { return false; }
        if Opcode == 211u8 || Opcode == 212u8 {
            Referencesˉandˉcalls = Referencesˉandˉcalls + 1u32;
            if Referencesˉandˉcalls > 65536u32 { return false; }
        }
        if Opcode == 213u8 {
            Closures = Closures + 1u32;
            if Closures > 65536u32 { return false; }
        }
        Cursor = Cursor + Size;
    }
    if Minor == 11u32 {
        return Callableˉtypes == 0u32 &&
            Referencesˉandˉcalls == 0u32 && Closures == 0u32;
    }
    if Minor == 33u32 { return true; }
    if Callableˉtypes == 0u32 { return false; }
    if Minor == 30u32 {
        return Referencesˉandˉcalls > 0u32 && Closures == 0u32;
    }
    if Minor == 31u32 { return Closures > 0u32; }
    return false;
}

fn Compilerˉnativeˉx64ˉcallableˉcaptureˉtypeˉisˉsupported(
    Type: u8
) -> bool {
    if Compilerˉnativeˉx64ˉscalarˉtypeˉisˉsupported(Type) { return true; }
    return Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉisˉenum(Type);
}

fn Compilerˉnativeˉx64ˉcallableˉtargetˉmatches(
    Input: bytes,
    Types: Nominalˉtypes.Compilerˉnativeˉx64ˉtypes,
    Callableˉtype: u32,
    Target: u32,
    Captures: u32,
    Callˉdirectory: bytes
) -> bool {
    if Callableˉtype >= Types.Count ||
        Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉkind(
            Types, Callableˉtype
        ) != 8u8 {
        return false;
    }
    let Publicˉparameters: u32 =
        Nominalˉtypes.Compilerˉnativeˉx64ˉcallableˉparameters(
            Types, Callableˉtype
        );
    let Physicalˉparameters: u32 =
        Layout.Compilerˉnativeˉx64ˉlayoutˉparameters(
            Callˉdirectory, Target
        );
    if Captures > 64u32 || Publicˉparameters > 64u32 - Captures ||
        Physicalˉparameters != Captures + Publicˉparameters {
        return false;
    }
    let Result: Nominalˉtypes.Compilerˉnativeˉx64ˉshape =
        Nominalˉtypes.Compilerˉnativeˉx64ˉcallableˉresult(
            Input, Types, Callableˉtype
        );
    if !Result.Valid || Result.Type !=
        Layout.Compilerˉnativeˉx64ˉlayoutˉreturnˉtype(
            Callˉdirectory, Target
        ) {
        return false;
    }
    var Capture: u32 = 0u32;
    while Capture < Captures {
        if !Compilerˉnativeˉx64ˉcallableˉcaptureˉtypeˉisˉsupported(
            Layout.Compilerˉnativeˉx64ˉlayoutˉparameterˉtype(
                Callˉdirectory, Target, Capture
            )
        ) {
            return false;
        }
        Capture = Capture + 1u32;
    }
    var Parameter: u32 = 0u32;
    while Parameter < Publicˉparameters {
        let Shape: Nominalˉtypes.Compilerˉnativeˉx64ˉshape =
            Nominalˉtypes.Compilerˉnativeˉx64ˉcallableˉparameter(
                Input, Types, Callableˉtype, Parameter
            );
        if !Shape.Valid || Shape.Type !=
            Layout.Compilerˉnativeˉx64ˉlayoutˉparameterˉtype(
                Callˉdirectory, Target, Captures + Parameter
            ) {
            return false;
        }
        Parameter = Parameter + 1u32;
    }
    return true;
}

fn Compilerˉnativeˉx64ˉcallableˉuniqueˉtarget(
    Input: bytes,
    Types: Nominalˉtypes.Compilerˉnativeˉx64ˉtypes,
    Callableˉtype: u32,
    Callableˉfunctions: u32,
    Callˉdirectory: bytes
) -> u32 {
    let Publicˉparameters: u32 =
        Nominalˉtypes.Compilerˉnativeˉx64ˉcallableˉparameters(
            Types, Callableˉtype
        );
    if Publicˉparameters > 64u32 { return 4294967295u32; }
    var Selected: u32 = 4294967295u32;
    var Target: u32 = 0u32;
    while Target < Callableˉfunctions {
        let Physicalˉparameters: u32 =
            Layout.Compilerˉnativeˉx64ˉlayoutˉparameters(
                Callˉdirectory, Target
            );
        if Physicalˉparameters >= Publicˉparameters {
            let Captures: u32 = Physicalˉparameters - Publicˉparameters;
            if Compilerˉnativeˉx64ˉcallableˉtargetˉmatches(
                Input, Types, Callableˉtype, Target, Captures,
                Callˉdirectory
            ) {
                if Selected != 4294967295u32 {
                    return 4294967295u32;
                }
                Selected = Target;
            }
        }
        Target = Target + 1u32;
    }
    return Selected;
}

fn Compilerˉnativeˉx64ˉfunctionˉusesˉprovider(
    Input: bytes,
    Section: Compilerˉnativeˉx64ˉsection,
    Capabilityˉtable: Nativeˉcapabilities.Compilerˉnativeˉx64ˉcapabilities
) -> bool {
    var Cursor: u32 = 0u32;
    while Cursor < Section.Payloadˉlength {
        let Opcode: u8 = Bytesˉreadˉu8(Input, Section.Payloadˉoffset + Cursor);
        if Opcode == 65u8 {
            let Capabilityˉindex: u32 = Bytesˉreadˉu32ˉlittle(
                Input,
                Section.Payloadˉoffset + Cursor + 1u32
            );
            let Kind: u8 = Nativeˉcapabilities.Compilerˉnativeˉx64ˉcapabilityˉkind(
                Capabilityˉtable,
                Capabilityˉindex
            );
            if Kind == Nativeˉcapabilities.Compilerˉnativeˉx64ˉstorageˉrandomˉaccessˉkind() ||
                Kind == Nativeˉcapabilities.Compilerˉnativeˉx64ˉdirectoryˉreadˉkind() ||
                Kind == Nativeˉcapabilities.Compilerˉnativeˉx64ˉmodelˉcatalogˉkind() ||
                Kind == Nativeˉcapabilities.Compilerˉnativeˉx64ˉmodelˉinferenceˉkind() ||
                Kind == Nativeˉcapabilities.Compilerˉnativeˉx64ˉstandardˉoutputˉwriteˉkind() {
                return true;
            }
        }
        let Size: u32 = Compilerˉnativeˉx64ˉinstructionˉsize(Opcode);
        if Size == 0u32 || Size > Section.Payloadˉlength - Cursor {
            return false;
        }
        Cursor = Cursor + Size;
    }
    return false;
}

fn Compilerˉnativeˉx64ˉinstructionˉmap(
    Input: bytes,
    Payloadˉoffset: u32,
    Length: u32
) -> bytes {
    var Result: bytes = Compilerˉnativeˉx64ˉempty(Input);
    var Chunk: bytes = Compilerˉnativeˉx64ˉempty(Input);
    var Cursor: u32 = 0u32;
    while Cursor < Length {
        let Opcode: u8 = Bytesˉreadˉu8(Input, Payloadˉoffset + Cursor);
        let Size: u32 = Compilerˉnativeˉx64ˉinstructionˉsize(Opcode);
        if Size == 0u32 || Size > Length - Cursor {
            return Compilerˉnativeˉx64ˉempty(Input);
        }
        var Marker: bytes = Bytesˉslice(
            Bytesˉfromˉu32ˉlittle(Size),
            0u32,
            1u32
        );
        if Size > 1u32 {
            Marker = Bytesˉconcat(
                Marker,
                Compilerˉnativeˉx64ˉzeroˉmap(Input, Size - 1u32)
            );
        }
        Chunk = Bytesˉconcat(Chunk, Marker);
        if Bytesˉlength(Chunk) >= 4096u32 {
            Result = Bytesˉconcat(Result, Chunk);
            Chunk = Compilerˉnativeˉx64ˉempty(Input);
        }
        Cursor = Cursor + Size;
    }
    return Bytesˉconcat(Result, Chunk);
}

export fn Compilerˉnativeˉx64ˉparameterˉbytes(
    Parameterˉtypes: bytes
) -> u32 {
    return Callˉarguments.Compilerˉnativeˉx64ˉcallˉparameterˉbytes(
        Parameterˉtypes
    );
}

fn Compilerˉnativeˉx64ˉentryˉparameterˉbytes(
    Function: Compilerˉnativeˉx64ˉfunction,
    Isˉmain: bool
) -> u32 {
    var Result: u32 = Compilerˉnativeˉx64ˉparameterˉbytes(
        Bytesˉslice(Function.Localˉtypes, 0u32, Function.Parameters)
    );
    if Isˉmain && Function.Parameters == 1u32 {
        Result = Result + 12u32;
    }
    return Result;
}

fn Compilerˉnativeˉx64ˉanalyzeˉnominalˉvalueˉinstruction(
    Input: bytes,
    Instructionˉoffset: u32,
    Opcode: u8,
    State: bytes,
    Types: Nominalˉtypes.Compilerˉnativeˉx64ˉtypes,
    Localˉtypeˉidentities: bytes,
    Capabilityˉtable: Nativeˉcapabilities.Compilerˉnativeˉx64ˉcapabilities
) -> bytes {
    var Stack: bytes = Compilerˉnativeˉx64ˉblockˉvalueˉstateˉstack(State);
    var Depth: u32 = Bytesˉreadˉu32ˉlittle(State, 1u32);
    var I32ˉvalues: u32 = Bytesˉreadˉu32ˉlittle(State, 5u32);
    var Boolˉvalues: u32 = Bytesˉreadˉu32ˉlittle(State, 9u32);
    var Textˉvalues: u32 = Bytesˉreadˉu32ˉlittle(State, 13u32);
    var U8ˉvalues: u32 = Bytesˉreadˉu32ˉlittle(State, 17u32);
    var U32ˉvalues: u32 = Bytesˉreadˉu32ˉlittle(State, 21u32);
    var Bytesˉvalues: u32 = Bytesˉreadˉu32ˉlittle(State, 25u32);
    var Enumˉvalues: u32 = Bytesˉreadˉu32ˉlittle(State, 29u32);
    var Recordˉvalues: u32 = Bytesˉreadˉu32ˉlittle(State, 33u32);
    var Bodyˉbytes: u32 = Bytesˉreadˉu32ˉlittle(State, 37u32);
    if Opcode == 65u8 {
        let Capabilityˉindex: u32 = Bytesˉreadˉu32ˉlittle(
            Input,
            Instructionˉoffset + 1u32
        );
        let Capabilityˉkind: u8 =
            Nativeˉcapabilities.Compilerˉnativeˉx64ˉcapabilityˉkind(
                Capabilityˉtable,
                Capabilityˉindex
            );
        let Capabilityˉanalysis:
            Nativeˉcapabilities.Compilerˉnativeˉx64ˉcapabilityˉanalysis =
            Nativeˉcapabilities.Compilerˉnativeˉx64ˉanalyzeˉcapability(
                Capabilityˉkind,
                Stack,
                Depth,
                Textˉvalues,
                U32ˉvalues,
                Bytesˉvalues,
                Bodyˉbytes
            );
        if !Capabilityˉanalysis.Valid {
            return Compilerˉnativeˉx64ˉinvalidˉblockˉvalueˉstate(Input);
        }
        Stack = Capabilityˉanalysis.Stack;
        Depth = Capabilityˉanalysis.Depth;
        Textˉvalues = Capabilityˉanalysis.Textˉvalues;
        U32ˉvalues = Capabilityˉanalysis.U32ˉvalues;
        Bytesˉvalues = Capabilityˉanalysis.Bytesˉvalues;
        Bodyˉbytes = Capabilityˉanalysis.Bodyˉbytes;
    }
    if Opcode == 161u8 || Opcode == 162u8 ||
        Opcode == 165u8 || Opcode == 166u8 {
        var Divisionˉtype: u8 = 5u8;
        if Opcode == 165u8 || Opcode == 166u8 { Divisionˉtype = 10u8; }
        if Depth < 2u32 {
            return Compilerˉnativeˉx64ˉinvalidˉblockˉvalueˉstate(Input);
        }
        if Bytesˉreadˉu8(Stack, Depth - 1u32) != Divisionˉtype ||
            Bytesˉreadˉu8(Stack, Depth - 2u32) != Divisionˉtype {
            return Compilerˉnativeˉx64ˉinvalidˉblockˉvalueˉstate(Input);
        }
        Depth = Depth - 2u32;
        Stack = Bytesˉslice(Stack, 0u32, Depth);
        Stack = Bytesˉconcat(Stack, Bytesˉfromˉu8(Divisionˉtype));
        Depth = Depth + 1u32;
        U32ˉvalues = U32ˉvalues + 1u32;
        if Divisionˉtype == 5u8 {
            Bodyˉbytes = Bodyˉbytes +
                Descriptorˉinstructions.Compilerˉnativeˉx64ˉu32ˉdivisionˉbytes(
                    Opcode
                );
        } else {
            Bodyˉbytes = Bodyˉbytes +
                Descriptorˉinstructions.Compilerˉnativeˉx64ˉu64ˉdivisionˉbytes(
                    Opcode
                );
        }
    }
    if Compilerˉnativeˉx64ˉisˉu64ˉbitwise(Opcode) {
        let Wideˉnumeric: u32 = U32ˉfromˉu8(Opcode);
        var Wideˉoperands: u32 = 2u32;
        if Opcode == 182u8 { Wideˉoperands = 1u32; }
        if Depth < Wideˉoperands {
            return Compilerˉnativeˉx64ˉinvalidˉblockˉvalueˉstate(Input);
        }
        var Wideˉoperand: u32 = 0u32;
        while Wideˉoperand < Wideˉoperands {
            var Wideˉexpectedˉtype: u8 = 10u8;
            if (Opcode == 183u8 || Opcode == 184u8) &&
                Wideˉoperand == 0u32 {
                Wideˉexpectedˉtype = 5u8;
            }
            if Bytesˉreadˉu8(Stack, Depth - Wideˉoperand - 1u32) !=
                Wideˉexpectedˉtype {
                return Compilerˉnativeˉx64ˉinvalidˉblockˉvalueˉstate(Input);
            }
            Wideˉoperand = Wideˉoperand + 1u32;
        }
        Depth = Depth - Wideˉoperands;
        Stack = Bytesˉslice(Stack, 0u32, Depth);
        Stack = Bytesˉconcat(Stack, Bytesˉfromˉu8(10u8));
        Depth = Depth + 1u32;
        U32ˉvalues = U32ˉvalues + 1u32;
        if Wideˉnumeric >= 179u32 && Wideˉnumeric <= 181u32 {
            Bodyˉbytes = Bodyˉbytes + 37u32;
        }
        if Opcode == 182u8 { Bodyˉbytes = Bodyˉbytes + 29u32; }
        if Opcode == 183u8 || Opcode == 184u8 {
            Bodyˉbytes = Bodyˉbytes + 45u32;
        }
    }
    if Opcode == 104u8 {
        let Recordˉtypeˉindex: u32 = Bytesˉreadˉu32ˉlittle(
            Input,
            Instructionˉoffset + 1u32
        );
        if Recordˉtypeˉindex >= Types.Count ||
            Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉkind(
                Types,
                Recordˉtypeˉindex
            ) != 1u8 {
            return Compilerˉnativeˉx64ˉinvalidˉblockˉvalueˉstate(Input);
        }
        let Recordˉfields: u32 =
            Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉitemˉcount(
                Types,
                Recordˉtypeˉindex
            );
        if Depth < Recordˉfields {
            return Compilerˉnativeˉx64ˉinvalidˉblockˉvalueˉstate(Input);
        }
        var Recordˉfield: u32 = Recordˉfields;
        while Recordˉfield > 0u32 {
            Recordˉfield = Recordˉfield - 1u32;
            let Expectedˉfieldˉtype: u8 =
                Nominalˉtypes.Compilerˉnativeˉx64ˉrecordˉfieldˉtype(
                    Input,
                    Types,
                    Recordˉtypeˉindex,
                    Recordˉfield
                );
            if Bytesˉreadˉu8(
                Stack,
                Depth - Recordˉfields + Recordˉfield
            ) != Expectedˉfieldˉtype {
                return Compilerˉnativeˉx64ˉinvalidˉblockˉvalueˉstate(Input);
            }
        }
        Depth = Depth - Recordˉfields;
        Stack = Bytesˉslice(Stack, 0u32, Depth);
        Stack = Bytesˉconcat(
            Stack,
            Bytesˉfromˉu8(
                Nominalˉtypes.Compilerˉnativeˉx64ˉrecordˉtype(
                    Recordˉtypeˉindex
                )
            )
        );
        Depth = Depth + 1u32;
        Recordˉvalues = Recordˉvalues + 1u32;
        Bodyˉbytes = Bodyˉbytes +
            Records.Compilerˉnativeˉx64ˉrecordˉcreateˉbytes(
                Input,
                Types,
                Recordˉtypeˉindex
            );
    }
    if Opcode == 105u8 {
        if Depth == 0u32 {
            return Compilerˉnativeˉx64ˉinvalidˉblockˉvalueˉstate(Input);
        }
        let Recordˉtype: u8 = Bytesˉreadˉu8(Stack, Depth - 1u32);
        if !Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉisˉrecord(Recordˉtype) {
            return Compilerˉnativeˉx64ˉinvalidˉblockˉvalueˉstate(Input);
        }
        let Fieldˉrecordˉtypeˉindex: u32 =
            Nominalˉtypes.Compilerˉnativeˉx64ˉrecordˉtypeˉindex(Recordˉtype);
        if Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉkind(
            Types,
            Fieldˉrecordˉtypeˉindex
        ) != 1u8 {
            return Compilerˉnativeˉx64ˉinvalidˉblockˉvalueˉstate(Input);
        }
        let Fieldˉrecordˉindex: u32 = Bytesˉreadˉu32ˉlittle(
            Input,
            Instructionˉoffset + 1u32
        );
        if Fieldˉrecordˉindex >=
            Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉitemˉcount(
                Types,
                Fieldˉrecordˉtypeˉindex
            ) {
            return Compilerˉnativeˉx64ˉinvalidˉblockˉvalueˉstate(Input);
        }
        let Recordˉfieldˉtype: u8 =
            Nominalˉtypes.Compilerˉnativeˉx64ˉrecordˉfieldˉtype(
                Input,
                Types,
                Fieldˉrecordˉtypeˉindex,
                Fieldˉrecordˉindex
            );
        Depth = Depth - 1u32;
        Stack = Bytesˉslice(Stack, 0u32, Depth);
        Stack = Bytesˉconcat(Stack, Bytesˉfromˉu8(Recordˉfieldˉtype));
        Depth = Depth + 1u32;
        if Recordˉfieldˉtype == 1u8 { I32ˉvalues = I32ˉvalues + 1u32; }
        if Recordˉfieldˉtype == 2u8 { Boolˉvalues = Boolˉvalues + 1u32; }
        if Recordˉfieldˉtype == 3u8 { Textˉvalues = Textˉvalues + 1u32; }
        if Recordˉfieldˉtype == 4u8 { U8ˉvalues = U8ˉvalues + 1u32; }
        if Recordˉfieldˉtype == 5u8 || Recordˉfieldˉtype == 10u8 {
            U32ˉvalues = U32ˉvalues + 1u32;
        }
        if Recordˉfieldˉtype == 6u8 { Bytesˉvalues = Bytesˉvalues + 1u32; }
        if Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉisˉenum(
            Recordˉfieldˉtype
        ) { Enumˉvalues = Enumˉvalues + 1u32; }
        if Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉisˉrecord(
            Recordˉfieldˉtype
        ) { Recordˉvalues = Recordˉvalues + 1u32; }
        Bodyˉbytes = Bodyˉbytes +
            Records.Compilerˉnativeˉx64ˉrecordˉfieldˉbytes();
    }
    if Opcode == 106u8 {
        let Enumˉtypeˉindex: u32 = Bytesˉreadˉu32ˉlittle(
            Input,
            Instructionˉoffset + 1u32
        );
        let Enumˉmemberˉindex: u32 = Bytesˉreadˉu32ˉlittle(
            Input,
            Instructionˉoffset + 5u32
        );
        if Enumˉtypeˉindex >= Types.Count ||
            Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉkind(
                Types,
                Enumˉtypeˉindex
            ) != 2u8 ||
            Enumˉmemberˉindex >=
                Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉitemˉcount(
                    Types,
                    Enumˉtypeˉindex
                ) {
            return Compilerˉnativeˉx64ˉinvalidˉblockˉvalueˉstate(Input);
        }
        Stack = Bytesˉconcat(
            Stack,
            Bytesˉfromˉu8(
                Nominalˉtypes.Compilerˉnativeˉx64ˉenumˉtype(
                    Types,
                    Enumˉtypeˉindex
                )
            )
        );
        Depth = Depth + 1u32;
        Enumˉvalues = Enumˉvalues + 1u32;
        Bodyˉbytes = Bodyˉbytes +
            Enums.Compilerˉnativeˉx64ˉenumˉconstantˉbytes();
    }
    if Compilerˉnativeˉx64ˉisˉenumˉcomparison(Opcode) {
        if Depth < 2u32 {
            return Compilerˉnativeˉx64ˉinvalidˉblockˉvalueˉstate(Input);
        }
        let Enumˉright: u8 = Bytesˉreadˉu8(Stack, Depth - 1u32);
        let Enumˉleft: u8 = Bytesˉreadˉu8(Stack, Depth - 2u32);
        if !Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉisˉenum(Enumˉleft) ||
            Enumˉleft != Enumˉright {
            return Compilerˉnativeˉx64ˉinvalidˉblockˉvalueˉstate(Input);
        }
        Depth = Depth - 2u32;
        Stack = Bytesˉslice(Stack, 0u32, Depth);
        Stack = Bytesˉconcat(Stack, Bytesˉfromˉu8(2u8));
        Depth = Depth + 1u32;
        Boolˉvalues = Boolˉvalues + 1u32;
        Bodyˉbytes = Bodyˉbytes +
            Enums.Compilerˉnativeˉx64ˉenumˉcomparisonˉbytes();
    }
    if Opcode == 109u8 {
        if Depth == 0u32 {
            return Compilerˉnativeˉx64ˉinvalidˉblockˉvalueˉstate(Input);
        }
        let Namedˉenum: u8 = Bytesˉreadˉu8(Stack, Depth - 1u32);
        if !Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉisˉenum(Namedˉenum) {
            return Compilerˉnativeˉx64ˉinvalidˉblockˉvalueˉstate(Input);
        }
        Depth = Depth - 1u32;
        Stack = Bytesˉslice(Stack, 0u32, Depth);
        Stack = Bytesˉconcat(Stack, Bytesˉfromˉu8(3u8));
        Depth = Depth + 1u32;
        Textˉvalues = Textˉvalues + 1u32;
        Bodyˉbytes = Bodyˉbytes +
            Enums.Compilerˉnativeˉx64ˉenumˉnameˉbytes();
    }
    if Opcode == 220u8 {
        if Depth < 2u32 ||
            Bytesˉreadˉu8(Stack, Depth - 2u32) != 10u8 ||
            Bytesˉreadˉu8(Stack, Depth - 1u32) != 10u8 {
            return Compilerˉnativeˉx64ˉinvalidˉblockˉvalueˉstate(Input);
        }
        let Scratchˉresultˉtype: u32 = Bytesˉreadˉu32ˉlittle(
            Input,
            Instructionˉoffset + 5u32
        );
        let Scratchˉabiˉtype: u32 = Bytesˉreadˉu32ˉlittle(
            Input,
            Instructionˉoffset + 9u32
        );
        let Scratchˉbudgetˉlocal: u32 = Bytesˉreadˉu32ˉlittle(
            Input,
            Instructionˉoffset + 1u32
        );
        if Scratchˉbudgetˉlocal >= Bytesˉlength(Localˉtypeˉidentities) / 4u32 ||
            Bytesˉreadˉu32ˉlittle(
                Localˉtypeˉidentities, Scratchˉbudgetˉlocal * 4u32
            ) != 25u32 ||
            Scratchˉresultˉtype >= Types.Count ||
            Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉkind(
                Types, Scratchˉresultˉtype
            ) != 3u8 ||
            Scratchˉabiˉtype >= Types.Count {
            return Compilerˉnativeˉx64ˉinvalidˉblockˉvalueˉstate(Input);
        }
        let Scratchˉabiˉkind: u8 =
            Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉkind(
                Types, Scratchˉabiˉtype
            );
        if Scratchˉabiˉkind != 2u8 && Scratchˉabiˉkind != 7u8 {
            return Compilerˉnativeˉx64ˉinvalidˉblockˉvalueˉstate(Input);
        }
        Depth = Depth - 2u32;
        Stack = Bytesˉconcat(
            Bytesˉslice(Stack, 0u32, Depth),
            Bytesˉfromˉu8(
                Nominalˉtypes.Compilerˉnativeˉx64ˉvariantˉtype(
                    Scratchˉresultˉtype
                )
            )
        );
        Depth = Depth + 1u32;
        Recordˉvalues = Recordˉvalues + 1u32;
        Bodyˉbytes = Bodyˉbytes +
            Unsafeˉscratch.Compilerˉnativeˉx64ˉunsafeˉscratchˉbytes();
    }
    return Compilerˉnativeˉx64ˉblockˉvalueˉstate(
        Stack,
        Depth,
        I32ˉvalues,
        Boolˉvalues,
        Textˉvalues,
        U8ˉvalues,
        U32ˉvalues,
        Bytesˉvalues,
        Enumˉvalues,
        Recordˉvalues,
        Bodyˉbytes
    );
}

fn Compilerˉnativeˉx64ˉanalyzeˉdescriptorˉvalueˉinstruction(
    Input: bytes,
    Instructionˉoffset: u32,
    Opcode: u8,
    State: bytes,
    Data: Staticˉdata.Compilerˉnativeˉx64ˉdata
) -> bytes {
    var Stack: bytes = Compilerˉnativeˉx64ˉblockˉvalueˉstateˉstack(State);
    var Depth: u32 = Bytesˉreadˉu32ˉlittle(State, 1u32);
    var I32ˉvalues: u32 = Bytesˉreadˉu32ˉlittle(State, 5u32);
    var Boolˉvalues: u32 = Bytesˉreadˉu32ˉlittle(State, 9u32);
    var Textˉvalues: u32 = Bytesˉreadˉu32ˉlittle(State, 13u32);
    var U8ˉvalues: u32 = Bytesˉreadˉu32ˉlittle(State, 17u32);
    var U32ˉvalues: u32 = Bytesˉreadˉu32ˉlittle(State, 21u32);
    var Bytesˉvalues: u32 = Bytesˉreadˉu32ˉlittle(State, 25u32);
    var Bodyˉbytes: u32 = Bytesˉreadˉu32ˉlittle(State, 37u32);
    if Opcode == 191u8 {
        if Depth == 0u32 ||
            Bytesˉreadˉu8(Stack, Depth - 1u32) != 5u8 {
            return Compilerˉnativeˉx64ˉinvalidˉblockˉvalueˉstate(Input);
        }
        Depth = Depth - 1u32;
        Stack = Bytesˉslice(Stack, 0u32, Depth);
        Stack = Bytesˉconcat(Stack, Bytesˉfromˉu8(10u8));
        Depth = Depth + 1u32;
        U32ˉvalues = U32ˉvalues + 1u32;
        Bodyˉbytes = Bodyˉbytes +
            Descriptorˉinstructions.Compilerˉnativeˉx64ˉu64ˉfromˉu32ˉbytes();
    }
    if Opcode == 118u8 {
        if Depth == 0u32 ||
            Bytesˉreadˉu8(Stack, Depth - 1u32) != 4u8 {
            return Compilerˉnativeˉx64ˉinvalidˉblockˉvalueˉstate(Input);
        }
        Depth = Depth - 1u32;
        Stack = Bytesˉslice(Stack, 0u32, Depth);
        Stack = Bytesˉconcat(Stack, Bytesˉfromˉu8(5u8));
        Depth = Depth + 1u32;
        U32ˉvalues = U32ˉvalues + 1u32;
        Bodyˉbytes = Bodyˉbytes +
            Descriptorˉinstructions.Compilerˉnativeˉx64ˉu32ˉfromˉu8ˉbytes();
    }
    if Opcode == 3u8 || Opcode == 10u8 {
        let Descriptorˉdata: u32 = Bytesˉreadˉu32ˉlittle(
            Input,
            Instructionˉoffset + 1u32
        );
        if Descriptorˉdata >= Data.Count {
            return Compilerˉnativeˉx64ˉinvalidˉblockˉvalueˉstate(Input);
        }
        var Descriptorˉtype: u8 = 3u8;
        var Descriptorˉkind: u8 = 3u8;
        if Opcode == 10u8 {
            Descriptorˉtype = 6u8;
            Descriptorˉkind = 5u8;
        }
        if Staticˉdata.Compilerˉnativeˉx64ˉdataˉkind(
            Data,
            Descriptorˉdata
        ) != Descriptorˉkind {
            return Compilerˉnativeˉx64ˉinvalidˉblockˉvalueˉstate(Input);
        }
        Stack = Bytesˉconcat(Stack, Bytesˉfromˉu8(Descriptorˉtype));
        Depth = Depth + 1u32;
        if Descriptorˉtype == 3u8 {
            Textˉvalues = Textˉvalues + 1u32;
        } else {
            Bytesˉvalues = Bytesˉvalues + 1u32;
        }
        Bodyˉbytes = Bodyˉbytes +
            Descriptors.Compilerˉnativeˉx64ˉdescriptorˉconstantˉbytes();
    }
    if Opcode == 11u8 {
        if Depth == 0u32 ||
            Bytesˉreadˉu8(Stack, Depth - 1u32) != 6u8 {
            return Compilerˉnativeˉx64ˉinvalidˉblockˉvalueˉstate(Input);
        }
        Depth = Depth - 1u32;
        Stack = Bytesˉslice(Stack, 0u32, Depth);
        Stack = Bytesˉconcat(Stack, Bytesˉfromˉu8(5u8));
        Depth = Depth + 1u32;
        U32ˉvalues = U32ˉvalues + 1u32;
        Bodyˉbytes = Bodyˉbytes +
            Descriptors.Compilerˉnativeˉx64ˉdescriptorˉlengthˉbytes();
    }
    if Opcode == 12u8 {
        if Depth < 3u32 ||
            Bytesˉreadˉu8(Stack, Depth - 3u32) != 6u8 ||
            Bytesˉreadˉu8(Stack, Depth - 2u32) != 5u8 ||
            Bytesˉreadˉu8(Stack, Depth - 1u32) != 5u8 {
            return Compilerˉnativeˉx64ˉinvalidˉblockˉvalueˉstate(Input);
        }
        Depth = Depth - 3u32;
        Stack = Bytesˉslice(Stack, 0u32, Depth);
        Stack = Bytesˉconcat(Stack, Bytesˉfromˉu8(6u8));
        Depth = Depth + 1u32;
        Bytesˉvalues = Bytesˉvalues + 1u32;
        Bodyˉbytes = Bodyˉbytes +
            Descriptors.Compilerˉnativeˉx64ˉdescriptorˉsliceˉbytes();
    }
    if Opcode == 13u8 || Opcode == 14u8 || Opcode == 15u8 ||
        Opcode == 114u8 || Opcode == 189u8 {
        if Depth < 2u32 ||
            Bytesˉreadˉu8(Stack, Depth - 2u32) != 6u8 ||
            Bytesˉreadˉu8(Stack, Depth - 1u32) != 5u8 {
            return Compilerˉnativeˉx64ˉinvalidˉblockˉvalueˉstate(Input);
        }
        Depth = Depth - 2u32;
        Stack = Bytesˉslice(Stack, 0u32, Depth);
        var Readˉtype: u8 = 5u8;
        if Opcode == 13u8 { Readˉtype = 4u8; }
        if Opcode == 114u8 { Readˉtype = 1u8; }
        if Opcode == 189u8 { Readˉtype = 10u8; }
        Stack = Bytesˉconcat(Stack, Bytesˉfromˉu8(Readˉtype));
        Depth = Depth + 1u32;
        if Readˉtype == 1u8 { I32ˉvalues = I32ˉvalues + 1u32; }
        if Readˉtype == 4u8 { U8ˉvalues = U8ˉvalues + 1u32; }
        if Readˉtype == 5u8 || Readˉtype == 10u8 {
            U32ˉvalues = U32ˉvalues + 1u32;
        }
        Bodyˉbytes = Bodyˉbytes +
            Descriptors.Compilerˉnativeˉx64ˉdescriptorˉreadˉbytes(Opcode);
    }
    if Opcode == 113u8 {
        if Depth < 2u32 ||
            Bytesˉreadˉu8(Stack, Depth - 2u32) != 3u8 ||
            Bytesˉreadˉu8(Stack, Depth - 1u32) != 3u8 {
            return Compilerˉnativeˉx64ˉinvalidˉblockˉvalueˉstate(Input);
        }
        Depth = Depth - 2u32;
        Stack = Bytesˉslice(Stack, 0u32, Depth);
        Stack = Bytesˉconcat(Stack, Bytesˉfromˉu8(3u8));
        Depth = Depth + 1u32;
        Textˉvalues = Textˉvalues + 1u32;
        Bodyˉbytes = Bodyˉbytes +
            Runtimeˉdescriptors.Compilerˉnativeˉx64ˉtextˉconcatˉbytes();
    }
    if Opcode == 110u8 || Opcode == 112u8 {
        if Depth == 0u32 ||
            (Opcode == 110u8 &&
                Bytesˉreadˉu8(Stack, Depth - 1u32) != 1u8) ||
            (Opcode == 112u8 &&
                Bytesˉreadˉu8(Stack, Depth - 1u32) != 5u8) {
            return Compilerˉnativeˉx64ˉinvalidˉblockˉvalueˉstate(Input);
        }
        Depth = Depth - 1u32;
        Stack = Bytesˉslice(Stack, 0u32, Depth);
        Stack = Bytesˉconcat(Stack, Bytesˉfromˉu8(3u8));
        Depth = Depth + 1u32;
        Textˉvalues = Textˉvalues + 1u32;
        if Opcode == 110u8 {
            Bodyˉbytes = Bodyˉbytes +
                Runtimeˉdescriptors.Compilerˉnativeˉx64ˉi32ˉformatˉbytes();
        } else {
            Bodyˉbytes = Bodyˉbytes +
                Runtimeˉdescriptors.Compilerˉnativeˉx64ˉu32ˉformatˉbytes();
        }
    }
    if Opcode == 115u8 || Opcode == 116u8 {
        if Depth == 0u32 ||
            Bytesˉreadˉu8(Stack, Depth - 1u32) != 6u8 {
            return Compilerˉnativeˉx64ˉinvalidˉblockˉvalueˉstate(Input);
        }
        Depth = Depth - 1u32;
        Stack = Bytesˉslice(Stack, 0u32, Depth);
        var Runtimeˉtype: u8 = 3u8;
        if Opcode == 115u8 { Runtimeˉtype = 2u8; }
        Stack = Bytesˉconcat(Stack, Bytesˉfromˉu8(Runtimeˉtype));
        Depth = Depth + 1u32;
        if Runtimeˉtype == 2u8 {
            Boolˉvalues = Boolˉvalues + 1u32;
            Bodyˉbytes = Bodyˉbytes +
                Runtimeˉdescriptors.Compilerˉnativeˉx64ˉtextˉutf8ˉisˉvalidˉbytes();
        } else {
            Textˉvalues = Textˉvalues + 1u32;
            Bodyˉbytes = Bodyˉbytes +
                Runtimeˉdescriptors.Compilerˉnativeˉx64ˉtextˉfromˉutf8ˉbytes();
        }
    }
    if Opcode == 117u8 {
        if Depth == 0u32 ||
            Bytesˉreadˉu8(Stack, Depth - 1u32) != 3u8 {
            return Compilerˉnativeˉx64ˉinvalidˉblockˉvalueˉstate(Input);
        }
        Depth = Depth - 1u32;
        Stack = Bytesˉslice(Stack, 0u32, Depth);
        Stack = Bytesˉconcat(Stack, Bytesˉfromˉu8(3u8));
        Depth = Depth + 1u32;
        Textˉvalues = Textˉvalues + 1u32;
        Bodyˉbytes = Bodyˉbytes +
            Runtimeˉdescriptors.Compilerˉnativeˉx64ˉtextˉquoteˉbytes();
    }
    if Opcode == 125u8 {
        if Depth == 0u32 ||
            Bytesˉreadˉu8(Stack, Depth - 1u32) != 6u8 {
            return Compilerˉnativeˉx64ˉinvalidˉblockˉvalueˉstate(Input);
        }
        Depth = Depth - 1u32;
        Stack = Bytesˉslice(Stack, 0u32, Depth);
        Stack = Bytesˉconcat(Stack, Bytesˉfromˉu8(3u8));
        Depth = Depth + 1u32;
        Textˉvalues = Textˉvalues + 1u32;
        Bodyˉbytes = Bodyˉbytes + 10u32 +
            Nativeˉsha256.Compilerˉnativeˉx64ˉsha256ˉinstructionˉbytes();
    }
    if Opcode == 119u8 {
        if Depth < 2u32 ||
            Bytesˉreadˉu8(Stack, Depth - 2u32) != 6u8 ||
            Bytesˉreadˉu8(Stack, Depth - 1u32) != 6u8 {
            return Compilerˉnativeˉx64ˉinvalidˉblockˉvalueˉstate(Input);
        }
        Depth = Depth - 2u32;
        Stack = Bytesˉslice(Stack, 0u32, Depth);
        Stack = Bytesˉconcat(Stack, Bytesˉfromˉu8(6u8));
        Depth = Depth + 1u32;
        Bytesˉvalues = Bytesˉvalues + 1u32;
        Bodyˉbytes = Bodyˉbytes +
            Bytesˉconcatenation.Compilerˉnativeˉx64ˉbytesˉconcatˉbytes();
    }
    if Opcode == 120u8 {
        if Depth == 0u32 ||
            Bytesˉreadˉu8(Stack, Depth - 1u32) != 4u8 {
            return Compilerˉnativeˉx64ˉinvalidˉblockˉvalueˉstate(Input);
        }
        Depth = Depth - 1u32;
        Stack = Bytesˉslice(Stack, 0u32, Depth);
        Stack = Bytesˉconcat(Stack, Bytesˉfromˉu8(6u8));
        Depth = Depth + 1u32;
        Bytesˉvalues = Bytesˉvalues + 1u32;
        Bodyˉbytes = Bodyˉbytes +
            Bytesˉconcatenation.Compilerˉnativeˉx64ˉbytesˉfromˉu8ˉbytes();
    }
    if Opcode == 121u8 || Opcode == 122u8 || Opcode == 123u8 ||
        Opcode == 190u8 {
        if Depth == 0u32 {
            return Compilerˉnativeˉx64ˉinvalidˉblockˉvalueˉstate(Input);
        }
        var Sourceˉtype: u8 = 5u8;
        if Opcode == 123u8 { Sourceˉtype = 1u8; }
        if Opcode == 190u8 { Sourceˉtype = 10u8; }
        if Bytesˉreadˉu8(Stack, Depth - 1u32) != Sourceˉtype {
            return Compilerˉnativeˉx64ˉinvalidˉblockˉvalueˉstate(Input);
        }
        Depth = Depth - 1u32;
        Stack = Bytesˉslice(Stack, 0u32, Depth);
        Stack = Bytesˉconcat(Stack, Bytesˉfromˉu8(6u8));
        Depth = Depth + 1u32;
        Bytesˉvalues = Bytesˉvalues + 1u32;
        if Opcode == 121u8 {
            Bodyˉbytes = Bodyˉbytes +
                Bytesˉconcatenation.Compilerˉnativeˉx64ˉbytesˉfromˉu16ˉlittleˉbytes();
        } else if Opcode == 190u8 {
            Bodyˉbytes = Bodyˉbytes +
                Bytesˉconcatenation.Compilerˉnativeˉx64ˉbytesˉfromˉu64ˉlittleˉbytes();
        } else {
            Bodyˉbytes = Bodyˉbytes +
                Bytesˉconcatenation.Compilerˉnativeˉx64ˉbytesˉfromˉ32ˉlittleˉbytes();
        }
    }
    if Opcode == 124u8 {
        if Depth == 0u32 ||
            Bytesˉreadˉu8(Stack, Depth - 1u32) != 3u8 {
            return Compilerˉnativeˉx64ˉinvalidˉblockˉvalueˉstate(Input);
        }
        Depth = Depth - 1u32;
        Stack = Bytesˉslice(Stack, 0u32, Depth);
        Stack = Bytesˉconcat(Stack, Bytesˉfromˉu8(6u8));
        Depth = Depth + 1u32;
        Bytesˉvalues = Bytesˉvalues + 1u32;
        Bodyˉbytes = Bodyˉbytes +
            Descriptors.Compilerˉnativeˉx64ˉdescriptorˉcopyˉbytes();
    }
    return Compilerˉnativeˉx64ˉblockˉvalueˉstate(
        Stack,
        Depth,
        I32ˉvalues,
        Boolˉvalues,
        Textˉvalues,
        U8ˉvalues,
        U32ˉvalues,
        Bytesˉvalues,
        Bytesˉreadˉu32ˉlittle(State, 29u32),
        Bytesˉreadˉu32ˉlittle(State, 33u32),
        Bodyˉbytes
    );
}

export fn Compilerˉnativeˉx64ˉanalyzeˉblock(
    Input: bytes,
    Section: Compilerˉnativeˉx64ˉsection,
    Function: Compilerˉnativeˉx64ˉfunction,
    Instructions: bytes,
    Start: u32,
    End: u32,
    Isˉmain: bool,
    Callableˉfunctions: u32,
    Callˉdirectory: bytes,
    Data: Staticˉdata.Compilerˉnativeˉx64ˉdata,
    Types: Nominalˉtypes.Compilerˉnativeˉx64ˉtypes,
    Capabilityˉtable: Nativeˉcapabilities.Compilerˉnativeˉx64ˉcapabilities
) -> Compilerˉnativeˉx64ˉblockˉanalysis {
    let Length: u32 = Section.Payloadˉlength;
    if Start >= End || End > Length {
        return Compilerˉnativeˉx64ˉinvalidˉblock();
    }
    var Stack: bytes = Compilerˉnativeˉx64ˉempty(Input);
    var Depth: u32 = 0u32;
    var Maximum: u32 = 0u32;
    var I32ˉvalues: u32 = 0u32;
    var Boolˉvalues: u32 = 0u32;
    var Textˉvalues: u32 = 0u32;
    var U8ˉvalues: u32 = 0u32;
    var U32ˉvalues: u32 = 0u32;
    var Bytesˉvalues: u32 = 0u32;
    var Enumˉvalues: u32 = 0u32;
    var Recordˉvalues: u32 = 0u32;
    var Bodyˉbytes: u32 = 0u32;
    var Terminator: u8 = 0u8;
    var Target: u32 = 0u32;
    var Cursor: u32 = Start;
    while Cursor < End {
        let Opcode: u8 = Bytesˉreadˉu8(Input, Section.Payloadˉoffset + Cursor);
        let Numericˉopcode: u32 = U32ˉfromˉu8(Opcode);
        let Size: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(Instructions, Cursor));
        if Size == 0u32 {
            return Compilerˉnativeˉx64ˉinvalidˉblock();
        }
        let Next: u32 = Cursor + Size;
        if Next > End { return Compilerˉnativeˉx64ˉinvalidˉblock(); }
        if Opcode == 211u8 || Opcode == 212u8 || Opcode == 213u8 {
            if Opcode == 211u8 {
                let Referenceˉtarget: u32 = Bytesˉreadˉu32ˉlittle(
                    Input, Section.Payloadˉoffset + Cursor + 1u32
                );
                let Referenceˉtype: u32 = Bytesˉreadˉu32ˉlittle(
                    Input, Section.Payloadˉoffset + Cursor + 5u32
                );
                if Referenceˉtarget >= Callableˉfunctions ||
                    !Compilerˉnativeˉx64ˉcallableˉtargetˉmatches(
                        Input, Types, Referenceˉtype, Referenceˉtarget,
                        0u32, Callˉdirectory
                    ) {
                    return Compilerˉnativeˉx64ˉinvalidˉblock();
                }
                Stack = Bytesˉconcat(Stack, Bytesˉfromˉu8(11u8));
                Depth = Depth + 1u32;
                Bytesˉvalues = Bytesˉvalues + 1u32;
            } else if Opcode == 213u8 {
                let Closureˉtarget: u32 = Bytesˉreadˉu32ˉlittle(
                    Input, Section.Payloadˉoffset + Cursor + 1u32
                );
                let Closureˉtype: u32 = Bytesˉreadˉu32ˉlittle(
                    Input, Section.Payloadˉoffset + Cursor + 5u32
                );
                let Closureˉcaptures: u32 = Bytesˉreadˉu32ˉlittle(
                    Input, Section.Payloadˉoffset + Cursor + 9u32
                );
                if Closureˉtarget >= Callableˉfunctions ||
                    Closureˉcaptures == 0u32 || Depth < Closureˉcaptures ||
                    !Compilerˉnativeˉx64ˉcallableˉtargetˉmatches(
                        Input, Types, Closureˉtype, Closureˉtarget,
                        Closureˉcaptures, Callˉdirectory
                    ) {
                    return Compilerˉnativeˉx64ˉinvalidˉblock();
                }
                var Capture: u32 = 0u32;
                while Capture < Closureˉcaptures {
                    if Bytesˉreadˉu8(
                        Stack, Depth - Closureˉcaptures + Capture
                    ) != Layout.Compilerˉnativeˉx64ˉlayoutˉparameterˉtype(
                        Callˉdirectory, Closureˉtarget, Capture
                    ) {
                        return Compilerˉnativeˉx64ˉinvalidˉblock();
                    }
                    Capture = Capture + 1u32;
                }
                Depth = Depth - Closureˉcaptures;
                Stack = Bytesˉslice(Stack, 0u32, Depth);
                Stack = Bytesˉconcat(Stack, Bytesˉfromˉu8(11u8));
                Depth = Depth + 1u32;
                Bytesˉvalues = Bytesˉvalues + 1u32;
            } else {
                let Indirectˉtype: u32 = Bytesˉreadˉu32ˉlittle(
                    Input, Section.Payloadˉoffset + Cursor + 1u32
                );
                let Indirectˉtarget: u32 =
                    Compilerˉnativeˉx64ˉcallableˉuniqueˉtarget(
                        Input, Types, Indirectˉtype, Callableˉfunctions,
                        Callˉdirectory
                    );
                if Indirectˉtarget == 4294967295u32 {
                    return Compilerˉnativeˉx64ˉinvalidˉblock();
                }
                let Publicˉparameters: u32 =
                    Nominalˉtypes.Compilerˉnativeˉx64ˉcallableˉparameters(
                        Types, Indirectˉtype
                    );
                if Depth < Publicˉparameters + 1u32 ||
                    Bytesˉreadˉu8(
                        Stack, Depth - Publicˉparameters - 1u32
                    ) != 11u8 {
                    return Compilerˉnativeˉx64ˉinvalidˉblock();
                }
                var Publicˉparameter: u32 = 0u32;
                while Publicˉparameter < Publicˉparameters {
                    let Parameterˉshape:
                        Nominalˉtypes.Compilerˉnativeˉx64ˉshape =
                        Nominalˉtypes.Compilerˉnativeˉx64ˉcallableˉparameter(
                            Input, Types, Indirectˉtype, Publicˉparameter
                        );
                    if !Parameterˉshape.Valid ||
                        Bytesˉreadˉu8(
                            Stack,
                            Depth - Publicˉparameters + Publicˉparameter
                        ) != Parameterˉshape.Type {
                        return Compilerˉnativeˉx64ˉinvalidˉblock();
                    }
                    Publicˉparameter = Publicˉparameter + 1u32;
                }
                Depth = Depth - Publicˉparameters - 1u32;
                Stack = Bytesˉslice(Stack, 0u32, Depth);
                let Callableˉresultˉshape:
                    Nominalˉtypes.Compilerˉnativeˉx64ˉshape =
                    Nominalˉtypes.Compilerˉnativeˉx64ˉcallableˉresult(
                        Input, Types, Indirectˉtype
                    );
                if !Callableˉresultˉshape.Valid {
                    return Compilerˉnativeˉx64ˉinvalidˉblock();
                }
                Stack = Bytesˉconcat(
                    Stack, Bytesˉfromˉu8(Callableˉresultˉshape.Type)
                );
                Depth = Depth + 1u32;
                if Callableˉresultˉshape.Type == 1u8 {
                    I32ˉvalues = I32ˉvalues + 1u32;
                }
                if Callableˉresultˉshape.Type == 2u8 {
                    Boolˉvalues = Boolˉvalues + 1u32;
                }
                if Callableˉresultˉshape.Type == 4u8 {
                    U8ˉvalues = U8ˉvalues + 1u32;
                }
                if Callableˉresultˉshape.Type == 5u8 ||
