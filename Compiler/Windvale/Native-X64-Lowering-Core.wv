export fn Compilerˉnativeˉx64ˉempty(Input: bytes) -> bytes {
    return Bytesˉslice(Input, 0u32, 0u32);
}

export fn Compilerˉnativeˉx64ˉfailure(
    Input: bytes,
    Status: Compilerˉnativeˉx64ˉstatus
) -> Compilerˉnativeˉx64ˉsummary {
    return Compilerˉnativeˉx64ˉsummary(
        Status,
        Compilerˉnativeˉx64ˉempty(Input),
        0,
        22u32,
        0u32
    );
}

fn Compilerˉnativeˉx64ˉplanˉfailure(
    Input: bytes,
    Status: Compilerˉnativeˉx64ˉstatus
) -> Compilerˉnativeˉx64ˉplan {
