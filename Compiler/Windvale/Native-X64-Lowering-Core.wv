                    let Loadˉslot: u32 =
                        Layout.Compilerˉnativeˉx64ˉlayoutˉvalueˉslot(
                            Function.Locals,
                            Analysis.I32ˉslots,
                            Analysis.Boolˉslots,
                            Analysis.Textˉslots,
                            Analysis.U8ˉslots,
                            Analysis.U32ˉslots,
                            Analysis.Bytesˉslots,
                            Loadˉtype,
                            Loadˉindex
