        if Opcode == 152u8 {
            return Variantˉinstructions.Compilerˉnativeˉx64ˉvariantˉisˉcaseˉbytes();
        }
        if Opcode == 196u8 {
            let Selection: u32 = Bytesˉreadˉu32ˉlittle(Input, Offset + 5u32);
            let Field: Nominalˉtypes.Compilerˉnativeˉx64ˉshape =
                Nominalˉtypes.Compilerˉnativeˉx64ˉvariantˉcaseˉfield(
                    Input,
                    Types,
                    Variantˉtypeˉindex,
                    Selection / 64u32,
                    Selection % 64u32
                );
            return Variantˉinstructions.Compilerˉnativeˉx64ˉvariantˉpayloadˉbytes(
                Field.Type
            );
        }
        let Payload: Nominalˉtypes.Compilerˉnativeˉx64ˉshape =
            Nominalˉtypes.Compilerˉnativeˉx64ˉvariantˉcaseˉpayload(
                Input,
                Types,
                Variantˉtypeˉindex,
                Variantˉcaseˉindex
