                let Callee: Compilerˉnativeˉx64ˉfunction = Compilerˉnativeˉx64ˉcalleeˉread(Input, Function, Sharedˉcallˉtarget, Types);
                if !Callee.Valid || Sharedˉcallˉtarget == Function.Signatureˉmain ||
                    Bytesˉlength(Callee.Localˉtypeˉidentities) < Callee.Parameters * 4u32 ||
                    Bytesˉlength(Callee.Localˉborrowˉkinds) < Callee.Parameters {
                    return Compilerˉnativeˉx64ˉinvalidˉblock();
                }
                let Callˉbytes: u32 = Callˉinstructions.Sharedˉcallˉbytes(Input, Types,
                    Bytesˉslice(Callee.Localˉtypes, 0u32, Callee.Parameters),
                    Bytesˉslice(Callee.Localˉtypeˉidentities, 0u32, Callee.Parameters * 4u32),
                    Bytesˉslice(Callee.Localˉborrowˉkinds, 0u32, Callee.Parameters),
                    Callee.Returnˉtype, Callee.Returnˉidentity);
                if Callˉbytes == 4294967295u32 { return Compilerˉnativeˉx64ˉinvalidˉblock(); }
                Bodyˉbytes = Beforeˉbytes + Callˉbytes;
            }
            if Opcode == 81u8 {
                let Returnˉbytes: u32 = Compilerˉnativeˉx64ˉsharedˉreturnˉbytes(Input, Function, Types);
                if Returnˉbytes == 4294967295u32 { return Compilerˉnativeˉx64ˉinvalidˉblock(); }
                Bodyˉbytes = Beforeˉbytes + Returnˉbytes;
            }
            let Transferˉbytes: u32 = Compilerˉnativeˉx64ˉsharedˉtransitionˉbytes(Input,
                Section.Payloadˉoffset + Cursor, Opcode, Function, Types, Beforeˉstack, Stack);
            if Transferˉbytes == 4294967295u32 { return Compilerˉnativeˉx64ˉinvalidˉblock(); }
            Bodyˉbytes = Bodyˉbytes + Transferˉbytes;
            var Callˉreturn: u8 = 1u8;
            if Opcode == 64u8 {
                Callˉreturn = Layout.Compilerˉnativeˉx64ˉlayoutˉreturnˉtype(Callˉdirectory,
                    Bytesˉreadˉu32ˉlittle(Input, Section.Payloadˉoffset + Cursor + 1u32));
            }
            var Identity: u32 = 0u32;
            if Compilerˉnativeˉx64ˉinstructionˉproduces(Opcode, Callˉreturn) {
                Identity = Compilerˉnativeˉx64ˉinstructionˉidentity(Input,
                    Section.Payloadˉoffset + Cursor, Opcode, Function, Types, Beforeˉstack);
                if Identity == 4294967294u32 || Depth == 0u32 {
                    return Compilerˉnativeˉx64ˉinvalidˉblock();
                }
                Stackˉidentities = Bytesˉconcat(Bytesˉslice(Stackˉidentities, 0u32, (Depth - 1u32) * 4u32),
                    Bytesˉfromˉu32ˉlittle(Identity));
            } else {
                Stackˉidentities = Bytesˉslice(Stackˉidentities, 0u32, Depth * 4u32);
            }
            Instructionˉsizes = Bytesˉconcat(Instructionˉsizes,
                Bytesˉconcat(Bytesˉconcat(Bytesˉfromˉu32ˉlittle(Cursor), Bytesˉfromˉu32ˉlittle(Bodyˉbytes - Beforeˉbytes)),
                    Bytesˉconcat(Bytesˉfromˉu32ˉlittle(Identity), Bytesˉfromˉu32ˉlittle(0u32))));
        }
        Cursor = Next;
    }
    if Terminator == 0u8 {
        if Depth != 0u32 { return Compilerˉnativeˉx64ˉinvalidˉblock(); }
        if End == Length { return Compilerˉnativeˉx64ˉinvalidˉblock(); }
    }
    return Compilerˉnativeˉx64ˉblockˉanalysis(
        true,
        End,
        I32ˉvalues,
        Boolˉvalues,
        Textˉvalues,
        U8ˉvalues,
        U32ˉvalues,
        Bytesˉvalues,
        Enumˉvalues,
        Recordˉvalues,
        Maximum,
        Bodyˉbytes,
        Terminator,
        Target,
        Instructionˉsizes
    );
}

export fn Compilerˉnativeˉx64ˉanalyzeˉcontrolˉcode(
    Input: bytes,
    Section: Compilerˉnativeˉx64ˉsection,
    Function: Compilerˉnativeˉx64ˉfunction,
    Isˉmain: bool,
    Callableˉfunctions: u32,
    Callˉdirectory: bytes,
    Data: Staticˉdata.Compilerˉnativeˉx64ˉdata,
    Types: Nominalˉtypes.Compilerˉnativeˉx64ˉtypes,
    Capabilityˉtable: Nativeˉcapabilities.Compilerˉnativeˉx64ˉcapabilities
) -> Compilerˉnativeˉx64ˉcontrolˉanalysis {
    if Section.Payloadˉlength != Function.Codeˉlength {
        return Compilerˉnativeˉx64ˉfailureˉcontrolˉanalysis(Input, 1u32);
    }
    let Length: u32 = Section.Payloadˉlength;
    var Leaderˉoffsets: bytes = Bytesˉfromˉu32ˉlittle(0u32);
    var Instructionˉcount: u32 = 0u32;
    var Callableˉoperations: u32 = 0u32;
    var Callableˉenvironmentˉslots: u32 = 0u32;
    var Callableˉcaptureˉslots: u32 = 0u32;
    var Unsafeˉbackingˉslots: u32 = 0u32;
    var Hasˉdivision: bool = false;
    var Hasˉshift: bool = false;
    var Outgoingˉbytes: u32 = 0u32;
    var Cursor: u32 = 0u32;
    while Cursor < Length {
        let Opcode: u8 = Bytesˉreadˉu8(Input, Section.Payloadˉoffset + Cursor);
        let Opcodeˉnumber: u32 = U32ˉfromˉu8(Opcode);
        let Size: u32 = Compilerˉnativeˉx64ˉinstructionˉsize(Opcode);
        if Opcode == 161u8 || Opcode == 162u8 ||
            Opcode == 165u8 || Opcode == 166u8 { Hasˉdivision = true; }
        if Opcode == 177u8 || Opcode == 178u8 { Hasˉshift = true; }
        if Opcode == 220u8 && Bytesˉreadˉu16ˉlittle(Input, 6u32) == 38u32 {
            Unsafeˉbackingˉslots = 4u32;
        }
        if Size == 0u32 {
            return Compilerˉnativeˉx64ˉfailureˉcontrolˉanalysis(Input, 1u32);
        }
        if Size > Length - Cursor {
            return Compilerˉnativeˉx64ˉfailureˉcontrolˉanalysis(Input, 1u32);
        }
        if Function.Sharedˉvalues {
            // These paths still use earlier context layouts or pointer services.
            if Opcode == 109u8 || Opcode == 202u8 || Opcode == 207u8 ||
                Opcode == 208u8 || Opcode == 209u8 || (Opcodeˉnumber >= 210u32 && Opcodeˉnumber <= 224u32) ||
                Opcode == 226u8 || Opcode == 227u8 || Opcode == 228u8 {
                return Compilerˉnativeˉx64ˉfailureˉcontrolˉanalysis(Input, 15u32);
            }
            if Opcode == 64u8 {
                let Target: u32 = Bytesˉreadˉu32ˉlittle(Input, Section.Payloadˉoffset + Cursor + 1u32);
                let Parameters: u32 = Layout.Compilerˉnativeˉx64ˉlayoutˉparameters(Callˉdirectory, Target);
                if Target >= Callableˉfunctions || Target == Function.Signatureˉmain || Parameters > 64u32 {
                    return Compilerˉnativeˉx64ˉfailureˉcontrolˉanalysis(Input, 11u32);
                }
                let Arguments: u32 = Callˉarguments.Compilerˉnativeˉx64ˉcallˉstackˉbytes(Parameters);
                if Arguments > Outgoingˉbytes { Outgoingˉbytes = Arguments; }
            }
        }
        if Opcode == 2u8 {
            if U32ˉfromˉu8(
                Bytesˉreadˉu8(Input, Section.Payloadˉoffset + Cursor + 1u32)
            ) > 1u32 {
                return Compilerˉnativeˉx64ˉfailureˉcontrolˉanalysis(Input, 1u32);
            }
        }
        if Opcode == 211u8 {
            let Referenceˉtarget: u32 = Bytesˉreadˉu32ˉlittle(
                Input, Section.Payloadˉoffset + Cursor + 1u32
            );
            let Referenceˉtype: u32 = Bytesˉreadˉu32ˉlittle(
                Input, Section.Payloadˉoffset + Cursor + 5u32
            );
            if Referenceˉtarget >= Callableˉfunctions ||
                !Compilerˉnativeˉx64ˉcallableˉtargetˉmatches(
                    Input, Types, Referenceˉtype, Referenceˉtarget, 0u32,
                    Callˉdirectory
                ) ||
                Compilerˉnativeˉx64ˉcallableˉuniqueˉtarget(
                    Input, Types, Referenceˉtype, Callableˉfunctions,
                    Callˉdirectory
                ) != Referenceˉtarget {
                return Compilerˉnativeˉx64ˉfailureˉcontrolˉanalysis(
                    Input, 12u32
                );
            }
            Callableˉoperations = Callableˉoperations + 1u32;
        }
        if Opcode == 213u8 {
            let Closureˉtarget: u32 = Bytesˉreadˉu32ˉlittle(
                Input, Section.Payloadˉoffset + Cursor + 1u32
            );
            let Closureˉtype: u32 = Bytesˉreadˉu32ˉlittle(
                Input, Section.Payloadˉoffset + Cursor + 5u32
            );
            let Closureˉcaptures: u32 = Bytesˉreadˉu32ˉlittle(
                Input, Section.Payloadˉoffset + Cursor + 9u32
            );
            if Closureˉtarget >= Callableˉfunctions ||
                Closureˉcaptures == 0u32 || Closureˉcaptures > 64u32 ||
                !Compilerˉnativeˉx64ˉcallableˉtargetˉmatches(
                    Input, Types, Closureˉtype, Closureˉtarget,
                    Closureˉcaptures, Callˉdirectory
                ) ||
                Compilerˉnativeˉx64ˉcallableˉuniqueˉtarget(
                    Input, Types, Closureˉtype, Callableˉfunctions,
                    Callˉdirectory
                ) != Closureˉtarget ||
                Callableˉenvironmentˉslots > 1024u32 - Closureˉcaptures {
                return Compilerˉnativeˉx64ˉfailureˉcontrolˉanalysis(
                    Input, 12u32
                );
            }
            Callableˉenvironmentˉslots = Callableˉenvironmentˉslots +
                Closureˉcaptures;
            Callableˉoperations = Callableˉoperations + 1u32;
        }
        if Opcode == 212u8 {
            let Indirectˉtype: u32 = Bytesˉreadˉu32ˉlittle(
                Input, Section.Payloadˉoffset + Cursor + 1u32
            );
            let Indirectˉtarget: u32 =
                Compilerˉnativeˉx64ˉcallableˉuniqueˉtarget(
                    Input, Types, Indirectˉtype, Callableˉfunctions,
                    Callˉdirectory
                );
            if Indirectˉtarget == 4294967295u32 {
                return Compilerˉnativeˉx64ˉfailureˉcontrolˉanalysis(
                    Input, 12u32
                );
            }
            let Indirectˉpublic: u32 =
                Nominalˉtypes.Compilerˉnativeˉx64ˉcallableˉparameters(
                    Types, Indirectˉtype
                );
            let Indirectˉphysical: u32 =
                Layout.Compilerˉnativeˉx64ˉlayoutˉparameters(
                    Callˉdirectory, Indirectˉtarget
                );
            let Indirectˉcaptures: u32 =
                Indirectˉphysical - Indirectˉpublic;
            if Indirectˉcaptures > Callableˉcaptureˉslots {
                Callableˉcaptureˉslots = Indirectˉcaptures;
            }
            Callableˉoperations = Callableˉoperations + 1u32;
        }
        Instructionˉcount = Instructionˉcount + 1u32;
        if Instructionˉcount > 32768u32 {
            return Compilerˉnativeˉx64ˉfailureˉcontrolˉanalysis(Input, 1u32);
        }
        let Next: u32 = Cursor + Size;
        if Opcode == 48u8 {
            let Jumpˉtarget: u32 = Bytesˉreadˉu32ˉlittle(
                Input,
                Section.Payloadˉoffset + Cursor + 1u32
            );
            if Jumpˉtarget >= Length {
                return Compilerˉnativeˉx64ˉfailureˉcontrolˉanalysis(Input, 1u32);
            }
            Leaderˉoffsets = Bytesˉconcat(
                Leaderˉoffsets,
                Bytesˉfromˉu32ˉlittle(Jumpˉtarget)
            );
        }
        if Opcode == 49u8 {
            let Branchˉtarget: u32 = Bytesˉreadˉu32ˉlittle(
                Input,
                Section.Payloadˉoffset + Cursor + 1u32
            );
            if Branchˉtarget >= Length {
                return Compilerˉnativeˉx64ˉfailureˉcontrolˉanalysis(Input, 1u32);
            }
            if Next >= Length {
                return Compilerˉnativeˉx64ˉfailureˉcontrolˉanalysis(Input, 1u32);
            }
            Leaderˉoffsets = Bytesˉconcat(
                Leaderˉoffsets,
                Bytesˉfromˉu32ˉlittle(Branchˉtarget)
            );
            Leaderˉoffsets = Bytesˉconcat(
                Leaderˉoffsets,
                Bytesˉfromˉu32ˉlittle(Next)
            );
        }
        Cursor = Next;
    }
    let Leaders: bytes = Compilerˉnativeˉx64ˉleaderˉmap(
        Input,
        Leaderˉoffsets,
        Length
    );
    if Bytesˉlength(Leaders) != Length {
        return Compilerˉnativeˉx64ˉfailureˉcontrolˉanalysis(Input, 2u32);
    }
    let Instructionsˉmap: bytes = Compilerˉnativeˉx64ˉinstructionˉmap(
        Input,
        Section.Payloadˉoffset,
        Length
    );
    if Bytesˉlength(Instructionsˉmap) != Length {
        return Compilerˉnativeˉx64ˉfailureˉcontrolˉanalysis(Input, 2u32);
    }
    var Ownership: Affineˉownership.Analysis = Affineˉownership.Analysis(true,
        Compilerˉnativeˉx64ˉempty(Input));
    if !Function.Sharedˉvalues {
        Ownership = Affineˉownership.Analyze(Input, Section.Payloadˉoffset, Section.Payloadˉlength,
            Function.Parameters, Function.Localˉtypes, Function.Localˉtypeˉidentities,
            Function.Localˉborrowˉkinds, Types, Isˉmain, Instructionsˉmap);
    }
    if !Ownership.Valid {
        return Compilerˉnativeˉx64ˉfailureˉcontrolˉanalysis(Input, 13u32);
    }

    var Blockˉoffsets: bytes = Compilerˉnativeˉx64ˉempty(Input);
    var Instructionˉsizes: bytes = Compilerˉnativeˉx64ˉempty(Input);
    var Blocks: u32 = 0u32;
    Cursor = 0u32;
    while Cursor < Length {
        if Bytesˉreadˉu8(Leaders, Cursor) == 1u8 {
            if Bytesˉreadˉu8(Instructionsˉmap, Cursor) == 0u8 {
                return Compilerˉnativeˉx64ˉfailureˉcontrolˉanalysis(Input, 3u32);
            }
            Blockˉoffsets = Bytesˉconcat(
                Blockˉoffsets,
                Bytesˉfromˉu32ˉlittle(Cursor)
            );
            Blocks = Blocks + 1u32;
        }
        Cursor = Cursor + 1u32;
    }
    if Bytesˉlength(Blockˉoffsets) != Blocks * 4u32 {
        return Compilerˉnativeˉx64ˉfailureˉcontrolˉanalysis(Input, 3u32);
    }
    if Callableˉoperations > 0u32 && Blocks != 1u32 {
        return Compilerˉnativeˉx64ˉfailureˉcontrolˉanalysis(Input, 12u32);
    }

    var I32ˉslots: u32 = 0u32;
    var Boolˉslots: u32 = 0u32;
    var Textˉslots: u32 = 0u32;
    var U8ˉslots: u32 = 0u32;
    var U32ˉslots: u32 = 0u32;
    var Bytesˉslots: u32 = 0u32;
    var Enumˉslots: u32 = 0u32;
    var Recordˉslots: u32 = 0u32;
    var Maximumˉstack: u32 = 0u32;
    var Bodyˉbytes: u32 = 0u32;
    var Controlˉedges: bytes = Compilerˉnativeˉx64ˉempty(Input);
    var Blockˉindex: u32 = 0u32;
    Cursor = 0u32;
    while Cursor < Length {
        if Bytesˉreadˉu8(Leaders, Cursor) != 1u8 {
            return Compilerˉnativeˉx64ˉfailureˉcontrolˉanalysis(Input, 3u32);
        }
        var Blockˉend: u32 = Length;
        if Blockˉindex + 1u32 < Blocks {
            Blockˉend = Bytesˉreadˉu32ˉlittle(
                Blockˉoffsets,
                (Blockˉindex + 1u32) * 4u32
            );
        }
        let Block: Compilerˉnativeˉx64ˉblockˉanalysis =
            Compilerˉnativeˉx64ˉanalyzeˉblock(
                Input,
                Section,
                Function,
                Instructionsˉmap,
                Cursor,
                Blockˉend,
                Isˉmain,
                Callableˉfunctions,
                Callˉdirectory,
                Data,
                Types,
                Capabilityˉtable
            );
        if !Block.Valid {
            return Compilerˉnativeˉx64ˉfailureˉcontrolˉanalysis(
                Input,
                1000u32 + Blockˉindex
            );
        }
        if Block.I32ˉvalues > I32ˉslots { I32ˉslots = Block.I32ˉvalues; }
        if Block.Boolˉvalues > Boolˉslots { Boolˉslots = Block.Boolˉvalues; }
        if Block.Textˉvalues > Textˉslots { Textˉslots = Block.Textˉvalues; }
        if Block.U8ˉvalues > U8ˉslots { U8ˉslots = Block.U8ˉvalues; }
        if Block.U32ˉvalues > U32ˉslots { U32ˉslots = Block.U32ˉvalues; }
        if Block.Bytesˉvalues > Bytesˉslots { Bytesˉslots = Block.Bytesˉvalues; }
        if Block.Enumˉvalues > Enumˉslots { Enumˉslots = Block.Enumˉvalues; }
        if Block.Recordˉvalues > Recordˉslots {
            Recordˉslots = Block.Recordˉvalues;
        }
        if Block.Maximumˉstack > Maximumˉstack {
            Maximumˉstack = Block.Maximumˉstack;
        }
        Bodyˉbytes = Bodyˉbytes + Block.Bodyˉbytes;
        Instructionˉsizes = Bytesˉconcat(Instructionˉsizes, Block.Instructionˉsizes);
        Controlˉedges = Bytesˉconcat(
            Controlˉedges,
            Bytesˉconcat(
                Bytesˉfromˉu8(Block.Terminator),
                Bytesˉfromˉu32ˉlittle(Block.Target)
            )
        );
        Cursor = Block.Next;
        Blockˉindex = Blockˉindex + 1u32;
    }
    if Blockˉindex != Blocks ||
        Bytesˉlength(Controlˉedges) != Blocks * 5u32 {
        return Compilerˉnativeˉx64ˉfailureˉcontrolˉanalysis(Input, 4u32);
    }

    var Reachableˉblocks: bytes = Bytesˉfromˉu32ˉlittle(0u32);
    var Reachableˉmap: bytes = Compilerˉnativeˉx64ˉzeroˉmap(Input, Blocks);
    Reachableˉmap = Compilerˉnativeˉx64ˉsetˉmapˉbyte(
        Reachableˉmap,
        0u32
    );
    var Reachableˉcursor: u32 = 0u32;
    while Reachableˉcursor < Bytesˉlength(Reachableˉblocks) {
        let Reachˉblock: u32 = Bytesˉreadˉu32ˉlittle(
            Reachableˉblocks,
            Reachableˉcursor
        );
        if Reachˉblock >= Blocks {
            return Compilerˉnativeˉx64ˉfailureˉcontrolˉanalysis(Input, 5u32);
        }
        let Edgeˉoffset: u32 = Reachˉblock * 5u32;
        let Terminator: u8 = Bytesˉreadˉu8(Controlˉedges, Edgeˉoffset);
        if Terminator == 0u8 || Terminator == 2u8 {
            let Nextˉblock: u32 = Reachˉblock + 1u32;
            if Nextˉblock >= Blocks {
                return Compilerˉnativeˉx64ˉfailureˉcontrolˉanalysis(Input, 5u32);
            }
            if Bytesˉreadˉu8(Reachableˉmap, Nextˉblock) == 0u8 {
                Reachableˉmap = Compilerˉnativeˉx64ˉsetˉmapˉbyte(
                    Reachableˉmap,
                    Nextˉblock
                );
                Reachableˉblocks = Bytesˉconcat(
                    Reachableˉblocks,
                    Bytesˉfromˉu32ˉlittle(Nextˉblock)
                );
            }
        }
        if Terminator == 1u8 || Terminator == 2u8 {
            let Targetˉoffset: u32 = Bytesˉreadˉu32ˉlittle(
                Controlˉedges,
                Edgeˉoffset + 1u32
            );
            let Targetˉblock: u32 = Compilerˉnativeˉx64ˉblockˉid(
                Blockˉoffsets,
                Targetˉoffset
            );
            if Targetˉblock >= Blocks {
                return Compilerˉnativeˉx64ˉfailureˉcontrolˉanalysis(Input, 5u32);
            }
            if Bytesˉreadˉu8(Reachableˉmap, Targetˉblock) == 0u8 {
                Reachableˉmap = Compilerˉnativeˉx64ˉsetˉmapˉbyte(
                    Reachableˉmap,
                    Targetˉblock
                );
                Reachableˉblocks = Bytesˉconcat(
                    Reachableˉblocks,
                    Bytesˉfromˉu32ˉlittle(Targetˉblock)
                );
            }
        }
        if Bytesˉlength(Reachableˉblocks) / 4u32 > Blocks {
            return Compilerˉnativeˉx64ˉfailureˉcontrolˉanalysis(Input, 5u32);
        }
        Reachableˉcursor = Reachableˉcursor + 4u32;
    }
    if Bytesˉlength(Reachableˉblocks) != Blocks * 4u32 {
        return Compilerˉnativeˉx64ˉfailureˉcontrolˉanalysis(Input, 5u32);
    }
    if Maximumˉstack != Function.Maximumˉstack {
        return Compilerˉnativeˉx64ˉfailureˉcontrolˉanalysis(Input, 6u32);
    }
    var Hasˉrecords: bool = Recordˉslots > 0u32 ||
        Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉisˉrecord(
            Function.Returnˉtype
        );
    var Local: u32 = 0u32;
    while Local < Function.Locals {
        if Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉisˉrecord(
            Bytesˉreadˉu8(Function.Localˉtypes, Local)
        ) { Hasˉrecords = true; }
        Local = Local + 1u32;
    }
    var Sharedˉliveness: Sharedˉlocalˉliveness.Plan = Sharedˉlocalˉliveness.Empty(Input, Function.Locals);
    if Function.Sharedˉvalues {
        Sharedˉliveness = Sharedˉlocalˉliveness.Buildˉindexed(Input, Section.Payloadˉoffset,
            Section.Payloadˉlength, Function.Parameters, Function.Localˉtypes,
            Function.Localˉtypeˉidentities, Instructionsˉmap, Blockˉoffsets, Controlˉedges,
            Function.Borrowˉdirectory, Function.Functionˉindex);
        if !Sharedˉliveness.Valid { return Compilerˉnativeˉx64ˉfailureˉcontrolˉanalysis(Input, 14u32); }
    }
    var Storage: Recordˉstorage.Compilerˉnativeˉx64ˉrecordˉstorage =
        Recordˉstorage.Compilerˉnativeˉx64ˉemptyˉrecordˉstorage(Input);
    if Hasˉrecords {
        let Storageˉbytes: bytes =
            Recordˉstorage.Compilerˉnativeˉx64ˉrecordˉstorageˉread(
                Input,
                Section.Payloadˉoffset,
                Section.Payloadˉlength,
                Function.Parameters,
                Function.Returnˉtype,
                Function.Localˉtypes,
                Callˉdirectory,
                Capabilityˉtable.Kinds,
                Types,
                Blocks,
                Leaders,
                Sharedˉliveness
            );
        Storage = Recordˉstorage.Compilerˉnativeˉx64ˉrecordˉstorageˉdecode(
            Storageˉbytes
        );
        if !Storage.Valid {
            return Compilerˉnativeˉx64ˉfailureˉcontrolˉanalysis(Input, 7u32);
        }
        if Storage.Recordˉvalues != Recordˉslots {
            return Compilerˉnativeˉx64ˉfailureˉcontrolˉanalysis(Input, 8u32);
        }
        if Bytesˉlength(Storage.Scratchˉblockˉoffsets) != Blocks * 4u32 {
            return Compilerˉnativeˉx64ˉfailureˉcontrolˉanalysis(Input, 9u32);
        }
        let Scratchˉvalues: u32 = Bytesˉlength(Storage.Scratchˉoffsets) / 4u32;
        var Scratchˉblock: u32 = 0u32;
        var Previousˉscratchˉbase: u32 = 0u32;
        while Scratchˉblock < Blocks {
            let Scratchˉbase: u32 = Bytesˉreadˉu32ˉlittle(
                Storage.Scratchˉblockˉoffsets,
                Scratchˉblock * 4u32
            );
            if Scratchˉbase > Scratchˉvalues ||
                Scratchˉbase < Previousˉscratchˉbase ||
                Scratchˉblock == 0u32 && Scratchˉbase != 0u32 {
                return Compilerˉnativeˉx64ˉfailureˉcontrolˉanalysis(Input, 10u32);
            }
            Previousˉscratchˉbase = Scratchˉbase;
            Scratchˉblock = Scratchˉblock + 1u32;
        }
    }
    if Function.Sharedˉvalues {
        var Measured: bytes = Compilerˉnativeˉx64ˉempty(Input);
        var Chunk: bytes = Compilerˉnativeˉx64ˉempty(Input);
        var Instruction: u32 = 0u32;
        while Instruction < Instructionˉcount {
            let Relative: u32 = Sharedˉlocalˉliveness.Rowˉoffset(Sharedˉliveness, Instruction);
            let Row: u32 = Instruction * 16u32;
            if Relative == 4294967295u32 || Bytesˉreadˉu32ˉlittle(Instructionˉsizes, Row) != Relative {
                return Compilerˉnativeˉx64ˉfailureˉcontrolˉanalysis(Input, 14u32);
            }
            let Measuredˉcleanupˉopcode: u8 = Bytesˉreadˉu8(Input, Section.Payloadˉoffset + Relative);
            var Cleanup: u32 = Compilerˉnativeˉx64ˉsharedˉcleanupˉbytes(Input, Function, Types,
                Sharedˉliveness, Instruction, Section.Payloadˉoffset + Relative, Measuredˉcleanupˉopcode,
                4294967295u32);
            if Measuredˉcleanupˉopcode == 49u8 {
                let Branchˉnextˉrow: u32 = Sharedˉlocalˉliveness.Rowˉindex(Sharedˉliveness, Relative + 5u32);
                let Branchˉtargetˉrow: u32 = Sharedˉlocalˉliveness.Rowˉindex(Sharedˉliveness,
                    Bytesˉreadˉu32ˉlittle(Input, Section.Payloadˉoffset + Relative + 1u32));
                if Branchˉnextˉrow == 4294967295u32 || Branchˉtargetˉrow == 4294967295u32 {
                    return Compilerˉnativeˉx64ˉfailureˉcontrolˉanalysis(Input, 14u32);
                }
                let Branchˉnextˉcleanup: u32 = Compilerˉnativeˉx64ˉsharedˉcleanupˉbytes(Input, Function, Types,
                    Sharedˉliveness, Instruction, 0u32, 49u8, Branchˉnextˉrow);
                let Branchˉtargetˉcleanup: u32 = Compilerˉnativeˉx64ˉsharedˉcleanupˉbytes(Input, Function, Types,
                    Sharedˉliveness, Instruction, 0u32, 49u8, Branchˉtargetˉrow);
                if Cleanup > 67108864u32 || Branchˉnextˉcleanup > 67108859u32 || Branchˉtargetˉcleanup > 67108859u32 {
                    return Compilerˉnativeˉx64ˉfailureˉcontrolˉanalysis(Input, 16u32);
                }
                if Branchˉnextˉcleanup != 0u32 { Cleanup = Cleanup + Branchˉnextˉcleanup + 5u32; }
                if Branchˉtargetˉcleanup != 0u32 { Cleanup = Cleanup + Branchˉtargetˉcleanup + 5u32; }
            }
            if Cleanup == 4294967295u32 || Bodyˉbytes > 67108864u32 || Cleanup > 67108864u32 - Bodyˉbytes {
                return Compilerˉnativeˉx64ˉfailureˉcontrolˉanalysis(Input, 16u32);
            }
            Bodyˉbytes = Bodyˉbytes + Cleanup;
            Chunk = Bytesˉconcat(Chunk, Bytesˉconcat(Bytesˉfromˉu32ˉlittle(Relative),
                Bytesˉconcat(Bytesˉfromˉu32ˉlittle(Bytesˉreadˉu32ˉlittle(Instructionˉsizes, Row + 4u32) + Cleanup),
                    Bytesˉslice(Instructionˉsizes, Row + 8u32, 8u32))));
            if Bytesˉlength(Chunk) >= 4096u32 {
                Measured = Bytesˉconcat(Measured, Chunk);
                Chunk = Compilerˉnativeˉx64ˉempty(Input);
            }
            Instruction = Instruction + 1u32;
        }
        Instructionˉsizes = Bytesˉconcat(Measured, Chunk);
        let Returnˉtail: u32 = Compilerˉnativeˉx64ˉsharedˉreturnˉtailˉbytes(Input, Function, Types, Isˉmain);
        if Returnˉtail == 4294967295u32 || Bodyˉbytes > 67108864u32 || Returnˉtail > 67108864u32 - Bodyˉbytes {
            return Compilerˉnativeˉx64ˉfailureˉcontrolˉanalysis(Input, 16u32);
        }
        Bodyˉbytes = Bodyˉbytes + Returnˉtail;
    }
    let Frameˉslots: u32 = Function.Locals + I32ˉslots + Boolˉslots + Textˉslots + U8ˉslots +
        U32ˉslots + Bytesˉslots + Enumˉslots + Recordˉslots +
        Storage.Persistentˉfields + Storage.Scratchˉfields +
        Compilerˉnativeˉx64ˉhiddenˉresultˉslots(Function.Returnˉtype) +
        Callableˉenvironmentˉslots + Callableˉcaptureˉslots +
        Unsafeˉbackingˉslots;
    if Frameˉslots + Ownedˉframes.Slots(Ownership.Ownedˉlocals) > 4096u32 {
        return Compilerˉnativeˉx64ˉfailureˉcontrolˉanalysis(Input, 11u32);
    }
    if Function.Sharedˉvalues {
        var Saved: u32 = 8u32;
        if Isˉmain { Saved = 16u32; }
        let Completeˉslots: u32 = Frameˉslots + Sharedˉbytes.Requestˉslots() + 1u32;
        if Completeˉslots > 4096u32 || Outgoingˉbytes + Saved > 65536u32 - Completeˉslots * 16u32 {
            return Compilerˉnativeˉx64ˉfailureˉcontrolˉanalysis(Input, 11u32);
        }
    }
    var Reclamation: bytes = Compilerˉnativeˉx64ˉempty(Input);
    if !Function.Sharedˉvalues {
        Reclamation = Liveˉstorage.Compilerˉnativeˉx64ˉliveˉstorageˉplan(
        Input, Section.Payloadˉoffset, Instructionsˉmap, Blockˉoffsets,
        Controlˉedges, Function.Localˉtypes, Types, Frameˉslots * 16u32
        );
    }
    Bodyˉbytes = Bodyˉbytes + Liveˉstorage.Compilerˉnativeˉx64ˉliveˉstorageˉbytes(Reclamation, Blocks);
    if Bytesˉlength(Ownership.Ownedˉlocals) > 0u32 {
        Cursor = 0u32;
        while Cursor < Length {
            let Cleanupˉopcode: u8 = Bytesˉreadˉu8(Input, Section.Payloadˉoffset + Cursor);
            Bodyˉbytes = Bodyˉbytes + Ownedˉframes.Hookˉbytes(
                Input, Section.Payloadˉoffset + Cursor, Cleanupˉopcode, Ownership.Ownedˉlocals);
            Cursor = Cursor + Compilerˉnativeˉx64ˉinstructionˉsize(Cleanupˉopcode);
        }
    }
    return Compilerˉnativeˉx64ˉcontrolˉanalysis(
        true,
        I32ˉslots,
        Boolˉslots,
        Textˉslots,
        U8ˉslots,
        U32ˉslots,
        Bytesˉslots,
        Enumˉslots,
        Recordˉslots,
        Callableˉoperations,
        Callableˉenvironmentˉslots,
        Callableˉcaptureˉslots,
        Unsafeˉbackingˉslots,
        Blocks,
        Instructionˉcount,
        Bodyˉbytes,
        Hasˉdivision,
        Hasˉshift,
        Maximumˉstack,
        Leaders,
        Blockˉoffsets,
        Storage.Persistentˉoffsets,
        Storage.Scratchˉoffsets,
        Storage.Scratchˉblockˉoffsets,
        Storage.Persistentˉfields,
        Storage.Scratchˉfields,
        Reclamation,
        Ownership.Ownedˉlocals,
        Instructionˉsizes,
        Sharedˉliveness
    );
}

export fn Compilerˉnativeˉx64ˉappendˉi32(Result: bytes, Value: i32) -> bytes {
    return Bytesˉconcat(Result, Bytesˉfromˉi32ˉlittle(Value));
}

export fn Compilerˉnativeˉx64ˉappendˉbyte(Result: bytes, Value: u8) -> bytes {
    return Bytesˉconcat(Result, Bytesˉfromˉu8(Value));
}

export fn Compilerˉnativeˉx64ˉappendˉu32(Result: bytes, Value: u32) -> bytes {
    return Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Value));
}

export fn Compilerˉnativeˉx64ˉemitˉframe(
    Result: bytes,
    Subtract: bool,
    Frameˉbytes: u32
) -> bytes {
    var Prefix: bytes = Bytesˉfromˉu16ˉlittle(33096u32);
    if Subtract {
        Prefix = Bytesˉconcat(Prefix, Bytesˉfromˉu8(236u8));
    } else {
        Prefix = Bytesˉconcat(Prefix, Bytesˉfromˉu8(196u8));
    }
    return Bytesˉconcat(
        Result,
        Bytesˉconcat(Prefix, Bytesˉfromˉu32ˉlittle(Frameˉbytes))
    );
}

export fn Compilerˉnativeˉx64ˉemitˉloadˉeax(
    Result: bytes,
    Offset: u32
) -> bytes {
    let Prefix: bytes = Bytesˉconcat(
        Bytesˉfromˉu16ˉlittle(33931u32),
        Bytesˉfromˉu8(36u8)
    );
    return Bytesˉconcat(
        Result,
        Bytesˉconcat(Prefix, Bytesˉfromˉu32ˉlittle(Offset))
    );
}

export fn Compilerˉnativeˉx64ˉemitˉloadˉecx(
    Result: bytes,
    Offset: u32
) -> bytes {
    let Prefix: bytes = Bytesˉconcat(
        Bytesˉfromˉu16ˉlittle(35979u32),
        Bytesˉfromˉu8(36u8)
    );
    return Bytesˉconcat(
        Result,
        Bytesˉconcat(Prefix, Bytesˉfromˉu32ˉlittle(Offset))
    );
}

export fn Compilerˉnativeˉx64ˉemitˉloadˉrax(
    Result: bytes,
    Offset: u32
) -> bytes {
    var Output: bytes = Compilerˉnativeˉx64ˉappendˉbyte(Result, 72u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 139u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 132u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 36u8);
    return Compilerˉnativeˉx64ˉappendˉu32(Output, Offset);
}

export fn Compilerˉnativeˉx64ˉemitˉloadˉrcx(
    Result: bytes,
    Offset: u32
) -> bytes {
    var Output: bytes = Compilerˉnativeˉx64ˉappendˉbyte(Result, 72u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 139u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 140u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 36u8);
    return Compilerˉnativeˉx64ˉappendˉu32(Output, Offset);
}

fn Compilerˉnativeˉx64ˉemitˉloadˉrdx(Result: bytes, Offset: u32) -> bytes {
    return Compilerˉnativeˉx64ˉappendˉu32(Bytesˉconcat(Result,
        Bytesˉfromˉu32ˉlittle(613714760u32)), Offset);
}

export fn Compilerˉnativeˉx64ˉemitˉstoreˉeax(
    Result: bytes,
    Offset: u32
) -> bytes {
    let Prefix: bytes = Bytesˉconcat(
        Bytesˉfromˉu16ˉlittle(33929u32),
        Bytesˉfromˉu8(36u8)
    );
    return Bytesˉconcat(
        Result,
        Bytesˉconcat(Prefix, Bytesˉfromˉu32ˉlittle(Offset))
    );
}

export fn Compilerˉnativeˉx64ˉemitˉstoreˉrax(
    Result: bytes,
    Offset: u32
) -> bytes {
    var Output: bytes = Compilerˉnativeˉx64ˉappendˉbyte(Result, 72u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 137u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 132u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 36u8);
    return Compilerˉnativeˉx64ˉappendˉu32(Output, Offset);
}

export fn Compilerˉnativeˉx64ˉemitˉrestore(Result: bytes) -> bytes {
    return Bytesˉconcat(
        Result,
        Bytesˉconcat(
            Bytesˉfromˉu32ˉlittle(1103298377u32),
            Bytesˉfromˉu16ˉlittle(50015u32)
        )
    );
}

export fn Compilerˉnativeˉx64ˉemitˉrestoreˉfor(
    Result: bytes,
    Restoreˉcontext: bool
) -> bytes {
    var Suffix: bytes = Bytesˉconcat(
        Bytesˉfromˉu16ˉlittle(65353u32),
        Bytesˉfromˉu8(194u8)
    );
    if Restoreˉcontext {
        Suffix = Bytesˉconcat(Suffix, Bytesˉfromˉu16ˉlittle(24385u32));
    }
    return Bytesˉconcat(Result, Bytesˉconcat(Suffix, Bytesˉfromˉu8(195u8)));
}

export fn Compilerˉnativeˉx64ˉemitˉcharge(
    Result: bytes,
    Target: u32
) -> bytes {
    let Suffix: bytes = Bytesˉconcat(
        Bytesˉfromˉu32ˉlittle(32211785u32),
        Bytesˉconcat(
            Bytesˉfromˉu16ˉlittle(33295u32),
            Bytesˉfromˉu32ˉlittle(Target - Bytesˉlength(Result) - 10u32)
        )
    );
    return Bytesˉconcat(Result, Suffix);
}

export fn Compilerˉnativeˉx64ˉemitˉoverflowˉbranch(
    Result: bytes,
    Target: u32
) -> bytes {
    return Bytesˉconcat(
        Result,
        Bytesˉconcat(
            Bytesˉfromˉu16ˉlittle(32783u32),
            Bytesˉfromˉu32ˉlittle(Target - Bytesˉlength(Result) - 6u32)
        )
    );
}

export fn Compilerˉnativeˉx64ˉemitˉunsignedˉoverflowˉbranch(
    Result: bytes,
    Target: u32
) -> bytes {
    return Bytesˉconcat(
        Result,
        Bytesˉconcat(
            Bytesˉfromˉu16ˉlittle(33295u32),
            Bytesˉfromˉu32ˉlittle(Target - Bytesˉlength(Result) - 6u32)
        )
    );
}

export fn Compilerˉnativeˉx64ˉemitˉnonzeroˉbranch(
    Result: bytes,
    Target: u32
) -> bytes {
    return Bytesˉconcat(
        Result,
        Bytesˉconcat(
            Bytesˉfromˉu16ˉlittle(34063u32),
            Bytesˉfromˉu32ˉlittle(Target - Bytesˉlength(Result) - 6u32)
        )
    );
}

export fn Compilerˉnativeˉx64ˉemitˉstatus(
    Result: bytes,
    Frameˉbytes: u32,
    Statusˉhigh: u32
) -> bytes {
    var Output: bytes = Compilerˉnativeˉx64ˉemitˉframe(
        Result,
        false,
        Frameˉbytes
    );
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 73u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 255u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 194u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 72u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 184u8);
    Output = Compilerˉnativeˉx64ˉappendˉu32(Output, 0u32);
    Output = Compilerˉnativeˉx64ˉappendˉu32(Output, Statusˉhigh);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 65u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 95u8);
    return Compilerˉnativeˉx64ˉappendˉbyte(Output, 195u8);
}

export fn Compilerˉnativeˉx64ˉemitˉstatusˉfor(
    Result: bytes,
    Frameˉbytes: u32,
    Statusˉhigh: u32,
    Restoreˉcontext: bool
) -> bytes {
    var Output: bytes = Compilerˉnativeˉx64ˉemitˉframe(
        Result,
        false,
        Frameˉbytes
    );
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 73u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 255u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 194u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 72u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 184u8);
    Output = Compilerˉnativeˉx64ˉappendˉu32(Output, 0u32);
    Output = Compilerˉnativeˉx64ˉappendˉu32(Output, Statusˉhigh);
    if Restoreˉcontext {
        Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 65u8);
        Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 95u8);
    }
    return Compilerˉnativeˉx64ˉappendˉbyte(Output, 195u8);
}

export fn Compilerˉnativeˉx64ˉemitˉwideˉstatusˉfor(
    Result: bytes,
    Frameˉbytes: u32,
    Status: u32,
    Restoreˉcontext: bool
) -> bytes {
    var Output: bytes = Compilerˉnativeˉx64ˉemitˉframe(
        Result,
        false,
        Frameˉbytes
    );
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 73u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 255u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 194u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 186u8);
    Output = Compilerˉnativeˉx64ˉappendˉu32(Output, Status);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 72u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 137u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 208u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 72u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 193u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 224u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 32u8);
    if Restoreˉcontext {
        Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 65u8);
        Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 95u8);
    }
    return Compilerˉnativeˉx64ˉappendˉbyte(Output, 195u8);
}

// Frame spans are multiples of one 16-byte ABI cell. Small spans avoid
// REP setup; larger spans preserve RCX/RDI and use 16 transient stack bytes.
fn Compilerˉnativeˉx64ˉzeroˉrangeˉbytes(Length: u32) -> u32 {
    if Length <= 16u32 { return Length / 4u32 * 7u32; }
    return 20u32;
}

fn Compilerˉnativeˉx64ˉemitˉzeroˉrange(
    Result: bytes,
    Offset: u32,
    Length: u32
) -> bytes {
    var Output: bytes = Result;
    if Length <= 16u32 {
        var Cursor: u32 = 0u32;
        while Cursor < Length {
            Output = Compilerˉnativeˉx64ˉemitˉstoreˉeax(
                Output, Offset + Cursor
            );
            Cursor = Cursor + 4u32;
        }
        return Output;
    }
    // EAX is zero. PUSH RDI; PUSH RCX; LEA RDI,[RSP+Offset+16];
    // MOV ECX,Length/4; CLD; REP STOSD; POP RCX; POP RDI.
    Output = Bytesˉconcat(Output, Bytesˉfromˉu32ˉlittle(2370326871u32));
    Output = Bytesˉconcat(Output, Bytesˉfromˉu16ˉlittle(9404u32));
    Output = Bytesˉconcat(Output, Bytesˉfromˉu32ˉlittle(Offset + 16u32));
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 185u8);
    Output = Bytesˉconcat(Output, Bytesˉfromˉu32ˉlittle(Length / 4u32));
    Output = Bytesˉconcat(Output, Bytesˉfromˉu32ˉlittle(1504441340u32));
    return Compilerˉnativeˉx64ˉappendˉbyte(Output, 95u8);
}

export fn Compilerˉnativeˉx64ˉemitˉcode(
    Input: bytes,
    Section: Compilerˉnativeˉx64ˉsection,
    Function: Compilerˉnativeˉx64ˉfunction,
    Analysis: Compilerˉnativeˉx64ˉanalysis
) -> bytes {
    let Slots: u32 = Function.Locals + Analysis.Values;
    let Frameˉbytes: u32 = Slots * 16u32;
    let Prologueˉbytes: u32 = 32u32 +
        Compilerˉnativeˉx64ˉzeroˉrangeˉbytes(Frameˉbytes);
    let Propagateˉoffset: u32 = Prologueˉbytes + Analysis.Bodyˉbytes;
    let Overflowˉoffset: u32 = Propagateˉoffset + 13u32;
    let Instructionˉlimitˉoffset: u32 = Overflowˉoffset + 23u32;
    let Depthˉoffset: u32 = Overflowˉoffset + 161u32;
    var Result: bytes = Compilerˉnativeˉx64ˉempty(Input);

    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 65u8);
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 87u8);
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 73u8);
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 137u8);
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 215u8);
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 77u8);
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 139u8);
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 95u8);
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 8u8);
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 77u8);
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 139u8);
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 87u8);
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 16u8);
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 73u8);
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 131u8);
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 234u8);
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 1u8);
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 15u8);
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 130u8);
    Result = Compilerˉnativeˉx64ˉappendˉu32(
        Result,
        Depthˉoffset - Bytesˉlength(Result) - 4u32
    );
    Result = Compilerˉnativeˉx64ˉemitˉframe(Result, true, Frameˉbytes);
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 49u8);
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 192u8);
    Result = Compilerˉnativeˉx64ˉemitˉzeroˉrange(
        Result, 0u32, Frameˉbytes
    );

    var Stack: bytes = Compilerˉnativeˉx64ˉempty(Input);
    var Stackˉdepth: u32 = 0u32;
    var Nextˉvalue: u32 = 0u32;
    var Cursor: u32 = 0u32;
    while Cursor < Section.Payloadˉlength {
        let Opcode: u8 = Bytesˉreadˉu8(Input, Section.Payloadˉoffset + Cursor);
        Result = Compilerˉnativeˉx64ˉemitˉcharge(
            Result,
            Instructionˉlimitˉoffset
        );
        if Opcode == 1u8 {
            Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 184u8);
            Result = Compilerˉnativeˉx64ˉappendˉi32(
                Result,
                Bytesˉreadˉi32ˉlittle(Input, Section.Payloadˉoffset + Cursor + 1u32)
            );
            Result = Compilerˉnativeˉx64ˉemitˉstoreˉeax(
                Result,
                (Function.Locals + Nextˉvalue) * 16u32
            );
            Stack = Bytesˉconcat(Stack, Bytesˉfromˉu32ˉlittle(Nextˉvalue));
            Stackˉdepth = Stackˉdepth + 1u32;
            Nextˉvalue = Nextˉvalue + 1u32;
            Cursor = Cursor + 5u32;
        } else {
            if Opcode == 4u8 || Opcode == 205u8 {
                let Loadˉlocal: u32 = Bytesˉreadˉu32ˉlittle(
                    Input,
                    Section.Payloadˉoffset + Cursor + 1u32
                );
                Result = Compilerˉnativeˉx64ˉemitˉloadˉeax(
                    Result,
                    Loadˉlocal * 16u32
                );
                Result = Compilerˉnativeˉx64ˉemitˉstoreˉeax(
                    Result,
                    (Function.Locals + Nextˉvalue) * 16u32
                );
                Stack = Bytesˉconcat(Stack, Bytesˉfromˉu32ˉlittle(Nextˉvalue));
                Stackˉdepth = Stackˉdepth + 1u32;
                Nextˉvalue = Nextˉvalue + 1u32;
                Cursor = Cursor + 5u32;
            } else {
                if Opcode == 5u8 {
                    let Storeˉlocal: u32 = Bytesˉreadˉu32ˉlittle(
                        Input,
                        Section.Payloadˉoffset + Cursor + 1u32
                    );
                    let Storeˉvalue: u32 = Bytesˉreadˉu32ˉlittle(
                        Stack,
                        (Stackˉdepth - 1u32) * 4u32
                    );
                    Stackˉdepth = Stackˉdepth - 1u32;
                    Stack = Bytesˉslice(Stack, 0u32, Stackˉdepth * 4u32);
                    Result = Compilerˉnativeˉx64ˉemitˉloadˉeax(
                        Result,
                        (Function.Locals + Storeˉvalue) * 16u32
                    );
                    Result = Compilerˉnativeˉx64ˉemitˉstoreˉeax(
                        Result,
                        Storeˉlocal * 16u32
                    );
                    Cursor = Cursor + 5u32;
                } else {
                    if Opcode == 16u8 {
                        let Addˉright: u32 = Bytesˉreadˉu32ˉlittle(
                            Stack,
                            (Stackˉdepth - 1u32) * 4u32
                        );
                        let Addˉleft: u32 = Bytesˉreadˉu32ˉlittle(
                            Stack,
                            (Stackˉdepth - 2u32) * 4u32
                        );
                        Stackˉdepth = Stackˉdepth - 2u32;
                        Stack = Bytesˉslice(Stack, 0u32, Stackˉdepth * 4u32);
                        Result = Compilerˉnativeˉx64ˉemitˉloadˉeax(
                            Result,
                            (Function.Locals + Addˉleft) * 16u32
                        );
                        Result = Compilerˉnativeˉx64ˉemitˉloadˉecx(
                            Result,
                            (Function.Locals + Addˉright) * 16u32
                        );
                        Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 1u8);
                        Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 200u8);
                        Result = Compilerˉnativeˉx64ˉemitˉoverflowˉbranch(
                            Result,
                            Overflowˉoffset
                        );
                        Result = Compilerˉnativeˉx64ˉemitˉstoreˉeax(
                            Result,
                            (Function.Locals + Nextˉvalue) * 16u32
                        );
                        Stack = Bytesˉconcat(
                            Stack,
                            Bytesˉfromˉu32ˉlittle(Nextˉvalue)
                        );
                        Stackˉdepth = Stackˉdepth + 1u32;
                        Nextˉvalue = Nextˉvalue + 1u32;
                        Cursor = Cursor + 1u32;
                    } else {
                        if Opcode == 17u8 {
                            let Subtractˉright: u32 = Bytesˉreadˉu32ˉlittle(
                                Stack,
                                (Stackˉdepth - 1u32) * 4u32
                            );
                            let Subtractˉleft: u32 = Bytesˉreadˉu32ˉlittle(
                                Stack,
                                (Stackˉdepth - 2u32) * 4u32
                            );
                            Stackˉdepth = Stackˉdepth - 2u32;
                            Stack = Bytesˉslice(Stack, 0u32, Stackˉdepth * 4u32);
                            Result = Compilerˉnativeˉx64ˉemitˉloadˉeax(
                                Result,
                                (Function.Locals + Subtractˉleft) * 16u32
                            );
                            Result = Compilerˉnativeˉx64ˉemitˉloadˉecx(
                                Result,
                                (Function.Locals + Subtractˉright) * 16u32
                            );
                            Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 41u8);
                            Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 200u8);
                            Result = Compilerˉnativeˉx64ˉemitˉoverflowˉbranch(
                                Result,
                                Overflowˉoffset
                            );
                            Result = Compilerˉnativeˉx64ˉemitˉstoreˉeax(
                                Result,
                                (Function.Locals + Nextˉvalue) * 16u32
                            );
                            Stack = Bytesˉconcat(
                                Stack,
                                Bytesˉfromˉu32ˉlittle(Nextˉvalue)
                            );
                            Stackˉdepth = Stackˉdepth + 1u32;
                            Nextˉvalue = Nextˉvalue + 1u32;
                            Cursor = Cursor + 1u32;
                        } else {
                            if Opcode == 18u8 {
                                let Multiplyˉright: u32 = Bytesˉreadˉu32ˉlittle(
                                    Stack,
                                    (Stackˉdepth - 1u32) * 4u32
                                );
                                let Multiplyˉleft: u32 = Bytesˉreadˉu32ˉlittle(
                                    Stack,
                                    (Stackˉdepth - 2u32) * 4u32
                                );
                                Stackˉdepth = Stackˉdepth - 2u32;
                                Stack = Bytesˉslice(Stack, 0u32, Stackˉdepth * 4u32);
                                Result = Compilerˉnativeˉx64ˉemitˉloadˉeax(
                                    Result,
                                    (Function.Locals + Multiplyˉleft) * 16u32
                                );
                                Result = Compilerˉnativeˉx64ˉemitˉloadˉecx(
                                    Result,
                                    (Function.Locals + Multiplyˉright) * 16u32
                                );
                                Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 15u8);
                                Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 175u8);
                                Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 193u8);
                                Result = Compilerˉnativeˉx64ˉemitˉoverflowˉbranch(
                                    Result,
                                    Overflowˉoffset
                                );
                                Result = Compilerˉnativeˉx64ˉemitˉstoreˉeax(
                                    Result,
                                    (Function.Locals + Nextˉvalue) * 16u32
                                );
                                Stack = Bytesˉconcat(
                                    Stack,
                                    Bytesˉfromˉu32ˉlittle(Nextˉvalue)
                                );
                                Stackˉdepth = Stackˉdepth + 1u32;
                                Nextˉvalue = Nextˉvalue + 1u32;
                                Cursor = Cursor + 1u32;
                            } else {
                                if Opcode == 19u8 {
                                    let Negateˉvalue: u32 = Bytesˉreadˉu32ˉlittle(
                                        Stack,
                                        (Stackˉdepth - 1u32) * 4u32
                                    );
                                    Stackˉdepth = Stackˉdepth - 1u32;
                                    Stack = Bytesˉslice(
                                        Stack,
                                        0u32,
                                        Stackˉdepth * 4u32
                                    );
                                    Result = Compilerˉnativeˉx64ˉemitˉloadˉeax(
                                        Result,
                                        (Function.Locals + Negateˉvalue) * 16u32
                                    );
                                    Result = Compilerˉnativeˉx64ˉappendˉbyte(
                                        Result,
                                        247u8
                                    );
                                    Result = Compilerˉnativeˉx64ˉappendˉbyte(
                                        Result,
                                        216u8
                                    );
                                    Result = Compilerˉnativeˉx64ˉemitˉoverflowˉbranch(
                                        Result,
                                        Overflowˉoffset
                                    );
                                    Result = Compilerˉnativeˉx64ˉemitˉstoreˉeax(
                                        Result,
                                        (Function.Locals + Nextˉvalue) * 16u32
                                    );
                                    Stack = Bytesˉconcat(
                                        Stack,
                                        Bytesˉfromˉu32ˉlittle(Nextˉvalue)
                                    );
                                    Stackˉdepth = Stackˉdepth + 1u32;
                                    Nextˉvalue = Nextˉvalue + 1u32;
                                    Cursor = Cursor + 1u32;
                                } else {
                                    let Returnˉvalue: u32 = Bytesˉreadˉu32ˉlittle(
                                        Stack,
                                        (Stackˉdepth - 1u32) * 4u32
                                    );
                                    Stackˉdepth = Stackˉdepth - 1u32;
                                    Stack = Bytesˉslice(
                                        Stack,
                                        0u32,
                                        Stackˉdepth * 4u32
                                    );
                                    Result = Compilerˉnativeˉx64ˉemitˉloadˉeax(
                                        Result,
                                        (Function.Locals + Returnˉvalue) * 16u32
                                    );
                                    Result = Compilerˉnativeˉx64ˉemitˉframe(
                                        Result,
                                        false,
                                        Frameˉbytes
                                    );
                                    Result = Compilerˉnativeˉx64ˉemitˉrestore(Result);
                                    Cursor = Cursor + 1u32;
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    Result = Compilerˉnativeˉx64ˉemitˉframe(Result, false, Frameˉbytes);
    Result = Compilerˉnativeˉx64ˉemitˉrestore(Result);
    Result = Compilerˉnativeˉx64ˉemitˉstatus(Result, Frameˉbytes, 1u32);
    Result = Compilerˉnativeˉx64ˉemitˉstatus(Result, Frameˉbytes, 2u32);
    Result = Compilerˉnativeˉx64ˉemitˉstatus(Result, Frameˉbytes, 4u32);
    Result = Compilerˉnativeˉx64ˉemitˉstatus(Result, Frameˉbytes, 6u32);
    Result = Compilerˉnativeˉx64ˉemitˉstatus(Result, Frameˉbytes, 5u32);
    Result = Compilerˉnativeˉx64ˉemitˉstatus(Result, Frameˉbytes, 8u32);
    Result = Compilerˉnativeˉx64ˉemitˉstatus(Result, Frameˉbytes, 7u32);
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 73u8);
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 255u8);
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 194u8);
    if Function.Returnˉtype == 8u8 || Function.Returnˉtype == 9u8 || Function.Returnˉtype == 10u8 {
        Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 186u8);
        Result = Compilerˉnativeˉx64ˉappendˉu32(Result, 3u32);
        Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 72u8);
        Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 137u8);
        Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 208u8);
        Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 72u8);
        Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 193u8);
        Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 224u8);
        Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 32u8);
    } else {
        Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 72u8);
        Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 184u8);
        Result = Compilerˉnativeˉx64ˉappendˉu32(Result, 0u32);
        Result = Compilerˉnativeˉx64ˉappendˉu32(Result, 3u32);
    }
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 65u8);
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 95u8);
    return Compilerˉnativeˉx64ˉappendˉbyte(Result, 195u8);
}

export fn Compilerˉnativeˉx64ˉemittedˉbytes(
    Input: bytes,
    Offset: u32,
    Opcode: u8,
    Isˉmain: bool,
    Callˉparameters: u32,
    Callˉtarget: u32,
    Callˉdirectory: bytes,
    Localˉtype: u8,
    Localˉidentity: u32,
    Functionˉreturnˉtype: u8,
