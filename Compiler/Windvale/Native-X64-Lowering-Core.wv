export fn Compilerˉnativeˉx64ˉrangeˉisˉvalid(
    Total: u32,
    Offset: u32,
    Length: u32
) -> bool {
    if Offset > Total { return false; }
    return Length <= Total - Offset;
}

export fn Compilerˉnativeˉx64ˉidentifierˉisˉvalid(
    Input: bytes,
    Offset: u32,
    Length: u32
) -> bool {
    let Total: u32 = Bytesˉlength(Input);
    if Length == 0u32 { return false; }
    if Length > 255u32 { return false; }
    if !Compilerˉnativeˉx64ˉrangeˉisˉvalid(Total, Offset, Length) {
        return false;
    }
    let End: u32 = Offset + Length;
    var Cursor: u32 = Offset;
    var Wordˉstart: bool = true;
    while Cursor < End {
        let Current: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(Input, Cursor));
        var Valid: bool = false;
        if Current >= 65u32 {
            if Current <= 90u32 { Valid = true; }
        }
        if Current >= 97u32 {
            if Current <= 122u32 { Valid = true; }
        }
        if Current == 95u32 { Valid = true; }
        if !Wordˉstart {
            if Current >= 48u32 {
                if Current <= 57u32 { Valid = true; }
            }
        }
        if Valid {
            Wordˉstart = false;
            Cursor = Cursor + 1u32;
        } else {
            if Wordˉstart { return false; }
            if Current != 203u32 { return false; }
            if Cursor + 1u32 >= End { return false; }
            if Bytesˉreadˉu8(Input, Cursor + 1u32) != 137u8 { return false; }
            Wordˉstart = true;
            Cursor = Cursor + 2u32;
        }
    }
    return !Wordˉstart;
}

export fn Compilerˉnativeˉx64ˉreadˉsection(
    Input: bytes,
    Cursor: u32,
    Kind: u8
) -> Compilerˉnativeˉx64ˉsection {
    let Total: u32 = Bytesˉlength(Input);
    if !Compilerˉnativeˉx64ˉrangeˉisˉvalid(Total, Cursor, 8u32) {
        return Compilerˉnativeˉx64ˉsection(false, 0u32, 0u32, 0u32);
    }
    if Bytesˉreadˉu8(Input, Cursor) != Kind {
        return Compilerˉnativeˉx64ˉsection(false, 0u32, 0u32, 0u32);
    }
    if Bytesˉreadˉu8(Input, Cursor + 1u32) != 0u8 {
        return Compilerˉnativeˉx64ˉsection(false, 0u32, 0u32, 0u32);
    }
    if Bytesˉreadˉu16ˉlittle(Input, Cursor + 2u32) != 0u32 {
        return Compilerˉnativeˉx64ˉsection(false, 0u32, 0u32, 0u32);
    }
    let Payloadˉlength: u32 = Bytesˉreadˉu32ˉlittle(Input, Cursor + 4u32);
    let Payloadˉoffset: u32 = Cursor + 8u32;
    if !Compilerˉnativeˉx64ˉrangeˉisˉvalid(
        Total,
        Payloadˉoffset,
        Payloadˉlength
    ) {
        return Compilerˉnativeˉx64ˉsection(false, 0u32, 0u32, 0u32);
    }
    return Compilerˉnativeˉx64ˉsection(
        true,
        Payloadˉoffset,
        Payloadˉlength,
        Payloadˉoffset + Payloadˉlength
    );
}

export fn Compilerˉnativeˉx64ˉinvalidˉstructure()
    -> Compilerˉnativeˉx64ˉstructure {
    return Compilerˉnativeˉx64ˉstructure(
        false,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32
    );
}

export fn Compilerˉnativeˉx64ˉreadˉstructure(Input: bytes)
    -> Compilerˉnativeˉx64ˉstructure {
    let Total: u32 = Bytesˉlength(Input);
    if Total < 12u32 { return Compilerˉnativeˉx64ˉinvalidˉstructure(); }
    if Bytesˉreadˉu8(Input, 0u32) != 87u8 {
        return Compilerˉnativeˉx64ˉinvalidˉstructure();
    }
    if Bytesˉreadˉu8(Input, 1u32) != 86u8 {
        return Compilerˉnativeˉx64ˉinvalidˉstructure();
    }
    if Bytesˉreadˉu8(Input, 2u32) != 66u8 {
        return Compilerˉnativeˉx64ˉinvalidˉstructure();
    }
    if Bytesˉreadˉu8(Input, 3u32) != 49u8 {
        return Compilerˉnativeˉx64ˉinvalidˉstructure();
    }
    if Bytesˉreadˉu16ˉlittle(Input, 4u32) != 1u32 {
        return Compilerˉnativeˉx64ˉinvalidˉstructure();
    }
    let Minor: u32 = Bytesˉreadˉu16ˉlittle(Input, 6u32);
    if Minor != 11u32 && Minor != 16u32 && !Ownedˉcollections.Minorˉisˉsupported(Minor) && Minor != 30u32 && Minor != 31u32 &&
        Minor != 33u32 && Minor != 34u32 && Minor != 35u32 &&
        Minor != 36u32 && Minor != 37u32 && Minor != 38u32 && Minor != 39u32 && !Nominalˉtypes.Compilerˉnativeˉx64ˉsharedˉminor(Minor) {
        return Compilerˉnativeˉx64ˉinvalidˉstructure();
    }
    if Bytesˉreadˉu32ˉlittle(Input, 8u32) != 7u32 {
        return Compilerˉnativeˉx64ˉinvalidˉstructure();
    }

    let Module: Compilerˉnativeˉx64ˉsection =
        Compilerˉnativeˉx64ˉreadˉsection(Input, 12u32, 1u8);
    if !Module.Valid { return Compilerˉnativeˉx64ˉinvalidˉstructure(); }
    let Capabilities: Compilerˉnativeˉx64ˉsection =
        Compilerˉnativeˉx64ˉreadˉsection(Input, Module.Nextˉoffset, 2u8);
    if !Capabilities.Valid { return Compilerˉnativeˉx64ˉinvalidˉstructure(); }
    let Data: Compilerˉnativeˉx64ˉsection =
        Compilerˉnativeˉx64ˉreadˉsection(Input, Capabilities.Nextˉoffset, 3u8);
    if !Data.Valid { return Compilerˉnativeˉx64ˉinvalidˉstructure(); }
    let Functions: Compilerˉnativeˉx64ˉsection =
        Compilerˉnativeˉx64ˉreadˉsection(Input, Data.Nextˉoffset, 4u8);
    if !Functions.Valid { return Compilerˉnativeˉx64ˉinvalidˉstructure(); }
    let Code: Compilerˉnativeˉx64ˉsection =
        Compilerˉnativeˉx64ˉreadˉsection(Input, Functions.Nextˉoffset, 5u8);
    if !Code.Valid { return Compilerˉnativeˉx64ˉinvalidˉstructure(); }
    let Exports: Compilerˉnativeˉx64ˉsection =
        Compilerˉnativeˉx64ˉreadˉsection(Input, Code.Nextˉoffset, 6u8);
    if !Exports.Valid { return Compilerˉnativeˉx64ˉinvalidˉstructure(); }
    let Types: Compilerˉnativeˉx64ˉsection =
        Compilerˉnativeˉx64ˉreadˉsection(Input, Exports.Nextˉoffset, 7u8);
    if !Types.Valid { return Compilerˉnativeˉx64ˉinvalidˉstructure(); }
    if Types.Nextˉoffset != Total {
        return Compilerˉnativeˉx64ˉinvalidˉstructure();
    }
    return Compilerˉnativeˉx64ˉstructure(
        true,
        Module.Payloadˉoffset,
        Module.Payloadˉlength,
        Capabilities.Payloadˉoffset,
        Capabilities.Payloadˉlength,
        Data.Payloadˉoffset,
        Data.Payloadˉlength,
        Functions.Payloadˉoffset,
        Functions.Payloadˉlength,
        Code.Payloadˉoffset,
        Code.Payloadˉlength,
        Exports.Payloadˉoffset,
        Exports.Payloadˉlength,
        Types.Payloadˉoffset,
        Types.Payloadˉlength
    );
}

export fn Compilerˉnativeˉx64ˉmainˉnameˉat(Input: bytes, Offset: u32) -> bool {
    if Bytesˉreadˉu8(Input, Offset) != 77u8 { return false; }
    if Bytesˉreadˉu8(Input, Offset + 1u32) != 97u8 { return false; }
    if Bytesˉreadˉu8(Input, Offset + 2u32) != 105u8 { return false; }
    return Bytesˉreadˉu8(Input, Offset + 3u32) == 110u8;
}

export fn Compilerˉnativeˉx64ˉmoduleˉisˉvalid(
    Input: bytes,
    Section: Compilerˉnativeˉx64ˉsection,
    Minor: u32
) -> bool {
    if Section.Payloadˉlength < 6u32 { return false; }
    let Nameˉlength: u32 =
        Bytesˉreadˉu32ˉlittle(Input, Section.Payloadˉoffset + 1u32);
    if Nameˉlength > Section.Payloadˉlength - 6u32 { return false; }
    if !Compilerˉnativeˉx64ˉidentifierˉisˉvalid(
        Input,
        Section.Payloadˉoffset + 5u32,
        Nameˉlength
    ) { return false; }
    let Metadata: Nativeˉmetadata.Compilerˉnativeˉx64ˉmetadata =
        Nativeˉmetadata.Compilerˉnativeˉx64ˉmetadataˉread(
            Input,
            Section.Payloadˉoffset + 5u32 + Nameˉlength,
            Section.Payloadˉoffset + Section.Payloadˉlength,
            Bytesˉreadˉu8(Input, Section.Payloadˉoffset),
            Minor
        );
    if !Metadata.Valid { return false; }
    if Minor == 38u32 &&
        !Nativeˉmetadata.Compilerˉnativeˉx64ˉregisteredˉforeignˉtargetˉisˉexact(
            Input,
            Section.Payloadˉoffset + 5u32 + Nameˉlength,
            Section.Payloadˉoffset + Section.Payloadˉlength
        ) {
        return false;
    }
    return true;
}

export fn Compilerˉnativeˉx64ˉinvalidˉfunction()
    -> Compilerˉnativeˉx64ˉfunction {
    return Compilerˉnativeˉx64ˉfunction(
        false,
        false,
        0u32,
        0u32,
        0u32,
        0u8,
        0u32,
        Textˉtoˉutf8(""),
        Textˉtoˉutf8(""),
        Textˉtoˉutf8(""),
        0u32,
        0u32,
        0u32,
        0u8,
        Textˉtoˉutf8(""),
        0u32,
        4294967295u32,
        Textˉtoˉutf8(""),
        Sharedˉlocalˉliveness.Directory(false, Textˉtoˉutf8(""), Textˉtoˉutf8(""), Textˉtoˉutf8(""), 0u32),
        4294967295u32
    );
}

export fn Compilerˉnativeˉx64ˉreadˉfunctionˉat(
    Input: bytes,
    Cursor: u32,
    Limit: u32,
    Requireˉmain: bool,
    Types: Nominalˉtypes.Compilerˉnativeˉx64ˉtypes
) -> Compilerˉnativeˉx64ˉfunction {
    let Total: u32 = Bytesˉlength(Input);
    if Limit > Total { return Compilerˉnativeˉx64ˉinvalidˉfunction(); }
    if Cursor > Limit { return Compilerˉnativeˉx64ˉinvalidˉfunction(); }
    if Limit - Cursor < 25u32 {
        return Compilerˉnativeˉx64ˉinvalidˉfunction();
    }
    let Nameˉlength: u32 = Bytesˉreadˉu32ˉlittle(Input, Cursor);
    if Nameˉlength == 0u32 { return Compilerˉnativeˉx64ˉinvalidˉfunction(); }
    if Nameˉlength > 255u32 { return Compilerˉnativeˉx64ˉinvalidˉfunction(); }
    if Nameˉlength > Limit - Cursor - 25u32 {
        return Compilerˉnativeˉx64ˉinvalidˉfunction();
    }
    let Nameˉoffset: u32 = Cursor + 4u32;
    if !Compilerˉnativeˉx64ˉidentifierˉisˉvalid(
        Input,
        Nameˉoffset,
        Nameˉlength
    ) {
        return Compilerˉnativeˉx64ˉinvalidˉfunction();
    }
    if Requireˉmain {
        if Nameˉlength != 4u32 {
            return Compilerˉnativeˉx64ˉinvalidˉfunction();
        }
        if !Compilerˉnativeˉx64ˉmainˉnameˉat(Input, Nameˉoffset) {
            return Compilerˉnativeˉx64ˉinvalidˉfunction();
        }
    } else {
        if Nameˉlength == 4u32 {
            if Compilerˉnativeˉx64ˉmainˉnameˉat(Input, Nameˉoffset) {
                return Compilerˉnativeˉx64ˉinvalidˉfunction();
            }
        }
    }
    let Signature: u32 = Nameˉoffset + Nameˉlength;
    let Parameters: u32 = Bytesˉreadˉu32ˉlittle(Input, Signature);
    if Parameters > Layout.Compilerˉnativeˉx64ˉlayoutˉparameterˉlimit() {
        return Compilerˉnativeˉx64ˉinvalidˉfunction();
    }
    if Requireˉmain {
        if Parameters > 1u32 && !Nominalˉtypes.Compilerˉnativeˉx64ˉsharedˉminor(Bytesˉreadˉu16ˉlittle(Input, 6u32)) {
            return Compilerˉnativeˉx64ˉinvalidˉfunction();
        }
    }
    let Parameterˉtypesˉoffset: u32 = Signature + 4u32;
    var Signatureˉcursor: u32 = Parameterˉtypesˉoffset;
    var Parameterˉtypes: bytes = Compilerˉnativeˉx64ˉempty(Input);
    var Parameterˉtypeˉidentities: bytes =
        Compilerˉnativeˉx64ˉempty(Input);
    var Parameterˉborrowˉkinds: bytes =
        Compilerˉnativeˉx64ˉempty(Input);
    let Moduleˉminor: u32 = Bytesˉreadˉu16ˉlittle(Input, 6u32);
    let Borrowˉmetadata: bool =
        (Moduleˉminor >= 34u32 && Moduleˉminor <= 39u32) ||
        Ownedˉcollections.Minorˉisˉsupported(Moduleˉminor) || Nominalˉtypes.Compilerˉnativeˉx64ˉsharedˉminor(Moduleˉminor);
    var Parameter: u32 = 0u32;
    while Parameter < Parameters {
        let Parameterˉshape: Nominalˉtypes.Compilerˉnativeˉx64ˉshape =
            Nominalˉtypes.Compilerˉnativeˉx64ˉfunctionˉshapeˉread(
                Input,
                Signatureˉcursor,
                Limit,
                Types,
                Moduleˉminor
            );
        if !Parameterˉshape.Valid {
            return Compilerˉnativeˉx64ˉinvalidˉfunction();
        }
        if Ownedˉcollections.Minorˉisˉsupported(Moduleˉminor) &&
            !Ownedˉcollections.Parameterˉisˉsupported(Parameterˉshape) {
            return Compilerˉnativeˉx64ˉinvalidˉfunction();
        }
        if !Compilerˉnativeˉx64ˉsignatureˉtypeˉisˉsupported(
            Parameterˉshape.Type
        ) {
            return Compilerˉnativeˉx64ˉinvalidˉfunction();
        }
        Parameterˉtypes = Bytesˉconcat(
            Parameterˉtypes,
            Bytesˉfromˉu8(Parameterˉshape.Type)
        );
        Parameterˉtypeˉidentities = Bytesˉconcat(
            Parameterˉtypeˉidentities,
            Bytesˉfromˉu32ˉlittle(Parameterˉshape.Identity)
        );
        if Borrowˉmetadata {
            Parameterˉborrowˉkinds = Bytesˉconcat(
                Parameterˉborrowˉkinds,
                Bytesˉfromˉu8(Parameterˉshape.Borrowˉkind)
            );
        }
        Signatureˉcursor = Parameterˉshape.Next;
        Parameter = Parameter + 1u32;
    }
    if Requireˉmain && Parameters == 1u32 &&
        Bytesˉreadˉu32ˉlittle(Parameterˉtypeˉidentities, 0u32) != 25u32 {
        return Compilerˉnativeˉx64ˉinvalidˉfunction();
    }
    let Returnˉshape: Nominalˉtypes.Compilerˉnativeˉx64ˉshape =
        Nominalˉtypes.Compilerˉnativeˉx64ˉreturnˉshapeˉread(
            Input,
            Signatureˉcursor,
            Limit,
            Types
        );
    if !Returnˉshape.Valid {
        return Compilerˉnativeˉx64ˉinvalidˉfunction();
    }
    if Returnˉshape.Borrowˉkind != 0u8 &&
        !(Nominalˉtypes.Compilerˉnativeˉx64ˉsharedˉminor(Moduleˉminor) && Returnˉshape.Type == 7u8 && Returnˉshape.Identity == 40u32) {
        return Compilerˉnativeˉx64ˉinvalidˉfunction();
    }
    let Returnˉtype: u8 = Returnˉshape.Type;
    if Ownedˉcollections.Minorˉisˉsupported(Moduleˉminor) && Returnˉtype != 0u8 &&
        !Ownedˉcollections.Shapeˉisˉsupported(Returnˉshape) {
        return Compilerˉnativeˉx64ˉinvalidˉfunction();
    }
    if Returnˉtype != 0u8 &&
        !Compilerˉnativeˉx64ˉsignatureˉtypeˉisˉsupported(Returnˉtype) {
        return Compilerˉnativeˉx64ˉinvalidˉfunction();
    }
    if Requireˉmain {
        if Returnˉtype != 1u8 && Returnˉtype != 6u8 {
            return Compilerˉnativeˉx64ˉinvalidˉfunction();
        }
    }
    if Nominalˉtypes.Compilerˉnativeˉx64ˉsharedˉminor(Moduleˉminor) {
        if Requireˉmain {
            if Returnˉtype == 1u8 {
                if Parameters != 1u32 || Bytesˉreadˉu8(Parameterˉtypes, 0u32) != 10u8 ||
                    Bytesˉreadˉu32ˉlittle(Parameterˉtypeˉidentities, 0u32) != 25u32 ||
                    Bytesˉreadˉu8(Parameterˉborrowˉkinds, 0u32) != 0u8 {
                    return Compilerˉnativeˉx64ˉinvalidˉfunction();
                }
            } else {
                if Parameters != 2u32 || Bytesˉreadˉu8(Parameterˉtypes, 0u32) != 6u8 ||
                    Bytesˉreadˉu8(Parameterˉborrowˉkinds, 0u32) != 37u8 ||
                    Bytesˉreadˉu8(Parameterˉtypes, 1u32) != 10u8 ||
                    Bytesˉreadˉu32ˉlittle(Parameterˉtypeˉidentities, 4u32) != 25u32 ||
                    Bytesˉreadˉu8(Parameterˉborrowˉkinds, 1u32) != 0u8 {
                    return Compilerˉnativeˉx64ˉinvalidˉfunction();
                }
            }
        }
        if Returnˉtype == 7u8 {
            var Borrowed: u32 = 0u32;
            var Position: u32 = 0u32;
            while Position < Parameters {
                if Bytesˉreadˉu8(Parameterˉborrowˉkinds, Position) != 0u8 { Borrowed = Borrowed + 1u32; }
                Position = Position + 1u32;
            }
            if Borrowed != 1u32 { return Compilerˉnativeˉx64ˉinvalidˉfunction(); }
        }
    }
    if !Compilerˉnativeˉx64ˉrangeˉisˉvalid(
        Limit,
        Returnˉshape.Next,
        4u32
    ) {
        return Compilerˉnativeˉx64ˉinvalidˉfunction();
    }
    let Declaredˉlocals: u32 = Bytesˉreadˉu32ˉlittle(
        Input,
        Returnˉshape.Next
    );
    if Declaredˉlocals >= 2048u32 {
        return Compilerˉnativeˉx64ˉinvalidˉfunction();
    }
    let Locals: u32 = Parameters + Declaredˉlocals;
    if Locals >= 2048u32 {
        return Compilerˉnativeˉx64ˉinvalidˉfunction();
    }
    let Declaredˉtypesˉoffset: u32 = Returnˉshape.Next + 4u32;
    var Declaredˉtypes: bytes = Compilerˉnativeˉx64ˉempty(Input);
    var Declaredˉtypeˉidentities: bytes =
        Compilerˉnativeˉx64ˉempty(Input);
    var Declaredˉborrowˉkinds: bytes =
        Compilerˉnativeˉx64ˉempty(Input);
    var Declaredˉcursor: u32 = Declaredˉtypesˉoffset;
    var Local: u32 = 0u32;
    while Local < Declaredˉlocals {
        let Localˉshape: Nominalˉtypes.Compilerˉnativeˉx64ˉshape =
            Nominalˉtypes.Compilerˉnativeˉx64ˉfunctionˉshapeˉread(
                Input,
                Declaredˉcursor,
                Limit,
                Types,
                Moduleˉminor
            );
        if !Localˉshape.Valid {
            return Compilerˉnativeˉx64ˉinvalidˉfunction();
        }
        if Ownedˉcollections.Minorˉisˉsupported(Moduleˉminor) && !Ownedˉcollections.Shapeˉisˉsupported(Localˉshape) {
            return Compilerˉnativeˉx64ˉinvalidˉfunction();
        }
        if !Compilerˉnativeˉx64ˉlocalˉtypeˉisˉsupported(
            Localˉshape.Type
        ) { return Compilerˉnativeˉx64ˉinvalidˉfunction(); }
        Declaredˉtypes = Bytesˉconcat(
            Declaredˉtypes,
            Bytesˉfromˉu8(Localˉshape.Type)
        );
        Declaredˉtypeˉidentities = Bytesˉconcat(
            Declaredˉtypeˉidentities,
            Bytesˉfromˉu32ˉlittle(Localˉshape.Identity)
        );
        if Borrowˉmetadata {
            Declaredˉborrowˉkinds = Bytesˉconcat(
                Declaredˉborrowˉkinds,
                Bytesˉfromˉu8(Localˉshape.Borrowˉkind)
            );
        }
        Declaredˉcursor = Localˉshape.Next;
        Local = Local + 1u32;
    }
    let Metadata: u32 = Declaredˉcursor;
    if !Compilerˉnativeˉx64ˉrangeˉisˉvalid(Limit, Metadata, 12u32) {
        return Compilerˉnativeˉx64ˉinvalidˉfunction();
    }
    let Codeˉoffset: u32 = Bytesˉreadˉu32ˉlittle(Input, Metadata);
    let Codeˉlength: u32 = Bytesˉreadˉu32ˉlittle(Input, Metadata + 4u32);
    let Maximumˉstack: u32 = Bytesˉreadˉu32ˉlittle(Input, Metadata + 8u32);
    if Codeˉlength == 0u32 { return Compilerˉnativeˉx64ˉinvalidˉfunction(); }
    if Codeˉlength > 131072u32 { return Compilerˉnativeˉx64ˉinvalidˉfunction(); }
    if Maximumˉstack > 1024u32 { return Compilerˉnativeˉx64ˉinvalidˉfunction(); }
    var Localˉborrowˉkinds: bytes = Compilerˉnativeˉx64ˉempty(Input);
    if Borrowˉmetadata {
        Localˉborrowˉkinds = Bytesˉconcat(
            Parameterˉborrowˉkinds,
            Declaredˉborrowˉkinds
        );
    }
    return Compilerˉnativeˉx64ˉfunction(
        true,
        Nominalˉtypes.Compilerˉnativeˉx64ˉsharedˉminor(Bytesˉreadˉu16ˉlittle(Input, 6u32)),
        Metadata + 12u32,
        Codeˉoffset,
        Parameters,
        Returnˉtype,
        Locals,
        Bytesˉconcat(
            Parameterˉtypes,
            Declaredˉtypes
        ),
        Bytesˉconcat(
            Parameterˉtypeˉidentities,
            Declaredˉtypeˉidentities
        ),
        Localˉborrowˉkinds,
        Codeˉlength,
        Maximumˉstack,
        Returnˉshape.Identity,
        Returnˉshape.Borrowˉkind,
        Compilerˉnativeˉx64ˉempty(Input),
        0u32,
        4294967295u32,
        Compilerˉnativeˉx64ˉempty(Input),
        Sharedˉlocalˉliveness.Directory(false, Compilerˉnativeˉx64ˉempty(Input),
            Compilerˉnativeˉx64ˉempty(Input), Compilerˉnativeˉx64ˉempty(Input), 0u32),
        4294967295u32
    );
}


fn Compilerˉnativeˉx64ˉfunctionˉwithˉsignatures(
    Function: Compilerˉnativeˉx64ˉfunction,
    Cursors: bytes, Limit: u32, Main: u32, Borrowˉroots: bytes,
    Borrowˉdirectory: Sharedˉlocalˉliveness.Directory, Index: u32
) -> Compilerˉnativeˉx64ˉfunction {
    return Compilerˉnativeˉx64ˉfunction(Function.Valid, Function.Sharedˉvalues,
        Function.Nextˉoffset, Function.Codeˉoffset, Function.Parameters, Function.Returnˉtype,
        Function.Locals, Function.Localˉtypes, Function.Localˉtypeˉidentities,
        Function.Localˉborrowˉkinds, Function.Codeˉlength, Function.Maximumˉstack,
        Function.Returnˉidentity, Function.Returnˉborrowˉkind, Cursors, Limit, Main, Borrowˉroots, Borrowˉdirectory, Index);
}
fn Compilerˉnativeˉx64ˉcalleeˉread(Input: bytes,
    Caller: Compilerˉnativeˉx64ˉfunction, Target: u32,
    Types: Nominalˉtypes.Compilerˉnativeˉx64ˉtypes
) -> Compilerˉnativeˉx64ˉfunction {
    if Bytesˉlength(Caller.Signatureˉcursors) % 4u32 != 0u32 ||
        Bytesˉlength(Caller.Signatureˉcursors) > 8192u32 ||
        Target >= Bytesˉlength(Caller.Signatureˉcursors) / 4u32 {
        return Compilerˉnativeˉx64ˉinvalidˉfunction();
    }
    return Compilerˉnativeˉx64ˉreadˉfunctionˉat(Input,
        Bytesˉreadˉu32ˉlittle(Caller.Signatureˉcursors, Target * 4u32),
        Caller.Signatureˉlimit, Target == Caller.Signatureˉmain, Types);
}

export fn Compilerˉnativeˉx64ˉexportˉisˉsupported(
    Input: bytes,
    Section: Compilerˉnativeˉx64ˉsection,
    Target: u32
) -> bool {
    if Section.Payloadˉlength != 17u32 { return false; }
    let Offset: u32 = Section.Payloadˉoffset;
    if Bytesˉreadˉu32ˉlittle(Input, Offset) != 1u32 { return false; }
    if Bytesˉreadˉu32ˉlittle(Input, Offset + 4u32) != 4u32 { return false; }
    if !Compilerˉnativeˉx64ˉmainˉnameˉat(Input, Offset + 8u32) {
        return false;
    }
    if Bytesˉreadˉu8(Input, Offset + 12u32) != 1u8 { return false; }
    return Bytesˉreadˉu32ˉlittle(Input, Offset + 13u32) == Target;
}

export fn Compilerˉnativeˉx64ˉemptyˉanalysis()
    -> Compilerˉnativeˉx64ˉanalysis {
    return Compilerˉnativeˉx64ˉanalysis(
        false,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32
    );
}

export fn Compilerˉnativeˉx64ˉanalyzeˉcode(
    Input: bytes,
    Section: Compilerˉnativeˉx64ˉsection,
    Function: Compilerˉnativeˉx64ˉfunction
) -> Compilerˉnativeˉx64ˉanalysis {
    if Section.Payloadˉlength != Function.Codeˉlength {
        return Compilerˉnativeˉx64ˉemptyˉanalysis();
    }
    var Stack: bytes = Compilerˉnativeˉx64ˉempty(Input);
    var Stackˉdepth: u32 = 0u32;
    var Maximumˉstack: u32 = 0u32;
    var Values: u32 = 0u32;
    var Instructions: u32 = 0u32;
    var Bodyˉbytes: u32 = 0u32;
    var Returnˉvalue: u32 = 0u32;
    var Returned: bool = false;
    var Cursor: u32 = 0u32;
    while Cursor < Section.Payloadˉlength {
        if Returned { return Compilerˉnativeˉx64ˉemptyˉanalysis(); }
        let Opcode: u8 = Bytesˉreadˉu8(Input, Section.Payloadˉoffset + Cursor);
        Instructions = Instructions + 1u32;
        if Instructions > 32768u32 {
            return Compilerˉnativeˉx64ˉemptyˉanalysis();
        }
        if Opcode == 1u8 {
            if Section.Payloadˉlength - Cursor < 5u32 {
                return Compilerˉnativeˉx64ˉemptyˉanalysis();
            }
            Stack = Bytesˉconcat(Stack, Bytesˉfromˉu32ˉlittle(Values));
            Stackˉdepth = Stackˉdepth + 1u32;
            Values = Values + 1u32;
            Bodyˉbytes = Bodyˉbytes + 22u32;
            Cursor = Cursor + 5u32;
        } else {
            if Opcode == 4u8 || Opcode == 205u8 {
                if Section.Payloadˉlength - Cursor < 5u32 {
                    return Compilerˉnativeˉx64ˉemptyˉanalysis();
                }
                let Loadˉindex: u32 = Bytesˉreadˉu32ˉlittle(
                    Input,
                    Section.Payloadˉoffset + Cursor + 1u32
                );
                if Loadˉindex >= Function.Locals {
                    return Compilerˉnativeˉx64ˉemptyˉanalysis();
                }
                Stack = Bytesˉconcat(Stack, Bytesˉfromˉu32ˉlittle(Values));
                Stackˉdepth = Stackˉdepth + 1u32;
                Values = Values + 1u32;
                Bodyˉbytes = Bodyˉbytes + 24u32;
                Cursor = Cursor + 5u32;
            } else {
                if Opcode == 5u8 {
                    if Section.Payloadˉlength - Cursor < 5u32 {
                        return Compilerˉnativeˉx64ˉemptyˉanalysis();
                    }
                    let Storeˉindex: u32 = Bytesˉreadˉu32ˉlittle(
                        Input,
                        Section.Payloadˉoffset + Cursor + 1u32
                    );
                    if Storeˉindex >= Function.Locals {
                        return Compilerˉnativeˉx64ˉemptyˉanalysis();
                    }
                    if Stackˉdepth == 0u32 {
                        return Compilerˉnativeˉx64ˉemptyˉanalysis();
                    }
                    Stackˉdepth = Stackˉdepth - 1u32;
                    Stack = Bytesˉslice(Stack, 0u32, Stackˉdepth * 4u32);
                    Bodyˉbytes = Bodyˉbytes + 24u32;
                    Cursor = Cursor + 5u32;
                } else {
                    if Opcode == 16u8 {
                        if Stackˉdepth < 2u32 {
                            return Compilerˉnativeˉx64ˉemptyˉanalysis();
                        }
                        Stackˉdepth = Stackˉdepth - 2u32;
                        Stack = Bytesˉslice(Stack, 0u32, Stackˉdepth * 4u32);
                        Stack = Bytesˉconcat(Stack, Bytesˉfromˉu32ˉlittle(Values));
                        Stackˉdepth = Stackˉdepth + 1u32;
                        Values = Values + 1u32;
                        Bodyˉbytes = Bodyˉbytes + 39u32;
                        Cursor = Cursor + 1u32;
                    } else {
                        if Opcode == 17u8 {
                            if Stackˉdepth < 2u32 {
                                return Compilerˉnativeˉx64ˉemptyˉanalysis();
                            }
                            Stackˉdepth = Stackˉdepth - 2u32;
                            Stack = Bytesˉslice(Stack, 0u32, Stackˉdepth * 4u32);
                            Stack = Bytesˉconcat(Stack, Bytesˉfromˉu32ˉlittle(Values));
                            Stackˉdepth = Stackˉdepth + 1u32;
                            Values = Values + 1u32;
                            Bodyˉbytes = Bodyˉbytes + 39u32;
                            Cursor = Cursor + 1u32;
                        } else {
                            if Opcode == 18u8 {
                                if Stackˉdepth < 2u32 {
                                    return Compilerˉnativeˉx64ˉemptyˉanalysis();
                                }
                                Stackˉdepth = Stackˉdepth - 2u32;
                                Stack = Bytesˉslice(Stack, 0u32, Stackˉdepth * 4u32);
                                Stack = Bytesˉconcat(Stack, Bytesˉfromˉu32ˉlittle(Values));
                                Stackˉdepth = Stackˉdepth + 1u32;
                                Values = Values + 1u32;
                                Bodyˉbytes = Bodyˉbytes + 40u32;
                                Cursor = Cursor + 1u32;
                            } else {
                                if Opcode == 19u8 {
                                    if Stackˉdepth == 0u32 {
                                        return Compilerˉnativeˉx64ˉemptyˉanalysis();
                                    }
                                    Stackˉdepth = Stackˉdepth - 1u32;
                                    Stack = Bytesˉslice(Stack, 0u32, Stackˉdepth * 4u32);
                                    Stack = Bytesˉconcat(
                                        Stack,
                                        Bytesˉfromˉu32ˉlittle(Values)
                                    );
                                    Stackˉdepth = Stackˉdepth + 1u32;
                                    Values = Values + 1u32;
                                    Bodyˉbytes = Bodyˉbytes + 32u32;
                                    Cursor = Cursor + 1u32;
                                } else {
                                    if Opcode != 81u8 {
                                        return Compilerˉnativeˉx64ˉemptyˉanalysis();
                                    }
                                    if Stackˉdepth != 1u32 {
                                        return Compilerˉnativeˉx64ˉemptyˉanalysis();
                                    }
                                    Returnˉvalue = Bytesˉreadˉu32ˉlittle(Stack, 0u32);
                                    Stackˉdepth = 0u32;
                                    Stack = Compilerˉnativeˉx64ˉempty(Input);
                                    Bodyˉbytes = Bodyˉbytes + 30u32;
                                    Cursor = Cursor + 1u32;
                                    Returned = true;
                                }
                            }
                        }
                    }
                }
            }
        }
        if Stackˉdepth > Maximumˉstack { Maximumˉstack = Stackˉdepth; }
        if Values > 2048u32 - Function.Locals {
            return Compilerˉnativeˉx64ˉemptyˉanalysis();
        }
    }
    if !Returned { return Compilerˉnativeˉx64ˉemptyˉanalysis(); }
    if Maximumˉstack != Function.Maximumˉstack {
        return Compilerˉnativeˉx64ˉemptyˉanalysis();
    }
    return Compilerˉnativeˉx64ˉanalysis(
        true,
        Values,
        Instructions,
        Bodyˉbytes,
        Returnˉvalue,
        Maximumˉstack
    );
}

fn Compilerˉnativeˉx64ˉfailureˉcontrolˉanalysis(Input: bytes, Detail: u32)
    -> Compilerˉnativeˉx64ˉcontrolˉanalysis {
    return Compilerˉnativeˉx64ˉcontrolˉanalysis(
        false,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        Detail,
        false,
        false,
        0u32,
        Compilerˉnativeˉx64ˉempty(Input),
        Compilerˉnativeˉx64ˉempty(Input),
        Compilerˉnativeˉx64ˉempty(Input),
        Compilerˉnativeˉx64ˉempty(Input),
        Compilerˉnativeˉx64ˉempty(Input),
        0u32,
        0u32,
        Compilerˉnativeˉx64ˉempty(Input),
        Compilerˉnativeˉx64ˉempty(Input),
        Compilerˉnativeˉx64ˉempty(Input),
        Sharedˉlocalˉliveness.Empty(Input, 0u32)
    );
}

export fn Compilerˉnativeˉx64ˉemptyˉcontrolˉanalysis(Input: bytes)
    -> Compilerˉnativeˉx64ˉcontrolˉanalysis {
    return Compilerˉnativeˉx64ˉfailureˉcontrolˉanalysis(Input, 0u32);
}

export fn Compilerˉnativeˉx64ˉinvalidˉblock()
    -> Compilerˉnativeˉx64ˉblockˉanalysis {
    return Compilerˉnativeˉx64ˉblockˉanalysis(
        false,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u8,
        0u32,
        Textˉtoˉutf8("")
    );
}

fn Compilerˉnativeˉx64ˉblockˉvalueˉstate(
    Stack: bytes,
    Depth: u32,
    I32ˉvalues: u32,
    Boolˉvalues: u32,
    Textˉvalues: u32,
    U8ˉvalues: u32,
    U32ˉvalues: u32,
    Bytesˉvalues: u32,
    Enumˉvalues: u32,
    Recordˉvalues: u32,
    Bodyˉbytes: u32
) -> bytes {
    var Result: bytes = Bytesˉfromˉu8(1u8);
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Depth));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(I32ˉvalues));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Boolˉvalues));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Textˉvalues));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(U8ˉvalues));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(U32ˉvalues));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Bytesˉvalues));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Enumˉvalues));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Recordˉvalues));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Bodyˉbytes));
    return Bytesˉconcat(Result, Stack);
}

fn Compilerˉnativeˉx64ˉblockˉvalueˉstateˉisˉvalid(State: bytes)
    -> bool {
    if Bytesˉlength(State) < 41u32 || Bytesˉreadˉu8(State, 0u32) != 1u8 {
        return false;
    }
    return Bytesˉreadˉu32ˉlittle(State, 1u32) == Bytesˉlength(State) - 41u32;
}

fn Compilerˉnativeˉx64ˉblockˉvalueˉstateˉstack(State: bytes)
    -> bytes {
    return Bytesˉslice(State, 41u32, Bytesˉlength(State) - 41u32);
}

fn Compilerˉnativeˉx64ˉinvalidˉblockˉvalueˉstate(Input: bytes)
    -> bytes {
    return Compilerˉnativeˉx64ˉempty(Input);
}

export fn Compilerˉnativeˉx64ˉzeroˉmap(Input: bytes, Length: u32) -> bytes {
    var Result: bytes = Compilerˉnativeˉx64ˉempty(Input);
    var Chunk: bytes = Bytesˉfromˉu8(0u8);
    var Remaining: u32 = Length;
    while Remaining > 0u32 {
        if Remaining % 2u32 == 1u32 {
            Result = Bytesˉconcat(Result, Chunk);
        }
        Remaining = Remaining / 2u32;
        if Remaining > 0u32 {
            Chunk = Bytesˉconcat(Chunk, Chunk);
        }
    }
    return Result;
}

fn Compilerˉnativeˉx64ˉsetˉmapˉbyte(
    Input: bytes,
    Index: u32
) -> bytes {
    return Bytesˉconcat(
        Bytesˉconcat(
            Bytesˉslice(Input, 0u32, Index),
            Bytesˉfromˉu8(1u8)
        ),
        Bytesˉslice(
            Input,
            Index + 1u32,
            Bytesˉlength(Input) - Index - 1u32
        )
    );
}

fn Compilerˉnativeˉx64ˉleaderˉmap(
    Input: bytes,
    Leaderˉoffsets: bytes,
    Length: u32
) -> bytes {
    if Bytesˉlength(Leaderˉoffsets) % 4u32 != 0u32 {
        return Compilerˉnativeˉx64ˉempty(Input);
    }
    var Result: bytes = Compilerˉnativeˉx64ˉzeroˉmap(Input, Length);
    var Cursor: u32 = 0u32;
    while Cursor < Bytesˉlength(Leaderˉoffsets) {
        let Leader: u32 = Bytesˉreadˉu32ˉlittle(Leaderˉoffsets, Cursor);
        if Leader < Length {
            Result = Compilerˉnativeˉx64ˉsetˉmapˉbyte(Result, Leader);
        }
        Cursor = Cursor + 4u32;
    }
    return Result;
}

export fn Compilerˉnativeˉx64ˉscalarˉtypeˉisˉsupported(Type: u8) -> bool {
    if Type == 1u8 { return true; }
    if Type == 2u8 { return true; }
    if Type == 4u8 { return true; }
    if Type == 5u8 { return true; }
    if Type == 9u8 { return true; }
    return Type == 10u8;
}

export fn Compilerˉnativeˉx64ˉsignatureˉtypeˉisˉsupported(Type: u8) -> bool {
    if Compilerˉnativeˉx64ˉscalarˉtypeˉisˉsupported(Type) || Type == 8u8 { return true; }
    if Descriptorˉcalls.Compilerˉnativeˉx64ˉtypeˉisˉdescriptor(Type) {
        return true;
    }
    if Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉisˉenum(Type) { return true; }
    return Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉisˉrecord(Type);
}

export fn Compilerˉnativeˉx64ˉlocalˉtypeˉisˉsupported(Type: u8) -> bool {
    if Compilerˉnativeˉx64ˉscalarˉtypeˉisˉsupported(Type) || Type == 8u8 { return true; }
    if Type == 3u8 { return true; }
    if Type == 6u8 || Type == 7u8 { return true; }
    if Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉisˉcallable(Type) {
        return true;
    }
    if Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉisˉenum(Type) { return true; }
    return Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉisˉrecord(Type);
}

export fn Compilerˉnativeˉx64ˉdescriptorˉoperation(Opcode: u8) -> bool {
    let Numeric: u32 = U32ˉfromˉu8(Opcode);
    if Opcode == 3u8 { return true; }
    if Opcode == 10u8 { return true; }
    if Numeric >= 11u32 {
        if Numeric <= 15u32 { return true; }
    }
    if Opcode == 110u8 { return true; }
    if Opcode == 112u8 { return true; }
    if Opcode == 113u8 { return true; }
    if Opcode == 114u8 { return true; }
    if Opcode == 115u8 { return true; }
    if Opcode == 116u8 { return true; }
    if Opcode == 117u8 { return true; }
    if Opcode == 118u8 { return true; }
    if Opcode == 119u8 { return true; }
    if Opcode == 120u8 { return true; }
    if Opcode == 121u8 { return true; }
    if Opcode == 122u8 { return true; }
    if Opcode == 123u8 { return true; }
    if Opcode == 124u8 { return true; }
    if Opcode == 125u8 { return true; }
    if Opcode == 189u8 { return true; }
    if Opcode == 190u8 { return true; }
    return Opcode == 191u8;
}

export fn Compilerˉnativeˉx64ˉnominalˉoperation(Opcode: u8) -> bool {
    let Numeric: u32 = U32ˉfromˉu8(Opcode);
    if Numeric < 106u32 { return false; }
    return Numeric <= 109u32;
}

export fn Compilerˉnativeˉx64ˉrecordˉoperation(Opcode: u8) -> bool {
    if Opcode == 104u8 { return true; }
    return Opcode == 105u8;
}

export fn Compilerˉnativeˉx64ˉvariantˉoperation(Opcode: u8) -> bool {
    let Numeric: u32 = U32ˉfromˉu8(Opcode);
    if Numeric >= 151u32 && Numeric <= 153u32 { return true; }
    return Opcode == 196u8 || Opcode == 225u8;
}

export fn Compilerˉnativeˉx64ˉisˉi32ˉcomparison(Opcode: u8) -> bool {
    let Numeric: u32 = U32ˉfromˉu8(Opcode);
    if Numeric < 32u32 { return false; }
    return Numeric <= 37u32;
}

export fn Compilerˉnativeˉx64ˉisˉboolˉcomparison(Opcode: u8) -> bool {
    let Numeric: u32 = U32ˉfromˉu8(Opcode);
    if Numeric < 38u32 { return false; }
    return Numeric <= 39u32;
}

export fn Compilerˉnativeˉx64ˉisˉu32ˉcomparison(Opcode: u8) -> bool {
    let Numeric: u32 = U32ˉfromˉu8(Opcode);
    if Numeric < 96u32 { return false; }
    return Numeric <= 101u32;
}

export fn Compilerˉnativeˉx64ˉisˉu8ˉcomparison(Opcode: u8) -> bool {
    let Numeric: u32 = U32ˉfromˉu8(Opcode);
    if Numeric < 102u32 { return false; }
    return Numeric <= 103u32;
}

export fn Compilerˉnativeˉx64ˉisˉu64ˉcomparison(Opcode: u8) -> bool {
    let Numeric: u32 = U32ˉfromˉu8(Opcode);
    if Numeric < 143u32 { return false; }
    return Numeric <= 148u32;
}

export fn Compilerˉnativeˉx64ˉisˉi64ˉcomparison(Opcode: u8) -> bool {
    let Numeric: u32 = U32ˉfromˉu8(Opcode);
    if Numeric < 137u32 { return false; }
    return Numeric <= 142u32;
}

export fn Compilerˉnativeˉx64ˉisˉu64ˉbitwise(Opcode: u8) -> bool {
    let Numeric: u32 = U32ˉfromˉu8(Opcode);
    if Numeric < 179u32 { return false; }
    return Numeric <= 184u32;
}

export fn Compilerˉnativeˉx64ˉisˉenumˉcomparison(Opcode: u8) -> bool {
    if Opcode == 107u8 { return true; }
    return Opcode == 108u8;
}

export fn Compilerˉnativeˉx64ˉinstructionˉsize(Opcode: u8) -> u32 {
    let Numeric: u32 = U32ˉfromˉu8(Opcode);
    if Numeric >= 229u32 && Numeric <= 235u32 { return 13u32; }
    if Opcode == 239u8 { return 5u32; }
    if Numeric >= 236u32 && Numeric <= 241u32 { return 1u32; }
    if Opcode == 195u8 { return 1u32; }
    if Opcode == 1u8 { return 5u32; }
    if Opcode == 2u8 { return 2u32; }
    if Opcode == 3u8 { return 5u32; }
    if Opcode == 4u8 { return 5u32; }
    if Opcode == 5u8 { return 5u32; }
    if Opcode == 6u8 { return 5u32; }
    if Opcode == 7u8 { return 5u32; }
    if Opcode == 8u8 { return 2u32; }
    if Opcode == 9u8 { return 5u32; }
    if Opcode == 10u8 { return 5u32; }
    if Numeric >= 11u32 {
        if Numeric <= 15u32 { return 1u32; }
    }
    if Numeric >= 16u32 {
        if Numeric <= 22u32 { return 1u32; }
    }
    if Compilerˉnativeˉx64ˉisˉi32ˉcomparison(Opcode) { return 1u32; }
    if Compilerˉnativeˉx64ˉisˉboolˉcomparison(Opcode) { return 1u32; }
    if Compilerˉnativeˉx64ˉisˉu32ˉcomparison(Opcode) { return 1u32; }
    if Compilerˉnativeˉx64ˉisˉu8ˉcomparison(Opcode) { return 1u32; }
    if Opcode == 128u8 || Opcode == 129u8 { return 9u32; }
    if Opcode == 133u8 { return 1u32; }
    if Numeric >= 134u32 && Numeric <= 136u32 { return 1u32; }
    if Compilerˉnativeˉx64ˉisˉi64ˉcomparison(Opcode) { return 1u32; }
    if Compilerˉnativeˉx64ˉisˉu64ˉcomparison(Opcode) { return 1u32; }
    if Compilerˉnativeˉx64ˉrecordˉoperation(Opcode) { return 5u32; }
    if Opcode == 106u8 { return 9u32; }
    if Compilerˉnativeˉx64ˉisˉenumˉcomparison(Opcode) { return 1u32; }
    if Opcode == 109u8 { return 1u32; }
    if Opcode == 225u8 { return 13u32; }
    if Compilerˉnativeˉx64ˉvariantˉoperation(Opcode) { return 9u32; }
    if Opcode == 40u8 { return 1u32; }
    if Opcode == 48u8 { return 5u32; }
    if Opcode == 49u8 { return 5u32; }
    if Opcode == 64u8 { return 5u32; }
    if Opcode == 65u8 { return 5u32; }
    if Opcode == 80u8 || Opcode == 81u8 { return 1u32; }
    if Opcode == 110u8 { return 1u32; }
    if Opcode == 112u8 { return 1u32; }
    if Opcode == 113u8 { return 1u32; }
    if Opcode == 114u8 { return 1u32; }
    if Opcode == 115u8 { return 1u32; }
    if Opcode == 116u8 { return 1u32; }
    if Opcode == 117u8 { return 1u32; }
    if Opcode == 118u8 { return 1u32; }
    if Opcode == 119u8 { return 1u32; }
    if Opcode == 120u8 { return 1u32; }
    if Opcode == 121u8 { return 1u32; }
    if Opcode == 122u8 { return 1u32; }
    if Opcode == 123u8 { return 1u32; }
    if Opcode == 124u8 { return 1u32; }
    if Opcode == 125u8 { return 1u32; }
    if Opcode == 161u8 { return 1u32; }
    if Opcode == 162u8 { return 1u32; }
    if Opcode == 165u8 || Opcode == 166u8 { return 1u32; }
    if Numeric >= 173u32 {
        if Numeric <= 178u32 { return 1u32; }
    }
    if Opcode == 189u8 || Opcode == 190u8 || Opcode == 191u8 { return 1u32; }
    if Opcode == 211u8 { return 9u32; }
    if Opcode == 212u8 { return 5u32; }
    if Opcode == 213u8 { return 13u32; }
    if Opcode == 196u8 { return 9u32; }
    if Opcode == 205u8 { return 5u32; }
    if Opcode == 206u8 || Opcode == 207u8 || Opcode == 208u8 ||
        Opcode == 226u8 || Opcode == 227u8 || Opcode == 228u8 { return 9u32; }
    if Opcode == 209u8 { return 13u32; }
    if Opcode == 202u8 { return 5u32; }
    if Opcode == 220u8 { return 13u32; }
    if Opcode == 221u8 { return 9u32; }
    if Opcode == 222u8 { return 13u32; }
    if Opcode == 223u8 { return 13u32; }
    if Opcode == 224u8 { return 13u32; }
    if Compilerˉnativeˉx64ˉisˉu64ˉbitwise(Opcode) { return 1u32; }
    return 0u32;
}

fn Compilerˉnativeˉx64ˉcodeˉusesˉsha256(
    Input: bytes,
    Codeˉoffset: u32,
    Codeˉlength: u32
) -> bool {
    var Cursor: u32 = 0u32;
    while Cursor < Codeˉlength {
        let Opcode: u8 = Bytesˉreadˉu8(Input, Codeˉoffset + Cursor);
        if Opcode == 125u8 { return true; }
        let Size: u32 = Compilerˉnativeˉx64ˉinstructionˉsize(Opcode);
        if Size == 0u32 || Size > Codeˉlength - Cursor { return false; }
        Cursor = Cursor + Size;
    }
    return false;
}

fn Compilerˉnativeˉx64ˉownedˉmain(Input: bytes) -> u32 {
    let Structure: Compilerˉnativeˉx64ˉstructure = Compilerˉnativeˉx64ˉreadˉstructure(Input);
    if !Structure.Valid || Structure.Exportsˉlength != 17u32 { return 4294967295u32; }
    return Bytesˉreadˉu32ˉlittle(Input, Structure.Exportsˉoffset + 13u32);
}

fn Compilerˉnativeˉx64ˉcallableˉversionˉisˉvalid(
    Input: bytes,
    Codeˉoffset: u32,
    Codeˉlength: u32,
    Minor: u32,
    Profile: u8,
    Types: Nominalˉtypes.Compilerˉnativeˉx64ˉtypes
) -> bool {
    var Callableˉtypes: u32 = 0u32;
    var Typeˉindex: u32 = 0u32;
    while Typeˉindex < Types.Count {
        if Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉkind(
            Types, Typeˉindex
        ) == 8u8 {
            if Nominalˉtypes.Compilerˉnativeˉx64ˉcallableˉprofile(
                Input, Types, Typeˉindex
            ) != Profile {
                return false;
            }
            Callableˉtypes = Callableˉtypes + 1u32;
        }
        Typeˉindex = Typeˉindex + 1u32;
    }

    var Referencesˉandˉcalls: u32 = 0u32;
    var Closures: u32 = 0u32;
    var Writeˉregions: u32 = 0u32;
    var Writeˉpointers: u32 = 0u32;
    var Foreignˉcalls: u32 = 0u32;
    var Previousˉopcode: u8 = 0u8;
    var Ownedˉmain: u32 = 4294967295u32;
    if Ownedˉcollections.Minorˉisˉsupported(Minor) {
        Ownedˉmain = Compilerˉnativeˉx64ˉownedˉmain(Input);
    }
    var Cursor: u32 = 0u32;
    while Cursor < Codeˉlength {
        let Opcode: u8 = Bytesˉreadˉu8(Input, Codeˉoffset + Cursor);
        let Opcodeˉnumber: u32 = U32ˉfromˉu8(Opcode);
        let Size: u32 = Compilerˉnativeˉx64ˉinstructionˉsize(Opcode);
        if Size == 0u32 || Size > Codeˉlength - Cursor { return false; }
        if Ownedˉcollections.Minorˉisˉsupported(Minor) {
            if !Ownedˉcollections.Opcodeˉisˉsupported(Opcode) ||
                (Opcode == 80u8 && Previousˉopcode != 205u8) { return false; }
            // The exported entry owns domain teardown and cannot be called as
            // a helper. Internal recursive helpers retain the common depth cap.
            if Opcode == 64u8 && Bytesˉreadˉu32ˉlittle(Input, Codeˉoffset + Cursor + 1u32) == Ownedˉmain { return false; }
        } else if Nominalˉtypes.Compilerˉnativeˉx64ˉsharedˉminor(Minor) {
            if Opcode == 109u8 || Opcode == 202u8 || Opcode == 207u8 ||
                Opcode == 208u8 || Opcode == 209u8 || (Opcodeˉnumber >= 210u32 && Opcodeˉnumber <= 224u32) ||
                Opcode == 226u8 || Opcode == 227u8 || Opcode == 228u8 { return false; }
        } else if Ownedˉcollections.Operationˉisˉsupported(Opcode) &&
            Opcode != 206u8 { return false; }
        Previousˉopcode = Opcode;
        if Opcode == 211u8 || Opcode == 212u8 {
            Referencesˉandˉcalls = Referencesˉandˉcalls + 1u32;
            if Referencesˉandˉcalls > 65536u32 { return false; }
        }
        if Opcode == 213u8 {
            Closures = Closures + 1u32;
            if Closures > 65536u32 { return false; }
        }
        if Opcode == 222u8 {
            Writeˉregions = Writeˉregions + 1u32;
            if Writeˉregions > 4096u32 { return false; }
        }
        if Opcode == 223u8 {
            Writeˉpointers = Writeˉpointers + 1u32;
            if Writeˉpointers > 4096u32 { return false; }
        }
        if Opcode == 224u8 {
            if Bytesˉreadˉu32ˉlittle(Input, Codeˉoffset + Cursor + 1u32) !=
                    1u32 {
                return false;
            }
            Foreignˉcalls = Foreignˉcalls + 1u32;
            if Foreignˉcalls > 4096u32 { return false; }
        }
        Cursor = Cursor + Size;
    }
    if Writeˉregions > 0u32 && Minor != 36u32 && Minor != 37u32 &&
        Minor != 38u32 {
        return false;
    }
    if Writeˉpointers > 0u32 && Minor != 37u32 && Minor != 38u32 {
        return false;
    }
    if Foreignˉcalls > 0u32 && Minor != 38u32 { return false; }
    if Minor == 11u32 || Minor == 16u32 || Ownedˉcollections.Minorˉisˉsupported(Minor) {
        return Callableˉtypes == 0u32 &&
            Referencesˉandˉcalls == 0u32 && Closures == 0u32;
    }
    if Nominalˉtypes.Compilerˉnativeˉx64ˉsharedˉminor(Minor) {
        return Profile == 1u8 && Referencesˉandˉcalls == 0u32 && Closures == 0u32 &&
            Writeˉregions == 0u32 && Writeˉpointers == 0u32 && Foreignˉcalls == 0u32;
    }
    if Minor == 33u32 || Minor == 34u32 || Minor == 35u32 || Minor == 39u32 {
        return true;
    }
    if Minor == 36u32 { return Writeˉregions > 0u32; }
    if Minor == 37u32 { return Writeˉpointers > 0u32; }
    if Minor == 38u32 { return Foreignˉcalls > 0u32; }
    if Callableˉtypes == 0u32 { return false; }
    if Minor == 30u32 {
        return Referencesˉandˉcalls > 0u32 && Closures == 0u32;
    }
    if Minor == 31u32 { return Closures > 0u32; }
    return false;
}

fn Compilerˉnativeˉx64ˉcallableˉcaptureˉtypeˉisˉsupported(
    Type: u8
) -> bool {
    if Compilerˉnativeˉx64ˉscalarˉtypeˉisˉsupported(Type) || Type == 8u8 { return true; }
    return Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉisˉenum(Type);
}

fn Compilerˉnativeˉx64ˉcallableˉtargetˉmatches(
    Input: bytes,
    Types: Nominalˉtypes.Compilerˉnativeˉx64ˉtypes,
    Callableˉtype: u32,
    Target: u32,
    Captures: u32,
    Callˉdirectory: bytes
) -> bool {
    if Callableˉtype >= Types.Count ||
        Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉkind(
            Types, Callableˉtype
        ) != 8u8 {
        return false;
    }
    let Publicˉparameters: u32 =
        Nominalˉtypes.Compilerˉnativeˉx64ˉcallableˉparameters(
            Types, Callableˉtype
        );
    let Physicalˉparameters: u32 =
        Layout.Compilerˉnativeˉx64ˉlayoutˉparameters(
            Callˉdirectory, Target
        );
    if Captures > 64u32 || Publicˉparameters > 64u32 - Captures ||
        Physicalˉparameters != Captures + Publicˉparameters {
        return false;
    }
    let Result: Nominalˉtypes.Compilerˉnativeˉx64ˉshape =
        Nominalˉtypes.Compilerˉnativeˉx64ˉcallableˉresult(
            Input, Types, Callableˉtype
        );
    if !Result.Valid || Result.Type !=
        Layout.Compilerˉnativeˉx64ˉlayoutˉreturnˉtype(
            Callˉdirectory, Target
        ) {
        return false;
    }
    var Capture: u32 = 0u32;
    while Capture < Captures {
        if !Compilerˉnativeˉx64ˉcallableˉcaptureˉtypeˉisˉsupported(
            Layout.Compilerˉnativeˉx64ˉlayoutˉparameterˉtype(
                Callˉdirectory, Target, Capture
            )
        ) {
            return false;
        }
        Capture = Capture + 1u32;
    }
    var Parameter: u32 = 0u32;
    while Parameter < Publicˉparameters {
        let Shape: Nominalˉtypes.Compilerˉnativeˉx64ˉshape =
            Nominalˉtypes.Compilerˉnativeˉx64ˉcallableˉparameter(
                Input, Types, Callableˉtype, Parameter
            );
        if !Shape.Valid || Shape.Type !=
            Layout.Compilerˉnativeˉx64ˉlayoutˉparameterˉtype(
                Callˉdirectory, Target, Captures + Parameter
            ) {
            return false;
        }
        Parameter = Parameter + 1u32;
    }
    return true;
}

fn Compilerˉnativeˉx64ˉcallableˉuniqueˉtarget(
    Input: bytes,
    Types: Nominalˉtypes.Compilerˉnativeˉx64ˉtypes,
    Callableˉtype: u32,
    Callableˉfunctions: u32,
    Callˉdirectory: bytes
) -> u32 {
    let Publicˉparameters: u32 =
        Nominalˉtypes.Compilerˉnativeˉx64ˉcallableˉparameters(
            Types, Callableˉtype
        );
    if Publicˉparameters > 64u32 { return 4294967295u32; }
    var Selected: u32 = 4294967295u32;
    var Target: u32 = 0u32;
    while Target < Callableˉfunctions {
        let Physicalˉparameters: u32 =
            Layout.Compilerˉnativeˉx64ˉlayoutˉparameters(
                Callˉdirectory, Target
            );
        if Physicalˉparameters >= Publicˉparameters {
            let Captures: u32 = Physicalˉparameters - Publicˉparameters;
            if Compilerˉnativeˉx64ˉcallableˉtargetˉmatches(
                Input, Types, Callableˉtype, Target, Captures,
                Callˉdirectory
            ) {
                if Selected != 4294967295u32 {
                    return 4294967295u32;
                }
                Selected = Target;
            }
        }
        Target = Target + 1u32;
    }
    return Selected;
}

fn Compilerˉnativeˉx64ˉfunctionˉusesˉprovider(
    Input: bytes,
    Section: Compilerˉnativeˉx64ˉsection,
    Capabilityˉtable: Nativeˉcapabilities.Compilerˉnativeˉx64ˉcapabilities
) -> bool {
    var Cursor: u32 = 0u32;
    while Cursor < Section.Payloadˉlength {
        let Opcode: u8 = Bytesˉreadˉu8(Input, Section.Payloadˉoffset + Cursor);
        if Opcode == 65u8 {
            let Capabilityˉindex: u32 = Bytesˉreadˉu32ˉlittle(
                Input,
                Section.Payloadˉoffset + Cursor + 1u32
            );
            let Kind: u8 = Nativeˉcapabilities.Compilerˉnativeˉx64ˉcapabilityˉkind(
                Capabilityˉtable,
                Capabilityˉindex
            );
            if Kind == Nativeˉcapabilities.Compilerˉnativeˉx64ˉstorageˉrandomˉaccessˉkind() ||
                Kind == Nativeˉcapabilities.Compilerˉnativeˉx64ˉdirectoryˉreadˉkind() ||
                Kind == Nativeˉcapabilities.Compilerˉnativeˉx64ˉmodelˉcatalogˉkind() ||
                Kind == Nativeˉcapabilities.Compilerˉnativeˉx64ˉmodelˉinferenceˉkind() ||
                Kind == Nativeˉcapabilities.Compilerˉnativeˉx64ˉstandardˉoutputˉwriteˉkind() {
                return true;
            }
        }
        let Size: u32 = Compilerˉnativeˉx64ˉinstructionˉsize(Opcode);
        if Size == 0u32 || Size > Section.Payloadˉlength - Cursor {
            return false;
        }
        Cursor = Cursor + Size;
    }
    return false;
}

fn Compilerˉnativeˉx64ˉinstructionˉmap(
    Input: bytes,
    Payloadˉoffset: u32,
    Length: u32
) -> bytes {
    var Result: bytes = Compilerˉnativeˉx64ˉempty(Input);
    var Chunk: bytes = Compilerˉnativeˉx64ˉempty(Input);
    var Cursor: u32 = 0u32;
    while Cursor < Length {
        let Opcode: u8 = Bytesˉreadˉu8(Input, Payloadˉoffset + Cursor);
        let Size: u32 = Compilerˉnativeˉx64ˉinstructionˉsize(Opcode);
        if Size == 0u32 || Size > Length - Cursor {
            return Compilerˉnativeˉx64ˉempty(Input);
        }
        var Marker: bytes = Bytesˉslice(
            Bytesˉfromˉu32ˉlittle(Size),
            0u32,
            1u32
        );
        if Size > 1u32 {
            Marker = Bytesˉconcat(
                Marker,
                Compilerˉnativeˉx64ˉzeroˉmap(Input, Size - 1u32)
            );
        }
        Chunk = Bytesˉconcat(Chunk, Marker);
        if Bytesˉlength(Chunk) >= 4096u32 {
            Result = Bytesˉconcat(Result, Chunk);
            Chunk = Compilerˉnativeˉx64ˉempty(Input);
        }
        Cursor = Cursor + Size;
    }
    return Bytesˉconcat(Result, Chunk);
}

export fn Compilerˉnativeˉx64ˉparameterˉbytes(
    Parameterˉtypes: bytes
) -> u32 {
    return Callˉarguments.Compilerˉnativeˉx64ˉcallˉparameterˉbytes(
        Parameterˉtypes
    );
}

fn Compilerˉnativeˉx64ˉentryˉparameterˉbytes(
    Function: Compilerˉnativeˉx64ˉfunction,
    Isˉmain: bool
) -> u32 {
    var Result: u32 = Compilerˉnativeˉx64ˉparameterˉbytes(
        Bytesˉslice(Function.Localˉtypes, 0u32, Function.Parameters)
    );
    if Isˉmain && Function.Parameters == 1u32 && !Function.Sharedˉvalues {
        Result = Result + 18u32;
    }
    if Function.Sharedˉvalues {
        var Parameter: u32 = 0u32;
        while Parameter < Function.Parameters {
            let Type: u8 = Bytesˉreadˉu8(Function.Localˉtypes, Parameter);
            if Type == 8u8 || (Type == 10u8 &&
                Bytesˉreadˉu32ˉlittle(Function.Localˉtypeˉidentities, Parameter * 4u32) == 25u32) {
                Result = Result + 12u32;
            }
            Parameter = Parameter + 1u32;
        }
    }
    return Result;
}

fn Compilerˉnativeˉx64ˉsharedˉdropˉbytes(Input: bytes,
    Types: Nominalˉtypes.Compilerˉnativeˉx64ˉtypes, Type: u8, Identity: u32) -> u32 {
    if Type == 0u8 { return 0u32; }
    if Sharedˉbytes.Localˉisˉshared(Type, Identity) { return Sharedˉbytes.Operationˉbytes(); }
    if Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉisˉrecord(Type) {
        let Shape: Sharedˉaggregates.Plan = Sharedˉaggregates.Build(Input, Types, Type, Identity);
        if !Shape.Valid { return 4294967295u32; }
        return Sharedˉaggregates.Bytes(Shape) + Sharedˉaggregates.Clearˉbytes(Shape.Width);
    }
    if Type == 7u8 || Compilerˉnativeˉx64ˉscalarˉtypeˉisˉsupported(Type) ||
        Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉisˉenum(Type) { return 18u32; }
    return 4294967295u32;
}
fn Compilerˉnativeˉx64ˉsharedˉdrop(Input: bytes, Initial: bytes,
    Types: Nominalˉtypes.Compilerˉnativeˉx64ˉtypes, Type: u8, Identity: u32,
    Slot: u32, Request: u32, Helper: u32, Codeˉbase: u32, Invalid: u32) -> bytes {
    if Type == 0u8 { return Initial; }
    if Sharedˉbytes.Localˉisˉshared(Type, Identity) {
        var Action: u32 = 1u32;
        if Type == 8u8 { Action = 7u32; }
        if Type == 10u8 { Action = 8u32; }
        return Sharedˉbytes.Emitˉoperation(Initial, Action, 4294967295u32, Slot,
            4294967295u32, 0u32, 0u8, 0u32, 0u8, Request, Helper, Codeˉbase, Invalid);
    }
    if Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉisˉrecord(Type) {
        let Shape: Sharedˉaggregates.Plan = Sharedˉaggregates.Build(Input, Types, Type, Identity);
        if !Shape.Valid { return Compilerˉnativeˉx64ˉempty(Input); }
        return Sharedˉaggregates.Clear(Sharedˉaggregates.Emit(Initial, Shape, Slot, false,
            Request, Helper, Codeˉbase, Invalid), Slot, Shape.Width);
    }
    return Sharedˉbytes.Emitˉclear(Initial, Slot);
}
fn Compilerˉnativeˉx64ˉsharedˉclearˉbytes(Input: bytes,
    Types: Nominalˉtypes.Compilerˉnativeˉx64ˉtypes, Type: u8) -> u32 {
    if Type == 0u8 { return 0u32; }
    if Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉisˉrecord(Type) {
        return Sharedˉaggregates.Clearˉbytes(Nominalˉtypes.Compilerˉnativeˉx64ˉrecordˉwidth(
            Input, Types, Nominalˉtypes.Compilerˉnativeˉx64ˉrecordˉtypeˉindex(Types, Type)));
    }
    return 18u32;
}
fn Compilerˉnativeˉx64ˉsharedˉclear(Input: bytes, Initial: bytes,
    Types: Nominalˉtypes.Compilerˉnativeˉx64ˉtypes, Type: u8, Slot: u32) -> bytes {
    if Type == 0u8 { return Initial; }
    if Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉisˉrecord(Type) {
        return Sharedˉaggregates.Clear(Initial, Slot,
            Nominalˉtypes.Compilerˉnativeˉx64ˉrecordˉwidth(Input, Types,
                Nominalˉtypes.Compilerˉnativeˉx64ˉrecordˉtypeˉindex(Types, Type)));
    }
    return Sharedˉbytes.Emitˉclear(Initial, Slot);
}
fn Compilerˉnativeˉx64ˉsharedˉfieldˉoffset(Input: bytes, Offset: u32,
    Opcode: u8, Types: Nominalˉtypes.Compilerˉnativeˉx64ˉtypes, Parent: u8) -> u32 {
    if Opcode == 105u8 {
        let Index: u32 = Bytesˉreadˉu32ˉlittle(Input, Offset + 1u32);
        let Type: u32 = Nominalˉtypes.Compilerˉnativeˉx64ˉrecordˉtypeˉindex(Types, Parent);
        let Field: Nominalˉtypes.Compilerˉnativeˉx64ˉshape =
            Nominalˉtypes.Compilerˉnativeˉx64ˉrecordˉfieldˉshape(Input, Types, Type, Index);
        if Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉisˉrecord(Field.Type) {
            return Nominalˉtypes.Compilerˉnativeˉx64ˉrecordˉfieldˉbackingˉoffset(Input, Types, Type, Index);
        }
        return Index;
    }
    if Opcode == 153u8 {
        let Payload: Nominalˉtypes.Compilerˉnativeˉx64ˉshape =
            Nominalˉtypes.Compilerˉnativeˉx64ˉvariantˉcaseˉpayload(Input, Types,
                Bytesˉreadˉu32ˉlittle(Input, Offset + 1u32), Bytesˉreadˉu32ˉlittle(Input, Offset + 5u32));
        if Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉisˉrecord(Payload.Type) { return 2u32; }
        return 1u32;
    }
    let Selection: u32 = Bytesˉreadˉu32ˉlittle(Input, Offset + 5u32);
    return Nominalˉtypes.Compilerˉnativeˉx64ˉvariantˉcaseˉfieldˉbackingˉoffset(Input, Types,
        Bytesˉreadˉu32ˉlittle(Input, Offset + 1u32), Selection / 64u32, Selection % 64u32);
}
fn Compilerˉnativeˉx64ˉsharedˉcreationˉoperands(Input: bytes, Offset: u32,
    Opcode: u8, Types: Nominalˉtypes.Compilerˉnativeˉx64ˉtypes) -> u32 {
    let Type: u32 = Bytesˉreadˉu32ˉlittle(Input, Offset + 1u32);
    if Opcode == 104u8 { return Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉitemˉcount(Types, Type); }
    let Case: u32 = Bytesˉreadˉu32ˉlittle(Input, Offset + 5u32);
    var Count: u32 = 0u32;
    var Present: bool = true;
    while Count < 64u32 && Present {
        let Field: Nominalˉtypes.Compilerˉnativeˉx64ˉshape =
            Nominalˉtypes.Compilerˉnativeˉx64ˉvariantˉcaseˉfield(Input, Types, Type, Case, Count);
        Present = Field.Valid;
        if Present { Count = Count + 1u32; }
    }
    return Count;
}
fn Compilerˉnativeˉx64ˉsharedˉtransitionˉbytes(Input: bytes, Offset: u32,
    Opcode: u8, Function: Compilerˉnativeˉx64ˉfunction,
    Types: Nominalˉtypes.Compilerˉnativeˉx64ˉtypes, Before: bytes, After: bytes) -> u32 {
    var Cost: u32 = 0u32;
    if Opcode == 4u8 || Opcode == 205u8 || Opcode == 225u8 {
        let Local: u32 = Bytesˉreadˉu32ˉlittle(Input, Offset + 1u32);
        var Type: u8 = Bytesˉreadˉu8(Function.Localˉtypes, Local);
        if Opcode == 225u8 { Type = Bytesˉreadˉu8(After, Bytesˉlength(After) - 1u32); }
        if Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉisˉrecord(Type) {
            if Opcode == 205u8 { return Compilerˉnativeˉx64ˉsharedˉclearˉbytes(Input, Types, Type); }
            let Shape: Sharedˉaggregates.Plan = Sharedˉaggregates.Build(Input, Types, Type, 0u32);
            if !Shape.Valid { return 4294967295u32; }
            return Sharedˉaggregates.Bytes(Shape);
        }
    }
    if Opcode == 5u8 {
        let Storeˉlocal: u32 = Bytesˉreadˉu32ˉlittle(Input, Offset + 1u32);
        let Storeˉtype: u8 = Bytesˉreadˉu8(Function.Localˉtypes, Storeˉlocal);
        if Storeˉtype == 7u8 { return 18u32; }
        if Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉisˉrecord(Storeˉtype) {
            let Drop: u32 = Compilerˉnativeˉx64ˉsharedˉdropˉbytes(Input, Types, Storeˉtype,
                Bytesˉreadˉu32ˉlittle(Function.Localˉtypeˉidentities, Storeˉlocal * 4u32));
            if Drop == 4294967295u32 { return Drop; }
            return Drop + Compilerˉnativeˉx64ˉsharedˉclearˉbytes(Input, Types, Storeˉtype);
        }
    }
    if Opcode == 104u8 || Opcode == 151u8 {
        let Count: u32 = Compilerˉnativeˉx64ˉsharedˉcreationˉoperands(Input, Offset, Opcode, Types);
        var Field: u32 = 0u32;
        while Field < Count {
            Cost = Cost + Compilerˉnativeˉx64ˉsharedˉclearˉbytes(Input, Types,
                Bytesˉreadˉu8(Before, Bytesˉlength(Before) - Count + Field));
            Field = Field + 1u32;
        }
    }
    if Opcode == 105u8 || Opcode == 153u8 || Opcode == 196u8 || Opcode == 152u8 {
        let Parent: u8 = Bytesˉreadˉu8(Before, Bytesˉlength(Before) - 1u32);
        Cost = Compilerˉnativeˉx64ˉsharedˉdropˉbytes(Input, Types, Parent, 0u32);
        if Cost == 4294967295u32 { return Cost; }
        if Opcode != 152u8 {
            let Selectedˉtype: u8 = Bytesˉreadˉu8(After, Bytesˉlength(After) - 1u32);
            var Width: u32 = 1u32;
            if Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉisˉrecord(Selectedˉtype) {
                Width = Nominalˉtypes.Compilerˉnativeˉx64ˉrecordˉwidth(Input, Types,
                    Nominalˉtypes.Compilerˉnativeˉx64ˉrecordˉtypeˉindex(Types, Selectedˉtype));
            }
            Cost = Cost + Sharedˉaggregates.Clearˉrangeˉbytes(Width);
        }
    }
    return Cost;
}
fn Compilerˉnativeˉx64ˉsharedˉtransition(Input: bytes, Initial: bytes, Offset: u32,
    Opcode: u8, Function: Compilerˉnativeˉx64ˉfunction,
    Types: Nominalˉtypes.Compilerˉnativeˉx64ˉtypes, Before: bytes, Beforeˉslots: bytes,
    After: bytes, Afterˉslots: bytes, Request: u32, Helper: u32, Codeˉbase: u32, Invalid: u32) -> bytes {
    var Output: bytes = Initial;
    if Opcode == 4u8 || Opcode == 205u8 || Opcode == 225u8 {
        let Local: u32 = Bytesˉreadˉu32ˉlittle(Input, Offset + 1u32);
        let Type: u8 = Bytesˉreadˉu8(After, Bytesˉlength(After) - 1u32);
        if Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉisˉrecord(Type) {
            if Opcode == 205u8 { return Compilerˉnativeˉx64ˉsharedˉclear(Input, Output, Types, Type, Local); }
            return Sharedˉaggregates.Emit(Output, Sharedˉaggregates.Build(Input, Types, Type, 0u32),
                Bytesˉreadˉu32ˉlittle(Afterˉslots, (Bytesˉlength(After) - 1u32) * 4u32), true,
                Request, Helper, Codeˉbase, Invalid);
        }
    }
    if Opcode == 5u8 {
        let Storedˉtype: u8 = Bytesˉreadˉu8(Before, Bytesˉlength(Before) - 1u32);
        // Slice temporaries share physical slots with bytes. A consumed loan
        // must leave an empty cell before that slot can hold an owning value.
        if Storedˉtype == 7u8 || Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉisˉrecord(Storedˉtype) {
            return Compilerˉnativeˉx64ˉsharedˉclear(Input, Output, Types, Storedˉtype,
                Bytesˉreadˉu32ˉlittle(Beforeˉslots, (Bytesˉlength(Before) - 1u32) * 4u32));
        }
    }
    if Opcode == 104u8 || Opcode == 151u8 {
        let Count: u32 = Compilerˉnativeˉx64ˉsharedˉcreationˉoperands(Input, Offset, Opcode, Types);
        var Field: u32 = 0u32;
        while Field < Count {
            let Position: u32 = Bytesˉlength(Before) - Count + Field;
            Output = Compilerˉnativeˉx64ˉsharedˉclear(Input, Output, Types, Bytesˉreadˉu8(Before, Position),
                Bytesˉreadˉu32ˉlittle(Beforeˉslots, Position * 4u32));
            Field = Field + 1u32;
        }
    }
    if Opcode == 105u8 || Opcode == 153u8 || Opcode == 196u8 || Opcode == 152u8 {
        let Parent: u8 = Bytesˉreadˉu8(Before, Bytesˉlength(Before) - 1u32);
        let Parentˉslot: u32 = Bytesˉreadˉu32ˉlittle(Beforeˉslots, (Bytesˉlength(Before) - 1u32) * 4u32);
        if Opcode != 152u8 {
            let Selectedˉtype: u8 = Bytesˉreadˉu8(After, Bytesˉlength(After) - 1u32);
            var Width: u32 = 1u32;
            if Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉisˉrecord(Selectedˉtype) {
                Width = Nominalˉtypes.Compilerˉnativeˉx64ˉrecordˉwidth(Input, Types,
                    Nominalˉtypes.Compilerˉnativeˉx64ˉrecordˉtypeˉindex(Types, Selectedˉtype));
            }
            Output = Sharedˉaggregates.Clearˉrange(Output, Parentˉslot,
                Compilerˉnativeˉx64ˉsharedˉfieldˉoffset(Input, Offset, Opcode, Types, Parent), Width);
        }
        return Compilerˉnativeˉx64ˉsharedˉdrop(Input, Output, Types, Parent, 0u32,
            Parentˉslot, Request, Helper, Codeˉbase, Invalid);
    }
    return Output;
}

fn Compilerˉnativeˉx64ˉsharedˉlocalˉisˉowned(Function: Compilerˉnativeˉx64ˉfunction, Local: u32) -> bool {
    if Local < Function.Parameters && Bytesˉreadˉu8(Function.Localˉborrowˉkinds, Local) != 0u8 { return false; }
    let Type: u8 = Bytesˉreadˉu8(Function.Localˉtypes, Local);
    return Sharedˉbytes.Localˉisˉshared(Type,
        Bytesˉreadˉu32ˉlittle(Function.Localˉtypeˉidentities, Local * 4u32)) ||
        Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉisˉrecord(Type);
}
fn Compilerˉnativeˉx64ˉsharedˉlocalsˉdropˉbytes(Input: bytes,
    Function: Compilerˉnativeˉx64ˉfunction, Types: Nominalˉtypes.Compilerˉnativeˉx64ˉtypes) -> u32 {
    var Cost: u32 = 0u32;
    var Local: u32 = Function.Locals;
    while Local > 0u32 {
        Local = Local - 1u32;
        if Compilerˉnativeˉx64ˉsharedˉlocalˉisˉowned(Function, Local) {
            let Drop: u32 = Compilerˉnativeˉx64ˉsharedˉdropˉbytes(Input, Types,
                Bytesˉreadˉu8(Function.Localˉtypes, Local),
                Bytesˉreadˉu32ˉlittle(Function.Localˉtypeˉidentities, Local * 4u32));
            if Drop == 4294967295u32 { return Drop; }
            Cost = Cost + Drop;
        }
    }
    return Cost;
}
fn Compilerˉnativeˉx64ˉsharedˉlocalsˉdropˉrange(Input: bytes,
    Function: Compilerˉnativeˉx64ˉfunction, Types: Nominalˉtypes.Compilerˉnativeˉx64ˉtypes,
    First: u32, Limit: u32,
    Request: u32, Helper: u32, Codeˉbase: u32, Invalid: u32) -> bytes {
    // Balanced groups preserve reverse-local order while bounding temporary
    // concatenation. At most 2048 locals require eight splits above each leaf.
    if Limit - First > 8u32 {
        let Middle: u32 = First + (Limit - First) / 2u32;
        let High: bytes = Compilerˉnativeˉx64ˉsharedˉlocalsˉdropˉrange(Input, Function, Types,
            Middle, Limit, Request, Helper, Codeˉbase, Invalid);
        let Low: bytes = Compilerˉnativeˉx64ˉsharedˉlocalsˉdropˉrange(Input, Function, Types,
            First, Middle, Request, Helper, Codeˉbase + Bytesˉlength(High),
            Compilerˉnativeˉx64ˉrelativeˉu32(Invalid, Bytesˉlength(High)));
        if Bytesˉlength(High) == 0u32 { return Low; }
        if Bytesˉlength(Low) == 0u32 { return High; }
        return Bytesˉconcat(High, Low);
    }
    var Output: bytes = Compilerˉnativeˉx64ˉempty(Input);
    var Local: u32 = Limit;
    while Local > First {
        Local = Local - 1u32;
        if Compilerˉnativeˉx64ˉsharedˉlocalˉisˉowned(Function, Local) {
            Output = Compilerˉnativeˉx64ˉsharedˉdrop(Input, Output, Types,
                Bytesˉreadˉu8(Function.Localˉtypes, Local),
                Bytesˉreadˉu32ˉlittle(Function.Localˉtypeˉidentities, Local * 4u32), Local,
                Request, Helper, Codeˉbase, Invalid);
        }
    }
    return Output;
}
fn Compilerˉnativeˉx64ˉsharedˉlocalsˉdrop(Input: bytes, Initial: bytes,
    Function: Compilerˉnativeˉx64ˉfunction, Types: Nominalˉtypes.Compilerˉnativeˉx64ˉtypes,
    Request: u32, Helper: u32, Codeˉbase: u32, Invalid: u32) -> bytes {
    let Prefix: u32 = Bytesˉlength(Initial);
    let Output: bytes = Compilerˉnativeˉx64ˉsharedˉlocalsˉdropˉrange(Input, Function, Types,
        0u32, Function.Locals, Request, Helper, Codeˉbase + Prefix,
        Compilerˉnativeˉx64ˉrelativeˉu32(Invalid, Prefix));
    if Bytesˉlength(Output) == 0u32 { return Initial; }
    return Bytesˉconcat(Initial, Output);
}
fn Compilerˉnativeˉx64ˉsharedˉcleanupˉbytes(Input: bytes,
    Function: Compilerˉnativeˉx64ˉfunction, Types: Nominalˉtypes.Compilerˉnativeˉx64ˉtypes,
    Liveness: Sharedˉlocalˉliveness.Plan, Instruction: u32, Offset: u32, Opcode: u8,
    Successor: u32) -> u32 {
    if Opcode == 81u8 { return 0u32; }
    var Cost: u32 = 0u32;
    var Stored: u32 = 4294967295u32;
    if Opcode == 5u8 { Stored = Bytesˉreadˉu32ˉlittle(Input, Offset + 1u32); }
    var Group: u32 = (Function.Locals + 31u32) / 32u32;
    while Group > 0u32 {
        Group = Group - 1u32;
        let First: u32 = Group * 32u32;
        var Mask: u32 = 0u32;
        if Successor == 4294967295u32 {
            Mask = Sharedˉlocalˉliveness.Endingˉmask(Liveness, Instruction, First, Stored);
        } else {
            Mask = Sharedˉlocalˉliveness.Edgeˉendingˉmask(Liveness, Instruction, Successor, First);
        }
        if Mask != 0u32 {
            var Local: u32 = First + 32u32;
            if Local > Function.Locals { Local = Function.Locals; }
            while Local > First {
                Local = Local - 1u32;
                if (Mask & (1u32 << (Local - First))) != 0u32 &&
                    Compilerˉnativeˉx64ˉsharedˉlocalˉisˉowned(Function, Local) {
                    let Drop: u32 = Compilerˉnativeˉx64ˉsharedˉdropˉbytes(Input, Types,
                        Bytesˉreadˉu8(Function.Localˉtypes, Local),
                        Bytesˉreadˉu32ˉlittle(Function.Localˉtypeˉidentities, Local * 4u32));
                    if Drop == 4294967295u32 || Drop > 67108864u32 - Cost { return 4294967295u32; }
                    Cost = Cost + Drop;
                }
            }
        }
    }
    return Cost;
}
fn Compilerˉnativeˉx64ˉsharedˉcleanup(Input: bytes, Initial: bytes,
    Function: Compilerˉnativeˉx64ˉfunction, Types: Nominalˉtypes.Compilerˉnativeˉx64ˉtypes,
    Liveness: Sharedˉlocalˉliveness.Plan, Instruction: u32, Offset: u32, Opcode: u8,
    Successor: u32, Request: u32, Helper: u32, Codeˉbase: u32, Invalid: u32) -> bytes {
    if Opcode == 81u8 { return Initial; }
    let Prefix: u32 = Bytesˉlength(Initial);
    let Fragmentˉinvalid: u32 = Compilerˉnativeˉx64ˉrelativeˉu32(Invalid, Prefix);
    var Output: bytes = Compilerˉnativeˉx64ˉempty(Initial);
    var Stored: u32 = 4294967295u32;
    if Opcode == 5u8 { Stored = Bytesˉreadˉu32ˉlittle(Input, Offset + 1u32); }
    var Group: u32 = (Function.Locals + 31u32) / 32u32;
    while Group > 0u32 {
        Group = Group - 1u32;
        let First: u32 = Group * 32u32;
        var Mask: u32 = 0u32;
        if Successor == 4294967295u32 {
            Mask = Sharedˉlocalˉliveness.Endingˉmask(Liveness, Instruction, First, Stored);
        } else {
            Mask = Sharedˉlocalˉliveness.Edgeˉendingˉmask(Liveness, Instruction, Successor, First);
        }
        if Mask != 0u32 {
            var Local: u32 = First + 32u32;
            if Local > Function.Locals { Local = Function.Locals; }
            while Local > First {
                Local = Local - 1u32;
                if (Mask & (1u32 << (Local - First))) != 0u32 &&
                    Compilerˉnativeˉx64ˉsharedˉlocalˉisˉowned(Function, Local) {
                    Output = Compilerˉnativeˉx64ˉsharedˉdrop(Input, Output, Types,
                        Bytesˉreadˉu8(Function.Localˉtypes, Local),
                        Bytesˉreadˉu32ˉlittle(Function.Localˉtypeˉidentities, Local * 4u32), Local,
                        Request, Helper, Codeˉbase + Prefix, Fragmentˉinvalid);
                }
            }
        }
    }
    if Bytesˉlength(Output) == 0u32 { return Initial; }
    return Bytesˉconcat(Initial, Output);
}
fn Compilerˉnativeˉx64ˉsharedˉvirtualˉrootsˉmatch(Dependencies: bytes, Locals: u32,
    Offset: u32, Before: bytes, After: bytes) -> bool {
    if Bytesˉlength(Dependencies) % 12u32 != 0u32 { return false; }
    var First: u32 = 0u32;
    var Limit: u32 = Bytesˉlength(Dependencies) / 12u32;
    while First < Limit {
        let Middle: u32 = First + (Limit - First) / 2u32;
        if Bytesˉreadˉu32ˉlittle(Dependencies, Middle * 12u32) < Offset { First = Middle + 1u32; }
        else { Limit = Middle; }
    }
    while First < Bytesˉlength(Dependencies) / 12u32 &&
        Bytesˉreadˉu32ˉlittle(Dependencies, First * 12u32) == Offset {
        let Borrowed: u32 = Bytesˉreadˉu32ˉlittle(Dependencies, First * 12u32 + 4u32);
        let Owner: u32 = Bytesˉreadˉu32ˉlittle(Dependencies, First * 12u32 + 8u32);
        if Borrowed < Locals || Owner >= Locals { return false; }
        let Position: u32 = Borrowed - Locals;
        // E1 virtual cells are logical operand positions at this event, never
        // local indices. Creation is after-transfer; a read is before-transfer.
        if Position >= Bytesˉlength(Before) && Position >= Bytesˉlength(After) { return false; }
        First = First + 1u32;
    }
    return true;
}

fn Compilerˉnativeˉx64ˉsharedˉreturnˉbytes(Input: bytes,
    Function: Compilerˉnativeˉx64ˉfunction, Types: Nominalˉtypes.Compilerˉnativeˉx64ˉtypes) -> u32 {
    // Every return stages its result and jumps to one function cleanup tail.
    // The ten-byte instruction charge is included; the shared tail is not.
    let Type: u8 = Function.Returnˉtype;
    if Type == 0u8 { return 15u32; }
    if Type == 3u8 || Type == 6u8 {
        return 15u32 + Sharedˉbytes.Operationˉbytes() + 6u32;
    }
    if Type == 7u8 { return 15u32 + 38u32 + 18u32; }
    if Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉisˉrecord(Type) {
        let Width: u32 = Nominalˉtypes.Compilerˉnativeˉx64ˉrecordˉwidth(Input, Types,
            Nominalˉtypes.Compilerˉnativeˉx64ˉrecordˉtypeˉindex(Types, Type));
        return 15u32 + Records.Compilerˉnativeˉx64ˉsharedˉrecordˉresultˉbytes(Width) +
            Sharedˉaggregates.Clearˉbytes(Width);
    }
    if Type == 8u8 || Type == 9u8 || Type == 10u8 {
        var Stage: u32 = 34u32;
        if Type == 8u8 || Function.Returnˉidentity == 25u32 { Stage = Sharedˉbytes.Operationˉbytes(); }
        return 15u32 + Stage;
    }
    return 29u32;
}
fn Compilerˉnativeˉx64ˉsharedˉreturnˉtailˉbytes(Input: bytes,
    Function: Compilerˉnativeˉx64ˉfunction, Types: Nominalˉtypes.Compilerˉnativeˉx64ˉtypes,
    Isˉmain: bool) -> u32 {
    let Cleanup: u32 = Compilerˉnativeˉx64ˉsharedˉlocalsˉdropˉbytes(Input, Function, Types);
    if Cleanup == 4294967295u32 { return Cleanup; }
    var Restore: u32 = 11u32;
    if Isˉmain { Restore = 13u32; }
    let Type: u8 = Function.Returnˉtype;
    if Type == 8u8 || Type == 9u8 || Type == 10u8 { return Cleanup + Restore + 28u32; }
    if Type == 0u8 || Type == 3u8 || Type == 6u8 || Type == 7u8 ||
        Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉisˉrecord(Type) { return Cleanup + Restore + 2u32; }
    return Cleanup + Restore + 7u32;
}
fn Compilerˉnativeˉx64ˉemitˉsharedˉreturn(Input: bytes, Initial: bytes,
    Function: Compilerˉnativeˉx64ˉfunction, Analysis: Compilerˉnativeˉx64ˉcontrolˉanalysis,
    Types: Nominalˉtypes.Compilerˉnativeˉx64ˉtypes, Source: u32, Hidden: u32,
    Tail: u32, Request: u32, Helper: u32, Codeˉbase: u32, Invalid: u32) -> bytes {
    var Output: bytes = Initial;
    let Type: u8 = Function.Returnˉtype;
    let Stage: u32 = Compilerˉnativeˉx64ˉsharedˉreturnˉslot(Function, Analysis);
    if Type == 3u8 || Type == 6u8 {
        Output = Sharedˉbytes.Emitˉtransfer(Output, 3u32, Hidden, Source, true,
            Request, Helper, Codeˉbase, Invalid);
    } else if Type == 7u8 {
        Output = Compilerˉnativeˉx64ˉemitˉloadˉrdx(Output, Hidden * 16u32);
        var Part: u32 = 0u32;
        while Part < 2u32 {
            Output = Compilerˉnativeˉx64ˉemitˉloadˉrax(Output, Source * 16u32 + Part * 8u32);
            Output = Compilerˉnativeˉx64ˉappendˉu32(Bytesˉconcat(Output,
                Bytesˉconcat(Bytesˉfromˉu16ˉlittle(35144u32), Bytesˉfromˉu8(130u8))), Part * 8u32);
            Part = Part + 1u32;
        }
        Output = Sharedˉbytes.Emitˉclear(Output, Source);
    } else if Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉisˉrecord(Type) {
        let Index: u32 = Nominalˉtypes.Compilerˉnativeˉx64ˉrecordˉtypeˉindex(Types, Type);
        let Width: u32 = Nominalˉtypes.Compilerˉnativeˉx64ˉrecordˉwidth(Input, Types, Index);
        Output = Records.Compilerˉnativeˉx64ˉemitˉsharedˉrecordˉresult(Output, Index, Width, Source, Hidden);
        Output = Sharedˉaggregates.Clear(Output, Source, Width);
    } else if Type == 8u8 || Type == 9u8 || Type == 10u8 {
        if Type == 8u8 || Function.Returnˉidentity == 25u32 {
            var Action: u32 = 9u32;
            if Type == 10u8 { Action = 17u32; }
            Output = Sharedˉbytes.Emitˉtransfer(Output, Action, Stage, Source, false,
                Request, Helper, Codeˉbase, Invalid);
        } else {
            Output = Compilerˉnativeˉx64ˉemitˉloadˉrax(Output, Source * 16u32);
            Output = Compilerˉnativeˉx64ˉemitˉstoreˉrax(Output, Stage * 16u32);
            Output = Sharedˉbytes.Emitˉclear(Output, Source);
        }
    } else if Type != 0u8 {
        Output = Compilerˉnativeˉx64ˉemitˉstoreˉeax(
            Compilerˉnativeˉx64ˉemitˉloadˉeax(Output, Source * 16u32), Stage * 16u32);
    }
    return Compilerˉnativeˉx64ˉemitˉjump(Output, Tail);
}
fn Compilerˉnativeˉx64ˉemitˉsharedˉreturnˉtail(Input: bytes, Initial: bytes,
    Function: Compilerˉnativeˉx64ˉfunction, Analysis: Compilerˉnativeˉx64ˉcontrolˉanalysis,
    Types: Nominalˉtypes.Compilerˉnativeˉx64ˉtypes,
    Frame: u32, Isˉmain: bool, Request: u32, Helper: u32, Codeˉbase: u32, Invalid: u32) -> bytes {
    let Type: u8 = Function.Returnˉtype;
    let Stage: u32 = Compilerˉnativeˉx64ˉsharedˉreturnˉslot(Function, Analysis);
    var Output: bytes = Compilerˉnativeˉx64ˉsharedˉlocalsˉdrop(Input, Initial, Function, Types,
        Request, Helper, Codeˉbase, Invalid);
    if Type == 8u8 || Type == 9u8 || Type == 10u8 {
        Output = Compilerˉnativeˉx64ˉemitˉloadˉrax(Output, Stage * 16u32);
        Output = Sharedˉbytes.Emitˉclearˉpreserveˉrax(Output, Stage);
        Output = Bytesˉconcat(Output, Bytesˉfromˉu16ˉlittle(53809u32));
    } else if Type == 0u8 || Type == 3u8 || Type == 6u8 || Type == 7u8 ||
        Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉisˉrecord(Type) {
        Output = Bytesˉconcat(Output, Bytesˉfromˉu16ˉlittle(49201u32));
    } else {
        Output = Compilerˉnativeˉx64ˉemitˉloadˉeax(Output, Stage * 16u32);
    }
    return Compilerˉnativeˉx64ˉemitˉrestoreˉfor(
        Compilerˉnativeˉx64ˉemitˉframe(Output, false, Frame), Isˉmain);
}

fn Compilerˉnativeˉx64ˉinstructionˉproduces(Opcode: u8, Returnˉtype: u8) -> bool {
    if Opcode == 5u8 || Opcode == 48u8 || Opcode == 49u8 || Opcode == 80u8 || Opcode == 81u8 { return false; }
    if Opcode == 64u8 && Returnˉtype == 0u8 { return false; }
    return true;
}
fn Compilerˉnativeˉx64ˉinstructionˉidentity(Input: bytes, Offset: u32,
    Opcode: u8, Function: Compilerˉnativeˉx64ˉfunction,
    Types: Nominalˉtypes.Compilerˉnativeˉx64ˉtypes, Beforeˉstack: bytes) -> u32 {
    if Opcode == 4u8 || Opcode == 205u8 {
        return Bytesˉreadˉu32ˉlittle(Function.Localˉtypeˉidentities,
            Bytesˉreadˉu32ˉlittle(Input, Offset + 1u32) * 4u32);
    }
    if Opcode == 105u8 {
        let Parent: u8 = Bytesˉreadˉu8(Beforeˉstack, Bytesˉlength(Beforeˉstack) - 1u32);
        let Field: Nominalˉtypes.Compilerˉnativeˉx64ˉshape =
            Nominalˉtypes.Compilerˉnativeˉx64ˉrecordˉfieldˉshape(Input, Types,
                Nominalˉtypes.Compilerˉnativeˉx64ˉrecordˉtypeˉindex(Types, Parent),
                Bytesˉreadˉu32ˉlittle(Input, Offset + 1u32));
        return Field.Identity;
    }
    if Opcode == 153u8 {
        let Payload: Nominalˉtypes.Compilerˉnativeˉx64ˉshape =
            Nominalˉtypes.Compilerˉnativeˉx64ˉvariantˉcaseˉpayload(Input, Types,
                Bytesˉreadˉu32ˉlittle(Input, Offset + 1u32),
                Bytesˉreadˉu32ˉlittle(Input, Offset + 5u32));
        return Payload.Identity;
    }
    if Opcode == 196u8 {
        let Selection: u32 = Bytesˉreadˉu32ˉlittle(Input, Offset + 5u32);
        let Variantˉfield: Nominalˉtypes.Compilerˉnativeˉx64ˉshape =
            Nominalˉtypes.Compilerˉnativeˉx64ˉvariantˉcaseˉfield(Input, Types,
                Bytesˉreadˉu32ˉlittle(Input, Offset + 1u32), Selection / 64u32, Selection % 64u32);
        return Variantˉfield.Identity;
    }
    if Opcode == 64u8 {
        let Callee: Compilerˉnativeˉx64ˉfunction = Compilerˉnativeˉx64ˉcalleeˉread(
            Input, Function, Bytesˉreadˉu32ˉlittle(Input, Offset + 1u32), Types);
        if !Callee.Valid { return 4294967294u32; }
        return Callee.Returnˉidentity;
    }
    if Opcode == 239u8 { return 40u32; }
    return 4294967295u32;
}

fn Compilerˉnativeˉx64ˉanalyzeˉnominalˉvalueˉinstruction(
    Input: bytes,
    Instructionˉoffset: u32,
    Opcode: u8,
    State: bytes,
    Isˉmain: bool,
    Types: Nominalˉtypes.Compilerˉnativeˉx64ˉtypes,
    Localˉtypes: bytes,
    Localˉtypeˉidentities: bytes,
    Localˉborrowˉkinds: bytes,
    Stackˉidentities: bytes,
    Capabilityˉtable: Nativeˉcapabilities.Compilerˉnativeˉx64ˉcapabilities
) -> bytes {
    var Stack: bytes = Compilerˉnativeˉx64ˉblockˉvalueˉstateˉstack(State);
    var Depth: u32 = Bytesˉreadˉu32ˉlittle(State, 1u32);
    var I32ˉvalues: u32 = Bytesˉreadˉu32ˉlittle(State, 5u32);
    var Boolˉvalues: u32 = Bytesˉreadˉu32ˉlittle(State, 9u32);
    var Textˉvalues: u32 = Bytesˉreadˉu32ˉlittle(State, 13u32);
    var U8ˉvalues: u32 = Bytesˉreadˉu32ˉlittle(State, 17u32);
    var U32ˉvalues: u32 = Bytesˉreadˉu32ˉlittle(State, 21u32);
    var Bytesˉvalues: u32 = Bytesˉreadˉu32ˉlittle(State, 25u32);
    var Enumˉvalues: u32 = Bytesˉreadˉu32ˉlittle(State, 29u32);
    var Recordˉvalues: u32 = Bytesˉreadˉu32ˉlittle(State, 33u32);
    var Bodyˉbytes: u32 = Bytesˉreadˉu32ˉlittle(State, 37u32);
    if Nominalˉtypes.Compilerˉnativeˉx64ˉsharedˉminor(Bytesˉreadˉu16ˉlittle(Input, 6u32)) && Opcode == 80u8 {
        if Depth == 0u32 || Bytesˉlength(Stackˉidentities) != Depth * 4u32 {
            return Compilerˉnativeˉx64ˉinvalidˉblockˉvalueˉstate(Input);
        }
        let Type: u8 = Bytesˉreadˉu8(Stack, Depth - 1u32);
        let Identity: u32 = Bytesˉreadˉu32ˉlittle(Stackˉidentities, (Depth - 1u32) * 4u32);
        let Cleanup: u32 = Compilerˉnativeˉx64ˉsharedˉdropˉbytes(Input, Types, Type, Identity);
        if Cleanup == 4294967295u32 { return Compilerˉnativeˉx64ˉinvalidˉblockˉvalueˉstate(Input); }
        return Compilerˉnativeˉx64ˉblockˉvalueˉstate(Bytesˉslice(Stack, 0u32, Depth - 1u32),
            Depth - 1u32, I32ˉvalues, Boolˉvalues, Textˉvalues, U8ˉvalues,
            U32ˉvalues, Bytesˉvalues, Enumˉvalues, Recordˉvalues, Bodyˉbytes + 10u32 + Cleanup);
    }
    if Sharedˉbytes.Operationˉisˉsupported(Opcode) ||
        (Nominalˉtypes.Compilerˉnativeˉx64ˉsharedˉminor(Bytesˉreadˉu16ˉlittle(Input, 6u32)) && Sharedˉbytes.Budgetˉisˉsupported(Opcode)) {
        let Byteˉoperation: Sharedˉbytes.Analysis = Sharedˉbytes.Analyze(
            Input, Instructionˉoffset, Opcode, Localˉtypes,
            Localˉtypeˉidentities, Localˉborrowˉkinds, Types, Stack, Depth,
            U8ˉvalues, U32ˉvalues, Bytesˉvalues, Recordˉvalues, Bodyˉbytes);
        if !Byteˉoperation.Valid {
            return Compilerˉnativeˉx64ˉinvalidˉblockˉvalueˉstate(Input);
        }
        Stack = Byteˉoperation.Stack;
        Depth = Byteˉoperation.Depth;
        U8ˉvalues = Byteˉoperation.U8ˉvalues;
        U32ˉvalues = Byteˉoperation.U32ˉvalues;
        Bytesˉvalues = Byteˉoperation.Bytesˉvalues;
        Recordˉvalues = Byteˉoperation.Recordˉvalues;
        Bodyˉbytes = Byteˉoperation.Bodyˉbytes;
        return Compilerˉnativeˉx64ˉblockˉvalueˉstate(Stack, Depth, I32ˉvalues,
            Boolˉvalues, Textˉvalues, U8ˉvalues, U32ˉvalues, Bytesˉvalues,
            Enumˉvalues, Recordˉvalues, Bodyˉbytes);
    }
    if Opcode == 65u8 {
        let Capabilityˉindex: u32 = Bytesˉreadˉu32ˉlittle(
            Input,
            Instructionˉoffset + 1u32
        );
        let Capabilityˉkind: u8 =
            Nativeˉcapabilities.Compilerˉnativeˉx64ˉcapabilityˉkind(
                Capabilityˉtable,
                Capabilityˉindex
            );
        let Capabilityˉanalysis:
            Nativeˉcapabilities.Compilerˉnativeˉx64ˉcapabilityˉanalysis =
            Nativeˉcapabilities.Compilerˉnativeˉx64ˉanalyzeˉcapability(
                Capabilityˉkind,
                Stack,
                Depth,
                Textˉvalues,
                U32ˉvalues,
                Bytesˉvalues,
                Bodyˉbytes
            );
        if !Capabilityˉanalysis.Valid {
            return Compilerˉnativeˉx64ˉinvalidˉblockˉvalueˉstate(Input);
        }
        Stack = Capabilityˉanalysis.Stack;
        Depth = Capabilityˉanalysis.Depth;
        Textˉvalues = Capabilityˉanalysis.Textˉvalues;
        U32ˉvalues = Capabilityˉanalysis.U32ˉvalues;
        Bytesˉvalues = Capabilityˉanalysis.Bytesˉvalues;
        Bodyˉbytes = Capabilityˉanalysis.Bodyˉbytes;
    }
    if Opcode == 161u8 || Opcode == 162u8 ||
        Opcode == 165u8 || Opcode == 166u8 {
        var Divisionˉtype: u8 = 5u8;
        if Opcode == 165u8 || Opcode == 166u8 { Divisionˉtype = 10u8; }
        if Depth < 2u32 {
            return Compilerˉnativeˉx64ˉinvalidˉblockˉvalueˉstate(Input);
        }
        if Bytesˉreadˉu8(Stack, Depth - 1u32) != Divisionˉtype ||
            Bytesˉreadˉu8(Stack, Depth - 2u32) != Divisionˉtype {
            return Compilerˉnativeˉx64ˉinvalidˉblockˉvalueˉstate(Input);
        }
        Depth = Depth - 2u32;
        Stack = Bytesˉslice(Stack, 0u32, Depth);
        Stack = Bytesˉconcat(Stack, Bytesˉfromˉu8(Divisionˉtype));
        Depth = Depth + 1u32;
        U32ˉvalues = U32ˉvalues + 1u32;
        if Divisionˉtype == 5u8 {
            Bodyˉbytes = Bodyˉbytes +
                Descriptorˉinstructions.Compilerˉnativeˉx64ˉu32ˉdivisionˉbytes(
                    Opcode
                );
        } else {
            Bodyˉbytes = Bodyˉbytes +
                Descriptorˉinstructions.Compilerˉnativeˉx64ˉu64ˉdivisionˉbytes(
                    Opcode
                );
        }
    }
    if Compilerˉnativeˉx64ˉisˉu64ˉbitwise(Opcode) {
        let Wideˉnumeric: u32 = U32ˉfromˉu8(Opcode);
        var Wideˉoperands: u32 = 2u32;
        if Opcode == 182u8 { Wideˉoperands = 1u32; }
        if Depth < Wideˉoperands {
            return Compilerˉnativeˉx64ˉinvalidˉblockˉvalueˉstate(Input);
        }
        var Wideˉoperand: u32 = 0u32;
        while Wideˉoperand < Wideˉoperands {
            var Wideˉexpectedˉtype: u8 = 10u8;
            if (Opcode == 183u8 || Opcode == 184u8) &&
                Wideˉoperand == 0u32 {
                Wideˉexpectedˉtype = 5u8;
            }
            if Bytesˉreadˉu8(Stack, Depth - Wideˉoperand - 1u32) !=
                Wideˉexpectedˉtype {
                return Compilerˉnativeˉx64ˉinvalidˉblockˉvalueˉstate(Input);
            }
            Wideˉoperand = Wideˉoperand + 1u32;
        }
        Depth = Depth - Wideˉoperands;
        Stack = Bytesˉslice(Stack, 0u32, Depth);
        Stack = Bytesˉconcat(Stack, Bytesˉfromˉu8(10u8));
        Depth = Depth + 1u32;
        U32ˉvalues = U32ˉvalues + 1u32;
        if Wideˉnumeric >= 179u32 && Wideˉnumeric <= 181u32 {
            Bodyˉbytes = Bodyˉbytes + 37u32;
        }
        if Opcode == 182u8 { Bodyˉbytes = Bodyˉbytes + 29u32; }
        if Opcode == 183u8 || Opcode == 184u8 {
            Bodyˉbytes = Bodyˉbytes + 45u32;
        }
    }
    if Opcode == 104u8 {
        let Recordˉtypeˉindex: u32 = Bytesˉreadˉu32ˉlittle(
            Input,
            Instructionˉoffset + 1u32
        );
        if Recordˉtypeˉindex >= Types.Count ||
            Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉkind(
                Types,
                Recordˉtypeˉindex
            ) != 1u8 {
            return Compilerˉnativeˉx64ˉinvalidˉblockˉvalueˉstate(Input);
        }
        let Recordˉfields: u32 =
            Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉitemˉcount(
                Types,
                Recordˉtypeˉindex
            );
        if Depth < Recordˉfields {
            return Compilerˉnativeˉx64ˉinvalidˉblockˉvalueˉstate(Input);
        }
        var Recordˉfield: u32 = Recordˉfields;
        while Recordˉfield > 0u32 {
            Recordˉfield = Recordˉfield - 1u32;
            let Expectedˉfieldˉtype: u8 =
                Nominalˉtypes.Compilerˉnativeˉx64ˉrecordˉfieldˉtype(
                    Input,
                    Types,
                    Recordˉtypeˉindex,
                    Recordˉfield
                );
            if Bytesˉreadˉu8(
                Stack,
                Depth - Recordˉfields + Recordˉfield
            ) != Expectedˉfieldˉtype {
                return Compilerˉnativeˉx64ˉinvalidˉblockˉvalueˉstate(Input);
            }
        }
        Depth = Depth - Recordˉfields;
        Stack = Bytesˉslice(Stack, 0u32, Depth);
        Stack = Bytesˉconcat(
            Stack,
            Bytesˉfromˉu8(
                Nominalˉtypes.Compilerˉnativeˉx64ˉrecordˉtype(
                    Recordˉtypeˉindex
                )
            )
        );
        Depth = Depth + 1u32;
        Recordˉvalues = Recordˉvalues + 1u32;
        Bodyˉbytes = Bodyˉbytes +
            Records.Compilerˉnativeˉx64ˉrecordˉcreateˉbytes(
                Input,
                Types,
                Recordˉtypeˉindex
            );
    }
    if Opcode == 105u8 {
        if Depth == 0u32 {
            return Compilerˉnativeˉx64ˉinvalidˉblockˉvalueˉstate(Input);
        }
        let Recordˉtype: u8 = Bytesˉreadˉu8(Stack, Depth - 1u32);
        if !Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉisˉrecord(Recordˉtype) {
            return Compilerˉnativeˉx64ˉinvalidˉblockˉvalueˉstate(Input);
        }
        let Fieldˉrecordˉtypeˉindex: u32 =
            Nominalˉtypes.Compilerˉnativeˉx64ˉrecordˉtypeˉindex(Types, Recordˉtype);
        if Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉkind(
            Types,
            Fieldˉrecordˉtypeˉindex
        ) != 1u8 {
            return Compilerˉnativeˉx64ˉinvalidˉblockˉvalueˉstate(Input);
        }
        let Fieldˉrecordˉindex: u32 = Bytesˉreadˉu32ˉlittle(
            Input,
            Instructionˉoffset + 1u32
        );
        if Fieldˉrecordˉindex >=
            Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉitemˉcount(
                Types,
                Fieldˉrecordˉtypeˉindex
            ) {
            return Compilerˉnativeˉx64ˉinvalidˉblockˉvalueˉstate(Input);
        }
        let Recordˉfieldˉtype: u8 =
            Nominalˉtypes.Compilerˉnativeˉx64ˉrecordˉfieldˉtype(
                Input,
                Types,
                Fieldˉrecordˉtypeˉindex,
                Fieldˉrecordˉindex
            );
        Depth = Depth - 1u32;
        Stack = Bytesˉslice(Stack, 0u32, Depth);
        Stack = Bytesˉconcat(Stack, Bytesˉfromˉu8(Recordˉfieldˉtype));
        Depth = Depth + 1u32;
        if Recordˉfieldˉtype == 1u8 { I32ˉvalues = I32ˉvalues + 1u32; }
        if Recordˉfieldˉtype == 2u8 { Boolˉvalues = Boolˉvalues + 1u32; }
        if Recordˉfieldˉtype == 3u8 { Textˉvalues = Textˉvalues + 1u32; }
        if Recordˉfieldˉtype == 4u8 { U8ˉvalues = U8ˉvalues + 1u32; }
        if Recordˉfieldˉtype == 5u8 || Recordˉfieldˉtype == 8u8 || Recordˉfieldˉtype == 9u8 ||
            Recordˉfieldˉtype == 10u8 {
            U32ˉvalues = U32ˉvalues + 1u32;
        }
        if Recordˉfieldˉtype == 6u8 || Recordˉfieldˉtype == 7u8 { Bytesˉvalues = Bytesˉvalues + 1u32; }
        if Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉisˉenum(
            Recordˉfieldˉtype
        ) { Enumˉvalues = Enumˉvalues + 1u32; }
        if Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉisˉrecord(
            Recordˉfieldˉtype
        ) { Recordˉvalues = Recordˉvalues + 1u32; }
        if Nominalˉtypes.Compilerˉnativeˉx64ˉsharedˉminor(Bytesˉreadˉu16ˉlittle(Input, 6u32)) &&
            Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉisˉrecord(Recordˉfieldˉtype) {
            Bodyˉbytes = Bodyˉbytes + Records.Compilerˉnativeˉx64ˉrecordˉfieldˉcopyˉbytes(
                Nominalˉtypes.Compilerˉnativeˉx64ˉrecordˉwidth(Input, Types,
                    Nominalˉtypes.Compilerˉnativeˉx64ˉrecordˉtypeˉindex(Types, Recordˉfieldˉtype)));
        } else {
            Bodyˉbytes = Bodyˉbytes + Records.Compilerˉnativeˉx64ˉrecordˉfieldˉbytes();
        }
    }
    if Opcode == 106u8 {
        let Enumˉtypeˉindex: u32 = Bytesˉreadˉu32ˉlittle(
            Input,
            Instructionˉoffset + 1u32
        );
        let Enumˉmemberˉindex: u32 = Bytesˉreadˉu32ˉlittle(
            Input,
            Instructionˉoffset + 5u32
        );
        if Enumˉtypeˉindex >= Types.Count {
            return Compilerˉnativeˉx64ˉinvalidˉblockˉvalueˉstate(Input);
        }
        let Enumˉkind: u8 = Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉkind(
            Types,
            Enumˉtypeˉindex
        );
        if Enumˉkind != 2u8 && Enumˉkind != 7u8 ||
            Enumˉmemberˉindex >=
                Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉitemˉcount(
                    Types,
                    Enumˉtypeˉindex
                ) {
            return Compilerˉnativeˉx64ˉinvalidˉblockˉvalueˉstate(Input);
        }
        Stack = Bytesˉconcat(
            Stack,
            Bytesˉfromˉu8(
                Nominalˉtypes.Compilerˉnativeˉx64ˉenumˉtype(
                    Types,
                    Enumˉtypeˉindex
                )
            )
        );
        Depth = Depth + 1u32;
        Enumˉvalues = Enumˉvalues + 1u32;
        Bodyˉbytes = Bodyˉbytes +
            Enums.Compilerˉnativeˉx64ˉenumˉconstantˉbytes();
    }
    if Compilerˉnativeˉx64ˉisˉenumˉcomparison(Opcode) {
        if Depth < 2u32 {
            return Compilerˉnativeˉx64ˉinvalidˉblockˉvalueˉstate(Input);
        }
        let Enumˉright: u8 = Bytesˉreadˉu8(Stack, Depth - 1u32);
        let Enumˉleft: u8 = Bytesˉreadˉu8(Stack, Depth - 2u32);
        if !Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉisˉenum(Enumˉleft) ||
            Enumˉleft != Enumˉright {
            return Compilerˉnativeˉx64ˉinvalidˉblockˉvalueˉstate(Input);
        }
        Depth = Depth - 2u32;
        Stack = Bytesˉslice(Stack, 0u32, Depth);
        Stack = Bytesˉconcat(Stack, Bytesˉfromˉu8(2u8));
        Depth = Depth + 1u32;
        Boolˉvalues = Boolˉvalues + 1u32;
        Bodyˉbytes = Bodyˉbytes +
            Enums.Compilerˉnativeˉx64ˉenumˉcomparisonˉbytes();
    }
    if Opcode == 109u8 {
        if Depth == 0u32 {
            return Compilerˉnativeˉx64ˉinvalidˉblockˉvalueˉstate(Input);
        }
        let Namedˉenum: u8 = Bytesˉreadˉu8(Stack, Depth - 1u32);
        if !Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉisˉenum(Namedˉenum) {
            return Compilerˉnativeˉx64ˉinvalidˉblockˉvalueˉstate(Input);
        }
        Depth = Depth - 1u32;
        Stack = Bytesˉslice(Stack, 0u32, Depth);
        Stack = Bytesˉconcat(Stack, Bytesˉfromˉu8(3u8));
        Depth = Depth + 1u32;
        Textˉvalues = Textˉvalues + 1u32;
        Bodyˉbytes = Bodyˉbytes +
            Enums.Compilerˉnativeˉx64ˉenumˉnameˉbytes();
    }
    if Opcode == 80u8 {
        if Depth == 0u32 || Bytesˉreadˉu8(Stack, Depth - 1u32) != 10u8 ||
            Instructionˉoffset < 5u32 { return Compilerˉnativeˉx64ˉinvalidˉblockˉvalueˉstate(Input); }
        let Releasedˉlocal: u32 = Bytesˉreadˉu32ˉlittle(Input, Instructionˉoffset - 4u32);
        if Releasedˉlocal >= Bytesˉlength(Localˉtypeˉidentities) / 4u32 {
            return Compilerˉnativeˉx64ˉinvalidˉblockˉvalueˉstate(Input);
        }
        let Releasedˉidentity: u32 = Bytesˉreadˉu32ˉlittle(Localˉtypeˉidentities, Releasedˉlocal * 4u32);
        if Releasedˉidentity != 25u32 &&
            (Releasedˉidentity < 2147483648u32 || Releasedˉidentity == 4294967295u32) {
            return Compilerˉnativeˉx64ˉinvalidˉblockˉvalueˉstate(Input);
        }
        Depth = Depth - 1u32;
        Stack = Bytesˉslice(Stack, 0u32, Depth);
        Bodyˉbytes = Bodyˉbytes + Ownedˉcollections.Operationˉbytes(Opcode);
    }
    if Opcode == 195u8 || Opcode == 202u8 || Opcode == 208u8 ||
        Opcode == 209u8 || Opcode == 226u8 || Opcode == 227u8 || Opcode == 228u8 {
        let Collection: Ownedˉcollections.Analysis = Ownedˉcollections.Analyze(Input, Instructionˉoffset, Opcode, Localˉtypeˉidentities, Types, Stack, Depth, I32ˉvalues, Boolˉvalues, U8ˉvalues, U32ˉvalues, Recordˉvalues, Bodyˉbytes);
        if !Collection.Valid { return Compilerˉnativeˉx64ˉinvalidˉblockˉvalueˉstate(Input); }
        Stack = Collection.Stack;
        Depth = Collection.Depth;
        I32ˉvalues = Collection.I32ˉvalues;
        Boolˉvalues = Collection.Boolˉvalues;
        U8ˉvalues = Collection.U8ˉvalues;
        U32ˉvalues = Collection.U32ˉvalues;
        Recordˉvalues = Collection.Recordˉvalues;
        Bodyˉbytes = Collection.Bodyˉbytes;
    }
    if Opcode == 207u8 {
        if Depth == 0u32 || Bytesˉreadˉu8(Stack, Depth - 1u32) != 10u8 {
            return Compilerˉnativeˉx64ˉinvalidˉblockˉvalueˉstate(Input);
        }
        let Vectorˉbudget: u32 = Bytesˉreadˉu32ˉlittle(Input, Instructionˉoffset + 1u32);
        let Vectorˉresult: u32 = Bytesˉreadˉu32ˉlittle(Input, Instructionˉoffset + 5u32);
        if Vectorˉbudget >= Bytesˉlength(Localˉtypeˉidentities) / 4u32 ||
            Bytesˉreadˉu32ˉlittle(Localˉtypeˉidentities, Vectorˉbudget * 4u32) != 25u32 ||
            !Nominalˉtypes.Compilerˉnativeˉx64ˉvectorˉresultˉisˉexact(Input, Types, Vectorˉresult) {
            return Compilerˉnativeˉx64ˉinvalidˉblockˉvalueˉstate(Input);
        }
        Stack = Bytesˉconcat(Bytesˉslice(Stack, 0u32, Depth - 1u32),
            Bytesˉfromˉu8(Nominalˉtypes.Compilerˉnativeˉx64ˉvariantˉtype(Types, Vectorˉresult)));
        Recordˉvalues = Recordˉvalues + 1u32;
        Bodyˉbytes = Bodyˉbytes + Ownedˉcollections.Operationˉbytes(Opcode);
    }
    if Opcode == 206u8 {
        if Depth < 2u32 ||
            Bytesˉreadˉu8(Stack, Depth - 2u32) != 10u8 ||
            Bytesˉreadˉu8(Stack, Depth - 1u32) != 5u8 {
            return Compilerˉnativeˉx64ˉinvalidˉblockˉvalueˉstate(Input);
        }
        let Parentˉlocal: u32 = Bytesˉreadˉu32ˉlittle(
            Input, Instructionˉoffset + 1u32
        );
        let Budgetˉresultˉtype: u32 = Bytesˉreadˉu32ˉlittle(
            Input, Instructionˉoffset + 5u32
        );
        if Parentˉlocal >= Bytesˉlength(Localˉtypeˉidentities) / 4u32 ||
            Bytesˉreadˉu32ˉlittle(
                Localˉtypeˉidentities, Parentˉlocal * 4u32
            ) != 25u32 ||
            !Nominalˉtypes.Compilerˉnativeˉx64ˉmemoryˉbudgetˉresultˉisˉexact(
                Input, Types, Budgetˉresultˉtype
            ) {
            return Compilerˉnativeˉx64ˉinvalidˉblockˉvalueˉstate(Input);
        }
        Depth = Depth - 2u32;
        Stack = Bytesˉconcat(
            Bytesˉslice(Stack, 0u32, Depth),
            Bytesˉfromˉu8(
                Nominalˉtypes.Compilerˉnativeˉx64ˉvariantˉtype(Types,
                    Budgetˉresultˉtype
                )
            )
        );
        Depth = Depth + 1u32;
        Recordˉvalues = Recordˉvalues + 1u32;
        if Ownedˉcollections.Minorˉisˉsupported(Bytesˉreadˉu16ˉlittle(Input, 6u32)) {
            Bodyˉbytes = Bodyˉbytes + Ownedˉcollections.Operationˉbytes(Opcode);
        } else {
            Bodyˉbytes = Bodyˉbytes +
                Memoryˉbudget.Compilerˉnativeˉx64ˉmemoryˉbudgetˉsplitˉbytes();
        }
    }
    if Opcode == 220u8 {
        if Depth < 2u32 ||
            Bytesˉreadˉu8(Stack, Depth - 2u32) != 10u8 ||
            Bytesˉreadˉu8(Stack, Depth - 1u32) != 10u8 {
            return Compilerˉnativeˉx64ˉinvalidˉblockˉvalueˉstate(Input);
        }
        let Scratchˉresultˉtype: u32 = Bytesˉreadˉu32ˉlittle(
            Input,
            Instructionˉoffset + 5u32
        );
        let Scratchˉabiˉtype: u32 = Bytesˉreadˉu32ˉlittle(
            Input,
            Instructionˉoffset + 9u32
        );
        let Scratchˉbudgetˉlocal: u32 = Bytesˉreadˉu32ˉlittle(
            Input,
            Instructionˉoffset + 1u32
        );
        if Scratchˉbudgetˉlocal >= Bytesˉlength(Localˉtypeˉidentities) / 4u32 ||
            Bytesˉreadˉu32ˉlittle(
                Localˉtypeˉidentities, Scratchˉbudgetˉlocal * 4u32
            ) != 25u32 ||
            Scratchˉresultˉtype >= Types.Count ||
            Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉkind(
                Types, Scratchˉresultˉtype
            ) != 3u8 ||
            Scratchˉabiˉtype >= Types.Count {
            return Compilerˉnativeˉx64ˉinvalidˉblockˉvalueˉstate(Input);
        }
        let Scratchˉabiˉkind: u8 =
            Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉkind(
                Types, Scratchˉabiˉtype
            );
        if Scratchˉabiˉkind != 2u8 && Scratchˉabiˉkind != 7u8 {
            return Compilerˉnativeˉx64ˉinvalidˉblockˉvalueˉstate(Input);
        }
        Depth = Depth - 2u32;
        Stack = Bytesˉconcat(
            Bytesˉslice(Stack, 0u32, Depth),
            Bytesˉfromˉu8(
                Nominalˉtypes.Compilerˉnativeˉx64ˉvariantˉtype(Types,
                    Scratchˉresultˉtype
                )
            )
        );
        Depth = Depth + 1u32;
        Recordˉvalues = Recordˉvalues + 1u32;
        Bodyˉbytes = Bodyˉbytes +
            Unsafeˉscratch.Compilerˉnativeˉx64ˉunsafeˉscratchˉbytes(
                Bytesˉreadˉu16ˉlittle(Input, 6u32)
            );
    }
    if Opcode == 221u8 {
        let Lengthˉscratchˉlocal: u32 = Bytesˉreadˉu32ˉlittle(
            Input, Instructionˉoffset + 1u32
        );
        let Lengthˉscratchˉabiˉtype: u32 = Bytesˉreadˉu32ˉlittle(
            Input, Instructionˉoffset + 5u32
        );
        if Lengthˉscratchˉlocal >=
                Bytesˉlength(Localˉtypeˉidentities) / 4u32 ||
            Lengthˉscratchˉabiˉtype >= Types.Count {
            return Compilerˉnativeˉx64ˉinvalidˉblockˉvalueˉstate(Input);
        }
        let Lengthˉscratchˉtype: u32 = Bytesˉreadˉu32ˉlittle(
            Localˉtypeˉidentities, Lengthˉscratchˉlocal * 4u32
        );
        let Lengthˉscratchˉabiˉkind: u8 =
            Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉkind(
                Types, Lengthˉscratchˉabiˉtype
            );
        if Lengthˉscratchˉtype >= Types.Count ||
            Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉkind(
                Types, Lengthˉscratchˉtype
            ) != 1u8 ||
            (Lengthˉscratchˉabiˉkind != 2u8 &&
                Lengthˉscratchˉabiˉkind != 7u8) {
            return Compilerˉnativeˉx64ˉinvalidˉblockˉvalueˉstate(Input);
        }
        Stack = Bytesˉconcat(Stack, Bytesˉfromˉu8(10u8));
        Depth = Depth + 1u32;
        U32ˉvalues = U32ˉvalues + 1u32;
        Bodyˉbytes = Bodyˉbytes +
            Unsafeˉscratch.Compilerˉnativeˉx64ˉunsafeˉscratchˉlengthˉbytes(
                Bytesˉreadˉu16ˉlittle(Input, 6u32)
            );
    }
    if Opcode == 222u8 {
        if Depth < 3u32 ||
            Bytesˉreadˉu8(Stack, Depth - 3u32) != 10u8 ||
            Bytesˉreadˉu8(Stack, Depth - 2u32) != 10u8 ||
            Bytesˉreadˉu8(Stack, Depth - 1u32) != 10u8 {
            return Compilerˉnativeˉx64ˉinvalidˉblockˉvalueˉstate(Input);
        }
        let Regionˉscratchˉlocal: u32 = Bytesˉreadˉu32ˉlittle(
            Input, Instructionˉoffset + 1u32
        );
        let Regionˉresultˉtype: u32 = Bytesˉreadˉu32ˉlittle(
            Input, Instructionˉoffset + 5u32
        );
        let Regionˉabiˉtype: u32 = Bytesˉreadˉu32ˉlittle(
            Input, Instructionˉoffset + 9u32
        );
        if Regionˉscratchˉlocal >=
                Bytesˉlength(Localˉtypeˉidentities) / 4u32 ||
            Regionˉresultˉtype >= Types.Count ||
            Regionˉabiˉtype >= Types.Count {
            return Compilerˉnativeˉx64ˉinvalidˉblockˉvalueˉstate(Input);
        }
        let Regionˉscratchˉtype: u32 = Bytesˉreadˉu32ˉlittle(
            Localˉtypeˉidentities, Regionˉscratchˉlocal * 4u32
        );
        let Regionˉvalueˉtype: u32 =
            Nominalˉtypes.Compilerˉnativeˉx64ˉunsafeˉwriteˉregionˉvalueˉtype(
                Input, Types, Regionˉresultˉtype
            );
        if Regionˉscratchˉtype >= Types.Count ||
            !Nominalˉtypes.Compilerˉnativeˉx64ˉunsafeˉtokenˉisˉexact(
                Input, Types, Regionˉscratchˉtype
            ) || Regionˉvalueˉtype >= Types.Count ||
            Regionˉvalueˉtype == Regionˉscratchˉtype {
            return Compilerˉnativeˉx64ˉinvalidˉblockˉvalueˉstate(Input);
        }
        let Regionˉabiˉkind: u8 =
            Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉkind(
                Types, Regionˉabiˉtype
            );
        if Regionˉabiˉkind != 2u8 && Regionˉabiˉkind != 7u8 {
            return Compilerˉnativeˉx64ˉinvalidˉblockˉvalueˉstate(Input);
        }
        Depth = Depth - 3u32;
        Stack = Bytesˉconcat(
            Bytesˉslice(Stack, 0u32, Depth),
            Bytesˉfromˉu8(
                Nominalˉtypes.Compilerˉnativeˉx64ˉvariantˉtype(Types,
                    Regionˉresultˉtype
                )
            )
        );
        Depth = Depth + 1u32;
        Recordˉvalues = Recordˉvalues + 1u32;
        Bodyˉbytes = Bodyˉbytes +
            Unsafeˉwriteˉregion.Compilerˉnativeˉx64ˉunsafeˉwriteˉregionˉbytes(
                Bytesˉreadˉu16ˉlittle(Input, 6u32)
            );
    }
    if Opcode == 223u8 {
        let Pointerˉregionˉlocal: u32 = Bytesˉreadˉu32ˉlittle(
            Input, Instructionˉoffset + 1u32
        );
        let Pointerˉtype: u32 = Bytesˉreadˉu32ˉlittle(
            Input, Instructionˉoffset + 5u32
        );
        let Pointerˉabiˉtype: u32 = Bytesˉreadˉu32ˉlittle(
            Input, Instructionˉoffset + 9u32
        );
        if Pointerˉregionˉlocal >=
                Bytesˉlength(Localˉtypeˉidentities) / 4u32 ||
            Pointerˉtype >= Types.Count || Pointerˉabiˉtype >= Types.Count {
            return Compilerˉnativeˉx64ˉinvalidˉblockˉvalueˉstate(Input);
        }
        let Pointerˉregionˉtype: u32 = Bytesˉreadˉu32ˉlittle(
            Localˉtypeˉidentities, Pointerˉregionˉlocal * 4u32
        );
        if Pointerˉregionˉtype >= Types.Count ||
            Pointerˉregionˉtype == Pointerˉtype ||
            !Nominalˉtypes.Compilerˉnativeˉx64ˉunsafeˉtokenˉisˉexact(
                Input, Types, Pointerˉregionˉtype
            ) ||
            !Nominalˉtypes.Compilerˉnativeˉx64ˉunsafeˉtokenˉisˉexact(
                Input, Types, Pointerˉtype
            ) {
            return Compilerˉnativeˉx64ˉinvalidˉblockˉvalueˉstate(Input);
        }
        let Pointerˉabiˉkind: u8 =
            Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉkind(
                Types, Pointerˉabiˉtype
            );
        if Pointerˉabiˉkind != 2u8 && Pointerˉabiˉkind != 7u8 {
            return Compilerˉnativeˉx64ˉinvalidˉblockˉvalueˉstate(Input);
        }
        Stack = Bytesˉconcat(
            Stack,
            Bytesˉfromˉu8(
                Nominalˉtypes.Compilerˉnativeˉx64ˉrecordˉtype(Pointerˉtype)
            )
        );
        Depth = Depth + 1u32;
        Recordˉvalues = Recordˉvalues + 1u32;
        if Bytesˉreadˉu16ˉlittle(Input, 6u32) == 38u32 {
            Bodyˉbytes = Bodyˉbytes + 61u32;
        } else {
            Bodyˉbytes = Bodyˉbytes + 45u32;
        }
    }
    if Opcode == 224u8 {
        let Foreignˉbinding: u32 = Bytesˉreadˉu32ˉlittle(
            Input, Instructionˉoffset + 1u32
        );
        let Foreignˉpointerˉtype: u32 = Bytesˉreadˉu32ˉlittle(
            Input, Instructionˉoffset + 5u32
        );
        let Foreignˉabiˉtype: u32 = Bytesˉreadˉu32ˉlittle(
            Input, Instructionˉoffset + 9u32
        );
        if Depth < 3u32 || Foreignˉbinding != 1u32 ||
            Foreignˉpointerˉtype >= Types.Count ||
            Foreignˉabiˉtype >= Types.Count ||
            Bytesˉreadˉu8(Stack, Depth - 3u32) !=
                Nominalˉtypes.Compilerˉnativeˉx64ˉrecordˉtype(
                    Foreignˉpointerˉtype
                ) ||
            Bytesˉreadˉu8(Stack, Depth - 2u32) != 10u8 ||
            Bytesˉreadˉu8(Stack, Depth - 1u32) != 10u8 ||
            !Nominalˉtypes.Compilerˉnativeˉx64ˉunsafeˉtokenˉisˉexact(
                Input, Types, Foreignˉpointerˉtype
            ) {
            return Compilerˉnativeˉx64ˉinvalidˉblockˉvalueˉstate(Input);
        }
        let Foreignˉabiˉkind: u8 =
            Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉkind(
                Types, Foreignˉabiˉtype
            );
        if Foreignˉabiˉkind != 2u8 && Foreignˉabiˉkind != 7u8 {
            return Compilerˉnativeˉx64ˉinvalidˉblockˉvalueˉstate(Input);
        }
        Depth = Depth - 3u32;
        Stack = Bytesˉconcat(
            Bytesˉslice(Stack, 0u32, Depth),
            Bytesˉfromˉu8(9u8)
        );
        Depth = Depth + 1u32;
        U32ˉvalues = U32ˉvalues + 1u32;
        Bodyˉbytes = Bodyˉbytes +
            Foreignˉcall.Compilerˉnativeˉx64ˉforeignˉcallˉbytes(Isˉmain);
    }
    return Compilerˉnativeˉx64ˉblockˉvalueˉstate(
        Stack,
        Depth,
        I32ˉvalues,
        Boolˉvalues,
        Textˉvalues,
        U8ˉvalues,
        U32ˉvalues,
        Bytesˉvalues,
        Enumˉvalues,
        Recordˉvalues,
        Bodyˉbytes
    );
}

fn Compilerˉnativeˉx64ˉanalyzeˉdescriptorˉvalueˉinstruction(
    Input: bytes,
    Instructionˉoffset: u32,
    Opcode: u8,
    State: bytes,
    Data: Staticˉdata.Compilerˉnativeˉx64ˉdata,
    Sharedˉvalues: bool
) -> bytes {
    let Opcodeˉnumber: u32 = U32ˉfromˉu8(Opcode);
    var Stack: bytes = Compilerˉnativeˉx64ˉblockˉvalueˉstateˉstack(State);
    var Depth: u32 = Bytesˉreadˉu32ˉlittle(State, 1u32);
    var I32ˉvalues: u32 = Bytesˉreadˉu32ˉlittle(State, 5u32);
    var Boolˉvalues: u32 = Bytesˉreadˉu32ˉlittle(State, 9u32);
    var Textˉvalues: u32 = Bytesˉreadˉu32ˉlittle(State, 13u32);
    var U8ˉvalues: u32 = Bytesˉreadˉu32ˉlittle(State, 17u32);
    var U32ˉvalues: u32 = Bytesˉreadˉu32ˉlittle(State, 21u32);
    var Bytesˉvalues: u32 = Bytesˉreadˉu32ˉlittle(State, 25u32);
    var Bodyˉbytes: u32 = Bytesˉreadˉu32ˉlittle(State, 37u32);
    if Sharedˉvalues && Opcodeˉnumber >= 185u32 && Opcodeˉnumber <= 188u32 {
        var Expected: u8 = 3u8;
        if Opcodeˉnumber >= 187u32 { Expected = 6u8; }
        if Depth < 2u32 || Bytesˉreadˉu8(Stack, Depth - 1u32) != Expected ||
            Bytesˉreadˉu8(Stack, Depth - 2u32) != Expected {
            return Compilerˉnativeˉx64ˉinvalidˉblockˉvalueˉstate(Input);
        }
        Depth = Depth - 1u32;
        Stack = Bytesˉconcat(Bytesˉslice(Stack, 0u32, Depth - 1u32), Bytesˉfromˉu8(2u8));
        Boolˉvalues = Boolˉvalues + 1u32;
    }
    if Opcode == 191u8 {
        if Depth == 0u32 ||
            Bytesˉreadˉu8(Stack, Depth - 1u32) != 5u8 {
            return Compilerˉnativeˉx64ˉinvalidˉblockˉvalueˉstate(Input);
        }
        Depth = Depth - 1u32;
        Stack = Bytesˉslice(Stack, 0u32, Depth);
        Stack = Bytesˉconcat(Stack, Bytesˉfromˉu8(10u8));
        Depth = Depth + 1u32;
        U32ˉvalues = U32ˉvalues + 1u32;
        Bodyˉbytes = Bodyˉbytes +
            Descriptorˉinstructions.Compilerˉnativeˉx64ˉu64ˉfromˉu32ˉbytes();
    }
    if Opcode == 118u8 {
        if Depth == 0u32 ||
            Bytesˉreadˉu8(Stack, Depth - 1u32) != 4u8 {
            return Compilerˉnativeˉx64ˉinvalidˉblockˉvalueˉstate(Input);
        }
        Depth = Depth - 1u32;
        Stack = Bytesˉslice(Stack, 0u32, Depth);
        Stack = Bytesˉconcat(Stack, Bytesˉfromˉu8(5u8));
        Depth = Depth + 1u32;
        U32ˉvalues = U32ˉvalues + 1u32;
        Bodyˉbytes = Bodyˉbytes +
            Descriptorˉinstructions.Compilerˉnativeˉx64ˉu32ˉfromˉu8ˉbytes();
    }
    if Opcode == 3u8 || Opcode == 10u8 {
        let Descriptorˉdata: u32 = Bytesˉreadˉu32ˉlittle(
            Input,
            Instructionˉoffset + 1u32
        );
        if Descriptorˉdata >= Data.Count {
            return Compilerˉnativeˉx64ˉinvalidˉblockˉvalueˉstate(Input);
        }
        var Descriptorˉtype: u8 = 3u8;
        var Descriptorˉkind: u8 = 3u8;
        if Opcode == 10u8 {
            Descriptorˉtype = 6u8;
            Descriptorˉkind = 5u8;
        }
        if Staticˉdata.Compilerˉnativeˉx64ˉdataˉkind(
            Data,
            Descriptorˉdata
        ) != Descriptorˉkind {
            return Compilerˉnativeˉx64ˉinvalidˉblockˉvalueˉstate(Input);
        }
        Stack = Bytesˉconcat(Stack, Bytesˉfromˉu8(Descriptorˉtype));
        Depth = Depth + 1u32;
        if Descriptorˉtype == 3u8 {
            Textˉvalues = Textˉvalues + 1u32;
        } else {
            Bytesˉvalues = Bytesˉvalues + 1u32;
        }
        Bodyˉbytes = Bodyˉbytes +
            Descriptors.Compilerˉnativeˉx64ˉdescriptorˉconstantˉbytes();
    }
    if Opcode == 11u8 {
        if Depth == 0u32 ||
            Bytesˉreadˉu8(Stack, Depth - 1u32) != 6u8 {
            return Compilerˉnativeˉx64ˉinvalidˉblockˉvalueˉstate(Input);
        }
        Depth = Depth - 1u32;
        Stack = Bytesˉslice(Stack, 0u32, Depth);
        Stack = Bytesˉconcat(Stack, Bytesˉfromˉu8(5u8));
        Depth = Depth + 1u32;
        U32ˉvalues = U32ˉvalues + 1u32;
        Bodyˉbytes = Bodyˉbytes +
            Descriptors.Compilerˉnativeˉx64ˉdescriptorˉlengthˉbytes();
    }
    if Opcode == 12u8 {
        if Depth < 3u32 ||
            Bytesˉreadˉu8(Stack, Depth - 3u32) != 6u8 ||
            Bytesˉreadˉu8(Stack, Depth - 2u32) != 5u8 ||
            Bytesˉreadˉu8(Stack, Depth - 1u32) != 5u8 {
            return Compilerˉnativeˉx64ˉinvalidˉblockˉvalueˉstate(Input);
        }
        Depth = Depth - 3u32;
        Stack = Bytesˉslice(Stack, 0u32, Depth);
        Stack = Bytesˉconcat(Stack, Bytesˉfromˉu8(6u8));
        Depth = Depth + 1u32;
        Bytesˉvalues = Bytesˉvalues + 1u32;
        Bodyˉbytes = Bodyˉbytes +
            Descriptors.Compilerˉnativeˉx64ˉdescriptorˉsliceˉbytes();
    }
    if Opcode == 13u8 || Opcode == 14u8 || Opcode == 15u8 ||
        Opcode == 114u8 || Opcode == 189u8 {
        if Depth < 2u32 ||
            Bytesˉreadˉu8(Stack, Depth - 2u32) != 6u8 ||
            Bytesˉreadˉu8(Stack, Depth - 1u32) != 5u8 {
            return Compilerˉnativeˉx64ˉinvalidˉblockˉvalueˉstate(Input);
        }
        Depth = Depth - 2u32;
        Stack = Bytesˉslice(Stack, 0u32, Depth);
        var Readˉtype: u8 = 5u8;
        if Opcode == 13u8 { Readˉtype = 4u8; }
        if Opcode == 114u8 { Readˉtype = 1u8; }
        if Opcode == 189u8 { Readˉtype = 10u8; }
        Stack = Bytesˉconcat(Stack, Bytesˉfromˉu8(Readˉtype));
        Depth = Depth + 1u32;
        if Readˉtype == 1u8 { I32ˉvalues = I32ˉvalues + 1u32; }
        if Readˉtype == 4u8 { U8ˉvalues = U8ˉvalues + 1u32; }
        if Readˉtype == 5u8 || Readˉtype == 10u8 {
            U32ˉvalues = U32ˉvalues + 1u32;
        }
        Bodyˉbytes = Bodyˉbytes +
            Descriptors.Compilerˉnativeˉx64ˉdescriptorˉreadˉbytes(Opcode);
    }
    if Opcode == 113u8 {
        if Depth < 2u32 ||
            Bytesˉreadˉu8(Stack, Depth - 2u32) != 3u8 ||
            Bytesˉreadˉu8(Stack, Depth - 1u32) != 3u8 {
            return Compilerˉnativeˉx64ˉinvalidˉblockˉvalueˉstate(Input);
        }
        Depth = Depth - 2u32;
        Stack = Bytesˉslice(Stack, 0u32, Depth);
        Stack = Bytesˉconcat(Stack, Bytesˉfromˉu8(3u8));
        Depth = Depth + 1u32;
        Textˉvalues = Textˉvalues + 1u32;
        Bodyˉbytes = Bodyˉbytes +
            Runtimeˉdescriptors.Compilerˉnativeˉx64ˉtextˉconcatˉbytes();
    }
    if Opcode == 110u8 || Opcode == 112u8 {
        if Depth == 0u32 ||
            (Opcode == 110u8 &&
                Bytesˉreadˉu8(Stack, Depth - 1u32) != 1u8) ||
            (Opcode == 112u8 &&
                Bytesˉreadˉu8(Stack, Depth - 1u32) != 5u8) {
            return Compilerˉnativeˉx64ˉinvalidˉblockˉvalueˉstate(Input);
        }
        Depth = Depth - 1u32;
        Stack = Bytesˉslice(Stack, 0u32, Depth);
        Stack = Bytesˉconcat(Stack, Bytesˉfromˉu8(3u8));
        Depth = Depth + 1u32;
        Textˉvalues = Textˉvalues + 1u32;
        if Opcode == 110u8 {
            Bodyˉbytes = Bodyˉbytes +
                Runtimeˉdescriptors.Compilerˉnativeˉx64ˉi32ˉformatˉbytes();
        } else {
            Bodyˉbytes = Bodyˉbytes +
                Runtimeˉdescriptors.Compilerˉnativeˉx64ˉu32ˉformatˉbytes();
        }
    }
    if Opcode == 115u8 || Opcode == 116u8 {
        if Depth == 0u32 ||
            Bytesˉreadˉu8(Stack, Depth - 1u32) != 6u8 {
            return Compilerˉnativeˉx64ˉinvalidˉblockˉvalueˉstate(Input);
        }
        Depth = Depth - 1u32;
        Stack = Bytesˉslice(Stack, 0u32, Depth);
        var Runtimeˉtype: u8 = 3u8;
        if Opcode == 115u8 { Runtimeˉtype = 2u8; }
        Stack = Bytesˉconcat(Stack, Bytesˉfromˉu8(Runtimeˉtype));
        Depth = Depth + 1u32;
        if Runtimeˉtype == 2u8 {
            Boolˉvalues = Boolˉvalues + 1u32;
            Bodyˉbytes = Bodyˉbytes +
                Runtimeˉdescriptors.Compilerˉnativeˉx64ˉtextˉutf8ˉisˉvalidˉbytes();
        } else {
            Textˉvalues = Textˉvalues + 1u32;
            Bodyˉbytes = Bodyˉbytes +
                Runtimeˉdescriptors.Compilerˉnativeˉx64ˉtextˉfromˉutf8ˉbytes();
        }
    }
    if Opcode == 117u8 {
        if Depth == 0u32 ||
            Bytesˉreadˉu8(Stack, Depth - 1u32) != 3u8 {
            return Compilerˉnativeˉx64ˉinvalidˉblockˉvalueˉstate(Input);
        }
        Depth = Depth - 1u32;
        Stack = Bytesˉslice(Stack, 0u32, Depth);
        Stack = Bytesˉconcat(Stack, Bytesˉfromˉu8(3u8));
        Depth = Depth + 1u32;
        Textˉvalues = Textˉvalues + 1u32;
        Bodyˉbytes = Bodyˉbytes +
            Runtimeˉdescriptors.Compilerˉnativeˉx64ˉtextˉquoteˉbytes();
    }
    if Opcode == 125u8 {
        if Depth == 0u32 ||
            Bytesˉreadˉu8(Stack, Depth - 1u32) != 6u8 {
            return Compilerˉnativeˉx64ˉinvalidˉblockˉvalueˉstate(Input);
        }
        Depth = Depth - 1u32;
        Stack = Bytesˉslice(Stack, 0u32, Depth);
        Stack = Bytesˉconcat(Stack, Bytesˉfromˉu8(3u8));
        Depth = Depth + 1u32;
        Textˉvalues = Textˉvalues + 1u32;
        Bodyˉbytes = Bodyˉbytes + 10u32 +
            Nativeˉsha256.Compilerˉnativeˉx64ˉsha256ˉinstructionˉbytes();
    }
    if Opcode == 119u8 {
        if Depth < 2u32 ||
            Bytesˉreadˉu8(Stack, Depth - 2u32) != 6u8 ||
            Bytesˉreadˉu8(Stack, Depth - 1u32) != 6u8 {
            return Compilerˉnativeˉx64ˉinvalidˉblockˉvalueˉstate(Input);
        }
        Depth = Depth - 2u32;
        Stack = Bytesˉslice(Stack, 0u32, Depth);
        Stack = Bytesˉconcat(Stack, Bytesˉfromˉu8(6u8));
        Depth = Depth + 1u32;
        Bytesˉvalues = Bytesˉvalues + 1u32;
        Bodyˉbytes = Bodyˉbytes +
            Bytesˉconcatenation.Compilerˉnativeˉx64ˉbytesˉconcatˉbytes();
    }
    if Opcode == 120u8 {
        if Depth == 0u32 ||
            Bytesˉreadˉu8(Stack, Depth - 1u32) != 4u8 {
            return Compilerˉnativeˉx64ˉinvalidˉblockˉvalueˉstate(Input);
        }
        Depth = Depth - 1u32;
        Stack = Bytesˉslice(Stack, 0u32, Depth);
        Stack = Bytesˉconcat(Stack, Bytesˉfromˉu8(6u8));
        Depth = Depth + 1u32;
        Bytesˉvalues = Bytesˉvalues + 1u32;
        Bodyˉbytes = Bodyˉbytes +
            Bytesˉconcatenation.Compilerˉnativeˉx64ˉbytesˉfromˉu8ˉbytes();
    }
    if Opcode == 121u8 || Opcode == 122u8 || Opcode == 123u8 ||
        Opcode == 190u8 {
        if Depth == 0u32 {
            return Compilerˉnativeˉx64ˉinvalidˉblockˉvalueˉstate(Input);
        }
        var Sourceˉtype: u8 = 5u8;
        if Opcode == 123u8 { Sourceˉtype = 1u8; }
        if Opcode == 190u8 { Sourceˉtype = 10u8; }
        if Bytesˉreadˉu8(Stack, Depth - 1u32) != Sourceˉtype {
            return Compilerˉnativeˉx64ˉinvalidˉblockˉvalueˉstate(Input);
        }
        Depth = Depth - 1u32;
        Stack = Bytesˉslice(Stack, 0u32, Depth);
        Stack = Bytesˉconcat(Stack, Bytesˉfromˉu8(6u8));
        Depth = Depth + 1u32;
        Bytesˉvalues = Bytesˉvalues + 1u32;
        if Opcode == 121u8 {
            Bodyˉbytes = Bodyˉbytes +
                Bytesˉconcatenation.Compilerˉnativeˉx64ˉbytesˉfromˉu16ˉlittleˉbytes();
        } else if Opcode == 190u8 {
            Bodyˉbytes = Bodyˉbytes +
                Bytesˉconcatenation.Compilerˉnativeˉx64ˉbytesˉfromˉu64ˉlittleˉbytes();
        } else {
            Bodyˉbytes = Bodyˉbytes +
                Bytesˉconcatenation.Compilerˉnativeˉx64ˉbytesˉfromˉ32ˉlittleˉbytes();
        }
    }
    if Opcode == 124u8 {
        if Depth == 0u32 ||
            Bytesˉreadˉu8(Stack, Depth - 1u32) != 3u8 {
            return Compilerˉnativeˉx64ˉinvalidˉblockˉvalueˉstate(Input);
        }
        Depth = Depth - 1u32;
        Stack = Bytesˉslice(Stack, 0u32, Depth);
        Stack = Bytesˉconcat(Stack, Bytesˉfromˉu8(6u8));
        Depth = Depth + 1u32;
        Bytesˉvalues = Bytesˉvalues + 1u32;
        Bodyˉbytes = Bodyˉbytes +
            Descriptors.Compilerˉnativeˉx64ˉdescriptorˉcopyˉbytes();
    }
    if Sharedˉvalues && Sharedˉbytes.Legacyˉisˉsupported(Opcode) {
        Bodyˉbytes = Bytesˉreadˉu32ˉlittle(State, 37u32) + Sharedˉbytes.Legacyˉbytes(Opcode);
    }
    return Compilerˉnativeˉx64ˉblockˉvalueˉstate(
        Stack,
        Depth,
        I32ˉvalues,
        Boolˉvalues,
        Textˉvalues,
        U8ˉvalues,
        U32ˉvalues,
        Bytesˉvalues,
        Bytesˉreadˉu32ˉlittle(State, 29u32),
        Bytesˉreadˉu32ˉlittle(State, 33u32),
        Bodyˉbytes
    );
}

export fn Compilerˉnativeˉx64ˉanalyzeˉblock(
    Input: bytes,
    Section: Compilerˉnativeˉx64ˉsection,
    Function: Compilerˉnativeˉx64ˉfunction,
    Instructions: bytes,
    Start: u32,
    End: u32,
    Isˉmain: bool,
    Callableˉfunctions: u32,
    Callˉdirectory: bytes,
    Data: Staticˉdata.Compilerˉnativeˉx64ˉdata,
    Types: Nominalˉtypes.Compilerˉnativeˉx64ˉtypes,
    Capabilityˉtable: Nativeˉcapabilities.Compilerˉnativeˉx64ˉcapabilities
) -> Compilerˉnativeˉx64ˉblockˉanalysis {
    let Length: u32 = Section.Payloadˉlength;
    if Start >= End || End > Length {
        return Compilerˉnativeˉx64ˉinvalidˉblock();
    }
    var Stack: bytes = Compilerˉnativeˉx64ˉempty(Input);
    var Stackˉidentities: bytes = Compilerˉnativeˉx64ˉempty(Input);
    var Depth: u32 = 0u32;
    var Maximum: u32 = 0u32;
    var I32ˉvalues: u32 = 0u32;
    var Boolˉvalues: u32 = 0u32;
    var Textˉvalues: u32 = 0u32;
    var U8ˉvalues: u32 = 0u32;
    var U32ˉvalues: u32 = 0u32;
    var Bytesˉvalues: u32 = 0u32;
    var Enumˉvalues: u32 = 0u32;
    var Recordˉvalues: u32 = 0u32;
    var Bodyˉbytes: u32 = 0u32;
    var Terminator: u8 = 0u8;
    var Target: u32 = 0u32;
    var Cursor: u32 = Start;
    var Instructionˉsizes: bytes = Compilerˉnativeˉx64ˉempty(Input);
    while Cursor < End {
        let Beforeˉbytes: u32 = Bodyˉbytes;
        let Beforeˉstack: bytes = Stack;
        let Opcode: u8 = Bytesˉreadˉu8(Input, Section.Payloadˉoffset + Cursor);
        let Numericˉopcode: u32 = U32ˉfromˉu8(Opcode);
        let Size: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(Instructions, Cursor));
        if Size == 0u32 {
            return Compilerˉnativeˉx64ˉinvalidˉblock();
        }
        let Next: u32 = Cursor + Size;
        if Next > End { return Compilerˉnativeˉx64ˉinvalidˉblock(); }
        if Function.Sharedˉvalues && (Opcode == 5u8 || Opcode == 81u8) && Depth > 0u32 {
            var Expectedˉidentity: u32 = Function.Returnˉidentity;
            if Opcode == 5u8 {
                let Destination: u32 = Bytesˉreadˉu32ˉlittle(Input, Section.Payloadˉoffset + Cursor + 1u32);
                if Destination >= Function.Locals { return Compilerˉnativeˉx64ˉinvalidˉblock(); }
                Expectedˉidentity = Bytesˉreadˉu32ˉlittle(Function.Localˉtypeˉidentities, Destination * 4u32);
            }
            if Bytesˉreadˉu8(Stack, Depth - 1u32) == 10u8 &&
                (Bytesˉreadˉu32ˉlittle(Stackˉidentities, (Depth - 1u32) * 4u32) == 25u32) !=
                    (Expectedˉidentity == 25u32) {
                return Compilerˉnativeˉx64ˉinvalidˉblock();
            }
        }
        if Opcode == 211u8 || Opcode == 212u8 || Opcode == 213u8 {
            if Opcode == 211u8 {
                let Referenceˉtarget: u32 = Bytesˉreadˉu32ˉlittle(
                    Input, Section.Payloadˉoffset + Cursor + 1u32
                );
                let Referenceˉtype: u32 = Bytesˉreadˉu32ˉlittle(
                    Input, Section.Payloadˉoffset + Cursor + 5u32
                );
                if Referenceˉtarget >= Callableˉfunctions ||
                    !Compilerˉnativeˉx64ˉcallableˉtargetˉmatches(
                        Input, Types, Referenceˉtype, Referenceˉtarget,
                        0u32, Callˉdirectory
                    ) {
                    return Compilerˉnativeˉx64ˉinvalidˉblock();
                }
                Stack = Bytesˉconcat(Stack, Bytesˉfromˉu8(11u8));
                Depth = Depth + 1u32;
                Bytesˉvalues = Bytesˉvalues + 1u32;
            } else if Opcode == 213u8 {
                let Closureˉtarget: u32 = Bytesˉreadˉu32ˉlittle(
                    Input, Section.Payloadˉoffset + Cursor + 1u32
                );
                let Closureˉtype: u32 = Bytesˉreadˉu32ˉlittle(
                    Input, Section.Payloadˉoffset + Cursor + 5u32
                );
                let Closureˉcaptures: u32 = Bytesˉreadˉu32ˉlittle(
                    Input, Section.Payloadˉoffset + Cursor + 9u32
                );
                if Closureˉtarget >= Callableˉfunctions ||
                    Closureˉcaptures == 0u32 || Depth < Closureˉcaptures ||
                    !Compilerˉnativeˉx64ˉcallableˉtargetˉmatches(
                        Input, Types, Closureˉtype, Closureˉtarget,
                        Closureˉcaptures, Callˉdirectory
                    ) {
                    return Compilerˉnativeˉx64ˉinvalidˉblock();
                }
                var Capture: u32 = 0u32;
                while Capture < Closureˉcaptures {
                    if Bytesˉreadˉu8(
                        Stack, Depth - Closureˉcaptures + Capture
                    ) != Layout.Compilerˉnativeˉx64ˉlayoutˉparameterˉtype(
                        Callˉdirectory, Closureˉtarget, Capture
                    ) {
                        return Compilerˉnativeˉx64ˉinvalidˉblock();
                    }
                    Capture = Capture + 1u32;
                }
                Depth = Depth - Closureˉcaptures;
                Stack = Bytesˉslice(Stack, 0u32, Depth);
                Stack = Bytesˉconcat(Stack, Bytesˉfromˉu8(11u8));
                Depth = Depth + 1u32;
                Bytesˉvalues = Bytesˉvalues + 1u32;
            } else {
                let Indirectˉtype: u32 = Bytesˉreadˉu32ˉlittle(
                    Input, Section.Payloadˉoffset + Cursor + 1u32
                );
                let Indirectˉtarget: u32 =
                    Compilerˉnativeˉx64ˉcallableˉuniqueˉtarget(
                        Input, Types, Indirectˉtype, Callableˉfunctions,
                        Callˉdirectory
                    );
                if Indirectˉtarget == 4294967295u32 {
                    return Compilerˉnativeˉx64ˉinvalidˉblock();
                }
                let Publicˉparameters: u32 =
                    Nominalˉtypes.Compilerˉnativeˉx64ˉcallableˉparameters(
                        Types, Indirectˉtype
                    );
                if Depth < Publicˉparameters + 1u32 ||
                    Bytesˉreadˉu8(
                        Stack, Depth - Publicˉparameters - 1u32
                    ) != 11u8 {
                    return Compilerˉnativeˉx64ˉinvalidˉblock();
                }
                var Publicˉparameter: u32 = 0u32;
                while Publicˉparameter < Publicˉparameters {
                    let Parameterˉshape:
                        Nominalˉtypes.Compilerˉnativeˉx64ˉshape =
                        Nominalˉtypes.Compilerˉnativeˉx64ˉcallableˉparameter(
                            Input, Types, Indirectˉtype, Publicˉparameter
                        );
                    if !Parameterˉshape.Valid ||
                        Bytesˉreadˉu8(
                            Stack,
                            Depth - Publicˉparameters + Publicˉparameter
                        ) != Parameterˉshape.Type {
                        return Compilerˉnativeˉx64ˉinvalidˉblock();
                    }
                    Publicˉparameter = Publicˉparameter + 1u32;
                }
                Depth = Depth - Publicˉparameters - 1u32;
                Stack = Bytesˉslice(Stack, 0u32, Depth);
                let Callableˉresultˉshape:
                    Nominalˉtypes.Compilerˉnativeˉx64ˉshape =
                    Nominalˉtypes.Compilerˉnativeˉx64ˉcallableˉresult(
                        Input, Types, Indirectˉtype
                    );
                if !Callableˉresultˉshape.Valid {
                    return Compilerˉnativeˉx64ˉinvalidˉblock();
                }
                Stack = Bytesˉconcat(
                    Stack, Bytesˉfromˉu8(Callableˉresultˉshape.Type)
                );
                Depth = Depth + 1u32;
                if Callableˉresultˉshape.Type == 1u8 {
                    I32ˉvalues = I32ˉvalues + 1u32;
                }
                if Callableˉresultˉshape.Type == 2u8 {
                    Boolˉvalues = Boolˉvalues + 1u32;
                }
                if Callableˉresultˉshape.Type == 4u8 {
                    U8ˉvalues = U8ˉvalues + 1u32;
                }
                if Callableˉresultˉshape.Type == 5u8 ||
                    Callableˉresultˉshape.Type == 9u8 ||
                    Callableˉresultˉshape.Type == 10u8 {
                    U32ˉvalues = U32ˉvalues + 1u32;
                }
                if Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉisˉenum(
                    Callableˉresultˉshape.Type
                ) {
                    Enumˉvalues = Enumˉvalues + 1u32;
                }
            }
            Bodyˉbytes = Bodyˉbytes +
                Compilerˉnativeˉx64ˉemittedˉbytes(
                    Input, Section.Payloadˉoffset + Cursor, Opcode,
                    Isˉmain, 0u32, 0u32, Callˉdirectory, 0u8, 4294967295u32,
                    Function.Returnˉtype, Types, Capabilityˉtable
                );
        } else {
        if Opcode == 65u8 || Opcode == 161u8 || Opcode == 162u8 ||
            Opcode == 165u8 || Opcode == 166u8 ||
            Compilerˉnativeˉx64ˉisˉu64ˉbitwise(Opcode) ||
            Compilerˉnativeˉx64ˉdescriptorˉoperation(Opcode) ||
            Compilerˉnativeˉx64ˉnominalˉoperation(Opcode) ||
            Compilerˉnativeˉx64ˉrecordˉoperation(Opcode) ||
            Compilerˉnativeˉx64ˉvariantˉoperation(Opcode) ||
            (Function.Sharedˉvalues && Sharedˉbytes.Legacyˉisˉsupported(Opcode) && Opcode != 7u8) ||
            Sharedˉbytes.Operationˉisˉsupported(Opcode) ||
            Ownedˉcollections.Operationˉisˉsupported(Opcode) ||
            Opcode == 220u8 || Opcode == 221u8 || Opcode == 222u8 ||
            Opcode == 223u8 || Opcode == 224u8 {
            let Valueˉstate: bytes = Compilerˉnativeˉx64ˉblockˉvalueˉstate(
                Stack,
                Depth,
                I32ˉvalues,
                Boolˉvalues,
                Textˉvalues,
                U8ˉvalues,
                U32ˉvalues,
                Bytesˉvalues,
                Enumˉvalues,
                Recordˉvalues,
                Bodyˉbytes
            );
            var Nominalˉstate: bytes = Valueˉstate;
            if Opcode == 225u8 {
                let Borrowˉowner: u32 = Bytesˉreadˉu32ˉlittle(
                    Input, Section.Payloadˉoffset + Cursor + 1u32);
                if Bytesˉreadˉu16ˉlittle(Input, 6u32) != 39u32 ||
                    Borrowˉowner >= Function.Locals ||
                    Bytesˉlength(Function.Localˉborrowˉkinds) != Function.Locals {
                    return Compilerˉnativeˉx64ˉinvalidˉblock();
                }
                let Borrowˉownerˉtype: u8 = Bytesˉreadˉu8(Function.Localˉtypes, Borrowˉowner);
                if !Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉisˉvariant(Borrowˉownerˉtype) ||
                    Bytesˉreadˉu8(Function.Localˉborrowˉkinds, Borrowˉowner) != 0u8 {
                    return Compilerˉnativeˉx64ˉinvalidˉblock();
                }
                let Borrowˉpayload: Nominalˉtypes.Compilerˉnativeˉx64ˉshape =
                    Nominalˉtypes.Compilerˉnativeˉx64ˉfoundationˉborrowˉpayload(
                        Input, Types,
                        Nominalˉtypes.Compilerˉnativeˉx64ˉrecordˉtypeˉindex(Types, Borrowˉownerˉtype),
                        Bytesˉreadˉu32ˉlittle(Input, Section.Payloadˉoffset + Cursor + 5u32),
                        Bytesˉreadˉu32ˉlittle(Input, Section.Payloadˉoffset + Cursor + 9u32));
                if !Borrowˉpayload.Valid { return Compilerˉnativeˉx64ˉinvalidˉblock(); }
            }
            if Compilerˉnativeˉx64ˉvariantˉoperation(Opcode) {
                Nominalˉstate =
                    Variantˉanalysis.Compilerˉnativeˉx64ˉanalyzeˉvariantˉvalue(
                        Input,
                        Section.Payloadˉoffset + Cursor,
                        Opcode,
                        Types,
                        Valueˉstate
                    );
            } else {
                Nominalˉstate =
                    Compilerˉnativeˉx64ˉanalyzeˉnominalˉvalueˉinstruction(
                    Input,
                    Section.Payloadˉoffset + Cursor,
                    Opcode,
                    Valueˉstate,
                    Isˉmain,
                    Types,
                    Function.Localˉtypes,
                    Function.Localˉtypeˉidentities,
                    Function.Localˉborrowˉkinds,
                    Stackˉidentities,
                    Capabilityˉtable
                );
            }
            if !Compilerˉnativeˉx64ˉblockˉvalueˉstateˉisˉvalid(
                Nominalˉstate
            ) {
                return Compilerˉnativeˉx64ˉinvalidˉblock();
            }
            Stack = Compilerˉnativeˉx64ˉblockˉvalueˉstateˉstack(
                Nominalˉstate
            );
            Depth = Bytesˉreadˉu32ˉlittle(Nominalˉstate, 1u32);
            I32ˉvalues = Bytesˉreadˉu32ˉlittle(Nominalˉstate, 5u32);
            Boolˉvalues = Bytesˉreadˉu32ˉlittle(Nominalˉstate, 9u32);
            Textˉvalues = Bytesˉreadˉu32ˉlittle(Nominalˉstate, 13u32);
            U8ˉvalues = Bytesˉreadˉu32ˉlittle(Nominalˉstate, 17u32);
            U32ˉvalues = Bytesˉreadˉu32ˉlittle(Nominalˉstate, 21u32);
            Bytesˉvalues = Bytesˉreadˉu32ˉlittle(Nominalˉstate, 25u32);
            Enumˉvalues = Bytesˉreadˉu32ˉlittle(Nominalˉstate, 29u32);
            Recordˉvalues = Bytesˉreadˉu32ˉlittle(Nominalˉstate, 33u32);
            Bodyˉbytes = Bytesˉreadˉu32ˉlittle(Nominalˉstate, 37u32);
            let Descriptorˉstate: bytes =
                Compilerˉnativeˉx64ˉanalyzeˉdescriptorˉvalueˉinstruction(
                    Input,
                    Section.Payloadˉoffset + Cursor,
                    Opcode,
                    Compilerˉnativeˉx64ˉblockˉvalueˉstate(
                        Stack,
                        Depth,
                        I32ˉvalues,
                        Boolˉvalues,
                        Textˉvalues,
                        U8ˉvalues,
                        U32ˉvalues,
                        Bytesˉvalues,
                        Enumˉvalues,
                        Recordˉvalues,
                        Bodyˉbytes
                    ),
                    Data,
                    Function.Sharedˉvalues
                );
            if !Compilerˉnativeˉx64ˉblockˉvalueˉstateˉisˉvalid(
                Descriptorˉstate
            ) {
                return Compilerˉnativeˉx64ˉinvalidˉblock();
            }
            Stack = Compilerˉnativeˉx64ˉblockˉvalueˉstateˉstack(
                Descriptorˉstate
            );
            Depth = Bytesˉreadˉu32ˉlittle(Descriptorˉstate, 1u32);
