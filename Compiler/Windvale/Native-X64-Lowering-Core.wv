            Boolˉvalues = Bytesˉreadˉu32ˉlittle(Descriptorˉstate, 9u32);
            Textˉvalues = Bytesˉreadˉu32ˉlittle(Descriptorˉstate, 13u32);
            U8ˉvalues = Bytesˉreadˉu32ˉlittle(Descriptorˉstate, 17u32);
            U32ˉvalues = Bytesˉreadˉu32ˉlittle(Descriptorˉstate, 21u32);
            Bytesˉvalues = Bytesˉreadˉu32ˉlittle(Descriptorˉstate, 25u32);
