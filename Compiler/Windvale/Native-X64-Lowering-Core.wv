        return Ownedˉcollections.Operationˉbytes(Opcode);
    }
    if Opcode == 206u8 {
        return Memoryˉbudget.Compilerˉnativeˉx64ˉmemoryˉbudgetˉsplitˉbytes();
    }
    if Opcode == 220u8 {
        return Unsafeˉscratch.Compilerˉnativeˉx64ˉunsafeˉscratchˉbytes(
