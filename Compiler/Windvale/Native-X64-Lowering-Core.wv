                                                    0u32,
                                                    Stackˉdepth
                                                );
                                                Stackˉslots = Bytesˉslice(
                                                    Stackˉslots,
                                                    0u32,
                                                    Stackˉdepth * 4u32
                                                );
                                                let Notˉresult: u32 =
                                                    Function.Locals +
                                                    Analysis.I32ˉslots + Nextˉbool;
                                                Result = Compilerˉnativeˉx64ˉemitˉloadˉeax(
                                                    Result,
                                                    Notˉinput * 16u32
                                                );
                                                Result = Compilerˉnativeˉx64ˉappendˉbyte(
                                                    Result,
