module Compilerˉnativeˉx64ˉlowering profile portable;

enum Compilerˉnativeˉx64ˉstatus {
    Valid = 0;
    Invalidˉwvb = 1;
    Unsupportedˉprofile = 2;
    Unsupportedˉmodule = 3;
    Unsupportedˉfunction = 4;
    Unsupportedˉcode = 5;
    Outputˉlimit = 6;
}

record Compilerˉnativeˉx64ˉsection {
    Valid: bool;
    Payloadˉoffset: u32;
    Payloadˉlength: u32;
    Nextˉoffset: u32;
}

record Compilerˉnativeˉx64ˉstructure {
    Valid: bool;
    Moduleˉoffset: u32;
    Moduleˉlength: u32;
    Capabilitiesˉoffset: u32;
    Capabilitiesˉlength: u32;
    Dataˉoffset: u32;
    Dataˉlength: u32;
    Functionsˉoffset: u32;
    Functionsˉlength: u32;
    Codeˉoffset: u32;
    Codeˉlength: u32;
    Exportsˉoffset: u32;
    Exportsˉlength: u32;
    Typesˉoffset: u32;
    Typesˉlength: u32;
}

record Compilerˉnativeˉx64ˉsummary {
    Status: Compilerˉnativeˉx64ˉstatus;
    Object: bytes;
    Value: i32;
    Abi: u32;
    Codeˉbytes: u32;
}

record Compilerˉnativeˉx64ˉfunction {
    Valid: bool;
    Locals: u32;
    Codeˉlength: u32;
    Maximumˉstack: u32;
}

record Compilerˉnativeˉx64ˉanalysis {
    Valid: bool;
    Values: u32;
    Instructions: u32;
    Bodyˉbytes: u32;
    Returnˉvalue: u32;
    Maximumˉstack: u32;
}

export fn Compilerˉnativeˉx64ˉempty(Input: bytes) -> bytes {
    return Bytesˉslice(Input, 0u32, 0u32);
}

export fn Compilerˉnativeˉx64ˉfailure(
    Input: bytes,
    Status: Compilerˉnativeˉx64ˉstatus
) -> Compilerˉnativeˉx64ˉsummary {
    return Compilerˉnativeˉx64ˉsummary(
        Status,
        Compilerˉnativeˉx64ˉempty(Input),
        0,
        22u32,
        0u32
    );
}

export fn Compilerˉnativeˉx64ˉrangeˉisˉvalid(
    Total: u32,
    Offset: u32,
    Length: u32
) -> bool {
    if Offset > Total { return false; }
    return Length <= Total - Offset;
}

export fn Compilerˉnativeˉx64ˉidentifierˉisˉvalid(
    Input: bytes,
    Offset: u32,
    Length: u32
) -> bool {
    let Total: u32 = Bytesˉlength(Input);
    if Length == 0u32 { return false; }
    if Length > 255u32 { return false; }
    if !Compilerˉnativeˉx64ˉrangeˉisˉvalid(Total, Offset, Length) {
        return false;
    }
    let End: u32 = Offset + Length;
    var Cursor: u32 = Offset;
    var Wordˉstart: bool = true;
    while Cursor < End {
        let Current: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(Input, Cursor));
        var Valid: bool = false;
        if Current >= 65u32 {
            if Current <= 90u32 { Valid = true; }
        }
        if Current >= 97u32 {
            if Current <= 122u32 { Valid = true; }
        }
        if Current == 95u32 { Valid = true; }
        if !Wordˉstart {
            if Current >= 48u32 {
                if Current <= 57u32 { Valid = true; }
            }
        }
        if Valid {
            Wordˉstart = false;
            Cursor = Cursor + 1u32;
        } else {
            if Wordˉstart { return false; }
            if Current != 203u32 { return false; }
            if Cursor + 1u32 >= End { return false; }
            if Bytesˉreadˉu8(Input, Cursor + 1u32) != 137u8 { return false; }
            Wordˉstart = true;
            Cursor = Cursor + 2u32;
        }
    }
    return !Wordˉstart;
}

export fn Compilerˉnativeˉx64ˉreadˉsection(
    Input: bytes,
    Cursor: u32,
    Kind: u8
) -> Compilerˉnativeˉx64ˉsection {
    let Total: u32 = Bytesˉlength(Input);
    if !Compilerˉnativeˉx64ˉrangeˉisˉvalid(Total, Cursor, 8u32) {
        return Compilerˉnativeˉx64ˉsection(false, 0u32, 0u32, 0u32);
    }
    if Bytesˉreadˉu8(Input, Cursor) != Kind {
        return Compilerˉnativeˉx64ˉsection(false, 0u32, 0u32, 0u32);
    }
    if Bytesˉreadˉu8(Input, Cursor + 1u32) != 0u8 {
        return Compilerˉnativeˉx64ˉsection(false, 0u32, 0u32, 0u32);
    }
    if Bytesˉreadˉu16ˉlittle(Input, Cursor + 2u32) != 0u32 {
        return Compilerˉnativeˉx64ˉsection(false, 0u32, 0u32, 0u32);
    }
    let Payloadˉlength: u32 = Bytesˉreadˉu32ˉlittle(Input, Cursor + 4u32);
    let Payloadˉoffset: u32 = Cursor + 8u32;
    if !Compilerˉnativeˉx64ˉrangeˉisˉvalid(
        Total,
        Payloadˉoffset,
        Payloadˉlength
    ) {
        return Compilerˉnativeˉx64ˉsection(false, 0u32, 0u32, 0u32);
    }
    return Compilerˉnativeˉx64ˉsection(
        true,
        Payloadˉoffset,
        Payloadˉlength,
        Payloadˉoffset + Payloadˉlength
    );
}

export fn Compilerˉnativeˉx64ˉinvalidˉstructure()
    -> Compilerˉnativeˉx64ˉstructure {
    return Compilerˉnativeˉx64ˉstructure(
        false,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32
    );
}

export fn Compilerˉnativeˉx64ˉreadˉstructure(Input: bytes)
    -> Compilerˉnativeˉx64ˉstructure {
    let Total: u32 = Bytesˉlength(Input);
    if Total < 12u32 { return Compilerˉnativeˉx64ˉinvalidˉstructure(); }
    if Bytesˉreadˉu8(Input, 0u32) != 87u8 {
        return Compilerˉnativeˉx64ˉinvalidˉstructure();
    }
    if Bytesˉreadˉu8(Input, 1u32) != 86u8 {
        return Compilerˉnativeˉx64ˉinvalidˉstructure();
    }
    if Bytesˉreadˉu8(Input, 2u32) != 66u8 {
        return Compilerˉnativeˉx64ˉinvalidˉstructure();
    }
    if Bytesˉreadˉu8(Input, 3u32) != 49u8 {
        return Compilerˉnativeˉx64ˉinvalidˉstructure();
    }
    if Bytesˉreadˉu16ˉlittle(Input, 4u32) != 1u32 {
        return Compilerˉnativeˉx64ˉinvalidˉstructure();
    }
    if Bytesˉreadˉu16ˉlittle(Input, 6u32) != 6u32 {
        return Compilerˉnativeˉx64ˉinvalidˉstructure();
    }
    if Bytesˉreadˉu32ˉlittle(Input, 8u32) != 7u32 {
        return Compilerˉnativeˉx64ˉinvalidˉstructure();
    }

    let Module: Compilerˉnativeˉx64ˉsection =
        Compilerˉnativeˉx64ˉreadˉsection(Input, 12u32, 1u8);
    if !Module.Valid { return Compilerˉnativeˉx64ˉinvalidˉstructure(); }
    let Capabilities: Compilerˉnativeˉx64ˉsection =
        Compilerˉnativeˉx64ˉreadˉsection(Input, Module.Nextˉoffset, 2u8);
    if !Capabilities.Valid { return Compilerˉnativeˉx64ˉinvalidˉstructure(); }
    let Data: Compilerˉnativeˉx64ˉsection =
        Compilerˉnativeˉx64ˉreadˉsection(Input, Capabilities.Nextˉoffset, 3u8);
    if !Data.Valid { return Compilerˉnativeˉx64ˉinvalidˉstructure(); }
    let Functions: Compilerˉnativeˉx64ˉsection =
        Compilerˉnativeˉx64ˉreadˉsection(Input, Data.Nextˉoffset, 4u8);
    if !Functions.Valid { return Compilerˉnativeˉx64ˉinvalidˉstructure(); }
    let Code: Compilerˉnativeˉx64ˉsection =
        Compilerˉnativeˉx64ˉreadˉsection(Input, Functions.Nextˉoffset, 5u8);
    if !Code.Valid { return Compilerˉnativeˉx64ˉinvalidˉstructure(); }
    let Exports: Compilerˉnativeˉx64ˉsection =
        Compilerˉnativeˉx64ˉreadˉsection(Input, Code.Nextˉoffset, 6u8);
    if !Exports.Valid { return Compilerˉnativeˉx64ˉinvalidˉstructure(); }
    let Types: Compilerˉnativeˉx64ˉsection =
        Compilerˉnativeˉx64ˉreadˉsection(Input, Exports.Nextˉoffset, 7u8);
    if !Types.Valid { return Compilerˉnativeˉx64ˉinvalidˉstructure(); }
    if Types.Nextˉoffset != Total {
        return Compilerˉnativeˉx64ˉinvalidˉstructure();
    }
    return Compilerˉnativeˉx64ˉstructure(
        true,
        Module.Payloadˉoffset,
        Module.Payloadˉlength,
        Capabilities.Payloadˉoffset,
        Capabilities.Payloadˉlength,
        Data.Payloadˉoffset,
        Data.Payloadˉlength,
        Functions.Payloadˉoffset,
        Functions.Payloadˉlength,
        Code.Payloadˉoffset,
        Code.Payloadˉlength,
        Exports.Payloadˉoffset,
        Exports.Payloadˉlength,
        Types.Payloadˉoffset,
        Types.Payloadˉlength
    );
}

export fn Compilerˉnativeˉx64ˉmainˉnameˉat(Input: bytes, Offset: u32) -> bool {
    if Bytesˉreadˉu8(Input, Offset) != 77u8 { return false; }
    if Bytesˉreadˉu8(Input, Offset + 1u32) != 97u8 { return false; }
    if Bytesˉreadˉu8(Input, Offset + 2u32) != 105u8 { return false; }
    return Bytesˉreadˉu8(Input, Offset + 3u32) == 110u8;
}

export fn Compilerˉnativeˉx64ˉmoduleˉisˉvalid(
    Input: bytes,
    Section: Compilerˉnativeˉx64ˉsection
) -> bool {
    if Section.Payloadˉlength < 5u32 { return false; }
    let Nameˉlength: u32 =
        Bytesˉreadˉu32ˉlittle(Input, Section.Payloadˉoffset + 1u32);
    if Nameˉlength != Section.Payloadˉlength - 5u32 { return false; }
    return Compilerˉnativeˉx64ˉidentifierˉisˉvalid(
        Input,
        Section.Payloadˉoffset + 5u32,
        Nameˉlength
    );
}

export fn Compilerˉnativeˉx64ˉinvalidˉfunction()
    -> Compilerˉnativeˉx64ˉfunction {
    return Compilerˉnativeˉx64ˉfunction(false, 0u32, 0u32, 0u32);
}

export fn Compilerˉnativeˉx64ˉreadˉfunction(
    Input: bytes,
    Section: Compilerˉnativeˉx64ˉsection
) -> Compilerˉnativeˉx64ˉfunction {
    if Section.Payloadˉlength < 33u32 {
        return Compilerˉnativeˉx64ˉinvalidˉfunction();
    }
    let Offset: u32 = Section.Payloadˉoffset;
    if Bytesˉreadˉu32ˉlittle(Input, Offset) != 1u32 {
        return Compilerˉnativeˉx64ˉinvalidˉfunction();
    }
    if Bytesˉreadˉu32ˉlittle(Input, Offset + 4u32) != 4u32 {
        return Compilerˉnativeˉx64ˉinvalidˉfunction();
    }
    if !Compilerˉnativeˉx64ˉmainˉnameˉat(Input, Offset + 8u32) {
        return Compilerˉnativeˉx64ˉinvalidˉfunction();
    }
    if Bytesˉreadˉu32ˉlittle(Input, Offset + 12u32) != 0u32 {
        return Compilerˉnativeˉx64ˉinvalidˉfunction();
    }
    if Bytesˉreadˉu8(Input, Offset + 16u32) != 1u8 {
        return Compilerˉnativeˉx64ˉinvalidˉfunction();
    }
    let Locals: u32 = Bytesˉreadˉu32ˉlittle(Input, Offset + 17u32);
    if Locals > 1024u32 {
        return Compilerˉnativeˉx64ˉinvalidˉfunction();
    }
    if Section.Payloadˉlength != 33u32 + Locals {
        return Compilerˉnativeˉx64ˉinvalidˉfunction();
    }
    var Local: u32 = 0u32;
    while Local < Locals {
        if Bytesˉreadˉu8(Input, Offset + 21u32 + Local) != 1u8 {
            return Compilerˉnativeˉx64ˉinvalidˉfunction();
        }
        Local = Local + 1u32;
    }
    let Metadata: u32 = Offset + 21u32 + Locals;
    if Bytesˉreadˉu32ˉlittle(Input, Metadata) != 0u32 {
        return Compilerˉnativeˉx64ˉinvalidˉfunction();
    }
    let Codeˉlength: u32 = Bytesˉreadˉu32ˉlittle(Input, Metadata + 4u32);
    let Maximumˉstack: u32 = Bytesˉreadˉu32ˉlittle(Input, Metadata + 8u32);
    if Codeˉlength == 0u32 { return Compilerˉnativeˉx64ˉinvalidˉfunction(); }
    if Codeˉlength > 8192u32 { return Compilerˉnativeˉx64ˉinvalidˉfunction(); }
    if Maximumˉstack == 0u32 { return Compilerˉnativeˉx64ˉinvalidˉfunction(); }
    if Maximumˉstack > 1024u32 { return Compilerˉnativeˉx64ˉinvalidˉfunction(); }
    return Compilerˉnativeˉx64ˉfunction(
        true,
        Locals,
        Codeˉlength,
        Maximumˉstack
    );
}

export fn Compilerˉnativeˉx64ˉexportˉisˉsupported(
    Input: bytes,
    Section: Compilerˉnativeˉx64ˉsection
) -> bool {
    if Section.Payloadˉlength != 17u32 { return false; }
    let Offset: u32 = Section.Payloadˉoffset;
    if Bytesˉreadˉu32ˉlittle(Input, Offset) != 1u32 { return false; }
    if Bytesˉreadˉu32ˉlittle(Input, Offset + 4u32) != 4u32 { return false; }
    if !Compilerˉnativeˉx64ˉmainˉnameˉat(Input, Offset + 8u32) {
        return false;
    }
    if Bytesˉreadˉu8(Input, Offset + 12u32) != 1u8 { return false; }
    return Bytesˉreadˉu32ˉlittle(Input, Offset + 13u32) == 0u32;
}

export fn Compilerˉnativeˉx64ˉemptyˉanalysis()
    -> Compilerˉnativeˉx64ˉanalysis {
    return Compilerˉnativeˉx64ˉanalysis(
        false,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32
    );
}

export fn Compilerˉnativeˉx64ˉanalyzeˉcode(
    Input: bytes,
    Section: Compilerˉnativeˉx64ˉsection,
    Function: Compilerˉnativeˉx64ˉfunction
) -> Compilerˉnativeˉx64ˉanalysis {
    if Section.Payloadˉlength != Function.Codeˉlength {
        return Compilerˉnativeˉx64ˉemptyˉanalysis();
    }
    var Stack: bytes = Compilerˉnativeˉx64ˉempty(Input);
    var Stackˉdepth: u32 = 0u32;
    var Maximumˉstack: u32 = 0u32;
    var Values: u32 = 0u32;
    var Instructions: u32 = 0u32;
    var Bodyˉbytes: u32 = 0u32;
    var Returnˉvalue: u32 = 0u32;
    var Returned: bool = false;
    var Cursor: u32 = 0u32;
    while Cursor < Section.Payloadˉlength {
        if Returned { return Compilerˉnativeˉx64ˉemptyˉanalysis(); }
        let Opcode: u8 = Bytesˉreadˉu8(Input, Section.Payloadˉoffset + Cursor);
        Instructions = Instructions + 1u32;
        if Instructions > 1024u32 {
            return Compilerˉnativeˉx64ˉemptyˉanalysis();
        }
        if Opcode == 1u8 {
            if Section.Payloadˉlength - Cursor < 5u32 {
                return Compilerˉnativeˉx64ˉemptyˉanalysis();
            }
            Stack = Bytesˉconcat(Stack, Bytesˉfromˉu32ˉlittle(Values));
            Stackˉdepth = Stackˉdepth + 1u32;
            Values = Values + 1u32;
            Bodyˉbytes = Bodyˉbytes + 22u32;
            Cursor = Cursor + 5u32;
        } else {
            if Opcode == 4u8 {
                if Section.Payloadˉlength - Cursor < 5u32 {
                    return Compilerˉnativeˉx64ˉemptyˉanalysis();
                }
                let Loadˉindex: u32 = Bytesˉreadˉu32ˉlittle(
                    Input,
                    Section.Payloadˉoffset + Cursor + 1u32
                );
                if Loadˉindex >= Function.Locals {
                    return Compilerˉnativeˉx64ˉemptyˉanalysis();
                }
                Stack = Bytesˉconcat(Stack, Bytesˉfromˉu32ˉlittle(Values));
                Stackˉdepth = Stackˉdepth + 1u32;
                Values = Values + 1u32;
                Bodyˉbytes = Bodyˉbytes + 24u32;
                Cursor = Cursor + 5u32;
            } else {
                if Opcode == 5u8 {
                    if Section.Payloadˉlength - Cursor < 5u32 {
                        return Compilerˉnativeˉx64ˉemptyˉanalysis();
                    }
                    let Storeˉindex: u32 = Bytesˉreadˉu32ˉlittle(
                        Input,
                        Section.Payloadˉoffset + Cursor + 1u32
                    );
                    if Storeˉindex >= Function.Locals {
                        return Compilerˉnativeˉx64ˉemptyˉanalysis();
                    }
                    if Stackˉdepth == 0u32 {
                        return Compilerˉnativeˉx64ˉemptyˉanalysis();
                    }
                    Stackˉdepth = Stackˉdepth - 1u32;
                    Stack = Bytesˉslice(Stack, 0u32, Stackˉdepth * 4u32);
                    Bodyˉbytes = Bodyˉbytes + 24u32;
                    Cursor = Cursor + 5u32;
                } else {
                    if Opcode == 16u8 {
                        if Stackˉdepth < 2u32 {
                            return Compilerˉnativeˉx64ˉemptyˉanalysis();
                        }
                        Stackˉdepth = Stackˉdepth - 2u32;
                        Stack = Bytesˉslice(Stack, 0u32, Stackˉdepth * 4u32);
                        Stack = Bytesˉconcat(Stack, Bytesˉfromˉu32ˉlittle(Values));
                        Stackˉdepth = Stackˉdepth + 1u32;
                        Values = Values + 1u32;
                        Bodyˉbytes = Bodyˉbytes + 39u32;
                        Cursor = Cursor + 1u32;
                    } else {
                        if Opcode == 17u8 {
                            if Stackˉdepth < 2u32 {
                                return Compilerˉnativeˉx64ˉemptyˉanalysis();
                            }
                            Stackˉdepth = Stackˉdepth - 2u32;
                            Stack = Bytesˉslice(Stack, 0u32, Stackˉdepth * 4u32);
                            Stack = Bytesˉconcat(Stack, Bytesˉfromˉu32ˉlittle(Values));
                            Stackˉdepth = Stackˉdepth + 1u32;
                            Values = Values + 1u32;
                            Bodyˉbytes = Bodyˉbytes + 39u32;
                            Cursor = Cursor + 1u32;
                        } else {
                            if Opcode == 18u8 {
                                if Stackˉdepth < 2u32 {
                                    return Compilerˉnativeˉx64ˉemptyˉanalysis();
                                }
                                Stackˉdepth = Stackˉdepth - 2u32;
                                Stack = Bytesˉslice(Stack, 0u32, Stackˉdepth * 4u32);
                                Stack = Bytesˉconcat(Stack, Bytesˉfromˉu32ˉlittle(Values));
                                Stackˉdepth = Stackˉdepth + 1u32;
                                Values = Values + 1u32;
                                Bodyˉbytes = Bodyˉbytes + 40u32;
                                Cursor = Cursor + 1u32;
                            } else {
                                if Opcode == 19u8 {
                                    if Stackˉdepth == 0u32 {
                                        return Compilerˉnativeˉx64ˉemptyˉanalysis();
                                    }
                                    Stackˉdepth = Stackˉdepth - 1u32;
                                    Stack = Bytesˉslice(Stack, 0u32, Stackˉdepth * 4u32);
                                    Stack = Bytesˉconcat(
                                        Stack,
                                        Bytesˉfromˉu32ˉlittle(Values)
                                    );
                                    Stackˉdepth = Stackˉdepth + 1u32;
                                    Values = Values + 1u32;
                                    Bodyˉbytes = Bodyˉbytes + 32u32;
                                    Cursor = Cursor + 1u32;
                                } else {
                                    if Opcode != 81u8 {
                                        return Compilerˉnativeˉx64ˉemptyˉanalysis();
                                    }
                                    if Stackˉdepth != 1u32 {
                                        return Compilerˉnativeˉx64ˉemptyˉanalysis();
                                    }
                                    Returnˉvalue = Bytesˉreadˉu32ˉlittle(Stack, 0u32);
                                    Stackˉdepth = 0u32;
                                    Stack = Compilerˉnativeˉx64ˉempty(Input);
                                    Bodyˉbytes = Bodyˉbytes + 30u32;
                                    Cursor = Cursor + 1u32;
                                    Returned = true;
                                }
                            }
                        }
                    }
                }
            }
        }
        if Stackˉdepth > Maximumˉstack { Maximumˉstack = Stackˉdepth; }
        if Values > 2048u32 - Function.Locals {
            return Compilerˉnativeˉx64ˉemptyˉanalysis();
        }
    }
    if !Returned { return Compilerˉnativeˉx64ˉemptyˉanalysis(); }
    if Maximumˉstack != Function.Maximumˉstack {
        return Compilerˉnativeˉx64ˉemptyˉanalysis();
    }
    return Compilerˉnativeˉx64ˉanalysis(
        true,
        Values,
        Instructions,
        Bodyˉbytes,
        Returnˉvalue,
        Maximumˉstack
    );
}

export fn Compilerˉnativeˉx64ˉi32ˉbits(Value: i32) -> u32 {
    let Encoded: bytes = Textˉtoˉutf8(I32ˉformat(Value));
    let Length: u32 = Bytesˉlength(Encoded);
    var Cursor: u32 = 0u32;
    var Negative: bool = false;
    if Bytesˉreadˉu8(Encoded, 0u32) == 45u8 {
        Negative = true;
        Cursor = 1u32;
    }
    var Magnitude: u32 = 0u32;
    while Cursor < Length {
        let Digit: u32 =
            U32ˉfromˉu8(Bytesˉreadˉu8(Encoded, Cursor)) - 48u32;
        Magnitude = Magnitude * 10u32 + Digit;
        Cursor = Cursor + 1u32;
    }
    if Negative {
        return 4294967295u32 - Magnitude + 1u32;
    }
    return Magnitude;
}

export fn Compilerˉnativeˉx64ˉappendˉi32(Result: bytes, Value: i32) -> bytes {
    return Bytesˉconcat(
        Result,
        Bytesˉfromˉu32ˉlittle(Compilerˉnativeˉx64ˉi32ˉbits(Value))
    );
}

export fn Compilerˉnativeˉx64ˉappendˉbyte(Result: bytes, Value: u8) -> bytes {
    return Bytesˉconcat(Result, Bytesˉfromˉu8(Value));
}

export fn Compilerˉnativeˉx64ˉappendˉu32(Result: bytes, Value: u32) -> bytes {
    return Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Value));
}

export fn Compilerˉnativeˉx64ˉemitˉframe(
    Result: bytes,
    Subtract: bool,
    Frameˉbytes: u32
) -> bytes {
    var Output: bytes = Compilerˉnativeˉx64ˉappendˉbyte(Result, 72u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 129u8);
    if Subtract {
        Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 236u8);
    } else {
        Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 196u8);
    }
    return Compilerˉnativeˉx64ˉappendˉu32(Output, Frameˉbytes);
}

export fn Compilerˉnativeˉx64ˉemitˉloadˉeax(
    Result: bytes,
    Offset: u32
) -> bytes {
    var Output: bytes = Compilerˉnativeˉx64ˉappendˉbyte(Result, 139u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 132u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 36u8);
    return Compilerˉnativeˉx64ˉappendˉu32(Output, Offset);
}

export fn Compilerˉnativeˉx64ˉemitˉloadˉecx(
    Result: bytes,
    Offset: u32
) -> bytes {
    var Output: bytes = Compilerˉnativeˉx64ˉappendˉbyte(Result, 139u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 140u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 36u8);
    return Compilerˉnativeˉx64ˉappendˉu32(Output, Offset);
}

export fn Compilerˉnativeˉx64ˉemitˉstoreˉeax(
    Result: bytes,
    Offset: u32
) -> bytes {
    var Output: bytes = Compilerˉnativeˉx64ˉappendˉbyte(Result, 137u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 132u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 36u8);
    return Compilerˉnativeˉx64ˉappendˉu32(Output, Offset);
}

export fn Compilerˉnativeˉx64ˉemitˉrestore(Result: bytes) -> bytes {
    var Output: bytes = Compilerˉnativeˉx64ˉappendˉbyte(Result, 73u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 255u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 194u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 65u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 95u8);
    return Compilerˉnativeˉx64ˉappendˉbyte(Output, 195u8);
}

export fn Compilerˉnativeˉx64ˉemitˉcharge(
    Result: bytes,
    Target: u32
) -> bytes {
    var Output: bytes = Compilerˉnativeˉx64ˉappendˉbyte(Result, 73u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 131u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 235u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 1u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 15u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 130u8);
    return Compilerˉnativeˉx64ˉappendˉu32(
        Output,
        Target - Bytesˉlength(Output) - 4u32
    );
}

export fn Compilerˉnativeˉx64ˉemitˉoverflowˉbranch(
    Result: bytes,
    Target: u32
) -> bytes {
    var Output: bytes = Compilerˉnativeˉx64ˉappendˉbyte(Result, 15u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 128u8);
    return Compilerˉnativeˉx64ˉappendˉu32(
        Output,
        Target - Bytesˉlength(Output) - 4u32
    );
}

export fn Compilerˉnativeˉx64ˉemitˉstatus(
    Result: bytes,
    Frameˉbytes: u32,
    Statusˉhigh: u32
) -> bytes {
    var Output: bytes = Compilerˉnativeˉx64ˉemitˉframe(
        Result,
        false,
        Frameˉbytes
    );
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 73u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 255u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 194u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 72u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 184u8);
    Output = Compilerˉnativeˉx64ˉappendˉu32(Output, 0u32);
    Output = Compilerˉnativeˉx64ˉappendˉu32(Output, Statusˉhigh);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 65u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 95u8);
    return Compilerˉnativeˉx64ˉappendˉbyte(Output, 195u8);
}

export fn Compilerˉnativeˉx64ˉemitˉcode(
    Input: bytes,
    Section: Compilerˉnativeˉx64ˉsection,
    Function: Compilerˉnativeˉx64ˉfunction,
    Analysis: Compilerˉnativeˉx64ˉanalysis
) -> bytes {
    let Slots: u32 = Function.Locals + Analysis.Values;
    let Frameˉbytes: u32 = Slots * 16u32;
    let Prologueˉbytes: u32 = 32u32 + Slots * 28u32;
    let Propagateˉoffset: u32 = Prologueˉbytes + Analysis.Bodyˉbytes;
    let Overflowˉoffset: u32 = Propagateˉoffset + 13u32;
    let Instructionˉlimitˉoffset: u32 = Overflowˉoffset + 23u32;
    let Depthˉoffset: u32 = Overflowˉoffset + 161u32;
    var Result: bytes = Compilerˉnativeˉx64ˉempty(Input);

    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 65u8);
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 87u8);
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 73u8);
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 137u8);
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 215u8);
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 77u8);
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 139u8);
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 95u8);
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 8u8);
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 77u8);
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 139u8);
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 87u8);
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 16u8);
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 73u8);
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 131u8);
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 234u8);
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 1u8);
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 15u8);
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 130u8);
    Result = Compilerˉnativeˉx64ˉappendˉu32(
        Result,
        Depthˉoffset - Bytesˉlength(Result) - 4u32
    );
    Result = Compilerˉnativeˉx64ˉemitˉframe(Result, true, Frameˉbytes);
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 49u8);
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 192u8);
    var Zeroˉoffset: u32 = 0u32;
    while Zeroˉoffset < Frameˉbytes {
        Result = Compilerˉnativeˉx64ˉemitˉstoreˉeax(Result, Zeroˉoffset);
        Zeroˉoffset = Zeroˉoffset + 4u32;
    }

    var Stack: bytes = Compilerˉnativeˉx64ˉempty(Input);
    var Stackˉdepth: u32 = 0u32;
    var Nextˉvalue: u32 = 0u32;
    var Cursor: u32 = 0u32;
    while Cursor < Section.Payloadˉlength {
        let Opcode: u8 = Bytesˉreadˉu8(Input, Section.Payloadˉoffset + Cursor);
        Result = Compilerˉnativeˉx64ˉemitˉcharge(
            Result,
            Instructionˉlimitˉoffset
        );
        if Opcode == 1u8 {
            Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 184u8);
            Result = Compilerˉnativeˉx64ˉappendˉi32(
                Result,
                Bytesˉreadˉi32ˉlittle(Input, Section.Payloadˉoffset + Cursor + 1u32)
            );
            Result = Compilerˉnativeˉx64ˉemitˉstoreˉeax(
                Result,
                (Function.Locals + Nextˉvalue) * 16u32
            );
            Stack = Bytesˉconcat(Stack, Bytesˉfromˉu32ˉlittle(Nextˉvalue));
            Stackˉdepth = Stackˉdepth + 1u32;
            Nextˉvalue = Nextˉvalue + 1u32;
            Cursor = Cursor + 5u32;
        } else {
            if Opcode == 4u8 {
                let Loadˉlocal: u32 = Bytesˉreadˉu32ˉlittle(
                    Input,
                    Section.Payloadˉoffset + Cursor + 1u32
                );
                Result = Compilerˉnativeˉx64ˉemitˉloadˉeax(
                    Result,
                    Loadˉlocal * 16u32
                );
                Result = Compilerˉnativeˉx64ˉemitˉstoreˉeax(
                    Result,
                    (Function.Locals + Nextˉvalue) * 16u32
                );
                Stack = Bytesˉconcat(Stack, Bytesˉfromˉu32ˉlittle(Nextˉvalue));
                Stackˉdepth = Stackˉdepth + 1u32;
                Nextˉvalue = Nextˉvalue + 1u32;
                Cursor = Cursor + 5u32;
            } else {
                if Opcode == 5u8 {
                    let Storeˉlocal: u32 = Bytesˉreadˉu32ˉlittle(
                        Input,
                        Section.Payloadˉoffset + Cursor + 1u32
                    );
                    let Storeˉvalue: u32 = Bytesˉreadˉu32ˉlittle(
                        Stack,
                        (Stackˉdepth - 1u32) * 4u32
                    );
                    Stackˉdepth = Stackˉdepth - 1u32;
                    Stack = Bytesˉslice(Stack, 0u32, Stackˉdepth * 4u32);
                    Result = Compilerˉnativeˉx64ˉemitˉloadˉeax(
                        Result,
                        (Function.Locals + Storeˉvalue) * 16u32
                    );
                    Result = Compilerˉnativeˉx64ˉemitˉstoreˉeax(
                        Result,
                        Storeˉlocal * 16u32
                    );
                    Cursor = Cursor + 5u32;
                } else {
                    if Opcode == 16u8 {
                        let Addˉright: u32 = Bytesˉreadˉu32ˉlittle(
                            Stack,
                            (Stackˉdepth - 1u32) * 4u32
                        );
                        let Addˉleft: u32 = Bytesˉreadˉu32ˉlittle(
                            Stack,
                            (Stackˉdepth - 2u32) * 4u32
                        );
                        Stackˉdepth = Stackˉdepth - 2u32;
                        Stack = Bytesˉslice(Stack, 0u32, Stackˉdepth * 4u32);
                        Result = Compilerˉnativeˉx64ˉemitˉloadˉeax(
                            Result,
                            (Function.Locals + Addˉleft) * 16u32
                        );
                        Result = Compilerˉnativeˉx64ˉemitˉloadˉecx(
                            Result,
                            (Function.Locals + Addˉright) * 16u32
                        );
                        Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 1u8);
                        Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 200u8);
                        Result = Compilerˉnativeˉx64ˉemitˉoverflowˉbranch(
                            Result,
                            Overflowˉoffset
                        );
                        Result = Compilerˉnativeˉx64ˉemitˉstoreˉeax(
                            Result,
                            (Function.Locals + Nextˉvalue) * 16u32
                        );
                        Stack = Bytesˉconcat(
                            Stack,
                            Bytesˉfromˉu32ˉlittle(Nextˉvalue)
                        );
                        Stackˉdepth = Stackˉdepth + 1u32;
                        Nextˉvalue = Nextˉvalue + 1u32;
                        Cursor = Cursor + 1u32;
                    } else {
                        if Opcode == 17u8 {
                            let Subtractˉright: u32 = Bytesˉreadˉu32ˉlittle(
                                Stack,
                                (Stackˉdepth - 1u32) * 4u32
                            );
                            let Subtractˉleft: u32 = Bytesˉreadˉu32ˉlittle(
                                Stack,
                                (Stackˉdepth - 2u32) * 4u32
                            );
                            Stackˉdepth = Stackˉdepth - 2u32;
                            Stack = Bytesˉslice(Stack, 0u32, Stackˉdepth * 4u32);
                            Result = Compilerˉnativeˉx64ˉemitˉloadˉeax(
                                Result,
                                (Function.Locals + Subtractˉleft) * 16u32
                            );
                            Result = Compilerˉnativeˉx64ˉemitˉloadˉecx(
                                Result,
                                (Function.Locals + Subtractˉright) * 16u32
                            );
                            Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 41u8);
                            Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 200u8);
                            Result = Compilerˉnativeˉx64ˉemitˉoverflowˉbranch(
                                Result,
                                Overflowˉoffset
                            );
                            Result = Compilerˉnativeˉx64ˉemitˉstoreˉeax(
                                Result,
                                (Function.Locals + Nextˉvalue) * 16u32
                            );
                            Stack = Bytesˉconcat(
                                Stack,
                                Bytesˉfromˉu32ˉlittle(Nextˉvalue)
                            );
                            Stackˉdepth = Stackˉdepth + 1u32;
                            Nextˉvalue = Nextˉvalue + 1u32;
                            Cursor = Cursor + 1u32;
                        } else {
                            if Opcode == 18u8 {
                                let Multiplyˉright: u32 = Bytesˉreadˉu32ˉlittle(
                                    Stack,
                                    (Stackˉdepth - 1u32) * 4u32
                                );
                                let Multiplyˉleft: u32 = Bytesˉreadˉu32ˉlittle(
                                    Stack,
                                    (Stackˉdepth - 2u32) * 4u32
                                );
                                Stackˉdepth = Stackˉdepth - 2u32;
                                Stack = Bytesˉslice(Stack, 0u32, Stackˉdepth * 4u32);
                                Result = Compilerˉnativeˉx64ˉemitˉloadˉeax(
                                    Result,
                                    (Function.Locals + Multiplyˉleft) * 16u32
                                );
                                Result = Compilerˉnativeˉx64ˉemitˉloadˉecx(
                                    Result,
                                    (Function.Locals + Multiplyˉright) * 16u32
                                );
                                Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 15u8);
                                Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 175u8);
                                Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 193u8);
                                Result = Compilerˉnativeˉx64ˉemitˉoverflowˉbranch(
                                    Result,
                                    Overflowˉoffset
                                );
                                Result = Compilerˉnativeˉx64ˉemitˉstoreˉeax(
                                    Result,
                                    (Function.Locals + Nextˉvalue) * 16u32
                                );
                                Stack = Bytesˉconcat(
                                    Stack,
                                    Bytesˉfromˉu32ˉlittle(Nextˉvalue)
                                );
                                Stackˉdepth = Stackˉdepth + 1u32;
                                Nextˉvalue = Nextˉvalue + 1u32;
                                Cursor = Cursor + 1u32;
                            } else {
                                if Opcode == 19u8 {
                                    let Negateˉvalue: u32 = Bytesˉreadˉu32ˉlittle(
                                        Stack,
                                        (Stackˉdepth - 1u32) * 4u32
                                    );
                                    Stackˉdepth = Stackˉdepth - 1u32;
                                    Stack = Bytesˉslice(
                                        Stack,
                                        0u32,
                                        Stackˉdepth * 4u32
                                    );
                                    Result = Compilerˉnativeˉx64ˉemitˉloadˉeax(
                                        Result,
                                        (Function.Locals + Negateˉvalue) * 16u32
                                    );
                                    Result = Compilerˉnativeˉx64ˉappendˉbyte(
                                        Result,
                                        247u8
                                    );
                                    Result = Compilerˉnativeˉx64ˉappendˉbyte(
                                        Result,
                                        216u8
                                    );
                                    Result = Compilerˉnativeˉx64ˉemitˉoverflowˉbranch(
                                        Result,
                                        Overflowˉoffset
                                    );
                                    Result = Compilerˉnativeˉx64ˉemitˉstoreˉeax(
                                        Result,
                                        (Function.Locals + Nextˉvalue) * 16u32
                                    );
                                    Stack = Bytesˉconcat(
                                        Stack,
                                        Bytesˉfromˉu32ˉlittle(Nextˉvalue)
                                    );
                                    Stackˉdepth = Stackˉdepth + 1u32;
                                    Nextˉvalue = Nextˉvalue + 1u32;
                                    Cursor = Cursor + 1u32;
                                } else {
                                    let Returnˉvalue: u32 = Bytesˉreadˉu32ˉlittle(
                                        Stack,
                                        (Stackˉdepth - 1u32) * 4u32
                                    );
                                    Stackˉdepth = Stackˉdepth - 1u32;
                                    Stack = Bytesˉslice(
                                        Stack,
                                        0u32,
                                        Stackˉdepth * 4u32
                                    );
                                    Result = Compilerˉnativeˉx64ˉemitˉloadˉeax(
                                        Result,
                                        (Function.Locals + Returnˉvalue) * 16u32
                                    );
                                    Result = Compilerˉnativeˉx64ˉemitˉframe(
                                        Result,
                                        false,
                                        Frameˉbytes
                                    );
                                    Result = Compilerˉnativeˉx64ˉemitˉrestore(Result);
                                    Cursor = Cursor + 1u32;
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    Result = Compilerˉnativeˉx64ˉemitˉframe(Result, false, Frameˉbytes);
    Result = Compilerˉnativeˉx64ˉemitˉrestore(Result);
    Result = Compilerˉnativeˉx64ˉemitˉstatus(Result, Frameˉbytes, 1u32);
    Result = Compilerˉnativeˉx64ˉemitˉstatus(Result, Frameˉbytes, 2u32);
    Result = Compilerˉnativeˉx64ˉemitˉstatus(Result, Frameˉbytes, 4u32);
    Result = Compilerˉnativeˉx64ˉemitˉstatus(Result, Frameˉbytes, 6u32);
    Result = Compilerˉnativeˉx64ˉemitˉstatus(Result, Frameˉbytes, 5u32);
    Result = Compilerˉnativeˉx64ˉemitˉstatus(Result, Frameˉbytes, 8u32);
    Result = Compilerˉnativeˉx64ˉemitˉstatus(Result, Frameˉbytes, 7u32);
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 73u8);
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 255u8);
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 194u8);
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 72u8);
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 184u8);
    Result = Compilerˉnativeˉx64ˉappendˉu32(Result, 0u32);
    Result = Compilerˉnativeˉx64ˉappendˉu32(Result, 3u32);
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 65u8);
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 95u8);
    return Compilerˉnativeˉx64ˉappendˉbyte(Result, 195u8);
}

export fn Compilerˉnativeˉx64ˉemitˉobject(Input: bytes, Code: bytes) -> bytes {
    let Codeˉlength: u32 = Bytesˉlength(Code);
    var Result: bytes = Textˉtoˉutf8("WVO1");
    Result = Bytesˉconcat(Result, Bytesˉfromˉu16ˉlittle(1u32));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu16ˉlittle(0u32));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu8(1u8));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu8(0u8));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu16ˉlittle(0u32));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(1u32));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(1u32));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(0u32));

    Result = Bytesˉconcat(Result, Bytesˉfromˉu8(1u8));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu8(0u8));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu16ˉlittle(0u32));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(16u32));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Codeˉlength));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Codeˉlength));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(5u32));
    Result = Bytesˉconcat(Result, Textˉtoˉutf8(".text"));
    Result = Bytesˉconcat(Result, Code);

    Result = Bytesˉconcat(Result, Bytesˉfromˉu8(2u8));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu8(1u8));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu16ˉlittle(0u32));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(0u32));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(0u32));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Codeˉlength));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(4u32));
    return Bytesˉconcat(Result, Textˉtoˉutf8("Main"));
}

export fn Compilerˉlowerˉwvbˉnativeˉx64(Input: bytes)
    -> Compilerˉnativeˉx64ˉsummary {
    let Structure: Compilerˉnativeˉx64ˉstructure =
        Compilerˉnativeˉx64ˉreadˉstructure(Input);
    if !Structure.Valid {
        return Compilerˉnativeˉx64ˉfailure(
            Input,
            Compilerˉnativeˉx64ˉstatus.Invalidˉwvb
        );
    }
    let Module: Compilerˉnativeˉx64ˉsection = Compilerˉnativeˉx64ˉsection(
        true,
        Structure.Moduleˉoffset,
        Structure.Moduleˉlength,
        0u32
    );
    if !Compilerˉnativeˉx64ˉmoduleˉisˉvalid(Input, Module) {
        return Compilerˉnativeˉx64ˉfailure(
            Input,
            Compilerˉnativeˉx64ˉstatus.Invalidˉwvb
        );
    }
    if Bytesˉreadˉu8(Input, Structure.Moduleˉoffset) != 1u8 {
        return Compilerˉnativeˉx64ˉfailure(
            Input,
            Compilerˉnativeˉx64ˉstatus.Unsupportedˉprofile
        );
    }
    if Structure.Capabilitiesˉlength != 4u32 {
        return Compilerˉnativeˉx64ˉfailure(
            Input,
            Compilerˉnativeˉx64ˉstatus.Unsupportedˉmodule
        );
    }
    if Bytesˉreadˉu32ˉlittle(Input, Structure.Capabilitiesˉoffset) != 0u32 {
        return Compilerˉnativeˉx64ˉfailure(
            Input,
            Compilerˉnativeˉx64ˉstatus.Unsupportedˉmodule
        );
    }
    if Structure.Dataˉlength != 4u32 {
        return Compilerˉnativeˉx64ˉfailure(
            Input,
            Compilerˉnativeˉx64ˉstatus.Unsupportedˉmodule
        );
    }
    if Bytesˉreadˉu32ˉlittle(Input, Structure.Dataˉoffset) != 0u32 {
        return Compilerˉnativeˉx64ˉfailure(
            Input,
            Compilerˉnativeˉx64ˉstatus.Unsupportedˉmodule
        );
    }
    if Structure.Typesˉlength != 4u32 {
        return Compilerˉnativeˉx64ˉfailure(
            Input,
            Compilerˉnativeˉx64ˉstatus.Unsupportedˉmodule
        );
    }
    if Bytesˉreadˉu32ˉlittle(Input, Structure.Typesˉoffset) != 0u32 {
        return Compilerˉnativeˉx64ˉfailure(
            Input,
            Compilerˉnativeˉx64ˉstatus.Unsupportedˉmodule
        );
    }
    let Functions: Compilerˉnativeˉx64ˉsection = Compilerˉnativeˉx64ˉsection(
        true,
        Structure.Functionsˉoffset,
        Structure.Functionsˉlength,
        0u32
    );
    let Function: Compilerˉnativeˉx64ˉfunction =
        Compilerˉnativeˉx64ˉreadˉfunction(Input, Functions);
    if !Function.Valid {
        return Compilerˉnativeˉx64ˉfailure(
            Input,
            Compilerˉnativeˉx64ˉstatus.Unsupportedˉfunction
        );
    }
    let Exports: Compilerˉnativeˉx64ˉsection = Compilerˉnativeˉx64ˉsection(
        true,
        Structure.Exportsˉoffset,
        Structure.Exportsˉlength,
        0u32
    );
    if !Compilerˉnativeˉx64ˉexportˉisˉsupported(Input, Exports) {
        return Compilerˉnativeˉx64ˉfailure(
            Input,
            Compilerˉnativeˉx64ˉstatus.Unsupportedˉfunction
        );
    }
    let Codeˉsection: Compilerˉnativeˉx64ˉsection = Compilerˉnativeˉx64ˉsection(
        true,
        Structure.Codeˉoffset,
        Structure.Codeˉlength,
        0u32
    );
    let Analysis: Compilerˉnativeˉx64ˉanalysis =
        Compilerˉnativeˉx64ˉanalyzeˉcode(Input, Codeˉsection, Function);
    if !Analysis.Valid {
        return Compilerˉnativeˉx64ˉfailure(
            Input,
            Compilerˉnativeˉx64ˉstatus.Unsupportedˉcode
        );
    }

    let Expectedˉcodeˉbytes: u32 =
        222u32 + (Function.Locals + Analysis.Values) * 28u32 +
        Analysis.Bodyˉbytes;
    if Expectedˉcodeˉbytes > 33554432u32 {
        return Compilerˉnativeˉx64ˉfailure(
            Input,
            Compilerˉnativeˉx64ˉstatus.Outputˉlimit
        );
    }
    let Code: bytes = Compilerˉnativeˉx64ˉemitˉcode(
        Input,
        Codeˉsection,
        Function,
        Analysis
    );
    if Bytesˉlength(Code) != Expectedˉcodeˉbytes {
        return Compilerˉnativeˉx64ˉfailure(
            Input,
            Compilerˉnativeˉx64ˉstatus.Outputˉlimit
        );
    }
    let Object: bytes = Compilerˉnativeˉx64ˉemitˉobject(Input, Code);
    if Bytesˉlength(Object) != Expectedˉcodeˉbytes + 73u32 {
        return Compilerˉnativeˉx64ˉfailure(
            Input,
            Compilerˉnativeˉx64ˉstatus.Outputˉlimit
        );
    }
    return Compilerˉnativeˉx64ˉsummary(
        Compilerˉnativeˉx64ˉstatus.Valid,
        Object,
        0,
        22u32,
        Expectedˉcodeˉbytes
    );
}
