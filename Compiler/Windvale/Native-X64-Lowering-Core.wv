                                Result,
                                Storeˉlocal * 16u32
                            );
                        }
                    } else {
                        let Numericˉopcode: u32 = U32ˉfromˉu8(Opcode);
                        if Numericˉopcode >= 16u32 {
                            if Numericˉopcode <= 18u32 || Numericˉopcode == 20u32 {
                                var Binaryˉtype: u8 = 1u8;
                                var Binaryˉindex: u32 = Nextˉi32;
                                if Numericˉopcode >= 20u32 {
                                    Binaryˉtype = 5u8;
                                    Binaryˉindex = Nextˉu32;
                                }
                                let Binaryˉright: u32 = Bytesˉreadˉu32ˉlittle(
                                    Stackˉslots,
                                    (Stackˉdepth - 1u32) * 4u32
                                );
                                let Binaryˉleft: u32 = Bytesˉreadˉu32ˉlittle(
