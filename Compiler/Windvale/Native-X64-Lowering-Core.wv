        if Capabilityˉkind ==
            Nativeˉcapabilities.Compilerˉnativeˉx64ˉconsoleˉwriteˉlineˉkind() ||
            Capabilityˉkind ==
            Nativeˉcapabilities.Compilerˉnativeˉx64ˉdiagnosticˉwriteˉlineˉkind() {
            return Nativeˉcapabilities.Compilerˉnativeˉx64ˉtextˉoutputˉbytes();
        }
        if Capabilityˉkind ==
            Nativeˉcapabilities.Compilerˉnativeˉx64ˉprocessˉargumentˉkind() {
            return Nativeˉcapabilities.Compilerˉnativeˉx64ˉprocessˉargumentˉbytes();
        }
        if Capabilityˉkind ==
            Nativeˉcapabilities.Compilerˉnativeˉx64ˉfileˉreadˉbytesˉkind() {
            return Nativeˉcapabilities.Compilerˉnativeˉx64ˉfileˉreadˉbytesˉbytes();
        }
        if Capabilityˉkind ==
            Nativeˉcapabilities.Compilerˉnativeˉx64ˉfileˉwriteˉbytesˉkind() {
            return Nativeˉcapabilities.Compilerˉnativeˉx64ˉfileˉwriteˉbytesˉbytes();
        }
        if Capabilityˉkind ==
            Nativeˉcapabilities.Compilerˉnativeˉx64ˉstorageˉrandomˉaccessˉkind() {
            return Nativeˉcapabilities.Compilerˉnativeˉx64ˉstorageˉrandomˉaccessˉbytes();
        }
        if Capabilityˉkind ==
            Nativeˉcapabilities.Compilerˉnativeˉx64ˉdirectoryˉreadˉkind() {
            return Nativeˉcapabilities.Compilerˉnativeˉx64ˉdirectoryˉreadˉbytes();
        }
        if Capabilityˉkind ==
                Nativeˉcapabilities.Compilerˉnativeˉx64ˉmodelˉcatalogˉkind() ||
            Capabilityˉkind ==
                Nativeˉcapabilities.Compilerˉnativeˉx64ˉmodelˉinferenceˉkind() ||
            Capabilityˉkind ==
                Nativeˉcapabilities.Compilerˉnativeˉx64ˉstandardˉoutputˉwriteˉkind() ||
            Capabilityˉkind ==
                Nativeˉcapabilities.Compilerˉnativeˉx64ˉterminalˉlineˉreadˉkind() {
            return Nativeˉcapabilities.Compilerˉnativeˉx64ˉmodelˉcallˉbytes();
        }
        return Nativeˉcapabilities.Compilerˉnativeˉx64ˉprocessˉargumentˉcountˉbytes();
    }
    if Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉisˉrecord(
        Functionˉreturnˉtype
    ) {
        let Returnˉtypeˉindex: u32 =
            Nominalˉtypes.Compilerˉnativeˉx64ˉrecordˉtypeˉindex(Types,
                Functionˉreturnˉtype
            );
        return Records.Compilerˉnativeˉx64ˉrecordˉreturnˉbytes(Input, Types, Returnˉtypeˉindex);
    }
    if Descriptorˉcalls.Compilerˉnativeˉx64ˉtypeˉisˉdescriptor(
        Functionˉreturnˉtype
    ) {
        return Descriptorˉcalls.Compilerˉnativeˉx64ˉdescriptorˉreturnˉbytes(
            Isˉmain
        );
    }
    if Functionˉreturnˉtype == 0u8 { return 23u32; }
    if Functionˉreturnˉtype == 9u8 || Functionˉreturnˉtype == 10u8 {
        return 31u32;
    }
    if Isˉmain { return 30u32; }
    return 28u32;
}

export fn Compilerˉnativeˉx64ˉblockˉid(
    Blockˉoffsets: bytes,
    Offset: u32
) -> u32 {
    if Bytesˉlength(Blockˉoffsets) % 4u32 != 0u32 {
        return 4294967295u32;
    }
    let Count: u32 = Bytesˉlength(Blockˉoffsets) / 4u32;
    var First: u32 = 0u32;
    var Limit: u32 = Count;
    while First < Limit {
        let Middle: u32 = First + (Limit - First) / 2u32;
        let Candidate: u32 = Bytesˉreadˉu32ˉlittle(
            Blockˉoffsets,
            Middle * 4u32
        );
        if Candidate < Offset {
            First = Middle + 1u32;
        } else {
            Limit = Middle;
        }
    }
    if First < Count {
        if Bytesˉreadˉu32ˉlittle(Blockˉoffsets, First * 4u32) == Offset {
            return First;
        }
    }
    return 4294967295u32;
}

export fn Compilerˉnativeˉx64ˉbuildˉblockˉoffsets(
    Input: bytes,
    Section: Compilerˉnativeˉx64ˉsection,
    Leaders: bytes,
    Prologueˉbytes: u32,
    Isˉmain: bool,
    Callˉdirectory: bytes,
    Function: Compilerˉnativeˉx64ˉfunction,
    Types: Nominalˉtypes.Compilerˉnativeˉx64ˉtypes,
    Capabilityˉtable: Nativeˉcapabilities.Compilerˉnativeˉx64ˉcapabilities,
    Reclamation: bytes,
    Ownedˉlocals: bytes,
    Instructionˉsizes: bytes
) -> bytes {
    var Result: bytes = Compilerˉnativeˉx64ˉempty(Input);
    var Machine: u32 = Prologueˉbytes;
    var Cursor: u32 = 0u32;
    var Block: u32 = 0u32;
    while Cursor < Section.Payloadˉlength {
        if Bytesˉreadˉu8(Leaders, Cursor) == 1u8 {
            Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Machine));
            Machine = Machine + Bytesˉlength(Liveˉstorage.Compilerˉnativeˉx64ˉliveˉstorageˉblock(Reclamation, Block));
            Block = Block + 1u32;
        }
        let Opcode: u8 = Bytesˉreadˉu8(Input, Section.Payloadˉoffset + Cursor);
        var Callˉparameters: u32 = 0u32;
        var Callˉtarget: u32 = 0u32;
        var Localˉtype: u8 = 0u8;
        var Localˉidentity: u32 = 4294967295u32;
        if Opcode == 4u8 || Opcode == 5u8 || Opcode == 205u8 {
            Localˉtype = Bytesˉreadˉu8(
                Function.Localˉtypes,
                Bytesˉreadˉu32ˉlittle(
                    Input,
                    Section.Payloadˉoffset + Cursor + 1u32
                )
            );
            Localˉidentity = Bytesˉreadˉu32ˉlittle(Function.Localˉtypeˉidentities,
                Bytesˉreadˉu32ˉlittle(Input, Section.Payloadˉoffset + Cursor + 1u32) * 4u32);
        }
        if Opcode == 64u8 {
            Callˉtarget = Bytesˉreadˉu32ˉlittle(
                Input,
                Section.Payloadˉoffset + Cursor + 1u32
            );
            Callˉparameters = Layout.Compilerˉnativeˉx64ˉlayoutˉparameters(
                Callˉdirectory,
                Callˉtarget
            );
        }
        Machine = Machine + Ownedˉframes.Hookˉbytes(
            Input, Section.Payloadˉoffset + Cursor, Opcode, Ownedˉlocals);
        if Function.Sharedˉvalues {
            Machine = Machine + Compilerˉnativeˉx64ˉinstructionˉmachineˉbytes(Instructionˉsizes, Cursor);
        } else {
        Machine = Machine + Compilerˉnativeˉx64ˉemittedˉbytes(
            Input,
            Section.Payloadˉoffset + Cursor,
            Opcode,
            Isˉmain,
            Callˉparameters,
            Callˉtarget,
            Callˉdirectory,
            Localˉtype,
            Localˉidentity,
            Function.Returnˉtype,
            Types,
            Capabilityˉtable
        );
        }
        Cursor = Cursor + Compilerˉnativeˉx64ˉinstructionˉsize(Opcode);
    }
    return Result;
}
fn Compilerˉnativeˉx64ˉinstructionˉmetadataˉoffset(Sizes: bytes, Offset: u32) -> u32 {
    var First: u32 = 0u32;
    var Limit: u32 = Bytesˉlength(Sizes) / 16u32;
    while First < Limit {
        let Middle: u32 = First + (Limit - First) / 2u32;
        let Candidate: u32 = Bytesˉreadˉu32ˉlittle(Sizes, Middle * 16u32);
        if Candidate < Offset { First = Middle + 1u32; }
        else { Limit = Middle; }
    }
    if First < Bytesˉlength(Sizes) / 16u32 && Bytesˉreadˉu32ˉlittle(Sizes, First * 16u32) == Offset {
        return First * 16u32;
    }
    return 4294967295u32;
}
fn Compilerˉnativeˉx64ˉinstructionˉmachineˉbytes(Sizes: bytes, Offset: u32) -> u32 {
    let Row: u32 = Compilerˉnativeˉx64ˉinstructionˉmetadataˉoffset(Sizes, Offset);
    if Row == 4294967295u32 { return 0u32; }
    return Bytesˉreadˉu32ˉlittle(Sizes, Row + 4u32);
}


fn Compilerˉnativeˉx64ˉframeˉslots(
    Function: Compilerˉnativeˉx64ˉfunction,
    Analysis: Compilerˉnativeˉx64ˉcontrolˉanalysis
) -> u32 {
    var Checkpoint: u32 = 0u32;
    if Bytesˉlength(Analysis.Reclamation) > 0u32 { Checkpoint = 1u32; }
    if Function.Sharedˉvalues { Checkpoint = Sharedˉbytes.Requestˉslots() + 1u32; }
    return Function.Locals + Analysis.I32ˉslots + Analysis.Boolˉslots +
        Analysis.Textˉslots + Analysis.U8ˉslots + Analysis.U32ˉslots +
        Analysis.Bytesˉslots + Analysis.Enumˉslots + Analysis.Recordˉslots +
        Analysis.Recordˉpersistentˉfields + Analysis.Recordˉscratchˉfields +
        Compilerˉnativeˉx64ˉhiddenˉresultˉslots(Function.Returnˉtype) +
        Analysis.Callableˉenvironmentˉslots +
        Analysis.Callableˉcaptureˉslots + Analysis.Unsafeˉbackingˉslots +
        Ownedˉframes.Slots(Analysis.Ownedˉlocals) + Checkpoint;
}
fn Compilerˉnativeˉx64ˉsharedˉrequestˉslot(
    Function: Compilerˉnativeˉx64ˉfunction,
    Analysis: Compilerˉnativeˉx64ˉcontrolˉanalysis
) -> u32 {
    if !Function.Sharedˉvalues { return 0u32; }
    return Compilerˉnativeˉx64ˉframeˉslots(Function, Analysis) - Sharedˉbytes.Requestˉslots();
}

fn Compilerˉnativeˉx64ˉsharedˉreturnˉslot(Function: Compilerˉnativeˉx64ˉfunction,
    Analysis: Compilerˉnativeˉx64ˉcontrolˉanalysis) -> u32 {
    return Compilerˉnativeˉx64ˉframeˉslots(Function, Analysis) - Sharedˉbytes.Requestˉslots() - 1u32;
}
fn Compilerˉnativeˉx64ˉsharedˉframeˉbytes(Frame: u32) -> u32 {
    return ((Frame + 4095u32) / 4096u32) * 11u32;
}
fn Compilerˉnativeˉx64ˉemitˉsharedˉframe(Initial: bytes, Frame: u32) -> bytes {
    var Output: bytes = Initial;
    var Remaining: u32 = Frame;
    while Remaining > 0u32 {
        var Chunk: u32 = Remaining;
        if Chunk > 4096u32 { Chunk = 4096u32; }
        Output = Compilerˉnativeˉx64ˉemitˉframe(Output, true, Chunk);
        Output = Bytesˉconcat(Output, Bytesˉfromˉu32ˉlittle(2360566u32));
        Remaining = Remaining - Chunk;
    }
    return Output;
}
fn Compilerˉnativeˉx64ˉownedˉframeˉbase(
    Function: Compilerˉnativeˉx64ˉfunction,
    Analysis: Compilerˉnativeˉx64ˉcontrolˉanalysis
) -> u32 {
    var Checkpoint: u32 = 0u32;
    if Bytesˉlength(Analysis.Reclamation) > 0u32 { Checkpoint = 1u32; }
    return (Compilerˉnativeˉx64ˉframeˉslots(Function, Analysis) -
        Ownedˉframes.Slots(Analysis.Ownedˉlocals) - Checkpoint) * 16u32;
}

fn Compilerˉnativeˉx64ˉunsafeˉbackingˉbase(
    Function: Compilerˉnativeˉx64ˉfunction,
    Analysis: Compilerˉnativeˉx64ˉcontrolˉanalysis
) -> u32 {
    return Compilerˉnativeˉx64ˉframeˉslots(Function, Analysis) -
        Ownedˉframes.Slots(Analysis.Ownedˉlocals) -
        Analysis.Unsafeˉbackingˉslots;
}

fn Compilerˉnativeˉx64ˉcallableˉenvironmentˉbase(
    Function: Compilerˉnativeˉx64ˉfunction,
    Analysis: Compilerˉnativeˉx64ˉcontrolˉanalysis
) -> u32 {
    return Function.Locals + Analysis.I32ˉslots + Analysis.Boolˉslots +
        Analysis.Textˉslots + Analysis.U8ˉslots + Analysis.U32ˉslots +
        Analysis.Bytesˉslots + Analysis.Enumˉslots + Analysis.Recordˉslots +
        Analysis.Recordˉpersistentˉfields + Analysis.Recordˉscratchˉfields +
        Compilerˉnativeˉx64ˉhiddenˉresultˉslots(Function.Returnˉtype);
}

fn Compilerˉnativeˉx64ˉcallableˉcaptureˉbase(
    Function: Compilerˉnativeˉx64ˉfunction,
    Analysis: Compilerˉnativeˉx64ˉcontrolˉanalysis
) -> u32 {
    return Compilerˉnativeˉx64ˉcallableˉenvironmentˉbase(
        Function, Analysis
    ) + Analysis.Callableˉenvironmentˉslots;
}

fn Compilerˉnativeˉx64ˉdescriptorˉresultˉslots(
    Returnˉtype: u8
) -> u32 {
    if Descriptorˉcalls.Compilerˉnativeˉx64ˉtypeˉisˉdescriptor(Returnˉtype) {
        return 1u32;
    }
    return 0u32;
}

fn Compilerˉnativeˉx64ˉhiddenˉresultˉslot(
    Function: Compilerˉnativeˉx64ˉfunction,
    Analysis: Compilerˉnativeˉx64ˉcontrolˉanalysis
) -> u32 {
    let Valueˉslots: u32 = Function.Locals + Analysis.I32ˉslots +
        Analysis.Boolˉslots + Analysis.Textˉslots + Analysis.U8ˉslots +
        Analysis.U32ˉslots + Analysis.Bytesˉslots + Analysis.Enumˉslots +
        Analysis.Recordˉslots;
    if Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉisˉrecord(
        Function.Returnˉtype
    ) {
        return Valueˉslots + Analysis.Recordˉpersistentˉfields +
            Analysis.Recordˉscratchˉfields;
    }
    return Valueˉslots;
}

fn Compilerˉnativeˉx64ˉprologueˉbytes(
    Function: Compilerˉnativeˉx64ˉfunction,
    Analysis: Compilerˉnativeˉx64ˉcontrolˉanalysis,
    Isˉmain: bool
) -> u32 {
    let Frameˉbytes: u32 =
        Compilerˉnativeˉx64ˉframeˉslots(Function, Analysis) * 16u32;
    var Base: u32 = 19u32;
    if Isˉmain { Base = 32u32; }
    let Record: bool = Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉisˉrecord(
        Function.Returnˉtype
    );
    let Descriptor: bool =
        Descriptorˉcalls.Compilerˉnativeˉx64ˉtypeˉisˉdescriptor(
            Function.Returnˉtype
        );
    var Zeroˉbytes: u32 =
        Compilerˉnativeˉx64ˉzeroˉrangeˉbytes(Frameˉbytes);
    if Record || Descriptor {
        // Hidden-result save and checkpoint add 19 bytes for helpers;
        // descriptor Main saves RCX in 11 bytes and has no checkpoint.
        Base = 38u32;
        if Isˉmain { Base = 43u32; }
        let Hiddenˉoffset: u32 =
            Compilerˉnativeˉx64ˉhiddenˉresultˉslot(Function, Analysis) * 16u32;
        Zeroˉbytes = Compilerˉnativeˉx64ˉzeroˉrangeˉbytes(Hiddenˉoffset) +
            Compilerˉnativeˉx64ˉzeroˉrangeˉbytes(
                Frameˉbytes - Hiddenˉoffset - 16u32
            );
    }
    if Function.Sharedˉvalues {
        if (Record || Descriptor) && !Isˉmain { Base = Base - 11u32; }
        Base = Base - 7u32 + Compilerˉnativeˉx64ˉsharedˉframeˉbytes(Frameˉbytes);
    }
    if Bytesˉlength(Analysis.Reclamation) > 0u32 { Base = Base + 11u32; }
    return Base + Zeroˉbytes +
        Ownedˉframes.Prologueˉbytes(Analysis.Ownedˉlocals, Function.Parameters) +
        Compilerˉnativeˉx64ˉentryˉparameterˉbytes(Function, Isˉmain);
}

export fn Compilerˉnativeˉx64ˉcollectˉdataˉrelocations(
    Input: bytes,
    Section: Compilerˉnativeˉx64ˉsection,
    Function: Compilerˉnativeˉx64ˉfunction,
    Analysis: Compilerˉnativeˉx64ˉcontrolˉanalysis,
    Isˉmain: bool,
    Codeˉbase: u32,
    Callˉdirectory: bytes,
    Types: Nominalˉtypes.Compilerˉnativeˉx64ˉtypes,
    Capabilityˉtable: Nativeˉcapabilities.Compilerˉnativeˉx64ˉcapabilities
) -> bytes {
    var Machine: u32 = Compilerˉnativeˉx64ˉprologueˉbytes(
        Function, Analysis, Isˉmain
    );
    var Result: bytes = Compilerˉnativeˉx64ˉempty(Input);
    var Cursor: u32 = 0u32;
    var Block: u32 = 0u32;
    while Cursor < Section.Payloadˉlength {
        if Bytesˉreadˉu8(Analysis.Leaders, Cursor) == 1u8 {
            Machine = Machine + Bytesˉlength(Liveˉstorage.Compilerˉnativeˉx64ˉliveˉstorageˉblock(Analysis.Reclamation, Block));
            Block = Block + 1u32;
        }
        let Opcode: u8 = Bytesˉreadˉu8(Input, Section.Payloadˉoffset + Cursor);
        var Callˉparameters: u32 = 0u32;
        var Callˉtarget: u32 = 0u32;
        var Localˉtype: u8 = 0u8;
        var Localˉidentity: u32 = 4294967295u32;
        if Opcode == 4u8 || Opcode == 5u8 || Opcode == 205u8 {
            Localˉtype = Bytesˉreadˉu8(
                Function.Localˉtypes,
                Bytesˉreadˉu32ˉlittle(
                    Input,
                    Section.Payloadˉoffset + Cursor + 1u32
                )
            );
            Localˉidentity = Bytesˉreadˉu32ˉlittle(Function.Localˉtypeˉidentities,
                Bytesˉreadˉu32ˉlittle(Input, Section.Payloadˉoffset + Cursor + 1u32) * 4u32);
        }
        if Opcode == 64u8 {
            Callˉtarget = Bytesˉreadˉu32ˉlittle(
                Input,
                Section.Payloadˉoffset + Cursor + 1u32
            );
            Callˉparameters = Layout.Compilerˉnativeˉx64ˉlayoutˉparameters(
                Callˉdirectory,
                Callˉtarget
            );
        }
        Machine = Machine + Ownedˉframes.Hookˉbytes(
            Input, Section.Payloadˉoffset + Cursor, Opcode, Analysis.Ownedˉlocals);
        if Opcode == 7u8 && !Function.Sharedˉvalues {
            Result = Bytesˉconcat(
                Result,
                Bytesˉfromˉu32ˉlittle(Codeˉbase + Machine + 31u32)
            );
            Result = Bytesˉconcat(
                Result,
                Bytesˉfromˉu32ˉlittle(Bytesˉreadˉu32ˉlittle(
                    Input,
                    Section.Payloadˉoffset + Cursor + 1u32
                ))
            );
        }
        if (Opcode == 3u8 || Opcode == 10u8) && !Function.Sharedˉvalues {
            Result = Bytesˉconcat(
                Result,
                Bytesˉfromˉu32ˉlittle(Codeˉbase + Machine + 13u32)
            );
            Result = Bytesˉconcat(
                Result,
                Bytesˉfromˉu32ˉlittle(Bytesˉreadˉu32ˉlittle(
                    Input,
                    Section.Payloadˉoffset + Cursor + 1u32
                ))
            );
        }
        if Opcode == 224u8 {
            Result = Bytesˉconcat(
                Result,
                Bytesˉfromˉu32ˉlittle(
                    Codeˉbase + Machine +
                        Foreignˉcall.Compilerˉnativeˉx64ˉforeignˉcallˉrelocationˉoffset(
                            Isˉmain
                        )
                )
            );
            // The object writer maps this private sentinel to the one exact
            // registered imported function symbol.
            Result = Bytesˉconcat(
                Result,
                Bytesˉfromˉu32ˉlittle(4294967295u32)
            );
        }
        if Function.Sharedˉvalues {
            Machine = Machine + Compilerˉnativeˉx64ˉinstructionˉmachineˉbytes(Analysis.Instructionˉsizes, Cursor);
        } else {
        Machine = Machine + Compilerˉnativeˉx64ˉemittedˉbytes(
            Input,
            Section.Payloadˉoffset + Cursor,
            Opcode,
            Isˉmain,
            Callˉparameters,
            Callˉtarget,
            Callˉdirectory,
            Localˉtype,
            Localˉidentity,
            Function.Returnˉtype,
            Types,
            Capabilityˉtable
        );
        }
        Cursor = Cursor + Compilerˉnativeˉx64ˉinstructionˉsize(Opcode);
    }
    return Result;
}

fn Compilerˉnativeˉx64ˉmeasureˉdataˉrelocations(
    Input: bytes,
    Section: Compilerˉnativeˉx64ˉsection
) -> u32 {
    var Relocationˉbytes: u32 = 0u32;
    var Cursor: u32 = 0u32;
    while Cursor < Section.Payloadˉlength {
        let Opcode: u8 = Bytesˉreadˉu8(
            Input,
            Section.Payloadˉoffset + Cursor
        );
        if ((Opcode == 3u8 || Opcode == 7u8 || Opcode == 10u8) && !Nominalˉtypes.Compilerˉnativeˉx64ˉsharedˉminor(Bytesˉreadˉu16ˉlittle(Input, 6u32))) ||
            Opcode == 224u8 {
            Relocationˉbytes = Relocationˉbytes + 8u32;
        }
        Cursor = Cursor + Compilerˉnativeˉx64ˉinstructionˉsize(Opcode);
    }
    return Relocationˉbytes;
}

export fn Compilerˉnativeˉx64ˉmachineˉtarget(
    Wvbˉblockˉoffsets: bytes,
    Blockˉoffsets: bytes,
    Wvbˉoffset: u32
) -> u32 {
    return Bytesˉreadˉu32ˉlittle(
        Blockˉoffsets,
        Compilerˉnativeˉx64ˉblockˉid(
            Wvbˉblockˉoffsets,
            Wvbˉoffset
        ) * 4u32
    );
}

fn Compilerˉnativeˉx64ˉhiddenˉresultˉslots(
    Returnˉtype: u8
) -> u32 {
    if Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉisˉrecord(Returnˉtype) {
        return 1u32;
    }
    if Descriptorˉcalls.Compilerˉnativeˉx64ˉtypeˉisˉdescriptor(Returnˉtype) {
        return 1u32;
    }
    return 0u32;
}

export fn Compilerˉnativeˉx64ˉrelativeˉu32(
    Target: u32,
    Origin: u32
) -> u32 {
    if Target >= Origin { return Target - Origin; }
    let Magnitude: u32 = Origin - Target;
    return 4294967295u32 - Magnitude + 1u32;
}

export fn Compilerˉnativeˉx64ˉemitˉjump(
    Result: bytes,
    Target: u32
) -> bytes {
    var Output: bytes = Compilerˉnativeˉx64ˉappendˉbyte(Result, 233u8);
    return Compilerˉnativeˉx64ˉappendˉu32(
        Output,
        Compilerˉnativeˉx64ˉrelativeˉu32(
            Target,
            Bytesˉlength(Output) + 4u32
        )
    );
}

export fn Compilerˉnativeˉx64ˉcomparisonˉcondition(Opcode: u8) -> u8 {
    if Opcode == 32u8 { return 148u8; }
    if Opcode == 33u8 { return 149u8; }
    if Opcode == 34u8 { return 156u8; }
    if Opcode == 35u8 { return 158u8; }
    if Opcode == 36u8 { return 159u8; }
    if Opcode == 37u8 { return 157u8; }
    if Opcode == 38u8 { return 148u8; }
    if Opcode == 137u8 { return 148u8; }
    if Opcode == 138u8 { return 149u8; }
    if Opcode == 139u8 { return 156u8; }
    if Opcode == 140u8 { return 158u8; }
    if Opcode == 141u8 { return 159u8; }
    if Opcode == 142u8 { return 157u8; }
    if Opcode == 96u8 { return 148u8; }
    if Opcode == 97u8 { return 149u8; }
    if Opcode == 98u8 { return 146u8; }
    if Opcode == 99u8 { return 150u8; }
    if Opcode == 100u8 { return 151u8; }
    if Opcode == 101u8 { return 147u8; }
    if Opcode == 102u8 { return 148u8; }
    if Opcode == 103u8 { return 149u8; }
    if Opcode == 143u8 { return 148u8; }
    if Opcode == 144u8 { return 149u8; }
    if Opcode == 145u8 { return 146u8; }
    if Opcode == 146u8 { return 150u8; }
    if Opcode == 147u8 { return 151u8; }
    if Opcode == 148u8 { return 147u8; }
    return 149u8;
}

export fn Compilerˉnativeˉx64ˉemitˉcomparison(
    Result: bytes,
    Leftˉslot: u32,
    Rightˉslot: u32,
    Condition: u8,
    Resultˉslot: u32
) -> bytes {
    var Output: bytes = Compilerˉnativeˉx64ˉemitˉloadˉeax(
        Result,
        Leftˉslot * 16u32
    );
    Output = Compilerˉnativeˉx64ˉemitˉloadˉecx(Output, Rightˉslot * 16u32);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 57u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 200u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 15u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, Condition);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 192u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 15u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 182u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 192u8);
    return Compilerˉnativeˉx64ˉemitˉstoreˉeax(
        Output,
        Resultˉslot * 16u32
    );
}

export fn Compilerˉnativeˉx64ˉemitˉwideˉcomparison(
    Result: bytes,
    Leftˉslot: u32,
    Rightˉslot: u32,
    Condition: u8,
    Resultˉslot: u32
) -> bytes {
    var Output: bytes = Compilerˉnativeˉx64ˉemitˉloadˉrax(
        Result,
        Leftˉslot * 16u32
    );
    Output = Compilerˉnativeˉx64ˉemitˉloadˉrcx(Output, Rightˉslot * 16u32);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 72u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 57u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 200u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 15u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, Condition);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 192u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 15u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 182u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 192u8);
    return Compilerˉnativeˉx64ˉemitˉstoreˉeax(
        Output,
        Resultˉslot * 16u32
    );
}

export fn Compilerˉnativeˉx64ˉemitˉconditionalˉbranch(
    Result: bytes,
    Conditionˉslot: u32,
    Trueˉtarget: u32,
    Falseˉtarget: u32
) -> bytes {
    var Output: bytes = Compilerˉnativeˉx64ˉemitˉloadˉeax(
        Result,
        Conditionˉslot * 16u32
    );
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 133u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 192u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 15u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 133u8);
    Output = Compilerˉnativeˉx64ˉappendˉu32(
        Output,
        Compilerˉnativeˉx64ˉrelativeˉu32(
            Trueˉtarget,
            Bytesˉlength(Output) + 4u32
        )
    );
    return Compilerˉnativeˉx64ˉemitˉjump(Output, Falseˉtarget);
}

fn Compilerˉnativeˉx64ˉemitˉsharedˉconditionalˉbranch(Input: bytes, Initial: bytes,
    Function: Compilerˉnativeˉx64ˉfunction, Types: Nominalˉtypes.Compilerˉnativeˉx64ˉtypes,
    Liveness: Sharedˉlocalˉliveness.Plan, Offset: u32, Next: u32, Target: u32,
    Conditionˉslot: u32, Trueˉtarget: u32, Falseˉtarget: u32,
    Request: u32, Helper: u32, Codeˉbase: u32, Invalid: u32) -> bytes {
    let Instruction: u32 = Sharedˉlocalˉliveness.Rowˉindex(Liveness, Offset);
    let Trueˉrow: u32 = Sharedˉlocalˉliveness.Rowˉindex(Liveness, Next);
    let Falseˉrow: u32 = Sharedˉlocalˉliveness.Rowˉindex(Liveness, Target);
    if Instruction == 4294967295u32 || Trueˉrow == 4294967295u32 || Falseˉrow == 4294967295u32 {
        return Compilerˉnativeˉx64ˉempty(Input);
    }
    let Trueˉcleanup: u32 = Compilerˉnativeˉx64ˉsharedˉcleanupˉbytes(Input, Function, Types,
        Liveness, Instruction, 0u32, 49u8, Trueˉrow);
    let Falseˉcleanup: u32 = Compilerˉnativeˉx64ˉsharedˉcleanupˉbytes(Input, Function, Types,
        Liveness, Instruction, 0u32, 49u8, Falseˉrow);
    if Trueˉcleanup > 67108859u32 || Falseˉcleanup > 67108859u32 {
        return Compilerˉnativeˉx64ˉempty(Input);
    }
    // Select the edge before cleanup can clobber condition registers. Each
    // nonempty stub ends in a five-byte jump to the original successor.
    var Trueˉbranch: u32 = Trueˉtarget;
    var Falseˉbranch: u32 = Falseˉtarget;
    var Stub: u32 = Bytesˉlength(Initial) + 20u32;
    if Trueˉcleanup != 0u32 {
        Trueˉbranch = Stub;
        Stub = Stub + Trueˉcleanup + 5u32;
    }
    if Falseˉcleanup != 0u32 { Falseˉbranch = Stub; }
    var Output: bytes = Compilerˉnativeˉx64ˉemitˉconditionalˉbranch(
        Initial, Conditionˉslot, Trueˉbranch, Falseˉbranch);
    if Trueˉcleanup != 0u32 {
        Output = Compilerˉnativeˉx64ˉsharedˉcleanup(Input, Output, Function, Types,
            Liveness, Instruction, 0u32, 49u8, Trueˉrow, Request, Helper, Codeˉbase, Invalid);
        Output = Compilerˉnativeˉx64ˉemitˉjump(Output, Trueˉtarget);
    }
    if Falseˉcleanup != 0u32 {
        Output = Compilerˉnativeˉx64ˉsharedˉcleanup(Input, Output, Function, Types,
            Liveness, Instruction, 0u32, 49u8, Falseˉrow, Request, Helper, Codeˉbase, Invalid);
        Output = Compilerˉnativeˉx64ˉemitˉjump(Output, Falseˉtarget);
    }
    return Output;
}

fn Compilerˉnativeˉx64ˉemitˉrecordˉstep(
    Input: bytes,
    Offset: u32,
    Opcode: u8,
    Function: Compilerˉnativeˉx64ˉfunction,
    Analysis: Compilerˉnativeˉx64ˉcontrolˉanalysis,
    Types: Nominalˉtypes.Compilerˉnativeˉx64ˉtypes,
    Scratchˉbase: u32,
    State: Recordˉinstructions.Compilerˉnativeˉx64ˉrecordˉstate
) -> Recordˉinstructions.Compilerˉnativeˉx64ˉrecordˉstate {
    let Recordˉbase: u32 = Function.Locals + Analysis.I32ˉslots +
        Analysis.Boolˉslots + Analysis.Textˉslots + Analysis.U8ˉslots +
        Analysis.U32ˉslots + Analysis.Bytesˉslots + Analysis.Enumˉslots;
    let Persistentˉbase: u32 = Recordˉbase + Analysis.Recordˉslots +
        Compilerˉnativeˉx64ˉdescriptorˉresultˉslots(
            Function.Returnˉtype
        );
    return Recordˉinstructions.Compilerˉnativeˉx64ˉemitˉrecordˉinstruction(
        Recordˉinstructions.Compilerˉnativeˉx64ˉrecordˉinstruction(
            Input,
            Offset,
            Opcode
        ),
        Recordˉinstructions.Compilerˉnativeˉx64ˉrecordˉlayout(
            Function.Locals,
            Analysis.I32ˉslots,
            Analysis.Boolˉslots,
            Analysis.Textˉslots,
            Analysis.U8ˉslots,
            Analysis.U32ˉslots,
            Analysis.Bytesˉslots,
            Recordˉbase,
            Persistentˉbase,
            Persistentˉbase + Analysis.Recordˉpersistentˉfields
        ),
        Function.Localˉtypes,
        Types,
        Recordˉstorage.Compilerˉnativeˉx64ˉrecordˉstorage(
            true,
            Analysis.Recordˉpersistentˉoffsets,
            Bytesˉslice(
                Analysis.Recordˉscratchˉoffsets,
                Scratchˉbase * 4u32,
                Bytesˉlength(Analysis.Recordˉscratchˉoffsets) -
                    Scratchˉbase * 4u32
            ),
            Analysis.Recordˉscratchˉblockˉoffsets,
            Analysis.Recordˉpersistentˉfields,
            Analysis.Recordˉscratchˉfields,
            Analysis.Recordˉslots
        ),
        State
    );
}

fn Compilerˉnativeˉx64ˉemitˉvariantˉstep(
    Input: bytes,
    Offset: u32,
    Opcode: u8,
    Function: Compilerˉnativeˉx64ˉfunction,
    Analysis: Compilerˉnativeˉx64ˉcontrolˉanalysis,
    Types: Nominalˉtypes.Compilerˉnativeˉx64ˉtypes,
    Scratchˉbase: u32,
    State: Recordˉinstructions.Compilerˉnativeˉx64ˉrecordˉstate
) -> Recordˉinstructions.Compilerˉnativeˉx64ˉrecordˉstate {
    let Recordˉbase: u32 = Function.Locals + Analysis.I32ˉslots +
        Analysis.Boolˉslots + Analysis.Textˉslots + Analysis.U8ˉslots +
        Analysis.U32ˉslots + Analysis.Bytesˉslots + Analysis.Enumˉslots;
    let Persistentˉbase: u32 = Recordˉbase + Analysis.Recordˉslots +
        Compilerˉnativeˉx64ˉdescriptorˉresultˉslots(
            Function.Returnˉtype
        );
    return Variantˉinstructions.Compilerˉnativeˉx64ˉemitˉvariantˉinstruction(
        Input,
        Offset,
        Opcode,
        Recordˉinstructions.Compilerˉnativeˉx64ˉrecordˉlayout(
            Function.Locals,
            Analysis.I32ˉslots,
            Analysis.Boolˉslots,
            Analysis.Textˉslots,
            Analysis.U8ˉslots,
            Analysis.U32ˉslots,
            Analysis.Bytesˉslots,
            Recordˉbase,
            Persistentˉbase,
            Persistentˉbase + Analysis.Recordˉpersistentˉfields
        ),
        Types,
        Recordˉstorage.Compilerˉnativeˉx64ˉrecordˉstorage(
            true,
            Analysis.Recordˉpersistentˉoffsets,
            Bytesˉslice(
                Analysis.Recordˉscratchˉoffsets,
                Scratchˉbase * 4u32,
                Bytesˉlength(Analysis.Recordˉscratchˉoffsets) -
                    Scratchˉbase * 4u32
            ),
            Analysis.Recordˉscratchˉblockˉoffsets,
            Analysis.Recordˉpersistentˉfields,
            Analysis.Recordˉscratchˉfields,
            Analysis.Recordˉslots
        ),
        State
    );
}

fn Compilerˉnativeˉx64ˉemitˉrecordˉbackedˉstep(
    Input: bytes,
    Offset: u32,
    Opcode: u8,
    Function: Compilerˉnativeˉx64ˉfunction,
    Analysis: Compilerˉnativeˉx64ˉcontrolˉanalysis,
    Types: Nominalˉtypes.Compilerˉnativeˉx64ˉtypes,
    Scratchˉbase: u32,
    Isˉmain: bool,
    Invalidˉlimitˉtarget: u32,
    Emittedˉoffset: u32,
    Ownedˉentryˉbase: u32,
    Sharedˉhelperˉbase: u32,
    Codeˉbase: u32,
    State: Recordˉinstructions.Compilerˉnativeˉx64ˉrecordˉstate
) -> Recordˉinstructions.Compilerˉnativeˉx64ˉrecordˉstate {
    if Sharedˉbytes.Operationˉisˉsupported(Opcode) ||
        (Function.Sharedˉvalues && Sharedˉbytes.Budgetˉisˉsupported(Opcode)) {
        let Byteˉrecordˉbase: u32 = Function.Locals +
            Analysis.I32ˉslots + Analysis.Boolˉslots + Analysis.Textˉslots +
            Analysis.U8ˉslots + Analysis.U32ˉslots + Analysis.Bytesˉslots +
            Analysis.Enumˉslots;
        let Byteˉpersistentˉbase: u32 = Byteˉrecordˉbase + Analysis.Recordˉslots +
            Compilerˉnativeˉx64ˉdescriptorˉresultˉslots(Function.Returnˉtype);
        return Sharedˉbytes.Emitˉbyteˉinstruction(Types, Input, Offset, Opcode,
            Recordˉinstructions.Compilerˉnativeˉx64ˉrecordˉlayout(
                Function.Locals, Analysis.I32ˉslots, Analysis.Boolˉslots,
                Analysis.Textˉslots, Analysis.U8ˉslots, Analysis.U32ˉslots,
                Analysis.Bytesˉslots, Byteˉrecordˉbase, Byteˉpersistentˉbase,
                Byteˉpersistentˉbase + Analysis.Recordˉpersistentˉfields),
            Recordˉstorage.Compilerˉnativeˉx64ˉrecordˉstorage(
                true, Analysis.Recordˉpersistentˉoffsets,
                Bytesˉslice(Analysis.Recordˉscratchˉoffsets,
                    Scratchˉbase * 4u32, Bytesˉlength(Analysis.Recordˉscratchˉoffsets) - Scratchˉbase * 4u32),
                Analysis.Recordˉscratchˉblockˉoffsets,
                Analysis.Recordˉpersistentˉfields, Analysis.Recordˉscratchˉfields,
                Analysis.Recordˉslots),
            Compilerˉnativeˉx64ˉframeˉslots(Function, Analysis) - Sharedˉbytes.Requestˉslots(),
            Sharedˉhelperˉbase, Codeˉbase + Emittedˉoffset, Invalidˉlimitˉtarget, State);
    }
    if Ownedˉcollections.Operationˉisˉsupported(Opcode) {
        let Budgetˉrecordˉbase: u32 = Function.Locals +
            Analysis.I32ˉslots + Analysis.Boolˉslots + Analysis.Textˉslots +
            Analysis.U8ˉslots + Analysis.U32ˉslots + Analysis.Bytesˉslots +
            Analysis.Enumˉslots;
        let Budgetˉpersistentˉbase: u32 = Budgetˉrecordˉbase +
            Analysis.Recordˉslots +
            Compilerˉnativeˉx64ˉdescriptorˉresultˉslots(
                Function.Returnˉtype
            );
        if Ownedˉcollections.Minorˉisˉsupported(Bytesˉreadˉu16ˉlittle(Input, 6u32)) ||
            (Function.Sharedˉvalues && Opcode == 195u8) {
        return Ownedˉcollections.Emitˉoperation(
            Input,
            Offset,
            Opcode,
            Emittedˉoffset,
            Ownedˉentryˉbase,
            Codeˉbase,
            Function.Localˉtypeˉidentities,
            Types,
            Recordˉinstructions.Compilerˉnativeˉx64ˉrecordˉlayout(
                Function.Locals,
                Analysis.I32ˉslots,
                Analysis.Boolˉslots,
                Analysis.Textˉslots,
                Analysis.U8ˉslots,
                Analysis.U32ˉslots,
                Analysis.Bytesˉslots,
                Budgetˉrecordˉbase,
                Budgetˉpersistentˉbase,
                Budgetˉpersistentˉbase + Analysis.Recordˉpersistentˉfields
            ),
            Recordˉstorage.Compilerˉnativeˉx64ˉrecordˉstorage(
                true,
                Analysis.Recordˉpersistentˉoffsets,
                Bytesˉslice(
                    Analysis.Recordˉscratchˉoffsets,
                    Scratchˉbase * 4u32,
                    Bytesˉlength(Analysis.Recordˉscratchˉoffsets) -
                        Scratchˉbase * 4u32
                ),
                Analysis.Recordˉscratchˉblockˉoffsets,
                Analysis.Recordˉpersistentˉfields,
                Analysis.Recordˉscratchˉfields,
                Analysis.Recordˉslots
            ),
            Invalidˉlimitˉtarget,
            State
        );
        }
        return Memoryˉbudget.Compilerˉnativeˉx64ˉemitˉmemoryˉbudgetˉsplit(Types,
            Input,
            Offset,
            Recordˉinstructions.Compilerˉnativeˉx64ˉrecordˉlayout(
                Function.Locals,
                Analysis.I32ˉslots,
                Analysis.Boolˉslots,
                Analysis.Textˉslots,
                Analysis.U8ˉslots,
                Analysis.U32ˉslots,
                Analysis.Bytesˉslots,
                Budgetˉrecordˉbase,
                Budgetˉpersistentˉbase,
                Budgetˉpersistentˉbase + Analysis.Recordˉpersistentˉfields
            ),
            Recordˉstorage.Compilerˉnativeˉx64ˉrecordˉstorage(
                true,
                Analysis.Recordˉpersistentˉoffsets,
                Bytesˉslice(
                    Analysis.Recordˉscratchˉoffsets,
                    Scratchˉbase * 4u32,
                    Bytesˉlength(Analysis.Recordˉscratchˉoffsets) -
                        Scratchˉbase * 4u32
                ),
                Analysis.Recordˉscratchˉblockˉoffsets,
                Analysis.Recordˉpersistentˉfields,
                Analysis.Recordˉscratchˉfields,
                Analysis.Recordˉslots
            ),
            Invalidˉlimitˉtarget,
            State
        );
    }
    if Opcode == 221u8 {
        let Lengthˉrecordˉbase: u32 = Function.Locals +
            Analysis.I32ˉslots + Analysis.Boolˉslots + Analysis.Textˉslots +
            Analysis.U8ˉslots + Analysis.U32ˉslots + Analysis.Bytesˉslots +
            Analysis.Enumˉslots;
        let Lengthˉpersistentˉbase: u32 = Lengthˉrecordˉbase +
            Analysis.Recordˉslots +
            Compilerˉnativeˉx64ˉdescriptorˉresultˉslots(
                Function.Returnˉtype
            );
        return Unsafeˉscratch.Compilerˉnativeˉx64ˉemitˉunsafeˉscratchˉlength(
                Input,
                Offset,
                Recordˉinstructions.Compilerˉnativeˉx64ˉrecordˉlayout(
                    Function.Locals,
                    Analysis.I32ˉslots,
                    Analysis.Boolˉslots,
                    Analysis.Textˉslots,
                    Analysis.U8ˉslots,
                    Analysis.U32ˉslots,
                    Analysis.Bytesˉslots,
                    Lengthˉrecordˉbase,
                    Lengthˉpersistentˉbase,
                    Lengthˉpersistentˉbase +
                        Analysis.Recordˉpersistentˉfields
                ),
                State
            );
    }
    if Opcode == 220u8 {
        let Scratchˉrecordˉbase: u32 = Function.Locals +
            Analysis.I32ˉslots + Analysis.Boolˉslots + Analysis.Textˉslots +
            Analysis.U8ˉslots + Analysis.U32ˉslots + Analysis.Bytesˉslots +
            Analysis.Enumˉslots;
        let Scratchˉpersistentˉbase: u32 = Scratchˉrecordˉbase +
            Analysis.Recordˉslots +
            Compilerˉnativeˉx64ˉdescriptorˉresultˉslots(
                Function.Returnˉtype
            );
        return Unsafeˉscratch.Compilerˉnativeˉx64ˉemitˉunsafeˉscratch(Types,
            Input,
            Offset,
            Recordˉinstructions.Compilerˉnativeˉx64ˉrecordˉlayout(
                Function.Locals,
                Analysis.I32ˉslots,
                Analysis.Boolˉslots,
                Analysis.Textˉslots,
                Analysis.U8ˉslots,
                Analysis.U32ˉslots,
                Analysis.Bytesˉslots,
                Scratchˉrecordˉbase,
                Scratchˉpersistentˉbase,
                Scratchˉpersistentˉbase + Analysis.Recordˉpersistentˉfields
            ),
            Recordˉstorage.Compilerˉnativeˉx64ˉrecordˉstorage(
                true,
                Analysis.Recordˉpersistentˉoffsets,
                Bytesˉslice(
                    Analysis.Recordˉscratchˉoffsets,
                    Scratchˉbase * 4u32,
                    Bytesˉlength(Analysis.Recordˉscratchˉoffsets) -
                        Scratchˉbase * 4u32
                ),
                Analysis.Recordˉscratchˉblockˉoffsets,
                Analysis.Recordˉpersistentˉfields,
                Analysis.Recordˉscratchˉfields,
                Analysis.Recordˉslots
            ),
            Compilerˉnativeˉx64ˉunsafeˉbackingˉbase(Function, Analysis),
            State
        );
    }
    if Opcode == 222u8 {
        let Regionˉrecordˉbase: u32 = Function.Locals +
            Analysis.I32ˉslots + Analysis.Boolˉslots + Analysis.Textˉslots +
            Analysis.U8ˉslots + Analysis.U32ˉslots + Analysis.Bytesˉslots +
            Analysis.Enumˉslots;
        let Regionˉpersistentˉbase: u32 = Regionˉrecordˉbase +
            Analysis.Recordˉslots +
            Compilerˉnativeˉx64ˉdescriptorˉresultˉslots(
                Function.Returnˉtype
            );
        return Unsafeˉwriteˉregion.Compilerˉnativeˉx64ˉemitˉunsafeˉwriteˉregion(Types,
            Input,
            Offset,
            Recordˉinstructions.Compilerˉnativeˉx64ˉrecordˉlayout(
                Function.Locals,
                Analysis.I32ˉslots,
                Analysis.Boolˉslots,
                Analysis.Textˉslots,
                Analysis.U8ˉslots,
                Analysis.U32ˉslots,
                Analysis.Bytesˉslots,
                Regionˉrecordˉbase,
                Regionˉpersistentˉbase,
                Regionˉpersistentˉbase + Analysis.Recordˉpersistentˉfields
            ),
            Recordˉstorage.Compilerˉnativeˉx64ˉrecordˉstorage(
                true,
                Analysis.Recordˉpersistentˉoffsets,
                Bytesˉslice(
                    Analysis.Recordˉscratchˉoffsets,
                    Scratchˉbase * 4u32,
                    Bytesˉlength(Analysis.Recordˉscratchˉoffsets) -
                        Scratchˉbase * 4u32
                ),
                Analysis.Recordˉscratchˉblockˉoffsets,
                Analysis.Recordˉpersistentˉfields,
                Analysis.Recordˉscratchˉfields,
                Analysis.Recordˉslots
            ),
            State
        );
    }
    if Opcode == 223u8 {
        let Pointerˉrecordˉbase: u32 = Function.Locals +
            Analysis.I32ˉslots + Analysis.Boolˉslots + Analysis.Textˉslots +
            Analysis.U8ˉslots + Analysis.U32ˉslots + Analysis.Bytesˉslots +
            Analysis.Enumˉslots;
        let Pointerˉpersistentˉbase: u32 = Pointerˉrecordˉbase +
            Analysis.Recordˉslots +
            Compilerˉnativeˉx64ˉdescriptorˉresultˉslots(
                Function.Returnˉtype
            );
        let Region: u32 = Bytesˉreadˉu32ˉlittle(Input, Offset + 1u32);
        let Pointerˉtype: u32 = Bytesˉreadˉu32ˉlittle(Input, Offset + 5u32);
        let Target: u32 = Pointerˉrecordˉbase + State.Nextˉrecord;
        let Pointerˉscratchˉoffsets: bytes = Bytesˉslice(
            Analysis.Recordˉscratchˉoffsets,
            Scratchˉbase * 4u32,
            Bytesˉlength(Analysis.Recordˉscratchˉoffsets) - Scratchˉbase * 4u32
        );
        let Backing: u32 = Pointerˉpersistentˉbase +
            Analysis.Recordˉpersistentˉfields + Bytesˉreadˉu32ˉlittle(
                Pointerˉscratchˉoffsets, State.Nextˉrecord * 4u32
            );
        var Output: bytes = Compilerˉnativeˉx64ˉemitˉloadˉrax(
            State.Result, Region * 16u32
        );
        if Bytesˉreadˉu16ˉlittle(Input, 6u32) == 38u32 {
            // The region record retains its checked native address in the
            // private high word and its logical length in bits 32..63.
            Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 72u8);
            Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 139u8);
            Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 72u8);
            Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 8u8);
            Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 72u8);
            Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 139u8);
            Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 16u8);
            Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 72u8);
            Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 193u8);
            Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 234u8);
            Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 32u8);
            Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 72u8);
            Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 137u8);
            Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 140u8);
            Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 36u8);
            Output = Compilerˉnativeˉx64ˉappendˉu32(
                Output, Backing * 16u32
            );
            Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 72u8);
            Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 137u8);
            Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 148u8);
            Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 36u8);
            Output = Compilerˉnativeˉx64ˉappendˉu32(
                Output, Backing * 16u32 + 8u32
            );
        } else {
            // WVB 1.37 retains only the private packed {start,length}
            // descriptor and deliberately forms no host address.
            Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 72u8);
            Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 139u8);
            Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 0u8);
            Output = Compilerˉnativeˉx64ˉemitˉstoreˉrax(
                Output, Backing * 16u32
            );
        }
        Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 72u8);
        Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 141u8);
        Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 132u8);
        Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 36u8);
        Output = Compilerˉnativeˉx64ˉappendˉu32(Output, Backing * 16u32);
        Output = Compilerˉnativeˉx64ˉemitˉstoreˉrax(Output, Target * 16u32);
        return Recordˉinstructions.Compilerˉnativeˉx64ˉrecordˉstate(
            Output,
            Bytesˉconcat(
                State.Stackˉtypes,
                Bytesˉfromˉu8(
                    Nominalˉtypes.Compilerˉnativeˉx64ˉrecordˉtype(Pointerˉtype)
                )
            ),
            Bytesˉconcat(
                State.Stackˉslots, Bytesˉfromˉu32ˉlittle(Target)
            ),
            State.Stackˉdepth + 1u32,
            State.Nextˉi32,
            State.Nextˉbool,
            State.Nextˉtext,
            State.Nextˉu8,
            State.Nextˉu32,
            State.Nextˉbytes,
            State.Nextˉenum,
            State.Nextˉrecord + 1u32
        );
    }
    if Opcode == 224u8 {
        let Foreignˉrecordˉbase: u32 = Function.Locals +
            Analysis.I32ˉslots + Analysis.Boolˉslots + Analysis.Textˉslots +
            Analysis.U8ˉslots + Analysis.U32ˉslots + Analysis.Bytesˉslots +
            Analysis.Enumˉslots;
        let Foreignˉpersistentˉbase: u32 = Foreignˉrecordˉbase +
            Analysis.Recordˉslots +
            Compilerˉnativeˉx64ˉdescriptorˉresultˉslots(
                Function.Returnˉtype
            );
        return Foreignˉcall.Compilerˉnativeˉx64ˉemitˉforeignˉcall(
            Recordˉinstructions.Compilerˉnativeˉx64ˉrecordˉlayout(
                Function.Locals,
                Analysis.I32ˉslots,
                Analysis.Boolˉslots,
                Analysis.Textˉslots,
                Analysis.U8ˉslots,
                Analysis.U32ˉslots,
                Analysis.Bytesˉslots,
                Foreignˉrecordˉbase,
                Foreignˉpersistentˉbase,
                Foreignˉpersistentˉbase + Analysis.Recordˉpersistentˉfields
            ),
            Isˉmain,
            Invalidˉlimitˉtarget,
            State
        );
    }
    if Compilerˉnativeˉx64ˉvariantˉoperation(Opcode) {
        return Compilerˉnativeˉx64ˉemitˉvariantˉstep(
            Input,
            Offset,
            Opcode,
            Function,
            Analysis,
            Types,
            Scratchˉbase,
            State
        );
    }
    return Compilerˉnativeˉx64ˉemitˉrecordˉstep(
        Input,
        Offset,
        Opcode,
        Function,
        Analysis,
        Types,
        Scratchˉbase,
        State
    );
}

fn Compilerˉnativeˉx64ˉemitˉcallˉstep(
    Target: u32,
    Function: Compilerˉnativeˉx64ˉfunction,
    Analysis: Compilerˉnativeˉx64ˉcontrolˉanalysis,
    Callˉdirectory: bytes,
    Codeˉbase: u32,
    Propagateˉoffset: u32,
    Scratchˉbase: u32,
    Input: bytes,
    Types: Nominalˉtypes.Compilerˉnativeˉx64ˉtypes,
    Sharedˉhelper: u32,
    Sharedˉinvalid: u32,
    State: Callˉinstructions.Compilerˉnativeˉx64ˉcallˉstate
) -> Callˉinstructions.Compilerˉnativeˉx64ˉcallˉstate {
    let Recordˉbase: u32 = Function.Locals + Analysis.I32ˉslots +
        Analysis.Boolˉslots + Analysis.Textˉslots + Analysis.U8ˉslots +
        Analysis.U32ˉslots + Analysis.Bytesˉslots + Analysis.Enumˉslots;
    let Shape: Callˉinstructions.Compilerˉnativeˉx64ˉcallˉlayout =
        Callˉinstructions.Compilerˉnativeˉx64ˉcallˉlayout(Function.Locals,
            Analysis.I32ˉslots, Analysis.Boolˉslots, Analysis.Textˉslots,
            Analysis.U8ˉslots, Analysis.U32ˉslots, Analysis.Bytesˉslots, Recordˉbase,
            Recordˉbase + Analysis.Recordˉslots +
                Compilerˉnativeˉx64ˉdescriptorˉresultˉslots(Function.Returnˉtype) +
                Analysis.Recordˉpersistentˉfields);
    let Storage: Recordˉstorage.Compilerˉnativeˉx64ˉrecordˉstorage =
        Recordˉstorage.Compilerˉnativeˉx64ˉrecordˉstorage(true,
            Analysis.Recordˉpersistentˉoffsets,
            Bytesˉslice(Analysis.Recordˉscratchˉoffsets, Scratchˉbase * 4u32,
                Bytesˉlength(Analysis.Recordˉscratchˉoffsets) - Scratchˉbase * 4u32),
            Analysis.Recordˉscratchˉblockˉoffsets, Analysis.Recordˉpersistentˉfields,
            Analysis.Recordˉscratchˉfields, Analysis.Recordˉslots);
    if Function.Sharedˉvalues {
        let Callee: Compilerˉnativeˉx64ˉfunction = Compilerˉnativeˉx64ˉcalleeˉread(Input, Function, Target, Types);
        return Callˉinstructions.Emitˉsharedˉcall(Target, Shape, Storage, Callˉdirectory,
            Codeˉbase, Propagateˉoffset, Input, Types,
            Bytesˉslice(Callee.Localˉtypeˉidentities, 0u32, Callee.Parameters * 4u32),
            Bytesˉslice(Callee.Localˉborrowˉkinds, 0u32, Callee.Parameters),
            Callee.Returnˉidentity, Compilerˉnativeˉx64ˉsharedˉrequestˉslot(Function, Analysis),
            Sharedˉhelper, Sharedˉinvalid, State);
    }
    return Callˉinstructions.Compilerˉnativeˉx64ˉemitˉcallˉinstruction(Types,
        Target, Shape, Storage, Callˉdirectory, Codeˉbase, Propagateˉoffset, State);
}

fn Compilerˉnativeˉx64ˉemitˉstatusˉtails(
    Result: bytes,
    Frameˉbytes: u32,
    Isˉmain: bool,
    Hasˉdivision: bool,
    Hasˉshift: bool,
    Returnˉtype: u8
) -> bytes {
    if Returnˉtype == 8u8 || Returnˉtype == 9u8 || Returnˉtype == 10u8 {
        var Wideˉoutput: bytes = Compilerˉnativeˉx64ˉemitˉwideˉstatusˉfor(
            Result, Frameˉbytes, 1u32, Isˉmain
        );
        Wideˉoutput = Compilerˉnativeˉx64ˉemitˉwideˉstatusˉfor(
            Wideˉoutput, Frameˉbytes, 2u32, Isˉmain
        );
        Wideˉoutput = Compilerˉnativeˉx64ˉemitˉwideˉstatusˉfor(
            Wideˉoutput, Frameˉbytes, 4u32, Isˉmain
        );
        Wideˉoutput = Compilerˉnativeˉx64ˉemitˉwideˉstatusˉfor(
            Wideˉoutput, Frameˉbytes, 6u32, Isˉmain
        );
        Wideˉoutput = Compilerˉnativeˉx64ˉemitˉwideˉstatusˉfor(
            Wideˉoutput, Frameˉbytes, 5u32, Isˉmain
        );
        Wideˉoutput = Compilerˉnativeˉx64ˉemitˉwideˉstatusˉfor(
            Wideˉoutput, Frameˉbytes, 8u32, Isˉmain
        );
        Wideˉoutput = Compilerˉnativeˉx64ˉemitˉwideˉstatusˉfor(
            Wideˉoutput, Frameˉbytes, 7u32, Isˉmain
        );
        if Hasˉdivision {
            Wideˉoutput = Compilerˉnativeˉx64ˉemitˉwideˉstatusˉfor(
                Wideˉoutput, Frameˉbytes, 9u32, Isˉmain
            );
        }
        if Hasˉshift {
            Wideˉoutput = Compilerˉnativeˉx64ˉemitˉwideˉstatusˉfor(
                Wideˉoutput, Frameˉbytes, 10u32, Isˉmain
            );
        }
        return Wideˉoutput;
    }
    var Output: bytes = Compilerˉnativeˉx64ˉemitˉstatusˉfor(
        Result,
        Frameˉbytes,
        1u32,
        Isˉmain
    );
    Output = Compilerˉnativeˉx64ˉemitˉstatusˉfor(
        Output,
        Frameˉbytes,
        2u32,
        Isˉmain
    );
    Output = Compilerˉnativeˉx64ˉemitˉstatusˉfor(
        Output,
        Frameˉbytes,
        4u32,
        Isˉmain
    );
    Output = Compilerˉnativeˉx64ˉemitˉstatusˉfor(
        Output,
        Frameˉbytes,
        6u32,
        Isˉmain
    );
    Output = Compilerˉnativeˉx64ˉemitˉstatusˉfor(
        Output,
        Frameˉbytes,
        5u32,
        Isˉmain
    );
    Output = Compilerˉnativeˉx64ˉemitˉstatusˉfor(
        Output,
        Frameˉbytes,
        8u32,
        Isˉmain
    );
    Output = Compilerˉnativeˉx64ˉemitˉstatusˉfor(
        Output,
        Frameˉbytes,
        7u32,
        Isˉmain
    );
    if Hasˉdivision {
        Output = Compilerˉnativeˉx64ˉemitˉstatusˉfor(
            Output,
            Frameˉbytes,
            9u32,
            Isˉmain
        );
    }
    if Hasˉshift {
        Output = Compilerˉnativeˉx64ˉemitˉstatusˉfor(
            Output,
            Frameˉbytes,
            10u32,
            Isˉmain
        );
    }
    return Output;
}

fn Compilerˉnativeˉx64ˉemitˉcontrolˉprologue(
    Input: bytes,
    Function: Compilerˉnativeˉx64ˉfunction,
    Isˉmain: bool,
    Frameˉbytes: u32,
    Depthˉoffset: u32,
    Returnsˉrecord: bool,
    Returnsˉdescriptor: bool,
    Hiddenˉresultˉslot: u32,
    Reclamation: bool
) -> bytes {
    var Result: bytes = Compilerˉnativeˉx64ˉempty(Input);
    if Isˉmain {
        Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 65u8);
        Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 87u8);
        Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 73u8);
        Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 137u8);
        Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 215u8);
        Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 77u8);
        Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 139u8);
        Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 95u8);
        Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 8u8);
        Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 77u8);
        Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 139u8);
        Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 87u8);
        Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 16u8);
    }
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 73u8);
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 131u8);
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 234u8);
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 1u8);
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 15u8);
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 130u8);
    Result = Compilerˉnativeˉx64ˉappendˉu32(
        Result,
        Depthˉoffset - Bytesˉlength(Result) - 4u32
    );
    if Function.Sharedˉvalues { Result = Compilerˉnativeˉx64ˉemitˉsharedˉframe(Result, Frameˉbytes); }
    else { Result = Compilerˉnativeˉx64ˉemitˉframe(Result, true, Frameˉbytes); }
    if Returnsˉrecord {
        Result = Records.Compilerˉnativeˉx64ˉemitˉhiddenˉrecordˉresult(
            Result,
            Hiddenˉresultˉslot
        );
    }
    if Returnsˉdescriptor {
        if Isˉmain {
            Result = Descriptorˉcalls.Compilerˉnativeˉx64ˉemitˉhiddenˉmainˉdescriptorˉresult(
                Result,
                Hiddenˉresultˉslot
            );
        } else {
            Result = Descriptorˉcalls.Compilerˉnativeˉx64ˉemitˉhiddenˉdescriptorˉresult(
                Result,
                Hiddenˉresultˉslot
            );
        }
    }
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 49u8);
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 192u8);
    let Hasˉhiddenˉresult: bool = Returnsˉrecord || Returnsˉdescriptor;
    if Hasˉhiddenˉresult {
        let Hiddenˉoffset: u32 = Hiddenˉresultˉslot * 16u32;
        Result = Compilerˉnativeˉx64ˉemitˉzeroˉrange(
            Result, 0u32, Hiddenˉoffset
        );
        Result = Compilerˉnativeˉx64ˉemitˉzeroˉrange(
            Result, Hiddenˉoffset + 16u32,
            Frameˉbytes - Hiddenˉoffset - 16u32
        );
    } else {
        Result = Compilerˉnativeˉx64ˉemitˉzeroˉrange(
            Result, 0u32, Frameˉbytes
        );
    }
    if Returnsˉrecord && !Function.Sharedˉvalues {
        Result = Records.Compilerˉnativeˉx64ˉemitˉrecordˉcheckpoint(
            Result,
            Hiddenˉresultˉslot
        );
    }
    if Returnsˉdescriptor && !Isˉmain && !Function.Sharedˉvalues {
        Result = Descriptorˉcalls.Compilerˉnativeˉx64ˉemitˉdescriptorˉcheckpoint(
            Result,
            Hiddenˉresultˉslot
        );
    }
    var Complete: bytes =
        Callˉarguments.Compilerˉnativeˉx64ˉemitˉcallˉparameters(
            Result,
            Bytesˉslice(Function.Localˉtypes, 0u32, Function.Parameters),
            Frameˉbytes
        );
    if Isˉmain && Function.Parameters == 1u32 && !Function.Sharedˉvalues {
        Complete = Compilerˉnativeˉx64ˉappendˉbyte(Complete, 72u8);
        Complete = Compilerˉnativeˉx64ˉappendˉbyte(Complete, 184u8);
        var Rootˉword: u32 = 64u32;
        if Ownedˉcollections.Minorˉisˉsupported(Bytesˉreadˉu16ˉlittle(Input, 6u32)) { Rootˉword = 1u32; }
        Complete = Compilerˉnativeˉx64ˉappendˉu32(Complete, Rootˉword);
        Complete = Compilerˉnativeˉx64ˉappendˉu32(Complete, Rootˉword);
        Complete = Compilerˉnativeˉx64ˉappendˉbyte(Complete, 72u8);
        Complete = Compilerˉnativeˉx64ˉappendˉbyte(Complete, 137u8);
        Complete = Compilerˉnativeˉx64ˉappendˉbyte(Complete, 132u8);
        Complete = Compilerˉnativeˉx64ˉappendˉbyte(Complete, 36u8);
        Complete = Compilerˉnativeˉx64ˉappendˉu32(Complete, 0u32);
    }
    if Function.Sharedˉvalues {
        var Parameter: u32 = 0u32;
        while Parameter < Function.Parameters {
            let Type: u8 = Bytesˉreadˉu8(Function.Localˉtypes, Parameter);
            if Type == 8u8 || (Type == 10u8 &&
                Bytesˉreadˉu32ˉlittle(Function.Localˉtypeˉidentities, Parameter * 4u32) == 25u32) {
                var Marker: u32 = 0u32;
                if Bytesˉreadˉu8(Function.Localˉborrowˉkinds, Parameter) == 0u8 { Marker = 1u32; }
                Complete = Compilerˉnativeˉx64ˉappendˉu32(
                    Compilerˉnativeˉx64ˉappendˉu32(Bytesˉconcat(Complete,
                        Bytesˉfromˉu32ˉlittle(612681544u32)), Parameter * 16u32 + 8u32), Marker);
            }
            Parameter = Parameter + 1u32;
        }
    }
    if Reclamation {
        Complete = Records.Compilerˉnativeˉx64ˉemitˉrecordˉcheckpoint(Complete, Frameˉbytes / 16u32 - 1u32);
    }
    return Complete;
}

fn Compilerˉnativeˉx64ˉemitˉscalarˉinstruction(
    Input: bytes,
    Instructionˉoffset: u32,
    Opcode: u8,
    Function: Compilerˉnativeˉx64ˉfunction,
    Analysis: Compilerˉnativeˉx64ˉcontrolˉanalysis,
    Hasˉrecordˉinstruction: bool,
    Overflowˉtarget: u32,
    Invalidˉshiftˉtarget: u32,
    Sharedˉrequest: u32,
    Sharedˉhelper: u32,
    Sharedˉcodeˉbase: u32,
    Sharedˉinvalid: u32,
    State: Compilerˉnativeˉx64ˉscalarˉemissionˉstate
) -> Compilerˉnativeˉx64ˉscalarˉemissionˉstate {
    var Handled: bool = false;
    var Result: bytes = State.Result;
    var Stackˉtypes: bytes = State.Stackˉtypes;
    var Stackˉslots: bytes = State.Stackˉslots;
    var Stackˉdepth: u32 = State.Stackˉdepth;
    var Nextˉi32: u32 = State.Nextˉi32;
    var Nextˉbool: u32 = State.Nextˉbool;
    var Nextˉtext: u32 = State.Nextˉtext;
    var Nextˉu8: u32 = State.Nextˉu8;
    var Nextˉu32: u32 = State.Nextˉu32;
    var Nextˉbytes: u32 = State.Nextˉbytes;
    var Nextˉenum: u32 = State.Nextˉenum;

    if Function.Sharedˉvalues && !Hasˉrecordˉinstruction &&
        (Opcode == 4u8 || Opcode == 5u8 || Opcode == 205u8) {
        let Local: u32 = Bytesˉreadˉu32ˉlittle(Input, Instructionˉoffset + 1u32);
        let Type: u8 = Bytesˉreadˉu8(Function.Localˉtypes, Local);
        let Identity: u32 = Bytesˉreadˉu32ˉlittle(Function.Localˉtypeˉidentities, Local * 4u32);
        if Sharedˉbytes.Localˉisˉshared(Type, Identity) {
            var Source: u32 = Local;
            var Target: u32 = Local;
            if Opcode == 5u8 {
                Stackˉdepth = Stackˉdepth - 1u32;
                Source = Bytesˉreadˉu32ˉlittle(Stackˉslots, Stackˉdepth * 4u32);
                Stackˉtypes = Bytesˉslice(Stackˉtypes, 0u32, Stackˉdepth);
                Stackˉslots = Bytesˉslice(Stackˉslots, 0u32, Stackˉdepth * 4u32);
            } else {
                var Index: u32 = Nextˉu32;
                if Type == 3u8 { Index = Nextˉtext; Nextˉtext = Nextˉtext + 1u32; }
                else if Type == 6u8 { Index = Nextˉbytes; Nextˉbytes = Nextˉbytes + 1u32; }
                else { Nextˉu32 = Nextˉu32 + 1u32; }
                Target = Layout.Compilerˉnativeˉx64ˉlayoutˉvalueˉslot(Function.Locals,
                    Analysis.I32ˉslots, Analysis.Boolˉslots, Analysis.Textˉslots,
                    Analysis.U8ˉslots, Analysis.U32ˉslots, Analysis.Bytesˉslots, Type, Index);
                Stackˉtypes = Bytesˉconcat(Stackˉtypes, Bytesˉfromˉu8(Type));
                Stackˉslots = Bytesˉconcat(Stackˉslots, Bytesˉfromˉu32ˉlittle(Target));
                Stackˉdepth = Stackˉdepth + 1u32;
            }
            var Action: u32 = Sharedˉbytes.Localˉaction(Opcode, Type);
            let Borrowedˉbuilderˉstore: bool = Opcode == 5u8 && Type == 8u8 &&
                Bytesˉreadˉu8(Function.Localˉborrowˉkinds, Local) == 37u8;
            let Borrowedˉbudgetˉstore: bool = Opcode == 5u8 && Type == 10u8 && Identity == 25u32 &&
                (Bytesˉreadˉu8(Function.Localˉborrowˉkinds, Local) == 36u8 ||
                    Bytesˉreadˉu8(Function.Localˉborrowˉkinds, Local) == 41u8);
            if Borrowedˉbuilderˉstore { Action = 10u32; }
            if Borrowedˉbudgetˉstore { Action = 18u32; }
            Result = Sharedˉbytes.Emitˉoperation(Result, Action,
                Target, Source, 4294967295u32, 0u32, 0u8, 0u32, 0u8,
                Sharedˉrequest, Sharedˉhelper, Sharedˉcodeˉbase, Sharedˉinvalid);
            if Borrowedˉbuilderˉstore || Borrowedˉbudgetˉstore { Result = Sharedˉbytes.Emitˉclear(Result, Source); }
            return Compilerˉnativeˉx64ˉscalarˉemissionˉstate(true, true,
                Result, Stackˉtypes, Stackˉslots, Stackˉdepth,
                Nextˉi32, Nextˉbool, Nextˉtext, Nextˉu8, Nextˉu32,
                Nextˉbytes, Nextˉenum, State.Nextˉrecord);
        }
    }

    if Opcode == 1u8 || Opcode == 8u8 || Opcode == 9u8 ||
        Opcode == 128u8 ||
        Opcode == 129u8 {
        Handled = true;
        var Constantˉtype: u8 = 1u8;
        var Constantˉindex: u32 = Nextˉi32;
        if Opcode == 8u8 {
            Constantˉtype = 4u8;
            Constantˉindex = Nextˉu8;
        }
        if Opcode == 9u8 {
            Constantˉtype = 5u8;
            Constantˉindex = Nextˉu32;
        }
        if Opcode == 128u8 {
            Constantˉtype = 9u8;
            Constantˉindex = Nextˉu32;
        }
        if Opcode == 129u8 {
            Constantˉtype = 10u8;
            Constantˉindex = Nextˉu32;
        }
        let Constantˉslot: u32 =
            Layout.Compilerˉnativeˉx64ˉlayoutˉvalueˉslot(
                Function.Locals,
                Analysis.I32ˉslots,
                Analysis.Boolˉslots,
                Analysis.Textˉslots,
                Analysis.U8ˉslots,
                Analysis.U32ˉslots,
                Analysis.Bytesˉslots,
                Constantˉtype,
                Constantˉindex
            );
        if Opcode == 128u8 || Opcode == 129u8 {
            Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 72u8);
        }
        Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 184u8);
        if Opcode == 1u8 {
            Result = Compilerˉnativeˉx64ˉappendˉi32(
                Result,
                Bytesˉreadˉi32ˉlittle(Input, Instructionˉoffset + 1u32)
            );
        }
        if Opcode == 8u8 {
            Result = Compilerˉnativeˉx64ˉappendˉu32(
                Result,
                U32ˉfromˉu8(Bytesˉreadˉu8(Input, Instructionˉoffset + 1u32))
            );
        }
        if Opcode == 9u8 {
            Result = Compilerˉnativeˉx64ˉappendˉu32(
                Result,
                Bytesˉreadˉu32ˉlittle(Input, Instructionˉoffset + 1u32)
            );
        }
        if Opcode == 128u8 || Opcode == 129u8 {
            Result = Bytesˉconcat(
                Result,
                Bytesˉslice(Input, Instructionˉoffset + 1u32, 8u32)
            );
            Result = Compilerˉnativeˉx64ˉemitˉstoreˉrax(
                Result,
                Constantˉslot * 16u32
            );
        } else {
            Result = Compilerˉnativeˉx64ˉemitˉstoreˉeax(
                Result,
                Constantˉslot * 16u32
            );
        }
        Stackˉtypes = Bytesˉconcat(Stackˉtypes, Bytesˉfromˉu8(Constantˉtype));
        Stackˉslots = Bytesˉconcat(
            Stackˉslots,
            Bytesˉfromˉu32ˉlittle(Constantˉslot)
        );
        Stackˉdepth = Stackˉdepth + 1u32;
        if Constantˉtype == 1u8 { Nextˉi32 = Nextˉi32 + 1u32; }
        if Constantˉtype == 4u8 { Nextˉu8 = Nextˉu8 + 1u32; }
        if Constantˉtype == 5u8 { Nextˉu32 = Nextˉu32 + 1u32; }
        if Constantˉtype == 9u8 { Nextˉu32 = Nextˉu32 + 1u32; }
        if Constantˉtype == 10u8 { Nextˉu32 = Nextˉu32 + 1u32; }
    }

    if Opcode == 2u8 {
        Handled = true;
        let Boolˉconstantˉslot: u32 =
            Function.Locals + Analysis.I32ˉslots + Nextˉbool;
        Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 184u8);
        Result = Compilerˉnativeˉx64ˉappendˉu32(
            Result,
            U32ˉfromˉu8(Bytesˉreadˉu8(Input, Instructionˉoffset + 1u32))
        );
        Result = Compilerˉnativeˉx64ˉemitˉstoreˉeax(
            Result,
            Boolˉconstantˉslot * 16u32
        );
        Stackˉtypes = Bytesˉconcat(Stackˉtypes, Bytesˉfromˉu8(2u8));
        Stackˉslots = Bytesˉconcat(
            Stackˉslots,
            Bytesˉfromˉu32ˉlittle(Boolˉconstantˉslot)
        );
        Stackˉdepth = Stackˉdepth + 1u32;
        Nextˉbool = Nextˉbool + 1u32;
    }

    if (Opcode == 4u8 || Opcode == 205u8) && !Hasˉrecordˉinstruction {
        Handled = true;
        let Loadˉlocal: u32 = Bytesˉreadˉu32ˉlittle(
            Input,
            Instructionˉoffset + 1u32
        );
        let Loadˉtype: u8 = Bytesˉreadˉu8(Function.Localˉtypes, Loadˉlocal);
        var Loadˉindex: u32 = Nextˉi32;
        if Loadˉtype == 2u8 { Loadˉindex = Nextˉbool; }
        if Loadˉtype == 3u8 { Loadˉindex = Nextˉtext; }
        if Loadˉtype == 4u8 { Loadˉindex = Nextˉu8; }
        if Loadˉtype == 5u8 || Loadˉtype == 9u8 || Loadˉtype == 10u8 {
            Loadˉindex = Nextˉu32;
        }
        if Loadˉtype == 6u8 || Loadˉtype == 7u8 ||
            Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉisˉcallable(Loadˉtype) {
            Loadˉindex = Nextˉbytes;
        }
        if Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉisˉenum(Loadˉtype) {
            Loadˉindex = Nextˉenum;
        }
        let Loadˉslot: u32 =
            Layout.Compilerˉnativeˉx64ˉlayoutˉvalueˉslot(
                Function.Locals,
                Analysis.I32ˉslots,
                Analysis.Boolˉslots,
                Analysis.Textˉslots,
                Analysis.U8ˉslots,
                Analysis.U32ˉslots,
                Analysis.Bytesˉslots,
                Loadˉtype,
                Loadˉindex
            );
        if Loadˉtype == 3u8 || Loadˉtype == 6u8 || Loadˉtype == 7u8 ||
            Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉisˉcallable(Loadˉtype) {
            Result = Descriptors.Compilerˉnativeˉx64ˉemitˉdescriptorˉcopy(
                Result,
                Loadˉlocal,
                Loadˉslot
            );
        } else if Loadˉtype == 9u8 || Loadˉtype == 10u8 {
            Result = Compilerˉnativeˉx64ˉemitˉloadˉrax(
                Result,
                Loadˉlocal * 16u32
            );
            Result = Compilerˉnativeˉx64ˉemitˉstoreˉrax(
                Result,
                Loadˉslot * 16u32
            );
        } else {
            Result = Compilerˉnativeˉx64ˉemitˉloadˉeax(
                Result,
                Loadˉlocal * 16u32
            );
            Result = Compilerˉnativeˉx64ˉemitˉstoreˉeax(
                Result,
                Loadˉslot * 16u32
            );
        }
        Stackˉtypes = Bytesˉconcat(Stackˉtypes, Bytesˉfromˉu8(Loadˉtype));
        Stackˉslots = Bytesˉconcat(
            Stackˉslots,
            Bytesˉfromˉu32ˉlittle(Loadˉslot)
        );
        Stackˉdepth = Stackˉdepth + 1u32;
        if Loadˉtype == 1u8 { Nextˉi32 = Nextˉi32 + 1u32; }
        if Loadˉtype == 2u8 { Nextˉbool = Nextˉbool + 1u32; }
        if Loadˉtype == 3u8 { Nextˉtext = Nextˉtext + 1u32; }
        if Loadˉtype == 4u8 { Nextˉu8 = Nextˉu8 + 1u32; }
        if Loadˉtype == 5u8 { Nextˉu32 = Nextˉu32 + 1u32; }
        if Loadˉtype == 9u8 { Nextˉu32 = Nextˉu32 + 1u32; }
        if Loadˉtype == 10u8 { Nextˉu32 = Nextˉu32 + 1u32; }
        if Loadˉtype == 6u8 || Loadˉtype == 7u8 ||
            Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉisˉcallable(Loadˉtype) {
            Nextˉbytes = Nextˉbytes + 1u32;
        }
        if Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉisˉenum(Loadˉtype) {
            Nextˉenum = Nextˉenum + 1u32;
        }
    }

    if Opcode == 5u8 && !Hasˉrecordˉinstruction {
        Handled = true;
        let Storeˉlocal: u32 = Bytesˉreadˉu32ˉlittle(
            Input,
            Instructionˉoffset + 1u32
        );
        let Storeˉslot: u32 = Bytesˉreadˉu32ˉlittle(
            Stackˉslots,
            (Stackˉdepth - 1u32) * 4u32
        );
        Stackˉdepth = Stackˉdepth - 1u32;
        Stackˉtypes = Bytesˉslice(Stackˉtypes, 0u32, Stackˉdepth);
        Stackˉslots = Bytesˉslice(Stackˉslots, 0u32, Stackˉdepth * 4u32);
        let Storeˉtype: u8 = Bytesˉreadˉu8(
            Function.Localˉtypes,
            Storeˉlocal
        );
        if Storeˉtype == 3u8 || Storeˉtype == 6u8 || Storeˉtype == 7u8 ||
            Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉisˉcallable(Storeˉtype) {
            Result = Descriptors.Compilerˉnativeˉx64ˉemitˉdescriptorˉcopy(
                Result,
                Storeˉslot,
                Storeˉlocal
            );
        } else if Storeˉtype == 9u8 || Storeˉtype == 10u8 {
            Result = Compilerˉnativeˉx64ˉemitˉloadˉrax(
                Result,
                Storeˉslot * 16u32
            );
            Result = Compilerˉnativeˉx64ˉemitˉstoreˉrax(
                Result,
                Storeˉlocal * 16u32
            );
        } else {
            Result = Compilerˉnativeˉx64ˉemitˉloadˉeax(
                Result,
                Storeˉslot * 16u32
            );
            Result = Compilerˉnativeˉx64ˉemitˉstoreˉeax(
                Result,
                Storeˉlocal * 16u32
            );
        }
    }

    let Numericˉopcode: u32 = U32ˉfromˉu8(Opcode);
    if (Numericˉopcode >= 16u32 || Numericˉopcode >= 134u32) &&
        (Numericˉopcode <= 18u32 ||
            (Numericˉopcode >= 20u32 && Numericˉopcode <= 22u32) ||
            (Numericˉopcode >= 134u32 && Numericˉopcode <= 136u32) ||
            (Numericˉopcode >= 173u32 && Numericˉopcode <= 178u32 &&
                Opcode != 176u8)) {
        Handled = true;
        var Binaryˉtype: u8 = 1u8;
        var Binaryˉindex: u32 = Nextˉi32;
        if Numericˉopcode >= 20u32 {
            Binaryˉtype = 5u8;
            Binaryˉindex = Nextˉu32;
        }
        if Numericˉopcode >= 134u32 && Numericˉopcode <= 136u32 {
            Binaryˉtype = 10u8;
            Binaryˉindex = Nextˉu32;
        }
        let Binaryˉright: u32 = Bytesˉreadˉu32ˉlittle(
            Stackˉslots,
            (Stackˉdepth - 1u32) * 4u32
        );
        let Binaryˉleft: u32 = Bytesˉreadˉu32ˉlittle(
            Stackˉslots,
            (Stackˉdepth - 2u32) * 4u32
        );
        Stackˉdepth = Stackˉdepth - 2u32;
        Stackˉtypes = Bytesˉslice(Stackˉtypes, 0u32, Stackˉdepth);
        Stackˉslots = Bytesˉslice(Stackˉslots, 0u32, Stackˉdepth * 4u32);
        let Binaryˉresult: u32 =
            Layout.Compilerˉnativeˉx64ˉlayoutˉvalueˉslot(
                Function.Locals,
                Analysis.I32ˉslots,
                Analysis.Boolˉslots,
                Analysis.Textˉslots,
                Analysis.U8ˉslots,
                Analysis.U32ˉslots,
                Analysis.Bytesˉslots,
                Binaryˉtype,
                Binaryˉindex
            );
        var Failureˉtarget: u32 = Overflowˉtarget;
        if Numericˉopcode >= 173u32 { Failureˉtarget = Invalidˉshiftˉtarget; }
        Result = Descriptorˉinstructions.Compilerˉnativeˉx64ˉemitˉscalarˉarithmetic(
            Result,
            Opcode,
            Binaryˉleft,
            Binaryˉright,
            Binaryˉresult,
            Failureˉtarget
        );
        Stackˉtypes = Bytesˉconcat(Stackˉtypes, Bytesˉfromˉu8(Binaryˉtype));
        Stackˉslots = Bytesˉconcat(
            Stackˉslots,
            Bytesˉfromˉu32ˉlittle(Binaryˉresult)
        );
        Stackˉdepth = Stackˉdepth + 1u32;
        if Binaryˉtype == 1u8 {
            Nextˉi32 = Nextˉi32 + 1u32;
        } else {
            Nextˉu32 = Nextˉu32 + 1u32;
        }
    }

    if Compilerˉnativeˉx64ˉisˉu64ˉbitwise(Opcode) {
        Handled = true;
        var Wideˉbitwiseˉoperands: u32 = 2u32;
        if Opcode == 182u8 { Wideˉbitwiseˉoperands = 1u32; }
        let Wideˉbitwiseˉright: u32 = Bytesˉreadˉu32ˉlittle(
            Stackˉslots,
            (Stackˉdepth - 1u32) * 4u32
        );
        var Wideˉbitwiseˉleft: u32 = Wideˉbitwiseˉright;
        if Wideˉbitwiseˉoperands == 2u32 {
            Wideˉbitwiseˉleft = Bytesˉreadˉu32ˉlittle(
                Stackˉslots,
                (Stackˉdepth - 2u32) * 4u32
            );
        }
        Stackˉdepth = Stackˉdepth - Wideˉbitwiseˉoperands;
        Stackˉtypes = Bytesˉslice(Stackˉtypes, 0u32, Stackˉdepth);
        Stackˉslots = Bytesˉslice(
            Stackˉslots, 0u32, Stackˉdepth * 4u32
        );
        let Wideˉbitwiseˉresult: u32 =
            Layout.Compilerˉnativeˉx64ˉlayoutˉvalueˉslot(
                Function.Locals,
                Analysis.I32ˉslots,
                Analysis.Boolˉslots,
                Analysis.Textˉslots,
                Analysis.U8ˉslots,
                Analysis.U32ˉslots,
                Analysis.Bytesˉslots,
                10u8,
                Nextˉu32
            );
        Result = Descriptorˉinstructions.Compilerˉnativeˉx64ˉemitˉscalarˉarithmetic(
            Result,
            Opcode,
            Wideˉbitwiseˉleft,
            Wideˉbitwiseˉright,
            Wideˉbitwiseˉresult,
            Invalidˉshiftˉtarget
        );
        Stackˉtypes = Bytesˉconcat(Stackˉtypes, Bytesˉfromˉu8(10u8));
        Stackˉslots = Bytesˉconcat(
            Stackˉslots,
            Bytesˉfromˉu32ˉlittle(Wideˉbitwiseˉresult)
        );
        Stackˉdepth = Stackˉdepth + 1u32;
        Nextˉu32 = Nextˉu32 + 1u32;
    }

    if Opcode == 19u8 || Opcode == 133u8 || Opcode == 176u8 {
        Handled = true;
        var Unaryˉtype: u8 = 1u8;
        var Unaryˉindex: u32 = Nextˉi32;
        if Opcode == 176u8 {
            Unaryˉtype = 5u8;
            Unaryˉindex = Nextˉu32;
        }
        if Opcode == 133u8 {
            Unaryˉtype = 9u8;
            Unaryˉindex = Nextˉu32;
        }
        let Unaryˉinput: u32 = Bytesˉreadˉu32ˉlittle(
            Stackˉslots,
            (Stackˉdepth - 1u32) * 4u32
        );
        Stackˉdepth = Stackˉdepth - 1u32;
        Stackˉtypes = Bytesˉslice(Stackˉtypes, 0u32, Stackˉdepth);
        Stackˉslots = Bytesˉslice(Stackˉslots, 0u32, Stackˉdepth * 4u32);
        let Unaryˉresult: u32 =
            Layout.Compilerˉnativeˉx64ˉlayoutˉvalueˉslot(
                Function.Locals,
                Analysis.I32ˉslots,
                Analysis.Boolˉslots,
                Analysis.Textˉslots,
                Analysis.U8ˉslots,
                Analysis.U32ˉslots,
                Analysis.Bytesˉslots,
                Unaryˉtype,
                Unaryˉindex
            );
        if Opcode == 19u8 {
            Result = Compilerˉnativeˉx64ˉemitˉloadˉeax(
                Result,
                Unaryˉinput * 16u32
            );
            Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 247u8);
            Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 216u8);
            Result = Compilerˉnativeˉx64ˉemitˉoverflowˉbranch(
                Result,
                Overflowˉtarget
            );
            Result = Compilerˉnativeˉx64ˉemitˉstoreˉeax(
                Result,
                Unaryˉresult * 16u32
            );
        } else if Opcode == 133u8 {
            Result = Compilerˉnativeˉx64ˉemitˉloadˉrax(
                Result,
                Unaryˉinput * 16u32
            );
            Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 72u8);
            Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 247u8);
            Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 216u8);
            Result = Compilerˉnativeˉx64ˉemitˉoverflowˉbranch(
                Result,
                Overflowˉtarget
            );
            Result = Compilerˉnativeˉx64ˉemitˉstoreˉrax(
                Result,
                Unaryˉresult * 16u32
            );
        } else {
            Result = Descriptorˉinstructions.Compilerˉnativeˉx64ˉemitˉscalarˉarithmetic(
                Result,
                Opcode,
                Unaryˉinput,
                0u32,
                Unaryˉresult,
                Invalidˉshiftˉtarget
            );
        }
        Stackˉtypes = Bytesˉconcat(Stackˉtypes, Bytesˉfromˉu8(Unaryˉtype));
        Stackˉslots = Bytesˉconcat(
            Stackˉslots,
            Bytesˉfromˉu32ˉlittle(Unaryˉresult)
        );
        Stackˉdepth = Stackˉdepth + 1u32;
        if Opcode == 19u8 {
            Nextˉi32 = Nextˉi32 + 1u32;
        } else {
            Nextˉu32 = Nextˉu32 + 1u32;
        }
    }

    if Compilerˉnativeˉx64ˉisˉi32ˉcomparison(Opcode) ||
        Compilerˉnativeˉx64ˉisˉu32ˉcomparison(Opcode) ||
        Compilerˉnativeˉx64ˉisˉu8ˉcomparison(Opcode) ||
        Compilerˉnativeˉx64ˉisˉi64ˉcomparison(Opcode) ||
        Compilerˉnativeˉx64ˉisˉu64ˉcomparison(Opcode) {
        Handled = true;
        let Scalarˉcompareˉright: u32 = Bytesˉreadˉu32ˉlittle(
            Stackˉslots,
            (Stackˉdepth - 1u32) * 4u32
        );
        let Scalarˉcompareˉleft: u32 = Bytesˉreadˉu32ˉlittle(
            Stackˉslots,
            (Stackˉdepth - 2u32) * 4u32
        );
        Stackˉdepth = Stackˉdepth - 2u32;
        Stackˉtypes = Bytesˉslice(Stackˉtypes, 0u32, Stackˉdepth);
        Stackˉslots = Bytesˉslice(Stackˉslots, 0u32, Stackˉdepth * 4u32);
        let Scalarˉcompareˉresult: u32 =
            Function.Locals + Analysis.I32ˉslots + Nextˉbool;
        if Compilerˉnativeˉx64ˉisˉi64ˉcomparison(Opcode) ||
            Compilerˉnativeˉx64ˉisˉu64ˉcomparison(Opcode) {
            Result = Compilerˉnativeˉx64ˉemitˉwideˉcomparison(
                Result,
                Scalarˉcompareˉleft,
                Scalarˉcompareˉright,
                Compilerˉnativeˉx64ˉcomparisonˉcondition(Opcode),
                Scalarˉcompareˉresult
            );
        } else {
            Result = Compilerˉnativeˉx64ˉemitˉcomparison(
                Result,
                Scalarˉcompareˉleft,
                Scalarˉcompareˉright,
                Compilerˉnativeˉx64ˉcomparisonˉcondition(Opcode),
                Scalarˉcompareˉresult
            );
        }
        Stackˉtypes = Bytesˉconcat(Stackˉtypes, Bytesˉfromˉu8(2u8));
        Stackˉslots = Bytesˉconcat(
            Stackˉslots,
            Bytesˉfromˉu32ˉlittle(Scalarˉcompareˉresult)
        );
        Stackˉdepth = Stackˉdepth + 1u32;
        Nextˉbool = Nextˉbool + 1u32;
    }

    if Compilerˉnativeˉx64ˉisˉboolˉcomparison(Opcode) {
        Handled = true;
        let Boolˉcompareˉright: u32 = Bytesˉreadˉu32ˉlittle(
            Stackˉslots,
            (Stackˉdepth - 1u32) * 4u32
        );
        let Boolˉcompareˉleft: u32 = Bytesˉreadˉu32ˉlittle(
            Stackˉslots,
            (Stackˉdepth - 2u32) * 4u32
        );
        Stackˉdepth = Stackˉdepth - 2u32;
        Stackˉtypes = Bytesˉslice(Stackˉtypes, 0u32, Stackˉdepth);
        Stackˉslots = Bytesˉslice(Stackˉslots, 0u32, Stackˉdepth * 4u32);
        let Boolˉcompareˉresult: u32 =
            Function.Locals + Analysis.I32ˉslots + Nextˉbool;
        Result = Compilerˉnativeˉx64ˉemitˉcomparison(
            Result,
            Boolˉcompareˉleft,
            Boolˉcompareˉright,
            Compilerˉnativeˉx64ˉcomparisonˉcondition(Opcode),
            Boolˉcompareˉresult
        );
        Stackˉtypes = Bytesˉconcat(Stackˉtypes, Bytesˉfromˉu8(2u8));
        Stackˉslots = Bytesˉconcat(
            Stackˉslots,
            Bytesˉfromˉu32ˉlittle(Boolˉcompareˉresult)
        );
        Stackˉdepth = Stackˉdepth + 1u32;
        Nextˉbool = Nextˉbool + 1u32;
    }

    if Opcode == 40u8 {
        Handled = true;
        let Notˉinput: u32 = Bytesˉreadˉu32ˉlittle(
            Stackˉslots,
            (Stackˉdepth - 1u32) * 4u32
        );
        Stackˉdepth = Stackˉdepth - 1u32;
        Stackˉtypes = Bytesˉslice(Stackˉtypes, 0u32, Stackˉdepth);
        Stackˉslots = Bytesˉslice(Stackˉslots, 0u32, Stackˉdepth * 4u32);
        let Notˉresult: u32 = Function.Locals + Analysis.I32ˉslots + Nextˉbool;
        Result = Compilerˉnativeˉx64ˉemitˉloadˉeax(
            Result,
            Notˉinput * 16u32
        );
        Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 131u8);
        Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 240u8);
        Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 1u8);
        Result = Compilerˉnativeˉx64ˉemitˉstoreˉeax(
            Result,
            Notˉresult * 16u32
        );
        Stackˉtypes = Bytesˉconcat(Stackˉtypes, Bytesˉfromˉu8(2u8));
        Stackˉslots = Bytesˉconcat(
            Stackˉslots,
            Bytesˉfromˉu32ˉlittle(Notˉresult)
        );
        Stackˉdepth = Stackˉdepth + 1u32;
        Nextˉbool = Nextˉbool + 1u32;
    }

    return Compilerˉnativeˉx64ˉscalarˉemissionˉstate(
        State.Valid,
        Handled,
        Result,
        Stackˉtypes,
        Stackˉslots,
        Stackˉdepth,
        Nextˉi32,
        Nextˉbool,
        Nextˉtext,
        Nextˉu8,
        Nextˉu32,
        Nextˉbytes,
        Nextˉenum,
        State.Nextˉrecord
    );
}

fn Compilerˉnativeˉx64ˉemitˉcallableˉcondition(
    Result: bytes,
    Condition: u8,
    Target: u32
) -> bytes {
    var Output: bytes = Compilerˉnativeˉx64ˉappendˉbyte(Result, 15u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, Condition);
    return Compilerˉnativeˉx64ˉappendˉu32(
        Output,
        Compilerˉnativeˉx64ˉrelativeˉu32(
            Target, Bytesˉlength(Output) + 4u32
        )
    );
}

fn Compilerˉnativeˉx64ˉemitˉcallableˉheader(
    Result: bytes,
    Slot: u32,
    Target: u32,
    Callableˉtype: u32
) -> bytes {
    var Output: bytes = Compilerˉnativeˉx64ˉappendˉbyte(Result, 184u8);
    Output = Compilerˉnativeˉx64ˉappendˉu32(Output, Target);
    Output = Compilerˉnativeˉx64ˉemitˉstoreˉeax(
        Output, Slot * 16u32
    );
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 184u8);
    Output = Compilerˉnativeˉx64ˉappendˉu32(Output, Callableˉtype);
    return Compilerˉnativeˉx64ˉemitˉstoreˉeax(
        Output, Slot * 16u32 + 4u32
    );
}

fn Compilerˉnativeˉx64ˉemitˉcallableˉreference(
    Result: bytes,
    Slot: u32,
    Target: u32,
    Callableˉtype: u32
) -> bytes {
    var Output: bytes = Compilerˉnativeˉx64ˉemitˉcallableˉheader(
        Result, Slot, Target, Callableˉtype
    );
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 49u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 192u8);
    return Compilerˉnativeˉx64ˉemitˉstoreˉrax(
        Output, Slot * 16u32 + 8u32
    );
}

fn Compilerˉnativeˉx64ˉemitˉcallableˉclosure(
    Result: bytes,
    Stackˉslots: bytes,
    Stackˉdepth: u32,
    Captures: u32,
    Environmentˉslot: u32,
    Callableˉslot: u32,
    Target: u32,
    Callableˉtype: u32
) -> bytes {
    var Output: bytes = Result;
    var Capture: u32 = 0u32;
    while Capture < Captures {
        let Sourceˉslot: u32 = Bytesˉreadˉu32ˉlittle(
            Stackˉslots,
            (Stackˉdepth - Captures + Capture) * 4u32
        );
        let Destinationˉslot: u32 = Environmentˉslot + Capture;
        Output = Compilerˉnativeˉx64ˉemitˉloadˉrax(
            Output, Sourceˉslot * 16u32
        );
        Output = Compilerˉnativeˉx64ˉemitˉstoreˉrax(
            Output, Destinationˉslot * 16u32
        );
        Output = Compilerˉnativeˉx64ˉemitˉloadˉrax(
            Output, Sourceˉslot * 16u32 + 8u32
        );
        Output = Compilerˉnativeˉx64ˉemitˉstoreˉrax(
            Output, Destinationˉslot * 16u32 + 8u32
        );
        Capture = Capture + 1u32;
    }
    Output = Compilerˉnativeˉx64ˉemitˉcallableˉheader(
        Output, Callableˉslot, Target, Callableˉtype
    );
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 72u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 141u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 132u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 36u8);
    Output = Compilerˉnativeˉx64ˉappendˉu32(
        Output, Environmentˉslot * 16u32
    );
    return Compilerˉnativeˉx64ˉemitˉstoreˉrax(
        Output, Callableˉslot * 16u32 + 8u32
    );
}

fn Compilerˉnativeˉx64ˉemitˉcallableˉvalidation(
    Result: bytes,
    Callableˉslot: u32,
    Target: u32,
    Callableˉtype: u32,
    Captures: u32,
    Environmentˉbase: u32,
    Environmentˉslots: u32,
    Captureˉbase: u32,
    Invalidˉtarget: u32
) -> bytes {
    var Output: bytes = Compilerˉnativeˉx64ˉemitˉloadˉeax(
        Result, Callableˉslot * 16u32
    );
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 61u8);
    Output = Compilerˉnativeˉx64ˉappendˉu32(Output, Target);
    Output = Compilerˉnativeˉx64ˉemitˉcallableˉcondition(
        Output, 133u8, Invalidˉtarget
    );
    Output = Compilerˉnativeˉx64ˉemitˉloadˉeax(
        Output, Callableˉslot * 16u32 + 4u32
    );
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 61u8);
    Output = Compilerˉnativeˉx64ˉappendˉu32(Output, Callableˉtype);
    Output = Compilerˉnativeˉx64ˉemitˉcallableˉcondition(
        Output, 133u8, Invalidˉtarget
    );
    Output = Compilerˉnativeˉx64ˉemitˉloadˉrax(
        Output, Callableˉslot * 16u32 + 8u32
    );
    if Captures == 0u32 {
        Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 72u8);
        Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 133u8);
        Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 192u8);
        return Compilerˉnativeˉx64ˉemitˉcallableˉcondition(
            Output, 133u8, Invalidˉtarget
        );
    }
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 72u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 141u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 140u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 36u8);
    Output = Compilerˉnativeˉx64ˉappendˉu32(
        Output, Environmentˉbase * 16u32
    );
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 72u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 57u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 200u8);
    Output = Compilerˉnativeˉx64ˉemitˉcallableˉcondition(
        Output, 130u8, Invalidˉtarget
    );
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 72u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 141u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 140u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 36u8);
    Output = Compilerˉnativeˉx64ˉappendˉu32(
        Output,
        (Environmentˉbase + Environmentˉslots - Captures) * 16u32
    );
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 72u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 57u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 200u8);
    Output = Compilerˉnativeˉx64ˉemitˉcallableˉcondition(
        Output, 135u8, Invalidˉtarget
    );
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 168u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 15u8);
    Output = Compilerˉnativeˉx64ˉemitˉcallableˉcondition(
        Output, 133u8, Invalidˉtarget
    );
    var Capture: u32 = 0u32;
    while Capture < Captures {
        Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 72u8);
        Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 139u8);
        Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 136u8);
        Output = Compilerˉnativeˉx64ˉappendˉu32(
            Output, Capture * 16u32
        );
        Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 72u8);
        Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 137u8);
        Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 140u8);
        Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 36u8);
        Output = Compilerˉnativeˉx64ˉappendˉu32(
            Output, (Captureˉbase + Capture) * 16u32
        );
        Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 72u8);
        Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 139u8);
        Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 136u8);
        Output = Compilerˉnativeˉx64ˉappendˉu32(
            Output, Capture * 16u32 + 8u32
        );
        Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 72u8);
        Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 137u8);
        Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 140u8);
        Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 36u8);
        Output = Compilerˉnativeˉx64ˉappendˉu32(
            Output, (Captureˉbase + Capture) * 16u32 + 8u32
        );
        Capture = Capture + 1u32;
    }
    return Output;
}

export fn Compilerˉnativeˉx64ˉemitˉcontrolˉcode(
    Input: bytes,
    Section: Compilerˉnativeˉx64ˉsection,
    Function: Compilerˉnativeˉx64ˉfunction,
    Analysis: Compilerˉnativeˉx64ˉcontrolˉanalysis,
    Hasˉdivision: bool,
    Hasˉshift: bool,
    Isˉmain: bool,
    Codeˉbase: u32,
    Callˉdirectory: bytes,
    Data: Staticˉdata.Compilerˉnativeˉx64ˉdata,
    Types: Nominalˉtypes.Compilerˉnativeˉx64ˉtypes,
    Capabilityˉtable: Nativeˉcapabilities.Compilerˉnativeˉx64ˉcapabilities
) -> bytes {
    var Ownedˉentryˉbase: u32 = 0u32;
    if Ownedˉcollections.Minorˉisˉsupported(Bytesˉreadˉu16ˉlittle(Input, 6u32)) {
        Ownedˉentryˉbase = Layout.Compilerˉnativeˉx64ˉlayoutˉmachineˉoffset(Callˉdirectory, Compilerˉnativeˉx64ˉownedˉmain(Input));
    }
    let Directoryˉfunctions: u32 = Bytesˉlength(Callˉdirectory) /
        Layout.Compilerˉnativeˉx64ˉlayoutˉentryˉbytes();
    let Lastˉfunction: u32 = Directoryˉfunctions - 1u32;
    let Helperˉglobalˉoffset: u32 =
        Layout.Compilerˉnativeˉx64ˉlayoutˉmachineˉoffset(
            Callˉdirectory, Lastˉfunction
        ) +
        Layout.Compilerˉnativeˉx64ˉlayoutˉmachineˉlength(
            Callˉdirectory, Lastˉfunction
        );
    let Slots: u32 = Compilerˉnativeˉx64ˉframeˉslots(
        Function,
        Analysis
    );
    let Frameˉbytes: u32 = Slots * 16u32;
    let Prologueˉbytes: u32 = Compilerˉnativeˉx64ˉprologueˉbytes(
        Function, Analysis, Isˉmain
    );
    let Propagateˉoffset: u32 = Prologueˉbytes + Analysis.Bodyˉbytes;
    var Restoreˉbytes: u32 = 11u32;
    var Sharedˉreturnˉoffset: u32 = Propagateˉoffset;
    if Function.Sharedˉvalues {
        let Tailˉbytes: u32 = Compilerˉnativeˉx64ˉsharedˉreturnˉtailˉbytes(Input, Function, Types, Isˉmain);
        if Tailˉbytes > Analysis.Bodyˉbytes { return Compilerˉnativeˉx64ˉempty(Input); }
        Sharedˉreturnˉoffset = Propagateˉoffset - Tailˉbytes;
    }
    var Statusˉbytes: u32 = 21u32;
    if Function.Returnˉtype == 8u8 || Function.Returnˉtype == 9u8 || Function.Returnˉtype == 10u8 {
        Statusˉbytes = 23u32;
    }
    if Isˉmain {
        Restoreˉbytes = 13u32;
        Statusˉbytes = 23u32;
        if Function.Returnˉtype == 8u8 || Function.Returnˉtype == 9u8 || Function.Returnˉtype == 10u8 {
            Statusˉbytes = 25u32;
        }
    }
    let Overflowˉoffset: u32 = Propagateˉoffset + Restoreˉbytes;
    let Instructionˉlimitˉoffset: u32 = Overflowˉoffset + Statusˉbytes;
    let Boundsˉoffset: u32 = Overflowˉoffset + Statusˉbytes * 2u32;
    let Byteˉboundsˉoffset: u32 = Overflowˉoffset + Statusˉbytes * 3u32;
    let Runtimeˉserviceˉoffset: u32 = Overflowˉoffset + Statusˉbytes * 4u32;
    let Invalidˉutf8ˉoffset: u32 = Overflowˉoffset + Statusˉbytes * 5u32;
    let Divisionˉbyˉzeroˉoffset: u32 = Overflowˉoffset + Statusˉbytes * 7u32;
    var Invalidˉshiftˉoffset: u32 = Divisionˉbyˉzeroˉoffset;
    if Hasˉdivision {
        Invalidˉshiftˉoffset = Overflowˉoffset + Statusˉbytes * 8u32;
    }
    var Depthˉoffset: u32 = Invalidˉshiftˉoffset;
    if Hasˉshift {
        Depthˉoffset = Invalidˉshiftˉoffset + Statusˉbytes;
    }
    let Blockˉoffsets: bytes = Compilerˉnativeˉx64ˉbuildˉblockˉoffsets(
        Input,
        Section,
        Analysis.Leaders,
        Prologueˉbytes,
        Isˉmain,
        Callˉdirectory,
        Function,
        Types,
        Capabilityˉtable,
        Analysis.Reclamation,
        Analysis.Ownedˉlocals,
        Analysis.Instructionˉsizes
    );
    let Returnsˉrecord: bool =
        Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉisˉrecord(
            Function.Returnˉtype
        );
    let Returnsˉdescriptor: bool =
        Descriptorˉcalls.Compilerˉnativeˉx64ˉtypeˉisˉdescriptor(
            Function.Returnˉtype
        );
    let Hiddenˉresultˉslot: u32 =
        Compilerˉnativeˉx64ˉhiddenˉresultˉslot(
            Function,
            Analysis
        );
    var Emittedˉprefix: bytes = Compilerˉnativeˉx64ˉempty(Input);
    var Emittedˉgroup: bytes = Compilerˉnativeˉx64ˉempty(Input);
    var Emittedˉprefixˉbytes: u32 = 0u32;
    var Result: bytes = Compilerˉnativeˉx64ˉemitˉcontrolˉprologue(
        Input,
        Function,
        Isˉmain,
        Frameˉbytes,
        Depthˉoffset,
        Returnsˉrecord,
        Returnsˉdescriptor,
        Hiddenˉresultˉslot,
        Bytesˉlength(Analysis.Reclamation) > 0u32
    );
    let Ownedˉframeˉbase: u32 = Compilerˉnativeˉx64ˉownedˉframeˉbase(Function, Analysis);
    let Ownedˉmetadataˉoffset: u32 = Prologueˉbytes -
        Ownedˉframes.Prologueˉbytes(Analysis.Ownedˉlocals, Function.Parameters) + 5u32;
    Result = Bytesˉconcat(Result, Ownedˉframes.Emitˉprologue(
        Analysis.Ownedˉlocals, Function.Parameters, Ownedˉframeˉbase));

    var Stackˉtypes: bytes = Compilerˉnativeˉx64ˉempty(Input);
    var Stackˉidentities: bytes = Compilerˉnativeˉx64ˉempty(Input);
    var Stackˉslots: bytes = Compilerˉnativeˉx64ˉempty(Input);
    var Stackˉdepth: u32 = 0u32;
    var Nextˉi32: u32 = 0u32;
    var Nextˉbool: u32 = 0u32;
    var Nextˉtext: u32 = 0u32;
    var Nextˉu8: u32 = 0u32;
    var Nextˉu32: u32 = 0u32;
    var Nextˉbytes: u32 = 0u32;
    var Nextˉenum: u32 = 0u32;
    var Nextˉrecord: u32 = 0u32;
    var Emissionˉblock: u32 = 0u32;
    var Scratchˉbase: u32 = 0u32;
    var Callableˉenvironmentˉcursor: u32 = 0u32;
    var Cursor: u32 = 0u32;
    while Cursor < Section.Payloadˉlength {
        if Bytesˉreadˉu8(Analysis.Leaders, Cursor) == 1u8 {
            if Cursor > 0u32 { Emissionˉblock = Emissionˉblock + 1u32; }
            if Bytesˉlength(Analysis.Recordˉscratchˉblockˉoffsets) > 0u32 {
                Scratchˉbase = Bytesˉreadˉu32ˉlittle(
                    Analysis.Recordˉscratchˉblockˉoffsets,
                    Emissionˉblock * 4u32
                );
            }
            Stackˉtypes = Compilerˉnativeˉx64ˉempty(Input);
            Stackˉidentities = Compilerˉnativeˉx64ˉempty(Input);
            Stackˉslots = Compilerˉnativeˉx64ˉempty(Input);
            Stackˉdepth = 0u32;
            Nextˉi32 = 0u32;
            Nextˉbool = 0u32;
            Nextˉtext = 0u32;
            Nextˉu8 = 0u32;
            Nextˉu32 = 0u32;
            Nextˉbytes = 0u32;
            Nextˉenum = 0u32;
            Nextˉrecord = 0u32;
            Result = Bytesˉconcat(Result, Liveˉstorage.Compilerˉnativeˉx64ˉliveˉstorageˉblock(
                Analysis.Reclamation, Emissionˉblock
            ));
        }
        let Opcode: u8 = Bytesˉreadˉu8(Input, Section.Payloadˉoffset + Cursor);
        let Beforeˉstack: bytes = Stackˉtypes;
        let Beforeˉslots: bytes = Stackˉslots;
        Result = Compilerˉnativeˉx64ˉemitˉcharge(
            Result,
            Compilerˉnativeˉx64ˉrelativeˉu32(
                Instructionˉlimitˉoffset,
                Emittedˉprefixˉbytes
            )
        );
        if !Function.Sharedˉvalues {
        Result = Bytesˉconcat(Result, Ownedˉframes.Emitˉhook(
            Input, Section.Payloadˉoffset + Cursor, Opcode, Analysis.Ownedˉlocals,
            Ownedˉframeˉbase, Ownedˉmetadataˉoffset, Helperˉglobalˉoffset,
            Ownedˉentryˉbase, Codeˉbase, Emittedˉprefixˉbytes + Bytesˉlength(Result),
            Byteˉboundsˉoffset));
        }
        if Function.Sharedˉvalues && (Opcode == 48u8 || Opcode == 49u8) {
            let Instruction: u32 = Sharedˉlocalˉliveness.Rowˉindex(Analysis.Sharedˉliveness, Cursor);
            if Instruction == 4294967295u32 { return Compilerˉnativeˉx64ˉempty(Input); }
            Result = Compilerˉnativeˉx64ˉsharedˉcleanup(Input, Result, Function, Types,
                Analysis.Sharedˉliveness, Instruction, Section.Payloadˉoffset + Cursor, Opcode,
                4294967295u32,
                Compilerˉnativeˉx64ˉsharedˉrequestˉslot(Function, Analysis), Helperˉglobalˉoffset,
                Codeˉbase + Emittedˉprefixˉbytes,
                Compilerˉnativeˉx64ˉrelativeˉu32(Runtimeˉserviceˉoffset, Emittedˉprefixˉbytes));
        }
        if Function.Sharedˉvalues && Opcode == 5u8 {
            let Local: u32 = Bytesˉreadˉu32ˉlittle(Input, Section.Payloadˉoffset + Cursor + 1u32);
            let Type: u8 = Bytesˉreadˉu8(Function.Localˉtypes, Local);
            if Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉisˉrecord(Type) {
                Result = Compilerˉnativeˉx64ˉsharedˉdrop(Input, Result, Types, Type,
                    Bytesˉreadˉu32ˉlittle(Function.Localˉtypeˉidentities, Local * 4u32), Local,
                    Compilerˉnativeˉx64ˉsharedˉrequestˉslot(Function, Analysis), Helperˉglobalˉoffset,
                    Codeˉbase + Emittedˉprefixˉbytes,
                    Compilerˉnativeˉx64ˉrelativeˉu32(Runtimeˉserviceˉoffset, Emittedˉprefixˉbytes));
            }
        }
        if Function.Sharedˉvalues && Opcode == 81u8 {
            var Source: u32 = 0u32;
            if Function.Returnˉtype != 0u8 { Source = Bytesˉreadˉu32ˉlittle(Stackˉslots, (Stackˉdepth - 1u32) * 4u32); }
            Result = Compilerˉnativeˉx64ˉemitˉsharedˉreturn(Input, Result, Function, Analysis, Types,
                Source, Hiddenˉresultˉslot,
                Compilerˉnativeˉx64ˉrelativeˉu32(Sharedˉreturnˉoffset, Emittedˉprefixˉbytes),
                Compilerˉnativeˉx64ˉsharedˉrequestˉslot(Function, Analysis), Helperˉglobalˉoffset,
                Codeˉbase + Emittedˉprefixˉbytes,
                Compilerˉnativeˉx64ˉrelativeˉu32(Runtimeˉserviceˉoffset, Emittedˉprefixˉbytes));
        } else if Function.Sharedˉvalues && Opcode == 80u8 {
            if Stackˉdepth == 0u32 || Bytesˉlength(Stackˉidentities) != Stackˉdepth * 4u32 {
                return Compilerˉnativeˉx64ˉempty(Input);
            }
            Result = Compilerˉnativeˉx64ˉsharedˉdrop(Input, Result, Types,
                Bytesˉreadˉu8(Stackˉtypes, Stackˉdepth - 1u32),
                Bytesˉreadˉu32ˉlittle(Stackˉidentities, (Stackˉdepth - 1u32) * 4u32),
                Bytesˉreadˉu32ˉlittle(Stackˉslots, (Stackˉdepth - 1u32) * 4u32),
                Compilerˉnativeˉx64ˉsharedˉrequestˉslot(Function, Analysis), Helperˉglobalˉoffset,
                Codeˉbase + Emittedˉprefixˉbytes,
                Compilerˉnativeˉx64ˉrelativeˉu32(Runtimeˉserviceˉoffset, Emittedˉprefixˉbytes));
            Stackˉdepth = Stackˉdepth - 1u32;
            Stackˉtypes = Bytesˉslice(Stackˉtypes, 0u32, Stackˉdepth);
            Stackˉslots = Bytesˉslice(Stackˉslots, 0u32, Stackˉdepth * 4u32);
        } else if Function.Sharedˉvalues && Sharedˉbytes.Legacyˉisˉsupported(Opcode) {
            let Sharedˉstate: Recordˉinstructions.Compilerˉnativeˉx64ˉrecordˉstate =
                Sharedˉbytes.Emitˉlegacy(Input, Section.Payloadˉoffset + Cursor, Opcode,
                    Recordˉinstructions.Compilerˉnativeˉx64ˉrecordˉlayout(
                        Function.Locals, Analysis.I32ˉslots, Analysis.Boolˉslots,
                        Analysis.Textˉslots, Analysis.U8ˉslots, Analysis.U32ˉslots,
                        Analysis.Bytesˉslots, 0u32, 0u32, 0u32),
                    Compilerˉnativeˉx64ˉsharedˉrequestˉslot(Function, Analysis), Helperˉglobalˉoffset,
                    Codeˉbase + Emittedˉprefixˉbytes,
                    Compilerˉnativeˉx64ˉrelativeˉu32(Runtimeˉserviceˉoffset, Emittedˉprefixˉbytes),
                    Recordˉinstructions.Compilerˉnativeˉx64ˉrecordˉstate(
                        Result, Stackˉtypes, Stackˉslots, Stackˉdepth,
                        Nextˉi32, Nextˉbool, Nextˉtext, Nextˉu8,
                        Nextˉu32, Nextˉbytes, Nextˉenum, Nextˉrecord));
            Result = Sharedˉstate.Result;
            Stackˉtypes = Sharedˉstate.Stackˉtypes;
            Stackˉslots = Sharedˉstate.Stackˉslots;
            Stackˉdepth = Sharedˉstate.Stackˉdepth;
            Nextˉi32 = Sharedˉstate.Nextˉi32;
            Nextˉbool = Sharedˉstate.Nextˉbool;
            Nextˉtext = Sharedˉstate.Nextˉtext;
            Nextˉu8 = Sharedˉstate.Nextˉu8;
            Nextˉu32 = Sharedˉstate.Nextˉu32;
            Nextˉbytes = Sharedˉstate.Nextˉbytes;
        } else {
        if Opcode == 211u8 || Opcode == 212u8 || Opcode == 213u8 {
            if Opcode == 211u8 {
                let Nativeˉreferenceˉtarget: u32 = Bytesˉreadˉu32ˉlittle(
                    Input, Section.Payloadˉoffset + Cursor + 1u32
                );
                let Nativeˉreferenceˉtype: u32 = Bytesˉreadˉu32ˉlittle(
                    Input, Section.Payloadˉoffset + Cursor + 5u32
                );
                let Nativeˉreferenceˉslot: u32 =
                    Layout.Compilerˉnativeˉx64ˉlayoutˉvalueˉslot(
                        Function.Locals, Analysis.I32ˉslots,
                        Analysis.Boolˉslots, Analysis.Textˉslots,
                        Analysis.U8ˉslots, Analysis.U32ˉslots,
                        Analysis.Bytesˉslots, 11u8, Nextˉbytes
                    );
                Result = Compilerˉnativeˉx64ˉemitˉcallableˉreference(
                    Result, Nativeˉreferenceˉslot,
                    Nativeˉreferenceˉtarget, Nativeˉreferenceˉtype
                );
                Stackˉtypes = Bytesˉconcat(
                    Stackˉtypes, Bytesˉfromˉu8(11u8)
                );
                Stackˉslots = Bytesˉconcat(
                    Stackˉslots,
                    Bytesˉfromˉu32ˉlittle(Nativeˉreferenceˉslot)
                );
                Stackˉdepth = Stackˉdepth + 1u32;
                Nextˉbytes = Nextˉbytes + 1u32;
            } else if Opcode == 213u8 {
                let Nativeˉclosureˉtarget: u32 = Bytesˉreadˉu32ˉlittle(
                    Input, Section.Payloadˉoffset + Cursor + 1u32
                );
                let Nativeˉclosureˉtype: u32 = Bytesˉreadˉu32ˉlittle(
                    Input, Section.Payloadˉoffset + Cursor + 5u32
                );
                let Nativeˉclosureˉcaptures: u32 =
                    Bytesˉreadˉu32ˉlittle(
                        Input, Section.Payloadˉoffset + Cursor + 9u32
                    );
                let Nativeˉclosureˉslot: u32 =
                    Layout.Compilerˉnativeˉx64ˉlayoutˉvalueˉslot(
                        Function.Locals, Analysis.I32ˉslots,
                        Analysis.Boolˉslots, Analysis.Textˉslots,
                        Analysis.U8ˉslots, Analysis.U32ˉslots,
                        Analysis.Bytesˉslots, 11u8, Nextˉbytes
                    );
                let Nativeˉenvironmentˉslot: u32 =
                    Compilerˉnativeˉx64ˉcallableˉenvironmentˉbase(
                        Function, Analysis
                    ) + Callableˉenvironmentˉcursor;
                Result = Compilerˉnativeˉx64ˉemitˉcallableˉclosure(
                    Result, Stackˉslots, Stackˉdepth,
                    Nativeˉclosureˉcaptures, Nativeˉenvironmentˉslot,
                    Nativeˉclosureˉslot, Nativeˉclosureˉtarget,
                    Nativeˉclosureˉtype
                );
                Stackˉdepth = Stackˉdepth - Nativeˉclosureˉcaptures;
                Stackˉtypes = Bytesˉslice(
                    Stackˉtypes, 0u32, Stackˉdepth
                );
                Stackˉslots = Bytesˉslice(
                    Stackˉslots, 0u32, Stackˉdepth * 4u32
                );
                Stackˉtypes = Bytesˉconcat(
                    Stackˉtypes, Bytesˉfromˉu8(11u8)
                );
                Stackˉslots = Bytesˉconcat(
                    Stackˉslots,
                    Bytesˉfromˉu32ˉlittle(Nativeˉclosureˉslot)
                );
                Stackˉdepth = Stackˉdepth + 1u32;
                Nextˉbytes = Nextˉbytes + 1u32;
                Callableˉenvironmentˉcursor =
                    Callableˉenvironmentˉcursor + Nativeˉclosureˉcaptures;
            } else {
                let Nativeˉindirectˉtype: u32 = Bytesˉreadˉu32ˉlittle(
                    Input, Section.Payloadˉoffset + Cursor + 1u32
                );
                let Nativeˉindirectˉtarget: u32 =
                    Compilerˉnativeˉx64ˉcallableˉuniqueˉtarget(
                        Input, Types, Nativeˉindirectˉtype,
                        Bytesˉlength(Callˉdirectory) /
                            Layout.Compilerˉnativeˉx64ˉlayoutˉentryˉbytes(),
                        Callˉdirectory
                    );
                let Nativeˉpublicˉparameters: u32 =
                    Nominalˉtypes.Compilerˉnativeˉx64ˉcallableˉparameters(
                        Types, Nativeˉindirectˉtype
                    );
                let Nativeˉphysicalˉparameters: u32 =
                    Layout.Compilerˉnativeˉx64ˉlayoutˉparameters(
                        Callˉdirectory, Nativeˉindirectˉtarget
                    );
                let Nativeˉindirectˉcaptures: u32 =
                    Nativeˉphysicalˉparameters - Nativeˉpublicˉparameters;
                let Nativeˉcallableˉstackˉindex: u32 =
                    Stackˉdepth - Nativeˉpublicˉparameters - 1u32;
                let Nativeˉcallableˉslot: u32 = Bytesˉreadˉu32ˉlittle(
                    Stackˉslots, Nativeˉcallableˉstackˉindex * 4u32
                );
                let Nativeˉenvironmentˉbase: u32 =
                    Compilerˉnativeˉx64ˉcallableˉenvironmentˉbase(
                        Function, Analysis
                    );
                let Nativeˉcaptureˉbase: u32 =
                    Compilerˉnativeˉx64ˉcallableˉcaptureˉbase(
                        Function, Analysis
                    );
                Result = Compilerˉnativeˉx64ˉemitˉcallableˉvalidation(
                    Result, Nativeˉcallableˉslot,
                    Nativeˉindirectˉtarget, Nativeˉindirectˉtype,
                    Nativeˉindirectˉcaptures, Nativeˉenvironmentˉbase,
                    Analysis.Callableˉenvironmentˉslots,
                    Nativeˉcaptureˉbase,
                    Compilerˉnativeˉx64ˉrelativeˉu32(
                        Boundsˉoffset, Emittedˉprefixˉbytes
                    )
                );
                var Nativeˉcallˉtypes: bytes = Bytesˉslice(
                    Stackˉtypes, 0u32, Nativeˉcallableˉstackˉindex
                );
                var Nativeˉcallˉslots: bytes = Bytesˉslice(
                    Stackˉslots, 0u32,
                    Nativeˉcallableˉstackˉindex * 4u32
                );
                var Nativeˉcapture: u32 = 0u32;
                while Nativeˉcapture < Nativeˉindirectˉcaptures {
                    Nativeˉcallˉslots = Bytesˉconcat(
                        Nativeˉcallˉslots,
                        Bytesˉfromˉu32ˉlittle(
                            Nativeˉcaptureˉbase + Nativeˉcapture
                        )
                    );
                    Nativeˉcapture = Nativeˉcapture + 1u32;
                }
                Nativeˉcallˉslots = Bytesˉconcat(
                    Nativeˉcallˉslots,
                    Bytesˉslice(
                        Stackˉslots,
                        (Nativeˉcallableˉstackˉindex + 1u32) * 4u32,
                        Nativeˉpublicˉparameters * 4u32
                    )
                );
                Nativeˉcallˉtypes = Bytesˉconcat(
                    Nativeˉcallˉtypes,
                    Bytesˉslice(
                        Callˉdirectory,
                        Nativeˉindirectˉtarget *
                            Layout.Compilerˉnativeˉx64ˉlayoutˉentryˉbytes() +
                            Layout.Compilerˉnativeˉx64ˉlayoutˉparameterˉtypesˉoffset(),
                        Nativeˉphysicalˉparameters
                    )
                );
                let Nativeˉcallˉstate:
                    Callˉinstructions.Compilerˉnativeˉx64ˉcallˉstate =
                    Compilerˉnativeˉx64ˉemitˉcallˉstep(
                        Nativeˉindirectˉtarget, Function, Analysis,
                        Callˉdirectory,
                        Codeˉbase + Emittedˉprefixˉbytes,
                        Compilerˉnativeˉx64ˉrelativeˉu32(
                            Propagateˉoffset, Emittedˉprefixˉbytes
                        ),
                        Scratchˉbase,
                        Input, Types, Helperˉglobalˉoffset,
                        Compilerˉnativeˉx64ˉrelativeˉu32(Runtimeˉserviceˉoffset, Emittedˉprefixˉbytes),
                        Callˉinstructions.Compilerˉnativeˉx64ˉcallˉstate(
                            Result, Nativeˉcallˉtypes, Nativeˉcallˉslots,
                            Nativeˉcallableˉstackˉindex +
                                Nativeˉphysicalˉparameters,
                            Nextˉi32, Nextˉbool, Nextˉtext, Nextˉu8,
                            Nextˉu32, Nextˉbytes, Nextˉenum, Nextˉrecord
                        )
                    );
                Result = Nativeˉcallˉstate.Result;
                Stackˉtypes = Nativeˉcallˉstate.Stackˉtypes;
                Stackˉslots = Nativeˉcallˉstate.Stackˉslots;
                Stackˉdepth = Nativeˉcallˉstate.Stackˉdepth;
                Nextˉi32 = Nativeˉcallˉstate.Nextˉi32;
                Nextˉbool = Nativeˉcallˉstate.Nextˉbool;
                Nextˉtext = Nativeˉcallˉstate.Nextˉtext;
                Nextˉu8 = Nativeˉcallˉstate.Nextˉu8;
                Nextˉu32 = Nativeˉcallˉstate.Nextˉu32;
                Nextˉbytes = Nativeˉcallˉstate.Nextˉbytes;
                Nextˉenum = Nativeˉcallˉstate.Nextˉenum;
                Nextˉrecord = Nativeˉcallˉstate.Nextˉrecord;
            }
        } else {
        if Compilerˉnativeˉx64ˉdescriptorˉoperation(Opcode) ||
            Opcode == 161u8 || Opcode == 162u8 ||
            Opcode == 165u8 || Opcode == 166u8 {
            let Descriptorˉstate:
                Descriptorˉinstructions.Compilerˉnativeˉx64ˉdescriptorˉstate =
                Descriptorˉinstructions.Compilerˉnativeˉx64ˉemitˉdescriptorˉinstruction(
                    Descriptorˉinstructions.Compilerˉnativeˉx64ˉdescriptorˉinstruction(
                        Input,
                        Section.Payloadˉoffset + Cursor,
                        Opcode,
                        Compilerˉnativeˉx64ˉrelativeˉu32(
                            Byteˉboundsˉoffset,
                            Emittedˉprefixˉbytes
                        ),
                        Compilerˉnativeˉx64ˉrelativeˉu32(
                            Runtimeˉserviceˉoffset,
                            Emittedˉprefixˉbytes
                        ),
                        Compilerˉnativeˉx64ˉrelativeˉu32(
                            Helperˉglobalˉoffset - Codeˉbase,
                            Emittedˉprefixˉbytes
                        ),
                        Compilerˉnativeˉx64ˉrelativeˉu32(
                            Invalidˉutf8ˉoffset,
                            Emittedˉprefixˉbytes
                        ),
                        Compilerˉnativeˉx64ˉrelativeˉu32(
                            Divisionˉbyˉzeroˉoffset,
                            Emittedˉprefixˉbytes
                        )
                    ),
                    Descriptorˉinstructions.Compilerˉnativeˉx64ˉdescriptorˉlayout(
                        Function.Locals,
                        Analysis.I32ˉslots,
                        Analysis.Boolˉslots,
                        Analysis.Textˉslots,
                        Analysis.U8ˉslots,
                        Analysis.U32ˉslots,
                        Analysis.Bytesˉslots
                    ),
                    Data,
                    Descriptorˉinstructions.Compilerˉnativeˉx64ˉdescriptorˉstate(
                        Result,
                        Stackˉtypes,
                        Stackˉslots,
                        Stackˉdepth,
                        Nextˉi32,
                        Nextˉbool,
                        Nextˉtext,
                        Nextˉu8,
                        Nextˉu32,
                        Nextˉbytes
                    )
                );
            Result = Descriptorˉstate.Result;
            Stackˉtypes = Descriptorˉstate.Stackˉtypes;
            Stackˉslots = Descriptorˉstate.Stackˉslots;
            Stackˉdepth = Descriptorˉstate.Stackˉdepth;
            Nextˉi32 = Descriptorˉstate.Nextˉi32;
            Nextˉbool = Descriptorˉstate.Nextˉbool;
            Nextˉtext = Descriptorˉstate.Nextˉtext;
            Nextˉu8 = Descriptorˉstate.Nextˉu8;
            Nextˉu32 = Descriptorˉstate.Nextˉu32;
            Nextˉbytes = Descriptorˉstate.Nextˉbytes;
        }
        if Compilerˉnativeˉx64ˉnominalˉoperation(Opcode) {
            let Enumˉstate: Enumˉinstructions.Compilerˉnativeˉx64ˉenumˉstate =
                Enumˉinstructions.Compilerˉnativeˉx64ˉemitˉenumˉinstruction(
                    Enumˉinstructions.Compilerˉnativeˉx64ˉenumˉinstruction(
                        Input,
                        Section.Payloadˉoffset + Cursor,
                        Opcode,
                        Compilerˉnativeˉx64ˉrelativeˉu32(
                            Runtimeˉserviceˉoffset,
                            Emittedˉprefixˉbytes
                        )
                    ),
                    Enumˉinstructions.Compilerˉnativeˉx64ˉenumˉlayout(
                        Function.Locals,
                        Analysis.I32ˉslots,
                        Analysis.Boolˉslots,
                        Analysis.Textˉslots,
                        Analysis.U8ˉslots,
                        Analysis.U32ˉslots,
                        Analysis.Bytesˉslots
                    ),
                    Types,
                    Enumˉinstructions.Compilerˉnativeˉx64ˉenumˉstate(
                        Result,
                        Stackˉtypes,
                        Stackˉslots,
                        Stackˉdepth,
                        Nextˉbool,
                        Nextˉtext,
                        Nextˉenum
                    )
                );
            Result = Enumˉstate.Result;
            Stackˉtypes = Enumˉstate.Stackˉtypes;
            Stackˉslots = Enumˉstate.Stackˉslots;
            Stackˉdepth = Enumˉstate.Stackˉdepth;
            Nextˉbool = Enumˉstate.Nextˉbool;
            Nextˉtext = Enumˉstate.Nextˉtext;
            Nextˉenum = Enumˉstate.Nextˉenum;
        }
        var Hasˉrecordˉinstruction: bool =
            Compilerˉnativeˉx64ˉrecordˉoperation(Opcode) ||
            Compilerˉnativeˉx64ˉvariantˉoperation(Opcode) ||
            Ownedˉcollections.Operationˉisˉsupported(Opcode) ||
            Sharedˉbytes.Operationˉisˉsupported(Opcode) ||
            Opcode == 220u8 || Opcode == 221u8 || Opcode == 222u8 ||
            Opcode == 223u8 || Opcode == 224u8;
        if Opcode == 4u8 || Opcode == 5u8 || Opcode == 205u8 {
            let Recordˉlocal: u32 = Bytesˉreadˉu32ˉlittle(
                Input,
                Section.Payloadˉoffset + Cursor + 1u32
            );
            if Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉisˉrecord(
                Bytesˉreadˉu8(Function.Localˉtypes, Recordˉlocal)
            ) { Hasˉrecordˉinstruction = true; }
        }
        if Hasˉrecordˉinstruction {
            let Recordˉstate:
                Recordˉinstructions.Compilerˉnativeˉx64ˉrecordˉstate =
                Compilerˉnativeˉx64ˉemitˉrecordˉbackedˉstep(
                    Input,
                    Section.Payloadˉoffset + Cursor,
                    Opcode,
                    Function,
                    Analysis,
                    Types,
                    Scratchˉbase,
                    Isˉmain,
                    Compilerˉnativeˉx64ˉrelativeˉu32(
                        Runtimeˉserviceˉoffset,
                        Emittedˉprefixˉbytes
                    ),
                    Emittedˉprefixˉbytes,
                    Ownedˉentryˉbase,
                    Helperˉglobalˉoffset,
                    Codeˉbase,
                    Recordˉinstructions.Compilerˉnativeˉx64ˉrecordˉstate(
                        Result,
                        Stackˉtypes,
                        Stackˉslots,
                        Stackˉdepth,
                        Nextˉi32,
                        Nextˉbool,
                        Nextˉtext,
                        Nextˉu8,
                        Nextˉu32,
                        Nextˉbytes,
                        Nextˉenum,
                        Nextˉrecord
                    )
                );
            Result = Recordˉstate.Result;
            Stackˉtypes = Recordˉstate.Stackˉtypes;
            Stackˉslots = Recordˉstate.Stackˉslots;
            Stackˉdepth = Recordˉstate.Stackˉdepth;
            Nextˉi32 = Recordˉstate.Nextˉi32;
            Nextˉbool = Recordˉstate.Nextˉbool;
            Nextˉtext = Recordˉstate.Nextˉtext;
            Nextˉu8 = Recordˉstate.Nextˉu8;
            Nextˉu32 = Recordˉstate.Nextˉu32;
            Nextˉbytes = Recordˉstate.Nextˉbytes;
            Nextˉenum = Recordˉstate.Nextˉenum;
            Nextˉrecord = Recordˉstate.Nextˉrecord;
        }
        if Opcode == 6u8 || Opcode == 7u8 {
            let Staticˉdataˉstate:
                Staticˉdataˉinstructions.Compilerˉnativeˉx64ˉstaticˉdataˉstate =
                Staticˉdataˉinstructions.Compilerˉnativeˉx64ˉemitˉstaticˉdataˉinstruction(
                    Staticˉdataˉinstructions.Compilerˉnativeˉx64ˉstaticˉdataˉinstruction(
                        Input,
                        Section.Payloadˉoffset + Cursor,
                        Opcode,
                        Compilerˉnativeˉx64ˉrelativeˉu32(
                            Boundsˉoffset,
                            Emittedˉprefixˉbytes
                        )
                    ),
                    Function.Locals,
                    Data,
                    Staticˉdataˉinstructions.Compilerˉnativeˉx64ˉstaticˉdataˉstate(
                        Result,
                        Stackˉtypes,
                        Stackˉslots,
                        Stackˉdepth,
                        Nextˉi32
                    )
                );
            Result = Staticˉdataˉstate.Result;
            Stackˉtypes = Staticˉdataˉstate.Stackˉtypes;
            Stackˉslots = Staticˉdataˉstate.Stackˉslots;
            Stackˉdepth = Staticˉdataˉstate.Stackˉdepth;
            Nextˉi32 = Staticˉdataˉstate.Nextˉi32;
        }
        if Opcode == 65u8 {
            let Capabilityˉindex: u32 = Bytesˉreadˉu32ˉlittle(
                Input,
                Section.Payloadˉoffset + Cursor + 1u32
            );
            let Capabilityˉkind: u8 =
                Nativeˉcapabilities.Compilerˉnativeˉx64ˉcapabilityˉkind(
                Capabilityˉtable,
                Capabilityˉindex
            );
            let Capabilityˉstate:
                Nativeˉcapabilities.Compilerˉnativeˉx64ˉcapabilityˉstate =
                Nativeˉcapabilities.Compilerˉnativeˉx64ˉemitˉcapability(
                    Capabilityˉkind,
                    Capabilityˉindex,
                    Result,
                    Stackˉtypes,
                    Stackˉslots,
                    Stackˉdepth,
                    Nextˉtext,
                    Nextˉu32,
                    Nextˉbytes,
                    Function.Locals,
                    Analysis.I32ˉslots,
                    Analysis.Boolˉslots,
                    Analysis.Textˉslots,
                    Analysis.U8ˉslots,
                    Analysis.U32ˉslots,
                    Analysis.Bytesˉslots,
                    Compilerˉnativeˉx64ˉrelativeˉu32(
                        Runtimeˉserviceˉoffset,
                        Emittedˉprefixˉbytes
                    )
                );
            Result = Capabilityˉstate.Result;
            Stackˉtypes = Capabilityˉstate.Stackˉtypes;
            Stackˉslots = Capabilityˉstate.Stackˉslots;
            Stackˉdepth = Capabilityˉstate.Stackˉdepth;
            Nextˉtext = Capabilityˉstate.Nextˉtext;
            Nextˉu32 = Capabilityˉstate.Nextˉu32;
            Nextˉbytes = Capabilityˉstate.Nextˉbytes;
        } else {
            let Scalarˉstate: Compilerˉnativeˉx64ˉscalarˉemissionˉstate =
                Compilerˉnativeˉx64ˉemitˉscalarˉinstruction(
                    Input,
                    Section.Payloadˉoffset + Cursor,
                    Opcode,
                    Function,
                    Analysis,
                    Hasˉrecordˉinstruction,
                    Compilerˉnativeˉx64ˉrelativeˉu32(
                        Overflowˉoffset,
                        Emittedˉprefixˉbytes
                    ),
                    Compilerˉnativeˉx64ˉrelativeˉu32(
                        Invalidˉshiftˉoffset,
                        Emittedˉprefixˉbytes
                    ),
                    Compilerˉnativeˉx64ˉsharedˉrequestˉslot(Function, Analysis), Helperˉglobalˉoffset,
                    Codeˉbase + Emittedˉprefixˉbytes,
                    Compilerˉnativeˉx64ˉrelativeˉu32(Runtimeˉserviceˉoffset, Emittedˉprefixˉbytes),
                    Compilerˉnativeˉx64ˉscalarˉemissionˉstate(
                        true,
                        false,
                        Result,
                        Stackˉtypes,
                        Stackˉslots,
                        Stackˉdepth,
                        Nextˉi32,
                        Nextˉbool,
                        Nextˉtext,
                        Nextˉu8,
                        Nextˉu32,
                        Nextˉbytes,
                        Nextˉenum,
                        Nextˉrecord
                    )
                );
            Result = Scalarˉstate.Result;
            Stackˉtypes = Scalarˉstate.Stackˉtypes;
            Stackˉslots = Scalarˉstate.Stackˉslots;
            Stackˉdepth = Scalarˉstate.Stackˉdepth;
            Nextˉi32 = Scalarˉstate.Nextˉi32;
            Nextˉbool = Scalarˉstate.Nextˉbool;
            Nextˉtext = Scalarˉstate.Nextˉtext;
            Nextˉu8 = Scalarˉstate.Nextˉu8;
            Nextˉu32 = Scalarˉstate.Nextˉu32;
            Nextˉbytes = Scalarˉstate.Nextˉbytes;
            Nextˉenum = Scalarˉstate.Nextˉenum;
            Nextˉrecord = Scalarˉstate.Nextˉrecord;

            if !Scalarˉstate.Handled {
                if Opcode == 64u8 {
                    let Callˉtarget: u32 = Bytesˉreadˉu32ˉlittle(
                        Input,
                        Section.Payloadˉoffset + Cursor + 1u32
                    );
                    let Callˉstate:
                        Callˉinstructions.Compilerˉnativeˉx64ˉcallˉstate =
                        Compilerˉnativeˉx64ˉemitˉcallˉstep(
                            Callˉtarget,
                            Function,
                            Analysis,
                            Callˉdirectory,
                            Codeˉbase + Emittedˉprefixˉbytes,
                            Compilerˉnativeˉx64ˉrelativeˉu32(
                                Propagateˉoffset,
                                Emittedˉprefixˉbytes
                            ),
                            Scratchˉbase,
                            Input, Types, Helperˉglobalˉoffset,
                            Compilerˉnativeˉx64ˉrelativeˉu32(Runtimeˉserviceˉoffset, Emittedˉprefixˉbytes),
                            Callˉinstructions.Compilerˉnativeˉx64ˉcallˉstate(
                                Result,
                                Stackˉtypes,
                                Stackˉslots,
                                Stackˉdepth,
                                Nextˉi32,
                                Nextˉbool,
                                Nextˉtext,
                                Nextˉu8,
                                Nextˉu32,
                                Nextˉbytes,
                                Nextˉenum,
                                Nextˉrecord
                            )
                        );
                    Result = Callˉstate.Result;
                    Stackˉtypes = Callˉstate.Stackˉtypes;
                    Stackˉslots = Callˉstate.Stackˉslots;
                    Stackˉdepth = Callˉstate.Stackˉdepth;
                    Nextˉi32 = Callˉstate.Nextˉi32;
                    Nextˉbool = Callˉstate.Nextˉbool;
                    Nextˉtext = Callˉstate.Nextˉtext;
                    Nextˉu8 = Callˉstate.Nextˉu8;
                    Nextˉu32 = Callˉstate.Nextˉu32;
                    Nextˉbytes = Callˉstate.Nextˉbytes;
                    Nextˉenum = Callˉstate.Nextˉenum;
                    Nextˉrecord = Callˉstate.Nextˉrecord;
                } else {
                    if Opcode == 48u8 {
                        let Jumpˉwvbˉtarget: u32 = Bytesˉreadˉu32ˉlittle(
                            Input,
                            Section.Payloadˉoffset + Cursor + 1u32
                        );
                        Result = Compilerˉnativeˉx64ˉemitˉjump(
                            Result,
                            Compilerˉnativeˉx64ˉrelativeˉu32(
                                Compilerˉnativeˉx64ˉmachineˉtarget(
                                    Analysis.Blockˉoffsets,
                                    Blockˉoffsets,
                                    Jumpˉwvbˉtarget
                                ),
                                Emittedˉprefixˉbytes
                            )
                        );
                    } else {
                        if Opcode == 49u8 {
                            let Branchˉconditionˉslot: u32 =
                                Bytesˉreadˉu32ˉlittle(
                                    Stackˉslots,
                                    (Stackˉdepth - 1u32) * 4u32
                                );
                            Stackˉdepth = Stackˉdepth - 1u32;
                            Stackˉtypes = Bytesˉslice(
                                Stackˉtypes,
                                0u32,
                                Stackˉdepth
                            );
                            Stackˉslots = Bytesˉslice(
                                Stackˉslots,
                                0u32,
                                Stackˉdepth * 4u32
                            );
                            let Branchˉfalseˉwvb: u32 =
                                Bytesˉreadˉu32ˉlittle(
                                    Input,
                                    Section.Payloadˉoffset + Cursor + 1u32
                                );
                            let Branchˉnextˉwvb: u32 = Cursor + 5u32;
                            let Branchˉtrueˉtarget: u32 = Compilerˉnativeˉx64ˉrelativeˉu32(
                                Compilerˉnativeˉx64ˉmachineˉtarget(Analysis.Blockˉoffsets,
                                    Blockˉoffsets, Branchˉnextˉwvb), Emittedˉprefixˉbytes);
                            let Branchˉfalseˉtarget: u32 = Compilerˉnativeˉx64ˉrelativeˉu32(
                                Compilerˉnativeˉx64ˉmachineˉtarget(Analysis.Blockˉoffsets,
                                    Blockˉoffsets, Branchˉfalseˉwvb), Emittedˉprefixˉbytes);
                            if Function.Sharedˉvalues {
                                Result = Compilerˉnativeˉx64ˉemitˉsharedˉconditionalˉbranch(Input, Result,
                                    Function, Types, Analysis.Sharedˉliveness, Cursor, Branchˉnextˉwvb,
                                    Branchˉfalseˉwvb, Branchˉconditionˉslot, Branchˉtrueˉtarget, Branchˉfalseˉtarget,
                                    Compilerˉnativeˉx64ˉsharedˉrequestˉslot(Function, Analysis), Helperˉglobalˉoffset,
                                    Codeˉbase + Emittedˉprefixˉbytes,
                                    Compilerˉnativeˉx64ˉrelativeˉu32(Runtimeˉserviceˉoffset, Emittedˉprefixˉbytes));
                            } else {
                                Result = Compilerˉnativeˉx64ˉemitˉconditionalˉbranch(Result, Branchˉconditionˉslot,
                                    Branchˉtrueˉtarget, Branchˉfalseˉtarget);
                            }
                        } else {
                            if Opcode == 81u8 {
                                if Function.Returnˉtype == 0u8 {
                                    Result = Compilerˉnativeˉx64ˉappendˉbyte(
                                        Result,
                                        49u8
                                    );
                                    Result = Compilerˉnativeˉx64ˉappendˉbyte(
                                        Result,
                                        192u8
                                    );
                                    Result = Compilerˉnativeˉx64ˉemitˉframe(
                                        Result,
                                        false,
                                        Frameˉbytes
                                    );
                                    Result = Compilerˉnativeˉx64ˉemitˉrestoreˉfor(
                                        Result,
                                        Isˉmain
                                    );
                                } else {
                                    let Returnˉslot: u32 =
                                        Bytesˉreadˉu32ˉlittle(
                                            Stackˉslots,
                                            (Stackˉdepth - 1u32) * 4u32
                                        );
                                    Stackˉdepth = Stackˉdepth - 1u32;
                                    Stackˉtypes = Bytesˉslice(
                                        Stackˉtypes,
                                        0u32,
                                        Stackˉdepth
                                    );
                                    Stackˉslots = Bytesˉslice(
                                        Stackˉslots,
                                        0u32,
                                        Stackˉdepth * 4u32
                                    );
                                    if Returnsˉrecord {
                                    let Returnˉtypeˉindex: u32 =
                                        Nominalˉtypes.Compilerˉnativeˉx64ˉrecordˉtypeˉindex(Types,
                                            Function.Returnˉtype
                                        );
                                    Result = Records.Compilerˉnativeˉx64ˉemitˉrecordˉreturn(
                                        Result,
                                        Input, Types, Returnˉtypeˉindex,
                                        Returnˉslot,
                                        Hiddenˉresultˉslot,
                                        Frameˉbytes
                                    );
                                } else {
                                    if Returnsˉdescriptor {
                                        Result = Descriptorˉcalls.Compilerˉnativeˉx64ˉemitˉdescriptorˉreturn(
                                            Result,
                                            Returnˉslot,
                                            Hiddenˉresultˉslot,
                                            Frameˉbytes,
                                            Isˉmain
                                        );
                                    } else {
                                        if Function.Returnˉtype == 9u8 ||
                                            Function.Returnˉtype == 10u8 {
                                            Result = Compilerˉnativeˉx64ˉemitˉloadˉrax(
                                                Result,
                                                Returnˉslot * 16u32
                                            );
                                            Result = Compilerˉnativeˉx64ˉappendˉbyte(
                                                Result, 49u8
                                            );
                                            Result = Compilerˉnativeˉx64ˉappendˉbyte(
                                                Result, 210u8
                                            );
                                        } else {
                                            Result = Compilerˉnativeˉx64ˉemitˉloadˉeax(
                                                Result,
                                                Returnˉslot * 16u32
                                            );
                                        }
                                        Result = Compilerˉnativeˉx64ˉemitˉframe(
                                            Result,
                                            false,
                                            Frameˉbytes
                                        );
                                        Result = Compilerˉnativeˉx64ˉemitˉrestoreˉfor(
                                            Result,
                                            Isˉmain
                                        );
                                    }
                                }
                                }
                            }
                        }
                    }
                }
            }
        }

        }
        }
        if Function.Sharedˉvalues {
            Result = Compilerˉnativeˉx64ˉsharedˉtransition(Input, Result,
                Section.Payloadˉoffset + Cursor, Opcode, Function, Types, Beforeˉstack, Beforeˉslots,
                Stackˉtypes, Stackˉslots, Compilerˉnativeˉx64ˉsharedˉrequestˉslot(Function, Analysis),
                Helperˉglobalˉoffset, Codeˉbase + Emittedˉprefixˉbytes,
                Compilerˉnativeˉx64ˉrelativeˉu32(Runtimeˉserviceˉoffset, Emittedˉprefixˉbytes));
            if !Compilerˉnativeˉx64ˉsharedˉvirtualˉrootsˉmatch(Analysis.Sharedˉliveness.Virtualˉdependencies,
                Function.Locals, Cursor, Beforeˉstack, Stackˉtypes) {
                return Compilerˉnativeˉx64ˉempty(Input);
            }
            if Opcode != 48u8 && Opcode != 49u8 && Opcode != 81u8 {
                let Cleanupˉinstruction: u32 = Sharedˉlocalˉliveness.Rowˉindex(Analysis.Sharedˉliveness, Cursor);
                if Cleanupˉinstruction == 4294967295u32 { return Compilerˉnativeˉx64ˉempty(Input); }
                Result = Compilerˉnativeˉx64ˉsharedˉcleanup(Input, Result, Function, Types,
                    Analysis.Sharedˉliveness, Cleanupˉinstruction, Section.Payloadˉoffset + Cursor, Opcode,
                    4294967295u32,
                    Compilerˉnativeˉx64ˉsharedˉrequestˉslot(Function, Analysis), Helperˉglobalˉoffset,
                    Codeˉbase + Emittedˉprefixˉbytes,
                    Compilerˉnativeˉx64ˉrelativeˉu32(Runtimeˉserviceˉoffset, Emittedˉprefixˉbytes));
            }
            let Row: u32 = Compilerˉnativeˉx64ˉinstructionˉmetadataˉoffset(Analysis.Instructionˉsizes, Cursor);
            if Row == 4294967295u32 { return Compilerˉnativeˉx64ˉempty(Input); }
            var Callˉreturn: u8 = 1u8;
            if Opcode == 64u8 {
                Callˉreturn = Layout.Compilerˉnativeˉx64ˉlayoutˉreturnˉtype(Callˉdirectory,
                    Bytesˉreadˉu32ˉlittle(Input, Section.Payloadˉoffset + Cursor + 1u32));
            }
            if Compilerˉnativeˉx64ˉinstructionˉproduces(Opcode, Callˉreturn) {
                if Stackˉdepth == 0u32 { return Compilerˉnativeˉx64ˉempty(Input); }
                Stackˉidentities = Bytesˉconcat(Bytesˉslice(Stackˉidentities, 0u32, (Stackˉdepth - 1u32) * 4u32),
                    Bytesˉslice(Analysis.Instructionˉsizes, Row + 8u32, 4u32));
            } else { Stackˉidentities = Bytesˉslice(Stackˉidentities, 0u32, Stackˉdepth * 4u32); }
        }
        Cursor = Cursor + Compilerˉnativeˉx64ˉinstructionˉsize(Opcode);
        // Keep immutable code assembly bounded while preserving function-relative offsets.
        if Bytesˉlength(Result) >= 4096u32 {
            Emittedˉgroup = Bytesˉconcat(Emittedˉgroup, Result);
            Emittedˉprefixˉbytes = Emittedˉprefixˉbytes +
                Bytesˉlength(Result);
            Result = Compilerˉnativeˉx64ˉempty(Input);
            if Bytesˉlength(Emittedˉgroup) >= 65536u32 {
                Emittedˉprefix = Bytesˉconcat(
                    Emittedˉprefix,
                    Emittedˉgroup
                );
                Emittedˉgroup = Compilerˉnativeˉx64ˉempty(Input);
            }
        }
    }

    if Function.Sharedˉvalues {
        if Emittedˉprefixˉbytes + Bytesˉlength(Result) != Sharedˉreturnˉoffset {
            return Compilerˉnativeˉx64ˉempty(Input);
        }
        Result = Compilerˉnativeˉx64ˉemitˉsharedˉreturnˉtail(Input, Result, Function, Analysis, Types,
            Frameˉbytes, Isˉmain, Compilerˉnativeˉx64ˉsharedˉrequestˉslot(Function, Analysis),
            Helperˉglobalˉoffset, Codeˉbase + Emittedˉprefixˉbytes,
            Compilerˉnativeˉx64ˉrelativeˉu32(Runtimeˉserviceˉoffset, Emittedˉprefixˉbytes));
        if Emittedˉprefixˉbytes + Bytesˉlength(Result) != Propagateˉoffset {
            return Compilerˉnativeˉx64ˉempty(Input);
        }
    }
    Result = Compilerˉnativeˉx64ˉemitˉframe(Result, false, Frameˉbytes);
    Result = Compilerˉnativeˉx64ˉemitˉrestoreˉfor(Result, Isˉmain);
    Result = Compilerˉnativeˉx64ˉemitˉstatusˉtails(
        Result,
        Frameˉbytes,
        Isˉmain,
        Hasˉdivision,
        Hasˉshift,
        Function.Returnˉtype
    );
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 73u8);
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 255u8);
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 194u8);
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 72u8);
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 184u8);
    Result = Compilerˉnativeˉx64ˉappendˉu32(Result, 0u32);
    Result = Compilerˉnativeˉx64ˉappendˉu32(Result, 3u32);
    if Isˉmain {
        Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 65u8);
        Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 95u8);
    }
    return Bytesˉconcat(
        Bytesˉconcat(Emittedˉprefix, Emittedˉgroup),
        Compilerˉnativeˉx64ˉappendˉbyte(Result, 195u8)
    );
}

export fn Compilerˉnativeˉx64ˉfunctionˉbytes(
    Function: Compilerˉnativeˉx64ˉfunction,
    Analysis: Compilerˉnativeˉx64ˉcontrolˉanalysis,
    Hasˉdivision: bool,
    Hasˉshift: bool,
    Isˉmain: bool
) -> u32 {
    var Divisionˉbytes: u32 = 0u32;
    if Hasˉdivision {
        Divisionˉbytes = 21u32;
        if Isˉmain { Divisionˉbytes = 23u32; }
    }
    var Shiftˉbytes: u32 = 0u32;
    if Hasˉshift {
        Shiftˉbytes = 21u32;
        if Isˉmain { Shiftˉbytes = 23u32; }
    }
    var Wideˉstatusˉbytes: u32 = 0u32;
    if Function.Returnˉtype == 8u8 || Function.Returnˉtype == 9u8 || Function.Returnˉtype == 10u8 {
        Wideˉstatusˉbytes = 14u32;
        if Hasˉdivision { Divisionˉbytes = Divisionˉbytes + 2u32; }
        if Hasˉshift { Shiftˉbytes = Shiftˉbytes + 2u32; }
    }
    let Prologueˉbytes: u32 = Compilerˉnativeˉx64ˉprologueˉbytes(
        Function, Analysis, Isˉmain
    );
    var Exitˉbytes: u32 = 172u32 + Wideˉstatusˉbytes;
    if Isˉmain { Exitˉbytes = 190u32; }
    return Prologueˉbytes + Analysis.Bodyˉbytes + Exitˉbytes +
        Divisionˉbytes + Shiftˉbytes;
}

fn Compilerˉnativeˉx64ˉmeasureˉfunction(
    Input: bytes,
    Section: Compilerˉnativeˉx64ˉsection,
    Function: Compilerˉnativeˉx64ˉfunction,
    Isˉmain: bool,
    Functionˉcount: u32,
    Callˉdirectory: bytes,
    Data: Staticˉdata.Compilerˉnativeˉx64ˉdata,
    Types: Nominalˉtypes.Compilerˉnativeˉx64ˉtypes,
    Capabilityˉtable: Nativeˉcapabilities.Compilerˉnativeˉx64ˉcapabilities
) -> Compilerˉnativeˉx64ˉfunctionˉmeasure {
    let Analysis: Compilerˉnativeˉx64ˉcontrolˉanalysis =
        Compilerˉnativeˉx64ˉanalyzeˉcontrolˉcode(
            Input,
            Section,
            Function,
            Isˉmain,
            Functionˉcount,
            Callˉdirectory,
            Data,
            Types,
            Capabilityˉtable
        );
    if !Analysis.Valid {
        return Compilerˉnativeˉx64ˉfunctionˉmeasure(2147483648u32 + Analysis.Bodyˉbytes, false);
    }
    var Prefixˉbytes: u32 = 0u32;
    if Ownedˉcollections.Minorˉisˉsupported(Bytesˉreadˉu16ˉlittle(Input, 6u32)) {
        if Compilerˉnativeˉx64ˉframeˉslots(Function, Analysis) > 240u32 {
            return Compilerˉnativeˉx64ˉfunctionˉmeasure(2147483648u32, false);
        }
        if Isˉmain { Prefixˉbytes = Ownedˉcollections.Entryˉbytes(); }
    }
    if Function.Sharedˉvalues && Isˉmain { Prefixˉbytes = Sharedˉbytes.Entryˉbytes(); }
    return Compilerˉnativeˉx64ˉfunctionˉmeasure(
        Prefixˉbytes + Compilerˉnativeˉx64ˉfunctionˉbytes(
            Function, Analysis, Analysis.Hasˉdivision, Analysis.Hasˉshift, Isˉmain),
        Bytesˉlength(Analysis.Ownedˉlocals) > 0u32);
}

fn Compilerˉnativeˉx64ˉemitˉfunctionˉartifacts(
    Input: bytes,
    Section: Compilerˉnativeˉx64ˉsection,
    Function: Compilerˉnativeˉx64ˉfunction,
    Isˉmain: bool,
    Functionˉcount: u32,
    Functionˉindex: u32,
    Directory: bytes,
    Data: Staticˉdata.Compilerˉnativeˉx64ˉdata,
    Types: Nominalˉtypes.Compilerˉnativeˉx64ˉtypes,
    Capabilityˉtable: Nativeˉcapabilities.Compilerˉnativeˉx64ˉcapabilities
) -> bytes {
    let Analysis: Compilerˉnativeˉx64ˉcontrolˉanalysis =
        Compilerˉnativeˉx64ˉanalyzeˉcontrolˉcode(
            Input,
            Section,
            Function,
            Isˉmain,
            Functionˉcount,
            Directory,
            Data,
            Types,
            Capabilityˉtable
        );
    if !Analysis.Valid { return Compilerˉnativeˉx64ˉempty(Input); }
    var Codeˉbase: u32 =
        Layout.Compilerˉnativeˉx64ˉlayoutˉmachineˉoffset(
            Directory,
            Functionˉindex
        );
    if Isˉmain && Ownedˉcollections.Minorˉisˉsupported(Bytesˉreadˉu16ˉlittle(Input, 6u32)) {
        Codeˉbase = Codeˉbase + Ownedˉcollections.Entryˉbytes();
    }
    if Isˉmain && Function.Sharedˉvalues { Codeˉbase = Codeˉbase + Sharedˉbytes.Entryˉbytes(); }
    var Relocations: bytes =
        Compilerˉnativeˉx64ˉcollectˉdataˉrelocations(
            Input,
            Section,
            Function,
            Analysis,
            Isˉmain,
            Codeˉbase,
            Directory,
            Types,
            Capabilityˉtable
        );
    var Code: bytes = Compilerˉnativeˉx64ˉemitˉcontrolˉcode(
        Input,
        Section,
        Function,
        Analysis,
        Analysis.Hasˉdivision,
        Analysis.Hasˉshift,
        Isˉmain,
        Codeˉbase,
        Directory,
        Data,
        Types,
        Capabilityˉtable
    );
    if Isˉmain && Ownedˉcollections.Minorˉisˉsupported(Bytesˉreadˉu16ˉlittle(Input, 6u32)) {
        Code = Bytesˉconcat(Ownedˉcollections.Entry(), Code);
    }
    if Isˉmain && Function.Sharedˉvalues {
        let Entry: bytes = Sharedˉbytes.Entry(Function.Returnˉtype);
        if Bytesˉlength(Entry) != Sharedˉbytes.Entryˉbytes() { return Compilerˉnativeˉx64ˉempty(Input); }
        Code = Bytesˉconcat(Entry, Code);
        Relocations = Bytesˉconcat(Relocations, Sharedˉbytes.Entryˉproviderˉrelocations(
            Codeˉbase - Sharedˉbytes.Entryˉbytes()));
    }
    let Header: bytes = Bytesˉconcat(
        Bytesˉconcat(
            Bytesˉfromˉu32ˉlittle(1095128663u32),
            Bytesˉfromˉu32ˉlittle(1u32)
        ),
        Bytesˉconcat(
            Bytesˉfromˉu32ˉlittle(Bytesˉlength(Relocations)),
            Bytesˉfromˉu32ˉlittle(Bytesˉlength(Code))
        )
    );
    return Bytesˉconcat(
        Bytesˉconcat(Header, Relocations),
        Code
    );
}

fn Compilerˉnativeˉx64ˉfunctionˉartifactsˉareˉvalid(
    Artifacts: bytes
) -> bool {
    let Artifactˉbytes: u32 = Bytesˉlength(Artifacts);
    if Artifactˉbytes < 16u32 { return false; }
    if Bytesˉreadˉu32ˉlittle(Artifacts, 0u32) != 1095128663u32 ||
        Bytesˉreadˉu32ˉlittle(Artifacts, 4u32) != 1u32 {
        return false;
    }
    let Relocationˉbytes: u32 = Bytesˉreadˉu32ˉlittle(Artifacts, 8u32);
    let Codeˉbytes: u32 = Bytesˉreadˉu32ˉlittle(Artifacts, 12u32);
    let Payloadˉbytes: u32 = Artifactˉbytes - 16u32;
    if Relocationˉbytes > 524288u32 || Relocationˉbytes % 8u32 != 0u32 {
        return false;
    }
    if Codeˉbytes > 67108864u32 { return false; }
    if Relocationˉbytes > Payloadˉbytes {
        return false;
    }
    return Codeˉbytes == Payloadˉbytes - Relocationˉbytes;
}

fn Compilerˉnativeˉx64ˉcombineˉfunctionˉartifacts(
    Input: bytes,
    Left: bytes,
    Right: bytes
) -> bytes {
    if !Compilerˉnativeˉx64ˉfunctionˉartifactsˉareˉvalid(Left) ||
        !Compilerˉnativeˉx64ˉfunctionˉartifactsˉareˉvalid(Right) {
        return Compilerˉnativeˉx64ˉempty(Input);
    }
    let Leftˉrelocationˉbytes: u32 =
        Bytesˉreadˉu32ˉlittle(Left, 8u32);
    let Rightˉrelocationˉbytes: u32 =
        Bytesˉreadˉu32ˉlittle(Right, 8u32);
    if Leftˉrelocationˉbytes > 524288u32 ||
        Rightˉrelocationˉbytes > 524288u32 - Leftˉrelocationˉbytes {
        return Compilerˉnativeˉx64ˉempty(Input);
    }
    let Leftˉcodeˉbytes: u32 = Bytesˉreadˉu32ˉlittle(Left, 12u32);
    let Rightˉcodeˉbytes: u32 = Bytesˉreadˉu32ˉlittle(Right, 12u32);
    if Leftˉcodeˉbytes > 67108864u32 ||
        Rightˉcodeˉbytes > 67108864u32 - Leftˉcodeˉbytes {
        return Compilerˉnativeˉx64ˉempty(Input);
    }
    let Relocationˉbytes: u32 =
        Leftˉrelocationˉbytes + Rightˉrelocationˉbytes;
    let Codeˉbytes: u32 = Leftˉcodeˉbytes + Rightˉcodeˉbytes;
    let Relocations: bytes = Bytesˉconcat(
        Bytesˉslice(Left, 16u32, Leftˉrelocationˉbytes),
        Bytesˉslice(Right, 16u32, Rightˉrelocationˉbytes)
    );
    let Code: bytes = Bytesˉconcat(
        Bytesˉslice(
            Left,
            16u32 + Leftˉrelocationˉbytes,
            Leftˉcodeˉbytes
        ),
        Bytesˉslice(
            Right,
            16u32 + Rightˉrelocationˉbytes,
            Rightˉcodeˉbytes
        )
    );
    let Header: bytes = Bytesˉconcat(
        Bytesˉconcat(
            Bytesˉfromˉu32ˉlittle(1095128663u32),
            Bytesˉfromˉu32ˉlittle(1u32)
        ),
        Bytesˉconcat(
            Bytesˉfromˉu32ˉlittle(Relocationˉbytes),
            Bytesˉfromˉu32ˉlittle(Codeˉbytes)
        )
    );
    return Bytesˉconcat(Bytesˉconcat(Header, Relocations), Code);
}

fn Compilerˉnativeˉx64ˉfunctionˉcursorˉafter(
    Input: bytes,
    Functionˉcursor: u32,
    Functionsˉlimit: u32,
    Firstˉfunction: u32,
    Count: u32,
    Mainˉfunction: u32,
    Types: Nominalˉtypes.Compilerˉnativeˉx64ˉtypes
) -> u32 {
    var Cursor: u32 = Functionˉcursor;
    var Offset: u32 = 0u32;
    while Offset < Count {
        let Function: Compilerˉnativeˉx64ˉfunction =
            Compilerˉnativeˉx64ˉreadˉfunctionˉat(
                Input,
                Cursor,
                Functionsˉlimit,
                Firstˉfunction + Offset == Mainˉfunction,
                Types
            );
        if !Function.Valid { return 4294967295u32; }
        Cursor = Function.Nextˉoffset;
        Offset = Offset + 1u32;
    }
    return Cursor;
}

fn Compilerˉnativeˉx64ˉemitˉfunctionˉrange(
    Input: bytes,
    Codeˉoffset: u32,
    Functionˉcursor: u32,
    Functionsˉlimit: u32,
    Firstˉfunction: u32,
    Count: u32,
    Mainˉfunction: u32,
    Functionˉcount: u32,
    Directory: bytes,
    Signatureˉcursors: bytes,
    Borrowˉroots: bytes,
    Borrowˉdirectory: Sharedˉlocalˉliveness.Directory,
    Data: Staticˉdata.Compilerˉnativeˉx64ˉdata,
    Types: Nominalˉtypes.Compilerˉnativeˉx64ˉtypes,
    Capabilityˉtable: Nativeˉcapabilities.Compilerˉnativeˉx64ˉcapabilities
) -> bytes {
    if Count == 0u32 { return Compilerˉnativeˉx64ˉempty(Input); }
    if Count == 1u32 {
        let Isˉmain: bool = Firstˉfunction == Mainˉfunction;
        let Function: Compilerˉnativeˉx64ˉfunction =
            Compilerˉnativeˉx64ˉreadˉfunctionˉat(
                Input,
                Functionˉcursor,
                Functionsˉlimit,
                Isˉmain,
                Types
            );
        if !Function.Valid { return Compilerˉnativeˉx64ˉempty(Input); }
        let Codeˉsection: Compilerˉnativeˉx64ˉsection =
            Compilerˉnativeˉx64ˉsection(
                true,
                Codeˉoffset + Function.Codeˉoffset,
                Function.Codeˉlength,
                0u32
            );
        let Artifacts: bytes = Compilerˉnativeˉx64ˉemitˉfunctionˉartifacts(
            Input,
            Codeˉsection,
            Compilerˉnativeˉx64ˉfunctionˉwithˉsignatures(Function,
                Signatureˉcursors, Functionsˉlimit, Mainˉfunction, Borrowˉroots, Borrowˉdirectory, Firstˉfunction),
            Isˉmain,
            Functionˉcount,
            Firstˉfunction,
            Directory,
            Data,
            Types,
            Capabilityˉtable
        );
        if !Compilerˉnativeˉx64ˉfunctionˉartifactsˉareˉvalid(Artifacts) {
            return Compilerˉnativeˉx64ˉempty(Input);
        }
        if Bytesˉreadˉu32ˉlittle(Artifacts, 12u32) !=
            Layout.Compilerˉnativeˉx64ˉlayoutˉmachineˉlength(
                Directory,
                Firstˉfunction
            ) {
            return Compilerˉnativeˉx64ˉempty(Input);
        }
        return Artifacts;
    }

    let Leftˉcount: u32 = Count / 2u32;
    let Middleˉcursor: u32 = Compilerˉnativeˉx64ˉfunctionˉcursorˉafter(
        Input,
        Functionˉcursor,
        Functionsˉlimit,
        Firstˉfunction,
        Leftˉcount,
        Mainˉfunction,
        Types
    );
    if Middleˉcursor == 4294967295u32 {
        return Compilerˉnativeˉx64ˉempty(Input);
    }
    let Left: bytes = Compilerˉnativeˉx64ˉemitˉfunctionˉrange(
        Input,
        Codeˉoffset,
        Functionˉcursor,
        Functionsˉlimit,
        Firstˉfunction,
        Leftˉcount,
        Mainˉfunction,
        Functionˉcount,
        Directory,
        Signatureˉcursors,
        Borrowˉroots,
        Borrowˉdirectory,
        Data,
        Types,
        Capabilityˉtable
    );
    if Bytesˉlength(Left) == 0u32 {
        return Compilerˉnativeˉx64ˉempty(Input);
    }
    let Right: bytes = Compilerˉnativeˉx64ˉemitˉfunctionˉrange(
        Input,
        Codeˉoffset,
        Middleˉcursor,
        Functionsˉlimit,
        Firstˉfunction + Leftˉcount,
        Count - Leftˉcount,
        Mainˉfunction,
        Functionˉcount,
        Directory,
        Signatureˉcursors,
        Borrowˉroots,
        Borrowˉdirectory,
        Data,
        Types,
        Capabilityˉtable
    );
    return Compilerˉnativeˉx64ˉcombineˉfunctionˉartifacts(
        Input,
        Left,
        Right
    );
}

export fn Compilerˉnativeˉx64ˉcompareˉplannedˉemission(
    Input: bytes,
    Plan: Compilerˉnativeˉx64ˉplan
) -> Compilerˉnativeˉx64ˉemissionˉcomparison {
    if Plan.Status != Compilerˉnativeˉx64ˉstatus.Valid ||
        Plan.Functionˉcount == 0u32 ||
        Bytesˉlength(Plan.Functionˉcursors) < 4u32 {
        return Compilerˉnativeˉx64ˉemissionˉcomparison(
            false,
            4294967295u32,
            Plan.Machineˉcodeˉbytes,
            0u32,
            Plan.Relocationˉbytes,
            0u32
        );
    }
    let Diagnosticˉdata: Staticˉdata.Compilerˉnativeˉx64ˉdata =
        Compilerˉnativeˉx64ˉplanˉdata(Plan);
    let Diagnosticˉtypes: Nominalˉtypes.Compilerˉnativeˉx64ˉtypes =
        Compilerˉnativeˉx64ˉplanˉtypes(Plan);
    let Diagnosticˉcapabilities:
        Nativeˉcapabilities.Compilerˉnativeˉx64ˉcapabilities =
        Compilerˉnativeˉx64ˉplanˉcapabilities(Plan);
    var Diagnosticˉfunction: u32 = 0u32;
    while Diagnosticˉfunction < Plan.Functionˉcount {
        let Diagnosticˉdefinition: Compilerˉnativeˉx64ˉfunction =
            Compilerˉnativeˉx64ˉreadˉfunctionˉat(
                Input,
                Bytesˉreadˉu32ˉlittle(
                    Plan.Functionˉcursors,
                    Diagnosticˉfunction * 4u32
                ),
                Plan.Functionsˉlimit,
                Diagnosticˉfunction == Plan.Mainˉfunction,
                Diagnosticˉtypes
            );
        if !Diagnosticˉdefinition.Valid {
            return Compilerˉnativeˉx64ˉemissionˉcomparison(
                false,
                Diagnosticˉfunction,
                0u32,
                0u32,
                0u32,
                0u32
            );
        }
        let Diagnosticˉartifacts: bytes =
            Compilerˉnativeˉx64ˉemitˉfunctionˉartifacts(
                Input,
                Compilerˉnativeˉx64ˉsection(
                    true,
                    Plan.Codeˉoffset + Diagnosticˉdefinition.Codeˉoffset,
                    Diagnosticˉdefinition.Codeˉlength,
                    0u32
                ),
                Compilerˉnativeˉx64ˉfunctionˉwithˉsignatures(Diagnosticˉdefinition,
                    Plan.Functionˉcursors, Plan.Functionsˉlimit, Plan.Mainˉfunction,
                    Plan.Borrowˉroots, Plan.Borrowˉdirectory, Diagnosticˉfunction),
                Diagnosticˉfunction == Plan.Mainˉfunction,
                Plan.Functionˉcount,
                Diagnosticˉfunction,
                Plan.Directory,
                Diagnosticˉdata,
                Diagnosticˉtypes,
                Diagnosticˉcapabilities
            );
        let Diagnosticˉexpectedˉcode: u32 =
            Layout.Compilerˉnativeˉx64ˉlayoutˉmachineˉlength(
                Plan.Directory,
                Diagnosticˉfunction
            );
        let Diagnosticˉexpectedˉrelocations: u32 = Bytesˉreadˉu32ˉlittle(
            Plan.Relocationˉlengths,
            Diagnosticˉfunction * 4u32
        );
        if !Compilerˉnativeˉx64ˉfunctionˉartifactsˉareˉvalid(
            Diagnosticˉartifacts
        ) {
            return Compilerˉnativeˉx64ˉemissionˉcomparison(
                false,
                Diagnosticˉfunction,
                Diagnosticˉexpectedˉcode,
                0u32,
                Diagnosticˉexpectedˉrelocations,
                0u32
            );
        }
        let Diagnosticˉactualˉcode: u32 = Bytesˉreadˉu32ˉlittle(
            Diagnosticˉartifacts,
            12u32
        );
        let Diagnosticˉactualˉrelocations: u32 = Bytesˉreadˉu32ˉlittle(
            Diagnosticˉartifacts,
            8u32
        );
        if Diagnosticˉexpectedˉcode != Diagnosticˉactualˉcode ||
            Diagnosticˉexpectedˉrelocations !=
                Diagnosticˉactualˉrelocations {
            return Compilerˉnativeˉx64ˉemissionˉcomparison(
                true,
                Diagnosticˉfunction,
                Diagnosticˉexpectedˉcode,
                Diagnosticˉactualˉcode,
                Diagnosticˉexpectedˉrelocations,
                Diagnosticˉactualˉrelocations
            );
        }
        Diagnosticˉfunction = Diagnosticˉfunction + 1u32;
    }
    return Compilerˉnativeˉx64ˉemissionˉcomparison(
        true,
        4294967295u32,
        Plan.Machineˉcodeˉbytes,
        Plan.Machineˉcodeˉbytes,
        Plan.Relocationˉbytes,
        Plan.Relocationˉbytes
    );
}

fn Compilerˉnativeˉx64ˉborrowedˉparameterˉisˉset(
    Masks: bytes,
    Function: u32,
    Parameter: u32
) -> bool {
    if Parameter >= 64u32 ||
        Function >= Bytesˉlength(Masks) / 8u32 {
        return false;
    }
    let Word: u32 = Parameter / 32u32;
    let Shift: u32 = Parameter % 32u32;
    return ((Bytesˉreadˉu32ˉlittle(
        Masks, Function * 8u32 + Word * 4u32
    ) >> Shift) & 1u32) == 1u32;
}

fn Compilerˉnativeˉx64ˉborrowedˉcallˉfollows(
    Input: bytes,
    Codeˉoffset: u32,
    Codeˉlength: u32,
    Start: u32,
    Parameterˉcounts: bytes,
    Borrowedˉparameterˉmasks: bytes
) -> bool {
    var Cursor: u32 = Start;
    var Trailingˉloads: u32 = 0u32;
    while Cursor < Codeˉlength {
        if Trailingˉloads > 64u32 { return false; }
        let Opcode: u8 = Bytesˉreadˉu8(Input, Codeˉoffset + Cursor);
        if Opcode == 64u8 {
            if 5u32 > Codeˉlength - Cursor { return false; }
            let Target: u32 = Bytesˉreadˉu32ˉlittle(
                Input, Codeˉoffset + Cursor + 1u32
            );
            if Target >= Bytesˉlength(Parameterˉcounts) ||
                Target >= Bytesˉlength(Borrowedˉparameterˉmasks) / 8u32 {
                return false;
            }
            let Parameters: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(
                Parameterˉcounts, Target
            ));
            if Trailingˉloads >= Parameters { return false; }
            return Compilerˉnativeˉx64ˉborrowedˉparameterˉisˉset(
                Borrowedˉparameterˉmasks,
                Target,
                Parameters - Trailingˉloads - 1u32
            );
        }
        if Opcode != 4u8 || 5u32 > Codeˉlength - Cursor {
            return false;
        }
        Cursor = Cursor + 5u32;
        Trailingˉloads = Trailingˉloads + 1u32;
    }
    return false;
}

fn Compilerˉnativeˉx64ˉborrowedˉusesˉareˉvalid(
    Input: bytes,
    Codeˉoffset: u32,
    Function: Compilerˉnativeˉx64ˉfunction,
    Parameterˉcounts: bytes,
    Borrowedˉparameterˉmasks: bytes
) -> bool {
    if Bytesˉlength(Function.Localˉtypes) != Function.Locals ||
        Bytesˉlength(Function.Localˉtypeˉidentities) !=
            Function.Locals * 4u32 ||
        Bytesˉlength(Function.Localˉborrowˉkinds) != Function.Locals {
        return false;
    }
    var Cursor: u32 = 0u32;
    var Previous: u32 = Function.Codeˉlength;
    while Cursor < Function.Codeˉlength {
        let Opcode: u8 = Bytesˉreadˉu8(Input, Codeˉoffset + Cursor);
        let Size: u32 = Compilerˉnativeˉx64ˉinstructionˉsize(Opcode);
        if Size == 0u32 || Size > Function.Codeˉlength - Cursor {
            return false;
        }
        if Opcode == 4u8 || Opcode == 5u8 || Opcode == 205u8 {
            let Local: u32 = Bytesˉreadˉu32ˉlittle(
                Input, Codeˉoffset + Cursor + 1u32
            );
            if Local >= Function.Locals { return false; }
            let Identity: u32 = Bytesˉreadˉu32ˉlittle(
                Function.Localˉtypeˉidentities, Local * 4u32
            );
            let Borrowˉkind: u8 = Bytesˉreadˉu8(
                Function.Localˉborrowˉkinds, Local
            );
            if Borrowˉkind == 36u8 || Borrowˉkind == 28u8 {
                if Opcode == 205u8 || Local < Function.Parameters ||
                    Previous >= Function.Codeˉlength {
                    return false;
                }
                let Previousˉopcode: u8 = Bytesˉreadˉu8(
                    Input, Codeˉoffset + Previous
                );
                let Previousˉlocal: u32 = Bytesˉreadˉu32ˉlittle(
                    Input, Codeˉoffset + Previous + 1u32
                );
                if Opcode == 5u8 {
                    if Previousˉopcode != 4u8 ||
                        Previousˉlocal >= Function.Locals || Bytesˉreadˉu8(
                            Function.Localˉborrowˉkinds,
                            Previousˉlocal
                        ) != 0u8 {
                        return false;
                    }
                    let Previousˉidentity: u32 = Bytesˉreadˉu32ˉlittle(
                        Function.Localˉtypeˉidentities,
                        Previousˉlocal * 4u32
                    );
                    if (Borrowˉkind == 36u8 &&
                            Previousˉidentity != 25u32) ||
                        (Borrowˉkind == 28u8 &&
                            Previousˉidentity != Identity) {
                        return false;
                    }
                } else {
                    if Previousˉopcode != 5u8 || Previousˉlocal != Local ||
                        !Compilerˉnativeˉx64ˉborrowedˉcallˉfollows(
                            Input,
                            Codeˉoffset,
                            Function.Codeˉlength,
                            Cursor + Size,
                            Parameterˉcounts,
                            Borrowedˉparameterˉmasks
                        ) {
                        return false;
                    }
                }
            }
        }
        Previous = Cursor;
        Cursor = Cursor + Size;
    }
    return Cursor == Function.Codeˉlength;
}

export fn Compilerˉnativeˉx64ˉplanˉbuild(
    Input: borrow bytes,
    Budget: borrow mut Foundationˉmemory.Memoryˉbudget
) -> Compilerˉnativeˉx64ˉplan effects(memory.allocate) {
    let Structure: Compilerˉnativeˉx64ˉstructure = Compilerˉnativeˉx64ˉreadˉstructure(Input);
    if !Structure.Valid || Structure.Functionsˉlength < 4u32 {
        return Compilerˉnativeˉx64ˉplanˉfailure(Input, Compilerˉnativeˉx64ˉstatus.Invalidˉwvb);
    }
    let Functions: u32 = Bytesˉreadˉu32ˉlittle(Input, Structure.Functionsˉoffset);
    if Functions == 0u32 {
        return Compilerˉnativeˉx64ˉplanˉfailure(Input, Compilerˉnativeˉx64ˉstatus.Unsupportedˉfunction);
    }
    if Functions > Layout.Compilerˉnativeˉx64ˉlayoutˉfunctionˉlimit() {
        return Compilerˉnativeˉx64ˉplanˉfunctionˉfailure(Input,
            Compilerˉnativeˉx64ˉstatus.Unsupportedˉfunction, 4294967295u32, Functions);
    }
    let Maximum: u64 = U64ˉfromˉu32(Functions * Layout.Compilerˉnativeˉx64ˉlayoutˉentryˉbytes());
    let Charge: u64 = ((Maximum + 31u64) / 16u64) * 16u64;
    let Signatureˉbudget = Foundationˉmemory.Split(borrow mut Budget, Charge, 0u32);
    return match Signatureˉbudget {
        case Foundationˉresults.Result.Valid { Value: Child } {
            let Signatureˉcreated = Foundationˉbytes.Constructˉreserved(Child, Maximum);
            match Signatureˉcreated {
                case Foundationˉresults.Result.Valid { Value: Signatures } {
                    let Directoryˉbudget = Foundationˉmemory.Split(borrow mut Budget, Charge, 0u32);
                    match Directoryˉbudget {
                        case Foundationˉresults.Result.Valid { Value: Directoryˉchild } {
                            let Directoryˉcreated = Foundationˉbytes.Constructˉreserved(Directoryˉchild, Maximum);
                            match Directoryˉcreated {
                                case Foundationˉresults.Result.Valid { Value: Directory } {
                                    Compilerˉnativeˉx64ˉplanˉbuildˉdirectories(Input, Signatures, Directory)
                                }
                                case Foundationˉresults.Result.Failure { Error: _ } {
                                    Compilerˉnativeˉx64ˉplanˉfailure(Input, Compilerˉnativeˉx64ˉstatus.Outputˉlimit)
                                }
                            }
                        }
                        case Foundationˉresults.Result.Failure { Error: _ } {
                            Compilerˉnativeˉx64ˉplanˉfailure(Input, Compilerˉnativeˉx64ˉstatus.Outputˉlimit)
                        }
                    }
                }
                case Foundationˉresults.Result.Failure { Error: _ } {
                    Compilerˉnativeˉx64ˉplanˉfailure(Input, Compilerˉnativeˉx64ˉstatus.Outputˉlimit)
                }
            }
        }
        case Foundationˉresults.Result.Failure { Error: _ } {
            Compilerˉnativeˉx64ˉplanˉfailure(Input, Compilerˉnativeˉx64ˉstatus.Outputˉlimit)
        }
    };
}

fn Compilerˉnativeˉx64ˉplanˉbuildˉdirectories(
    Input: borrow bytes,
    Initialˉsignatures: Foundationˉbytes.Bytesˉbuilder,
    Initialˉdirectory: Foundationˉbytes.Bytesˉbuilder
) -> Compilerˉnativeˉx64ˉplan {
    var Signatureˉbuilder: Foundationˉbytes.Bytesˉbuilder = Initialˉsignatures;
    var Directoryˉbuilder: Foundationˉbytes.Bytesˉbuilder = Initialˉdirectory;
    let Context: Compilerˉnativeˉx64ˉplanˉinputs = Compilerˉnativeˉx64ˉplanˉinputsˉread(Input);
    if Context.Status != Compilerˉnativeˉx64ˉstatus.Valid {
        return Compilerˉnativeˉx64ˉplanˉfunctionˉfailure(
            Input, Context.Status, Context.Failureˉfunction, Context.Failureˉdetail);
    }
    let Table: Compilerˉnativeˉx64ˉsignatureˉtable = Compilerˉnativeˉx64ˉsignatureˉtableˉbuild(
        Input, Context, Signatureˉbuilder);
    if Table.Status != Compilerˉnativeˉx64ˉstatus.Valid {
        return Compilerˉnativeˉx64ˉplanˉfunctionˉfailure(
            Input, Table.Status, Table.Failureˉfunction, Table.Failureˉdetail);
    }
    return Compilerˉnativeˉx64ˉmachineˉdirectoryˉbuild(Input, Context, Table, Directoryˉbuilder);
}

fn Compilerˉnativeˉx64ˉplanˉinputsˉfailure(
    Input: bytes, Status: Compilerˉnativeˉx64ˉstatus, Function: u32, Detail: u32
) -> Compilerˉnativeˉx64ˉplanˉinputs {
    let Empty: bytes = Compilerˉnativeˉx64ˉempty(Input);
    return Compilerˉnativeˉx64ˉplanˉinputs(
        Status, Function, Detail,
        Compilerˉnativeˉx64ˉstructure(false, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32),
        Staticˉdata.Compilerˉnativeˉx64ˉdata(false, 0u32, Empty, Empty, Empty, Empty, Empty),
        Nominalˉtypes.Compilerˉnativeˉx64ˉtypes(false, 0u32, Empty, Empty, Empty, Empty, Empty),
        Nativeˉcapabilities.Compilerˉnativeˉx64ˉcapabilities(false, 0u32, Empty),
        0u32, Compilerˉnativeˉx64ˉsection(false, 0u32, 0u32, 0u32), 0u32, 0u32, 0u32,
        Empty, Empty, Sharedˉlocalˉliveness.Directory(false, Empty, Empty, Empty, 0u32)
    );
}

fn Compilerˉnativeˉx64ˉplanˉinputsˉread(Input: borrow bytes)
    -> Compilerˉnativeˉx64ˉplanˉinputs {
    if Bytesˉlength(Input) >= 12u32 &&
        Ownedˉcollections.Minorˉisˉsupported(Bytesˉreadˉu16ˉlittle(Input, 6u32)) && Bytesˉlength(Input) > 1048576u32 {
        return Compilerˉnativeˉx64ˉplanˉinputsˉfailure(Input, Compilerˉnativeˉx64ˉstatus.Invalidˉwvb, 4294967295u32, 4294967295u32);
    }
    // Candidate borrowing requires the shared typed-stack and lifetime proof,
    // including when callers bypass the command-line tool. Native target
    // admission below remains a separate, stricter boundary.
    if Bytesˉlength(Input) >= 12u32 &&
        (Bytesˉreadˉu16ˉlittle(Input, 6u32) == 39u32 ||
            Nominalˉtypes.Compilerˉnativeˉx64ˉsharedˉminor(Bytesˉreadˉu16ˉlittle(Input, 6u32)) ||
            Ownedˉcollections.Minorˉisˉsupported(Bytesˉreadˉu16ˉlittle(Input, 6u32))) {
        if Completeˉverifier.Compilerˉwvbˉverifyˉmetadata(Input) != 0u32 {
            return Compilerˉnativeˉx64ˉplanˉinputsˉfailure(
                Input, Compilerˉnativeˉx64ˉstatus.Invalidˉwvb,
    4294967295u32, 4294967295u32
);
        }
    }
    let Structure: Compilerˉnativeˉx64ˉstructure =
        Compilerˉnativeˉx64ˉreadˉstructure(Input);
    if !Structure.Valid {
        return Compilerˉnativeˉx64ˉplanˉinputsˉfailure(
            Input,
            Compilerˉnativeˉx64ˉstatus.Invalidˉwvb,
            4294967295u32, 4294967295u32
        );
    }
    let Module: Compilerˉnativeˉx64ˉsection = Compilerˉnativeˉx64ˉsection(
        true,
        Structure.Moduleˉoffset,
        Structure.Moduleˉlength,
        0u32
    );
    if !Compilerˉnativeˉx64ˉmoduleˉisˉvalid(
        Input,
        Module,
        Bytesˉreadˉu16ˉlittle(Input, 6u32)
    ) {
        return Compilerˉnativeˉx64ˉplanˉinputsˉfailure(
            Input,
            Compilerˉnativeˉx64ˉstatus.Invalidˉwvb,
            4294967295u32, 4294967295u32
        );
    }
    let Profile: u8 = Bytesˉreadˉu8(Input, Structure.Moduleˉoffset);
    let Minor: u32 = Bytesˉreadˉu16ˉlittle(Input, 6u32);
    var Borrowˉroots: bytes = Compilerˉnativeˉx64ˉempty(Input);
    var Evidenceˉsource: bytes = Compilerˉnativeˉx64ˉempty(Input);
    var Borrowˉdirectory: Sharedˉlocalˉliveness.Directory = Sharedˉlocalˉliveness.Directory(false,
        Evidenceˉsource, Evidenceˉsource, Evidenceˉsource, 0u32);
    if Nominalˉtypes.Compilerˉnativeˉx64ˉsharedˉminor(Minor) {
        let Evidence: Executableˉverifier.Hˉborrowˉrootˉevidence = Executableˉverifier.Hˉborrowˉroots(Input);
        if !Evidence.Valid || Evidence.Generation != 1u32 || !Sharedˉbytes.Bytesˉareˉequal(Evidence.Source, Input) {
            return Compilerˉnativeˉx64ˉplanˉinputsˉfailure(Input, Compilerˉnativeˉx64ˉstatus.Invalidˉwvb, 4294967295u32, 4294967295u32);
        }
        Borrowˉroots = Evidence.Directory;
        Evidenceˉsource = Evidence.Source;
        Borrowˉdirectory = Sharedˉlocalˉliveness.Directoryˉindex(Input, Borrowˉroots);
        if !Borrowˉdirectory.Valid {
            return Compilerˉnativeˉx64ˉplanˉinputsˉfailure(Input, Compilerˉnativeˉx64ˉstatus.Invalidˉwvb, 4294967295u32, 4294967295u32);
        }
    }
    if Nominalˉtypes.Compilerˉnativeˉx64ˉsharedˉminor(Minor) && Profile != 1u8 {
        return Compilerˉnativeˉx64ˉplanˉinputsˉfailure(Input, Compilerˉnativeˉx64ˉstatus.Unsupportedˉprofile, 4294967295u32, 4294967295u32);
    }
    if Profile != 1u8 && Profile != 2u8 &&
        !(Profile == 3u8 && (Minor == 33u32 || Minor == 34u32 ||
            Minor == 35u32 || Minor == 36u32 || Minor == 37u32 ||
            Minor == 38u32)) {
        return Compilerˉnativeˉx64ˉplanˉinputsˉfailure(
            Input,
            Compilerˉnativeˉx64ˉstatus.Unsupportedˉprofile,
            4294967295u32, 4294967295u32
        );
    }
    let Capabilityˉtable: Nativeˉcapabilities.Compilerˉnativeˉx64ˉcapabilities =
        Nativeˉcapabilities.Compilerˉnativeˉx64ˉcapabilitiesˉread(
            Input,
            Structure.Capabilitiesˉoffset,
            Structure.Capabilitiesˉlength
        );
    if !Capabilityˉtable.Valid {
        return Compilerˉnativeˉx64ˉplanˉinputsˉfailure(
            Input,
            Compilerˉnativeˉx64ˉstatus.Unsupportedˉmodule,
            4294967295u32,
            100u32
        );
    }
    if Profile == 1u8 && Capabilityˉtable.Count != 0u32 {
        return Compilerˉnativeˉx64ˉplanˉinputsˉfailure(
            Input,
            Compilerˉnativeˉx64ˉstatus.Unsupportedˉmodule,
            4294967295u32,
            101u32
        );
    }
    if Profile == 2u8 && Capabilityˉtable.Count == 0u32 {
        return Compilerˉnativeˉx64ˉplanˉinputsˉfailure(
            Input,
            Compilerˉnativeˉx64ˉstatus.Unsupportedˉmodule,
            4294967295u32,
            102u32
        );
    }
    if Profile == 3u8 && Capabilityˉtable.Count != 0u32 {
        return Compilerˉnativeˉx64ˉplanˉinputsˉfailure(
            Input,
            Compilerˉnativeˉx64ˉstatus.Unsupportedˉmodule,
            4294967295u32,
            103u32
        );
    }
    let Data: Staticˉdata.Compilerˉnativeˉx64ˉdata =
        Staticˉdata.Compilerˉnativeˉx64ˉdataˉread(
            Input,
            Structure.Dataˉoffset,
            Structure.Dataˉlength
        );
    if !Data.Valid {
        return Compilerˉnativeˉx64ˉplanˉinputsˉfailure(
            Input,
            Compilerˉnativeˉx64ˉstatus.Unsupportedˉmodule,
            4294967295u32,
            104u32
        );
    }
    if Nominalˉtypes.Compilerˉnativeˉx64ˉsharedˉminor(Minor) && (Data.Count > 512u32 || Bytesˉlength(Data.Bytes) > 4194304u32) {
        return Compilerˉnativeˉx64ˉplanˉinputsˉfailure(Input, Compilerˉnativeˉx64ˉstatus.Outputˉlimit, 4294967295u32, 4294967295u32);
    }
    var Types: Nominalˉtypes.Compilerˉnativeˉx64ˉtypes =
        Nominalˉtypes.Compilerˉnativeˉx64ˉhostedˉtypesˉread(
            Input,
            Structure.Typesˉoffset,
            Structure.Typesˉlength
        );
    if !Types.Valid {
        return Compilerˉnativeˉx64ˉplanˉinputsˉfailure(
            Input,
            Compilerˉnativeˉx64ˉstatus.Unsupportedˉmodule,
            4294967295u32,
            105u32
        );
    }
    if Nominalˉtypes.Compilerˉnativeˉx64ˉsharedˉminor(Minor) {
        Types = Sharedˉaggregates.Prepare(Input, Types);
    }
    if !Compilerˉnativeˉx64ˉcallableˉversionˉisˉvalid(
        Input,
        Structure.Codeˉoffset,
        Structure.Codeˉlength,
        Minor,
        Profile,
        Types
    ) {
        return Compilerˉnativeˉx64ˉplanˉinputsˉfailure(
            Input,
            Compilerˉnativeˉx64ˉstatus.Unsupportedˉmodule,
            4294967295u32,
            106u32
        );
    }

    let Functions: Compilerˉnativeˉx64ˉsection = Compilerˉnativeˉx64ˉsection(
        true,
        Structure.Functionsˉoffset,
        Structure.Functionsˉlength,
        0u32
    );
    if Functions.Payloadˉlength < 4u32 {
        return Compilerˉnativeˉx64ˉplanˉinputsˉfailure(
            Input,
            Compilerˉnativeˉx64ˉstatus.Unsupportedˉfunction,
            4294967295u32, 4294967295u32
        );
    }
    let Functionˉcount: u32 = Bytesˉreadˉu32ˉlittle(
        Input,
        Functions.Payloadˉoffset
    );
    if Ownedˉcollections.Minorˉisˉsupported(Minor) && (Functionˉcount > 64u32 || Profile != 1u8 || Data.Count != 0u32 ||
        !Ownedˉcollections.Typesˉareˉsupported(Input, Types)) {
        return Compilerˉnativeˉx64ˉplanˉinputsˉfailure(Input, Compilerˉnativeˉx64ˉstatus.Unsupportedˉmodule, 4294967295u32, 4294967295u32);
    }
    if Functionˉcount == 0u32 {
        return Compilerˉnativeˉx64ˉplanˉinputsˉfailure(
            Input,
            Compilerˉnativeˉx64ˉstatus.Unsupportedˉfunction,
            4294967295u32, 4294967295u32
        );
    }
    if Functionˉcount > Layout.Compilerˉnativeˉx64ˉlayoutˉfunctionˉlimit() {
        return Compilerˉnativeˉx64ˉplanˉinputsˉfailure(
            Input,
            Compilerˉnativeˉx64ˉstatus.Unsupportedˉfunction,
            4294967295u32,
            Functionˉcount
        );
    }
    let Functionsˉlimit: u32 =
        Functions.Payloadˉoffset + Functions.Payloadˉlength;
    let Exports: Compilerˉnativeˉx64ˉsection = Compilerˉnativeˉx64ˉsection(
        true,
        Structure.Exportsˉoffset,
        Structure.Exportsˉlength,
        0u32
    );
    if Exports.Payloadˉlength != 17u32 {
        return Compilerˉnativeˉx64ˉplanˉinputsˉfailure(
            Input,
            Compilerˉnativeˉx64ˉstatus.Unsupportedˉfunction,
            4294967295u32, 4294967295u32
        );
    }
    let Mainˉfunction: u32 = Bytesˉreadˉu32ˉlittle(
        Input,
        Exports.Payloadˉoffset + 13u32
    );
    if Mainˉfunction >= Functionˉcount {
        return Compilerˉnativeˉx64ˉplanˉinputsˉfailure(
            Input,
            Compilerˉnativeˉx64ˉstatus.Unsupportedˉfunction,
            4294967295u32, 4294967295u32
        );
    }
    if !Compilerˉnativeˉx64ˉexportˉisˉsupported(
        Input,
        Exports,
        Mainˉfunction
    ) {
        return Compilerˉnativeˉx64ˉplanˉinputsˉfailure(
            Input,
            Compilerˉnativeˉx64ˉstatus.Unsupportedˉfunction,
            4294967295u32, 4294967295u32
        );
    }

    return Compilerˉnativeˉx64ˉplanˉinputs(
        Compilerˉnativeˉx64ˉstatus.Valid, 4294967295u32, 4294967295u32,
        Structure, Data, Types, Capabilityˉtable, Minor, Functions, Functionsˉlimit,
        Functionˉcount, Mainˉfunction, Evidenceˉsource, Borrowˉroots, Borrowˉdirectory
    );
}

fn Compilerˉnativeˉx64ˉsignatureˉmetadataˉcheck(
    Function: Compilerˉnativeˉx64ˉfunction, Isˉmain: bool, Minor: u32,
    Codeˉlength: u32, Expectedˉwvbˉcodeˉoffset: u32, Header: bool
) -> Compilerˉnativeˉx64ˉsignatureˉcheck {
    if Header {
        if !Function.Valid {
            return Compilerˉnativeˉx64ˉsignatureˉcheck(false, 200u32);
        }
        if Ownedˉcollections.Minorˉisˉsupported(Minor) && ((Isˉmain && (Function.Parameters != 1u32 || Function.Returnˉtype != 1u8)) ||
            Function.Locals > 128u32 || Function.Codeˉlength > 4096u32) {
            return Compilerˉnativeˉx64ˉsignatureˉcheck(false, 4294967295u32);
        }
        if Isˉmain && !Ownedˉcollections.Minorˉisˉsupported(Minor) && Minor != 33u32 && Minor != 34u32 &&
            Minor != 35u32 && Minor != 36u32 && Minor != 37u32 &&
            Minor != 38u32 && Minor != 39u32 && !Nominalˉtypes.Compilerˉnativeˉx64ˉsharedˉminor(Minor) &&
            Function.Parameters != 0u32 {
            return Compilerˉnativeˉx64ˉsignatureˉcheck(false, 201u32);
        }
    } else {
        if Function.Codeˉoffset != Expectedˉwvbˉcodeˉoffset {
            return Compilerˉnativeˉx64ˉsignatureˉcheck(false, 202u32);
        }
        if Function.Codeˉoffset > Codeˉlength {
            return Compilerˉnativeˉx64ˉsignatureˉcheck(false, 203u32);
        }
        if Function.Codeˉlength >
            Codeˉlength - Function.Codeˉoffset {
            return Compilerˉnativeˉx64ˉsignatureˉcheck(false, 204u32);
        }
    }
    return Compilerˉnativeˉx64ˉsignatureˉcheck(true, 0u32);
}

fn Compilerˉnativeˉx64ˉsignatureˉtableˉfailure(
    Input: bytes, Status: Compilerˉnativeˉx64ˉstatus, Function: u32, Detail: u32
) -> Compilerˉnativeˉx64ˉsignatureˉtable {
    let Empty: bytes = Compilerˉnativeˉx64ˉempty(Input);
    return Compilerˉnativeˉx64ˉsignatureˉtable(Status, Function, Detail, Empty, Empty);
}

fn Compilerˉnativeˉx64ˉsignatureˉtableˉbuild(
    Input: borrow bytes, Context: Compilerˉnativeˉx64ˉplanˉinputs,
    Initialˉsignatures: Foundationˉbytes.Bytesˉbuilder
) -> Compilerˉnativeˉx64ˉsignatureˉtable {
    var Signatureˉbuilder: Foundationˉbytes.Bytesˉbuilder = Initialˉsignatures;
    let Structure: Compilerˉnativeˉx64ˉstructure = Context.Structure;
    let Types: Nominalˉtypes.Compilerˉnativeˉx64ˉtypes = Context.Types;
    let Minor: u32 = Context.Minor;
    let Functions: Compilerˉnativeˉx64ˉsection = Context.Functions;
    let Functionsˉlimit: u32 = Context.Functionsˉlimit;
    let Functionˉcount: u32 = Context.Functionˉcount;
    let Mainˉfunction: u32 = Context.Mainˉfunction;
    var Functionˉcursors: bytes = Compilerˉnativeˉx64ˉempty(Input);
    var Parameterˉcounts: bytes = Compilerˉnativeˉx64ˉempty(Input);
    var Borrowedˉparameterˉmasks: bytes =
        Compilerˉnativeˉx64ˉempty(Input);
    var Borrowedˉparameterˉcount: u32 = 0u32;
    var Functionˉcursor: u32 = Functions.Payloadˉoffset + 4u32;
    var Expectedˉwvbˉcodeˉoffset: u32 = 0u32;
    var Functionˉindex: u32 = 0u32;
    while Functionˉindex < Functionˉcount {
        Functionˉcursors = Bytesˉconcat(
            Functionˉcursors,
            Bytesˉfromˉu32ˉlittle(Functionˉcursor)
        );
        let Isˉmain: bool = Functionˉindex == Mainˉfunction;
        let Function: Compilerˉnativeˉx64ˉfunction =
            Compilerˉnativeˉx64ˉreadˉfunctionˉat(
                Input,
                Functionˉcursor,
                Functionsˉlimit,
                Isˉmain,
                Types
            );
        let Checkedˉheader: Compilerˉnativeˉx64ˉsignatureˉcheck = Compilerˉnativeˉx64ˉsignatureˉmetadataˉcheck(
            Function, Isˉmain, Minor, Structure.Codeˉlength, Expectedˉwvbˉcodeˉoffset, true);
        if !Checkedˉheader.Valid {
            var Failureˉfunction: u32 = Functionˉindex;
            if Checkedˉheader.Detail == 4294967295u32 { Failureˉfunction = 4294967295u32; }
            return Compilerˉnativeˉx64ˉsignatureˉtableˉfailure(Input,
                Compilerˉnativeˉx64ˉstatus.Unsupportedˉfunction, Failureˉfunction, Checkedˉheader.Detail);
        }
        if Minor == 34u32 || Minor == 35u32 || Minor == 36u32 ||
            Minor == 37u32 || Minor == 38u32 || Minor == 39u32 {
            Parameterˉcounts = Bytesˉconcat(
                Parameterˉcounts,
                Bytesˉslice(
                    Bytesˉfromˉu32ˉlittle(Function.Parameters), 0u32, 1u32
                )
            );
            var Borrowedˉlow: u32 = 0u32;
            var Borrowedˉhigh: u32 = 0u32;
            var Parameter: u32 = 0u32;
            while Parameter < Function.Parameters {
                let Borrowˉkind: u8 = Bytesˉreadˉu8(
                    Function.Localˉborrowˉkinds, Parameter
                );
                if Borrowˉkind == 36u8 || Borrowˉkind == 28u8 {
                    if Parameter < 32u32 {
                        Borrowedˉlow = Borrowedˉlow | (1u32 << Parameter);
                    } else {
                        Borrowedˉhigh = Borrowedˉhigh |
                            (1u32 << (Parameter - 32u32));
                    }
                    Borrowedˉparameterˉcount =
                        Borrowedˉparameterˉcount + 1u32;
                }
                Parameter = Parameter + 1u32;
            }
            Borrowedˉparameterˉmasks = Bytesˉconcat(
                Borrowedˉparameterˉmasks,
                Bytesˉconcat(
                    Bytesˉfromˉu32ˉlittle(Borrowedˉlow),
                    Bytesˉfromˉu32ˉlittle(Borrowedˉhigh)
                )
            );
        }
        let Checkedˉcode: Compilerˉnativeˉx64ˉsignatureˉcheck = Compilerˉnativeˉx64ˉsignatureˉmetadataˉcheck(
            Function, Isˉmain, Minor, Structure.Codeˉlength, Expectedˉwvbˉcodeˉoffset, false);
        if !Checkedˉcode.Valid {
            return Compilerˉnativeˉx64ˉsignatureˉtableˉfailure(Input,
                Compilerˉnativeˉx64ˉstatus.Unsupportedˉfunction, Functionˉindex, Checkedˉcode.Detail);
        }
        let Appended = Layoutˉwriter.Compilerˉnativeˉx64ˉlayoutˉappend(
            borrow mut Signatureˉbuilder,
            0u32,
            0u32,
            Function.Parameters,
            Function.Returnˉtype,
            borrow Bytesˉslice(Function.Localˉtypes, 0u32, Function.Parameters)
        );
        let Accepted: bool = match Appended {
            case Foundationˉresults.Result.Valid { Value: _ } { true }
            case Foundationˉresults.Result.Failure { Error: _ } { false }
        };
        if !Accepted { return Compilerˉnativeˉx64ˉsignatureˉtableˉfailure(Input, Compilerˉnativeˉx64ˉstatus.Outputˉlimit, 4294967295u32, 4294967295u32); }
        Expectedˉwvbˉcodeˉoffset =
            Expectedˉwvbˉcodeˉoffset + Function.Codeˉlength;
        Functionˉcursor = Function.Nextˉoffset;
        Functionˉindex = Functionˉindex + 1u32;
    }
    let Signatures: bytes = Foundationˉbytes.Freeze(Signatureˉbuilder);
    return Compilerˉnativeˉx64ˉsignatureˉtableˉfinish(
        Input, Context, Signatures, Functionˉcursors, Parameterˉcounts,
        Borrowedˉparameterˉmasks, Borrowedˉparameterˉcount, Functionˉcursor, Expectedˉwvbˉcodeˉoffset);
}

fn Compilerˉnativeˉx64ˉsignatureˉtableˉfinish(
    Input: borrow bytes, Context: Compilerˉnativeˉx64ˉplanˉinputs,
    Signatures: bytes, Functionˉcursors: bytes, Parameterˉcounts: bytes,
    Borrowedˉparameterˉmasks: bytes, Borrowedˉparameterˉcount: u32,
    Functionˉcursor: u32, Expectedˉwvbˉcodeˉoffset: u32
) -> Compilerˉnativeˉx64ˉsignatureˉtable {
    let Structure: Compilerˉnativeˉx64ˉstructure = Context.Structure;
    let Types: Nominalˉtypes.Compilerˉnativeˉx64ˉtypes = Context.Types;
    let Minor: u32 = Context.Minor;
    let Functionsˉlimit: u32 = Context.Functionsˉlimit;
    let Functionˉcount: u32 = Context.Functionˉcount;
    let Mainˉfunction: u32 = Context.Mainˉfunction;
    var Functionˉindex: u32 = 0u32;
    if Functionˉcursor != Functionsˉlimit {
        return Compilerˉnativeˉx64ˉsignatureˉtableˉfailure(
            Input,
            Compilerˉnativeˉx64ˉstatus.Unsupportedˉfunction,
            4294967295u32, 4294967295u32
        );
    }
    if Minor == 34u32 || Minor == 35u32 || Minor == 36u32 ||
        Minor == 37u32 || Minor == 38u32 || Minor == 39u32 {
        if Bytesˉlength(Parameterˉcounts) != Functionˉcount ||
            Bytesˉlength(Borrowedˉparameterˉmasks) != Functionˉcount * 8u32 ||
            (Minor == 34u32 && Borrowedˉparameterˉcount == 0u32) {
            return Compilerˉnativeˉx64ˉsignatureˉtableˉfailure(
                Input,
                Compilerˉnativeˉx64ˉstatus.Unsupportedˉfunction,
                4294967295u32, 4294967295u32
            );
        }
        Functionˉindex = 0u32;
        while Functionˉindex < Functionˉcount {
            let Borrowedˉfunction: Compilerˉnativeˉx64ˉfunction =
                Compilerˉnativeˉx64ˉreadˉfunctionˉat(
                    Input,
                    Bytesˉreadˉu32ˉlittle(
                        Functionˉcursors, Functionˉindex * 4u32
                    ),
                    Functionsˉlimit,
                    Functionˉindex == Mainˉfunction,
                    Types
                );
            if !Borrowedˉfunction.Valid ||
                !Compilerˉnativeˉx64ˉborrowedˉusesˉareˉvalid(
                    Input,
                    Structure.Codeˉoffset + Borrowedˉfunction.Codeˉoffset,
                    Borrowedˉfunction,
                    Parameterˉcounts,
                    Borrowedˉparameterˉmasks
                ) {
                return Compilerˉnativeˉx64ˉsignatureˉtableˉfailure(
                    Input,
                    Compilerˉnativeˉx64ˉstatus.Unsupportedˉfunction,
                    4294967295u32, 4294967295u32
                );
            }
            Functionˉindex = Functionˉindex + 1u32;
        }
    }
    if Expectedˉwvbˉcodeˉoffset != Structure.Codeˉlength {
        return Compilerˉnativeˉx64ˉsignatureˉtableˉfailure(
            Input,
            Compilerˉnativeˉx64ˉstatus.Unsupportedˉfunction,
            4294967295u32, 4294967295u32
        );
    }
    if Bytesˉlength(Signatures) !=
        Functionˉcount * Layout.Compilerˉnativeˉx64ˉlayoutˉentryˉbytes() {
        return Compilerˉnativeˉx64ˉsignatureˉtableˉfailure(
            Input,
            Compilerˉnativeˉx64ˉstatus.Outputˉlimit,
            4294967295u32, 4294967295u32
        );
    }
    if Bytesˉlength(Functionˉcursors) != Functionˉcount * 4u32 {
        return Compilerˉnativeˉx64ˉsignatureˉtableˉfailure(
            Input,
            Compilerˉnativeˉx64ˉstatus.Outputˉlimit,
            4294967295u32, 4294967295u32
        );
    }

    return Compilerˉnativeˉx64ˉsignatureˉtable(
        Compilerˉnativeˉx64ˉstatus.Valid, 4294967295u32, 4294967295u32, Signatures, Functionˉcursors);
}

fn Compilerˉnativeˉx64ˉmachineˉdirectoryˉbuild(
    Input: borrow bytes, Context: Compilerˉnativeˉx64ˉplanˉinputs,
    Table: Compilerˉnativeˉx64ˉsignatureˉtable, Initialˉdirectory: Foundationˉbytes.Bytesˉbuilder
) -> Compilerˉnativeˉx64ˉplan {
    var Directoryˉbuilder: Foundationˉbytes.Bytesˉbuilder = Initialˉdirectory;
    let Structure: Compilerˉnativeˉx64ˉstructure = Context.Structure;
    let Data: Staticˉdata.Compilerˉnativeˉx64ˉdata = Context.Data;
    let Types: Nominalˉtypes.Compilerˉnativeˉx64ˉtypes = Context.Types;
    let Capabilityˉtable: Nativeˉcapabilities.Compilerˉnativeˉx64ˉcapabilities = Context.Capabilityˉtable;
    let Minor: u32 = Context.Minor;
    let Functions: Compilerˉnativeˉx64ˉsection = Context.Functions;
    let Functionsˉlimit: u32 = Context.Functionsˉlimit;
    let Functionˉcount: u32 = Context.Functionˉcount;
    let Mainˉfunction: u32 = Context.Mainˉfunction;
    let Borrowˉroots: bytes = Context.Borrowˉroots;
    let Borrowˉdirectory: Sharedˉlocalˉliveness.Directory = Context.Borrowˉdirectory;
    let Signatures: bytes = Table.Signatures;
    let Functionˉcursors: bytes = Table.Functionˉcursors;
    var Functionˉcursor: u32 = 0u32;
    var Functionˉindex: u32 = 0u32;
    var Relocationˉlengths: bytes = Compilerˉnativeˉx64ˉempty(Input);
    var Expectedˉrelocationˉbytes: u32 = 0u32;
    var Expectedˉmachineˉcodeˉbytes: u32 = 0u32;
    var Hasˉsha256: bool = false;
    var Hasˉownedˉframes: bool = false;
    var Nativeˉabi: u32 = 22u32;
    if Ownedˉcollections.Minorˉisˉsupported(Minor) { Nativeˉabi = 24u32; }
    if Nominalˉtypes.Compilerˉnativeˉx64ˉsharedˉminor(Minor) { Nativeˉabi = 25u32; }
    Functionˉcursor = Functions.Payloadˉoffset + 4u32;
    Functionˉindex = 0u32;
    while Functionˉindex < Functionˉcount {
        let Isˉmeasureˉmain: bool = Functionˉindex == Mainˉfunction;
        let Measureˉfunction: Compilerˉnativeˉx64ˉfunction =
            Compilerˉnativeˉx64ˉreadˉfunctionˉat(
                Input,
                Functionˉcursor,
                Functionsˉlimit,
                Isˉmeasureˉmain,
                Types
            );
        let Measureˉcodeˉsection: Compilerˉnativeˉx64ˉsection =
            Compilerˉnativeˉx64ˉsection(
                true,
                Structure.Codeˉoffset + Measureˉfunction.Codeˉoffset,
                Measureˉfunction.Codeˉlength,
                0u32
            );
        let Measurement: Compilerˉnativeˉx64ˉfunctionˉmeasure = Compilerˉnativeˉx64ˉmeasureˉfunction(
            Input,
            Measureˉcodeˉsection,
            Compilerˉnativeˉx64ˉfunctionˉwithˉsignatures(Measureˉfunction,
                Functionˉcursors, Functionsˉlimit, Mainˉfunction, Borrowˉroots, Borrowˉdirectory, Functionˉindex),
            Isˉmeasureˉmain,
            Functionˉcount,
            Signatures,
            Data,
            Types,
            Capabilityˉtable
        );
        let Machineˉbytes: u32 = Measurement.Bytes;
        if Measurement.Ownedˉframes { Hasˉownedˉframes = true; }
        if Compilerˉnativeˉx64ˉcodeˉusesˉsha256(
            Input,
            Measureˉcodeˉsection.Payloadˉoffset,
            Measureˉcodeˉsection.Payloadˉlength
        ) { Hasˉsha256 = true; }
        if Machineˉbytes >= 2147483648u32 {
            return Compilerˉnativeˉx64ˉplanˉfunctionˉfailure(
                Input,
                Compilerˉnativeˉx64ˉstatus.Unsupportedˉcode,
                Functionˉindex,
                Machineˉbytes - 2147483648u32
            );
        }
        if Compilerˉnativeˉx64ˉfunctionˉusesˉprovider(
            Input,
            Measureˉcodeˉsection,
            Capabilityˉtable
        ) {
            Nativeˉabi = 23u32;
        }
        if Expectedˉmachineˉcodeˉbytes > 67108864u32 {
            return Compilerˉnativeˉx64ˉplanˉfunctionˉfailure(
                Input,
                Compilerˉnativeˉx64ˉstatus.Outputˉlimit, Functionˉindex, 1u32
            );
        }
        if Machineˉbytes >
            67108864u32 - Expectedˉmachineˉcodeˉbytes {
            return Compilerˉnativeˉx64ˉplanˉfunctionˉfailure(
                Input,
                Compilerˉnativeˉx64ˉstatus.Outputˉlimit, Functionˉindex, 1u32
            );
        }
        var Functionˉrelocationˉbytes: u32 =
            Compilerˉnativeˉx64ˉmeasureˉdataˉrelocations(
                Input,
                Measureˉcodeˉsection
            );
        if Nominalˉtypes.Compilerˉnativeˉx64ˉsharedˉminor(Minor) && Isˉmeasureˉmain { Functionˉrelocationˉbytes = Functionˉrelocationˉbytes + 16u32; }
        if Expectedˉrelocationˉbytes > 524288u32 {
            return Compilerˉnativeˉx64ˉplanˉfunctionˉfailure(
                Input,
                Compilerˉnativeˉx64ˉstatus.Outputˉlimit, Functionˉindex, 2u32
            );
        }
        if Functionˉrelocationˉbytes >
            524288u32 - Expectedˉrelocationˉbytes {
            return Compilerˉnativeˉx64ˉplanˉfunctionˉfailure(
                Input,
                Compilerˉnativeˉx64ˉstatus.Outputˉlimit, Functionˉindex, 2u32
            );
        }
        let Directoryˉappended = Layoutˉwriter.Compilerˉnativeˉx64ˉlayoutˉappend(
            borrow mut Directoryˉbuilder,
            Expectedˉmachineˉcodeˉbytes,
            Machineˉbytes,
            Measureˉfunction.Parameters,
            Measureˉfunction.Returnˉtype,
            borrow Bytesˉslice(
                Measureˉfunction.Localˉtypes,
                0u32,
                Measureˉfunction.Parameters
            )
        );
        let Directoryˉaccepted: bool = match Directoryˉappended {
            case Foundationˉresults.Result.Valid { Value: _ } { true }
            case Foundationˉresults.Result.Failure { Error: _ } { false }
        };
        if !Directoryˉaccepted { return Compilerˉnativeˉx64ˉplanˉfailure(Input, Compilerˉnativeˉx64ˉstatus.Outputˉlimit); }
        Expectedˉmachineˉcodeˉbytes =
            Expectedˉmachineˉcodeˉbytes + Machineˉbytes;
        Relocationˉlengths = Bytesˉconcat(
            Relocationˉlengths,
            Bytesˉfromˉu32ˉlittle(Functionˉrelocationˉbytes)
        );
        Expectedˉrelocationˉbytes = Expectedˉrelocationˉbytes +
            Functionˉrelocationˉbytes;
        Functionˉcursor = Measureˉfunction.Nextˉoffset;
        Functionˉindex = Functionˉindex + 1u32;
    }
    let Directory: bytes = Foundationˉbytes.Freeze(Directoryˉbuilder);
    return Compilerˉnativeˉx64ˉplanˉfinish(
        Input, Context, Directory, Functionˉcursors, Relocationˉlengths,
        Expectedˉmachineˉcodeˉbytes, Expectedˉrelocationˉbytes, Hasˉsha256, Hasˉownedˉframes, Nativeˉabi);
}

fn Compilerˉnativeˉx64ˉplanˉfinish(
    Input: borrow bytes, Context: Compilerˉnativeˉx64ˉplanˉinputs,
    Directory: bytes, Functionˉcursors: bytes, Relocationˉlengths: bytes,
    Expectedˉmachineˉcodeˉbytes: u32, Expectedˉrelocationˉbytes: u32,
    Hasˉsha256: bool, Hasˉownedˉframes: bool, Nativeˉabi: u32
) -> Compilerˉnativeˉx64ˉplan {
    let Structure: Compilerˉnativeˉx64ˉstructure = Context.Structure;
    let Data: Staticˉdata.Compilerˉnativeˉx64ˉdata = Context.Data;
    let Types: Nominalˉtypes.Compilerˉnativeˉx64ˉtypes = Context.Types;
    let Capabilityˉtable: Nativeˉcapabilities.Compilerˉnativeˉx64ˉcapabilities = Context.Capabilityˉtable;
    let Minor: u32 = Context.Minor;
    let Functions: Compilerˉnativeˉx64ˉsection = Context.Functions;
    let Functionsˉlimit: u32 = Context.Functionsˉlimit;
    let Functionˉcount: u32 = Context.Functionˉcount;
    let Mainˉfunction: u32 = Context.Mainˉfunction;
    let Evidenceˉsource: bytes = Context.Evidenceˉsource;
    let Borrowˉroots: bytes = Context.Borrowˉroots;
    let Borrowˉdirectory: Sharedˉlocalˉliveness.Directory = Context.Borrowˉdirectory;
    if Bytesˉlength(Directory) !=
        Functionˉcount * Layout.Compilerˉnativeˉx64ˉlayoutˉentryˉbytes() {
        return Compilerˉnativeˉx64ˉplanˉfailure(
            Input,
            Compilerˉnativeˉx64ˉstatus.Outputˉlimit
        );
    }
    if Bytesˉlength(Relocationˉlengths) != Functionˉcount * 4u32 {
        return Compilerˉnativeˉx64ˉplanˉfailure(
            Input,
            Compilerˉnativeˉx64ˉstatus.Outputˉlimit
        );
    }

    var Helper: bytes = Compilerˉnativeˉx64ˉempty(Input);
    if Hasˉsha256 { Helper = Nativeˉsha256.Compilerˉnativeˉx64ˉsha256ˉhelper(); }
    if Nominalˉtypes.Compilerˉnativeˉx64ˉsharedˉminor(Minor) { Helper = Sharedˉbytes.Helper(); }
    if Hasˉownedˉframes {
        if Hasˉsha256 || Nativeˉabi != 24u32 {
            return Compilerˉnativeˉx64ˉplanˉfailure(Input, Compilerˉnativeˉx64ˉstatus.Unsupportedˉmodule);
        }
        Helper = Ownedˉframes.Helper();
    }
    if Bytesˉlength(Helper) > 67108864u32 - Expectedˉmachineˉcodeˉbytes {
        return Compilerˉnativeˉx64ˉplanˉfailure(
            Input, Compilerˉnativeˉx64ˉstatus.Outputˉlimit
        );
    }
    return Compilerˉnativeˉx64ˉplan(
        Compilerˉnativeˉx64ˉstatus.Valid,
        Nativeˉabi,
        Structure.Codeˉoffset,
        Functions.Payloadˉoffset + 4u32,
        Functionsˉlimit,
        Functionˉcount,
        Mainˉfunction,
        Expectedˉmachineˉcodeˉbytes,
        Bytesˉlength(Helper),
        Helper,
        Expectedˉrelocationˉbytes,
        Directory,
        Functionˉcursors,
        Relocationˉlengths,
        Data.Count,
        Data.Kinds,
        Data.Lengths,
        Data.Offsets,
        Data.Sizes,
        Data.Bytes,
        Types.Count,
        Types.Kinds,
        Types.Itemˉoffsets,
        Types.Itemˉcounts,
        Types.Recordˉwidths,
        Types.Sharedˉplans,
        Capabilityˉtable.Count,
        Capabilityˉtable.Kinds,
        4294967295u32,
        4294967295u32,
        Evidenceˉsource,
        Borrowˉroots,
        Borrowˉdirectory
    );
}

export fn Compilerˉnativeˉx64ˉfunctionˉbatchˉemitˉbounded(
    Input: bytes,
    Plan: Compilerˉnativeˉx64ˉplan,
    Firstˉfunction: u32,
    Maximumˉartifactˉbytes: u32,
    Maximumˉfunctions: u32,
    Maximumˉgroupedˉfunctionˉbytes: u32
) -> Compilerˉnativeˉx64ˉfunctionˉbatch {
    if Plan.Status != Compilerˉnativeˉx64ˉstatus.Valid {
        return Compilerˉnativeˉx64ˉfunctionˉbatchˉfailure(
            Input,
            Plan.Status,
            Firstˉfunction
        );
    }
    if Plan.Abi == 25u32 && (!Sharedˉbytes.Bytesˉareˉequal(Plan.Source, Input) ||
        Bytesˉlength(Plan.Borrowˉroots) < 16u32 || !Plan.Borrowˉdirectory.Valid ||
        !Sharedˉbytes.Bytesˉareˉequal(Plan.Borrowˉdirectory.Source, Input) ||
        !Sharedˉbytes.Bytesˉareˉequal(Plan.Borrowˉdirectory.Borrowˉroots, Plan.Borrowˉroots)) {
        return Compilerˉnativeˉx64ˉfunctionˉbatchˉfailure(Input,
            Compilerˉnativeˉx64ˉstatus.Invalidˉwvb, Firstˉfunction);
    }
    if Maximumˉartifactˉbytes < 16u32 ||
        Maximumˉartifactˉbytes > 4194304u32 ||
        Maximumˉfunctions == 0u32 ||
        Maximumˉfunctions >
            Layout.Compilerˉnativeˉx64ˉlayoutˉfunctionˉlimit() ||
        Maximumˉgroupedˉfunctionˉbytes == 0u32 ||
        Maximumˉgroupedˉfunctionˉbytes > Maximumˉartifactˉbytes - 16u32 {
        return Compilerˉnativeˉx64ˉfunctionˉbatchˉfailure(
            Input,
            Compilerˉnativeˉx64ˉstatus.Outputˉlimit,
            Firstˉfunction
        );
    }
    if Plan.Functionˉcount == 0u32 ||
        Plan.Functionˉcount > Layout.Compilerˉnativeˉx64ˉlayoutˉfunctionˉlimit() ||
        Plan.Mainˉfunction >= Plan.Functionˉcount ||
        Firstˉfunction >= Plan.Functionˉcount {
        return Compilerˉnativeˉx64ˉfunctionˉbatchˉfailure(
            Input,
            Compilerˉnativeˉx64ˉstatus.Unsupportedˉfunction,
            Firstˉfunction
        );
    }
    if Bytesˉlength(Plan.Directory) != Plan.Functionˉcount *
            Layout.Compilerˉnativeˉx64ˉlayoutˉentryˉbytes() ||
        Bytesˉlength(Plan.Functionˉcursors) != Plan.Functionˉcount * 4u32 ||
        Bytesˉlength(Plan.Relocationˉlengths) != Plan.Functionˉcount * 4u32 ||
        Plan.Machineˉcodeˉbytes > 67108864u32 ||
        Plan.Helperˉbytes != Bytesˉlength(Plan.Helper) ||
        Plan.Helperˉbytes > 67108864u32 - Plan.Machineˉcodeˉbytes ||
        (Plan.Helperˉbytes != 0u32 &&
            !Nativeˉsha256.Compilerˉnativeˉx64ˉsha256ˉhelperˉisˉexact(
                Plan.Helper
            ) && !(Plan.Abi == 24u32 && Ownedˉframes.Helperˉisˉexact(Plan.Helper)) &&
                !(Plan.Abi == 25u32 && Sharedˉbytes.Helperˉisˉexact(Plan.Helper))) ||
        (Plan.Abi == 25u32 && (!Sharedˉbytes.Helperˉisˉexact(Plan.Helper) ||
            Plan.Capabilityˉcount != 0u32 || Plan.Dataˉcount > 512u32 ||
            Bytesˉlength(Plan.Dataˉbytes) > 4194304u32)) ||
        Plan.Relocationˉbytes > 524288u32 ||
        Plan.Dataˉcount > Staticˉdata.Compilerˉnativeˉx64ˉdataˉlimit() ||
        Bytesˉlength(Plan.Dataˉkinds) != Plan.Dataˉcount ||
        Bytesˉlength(Plan.Dataˉlengths) != Plan.Dataˉcount * 4u32 ||
        Bytesˉlength(Plan.Dataˉoffsets) != Plan.Dataˉcount * 4u32 ||
        Bytesˉlength(Plan.Dataˉsizes) != Plan.Dataˉcount * 4u32 ||
        Plan.Typeˉcount > Nominalˉtypes.Compilerˉnativeˉx64ˉtypesˉlimit() ||
        Bytesˉlength(Plan.Typeˉkinds) != Plan.Typeˉcount ||
        Bytesˉlength(Plan.Typeˉitemˉoffsets) != Plan.Typeˉcount * 4u32 ||
        Bytesˉlength(Plan.Typeˉitemˉcounts) != Plan.Typeˉcount * 4u32 ||
        Bytesˉlength(Plan.Typeˉrecordˉwidths) != Plan.Typeˉcount * 4u32 ||
        Bytesˉlength(Plan.Typeˉsharedˉplans) > 4194304u32 ||
        (Plan.Abi != 22u32 && Plan.Abi != 23u32 && Plan.Abi != 24u32 && Plan.Abi != 25u32) ||
        Plan.Capabilityˉcount > 7u32 ||
        Bytesˉlength(Plan.Capabilityˉkinds) != Plan.Capabilityˉcount {
        return Compilerˉnativeˉx64ˉfunctionˉbatchˉfailure(
            Input,
            Compilerˉnativeˉx64ˉstatus.Unsupportedˉmodule,
            Firstˉfunction
        );
    }
    let Inputˉbytes: u32 = Bytesˉlength(Input);
    if Plan.Codeˉoffset > Inputˉbytes ||
        Plan.Functionsˉoffset > Plan.Functionsˉlimit ||
        Plan.Functionsˉlimit > Inputˉbytes {
        return Compilerˉnativeˉx64ˉfunctionˉbatchˉfailure(
            Input,
            Compilerˉnativeˉx64ˉstatus.Invalidˉwvb,
            Firstˉfunction
        );
    }

    var Batchˉfunctions: u32 = 0u32;
    var Batchˉcodeˉbytes: u32 = 0u32;
    var Batchˉrelocationˉbytes: u32 = 0u32;
    var Functionˉindex: u32 = Firstˉfunction;
    while Functionˉindex < Plan.Functionˉcount {
        let Functionˉcodeˉbytes: u32 =
            Layout.Compilerˉnativeˉx64ˉlayoutˉmachineˉlength(
                Plan.Directory,
                Functionˉindex
            );
        let Functionˉrelocationˉbytes: u32 = Bytesˉreadˉu32ˉlittle(
            Plan.Relocationˉlengths,
            Functionˉindex * 4u32
        );
        var Fits: bool = Functionˉrelocationˉbytes % 8u32 == 0u32;
        if Functionˉrelocationˉbytes > 524288u32 - Batchˉrelocationˉbytes {
            Fits = false;
        }
        if Functionˉcodeˉbytes > 67108864u32 - Batchˉcodeˉbytes {
            Fits = false;
        }
        let Currentˉpayloadˉbytes: u32 =
            Batchˉrelocationˉbytes + Batchˉcodeˉbytes;
        if Functionˉrelocationˉbytes >
            Maximumˉartifactˉbytes - 16u32 {
            Fits = false;
        } else {
            if Functionˉcodeˉbytes > Maximumˉartifactˉbytes - 16u32 -
                Functionˉrelocationˉbytes {
                Fits = false;
            } else {
                let Functionˉartifactˉbytes: u32 =
                    Functionˉrelocationˉbytes + Functionˉcodeˉbytes;
                if Batchˉfunctions > 0u32 &&
                    Functionˉartifactˉbytes >
                        Maximumˉgroupedˉfunctionˉbytes {
                    Fits = false;
                }
                if Currentˉpayloadˉbytes > Maximumˉartifactˉbytes - 16u32 ||
                    Functionˉartifactˉbytes > Maximumˉartifactˉbytes - 16u32 -
                        Currentˉpayloadˉbytes {
                    Fits = false;
                }
            }
        }
        if !Fits {
            if Batchˉfunctions == 0u32 {
                return Compilerˉnativeˉx64ˉfunctionˉbatchˉfailure(
                    Input,
                    Compilerˉnativeˉx64ˉstatus.Outputˉlimit,
                    Firstˉfunction
                );
            }
            Functionˉindex = Plan.Functionˉcount;
        } else {
            Batchˉcodeˉbytes = Batchˉcodeˉbytes + Functionˉcodeˉbytes;
            Batchˉrelocationˉbytes = Batchˉrelocationˉbytes +
                Functionˉrelocationˉbytes;
            Batchˉfunctions = Batchˉfunctions + 1u32;
            Functionˉindex = Functionˉindex + 1u32;
            if Batchˉfunctions == Maximumˉfunctions ||
                Functionˉrelocationˉbytes + Functionˉcodeˉbytes >
                    Maximumˉgroupedˉfunctionˉbytes {
                Functionˉindex = Plan.Functionˉcount;
            }
        }
    }

    let Functionˉcursor: u32 = Bytesˉreadˉu32ˉlittle(
        Plan.Functionˉcursors,
        Firstˉfunction * 4u32
    );
    let Data: Staticˉdata.Compilerˉnativeˉx64ˉdata =
        Compilerˉnativeˉx64ˉplanˉdata(Plan);
    let Types: Nominalˉtypes.Compilerˉnativeˉx64ˉtypes =
        Compilerˉnativeˉx64ˉplanˉtypes(Plan);
    let Capabilityˉtable: Nativeˉcapabilities.Compilerˉnativeˉx64ˉcapabilities =
        Compilerˉnativeˉx64ˉplanˉcapabilities(Plan);
    let Artifacts: bytes = Compilerˉnativeˉx64ˉemitˉfunctionˉrange(
        Input,
        Plan.Codeˉoffset,
        Functionˉcursor,
        Plan.Functionsˉlimit,
        Firstˉfunction,
        Batchˉfunctions,
        Plan.Mainˉfunction,
        Plan.Functionˉcount,
        Plan.Directory,
        Plan.Functionˉcursors,
        Plan.Borrowˉroots,
        Plan.Borrowˉdirectory,
        Data,
        Types,
        Capabilityˉtable
    );
    if !Compilerˉnativeˉx64ˉfunctionˉartifactsˉareˉvalid(Artifacts) ||
        Bytesˉlength(Artifacts) > Maximumˉartifactˉbytes ||
        Bytesˉreadˉu32ˉlittle(Artifacts, 8u32) !=
            Batchˉrelocationˉbytes ||
        Bytesˉreadˉu32ˉlittle(Artifacts, 12u32) != Batchˉcodeˉbytes {
        return Compilerˉnativeˉx64ˉfunctionˉbatchˉfailure(
            Input,
            Compilerˉnativeˉx64ˉstatus.Unsupportedˉcode,
            Firstˉfunction
        );
    }
    return Compilerˉnativeˉx64ˉfunctionˉbatch(
        Compilerˉnativeˉx64ˉstatus.Valid,
        Firstˉfunction,
        Batchˉfunctions,
        Firstˉfunction + Batchˉfunctions,
        Artifacts
    );
}

export fn Compilerˉnativeˉx64ˉfunctionˉbatchˉemit(
    Input: bytes,
    Plan: Compilerˉnativeˉx64ˉplan,
    Firstˉfunction: u32,
    Maximumˉartifactˉbytes: u32
) -> Compilerˉnativeˉx64ˉfunctionˉbatch {
    return Compilerˉnativeˉx64ˉfunctionˉbatchˉemitˉbounded(
        Input,
        Plan,
        Firstˉfunction,
        Maximumˉartifactˉbytes,
        Layout.Compilerˉnativeˉx64ˉlayoutˉfunctionˉlimit(),
        Maximumˉartifactˉbytes - 16u32
    );
}

export fn Compilerˉlowerˉwvbˉnativeˉx64(
    Input: borrow bytes,
    Budget: borrow mut Foundationˉmemory.Memoryˉbudget
) -> Compilerˉnativeˉx64ˉsummary effects(memory.allocate) {
    return Compilerˉlowerˉwvbˉnativeˉx64ˉbounded(
        Input, borrow mut Budget, 0u32
    );
}

export fn Compilerˉlowerˉwvbˉnativeˉx64ˉbounded(
    Input: borrow bytes,
    Budget: borrow mut Foundationˉmemory.Memoryˉbudget,
    Maximumˉobjectˉbytes: u32
) -> Compilerˉnativeˉx64ˉsummary effects(memory.allocate) {
    if Maximumˉobjectˉbytes != 0u32 &&
        (Maximumˉobjectˉbytes > 4194304u32 || Bytesˉlength(Input) > 4194304u32) {
        return Compilerˉnativeˉx64ˉfailure(Input, Compilerˉnativeˉx64ˉstatus.Outputˉlimit);
    }
    let Plan: Compilerˉnativeˉx64ˉplan =
        Compilerˉnativeˉx64ˉplanˉbuild(Input, borrow mut Budget);
    if Plan.Status != Compilerˉnativeˉx64ˉstatus.Valid {
        return Compilerˉnativeˉx64ˉfailure(Input, Plan.Status);
    }
    let Batch: Compilerˉnativeˉx64ˉfunctionˉbatch =
        Compilerˉnativeˉx64ˉfunctionˉbatchˉemit(
            Input,
            Plan,
            0u32,
            4194304u32
        );
    if Batch.Status != Compilerˉnativeˉx64ˉstatus.Valid {
        return Compilerˉnativeˉx64ˉfailure(Input, Batch.Status);
    }
    if Batch.Nextˉfunction != Plan.Functionˉcount {
        return Compilerˉnativeˉx64ˉfailure(
            Input,
            Compilerˉnativeˉx64ˉstatus.Outputˉlimit
        );
    }
    let Data: Staticˉdata.Compilerˉnativeˉx64ˉdata =
        Compilerˉnativeˉx64ˉplanˉdata(Plan);
    let Functionˉartifacts: bytes = Batch.Artifacts;
    let Relocationˉbytes: u32 =
        Bytesˉreadˉu32ˉlittle(Functionˉartifacts, 8u32);
    let Codeˉbytes: u32 = Bytesˉreadˉu32ˉlittle(Functionˉartifacts, 12u32);
    if Relocationˉbytes != Plan.Relocationˉbytes ||
        Codeˉbytes != Plan.Machineˉcodeˉbytes {
        return Compilerˉnativeˉx64ˉfailure(
            Input,
            Compilerˉnativeˉx64ˉstatus.Outputˉlimit
        );
    }
    let Relocations: bytes =
        Bytesˉslice(Functionˉartifacts, 16u32, Relocationˉbytes);
    let Declaredˉcode: bytes = Bytesˉslice(
        Functionˉartifacts,
        16u32 + Relocationˉbytes,
        Codeˉbytes
    );
    var Padding: bytes = Compilerˉnativeˉx64ˉempty(Input);
    if Data.Count > 0u32 || Plan.Abi == 25u32 {
        while (Bytesˉlength(Declaredˉcode) + Plan.Helperˉbytes +
            Bytesˉlength(Padding)) % 16u32 != 0u32 {
            Padding = Bytesˉconcat(Padding, Bytesˉfromˉu8(144u8));
        }
    }
    let Textˉbytes: u32 = Bytesˉlength(Declaredˉcode) + Plan.Helperˉbytes +
        Bytesˉlength(Padding);
    let Object: bytes = Objectˉwriter.Compilerˉnativeˉx64ˉobjectˉemitˉbounded(
        Declaredˉcode,
        Padding,
        Plan.Directory,
        Plan.Functionˉcount,
        Plan.Mainˉfunction,
        Plan.Helper,
        Data,
        Relocations,
        Plan.Abi,
        Maximumˉobjectˉbytes
    );
    if Bytesˉlength(Object) == 0u32 {
        return Compilerˉnativeˉx64ˉfailure(
            Input, Compilerˉnativeˉx64ˉstatus.Outputˉlimit
        );
    }
    // ABI25's writer measures the complete versioned symbol/read-only layout.
    // Retain the established exact length check for unchanged earlier objects.
    if Plan.Abi != 25u32 {
    var Objectˉoverhead: u32 =
        73u32 + (Plan.Functionˉcount - 1u32) * 34u32;
    if Plan.Helperˉbytes > 0u32 {
        var Helperˉoverhead: u32 = 38u32;
        if Ownedˉframes.Helperˉisˉexact(Plan.Helper) { Helperˉoverhead = 40u32; }
        Objectˉoverhead = Objectˉoverhead + Helperˉoverhead;
    }
    if Data.Count > 0u32 {
        Objectˉoverhead = Objectˉoverhead + 27u32 +
            Bytesˉlength(Data.Bytes) + Data.Count * 30u32;
    }
    Objectˉoverhead = Objectˉoverhead +
        Bytesˉlength(Relocations) / 8u32 * 20u32;
    var Overheadˉrelocation: u32 = 0u32;
    var Hasˉforeignˉrelocation: bool = false;
    while Overheadˉrelocation < Bytesˉlength(Relocations) / 8u32 {
        if Bytesˉreadˉu32ˉlittle(
            Relocations, Overheadˉrelocation * 8u32 + 4u32
        ) == 4294967295u32 {
            Hasˉforeignˉrelocation = true;
        }
        Overheadˉrelocation = Overheadˉrelocation + 1u32;
    }
    if Hasˉforeignˉrelocation {
        // One exact 50-byte imported buffer-source symbol owns every E0 call.
        Objectˉoverhead = Objectˉoverhead + 50u32;
    }
    if Bytesˉlength(Object) != Textˉbytes + Objectˉoverhead {
        return Compilerˉnativeˉx64ˉfailure(
            Input,
            Compilerˉnativeˉx64ˉstatus.Outputˉlimit
        );
    }
    }
    return Compilerˉnativeˉx64ˉsummary(
        Compilerˉnativeˉx64ˉstatus.Valid,
        Object,
        0,
        Plan.Abi,
        Textˉbytes
    );
}
