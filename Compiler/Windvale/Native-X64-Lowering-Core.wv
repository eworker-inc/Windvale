    }
    if Opcode == 16u8 { return 39u32; }
    if Opcode == 17u8 { return 39u32; }
    if Opcode == 18u8 { return 40u32; }
    if Opcode == 19u8 { return 32u32; }
    if Opcode == 20u8 { return 39u32; }
    if Opcode == 21u8 { return 39u32; }
    if Opcode == 22u8 { return 41u32; }
    if Opcode == 161u8 { return 43u32; }
    if Opcode == 162u8 { return 45u32; }
    if Opcode == 165u8 || Opcode == 166u8 {
        return Descriptorˉinstructions.Compilerˉnativeˉx64ˉu64ˉdivisionˉbytes(
            Opcode
