    Result = Compilerˉnativeˉx64ˉappendˉword(Result, 1320068);
    Result = Compilerˉnativeˉx64ˉappendˉword(Result, -2071396352);
    Result = Compilerˉnativeˉx64ˉappendˉword(Result, 6180);
    Result = Compilerˉnativeˉx64ˉappendˉword(Result, 612665600);
    Result = Compilerˉnativeˉx64ˉappendˉword(Result, 28);
    Result = Compilerˉnativeˉx64ˉappendˉword(Result, 539264137);
    Result = Compilerˉnativeˉx64ˉappendˉword(Result, -1996488704);
    Result = Compilerˉnativeˉx64ˉappendˉword(Result, 2368644);
    Result = Compilerˉnativeˉx64ˉappendˉword(Result, -2071396352);
    Result = Compilerˉnativeˉx64ˉappendˉword(Result, 10276);
    Result = Compilerˉnativeˉx64ˉappendˉword(Result, 612665600);
    Result = Compilerˉnativeˉx64ˉappendˉword(Result, 44);
    Result = Compilerˉnativeˉx64ˉappendˉword(Result, 32211785);
    Result = Compilerˉnativeˉx64ˉappendˉword(Result, 8290831);
    Result = Bytesˉconcat(Result, Bytesˉfromˉu8(0u8));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu8(0u8));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu8(184u8));
    Result = Compilerˉnativeˉx64ˉappendˉword(Result, Value);
    // Pinned ABI-22 suffix.
    Result = Compilerˉnativeˉx64ˉappendˉword(Result, 270828681);
    Result = Compilerˉnativeˉx64ˉappendˉword(Result, 1224736768);
    Result = Compilerˉnativeˉx64ˉappendˉword(Result, 251784067);
