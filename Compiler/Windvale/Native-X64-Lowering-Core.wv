    if Opcode == 134u8 || Opcode == 135u8 { return 43u32; }
    if Opcode == 136u8 { return 46u32; }
    if Opcode == 133u8 { return 35u32; }
    if Opcode == 173u8 || Opcode == 174u8 || Opcode == 175u8 { return 33u32; }
    if Opcode == 176u8 { return 26u32; }
    if Opcode == 177u8 || Opcode == 178u8 { return 42u32; }
    if U32ˉfromˉu8(Opcode) >= 179u32 &&
        U32ˉfromˉu8(Opcode) <= 181u32 { return 37u32; }
    if Opcode == 182u8 { return 29u32; }
    if Opcode == 183u8 || Opcode == 184u8 { return 45u32; }
    if Compilerˉnativeˉx64ˉisˉi32ˉcomparison(Opcode) { return 39u32; }
    if Compilerˉnativeˉx64ˉisˉboolˉcomparison(Opcode) { return 39u32; }
    if Compilerˉnativeˉx64ˉisˉu32ˉcomparison(Opcode) { return 39u32; }
    if Compilerˉnativeˉx64ˉisˉu8ˉcomparison(Opcode) { return 39u32; }
    if Compilerˉnativeˉx64ˉisˉi64ˉcomparison(Opcode) { return 42u32; }
    if Compilerˉnativeˉx64ˉisˉu64ˉcomparison(Opcode) { return 42u32; }
    if Opcode == 104u8 {
        return Records.Compilerˉnativeˉx64ˉrecordˉcreateˉbytes(
