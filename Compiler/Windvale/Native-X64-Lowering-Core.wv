    if Opcode == 117u8 {
        return Runtimeˉdescriptors.Compilerˉnativeˉx64ˉtextˉquoteˉbytes();
    }
    if Opcode == 118u8 {
        return Descriptorˉinstructions.Compilerˉnativeˉx64ˉu32ˉfromˉu8ˉbytes();
    }
    if Opcode == 191u8 {
        return Descriptorˉinstructions.Compilerˉnativeˉx64ˉu64ˉfromˉu32ˉbytes();
    }
    if Opcode == 119u8 {
        return Bytesˉconcatenation.Compilerˉnativeˉx64ˉbytesˉconcatˉbytes();
    }
    if Opcode == 120u8 {
        return Bytesˉconcatenation.Compilerˉnativeˉx64ˉbytesˉfromˉu8ˉbytes();
    }
    if Opcode == 121u8 {
        return Bytesˉconcatenation.Compilerˉnativeˉx64ˉbytesˉfromˉu16ˉlittleˉbytes();
    }
    if Opcode == 122u8 || Opcode == 123u8 {
        return Bytesˉconcatenation.Compilerˉnativeˉx64ˉbytesˉfromˉ32ˉlittleˉbytes();
    }
    if Opcode == 190u8 {
