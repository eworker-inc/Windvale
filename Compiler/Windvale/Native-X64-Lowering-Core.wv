                                                Stackˉtypes = Bytesˉconcat(
                                                    Stackˉtypes,
                                                    Bytesˉfromˉu8(2u8)
                                                );
                                                Stackˉslots = Bytesˉconcat(
                                                    Stackˉslots,
                                                    Bytesˉfromˉu32ˉlittle(Notˉresult)
                                                );
                                                Stackˉdepth = Stackˉdepth + 1u32;
                                                Nextˉbool = Nextˉbool + 1u32;
                                            } else {
                                                if Opcode == 64u8 {
