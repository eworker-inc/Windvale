            Input, Types, Callableˉtype, Callableˉfunctions, Callˉdirectory
        );
        if Indirectˉcallableˉtarget == 4294967295u32 { return 0u32; }
        let Publicˉparameters: u32 =
            Nominalˉtypes.Compilerˉnativeˉx64ˉcallableˉparameters(
                Types, Callableˉtype
            );
        let Physicalˉparameters: u32 =
            Layout.Compilerˉnativeˉx64ˉlayoutˉparameters(
                Callˉdirectory, Indirectˉcallableˉtarget
            );
        let Indirectˉcaptureˉcount: u32 =
            Physicalˉparameters - Publicˉparameters;
        var Validationˉbytes: u32 = 53u32;
        if Indirectˉcaptureˉcount > 0u32 {
            Validationˉbytes = 86u32 + Indirectˉcaptureˉcount * 30u32;
        }
        return Validationˉbytes + Compilerˉnativeˉx64ˉemittedˉbytes(
            Input, Offset, 64u8, Isˉmain, Physicalˉparameters,
            Indirectˉcallableˉtarget,
            Callˉdirectory, 0u8, 4294967295u32, Functionˉreturnˉtype, Types,
            Capabilityˉtable
        );
    }
    if Opcode == 1u8 { return 22u32; }
    if Opcode == 2u8 { return 22u32; }
