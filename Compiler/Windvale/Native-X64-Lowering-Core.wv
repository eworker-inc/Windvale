module Compilerˉnativeˉx64ˉlowering profile portable;

export enum Compilerˉnativeˉx64ˉstatus {
    Valid = 0;
    Invalidˉwvb = 1;
    Unsupportedˉprofile = 2;
    Unsupportedˉmodule = 3;
    Unsupportedˉfunction = 4;
    Unsupportedˉcode = 5;
    Outputˉlimit = 6;
}

record Compilerˉnativeˉx64ˉsection {
    Valid: bool;
    Payloadˉoffset: u32;
    Payloadˉlength: u32;
    Nextˉoffset: u32;
}

record Compilerˉnativeˉx64ˉstructure {
    Valid: bool;
    Moduleˉoffset: u32;
    Moduleˉlength: u32;
    Capabilitiesˉoffset: u32;
    Capabilitiesˉlength: u32;
    Dataˉoffset: u32;
    Dataˉlength: u32;
    Functionsˉoffset: u32;
    Functionsˉlength: u32;
    Codeˉoffset: u32;
    Codeˉlength: u32;
    Exportsˉoffset: u32;
    Exportsˉlength: u32;
    Typesˉoffset: u32;
    Typesˉlength: u32;
}

export record Compilerˉnativeˉx64ˉsummary {
    Status: Compilerˉnativeˉx64ˉstatus;
    Object: bytes;
    Value: i32;
    Abi: u32;
    Codeˉbytes: u32;
}

record Compilerˉnativeˉx64ˉfunction {
    Valid: bool;
    Nextˉoffset: u32;
    Codeˉoffset: u32;
    Parameters: u32;
    Locals: u32;
    Localˉtypes: bytes;
    Codeˉlength: u32;
    Maximumˉstack: u32;
}

record Compilerˉnativeˉx64ˉanalysis {
    Valid: bool;
    Values: u32;
    Instructions: u32;
    Bodyˉbytes: u32;
    Returnˉvalue: u32;
    Maximumˉstack: u32;
}

record Compilerˉnativeˉx64ˉcontrolˉanalysis {
    Valid: bool;
    I32ˉslots: u32;
    Boolˉslots: u32;
    Blocks: u32;
    Instructions: u32;
    Bodyˉbytes: u32;
    Maximumˉstack: u32;
    Leaders: bytes;
}

record Compilerˉnativeˉx64ˉblockˉanalysis {
    Valid: bool;
    Next: u32;
    I32ˉvalues: u32;
    Boolˉvalues: u32;
    Maximumˉstack: u32;
    Bodyˉbytes: u32;
    Terminator: u8;
    Target: u32;
}

export fn Compilerˉnativeˉx64ˉempty(Input: bytes) -> bytes {
    return Bytesˉslice(Input, 0u32, 0u32);
}

export fn Compilerˉnativeˉx64ˉfailure(
    Input: bytes,
    Status: Compilerˉnativeˉx64ˉstatus
) -> Compilerˉnativeˉx64ˉsummary {
    return Compilerˉnativeˉx64ˉsummary(
        Status,
        Compilerˉnativeˉx64ˉempty(Input),
        0,
        22u32,
        0u32
    );
}

export fn Compilerˉnativeˉx64ˉrangeˉisˉvalid(
    Total: u32,
    Offset: u32,
    Length: u32
) -> bool {
    if Offset > Total { return false; }
    return Length <= Total - Offset;
}

export fn Compilerˉnativeˉx64ˉidentifierˉisˉvalid(
    Input: bytes,
    Offset: u32,
    Length: u32
) -> bool {
    let Total: u32 = Bytesˉlength(Input);
    if Length == 0u32 { return false; }
    if Length > 255u32 { return false; }
    if !Compilerˉnativeˉx64ˉrangeˉisˉvalid(Total, Offset, Length) {
        return false;
    }
    let End: u32 = Offset + Length;
    var Cursor: u32 = Offset;
    var Wordˉstart: bool = true;
    while Cursor < End {
        let Current: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(Input, Cursor));
        var Valid: bool = false;
        if Current >= 65u32 {
            if Current <= 90u32 { Valid = true; }
        }
        if Current >= 97u32 {
            if Current <= 122u32 { Valid = true; }
        }
        if Current == 95u32 { Valid = true; }
        if !Wordˉstart {
            if Current >= 48u32 {
                if Current <= 57u32 { Valid = true; }
            }
        }
        if Valid {
            Wordˉstart = false;
            Cursor = Cursor + 1u32;
        } else {
            if Wordˉstart { return false; }
            if Current != 203u32 { return false; }
            if Cursor + 1u32 >= End { return false; }
            if Bytesˉreadˉu8(Input, Cursor + 1u32) != 137u8 { return false; }
            Wordˉstart = true;
            Cursor = Cursor + 2u32;
        }
    }
    return !Wordˉstart;
}

export fn Compilerˉnativeˉx64ˉreadˉsection(
    Input: bytes,
    Cursor: u32,
    Kind: u8
) -> Compilerˉnativeˉx64ˉsection {
    let Total: u32 = Bytesˉlength(Input);
    if !Compilerˉnativeˉx64ˉrangeˉisˉvalid(Total, Cursor, 8u32) {
        return Compilerˉnativeˉx64ˉsection(false, 0u32, 0u32, 0u32);
    }
    if Bytesˉreadˉu8(Input, Cursor) != Kind {
        return Compilerˉnativeˉx64ˉsection(false, 0u32, 0u32, 0u32);
    }
    if Bytesˉreadˉu8(Input, Cursor + 1u32) != 0u8 {
        return Compilerˉnativeˉx64ˉsection(false, 0u32, 0u32, 0u32);
    }
    if Bytesˉreadˉu16ˉlittle(Input, Cursor + 2u32) != 0u32 {
        return Compilerˉnativeˉx64ˉsection(false, 0u32, 0u32, 0u32);
    }
    let Payloadˉlength: u32 = Bytesˉreadˉu32ˉlittle(Input, Cursor + 4u32);
    let Payloadˉoffset: u32 = Cursor + 8u32;
    if !Compilerˉnativeˉx64ˉrangeˉisˉvalid(
        Total,
        Payloadˉoffset,
        Payloadˉlength
    ) {
        return Compilerˉnativeˉx64ˉsection(false, 0u32, 0u32, 0u32);
    }
    return Compilerˉnativeˉx64ˉsection(
        true,
        Payloadˉoffset,
        Payloadˉlength,
        Payloadˉoffset + Payloadˉlength
    );
}

export fn Compilerˉnativeˉx64ˉinvalidˉstructure()
    -> Compilerˉnativeˉx64ˉstructure {
    return Compilerˉnativeˉx64ˉstructure(
        false,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32
    );
}

export fn Compilerˉnativeˉx64ˉreadˉstructure(Input: bytes)
    -> Compilerˉnativeˉx64ˉstructure {
    let Total: u32 = Bytesˉlength(Input);
    if Total < 12u32 { return Compilerˉnativeˉx64ˉinvalidˉstructure(); }
    if Bytesˉreadˉu8(Input, 0u32) != 87u8 {
        return Compilerˉnativeˉx64ˉinvalidˉstructure();
    }
    if Bytesˉreadˉu8(Input, 1u32) != 86u8 {
        return Compilerˉnativeˉx64ˉinvalidˉstructure();
    }
    if Bytesˉreadˉu8(Input, 2u32) != 66u8 {
        return Compilerˉnativeˉx64ˉinvalidˉstructure();
    }
    if Bytesˉreadˉu8(Input, 3u32) != 49u8 {
        return Compilerˉnativeˉx64ˉinvalidˉstructure();
    }
    if Bytesˉreadˉu16ˉlittle(Input, 4u32) != 1u32 {
        return Compilerˉnativeˉx64ˉinvalidˉstructure();
    }
    if Bytesˉreadˉu16ˉlittle(Input, 6u32) != 11u32 {
        return Compilerˉnativeˉx64ˉinvalidˉstructure();
    }
    if Bytesˉreadˉu32ˉlittle(Input, 8u32) != 7u32 {
        return Compilerˉnativeˉx64ˉinvalidˉstructure();
    }

    let Module: Compilerˉnativeˉx64ˉsection =
        Compilerˉnativeˉx64ˉreadˉsection(Input, 12u32, 1u8);
    if !Module.Valid { return Compilerˉnativeˉx64ˉinvalidˉstructure(); }
    let Capabilities: Compilerˉnativeˉx64ˉsection =
        Compilerˉnativeˉx64ˉreadˉsection(Input, Module.Nextˉoffset, 2u8);
    if !Capabilities.Valid { return Compilerˉnativeˉx64ˉinvalidˉstructure(); }
    let Data: Compilerˉnativeˉx64ˉsection =
        Compilerˉnativeˉx64ˉreadˉsection(Input, Capabilities.Nextˉoffset, 3u8);
    if !Data.Valid { return Compilerˉnativeˉx64ˉinvalidˉstructure(); }
    let Functions: Compilerˉnativeˉx64ˉsection =
        Compilerˉnativeˉx64ˉreadˉsection(Input, Data.Nextˉoffset, 4u8);
    if !Functions.Valid { return Compilerˉnativeˉx64ˉinvalidˉstructure(); }
    let Code: Compilerˉnativeˉx64ˉsection =
        Compilerˉnativeˉx64ˉreadˉsection(Input, Functions.Nextˉoffset, 5u8);
    if !Code.Valid { return Compilerˉnativeˉx64ˉinvalidˉstructure(); }
    let Exports: Compilerˉnativeˉx64ˉsection =
        Compilerˉnativeˉx64ˉreadˉsection(Input, Code.Nextˉoffset, 6u8);
    if !Exports.Valid { return Compilerˉnativeˉx64ˉinvalidˉstructure(); }
    let Types: Compilerˉnativeˉx64ˉsection =
        Compilerˉnativeˉx64ˉreadˉsection(Input, Exports.Nextˉoffset, 7u8);
    if !Types.Valid { return Compilerˉnativeˉx64ˉinvalidˉstructure(); }
    if Types.Nextˉoffset != Total {
        return Compilerˉnativeˉx64ˉinvalidˉstructure();
    }
    return Compilerˉnativeˉx64ˉstructure(
        true,
        Module.Payloadˉoffset,
        Module.Payloadˉlength,
        Capabilities.Payloadˉoffset,
        Capabilities.Payloadˉlength,
        Data.Payloadˉoffset,
        Data.Payloadˉlength,
        Functions.Payloadˉoffset,
        Functions.Payloadˉlength,
        Code.Payloadˉoffset,
        Code.Payloadˉlength,
        Exports.Payloadˉoffset,
        Exports.Payloadˉlength,
        Types.Payloadˉoffset,
        Types.Payloadˉlength
    );
}

export fn Compilerˉnativeˉx64ˉmainˉnameˉat(Input: bytes, Offset: u32) -> bool {
    if Bytesˉreadˉu8(Input, Offset) != 77u8 { return false; }
    if Bytesˉreadˉu8(Input, Offset + 1u32) != 97u8 { return false; }
    if Bytesˉreadˉu8(Input, Offset + 2u32) != 105u8 { return false; }
    return Bytesˉreadˉu8(Input, Offset + 3u32) == 110u8;
}

export fn Compilerˉnativeˉx64ˉmoduleˉisˉvalid(
    Input: bytes,
    Section: Compilerˉnativeˉx64ˉsection
) -> bool {
    if Section.Payloadˉlength < 6u32 { return false; }
    let Nameˉlength: u32 =
        Bytesˉreadˉu32ˉlittle(Input, Section.Payloadˉoffset + 1u32);
    if Nameˉlength != Section.Payloadˉlength - 6u32 { return false; }
    if !Compilerˉnativeˉx64ˉidentifierˉisˉvalid(
        Input,
        Section.Payloadˉoffset + 5u32,
        Nameˉlength
    ) { return false; }
    return Bytesˉreadˉu8(
        Input,
        Section.Payloadˉoffset + 5u32 + Nameˉlength
    ) == 0u8;
}

export fn Compilerˉnativeˉx64ˉinvalidˉfunction()
    -> Compilerˉnativeˉx64ˉfunction {
    return Compilerˉnativeˉx64ˉfunction(
        false,
        0u32,
        0u32,
        0u32,
        0u32,
        Textˉtoˉutf8(""),
        0u32,
        0u32
    );
}

export fn Compilerˉnativeˉx64ˉreadˉfunctionˉat(
    Input: bytes,
    Cursor: u32,
    Limit: u32,
    Requireˉmain: bool
) -> Compilerˉnativeˉx64ˉfunction {
    let Total: u32 = Bytesˉlength(Input);
    if Limit > Total { return Compilerˉnativeˉx64ˉinvalidˉfunction(); }
    if Cursor > Limit { return Compilerˉnativeˉx64ˉinvalidˉfunction(); }
    if Limit - Cursor < 25u32 {
        return Compilerˉnativeˉx64ˉinvalidˉfunction();
    }
    let Nameˉlength: u32 = Bytesˉreadˉu32ˉlittle(Input, Cursor);
    if Nameˉlength == 0u32 { return Compilerˉnativeˉx64ˉinvalidˉfunction(); }
    if Nameˉlength > 255u32 { return Compilerˉnativeˉx64ˉinvalidˉfunction(); }
    if Nameˉlength > Limit - Cursor - 25u32 {
        return Compilerˉnativeˉx64ˉinvalidˉfunction();
    }
    let Nameˉoffset: u32 = Cursor + 4u32;
    if !Compilerˉnativeˉx64ˉidentifierˉisˉvalid(
        Input,
        Nameˉoffset,
        Nameˉlength
    ) {
        return Compilerˉnativeˉx64ˉinvalidˉfunction();
    }
    if Requireˉmain {
        if Nameˉlength != 4u32 {
            return Compilerˉnativeˉx64ˉinvalidˉfunction();
        }
        if !Compilerˉnativeˉx64ˉmainˉnameˉat(Input, Nameˉoffset) {
            return Compilerˉnativeˉx64ˉinvalidˉfunction();
        }
    } else {
        if Nameˉlength == 4u32 {
            if Compilerˉnativeˉx64ˉmainˉnameˉat(Input, Nameˉoffset) {
                return Compilerˉnativeˉx64ˉinvalidˉfunction();
            }
        }
    }
    let Signature: u32 = Nameˉoffset + Nameˉlength;
    let Parameters: u32 = Bytesˉreadˉu32ˉlittle(Input, Signature);
    if Parameters > 4u32 {
        return Compilerˉnativeˉx64ˉinvalidˉfunction();
    }
    if Requireˉmain {
        if Parameters != 0u32 {
            return Compilerˉnativeˉx64ˉinvalidˉfunction();
        }
    }
    let Parameterˉtypesˉoffset: u32 = Signature + 4u32;
    if Parameters > Limit - Parameterˉtypesˉoffset - 17u32 {
        return Compilerˉnativeˉx64ˉinvalidˉfunction();
    }
    var Parameter: u32 = 0u32;
    while Parameter < Parameters {
        let Parameterˉtype: u8 = Bytesˉreadˉu8(
            Input,
            Parameterˉtypesˉoffset + Parameter
        );
        if Parameterˉtype != 1u8 {
            if Parameterˉtype != 2u8 {
                return Compilerˉnativeˉx64ˉinvalidˉfunction();
            }
        }
        Parameter = Parameter + 1u32;
    }
    let Returnˉtypeˉoffset: u32 = Parameterˉtypesˉoffset + Parameters;
    if Bytesˉreadˉu8(Input, Returnˉtypeˉoffset) != 1u8 {
        return Compilerˉnativeˉx64ˉinvalidˉfunction();
    }
    let Declaredˉlocals: u32 = Bytesˉreadˉu32ˉlittle(
        Input,
        Returnˉtypeˉoffset + 1u32
    );
    if Declaredˉlocals > 1024u32 {
        return Compilerˉnativeˉx64ˉinvalidˉfunction();
    }
    let Locals: u32 = Parameters + Declaredˉlocals;
    if Locals > 1024u32 {
        return Compilerˉnativeˉx64ˉinvalidˉfunction();
    }
    let Declaredˉtypesˉoffset: u32 = Returnˉtypeˉoffset + 5u32;
    if Declaredˉlocals > Limit - Declaredˉtypesˉoffset - 12u32 {
        return Compilerˉnativeˉx64ˉinvalidˉfunction();
    }
    var Local: u32 = 0u32;
    while Local < Declaredˉlocals {
        let Localˉtype: u8 = Bytesˉreadˉu8(Input, Declaredˉtypesˉoffset + Local);
        if Localˉtype != 1u8 {
            if Localˉtype != 2u8 {
                return Compilerˉnativeˉx64ˉinvalidˉfunction();
            }
        }
        Local = Local + 1u32;
    }
    let Metadata: u32 = Declaredˉtypesˉoffset + Declaredˉlocals;
    let Codeˉoffset: u32 = Bytesˉreadˉu32ˉlittle(Input, Metadata);
    let Codeˉlength: u32 = Bytesˉreadˉu32ˉlittle(Input, Metadata + 4u32);
    let Maximumˉstack: u32 = Bytesˉreadˉu32ˉlittle(Input, Metadata + 8u32);
    if Codeˉlength == 0u32 { return Compilerˉnativeˉx64ˉinvalidˉfunction(); }
    if Codeˉlength > 8192u32 { return Compilerˉnativeˉx64ˉinvalidˉfunction(); }
    if Maximumˉstack == 0u32 { return Compilerˉnativeˉx64ˉinvalidˉfunction(); }
    if Maximumˉstack > 1024u32 { return Compilerˉnativeˉx64ˉinvalidˉfunction(); }
    return Compilerˉnativeˉx64ˉfunction(
        true,
        Metadata + 12u32,
        Codeˉoffset,
        Parameters,
        Locals,
        Bytesˉconcat(
            Bytesˉslice(Input, Parameterˉtypesˉoffset, Parameters),
            Bytesˉslice(Input, Declaredˉtypesˉoffset, Declaredˉlocals)
        ),
        Codeˉlength,
        Maximumˉstack
    );
}

export fn Compilerˉnativeˉx64ˉexportˉisˉsupported(
    Input: bytes,
    Section: Compilerˉnativeˉx64ˉsection,
    Target: u32
) -> bool {
    if Section.Payloadˉlength != 17u32 { return false; }
    let Offset: u32 = Section.Payloadˉoffset;
    if Bytesˉreadˉu32ˉlittle(Input, Offset) != 1u32 { return false; }
    if Bytesˉreadˉu32ˉlittle(Input, Offset + 4u32) != 4u32 { return false; }
    if !Compilerˉnativeˉx64ˉmainˉnameˉat(Input, Offset + 8u32) {
        return false;
    }
    if Bytesˉreadˉu8(Input, Offset + 12u32) != 1u8 { return false; }
    return Bytesˉreadˉu32ˉlittle(Input, Offset + 13u32) == Target;
}

export fn Compilerˉnativeˉx64ˉemptyˉanalysis()
    -> Compilerˉnativeˉx64ˉanalysis {
    return Compilerˉnativeˉx64ˉanalysis(
        false,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32
    );
}

export fn Compilerˉnativeˉx64ˉanalyzeˉcode(
    Input: bytes,
    Section: Compilerˉnativeˉx64ˉsection,
    Function: Compilerˉnativeˉx64ˉfunction
) -> Compilerˉnativeˉx64ˉanalysis {
    if Section.Payloadˉlength != Function.Codeˉlength {
        return Compilerˉnativeˉx64ˉemptyˉanalysis();
    }
    var Stack: bytes = Compilerˉnativeˉx64ˉempty(Input);
    var Stackˉdepth: u32 = 0u32;
    var Maximumˉstack: u32 = 0u32;
    var Values: u32 = 0u32;
    var Instructions: u32 = 0u32;
    var Bodyˉbytes: u32 = 0u32;
    var Returnˉvalue: u32 = 0u32;
    var Returned: bool = false;
    var Cursor: u32 = 0u32;
    while Cursor < Section.Payloadˉlength {
        if Returned { return Compilerˉnativeˉx64ˉemptyˉanalysis(); }
        let Opcode: u8 = Bytesˉreadˉu8(Input, Section.Payloadˉoffset + Cursor);
        Instructions = Instructions + 1u32;
        if Instructions > 1024u32 {
            return Compilerˉnativeˉx64ˉemptyˉanalysis();
        }
        if Opcode == 1u8 {
            if Section.Payloadˉlength - Cursor < 5u32 {
                return Compilerˉnativeˉx64ˉemptyˉanalysis();
            }
            Stack = Bytesˉconcat(Stack, Bytesˉfromˉu32ˉlittle(Values));
            Stackˉdepth = Stackˉdepth + 1u32;
            Values = Values + 1u32;
            Bodyˉbytes = Bodyˉbytes + 22u32;
            Cursor = Cursor + 5u32;
        } else {
            if Opcode == 4u8 {
                if Section.Payloadˉlength - Cursor < 5u32 {
                    return Compilerˉnativeˉx64ˉemptyˉanalysis();
                }
                let Loadˉindex: u32 = Bytesˉreadˉu32ˉlittle(
                    Input,
                    Section.Payloadˉoffset + Cursor + 1u32
                );
                if Loadˉindex >= Function.Locals {
                    return Compilerˉnativeˉx64ˉemptyˉanalysis();
                }
                Stack = Bytesˉconcat(Stack, Bytesˉfromˉu32ˉlittle(Values));
                Stackˉdepth = Stackˉdepth + 1u32;
                Values = Values + 1u32;
                Bodyˉbytes = Bodyˉbytes + 24u32;
                Cursor = Cursor + 5u32;
            } else {
                if Opcode == 5u8 {
                    if Section.Payloadˉlength - Cursor < 5u32 {
                        return Compilerˉnativeˉx64ˉemptyˉanalysis();
                    }
                    let Storeˉindex: u32 = Bytesˉreadˉu32ˉlittle(
                        Input,
                        Section.Payloadˉoffset + Cursor + 1u32
                    );
                    if Storeˉindex >= Function.Locals {
                        return Compilerˉnativeˉx64ˉemptyˉanalysis();
                    }
                    if Stackˉdepth == 0u32 {
                        return Compilerˉnativeˉx64ˉemptyˉanalysis();
                    }
                    Stackˉdepth = Stackˉdepth - 1u32;
                    Stack = Bytesˉslice(Stack, 0u32, Stackˉdepth * 4u32);
                    Bodyˉbytes = Bodyˉbytes + 24u32;
                    Cursor = Cursor + 5u32;
                } else {
                    if Opcode == 16u8 {
                        if Stackˉdepth < 2u32 {
                            return Compilerˉnativeˉx64ˉemptyˉanalysis();
                        }
                        Stackˉdepth = Stackˉdepth - 2u32;
                        Stack = Bytesˉslice(Stack, 0u32, Stackˉdepth * 4u32);
                        Stack = Bytesˉconcat(Stack, Bytesˉfromˉu32ˉlittle(Values));
                        Stackˉdepth = Stackˉdepth + 1u32;
                        Values = Values + 1u32;
                        Bodyˉbytes = Bodyˉbytes + 39u32;
                        Cursor = Cursor + 1u32;
                    } else {
                        if Opcode == 17u8 {
                            if Stackˉdepth < 2u32 {
                                return Compilerˉnativeˉx64ˉemptyˉanalysis();
                            }
                            Stackˉdepth = Stackˉdepth - 2u32;
                            Stack = Bytesˉslice(Stack, 0u32, Stackˉdepth * 4u32);
                            Stack = Bytesˉconcat(Stack, Bytesˉfromˉu32ˉlittle(Values));
                            Stackˉdepth = Stackˉdepth + 1u32;
                            Values = Values + 1u32;
                            Bodyˉbytes = Bodyˉbytes + 39u32;
                            Cursor = Cursor + 1u32;
                        } else {
                            if Opcode == 18u8 {
                                if Stackˉdepth < 2u32 {
                                    return Compilerˉnativeˉx64ˉemptyˉanalysis();
                                }
                                Stackˉdepth = Stackˉdepth - 2u32;
                                Stack = Bytesˉslice(Stack, 0u32, Stackˉdepth * 4u32);
                                Stack = Bytesˉconcat(Stack, Bytesˉfromˉu32ˉlittle(Values));
                                Stackˉdepth = Stackˉdepth + 1u32;
                                Values = Values + 1u32;
                                Bodyˉbytes = Bodyˉbytes + 40u32;
                                Cursor = Cursor + 1u32;
                            } else {
                                if Opcode == 19u8 {
                                    if Stackˉdepth == 0u32 {
                                        return Compilerˉnativeˉx64ˉemptyˉanalysis();
                                    }
                                    Stackˉdepth = Stackˉdepth - 1u32;
                                    Stack = Bytesˉslice(Stack, 0u32, Stackˉdepth * 4u32);
                                    Stack = Bytesˉconcat(
                                        Stack,
                                        Bytesˉfromˉu32ˉlittle(Values)
                                    );
                                    Stackˉdepth = Stackˉdepth + 1u32;
                                    Values = Values + 1u32;
                                    Bodyˉbytes = Bodyˉbytes + 32u32;
                                    Cursor = Cursor + 1u32;
                                } else {
                                    if Opcode != 81u8 {
                                        return Compilerˉnativeˉx64ˉemptyˉanalysis();
                                    }
                                    if Stackˉdepth != 1u32 {
                                        return Compilerˉnativeˉx64ˉemptyˉanalysis();
                                    }
                                    Returnˉvalue = Bytesˉreadˉu32ˉlittle(Stack, 0u32);
                                    Stackˉdepth = 0u32;
                                    Stack = Compilerˉnativeˉx64ˉempty(Input);
                                    Bodyˉbytes = Bodyˉbytes + 30u32;
                                    Cursor = Cursor + 1u32;
                                    Returned = true;
                                }
                            }
                        }
                    }
                }
            }
        }
        if Stackˉdepth > Maximumˉstack { Maximumˉstack = Stackˉdepth; }
        if Values > 2048u32 - Function.Locals {
            return Compilerˉnativeˉx64ˉemptyˉanalysis();
        }
    }
    if !Returned { return Compilerˉnativeˉx64ˉemptyˉanalysis(); }
    if Maximumˉstack != Function.Maximumˉstack {
        return Compilerˉnativeˉx64ˉemptyˉanalysis();
    }
    return Compilerˉnativeˉx64ˉanalysis(
        true,
        Values,
        Instructions,
        Bodyˉbytes,
        Returnˉvalue,
        Maximumˉstack
    );
}

export fn Compilerˉnativeˉx64ˉemptyˉcontrolˉanalysis(Input: bytes)
    -> Compilerˉnativeˉx64ˉcontrolˉanalysis {
    return Compilerˉnativeˉx64ˉcontrolˉanalysis(
        false,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        Compilerˉnativeˉx64ˉempty(Input)
    );
}

export fn Compilerˉnativeˉx64ˉinvalidˉblock()
    -> Compilerˉnativeˉx64ˉblockˉanalysis {
    return Compilerˉnativeˉx64ˉblockˉanalysis(
        false,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u8,
        0u32
    );
}

export fn Compilerˉnativeˉx64ˉreplaceˉbyte(
    Input: bytes,
    Offset: u32,
    Value: u8
) -> bytes {
    let Length: u32 = Bytesˉlength(Input);
    return Bytesˉconcat(
        Bytesˉconcat(
            Bytesˉslice(Input, 0u32, Offset),
            Bytesˉfromˉu8(Value)
        ),
        Bytesˉslice(Input, Offset + 1u32, Length - Offset - 1u32)
    );
}

export fn Compilerˉnativeˉx64ˉzeroˉmap(Input: bytes, Length: u32) -> bytes {
    var Result: bytes = Compilerˉnativeˉx64ˉempty(Input);
    var Cursor: u32 = 0u32;
    while Cursor < Length {
        Result = Bytesˉconcat(Result, Bytesˉfromˉu8(0u8));
        Cursor = Cursor + 1u32;
    }
    return Result;
}

export fn Compilerˉnativeˉx64ˉisˉi32ˉcomparison(Opcode: u8) -> bool {
    let Numeric: u32 = U32ˉfromˉu8(Opcode);
    if Numeric < 32u32 { return false; }
    return Numeric <= 37u32;
}

export fn Compilerˉnativeˉx64ˉisˉboolˉcomparison(Opcode: u8) -> bool {
    let Numeric: u32 = U32ˉfromˉu8(Opcode);
    if Numeric < 38u32 { return false; }
    return Numeric <= 39u32;
}

export fn Compilerˉnativeˉx64ˉinstructionˉsize(Opcode: u8) -> u32 {
    let Numeric: u32 = U32ˉfromˉu8(Opcode);
    if Opcode == 1u8 { return 5u32; }
    if Opcode == 2u8 { return 2u32; }
    if Opcode == 4u8 { return 5u32; }
    if Opcode == 5u8 { return 5u32; }
    if Numeric >= 16u32 {
        if Numeric <= 19u32 { return 1u32; }
    }
    if Compilerˉnativeˉx64ˉisˉi32ˉcomparison(Opcode) { return 1u32; }
    if Compilerˉnativeˉx64ˉisˉboolˉcomparison(Opcode) { return 1u32; }
    if Opcode == 40u8 { return 1u32; }
    if Opcode == 48u8 { return 5u32; }
    if Opcode == 49u8 { return 5u32; }
    if Opcode == 64u8 { return 5u32; }
    if Opcode == 81u8 { return 1u32; }
    return 0u32;
}

export fn Compilerˉnativeˉx64ˉscalarˉargumentˉbytes(
    Parameters: u32
) -> u32 {
    if Parameters <= 2u32 { return Parameters * 8u32; }
    return 16u32 + (Parameters - 2u32) * 7u32;
}

export fn Compilerˉnativeˉx64ˉnextˉleader(
    Leaders: bytes,
    Start: u32,
    Length: u32
) -> u32 {
    var Cursor: u32 = Start + 1u32;
    while Cursor < Length {
        if Bytesˉreadˉu8(Leaders, Cursor) == 1u8 { return Cursor; }
        Cursor = Cursor + 1u32;
    }
    return Length;
}

export fn Compilerˉnativeˉx64ˉanalyzeˉblock(
    Input: bytes,
    Section: Compilerˉnativeˉx64ˉsection,
    Function: Compilerˉnativeˉx64ˉfunction,
    Leaders: bytes,
    Instructions: bytes,
    Start: u32,
    Isˉmain: bool,
    Allowˉcall: bool,
    Callˉparameters: u32,
    Callˉparameterˉtypes: bytes
) -> Compilerˉnativeˉx64ˉblockˉanalysis {
    let Length: u32 = Section.Payloadˉlength;
    let End: u32 = Compilerˉnativeˉx64ˉnextˉleader(Leaders, Start, Length);
    var Stack: bytes = Compilerˉnativeˉx64ˉempty(Input);
    var Depth: u32 = 0u32;
    var Maximum: u32 = 0u32;
    var I32ˉvalues: u32 = 0u32;
    var Boolˉvalues: u32 = 0u32;
    var Bodyˉbytes: u32 = 0u32;
    var Terminator: u8 = 0u8;
    var Target: u32 = 0u32;
    var Cursor: u32 = Start;
    while Cursor < End {
        let Opcode: u8 = Bytesˉreadˉu8(Input, Section.Payloadˉoffset + Cursor);
        let Numericˉopcode: u32 = U32ˉfromˉu8(Opcode);
        let Size: u32 = Compilerˉnativeˉx64ˉinstructionˉsize(Opcode);
        let Next: u32 = Cursor + Size;
        if Next > End { return Compilerˉnativeˉx64ˉinvalidˉblock(); }
        if Opcode == 1u8 {
            Stack = Bytesˉconcat(Stack, Bytesˉfromˉu8(1u8));
            Depth = Depth + 1u32;
            I32ˉvalues = I32ˉvalues + 1u32;
            Bodyˉbytes = Bodyˉbytes + 22u32;
        } else {
            if Opcode == 2u8 {
                Stack = Bytesˉconcat(Stack, Bytesˉfromˉu8(2u8));
                Depth = Depth + 1u32;
                Boolˉvalues = Boolˉvalues + 1u32;
                Bodyˉbytes = Bodyˉbytes + 22u32;
            } else {
                if Opcode == 4u8 {
                    let Loadˉindex: u32 = Bytesˉreadˉu32ˉlittle(
                        Input,
                        Section.Payloadˉoffset + Cursor + 1u32
                    );
                    if Loadˉindex >= Function.Locals {
                        return Compilerˉnativeˉx64ˉinvalidˉblock();
                    }
                    let Loadˉtype: u8 = Bytesˉreadˉu8(
                        Function.Localˉtypes,
                        Loadˉindex
                    );
                    Stack = Bytesˉconcat(Stack, Bytesˉfromˉu8(Loadˉtype));
                    Depth = Depth + 1u32;
                    if Loadˉtype == 1u8 {
                        I32ˉvalues = I32ˉvalues + 1u32;
                    } else {
                        Boolˉvalues = Boolˉvalues + 1u32;
                    }
                    Bodyˉbytes = Bodyˉbytes + 24u32;
                } else {
                    if Opcode == 5u8 {
                        let Storeˉindex: u32 = Bytesˉreadˉu32ˉlittle(
                            Input,
                            Section.Payloadˉoffset + Cursor + 1u32
                        );
                        if Storeˉindex >= Function.Locals {
                            return Compilerˉnativeˉx64ˉinvalidˉblock();
                        }
                        if Depth == 0u32 {
                            return Compilerˉnativeˉx64ˉinvalidˉblock();
                        }
                        let Storeˉtype: u8 = Bytesˉreadˉu8(
                            Function.Localˉtypes,
                            Storeˉindex
                        );
                        if Bytesˉreadˉu8(Stack, Depth - 1u32) != Storeˉtype {
                            return Compilerˉnativeˉx64ˉinvalidˉblock();
                        }
                        Depth = Depth - 1u32;
                        Stack = Bytesˉslice(Stack, 0u32, Depth);
                        Bodyˉbytes = Bodyˉbytes + 24u32;
                    } else {
                        if Numericˉopcode >= 16u32 {
                            if Numericˉopcode <= 18u32 {
                                if Depth < 2u32 {
                                    return Compilerˉnativeˉx64ˉinvalidˉblock();
                                }
                                if Bytesˉreadˉu8(Stack, Depth - 1u32) != 1u8 {
                                    return Compilerˉnativeˉx64ˉinvalidˉblock();
                                }
                                if Bytesˉreadˉu8(Stack, Depth - 2u32) != 1u8 {
                                    return Compilerˉnativeˉx64ˉinvalidˉblock();
                                }
                                Depth = Depth - 2u32;
                                Stack = Bytesˉslice(Stack, 0u32, Depth);
                                Stack = Bytesˉconcat(Stack, Bytesˉfromˉu8(1u8));
                                Depth = Depth + 1u32;
                                I32ˉvalues = I32ˉvalues + 1u32;
                                if Opcode == 18u8 {
                                    Bodyˉbytes = Bodyˉbytes + 40u32;
                                } else {
                                    Bodyˉbytes = Bodyˉbytes + 39u32;
                                }
                            } else {
                                if Opcode == 19u8 {
                                    if Depth == 0u32 {
                                        return Compilerˉnativeˉx64ˉinvalidˉblock();
                                    }
                                    if Bytesˉreadˉu8(Stack, Depth - 1u32) != 1u8 {
                                        return Compilerˉnativeˉx64ˉinvalidˉblock();
                                    }
                                    I32ˉvalues = I32ˉvalues + 1u32;
                                    Bodyˉbytes = Bodyˉbytes + 32u32;
                                } else {
                                    if Compilerˉnativeˉx64ˉisˉi32ˉcomparison(Opcode) {
                                        if Depth < 2u32 {
                                            return Compilerˉnativeˉx64ˉinvalidˉblock();
                                        }
                                        if Bytesˉreadˉu8(Stack, Depth - 1u32) != 1u8 {
                                            return Compilerˉnativeˉx64ˉinvalidˉblock();
                                        }
                                        if Bytesˉreadˉu8(Stack, Depth - 2u32) != 1u8 {
                                            return Compilerˉnativeˉx64ˉinvalidˉblock();
                                        }
                                        Depth = Depth - 2u32;
                                        Stack = Bytesˉslice(Stack, 0u32, Depth);
                                        Stack = Bytesˉconcat(Stack, Bytesˉfromˉu8(2u8));
                                        Depth = Depth + 1u32;
                                        Boolˉvalues = Boolˉvalues + 1u32;
                                        Bodyˉbytes = Bodyˉbytes + 39u32;
                                    } else {
                                        if Compilerˉnativeˉx64ˉisˉboolˉcomparison(Opcode) {
                                            if Depth < 2u32 {
                                                return Compilerˉnativeˉx64ˉinvalidˉblock();
                                            }
                                            if Bytesˉreadˉu8(Stack, Depth - 1u32) != 2u8 {
                                                return Compilerˉnativeˉx64ˉinvalidˉblock();
                                            }
                                            if Bytesˉreadˉu8(Stack, Depth - 2u32) != 2u8 {
                                                return Compilerˉnativeˉx64ˉinvalidˉblock();
                                            }
                                            Depth = Depth - 2u32;
                                            Stack = Bytesˉslice(Stack, 0u32, Depth);
                                            Stack = Bytesˉconcat(Stack, Bytesˉfromˉu8(2u8));
                                            Depth = Depth + 1u32;
                                            Boolˉvalues = Boolˉvalues + 1u32;
                                            Bodyˉbytes = Bodyˉbytes + 39u32;
                                        } else {
                                            if Opcode == 40u8 {
                                                if Depth == 0u32 {
                                                    return Compilerˉnativeˉx64ˉinvalidˉblock();
                                                }
                                                if Bytesˉreadˉu8(Stack, Depth - 1u32) != 2u8 {
                                                    return Compilerˉnativeˉx64ˉinvalidˉblock();
                                                }
                                                Boolˉvalues = Boolˉvalues + 1u32;
                                                Bodyˉbytes = Bodyˉbytes + 27u32;
                                            } else {
                                                if Opcode == 64u8 {
                                                    if !Allowˉcall {
                                                        return Compilerˉnativeˉx64ˉinvalidˉblock();
                                                    }
                                                    if Bytesˉreadˉu32ˉlittle(
                                                        Input,
                                                        Section.Payloadˉoffset + Cursor + 1u32
                                                    ) != 0u32 {
                                                        return Compilerˉnativeˉx64ˉinvalidˉblock();
                                                    }
                                                    if Depth < Callˉparameters {
                                                        return Compilerˉnativeˉx64ˉinvalidˉblock();
                                                    }
                                                    var Argument: u32 = 0u32;
                                                    while Argument < Callˉparameters {
                                                        if Bytesˉreadˉu8(
                                                            Stack,
                                                            Depth - Callˉparameters + Argument
                                                        ) != Bytesˉreadˉu8(
                                                            Callˉparameterˉtypes,
                                                            Argument
                                                        ) {
                                                            return Compilerˉnativeˉx64ˉinvalidˉblock();
                                                        }
                                                        Argument = Argument + 1u32;
                                                    }
                                                    Depth = Depth - Callˉparameters;
                                                    Stack = Bytesˉslice(Stack, 0u32, Depth);
                                                    Stack = Bytesˉconcat(
                                                        Stack,
                                                        Bytesˉfromˉu8(1u8)
                                                    );
                                                    Depth = Depth + 1u32;
                                                    I32ˉvalues = I32ˉvalues + 1u32;
                                                    Bodyˉbytes = Bodyˉbytes + 38u32 +
                                                        Compilerˉnativeˉx64ˉscalarˉargumentˉbytes(
                                                            Callˉparameters
                                                        );
                                                } else {
                                                if Opcode == 48u8 {
                                                    if Next != End {
                                                        return Compilerˉnativeˉx64ˉinvalidˉblock();
                                                    }
                                                    if Depth != 0u32 {
                                                        return Compilerˉnativeˉx64ˉinvalidˉblock();
                                                    }
                                                    let Jumpˉtarget: u32 = Bytesˉreadˉu32ˉlittle(
                                                        Input,
                                                        Section.Payloadˉoffset + Cursor + 1u32
                                                    );
                                                    if Bytesˉreadˉu8(Instructions, Jumpˉtarget) != 1u8 {
                                                        return Compilerˉnativeˉx64ˉinvalidˉblock();
                                                    }
                                                    Terminator = 1u8;
                                                    Target = Jumpˉtarget;
                                                    Bodyˉbytes = Bodyˉbytes + 15u32;
                                                } else {
                                                    if Opcode == 49u8 {
                                                        if Next != End {
                                                            return Compilerˉnativeˉx64ˉinvalidˉblock();
                                                        }
                                                        if Depth != 1u32 {
                                                            return Compilerˉnativeˉx64ˉinvalidˉblock();
                                                        }
                                                        if Bytesˉreadˉu8(Stack, 0u32) != 2u8 {
                                                            return Compilerˉnativeˉx64ˉinvalidˉblock();
                                                        }
                                                        let Branchˉtarget: u32 = Bytesˉreadˉu32ˉlittle(
                                                            Input,
                                                            Section.Payloadˉoffset + Cursor + 1u32
                                                        );
                                                        if Bytesˉreadˉu8(Instructions, Branchˉtarget) != 1u8 {
                                                            return Compilerˉnativeˉx64ˉinvalidˉblock();
                                                        }
                                                        Depth = 0u32;
                                                        Stack = Compilerˉnativeˉx64ˉempty(Input);
                                                        Terminator = 2u8;
                                                        Target = Branchˉtarget;
                                                        Bodyˉbytes = Bodyˉbytes + 30u32;
                                                    } else {
                                                        if Next != End {
                                                            return Compilerˉnativeˉx64ˉinvalidˉblock();
                                                        }
                                                        if Depth != 1u32 {
                                                            return Compilerˉnativeˉx64ˉinvalidˉblock();
                                                        }
                                                        if Bytesˉreadˉu8(Stack, 0u32) != 1u8 {
                                                            return Compilerˉnativeˉx64ˉinvalidˉblock();
                                                        }
                                                        Depth = 0u32;
                                                        Stack = Compilerˉnativeˉx64ˉempty(Input);
                                                        Terminator = 3u8;
                                                        if Isˉmain {
                                                            Bodyˉbytes = Bodyˉbytes + 30u32;
                                                        } else {
                                                            Bodyˉbytes = Bodyˉbytes + 28u32;
                                                        }
                                                    }
                                                }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        if Depth > Maximum { Maximum = Depth; }
        Cursor = Next;
    }
    if Terminator == 0u8 {
        if Depth != 0u32 { return Compilerˉnativeˉx64ˉinvalidˉblock(); }
        if End == Length { return Compilerˉnativeˉx64ˉinvalidˉblock(); }
    }
    return Compilerˉnativeˉx64ˉblockˉanalysis(
        true,
        End,
        I32ˉvalues,
        Boolˉvalues,
        Maximum,
        Bodyˉbytes,
        Terminator,
        Target
    );
}

export fn Compilerˉnativeˉx64ˉanalyzeˉcontrolˉcode(
    Input: bytes,
    Section: Compilerˉnativeˉx64ˉsection,
    Function: Compilerˉnativeˉx64ˉfunction,
    Isˉmain: bool,
    Allowˉcall: bool,
    Callˉparameters: u32,
    Callˉparameterˉtypes: bytes
) -> Compilerˉnativeˉx64ˉcontrolˉanalysis {
    if Section.Payloadˉlength != Function.Codeˉlength {
        return Compilerˉnativeˉx64ˉemptyˉcontrolˉanalysis(Input);
    }
    let Length: u32 = Section.Payloadˉlength;
    var Instructionsˉmap: bytes = Compilerˉnativeˉx64ˉzeroˉmap(Input, Length);
    var Leaders: bytes = Compilerˉnativeˉx64ˉzeroˉmap(Input, Length);
    Leaders = Compilerˉnativeˉx64ˉreplaceˉbyte(Leaders, 0u32, 1u8);
    var Instructionˉcount: u32 = 0u32;
    var Cursor: u32 = 0u32;
    while Cursor < Length {
        let Opcode: u8 = Bytesˉreadˉu8(Input, Section.Payloadˉoffset + Cursor);
        let Size: u32 = Compilerˉnativeˉx64ˉinstructionˉsize(Opcode);
        if Size == 0u32 {
            return Compilerˉnativeˉx64ˉemptyˉcontrolˉanalysis(Input);
        }
        if Size > Length - Cursor {
            return Compilerˉnativeˉx64ˉemptyˉcontrolˉanalysis(Input);
        }
        if Opcode == 2u8 {
            if U32ˉfromˉu8(
                Bytesˉreadˉu8(Input, Section.Payloadˉoffset + Cursor + 1u32)
            ) > 1u32 {
                return Compilerˉnativeˉx64ˉemptyˉcontrolˉanalysis(Input);
            }
        }
        Instructionˉcount = Instructionˉcount + 1u32;
        if Instructionˉcount > 1024u32 {
            return Compilerˉnativeˉx64ˉemptyˉcontrolˉanalysis(Input);
        }
        Instructionsˉmap = Compilerˉnativeˉx64ˉreplaceˉbyte(
            Instructionsˉmap,
            Cursor,
            1u8
        );
        let Next: u32 = Cursor + Size;
        if Opcode == 48u8 {
            let Jumpˉtarget: u32 = Bytesˉreadˉu32ˉlittle(
                Input,
                Section.Payloadˉoffset + Cursor + 1u32
            );
            if Jumpˉtarget >= Length {
                return Compilerˉnativeˉx64ˉemptyˉcontrolˉanalysis(Input);
            }
            Leaders = Compilerˉnativeˉx64ˉreplaceˉbyte(
                Leaders,
                Jumpˉtarget,
                1u8
            );
        }
        if Opcode == 49u8 {
            let Branchˉtarget: u32 = Bytesˉreadˉu32ˉlittle(
                Input,
                Section.Payloadˉoffset + Cursor + 1u32
            );
            if Branchˉtarget >= Length {
                return Compilerˉnativeˉx64ˉemptyˉcontrolˉanalysis(Input);
            }
            if Next >= Length {
                return Compilerˉnativeˉx64ˉemptyˉcontrolˉanalysis(Input);
            }
            Leaders = Compilerˉnativeˉx64ˉreplaceˉbyte(
                Leaders,
                Branchˉtarget,
                1u8
            );
            Leaders = Compilerˉnativeˉx64ˉreplaceˉbyte(Leaders, Next, 1u8);
        }
        Cursor = Next;
    }

    var Blocks: u32 = 0u32;
    Cursor = 0u32;
    while Cursor < Length {
        if Bytesˉreadˉu8(Leaders, Cursor) == 1u8 {
            if Bytesˉreadˉu8(Instructionsˉmap, Cursor) != 1u8 {
                return Compilerˉnativeˉx64ˉemptyˉcontrolˉanalysis(Input);
            }
            Blocks = Blocks + 1u32;
        }
        Cursor = Cursor + 1u32;
    }

    var I32ˉslots: u32 = 0u32;
    var Boolˉslots: u32 = 0u32;
    var Maximumˉstack: u32 = 0u32;
    var Bodyˉbytes: u32 = 0u32;
    Cursor = 0u32;
    while Cursor < Length {
        if Bytesˉreadˉu8(Leaders, Cursor) != 1u8 {
            return Compilerˉnativeˉx64ˉemptyˉcontrolˉanalysis(Input);
        }
        let Block: Compilerˉnativeˉx64ˉblockˉanalysis =
            Compilerˉnativeˉx64ˉanalyzeˉblock(
                Input,
                Section,
                Function,
                Leaders,
                Instructionsˉmap,
                Cursor,
                Isˉmain,
                Allowˉcall,
                Callˉparameters,
                Callˉparameterˉtypes
            );
        if !Block.Valid {
            return Compilerˉnativeˉx64ˉemptyˉcontrolˉanalysis(Input);
        }
        if Block.I32ˉvalues > I32ˉslots { I32ˉslots = Block.I32ˉvalues; }
        if Block.Boolˉvalues > Boolˉslots { Boolˉslots = Block.Boolˉvalues; }
        if Block.Maximumˉstack > Maximumˉstack {
            Maximumˉstack = Block.Maximumˉstack;
        }
        Bodyˉbytes = Bodyˉbytes + Block.Bodyˉbytes;
        Cursor = Block.Next;
    }

    var Reachable: bytes = Compilerˉnativeˉx64ˉzeroˉmap(Input, Length);
    Reachable = Compilerˉnativeˉx64ˉreplaceˉbyte(Reachable, 0u32, 1u8);
    var Reachˉiteration: u32 = 0u32;
    while Reachˉiteration < Blocks {
        Cursor = 0u32;
        while Cursor < Length {
            let Reachˉblock: Compilerˉnativeˉx64ˉblockˉanalysis =
                Compilerˉnativeˉx64ˉanalyzeˉblock(
                    Input,
                    Section,
                    Function,
                    Leaders,
                    Instructionsˉmap,
                    Cursor,
                    Isˉmain,
                    Allowˉcall,
                    Callˉparameters,
                    Callˉparameterˉtypes
                );
            if Bytesˉreadˉu8(Reachable, Cursor) == 1u8 {
                if Reachˉblock.Terminator == 0u8 {
                    Reachable = Compilerˉnativeˉx64ˉreplaceˉbyte(
                        Reachable,
                        Reachˉblock.Next,
                        1u8
                    );
                }
                if Reachˉblock.Terminator == 1u8 {
                    Reachable = Compilerˉnativeˉx64ˉreplaceˉbyte(
                        Reachable,
                        Reachˉblock.Target,
                        1u8
                    );
                }
                if Reachˉblock.Terminator == 2u8 {
                    Reachable = Compilerˉnativeˉx64ˉreplaceˉbyte(
                        Reachable,
                        Reachˉblock.Next,
                        1u8
                    );
                    Reachable = Compilerˉnativeˉx64ˉreplaceˉbyte(
                        Reachable,
                        Reachˉblock.Target,
                        1u8
                    );
                }
            }
            Cursor = Reachˉblock.Next;
        }
        Reachˉiteration = Reachˉiteration + 1u32;
    }
    Cursor = 0u32;
    while Cursor < Length {
        if Bytesˉreadˉu8(Leaders, Cursor) == 1u8 {
            if Bytesˉreadˉu8(Reachable, Cursor) != 1u8 {
                return Compilerˉnativeˉx64ˉemptyˉcontrolˉanalysis(Input);
            }
        }
        Cursor = Cursor + 1u32;
    }
    if Maximumˉstack != Function.Maximumˉstack {
        return Compilerˉnativeˉx64ˉemptyˉcontrolˉanalysis(Input);
    }
    if Function.Locals + I32ˉslots + Boolˉslots > 2048u32 {
        return Compilerˉnativeˉx64ˉemptyˉcontrolˉanalysis(Input);
    }
    return Compilerˉnativeˉx64ˉcontrolˉanalysis(
        true,
        I32ˉslots,
        Boolˉslots,
        Blocks,
        Instructionˉcount,
        Bodyˉbytes,
        Maximumˉstack,
        Leaders
    );
}

export fn Compilerˉnativeˉx64ˉappendˉi32(Result: bytes, Value: i32) -> bytes {
    return Bytesˉconcat(Result, Bytesˉfromˉi32ˉlittle(Value));
}

export fn Compilerˉnativeˉx64ˉappendˉbyte(Result: bytes, Value: u8) -> bytes {
    return Bytesˉconcat(Result, Bytesˉfromˉu8(Value));
}

export fn Compilerˉnativeˉx64ˉappendˉu32(Result: bytes, Value: u32) -> bytes {
    return Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Value));
}

export fn Compilerˉnativeˉx64ˉemitˉframe(
    Result: bytes,
    Subtract: bool,
    Frameˉbytes: u32
) -> bytes {
    var Output: bytes = Compilerˉnativeˉx64ˉappendˉbyte(Result, 72u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 129u8);
    if Subtract {
        Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 236u8);
    } else {
        Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 196u8);
    }
    return Compilerˉnativeˉx64ˉappendˉu32(Output, Frameˉbytes);
}

export fn Compilerˉnativeˉx64ˉemitˉloadˉeax(
    Result: bytes,
    Offset: u32
) -> bytes {
    var Output: bytes = Compilerˉnativeˉx64ˉappendˉbyte(Result, 139u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 132u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 36u8);
    return Compilerˉnativeˉx64ˉappendˉu32(Output, Offset);
}

export fn Compilerˉnativeˉx64ˉemitˉloadˉecx(
    Result: bytes,
    Offset: u32
) -> bytes {
    var Output: bytes = Compilerˉnativeˉx64ˉappendˉbyte(Result, 139u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 140u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 36u8);
    return Compilerˉnativeˉx64ˉappendˉu32(Output, Offset);
}

export fn Compilerˉnativeˉx64ˉemitˉstoreˉeax(
    Result: bytes,
    Offset: u32
) -> bytes {
    var Output: bytes = Compilerˉnativeˉx64ˉappendˉbyte(Result, 137u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 132u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 36u8);
    return Compilerˉnativeˉx64ˉappendˉu32(Output, Offset);
}

export fn Compilerˉnativeˉx64ˉemitˉloadˉargument(
    Result: bytes,
    Argument: u32,
    Offset: u32
) -> bytes {
    var Output: bytes = Result;
    if Argument < 2u32 {
        Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 68u8);
    }
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 139u8);
    if Argument == 0u32 {
        Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 132u8);
    }
    if Argument == 1u32 {
        Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 140u8);
    }
    if Argument == 2u32 {
        Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 140u8);
    }
    if Argument == 3u32 {
        Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 148u8);
    }
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 36u8);
    return Compilerˉnativeˉx64ˉappendˉu32(Output, Offset);
}

export fn Compilerˉnativeˉx64ˉemitˉstoreˉargument(
    Result: bytes,
    Argument: u32,
    Offset: u32
) -> bytes {
    var Output: bytes = Result;
    if Argument < 2u32 {
        Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 68u8);
    }
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 137u8);
    if Argument == 0u32 {
        Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 132u8);
    }
    if Argument == 1u32 {
        Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 140u8);
    }
    if Argument == 2u32 {
        Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 140u8);
    }
    if Argument == 3u32 {
        Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 148u8);
    }
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 36u8);
    return Compilerˉnativeˉx64ˉappendˉu32(Output, Offset);
}

export fn Compilerˉnativeˉx64ˉemitˉrestore(Result: bytes) -> bytes {
    var Output: bytes = Compilerˉnativeˉx64ˉappendˉbyte(Result, 73u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 255u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 194u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 65u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 95u8);
    return Compilerˉnativeˉx64ˉappendˉbyte(Output, 195u8);
}

export fn Compilerˉnativeˉx64ˉemitˉrestoreˉfor(
    Result: bytes,
    Restoreˉcontext: bool
) -> bytes {
    var Output: bytes = Compilerˉnativeˉx64ˉappendˉbyte(Result, 73u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 255u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 194u8);
    if Restoreˉcontext {
        Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 65u8);
        Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 95u8);
    }
    return Compilerˉnativeˉx64ˉappendˉbyte(Output, 195u8);
}

export fn Compilerˉnativeˉx64ˉemitˉcharge(
    Result: bytes,
    Target: u32
) -> bytes {
    var Output: bytes = Compilerˉnativeˉx64ˉappendˉbyte(Result, 73u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 131u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 235u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 1u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 15u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 130u8);
    return Compilerˉnativeˉx64ˉappendˉu32(
        Output,
        Target - Bytesˉlength(Output) - 4u32
    );
}

export fn Compilerˉnativeˉx64ˉemitˉoverflowˉbranch(
    Result: bytes,
    Target: u32
) -> bytes {
    var Output: bytes = Compilerˉnativeˉx64ˉappendˉbyte(Result, 15u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 128u8);
    return Compilerˉnativeˉx64ˉappendˉu32(
        Output,
        Target - Bytesˉlength(Output) - 4u32
    );
}

export fn Compilerˉnativeˉx64ˉemitˉstatus(
    Result: bytes,
    Frameˉbytes: u32,
    Statusˉhigh: u32
) -> bytes {
    var Output: bytes = Compilerˉnativeˉx64ˉemitˉframe(
        Result,
        false,
        Frameˉbytes
    );
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 73u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 255u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 194u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 72u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 184u8);
    Output = Compilerˉnativeˉx64ˉappendˉu32(Output, 0u32);
    Output = Compilerˉnativeˉx64ˉappendˉu32(Output, Statusˉhigh);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 65u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 95u8);
    return Compilerˉnativeˉx64ˉappendˉbyte(Output, 195u8);
}

export fn Compilerˉnativeˉx64ˉemitˉstatusˉfor(
    Result: bytes,
    Frameˉbytes: u32,
    Statusˉhigh: u32,
    Restoreˉcontext: bool
) -> bytes {
    var Output: bytes = Compilerˉnativeˉx64ˉemitˉframe(
        Result,
        false,
        Frameˉbytes
    );
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 73u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 255u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 194u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 72u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 184u8);
    Output = Compilerˉnativeˉx64ˉappendˉu32(Output, 0u32);
    Output = Compilerˉnativeˉx64ˉappendˉu32(Output, Statusˉhigh);
    if Restoreˉcontext {
        Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 65u8);
        Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 95u8);
    }
    return Compilerˉnativeˉx64ˉappendˉbyte(Output, 195u8);
}

export fn Compilerˉnativeˉx64ˉemitˉcode(
    Input: bytes,
    Section: Compilerˉnativeˉx64ˉsection,
    Function: Compilerˉnativeˉx64ˉfunction,
    Analysis: Compilerˉnativeˉx64ˉanalysis
) -> bytes {
    let Slots: u32 = Function.Locals + Analysis.Values;
    let Frameˉbytes: u32 = Slots * 16u32;
    let Prologueˉbytes: u32 = 32u32 + Slots * 28u32;
    let Propagateˉoffset: u32 = Prologueˉbytes + Analysis.Bodyˉbytes;
    let Overflowˉoffset: u32 = Propagateˉoffset + 13u32;
    let Instructionˉlimitˉoffset: u32 = Overflowˉoffset + 23u32;
    let Depthˉoffset: u32 = Overflowˉoffset + 161u32;
    var Result: bytes = Compilerˉnativeˉx64ˉempty(Input);

    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 65u8);
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 87u8);
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 73u8);
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 137u8);
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 215u8);
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 77u8);
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 139u8);
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 95u8);
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 8u8);
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 77u8);
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 139u8);
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 87u8);
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 16u8);
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 73u8);
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 131u8);
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 234u8);
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 1u8);
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 15u8);
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 130u8);
    Result = Compilerˉnativeˉx64ˉappendˉu32(
        Result,
        Depthˉoffset - Bytesˉlength(Result) - 4u32
    );
    Result = Compilerˉnativeˉx64ˉemitˉframe(Result, true, Frameˉbytes);
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 49u8);
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 192u8);
    var Zeroˉoffset: u32 = 0u32;
    while Zeroˉoffset < Frameˉbytes {
        Result = Compilerˉnativeˉx64ˉemitˉstoreˉeax(Result, Zeroˉoffset);
        Zeroˉoffset = Zeroˉoffset + 4u32;
    }

    var Stack: bytes = Compilerˉnativeˉx64ˉempty(Input);
    var Stackˉdepth: u32 = 0u32;
    var Nextˉvalue: u32 = 0u32;
    var Cursor: u32 = 0u32;
    while Cursor < Section.Payloadˉlength {
        let Opcode: u8 = Bytesˉreadˉu8(Input, Section.Payloadˉoffset + Cursor);
        Result = Compilerˉnativeˉx64ˉemitˉcharge(
            Result,
            Instructionˉlimitˉoffset
        );
        if Opcode == 1u8 {
            Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 184u8);
            Result = Compilerˉnativeˉx64ˉappendˉi32(
                Result,
                Bytesˉreadˉi32ˉlittle(Input, Section.Payloadˉoffset + Cursor + 1u32)
            );
            Result = Compilerˉnativeˉx64ˉemitˉstoreˉeax(
                Result,
                (Function.Locals + Nextˉvalue) * 16u32
            );
            Stack = Bytesˉconcat(Stack, Bytesˉfromˉu32ˉlittle(Nextˉvalue));
            Stackˉdepth = Stackˉdepth + 1u32;
            Nextˉvalue = Nextˉvalue + 1u32;
            Cursor = Cursor + 5u32;
        } else {
            if Opcode == 4u8 {
                let Loadˉlocal: u32 = Bytesˉreadˉu32ˉlittle(
                    Input,
                    Section.Payloadˉoffset + Cursor + 1u32
                );
                Result = Compilerˉnativeˉx64ˉemitˉloadˉeax(
                    Result,
                    Loadˉlocal * 16u32
                );
                Result = Compilerˉnativeˉx64ˉemitˉstoreˉeax(
                    Result,
                    (Function.Locals + Nextˉvalue) * 16u32
                );
                Stack = Bytesˉconcat(Stack, Bytesˉfromˉu32ˉlittle(Nextˉvalue));
                Stackˉdepth = Stackˉdepth + 1u32;
                Nextˉvalue = Nextˉvalue + 1u32;
                Cursor = Cursor + 5u32;
            } else {
                if Opcode == 5u8 {
                    let Storeˉlocal: u32 = Bytesˉreadˉu32ˉlittle(
                        Input,
                        Section.Payloadˉoffset + Cursor + 1u32
                    );
                    let Storeˉvalue: u32 = Bytesˉreadˉu32ˉlittle(
                        Stack,
                        (Stackˉdepth - 1u32) * 4u32
                    );
                    Stackˉdepth = Stackˉdepth - 1u32;
                    Stack = Bytesˉslice(Stack, 0u32, Stackˉdepth * 4u32);
                    Result = Compilerˉnativeˉx64ˉemitˉloadˉeax(
                        Result,
                        (Function.Locals + Storeˉvalue) * 16u32
                    );
                    Result = Compilerˉnativeˉx64ˉemitˉstoreˉeax(
                        Result,
                        Storeˉlocal * 16u32
                    );
                    Cursor = Cursor + 5u32;
                } else {
                    if Opcode == 16u8 {
                        let Addˉright: u32 = Bytesˉreadˉu32ˉlittle(
                            Stack,
                            (Stackˉdepth - 1u32) * 4u32
                        );
                        let Addˉleft: u32 = Bytesˉreadˉu32ˉlittle(
                            Stack,
                            (Stackˉdepth - 2u32) * 4u32
                        );
                        Stackˉdepth = Stackˉdepth - 2u32;
                        Stack = Bytesˉslice(Stack, 0u32, Stackˉdepth * 4u32);
                        Result = Compilerˉnativeˉx64ˉemitˉloadˉeax(
                            Result,
                            (Function.Locals + Addˉleft) * 16u32
                        );
                        Result = Compilerˉnativeˉx64ˉemitˉloadˉecx(
                            Result,
                            (Function.Locals + Addˉright) * 16u32
                        );
                        Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 1u8);
                        Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 200u8);
                        Result = Compilerˉnativeˉx64ˉemitˉoverflowˉbranch(
                            Result,
                            Overflowˉoffset
                        );
                        Result = Compilerˉnativeˉx64ˉemitˉstoreˉeax(
                            Result,
                            (Function.Locals + Nextˉvalue) * 16u32
                        );
                        Stack = Bytesˉconcat(
                            Stack,
                            Bytesˉfromˉu32ˉlittle(Nextˉvalue)
                        );
                        Stackˉdepth = Stackˉdepth + 1u32;
                        Nextˉvalue = Nextˉvalue + 1u32;
                        Cursor = Cursor + 1u32;
                    } else {
                        if Opcode == 17u8 {
                            let Subtractˉright: u32 = Bytesˉreadˉu32ˉlittle(
                                Stack,
                                (Stackˉdepth - 1u32) * 4u32
                            );
                            let Subtractˉleft: u32 = Bytesˉreadˉu32ˉlittle(
                                Stack,
                                (Stackˉdepth - 2u32) * 4u32
                            );
                            Stackˉdepth = Stackˉdepth - 2u32;
                            Stack = Bytesˉslice(Stack, 0u32, Stackˉdepth * 4u32);
                            Result = Compilerˉnativeˉx64ˉemitˉloadˉeax(
                                Result,
                                (Function.Locals + Subtractˉleft) * 16u32
                            );
                            Result = Compilerˉnativeˉx64ˉemitˉloadˉecx(
                                Result,
                                (Function.Locals + Subtractˉright) * 16u32
                            );
                            Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 41u8);
                            Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 200u8);
                            Result = Compilerˉnativeˉx64ˉemitˉoverflowˉbranch(
                                Result,
                                Overflowˉoffset
                            );
                            Result = Compilerˉnativeˉx64ˉemitˉstoreˉeax(
                                Result,
                                (Function.Locals + Nextˉvalue) * 16u32
                            );
                            Stack = Bytesˉconcat(
                                Stack,
                                Bytesˉfromˉu32ˉlittle(Nextˉvalue)
                            );
                            Stackˉdepth = Stackˉdepth + 1u32;
                            Nextˉvalue = Nextˉvalue + 1u32;
                            Cursor = Cursor + 1u32;
                        } else {
                            if Opcode == 18u8 {
                                let Multiplyˉright: u32 = Bytesˉreadˉu32ˉlittle(
                                    Stack,
                                    (Stackˉdepth - 1u32) * 4u32
                                );
                                let Multiplyˉleft: u32 = Bytesˉreadˉu32ˉlittle(
                                    Stack,
                                    (Stackˉdepth - 2u32) * 4u32
                                );
                                Stackˉdepth = Stackˉdepth - 2u32;
                                Stack = Bytesˉslice(Stack, 0u32, Stackˉdepth * 4u32);
                                Result = Compilerˉnativeˉx64ˉemitˉloadˉeax(
                                    Result,
                                    (Function.Locals + Multiplyˉleft) * 16u32
                                );
                                Result = Compilerˉnativeˉx64ˉemitˉloadˉecx(
                                    Result,
                                    (Function.Locals + Multiplyˉright) * 16u32
                                );
                                Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 15u8);
                                Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 175u8);
                                Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 193u8);
                                Result = Compilerˉnativeˉx64ˉemitˉoverflowˉbranch(
                                    Result,
                                    Overflowˉoffset
                                );
                                Result = Compilerˉnativeˉx64ˉemitˉstoreˉeax(
                                    Result,
                                    (Function.Locals + Nextˉvalue) * 16u32
                                );
                                Stack = Bytesˉconcat(
                                    Stack,
                                    Bytesˉfromˉu32ˉlittle(Nextˉvalue)
                                );
                                Stackˉdepth = Stackˉdepth + 1u32;
                                Nextˉvalue = Nextˉvalue + 1u32;
                                Cursor = Cursor + 1u32;
                            } else {
                                if Opcode == 19u8 {
                                    let Negateˉvalue: u32 = Bytesˉreadˉu32ˉlittle(
                                        Stack,
                                        (Stackˉdepth - 1u32) * 4u32
                                    );
                                    Stackˉdepth = Stackˉdepth - 1u32;
                                    Stack = Bytesˉslice(
                                        Stack,
                                        0u32,
                                        Stackˉdepth * 4u32
                                    );
                                    Result = Compilerˉnativeˉx64ˉemitˉloadˉeax(
                                        Result,
                                        (Function.Locals + Negateˉvalue) * 16u32
                                    );
                                    Result = Compilerˉnativeˉx64ˉappendˉbyte(
                                        Result,
                                        247u8
                                    );
                                    Result = Compilerˉnativeˉx64ˉappendˉbyte(
                                        Result,
                                        216u8
                                    );
                                    Result = Compilerˉnativeˉx64ˉemitˉoverflowˉbranch(
                                        Result,
                                        Overflowˉoffset
                                    );
                                    Result = Compilerˉnativeˉx64ˉemitˉstoreˉeax(
                                        Result,
                                        (Function.Locals + Nextˉvalue) * 16u32
                                    );
                                    Stack = Bytesˉconcat(
                                        Stack,
                                        Bytesˉfromˉu32ˉlittle(Nextˉvalue)
                                    );
                                    Stackˉdepth = Stackˉdepth + 1u32;
                                    Nextˉvalue = Nextˉvalue + 1u32;
                                    Cursor = Cursor + 1u32;
                                } else {
                                    let Returnˉvalue: u32 = Bytesˉreadˉu32ˉlittle(
                                        Stack,
                                        (Stackˉdepth - 1u32) * 4u32
                                    );
                                    Stackˉdepth = Stackˉdepth - 1u32;
                                    Stack = Bytesˉslice(
                                        Stack,
                                        0u32,
                                        Stackˉdepth * 4u32
                                    );
                                    Result = Compilerˉnativeˉx64ˉemitˉloadˉeax(
                                        Result,
                                        (Function.Locals + Returnˉvalue) * 16u32
                                    );
                                    Result = Compilerˉnativeˉx64ˉemitˉframe(
                                        Result,
                                        false,
                                        Frameˉbytes
                                    );
                                    Result = Compilerˉnativeˉx64ˉemitˉrestore(Result);
                                    Cursor = Cursor + 1u32;
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    Result = Compilerˉnativeˉx64ˉemitˉframe(Result, false, Frameˉbytes);
    Result = Compilerˉnativeˉx64ˉemitˉrestore(Result);
    Result = Compilerˉnativeˉx64ˉemitˉstatus(Result, Frameˉbytes, 1u32);
    Result = Compilerˉnativeˉx64ˉemitˉstatus(Result, Frameˉbytes, 2u32);
    Result = Compilerˉnativeˉx64ˉemitˉstatus(Result, Frameˉbytes, 4u32);
    Result = Compilerˉnativeˉx64ˉemitˉstatus(Result, Frameˉbytes, 6u32);
    Result = Compilerˉnativeˉx64ˉemitˉstatus(Result, Frameˉbytes, 5u32);
    Result = Compilerˉnativeˉx64ˉemitˉstatus(Result, Frameˉbytes, 8u32);
    Result = Compilerˉnativeˉx64ˉemitˉstatus(Result, Frameˉbytes, 7u32);
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 73u8);
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 255u8);
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 194u8);
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 72u8);
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 184u8);
    Result = Compilerˉnativeˉx64ˉappendˉu32(Result, 0u32);
    Result = Compilerˉnativeˉx64ˉappendˉu32(Result, 3u32);
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 65u8);
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 95u8);
    return Compilerˉnativeˉx64ˉappendˉbyte(Result, 195u8);
}

export fn Compilerˉnativeˉx64ˉemittedˉbytes(
    Opcode: u8,
    Isˉmain: bool,
    Callˉparameters: u32
) -> u32 {
    if Opcode == 1u8 { return 22u32; }
    if Opcode == 2u8 { return 22u32; }
    if Opcode == 4u8 { return 24u32; }
    if Opcode == 5u8 { return 24u32; }
    if Opcode == 16u8 { return 39u32; }
    if Opcode == 17u8 { return 39u32; }
    if Opcode == 18u8 { return 40u32; }
    if Opcode == 19u8 { return 32u32; }
    if Compilerˉnativeˉx64ˉisˉi32ˉcomparison(Opcode) { return 39u32; }
    if Compilerˉnativeˉx64ˉisˉboolˉcomparison(Opcode) { return 39u32; }
    if Opcode == 40u8 { return 27u32; }
    if Opcode == 48u8 { return 15u32; }
    if Opcode == 49u8 { return 30u32; }
    if Opcode == 64u8 {
        return 38u32 +
            Compilerˉnativeˉx64ˉscalarˉargumentˉbytes(Callˉparameters);
    }
    if Isˉmain { return 30u32; }
    return 28u32;
}

export fn Compilerˉnativeˉx64ˉblockˉid(Leaders: bytes, Offset: u32) -> u32 {
    var Id: u32 = 0u32;
    var Cursor: u32 = 0u32;
    while Cursor < Offset {
        if Bytesˉreadˉu8(Leaders, Cursor) == 1u8 { Id = Id + 1u32; }
        Cursor = Cursor + 1u32;
    }
    return Id;
}

export fn Compilerˉnativeˉx64ˉbuildˉblockˉoffsets(
    Input: bytes,
    Section: Compilerˉnativeˉx64ˉsection,
    Leaders: bytes,
    Prologueˉbytes: u32,
    Isˉmain: bool,
    Callˉparameters: u32
) -> bytes {
    var Result: bytes = Compilerˉnativeˉx64ˉempty(Input);
    var Machine: u32 = Prologueˉbytes;
    var Cursor: u32 = 0u32;
    while Cursor < Section.Payloadˉlength {
        if Bytesˉreadˉu8(Leaders, Cursor) == 1u8 {
            Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Machine));
        }
        let Opcode: u8 = Bytesˉreadˉu8(Input, Section.Payloadˉoffset + Cursor);
        Machine = Machine + Compilerˉnativeˉx64ˉemittedˉbytes(
            Opcode,
            Isˉmain,
            Callˉparameters
        );
        Cursor = Cursor + Compilerˉnativeˉx64ˉinstructionˉsize(Opcode);
    }
    return Result;
}

export fn Compilerˉnativeˉx64ˉmachineˉtarget(
    Leaders: bytes,
    Blockˉoffsets: bytes,
    Wvbˉoffset: u32
) -> u32 {
    return Bytesˉreadˉu32ˉlittle(
        Blockˉoffsets,
        Compilerˉnativeˉx64ˉblockˉid(Leaders, Wvbˉoffset) * 4u32
    );
}

export fn Compilerˉnativeˉx64ˉrelativeˉu32(
    Target: u32,
    Origin: u32
) -> u32 {
    if Target >= Origin { return Target - Origin; }
    let Magnitude: u32 = Origin - Target;
    return 4294967295u32 - Magnitude + 1u32;
}

export fn Compilerˉnativeˉx64ˉemitˉjump(
    Result: bytes,
    Target: u32
) -> bytes {
    var Output: bytes = Compilerˉnativeˉx64ˉappendˉbyte(Result, 233u8);
    return Compilerˉnativeˉx64ˉappendˉu32(
        Output,
        Compilerˉnativeˉx64ˉrelativeˉu32(
            Target,
            Bytesˉlength(Output) + 4u32
        )
    );
}

export fn Compilerˉnativeˉx64ˉcomparisonˉcondition(Opcode: u8) -> u8 {
    if Opcode == 32u8 { return 148u8; }
    if Opcode == 33u8 { return 149u8; }
    if Opcode == 34u8 { return 156u8; }
    if Opcode == 35u8 { return 158u8; }
    if Opcode == 36u8 { return 159u8; }
    if Opcode == 37u8 { return 157u8; }
    if Opcode == 38u8 { return 148u8; }
    return 149u8;
}

export fn Compilerˉnativeˉx64ˉemitˉcomparison(
    Result: bytes,
    Leftˉslot: u32,
    Rightˉslot: u32,
    Condition: u8,
    Resultˉslot: u32
) -> bytes {
    var Output: bytes = Compilerˉnativeˉx64ˉemitˉloadˉeax(
        Result,
        Leftˉslot * 16u32
    );
    Output = Compilerˉnativeˉx64ˉemitˉloadˉecx(Output, Rightˉslot * 16u32);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 57u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 200u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 15u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, Condition);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 192u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 15u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 182u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 192u8);
    return Compilerˉnativeˉx64ˉemitˉstoreˉeax(
        Output,
        Resultˉslot * 16u32
    );
}

export fn Compilerˉnativeˉx64ˉemitˉconditionalˉbranch(
    Result: bytes,
    Conditionˉslot: u32,
    Trueˉtarget: u32,
    Falseˉtarget: u32
) -> bytes {
    var Output: bytes = Compilerˉnativeˉx64ˉemitˉloadˉeax(
        Result,
        Conditionˉslot * 16u32
    );
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 133u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 192u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 15u8);
    Output = Compilerˉnativeˉx64ˉappendˉbyte(Output, 133u8);
    Output = Compilerˉnativeˉx64ˉappendˉu32(
        Output,
        Compilerˉnativeˉx64ˉrelativeˉu32(
            Trueˉtarget,
            Bytesˉlength(Output) + 4u32
        )
    );
    return Compilerˉnativeˉx64ˉemitˉjump(Output, Falseˉtarget);
}

export fn Compilerˉnativeˉx64ˉemitˉcontrolˉcode(
    Input: bytes,
    Section: Compilerˉnativeˉx64ˉsection,
    Function: Compilerˉnativeˉx64ˉfunction,
    Analysis: Compilerˉnativeˉx64ˉcontrolˉanalysis,
    Isˉmain: bool,
    Codeˉbase: u32,
    Callˉparameters: u32
) -> bytes {
    let Slots: u32 = Function.Locals + Analysis.I32ˉslots + Analysis.Boolˉslots;
    let Frameˉbytes: u32 = Slots * 16u32;
    var Prologueˉbase: u32 = 19u32;
    if Isˉmain { Prologueˉbase = 32u32; }
    let Parameterˉbytes: u32 =
        Compilerˉnativeˉx64ˉscalarˉargumentˉbytes(Function.Parameters);
    let Prologueˉbytes: u32 = Prologueˉbase + Slots * 28u32 + Parameterˉbytes;
    let Propagateˉoffset: u32 = Prologueˉbytes + Analysis.Bodyˉbytes;
    var Restoreˉbytes: u32 = 11u32;
    var Statusˉbytes: u32 = 21u32;
    if Isˉmain {
        Restoreˉbytes = 13u32;
        Statusˉbytes = 23u32;
    }
    let Overflowˉoffset: u32 = Propagateˉoffset + Restoreˉbytes;
    let Instructionˉlimitˉoffset: u32 = Overflowˉoffset + Statusˉbytes;
    let Depthˉoffset: u32 = Overflowˉoffset + Statusˉbytes * 7u32;
    let Blockˉoffsets: bytes = Compilerˉnativeˉx64ˉbuildˉblockˉoffsets(
        Input,
        Section,
        Analysis.Leaders,
        Prologueˉbytes,
        Isˉmain,
        Callˉparameters
    );
    var Result: bytes = Compilerˉnativeˉx64ˉempty(Input);

    if Isˉmain {
        Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 65u8);
        Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 87u8);
        Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 73u8);
        Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 137u8);
        Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 215u8);
        Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 77u8);
        Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 139u8);
        Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 95u8);
        Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 8u8);
        Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 77u8);
        Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 139u8);
        Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 87u8);
        Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 16u8);
    }
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 73u8);
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 131u8);
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 234u8);
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 1u8);
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 15u8);
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 130u8);
    Result = Compilerˉnativeˉx64ˉappendˉu32(
        Result,
        Depthˉoffset - Bytesˉlength(Result) - 4u32
    );
    Result = Compilerˉnativeˉx64ˉemitˉframe(Result, true, Frameˉbytes);
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 49u8);
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 192u8);
    var Zeroˉoffset: u32 = 0u32;
    while Zeroˉoffset < Frameˉbytes {
        Result = Compilerˉnativeˉx64ˉemitˉstoreˉeax(Result, Zeroˉoffset);
        Zeroˉoffset = Zeroˉoffset + 4u32;
    }
    var Parameter: u32 = 0u32;
    while Parameter < Function.Parameters {
        Result = Compilerˉnativeˉx64ˉemitˉstoreˉargument(
            Result,
            Parameter,
            Parameter * 16u32
        );
        Parameter = Parameter + 1u32;
    }

    var Stackˉtypes: bytes = Compilerˉnativeˉx64ˉempty(Input);
    var Stackˉslots: bytes = Compilerˉnativeˉx64ˉempty(Input);
    var Stackˉdepth: u32 = 0u32;
    var Nextˉi32: u32 = 0u32;
    var Nextˉbool: u32 = 0u32;
    var Cursor: u32 = 0u32;
    while Cursor < Section.Payloadˉlength {
        if Bytesˉreadˉu8(Analysis.Leaders, Cursor) == 1u8 {
            Stackˉtypes = Compilerˉnativeˉx64ˉempty(Input);
            Stackˉslots = Compilerˉnativeˉx64ˉempty(Input);
            Stackˉdepth = 0u32;
            Nextˉi32 = 0u32;
            Nextˉbool = 0u32;
        }
        let Opcode: u8 = Bytesˉreadˉu8(Input, Section.Payloadˉoffset + Cursor);
        Result = Compilerˉnativeˉx64ˉemitˉcharge(
            Result,
            Instructionˉlimitˉoffset
        );
        if Opcode == 1u8 {
            let Constantˉslot: u32 = Function.Locals + Nextˉi32;
            Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 184u8);
            Result = Compilerˉnativeˉx64ˉappendˉi32(
                Result,
                Bytesˉreadˉi32ˉlittle(Input, Section.Payloadˉoffset + Cursor + 1u32)
            );
            Result = Compilerˉnativeˉx64ˉemitˉstoreˉeax(
                Result,
                Constantˉslot * 16u32
            );
            Stackˉtypes = Bytesˉconcat(Stackˉtypes, Bytesˉfromˉu8(1u8));
            Stackˉslots = Bytesˉconcat(
                Stackˉslots,
                Bytesˉfromˉu32ˉlittle(Constantˉslot)
            );
            Stackˉdepth = Stackˉdepth + 1u32;
            Nextˉi32 = Nextˉi32 + 1u32;
        } else {
            if Opcode == 2u8 {
                let Boolˉconstantˉslot: u32 =
                    Function.Locals + Analysis.I32ˉslots + Nextˉbool;
                Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 184u8);
                Result = Compilerˉnativeˉx64ˉappendˉu32(
                    Result,
                    U32ˉfromˉu8(Bytesˉreadˉu8(
                        Input,
                        Section.Payloadˉoffset + Cursor + 1u32
                    ))
                );
                Result = Compilerˉnativeˉx64ˉemitˉstoreˉeax(
                    Result,
                    Boolˉconstantˉslot * 16u32
                );
                Stackˉtypes = Bytesˉconcat(Stackˉtypes, Bytesˉfromˉu8(2u8));
                Stackˉslots = Bytesˉconcat(
                    Stackˉslots,
                    Bytesˉfromˉu32ˉlittle(Boolˉconstantˉslot)
                );
                Stackˉdepth = Stackˉdepth + 1u32;
                Nextˉbool = Nextˉbool + 1u32;
            } else {
                if Opcode == 4u8 {
                    let Loadˉlocal: u32 = Bytesˉreadˉu32ˉlittle(
                        Input,
                        Section.Payloadˉoffset + Cursor + 1u32
                    );
                    let Loadˉtype: u8 = Bytesˉreadˉu8(
                        Function.Localˉtypes,
                        Loadˉlocal
                    );
                    var Loadˉslot: u32 = Function.Locals + Nextˉi32;
                    if Loadˉtype == 2u8 {
                        Loadˉslot = Function.Locals + Analysis.I32ˉslots + Nextˉbool;
                    }
                    Result = Compilerˉnativeˉx64ˉemitˉloadˉeax(
                        Result,
                        Loadˉlocal * 16u32
                    );
                    Result = Compilerˉnativeˉx64ˉemitˉstoreˉeax(
                        Result,
                        Loadˉslot * 16u32
                    );
                    Stackˉtypes = Bytesˉconcat(Stackˉtypes, Bytesˉfromˉu8(Loadˉtype));
                    Stackˉslots = Bytesˉconcat(
                        Stackˉslots,
                        Bytesˉfromˉu32ˉlittle(Loadˉslot)
                    );
                    Stackˉdepth = Stackˉdepth + 1u32;
                    if Loadˉtype == 1u8 {
                        Nextˉi32 = Nextˉi32 + 1u32;
                    } else {
                        Nextˉbool = Nextˉbool + 1u32;
                    }
                } else {
                    if Opcode == 5u8 {
                        let Storeˉlocal: u32 = Bytesˉreadˉu32ˉlittle(
                            Input,
                            Section.Payloadˉoffset + Cursor + 1u32
                        );
                        let Storeˉslot: u32 = Bytesˉreadˉu32ˉlittle(
                            Stackˉslots,
                            (Stackˉdepth - 1u32) * 4u32
                        );
                        Stackˉdepth = Stackˉdepth - 1u32;
                        Stackˉtypes = Bytesˉslice(Stackˉtypes, 0u32, Stackˉdepth);
                        Stackˉslots = Bytesˉslice(
                            Stackˉslots,
                            0u32,
                            Stackˉdepth * 4u32
                        );
                        Result = Compilerˉnativeˉx64ˉemitˉloadˉeax(
                            Result,
                            Storeˉslot * 16u32
                        );
                        Result = Compilerˉnativeˉx64ˉemitˉstoreˉeax(
                            Result,
                            Storeˉlocal * 16u32
                        );
                    } else {
                        let Numericˉopcode: u32 = U32ˉfromˉu8(Opcode);
                        if Numericˉopcode >= 16u32 {
                            if Numericˉopcode <= 18u32 {
                                let Binaryˉright: u32 = Bytesˉreadˉu32ˉlittle(
                                    Stackˉslots,
                                    (Stackˉdepth - 1u32) * 4u32
                                );
                                let Binaryˉleft: u32 = Bytesˉreadˉu32ˉlittle(
                                    Stackˉslots,
                                    (Stackˉdepth - 2u32) * 4u32
                                );
                                Stackˉdepth = Stackˉdepth - 2u32;
                                Stackˉtypes = Bytesˉslice(
                                    Stackˉtypes,
                                    0u32,
                                    Stackˉdepth
                                );
                                Stackˉslots = Bytesˉslice(
                                    Stackˉslots,
                                    0u32,
                                    Stackˉdepth * 4u32
                                );
                                let Binaryˉresult: u32 =
                                    Function.Locals + Nextˉi32;
                                Result = Compilerˉnativeˉx64ˉemitˉloadˉeax(
                                    Result,
                                    Binaryˉleft * 16u32
                                );
                                Result = Compilerˉnativeˉx64ˉemitˉloadˉecx(
                                    Result,
                                    Binaryˉright * 16u32
                                );
                                if Opcode == 16u8 {
                                    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 1u8);
                                    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 200u8);
                                }
                                if Opcode == 17u8 {
                                    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 41u8);
                                    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 200u8);
                                }
                                if Opcode == 18u8 {
                                    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 15u8);
                                    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 175u8);
                                    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 193u8);
                                }
                                Result = Compilerˉnativeˉx64ˉemitˉoverflowˉbranch(
                                    Result,
                                    Overflowˉoffset
                                );
                                Result = Compilerˉnativeˉx64ˉemitˉstoreˉeax(
                                    Result,
                                    Binaryˉresult * 16u32
                                );
                                Stackˉtypes = Bytesˉconcat(
                                    Stackˉtypes,
                                    Bytesˉfromˉu8(1u8)
                                );
                                Stackˉslots = Bytesˉconcat(
                                    Stackˉslots,
                                    Bytesˉfromˉu32ˉlittle(Binaryˉresult)
                                );
                                Stackˉdepth = Stackˉdepth + 1u32;
                                Nextˉi32 = Nextˉi32 + 1u32;
                            } else {
                                if Opcode == 19u8 {
                                    let Negateˉinput: u32 = Bytesˉreadˉu32ˉlittle(
                                        Stackˉslots,
                                        (Stackˉdepth - 1u32) * 4u32
                                    );
                                    Stackˉdepth = Stackˉdepth - 1u32;
                                    Stackˉtypes = Bytesˉslice(
                                        Stackˉtypes,
                                        0u32,
                                        Stackˉdepth
                                    );
                                    Stackˉslots = Bytesˉslice(
                                        Stackˉslots,
                                        0u32,
                                        Stackˉdepth * 4u32
                                    );
                                    let Negateˉresult: u32 =
                                        Function.Locals + Nextˉi32;
                                    Result = Compilerˉnativeˉx64ˉemitˉloadˉeax(
                                        Result,
                                        Negateˉinput * 16u32
                                    );
                                    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 247u8);
                                    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 216u8);
                                    Result = Compilerˉnativeˉx64ˉemitˉoverflowˉbranch(
                                        Result,
                                        Overflowˉoffset
                                    );
                                    Result = Compilerˉnativeˉx64ˉemitˉstoreˉeax(
                                        Result,
                                        Negateˉresult * 16u32
                                    );
                                    Stackˉtypes = Bytesˉconcat(
                                        Stackˉtypes,
                                        Bytesˉfromˉu8(1u8)
                                    );
                                    Stackˉslots = Bytesˉconcat(
                                        Stackˉslots,
                                        Bytesˉfromˉu32ˉlittle(Negateˉresult)
                                    );
                                    Stackˉdepth = Stackˉdepth + 1u32;
                                    Nextˉi32 = Nextˉi32 + 1u32;
                                } else {
                                    if Compilerˉnativeˉx64ˉisˉi32ˉcomparison(Opcode) {
                                        let I32ˉcompareˉright: u32 =
                                            Bytesˉreadˉu32ˉlittle(
                                                Stackˉslots,
                                                (Stackˉdepth - 1u32) * 4u32
                                            );
                                        let I32ˉcompareˉleft: u32 =
                                            Bytesˉreadˉu32ˉlittle(
                                                Stackˉslots,
                                                (Stackˉdepth - 2u32) * 4u32
                                            );
                                        Stackˉdepth = Stackˉdepth - 2u32;
                                        Stackˉtypes = Bytesˉslice(
                                            Stackˉtypes,
                                            0u32,
                                            Stackˉdepth
                                        );
                                        Stackˉslots = Bytesˉslice(
                                            Stackˉslots,
                                            0u32,
                                            Stackˉdepth * 4u32
                                        );
                                        let I32ˉcompareˉresult: u32 =
                                            Function.Locals + Analysis.I32ˉslots + Nextˉbool;
                                        Result = Compilerˉnativeˉx64ˉemitˉcomparison(
                                            Result,
                                            I32ˉcompareˉleft,
                                            I32ˉcompareˉright,
                                            Compilerˉnativeˉx64ˉcomparisonˉcondition(Opcode),
                                            I32ˉcompareˉresult
                                        );
                                        Stackˉtypes = Bytesˉconcat(
                                            Stackˉtypes,
                                            Bytesˉfromˉu8(2u8)
                                        );
                                        Stackˉslots = Bytesˉconcat(
                                            Stackˉslots,
                                            Bytesˉfromˉu32ˉlittle(I32ˉcompareˉresult)
                                        );
                                        Stackˉdepth = Stackˉdepth + 1u32;
                                        Nextˉbool = Nextˉbool + 1u32;
                                    } else {
                                        if Compilerˉnativeˉx64ˉisˉboolˉcomparison(Opcode) {
                                            let Boolˉcompareˉright: u32 =
                                                Bytesˉreadˉu32ˉlittle(
                                                    Stackˉslots,
                                                    (Stackˉdepth - 1u32) * 4u32
                                                );
                                            let Boolˉcompareˉleft: u32 =
                                                Bytesˉreadˉu32ˉlittle(
                                                    Stackˉslots,
                                                    (Stackˉdepth - 2u32) * 4u32
                                                );
                                            Stackˉdepth = Stackˉdepth - 2u32;
                                            Stackˉtypes = Bytesˉslice(
                                                Stackˉtypes,
                                                0u32,
                                                Stackˉdepth
                                            );
                                            Stackˉslots = Bytesˉslice(
                                                Stackˉslots,
                                                0u32,
                                                Stackˉdepth * 4u32
                                            );
                                            let Boolˉcompareˉresult: u32 =
                                                Function.Locals + Analysis.I32ˉslots + Nextˉbool;
                                            Result = Compilerˉnativeˉx64ˉemitˉcomparison(
                                                Result,
                                                Boolˉcompareˉleft,
                                                Boolˉcompareˉright,
                                                Compilerˉnativeˉx64ˉcomparisonˉcondition(Opcode),
                                                Boolˉcompareˉresult
                                            );
                                            Stackˉtypes = Bytesˉconcat(
                                                Stackˉtypes,
                                                Bytesˉfromˉu8(2u8)
                                            );
                                            Stackˉslots = Bytesˉconcat(
                                                Stackˉslots,
                                                Bytesˉfromˉu32ˉlittle(Boolˉcompareˉresult)
                                            );
                                            Stackˉdepth = Stackˉdepth + 1u32;
                                            Nextˉbool = Nextˉbool + 1u32;
                                        } else {
                                            if Opcode == 40u8 {
                                                let Notˉinput: u32 =
                                                    Bytesˉreadˉu32ˉlittle(
                                                        Stackˉslots,
                                                        (Stackˉdepth - 1u32) * 4u32
                                                    );
                                                Stackˉdepth = Stackˉdepth - 1u32;
                                                Stackˉtypes = Bytesˉslice(
                                                    Stackˉtypes,
                                                    0u32,
                                                    Stackˉdepth
                                                );
                                                Stackˉslots = Bytesˉslice(
                                                    Stackˉslots,
                                                    0u32,
                                                    Stackˉdepth * 4u32
                                                );
                                                let Notˉresult: u32 =
                                                    Function.Locals +
                                                    Analysis.I32ˉslots + Nextˉbool;
                                                Result = Compilerˉnativeˉx64ˉemitˉloadˉeax(
                                                    Result,
                                                    Notˉinput * 16u32
                                                );
                                                Result = Compilerˉnativeˉx64ˉappendˉbyte(
                                                    Result,
                                                    131u8
                                                );
                                                Result = Compilerˉnativeˉx64ˉappendˉbyte(
                                                    Result,
                                                    240u8
                                                );
                                                Result = Compilerˉnativeˉx64ˉappendˉbyte(
                                                    Result,
                                                    1u8
                                                );
                                                Result = Compilerˉnativeˉx64ˉemitˉstoreˉeax(
                                                    Result,
                                                    Notˉresult * 16u32
                                                );
                                                Stackˉtypes = Bytesˉconcat(
                                                    Stackˉtypes,
                                                    Bytesˉfromˉu8(2u8)
                                                );
                                                Stackˉslots = Bytesˉconcat(
                                                    Stackˉslots,
                                                    Bytesˉfromˉu32ˉlittle(Notˉresult)
                                                );
                                                Stackˉdepth = Stackˉdepth + 1u32;
                                                Nextˉbool = Nextˉbool + 1u32;
                                            } else {
                                                if Opcode == 64u8 {
                                                    let Callˉresult: u32 =
                                                        Function.Locals + Nextˉi32;
                                                    var Argument: u32 = 0u32;
                                                    while Argument < Callˉparameters {
                                                        let Argumentˉslot: u32 =
                                                            Bytesˉreadˉu32ˉlittle(
                                                                Stackˉslots,
                                                                (Stackˉdepth -
                                                                    Callˉparameters +
                                                                    Argument) * 4u32
                                                            );
                                                        Result =
                                                            Compilerˉnativeˉx64ˉemitˉloadˉargument(
                                                                Result,
                                                                Argument,
                                                                Argumentˉslot * 16u32
                                                            );
                                                        Argument = Argument + 1u32;
                                                    }
                                                    Stackˉdepth =
                                                        Stackˉdepth - Callˉparameters;
                                                    Stackˉtypes = Bytesˉslice(
                                                        Stackˉtypes,
                                                        0u32,
                                                        Stackˉdepth
                                                    );
                                                    Stackˉslots = Bytesˉslice(
                                                        Stackˉslots,
                                                        0u32,
                                                        Stackˉdepth * 4u32
                                                    );
                                                    Result = Compilerˉnativeˉx64ˉappendˉbyte(
                                                        Result,
                                                        232u8
                                                    );
                                                    Result = Compilerˉnativeˉx64ˉappendˉu32(
                                                        Result,
                                                        Compilerˉnativeˉx64ˉrelativeˉu32(
                                                            0u32,
                                                            Codeˉbase + Bytesˉlength(Result) + 4u32
                                                        )
                                                    );
                                                    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 72u8);
                                                    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 137u8);
                                                    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 194u8);
                                                    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 72u8);
                                                    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 193u8);
                                                    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 234u8);
                                                    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 32u8);
                                                    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 72u8);
                                                    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 133u8);
                                                    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 210u8);
                                                    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 15u8);
                                                    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 133u8);
                                                    Result = Compilerˉnativeˉx64ˉappendˉu32(
                                                        Result,
                                                        Compilerˉnativeˉx64ˉrelativeˉu32(
                                                            Propagateˉoffset,
                                                            Bytesˉlength(Result) + 4u32
                                                        )
                                                    );
                                                    Result = Compilerˉnativeˉx64ˉemitˉstoreˉeax(
                                                        Result,
                                                        Callˉresult * 16u32
                                                    );
                                                    Stackˉtypes = Bytesˉconcat(
                                                        Stackˉtypes,
                                                        Bytesˉfromˉu8(1u8)
                                                    );
                                                    Stackˉslots = Bytesˉconcat(
                                                        Stackˉslots,
                                                        Bytesˉfromˉu32ˉlittle(Callˉresult)
                                                    );
                                                    Stackˉdepth = Stackˉdepth + 1u32;
                                                    Nextˉi32 = Nextˉi32 + 1u32;
                                                } else {
                                                if Opcode == 48u8 {
                                                    let Jumpˉwvbˉtarget: u32 =
                                                        Bytesˉreadˉu32ˉlittle(
                                                            Input,
                                                            Section.Payloadˉoffset + Cursor + 1u32
                                                        );
                                                    Result = Compilerˉnativeˉx64ˉemitˉjump(
                                                        Result,
                                                        Compilerˉnativeˉx64ˉmachineˉtarget(
                                                            Analysis.Leaders,
                                                            Blockˉoffsets,
                                                            Jumpˉwvbˉtarget
                                                        )
                                                    );
                                                } else {
                                                    if Opcode == 49u8 {
                                                        let Branchˉconditionˉslot: u32 =
                                                            Bytesˉreadˉu32ˉlittle(
                                                                Stackˉslots,
                                                                (Stackˉdepth - 1u32) * 4u32
                                                            );
                                                        Stackˉdepth = Stackˉdepth - 1u32;
                                                        Stackˉtypes = Bytesˉslice(
                                                            Stackˉtypes,
                                                            0u32,
                                                            Stackˉdepth
                                                        );
                                                        Stackˉslots = Bytesˉslice(
                                                            Stackˉslots,
                                                            0u32,
                                                            Stackˉdepth * 4u32
                                                        );
                                                        let Branchˉfalseˉwvb: u32 =
                                                            Bytesˉreadˉu32ˉlittle(
                                                                Input,
                                                                Section.Payloadˉoffset + Cursor + 1u32
                                                            );
                                                        let Branchˉnextˉwvb: u32 =
                                                            Cursor + 5u32;
                                                        Result = Compilerˉnativeˉx64ˉemitˉconditionalˉbranch(
                                                            Result,
                                                            Branchˉconditionˉslot,
                                                            Compilerˉnativeˉx64ˉmachineˉtarget(
                                                                Analysis.Leaders,
                                                                Blockˉoffsets,
                                                                Branchˉnextˉwvb
                                                            ),
                                                            Compilerˉnativeˉx64ˉmachineˉtarget(
                                                                Analysis.Leaders,
                                                                Blockˉoffsets,
                                                                Branchˉfalseˉwvb
                                                            )
                                                        );
                                                    } else {
                                                        let Returnˉslot: u32 =
                                                            Bytesˉreadˉu32ˉlittle(
                                                                Stackˉslots,
                                                                (Stackˉdepth - 1u32) * 4u32
                                                            );
                                                        Stackˉdepth = Stackˉdepth - 1u32;
                                                        Stackˉtypes = Bytesˉslice(
                                                            Stackˉtypes,
                                                            0u32,
                                                            Stackˉdepth
                                                        );
                                                        Stackˉslots = Bytesˉslice(
                                                            Stackˉslots,
                                                            0u32,
                                                            Stackˉdepth * 4u32
                                                        );
                                                        Result = Compilerˉnativeˉx64ˉemitˉloadˉeax(
                                                            Result,
                                                            Returnˉslot * 16u32
                                                        );
                                                        Result = Compilerˉnativeˉx64ˉemitˉframe(
                                                            Result,
                                                            false,
                                                            Frameˉbytes
                                                        );
                                                        Result = Compilerˉnativeˉx64ˉemitˉrestoreˉfor(
                                                            Result,
                                                            Isˉmain
                                                        );
                                                    }
                                                }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        Cursor = Cursor + Compilerˉnativeˉx64ˉinstructionˉsize(Opcode);
    }

    Result = Compilerˉnativeˉx64ˉemitˉframe(Result, false, Frameˉbytes);
    Result = Compilerˉnativeˉx64ˉemitˉrestoreˉfor(Result, Isˉmain);
    Result = Compilerˉnativeˉx64ˉemitˉstatusˉfor(Result, Frameˉbytes, 1u32, Isˉmain);
    Result = Compilerˉnativeˉx64ˉemitˉstatusˉfor(Result, Frameˉbytes, 2u32, Isˉmain);
    Result = Compilerˉnativeˉx64ˉemitˉstatusˉfor(Result, Frameˉbytes, 4u32, Isˉmain);
    Result = Compilerˉnativeˉx64ˉemitˉstatusˉfor(Result, Frameˉbytes, 6u32, Isˉmain);
    Result = Compilerˉnativeˉx64ˉemitˉstatusˉfor(Result, Frameˉbytes, 5u32, Isˉmain);
    Result = Compilerˉnativeˉx64ˉemitˉstatusˉfor(Result, Frameˉbytes, 8u32, Isˉmain);
    Result = Compilerˉnativeˉx64ˉemitˉstatusˉfor(Result, Frameˉbytes, 7u32, Isˉmain);
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 73u8);
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 255u8);
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 194u8);
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 72u8);
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 184u8);
    Result = Compilerˉnativeˉx64ˉappendˉu32(Result, 0u32);
    Result = Compilerˉnativeˉx64ˉappendˉu32(Result, 3u32);
    if Isˉmain {
        Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 65u8);
        Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 95u8);
    }
    return Compilerˉnativeˉx64ˉappendˉbyte(Result, 195u8);
}

export fn Compilerˉnativeˉx64ˉemitˉobject(
    Input: bytes,
    Code: bytes,
    Helperˉbytes: u32
) -> bytes {
    let Codeˉlength: u32 = Bytesˉlength(Code);
    var Symbolˉcount: u32 = 1u32;
    if Helperˉbytes != 0u32 { Symbolˉcount = 2u32; }
    var Result: bytes = Textˉtoˉutf8("WVO1");
    Result = Bytesˉconcat(Result, Bytesˉfromˉu16ˉlittle(1u32));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu16ˉlittle(0u32));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu8(1u8));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu8(0u8));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu16ˉlittle(0u32));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(1u32));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Symbolˉcount));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(0u32));

    Result = Bytesˉconcat(Result, Bytesˉfromˉu8(1u8));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu8(0u8));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu16ˉlittle(0u32));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(16u32));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Codeˉlength));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Codeˉlength));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(5u32));
    Result = Bytesˉconcat(Result, Textˉtoˉutf8(".text"));
    Result = Bytesˉconcat(Result, Code);

    if Helperˉbytes != 0u32 {
        Result = Bytesˉconcat(Result, Bytesˉfromˉu8(1u8));
        Result = Bytesˉconcat(Result, Bytesˉfromˉu8(1u8));
        Result = Bytesˉconcat(Result, Bytesˉfromˉu16ˉlittle(0u32));
        Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(0u32));
        Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(0u32));
        Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Helperˉbytes));
        Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(14u32));
        Result = Bytesˉconcat(Result, Textˉtoˉutf8("$function_0000"));
    }

    Result = Bytesˉconcat(Result, Bytesˉfromˉu8(2u8));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu8(1u8));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu16ˉlittle(0u32));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(0u32));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Helperˉbytes));
    Result = Bytesˉconcat(
        Result,
        Bytesˉfromˉu32ˉlittle(Codeˉlength - Helperˉbytes)
    );
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(4u32));
    return Bytesˉconcat(Result, Textˉtoˉutf8("Main"));
}

export fn Compilerˉlowerˉwvbˉnativeˉx64(Input: bytes)
    -> Compilerˉnativeˉx64ˉsummary {
    let Structure: Compilerˉnativeˉx64ˉstructure =
        Compilerˉnativeˉx64ˉreadˉstructure(Input);
    if !Structure.Valid {
        return Compilerˉnativeˉx64ˉfailure(
            Input,
            Compilerˉnativeˉx64ˉstatus.Invalidˉwvb
        );
    }
    let Module: Compilerˉnativeˉx64ˉsection = Compilerˉnativeˉx64ˉsection(
        true,
        Structure.Moduleˉoffset,
        Structure.Moduleˉlength,
        0u32
    );
    if !Compilerˉnativeˉx64ˉmoduleˉisˉvalid(Input, Module) {
        return Compilerˉnativeˉx64ˉfailure(
            Input,
            Compilerˉnativeˉx64ˉstatus.Invalidˉwvb
        );
    }
    if Bytesˉreadˉu8(Input, Structure.Moduleˉoffset) != 1u8 {
        return Compilerˉnativeˉx64ˉfailure(
            Input,
            Compilerˉnativeˉx64ˉstatus.Unsupportedˉprofile
        );
    }
    if Structure.Capabilitiesˉlength != 4u32 {
        return Compilerˉnativeˉx64ˉfailure(
            Input,
            Compilerˉnativeˉx64ˉstatus.Unsupportedˉmodule
        );
    }
    if Bytesˉreadˉu32ˉlittle(Input, Structure.Capabilitiesˉoffset) != 0u32 {
        return Compilerˉnativeˉx64ˉfailure(
            Input,
            Compilerˉnativeˉx64ˉstatus.Unsupportedˉmodule
        );
    }
    if Structure.Dataˉlength != 4u32 {
        return Compilerˉnativeˉx64ˉfailure(
            Input,
            Compilerˉnativeˉx64ˉstatus.Unsupportedˉmodule
        );
    }
    if Bytesˉreadˉu32ˉlittle(Input, Structure.Dataˉoffset) != 0u32 {
        return Compilerˉnativeˉx64ˉfailure(
            Input,
            Compilerˉnativeˉx64ˉstatus.Unsupportedˉmodule
        );
    }
    if Structure.Typesˉlength != 4u32 {
        return Compilerˉnativeˉx64ˉfailure(
            Input,
            Compilerˉnativeˉx64ˉstatus.Unsupportedˉmodule
        );
    }
    if Bytesˉreadˉu32ˉlittle(Input, Structure.Typesˉoffset) != 0u32 {
        return Compilerˉnativeˉx64ˉfailure(
            Input,
            Compilerˉnativeˉx64ˉstatus.Unsupportedˉmodule
        );
    }
    let Functions: Compilerˉnativeˉx64ˉsection = Compilerˉnativeˉx64ˉsection(
        true,
        Structure.Functionsˉoffset,
        Structure.Functionsˉlength,
        0u32
    );
    if Functions.Payloadˉlength < 4u32 {
        return Compilerˉnativeˉx64ˉfailure(
            Input,
            Compilerˉnativeˉx64ˉstatus.Unsupportedˉfunction
        );
    }
    let Functionˉcount: u32 = Bytesˉreadˉu32ˉlittle(
        Input,
        Functions.Payloadˉoffset
    );
    if Functionˉcount == 0u32 {
        return Compilerˉnativeˉx64ˉfailure(
            Input,
            Compilerˉnativeˉx64ˉstatus.Unsupportedˉfunction
        );
    }
    if Functionˉcount > 2u32 {
        return Compilerˉnativeˉx64ˉfailure(
            Input,
            Compilerˉnativeˉx64ˉstatus.Unsupportedˉfunction
        );
    }
    let Functionsˉlimit: u32 =
        Functions.Payloadˉoffset + Functions.Payloadˉlength;
    let Exports: Compilerˉnativeˉx64ˉsection = Compilerˉnativeˉx64ˉsection(
        true,
        Structure.Exportsˉoffset,
        Structure.Exportsˉlength,
        0u32
    );
    if Functionˉcount == 1u32 {
        let Function: Compilerˉnativeˉx64ˉfunction =
            Compilerˉnativeˉx64ˉreadˉfunctionˉat(
                Input,
                Functions.Payloadˉoffset + 4u32,
                Functionsˉlimit,
                true
            );
        if !Function.Valid {
            return Compilerˉnativeˉx64ˉfailure(
                Input,
                Compilerˉnativeˉx64ˉstatus.Unsupportedˉfunction
            );
        }
        if Function.Nextˉoffset != Functionsˉlimit {
            return Compilerˉnativeˉx64ˉfailure(
                Input,
                Compilerˉnativeˉx64ˉstatus.Unsupportedˉfunction
            );
        }
        if Function.Codeˉoffset != 0u32 {
            return Compilerˉnativeˉx64ˉfailure(
                Input,
                Compilerˉnativeˉx64ˉstatus.Unsupportedˉfunction
            );
        }
        if Function.Codeˉlength != Structure.Codeˉlength {
            return Compilerˉnativeˉx64ˉfailure(
                Input,
                Compilerˉnativeˉx64ˉstatus.Unsupportedˉfunction
            );
        }
        if !Compilerˉnativeˉx64ˉexportˉisˉsupported(
            Input,
            Exports,
            0u32
        ) {
            return Compilerˉnativeˉx64ˉfailure(
                Input,
                Compilerˉnativeˉx64ˉstatus.Unsupportedˉfunction
            );
        }
        let Codeˉsection: Compilerˉnativeˉx64ˉsection =
            Compilerˉnativeˉx64ˉsection(
                true,
                Structure.Codeˉoffset,
                Function.Codeˉlength,
                0u32
            );
        let Analysis: Compilerˉnativeˉx64ˉcontrolˉanalysis =
            Compilerˉnativeˉx64ˉanalyzeˉcontrolˉcode(
                Input,
                Codeˉsection,
                Function,
                true,
                false,
                0u32,
                Compilerˉnativeˉx64ˉempty(Input)
            );
        if !Analysis.Valid {
            return Compilerˉnativeˉx64ˉfailure(
                Input,
                Compilerˉnativeˉx64ˉstatus.Unsupportedˉcode
            );
        }
        let Singleˉexpectedˉcodeˉbytes: u32 =
            222u32 +
            (Function.Locals + Analysis.I32ˉslots + Analysis.Boolˉslots) * 28u32 +
            Analysis.Bodyˉbytes;
        if Singleˉexpectedˉcodeˉbytes > 33554432u32 {
            return Compilerˉnativeˉx64ˉfailure(
                Input,
                Compilerˉnativeˉx64ˉstatus.Outputˉlimit
            );
        }
        let Singleˉcode: bytes = Compilerˉnativeˉx64ˉemitˉcontrolˉcode(
            Input,
            Codeˉsection,
            Function,
            Analysis,
            true,
            0u32,
            0u32
        );
        if Bytesˉlength(Singleˉcode) != Singleˉexpectedˉcodeˉbytes {
            return Compilerˉnativeˉx64ˉfailure(
                Input,
                Compilerˉnativeˉx64ˉstatus.Outputˉlimit
            );
        }
        let Singleˉobject: bytes = Compilerˉnativeˉx64ˉemitˉobject(
            Input,
            Singleˉcode,
            0u32
        );
        if Bytesˉlength(Singleˉobject) != Singleˉexpectedˉcodeˉbytes + 73u32 {
            return Compilerˉnativeˉx64ˉfailure(
                Input,
                Compilerˉnativeˉx64ˉstatus.Outputˉlimit
            );
        }
        return Compilerˉnativeˉx64ˉsummary(
            Compilerˉnativeˉx64ˉstatus.Valid,
            Singleˉobject,
            0,
            22u32,
            Singleˉexpectedˉcodeˉbytes
        );
    }

    let Helper: Compilerˉnativeˉx64ˉfunction =
        Compilerˉnativeˉx64ˉreadˉfunctionˉat(
            Input,
            Functions.Payloadˉoffset + 4u32,
            Functionsˉlimit,
            false
        );
    if !Helper.Valid {
        return Compilerˉnativeˉx64ˉfailure(
            Input,
            Compilerˉnativeˉx64ˉstatus.Unsupportedˉfunction
        );
    }
    let Main: Compilerˉnativeˉx64ˉfunction =
        Compilerˉnativeˉx64ˉreadˉfunctionˉat(
            Input,
            Helper.Nextˉoffset,
            Functionsˉlimit,
            true
        );
    if !Main.Valid {
        return Compilerˉnativeˉx64ˉfailure(
            Input,
            Compilerˉnativeˉx64ˉstatus.Unsupportedˉfunction
        );
    }
    if Main.Nextˉoffset != Functionsˉlimit {
        return Compilerˉnativeˉx64ˉfailure(
            Input,
            Compilerˉnativeˉx64ˉstatus.Unsupportedˉfunction
        );
    }
    if Helper.Codeˉoffset != 0u32 {
        return Compilerˉnativeˉx64ˉfailure(
            Input,
            Compilerˉnativeˉx64ˉstatus.Unsupportedˉfunction
        );
    }
    if Main.Codeˉoffset != Helper.Codeˉlength {
        return Compilerˉnativeˉx64ˉfailure(
            Input,
            Compilerˉnativeˉx64ˉstatus.Unsupportedˉfunction
        );
    }
    if Main.Codeˉoffset > Structure.Codeˉlength {
        return Compilerˉnativeˉx64ˉfailure(
            Input,
            Compilerˉnativeˉx64ˉstatus.Unsupportedˉfunction
        );
    }
    if Main.Codeˉlength != Structure.Codeˉlength - Main.Codeˉoffset {
        return Compilerˉnativeˉx64ˉfailure(
            Input,
            Compilerˉnativeˉx64ˉstatus.Unsupportedˉfunction
        );
    }
    if !Compilerˉnativeˉx64ˉexportˉisˉsupported(
        Input,
        Exports,
        1u32
    ) {
        return Compilerˉnativeˉx64ˉfailure(
            Input,
            Compilerˉnativeˉx64ˉstatus.Unsupportedˉfunction
        );
    }
    let Helperˉcodeˉsection: Compilerˉnativeˉx64ˉsection =
        Compilerˉnativeˉx64ˉsection(
            true,
            Structure.Codeˉoffset,
            Helper.Codeˉlength,
            0u32
        );
    let Mainˉcodeˉsection: Compilerˉnativeˉx64ˉsection =
        Compilerˉnativeˉx64ˉsection(
            true,
            Structure.Codeˉoffset + Main.Codeˉoffset,
            Main.Codeˉlength,
            0u32
        );
    let Helperˉanalysis: Compilerˉnativeˉx64ˉcontrolˉanalysis =
        Compilerˉnativeˉx64ˉanalyzeˉcontrolˉcode(
            Input,
            Helperˉcodeˉsection,
            Helper,
            false,
            false,
            0u32,
            Compilerˉnativeˉx64ˉempty(Input)
        );
    let Mainˉanalysis: Compilerˉnativeˉx64ˉcontrolˉanalysis =
        Compilerˉnativeˉx64ˉanalyzeˉcontrolˉcode(
            Input,
            Mainˉcodeˉsection,
            Main,
            true,
            true,
            Helper.Parameters,
            Bytesˉslice(Helper.Localˉtypes, 0u32, Helper.Parameters)
        );
    if !Helperˉanalysis.Valid {
        return Compilerˉnativeˉx64ˉfailure(
            Input,
            Compilerˉnativeˉx64ˉstatus.Unsupportedˉcode
        );
    }
    if !Mainˉanalysis.Valid {
        return Compilerˉnativeˉx64ˉfailure(
            Input,
            Compilerˉnativeˉx64ˉstatus.Unsupportedˉcode
        );
    }
    let Helperˉbytes: u32 =
        191u32 +
        (Helper.Locals +
            Helperˉanalysis.I32ˉslots +
            Helperˉanalysis.Boolˉslots) * 28u32 +
        Compilerˉnativeˉx64ˉscalarˉargumentˉbytes(Helper.Parameters) +
        Helperˉanalysis.Bodyˉbytes;
    let Mainˉbytes: u32 =
        222u32 +
        (Main.Locals + Mainˉanalysis.I32ˉslots + Mainˉanalysis.Boolˉslots) *
            28u32 +
        Mainˉanalysis.Bodyˉbytes;
    let Expectedˉcodeˉbytes: u32 = Helperˉbytes + Mainˉbytes;
    if Expectedˉcodeˉbytes > 33554432u32 {
        return Compilerˉnativeˉx64ˉfailure(
            Input,
            Compilerˉnativeˉx64ˉstatus.Outputˉlimit
        );
    }
    let Helperˉcode: bytes = Compilerˉnativeˉx64ˉemitˉcontrolˉcode(
        Input,
        Helperˉcodeˉsection,
        Helper,
        Helperˉanalysis,
        false,
        0u32,
        0u32
    );
    let Mainˉcode: bytes = Compilerˉnativeˉx64ˉemitˉcontrolˉcode(
        Input,
        Mainˉcodeˉsection,
        Main,
        Mainˉanalysis,
        true,
        Helperˉbytes,
        Helper.Parameters
    );
    if Bytesˉlength(Helperˉcode) != Helperˉbytes {
        return Compilerˉnativeˉx64ˉfailure(
            Input,
            Compilerˉnativeˉx64ˉstatus.Outputˉlimit
        );
    }
    if Bytesˉlength(Mainˉcode) != Mainˉbytes {
        return Compilerˉnativeˉx64ˉfailure(
            Input,
            Compilerˉnativeˉx64ˉstatus.Outputˉlimit
        );
    }
    let Code: bytes = Bytesˉconcat(Helperˉcode, Mainˉcode);
    let Object: bytes = Compilerˉnativeˉx64ˉemitˉobject(Input, Code, Helperˉbytes);
    if Bytesˉlength(Object) != Expectedˉcodeˉbytes + 107u32 {
        return Compilerˉnativeˉx64ˉfailure(
            Input,
            Compilerˉnativeˉx64ˉstatus.Outputˉlimit
        );
    }
    return Compilerˉnativeˉx64ˉsummary(
        Compilerˉnativeˉx64ˉstatus.Valid,
        Object,
        0,
        22u32,
        Expectedˉcodeˉbytes
    );
}
