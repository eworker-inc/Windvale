                                                                Analysis.Leaders,
                                                                Blockˉoffsets,
                                                                Branchˉnextˉwvb
                                                            ),
                                                            Compilerˉnativeˉx64ˉmachineˉtarget(
                                                                Analysis.Leaders,
                                                                Blockˉoffsets,
                                                                Branchˉfalseˉwvb
                                                            )
                                                        );
                                                } else {
                                                    if Opcode == 81u8 {
                                                    let Returnˉslot: u32 =
                                                        Bytesˉreadˉu32ˉlittle(
                                                            Stackˉslots,
                                                                (Stackˉdepth - 1u32) * 4u32
                                                            );
                                                        Stackˉdepth = Stackˉdepth - 1u32;
                                                        Stackˉtypes = Bytesˉslice(
                                                            Stackˉtypes,
                                                            0u32,
                                                            Stackˉdepth
                                                        );
                                                        Stackˉslots = Bytesˉslice(
                                                            Stackˉslots,
                                                            0u32,
                                                            Stackˉdepth * 4u32
                                                        );
                                                        if Returnsˉrecord {
                                                            let Returnˉtypeˉindex: u32 =
                                                                Nominalˉtypes.Compilerˉnativeˉx64ˉrecordˉtypeˉindex(
                                                                    Function.Returnˉtype
                                                                );
                                                            Result = Records.Compilerˉnativeˉx64ˉemitˉrecordˉreturn(
                                                                Result,
                                                                Returnˉtypeˉindex,
                                                                Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉitemˉcount(
                                                                    Types,
                                                                    Returnˉtypeˉindex
                                                                ),
                                                                Nominalˉtypes.Compilerˉnativeˉx64ˉrecordˉhasˉdescriptors(
                                                                    Input,
                                                                    Types,
                                                                    Returnˉtypeˉindex
                                                                ),
                                                                Returnˉslot,
                                                                Hiddenˉrecordˉslot,
                                                                Frameˉbytes
                                                            );
                                                        } else {
                                                            Result = Compilerˉnativeˉx64ˉemitˉloadˉeax(
                                                                Result,
                                                                Returnˉslot * 16u32
                                                            );
                                                            Result = Compilerˉnativeˉx64ˉemitˉframe(
                                                                Result,
                                                                false,
                                                                Frameˉbytes
                                                            );
                                                            Result = Compilerˉnativeˉx64ˉemitˉrestoreˉfor(
                                                                Result,
                                                                Isˉmain
                                                            );
                                                        }
                                                    }
                                                }
                                                }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        }
        Cursor = Cursor + Compilerˉnativeˉx64ˉinstructionˉsize(Opcode);
    }

    Result = Compilerˉnativeˉx64ˉemitˉframe(Result, false, Frameˉbytes);
    Result = Compilerˉnativeˉx64ˉemitˉrestoreˉfor(Result, Isˉmain);
    Result = Compilerˉnativeˉx64ˉemitˉstatusˉfor(Result, Frameˉbytes, 1u32, Isˉmain);
    Result = Compilerˉnativeˉx64ˉemitˉstatusˉfor(Result, Frameˉbytes, 2u32, Isˉmain);
    Result = Compilerˉnativeˉx64ˉemitˉstatusˉfor(Result, Frameˉbytes, 4u32, Isˉmain);
    Result = Compilerˉnativeˉx64ˉemitˉstatusˉfor(Result, Frameˉbytes, 6u32, Isˉmain);
    Result = Compilerˉnativeˉx64ˉemitˉstatusˉfor(Result, Frameˉbytes, 5u32, Isˉmain);
    Result = Compilerˉnativeˉx64ˉemitˉstatusˉfor(Result, Frameˉbytes, 8u32, Isˉmain);
    Result = Compilerˉnativeˉx64ˉemitˉstatusˉfor(Result, Frameˉbytes, 7u32, Isˉmain);
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 73u8);
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 255u8);
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 194u8);
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 72u8);
    Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 184u8);
    Result = Compilerˉnativeˉx64ˉappendˉu32(Result, 0u32);
    Result = Compilerˉnativeˉx64ˉappendˉu32(Result, 3u32);
    if Isˉmain {
        Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 65u8);
        Result = Compilerˉnativeˉx64ˉappendˉbyte(Result, 95u8);
    }
    return Compilerˉnativeˉx64ˉappendˉbyte(Result, 195u8);
}

export fn Compilerˉnativeˉx64ˉfunctionˉbytes(
    Function: Compilerˉnativeˉx64ˉfunction,
    Analysis: Compilerˉnativeˉx64ˉcontrolˉanalysis,
    Isˉmain: bool
) -> u32 {
    let Slots: u32 =
        Function.Locals + Analysis.I32ˉslots + Analysis.Boolˉslots +
        Analysis.Textˉslots + Analysis.U8ˉslots + Analysis.U32ˉslots +
        Analysis.Bytesˉslots + Analysis.Enumˉslots + Analysis.Recordˉslots +
        Analysis.Recordˉpersistentˉfields + Analysis.Recordˉscratchˉfields +
        Compilerˉnativeˉx64ˉhiddenˉrecordˉslots(Function.Returnˉtype);
    if Isˉmain {
        return 222u32 + Slots * 28u32 + Analysis.Bodyˉbytes;
    }
    if Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉisˉrecord(
        Function.Returnˉtype
    ) {
        return 182u32 + Slots * 28u32 +
            Compilerˉnativeˉx64ˉscalarˉargumentˉbytes(Function.Parameters) +
            Analysis.Bodyˉbytes;
    }
    return 191u32 +
        Slots * 28u32 +
        Compilerˉnativeˉx64ˉscalarˉargumentˉbytes(Function.Parameters) +
        Analysis.Bodyˉbytes;
}

export fn Compilerˉlowerˉwvbˉnativeˉx64(Input: bytes)
    -> Compilerˉnativeˉx64ˉsummary {
    let Structure: Compilerˉnativeˉx64ˉstructure =
        Compilerˉnativeˉx64ˉreadˉstructure(Input);
    if !Structure.Valid {
        return Compilerˉnativeˉx64ˉfailure(
            Input,
            Compilerˉnativeˉx64ˉstatus.Invalidˉwvb
        );
    }
    let Module: Compilerˉnativeˉx64ˉsection = Compilerˉnativeˉx64ˉsection(
        true,
        Structure.Moduleˉoffset,
        Structure.Moduleˉlength,
        0u32
    );
    if !Compilerˉnativeˉx64ˉmoduleˉisˉvalid(Input, Module) {
        return Compilerˉnativeˉx64ˉfailure(
            Input,
            Compilerˉnativeˉx64ˉstatus.Invalidˉwvb
        );
    }
    let Profile: u8 = Bytesˉreadˉu8(Input, Structure.Moduleˉoffset);
    if Profile != 1u8 && Profile != 2u8 {
        return Compilerˉnativeˉx64ˉfailure(
            Input,
            Compilerˉnativeˉx64ˉstatus.Unsupportedˉprofile
        );
    }
    let Capabilityˉtable: Nativeˉcapabilities.Compilerˉnativeˉx64ˉcapabilities =
        Nativeˉcapabilities.Compilerˉnativeˉx64ˉcapabilitiesˉread(
            Input,
            Structure.Capabilitiesˉoffset,
            Structure.Capabilitiesˉlength
        );
    if !Capabilityˉtable.Valid {
        return Compilerˉnativeˉx64ˉfailure(
            Input,
            Compilerˉnativeˉx64ˉstatus.Unsupportedˉmodule
        );
    }
    if Profile == 1u8 && Capabilityˉtable.Count != 0u32 {
        return Compilerˉnativeˉx64ˉfailure(
            Input,
            Compilerˉnativeˉx64ˉstatus.Unsupportedˉmodule
        );
    }
    if Profile == 2u8 && Capabilityˉtable.Count == 0u32 {
        return Compilerˉnativeˉx64ˉfailure(
            Input,
            Compilerˉnativeˉx64ˉstatus.Unsupportedˉmodule
        );
    }
    let Data: Staticˉdata.Compilerˉnativeˉx64ˉdata =
        Staticˉdata.Compilerˉnativeˉx64ˉdataˉread(
            Input,
            Structure.Dataˉoffset,
            Structure.Dataˉlength
        );
    if !Data.Valid {
        return Compilerˉnativeˉx64ˉfailure(
            Input,
            Compilerˉnativeˉx64ˉstatus.Unsupportedˉmodule
        );
    }
    let Types: Nominalˉtypes.Compilerˉnativeˉx64ˉtypes =
        Nominalˉtypes.Compilerˉnativeˉx64ˉtypesˉread(
            Input,
            Structure.Typesˉoffset,
            Structure.Typesˉlength
        );
    if !Types.Valid {
        return Compilerˉnativeˉx64ˉfailure(
            Input,
            Compilerˉnativeˉx64ˉstatus.Unsupportedˉmodule
        );
    }

    let Functions: Compilerˉnativeˉx64ˉsection = Compilerˉnativeˉx64ˉsection(
        true,
        Structure.Functionsˉoffset,
        Structure.Functionsˉlength,
        0u32
    );
    if Functions.Payloadˉlength < 4u32 {
        return Compilerˉnativeˉx64ˉfailure(
            Input,
            Compilerˉnativeˉx64ˉstatus.Unsupportedˉfunction
        );
    }
    let Functionˉcount: u32 = Bytesˉreadˉu32ˉlittle(
        Input,
        Functions.Payloadˉoffset
    );
    if Functionˉcount == 0u32 {
        return Compilerˉnativeˉx64ˉfailure(
            Input,
            Compilerˉnativeˉx64ˉstatus.Unsupportedˉfunction
        );
    }
    if Functionˉcount > 8u32 {
        return Compilerˉnativeˉx64ˉfailure(
            Input,
            Compilerˉnativeˉx64ˉstatus.Unsupportedˉfunction
        );
    }
    let Functionsˉlimit: u32 =
        Functions.Payloadˉoffset + Functions.Payloadˉlength;
    let Exports: Compilerˉnativeˉx64ˉsection = Compilerˉnativeˉx64ˉsection(
        true,
        Structure.Exportsˉoffset,
        Structure.Exportsˉlength,
        0u32
    );
    if Exports.Payloadˉlength != 17u32 {
        return Compilerˉnativeˉx64ˉfailure(
            Input,
            Compilerˉnativeˉx64ˉstatus.Unsupportedˉfunction
        );
    }
    let Mainˉfunction: u32 = Bytesˉreadˉu32ˉlittle(
        Input,
        Exports.Payloadˉoffset + 13u32
    );
    if Mainˉfunction >= Functionˉcount {
        return Compilerˉnativeˉx64ˉfailure(
            Input,
            Compilerˉnativeˉx64ˉstatus.Unsupportedˉfunction
        );
    }
    if !Compilerˉnativeˉx64ˉexportˉisˉsupported(
        Input,
        Exports,
        Mainˉfunction
    ) {
        return Compilerˉnativeˉx64ˉfailure(
            Input,
            Compilerˉnativeˉx64ˉstatus.Unsupportedˉfunction
        );
    }

    var Signatures: bytes = Compilerˉnativeˉx64ˉempty(Input);
    var Functionˉcursor: u32 = Functions.Payloadˉoffset + 4u32;
    var Expectedˉwvbˉcodeˉoffset: u32 = 0u32;
    var Functionˉindex: u32 = 0u32;
    while Functionˉindex < Functionˉcount {
        let Isˉmain: bool = Functionˉindex == Mainˉfunction;
        let Function: Compilerˉnativeˉx64ˉfunction =
            Compilerˉnativeˉx64ˉreadˉfunctionˉat(
                Input,
                Functionˉcursor,
                Functionsˉlimit,
                Isˉmain,
                Types
            );
        if !Function.Valid {
            return Compilerˉnativeˉx64ˉfailure(
                Input,
                Compilerˉnativeˉx64ˉstatus.Unsupportedˉfunction
            );
        }
        if Function.Codeˉoffset != Expectedˉwvbˉcodeˉoffset {
            return Compilerˉnativeˉx64ˉfailure(
                Input,
                Compilerˉnativeˉx64ˉstatus.Unsupportedˉfunction
            );
        }
        if Function.Codeˉoffset > Structure.Codeˉlength {
            return Compilerˉnativeˉx64ˉfailure(
                Input,
                Compilerˉnativeˉx64ˉstatus.Unsupportedˉfunction
            );
        }
        if Function.Codeˉlength >
            Structure.Codeˉlength - Function.Codeˉoffset {
            return Compilerˉnativeˉx64ˉfailure(
                Input,
                Compilerˉnativeˉx64ˉstatus.Unsupportedˉfunction
            );
        }
        Signatures = Layout.Compilerˉnativeˉx64ˉlayoutˉappend(
            Signatures,
            0u32,
            0u32,
            Function.Parameters,
            Function.Returnˉtype,
            Bytesˉslice(Function.Localˉtypes, 0u32, Function.Parameters)
        );
        Expectedˉwvbˉcodeˉoffset =
            Expectedˉwvbˉcodeˉoffset + Function.Codeˉlength;
        Functionˉcursor = Function.Nextˉoffset;
        Functionˉindex = Functionˉindex + 1u32;
    }
    if Functionˉcursor != Functionsˉlimit {
        return Compilerˉnativeˉx64ˉfailure(
            Input,
            Compilerˉnativeˉx64ˉstatus.Unsupportedˉfunction
        );
    }
    if Expectedˉwvbˉcodeˉoffset != Structure.Codeˉlength {
        return Compilerˉnativeˉx64ˉfailure(
            Input,
            Compilerˉnativeˉx64ˉstatus.Unsupportedˉfunction
        );
    }
    if Bytesˉlength(Signatures) !=
        Functionˉcount * Layout.Compilerˉnativeˉx64ˉlayoutˉentryˉbytes() {
        return Compilerˉnativeˉx64ˉfailure(
            Input,
            Compilerˉnativeˉx64ˉstatus.Outputˉlimit
        );
    }

    var Directory: bytes = Compilerˉnativeˉx64ˉempty(Input);
    var Expectedˉmachineˉcodeˉbytes: u32 = 0u32;
    Functionˉcursor = Functions.Payloadˉoffset + 4u32;
    Functionˉindex = 0u32;
    while Functionˉindex < Functionˉcount {
        let Isˉmeasureˉmain: bool = Functionˉindex == Mainˉfunction;
        let Measureˉfunction: Compilerˉnativeˉx64ˉfunction =
            Compilerˉnativeˉx64ˉreadˉfunctionˉat(
                Input,
                Functionˉcursor,
                Functionsˉlimit,
                Isˉmeasureˉmain,
                Types
            );
        let Measureˉcodeˉsection: Compilerˉnativeˉx64ˉsection =
            Compilerˉnativeˉx64ˉsection(
                true,
                Structure.Codeˉoffset + Measureˉfunction.Codeˉoffset,
                Measureˉfunction.Codeˉlength,
                0u32
            );
        let Measureˉanalysis: Compilerˉnativeˉx64ˉcontrolˉanalysis =
            Compilerˉnativeˉx64ˉanalyzeˉcontrolˉcode(
                Input,
                Measureˉcodeˉsection,
                Measureˉfunction,
                Isˉmeasureˉmain,
                Functionˉcount,
                Signatures,
                Data,
                Types,
                Capabilityˉtable
            );
        if !Measureˉanalysis.Valid {
            return Compilerˉnativeˉx64ˉfailure(
                Input,
                Compilerˉnativeˉx64ˉstatus.Unsupportedˉcode
            );
        }
        let Machineˉbytes: u32 = Compilerˉnativeˉx64ˉfunctionˉbytes(
            Measureˉfunction,
            Measureˉanalysis,
            Isˉmeasureˉmain
        );
        if Expectedˉmachineˉcodeˉbytes > 33554432u32 {
            return Compilerˉnativeˉx64ˉfailure(
                Input,
                Compilerˉnativeˉx64ˉstatus.Outputˉlimit
            );
        }
        if Machineˉbytes >
            33554432u32 - Expectedˉmachineˉcodeˉbytes {
            return Compilerˉnativeˉx64ˉfailure(
                Input,
                Compilerˉnativeˉx64ˉstatus.Outputˉlimit
            );
        }
        Directory = Layout.Compilerˉnativeˉx64ˉlayoutˉappend(
            Directory,
            Expectedˉmachineˉcodeˉbytes,
            Machineˉbytes,
            Measureˉfunction.Parameters,
            Measureˉfunction.Returnˉtype,
            Bytesˉslice(
                Measureˉfunction.Localˉtypes,
                0u32,
                Measureˉfunction.Parameters
            )
        );
        Expectedˉmachineˉcodeˉbytes =
            Expectedˉmachineˉcodeˉbytes + Machineˉbytes;
        Functionˉcursor = Measureˉfunction.Nextˉoffset;
        Functionˉindex = Functionˉindex + 1u32;
    }
    if Bytesˉlength(Directory) !=
        Functionˉcount * Layout.Compilerˉnativeˉx64ˉlayoutˉentryˉbytes() {
        return Compilerˉnativeˉx64ˉfailure(
            Input,
            Compilerˉnativeˉx64ˉstatus.Outputˉlimit
        );
    }

    var Code: bytes = Compilerˉnativeˉx64ˉempty(Input);
    var Relocations: bytes = Compilerˉnativeˉx64ˉempty(Input);
    Functionˉcursor = Functions.Payloadˉoffset + 4u32;
    Functionˉindex = 0u32;
    while Functionˉindex < Functionˉcount {
        let Isˉemitˉmain: bool = Functionˉindex == Mainˉfunction;
        let Emitˉfunction: Compilerˉnativeˉx64ˉfunction =
            Compilerˉnativeˉx64ˉreadˉfunctionˉat(
                Input,
                Functionˉcursor,
                Functionsˉlimit,
                Isˉemitˉmain,
                Types
            );
        let Emitˉcodeˉsection: Compilerˉnativeˉx64ˉsection =
            Compilerˉnativeˉx64ˉsection(
                true,
                Structure.Codeˉoffset + Emitˉfunction.Codeˉoffset,
                Emitˉfunction.Codeˉlength,
                0u32
            );
        let Emitˉanalysis: Compilerˉnativeˉx64ˉcontrolˉanalysis =
            Compilerˉnativeˉx64ˉanalyzeˉcontrolˉcode(
                Input,
                Emitˉcodeˉsection,
                Emitˉfunction,
                Isˉemitˉmain,
                Functionˉcount,
                Directory,
                Data,
                Types,
                Capabilityˉtable
            );
        Relocations = Bytesˉconcat(
            Relocations,
            Compilerˉnativeˉx64ˉcollectˉdataˉrelocations(
                Input,
                Emitˉcodeˉsection,
                Emitˉfunction,
                Emitˉanalysis,
                Isˉemitˉmain,
                Layout.Compilerˉnativeˉx64ˉlayoutˉmachineˉoffset(
                    Directory,
                    Functionˉindex
                ),
                Directory,
                Types,
                Capabilityˉtable
            )
        );
        let Functionˉcode: bytes =
            Compilerˉnativeˉx64ˉemitˉcontrolˉcode(
                Input,
                Emitˉcodeˉsection,
                Emitˉfunction,
                Emitˉanalysis,
                Isˉemitˉmain,
                Layout.Compilerˉnativeˉx64ˉlayoutˉmachineˉoffset(
                    Directory,
                    Functionˉindex
                ),
                Directory,
                Data,
                Types,
                Capabilityˉtable
            );
        if Bytesˉlength(Functionˉcode) !=
            Layout.Compilerˉnativeˉx64ˉlayoutˉmachineˉlength(
                Directory,
                Functionˉindex
            ) {
            return Compilerˉnativeˉx64ˉfailure(
                Input,
                Compilerˉnativeˉx64ˉstatus.Outputˉlimit
            );
        }
        Code = Bytesˉconcat(Code, Functionˉcode);
        Functionˉcursor = Emitˉfunction.Nextˉoffset;
        Functionˉindex = Functionˉindex + 1u32;
    }
    if Bytesˉlength(Code) != Expectedˉmachineˉcodeˉbytes {
        return Compilerˉnativeˉx64ˉfailure(
            Input,
            Compilerˉnativeˉx64ˉstatus.Outputˉlimit
        );
    }
    if Data.Count > 0u32 {
        while Bytesˉlength(Code) % 16u32 != 0u32 {
            Code = Bytesˉconcat(Code, Bytesˉfromˉu8(144u8));
        }
    }
    let Textˉbytes: u32 = Bytesˉlength(Code);
    let Object: bytes = Objectˉwriter.Compilerˉnativeˉx64ˉobjectˉemit(
        Code,
        Directory,
        Functionˉcount,
        Mainˉfunction,
        Data,
        Relocations
    );
    var Objectˉoverhead: u32 = 73u32 + (Functionˉcount - 1u32) * 34u32;
    if Data.Count > 0u32 {
        Objectˉoverhead = Objectˉoverhead + 27u32 + Bytesˉlength(Data.Bytes) +
            Data.Count * 30u32 + Bytesˉlength(Relocations) / 8u32 * 20u32;
    }
    if Bytesˉlength(Object) != Textˉbytes + Objectˉoverhead {
        return Compilerˉnativeˉx64ˉfailure(
            Input,
            Compilerˉnativeˉx64ˉstatus.Outputˉlimit
        );
    }
    return Compilerˉnativeˉx64ˉsummary(
        Compilerˉnativeˉx64ˉstatus.Valid,
        Object,
        0,
        22u32,
        Textˉbytes
    );
}
