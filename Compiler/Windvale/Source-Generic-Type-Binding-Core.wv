module Compilerˉsourceˉgenericˉtypeˉbinding profile portable;

import Compilerˉsourceˉbodyˉparser as Sourceˉbodies;
import Compilerˉsourceˉdeclarationˉparser as Sourceˉdeclarations;
import Compilerˉsourceˉgenericˉlowering as Sourceˉgenerics;
import Compilerˉsourceˉgenericˉtypeˉlowering as Genericˉtypes;
import Compilerˉsourceˉlexer as Sourceˉlexer;
import Compilerˉsourceˉset as Sourceˉset;
import Compilerˉsourceˉsymbols as Sourceˉsymbols;

export record Compilerˉsourceˉgenericˉtypeˉbinding {
    Status: Sourceˉsymbols.Compilerˉsourceˉsymbolˉstatus;
    Genericˉstatus: Sourceˉgenerics.Compilerˉsourceˉgenericˉstatus;
    Shape: u32;
    Nominalˉkind: Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind;
    Declaration: u32;
    Module: u32;
    Catalogˉstatus: Sourceˉgenerics.Compilerˉsourceˉgenericˉstatus;
    Catalogˉevidence: bytes;
    Nextˉoffset: u32;
    Nextˉline: u32;
    Nextˉcolumn: u32;
    Failureˉoffset: u32;
    Failureˉline: u32;
    Failureˉcolumn: u32;
}

fn Compilerˉsourceˉgenericˉtypeˉbindingˉvalue(
    Status: Sourceˉsymbols.Compilerˉsourceˉsymbolˉstatus,
    Genericˉstatus: Sourceˉgenerics.Compilerˉsourceˉgenericˉstatus,
    Shape: u32,
    Nominalˉkind: Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind,
    Declaration: u32,
    Module: u32,
    Catalog: Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog,
    Nextˉoffset: u32,
    Nextˉline: u32,
    Nextˉcolumn: u32,
    Failureˉoffset: u32,
    Failureˉline: u32,
    Failureˉcolumn: u32
) -> Compilerˉsourceˉgenericˉtypeˉbinding {
    return Compilerˉsourceˉgenericˉtypeˉbinding(
        Status, Genericˉstatus, Shape, Nominalˉkind,
        Declaration, Module, Catalog.Status, Catalog.Evidence,
        Nextˉoffset, Nextˉline, Nextˉcolumn,
        Failureˉoffset, Failureˉline, Failureˉcolumn
    );
}

export fn Compilerˉsourceˉgenericˉtypeˉbindingˉcatalog(
    Binding: Compilerˉsourceˉgenericˉtypeˉbinding
) -> Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog {
    return Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog(
        Binding.Catalogˉstatus,
        Binding.Catalogˉevidence
    );
}

fn Compilerˉsourceˉgenericˉtypeˉbindingˉfromˉsymbol(
    Binding: Sourceˉsymbols.Compilerˉsourceˉtypeˉbinding,
    Source: bytes,
    Catalog: Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog
) -> Compilerˉsourceˉgenericˉtypeˉbinding {
    var Nextˉoffset: u32 = Binding.Nextˉoffset;
    var Nextˉline: u32 = Binding.Nextˉline;
    var Nextˉcolumn: u32 = Binding.Nextˉcolumn;
    if Binding.Status ==
            Sourceˉsymbols.Compilerˉsourceˉsymbolˉstatus.Valid &&
        Nextˉoffset >= 2u32 && Nextˉcolumn > 1u32 &&
        Bytesˉreadˉu8(Source, Nextˉoffset - 2u32) == 62u8 &&
        Bytesˉreadˉu8(Source, Nextˉoffset - 1u32) == 62u8 {
        Nextˉoffset = Nextˉoffset - 1u32;
        Nextˉcolumn = Nextˉcolumn - 1u32;
    }
    return Compilerˉsourceˉgenericˉtypeˉbindingˉvalue(
        Binding.Status,
        Sourceˉgenerics.Compilerˉsourceˉgenericˉstatus.Valid,
        Sourceˉsymbols.Compilerˉsourceˉsymbolsˉtypeˉshape(Binding),
        Binding.Nominalˉkind, 4294967295u32, Binding.Nominalˉmodule,
        Catalog,
        Nextˉoffset, Nextˉline, Nextˉcolumn,
        Binding.Failureˉoffset, Binding.Failureˉline,
        Binding.Failureˉcolumn
    );
}

fn Compilerˉsourceˉgenericˉtypeˉbindingˉfailure(
    Genericˉstatus: Sourceˉgenerics.Compilerˉsourceˉgenericˉstatus,
    Catalog: Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog,
    Token: Sourceˉlexer.Compilerˉsourceˉtoken
) -> Compilerˉsourceˉgenericˉtypeˉbinding {
    return Compilerˉsourceˉgenericˉtypeˉbindingˉvalue(
        Sourceˉsymbols.Compilerˉsourceˉsymbolˉstatus.Unknownˉtype,
        Genericˉstatus, 0u32,
        Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.End,
        4294967295u32, 4294967295u32, Catalog,
        Token.Nextˉoffset, Token.Nextˉline, Token.Nextˉcolumn,
        Token.Offset, Token.Line, Token.Column
    );
}

fn Compilerˉsourceˉgenericˉtypeˉbindingˉpreserveˉcatalog(
    Binding: Compilerˉsourceˉgenericˉtypeˉbinding,
    Catalog: Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog
) -> Compilerˉsourceˉgenericˉtypeˉbinding {
    return Compilerˉsourceˉgenericˉtypeˉbindingˉvalue(
        Binding.Status, Binding.Genericˉstatus, Binding.Shape,
        Binding.Nominalˉkind, Binding.Declaration, Binding.Module, Catalog,
        Binding.Nextˉoffset, Binding.Nextˉline, Binding.Nextˉcolumn,
        Binding.Failureˉoffset, Binding.Failureˉline,
        Binding.Failureˉcolumn
    );
}

fn Compilerˉsourceˉgenericˉtypeˉbindingˉsolutionˉfailure(
    Source: bytes,
    Status: Sourceˉgenerics.Compilerˉsourceˉgenericˉstatus
) -> Sourceˉgenerics.Compilerˉsourceˉgenericˉsolution {
    return Sourceˉgenerics.Compilerˉsourceˉgenericˉsolution(
        Status, Bytesˉslice(Source, 0u32, 0u32)
    );
}

fn Compilerˉsourceˉgenericˉtypeˉbindingˉtypeˉsolution(
    Source: bytes,
    Generic: Sourceˉsymbols.Compilerˉsourceˉfunctionˉgeneric,
    Catalog: Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog,
    Instance: u32
) -> Sourceˉgenerics.Compilerˉsourceˉgenericˉsolution {
    var Solution: Sourceˉgenerics.Compilerˉsourceˉgenericˉsolution =
        Sourceˉsymbols.Compilerˉsourceˉsymbolsˉgenericˉsolution(
            Source, Generic
        );
    if Solution.Status !=
        Sourceˉgenerics.Compilerˉsourceˉgenericˉstatus.Valid {
        return Solution;
    }
    var Parameter: u32 = 0u32;
    while Parameter < Generic.Parameters {
        let Declared:
            Sourceˉsymbols.Compilerˉsourceˉgenericˉparameterˉmatch =
            Sourceˉsymbols.Compilerˉsourceˉsymbolsˉgenericˉparameterˉat(
                Source, Generic, Parameter
            );
        let Argument: Sourceˉgenerics.Compilerˉsourceˉgenericˉargument =
            Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalogˉargument(
                Catalog, Instance, Parameter
            );
        if !Declared.Found || !Argument.Valid {
            return Compilerˉsourceˉgenericˉtypeˉbindingˉsolutionˉfailure(
                Source,
                Sourceˉgenerics.Compilerˉsourceˉgenericˉstatus.Invalidˉevidence
            );
        }
        Solution =
            Sourceˉgenerics.Compilerˉsourceˉgenericˉsolutionˉcontribute(
                Solution, Parameter, Argument.Kind,
                Argument.Low, Argument.High,
                Parameter, Generic.Firstˉoffset
            );
        if Solution.Status !=
            Sourceˉgenerics.Compilerˉsourceˉgenericˉstatus.Valid {
            return Solution;
        }
        Parameter = Parameter + 1u32;
    }
    return Sourceˉgenerics.Compilerˉsourceˉgenericˉsolutionˉfinish(
        Solution
    );
}

fn Compilerˉsourceˉgenericˉtypeˉbindˉnested(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Owner: u32,
    Source: bytes,
    Offset: u32,
    Line: u32,
    Column: u32,
    Catalog: Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog,
    Depth: u32,
    Specializationˉsource: bytes,
    Specializationˉgeneric:
        Sourceˉsymbols.Compilerˉsourceˉfunctionˉgeneric,
    Specializationˉsolution:
        Sourceˉgenerics.Compilerˉsourceˉgenericˉsolution,
    Inˉspecialization: bool,
    Functionˉcatalog: Sourceˉgenerics.Compilerˉsourceˉgenericˉcatalog,
    Functionˉinstance: u32,
    Inˉfunctionˉspecialization: bool
) -> Compilerˉsourceˉgenericˉtypeˉbinding {
    let Token: Sourceˉlexer.Compilerˉsourceˉtoken =
        Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Source, Offset, Line, Column
        );
    if Depth > 32u32 {
        return Compilerˉsourceˉgenericˉtypeˉbindingˉfailure(
            Sourceˉgenerics.Compilerˉsourceˉgenericˉstatus.Instantiationˉdepth,
            Catalog, Token
        );
    }
    if !Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalogˉisˉvalid(
        Catalog
    ) {
        return Compilerˉsourceˉgenericˉtypeˉbindingˉfailure(
            Sourceˉgenerics.Compilerˉsourceˉgenericˉstatus.Invalidˉevidence,
            Catalog, Token
        );
    }
    let Ordinary: Sourceˉsymbols.Compilerˉsourceˉtypeˉbinding =
        Sourceˉsymbols.Compilerˉsourceˉsymbolsˉbindˉtype(
            Input, Scan, Symbols.Directory, Symbols.Lookup,
            Symbols.Visibility, Owner, Source, Offset, Line, Column,
            Symbols.Records, Symbols.Enums, false
        );
    if Ordinary.Status !=
            Sourceˉsymbols.Compilerˉsourceˉsymbolˉstatus.Unknownˉtype {
        return Compilerˉsourceˉgenericˉtypeˉbindingˉfromˉsymbol(
            Ordinary, Source, Catalog
        );
    }
    if Token.Kind != Sourceˉlexer.Compilerˉtokenˉkind.Identifier {
        return Compilerˉsourceˉgenericˉtypeˉbindingˉfromˉsymbol(
            Ordinary, Source, Catalog
        );
    }
    if Inˉspecialization || Inˉfunctionˉspecialization {
        let Specializationˉparameter:
            Sourceˉsymbols.Compilerˉsourceˉgenericˉparameterˉmatch =
            Sourceˉsymbols.Compilerˉsourceˉsymbolsˉgenericˉparameter(
                Specializationˉsource, Specializationˉgeneric,
                Token.Offset, Token.Length
            );
        if Specializationˉparameter.Found {
            var Specializationˉargument:
                Sourceˉgenerics.Compilerˉsourceˉgenericˉargument =
                Sourceˉgenerics.Compilerˉsourceˉgenericˉsolutionˉargument(
                    Specializationˉsolution,
                    Specializationˉparameter.Index
                );
            if Inˉfunctionˉspecialization {
                Specializationˉargument =
                    Sourceˉgenerics.Compilerˉsourceˉgenericˉcatalogˉargument(
                        Functionˉcatalog, Functionˉinstance,
                        Specializationˉparameter.Index
                    );
            }
            if !Specializationˉparameter.Isˉtype ||
                !Specializationˉargument.Valid ||
                Specializationˉargument.Kind != 1u32 ||
                Specializationˉargument.Low == 0u32 {
                return Compilerˉsourceˉgenericˉtypeˉbindingˉfailure(
                    Sourceˉgenerics.Compilerˉsourceˉgenericˉstatus.Kindˉmismatch,
                    Catalog, Token
                );
            }
            return Compilerˉsourceˉgenericˉtypeˉbindingˉvalue(
                Sourceˉsymbols.Compilerˉsourceˉsymbolˉstatus.Valid,
                Sourceˉgenerics.Compilerˉsourceˉgenericˉstatus.Valid,
                Specializationˉargument.Low,
                Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.End,
                4294967295u32, Owner, Catalog,
                Token.Nextˉoffset, Token.Nextˉline, Token.Nextˉcolumn,
                Token.Nextˉoffset, Token.Nextˉline, Token.Nextˉcolumn
            );
        }
    }
    let Qualified: Sourceˉdeclarations.Compilerˉparseˉstep =
        Sourceˉdeclarations.Compilerˉparseˉqualifiedˉname(
            Source, Offset, Line, Column, false
        );
    let Qualifiedˉlength: u32 = Qualified.Nextˉoffset - Token.Offset;
    let Match: Sourceˉsymbols.Compilerˉsourceˉsymbolˉmatch =
        Sourceˉsymbols.Compilerˉsourceˉsymbolsˉfindˉownedˉnominal(
            Input, Scan, Symbols.Directory, Symbols.Lookup,
            Owner, Source, Token.Offset, Qualifiedˉlength
        );
    if !Match.Found ||
        !Sourceˉsymbols.Compilerˉsourceˉsymbolsˉownedˉmatchˉisˉaccessible(
            Input, Scan, Symbols.Visibility, Symbols.Lookup,
            Owner, Source, Token.Offset, Qualifiedˉlength, Match
        ) {
        return Compilerˉsourceˉgenericˉtypeˉbindingˉfromˉsymbol(
            Ordinary, Source, Catalog
        );
    }
    let Target: Sourceˉset.Compilerˉsourceˉsetˉview =
        Sourceˉset.Compilerˉsourceˉsetˉmodule(Input, Scan, Match.Module);
    let Declarationˉposition: Sourceˉbodies.Compilerˉsourceˉposition =
        Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
            Target.Source, 0u32, 1u32, 1u32, Match.Declarationˉoffset
        );
    let Declaration: Sourceˉdeclarations.Compilerˉsourceˉdeclaration =
        Sourceˉdeclarations.Compilerˉparseˉnextˉdeclarationˉvalidated(
            Target.Source, Match.Declarationˉoffset,
            Declarationˉposition.Line, Declarationˉposition.Column, true
        );
    let Generic: Sourceˉsymbols.Compilerˉsourceˉfunctionˉgeneric =
        Sourceˉsymbols.Compilerˉsourceˉsymbolsˉfunctionˉgeneric(
            Target.Source, Declaration,
            Declarationˉposition.Line, Declarationˉposition.Column
        );
    let Argumentsˉstart: Sourceˉlexer.Compilerˉsourceˉtoken =
        Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Source, Qualified.Nextˉoffset,
            Qualified.Nextˉline, Qualified.Nextˉcolumn
        );
    if Generic.Parameters == 0u32 ||
        Argumentsˉstart.Kind != Sourceˉlexer.Compilerˉtokenˉkind.Less {
        return Compilerˉsourceˉgenericˉtypeˉbindingˉfromˉsymbol(
            Ordinary, Source, Catalog
        );
    }
    var Solution: Sourceˉgenerics.Compilerˉsourceˉgenericˉsolution =
        Sourceˉsymbols.Compilerˉsourceˉsymbolsˉgenericˉsolution(
            Target.Source, Generic
        );
    if Solution.Status !=
        Sourceˉgenerics.Compilerˉsourceˉgenericˉstatus.Valid {
        return Compilerˉsourceˉgenericˉtypeˉbindingˉfailure(
            Solution.Status, Catalog, Argumentsˉstart
        );
    }
    var Workingˉcatalog: Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog =
        Catalog;
    var Cursor: u32 = Argumentsˉstart.Nextˉoffset;
    var Currentˉline: u32 = Argumentsˉstart.Nextˉline;
    var Currentˉcolumn: u32 = Argumentsˉstart.Nextˉcolumn;
    var End: Sourceˉlexer.Compilerˉsourceˉtoken = Argumentsˉstart;
    var Closeˉnextˉoffset: u32 = Argumentsˉstart.Nextˉoffset;
    var Closeˉnextˉline: u32 = Argumentsˉstart.Nextˉline;
    var Closeˉnextˉcolumn: u32 = Argumentsˉstart.Nextˉcolumn;
    var Parameter: u32 = 0u32;
    while Parameter < Generic.Parameters {
        let Argumentˉtoken: Sourceˉlexer.Compilerˉsourceˉtoken =
            Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                Source, Cursor, Currentˉline, Currentˉcolumn
            );
        if Argumentˉtoken.Kind ==
            Sourceˉlexer.Compilerˉtokenˉkind.Greater {
            return Compilerˉsourceˉgenericˉtypeˉbindingˉfailure(
                Sourceˉgenerics.Compilerˉsourceˉgenericˉstatus.Explicitˉarity,
                Catalog, Argumentˉtoken
            );
        }
        let Declared: Sourceˉsymbols.Compilerˉsourceˉgenericˉparameterˉmatch =
            Sourceˉsymbols.Compilerˉsourceˉsymbolsˉgenericˉparameterˉat(
                Target.Source, Generic, Parameter
            );
        if !Declared.Found {
            return Compilerˉsourceˉgenericˉtypeˉbindingˉfailure(
                Sourceˉgenerics.Compilerˉsourceˉgenericˉstatus.Invalidˉevidence,
                Catalog, Argumentˉtoken
            );
        }
        var Nextˉoffset: u32 = Argumentˉtoken.Nextˉoffset;
        var Nextˉline: u32 = Argumentˉtoken.Nextˉline;
        var Nextˉcolumn: u32 = Argumentˉtoken.Nextˉcolumn;
        if Declared.Isˉtype {
            if Argumentˉtoken.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Integer {
                return Compilerˉsourceˉgenericˉtypeˉbindingˉfailure(
                    Sourceˉgenerics.Compilerˉsourceˉgenericˉstatus.Kindˉmismatch,
                    Catalog, Argumentˉtoken
                );
            }
            let Nested: Compilerˉsourceˉgenericˉtypeˉbinding =
                Compilerˉsourceˉgenericˉtypeˉbindˉnested(
                    Input, Scan, Symbols, Owner, Source,
                    Cursor, Currentˉline, Currentˉcolumn,
                    Workingˉcatalog, Depth + 1u32,
                    Specializationˉsource, Specializationˉgeneric,
                    Specializationˉsolution, Inˉspecialization,
                    Functionˉcatalog, Functionˉinstance,
                    Inˉfunctionˉspecialization
                );
            if Nested.Status !=
                    Sourceˉsymbols.Compilerˉsourceˉsymbolˉstatus.Valid ||
                Nested.Genericˉstatus !=
                    Sourceˉgenerics.Compilerˉsourceˉgenericˉstatus.Valid {
                return Compilerˉsourceˉgenericˉtypeˉbindingˉpreserveˉcatalog(
                    Nested, Catalog
                );
            }
            Solution =
                Sourceˉgenerics.Compilerˉsourceˉgenericˉsolutionˉcontribute(
                    Solution, Parameter, 1u32, Nested.Shape, 0u32,
                    Parameter, Argumentˉtoken.Offset
                );
            Workingˉcatalog =
                Compilerˉsourceˉgenericˉtypeˉbindingˉcatalog(Nested);
            Nextˉoffset = Nested.Nextˉoffset;
            Nextˉline = Nested.Nextˉline;
            Nextˉcolumn = Nested.Nextˉcolumn;
        } else {
            var Constantˉlow: u32 = Argumentˉtoken.Numericˉvalue;
            var Constantˉhigh: u32 = Argumentˉtoken.Numericˉhigh;
            var Constantˉvalid: bool = Argumentˉtoken.Kind ==
                Sourceˉlexer.Compilerˉtokenˉkind.Integer &&
                Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnumericˉshape(
                    Argumentˉtoken.Numericˉkind
                ) == Declared.Shape;
            if (Inˉspecialization || Inˉfunctionˉspecialization) &&
                Argumentˉtoken.Kind ==
                    Sourceˉlexer.Compilerˉtokenˉkind.Identifier {
                let Constantˉspecializationˉparameter:
                    Sourceˉsymbols.Compilerˉsourceˉgenericˉparameterˉmatch =
                    Sourceˉsymbols.Compilerˉsourceˉsymbolsˉgenericˉparameter(
                        Specializationˉsource, Specializationˉgeneric,
                        Argumentˉtoken.Offset, Argumentˉtoken.Length
                    );
                if Constantˉspecializationˉparameter.Found &&
                    !Constantˉspecializationˉparameter.Isˉtype &&
                    Constantˉspecializationˉparameter.Shape == Declared.Shape {
                    var Constantˉspecializationˉargument:
                        Sourceˉgenerics.Compilerˉsourceˉgenericˉargument =
                        Sourceˉgenerics.Compilerˉsourceˉgenericˉsolutionˉargument(
                            Specializationˉsolution,
                            Constantˉspecializationˉparameter.Index
                        );
                    if Inˉfunctionˉspecialization {
                        Constantˉspecializationˉargument =
                            Sourceˉgenerics.Compilerˉsourceˉgenericˉcatalogˉargument(
                                Functionˉcatalog, Functionˉinstance,
                                Constantˉspecializationˉparameter.Index
                            );
                    }
                    if Constantˉspecializationˉargument.Valid &&
                        Constantˉspecializationˉargument.Kind == 2u32 &&
                        Constantˉspecializationˉargument.Shape ==
                            Declared.Shape {
                        Constantˉlow = Constantˉspecializationˉargument.Low;
                        Constantˉhigh = Constantˉspecializationˉargument.High;
                        Constantˉvalid = true;
                    }
                }
            }
            if !Constantˉvalid {
                return Compilerˉsourceˉgenericˉtypeˉbindingˉfailure(
                    Sourceˉgenerics.Compilerˉsourceˉgenericˉstatus.Kindˉmismatch,
                    Catalog, Argumentˉtoken
                );
            }
            Solution =
                Sourceˉgenerics.Compilerˉsourceˉgenericˉsolutionˉcontribute(
                    Solution, Parameter, 2u32,
                    Constantˉlow, Constantˉhigh,
                    Parameter, Argumentˉtoken.Offset
                );
        }
        if Solution.Status !=
            Sourceˉgenerics.Compilerˉsourceˉgenericˉstatus.Valid {
            return Compilerˉsourceˉgenericˉtypeˉbindingˉfailure(
                Solution.Status, Catalog, Argumentˉtoken
            );
        }
        let Separator: Sourceˉlexer.Compilerˉsourceˉtoken =
            Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                Source, Nextˉoffset, Nextˉline, Nextˉcolumn
            );
        if Parameter + 1u32 < Generic.Parameters {
            if Separator.Kind != Sourceˉlexer.Compilerˉtokenˉkind.Comma {
                return Compilerˉsourceˉgenericˉtypeˉbindingˉfailure(
                    Sourceˉgenerics.Compilerˉsourceˉgenericˉstatus.Explicitˉarity,
                    Catalog, Separator
                );
            }
            Cursor = Separator.Nextˉoffset;
            Currentˉline = Separator.Nextˉline;
            Currentˉcolumn = Separator.Nextˉcolumn;
        } else {
            End = Separator;
            if Separator.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Comma {
                End = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                    Source, Separator.Nextˉoffset,
                    Separator.Nextˉline, Separator.Nextˉcolumn
                );
            }
            Closeˉnextˉoffset = End.Nextˉoffset;
            Closeˉnextˉline = End.Nextˉline;
            Closeˉnextˉcolumn = End.Nextˉcolumn;
            if End.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Shiftˉright {
                Closeˉnextˉoffset = End.Offset + 1u32;
                Closeˉnextˉline = End.Line;
                Closeˉnextˉcolumn = End.Column + 1u32;
            } else if End.Kind !=
                Sourceˉlexer.Compilerˉtokenˉkind.Greater {
                return Compilerˉsourceˉgenericˉtypeˉbindingˉfailure(
                    Sourceˉgenerics.Compilerˉsourceˉgenericˉstatus.Explicitˉarity,
                    Catalog, End
                );
            }
        }
        Parameter = Parameter + 1u32;
    }
    Solution =
        Sourceˉgenerics.Compilerˉsourceˉgenericˉsolutionˉfinish(Solution);
    if Solution.Status !=
        Sourceˉgenerics.Compilerˉsourceˉgenericˉstatus.Valid {
        return Compilerˉsourceˉgenericˉtypeˉbindingˉfailure(
            Solution.Status, Catalog, End
        );
    }
    let Dependencies: Compilerˉsourceˉgenericˉtypeˉbinding =
        Compilerˉsourceˉgenericˉtypeˉbindingˉadmitˉdependencies(
            Input, Scan, Symbols, Match.Module, Target.Source,
            Declaration, Generic,
            Declarationˉposition.Line, Declarationˉposition.Column,
            Solution, Workingˉcatalog, Depth
        );
    if Dependencies.Status !=
            Sourceˉsymbols.Compilerˉsourceˉsymbolˉstatus.Valid ||
        Dependencies.Genericˉstatus !=
            Sourceˉgenerics.Compilerˉsourceˉgenericˉstatus.Valid {
        return Compilerˉsourceˉgenericˉtypeˉbindingˉpreserveˉcatalog(
            Dependencies, Catalog
        );
    }
    Workingˉcatalog =
        Compilerˉsourceˉgenericˉtypeˉbindingˉcatalog(Dependencies);
    let Admission: Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉadmission =
        Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalogˉadmit(
            Workingˉcatalog, Match.Directoryˉindex,
            Sourceˉsymbols.Compilerˉsourceˉsymbolsˉdeclarationˉkindˉvalue(
                Match.Kind
            ),
            Owner, Token.Offset, 16u32 + Declaration.Items * 16u32,
            Solution
        );
    if Admission.Status !=
        Sourceˉgenerics.Compilerˉsourceˉgenericˉstatus.Valid {
        return Compilerˉsourceˉgenericˉtypeˉbindingˉfailure(
            Admission.Status, Catalog, Token
        );
    }
    let Updated: Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog =
        Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉadmissionˉcatalog(
            Admission
        );
    return Compilerˉsourceˉgenericˉtypeˉbindingˉvalue(
        Sourceˉsymbols.Compilerˉsourceˉsymbolˉstatus.Valid,
        Sourceˉgenerics.Compilerˉsourceˉgenericˉstatus.Valid,
        Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉshape(
            Admission.Instance
        ),
        Match.Kind, Match.Directoryˉindex, Match.Module, Updated,
        Closeˉnextˉoffset, Closeˉnextˉline, Closeˉnextˉcolumn,
        Closeˉnextˉoffset, Closeˉnextˉline, Closeˉnextˉcolumn
    );
}

fn Compilerˉsourceˉgenericˉtypeˉfieldˉplanˉappend(
    Input: bytes,
    Value: u32
) -> bytes {
    return Bytesˉconcat(Input, Bytesˉfromˉu32ˉlittle(Value));
}

export fn Compilerˉsourceˉgenericˉtypeˉfieldˉplan(
    Source: bytes,
    Declaration: Sourceˉdeclarations.Compilerˉsourceˉdeclaration,
    Declarationˉline: u32,
    Declarationˉcolumn: u32
) -> bytes {
    let Empty: bytes = Bytesˉslice(Source, 0u32, 0u32);
    let Bodyˉposition: Sourceˉbodies.Compilerˉsourceˉposition =
        Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
            Source, Declaration.Declarationˉoffset,
            Declarationˉline, Declarationˉcolumn,
            Declaration.Bodyˉoffset
        );
    let Brace: Sourceˉlexer.Compilerˉsourceˉtoken =
        Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Source, Declaration.Bodyˉoffset,
            Bodyˉposition.Line, Bodyˉposition.Column
        );
    var Itemˉevidence: bytes = Empty;
    var Fieldˉevidence: bytes = Empty;
    var Fields: u32 = 0u32;
    var Cursor: u32 = Brace.Nextˉoffset;
    var Line: u32 = Brace.Nextˉline;
    var Column: u32 = Brace.Nextˉcolumn;
    var Itemˉindex: u32 = 0u32;
    if Declaration.Kind ==
        Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Record {
        while Itemˉindex < Declaration.Items {
            let Recordˉfield: Sourceˉlexer.Compilerˉsourceˉtoken =
                Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                    Source, Cursor, Line, Column
                );
            let Recordˉcolon: Sourceˉlexer.Compilerˉsourceˉtoken =
                Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                    Source, Recordˉfield.Nextˉoffset,
                    Recordˉfield.Nextˉline, Recordˉfield.Nextˉcolumn
                );
            let Recordˉtype: Sourceˉdeclarations.Compilerˉparseˉstep =
                Sourceˉdeclarations.Compilerˉparseˉtype(
                    Source, Recordˉcolon.Nextˉoffset,
                    Recordˉcolon.Nextˉline, Recordˉcolon.Nextˉcolumn,
                    false, false
                );
            let Recordˉend: Sourceˉlexer.Compilerˉsourceˉtoken =
                Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                    Source, Recordˉtype.Nextˉoffset,
                    Recordˉtype.Nextˉline, Recordˉtype.Nextˉcolumn
                );
            if Recordˉtype.Status !=
                    Sourceˉdeclarations.Compilerˉparseˉstatus.Valid ||
                Recordˉend.Kind !=
                    Sourceˉlexer.Compilerˉtokenˉkind.Semicolon {
                return Empty;
            }
            Fieldˉevidence =
                Compilerˉsourceˉgenericˉtypeˉfieldˉplanˉappend(
                    Fieldˉevidence, Recordˉfield.Offset
                );
            Fieldˉevidence =
                Compilerˉsourceˉgenericˉtypeˉfieldˉplanˉappend(
                    Fieldˉevidence, Recordˉfield.Length
                );
            Fieldˉevidence =
                Compilerˉsourceˉgenericˉtypeˉfieldˉplanˉappend(
                    Fieldˉevidence, Recordˉcolon.Nextˉoffset
                );
            Fieldˉevidence =
                Compilerˉsourceˉgenericˉtypeˉfieldˉplanˉappend(
                    Fieldˉevidence, Recordˉcolon.Nextˉline
                );
            Fieldˉevidence =
                Compilerˉsourceˉgenericˉtypeˉfieldˉplanˉappend(
                    Fieldˉevidence, Recordˉcolon.Nextˉcolumn
                );
            Fields = Fields + 1u32;
            Cursor = Recordˉend.Nextˉoffset;
            Line = Recordˉend.Nextˉline;
            Column = Recordˉend.Nextˉcolumn;
            Itemˉindex = Itemˉindex + 1u32;
        }
    } else {
        while Itemˉindex < Declaration.Items {
            let Case: Sourceˉlexer.Compilerˉsourceˉtoken =
                Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                    Source, Cursor, Line, Column
                );
            let Afterˉname: Sourceˉlexer.Compilerˉsourceˉtoken =
                Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                    Source, Case.Nextˉoffset,
                    Case.Nextˉline, Case.Nextˉcolumn
                );
            var End: Sourceˉlexer.Compilerˉsourceˉtoken = Afterˉname;
            let Firstˉfield: u32 = Fields;
            if Afterˉname.Kind ==
                Sourceˉlexer.Compilerˉtokenˉkind.Leftˉparenthesis {
                var Fieldˉcursor: u32 = Afterˉname.Nextˉoffset;
                var Fieldˉline: u32 = Afterˉname.Nextˉline;
                var Fieldˉcolumn: u32 = Afterˉname.Nextˉcolumn;
                var Readingˉfields: bool = true;
                while Readingˉfields {
                    let Parsed:
                        Sourceˉdeclarations.Compilerˉsourceˉvariantˉfield =
                        Sourceˉdeclarations.Compilerˉparseˉvariantˉfield(
                            Source, Fieldˉcursor,
                            Fieldˉline, Fieldˉcolumn
                        );
                    let Typeˉposition:
                        Sourceˉbodies.Compilerˉsourceˉposition =
                        Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
                            Source, Fieldˉcursor,
                            Fieldˉline, Fieldˉcolumn,
                            Parsed.Typeˉoffset
                        );
                    if Parsed.Status !=
                        Sourceˉdeclarations.Compilerˉparseˉstatus.Valid {
                        return Empty;
                    }
                    Fieldˉevidence =
                        Compilerˉsourceˉgenericˉtypeˉfieldˉplanˉappend(
                            Fieldˉevidence, Parsed.Nameˉoffset
                        );
                    Fieldˉevidence =
                        Compilerˉsourceˉgenericˉtypeˉfieldˉplanˉappend(
                            Fieldˉevidence, Parsed.Nameˉlength
                        );
                    Fieldˉevidence =
                        Compilerˉsourceˉgenericˉtypeˉfieldˉplanˉappend(
                            Fieldˉevidence, Parsed.Typeˉoffset
                        );
                    Fieldˉevidence =
                        Compilerˉsourceˉgenericˉtypeˉfieldˉplanˉappend(
                            Fieldˉevidence, Typeˉposition.Line
                        );
                    Fieldˉevidence =
                        Compilerˉsourceˉgenericˉtypeˉfieldˉplanˉappend(
                            Fieldˉevidence, Typeˉposition.Column
                        );
                    Fields = Fields + 1u32;
                    let Separator: Sourceˉlexer.Compilerˉsourceˉtoken =
                        Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                            Source, Parsed.Nextˉoffset,
                            Parsed.Nextˉline, Parsed.Nextˉcolumn
                        );
                    if Separator.Kind ==
                        Sourceˉlexer.Compilerˉtokenˉkind.Comma {
                        let Afterˉcomma:
                            Sourceˉlexer.Compilerˉsourceˉtoken =
                            Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                                Source, Separator.Nextˉoffset,
                                Separator.Nextˉline,
                                Separator.Nextˉcolumn
                            );
                        if Afterˉcomma.Kind ==
                            Sourceˉlexer.Compilerˉtokenˉkind.Rightˉparenthesis {
                            Readingˉfields = false;
                            End = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                                Source, Afterˉcomma.Nextˉoffset,
                                Afterˉcomma.Nextˉline,
                                Afterˉcomma.Nextˉcolumn
                            );
                        } else {
                            Fieldˉcursor = Separator.Nextˉoffset;
                            Fieldˉline = Separator.Nextˉline;
                            Fieldˉcolumn = Separator.Nextˉcolumn;
                        }
                    } else {
                        Readingˉfields = false;
                        End = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                            Source, Separator.Nextˉoffset,
                            Separator.Nextˉline, Separator.Nextˉcolumn
                        );
                    }
                }
            }
            Itemˉevidence =
                Compilerˉsourceˉgenericˉtypeˉfieldˉplanˉappend(
                    Itemˉevidence, Case.Offset
                );
            Itemˉevidence =
                Compilerˉsourceˉgenericˉtypeˉfieldˉplanˉappend(
                    Itemˉevidence, Case.Length
                );
            Itemˉevidence =
                Compilerˉsourceˉgenericˉtypeˉfieldˉplanˉappend(
                    Itemˉevidence, Firstˉfield
                );
            Itemˉevidence =
                Compilerˉsourceˉgenericˉtypeˉfieldˉplanˉappend(
                    Itemˉevidence, Fields - Firstˉfield
                );
            Cursor = End.Nextˉoffset;
            Line = End.Nextˉline;
            Column = End.Nextˉcolumn;
            Itemˉindex = Itemˉindex + 1u32;
        }
    }
    let Items: u32 = Bytesˉlength(Itemˉevidence) / 16u32;
    var Header: bytes = Bytesˉfromˉu32ˉlittle(Fields);
    Header = Compilerˉsourceˉgenericˉtypeˉfieldˉplanˉappend(
        Header, Items
    );
    return Bytesˉconcat(
        Bytesˉconcat(Header, Itemˉevidence), Fieldˉevidence
    );
}

fn Compilerˉsourceˉgenericˉtypeˉbindingˉdependenciesˉvalid(
    Catalog: Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog,
    Declaration: Sourceˉdeclarations.Compilerˉsourceˉdeclaration
) -> Compilerˉsourceˉgenericˉtypeˉbinding {
    return Compilerˉsourceˉgenericˉtypeˉbindingˉvalue(
        Sourceˉsymbols.Compilerˉsourceˉsymbolˉstatus.Valid,
        Sourceˉgenerics.Compilerˉsourceˉgenericˉstatus.Valid,
        1u32,
        Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.End,
        4294967295u32, 4294967295u32, Catalog,
        Declaration.Nextˉoffset,
        Declaration.Nextˉline,
        Declaration.Nextˉcolumn,
        Declaration.Nextˉoffset,
        Declaration.Nextˉline,
        Declaration.Nextˉcolumn
    );
}

fn Compilerˉsourceˉgenericˉtypeˉbindingˉadmitˉdependencies(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Module: u32,
    Source: bytes,
    Declaration: Sourceˉdeclarations.Compilerˉsourceˉdeclaration,
    Generic: Sourceˉsymbols.Compilerˉsourceˉfunctionˉgeneric,
    Declarationˉline: u32,
    Declarationˉcolumn: u32,
    Solution: Sourceˉgenerics.Compilerˉsourceˉgenericˉsolution,
    Catalog: Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog,
    Depth: u32
) -> Compilerˉsourceˉgenericˉtypeˉbinding {
    let Plan: bytes = Compilerˉsourceˉgenericˉtypeˉfieldˉplan(
        Source, Declaration, Declarationˉline, Declarationˉcolumn
    );
    let Planˉlength: u32 = Bytesˉlength(Plan);
    if Planˉlength < 8u32 {
        let Token: Sourceˉlexer.Compilerˉsourceˉtoken =
            Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                Source, Declaration.Declarationˉoffset,
                Declarationˉline, Declarationˉcolumn
            );
        return Compilerˉsourceˉgenericˉtypeˉbindingˉfailure(
            Sourceˉgenerics.Compilerˉsourceˉgenericˉstatus.Invalidˉevidence,
            Catalog, Token
        );
    }
    let Fields: u32 = Bytesˉreadˉu32ˉlittle(Plan, 0u32);
    let Items: u32 = Bytesˉreadˉu32ˉlittle(Plan, 4u32);
    if Items > 256u32 || Fields > 16384u32 ||
        Items * 16u32 > Planˉlength - 8u32 ||
        Fields * 20u32 != Planˉlength - 8u32 - Items * 16u32 {
        let Invalidˉtoken: Sourceˉlexer.Compilerˉsourceˉtoken =
            Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                Source, Declaration.Declarationˉoffset,
                Declarationˉline, Declarationˉcolumn
            );
        return Compilerˉsourceˉgenericˉtypeˉbindingˉfailure(
            Sourceˉgenerics.Compilerˉsourceˉgenericˉstatus.Invalidˉevidence,
            Catalog, Invalidˉtoken
        );
    }
    var Workingˉcatalog:
        Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog = Catalog;
    var Fieldˉindex: u32 = 0u32;
    while Fieldˉindex < Fields {
        let Fieldˉentry: u32 =
            8u32 + Items * 16u32 + Fieldˉindex * 20u32;
        let Dependency: Compilerˉsourceˉgenericˉtypeˉbinding =
            Compilerˉsourceˉgenericˉtypeˉbindˉnested(
                Input, Scan, Symbols, Module, Source,
                Bytesˉreadˉu32ˉlittle(Plan, Fieldˉentry + 8u32),
                Bytesˉreadˉu32ˉlittle(Plan, Fieldˉentry + 12u32),
                Bytesˉreadˉu32ˉlittle(Plan, Fieldˉentry + 16u32),
                Workingˉcatalog, Depth + 1u32,
                Source, Generic, Solution, true,
                Sourceˉgenerics.Compilerˉsourceˉgenericˉcatalogˉempty(),
                4294967295u32, false
            );
        if Dependency.Status !=
                Sourceˉsymbols.Compilerˉsourceˉsymbolˉstatus.Valid ||
            Dependency.Genericˉstatus !=
                Sourceˉgenerics.Compilerˉsourceˉgenericˉstatus.Valid {
            return Compilerˉsourceˉgenericˉtypeˉbindingˉpreserveˉcatalog(
                Dependency, Catalog
            );
        }
        Workingˉcatalog =
            Compilerˉsourceˉgenericˉtypeˉbindingˉcatalog(Dependency);
        Fieldˉindex = Fieldˉindex + 1u32;
    }
    return Compilerˉsourceˉgenericˉtypeˉbindingˉdependenciesˉvalid(
        Workingˉcatalog, Declaration
    );
}

export fn Compilerˉsourceˉgenericˉtypeˉbind(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Owner: u32,
    Source: bytes,
    Offset: u32,
    Line: u32,
    Column: u32,
    Catalog: Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog
) -> Compilerˉsourceˉgenericˉtypeˉbinding {
    let Emptyˉgeneric: Sourceˉsymbols.Compilerˉsourceˉfunctionˉgeneric =
        Sourceˉsymbols.Compilerˉsourceˉfunctionˉgeneric(
            0u32, 0u32, 1u32, 1u32, 0u32, 1u32, 1u32
        );
    let Empty: bytes = Bytesˉslice(Input, 0u32, 0u32);
    let Emptyˉsolution:
        Sourceˉgenerics.Compilerˉsourceˉgenericˉsolution =
        Sourceˉgenerics.Compilerˉsourceˉgenericˉsolutionˉcreate(
            Empty, Empty
        );
    return Compilerˉsourceˉgenericˉtypeˉbindˉnested(
        Input, Scan, Symbols, Owner, Source,
        Offset, Line, Column, Catalog, 0u32,
        Empty, Emptyˉgeneric, Emptyˉsolution, false,
        Sourceˉgenerics.Compilerˉsourceˉgenericˉcatalogˉempty(),
        4294967295u32, false
    );
}

export fn Compilerˉsourceˉgenericˉtypeˉbindˉfunctionˉspecialization(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Owner: u32,
    Source: bytes,
    Offset: u32,
    Line: u32,
    Column: u32,
    Catalog: Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog,
    Functionˉsource: bytes,
    Functionˉgeneric: Sourceˉsymbols.Compilerˉsourceˉfunctionˉgeneric,
    Functionˉcatalog: Sourceˉgenerics.Compilerˉsourceˉgenericˉcatalog,
    Functionˉinstance: u32
) -> Compilerˉsourceˉgenericˉtypeˉbinding {
    let Emptyˉsolution:
        Sourceˉgenerics.Compilerˉsourceˉgenericˉsolution =
        Sourceˉgenerics.Compilerˉsourceˉgenericˉsolution(
            Sourceˉgenerics.Compilerˉsourceˉgenericˉstatus.Valid,
            Bytesˉslice(Input, 0u32, 0u32)
        );
    return Compilerˉsourceˉgenericˉtypeˉbindˉnested(
        Input, Scan, Symbols, Owner, Source,
        Offset, Line, Column, Catalog, 0u32,
        Functionˉsource, Functionˉgeneric, Emptyˉsolution, false,
        Functionˉcatalog, Functionˉinstance, true
    );
}

export fn Compilerˉsourceˉgenericˉtypeˉbindˉtypeˉspecialization(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Owner: u32,
    Source: bytes,
    Offset: u32,
    Line: u32,
    Column: u32,
    Catalog: Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog,
    Typeˉsource: bytes,
    Typeˉgeneric: Sourceˉsymbols.Compilerˉsourceˉfunctionˉgeneric,
    Typeˉinstance: u32
) -> Compilerˉsourceˉgenericˉtypeˉbinding {
    let Solution: Sourceˉgenerics.Compilerˉsourceˉgenericˉsolution =
        Compilerˉsourceˉgenericˉtypeˉbindingˉtypeˉsolution(
            Typeˉsource, Typeˉgeneric, Catalog, Typeˉinstance
        );
    if Solution.Status !=
        Sourceˉgenerics.Compilerˉsourceˉgenericˉstatus.Valid {
        let Token: Sourceˉlexer.Compilerˉsourceˉtoken =
            Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                Source, Offset, Line, Column
            );
        return Compilerˉsourceˉgenericˉtypeˉbindingˉfailure(
            Solution.Status, Catalog, Token
        );
    }
    return Compilerˉsourceˉgenericˉtypeˉbindˉnested(
        Input, Scan, Symbols, Owner, Source,
        Offset, Line, Column, Catalog, 0u32,
        Typeˉsource, Typeˉgeneric, Solution, true,
        Sourceˉgenerics.Compilerˉsourceˉgenericˉcatalogˉempty(),
        4294967295u32, false
    );
}
