module Compilerˉsourceˉsymbols profile portable;

import Compilerˉsourceˉbodyˉparser as Sourceˉbodies;
import Compilerˉsourceˉdeclarationˉparser as Sourceˉdeclarations;
import Compilerˉsourceˉgraph as Sourceˉgraph;
import Compilerˉsourceˉlexer as Sourceˉlexer;
import Compilerˉsourceˉset as Sourceˉset;
import Foundationˉbyteˉconstruction as Byteˉconstruction;

export enum Compilerˉsourceˉsymbolˉstatus {
    Valid = 0;
    Sourceˉgraph = 1;
    Capabilityˉlimit = 2;
    Dataˉlimit = 3;
    Nominalˉtypeˉlimit = 4;
    Functionˉlimit = 5;
    Duplicateˉcapability = 6;
    Unknownˉcapability = 7;
    Capabilityˉprofile = 8;
    Duplicateˉdata = 9;
    Duplicateˉtype = 10;
    Duplicateˉfunction = 11;
    Constructorˉconflict = 12;
    Reservedˉname = 13;
    Emptyˉrecord = 14;
    Duplicateˉfield = 15;
    Emptyˉenum = 16;
    Duplicateˉenumˉmember = 17;
    Duplicateˉenumˉvalue = 18;
    Unknownˉtype = 19;
    Inaccessibleˉtype = 20;
    Invalidˉfieldˉtype = 21;
    Invalidˉdirectory = 22;
    Duplicateˉparameter = 23;
    Constantˉlimit = 24;
    Invalidˉconstantˉname = 25;
    Invalidˉconstantˉtype = 26;
    Invalidˉconstantˉinitializer = 27;
    Constantˉtypeˉmismatch = 28;
    Constantˉforwardˉreference = 29;
    Constantˉoverflow = 30;
    Importedˉconstant = 31;
    Emptyˉvariant = 32;
    Duplicateˉvariantˉcase = 33;
    Invalidˉvariantˉpayload = 34;
    Invalidˉcollectionˉelement = 35;
}

enum Compilerˉsourceˉnamespaceˉkind {
    Capability = 0;
    Data = 1;
    Nominal = 2;
    Function = 3;
    Constructor = 4;
    Constant = 5;
}

export record Compilerˉsourceˉsymbolˉmatch {
    Found: bool;
    Module: u32;
    Kind: Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind;
    Declarationˉoffset: u32;
    Nameˉoffset: u32;
    Nameˉlength: u32;
    Directoryˉindex: u32;
}

record Compilerˉsourceˉsymbolˉquery {
    Qualified: bool;
    Aliasˉfound: bool;
    Target: u32;
    Nameˉoffset: u32;
    Nameˉlength: u32;
}

record Compilerˉsourceˉenumˉduplicate {
    Name: bool;
    Value: bool;
}

export record Compilerˉsourceˉtypeˉbinding {
    Status: Compilerˉsourceˉsymbolˉstatus;
    Kind: Sourceˉdeclarations.Compilerˉsourceˉtypeˉkind;
    Nominalˉkind: Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind;
    Nominalˉindex: u32;
    Nominalˉmodule: u32;
    Nameˉoffset: u32;
    Nameˉlength: u32;
    Nextˉoffset: u32;
    Nextˉline: u32;
    Nextˉcolumn: u32;
    Failureˉoffset: u32;
    Failureˉline: u32;
    Failureˉcolumn: u32;
}

export record Compilerˉsourceˉsymbolˉsummary {
    Status: Compilerˉsourceˉsymbolˉstatus;
    Graphˉstatus: Sourceˉgraph.Compilerˉsourceˉgraphˉstatus;
    Modules: u32;
    Capabilities: u32;
    Data: u32;
    Records: u32;
    Enums: u32;
    Variants: u32;
    Functions: u32;
    Fields: u32;
    Members: u32;
    Cases: u32;
    Parameters: u32;
    Directory: bytes;
    Visibility: bytes;
    Lookup: bytes;
    Failureˉmodule: u32;
    Failureˉrelatedˉmodule: u32;
    Failureˉkind: Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind;
    Failureˉoffset: u32;
    Failureˉline: u32;
    Failureˉcolumn: u32;
}

export record Compilerˉsourceˉconstantˉvalue {
    Status: Compilerˉsourceˉsymbolˉstatus;
    Shape: u32;
    Magnitude: u32;
    High: u32;
    Negative: bool;
    Failureˉmodule: u32;
    Failureˉoffset: u32;
    Failureˉline: u32;
    Failureˉcolumn: u32;
}

record Compilerˉsourceˉconstantˉdivision {
    Quotient: u32;
    Remainder: u32;
}

record Compilerˉsourceˉconstantˉwideˉvalue {
    Valid: bool;
    Low: u32;
    High: u32;
}

record Compilerˉsourceˉconstantˉwideˉdivision {
    Valid: bool;
    Quotientˉlow: u32;
    Quotientˉhigh: u32;
    Remainderˉlow: u32;
    Remainderˉhigh: u32;
}

export fn Compilerˉsourceˉsymbolsˉempty(Input: bytes) -> bytes {
    return Bytesˉslice(Input, 0u32, 0u32);
}

export fn Compilerˉsourceˉsymbolsˉmatchˉnone(Modules: u32) -> Compilerˉsourceˉsymbolˉmatch {
    return Compilerˉsourceˉsymbolˉmatch(
        false,
        Modules,
        Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.End,
        0u32,
        0u32,
        0u32,
        0u32
    );
}

export fn Compilerˉsourceˉsymbolsˉsummaryˉfailure(
    Input: bytes,
    Status: Compilerˉsourceˉsymbolˉstatus,
    Graphˉstatus: Sourceˉgraph.Compilerˉsourceˉgraphˉstatus,
    Modules: u32,
    Capabilities: u32,
    Data: u32,
    Records: u32,
    Enums: u32,
    Variants: u32,
    Functions: u32,
    Fields: u32,
    Members: u32,
    Cases: u32,
    Parameters: u32,
    Module: u32,
    Relatedˉmodule: u32,
    Kind: Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind,
    Offset: u32,
    Line: u32,
    Column: u32
) -> Compilerˉsourceˉsymbolˉsummary {
    return Compilerˉsourceˉsymbolˉsummary(
        Status,
        Graphˉstatus,
        Modules,
        Capabilities,
        Data,
        Records,
        Enums,
        Variants,
        Functions,
        Fields,
        Members,
        Cases,
        Parameters,
        Compilerˉsourceˉsymbolsˉempty(Input),
        Compilerˉsourceˉsymbolsˉempty(Input),
        Compilerˉsourceˉsymbolsˉempty(Input),
        Module,
        Relatedˉmodule,
        Kind,
        Offset,
        Line,
        Column
    );
}

export fn Compilerˉsourceˉsymbolsˉsummaryˉsuccess(
    Input: bytes,
    Modules: u32,
    Capabilities: u32,
    Data: u32,
    Records: u32,
    Enums: u32,
    Variants: u32,
    Functions: u32,
    Fields: u32,
    Members: u32,
    Cases: u32,
    Parameters: u32,
    Directory: bytes,
    Visibility: bytes,
    Lookup: bytes
) -> Compilerˉsourceˉsymbolˉsummary {
    return Compilerˉsourceˉsymbolˉsummary(
        Compilerˉsourceˉsymbolˉstatus.Valid,
        Sourceˉgraph.Compilerˉsourceˉgraphˉstatus.Valid,
        Modules,
        Capabilities,
        Data,
        Records,
        Enums,
        Variants,
        Functions,
        Fields,
        Members,
        Cases,
        Parameters,
        Directory,
        Visibility,
        Lookup,
        Modules,
        Modules,
        Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.End,
        Bytesˉlength(Input),
        0u32,
        0u32
    );
}

export fn Compilerˉsourceˉsymbolsˉnameˉequals(
    Source: bytes,
    Offset: u32,
    Length: u32,
    Candidate: text
) -> bool {
    let Candidateˉbytes: bytes = Textˉtoˉutf8(Candidate);
    if Length != Bytesˉlength(Candidateˉbytes) { return false; }
    return Sourceˉset.Compilerˉsourceˉspansˉequal(
        Source,
        Offset,
        Length,
        Candidateˉbytes,
        0u32,
        Length
    );
}

export fn Compilerˉsourceˉsymbolsˉconstantˉnameˉisˉvalid(
    Source: bytes,
    Offset: u32,
    Length: u32
) -> bool {
    if Length == 0u32 { return false; }
    var Index: u32 = 0u32;
    while Index < Length {
        let Character: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(Source, Offset + Index));
        var Valid: bool = Character == 95u32;
        if Character >= 65u32 {
            if Character <= 90u32 { Valid = true; }
        }
        if Index > 0u32 {
            if Character >= 48u32 {
                if Character <= 57u32 { Valid = true; }
            }
        }
        if !Valid { return false; }
        Index = Index + 1u32;
    }
    return true;
}

export fn Compilerˉsourceˉsymbolsˉisˉreserved(
    Source: bytes,
    Offset: u32,
    Length: u32
) -> bool {
    if Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "Bytesˉlength") { return true; }
    if Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "Bytesˉslice") { return true; }
    if Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "Bytesˉreadˉu8") { return true; }
    if Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "Bytesˉreadˉu16ˉlittle") { return true; }
    if Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "Bytesˉreadˉu32ˉlittle") { return true; }
    if Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "Bytesˉreadˉi32ˉlittle") { return true; }
    if Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "Bytesˉreadˉu64ˉlittle") { return true; }
    if Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "Bytesˉconcat") { return true; }
    if Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "Bytesˉfromˉu8") { return true; }
    if Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "Bytesˉfromˉu16ˉlittle") { return true; }
    if Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "Bytesˉfromˉu32ˉlittle") { return true; }
    if Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "Bytesˉfromˉi32ˉlittle") { return true; }
    if Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "Bytesˉfromˉu64ˉlittle") { return true; }
    if Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "Bytesˉsha256ˉhex") { return true; }
    if Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "U32ˉfromˉu8") { return true; }
    if Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "U64ˉfromˉu32") { return true; }
    if Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "I32ˉformat") { return true; }
    if Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "U8ˉformat") { return true; }
    if Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "U32ˉformat") { return true; }
    if Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "I64ˉformat") { return true; }
    if Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "U64ˉformat") { return true; }
    if Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "Textˉconcat") { return true; }
    if Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "Textˉutf8ˉisˉvalid") { return true; }
    if Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "Textˉfromˉutf8") { return true; }
    if Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "Textˉtoˉutf8") { return true; }
    if Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "Textˉquote") { return true; }
    if Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "Enumˉname") { return true; }
    return false;
}

export fn Compilerˉsourceˉsymbolsˉisˉknownˉcapability(
    Source: bytes,
    Offset: u32,
    Length: u32
) -> bool {
    if Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "console.write") { return true; }
    if Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "console.write_line") { return true; }
    if Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "diagnostic.write_line") { return true; }
    if Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "file.read_bytes") { return true; }
    if Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "file.write_bytes") { return true; }
    if Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "filesystem.directory_read_v1") { return true; }
    if Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "model.catalog_v1") { return true; }
    if Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "model.inference_v1") { return true; }
    if Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "process.argument") { return true; }
    if Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "process.argument_count") { return true; }
    if Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "standard_output.write_v1") { return true; }
    if Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "storage.random_access_v1") { return true; }
    return false;
}

export fn Compilerˉsourceˉsymbolsˉdeclarationˉkindˉvalue(
    Kind: Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind
) -> u32 {
    if Kind == Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Import { return 1u32; }
    if Kind == Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Capability { return 2u32; }
    if Kind == Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Data { return 3u32; }
    if Kind == Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Record { return 4u32; }
    if Kind == Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Enum { return 5u32; }
    if Kind == Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Function { return 6u32; }
    if Kind == Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Constant { return 7u32; }
    if Kind == Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Variant { return 8u32; }
    return 0u32;
}

export fn Compilerˉsourceˉsymbolsˉdeclarationˉkind(
    Value: u32
) -> Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind {
    if Value == 1u32 { return Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Import; }
    if Value == 2u32 { return Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Capability; }
    if Value == 3u32 { return Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Data; }
    if Value == 4u32 { return Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Record; }
    if Value == 5u32 { return Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Enum; }
    if Value == 6u32 { return Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Function; }
    if Value == 7u32 { return Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Constant; }
    if Value == 8u32 { return Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Variant; }
    return Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.End;
}

export fn Compilerˉsourceˉsymbolsˉdirectoryˉkindˉcount(
    Directory: bytes,
    Kind: u32
) -> u32 {
    let Entries: u32 = Bytesˉreadˉu32ˉlittle(Directory, 8u32);
    var Count: u32 = 0u32;
    var Index: u32 = 0u32;
    while Index < Entries {
        if Bytesˉreadˉu32ˉlittle(Directory, 20u32 + Index * 24u32) == Kind {
            Count = Count + 1u32;
        }
        Index = Index + 1u32;
    }
    return Count;
}

export fn Compilerˉsourceˉsymbolsˉdirectory(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Entries: u32
) -> bytes {
    var Directory: bytes = Textˉtoˉutf8("WVSD");
    Directory = Bytesˉconcat(Directory, Bytesˉfromˉu16ˉlittle(1u32));
    Directory = Bytesˉconcat(Directory, Bytesˉfromˉu16ˉlittle(1u32));
    Directory = Bytesˉconcat(Directory, Bytesˉfromˉu32ˉlittle(Entries));
    Directory = Bytesˉconcat(Directory, Bytesˉfromˉu32ˉlittle(24u32));
    var Module: u32 = 0u32;
    while Module < Scan.Modules {
        let View: Sourceˉset.Compilerˉsourceˉsetˉview = Sourceˉset.Compilerˉsourceˉsetˉmodule(Input, Scan, Module);
        let Header: Sourceˉdeclarations.Compilerˉsourceˉheader = Sourceˉdeclarations.Compilerˉparseˉheaderˉvalidated(View.Source);
        var Cursor: u32 = Header.Nextˉoffset;
        var Currentˉline: u32 = Header.Nextˉline;
        var Currentˉcolumn: u32 = Header.Nextˉcolumn;
        var Sawˉnonˉimport: bool = false;
        var Reading: bool = true;
        while Reading {
            let Declaration: Sourceˉdeclarations.Compilerˉsourceˉdeclaration = Sourceˉdeclarations.Compilerˉparseˉnextˉdeclarationˉvalidated(
                View.Source, Cursor, Currentˉline, Currentˉcolumn, Sawˉnonˉimport
            );
            if Declaration.Kind == Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.End {
                Reading = false;
            } else {
                if Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉisˉsymbol(Declaration) {
                    Directory = Bytesˉconcat(Directory, Bytesˉfromˉu32ˉlittle(Module));
                    Directory = Bytesˉconcat(Directory, Bytesˉfromˉu32ˉlittle(
                        Compilerˉsourceˉsymbolsˉdeclarationˉkindˉvalue(Declaration.Kind)
                    ));
                    Directory = Bytesˉconcat(Directory, Bytesˉfromˉu32ˉlittle(Declaration.Declarationˉoffset));
                    Directory = Bytesˉconcat(Directory, Bytesˉfromˉu32ˉlittle(Declaration.Nameˉoffset));
                    Directory = Bytesˉconcat(Directory, Bytesˉfromˉu32ˉlittle(Declaration.Nameˉlength));
                    Directory = Bytesˉconcat(Directory, Bytesˉfromˉu32ˉlittle(Declaration.Items));
                    if Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉclosesˉimports(Declaration) {
                        Sawˉnonˉimport = true;
                    }
                }
                Cursor = Declaration.Nextˉoffset;
                Currentˉline = Declaration.Nextˉline;
                Currentˉcolumn = Declaration.Nextˉcolumn;
            }
        }
        Module = Module + 1u32;
    }
    return Directory;
}

export fn Compilerˉsourceˉsymbolsˉrootˉnameˉexists(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Directory: bytes,
    Name: bytes
) -> bool {
    let Entries: u32 = Bytesˉreadˉu32ˉlittle(Directory, 8u32);
    var Entry: u32 = 0u32;
    while Entry < Entries {
        let Offset: u32 = 16u32 + Entry * 24u32;
        if Bytesˉreadˉu32ˉlittle(Directory, Offset) == 0u32 {
            let View: Sourceˉset.Compilerˉsourceˉsetˉview = Sourceˉset.Compilerˉsourceˉsetˉmodule(Input, Scan, 0u32);
            let Sourceˉoffset: u32 = Bytesˉreadˉu32ˉlittle(Directory, Offset + 12u32);
            let Sourceˉlength: u32 = Bytesˉreadˉu32ˉlittle(Directory, Offset + 16u32);
            if Sourceˉlength == Bytesˉlength(Name) {
                if Sourceˉset.Compilerˉsourceˉspansˉequal(
                    View.Source, Sourceˉoffset, Sourceˉlength,
                    Name, 0u32, Bytesˉlength(Name)
                ) { return true; }
            }
        }
        Entry = Entry + 1u32;
    }
    return false;
}

export fn Compilerˉsourceˉsymbolsˉemittedˉname(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Directory: bytes,
    Entry: u32
) -> bytes {
    let Offset: u32 = 16u32 + Entry * 24u32;
    let Owner: u32 = Bytesˉreadˉu32ˉlittle(Directory, Offset);
    let View: Sourceˉset.Compilerˉsourceˉsetˉview = Sourceˉset.Compilerˉsourceˉsetˉmodule(Input, Scan, Owner);
    let Sourceˉoffset: u32 = Bytesˉreadˉu32ˉlittle(Directory, Offset + 12u32);
    let Sourceˉlength: u32 = Bytesˉreadˉu32ˉlittle(Directory, Offset + 16u32);
    if Owner == 0u32 {
        return Bytesˉslice(View.Source, Sourceˉoffset, Sourceˉlength);
    }
    let Kind: u32 = Bytesˉreadˉu32ˉlittle(Directory, Offset + 4u32);
    var Ordinal: u32 = 0u32;
    var Prior: u32 = 0u32;
    while Prior < Entry {
        let Priorˉoffset: u32 = 16u32 + Prior * 24u32;
        if Bytesˉreadˉu32ˉlittle(Directory, Priorˉoffset) == Owner {
            if Bytesˉreadˉu32ˉlittle(Directory, Priorˉoffset + 4u32) == Kind {
                Ordinal = Ordinal + 1u32;
            }
        }
        Prior = Prior + 1u32;
    }
    var Kindˉname: text = "F";
    if Kind == 3u32 { Kindˉname = "D"; }
    if Kind == 4u32 { Kindˉname = "R"; }
    if Kind == 5u32 { Kindˉname = "E"; }
    if Kind == 7u32 { Kindˉname = "C"; }
    if Kind == 8u32 { Kindˉname = "V"; }
    var Nameˉtext: text = Textˉconcat("__WvM", U32ˉformat(Owner));
    Nameˉtext = Textˉconcat(Nameˉtext, Kindˉname);
    Nameˉtext = Textˉconcat(Nameˉtext, U32ˉformat(Ordinal));
    var Name: bytes = Textˉtoˉutf8(Nameˉtext);
    while Compilerˉsourceˉsymbolsˉrootˉnameˉexists(Input, Scan, Directory, Name) {
        Name = Bytesˉconcat(Name, Textˉtoˉutf8("_"));
    }
    return Name;
}

export fn Compilerˉsourceˉsymbolsˉlookup(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Directory: bytes
) -> bytes {
    let Entries: u32 = Bytesˉreadˉu32ˉlittle(Directory, 8u32);
    var Ranges: bytes = Compilerˉsourceˉsymbolsˉempty(Input);
    var Payload: bytes = Compilerˉsourceˉsymbolsˉempty(Input);
    var Firstˉbyte: u32 = 0u32;
    var Payloadˉentries: u32 = 0u32;
    var Priorˉrecords: u32 = 0u32;
    var Priorˉenums: u32 = 0u32;
    var Priorˉvariants: u32 = 0u32;
    while Firstˉbyte < 256u32 {
        let Rangeˉfirst: u32 = Payloadˉentries;
        var Rangeˉcount: u32 = 0u32;
        var Rangeˉrecords: u32 = 0u32;
        var Rangeˉenums: u32 = 0u32;
        var Rangeˉvariants: u32 = 0u32;
        var Symbolˉindex: u32 = 0u32;
        while Symbolˉindex < Entries {
            let Symbolˉentry: u32 = 16u32 + Symbolˉindex * 24u32;
            let Symbolˉmodule: u32 = Bytesˉreadˉu32ˉlittle(Directory, Symbolˉentry);
            let Symbolˉnameˉoffset: u32 = Bytesˉreadˉu32ˉlittle(
                Directory, Symbolˉentry + 12u32
            );
            let Sourceˉentry: u32 = Scan.Directoryˉoffset + Symbolˉmodule * 8u32;
            let Sourceˉoffset: u32 = Bytesˉreadˉu32ˉlittle(Input, Sourceˉentry);
            let Symbolˉfirst: u32 = U32ˉfromˉu8(
                Bytesˉreadˉu8(Input, Sourceˉoffset + Symbolˉnameˉoffset)
            );
            if Symbolˉfirst == Firstˉbyte {
                Payload = Bytesˉconcat(Payload, Bytesˉfromˉu32ˉlittle(Symbolˉindex));
                Rangeˉcount = Rangeˉcount + 1u32;
                Payloadˉentries = Payloadˉentries + 1u32;
                let Kind: u32 = Bytesˉreadˉu32ˉlittle(Directory, Symbolˉentry + 4u32);
                if Kind == 4u32 { Rangeˉrecords = Rangeˉrecords + 1u32; }
                if Kind == 5u32 { Rangeˉenums = Rangeˉenums + 1u32; }
                if Kind == 8u32 { Rangeˉvariants = Rangeˉvariants + 1u32; }
            }
            Symbolˉindex = Symbolˉindex + 1u32;
        }
        Ranges = Bytesˉconcat(Ranges, Bytesˉfromˉu32ˉlittle(Rangeˉfirst));
        Ranges = Bytesˉconcat(Ranges, Bytesˉfromˉu32ˉlittle(Rangeˉcount));
        Ranges = Bytesˉconcat(Ranges, Bytesˉfromˉu32ˉlittle(Priorˉrecords));
        Ranges = Bytesˉconcat(Ranges, Bytesˉfromˉu32ˉlittle(Priorˉenums));
        Priorˉrecords = Priorˉrecords + Rangeˉrecords;
        Priorˉenums = Priorˉenums + Rangeˉenums;
        Priorˉvariants = Priorˉvariants + Rangeˉvariants;
        Firstˉbyte = Firstˉbyte + 1u32;
    }
    var Result: bytes = Textˉtoˉutf8("WVSI");
    Result = Bytesˉconcat(Result, Bytesˉfromˉu16ˉlittle(1u32));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu16ˉlittle(1u32));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Entries));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Priorˉvariants));
    Result = Bytesˉconcat(Result, Ranges);
    Result = Bytesˉconcat(Result, Payload);
    var Nominalˉkind: Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind = Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Record;
    var Nominalˉkinds: u32 = 0u32;
    var Priorˉname: bytes = Compilerˉsourceˉsymbolsˉempty(Input);
    var Hasˉpriorˉname: bool = false;
    while Nominalˉkinds < 3u32 {
        var Count: u32 = Priorˉrecords;
        if Nominalˉkind == Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Enum { Count = Priorˉenums; }
        if Nominalˉkind == Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Variant { Count = Priorˉvariants; }
        let Kindˉvalue: u32 = Compilerˉsourceˉsymbolsˉdeclarationˉkindˉvalue(Nominalˉkind);
        Priorˉname = Compilerˉsourceˉsymbolsˉempty(Input);
        Hasˉpriorˉname = false;
        var Nominal: u32 = 0u32;
        while Nominal < Count {
            var Directoryˉindex: u32 = 0u32;
            var Found: bool = false;
            var Selectedˉdirectory: u32 = Entries;
            var Selectedˉname: bytes = Compilerˉsourceˉsymbolsˉempty(Input);
            while Directoryˉindex < Entries {
                let Entry: u32 = 16u32 + Directoryˉindex * 24u32;
                if Bytesˉreadˉu32ˉlittle(Directory, Entry + 4u32) == Kindˉvalue {
                    let Emittedˉname: bytes = Compilerˉsourceˉsymbolsˉemittedˉname(
                        Input, Scan, Directory, Directoryˉindex
                    );
                    var Afterˉprior: bool = !Hasˉpriorˉname;
                    if Hasˉpriorˉname {
                        Afterˉprior = Sourceˉset.Compilerˉsourceˉspansˉcompare(
                            Emittedˉname, 0u32, Bytesˉlength(Emittedˉname),
                            Priorˉname, 0u32, Bytesˉlength(Priorˉname)
                        ) > 0;
                    }
                    if Afterˉprior {
                        var Beforeˉselected: bool = !Found;
                        if Found {
                            Beforeˉselected = Sourceˉset.Compilerˉsourceˉspansˉcompare(
                                Emittedˉname, 0u32, Bytesˉlength(Emittedˉname),
                                Selectedˉname, 0u32, Bytesˉlength(Selectedˉname)
                            ) < 0;
                        }
                        if Beforeˉselected {
                            Found = true;
                            Selectedˉdirectory = Directoryˉindex;
                            Selectedˉname = Emittedˉname;
                        }
                    }
                }
                Directoryˉindex = Directoryˉindex + 1u32;
            }
            Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Selectedˉdirectory));
            if Found {
                Priorˉname = Selectedˉname;
                Hasˉpriorˉname = true;
            }
            Nominal = Nominal + 1u32;
        }
        if Nominalˉkind == Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Enum {
            Nominalˉkind = Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Variant;
        } else {
            Nominalˉkind = Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Enum;
        }
        Nominalˉkinds = Nominalˉkinds + 1u32;
    }
    let Nominals: u32 = Priorˉrecords + Priorˉenums + Priorˉvariants;
    let Reverseˉoffset: u32 = 4112u32 + Entries * 4u32;
    var Forwardˉdirectory: u32 = 0u32;
    while Forwardˉdirectory < Entries {
        var Forwardˉnominal: u32 = 0u32;
        var Directoryˉnominal: u32 = Nominals;
        while Forwardˉnominal < Nominals {
            if Bytesˉreadˉu32ˉlittle(
                Result, Reverseˉoffset + Forwardˉnominal * 4u32
            ) == Forwardˉdirectory {
                Directoryˉnominal = Forwardˉnominal;
                Forwardˉnominal = Nominals;
            }
            Forwardˉnominal = Forwardˉnominal + 1u32;
        }
        Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Directoryˉnominal));
        Forwardˉdirectory = Forwardˉdirectory + 1u32;
    }
    var Exportˉdirectory: u32 = 0u32;
    while Exportˉdirectory < Entries {
        let Exportˉentry: u32 = 16u32 + Exportˉdirectory * 24u32;
        let Exportˉmodule: u32 = Bytesˉreadˉu32ˉlittle(Directory, Exportˉentry);
        let Exportˉview: Sourceˉset.Compilerˉsourceˉsetˉview = Sourceˉset.Compilerˉsourceˉsetˉmodule(
            Input, Scan, Exportˉmodule
        );
        let Exportˉoffset: u32 = Bytesˉreadˉu32ˉlittle(
            Directory, Exportˉentry + 8u32
        );
        let Exportˉtoken: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Exportˉview.Source, Exportˉoffset, 1u32, 1u32
        );
        var Exported: u8 = 0u8;
        if Exportˉtoken.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Export {
            Exported = 1u8;
        }
        Result = Bytesˉconcat(Result, Bytesˉfromˉu8(Exported));
        Exportˉdirectory = Exportˉdirectory + 1u32;
    }
    var Aliasˉowner: u32 = 0u32;
    while Aliasˉowner < Scan.Modules {
        var Aliasˉrow: bytes = Compilerˉsourceˉsymbolsˉempty(Input);
        var Aliasˉtarget: u32 = 0u32;
        while Aliasˉtarget < Scan.Modules {
            Aliasˉrow = Bytesˉconcat(Aliasˉrow, Bytesˉfromˉu32ˉlittle(0u32));
            Aliasˉrow = Bytesˉconcat(Aliasˉrow, Bytesˉfromˉu32ˉlittle(0u32));
            Aliasˉtarget = Aliasˉtarget + 1u32;
        }
        let Aliasˉview: Sourceˉset.Compilerˉsourceˉsetˉview = Sourceˉset.Compilerˉsourceˉsetˉmodule(
            Input, Scan, Aliasˉowner
        );
        let Aliasˉheader: Sourceˉdeclarations.Compilerˉsourceˉheader = Sourceˉdeclarations.Compilerˉparseˉheaderˉvalidated(
            Aliasˉview.Source
        );
        var Aliasˉcursor: u32 = Aliasˉheader.Nextˉoffset;
        var Aliasˉline: u32 = Aliasˉheader.Nextˉline;
        var Aliasˉcolumn: u32 = Aliasˉheader.Nextˉcolumn;
        var Readingˉaliases: bool = true;
        while Readingˉaliases {
            let Aliasˉimport: Sourceˉdeclarations.Compilerˉsourceˉdeclaration = Sourceˉdeclarations.Compilerˉparseˉnextˉdeclarationˉvalidated(
                Aliasˉview.Source, Aliasˉcursor, Aliasˉline, Aliasˉcolumn, false
            );
            if Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉisˉheaderˉmetadata(
                Aliasˉimport
            ) {
                Aliasˉcursor = Aliasˉimport.Nextˉoffset;
                Aliasˉline = Aliasˉimport.Nextˉline;
                Aliasˉcolumn = Aliasˉimport.Nextˉcolumn;
            } else if Aliasˉimport.Kind != Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Import {
                Readingˉaliases = false;
            } else {
                let Imported: Sourceˉgraph.Compilerˉsourceˉgraphˉmatch = Sourceˉgraph.Compilerˉsourceˉgraphˉfind(
                    Input, Scan, Aliasˉview.Source,
                    Aliasˉimport.Nameˉoffset, Aliasˉimport.Nameˉlength
                );
                var Aliasˉentry: bytes = Bytesˉfromˉu32ˉlittle(Aliasˉimport.Bodyˉoffset);
                Aliasˉentry = Bytesˉconcat(
                    Aliasˉentry, Bytesˉfromˉu32ˉlittle(Aliasˉimport.Bodyˉlength)
                );
                let Replacedˉalias: Byteˉconstruction.Foundationˉbytesˉresult = Byteˉconstruction.Foundationˉbytesˉreplace(
                    Aliasˉrow, Imported.Index * 8u32, 8u32, Aliasˉentry
                );
                Aliasˉrow = Replacedˉalias.Value;
                Aliasˉcursor = Aliasˉimport.Nextˉoffset;
                Aliasˉline = Aliasˉimport.Nextˉline;
                Aliasˉcolumn = Aliasˉimport.Nextˉcolumn;
            }
        }
        Result = Bytesˉconcat(Result, Aliasˉrow);
        Aliasˉowner = Aliasˉowner + 1u32;
    }
    var Nameˉdirectory: bytes = Compilerˉsourceˉsymbolsˉempty(Input);
    var Nameˉpayload: bytes = Compilerˉsourceˉsymbolsˉempty(Input);
    var Nameˉentry: u32 = 0u32;
    while Nameˉentry < Entries {
        let Cachedˉname: bytes = Compilerˉsourceˉsymbolsˉemittedˉname(
            Input, Scan, Directory, Nameˉentry
        );
        Nameˉdirectory = Bytesˉconcat(
            Nameˉdirectory, Bytesˉfromˉu32ˉlittle(Bytesˉlength(Nameˉpayload))
        );
        Nameˉdirectory = Bytesˉconcat(
            Nameˉdirectory, Bytesˉfromˉu32ˉlittle(Bytesˉlength(Cachedˉname))
        );
        Nameˉpayload = Bytesˉconcat(Nameˉpayload, Cachedˉname);
        Nameˉentry = Nameˉentry + 1u32;
    }
    Result = Bytesˉconcat(Result, Nameˉdirectory);
    Result = Bytesˉconcat(Result, Nameˉpayload);
    return Result;
}

export fn Compilerˉsourceˉsymbolsˉlookupˉmetadataˉoffset(Lookup: bytes) -> u32 {
    let Entries: u32 = Bytesˉreadˉu32ˉlittle(Lookup, 8u32);
    let Variants: u32 = Bytesˉreadˉu32ˉlittle(Lookup, 12u32);
    let Totalˉrange: u32 = 16u32 + 255u32 * 16u32;
    let Records: u32 = Bytesˉreadˉu32ˉlittle(Lookup, Totalˉrange + 8u32);
    let Enums: u32 = Bytesˉreadˉu32ˉlittle(Lookup, Totalˉrange + 12u32);
    return 4112u32 + Entries * 4u32 + (Records + Enums + Variants) * 4u32 + Entries * 4u32;
}

export fn Compilerˉsourceˉsymbolsˉlookupˉaliasˉoffset(Lookup: bytes) -> u32 {
    let Entries: u32 = Bytesˉreadˉu32ˉlittle(Lookup, 8u32);
    return Compilerˉsourceˉsymbolsˉlookupˉmetadataˉoffset(Lookup) + Entries;
}

export fn Compilerˉsourceˉsymbolsˉlookupˉnameˉdirectoryˉoffset(
    Lookup: bytes,
    Modules: u32
) -> u32 {
    return Compilerˉsourceˉsymbolsˉlookupˉaliasˉoffset(Lookup) +
        Modules * Modules * 8u32;
}

export fn Compilerˉsourceˉsymbolsˉlookupˉemittedˉname(
    Lookup: bytes,
    Modules: u32,
    Directoryˉindex: u32
) -> bytes {
    let Entries: u32 = Bytesˉreadˉu32ˉlittle(Lookup, 8u32);
    if Directoryˉindex >= Entries { return Bytesˉslice(Lookup, 0u32, 0u32); }
    let Nameˉdirectory: u32 = Compilerˉsourceˉsymbolsˉlookupˉnameˉdirectoryˉoffset(
        Lookup, Modules
    );
    let Nameˉpayload: u32 = Nameˉdirectory + Entries * 8u32;
    let Entry: u32 = Nameˉdirectory + Directoryˉindex * 8u32;
    let Offset: u32 = Bytesˉreadˉu32ˉlittle(Lookup, Entry);
    let Length: u32 = Bytesˉreadˉu32ˉlittle(Lookup, Entry + 4u32);
    if Bytesˉlength(Lookup) < Nameˉpayload + Offset + Length {
        return Bytesˉslice(Lookup, 0u32, 0u32);
    }
    return Bytesˉslice(Lookup, Nameˉpayload + Offset, Length);
}

export fn Compilerˉsourceˉsymbolsˉlookupˉisˉexported(
    Lookup: bytes,
    Directoryˉindex: u32
) -> bool {
    let Entries: u32 = Bytesˉreadˉu32ˉlittle(Lookup, 8u32);
    if Directoryˉindex >= Entries { return false; }
    let Exportˉoffset: u32 = Compilerˉsourceˉsymbolsˉlookupˉmetadataˉoffset(Lookup);
    if Bytesˉlength(Lookup) < Exportˉoffset + Entries { return false; }
    return Bytesˉreadˉu8(Lookup, Exportˉoffset + Directoryˉindex) == 1u8;
}

export fn Compilerˉsourceˉsymbolsˉlookupˉaliasˉtarget(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Lookup: bytes,
    Owner: u32,
    Nameˉsource: bytes,
    Nameˉoffset: u32,
    Nameˉlength: u32
) -> Sourceˉgraph.Compilerˉsourceˉgraphˉmatch {
    if Owner >= Scan.Modules {
        return Sourceˉgraph.Compilerˉsourceˉgraphˉmatch(false, Scan.Modules);
    }
    let Entries: u32 = Bytesˉreadˉu32ˉlittle(Lookup, 8u32);
    let Aliasˉoffset: u32 = Compilerˉsourceˉsymbolsˉlookupˉaliasˉoffset(Lookup);
    if Bytesˉlength(Lookup) < Aliasˉoffset + Scan.Modules * Scan.Modules * 8u32 {
        return Sourceˉgraph.Compilerˉsourceˉgraphˉmatch(false, Scan.Modules);
    }
    let View: Sourceˉset.Compilerˉsourceˉsetˉview = Sourceˉset.Compilerˉsourceˉsetˉmodule(
        Input, Scan, Owner
    );
    var Target: u32 = 0u32;
    while Target < Scan.Modules {
        let Entry: u32 = Aliasˉoffset + (Owner * Scan.Modules + Target) * 8u32;
        let Candidateˉoffset: u32 = Bytesˉreadˉu32ˉlittle(Lookup, Entry);
        let Candidateˉlength: u32 = Bytesˉreadˉu32ˉlittle(Lookup, Entry + 4u32);
        if Candidateˉlength == Nameˉlength {
            if Candidateˉlength != 0u32 {
                if Sourceˉset.Compilerˉsourceˉspansˉequal(
                    View.Source, Candidateˉoffset, Candidateˉlength,
                    Nameˉsource, Nameˉoffset, Nameˉlength
                ) {
                    return Sourceˉgraph.Compilerˉsourceˉgraphˉmatch(true, Target);
                }
            }
        }
        Target = Target + 1u32;
    }
    return Sourceˉgraph.Compilerˉsourceˉgraphˉmatch(false, Scan.Modules);
}

export fn Compilerˉsourceˉsymbolsˉlookupˉrange(
    Lookup: bytes,
    First: u8
) -> Sourceˉbodies.Compilerˉsourceˉposition {
    let Rangeˉentry: u32 = 16u32 + U32ˉfromˉu8(First) * 16u32;
    return Sourceˉbodies.Compilerˉsourceˉposition(
        Bytesˉreadˉu32ˉlittle(Lookup, Rangeˉentry),
        Bytesˉreadˉu32ˉlittle(Lookup, Rangeˉentry + 4u32),
        0u32
    );
}

export fn Compilerˉsourceˉsymbolsˉlookupˉnominalˉprefix(
    Lookup: bytes,
    First: u8,
    Kind: Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind
) -> u32 {
    let Rangeˉentry: u32 = 16u32 + U32ˉfromˉu8(First) * 16u32;
    if Kind == Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Record {
        return Bytesˉreadˉu32ˉlittle(Lookup, Rangeˉentry + 8u32);
    }
    return Bytesˉreadˉu32ˉlittle(Lookup, Rangeˉentry + 12u32);
}

export fn Compilerˉsourceˉsymbolsˉdirectoryˉentry(
    Directory: bytes,
    Modules: u32,
    Index: u32
) -> Compilerˉsourceˉsymbolˉmatch {
    if Bytesˉlength(Directory) < 16u32 {
        return Compilerˉsourceˉsymbolsˉmatchˉnone(Modules);
    }
    let Entries: u32 = Bytesˉreadˉu32ˉlittle(Directory, 8u32);
    if Index >= Entries { return Compilerˉsourceˉsymbolsˉmatchˉnone(Modules); }
    let Offset: u32 = 16u32 + Index * 24u32;
    return Compilerˉsourceˉsymbolˉmatch(
        true,
        Bytesˉreadˉu32ˉlittle(Directory, Offset),
        Compilerˉsourceˉsymbolsˉdeclarationˉkind(
            Bytesˉreadˉu32ˉlittle(Directory, Offset + 4u32)
        ),
        Bytesˉreadˉu32ˉlittle(Directory, Offset + 8u32),
        Bytesˉreadˉu32ˉlittle(Directory, Offset + 12u32),
        Bytesˉreadˉu32ˉlittle(Directory, Offset + 16u32),
        Index
    );
}

export fn Compilerˉsourceˉsymbolsˉdirectoryˉisˉvalid(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Directory: bytes,
    Expectedˉentries: u32
) -> bool {
    let Total: u32 = Bytesˉlength(Directory);
    if Total < 16u32 { return false; }
    if Bytesˉreadˉu8(Directory, 0u32) != 87u8 { return false; }
    if Bytesˉreadˉu8(Directory, 1u32) != 86u8 { return false; }
    if Bytesˉreadˉu8(Directory, 2u32) != 83u8 { return false; }
    if Bytesˉreadˉu8(Directory, 3u32) != 68u8 { return false; }
    if Bytesˉreadˉu16ˉlittle(Directory, 4u32) != 1u32 { return false; }
    if Bytesˉreadˉu16ˉlittle(Directory, 6u32) != 1u32 { return false; }
    if Bytesˉreadˉu32ˉlittle(Directory, 8u32) != Expectedˉentries { return false; }
    if Bytesˉreadˉu32ˉlittle(Directory, 12u32) != 24u32 { return false; }
    if Expectedˉentries > 174762u32 { return false; }
    if Total != 16u32 + Expectedˉentries * 24u32 { return false; }
    var Entryˉindex: u32 = 0u32;
    var Module: u32 = 0u32;
    while Module < Scan.Modules {
        let View: Sourceˉset.Compilerˉsourceˉsetˉview = Sourceˉset.Compilerˉsourceˉsetˉmodule(Input, Scan, Module);
        let Header: Sourceˉdeclarations.Compilerˉsourceˉheader = Sourceˉdeclarations.Compilerˉparseˉheaderˉvalidated(View.Source);
        var Cursor: u32 = Header.Nextˉoffset;
        var Currentˉline: u32 = Header.Nextˉline;
        var Currentˉcolumn: u32 = Header.Nextˉcolumn;
        var Sawˉnonˉimport: bool = false;
        var Reading: bool = true;
        while Reading {
            let Declaration: Sourceˉdeclarations.Compilerˉsourceˉdeclaration = Sourceˉdeclarations.Compilerˉparseˉnextˉdeclarationˉvalidated(
                View.Source, Cursor, Currentˉline, Currentˉcolumn, Sawˉnonˉimport
            );
            if Declaration.Kind == Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.End {
                Reading = false;
            } else {
                if Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉisˉsymbol(Declaration) {
                    if Entryˉindex >= Expectedˉentries { return false; }
                    let Entryˉoffset: u32 = 16u32 + Entryˉindex * 24u32;
                    if Bytesˉreadˉu32ˉlittle(Directory, Entryˉoffset) != Module { return false; }
                    if Bytesˉreadˉu32ˉlittle(Directory, Entryˉoffset + 4u32) !=
                        Compilerˉsourceˉsymbolsˉdeclarationˉkindˉvalue(Declaration.Kind) {
                        return false;
                    }
                    if Bytesˉreadˉu32ˉlittle(Directory, Entryˉoffset + 8u32) !=
                        Declaration.Declarationˉoffset { return false; }
                    if Bytesˉreadˉu32ˉlittle(Directory, Entryˉoffset + 12u32) !=
                        Declaration.Nameˉoffset { return false; }
                    if Bytesˉreadˉu32ˉlittle(Directory, Entryˉoffset + 16u32) !=
                        Declaration.Nameˉlength { return false; }
                    if Bytesˉreadˉu32ˉlittle(Directory, Entryˉoffset + 20u32) != Declaration.Items {
                        return false;
                    }
                    Entryˉindex = Entryˉindex + 1u32;
                    if Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉclosesˉimports(Declaration) {
                        Sawˉnonˉimport = true;
                    }
                }
                Cursor = Declaration.Nextˉoffset;
                Currentˉline = Declaration.Nextˉline;
                Currentˉcolumn = Declaration.Nextˉcolumn;
            }
        }
        Module = Module + 1u32;
    }
    return Entryˉindex == Expectedˉentries;
}

export fn Compilerˉsourceˉsymbolsˉdirectoryˉshapeˉisˉvalid(
    Directory: bytes,
    Expectedˉentries: u32
) -> bool {
    let Total: u32 = Bytesˉlength(Directory);
    if Total < 16u32 { return false; }
    if Bytesˉreadˉu8(Directory, 0u32) != 87u8 { return false; }
    if Bytesˉreadˉu8(Directory, 1u32) != 86u8 { return false; }
    if Bytesˉreadˉu8(Directory, 2u32) != 83u8 { return false; }
    if Bytesˉreadˉu8(Directory, 3u32) != 68u8 { return false; }
    if Bytesˉreadˉu16ˉlittle(Directory, 4u32) != 1u32 { return false; }
    if Bytesˉreadˉu16ˉlittle(Directory, 6u32) != 1u32 { return false; }
    if Bytesˉreadˉu32ˉlittle(Directory, 8u32) != Expectedˉentries { return false; }
    if Bytesˉreadˉu32ˉlittle(Directory, 12u32) != 24u32 { return false; }
    if Expectedˉentries > 174762u32 { return false; }
    return Total == 16u32 + Expectedˉentries * 24u32;
}

export fn Compilerˉsourceˉsymbolsˉkindˉisˉinˉnamespace(
    Kind: Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind,
    Namespace: Compilerˉsourceˉnamespaceˉkind
) -> bool {
    if Namespace == Compilerˉsourceˉnamespaceˉkind.Capability {
        return Kind == Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Capability;
    }
    if Namespace == Compilerˉsourceˉnamespaceˉkind.Data {
        if Kind == Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Data { return true; }
        return Kind == Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Constant;
    }
    if Namespace == Compilerˉsourceˉnamespaceˉkind.Nominal {
        if Kind == Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Record { return true; }
        if Kind == Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Enum { return true; }
        return Kind == Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Variant;
    }
    if Namespace == Compilerˉsourceˉnamespaceˉkind.Function {
        return Kind == Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Function;
    }
    if Namespace == Compilerˉsourceˉnamespaceˉkind.Constant {
        return Kind == Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Constant;
    }
    if Kind == Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Record { return true; }
    return Kind == Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Function;
}

export fn Compilerˉsourceˉsymbolsˉfindˉpriorˉinˉdirectory(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Directory: bytes,
    Lookup: bytes,
    Currentˉmodule: u32,
    Currentˉdeclaration: u32,
    Nameˉsource: bytes,
    Nameˉoffset: u32,
    Nameˉlength: u32,
    Namespace: Compilerˉsourceˉnamespaceˉkind
) -> Compilerˉsourceˉsymbolˉmatch {
    let Range: Sourceˉbodies.Compilerˉsourceˉposition = Compilerˉsourceˉsymbolsˉlookupˉrange(
        Lookup, Bytesˉreadˉu8(Nameˉsource, Nameˉoffset)
    );
    var Index: u32 = 0u32;
    while Index < Range.Line {
        let Directoryˉindex: u32 = Bytesˉreadˉu32ˉlittle(
            Lookup, 4112u32 + (Range.Offset + Index) * 4u32
        );
        let Entry: u32 = 16u32 + Directoryˉindex * 24u32;
        let Entryˉmodule: u32 = Bytesˉreadˉu32ˉlittle(Directory, Entry);
        let Entryˉkind: u32 = Bytesˉreadˉu32ˉlittle(Directory, Entry + 4u32);
        var Isˉinˉnamespace: bool = false;
        if Entryˉmodule == Currentˉmodule {
            if Bytesˉreadˉu32ˉlittle(Directory, Entry + 8u32) < Currentˉdeclaration {
                if Namespace == Compilerˉsourceˉnamespaceˉkind.Capability {
                    Isˉinˉnamespace = Entryˉkind == 2u32;
                }
                if Namespace == Compilerˉsourceˉnamespaceˉkind.Data {
                    Isˉinˉnamespace = Entryˉkind == 3u32;
                    if Entryˉkind == 7u32 { Isˉinˉnamespace = true; }
                }
                if Namespace == Compilerˉsourceˉnamespaceˉkind.Nominal {
                    Isˉinˉnamespace = Entryˉkind == 4u32;
                    if Entryˉkind == 5u32 { Isˉinˉnamespace = true; }
                    if Entryˉkind == 8u32 { Isˉinˉnamespace = true; }
                }
                if Namespace == Compilerˉsourceˉnamespaceˉkind.Function {
                    Isˉinˉnamespace = Entryˉkind == 6u32;
                }
                if Namespace == Compilerˉsourceˉnamespaceˉkind.Constant {
                    Isˉinˉnamespace = Entryˉkind == 7u32;
                }
                if Namespace == Compilerˉsourceˉnamespaceˉkind.Constructor {
                    Isˉinˉnamespace = Entryˉkind == 4u32;
                    if Entryˉkind == 6u32 { Isˉinˉnamespace = true; }
                }
            }
        }
        if Isˉinˉnamespace {
            let Sourceˉentry: u32 = Scan.Directoryˉoffset + Entryˉmodule * 8u32;
            let Sourceˉoffset: u32 = Bytesˉreadˉu32ˉlittle(Input, Sourceˉentry);
            let Entryˉnameˉoffset: u32 = Bytesˉreadˉu32ˉlittle(Directory, Entry + 12u32);
            let Entryˉnameˉlength: u32 = Bytesˉreadˉu32ˉlittle(Directory, Entry + 16u32);
            if Entryˉnameˉlength == Nameˉlength {
                if Sourceˉset.Compilerˉsourceˉspansˉequal(
                    Input, Sourceˉoffset + Entryˉnameˉoffset, Entryˉnameˉlength,
                    Nameˉsource, Nameˉoffset, Nameˉlength
                ) {
                    return Compilerˉsourceˉsymbolsˉdirectoryˉentry(
                        Directory, Scan.Modules, Directoryˉindex
                    );
                }
            }
        }
        Index = Index + 1u32;
    }
    return Compilerˉsourceˉsymbolsˉmatchˉnone(Scan.Modules);
}

export fn Compilerˉsourceˉsymbolsˉfindˉnominalˉinˉdirectory(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Directory: bytes,
    Lookup: bytes,
    Nameˉsource: bytes,
    Nameˉoffset: u32,
    Nameˉlength: u32
) -> Compilerˉsourceˉsymbolˉmatch {
    let Entries: u32 = Bytesˉreadˉu32ˉlittle(Directory, 8u32);
    let Reverseˉoffset: u32 = 4112u32 + Entries * 4u32;
    let First: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(Nameˉsource, Nameˉoffset));
    let Rangeˉentry: u32 = 16u32 + First * 16u32;
    let Totalˉrange: u32 = 16u32 + 255u32 * 16u32;
    let Records: u32 = Bytesˉreadˉu32ˉlittle(Lookup, Totalˉrange + 8u32);
    let Enums: u32 = Bytesˉreadˉu32ˉlittle(Lookup, Totalˉrange + 12u32);
    var Begin: u32 = Bytesˉreadˉu32ˉlittle(Lookup, Rangeˉentry + 8u32);
    var End: u32 = Records;
    if First < 255u32 {
        End = Bytesˉreadˉu32ˉlittle(Lookup, Rangeˉentry + 24u32);
    }
    var Pass: u32 = 0u32;
    while Pass < 2u32 {
        var Index: u32 = Begin;
        while Index < End {
            let Directoryˉindex: u32 = Bytesˉreadˉu32ˉlittle(
                Lookup, Reverseˉoffset + Index * 4u32
            );
            let Entry: u32 = 16u32 + Directoryˉindex * 24u32;
            let Entryˉmodule: u32 = Bytesˉreadˉu32ˉlittle(Directory, Entry);
            let Sourceˉentry: u32 = Scan.Directoryˉoffset + Entryˉmodule * 8u32;
            let Sourceˉoffset: u32 = Bytesˉreadˉu32ˉlittle(Input, Sourceˉentry);
            let Entryˉnameˉoffset: u32 = Bytesˉreadˉu32ˉlittle(Directory, Entry + 12u32);
            let Entryˉnameˉlength: u32 = Bytesˉreadˉu32ˉlittle(Directory, Entry + 16u32);
            if Entryˉnameˉlength == Nameˉlength {
                if Sourceˉset.Compilerˉsourceˉspansˉequal(
                    Input, Sourceˉoffset + Entryˉnameˉoffset, Entryˉnameˉlength,
                    Nameˉsource, Nameˉoffset, Nameˉlength
                ) {
                    return Compilerˉsourceˉsymbolsˉdirectoryˉentry(
                        Directory, Scan.Modules, Directoryˉindex
                    );
                }
            }
            Index = Index + 1u32;
        }
        Begin = Records + Bytesˉreadˉu32ˉlittle(Lookup, Rangeˉentry + 12u32);
        End = Records + Enums;
        if First < 255u32 {
            End = Records + Bytesˉreadˉu32ˉlittle(Lookup, Rangeˉentry + 28u32);
        }
        Pass = Pass + 1u32;
    }
    return Compilerˉsourceˉsymbolsˉmatchˉnone(Scan.Modules);
}

export fn Compilerˉsourceˉsymbolsˉquery(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Lookup: bytes,
    Owner: u32,
    Source: bytes,
    Nameˉoffset: u32,
    Nameˉlength: u32
) -> Compilerˉsourceˉsymbolˉquery {
    var Dot: u32 = Nameˉlength;
    var Character: u32 = 0u32;
    while Character < Nameˉlength {
        if Dot == Nameˉlength {
            if Bytesˉreadˉu8(Source, Nameˉoffset + Character) == 46u8 {
                Dot = Character;
            }
        }
        Character = Character + 1u32;
    }
    var Aliasˉfound: bool = false;
    var Target: u32 = Owner;
    if Dot < Nameˉlength {
        let Importˉtarget: Sourceˉgraph.Compilerˉsourceˉgraphˉmatch =
            Compilerˉsourceˉsymbolsˉlookupˉaliasˉtarget(
                Input, Scan, Lookup, Owner, Source, Nameˉoffset, Dot
            );
        Aliasˉfound = Importˉtarget.Found;
        Target = Importˉtarget.Index;
        return Compilerˉsourceˉsymbolˉquery(
            true, Aliasˉfound, Target,
            Nameˉoffset + Dot + 1u32, Nameˉlength - Dot - 1u32
        );
    }
    return Compilerˉsourceˉsymbolˉquery(
        false, true, Owner, Nameˉoffset, Nameˉlength
    );
}

export fn Compilerˉsourceˉsymbolsˉdeclarationˉisˉexported(
    Lookup: bytes,
    Match: Compilerˉsourceˉsymbolˉmatch
) -> bool {
    if !Match.Found { return false; }
    return Compilerˉsourceˉsymbolsˉlookupˉisˉexported(
        Lookup, Match.Directoryˉindex
    );
}

export fn Compilerˉsourceˉsymbolsˉfindˉownedˉnominal(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Directory: bytes,
    Lookup: bytes,
    Owner: u32,
    Source: bytes,
    Nameˉoffset: u32,
    Nameˉlength: u32
) -> Compilerˉsourceˉsymbolˉmatch {
    let Query: Compilerˉsourceˉsymbolˉquery = Compilerˉsourceˉsymbolsˉquery(
        Input, Scan, Lookup, Owner, Source, Nameˉoffset, Nameˉlength
    );
    if Query.Qualified {
        if !Query.Aliasˉfound {
            return Compilerˉsourceˉsymbolsˉmatchˉnone(Scan.Modules);
        }
    }
    let Range: Sourceˉbodies.Compilerˉsourceˉposition = Compilerˉsourceˉsymbolsˉlookupˉrange(
        Lookup, Bytesˉreadˉu8(Source, Query.Nameˉoffset)
    );
    var Index: u32 = 0u32;
    while Index < Range.Line {
        let Directoryˉindex: u32 = Bytesˉreadˉu32ˉlittle(
            Lookup, 4112u32 + (Range.Offset + Index) * 4u32
        );
        let Entry: u32 = 16u32 + Directoryˉindex * 24u32;
        let Kind: u32 = Bytesˉreadˉu32ˉlittle(Directory, Entry + 4u32);
        let Target: u32 = Bytesˉreadˉu32ˉlittle(Directory, Entry);
        var Candidate: bool = Kind == 4u32;
        if Kind == 5u32 { Candidate = true; }
        if Kind == 8u32 { Candidate = true; }
        if Target != Query.Target { Candidate = false; }
        if Candidate {
            let View: Sourceˉset.Compilerˉsourceˉsetˉview = Sourceˉset.Compilerˉsourceˉsetˉmodule(Input, Scan, Target);
            let Targetˉoffset: u32 = Bytesˉreadˉu32ˉlittle(Directory, Entry + 12u32);
            let Targetˉlength: u32 = Bytesˉreadˉu32ˉlittle(Directory, Entry + 16u32);
            if Targetˉlength == Query.Nameˉlength {
                if Sourceˉset.Compilerˉsourceˉspansˉequal(
                    Source, Query.Nameˉoffset, Query.Nameˉlength,
                    View.Source, Targetˉoffset, Targetˉlength
                ) {
                    return Compilerˉsourceˉsymbolsˉdirectoryˉentry(
                        Directory, Scan.Modules, Directoryˉindex
                    );
                }
            }
        }
        Index = Index + 1u32;
    }
    return Compilerˉsourceˉsymbolsˉmatchˉnone(Scan.Modules);
}

export fn Compilerˉsourceˉsymbolsˉshapeˉisˉcapability(
    Directory: bytes,
    Shape: u32
) -> bool {
    if Shape < 268435456u32 { return false; }
    let Target: u32 = Shape - 268435456u32;
    let Entries: u32 = Bytesˉreadˉu32ˉlittle(Directory, 8u32);
    if Target >= Entries { return false; }
    let Entry: u32 = 16u32 + Target * 24u32;
    return Bytesˉreadˉu32ˉlittle(Directory, Entry) == 0u32 &&
        Bytesˉreadˉu32ˉlittle(Directory, Entry + 4u32) == 2u32;
}

export fn Compilerˉsourceˉsymbolsˉownedˉmatchˉisˉaccessible(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Visibility: bytes,
    Lookup: bytes,
    Owner: u32,
    Source: bytes,
    Nameˉoffset: u32,
    Nameˉlength: u32,
    Match: Compilerˉsourceˉsymbolˉmatch
) -> bool {
    let Query: Compilerˉsourceˉsymbolˉquery = Compilerˉsourceˉsymbolsˉquery(
        Input, Scan, Lookup, Owner, Source, Nameˉoffset, Nameˉlength
    );
    if Match.Module == Owner { return true; }
    if Query.Qualified {
        if Query.Aliasˉfound {
            return Compilerˉsourceˉsymbolsˉdeclarationˉisˉexported(Lookup, Match);
        }
    }
    return false;
}

export fn Compilerˉsourceˉsymbolsˉnominalˉindexˉinˉdirectory(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Directory: bytes,
    Lookup: bytes,
    Kind: Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind,
    Nameˉsource: bytes,
    Nameˉoffset: u32,
    Nameˉlength: u32,
    Records: u32
) -> u32 {
    let First: u8 = Bytesˉreadˉu8(Nameˉsource, Nameˉoffset);
    var Result: u32 = Compilerˉsourceˉsymbolsˉlookupˉnominalˉprefix(
        Lookup, First, Kind
    );
    if Kind == Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Enum { Result = Records; }
    if Kind == Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Enum {
        Result = Result + Compilerˉsourceˉsymbolsˉlookupˉnominalˉprefix(
            Lookup, First, Kind
        );
    }
    if Kind == Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Variant {
        Result = Records + Compilerˉsourceˉsymbolsˉdirectoryˉkindˉcount(Directory, 5u32);
    }
    let Kindˉvalue: u32 = Compilerˉsourceˉsymbolsˉdeclarationˉkindˉvalue(Kind);
    let Range: Sourceˉbodies.Compilerˉsourceˉposition = Compilerˉsourceˉsymbolsˉlookupˉrange(Lookup, First);
    var Index: u32 = 0u32;
    while Index < Range.Line {
        let Directoryˉindex: u32 = Bytesˉreadˉu32ˉlittle(
            Lookup, 4112u32 + (Range.Offset + Index) * 4u32
        );
        let Entry: u32 = 16u32 + Directoryˉindex * 24u32;
        if Bytesˉreadˉu32ˉlittle(Directory, Entry + 4u32) == Kindˉvalue {
            let Entryˉmodule: u32 = Bytesˉreadˉu32ˉlittle(Directory, Entry);
            let Sourceˉentry: u32 = Scan.Directoryˉoffset + Entryˉmodule * 8u32;
            let Sourceˉoffset: u32 = Bytesˉreadˉu32ˉlittle(Input, Sourceˉentry);
            let Entryˉnameˉoffset: u32 = Bytesˉreadˉu32ˉlittle(Directory, Entry + 12u32);
            let Entryˉnameˉlength: u32 = Bytesˉreadˉu32ˉlittle(Directory, Entry + 16u32);
            if Sourceˉset.Compilerˉsourceˉspansˉcompare(
                Input, Sourceˉoffset + Entryˉnameˉoffset, Entryˉnameˉlength,
                Nameˉsource, Nameˉoffset, Nameˉlength
            ) < 0 { Result = Result + 1u32; }
        }
        Index = Index + 1u32;
    }
    return Result;
}

export fn Compilerˉsourceˉsymbolsˉvisibility(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan
) -> bytes {
    var Matrix: bytes = Compilerˉsourceˉsymbolsˉempty(Input);
    var Owner: u32 = 0u32;
    while Owner < Scan.Modules {
        var Directˉrow: bytes = Sourceˉgraph.Compilerˉsourceˉgraphˉmark(
            Sourceˉgraph.Compilerˉsourceˉgraphˉstate(Scan.Modules),
            Owner
        );
        let View: Sourceˉset.Compilerˉsourceˉsetˉview = Sourceˉset.Compilerˉsourceˉsetˉmodule(Input, Scan, Owner);
        let Header: Sourceˉdeclarations.Compilerˉsourceˉheader = Sourceˉdeclarations.Compilerˉparseˉheaderˉvalidated(View.Source);
        var Cursor: u32 = Header.Nextˉoffset;
        var Currentˉline: u32 = Header.Nextˉline;
        var Currentˉcolumn: u32 = Header.Nextˉcolumn;
        var Reading: bool = true;
        while Reading {
            let Declaration: Sourceˉdeclarations.Compilerˉsourceˉdeclaration = Sourceˉdeclarations.Compilerˉparseˉnextˉdeclarationˉvalidated(
                View.Source, Cursor, Currentˉline, Currentˉcolumn, false
            );
            if Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉisˉheaderˉmetadata(Declaration) {
                Cursor = Declaration.Nextˉoffset;
                Currentˉline = Declaration.Nextˉline;
                Currentˉcolumn = Declaration.Nextˉcolumn;
            } else if Declaration.Kind != Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Import {
                Reading = false;
            } else {
                let Importˉtarget: Sourceˉgraph.Compilerˉsourceˉgraphˉmatch = Sourceˉgraph.Compilerˉsourceˉgraphˉfind(
                    Input, Scan, View.Source, Declaration.Nameˉoffset, Declaration.Nameˉlength
                );
                Directˉrow = Sourceˉgraph.Compilerˉsourceˉgraphˉmark(Directˉrow, Importˉtarget.Index);
                Cursor = Declaration.Nextˉoffset;
                Currentˉline = Declaration.Nextˉline;
                Currentˉcolumn = Declaration.Nextˉcolumn;
            }
        }
        Matrix = Bytesˉconcat(Matrix, Directˉrow);
        Owner = Owner + 1u32;
    }

    var Through: u32 = 0u32;
    while Through < Scan.Modules {
        var From: u32 = 0u32;
        while From < Scan.Modules {
            if Bytesˉreadˉu8(Matrix, From * Scan.Modules + Through) == 1u8 {
                var Closureˉrow: bytes = Compilerˉsourceˉsymbolsˉempty(Input);
                var Changed: bool = false;
                var To: u32 = 0u32;
                while To < Scan.Modules {
                    var Value: u8 = Bytesˉreadˉu8(Matrix, From * Scan.Modules + To);
                    if Value == 0u8 {
                        if Bytesˉreadˉu8(Matrix, Through * Scan.Modules + To) == 1u8 {
                            Value = 1u8;
                            Changed = true;
                        }
                    }
                    Closureˉrow = Bytesˉconcat(Closureˉrow, Bytesˉfromˉu8(Value));
                    To = To + 1u32;
                }
                if Changed {
                    let Replaced: Byteˉconstruction.Foundationˉbytesˉresult = Byteˉconstruction.Foundationˉbytesˉreplace(
                        Matrix,
                        From * Scan.Modules,
                        Scan.Modules,
                        Closureˉrow
                    );
                    Matrix = Replaced.Value;
                }
            }
            From = From + 1u32;
        }
        Through = Through + 1u32;
    }
    return Matrix;
}

export fn Compilerˉsourceˉsymbolsˉisˉvisible(
    Visibility: bytes,
    Modules: u32,
    Owner: u32,
    Target: u32
) -> bool {
    if Owner >= Modules { return false; }
    if Target >= Modules { return false; }
    if Bytesˉlength(Visibility) != Modules * Modules { return false; }
    return Bytesˉreadˉu8(Visibility, Owner * Modules + Target) == 1u8;
}

export fn Compilerˉsourceˉsymbolsˉtypeˉfailure(
    Status: Compilerˉsourceˉsymbolˉstatus,
    Kind: Sourceˉdeclarations.Compilerˉsourceˉtypeˉkind,
    Nominalˉkind: Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind,
    Nominalˉindex: u32,
    Nominalˉmodule: u32,
    Token: Sourceˉlexer.Compilerˉsourceˉtoken
) -> Compilerˉsourceˉtypeˉbinding {
    return Compilerˉsourceˉtypeˉbinding(
        Status,
        Kind,
        Nominalˉkind,
        Nominalˉindex,
        Nominalˉmodule,
        Token.Offset,
        Token.Length,
        Token.Nextˉoffset,
        Token.Nextˉline,
        Token.Nextˉcolumn,
        Token.Offset,
        Token.Line,
        Token.Column
    );
}

export fn Compilerˉsourceˉsymbolsˉbindˉtype(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Directory: bytes,
    Lookup: bytes,
    Visibility: bytes,
    Owner: u32,
    Source: bytes,
    Offset: u32,
    Line: u32,
    Column: u32,
    Records: u32,
    Enums: u32,
    Forˉfield: bool
) -> Compilerˉsourceˉtypeˉbinding {
    let Token: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(Source, Offset, Line, Column);
    var Kind: Sourceˉdeclarations.Compilerˉsourceˉtypeˉkind = Sourceˉdeclarations.Compilerˉsourceˉtypeˉkind.Unknown;
    if Token.Kind == Sourceˉlexer.Compilerˉtokenˉkind.I8 { Kind = Sourceˉdeclarations.Compilerˉsourceˉtypeˉkind.I8; }
    if Token.Kind == Sourceˉlexer.Compilerˉtokenˉkind.I16 { Kind = Sourceˉdeclarations.Compilerˉsourceˉtypeˉkind.I16; }
    if Token.Kind == Sourceˉlexer.Compilerˉtokenˉkind.I32 { Kind = Sourceˉdeclarations.Compilerˉsourceˉtypeˉkind.I32; }
    if Token.Kind == Sourceˉlexer.Compilerˉtokenˉkind.U8 { Kind = Sourceˉdeclarations.Compilerˉsourceˉtypeˉkind.U8; }
    if Token.Kind == Sourceˉlexer.Compilerˉtokenˉkind.U16 { Kind = Sourceˉdeclarations.Compilerˉsourceˉtypeˉkind.U16; }
    if Token.Kind == Sourceˉlexer.Compilerˉtokenˉkind.U32 { Kind = Sourceˉdeclarations.Compilerˉsourceˉtypeˉkind.U32; }
    if Token.Kind == Sourceˉlexer.Compilerˉtokenˉkind.I64 { Kind = Sourceˉdeclarations.Compilerˉsourceˉtypeˉkind.I64; }
    if Token.Kind == Sourceˉlexer.Compilerˉtokenˉkind.U64 { Kind = Sourceˉdeclarations.Compilerˉsourceˉtypeˉkind.U64; }
    if Token.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Bool { Kind = Sourceˉdeclarations.Compilerˉsourceˉtypeˉkind.Bool; }
    if Token.Kind == Sourceˉlexer.Compilerˉtokenˉkind.F32 { Kind = Sourceˉdeclarations.Compilerˉsourceˉtypeˉkind.F32; }
    if Token.Kind == Sourceˉlexer.Compilerˉtokenˉkind.F64 { Kind = Sourceˉdeclarations.Compilerˉsourceˉtypeˉkind.F64; }
    if Token.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Rune { Kind = Sourceˉdeclarations.Compilerˉsourceˉtypeˉkind.Rune; }
    if Token.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Unit { Kind = Sourceˉdeclarations.Compilerˉsourceˉtypeˉkind.Unit; }
    if Token.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Never { Kind = Sourceˉdeclarations.Compilerˉsourceˉtypeˉkind.Never; }
    if Token.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Text { Kind = Sourceˉdeclarations.Compilerˉsourceˉtypeˉkind.Text; }
    if Token.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Bytes { Kind = Sourceˉdeclarations.Compilerˉsourceˉtypeˉkind.Bytes; }
    if Token.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Void { Kind = Sourceˉdeclarations.Compilerˉsourceˉtypeˉkind.Void; }
    if Token.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Identifier { Kind = Sourceˉdeclarations.Compilerˉsourceˉtypeˉkind.Named; }
    if Token.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Sequence { Kind = Sourceˉdeclarations.Compilerˉsourceˉtypeˉkind.Sequence; }
    if Token.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Builder { Kind = Sourceˉdeclarations.Compilerˉsourceˉtypeˉkind.Builder; }
    let Variants: u32 = Compilerˉsourceˉsymbolsˉdirectoryˉkindˉcount(Directory, 8u32);
    let Nominalˉsentinel: u32 = Records + Enums + Variants;
    if Kind == Sourceˉdeclarations.Compilerˉsourceˉtypeˉkind.Sequence || Kind == Sourceˉdeclarations.Compilerˉsourceˉtypeˉkind.Builder {
        if Forˉfield {
            if Kind == Sourceˉdeclarations.Compilerˉsourceˉtypeˉkind.Builder {
                return Compilerˉsourceˉsymbolsˉtypeˉfailure(
                    Compilerˉsourceˉsymbolˉstatus.Invalidˉfieldˉtype,
                    Kind, Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.End,
                    Nominalˉsentinel, Scan.Modules, Token
                );
            }
        }
        let Left: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Source, Token.Nextˉoffset, Token.Nextˉline, Token.Nextˉcolumn
        );
        let Element: Compilerˉsourceˉtypeˉbinding = Compilerˉsourceˉsymbolsˉbindˉtype(
            Input, Scan, Directory, Lookup, Visibility, Owner, Source,
            Left.Nextˉoffset, Left.Nextˉline, Left.Nextˉcolumn,
            Records, Enums, false
        );
        if Element.Status != Compilerˉsourceˉsymbolˉstatus.Valid { return Element; }
        if Element.Nominalˉkind == Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Capability {
            return Compilerˉsourceˉsymbolsˉtypeˉfailure(
                Compilerˉsourceˉsymbolˉstatus.Invalidˉcollectionˉelement,
                Kind, Element.Nominalˉkind, Element.Nominalˉindex,
                Element.Nominalˉmodule, Token
            );
        }
        var Elementˉshape: u32 = 0u32;
        if Element.Kind == Sourceˉdeclarations.Compilerˉsourceˉtypeˉkind.I32 { Elementˉshape = 1u32; }
        if Element.Kind == Sourceˉdeclarations.Compilerˉsourceˉtypeˉkind.Unit { Elementˉshape = 9u32; }
        if Element.Kind == Sourceˉdeclarations.Compilerˉsourceˉtypeˉkind.Never { Elementˉshape = 10u32; }
        if Element.Kind == Sourceˉdeclarations.Compilerˉsourceˉtypeˉkind.I8 { Elementˉshape = 11u32; }
        if Element.Kind == Sourceˉdeclarations.Compilerˉsourceˉtypeˉkind.I16 { Elementˉshape = 12u32; }
        if Element.Kind == Sourceˉdeclarations.Compilerˉsourceˉtypeˉkind.U16 { Elementˉshape = 13u32; }
        if Element.Kind == Sourceˉdeclarations.Compilerˉsourceˉtypeˉkind.F32 { Elementˉshape = 14u32; }
        if Element.Kind == Sourceˉdeclarations.Compilerˉsourceˉtypeˉkind.F64 { Elementˉshape = 15u32; }
        if Element.Kind == Sourceˉdeclarations.Compilerˉsourceˉtypeˉkind.Rune { Elementˉshape = 16u32; }
        if Element.Kind == Sourceˉdeclarations.Compilerˉsourceˉtypeˉkind.U8 { Elementˉshape = 2u32; }
        if Element.Kind == Sourceˉdeclarations.Compilerˉsourceˉtypeˉkind.U32 { Elementˉshape = 3u32; }
        if Element.Kind == Sourceˉdeclarations.Compilerˉsourceˉtypeˉkind.I64 { Elementˉshape = 7u32; }
        if Element.Kind == Sourceˉdeclarations.Compilerˉsourceˉtypeˉkind.U64 { Elementˉshape = 8u32; }
        if Element.Kind == Sourceˉdeclarations.Compilerˉsourceˉtypeˉkind.Bool { Elementˉshape = 4u32; }
        if Element.Kind == Sourceˉdeclarations.Compilerˉsourceˉtypeˉkind.Text { Elementˉshape = 5u32; }
        if Element.Kind == Sourceˉdeclarations.Compilerˉsourceˉtypeˉkind.Bytes { Elementˉshape = 6u32; }
        if Element.Nominalˉkind == Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Record { Elementˉshape = 4096u32 + Element.Nominalˉindex; }
        if Element.Nominalˉkind == Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Enum { Elementˉshape = 8192u32 + Element.Nominalˉindex; }
        if Element.Nominalˉkind == Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Variant { Elementˉshape = 12288u32 + Element.Nominalˉindex; }
        let Comma: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Source, Element.Nextˉoffset, Element.Nextˉline, Element.Nextˉcolumn
        );
        let Maximum: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Source, Comma.Nextˉoffset, Comma.Nextˉline, Comma.Nextˉcolumn
        );
        let Right: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Source, Maximum.Nextˉoffset, Maximum.Nextˉline, Maximum.Nextˉcolumn
        );
        var Base: u32 = 1073741824u32;
        if Kind == Sourceˉdeclarations.Compilerˉsourceˉtypeˉkind.Builder { Base = 1342177280u32; }
        let Shape: u32 = Base + Maximum.Numericˉvalue * 65536u32 + Elementˉshape;
        return Compilerˉsourceˉtypeˉbinding(
            Compilerˉsourceˉsymbolˉstatus.Valid,
            Kind,
            Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.End,
            Shape,
            Element.Nominalˉmodule,
            Token.Offset,
            Right.Nextˉoffset - Token.Offset,
            Right.Nextˉoffset,
            Right.Nextˉline,
            Right.Nextˉcolumn,
            Right.Nextˉoffset,
            Right.Nextˉline,
            Right.Nextˉcolumn
        );
    }
    if Kind != Sourceˉdeclarations.Compilerˉsourceˉtypeˉkind.Named {
        return Compilerˉsourceˉtypeˉbinding(
            Compilerˉsourceˉsymbolˉstatus.Valid,
            Kind,
            Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.End,
            Nominalˉsentinel,
            Scan.Modules,
            Token.Offset,
            Token.Length,
            Token.Nextˉoffset,
            Token.Nextˉline,
            Token.Nextˉcolumn,
            Token.Nextˉoffset,
            Token.Nextˉline,
            Token.Nextˉcolumn
        );
    }
    let Qualified: Sourceˉdeclarations.Compilerˉparseˉstep = Sourceˉdeclarations.Compilerˉparseˉqualifiedˉname(
        Source, Offset, Line, Column, false
    );
    let Qualifiedˉlength: u32 = Qualified.Nextˉoffset - Token.Offset;
    let Capability: Compilerˉsourceˉsymbolˉmatch = Compilerˉsourceˉsymbolsˉfindˉpriorˉinˉdirectory(
        Input, Scan, Directory, Lookup, 0u32, 4294967295u32,
        Source, Token.Offset, Qualifiedˉlength,
        Compilerˉsourceˉnamespaceˉkind.Capability
    );
    if Capability.Found {
        if Forˉfield {
            return Compilerˉsourceˉsymbolsˉtypeˉfailure(
                Compilerˉsourceˉsymbolˉstatus.Invalidˉfieldˉtype,
                Sourceˉdeclarations.Compilerˉsourceˉtypeˉkind.Named,
                Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Capability,
                Capability.Directoryˉindex,
                0u32,
                Token
            );
        }
        return Compilerˉsourceˉtypeˉbinding(
            Compilerˉsourceˉsymbolˉstatus.Valid,
            Sourceˉdeclarations.Compilerˉsourceˉtypeˉkind.Named,
            Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Capability,
            Capability.Directoryˉindex,
            0u32,
            Token.Offset,
            Qualifiedˉlength,
            Qualified.Nextˉoffset,
            Qualified.Nextˉline,
            Qualified.Nextˉcolumn,
            Qualified.Nextˉoffset,
            Qualified.Nextˉline,
            Qualified.Nextˉcolumn
        );
    }
    let Match: Compilerˉsourceˉsymbolˉmatch = Compilerˉsourceˉsymbolsˉfindˉownedˉnominal(
        Input,
        Scan,
        Directory,
        Lookup,
        Owner,
        Source,
        Token.Offset,
        Qualifiedˉlength
    );
    if !Match.Found {
        return Compilerˉsourceˉsymbolsˉtypeˉfailure(
            Compilerˉsourceˉsymbolˉstatus.Unknownˉtype,
            Kind,
            Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.End,
            Nominalˉsentinel,
            Scan.Modules,
            Token
        );
    }
    let Directoryˉentries: u32 = Bytesˉreadˉu32ˉlittle(Directory, 8u32);
    let Nominals: u32 = Records + Enums + Variants;
    let Nominalˉindex: u32 = Bytesˉreadˉu32ˉlittle(
        Lookup,
        4112u32 + Directoryˉentries * 4u32 + Nominals * 4u32 + Match.Directoryˉindex * 4u32
    );
    if !Compilerˉsourceˉsymbolsˉownedˉmatchˉisˉaccessible(
        Input, Scan, Visibility, Lookup, Owner, Source,
        Token.Offset, Qualifiedˉlength, Match
    ) {
        return Compilerˉsourceˉsymbolsˉtypeˉfailure(
            Compilerˉsourceˉsymbolˉstatus.Inaccessibleˉtype,
            Kind,
            Match.Kind,
            Nominalˉindex,
            Match.Module,
            Token
        );
    }
    if Forˉfield {
        if Match.Kind != Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Record &&
            Match.Kind != Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Enum {
            return Compilerˉsourceˉsymbolsˉtypeˉfailure(
                Compilerˉsourceˉsymbolˉstatus.Invalidˉfieldˉtype,
                Kind,
                Match.Kind,
                Nominalˉindex,
                Match.Module,
                Token
            );
        }
    }
    return Compilerˉsourceˉtypeˉbinding(
        Compilerˉsourceˉsymbolˉstatus.Valid,
        Kind,
        Match.Kind,
        Nominalˉindex,
        Match.Module,
        Token.Offset,
        Qualifiedˉlength,
        Qualified.Nextˉoffset,
        Qualified.Nextˉline,
        Qualified.Nextˉcolumn,
        Qualified.Nextˉoffset,
        Qualified.Nextˉline,
        Qualified.Nextˉcolumn
    );
}

export fn Compilerˉsourceˉsymbolsˉconstantˉshape(
    Binding: Compilerˉsourceˉtypeˉbinding
) -> u32 {
    if Binding.Kind == Sourceˉdeclarations.Compilerˉsourceˉtypeˉkind.I32 { return 1u32; }
    if Binding.Kind == Sourceˉdeclarations.Compilerˉsourceˉtypeˉkind.Unit { return 9u32; }
    if Binding.Kind == Sourceˉdeclarations.Compilerˉsourceˉtypeˉkind.Never { return 10u32; }
    if Binding.Kind == Sourceˉdeclarations.Compilerˉsourceˉtypeˉkind.I8 { return 11u32; }
    if Binding.Kind == Sourceˉdeclarations.Compilerˉsourceˉtypeˉkind.I16 { return 12u32; }
    if Binding.Kind == Sourceˉdeclarations.Compilerˉsourceˉtypeˉkind.U16 { return 13u32; }
    if Binding.Kind == Sourceˉdeclarations.Compilerˉsourceˉtypeˉkind.F32 { return 14u32; }
    if Binding.Kind == Sourceˉdeclarations.Compilerˉsourceˉtypeˉkind.F64 { return 15u32; }
    if Binding.Kind == Sourceˉdeclarations.Compilerˉsourceˉtypeˉkind.Rune { return 16u32; }
    if Binding.Kind == Sourceˉdeclarations.Compilerˉsourceˉtypeˉkind.U8 { return 2u32; }
    if Binding.Kind == Sourceˉdeclarations.Compilerˉsourceˉtypeˉkind.U32 { return 3u32; }
    if Binding.Kind == Sourceˉdeclarations.Compilerˉsourceˉtypeˉkind.I64 { return 7u32; }
    if Binding.Kind == Sourceˉdeclarations.Compilerˉsourceˉtypeˉkind.U64 { return 8u32; }
    if Binding.Kind == Sourceˉdeclarations.Compilerˉsourceˉtypeˉkind.Bool { return 4u32; }
    if Binding.Nominalˉkind == Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Enum {
        return 131072u32 + Binding.Nominalˉindex;
    }
    return 0u32;
}

export fn Compilerˉsourceˉsymbolsˉconstantˉsuccess(
    Shape: u32,
    Magnitude: u32,
    Negative: bool
) -> Compilerˉsourceˉconstantˉvalue {
    var Normalizedˉnegative: bool = Negative;
    if Magnitude == 0u32 { Normalizedˉnegative = false; }
    return Compilerˉsourceˉconstantˉvalue(
        Compilerˉsourceˉsymbolˉstatus.Valid,
        Shape,
        Magnitude,
        0u32,
        Normalizedˉnegative,
        0u32,
        0u32,
        0u32,
        0u32
    );
}

export fn Compilerˉsourceˉsymbolsˉconstantˉsuccessˉwide(
    Shape: u32,
    Magnitude: u32,
    High: u32,
    Negative: bool
) -> Compilerˉsourceˉconstantˉvalue {
    var Normalizedˉnegative: bool = Negative;
    if Magnitude == 0u32 && High == 0u32 { Normalizedˉnegative = false; }
    return Compilerˉsourceˉconstantˉvalue(
        Compilerˉsourceˉsymbolˉstatus.Valid,
        Shape,
        Magnitude,
        High,
        Normalizedˉnegative,
        0u32,
        0u32,
        0u32,
        0u32
    );
}

export fn Compilerˉsourceˉsymbolsˉconstantˉfailure(
    Status: Compilerˉsourceˉsymbolˉstatus,
    Module: u32,
    Offset: u32,
    Line: u32,
    Column: u32
) -> Compilerˉsourceˉconstantˉvalue {
    return Compilerˉsourceˉconstantˉvalue(
        Status,
        0u32,
        0u32,
        0u32,
        false,
        Module,
        Offset,
        Line,
        Column
    );
}

export fn Compilerˉsourceˉsymbolsˉconstantˉfailureˉat(
    Status: Compilerˉsourceˉsymbolˉstatus,
    Module: u32,
    Expression: Sourceˉbodies.Compilerˉsourceˉexpression
) -> Compilerˉsourceˉconstantˉvalue {
    return Compilerˉsourceˉsymbolsˉconstantˉfailure(
        Status,
        Module,
        Expression.Offset,
        Expression.Line,
        Expression.Column
    );
}

export fn Compilerˉsourceˉsymbolsˉconstantˉdivide(
    Value: u32,
    Divisor: u32
) -> Compilerˉsourceˉconstantˉdivision {
    if Divisor == 0u32 {
        return Compilerˉsourceˉconstantˉdivision(0u32, Value);
    }
    var Quotient: u32 = 0u32;
    var Remainder: u32 = Value;
    while Remainder >= Divisor {
        var Current: u32 = Divisor;
        var Multiple: u32 = 1u32;
        var Growing: bool = true;
        while Growing {
            if Current > 2147483647u32 {
                Growing = false;
            } else {
                let Doubled: u32 = Current + Current;
                if Doubled > Remainder {
                    Growing = false;
                } else {
                    Current = Doubled;
                    Multiple = Multiple + Multiple;
                }
            }
        }
        Remainder = Remainder - Current;
        Quotient = Quotient + Multiple;
    }
    return Compilerˉsourceˉconstantˉdivision(Quotient, Remainder);
}

fn Compilerˉsourceˉsymbolsˉconstantˉwideˉcompare(
    Leftˉlow: u32,
    Leftˉhigh: u32,
    Rightˉlow: u32,
    Rightˉhigh: u32
) -> i32 {
    if Leftˉhigh < Rightˉhigh { return -1; }
    if Leftˉhigh > Rightˉhigh { return 1; }
    if Leftˉlow < Rightˉlow { return -1; }
    if Leftˉlow > Rightˉlow { return 1; }
    return 0;
}

fn Compilerˉsourceˉsymbolsˉconstantˉwideˉadd(
    Leftˉlow: u32,
    Leftˉhigh: u32,
    Rightˉlow: u32,
    Rightˉhigh: u32
) -> Compilerˉsourceˉconstantˉwideˉvalue {
    let Leftˉzero: u32 = Leftˉlow % 65536u32;
    let Leftˉone: u32 = Leftˉlow / 65536u32;
    let Leftˉtwo: u32 = Leftˉhigh % 65536u32;
    let Leftˉthree: u32 = Leftˉhigh / 65536u32;
    let Rightˉzero: u32 = Rightˉlow % 65536u32;
    let Rightˉone: u32 = Rightˉlow / 65536u32;
    let Rightˉtwo: u32 = Rightˉhigh % 65536u32;
    let Rightˉthree: u32 = Rightˉhigh / 65536u32;

    var Sum: u32 = Leftˉzero + Rightˉzero;
    let Resultˉzero: u32 = Sum % 65536u32;
    var Carry: u32 = Sum / 65536u32;
    Sum = Leftˉone + Rightˉone + Carry;
    let Resultˉone: u32 = Sum % 65536u32;
    Carry = Sum / 65536u32;
    Sum = Leftˉtwo + Rightˉtwo + Carry;
    let Resultˉtwo: u32 = Sum % 65536u32;
    Carry = Sum / 65536u32;
    Sum = Leftˉthree + Rightˉthree + Carry;
    let Resultˉthree: u32 = Sum % 65536u32;
    Carry = Sum / 65536u32;
    return Compilerˉsourceˉconstantˉwideˉvalue(
        Carry == 0u32,
        Resultˉzero + Resultˉone * 65536u32,
        Resultˉtwo + Resultˉthree * 65536u32
    );
}

fn Compilerˉsourceˉsymbolsˉconstantˉwideˉsubtract(
    Leftˉlow: u32,
    Leftˉhigh: u32,
    Rightˉlow: u32,
    Rightˉhigh: u32
) -> Compilerˉsourceˉconstantˉwideˉvalue {
    if Compilerˉsourceˉsymbolsˉconstantˉwideˉcompare(
        Leftˉlow, Leftˉhigh, Rightˉlow, Rightˉhigh
    ) < 0 { return Compilerˉsourceˉconstantˉwideˉvalue(false, 0u32, 0u32); }
    var Borrow: u32 = 0u32;
    var Leftˉlimb: u32 = Leftˉlow % 65536u32;
    var Rightˉlimb: u32 = Rightˉlow % 65536u32;
    var Needed: u32 = Rightˉlimb + Borrow;
    var Resultˉzero: u32 = 0u32;
    if Leftˉlimb >= Needed {
        Resultˉzero = Leftˉlimb - Needed;
        Borrow = 0u32;
    } else {
        Resultˉzero = Leftˉlimb + 65536u32 - Needed;
        Borrow = 1u32;
    }
    Leftˉlimb = Leftˉlow / 65536u32;
    Rightˉlimb = Rightˉlow / 65536u32;
    Needed = Rightˉlimb + Borrow;
    var Resultˉone: u32 = 0u32;
    if Leftˉlimb >= Needed {
        Resultˉone = Leftˉlimb - Needed;
        Borrow = 0u32;
    } else {
        Resultˉone = Leftˉlimb + 65536u32 - Needed;
        Borrow = 1u32;
    }
    Leftˉlimb = Leftˉhigh % 65536u32;
    Rightˉlimb = Rightˉhigh % 65536u32;
    Needed = Rightˉlimb + Borrow;
    var Resultˉtwo: u32 = 0u32;
    if Leftˉlimb >= Needed {
        Resultˉtwo = Leftˉlimb - Needed;
        Borrow = 0u32;
    } else {
        Resultˉtwo = Leftˉlimb + 65536u32 - Needed;
        Borrow = 1u32;
    }
    Leftˉlimb = Leftˉhigh / 65536u32;
    Rightˉlimb = Rightˉhigh / 65536u32;
    Needed = Rightˉlimb + Borrow;
    var Resultˉthree: u32 = 0u32;
    if Leftˉlimb >= Needed {
        Resultˉthree = Leftˉlimb - Needed;
        Borrow = 0u32;
    } else {
        Resultˉthree = Leftˉlimb + 65536u32 - Needed;
        Borrow = 1u32;
    }
    return Compilerˉsourceˉconstantˉwideˉvalue(
        Borrow == 0u32,
        Resultˉzero + Resultˉone * 65536u32,
        Resultˉtwo + Resultˉthree * 65536u32
    );
}

fn Compilerˉsourceˉsymbolsˉconstantˉwideˉshiftˉleftˉone(
    Low: u32,
    High: u32
) -> Compilerˉsourceˉconstantˉwideˉvalue {
    return Compilerˉsourceˉconstantˉwideˉvalue(
        High < 2147483648u32,
        (Low % 2147483648u32) * 2u32,
        (High % 2147483648u32) * 2u32 + Low / 2147483648u32
    );
}

fn Compilerˉsourceˉsymbolsˉconstantˉwideˉshiftˉrightˉone(
    Low: u32,
    High: u32
) -> Compilerˉsourceˉconstantˉwideˉvalue {
    return Compilerˉsourceˉconstantˉwideˉvalue(
        true,
        Low / 2u32 + (High % 2u32) * 2147483648u32,
        High / 2u32
    );
}

fn Compilerˉsourceˉsymbolsˉconstantˉwideˉmultiply(
    Leftˉlow: u32,
    Leftˉhigh: u32,
    Rightˉlow: u32,
    Rightˉhigh: u32,
    Limitˉlow: u32,
    Limitˉhigh: u32
) -> Compilerˉsourceˉconstantˉwideˉvalue {
    var Resultˉlow: u32 = 0u32;
    var Resultˉhigh: u32 = 0u32;
    var Multiplicandˉlow: u32 = Leftˉlow;
    var Multiplicandˉhigh: u32 = Leftˉhigh;
    var Multiplierˉlow: u32 = Rightˉlow;
    var Multiplierˉhigh: u32 = Rightˉhigh;
    var Reading: bool = Multiplierˉlow != 0u32 || Multiplierˉhigh != 0u32;
    while Reading {
        if Multiplierˉlow % 2u32 != 0u32 {
            let Sum: Compilerˉsourceˉconstantˉwideˉvalue =
                Compilerˉsourceˉsymbolsˉconstantˉwideˉadd(
                    Resultˉlow, Resultˉhigh, Multiplicandˉlow, Multiplicandˉhigh
                );
            if !Sum.Valid { return Compilerˉsourceˉconstantˉwideˉvalue(false, 0u32, 0u32); }
            if Compilerˉsourceˉsymbolsˉconstantˉwideˉcompare(
                Sum.Low, Sum.High, Limitˉlow, Limitˉhigh
            ) > 0 { return Compilerˉsourceˉconstantˉwideˉvalue(false, 0u32, 0u32); }
            Resultˉlow = Sum.Low;
            Resultˉhigh = Sum.High;
        }
        let Reduced: Compilerˉsourceˉconstantˉwideˉvalue =
            Compilerˉsourceˉsymbolsˉconstantˉwideˉshiftˉrightˉone(
                Multiplierˉlow, Multiplierˉhigh
            );
        Multiplierˉlow = Reduced.Low;
        Multiplierˉhigh = Reduced.High;
        Reading = Multiplierˉlow != 0u32 || Multiplierˉhigh != 0u32;
        if Reading {
            let Doubled: Compilerˉsourceˉconstantˉwideˉvalue =
                Compilerˉsourceˉsymbolsˉconstantˉwideˉshiftˉleftˉone(
                    Multiplicandˉlow, Multiplicandˉhigh
                );
            if !Doubled.Valid { return Compilerˉsourceˉconstantˉwideˉvalue(false, 0u32, 0u32); }
            if Compilerˉsourceˉsymbolsˉconstantˉwideˉcompare(
                Doubled.Low, Doubled.High, Limitˉlow, Limitˉhigh
            ) > 0 { return Compilerˉsourceˉconstantˉwideˉvalue(false, 0u32, 0u32); }
            Multiplicandˉlow = Doubled.Low;
            Multiplicandˉhigh = Doubled.High;
        }
    }
    return Compilerˉsourceˉconstantˉwideˉvalue(true, Resultˉlow, Resultˉhigh);
}

fn Compilerˉsourceˉsymbolsˉconstantˉwideˉdivide(
    Dividendˉlow: u32,
    Dividendˉhigh: u32,
    Divisorˉlow: u32,
    Divisorˉhigh: u32
) -> Compilerˉsourceˉconstantˉwideˉdivision {
    if Divisorˉlow == 0u32 && Divisorˉhigh == 0u32 {
        return Compilerˉsourceˉconstantˉwideˉdivision(
            false, 0u32, 0u32, Dividendˉlow, Dividendˉhigh
        );
    }
    var Sourceˉlow: u32 = Dividendˉlow;
    var Sourceˉhigh: u32 = Dividendˉhigh;
    var Quotientˉlow: u32 = 0u32;
    var Quotientˉhigh: u32 = 0u32;
    var Remainderˉlow: u32 = 0u32;
    var Remainderˉhigh: u32 = 0u32;
    var Bit: u32 = 0u32;
    while Bit < 64u32 {
        let Nextˉbit: u32 = Sourceˉhigh / 2147483648u32;
        Sourceˉhigh = (Sourceˉhigh % 2147483648u32) * 2u32 + Sourceˉlow / 2147483648u32;
        Sourceˉlow = (Sourceˉlow % 2147483648u32) * 2u32;
        Remainderˉhigh = (Remainderˉhigh % 2147483648u32) * 2u32 + Remainderˉlow / 2147483648u32;
        Remainderˉlow = (Remainderˉlow % 2147483648u32) * 2u32 + Nextˉbit;
        Quotientˉhigh = (Quotientˉhigh % 2147483648u32) * 2u32 + Quotientˉlow / 2147483648u32;
        Quotientˉlow = (Quotientˉlow % 2147483648u32) * 2u32;
        if Compilerˉsourceˉsymbolsˉconstantˉwideˉcompare(
            Remainderˉlow, Remainderˉhigh, Divisorˉlow, Divisorˉhigh
        ) >= 0 {
            let Reduced: Compilerˉsourceˉconstantˉwideˉvalue =
                Compilerˉsourceˉsymbolsˉconstantˉwideˉsubtract(
                    Remainderˉlow, Remainderˉhigh, Divisorˉlow, Divisorˉhigh
                );
            Remainderˉlow = Reduced.Low;
            Remainderˉhigh = Reduced.High;
            Quotientˉlow = Quotientˉlow + 1u32;
        }
        Bit = Bit + 1u32;
    }
    return Compilerˉsourceˉconstantˉwideˉdivision(
        true, Quotientˉlow, Quotientˉhigh, Remainderˉlow, Remainderˉhigh
    );
}

export fn Compilerˉsourceˉsymbolsˉconstantˉfind(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Compilerˉsourceˉsymbolˉsummary,
    Module: u32,
    Source: bytes,
    Offset: u32,
    Length: u32
) -> Compilerˉsourceˉsymbolˉmatch {
    let Range: Sourceˉbodies.Compilerˉsourceˉposition = Compilerˉsourceˉsymbolsˉlookupˉrange(
        Symbols.Lookup, Bytesˉreadˉu8(Source, Offset)
    );
    var Index: u32 = 0u32;
    while Index < Range.Line {
        let Directoryˉindex: u32 = Bytesˉreadˉu32ˉlittle(
            Symbols.Lookup, 4112u32 + (Range.Offset + Index) * 4u32
        );
        let Entry: u32 = 16u32 + Directoryˉindex * 24u32;
        let Kind: u32 = Bytesˉreadˉu32ˉlittle(Symbols.Directory, Entry + 4u32);
        let Owner: u32 = Bytesˉreadˉu32ˉlittle(Symbols.Directory, Entry);
        if Kind == 7u32 {
            if Owner == Module {
                let View: Sourceˉset.Compilerˉsourceˉsetˉview = Sourceˉset.Compilerˉsourceˉsetˉmodule(
                    Input, Scan, Owner
                );
                let Nameˉoffset: u32 = Bytesˉreadˉu32ˉlittle(
                    Symbols.Directory, Entry + 12u32
                );
                let Nameˉlength: u32 = Bytesˉreadˉu32ˉlittle(
                    Symbols.Directory, Entry + 16u32
                );
                if Nameˉlength == Length {
                    if Sourceˉset.Compilerˉsourceˉspansˉequal(
                        View.Source, Nameˉoffset, Nameˉlength,
                        Source, Offset, Length
                    ) {
                        return Compilerˉsourceˉsymbolsˉdirectoryˉentry(
                            Symbols.Directory, Scan.Modules, Directoryˉindex
                        );
                    }
                }
            }
        }
        Index = Index + 1u32;
    }
    return Compilerˉsourceˉsymbolsˉmatchˉnone(Scan.Modules);
}

export fn Compilerˉsourceˉsymbolsˉconstantˉenumˉmember(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Compilerˉsourceˉsymbolˉsummary,
    Module: u32,
    Source: bytes,
    Expression: Sourceˉbodies.Compilerˉsourceˉexpression
) -> Compilerˉsourceˉconstantˉvalue {
    var Lastˉdot: u32 = Expression.Valueˉlength;
    var Nameˉcharacter: u32 = 0u32;
    while Nameˉcharacter < Expression.Valueˉlength {
        if Bytesˉreadˉu8(Source, Expression.Valueˉoffset + Nameˉcharacter) == 46u8 {
            Lastˉdot = Nameˉcharacter;
        }
        Nameˉcharacter = Nameˉcharacter + 1u32;
    }
    let Memberˉoffset: u32 = Expression.Valueˉoffset + Lastˉdot + 1u32;
    let Memberˉlength: u32 = Expression.Valueˉlength - Lastˉdot - 1u32;
    let Nominal: Compilerˉsourceˉsymbolˉmatch = Compilerˉsourceˉsymbolsˉfindˉownedˉnominal(
        Input, Scan, Symbols.Directory, Symbols.Lookup, Module,
        Source, Expression.Valueˉoffset, Lastˉdot
    );
    if !Nominal.Found {
        return Compilerˉsourceˉsymbolsˉconstantˉfailureˉat(
            Compilerˉsourceˉsymbolˉstatus.Invalidˉconstantˉinitializer,
            Module,
            Expression
        );
    }
    if Nominal.Kind != Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Enum {
        return Compilerˉsourceˉsymbolsˉconstantˉfailureˉat(
            Compilerˉsourceˉsymbolˉstatus.Invalidˉconstantˉinitializer,
            Nominal.Module,
            Expression
        );
    }
    if !Compilerˉsourceˉsymbolsˉownedˉmatchˉisˉaccessible(
        Input, Scan, Symbols.Visibility, Symbols.Lookup, Module, Source,
        Expression.Valueˉoffset, Lastˉdot, Nominal
    ) {
        return Compilerˉsourceˉsymbolsˉconstantˉfailureˉat(
            Compilerˉsourceˉsymbolˉstatus.Invalidˉconstantˉinitializer,
            Nominal.Module,
            Expression
        );
    }
    let View: Sourceˉset.Compilerˉsourceˉsetˉview = Sourceˉset.Compilerˉsourceˉsetˉmodule(
        Input, Scan, Nominal.Module
    );
    let Declarationˉposition: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
        View.Source, 0u32, 1u32, 1u32, Nominal.Declarationˉoffset
    );
    let Declaration: Sourceˉdeclarations.Compilerˉsourceˉdeclaration = Sourceˉdeclarations.Compilerˉparseˉnextˉdeclarationˉvalidated(
        View.Source,
        Nominal.Declarationˉoffset,
        Declarationˉposition.Line,
        Declarationˉposition.Column,
        true
    );
    let Bodyˉposition: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
        View.Source, Declaration.Declarationˉoffset,
        Declarationˉposition.Line, Declarationˉposition.Column,
        Declaration.Bodyˉoffset
    );
    let Left: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
        View.Source, Declaration.Bodyˉoffset,
        Bodyˉposition.Line, Bodyˉposition.Column
    );
    var Cursor: u32 = Left.Nextˉoffset;
    var Line: u32 = Left.Nextˉline;
    var Column: u32 = Left.Nextˉcolumn;
    var Memberˉindex: u32 = 0u32;
    while Memberˉindex < Declaration.Items {
        let Member: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            View.Source, Cursor, Line, Column
        );
        if Member.Length == Memberˉlength {
            if Sourceˉset.Compilerˉsourceˉspansˉequal(
                View.Source, Member.Offset, Member.Length,
                Source, Memberˉoffset, Memberˉlength
            ) {
                let Entries: u32 = Bytesˉreadˉu32ˉlittle(Symbols.Directory, 8u32);
                let Nominals: u32 = Symbols.Records + Symbols.Enums + Symbols.Variants;
                let Nominalˉindex: u32 = Bytesˉreadˉu32ˉlittle(
                    Symbols.Lookup,
                    4112u32 + Entries * 4u32 + Nominals * 4u32 +
                        Nominal.Directoryˉindex * 4u32
                );
                return Compilerˉsourceˉsymbolsˉconstantˉsuccess(
                    131072u32 + Nominalˉindex,
                    Memberˉindex,
                    false
                );
            }
        }
        let Equals: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            View.Source, Member.Nextˉoffset, Member.Nextˉline, Member.Nextˉcolumn
        );
        let Value: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            View.Source, Equals.Nextˉoffset, Equals.Nextˉline, Equals.Nextˉcolumn
        );
        let End: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            View.Source, Value.Nextˉoffset, Value.Nextˉline, Value.Nextˉcolumn
        );
        Cursor = End.Nextˉoffset;
        Line = End.Nextˉline;
        Column = End.Nextˉcolumn;
        Memberˉindex = Memberˉindex + 1u32;
    }
    return Compilerˉsourceˉsymbolsˉconstantˉfailureˉat(
        Compilerˉsourceˉsymbolˉstatus.Invalidˉconstantˉinitializer,
        Nominal.Module,
        Expression
    );
}

export fn Compilerˉsourceˉsymbolsˉconstantˉsignedˉcompare(
    Left: Compilerˉsourceˉconstantˉvalue,
    Right: Compilerˉsourceˉconstantˉvalue
) -> i32 {
    if Left.Negative {
        if !Right.Negative { return -1; }
    } else {
        if Right.Negative { return 1; }
    }
    if Left.High == Right.High && Left.Magnitude == Right.Magnitude { return 0; }
    if Left.Negative {
        if Left.High > Right.High { return -1; }
        if Left.High < Right.High { return 1; }
        if Left.Magnitude > Right.Magnitude { return -1; }
        return 1;
    }
    if Left.High < Right.High { return -1; }
    if Left.High > Right.High { return 1; }
    if Left.Magnitude < Right.Magnitude { return -1; }
    return 1;
}

fn Compilerˉsourceˉsymbolsˉconstantˉshapeˉisˉsigned(Shape: u32) -> bool {
    return Shape == 1u32 || Shape == 7u32 || Shape == 11u32 || Shape == 12u32;
}

fn Compilerˉsourceˉsymbolsˉconstantˉsignedˉlimit(
    Shape: u32,
    Negative: bool
) -> u32 {
    if Shape == 11u32 {
        if Negative { return 128u32; }
        return 127u32;
    }
    if Shape == 12u32 {
        if Negative { return 32768u32; }
        return 32767u32;
    }
    if Negative { return 2147483648u32; }
    return 2147483647u32;
}

fn Compilerˉsourceˉsymbolsˉconstantˉunsignedˉlimit(Shape: u32) -> u32 {
    if Shape == 2u32 { return 255u32; }
    if Shape == 13u32 { return 65535u32; }
    return 4294967295u32;
}

export fn Compilerˉsourceˉsymbolsˉconstantˉsignedˉadd(
    Left: Compilerˉsourceˉconstantˉvalue,
    Right: Compilerˉsourceˉconstantˉvalue,
    Subtract: bool,
    Module: u32,
    Expression: Sourceˉbodies.Compilerˉsourceˉexpression
) -> Compilerˉsourceˉconstantˉvalue {
    var Rightˉnegative: bool = Right.Negative;
    if Subtract {
        if Right.Magnitude != 0u32 { Rightˉnegative = !Rightˉnegative; }
    }
    if Left.Negative == Rightˉnegative {
        let Limit: u32 = Compilerˉsourceˉsymbolsˉconstantˉsignedˉlimit(
            Left.Shape, Left.Negative
        );
        if Right.Magnitude > Limit - Left.Magnitude {
            return Compilerˉsourceˉsymbolsˉconstantˉfailureˉat(
                Compilerˉsourceˉsymbolˉstatus.Constantˉoverflow,
                Module,
                Expression
            );
        }
        return Compilerˉsourceˉsymbolsˉconstantˉsuccess(
            Left.Shape,
            Left.Magnitude + Right.Magnitude,
            Left.Negative
        );
    }
    if Left.Magnitude >= Right.Magnitude {
        return Compilerˉsourceˉsymbolsˉconstantˉsuccess(
            Left.Shape,
            Left.Magnitude - Right.Magnitude,
            Left.Negative
        );
    }
    return Compilerˉsourceˉsymbolsˉconstantˉsuccess(
        Left.Shape,
        Right.Magnitude - Left.Magnitude,
        Rightˉnegative
    );
}

fn Compilerˉsourceˉsymbolsˉconstantˉwideˉsignedˉadd(
    Left: Compilerˉsourceˉconstantˉvalue,
    Right: Compilerˉsourceˉconstantˉvalue,
    Subtract: bool,
    Module: u32,
    Expression: Sourceˉbodies.Compilerˉsourceˉexpression
) -> Compilerˉsourceˉconstantˉvalue {
    var Rightˉnegative: bool = Right.Negative;
    if Subtract {
        if Right.Magnitude != 0u32 || Right.High != 0u32 {
            Rightˉnegative = !Rightˉnegative;
        }
    }
    if Left.Negative == Rightˉnegative {
        let Sum: Compilerˉsourceˉconstantˉwideˉvalue =
            Compilerˉsourceˉsymbolsˉconstantˉwideˉadd(
                Left.Magnitude, Left.High, Right.Magnitude, Right.High
            );
        var Limitˉlow: u32 = 4294967295u32;
        var Limitˉhigh: u32 = 2147483647u32;
        if Left.Negative {
            Limitˉlow = 0u32;
            Limitˉhigh = 2147483648u32;
        }
        if !Sum.Valid || Compilerˉsourceˉsymbolsˉconstantˉwideˉcompare(
            Sum.Low, Sum.High, Limitˉlow, Limitˉhigh
        ) > 0 {
            return Compilerˉsourceˉsymbolsˉconstantˉfailureˉat(
                Compilerˉsourceˉsymbolˉstatus.Constantˉoverflow,
                Module, Expression
            );
        }
        return Compilerˉsourceˉsymbolsˉconstantˉsuccessˉwide(
            7u32, Sum.Low, Sum.High, Left.Negative
        );
    }
    let Comparison: i32 = Compilerˉsourceˉsymbolsˉconstantˉwideˉcompare(
        Left.Magnitude, Left.High, Right.Magnitude, Right.High
    );
    if Comparison >= 0 {
        let Difference: Compilerˉsourceˉconstantˉwideˉvalue =
            Compilerˉsourceˉsymbolsˉconstantˉwideˉsubtract(
                Left.Magnitude, Left.High, Right.Magnitude, Right.High
            );
        return Compilerˉsourceˉsymbolsˉconstantˉsuccessˉwide(
            7u32, Difference.Low, Difference.High, Left.Negative
        );
    }
    let Reverseˉdifference: Compilerˉsourceˉconstantˉwideˉvalue =
        Compilerˉsourceˉsymbolsˉconstantˉwideˉsubtract(
            Right.Magnitude, Right.High, Left.Magnitude, Left.High
        );
    return Compilerˉsourceˉsymbolsˉconstantˉsuccessˉwide(
        7u32, Reverseˉdifference.Low, Reverseˉdifference.High, Rightˉnegative
    );
}

export fn Compilerˉsourceˉsymbolsˉconstantˉmultiply(
    Left: Compilerˉsourceˉconstantˉvalue,
    Right: Compilerˉsourceˉconstantˉvalue,
    Module: u32,
    Expression: Sourceˉbodies.Compilerˉsourceˉexpression
) -> Compilerˉsourceˉconstantˉvalue {
    var Limit: u32 = Compilerˉsourceˉsymbolsˉconstantˉunsignedˉlimit(
        Left.Shape
    );
    let Signed: bool = Compilerˉsourceˉsymbolsˉconstantˉshapeˉisˉsigned(
        Left.Shape
    );
    if Signed {
        Limit = Compilerˉsourceˉsymbolsˉconstantˉsignedˉlimit(
            Left.Shape, Left.Negative != Right.Negative
        );
    }
    if Left.Magnitude != 0u32 {
        let Division: Compilerˉsourceˉconstantˉdivision =
            Compilerˉsourceˉsymbolsˉconstantˉdivide(Limit, Left.Magnitude);
        if Right.Magnitude > Division.Quotient {
            return Compilerˉsourceˉsymbolsˉconstantˉfailureˉat(
                Compilerˉsourceˉsymbolˉstatus.Constantˉoverflow,
                Module,
                Expression
            );
        }
    }
    var Negative: bool = false;
    if Signed {
        Negative = Left.Negative != Right.Negative;
    }
    return Compilerˉsourceˉsymbolsˉconstantˉsuccess(
        Left.Shape,
        Left.Magnitude * Right.Magnitude,
        Negative
    );
}

fn Compilerˉsourceˉsymbolsˉconstantˉsignedˉdivideˉvalues(
    Left: Compilerˉsourceˉconstantˉvalue,
    Right: Compilerˉsourceˉconstantˉvalue,
    Isˉremainder: bool,
    Module: u32,
    Expression: Sourceˉbodies.Compilerˉsourceˉexpression
) -> Compilerˉsourceˉconstantˉvalue {
    if Left.Negative &&
        Left.Magnitude == Compilerˉsourceˉsymbolsˉconstantˉsignedˉlimit(
            Left.Shape, true
        ) &&
        Right.Negative && Right.Magnitude == 1u32 {
        return Compilerˉsourceˉsymbolsˉconstantˉfailureˉat(
            Compilerˉsourceˉsymbolˉstatus.Constantˉoverflow,
            Module, Expression
        );
    }
    let Division: Compilerˉsourceˉconstantˉdivision =
        Compilerˉsourceˉsymbolsˉconstantˉdivide(
            Left.Magnitude, Right.Magnitude
        );
    if Isˉremainder {
        return Compilerˉsourceˉsymbolsˉconstantˉsuccess(
            Left.Shape, Division.Remainder, Left.Negative
        );
    }
    return Compilerˉsourceˉsymbolsˉconstantˉsuccess(
        Left.Shape, Division.Quotient, Left.Negative != Right.Negative
    );
}

fn Compilerˉsourceˉsymbolsˉconstantˉwideˉdivideˉvalues(
    Left: Compilerˉsourceˉconstantˉvalue,
    Right: Compilerˉsourceˉconstantˉvalue,
    Isˉremainder: bool,
    Module: u32,
    Expression: Sourceˉbodies.Compilerˉsourceˉexpression
) -> Compilerˉsourceˉconstantˉvalue {
    if Left.Shape == 7u32 && Left.Negative &&
        Left.High == 2147483648u32 && Left.Magnitude == 0u32 &&
        Right.Negative && Right.High == 0u32 && Right.Magnitude == 1u32 {
        return Compilerˉsourceˉsymbolsˉconstantˉfailureˉat(
            Compilerˉsourceˉsymbolˉstatus.Constantˉoverflow,
            Module, Expression
        );
    }
    let Division: Compilerˉsourceˉconstantˉwideˉdivision =
        Compilerˉsourceˉsymbolsˉconstantˉwideˉdivide(
            Left.Magnitude, Left.High, Right.Magnitude, Right.High
        );
    if Isˉremainder {
        var Remainderˉnegative: bool = false;
        if Left.Shape == 7u32 { Remainderˉnegative = Left.Negative; }
        return Compilerˉsourceˉsymbolsˉconstantˉsuccessˉwide(
            Left.Shape,
            Division.Remainderˉlow,
            Division.Remainderˉhigh,
            Remainderˉnegative
        );
    }
    var Quotientˉnegative: bool = false;
    if Left.Shape == 7u32 {
        Quotientˉnegative = Left.Negative != Right.Negative;
    }
    return Compilerˉsourceˉsymbolsˉconstantˉsuccessˉwide(
        Left.Shape,
        Division.Quotientˉlow,
        Division.Quotientˉhigh,
        Quotientˉnegative
    );
}

fn Compilerˉsourceˉsymbolsˉconstantˉdivideˉvalues(
    Left: Compilerˉsourceˉconstantˉvalue,
    Right: Compilerˉsourceˉconstantˉvalue,
    Isˉremainder: bool,
    Module: u32,
    Expression: Sourceˉbodies.Compilerˉsourceˉexpression
) -> Compilerˉsourceˉconstantˉvalue {
    if Right.Magnitude == 0u32 && Right.High == 0u32 {
        return Compilerˉsourceˉsymbolsˉconstantˉfailureˉat(
            Compilerˉsourceˉsymbolˉstatus.Constantˉoverflow,
            Module, Expression
        );
    }
    if Compilerˉsourceˉsymbolsˉconstantˉshapeˉisˉsigned(Left.Shape) {
        return Compilerˉsourceˉsymbolsˉconstantˉsignedˉdivideˉvalues(
            Left, Right, Isˉremainder, Module, Expression
        );
    }
    if Left.Shape == 2u32 || Left.Shape == 3u32 || Left.Shape == 13u32 {
        if Isˉremainder {
            return Compilerˉsourceˉsymbolsˉconstantˉsuccess(
                Left.Shape, Left.Magnitude % Right.Magnitude, false
            );
        }
        return Compilerˉsourceˉsymbolsˉconstantˉsuccess(
            Left.Shape, Left.Magnitude / Right.Magnitude, false
        );
    }
    if Left.Shape == 7u32 || Left.Shape == 8u32 {
        return Compilerˉsourceˉsymbolsˉconstantˉwideˉdivideˉvalues(
            Left, Right, Isˉremainder, Module, Expression
        );
    }
    return Compilerˉsourceˉsymbolsˉconstantˉfailureˉat(
        Compilerˉsourceˉsymbolˉstatus.Invalidˉconstantˉinitializer,
        Module, Expression
    );
}

fn Compilerˉsourceˉsymbolsˉconstantˉshiftˉvalues(
    Left: Compilerˉsourceˉconstantˉvalue,
    Right: Compilerˉsourceˉconstantˉvalue,
    Shiftˉright: bool,
    Module: u32,
    Expression: Sourceˉbodies.Compilerˉsourceˉexpression
) -> Compilerˉsourceˉconstantˉvalue {
    var Width: u32 = 0u32;
    if Left.Shape == 2u32 { Width = 8u32; }
    if Left.Shape == 13u32 { Width = 16u32; }
    if Left.Shape == 3u32 { Width = 32u32; }
    if Left.Shape == 8u32 { Width = 64u32; }
    if Width == 0u32 || Right.High != 0u32 || Right.Magnitude >= Width {
        return Compilerˉsourceˉsymbolsˉconstantˉfailureˉat(
            Compilerˉsourceˉsymbolˉstatus.Constantˉoverflow,
            Module, Expression
        );
    }
    if Left.Shape == 2u32 || Left.Shape == 3u32 || Left.Shape == 13u32 {
        var Shifted: u32 = Left.Magnitude << Right.Magnitude;
        if Shiftˉright { Shifted = Left.Magnitude >> Right.Magnitude; }
        if Left.Shape == 2u32 { Shifted = Shifted % 256u32; }
        if Left.Shape == 13u32 { Shifted = Shifted % 65536u32; }
        return Compilerˉsourceˉsymbolsˉconstantˉsuccess(
            Left.Shape, Shifted, false
        );
    }
    var Shiftˉlow: u32 = Left.Magnitude;
    var Shiftˉhigh: u32 = Left.High;
    var Shiftˉcount: u32 = 0u32;
    while Shiftˉcount < Right.Magnitude {
        var Shiftedˉwide: Compilerˉsourceˉconstantˉwideˉvalue =
            Compilerˉsourceˉsymbolsˉconstantˉwideˉshiftˉleftˉone(
                Shiftˉlow, Shiftˉhigh
            );
        if Shiftˉright {
            Shiftedˉwide = Compilerˉsourceˉsymbolsˉconstantˉwideˉshiftˉrightˉone(
                Shiftˉlow, Shiftˉhigh
            );
        }
        Shiftˉlow = Shiftedˉwide.Low;
        Shiftˉhigh = Shiftedˉwide.High;
        Shiftˉcount = Shiftˉcount + 1u32;
    }
    return Compilerˉsourceˉsymbolsˉconstantˉsuccessˉwide(
        8u32, Shiftˉlow, Shiftˉhigh, false
    );
}

export fn Compilerˉsourceˉsymbolsˉconstantˉevaluateˉexpression(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Compilerˉsourceˉsymbolˉsummary,
    Module: u32,
    Source: bytes,
    Expression: Sourceˉbodies.Compilerˉsourceˉexpression,
    Beforeˉdeclaration: u32,
    Depth: u32
) -> Compilerˉsourceˉconstantˉvalue {
    if Depth > 64u32 {
        return Compilerˉsourceˉsymbolsˉconstantˉfailureˉat(
            Compilerˉsourceˉsymbolˉstatus.Constantˉforwardˉreference,
            Module,
            Expression
        );
    }
    if Expression.Status != Sourceˉbodies.Compilerˉbodyˉparseˉstatus.Valid {
        return Compilerˉsourceˉsymbolsˉconstantˉfailureˉat(
            Compilerˉsourceˉsymbolˉstatus.Invalidˉconstantˉinitializer,
            Module,
            Expression
        );
    }
    if Expression.Kind == Sourceˉbodies.Compilerˉsourceˉexpressionˉkind.Integer {
        var Shape: u32 = 1u32;
        if Expression.Numericˉkind == Sourceˉlexer.Compilerˉnumericˉkind.U8 { Shape = 2u32; }
        if Expression.Numericˉkind == Sourceˉlexer.Compilerˉnumericˉkind.U32 { Shape = 3u32; }
        if Expression.Numericˉkind == Sourceˉlexer.Compilerˉnumericˉkind.I64 { Shape = 7u32; }
        if Expression.Numericˉkind == Sourceˉlexer.Compilerˉnumericˉkind.U64 { Shape = 8u32; }
        if Expression.Numericˉkind == Sourceˉlexer.Compilerˉnumericˉkind.I8 { Shape = 11u32; }
        if Expression.Numericˉkind == Sourceˉlexer.Compilerˉnumericˉkind.I16 { Shape = 12u32; }
        if Expression.Numericˉkind == Sourceˉlexer.Compilerˉnumericˉkind.U16 { Shape = 13u32; }
        if Shape == 7u32 || Shape == 8u32 {
            return Compilerˉsourceˉsymbolsˉconstantˉsuccessˉwide(
                Shape, Expression.Numericˉvalue, Expression.Numericˉhigh, false
            );
        }
        return Compilerˉsourceˉsymbolsˉconstantˉsuccess(
            Shape, Expression.Numericˉvalue, false
        );
    }
    if Expression.Kind == Sourceˉbodies.Compilerˉsourceˉexpressionˉkind.Floating {
        var Floatingˉshape: u32 = 14u32;
        if Expression.Numericˉkind == Sourceˉlexer.Compilerˉnumericˉkind.F64 {
            Floatingˉshape = 15u32;
        }
        return Compilerˉsourceˉsymbolsˉconstantˉsuccessˉwide(
            Floatingˉshape,
            Expression.Numericˉvalue,
            Expression.Numericˉhigh,
            false
        );
    }
    if Expression.Kind == Sourceˉbodies.Compilerˉsourceˉexpressionˉkind.Boolean {
        var Boolean: u32 = 0u32;
        if Expression.Booleanˉvalue { Boolean = 1u32; }
        return Compilerˉsourceˉsymbolsˉconstantˉsuccess(4u32, Boolean, false);
    }
    if Expression.Kind == Sourceˉbodies.Compilerˉsourceˉexpressionˉkind.Rune {
        return Compilerˉsourceˉsymbolsˉconstantˉsuccess(
            16u32, Expression.Numericˉvalue, false
        );
    }
    if Expression.Kind == Sourceˉbodies.Compilerˉsourceˉexpressionˉkind.Name {
        let Prior: Compilerˉsourceˉsymbolˉmatch = Compilerˉsourceˉsymbolsˉfindˉpriorˉinˉdirectory(
            Input, Scan, Symbols.Directory, Symbols.Lookup,
            Module, Beforeˉdeclaration,
            Source, Expression.Valueˉoffset, Expression.Valueˉlength,
            Compilerˉsourceˉnamespaceˉkind.Constant
        );
        if !Prior.Found {
            let Any: Compilerˉsourceˉsymbolˉmatch = Compilerˉsourceˉsymbolsˉconstantˉfind(
                Input, Scan, Symbols, Module, Source,
                Expression.Valueˉoffset, Expression.Valueˉlength
            );
            var Status: Compilerˉsourceˉsymbolˉstatus =
                Compilerˉsourceˉsymbolˉstatus.Invalidˉconstantˉinitializer;
            if Any.Found {
                Status = Compilerˉsourceˉsymbolˉstatus.Constantˉforwardˉreference;
            }
            return Compilerˉsourceˉsymbolsˉconstantˉfailureˉat(
                Status, Module, Expression
            );
        }
        let View: Sourceˉset.Compilerˉsourceˉsetˉview = Sourceˉset.Compilerˉsourceˉsetˉmodule(
            Input, Scan, Prior.Module
        );
        let Priorˉposition: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
            View.Source, 0u32, 1u32, 1u32, Prior.Declarationˉoffset
        );
        let Declaration: Sourceˉdeclarations.Compilerˉsourceˉdeclaration = Sourceˉdeclarations.Compilerˉparseˉnextˉdeclarationˉvalidated(
            View.Source,
            Prior.Declarationˉoffset,
            Priorˉposition.Line,
            Priorˉposition.Column,
            true
        );
        return Compilerˉsourceˉsymbolsˉconstantˉevaluateˉdeclaration(
            Input, Scan, Symbols, Prior.Module, View.Source,
            Declaration, Priorˉposition.Line, Priorˉposition.Column, Depth + 1u32
        );
    }
    if Expression.Kind == Sourceˉbodies.Compilerˉsourceˉexpressionˉkind.Field {
        return Compilerˉsourceˉsymbolsˉconstantˉenumˉmember(
            Input, Scan, Symbols, Module, Source, Expression
        );
    }
    if Expression.Kind == Sourceˉbodies.Compilerˉsourceˉexpressionˉkind.Unary {
        let Unaryˉposition: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
            Source, Expression.Offset, Expression.Line, Expression.Column,
            Expression.Firstˉoffset
        );
        let Operandˉexpression: Sourceˉbodies.Compilerˉsourceˉexpression = Sourceˉbodies.Compilerˉparseˉexpressionˉvalidated(
            Source,
            Expression.Firstˉoffset,
            Unaryˉposition.Line,
            Unaryˉposition.Column,
            Expression.Firstˉoffset + Expression.Firstˉlength,
            0u32,
            0u32
        );
        let Operand: Compilerˉsourceˉconstantˉvalue =
            Compilerˉsourceˉsymbolsˉconstantˉevaluateˉexpression(
                Input, Scan, Symbols, Module, Source,
                Operandˉexpression, Beforeˉdeclaration, Depth + 1u32
            );
        if Operand.Status != Compilerˉsourceˉsymbolˉstatus.Valid { return Operand; }
        if Expression.Operator == Sourceˉlexer.Compilerˉtokenˉkind.Minus {
            if Operand.Shape == 14u32 {
                return Compilerˉsourceˉsymbolsˉconstantˉsuccessˉwide(
                    14u32, Operand.Magnitude ^ 2147483648u32, 0u32, false
                );
            }
            if Operand.Shape == 15u32 {
                return Compilerˉsourceˉsymbolsˉconstantˉsuccessˉwide(
                    15u32, Operand.Magnitude,
                    Operand.High ^ 2147483648u32, false
                );
            }
            if !Compilerˉsourceˉsymbolsˉconstantˉshapeˉisˉsigned(Operand.Shape) {
                return Compilerˉsourceˉsymbolsˉconstantˉfailureˉat(
                    Compilerˉsourceˉsymbolˉstatus.Invalidˉconstantˉinitializer,
                    Module,
                    Expression
                );
            }
            if Operand.Negative {
                var Minimum: bool = Operand.Shape != 7u32 &&
                    Operand.Magnitude == Compilerˉsourceˉsymbolsˉconstantˉsignedˉlimit(
                        Operand.Shape, true
                    );
                if Operand.Shape == 7u32 {
                    Minimum = Operand.High == 2147483648u32 && Operand.Magnitude == 0u32;
                }
                if Minimum {
                    return Compilerˉsourceˉsymbolsˉconstantˉfailureˉat(
                        Compilerˉsourceˉsymbolˉstatus.Constantˉoverflow,
                        Module,
                        Expression
                    );
                }
            }
            if Operand.Shape == 7u32 {
                return Compilerˉsourceˉsymbolsˉconstantˉsuccessˉwide(
                    7u32, Operand.Magnitude, Operand.High, !Operand.Negative
                );
            }
            return Compilerˉsourceˉsymbolsˉconstantˉsuccess(
                Operand.Shape, Operand.Magnitude, !Operand.Negative
            );
        }
        if Expression.Operator == Sourceˉlexer.Compilerˉtokenˉkind.Bang {
            if Operand.Shape == 4u32 {
                var Negatedˉboolean: u32 = 1u32;
                if Operand.Magnitude != 0u32 { Negatedˉboolean = 0u32; }
                return Compilerˉsourceˉsymbolsˉconstantˉsuccess(
                    4u32, Negatedˉboolean, false
                );
            }
        }
        if Expression.Operator == Sourceˉlexer.Compilerˉtokenˉkind.Tilde {
            if Operand.Shape == 2u32 {
                return Compilerˉsourceˉsymbolsˉconstantˉsuccess(
                    2u32, 255u32 - Operand.Magnitude, false
                );
            }
            if Operand.Shape == 3u32 {
                return Compilerˉsourceˉsymbolsˉconstantˉsuccess(
                    3u32, ~Operand.Magnitude, false
                );
            }
            if Operand.Shape == 13u32 {
                return Compilerˉsourceˉsymbolsˉconstantˉsuccess(
                    13u32, 65535u32 - Operand.Magnitude, false
                );
            }
            if Operand.Shape == 8u32 {
                return Compilerˉsourceˉsymbolsˉconstantˉsuccessˉwide(
                    8u32, ~Operand.Magnitude, ~Operand.High, false
                );
            }
        }
        return Compilerˉsourceˉsymbolsˉconstantˉfailureˉat(
            Compilerˉsourceˉsymbolˉstatus.Invalidˉconstantˉinitializer,
            Module,
            Expression
        );
    }
    if Expression.Kind == Sourceˉbodies.Compilerˉsourceˉexpressionˉkind.Binary {
        let Leftˉposition: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
            Source, Expression.Offset, Expression.Line, Expression.Column,
            Expression.Firstˉoffset
        );
        let Leftˉexpression: Sourceˉbodies.Compilerˉsourceˉexpression = Sourceˉbodies.Compilerˉparseˉexpressionˉvalidated(
            Source,
            Expression.Firstˉoffset,
            Leftˉposition.Line,
            Leftˉposition.Column,
            Expression.Firstˉoffset + Expression.Firstˉlength,
            0u32,
            0u32
        );
        let Left: Compilerˉsourceˉconstantˉvalue =
            Compilerˉsourceˉsymbolsˉconstantˉevaluateˉexpression(
                Input, Scan, Symbols, Module, Source,
                Leftˉexpression, Beforeˉdeclaration, Depth + 1u32
            );
        if Left.Status != Compilerˉsourceˉsymbolˉstatus.Valid { return Left; }
        let Isˉbooleanˉand: bool = Expression.Operator == Sourceˉlexer.Compilerˉtokenˉkind.Andˉand;
        let Isˉbooleanˉor: bool = Expression.Operator == Sourceˉlexer.Compilerˉtokenˉkind.Orˉor;
        if Isˉbooleanˉand || Isˉbooleanˉor {
            if Left.Shape != 4u32 {
                return Compilerˉsourceˉsymbolsˉconstantˉfailureˉat(
                    Compilerˉsourceˉsymbolˉstatus.Invalidˉconstantˉinitializer,
                    Module,
                    Expression
                );
            }
            if Isˉbooleanˉand {
                if Left.Magnitude == 0u32 {
                    return Compilerˉsourceˉsymbolsˉconstantˉsuccess(4u32, 0u32, false);
                }
            }
            if Isˉbooleanˉor {
                if Left.Magnitude != 0u32 {
                    return Compilerˉsourceˉsymbolsˉconstantˉsuccess(4u32, 1u32, false);
                }
            }
        }
        let Rightˉposition: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
            Source, Expression.Offset, Expression.Line, Expression.Column,
            Expression.Secondˉoffset
        );
        let Rightˉexpression: Sourceˉbodies.Compilerˉsourceˉexpression = Sourceˉbodies.Compilerˉparseˉexpressionˉvalidated(
            Source,
            Expression.Secondˉoffset,
            Rightˉposition.Line,
            Rightˉposition.Column,
            Expression.Secondˉoffset + Expression.Secondˉlength,
            0u32,
            0u32
        );
        let Right: Compilerˉsourceˉconstantˉvalue =
            Compilerˉsourceˉsymbolsˉconstantˉevaluateˉexpression(
                Input, Scan, Symbols, Module, Source,
                Rightˉexpression, Beforeˉdeclaration, Depth + 1u32
            );
        if Right.Status != Compilerˉsourceˉsymbolˉstatus.Valid { return Right; }
        var Compatibleˉshapes: bool = Left.Shape == Right.Shape;
        if Expression.Operator == Sourceˉlexer.Compilerˉtokenˉkind.Shiftˉleft ||
            Expression.Operator == Sourceˉlexer.Compilerˉtokenˉkind.Shiftˉright {
            Compatibleˉshapes = Right.Shape == 3u32;
        }
        if !Compatibleˉshapes {
            return Compilerˉsourceˉsymbolsˉconstantˉfailureˉat(
                Compilerˉsourceˉsymbolˉstatus.Invalidˉconstantˉinitializer,
                Module,
                Expression
            );
        }
        if Isˉbooleanˉand || Isˉbooleanˉor {
            if Right.Shape != 4u32 {
                return Compilerˉsourceˉsymbolsˉconstantˉfailureˉat(
                    Compilerˉsourceˉsymbolˉstatus.Invalidˉconstantˉinitializer,
                    Module,
                    Expression
                );
            }
            var Booleanˉresult: u32 = 0u32;
            if Right.Magnitude != 0u32 { Booleanˉresult = 1u32; }
            return Compilerˉsourceˉsymbolsˉconstantˉsuccess(
                4u32, Booleanˉresult, false
            );
        }
        if Expression.Operator == Sourceˉlexer.Compilerˉtokenˉkind.Plus {
            if Compilerˉsourceˉsymbolsˉconstantˉshapeˉisˉsigned(Left.Shape) &&
                Left.Shape != 7u32 {
                return Compilerˉsourceˉsymbolsˉconstantˉsignedˉadd(
                    Left, Right, false, Module, Expression
                );
            }
            if Left.Shape == 2u32 || Left.Shape == 3u32 || Left.Shape == 13u32 {
                let Limit: u32 = Compilerˉsourceˉsymbolsˉconstantˉunsignedˉlimit(
                    Left.Shape
                );
                if Right.Magnitude > Limit - Left.Magnitude {
                    return Compilerˉsourceˉsymbolsˉconstantˉfailureˉat(
                        Compilerˉsourceˉsymbolˉstatus.Constantˉoverflow,
                        Module,
                        Expression
                    );
                }
                return Compilerˉsourceˉsymbolsˉconstantˉsuccess(
                    Left.Shape, Left.Magnitude + Right.Magnitude, false
                );
            }
            if Left.Shape == 7u32 {
                return Compilerˉsourceˉsymbolsˉconstantˉwideˉsignedˉadd(
                    Left, Right, false, Module, Expression
                );
            }
            if Left.Shape == 8u32 {
                let Sum: Compilerˉsourceˉconstantˉwideˉvalue =
                    Compilerˉsourceˉsymbolsˉconstantˉwideˉadd(
                        Left.Magnitude, Left.High, Right.Magnitude, Right.High
                    );
                if !Sum.Valid {
                    return Compilerˉsourceˉsymbolsˉconstantˉfailureˉat(
                        Compilerˉsourceˉsymbolˉstatus.Constantˉoverflow,
                        Module, Expression
                    );
                }
                return Compilerˉsourceˉsymbolsˉconstantˉsuccessˉwide(
                    8u32, Sum.Low, Sum.High, false
                );
            }
        }
        if Expression.Operator == Sourceˉlexer.Compilerˉtokenˉkind.Minus {
            if Compilerˉsourceˉsymbolsˉconstantˉshapeˉisˉsigned(Left.Shape) &&
                Left.Shape != 7u32 {
                return Compilerˉsourceˉsymbolsˉconstantˉsignedˉadd(
                    Left, Right, true, Module, Expression
                );
            }
            if Left.Shape == 2u32 || Left.Shape == 3u32 || Left.Shape == 13u32 {
                if Left.Magnitude < Right.Magnitude {
                    return Compilerˉsourceˉsymbolsˉconstantˉfailureˉat(
                        Compilerˉsourceˉsymbolˉstatus.Constantˉoverflow,
                        Module,
                        Expression
                    );
                }
                return Compilerˉsourceˉsymbolsˉconstantˉsuccess(
                    Left.Shape, Left.Magnitude - Right.Magnitude, false
                );
            }
            if Left.Shape == 7u32 {
                return Compilerˉsourceˉsymbolsˉconstantˉwideˉsignedˉadd(
                    Left, Right, true, Module, Expression
                );
            }
            if Left.Shape == 8u32 {
                let Difference: Compilerˉsourceˉconstantˉwideˉvalue =
                    Compilerˉsourceˉsymbolsˉconstantˉwideˉsubtract(
                        Left.Magnitude, Left.High, Right.Magnitude, Right.High
                    );
                if !Difference.Valid {
                    return Compilerˉsourceˉsymbolsˉconstantˉfailureˉat(
                        Compilerˉsourceˉsymbolˉstatus.Constantˉoverflow,
                        Module, Expression
                    );
                }
                return Compilerˉsourceˉsymbolsˉconstantˉsuccessˉwide(
                    8u32, Difference.Low, Difference.High, false
                );
            }
        }
        if Expression.Operator == Sourceˉlexer.Compilerˉtokenˉkind.Star {
            if Compilerˉsourceˉsymbolsˉconstantˉshapeˉisˉsigned(Left.Shape) &&
                Left.Shape != 7u32 {
                return Compilerˉsourceˉsymbolsˉconstantˉmultiply(
                    Left, Right, Module, Expression
                );
            }
            if Left.Shape == 2u32 || Left.Shape == 3u32 || Left.Shape == 13u32 {
                return Compilerˉsourceˉsymbolsˉconstantˉmultiply(
                    Left, Right, Module, Expression
                );
            }
            if Left.Shape == 7u32 || Left.Shape == 8u32 {
                var Negative: bool = false;
                var Limitˉlow: u32 = 4294967295u32;
                var Limitˉhigh: u32 = 4294967295u32;
                if Left.Shape == 7u32 {
                    Negative = Left.Negative != Right.Negative;
                    Limitˉhigh = 2147483647u32;
                    if Negative {
                        Limitˉlow = 0u32;
                        Limitˉhigh = 2147483648u32;
                    }
                }
                let Product: Compilerˉsourceˉconstantˉwideˉvalue =
                    Compilerˉsourceˉsymbolsˉconstantˉwideˉmultiply(
                        Left.Magnitude, Left.High, Right.Magnitude, Right.High,
                        Limitˉlow, Limitˉhigh
                    );
                if !Product.Valid {
                    return Compilerˉsourceˉsymbolsˉconstantˉfailureˉat(
                        Compilerˉsourceˉsymbolˉstatus.Constantˉoverflow,
                        Module, Expression
                    );
                }
                return Compilerˉsourceˉsymbolsˉconstantˉsuccessˉwide(
                    Left.Shape, Product.Low, Product.High, Negative
                );
            }
        }
        if Expression.Operator == Sourceˉlexer.Compilerˉtokenˉkind.Slash ||
            Expression.Operator == Sourceˉlexer.Compilerˉtokenˉkind.Percent {
            return Compilerˉsourceˉsymbolsˉconstantˉdivideˉvalues(
                Left, Right,
                Expression.Operator == Sourceˉlexer.Compilerˉtokenˉkind.Percent,
                Module, Expression
            );
        }
        if Expression.Operator == Sourceˉlexer.Compilerˉtokenˉkind.Ampersand ||
            Expression.Operator == Sourceˉlexer.Compilerˉtokenˉkind.Pipe ||
            Expression.Operator == Sourceˉlexer.Compilerˉtokenˉkind.Caret {
            if Left.Shape == 2u32 || Left.Shape == 3u32 || Left.Shape == 13u32 {
                var Bitwiseˉvalue: u32 = Left.Magnitude & Right.Magnitude;
                if Expression.Operator == Sourceˉlexer.Compilerˉtokenˉkind.Pipe {
                    Bitwiseˉvalue = Left.Magnitude | Right.Magnitude;
                }
                if Expression.Operator == Sourceˉlexer.Compilerˉtokenˉkind.Caret {
                    Bitwiseˉvalue = Left.Magnitude ^ Right.Magnitude;
                }
                return Compilerˉsourceˉsymbolsˉconstantˉsuccess(
                    Left.Shape, Bitwiseˉvalue, false
                );
            }
            if Left.Shape == 8u32 {
                var Bitwiseˉlow: u32 = Left.Magnitude & Right.Magnitude;
                var Bitwiseˉhigh: u32 = Left.High & Right.High;
                if Expression.Operator == Sourceˉlexer.Compilerˉtokenˉkind.Pipe {
                    Bitwiseˉlow = Left.Magnitude | Right.Magnitude;
                    Bitwiseˉhigh = Left.High | Right.High;
                }
                if Expression.Operator == Sourceˉlexer.Compilerˉtokenˉkind.Caret {
                    Bitwiseˉlow = Left.Magnitude ^ Right.Magnitude;
                    Bitwiseˉhigh = Left.High ^ Right.High;
                }
                return Compilerˉsourceˉsymbolsˉconstantˉsuccessˉwide(
                    8u32, Bitwiseˉlow, Bitwiseˉhigh, false
                );
            }
        }
        if Expression.Operator == Sourceˉlexer.Compilerˉtokenˉkind.Shiftˉleft ||
            Expression.Operator == Sourceˉlexer.Compilerˉtokenˉkind.Shiftˉright {
            return Compilerˉsourceˉsymbolsˉconstantˉshiftˉvalues(
                Left, Right,
                Expression.Operator == Sourceˉlexer.Compilerˉtokenˉkind.Shiftˉright,
                Module, Expression
            );
        }
        if Expression.Operator == Sourceˉlexer.Compilerˉtokenˉkind.Equalsˉequals {
            var Equalsˉresult: bool = Left.Magnitude == Right.Magnitude;
            if Left.High != Right.High { Equalsˉresult = false; }
            if Left.Negative != Right.Negative { Equalsˉresult = false; }
            var Equalsˉvalue: u32 = 0u32;
            if Equalsˉresult { Equalsˉvalue = 1u32; }
            return Compilerˉsourceˉsymbolsˉconstantˉsuccess(4u32, Equalsˉvalue, false);
        }
        if Expression.Operator == Sourceˉlexer.Compilerˉtokenˉkind.Bangˉequals {
            var Notˉequalˉresult: bool = Left.Magnitude == Right.Magnitude;
            if Left.High != Right.High { Notˉequalˉresult = false; }
            if Left.Negative != Right.Negative { Notˉequalˉresult = false; }
            var Notˉequalˉvalue: u32 = 1u32;
            if Notˉequalˉresult { Notˉequalˉvalue = 0u32; }
            return Compilerˉsourceˉsymbolsˉconstantˉsuccess(4u32, Notˉequalˉvalue, false);
        }
        var Isˉcomparison: bool = Expression.Operator == Sourceˉlexer.Compilerˉtokenˉkind.Less;
        if Expression.Operator == Sourceˉlexer.Compilerˉtokenˉkind.Lessˉequals { Isˉcomparison = true; }
        if Expression.Operator == Sourceˉlexer.Compilerˉtokenˉkind.Greater { Isˉcomparison = true; }
        if Expression.Operator == Sourceˉlexer.Compilerˉtokenˉkind.Greaterˉequals { Isˉcomparison = true; }
        if Isˉcomparison {
            var Comparable: bool = Left.Shape == 1u32;
            if Left.Shape == 2u32 { Comparable = true; }
            if Left.Shape == 3u32 { Comparable = true; }
            if Left.Shape == 7u32 { Comparable = true; }
            if Left.Shape == 8u32 { Comparable = true; }
            if Left.Shape == 11u32 { Comparable = true; }
            if Left.Shape == 12u32 { Comparable = true; }
            if Left.Shape == 13u32 { Comparable = true; }
            if !Comparable {
                return Compilerˉsourceˉsymbolsˉconstantˉfailureˉat(
                    Compilerˉsourceˉsymbolˉstatus.Invalidˉconstantˉinitializer,
                    Module,
                    Expression
                );
            }
            var Comparison: i32 = 0;
            if Compilerˉsourceˉsymbolsˉconstantˉshapeˉisˉsigned(Left.Shape) {
                Comparison = Compilerˉsourceˉsymbolsˉconstantˉsignedˉcompare(
                    Left, Right
                );
            } else {
                if Left.High < Right.High { Comparison = -1; }
                if Left.High > Right.High { Comparison = 1; }
                if Left.High == Right.High {
                    if Left.Magnitude < Right.Magnitude { Comparison = -1; }
                    if Left.Magnitude > Right.Magnitude { Comparison = 1; }
                }
            }
            var Matches: bool = Comparison < 0;
            if Expression.Operator == Sourceˉlexer.Compilerˉtokenˉkind.Lessˉequals {
                Matches = Comparison <= 0;
            }
            if Expression.Operator == Sourceˉlexer.Compilerˉtokenˉkind.Greater {
                Matches = Comparison > 0;
            }
            if Expression.Operator == Sourceˉlexer.Compilerˉtokenˉkind.Greaterˉequals {
                Matches = Comparison >= 0;
            }
            var Comparisonˉvalue: u32 = 0u32;
            if Matches { Comparisonˉvalue = 1u32; }
            return Compilerˉsourceˉsymbolsˉconstantˉsuccess(4u32, Comparisonˉvalue, false);
        }
        return Compilerˉsourceˉsymbolsˉconstantˉfailureˉat(
            Compilerˉsourceˉsymbolˉstatus.Invalidˉconstantˉinitializer,
            Module,
            Expression
        );
    }
    return Compilerˉsourceˉsymbolsˉconstantˉfailureˉat(
        Compilerˉsourceˉsymbolˉstatus.Invalidˉconstantˉinitializer,
        Module,
        Expression
    );
}

export fn Compilerˉsourceˉsymbolsˉconstantˉevaluateˉdeclaration(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Compilerˉsourceˉsymbolˉsummary,
    Module: u32,
    Source: bytes,
    Declaration: Sourceˉdeclarations.Compilerˉsourceˉdeclaration,
    Declarationˉline: u32,
    Declarationˉcolumn: u32,
    Depth: u32
) -> Compilerˉsourceˉconstantˉvalue {
    let First: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
        Source,
        Declaration.Declarationˉoffset,
        Declarationˉline,
        Declarationˉcolumn
    );
    var Constantˉtoken: Sourceˉlexer.Compilerˉsourceˉtoken = First;
    if First.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Export {
        Constantˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Source, First.Nextˉoffset, First.Nextˉline, First.Nextˉcolumn
        );
    }
    let Name: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
        Source,
        Constantˉtoken.Nextˉoffset,
        Constantˉtoken.Nextˉline,
        Constantˉtoken.Nextˉcolumn
    );
    let Colon: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
        Source, Name.Nextˉoffset, Name.Nextˉline, Name.Nextˉcolumn
    );
    let Binding: Compilerˉsourceˉtypeˉbinding = Compilerˉsourceˉsymbolsˉbindˉtype(
        Input, Scan, Symbols.Directory, Symbols.Lookup, Symbols.Visibility,
        Module, Source,
        Colon.Nextˉoffset, Colon.Nextˉline, Colon.Nextˉcolumn,
        Symbols.Records, Symbols.Enums, false
    );
    if Binding.Status != Compilerˉsourceˉsymbolˉstatus.Valid {
        return Compilerˉsourceˉsymbolsˉconstantˉfailure(
            Binding.Status,
            Binding.Nominalˉmodule,
            Binding.Failureˉoffset,
            Binding.Failureˉline,
            Binding.Failureˉcolumn
        );
    }
    let Requiredˉshape: u32 = Compilerˉsourceˉsymbolsˉconstantˉshape(Binding);
    if Requiredˉshape == 0u32 {
        return Compilerˉsourceˉsymbolsˉconstantˉfailure(
            Compilerˉsourceˉsymbolˉstatus.Invalidˉconstantˉtype,
            Module,
            Binding.Nameˉoffset,
            Binding.Failureˉline,
            Binding.Failureˉcolumn
        );
    }
    let Initializerˉposition: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
        Source,
        Declaration.Declarationˉoffset,
        Declarationˉline,
        Declarationˉcolumn,
        Declaration.Bodyˉoffset
    );
    let Expression: Sourceˉbodies.Compilerˉsourceˉexpression = Sourceˉbodies.Compilerˉparseˉexpressionˉvalidated(
        Source,
        Declaration.Bodyˉoffset,
        Initializerˉposition.Line,
        Initializerˉposition.Column,
        Declaration.Bodyˉoffset + Declaration.Bodyˉlength,
        0u32,
        0u32
    );
    let Value: Compilerˉsourceˉconstantˉvalue =
        Compilerˉsourceˉsymbolsˉconstantˉevaluateˉexpression(
            Input, Scan, Symbols, Module, Source,
            Expression, Declaration.Declarationˉoffset, Depth
        );
    if Value.Status != Compilerˉsourceˉsymbolˉstatus.Valid { return Value; }
    if Value.Shape != Requiredˉshape {
        return Compilerˉsourceˉsymbolsˉconstantˉfailure(
            Compilerˉsourceˉsymbolˉstatus.Constantˉtypeˉmismatch,
            Module,
            Expression.Offset,
            Expression.Line,
            Expression.Column
        );
    }
    return Value;
}

export fn Compilerˉsourceˉsymbolsˉfailureˉfromˉsummary(
    Input: bytes,
    Summary: Compilerˉsourceˉsymbolˉsummary,
    Status: Compilerˉsourceˉsymbolˉstatus,
    Module: u32,
    Relatedˉmodule: u32,
    Kind: Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind,
    Offset: u32,
    Line: u32,
    Column: u32
) -> Compilerˉsourceˉsymbolˉsummary {
    return Compilerˉsourceˉsymbolsˉsummaryˉfailure(
        Input,
        Status,
        Sourceˉgraph.Compilerˉsourceˉgraphˉstatus.Valid,
        Summary.Modules,
        Summary.Capabilities,
        Summary.Data,
        Summary.Records,
        Summary.Enums,
        Summary.Variants,
        Summary.Functions,
        Summary.Fields,
        Summary.Members,
        Summary.Cases,
        Summary.Parameters,
        Module,
        Relatedˉmodule,
        Kind,
        Offset,
        Line,
        Column
    );
}

export fn Compilerˉsourceˉsymbolsˉcount(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan
) -> Compilerˉsourceˉsymbolˉsummary {
    var Capabilities: u32 = 0u32;
    var Data: u32 = 0u32;
    var Constants: u32 = 0u32;
    var Records: u32 = 0u32;
    var Enums: u32 = 0u32;
    var Variants: u32 = 0u32;
    var Functions: u32 = 0u32;
    var Fields: u32 = 0u32;
    var Members: u32 = 0u32;
    var Cases: u32 = 0u32;
    var Parameters: u32 = 0u32;
    var Directoryˉpayload: bytes = Compilerˉsourceˉsymbolsˉempty(Input);
    var Module: u32 = 0u32;
    while Module < Scan.Modules {
        let View: Sourceˉset.Compilerˉsourceˉsetˉview = Sourceˉset.Compilerˉsourceˉsetˉmodule(Input, Scan, Module);
        let Header: Sourceˉdeclarations.Compilerˉsourceˉheader = Sourceˉdeclarations.Compilerˉparseˉheaderˉvalidated(View.Source);
        var Cursor: u32 = Header.Nextˉoffset;
        var Currentˉline: u32 = Header.Nextˉline;
        var Currentˉcolumn: u32 = Header.Nextˉcolumn;
        var Sawˉnonˉimport: bool = false;
        var Reading: bool = true;
        while Reading {
            let Declaration: Sourceˉdeclarations.Compilerˉsourceˉdeclaration = Sourceˉdeclarations.Compilerˉparseˉnextˉdeclarationˉvalidated(
                View.Source,
                Cursor,
                Currentˉline,
                Currentˉcolumn,
                Sawˉnonˉimport
            );
            if Declaration.Kind == Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.End {
                Reading = false;
            } else {
                let Nameˉposition: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
                    View.Source,
                    Cursor,
                    Currentˉline,
                    Currentˉcolumn,
                    Declaration.Nameˉoffset
                );
                if Declaration.Kind == Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Capability {
                    Capabilities = Capabilities + 1u32;
                    if Capabilities > 32u32 {
                        return Compilerˉsourceˉsymbolsˉsummaryˉfailure(
                            Input,
                            Compilerˉsourceˉsymbolˉstatus.Capabilityˉlimit,
                            Sourceˉgraph.Compilerˉsourceˉgraphˉstatus.Valid,
                            Scan.Modules,
                            Capabilities,
                            Data,
                            Records,
                            Enums,
                            Variants,
                            Functions,
                            Fields,
                            Members,
                            Cases,
                            Parameters,
                            Module,
                            Scan.Modules,
                            Declaration.Kind,
                            Declaration.Nameˉoffset,
                            Nameˉposition.Line,
                            Nameˉposition.Column
                        );
                    }
                }
                if Declaration.Kind == Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Data {
                    Data = Data + 1u32;
                    if Data > 4096u32 {
                        return Compilerˉsourceˉsymbolsˉsummaryˉfailure(
                            Input,
                            Compilerˉsourceˉsymbolˉstatus.Dataˉlimit,
                            Sourceˉgraph.Compilerˉsourceˉgraphˉstatus.Valid,
                            Scan.Modules,
                            Capabilities,
                            Data,
                            Records,
                            Enums,
                            Variants,
                            Functions,
                            Fields,
                            Members,
                            Cases,
                            Parameters,
                            Module,
                            Scan.Modules,
                            Declaration.Kind,
                            Declaration.Nameˉoffset,
                            Nameˉposition.Line,
                            Nameˉposition.Column
                        );
                    }
                }
                if Declaration.Kind == Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Constant {
                    Constants = Constants + 1u32;
                    if Constants > 4096u32 {
                        return Compilerˉsourceˉsymbolsˉsummaryˉfailure(
                            Input,
                            Compilerˉsourceˉsymbolˉstatus.Constantˉlimit,
                            Sourceˉgraph.Compilerˉsourceˉgraphˉstatus.Valid,
                            Scan.Modules,
                            Capabilities,
                            Data,
                            Records,
                            Enums,
                            Variants,
                            Functions,
                            Fields,
                            Members,
                            Cases,
                            Parameters,
                            Module,
                            Scan.Modules,
                            Declaration.Kind,
                            Declaration.Nameˉoffset,
                            Nameˉposition.Line,
                            Nameˉposition.Column
                        );
                    }
                }
                if Declaration.Kind == Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Record {
                    Records = Records + 1u32;
                    Fields = Fields + Declaration.Items;
                }
                if Declaration.Kind == Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Enum {
                    Enums = Enums + 1u32;
                    Members = Members + Declaration.Items;
                }
                if Declaration.Kind == Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Variant {
                    Variants = Variants + 1u32;
                    Cases = Cases + Declaration.Items;
                }
                if Records + Enums + Variants > 1024u32 {
                    return Compilerˉsourceˉsymbolsˉsummaryˉfailure(
                        Input,
                        Compilerˉsourceˉsymbolˉstatus.Nominalˉtypeˉlimit,
                        Sourceˉgraph.Compilerˉsourceˉgraphˉstatus.Valid,
                        Scan.Modules,
                        Capabilities,
                        Data,
                            Records,
                            Enums,
                            Variants,
                            Functions,
                            Fields,
                            Members,
                            Cases,
                            Parameters,
                        Module,
                        Scan.Modules,
                        Declaration.Kind,
                        Declaration.Nameˉoffset,
                        Nameˉposition.Line,
                        Nameˉposition.Column
                    );
                }
                if Declaration.Kind == Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Function {
                    Functions = Functions + 1u32;
                    Parameters = Parameters + Declaration.Items;
                    if Functions > 4096u32 {
                        return Compilerˉsourceˉsymbolsˉsummaryˉfailure(
                            Input,
                            Compilerˉsourceˉsymbolˉstatus.Functionˉlimit,
                            Sourceˉgraph.Compilerˉsourceˉgraphˉstatus.Valid,
                            Scan.Modules,
                            Capabilities,
                            Data,
                            Records,
                            Enums,
                            Variants,
                            Functions,
                            Fields,
                            Members,
                            Cases,
                            Parameters,
                            Module,
                            Scan.Modules,
                            Declaration.Kind,
                            Declaration.Nameˉoffset,
                            Nameˉposition.Line,
                            Nameˉposition.Column
                        );
                    }
                }
                if Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉisˉsymbol(Declaration) {
                    Directoryˉpayload = Bytesˉconcat(
                        Directoryˉpayload, Bytesˉfromˉu32ˉlittle(Module)
                    );
                    Directoryˉpayload = Bytesˉconcat(Directoryˉpayload, Bytesˉfromˉu32ˉlittle(
                        Compilerˉsourceˉsymbolsˉdeclarationˉkindˉvalue(Declaration.Kind)
                    ));
                    Directoryˉpayload = Bytesˉconcat(
                        Directoryˉpayload, Bytesˉfromˉu32ˉlittle(Declaration.Declarationˉoffset)
                    );
                    Directoryˉpayload = Bytesˉconcat(
                        Directoryˉpayload, Bytesˉfromˉu32ˉlittle(Declaration.Nameˉoffset)
                    );
                    Directoryˉpayload = Bytesˉconcat(
                        Directoryˉpayload, Bytesˉfromˉu32ˉlittle(Declaration.Nameˉlength)
                    );
                    Directoryˉpayload = Bytesˉconcat(
                        Directoryˉpayload, Bytesˉfromˉu32ˉlittle(Declaration.Items)
                    );
                    if Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉclosesˉimports(Declaration) {
                        Sawˉnonˉimport = true;
                    }
                }
                Cursor = Declaration.Nextˉoffset;
                Currentˉline = Declaration.Nextˉline;
                Currentˉcolumn = Declaration.Nextˉcolumn;
            }
        }
        Module = Module + 1u32;
    }
    let Entries: u32 = Capabilities + Data + Constants + Records + Enums + Variants + Functions;
    var Directory: bytes = Textˉtoˉutf8("WVSD");
    Directory = Bytesˉconcat(Directory, Bytesˉfromˉu16ˉlittle(1u32));
    Directory = Bytesˉconcat(Directory, Bytesˉfromˉu16ˉlittle(1u32));
    Directory = Bytesˉconcat(Directory, Bytesˉfromˉu32ˉlittle(Entries));
    Directory = Bytesˉconcat(Directory, Bytesˉfromˉu32ˉlittle(24u32));
    Directory = Bytesˉconcat(Directory, Directoryˉpayload);
    return Compilerˉsourceˉsymbolsˉsummaryˉsuccess(
        Input,
        Scan.Modules,
        Capabilities,
        Data,
        Records,
        Enums,
        Variants,
        Functions,
        Fields,
        Members,
        Cases,
        Parameters,
        Directory,
        Compilerˉsourceˉsymbolsˉempty(Input),
        Compilerˉsourceˉsymbolsˉempty(Input)
    );
}

export fn Compilerˉsourceˉsymbolsˉvalidateˉnamespaces(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Directory: bytes,
    Counts: Compilerˉsourceˉsymbolˉsummary
) -> Compilerˉsourceˉsymbolˉsummary {
    let Expectedˉentries: u32 = Bytesˉreadˉu32ˉlittle(Directory, 8u32);
    var Directoryˉindex: u32 = 0u32;
    var Module: u32 = 0u32;
    while Module < Scan.Modules {
        let View: Sourceˉset.Compilerˉsourceˉsetˉview = Sourceˉset.Compilerˉsourceˉsetˉmodule(Input, Scan, Module);
        let Header: Sourceˉdeclarations.Compilerˉsourceˉheader = Sourceˉdeclarations.Compilerˉparseˉheaderˉvalidated(View.Source);
        var Cursor: u32 = Header.Nextˉoffset;
        var Currentˉline: u32 = Header.Nextˉline;
        var Currentˉcolumn: u32 = Header.Nextˉcolumn;
        var Sawˉnonˉimport: bool = false;
        var Reading: bool = true;
        while Reading {
            let Declaration: Sourceˉdeclarations.Compilerˉsourceˉdeclaration = Sourceˉdeclarations.Compilerˉparseˉnextˉdeclarationˉvalidated(
                View.Source,
                Cursor,
                Currentˉline,
                Currentˉcolumn,
                Sawˉnonˉimport
            );
            if Declaration.Kind == Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.End {
                Reading = false;
            } else {
                let Nameˉposition: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
                    View.Source,
                    Cursor,
                    Currentˉline,
                    Currentˉcolumn,
                    Declaration.Nameˉoffset
                );
                if Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉisˉsymbol(Declaration) {
                    if Directoryˉindex >= Expectedˉentries {
                        return Compilerˉsourceˉsymbolsˉfailureˉfromˉsummary(
                            Input, Counts, Compilerˉsourceˉsymbolˉstatus.Invalidˉdirectory,
                            Module, Scan.Modules, Declaration.Kind, Declaration.Nameˉoffset,
                            Nameˉposition.Line, Nameˉposition.Column
                        );
                    }
                    let Canonical: Compilerˉsourceˉsymbolˉmatch = Compilerˉsourceˉsymbolsˉdirectoryˉentry(
                        Directory, Scan.Modules, Directoryˉindex
                    );
                    let Canonicalˉoffset: u32 = 16u32 + Directoryˉindex * 24u32;
                    var Matches: bool = Canonical.Found;
                    if Canonical.Module != Module { Matches = false; }
                    if Canonical.Kind != Declaration.Kind { Matches = false; }
                    if Canonical.Declarationˉoffset != Declaration.Declarationˉoffset { Matches = false; }
                    if Canonical.Nameˉoffset != Declaration.Nameˉoffset { Matches = false; }
                    if Canonical.Nameˉlength != Declaration.Nameˉlength { Matches = false; }
                    if Bytesˉreadˉu32ˉlittle(Directory, Canonicalˉoffset + 20u32) != Declaration.Items {
                        Matches = false;
                    }
                    if !Matches {
                        return Compilerˉsourceˉsymbolsˉfailureˉfromˉsummary(
                            Input, Counts, Compilerˉsourceˉsymbolˉstatus.Invalidˉdirectory,
                            Module, Scan.Modules, Declaration.Kind, Declaration.Nameˉoffset,
                            Nameˉposition.Line, Nameˉposition.Column
                        );
                    }
                    Directoryˉindex = Directoryˉindex + 1u32;
                }
                if Declaration.Kind == Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Capability {
                    let Capabilityˉprior: Compilerˉsourceˉsymbolˉmatch = Compilerˉsourceˉsymbolsˉfindˉpriorˉinˉdirectory(
                        Input,
                        Scan,
                        Directory,
                        Counts.Lookup,
                        Module,
                        Declaration.Declarationˉoffset,
                        View.Source,
                        Declaration.Nameˉoffset,
                        Declaration.Nameˉlength,
                        Compilerˉsourceˉnamespaceˉkind.Capability
                    );
                    if Capabilityˉprior.Found {
                        return Compilerˉsourceˉsymbolsˉfailureˉfromˉsummary(
                            Input, Counts, Compilerˉsourceˉsymbolˉstatus.Duplicateˉcapability,
                            Module, Capabilityˉprior.Module, Declaration.Kind, Declaration.Nameˉoffset,
                            Nameˉposition.Line, Nameˉposition.Column
                        );
                    }
                    if !Compilerˉsourceˉsymbolsˉisˉknownˉcapability(
                        View.Source,
                        Declaration.Nameˉoffset,
                        Declaration.Nameˉlength
                    ) {
                        return Compilerˉsourceˉsymbolsˉfailureˉfromˉsummary(
                            Input, Counts, Compilerˉsourceˉsymbolˉstatus.Unknownˉcapability,
                            Module, Scan.Modules, Declaration.Kind, Declaration.Nameˉoffset,
                            Nameˉposition.Line, Nameˉposition.Column
                        );
                    }
                    if Header.Profile == Sourceˉdeclarations.Compilerˉsourceˉprofile.Portable {
                        return Compilerˉsourceˉsymbolsˉfailureˉfromˉsummary(
                            Input, Counts, Compilerˉsourceˉsymbolˉstatus.Capabilityˉprofile,
                            Module, Scan.Modules, Declaration.Kind, Declaration.Nameˉoffset,
                            Nameˉposition.Line, Nameˉposition.Column
                        );
                    }
                }
                if Declaration.Kind == Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Data {
                    let Dataˉprior: Compilerˉsourceˉsymbolˉmatch = Compilerˉsourceˉsymbolsˉfindˉpriorˉinˉdirectory(
                        Input, Scan, Directory, Counts.Lookup, Module, Declaration.Declarationˉoffset,
                        View.Source, Declaration.Nameˉoffset, Declaration.Nameˉlength,
                        Compilerˉsourceˉnamespaceˉkind.Data
                    );
                    if Dataˉprior.Found {
                        return Compilerˉsourceˉsymbolsˉfailureˉfromˉsummary(
                            Input, Counts, Compilerˉsourceˉsymbolˉstatus.Duplicateˉdata,
                            Module, Dataˉprior.Module, Declaration.Kind, Declaration.Nameˉoffset,
                            Nameˉposition.Line, Nameˉposition.Column
                        );
                    }
                }
                if Declaration.Kind == Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Constant {
                    if !Compilerˉsourceˉsymbolsˉconstantˉnameˉisˉvalid(
                        View.Source, Declaration.Nameˉoffset, Declaration.Nameˉlength
                    ) {
                        return Compilerˉsourceˉsymbolsˉfailureˉfromˉsummary(
                            Input, Counts, Compilerˉsourceˉsymbolˉstatus.Invalidˉconstantˉname,
                            Module, Scan.Modules, Declaration.Kind, Declaration.Nameˉoffset,
                            Nameˉposition.Line, Nameˉposition.Column
                        );
                    }
                    let Constantˉprior: Compilerˉsourceˉsymbolˉmatch = Compilerˉsourceˉsymbolsˉfindˉpriorˉinˉdirectory(
                        Input, Scan, Directory, Counts.Lookup, Module, Declaration.Declarationˉoffset,
                        View.Source, Declaration.Nameˉoffset, Declaration.Nameˉlength,
                        Compilerˉsourceˉnamespaceˉkind.Data
                    );
                    if Constantˉprior.Found {
                        return Compilerˉsourceˉsymbolsˉfailureˉfromˉsummary(
                            Input, Counts, Compilerˉsourceˉsymbolˉstatus.Duplicateˉdata,
                            Module, Constantˉprior.Module, Declaration.Kind, Declaration.Nameˉoffset,
                            Nameˉposition.Line, Nameˉposition.Column
                        );
                    }
                }
                if Declaration.Kind == Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Record {
                    if Compilerˉsourceˉsymbolsˉisˉreserved(
                        View.Source,
                        Declaration.Nameˉoffset,
                        Declaration.Nameˉlength
                    ) {
                        return Compilerˉsourceˉsymbolsˉfailureˉfromˉsummary(
                            Input, Counts, Compilerˉsourceˉsymbolˉstatus.Reservedˉname,
                            Module, Scan.Modules, Declaration.Kind, Declaration.Nameˉoffset,
                            Nameˉposition.Line, Nameˉposition.Column
                        );
                    }
                    let Priorˉtype: Compilerˉsourceˉsymbolˉmatch = Compilerˉsourceˉsymbolsˉfindˉpriorˉinˉdirectory(
                        Input, Scan, Directory, Counts.Lookup, Module, Declaration.Declarationˉoffset,
                        View.Source, Declaration.Nameˉoffset, Declaration.Nameˉlength,
                        Compilerˉsourceˉnamespaceˉkind.Nominal
                    );
                    if Priorˉtype.Found {
                        return Compilerˉsourceˉsymbolsˉfailureˉfromˉsummary(
                            Input, Counts, Compilerˉsourceˉsymbolˉstatus.Duplicateˉtype,
                            Module, Priorˉtype.Module, Declaration.Kind, Declaration.Nameˉoffset,
                            Nameˉposition.Line, Nameˉposition.Column
                        );
                    }
                    let Recordˉpriorˉconstructor: Compilerˉsourceˉsymbolˉmatch = Compilerˉsourceˉsymbolsˉfindˉpriorˉinˉdirectory(
                        Input, Scan, Directory, Counts.Lookup, Module, Declaration.Declarationˉoffset,
                        View.Source, Declaration.Nameˉoffset, Declaration.Nameˉlength,
                        Compilerˉsourceˉnamespaceˉkind.Constructor
                    );
                    if Recordˉpriorˉconstructor.Found {
                        return Compilerˉsourceˉsymbolsˉfailureˉfromˉsummary(
                            Input, Counts, Compilerˉsourceˉsymbolˉstatus.Constructorˉconflict,
                            Module, Recordˉpriorˉconstructor.Module, Declaration.Kind, Declaration.Nameˉoffset,
                            Nameˉposition.Line, Nameˉposition.Column
                        );
                    }
                }
                if Declaration.Kind == Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Enum {
                    let Enumˉprior: Compilerˉsourceˉsymbolˉmatch = Compilerˉsourceˉsymbolsˉfindˉpriorˉinˉdirectory(
                        Input, Scan, Directory, Counts.Lookup, Module, Declaration.Declarationˉoffset,
                        View.Source, Declaration.Nameˉoffset, Declaration.Nameˉlength,
                        Compilerˉsourceˉnamespaceˉkind.Nominal
                    );
                    if Enumˉprior.Found {
                        return Compilerˉsourceˉsymbolsˉfailureˉfromˉsummary(
                            Input, Counts, Compilerˉsourceˉsymbolˉstatus.Duplicateˉtype,
                            Module, Enumˉprior.Module, Declaration.Kind, Declaration.Nameˉoffset,
                            Nameˉposition.Line, Nameˉposition.Column
                        );
                    }
                }
                if Declaration.Kind == Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Variant {
                    if Compilerˉsourceˉsymbolsˉisˉreserved(
                        View.Source, Declaration.Nameˉoffset, Declaration.Nameˉlength
                    ) {
                        return Compilerˉsourceˉsymbolsˉfailureˉfromˉsummary(
                            Input, Counts, Compilerˉsourceˉsymbolˉstatus.Reservedˉname,
                            Module, Scan.Modules, Declaration.Kind, Declaration.Nameˉoffset,
                            Nameˉposition.Line, Nameˉposition.Column
                        );
                    }
                    let Variantˉprior: Compilerˉsourceˉsymbolˉmatch = Compilerˉsourceˉsymbolsˉfindˉpriorˉinˉdirectory(
                        Input, Scan, Directory, Counts.Lookup, Module, Declaration.Declarationˉoffset,
                        View.Source, Declaration.Nameˉoffset, Declaration.Nameˉlength,
                        Compilerˉsourceˉnamespaceˉkind.Nominal
                    );
                    if Variantˉprior.Found {
                        return Compilerˉsourceˉsymbolsˉfailureˉfromˉsummary(
                            Input, Counts, Compilerˉsourceˉsymbolˉstatus.Duplicateˉtype,
                            Module, Variantˉprior.Module, Declaration.Kind, Declaration.Nameˉoffset,
                            Nameˉposition.Line, Nameˉposition.Column
                        );
                    }
                }
                if Declaration.Kind == Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Function {
                    if Compilerˉsourceˉsymbolsˉisˉreserved(
                        View.Source,
                        Declaration.Nameˉoffset,
                        Declaration.Nameˉlength
                    ) {
                        return Compilerˉsourceˉsymbolsˉfailureˉfromˉsummary(
                            Input, Counts, Compilerˉsourceˉsymbolˉstatus.Reservedˉname,
                            Module, Scan.Modules, Declaration.Kind, Declaration.Nameˉoffset,
                            Nameˉposition.Line, Nameˉposition.Column
                        );
                    }
                    let Priorˉfunction: Compilerˉsourceˉsymbolˉmatch = Compilerˉsourceˉsymbolsˉfindˉpriorˉinˉdirectory(
                        Input, Scan, Directory, Counts.Lookup, Module, Declaration.Declarationˉoffset,
                        View.Source, Declaration.Nameˉoffset, Declaration.Nameˉlength,
                        Compilerˉsourceˉnamespaceˉkind.Function
                    );
                    if Priorˉfunction.Found {
                        return Compilerˉsourceˉsymbolsˉfailureˉfromˉsummary(
                            Input, Counts, Compilerˉsourceˉsymbolˉstatus.Duplicateˉfunction,
                            Module, Priorˉfunction.Module, Declaration.Kind, Declaration.Nameˉoffset,
                            Nameˉposition.Line, Nameˉposition.Column
                        );
                    }
                    let Functionˉpriorˉconstructor: Compilerˉsourceˉsymbolˉmatch = Compilerˉsourceˉsymbolsˉfindˉpriorˉinˉdirectory(
                        Input, Scan, Directory, Counts.Lookup, Module, Declaration.Declarationˉoffset,
                        View.Source, Declaration.Nameˉoffset, Declaration.Nameˉlength,
                        Compilerˉsourceˉnamespaceˉkind.Constructor
                    );
                    if Functionˉpriorˉconstructor.Found {
                        return Compilerˉsourceˉsymbolsˉfailureˉfromˉsummary(
                            Input, Counts, Compilerˉsourceˉsymbolˉstatus.Constructorˉconflict,
                            Module, Functionˉpriorˉconstructor.Module, Declaration.Kind, Declaration.Nameˉoffset,
                            Nameˉposition.Line, Nameˉposition.Column
                        );
                    }
                }
                if Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉclosesˉimports(Declaration) {
                    Sawˉnonˉimport = true;
                }
                Cursor = Declaration.Nextˉoffset;
                Currentˉline = Declaration.Nextˉline;
                Currentˉcolumn = Declaration.Nextˉcolumn;
            }
        }
        Module = Module + 1u32;
    }
    if Directoryˉindex != Expectedˉentries {
        return Compilerˉsourceˉsymbolsˉfailureˉfromˉsummary(
            Input, Counts, Compilerˉsourceˉsymbolˉstatus.Invalidˉdirectory,
            Scan.Modules, Scan.Modules, Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.End,
            Bytesˉlength(Input), 0u32, 0u32
        );
    }
    return Counts;
}

export fn Compilerˉsourceˉsymbolsˉfieldˉisˉduplicate(
    Source: bytes,
    Firstˉoffset: u32,
    Firstˉline: u32,
    Firstˉcolumn: u32,
    Current: Sourceˉlexer.Compilerˉsourceˉtoken
) -> bool {
    var Cursor: u32 = Firstˉoffset;
    var Currentˉline: u32 = Firstˉline;
    var Currentˉcolumn: u32 = Firstˉcolumn;
    while Cursor < Current.Offset {
        let Name: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Source, Cursor, Currentˉline, Currentˉcolumn
        );
        if Name.Offset >= Current.Offset { return false; }
        if Sourceˉset.Compilerˉsourceˉspansˉequal(
            Source, Name.Offset, Name.Length,
            Source, Current.Offset, Current.Length
        ) { return true; }
        let Colon: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Source, Name.Nextˉoffset, Name.Nextˉline, Name.Nextˉcolumn
        );
        let Type: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Source, Colon.Nextˉoffset, Colon.Nextˉline, Colon.Nextˉcolumn
        );
        let End: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Source, Type.Nextˉoffset, Type.Nextˉline, Type.Nextˉcolumn
        );
        Cursor = End.Nextˉoffset;
        Currentˉline = End.Nextˉline;
        Currentˉcolumn = End.Nextˉcolumn;
    }
    return false;
}

export fn Compilerˉsourceˉsymbolsˉenumˉduplicate(
    Source: bytes,
    Firstˉoffset: u32,
    Firstˉline: u32,
    Firstˉcolumn: u32,
    Currentˉname: Sourceˉlexer.Compilerˉsourceˉtoken,
    Currentˉvalue: u32
) -> Compilerˉsourceˉenumˉduplicate {
    var Duplicateˉname: bool = false;
    var Duplicateˉvalue: bool = false;
    var Cursor: u32 = Firstˉoffset;
    var Currentˉline: u32 = Firstˉline;
    var Currentˉcolumn: u32 = Firstˉcolumn;
    while Cursor < Currentˉname.Offset {
        let Name: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Source, Cursor, Currentˉline, Currentˉcolumn
        );
        if Name.Offset >= Currentˉname.Offset {
            return Compilerˉsourceˉenumˉduplicate(Duplicateˉname, Duplicateˉvalue);
        }
        if Sourceˉset.Compilerˉsourceˉspansˉequal(
            Source, Name.Offset, Name.Length,
            Source, Currentˉname.Offset, Currentˉname.Length
        ) { Duplicateˉname = true; }
        let Equals: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Source, Name.Nextˉoffset, Name.Nextˉline, Name.Nextˉcolumn
        );
        let Value: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Source, Equals.Nextˉoffset, Equals.Nextˉline, Equals.Nextˉcolumn
        );
        if Value.Numericˉvalue == Currentˉvalue { Duplicateˉvalue = true; }
        let End: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Source, Value.Nextˉoffset, Value.Nextˉline, Value.Nextˉcolumn
        );
        Cursor = End.Nextˉoffset;
        Currentˉline = End.Nextˉline;
        Currentˉcolumn = End.Nextˉcolumn;
    }
    return Compilerˉsourceˉenumˉduplicate(Duplicateˉname, Duplicateˉvalue);
}

export fn Compilerˉsourceˉsymbolsˉparameterˉisˉduplicate(
    Source: bytes,
    Firstˉoffset: u32,
    Firstˉline: u32,
    Firstˉcolumn: u32,
    Current: Sourceˉlexer.Compilerˉsourceˉtoken
) -> bool {
    var Cursor: u32 = Firstˉoffset;
    var Currentˉline: u32 = Firstˉline;
    var Currentˉcolumn: u32 = Firstˉcolumn;
    while Cursor < Current.Offset {
        let Name: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Source, Cursor, Currentˉline, Currentˉcolumn
        );
        if Name.Offset >= Current.Offset { return false; }
        if Sourceˉset.Compilerˉsourceˉspansˉequal(
            Source, Name.Offset, Name.Length,
            Source, Current.Offset, Current.Length
        ) { return true; }
        let Colon: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Source, Name.Nextˉoffset, Name.Nextˉline, Name.Nextˉcolumn
        );
        let Type: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Source, Colon.Nextˉoffset, Colon.Nextˉline, Colon.Nextˉcolumn
        );
        let Separator: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Source, Type.Nextˉoffset, Type.Nextˉline, Type.Nextˉcolumn
        );
        Cursor = Separator.Nextˉoffset;
        Currentˉline = Separator.Nextˉline;
        Currentˉcolumn = Separator.Nextˉcolumn;
    }
    return false;
}

export fn Compilerˉsourceˉsymbolsˉfailureˉfromˉtype(
    Input: bytes,
    Summary: Compilerˉsourceˉsymbolˉsummary,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Module: u32,
    Kind: Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind,
    Binding: Compilerˉsourceˉtypeˉbinding
) -> Compilerˉsourceˉsymbolˉsummary {
    var Related: u32 = Binding.Nominalˉmodule;
    if Related > Scan.Modules { Related = Scan.Modules; }
    return Compilerˉsourceˉsymbolsˉfailureˉfromˉsummary(
        Input,
        Summary,
        Binding.Status,
        Module,
        Related,
        Kind,
        Binding.Failureˉoffset,
        Binding.Failureˉline,
        Binding.Failureˉcolumn
    );
}

export fn Compilerˉsourceˉsymbolsˉvalidateˉrecord(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Directory: bytes,
    Visibility: bytes,
    Counts: Compilerˉsourceˉsymbolˉsummary,
    Module: u32,
    Source: bytes,
    Declaration: Sourceˉdeclarations.Compilerˉsourceˉdeclaration,
    Declarationˉline: u32,
    Declarationˉcolumn: u32
) -> Compilerˉsourceˉsymbolˉsummary {
    let Nameˉposition: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
        Source,
        Declaration.Declarationˉoffset,
        Declarationˉline,
        Declarationˉcolumn,
        Declaration.Nameˉoffset
    );
    if Declaration.Items == 0u32 {
        return Compilerˉsourceˉsymbolsˉfailureˉfromˉsummary(
            Input, Counts, Compilerˉsourceˉsymbolˉstatus.Emptyˉrecord,
            Module, Scan.Modules, Declaration.Kind, Declaration.Nameˉoffset,
            Nameˉposition.Line, Nameˉposition.Column
        );
    }
    let Bodyˉposition: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
        Source, Declaration.Declarationˉoffset, Declarationˉline, Declarationˉcolumn,
        Declaration.Bodyˉoffset
    );
    let Brace: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
        Source, Declaration.Bodyˉoffset, Bodyˉposition.Line, Bodyˉposition.Column
    );
    let Firstˉoffset: u32 = Brace.Nextˉoffset;
    let Firstˉline: u32 = Brace.Nextˉline;
    let Firstˉcolumn: u32 = Brace.Nextˉcolumn;
    var Cursor: u32 = Firstˉoffset;
    var Currentˉline: u32 = Firstˉline;
    var Currentˉcolumn: u32 = Firstˉcolumn;
    var Index: u32 = 0u32;
    while Index < Declaration.Items {
        let Field: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Source, Cursor, Currentˉline, Currentˉcolumn
        );
        if Compilerˉsourceˉsymbolsˉfieldˉisˉduplicate(
            Source, Firstˉoffset, Firstˉline, Firstˉcolumn, Field
        ) {
            return Compilerˉsourceˉsymbolsˉfailureˉfromˉsummary(
                Input, Counts, Compilerˉsourceˉsymbolˉstatus.Duplicateˉfield,
                Module, Module, Declaration.Kind, Field.Offset, Field.Line, Field.Column
            );
        }
        let Colon: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Source, Field.Nextˉoffset, Field.Nextˉline, Field.Nextˉcolumn
        );
        let Binding: Compilerˉsourceˉtypeˉbinding = Compilerˉsourceˉsymbolsˉbindˉtype(
            Input, Scan, Directory, Counts.Lookup, Visibility, Module, Source,
            Colon.Nextˉoffset, Colon.Nextˉline, Colon.Nextˉcolumn,
            Counts.Records, Counts.Enums, true
        );
        if Binding.Status != Compilerˉsourceˉsymbolˉstatus.Valid {
            return Compilerˉsourceˉsymbolsˉfailureˉfromˉtype(
                Input, Counts, Scan, Module, Declaration.Kind, Binding
            );
        }
        let End: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Source, Binding.Nextˉoffset, Binding.Nextˉline, Binding.Nextˉcolumn
        );
        Cursor = End.Nextˉoffset;
        Currentˉline = End.Nextˉline;
        Currentˉcolumn = End.Nextˉcolumn;
        Index = Index + 1u32;
    }
    return Counts;
}

export fn Compilerˉsourceˉsymbolsˉvalidateˉenum(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Counts: Compilerˉsourceˉsymbolˉsummary,
    Module: u32,
    Source: bytes,
    Declaration: Sourceˉdeclarations.Compilerˉsourceˉdeclaration,
    Declarationˉline: u32,
    Declarationˉcolumn: u32
) -> Compilerˉsourceˉsymbolˉsummary {
    let Nameˉposition: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
        Source,
        Declaration.Declarationˉoffset,
        Declarationˉline,
        Declarationˉcolumn,
        Declaration.Nameˉoffset
    );
    if Declaration.Items == 0u32 {
        return Compilerˉsourceˉsymbolsˉfailureˉfromˉsummary(
            Input, Counts, Compilerˉsourceˉsymbolˉstatus.Emptyˉenum,
            Module, Scan.Modules, Declaration.Kind, Declaration.Nameˉoffset,
            Nameˉposition.Line, Nameˉposition.Column
        );
    }
    let Bodyˉposition: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
        Source, Declaration.Declarationˉoffset, Declarationˉline, Declarationˉcolumn,
        Declaration.Bodyˉoffset
    );
    let Brace: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
        Source, Declaration.Bodyˉoffset, Bodyˉposition.Line, Bodyˉposition.Column
    );
    let Firstˉoffset: u32 = Brace.Nextˉoffset;
    let Firstˉline: u32 = Brace.Nextˉline;
    let Firstˉcolumn: u32 = Brace.Nextˉcolumn;
    var Cursor: u32 = Firstˉoffset;
    var Currentˉline: u32 = Firstˉline;
    var Currentˉcolumn: u32 = Firstˉcolumn;
    var Index: u32 = 0u32;
    while Index < Declaration.Items {
        let Member: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Source, Cursor, Currentˉline, Currentˉcolumn
        );
        let Equals: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Source, Member.Nextˉoffset, Member.Nextˉline, Member.Nextˉcolumn
        );
        let Value: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Source, Equals.Nextˉoffset, Equals.Nextˉline, Equals.Nextˉcolumn
        );
        let Duplicate: Compilerˉsourceˉenumˉduplicate = Compilerˉsourceˉsymbolsˉenumˉduplicate(
            Source, Firstˉoffset, Firstˉline, Firstˉcolumn, Member, Value.Numericˉvalue
        );
        if Duplicate.Name {
            return Compilerˉsourceˉsymbolsˉfailureˉfromˉsummary(
                Input, Counts, Compilerˉsourceˉsymbolˉstatus.Duplicateˉenumˉmember,
                Module, Module, Declaration.Kind, Member.Offset, Member.Line, Member.Column
            );
        }
        if Duplicate.Value {
            return Compilerˉsourceˉsymbolsˉfailureˉfromˉsummary(
                Input, Counts, Compilerˉsourceˉsymbolˉstatus.Duplicateˉenumˉvalue,
                Module, Module, Declaration.Kind, Value.Offset, Value.Line, Value.Column
            );
        }
        let End: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Source, Value.Nextˉoffset, Value.Nextˉline, Value.Nextˉcolumn
        );
        Cursor = End.Nextˉoffset;
        Currentˉline = End.Nextˉline;
        Currentˉcolumn = End.Nextˉcolumn;
        Index = Index + 1u32;
    }
    return Counts;
}

export fn Compilerˉsourceˉsymbolsˉvariantˉcaseˉisˉduplicate(
    Source: bytes,
    Firstˉoffset: u32,
    Firstˉline: u32,
    Firstˉcolumn: u32,
    Current: Sourceˉlexer.Compilerˉsourceˉtoken
) -> bool {
    var Cursor: u32 = Firstˉoffset;
    var Currentˉline: u32 = Firstˉline;
    var Currentˉcolumn: u32 = Firstˉcolumn;
    while Cursor < Current.Offset {
        let Name: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Source, Cursor, Currentˉline, Currentˉcolumn
        );
        if Name.Offset >= Current.Offset { return false; }
        if Sourceˉset.Compilerˉsourceˉspansˉequal(
            Source, Name.Offset, Name.Length,
            Source, Current.Offset, Current.Length
        ) { return true; }
        let Afterˉname: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Source, Name.Nextˉoffset, Name.Nextˉline, Name.Nextˉcolumn
        );
        var End: Sourceˉlexer.Compilerˉsourceˉtoken = Afterˉname;
        if Afterˉname.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Leftˉparenthesis {
            let Payloadˉname: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                Source, Afterˉname.Nextˉoffset, Afterˉname.Nextˉline, Afterˉname.Nextˉcolumn
            );
            let Colon: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                Source, Payloadˉname.Nextˉoffset, Payloadˉname.Nextˉline, Payloadˉname.Nextˉcolumn
            );
            let Type: Sourceˉdeclarations.Compilerˉparseˉstep = Sourceˉdeclarations.Compilerˉparseˉtype(
                Source, Colon.Nextˉoffset, Colon.Nextˉline, Colon.Nextˉcolumn, false, false
            );
            let Right: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                Source, Type.Nextˉoffset, Type.Nextˉline, Type.Nextˉcolumn
            );
            End = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                Source, Right.Nextˉoffset, Right.Nextˉline, Right.Nextˉcolumn
            );
        }
        Cursor = End.Nextˉoffset;
        Currentˉline = End.Nextˉline;
        Currentˉcolumn = End.Nextˉcolumn;
    }
    return false;
}

export fn Compilerˉsourceˉsymbolsˉvalidateˉvariant(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Directory: bytes,
    Visibility: bytes,
    Counts: Compilerˉsourceˉsymbolˉsummary,
    Module: u32,
    Source: bytes,
    Declaration: Sourceˉdeclarations.Compilerˉsourceˉdeclaration,
    Declarationˉline: u32,
    Declarationˉcolumn: u32
) -> Compilerˉsourceˉsymbolˉsummary {
    let Nameˉposition: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
        Source, Declaration.Declarationˉoffset, Declarationˉline, Declarationˉcolumn,
        Declaration.Nameˉoffset
    );
    if Declaration.Items == 0u32 {
        return Compilerˉsourceˉsymbolsˉfailureˉfromˉsummary(
            Input, Counts, Compilerˉsourceˉsymbolˉstatus.Emptyˉvariant,
            Module, Scan.Modules, Declaration.Kind, Declaration.Nameˉoffset,
            Nameˉposition.Line, Nameˉposition.Column
        );
    }
    let Bodyˉposition: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
        Source, Declaration.Declarationˉoffset, Declarationˉline, Declarationˉcolumn,
        Declaration.Bodyˉoffset
    );
    let Brace: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
        Source, Declaration.Bodyˉoffset, Bodyˉposition.Line, Bodyˉposition.Column
    );
    let Firstˉoffset: u32 = Brace.Nextˉoffset;
    let Firstˉline: u32 = Brace.Nextˉline;
    let Firstˉcolumn: u32 = Brace.Nextˉcolumn;
    var Cursor: u32 = Firstˉoffset;
    var Currentˉline: u32 = Firstˉline;
    var Currentˉcolumn: u32 = Firstˉcolumn;
    var Index: u32 = 0u32;
    while Index < Declaration.Items {
        let Case: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Source, Cursor, Currentˉline, Currentˉcolumn
        );
        if Compilerˉsourceˉsymbolsˉvariantˉcaseˉisˉduplicate(
            Source, Firstˉoffset, Firstˉline, Firstˉcolumn, Case
        ) {
            return Compilerˉsourceˉsymbolsˉfailureˉfromˉsummary(
                Input, Counts, Compilerˉsourceˉsymbolˉstatus.Duplicateˉvariantˉcase,
                Module, Module, Declaration.Kind, Case.Offset, Case.Line, Case.Column
            );
        }
        let Afterˉname: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Source, Case.Nextˉoffset, Case.Nextˉline, Case.Nextˉcolumn
        );
        var End: Sourceˉlexer.Compilerˉsourceˉtoken = Afterˉname;
        if Afterˉname.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Leftˉparenthesis {
            let Payloadˉname: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                Source, Afterˉname.Nextˉoffset, Afterˉname.Nextˉline, Afterˉname.Nextˉcolumn
            );
            let Colon: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                Source, Payloadˉname.Nextˉoffset, Payloadˉname.Nextˉline, Payloadˉname.Nextˉcolumn
            );
            let Payloadˉtype: Compilerˉsourceˉtypeˉbinding = Compilerˉsourceˉsymbolsˉbindˉtype(
                Input, Scan, Directory, Counts.Lookup, Visibility, Module, Source,
                Colon.Nextˉoffset, Colon.Nextˉline, Colon.Nextˉcolumn,
                Counts.Records, Counts.Enums, false
            );
            if Payloadˉtype.Status != Compilerˉsourceˉsymbolˉstatus.Valid {
                return Compilerˉsourceˉsymbolsˉfailureˉfromˉtype(
                    Input, Counts, Scan, Module, Declaration.Kind, Payloadˉtype
                );
            }
            if Payloadˉtype.Nominalˉkind == Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Variant {
                return Compilerˉsourceˉsymbolsˉfailureˉfromˉsummary(
                    Input, Counts, Compilerˉsourceˉsymbolˉstatus.Invalidˉvariantˉpayload,
                    Module, Payloadˉtype.Nominalˉmodule, Declaration.Kind,
                    Payloadˉtype.Nameˉoffset, Payloadˉtype.Failureˉline, Payloadˉtype.Failureˉcolumn
                );
            }
            if Payloadˉtype.Nominalˉkind == Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Capability {
                return Compilerˉsourceˉsymbolsˉfailureˉfromˉsummary(
                    Input, Counts, Compilerˉsourceˉsymbolˉstatus.Invalidˉvariantˉpayload,
                    Module, Payloadˉtype.Nominalˉmodule, Declaration.Kind,
                    Payloadˉtype.Nameˉoffset, Payloadˉtype.Failureˉline, Payloadˉtype.Failureˉcolumn
                );
            }
            let Right: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                Source, Payloadˉtype.Nextˉoffset, Payloadˉtype.Nextˉline, Payloadˉtype.Nextˉcolumn
            );
            End = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                Source, Right.Nextˉoffset, Right.Nextˉline, Right.Nextˉcolumn
            );
        }
        Cursor = End.Nextˉoffset;
        Currentˉline = End.Nextˉline;
        Currentˉcolumn = End.Nextˉcolumn;
        Index = Index + 1u32;
    }
    return Counts;
}

export fn Compilerˉsourceˉsymbolsˉvalidateˉfunction(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Directory: bytes,
    Visibility: bytes,
    Counts: Compilerˉsourceˉsymbolˉsummary,
    Module: u32,
    Source: bytes,
    Declaration: Sourceˉdeclarations.Compilerˉsourceˉdeclaration,
    Declarationˉline: u32,
    Declarationˉcolumn: u32
) -> Compilerˉsourceˉsymbolˉsummary {
    let First: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
        Source, Declaration.Declarationˉoffset, Declarationˉline, Declarationˉcolumn
    );
    var Functionˉtoken: Sourceˉlexer.Compilerˉsourceˉtoken = First;
    if First.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Export {
        Functionˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Source, First.Nextˉoffset, First.Nextˉline, First.Nextˉcolumn
        );
    }
    let Name: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
        Source, Functionˉtoken.Nextˉoffset, Functionˉtoken.Nextˉline, Functionˉtoken.Nextˉcolumn
    );
    let Left: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
        Source, Name.Nextˉoffset, Name.Nextˉline, Name.Nextˉcolumn
    );
    let Firstˉoffset: u32 = Left.Nextˉoffset;
    let Firstˉline: u32 = Left.Nextˉline;
    let Firstˉcolumn: u32 = Left.Nextˉcolumn;
    var Cursor: u32 = Firstˉoffset;
    var Currentˉline: u32 = Firstˉline;
    var Currentˉcolumn: u32 = Firstˉcolumn;
    var Index: u32 = 0u32;
    while Index < Declaration.Items {
        let Parameter: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Source, Cursor, Currentˉline, Currentˉcolumn
        );
        if Compilerˉsourceˉsymbolsˉparameterˉisˉduplicate(
            Source, Firstˉoffset, Firstˉline, Firstˉcolumn, Parameter
        ) {
            return Compilerˉsourceˉsymbolsˉfailureˉfromˉsummary(
                Input, Counts, Compilerˉsourceˉsymbolˉstatus.Duplicateˉparameter,
                Module, Module, Declaration.Kind,
                Parameter.Offset, Parameter.Line, Parameter.Column
            );
        }
        let Colon: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Source, Parameter.Nextˉoffset, Parameter.Nextˉline, Parameter.Nextˉcolumn
        );
        let Binding: Compilerˉsourceˉtypeˉbinding = Compilerˉsourceˉsymbolsˉbindˉtype(
            Input, Scan, Directory, Counts.Lookup, Visibility, Module, Source,
            Colon.Nextˉoffset, Colon.Nextˉline, Colon.Nextˉcolumn,
            Counts.Records, Counts.Enums, false
        );
        if Binding.Status != Compilerˉsourceˉsymbolˉstatus.Valid {
            return Compilerˉsourceˉsymbolsˉfailureˉfromˉtype(
                Input, Counts, Scan, Module, Declaration.Kind, Binding
            );
        }
        let Separator: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Source, Binding.Nextˉoffset, Binding.Nextˉline, Binding.Nextˉcolumn
        );
        if Separator.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Comma {
            Cursor = Separator.Nextˉoffset;
            Currentˉline = Separator.Nextˉline;
            Currentˉcolumn = Separator.Nextˉcolumn;
        } else {
            Cursor = Separator.Offset;
            Currentˉline = Separator.Line;
            Currentˉcolumn = Separator.Column;
        }
        Index = Index + 1u32;
    }
    let Right: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
        Source, Cursor, Currentˉline, Currentˉcolumn
    );
    let Arrow: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
        Source, Right.Nextˉoffset, Right.Nextˉline, Right.Nextˉcolumn
    );
    let Returnˉtype: Compilerˉsourceˉtypeˉbinding = Compilerˉsourceˉsymbolsˉbindˉtype(
        Input, Scan, Directory, Counts.Lookup, Visibility, Module, Source,
        Arrow.Nextˉoffset, Arrow.Nextˉline, Arrow.Nextˉcolumn,
        Counts.Records, Counts.Enums, false
    );
    if Returnˉtype.Status != Compilerˉsourceˉsymbolˉstatus.Valid {
        return Compilerˉsourceˉsymbolsˉfailureˉfromˉtype(
            Input, Counts, Scan, Module, Declaration.Kind, Returnˉtype
        );
    }
    return Counts;
}

export fn Compilerˉsourceˉsymbolsˉvalidateˉconstant(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Counts: Compilerˉsourceˉsymbolˉsummary,
    Module: u32,
    Source: bytes,
    Declaration: Sourceˉdeclarations.Compilerˉsourceˉdeclaration,
    Declarationˉline: u32,
    Declarationˉcolumn: u32
) -> Compilerˉsourceˉsymbolˉsummary {
    let Value: Compilerˉsourceˉconstantˉvalue =
        Compilerˉsourceˉsymbolsˉconstantˉevaluateˉdeclaration(
            Input, Scan, Counts, Module, Source,
            Declaration, Declarationˉline, Declarationˉcolumn, 0u32
        );
    if Value.Status != Compilerˉsourceˉsymbolˉstatus.Valid {
        return Compilerˉsourceˉsymbolsˉfailureˉfromˉsummary(
            Input,
            Counts,
            Value.Status,
            Module,
            Value.Failureˉmodule,
            Declaration.Kind,
            Value.Failureˉoffset,
            Value.Failureˉline,
            Value.Failureˉcolumn
        );
    }
    return Counts;
}

export fn Compilerˉsourceˉsymbolsˉvalidateˉdeclarations(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Directory: bytes,
    Visibility: bytes,
    Counts: Compilerˉsourceˉsymbolˉsummary
) -> Compilerˉsourceˉsymbolˉsummary {
    var Module: u32 = 0u32;
    while Module < Scan.Modules {
        let View: Sourceˉset.Compilerˉsourceˉsetˉview = Sourceˉset.Compilerˉsourceˉsetˉmodule(Input, Scan, Module);
        let Header: Sourceˉdeclarations.Compilerˉsourceˉheader = Sourceˉdeclarations.Compilerˉparseˉheaderˉvalidated(View.Source);
        var Cursor: u32 = Header.Nextˉoffset;
        var Currentˉline: u32 = Header.Nextˉline;
        var Currentˉcolumn: u32 = Header.Nextˉcolumn;
        var Sawˉnonˉimport: bool = false;
        var Reading: bool = true;
        while Reading {
            let Declaration: Sourceˉdeclarations.Compilerˉsourceˉdeclaration = Sourceˉdeclarations.Compilerˉparseˉnextˉdeclarationˉvalidated(
                View.Source,
                Cursor,
                Currentˉline,
                Currentˉcolumn,
                Sawˉnonˉimport
            );
            if Declaration.Kind == Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.End {
                Reading = false;
            } else {
                let Declarationˉposition: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
                    View.Source,
                    Cursor,
                    Currentˉline,
                    Currentˉcolumn,
                    Declaration.Declarationˉoffset
                );
                var Result: Compilerˉsourceˉsymbolˉsummary = Counts;
                if Declaration.Kind == Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Record {
                    Result = Compilerˉsourceˉsymbolsˉvalidateˉrecord(
                        Input, Scan, Directory, Visibility, Counts, Module, View.Source, Declaration,
                        Declarationˉposition.Line, Declarationˉposition.Column
                    );
                }
                if Declaration.Kind == Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Enum {
                    Result = Compilerˉsourceˉsymbolsˉvalidateˉenum(
                        Input, Scan, Counts, Module, View.Source, Declaration,
                        Declarationˉposition.Line, Declarationˉposition.Column
                    );
                }
                if Declaration.Kind == Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Variant {
                    Result = Compilerˉsourceˉsymbolsˉvalidateˉvariant(
                        Input, Scan, Directory, Visibility, Counts, Module, View.Source, Declaration,
                        Declarationˉposition.Line, Declarationˉposition.Column
                    );
                }
                if Declaration.Kind == Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Function {
                    Result = Compilerˉsourceˉsymbolsˉvalidateˉfunction(
                        Input, Scan, Directory, Visibility, Counts, Module, View.Source, Declaration,
                        Declarationˉposition.Line, Declarationˉposition.Column
                    );
                }
                if Declaration.Kind == Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Constant {
                    Result = Compilerˉsourceˉsymbolsˉvalidateˉconstant(
                        Input, Scan, Counts, Module, View.Source, Declaration,
                        Declarationˉposition.Line, Declarationˉposition.Column
                    );
                }
                if Result.Status != Compilerˉsourceˉsymbolˉstatus.Valid { return Result; }
                if Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉclosesˉimports(Declaration) {
                    Sawˉnonˉimport = true;
                }
                Cursor = Declaration.Nextˉoffset;
                Currentˉline = Declaration.Nextˉline;
                Currentˉcolumn = Declaration.Nextˉcolumn;
            }
        }
        Module = Module + 1u32;
    }
    return Counts;
}

export fn Compilerˉvalidateˉsourceˉsymbols(Input: bytes) -> Compilerˉsourceˉsymbolˉsummary {
    let Graph: Sourceˉgraph.Compilerˉsourceˉgraphˉsummary = Sourceˉgraph.Compilerˉvalidateˉsourceˉgraph(Input);
    if Graph.Status != Sourceˉgraph.Compilerˉsourceˉgraphˉstatus.Valid {
        return Compilerˉsourceˉsymbolsˉsummaryˉfailure(
            Input,
            Compilerˉsourceˉsymbolˉstatus.Sourceˉgraph,
            Graph.Status,
            Graph.Modules,
            0u32,
            0u32,
            0u32,
            0u32,
            0u32,
            0u32,
            0u32,
            0u32,
            0u32,
            0u32,
            Graph.Failureˉmodule,
            Graph.Failureˉtarget,
            Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.End,
            Graph.Failureˉoffset,
            Graph.Failureˉline,
            Graph.Failureˉcolumn
        );
    }
    let Scan: Sourceˉset.Compilerˉsourceˉsetˉscan = Sourceˉset.Compilerˉscanˉsourceˉset(Input);
    let Counts: Compilerˉsourceˉsymbolˉsummary = Compilerˉsourceˉsymbolsˉcount(Input, Scan);
    if Counts.Status != Compilerˉsourceˉsymbolˉstatus.Valid { return Counts; }
    let Directory: bytes = Counts.Directory;
    let Entries: u32 = Bytesˉreadˉu32ˉlittle(Directory, 8u32);
    if !Compilerˉsourceˉsymbolsˉdirectoryˉshapeˉisˉvalid(Directory, Entries) {
        return Compilerˉsourceˉsymbolsˉfailureˉfromˉsummary(
            Input,
            Counts,
            Compilerˉsourceˉsymbolˉstatus.Invalidˉdirectory,
            Scan.Modules,
            Scan.Modules,
            Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.End,
            Bytesˉlength(Input),
            0u32,
            0u32
        );
    }
    let Lookup: bytes = Compilerˉsourceˉsymbolsˉlookup(Input, Scan, Directory);
    let Indexedˉcounts: Compilerˉsourceˉsymbolˉsummary = Compilerˉsourceˉsymbolsˉsummaryˉsuccess(
        Input,
        Counts.Modules,
        Counts.Capabilities,
        Counts.Data,
        Counts.Records,
        Counts.Enums,
        Counts.Variants,
        Counts.Functions,
        Counts.Fields,
        Counts.Members,
        Counts.Cases,
        Counts.Parameters,
        Directory,
        Compilerˉsourceˉsymbolsˉempty(Input),
        Lookup
    );
    let Namespaces: Compilerˉsourceˉsymbolˉsummary = Compilerˉsourceˉsymbolsˉvalidateˉnamespaces(
        Input,
        Scan,
        Directory,
        Indexedˉcounts
    );
    if Namespaces.Status != Compilerˉsourceˉsymbolˉstatus.Valid { return Namespaces; }
    let Visibility: bytes = Compilerˉsourceˉsymbolsˉvisibility(Input, Scan);
    let Preparedˉcounts: Compilerˉsourceˉsymbolˉsummary = Compilerˉsourceˉsymbolsˉsummaryˉsuccess(
        Input,
        Counts.Modules,
        Counts.Capabilities,
        Counts.Data,
        Counts.Records,
        Counts.Enums,
        Counts.Variants,
        Counts.Functions,
        Counts.Fields,
        Counts.Members,
        Counts.Cases,
        Counts.Parameters,
        Directory,
        Visibility,
        Lookup
    );
    let Declarations: Compilerˉsourceˉsymbolˉsummary = Compilerˉsourceˉsymbolsˉvalidateˉdeclarations(
        Input,
        Scan,
        Directory,
        Visibility,
        Preparedˉcounts
    );
    if Declarations.Status != Compilerˉsourceˉsymbolˉstatus.Valid { return Declarations; }
    return Compilerˉsourceˉsymbolsˉsummaryˉsuccess(
        Input,
        Counts.Modules,
        Counts.Capabilities,
        Counts.Data,
        Counts.Records,
        Counts.Enums,
        Counts.Variants,
        Counts.Functions,
        Counts.Fields,
        Counts.Members,
        Counts.Cases,
        Counts.Parameters,
        Directory,
        Visibility,
        Lookup
    );
}
