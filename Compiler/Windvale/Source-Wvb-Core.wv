    if Operation == 72u32 { return 158u8; }
    if Operation == 73u32 { return 159u8; }
    if Operation == 74u32 { return 160u8; }
    if Operation == 75u32 { return 161u8; }
    if Operation == 76u32 { return 162u8; }
    if Operation == 77u32 { return 167u8; }
    if Operation == 78u32 { return 168u8; }
