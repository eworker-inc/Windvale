    return Compilerˉsourceˉwvbˉsymbolˉorder(
        Orders.Functionˉentries, Orders.Functionˉranks
    );
}

export fn Compilerˉsourceˉwvbˉreachableˉfunctionˉorder(
    Input: bytes,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Order: Compilerˉsourceˉwvbˉsymbolˉorder,
    Reachability: Compilerˉsourceˉwvbˉreachability
) -> Compilerˉsourceˉwvbˉsymbolˉorder {
    var Retainedˉentries: bytes = Compilerˉsourceˉwvbˉempty(Input);
    var Fullˉrank: u32 = 0u32;
    let Fullˉfunctions: u32 = Bytesˉlength(Order.Entries) / 4u32;
    while Fullˉrank < Fullˉfunctions {
        let Candidate: u32 = Compilerˉsourceˉwvbˉorderedˉsymbol(
            Order, Fullˉrank
        );
        if Bytesˉreadˉu8(Reachability.Map, Candidate) == 1u8 {
            Retainedˉentries = Bytesˉconcat(
                Retainedˉentries, Bytesˉfromˉu32ˉlittle(Candidate)
            );
        }
        Fullˉrank = Fullˉrank + 1u32;
    }
    let Emptyˉranks: Byteˉconstruction.Foundationˉbytesˉresult =
        Byteˉconstruction.Foundationˉbytesˉrepeat(
            0u8, Bytesˉlength(Reachability.Map) * 4u32
        );
    var Retainedˉranks: bytes = Emptyˉranks.Value;
    var Retainedˉrank: u32 = 0u32;
    while Retainedˉrank < Reachability.Reachable {
        let Retained: u32 = Bytesˉreadˉu32ˉlittle(
            Retainedˉentries, Retainedˉrank * 4u32
        );
        let Ranked: Byteˉconstruction.Foundationˉbytesˉresult =
            Byteˉconstruction.Foundationˉbytesˉreplace(
                Retainedˉranks,
                Retained * 4u32,
                4u32,
                Bytesˉfromˉu32ˉlittle(Retainedˉrank)
            );
        Retainedˉranks = Ranked.Value;
        Retainedˉrank = Retainedˉrank + 1u32;
    }
    return Compilerˉsourceˉwvbˉsymbolˉorder(
        Retainedˉentries, Retainedˉranks
    );
}

export fn Compilerˉsourceˉwvbˉwithˉfunctionˉorder(
    Orders: Compilerˉsourceˉwvbˉsymbolˉorders,
    Functions: Compilerˉsourceˉwvbˉsymbolˉorder
) -> Compilerˉsourceˉwvbˉsymbolˉorders {
    return Compilerˉsourceˉwvbˉsymbolˉorders(
        Orders.Capabilityˉentries,
        Orders.Capabilityˉranks,
        Orders.Dataˉentries,
        Orders.Dataˉranks,
        Orders.Recordˉentries,
        Orders.Recordˉranks,
        Orders.Enumˉentries,
        Orders.Enumˉranks,
        Orders.Variantˉentries,
        Orders.Variantˉranks,
        Functions.Entries,
        Functions.Ranks,
        Orders.Recordˉtargets,
        Orders.Variantˉtargets,
        Orders.Concreteˉrecords,
        Orders.Concreteˉvariants,
        Orders.Genericˉrecords,
        Orders.Genericˉnominalˉentries,
        Orders.Genericˉnominals,
        Orders.Genericˉfields, Orders.Genericˉtypeˉevidence, Orders.Genericˉtypeˉentries,
        Orders.Builderˉownedˉshapes, Orders.Ownershipˉconstructors
    );
}

export fn Compilerˉsourceˉwvbˉreachableˉdataˉorder(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Functions: Compilerˉsourceˉwvbˉsymbolˉorder,
    Functionˉcount: u32,
    Data: Compilerˉsourceˉwvbˉsymbolˉorder,
    Bindingˉdirectory: bytes,
    Wir: bytes
) -> Compilerˉsourceˉwvbˉsymbolˉorder {
    let Entries: u32 = Bytesˉreadˉu32ˉlittle(Symbols.Directory, 8u32);
    let Emptyˉmap: Byteˉconstruction.Foundationˉbytesˉresult =
        Byteˉconstruction.Foundationˉbytesˉrepeat(0u8, Entries);
    var Dataˉmap: bytes = Emptyˉmap.Value;
    let Operationsˉoffset: u32 = Compilerˉsourceˉwvbˉoperationsˉoffset(Wir);
    var Functionˉrank: u32 = 0u32;
    while Functionˉrank < Functionˉcount {
        let Function: u32 = Compilerˉsourceˉwvbˉorderedˉsymbol(
            Functions, Functionˉrank
        );
        let Functionˉdeclaration: u32 =
            Compilerˉsourceˉwvbˉfunctionˉdeclaration(
                Symbols, Bindingˉdirectory, Function
            );
        let Functionˉview: Sourceˉset.Compilerˉsourceˉsetˉview =
            Compilerˉsourceˉwvbˉsymbolˉsource(
                Input, Scan, Symbols, Functionˉdeclaration
            );
        let Functionˉentry: u32 =
            Sourceˉwir.Compilerˉsourceˉwirˉfunctionsˉoffset(Wir) +
                Function * 48u32;
        let Firstˉoperation: u32 = Bytesˉreadˉu32ˉlittle(
            Wir, Functionˉentry + 12u32
        );
        let Operationˉcount: u32 = Bytesˉreadˉu32ˉlittle(
            Wir, Functionˉentry + 16u32
        );
        var Inˉfunction: u32 = 0u32;
        while Inˉfunction < Operationˉcount {
            let Operationˉentry: u32 = Operationsˉoffset +
                (Firstˉoperation + Inˉfunction) * 28u32;
            let Operation: u32 = Bytesˉreadˉu16ˉlittle(
                Wir, Operationˉentry + 4u32
            );
            let Target: u32 = Bytesˉreadˉu32ˉlittle(
                Wir, Operationˉentry + 20u32
            );
            var Referenced: u32 = Sourceˉwir.Compilerˉsourceˉwirˉsentinel();
            if Operation == 6u32 || Operation == 9u32 || Operation == 10u32 {
                Referenced = Target;
            }
            if Operation == 5u32 {
                let Textˉlength: u32 = Bytesˉreadˉu32ˉlittle(
                    Wir, Operationˉentry + 24u32
                );
                if Textˉlength == 0u32 {
                    Referenced = Target;
                } else {
                    let Textˉvalue: Compilerˉsourceˉwvbˉtextˉvalue =
                        Compilerˉsourceˉwvbˉdecodeˉtext(
                            Functionˉview.Source, Target, Textˉlength
                        );
                    Referenced = Compilerˉsourceˉwvbˉexplicitˉtextˉentry(
                        Input, Scan, Symbols, Textˉvalue.Value
                    );
                }
            }
            if Referenced != Sourceˉwir.Compilerˉsourceˉwirˉsentinel() {
                if Bytesˉreadˉu8(Dataˉmap, Referenced) == 0u8 {
                    let Marked: Byteˉconstruction.Foundationˉbytesˉresult =
                        Byteˉconstruction.Foundationˉbytesˉreplace(
                            Dataˉmap, Referenced,
                            1u32, Bytesˉfromˉu8(1u8)
                        );
                    Dataˉmap = Marked.Value;
                }
            }
            Inˉfunction = Inˉfunction + 1u32;
        }
        Functionˉrank = Functionˉrank + 1u32;
    }

    var Retainedˉentries: bytes = Compilerˉsourceˉwvbˉempty(Input);
    var Dataˉrank: u32 = 0u32;
    while Dataˉrank < Symbols.Data {
        let Candidate: u32 = Compilerˉsourceˉwvbˉorderedˉsymbol(
            Data, Dataˉrank
        );
        if Bytesˉreadˉu8(Dataˉmap, Candidate) == 1u8 {
            Retainedˉentries = Bytesˉconcat(
                Retainedˉentries, Bytesˉfromˉu32ˉlittle(Candidate)
            );
        }
        Dataˉrank = Dataˉrank + 1u32;
    }
    let Emptyˉranks: Byteˉconstruction.Foundationˉbytesˉresult =
        Byteˉconstruction.Foundationˉbytesˉrepeat(0u8, Entries * 4u32);
    var Retainedˉranks: bytes = Emptyˉranks.Value;
    var Retainedˉrank: u32 = 0u32;
    while Retainedˉrank * 4u32 < Bytesˉlength(Retainedˉentries) {
        let Retained: u32 = Bytesˉreadˉu32ˉlittle(
            Retainedˉentries, Retainedˉrank * 4u32
        );
        let Ranked: Byteˉconstruction.Foundationˉbytesˉresult =
            Byteˉconstruction.Foundationˉbytesˉreplace(
                Retainedˉranks,
                Retained * 4u32,
                4u32,
                Bytesˉfromˉu32ˉlittle(Retainedˉrank)
            );
        Retainedˉranks = Ranked.Value;
        Retainedˉrank = Retainedˉrank + 1u32;
    }
    return Compilerˉsourceˉwvbˉsymbolˉorder(
        Retainedˉentries, Retainedˉranks
    );
}

export fn Compilerˉsourceˉwvbˉwithˉdataˉorder(
    Orders: Compilerˉsourceˉwvbˉsymbolˉorders,
    Data: Compilerˉsourceˉwvbˉsymbolˉorder
) -> Compilerˉsourceˉwvbˉsymbolˉorders {
    return Compilerˉsourceˉwvbˉsymbolˉorders(
        Orders.Capabilityˉentries,
        Orders.Capabilityˉranks,
        Data.Entries,
        Data.Ranks,
        Orders.Recordˉentries,
        Orders.Recordˉranks,
        Orders.Enumˉentries,
        Orders.Enumˉranks,
        Orders.Variantˉentries,
        Orders.Variantˉranks,
        Orders.Functionˉentries,
        Orders.Functionˉranks,
        Orders.Recordˉtargets,
        Orders.Variantˉtargets,
        Orders.Concreteˉrecords,
        Orders.Concreteˉvariants,
        Orders.Genericˉrecords,
        Orders.Genericˉnominalˉentries,
        Orders.Genericˉnominals,
        Orders.Genericˉfields, Orders.Genericˉtypeˉevidence, Orders.Genericˉtypeˉentries,
        Orders.Builderˉownedˉshapes, Orders.Ownershipˉconstructors
    );
}

export fn Compilerˉsourceˉwvbˉorderedˉsymbol(
    Order: Compilerˉsourceˉwvbˉsymbolˉorder,
    Rank: u32
) -> u32 {
    return Bytesˉreadˉu32ˉlittle(Order.Entries, Rank * 4u32);
}

export fn Compilerˉsourceˉwvbˉorderedˉrank(
    Order: Compilerˉsourceˉwvbˉsymbolˉorder,
    Entry: u32
) -> u32 {
    return Bytesˉreadˉu32ˉlittle(Order.Ranks, Entry * 4u32);
}

fn Compilerˉsourceˉwvbˉplannedˉnominalˉtarget(
    Target: u32,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Orders: Compilerˉsourceˉwvbˉsymbolˉorders
) -> u32 {
    if Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉshapeˉisˉprivate(Target) {
        let Entry: u32 = Compilerˉsourceˉwvbˉgenericˉnominalˉentry(
            Target, Orders
        );
        if Entry == 4294967295u32 { return Entry; }
        return Bytesˉreadˉu32ˉlittle(
            Orders.Genericˉnominalˉentries, Entry + 4u32
        );
    }
    if Target < Symbols.Records {
        return Bytesˉreadˉu32ˉlittle(
            Orders.Recordˉtargets, Target * 4u32
        );
    }
    if Target < Symbols.Records + Symbols.Enums {
        return Orders.Concreteˉrecords + Orders.Genericˉrecords +
            Target - Symbols.Records;
    }
    if Target < Symbols.Records + Symbols.Enums + Symbols.Variants {
        let Variantˉtarget: u32 = Bytesˉreadˉu32ˉlittle(
            Orders.Variantˉtargets,
            (Target - Symbols.Records - Symbols.Enums) * 4u32
        );
        if Variantˉtarget == 4294967295u32 { return Variantˉtarget; }
        return Variantˉtarget + Orders.Genericˉrecords;
    }
    return 4294967295u32;
}

fn Compilerˉsourceˉwvbˉgenericˉnominalˉentry(
    Shape: u32,
    Orders: Compilerˉsourceˉwvbˉsymbolˉorders
) -> u32 {
    if !Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉshapeˉisˉprivate(Shape) {
        return 4294967295u32;
    }
    let Instance: u32 =
        Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉshapeˉinstance(Shape);
    if Instance >= Orders.Genericˉnominals ||
        Bytesˉlength(Orders.Genericˉnominalˉentries) !=
            Orders.Genericˉnominals * 36u32 {
        return 4294967295u32;
    }
    let Entry: u32 = Instance * 36u32;
    if Bytesˉreadˉu32ˉlittle(
            Orders.Genericˉnominalˉentries, Entry
        ) != Shape {
        return 4294967295u32;
    }
    return Entry;
}

fn Compilerˉsourceˉwvbˉplannedˉshapeˉvalue(
    Shape: u32,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Orders: Compilerˉsourceˉwvbˉsymbolˉorders
) -> u32 {
    if Shape == 805306368u32 || Shape == 805306369u32 || Shape == 805306370u32 { return Shape; }
    if Compilerˉsourceˉwvbˉshapeˉisˉborrowedˉoption(Shape) {
        return Compilerˉsourceˉwvbˉplannedˉshapeˉvalue(
            Compilerˉsourceˉwvbˉborrowedˉoptionˉvalueˉshape(
                Shape
            ),
            Symbols,
            Orders
        );
    }
    if Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉshapeˉisˉprivate(Shape) {
        let Entry: u32 = Compilerˉsourceˉwvbˉgenericˉnominalˉentry(
            Shape, Orders
        );
        if Entry == 4294967295u32 { return Entry; }
        let Genericˉtarget: u32 = Bytesˉreadˉu32ˉlittle(
            Orders.Genericˉnominalˉentries, Entry + 4u32
        );
        let Kind: u32 = Bytesˉreadˉu32ˉlittle(
            Orders.Genericˉnominalˉentries, Entry + 8u32
        );
        if Kind == 4u32 { return 65536u32 + Genericˉtarget; }
        if Kind == 8u32 { return 196608u32 + Genericˉtarget; }
        if Kind == 10u32 { return 262144u32 + Genericˉtarget; }
        if Kind == 11u32 { return 327680u32 + Genericˉtarget; }
        if Kind == 12u32 { return 393216u32 + Genericˉtarget; }
        if Kind == 13u32 { return Shape; }
        return 4294967295u32;
    }
    if Shape >= 65536u32 && Shape < 131072u32 {
        let Recordˉtarget: u32 =
            Compilerˉsourceˉwvbˉplannedˉnominalˉtarget(
            Shape - 65536u32, Symbols, Orders
        );
        if Recordˉtarget == 4294967295u32 { return Recordˉtarget; }
        return 65536u32 + Recordˉtarget;
    }
    if Shape >= 131072u32 && Shape < 196608u32 {
        let Enumˉtarget: u32 =
            Compilerˉsourceˉwvbˉplannedˉnominalˉtarget(
            Shape - 131072u32, Symbols, Orders
        );
        if Enumˉtarget == 4294967295u32 { return Enumˉtarget; }
        return 131072u32 + Enumˉtarget;
    }
    if Shape >= 196608u32 && Shape < 262144u32 {
        let Variantˉtarget: u32 =
            Compilerˉsourceˉwvbˉplannedˉnominalˉtarget(
            Shape - 196608u32, Symbols, Orders
        );
        if Variantˉtarget == 4294967295u32 { return Variantˉtarget; }
        return 196608u32 + Variantˉtarget;
    }
    return Shape;
}

fn Compilerˉsourceˉwvbˉshapeˉisˉbyteˉslice(
    Shape: u32,
    Orders: Compilerˉsourceˉwvbˉsymbolˉorders
) -> bool {
    let Entry: u32 = Compilerˉsourceˉwvbˉgenericˉnominalˉentry(Shape, Orders);
    if Entry == 4294967295u32 || Bytesˉreadˉu32ˉlittle(Orders.Genericˉnominalˉentries, Entry + 8u32) != 13u32 {
        return false;
    }
    let Catalog: Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog =
        Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog(Sourceˉgenerics.Compilerˉsourceˉgenericˉstatus.Valid, Orders.Genericˉtypeˉevidence);
    let Element: Sourceˉgenerics.Compilerˉsourceˉgenericˉargument =
        Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalogˉargument(
            Catalog, Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉshapeˉinstance(Shape), 0u32
        );
    return Element.Valid && Element.Kind == 1u32 && Element.Shape == 0u32 &&
        Element.High == 0u32 && Element.Low == 2u32;
}

fn Compilerˉsourceˉwvbˉplannedˉshape(
    Shape: u32,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Orders: Compilerˉsourceˉwvbˉsymbolˉorders
) -> bytes {
    if Compilerˉsourceˉwvbˉshapeˉisˉbyteˉslice(Shape, Orders) {
        return Bytesˉconcat(Bytesˉfromˉu8(40u8), Bytesˉfromˉu8(4u8));
    }
    if Compilerˉsourceˉwvbˉfunctionˉtypeˉshapeˉisˉprivate(Shape) {
        let Nominalˉtypes: u32 = Orders.Concreteˉrecords +
            Symbols.Enums + Orders.Concreteˉvariants +
            Orders.Genericˉtypeˉentries;
        return Bytesˉconcat(
            Bytesˉfromˉu8(35u8),
            Bytesˉfromˉu32ˉlittle(
                Nominalˉtypes +
                    Compilerˉsourceˉwvbˉfunctionˉtypeˉshapeˉinstance(
                        Shape
                    )
            )
        );
    }
    if Sourceˉwir.Compilerˉsourceˉwirˉshapeˉisˉsequence(Shape) ||
        Sourceˉwir.Compilerˉsourceˉwirˉshapeˉisˉbuilder(Shape) {
        var Kind: u8 = 12u8;
        if Sourceˉwir.Compilerˉsourceˉwirˉshapeˉisˉbuilder(Shape) {
            Kind = 13u8;
        }
        var Result: bytes = Bytesˉfromˉu8(Kind);
        Result = Bytesˉconcat(
            Result,
            Compilerˉsourceˉwvbˉplannedˉshape(
                Sourceˉwir.Compilerˉsourceˉwirˉcollectionˉelementˉshape(Shape),
                Symbols, Orders
            )
        );
        return Bytesˉconcat(
            Result,
            Bytesˉfromˉu32ˉlittle(
                Sourceˉwir.Compilerˉsourceˉwirˉcollectionˉmaximum(Shape)
            )
        );
    }
    let Planned: u32 = Compilerˉsourceˉwvbˉplannedˉshapeˉvalue(
        Shape, Symbols, Orders
    );
    if Planned >= 262144u32 && Planned < 327680u32 {
        return Bytesˉconcat(
            Bytesˉfromˉu8(22u8),
            Bytesˉfromˉu32ˉlittle(Planned - 262144u32)
        );
    }
    if Planned >= 327680u32 && Planned < 393216u32 {
        return Bytesˉconcat(
            Bytesˉfromˉu8(23u8),
            Bytesˉfromˉu32ˉlittle(Planned - 327680u32)
        );
    }
    if Planned >= 393216u32 && Planned < 458752u32 {
        return Bytesˉconcat(
            Bytesˉfromˉu8(24u8),
            Bytesˉfromˉu32ˉlittle(Planned - 393216u32)
        );
    }
    return Compilerˉsourceˉwvbˉshape(
        Planned
    );
}

fn Compilerˉsourceˉwvbˉplannedˉvariantˉtarget(
    Target: u32,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Orders: Compilerˉsourceˉwvbˉsymbolˉorders
) -> u32 {
    if Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉshapeˉisˉprivate(Target) {
        let Entry: u32 = Compilerˉsourceˉwvbˉgenericˉnominalˉentry(
            Target, Orders
        );
        if Entry == 4294967295u32 || Bytesˉreadˉu32ˉlittle(
                Orders.Genericˉnominalˉentries, Entry + 8u32
            ) != 8u32 {
            return 4294967295u32;
        }
        return Bytesˉreadˉu32ˉlittle(
            Orders.Genericˉnominalˉentries, Entry + 4u32
        );
    }
    return Compilerˉsourceˉwvbˉplannedˉnominalˉtarget(
        Target, Symbols, Orders
    );
}

export fn Compilerˉsourceˉwvbˉdeclaration(
    Source: bytes,
    Header: Sourceˉdeclarations.Compilerˉsourceˉheader,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Entry: u32
) -> Sourceˉdeclarations.Compilerˉsourceˉdeclaration {
    let Entryˉoffset: u32 = 16u32 + Entry * 24u32;
    let Declarationˉoffset: u32 = Bytesˉreadˉu32ˉlittle(
        Symbols.Directory, Entryˉoffset + 8u32
    );
    return Sourceˉdeclarations.Compilerˉparseˉnextˉdeclarationˉvalidated(
        Source, Declarationˉoffset, 1u32, 1u32, true
    );
}

export fn Compilerˉsourceˉwvbˉdataˉtype(
    Source: bytes,
    Declaration: Sourceˉdeclarations.Compilerˉsourceˉdeclaration
) -> Sourceˉdeclarations.Compilerˉsourceˉtypeˉkind {
    let Name: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
        Source, Declaration.Nameˉoffset, 1u32, 1u32
    );
    let Colon: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
        Source, Name.Nextˉoffset, Name.Nextˉline, Name.Nextˉcolumn
    );
    let Type: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
        Source, Colon.Nextˉoffset, Colon.Nextˉline, Colon.Nextˉcolumn
    );
    if Type.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Text {
        return Sourceˉdeclarations.Compilerˉsourceˉtypeˉkind.Text;
    }
    if Type.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Bytes {
        return Sourceˉdeclarations.Compilerˉsourceˉtypeˉkind.Bytes;
    }
    return Sourceˉdeclarations.Compilerˉsourceˉtypeˉkind.I32ˉarray;
}

export fn Compilerˉsourceˉwvbˉlowˉbyte(Value: u32) -> bytes {
    return Bytesˉslice(Bytesˉfromˉu32ˉlittle(Value), 0u32, 1u32);
}

export fn Compilerˉsourceˉwvbˉutf8(Codeˉpoint: u32) -> bytes {
    if Codeˉpoint <= 127u32 {
        return Compilerˉsourceˉwvbˉlowˉbyte(Codeˉpoint);
    }
    let Firstˉquotient: u32 = Codeˉpoint / 64u32;
    let Firstˉremainder: u32 = Codeˉpoint % 64u32;
    if Codeˉpoint <= 2047u32 {
        return Bytesˉconcat(
            Compilerˉsourceˉwvbˉlowˉbyte(192u32 + Firstˉquotient),
            Compilerˉsourceˉwvbˉlowˉbyte(128u32 + Firstˉremainder)
        );
    }
    let Secondˉquotient: u32 = Firstˉquotient / 64u32;
    let Secondˉremainder: u32 = Firstˉquotient % 64u32;
    if Codeˉpoint <= 65535u32 {
        var Threeˉbyteˉresult: bytes = Compilerˉsourceˉwvbˉlowˉbyte(
            224u32 + Secondˉquotient
        );
        Threeˉbyteˉresult = Bytesˉconcat(
            Threeˉbyteˉresult,
            Compilerˉsourceˉwvbˉlowˉbyte(128u32 + Secondˉremainder)
        );
        return Bytesˉconcat(
            Threeˉbyteˉresult,
            Compilerˉsourceˉwvbˉlowˉbyte(128u32 + Firstˉremainder)
        );
    }
    let Thirdˉquotient: u32 = Secondˉquotient / 64u32;
    let Thirdˉremainder: u32 = Secondˉquotient % 64u32;
    var Fourˉbyteˉresult: bytes = Compilerˉsourceˉwvbˉlowˉbyte(
        240u32 + Thirdˉquotient
    );
    Fourˉbyteˉresult = Bytesˉconcat(
        Fourˉbyteˉresult,
        Compilerˉsourceˉwvbˉlowˉbyte(128u32 + Thirdˉremainder)
    );
    Fourˉbyteˉresult = Bytesˉconcat(
        Fourˉbyteˉresult,
        Compilerˉsourceˉwvbˉlowˉbyte(128u32 + Secondˉremainder)
    );
    return Bytesˉconcat(
        Fourˉbyteˉresult,
        Compilerˉsourceˉwvbˉlowˉbyte(128u32 + Firstˉremainder)
    );
}

export fn Compilerˉsourceˉwvbˉdecodeˉtext(
    Source: bytes,
    Offset: u32,
    Length: u32
) -> Compilerˉsourceˉwvbˉtextˉvalue {
    let Empty: bytes = Compilerˉsourceˉwvbˉempty(Source);
    if Length < 2u32 {
        return Compilerˉsourceˉwvbˉtextˉvalue(
            Compilerˉsourceˉwvbˉstatus.Invalidˉdata, Empty
        );
    }
    if Offset > Bytesˉlength(Source) {
        return Compilerˉsourceˉwvbˉtextˉvalue(
            Compilerˉsourceˉwvbˉstatus.Invalidˉdata, Empty
        );
    }
    if Length > Bytesˉlength(Source) - Offset {
        return Compilerˉsourceˉwvbˉtextˉvalue(
            Compilerˉsourceˉwvbˉstatus.Invalidˉdata, Empty
        );
    }
    if Bytesˉreadˉu8(Source, Offset) != 34u8 {
        return Compilerˉsourceˉwvbˉtextˉvalue(
            Compilerˉsourceˉwvbˉstatus.Invalidˉdata, Empty
        );
    }
    let End: u32 = Offset + Length - 1u32;
    if Bytesˉreadˉu8(Source, End) != 34u8 {
        return Compilerˉsourceˉwvbˉtextˉvalue(
            Compilerˉsourceˉwvbˉstatus.Invalidˉdata, Empty
        );
    }
    var Result: bytes = Empty;
    var Cursor: u32 = Offset + 1u32;
    var Segment: u32 = Cursor;
    while Cursor < End {
        if Bytesˉreadˉu8(Source, Cursor) == 92u8 {
            Result = Bytesˉconcat(
                Result, Bytesˉslice(Source, Segment, Cursor - Segment)
            );
            if Cursor + 1u32 >= End {
                return Compilerˉsourceˉwvbˉtextˉvalue(
                    Compilerˉsourceˉwvbˉstatus.Invalidˉdata, Empty
                );
            }
            let Escape: u8 = Bytesˉreadˉu8(Source, Cursor + 1u32);
            var Recognized: bool = false;
            if Escape == 34u8 { Result = Bytesˉconcat(Result, Compilerˉsourceˉwvbˉlowˉbyte(34u32)); Cursor = Cursor + 2u32; Recognized = true; }
            if Escape == 92u8 { Result = Bytesˉconcat(Result, Compilerˉsourceˉwvbˉlowˉbyte(92u32)); Cursor = Cursor + 2u32; Recognized = true; }
            if Escape == 110u8 { Result = Bytesˉconcat(Result, Compilerˉsourceˉwvbˉlowˉbyte(10u32)); Cursor = Cursor + 2u32; Recognized = true; }
            if Escape == 114u8 { Result = Bytesˉconcat(Result, Compilerˉsourceˉwvbˉlowˉbyte(13u32)); Cursor = Cursor + 2u32; Recognized = true; }
            if Escape == 116u8 { Result = Bytesˉconcat(Result, Compilerˉsourceˉwvbˉlowˉbyte(9u32)); Cursor = Cursor + 2u32; Recognized = true; }
            if Escape == 117u8 {
                Recognized = true;
                if Cursor + 6u32 > End {
                    return Compilerˉsourceˉwvbˉtextˉvalue(
                        Compilerˉsourceˉwvbˉstatus.Invalidˉdata, Empty
                    );
                }
                let H0: u32 = Sourceˉlexer.Compilerˉsourceˉhexˉdigit(Bytesˉreadˉu8(Source, Cursor + 2u32));
                let H1: u32 = Sourceˉlexer.Compilerˉsourceˉhexˉdigit(Bytesˉreadˉu8(Source, Cursor + 3u32));
                let H2: u32 = Sourceˉlexer.Compilerˉsourceˉhexˉdigit(Bytesˉreadˉu8(Source, Cursor + 4u32));
                let H3: u32 = Sourceˉlexer.Compilerˉsourceˉhexˉdigit(Bytesˉreadˉu8(Source, Cursor + 5u32));
                var Highˉdigitsˉvalid: bool = H0 <= 15u32;
                if H1 > 15u32 { Highˉdigitsˉvalid = false; }
                if H2 > 15u32 { Highˉdigitsˉvalid = false; }
                if H3 > 15u32 { Highˉdigitsˉvalid = false; }
                if !Highˉdigitsˉvalid {
                    return Compilerˉsourceˉwvbˉtextˉvalue(
                        Compilerˉsourceˉwvbˉstatus.Invalidˉdata, Empty
                    );
                }
                var Codeˉpoint: u32 = H0 * 4096u32 + H1 * 256u32 + H2 * 16u32 + H3;
                Cursor = Cursor + 6u32;
                if Codeˉpoint >= 55296u32 {
                    if Codeˉpoint <= 56319u32 {
                        if Cursor + 6u32 > End {
                            return Compilerˉsourceˉwvbˉtextˉvalue(
                                Compilerˉsourceˉwvbˉstatus.Invalidˉdata, Empty
                            );
                        }
                        let L0: u32 = Sourceˉlexer.Compilerˉsourceˉhexˉdigit(Bytesˉreadˉu8(Source, Cursor + 2u32));
                        let L1: u32 = Sourceˉlexer.Compilerˉsourceˉhexˉdigit(Bytesˉreadˉu8(Source, Cursor + 3u32));
                        let L2: u32 = Sourceˉlexer.Compilerˉsourceˉhexˉdigit(Bytesˉreadˉu8(Source, Cursor + 4u32));
                        let L3: u32 = Sourceˉlexer.Compilerˉsourceˉhexˉdigit(Bytesˉreadˉu8(Source, Cursor + 5u32));
                        var Lowˉdigitsˉvalid: bool = L0 <= 15u32;
                        if L1 > 15u32 { Lowˉdigitsˉvalid = false; }
                        if L2 > 15u32 { Lowˉdigitsˉvalid = false; }
                        if L3 > 15u32 { Lowˉdigitsˉvalid = false; }
                        if !Lowˉdigitsˉvalid {
                            return Compilerˉsourceˉwvbˉtextˉvalue(
                                Compilerˉsourceˉwvbˉstatus.Invalidˉdata, Empty
                            );
                        }
                        let Low: u32 = L0 * 4096u32 + L1 * 256u32 + L2 * 16u32 + L3;
                        if Bytesˉreadˉu8(Source, Cursor) != 92u8 {
                            return Compilerˉsourceˉwvbˉtextˉvalue(
                                Compilerˉsourceˉwvbˉstatus.Invalidˉdata, Empty
                            );
                        }
                        if Bytesˉreadˉu8(Source, Cursor + 1u32) != 117u8 {
                            return Compilerˉsourceˉwvbˉtextˉvalue(
                                Compilerˉsourceˉwvbˉstatus.Invalidˉdata, Empty
                            );
                        }
                        if Low < 56320u32 {
                            return Compilerˉsourceˉwvbˉtextˉvalue(
                                Compilerˉsourceˉwvbˉstatus.Invalidˉdata, Empty
                            );
                        }
                        if Low > 57343u32 {
                            return Compilerˉsourceˉwvbˉtextˉvalue(
                                Compilerˉsourceˉwvbˉstatus.Invalidˉdata, Empty
                            );
                        }
                        Codeˉpoint = 65536u32 +
                            (Codeˉpoint - 55296u32) * 1024u32 +
                            (Low - 56320u32);
                        Cursor = Cursor + 6u32;
                    }
                }
                if Codeˉpoint >= 56320u32 {
                    if Codeˉpoint <= 57343u32 {
                        return Compilerˉsourceˉwvbˉtextˉvalue(
                            Compilerˉsourceˉwvbˉstatus.Invalidˉdata, Empty
                        );
                    }
                }
                Result = Bytesˉconcat(Result, Compilerˉsourceˉwvbˉutf8(Codeˉpoint));
            }
            if !Recognized {
                return Compilerˉsourceˉwvbˉtextˉvalue(
                    Compilerˉsourceˉwvbˉstatus.Invalidˉdata, Empty
                );
            }
            Segment = Cursor;
        } else {
            Cursor = Cursor + 1u32;
        }
    }
    Result = Bytesˉconcat(Result, Bytesˉslice(Source, Segment, End - Segment));
    if Bytesˉlength(Result) > 1048576u32 {
        return Compilerˉsourceˉwvbˉtextˉvalue(
            Compilerˉsourceˉwvbˉstatus.Bytecodeˉlimit, Empty
        );
    }
    return Compilerˉsourceˉwvbˉtextˉvalue(
        Compilerˉsourceˉwvbˉstatus.Valid, Result
    );
}

export fn Compilerˉsourceˉwvbˉsyntheticˉname(Counter: u32) -> bytes {
    var Result: bytes = Textˉtoˉutf8("__Text_");
    Result = Bytesˉconcat(
        Result,
        Compilerˉsourceˉwvbˉlowˉbyte(
            48u32 + Counter / 100000u32 % 10u32
        )
    );
    Result = Bytesˉconcat(
        Result,
        Compilerˉsourceˉwvbˉlowˉbyte(
            48u32 + Counter / 10000u32 % 10u32
        )
    );
    Result = Bytesˉconcat(
        Result,
        Compilerˉsourceˉwvbˉlowˉbyte(
            48u32 + Counter / 1000u32 % 10u32
        )
    );
    Result = Bytesˉconcat(
        Result,
        Compilerˉsourceˉwvbˉlowˉbyte(
            48u32 + Counter / 100u32 % 10u32
        )
    );
    Result = Bytesˉconcat(
        Result,
        Compilerˉsourceˉwvbˉlowˉbyte(
            48u32 + Counter / 10u32 % 10u32
        )
    );
    return Bytesˉconcat(
        Result,
        Compilerˉsourceˉwvbˉlowˉbyte(48u32 + Counter % 10u32)
    );
}

export fn Compilerˉsourceˉwvbˉspecializationˉname(Counter: u32) -> bytes {
    let Textˉname: bytes = Compilerˉsourceˉwvbˉsyntheticˉname(Counter);
    return Bytesˉconcat(
        Textˉtoˉutf8("__Generic_"),
        Bytesˉslice(Textˉname, 7u32, 6u32)
    );
}

export fn Compilerˉsourceˉwvbˉdataˉnameˉexists(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Name: bytes
) -> bool {
    let Entries: u32 = Bytesˉreadˉu32ˉlittle(Symbols.Directory, 8u32);
    var Entry: u32 = 0u32;
    while Entry < Entries {
        let Entryˉoffset: u32 = 16u32 + Entry * 24u32;
        if Bytesˉreadˉu32ˉlittle(Symbols.Directory, Entryˉoffset + 4u32) == 3u32 {
            let Symbolˉname: bytes = Compilerˉsourceˉwvbˉsymbolˉname(
                Input, Scan, Symbols, Entry
            );
            if Sourceˉset.Compilerˉsourceˉspansˉequal(
                Symbolˉname, 0u32, Bytesˉlength(Symbolˉname),
                Name, 0u32, Bytesˉlength(Name)
            ) { return true; }
        }
        Entry = Entry + 1u32;
    }
    return false;
}

export fn Compilerˉsourceˉwvbˉexplicitˉtextˉentry(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Value: bytes
) -> u32 {
    let Entries: u32 = Bytesˉreadˉu32ˉlittle(Symbols.Directory, 8u32);
    var Entry: u32 = 0u32;
    while Entry < Entries {
        let Entryˉoffset: u32 = 16u32 + Entry * 24u32;
        if Bytesˉreadˉu32ˉlittle(Symbols.Directory, Entryˉoffset + 4u32) == 3u32 {
            let View: Sourceˉset.Compilerˉsourceˉsetˉview =
                Compilerˉsourceˉwvbˉsymbolˉsource(
                    Input, Scan, Symbols, Entry
                );
            let Header: Sourceˉdeclarations.Compilerˉsourceˉheader = Sourceˉdeclarations.Compilerˉparseˉheaderˉvalidated(
                View.Source
            );
            let Declaration: Sourceˉdeclarations.Compilerˉsourceˉdeclaration =
                Compilerˉsourceˉwvbˉdeclaration(
                    View.Source, Header, Symbols, Entry
                );
            if Compilerˉsourceˉwvbˉdataˉtype(
                View.Source, Declaration
            ) == Sourceˉdeclarations.Compilerˉsourceˉtypeˉkind.Text {
                let Decoded: Compilerˉsourceˉwvbˉtextˉvalue =
                    Compilerˉsourceˉwvbˉdecodeˉtext(
                        View.Source,
                        Declaration.Bodyˉoffset, Declaration.Bodyˉlength
                    );
                if Decoded.Status == Compilerˉsourceˉwvbˉstatus.Valid {
                    if Sourceˉset.Compilerˉsourceˉspansˉequal(
                        Decoded.Value, 0u32, Bytesˉlength(Decoded.Value),
                        Value, 0u32, Bytesˉlength(Value)
                    ) { return Entry; }
                }
            }
        }
        Entry = Entry + 1u32;
    }
    return Sourceˉwir.Compilerˉsourceˉwirˉsentinel();
}

export fn Compilerˉsourceˉwvbˉtextˉplanˉempty(
    Input: bytes
) -> Compilerˉsourceˉwvbˉtextˉplan {
    let Empty: bytes = Compilerˉsourceˉwvbˉempty(Input);
    return Compilerˉsourceˉwvbˉtextˉplan(
        Compilerˉsourceˉwvbˉstatus.Valid, 0u32, 0u32, Empty, Empty
    );
}

export fn Compilerˉsourceˉwvbˉtextˉplanˉfind(
    Plan: Compilerˉsourceˉwvbˉtextˉplan,
    Value: bytes
) -> u32 {
    var Index: u32 = 0u32;
    while Index < Plan.Count {
        let Entry: u32 = Index * 12u32;
        let Offset: u32 = Bytesˉreadˉu32ˉlittle(Plan.Directory, Entry + 4u32);
        let Length: u32 = Bytesˉreadˉu32ˉlittle(Plan.Directory, Entry + 8u32);
        if Sourceˉset.Compilerˉsourceˉspansˉequal(
            Plan.Values, Offset, Length,
            Value, 0u32, Bytesˉlength(Value)
        ) { return Index; }
        Index = Index + 1u32;
    }
    return Sourceˉwir.Compilerˉsourceˉwirˉsentinel();
}

export fn Compilerˉsourceˉwvbˉtextˉplanˉadd(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Plan: Compilerˉsourceˉwvbˉtextˉplan,
    Value: bytes
) -> Compilerˉsourceˉwvbˉtextˉplan {
    if Plan.Count + Symbols.Data >= 4096u32 {
        return Compilerˉsourceˉwvbˉtextˉplan(
            Compilerˉsourceˉwvbˉstatus.Bytecodeˉlimit,
            Plan.Count, Plan.Nextˉname, Plan.Directory, Plan.Values
        );
    }
    var Counter: u32 = Plan.Nextˉname;
    var Name: bytes = Compilerˉsourceˉwvbˉsyntheticˉname(Counter);
    while Compilerˉsourceˉwvbˉdataˉnameˉexists(
        Input, Scan, Symbols, Name
    ) {
        Counter = Counter + 1u32;
        if Counter > 999999u32 {
            return Compilerˉsourceˉwvbˉtextˉplan(
                Compilerˉsourceˉwvbˉstatus.Bytecodeˉlimit,
                Plan.Count, Counter, Plan.Directory, Plan.Values
            );
        }
        Name = Compilerˉsourceˉwvbˉsyntheticˉname(Counter);
    }
    var Entry: bytes = Bytesˉfromˉu32ˉlittle(Counter);
    Entry = Bytesˉconcat(
        Entry, Bytesˉfromˉu32ˉlittle(Bytesˉlength(Plan.Values))
    );
    Entry = Bytesˉconcat(
        Entry, Bytesˉfromˉu32ˉlittle(Bytesˉlength(Value))
    );
    return Compilerˉsourceˉwvbˉtextˉplan(
        Compilerˉsourceˉwvbˉstatus.Valid,
        Plan.Count + 1u32,
        Counter + 1u32,
        Bytesˉconcat(Plan.Directory, Entry),
        Bytesˉconcat(Plan.Values, Value)
    );
}

fn Compilerˉsourceˉwvbˉcollectˉtextˉplanˉmode(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Order: Compilerˉsourceˉwvbˉsymbolˉorder,
    Functions: u32,
    Bindingˉdirectory: bytes,
    Wir: bytes,
    Retainedˉmap: bytes,
    Filter: bool
) -> Compilerˉsourceˉwvbˉtextˉplan {
    var Plan: Compilerˉsourceˉwvbˉtextˉplan =
        Compilerˉsourceˉwvbˉtextˉplanˉempty(Input);
    let Operationsˉoffset: u32 = Compilerˉsourceˉwvbˉoperationsˉoffset(Wir);
    var Rank: u32 = 0u32;
    while Rank < Functions {
        let Function: u32 = Compilerˉsourceˉwvbˉorderedˉsymbol(Order, Rank);
        var Retain: bool = true;
        if Filter {
            Retain = Bytesˉreadˉu8(Retainedˉmap, Function) == 1u8;
        }
        let Functionˉdeclaration: u32 =
            Compilerˉsourceˉwvbˉfunctionˉdeclaration(
                Symbols, Bindingˉdirectory, Function
            );
        let View: Sourceˉset.Compilerˉsourceˉsetˉview =
            Compilerˉsourceˉwvbˉsymbolˉsource(
                Input, Scan, Symbols, Functionˉdeclaration
            );
        let Functionˉentry: u32 =
            Sourceˉwir.Compilerˉsourceˉwirˉfunctionsˉoffset(Wir) +
                Function * 48u32;
        let Firstˉoperation: u32 = Bytesˉreadˉu32ˉlittle(
            Wir, Functionˉentry + 12u32
        );
        let Operationˉcount: u32 = Bytesˉreadˉu32ˉlittle(
            Wir, Functionˉentry + 16u32
        );
        var Index: u32 = 0u32;
        while Index < Operationˉcount {
            let Operationˉentry: u32 = Operationsˉoffset +
                (Firstˉoperation + Index) * 28u32;
            if Bytesˉreadˉu16ˉlittle(Wir, Operationˉentry + 4u32) == 5u32 {
                let Length: u32 = Bytesˉreadˉu32ˉlittle(
                    Wir, Operationˉentry + 24u32
                );
                if Length != 0u32 {
                    let Offset: u32 = Bytesˉreadˉu32ˉlittle(
                        Wir, Operationˉentry + 20u32
                    );
                    let Decoded: Compilerˉsourceˉwvbˉtextˉvalue =
                        Compilerˉsourceˉwvbˉdecodeˉtext(
                            View.Source, Offset, Length
                        );
                    if Decoded.Status != Compilerˉsourceˉwvbˉstatus.Valid {
                        return Compilerˉsourceˉwvbˉtextˉplan(
                            Decoded.Status, Plan.Count, Plan.Nextˉname,
                            Plan.Directory, Plan.Values
                        );
                    }
                    if Retain {
                        let Explicit: u32 =
                            Compilerˉsourceˉwvbˉexplicitˉtextˉentry(
                                Input, Scan, Symbols, Decoded.Value
                            );
                        if Explicit ==
                            Sourceˉwir.Compilerˉsourceˉwirˉsentinel() {
                            if Compilerˉsourceˉwvbˉtextˉplanˉfind(
                                Plan, Decoded.Value
                            ) == Sourceˉwir.Compilerˉsourceˉwirˉsentinel() {
                                Plan = Compilerˉsourceˉwvbˉtextˉplanˉadd(
                                    Input, Scan, Symbols, Plan, Decoded.Value
                                );
                                if Plan.Status !=
                                    Compilerˉsourceˉwvbˉstatus.Valid {
                                    return Plan;
                                }
                            }
                        }
                    }
                }
            }
            Index = Index + 1u32;
        }
        Rank = Rank + 1u32;
    }
    return Plan;
}

export fn Compilerˉsourceˉwvbˉcollectˉtextˉplan(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Order: Compilerˉsourceˉwvbˉsymbolˉorder,
    Functions: u32,
    Wir: bytes
) -> Compilerˉsourceˉwvbˉtextˉplan {
    return Compilerˉsourceˉwvbˉcollectˉtextˉplanˉmode(
        Input, Scan, Symbols, Order, Functions,
        Compilerˉsourceˉwvbˉempty(Input), Wir,
        Compilerˉsourceˉwvbˉempty(Input), false
    );
}

export fn Compilerˉsourceˉwvbˉexplicitˉdataˉindex(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Plan: Compilerˉsourceˉwvbˉtextˉplan,
    Order: Compilerˉsourceˉwvbˉsymbolˉorder,
    Entry: u32
) -> u32 {
    var Result: u32 = Compilerˉsourceˉwvbˉorderedˉrank(Order, Entry);
    let Entryˉoffset: u32 = 16u32 + Entry * 24u32;
    let Nameˉoffset: u32 = Bytesˉreadˉu32ˉlittle(
        Symbols.Directory, Entryˉoffset + 12u32
    );
    let Nameˉlength: u32 = Bytesˉreadˉu32ˉlittle(
        Symbols.Directory, Entryˉoffset + 16u32
    );
    let View: Sourceˉset.Compilerˉsourceˉsetˉview = Compilerˉsourceˉwvbˉsymbolˉsource(
        Input, Scan, Symbols, Entry
    );
    let Symbolˉname: bytes = Compilerˉsourceˉwvbˉsymbolˉname(
        Input, Scan, Symbols, Entry
    );
    var Synthetic: u32 = 0u32;
    while Synthetic < Plan.Count {
        let Name: bytes = Compilerˉsourceˉwvbˉsyntheticˉname(
            Bytesˉreadˉu32ˉlittle(Plan.Directory, Synthetic * 12u32)
        );
        if Sourceˉset.Compilerˉsourceˉspansˉcompare(
            Name, 0u32, Bytesˉlength(Name),
            Symbolˉname, 0u32, Bytesˉlength(Symbolˉname)
        ) < 0 { Result = Result + 1u32; }
        Synthetic = Synthetic + 1u32;
    }
    return Result;
}

export fn Compilerˉsourceˉwvbˉsyntheticˉdataˉindex(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Plan: Compilerˉsourceˉwvbˉtextˉplan,
    Order: Compilerˉsourceˉwvbˉsymbolˉorder,
    Synthetic: u32
) -> u32 {
    let Name: bytes = Compilerˉsourceˉwvbˉsyntheticˉname(
        Bytesˉreadˉu32ˉlittle(Plan.Directory, Synthetic * 12u32)
    );
    var Result: u32 = Synthetic;
    let Explicitˉcount: u32 = Bytesˉlength(Order.Entries) / 4u32;
    var Rank: u32 = 0u32;
    while Rank < Explicitˉcount {
        let Entry: u32 = Compilerˉsourceˉwvbˉorderedˉsymbol(Order, Rank);
        let Entryˉoffset: u32 = 16u32 + Entry * 24u32;
        let Nameˉoffset: u32 = Bytesˉreadˉu32ˉlittle(
            Symbols.Directory, Entryˉoffset + 12u32
        );
        let Nameˉlength: u32 = Bytesˉreadˉu32ˉlittle(
            Symbols.Directory, Entryˉoffset + 16u32
        );
        let View: Sourceˉset.Compilerˉsourceˉsetˉview =
            Compilerˉsourceˉwvbˉsymbolˉsource(
                Input, Scan, Symbols, Entry
            );
        let Symbolˉname: bytes = Compilerˉsourceˉwvbˉsymbolˉname(
            Input, Scan, Symbols, Entry
        );
        if Sourceˉset.Compilerˉsourceˉspansˉcompare(
            Symbolˉname, 0u32, Bytesˉlength(Symbolˉname),
            Name, 0u32, Bytesˉlength(Name)
        ) < 0 { Result = Result + 1u32; }
        Rank = Rank + 1u32;
    }
    return Result;
}

export fn Compilerˉsourceˉwvbˉencodeˉexplicitˉdata(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Source: bytes,
    Header: Sourceˉdeclarations.Compilerˉsourceˉheader,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Entry: u32
) -> Compilerˉsourceˉwvbˉdataˉencoding {
    let Empty: bytes = Compilerˉsourceˉwvbˉempty(Source);
    let Declaration: Sourceˉdeclarations.Compilerˉsourceˉdeclaration =
        Compilerˉsourceˉwvbˉdeclaration(Source, Header, Symbols, Entry);
    let Type: Sourceˉdeclarations.Compilerˉsourceˉtypeˉkind = Compilerˉsourceˉwvbˉdataˉtype(
        Source, Declaration
    );
    var Payload: bytes = Compilerˉsourceˉwvbˉencodedˉstring(
        Compilerˉsourceˉwvbˉsymbolˉname(Input, Scan, Symbols, Entry)
    );
    if Type == Sourceˉdeclarations.Compilerˉsourceˉtypeˉkind.Text {
        let Decoded: Compilerˉsourceˉwvbˉtextˉvalue =
            Compilerˉsourceˉwvbˉdecodeˉtext(
                Source, Declaration.Bodyˉoffset, Declaration.Bodyˉlength
            );
        if Decoded.Status != Compilerˉsourceˉwvbˉstatus.Valid {
            return Compilerˉsourceˉwvbˉdataˉencoding(Decoded.Status, Empty);
        }
        Payload = Bytesˉconcat(Payload, Bytesˉfromˉu8(3u8));
        Payload = Bytesˉconcat(
            Payload, Bytesˉfromˉu32ˉlittle(Bytesˉlength(Decoded.Value))
        );
        return Compilerˉsourceˉwvbˉdataˉencoding(
            Compilerˉsourceˉwvbˉstatus.Valid,
            Bytesˉconcat(Payload, Decoded.Value)
        );
    }
    let Start: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
        Source, Declaration.Bodyˉoffset, 1u32, 1u32
    );
    var Cursor: u32 = Start.Nextˉoffset;
    var Line: u32 = Start.Nextˉline;
    var Column: u32 = Start.Nextˉcolumn;
    if Type == Sourceˉdeclarations.Compilerˉsourceˉtypeˉkind.I32ˉarray {
        Payload = Bytesˉconcat(Payload, Bytesˉfromˉu8(4u8));
        Payload = Bytesˉconcat(
            Payload, Bytesˉfromˉu32ˉlittle(Declaration.Items)
        );
        var Arrayˉindex: u32 = 0u32;
        while Arrayˉindex < Declaration.Items {
            var Arrayˉitem: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                Source, Cursor, Line, Column
            );
            var Negative: bool = false;
            if Arrayˉitem.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Minus {
                Negative = true;
                Arrayˉitem = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                    Source, Arrayˉitem.Nextˉoffset, Arrayˉitem.Nextˉline, Arrayˉitem.Nextˉcolumn
                );
            }
            var Arrayˉvalue: u32 = Arrayˉitem.Numericˉvalue;
            if Negative {
                if Arrayˉvalue != 0u32 {
                    Arrayˉvalue = 4294967295u32 - (Arrayˉvalue - 1u32);
                }
            }
            Payload = Bytesˉconcat(Payload, Bytesˉfromˉu32ˉlittle(Arrayˉvalue));
            let Arrayˉseparator: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                Source, Arrayˉitem.Nextˉoffset, Arrayˉitem.Nextˉline, Arrayˉitem.Nextˉcolumn
            );
            Cursor = Arrayˉseparator.Nextˉoffset;
            Line = Arrayˉseparator.Nextˉline;
            Column = Arrayˉseparator.Nextˉcolumn;
            Arrayˉindex = Arrayˉindex + 1u32;
        }
        return Compilerˉsourceˉwvbˉdataˉencoding(
            Compilerˉsourceˉwvbˉstatus.Valid, Payload
        );
    }
    Payload = Bytesˉconcat(Payload, Bytesˉfromˉu8(5u8));
    Payload = Bytesˉconcat(
        Payload, Bytesˉfromˉu32ˉlittle(Declaration.Items)
    );
    var Byteˉindex: u32 = 0u32;
    while Byteˉindex < Declaration.Items {
        let Byteˉitem: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Source, Cursor, Line, Column
        );
        Payload = Bytesˉconcat(
            Payload, Compilerˉsourceˉwvbˉlowˉbyte(Byteˉitem.Numericˉvalue)
        );
        let Byteˉseparator: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Source, Byteˉitem.Nextˉoffset, Byteˉitem.Nextˉline, Byteˉitem.Nextˉcolumn
        );
        Cursor = Byteˉseparator.Nextˉoffset;
        Line = Byteˉseparator.Nextˉline;
        Column = Byteˉseparator.Nextˉcolumn;
        Byteˉindex = Byteˉindex + 1u32;
    }
    return Compilerˉsourceˉwvbˉdataˉencoding(
        Compilerˉsourceˉwvbˉstatus.Valid, Payload
    );
}

export fn Compilerˉsourceˉwvbˉencodeˉsyntheticˉdata(
    Plan: Compilerˉsourceˉwvbˉtextˉplan,
    Synthetic: u32
) -> bytes {
    let Entry: u32 = Synthetic * 12u32;
    let Name: bytes = Compilerˉsourceˉwvbˉsyntheticˉname(
        Bytesˉreadˉu32ˉlittle(Plan.Directory, Entry)
    );
    let Offset: u32 = Bytesˉreadˉu32ˉlittle(Plan.Directory, Entry + 4u32);
    let Length: u32 = Bytesˉreadˉu32ˉlittle(Plan.Directory, Entry + 8u32);
    var Payload: bytes = Compilerˉsourceˉwvbˉstring(
        Name, 0u32, Bytesˉlength(Name)
    );
    Payload = Bytesˉconcat(Payload, Bytesˉfromˉu8(3u8));
    Payload = Bytesˉconcat(Payload, Bytesˉfromˉu32ˉlittle(Length));
    return Bytesˉconcat(Payload, Bytesˉslice(Plan.Values, Offset, Length));
}

export fn Compilerˉsourceˉwvbˉencodeˉdata(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Plan: Compilerˉsourceˉwvbˉtextˉplan,
    Order: Compilerˉsourceˉwvbˉsymbolˉorder
) -> Compilerˉsourceˉwvbˉdataˉencoding {
    let Explicitˉcount: u32 = Bytesˉlength(Order.Entries) / 4u32;
    var Payload: bytes = Bytesˉfromˉu32ˉlittle(Explicitˉcount + Plan.Count);
    var Explicit: u32 = 0u32;
    var Synthetic: u32 = 0u32;
    while Explicit < Explicitˉcount {
        var Useˉexplicit: bool = Synthetic >= Plan.Count;
        let Explicitˉentry: u32 = Compilerˉsourceˉwvbˉorderedˉsymbol(
            Order, Explicit
        );
        let View: Sourceˉset.Compilerˉsourceˉsetˉview = Compilerˉsourceˉwvbˉsymbolˉsource(
            Input, Scan, Symbols, Explicitˉentry
        );
        if Synthetic < Plan.Count {
            let Entryˉoffset: u32 = 16u32 + Explicitˉentry * 24u32;
            let Explicitˉnameˉoffset: u32 = Bytesˉreadˉu32ˉlittle(
                Symbols.Directory, Entryˉoffset + 12u32
            );
            let Explicitˉnameˉlength: u32 = Bytesˉreadˉu32ˉlittle(
                Symbols.Directory, Entryˉoffset + 16u32
            );
            let Syntheticˉname: bytes = Compilerˉsourceˉwvbˉsyntheticˉname(
                Bytesˉreadˉu32ˉlittle(Plan.Directory, Synthetic * 12u32)
            );
            let Explicitˉname: bytes = Compilerˉsourceˉwvbˉsymbolˉname(
                Input, Scan, Symbols, Explicitˉentry
            );
            if Sourceˉset.Compilerˉsourceˉspansˉcompare(
                Explicitˉname, 0u32, Bytesˉlength(Explicitˉname),
                Syntheticˉname, 0u32, Bytesˉlength(Syntheticˉname)
            ) < 0 { Useˉexplicit = true; }
        }
        if Useˉexplicit {
            let Header: Sourceˉdeclarations.Compilerˉsourceˉheader = Sourceˉdeclarations.Compilerˉparseˉheaderˉvalidated(
                View.Source
            );
            let Encoded: Compilerˉsourceˉwvbˉdataˉencoding =
                Compilerˉsourceˉwvbˉencodeˉexplicitˉdata(
                    Input, Scan, View.Source, Header, Symbols, Explicitˉentry
                );
            if Encoded.Status != Compilerˉsourceˉwvbˉstatus.Valid {
                return Encoded;
            }
            Payload = Bytesˉconcat(Payload, Encoded.Payload);
            Explicit = Explicit + 1u32;
        } else {
            Payload = Bytesˉconcat(
                Payload,
                Compilerˉsourceˉwvbˉencodeˉsyntheticˉdata(Plan, Synthetic)
            );
            Synthetic = Synthetic + 1u32;
        }
    }
    while Synthetic < Plan.Count {
        Payload = Bytesˉconcat(
            Payload,
            Compilerˉsourceˉwvbˉencodeˉsyntheticˉdata(Plan, Synthetic)
        );
        Synthetic = Synthetic + 1u32;
    }
    return Compilerˉsourceˉwvbˉdataˉencoding(
        Compilerˉsourceˉwvbˉstatus.Valid, Payload
    );
}

fn Compilerˉsourceˉwvbˉencodeˉdataˉvalidated(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Plan: Compilerˉsourceˉwvbˉtextˉplan,
    Validationˉorder: Compilerˉsourceˉwvbˉsymbolˉorder,
    Emissionˉorder: Compilerˉsourceˉwvbˉsymbolˉorder,
    Validateˉomitted: bool
) -> Compilerˉsourceˉwvbˉdataˉencoding {
    if Validateˉomitted {
        let Validationˉcount: u32 =
            Bytesˉlength(Validationˉorder.Entries) / 4u32;
        let Emissionˉcount: u32 =
            Bytesˉlength(Emissionˉorder.Entries) / 4u32;
        var Validationˉrank: u32 = 0u32;
        while Validationˉrank < Validationˉcount {
            let Entry: u32 = Compilerˉsourceˉwvbˉorderedˉsymbol(
                Validationˉorder, Validationˉrank
            );
            let Ranked: u32 = Compilerˉsourceˉwvbˉorderedˉrank(
                Emissionˉorder, Entry
            );
            var Retained: bool = false;
            if Ranked < Emissionˉcount {
                Retained = Compilerˉsourceˉwvbˉorderedˉsymbol(
                    Emissionˉorder, Ranked
                ) == Entry;
            }
            if !Retained {
                let View: Sourceˉset.Compilerˉsourceˉsetˉview =
                    Compilerˉsourceˉwvbˉsymbolˉsource(
                        Input, Scan, Symbols, Entry
                    );
                let Header: Sourceˉdeclarations.Compilerˉsourceˉheader =
                    Sourceˉdeclarations.Compilerˉparseˉheaderˉvalidated(
                        View.Source
                    );
                let Encoded: Compilerˉsourceˉwvbˉdataˉencoding =
                    Compilerˉsourceˉwvbˉencodeˉexplicitˉdata(
                        Input, Scan, View.Source, Header, Symbols, Entry
                    );
                if Encoded.Status != Compilerˉsourceˉwvbˉstatus.Valid {
                    return Encoded;
                }
            }
            Validationˉrank = Validationˉrank + 1u32;
        }
    }
    return Compilerˉsourceˉwvbˉencodeˉdata(
        Input, Scan, Symbols, Plan, Emissionˉorder
    );
}

export fn Compilerˉsourceˉwvbˉencodeˉrecordˉtype(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Source: bytes,
    Header: Sourceˉdeclarations.Compilerˉsourceˉheader,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Orders: Compilerˉsourceˉwvbˉsymbolˉorders,
    Entry: u32
) -> Compilerˉsourceˉwvbˉtypeˉencoding {
    let Empty: bytes = Compilerˉsourceˉwvbˉempty(Source);
    let Entryˉoffset: u32 = 16u32 + Entry * 24u32;
    let Owner: u32 = Bytesˉreadˉu32ˉlittle(Symbols.Directory, Entryˉoffset);
    let Declaration: Sourceˉdeclarations.Compilerˉsourceˉdeclaration = Compilerˉsourceˉwvbˉdeclaration(
        Source, Header, Symbols, Entry
    );
    var Payload: bytes = Bytesˉfromˉu8(1u8);
    var Features: u32 = 0u32;
    Payload = Bytesˉconcat(
        Payload,
        Compilerˉsourceˉwvbˉencodedˉstring(
            Compilerˉsourceˉwvbˉsymbolˉname(Input, Scan, Symbols, Entry)
        )
    );
    Payload = Bytesˉconcat(Payload, Bytesˉfromˉu32ˉlittle(Declaration.Items));
    let Brace: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
        Source, Declaration.Bodyˉoffset, 1u32, 1u32
    );
    var Cursor: u32 = Brace.Nextˉoffset;
    var Line: u32 = Brace.Nextˉline;
    var Column: u32 = Brace.Nextˉcolumn;
    var Fieldˉindex: u32 = 0u32;
    while Fieldˉindex < Declaration.Items {
        let Field: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Source, Cursor, Line, Column
        );
        let Colon: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Source, Field.Nextˉoffset, Field.Nextˉline, Field.Nextˉcolumn
        );
        let Binding: Sourceˉsymbols.Compilerˉsourceˉtypeˉbinding = Sourceˉsymbols.Compilerˉsourceˉsymbolsˉbindˉtype(
            Input, Scan, Symbols.Directory, Symbols.Lookup, Symbols.Visibility,
            Owner, Source,
            Colon.Nextˉoffset, Colon.Nextˉline, Colon.Nextˉcolumn,
            Symbols.Records, Symbols.Enums, true
        );
        if Binding.Status != Sourceˉsymbols.Compilerˉsourceˉsymbolˉstatus.Valid {
            return Compilerˉsourceˉwvbˉtypeˉencoding(
                Compilerˉsourceˉwvbˉstatus.Unsupportedˉshape, Empty, Features
            );
        }
        let Shape: u32 = Sourceˉbindings.Compilerˉsourceˉbindingsˉshape(Binding);
        if !Compilerˉsourceˉwvbˉshapeˉisˉsupported(
            Shape, false, Symbols, Orders
        ) {
            return Compilerˉsourceˉwvbˉtypeˉencoding(
                Compilerˉsourceˉwvbˉstatus.Unsupportedˉshape, Empty, Features
            );
        }
        Features = Features | Compilerˉsourceˉwvbˉshapeˉfeatures(Shape);
        Payload = Bytesˉconcat(
            Payload, Compilerˉsourceˉwvbˉstring(Source, Field.Offset, Field.Length)
        );
        Payload = Bytesˉconcat(
            Payload,
            Compilerˉsourceˉwvbˉplannedˉshape(Shape, Symbols, Orders)
        );
        let End: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Source, Binding.Nextˉoffset, Binding.Nextˉline, Binding.Nextˉcolumn
        );
        Cursor = End.Nextˉoffset;
        Line = End.Nextˉline;
        Column = End.Nextˉcolumn;
        Fieldˉindex = Fieldˉindex + 1u32;
    }
    return Compilerˉsourceˉwvbˉtypeˉencoding(
        Compilerˉsourceˉwvbˉstatus.Valid, Payload, Features
    );
}

export fn Compilerˉsourceˉwvbˉencodeˉenumˉtype(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Source: bytes,
    Header: Sourceˉdeclarations.Compilerˉsourceˉheader,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Entry: u32
) -> Compilerˉsourceˉwvbˉtypeˉencoding {
    let Declaration: Sourceˉdeclarations.Compilerˉsourceˉdeclaration = Compilerˉsourceˉwvbˉdeclaration(
        Source, Header, Symbols, Entry
    );
    let Name: Sourceˉlexer.Compilerˉsourceˉtoken =
        Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Source, Declaration.Nameˉoffset, 1u32, 1u32
        );
    let Afterˉname: Sourceˉlexer.Compilerˉsourceˉtoken =
        Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Source, Name.Nextˉoffset, Name.Nextˉline, Name.Nextˉcolumn
        );
    var Backingˉkind: Sourceˉdeclarations.Compilerˉsourceˉtypeˉkind =
        Sourceˉdeclarations.Compilerˉsourceˉtypeˉkind.I32;
    if Afterˉname.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Colon {
        let Backing: Sourceˉlexer.Compilerˉsourceˉtoken =
            Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                Source, Afterˉname.Nextˉoffset,
                Afterˉname.Nextˉline, Afterˉname.Nextˉcolumn
            );
        Backingˉkind = Sourceˉdeclarations.Compilerˉsourceˉtypeˉkindˉfromˉtoken(
            Backing.Kind
        );
    }
    if Backingˉkind != Sourceˉdeclarations.Compilerˉsourceˉtypeˉkind.I32 &&
        Backingˉkind != Sourceˉdeclarations.Compilerˉsourceˉtypeˉkind.U8 {
        return Compilerˉsourceˉwvbˉtypeˉencoding(
            Compilerˉsourceˉwvbˉstatus.Unsupportedˉshape,
            Compilerˉsourceˉwvbˉempty(Source), 0u32
        );
    }
    let U8ˉbacked: bool =
        Backingˉkind == Sourceˉdeclarations.Compilerˉsourceˉtypeˉkind.U8;
    var Payload: bytes = Bytesˉfromˉu8(2u8);
    var Features: u32 = 0u32;
    if U8ˉbacked {
        Payload = Bytesˉfromˉu8(7u8);
        Features = Features | 2048u32;
    }
    Payload = Bytesˉconcat(
        Payload,
        Compilerˉsourceˉwvbˉencodedˉstring(
            Compilerˉsourceˉwvbˉsymbolˉname(Input, Scan, Symbols, Entry)
        )
    );
    if U8ˉbacked {
        Payload = Bytesˉconcat(Payload, Bytesˉfromˉu8(6u8));
    }
    Payload = Bytesˉconcat(Payload, Bytesˉfromˉu32ˉlittle(Declaration.Items));
    let Brace: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
        Source, Declaration.Bodyˉoffset, 1u32, 1u32
    );
    var Cursor: u32 = Brace.Nextˉoffset;
    var Line: u32 = Brace.Nextˉline;
    var Column: u32 = Brace.Nextˉcolumn;
    var Memberˉindex: u32 = 0u32;
    while Memberˉindex < Declaration.Items {
        let Member: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Source, Cursor, Line, Column
        );
        let Equals: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Source, Member.Nextˉoffset, Member.Nextˉline, Member.Nextˉcolumn
        );
        var Value: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Source, Equals.Nextˉoffset, Equals.Nextˉline, Equals.Nextˉcolumn
        );
        var Negative: bool = false;
        if Value.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Minus {
            Negative = true;
            Value = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                Source, Value.Nextˉoffset, Value.Nextˉline, Value.Nextˉcolumn
            );
        }
        Payload = Bytesˉconcat(
            Payload, Compilerˉsourceˉwvbˉstring(Source, Member.Offset, Member.Length)
        );
        var Encodedˉvalue: u32 = Value.Numericˉvalue;
        if Negative && Encodedˉvalue != 0u32 {
            Encodedˉvalue = 4294967295u32 - Encodedˉvalue + 1u32;
        }
        if U8ˉbacked {
            Payload = Bytesˉconcat(
                Payload, Compilerˉsourceˉwvbˉlowˉbyte(Encodedˉvalue)
            );
        } else {
            Payload = Bytesˉconcat(
                Payload, Bytesˉfromˉu32ˉlittle(Encodedˉvalue)
            );
        }
        let End: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Source, Value.Nextˉoffset, Value.Nextˉline, Value.Nextˉcolumn
        );
        Cursor = End.Nextˉoffset;
        Line = End.Nextˉline;
        Column = End.Nextˉcolumn;
        Memberˉindex = Memberˉindex + 1u32;
    }
    return Compilerˉsourceˉwvbˉtypeˉencoding(
        Compilerˉsourceˉwvbˉstatus.Valid, Payload, Features
    );
}

fn Compilerˉsourceˉwvbˉencodeˉvariantˉfields(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Orders: Compilerˉsourceˉwvbˉsymbolˉorders,
    Owner: u32,
    Source: bytes,
    Offset: u32,
    Line: u32,
    Column: u32
) -> Compilerˉsourceˉwvbˉvariantˉfieldsˉencoding {
    let Empty: bytes = Compilerˉsourceˉwvbˉempty(Source);
    var Fields: bytes = Empty;
    var Fieldˉcount: u32 = 0u32;
    var Cursor: u32 = Offset;
    var Currentˉline: u32 = Line;
    var Currentˉcolumn: u32 = Column;
    var Features: u32 = 0u32;
    var Reading: bool = true;
    var Nextˉoffset: u32 = 0u32;
    var Nextˉline: u32 = 0u32;
    var Nextˉcolumn: u32 = 0u32;
    while Reading {
        let Name: Sourceˉlexer.Compilerˉsourceˉtoken =
            Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                Source, Cursor, Currentˉline, Currentˉcolumn
            );
        let Colon: Sourceˉlexer.Compilerˉsourceˉtoken =
            Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                Source, Name.Nextˉoffset, Name.Nextˉline, Name.Nextˉcolumn
            );
        let Binding: Sourceˉsymbols.Compilerˉsourceˉtypeˉbinding =
            Sourceˉsymbols.Compilerˉsourceˉsymbolsˉbindˉtype(
                Input, Scan, Symbols.Directory, Symbols.Lookup,
                Symbols.Visibility, Owner, Source,
                Colon.Nextˉoffset, Colon.Nextˉline, Colon.Nextˉcolumn,
                Symbols.Records, Symbols.Enums, false
            );
        if Binding.Status != Sourceˉsymbols.Compilerˉsourceˉsymbolˉstatus.Valid {
            return Compilerˉsourceˉwvbˉvariantˉfieldsˉencoding(
                Compilerˉsourceˉwvbˉstatus.Unsupportedˉshape, Empty,
                0u32, 0u32, 0u32, 0u32
            );
        }
        let Shape: u32 = Sourceˉbindings.Compilerˉsourceˉbindingsˉshape(Binding);
        if !Compilerˉsourceˉwvbˉshapeˉisˉsupported(
            Shape, false, Symbols, Orders
        ) {
            return Compilerˉsourceˉwvbˉvariantˉfieldsˉencoding(
                Compilerˉsourceˉwvbˉstatus.Unsupportedˉshape, Empty,
                0u32, 0u32, 0u32, 0u32
            );
        }
        Features = Features | Compilerˉsourceˉwvbˉshapeˉfeatures(Shape);
        Fields = Bytesˉconcat(
            Fields, Compilerˉsourceˉwvbˉstring(Source, Name.Offset, Name.Length)
        );
        Fields = Bytesˉconcat(
            Fields,
            Compilerˉsourceˉwvbˉplannedˉshape(Shape, Symbols, Orders)
        );
        Fieldˉcount = Fieldˉcount + 1u32;
        let Separator: Sourceˉlexer.Compilerˉsourceˉtoken =
            Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                Source, Binding.Nextˉoffset,
                Binding.Nextˉline, Binding.Nextˉcolumn
            );
        if Separator.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Comma {
            let Afterˉcomma: Sourceˉlexer.Compilerˉsourceˉtoken =
                Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                    Source, Separator.Nextˉoffset,
                    Separator.Nextˉline, Separator.Nextˉcolumn
                );
            if Afterˉcomma.Kind ==
                Sourceˉlexer.Compilerˉtokenˉkind.Rightˉparenthesis {
                let Trailingˉend: Sourceˉlexer.Compilerˉsourceˉtoken =
                    Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                        Source, Afterˉcomma.Nextˉoffset,
                        Afterˉcomma.Nextˉline, Afterˉcomma.Nextˉcolumn
                    );
                Nextˉoffset = Trailingˉend.Nextˉoffset;
                Nextˉline = Trailingˉend.Nextˉline;
                Nextˉcolumn = Trailingˉend.Nextˉcolumn;
                Reading = false;
            } else {
                Cursor = Separator.Nextˉoffset;
                Currentˉline = Separator.Nextˉline;
                Currentˉcolumn = Separator.Nextˉcolumn;
            }
        } else {
            let Rightˉend: Sourceˉlexer.Compilerˉsourceˉtoken =
                Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                    Source, Separator.Nextˉoffset,
                    Separator.Nextˉline, Separator.Nextˉcolumn
                );
            Nextˉoffset = Rightˉend.Nextˉoffset;
            Nextˉline = Rightˉend.Nextˉline;
            Nextˉcolumn = Rightˉend.Nextˉcolumn;
            Reading = false;
        }
    }
    var Payload: bytes = Bytesˉfromˉu8(1u8);
    if Fieldˉcount > 1u32 {
        Payload = Bytesˉfromˉu8(2u8);
        Payload = Bytesˉconcat(Payload, Bytesˉfromˉu32ˉlittle(Fieldˉcount));
        Features = Features | 32u32;
    }
    Payload = Bytesˉconcat(Payload, Fields);
    return Compilerˉsourceˉwvbˉvariantˉfieldsˉencoding(
        Compilerˉsourceˉwvbˉstatus.Valid, Payload,
        Nextˉoffset, Nextˉline, Nextˉcolumn, Features
    );
}

export fn Compilerˉsourceˉwvbˉencodeˉvariantˉtype(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Source: bytes,
    Header: Sourceˉdeclarations.Compilerˉsourceˉheader,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Orders: Compilerˉsourceˉwvbˉsymbolˉorders,
    Entry: u32
) -> Compilerˉsourceˉwvbˉtypeˉencoding {
    let Empty: bytes = Compilerˉsourceˉwvbˉempty(Source);
    let Entryˉoffset: u32 = 16u32 + Entry * 24u32;
    let Owner: u32 = Bytesˉreadˉu32ˉlittle(Symbols.Directory, Entryˉoffset);
    let Declaration: Sourceˉdeclarations.Compilerˉsourceˉdeclaration =
        Compilerˉsourceˉwvbˉdeclaration(Source, Header, Symbols, Entry);
    var Payload: bytes = Bytesˉfromˉu8(3u8);
    var Features: u32 = 0u32;
    Payload = Bytesˉconcat(
        Payload,
        Compilerˉsourceˉwvbˉencodedˉstring(
            Compilerˉsourceˉwvbˉsymbolˉname(Input, Scan, Symbols, Entry)
        )
    );
    Payload = Bytesˉconcat(Payload, Bytesˉfromˉu32ˉlittle(Declaration.Items));
    let Brace: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
        Source, Declaration.Bodyˉoffset, 1u32, 1u32
    );
    var Cursor: u32 = Brace.Nextˉoffset;
    var Line: u32 = Brace.Nextˉline;
    var Column: u32 = Brace.Nextˉcolumn;
    var Caseˉindex: u32 = 0u32;
    while Caseˉindex < Declaration.Items {
        let Caseˉname: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Source, Cursor, Line, Column
        );
        let Afterˉname: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Source, Caseˉname.Nextˉoffset, Caseˉname.Nextˉline, Caseˉname.Nextˉcolumn
        );
        Payload = Bytesˉconcat(
            Payload,
            Compilerˉsourceˉwvbˉstring(Source, Caseˉname.Offset, Caseˉname.Length)
        );
        var Nextˉoffset: u32 = Afterˉname.Nextˉoffset;
        var Nextˉline: u32 = Afterˉname.Nextˉline;
        var Nextˉcolumn: u32 = Afterˉname.Nextˉcolumn;
        if Afterˉname.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Leftˉparenthesis {
            let Encodedˉfields:
                Compilerˉsourceˉwvbˉvariantˉfieldsˉencoding =
                Compilerˉsourceˉwvbˉencodeˉvariantˉfields(
                    Input, Scan, Symbols, Orders, Owner, Source,
                    Afterˉname.Nextˉoffset, Afterˉname.Nextˉline,
                    Afterˉname.Nextˉcolumn
                );
            if Encodedˉfields.Status != Compilerˉsourceˉwvbˉstatus.Valid {
                return Compilerˉsourceˉwvbˉtypeˉencoding(
                    Encodedˉfields.Status, Empty, Features
                );
            }
            Payload = Bytesˉconcat(Payload, Encodedˉfields.Payload);
            Features = Features | Encodedˉfields.Features;
            Nextˉoffset = Encodedˉfields.Nextˉoffset;
            Nextˉline = Encodedˉfields.Nextˉline;
            Nextˉcolumn = Encodedˉfields.Nextˉcolumn;
        } else {
            Payload = Bytesˉconcat(Payload, Bytesˉfromˉu8(0u8));
        }
        Cursor = Nextˉoffset;
        Line = Nextˉline;
        Column = Nextˉcolumn;
        Caseˉindex = Caseˉindex + 1u32;
    }
    return Compilerˉsourceˉwvbˉtypeˉencoding(
        Compilerˉsourceˉwvbˉstatus.Valid, Payload, Features
    );
}

fn Compilerˉsourceˉwvbˉfunctionˉtypesˉoffset(Wir: bytes) -> u32 {
    return Compilerˉsourceˉwvbˉoperandsˉoffset(Wir) +
        Bytesˉreadˉu32ˉlittle(Wir, 40u32) * 4u32;
}

fn Compilerˉsourceˉwvbˉfunctionˉtypeˉentryˉcursor(
    Wir: bytes,
    Wanted: u32
) -> u32 {
    let Catalog: u32 = Compilerˉsourceˉwvbˉfunctionˉtypesˉoffset(Wir);
    let Length: u32 = Bytesˉlength(Wir);
    if Catalog > Length || Length - Catalog < WVB_FUNCTION_TYPE_HEADER_BYTES ||
        Wanted >= Bytesˉreadˉu32ˉlittle(Wir, Catalog + 8u32) {
        return 4294967295u32;
    }
    var Cursor: u32 = Catalog + WVB_FUNCTION_TYPE_HEADER_BYTES;
    var Instance: u32 = 0u32;
    while Instance < Wanted {
        if Cursor > Length || Length - Cursor < WVB_FUNCTION_TYPE_ENTRY_BYTES {
            return 4294967295u32;
        }
        let Parameters: u32 = Bytesˉreadˉu32ˉlittle(
            Wir, Cursor + 24u32
        );
        if Parameters > 64u32 ||
            Parameters * WVB_FUNCTION_TYPE_PARAMETER_BYTES >
                Length - Cursor - WVB_FUNCTION_TYPE_ENTRY_BYTES {
            return 4294967295u32;
        }
        Cursor = Cursor + WVB_FUNCTION_TYPE_ENTRY_BYTES +
            Parameters * WVB_FUNCTION_TYPE_PARAMETER_BYTES;
        Instance = Instance + 1u32;
    }
    return Cursor;
}

fn Compilerˉsourceˉwvbˉfunctionˉtypesˉareˉextended(
    Wir: bytes,
    Instances: u32
) -> bool {
    let Length: u32 = Bytesˉlength(Wir);
    var Instance: u32 = 0u32;
    while Instance < Instances {
        let Cursor: u32 =
            Compilerˉsourceˉwvbˉfunctionˉtypeˉentryˉcursor(
                Wir, Instance
            );
        if Cursor == 4294967295u32 || Cursor > Length ||
            Length - Cursor < WVB_FUNCTION_TYPE_ENTRY_BYTES {
            return false;
        }
        if Bytesˉreadˉu32ˉlittle(Wir, Cursor) != 0u32 ||
            Bytesˉreadˉu32ˉlittle(Wir, Cursor + 12u32) != 0u32 ||
            Bytesˉreadˉu32ˉlittle(Wir, Cursor + 16u32) != 0u32 ||
            Bytesˉreadˉu32ˉlittle(Wir, Cursor + 20u32) != 0u32 {
            return true;
        }
        let Parameters: u32 = Bytesˉreadˉu32ˉlittle(
            Wir, Cursor + 24u32
        );
        if Parameters > 64u32 ||
            Parameters * WVB_FUNCTION_TYPE_PARAMETER_BYTES >
                Length - Cursor - WVB_FUNCTION_TYPE_ENTRY_BYTES {
            return false;
        }
        var Parameter: u32 = 0u32;
        while Parameter < Parameters {
            if Bytesˉreadˉu32ˉlittle(
                    Wir, Cursor + WVB_FUNCTION_TYPE_ENTRY_BYTES +
                        Parameter * WVB_FUNCTION_TYPE_PARAMETER_BYTES + 4u32
                ) != 0u32 {
                return true;
            }
            Parameter = Parameter + 1u32;
        }
        Instance = Instance + 1u32;
    }
    return false;
}

fn Compilerˉsourceˉwvbˉencodeˉfunctionˉtypes(
    Wir: bytes,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Orders: Compilerˉsourceˉwvbˉsymbolˉorders
) -> Compilerˉsourceˉwvbˉtypeˉencoding {
    let Empty: bytes = Compilerˉsourceˉwvbˉempty(Wir);
    let Catalog: u32 = Compilerˉsourceˉwvbˉfunctionˉtypesˉoffset(Wir);
    let Length: u32 = Bytesˉlength(Wir);
    if Catalog == Length {
        return Compilerˉsourceˉwvbˉtypeˉencoding(
            Compilerˉsourceˉwvbˉstatus.Valid, Empty, 0u32
        );
    }
    if Catalog > Length || Length - Catalog < WVB_FUNCTION_TYPE_HEADER_BYTES ||
        Bytesˉreadˉu8(Wir, Catalog) != 87u8 ||
        Bytesˉreadˉu8(Wir, Catalog + 1u32) != 86u8 ||
        Bytesˉreadˉu8(Wir, Catalog + 2u32) != 70u8 ||
        Bytesˉreadˉu8(Wir, Catalog + 3u32) != 84u8 ||
        Bytesˉreadˉu16ˉlittle(Wir, Catalog + 4u32) != 1u32 ||
        Bytesˉreadˉu16ˉlittle(Wir, Catalog + 6u32) != 0u32 ||
        Bytesˉreadˉu32ˉlittle(Wir, Catalog + 16u32) != Length - Catalog {
        return Compilerˉsourceˉwvbˉtypeˉencoding(
            Compilerˉsourceˉwvbˉstatus.Invalidˉdata, Empty, 0u32
        );
    }
    let Instances: u32 = Bytesˉreadˉu32ˉlittle(Wir, Catalog + 8u32);
    let Extended: bool = Bytesˉreadˉu16ˉlittle(Wir, 6u32) >= 21u32 ||
        Compilerˉsourceˉwvbˉfunctionˉtypesˉareˉextended(Wir, Instances);
    let Nominalˉtypes: u32 = Orders.Concreteˉrecords + Symbols.Enums +
        Orders.Concreteˉvariants + Orders.Genericˉtypeˉentries;
    if Instances == 0u32 || Instances > WVB_FUNCTION_TYPE_INSTANCE_LIMIT ||
        Nominalˉtypes > 1024u32 || Instances > 1024u32 - Nominalˉtypes {
        return Compilerˉsourceˉwvbˉtypeˉencoding(
            Compilerˉsourceˉwvbˉstatus.Bytecodeˉlimit, Empty, 0u32
        );
    }
    var Payload: bytes = Empty;
    var Instance: u32 = 0u32;
    while Instance < Instances {
        let Cursor: u32 =
            Compilerˉsourceˉwvbˉfunctionˉtypeˉentryˉcursor(
                Wir, Instance
            );
        if Cursor == 4294967295u32 || Cursor > Length ||
            Length - Cursor < WVB_FUNCTION_TYPE_ENTRY_BYTES {
            return Compilerˉsourceˉwvbˉtypeˉencoding(
                Compilerˉsourceˉwvbˉstatus.Invalidˉdata, Empty, 0u32
            );
        }
        let Flags: u32 = Bytesˉreadˉu32ˉlittle(Wir, Cursor);
        let Profile: u32 = Bytesˉreadˉu32ˉlittle(Wir, Cursor + 4u32);
        let Resultˉshape: u32 = Bytesˉreadˉu32ˉlittle(
            Wir, Cursor + 8u32
        );
        let Resultˉmode: u32 = Bytesˉreadˉu32ˉlittle(
            Wir, Cursor + 12u32
        );
        let Languageˉeffects: u32 = Bytesˉreadˉu32ˉlittle(
            Wir, Cursor + 16u32
        );
        let Capabilityˉeffects: u32 = Bytesˉreadˉu32ˉlittle(
            Wir, Cursor + 20u32
        );
        let Parameters: u32 = Bytesˉreadˉu32ˉlittle(
            Wir, Cursor + 24u32
        );
        if Flags > 3u32 || Profile == 0u32 || Profile > 3u32 ||
            Resultˉmode > 2u32 || Parameters > 64u32 ||
            Parameters * WVB_FUNCTION_TYPE_PARAMETER_BYTES >
                Length - Cursor - WVB_FUNCTION_TYPE_ENTRY_BYTES ||
            !Compilerˉsourceˉwvbˉshapeˉisˉsupported(
                Resultˉshape, false, Symbols, Orders
            ) {
            return Compilerˉsourceˉwvbˉtypeˉencoding(
                Compilerˉsourceˉwvbˉstatus.Unsupportedˉshape,
                Empty, 0u32
            );
        }
        var Entry: bytes = Bytesˉfromˉu8(8u8);
        Entry = Bytesˉconcat(
            Entry,
            Bytesˉslice(
                Bytesˉfromˉu32ˉlittle(Profile), 0u32, 1u32
            )
        );
        if !Extended && (Flags != 0u32 || Resultˉmode != 0u32 ||
            Languageˉeffects != 0u32 || Capabilityˉeffects != 0u32) {
            return Compilerˉsourceˉwvbˉtypeˉencoding(
                Compilerˉsourceˉwvbˉstatus.Unsupportedˉshape,
                Empty, 0u32
            );
        }
        Entry = Bytesˉconcat(
            Entry,
            Compilerˉsourceˉwvbˉplannedˉshape(
                Resultˉshape, Symbols, Orders
            )
        );
        Entry = Bytesˉconcat(
            Entry, Bytesˉfromˉu32ˉlittle(Parameters)
        );
        var Parameter: u32 = 0u32;
        while Parameter < Parameters {
            let Parameterˉshape: u32 = Bytesˉreadˉu32ˉlittle(
                Wir, Cursor + WVB_FUNCTION_TYPE_ENTRY_BYTES +
                    Parameter * WVB_FUNCTION_TYPE_PARAMETER_BYTES
            );
            let Parameterˉmode: u32 = Bytesˉreadˉu32ˉlittle(
                Wir, Cursor + WVB_FUNCTION_TYPE_ENTRY_BYTES +
                    Parameter * WVB_FUNCTION_TYPE_PARAMETER_BYTES + 4u32
            );
            if !Compilerˉsourceˉwvbˉshapeˉisˉsupported(
                    Parameterˉshape, false, Symbols, Orders
                ) || Parameterˉmode > 2u32 ||
                (!Extended && Parameterˉmode != 0u32) {
                return Compilerˉsourceˉwvbˉtypeˉencoding(
                    Compilerˉsourceˉwvbˉstatus.Unsupportedˉshape,
                    Empty, 0u32
                );
            }
            Entry = Bytesˉconcat(
                Entry,
                Compilerˉsourceˉwvbˉplannedˉshape(
                    Parameterˉshape, Symbols, Orders
                )
            );
            Parameter = Parameter + 1u32;
        }
        if Extended {
            Entry = Bytesˉconcat(
                Entry,
                Bytesˉslice(
                    Bytesˉfromˉu32ˉlittle(Flags), 0u32, 1u32
                )
            );
            Entry = Bytesˉconcat(
                Entry,
                Bytesˉslice(
                    Bytesˉfromˉu32ˉlittle(Resultˉmode), 0u32, 1u32
                )
            );
            Entry = Bytesˉconcat(
                Entry, Bytesˉfromˉu32ˉlittle(Languageˉeffects)
            );
            Entry = Bytesˉconcat(
                Entry, Bytesˉfromˉu32ˉlittle(Capabilityˉeffects)
            );
            Parameter = 0u32;
            while Parameter < Parameters {
                let Encodedˉparameterˉmode: u32 = Bytesˉreadˉu32ˉlittle(
                    Wir, Cursor + WVB_FUNCTION_TYPE_ENTRY_BYTES +
                        Parameter * WVB_FUNCTION_TYPE_PARAMETER_BYTES + 4u32
                );
                Entry = Bytesˉconcat(
                    Entry,
                    Bytesˉslice(
                        Bytesˉfromˉu32ˉlittle(Encodedˉparameterˉmode),
                        0u32, 1u32
                    )
                );
                Parameter = Parameter + 1u32;
            }
        }
        Payload = Bytesˉconcat(Payload, Entry);
        Instance = Instance + 1u32;
    }
    var Features: u32 = 524288u32;
    if Extended { Features = Features | WVB_TASK_FEATURE; }
    return Compilerˉsourceˉwvbˉtypeˉencoding(
        Compilerˉsourceˉwvbˉstatus.Valid, Payload, Features
    );
}

export fn Compilerˉsourceˉwvbˉencodeˉtypes(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Orders: Compilerˉsourceˉwvbˉsymbolˉorders,
    Genericˉnominalˉencoding:
        Genericˉnominalˉtypes.Compilerˉsourceˉwvbˉgenericˉnominalˉencoding,
    Wir: bytes
) -> Compilerˉsourceˉwvbˉtypeˉencoding {
    let Empty: bytes = Compilerˉsourceˉwvbˉempty(Input);
    if Genericˉnominalˉencoding.Status !=
            Genericˉnominalˉtypes.Compilerˉsourceˉwvbˉgenericˉnominalˉstatus.Valid ||
        Genericˉnominalˉencoding.Entries != Orders.Genericˉnominals {
        return Compilerˉsourceˉwvbˉtypeˉencoding(
            Compilerˉsourceˉwvbˉstatus.Invalidˉdata, Empty, 0u32
        );
    }
    if Genericˉnominalˉencoding.Recordˉentries != Orders.Genericˉrecords ||
        Genericˉnominalˉencoding.Recordˉpayloadˉbytes >
            Bytesˉlength(Genericˉnominalˉencoding.Payload) {
        return Compilerˉsourceˉwvbˉtypeˉencoding(
            Compilerˉsourceˉwvbˉstatus.Invalidˉdata, Empty, 0u32
        );
    }
    let Functionˉtypes: Compilerˉsourceˉwvbˉtypeˉencoding =
        Compilerˉsourceˉwvbˉencodeˉfunctionˉtypes(
            Wir, Symbols, Orders
        );
    if Functionˉtypes.Status != Compilerˉsourceˉwvbˉstatus.Valid {
        return Functionˉtypes;
    }
    let Functionˉtypeˉcatalog: u32 =
        Compilerˉsourceˉwvbˉfunctionˉtypesˉoffset(Wir);
    var Functionˉtypeˉcount: u32 = 0u32;
    if Functionˉtypeˉcatalog < Bytesˉlength(Wir) {
        Functionˉtypeˉcount = Bytesˉreadˉu32ˉlittle(
            Wir, Functionˉtypeˉcatalog + 8u32
        );
    }
    var Payload: bytes = Bytesˉfromˉu32ˉlittle(
        Orders.Concreteˉrecords + Symbols.Enums + Orders.Concreteˉvariants +
            Orders.Genericˉtypeˉentries + Functionˉtypeˉcount
    );
    var Rank: u32 = 0u32;
    var Features: u32 = 0u32;
    while Rank < Symbols.Records {
        let Entry: u32 = Compilerˉsourceˉwvbˉorderedˉsymbol(
            Compilerˉsourceˉwvbˉrecordˉorder(Orders), Rank
        );
        if !Compilerˉsourceˉwvbˉnominalˉisˉtemplate(
                Input, Scan, Symbols, Entry
            ) {
            let View: Sourceˉset.Compilerˉsourceˉsetˉview =
                Compilerˉsourceˉwvbˉsymbolˉsource(
                    Input, Scan, Symbols, Entry
                );
            let Header: Sourceˉdeclarations.Compilerˉsourceˉheader =
                Sourceˉdeclarations.Compilerˉparseˉheaderˉvalidated(
                    View.Source
                );
            let Encoded: Compilerˉsourceˉwvbˉtypeˉencoding =
                Compilerˉsourceˉwvbˉencodeˉrecordˉtype(
                    Input, Scan, View.Source, Header,
                    Symbols, Orders, Entry
                );
            if Encoded.Status != Compilerˉsourceˉwvbˉstatus.Valid {
                return Encoded;
            }
            Features = Features | Encoded.Features;
            Payload = Bytesˉconcat(Payload, Encoded.Payload);
        }
        Rank = Rank + 1u32;
    }
    Payload = Bytesˉconcat(
        Payload,
        Bytesˉslice(
            Genericˉnominalˉencoding.Payload, 0u32,
            Genericˉnominalˉencoding.Recordˉpayloadˉbytes
        )
    );
    Rank = 0u32;
    while Rank < Symbols.Enums {
        let Enumˉentry: u32 = Compilerˉsourceˉwvbˉorderedˉsymbol(
            Compilerˉsourceˉwvbˉenumˉorder(Orders), Rank
        );
        let Enumˉview: Sourceˉset.Compilerˉsourceˉsetˉview =
            Compilerˉsourceˉwvbˉsymbolˉsource(
                Input, Scan, Symbols, Enumˉentry
            );
        let Enumˉheader: Sourceˉdeclarations.Compilerˉsourceˉheader =
            Sourceˉdeclarations.Compilerˉparseˉheaderˉvalidated(Enumˉview.Source);
        let Encodedˉenum: Compilerˉsourceˉwvbˉtypeˉencoding =
            Compilerˉsourceˉwvbˉencodeˉenumˉtype(
                Input, Scan, Enumˉview.Source, Enumˉheader, Symbols, Enumˉentry
            );
        if Encodedˉenum.Status != Compilerˉsourceˉwvbˉstatus.Valid {
            return Encodedˉenum;
        }
        Features = Features | Encodedˉenum.Features;
        Payload = Bytesˉconcat(Payload, Encodedˉenum.Payload);
        Rank = Rank + 1u32;
    }
    Rank = 0u32;
    while Rank < Symbols.Variants {
        let Variantˉentry: u32 = Compilerˉsourceˉwvbˉorderedˉsymbol(
            Compilerˉsourceˉwvbˉvariantˉorder(Orders), Rank
        );
        if !Compilerˉsourceˉwvbˉnominalˉisˉtemplate(
                Input, Scan, Symbols, Variantˉentry
            ) {
            let Variantˉview: Sourceˉset.Compilerˉsourceˉsetˉview =
                Compilerˉsourceˉwvbˉsymbolˉsource(
                    Input, Scan, Symbols, Variantˉentry
                );
            let Variantˉheader: Sourceˉdeclarations.Compilerˉsourceˉheader =
                Sourceˉdeclarations.Compilerˉparseˉheaderˉvalidated(
                    Variantˉview.Source
                );
            let Encodedˉvariant: Compilerˉsourceˉwvbˉtypeˉencoding =
                Compilerˉsourceˉwvbˉencodeˉvariantˉtype(
                    Input, Scan, Variantˉview.Source, Variantˉheader,
                    Symbols, Orders, Variantˉentry
                );
            if Encodedˉvariant.Status != Compilerˉsourceˉwvbˉstatus.Valid {
                return Encodedˉvariant;
            }
            Features = Features | Encodedˉvariant.Features;
            Payload = Bytesˉconcat(Payload, Encodedˉvariant.Payload);
        }
        Rank = Rank + 1u32;
    }
    Features = Features | Genericˉnominalˉencoding.Features;
    Payload = Bytesˉconcat(
        Payload,
        Bytesˉslice(
            Genericˉnominalˉencoding.Payload,
            Genericˉnominalˉencoding.Recordˉpayloadˉbytes,
            Bytesˉlength(Genericˉnominalˉencoding.Payload) -
                Genericˉnominalˉencoding.Recordˉpayloadˉbytes
        )
    );
    Features = Features | Functionˉtypes.Features;
    Payload = Bytesˉconcat(Payload, Functionˉtypes.Payload);
    return Compilerˉsourceˉwvbˉtypeˉencoding(
        Compilerˉsourceˉwvbˉstatus.Valid, Payload, Features
    );
}

export fn Compilerˉsourceˉwvbˉtextˉoperationˉdataˉindex(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Source: bytes,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Plan: Compilerˉsourceˉwvbˉtextˉplan,
    Order: Compilerˉsourceˉwvbˉsymbolˉorder,
    Wir: bytes,
    Operationˉentry: u32
) -> u32 {
    let Target: u32 = Bytesˉreadˉu32ˉlittle(Wir, Operationˉentry + 20u32);
    let Length: u32 = Bytesˉreadˉu32ˉlittle(Wir, Operationˉentry + 24u32);
    if Length == 0u32 {
        return Compilerˉsourceˉwvbˉexplicitˉdataˉindex(
            Input, Scan, Symbols, Plan, Order, Target
        );
    }
    let Decoded: Compilerˉsourceˉwvbˉtextˉvalue =
        Compilerˉsourceˉwvbˉdecodeˉtext(Source, Target, Length);
    let Explicit: u32 = Compilerˉsourceˉwvbˉexplicitˉtextˉentry(
        Input, Scan, Symbols, Decoded.Value
    );
    if Explicit != Sourceˉwir.Compilerˉsourceˉwirˉsentinel() {
        return Compilerˉsourceˉwvbˉexplicitˉdataˉindex(
            Input, Scan, Symbols, Plan, Order, Explicit
        );
    }
    return Compilerˉsourceˉwvbˉsyntheticˉdataˉindex(
        Input,
        Scan,
        Symbols,
        Plan,
        Order,
        Compilerˉsourceˉwvbˉtextˉplanˉfind(Plan, Decoded.Value)
    );
}

export fn Compilerˉsourceˉwvbˉblocksˉoffset(Wir: bytes) -> u32 {
    return Sourceˉwir.Compilerˉsourceˉwirˉfunctionsˉoffset(Wir) +
        Bytesˉreadˉu32ˉlittle(Wir, 8u32) * 48u32;
}

export fn Compilerˉsourceˉwvbˉoperationsˉoffset(Wir: bytes) -> u32 {
    return Compilerˉsourceˉwvbˉblocksˉoffset(Wir) +
        Bytesˉreadˉu32ˉlittle(Wir, 16u32) * 28u32;
}

fn Compilerˉsourceˉwvbˉshapeˉisˉaffineˉresult(
    Wir: bytes,
    Shape: u32
) -> bool {
    if !Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉshapeˉisˉprivate(Shape) {
        return false;
    }
    let Operations: u32 = Bytesˉreadˉu32ˉlittle(Wir, 24u32);
    let Offset: u32 = Compilerˉsourceˉwvbˉoperationsˉoffset(Wir);
    var Index: u32 = 0u32;
    while Index < Operations {
        let Entry: u32 = Offset + Index * 28u32;
        let Operation: u32 = Bytesˉreadˉu16ˉlittle(Wir, Entry + 4u32);
        if (Operation == 171u32 || Operation == 172u32 ||
                Operation == 180u32 || Operation == 182u32 ||
                Operation == 186u32 || Operation == 188u32 || Operation == 195u32) &&
            Bytesˉreadˉu32ˉlittle(Wir, Entry + 8u32) == Shape {
            return true;
        }
        Index = Index + 1u32;
    }
    return false;
}

fn Compilerˉsourceˉwvbˉfunctionˉhasˉwriteˉregionˉtarget(
    Wir: bytes,
    Firstˉoperation: u32,
    Operationˉcount: u32,
    Target: u32
) -> bool {
    let Operations: u32 = Compilerˉsourceˉwvbˉoperationsˉoffset(Wir);
    var Index: u32 = 0u32;
    while Index < Operationˉcount {
        let Entry: u32 = Operations + (Firstˉoperation + Index) * 28u32;
        if Bytesˉreadˉu16ˉlittle(Wir, Entry + 4u32) == 188u32 &&
            Bytesˉreadˉu32ˉlittle(Wir, Entry + 20u32) == Target {
            return true;
        }
        Index = Index + 1u32;
    }
    return false;
}

fn Compilerˉsourceˉwvbˉfunctionˉhasˉwriteˉpointerˉtarget(
    Wir: bytes,
    Firstˉoperation: u32,
    Operationˉcount: u32,
    Target: u32
) -> bool {
    let Operations: u32 = Compilerˉsourceˉwvbˉoperationsˉoffset(Wir);
    var Index: u32 = 0u32;
    while Index < Operationˉcount {
        let Entry: u32 = Operations + (Firstˉoperation + Index) * 28u32;
        if Bytesˉreadˉu16ˉlittle(Wir, Entry + 4u32) == 189u32 &&
            Bytesˉreadˉu32ˉlittle(Wir, Entry + 20u32) == Target {
            return true;
        }
        Index = Index + 1u32;
    }
    return false;
}

fn Compilerˉsourceˉwvbˉshapeˉisˉtaskˉowner(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Bindings: Sourceˉbindings.Compilerˉsourceˉbindingˉsummary,
    Shape: u32
) -> bool {
    var Nominal: Sourceˉsymbols.Compilerˉsourceˉsymbolˉmatch =
        Sourceˉsymbols.Compilerˉsourceˉsymbolsˉmatchˉnone(Scan.Modules);
    if Shape >= 65536u32 && Shape < 131072u32 {
        let Wanted: u32 = Shape - 65536u32;
        if Wanted < Symbols.Records + Symbols.Enums + Symbols.Variants {
            let Entries: u32 = Bytesˉreadˉu32ˉlittle(Symbols.Directory, 8u32);
            Nominal = Sourceˉsymbols.Compilerˉsourceˉsymbolsˉdirectoryˉentry(
                Symbols.Directory, Scan.Modules,
                Bytesˉreadˉu32ˉlittle(
                    Symbols.Lookup,
                    4112u32 + Entries * 4u32 + Wanted * 4u32
                )
            );
        }
        if Nominal.Found && Nominal.Module < Scan.Modules {
            let Scopeˉview: Sourceˉset.Compilerˉsourceˉsetˉview =
                Sourceˉset.Compilerˉsourceˉsetˉmodule(
                    Input, Scan, Nominal.Module
                );
            let Scopeˉheader: Sourceˉdeclarations.Compilerˉsourceˉheader =
                Sourceˉdeclarations.Compilerˉparseˉheaderˉvalidated(
                    Scopeˉview.Source
                );
            if Scopeˉview.Edition == 1u32 &&
                Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(
                    Scopeˉview.Source,
                    Scopeˉheader.Nameˉoffset, Scopeˉheader.Nameˉlength,
                    "Foundationˉtask"
                ) && Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(
                    Scopeˉview.Source,
                    Nominal.Nameˉoffset, Nominal.Nameˉlength,
                    "Taskˉscope"
                ) {
                return true;
            }
        }
    }
    if !Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉshapeˉisˉprivate(Shape) {
        return false;
    }
    let Catalog: Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog =
        Compilerˉsourceˉwvbˉbindingsˉtypeˉcatalog(Bindings.Directory);
    let Instance: u32 =
        Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉshapeˉinstance(Shape);
    if Instance >=
            Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalogˉinstances(
                Catalog
            ) || Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalogˉinstanceˉparameters(
            Catalog, Instance
        ) != 2u32 {
        return false;
    }
    Nominal = Sourceˉsymbols.Compilerˉsourceˉsymbolsˉdirectoryˉentry(
        Symbols.Directory, Scan.Modules,
        Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalogˉinstanceˉdeclaration(
            Catalog, Instance
        )
    );
    if !Nominal.Found || Nominal.Module >= Scan.Modules || Nominal.Kind !=
        Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Record {
        return false;
    }
    let Taskˉview: Sourceˉset.Compilerˉsourceˉsetˉview =
        Sourceˉset.Compilerˉsourceˉsetˉmodule(Input, Scan, Nominal.Module);
    let Taskˉheader: Sourceˉdeclarations.Compilerˉsourceˉheader =
        Sourceˉdeclarations.Compilerˉparseˉheaderˉvalidated(Taskˉview.Source);
    return Taskˉview.Edition == 1u32 && Taskˉheader.Profile ==
            Sourceˉdeclarations.Compilerˉsourceˉprofile.Hosted &&
        Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(
            Taskˉview.Source,
            Taskˉheader.Nameˉoffset, Taskˉheader.Nameˉlength,
            "Foundationˉtask"
        ) && Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(
            Taskˉview.Source, Nominal.Nameˉoffset, Nominal.Nameˉlength,
            "Task"
        );
}

fn Compilerˉsourceˉwvbˉshapeˉpathˉcontains(
    Path: bytes,
    Shape: u32
) -> bool {
    var Cursor: u32 = 0u32;
    while Cursor < Bytesˉlength(Path) {
        if Bytesˉreadˉu32ˉlittle(Path, Cursor) == Shape { return true; }
        Cursor = Cursor + 4u32;
    }
    return false;
}

// One row binds a constructor's shape and operation to its function's temporary
// base. Validated WVIR partitions operations into ordered function ranges.
fn Compilerˉsourceˉwvbˉownershipˉconstructors(Wir: bytes) -> bytes {
    let Empty: bytes = Compilerˉsourceˉwvbˉempty(Wir);
    if Bytesˉreadˉu16ˉlittle(Wir, 6u32) == 9u32 { return Empty; }
    let Invalid: bytes = Bytesˉfromˉu32ˉlittle(4294967295u32);
    let Functions: u32 = Bytesˉreadˉu32ˉlittle(Wir, 8u32);
    let Operations: u32 = Bytesˉreadˉu32ˉlittle(Wir, 24u32);
    let Total: u32 = Bytesˉlength(Wir);
    if Functions > Total / 48u32 || Operations > Total / 28u32 {
        return Invalid;
    }
    let Functionˉoffset: u32 = Sourceˉwir.Compilerˉsourceˉwirˉfunctionsˉoffset(Wir);
    let Operationˉoffset: u32 = Compilerˉsourceˉwvbˉoperationsˉoffset(Wir);
    if Functionˉoffset > Total || Functions * 48u32 > Total - Functionˉoffset ||
        Operationˉoffset > Total || Operations * 28u32 > Total - Operationˉoffset {
        return Invalid;
    }
    var Result: bytes = Empty;
    var Chunk: bytes = Empty;
    var Function: u32 = 0u32;
    var Operation: u32 = 0u32;
    while Operation < Operations {
        let Current: u32 = Operationˉoffset + Operation * 28u32;
        let Kind: u32 = Bytesˉreadˉu16ˉlittle(Wir, Current + 4u32);
        if Kind == 17u32 || Kind == 65u32 || Kind == 165u32 {
            var Found: bool = false;
            var Firstˉtemporary: u32 = 0u32;
            while Function < Functions && !Found {
                let Entry: u32 = Functionˉoffset + Function * 48u32;
                let First: u32 = Bytesˉreadˉu32ˉlittle(Wir, Entry + 12u32);
                let Count: u32 = Bytesˉreadˉu32ˉlittle(Wir, Entry + 16u32);
                if First > Operations || Count > Operations - First || Operation < First {
                    return Invalid;
                }
                if Operation - First < Count {
                    Firstˉtemporary = Bytesˉreadˉu32ˉlittle(Wir, Entry + 20u32);
                    Found = true;
                } else {
                    Function = Function + 1u32;
                }
            }
            if !Found { return Invalid; }
            Chunk = Bytesˉconcat(Chunk, Bytesˉfromˉu32ˉlittle(
                Bytesˉreadˉu32ˉlittle(Wir, Current + 8u32)));
            Chunk = Bytesˉconcat(Chunk, Bytesˉfromˉu32ˉlittle(Firstˉtemporary));
            Chunk = Bytesˉconcat(Chunk, Bytesˉfromˉu32ˉlittle(Operation));
            if Bytesˉlength(Chunk) == 384u32 {
                Result = Bytesˉconcat(Result, Chunk);
                Chunk = Empty;
            }
        }
        Operation = Operation + 1u32;
    }
    return Bytesˉconcat(Result, Chunk);
}

fn Compilerˉsourceˉwvbˉshapeˉcontainsˉownedˉvectorˉat(
    Wir: bytes,
    Shape: u32,
    Orders: Compilerˉsourceˉwvbˉsymbolˉorders,
    Path: bytes,
    Depth: u32,
    Budget: u32
) -> u32 {
    if Shape == 805306369u32 || Shape == 805306370u32 { return 1u32; }
    if Bytesˉlength(Orders.Builderˉownedˉshapes) % 4u32 != 0u32 { return 2u32; }
    if Bytesˉlength(Orders.Builderˉownedˉshapes) == 4u32 &&
        Bytesˉreadˉu32ˉlittle(Orders.Builderˉownedˉshapes, 0u32) == 4294967295u32 { return 2u32; }
    if Compilerˉsourceˉwvbˉshapeˉpathˉcontains(Orders.Builderˉownedˉshapes, Shape) { return 1u32; }
    if Bytesˉreadˉu16ˉlittle(Wir, 6u32) == 9u32 { return 0u32; }
    let Entry: u32 = Compilerˉsourceˉwvbˉgenericˉnominalˉentry(
        Shape, Orders
    );
    if Entry != 4294967295u32 && Bytesˉreadˉu32ˉlittle(
        Orders.Genericˉnominalˉentries, Entry + 8u32
    ) == 11u32 { return 1u32; }
    var Possibleˉaggregate: bool =
        (Shape >= 65536u32 && Shape < 131072u32) ||
        (Shape >= 196608u32 && Shape < 262144u32);
    if Entry != 4294967295u32 {
        let Possibleˉkind: u32 = Bytesˉreadˉu32ˉlittle(
            Orders.Genericˉnominalˉentries, Entry + 8u32
        );
        Possibleˉaggregate = Possibleˉkind == 4u32 ||
            Possibleˉkind == 8u32 || Possibleˉkind == 10u32;
    }
    if !Possibleˉaggregate { return 0u32; }
    if Budget == 0u32 || Depth >= 64u32 ||
        Compilerˉsourceˉwvbˉshapeˉpathˉcontains(Path, Shape) {
        return 2u32;
    }
    let Nextˉpath: bytes = Bytesˉconcat(
        Path, Bytesˉfromˉu32ˉlittle(Shape)
    );
    if Entry != 4294967295u32 &&
        (Bytesˉreadˉu32ˉlittle(Orders.Genericˉnominalˉentries, Entry + 8u32) == 4u32 ||
         Bytesˉreadˉu32ˉlittle(Orders.Genericˉnominalˉentries, Entry + 8u32) == 8u32) {
        // Ownership follows every declared field/case, including an inactive
        // Vector arm. Unused generic arguments are not storage evidence.
        let Firstˉfield: u32 = Bytesˉreadˉu32ˉlittle(
            Orders.Genericˉnominalˉentries, Entry + 28u32
        );
        let Fields: u32 = Bytesˉreadˉu32ˉlittle(
            Orders.Genericˉnominalˉentries, Entry + 32u32
        );
        let Available: u32 = Bytesˉlength(Orders.Genericˉfields) / 16u32;
        if Bytesˉlength(Orders.Genericˉfields) % 16u32 != 0u32 ||
            Firstˉfield > Available || Fields > Available - Firstˉfield ||
            Fields > Budget - 1u32 { return 2u32; }
        var Field: u32 = 0u32;
        while Field < Fields {
            let Child: u32 = Compilerˉsourceˉwvbˉshapeˉcontainsˉownedˉvectorˉat(
                Wir, Bytesˉreadˉu32ˉlittle(
                    Orders.Genericˉfields, (Firstˉfield + Field) * 16u32 + 8u32
                ), Orders, Nextˉpath, Depth + 1u32,
                (Budget - 1u32) / Fields
            );
            if Child != 0u32 { return Child; }
            Field = Field + 1u32;
        }
        return 0u32;
    }
    let Operationˉoffset: u32 = Compilerˉsourceˉwvbˉoperationsˉoffset(Wir);
    let Temporaryˉoffset: u32 = Compilerˉsourceˉwvbˉtemporariesˉoffset(Wir);
    let Operandˉoffset: u32 = Compilerˉsourceˉwvbˉoperandsˉoffset(Wir);
    let Constructors: bytes = Orders.Ownershipˉconstructors;
    if Bytesˉlength(Constructors) % 12u32 != 0u32 { return 2u32; }
    var Constructor: u32 = 0u32;
    var Childˉshapes: bytes = Compilerˉsourceˉwvbˉempty(Wir);
    // Ownership is a property of the stored types, not the number of values
    // constructed. Inspect every constructor, but visit each child type once.
    while Constructor < Bytesˉlength(Constructors) {
        if Bytesˉreadˉu32ˉlittle(Constructors, Constructor) == Shape {
            let Firstˉtemporary: u32 = Bytesˉreadˉu32ˉlittle(Constructors, Constructor + 4u32);
            let Current: u32 = Operationˉoffset +
                Bytesˉreadˉu32ˉlittle(Constructors, Constructor + 8u32) * 28u32;
            let First: u32 = Bytesˉreadˉu32ˉlittle(Wir, Current + 16u32);
            let Count: u32 = Bytesˉreadˉu16ˉlittle(Wir, Current + 6u32);
            var Operand: u32 = 0u32;
            while Operand < Count {
                let Temporary: u32 = Bytesˉreadˉu32ˉlittle(
                    Wir, Operandˉoffset + (First + Operand) * 4u32
                );
                let Operandˉshape: u32 = Bytesˉreadˉu32ˉlittle(
                    Wir,
                    Temporaryˉoffset +
                        (Firstˉtemporary + Temporary) * 4u32
                );
                if !Compilerˉsourceˉwvbˉshapeˉpathˉcontains(Childˉshapes, Operandˉshape) {
                    if Bytesˉlength(Childˉshapes) / 4u32 >= Budget - 1u32 { return 2u32; }
                    Childˉshapes = Bytesˉconcat(Childˉshapes, Bytesˉfromˉu32ˉlittle(Operandˉshape));
                }
                Operand = Operand + 1u32;
            }
        }
        Constructor = Constructor + 12u32;
    }
    let Children: u32 = Bytesˉlength(Childˉshapes) / 4u32;
    var Childˉindex: u32 = 0u32;
    while Childˉindex < Children {
        let Constructedˉchild: u32 = Compilerˉsourceˉwvbˉshapeˉcontainsˉownedˉvectorˉat(
            Wir, Bytesˉreadˉu32ˉlittle(Childˉshapes, Childˉindex * 4u32),
            Orders, Nextˉpath, Depth + 1u32, (Budget - 1u32) / Children
        );
        if Constructedˉchild != 0u32 { return Constructedˉchild; }
        Childˉindex = Childˉindex + 1u32;
    }
    return 0u32;
}

fn Compilerˉsourceˉwvbˉshapeˉcontainsˉownedˉvector(
    Wir: bytes,
    Shape: u32,
    Orders: Compilerˉsourceˉwvbˉsymbolˉorders
) -> bool {
    return Compilerˉsourceˉwvbˉshapeˉcontainsˉownedˉvectorˉat(
        Wir, Shape, Orders, Compilerˉsourceˉwvbˉempty(Wir), 0u32, 8192u32
    ) == 1u32;
}

fn Compilerˉsourceˉwvbˉshapeˉownershipˉisˉunknown(
    Wir: bytes,
    Shape: u32,
    Orders: Compilerˉsourceˉwvbˉsymbolˉorders
) -> bool {
    return Compilerˉsourceˉwvbˉshapeˉcontainsˉownedˉvectorˉat(
        Wir, Shape, Orders, Compilerˉsourceˉwvbˉempty(Wir), 0u32, 8192u32
    ) == 2u32;
}

fn Compilerˉsourceˉwvbˉshapeˉisˉnewˉownedˉaggregate(
    Wir: bytes,
    Shape: u32,
    Orders: Compilerˉsourceˉwvbˉsymbolˉorders
) -> bool {
    return Compilerˉsourceˉwvbˉshapeˉcontainsˉownedˉvector(
            Wir, Shape, Orders
        ) && Shape != 805306369u32 &&
        !Compilerˉsourceˉwvbˉshapeˉisˉownedˉvector(
            Shape, Orders
        ) && !Compilerˉsourceˉwvbˉshapeˉisˉaffineˉresult(Wir, Shape);
}

fn Compilerˉsourceˉwvbˉfoundationˉidentityˉisˉexact(
    Source: bytes,
    Edition: u32,
    Nameˉoffset: u32,
    Nameˉlength: u32,
    Moduleˉname: text,
    Typeˉname: text,
    Requiredˉprofile: Sourceˉdeclarations.Compilerˉsourceˉprofile
) -> bool {
    if Edition != 1u32 { return false; }
    let Header: Sourceˉdeclarations.Compilerˉsourceˉheader =
        Sourceˉdeclarations.Compilerˉparseˉheaderˉvalidated(Source);
    return Header.Profile == Requiredˉprofile &&
        Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(
            Source, Header.Nameˉoffset, Header.Nameˉlength, Moduleˉname
        ) &&
        Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(
            Source, Nameˉoffset, Nameˉlength, Typeˉname
        );
}

fn Compilerˉsourceˉwvbˉshapeˉisˉunsafeˉscratch(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Bindings: Sourceˉbindings.Compilerˉsourceˉbindingˉsummary,
    Shape: u32
) -> bool {
    if !Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉshapeˉisˉprivate(Shape) {
        return false;
    }
    let Catalog: Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog =
        Compilerˉsourceˉwvbˉbindingsˉtypeˉcatalog(Bindings.Directory);
    let Instance: u32 =
        Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉshapeˉinstance(Shape);
    if Instance >=
            Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalogˉinstances(
                Catalog
            ) || Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalogˉinstanceˉparameters(
                Catalog, Instance
            ) != 1u32 {
        return false;
    }
    let Nominal: Sourceˉsymbols.Compilerˉsourceˉsymbolˉmatch =
        Sourceˉsymbols.Compilerˉsourceˉsymbolsˉdirectoryˉentry(
            Symbols.Directory, Scan.Modules,
            Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalogˉinstanceˉdeclaration(
                Catalog, Instance
            )
        );
    if !Nominal.Found || Nominal.Module >= Scan.Modules || Nominal.Kind !=
            Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Record {
        return false;
    }
    let View: Sourceˉset.Compilerˉsourceˉsetˉview =
        Sourceˉset.Compilerˉsourceˉsetˉmodule(Input, Scan, Nominal.Module);
    return Compilerˉsourceˉwvbˉfoundationˉidentityˉisˉexact(
        View.Source, View.Edition, Nominal.Nameˉoffset, Nominal.Nameˉlength,
        "Foundationˉunsafe", "Foreignˉscratch",
        Sourceˉdeclarations.Compilerˉsourceˉprofile.System
    );
}

fn Compilerˉsourceˉwvbˉshapeˉisˉunsafeˉwriteˉregion(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Bindings: Sourceˉbindings.Compilerˉsourceˉbindingˉsummary,
    Shape: u32
) -> bool {
    if !Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉshapeˉisˉprivate(Shape) {
        return false;
    }
    let Catalog: Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog =
        Compilerˉsourceˉwvbˉbindingsˉtypeˉcatalog(Bindings.Directory);
    let Instance: u32 =
        Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉshapeˉinstance(Shape);
    if Instance >=
            Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalogˉinstances(
                Catalog
            ) || Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalogˉinstanceˉparameters(
                Catalog, Instance
            ) != 1u32 {
        return false;
    }
    let Nominal: Sourceˉsymbols.Compilerˉsourceˉsymbolˉmatch =
        Sourceˉsymbols.Compilerˉsourceˉsymbolsˉdirectoryˉentry(
            Symbols.Directory, Scan.Modules,
            Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalogˉinstanceˉdeclaration(
                Catalog, Instance
            )
        );
    if !Nominal.Found || Nominal.Module >= Scan.Modules || Nominal.Kind !=
            Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Record {
        return false;
    }
    let View: Sourceˉset.Compilerˉsourceˉsetˉview =
        Sourceˉset.Compilerˉsourceˉsetˉmodule(Input, Scan, Nominal.Module);
    return Compilerˉsourceˉwvbˉfoundationˉidentityˉisˉexact(
        View.Source, View.Edition, Nominal.Nameˉoffset, Nominal.Nameˉlength,
        "Foundationˉunsafe", "Foreignˉwriteˉregion",
        Sourceˉdeclarations.Compilerˉsourceˉprofile.System
    );
}

fn Compilerˉsourceˉwvbˉshapeˉisˉownedˉaggregate(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Bindings: Sourceˉbindings.Compilerˉsourceˉbindingˉsummary,
    Wir: bytes,
    Shape: u32,
    Orders: Compilerˉsourceˉwvbˉsymbolˉorders
) -> bool {
    return Compilerˉsourceˉwvbˉshapeˉisˉnewˉownedˉaggregate(
            Wir, Shape, Orders
        ) || Compilerˉsourceˉwvbˉshapeˉisˉunsafeˉscratch(
            Input, Scan, Symbols, Bindings, Shape
        ) || Compilerˉsourceˉwvbˉshapeˉisˉunsafeˉwriteˉregion(
            Input, Scan, Symbols, Bindings, Shape
        );
}

fn Compilerˉsourceˉwvbˉshapeˉrequiresˉownedˉtake(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Bindings: Sourceˉbindings.Compilerˉsourceˉbindingˉsummary,
    Wir: bytes,
    Shape: u32,
    Orders: Compilerˉsourceˉwvbˉsymbolˉorders
) -> bool {
    return Compilerˉsourceˉwvbˉshapeˉrequiresˉtake(
            Wir, Shape, Orders
        ) || Compilerˉsourceˉwvbˉshapeˉisˉunsafeˉscratch(
            Input, Scan, Symbols, Bindings, Shape
        ) || Compilerˉsourceˉwvbˉshapeˉisˉunsafeˉwriteˉregion(
            Input, Scan, Symbols, Bindings, Shape
        );
}

fn Compilerˉsourceˉwvbˉshapeˉrequiresˉtake(
    Wir: bytes,
    Shape: u32,
    Orders: Compilerˉsourceˉwvbˉsymbolˉorders
) -> bool {
    if Shape == 805306368u32 ||
        Compilerˉsourceˉwvbˉshapeˉisˉaffineˉresult(Wir, Shape) {
        return true;
    }
    return Compilerˉsourceˉwvbˉshapeˉcontainsˉownedˉvector(
        Wir, Shape, Orders
    );
}

fn Compilerˉsourceˉwvbˉshapeˉisˉownedˉvector(
    Shape: u32,
    Orders: Compilerˉsourceˉwvbˉsymbolˉorders
) -> bool {
    let Entry: u32 = Compilerˉsourceˉwvbˉgenericˉnominalˉentry(
        Shape, Orders
    );
    return Entry != 4294967295u32 && Bytesˉreadˉu32ˉlittle(
        Orders.Genericˉnominalˉentries, Entry + 8u32
    ) == 11u32;
}

export fn Compilerˉsourceˉwvbˉtemporariesˉoffset(Wir: bytes) -> u32 {
    return Compilerˉsourceˉwvbˉoperationsˉoffset(Wir) +
        Bytesˉreadˉu32ˉlittle(Wir, 24u32) * 28u32;
}

export fn Compilerˉsourceˉwvbˉoperandsˉoffset(Wir: bytes) -> u32 {
    return Compilerˉsourceˉwvbˉtemporariesˉoffset(Wir) +
        Bytesˉreadˉu32ˉlittle(Wir, 32u32) * 4u32;
}

export fn Compilerˉsourceˉwvbˉanalysisˉfailure(
    Wir: bytes,
    Status: Compilerˉsourceˉwvbˉstatus,
    Operation: u32
) -> Compilerˉsourceˉwvbˉanalysis {
    return Compilerˉsourceˉwvbˉanalysisˉruleˉfailure(
        Wir, Status, Operation, Enumˉname(Status)
    );
}

fn Compilerˉsourceˉwvbˉanalysisˉruleˉfailure(
    Wir: bytes,
    Status: Compilerˉsourceˉwvbˉstatus,
    Operation: u32,
    Rule: text
) -> Compilerˉsourceˉwvbˉanalysis {
    return Compilerˉsourceˉwvbˉanalysis(
        Status, 0u32, 0u32, Compilerˉsourceˉwvbˉempty(Wir),
        Compilerˉsourceˉwvbˉempty(Wir), Operation, Rule
    );
}

export fn Compilerˉsourceˉwvbˉphiˉpreludeˉlength(
    Wir: bytes,
    Firstˉblock: u32,
    Predecessor: u32,
    Targetˉblock: u32
) -> u32 {
    let Blocksˉoffset: u32 = Compilerˉsourceˉwvbˉblocksˉoffset(Wir);
    let Targetˉentry: u32 = Blocksˉoffset + (Firstˉblock + Targetˉblock) * 28u32;
    if Bytesˉreadˉu32ˉlittle(Wir, Targetˉentry + 8u32) == 0u32 { return 0u32; }
    let Firstˉoperation: u32 = Bytesˉreadˉu32ˉlittle(Wir, Targetˉentry + 4u32);
    let Operationˉentry: u32 = Compilerˉsourceˉwvbˉoperationsˉoffset(Wir) +
        Firstˉoperation * 28u32;
    if Bytesˉreadˉu16ˉlittle(Wir, Operationˉentry + 4u32) != 64u32 { return 0u32; }
    if Bytesˉreadˉu32ˉlittle(Wir, Operationˉentry + 20u32) == Predecessor {
        return 10u32;
    }
    if Bytesˉreadˉu32ˉlittle(Wir, Operationˉentry + 24u32) == Predecessor {
        return 10u32;
    }
    return 0u32;
}

fn Compilerˉsourceˉwvbˉvectorˉborrowˉsource(Sources: bytes, Temporary: u32) -> u32 {
    if Temporary >= Bytesˉlength(Sources) / 4u32 { return 0u32; }
    return Bytesˉreadˉu32ˉlittle(Sources, Temporary * 4u32);
}

// Indices are checked by the planner before updating these fixed-width cells.
fn Compilerˉsourceˉwvbˉvectorˉborrowˉset(State: bytes, Index: u32, Value: u32) -> bytes {
    let Offset: u32 = Index * 4u32;
    return Bytesˉconcat(
        Bytesˉconcat(Bytesˉslice(State, 0u32, Offset), Bytesˉfromˉu32ˉlittle(Value)),
        Bytesˉslice(State, Offset + 4u32, Bytesˉlength(State) - Offset - 4u32)
    );
}

// Complete WVIR validation proves single-use, same-block owned temporaries.
// Revisions additionally prove that delaying a Vector load to its borrowed call
// cannot observe a replaced/moved owner or overlap a mutating argument.
fn Compilerˉsourceˉwvbˉbuildˉvectorˉborrowˉplan(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Bindings: Sourceˉbindings.Compilerˉsourceˉbindingˉsummary,
    Orders: Compilerˉsourceˉwvbˉsymbolˉorders,
    Wir: bytes,
    Function: u32
) -> Compilerˉsourceˉwvbˉvectorˉborrowˉplan {
    let Empty: bytes = Compilerˉsourceˉwvbˉempty(Wir);
    let Functionˉentry: u32 = Sourceˉwir.Compilerˉsourceˉwirˉfunctionsˉoffset(Wir) + Function * 48u32;
    let Firstˉoperation: u32 = Bytesˉreadˉu32ˉlittle(Wir, Functionˉentry + 12u32);
    let Invalid: Compilerˉsourceˉwvbˉvectorˉborrowˉplan =
        Compilerˉsourceˉwvbˉvectorˉborrowˉplan(false, Empty, Firstˉoperation);
    let Operationˉcount: u32 = Bytesˉreadˉu32ˉlittle(Wir, Functionˉentry + 16u32);
    let Temporaryˉcount: u32 = Bytesˉreadˉu32ˉlittle(Wir, Functionˉentry + 24u32);
    let Slotˉcount: u32 = Bytesˉreadˉu32ˉlittle(Wir, Functionˉentry + 36u32) +
        Bytesˉreadˉu32ˉlittle(Wir, Functionˉentry + 40u32);
    let Operations: u32 = Compilerˉsourceˉwvbˉoperationsˉoffset(Wir);
    let Operands: u32 = Compilerˉsourceˉwvbˉoperandsˉoffset(Wir);
    var Candidates: bytes = Empty;
    var Capturedˉrevisions: bytes = Empty;
    var Capturedˉaccesses: bytes = Empty;
    var Slotˉrevisions: bytes = Empty;
    var Slotˉaccesses: bytes = Empty;
    var Sources: bytes = Empty;
    var Hasˉborrow: bool = false;
    var Index: u32 = 0u32;
    while Index < Operationˉcount {
        let Entry: u32 = Operations + (Firstˉoperation + Index) * 28u32;
        let Kind: u32 = Bytesˉreadˉu16ˉlittle(Wir, Entry + 4u32);
        if Kind == 7u32 {
            let Shape: u32 = Compilerˉsourceˉwvbˉplannedˉshapeˉvalue(
                Bytesˉreadˉu32ˉlittle(Wir, Entry + 8u32), Symbols, Orders
            );
            if (Shape >= 327680u32 && Shape < 393216u32) || Shape == 805306370u32 {
                // Existing WVIR owned-function bounds: four temporary tables
                // and three slot tables retain at most 66,304 bytes, independent
                // of loop trips. No table is allocated in Vector-load-free code.
                if Temporaryˉcount > 4096u32 || Operationˉcount > 4096u32 || Slotˉcount > 64u32 {
                    return Invalid;
                }
                let Loadedˉtemporary: u32 = Bytesˉreadˉu32ˉlittle(Wir, Entry + 12u32);
                let Loadedˉorigin: u32 = Bytesˉreadˉu32ˉlittle(Wir, Entry + 20u32);
                if Loadedˉtemporary >= Temporaryˉcount || Loadedˉorigin >= Slotˉcount { return Invalid; }
                if Bytesˉlength(Candidates) == 0u32 {
                    let Zeroes: Byteˉconstruction.Foundationˉbytesˉresult =
                        Byteˉconstruction.Foundationˉbytesˉrepeat(0u8, Temporaryˉcount * 4u32);
                    if !Zeroes.Valid { return Invalid; }
                    Candidates = Zeroes.Value;
                    Capturedˉrevisions = Zeroes.Value;
                    Capturedˉaccesses = Zeroes.Value;
                    Sources = Zeroes.Value;
                    let Slots: Byteˉconstruction.Foundationˉbytesˉresult =
                        Byteˉconstruction.Foundationˉbytesˉrepeat(0u8, Slotˉcount * 4u32);
                    if !Slots.Valid { return Invalid; }
                    Slotˉrevisions = Slots.Value;
                    Slotˉaccesses = Slots.Value;
                }
                Candidates = Compilerˉsourceˉwvbˉvectorˉborrowˉset(Candidates, Loadedˉtemporary, Loadedˉorigin + 1u32);
                Capturedˉrevisions = Compilerˉsourceˉwvbˉvectorˉborrowˉset(
                    Capturedˉrevisions, Loadedˉtemporary,
                    Compilerˉsourceˉwvbˉvectorˉborrowˉsource(Slotˉrevisions, Loadedˉorigin)
                );
                Capturedˉaccesses = Compilerˉsourceˉwvbˉvectorˉborrowˉset(
                    Capturedˉaccesses, Loadedˉtemporary,
                    Compilerˉsourceˉwvbˉvectorˉborrowˉsource(Slotˉaccesses, Loadedˉorigin)
                );
            }
        }
        if Bytesˉlength(Candidates) != 0u32 {
            let Target: u32 = Bytesˉreadˉu32ˉlittle(Wir, Entry + 20u32);
            let First: u32 = Bytesˉreadˉu32ˉlittle(Wir, Entry + 16u32);
            let Count: u32 = Bytesˉreadˉu16ˉlittle(Wir, Entry + 6u32);
            let Emptyˉmodes: Byteˉconstruction.Foundationˉbytesˉresult =
                Byteˉconstruction.Foundationˉbytesˉrepeat(0u8, Slotˉcount * 4u32);
            if !Emptyˉmodes.Valid { return Invalid; }
            var Modes: bytes = Emptyˉmodes.Value;
            var Operand: u32 = 0u32;
            while Operand < Count {
                let Temporary: u32 = Bytesˉreadˉu32ˉlittle(Wir, Operands + (First + Operand) * 4u32);
                let Origin: u32 = Compilerˉsourceˉwvbˉvectorˉborrowˉsource(Candidates, Temporary);
                var Borrowed: bool = false;
                if Origin != 0u32 {
                    if Compilerˉsourceˉwvbˉvectorˉborrowˉsource(Capturedˉrevisions, Temporary) !=
                        Compilerˉsourceˉwvbˉvectorˉborrowˉsource(Slotˉrevisions, Origin - 1u32) {
                        return Compilerˉsourceˉwvbˉvectorˉborrowˉplan(false, Empty, Firstˉoperation + Index);
                    }
                    var Mode: u32 = Sourceˉdeclarations.COMPILER_SOURCE_BORROW_MODE_VALUE;
                    if Kind == 62u32 {
                        Mode = Sourceˉwir.Compilerˉsourceˉwirˉfunctionˉparameterˉborrowˉmode(
                            Input, Scan, Symbols, Bindings, Target, Operand
                        );
                    }
                    Borrowed = Kind == 62u32 &&
                        (Mode == Sourceˉdeclarations.COMPILER_SOURCE_BORROW_MODE_IMMUTABLE ||
                            Mode == Sourceˉdeclarations.COMPILER_SOURCE_BORROW_MODE_MUTABLE);
                    var Access: u32 = 2u32;
                    if Kind == 62u32 && Mode == Sourceˉdeclarations.COMPILER_SOURCE_BORROW_MODE_IMMUTABLE {
                        Access = 1u32;
                    }
                    // Value arguments move at evaluation, and exclusive
                    // arguments exclude later reads before their call too.
                    if Access == 2u32 &&
                        Compilerˉsourceˉwvbˉvectorˉborrowˉsource(Capturedˉaccesses, Temporary) !=
                            Compilerˉsourceˉwvbˉvectorˉborrowˉsource(Slotˉaccesses, Origin - 1u32) {
                        return Compilerˉsourceˉwvbˉvectorˉborrowˉplan(false, Empty, Firstˉoperation + Index);
                    }
                    let Prior: u32 = Compilerˉsourceˉwvbˉvectorˉborrowˉsource(Modes, Origin - 1u32);
                    if Prior != 0u32 && (Prior != 1u32 || Access != 1u32) {
                        return Compilerˉsourceˉwvbˉvectorˉborrowˉplan(false, Empty, Firstˉoperation + Index);
                    }
                    Modes = Compilerˉsourceˉwvbˉvectorˉborrowˉset(Modes, Origin - 1u32, Access);
                }
                if Borrowed {
                    Sources = Compilerˉsourceˉwvbˉvectorˉborrowˉset(Sources, Temporary, Origin);
                    Hasˉborrow = true;
                }
                Operand = Operand + 1u32;
            }
            var Slot: u32 = 0u32;
            while Slot < Slotˉcount {
                if Compilerˉsourceˉwvbˉvectorˉborrowˉsource(Modes, Slot) != 0u32 {
                    Slotˉaccesses = Compilerˉsourceˉwvbˉvectorˉborrowˉset(Slotˉaccesses, Slot, Index + 1u32);
                }
                if Compilerˉsourceˉwvbˉvectorˉborrowˉsource(Modes, Slot) == 2u32 {
                    Slotˉrevisions = Compilerˉsourceˉwvbˉvectorˉborrowˉset(Slotˉrevisions, Slot, Index + 1u32);
                }
                Slot = Slot + 1u32;
            }
            // Store, freeze, append, release, replacement and growth can change
            // a direct Vector slot without mentioning it as an operand.
            if (Kind == 8u32 || Kind == 170u32 || Kind == 173u32 ||
                    Kind == 174u32 || Kind == 175u32 || Kind == 193u32 || Kind == 194u32 ||
                    (Kind >= 196u32 && Kind <= 201u32)) &&
                Target < Slotˉcount {
                Slotˉrevisions = Compilerˉsourceˉwvbˉvectorˉborrowˉset(Slotˉrevisions, Target, Index + 1u32);
                Slotˉaccesses = Compilerˉsourceˉwvbˉvectorˉborrowˉset(Slotˉaccesses, Target, Index + 1u32);
            }
            if (Kind == 169u32 || Kind == 192u32) && Target < Slotˉcount {
                Slotˉaccesses = Compilerˉsourceˉwvbˉvectorˉborrowˉset(Slotˉaccesses, Target, Index + 1u32);
            }
        }
        Index = Index + 1u32;
    }
    if !Hasˉborrow { Sources = Empty; }
    return Compilerˉsourceˉwvbˉvectorˉborrowˉplan(true, Sources, 0u32);
}

fn Compilerˉsourceˉwvbˉvectorˉborrowsˉretainˉprojections(
    Plan: Compilerˉsourceˉwvbˉvectorˉborrowˉplan,
    Foundationˉplan: Foundationˉborrows.Borrowˉplan
) -> Compilerˉsourceˉwvbˉvectorˉborrowˉplan {
    if !Plan.Valid || !Foundationˉplan.Valid || !Foundationˉplan.Hasˉborrow { return Plan; }
    var Sources: bytes = Plan.Sources;
    var Hasˉdirect: bool = false;
    var Temporary: u32 = 0u32;
    while Temporary < Bytesˉlength(Sources) / 4u32 {
        let Origin: u32 = Compilerˉsourceˉwvbˉvectorˉborrowˉsource(Sources, Temporary);
        // A payload view retains its original owner's provenance through an
        // explicit borrowed temporary. Only direct Vector owners may be elided.
        if Origin != 0u32 &&
            (Bytesˉreadˉu8(Foundationˉplan.Temporaryˉstate, Temporary) != 0u8 ||
                Bytesˉreadˉu8(Foundationˉplan.Slotˉstate, Origin - 1u32) != 0u8) {
            Sources = Compilerˉsourceˉwvbˉvectorˉborrowˉset(Sources, Temporary, 0u32);
        } else if Origin != 0u32 {
            Hasˉdirect = true;
        }
        Temporary = Temporary + 1u32;
    }
    if !Hasˉdirect { Sources = Bytesˉslice(Sources, 0u32, 0u32); }
    return Compilerˉsourceˉwvbˉvectorˉborrowˉplan(true, Sources, Plan.Failureˉoperation);
}

fn Compilerˉsourceˉwvbˉplanˉbuilderˉownedˉshapes(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Catalog: Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog
) -> bytes {
    var Foundˉbytes: bool = false;
    var Module: u32 = 0u32;
    while Module < Scan.Modules {
        let View: Sourceˉset.Compilerˉsourceˉsetˉview = Sourceˉset.Compilerˉsourceˉsetˉmodule(Input, Scan, Module);
        let Header: Sourceˉdeclarations.Compilerˉsourceˉheader = Sourceˉdeclarations.Compilerˉparseˉheaderˉvalidated(View.Source);
        if View.Edition == 1u32 && Header.Profile == Sourceˉdeclarations.Compilerˉsourceˉprofile.Portable &&
            Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(View.Source, Header.Nameˉoffset, Header.Nameˉlength, "Foundationˉbytes") {
            Foundˉbytes = true;
        }
        Module = Module + 1u32;
    }
    var Result: bytes = Compilerˉsourceˉwvbˉempty(Input);
    if !Foundˉbytes { return Result; }
    if Symbols.Records > 1024u32 || Symbols.Variants > 1024u32 - Symbols.Records {
        return Bytesˉfromˉu32ˉlittle(4294967295u32);
    }
    var Index: u32 = 0u32;
    while Index < Symbols.Records + Symbols.Variants {
        var Shape: u32 = 65536u32 + Index;
        if Index >= Symbols.Records { Shape = 196608u32 + Symbols.Enums + Index; }
        let Nominal: Sourceˉsymbols.Compilerˉsourceˉsymbolˉmatch = Compilerˉsourceˉwvbˉnominalˉbyˉshape(Scan, Symbols, Shape);
        if !Nominal.Found { return Bytesˉfromˉu32ˉlittle(4294967295u32); }
        if !Compilerˉsourceˉwvbˉnominalˉisˉtemplate(Input, Scan, Symbols, Nominal.Directoryˉindex) {
            let Presence: u32 = Genericˉlayouts.Compilerˉsourceˉgenericˉtypeˉbytesˉbuilderˉpresence(Input, Scan, Symbols, Catalog, Shape);
            if Presence == 0u32 { return Bytesˉfromˉu32ˉlittle(4294967295u32); }
            if Presence == 2u32 { Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Shape)); }
        }
        Index = Index + 1u32;
    }
    return Result;
}

fn Compilerˉsourceˉwvbˉnominalˉbyˉshape(
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Shape: u32
) -> Sourceˉsymbols.Compilerˉsourceˉsymbolˉmatch {
    if Shape < 65536u32 || Shape >= 262144u32 {
        return Sourceˉsymbols.Compilerˉsourceˉsymbolsˉmatchˉnone(Scan.Modules);
    }
    var Wanted: u32 = Shape - 65536u32;
    if Shape >= 131072u32 { Wanted = Shape - 131072u32; }
    if Shape >= 196608u32 { Wanted = Shape - 196608u32; }
    if Wanted >= Symbols.Records + Symbols.Enums + Symbols.Variants {
        return Sourceˉsymbols.Compilerˉsourceˉsymbolsˉmatchˉnone(Scan.Modules);
    }
    let Entries: u32 = Bytesˉreadˉu32ˉlittle(Symbols.Directory, 8u32);
    return Sourceˉsymbols.Compilerˉsourceˉsymbolsˉdirectoryˉentry(
        Symbols.Directory, Scan.Modules,
        Bytesˉreadˉu32ˉlittle(Symbols.Lookup, 4112u32 + Entries * 4u32 + Wanted * 4u32)
    );
}

fn Compilerˉsourceˉwvbˉcanonicalˉmemoryˉnominal(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Nominal: Sourceˉsymbols.Compilerˉsourceˉsymbolˉmatch,
    Module: u32,
    Name: text,
    Kind: Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind
) -> bool {
    if !Nominal.Found || Nominal.Module != Module || Module >= Scan.Modules || Nominal.Kind != Kind { return false; }
    let View: Sourceˉset.Compilerˉsourceˉsetˉview = Sourceˉset.Compilerˉsourceˉsetˉmodule(Input, Scan, Module);
    return Compilerˉsourceˉwvbˉfoundationˉidentityˉisˉexact(
        View.Source, View.Edition, Nominal.Nameˉoffset, Nominal.Nameˉlength,
        "Foundationˉmemory", Name,
        Sourceˉdeclarations.Compilerˉsourceˉprofile.Portable
    );
}

fn Compilerˉsourceˉwvbˉencodedˉtypesˉequal(Actual: bytes, Expected: bytes) -> bool {
    return Bytesˉlength(Actual) == Bytesˉlength(Expected) && Sourceˉset.Compilerˉsourceˉspansˉequal(
        Actual, 0u32, Bytesˉlength(Actual), Expected, 0u32, Bytesˉlength(Expected)
    );
}

fn Compilerˉsourceˉwvbˉresolveˉbytesˉresultˉindices(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Orders: Compilerˉsourceˉwvbˉsymbolˉorders,
    Shape: u32,
    Memory: u32,
    Construct: bool
) -> Compilerˉsourceˉwvbˉbytesˉresultˉindices {
    let Missing: Compilerˉsourceˉwvbˉbytesˉresultˉindices = Compilerˉsourceˉwvbˉbytesˉresultˉindices(false, 0u32, 0u32, 0u32);
    if !Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉshapeˉisˉprivate(Shape) || Memory >= Scan.Modules { return Missing; }
    let Catalog: Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog =
        Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog(Sourceˉgenerics.Compilerˉsourceˉgenericˉstatus.Valid, Orders.Genericˉtypeˉevidence);
    let Layout: Genericˉlayouts.Compilerˉsourceˉgenericˉtypeˉlayout = Genericˉlayouts.Compilerˉsourceˉgenericˉtypeˉlayoutˉcreate(
        Input, Scan, Symbols, Catalog, Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉshapeˉinstance(Shape)
    );
    if Layout.Shape != Shape || Layout.Kind != Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Variant ||
        Layout.Items != 2u32 || Layout.Fields != 2u32 || !Genericˉlayouts.Compilerˉsourceˉgenericˉtypeˉlayoutˉisˉvalid(Input, Scan, Symbols, Layout) {
        return Missing;
    }
    let Resultˉnominal: Sourceˉsymbols.Compilerˉsourceˉsymbolˉmatch =
        Sourceˉsymbols.Compilerˉsourceˉsymbolsˉdirectoryˉentry(Symbols.Directory, Scan.Modules, Layout.Declaration);
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉfoundationˉgenericˉfamily(Input, Scan, Resultˉnominal) != 2u32 { return Missing; }
    let Valid: Genericˉlayouts.Compilerˉsourceˉgenericˉtypeˉcase = Genericˉlayouts.Compilerˉsourceˉgenericˉtypeˉlayoutˉvariantˉcase(Input, Scan, Symbols, Layout, 0u32);
    let Failure: Genericˉlayouts.Compilerˉsourceˉgenericˉtypeˉcase = Genericˉlayouts.Compilerˉsourceˉgenericˉtypeˉlayoutˉvariantˉcase(Input, Scan, Symbols, Layout, 1u32);
    let Value: Genericˉlayouts.Compilerˉsourceˉgenericˉtypeˉfield = Genericˉlayouts.Compilerˉsourceˉgenericˉtypeˉlayoutˉvariantˉfield(Input, Scan, Symbols, Layout, 0u32, 0u32);
    let Error: Genericˉlayouts.Compilerˉsourceˉgenericˉtypeˉfield = Genericˉlayouts.Compilerˉsourceˉgenericˉtypeˉlayoutˉvariantˉfield(Input, Scan, Symbols, Layout, 1u32, 0u32);
    var Valueˉshape: u32 = 9u32;
    if Construct { Valueˉshape = 805306370u32; }
    if !Valid.Found || Valid.Fields != 1u32 || !Failure.Found || Failure.Fields != 1u32 ||
        !Value.Found || Value.Shape != Valueˉshape || !Error.Found { return Missing; }
    let Resultˉview: Sourceˉset.Compilerˉsourceˉsetˉview = Sourceˉset.Compilerˉsourceˉsetˉmodule(Input, Scan, Layout.Module);
    if !Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Resultˉview.Source, Valid.Nameˉoffset, Valid.Nameˉlength, "Valid") ||
        !Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Resultˉview.Source, Failure.Nameˉoffset, Failure.Nameˉlength, "Failure") ||
        !Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Resultˉview.Source, Value.Nameˉoffset, Value.Nameˉlength, "Value") ||
        !Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Resultˉview.Source, Error.Nameˉoffset, Error.Nameˉlength, "Error") { return Missing; }
    let Failureˉnominal: Sourceˉsymbols.Compilerˉsourceˉsymbolˉmatch = Compilerˉsourceˉwvbˉnominalˉbyˉshape(Scan, Symbols, Error.Shape);
    let View: Sourceˉset.Compilerˉsourceˉsetˉview = Sourceˉset.Compilerˉsourceˉsetˉmodule(Input, Scan, Memory);
    let Header: Sourceˉdeclarations.Compilerˉsourceˉheader = Sourceˉdeclarations.Compilerˉparseˉheaderˉvalidated(View.Source);
    let Resultˉtarget: u32 = Compilerˉsourceˉwvbˉplannedˉshapeˉvalue(Shape, Symbols, Orders);
    if Resultˉtarget < 196608u32 || Resultˉtarget >= 262144u32 { return Missing; }
    if Construct {
        if !Compilerˉsourceˉwvbˉcanonicalˉmemoryˉnominal(Input, Scan, Failureˉnominal, Memory, "Allocationˉfailure", Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Record) { return Missing; }
        let Declaration: Sourceˉdeclarations.Compilerˉsourceˉdeclaration = Compilerˉsourceˉwvbˉdeclaration(View.Source, Header, Symbols, Failureˉnominal.Directoryˉindex);
        let Brace: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(View.Source, Declaration.Bodyˉoffset, 1u32, 1u32);
        let Field: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(View.Source, Brace.Nextˉoffset, Brace.Nextˉline, Brace.Nextˉcolumn);
        let Colon: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(View.Source, Field.Nextˉoffset, Field.Nextˉline, Field.Nextˉcolumn);
        let Bound: Sourceˉsymbols.Compilerˉsourceˉtypeˉbinding = Sourceˉsymbols.Compilerˉsourceˉsymbolsˉbindˉtype(
            Input, Scan, Symbols.Directory, Symbols.Lookup, Symbols.Visibility, Memory, View.Source,
            Colon.Nextˉoffset, Colon.Nextˉline, Colon.Nextˉcolumn, Symbols.Records, Symbols.Enums, true
        );
        let Reasonˉshape: u32 = Sourceˉbindings.Compilerˉsourceˉbindingsˉshape(Bound);
        let Reason: Sourceˉsymbols.Compilerˉsourceˉsymbolˉmatch = Compilerˉsourceˉwvbˉnominalˉbyˉshape(Scan, Symbols, Reasonˉshape);
        if Bound.Status != Sourceˉsymbols.Compilerˉsourceˉsymbolˉstatus.Valid || !Compilerˉsourceˉwvbˉcanonicalˉmemoryˉnominal(
                Input, Scan, Reason, Memory, "Allocationˉreason", Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Enum
            ) { return Missing; }
        let Failureˉtarget: u32 = Compilerˉsourceˉwvbˉplannedˉshapeˉvalue(Error.Shape, Symbols, Orders);
        let Reasonˉtarget: u32 = Compilerˉsourceˉwvbˉplannedˉshapeˉvalue(Reasonˉshape, Symbols, Orders);
        if Failureˉtarget < 65536u32 || Failureˉtarget >= 131072u32 || Reasonˉtarget < 131072u32 || Reasonˉtarget >= 196608u32 { return Missing; }
        var Expectedˉreason: bytes = Bytesˉconcat(Bytesˉfromˉu8(7u8), Compilerˉsourceˉwvbˉencodedˉstring(Compilerˉsourceˉwvbˉsymbolˉname(Input, Scan, Symbols, Reason.Directoryˉindex)));
        Expectedˉreason = Bytesˉconcat(Expectedˉreason, Bytesˉfromˉu8(6u8));
        Expectedˉreason = Bytesˉconcat(Expectedˉreason, Bytesˉfromˉu32ˉlittle(4u32));
        var Index: u32 = 0u32;
        while Index < 4u32 {
            var Name: text = "Budgetˉexhausted";
            if Index == 1u32 { Name = "Targetˉunaddressable"; }
            if Index == 2u32 { Name = "Providerˉunavailable"; }
            if Index == 3u32 { Name = "Fragmented"; }
            Expectedˉreason = Bytesˉconcat(Expectedˉreason, Compilerˉsourceˉwvbˉencodedˉstring(Textˉtoˉutf8(Name)));
            Expectedˉreason = Bytesˉconcat(Expectedˉreason, Compilerˉsourceˉwvbˉlowˉbyte(Index + 1u32));
            Index = Index + 1u32;
        }
        let Encodedˉreason: Compilerˉsourceˉwvbˉtypeˉencoding = Compilerˉsourceˉwvbˉencodeˉenumˉtype(Input, Scan, View.Source, Header, Symbols, Reason.Directoryˉindex);
        if Encodedˉreason.Status != Compilerˉsourceˉwvbˉstatus.Valid || !Compilerˉsourceˉwvbˉencodedˉtypesˉequal(Encodedˉreason.Payload, Expectedˉreason) { return Missing; }
        var Expected: bytes = Bytesˉconcat(Bytesˉfromˉu8(1u8), Compilerˉsourceˉwvbˉencodedˉstring(Compilerˉsourceˉwvbˉsymbolˉname(Input, Scan, Symbols, Failureˉnominal.Directoryˉindex)));
        Expected = Bytesˉconcat(Expected, Bytesˉfromˉu32ˉlittle(3u32));
        Expected = Bytesˉconcat(Expected, Compilerˉsourceˉwvbˉencodedˉstring(Textˉtoˉutf8("Reason")));
        Expected = Bytesˉconcat(Expected, Compilerˉsourceˉwvbˉinstructionˉu32(8u8, Reasonˉtarget - 131072u32));
        Expected = Bytesˉconcat(Expected, Compilerˉsourceˉwvbˉencodedˉstring(Textˉtoˉutf8("Requestedˉbytes")));
        Expected = Bytesˉconcat(Expected, Bytesˉfromˉu8(10u8));
        Expected = Bytesˉconcat(Expected, Compilerˉsourceˉwvbˉencodedˉstring(Textˉtoˉutf8("Availableˉbytes")));
        Expected = Bytesˉconcat(Expected, Bytesˉfromˉu8(10u8));
        let Encoded: Compilerˉsourceˉwvbˉtypeˉencoding = Compilerˉsourceˉwvbˉencodeˉrecordˉtype(Input, Scan, View.Source, Header, Symbols, Orders, Failureˉnominal.Directoryˉindex);
        if Encoded.Status != Compilerˉsourceˉwvbˉstatus.Valid || !Compilerˉsourceˉwvbˉencodedˉtypesˉequal(Encoded.Payload, Expected) { return Missing; }
        return Compilerˉsourceˉwvbˉbytesˉresultˉindices(true, Resultˉtarget - 196608u32, Failureˉtarget - 65536u32, Reasonˉtarget - 131072u32);
    }
    if !Compilerˉsourceˉwvbˉcanonicalˉmemoryˉnominal(Input, Scan, Failureˉnominal, Memory, "Limitˉfailure", Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Variant) { return Missing; }
    let Limitˉfailureˉtarget: u32 = Compilerˉsourceˉwvbˉplannedˉshapeˉvalue(Error.Shape, Symbols, Orders);
    if Limitˉfailureˉtarget < 196608u32 || Limitˉfailureˉtarget >= 262144u32 { return Missing; }
    var Expectedˉlimitˉfailure: bytes = Bytesˉconcat(Bytesˉfromˉu8(3u8), Compilerˉsourceˉwvbˉencodedˉstring(Compilerˉsourceˉwvbˉsymbolˉname(Input, Scan, Symbols, Failureˉnominal.Directoryˉindex)));
    Expectedˉlimitˉfailure = Bytesˉconcat(Expectedˉlimitˉfailure, Bytesˉfromˉu32ˉlittle(2u32));
    Expectedˉlimitˉfailure = Bytesˉconcat(Expectedˉlimitˉfailure, Compilerˉsourceˉwvbˉencodedˉstring(Textˉtoˉutf8("Maximumˉexceeded")));
    Expectedˉlimitˉfailure = Bytesˉconcat(Expectedˉlimitˉfailure, Bytesˉfromˉu8(2u8));
    Expectedˉlimitˉfailure = Bytesˉconcat(Expectedˉlimitˉfailure, Bytesˉfromˉu32ˉlittle(2u32));
    Expectedˉlimitˉfailure = Bytesˉconcat(Expectedˉlimitˉfailure, Compilerˉsourceˉwvbˉencodedˉstring(Textˉtoˉutf8("Requested")));
    Expectedˉlimitˉfailure = Bytesˉconcat(Expectedˉlimitˉfailure, Bytesˉfromˉu8(10u8));
    Expectedˉlimitˉfailure = Bytesˉconcat(Expectedˉlimitˉfailure, Compilerˉsourceˉwvbˉencodedˉstring(Textˉtoˉutf8("Maximum")));
    Expectedˉlimitˉfailure = Bytesˉconcat(Expectedˉlimitˉfailure, Bytesˉfromˉu8(10u8));
    Expectedˉlimitˉfailure = Bytesˉconcat(Expectedˉlimitˉfailure, Compilerˉsourceˉwvbˉencodedˉstring(Textˉtoˉutf8("Arithmeticˉoverflow")));
    Expectedˉlimitˉfailure = Bytesˉconcat(Expectedˉlimitˉfailure, Bytesˉfromˉu8(0u8));
    let Encodedˉlimitˉfailure: Compilerˉsourceˉwvbˉtypeˉencoding = Compilerˉsourceˉwvbˉencodeˉvariantˉtype(Input, Scan, View.Source, Header, Symbols, Orders, Failureˉnominal.Directoryˉindex);
    if Encodedˉlimitˉfailure.Status != Compilerˉsourceˉwvbˉstatus.Valid || !Compilerˉsourceˉwvbˉencodedˉtypesˉequal(Encodedˉlimitˉfailure.Payload, Expectedˉlimitˉfailure) { return Missing; }
    return Compilerˉsourceˉwvbˉbytesˉresultˉindices(true, Resultˉtarget - 196608u32, Limitˉfailureˉtarget - 196608u32, 0u32);
}

fn Compilerˉsourceˉwvbˉvectorˉoperationˉisˉvalid(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Bindings: Sourceˉbindings.Compilerˉsourceˉbindingˉsummary,
    Wir: bytes,
    Function: u32,
    Operationˉentry: u32,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Orders: Compilerˉsourceˉwvbˉsymbolˉorders
) -> bool {
    let Functionˉentry: u32 =
        Sourceˉwir.Compilerˉsourceˉwirˉfunctionsˉoffset(Wir) + Function * 48u32;
    let Parameters: u32 = Bytesˉreadˉu32ˉlittle(Wir, Functionˉentry + 36u32);
    let Locals: u32 = Bytesˉreadˉu32ˉlittle(Wir, Functionˉentry + 40u32);
    let Operation: u32 = Bytesˉreadˉu16ˉlittle(Wir, Operationˉentry + 4u32);
    let Shape: u32 = Bytesˉreadˉu32ˉlittle(Wir, Operationˉentry + 8u32);
    let Target: u32 = Bytesˉreadˉu32ˉlittle(Wir, Operationˉentry + 20u32);
    let Auxiliary: u32 = Bytesˉreadˉu32ˉlittle(Wir, Operationˉentry + 24u32);
    let Operands: u32 = Bytesˉreadˉu16ˉlittle(Wir, Operationˉentry + 6u32);
    if Operation == 169u32 || Operation == 170u32 ||
        Operation == 192u32 || Operation == 193u32 {
        let Plannedˉvector: u32 =
            Compilerˉsourceˉwvbˉplannedˉshapeˉvalue(
                Auxiliary, Symbols, Orders
            );
        if (Target < Parameters && Operation == 170u32) ||
            Target >= Parameters + Locals ||
            Plannedˉvector < 327680u32 ||
            Plannedˉvector >= 393216u32 ||
            (Operation == 192u32 && Operands != 1u32) ||
            (Operation == 193u32 && (Operands != 2u32 ||
                (Shape != 1u32 && Shape != 2u32 && Shape != 3u32 &&
                    Shape != 4u32 && Shape != 7u32 && Shape != 8u32))) {
            return false;
        }
        if Operation == 170u32 {
            let Plannedˉresultˉsequence: u32 =
                Compilerˉsourceˉwvbˉplannedˉshapeˉvalue(
                    Shape, Symbols, Orders
                );
            if Plannedˉresultˉsequence < 393216u32 ||
                Plannedˉresultˉsequence >= 458752u32 {
                return false;
            }
        }
    }
    if Operation == 171u32 {
        let Plannedˉresult: u32 =
            Compilerˉsourceˉwvbˉplannedˉshapeˉvalue(
                Shape, Symbols, Orders
            );
        if Target >= Parameters + Locals ||
            Operands != 2u32 || Plannedˉresult < 196608u32 ||
            Plannedˉresult >= 262144u32 {
            return false;
        }
        if Target < Parameters &&
            (Sourceˉwir.Compilerˉsourceˉwirˉbindingˉshape(
                Bindings, Bytesˉreadˉu32ˉlittle(Symbols.Directory, 8u32),
                Function, Target
            ) != 805306368u32 ||
                Sourceˉwir.Compilerˉsourceˉwirˉfunctionˉparameterˉborrowˉmode(
                    Input, Scan, Symbols, Bindings, Function, Target
                ) != Sourceˉdeclarations.COMPILER_SOURCE_BORROW_MODE_MUTABLE) {
            return false;
        }
    }
    if Operation == 172u32 {
        let Plannedˉvectorˉresult: u32 =
            Compilerˉsourceˉwvbˉplannedˉshapeˉvalue(
                Shape, Symbols, Orders
            );
        if Target >= Parameters + Locals || Operands != 1u32 ||
            Plannedˉvectorˉresult < 196608u32 ||
            Plannedˉvectorˉresult >= 262144u32 {
            return false;
        }
    }
    if Operation == 173u32 || Operation == 194u32 {
        let Plannedˉappendˉresult: u32 =
            Compilerˉsourceˉwvbˉplannedˉshapeˉvalue(
                Shape, Symbols, Orders
            );
        let Plannedˉappendˉvector: u32 =
            Compilerˉsourceˉwvbˉplannedˉshapeˉvalue(
                Auxiliary, Symbols, Orders
            );
        if (Operation == 173u32 && Target < Parameters) ||
            (Operation == 194u32 && Target >= Parameters) ||
            Target >= Parameters + Locals ||
            Operands != 1u32 || Plannedˉappendˉresult < 196608u32 ||
            Plannedˉappendˉresult >= 262144u32 ||
            Plannedˉappendˉvector < 327680u32 ||
            Plannedˉappendˉvector >= 393216u32 {
            return false;
        }
    }
    if Operation == 174u32 {
        let Plannedˉreleasedˉvector: u32 =
            Compilerˉsourceˉwvbˉplannedˉshapeˉvalue(
                Compilerˉsourceˉwvbˉinferredˉlocalˉshape(
                    Wir, Function, Target
                ), Symbols, Orders
            );
        if Target < Parameters || Target >= Parameters + Locals ||
            Operands != 0u32 || Shape != 0u32 || Auxiliary != 0u32 ||
            ((Plannedˉreleasedˉvector < 327680u32 ||
                Plannedˉreleasedˉvector >= 393216u32) &&
                Plannedˉreleasedˉvector != 805306369u32 && Plannedˉreleasedˉvector != 805306370u32) {
            return false;
        }
    }
    if Operation == 175u32 {
        let Plannedˉgrowˉresult: u32 =
            Compilerˉsourceˉwvbˉplannedˉshapeˉvalue(
                Shape, Symbols, Orders
            );
        let Plannedˉgrowˉvector: u32 =
            Compilerˉsourceˉwvbˉplannedˉshapeˉvalue(
                Compilerˉsourceˉwvbˉinferredˉlocalˉshape(
                    Wir, Function, Target
                ), Symbols, Orders
            );
        if Target < Parameters || Target >= Parameters + Locals ||
            Auxiliary >= Parameters + Locals ||
            Target == Auxiliary || Operands != 1u32 ||
            Plannedˉgrowˉresult < 196608u32 ||
            Plannedˉgrowˉresult >= 262144u32 ||
            Plannedˉgrowˉvector < 327680u32 ||
            Plannedˉgrowˉvector >= 393216u32 {
            return false;
        }
    }
    return true;
}

fn Compilerˉsourceˉwvbˉbytesˉoperationˉisˉvalid(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Bindings: Sourceˉbindings.Compilerˉsourceˉbindingˉsummary,
    Wir: bytes,
    Function: u32,
    Entry: u32,
    Orders: Compilerˉsourceˉwvbˉsymbolˉorders
) -> bool {
    let Operation: u32 = Bytesˉreadˉu16ˉlittle(Wir, Entry + 4u32);
    if Operation < 195u32 || Operation > 207u32 { return true; }
    let Minor: u32 = Bytesˉreadˉu16ˉlittle(Wir, 6u32);
    if Minor != 39u32 && Minor != 40u32 { return false; }
    let Shape: u32 = Bytesˉreadˉu32ˉlittle(Wir, Entry + 8u32);
    let Target: u32 = Bytesˉreadˉu32ˉlittle(Wir, Entry + 20u32);
    let Auxiliary: u32 = Bytesˉreadˉu32ˉlittle(Wir, Entry + 24u32);
    let Count: u32 = Bytesˉreadˉu16ˉlittle(Wir, Entry + 6u32);
    var Expectedˉcount: u32 = 1u32;
    if Operation == 195u32 || Operation == 204u32 || Operation == 206u32 { Expectedˉcount = 2u32; }
    if Operation == 205u32 { Expectedˉcount = 3u32; }
    if Count != Expectedˉcount { return false; }
    let Functionˉentry: u32 = Sourceˉwir.Compilerˉsourceˉwirˉfunctionsˉoffset(Wir) + Function * 48u32;
    let Parameters: u32 = Bytesˉreadˉu32ˉlittle(Wir, Functionˉentry + 36u32);
    let Locals: u32 = Bytesˉreadˉu32ˉlittle(Wir, Functionˉentry + 40u32);
    let Firstˉtemporary: u32 = Bytesˉreadˉu32ˉlittle(Wir, Functionˉentry + 20u32);
    let Firstˉoperand: u32 = Bytesˉreadˉu32ˉlittle(Wir, Entry + 16u32);
    if Operation >= 195u32 && Operation <= 201u32 {
        let Indices: Compilerˉsourceˉwvbˉbytesˉresultˉindices = Compilerˉsourceˉwvbˉresolveˉbytesˉresultˉindices(Input, Scan, Symbols, Orders, Shape, Auxiliary, Operation == 195u32);
        if !Indices.Valid { return false; }
        if Operation == 195u32 {
            if Target != 0u32 { return false; }
        } else {
            if Target >= Parameters + Locals { return false; }
            var Ownerˉshape: u32 = Sourceˉwir.Compilerˉsourceˉwirˉbindingˉshape(Bindings, Bytesˉreadˉu32ˉlittle(Symbols.Directory, 8u32), Function, Target);
            if Ownerˉshape == 0u32 { Ownerˉshape = Compilerˉsourceˉwvbˉinferredˉlocalˉshape(Wir, Function, Target); }
            if Ownerˉshape != 805306370u32 { return false; }
            if Target < Parameters {
                if Sourceˉwir.Compilerˉsourceˉwirˉfunctionˉparameterˉborrowˉmode(Input, Scan, Symbols, Bindings, Function, Target) != Sourceˉdeclarations.COMPILER_SOURCE_BORROW_MODE_MUTABLE { return false; }
            } else {
                let Range: u32 = Sourceˉbindings.Compilerˉsourceˉbindingsˉrangeˉoffset(Bindings.Directory, Function);
                let First: u32 = Bytesˉreadˉu32ˉlittle(Bindings.Directory, Range);
                let Available: u32 = Bytesˉreadˉu32ˉlittle(Bindings.Directory, Range + 4u32);
                if Target >= Available || Bytesˉreadˉu32ˉlittle(Bindings.Directory, Sourceˉbindings.Compilerˉsourceˉbindingsˉentriesˉoffset(Bindings.Directory) + (First + Target) * 36u32 + 8u32) != 3u32 { return false; }
            }
        }
    } else if Operation == 205u32 {
        if Target >= Parameters + Locals || Auxiliary != 6u32 || !Compilerˉsourceˉwvbˉshapeˉisˉbyteˉslice(Shape, Orders) { return false; }
        var Borrowˉownerˉshape: u32 = Sourceˉwir.Compilerˉsourceˉwirˉbindingˉshape(Bindings, Bytesˉreadˉu32ˉlittle(Symbols.Directory, 8u32), Function, Target);
        if Borrowˉownerˉshape == 0u32 { Borrowˉownerˉshape = Compilerˉsourceˉwvbˉinferredˉlocalˉshape(Wir, Function, Target); }
        if Borrowˉownerˉshape != 6u32 { return false; }
    } else {
        if Target != 0u32 || Auxiliary != 0u32 { return false; }
        var Expectedˉshape: u32 = 8u32;
        if Operation == 202u32 { Expectedˉshape = 6u32; }
        if Operation == 204u32 || Operation == 206u32 { Expectedˉshape = 2u32; }
        if Shape != Expectedˉshape { return false; }
    }
    var Operand: u32 = 0u32;
    while Operand < Count {
        let Temporary: u32 = Bytesˉreadˉu32ˉlittle(Wir, Compilerˉsourceˉwvbˉoperandsˉoffset(Wir) + (Firstˉoperand + Operand) * 4u32);
        let Actual: u32 = Bytesˉreadˉu32ˉlittle(Wir, Compilerˉsourceˉwvbˉtemporariesˉoffset(Wir) + (Firstˉtemporary + Temporary) * 4u32);
        var Expected: u32 = 8u32;
        if Operand == 0u32 {
            if Operation == 195u32 { Expected = 805306368u32; }
            if Operation == 196u32 { Expected = 2u32; }
            if Operation == 197u32 { Expected = 3u32; }
            if Operation == 200u32 || (Operation >= 203u32 && Operation <= 205u32) { Expected = 6u32; }
            if Operation == 201u32 { Expected = 5u32; }
            if Operation == 202u32 { Expected = 805306370u32; }
            if Operation == 206u32 || Operation == 207u32 {
                if !Compilerˉsourceˉwvbˉshapeˉisˉbyteˉslice(Actual, Orders) { return false; }
                Expected = Actual;
            }
        }
        if Actual != Expected { return false; }
        Operand = Operand + 1u32;
    }
    return true;
}

fn Compilerˉsourceˉwvbˉresourceˉoperationˉisˉvalid(
    Wir: bytes,
    Function: u32,
    Operationˉentry: u32,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Orders: Compilerˉsourceˉwvbˉsymbolˉorders
) -> bool {
    let Functionˉentry: u32 =
        Sourceˉwir.Compilerˉsourceˉwirˉfunctionsˉoffset(Wir) + Function * 48u32;
    let Parameters: u32 = Bytesˉreadˉu32ˉlittle(Wir, Functionˉentry + 36u32);
    let Locals: u32 = Bytesˉreadˉu32ˉlittle(Wir, Functionˉentry + 40u32);
    let Operation: u32 = Bytesˉreadˉu16ˉlittle(Wir, Operationˉentry + 4u32);
    let Shape: u32 = Bytesˉreadˉu32ˉlittle(Wir, Operationˉentry + 8u32);
    let Target: u32 = Bytesˉreadˉu32ˉlittle(Wir, Operationˉentry + 20u32);
    let Auxiliary: u32 = Bytesˉreadˉu32ˉlittle(Wir, Operationˉentry + 24u32);
    let Operands: u32 = Bytesˉreadˉu16ˉlittle(Wir, Operationˉentry + 6u32);
    if Operation == 180u32 {
        let Plannedˉscopeˉresult: u32 =
            Compilerˉsourceˉwvbˉplannedˉshapeˉvalue(
                Shape, Symbols, Orders
            );
        if Target >= Parameters + Locals ||
            Operands != 2u32 || Auxiliary == 0u32 ||
            Plannedˉscopeˉresult < 196608u32 ||
            Plannedˉscopeˉresult >= 262144u32 {
            return false;
        }
    }
    if Operation == 181u32 {
        let Plannedˉcontext: u32 =
            Compilerˉsourceˉwvbˉplannedˉshapeˉvalue(
                Shape, Symbols, Orders
            );
        if Target >= Parameters + Locals || Operands != 0u32 ||
            Auxiliary != 0u32 || Plannedˉcontext < 65536u32 ||
            Plannedˉcontext >= 131072u32 {
            return false;
        }
    }
    if Operation == 182u32 {
        let Plannedˉspawnˉresult: u32 =
            Compilerˉsourceˉwvbˉplannedˉshapeˉvalue(
                Shape, Symbols, Orders
            );
        let Plannedˉtask: u32 =
            Compilerˉsourceˉwvbˉplannedˉshapeˉvalue(
                Auxiliary, Symbols, Orders
            );
        if Target >= Parameters + Locals || Operands != 1u32 ||
            Plannedˉspawnˉresult < 196608u32 ||
            Plannedˉspawnˉresult >= 262144u32 ||
            Plannedˉtask < 65536u32 || Plannedˉtask >= 131072u32 {
            return false;
        }
    }
    if Operation == 183u32 {
        let Plannedˉoutcome: u32 =
            Compilerˉsourceˉwvbˉplannedˉshapeˉvalue(
                Shape, Symbols, Orders
            );
        if Target >= Parameters + Locals ||
            Auxiliary >= Parameters + Locals ||
            Target == Auxiliary || Operands != 0u32 ||
            Plannedˉoutcome < 196608u32 ||
            Plannedˉoutcome >= 262144u32 {
            return false;
        }
    }
    if Operation == 184u32 {
        let Plannedˉcancellation: u32 =
            Compilerˉsourceˉwvbˉplannedˉshapeˉvalue(
                Shape, Symbols, Orders
            );
        if Target >= Parameters + Locals || Operands != 0u32 ||
            Auxiliary != 0u32 || Plannedˉcancellation < 196608u32 ||
            Plannedˉcancellation >= 262144u32 {
            return false;
        }
    }
    if Operation == 185u32 &&
        (Target < Parameters || Target >= Parameters + Locals ||
            Operands != 0u32 || Shape != 0u32 || Auxiliary > 2u32) {
        return false;
    }
    if Operation == 186u32 {
        let Plannedˉscratchˉresult: u32 =
            Compilerˉsourceˉwvbˉplannedˉshapeˉvalue(
                Shape, Symbols, Orders
            );
        let Plannedˉabi: u32 =
            Compilerˉsourceˉwvbˉplannedˉshapeˉvalue(
                Auxiliary, Symbols, Orders
            );
        if Target >= Parameters + Locals || Operands != 2u32 ||
            Plannedˉscratchˉresult < 196608u32 ||
            Plannedˉscratchˉresult >= 262144u32 ||
            Plannedˉabi < 131072u32 || Plannedˉabi >= 196608u32 {
            return false;
        }
    }
    if Operation == 187u32 {
        let Plannedˉlengthˉabi: u32 =
            Compilerˉsourceˉwvbˉplannedˉshapeˉvalue(
                Auxiliary, Symbols, Orders
            );
        if Target >= Parameters + Locals || Operands != 0u32 ||
            Shape != 8u32 || Plannedˉlengthˉabi < 131072u32 ||
            Plannedˉlengthˉabi >= 196608u32 {
            return false;
        }
    }
    if Operation == 188u32 {
        let Plannedˉregionˉresult: u32 =
            Compilerˉsourceˉwvbˉplannedˉshapeˉvalue(
                Shape, Symbols, Orders
            );
        let Plannedˉregionˉabi: u32 =
            Compilerˉsourceˉwvbˉplannedˉshapeˉvalue(
                Auxiliary, Symbols, Orders
            );
        if Target >= Parameters + Locals || Operands != 3u32 ||
            Plannedˉregionˉresult < 196608u32 ||
            Plannedˉregionˉresult >= 262144u32 ||
            Plannedˉregionˉabi < 131072u32 ||
            Plannedˉregionˉabi >= 196608u32 {
            return false;
        }
    }
    if Operation == 189u32 {
        let Plannedˉpointer: u32 =
            Compilerˉsourceˉwvbˉplannedˉshapeˉvalue(
                Shape, Symbols, Orders
            );
        let Plannedˉpointerˉabi: u32 =
            Compilerˉsourceˉwvbˉplannedˉshapeˉvalue(
                Auxiliary, Symbols, Orders
            );
        if Target >= Parameters + Locals || Operands != 0u32 ||
            Plannedˉpointer < 65536u32 ||
            Plannedˉpointer >= 131072u32 ||
            Plannedˉpointerˉabi < 131072u32 ||
            Plannedˉpointerˉabi >= 196608u32 {
            return false;
        }
    }
    if Operation == 190u32 {
        let Symbolˉentries: u32 = Bytesˉreadˉu32ˉlittle(
            Symbols.Directory, 8u32
        );
        var Plannedˉforeignˉpointer: u32 = 4294967295u32;
        if Operands == 3u32 {
            let Foreignˉfirstˉtemporary: u32 =
                Bytesˉreadˉu32ˉlittle(
                    Wir,
                    Compilerˉsourceˉwvbˉoperandsˉoffset(Wir) +
                        Bytesˉreadˉu32ˉlittle(
                            Wir, Operationˉentry + 16u32
                        ) * 4u32
                );
            let Foreignˉpointerˉshape: u32 =
                Bytesˉreadˉu32ˉlittle(
                    Wir,
                    Compilerˉsourceˉwvbˉtemporariesˉoffset(Wir) +
                        (Bytesˉreadˉu32ˉlittle(
                            Wir, Functionˉentry + 20u32
                        ) + Foreignˉfirstˉtemporary) * 4u32
                );
            Plannedˉforeignˉpointer =
                Compilerˉsourceˉwvbˉplannedˉshapeˉvalue(
                    Foreignˉpointerˉshape, Symbols, Orders
                );
        }
        if Target >= Symbolˉentries || Operands != 3u32 ||
            Shape != 7u32 || Auxiliary != 0u32 ||
            Plannedˉforeignˉpointer < 65536u32 ||
            Plannedˉforeignˉpointer >= 131072u32 ||
            Bytesˉreadˉu32ˉlittle(
                Symbols.Directory, 16u32 + Target * 24u32 + 4u32
            ) != 9u32 ||
            Bytesˉreadˉu32ˉlittle(
                Symbols.Directory, 16u32 + Target * 24u32 + 20u32
            ) != 3u32 {
            return false;
        }
    }
    if Operation == 191u32 {
        let Plannedˉoption: u32 =
            Compilerˉsourceˉwvbˉplannedˉshapeˉvalue(
                Compilerˉsourceˉwvbˉborrowedˉoptionˉvalueˉshape(
                    Shape
                ),
                Symbols,
                Orders
            );
        if Target >= Parameters + Locals || Operands != 0u32 ||
            Auxiliary < 1u32 || Auxiliary > 3u32 ||
            Plannedˉoption < 196608u32 ||
            Plannedˉoption >= 262144u32 {
            return false;
        }
    }
    return true;
}

// Reverse postorder keeps acyclic joins after their predecessors. The explicit
// traversal stack is chunked, bounded, and retains original WVIR target identities.
fn Compilerˉsourceˉwvbˉblockˉorder(Wir: bytes, First: u32, Count: u32) -> bytes {
    let Empty: bytes = Compilerˉsourceˉwvbˉempty(Wir);
    let Total: u32 = Bytesˉreadˉu32ˉlittle(Wir, 16u32);
    if Count == 0u32 || Count > 4096u32 || First > Total || Count > Total - First {
        return Empty;
    }
    var Zeroes: bytes = Bytesˉfromˉu8(0u8);
    while Bytesˉlength(Zeroes) < Count { Zeroes = Bytesˉconcat(Zeroes, Zeroes); }
    var Seen: bytes = Bytesˉslice(Zeroes, 0u32, Count);
    Seen = Bytesˉconcat(Bytesˉfromˉu8(1u8), Bytesˉslice(Seen, 1u32, Count - 1u32));
    var Stack: bytes = Empty;
    var Stackˉchunk: bytes = Bytesˉfromˉu32ˉlittle(0u32);
    var Depth: u32 = 1u32;
    var Postorder: bytes = Empty;
    var Postorderˉchunk: bytes = Empty;
    let Blocks: u32 = Compilerˉsourceˉwvbˉblocksˉoffset(Wir);
    while Depth > 0u32 {
        if Bytesˉlength(Stackˉchunk) == 0u32 {
            let Prefix: u32 = Bytesˉlength(Stack) - 256u32;
            Stackˉchunk = Bytesˉslice(Stack, Prefix, 256u32);
            Stack = Bytesˉslice(Stack, 0u32, Prefix);
        }
        let Top: u32 = Bytesˉlength(Stackˉchunk) - 4u32;
        let Frame: u32 = Bytesˉreadˉu32ˉlittle(Stackˉchunk, Top);
        let Original: u32 = Frame & 65535u32;
        let Successor: u32 = Frame >> 16u32;
        let Entry: u32 = Blocks + (First + Original) * 28u32;
        let Terminator: u32 = Bytesˉreadˉu32ˉlittle(Wir, Entry + 12u32);
        if Terminator < 1u32 || Terminator > 3u32 { return Empty; }
        var Successors: u32 = 0u32;
        if Terminator == 1u32 { Successors = 1u32; }
        if Terminator == 2u32 { Successors = 2u32; }
        if Successor < Successors {
            Stackˉchunk = Bytesˉconcat(Bytesˉslice(Stackˉchunk, 0u32, Top),
                Bytesˉfromˉu32ˉlittle(Frame + 65536u32));
            let Target: u32 = Bytesˉreadˉu32ˉlittle(Wir, Entry + 20u32 + Successor * 4u32);
            if Target >= Count { return Empty; }
            if Bytesˉreadˉu8(Seen, Target) == 0u8 {
                Seen = Bytesˉconcat(Bytesˉconcat(Bytesˉslice(Seen, 0u32, Target),
                    Bytesˉfromˉu8(1u8)), Bytesˉslice(Seen, Target + 1u32, Count - Target - 1u32));
                if Bytesˉlength(Stackˉchunk) == 256u32 {
                    Stack = Bytesˉconcat(Stack, Stackˉchunk);
                    Stackˉchunk = Empty;
                }
                Stackˉchunk = Bytesˉconcat(Stackˉchunk, Bytesˉfromˉu32ˉlittle(Target));
                Depth = Depth + 1u32;
            }
        } else {
            Stackˉchunk = Bytesˉslice(Stackˉchunk, 0u32, Top);
            Depth = Depth - 1u32;
            Postorderˉchunk = Bytesˉconcat(Postorderˉchunk, Bytesˉfromˉu32ˉlittle(Original));
            if Bytesˉlength(Postorderˉchunk) == 256u32 {
                Postorder = Bytesˉconcat(Postorder, Postorderˉchunk);
                Postorderˉchunk = Empty;
            }
        }
    }
    Postorder = Bytesˉconcat(Postorder, Postorderˉchunk);
    var Order: bytes = Empty;
    var Chunk: bytes = Empty;
    var Remaining: u32 = Bytesˉlength(Postorder) / 4u32;
    while Remaining > 0u32 {
        Remaining = Remaining - 1u32;
        Chunk = Bytesˉconcat(Chunk, Bytesˉslice(Postorder, Remaining * 4u32, 4u32));
        if Bytesˉlength(Chunk) == 256u32 {
            Order = Bytesˉconcat(Order, Chunk);
            Chunk = Empty;
        }
    }
    return Bytesˉconcat(Order, Chunk);
}

// Offsets remain indexed by original block identity. This bounded inverse pass
// streams its output; it never retains one mutable heap frame per source block.
fn Compilerˉsourceˉwvbˉblockˉoffsetˉdirectory(Order: bytes, Offsets: bytes, Count: u32) -> bytes {
    let Empty: bytes = Compilerˉsourceˉwvbˉempty(Order);
    if Count > 4096u32 || Bytesˉlength(Order) != Bytesˉlength(Offsets) ||
        Bytesˉlength(Order) % 4u32 != 0u32 { return Empty; }
    var Identity: bool = Bytesˉlength(Order) == Count * 4u32;
    var Identityˉindex: u32 = 0u32;
    while Identity && Identityˉindex < Count {
        if Bytesˉreadˉu32ˉlittle(Order, Identityˉindex * 4u32) != Identityˉindex { Identity = false; }
        Identityˉindex = Identityˉindex + 1u32;
    }
    if Identity { return Offsets; }
    var Result: bytes = Empty;
    var Chunk: bytes = Empty;
    var Original: u32 = 0u32;
    while Original < Count {
        var Index: u32 = 0u32;
        var Offset: u32 = 4294967295u32;
        while Index < Bytesˉlength(Order) / 4u32 {
            if Bytesˉreadˉu32ˉlittle(Order, Index * 4u32) == Original {
                Offset = Bytesˉreadˉu32ˉlittle(Offsets, Index * 4u32);
                Index = Bytesˉlength(Order) / 4u32;
            } else { Index = Index + 1u32; }
        }
        Chunk = Bytesˉconcat(Chunk, Bytesˉfromˉu32ˉlittle(Offset));
        if Bytesˉlength(Chunk) == 256u32 {
            Result = Bytesˉconcat(Result, Chunk);
            Chunk = Empty;
        }
        Original = Original + 1u32;
    }
    return Bytesˉconcat(Result, Chunk);
}

export fn Compilerˉsourceˉwvbˉanalyzeˉfunction(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Bindings: Sourceˉbindings.Compilerˉsourceˉbindingˉsummary,
    Wir: bytes,
    Function: u32,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Orders: Compilerˉsourceˉwvbˉsymbolˉorders,
    Vectorˉborrows: Compilerˉsourceˉwvbˉvectorˉborrowˉplan,
    Borrowˉowners: Foundationˉborrows.Ownerˉplan
) -> Compilerˉsourceˉwvbˉanalysis {
    let Functionˉentry: u32 =
        Sourceˉwir.Compilerˉsourceˉwirˉfunctionsˉoffset(Wir) +
            Function * 48u32;
    let Firstˉblock: u32 = Bytesˉreadˉu32ˉlittle(Wir, Functionˉentry + 4u32);
    let Blockˉcount: u32 = Bytesˉreadˉu32ˉlittle(Wir, Functionˉentry + 8u32);
    let Parameters: u32 = Bytesˉreadˉu32ˉlittle(Wir, Functionˉentry + 36u32);
    let Blocksˉoffset: u32 = Compilerˉsourceˉwvbˉblocksˉoffset(Wir);
    let Operationsˉoffset: u32 = Compilerˉsourceˉwvbˉoperationsˉoffset(Wir);
    if !Borrowˉowners.Valid {
        return Compilerˉsourceˉwvbˉanalysisˉruleˉfailure(
            Wir, Compilerˉsourceˉwvbˉstatus.Unsupportedˉshape,
            Vectorˉborrows.Failureˉoperation, "borrow-expression-owner-not-proved"
        );
    }
    if !Vectorˉborrows.Valid {
        return Compilerˉsourceˉwvbˉanalysisˉfailure(
            Wir, Compilerˉsourceˉwvbˉstatus.Unsupportedˉoperation,
            Vectorˉborrows.Failureˉoperation
        );
    }
    var Blockˉoffsets: bytes = Compilerˉsourceˉwvbˉempty(Wir);
    var Codeˉlength: u32 = 0u32;
    var Maximumˉstack: u32 = 0u32;
    let Blockˉorder: bytes = Compilerˉsourceˉwvbˉblockˉorder(Wir, Firstˉblock, Blockˉcount);
    if Bytesˉlength(Blockˉorder) == 0u32 {
        return Compilerˉsourceˉwvbˉanalysisˉfailure(
            Wir, Compilerˉsourceˉwvbˉstatus.Bytecodeˉlimit, Bytesˉreadˉu32ˉlittle(Wir, 24u32));
    }
    var Block: u32 = 0u32;
    while Block < Bytesˉlength(Blockˉorder) / 4u32 {
        Blockˉoffsets = Bytesˉconcat(
            Blockˉoffsets, Bytesˉfromˉu32ˉlittle(Codeˉlength)
        );
        let Originalˉblock: u32 = Bytesˉreadˉu32ˉlittle(Blockˉorder, Block * 4u32);
        let Blockˉentry: u32 = Blocksˉoffset + (Firstˉblock + Originalˉblock) * 28u32;
        let Firstˉoperation: u32 = Bytesˉreadˉu32ˉlittle(Wir, Blockˉentry + 4u32);
        let Operationˉcount: u32 = Bytesˉreadˉu32ˉlittle(Wir, Blockˉentry + 8u32);
        var Inˉblock: u32 = 0u32;
        while Inˉblock < Operationˉcount {
            let Globalˉoperation: u32 = Firstˉoperation + Inˉblock;
            let Operationˉentry: u32 = Operationsˉoffset + Globalˉoperation * 28u32;
            let Operation: u32 = Bytesˉreadˉu16ˉlittle(Wir, Operationˉentry + 4u32);
            let Shape: u32 = Bytesˉreadˉu32ˉlittle(Wir, Operationˉentry + 8u32);
            let Isˉvectorˉborrow: bool = Operation == 7u32 &&
                Compilerˉsourceˉwvbˉvectorˉborrowˉsource(
                    Vectorˉborrows.Sources,
                    Bytesˉreadˉu32ˉlittle(Wir, Operationˉentry + 12u32)
                ) != 0u32;
            let Target: u32 = Bytesˉreadˉu32ˉlittle(
                Wir, Operationˉentry + 20u32
            );
            let Auxiliary: u32 = Bytesˉreadˉu32ˉlittle(
                Wir, Operationˉentry + 24u32
            );
            let Operands: u32 = Bytesˉreadˉu16ˉlittle(Wir, Operationˉentry + 6u32);
            if !Compilerˉsourceˉwvbˉoperationˉisˉsupported(Operation) {
                return Compilerˉsourceˉwvbˉanalysisˉfailure(
                    Wir, Compilerˉsourceˉwvbˉstatus.Unsupportedˉoperation,
                    Globalˉoperation
                );
            }
            if !Compilerˉsourceˉwvbˉbytesˉoperationˉisˉvalid(Input, Scan, Symbols, Bindings, Wir, Function, Operationˉentry, Orders) {
                return Compilerˉsourceˉwvbˉanalysisˉruleˉfailure(Wir, Compilerˉsourceˉwvbˉstatus.Unsupportedˉoperation, Globalˉoperation, "bytes-operation-contract-not-proved");
            }
            if (Operation == 17u32 || Operation == 19u32) &&
                Compilerˉsourceˉwvbˉplannedˉnominalˉtarget(
                    Target, Symbols, Orders
                ) == 4294967295u32 {
                return Compilerˉsourceˉwvbˉanalysisˉruleˉfailure(
                    Wir, Compilerˉsourceˉwvbˉstatus.Unsupportedˉshape,
                    Globalˉoperation, "nominal-target-not-mapped"
                );
            }
            if ((Operation >= 65u32 && Operation <= 67u32) ||
                    Operation == 164u32) &&
                Compilerˉsourceˉwvbˉplannedˉvariantˉtarget(
                    Target, Symbols, Orders
                ) == 4294967295u32 {
                return Compilerˉsourceˉwvbˉanalysisˉfailure(
                    Wir, Compilerˉsourceˉwvbˉstatus.Unsupportedˉshape,
                    Globalˉoperation
                );
            }
            if Operation == 165u32 || Operation == 166u32 {
                let Plannedˉarray: u32 =
                    Compilerˉsourceˉwvbˉplannedˉshapeˉvalue(
                        Target, Symbols, Orders
                    );
                if Plannedˉarray < 262144u32 || Plannedˉarray >= 327680u32 {
                    return Compilerˉsourceˉwvbˉanalysisˉfailure(
                        Wir, Compilerˉsourceˉwvbˉstatus.Unsupportedˉshape,
                        Globalˉoperation
                    );
                }
            }
            if Operation == 167u32 || Operation == 168u32 {
                let Plannedˉsequence: u32 =
                    Compilerˉsourceˉwvbˉplannedˉshapeˉvalue(
                        Target, Symbols, Orders
                    );
                if Plannedˉsequence < 393216u32 ||
                    Plannedˉsequence >= 458752u32 {
                    return Compilerˉsourceˉwvbˉanalysisˉfailure(
                        Wir, Compilerˉsourceˉwvbˉstatus.Unsupportedˉshape,
                        Globalˉoperation
                    );
                }
            }
            if ((Operation >= 169u32 && Operation <= 175u32) ||
                    (Operation >= 192u32 && Operation <= 194u32)) &&
                !Compilerˉsourceˉwvbˉvectorˉoperationˉisˉvalid(
                    Input, Scan, Bindings, Wir, Function, Operationˉentry, Symbols, Orders
                ) {
                return Compilerˉsourceˉwvbˉanalysisˉfailure(
                    Wir, Compilerˉsourceˉwvbˉstatus.Unsupportedˉshape,
                    Globalˉoperation
                );
            }
            if Operation == 177u32 || Operation == 179u32 {
                let Functionˉorder: Compilerˉsourceˉwvbˉsymbolˉorder =
                    Compilerˉsourceˉwvbˉfunctionˉorder(Orders);
                let Functionˉrank: u32 =
                    Compilerˉsourceˉwvbˉorderedˉrank(
                        Functionˉorder, Target
                    );
                if (Operation == 179u32 &&
                        (Operands == 0u32 || Operands > 64u32)) ||
                    Functionˉrank * 4u32 >=
                        Bytesˉlength(Functionˉorder.Entries) ||
                    Compilerˉsourceˉwvbˉorderedˉsymbol(
                        Functionˉorder, Functionˉrank
                    ) != Target ||
                    Auxiliary !=
                        Compilerˉsourceˉwvbˉfunctionˉtypeˉshapeˉinstance(
                            Shape
                        ) {
                    return Compilerˉsourceˉwvbˉanalysisˉfailure(
                        Wir, Compilerˉsourceˉwvbˉstatus.Invalidˉdata,
                        Globalˉoperation
                    );
                }
            }
            if Operation == 178u32 {
                let Catalog: u32 =
                    Compilerˉsourceˉwvbˉfunctionˉtypesˉoffset(Wir);
                let Wirˉlength: u32 = Bytesˉlength(Wir);
                if Catalog > Wirˉlength ||
                    Wirˉlength - Catalog < WVB_FUNCTION_TYPE_HEADER_BYTES ||
                    Target >= Bytesˉreadˉu32ˉlittle(
                        Wir, Catalog + 8u32
                    ) || Auxiliary != 0u32 {
                    return Compilerˉsourceˉwvbˉanalysisˉfailure(
                        Wir, Compilerˉsourceˉwvbˉstatus.Invalidˉdata,
                        Globalˉoperation
                    );
                }
            }
            if (Operation >= 180u32 && Operation <= 191u32) &&
                !Compilerˉsourceˉwvbˉresourceˉoperationˉisˉvalid(
                    Wir, Function, Operationˉentry, Symbols, Orders
                ) {
                return Compilerˉsourceˉwvbˉanalysisˉfailure(
                    Wir, Compilerˉsourceˉwvbˉstatus.Unsupportedˉshape,
                    Globalˉoperation
                );
            }
            if Operation != 171u32 && Operation != 172u32 &&
                Operation != 173u32 && Operation != 194u32 && Operation != 180u32 &&
                Operation != 181u32 && Operation != 182u32 &&
                Operation != 183u32 && Operation != 184u32 &&
                Operation != 186u32 && Operation != 187u32 &&
                Operation != 188u32 && Operation != 189u32 &&
                Operation != 191u32 &&
                !Compilerˉsourceˉwvbˉshapeˉrequiresˉtake(
                    Wir, Shape, Orders
                ) &&
                !Compilerˉsourceˉwvbˉshapeˉisˉsupported(
                Shape, true, Symbols, Orders
            ) {
                return Compilerˉsourceˉwvbˉanalysisˉruleˉfailure(
                    Wir, Compilerˉsourceˉwvbˉstatus.Unsupportedˉshape,
                    Globalˉoperation, "operation-result-shape-not-supported"
                );
            }
            if Compilerˉsourceˉwvbˉshapeˉownershipˉisˉunknown(Wir, Shape, Orders) {
                return Compilerˉsourceˉwvbˉanalysisˉruleˉfailure(
                    Wir, Compilerˉsourceˉwvbˉstatus.Unsupportedˉshape,
                    Globalˉoperation, "operation-result-ownership-unknown"
                );
            }
            var Operationˉstack: u32 = Operands;
            if Operation == 64u32 { Operationˉstack = 0u32; }
            if Operation == 167u32 { Operationˉstack = 2u32; }
            if Operation == 169u32 {
                Operationˉstack = 2u32;
                if Target < Parameters { Operationˉstack = 1u32; }
            }
            if Operation == 170u32 { Operationˉstack = 1u32; }
            if Operation == 174u32 { Operationˉstack = 1u32; }
            if Shape != 0u32 {
                if Operationˉstack == 0u32 { Operationˉstack = 1u32; }
            }
            if Isˉvectorˉborrow { Operationˉstack = 0u32; }
            if Operationˉstack > Maximumˉstack { Maximumˉstack = Operationˉstack; }
            var Added: u32 = Compilerˉsourceˉwvbˉoperationˉlength(
                Operation, Shape, Operands
            );
            // E2 reads a parameter directly: nine opcode bytes instead of
            // the owned local's take/length/restore sequence of fifteen.
            if Operation == 169u32 && Target < Parameters { Added = Added - 6u32; }
            if Isˉvectorˉborrow { Added = 0u32; }
            if Foundationˉborrows.Ownerˉslot(Borrowˉowners,
                Bytesˉreadˉu32ˉlittle(Wir, Operationˉentry + 12u32)) != 0u32 {
                Added = Added + 10u32;
            }
            if Added == 0u32 && Operation != 64u32 && !Isˉvectorˉborrow {
                return Compilerˉsourceˉwvbˉanalysisˉfailure(
                    Wir, Compilerˉsourceˉwvbˉstatus.Unsupportedˉoperation,
                    Globalˉoperation
                );
            }
            if Codeˉlength > 1048576u32 - Added {
                return Compilerˉsourceˉwvbˉanalysisˉfailure(
                    Wir, Compilerˉsourceˉwvbˉstatus.Bytecodeˉlimit,
                    Globalˉoperation
                );
            }
            Codeˉlength = Codeˉlength + Added;
            Inˉblock = Inˉblock + 1u32;
        }
        let Terminator: u32 = Bytesˉreadˉu32ˉlittle(Wir, Blockˉentry + 12u32);
        var Terminatorˉlength: u32 = 0u32;
        if Terminator == 1u32 {
            let Jumpˉtarget: u32 = Bytesˉreadˉu32ˉlittle(Wir, Blockˉentry + 20u32);
            let Phiˉprelude: u32 = Compilerˉsourceˉwvbˉphiˉpreludeˉlength(
                Wir, Firstˉblock, Originalˉblock, Jumpˉtarget
            );
            Terminatorˉlength = 5u32 + Phiˉprelude;
            if Phiˉprelude > 0u32 {
                if Maximumˉstack == 0u32 { Maximumˉstack = 1u32; }
            }
        }
        if Terminator == 2u32 {
            Terminatorˉlength = 15u32;
            if Maximumˉstack == 0u32 { Maximumˉstack = 1u32; }
        }
        if Terminator == 3u32 {
            Terminatorˉlength = 1u32;
            if Bytesˉreadˉu32ˉlittle(Wir, Blockˉentry + 16u32) !=
                Sourceˉwir.Compilerˉsourceˉwirˉsentinel() {
                Terminatorˉlength = 6u32;
                if Maximumˉstack == 0u32 { Maximumˉstack = 1u32; }
            }
        }
        if Codeˉlength > 1048576u32 - Terminatorˉlength {
            return Compilerˉsourceˉwvbˉanalysisˉfailure(
                Wir, Compilerˉsourceˉwvbˉstatus.Bytecodeˉlimit,
                Bytesˉreadˉu32ˉlittle(Wir, 24u32)
            );
        }
        Codeˉlength = Codeˉlength + Terminatorˉlength;
        Block = Block + 1u32;
    }
    return Compilerˉsourceˉwvbˉanalysis(
        Compilerˉsourceˉwvbˉstatus.Valid,
        Codeˉlength,
        Maximumˉstack,
        Compilerˉsourceˉwvbˉblockˉoffsetˉdirectory(Blockˉorder, Blockˉoffsets, Blockˉcount),
        Blockˉorder,
        Bytesˉreadˉu32ˉlittle(Wir, 24u32),
        ""
    );
}

export fn Compilerˉsourceˉwvbˉinstructionˉu32(Opcode: u8, Value: u32) -> bytes {
    return Bytesˉconcat(Bytesˉfromˉu8(Opcode), Bytesˉfromˉu32ˉlittle(Value));
}

fn Compilerˉsourceˉwvbˉinstructionˉbytesˉu32(
    Opcode: bytes,
    Value: u32
) -> bytes {
    return Bytesˉconcat(Opcode, Bytesˉfromˉu32ˉlittle(Value));
}

export fn Compilerˉsourceˉwvbˉtemporaryˉslot(
    Temporary: u32,
    Parameters: u32,
    Locals: u32,
    Mapping: bytes
) -> u32 {
    if Bytesˉlength(Mapping) == 0u32 {
        return Parameters + Locals + Temporary;
    }
    return Parameters + Locals + Bytesˉreadˉu32ˉlittle(
        Mapping, Temporary * 4u32
    );
}

export fn Compilerˉsourceˉwvbˉloadˉtemporary(
    Temporary: u32,
    Parameters: u32,
    Locals: u32,
    Mapping: bytes
) -> bytes {
    return Compilerˉsourceˉwvbˉinstructionˉu32(
        4u8,
        Compilerˉsourceˉwvbˉtemporaryˉslot(
            Temporary, Parameters, Locals, Mapping
        )
    );
}

// Cache direct-call budget authority once per function, with at most 4096
// one-byte entries and one immutable table update per distinct budget temporary.
fn Compilerˉsourceˉwvbˉbudgetˉtemporaryˉborrowˉmodes(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Bindings: Sourceˉbindings.Compilerˉsourceˉbindingˉsummary,
    Wir: bytes,
    Firstˉoperation: u32,
    Operationˉcount: u32,
    Firstˉtemporary: u32,
    Temporaryˉcount: u32
) -> bytes {
    let Empty: bytes = Compilerˉsourceˉwvbˉempty(Wir);
    let Temporaries: u32 = Compilerˉsourceˉwvbˉtemporariesˉoffset(Wir);
    var Hasˉbudget: bool = false;
    var Index: u32 = 0u32;
    while Index < Temporaryˉcount {
        if Bytesˉreadˉu32ˉlittle(Wir,
                Temporaries + (Firstˉtemporary + Index) * 4u32) == 805306368u32 {
            Hasˉbudget = true;
        }
        Index = Index + 1u32;
    }
    if !Hasˉbudget { return Empty; }
    if Temporaryˉcount > 4096u32 || Operationˉcount > 4096u32 { return Empty; }
    let Operations: u32 = Compilerˉsourceˉwvbˉoperationsˉoffset(Wir);
    let Operands: u32 = Compilerˉsourceˉwvbˉoperandsˉoffset(Wir);
    let Availableˉoperands: u32 = (Bytesˉlength(Wir) - Operands) / 4u32;
    var Modes: bytes = Foundationˉborrows.Zeroes(Temporaryˉcount);
    Index = 0u32;
    while Index < Operationˉcount {
        let Entry: u32 = Operations + (Firstˉoperation + Index) * 28u32;
        if Bytesˉreadˉu16ˉlittle(Wir, Entry + 4u32) == 62u32 {
            let First: u32 = Bytesˉreadˉu32ˉlittle(Wir, Entry + 16u32);
            let Count: u32 = Bytesˉreadˉu16ˉlittle(Wir, Entry + 6u32);
            if Count > 64u32 || First > Availableˉoperands ||
                Count > Availableˉoperands - First { return Empty; }
            var Operand: u32 = 0u32;
            while Operand < Count {
                let Temporary: u32 = Bytesˉreadˉu32ˉlittle(Wir,
                    Operands + (First + Operand) * 4u32);
                if Temporary >= Temporaryˉcount { return Empty; }
                if Bytesˉreadˉu32ˉlittle(Wir,
                        Temporaries + (Firstˉtemporary + Temporary) * 4u32) == 805306368u32 {
                    let Actual: u32 = Sourceˉwir.Compilerˉsourceˉwirˉfunctionˉparameterˉborrowˉmode(
                        Input, Scan, Symbols, Bindings,
                        Bytesˉreadˉu32ˉlittle(Wir, Entry + 20u32), Operand);
                    let Prior: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(Modes, Temporary));
                    if Actual > Sourceˉdeclarations.COMPILER_SOURCE_BORROW_MODE_MUTABLE ||
                        (Prior != 0u32 && Prior != Actual + 1u32) { return Empty; }
                    if Prior == 0u32 {
                        var Mode: u8 = 1u8;
                        if Actual == Sourceˉdeclarations.COMPILER_SOURCE_BORROW_MODE_IMMUTABLE {
                            Mode = 2u8;
                        }
                        if Actual == Sourceˉdeclarations.COMPILER_SOURCE_BORROW_MODE_MUTABLE {
                            Mode = 3u8;
                        }
                        Modes = Foundationˉborrows.Setˉstate(Modes,
                            Temporary, Mode);
                    }
                }
                Operand = Operand + 1u32;
            }
        }
        Index = Index + 1u32;
    }
    return Modes;
}

fn Compilerˉsourceˉwvbˉtemporaryˉisˉborrowedˉcallˉoperand(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Bindings: Sourceˉbindings.Compilerˉsourceˉbindingˉsummary,
    Wir: bytes,
    Start: u32,
    End: u32,
    Temporary: u32,
    Shape: u32
) -> bool {
    let Operands: u32 = Compilerˉsourceˉwvbˉoperandsˉoffset(Wir);
    var Operation: u32 = Start;
    while Operation < End {
        let Kind: u32 = Bytesˉreadˉu16ˉlittle(
            Wir, Operation + 4u32
        );
        if (Kind == 18u32 || Kind == 164u32 || Kind == 166u32) &&
            (Kind != 164u32 ||
                !Compilerˉsourceˉwvbˉshapeˉisˉaffineˉresult(
                    Wir, Shape
                )) {
            let Observationˉfirst: u32 = Bytesˉreadˉu32ˉlittle(
                Wir, Operation + 16u32
            );
            if Bytesˉreadˉu16ˉlittle(Wir, Operation + 6u32) > 0u32 &&
                Bytesˉreadˉu32ˉlittle(
                    Wir, Operands + Observationˉfirst * 4u32
                ) == Temporary {
                return true;
            }
        }
        if Kind == 62u32 {
            let First: u32 = Bytesˉreadˉu32ˉlittle(
                Wir, Operation + 16u32
            );
            let Count: u32 = Bytesˉreadˉu16ˉlittle(
                Wir, Operation + 6u32
            );
            var Operand: u32 = 0u32;
            while Operand < Count {
                if Bytesˉreadˉu32ˉlittle(
                        Wir, Operands + (First + Operand) * 4u32
                    ) == Temporary &&
                    Sourceˉwir.Compilerˉsourceˉwirˉfunctionˉparameterˉborrowˉmode(
                        Input, Scan, Symbols, Bindings,
                        Bytesˉreadˉu32ˉlittle(Wir, Operation + 20u32),
                        Operand
                    ) != Sourceˉdeclarations.COMPILER_SOURCE_BORROW_MODE_VALUE {
                    return true;
                }
                Operand = Operand + 1u32;
            }
        }
        Operation = Operation + 28u32;
    }
    return false;
}

fn Compilerˉsourceˉwvbˉtemporaryˉisˉborrowedˉownedˉaggregate(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Bindings: Sourceˉbindings.Compilerˉsourceˉbindingˉsummary,
    Wir: bytes,
    Firstˉoperation: u32,
    Operationˉcount: u32,
    Firstˉtemporary: u32,
    Temporary: u32,
    Orders: Compilerˉsourceˉwvbˉsymbolˉorders
) -> bool {
    let Operations: u32 = Compilerˉsourceˉwvbˉoperationsˉoffset(Wir);
    let Operands: u32 = Compilerˉsourceˉwvbˉoperandsˉoffset(Wir);
    let Temporaries: u32 = Compilerˉsourceˉwvbˉtemporariesˉoffset(Wir);
    let Shape: u32 = Bytesˉreadˉu32ˉlittle(
        Wir, Temporaries + (Firstˉtemporary + Temporary) * 4u32
    );
    let Isˉunsafeˉscratch: bool =
        Compilerˉsourceˉwvbˉshapeˉisˉunsafeˉscratch(
            Input, Scan, Symbols, Bindings, Shape
        );
    if !Isˉunsafeˉscratch &&
        !Compilerˉsourceˉwvbˉshapeˉisˉnewˉownedˉaggregate(
            Wir, Shape, Orders
        ) {
        return false;
    }
    let Isˉborrowedˉcallˉoperand: bool =
        Compilerˉsourceˉwvbˉtemporaryˉisˉborrowedˉcallˉoperand(
            Input, Scan, Symbols, Bindings, Wir,
            Operations + Firstˉoperation * 28u32,
            Operations + (Firstˉoperation + Operationˉcount) * 28u32,
            Temporary, Shape
        );
    if Isˉunsafeˉscratch { return Isˉborrowedˉcallˉoperand; }
    if Isˉborrowedˉcallˉoperand { return true; }
    var Producer: u32 = 0u32;
    while Producer < Operationˉcount {
        let Entry: u32 = Operations + (Firstˉoperation + Producer) * 28u32;
        if Bytesˉreadˉu32ˉlittle(Wir, Entry + 12u32) == Temporary {
            let Kind: u32 = Bytesˉreadˉu16ˉlittle(Wir, Entry + 4u32);
            if Kind == 18u32 || Kind == 164u32 || Kind == 166u32 {
                return true;
            }
            if Kind != 7u32 { return false; }
            var Consumer: u32 = Producer + 1u32;
            while Consumer < Operationˉcount {
                let Consumerˉentry: u32 = Operations +
                    (Firstˉoperation + Consumer) * 28u32;
                let Consumerˉkind: u32 = Bytesˉreadˉu16ˉlittle(
                    Wir, Consumerˉentry + 4u32
                );
                if Consumerˉkind == 18u32 || Consumerˉkind == 164u32 ||
                    Consumerˉkind == 166u32 {
                    let First: u32 = Bytesˉreadˉu32ˉlittle(
                        Wir, Consumerˉentry + 16u32
                    );
                    if Bytesˉreadˉu16ˉlittle(
                            Wir, Consumerˉentry + 6u32
                        ) > 0u32 && Bytesˉreadˉu32ˉlittle(
                            Wir, Operands + First * 4u32
                        ) == Temporary {
                        return true;
                    }
                }
                Consumer = Consumer + 1u32;
            }
            return false;
        }
        Producer = Producer + 1u32;
    }
    return false;
}

fn Compilerˉsourceˉwvbˉborrowedˉaggregateˉshape(
    Planned: bytes
) -> bytes {
    if Bytesˉlength(Planned) != 5u32 { return Planned; }
    let Kind: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(Planned, 0u32));
    var Borrowedˉkind: u8 = 0u8;
    if Kind == 7u32 { Borrowedˉkind = 28u8; }
    if Kind == 11u32 { Borrowedˉkind = 29u8; }
    if Kind == 22u32 { Borrowedˉkind = 30u8; }
    if Borrowedˉkind == 0u8 { return Planned; }
    return Bytesˉconcat(
        Bytesˉfromˉu8(Borrowedˉkind),
        Bytesˉslice(Planned, 1u32, 4u32)
    );
}


fn Compilerˉsourceˉwvbˉparameterˉisˉfoundationˉborrow(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Bindings: Sourceˉbindings.Compilerˉsourceˉbindingˉsummary,
    Orders: Compilerˉsourceˉwvbˉsymbolˉorders,
    Function: u32,
    Parameter: u32
) -> bool {
    if Sourceˉwir.Compilerˉsourceˉwirˉfunctionˉparameterˉborrowˉmode(
        Input, Scan, Symbols, Bindings, Function, Parameter
    ) != Sourceˉdeclarations.COMPILER_SOURCE_BORROW_MODE_IMMUTABLE {
        return false;
    }
    let Shape: u32 = Sourceˉwir.Compilerˉsourceˉwirˉbindingˉshape(
        Bindings, Bytesˉreadˉu32ˉlittle(Symbols.Directory, 8u32), Function, Parameter
    );
    return Shape != 805306368u32 && Shape != 805306369u32 && Shape != 805306370u32 &&
        !Compilerˉsourceˉwvbˉshapeˉisˉownedˉvector(Shape, Orders) &&
        !Compilerˉsourceˉwvbˉshapeˉisˉtaskˉowner(Input, Scan, Symbols, Bindings, Shape) &&
        !Compilerˉsourceˉwvbˉshapeˉisˉunsafeˉscratch(Input, Scan, Symbols, Bindings, Shape) &&
        !Compilerˉsourceˉwvbˉshapeˉisˉunsafeˉwriteˉregion(Input, Scan, Symbols, Bindings, Shape);
}

fn Compilerˉsourceˉwvbˉbuildˉfoundationˉborrowˉplan(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Bindings: Sourceˉbindings.Compilerˉsourceˉbindingˉsummary,
    Orders: Compilerˉsourceˉwvbˉsymbolˉorders,
    Wir: bytes,
    Firstˉoperation: u32,
    Operationˉcount: u32,
    Temporaryˉcount: u32,
    Slotˉcount: u32,
    Parameterˉborrows: bytes,
    Foundationˉborrowˉmodule: bool
) -> Foundationˉborrows.Borrowˉplan {
    let Empty: bytes = Compilerˉsourceˉwvbˉempty(Wir);
    let Unborrowed: Foundationˉborrows.Borrowˉplan =
        Foundationˉborrows.Borrowˉplan(true, false, Empty, Empty, Empty);
    if !Foundationˉborrowˉmodule { return Unborrowed; }
    var Callˉborrows: bytes = Foundationˉborrows.Zeroes(Temporaryˉcount);
    let Operations: u32 = Compilerˉsourceˉwvbˉoperationsˉoffset(Wir);
    let Operands: u32 = Compilerˉsourceˉwvbˉoperandsˉoffset(Wir);
    var Hasˉborrow: bool = false;
    var Index: u32 = 0u32;
    while Index < Bytesˉlength(Parameterˉborrows) {
        if Bytesˉreadˉu8(Parameterˉborrows, Index) != 0u8 {
            Hasˉborrow = true;
        }
        Index = Index + 1u32;
    }
    Index = 0u32;
    while Index < Operationˉcount {
        let Entry: u32 = Operations + (Firstˉoperation + Index) * 28u32;
        let Kind: u32 = Bytesˉreadˉu16ˉlittle(Wir, Entry + 4u32);
        if Kind == 191u32 || Kind == 192u32 || Kind == 205u32 { Hasˉborrow = true; }
        if Kind == 62u32 && Compilerˉsourceˉwvbˉshapeˉisˉbyteˉslice(Bytesˉreadˉu32ˉlittle(Wir, Entry + 8u32), Orders) {
            Hasˉborrow = true;
            Callˉborrows = Foundationˉborrows.Setˉstate(Callˉborrows, Bytesˉreadˉu32ˉlittle(Wir, Entry + 12u32), 2u8);
        }
        if Kind == 62u32 {
            let Target: u32 = Bytesˉreadˉu32ˉlittle(Wir, Entry + 20u32);
            let First: u32 = Bytesˉreadˉu32ˉlittle(Wir, Entry + 16u32);
            let Count: u32 = Bytesˉreadˉu16ˉlittle(Wir, Entry + 6u32);
            var Operand: u32 = 0u32;
            while Operand < Count {
                if Compilerˉsourceˉwvbˉparameterˉisˉfoundationˉborrow(
                    Input, Scan, Symbols, Bindings, Orders, Target, Operand
                ) {
                    Hasˉborrow = true;
                    Callˉborrows = Foundationˉborrows.Setˉstate(
                        Callˉborrows,
                        Bytesˉreadˉu32ˉlittle(Wir, Operands + (First + Operand) * 4u32),
                        2u8
                    );
                }
                Operand = Operand + 1u32;
            }
        }
        Index = Index + 1u32;
    }
    if !Hasˉborrow { return Unborrowed; }
    // Preserve large borrow-free functions, but enforce the planner's bounds
    // before traversing projected aggregate types in a borrowing function.
    if Operationˉcount > 4096u32 || Temporaryˉcount > 4096u32 ||
        Slotˉcount > 4096u32 || Bytesˉlength(Parameterˉborrows) > Slotˉcount {
        return Foundationˉborrows.Borrowˉplan(false, true, Empty, Empty, Empty);
    }
    var Projectionˉreads: bytes = Foundationˉborrows.Zeroes(Temporaryˉcount);
    let Readˉtypes: Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog =
        Compilerˉsourceˉwvbˉbindingsˉtypeˉcatalog(Bindings.Directory);
    let Functionˉtypesˉoffset: u32 = Compilerˉsourceˉwvbˉfunctionˉtypesˉoffset(Wir);
    var Readˉfunctions: Functionˉtypes.Compilerˉsourceˉfunctionˉtypeˉcatalog =
        Functionˉtypes.Compilerˉsourceˉfunctionˉtypeˉcatalog(
            Functionˉtypes.Compilerˉsourceˉfunctionˉtypeˉstatus.Valid,
            Bytesˉslice(Wir, Functionˉtypesˉoffset, Bytesˉlength(Wir) - Functionˉtypesˉoffset)
        );
    if Functionˉtypesˉoffset == Bytesˉlength(Wir) {
        Readˉfunctions = Functionˉtypes.Compilerˉsourceˉfunctionˉtypeˉcatalogˉempty();
    }
    Index = 0u32;
    while Index < Operationˉcount {
        let Readˉentry: u32 = Operations + (Firstˉoperation + Index) * 28u32;
        let Readˉkind: u32 = Bytesˉreadˉu16ˉlittle(Wir, Readˉentry + 4u32);
        if Readˉkind == 18u32 || Readˉkind == 67u32 || Readˉkind == 164u32 ||
            Readˉkind == 166u32 || Readˉkind == 168u32 || Readˉkind == 192u32 {
            let Readˉclass: u32 = Genericˉlayouts.Compilerˉsourceˉgenericˉtypeˉreadˉclass(
                Input, Scan, Symbols, Readˉtypes, Readˉfunctions,
                Bytesˉreadˉu32ˉlittle(Wir, Readˉentry + 8u32)
            );
            if Readˉclass == 1u32 || Readˉclass == 2u32 {
                Projectionˉreads = Foundationˉborrows.Setˉstate(
                    Projectionˉreads, Bytesˉreadˉu32ˉlittle(Wir, Readˉentry + 12u32), 1u8
                );
            }
        }
        Index = Index + 1u32;
    }
    return Foundationˉborrows.Build(
        Wir, Operations, Operands, Firstˉoperation, Operationˉcount,
        Temporaryˉcount, Slotˉcount, Parameterˉborrows, Callˉborrows, Projectionˉreads
    );
}

// WVB41 conservatively invalidates every Foundation loan at an exclusive
// Vector call. Copy read-through results are already ordinary temporaries.
// Retained loans must stay in their defining block and precede no such call
// before their use. Rejecting cross-block loans avoids a linear-order proof
// incorrectly admitting a stale read on a loop backedge.
fn Compilerˉsourceˉwvbˉguardˉexclusiveˉfoundationˉcalls(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Bindings: Sourceˉbindings.Compilerˉsourceˉbindingˉsummary,
    Orders: Compilerˉsourceˉwvbˉsymbolˉorders,
    Wir: bytes,
    Function: u32,
    Foundation: Foundationˉborrows.Borrowˉplan,
    Plan: Compilerˉsourceˉwvbˉvectorˉborrowˉplan
) -> Compilerˉsourceˉwvbˉvectorˉborrowˉplan {
    if !Plan.Valid { return Plan; }
    let Minor: u32 = Bytesˉreadˉu16ˉlittle(Wir, 6u32);
    if (Minor < 35u32 || Minor > 40u32) || !Foundation.Hasˉborrow {
        return Plan;
    }
    let Empty: bytes = Compilerˉsourceˉwvbˉempty(Wir);
    let Functionˉentry: u32 = Sourceˉwir.Compilerˉsourceˉwirˉfunctionsˉoffset(Wir) +
        Function * 48u32;
    let Firstˉblock: u32 = Bytesˉreadˉu32ˉlittle(Wir, Functionˉentry + 4u32);
    let Blockˉcount: u32 = Bytesˉreadˉu32ˉlittle(Wir, Functionˉentry + 8u32);
    let Firstˉoperation: u32 = Bytesˉreadˉu32ˉlittle(Wir, Functionˉentry + 12u32);
    let Operationˉcount: u32 = Bytesˉreadˉu32ˉlittle(Wir, Functionˉentry + 16u32);
    let Firstˉtemporary: u32 = Bytesˉreadˉu32ˉlittle(Wir, Functionˉentry + 20u32);
    let Temporaryˉcount: u32 = Bytesˉreadˉu32ˉlittle(Wir, Functionˉentry + 24u32);
    let Slotˉcount: u32 = Bytesˉreadˉu32ˉlittle(Wir, Functionˉentry + 36u32) +
        Bytesˉreadˉu32ˉlittle(Wir, Functionˉentry + 40u32);
    let Invalid: Compilerˉsourceˉwvbˉvectorˉborrowˉplan =
        Compilerˉsourceˉwvbˉvectorˉborrowˉplan(false, Empty, Firstˉoperation);
    if !Foundation.Valid || Operationˉcount > 4096u32 ||
        Temporaryˉcount > 4096u32 || Slotˉcount > 4096u32 ||
        Blockˉcount == 0u32 || Blockˉcount > 4096u32 ||
        Bytesˉlength(Foundation.Temporaryˉstate) != Temporaryˉcount ||
        Bytesˉlength(Foundation.Slotˉstate) != Slotˉcount {
        return Invalid;
    }
    var Hasˉretainedˉloan: bool = false;
    var Hasˉborrowedˉslot: bool = false;
    var Stateˉindex: u32 = 0u32;
    while Stateˉindex < Temporaryˉcount {
        let State: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(Foundation.Temporaryˉstate, Stateˉindex));
        if State > 3u32 { return Invalid; }
        if State != 0u32 { Hasˉretainedˉloan = true; }
        Stateˉindex = Stateˉindex + 1u32;
    }
    Stateˉindex = 0u32;
    while Stateˉindex < Slotˉcount {
        let Slotˉstate: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(Foundation.Slotˉstate, Stateˉindex));
        if Slotˉstate > 1u32 { return Invalid; }
        if Slotˉstate != 0u32 { Hasˉborrowedˉslot = true; }
        Stateˉindex = Stateˉindex + 1u32;
    }
    if !Hasˉretainedˉloan && !Hasˉborrowedˉslot { return Plan; }

    // Complete WVIR validation has already bounded every directory/range.
    // Classify each direct call once. At most 4096 one-byte flags are retained;
    // 128-byte chunks bound append copying without per-call lifetime rescans.
    let Blocks: u32 = Compilerˉsourceˉwvbˉblocksˉoffset(Wir);
    let Operations: u32 = Compilerˉsourceˉwvbˉoperationsˉoffset(Wir);
    let Temporaries: u32 = Compilerˉsourceˉwvbˉtemporariesˉoffset(Wir);
    let Operands: u32 = Compilerˉsourceˉwvbˉoperandsˉoffset(Wir);
    var Exclusiveˉcalls: bytes = Empty;
    var Exclusiveˉchunk: bytes = Empty;
    var Firstˉexclusive: u32 = 4294967295u32;
    var Scanˉoperation: u32 = 0u32;
    while Scanˉoperation < Operationˉcount {
        let Scanˉentry: u32 = Operations + (Firstˉoperation + Scanˉoperation) * 28u32;
        let Scanˉkind: u32 = Bytesˉreadˉu16ˉlittle(Wir, Scanˉentry + 4u32);
        var Exclusive: bool = Scanˉkind == 193u32 || Scanˉkind == 194u32;
        if Scanˉkind == 62u32 {
            let Callˉtarget: u32 = Bytesˉreadˉu32ˉlittle(Wir, Scanˉentry + 20u32);
            let Callˉfirst: u32 = Bytesˉreadˉu32ˉlittle(Wir, Scanˉentry + 16u32);
            let Callˉcount: u32 = Bytesˉreadˉu16ˉlittle(Wir, Scanˉentry + 6u32);
            var Callˉoperand: u32 = 0u32;
            while Callˉoperand < Callˉcount && !Exclusive {
                if Sourceˉwir.Compilerˉsourceˉwirˉfunctionˉparameterˉborrowˉmode(
                        Input, Scan, Symbols, Bindings, Callˉtarget, Callˉoperand
                    ) == Sourceˉdeclarations.COMPILER_SOURCE_BORROW_MODE_MUTABLE {
                    let Callˉtemporary: u32 = Bytesˉreadˉu32ˉlittle(
                        Wir, Operands + (Callˉfirst + Callˉoperand) * 4u32
                    );
                    if Callˉtemporary >= Temporaryˉcount { return Invalid; }
                    let Callˉshape: u32 = Bytesˉreadˉu32ˉlittle(
                        Wir, Temporaries + (Firstˉtemporary + Callˉtemporary) * 4u32
                    );
                    Exclusive = Compilerˉsourceˉwvbˉshapeˉisˉownedˉvector(Callˉshape, Orders);
                }
                Callˉoperand = Callˉoperand + 1u32;
            }
        }
        var Exclusiveˉflag: u8 = 0u8;
        if Exclusive {
            Exclusiveˉflag = 1u8;
            if Firstˉexclusive == 4294967295u32 {
                Firstˉexclusive = Firstˉoperation + Scanˉoperation;
            }
        }
        Exclusiveˉchunk = Bytesˉconcat(Exclusiveˉchunk, Bytesˉfromˉu8(Exclusiveˉflag));
        if Bytesˉlength(Exclusiveˉchunk) == 128u32 {
            Exclusiveˉcalls = Bytesˉconcat(Exclusiveˉcalls, Exclusiveˉchunk);
            Exclusiveˉchunk = Empty;
        }
        Scanˉoperation = Scanˉoperation + 1u32;
    }
    if Firstˉexclusive == 4294967295u32 { return Plan; }
    let Unsupported: Compilerˉsourceˉwvbˉvectorˉborrowˉplan =
        Compilerˉsourceˉwvbˉvectorˉborrowˉplan(false, Empty, Firstˉexclusive);
    if Hasˉborrowedˉslot { return Unsupported; }
    Exclusiveˉcalls = Bytesˉconcat(Exclusiveˉcalls, Exclusiveˉchunk);
    if Bytesˉlength(Exclusiveˉcalls) != Operationˉcount { return Unsupported; }

    // Global operation order, not block-directory order, follows SSA result
    // IDs: loop exits may be declared before their bodies. Each nonempty block
    // still owns one contiguous operation/definition interval.
    // A call invalidates every earlier retained loan, including its arguments.
    // Testing operands once replaces a roots-by-calls or last-use-table scan.
    var Nextˉtemporary: u32 = 0u32;
    var Checkedˉoperations: u32 = 0u32;
    while Checkedˉoperations < Operationˉcount {
        let Block: u32 = Bytesˉreadˉu32ˉlittle(
            Wir, Operations + (Firstˉoperation + Checkedˉoperations) * 28u32
        );
        if Block >= Blockˉcount { return Unsupported; }
        let Blockˉentry: u32 = Blocks + (Firstˉblock + Block) * 28u32;
        let Blockˉfirst: u32 = Bytesˉreadˉu32ˉlittle(Wir, Blockˉentry + 4u32);
        let Blockˉoperations: u32 = Bytesˉreadˉu32ˉlittle(Wir, Blockˉentry + 8u32);
        if Bytesˉreadˉu32ˉlittle(Wir, Blockˉentry) != Block ||
            Blockˉfirst != Firstˉoperation + Checkedˉoperations ||
            Blockˉoperations == 0u32 ||
            Blockˉoperations > Operationˉcount - Checkedˉoperations {
            return Unsupported;
        }
        let Blockˉtemporaryˉfirst: u32 = Nextˉtemporary;
        var Exclusiveˉthreshold: u32 = 0u32;
        var Latestˉexclusive: u32 = Firstˉexclusive;
        var Inˉblock: u32 = 0u32;
        while Inˉblock < Blockˉoperations {
            let Globalˉoperation: u32 = Blockˉfirst + Inˉblock;
            let Entry: u32 = Operations + Globalˉoperation * 28u32;
            if Bytesˉreadˉu32ˉlittle(Wir, Entry) != Block { return Unsupported; }
            if Bytesˉreadˉu8(Exclusiveˉcalls, Checkedˉoperations) == 1u8 {
                Exclusiveˉthreshold = Nextˉtemporary;
                Latestˉexclusive = Globalˉoperation;
            }
            let Firstˉoperand: u32 = Bytesˉreadˉu32ˉlittle(Wir, Entry + 16u32);
            let Operandˉcount: u32 = Bytesˉreadˉu16ˉlittle(Wir, Entry + 6u32);
            var Operand: u32 = 0u32;
            while Operand < Operandˉcount {
                let Used: u32 = Bytesˉreadˉu32ˉlittle(
                    Wir, Operands + (Firstˉoperand + Operand) * 4u32
                );
                if Used >= Nextˉtemporary { return Unsupported; }
                if Bytesˉreadˉu8(Foundation.Temporaryˉstate, Used) != 0u8 {
                    if Used < Blockˉtemporaryˉfirst { return Unsupported; }
                    if Used < Exclusiveˉthreshold {
                        return Compilerˉsourceˉwvbˉvectorˉborrowˉplan(false, Empty, Latestˉexclusive);
                    }
                }
                Operand = Operand + 1u32;
            }
            if Bytesˉreadˉu32ˉlittle(Wir, Entry + 8u32) != 0u32 {
                if Nextˉtemporary >= Temporaryˉcount ||
                    Bytesˉreadˉu32ˉlittle(Wir, Entry + 12u32) != Nextˉtemporary {
                    return Unsupported;
                }
                Nextˉtemporary = Nextˉtemporary + 1u32;
            }
            Checkedˉoperations = Checkedˉoperations + 1u32;
            Inˉblock = Inˉblock + 1u32;
        }
        // Check branch/return read-through at this block's actual end, not
        // after all function operations where later calls would look earlier.
        let Terminator: u32 = Bytesˉreadˉu32ˉlittle(Wir, Blockˉentry + 12u32);
        let Terminatorˉvalue: u32 = Bytesˉreadˉu32ˉlittle(Wir, Blockˉentry + 16u32);
        if (Terminator == 2u32 || Terminator == 3u32) && Terminatorˉvalue != 4294967295u32 {
            if Terminatorˉvalue >= Nextˉtemporary { return Unsupported; }
            if Bytesˉreadˉu8(Foundation.Temporaryˉstate, Terminatorˉvalue) != 0u8 {
                if Terminatorˉvalue < Blockˉtemporaryˉfirst { return Unsupported; }
                if Terminatorˉvalue < Exclusiveˉthreshold {
                    return Compilerˉsourceˉwvbˉvectorˉborrowˉplan(false, Empty, Latestˉexclusive);
                }
            }
        }
    }
    if Checkedˉoperations != Operationˉcount || Nextˉtemporary != Temporaryˉcount {
        return Unsupported;
    }
    // A block without operations has no local loan definition. Any retained
    // loan read by its terminator therefore crosses a block boundary.
    var Emptyˉblock: u32 = 0u32;
    while Emptyˉblock < Blockˉcount {
        let Emptyˉentry: u32 = Blocks + (Firstˉblock + Emptyˉblock) * 28u32;
        if Bytesˉreadˉu32ˉlittle(Wir, Emptyˉentry + 8u32) == 0u32 {
            let Emptyˉterminator: u32 = Bytesˉreadˉu32ˉlittle(Wir, Emptyˉentry + 12u32);
            let Emptyˉvalue: u32 = Bytesˉreadˉu32ˉlittle(Wir, Emptyˉentry + 16u32);
            if (Emptyˉterminator == 2u32 || Emptyˉterminator == 3u32) &&
                Emptyˉvalue != 4294967295u32 {
                if Emptyˉvalue >= Temporaryˉcount { return Unsupported; }
                if Bytesˉreadˉu8(Foundation.Temporaryˉstate, Emptyˉvalue) != 0u8 {
                    return Unsupported;
                }
            }
        }
        Emptyˉblock = Emptyˉblock + 1u32;
    }
    return Plan;
}

fn Compilerˉsourceˉwvbˉbuildˉfoundationˉborrowˉowners(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Bindings: Sourceˉbindings.Compilerˉsourceˉbindingˉsummary,
    Orders: Compilerˉsourceˉwvbˉsymbolˉorders,
    Wir: bytes,
    Entry: u32,
    Foundation: Foundationˉborrows.Borrowˉplan
) -> Foundationˉborrows.Ownerˉplan {
    let Empty: bytes = Compilerˉsourceˉwvbˉempty(Wir);
    if !Foundation.Valid { return Foundationˉborrows.Ownerˉplan(false, 0u32, Empty, Empty); }
    if !Foundation.Hasˉborrow { return Foundationˉborrows.Ownerˉplan(true, 0u32, Empty, Empty); }
    let Count: u32 = Bytesˉreadˉu32ˉlittle(Wir, Entry + 24u32);
    let First: u32 = Bytesˉreadˉu32ˉlittle(Wir, Entry + 20u32);
    if Count > 4096u32 || Bytesˉlength(Foundation.Temporaryˉstate) != Count {
        return Foundationˉborrows.Ownerˉplan(false, 0u32, Empty, Empty);
    }
    let Types: Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog =
        Compilerˉsourceˉwvbˉbindingsˉtypeˉcatalog(Bindings.Directory);
    let Functionˉoffset: u32 = Compilerˉsourceˉwvbˉfunctionˉtypesˉoffset(Wir);
    var Functions: Functionˉtypes.Compilerˉsourceˉfunctionˉtypeˉcatalog =
        Functionˉtypes.Compilerˉsourceˉfunctionˉtypeˉcatalog(
            Functionˉtypes.Compilerˉsourceˉfunctionˉtypeˉstatus.Valid,
            Bytesˉslice(Wir, Functionˉoffset, Bytesˉlength(Wir) - Functionˉoffset));
    if Functionˉoffset == Bytesˉlength(Wir) {
        Functions = Functionˉtypes.Compilerˉsourceˉfunctionˉtypeˉcatalogˉempty();
    }
    var Intrinsic: bytes = Empty;
    var Reads: bytes = Empty;
    var Intrinsicˉchunk: bytes = Empty;
    var Readˉchunk: bytes = Empty;
    var Index: u32 = 0u32;
    while Index < Count {
        let Shape: u32 = Bytesˉreadˉu32ˉlittle(Wir,
            Compilerˉsourceˉwvbˉtemporariesˉoffset(Wir) + (First + Index) * 4u32);
        var Loan: u8 = 0u8;
        var Read: u8 = 0u8;
        if Compilerˉsourceˉwvbˉshapeˉisˉbyteˉslice(Shape, Orders) { Loan = 1u8; }
        if U32ˉfromˉu8(Bytesˉreadˉu8(Foundation.Temporaryˉstate, Index)) >= 2u32 && Loan == 0u8 {
            let Class: u32 = Genericˉlayouts.Compilerˉsourceˉgenericˉtypeˉreadˉclass(
                Input, Scan, Symbols, Types, Functions, Shape);
            if Class == 1u32 || Class == 2u32 { Read = 1u8; }
        }
        Intrinsicˉchunk = Bytesˉconcat(Intrinsicˉchunk, Bytesˉfromˉu8(Loan));
        Readˉchunk = Bytesˉconcat(Readˉchunk, Bytesˉfromˉu8(Read));
        if Bytesˉlength(Intrinsicˉchunk) == 256u32 {
            Intrinsic = Bytesˉconcat(Intrinsic, Intrinsicˉchunk);
            Reads = Bytesˉconcat(Reads, Readˉchunk);
            Intrinsicˉchunk = Empty;
            Readˉchunk = Empty;
        }
        Index = Index + 1u32;
    }
    return Foundationˉborrows.Buildˉowners(Wir,
        Compilerˉsourceˉwvbˉoperationsˉoffset(Wir), Compilerˉsourceˉwvbˉoperandsˉoffset(Wir),
        Bytesˉreadˉu32ˉlittle(Wir, Entry + 12u32),
        Bytesˉreadˉu32ˉlittle(Wir, Entry + 16u32), Count, Foundation,
        Bytesˉconcat(Intrinsic, Intrinsicˉchunk), Bytesˉconcat(Reads, Readˉchunk));
}

fn Compilerˉsourceˉwvbˉbuildˉfunctionˉborrowˉplans(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Bindings: Sourceˉbindings.Compilerˉsourceˉbindingˉsummary,
    Orders: Compilerˉsourceˉwvbˉsymbolˉorders,
    Wir: bytes,
    Function: u32,
    Foundationˉborrowˉmodule: bool
) -> Compilerˉsourceˉwvbˉfunctionˉborrowˉplans {
    let Entry: u32 = Sourceˉwir.Compilerˉsourceˉwirˉfunctionsˉoffset(Wir) + Function * 48u32;
    let Parameters: u32 = Bytesˉreadˉu32ˉlittle(Wir, Entry + 36u32);
    let Locals: u32 = Bytesˉreadˉu32ˉlittle(Wir, Entry + 40u32);
    var Parameterˉborrows: bytes = Compilerˉsourceˉwvbˉempty(Wir);
    var Index: u32 = 0u32;
    while Index < Parameters {
        var Borrowed: u8 = 0u8;
        if Foundationˉborrowˉmodule && Compilerˉsourceˉwvbˉparameterˉisˉfoundationˉborrow(
                Input, Scan, Symbols, Bindings, Orders, Function, Index
            ) { Borrowed = 1u8; }
        Parameterˉborrows = Bytesˉconcat(Parameterˉborrows, Bytesˉfromˉu8(Borrowed));
        Index = Index + 1u32;
    }
    let Foundation: Foundationˉborrows.Borrowˉplan = Compilerˉsourceˉwvbˉbuildˉfoundationˉborrowˉplan(
        Input, Scan, Symbols, Bindings, Orders, Wir,
        Bytesˉreadˉu32ˉlittle(Wir, Entry + 12u32),
        Bytesˉreadˉu32ˉlittle(Wir, Entry + 16u32),
        Bytesˉreadˉu32ˉlittle(Wir, Entry + 24u32),
        Parameters + Locals, Parameterˉborrows, Foundationˉborrowˉmodule
    );
    let Vectors: Compilerˉsourceˉwvbˉvectorˉborrowˉplan =
        Compilerˉsourceˉwvbˉvectorˉborrowsˉretainˉprojections(
            Compilerˉsourceˉwvbˉbuildˉvectorˉborrowˉplan(
                Input, Scan, Symbols, Bindings, Orders, Wir, Function
            ), Foundation
        );
    let Guardedˉvectors: Compilerˉsourceˉwvbˉvectorˉborrowˉplan =
        Compilerˉsourceˉwvbˉguardˉexclusiveˉfoundationˉcalls(
            Input, Scan, Symbols, Bindings, Orders, Wir, Function, Foundation, Vectors
        );
    let Owners: Foundationˉborrows.Ownerˉplan = Compilerˉsourceˉwvbˉbuildˉfoundationˉborrowˉowners(
        Input, Scan, Symbols, Bindings, Orders, Wir, Entry, Foundation);
    return Compilerˉsourceˉwvbˉfunctionˉborrowˉplans(Foundation, Parameterˉborrows, Guardedˉvectors, Owners);
}

fn Compilerˉsourceˉwvbˉmoduleˉhasˉrecordˉcollection(
    Wir: bytes,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Bindings: Sourceˉbindings.Compilerˉsourceˉbindingˉsummary,
    Orders: Compilerˉsourceˉwvbˉsymbolˉorders
) -> bool {
    let Catalog: Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog =
        Compilerˉsourceˉwvbˉbindingsˉtypeˉcatalog(Bindings.Directory);
    let Functions: Compilerˉsourceˉwvbˉsymbolˉorder = Compilerˉsourceˉwvbˉfunctionˉorder(Orders);
    var Index: u32 = 0u32;
    while Index < Bytesˉlength(Functions.Entries) / 4u32 {
        let Function: u32 = Compilerˉsourceˉwvbˉorderedˉsymbol(Functions, Index);
        let Entry: u32 = Sourceˉwir.Compilerˉsourceˉwirˉfunctionsˉoffset(Wir) + Function * 48u32;
        var Operation: u32 = Bytesˉreadˉu32ˉlittle(Wir, Entry + 12u32);
        let End: u32 = Operation + Bytesˉreadˉu32ˉlittle(Wir, Entry + 16u32);
        while Operation < End {
            let Current: u32 = Compilerˉsourceˉwvbˉoperationsˉoffset(Wir) + Operation * 28u32;
            let Kind: u32 = Bytesˉreadˉu16ˉlittle(Wir, Current + 4u32);
            var Collection: u32 = 0u32;
            if Kind == 167u32 || Kind == 168u32 {
                Collection = Bytesˉreadˉu32ˉlittle(Wir, Current + 20u32);
            } else if Kind == 169u32 || Kind == 170u32 || Kind == 173u32 ||
                Kind == 192u32 || Kind == 193u32 || Kind == 194u32 {
                Collection = Bytesˉreadˉu32ˉlittle(Wir, Current + 24u32);
            } else if Kind == 172u32 {
                Collection = Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalogˉshapeˉtypeˉargument(
                    Catalog, Bytesˉreadˉu32ˉlittle(Wir, Current + 8u32), 0u32);
            } else if Kind == 175u32 {
                Collection = Sourceˉwir.Compilerˉsourceˉwirˉbindingˉshape(
                    Bindings, Bytesˉreadˉu32ˉlittle(Symbols.Directory, 8u32), Function,
                    Bytesˉreadˉu32ˉlittle(Wir, Current + 20u32));
            }
            if Collection != 0u32 {
                let Element: u32 = Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalogˉshapeˉtypeˉargument(
                    Catalog, Collection, 0u32);
                let Planned: bytes = Compilerˉsourceˉwvbˉplannedˉshape(Element, Symbols, Orders);
                if Bytesˉlength(Planned) == 5u32 && Bytesˉreadˉu8(Planned, 0u32) == 7u8 { return true; }
            }
            Operation = Operation + 1u32;
        }
        Index = Index + 1u32;
    }
    return false;
}

fn Compilerˉsourceˉwvbˉmoduleˉhasˉcollectionˉhelper(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Wir: bytes,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Bindings: Sourceˉbindings.Compilerˉsourceˉbindingˉsummary,
    Orders: Compilerˉsourceˉwvbˉsymbolˉorders
) -> bool {
    let Functions: Compilerˉsourceˉwvbˉsymbolˉorder = Compilerˉsourceˉwvbˉfunctionˉorder(Orders);
    var Index: u32 = 0u32;
    while Index < Bytesˉlength(Functions.Entries) / 4u32 {
        let Function: u32 = Compilerˉsourceˉwvbˉorderedˉsymbol(Functions, Index);
        let Declaration: u32 = Compilerˉsourceˉwvbˉfunctionˉdeclaration(Symbols, Bindings.Directory, Function);
        let Name: bytes = Compilerˉsourceˉwvbˉfunctionˉname(Input, Scan, Symbols, Function);
        let Entry: bool = Bytesˉlength(Name) == 4u32 &&
            Bytesˉreadˉu32ˉlittle(Name, 0u32) == 1852399949u32 &&
            Function == Declaration && Compilerˉsourceˉwvbˉsymbolˉmodule(Symbols, Declaration) == 0u32 &&
            Sourceˉsymbols.Compilerˉsourceˉsymbolsˉlookupˉisˉexported(Symbols.Lookup, Function);
        if !Entry {
            let Directory: u32 = Sourceˉwir.Compilerˉsourceˉwirˉfunctionsˉoffset(Wir) + Function * 48u32;
            let Parameters: u32 = Bytesˉreadˉu32ˉlittle(Wir, Directory + 36u32);
            var Parameter: u32 = 0u32;
            while Parameter < Parameters {
                if Sourceˉwir.Compilerˉsourceˉwirˉbindingˉshape(Bindings,
                    Bytesˉreadˉu32ˉlittle(Symbols.Directory, 8u32), Function, Parameter) == 805306368u32 &&
                    Sourceˉwir.Compilerˉsourceˉwirˉfunctionˉparameterˉborrowˉmode(
                        Input, Scan, Symbols, Bindings, Function, Parameter
                    ) == Sourceˉdeclarations.COMPILER_SOURCE_BORROW_MODE_VALUE { return true; }
                Parameter = Parameter + 1u32;
            }
            var Operation: u32 = Bytesˉreadˉu32ˉlittle(Wir, Directory + 12u32);
            let End: u32 = Operation + Bytesˉreadˉu32ˉlittle(Wir, Directory + 16u32);
            while Operation < End {
                let Kind: u32 = Bytesˉreadˉu16ˉlittle(Wir,
                    Compilerˉsourceˉwvbˉoperationsˉoffset(Wir) + Operation * 28u32 + 4u32);
                if Kind == 171u32 || Kind == 172u32 || Kind == 173u32 ||
                    Kind == 175u32 || Kind == 193u32 || Kind == 194u32 { return true; }
                Operation = Operation + 1u32;
            }
        }
        Index = Index + 1u32;
    }
    return false;
}

fn Compilerˉsourceˉwvbˉmoduleˉhasˉbudgetˉhelperˉtransfer(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Bindings: Sourceˉbindings.Compilerˉsourceˉbindingˉsummary,
    Wir: bytes,
    Orders: Compilerˉsourceˉwvbˉsymbolˉorders
) -> bool {
    let Functions: Compilerˉsourceˉwvbˉsymbolˉorder =
        Compilerˉsourceˉwvbˉfunctionˉorder(Orders);
    let Symbolˉentries: u32 = Bytesˉreadˉu32ˉlittle(Symbols.Directory, 8u32);
    var Rank: u32 = 0u32;
    while Rank < Bytesˉlength(Functions.Entries) / 4u32 {
        let Function: u32 = Compilerˉsourceˉwvbˉorderedˉsymbol(Functions, Rank);
        let Entry: u32 = Sourceˉwir.Compilerˉsourceˉwirˉfunctionsˉoffset(Wir) +
            Function * 48u32;
        if Bytesˉreadˉu32ˉlittle(Wir, Entry + 44u32) == 805306368u32 {
            return true;
        }
        let Parameters: u32 = Bytesˉreadˉu32ˉlittle(Wir, Entry + 36u32);
        var Parameter: u32 = 0u32;
        while Parameter < Parameters {
            if Sourceˉwir.Compilerˉsourceˉwirˉbindingˉshape(
                    Bindings, Symbolˉentries, Function, Parameter) == 805306368u32 &&
                Sourceˉwir.Compilerˉsourceˉwirˉfunctionˉparameterˉborrowˉmode(
                    Input, Scan, Symbols, Bindings, Function, Parameter) ==
                    Sourceˉdeclarations.COMPILER_SOURCE_BORROW_MODE_MUTABLE {
                return true;
            }
            Parameter = Parameter + 1u32;
        }
        Rank = Rank + 1u32;
    }
    return false;
}

fn Compilerˉsourceˉwvbˉmoduleˉhasˉvectorˉmutation(
    Wir: bytes,
    Orders: Compilerˉsourceˉwvbˉsymbolˉorders
) -> bool {
    let Functions: Compilerˉsourceˉwvbˉsymbolˉorder = Compilerˉsourceˉwvbˉfunctionˉorder(Orders);
    var Index: u32 = 0u32;
    while Index < Bytesˉlength(Functions.Entries) / 4u32 {
        let Entry: u32 = Sourceˉwir.Compilerˉsourceˉwirˉfunctionsˉoffset(Wir) +
            Compilerˉsourceˉwvbˉorderedˉsymbol(Functions, Index) * 48u32;
        var Operation: u32 = Bytesˉreadˉu32ˉlittle(Wir, Entry + 12u32);
        let End: u32 = Operation + Bytesˉreadˉu32ˉlittle(Wir, Entry + 16u32);
        while Operation < End {
            let Kind: u32 = Bytesˉreadˉu16ˉlittle(Wir,
                Compilerˉsourceˉwvbˉoperationsˉoffset(Wir) + Operation * 28u32 + 4u32);
            if Kind == 193u32 || Kind == 194u32 { return true; }
            Operation = Operation + 1u32;
        }
        Index = Index + 1u32;
    }
    return false;
}

fn Compilerˉsourceˉwvbˉmoduleˉhasˉfoundationˉborrow(
    Wir: bytes,
    Orders: Compilerˉsourceˉwvbˉsymbolˉorders
) -> bool {
    let Minor: u32 = Bytesˉreadˉu16ˉlittle(Wir, 6u32);
    if Minor == 39u32 || Minor == 40u32 { return true; }
    let Functions: Compilerˉsourceˉwvbˉsymbolˉorder = Compilerˉsourceˉwvbˉfunctionˉorder(Orders);
    var Index: u32 = 0u32;
    while Index < Bytesˉlength(Functions.Entries) / 4u32 {
        let Entry: u32 = Sourceˉwir.Compilerˉsourceˉwirˉfunctionsˉoffset(Wir) +
            Compilerˉsourceˉwvbˉorderedˉsymbol(Functions, Index) * 48u32;
        var Operation: u32 = Bytesˉreadˉu32ˉlittle(Wir, Entry + 12u32);
        let End: u32 = Operation + Bytesˉreadˉu32ˉlittle(Wir, Entry + 16u32);
        while Operation < End {
            let Kind: u32 = Bytesˉreadˉu16ˉlittle(Wir,
                    Compilerˉsourceˉwvbˉoperationsˉoffset(Wir) + Operation * 28u32 + 4u32
                );
            if Kind == 191u32 || Kind == 192u32 || Kind == 205u32 { return true; }
            Operation = Operation + 1u32;
        }
        Index = Index + 1u32;
    }
    return false;
}

fn Compilerˉsourceˉwvbˉfoundationˉborrowedˉoptionˉshape(
    Shape: u32,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Orders: Compilerˉsourceˉwvbˉsymbolˉorders
) -> bytes {
    return Compilerˉsourceˉwvbˉborrowedˉaggregateˉshape(
        Compilerˉsourceˉwvbˉplannedˉshape(
            Compilerˉsourceˉwvbˉborrowedˉoptionˉvalueˉshape(
                Shape
            ),
            Symbols,
            Orders
        )
    );
}

fn Compilerˉsourceˉwvbˉfoundationˉborrowedˉpayloadˉshape(
    Planned: bytes
) -> bytes {
    return Bytesˉconcat(Bytesˉfromˉu8(37u8), Planned);
}

fn Compilerˉsourceˉwvbˉtemporaryˉhasˉfoundationˉborrow(
    Borrowˉplan: Foundationˉborrows.Borrowˉplan,
    Temporary: u32
) -> bool {
    return Temporary < Bytesˉlength(Borrowˉplan.Temporaryˉstate) &&
        Bytesˉreadˉu8(Borrowˉplan.Temporaryˉstate, Temporary) != 0u8;
}

export fn Compilerˉsourceˉwvbˉemitˉoperation(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Source: bytes,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Bindings: Sourceˉbindings.Compilerˉsourceˉbindingˉsummary,
    Orders: Compilerˉsourceˉwvbˉsymbolˉorders,
    Plan: Compilerˉsourceˉwvbˉtextˉplan,
    Wir: bytes,
    Operationˉentry: u32,
    Operationˉend: u32,
    Parameters: u32,
    Locals: u32,
    Firstˉtemporary: u32,
    Temporaryˉmapping: bytes,
    Borrowˉplan: Foundationˉborrows.Borrowˉplan,
    Borrowˉowners: Foundationˉborrows.Ownerˉplan,
    Firstˉborrowˉowner: u32,
    Vectorˉborrowˉsources: bytes
) -> bytes {
    let Operation: u32 = Bytesˉreadˉu16ˉlittle(Wir, Operationˉentry + 4u32);
    let Shape: u32 = Bytesˉreadˉu32ˉlittle(Wir, Operationˉentry + 8u32);
    let Temporary: u32 = Bytesˉreadˉu32ˉlittle(Wir, Operationˉentry + 12u32);
    let Firstˉoperand: u32 = Bytesˉreadˉu32ˉlittle(Wir, Operationˉentry + 16u32);
    let Operandˉcount: u32 = Bytesˉreadˉu16ˉlittle(Wir, Operationˉentry + 6u32);
    let Target: u32 = Bytesˉreadˉu32ˉlittle(Wir, Operationˉentry + 20u32);
    let Auxiliary: u32 = Bytesˉreadˉu32ˉlittle(Wir, Operationˉentry + 24u32);
    let Operandsˉoffset: u32 = Compilerˉsourceˉwvbˉoperandsˉoffset(Wir);
    let Temporariesˉoffset: u32 = Compilerˉsourceˉwvbˉtemporariesˉoffset(Wir);
    var Result: bytes = Compilerˉsourceˉwvbˉempty(Wir);
    if Operation == 64u32 { return Result; }
    if Operation == 7u32 && Compilerˉsourceˉwvbˉvectorˉborrowˉsource(
            Vectorˉborrowˉsources, Temporary
        ) != 0u32 { return Result; }
    var Operand: u32 = 0u32;
    while Operand < Operandˉcount {
        let Operandˉtemporary: u32 = Bytesˉreadˉu32ˉlittle(
            Wir, Operandsˉoffset + (Firstˉoperand + Operand) * 4u32
        );
        var Operandˉload: bytes = Compilerˉsourceˉwvbˉloadˉtemporary(
            Operandˉtemporary, Parameters, Locals, Temporaryˉmapping
        );
        let Vectorˉorigin: u32 = Compilerˉsourceˉwvbˉvectorˉborrowˉsource(
            Vectorˉborrowˉsources, Operandˉtemporary
        );
        if Vectorˉorigin != 0u32 {
            Operandˉload = Compilerˉsourceˉwvbˉinstructionˉu32(4u8, Vectorˉorigin - 1u32);
        }
        let Operandˉshape: u32 = Bytesˉreadˉu32ˉlittle(
            Wir,
            Temporariesˉoffset +
                (Firstˉtemporary + Operandˉtemporary) * 4u32
        );
        if Operation == 205u32 && Operand == 0u32 {
            // The bytecode verifier proves the range against this owner slot.
            // Argument evaluation has already completed in source order.
            Operandˉload = Compilerˉsourceˉwvbˉinstructionˉu32(4u8, Target);
        }
        if (Operation == 195u32 && Operand == 0u32) || Operation == 202u32 {
            Operandˉload = Compilerˉsourceˉwvbˉinstructionˉu32(205u8,
                Compilerˉsourceˉwvbˉtemporaryˉslot(Operandˉtemporary, Parameters, Locals, Temporaryˉmapping));
        }
        if Operation == 62u32 &&
            (Compilerˉsourceˉwvbˉshapeˉrequiresˉownedˉtake(
                Input, Scan, Symbols, Bindings, Wir, Operandˉshape, Orders
            ) || Compilerˉsourceˉwvbˉshapeˉisˉtaskˉowner(
                Input, Scan, Symbols, Bindings, Operandˉshape
            )) {
            let Mode: u32 =
                Sourceˉwir.Compilerˉsourceˉwirˉfunctionˉparameterˉborrowˉmode(
                    Input, Scan, Symbols, Bindings, Target, Operand
                );
            if Mode == Sourceˉdeclarations.COMPILER_SOURCE_BORROW_MODE_VALUE {
                Operandˉload = Compilerˉsourceˉwvbˉinstructionˉu32(
                    205u8,
                    Compilerˉsourceˉwvbˉtemporaryˉslot(
                        Operandˉtemporary, Parameters, Locals,
                        Temporaryˉmapping
                    )
                );
            }
        }
        // Variant construction transfers owned payloads just like records and arrays.
        if (Operation == 17u32 || Operation == 19u32 || Operation == 65u32 ||
                Operation == 165u32) &&
            (Compilerˉsourceˉwvbˉshapeˉrequiresˉownedˉtake(
                Input, Scan, Symbols, Bindings, Wir, Operandˉshape, Orders
            ) || Compilerˉsourceˉwvbˉshapeˉisˉtaskˉowner(
                Input, Scan, Symbols, Bindings, Operandˉshape
            )) {
            Operandˉload = Compilerˉsourceˉwvbˉinstructionˉu32(
                205u8,
                Compilerˉsourceˉwvbˉtemporaryˉslot(
                    Operandˉtemporary, Parameters, Locals,
                    Temporaryˉmapping
                )
            );
        }
        if Operation == 8u32 || Operation == 164u32 {
            let Plannedˉoperandˉshape: u32 =
                Compilerˉsourceˉwvbˉplannedˉshapeˉvalue(
                    Operandˉshape, Symbols, Orders
                );
            if (Plannedˉoperandˉshape >= 327680u32 &&
                    Plannedˉoperandˉshape < 393216u32) ||
                (Operation == 8u32 &&
                    (Compilerˉsourceˉwvbˉshapeˉrequiresˉownedˉtake(
                        Input, Scan, Symbols, Bindings,
                        Wir, Operandˉshape, Orders
                    ) || Compilerˉsourceˉwvbˉshapeˉisˉtaskˉowner(
                        Input, Scan, Symbols, Bindings, Operandˉshape
                    ))) ||
                (Operation == 164u32 &&
                    Compilerˉsourceˉwvbˉshapeˉisˉaffineˉresult(
                        Wir, Operandˉshape
                    )) {
                if !Compilerˉsourceˉwvbˉtemporaryˉhasˉfoundationˉborrow(
                        Borrowˉplan, Operandˉtemporary
                    ) {
                    Operandˉload = Compilerˉsourceˉwvbˉinstructionˉu32(
                        205u8,
                        Compilerˉsourceˉwvbˉtemporaryˉslot(
                            Operandˉtemporary, Parameters, Locals,
                            Temporaryˉmapping
                        )
                    );
                }
            }
        }
        Result = Bytesˉconcat(Result, Operandˉload);
        Operand = Operand + 1u32;
    }
    if Operation == 1u32 {
        Result = Bytesˉconcat(
            Result, Compilerˉsourceˉwvbˉinstructionˉu32(1u8, Target)
        );
    }
    if Operation == 2u32 {
        Result = Bytesˉconcat(Result, Bytesˉfromˉu8(8u8));
        Result = Bytesˉconcat(
            Result, Bytesˉslice(Bytesˉfromˉu32ˉlittle(Target), 0u32, 1u32)
        );
    }
    if Operation == 3u32 {
        Result = Bytesˉconcat(
            Result, Compilerˉsourceˉwvbˉinstructionˉu32(9u8, Target)
        );
    }
    if Operation == 4u32 {
        Result = Bytesˉconcat(Result, Bytesˉfromˉu8(2u8));
        Result = Bytesˉconcat(
            Result, Bytesˉslice(Bytesˉfromˉu32ˉlittle(Target), 0u32, 1u32)
        );
    }
    if Operation == 93u32 || Operation == 94u32 {
        Result = Bytesˉconcat(
            Result, Compilerˉsourceˉwvbˉopcode(Operation)
        );
        Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Target));
        Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Auxiliary));
    }
    if Operation == 5u32 {
        Result = Bytesˉconcat(
            Result,
            Compilerˉsourceˉwvbˉinstructionˉu32(
                3u8,
                Compilerˉsourceˉwvbˉtextˉoperationˉdataˉindex(
                    Input, Scan, Source, Symbols, Plan,
                    Compilerˉsourceˉwvbˉdataˉorder(Orders),
                    Wir, Operationˉentry
                )
            )
        );
    }
    if Operation == 6u32 {
        Result = Bytesˉconcat(
            Result,
            Compilerˉsourceˉwvbˉinstructionˉu32(
                10u8,
                Compilerˉsourceˉwvbˉexplicitˉdataˉindex(
                    Input, Scan, Symbols, Plan,
                    Compilerˉsourceˉwvbˉdataˉorder(Orders), Target
                )
            )
        );
    }
    if Operation == 7u32 {
        var Loadˉopcode: u8 = 4u8;
        if (Compilerˉsourceˉwvbˉshapeˉrequiresˉownedˉtake(
                Input, Scan, Symbols, Bindings, Wir, Shape, Orders
            ) || Compilerˉsourceˉwvbˉshapeˉisˉtaskˉowner(
                Input, Scan, Symbols, Bindings, Shape
            )) && !Compilerˉsourceˉwvbˉtemporaryˉisˉborrowedˉcallˉoperand(
                Input, Scan, Symbols, Bindings, Wir,
                Operationˉentry + 28u32, Operationˉend, Temporary, Shape
            ) && !Compilerˉsourceˉwvbˉtemporaryˉhasˉfoundationˉborrow(
                Borrowˉplan, Temporary
            ) {
            Loadˉopcode = 205u8;
        }
        Result = Bytesˉconcat(
            Result,
            Compilerˉsourceˉwvbˉinstructionˉu32(Loadˉopcode, Target)
        );
    }
    if Operation == 8u32 {
        Result = Bytesˉconcat(
            Result, Compilerˉsourceˉwvbˉinstructionˉu32(5u8, Target)
        );
    }
    if Operation == 9u32 {
        Result = Bytesˉconcat(
            Result,
            Compilerˉsourceˉwvbˉinstructionˉu32(
                6u8,
                Compilerˉsourceˉwvbˉexplicitˉdataˉindex(
                    Input, Scan, Symbols, Plan,
                    Compilerˉsourceˉwvbˉdataˉorder(Orders), Target
                )
            )
        );
    }
    if Operation == 10u32 {
        Result = Bytesˉconcat(
            Result,
            Compilerˉsourceˉwvbˉinstructionˉu32(
                7u8,
                Compilerˉsourceˉwvbˉexplicitˉdataˉindex(
                    Input, Scan, Symbols, Plan,
                    Compilerˉsourceˉwvbˉdataˉorder(Orders), Target
                )
            )
        );
    }
    if Operation == 17u32 {
        Result = Bytesˉconcat(
            Result,
            Compilerˉsourceˉwvbˉinstructionˉu32(
                104u8,
                Compilerˉsourceˉwvbˉplannedˉnominalˉtarget(
                    Target, Symbols, Orders
                )
            )
        );
    }
    if Operation == 18u32 {
        Result = Bytesˉconcat(
            Result, Compilerˉsourceˉwvbˉinstructionˉu32(105u8, Auxiliary)
        );
    }
    if Operation == 19u32 {
        Result = Bytesˉconcat(
            Result,
            Compilerˉsourceˉwvbˉinstructionˉu32(
                106u8,
                Compilerˉsourceˉwvbˉplannedˉnominalˉtarget(
                    Target, Symbols, Orders
                )
            )
        );
        Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Auxiliary));
    }
    if Operation == 62u32 {
        Result = Bytesˉconcat(
            Result,
            Compilerˉsourceˉwvbˉinstructionˉu32(
                64u8,
                Compilerˉsourceˉwvbˉorderedˉrank(
                    Compilerˉsourceˉwvbˉfunctionˉorder(Orders), Target
                )
            )
        );
    }
    if Operation == 63u32 {
        let Capabilityˉorder: Compilerˉsourceˉwvbˉsymbolˉorder =
            Compilerˉsourceˉwvbˉcapabilityˉorder(Orders);
        let Targetˉview: Sourceˉset.Compilerˉsourceˉsetˉview =
            Compilerˉsourceˉwvbˉsymbolˉsource(
            Input, Scan, Symbols, Target
        );
        let Targetˉentry: u32 = 16u32 + Target * 24u32;
        let Targetˉnameˉoffset: u32 = Bytesˉreadˉu32ˉlittle(
            Symbols.Directory, Targetˉentry + 12u32
        );
        let Targetˉnameˉlength: u32 = Bytesˉreadˉu32ˉlittle(
            Symbols.Directory, Targetˉentry + 16u32
        );
        var Capabilityˉrank: u32 = 0u32;
        var Searchˉrank: u32 = 0u32;
        var Searching: bool = true;
        while Searching {
            if Searchˉrank >= Symbols.Capabilities {
                Searching = false;
            } else {
                let Entry: u32 = Compilerˉsourceˉwvbˉorderedˉsymbol(
                    Capabilityˉorder, Searchˉrank
                );
                if Compilerˉsourceˉwvbˉsymbolˉmodule(Symbols, Entry) == 0u32 {
                    let Candidateˉview: Sourceˉset.Compilerˉsourceˉsetˉview =
                        Compilerˉsourceˉwvbˉsymbolˉsource(
                            Input, Scan, Symbols, Entry
                        );
                    let Candidateˉentry: u32 = 16u32 + Entry * 24u32;
                    let Candidateˉnameˉoffset: u32 = Bytesˉreadˉu32ˉlittle(
                        Symbols.Directory, Candidateˉentry + 12u32
                    );
                    let Candidateˉnameˉlength: u32 = Bytesˉreadˉu32ˉlittle(
                        Symbols.Directory, Candidateˉentry + 16u32
                    );
                    if Sourceˉset.Compilerˉsourceˉspansˉequal(
                        Candidateˉview.Source, Candidateˉnameˉoffset,
                        Candidateˉnameˉlength,
                        Targetˉview.Source, Targetˉnameˉoffset, Targetˉnameˉlength
                    ) {
                        Searching = false;
                    } else {
                        Capabilityˉrank = Capabilityˉrank + 1u32;
                    }
                }
                Searchˉrank = Searchˉrank + 1u32;
            }
        }
        Result = Bytesˉconcat(
            Result,
            Compilerˉsourceˉwvbˉinstructionˉu32(
                65u8,
                Capabilityˉrank
            )
        );
    }
    if Operation >= 65u32 {
        if Operation <= 67u32 {
            Result = Bytesˉconcat(
                Result,
                Compilerˉsourceˉwvbˉinstructionˉbytesˉu32(
                    Compilerˉsourceˉwvbˉopcode(Operation),
                    Compilerˉsourceˉwvbˉplannedˉvariantˉtarget(
                        Target, Symbols, Orders
                    )
                )
            );
            Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Auxiliary));
        }
    }
    if Operation == 68u32 {
        Result = Bytesˉconcat(
            Result,
            Compilerˉsourceˉwvbˉinstructionˉbytesˉu32(
                Compilerˉsourceˉwvbˉopcode(Operation), Target
            )
        );
        Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Auxiliary));
    }
    if Operation >= 69u32 {
        if Operation <= 72u32 {
            Result = Bytesˉconcat(
                Result, Compilerˉsourceˉwvbˉopcode(Operation)
            );
        }
    }
    if Operation >= 73u32 {
        if Operation <= 92u32 {
            Result = Bytesˉconcat(
                Result, Compilerˉsourceˉwvbˉopcode(Operation)
            );
        }
    }
    if Operation >= 95u32 {
        if Operation <= 128u32 {
            Result = Bytesˉconcat(
                Result, Compilerˉsourceˉwvbˉopcode(Operation)
            );
        }
    }
    if Operation >= 129u32 {
        if Operation <= 147u32 {
            var Fixedˉshape: u32 = Shape;
            if Operation >= 136u32 {
                if Operation <= 141u32 { Fixedˉshape = Target; }
            }
            Result = Bytesˉconcat(Result, Bytesˉfromˉu8(192u8));
            Result = Bytesˉconcat(
                Result, Compilerˉsourceˉwvbˉshape(Fixedˉshape)
            );
            Result = Bytesˉconcat(
                Result,
                Bytesˉslice(
                    Bytesˉfromˉu32ˉlittle(Operation - 129u32), 0u32, 1u32
                )
            );
            if Operation == 129u32 {
                Result = Bytesˉconcat(
                    Result, Bytesˉfromˉu16ˉlittle(Target)
                );
            }
        }
    }
    if Operation >= 148u32 {
        if Operation <= 150u32 {
            Result = Bytesˉconcat(Result, Bytesˉfromˉu8(193u8));
            Result = Bytesˉconcat(
                Result,
                Bytesˉslice(
                    Bytesˉfromˉu32ˉlittle(Operation - 148u32), 0u32, 1u32
                )
            );
            if Operation == 148u32 {
                Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Target));
            }
        }
    }
    if Operation >= 151u32 {
        if Operation <= 162u32 {
            var Floatingˉshape: u32 = Shape;
            if Operation >= 157u32 { Floatingˉshape = Target; }
            Result = Bytesˉconcat(Result, Bytesˉfromˉu8(194u8));
            Result = Bytesˉconcat(
                Result, Compilerˉsourceˉwvbˉshape(Floatingˉshape)
            );
            Result = Bytesˉconcat(
                Result,
                Bytesˉslice(
                    Bytesˉfromˉu32ˉlittle(Operation - 151u32), 0u32, 1u32
                )
            );
            if Operation == 151u32 {
                Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Target));
                if Floatingˉshape == 15u32 {
                    Result = Bytesˉconcat(
                        Result, Bytesˉfromˉu32ˉlittle(Auxiliary)
                    );
                }
            }
        }
    }
    if Operation == 163u32 {
        Result = Bytesˉconcat(Result, Bytesˉfromˉu8(195u8));
    }
    if Operation == 164u32 {
        Result = Bytesˉconcat(Result, Bytesˉfromˉu8(196u8));
        Result = Bytesˉconcat(
            Result,
            Bytesˉfromˉu32ˉlittle(
                Compilerˉsourceˉwvbˉplannedˉvariantˉtarget(
                    Target, Symbols, Orders
                )
            )
        );
        Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Auxiliary));
    }
    if Operation == 165u32 {
        Result = Bytesˉconcat(Result, Bytesˉfromˉu8(197u8));
        Result = Bytesˉconcat(
            Result,
            Bytesˉfromˉu32ˉlittle(
                Compilerˉsourceˉwvbˉplannedˉshapeˉvalue(
                    Target, Symbols, Orders
                ) - 262144u32
            )
        );
    }
    if Operation == 166u32 {
        Result = Bytesˉconcat(Result, Bytesˉfromˉu8(198u8));
    }
    if Operation == 167u32 || Operation == 168u32 {
        Result = Bytesˉconcat(
            Result,
            Compilerˉsourceˉwvbˉinstructionˉbytesˉu32(
                Compilerˉsourceˉwvbˉopcode(Operation),
                Compilerˉsourceˉwvbˉplannedˉshapeˉvalue(
                    Target, Symbols, Orders
                ) - 393216u32
            )
        );
    }
    if Operation == 169u32 && Target < Parameters {
        Result = Bytesˉconcat(Result, Compilerˉsourceˉwvbˉinstructionˉu32(226u8, Target));
        Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(
            Compilerˉsourceˉwvbˉplannedˉshapeˉvalue(Auxiliary, Symbols, Orders) - 327680u32
        ));
    } else if Operation == 169u32 || Operation == 170u32 {
        Result = Bytesˉconcat(
            Result, Compilerˉsourceˉwvbˉinstructionˉu32(205u8, Target)
        );
        let Vectorˉtype: u32 =
            Compilerˉsourceˉwvbˉplannedˉshapeˉvalue(
                Auxiliary, Symbols, Orders
            ) - 327680u32;
        Result = Bytesˉconcat(
            Result,
            Compilerˉsourceˉwvbˉinstructionˉbytesˉu32(
                Compilerˉsourceˉwvbˉopcode(Operation), Vectorˉtype
            )
        );
        if Operation == 170u32 {
            Result = Bytesˉconcat(
                Result,
                Bytesˉfromˉu32ˉlittle(
                    Compilerˉsourceˉwvbˉplannedˉshapeˉvalue(
                        Shape, Symbols, Orders
                    ) - 393216u32
                )
            );
        }
    }
    if Operation == 192u32 || Operation == 193u32 {
        Result = Bytesˉconcat(Result, Compilerˉsourceˉwvbˉinstructionˉbytesˉu32(
            Compilerˉsourceˉwvbˉopcode(Operation), Target
        ));
        Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(
            Compilerˉsourceˉwvbˉplannedˉshapeˉvalue(Auxiliary, Symbols, Orders) - 327680u32
        ));
    }
    if Operation == 171u32 {
        Result = Bytesˉconcat(Result, Bytesˉfromˉu8(206u8));
        Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Target));
        Result = Bytesˉconcat(
            Result,
            Bytesˉfromˉu32ˉlittle(
                Compilerˉsourceˉwvbˉplannedˉshapeˉvalue(
                    Shape, Symbols, Orders
                ) - 196608u32
            )
        );
    }
    if Operation == 172u32 {
        Result = Bytesˉconcat(Result, Bytesˉfromˉu8(207u8));
        Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Target));
        Result = Bytesˉconcat(
            Result,
            Bytesˉfromˉu32ˉlittle(
                Compilerˉsourceˉwvbˉplannedˉshapeˉvalue(
                    Shape, Symbols, Orders
                ) - 196608u32
            )
        );
    }
    if Operation == 173u32 || Operation == 194u32 {
        Result = Bytesˉconcat(Result, Bytesˉfromˉu8(208u8));
        Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Target));
        Result = Bytesˉconcat(
            Result,
            Bytesˉfromˉu32ˉlittle(
                Compilerˉsourceˉwvbˉplannedˉshapeˉvalue(
                    Shape, Symbols, Orders
                ) - 196608u32
            )
        );
    }
    if Operation == 174u32 {
        Result = Bytesˉconcat(
            Result, Compilerˉsourceˉwvbˉinstructionˉu32(205u8, Target)
        );
        Result = Bytesˉconcat(Result, Bytesˉfromˉu8(80u8));
    }
    if Operation == 175u32 {
        Result = Bytesˉconcat(Result, Bytesˉfromˉu8(209u8));
        Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Target));
        Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Auxiliary));
        Result = Bytesˉconcat(
            Result,
            Bytesˉfromˉu32ˉlittle(
                Compilerˉsourceˉwvbˉplannedˉshapeˉvalue(
                    Shape, Symbols, Orders
                ) - 196608u32
            )
        );
    }
    if Operation == 176u32 {
        Result = Bytesˉconcat(
            Result, Compilerˉsourceˉwvbˉinstructionˉu32(210u8, Target)
        );
    }
    if Operation == 177u32 {
        Result = Bytesˉconcat(Result, Bytesˉfromˉu8(211u8));
        Result = Bytesˉconcat(
            Result,
            Bytesˉfromˉu32ˉlittle(
                Compilerˉsourceˉwvbˉorderedˉrank(
                    Compilerˉsourceˉwvbˉfunctionˉorder(Orders), Target
                )
            )
        );
        Result = Bytesˉconcat(
            Result,
            Bytesˉfromˉu32ˉlittle(
                Orders.Concreteˉrecords + Symbols.Enums +
                    Orders.Concreteˉvariants + Orders.Genericˉtypeˉentries +
                    Auxiliary
            )
        );
    }
    if Operation == 178u32 {
        Result = Bytesˉconcat(Result, Bytesˉfromˉu8(212u8));
        Result = Bytesˉconcat(
            Result,
            Bytesˉfromˉu32ˉlittle(
                Orders.Concreteˉrecords + Symbols.Enums +
                    Orders.Concreteˉvariants + Orders.Genericˉtypeˉentries +
                    Target
            )
        );
    }
    if Operation == 179u32 {
        Result = Bytesˉconcat(Result, Bytesˉfromˉu8(213u8));
        Result = Bytesˉconcat(
            Result,
            Bytesˉfromˉu32ˉlittle(
                Compilerˉsourceˉwvbˉorderedˉrank(
                    Compilerˉsourceˉwvbˉfunctionˉorder(Orders), Target
                )
            )
        );
        Result = Bytesˉconcat(
            Result,
            Bytesˉfromˉu32ˉlittle(
                Orders.Concreteˉrecords + Symbols.Enums +
                    Orders.Concreteˉvariants + Orders.Genericˉtypeˉentries +
                    Auxiliary
            )
        );
        Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Operandˉcount));
    }
    if Operation == 180u32 {
        Result = Bytesˉconcat(Result, Bytesˉfromˉu8(214u8));
        Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Target));
        Result = Bytesˉconcat(
            Result,
            Bytesˉfromˉu32ˉlittle(
                Compilerˉsourceˉwvbˉplannedˉshapeˉvalue(
                    Shape, Symbols, Orders
                ) - 196608u32
            )
        );
    }
    if Operation == 181u32 {
        Result = Bytesˉconcat(Result, Bytesˉfromˉu8(215u8));
        Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Target));
        Result = Bytesˉconcat(
            Result,
            Bytesˉfromˉu32ˉlittle(
                Compilerˉsourceˉwvbˉplannedˉshapeˉvalue(
                    Shape, Symbols, Orders
                ) - 65536u32
            )
        );
    }
    if Operation == 182u32 {
        Result = Bytesˉconcat(Result, Bytesˉfromˉu8(216u8));
        Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Target));
        Result = Bytesˉconcat(
            Result,
            Bytesˉfromˉu32ˉlittle(
                Compilerˉsourceˉwvbˉplannedˉshapeˉvalue(
                    Shape, Symbols, Orders
                ) - 196608u32
            )
        );
        Result = Bytesˉconcat(
            Result,
            Bytesˉfromˉu32ˉlittle(
                Compilerˉsourceˉwvbˉplannedˉshapeˉvalue(
                    Auxiliary, Symbols, Orders
                ) - 65536u32
            )
        );
    }
    if Operation == 183u32 {
        Result = Bytesˉconcat(Result, Bytesˉfromˉu8(217u8));
        Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Target));
        Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Auxiliary));
        Result = Bytesˉconcat(
            Result,
            Bytesˉfromˉu32ˉlittle(
                Compilerˉsourceˉwvbˉplannedˉshapeˉvalue(
                    Shape, Symbols, Orders
                ) - 196608u32
            )
        );
    }
    if Operation == 184u32 {
        Result = Bytesˉconcat(Result, Bytesˉfromˉu8(218u8));
        Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Target));
        Result = Bytesˉconcat(
            Result,
            Bytesˉfromˉu32ˉlittle(
                Compilerˉsourceˉwvbˉplannedˉshapeˉvalue(
                    Shape, Symbols, Orders
                ) - 196608u32
            )
        );
    }
    if Operation == 185u32 {
        Result = Bytesˉconcat(Result, Bytesˉfromˉu8(219u8));
        Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Target));
        Result = Bytesˉconcat(
            Result,
            Bytesˉslice(
                Bytesˉfromˉu32ˉlittle(Auxiliary), 0u32, 1u32
            )
        );
    }
    if Operation == 186u32 {
        Result = Bytesˉconcat(Result, Bytesˉfromˉu8(220u8));
        Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Target));
        Result = Bytesˉconcat(
            Result,
            Bytesˉfromˉu32ˉlittle(
                Compilerˉsourceˉwvbˉplannedˉshapeˉvalue(
                    Shape, Symbols, Orders
                ) - 196608u32
            )
        );
        Result = Bytesˉconcat(
            Result,
            Bytesˉfromˉu32ˉlittle(
                Compilerˉsourceˉwvbˉplannedˉshapeˉvalue(
                    Auxiliary, Symbols, Orders
                ) - 131072u32
            )
        );
    }
    if Operation == 187u32 {
        Result = Bytesˉconcat(Result, Bytesˉfromˉu8(221u8));
        Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Target));
        Result = Bytesˉconcat(
            Result,
            Bytesˉfromˉu32ˉlittle(
                Compilerˉsourceˉwvbˉplannedˉshapeˉvalue(
                    Auxiliary, Symbols, Orders
                ) - 131072u32
            )
        );
    }
    if Operation == 188u32 {
        Result = Bytesˉconcat(Result, Bytesˉfromˉu8(222u8));
        Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Target));
        Result = Bytesˉconcat(
            Result,
            Bytesˉfromˉu32ˉlittle(
                Compilerˉsourceˉwvbˉplannedˉshapeˉvalue(
                    Shape, Symbols, Orders
                ) - 196608u32
            )
        );
        Result = Bytesˉconcat(
            Result,
            Bytesˉfromˉu32ˉlittle(
                Compilerˉsourceˉwvbˉplannedˉshapeˉvalue(
                    Auxiliary, Symbols, Orders
                ) - 131072u32
            )
        );
    }
    if Operation == 189u32 {
        Result = Bytesˉconcat(Result, Bytesˉfromˉu8(223u8));
        Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Target));
        Result = Bytesˉconcat(
            Result,
            Bytesˉfromˉu32ˉlittle(
                Compilerˉsourceˉwvbˉplannedˉshapeˉvalue(
                    Shape, Symbols, Orders
                ) - 65536u32
            )
        );
        Result = Bytesˉconcat(
            Result,
            Bytesˉfromˉu32ˉlittle(
                Compilerˉsourceˉwvbˉplannedˉshapeˉvalue(
                    Auxiliary, Symbols, Orders
                ) - 131072u32
            )
        );
    }
    if Operation == 190u32 {
        let Foreignˉpointerˉtemporary: u32 = Bytesˉreadˉu32ˉlittle(
            Wir, Operandsˉoffset + Firstˉoperand * 4u32
        );
        let Foreignˉpointerˉshape: u32 = Bytesˉreadˉu32ˉlittle(
            Wir,
            Temporariesˉoffset +
                (Firstˉtemporary + Foreignˉpointerˉtemporary) * 4u32
        );
        let Foreignˉtypeˉcatalog:
            Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog =
            Compilerˉsourceˉwvbˉbindingsˉtypeˉcatalog(Bindings.Directory);
        let Foreignˉabiˉshape: u32 =
            Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalogˉshapeˉtypeˉargument(
                Foreignˉtypeˉcatalog, Foreignˉpointerˉshape, 1u32
            );
        Result = Bytesˉconcat(Result, Bytesˉfromˉu8(224u8));
        // Identity 1 is the exact registered paper-buffer source binding.
        Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(1u32));
        Result = Bytesˉconcat(
            Result,
            Bytesˉfromˉu32ˉlittle(
                Compilerˉsourceˉwvbˉplannedˉshapeˉvalue(
                    Foreignˉpointerˉshape, Symbols, Orders
                ) - 65536u32
            )
        );
        Result = Bytesˉconcat(
            Result,
            Bytesˉfromˉu32ˉlittle(
                Compilerˉsourceˉwvbˉplannedˉshapeˉvalue(
                    Foreignˉabiˉshape, Symbols, Orders
                ) - 131072u32
            )
        );
    }
    if Operation == 191u32 {
        Result = Bytesˉconcat(Result, Bytesˉfromˉu8(225u8));
        Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Target));
        Result = Bytesˉconcat(
            Result,
            Bytesˉfromˉu32ˉlittle(
                Compilerˉsourceˉwvbˉplannedˉshapeˉvalue(
                    Compilerˉsourceˉwvbˉborrowedˉoptionˉvalueˉshape(
                        Shape
                    ),
                    Symbols,
                    Orders
                ) - 196608u32
            )
        );
        Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Auxiliary));
    }
    if Operation >= 195u32 && Operation <= 201u32 {
        let Indices: Compilerˉsourceˉwvbˉbytesˉresultˉindices = Compilerˉsourceˉwvbˉresolveˉbytesˉresultˉindices(Input, Scan, Symbols, Orders, Shape, Auxiliary, Operation == 195u32);
        Result = Bytesˉconcat(Result, Compilerˉsourceˉwvbˉopcode(Operation));
        if Operation == 195u32 {
            Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Indices.Result));
            Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Indices.Failure));
            Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Indices.Reason));
        } else {
            Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Target));
            Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Indices.Result));
            Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Indices.Failure));
        }
    }
    if Operation >= 202u32 && Operation <= 207u32 {
        Result = Bytesˉconcat(Result, Compilerˉsourceˉwvbˉopcode(Operation));
        if Operation == 205u32 { Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Target)); }
    }
    if Operation >= 11u32 {
        if Operation <= 16u32 {
            Result = Bytesˉconcat(
                Result, Compilerˉsourceˉwvbˉopcode(Operation)
            );
        }
    }
    if Operation >= 20u32 {
        if Operation <= 22u32 {
            Result = Bytesˉconcat(
                Result, Compilerˉsourceˉwvbˉopcode(Operation)
            );
        }
    }
    if Operation >= 23u32 {
        if Operation <= 61u32 {
            Result = Bytesˉconcat(
                Result, Compilerˉsourceˉwvbˉopcode(Operation)
            );
        }
    }
    if Shape != 0u32 {
        let Owner: u32 = Foundationˉborrows.Ownerˉslot(Borrowˉowners, Temporary);
        if Owner != 0u32 {
            let Slot: u32 = Firstˉborrowˉowner + Owner - 1u32;
            Result = Bytesˉconcat(Result, Compilerˉsourceˉwvbˉinstructionˉu32(5u8, Slot));
            Result = Bytesˉconcat(Result, Compilerˉsourceˉwvbˉinstructionˉu32(4u8, Slot));
        }
        Result = Bytesˉconcat(
            Result,
            Compilerˉsourceˉwvbˉinstructionˉu32(
                5u8,
                Compilerˉsourceˉwvbˉtemporaryˉslot(
                    Temporary, Parameters, Locals, Temporaryˉmapping
                )
            )
        );
    }
    if Operation == 167u32 || Operation == 168u32 {
        Result = Bytesˉconcat(Result, Bytesˉfromˉu8(80u8));
    }
    if Operation == 169u32 && Target >= Parameters {
        Result = Bytesˉconcat(
            Result, Compilerˉsourceˉwvbˉinstructionˉu32(5u8, Target)
        );
    }
    return Result;
}

export fn Compilerˉsourceˉwvbˉemitˉphiˉprelude(
    Wir: bytes,
    Firstˉblock: u32,
    Predecessor: u32,
    Targetˉblock: u32,
    Parameters: u32,
    Locals: u32,
    Temporaryˉmapping: bytes,
    Firstˉtemporary: u32,
    Orders: Compilerˉsourceˉwvbˉsymbolˉorders
) -> bytes {
    if Compilerˉsourceˉwvbˉphiˉpreludeˉlength(
        Wir, Firstˉblock, Predecessor, Targetˉblock
    ) == 0u32 { return Compilerˉsourceˉwvbˉempty(Wir); }
    let Targetˉentry: u32 = Compilerˉsourceˉwvbˉblocksˉoffset(Wir) +
        (Firstˉblock + Targetˉblock) * 28u32;
    let Firstˉoperation: u32 = Bytesˉreadˉu32ˉlittle(Wir, Targetˉentry + 4u32);
    let Phiˉentry: u32 = Compilerˉsourceˉwvbˉoperationsˉoffset(Wir) +
        Firstˉoperation * 28u32;
    let Firstˉoperand: u32 = Bytesˉreadˉu32ˉlittle(Wir, Phiˉentry + 16u32);
    var Operandˉindex: u32 = 0u32;
    if Bytesˉreadˉu32ˉlittle(Wir, Phiˉentry + 24u32) == Predecessor {
        Operandˉindex = 1u32;
    }
    let Operandˉtemporary: u32 = Bytesˉreadˉu32ˉlittle(
        Wir,
        Compilerˉsourceˉwvbˉoperandsˉoffset(Wir) +
            (Firstˉoperand + Operandˉindex) * 4u32
    );
    let Phiˉtemporary: u32 = Bytesˉreadˉu32ˉlittle(
        Wir, Phiˉentry + 12u32
    );
    var Loaded: bytes = Compilerˉsourceˉwvbˉloadˉtemporary(
        Operandˉtemporary, Parameters, Locals, Temporaryˉmapping
    );
    let Shape: u32 = Bytesˉreadˉu32ˉlittle(Wir, Compilerˉsourceˉwvbˉtemporariesˉoffset(Wir) + (Firstˉtemporary + Operandˉtemporary) * 4u32);
    if Compilerˉsourceˉwvbˉshapeˉrequiresˉtake(Wir, Shape, Orders) {
        Loaded = Compilerˉsourceˉwvbˉinstructionˉu32(205u8,
            Compilerˉsourceˉwvbˉtemporaryˉslot(Operandˉtemporary, Parameters, Locals, Temporaryˉmapping));
    }
    return Bytesˉconcat(
        Loaded,
        Compilerˉsourceˉwvbˉinstructionˉu32(
            5u8,
            Compilerˉsourceˉwvbˉtemporaryˉslot(
                Phiˉtemporary, Parameters, Locals, Temporaryˉmapping
            )
        )
    );
}

export fn Compilerˉsourceˉwvbˉemitˉterminator(
    Wir: bytes,
    Firstˉblock: u32,
    Blockˉentry: u32,
    Blockˉoffsets: bytes,
    Parameters: u32,
    Locals: u32,
    Returnˉrequiresˉtake: bool,
    Temporaryˉmapping: bytes,
    Firstˉtemporary: u32,
    Orders: Compilerˉsourceˉwvbˉsymbolˉorders
) -> bytes {
    let Terminator: u32 = Bytesˉreadˉu32ˉlittle(Wir, Blockˉentry + 12u32);
    let Value: u32 = Bytesˉreadˉu32ˉlittle(Wir, Blockˉentry + 16u32);
    let Firstˉtarget: u32 = Bytesˉreadˉu32ˉlittle(Wir, Blockˉentry + 20u32);
    let Secondˉtarget: u32 = Bytesˉreadˉu32ˉlittle(Wir, Blockˉentry + 24u32);
    var Result: bytes = Compilerˉsourceˉwvbˉempty(Wir);
    if Terminator == 1u32 {
        let Predecessor: u32 = Bytesˉreadˉu32ˉlittle(Wir, Blockˉentry);
        Result = Compilerˉsourceˉwvbˉemitˉphiˉprelude(
            Wir, Firstˉblock, Predecessor, Firstˉtarget,
            Parameters, Locals, Temporaryˉmapping, Firstˉtemporary, Orders
        );
        return Bytesˉconcat(
            Result,
            Compilerˉsourceˉwvbˉinstructionˉu32(
                48u8, Bytesˉreadˉu32ˉlittle(Blockˉoffsets, Firstˉtarget * 4u32)
            )
        );
    }
    if Terminator == 2u32 {
        Result = Compilerˉsourceˉwvbˉloadˉtemporary(
            Value, Parameters, Locals, Temporaryˉmapping
        );
        Result = Bytesˉconcat(
            Result,
            Compilerˉsourceˉwvbˉinstructionˉu32(
                49u8,
                Bytesˉreadˉu32ˉlittle(Blockˉoffsets, Secondˉtarget * 4u32)
            )
        );
        return Bytesˉconcat(
            Result,
            Compilerˉsourceˉwvbˉinstructionˉu32(
                48u8,
                Bytesˉreadˉu32ˉlittle(Blockˉoffsets, Firstˉtarget * 4u32)
            )
        );
    }
    if Value != Sourceˉwir.Compilerˉsourceˉwirˉsentinel() {
        if Returnˉrequiresˉtake {
            Result = Compilerˉsourceˉwvbˉinstructionˉu32(
                205u8,
                Compilerˉsourceˉwvbˉtemporaryˉslot(
                    Value, Parameters, Locals, Temporaryˉmapping
                )
            );
        } else {
            Result = Compilerˉsourceˉwvbˉloadˉtemporary(
                Value, Parameters, Locals, Temporaryˉmapping
            );
        }
    }
    return Bytesˉconcat(Result, Bytesˉfromˉu8(81u8));
}

export fn Compilerˉsourceˉwvbˉfunctionˉfailure(
    Wir: bytes,
    Status: Compilerˉsourceˉwvbˉstatus,
    Operation: u32
) -> Compilerˉsourceˉwvbˉfunctionˉencoding {
    let Empty: bytes = Compilerˉsourceˉwvbˉempty(Wir);
    return Compilerˉsourceˉwvbˉfunctionˉencoding(
        Status, Empty, Empty, Operation, 0u32, Enumˉname(Status)
    );
}

export fn Compilerˉsourceˉwvbˉinferredˉlocalˉshape(
    Wir: bytes,
    Function: u32,
    Slot: u32
) -> u32 {
    let Functionˉentry: u32 =
        Sourceˉwir.Compilerˉsourceˉwirˉfunctionsˉoffset(Wir) +
            Function * 48u32;
    let Firstˉoperation: u32 = Bytesˉreadˉu32ˉlittle(
        Wir, Functionˉentry + 12u32
    );
    let Operationˉcount: u32 = Bytesˉreadˉu32ˉlittle(
        Wir, Functionˉentry + 16u32
    );
    let Firstˉtemporary: u32 = Bytesˉreadˉu32ˉlittle(
        Wir, Functionˉentry + 20u32
    );
    let Operationsˉoffset: u32 = Compilerˉsourceˉwvbˉoperationsˉoffset(Wir);
    let Temporariesˉoffset: u32 = Compilerˉsourceˉwvbˉtemporariesˉoffset(Wir);
    let Operandsˉoffset: u32 = Compilerˉsourceˉwvbˉoperandsˉoffset(Wir);
    var Index: u32 = 0u32;
    while Index < Operationˉcount {
        let Operationˉentry: u32 = Operationsˉoffset + (
            Firstˉoperation + Index
        ) * 28u32;
        if Bytesˉreadˉu16ˉlittle(Wir, Operationˉentry + 4u32) == 8u32 {
            if Bytesˉreadˉu32ˉlittle(Wir, Operationˉentry + 20u32) == Slot {
                let Firstˉoperand: u32 = Bytesˉreadˉu32ˉlittle(
                    Wir, Operationˉentry + 16u32
                );
                let Temporary: u32 = Bytesˉreadˉu32ˉlittle(
                    Wir, Operandsˉoffset + Firstˉoperand * 4u32
                );
                return Bytesˉreadˉu32ˉlittle(
                    Wir,
                    Temporariesˉoffset + (Firstˉtemporary + Temporary) * 4u32
                );
            }
        }
        Index = Index + 1u32;
    }
    return 0u32;
}

fn Compilerˉsourceˉwvbˉwirˉrequiresˉtypeˉentries(
    Wir: bytes,
    Bindings: Sourceˉbindings.Compilerˉsourceˉbindingˉsummary,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Orders: Compilerˉsourceˉwvbˉsymbolˉorders
) -> bool {
    let Functions: u32 = Bytesˉreadˉu32ˉlittle(Wir, 8u32);
    let Functionˉoffset: u32 =
        Sourceˉwir.Compilerˉsourceˉwirˉfunctionsˉoffset(Wir);
    let Operationˉoffset: u32 = Compilerˉsourceˉwvbˉoperationsˉoffset(Wir);
    let Temporaryˉoffset: u32 = Compilerˉsourceˉwvbˉtemporariesˉoffset(Wir);
    let Bindingˉpayload: u32 =
        Sourceˉbindings.Compilerˉsourceˉbindingsˉentriesˉoffset(
            Bindings.Directory
        );
    var Function: u32 = 0u32;
    while Function < Functions {
        let Entry: u32 = Functionˉoffset + Function * 48u32;
        let Parameters: u32 = Bytesˉreadˉu32ˉlittle(Wir, Entry + 36u32);
        let Locals: u32 = Bytesˉreadˉu32ˉlittle(Wir, Entry + 40u32);
        if Compilerˉsourceˉwvbˉshapeˉrequiresˉtypeˉentry(
            Bytesˉreadˉu32ˉlittle(Wir, Entry + 44u32), Symbols, Orders
        ) {
            return true;
        }
        let Bindingˉrange: u32 =
            Sourceˉbindings.Compilerˉsourceˉbindingsˉrangeˉoffset(
                Bindings.Directory, Function
            );
        let Firstˉbinding: u32 = Bytesˉreadˉu32ˉlittle(
            Bindings.Directory, Bindingˉrange
        );
        let Bindingˉcount: u32 = Bytesˉreadˉu32ˉlittle(
            Bindings.Directory, Bindingˉrange + 4u32
        );
        var Binding: u32 = 0u32;
        while Binding < Parameters + Locals {
            var Shape: u32 = 0u32;
            if Binding < Bindingˉcount {
                Shape = Bytesˉreadˉu32ˉlittle(
                    Bindings.Directory,
                    Bindingˉpayload + (Firstˉbinding + Binding) * 36u32 + 24u32
                );
            }
            if Shape == 0u32 && Binding >= Parameters {
                Shape = Compilerˉsourceˉwvbˉinferredˉlocalˉshape(
                    Wir, Function, Binding
                );
            }
            if Compilerˉsourceˉwvbˉshapeˉrequiresˉtypeˉentry(
                Shape, Symbols, Orders
            ) {
                return true;
            }
            Binding = Binding + 1u32;
        }
        let Firstˉtemporary: u32 = Bytesˉreadˉu32ˉlittle(
            Wir, Entry + 20u32
        );
        let Temporaries: u32 = Bytesˉreadˉu32ˉlittle(Wir, Entry + 24u32);
        var Temporary: u32 = 0u32;
        while Temporary < Temporaries {
            if Compilerˉsourceˉwvbˉshapeˉrequiresˉtypeˉentry(
                Bytesˉreadˉu32ˉlittle(
                    Wir, Temporaryˉoffset + (Firstˉtemporary + Temporary) * 4u32
                ),
                Symbols, Orders
            ) {
                return true;
            }
            Temporary = Temporary + 1u32;
        }
        let Firstˉoperation: u32 = Bytesˉreadˉu32ˉlittle(
            Wir, Entry + 12u32
        );
        let Operations: u32 = Bytesˉreadˉu32ˉlittle(Wir, Entry + 16u32);
        var Index: u32 = 0u32;
        while Index < Operations {
            let Operationˉentry: u32 = Operationˉoffset +
                (Firstˉoperation + Index) * 28u32;
            let Operation: u32 = Bytesˉreadˉu16ˉlittle(
                Wir, Operationˉentry + 4u32
            );
            if Compilerˉsourceˉwvbˉshapeˉrequiresˉtypeˉentry(
                Bytesˉreadˉu32ˉlittle(Wir, Operationˉentry + 8u32),
                Symbols, Orders
            ) {
                return true;
            }
            if Operation == 17u32 || Operation == 19u32 ||
                (Operation >= 65u32 && Operation <= 67u32) ||
                Operation == 164u32 {
                return true;
            }
            if (Operation == 165u32 || Operation == 166u32 ||
                    Operation == 167u32 || Operation == 168u32) &&
                Compilerˉsourceˉwvbˉshapeˉrequiresˉtypeˉentry(
                    Bytesˉreadˉu32ˉlittle(
                        Wir, Operationˉentry + 20u32
                    ),
                    Symbols, Orders
                ) {
                return true;
            }
            if (Operation == 169u32 || Operation == 170u32 ||
                    Operation == 192u32 || Operation == 193u32 || Operation == 194u32) &&
                Compilerˉsourceˉwvbˉshapeˉrequiresˉtypeˉentry(
                    Bytesˉreadˉu32ˉlittle(
                        Wir, Operationˉentry + 24u32
                    ),
                    Symbols, Orders
                ) {
                return true;
            }
            Index = Index + 1u32;
        }
        Function = Function + 1u32;
    }
    return false;
}

fn Compilerˉsourceˉwvbˉsourceˉfunctionˉisˉadmitted(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Bindings: Sourceˉbindings.Compilerˉsourceˉbindingˉsummary,
    Wir: bytes,
    Function: u32
) -> u32 {
    let Functionˉentry: u32 =
        Sourceˉwir.Compilerˉsourceˉwirˉfunctionsˉoffset(Wir) +
            Function * 48u32;
    let Parameters: u32 = Bytesˉreadˉu32ˉlittle(
        Wir, Functionˉentry + 36u32
    );
    let Locals: u32 = Bytesˉreadˉu32ˉlittle(Wir, Functionˉentry + 40u32);
    let Symbolˉentries: u32 = Bytesˉreadˉu32ˉlittle(
        Symbols.Directory, 8u32
    );
    var Hasˉsource: bool = false;
    var Index: u32 = 0u32;
    while Index < Parameters + Locals {
        if Sourceˉwir.Compilerˉsourceˉwirˉbindingˉshape(
                Bindings, Symbolˉentries, Function, Index
            ) == 805306369u32 {
            Hasˉsource = true;
        }
        Index = Index + 1u32;
    }
    if !Hasˉsource { return 0u32; }
    if Parameters != 1u32 ||
        Bytesˉreadˉu32ˉlittle(Wir, Functionˉentry + 44u32) != 1u32 ||
        Sourceˉwir.Compilerˉsourceˉwirˉbindingˉshape(
            Bindings, Symbolˉentries, Function, 0u32
        ) != 805306369u32 ||
        Sourceˉwir.Compilerˉsourceˉwirˉfunctionˉparameterˉborrowˉmode(
            Input, Scan, Symbols, Bindings, Function, 0u32
        ) != Sourceˉdeclarations.COMPILER_SOURCE_BORROW_MODE_VALUE {
        return 2u32;
    }
    let Name: bytes = Compilerˉsourceˉwvbˉfunctionˉname(
        Input, Scan, Symbols, Function
    );
    let Declaration: u32 = Compilerˉsourceˉwvbˉfunctionˉdeclaration(
        Symbols, Bindings.Directory, Function
    );
    if Bytesˉlength(Name) == 4u32 &&
        U32ˉfromˉu8(Bytesˉreadˉu8(Name, 0u32)) == 77u32 &&
        U32ˉfromˉu8(Bytesˉreadˉu8(Name, 1u32)) == 97u32 &&
        U32ˉfromˉu8(Bytesˉreadˉu8(Name, 2u32)) == 105u32 &&
        U32ˉfromˉu8(Bytesˉreadˉu8(Name, 3u32)) == 110u32 &&
        Function == Declaration &&
        Compilerˉsourceˉwvbˉsymbolˉmodule(Symbols, Declaration) == 0u32 &&
        Sourceˉsymbols.Compilerˉsourceˉsymbolsˉlookupˉisˉexported(
            Symbols.Lookup, Function
        ) {
        return 1u32;
    }
    return 2u32;
}

export fn Compilerˉsourceˉwvbˉencodeˉfunction(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Source: bytes,
    Header: Sourceˉdeclarations.Compilerˉsourceˉheader,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Bindings: Sourceˉbindings.Compilerˉsourceˉbindingˉsummary,
    Orders: Compilerˉsourceˉwvbˉsymbolˉorders,
    Plan: Compilerˉsourceˉwvbˉtextˉplan,
    Wir: bytes,
    Function: u32,
    Codeˉoffset: u32,
    Emitˉcode: bool,
    Foundationˉborrowˉmodule: bool
) -> Compilerˉsourceˉwvbˉfunctionˉencoding {
    let Borrowˉplans: Compilerˉsourceˉwvbˉfunctionˉborrowˉplans =
        Compilerˉsourceˉwvbˉbuildˉfunctionˉborrowˉplans(
            Input, Scan, Symbols, Bindings, Orders, Wir, Function, Foundationˉborrowˉmodule
        );
    let Vectorˉborrows: Compilerˉsourceˉwvbˉvectorˉborrowˉplan = Borrowˉplans.Vectors;
    let Foundationˉborrowˉplan: Foundationˉborrows.Borrowˉplan = Borrowˉplans.Foundation;
    let Foundationˉparameterˉborrows: bytes = Borrowˉplans.Parameters;
    let Borrowˉowners: Foundationˉborrows.Ownerˉplan = Borrowˉplans.Owners;
    let Analysis: Compilerˉsourceˉwvbˉanalysis =
        Compilerˉsourceˉwvbˉanalyzeˉfunction(
            Input, Scan, Bindings, Wir, Function, Symbols, Orders, Vectorˉborrows, Borrowˉowners
        );
    if Analysis.Status != Compilerˉsourceˉwvbˉstatus.Valid {
        return Compilerˉsourceˉwvbˉfunctionˉencoding(
            Analysis.Status, Compilerˉsourceˉwvbˉempty(Wir),
            Compilerˉsourceˉwvbˉempty(Wir), Analysis.Failureˉoperation,
            0u32, Analysis.Failureˉrule
        );
    }
    let Functionˉentry: u32 =
        Sourceˉwir.Compilerˉsourceˉwirˉfunctionsˉoffset(Wir) +
            Function * 48u32;
    let Firstˉblock: u32 = Bytesˉreadˉu32ˉlittle(Wir, Functionˉentry + 4u32);
    let Blockˉcount: u32 = Bytesˉreadˉu32ˉlittle(Wir, Functionˉentry + 8u32);
    let Firstˉoperation: u32 = Bytesˉreadˉu32ˉlittle(
        Wir, Functionˉentry + 12u32
    );
    let Operationˉcount: u32 = Bytesˉreadˉu32ˉlittle(
        Wir, Functionˉentry + 16u32
    );
    let Firstˉtemporary: u32 = Bytesˉreadˉu32ˉlittle(Wir, Functionˉentry + 20u32);
    let Temporaryˉcount: u32 = Bytesˉreadˉu32ˉlittle(Wir, Functionˉentry + 24u32);
    let Parameters: u32 = Bytesˉreadˉu32ˉlittle(Wir, Functionˉentry + 36u32);
    let Locals: u32 = Bytesˉreadˉu32ˉlittle(Wir, Functionˉentry + 40u32);
    let Returnˉshape: u32 = Bytesˉreadˉu32ˉlittle(Wir, Functionˉentry + 44u32);
    if Compilerˉsourceˉwvbˉshapeˉisˉbyteˉslice(Returnˉshape, Orders) {
        var Borrowed: u32 = 0u32;
        var Ownerˉshape: u32 = 0u32;
        var Parameter: u32 = 0u32;
        while Parameter < Parameters {
            let Mode: u32 = Sourceˉwir.Compilerˉsourceˉwirˉfunctionˉparameterˉborrowˉmode(Input, Scan, Symbols, Bindings, Function, Parameter);
            if Mode != Sourceˉdeclarations.COMPILER_SOURCE_BORROW_MODE_VALUE {
                Borrowed = Borrowed + 1u32;
                Ownerˉshape = Sourceˉwir.Compilerˉsourceˉwirˉbindingˉshape(Bindings, Bytesˉreadˉu32ˉlittle(Symbols.Directory, 8u32), Function, Parameter);
            }
            Parameter = Parameter + 1u32;
        }
        if Borrowed != 1u32 || (Ownerˉshape != 6u32 && !Compilerˉsourceˉwvbˉshapeˉisˉbyteˉslice(Ownerˉshape, Orders)) {
            return Compilerˉsourceˉwvbˉfunctionˉfailure(Wir, Compilerˉsourceˉwvbˉstatus.Unsupportedˉshape, Analysis.Failureˉoperation);
        }
    }
    let Functionˉname: bytes = Compilerˉsourceˉwvbˉfunctionˉname(
        Input, Scan, Symbols, Function
    );
    let Functionˉdeclaration: u32 =
        Compilerˉsourceˉwvbˉfunctionˉdeclaration(
            Symbols, Bindings.Directory, Function
        );
    let Isˉexportedˉroot: bool = Function == Functionˉdeclaration &&
        Compilerˉsourceˉwvbˉsymbolˉmodule(
            Symbols, Functionˉdeclaration
        ) == 0u32 &&
        Sourceˉsymbols.Compilerˉsourceˉsymbolsˉlookupˉisˉexported(
            Symbols.Lookup, Function
        );
    let Isˉlauncherˉbudgetˉmain: bool =
        Bytesˉlength(Functionˉname) == 4u32 &&
        U32ˉfromˉu8(Bytesˉreadˉu8(Functionˉname, 0u32)) == 77u32 &&
        U32ˉfromˉu8(Bytesˉreadˉu8(Functionˉname, 1u32)) == 97u32 &&
        U32ˉfromˉu8(Bytesˉreadˉu8(Functionˉname, 2u32)) == 105u32 &&
        U32ˉfromˉu8(Bytesˉreadˉu8(Functionˉname, 3u32)) == 110u32 &&
        Isˉexportedˉroot &&
        Parameters == 1u32 && Returnˉshape == 1u32;
    var Features: u32 = Compilerˉsourceˉwvbˉshapeˉfeatures(Returnˉshape);
    if Compilerˉsourceˉwvbˉshapeˉisˉownedˉaggregate(
        Input, Scan, Symbols, Bindings, Wir, Returnˉshape, Orders
    ) {
        Features = Features | 131072u32;
    }
    let Plannedˉreturnˉshape: u32 =
        Compilerˉsourceˉwvbˉplannedˉshapeˉvalue(
            Returnˉshape, Symbols, Orders
        );
    let Returnˉisˉfoundationˉvector: bool =
        Plannedˉreturnˉshape >= 327680u32 &&
        Plannedˉreturnˉshape < 393216u32;
    let Returnˉrequiresˉtake: bool = Returnˉshape == 805306368u32 ||
        Returnˉisˉfoundationˉvector ||
        Compilerˉsourceˉwvbˉshapeˉisˉaffineˉresult(Wir, Returnˉshape) ||
        Compilerˉsourceˉwvbˉshapeˉisˉtaskˉowner(
            Input, Scan, Symbols, Bindings, Returnˉshape
        ) ||
        Compilerˉsourceˉwvbˉshapeˉisˉownedˉaggregate(
            Input, Scan, Symbols, Bindings, Wir, Returnˉshape, Orders
        );
    if Returnˉisˉfoundationˉvector { Features = Features | 512u32; }
    if Compilerˉsourceˉwvbˉshapeˉownershipˉisˉunknown(Wir, Returnˉshape, Orders) ||
        (Returnˉshape != 805306368u32 &&
        !Compilerˉsourceˉwvbˉshapeˉisˉsupported(
        Returnˉshape, true, Symbols, Orders
    )) {
        return Compilerˉsourceˉwvbˉfunctionˉfailure(
            Wir, Compilerˉsourceˉwvbˉstatus.Unsupportedˉshape,
            Analysis.Failureˉoperation
        );
    }
    let Blocksˉoffset: u32 = Compilerˉsourceˉwvbˉblocksˉoffset(Wir);
    let Operationsˉoffset: u32 = Compilerˉsourceˉwvbˉoperationsˉoffset(Wir);
    let Temporariesˉoffset: u32 = Compilerˉsourceˉwvbˉtemporariesˉoffset(Wir);
    let Operandsˉoffset: u32 = Compilerˉsourceˉwvbˉoperandsˉoffset(Wir);
    if !Foundationˉborrowˉplan.Valid {
        return Compilerˉsourceˉwvbˉfunctionˉfailure(
            Wir, Compilerˉsourceˉwvbˉstatus.Unsupportedˉoperation,
            Analysis.Failureˉoperation
        );
    }
    if Foundationˉborrowˉplan.Hasˉborrow {
        Features = Features | WVB_FOUNDATION_VALUE_BORROW_FEATURE;
    }
    var Temporaryˉallocation: Temporaryˉslots.Compilerˉsourceˉwvbˉtemporaryˉslotˉallocation =
        Temporaryˉslots.Compilerˉsourceˉwvbˉidentityˉtemporaryˉslots(
            Wir, Temporariesˉoffset, Firstˉtemporary, Temporaryˉcount
        );
    let Budgetˉtemporaryˉmodes: bytes = Compilerˉsourceˉwvbˉbudgetˉtemporaryˉborrowˉmodes(
        Input, Scan, Symbols, Bindings, Wir, Firstˉoperation,
        Operationˉcount, Firstˉtemporary, Temporaryˉcount);
    var Hasˉbudgetˉtemporary: bool = false;
    var Preserveˉborrowedˉtemporaryˉidentity: bool =
        Foundationˉborrowˉplan.Hasˉborrow || Bytesˉlength(Vectorˉborrows.Sources) != 0u32;
    var Borrowˉscan: u32 = 0u32;
    while Borrowˉscan < Temporaryˉcount {
        let Borrowˉshape: u32 = Bytesˉreadˉu32ˉlittle(
            Wir,
            Compilerˉsourceˉwvbˉtemporariesˉoffset(Wir) +
                (Firstˉtemporary + Borrowˉscan) * 4u32
        );
        if Compilerˉsourceˉwvbˉtemporaryˉisˉborrowedˉownedˉaggregate(
                Input, Scan, Symbols, Bindings, Wir,
                Firstˉoperation, Operationˉcount, Firstˉtemporary,
                Borrowˉscan, Orders
            ) {
            Preserveˉborrowedˉtemporaryˉidentity = true;
        }
        if Borrowˉshape == 805306368u32 {
            Hasˉbudgetˉtemporary = true;
            if Bytesˉlength(Budgetˉtemporaryˉmodes) == Temporaryˉcount &&
                U32ˉfromˉu8(Bytesˉreadˉu8(Budgetˉtemporaryˉmodes, Borrowˉscan)) >= 2u32 {
                Preserveˉborrowedˉtemporaryˉidentity = true;
            }
        }
        Borrowˉscan = Borrowˉscan + 1u32;
    }
    if Hasˉbudgetˉtemporary && Bytesˉlength(Budgetˉtemporaryˉmodes) != Temporaryˉcount {
        return Compilerˉsourceˉwvbˉfunctionˉfailure(Wir,
            Compilerˉsourceˉwvbˉstatus.Unsupportedˉshape, Analysis.Failureˉoperation);
    }
    if Parameters + Locals + Temporaryˉcount > 4096u32 &&
        !Preserveˉborrowedˉtemporaryˉidentity {
        Temporaryˉallocation =
            Temporaryˉslots.Compilerˉsourceˉwvbˉallocateˉtemporaryˉslots(
                Wir,
                Blocksˉoffset,
                Operationsˉoffset,
                Temporariesˉoffset,
                Operandsˉoffset,
                Firstˉblock,
                Blockˉcount,
                Firstˉoperation,
                Operationˉcount,
                Firstˉtemporary,
                Temporaryˉcount
            );
    }
    if Temporaryˉallocation.Status !=
        Temporaryˉslots.Compilerˉsourceˉwvbˉtemporaryˉslotˉstatus.Valid {
        return Compilerˉsourceˉwvbˉfunctionˉfailure(
            Wir, Compilerˉsourceˉwvbˉstatus.Bytecodeˉlimit,
            Analysis.Failureˉoperation
        );
    }
    if Parameters + Locals + Temporaryˉallocation.Slots + Borrowˉowners.Count > 4096u32 {
        return Compilerˉsourceˉwvbˉfunctionˉfailure(
            Wir, Compilerˉsourceˉwvbˉstatus.Bytecodeˉlimit,
            Analysis.Failureˉoperation
        );
    }
    let Bindingˉrange: u32 =
        Sourceˉbindings.Compilerˉsourceˉbindingsˉrangeˉoffset(
            Bindings.Directory, Function
        );
    let Firstˉbinding: u32 = Bytesˉreadˉu32ˉlittle(
        Bindings.Directory, Bindingˉrange
    );
    let Bindingˉcount: u32 = Bytesˉreadˉu32ˉlittle(
        Bindings.Directory, Bindingˉrange + 4u32
    );
    let Bindingˉpayload: u32 =
        Sourceˉbindings.Compilerˉsourceˉbindingsˉentriesˉoffset(
            Bindings.Directory
        );
    var Metadata: bytes = Compilerˉsourceˉwvbˉencodedˉstring(Functionˉname);
    Metadata = Bytesˉconcat(Metadata, Bytesˉfromˉu32ˉlittle(Parameters));
    var Index: u32 = 0u32;
    while Index < Parameters {
        let Parameterˉshape: u32 = Bytesˉreadˉu32ˉlittle(
            Bindings.Directory,
            Bindingˉpayload + (Firstˉbinding + Index) * 36u32 + 24u32
        );
        let Parameterˉmode: u32 =
            Sourceˉwir.Compilerˉsourceˉwirˉfunctionˉparameterˉborrowˉmode(
                Input, Scan, Symbols, Bindings, Function, Index
            );
        let Isˉunsafeˉscratchˉparameter: bool =
            Compilerˉsourceˉwvbˉshapeˉisˉunsafeˉscratch(
                Input, Scan, Symbols, Bindings, Parameterˉshape
            );
        let Isˉallowedˉscratchˉborrow: bool =
            Isˉunsafeˉscratchˉparameter &&
            (Parameterˉmode ==
                Sourceˉdeclarations.COMPILER_SOURCE_BORROW_MODE_IMMUTABLE ||
             (Parameterˉmode ==
                    Sourceˉdeclarations.COMPILER_SOURCE_BORROW_MODE_MUTABLE &&
                Compilerˉsourceˉwvbˉfunctionˉhasˉwriteˉregionˉtarget(
                    Wir, Firstˉoperation, Operationˉcount, Index
                )));
        let Isˉunsafeˉwriteˉregionˉparameter: bool =
            Compilerˉsourceˉwvbˉshapeˉisˉunsafeˉwriteˉregion(
                Input, Scan, Symbols, Bindings, Parameterˉshape
            );
        let Isˉallowedˉwriteˉregionˉborrow: bool =
            Isˉunsafeˉwriteˉregionˉparameter && Parameterˉmode ==
                Sourceˉdeclarations.COMPILER_SOURCE_BORROW_MODE_IMMUTABLE &&
            Compilerˉsourceˉwvbˉfunctionˉhasˉwriteˉpointerˉtarget(
                Wir, Firstˉoperation, Operationˉcount, Index
            );
        let Isˉallowedˉbudgetˉparameter: bool =
            Parameterˉshape == 805306368u32 &&
            (Isˉlauncherˉbudgetˉmain || Foundationˉborrowˉmodule ||
             Parameterˉmode ==
                Sourceˉdeclarations.COMPILER_SOURCE_BORROW_MODE_VALUE ||
             Bytesˉreadˉu16ˉlittle(Wir, 6u32) >= 21u32) &&
            (Parameterˉmode ==
                Sourceˉdeclarations.COMPILER_SOURCE_BORROW_MODE_VALUE ||
             Parameterˉmode ==
                Sourceˉdeclarations.COMPILER_SOURCE_BORROW_MODE_IMMUTABLE ||
             Parameterˉmode ==
                Sourceˉdeclarations.COMPILER_SOURCE_BORROW_MODE_MUTABLE);
        if Compilerˉsourceˉwvbˉshapeˉownershipˉisˉunknown(Wir, Parameterˉshape, Orders) ||
            (!Isˉallowedˉbudgetˉparameter &&
            !Compilerˉsourceˉwvbˉshapeˉisˉsupported(
                Parameterˉshape, false, Symbols, Orders
            )) {
            return Compilerˉsourceˉwvbˉfunctionˉfailure(
                Wir, Compilerˉsourceˉwvbˉstatus.Unsupportedˉshape,
                Analysis.Failureˉoperation
            );
        }
        if Isˉunsafeˉwriteˉregionˉparameter &&
            !Isˉallowedˉwriteˉregionˉborrow {
            return Compilerˉsourceˉwvbˉfunctionˉfailure(
                Wir, Compilerˉsourceˉwvbˉstatus.Unsupportedˉshape,
                Analysis.Failureˉoperation
            );
        }
        Features = Features | Compilerˉsourceˉwvbˉshapeˉfeatures(Parameterˉshape);
        if Compilerˉsourceˉwvbˉshapeˉisˉownedˉaggregate(
            Input, Scan, Symbols, Bindings, Wir, Parameterˉshape, Orders
        ) {
            Features = Features | 131072u32;
            if Parameterˉmode !=
                    Sourceˉdeclarations.COMPILER_SOURCE_BORROW_MODE_VALUE &&
                !Isˉallowedˉscratchˉborrow &&
                !Isˉallowedˉwriteˉregionˉborrow &&
                Parameterˉshape != 805306370u32 &&
                Bytesˉreadˉu8(Foundationˉparameterˉborrows, Index) == 0u8 {
                return Compilerˉsourceˉwvbˉfunctionˉfailure(
                    Wir, Compilerˉsourceˉwvbˉstatus.Unsupportedˉshape,
                    Analysis.Failureˉoperation
                );
            }
        }
        var Plannedˉparameter: bytes =
            Compilerˉsourceˉwvbˉplannedˉshape(
                Parameterˉshape, Symbols, Orders
            );
        if Parameterˉshape == 805306368u32 && Parameterˉmode ==
                Sourceˉdeclarations.COMPILER_SOURCE_BORROW_MODE_IMMUTABLE {
            Plannedˉparameter = Bytesˉfromˉu8(36u8);
            Features = Features | WVB_BORROWED_BUDGET_FEATURE;
        }
        if Parameterˉshape == 805306368u32 && Parameterˉmode ==
                Sourceˉdeclarations.COMPILER_SOURCE_BORROW_MODE_MUTABLE {
            Plannedˉparameter = Bytesˉconcat(Bytesˉfromˉu8(41u8), Bytesˉfromˉu8(25u8));
        }
        if Isˉallowedˉscratchˉborrow {
            Plannedˉparameter =
                Compilerˉsourceˉwvbˉborrowedˉaggregateˉshape(
                    Plannedˉparameter
                );
        }
        if Isˉallowedˉwriteˉregionˉborrow {
            Plannedˉparameter =
                Compilerˉsourceˉwvbˉborrowedˉaggregateˉshape(
                    Plannedˉparameter
                );
        }
        if Compilerˉsourceˉwvbˉshapeˉisˉownedˉvector(
            Parameterˉshape, Orders
        ) {
            Features = Features | 32768u32;
            if Parameterˉmode >
                    Sourceˉdeclarations.COMPILER_SOURCE_BORROW_MODE_MUTABLE {
                return Compilerˉsourceˉwvbˉfunctionˉfailure(
                    Wir, Compilerˉsourceˉwvbˉstatus.Invalidˉdata,
                    Analysis.Failureˉoperation
                );
            }
            if Parameterˉmode !=
                    Sourceˉdeclarations.COMPILER_SOURCE_BORROW_MODE_VALUE {
                var Borrowedˉkind: u8 = 26u8;
                if Parameterˉmode ==
                        Sourceˉdeclarations.COMPILER_SOURCE_BORROW_MODE_MUTABLE {
                    Borrowedˉkind = 27u8;
                }
                Plannedˉparameter = Bytesˉconcat(
                    Bytesˉfromˉu8(Borrowedˉkind),
                    Bytesˉslice(
                        Plannedˉparameter, 1u32,
                        Bytesˉlength(Plannedˉparameter) - 1u32
                    )
                );
            }
        }
        if Parameterˉshape == 805306370u32 {
            if Parameterˉmode > Sourceˉdeclarations.COMPILER_SOURCE_BORROW_MODE_MUTABLE {
                return Compilerˉsourceˉwvbˉfunctionˉfailure(Wir, Compilerˉsourceˉwvbˉstatus.Unsupportedˉshape, Analysis.Failureˉoperation);
            }
            if Parameterˉmode == Sourceˉdeclarations.COMPILER_SOURCE_BORROW_MODE_IMMUTABLE {
                Plannedˉparameter = Bytesˉconcat(Bytesˉfromˉu8(37u8), Bytesˉfromˉu8(39u8));
            }
            if Parameterˉmode == Sourceˉdeclarations.COMPILER_SOURCE_BORROW_MODE_MUTABLE {
                Plannedˉparameter = Bytesˉconcat(Bytesˉfromˉu8(41u8), Bytesˉfromˉu8(39u8));
            }
        }
        if Bytesˉreadˉu8(Foundationˉparameterˉborrows, Index) != 0u8 &&
            !Compilerˉsourceˉwvbˉshapeˉisˉbyteˉslice(Parameterˉshape, Orders) {
            Plannedˉparameter =
                Compilerˉsourceˉwvbˉfoundationˉborrowedˉpayloadˉshape(
                    Plannedˉparameter
                );
        }
        Metadata = Bytesˉconcat(
            Metadata, Plannedˉparameter
        );
        Index = Index + 1u32;
    }
    Metadata = Bytesˉconcat(
        Metadata, Compilerˉsourceˉwvbˉplannedˉshape(
            Returnˉshape, Symbols, Orders
        )
    );
    Metadata = Bytesˉconcat(
        Metadata,
        Bytesˉfromˉu32ˉlittle(Locals + Temporaryˉallocation.Slots + Borrowˉowners.Count)
    );
    Index = 0u32;
    while Index < Locals {
        var Localˉshape: u32 = 0u32;
        if Parameters + Index < Bindingˉcount {
            Localˉshape = Bytesˉreadˉu32ˉlittle(
                Bindings.Directory,
                Bindingˉpayload + (Firstˉbinding + Parameters + Index) * 36u32 + 24u32
            );
        }
        if Localˉshape == 0u32 {
            Localˉshape = Compilerˉsourceˉwvbˉinferredˉlocalˉshape(
                Wir, Function, Parameters + Index
            );
        }
        if Compilerˉsourceˉwvbˉshapeˉownershipˉisˉunknown(Wir, Localˉshape, Orders) ||
            (!Compilerˉsourceˉwvbˉshapeˉrequiresˉtake(
                Wir, Localˉshape, Orders
            ) && !Compilerˉsourceˉwvbˉshapeˉisˉsupported(
                Localˉshape, false, Symbols, Orders
            )) {
            return Compilerˉsourceˉwvbˉfunctionˉfailure(
                Wir, Compilerˉsourceˉwvbˉstatus.Unsupportedˉshape,
                Analysis.Failureˉoperation
            );
        }
        Features = Features | Compilerˉsourceˉwvbˉshapeˉfeatures(Localˉshape);
        if Compilerˉsourceˉwvbˉshapeˉisˉownedˉaggregate(
            Input, Scan, Symbols, Bindings, Wir, Localˉshape, Orders
        ) {
            Features = Features | 131072u32;
        }
        var Plannedˉlocal: bytes = Compilerˉsourceˉwvbˉplannedˉshape(
            Localˉshape, Symbols, Orders
        );
        if Foundationˉborrowˉplan.Hasˉborrow && Bytesˉreadˉu8(
                Foundationˉborrowˉplan.Slotˉstate,
                Parameters + Index
            ) == 1u8 && !Compilerˉsourceˉwvbˉshapeˉisˉbyteˉslice(Localˉshape, Orders) {
            if Bytesˉreadˉu8(Plannedˉlocal, 0u32) == 23u8 {
                Features = Features | WVB_VECTOR_PAYLOAD_BORROW_FEATURE;
            }
            Plannedˉlocal =
                Compilerˉsourceˉwvbˉfoundationˉborrowedˉpayloadˉshape(
                    Plannedˉlocal
                );
        }
        Metadata = Bytesˉconcat(Metadata, Plannedˉlocal);
        Index = Index + 1u32;
    }
    Index = 0u32;
    while Index < Temporaryˉallocation.Slots {
        let Temporaryˉshape: u32 = Bytesˉreadˉu32ˉlittle(
            Temporaryˉallocation.Shapes, Index * 4u32
        );
        if Compilerˉsourceˉwvbˉshapeˉownershipˉisˉunknown(Wir, Temporaryˉshape, Orders) ||
            (!Compilerˉsourceˉwvbˉshapeˉrequiresˉtake(
                Wir, Temporaryˉshape, Orders
            ) && !Compilerˉsourceˉwvbˉshapeˉisˉsupported(
                Temporaryˉshape, false, Symbols, Orders
            )) {
            return Compilerˉsourceˉwvbˉfunctionˉfailure(
                Wir, Compilerˉsourceˉwvbˉstatus.Unsupportedˉshape,
                Analysis.Failureˉoperation
            );
        }
        Features = Features | Compilerˉsourceˉwvbˉshapeˉfeatures(Temporaryˉshape);
        if Compilerˉsourceˉwvbˉshapeˉisˉownedˉaggregate(
            Input, Scan, Symbols, Bindings, Wir, Temporaryˉshape, Orders
        ) {
            Features = Features | 131072u32;
        }
        var Plannedˉtemporary: bytes = Compilerˉsourceˉwvbˉplannedˉshape(
            Temporaryˉshape, Symbols, Orders
        );
        var Foundationˉborrowˉstate: u32 = 0u32;
        if Foundationˉborrowˉplan.Hasˉborrow {
            Foundationˉborrowˉstate = U32ˉfromˉu8(
                Bytesˉreadˉu8(Foundationˉborrowˉplan.Temporaryˉstate, Index)
            );
        }
        if Foundationˉborrowˉstate == 1u32 {
            Plannedˉtemporary =
                Compilerˉsourceˉwvbˉfoundationˉborrowedˉoptionˉshape(
                    Temporaryˉshape, Symbols, Orders
                );
        }
        if Foundationˉborrowˉstate >= 2u32 && !Compilerˉsourceˉwvbˉshapeˉisˉbyteˉslice(Temporaryˉshape, Orders) {
            if Bytesˉreadˉu8(Plannedˉtemporary, 0u32) == 23u8 {
                Features = Features | WVB_VECTOR_PAYLOAD_BORROW_FEATURE;
            }
            Plannedˉtemporary =
                Compilerˉsourceˉwvbˉfoundationˉborrowedˉpayloadˉshape(
                    Plannedˉtemporary
                );
        }
        var Budgetˉtemporaryˉmode: u32 = 0u32;
        if Temporaryˉshape == 805306368u32 {
            Budgetˉtemporaryˉmode = U32ˉfromˉu8(Bytesˉreadˉu8(Budgetˉtemporaryˉmodes, Index));
        }
        if Budgetˉtemporaryˉmode == 2u32 {
            Plannedˉtemporary = Bytesˉfromˉu8(36u8);
            Features = Features | WVB_BORROWED_BUDGET_FEATURE;
        }
        if Budgetˉtemporaryˉmode == 3u32 {
            Plannedˉtemporary = Bytesˉconcat(Bytesˉfromˉu8(41u8), Bytesˉfromˉu8(25u8));
        }
        if Preserveˉborrowedˉtemporaryˉidentity &&
            Compilerˉsourceˉwvbˉtemporaryˉisˉborrowedˉownedˉaggregate(
                Input, Scan, Symbols, Bindings, Wir,
                Firstˉoperation, Operationˉcount, Firstˉtemporary,
                Index, Orders
            ) {
            Plannedˉtemporary =
                Compilerˉsourceˉwvbˉborrowedˉaggregateˉshape(
                    Plannedˉtemporary
                );
        }
        if Compilerˉsourceˉwvbˉvectorˉborrowˉsource(Vectorˉborrows.Sources, Index) != 0u32 {
            // This WVIR temporary aliases a source slot and has no WVB value.
            // Its unused identity slot must not be classified as another owner.
            Plannedˉtemporary = Bytesˉfromˉu8(20u8);
        }
        Metadata = Bytesˉconcat(Metadata, Plannedˉtemporary);
        Index = Index + 1u32;
    }
    Index = 0u32;
    while Index < Borrowˉowners.Count {
        let Ownerˉtemporary: u32 = Bytesˉreadˉu32ˉlittle(Borrowˉowners.Temporaries, Index * 4u32);
        let Materializedˉownerˉshape: u32 = Bytesˉreadˉu32ˉlittle(Wir,
            Temporariesˉoffset + (Firstˉtemporary + Ownerˉtemporary) * 4u32);
        Metadata = Bytesˉconcat(Metadata, Compilerˉsourceˉwvbˉplannedˉshape(Materializedˉownerˉshape, Symbols, Orders));
        Index = Index + 1u32;
    }
    Metadata = Bytesˉconcat(Metadata, Bytesˉfromˉu32ˉlittle(Codeˉoffset));
    Metadata = Bytesˉconcat(
        Metadata, Bytesˉfromˉu32ˉlittle(Analysis.Codeˉlength)
    );
    Metadata = Bytesˉconcat(
        Metadata, Bytesˉfromˉu32ˉlittle(Analysis.Maximumˉstack)
    );

    var Code: bytes = Compilerˉsourceˉwvbˉempty(Wir);
    var Block: u32 = 0u32;
    if Emitˉcode {
        while Block < Bytesˉlength(Analysis.Blockˉorder) / 4u32 {
            let Originalˉblock: u32 = Bytesˉreadˉu32ˉlittle(Analysis.Blockˉorder, Block * 4u32);
            let Blockˉentry: u32 = Blocksˉoffset + (Firstˉblock + Originalˉblock) * 28u32;
            let Blockˉfirstˉoperation: u32 = Bytesˉreadˉu32ˉlittle(
                Wir, Blockˉentry + 4u32
            );
            let Blockˉoperationˉcount: u32 = Bytesˉreadˉu32ˉlittle(
                Wir, Blockˉentry + 8u32
            );
            var Inˉblock: u32 = 0u32;
            while Inˉblock < Blockˉoperationˉcount {
                let Operationˉentry: u32 = Operationsˉoffset +
                    (Blockˉfirstˉoperation + Inˉblock) * 28u32;
                let Operationˉkind: u32 = Bytesˉreadˉu16ˉlittle(
                    Wir, Operationˉentry + 4u32
                );
                if Operationˉkind >= 129u32 && Operationˉkind <= 147u32 {
                    Features = Features | 2u32;
                }
                if Operationˉkind >= 148u32 && Operationˉkind <= 150u32 {
                    Features = Features | 4u32;
                }
                if Operationˉkind >= 151u32 && Operationˉkind <= 162u32 {
                    Features = Features | 8u32;
                }
                if Operationˉkind == 163u32 { Features = Features | 16u32; }
                if Operationˉkind == 164u32 { Features = Features | 32u32; }
                if Operationˉkind == 165u32 || Operationˉkind == 166u32 {
                    Features = Features | 64u32;
                }
                if Operationˉkind == 167u32 || Operationˉkind == 168u32 {
                    Features = Features | 256u32;
                }
                if Operationˉkind == 169u32 || Operationˉkind == 170u32 {
                    Features = Features | 256u32;
                    Features = Features | 512u32;
                    if Operationˉkind == 169u32 &&
                        Bytesˉreadˉu32ˉlittle(Wir, Operationˉentry + 20u32) < Parameters {
                        Features = Features | WVB_VECTOR_PARAMETER_READ_FEATURE;
                    }
                }
                if Operationˉkind == 171u32 {
                    Features = Features | 4096u32;
                }
                if Operationˉkind == 172u32 {
                    Features = Features | 8192u32;
                }
                if Operationˉkind == 173u32 || Operationˉkind == 194u32 {
                    Features = Features | 16384u32;
                }
                if Operationˉkind == 175u32 {
                    Features = Features | 65536u32;
                }
                if Operationˉkind >= 177u32 &&
                    Operationˉkind <= 179u32 {
                    Features = Features | 524288u32;
                    if Operationˉkind == 179u32 {
                        Features = Features | 1048576u32;
                    }
                }
                if Operationˉkind >= 180u32 &&
                    Operationˉkind <= 185u32 {
                    Features = Features | WVB_TASK_FEATURE;
                }
                if Operationˉkind == 186u32 {
                    Features = Features | WVB_UNSAFE_SCRATCH_FEATURE;
                }
                if Operationˉkind == 187u32 {
                    Features = Features | WVB_UNSAFE_SCRATCH_LENGTH_FEATURE;
                }
                if Operationˉkind == 188u32 {
                    Features = Features | WVB_UNSAFE_WRITE_REGION_FEATURE;
                }
                if Operationˉkind == 189u32 {
                    Features = Features | WVB_UNSAFE_WRITE_POINTER_FEATURE;
                }
                if Operationˉkind == 190u32 {
                    Features = Features | WVB_FOREIGN_CALL_FEATURE;
                }
                if Operationˉkind == 191u32 {
                    Features = Features | WVB_FOUNDATION_VALUE_BORROW_FEATURE;
                }
                if Operationˉkind == 192u32 {
                    Features = Features | WVB_VECTOR_INDEXED_BORROW_FEATURE;
                }
                if Operationˉkind == 8u32 {
                    let Storeˉfirstˉoperand: u32 = Bytesˉreadˉu32ˉlittle(
                        Wir, Operationˉentry + 16u32
                    );
                    let Storeˉoperandˉtemporary: u32 =
                        Bytesˉreadˉu32ˉlittle(
                            Wir,
                            Operandsˉoffset + Storeˉfirstˉoperand * 4u32
                        );
                    let Storeˉoperandˉshape: u32 =
                        Bytesˉreadˉu32ˉlittle(
                            Wir,
                            Temporariesˉoffset +
                                (Firstˉtemporary +
                                    Storeˉoperandˉtemporary) * 4u32
                        );
                    let Plannedˉstoreˉoperandˉshape: u32 =
                        Compilerˉsourceˉwvbˉplannedˉshapeˉvalue(
                            Storeˉoperandˉshape, Symbols, Orders
                        );
                    if Plannedˉstoreˉoperandˉshape >= 327680u32 &&
                        Plannedˉstoreˉoperandˉshape < 393216u32 {
                        Features = Features | 512u32;
                    }
                }
                Code = Bytesˉconcat(
                    Code,
                    Compilerˉsourceˉwvbˉemitˉoperation(
                        Input, Scan, Source, Symbols, Bindings, Orders,
                        Plan, Wir,
                        Operationˉentry,
                        Operationsˉoffset +
                            (Firstˉoperation + Operationˉcount) * 28u32,
                        Parameters, Locals,
                        Firstˉtemporary,
                        Temporaryˉallocation.Mapping,
                        Foundationˉborrowˉplan,
                        Borrowˉowners,
                        Parameters + Locals + Temporaryˉallocation.Slots,
                        Vectorˉborrows.Sources
                    )
                );
                Inˉblock = Inˉblock + 1u32;
            }
            Code = Bytesˉconcat(
                Code,
                Compilerˉsourceˉwvbˉemitˉterminator(
                    Wir, Firstˉblock, Blockˉentry,
                    Analysis.Blockˉoffsets, Parameters, Locals,
                    Returnˉrequiresˉtake,
                    Temporaryˉallocation.Mapping, Firstˉtemporary, Orders
                )
            );
            Block = Block + 1u32;
        }
    }
    if Emitˉcode && Bytesˉlength(Code) != Analysis.Codeˉlength {
        return Compilerˉsourceˉwvbˉfunctionˉfailure(
            Wir, Compilerˉsourceˉwvbˉstatus.Bytecodeˉlimit,
            Analysis.Failureˉoperation
        );
    }
    return Compilerˉsourceˉwvbˉfunctionˉencoding(
        Compilerˉsourceˉwvbˉstatus.Valid,
        Metadata,
        Code,
        Analysis.Failureˉoperation,
        Features,
        ""
    );
}

fn Compilerˉsourceˉwvbˉreachabilityˉwithˉevidenceˉmode(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Bindings: Sourceˉbindings.Compilerˉsourceˉbindingˉsummary,
    Wirˉsummary: Sourceˉwir.Compilerˉsourceˉwirˉsummary,
    Orders: Compilerˉsourceˉwvbˉsymbolˉorders,
    Analyze: bool
) -> Compilerˉsourceˉwvbˉreachability {
    let Functionˉorder: Compilerˉsourceˉwvbˉsymbolˉorder =
        Compilerˉsourceˉwvbˉfunctionˉorder(Orders);
    let Symbolˉentries: u32 = Bytesˉreadˉu32ˉlittle(
        Symbols.Directory, 8u32
    );
    let Functionˉentries: u32 = Bytesˉreadˉu32ˉlittle(
        Wirˉsummary.Directory, 8u32
    );
    let Concreteˉfunctions: u32 = Bytesˉlength(Functionˉorder.Entries) / 4u32;
    let Emptyˉmap: Byteˉconstruction.Foundationˉbytesˉresult =
        Byteˉconstruction.Foundationˉbytesˉrepeat(0u8, Functionˉentries);
    if !Emptyˉmap.Valid {
        return Compilerˉsourceˉwvbˉreachabilityˉfailure(
            Input,
            Compilerˉsourceˉwvbˉstatus.Bytecodeˉlimit,
            Wirˉsummary.Status,
            0u32,
            0u32
        );
    }

    var Map: bytes = Emptyˉmap.Value;
    var Queue: bytes = Compilerˉsourceˉwvbˉempty(Input);
    var Roots: u32 = 0u32;
    var Reachable: u32 = 0u32;
    var Functionˉrank: u32 = 0u32;
    while Functionˉrank < Concreteˉfunctions {
        let Rootˉfunction: u32 = Compilerˉsourceˉwvbˉorderedˉsymbol(
            Functionˉorder, Functionˉrank
        );
        if Rootˉfunction < Symbolˉentries &&
            Compilerˉsourceˉwvbˉsymbolˉmodule(Symbols, Rootˉfunction) == 0u32 {
            if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉlookupˉisˉexported(
                Symbols.Lookup, Rootˉfunction
            ) {
                let Rootˉmarked: Byteˉconstruction.Foundationˉbytesˉresult =
                    Byteˉconstruction.Foundationˉbytesˉreplace(
                        Map, Rootˉfunction, 1u32, Bytesˉfromˉu8(1u8)
                    );
                if !Rootˉmarked.Valid {
                    return Compilerˉsourceˉwvbˉreachabilityˉfailure(
                        Input,
                        Compilerˉsourceˉwvbˉstatus.Invalidˉdata,
                        Wirˉsummary.Status,
                        Functionˉrank,
                        0u32
                    );
                }
                Map = Rootˉmarked.Value;
                Queue = Bytesˉconcat(
                    Queue, Bytesˉfromˉu32ˉlittle(Rootˉfunction)
                );
                Roots = Roots + 1u32;
                Reachable = Reachable + 1u32;
            }
        }
        Functionˉrank = Functionˉrank + 1u32;
    }

    let Wir: bytes = Wirˉsummary.Directory;
    let Blocksˉoffset: u32 = Compilerˉsourceˉwvbˉblocksˉoffset(Wir);
    let Operationsˉoffset: u32 = Compilerˉsourceˉwvbˉoperationsˉoffset(Wir);
    var Foundationˉborrowˉmodule: bool = false;
    if Analyze {
        Foundationˉborrowˉmodule = Compilerˉsourceˉwvbˉmoduleˉhasˉfoundationˉborrow(Wir, Orders);
    }
    var Reachableˉcodeˉbytes: u32 = 0u32;
    var Reachableˉcalls: u32 = 0u32;
    var Queueˉindex: u32 = 0u32;
    while Queueˉindex < Reachable {
        let Reachableˉfunction: u32 = Bytesˉreadˉu32ˉlittle(
            Queue, Queueˉindex * 4u32
        );
        if Analyze {
            let Reachableˉborrows: Compilerˉsourceˉwvbˉfunctionˉborrowˉplans =
                Compilerˉsourceˉwvbˉbuildˉfunctionˉborrowˉplans(
                    Input, Scan, Symbols, Bindings, Orders, Wir, Reachableˉfunction,
                    Foundationˉborrowˉmodule
                );
            let Reachableˉanalysis: Compilerˉsourceˉwvbˉanalysis =
                Compilerˉsourceˉwvbˉanalyzeˉfunction(
                    Input, Scan, Bindings, Wir, Reachableˉfunction, Symbols, Orders, Reachableˉborrows.Vectors,
                    Reachableˉborrows.Owners
                );
            if Reachableˉanalysis.Status != Compilerˉsourceˉwvbˉstatus.Valid {
                return Compilerˉsourceˉwvbˉreachabilityˉfailure(
                    Input,
                    Reachableˉanalysis.Status,
                    Wirˉsummary.Status,
                    Compilerˉsourceˉwvbˉorderedˉrank(
                        Functionˉorder, Reachableˉfunction
                    ),
                    Reachableˉanalysis.Failureˉoperation
                );
            }
            if Reachableˉcodeˉbytes >
                16777216u32 - Reachableˉanalysis.Codeˉlength {
                return Compilerˉsourceˉwvbˉreachabilityˉfailure(
                    Input,
                    Compilerˉsourceˉwvbˉstatus.Bytecodeˉlimit,
                    Wirˉsummary.Status,
                    Compilerˉsourceˉwvbˉorderedˉrank(
                        Functionˉorder, Reachableˉfunction
                    ),
                    Reachableˉanalysis.Failureˉoperation
                );
            }
            Reachableˉcodeˉbytes =
                Reachableˉcodeˉbytes + Reachableˉanalysis.Codeˉlength;
        }

        let Reachableˉfunctionˉentry: u32 =
            Sourceˉwir.Compilerˉsourceˉwirˉfunctionsˉoffset(Wir) +
                Reachableˉfunction * 48u32;
        let Reachableˉfirstˉblock: u32 = Bytesˉreadˉu32ˉlittle(
            Wir, Reachableˉfunctionˉentry + 4u32
        );
        let Reachableˉblockˉcount: u32 = Bytesˉreadˉu32ˉlittle(
            Wir, Reachableˉfunctionˉentry + 8u32
        );
        var Reachableˉblock: u32 = 0u32;
        while Reachableˉblock < Reachableˉblockˉcount {
            let Reachableˉblockˉentry: u32 = Blocksˉoffset +
                (Reachableˉfirstˉblock + Reachableˉblock) * 28u32;
            let Reachableˉfirstˉoperation: u32 = Bytesˉreadˉu32ˉlittle(
                Wir, Reachableˉblockˉentry + 4u32
            );
            let Reachableˉoperationˉcount: u32 = Bytesˉreadˉu32ˉlittle(
                Wir, Reachableˉblockˉentry + 8u32
            );
            var Reachableˉinˉblock: u32 = 0u32;
            while Reachableˉinˉblock < Reachableˉoperationˉcount {
                let Reachableˉoperationˉentry: u32 = Operationsˉoffset +
                    (Reachableˉfirstˉoperation + Reachableˉinˉblock) * 28u32;
                let Reachableˉoperation: u32 =
                    Bytesˉreadˉu16ˉlittle(
                        Wir, Reachableˉoperationˉentry + 4u32
                    );
                if Reachableˉoperation == 62u32 ||
                    Reachableˉoperation == 178u32 ||
                    Reachableˉoperation == 182u32 {
                    Reachableˉcalls = Reachableˉcalls + 1u32;
                }
                if Reachableˉoperation == 62u32 ||
                    Reachableˉoperation == 177u32 ||
                    Reachableˉoperation == 179u32 {
                    let Reachableˉtarget: u32 = Bytesˉreadˉu32ˉlittle(
                        Wir, Reachableˉoperationˉentry + 20u32
                    );
                    if Bytesˉreadˉu8(Map, Reachableˉtarget) == 0u8 {
                        let Reachableˉmarked: Byteˉconstruction.Foundationˉbytesˉresult =
                            Byteˉconstruction.Foundationˉbytesˉreplace(
                                Map, Reachableˉtarget,
                                1u32, Bytesˉfromˉu8(1u8)
                            );
                        if !Reachableˉmarked.Valid {
                            return Compilerˉsourceˉwvbˉreachabilityˉfailure(
                                Input,
                                Compilerˉsourceˉwvbˉstatus.Invalidˉdata,
                                Wirˉsummary.Status,
                                Compilerˉsourceˉwvbˉorderedˉrank(
                                    Functionˉorder, Reachableˉfunction
                                ),
                                Reachableˉfirstˉoperation + Reachableˉinˉblock
                            );
                        }
                        Map = Reachableˉmarked.Value;
                        Queue = Bytesˉconcat(
                            Queue, Bytesˉfromˉu32ˉlittle(Reachableˉtarget)
                        );
                        Reachable = Reachable + 1u32;
                    }
                }
                Reachableˉinˉblock = Reachableˉinˉblock + 1u32;
            }
            Reachableˉblock = Reachableˉblock + 1u32;
        }
        Queueˉindex = Queueˉindex + 1u32;
    }

    var Unreachableˉcodeˉbytes: u32 = 0u32;
    var Unreachableˉcalls: u32 = 0u32;
    Functionˉrank = 0u32;
    while Functionˉrank < Concreteˉfunctions {
        let Unreachableˉfunction: u32 = Compilerˉsourceˉwvbˉorderedˉsymbol(
            Functionˉorder, Functionˉrank
        );
        if Analyze && Bytesˉreadˉu8(Map, Unreachableˉfunction) == 0u8 {
            let Unreachableˉborrows: Compilerˉsourceˉwvbˉfunctionˉborrowˉplans =
                Compilerˉsourceˉwvbˉbuildˉfunctionˉborrowˉplans(
                    Input, Scan, Symbols, Bindings, Orders, Wir, Unreachableˉfunction,
                    Foundationˉborrowˉmodule
                );
            let Unreachableˉanalysis: Compilerˉsourceˉwvbˉanalysis =
                Compilerˉsourceˉwvbˉanalyzeˉfunction(
                    Input, Scan, Bindings, Wir, Unreachableˉfunction, Symbols, Orders, Unreachableˉborrows.Vectors,
                    Unreachableˉborrows.Owners
                );
            if Unreachableˉanalysis.Status !=
                Compilerˉsourceˉwvbˉstatus.Valid {
                return Compilerˉsourceˉwvbˉreachabilityˉfailure(
                    Input,
                    Unreachableˉanalysis.Status,
                    Wirˉsummary.Status,
                    Functionˉrank,
                    Unreachableˉanalysis.Failureˉoperation
                );
            }
            if Unreachableˉcodeˉbytes >
                16777216u32 - Unreachableˉanalysis.Codeˉlength {
                return Compilerˉsourceˉwvbˉreachabilityˉfailure(
                    Input,
                    Compilerˉsourceˉwvbˉstatus.Bytecodeˉlimit,
                    Wirˉsummary.Status,
                    Functionˉrank,
                    Unreachableˉanalysis.Failureˉoperation
                );
            }
            Unreachableˉcodeˉbytes =
                Unreachableˉcodeˉbytes + Unreachableˉanalysis.Codeˉlength;

            let Unreachableˉfunctionˉentry: u32 =
                Sourceˉwir.Compilerˉsourceˉwirˉfunctionsˉoffset(Wir) +
                    Unreachableˉfunction * 48u32;
            let Unreachableˉfirstˉblock: u32 = Bytesˉreadˉu32ˉlittle(
                Wir, Unreachableˉfunctionˉentry + 4u32
            );
            let Unreachableˉblockˉcount: u32 = Bytesˉreadˉu32ˉlittle(
                Wir, Unreachableˉfunctionˉentry + 8u32
            );
            var Unreachableˉblock: u32 = 0u32;
            while Unreachableˉblock < Unreachableˉblockˉcount {
                let Unreachableˉblockˉentry: u32 = Blocksˉoffset +
                    (Unreachableˉfirstˉblock + Unreachableˉblock) * 28u32;
                let Unreachableˉfirstˉoperation: u32 =
                    Bytesˉreadˉu32ˉlittle(
                        Wir, Unreachableˉblockˉentry + 4u32
                    );
                let Unreachableˉoperationˉcount: u32 =
                    Bytesˉreadˉu32ˉlittle(
                        Wir, Unreachableˉblockˉentry + 8u32
                    );
                var Unreachableˉinˉblock: u32 = 0u32;
                while Unreachableˉinˉblock < Unreachableˉoperationˉcount {
                    let Unreachableˉoperationˉentry: u32 = Operationsˉoffset +
                        (Unreachableˉfirstˉoperation + Unreachableˉinˉblock) *
                        28u32;
                    let Unreachableˉoperation: u32 =
                        Bytesˉreadˉu16ˉlittle(
                            Wir, Unreachableˉoperationˉentry + 4u32
                        );
                    if Unreachableˉoperation == 62u32 ||
                        Unreachableˉoperation == 178u32 ||
                        Unreachableˉoperation == 182u32 {
                        Unreachableˉcalls = Unreachableˉcalls + 1u32;
                    }
                    Unreachableˉinˉblock = Unreachableˉinˉblock + 1u32;
                }
                Unreachableˉblock = Unreachableˉblock + 1u32;
            }
        }
        Functionˉrank = Functionˉrank + 1u32;
    }

    if Analyze &&
        Reachableˉcodeˉbytes > 16777216u32 - Unreachableˉcodeˉbytes {
        return Compilerˉsourceˉwvbˉreachabilityˉfailure(
            Input,
            Compilerˉsourceˉwvbˉstatus.Bytecodeˉlimit,
            Wirˉsummary.Status,
            Concreteˉfunctions,
            Wirˉsummary.Operations
        );
    }
    return Compilerˉsourceˉwvbˉreachability(
        Compilerˉsourceˉwvbˉstatus.Valid,
        Wirˉsummary.Status,
        Concreteˉfunctions,
        Roots,
        Reachable,
        Concreteˉfunctions - Reachable,
        Reachableˉcalls + Unreachableˉcalls,
        Reachableˉcalls,
        Reachableˉcodeˉbytes + Unreachableˉcodeˉbytes,
        Reachableˉcodeˉbytes,
        Unreachableˉcodeˉbytes,
        Map,
        Concreteˉfunctions,
        Wirˉsummary.Operations
    );
}

export fn Compilerˉsourceˉwvbˉreachabilityˉwithˉevidence(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Bindings: Sourceˉbindings.Compilerˉsourceˉbindingˉsummary,
    Wirˉsummary: Sourceˉwir.Compilerˉsourceˉwirˉsummary,
    Orders: Compilerˉsourceˉwvbˉsymbolˉorders
) -> Compilerˉsourceˉwvbˉreachability {
    return Compilerˉsourceˉwvbˉreachabilityˉwithˉevidenceˉmode(
        Input, Scan, Symbols, Bindings, Wirˉsummary, Orders, true
    );
}

export fn Compilerˉanalyzeˉpreparedˉsourceˉwvbˉreachability(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Bindings: Sourceˉbindings.Compilerˉsourceˉbindingˉsummary,
    Wirˉsummary: Sourceˉwir.Compilerˉsourceˉwirˉsummary
) -> Compilerˉsourceˉwvbˉreachability {
    let Baseˉorders: Compilerˉsourceˉwvbˉsymbolˉorders =
        Compilerˉsourceˉwvbˉbuildˉsymbolˉorders(
            Input, Scan, Symbols, Wirˉsummary.Directory
        );
    let Genericˉtypeˉcatalog:
        Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog =
        Compilerˉsourceˉwvbˉbindingsˉtypeˉcatalog(
            Bindings.Directory
        );
    let Concreteˉtypeˉbase: u32 = Baseˉorders.Concreteˉrecords +
        Symbols.Enums + Baseˉorders.Concreteˉvariants;
    let Materialization:
        Genericˉmaterialization.Compilerˉsourceˉgenericˉtypeˉmaterialization =
        Genericˉmaterialization.Compilerˉsourceˉgenericˉtypeˉmaterialize(
            Input, Scan, Symbols, Genericˉtypeˉcatalog, Concreteˉtypeˉbase
        );
    if Materialization.Status !=
            Genericˉmaterialization.Compilerˉsourceˉgenericˉtypeˉmaterializationˉstatus.Valid {
        var Materializationˉfailureˉstatus: Compilerˉsourceˉwvbˉstatus =
            Compilerˉsourceˉwvbˉstatus.Unsupportedˉshape;
        if Materialization.Status ==
                Genericˉmaterialization.Compilerˉsourceˉgenericˉtypeˉmaterializationˉstatus.Typeˉlimit ||
            Materialization.Status ==
                Genericˉmaterialization.Compilerˉsourceˉgenericˉtypeˉmaterializationˉstatus.Evidenceˉlimit {
            Materializationˉfailureˉstatus =
                Compilerˉsourceˉwvbˉstatus.Bytecodeˉlimit;
        }
        return Compilerˉsourceˉwvbˉreachabilityˉfailure(
            Input, Materializationˉfailureˉstatus, Wirˉsummary.Status,
            Symbols.Functions, Wirˉsummary.Operations
        );
    }
    let Canonicalˉentries: bytes =
        Genericˉnominalˉtypes.Compilerˉsourceˉwvbˉgenericˉnominalˉcanonicalˉentries(
            Input, Materialization, Baseˉorders.Concreteˉrecords,
            Symbols.Enums, Baseˉorders.Concreteˉvariants
        );
    if Bytesˉlength(Canonicalˉentries) != Materialization.Instances * 36u32 {
        return Compilerˉsourceˉwvbˉreachabilityˉfailure(
            Input, Compilerˉsourceˉwvbˉstatus.Unsupportedˉshape,
            Wirˉsummary.Status, Symbols.Functions, Wirˉsummary.Operations
        );
    }
    let Orders: Compilerˉsourceˉwvbˉsymbolˉorders =
        Compilerˉsourceˉwvbˉsymbolˉorders(
            Baseˉorders.Capabilityˉentries, Baseˉorders.Capabilityˉranks,
            Baseˉorders.Dataˉentries, Baseˉorders.Dataˉranks,
            Baseˉorders.Recordˉentries, Baseˉorders.Recordˉranks,
            Baseˉorders.Enumˉentries, Baseˉorders.Enumˉranks,
            Baseˉorders.Variantˉentries, Baseˉorders.Variantˉranks,
            Baseˉorders.Functionˉentries, Baseˉorders.Functionˉranks,
            Baseˉorders.Recordˉtargets, Baseˉorders.Variantˉtargets,
            Baseˉorders.Concreteˉrecords, Baseˉorders.Concreteˉvariants,
            Materialization.Records,
            Canonicalˉentries, Materialization.Instances,
            Materialization.Fieldˉevidence, Materialization.Catalogˉevidence,
            Genericˉnominalˉtypes.Compilerˉsourceˉwvbˉgenericˉnominalˉwireˉentries(Canonicalˉentries),
            Compilerˉsourceˉwvbˉplanˉbuilderˉownedˉshapes(Input, Scan, Symbols, Genericˉtypeˉcatalog),
            Baseˉorders.Ownershipˉconstructors
        );
    return Compilerˉsourceˉwvbˉreachabilityˉwithˉevidence(
        Input, Scan, Symbols, Bindings, Wirˉsummary, Orders
    );
}

export fn Compilerˉemitˉpreparedˉsourceˉwvb(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Bindings: Sourceˉbindings.Compilerˉsourceˉbindingˉsummary,
    Wirˉsummary: Sourceˉwir.Compilerˉsourceˉwirˉsummary,
    Optimize: bool
) -> Compilerˉsourceˉwvbˉsummary {
    let Root: Sourceˉset.Compilerˉsourceˉsetˉview = Sourceˉset.Compilerˉsourceˉsetˉmodule(
        Input, Scan, 0u32
    );
    let Rootˉheader: Sourceˉdeclarations.Compilerˉsourceˉheader = Sourceˉdeclarations.Compilerˉparseˉheaderˉvalidated(
        Root.Source
    );
    let Baseˉorders: Compilerˉsourceˉwvbˉsymbolˉorders =
        Compilerˉsourceˉwvbˉbuildˉsymbolˉorders(
            Input, Scan, Symbols, Wirˉsummary.Directory
        );
    let Genericˉtypeˉcatalog:
        Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog =
        Compilerˉsourceˉwvbˉbindingsˉtypeˉcatalog(
            Bindings.Directory
        );
    let Concreteˉtypeˉbase: u32 = Baseˉorders.Concreteˉrecords +
        Symbols.Enums + Baseˉorders.Concreteˉvariants;
    let Materialization:
        Genericˉmaterialization.Compilerˉsourceˉgenericˉtypeˉmaterialization =
        Genericˉmaterialization.Compilerˉsourceˉgenericˉtypeˉmaterialize(
            Input, Scan, Symbols, Genericˉtypeˉcatalog, Concreteˉtypeˉbase
        );
    if Materialization.Status !=
            Genericˉmaterialization.Compilerˉsourceˉgenericˉtypeˉmaterializationˉstatus.Valid {
        var Materializationˉfailureˉstatus: Compilerˉsourceˉwvbˉstatus =
            Compilerˉsourceˉwvbˉstatus.Unsupportedˉshape;
        if Materialization.Status ==
                Genericˉmaterialization.Compilerˉsourceˉgenericˉtypeˉmaterializationˉstatus.Typeˉlimit ||
            Materialization.Status ==
                Genericˉmaterialization.Compilerˉsourceˉgenericˉtypeˉmaterializationˉstatus.Evidenceˉlimit {
            Materializationˉfailureˉstatus =
                Compilerˉsourceˉwvbˉstatus.Bytecodeˉlimit;
        }
        return Compilerˉsourceˉwvbˉsummaryˉfailure(
            Input, Materializationˉfailureˉstatus, Wirˉsummary.Status,
            Symbols.Functions, Wirˉsummary.Operations
        );
    }
    let Genericˉnominalˉencoding:
        Genericˉnominalˉtypes.Compilerˉsourceˉwvbˉgenericˉnominalˉencoding =
        Genericˉnominalˉtypes.Compilerˉsourceˉwvbˉencodeˉgenericˉnominalˉtypes(
            Input, Scan, Symbols, Materialization,
            Baseˉorders.Recordˉtargets, Baseˉorders.Variantˉtargets,
            Baseˉorders.Concreteˉrecords, Concreteˉtypeˉbase
        );
    if Genericˉnominalˉencoding.Status !=
            Genericˉnominalˉtypes.Compilerˉsourceˉwvbˉgenericˉnominalˉstatus.Valid {
        var Encodingˉfailureˉstatus: Compilerˉsourceˉwvbˉstatus =
            Compilerˉsourceˉwvbˉstatus.Unsupportedˉshape;
        if Genericˉnominalˉencoding.Status ==
                Genericˉnominalˉtypes.Compilerˉsourceˉwvbˉgenericˉnominalˉstatus.Typeˉlimit ||
            Genericˉnominalˉencoding.Status ==
                Genericˉnominalˉtypes.Compilerˉsourceˉwvbˉgenericˉnominalˉstatus.Evidenceˉlimit {
            Encodingˉfailureˉstatus =
                Compilerˉsourceˉwvbˉstatus.Bytecodeˉlimit;
        }
        return Compilerˉsourceˉwvbˉsummaryˉfailure(
            Input, Encodingˉfailureˉstatus, Wirˉsummary.Status,
            Symbols.Functions, Wirˉsummary.Operations
        );
    }
    let Orders: Compilerˉsourceˉwvbˉsymbolˉorders =
        Compilerˉsourceˉwvbˉsymbolˉorders(
            Baseˉorders.Capabilityˉentries, Baseˉorders.Capabilityˉranks,
            Baseˉorders.Dataˉentries, Baseˉorders.Dataˉranks,
            Baseˉorders.Recordˉentries, Baseˉorders.Recordˉranks,
            Baseˉorders.Enumˉentries, Baseˉorders.Enumˉranks,
            Baseˉorders.Variantˉentries, Baseˉorders.Variantˉranks,
            Baseˉorders.Functionˉentries, Baseˉorders.Functionˉranks,
            Baseˉorders.Recordˉtargets, Baseˉorders.Variantˉtargets,
            Baseˉorders.Concreteˉrecords, Baseˉorders.Concreteˉvariants,
            Genericˉnominalˉencoding.Recordˉentries,
            Genericˉnominalˉencoding.Canonicalˉentries,
            Genericˉnominalˉencoding.Entries,
            Materialization.Fieldˉevidence, Materialization.Catalogˉevidence,
            Genericˉnominalˉtypes.Compilerˉsourceˉwvbˉgenericˉnominalˉwireˉentries(Genericˉnominalˉencoding.Canonicalˉentries),
            Compilerˉsourceˉwvbˉplanˉbuilderˉownedˉshapes(Input, Scan, Symbols, Genericˉtypeˉcatalog),
            Baseˉorders.Ownershipˉconstructors
        );
    let Concreteˉorder: Compilerˉsourceˉwvbˉsymbolˉorder =
        Compilerˉsourceˉwvbˉfunctionˉorder(Orders);
    let Concreteˉfunctions: u32 = Bytesˉlength(
        Concreteˉorder.Entries
    ) / 4u32;
    var Emissionˉorders: Compilerˉsourceˉwvbˉsymbolˉorders = Orders;
    var Emissionˉfunctions: u32 = Concreteˉfunctions;
    var Reachableˉmap: bytes = Compilerˉsourceˉwvbˉempty(Input);
    if Optimize {
        let Pruning: Compilerˉsourceˉwvbˉreachability =
            Compilerˉsourceˉwvbˉreachabilityˉwithˉevidenceˉmode(
                Input, Scan, Symbols, Bindings, Wirˉsummary, Orders, false
            );
        if Pruning.Status != Compilerˉsourceˉwvbˉstatus.Valid {
            return Compilerˉsourceˉwvbˉsummaryˉfailure(
                Input,
                Pruning.Status,
                Pruning.Wirˉstatus,
                Pruning.Failureˉfunction,
                Pruning.Failureˉoperation
            );
        }
        let Retainedˉfunctions: Compilerˉsourceˉwvbˉsymbolˉorder =
            Compilerˉsourceˉwvbˉreachableˉfunctionˉorder(
                Input,
                Symbols,
                Compilerˉsourceˉwvbˉfunctionˉorder(Orders),
                Pruning
            );
        Emissionˉorders = Compilerˉsourceˉwvbˉwithˉfunctionˉorder(
            Orders, Retainedˉfunctions
        );
        Emissionˉfunctions = Pruning.Reachable;
        Reachableˉmap = Pruning.Map;
        let Retainedˉdata: Compilerˉsourceˉwvbˉsymbolˉorder =
            Compilerˉsourceˉwvbˉreachableˉdataˉorder(
                Input,
                Scan,
                Symbols,
                Compilerˉsourceˉwvbˉfunctionˉorder(Emissionˉorders),
                Emissionˉfunctions,
                Compilerˉsourceˉwvbˉdataˉorder(Orders),
                Bindings.Directory,
                Wirˉsummary.Directory
            );
        Emissionˉorders = Compilerˉsourceˉwvbˉwithˉdataˉorder(
            Emissionˉorders, Retainedˉdata
        );
    }

    let Capabilityˉencoding: Compilerˉsourceˉwvbˉdataˉencoding =
        Compilerˉsourceˉwvbˉencodeˉcapabilities(
            Input, Scan, Symbols,
            Compilerˉsourceˉwvbˉcapabilityˉorder(Orders)
        );
    if Capabilityˉencoding.Status != Compilerˉsourceˉwvbˉstatus.Valid {
        return Compilerˉsourceˉwvbˉsummaryˉfailure(
            Input,
            Capabilityˉencoding.Status,
            Wirˉsummary.Status,
            0u32,
            0u32
        );
    }

    let Textˉplan: Compilerˉsourceˉwvbˉtextˉplan =
        Compilerˉsourceˉwvbˉcollectˉtextˉplanˉmode(
            Input, Scan, Symbols,
            Compilerˉsourceˉwvbˉfunctionˉorder(Orders),
            Concreteˉfunctions,
            Bindings.Directory,
            Wirˉsummary.Directory,
            Reachableˉmap,
            Optimize
        );
    if Textˉplan.Status != Compilerˉsourceˉwvbˉstatus.Valid {
        return Compilerˉsourceˉwvbˉsummaryˉfailure(
            Input,
            Textˉplan.Status,
            Wirˉsummary.Status,
            Symbols.Functions,
            Wirˉsummary.Operations
        );
    }
    let Dataˉencoding: Compilerˉsourceˉwvbˉdataˉencoding =
        Compilerˉsourceˉwvbˉencodeˉdataˉvalidated(
            Input, Scan, Symbols, Textˉplan,
            Compilerˉsourceˉwvbˉdataˉorder(Orders),
            Compilerˉsourceˉwvbˉdataˉorder(Emissionˉorders),
            Optimize
        );
    if Dataˉencoding.Status != Compilerˉsourceˉwvbˉstatus.Valid {
        return Compilerˉsourceˉwvbˉsummaryˉfailure(
            Input,
            Dataˉencoding.Status,
            Wirˉsummary.Status,
            Symbols.Functions,
            Wirˉsummary.Operations
        );
    }
    var Typeˉencoding: Compilerˉsourceˉwvbˉtypeˉencoding =
        Compilerˉsourceˉwvbˉtypeˉencoding(
            Compilerˉsourceˉwvbˉstatus.Valid,
            Bytesˉfromˉu32ˉlittle(0u32), 0u32
        );
    if !Optimize || Compilerˉsourceˉwvbˉwirˉrequiresˉtypeˉentries(
        Wirˉsummary.Directory, Bindings, Symbols, Orders
    ) {
        Typeˉencoding = Compilerˉsourceˉwvbˉencodeˉtypes(
            Input, Scan, Symbols, Orders, Genericˉnominalˉencoding,
            Wirˉsummary.Directory
        );
    }
    if Typeˉencoding.Status != Compilerˉsourceˉwvbˉstatus.Valid {
        return Compilerˉsourceˉwvbˉsummaryˉfailure(
            Input,
            Typeˉencoding.Status,
            Wirˉsummary.Status,
            Symbols.Functions,
            Wirˉsummary.Operations
        );
    }
    if Optimize {
        // Unreachable functions still obey their declared borrow contracts.
        // Use the complete source graph for validation; emitted feature flags
        // continue to come only from the reachable graph below.
        let Validationˉfoundationˉborrows: bool =
            Compilerˉsourceˉwvbˉmoduleˉhasˉrecordˉcollection(
                Wirˉsummary.Directory, Symbols, Bindings, Orders
            ) || Compilerˉsourceˉwvbˉmoduleˉhasˉcollectionˉhelper(
                Input, Scan, Wirˉsummary.Directory, Symbols, Bindings, Orders
            ) || Compilerˉsourceˉwvbˉmoduleˉhasˉfoundationˉborrow(
                Wirˉsummary.Directory, Orders
            );
        var Validationˉrank: u32 = 0u32;
        while Validationˉrank < Concreteˉfunctions {
            let Validationˉfunction: u32 =
                Compilerˉsourceˉwvbˉorderedˉsymbol(
                    Compilerˉsourceˉwvbˉfunctionˉorder(Orders),
                    Validationˉrank
                );
            if Compilerˉsourceˉwvbˉsourceˉfunctionˉisˉadmitted(
                    Input, Scan, Symbols, Bindings,
                    Wirˉsummary.Directory, Validationˉfunction
                ) == 2u32 {
                return Compilerˉsourceˉwvbˉsummaryˉfailure(
                    Input, Compilerˉsourceˉwvbˉstatus.Unsupportedˉshape,
                    Wirˉsummary.Status, Validationˉrank,
                    Wirˉsummary.Operations
                );
            }
            if Bytesˉreadˉu8(Reachableˉmap, Validationˉfunction) == 0u8 {
                let Validationˉdeclaration: u32 =
                    Compilerˉsourceˉwvbˉfunctionˉdeclaration(
                        Symbols, Bindings.Directory,
                        Validationˉfunction
                    );
                let Validationˉview: Sourceˉset.Compilerˉsourceˉsetˉview =
                    Compilerˉsourceˉwvbˉsymbolˉsource(
                        Input, Scan, Symbols, Validationˉdeclaration
                    );
                let Validationˉheader: Sourceˉdeclarations.Compilerˉsourceˉheader =
                    Sourceˉdeclarations.Compilerˉparseˉheaderˉvalidated(
                        Validationˉview.Source
                    );
                let Validationˉencoding: Compilerˉsourceˉwvbˉfunctionˉencoding =
                    Compilerˉsourceˉwvbˉencodeˉfunction(
                        Input, Scan,
                        Validationˉview.Source, Validationˉheader,
                        Symbols, Bindings, Orders, Textˉplan,
                        Wirˉsummary.Directory,
                        Validationˉfunction,
                        0u32, false, Validationˉfoundationˉborrows
                    );
                if Validationˉencoding.Status !=
                    Compilerˉsourceˉwvbˉstatus.Valid {
                    return Compilerˉsourceˉwvbˉsummaryˉruleˉfailure(
                        Input,
                        Validationˉencoding.Status,
                        Wirˉsummary.Status,
                        Validationˉrank,
                        Validationˉencoding.Failureˉoperation,
                        Validationˉencoding.Failureˉrule
                    );
                }
            }
            Validationˉrank = Validationˉrank + 1u32;
        }
    }

    var Functionˉpayload: bytes = Bytesˉfromˉu32ˉlittle(Emissionˉfunctions);
    var Codeˉpayload: bytes = Compilerˉsourceˉwvbˉempty(Input);
    var Exportˉentries: bytes = Compilerˉsourceˉwvbˉempty(Input);
    var Exportˉcount: u32 = 0u32;
    var Codeˉoffset: u32 = 0u32;
    var Functionˉrank: u32 = 0u32;
    var Features: u32 = Typeˉencoding.Features;
    // One reachable-operation scan selects the module contract. Parameter
    // identity comes from declarations, never caller order or a fixed point.
    let Collectionˉownerˉmodule: bool = Compilerˉsourceˉwvbˉmoduleˉhasˉrecordˉcollection(
        Wirˉsummary.Directory, Symbols, Bindings, Emissionˉorders
    ) || Compilerˉsourceˉwvbˉmoduleˉhasˉcollectionˉhelper(
        Input, Scan, Wirˉsummary.Directory, Symbols, Bindings, Emissionˉorders
    );
    let Foundationˉborrowˉmodule: bool = Collectionˉownerˉmodule || Compilerˉsourceˉwvbˉmoduleˉhasˉfoundationˉborrow(
        Wirˉsummary.Directory, Emissionˉorders
    );
    while Functionˉrank < Emissionˉfunctions {
        let Functionˉentry: u32 = Compilerˉsourceˉwvbˉorderedˉsymbol(
            Compilerˉsourceˉwvbˉfunctionˉorder(Emissionˉorders), Functionˉrank
        );
        let Sourceˉadmission: u32 =
            Compilerˉsourceˉwvbˉsourceˉfunctionˉisˉadmitted(
                Input, Scan, Symbols, Bindings,
                Wirˉsummary.Directory, Functionˉentry
            );
        if Sourceˉadmission == 2u32 {
            return Compilerˉsourceˉwvbˉsummaryˉfailure(
                Input, Compilerˉsourceˉwvbˉstatus.Unsupportedˉshape,
                Wirˉsummary.Status, Functionˉrank,
                Wirˉsummary.Operations
            );
        }
        if Sourceˉadmission == 1u32 { Features = Features | 262144u32; }
        let Functionˉdeclaration: u32 =
            Compilerˉsourceˉwvbˉfunctionˉdeclaration(
                Symbols, Bindings.Directory, Functionˉentry
            );
        let Functionˉview: Sourceˉset.Compilerˉsourceˉsetˉview =
            Compilerˉsourceˉwvbˉsymbolˉsource(
                Input, Scan, Symbols, Functionˉdeclaration
            );
        let Functionˉheader: Sourceˉdeclarations.Compilerˉsourceˉheader =
            Sourceˉdeclarations.Compilerˉparseˉheaderˉvalidated(Functionˉview.Source);
        let Functionˉowner: u32 = Compilerˉsourceˉwvbˉsymbolˉmodule(
            Symbols, Functionˉdeclaration
        );
        let Encoded: Compilerˉsourceˉwvbˉfunctionˉencoding =
            Compilerˉsourceˉwvbˉencodeˉfunction(
                Input, Scan, Functionˉview.Source, Functionˉheader,
                Symbols, Bindings, Emissionˉorders, Textˉplan,
                Wirˉsummary.Directory,
                Functionˉentry, Codeˉoffset, true, Foundationˉborrowˉmodule
            );
        if Encoded.Status != Compilerˉsourceˉwvbˉstatus.Valid {
            return Compilerˉsourceˉwvbˉsummaryˉruleˉfailure(
                Input,
                Encoded.Status,
                Wirˉsummary.Status,
                Functionˉrank,
                Encoded.Failureˉoperation,
                Encoded.Failureˉrule
            );
        }
        Features = Features | Encoded.Features;
        Functionˉpayload = Bytesˉconcat(Functionˉpayload, Encoded.Metadata);
        Codeˉpayload = Bytesˉconcat(Codeˉpayload, Encoded.Code);
        if Functionˉentry == Functionˉdeclaration && Functionˉowner == 0u32 {
            if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉlookupˉisˉexported(
                Symbols.Lookup, Functionˉentry
            ) {
                Exportˉcount = Exportˉcount + 1u32;
                Exportˉentries = Bytesˉconcat(
                    Exportˉentries,
                    Compilerˉsourceˉwvbˉencodedˉstring(
                        Compilerˉsourceˉwvbˉsymbolˉname(
                            Input, Scan, Symbols, Functionˉentry
                        )
                    )
                );
                Exportˉentries = Bytesˉconcat(
                    Exportˉentries, Bytesˉfromˉu8(1u8)
                );
                Exportˉentries = Bytesˉconcat(
                    Exportˉentries, Bytesˉfromˉu32ˉlittle(Functionˉrank)
                );
            }
        }
        Codeˉoffset = Codeˉoffset + Bytesˉlength(Encoded.Code);
        Functionˉrank = Functionˉrank + 1u32;
    }
    let Moduleˉmetadata: Compilerˉsourceˉwvbˉdataˉencoding =
        Compilerˉsourceˉwvbˉmoduleˉmetadata(Root.Source);
    if Moduleˉmetadata.Status != Compilerˉsourceˉwvbˉstatus.Valid {
        return Compilerˉsourceˉwvbˉsummaryˉfailure(
            Input,
            Moduleˉmetadata.Status,
            Wirˉsummary.Status,
            Symbols.Functions,
            Wirˉsummary.Operations
        );
    }
    var Moduleˉpayload: bytes = Bytesˉfromˉu8(
        Compilerˉsourceˉwvbˉprofile(Rootˉheader.Profile)
    );
    Moduleˉpayload = Bytesˉconcat(
        Moduleˉpayload,
        Compilerˉsourceˉwvbˉstring(
            Root.Source, Rootˉheader.Nameˉoffset, Rootˉheader.Nameˉlength
        )
    );
    var Metadataˉpresent: u8 = 0u8;
    if Bytesˉlength(Moduleˉmetadata.Payload) != 0u32 {
        Metadataˉpresent = 1u8;
    }
    Moduleˉpayload = Bytesˉconcat(
        Moduleˉpayload, Bytesˉfromˉu8(Metadataˉpresent)
    );
    Moduleˉpayload = Bytesˉconcat(Moduleˉpayload, Moduleˉmetadata.Payload);
    let Exportˉpayload: bytes = Bytesˉconcat(
        Bytesˉfromˉu32ˉlittle(Exportˉcount),
        Exportˉentries
    );
    var Bytecode: bytes = Textˉtoˉutf8("WVB1");
    Bytecode = Bytesˉconcat(Bytecode, Bytesˉfromˉu16ˉlittle(1u32));
    var Wvbˉminor: u32 = 11u32;
    if (Features & 2u32) != 0u32 { Wvbˉminor = 12u32; }
    if (Features & 4u32) != 0u32 { Wvbˉminor = 13u32; }
    if (Features & 8u32) != 0u32 { Wvbˉminor = 14u32; }
    if (Features & 16u32) != 0u32 { Wvbˉminor = 15u32; }
    if (Features & 32u32) != 0u32 { Wvbˉminor = 16u32; }
    if (Features & 64u32) != 0u32 { Wvbˉminor = 17u32; }
    if (Features & 128u32) != 0u32 { Wvbˉminor = 18u32; }
    if (Features & 256u32) != 0u32 { Wvbˉminor = 19u32; }
    if (Features & 512u32) != 0u32 { Wvbˉminor = 20u32; }
    if (Features & 1024u32) != 0u32 { Wvbˉminor = 21u32; }
    if (Features & 2048u32) != 0u32 { Wvbˉminor = 22u32; }
    if (Features & 4096u32) != 0u32 { Wvbˉminor = 23u32; }
    if (Features & 8192u32) != 0u32 { Wvbˉminor = 24u32; }
    if (Features & 16384u32) != 0u32 { Wvbˉminor = 25u32; }
    if (Features & 32768u32) != 0u32 { Wvbˉminor = 26u32; }
    if (Features & 65536u32) != 0u32 { Wvbˉminor = 27u32; }
    if (Features & 131072u32) != 0u32 { Wvbˉminor = 28u32; }
    if (Features & 262144u32) != 0u32 { Wvbˉminor = 29u32; }
    if (Features & 1048576u32) != 0u32 {
        Wvbˉminor = 31u32;
    } else if (Features & 524288u32) != 0u32 {
        Wvbˉminor = 30u32;
    }
    if (Features & WVB_TASK_FEATURE) != 0u32 { Wvbˉminor = 32u32; }
    if (Features & WVB_UNSAFE_SCRATCH_FEATURE) != 0u32 { Wvbˉminor = 33u32; }
    if (Features & WVB_BORROWED_BUDGET_FEATURE) != 0u32 { Wvbˉminor = 34u32; }
    if (Features & WVB_UNSAFE_SCRATCH_LENGTH_FEATURE) != 0u32 {
        Wvbˉminor = 35u32;
    }
    if (Features & WVB_UNSAFE_WRITE_REGION_FEATURE) != 0u32 {
        Wvbˉminor = 36u32;
    }
    if (Features & WVB_UNSAFE_WRITE_POINTER_FEATURE) != 0u32 {
        Wvbˉminor = 37u32;
    }
    if (Features & WVB_FOREIGN_CALL_FEATURE) != 0u32 {
        Wvbˉminor = 38u32;
    }
    if (Features & WVB_FOUNDATION_VALUE_BORROW_FEATURE) != 0u32 {
        Wvbˉminor = 39u32;
    }
    if (Features & (WVB_VECTOR_PARAMETER_READ_FEATURE | WVB_VECTOR_PAYLOAD_BORROW_FEATURE)) != 0u32 {
        Wvbˉminor = 40u32;
    }
    if (Features & WVB_VECTOR_INDEXED_BORROW_FEATURE) != 0u32 {
        Wvbˉminor = 41u32;
    }
    if Collectionˉownerˉmodule { Wvbˉminor = 42u32; }
    if Compilerˉsourceˉwvbˉmoduleˉhasˉvectorˉmutation(
        Wirˉsummary.Directory, Emissionˉorders
    ) { Wvbˉminor = 43u32; }
    if Bytesˉreadˉu16ˉlittle(Wirˉsummary.Directory, 6u32) >= 39u32 ||
        Bytesˉlength(Orders.Builderˉownedˉshapes) != 0u32 { Wvbˉminor = 44u32; }
    if Compilerˉsourceˉwvbˉmoduleˉhasˉbudgetˉhelperˉtransfer(
        Input, Scan, Symbols, Bindings, Wirˉsummary.Directory, Emissionˉorders
    ) { Wvbˉminor = 45u32; }
    Bytecode = Bytesˉconcat(Bytecode, Bytesˉfromˉu16ˉlittle(Wvbˉminor));
    Bytecode = Bytesˉconcat(Bytecode, Bytesˉfromˉu32ˉlittle(7u32));
    Bytecode = Bytesˉconcat(
        Bytecode, Compilerˉsourceˉwvbˉsection(1u8, Moduleˉpayload)
    );
    Bytecode = Bytesˉconcat(
        Bytecode,
        Compilerˉsourceˉwvbˉsection(2u8, Capabilityˉencoding.Payload)
    );
    Bytecode = Bytesˉconcat(
        Bytecode, Compilerˉsourceˉwvbˉsection(3u8, Dataˉencoding.Payload)
    );
    Bytecode = Bytesˉconcat(
        Bytecode, Compilerˉsourceˉwvbˉsection(4u8, Functionˉpayload)
    );
    Bytecode = Bytesˉconcat(
        Bytecode, Compilerˉsourceˉwvbˉsection(5u8, Codeˉpayload)
    );
    Bytecode = Bytesˉconcat(
        Bytecode, Compilerˉsourceˉwvbˉsection(6u8, Exportˉpayload)
    );
    Bytecode = Bytesˉconcat(
        Bytecode, Compilerˉsourceˉwvbˉsection(7u8, Typeˉencoding.Payload)
    );
    if Bytesˉlength(Bytecode) > 16777216u32 {
        return Compilerˉsourceˉwvbˉsummaryˉfailure(
            Input,
            Compilerˉsourceˉwvbˉstatus.Bytecodeˉlimit,
            Wirˉsummary.Status,
            Symbols.Functions,
            Wirˉsummary.Operations
        );
    }
    return Compilerˉsourceˉwvbˉsummary(
        Compilerˉsourceˉwvbˉstatus.Valid,
        Wirˉsummary.Status,
        Emissionˉfunctions,
        Bytesˉlength(Codeˉpayload),
        Bytecode,
        Symbols.Functions,
        Wirˉsummary.Operations,
        0u32,
        ""
    );
}
