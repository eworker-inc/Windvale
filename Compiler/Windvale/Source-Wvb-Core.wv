module Compilerˉsourceˉwvb profile portable;

import Compilerˉsourceˉbindings as Sourceˉbindings;
import Compilerˉsourceˉdeclarationˉparser as Sourceˉdeclarations;
import Compilerˉsourceˉlexer as Sourceˉlexer;
import Compilerˉsourceˉset as Sourceˉset;
import Compilerˉsourceˉsymbols as Sourceˉsymbols;
import Compilerˉsourceˉwir as Sourceˉwir;
import Compilerˉsourceˉwvbˉtemporaryˉslots as Temporaryˉslots;
import Foundationˉbyteˉconstruction as Byteˉconstruction;

export enum Compilerˉsourceˉwvbˉstatus {
    Valid = 0;
    Sourceˉwir = 1;
    Unsupportedˉmoduleˉcount = 2;
    Unsupportedˉprofile = 3;
    Unsupportedˉdeclaration = 4;
    Unsupportedˉshape = 5;
    Unsupportedˉoperation = 6;
    Bytecodeˉlimit = 7;
    Invalidˉdata = 8;
}

record Compilerˉsourceˉwvbˉtextˉvalue {
    Status: Compilerˉsourceˉwvbˉstatus;
    Value: bytes;
}

record Compilerˉsourceˉwvbˉdivision {
    Quotient: u32;
    Remainder: u32;
}

record Compilerˉsourceˉwvbˉdigit {
    Value: u32;
    Remainder: u32;
}

record Compilerˉsourceˉwvbˉtextˉplan {
    Status: Compilerˉsourceˉwvbˉstatus;
    Count: u32;
    Nextˉname: u32;
    Directory: bytes;
    Values: bytes;
}

record Compilerˉsourceˉwvbˉdataˉencoding {
    Status: Compilerˉsourceˉwvbˉstatus;
    Payload: bytes;
}

record Compilerˉsourceˉwvbˉcapabilityˉencoding {
    Status: Compilerˉsourceˉwvbˉstatus;
    Payload: bytes;
}

record Compilerˉsourceˉwvbˉtypeˉencoding {
    Status: Compilerˉsourceˉwvbˉstatus;
    Payload: bytes;
    Hasˉcollections: bool;
}

record Compilerˉsourceˉwvbˉanalysis {
    Status: Compilerˉsourceˉwvbˉstatus;
    Codeˉlength: u32;
    Maximumˉstack: u32;
    Blockˉoffsets: bytes;
    Failureˉoperation: u32;
}

record Compilerˉsourceˉwvbˉfunctionˉencoding {
    Status: Compilerˉsourceˉwvbˉstatus;
    Metadata: bytes;
    Code: bytes;
    Failureˉoperation: u32;
    Hasˉcollections: bool;
    Hasˉoperators: bool;
}

record Compilerˉsourceˉwvbˉsymbolˉorder {
    Entries: bytes;
    Ranks: bytes;
}

record Compilerˉsourceˉwvbˉsymbolˉorders {
    Capabilityˉentries: bytes;
    Capabilityˉranks: bytes;
    Dataˉentries: bytes;
    Dataˉranks: bytes;
    Recordˉentries: bytes;
    Recordˉranks: bytes;
    Enumˉentries: bytes;
    Enumˉranks: bytes;
    Variantˉentries: bytes;
    Variantˉranks: bytes;
    Functionˉentries: bytes;
    Functionˉranks: bytes;
}

export record Compilerˉsourceˉwvbˉsummary {
    Status: Compilerˉsourceˉwvbˉstatus;
    Wirˉstatus: Sourceˉwir.Compilerˉsourceˉwirˉstatus;
    Functions: u32;
    Codeˉbytes: u32;
    Bytecode: bytes;
    Failureˉfunction: u32;
    Failureˉoperation: u32;
}

export record Compilerˉsourceˉwvbˉreachability {
    Status: Compilerˉsourceˉwvbˉstatus;
    Wirˉstatus: Sourceˉwir.Compilerˉsourceˉwirˉstatus;
    Functions: u32;
    Roots: u32;
    Reachable: u32;
    Unreachable: u32;
    Calls: u32;
    Reachableˉcalls: u32;
    Codeˉbytes: u32;
    Reachableˉcodeˉbytes: u32;
    Unreachableˉcodeˉbytes: u32;
    Map: bytes;
    Failureˉfunction: u32;
    Failureˉoperation: u32;
}

export fn Compilerˉsourceˉwvbˉempty(Input: bytes) -> bytes {
    return Bytesˉslice(Input, 0u32, 0u32);
}

export fn Compilerˉsourceˉwvbˉsummaryˉfailure(
    Input: bytes,
    Status: Compilerˉsourceˉwvbˉstatus,
    Wirˉstatus: Sourceˉwir.Compilerˉsourceˉwirˉstatus,
    Function: u32,
    Operation: u32
) -> Compilerˉsourceˉwvbˉsummary {
    return Compilerˉsourceˉwvbˉsummary(
        Status,
        Wirˉstatus,
        0u32,
        0u32,
        Compilerˉsourceˉwvbˉempty(Input),
        Function,
        Operation
    );
}

export fn Compilerˉsourceˉwvbˉreachabilityˉfailure(
    Input: bytes,
    Status: Compilerˉsourceˉwvbˉstatus,
    Wirˉstatus: Sourceˉwir.Compilerˉsourceˉwirˉstatus,
    Function: u32,
    Operation: u32
) -> Compilerˉsourceˉwvbˉreachability {
    return Compilerˉsourceˉwvbˉreachability(
        Status,
        Wirˉstatus,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        Compilerˉsourceˉwvbˉempty(Input),
        Function,
        Operation
    );
}

export fn Compilerˉsourceˉwvbˉstring(
    Source: bytes,
    Offset: u32,
    Length: u32
) -> bytes {
    return Bytesˉconcat(
        Bytesˉfromˉu32ˉlittle(Length),
        Bytesˉslice(Source, Offset, Length)
    );
}

export fn Compilerˉsourceˉwvbˉencodedˉstring(Value: bytes) -> bytes {
    return Bytesˉconcat(
        Bytesˉfromˉu32ˉlittle(Bytesˉlength(Value)),
        Value
    );
}

export fn Compilerˉsourceˉwvbˉsection(Kind: u8, Payload: bytes) -> bytes {
    var Result: bytes = Bytesˉfromˉu8(Kind);
    Result = Bytesˉconcat(Result, Bytesˉfromˉu8(0u8));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu16ˉlittle(0u32));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Bytesˉlength(Payload)));
    return Bytesˉconcat(Result, Payload);
}

export fn Compilerˉsourceˉwvbˉshapeˉisˉsupported(
    Shape: u32,
    Allowˉvoid: bool,
    Records: u32,
    Enums: u32,
    Variants: u32
) -> bool {
    if Shape == 0u32 { return Allowˉvoid; }
    if Shape <= 8u32 { return true; }
    if Shape >= 65536u32 {
        if Shape < 65536u32 + Records { return true; }
    }
    if Shape >= 131072u32 + Records {
        if Shape < 131072u32 + Records + Enums { return true; }
    }
    if Shape >= 196608u32 + Records + Enums {
        if Shape < 196608u32 + Records + Enums + Variants { return true; }
    }
    if Sourceˉwir.Compilerˉsourceˉwirˉshapeˉisˉsequence(Shape) ||
        Sourceˉwir.Compilerˉsourceˉwirˉshapeˉisˉbuilder(Shape) {
        let Maximum: u32 = Sourceˉwir.Compilerˉsourceˉwirˉcollectionˉmaximum(Shape);
        if Maximum == 0u32 || Maximum > 4095u32 { return false; }
        return Compilerˉsourceˉwvbˉshapeˉisˉsupported(
            Sourceˉwir.Compilerˉsourceˉwirˉcollectionˉelementˉshape(Shape),
            false, Records, Enums, Variants
        );
    }
    return false;
}

export fn Compilerˉsourceˉwvbˉshape(Shape: u32) -> bytes {
    var Kind: u8 = 0u8;
    if Shape == 1u32 { Kind = 1u8; }
    if Shape == 2u32 { Kind = 4u8; }
    if Shape == 3u32 { Kind = 5u8; }
    if Shape == 4u32 { Kind = 2u8; }
    if Shape == 5u32 { Kind = 3u8; }
    if Shape == 6u32 { Kind = 6u8; }
    if Shape == 7u32 { Kind = 9u8; }
    if Shape == 8u32 { Kind = 10u8; }
    if Sourceˉwir.Compilerˉsourceˉwirˉshapeˉisˉsequence(Shape) ||
        Sourceˉwir.Compilerˉsourceˉwirˉshapeˉisˉbuilder(Shape) {
        var Collectionˉkind: u8 = 12u8;
        if Sourceˉwir.Compilerˉsourceˉwirˉshapeˉisˉbuilder(Shape) {
            Collectionˉkind = 13u8;
        }
        var Collectionˉshape: bytes = Bytesˉfromˉu8(Collectionˉkind);
        Collectionˉshape = Bytesˉconcat(
            Collectionˉshape,
            Compilerˉsourceˉwvbˉshape(
                Sourceˉwir.Compilerˉsourceˉwirˉcollectionˉelementˉshape(Shape)
            )
        );
        return Bytesˉconcat(
            Collectionˉshape,
            Bytesˉfromˉu32ˉlittle(
                Sourceˉwir.Compilerˉsourceˉwirˉcollectionˉmaximum(Shape)
            )
        );
    }
    if Shape < 65536u32 { return Bytesˉfromˉu8(Kind); }
    if Shape < 131072u32 {
        return Bytesˉconcat(
            Bytesˉfromˉu8(7u8),
            Bytesˉfromˉu32ˉlittle(Shape - 65536u32)
        );
    }
    if Shape < 196608u32 {
        return Bytesˉconcat(
            Bytesˉfromˉu8(8u8),
            Bytesˉfromˉu32ˉlittle(Shape - 131072u32)
        );
    }
    return Bytesˉconcat(
        Bytesˉfromˉu8(11u8),
        Bytesˉfromˉu32ˉlittle(Shape - 196608u32)
    );
}

export fn Compilerˉsourceˉwvbˉprofile(
    Profile: Sourceˉdeclarations.Compilerˉsourceˉprofile
) -> u8 {
    if Profile == Sourceˉdeclarations.Compilerˉsourceˉprofile.Portable { return 1u8; }
    if Profile == Sourceˉdeclarations.Compilerˉsourceˉprofile.Hosted { return 2u8; }
    return 3u8;
}

export fn Compilerˉsourceˉwvbˉmoduleˉmetadata(
    Source: bytes
) -> Compilerˉsourceˉwvbˉdataˉencoding {
    let Moduleˉtoken: Sourceˉlexer.Compilerˉsourceˉtoken =
        Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(Source, 0u32, 1u32, 1u32);
    let Name: Sourceˉlexer.Compilerˉsourceˉtoken =
        Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Source, Moduleˉtoken.Nextˉoffset, Moduleˉtoken.Nextˉline, Moduleˉtoken.Nextˉcolumn
        );
    let Form: Sourceˉlexer.Compilerˉsourceˉtoken =
        Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Source, Name.Nextˉoffset, Name.Nextˉline, Name.Nextˉcolumn
        );
    if Form.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Profile {
        return Compilerˉsourceˉwvbˉdataˉencoding(
            Compilerˉsourceˉwvbˉstatus.Valid,
            Compilerˉsourceˉwvbˉempty(Source)
        );
    }
    if Form.Kind != Sourceˉlexer.Compilerˉtokenˉkind.Semicolon {
        return Compilerˉsourceˉwvbˉdataˉencoding(
            Compilerˉsourceˉwvbˉstatus.Invalidˉdata,
            Compilerˉsourceˉwvbˉempty(Source)
        );
    }

    let Platform: Sourceˉlexer.Compilerˉsourceˉtoken =
        Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Source, Form.Nextˉoffset, Form.Nextˉline, Form.Nextˉcolumn
        );
    if Platform.Kind != Sourceˉlexer.Compilerˉtokenˉkind.Platform {
        return Compilerˉsourceˉwvbˉdataˉencoding(
            Compilerˉsourceˉwvbˉstatus.Invalidˉdata,
            Compilerˉsourceˉwvbˉempty(Source)
        );
    }
    var Cursor: u32 = Platform.Nextˉoffset;
    var Line: u32 = Platform.Nextˉline;
    var Column: u32 = Platform.Nextˉcolumn;
    var Platformˉcount: u32 = 0u32;
    var Platformˉentries: bytes = Compilerˉsourceˉwvbˉempty(Source);
    var Readingˉplatforms: bool = true;
    while Readingˉplatforms {
        let Scope: Sourceˉlexer.Compilerˉsourceˉtoken =
            Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(Source, Cursor, Line, Column);
        let Qualified: Sourceˉdeclarations.Compilerˉparseˉstep =
            Sourceˉdeclarations.Compilerˉparseˉqualifiedˉname(
                Source, Cursor, Line, Column, false
            );
        Platformˉentries = Bytesˉconcat(
            Platformˉentries,
            Compilerˉsourceˉwvbˉstring(
                Source, Scope.Offset, Qualified.Nextˉoffset - Scope.Offset
            )
        );
        Platformˉcount = Platformˉcount + 1u32;
        let Separator: Sourceˉlexer.Compilerˉsourceˉtoken =
            Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                Source, Qualified.Nextˉoffset, Qualified.Nextˉline, Qualified.Nextˉcolumn
            );
        Cursor = Separator.Nextˉoffset;
        Line = Separator.Nextˉline;
        Column = Separator.Nextˉcolumn;
        if Separator.Kind != Sourceˉlexer.Compilerˉtokenˉkind.Comma {
            Readingˉplatforms = false;
        }
    }

    let Authorityˉkeyword: Sourceˉlexer.Compilerˉsourceˉtoken =
        Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(Source, Cursor, Line, Column);
    let Authority: Sourceˉlexer.Compilerˉsourceˉtoken =
        Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Source, Authorityˉkeyword.Nextˉoffset, Authorityˉkeyword.Nextˉline, Authorityˉkeyword.Nextˉcolumn
        );
    var Authorityˉvalue: u8 = 0u8;
    if Sourceˉlexer.Compilerˉsourceˉspanˉequalsˉtext(Source, Authority.Offset, Authority.Length, "library") {
        Authorityˉvalue = 1u8;
    }
    if Sourceˉlexer.Compilerˉsourceˉspanˉequalsˉtext(Source, Authority.Offset, Authority.Length, "application") {
        Authorityˉvalue = 2u8;
    }
    if Sourceˉlexer.Compilerˉsourceˉspanˉequalsˉtext(Source, Authority.Offset, Authority.Length, "service") {
        Authorityˉvalue = 3u8;
    }
    if Authority.Kind == Sourceˉlexer.Compilerˉtokenˉkind.System { Authorityˉvalue = 4u8; }
    let Authorityˉend: Sourceˉlexer.Compilerˉsourceˉtoken =
        Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Source, Authority.Nextˉoffset, Authority.Nextˉline, Authority.Nextˉcolumn
        );
    Cursor = Authorityˉend.Nextˉoffset;
    Line = Authorityˉend.Nextˉline;
    Column = Authorityˉend.Nextˉcolumn;

    var Requiredˉcount: u32 = 0u32;
    var Requiredˉentries: bytes = Compilerˉsourceˉwvbˉempty(Source);
    var Optionalˉcount: u32 = 0u32;
    var Optionalˉentries: bytes = Compilerˉsourceˉwvbˉempty(Source);
    var Readingˉrequirements: bool = true;
    while Readingˉrequirements {
        let Requirementˉtoken: Sourceˉlexer.Compilerˉsourceˉtoken =
            Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(Source, Cursor, Line, Column);
        var Isˉoptional: bool = Requirementˉtoken.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Optional;
        if Requirementˉtoken.Kind != Sourceˉlexer.Compilerˉtokenˉkind.Requires {
            if !Isˉoptional { Readingˉrequirements = false; }
        }
        if Readingˉrequirements {
            let Requirement: Sourceˉdeclarations.Compilerˉsourceˉdeclaration =
                Sourceˉdeclarations.Compilerˉparseˉmetadataˉcapabilityˉdeclaration(
                    Source, Requirementˉtoken, Isˉoptional
                );
            var Entry: bytes = Compilerˉsourceˉwvbˉstring(
                Source, Requirement.Nameˉoffset, Requirement.Nameˉlength
            );
            Entry = Bytesˉconcat(Entry, Bytesˉfromˉu32ˉlittle(1u32));
            if Isˉoptional {
                Optionalˉentries = Bytesˉconcat(Optionalˉentries, Entry);
                Optionalˉcount = Optionalˉcount + 1u32;
            } else {
                Requiredˉentries = Bytesˉconcat(Requiredˉentries, Entry);
                Requiredˉcount = Requiredˉcount + 1u32;
            }
            Cursor = Requirement.Nextˉoffset;
            Line = Requirement.Nextˉline;
            Column = Requirement.Nextˉcolumn;
        }
    }

    var Payload: bytes = Bytesˉfromˉu8(1u8);
    Payload = Bytesˉconcat(Payload, Bytesˉfromˉu8(Authorityˉvalue));
    Payload = Bytesˉconcat(Payload, Bytesˉfromˉu32ˉlittle(Platformˉcount));
    Payload = Bytesˉconcat(Payload, Platformˉentries);
    Payload = Bytesˉconcat(Payload, Bytesˉfromˉu32ˉlittle(Requiredˉcount));
    Payload = Bytesˉconcat(Payload, Requiredˉentries);
    Payload = Bytesˉconcat(Payload, Bytesˉfromˉu32ˉlittle(Optionalˉcount));
    Payload = Bytesˉconcat(Payload, Optionalˉentries);
    return Compilerˉsourceˉwvbˉdataˉencoding(
        Compilerˉsourceˉwvbˉstatus.Valid, Payload
    );
}

