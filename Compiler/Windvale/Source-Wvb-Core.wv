export fn Compilerˉsourceˉwvbˉoperationˉisˉsupported(Operation: u32) -> bool {
    if Operation >= 1u32 {
        if Operation <= 128u32 { return true; }
    }
    return false;
}

export fn Compilerˉsourceˉwvbˉoperationˉlength(
    Operation: u32,
    Shape: u32,
    Operands: u32
) -> u32 {
    if Operation == 64u32 { return 0u32; }
    var Opcodeˉbytes: u32 = 0u32;
    if Operation == 1u32 { Opcodeˉbytes = 5u32; }
    if Operation == 2u32 { Opcodeˉbytes = 2u32; }
    if Operation == 3u32 { Opcodeˉbytes = 5u32; }
    if Operation == 4u32 { Opcodeˉbytes = 2u32; }
    if Operation == 5u32 { Opcodeˉbytes = 5u32; }
    if Operation == 6u32 { Opcodeˉbytes = 5u32; }
    if Operation == 7u32 { Opcodeˉbytes = 5u32; }
    if Operation == 8u32 { Opcodeˉbytes = 5u32; }
    if Operation == 9u32 { Opcodeˉbytes = 5u32; }
    if Operation == 10u32 { Opcodeˉbytes = 5u32; }
    if Operation >= 11u32 {
        if Operation <= 16u32 { Opcodeˉbytes = 1u32; }
    }
    if Operation == 17u32 { Opcodeˉbytes = 5u32; }
    if Operation == 18u32 { Opcodeˉbytes = 5u32; }
    if Operation == 19u32 { Opcodeˉbytes = 9u32; }
    if Operation >= 20u32 {
        if Operation <= 22u32 { Opcodeˉbytes = 1u32; }
    }
    if Operation >= 23u32 {
        if Operation <= 61u32 { Opcodeˉbytes = 1u32; }
    }
    if Operation == 62u32 { Opcodeˉbytes = 5u32; }
    if Operation == 63u32 { Opcodeˉbytes = 5u32; }
    if Operation >= 65u32 {
        if Operation <= 67u32 { Opcodeˉbytes = 9u32; }
    }
    if Operation == 68u32 { Opcodeˉbytes = 9u32; }
    if Operation >= 69u32 {
        if Operation <= 72u32 { Opcodeˉbytes = 1u32; }
    }
    if Operation >= 73u32 {
        if Operation <= 92u32 { Opcodeˉbytes = 1u32; }
    }
    if Operation == 93u32 || Operation == 94u32 { Opcodeˉbytes = 9u32; }
    if Operation >= 95u32 {
        if Operation <= 128u32 { Opcodeˉbytes = 1u32; }
    }
    var Result: u32 = Operands * 5u32 + Opcodeˉbytes;
    if Shape != 0u32 { Result = Result + 5u32; }
    return Result;
}

export fn Compilerˉsourceˉwvbˉsymbolˉmodule(
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Entry: u32
) -> u32 {
    return Bytesˉreadˉu32ˉlittle(Symbols.Directory, 16u32 + Entry * 24u32);
}

export fn Compilerˉsourceˉwvbˉsymbolˉsource(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Entry: u32
) -> Sourceˉset.Compilerˉsourceˉsetˉview {
    return Sourceˉset.Compilerˉsourceˉsetˉmodule(
        Input, Scan, Compilerˉsourceˉwvbˉsymbolˉmodule(Symbols, Entry)
    );
}

export fn Compilerˉsourceˉwvbˉsymbolˉname(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Entry: u32
) -> bytes {
    return Sourceˉsymbols.Compilerˉsourceˉsymbolsˉlookupˉemittedˉname(
        Symbols.Lookup, Scan.Modules, Entry
    );
}

export fn Compilerˉsourceˉwvbˉcapabilityˉsignature(
    Source: bytes,
    Offset: u32,
    Length: u32
) -> bytes {
    let Parameters: u32 = Sourceˉbindings.Compilerˉsourceˉbindingsˉcapabilityˉarity(
        Source, Offset, Length
    );
    var Result: bytes = Bytesˉfromˉu32ˉlittle(Parameters);
    var Parameter: u32 = 0u32;
    while Parameter < Parameters {
        Result = Bytesˉconcat(
            Result,
            Compilerˉsourceˉwvbˉshape(
                Sourceˉwir.Compilerˉsourceˉwirˉcapabilityˉparameterˉshape(
                    Source, Offset, Length, Parameter
                )
            )
        );
        Parameter = Parameter + 1u32;
    }
    return Bytesˉconcat(
        Result,
        Compilerˉsourceˉwvbˉshape(
            Sourceˉwir.Compilerˉsourceˉwirˉcapabilityˉreturnˉshape(
                Source, Offset, Length
            )
        )
    );
}

export fn Compilerˉsourceˉwvbˉencodeˉcapabilities(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Order: Compilerˉsourceˉwvbˉsymbolˉorder
) -> Compilerˉsourceˉwvbˉcapabilityˉencoding {
    var Rootˉcapabilities: u32 = 0u32;
    var Countˉrank: u32 = 0u32;
    while Countˉrank < Symbols.Capabilities {
        let Countˉentry: u32 = Compilerˉsourceˉwvbˉorderedˉsymbol(Order, Countˉrank);
        if Compilerˉsourceˉwvbˉsymbolˉmodule(Symbols, Countˉentry) == 0u32 {
            Rootˉcapabilities = Rootˉcapabilities + 1u32;
        }
        Countˉrank = Countˉrank + 1u32;
    }
    var Payload: bytes = Bytesˉfromˉu32ˉlittle(Rootˉcapabilities);
    var Rank: u32 = 0u32;
    while Rank < Symbols.Capabilities {
        let Entry: u32 = Compilerˉsourceˉwvbˉorderedˉsymbol(Order, Rank);
        if Compilerˉsourceˉwvbˉsymbolˉmodule(Symbols, Entry) == 0u32 {
            let View: Sourceˉset.Compilerˉsourceˉsetˉview = Compilerˉsourceˉwvbˉsymbolˉsource(
                Input, Scan, Symbols, Entry
            );
            let Header: Sourceˉdeclarations.Compilerˉsourceˉheader = Sourceˉdeclarations.Compilerˉparseˉheaderˉvalidated(
                View.Source
            );
            let Declaration: Sourceˉdeclarations.Compilerˉsourceˉdeclaration =
                Compilerˉsourceˉwvbˉdeclaration(View.Source, Header, Symbols, Entry);
            let Signature: bytes = Compilerˉsourceˉwvbˉcapabilityˉsignature(
                View.Source, Declaration.Nameˉoffset, Declaration.Nameˉlength
            );
            Payload = Bytesˉconcat(
                Payload,
                Compilerˉsourceˉwvbˉstring(
                    View.Source, Declaration.Nameˉoffset, Declaration.Nameˉlength
                )
            );
            Payload = Bytesˉconcat(Payload, Signature);
        }
        Rank = Rank + 1u32;
    }
    return Compilerˉsourceˉwvbˉcapabilityˉencoding(
        Compilerˉsourceˉwvbˉstatus.Valid,
        Payload
    );
}

export fn Compilerˉsourceˉwvbˉsymbolˉrank(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Entry: u32,
    Kind: u32
) -> u32 {
    let Entries: u32 = Bytesˉreadˉu32ˉlittle(Symbols.Directory, 8u32);
    let Entryˉoffset: u32 = 16u32 + Entry * 24u32;
    let Name: bytes = Compilerˉsourceˉwvbˉsymbolˉname(
        Input, Scan, Symbols, Entry
    );
    var Rank: u32 = 0u32;
    var Candidate: u32 = 0u32;
    while Candidate < Entries {
        let Candidateˉoffset: u32 = 16u32 + Candidate * 24u32;
        if Bytesˉreadˉu32ˉlittle(
            Symbols.Directory, Candidateˉoffset + 4u32
        ) == Kind {
            let Candidateˉname: bytes = Compilerˉsourceˉwvbˉsymbolˉname(
                Input, Scan, Symbols, Candidate
            );
            if Sourceˉset.Compilerˉsourceˉspansˉcompare(
                Candidateˉname, 0u32, Bytesˉlength(Candidateˉname),
                Name, 0u32, Bytesˉlength(Name)
            ) < 0 { Rank = Rank + 1u32; }
        }
        Candidate = Candidate + 1u32;
    }
    return Rank;
}

export fn Compilerˉsourceˉwvbˉsymbolˉbyˉrank(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Kind: u32,
    Rank: u32
) -> u32 {
    let Entries: u32 = Bytesˉreadˉu32ˉlittle(Symbols.Directory, 8u32);
    var Entry: u32 = 0u32;
    while Entry < Entries {
        let Entryˉoffset: u32 = 16u32 + Entry * 24u32;
        if Bytesˉreadˉu32ˉlittle(
            Symbols.Directory, Entryˉoffset + 4u32
        ) == Kind {
            if Compilerˉsourceˉwvbˉsymbolˉrank(
                Input, Scan, Symbols, Entry, Kind
            ) == Rank { return Entry; }
        }
        Entry = Entry + 1u32;
    }
    return Sourceˉwir.Compilerˉsourceˉwirˉsentinel();
}

export fn Compilerˉsourceˉwvbˉbuildˉsymbolˉorder(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Kind: u32
) -> Compilerˉsourceˉwvbˉsymbolˉorder {
    let Entries: u32 = Bytesˉreadˉu32ˉlittle(Symbols.Directory, 8u32);
    var Ordered: bytes = Compilerˉsourceˉwvbˉempty(Input);
    var Count: u32 = 0u32;
    var Candidate: u32 = 0u32;
    while Candidate < Entries {
        let Candidateˉentry: u32 = 16u32 + Candidate * 24u32;
        if Bytesˉreadˉu32ˉlittle(
            Symbols.Directory, Candidateˉentry + 4u32
        ) == Kind {
            let Candidateˉname: bytes = Compilerˉsourceˉwvbˉsymbolˉname(
                Input, Scan, Symbols, Candidate
            );
            var Position: u32 = 0u32;
            var Insertˉat: u32 = Count;
            while Position < Count {
                if Insertˉat == Count {
                    let Existing: u32 = Bytesˉreadˉu32ˉlittle(
                        Ordered, Position * 4u32
                    );
                    let Existingˉname: bytes = Compilerˉsourceˉwvbˉsymbolˉname(
                        Input, Scan, Symbols, Existing
                    );
                    if Sourceˉset.Compilerˉsourceˉspansˉcompare(
                        Candidateˉname, 0u32, Bytesˉlength(Candidateˉname),
                        Existingˉname, 0u32, Bytesˉlength(Existingˉname)
                    ) < 0 { Insertˉat = Position; }
                }
                Position = Position + 1u32;
            }
            let Inserted: Byteˉconstruction.Foundationˉbytesˉresult = Byteˉconstruction.Foundationˉbytesˉreplace(
                Ordered,
                Insertˉat * 4u32,
                0u32,
                Bytesˉfromˉu32ˉlittle(Candidate)
            );
            Ordered = Inserted.Value;
            Count = Count + 1u32;
        }
        Candidate = Candidate + 1u32;
    }
    let Repeated: Byteˉconstruction.Foundationˉbytesˉresult = Byteˉconstruction.Foundationˉbytesˉrepeat(
        0u8, Entries * 4u32
    );
    var Ranks: bytes = Repeated.Value;
    var Rank: u32 = 0u32;
    while Rank < Count {
        let Entry: u32 = Bytesˉreadˉu32ˉlittle(Ordered, Rank * 4u32);
        let Replaced: Byteˉconstruction.Foundationˉbytesˉresult = Byteˉconstruction.Foundationˉbytesˉreplace(
            Ranks,
            Entry * 4u32,
            4u32,
            Bytesˉfromˉu32ˉlittle(Rank)
        );
        Ranks = Replaced.Value;
        Rank = Rank + 1u32;
    }
    return Compilerˉsourceˉwvbˉsymbolˉorder(Ordered, Ranks);
}

export fn Compilerˉsourceˉwvbˉbuildˉsymbolˉorders(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary
) -> Compilerˉsourceˉwvbˉsymbolˉorders {
    let Capabilities: Compilerˉsourceˉwvbˉsymbolˉorder =
        Compilerˉsourceˉwvbˉbuildˉsymbolˉorder(Input, Scan, Symbols, 2u32);
    let Data: Compilerˉsourceˉwvbˉsymbolˉorder =
        Compilerˉsourceˉwvbˉbuildˉsymbolˉorder(Input, Scan, Symbols, 3u32);
    let Records: Compilerˉsourceˉwvbˉsymbolˉorder =
        Compilerˉsourceˉwvbˉbuildˉsymbolˉorder(Input, Scan, Symbols, 4u32);
    let Enums: Compilerˉsourceˉwvbˉsymbolˉorder =
        Compilerˉsourceˉwvbˉbuildˉsymbolˉorder(Input, Scan, Symbols, 5u32);
    let Variants: Compilerˉsourceˉwvbˉsymbolˉorder =
        Compilerˉsourceˉwvbˉbuildˉsymbolˉorder(Input, Scan, Symbols, 8u32);
    let Functions: Compilerˉsourceˉwvbˉsymbolˉorder =
        Compilerˉsourceˉwvbˉbuildˉsymbolˉorder(Input, Scan, Symbols, 6u32);
    return Compilerˉsourceˉwvbˉsymbolˉorders(
        Capabilities.Entries, Capabilities.Ranks,
        Data.Entries, Data.Ranks,
        Records.Entries, Records.Ranks,
        Enums.Entries, Enums.Ranks,
        Variants.Entries, Variants.Ranks,
        Functions.Entries, Functions.Ranks
    );
}

export fn Compilerˉsourceˉwvbˉcapabilityˉorder(
    Orders: Compilerˉsourceˉwvbˉsymbolˉorders
) -> Compilerˉsourceˉwvbˉsymbolˉorder {
    return Compilerˉsourceˉwvbˉsymbolˉorder(
        Orders.Capabilityˉentries, Orders.Capabilityˉranks
    );
}

export fn Compilerˉsourceˉwvbˉdataˉorder(
    Orders: Compilerˉsourceˉwvbˉsymbolˉorders
) -> Compilerˉsourceˉwvbˉsymbolˉorder {
    return Compilerˉsourceˉwvbˉsymbolˉorder(
        Orders.Dataˉentries, Orders.Dataˉranks
    );
}

export fn Compilerˉsourceˉwvbˉrecordˉorder(
    Orders: Compilerˉsourceˉwvbˉsymbolˉorders
) -> Compilerˉsourceˉwvbˉsymbolˉorder {
    return Compilerˉsourceˉwvbˉsymbolˉorder(
        Orders.Recordˉentries, Orders.Recordˉranks
    );
}

export fn Compilerˉsourceˉwvbˉenumˉorder(
    Orders: Compilerˉsourceˉwvbˉsymbolˉorders
) -> Compilerˉsourceˉwvbˉsymbolˉorder {
    return Compilerˉsourceˉwvbˉsymbolˉorder(
        Orders.Enumˉentries, Orders.Enumˉranks
    );
}

export fn Compilerˉsourceˉwvbˉvariantˉorder(
    Orders: Compilerˉsourceˉwvbˉsymbolˉorders
) -> Compilerˉsourceˉwvbˉsymbolˉorder {
    return Compilerˉsourceˉwvbˉsymbolˉorder(
        Orders.Variantˉentries, Orders.Variantˉranks
    );
}

export fn Compilerˉsourceˉwvbˉfunctionˉorder(
    Orders: Compilerˉsourceˉwvbˉsymbolˉorders
) -> Compilerˉsourceˉwvbˉsymbolˉorder {
    return Compilerˉsourceˉwvbˉsymbolˉorder(
        Orders.Functionˉentries, Orders.Functionˉranks
    );
}

export fn Compilerˉsourceˉwvbˉreachableˉfunctionˉorder(
    Input: bytes,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Order: Compilerˉsourceˉwvbˉsymbolˉorder,
    Reachability: Compilerˉsourceˉwvbˉreachability
) -> Compilerˉsourceˉwvbˉsymbolˉorder {
    var Retainedˉentries: bytes = Compilerˉsourceˉwvbˉempty(Input);
    var Fullˉrank: u32 = 0u32;
    while Fullˉrank < Symbols.Functions {
        let Candidate: u32 = Compilerˉsourceˉwvbˉorderedˉsymbol(
            Order, Fullˉrank
        );
        if Bytesˉreadˉu8(Reachability.Map, Candidate) == 1u8 {
            Retainedˉentries = Bytesˉconcat(
                Retainedˉentries, Bytesˉfromˉu32ˉlittle(Candidate)
            );
        }
        Fullˉrank = Fullˉrank + 1u32;
    }
    let Entries: u32 = Bytesˉreadˉu32ˉlittle(Symbols.Directory, 8u32);
    let Emptyˉranks: Byteˉconstruction.Foundationˉbytesˉresult =
        Byteˉconstruction.Foundationˉbytesˉrepeat(0u8, Entries * 4u32);
    var Retainedˉranks: bytes = Emptyˉranks.Value;
    var Retainedˉrank: u32 = 0u32;
    while Retainedˉrank < Reachability.Reachable {
        let Retained: u32 = Bytesˉreadˉu32ˉlittle(
            Retainedˉentries, Retainedˉrank * 4u32
        );
        let Ranked: Byteˉconstruction.Foundationˉbytesˉresult =
            Byteˉconstruction.Foundationˉbytesˉreplace(
                Retainedˉranks,
                Retained * 4u32,
                4u32,
                Bytesˉfromˉu32ˉlittle(Retainedˉrank)
            );
        Retainedˉranks = Ranked.Value;
        Retainedˉrank = Retainedˉrank + 1u32;
    }
    return Compilerˉsourceˉwvbˉsymbolˉorder(
        Retainedˉentries, Retainedˉranks
    );
}

export fn Compilerˉsourceˉwvbˉwithˉfunctionˉorder(
    Orders: Compilerˉsourceˉwvbˉsymbolˉorders,
    Functions: Compilerˉsourceˉwvbˉsymbolˉorder
) -> Compilerˉsourceˉwvbˉsymbolˉorders {
    return Compilerˉsourceˉwvbˉsymbolˉorders(
        Orders.Capabilityˉentries,
        Orders.Capabilityˉranks,
        Orders.Dataˉentries,
        Orders.Dataˉranks,
        Orders.Recordˉentries,
        Orders.Recordˉranks,
        Orders.Enumˉentries,
        Orders.Enumˉranks,
        Orders.Variantˉentries,
        Orders.Variantˉranks,
        Functions.Entries,
        Functions.Ranks
    );
}

export fn Compilerˉsourceˉwvbˉreachableˉdataˉorder(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Functions: Compilerˉsourceˉwvbˉsymbolˉorder,
    Functionˉcount: u32,
    Data: Compilerˉsourceˉwvbˉsymbolˉorder,
    Wir: bytes
) -> Compilerˉsourceˉwvbˉsymbolˉorder {
    let Entries: u32 = Bytesˉreadˉu32ˉlittle(Symbols.Directory, 8u32);
    let Emptyˉmap: Byteˉconstruction.Foundationˉbytesˉresult =
        Byteˉconstruction.Foundationˉbytesˉrepeat(0u8, Entries);
    var Dataˉmap: bytes = Emptyˉmap.Value;
    let Operationsˉoffset: u32 = Compilerˉsourceˉwvbˉoperationsˉoffset(Wir);
    var Functionˉrank: u32 = 0u32;
    while Functionˉrank < Functionˉcount {
        let Function: u32 = Compilerˉsourceˉwvbˉorderedˉsymbol(
            Functions, Functionˉrank
        );
        let Functionˉview: Sourceˉset.Compilerˉsourceˉsetˉview =
            Compilerˉsourceˉwvbˉsymbolˉsource(
                Input, Scan, Symbols, Function
            );
        let Functionˉentry: u32 = 48u32 + Function * 48u32;
        let Firstˉoperation: u32 = Bytesˉreadˉu32ˉlittle(
            Wir, Functionˉentry + 12u32
        );
        let Operationˉcount: u32 = Bytesˉreadˉu32ˉlittle(
            Wir, Functionˉentry + 16u32
        );
        var Inˉfunction: u32 = 0u32;
        while Inˉfunction < Operationˉcount {
            let Operationˉentry: u32 = Operationsˉoffset +
                (Firstˉoperation + Inˉfunction) * 48u32;
            let Operation: u32 = Bytesˉreadˉu32ˉlittle(
                Wir, Operationˉentry + 12u32
            );
            let Target: u32 = Bytesˉreadˉu32ˉlittle(
                Wir, Operationˉentry + 32u32
            );
            var Referenced: u32 = Sourceˉwir.Compilerˉsourceˉwirˉsentinel();
            if Operation == 6u32 || Operation == 9u32 || Operation == 10u32 {
                Referenced = Target;
            }
            if Operation == 5u32 {
                let Textˉlength: u32 = Bytesˉreadˉu32ˉlittle(
                    Wir, Operationˉentry + 36u32
                );
                if Textˉlength == 0u32 {
                    Referenced = Target;
                } else {
                    let Textˉvalue: Compilerˉsourceˉwvbˉtextˉvalue =
                        Compilerˉsourceˉwvbˉdecodeˉtext(
                            Functionˉview.Source, Target, Textˉlength
                        );
                    Referenced = Compilerˉsourceˉwvbˉexplicitˉtextˉentry(
                        Input, Scan, Symbols, Textˉvalue.Value
                    );
                }
            }
            if Referenced != Sourceˉwir.Compilerˉsourceˉwirˉsentinel() {
                if Bytesˉreadˉu8(Dataˉmap, Referenced) == 0u8 {
                    let Marked: Byteˉconstruction.Foundationˉbytesˉresult =
                        Byteˉconstruction.Foundationˉbytesˉreplace(
                            Dataˉmap, Referenced,
                            1u32, Bytesˉfromˉu8(1u8)
                        );
                    Dataˉmap = Marked.Value;
                }
            }
            Inˉfunction = Inˉfunction + 1u32;
        }
        Functionˉrank = Functionˉrank + 1u32;
    }

    var Retainedˉentries: bytes = Compilerˉsourceˉwvbˉempty(Input);
    var Dataˉrank: u32 = 0u32;
    while Dataˉrank < Symbols.Data {
        let Candidate: u32 = Compilerˉsourceˉwvbˉorderedˉsymbol(
            Data, Dataˉrank
        );
        if Bytesˉreadˉu8(Dataˉmap, Candidate) == 1u8 {
            Retainedˉentries = Bytesˉconcat(
                Retainedˉentries, Bytesˉfromˉu32ˉlittle(Candidate)
            );
        }
        Dataˉrank = Dataˉrank + 1u32;
    }
    let Emptyˉranks: Byteˉconstruction.Foundationˉbytesˉresult =
        Byteˉconstruction.Foundationˉbytesˉrepeat(0u8, Entries * 4u32);
    var Retainedˉranks: bytes = Emptyˉranks.Value;
    var Retainedˉrank: u32 = 0u32;
    while Retainedˉrank * 4u32 < Bytesˉlength(Retainedˉentries) {
        let Retained: u32 = Bytesˉreadˉu32ˉlittle(
            Retainedˉentries, Retainedˉrank * 4u32
        );
        let Ranked: Byteˉconstruction.Foundationˉbytesˉresult =
            Byteˉconstruction.Foundationˉbytesˉreplace(
                Retainedˉranks,
                Retained * 4u32,
                4u32,
                Bytesˉfromˉu32ˉlittle(Retainedˉrank)
            );
        Retainedˉranks = Ranked.Value;
        Retainedˉrank = Retainedˉrank + 1u32;
    }
    return Compilerˉsourceˉwvbˉsymbolˉorder(
        Retainedˉentries, Retainedˉranks
    );
}

export fn Compilerˉsourceˉwvbˉwithˉdataˉorder(
    Orders: Compilerˉsourceˉwvbˉsymbolˉorders,
    Data: Compilerˉsourceˉwvbˉsymbolˉorder
) -> Compilerˉsourceˉwvbˉsymbolˉorders {
    return Compilerˉsourceˉwvbˉsymbolˉorders(
        Orders.Capabilityˉentries,
        Orders.Capabilityˉranks,
        Data.Entries,
        Data.Ranks,
        Orders.Recordˉentries,
        Orders.Recordˉranks,
        Orders.Enumˉentries,
        Orders.Enumˉranks,
        Orders.Variantˉentries,
        Orders.Variantˉranks,
        Orders.Functionˉentries,
        Orders.Functionˉranks
    );
}

export fn Compilerˉsourceˉwvbˉorderedˉsymbol(
    Order: Compilerˉsourceˉwvbˉsymbolˉorder,
    Rank: u32
) -> u32 {
    return Bytesˉreadˉu32ˉlittle(Order.Entries, Rank * 4u32);
}

export fn Compilerˉsourceˉwvbˉorderedˉrank(
    Order: Compilerˉsourceˉwvbˉsymbolˉorder,
    Entry: u32
) -> u32 {
    return Bytesˉreadˉu32ˉlittle(Order.Ranks, Entry * 4u32);
}

export fn Compilerˉsourceˉwvbˉdeclaration(
    Source: bytes,
    Header: Sourceˉdeclarations.Compilerˉsourceˉheader,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Entry: u32
) -> Sourceˉdeclarations.Compilerˉsourceˉdeclaration {
    let Entryˉoffset: u32 = 16u32 + Entry * 24u32;
    let Declarationˉoffset: u32 = Bytesˉreadˉu32ˉlittle(
        Symbols.Directory, Entryˉoffset + 8u32
    );
    return Sourceˉdeclarations.Compilerˉparseˉnextˉdeclarationˉvalidated(
        Source, Declarationˉoffset, 1u32, 1u32, true
    );
}

export fn Compilerˉsourceˉwvbˉdataˉtype(
    Source: bytes,
    Declaration: Sourceˉdeclarations.Compilerˉsourceˉdeclaration
) -> Sourceˉdeclarations.Compilerˉsourceˉtypeˉkind {
    let Name: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
        Source, Declaration.Nameˉoffset, 1u32, 1u32
    );
    let Colon: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
        Source, Name.Nextˉoffset, Name.Nextˉline, Name.Nextˉcolumn
    );
    let Type: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
        Source, Colon.Nextˉoffset, Colon.Nextˉline, Colon.Nextˉcolumn
    );
    if Type.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Text {
        return Sourceˉdeclarations.Compilerˉsourceˉtypeˉkind.Text;
    }
    if Type.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Bytes {
        return Sourceˉdeclarations.Compilerˉsourceˉtypeˉkind.Bytes;
    }
    return Sourceˉdeclarations.Compilerˉsourceˉtypeˉkind.I32ˉarray;
}

export fn Compilerˉsourceˉwvbˉlowˉbyte(Value: u32) -> bytes {
    return Bytesˉslice(Bytesˉfromˉu32ˉlittle(Value), 0u32, 1u32);
}

export fn Compilerˉsourceˉwvbˉdivideˉsixtyˉfour(Value: u32) -> Compilerˉsourceˉwvbˉdivision {
    var Quotient: u32 = 0u32;
    var Remainder: u32 = Value;
    if Remainder >= 1048576u32 { Remainder = Remainder - 1048576u32; Quotient = Quotient + 16384u32; }
    if Remainder >= 524288u32 { Remainder = Remainder - 524288u32; Quotient = Quotient + 8192u32; }
    if Remainder >= 262144u32 { Remainder = Remainder - 262144u32; Quotient = Quotient + 4096u32; }
    if Remainder >= 131072u32 { Remainder = Remainder - 131072u32; Quotient = Quotient + 2048u32; }
    if Remainder >= 65536u32 { Remainder = Remainder - 65536u32; Quotient = Quotient + 1024u32; }
    if Remainder >= 32768u32 { Remainder = Remainder - 32768u32; Quotient = Quotient + 512u32; }
    if Remainder >= 16384u32 { Remainder = Remainder - 16384u32; Quotient = Quotient + 256u32; }
    if Remainder >= 8192u32 { Remainder = Remainder - 8192u32; Quotient = Quotient + 128u32; }
    if Remainder >= 4096u32 { Remainder = Remainder - 4096u32; Quotient = Quotient + 64u32; }
    if Remainder >= 2048u32 { Remainder = Remainder - 2048u32; Quotient = Quotient + 32u32; }
    if Remainder >= 1024u32 { Remainder = Remainder - 1024u32; Quotient = Quotient + 16u32; }
    if Remainder >= 512u32 { Remainder = Remainder - 512u32; Quotient = Quotient + 8u32; }
    if Remainder >= 256u32 { Remainder = Remainder - 256u32; Quotient = Quotient + 4u32; }
    if Remainder >= 128u32 { Remainder = Remainder - 128u32; Quotient = Quotient + 2u32; }
    if Remainder >= 64u32 { Remainder = Remainder - 64u32; Quotient = Quotient + 1u32; }
    return Compilerˉsourceˉwvbˉdivision(Quotient, Remainder);
}

export fn Compilerˉsourceˉwvbˉutf8(Codeˉpoint: u32) -> bytes {
    if Codeˉpoint <= 127u32 {
        return Compilerˉsourceˉwvbˉlowˉbyte(Codeˉpoint);
    }
    let First: Compilerˉsourceˉwvbˉdivision =
        Compilerˉsourceˉwvbˉdivideˉsixtyˉfour(Codeˉpoint);
    if Codeˉpoint <= 2047u32 {
        return Bytesˉconcat(
            Compilerˉsourceˉwvbˉlowˉbyte(192u32 + First.Quotient),
            Compilerˉsourceˉwvbˉlowˉbyte(128u32 + First.Remainder)
        );
    }
    let Second: Compilerˉsourceˉwvbˉdivision =
        Compilerˉsourceˉwvbˉdivideˉsixtyˉfour(First.Quotient);
    if Codeˉpoint <= 65535u32 {
        var Threeˉbyteˉresult: bytes = Compilerˉsourceˉwvbˉlowˉbyte(
            224u32 + Second.Quotient
        );
        Threeˉbyteˉresult = Bytesˉconcat(
            Threeˉbyteˉresult,
            Compilerˉsourceˉwvbˉlowˉbyte(128u32 + Second.Remainder)
        );
        return Bytesˉconcat(
            Threeˉbyteˉresult,
            Compilerˉsourceˉwvbˉlowˉbyte(128u32 + First.Remainder)
        );
    }
    let Third: Compilerˉsourceˉwvbˉdivision =
        Compilerˉsourceˉwvbˉdivideˉsixtyˉfour(Second.Quotient);
    var Fourˉbyteˉresult: bytes = Compilerˉsourceˉwvbˉlowˉbyte(
        240u32 + Third.Quotient
    );
    Fourˉbyteˉresult = Bytesˉconcat(
        Fourˉbyteˉresult,
        Compilerˉsourceˉwvbˉlowˉbyte(128u32 + Third.Remainder)
    );
    Fourˉbyteˉresult = Bytesˉconcat(
        Fourˉbyteˉresult,
        Compilerˉsourceˉwvbˉlowˉbyte(128u32 + Second.Remainder)
    );
    return Bytesˉconcat(
        Fourˉbyteˉresult,
        Compilerˉsourceˉwvbˉlowˉbyte(128u32 + First.Remainder)
    );
}

export fn Compilerˉsourceˉwvbˉdecodeˉtext(
    Source: bytes,
    Offset: u32,
    Length: u32
) -> Compilerˉsourceˉwvbˉtextˉvalue {
    let Empty: bytes = Compilerˉsourceˉwvbˉempty(Source);
    if Length < 2u32 {
        return Compilerˉsourceˉwvbˉtextˉvalue(
            Compilerˉsourceˉwvbˉstatus.Invalidˉdata, Empty
        );
    }
    if Offset > Bytesˉlength(Source) {
        return Compilerˉsourceˉwvbˉtextˉvalue(
            Compilerˉsourceˉwvbˉstatus.Invalidˉdata, Empty
        );
    }
    if Length > Bytesˉlength(Source) - Offset {
        return Compilerˉsourceˉwvbˉtextˉvalue(
            Compilerˉsourceˉwvbˉstatus.Invalidˉdata, Empty
        );
    }
    if Bytesˉreadˉu8(Source, Offset) != 34u8 {
        return Compilerˉsourceˉwvbˉtextˉvalue(
            Compilerˉsourceˉwvbˉstatus.Invalidˉdata, Empty
        );
    }
    let End: u32 = Offset + Length - 1u32;
    if Bytesˉreadˉu8(Source, End) != 34u8 {
        return Compilerˉsourceˉwvbˉtextˉvalue(
            Compilerˉsourceˉwvbˉstatus.Invalidˉdata, Empty
        );
    }
    var Result: bytes = Empty;
    var Cursor: u32 = Offset + 1u32;
    var Segment: u32 = Cursor;
    while Cursor < End {
        if Bytesˉreadˉu8(Source, Cursor) == 92u8 {
            Result = Bytesˉconcat(
                Result, Bytesˉslice(Source, Segment, Cursor - Segment)
            );
            if Cursor + 1u32 >= End {
                return Compilerˉsourceˉwvbˉtextˉvalue(
                    Compilerˉsourceˉwvbˉstatus.Invalidˉdata, Empty
                );
            }
            let Escape: u8 = Bytesˉreadˉu8(Source, Cursor + 1u32);
            var Recognized: bool = false;
            if Escape == 34u8 { Result = Bytesˉconcat(Result, Compilerˉsourceˉwvbˉlowˉbyte(34u32)); Cursor = Cursor + 2u32; Recognized = true; }
            if Escape == 92u8 { Result = Bytesˉconcat(Result, Compilerˉsourceˉwvbˉlowˉbyte(92u32)); Cursor = Cursor + 2u32; Recognized = true; }
            if Escape == 110u8 { Result = Bytesˉconcat(Result, Compilerˉsourceˉwvbˉlowˉbyte(10u32)); Cursor = Cursor + 2u32; Recognized = true; }
            if Escape == 114u8 { Result = Bytesˉconcat(Result, Compilerˉsourceˉwvbˉlowˉbyte(13u32)); Cursor = Cursor + 2u32; Recognized = true; }
            if Escape == 116u8 { Result = Bytesˉconcat(Result, Compilerˉsourceˉwvbˉlowˉbyte(9u32)); Cursor = Cursor + 2u32; Recognized = true; }
            if Escape == 117u8 {
                Recognized = true;
                if Cursor + 6u32 > End {
                    return Compilerˉsourceˉwvbˉtextˉvalue(
                        Compilerˉsourceˉwvbˉstatus.Invalidˉdata, Empty
                    );
                }
                let H0: u32 = Sourceˉlexer.Compilerˉsourceˉhexˉdigit(Bytesˉreadˉu8(Source, Cursor + 2u32));
                let H1: u32 = Sourceˉlexer.Compilerˉsourceˉhexˉdigit(Bytesˉreadˉu8(Source, Cursor + 3u32));
                let H2: u32 = Sourceˉlexer.Compilerˉsourceˉhexˉdigit(Bytesˉreadˉu8(Source, Cursor + 4u32));
                let H3: u32 = Sourceˉlexer.Compilerˉsourceˉhexˉdigit(Bytesˉreadˉu8(Source, Cursor + 5u32));
                var Highˉdigitsˉvalid: bool = H0 <= 15u32;
                if H1 > 15u32 { Highˉdigitsˉvalid = false; }
                if H2 > 15u32 { Highˉdigitsˉvalid = false; }
                if H3 > 15u32 { Highˉdigitsˉvalid = false; }
                if !Highˉdigitsˉvalid {
                    return Compilerˉsourceˉwvbˉtextˉvalue(
                        Compilerˉsourceˉwvbˉstatus.Invalidˉdata, Empty
                    );
                }
                var Codeˉpoint: u32 = H0 * 4096u32 + H1 * 256u32 + H2 * 16u32 + H3;
                Cursor = Cursor + 6u32;
                if Codeˉpoint >= 55296u32 {
                    if Codeˉpoint <= 56319u32 {
                        if Cursor + 6u32 > End {
                            return Compilerˉsourceˉwvbˉtextˉvalue(
                                Compilerˉsourceˉwvbˉstatus.Invalidˉdata, Empty
                            );
                        }
                        let L0: u32 = Sourceˉlexer.Compilerˉsourceˉhexˉdigit(Bytesˉreadˉu8(Source, Cursor + 2u32));
                        let L1: u32 = Sourceˉlexer.Compilerˉsourceˉhexˉdigit(Bytesˉreadˉu8(Source, Cursor + 3u32));
                        let L2: u32 = Sourceˉlexer.Compilerˉsourceˉhexˉdigit(Bytesˉreadˉu8(Source, Cursor + 4u32));
                        let L3: u32 = Sourceˉlexer.Compilerˉsourceˉhexˉdigit(Bytesˉreadˉu8(Source, Cursor + 5u32));
                        var Lowˉdigitsˉvalid: bool = L0 <= 15u32;
                        if L1 > 15u32 { Lowˉdigitsˉvalid = false; }
                        if L2 > 15u32 { Lowˉdigitsˉvalid = false; }
                        if L3 > 15u32 { Lowˉdigitsˉvalid = false; }
                        if !Lowˉdigitsˉvalid {
                            return Compilerˉsourceˉwvbˉtextˉvalue(
                                Compilerˉsourceˉwvbˉstatus.Invalidˉdata, Empty
                            );
                        }
                        let Low: u32 = L0 * 4096u32 + L1 * 256u32 + L2 * 16u32 + L3;
                        if Bytesˉreadˉu8(Source, Cursor) != 92u8 {
                            return Compilerˉsourceˉwvbˉtextˉvalue(
                                Compilerˉsourceˉwvbˉstatus.Invalidˉdata, Empty
                            );
                        }
                        if Bytesˉreadˉu8(Source, Cursor + 1u32) != 117u8 {
                            return Compilerˉsourceˉwvbˉtextˉvalue(
                                Compilerˉsourceˉwvbˉstatus.Invalidˉdata, Empty
                            );
                        }
                        if Low < 56320u32 {
                            return Compilerˉsourceˉwvbˉtextˉvalue(
                                Compilerˉsourceˉwvbˉstatus.Invalidˉdata, Empty
                            );
                        }
                        if Low > 57343u32 {
                            return Compilerˉsourceˉwvbˉtextˉvalue(
                                Compilerˉsourceˉwvbˉstatus.Invalidˉdata, Empty
                            );
                        }
                        Codeˉpoint = 65536u32 +
                            (Codeˉpoint - 55296u32) * 1024u32 +
                            (Low - 56320u32);
                        Cursor = Cursor + 6u32;
                    }
                }
                if Codeˉpoint >= 56320u32 {
                    if Codeˉpoint <= 57343u32 {
                        return Compilerˉsourceˉwvbˉtextˉvalue(
                            Compilerˉsourceˉwvbˉstatus.Invalidˉdata, Empty
                        );
                    }
                }
                Result = Bytesˉconcat(Result, Compilerˉsourceˉwvbˉutf8(Codeˉpoint));
            }
            if !Recognized {
                return Compilerˉsourceˉwvbˉtextˉvalue(
                    Compilerˉsourceˉwvbˉstatus.Invalidˉdata, Empty
                );
            }
            Segment = Cursor;
        } else {
            Cursor = Cursor + 1u32;
        }
    }
    Result = Bytesˉconcat(Result, Bytesˉslice(Source, Segment, End - Segment));
    if Bytesˉlength(Result) > 1048576u32 {
        return Compilerˉsourceˉwvbˉtextˉvalue(
            Compilerˉsourceˉwvbˉstatus.Bytecodeˉlimit, Empty
        );
    }
    return Compilerˉsourceˉwvbˉtextˉvalue(
        Compilerˉsourceˉwvbˉstatus.Valid, Result
    );
}

export fn Compilerˉsourceˉwvbˉtakeˉdigit(
    Value: u32,
    Place: u32
) -> Compilerˉsourceˉwvbˉdigit {
    var Digit: u32 = 0u32;
    var Remainder: u32 = Value;
    while Remainder >= Place {
        Remainder = Remainder - Place;
        Digit = Digit + 1u32;
    }
    return Compilerˉsourceˉwvbˉdigit(Digit, Remainder);
}

export fn Compilerˉsourceˉwvbˉsyntheticˉname(Counter: u32) -> bytes {
    var Result: bytes = Textˉtoˉutf8("__Text_");
    let D5: Compilerˉsourceˉwvbˉdigit = Compilerˉsourceˉwvbˉtakeˉdigit(Counter, 100000u32);
    Result = Bytesˉconcat(Result, Compilerˉsourceˉwvbˉlowˉbyte(48u32 + D5.Value));
    let D4: Compilerˉsourceˉwvbˉdigit = Compilerˉsourceˉwvbˉtakeˉdigit(D5.Remainder, 10000u32);
    Result = Bytesˉconcat(Result, Compilerˉsourceˉwvbˉlowˉbyte(48u32 + D4.Value));
    let D3: Compilerˉsourceˉwvbˉdigit = Compilerˉsourceˉwvbˉtakeˉdigit(D4.Remainder, 1000u32);
    Result = Bytesˉconcat(Result, Compilerˉsourceˉwvbˉlowˉbyte(48u32 + D3.Value));
    let D2: Compilerˉsourceˉwvbˉdigit = Compilerˉsourceˉwvbˉtakeˉdigit(D3.Remainder, 100u32);
    Result = Bytesˉconcat(Result, Compilerˉsourceˉwvbˉlowˉbyte(48u32 + D2.Value));
    let D1: Compilerˉsourceˉwvbˉdigit = Compilerˉsourceˉwvbˉtakeˉdigit(D2.Remainder, 10u32);
    Result = Bytesˉconcat(Result, Compilerˉsourceˉwvbˉlowˉbyte(48u32 + D1.Value));
    return Bytesˉconcat(
        Result, Compilerˉsourceˉwvbˉlowˉbyte(48u32 + D1.Remainder)
    );
}

export fn Compilerˉsourceˉwvbˉdataˉnameˉexists(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Name: bytes
) -> bool {
    let Entries: u32 = Bytesˉreadˉu32ˉlittle(Symbols.Directory, 8u32);
    var Entry: u32 = 0u32;
    while Entry < Entries {
        let Entryˉoffset: u32 = 16u32 + Entry * 24u32;
        if Bytesˉreadˉu32ˉlittle(Symbols.Directory, Entryˉoffset + 4u32) == 3u32 {
            let Symbolˉname: bytes = Compilerˉsourceˉwvbˉsymbolˉname(
                Input, Scan, Symbols, Entry
            );
            if Sourceˉset.Compilerˉsourceˉspansˉequal(
                Symbolˉname, 0u32, Bytesˉlength(Symbolˉname),
                Name, 0u32, Bytesˉlength(Name)
            ) { return true; }
        }
        Entry = Entry + 1u32;
    }
    return false;
}

export fn Compilerˉsourceˉwvbˉexplicitˉtextˉentry(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Value: bytes
) -> u32 {
    let Entries: u32 = Bytesˉreadˉu32ˉlittle(Symbols.Directory, 8u32);
    var Entry: u32 = 0u32;
    while Entry < Entries {
        let Entryˉoffset: u32 = 16u32 + Entry * 24u32;
        if Bytesˉreadˉu32ˉlittle(Symbols.Directory, Entryˉoffset + 4u32) == 3u32 {
            let View: Sourceˉset.Compilerˉsourceˉsetˉview =
                Compilerˉsourceˉwvbˉsymbolˉsource(
                    Input, Scan, Symbols, Entry
                );
            let Header: Sourceˉdeclarations.Compilerˉsourceˉheader = Sourceˉdeclarations.Compilerˉparseˉheaderˉvalidated(
                View.Source
            );
            let Declaration: Sourceˉdeclarations.Compilerˉsourceˉdeclaration =
                Compilerˉsourceˉwvbˉdeclaration(
                    View.Source, Header, Symbols, Entry
                );
            if Compilerˉsourceˉwvbˉdataˉtype(
                View.Source, Declaration
            ) == Sourceˉdeclarations.Compilerˉsourceˉtypeˉkind.Text {
                let Decoded: Compilerˉsourceˉwvbˉtextˉvalue =
                    Compilerˉsourceˉwvbˉdecodeˉtext(
                        View.Source,
                        Declaration.Bodyˉoffset, Declaration.Bodyˉlength
                    );
                if Decoded.Status == Compilerˉsourceˉwvbˉstatus.Valid {
                    if Sourceˉset.Compilerˉsourceˉspansˉequal(
                        Decoded.Value, 0u32, Bytesˉlength(Decoded.Value),
                        Value, 0u32, Bytesˉlength(Value)
                    ) { return Entry; }
                }
            }
        }
        Entry = Entry + 1u32;
    }
    return Sourceˉwir.Compilerˉsourceˉwirˉsentinel();
}

export fn Compilerˉsourceˉwvbˉtextˉplanˉempty(
    Input: bytes
) -> Compilerˉsourceˉwvbˉtextˉplan {
    let Empty: bytes = Compilerˉsourceˉwvbˉempty(Input);
    return Compilerˉsourceˉwvbˉtextˉplan(
        Compilerˉsourceˉwvbˉstatus.Valid, 0u32, 0u32, Empty, Empty
    );
}

export fn Compilerˉsourceˉwvbˉtextˉplanˉfind(
    Plan: Compilerˉsourceˉwvbˉtextˉplan,
    Value: bytes
) -> u32 {
    var Index: u32 = 0u32;
    while Index < Plan.Count {
        let Entry: u32 = Index * 12u32;
        let Offset: u32 = Bytesˉreadˉu32ˉlittle(Plan.Directory, Entry + 4u32);
        let Length: u32 = Bytesˉreadˉu32ˉlittle(Plan.Directory, Entry + 8u32);
        if Sourceˉset.Compilerˉsourceˉspansˉequal(
            Plan.Values, Offset, Length,
            Value, 0u32, Bytesˉlength(Value)
        ) { return Index; }
        Index = Index + 1u32;
    }
    return Sourceˉwir.Compilerˉsourceˉwirˉsentinel();
}

export fn Compilerˉsourceˉwvbˉtextˉplanˉadd(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Plan: Compilerˉsourceˉwvbˉtextˉplan,
    Value: bytes
) -> Compilerˉsourceˉwvbˉtextˉplan {
    if Plan.Count + Symbols.Data >= 4096u32 {
        return Compilerˉsourceˉwvbˉtextˉplan(
            Compilerˉsourceˉwvbˉstatus.Bytecodeˉlimit,
            Plan.Count, Plan.Nextˉname, Plan.Directory, Plan.Values
        );
    }
    var Counter: u32 = Plan.Nextˉname;
    var Name: bytes = Compilerˉsourceˉwvbˉsyntheticˉname(Counter);
    while Compilerˉsourceˉwvbˉdataˉnameˉexists(
        Input, Scan, Symbols, Name
    ) {
        Counter = Counter + 1u32;
        if Counter > 999999u32 {
            return Compilerˉsourceˉwvbˉtextˉplan(
                Compilerˉsourceˉwvbˉstatus.Bytecodeˉlimit,
                Plan.Count, Counter, Plan.Directory, Plan.Values
            );
        }
        Name = Compilerˉsourceˉwvbˉsyntheticˉname(Counter);
    }
    var Entry: bytes = Bytesˉfromˉu32ˉlittle(Counter);
    Entry = Bytesˉconcat(
        Entry, Bytesˉfromˉu32ˉlittle(Bytesˉlength(Plan.Values))
    );
    Entry = Bytesˉconcat(
        Entry, Bytesˉfromˉu32ˉlittle(Bytesˉlength(Value))
    );
    return Compilerˉsourceˉwvbˉtextˉplan(
        Compilerˉsourceˉwvbˉstatus.Valid,
        Plan.Count + 1u32,
        Counter + 1u32,
        Bytesˉconcat(Plan.Directory, Entry),
        Bytesˉconcat(Plan.Values, Value)
    );
}

export fn Compilerˉsourceˉwvbˉcollectˉtextˉplan(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Order: Compilerˉsourceˉwvbˉsymbolˉorder,
    Functions: u32,
    Wir: bytes
) -> Compilerˉsourceˉwvbˉtextˉplan {
    var Plan: Compilerˉsourceˉwvbˉtextˉplan =
        Compilerˉsourceˉwvbˉtextˉplanˉempty(Input);
    let Operationsˉoffset: u32 = Compilerˉsourceˉwvbˉoperationsˉoffset(Wir);
    var Rank: u32 = 0u32;
    while Rank < Functions {
        let Function: u32 = Compilerˉsourceˉwvbˉorderedˉsymbol(Order, Rank);
        let View: Sourceˉset.Compilerˉsourceˉsetˉview = Compilerˉsourceˉwvbˉsymbolˉsource(
            Input, Scan, Symbols, Function
        );
        let Functionˉentry: u32 = 48u32 + Function * 48u32;
        let Firstˉoperation: u32 = Bytesˉreadˉu32ˉlittle(
            Wir, Functionˉentry + 12u32
        );
        let Operationˉcount: u32 = Bytesˉreadˉu32ˉlittle(
            Wir, Functionˉentry + 16u32
        );
        var Index: u32 = 0u32;
        while Index < Operationˉcount {
            let Operationˉentry: u32 = Operationsˉoffset +
                (Firstˉoperation + Index) * 48u32;
            if Bytesˉreadˉu32ˉlittle(Wir, Operationˉentry + 12u32) == 5u32 {
                let Length: u32 = Bytesˉreadˉu32ˉlittle(
                    Wir, Operationˉentry + 36u32
                );
                if Length != 0u32 {
                    let Offset: u32 = Bytesˉreadˉu32ˉlittle(
                        Wir, Operationˉentry + 32u32
                    );
                    let Decoded: Compilerˉsourceˉwvbˉtextˉvalue =
                        Compilerˉsourceˉwvbˉdecodeˉtext(
                            View.Source, Offset, Length
                        );
                    if Decoded.Status != Compilerˉsourceˉwvbˉstatus.Valid {
                        return Compilerˉsourceˉwvbˉtextˉplan(
                            Decoded.Status, Plan.Count, Plan.Nextˉname,
                            Plan.Directory, Plan.Values
                        );
                    }
                    let Explicit: u32 = Compilerˉsourceˉwvbˉexplicitˉtextˉentry(
                        Input, Scan, Symbols, Decoded.Value
                    );
                    if Explicit == Sourceˉwir.Compilerˉsourceˉwirˉsentinel() {
                        if Compilerˉsourceˉwvbˉtextˉplanˉfind(
                            Plan, Decoded.Value
                        ) == Sourceˉwir.Compilerˉsourceˉwirˉsentinel() {
                            Plan = Compilerˉsourceˉwvbˉtextˉplanˉadd(
                                Input, Scan, Symbols, Plan, Decoded.Value
                            );
                            if Plan.Status != Compilerˉsourceˉwvbˉstatus.Valid {
                                return Plan;
                            }
                        }
                    }
                }
            }
            Index = Index + 1u32;
        }
        Rank = Rank + 1u32;
    }
    return Plan;
}

export fn Compilerˉsourceˉwvbˉexplicitˉdataˉindex(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Plan: Compilerˉsourceˉwvbˉtextˉplan,
    Order: Compilerˉsourceˉwvbˉsymbolˉorder,
    Entry: u32
) -> u32 {
    var Result: u32 = Compilerˉsourceˉwvbˉorderedˉrank(Order, Entry);
    let Entryˉoffset: u32 = 16u32 + Entry * 24u32;
    let Nameˉoffset: u32 = Bytesˉreadˉu32ˉlittle(
        Symbols.Directory, Entryˉoffset + 12u32
    );
    let Nameˉlength: u32 = Bytesˉreadˉu32ˉlittle(
        Symbols.Directory, Entryˉoffset + 16u32
    );
    let View: Sourceˉset.Compilerˉsourceˉsetˉview = Compilerˉsourceˉwvbˉsymbolˉsource(
        Input, Scan, Symbols, Entry
    );
    let Symbolˉname: bytes = Compilerˉsourceˉwvbˉsymbolˉname(
        Input, Scan, Symbols, Entry
    );
    var Synthetic: u32 = 0u32;
    while Synthetic < Plan.Count {
        let Name: bytes = Compilerˉsourceˉwvbˉsyntheticˉname(
            Bytesˉreadˉu32ˉlittle(Plan.Directory, Synthetic * 12u32)
        );
        if Sourceˉset.Compilerˉsourceˉspansˉcompare(
            Name, 0u32, Bytesˉlength(Name),
            Symbolˉname, 0u32, Bytesˉlength(Symbolˉname)
        ) < 0 { Result = Result + 1u32; }
        Synthetic = Synthetic + 1u32;
    }
    return Result;
}

export fn Compilerˉsourceˉwvbˉsyntheticˉdataˉindex(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Plan: Compilerˉsourceˉwvbˉtextˉplan,
    Order: Compilerˉsourceˉwvbˉsymbolˉorder,
    Synthetic: u32
) -> u32 {
    let Name: bytes = Compilerˉsourceˉwvbˉsyntheticˉname(
        Bytesˉreadˉu32ˉlittle(Plan.Directory, Synthetic * 12u32)
    );
    var Result: u32 = Synthetic;
    let Explicitˉcount: u32 = Bytesˉlength(Order.Entries) / 4u32;
    var Rank: u32 = 0u32;
    while Rank < Explicitˉcount {
        let Entry: u32 = Compilerˉsourceˉwvbˉorderedˉsymbol(Order, Rank);
        let Entryˉoffset: u32 = 16u32 + Entry * 24u32;
        let Nameˉoffset: u32 = Bytesˉreadˉu32ˉlittle(
            Symbols.Directory, Entryˉoffset + 12u32
        );
        let Nameˉlength: u32 = Bytesˉreadˉu32ˉlittle(
            Symbols.Directory, Entryˉoffset + 16u32
        );
        let View: Sourceˉset.Compilerˉsourceˉsetˉview =
            Compilerˉsourceˉwvbˉsymbolˉsource(
                Input, Scan, Symbols, Entry
            );
        let Symbolˉname: bytes = Compilerˉsourceˉwvbˉsymbolˉname(
            Input, Scan, Symbols, Entry
        );
        if Sourceˉset.Compilerˉsourceˉspansˉcompare(
            Symbolˉname, 0u32, Bytesˉlength(Symbolˉname),
            Name, 0u32, Bytesˉlength(Name)
        ) < 0 { Result = Result + 1u32; }
        Rank = Rank + 1u32;
    }
    return Result;
}

export fn Compilerˉsourceˉwvbˉencodeˉexplicitˉdata(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Source: bytes,
    Header: Sourceˉdeclarations.Compilerˉsourceˉheader,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Entry: u32
) -> Compilerˉsourceˉwvbˉdataˉencoding {
    let Empty: bytes = Compilerˉsourceˉwvbˉempty(Source);
    let Declaration: Sourceˉdeclarations.Compilerˉsourceˉdeclaration =
        Compilerˉsourceˉwvbˉdeclaration(Source, Header, Symbols, Entry);
    let Type: Sourceˉdeclarations.Compilerˉsourceˉtypeˉkind = Compilerˉsourceˉwvbˉdataˉtype(
        Source, Declaration
    );
    var Payload: bytes = Compilerˉsourceˉwvbˉencodedˉstring(
        Compilerˉsourceˉwvbˉsymbolˉname(Input, Scan, Symbols, Entry)
    );
    if Type == Sourceˉdeclarations.Compilerˉsourceˉtypeˉkind.Text {
        let Decoded: Compilerˉsourceˉwvbˉtextˉvalue =
            Compilerˉsourceˉwvbˉdecodeˉtext(
                Source, Declaration.Bodyˉoffset, Declaration.Bodyˉlength
            );
        if Decoded.Status != Compilerˉsourceˉwvbˉstatus.Valid {
            return Compilerˉsourceˉwvbˉdataˉencoding(Decoded.Status, Empty);
        }
        Payload = Bytesˉconcat(Payload, Bytesˉfromˉu8(3u8));
        Payload = Bytesˉconcat(
            Payload, Bytesˉfromˉu32ˉlittle(Bytesˉlength(Decoded.Value))
        );
        return Compilerˉsourceˉwvbˉdataˉencoding(
            Compilerˉsourceˉwvbˉstatus.Valid,
            Bytesˉconcat(Payload, Decoded.Value)
        );
    }
    let Start: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
        Source, Declaration.Bodyˉoffset, 1u32, 1u32
    );
    var Cursor: u32 = Start.Nextˉoffset;
    var Line: u32 = Start.Nextˉline;
    var Column: u32 = Start.Nextˉcolumn;
    if Type == Sourceˉdeclarations.Compilerˉsourceˉtypeˉkind.I32ˉarray {
        Payload = Bytesˉconcat(Payload, Bytesˉfromˉu8(4u8));
        Payload = Bytesˉconcat(
            Payload, Bytesˉfromˉu32ˉlittle(Declaration.Items)
        );
        var Arrayˉindex: u32 = 0u32;
        while Arrayˉindex < Declaration.Items {
            var Arrayˉitem: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                Source, Cursor, Line, Column
            );
            var Negative: bool = false;
            if Arrayˉitem.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Minus {
                Negative = true;
                Arrayˉitem = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                    Source, Arrayˉitem.Nextˉoffset, Arrayˉitem.Nextˉline, Arrayˉitem.Nextˉcolumn
                );
            }
            var Arrayˉvalue: u32 = Arrayˉitem.Numericˉvalue;
            if Negative {
                if Arrayˉvalue != 0u32 {
                    Arrayˉvalue = 4294967295u32 - (Arrayˉvalue - 1u32);
                }
            }
            Payload = Bytesˉconcat(Payload, Bytesˉfromˉu32ˉlittle(Arrayˉvalue));
            let Arrayˉseparator: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                Source, Arrayˉitem.Nextˉoffset, Arrayˉitem.Nextˉline, Arrayˉitem.Nextˉcolumn
            );
            Cursor = Arrayˉseparator.Nextˉoffset;
            Line = Arrayˉseparator.Nextˉline;
            Column = Arrayˉseparator.Nextˉcolumn;
            Arrayˉindex = Arrayˉindex + 1u32;
        }
        return Compilerˉsourceˉwvbˉdataˉencoding(
            Compilerˉsourceˉwvbˉstatus.Valid, Payload
        );
    }
    Payload = Bytesˉconcat(Payload, Bytesˉfromˉu8(5u8));
    Payload = Bytesˉconcat(
        Payload, Bytesˉfromˉu32ˉlittle(Declaration.Items)
    );
    var Byteˉindex: u32 = 0u32;
    while Byteˉindex < Declaration.Items {
        let Byteˉitem: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Source, Cursor, Line, Column
        );
        Payload = Bytesˉconcat(
            Payload, Compilerˉsourceˉwvbˉlowˉbyte(Byteˉitem.Numericˉvalue)
        );
        let Byteˉseparator: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Source, Byteˉitem.Nextˉoffset, Byteˉitem.Nextˉline, Byteˉitem.Nextˉcolumn
        );
        Cursor = Byteˉseparator.Nextˉoffset;
        Line = Byteˉseparator.Nextˉline;
        Column = Byteˉseparator.Nextˉcolumn;
        Byteˉindex = Byteˉindex + 1u32;
    }
    return Compilerˉsourceˉwvbˉdataˉencoding(
        Compilerˉsourceˉwvbˉstatus.Valid, Payload
    );
}

export fn Compilerˉsourceˉwvbˉencodeˉsyntheticˉdata(
    Plan: Compilerˉsourceˉwvbˉtextˉplan,
    Synthetic: u32
) -> bytes {
    let Entry: u32 = Synthetic * 12u32;
    let Name: bytes = Compilerˉsourceˉwvbˉsyntheticˉname(
        Bytesˉreadˉu32ˉlittle(Plan.Directory, Entry)
    );
    let Offset: u32 = Bytesˉreadˉu32ˉlittle(Plan.Directory, Entry + 4u32);
    let Length: u32 = Bytesˉreadˉu32ˉlittle(Plan.Directory, Entry + 8u32);
    var Payload: bytes = Compilerˉsourceˉwvbˉstring(
        Name, 0u32, Bytesˉlength(Name)
    );
    Payload = Bytesˉconcat(Payload, Bytesˉfromˉu8(3u8));
    Payload = Bytesˉconcat(Payload, Bytesˉfromˉu32ˉlittle(Length));
    return Bytesˉconcat(Payload, Bytesˉslice(Plan.Values, Offset, Length));
}

export fn Compilerˉsourceˉwvbˉencodeˉdata(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Plan: Compilerˉsourceˉwvbˉtextˉplan,
    Order: Compilerˉsourceˉwvbˉsymbolˉorder
) -> Compilerˉsourceˉwvbˉdataˉencoding {
    let Explicitˉcount: u32 = Bytesˉlength(Order.Entries) / 4u32;
    var Payload: bytes = Bytesˉfromˉu32ˉlittle(Explicitˉcount + Plan.Count);
    var Explicit: u32 = 0u32;
    var Synthetic: u32 = 0u32;
    while Explicit < Explicitˉcount {
        var Useˉexplicit: bool = Synthetic >= Plan.Count;
        let Explicitˉentry: u32 = Compilerˉsourceˉwvbˉorderedˉsymbol(
            Order, Explicit
        );
        let View: Sourceˉset.Compilerˉsourceˉsetˉview = Compilerˉsourceˉwvbˉsymbolˉsource(
            Input, Scan, Symbols, Explicitˉentry
        );
        if Synthetic < Plan.Count {
            let Entryˉoffset: u32 = 16u32 + Explicitˉentry * 24u32;
            let Explicitˉnameˉoffset: u32 = Bytesˉreadˉu32ˉlittle(
                Symbols.Directory, Entryˉoffset + 12u32
            );
            let Explicitˉnameˉlength: u32 = Bytesˉreadˉu32ˉlittle(
                Symbols.Directory, Entryˉoffset + 16u32
            );
            let Syntheticˉname: bytes = Compilerˉsourceˉwvbˉsyntheticˉname(
                Bytesˉreadˉu32ˉlittle(Plan.Directory, Synthetic * 12u32)
            );
            let Explicitˉname: bytes = Compilerˉsourceˉwvbˉsymbolˉname(
                Input, Scan, Symbols, Explicitˉentry
            );
            if Sourceˉset.Compilerˉsourceˉspansˉcompare(
                Explicitˉname, 0u32, Bytesˉlength(Explicitˉname),
                Syntheticˉname, 0u32, Bytesˉlength(Syntheticˉname)
            ) < 0 { Useˉexplicit = true; }
        }
        if Useˉexplicit {
            let Header: Sourceˉdeclarations.Compilerˉsourceˉheader = Sourceˉdeclarations.Compilerˉparseˉheaderˉvalidated(
                View.Source
            );
            let Encoded: Compilerˉsourceˉwvbˉdataˉencoding =
                Compilerˉsourceˉwvbˉencodeˉexplicitˉdata(
                    Input, Scan, View.Source, Header, Symbols, Explicitˉentry
                );
            if Encoded.Status != Compilerˉsourceˉwvbˉstatus.Valid {
                return Encoded;
            }
            Payload = Bytesˉconcat(Payload, Encoded.Payload);
            Explicit = Explicit + 1u32;
        } else {
            Payload = Bytesˉconcat(
                Payload,
                Compilerˉsourceˉwvbˉencodeˉsyntheticˉdata(Plan, Synthetic)
            );
            Synthetic = Synthetic + 1u32;
        }
    }
    while Synthetic < Plan.Count {
        Payload = Bytesˉconcat(
            Payload,
            Compilerˉsourceˉwvbˉencodeˉsyntheticˉdata(Plan, Synthetic)
        );
        Synthetic = Synthetic + 1u32;
    }
    return Compilerˉsourceˉwvbˉdataˉencoding(
        Compilerˉsourceˉwvbˉstatus.Valid, Payload
    );
}

export fn Compilerˉsourceˉwvbˉencodeˉrecordˉtype(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Source: bytes,
    Header: Sourceˉdeclarations.Compilerˉsourceˉheader,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Entry: u32
) -> Compilerˉsourceˉwvbˉtypeˉencoding {
    let Empty: bytes = Compilerˉsourceˉwvbˉempty(Source);
    let Entryˉoffset: u32 = 16u32 + Entry * 24u32;
    let Owner: u32 = Bytesˉreadˉu32ˉlittle(Symbols.Directory, Entryˉoffset);
    let Declaration: Sourceˉdeclarations.Compilerˉsourceˉdeclaration = Compilerˉsourceˉwvbˉdeclaration(
        Source, Header, Symbols, Entry
    );
    var Payload: bytes = Bytesˉfromˉu8(1u8);
    var Hasˉcollections: bool = false;
    Payload = Bytesˉconcat(
        Payload,
        Compilerˉsourceˉwvbˉencodedˉstring(
            Compilerˉsourceˉwvbˉsymbolˉname(Input, Scan, Symbols, Entry)
        )
    );
    Payload = Bytesˉconcat(Payload, Bytesˉfromˉu32ˉlittle(Declaration.Items));
    let Brace: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
        Source, Declaration.Bodyˉoffset, 1u32, 1u32
    );
    var Cursor: u32 = Brace.Nextˉoffset;
    var Line: u32 = Brace.Nextˉline;
    var Column: u32 = Brace.Nextˉcolumn;
    var Fieldˉindex: u32 = 0u32;
    while Fieldˉindex < Declaration.Items {
        let Field: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Source, Cursor, Line, Column
        );
        let Colon: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Source, Field.Nextˉoffset, Field.Nextˉline, Field.Nextˉcolumn
        );
        let Binding: Sourceˉsymbols.Compilerˉsourceˉtypeˉbinding = Sourceˉsymbols.Compilerˉsourceˉsymbolsˉbindˉtype(
            Input, Scan, Symbols.Directory, Symbols.Lookup, Symbols.Visibility,
            Owner, Source,
            Colon.Nextˉoffset, Colon.Nextˉline, Colon.Nextˉcolumn,
            Symbols.Records, Symbols.Enums, true
        );
        if Binding.Status != Sourceˉsymbols.Compilerˉsourceˉsymbolˉstatus.Valid {
            return Compilerˉsourceˉwvbˉtypeˉencoding(
                Compilerˉsourceˉwvbˉstatus.Unsupportedˉshape, Empty, Hasˉcollections
            );
        }
        let Shape: u32 = Sourceˉbindings.Compilerˉsourceˉbindingsˉshape(Binding);
        if !Compilerˉsourceˉwvbˉshapeˉisˉsupported(
            Shape, false, Symbols.Records, Symbols.Enums, Symbols.Variants
        ) {
            return Compilerˉsourceˉwvbˉtypeˉencoding(
                Compilerˉsourceˉwvbˉstatus.Unsupportedˉshape, Empty, Hasˉcollections
            );
        }
        if Sourceˉwir.Compilerˉsourceˉwirˉshapeˉisˉsequence(Shape) ||
            Sourceˉwir.Compilerˉsourceˉwirˉshapeˉisˉbuilder(Shape) {
            Hasˉcollections = true;
        }
        Payload = Bytesˉconcat(
            Payload, Compilerˉsourceˉwvbˉstring(Source, Field.Offset, Field.Length)
        );
        Payload = Bytesˉconcat(Payload, Compilerˉsourceˉwvbˉshape(Shape));
        let End: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Source, Binding.Nextˉoffset, Binding.Nextˉline, Binding.Nextˉcolumn
        );
        Cursor = End.Nextˉoffset;
        Line = End.Nextˉline;
        Column = End.Nextˉcolumn;
        Fieldˉindex = Fieldˉindex + 1u32;
    }
    return Compilerˉsourceˉwvbˉtypeˉencoding(
        Compilerˉsourceˉwvbˉstatus.Valid, Payload, Hasˉcollections
    );
}

export fn Compilerˉsourceˉwvbˉencodeˉenumˉtype(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Source: bytes,
    Header: Sourceˉdeclarations.Compilerˉsourceˉheader,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Entry: u32
) -> Compilerˉsourceˉwvbˉtypeˉencoding {
    let Declaration: Sourceˉdeclarations.Compilerˉsourceˉdeclaration = Compilerˉsourceˉwvbˉdeclaration(
        Source, Header, Symbols, Entry
    );
    var Payload: bytes = Bytesˉfromˉu8(2u8);
    Payload = Bytesˉconcat(
        Payload,
        Compilerˉsourceˉwvbˉencodedˉstring(
            Compilerˉsourceˉwvbˉsymbolˉname(Input, Scan, Symbols, Entry)
        )
    );
    Payload = Bytesˉconcat(Payload, Bytesˉfromˉu32ˉlittle(Declaration.Items));
    let Brace: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
        Source, Declaration.Bodyˉoffset, 1u32, 1u32
    );
    var Cursor: u32 = Brace.Nextˉoffset;
    var Line: u32 = Brace.Nextˉline;
    var Column: u32 = Brace.Nextˉcolumn;
    var Memberˉindex: u32 = 0u32;
    while Memberˉindex < Declaration.Items {
        let Member: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Source, Cursor, Line, Column
        );
        let Equals: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Source, Member.Nextˉoffset, Member.Nextˉline, Member.Nextˉcolumn
        );
        let Value: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Source, Equals.Nextˉoffset, Equals.Nextˉline, Equals.Nextˉcolumn
        );
        Payload = Bytesˉconcat(
            Payload, Compilerˉsourceˉwvbˉstring(Source, Member.Offset, Member.Length)
        );
        Payload = Bytesˉconcat(Payload, Bytesˉfromˉu32ˉlittle(Value.Numericˉvalue));
        let End: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Source, Value.Nextˉoffset, Value.Nextˉline, Value.Nextˉcolumn
        );
        Cursor = End.Nextˉoffset;
        Line = End.Nextˉline;
        Column = End.Nextˉcolumn;
        Memberˉindex = Memberˉindex + 1u32;
    }
    return Compilerˉsourceˉwvbˉtypeˉencoding(
        Compilerˉsourceˉwvbˉstatus.Valid, Payload, false
    );
}

export fn Compilerˉsourceˉwvbˉencodeˉvariantˉtype(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Source: bytes,
    Header: Sourceˉdeclarations.Compilerˉsourceˉheader,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Entry: u32
) -> Compilerˉsourceˉwvbˉtypeˉencoding {
    let Empty: bytes = Compilerˉsourceˉwvbˉempty(Source);
    let Entryˉoffset: u32 = 16u32 + Entry * 24u32;
    let Owner: u32 = Bytesˉreadˉu32ˉlittle(Symbols.Directory, Entryˉoffset);
    let Declaration: Sourceˉdeclarations.Compilerˉsourceˉdeclaration =
        Compilerˉsourceˉwvbˉdeclaration(Source, Header, Symbols, Entry);
    var Payload: bytes = Bytesˉfromˉu8(3u8);
    var Hasˉcollections: bool = false;
    Payload = Bytesˉconcat(
        Payload,
        Compilerˉsourceˉwvbˉencodedˉstring(
            Compilerˉsourceˉwvbˉsymbolˉname(Input, Scan, Symbols, Entry)
        )
    );
    Payload = Bytesˉconcat(Payload, Bytesˉfromˉu32ˉlittle(Declaration.Items));
    let Brace: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
        Source, Declaration.Bodyˉoffset, 1u32, 1u32
    );
    var Cursor: u32 = Brace.Nextˉoffset;
    var Line: u32 = Brace.Nextˉline;
    var Column: u32 = Brace.Nextˉcolumn;
    var Caseˉindex: u32 = 0u32;
    while Caseˉindex < Declaration.Items {
        let Caseˉname: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Source, Cursor, Line, Column
        );
        let Afterˉname: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Source, Caseˉname.Nextˉoffset, Caseˉname.Nextˉline, Caseˉname.Nextˉcolumn
        );
        Payload = Bytesˉconcat(
            Payload,
            Compilerˉsourceˉwvbˉstring(Source, Caseˉname.Offset, Caseˉname.Length)
        );
        var End: Sourceˉlexer.Compilerˉsourceˉtoken = Afterˉname;
        if Afterˉname.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Leftˉparenthesis {
            Payload = Bytesˉconcat(Payload, Bytesˉfromˉu8(1u8));
            let Payloadˉname: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                Source, Afterˉname.Nextˉoffset, Afterˉname.Nextˉline, Afterˉname.Nextˉcolumn
            );
            Payload = Bytesˉconcat(
                Payload,
                Compilerˉsourceˉwvbˉstring(
                    Source, Payloadˉname.Offset, Payloadˉname.Length
                )
            );
            let Colon: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                Source, Payloadˉname.Nextˉoffset, Payloadˉname.Nextˉline, Payloadˉname.Nextˉcolumn
            );
            let Binding: Sourceˉsymbols.Compilerˉsourceˉtypeˉbinding =
                Sourceˉsymbols.Compilerˉsourceˉsymbolsˉbindˉtype(
                    Input, Scan, Symbols.Directory, Symbols.Lookup, Symbols.Visibility,
                    Owner, Source,
                    Colon.Nextˉoffset, Colon.Nextˉline, Colon.Nextˉcolumn,
                    Symbols.Records, Symbols.Enums, false
                );
            if Binding.Status != Sourceˉsymbols.Compilerˉsourceˉsymbolˉstatus.Valid {
                return Compilerˉsourceˉwvbˉtypeˉencoding(
                    Compilerˉsourceˉwvbˉstatus.Unsupportedˉshape, Empty, Hasˉcollections
                );
            }
            let Shape: u32 = Sourceˉbindings.Compilerˉsourceˉbindingsˉshape(Binding);
            if !Compilerˉsourceˉwvbˉshapeˉisˉsupported(
                Shape, false, Symbols.Records, Symbols.Enums, Symbols.Variants
            ) {
                return Compilerˉsourceˉwvbˉtypeˉencoding(
                    Compilerˉsourceˉwvbˉstatus.Unsupportedˉshape, Empty, Hasˉcollections
                );
            }
            if Sourceˉwir.Compilerˉsourceˉwirˉshapeˉisˉsequence(Shape) ||
                Sourceˉwir.Compilerˉsourceˉwirˉshapeˉisˉbuilder(Shape) {
                Hasˉcollections = true;
            }
            Payload = Bytesˉconcat(Payload, Compilerˉsourceˉwvbˉshape(Shape));
            let Right: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                Source, Binding.Nextˉoffset, Binding.Nextˉline, Binding.Nextˉcolumn
            );
            End = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                Source, Right.Nextˉoffset, Right.Nextˉline, Right.Nextˉcolumn
            );
        } else {
            Payload = Bytesˉconcat(Payload, Bytesˉfromˉu8(0u8));
        }
        Cursor = End.Nextˉoffset;
        Line = End.Nextˉline;
        Column = End.Nextˉcolumn;
        Caseˉindex = Caseˉindex + 1u32;
    }
    return Compilerˉsourceˉwvbˉtypeˉencoding(
        Compilerˉsourceˉwvbˉstatus.Valid, Payload, Hasˉcollections
    );
}

export fn Compilerˉsourceˉwvbˉencodeˉtypes(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Recordˉorder: Compilerˉsourceˉwvbˉsymbolˉorder,
    Enumˉorder: Compilerˉsourceˉwvbˉsymbolˉorder,
    Variantˉorder: Compilerˉsourceˉwvbˉsymbolˉorder
) -> Compilerˉsourceˉwvbˉtypeˉencoding {
    var Payload: bytes = Bytesˉfromˉu32ˉlittle(
        Symbols.Records + Symbols.Enums + Symbols.Variants
    );
    var Rank: u32 = 0u32;
    var Hasˉcollections: bool = false;
    while Rank < Symbols.Records {
        let Entry: u32 = Compilerˉsourceˉwvbˉorderedˉsymbol(
            Recordˉorder, Rank
        );
        let View: Sourceˉset.Compilerˉsourceˉsetˉview = Compilerˉsourceˉwvbˉsymbolˉsource(
            Input, Scan, Symbols, Entry
        );
        let Header: Sourceˉdeclarations.Compilerˉsourceˉheader = Sourceˉdeclarations.Compilerˉparseˉheaderˉvalidated(
            View.Source
        );
        let Encoded: Compilerˉsourceˉwvbˉtypeˉencoding =
            Compilerˉsourceˉwvbˉencodeˉrecordˉtype(
                Input, Scan, View.Source, Header, Symbols, Entry
            );
        if Encoded.Status != Compilerˉsourceˉwvbˉstatus.Valid { return Encoded; }
        if Encoded.Hasˉcollections { Hasˉcollections = true; }
        Payload = Bytesˉconcat(Payload, Encoded.Payload);
        Rank = Rank + 1u32;
    }
    Rank = 0u32;
    while Rank < Symbols.Enums {
        let Enumˉentry: u32 = Compilerˉsourceˉwvbˉorderedˉsymbol(
            Enumˉorder, Rank
        );
        let Enumˉview: Sourceˉset.Compilerˉsourceˉsetˉview =
            Compilerˉsourceˉwvbˉsymbolˉsource(
                Input, Scan, Symbols, Enumˉentry
            );
        let Enumˉheader: Sourceˉdeclarations.Compilerˉsourceˉheader =
            Sourceˉdeclarations.Compilerˉparseˉheaderˉvalidated(Enumˉview.Source);
        let Encodedˉenum: Compilerˉsourceˉwvbˉtypeˉencoding =
            Compilerˉsourceˉwvbˉencodeˉenumˉtype(
                Input, Scan, Enumˉview.Source, Enumˉheader, Symbols, Enumˉentry
            );
        if Encodedˉenum.Status != Compilerˉsourceˉwvbˉstatus.Valid {
            return Encodedˉenum;
        }
        if Encodedˉenum.Hasˉcollections { Hasˉcollections = true; }
        Payload = Bytesˉconcat(Payload, Encodedˉenum.Payload);
        Rank = Rank + 1u32;
    }
    Rank = 0u32;
    while Rank < Symbols.Variants {
        let Variantˉentry: u32 = Compilerˉsourceˉwvbˉorderedˉsymbol(
            Variantˉorder, Rank
        );
        let Variantˉview: Sourceˉset.Compilerˉsourceˉsetˉview =
            Compilerˉsourceˉwvbˉsymbolˉsource(
                Input, Scan, Symbols, Variantˉentry
            );
        let Variantˉheader: Sourceˉdeclarations.Compilerˉsourceˉheader =
            Sourceˉdeclarations.Compilerˉparseˉheaderˉvalidated(Variantˉview.Source);
        let Encodedˉvariant: Compilerˉsourceˉwvbˉtypeˉencoding =
            Compilerˉsourceˉwvbˉencodeˉvariantˉtype(
                Input, Scan, Variantˉview.Source, Variantˉheader,
                Symbols, Variantˉentry
            );
        if Encodedˉvariant.Status != Compilerˉsourceˉwvbˉstatus.Valid {
            return Encodedˉvariant;
        }
        if Encodedˉvariant.Hasˉcollections { Hasˉcollections = true; }
        Payload = Bytesˉconcat(Payload, Encodedˉvariant.Payload);
        Rank = Rank + 1u32;
    }
    return Compilerˉsourceˉwvbˉtypeˉencoding(
        Compilerˉsourceˉwvbˉstatus.Valid, Payload, Hasˉcollections
    );
}

export fn Compilerˉsourceˉwvbˉtextˉoperationˉdataˉindex(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Source: bytes,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Plan: Compilerˉsourceˉwvbˉtextˉplan,
    Order: Compilerˉsourceˉwvbˉsymbolˉorder,
    Wir: bytes,
    Operationˉentry: u32
) -> u32 {
    let Target: u32 = Bytesˉreadˉu32ˉlittle(Wir, Operationˉentry + 32u32);
    let Length: u32 = Bytesˉreadˉu32ˉlittle(Wir, Operationˉentry + 36u32);
    if Length == 0u32 {
        return Compilerˉsourceˉwvbˉexplicitˉdataˉindex(
            Input, Scan, Symbols, Plan, Order, Target
        );
    }
    let Decoded: Compilerˉsourceˉwvbˉtextˉvalue =
        Compilerˉsourceˉwvbˉdecodeˉtext(Source, Target, Length);
    let Explicit: u32 = Compilerˉsourceˉwvbˉexplicitˉtextˉentry(
        Input, Scan, Symbols, Decoded.Value
    );
    if Explicit != Sourceˉwir.Compilerˉsourceˉwirˉsentinel() {
        return Compilerˉsourceˉwvbˉexplicitˉdataˉindex(
            Input, Scan, Symbols, Plan, Order, Explicit
        );
    }
    return Compilerˉsourceˉwvbˉsyntheticˉdataˉindex(
        Input,
        Scan,
        Symbols,
        Plan,
        Order,
        Compilerˉsourceˉwvbˉtextˉplanˉfind(Plan, Decoded.Value)
    );
}

export fn Compilerˉsourceˉwvbˉblocksˉoffset(Wir: bytes) -> u32 {
    return 48u32 + Bytesˉreadˉu32ˉlittle(Wir, 8u32) * 48u32;
}

export fn Compilerˉsourceˉwvbˉoperationsˉoffset(Wir: bytes) -> u32 {
    return Compilerˉsourceˉwvbˉblocksˉoffset(Wir) +
        Bytesˉreadˉu32ˉlittle(Wir, 16u32) * 36u32;
}

export fn Compilerˉsourceˉwvbˉtemporariesˉoffset(Wir: bytes) -> u32 {
    return Compilerˉsourceˉwvbˉoperationsˉoffset(Wir) +
        Bytesˉreadˉu32ˉlittle(Wir, 24u32) * 48u32;
}

export fn Compilerˉsourceˉwvbˉoperandsˉoffset(Wir: bytes) -> u32 {
    return Compilerˉsourceˉwvbˉtemporariesˉoffset(Wir) +
        Bytesˉreadˉu32ˉlittle(Wir, 32u32) * 4u32;
}

export fn Compilerˉsourceˉwvbˉanalysisˉfailure(
    Wir: bytes,
    Status: Compilerˉsourceˉwvbˉstatus,
    Operation: u32
) -> Compilerˉsourceˉwvbˉanalysis {
    return Compilerˉsourceˉwvbˉanalysis(
        Status, 0u32, 0u32, Compilerˉsourceˉwvbˉempty(Wir), Operation
    );
}

export fn Compilerˉsourceˉwvbˉphiˉpreludeˉlength(
    Wir: bytes,
    Firstˉblock: u32,
    Predecessor: u32,
    Targetˉblock: u32
) -> u32 {
    let Blocksˉoffset: u32 = Compilerˉsourceˉwvbˉblocksˉoffset(Wir);
    let Targetˉentry: u32 = Blocksˉoffset + (Firstˉblock + Targetˉblock) * 36u32;
    if Bytesˉreadˉu32ˉlittle(Wir, Targetˉentry + 16u32) == 0u32 { return 0u32; }
    let Firstˉoperation: u32 = Bytesˉreadˉu32ˉlittle(Wir, Targetˉentry + 12u32);
    let Operationˉentry: u32 = Compilerˉsourceˉwvbˉoperationsˉoffset(Wir) +
        Firstˉoperation * 48u32;
    if Bytesˉreadˉu32ˉlittle(Wir, Operationˉentry + 12u32) != 64u32 { return 0u32; }
    if Bytesˉreadˉu32ˉlittle(Wir, Operationˉentry + 32u32) == Predecessor {
        return 10u32;
    }
    if Bytesˉreadˉu32ˉlittle(Wir, Operationˉentry + 36u32) == Predecessor {
        return 10u32;
    }
    return 0u32;
}

export fn Compilerˉsourceˉwvbˉanalyzeˉfunction(
    Wir: bytes,
    Function: u32,
    Records: u32,
    Enums: u32,
    Variants: u32
) -> Compilerˉsourceˉwvbˉanalysis {
    let Functionˉentry: u32 = 48u32 + Function * 48u32;
    let Firstˉblock: u32 = Bytesˉreadˉu32ˉlittle(Wir, Functionˉentry + 4u32);
    let Blockˉcount: u32 = Bytesˉreadˉu32ˉlittle(Wir, Functionˉentry + 8u32);
    let Blocksˉoffset: u32 = Compilerˉsourceˉwvbˉblocksˉoffset(Wir);
    let Operationsˉoffset: u32 = Compilerˉsourceˉwvbˉoperationsˉoffset(Wir);
    var Blockˉoffsets: bytes = Compilerˉsourceˉwvbˉempty(Wir);
    var Codeˉlength: u32 = 0u32;
    var Maximumˉstack: u32 = 0u32;
    var Block: u32 = 0u32;
    while Block < Blockˉcount {
        Blockˉoffsets = Bytesˉconcat(
            Blockˉoffsets, Bytesˉfromˉu32ˉlittle(Codeˉlength)
        );
        let Blockˉentry: u32 = Blocksˉoffset + (Firstˉblock + Block) * 36u32;
        let Firstˉoperation: u32 = Bytesˉreadˉu32ˉlittle(Wir, Blockˉentry + 12u32);
        let Operationˉcount: u32 = Bytesˉreadˉu32ˉlittle(Wir, Blockˉentry + 16u32);
        var Inˉblock: u32 = 0u32;
        while Inˉblock < Operationˉcount {
            let Globalˉoperation: u32 = Firstˉoperation + Inˉblock;
            let Operationˉentry: u32 = Operationsˉoffset + Globalˉoperation * 48u32;
            let Operation: u32 = Bytesˉreadˉu32ˉlittle(Wir, Operationˉentry + 12u32);
            let Shape: u32 = Bytesˉreadˉu32ˉlittle(Wir, Operationˉentry + 16u32);
            let Operands: u32 = Bytesˉreadˉu32ˉlittle(Wir, Operationˉentry + 28u32);
            if !Compilerˉsourceˉwvbˉoperationˉisˉsupported(Operation) {
                return Compilerˉsourceˉwvbˉanalysisˉfailure(
                    Wir, Compilerˉsourceˉwvbˉstatus.Unsupportedˉoperation,
                    Globalˉoperation
                );
            }
            if !Compilerˉsourceˉwvbˉshapeˉisˉsupported(
                Shape, true, Records, Enums, Variants
            ) {
                return Compilerˉsourceˉwvbˉanalysisˉfailure(
                    Wir, Compilerˉsourceˉwvbˉstatus.Unsupportedˉshape,
                    Globalˉoperation
                );
            }
            var Operationˉstack: u32 = Operands;
            if Operation == 64u32 { Operationˉstack = 0u32; }
            if Shape != 0u32 {
                if Operationˉstack == 0u32 { Operationˉstack = 1u32; }
            }
            if Operationˉstack > Maximumˉstack { Maximumˉstack = Operationˉstack; }
            let Added: u32 = Compilerˉsourceˉwvbˉoperationˉlength(
                Operation, Shape, Operands
            );
            if Added == 0u32 && Operation != 64u32 {
                return Compilerˉsourceˉwvbˉanalysisˉfailure(
                    Wir, Compilerˉsourceˉwvbˉstatus.Unsupportedˉoperation,
                    Globalˉoperation
                );
            }
            if Codeˉlength > 1048576u32 - Added {
                return Compilerˉsourceˉwvbˉanalysisˉfailure(
                    Wir, Compilerˉsourceˉwvbˉstatus.Bytecodeˉlimit,
                    Globalˉoperation
                );
            }
            Codeˉlength = Codeˉlength + Added;
            Inˉblock = Inˉblock + 1u32;
        }
        let Terminator: u32 = Bytesˉreadˉu32ˉlittle(Wir, Blockˉentry + 20u32);
        var Terminatorˉlength: u32 = 0u32;
        if Terminator == 1u32 {
            let Jumpˉtarget: u32 = Bytesˉreadˉu32ˉlittle(Wir, Blockˉentry + 28u32);
            let Phiˉprelude: u32 = Compilerˉsourceˉwvbˉphiˉpreludeˉlength(
                Wir, Firstˉblock, Block, Jumpˉtarget
            );
            Terminatorˉlength = 5u32 + Phiˉprelude;
            if Phiˉprelude > 0u32 {
                if Maximumˉstack == 0u32 { Maximumˉstack = 1u32; }
            }
        }
        if Terminator == 2u32 {
            Terminatorˉlength = 15u32;
            if Maximumˉstack == 0u32 { Maximumˉstack = 1u32; }
        }
        if Terminator == 3u32 {
            Terminatorˉlength = 1u32;
            if Bytesˉreadˉu32ˉlittle(Wir, Blockˉentry + 24u32) !=
                Sourceˉwir.Compilerˉsourceˉwirˉsentinel() {
                Terminatorˉlength = 6u32;
                if Maximumˉstack == 0u32 { Maximumˉstack = 1u32; }
            }
        }
        if Codeˉlength > 1048576u32 - Terminatorˉlength {
            return Compilerˉsourceˉwvbˉanalysisˉfailure(
                Wir, Compilerˉsourceˉwvbˉstatus.Bytecodeˉlimit,
                Bytesˉreadˉu32ˉlittle(Wir, 24u32)
            );
        }
        Codeˉlength = Codeˉlength + Terminatorˉlength;
        Block = Block + 1u32;
    }
    return Compilerˉsourceˉwvbˉanalysis(
        Compilerˉsourceˉwvbˉstatus.Valid,
        Codeˉlength,
        Maximumˉstack,
        Blockˉoffsets,
        Bytesˉreadˉu32ˉlittle(Wir, 24u32)
    );
}

export fn Compilerˉsourceˉwvbˉinstructionˉu32(Opcode: u8, Value: u32) -> bytes {
    return Bytesˉconcat(Bytesˉfromˉu8(Opcode), Bytesˉfromˉu32ˉlittle(Value));
}

export fn Compilerˉsourceˉwvbˉtemporaryˉslot(
    Temporary: u32,
    Parameters: u32,
    Locals: u32,
    Mapping: bytes
) -> u32 {
    return Parameters + Locals + Bytesˉreadˉu32ˉlittle(
        Mapping, Temporary * 4u32
    );
}

export fn Compilerˉsourceˉwvbˉloadˉtemporary(
    Temporary: u32,
    Parameters: u32,
    Locals: u32,
    Mapping: bytes
) -> bytes {
    return Compilerˉsourceˉwvbˉinstructionˉu32(
        4u8,
        Compilerˉsourceˉwvbˉtemporaryˉslot(
            Temporary, Parameters, Locals, Mapping
        )
    );
}

export fn Compilerˉsourceˉwvbˉemitˉoperation(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Source: bytes,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Orders: Compilerˉsourceˉwvbˉsymbolˉorders,
    Plan: Compilerˉsourceˉwvbˉtextˉplan,
    Wir: bytes,
    Operationˉentry: u32,
    Parameters: u32,
    Locals: u32,
    Temporaryˉmapping: bytes
) -> bytes {
    let Operation: u32 = Bytesˉreadˉu32ˉlittle(Wir, Operationˉentry + 12u32);
    let Shape: u32 = Bytesˉreadˉu32ˉlittle(Wir, Operationˉentry + 16u32);
    let Temporary: u32 = Bytesˉreadˉu32ˉlittle(Wir, Operationˉentry + 20u32);
    let Firstˉoperand: u32 = Bytesˉreadˉu32ˉlittle(Wir, Operationˉentry + 24u32);
    let Operandˉcount: u32 = Bytesˉreadˉu32ˉlittle(Wir, Operationˉentry + 28u32);
    let Target: u32 = Bytesˉreadˉu32ˉlittle(Wir, Operationˉentry + 32u32);
    let Auxiliary: u32 = Bytesˉreadˉu32ˉlittle(Wir, Operationˉentry + 36u32);
    let Operandsˉoffset: u32 = Compilerˉsourceˉwvbˉoperandsˉoffset(Wir);
    var Result: bytes = Compilerˉsourceˉwvbˉempty(Wir);
    if Operation == 64u32 { return Result; }
    var Operand: u32 = 0u32;
    while Operand < Operandˉcount {
        let Operandˉtemporary: u32 = Bytesˉreadˉu32ˉlittle(
            Wir, Operandsˉoffset + (Firstˉoperand + Operand) * 4u32
        );
        Result = Bytesˉconcat(
            Result,
            Compilerˉsourceˉwvbˉloadˉtemporary(
                Operandˉtemporary, Parameters, Locals, Temporaryˉmapping
            )
        );
        Operand = Operand + 1u32;
    }
    if Operation == 1u32 {
        Result = Bytesˉconcat(
            Result, Compilerˉsourceˉwvbˉinstructionˉu32(1u8, Target)
        );
    }
    if Operation == 2u32 {
        Result = Bytesˉconcat(Result, Bytesˉfromˉu8(8u8));
        Result = Bytesˉconcat(
            Result, Bytesˉslice(Bytesˉfromˉu32ˉlittle(Target), 0u32, 1u32)
        );
    }
    if Operation == 3u32 {
        Result = Bytesˉconcat(
            Result, Compilerˉsourceˉwvbˉinstructionˉu32(9u8, Target)
        );
    }
    if Operation == 4u32 {
        Result = Bytesˉconcat(Result, Bytesˉfromˉu8(2u8));
        Result = Bytesˉconcat(
            Result, Bytesˉslice(Bytesˉfromˉu32ˉlittle(Target), 0u32, 1u32)
        );
    }
    if Operation == 93u32 || Operation == 94u32 {
        Result = Bytesˉconcat(
            Result, Bytesˉfromˉu8(Compilerˉsourceˉwvbˉopcode(Operation))
        );
        Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Target));
        Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Auxiliary));
    }
    if Operation == 5u32 {
        Result = Bytesˉconcat(
            Result,
            Compilerˉsourceˉwvbˉinstructionˉu32(
                3u8,
                Compilerˉsourceˉwvbˉtextˉoperationˉdataˉindex(
                    Input, Scan, Source, Symbols, Plan,
                    Compilerˉsourceˉwvbˉdataˉorder(Orders),
                    Wir, Operationˉentry
                )
            )
        );
    }
    if Operation == 6u32 {
        Result = Bytesˉconcat(
            Result,
            Compilerˉsourceˉwvbˉinstructionˉu32(
                10u8,
                Compilerˉsourceˉwvbˉexplicitˉdataˉindex(
                    Input, Scan, Symbols, Plan,
                    Compilerˉsourceˉwvbˉdataˉorder(Orders), Target
                )
            )
        );
    }
    if Operation == 7u32 {
        Result = Bytesˉconcat(
            Result, Compilerˉsourceˉwvbˉinstructionˉu32(4u8, Target)
        );
    }
    if Operation == 8u32 {
        Result = Bytesˉconcat(
            Result, Compilerˉsourceˉwvbˉinstructionˉu32(5u8, Target)
        );
    }
    if Operation == 9u32 {
        Result = Bytesˉconcat(
            Result,
            Compilerˉsourceˉwvbˉinstructionˉu32(
                6u8,
                Compilerˉsourceˉwvbˉexplicitˉdataˉindex(
                    Input, Scan, Symbols, Plan,
                    Compilerˉsourceˉwvbˉdataˉorder(Orders), Target
                )
            )
        );
    }
    if Operation == 10u32 {
        Result = Bytesˉconcat(
            Result,
            Compilerˉsourceˉwvbˉinstructionˉu32(
                7u8,
                Compilerˉsourceˉwvbˉexplicitˉdataˉindex(
                    Input, Scan, Symbols, Plan,
                    Compilerˉsourceˉwvbˉdataˉorder(Orders), Target
                )
            )
        );
    }
    if Operation == 17u32 {
        Result = Bytesˉconcat(
            Result, Compilerˉsourceˉwvbˉinstructionˉu32(104u8, Target)
        );
    }
    if Operation == 18u32 {
        Result = Bytesˉconcat(
            Result, Compilerˉsourceˉwvbˉinstructionˉu32(105u8, Auxiliary)
        );
    }
    if Operation == 19u32 {
        Result = Bytesˉconcat(
            Result, Compilerˉsourceˉwvbˉinstructionˉu32(106u8, Target)
        );
        Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Auxiliary));
    }
    if Operation == 62u32 {
        Result = Bytesˉconcat(
            Result,
            Compilerˉsourceˉwvbˉinstructionˉu32(
                64u8,
                Compilerˉsourceˉwvbˉorderedˉrank(
                    Compilerˉsourceˉwvbˉfunctionˉorder(Orders), Target
                )
            )
        );
    }
    if Operation == 63u32 {
        let Capabilityˉorder: Compilerˉsourceˉwvbˉsymbolˉorder =
            Compilerˉsourceˉwvbˉcapabilityˉorder(Orders);
        let Targetˉview: Sourceˉset.Compilerˉsourceˉsetˉview =
            Compilerˉsourceˉwvbˉsymbolˉsource(
            Input, Scan, Symbols, Target
        );
        let Targetˉentry: u32 = 16u32 + Target * 24u32;
        let Targetˉnameˉoffset: u32 = Bytesˉreadˉu32ˉlittle(
            Symbols.Directory, Targetˉentry + 12u32
        );
        let Targetˉnameˉlength: u32 = Bytesˉreadˉu32ˉlittle(
            Symbols.Directory, Targetˉentry + 16u32
        );
        var Capabilityˉrank: u32 = 0u32;
        var Searchˉrank: u32 = 0u32;
        var Searching: bool = true;
        while Searching {
            if Searchˉrank >= Symbols.Capabilities {
                Searching = false;
            } else {
                let Entry: u32 = Compilerˉsourceˉwvbˉorderedˉsymbol(
                    Capabilityˉorder, Searchˉrank
                );
                if Compilerˉsourceˉwvbˉsymbolˉmodule(Symbols, Entry) == 0u32 {
                    let Candidateˉview: Sourceˉset.Compilerˉsourceˉsetˉview =
                        Compilerˉsourceˉwvbˉsymbolˉsource(
                            Input, Scan, Symbols, Entry
                        );
                    let Candidateˉentry: u32 = 16u32 + Entry * 24u32;
                    let Candidateˉnameˉoffset: u32 = Bytesˉreadˉu32ˉlittle(
                        Symbols.Directory, Candidateˉentry + 12u32
                    );
                    let Candidateˉnameˉlength: u32 = Bytesˉreadˉu32ˉlittle(
                        Symbols.Directory, Candidateˉentry + 16u32
                    );
                    if Sourceˉset.Compilerˉsourceˉspansˉequal(
                        Candidateˉview.Source, Candidateˉnameˉoffset,
                        Candidateˉnameˉlength,
                        Targetˉview.Source, Targetˉnameˉoffset, Targetˉnameˉlength
                    ) {
                        Searching = false;
                    } else {
                        Capabilityˉrank = Capabilityˉrank + 1u32;
                    }
                }
                Searchˉrank = Searchˉrank + 1u32;
            }
        }
        Result = Bytesˉconcat(
            Result,
            Compilerˉsourceˉwvbˉinstructionˉu32(
                65u8,
                Capabilityˉrank
            )
        );
    }
    if Operation >= 65u32 {
        if Operation <= 67u32 {
            Result = Bytesˉconcat(
                Result,
                Compilerˉsourceˉwvbˉinstructionˉu32(
                    Compilerˉsourceˉwvbˉopcode(Operation), Target
                )
            );
            Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Auxiliary));
        }
    }
    if Operation == 68u32 {
        Result = Bytesˉconcat(
            Result,
            Compilerˉsourceˉwvbˉinstructionˉu32(
                Compilerˉsourceˉwvbˉopcode(Operation), Target
            )
        );
        Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Auxiliary));
    }
    if Operation >= 69u32 {
        if Operation <= 72u32 {
            Result = Bytesˉconcat(
                Result, Bytesˉfromˉu8(Compilerˉsourceˉwvbˉopcode(Operation))
            );
        }
    }
    if Operation >= 73u32 {
        if Operation <= 92u32 {
            Result = Bytesˉconcat(
                Result, Bytesˉfromˉu8(Compilerˉsourceˉwvbˉopcode(Operation))
            );
        }
    }
    if Operation >= 95u32 {
        if Operation <= 128u32 {
            Result = Bytesˉconcat(
                Result, Bytesˉfromˉu8(Compilerˉsourceˉwvbˉopcode(Operation))
            );
        }
    }
    if Operation >= 11u32 {
        if Operation <= 16u32 {
            Result = Bytesˉconcat(
                Result, Bytesˉfromˉu8(Compilerˉsourceˉwvbˉopcode(Operation))
            );
        }
    }
    if Operation >= 20u32 {
        if Operation <= 22u32 {
            Result = Bytesˉconcat(
                Result, Bytesˉfromˉu8(Compilerˉsourceˉwvbˉopcode(Operation))
            );
        }
    }
    if Operation >= 23u32 {
        if Operation <= 61u32 {
            Result = Bytesˉconcat(
                Result, Bytesˉfromˉu8(Compilerˉsourceˉwvbˉopcode(Operation))
            );
        }
    }
    if Shape != 0u32 {
        Result = Bytesˉconcat(
            Result,
            Compilerˉsourceˉwvbˉinstructionˉu32(
                5u8,
                Compilerˉsourceˉwvbˉtemporaryˉslot(
                    Temporary, Parameters, Locals, Temporaryˉmapping
                )
            )
        );
    }
    return Result;
}

export fn Compilerˉsourceˉwvbˉemitˉphiˉprelude(
    Wir: bytes,
    Firstˉblock: u32,
    Predecessor: u32,
    Targetˉblock: u32,
    Parameters: u32,
    Locals: u32,
    Temporaryˉmapping: bytes
) -> bytes {
    if Compilerˉsourceˉwvbˉphiˉpreludeˉlength(
        Wir, Firstˉblock, Predecessor, Targetˉblock
    ) == 0u32 { return Compilerˉsourceˉwvbˉempty(Wir); }
    let Targetˉentry: u32 = Compilerˉsourceˉwvbˉblocksˉoffset(Wir) +
        (Firstˉblock + Targetˉblock) * 36u32;
    let Firstˉoperation: u32 = Bytesˉreadˉu32ˉlittle(Wir, Targetˉentry + 12u32);
    let Phiˉentry: u32 = Compilerˉsourceˉwvbˉoperationsˉoffset(Wir) +
        Firstˉoperation * 48u32;
    let Firstˉoperand: u32 = Bytesˉreadˉu32ˉlittle(Wir, Phiˉentry + 24u32);
    var Operandˉindex: u32 = 0u32;
    if Bytesˉreadˉu32ˉlittle(Wir, Phiˉentry + 36u32) == Predecessor {
        Operandˉindex = 1u32;
    }
    let Operandˉtemporary: u32 = Bytesˉreadˉu32ˉlittle(
        Wir,
        Compilerˉsourceˉwvbˉoperandsˉoffset(Wir) +
            (Firstˉoperand + Operandˉindex) * 4u32
    );
    let Phiˉtemporary: u32 = Bytesˉreadˉu32ˉlittle(Wir, Phiˉentry + 20u32);
    let Loaded: bytes = Compilerˉsourceˉwvbˉloadˉtemporary(
        Operandˉtemporary, Parameters, Locals, Temporaryˉmapping
    );
    return Bytesˉconcat(
        Loaded,
        Compilerˉsourceˉwvbˉinstructionˉu32(
            5u8,
            Compilerˉsourceˉwvbˉtemporaryˉslot(
                Phiˉtemporary, Parameters, Locals, Temporaryˉmapping
            )
        )
    );
}

export fn Compilerˉsourceˉwvbˉemitˉterminator(
    Wir: bytes,
    Firstˉblock: u32,
    Blockˉentry: u32,
    Blockˉoffsets: bytes,
    Parameters: u32,
    Locals: u32,
    Temporaryˉmapping: bytes
) -> bytes {
    let Terminator: u32 = Bytesˉreadˉu32ˉlittle(Wir, Blockˉentry + 20u32);
    let Value: u32 = Bytesˉreadˉu32ˉlittle(Wir, Blockˉentry + 24u32);
    let Firstˉtarget: u32 = Bytesˉreadˉu32ˉlittle(Wir, Blockˉentry + 28u32);
    let Secondˉtarget: u32 = Bytesˉreadˉu32ˉlittle(Wir, Blockˉentry + 32u32);
    var Result: bytes = Compilerˉsourceˉwvbˉempty(Wir);
    if Terminator == 1u32 {
        let Predecessor: u32 = Bytesˉreadˉu32ˉlittle(Wir, Blockˉentry + 8u32);
        Result = Compilerˉsourceˉwvbˉemitˉphiˉprelude(
            Wir, Firstˉblock, Predecessor, Firstˉtarget,
            Parameters, Locals, Temporaryˉmapping
        );
        return Bytesˉconcat(
            Result,
            Compilerˉsourceˉwvbˉinstructionˉu32(
                48u8, Bytesˉreadˉu32ˉlittle(Blockˉoffsets, Firstˉtarget * 4u32)
            )
        );
    }
    if Terminator == 2u32 {
        Result = Compilerˉsourceˉwvbˉloadˉtemporary(
            Value, Parameters, Locals, Temporaryˉmapping
        );
        Result = Bytesˉconcat(
            Result,
            Compilerˉsourceˉwvbˉinstructionˉu32(
                49u8,
                Bytesˉreadˉu32ˉlittle(Blockˉoffsets, Secondˉtarget * 4u32)
            )
        );
        return Bytesˉconcat(
            Result,
            Compilerˉsourceˉwvbˉinstructionˉu32(
                48u8,
                Bytesˉreadˉu32ˉlittle(Blockˉoffsets, Firstˉtarget * 4u32)
            )
        );
    }
    if Value != Sourceˉwir.Compilerˉsourceˉwirˉsentinel() {
        Result = Compilerˉsourceˉwvbˉloadˉtemporary(
            Value, Parameters, Locals, Temporaryˉmapping
        );
    }
    return Bytesˉconcat(Result, Bytesˉfromˉu8(81u8));
}

export fn Compilerˉsourceˉwvbˉfunctionˉfailure(
    Wir: bytes,
    Status: Compilerˉsourceˉwvbˉstatus,
    Operation: u32
) -> Compilerˉsourceˉwvbˉfunctionˉencoding {
    let Empty: bytes = Compilerˉsourceˉwvbˉempty(Wir);
    return Compilerˉsourceˉwvbˉfunctionˉencoding(
        Status, Empty, Empty, Operation, false, false
    );
}

export fn Compilerˉsourceˉwvbˉinferredˉlocalˉshape(
    Wir: bytes,
    Function: u32,
    Slot: u32
) -> u32 {
    let Functionˉentry: u32 = 48u32 + Function * 48u32;
    let Firstˉoperation: u32 = Bytesˉreadˉu32ˉlittle(
        Wir, Functionˉentry + 12u32
    );
    let Operationˉcount: u32 = Bytesˉreadˉu32ˉlittle(
        Wir, Functionˉentry + 16u32
    );
    let Firstˉtemporary: u32 = Bytesˉreadˉu32ˉlittle(
        Wir, Functionˉentry + 20u32
    );
    let Operationsˉoffset: u32 = Compilerˉsourceˉwvbˉoperationsˉoffset(Wir);
    let Temporariesˉoffset: u32 = Compilerˉsourceˉwvbˉtemporariesˉoffset(Wir);
    let Operandsˉoffset: u32 = Compilerˉsourceˉwvbˉoperandsˉoffset(Wir);
    var Index: u32 = 0u32;
    while Index < Operationˉcount {
        let Operationˉentry: u32 = Operationsˉoffset + (
            Firstˉoperation + Index
        ) * 48u32;
        if Bytesˉreadˉu32ˉlittle(Wir, Operationˉentry + 12u32) == 8u32 {
            if Bytesˉreadˉu32ˉlittle(Wir, Operationˉentry + 32u32) == Slot {
                let Firstˉoperand: u32 = Bytesˉreadˉu32ˉlittle(
                    Wir, Operationˉentry + 24u32
                );
                let Temporary: u32 = Bytesˉreadˉu32ˉlittle(
                    Wir, Operandsˉoffset + Firstˉoperand * 4u32
                );
                return Bytesˉreadˉu32ˉlittle(
                    Wir,
                    Temporariesˉoffset + (Firstˉtemporary + Temporary) * 4u32
                );
            }
        }
        Index = Index + 1u32;
    }
    return 0u32;
}

export fn Compilerˉsourceˉwvbˉencodeˉfunction(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Source: bytes,
    Header: Sourceˉdeclarations.Compilerˉsourceˉheader,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Bindings: Sourceˉbindings.Compilerˉsourceˉbindingˉsummary,
    Orders: Compilerˉsourceˉwvbˉsymbolˉorders,
    Plan: Compilerˉsourceˉwvbˉtextˉplan,
    Wir: bytes,
    Function: u32,
    Codeˉoffset: u32,
    Emitˉcode: bool
) -> Compilerˉsourceˉwvbˉfunctionˉencoding {
    let Analysis: Compilerˉsourceˉwvbˉanalysis =
        Compilerˉsourceˉwvbˉanalyzeˉfunction(
            Wir, Function, Symbols.Records, Symbols.Enums, Symbols.Variants
        );
    if Analysis.Status != Compilerˉsourceˉwvbˉstatus.Valid {
        return Compilerˉsourceˉwvbˉfunctionˉfailure(
            Wir, Analysis.Status, Analysis.Failureˉoperation
        );
    }
    let Functionˉentry: u32 = 48u32 + Function * 48u32;
    let Firstˉblock: u32 = Bytesˉreadˉu32ˉlittle(Wir, Functionˉentry + 4u32);
    let Blockˉcount: u32 = Bytesˉreadˉu32ˉlittle(Wir, Functionˉentry + 8u32);
    let Firstˉoperation: u32 = Bytesˉreadˉu32ˉlittle(
        Wir, Functionˉentry + 12u32
    );
    let Operationˉcount: u32 = Bytesˉreadˉu32ˉlittle(
        Wir, Functionˉentry + 16u32
    );
    let Firstˉtemporary: u32 = Bytesˉreadˉu32ˉlittle(Wir, Functionˉentry + 20u32);
    let Temporaryˉcount: u32 = Bytesˉreadˉu32ˉlittle(Wir, Functionˉentry + 24u32);
    let Parameters: u32 = Bytesˉreadˉu32ˉlittle(Wir, Functionˉentry + 36u32);
    let Locals: u32 = Bytesˉreadˉu32ˉlittle(Wir, Functionˉentry + 40u32);
    let Returnˉshape: u32 = Bytesˉreadˉu32ˉlittle(Wir, Functionˉentry + 44u32);
    var Hasˉcollections: bool =
        Sourceˉwir.Compilerˉsourceˉwirˉshapeˉisˉsequence(Returnˉshape) ||
        Sourceˉwir.Compilerˉsourceˉwirˉshapeˉisˉbuilder(Returnˉshape);
    var Hasˉoperators: bool = false;
    if !Compilerˉsourceˉwvbˉshapeˉisˉsupported(
        Returnˉshape, true, Symbols.Records, Symbols.Enums, Symbols.Variants
    ) {
        return Compilerˉsourceˉwvbˉfunctionˉfailure(
            Wir, Compilerˉsourceˉwvbˉstatus.Unsupportedˉshape,
            Analysis.Failureˉoperation
        );
    }
    let Blocksˉoffset: u32 = Compilerˉsourceˉwvbˉblocksˉoffset(Wir);
    let Operationsˉoffset: u32 = Compilerˉsourceˉwvbˉoperationsˉoffset(Wir);
    let Temporariesˉoffset: u32 = Compilerˉsourceˉwvbˉtemporariesˉoffset(Wir);
    let Operandsˉoffset: u32 = Compilerˉsourceˉwvbˉoperandsˉoffset(Wir);
    var Temporaryˉallocation: Temporaryˉslots.Compilerˉsourceˉwvbˉtemporaryˉslotˉallocation =
        Temporaryˉslots.Compilerˉsourceˉwvbˉidentityˉtemporaryˉslots(
            Wir, Temporariesˉoffset, Firstˉtemporary, Temporaryˉcount
        );
    if Parameters + Locals + Temporaryˉcount > 4096u32 {
        Temporaryˉallocation =
            Temporaryˉslots.Compilerˉsourceˉwvbˉallocateˉtemporaryˉslots(
                Wir,
                Blocksˉoffset,
                Operationsˉoffset,
                Temporariesˉoffset,
                Operandsˉoffset,
                Firstˉblock,
                Blockˉcount,
                Firstˉoperation,
                Operationˉcount,
                Firstˉtemporary,
                Temporaryˉcount
            );
    }
    if Temporaryˉallocation.Status !=
        Temporaryˉslots.Compilerˉsourceˉwvbˉtemporaryˉslotˉstatus.Valid {
        return Compilerˉsourceˉwvbˉfunctionˉfailure(
            Wir, Compilerˉsourceˉwvbˉstatus.Bytecodeˉlimit,
            Analysis.Failureˉoperation
        );
    }
    if Parameters + Locals + Temporaryˉallocation.Slots > 4096u32 {
        return Compilerˉsourceˉwvbˉfunctionˉfailure(
            Wir, Compilerˉsourceˉwvbˉstatus.Bytecodeˉlimit,
            Analysis.Failureˉoperation
        );
    }
    let Symbolˉentry: u32 = 16u32 + Function * 24u32;
    let Nameˉoffset: u32 = Bytesˉreadˉu32ˉlittle(
        Symbols.Directory, Symbolˉentry + 12u32
    );
    let Nameˉlength: u32 = Bytesˉreadˉu32ˉlittle(
        Symbols.Directory, Symbolˉentry + 16u32
    );
    let Symbolˉentries: u32 = Bytesˉreadˉu32ˉlittle(Symbols.Directory, 8u32);
    let Bindingˉrange: u32 = 24u32 + Function * 8u32;
    let Firstˉbinding: u32 = Bytesˉreadˉu32ˉlittle(
        Bindings.Directory, Bindingˉrange
    );
    let Bindingˉcount: u32 = Bytesˉreadˉu32ˉlittle(
        Bindings.Directory, Bindingˉrange + 4u32
    );
    let Bindingˉpayload: u32 = 24u32 + Symbolˉentries * 8u32;
    var Metadata: bytes = Compilerˉsourceˉwvbˉencodedˉstring(
        Compilerˉsourceˉwvbˉsymbolˉname(Input, Scan, Symbols, Function)
    );
    Metadata = Bytesˉconcat(Metadata, Bytesˉfromˉu32ˉlittle(Parameters));
    var Index: u32 = 0u32;
    while Index < Parameters {
        let Parameterˉshape: u32 = Bytesˉreadˉu32ˉlittle(
            Bindings.Directory,
            Bindingˉpayload + (Firstˉbinding + Index) * 36u32 + 24u32
        );
        if !Compilerˉsourceˉwvbˉshapeˉisˉsupported(
            Parameterˉshape, false, Symbols.Records, Symbols.Enums, Symbols.Variants
        ) {
            return Compilerˉsourceˉwvbˉfunctionˉfailure(
                Wir, Compilerˉsourceˉwvbˉstatus.Unsupportedˉshape,
                Analysis.Failureˉoperation
            );
        }
        if Sourceˉwir.Compilerˉsourceˉwirˉshapeˉisˉsequence(Parameterˉshape) ||
            Sourceˉwir.Compilerˉsourceˉwirˉshapeˉisˉbuilder(Parameterˉshape) {
            Hasˉcollections = true;
        }
        Metadata = Bytesˉconcat(
            Metadata, Compilerˉsourceˉwvbˉshape(Parameterˉshape)
        );
        Index = Index + 1u32;
    }
    Metadata = Bytesˉconcat(
        Metadata, Compilerˉsourceˉwvbˉshape(Returnˉshape)
    );
    Metadata = Bytesˉconcat(
        Metadata,
        Bytesˉfromˉu32ˉlittle(Locals + Temporaryˉallocation.Slots)
    );
    Index = 0u32;
    while Index < Locals {
        var Localˉshape: u32 = 0u32;
        if Parameters + Index < Bindingˉcount {
            Localˉshape = Bytesˉreadˉu32ˉlittle(
                Bindings.Directory,
                Bindingˉpayload + (Firstˉbinding + Parameters + Index) * 36u32 + 24u32
            );
        }
        if Localˉshape == 0u32 {
            Localˉshape = Compilerˉsourceˉwvbˉinferredˉlocalˉshape(
                Wir, Function, Parameters + Index
            );
        }
        if !Compilerˉsourceˉwvbˉshapeˉisˉsupported(
            Localˉshape, false, Symbols.Records, Symbols.Enums, Symbols.Variants
        ) {
            return Compilerˉsourceˉwvbˉfunctionˉfailure(
                Wir, Compilerˉsourceˉwvbˉstatus.Unsupportedˉshape,
                Analysis.Failureˉoperation
            );
        }
        if Sourceˉwir.Compilerˉsourceˉwirˉshapeˉisˉsequence(Localˉshape) ||
            Sourceˉwir.Compilerˉsourceˉwirˉshapeˉisˉbuilder(Localˉshape) {
            Hasˉcollections = true;
        }
        Metadata = Bytesˉconcat(
            Metadata, Compilerˉsourceˉwvbˉshape(Localˉshape)
        );
        Index = Index + 1u32;
    }
    Index = 0u32;
    while Index < Temporaryˉallocation.Slots {
        let Temporaryˉshape: u32 = Bytesˉreadˉu32ˉlittle(
            Temporaryˉallocation.Shapes, Index * 4u32
        );
        if !Compilerˉsourceˉwvbˉshapeˉisˉsupported(
            Temporaryˉshape, false, Symbols.Records, Symbols.Enums, Symbols.Variants
        ) {
            return Compilerˉsourceˉwvbˉfunctionˉfailure(
                Wir, Compilerˉsourceˉwvbˉstatus.Unsupportedˉshape,
                Analysis.Failureˉoperation
            );
        }
        if Sourceˉwir.Compilerˉsourceˉwirˉshapeˉisˉsequence(Temporaryˉshape) ||
            Sourceˉwir.Compilerˉsourceˉwirˉshapeˉisˉbuilder(Temporaryˉshape) {
            Hasˉcollections = true;
        }
        Metadata = Bytesˉconcat(
            Metadata, Compilerˉsourceˉwvbˉshape(Temporaryˉshape)
        );
        Index = Index + 1u32;
    }
    Metadata = Bytesˉconcat(Metadata, Bytesˉfromˉu32ˉlittle(Codeˉoffset));
    Metadata = Bytesˉconcat(
        Metadata, Bytesˉfromˉu32ˉlittle(Analysis.Codeˉlength)
    );
    Metadata = Bytesˉconcat(
        Metadata, Bytesˉfromˉu32ˉlittle(Analysis.Maximumˉstack)
    );

    var Code: bytes = Compilerˉsourceˉwvbˉempty(Wir);
    var Block: u32 = 0u32;
    if Emitˉcode {
        while Block < Blockˉcount {
            let Blockˉentry: u32 = Blocksˉoffset + (Firstˉblock + Block) * 36u32;
            let Blockˉfirstˉoperation: u32 = Bytesˉreadˉu32ˉlittle(
                Wir, Blockˉentry + 12u32
            );
            let Blockˉoperationˉcount: u32 = Bytesˉreadˉu32ˉlittle(
                Wir, Blockˉentry + 16u32
            );
            var Inˉblock: u32 = 0u32;
            while Inˉblock < Blockˉoperationˉcount {
                let Operationˉentry: u32 = Operationsˉoffset +
                    (Blockˉfirstˉoperation + Inˉblock) * 48u32;
                let Operationˉkind: u32 = Bytesˉreadˉu32ˉlittle(
                    Wir, Operationˉentry + 12u32
                );
                if Operationˉkind >= 73u32 { Hasˉoperators = true; }
                Code = Bytesˉconcat(
                    Code,
                    Compilerˉsourceˉwvbˉemitˉoperation(
                        Input, Scan, Source, Symbols, Orders, Plan, Wir,
                        Operationˉentry, Parameters, Locals,
                        Temporaryˉallocation.Mapping
                    )
                );
                Inˉblock = Inˉblock + 1u32;
            }
            Code = Bytesˉconcat(
                Code,
                Compilerˉsourceˉwvbˉemitˉterminator(
                    Wir, Firstˉblock, Blockˉentry,
                    Analysis.Blockˉoffsets, Parameters, Locals,
                    Temporaryˉallocation.Mapping
                )
            );
            Block = Block + 1u32;
        }
    }
    if Emitˉcode && Bytesˉlength(Code) != Analysis.Codeˉlength {
        return Compilerˉsourceˉwvbˉfunctionˉfailure(
            Wir, Compilerˉsourceˉwvbˉstatus.Bytecodeˉlimit,
            Analysis.Failureˉoperation
        );
    }
    return Compilerˉsourceˉwvbˉfunctionˉencoding(
        Compilerˉsourceˉwvbˉstatus.Valid,
        Metadata,
        Code,
        Analysis.Failureˉoperation,
        Hasˉcollections,
        Hasˉoperators
    );
}

export fn Compilerˉsourceˉwvbˉreachabilityˉwithˉevidence(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Wirˉsummary: Sourceˉwir.Compilerˉsourceˉwirˉsummary,
    Orders: Compilerˉsourceˉwvbˉsymbolˉorders
) -> Compilerˉsourceˉwvbˉreachability {
    let Functionˉorder: Compilerˉsourceˉwvbˉsymbolˉorder =
        Compilerˉsourceˉwvbˉfunctionˉorder(Orders);
    let Entries: u32 = Bytesˉreadˉu32ˉlittle(Symbols.Directory, 8u32);
    let Emptyˉmap: Byteˉconstruction.Foundationˉbytesˉresult =
        Byteˉconstruction.Foundationˉbytesˉrepeat(0u8, Entries);
    if !Emptyˉmap.Valid {
        return Compilerˉsourceˉwvbˉreachabilityˉfailure(
            Input,
            Compilerˉsourceˉwvbˉstatus.Bytecodeˉlimit,
            Wirˉsummary.Status,
            0u32,
            0u32
        );
    }

    var Map: bytes = Emptyˉmap.Value;
    var Queue: bytes = Compilerˉsourceˉwvbˉempty(Input);
    var Roots: u32 = 0u32;
    var Reachable: u32 = 0u32;
    var Functionˉrank: u32 = 0u32;
    while Functionˉrank < Symbols.Functions {
        let Rootˉfunction: u32 = Compilerˉsourceˉwvbˉorderedˉsymbol(
            Functionˉorder, Functionˉrank
        );
        if Compilerˉsourceˉwvbˉsymbolˉmodule(Symbols, Rootˉfunction) == 0u32 {
            if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉlookupˉisˉexported(
                Symbols.Lookup, Rootˉfunction
            ) {
                let Rootˉmarked: Byteˉconstruction.Foundationˉbytesˉresult =
                    Byteˉconstruction.Foundationˉbytesˉreplace(
                        Map, Rootˉfunction, 1u32, Bytesˉfromˉu8(1u8)
                    );
                if !Rootˉmarked.Valid {
                    return Compilerˉsourceˉwvbˉreachabilityˉfailure(
                        Input,
                        Compilerˉsourceˉwvbˉstatus.Invalidˉdata,
                        Wirˉsummary.Status,
                        Functionˉrank,
                        0u32
                    );
                }
                Map = Rootˉmarked.Value;
                Queue = Bytesˉconcat(
                    Queue, Bytesˉfromˉu32ˉlittle(Rootˉfunction)
                );
                Roots = Roots + 1u32;
                Reachable = Reachable + 1u32;
            }
        }
        Functionˉrank = Functionˉrank + 1u32;
    }

    let Wir: bytes = Wirˉsummary.Directory;
    let Blocksˉoffset: u32 = Compilerˉsourceˉwvbˉblocksˉoffset(Wir);
    let Operationsˉoffset: u32 = Compilerˉsourceˉwvbˉoperationsˉoffset(Wir);
    var Reachableˉcodeˉbytes: u32 = 0u32;
    var Reachableˉcalls: u32 = 0u32;
    var Queueˉindex: u32 = 0u32;
    while Queueˉindex < Reachable {
        let Reachableˉfunction: u32 = Bytesˉreadˉu32ˉlittle(
            Queue, Queueˉindex * 4u32
        );
        let Reachableˉanalysis: Compilerˉsourceˉwvbˉanalysis =
            Compilerˉsourceˉwvbˉanalyzeˉfunction(
                Wir, Reachableˉfunction,
                Symbols.Records, Symbols.Enums, Symbols.Variants
            );
        if Reachableˉanalysis.Status != Compilerˉsourceˉwvbˉstatus.Valid {
            return Compilerˉsourceˉwvbˉreachabilityˉfailure(
                Input,
                Reachableˉanalysis.Status,
                Wirˉsummary.Status,
                Compilerˉsourceˉwvbˉorderedˉrank(
                    Functionˉorder, Reachableˉfunction
                ),
                Reachableˉanalysis.Failureˉoperation
            );
        }
        if Reachableˉcodeˉbytes >
            16777216u32 - Reachableˉanalysis.Codeˉlength {
            return Compilerˉsourceˉwvbˉreachabilityˉfailure(
                Input,
                Compilerˉsourceˉwvbˉstatus.Bytecodeˉlimit,
                Wirˉsummary.Status,
                Compilerˉsourceˉwvbˉorderedˉrank(
                    Functionˉorder, Reachableˉfunction
                ),
                Reachableˉanalysis.Failureˉoperation
            );
        }
        Reachableˉcodeˉbytes =
            Reachableˉcodeˉbytes + Reachableˉanalysis.Codeˉlength;

        let Reachableˉfunctionˉentry: u32 =
            48u32 + Reachableˉfunction * 48u32;
        let Reachableˉfirstˉblock: u32 = Bytesˉreadˉu32ˉlittle(
            Wir, Reachableˉfunctionˉentry + 4u32
        );
        let Reachableˉblockˉcount: u32 = Bytesˉreadˉu32ˉlittle(
            Wir, Reachableˉfunctionˉentry + 8u32
        );
        var Reachableˉblock: u32 = 0u32;
        while Reachableˉblock < Reachableˉblockˉcount {
            let Reachableˉblockˉentry: u32 = Blocksˉoffset +
                (Reachableˉfirstˉblock + Reachableˉblock) * 36u32;
            let Reachableˉfirstˉoperation: u32 = Bytesˉreadˉu32ˉlittle(
                Wir, Reachableˉblockˉentry + 12u32
            );
            let Reachableˉoperationˉcount: u32 = Bytesˉreadˉu32ˉlittle(
                Wir, Reachableˉblockˉentry + 16u32
            );
            var Reachableˉinˉblock: u32 = 0u32;
            while Reachableˉinˉblock < Reachableˉoperationˉcount {
                let Reachableˉoperationˉentry: u32 = Operationsˉoffset +
                    (Reachableˉfirstˉoperation + Reachableˉinˉblock) * 48u32;
                if Bytesˉreadˉu32ˉlittle(
                    Wir, Reachableˉoperationˉentry + 12u32
                ) == 62u32 {
                    Reachableˉcalls = Reachableˉcalls + 1u32;
                    let Reachableˉtarget: u32 = Bytesˉreadˉu32ˉlittle(
                        Wir, Reachableˉoperationˉentry + 32u32
                    );
                    if Bytesˉreadˉu8(Map, Reachableˉtarget) == 0u8 {
                        let Reachableˉmarked: Byteˉconstruction.Foundationˉbytesˉresult =
                            Byteˉconstruction.Foundationˉbytesˉreplace(
                                Map, Reachableˉtarget,
                                1u32, Bytesˉfromˉu8(1u8)
                            );
                        if !Reachableˉmarked.Valid {
                            return Compilerˉsourceˉwvbˉreachabilityˉfailure(
                                Input,
                                Compilerˉsourceˉwvbˉstatus.Invalidˉdata,
                                Wirˉsummary.Status,
                                Compilerˉsourceˉwvbˉorderedˉrank(
                                    Functionˉorder, Reachableˉfunction
                                ),
                                Reachableˉfirstˉoperation + Reachableˉinˉblock
                            );
                        }
                        Map = Reachableˉmarked.Value;
                        Queue = Bytesˉconcat(
                            Queue, Bytesˉfromˉu32ˉlittle(Reachableˉtarget)
                        );
                        Reachable = Reachable + 1u32;
                    }
                }
                Reachableˉinˉblock = Reachableˉinˉblock + 1u32;
            }
            Reachableˉblock = Reachableˉblock + 1u32;
        }
        Queueˉindex = Queueˉindex + 1u32;
    }

    var Unreachableˉcodeˉbytes: u32 = 0u32;
    var Unreachableˉcalls: u32 = 0u32;
    Functionˉrank = 0u32;
    while Functionˉrank < Symbols.Functions {
        let Unreachableˉfunction: u32 = Compilerˉsourceˉwvbˉorderedˉsymbol(
            Functionˉorder, Functionˉrank
        );
        if Bytesˉreadˉu8(Map, Unreachableˉfunction) == 0u8 {
            let Unreachableˉanalysis: Compilerˉsourceˉwvbˉanalysis =
                Compilerˉsourceˉwvbˉanalyzeˉfunction(
                    Wir, Unreachableˉfunction,
                    Symbols.Records, Symbols.Enums, Symbols.Variants
                );
            if Unreachableˉanalysis.Status !=
                Compilerˉsourceˉwvbˉstatus.Valid {
                return Compilerˉsourceˉwvbˉreachabilityˉfailure(
                    Input,
                    Unreachableˉanalysis.Status,
                    Wirˉsummary.Status,
                    Functionˉrank,
                    Unreachableˉanalysis.Failureˉoperation
                );
            }
            if Unreachableˉcodeˉbytes >
                16777216u32 - Unreachableˉanalysis.Codeˉlength {
                return Compilerˉsourceˉwvbˉreachabilityˉfailure(
                    Input,
                    Compilerˉsourceˉwvbˉstatus.Bytecodeˉlimit,
                    Wirˉsummary.Status,
                    Functionˉrank,
                    Unreachableˉanalysis.Failureˉoperation
                );
            }
            Unreachableˉcodeˉbytes =
                Unreachableˉcodeˉbytes + Unreachableˉanalysis.Codeˉlength;

            let Unreachableˉfunctionˉentry: u32 =
                48u32 + Unreachableˉfunction * 48u32;
            let Unreachableˉfirstˉblock: u32 = Bytesˉreadˉu32ˉlittle(
                Wir, Unreachableˉfunctionˉentry + 4u32
            );
            let Unreachableˉblockˉcount: u32 = Bytesˉreadˉu32ˉlittle(
                Wir, Unreachableˉfunctionˉentry + 8u32
            );
            var Unreachableˉblock: u32 = 0u32;
            while Unreachableˉblock < Unreachableˉblockˉcount {
                let Unreachableˉblockˉentry: u32 = Blocksˉoffset +
                    (Unreachableˉfirstˉblock + Unreachableˉblock) * 36u32;
                let Unreachableˉfirstˉoperation: u32 =
                    Bytesˉreadˉu32ˉlittle(
                        Wir, Unreachableˉblockˉentry + 12u32
                    );
                let Unreachableˉoperationˉcount: u32 =
                    Bytesˉreadˉu32ˉlittle(
                        Wir, Unreachableˉblockˉentry + 16u32
                    );
                var Unreachableˉinˉblock: u32 = 0u32;
                while Unreachableˉinˉblock < Unreachableˉoperationˉcount {
                    let Unreachableˉoperationˉentry: u32 = Operationsˉoffset +
                        (Unreachableˉfirstˉoperation + Unreachableˉinˉblock) *
                        48u32;
                    if Bytesˉreadˉu32ˉlittle(
                        Wir, Unreachableˉoperationˉentry + 12u32
                    ) == 62u32 {
                        Unreachableˉcalls = Unreachableˉcalls + 1u32;
                    }
                    Unreachableˉinˉblock = Unreachableˉinˉblock + 1u32;
                }
                Unreachableˉblock = Unreachableˉblock + 1u32;
            }
        }
        Functionˉrank = Functionˉrank + 1u32;
    }

    if Reachableˉcodeˉbytes > 16777216u32 - Unreachableˉcodeˉbytes {
        return Compilerˉsourceˉwvbˉreachabilityˉfailure(
            Input,
            Compilerˉsourceˉwvbˉstatus.Bytecodeˉlimit,
            Wirˉsummary.Status,
            Symbols.Functions,
            Wirˉsummary.Operations
        );
    }
    return Compilerˉsourceˉwvbˉreachability(
        Compilerˉsourceˉwvbˉstatus.Valid,
        Wirˉsummary.Status,
        Symbols.Functions,
        Roots,
        Reachable,
        Symbols.Functions - Reachable,
        Reachableˉcalls + Unreachableˉcalls,
        Reachableˉcalls,
        Reachableˉcodeˉbytes + Unreachableˉcodeˉbytes,
        Reachableˉcodeˉbytes,
        Unreachableˉcodeˉbytes,
        Map,
        Symbols.Functions,
        Wirˉsummary.Operations
    );
}

export fn Compilerˉanalyzeˉsourceˉwvbˉreachability(
    Input: bytes
) -> Compilerˉsourceˉwvbˉreachability {
    let Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary =
        Sourceˉsymbols.Compilerˉvalidateˉsourceˉsymbols(Input);
    let Scan: Sourceˉset.Compilerˉsourceˉsetˉscan =
        Sourceˉset.Compilerˉscanˉsourceˉset(Input);
    let Wirˉcompilation: Sourceˉwir.Compilerˉsourceˉwirˉcompilation =
        Sourceˉwir.Compilerˉprepareˉsourceˉwirˉwithˉsymbols(
            Input, Scan, Symbols
        );
    let Wirˉsummary: Sourceˉwir.Compilerˉsourceˉwirˉsummary =
        Sourceˉwir.Compilerˉsourceˉwirˉcompilationˉsummary(Wirˉcompilation);
    if Wirˉsummary.Status != Sourceˉwir.Compilerˉsourceˉwirˉstatus.Valid {
        return Compilerˉsourceˉwvbˉreachabilityˉfailure(
            Input,
            Compilerˉsourceˉwvbˉstatus.Sourceˉwir,
            Wirˉsummary.Status,
            Wirˉsummary.Failureˉfunction,
            0u32
        );
    }
    let Orders: Compilerˉsourceˉwvbˉsymbolˉorders =
        Compilerˉsourceˉwvbˉbuildˉsymbolˉorders(Input, Scan, Symbols);
    return Compilerˉsourceˉwvbˉreachabilityˉwithˉevidence(
        Input, Scan, Symbols, Wirˉsummary, Orders
    );
}

export fn Compilerˉsourceˉwvbˉcompile(
    Input: bytes,
    Optimize: bool
) -> Compilerˉsourceˉwvbˉsummary {
    let Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary =
        Sourceˉsymbols.Compilerˉvalidateˉsourceˉsymbols(Input);
    let Scan: Sourceˉset.Compilerˉsourceˉsetˉscan =
        Sourceˉset.Compilerˉscanˉsourceˉset(Input);
    let Wirˉcompilation: Sourceˉwir.Compilerˉsourceˉwirˉcompilation =
        Sourceˉwir.Compilerˉprepareˉsourceˉwirˉwithˉsymbols(
            Input, Scan, Symbols
        );
    let Wirˉsummary: Sourceˉwir.Compilerˉsourceˉwirˉsummary =
        Sourceˉwir.Compilerˉsourceˉwirˉcompilationˉsummary(Wirˉcompilation);
    if Wirˉsummary.Status != Sourceˉwir.Compilerˉsourceˉwirˉstatus.Valid {
        return Compilerˉsourceˉwvbˉsummaryˉfailure(
            Input,
            Compilerˉsourceˉwvbˉstatus.Sourceˉwir,
            Wirˉsummary.Status,
            Wirˉsummary.Failureˉfunction,
            0u32
        );
    }
    let Bindings: Sourceˉbindings.Compilerˉsourceˉbindingˉsummary =
        Sourceˉwir.Compilerˉsourceˉwirˉcompilationˉbindings(
            Symbols, Wirˉcompilation
        );
    let Root: Sourceˉset.Compilerˉsourceˉsetˉview = Sourceˉset.Compilerˉsourceˉsetˉmodule(
        Input, Scan, 0u32
    );
    let Rootˉheader: Sourceˉdeclarations.Compilerˉsourceˉheader = Sourceˉdeclarations.Compilerˉparseˉheaderˉvalidated(
        Root.Source
    );
    let Orders: Compilerˉsourceˉwvbˉsymbolˉorders =
        Compilerˉsourceˉwvbˉbuildˉsymbolˉorders(Input, Scan, Symbols);
    var Emissionˉorders: Compilerˉsourceˉwvbˉsymbolˉorders = Orders;
    var Emissionˉfunctions: u32 = Symbols.Functions;
    var Reachableˉmap: bytes = Compilerˉsourceˉwvbˉempty(Input);
    if Optimize {
        let Pruning: Compilerˉsourceˉwvbˉreachability =
            Compilerˉsourceˉwvbˉreachabilityˉwithˉevidence(
                Input, Scan, Symbols, Wirˉsummary, Orders
            );
        if Pruning.Status != Compilerˉsourceˉwvbˉstatus.Valid {
            return Compilerˉsourceˉwvbˉsummaryˉfailure(
                Input,
                Pruning.Status,
                Pruning.Wirˉstatus,
                Pruning.Failureˉfunction,
                Pruning.Failureˉoperation
            );
        }
        let Retainedˉfunctions: Compilerˉsourceˉwvbˉsymbolˉorder =
            Compilerˉsourceˉwvbˉreachableˉfunctionˉorder(
                Input,
                Symbols,
                Compilerˉsourceˉwvbˉfunctionˉorder(Orders),
                Pruning
            );
        Emissionˉorders = Compilerˉsourceˉwvbˉwithˉfunctionˉorder(
            Orders, Retainedˉfunctions
        );
        Emissionˉfunctions = Pruning.Reachable;
        Reachableˉmap = Pruning.Map;
        let Retainedˉdata: Compilerˉsourceˉwvbˉsymbolˉorder =
            Compilerˉsourceˉwvbˉreachableˉdataˉorder(
                Input,
                Scan,
                Symbols,
                Compilerˉsourceˉwvbˉfunctionˉorder(Emissionˉorders),
                Emissionˉfunctions,
                Compilerˉsourceˉwvbˉdataˉorder(Orders),
                Wirˉsummary.Directory
            );
        Emissionˉorders = Compilerˉsourceˉwvbˉwithˉdataˉorder(
            Emissionˉorders, Retainedˉdata
        );
    }

    let Capabilityˉencoding: Compilerˉsourceˉwvbˉcapabilityˉencoding =
        Compilerˉsourceˉwvbˉencodeˉcapabilities(
            Input, Scan, Symbols,
            Compilerˉsourceˉwvbˉcapabilityˉorder(Orders)
        );
    if Capabilityˉencoding.Status != Compilerˉsourceˉwvbˉstatus.Valid {
        return Compilerˉsourceˉwvbˉsummaryˉfailure(
            Input,
            Capabilityˉencoding.Status,
            Wirˉsummary.Status,
            0u32,
            0u32
        );
    }

    let Validationˉtextˉplan: Compilerˉsourceˉwvbˉtextˉplan =
        Compilerˉsourceˉwvbˉcollectˉtextˉplan(
            Input, Scan, Symbols,
            Compilerˉsourceˉwvbˉfunctionˉorder(Orders),
            Symbols.Functions,
            Wirˉsummary.Directory
        );
    if Validationˉtextˉplan.Status != Compilerˉsourceˉwvbˉstatus.Valid {
        return Compilerˉsourceˉwvbˉsummaryˉfailure(
            Input,
            Validationˉtextˉplan.Status,
            Wirˉsummary.Status,
            Symbols.Functions,
            Wirˉsummary.Operations
        );
    }
    var Textˉplan: Compilerˉsourceˉwvbˉtextˉplan = Validationˉtextˉplan;
    if Optimize {
        let Emissionˉtextˉplan: Compilerˉsourceˉwvbˉtextˉplan =
            Compilerˉsourceˉwvbˉcollectˉtextˉplan(
                Input, Scan, Symbols,
                Compilerˉsourceˉwvbˉfunctionˉorder(Emissionˉorders),
                Emissionˉfunctions,
                Wirˉsummary.Directory
            );
        if Emissionˉtextˉplan.Status !=
            Compilerˉsourceˉwvbˉstatus.Valid {
            return Compilerˉsourceˉwvbˉsummaryˉfailure(
                Input,
                Emissionˉtextˉplan.Status,
                Wirˉsummary.Status,
                Symbols.Functions,
                Wirˉsummary.Operations
            );
        }
        Textˉplan = Emissionˉtextˉplan;
    }
    let Validationˉdataˉencoding: Compilerˉsourceˉwvbˉdataˉencoding =
        Compilerˉsourceˉwvbˉencodeˉdata(
            Input, Scan, Symbols, Validationˉtextˉplan,
            Compilerˉsourceˉwvbˉdataˉorder(Orders)
        );
    if Validationˉdataˉencoding.Status !=
        Compilerˉsourceˉwvbˉstatus.Valid {
        return Compilerˉsourceˉwvbˉsummaryˉfailure(
            Input,
            Validationˉdataˉencoding.Status,
            Wirˉsummary.Status,
            Symbols.Functions,
            Wirˉsummary.Operations
        );
    }
    var Dataˉencoding: Compilerˉsourceˉwvbˉdataˉencoding =
        Validationˉdataˉencoding;
    if Optimize {
        let Emissionˉdataˉencoding: Compilerˉsourceˉwvbˉdataˉencoding =
            Compilerˉsourceˉwvbˉencodeˉdata(
                Input, Scan, Symbols, Textˉplan,
                Compilerˉsourceˉwvbˉdataˉorder(Emissionˉorders)
            );
        if Emissionˉdataˉencoding.Status !=
            Compilerˉsourceˉwvbˉstatus.Valid {
            return Compilerˉsourceˉwvbˉsummaryˉfailure(
                Input,
                Emissionˉdataˉencoding.Status,
                Wirˉsummary.Status,
                Symbols.Functions,
                Wirˉsummary.Operations
            );
        }
        Dataˉencoding = Emissionˉdataˉencoding;
    }
    let Typeˉencoding: Compilerˉsourceˉwvbˉtypeˉencoding =
        Compilerˉsourceˉwvbˉencodeˉtypes(
            Input, Scan, Symbols,
            Compilerˉsourceˉwvbˉrecordˉorder(Orders),
            Compilerˉsourceˉwvbˉenumˉorder(Orders),
            Compilerˉsourceˉwvbˉvariantˉorder(Orders)
        );
    if Typeˉencoding.Status != Compilerˉsourceˉwvbˉstatus.Valid {
        return Compilerˉsourceˉwvbˉsummaryˉfailure(
            Input,
            Typeˉencoding.Status,
            Wirˉsummary.Status,
            Symbols.Functions,
            Wirˉsummary.Operations
        );
    }

    if Optimize {
        var Validationˉrank: u32 = 0u32;
        while Validationˉrank < Symbols.Functions {
            let Validationˉfunction: u32 =
                Compilerˉsourceˉwvbˉorderedˉsymbol(
                    Compilerˉsourceˉwvbˉfunctionˉorder(Orders),
                    Validationˉrank
                );
            if Bytesˉreadˉu8(Reachableˉmap, Validationˉfunction) == 0u8 {
                let Validationˉview: Sourceˉset.Compilerˉsourceˉsetˉview =
                    Compilerˉsourceˉwvbˉsymbolˉsource(
                        Input, Scan, Symbols, Validationˉfunction
                    );
                let Validationˉheader: Sourceˉdeclarations.Compilerˉsourceˉheader =
                    Sourceˉdeclarations.Compilerˉparseˉheaderˉvalidated(
                        Validationˉview.Source
                    );
                let Validationˉencoding: Compilerˉsourceˉwvbˉfunctionˉencoding =
                    Compilerˉsourceˉwvbˉencodeˉfunction(
                        Input, Scan,
                        Validationˉview.Source, Validationˉheader,
                        Symbols, Bindings, Orders, Validationˉtextˉplan,
                        Wirˉsummary.Directory, Validationˉfunction,
                        0u32, false
                    );
                if Validationˉencoding.Status !=
                    Compilerˉsourceˉwvbˉstatus.Valid {
                    return Compilerˉsourceˉwvbˉsummaryˉfailure(
                        Input,
                        Validationˉencoding.Status,
                        Wirˉsummary.Status,
                        Validationˉrank,
                        Validationˉencoding.Failureˉoperation
                    );
                }
            }
            Validationˉrank = Validationˉrank + 1u32;
        }
    }

    var Functionˉpayload: bytes = Bytesˉfromˉu32ˉlittle(Emissionˉfunctions);
    var Codeˉpayload: bytes = Compilerˉsourceˉwvbˉempty(Input);
    var Exportˉentries: bytes = Compilerˉsourceˉwvbˉempty(Input);
    var Exportˉcount: u32 = 0u32;
    var Codeˉoffset: u32 = 0u32;
    var Functionˉrank: u32 = 0u32;
    var Hasˉcollections: bool = Typeˉencoding.Hasˉcollections;
    var Hasˉoperators: bool = false;
    while Functionˉrank < Emissionˉfunctions {
        let Functionˉentry: u32 = Compilerˉsourceˉwvbˉorderedˉsymbol(
            Compilerˉsourceˉwvbˉfunctionˉorder(Emissionˉorders), Functionˉrank
        );
        let Functionˉview: Sourceˉset.Compilerˉsourceˉsetˉview =
            Compilerˉsourceˉwvbˉsymbolˉsource(
                Input, Scan, Symbols, Functionˉentry
            );
        let Functionˉheader: Sourceˉdeclarations.Compilerˉsourceˉheader =
            Sourceˉdeclarations.Compilerˉparseˉheaderˉvalidated(Functionˉview.Source);
        let Functionˉowner: u32 = Compilerˉsourceˉwvbˉsymbolˉmodule(
            Symbols, Functionˉentry
        );
        let Encoded: Compilerˉsourceˉwvbˉfunctionˉencoding =
            Compilerˉsourceˉwvbˉencodeˉfunction(
                Input, Scan, Functionˉview.Source, Functionˉheader,
                Symbols, Bindings, Emissionˉorders, Textˉplan,
                Wirˉsummary.Directory, Functionˉentry, Codeˉoffset, true
            );
        if Encoded.Status != Compilerˉsourceˉwvbˉstatus.Valid {
            return Compilerˉsourceˉwvbˉsummaryˉfailure(
                Input,
                Encoded.Status,
                Wirˉsummary.Status,
                Functionˉrank,
                Encoded.Failureˉoperation
            );
        }
        if Encoded.Hasˉcollections { Hasˉcollections = true; }
        if Encoded.Hasˉoperators { Hasˉoperators = true; }
        Functionˉpayload = Bytesˉconcat(Functionˉpayload, Encoded.Metadata);
        Codeˉpayload = Bytesˉconcat(Codeˉpayload, Encoded.Code);
        if Functionˉowner == 0u32 {
            if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉlookupˉisˉexported(
                Symbols.Lookup, Functionˉentry
            ) {
                Exportˉcount = Exportˉcount + 1u32;
                Exportˉentries = Bytesˉconcat(
                    Exportˉentries,
                    Compilerˉsourceˉwvbˉencodedˉstring(
                        Compilerˉsourceˉwvbˉsymbolˉname(
                            Input, Scan, Symbols, Functionˉentry
                        )
                    )
                );
                Exportˉentries = Bytesˉconcat(
                    Exportˉentries, Bytesˉfromˉu8(1u8)
                );
                Exportˉentries = Bytesˉconcat(
                    Exportˉentries, Bytesˉfromˉu32ˉlittle(Functionˉrank)
                );
            }
        }
        Codeˉoffset = Codeˉoffset + Bytesˉlength(Encoded.Code);
        Functionˉrank = Functionˉrank + 1u32;
    }

    let Moduleˉmetadata: Compilerˉsourceˉwvbˉdataˉencoding =
        Compilerˉsourceˉwvbˉmoduleˉmetadata(Root.Source);
    if Moduleˉmetadata.Status != Compilerˉsourceˉwvbˉstatus.Valid {
        return Compilerˉsourceˉwvbˉsummaryˉfailure(
            Input,
            Moduleˉmetadata.Status,
            Wirˉsummary.Status,
            Symbols.Functions,
            Wirˉsummary.Operations
        );
    }
    var Moduleˉpayload: bytes = Bytesˉfromˉu8(
        Compilerˉsourceˉwvbˉprofile(Rootˉheader.Profile)
    );
    Moduleˉpayload = Bytesˉconcat(
        Moduleˉpayload,
        Compilerˉsourceˉwvbˉstring(
            Root.Source, Rootˉheader.Nameˉoffset, Rootˉheader.Nameˉlength
        )
    );
    var Metadataˉpresent: u8 = 0u8;
    if Bytesˉlength(Moduleˉmetadata.Payload) != 0u32 {
        Metadataˉpresent = 1u8;
    }
    Moduleˉpayload = Bytesˉconcat(
        Moduleˉpayload, Bytesˉfromˉu8(Metadataˉpresent)
    );
    Moduleˉpayload = Bytesˉconcat(Moduleˉpayload, Moduleˉmetadata.Payload);
    let Exportˉpayload: bytes = Bytesˉconcat(
        Bytesˉfromˉu32ˉlittle(Exportˉcount),
        Exportˉentries
    );
    var Bytecode: bytes = Textˉtoˉutf8("WVB1");
    Bytecode = Bytesˉconcat(Bytecode, Bytesˉfromˉu16ˉlittle(1u32));
    Bytecode = Bytesˉconcat(Bytecode, Bytesˉfromˉu16ˉlittle(11u32));
    Bytecode = Bytesˉconcat(Bytecode, Bytesˉfromˉu32ˉlittle(7u32));
    Bytecode = Bytesˉconcat(
        Bytecode, Compilerˉsourceˉwvbˉsection(1u8, Moduleˉpayload)
    );
    Bytecode = Bytesˉconcat(
        Bytecode,
        Compilerˉsourceˉwvbˉsection(2u8, Capabilityˉencoding.Payload)
    );
    Bytecode = Bytesˉconcat(
        Bytecode, Compilerˉsourceˉwvbˉsection(3u8, Dataˉencoding.Payload)
    );
    Bytecode = Bytesˉconcat(
        Bytecode, Compilerˉsourceˉwvbˉsection(4u8, Functionˉpayload)
    );
    Bytecode = Bytesˉconcat(
        Bytecode, Compilerˉsourceˉwvbˉsection(5u8, Codeˉpayload)
    );
    Bytecode = Bytesˉconcat(
        Bytecode, Compilerˉsourceˉwvbˉsection(6u8, Exportˉpayload)
    );
    Bytecode = Bytesˉconcat(
        Bytecode, Compilerˉsourceˉwvbˉsection(7u8, Typeˉencoding.Payload)
    );
    if Bytesˉlength(Bytecode) > 16777216u32 {
        return Compilerˉsourceˉwvbˉsummaryˉfailure(
            Input,
            Compilerˉsourceˉwvbˉstatus.Bytecodeˉlimit,
            Wirˉsummary.Status,
            Symbols.Functions,
            Wirˉsummary.Operations
        );
    }
    return Compilerˉsourceˉwvbˉsummary(
        Compilerˉsourceˉwvbˉstatus.Valid,
        Wirˉsummary.Status,
        Emissionˉfunctions,
        Bytesˉlength(Codeˉpayload),
        Bytecode,
        Symbols.Functions,
        Wirˉsummary.Operations
    );
}

export fn Compilerˉcompileˉsourceˉwvb(
    Input: bytes
) -> Compilerˉsourceˉwvbˉsummary {
    return Compilerˉsourceˉwvbˉcompile(Input, false);
}

export fn Compilerˉcompileˉsourceˉwvbˉoptimized(
    Input: bytes
) -> Compilerˉsourceˉwvbˉsummary {
    return Compilerˉsourceˉwvbˉcompile(Input, true);
}
