#!wv/1 en@1
module Compilerˉsourceˉwvb;
profile core;
platform linux, windows, windvale;
authority library;

import Compilerˉsourceˉbindings as Sourceˉbindings;
import Compilerˉsourceˉdeclarationˉparser as Sourceˉdeclarations;
import Compilerˉsourceˉdescriptor as Sourceˉdescriptor;
import Compilerˉsourceˉfunctionˉtypeˉlowering as Functionˉtypes;
import Compilerˉsourceˉgenericˉlowering as Sourceˉgenerics;
import Compilerˉsourceˉgenericˉtypeˉlayout as Genericˉlayouts;
import Compilerˉsourceˉgenericˉtypeˉlowering as Genericˉtypes;
import Compilerˉsourceˉgenericˉtypeˉmaterialization as Genericˉmaterialization;
import Compilerˉsourceˉlexer as Sourceˉlexer;
import Compilerˉsourceˉset as Sourceˉset;
import Compilerˉsourceˉsymbols as Sourceˉsymbols;
import Compilerˉsourceˉwirˉconsumer as Sourceˉwir;
import Compilerˉsourceˉwvbˉgenericˉnominalˉtypes as Genericˉnominalˉtypes;
import Compilerˉsourceˉwvbˉtemporaryˉslots as Temporaryˉslots;
import Compilerˉsourceˉwvbˉfoundationˉborrows as Foundationˉborrows;
import Foundationˉbyteˉconstruction as Byteˉconstruction;

export enum Compilerˉsourceˉwvbˉstatus: i32 {
    Valid = 0;
    Sourceˉwir = 1;
    Unsupportedˉmoduleˉcount = 2;
    Unsupportedˉprofile = 3;
    Unsupportedˉdeclaration = 4;
    Unsupportedˉshape = 5;
    Unsupportedˉoperation = 6;
    Bytecodeˉlimit = 7;
    Invalidˉdata = 8;
}

record Compilerˉsourceˉwvbˉtextˉvalue {
    Status: Compilerˉsourceˉwvbˉstatus;
    Value: bytes;
}

record Compilerˉsourceˉwvbˉtextˉplan {
    Status: Compilerˉsourceˉwvbˉstatus;
    Count: u32;
    Nextˉname: u32;
    Directory: bytes;
    Values: bytes;
}

record Compilerˉsourceˉwvbˉdataˉencoding {
    Status: Compilerˉsourceˉwvbˉstatus;
    Payload: bytes;
}

record Compilerˉsourceˉwvbˉtypeˉencoding {
    Status: Compilerˉsourceˉwvbˉstatus;
    Payload: bytes;
    Features: u32;
}

record Compilerˉsourceˉwvbˉvariantˉfieldsˉencoding {
    Status: Compilerˉsourceˉwvbˉstatus;
    Payload: bytes;
    Nextˉoffset: u32;
    Nextˉline: u32;
    Nextˉcolumn: u32;
    Features: u32;
}

record Compilerˉsourceˉwvbˉvectorˉborrowˉplan {
    Valid: bool;
    Sources: bytes;
    Failureˉoperation: u32;
}

record Compilerˉsourceˉwvbˉfunctionˉborrowˉplans {
    Foundation: Foundationˉborrows.Borrowˉplan;
    Parameters: bytes;
    Vectors: Compilerˉsourceˉwvbˉvectorˉborrowˉplan;
    Owners: Foundationˉborrows.Ownerˉplan;
}

record Compilerˉsourceˉwvbˉbytesˉresultˉindices {
    Valid: bool;
    Result: u32;
    Failure: u32;
    Reason: u32;
}

record Compilerˉsourceˉwvbˉanalysis {
    Status: Compilerˉsourceˉwvbˉstatus;
    Codeˉlength: u32;
    Maximumˉstack: u32;
    Blockˉoffsets: bytes;
    Blockˉorder: bytes;
    Failureˉoperation: u32;
    Failureˉrule: text;
}


record Compilerˉsourceˉwvbˉfunctionˉencoding {
    Status: Compilerˉsourceˉwvbˉstatus;
    Metadata: bytes;
    Code: bytes;
    Failureˉoperation: u32;
    Features: u32;
    Failureˉrule: text;
}

record Compilerˉsourceˉwvbˉsymbolˉorder {
    Entries: bytes;
    Ranks: bytes;
}

record Compilerˉsourceˉwvbˉsymbolˉorders {
    Capabilityˉentries: bytes;
    Capabilityˉranks: bytes;
    Dataˉentries: bytes;
    Dataˉranks: bytes;
    Recordˉentries: bytes;
    Recordˉranks: bytes;
    Enumˉentries: bytes;
    Enumˉranks: bytes;
    Variantˉentries: bytes;
    Variantˉranks: bytes;
    Functionˉentries: bytes;
    Functionˉranks: bytes;
    Recordˉtargets: bytes;
    Variantˉtargets: bytes;
    Concreteˉrecords: u32;
    Concreteˉvariants: u32;
    Genericˉrecords: u32;
    Genericˉnominalˉentries: bytes;
    Genericˉnominals: u32;
    Genericˉfields: bytes;
    Genericˉtypeˉevidence: bytes;
    Genericˉtypeˉentries: u32;
    Builderˉownedˉshapes: bytes;
    Ownershipˉconstructors: bytes;
}

const WVB_FUNCTION_TYPE_SHAPE_BASE: u32 = 2147483904u32;
const WVB_FUNCTION_TYPE_INSTANCE_LIMIT: u32 = 256u32;
const WVB_FUNCTION_TYPE_HEADER_BYTES: u32 = 24u32;
const WVB_FUNCTION_TYPE_ENTRY_BYTES: u32 = 32u32;
const WVB_FUNCTION_TYPE_PARAMETER_BYTES: u32 = 8u32;
const WIR_BORROWED_OPTION_SHAPE_BASE: u32 = 2147484160u32;
const WIR_BORROWED_OPTION_SHAPE_LIMIT: u32 = 256u32;
const WVB_TASK_FEATURE: u32 = 2097152u32;
const WVB_UNSAFE_SCRATCH_FEATURE: u32 = 4194304u32;
const WVB_BORROWED_BUDGET_FEATURE: u32 = 8388608u32;
const WVB_UNSAFE_SCRATCH_LENGTH_FEATURE: u32 = 16777216u32;
const WVB_UNSAFE_WRITE_REGION_FEATURE: u32 = 33554432u32;
const WVB_UNSAFE_WRITE_POINTER_FEATURE: u32 = 67108864u32;
const WVB_FOREIGN_CALL_FEATURE: u32 = 134217728u32;
const WVB_FOUNDATION_VALUE_BORROW_FEATURE: u32 = 268435456u32;
const WVB_VECTOR_PARAMETER_READ_FEATURE: u32 = 536870912u32;
const WVB_VECTOR_PAYLOAD_BORROW_FEATURE: u32 = 1073741824u32;
const WVB_VECTOR_INDEXED_BORROW_FEATURE: u32 = 2147483648u32;

export record Compilerˉsourceˉwvbˉsummary {
    Status: Compilerˉsourceˉwvbˉstatus;
    Wirˉstatus: Sourceˉwir.Compilerˉsourceˉwirˉstatus;
    Functions: u32;
    Codeˉbytes: u32;
    Bytecode: bytes;
    Failureˉfunction: u32;
    Failureˉoperation: u32;
    Failureˉline: u32;
    Failureˉrule: text;
}

export record Compilerˉsourceˉwvbˉreachability {
    Status: Compilerˉsourceˉwvbˉstatus;
    Wirˉstatus: Sourceˉwir.Compilerˉsourceˉwirˉstatus;
    Functions: u32;
    Roots: u32;
    Reachable: u32;
    Unreachable: u32;
    Calls: u32;
    Reachableˉcalls: u32;
    Codeˉbytes: u32;
    Reachableˉcodeˉbytes: u32;
    Unreachableˉcodeˉbytes: u32;
    Map: bytes;
    Failureˉfunction: u32;
    Failureˉoperation: u32;
}

export fn Compilerˉsourceˉwvbˉempty(Input: bytes) -> bytes {
    return Bytesˉslice(Input, 0u32, 0u32);
}

fn Compilerˉsourceˉwvbˉfunctionˉtypeˉshapeˉisˉprivate(
    Shape: u32
) -> bool {
    return Shape >= WVB_FUNCTION_TYPE_SHAPE_BASE &&
        Shape < WVB_FUNCTION_TYPE_SHAPE_BASE +
            WVB_FUNCTION_TYPE_INSTANCE_LIMIT;
}

fn Compilerˉsourceˉwvbˉfunctionˉtypeˉshapeˉinstance(
    Shape: u32
) -> u32 {
    if !Compilerˉsourceˉwvbˉfunctionˉtypeˉshapeˉisˉprivate(Shape) {
        return 4294967295u32;
    }
    return Shape - WVB_FUNCTION_TYPE_SHAPE_BASE;
}

fn Compilerˉsourceˉwvbˉshapeˉisˉborrowedˉoption(
    Shape: u32
) -> bool {
    return Shape >= WIR_BORROWED_OPTION_SHAPE_BASE &&
        Shape < WIR_BORROWED_OPTION_SHAPE_BASE +
            WIR_BORROWED_OPTION_SHAPE_LIMIT;
}

fn Compilerˉsourceˉwvbˉborrowedˉoptionˉvalueˉshape(
    Shape: u32
) -> u32 {
    if !Compilerˉsourceˉwvbˉshapeˉisˉborrowedˉoption(Shape) {
        return 4294967295u32;
    }
    return Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉshape(
        Shape - WIR_BORROWED_OPTION_SHAPE_BASE
    );
}

export fn Compilerˉsourceˉwvbˉsummaryˉfailure(
    Input: bytes,
    Status: Compilerˉsourceˉwvbˉstatus,
    Wirˉstatus: Sourceˉwir.Compilerˉsourceˉwirˉstatus,
    Function: u32,
    Operation: u32
) -> Compilerˉsourceˉwvbˉsummary {
    return Compilerˉsourceˉwvbˉsummaryˉruleˉfailure(
        Input, Status, Wirˉstatus, Function, Operation, Enumˉname(Status)
    );
}

fn Compilerˉsourceˉwvbˉsummaryˉruleˉfailure(
    Input: bytes,
    Status: Compilerˉsourceˉwvbˉstatus,
    Wirˉstatus: Sourceˉwir.Compilerˉsourceˉwirˉstatus,
    Function: u32,
    Operation: u32,
    Rule: text
) -> Compilerˉsourceˉwvbˉsummary {
    return Compilerˉsourceˉwvbˉsummary(
        Status,
        Wirˉstatus,
        0u32,
        0u32,
        Compilerˉsourceˉwvbˉempty(Input),
        Function,
        Operation,
        0u32,
        Rule
    );
}

export fn Compilerˉsourceˉwvbˉreachabilityˉfailure(
    Input: bytes,
    Status: Compilerˉsourceˉwvbˉstatus,
    Wirˉstatus: Sourceˉwir.Compilerˉsourceˉwirˉstatus,
    Function: u32,
    Operation: u32
) -> Compilerˉsourceˉwvbˉreachability {
    return Compilerˉsourceˉwvbˉreachability(
        Status,
        Wirˉstatus,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        Compilerˉsourceˉwvbˉempty(Input),
        Function,
        Operation
    );
}

export fn Compilerˉsourceˉwvbˉstring(
    Source: bytes,
    Offset: u32,
    Length: u32
) -> bytes {
    return Bytesˉconcat(
        Bytesˉfromˉu32ˉlittle(Length),
        Bytesˉslice(Source, Offset, Length)
    );
}

export fn Compilerˉsourceˉwvbˉencodedˉstring(Value: bytes) -> bytes {
    return Bytesˉconcat(
        Bytesˉfromˉu32ˉlittle(Bytesˉlength(Value)),
        Value
    );
}

export fn Compilerˉsourceˉwvbˉsection(Kind: u8, Payload: bytes) -> bytes {
    var Result: bytes = Bytesˉfromˉu8(Kind);
    Result = Bytesˉconcat(Result, Bytesˉfromˉu8(0u8));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu16ˉlittle(0u32));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Bytesˉlength(Payload)));
    return Bytesˉconcat(Result, Payload);
}

fn Compilerˉsourceˉwvbˉbindingsˉtypeˉcatalog(
    Directory: bytes
) -> Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog {
    if Sourceˉwir.Compilerˉsourceˉbindingsˉclosuresˉheaderˉbytes(
            Directory
        ) != 0u32 {
        return Sourceˉwir.Compilerˉsourceˉbindingsˉclosuresˉtypeˉcatalog(
            Directory
        );
    }
    return Sourceˉwir.Compilerˉsourceˉbindingsˉgenericˉtypesˉtypeˉcatalog(
        Directory
    );
}

export fn Compilerˉsourceˉwvbˉshapeˉisˉsupported(
    Shape: u32,
    Allowˉvoid: bool,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Orders: Compilerˉsourceˉwvbˉsymbolˉorders
) -> bool {
    if Shape == 805306368u32 { return false; }
    if Shape == 805306370u32 { return true; }
    if Compilerˉsourceˉwvbˉfunctionˉtypeˉshapeˉisˉprivate(Shape) {
        return true;
    }
    if Compilerˉsourceˉwvbˉshapeˉisˉborrowedˉoption(Shape) {
        return Compilerˉsourceˉwvbˉplannedˉshapeˉvalue(
            Compilerˉsourceˉwvbˉborrowedˉoptionˉvalueˉshape(
                Shape
            ),
            Symbols,
            Orders
        ) != 4294967295u32;
    }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉshapeˉisˉdeclaredˉvalue(
        Shape, Symbols.Records, Symbols.Enums, Symbols.Variants, Allowˉvoid
    ) {
        return Compilerˉsourceˉwvbˉplannedˉshapeˉvalue(
            Shape, Symbols, Orders
        ) != 4294967295u32;
    }
    if Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉshapeˉisˉprivate(Shape) {
        let Entry: u32 = Compilerˉsourceˉwvbˉgenericˉnominalˉentry(Shape, Orders);
        if Entry != 4294967295u32 && Bytesˉreadˉu32ˉlittle(Orders.Genericˉnominalˉentries, Entry + 8u32) == 13u32 {
            return Compilerˉsourceˉwvbˉshapeˉisˉbyteˉslice(Shape, Orders);
        }
        return Compilerˉsourceˉwvbˉplannedˉshapeˉvalue(
            Shape, Symbols, Orders
        ) != 4294967295u32;
    }
    if Shape >= 268435456u32 {
        if Shape < 268439552u32 { return true; }
    }
    if Sourceˉwir.Compilerˉsourceˉwirˉshapeˉisˉsequence(Shape) ||
        Sourceˉwir.Compilerˉsourceˉwirˉshapeˉisˉbuilder(Shape) {
        let Maximum: u32 = Sourceˉwir.Compilerˉsourceˉwirˉcollectionˉmaximum(Shape);
        if Maximum == 0u32 || Maximum > 4095u32 { return false; }
        return Compilerˉsourceˉwvbˉshapeˉisˉsupported(
            Sourceˉwir.Compilerˉsourceˉwirˉcollectionˉelementˉshape(Shape),
            false, Symbols, Orders
        );
    }
    return false;
}

fn Compilerˉsourceˉwvbˉshapeˉrequiresˉtypeˉentry(
    Shape: u32,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Orders: Compilerˉsourceˉwvbˉsymbolˉorders
) -> bool {
    if Shape == 805306368u32 || Shape == 805306370u32 { return false; }
    if Compilerˉsourceˉwvbˉshapeˉisˉbyteˉslice(Shape, Orders) { return false; }
    if Compilerˉsourceˉwvbˉfunctionˉtypeˉshapeˉisˉprivate(Shape) {
        return true;
    }
    if Compilerˉsourceˉwvbˉshapeˉisˉborrowedˉoption(Shape) {
        return true;
    }
    if Shape >= 65536u32 && Shape < 65536u32 + Symbols.Records { return true; }
    if Shape >= 131072u32 + Symbols.Records &&
        Shape < 131072u32 + Symbols.Records + Symbols.Enums { return true; }
    if Shape >= 196608u32 + Symbols.Records + Symbols.Enums &&
        Shape < 196608u32 + Symbols.Records + Symbols.Enums + Symbols.Variants {
        return true;
    }
    if Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉshapeˉisˉprivate(Shape) {
        return true;
    }
    if Sourceˉwir.Compilerˉsourceˉwirˉshapeˉisˉsequence(Shape) ||
        Sourceˉwir.Compilerˉsourceˉwirˉshapeˉisˉbuilder(Shape) {
        return Compilerˉsourceˉwvbˉshapeˉrequiresˉtypeˉentry(
            Sourceˉwir.Compilerˉsourceˉwirˉcollectionˉelementˉshape(Shape),
            Symbols, Orders
        );
    }
    return false;
}

export fn Compilerˉsourceˉwvbˉshape(Shape: u32) -> bytes {
    if Shape == 805306368u32 { return Bytesˉfromˉu8(25u8); }
    if Shape == 805306369u32 { return Bytesˉfromˉu8(34u8); }
    if Shape == 805306370u32 { return Bytesˉfromˉu8(39u8); }
    var Kind: u8 = 0u8;
    if Shape == 1u32 { Kind = 1u8; }
    if Shape == 2u32 { Kind = 4u8; }
    if Shape == 3u32 { Kind = 5u8; }
    if Shape == 4u32 { Kind = 2u8; }
    if Shape == 5u32 { Kind = 3u8; }
    if Shape == 6u32 { Kind = 6u8; }
    if Shape == 7u32 { Kind = 9u8; }
    if Shape == 8u32 { Kind = 10u8; }
    if Shape == 9u32 { Kind = 20u8; }
    if Shape == 10u32 { Kind = 21u8; }
    if Shape == 11u32 { Kind = 14u8; }
    if Shape == 12u32 { Kind = 15u8; }
    if Shape == 13u32 { Kind = 16u8; }
    if Shape == 14u32 { Kind = 18u8; }
    if Shape == 15u32 { Kind = 19u8; }
    if Shape == 16u32 { Kind = 17u8; }
    if Shape >= 268435456u32 {
        if Shape < 268439552u32 {
            return Bytesˉfromˉu8(5u8);
        }
    }
    if Sourceˉwir.Compilerˉsourceˉwirˉshapeˉisˉsequence(Shape) ||
        Sourceˉwir.Compilerˉsourceˉwirˉshapeˉisˉbuilder(Shape) {
        var Collectionˉkind: u8 = 12u8;
        if Sourceˉwir.Compilerˉsourceˉwirˉshapeˉisˉbuilder(Shape) {
            Collectionˉkind = 13u8;
        }
        var Collectionˉshape: bytes = Bytesˉfromˉu8(Collectionˉkind);
        Collectionˉshape = Bytesˉconcat(
            Collectionˉshape,
            Compilerˉsourceˉwvbˉshape(
                Sourceˉwir.Compilerˉsourceˉwirˉcollectionˉelementˉshape(Shape)
            )
        );
        return Bytesˉconcat(
            Collectionˉshape,
            Bytesˉfromˉu32ˉlittle(
                Sourceˉwir.Compilerˉsourceˉwirˉcollectionˉmaximum(Shape)
            )
        );
    }
    if Shape < 65536u32 { return Bytesˉfromˉu8(Kind); }
    if Shape < 131072u32 {
        return Bytesˉconcat(
            Bytesˉfromˉu8(7u8),
            Bytesˉfromˉu32ˉlittle(Shape - 65536u32)
        );
    }
    if Shape < 196608u32 {
        return Bytesˉconcat(
            Bytesˉfromˉu8(8u8),
            Bytesˉfromˉu32ˉlittle(Shape - 131072u32)
        );
    }
    return Bytesˉconcat(
        Bytesˉfromˉu8(11u8),
        Bytesˉfromˉu32ˉlittle(Shape - 196608u32)
    );
}

export fn Compilerˉsourceˉwvbˉshapeˉhasˉfixedˉinteger(Shape: u32) -> bool {
    if Shape >= 11u32 {
        if Shape <= 13u32 { return true; }
    }
    if Sourceˉwir.Compilerˉsourceˉwirˉshapeˉisˉsequence(Shape) ||
        Sourceˉwir.Compilerˉsourceˉwirˉshapeˉisˉbuilder(Shape) {
        return Compilerˉsourceˉwvbˉshapeˉhasˉfixedˉinteger(
            Sourceˉwir.Compilerˉsourceˉwirˉcollectionˉelementˉshape(Shape)
        );
    }
    return false;
}

export fn Compilerˉsourceˉwvbˉshapeˉhasˉrune(Shape: u32) -> bool {
    if Shape == 16u32 { return true; }
    if Sourceˉwir.Compilerˉsourceˉwirˉshapeˉisˉsequence(Shape) ||
        Sourceˉwir.Compilerˉsourceˉwirˉshapeˉisˉbuilder(Shape) {
        return Compilerˉsourceˉwvbˉshapeˉhasˉrune(
            Sourceˉwir.Compilerˉsourceˉwirˉcollectionˉelementˉshape(Shape)
        );
    }
    return false;
}

export fn Compilerˉsourceˉwvbˉshapeˉhasˉfloating(Shape: u32) -> bool {
    if Shape == 14u32 || Shape == 15u32 { return true; }
    if Sourceˉwir.Compilerˉsourceˉwirˉshapeˉisˉsequence(Shape) ||
        Sourceˉwir.Compilerˉsourceˉwirˉshapeˉisˉbuilder(Shape) {
        return Compilerˉsourceˉwvbˉshapeˉhasˉfloating(
            Sourceˉwir.Compilerˉsourceˉwirˉcollectionˉelementˉshape(Shape)
        );
    }
    return false;
}

export fn Compilerˉsourceˉwvbˉshapeˉhasˉunitˉorˉnever(Shape: u32) -> bool {
    if Shape == 9u32 || Shape == 10u32 { return true; }
    if Sourceˉwir.Compilerˉsourceˉwirˉshapeˉisˉsequence(Shape) ||
        Sourceˉwir.Compilerˉsourceˉwirˉshapeˉisˉbuilder(Shape) {
        return Compilerˉsourceˉwvbˉshapeˉhasˉunitˉorˉnever(
            Sourceˉwir.Compilerˉsourceˉwirˉcollectionˉelementˉshape(Shape)
        );
    }
    return false;
}

fn Compilerˉsourceˉwvbˉshapeˉfeatures(Shape: u32) -> u32 {
    var Features: u32 = 0u32;
    if Shape == 805306368u32 { Features = Features | 1024u32; }
    if Compilerˉsourceˉwvbˉfunctionˉtypeˉshapeˉisˉprivate(Shape) {
        Features = Features | 524288u32;
    }
    if Sourceˉwir.Compilerˉsourceˉwirˉshapeˉisˉsequence(Shape) ||
        Sourceˉwir.Compilerˉsourceˉwirˉshapeˉisˉbuilder(Shape) {
        Features = Features | 1u32;
    }
    if Compilerˉsourceˉwvbˉshapeˉhasˉfixedˉinteger(Shape) {
        Features = Features | 2u32;
    }
    if Compilerˉsourceˉwvbˉshapeˉhasˉrune(Shape) {
        Features = Features | 4u32;
    }
    if Compilerˉsourceˉwvbˉshapeˉhasˉfloating(Shape) {
        Features = Features | 8u32;
    }
    if Compilerˉsourceˉwvbˉshapeˉhasˉunitˉorˉnever(Shape) {
        Features = Features | 16u32;
    }
    return Features;
}

export fn Compilerˉsourceˉwvbˉprofile(
    Profile: Sourceˉdeclarations.Compilerˉsourceˉprofile
) -> u8 {
    if Profile == Sourceˉdeclarations.Compilerˉsourceˉprofile.Portable { return 1u8; }
    if Profile == Sourceˉdeclarations.Compilerˉsourceˉprofile.Hosted { return 2u8; }
    return 3u8;
}

export fn Compilerˉsourceˉwvbˉmoduleˉmetadata(
    Source: bytes
) -> Compilerˉsourceˉwvbˉdataˉencoding {
    let Moduleˉtoken: Sourceˉlexer.Compilerˉsourceˉtoken =
        Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(Source, 0u32, 1u32, 1u32);
    let Name: Sourceˉlexer.Compilerˉsourceˉtoken =
        Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Source, Moduleˉtoken.Nextˉoffset, Moduleˉtoken.Nextˉline, Moduleˉtoken.Nextˉcolumn
        );
    let Form: Sourceˉlexer.Compilerˉsourceˉtoken =
        Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Source, Name.Nextˉoffset, Name.Nextˉline, Name.Nextˉcolumn
        );
    if Form.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Profile {
        return Compilerˉsourceˉwvbˉdataˉencoding(
            Compilerˉsourceˉwvbˉstatus.Valid,
            Compilerˉsourceˉwvbˉempty(Source)
        );
    }
    if Form.Kind != Sourceˉlexer.Compilerˉtokenˉkind.Semicolon {
        return Compilerˉsourceˉwvbˉdataˉencoding(
            Compilerˉsourceˉwvbˉstatus.Invalidˉdata,
            Compilerˉsourceˉwvbˉempty(Source)
        );
    }

    var Cursor: u32 = Form.Nextˉoffset;
    var Line: u32 = Form.Nextˉline;
    var Column: u32 = Form.Nextˉcolumn;
    let Headerˉmetadata: Sourceˉlexer.Compilerˉsourceˉtoken =
        Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Source, Cursor, Line, Column
        );
    if Headerˉmetadata.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Profile {
        let Profileˉvalue: Sourceˉlexer.Compilerˉsourceˉtoken =
            Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                Source, Headerˉmetadata.Nextˉoffset, Headerˉmetadata.Nextˉline, Headerˉmetadata.Nextˉcolumn
            );
        let Profileˉend: Sourceˉlexer.Compilerˉsourceˉtoken =
            Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                Source, Profileˉvalue.Nextˉoffset, Profileˉvalue.Nextˉline, Profileˉvalue.Nextˉcolumn
            );
        Cursor = Profileˉend.Nextˉoffset;
        Line = Profileˉend.Nextˉline;
        Column = Profileˉend.Nextˉcolumn;
    }
    let Platform: Sourceˉlexer.Compilerˉsourceˉtoken =
        Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(Source, Cursor, Line, Column);
    if Platform.Kind != Sourceˉlexer.Compilerˉtokenˉkind.Platform {
        return Compilerˉsourceˉwvbˉdataˉencoding(
            Compilerˉsourceˉwvbˉstatus.Invalidˉdata,
            Compilerˉsourceˉwvbˉempty(Source)
        );
    }
    Cursor = Platform.Nextˉoffset;
    Line = Platform.Nextˉline;
    Column = Platform.Nextˉcolumn;
    var Platformˉcount: u32 = 0u32;
    var Platformˉentries: bytes = Compilerˉsourceˉwvbˉempty(Source);
    var Readingˉplatforms: bool = true;
    while Readingˉplatforms {
        let Scope: Sourceˉlexer.Compilerˉsourceˉtoken =
            Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(Source, Cursor, Line, Column);
        let Qualified: Sourceˉdeclarations.Compilerˉparseˉstep =
            Sourceˉdeclarations.Compilerˉparseˉqualifiedˉname(
                Source, Cursor, Line, Column, false
            );
        Platformˉentries = Bytesˉconcat(
            Platformˉentries,
            Compilerˉsourceˉwvbˉstring(
                Source, Scope.Offset, Qualified.Nextˉoffset - Scope.Offset
            )
        );
        Platformˉcount = Platformˉcount + 1u32;
        let Separator: Sourceˉlexer.Compilerˉsourceˉtoken =
            Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                Source, Qualified.Nextˉoffset, Qualified.Nextˉline, Qualified.Nextˉcolumn
            );
        Cursor = Separator.Nextˉoffset;
        Line = Separator.Nextˉline;
        Column = Separator.Nextˉcolumn;
        if Separator.Kind != Sourceˉlexer.Compilerˉtokenˉkind.Comma {
            Readingˉplatforms = false;
        }
    }

    let Authorityˉkeyword: Sourceˉlexer.Compilerˉsourceˉtoken =
        Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(Source, Cursor, Line, Column);
    let Authority: Sourceˉlexer.Compilerˉsourceˉtoken =
        Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Source, Authorityˉkeyword.Nextˉoffset, Authorityˉkeyword.Nextˉline, Authorityˉkeyword.Nextˉcolumn
        );
    var Authorityˉvalue: u8 = 0u8;
    if Sourceˉlexer.Compilerˉsourceˉspanˉequalsˉtext(Source, Authority.Offset, Authority.Length, "library") {
        Authorityˉvalue = 1u8;
    }
    if Sourceˉlexer.Compilerˉsourceˉspanˉequalsˉtext(Source, Authority.Offset, Authority.Length, "application") {
        Authorityˉvalue = 2u8;
    }
    if Sourceˉlexer.Compilerˉsourceˉspanˉequalsˉtext(Source, Authority.Offset, Authority.Length, "service") {
        Authorityˉvalue = 3u8;
    }
    if Authority.Kind == Sourceˉlexer.Compilerˉtokenˉkind.System { Authorityˉvalue = 4u8; }
    let Authorityˉend: Sourceˉlexer.Compilerˉsourceˉtoken =
        Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Source, Authority.Nextˉoffset, Authority.Nextˉline, Authority.Nextˉcolumn
        );
    Cursor = Authorityˉend.Nextˉoffset;
    Line = Authorityˉend.Nextˉline;
    Column = Authorityˉend.Nextˉcolumn;

    var Requiredˉcount: u32 = 0u32;
    var Requiredˉentries: bytes = Compilerˉsourceˉwvbˉempty(Source);
    var Optionalˉcount: u32 = 0u32;
    var Optionalˉentries: bytes = Compilerˉsourceˉwvbˉempty(Source);
    var Readingˉrequirements: bool = true;
    while Readingˉrequirements {
        let Requirementˉtoken: Sourceˉlexer.Compilerˉsourceˉtoken =
            Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(Source, Cursor, Line, Column);
        var Isˉoptional: bool = Requirementˉtoken.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Optional;
        if Requirementˉtoken.Kind != Sourceˉlexer.Compilerˉtokenˉkind.Requires {
            if !Isˉoptional { Readingˉrequirements = false; }
        }
        if Readingˉrequirements {
            let Requirement: Sourceˉdeclarations.Compilerˉsourceˉdeclaration =
                Sourceˉdeclarations.Compilerˉparseˉmetadataˉcapabilityˉdeclaration(
                    Source, Requirementˉtoken, Isˉoptional
                );
            var Entry: bytes = Compilerˉsourceˉwvbˉstring(
                Source, Requirement.Nameˉoffset, Requirement.Nameˉlength
            );
            Entry = Bytesˉconcat(Entry, Bytesˉfromˉu32ˉlittle(1u32));
            if Isˉoptional {
                Optionalˉentries = Bytesˉconcat(Optionalˉentries, Entry);
                Optionalˉcount = Optionalˉcount + 1u32;
            } else {
                Requiredˉentries = Bytesˉconcat(Requiredˉentries, Entry);
                Requiredˉcount = Requiredˉcount + 1u32;
            }
            Cursor = Requirement.Nextˉoffset;
            Line = Requirement.Nextˉline;
            Column = Requirement.Nextˉcolumn;
        }
    }

    var Payload: bytes = Bytesˉfromˉu8(1u8);
    Payload = Bytesˉconcat(Payload, Bytesˉfromˉu8(Authorityˉvalue));
    Payload = Bytesˉconcat(Payload, Bytesˉfromˉu32ˉlittle(Platformˉcount));
    Payload = Bytesˉconcat(Payload, Platformˉentries);
    Payload = Bytesˉconcat(Payload, Bytesˉfromˉu32ˉlittle(Requiredˉcount));
    Payload = Bytesˉconcat(Payload, Requiredˉentries);
    Payload = Bytesˉconcat(Payload, Bytesˉfromˉu32ˉlittle(Optionalˉcount));
    Payload = Bytesˉconcat(Payload, Optionalˉentries);
    return Compilerˉsourceˉwvbˉdataˉencoding(
        Compilerˉsourceˉwvbˉstatus.Valid, Payload
    );
}

export fn Compilerˉsourceˉwvbˉopcode(Operation: u32) -> bytes {
    if Operation >= 11u32 && Operation <= 15u32 {
        return Compilerˉsourceˉwvbˉlowˉbyte(Operation);
    }
    if Operation == 16u32 { return Compilerˉsourceˉwvbˉlowˉbyte(114u32); }
    if Operation >= 17u32 && Operation <= 25u32 {
        return Compilerˉsourceˉwvbˉlowˉbyte(Operation + 87u32);
    }
    if Operation == 26u32 { return Compilerˉsourceˉwvbˉlowˉbyte(118u32); }
    if Operation == 27u32 { return Compilerˉsourceˉwvbˉlowˉbyte(113u32); }
    if Operation >= 28u32 && Operation <= 30u32 {
        return Compilerˉsourceˉwvbˉlowˉbyte(Operation + 87u32);
    }
    if Operation >= 31u32 && Operation <= 35u32 {
        return Compilerˉsourceˉwvbˉlowˉbyte(Operation + 88u32);
    }
    if Operation == 36u32 { return Compilerˉsourceˉwvbˉlowˉbyte(125u32); }
    if Operation == 37u32 { return Compilerˉsourceˉwvbˉlowˉbyte(124u32); }
    if Operation >= 38u32 && Operation <= 44u32 {
        return Compilerˉsourceˉwvbˉlowˉbyte(Operation - 22u32);
    }
    if Operation >= 45u32 && Operation <= 53u32 {
        return Compilerˉsourceˉwvbˉlowˉbyte(Operation - 13u32);
    }
    if Operation >= 54u32 && Operation <= 61u32 {
        return Compilerˉsourceˉwvbˉlowˉbyte(Operation + 42u32);
    }
    if Operation >= 65u32 && Operation <= 76u32 {
        return Compilerˉsourceˉwvbˉlowˉbyte(Operation + 86u32);
    }
    if Operation >= 77u32 && Operation <= 88u32 {
        return Compilerˉsourceˉwvbˉlowˉbyte(Operation + 90u32);
    }
    if Operation >= 89u32 && Operation <= 92u32 {
        return Compilerˉsourceˉwvbˉlowˉbyte(Operation + 96u32);
    }
    if Operation >= 93u32 && Operation <= 94u32 {
        return Compilerˉsourceˉwvbˉlowˉbyte(Operation + 35u32);
    }
    if Operation >= 95u32 && Operation <= 96u32 {
        return Compilerˉsourceˉwvbˉlowˉbyte(Operation + 54u32);
    }
    if Operation >= 97u32 && Operation <= 115u32 {
        return Compilerˉsourceˉwvbˉlowˉbyte(Operation + 33u32);
    }
    if Operation >= 116u32 && Operation <= 119u32 {
        return Compilerˉsourceˉwvbˉlowˉbyte(Operation + 47u32);
    }
    if Operation >= 120u32 && Operation <= 125u32 {
        return Compilerˉsourceˉwvbˉlowˉbyte(Operation + 59u32);
    }
    if Operation >= 126u32 && Operation <= 128u32 {
        return Compilerˉsourceˉwvbˉlowˉbyte(Operation + 63u32);
    }
    if Operation >= 129u32 && Operation <= 147u32 {
        return Compilerˉsourceˉwvbˉlowˉbyte(192u32);
    }
    if Operation >= 148u32 && Operation <= 150u32 {
        return Compilerˉsourceˉwvbˉlowˉbyte(193u32);
    }
    if Operation >= 151u32 && Operation <= 162u32 {
        return Compilerˉsourceˉwvbˉlowˉbyte(194u32);
    }
    if Operation == 163u32 { return Compilerˉsourceˉwvbˉlowˉbyte(195u32); }
    if Operation == 164u32 { return Compilerˉsourceˉwvbˉlowˉbyte(196u32); }
    if Operation == 165u32 { return Compilerˉsourceˉwvbˉlowˉbyte(197u32); }
    if Operation == 166u32 { return Compilerˉsourceˉwvbˉlowˉbyte(198u32); }
    if Operation == 167u32 { return Compilerˉsourceˉwvbˉlowˉbyte(203u32); }
    if Operation == 168u32 { return Compilerˉsourceˉwvbˉlowˉbyte(204u32); }
    if Operation == 169u32 { return Compilerˉsourceˉwvbˉlowˉbyte(202u32); }
    if Operation == 170u32 { return Compilerˉsourceˉwvbˉlowˉbyte(201u32); }
    if Operation == 171u32 { return Compilerˉsourceˉwvbˉlowˉbyte(206u32); }
    if Operation == 172u32 { return Compilerˉsourceˉwvbˉlowˉbyte(207u32); }
    if Operation == 173u32 { return Compilerˉsourceˉwvbˉlowˉbyte(208u32); }
    if Operation == 175u32 { return Compilerˉsourceˉwvbˉlowˉbyte(209u32); }
    if Operation == 176u32 { return Compilerˉsourceˉwvbˉlowˉbyte(210u32); }
    if Operation == 177u32 { return Compilerˉsourceˉwvbˉlowˉbyte(211u32); }
    if Operation == 178u32 { return Compilerˉsourceˉwvbˉlowˉbyte(212u32); }
    if Operation == 179u32 { return Compilerˉsourceˉwvbˉlowˉbyte(213u32); }
    if Operation >= 180u32 && Operation <= 185u32 {
        return Compilerˉsourceˉwvbˉlowˉbyte(Operation + 34u32);
    }
    if Operation == 186u32 { return Compilerˉsourceˉwvbˉlowˉbyte(220u32); }
    if Operation == 187u32 { return Compilerˉsourceˉwvbˉlowˉbyte(221u32); }
    if Operation == 188u32 { return Compilerˉsourceˉwvbˉlowˉbyte(222u32); }
    if Operation == 189u32 { return Compilerˉsourceˉwvbˉlowˉbyte(223u32); }
    if Operation == 190u32 { return Compilerˉsourceˉwvbˉlowˉbyte(224u32); }
    if Operation == 191u32 { return Compilerˉsourceˉwvbˉlowˉbyte(225u32); }
    if Operation == 192u32 { return Compilerˉsourceˉwvbˉlowˉbyte(227u32); }
    if Operation == 193u32 { return Compilerˉsourceˉwvbˉlowˉbyte(228u32); }
    if Operation == 194u32 { return Compilerˉsourceˉwvbˉlowˉbyte(208u32); }
    if Operation >= 195u32 && Operation <= 207u32 {
        return Compilerˉsourceˉwvbˉlowˉbyte(Operation + 34u32);
    }
    return Compilerˉsourceˉwvbˉlowˉbyte(0u32);
}
export fn Compilerˉsourceˉwvbˉoperationˉisˉsupported(Operation: u32) -> bool {
    if Operation >= 1u32 {
        if Operation <= 207u32 { return true; }
    }
    return false;
}

export fn Compilerˉsourceˉwvbˉoperationˉlength(
    Operation: u32,
    Shape: u32,
    Operands: u32
) -> u32 {
    if Operation == 64u32 { return 0u32; }
    var Opcodeˉbytes: u32 = 0u32;
    if Operation == 1u32 || Operation == 3u32 ||
        (Operation >= 5u32 && Operation <= 10u32) ||
        Operation == 17u32 || Operation == 18u32 ||
        Operation == 62u32 || Operation == 63u32 ||
        Operation == 129u32 {
        Opcodeˉbytes = 5u32;
    }
    if Operation == 2u32 || Operation == 4u32 ||
        Operation == 149u32 || Operation == 150u32 {
        Opcodeˉbytes = 2u32;
    }
    if Operation >= 11u32 && Operation <= 16u32 { Opcodeˉbytes = 1u32; }
    if Operation == 19u32 { Opcodeˉbytes = 9u32; }
    if Operation >= 20u32 && Operation <= 61u32 { Opcodeˉbytes = 1u32; }
    if Operation >= 65u32 && Operation <= 68u32 { Opcodeˉbytes = 9u32; }
    if Operation >= 69u32 && Operation <= 92u32 { Opcodeˉbytes = 1u32; }
    if Operation == 93u32 || Operation == 94u32 || Operation == 164u32 {
        Opcodeˉbytes = 9u32;
    }
    if Operation >= 95u32 && Operation <= 128u32 { Opcodeˉbytes = 1u32; }
    if Operation >= 130u32 && Operation <= 147u32 { Opcodeˉbytes = 3u32; }
    if Operation == 148u32 { Opcodeˉbytes = 6u32; }
    if Operation == 151u32 {
        Opcodeˉbytes = 7u32;
        if Shape == 15u32 { Opcodeˉbytes = 11u32; }
    }
    if Operation >= 152u32 && Operation <= 162u32 { Opcodeˉbytes = 3u32; }
    if Operation == 163u32 { Opcodeˉbytes = 1u32; }
    if Operation == 165u32 { Opcodeˉbytes = 5u32; }
    if Operation == 166u32 { Opcodeˉbytes = 1u32; }
    if Operation == 167u32 || Operation == 168u32 {
        Opcodeˉbytes = 6u32;
    }
    if Operation == 169u32 { Opcodeˉbytes = 15u32; }
    if Operation == 170u32 { Opcodeˉbytes = 14u32; }
    if Operation == 171u32 || Operation == 172u32 || Operation == 173u32 {
        Opcodeˉbytes = 9u32;
    }
    if Operation == 174u32 { Opcodeˉbytes = 6u32; }
    if Operation == 175u32 { Opcodeˉbytes = 13u32; }
    if Operation == 176u32 { Opcodeˉbytes = 5u32; }
    if Operation == 177u32 { Opcodeˉbytes = 9u32; }
    if Operation == 178u32 { Opcodeˉbytes = 5u32; }
    if Operation == 179u32 { Opcodeˉbytes = 13u32; }
    if Operation == 180u32 || Operation == 181u32 || Operation == 184u32 {
        Opcodeˉbytes = 9u32;
    }
    if Operation == 182u32 || Operation == 183u32 {
        Opcodeˉbytes = 13u32;
    }
    if Operation == 185u32 { Opcodeˉbytes = 6u32; }
    if Operation == 186u32 { Opcodeˉbytes = 13u32; }
    if Operation == 187u32 { Opcodeˉbytes = 9u32; }
    if Operation == 188u32 { Opcodeˉbytes = 13u32; }
    if Operation == 189u32 { Opcodeˉbytes = 13u32; }
    if Operation == 190u32 { Opcodeˉbytes = 13u32; }
    if Operation == 191u32 { Opcodeˉbytes = 13u32; }
    if Operation == 192u32 || Operation == 193u32 || Operation == 194u32 {
        Opcodeˉbytes = 9u32;
    }
    if Operation >= 195u32 && Operation <= 201u32 { Opcodeˉbytes = 13u32; }
    if Operation >= 202u32 && Operation <= 207u32 { Opcodeˉbytes = 1u32; }
    if Operation == 205u32 { Opcodeˉbytes = 5u32; }
    var Result: u32 = Operands * 5u32 + Opcodeˉbytes;
    if Shape != 0u32 { Result = Result + 5u32; }
    return Result;
}

export fn Compilerˉsourceˉwvbˉsymbolˉmodule(
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Entry: u32
) -> u32 {
    return Bytesˉreadˉu32ˉlittle(Symbols.Directory, 16u32 + Entry * 24u32);
}

export fn Compilerˉsourceˉwvbˉsymbolˉsource(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Entry: u32
) -> Sourceˉset.Compilerˉsourceˉsetˉview {
    return Sourceˉset.Compilerˉsourceˉsetˉmodule(
        Input, Scan, Compilerˉsourceˉwvbˉsymbolˉmodule(Symbols, Entry)
    );
}

export fn Compilerˉsourceˉwvbˉsymbolˉname(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Entry: u32
) -> bytes {
    return Sourceˉsymbols.Compilerˉsourceˉsymbolsˉlookupˉemittedˉname(
        Symbols.Lookup, Scan.Modules, Entry
    );
}

export fn Compilerˉsourceˉwvbˉfunctionˉdeclaration(
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Bindingˉdirectory: bytes,
    Function: u32
) -> u32 {
    let Symbolˉentries: u32 = Bytesˉreadˉu32ˉlittle(
        Symbols.Directory, 8u32
    );
    if Function < Symbolˉentries { return Function; }
    return Sourceˉbindings.Compilerˉsourceˉbindingsˉrangeˉdeclaration(
        Bindingˉdirectory, Function
    );
}

export fn Compilerˉsourceˉwvbˉfunctionˉname(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Function: u32
) -> bytes {
    let Symbolˉentries: u32 = Bytesˉreadˉu32ˉlittle(
        Symbols.Directory, 8u32
    );
    if Function < Symbolˉentries {
        return Compilerˉsourceˉwvbˉsymbolˉname(
            Input, Scan, Symbols, Function
        );
    }
    return Compilerˉsourceˉwvbˉspecializationˉname(
        Function - Symbolˉentries
    );
}

export fn Compilerˉsourceˉwvbˉcapabilityˉsignature(
    Source: bytes,
    Offset: u32,
    Length: u32
) -> bytes {
    let Parameters: u32 = Sourceˉbindings.Compilerˉsourceˉbindingsˉcapabilityˉarity(
        Source, Offset, Length
    );
    var Result: bytes = Bytesˉfromˉu32ˉlittle(Parameters);
    var Parameter: u32 = 0u32;
    while Parameter < Parameters {
        Result = Bytesˉconcat(
            Result,
            Compilerˉsourceˉwvbˉshape(
                Sourceˉwir.Compilerˉsourceˉwirˉcapabilityˉparameterˉshape(
                    Source, Offset, Length, Parameter
                )
            )
        );
        Parameter = Parameter + 1u32;
    }
    return Bytesˉconcat(
        Result,
        Compilerˉsourceˉwvbˉshape(
            Sourceˉwir.Compilerˉsourceˉwirˉcapabilityˉreturnˉshape(
                Source, Offset, Length
            )
        )
    );
}

export fn Compilerˉsourceˉwvbˉencodeˉcapabilities(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Order: Compilerˉsourceˉwvbˉsymbolˉorder
) -> Compilerˉsourceˉwvbˉdataˉencoding {
    var Rootˉcapabilities: u32 = 0u32;
    var Countˉrank: u32 = 0u32;
    while Countˉrank < Symbols.Capabilities {
        let Countˉentry: u32 = Compilerˉsourceˉwvbˉorderedˉsymbol(Order, Countˉrank);
        if Compilerˉsourceˉwvbˉsymbolˉmodule(Symbols, Countˉentry) == 0u32 {
            Rootˉcapabilities = Rootˉcapabilities + 1u32;
        }
        Countˉrank = Countˉrank + 1u32;
    }
    var Payload: bytes = Bytesˉfromˉu32ˉlittle(Rootˉcapabilities);
    var Rank: u32 = 0u32;
    while Rank < Symbols.Capabilities {
        let Entry: u32 = Compilerˉsourceˉwvbˉorderedˉsymbol(Order, Rank);
        if Compilerˉsourceˉwvbˉsymbolˉmodule(Symbols, Entry) == 0u32 {
            let View: Sourceˉset.Compilerˉsourceˉsetˉview = Compilerˉsourceˉwvbˉsymbolˉsource(
                Input, Scan, Symbols, Entry
            );
            let Header: Sourceˉdeclarations.Compilerˉsourceˉheader = Sourceˉdeclarations.Compilerˉparseˉheaderˉvalidated(
                View.Source
            );
            let Declaration: Sourceˉdeclarations.Compilerˉsourceˉdeclaration =
                Compilerˉsourceˉwvbˉdeclaration(View.Source, Header, Symbols, Entry);
            let Signature: bytes = Compilerˉsourceˉwvbˉcapabilityˉsignature(
                View.Source, Declaration.Nameˉoffset, Declaration.Nameˉlength
            );
            Payload = Bytesˉconcat(
                Payload,
                Compilerˉsourceˉwvbˉstring(
                    View.Source, Declaration.Nameˉoffset, Declaration.Nameˉlength
                )
            );
            Payload = Bytesˉconcat(Payload, Signature);
        }
        Rank = Rank + 1u32;
    }
    return Compilerˉsourceˉwvbˉdataˉencoding(
        Compilerˉsourceˉwvbˉstatus.Valid,
        Payload
    );
}

export fn Compilerˉsourceˉwvbˉsymbolˉrank(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Entry: u32,
    Kind: u32
) -> u32 {
    let Entries: u32 = Bytesˉreadˉu32ˉlittle(Symbols.Directory, 8u32);
    let Entryˉoffset: u32 = 16u32 + Entry * 24u32;
    let Name: bytes = Compilerˉsourceˉwvbˉsymbolˉname(
        Input, Scan, Symbols, Entry
    );
    var Rank: u32 = 0u32;
    var Candidate: u32 = 0u32;
    while Candidate < Entries {
        let Candidateˉoffset: u32 = 16u32 + Candidate * 24u32;
        if Bytesˉreadˉu32ˉlittle(
            Symbols.Directory, Candidateˉoffset + 4u32
        ) == Kind {
            let Candidateˉname: bytes = Compilerˉsourceˉwvbˉsymbolˉname(
                Input, Scan, Symbols, Candidate
            );
            if Sourceˉset.Compilerˉsourceˉspansˉcompare(
                Candidateˉname, 0u32, Bytesˉlength(Candidateˉname),
                Name, 0u32, Bytesˉlength(Name)
            ) < 0 { Rank = Rank + 1u32; }
        }
        Candidate = Candidate + 1u32;
    }
    return Rank;
}

export fn Compilerˉsourceˉwvbˉbuildˉsymbolˉorder(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Kind: u32
) -> Compilerˉsourceˉwvbˉsymbolˉorder {
    let Entries: u32 = Bytesˉreadˉu32ˉlittle(Symbols.Directory, 8u32);
    var Ordered: bytes = Compilerˉsourceˉwvbˉempty(Input);
    var Count: u32 = 0u32;
    var Candidate: u32 = 0u32;
    while Candidate < Entries {
        let Candidateˉentry: u32 = 16u32 + Candidate * 24u32;
        if Bytesˉreadˉu32ˉlittle(
            Symbols.Directory, Candidateˉentry + 4u32
        ) == Kind {
            let Candidateˉname: bytes = Compilerˉsourceˉwvbˉsymbolˉname(
                Input, Scan, Symbols, Candidate
            );
            var Position: u32 = 0u32;
            var Insertˉat: u32 = Count;
            while Position < Count {
                if Insertˉat == Count {
                    let Existing: u32 = Bytesˉreadˉu32ˉlittle(
                        Ordered, Position * 4u32
                    );
                    let Existingˉname: bytes = Compilerˉsourceˉwvbˉsymbolˉname(
                        Input, Scan, Symbols, Existing
                    );
                    if Sourceˉset.Compilerˉsourceˉspansˉcompare(
                        Candidateˉname, 0u32, Bytesˉlength(Candidateˉname),
                        Existingˉname, 0u32, Bytesˉlength(Existingˉname)
                    ) < 0 { Insertˉat = Position; }
                }
                Position = Position + 1u32;
            }
            let Inserted: Byteˉconstruction.Foundationˉbytesˉresult = Byteˉconstruction.Foundationˉbytesˉreplace(
                Ordered,
                Insertˉat * 4u32,
                0u32,
                Bytesˉfromˉu32ˉlittle(Candidate)
            );
            Ordered = Inserted.Value;
            Count = Count + 1u32;
        }
        Candidate = Candidate + 1u32;
    }
    let Repeated: Byteˉconstruction.Foundationˉbytesˉresult = Byteˉconstruction.Foundationˉbytesˉrepeat(
        0u8, Entries * 4u32
    );
    var Ranks: bytes = Repeated.Value;
    var Rank: u32 = 0u32;
    while Rank < Count {
        let Entry: u32 = Bytesˉreadˉu32ˉlittle(Ordered, Rank * 4u32);
        let Replaced: Byteˉconstruction.Foundationˉbytesˉresult = Byteˉconstruction.Foundationˉbytesˉreplace(
            Ranks,
            Entry * 4u32,
            4u32,
            Bytesˉfromˉu32ˉlittle(Rank)
        );
        Ranks = Replaced.Value;
        Rank = Rank + 1u32;
    }
    return Compilerˉsourceˉwvbˉsymbolˉorder(Ordered, Ranks);
}

export fn Compilerˉsourceˉwvbˉbuildˉfunctionˉorder(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Wir: bytes
) -> Compilerˉsourceˉwvbˉsymbolˉorder {
    let Base: Compilerˉsourceˉwvbˉsymbolˉorder =
        Compilerˉsourceˉwvbˉbuildˉsymbolˉorder(
            Input, Scan, Symbols, 6u32
        );
    let Symbolˉentries: u32 = Bytesˉreadˉu32ˉlittle(
        Symbols.Directory, 8u32
    );
    let Functions: u32 = Bytesˉreadˉu32ˉlittle(Wir, 8u32);
    let Functionsˉoffset: u32 =
        Sourceˉwir.Compilerˉsourceˉwirˉfunctionsˉoffset(Wir);
    var Ordered: bytes = Compilerˉsourceˉwvbˉempty(Input);
    var Rank: u32 = 0u32;
    while Rank < Symbols.Functions {
        let Candidate: u32 = Compilerˉsourceˉwvbˉorderedˉsymbol(
            Base, Rank
        );
        let Candidateˉentry: u32 = Functionsˉoffset + Candidate * 48u32;
        if Bytesˉreadˉu32ˉlittle(Wir, Candidateˉentry + 8u32) > 0u32 {
            Ordered = Bytesˉconcat(
                Ordered, Bytesˉfromˉu32ˉlittle(Candidate)
            );
        }
        Rank = Rank + 1u32;
    }
    var Specialization: u32 = Symbolˉentries;
    while Specialization < Functions {
        Ordered = Bytesˉconcat(
            Ordered, Bytesˉfromˉu32ˉlittle(Specialization)
        );
        Specialization = Specialization + 1u32;
    }
    let Repeated: Byteˉconstruction.Foundationˉbytesˉresult =
        Byteˉconstruction.Foundationˉbytesˉrepeat(0u8, Functions * 4u32);
    var Ranks: bytes = Repeated.Value;
    Rank = 0u32;
    while Rank < Bytesˉlength(Ordered) / 4u32 {
        let Entry: u32 = Bytesˉreadˉu32ˉlittle(Ordered, Rank * 4u32);
        let Replaced: Byteˉconstruction.Foundationˉbytesˉresult =
            Byteˉconstruction.Foundationˉbytesˉreplace(
                Ranks, Entry * 4u32, 4u32,
                Bytesˉfromˉu32ˉlittle(Rank)
            );
        Ranks = Replaced.Value;
        Rank = Rank + 1u32;
    }
    return Compilerˉsourceˉwvbˉsymbolˉorder(Ordered, Ranks);
}

fn Compilerˉsourceˉwvbˉnominalˉisˉtemplate(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Entry: u32
) -> bool {
    let View: Sourceˉset.Compilerˉsourceˉsetˉview =
        Compilerˉsourceˉwvbˉsymbolˉsource(Input, Scan, Symbols, Entry);
    let Directoryˉentry: u32 = 16u32 + Entry * 24u32;
    let Nameˉoffset: u32 = Bytesˉreadˉu32ˉlittle(
        Symbols.Directory, Directoryˉentry + 12u32
    );
    let Nameˉlength: u32 = Bytesˉreadˉu32ˉlittle(
        Symbols.Directory, Directoryˉentry + 16u32
    );
    let Afterˉname: Sourceˉlexer.Compilerˉsourceˉtoken =
        Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            View.Source, Nameˉoffset + Nameˉlength, 1u32, 1u32
        );
    return Afterˉname.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Less;
}

fn Compilerˉsourceˉwvbˉbuildˉrecordˉtargets(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Records: Compilerˉsourceˉwvbˉsymbolˉorder
) -> bytes {
    var Recordˉtargets: bytes = Compilerˉsourceˉwvbˉempty(Input);
    var Concreteˉrecords: u32 = 0u32;
    var Rank: u32 = 0u32;
    while Rank < Symbols.Records {
        let Recordˉentry: u32 =
            Compilerˉsourceˉwvbˉorderedˉsymbol(Records, Rank);
        var Recordˉtarget: u32 = 4294967295u32;
        if !Compilerˉsourceˉwvbˉnominalˉisˉtemplate(
                Input, Scan, Symbols, Recordˉentry
            ) {
            Recordˉtarget = Concreteˉrecords;
            Concreteˉrecords = Concreteˉrecords + 1u32;
        }
        Recordˉtargets = Bytesˉconcat(
            Recordˉtargets, Bytesˉfromˉu32ˉlittle(Recordˉtarget)
        );
        Rank = Rank + 1u32;
    }
    return Recordˉtargets;
}

fn Compilerˉsourceˉwvbˉconcreteˉnominalˉcount(
    Targets: bytes
) -> u32 {
    var Count: u32 = 0u32;
    var Offset: u32 = 0u32;
    while Offset < Bytesˉlength(Targets) {
        if Bytesˉreadˉu32ˉlittle(Targets, Offset) != 4294967295u32 {
            Count = Count + 1u32;
        }
        Offset = Offset + 4u32;
    }
    return Count;
}

fn Compilerˉsourceˉwvbˉbuildˉvariantˉtargets(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Variants: Compilerˉsourceˉwvbˉsymbolˉorder,
    Concreteˉrecords: u32
) -> bytes {
    var Variantˉtargets: bytes = Compilerˉsourceˉwvbˉempty(Input);
    var Concreteˉvariants: u32 = 0u32;
    var Rank: u32 = 0u32;
    while Rank < Symbols.Variants {
        let Variantˉentry: u32 =
            Compilerˉsourceˉwvbˉorderedˉsymbol(Variants, Rank);
        var Variantˉtarget: u32 = 4294967295u32;
        if !Compilerˉsourceˉwvbˉnominalˉisˉtemplate(
                Input, Scan, Symbols, Variantˉentry
            ) {
            Variantˉtarget =
                Concreteˉrecords + Symbols.Enums + Concreteˉvariants;
            Concreteˉvariants = Concreteˉvariants + 1u32;
        }
        Variantˉtargets = Bytesˉconcat(
            Variantˉtargets, Bytesˉfromˉu32ˉlittle(Variantˉtarget)
        );
        Rank = Rank + 1u32;
    }
    return Variantˉtargets;
}

export fn Compilerˉsourceˉwvbˉbuildˉsymbolˉorders(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Wir: bytes
) -> Compilerˉsourceˉwvbˉsymbolˉorders {
    let Capabilities: Compilerˉsourceˉwvbˉsymbolˉorder =
        Compilerˉsourceˉwvbˉbuildˉsymbolˉorder(Input, Scan, Symbols, 2u32);
    let Data: Compilerˉsourceˉwvbˉsymbolˉorder =
        Compilerˉsourceˉwvbˉbuildˉsymbolˉorder(Input, Scan, Symbols, 3u32);
    let Records: Compilerˉsourceˉwvbˉsymbolˉorder =
        Compilerˉsourceˉwvbˉbuildˉsymbolˉorder(Input, Scan, Symbols, 4u32);
    let Enums: Compilerˉsourceˉwvbˉsymbolˉorder =
        Compilerˉsourceˉwvbˉbuildˉsymbolˉorder(Input, Scan, Symbols, 5u32);
    let Variants: Compilerˉsourceˉwvbˉsymbolˉorder =
        Compilerˉsourceˉwvbˉbuildˉsymbolˉorder(Input, Scan, Symbols, 8u32);
    let Functions: Compilerˉsourceˉwvbˉsymbolˉorder =
        Compilerˉsourceˉwvbˉbuildˉfunctionˉorder(
            Input, Scan, Symbols, Wir
        );
    let Recordˉtargets: bytes =
        Compilerˉsourceˉwvbˉbuildˉrecordˉtargets(
            Input, Scan, Symbols, Records
        );
    let Concreteˉrecords: u32 =
        Compilerˉsourceˉwvbˉconcreteˉnominalˉcount(Recordˉtargets);
    let Variantˉtargets: bytes =
        Compilerˉsourceˉwvbˉbuildˉvariantˉtargets(
            Input, Scan, Symbols, Variants, Concreteˉrecords
        );
    let Concreteˉvariants: u32 =
        Compilerˉsourceˉwvbˉconcreteˉnominalˉcount(Variantˉtargets);
    return Compilerˉsourceˉwvbˉsymbolˉorders(
        Capabilities.Entries, Capabilities.Ranks,
        Data.Entries, Data.Ranks,
        Records.Entries, Records.Ranks,
        Enums.Entries, Enums.Ranks,
        Variants.Entries, Variants.Ranks,
        Functions.Entries, Functions.Ranks,
        Recordˉtargets, Variantˉtargets,
        Concreteˉrecords, Concreteˉvariants, 0u32,
        Compilerˉsourceˉwvbˉempty(Input), 0u32,
        Compilerˉsourceˉwvbˉempty(Input), Compilerˉsourceˉwvbˉempty(Input), 0u32,
        Compilerˉsourceˉwvbˉempty(Input),
        Compilerˉsourceˉwvbˉownershipˉconstructors(Wir)
    );
}

export fn Compilerˉsourceˉwvbˉcapabilityˉorder(
    Orders: Compilerˉsourceˉwvbˉsymbolˉorders
) -> Compilerˉsourceˉwvbˉsymbolˉorder {
    return Compilerˉsourceˉwvbˉsymbolˉorder(
        Orders.Capabilityˉentries, Orders.Capabilityˉranks
    );
}

export fn Compilerˉsourceˉwvbˉdataˉorder(
