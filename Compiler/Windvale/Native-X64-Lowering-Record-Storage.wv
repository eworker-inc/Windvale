module Compilerˉnativeˉx64ˉloweringˉrecordˉstorage profile portable;

import Compilerˉnativeˉx64ˉloweringˉtypes as Nominalˉtypes;
import Compilerˉnativeˉx64ˉloweringˉlayout as Layout;
import Compilerˉnativeˉx64ˉloweringˉrecordˉallocation as Allocation;
import Compilerˉnativeˉx64ˉloweringˉrecordˉlocalˉliveness as Localˉliveness;

export record Compilerˉnativeˉx64ˉrecordˉstorage {
    Valid: bool;
    Persistentˉoffsets: bytes;
    Scratchˉoffsets: bytes;
    Persistentˉfields: u32;
    Scratchˉfields: u32;
    Recordˉvalues: u32;
}

fn Empty(Input: bytes) -> bytes {
    return Bytesˉslice(Input, 0u32, 0u32);
}

fn Invalid(Input: bytes) -> Compilerˉnativeˉx64ˉrecordˉstorage {
    let Value: bytes = Empty(Input);
    return Compilerˉnativeˉx64ˉrecordˉstorage(
        false,
        Value,
        Value,
        0u32,
        0u32,
        0u32
    );
}

export fn Compilerˉnativeˉx64ˉemptyˉrecordˉstorage(Input: bytes)
    -> Compilerˉnativeˉx64ˉrecordˉstorage {
    let Value: bytes = Empty(Input);
    return Compilerˉnativeˉx64ˉrecordˉstorage(
        true,
        Value,
        Value,
        0u32,
        0u32,
        0u32
    );
}

fn Zeros(Input: bytes, Count: u32) -> bytes {
    var Result: bytes = Empty(Input);
    var Index: u32 = 0u32;
    while Index < Count {
        Result = Bytesˉconcat(Result, Bytesˉfromˉu8(0u8));
        Index = Index + 1u32;
    }
    return Result;
}

fn U32ˉvalues(Input: bytes, Count: u32, Value: u32) -> bytes {
    var Result: bytes = Empty(Input);
    var Index: u32 = 0u32;
    while Index < Count {
        Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Value));
        Index = Index + 1u32;
    }
    return Result;
}

fn Setˉbyte(Input: bytes, Index: u32, Value: u8) -> bytes {
    return Bytesˉconcat(
        Bytesˉconcat(
            Bytesˉslice(Input, 0u32, Index),
            Bytesˉfromˉu8(Value)
        ),
        Bytesˉslice(Input, Index + 1u32, Bytesˉlength(Input) - Index - 1u32)
    );
}

fn Setˉu32(Input: bytes, Index: u32, Value: u32) -> bytes {
    let Offset: u32 = Index * 4u32;
    return Bytesˉconcat(
        Bytesˉconcat(
            Bytesˉslice(Input, 0u32, Offset),
            Bytesˉfromˉu32ˉlittle(Value)
        ),
        Bytesˉslice(Input, Offset + 4u32, Bytesˉlength(Input) - Offset - 4u32)
    );
}

fn Pushˉrecord(Records: bytes, Record: u32) -> bytes {
    return Bytesˉconcat(Records, Bytesˉfromˉu32ˉlittle(Record));
}

fn Popˉrecords(Records: bytes, Depth: u32) -> bytes {
    return Bytesˉslice(Records, 0u32, Depth * 4u32);
}

fn Instructionˉsize(Opcode: u8) -> u32 {
    if Opcode == 1u8 { return 5u32; }
    if Opcode == 2u8 { return 2u32; }
    if Opcode == 3u8 { return 5u32; }
    if Opcode == 4u8 { return 5u32; }
    if Opcode == 5u8 { return 5u32; }
    if Opcode == 6u8 { return 5u32; }
    if Opcode == 7u8 { return 5u32; }
    if Opcode == 8u8 { return 2u32; }
    if Opcode == 9u8 { return 5u32; }
    if Opcode == 10u8 { return 5u32; }
    let Numeric: u32 = U32ˉfromˉu8(Opcode);
    if Numeric >= 11u32 {
        if Numeric <= 20u32 { return 1u32; }
    }
    if Numeric >= 32u32 {
        if Numeric <= 40u32 { return 1u32; }
    }
    if Opcode == 48u8 || Opcode == 49u8 || Opcode == 64u8 {
        return 5u32;
    }
    if Opcode == 81u8 { return 1u32; }
    if Numeric >= 96u32 {
        if Numeric <= 103u32 { return 1u32; }
    }
    if Opcode == 104u8 { return 5u32; }
    if Opcode == 105u8 { return 5u32; }
    if Opcode == 106u8 { return 9u32; }
    if Opcode == 107u8 || Opcode == 108u8 || Opcode == 109u8 {
        return 1u32;
    }
    if Numeric >= 113u32 {
        if Numeric <= 117u32 { return 1u32; }
    }
    if Opcode == 119u8 || Opcode == 124u8 { return 1u32; }
    return 0u32;
}

fn Recordˉwidth(
    Types: Nominalˉtypes.Compilerˉnativeˉx64ˉtypes,
    Type: u8
) -> u32 {
    return Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉitemˉcount(
        Types,
        Nominalˉtypes.Compilerˉnativeˉx64ˉrecordˉtypeˉindex(Type)
    );
}

fn Rememberˉrecordˉtype(
    Recordˉtypes: bytes,
    Types: Nominalˉtypes.Compilerˉnativeˉx64ˉtypes,
    Identifier: u32,
    Type: u8
) -> bytes {
    if Identifier == Bytesˉlength(Recordˉtypes) {
        return Bytesˉconcat(Recordˉtypes, Bytesˉfromˉu8(Type));
    }
    let Existing: u8 = Bytesˉreadˉu8(Recordˉtypes, Identifier);
    if Recordˉwidth(Types, Type) > Recordˉwidth(Types, Existing) {
        return Setˉbyte(Recordˉtypes, Identifier, Type);
    }
    return Recordˉtypes;
}

fn Pushˉscalar(Records: bytes) -> bytes {
    return Pushˉrecord(Records, 4294967295u32);
}

export fn Compilerˉnativeˉx64ˉrecordˉstorageˉread(
    Input: bytes,
    Codeˉoffset: u32,
    Codeˉlength: u32,
    Parameters: u32,
    Returnˉtype: u8,
    Localˉtypes: bytes,
    Callˉdirectory: bytes,
    Types: Nominalˉtypes.Compilerˉnativeˉx64ˉtypes,
    Blocks: u32,
    Leaders: bytes
) -> Compilerˉnativeˉx64ˉrecordˉstorage {
    let Locals: u32 = Bytesˉlength(Localˉtypes);
    if Locals > 128u32 || Blocks == 0u32 || Blocks > 128u32 {
        return Invalid(Input);
    }
    if Codeˉlength == 0u32 || Bytesˉlength(Leaders) < Codeˉlength {
        return Invalid(Input);
    }
    if Bytesˉreadˉu8(Leaders, 0u32) != 1u8 { return Invalid(Input); }

    var Blockˉbyˉoffset: bytes = U32ˉvalues(
        Input,
        Codeˉlength,
        4294967295u32
    );
    var Countedˉblocks: u32 = 0u32;
    var Offset: u32 = 0u32;
    while Offset < Codeˉlength {
        if Bytesˉreadˉu8(Leaders, Offset) == 1u8 {
            if Countedˉblocks >= Blocks { return Invalid(Input); }
            Blockˉbyˉoffset = Setˉu32(
                Blockˉbyˉoffset,
                Offset,
                Countedˉblocks
            );
            Countedˉblocks = Countedˉblocks + 1u32;
        }
        Offset = Offset + 1u32;
    }
    if Countedˉblocks != Blocks { return Invalid(Input); }

    var Instructionˉoffsets: bytes = Empty(Input);
    var Blockˉstarts: bytes = U32ˉvalues(Input, Blocks, 4294967295u32);
    var Blockˉends: bytes = U32ˉvalues(Input, Blocks, 4294967295u32);
    var Successorˉfirst: bytes = U32ˉvalues(Input, Blocks, 4294967295u32);
    var Successorˉsecond: bytes = U32ˉvalues(Input, Blocks, 4294967295u32);
    var Uses: bytes = Zeros(Input, Blocks * Locals);
    var Definitions: bytes = Zeros(Input, Blocks * Locals);
    var Stackˉrecords: bytes = Empty(Input);
    var Depth: u32 = 0u32;
    var Events: bytes = Empty(Input);
    var Recordˉtypes: bytes = Empty(Input);
    var Lastˉuses: bytes = U32ˉvalues(
        Input,
        Blocks * 128u32,
        4294967295u32
    );
    var Recordˉvalues: u32 = 0u32;
    var Blockˉrecordˉvalues: u32 = 0u32;
    var Currentˉblock: u32 = 4294967295u32;
    var Instructions: u32 = 0u32;
    var Cursor: u32 = 0u32;
    while Cursor < Codeˉlength {
        if Bytesˉreadˉu8(Leaders, Cursor) == 1u8 {
            if Currentˉblock != 4294967295u32 {
                if Depth != 0u32 { return Invalid(Input); }
                if Bytesˉreadˉu32ˉlittle(
                    Blockˉends,
                    Currentˉblock * 4u32
                ) == 4294967295u32 {
                    Blockˉends = Setˉu32(
                        Blockˉends,
                        Currentˉblock,
                        Instructions
                    );
                    Successorˉfirst = Setˉu32(
                        Successorˉfirst,
                        Currentˉblock,
                        Currentˉblock + 1u32
                    );
                }
            }
            Currentˉblock = Bytesˉreadˉu32ˉlittle(
                Blockˉbyˉoffset,
                Cursor * 4u32
            );
            if Currentˉblock == 4294967295u32 { return Invalid(Input); }
            Blockˉstarts = Setˉu32(
                Blockˉstarts,
                Currentˉblock,
                Instructions
            );
            Stackˉrecords = Empty(Input);
            Depth = 0u32;
            Blockˉrecordˉvalues = 0u32;
        }
        if Currentˉblock == 4294967295u32 { return Invalid(Input); }

        let Opcode: u8 = Bytesˉreadˉu8(Input, Codeˉoffset + Cursor);
        let Numericˉopcode: u32 = U32ˉfromˉu8(Opcode);
        let Size: u32 = Instructionˉsize(Opcode);
        if Size == 0u32 || Size > Codeˉlength - Cursor {
            return Invalid(Input);
        }
        if Instructions >= 1024u32 { return Invalid(Input); }
        Instructionˉoffsets = Bytesˉconcat(
            Instructionˉoffsets,
            Bytesˉfromˉu32ˉlittle(Cursor)
        );
        var Resultˉrecord: u32 = 4294967295u32;
        var Usedˉrecord: u32 = 4294967295u32;
        var Handled: bool = false;

        if Opcode == 1u8 || Opcode == 2u8 || Opcode == 3u8 ||
            Opcode == 6u8 || Opcode == 8u8 || Opcode == 9u8 ||
            Opcode == 10u8 || Opcode == 106u8 {
            Stackˉrecords = Pushˉscalar(Stackˉrecords);
            Depth = Depth + 1u32;
            Handled = true;
        }

        if Opcode == 4u8 {
            let Loadˉlocal: u32 = Bytesˉreadˉu32ˉlittle(
                Input,
                Codeˉoffset + Cursor + 1u32
            );
            if Loadˉlocal >= Locals { return Invalid(Input); }
            let Loadˉtype: u8 = Bytesˉreadˉu8(Localˉtypes, Loadˉlocal);
            if Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉisˉrecord(Loadˉtype) {
                if Blockˉrecordˉvalues >= 128u32 { return Invalid(Input); }
                Resultˉrecord = Blockˉrecordˉvalues;
                Blockˉrecordˉvalues = Blockˉrecordˉvalues + 1u32;
                if Blockˉrecordˉvalues > Recordˉvalues {
                    Recordˉvalues = Blockˉrecordˉvalues;
                }
                Recordˉtypes = Rememberˉrecordˉtype(
                    Recordˉtypes,
                    Types,
                    Resultˉrecord,
                    Loadˉtype
                );
                if Loadˉlocal >= Parameters {
                    let Cell: u32 = Currentˉblock * Locals + Loadˉlocal;
                    if Bytesˉreadˉu8(Definitions, Cell) == 0u8 {
                        Uses = Setˉbyte(Uses, Cell, 1u8);
                    }
                }
                Stackˉrecords = Pushˉrecord(Stackˉrecords, Resultˉrecord);
            } else {
                Stackˉrecords = Pushˉscalar(Stackˉrecords);
            }
            Depth = Depth + 1u32;
            Handled = true;
        }

        if Opcode == 5u8 {
            if Depth == 0u32 { return Invalid(Input); }
            let Storeˉlocal: u32 = Bytesˉreadˉu32ˉlittle(
                Input,
                Codeˉoffset + Cursor + 1u32
            );
            if Storeˉlocal >= Locals { return Invalid(Input); }
            let Storeˉtype: u8 = Bytesˉreadˉu8(Localˉtypes, Storeˉlocal);
            if Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉisˉrecord(Storeˉtype) {
                if Storeˉlocal < Parameters { return Invalid(Input); }
                Usedˉrecord = Bytesˉreadˉu32ˉlittle(
                    Stackˉrecords,
                    (Depth - 1u32) * 4u32
                );
                if Usedˉrecord == 4294967295u32 { return Invalid(Input); }
                Lastˉuses = Setˉu32(
                    Lastˉuses,
                    Currentˉblock * 128u32 + Usedˉrecord,
                    Instructions
                );
                Definitions = Setˉbyte(
                    Definitions,
                    Currentˉblock * Locals + Storeˉlocal,
                    1u8
                );
            }
            Depth = Depth - 1u32;
            Stackˉrecords = Popˉrecords(Stackˉrecords, Depth);
            Handled = true;
        }

        if Opcode == 7u8 || Opcode == 11u8 || Opcode == 19u8 ||
            Opcode == 40u8 || Opcode == 109u8 || Opcode == 115u8 ||
            Opcode == 116u8 || Opcode == 117u8 || Opcode == 124u8 {
            if Depth == 0u32 { return Invalid(Input); }
            Depth = Depth - 1u32;
            Stackˉrecords = Popˉrecords(Stackˉrecords, Depth);
            Stackˉrecords = Pushˉscalar(Stackˉrecords);
            Depth = Depth + 1u32;
            Handled = true;
        }

        if Opcode == 12u8 {
            if Depth < 3u32 { return Invalid(Input); }
            Depth = Depth - 3u32;
            Stackˉrecords = Popˉrecords(Stackˉrecords, Depth);
            Stackˉrecords = Pushˉscalar(Stackˉrecords);
            Depth = Depth + 1u32;
            Handled = true;
        }

        if Numericˉopcode >= 13u32 && Numericˉopcode <= 18u32 ||
            Opcode == 20u8 ||
            Numericˉopcode >= 32u32 && Numericˉopcode <= 39u32 ||
            Numericˉopcode >= 96u32 && Numericˉopcode <= 103u32 ||
            Opcode == 107u8 || Opcode == 108u8 || Opcode == 113u8 ||
            Opcode == 114u8 || Opcode == 119u8 {
            if Depth < 2u32 { return Invalid(Input); }
            Depth = Depth - 2u32;
            Stackˉrecords = Popˉrecords(Stackˉrecords, Depth);
            Stackˉrecords = Pushˉscalar(Stackˉrecords);
            Depth = Depth + 1u32;
            Handled = true;
        }

        if Opcode == 104u8 {
            let Typeˉindex: u32 = Bytesˉreadˉu32ˉlittle(
                Input,
                Codeˉoffset + Cursor + 1u32
            );
            if Typeˉindex >= Types.Count { return Invalid(Input); }
            let Fields: u32 =
                Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉitemˉcount(
                    Types,
                    Typeˉindex
                );
            if Depth < Fields || Blockˉrecordˉvalues >= 128u32 {
                return Invalid(Input);
            }
            var Field: u32 = 0u32;
            while Field < Fields {
                if Bytesˉreadˉu32ˉlittle(
                    Stackˉrecords,
                    (Depth - Fields + Field) * 4u32
                ) != 4294967295u32 { return Invalid(Input); }
                Field = Field + 1u32;
            }
            Depth = Depth - Fields;
            Stackˉrecords = Popˉrecords(Stackˉrecords, Depth);
            Resultˉrecord = Blockˉrecordˉvalues;
            Blockˉrecordˉvalues = Blockˉrecordˉvalues + 1u32;
            if Blockˉrecordˉvalues > Recordˉvalues {
                Recordˉvalues = Blockˉrecordˉvalues;
            }
            let Createˉtype: u8 = Nominalˉtypes.Compilerˉnativeˉx64ˉrecordˉtype(
                Typeˉindex
            );
            Recordˉtypes = Rememberˉrecordˉtype(
                Recordˉtypes,
                Types,
                Resultˉrecord,
                Createˉtype
            );
            Stackˉrecords = Pushˉrecord(Stackˉrecords, Resultˉrecord);
            Depth = Depth + 1u32;
            Handled = true;
        }

        if Opcode == 105u8 {
            if Depth == 0u32 { return Invalid(Input); }
            Usedˉrecord = Bytesˉreadˉu32ˉlittle(
                Stackˉrecords,
                (Depth - 1u32) * 4u32
            );
            if Usedˉrecord == 4294967295u32 { return Invalid(Input); }
            Lastˉuses = Setˉu32(
                Lastˉuses,
                Currentˉblock * 128u32 + Usedˉrecord,
                Instructions
            );
            Depth = Depth - 1u32;
            Stackˉrecords = Popˉrecords(Stackˉrecords, Depth);
            Stackˉrecords = Pushˉscalar(Stackˉrecords);
            Depth = Depth + 1u32;
            Handled = true;
        }

        if Opcode == 64u8 {
            let Callˉtarget: u32 = Bytesˉreadˉu32ˉlittle(
                Input,
                Codeˉoffset + Cursor + 1u32
            );
            if Callˉtarget >= Bytesˉlength(Callˉdirectory) /
                Layout.Compilerˉnativeˉx64ˉlayoutˉentryˉbytes() {
                return Invalid(Input);
            }
            let Callˉparameters: u32 =
                Layout.Compilerˉnativeˉx64ˉlayoutˉparameters(
                    Callˉdirectory,
                    Callˉtarget
                );
            if Depth < Callˉparameters { return Invalid(Input); }
            var Parameter: u32 = 0u32;
            while Parameter < Callˉparameters {
                if Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉisˉrecord(
                    Layout.Compilerˉnativeˉx64ˉlayoutˉparameterˉtype(
                        Callˉdirectory,
                        Callˉtarget,
                        Parameter
                    )
                ) {
                    if Usedˉrecord != 4294967295u32 {
                        return Invalid(Input);
                    }
                    Usedˉrecord = Bytesˉreadˉu32ˉlittle(
                        Stackˉrecords,
                        (Depth - Callˉparameters + Parameter) * 4u32
                    );
                    if Usedˉrecord == 4294967295u32 { return Invalid(Input); }
                    Lastˉuses = Setˉu32(
                        Lastˉuses,
                        Currentˉblock * 128u32 + Usedˉrecord,
                        Instructions
                    );
                }
                Parameter = Parameter + 1u32;
            }
            Depth = Depth - Callˉparameters;
            Stackˉrecords = Popˉrecords(Stackˉrecords, Depth);
            let Callˉreturn: u8 =
                Layout.Compilerˉnativeˉx64ˉlayoutˉreturnˉtype(
                    Callˉdirectory,
                    Callˉtarget
                );
            if Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉisˉrecord(Callˉreturn) {
                if Blockˉrecordˉvalues >= 128u32 { return Invalid(Input); }
                Resultˉrecord = Blockˉrecordˉvalues;
                Blockˉrecordˉvalues = Blockˉrecordˉvalues + 1u32;
                if Blockˉrecordˉvalues > Recordˉvalues {
                    Recordˉvalues = Blockˉrecordˉvalues;
                }
                Recordˉtypes = Rememberˉrecordˉtype(
                    Recordˉtypes,
                    Types,
                    Resultˉrecord,
                    Callˉreturn
                );
                Stackˉrecords = Pushˉrecord(Stackˉrecords, Resultˉrecord);
            } else {
                Stackˉrecords = Pushˉscalar(Stackˉrecords);
            }
            Depth = Depth + 1u32;
            Handled = true;
        }

        if Opcode == 48u8 {
            if Depth != 0u32 { return Invalid(Input); }
            let Jumpˉtarget: u32 = Bytesˉreadˉu32ˉlittle(
                Input,
                Codeˉoffset + Cursor + 1u32
            );
            if Jumpˉtarget >= Codeˉlength { return Invalid(Input); }
            let Jumpˉtargetˉblock: u32 = Bytesˉreadˉu32ˉlittle(
                Blockˉbyˉoffset,
                Jumpˉtarget * 4u32
            );
            if Jumpˉtargetˉblock == 4294967295u32 { return Invalid(Input); }
            Blockˉends = Setˉu32(
                Blockˉends,
                Currentˉblock,
                Instructions + 1u32
            );
            Successorˉfirst = Setˉu32(
                Successorˉfirst,
                Currentˉblock,
                Jumpˉtargetˉblock
            );
            Handled = true;
        }

        if Opcode == 49u8 {
            if Depth != 1u32 || Currentˉblock + 1u32 >= Blocks {
                return Invalid(Input);
            }
            let Branchˉtarget: u32 = Bytesˉreadˉu32ˉlittle(
                Input,
                Codeˉoffset + Cursor + 1u32
            );
            if Branchˉtarget >= Codeˉlength { return Invalid(Input); }
            let Branchˉtargetˉblock: u32 = Bytesˉreadˉu32ˉlittle(
                Blockˉbyˉoffset,
                Branchˉtarget * 4u32
            );
            if Branchˉtargetˉblock == 4294967295u32 { return Invalid(Input); }
            Depth = 0u32;
            Stackˉrecords = Empty(Input);
            Blockˉends = Setˉu32(
                Blockˉends,
                Currentˉblock,
                Instructions + 1u32
            );
            Successorˉfirst = Setˉu32(
                Successorˉfirst,
                Currentˉblock,
                Branchˉtargetˉblock
            );
            Successorˉsecond = Setˉu32(
                Successorˉsecond,
                Currentˉblock,
                Currentˉblock + 1u32
            );
            Handled = true;
        }

        if Opcode == 81u8 {
            if Depth != 1u32 { return Invalid(Input); }
            if Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉisˉrecord(Returnˉtype) {
                Usedˉrecord = Bytesˉreadˉu32ˉlittle(Stackˉrecords, 0u32);
                if Usedˉrecord == 4294967295u32 { return Invalid(Input); }
                Lastˉuses = Setˉu32(
                    Lastˉuses,
                    Currentˉblock * 128u32 + Usedˉrecord,
                    Instructions
                );
            }
            Depth = 0u32;
            Stackˉrecords = Empty(Input);
            Blockˉends = Setˉu32(
                Blockˉends,
                Currentˉblock,
                Instructions + 1u32
            );
            Handled = true;
        }

        if !Handled { return Invalid(Input); }
        Events = Bytesˉconcat(
            Events,
            Bytesˉconcat(
                Bytesˉfromˉu32ˉlittle(Currentˉblock),
                Bytesˉconcat(
                    Bytesˉfromˉu32ˉlittle(Resultˉrecord),
                    Bytesˉfromˉu32ˉlittle(Usedˉrecord)
                )
            )
        );
        Cursor = Cursor + Size;
        Instructions = Instructions + 1u32;
    }
    if Cursor != Codeˉlength || Currentˉblock == 4294967295u32 ||
        Depth != 0u32 {
        return Invalid(Input);
    }
    if Bytesˉreadˉu32ˉlittle(
        Blockˉends,
        Currentˉblock * 4u32
    ) == 4294967295u32 {
        Blockˉends = Setˉu32(Blockˉends, Currentˉblock, Instructions);
    }

    let Persistent:
        Allocation.Compilerˉnativeˉx64ˉrecordˉallocation =
        Localˉliveness.Compilerˉnativeˉx64ˉplanˉrecordˉlocalˉstorage(
            Input,
            Codeˉoffset,
            Parameters,
            Localˉtypes,
            Types,
            Blocks,
            Instructionˉoffsets,
            Blockˉstarts,
            Blockˉends,
            Successorˉfirst,
            Successorˉsecond,
            Uses,
            Definitions
        );

    var Scratchˉpresent: bytes = Zeros(Input, Recordˉvalues);
    var Scratchˉlive: bytes = Zeros(Input, Recordˉvalues);
    var Scratchˉinterference: bytes = Zeros(
        Input,
        Recordˉvalues * Recordˉvalues
    );
    var Eventˉblock: u32 = 4294967295u32;
    var Event: u32 = 0u32;
    while Event < Instructions {
        let Block: u32 = Bytesˉreadˉu32ˉlittle(Events, Event * 12u32);
        if Block != Eventˉblock {
            var Liveˉrecord: u32 = 0u32;
            while Liveˉrecord < Recordˉvalues {
                if Bytesˉreadˉu8(Scratchˉlive, Liveˉrecord) == 1u8 {
                    return Invalid(Input);
                }
                Liveˉrecord = Liveˉrecord + 1u32;
            }
            Scratchˉlive = Zeros(Input, Recordˉvalues);
            Eventˉblock = Block;
        }
        let Result: u32 = Bytesˉreadˉu32ˉlittle(
            Events,
            Event * 12u32 + 4u32
        );
        let Use: u32 = Bytesˉreadˉu32ˉlittle(
            Events,
            Event * 12u32 + 8u32
        );
        if Result != 4294967295u32 {
            Scratchˉpresent = Setˉbyte(Scratchˉpresent, Result, 1u8);
            Scratchˉinterference =
                Allocation.Compilerˉnativeˉx64ˉaddˉliveˉrecordˉinterference(
                    Scratchˉinterference,
                    Scratchˉlive,
                    Recordˉvalues,
                    Result
                );
            Scratchˉlive = Setˉbyte(Scratchˉlive, Result, 1u8);
        }
        if Use != 4294967295u32 {
            if Bytesˉreadˉu8(Scratchˉlive, Use) != 1u8 {
                return Invalid(Input);
            }
            if Bytesˉreadˉu32ˉlittle(
                Lastˉuses,
                (Block * 128u32 + Use) * 4u32
            ) == Event {
                Scratchˉlive = Setˉbyte(Scratchˉlive, Use, 0u8);
            }
        }
        if Result != 4294967295u32 {
            if Bytesˉreadˉu32ˉlittle(
                Lastˉuses,
                (Block * 128u32 + Result) * 4u32
            ) == 4294967295u32 {
                Scratchˉlive = Setˉbyte(Scratchˉlive, Result, 0u8);
            }
        }
        Event = Event + 1u32;
    }
    var Remainingˉlive: u32 = 0u32;
    while Remainingˉlive < Recordˉvalues {
        if Bytesˉreadˉu8(Scratchˉlive, Remainingˉlive) == 1u8 {
            return Invalid(Input);
        }
        Remainingˉlive = Remainingˉlive + 1u32;
    }
    let Scratch:
        Allocation.Compilerˉnativeˉx64ˉrecordˉallocation =
        Allocation.Compilerˉnativeˉx64ˉallocateˉrecordˉoffsets(
            Input,
            Types,
            Scratchˉpresent,
            Recordˉtypes,
            Scratchˉinterference,
            Recordˉvalues
        );
    return Compilerˉnativeˉx64ˉrecordˉstorage(
        true,
        Persistent.Offsets,
        Scratch.Offsets,
        Persistent.Fields,
        Scratch.Fields,
        Recordˉvalues
    );
}
