module Compilerˉnativeˉx64ˉloweringˉrecordˉstorage profile portable;

import Compilerˉnativeˉx64ˉloweringˉtypes as Nominalˉtypes;

export record Compilerˉnativeˉx64ˉrecordˉstorage {
    Valid: bool;
    Persistentˉoffsets: bytes;
    Scratchˉoffsets: bytes;
    Persistentˉfields: u32;
    Scratchˉfields: u32;
    Recordˉvalues: u32;
}

fn Empty(Input: bytes) -> bytes {
    return Bytesˉslice(Input, 0u32, 0u32);
}

fn Invalid(Input: bytes) -> Compilerˉnativeˉx64ˉrecordˉstorage {
    let Value: bytes = Empty(Input);
    return Compilerˉnativeˉx64ˉrecordˉstorage(
        false,
        Value,
        Value,
        0u32,
        0u32,
        0u32
    );
}

export fn Compilerˉnativeˉx64ˉemptyˉrecordˉstorage(Input: bytes)
    -> Compilerˉnativeˉx64ˉrecordˉstorage {
    let Value: bytes = Empty(Input);
    return Compilerˉnativeˉx64ˉrecordˉstorage(
        true,
        Value,
        Value,
        0u32,
        0u32,
        0u32
    );
}

fn Zeros(Input: bytes, Count: u32) -> bytes {
    var Result: bytes = Empty(Input);
    var Index: u32 = 0u32;
    while Index < Count {
        Result = Bytesˉconcat(Result, Bytesˉfromˉu8(0u8));
        Index = Index + 1u32;
    }
    return Result;
}

fn U32ˉvalues(Input: bytes, Count: u32, Value: u32) -> bytes {
    var Result: bytes = Empty(Input);
    var Index: u32 = 0u32;
    while Index < Count {
        Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Value));
        Index = Index + 1u32;
    }
    return Result;
}

fn Setˉbyte(Input: bytes, Index: u32, Value: u8) -> bytes {
    return Bytesˉconcat(
        Bytesˉconcat(
            Bytesˉslice(Input, 0u32, Index),
            Bytesˉfromˉu8(Value)
        ),
        Bytesˉslice(Input, Index + 1u32, Bytesˉlength(Input) - Index - 1u32)
    );
}

fn Setˉu32(Input: bytes, Index: u32, Value: u32) -> bytes {
    let Offset: u32 = Index * 4u32;
    return Bytesˉconcat(
        Bytesˉconcat(
            Bytesˉslice(Input, 0u32, Offset),
            Bytesˉfromˉu32ˉlittle(Value)
        ),
        Bytesˉslice(Input, Offset + 4u32, Bytesˉlength(Input) - Offset - 4u32)
    );
}

fn Pushˉtype(Types: bytes, Type: u8) -> bytes {
    return Bytesˉconcat(Types, Bytesˉfromˉu8(Type));
}

fn Pushˉrecord(Records: bytes, Record: u32) -> bytes {
    return Bytesˉconcat(Records, Bytesˉfromˉu32ˉlittle(Record));
}

fn Popˉtypes(Types: bytes, Depth: u32) -> bytes {
    return Bytesˉslice(Types, 0u32, Depth);
}

fn Popˉrecords(Records: bytes, Depth: u32) -> bytes {
    return Bytesˉslice(Records, 0u32, Depth * 4u32);
}

fn Instructionˉsize(Opcode: u8) -> u32 {
    if Opcode == 1u8 { return 5u32; }
    if Opcode == 4u8 { return 5u32; }
    if Opcode == 5u8 { return 5u32; }
    if Opcode == 16u8 { return 1u32; }
    if Opcode == 81u8 { return 1u32; }
    if Opcode == 104u8 { return 5u32; }
    if Opcode == 105u8 { return 5u32; }
    return 0u32;
}

fn Interferenceˉset(
    Matrix: bytes,
    Count: u32,
    Left: u32,
    Right: u32
) -> bytes {
    var Result: bytes = Setˉbyte(Matrix, Left * Count + Right, 1u8);
    return Setˉbyte(Result, Right * Count + Left, 1u8);
}

fn Addˉliveˉinterference(
    Matrix: bytes,
    Live: bytes,
    Count: u32,
    Value: u32
) -> bytes {
    var Result: bytes = Matrix;
    var Other: u32 = 0u32;
    while Other < Count {
        if Other != Value {
            if Bytesˉreadˉu8(Live, Other) == 1u8 {
                Result = Interferenceˉset(Result, Count, Value, Other);
            }
        }
        Other = Other + 1u32;
    }
    return Result;
}

fn Addˉallˉliveˉinterference(
    Matrix: bytes,
    Live: bytes,
    Count: u32
) -> bytes {
    var Result: bytes = Matrix;
    var Left: u32 = 0u32;
    while Left < Count {
        if Bytesˉreadˉu8(Live, Left) == 1u8 {
            var Right: u32 = Left + 1u32;
            while Right < Count {
                if Bytesˉreadˉu8(Live, Right) == 1u8 {
                    Result = Interferenceˉset(Result, Count, Left, Right);
                }
                Right = Right + 1u32;
            }
        }
        Left = Left + 1u32;
    }
    return Result;
}

fn Recordˉwidth(
    Types: Nominalˉtypes.Compilerˉnativeˉx64ˉtypes,
    Type: u8
) -> u32 {
    return Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉitemˉcount(
        Types,
        Nominalˉtypes.Compilerˉnativeˉx64ˉrecordˉtypeˉindex(Type)
    );
}

fn Allocateˉoffsets(
    Input: bytes,
    Types: Nominalˉtypes.Compilerˉnativeˉx64ˉtypes,
    Present: bytes,
    Typeˉbyˉidentifier: bytes,
    Interference: bytes,
    Count: u32
) -> bytes {
    var Offsets: bytes = U32ˉvalues(Input, Count, 4294967295u32);
    var Width: u32 = 64u32;
    while Width > 0u32 {
        var Identifier: u32 = 0u32;
        while Identifier < Count {
            if Bytesˉreadˉu8(Present, Identifier) == 1u8 {
                let Type: u8 = Bytesˉreadˉu8(Typeˉbyˉidentifier, Identifier);
                if Recordˉwidth(Types, Type) == Width {
                    var Candidate: u32 = 0u32;
                    var Searching: bool = true;
                    while Searching {
                        Searching = false;
                        var Next: u32 = Candidate;
                        var Other: u32 = 0u32;
                        while Other < Count {
                            let Otherˉoffset: u32 = Bytesˉreadˉu32ˉlittle(
                                Offsets,
                                Other * 4u32
                            );
                            if Otherˉoffset != 4294967295u32 {
                                if Bytesˉreadˉu8(
                                    Interference,
                                    Identifier * Count + Other
                                ) == 1u8 {
                                    let Otherˉwidth: u32 = Recordˉwidth(
                                        Types,
                                        Bytesˉreadˉu8(Typeˉbyˉidentifier, Other)
                                    );
                                    if Candidate < Otherˉoffset + Otherˉwidth {
                                        if Otherˉoffset < Candidate + Width {
                                            Searching = true;
                                            if Otherˉoffset + Otherˉwidth > Next {
                                                Next = Otherˉoffset + Otherˉwidth;
                                            }
                                        }
                                    }
                                }
                            }
                            Other = Other + 1u32;
                        }
                        Candidate = Next;
                    }
                    Offsets = Setˉu32(Offsets, Identifier, Candidate);
                }
            }
            Identifier = Identifier + 1u32;
        }
        Width = Width - 1u32;
    }
    return Offsets;
}

fn Requiredˉfields(
    Types: Nominalˉtypes.Compilerˉnativeˉx64ˉtypes,
    Present: bytes,
    Typeˉbyˉidentifier: bytes,
    Offsets: bytes,
    Count: u32
) -> u32 {
    var Required: u32 = 0u32;
    var Identifier: u32 = 0u32;
    while Identifier < Count {
        if Bytesˉreadˉu8(Present, Identifier) == 1u8 {
            let End: u32 = Bytesˉreadˉu32ˉlittle(
                Offsets,
                Identifier * 4u32
            ) + Recordˉwidth(
                Types,
                Bytesˉreadˉu8(Typeˉbyˉidentifier, Identifier)
            );
            if End > Required { Required = End; }
        }
        Identifier = Identifier + 1u32;
    }
    return Required;
}

export fn Compilerˉnativeˉx64ˉrecordˉstorageˉread(
    Input: bytes,
    Codeˉoffset: u32,
    Codeˉlength: u32,
    Localˉtypes: bytes,
    Types: Nominalˉtypes.Compilerˉnativeˉx64ˉtypes
) -> Compilerˉnativeˉx64ˉrecordˉstorage {
    let Locals: u32 = Bytesˉlength(Localˉtypes);
    if Locals > 128u32 { return Invalid(Input); }
    var Initialized: bytes = Zeros(Input, Locals);
    var Stackˉtypes: bytes = Empty(Input);
    var Stackˉrecords: bytes = Empty(Input);
    var Depth: u32 = 0u32;
    var Instructionˉoffsets: bytes = Empty(Input);
    var Events: bytes = Empty(Input);
    var Recordˉtypes: bytes = Empty(Input);
    var Lastˉuses: bytes = Empty(Input);
    var Recordˉvalues: u32 = 0u32;
    var Instructions: u32 = 0u32;
    var Cursor: u32 = 0u32;
    while Cursor < Codeˉlength {
        let Opcode: u8 = Bytesˉreadˉu8(Input, Codeˉoffset + Cursor);
        let Size: u32 = Instructionˉsize(Opcode);
        if Size == 0u32 { return Invalid(Input); }
        if Size > Codeˉlength - Cursor { return Invalid(Input); }
        if Instructions >= 1024u32 { return Invalid(Input); }
        Instructionˉoffsets = Bytesˉconcat(
            Instructionˉoffsets,
            Bytesˉfromˉu32ˉlittle(Cursor)
        );
        var Resultˉrecord: u32 = 4294967295u32;
        var Usedˉrecord: u32 = 4294967295u32;
        if Opcode == 1u8 {
            Stackˉtypes = Pushˉtype(Stackˉtypes, 1u8);
            Stackˉrecords = Pushˉrecord(Stackˉrecords, 4294967295u32);
            Depth = Depth + 1u32;
        }
        if Opcode == 4u8 {
            let Loadˉlocal: u32 = Bytesˉreadˉu32ˉlittle(
                Input,
                Codeˉoffset + Cursor + 1u32
            );
            if Loadˉlocal >= Locals { return Invalid(Input); }
            let Loadˉtype: u8 = Bytesˉreadˉu8(Localˉtypes, Loadˉlocal);
            if Loadˉtype != 1u8 {
                if !Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉisˉrecord(Loadˉtype) {
                    return Invalid(Input);
                }
                if Bytesˉreadˉu8(Initialized, Loadˉlocal) != 1u8 {
                    return Invalid(Input);
                }
                if Recordˉvalues >= 128u32 { return Invalid(Input); }
                Resultˉrecord = Recordˉvalues;
                Recordˉvalues = Recordˉvalues + 1u32;
                Recordˉtypes = Bytesˉconcat(
                    Recordˉtypes,
                    Bytesˉfromˉu8(Loadˉtype)
                );
                Lastˉuses = Bytesˉconcat(
                    Lastˉuses,
                    Bytesˉfromˉu32ˉlittle(4294967295u32)
                );
            }
            Stackˉtypes = Pushˉtype(Stackˉtypes, Loadˉtype);
            Stackˉrecords = Pushˉrecord(Stackˉrecords, Resultˉrecord);
            Depth = Depth + 1u32;
        }
        if Opcode == 5u8 {
            if Depth == 0u32 { return Invalid(Input); }
            let Storeˉlocal: u32 = Bytesˉreadˉu32ˉlittle(
                Input,
                Codeˉoffset + Cursor + 1u32
            );
            if Storeˉlocal >= Locals { return Invalid(Input); }
            let Storeˉtype: u8 = Bytesˉreadˉu8(Localˉtypes, Storeˉlocal);
            if Bytesˉreadˉu8(Stackˉtypes, Depth - 1u32) != Storeˉtype {
                return Invalid(Input);
            }
            Usedˉrecord = Bytesˉreadˉu32ˉlittle(
                Stackˉrecords,
                (Depth - 1u32) * 4u32
            );
            if Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉisˉrecord(Storeˉtype) {
                Initialized = Setˉbyte(Initialized, Storeˉlocal, 1u8);
                Lastˉuses = Setˉu32(Lastˉuses, Usedˉrecord, Instructions);
            }
            Depth = Depth - 1u32;
            Stackˉtypes = Popˉtypes(Stackˉtypes, Depth);
            Stackˉrecords = Popˉrecords(Stackˉrecords, Depth);
        }
        if Opcode == 16u8 {
            if Depth < 2u32 { return Invalid(Input); }
            if Bytesˉreadˉu8(Stackˉtypes, Depth - 1u32) != 1u8 {
                return Invalid(Input);
            }
            if Bytesˉreadˉu8(Stackˉtypes, Depth - 2u32) != 1u8 {
                return Invalid(Input);
            }
            Depth = Depth - 2u32;
            Stackˉtypes = Popˉtypes(Stackˉtypes, Depth);
            Stackˉrecords = Popˉrecords(Stackˉrecords, Depth);
            Stackˉtypes = Pushˉtype(Stackˉtypes, 1u8);
            Stackˉrecords = Pushˉrecord(Stackˉrecords, 4294967295u32);
            Depth = Depth + 1u32;
        }
        if Opcode == 104u8 {
            let Createˉtypeˉindex: u32 = Bytesˉreadˉu32ˉlittle(
                Input,
                Codeˉoffset + Cursor + 1u32
            );
            if Createˉtypeˉindex >= Types.Count { return Invalid(Input); }
            if Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉkind(
                Types,
                Createˉtypeˉindex
            ) != 1u8 { return Invalid(Input); }
            let Createˉfields: u32 =
                Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉitemˉcount(
                    Types,
                    Createˉtypeˉindex
                );
            if Depth < Createˉfields { return Invalid(Input); }
            var Createˉfield: u32 = Createˉfields;
            while Createˉfield > 0u32 {
                Createˉfield = Createˉfield - 1u32;
                let Createˉexpected: u8 =
                    Nominalˉtypes.Compilerˉnativeˉx64ˉrecordˉfieldˉtype(
                        Input,
                        Types,
                        Createˉtypeˉindex,
                        Createˉfield
                    );
                if Bytesˉreadˉu8(
                    Stackˉtypes,
                    Depth - Createˉfields + Createˉfield
                ) != Createˉexpected { return Invalid(Input); }
            }
            Depth = Depth - Createˉfields;
            Stackˉtypes = Popˉtypes(Stackˉtypes, Depth);
            Stackˉrecords = Popˉrecords(Stackˉrecords, Depth);
            if Recordˉvalues >= 128u32 { return Invalid(Input); }
            let Createˉtype: u8 = Nominalˉtypes.Compilerˉnativeˉx64ˉrecordˉtype(
                Createˉtypeˉindex
            );
            Resultˉrecord = Recordˉvalues;
            Recordˉvalues = Recordˉvalues + 1u32;
            Recordˉtypes = Bytesˉconcat(
                Recordˉtypes,
                Bytesˉfromˉu8(Createˉtype)
            );
            Lastˉuses = Bytesˉconcat(
                Lastˉuses,
                Bytesˉfromˉu32ˉlittle(4294967295u32)
            );
            Stackˉtypes = Pushˉtype(Stackˉtypes, Createˉtype);
            Stackˉrecords = Pushˉrecord(Stackˉrecords, Resultˉrecord);
            Depth = Depth + 1u32;
        }
        if Opcode == 105u8 {
            if Depth == 0u32 { return Invalid(Input); }
            let Recordˉtype: u8 = Bytesˉreadˉu8(Stackˉtypes, Depth - 1u32);
            if !Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉisˉrecord(Recordˉtype) {
                return Invalid(Input);
            }
            Usedˉrecord = Bytesˉreadˉu32ˉlittle(
                Stackˉrecords,
                (Depth - 1u32) * 4u32
            );
            Lastˉuses = Setˉu32(Lastˉuses, Usedˉrecord, Instructions);
            let Fieldˉtypeˉindex: u32 =
                Nominalˉtypes.Compilerˉnativeˉx64ˉrecordˉtypeˉindex(
                    Recordˉtype
                );
            let Fieldˉindex: u32 = Bytesˉreadˉu32ˉlittle(
                Input,
                Codeˉoffset + Cursor + 1u32
            );
            if Fieldˉindex >= Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉitemˉcount(
                Types,
                Fieldˉtypeˉindex
            ) { return Invalid(Input); }
            let Fieldˉtype: u8 =
                Nominalˉtypes.Compilerˉnativeˉx64ˉrecordˉfieldˉtype(
                    Input,
                    Types,
                    Fieldˉtypeˉindex,
                    Fieldˉindex
                );
            Depth = Depth - 1u32;
            Stackˉtypes = Popˉtypes(Stackˉtypes, Depth);
            Stackˉrecords = Popˉrecords(Stackˉrecords, Depth);
            Stackˉtypes = Pushˉtype(Stackˉtypes, Fieldˉtype);
            Stackˉrecords = Pushˉrecord(Stackˉrecords, 4294967295u32);
            Depth = Depth + 1u32;
        }
        if Opcode == 81u8 {
            if Depth != 1u32 { return Invalid(Input); }
            if Bytesˉreadˉu8(Stackˉtypes, 0u32) != 1u8 {
                return Invalid(Input);
            }
            Depth = 0u32;
            Stackˉtypes = Empty(Input);
            Stackˉrecords = Empty(Input);
        }
        Events = Bytesˉconcat(
            Events,
            Bytesˉconcat(
                Bytesˉfromˉu32ˉlittle(Resultˉrecord),
                Bytesˉfromˉu32ˉlittle(Usedˉrecord)
            )
        );
        Cursor = Cursor + Size;
        Instructions = Instructions + 1u32;
    }
    if Cursor != Codeˉlength { return Invalid(Input); }
    if Depth != 0u32 { return Invalid(Input); }

    var Persistentˉpresent: bytes = Zeros(Input, Locals);
    var Persistentˉlive: bytes = Zeros(Input, Locals);
    var Persistentˉinterference: bytes = Zeros(Input, Locals * Locals);
    var Reverse: u32 = Instructions;
    while Reverse > 0u32 {
        Reverse = Reverse - 1u32;
        let Instructionˉcursor: u32 = Bytesˉreadˉu32ˉlittle(
            Instructionˉoffsets,
            Reverse * 4u32
        );
        let Reverseˉopcode: u8 = Bytesˉreadˉu8(
            Input,
            Codeˉoffset + Instructionˉcursor
        );
        if Reverseˉopcode == 5u8 {
            let Reverseˉstoreˉlocal: u32 = Bytesˉreadˉu32ˉlittle(
                Input,
                Codeˉoffset + Instructionˉcursor + 1u32
            );
            if Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉisˉrecord(
                Bytesˉreadˉu8(Localˉtypes, Reverseˉstoreˉlocal)
            ) {
                Persistentˉpresent = Setˉbyte(
                    Persistentˉpresent,
                    Reverseˉstoreˉlocal,
                    1u8
                );
                Persistentˉinterference = Addˉliveˉinterference(
                    Persistentˉinterference,
                    Persistentˉlive,
                    Locals,
                    Reverseˉstoreˉlocal
                );
                Persistentˉlive = Setˉbyte(
                    Persistentˉlive,
                    Reverseˉstoreˉlocal,
                    0u8
                );
            }
        }
        if Reverseˉopcode == 4u8 {
            let Reverseˉloadˉlocal: u32 = Bytesˉreadˉu32ˉlittle(
                Input,
                Codeˉoffset + Instructionˉcursor + 1u32
            );
            if Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉisˉrecord(
                Bytesˉreadˉu8(Localˉtypes, Reverseˉloadˉlocal)
            ) {
                Persistentˉpresent = Setˉbyte(
                    Persistentˉpresent,
                    Reverseˉloadˉlocal,
                    1u8
                );
                Persistentˉlive = Setˉbyte(
                    Persistentˉlive,
                    Reverseˉloadˉlocal,
                    1u8
                );
            }
        }
        Persistentˉinterference = Addˉallˉliveˉinterference(
            Persistentˉinterference,
            Persistentˉlive,
            Locals
        );
    }
    let Persistentˉoffsets: bytes = Allocateˉoffsets(
        Input,
        Types,
        Persistentˉpresent,
        Localˉtypes,
        Persistentˉinterference,
        Locals
    );
    let Persistentˉfields: u32 = Requiredˉfields(
        Types,
        Persistentˉpresent,
        Localˉtypes,
        Persistentˉoffsets,
        Locals
    );

    var Scratchˉpresent: bytes = Zeros(Input, Recordˉvalues);
    var Scratchˉlive: bytes = Zeros(Input, Recordˉvalues);
    var Scratchˉinterference: bytes = Zeros(
        Input,
        Recordˉvalues * Recordˉvalues
    );
    var Event: u32 = 0u32;
    while Event < Instructions {
        let Result: u32 = Bytesˉreadˉu32ˉlittle(Events, Event * 8u32);
        let Use: u32 = Bytesˉreadˉu32ˉlittle(Events, Event * 8u32 + 4u32);
        if Result != 4294967295u32 {
            Scratchˉpresent = Setˉbyte(Scratchˉpresent, Result, 1u8);
            Scratchˉinterference = Addˉliveˉinterference(
                Scratchˉinterference,
                Scratchˉlive,
                Recordˉvalues,
                Result
            );
            Scratchˉlive = Setˉbyte(Scratchˉlive, Result, 1u8);
        }
        if Use != 4294967295u32 {
            if Bytesˉreadˉu32ˉlittle(Lastˉuses, Use * 4u32) == Event {
                Scratchˉlive = Setˉbyte(Scratchˉlive, Use, 0u8);
            }
        }
        if Result != 4294967295u32 {
            if Bytesˉreadˉu32ˉlittle(
                Lastˉuses,
                Result * 4u32
            ) == 4294967295u32 {
                Scratchˉlive = Setˉbyte(Scratchˉlive, Result, 0u8);
            }
        }
        Event = Event + 1u32;
    }
    let Scratchˉoffsets: bytes = Allocateˉoffsets(
        Input,
        Types,
        Scratchˉpresent,
        Recordˉtypes,
        Scratchˉinterference,
        Recordˉvalues
    );
    let Scratchˉfields: u32 = Requiredˉfields(
        Types,
        Scratchˉpresent,
        Recordˉtypes,
        Scratchˉoffsets,
        Recordˉvalues
    );
    return Compilerˉnativeˉx64ˉrecordˉstorage(
        true,
        Persistentˉoffsets,
        Scratchˉoffsets,
        Persistentˉfields,
        Scratchˉfields,
        Recordˉvalues
    );
}
