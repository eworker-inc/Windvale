module Compilerˉnativeˉx64ˉloweringˉrecordˉstorage profile portable;

import Compilerˉnativeˉx64ˉloweringˉtypes as Nominalˉtypes;
import Compilerˉnativeˉx64ˉloweringˉlayout as Layout;
import Compilerˉnativeˉx64ˉloweringˉcapabilities as Nativeˉcapabilities;
import Compilerˉnativeˉx64ˉloweringˉrecordˉallocation as Allocation;
import Compilerˉnativeˉx64ˉloweringˉrecordˉlocalˉliveness as Localˉliveness;
import Compilerˉnativeˉx64ˉloweringˉvariantˉstorage as Variantˉstorage;

export record Compilerˉnativeˉx64ˉrecordˉstorage {
    Valid: bool;
    Persistentˉoffsets: bytes;
    Scratchˉoffsets: bytes;
    Scratchˉblockˉoffsets: bytes;
    Persistentˉfields: u32;
    Scratchˉfields: u32;
    Recordˉvalues: u32;
}

record Scratchˉblockˉallocation {
    Valid: bool;
    Offsets: bytes;
    Fields: u32;
    Nextˉevent: u32;
    Nextˉeventˉoffset: u32;
}

fn Empty(Input: bytes) -> bytes {
    return Bytesˉslice(Input, 0u32, 0u32);
}

fn Invalidˉstorage(Input: bytes) -> Compilerˉnativeˉx64ˉrecordˉstorage {
    let Value: bytes = Empty(Input);
    return Compilerˉnativeˉx64ˉrecordˉstorage(
        false,
        Value,
        Value,
        Value,
        0u32,
        0u32,
        0u32
    );
}

fn Invalid(Input: bytes) -> bytes {
    return Empty(Input);
}

export fn Compilerˉnativeˉx64ˉemptyˉrecordˉstorage(Input: bytes)
    -> Compilerˉnativeˉx64ˉrecordˉstorage {
    let Value: bytes = Empty(Input);
    return Compilerˉnativeˉx64ˉrecordˉstorage(
        true,
        Value,
        Value,
        Value,
        0u32,
        0u32,
        0u32
    );
}

export fn Compilerˉnativeˉx64ˉrecordˉstorageˉdecode(Input: bytes)
    -> Compilerˉnativeˉx64ˉrecordˉstorage {
    if Bytesˉlength(Input) < 32u32 { return Invalidˉstorage(Input); }
    if Bytesˉreadˉu32ˉlittle(Input, 0u32) != 1381193303u32 {
        return Invalidˉstorage(Input);
    }
    if Bytesˉreadˉu32ˉlittle(Input, 4u32) != 2u32 {
        return Invalidˉstorage(Input);
    }
    let Persistentˉfields: u32 = Bytesˉreadˉu32ˉlittle(Input, 8u32);
    let Scratchˉfields: u32 = Bytesˉreadˉu32ˉlittle(Input, 12u32);
    let Recordˉvalues: u32 = Bytesˉreadˉu32ˉlittle(Input, 16u32);
    let Persistentˉbytes: u32 = Bytesˉreadˉu32ˉlittle(Input, 20u32);
    let Scratchˉbytes: u32 = Bytesˉreadˉu32ˉlittle(Input, 24u32);
    let Scratchˉblockˉbytes: u32 =
        Bytesˉreadˉu32ˉlittle(Input, 28u32);
    let Payloadˉbytes: u32 = Bytesˉlength(Input) - 32u32;
    if Persistentˉfields > 2048u32 || Scratchˉfields > 2048u32 ||
        Recordˉvalues > 256u32 || Persistentˉbytes > 8192u32 ||
        Scratchˉbytes > 32768u32 || Scratchˉblockˉbytes > 32768u32 ||
        Persistentˉbytes % 4u32 != 0u32 ||
        Scratchˉbytes % 4u32 != 0u32 ||
        Scratchˉblockˉbytes % 4u32 != 0u32 ||
        Persistentˉbytes > Payloadˉbytes ||
        Scratchˉbytes > Payloadˉbytes - Persistentˉbytes ||
        Scratchˉblockˉbytes != Payloadˉbytes - Persistentˉbytes -
            Scratchˉbytes {
        return Invalidˉstorage(Input);
    }
    return Compilerˉnativeˉx64ˉrecordˉstorage(
        true,
        Bytesˉslice(Input, 32u32, Persistentˉbytes),
        Bytesˉslice(Input, 32u32 + Persistentˉbytes, Scratchˉbytes),
        Bytesˉslice(
            Input,
            32u32 + Persistentˉbytes + Scratchˉbytes,
            Scratchˉblockˉbytes
        ),
        Persistentˉfields,
        Scratchˉfields,
        Recordˉvalues
    );
}

fn Repeatˉbytes(Input: bytes, Count: u32, Value: bytes) -> bytes {
    var Result: bytes = Empty(Input);
    var Chunk: bytes = Value;
    var Remaining: u32 = Count;
    while Remaining > 0u32 {
        if Remaining % 2u32 == 1u32 {
            Result = Bytesˉconcat(Result, Chunk);
        }
        Remaining = Remaining / 2u32;
        if Remaining > 0u32 {
            Chunk = Bytesˉconcat(Chunk, Chunk);
        }
    }
    return Result;
}

fn Zeros(Input: bytes, Count: u32) -> bytes {
    return Repeatˉbytes(Input, Count, Bytesˉfromˉu8(0u8));
}

fn U32ˉvalues(Input: bytes, Count: u32, Value: u32) -> bytes {
    return Repeatˉbytes(
        Input,
        Count,
        Bytesˉfromˉu32ˉlittle(Value)
    );
}

fn Setˉbyte(Input: bytes, Index: u32, Value: u8) -> bytes {
    return Bytesˉconcat(
        Bytesˉconcat(
            Bytesˉslice(Input, 0u32, Index),
            Bytesˉfromˉu8(Value)
        ),
        Bytesˉslice(Input, Index + 1u32, Bytesˉlength(Input) - Index - 1u32)
    );
}

fn Pushˉrecord(Records: bytes, Record: u32) -> bytes {
    return Bytesˉconcat(Records, Bytesˉfromˉu32ˉlittle(Record));
}

fn Popˉrecords(Records: bytes, Depth: u32) -> bytes {
    return Bytesˉslice(Records, 0u32, Depth * 4u32);
}

fn Instructionˉsize(Opcode: u8) -> u32 {
    if Opcode == 1u8 { return 5u32; }
    if Opcode == 2u8 { return 2u32; }
    if Opcode == 3u8 { return 5u32; }
    if Opcode == 4u8 { return 5u32; }
    if Opcode == 205u8 { return 5u32; }
    if Opcode == 5u8 { return 5u32; }
    if Opcode == 6u8 { return 5u32; }
    if Opcode == 7u8 { return 5u32; }
    if Opcode == 8u8 { return 2u32; }
    if Opcode == 9u8 { return 5u32; }
    if Opcode == 10u8 { return 5u32; }
    let Numeric: u32 = U32ˉfromˉu8(Opcode);
    if Numeric >= 11u32 {
        if Numeric <= 22u32 { return 1u32; }
    }
    if Numeric >= 32u32 {
        if Numeric <= 40u32 { return 1u32; }
    }
    if Opcode == 48u8 || Opcode == 49u8 || Opcode == 64u8 || Opcode == 65u8 {
        return 5u32;
    }
    if Opcode == 81u8 { return 1u32; }
    if Numeric >= 96u32 {
        if Numeric <= 103u32 { return 1u32; }
    }
    if Opcode == 104u8 { return 5u32; }
    if Opcode == 105u8 { return 5u32; }
    if Opcode == 106u8 { return 9u32; }
    if Opcode == 129u8 { return 9u32; }
    if Numeric >= 107u32 {
        if Numeric <= 125u32 { return 1u32; }
    }
    if Numeric >= 134u32 && Numeric <= 136u32 { return 1u32; }
    if Numeric >= 143u32 && Numeric <= 148u32 { return 1u32; }
    if Numeric >= 151u32 && Numeric <= 153u32 { return 9u32; }
    if Opcode == 196u8 { return 9u32; }
    if Opcode == 161u8 || Opcode == 162u8 ||
        Opcode == 165u8 || Opcode == 166u8 { return 1u32; }
    if Numeric >= 173u32 {
        if Numeric <= 178u32 { return 1u32; }
    }
    if Numeric >= 179u32 {
        if Numeric <= 184u32 { return 1u32; }
    }
    if Opcode == 189u8 || Opcode == 190u8 || Opcode == 191u8 { return 1u32; }
    if Opcode == 220u8 { return 13u32; }
    return 0u32;
}

fn Recordˉwidth(
    Input: bytes,
    Types: Nominalˉtypes.Compilerˉnativeˉx64ˉtypes,
    Type: u8
) -> u32 {
    return Nominalˉtypes.Compilerˉnativeˉx64ˉrecordˉwidth(
        Input,
        Types,
        Nominalˉtypes.Compilerˉnativeˉx64ˉrecordˉtypeˉindex(Type)
    );
}

fn Rememberˉrecordˉtype(
    Input: bytes,
    Recordˉtypes: bytes,
    Types: Nominalˉtypes.Compilerˉnativeˉx64ˉtypes,
    Identifier: u32,
    Type: u8
) -> bytes {
    if Identifier == Bytesˉlength(Recordˉtypes) {
        return Bytesˉconcat(Recordˉtypes, Bytesˉfromˉu8(Type));
    }
    let Existing: u8 = Bytesˉreadˉu8(Recordˉtypes, Identifier);
    if Recordˉwidth(Input, Types, Type) >
        Recordˉwidth(Input, Types, Existing) {
        return Setˉbyte(Recordˉtypes, Identifier, Type);
    }
    return Recordˉtypes;
}

fn Pushˉscalar(Records: bytes) -> bytes {
    return Pushˉrecord(Records, 4294967295u32);
}

fn Blockˉforˉleader(Directory: bytes, Offset: u32) -> u32 {
    if Bytesˉlength(Directory) % 8u32 != 0u32 { return 4294967295u32; }
    var Cursor: u32 = 0u32;
    while Cursor < Bytesˉlength(Directory) {
        let Candidate: u32 = Bytesˉreadˉu32ˉlittle(Directory, Cursor);
        if Candidate == Offset {
            return Bytesˉreadˉu32ˉlittle(Directory, Cursor + 4u32);
        }
        if Candidate > Offset { return 4294967295u32; }
        Cursor = Cursor + 8u32;
    }
    return 4294967295u32;
}

fn Eventsˉhaveˉlaterˉuse(
    Events: bytes,
    Start: u32,
    Block: u32,
    Record: u32
) -> bool {
    var Cursor: u32 = Start;
    while Cursor < Bytesˉlength(Events) {
        let Eventˉblock: u32 = Bytesˉreadˉu32ˉlittle(Events, Cursor);
        if Eventˉblock != Block { return false; }
        let Useˉcount: u32 = Bytesˉreadˉu32ˉlittle(Events, Cursor + 8u32);
        let Useˉoffset: u32 = Cursor + 12u32;
        var Use: u32 = 0u32;
        while Use < Useˉcount {
            if Bytesˉreadˉu32ˉlittle(
                Events,
                Useˉoffset + Use * 4u32
            ) == Record { return true; }
            Use = Use + 1u32;
        }
        Cursor = Useˉoffset + Useˉcount * 4u32;
    }
    return false;
}

fn Cellˉeventˉexists(
    Events: bytes,
    Kind: u8,
    Cell: u32
) -> bool {
    if Bytesˉlength(Events) % 5u32 != 0u32 { return false; }
    var Cursor: u32 = 0u32;
    while Cursor < Bytesˉlength(Events) {
        if Bytesˉreadˉu8(Events, Cursor) == Kind &&
            Bytesˉreadˉu32ˉlittle(Events, Cursor + 1u32) == Cell {
            return true;
        }
        Cursor = Cursor + 5u32;
    }
    return false;
}

fn Cellˉeventˉmapˉleaf(
    Input: bytes,
    Events: bytes,
    Kind: u8,
    Start: u32,
    Cells: u32
) -> bytes {
    var Result: bytes = Empty(Input);
    var Cell: u32 = 0u32;
    while Cell < Cells {
        var Value: u8 = 0u8;
        if Cellˉeventˉexists(Events, Kind, Start + Cell) { Value = 1u8; }
        Result = Bytesˉconcat(Result, Bytesˉfromˉu8(Value));
        Cell = Cell + 1u32;
    }
    return Result;
}

fn Cellˉeventˉmapˉrange(
    Input: bytes,
    Events: bytes,
    Kind: u8,
    Start: u32,
    Cells: u32
) -> bytes {
    if Cells <= 64u32 {
        return Cellˉeventˉmapˉleaf(Input, Events, Kind, Start, Cells);
    }
    let Leftˉcells: u32 = Cells / 2u32;
    let Boundary: u32 = Start + Leftˉcells;
    let End: u32 = Start + Cells;
    var Leftˉevents: bytes = Empty(Input);
    var Rightˉevents: bytes = Empty(Input);
    var Cursor: u32 = 0u32;
    while Cursor < Bytesˉlength(Events) {
        let Cell: u32 = Bytesˉreadˉu32ˉlittle(Events, Cursor + 1u32);
        if Cell >= Start && Cell < Boundary {
            Leftˉevents = Bytesˉconcat(
                Leftˉevents,
                Bytesˉslice(Events, Cursor, 5u32)
            );
        } else if Cell >= Boundary && Cell < End {
            Rightˉevents = Bytesˉconcat(
                Rightˉevents,
                Bytesˉslice(Events, Cursor, 5u32)
            );
        }
        Cursor = Cursor + 5u32;
    }
    var Left: bytes = Zeros(Input, Leftˉcells);
    if Bytesˉlength(Leftˉevents) > 0u32 {
        Left = Cellˉeventˉmapˉrange(
            Input,
            Leftˉevents,
            Kind,
            Start,
            Leftˉcells
        );
    }
    let Rightˉcells: u32 = Cells - Leftˉcells;
    var Right: bytes = Zeros(Input, Rightˉcells);
    if Bytesˉlength(Rightˉevents) > 0u32 {
        Right = Cellˉeventˉmapˉrange(
            Input,
            Rightˉevents,
            Kind,
            Boundary,
            Rightˉcells
        );
    }
    if Bytesˉlength(Left) != Leftˉcells ||
        Bytesˉlength(Right) != Rightˉcells {
        return Empty(Input);
    }
    return Bytesˉconcat(Left, Right);
}

fn Cellˉeventˉmap(
    Input: bytes,
    Events: bytes,
    Kind: u8,
    Cells: u32
) -> bytes {
    if Bytesˉlength(Events) % 5u32 != 0u32 { return Empty(Input); }
    var Relevant: bytes = Empty(Input);
    var Cursor: u32 = 0u32;
    while Cursor < Bytesˉlength(Events) {
        if Bytesˉreadˉu8(Events, Cursor) == Kind {
            Relevant = Bytesˉconcat(
                Relevant,
                Bytesˉslice(Events, Cursor, 5u32)
            );
        }
        Cursor = Cursor + 5u32;
    }
    if Bytesˉlength(Relevant) == 0u32 { return Zeros(Input, Cells); }
    return Cellˉeventˉmapˉrange(Input, Relevant, Kind, 0u32, Cells);
}

fn Invalidˉscratchˉallocation(Input: bytes)
    -> Allocation.Compilerˉnativeˉx64ˉrecordˉallocation {
    return Allocation.Compilerˉnativeˉx64ˉrecordˉallocation(
        Empty(Input),
        4294967295u32
    );
}

fn Invalidˉscratchˉblock(Input: bytes) -> Scratchˉblockˉallocation {
    return Scratchˉblockˉallocation(
        false,
        Empty(Input),
        0u32,
        0u32,
        0u32
    );
}

fn Buildˉscratchˉblock(
    Input: bytes,
    Types: Nominalˉtypes.Compilerˉnativeˉx64ˉtypes,
    Block: u32,
    Base: u32,
    Limit: u32,
    Events: bytes,
    Recordˉtypes: bytes,
    Instructions: u32,
    Firstˉevent: u32,
    Firstˉeventˉoffset: u32
) -> Scratchˉblockˉallocation {
    let Count: u32 = Limit - Base;
    var Present: bytes = Zeros(Input, Count);
    var Live: bytes = Zeros(Input, Count);
    var Interference: bytes = Zeros(
        Input,
        Allocation.Compilerˉnativeˉx64ˉrecordˉinterferenceˉbytes(Count)
    );
    var Event: u32 = Firstˉevent;
    var Eventˉoffset: u32 = Firstˉeventˉoffset;
    var Reading: bool = true;
    while Reading {
        if Event >= Instructions {
            Reading = false;
        } else {
            if Eventˉoffset + 12u32 > Bytesˉlength(Events) {
                return Invalidˉscratchˉblock(Input);
            }
            let Eventˉblock: u32 = Bytesˉreadˉu32ˉlittle(
                Events,
                Eventˉoffset
            );
            if Eventˉblock != Block {
                if Eventˉblock < Block {
                    return Invalidˉscratchˉblock(Input);
                }
                Reading = false;
            } else {
            let Resultˉidentifier: u32 = Bytesˉreadˉu32ˉlittle(
                Events,
                Eventˉoffset + 4u32
            );
            var Result: u32 = 4294967295u32;
            if Resultˉidentifier != 4294967295u32 {
                if Resultˉidentifier < Base || Resultˉidentifier >= Limit {
                    return Invalidˉscratchˉblock(Input);
                }
                Result = Resultˉidentifier - Base;
            }
            let Useˉcount: u32 = Bytesˉreadˉu32ˉlittle(
                Events,
                Eventˉoffset + 8u32
            );
            let Useˉoffset: u32 = Eventˉoffset + 12u32;
            if Useˉcount > 128u32 ||
                Useˉcount * 4u32 > Bytesˉlength(Events) - Useˉoffset {
                return Invalidˉscratchˉblock(Input);
            }
            if Result != 4294967295u32 {
                Present = Setˉbyte(Present, Result, 1u8);
                Interference =
                    Allocation.Compilerˉnativeˉx64ˉaddˉliveˉrecordˉinterference(
                        Interference,
                        Live,
                        Count,
                        Result
                    );
                Live = Setˉbyte(Live, Result, 1u8);
            }
            var Useˉindex: u32 = 0u32;
            while Useˉindex < Useˉcount {
                let Checkedˉuse: u32 = Bytesˉreadˉu32ˉlittle(
                    Events,
                    Useˉoffset + Useˉindex * 4u32
                );
                if Checkedˉuse < Base || Checkedˉuse >= Limit ||
                    Bytesˉreadˉu8(Live, Checkedˉuse - Base) != 1u8 {
                    return Invalidˉscratchˉblock(Input);
                }
                Useˉindex = Useˉindex + 1u32;
            }
            Useˉindex = 0u32;
            while Useˉindex < Useˉcount {
                let Lastˉuse: u32 = Bytesˉreadˉu32ˉlittle(
                    Events,
                    Useˉoffset + Useˉindex * 4u32
                );
                if !Eventsˉhaveˉlaterˉuse(
                    Events,
                    Useˉoffset + Useˉcount * 4u32,
                    Block,
                    Lastˉuse
                ) {
                    Live = Setˉbyte(Live, Lastˉuse - Base, 0u8);
                }
                Useˉindex = Useˉindex + 1u32;
            }
            if Result != 4294967295u32 && !Eventsˉhaveˉlaterˉuse(
                Events,
                Useˉoffset + Useˉcount * 4u32,
                Block,
                Resultˉidentifier
            ) {
                Live = Setˉbyte(Live, Result, 0u8);
            }
            Eventˉoffset = Useˉoffset + Useˉcount * 4u32;
            Event = Event + 1u32;
            }
        }
    }
    var Remainingˉlive: u32 = 0u32;
    while Remainingˉlive < Count {
        if Bytesˉreadˉu8(Live, Remainingˉlive) == 1u8 {
            return Invalidˉscratchˉblock(Input);
        }
        Remainingˉlive = Remainingˉlive + 1u32;
    }
    let Allocationˉresult:
        Allocation.Compilerˉnativeˉx64ˉrecordˉallocation =
        Allocation.Compilerˉnativeˉx64ˉallocateˉrecordˉoffsets(
            Input,
            Types,
            Present,
            Bytesˉslice(Recordˉtypes, Base, Count),
            Interference,
            Count
        );
    return Scratchˉblockˉallocation(
        true,
        Allocationˉresult.Offsets,
        Allocationˉresult.Fields,
        Event,
        Eventˉoffset
    );
}

fn Buildˉscratchˉstorage(
    Input: bytes,
    Types: Nominalˉtypes.Compilerˉnativeˉx64ˉtypes,
    Blocks: u32,
    Events: bytes,
    Recordˉtypes: bytes,
    Scratchˉvalues: u32,
    Scratchˉblockˉoffsets: bytes,
    Instructions: u32
) -> Allocation.Compilerˉnativeˉx64ˉrecordˉallocation {
    if Bytesˉlength(Scratchˉblockˉoffsets) != Blocks * 4u32 ||
        Bytesˉlength(Recordˉtypes) != Scratchˉvalues {
        return Invalidˉscratchˉallocation(Input);
    }
    var Offsets: bytes = Empty(Input);
    var Fields: u32 = 0u32;
    var Event: u32 = 0u32;
    var Eventˉoffset: u32 = 0u32;
    var Block: u32 = 0u32;
    while Block < Blocks {
        let Base: u32 = Bytesˉreadˉu32ˉlittle(
            Scratchˉblockˉoffsets,
            Block * 4u32
        );
        var Limit: u32 = Scratchˉvalues;
        if Block + 1u32 < Blocks {
            Limit = Bytesˉreadˉu32ˉlittle(
                Scratchˉblockˉoffsets,
                (Block + 1u32) * 4u32
            );
        }
        if Base > Limit || Limit > Scratchˉvalues || Limit - Base > 256u32 {
            return Invalidˉscratchˉallocation(Input);
        }
        let Blockˉallocation: Scratchˉblockˉallocation =
            Buildˉscratchˉblock(
                Input,
                Types,
                Block,
                Base,
                Limit,
                Events,
                Recordˉtypes,
                Instructions,
                Event,
                Eventˉoffset
            );
        if !Blockˉallocation.Valid {
            return Invalidˉscratchˉallocation(Input);
        }
        Offsets = Bytesˉconcat(Offsets, Blockˉallocation.Offsets);
        if Blockˉallocation.Fields > Fields {
            Fields = Blockˉallocation.Fields;
        }
        Event = Blockˉallocation.Nextˉevent;
        Eventˉoffset = Blockˉallocation.Nextˉeventˉoffset;
        Block = Block + 1u32;
    }
    if Event != Instructions || Eventˉoffset != Bytesˉlength(Events) ||
        Bytesˉlength(Offsets) != Scratchˉvalues * 4u32 {
        return Invalidˉscratchˉallocation(Input);
    }
    return Allocation.Compilerˉnativeˉx64ˉrecordˉallocation(
        Offsets,
        Fields
    );
}

fn Buildˉstorage(
    Input: bytes,
    Codeˉoffset: u32,
    Recordˉlocals: Localˉliveness.Compilerˉnativeˉx64ˉrecordˉlocalˉdirectory,
    Types: Nominalˉtypes.Compilerˉnativeˉx64ˉtypes,
    Blocks: u32,
    Instructionˉoffsets: bytes,
    Blockˉstarts: bytes,
    Blockˉends: bytes,
    Successorˉfirst: bytes,
    Successorˉsecond: bytes,
    Cellˉevents: bytes,
    Events: bytes,
    Recordˉtypes: bytes,
    Recordˉvalues: u32,
    Scratchˉvalues: u32,
    Scratchˉblockˉoffsets: bytes,
    Instructions: u32
) -> bytes {
    let Livenessˉcells: u32 = Blocks * Recordˉlocals.Count;
    let Uses: bytes = Cellˉeventˉmap(
        Input,
        Cellˉevents,
        1u8,
        Livenessˉcells
    );
    let Definitions: bytes = Cellˉeventˉmap(
        Input,
        Cellˉevents,
        2u8,
        Livenessˉcells
    );
    let Persistent:
        Allocation.Compilerˉnativeˉx64ˉrecordˉallocation =
        Localˉliveness.Compilerˉnativeˉx64ˉplanˉrecordˉlocalˉstorage(
            Input,
            Codeˉoffset,
            Recordˉlocals,
            Types,
            Blocks,
            Instructionˉoffsets,
            Blockˉstarts,
            Blockˉends,
            Successorˉfirst,
            Successorˉsecond,
            Uses,
            Definitions
        );

    let Scratch:
        Allocation.Compilerˉnativeˉx64ˉrecordˉallocation =
        Buildˉscratchˉstorage(
            Input,
            Types,
            Blocks,
            Events,
            Recordˉtypes,
            Scratchˉvalues,
            Scratchˉblockˉoffsets,
            Instructions
        );
    if Scratch.Fields == 4294967295u32 { return Invalid(Input); }
    let Header: bytes = Bytesˉconcat(
        Bytesˉconcat(
            Bytesˉfromˉu32ˉlittle(1381193303u32),
            Bytesˉfromˉu32ˉlittle(2u32)
        ),
        Bytesˉconcat(
            Bytesˉfromˉu32ˉlittle(Persistent.Fields),
            Bytesˉconcat(
                Bytesˉfromˉu32ˉlittle(Scratch.Fields),
                Bytesˉconcat(
                    Bytesˉfromˉu32ˉlittle(Recordˉvalues),
                    Bytesˉconcat(
                        Bytesˉfromˉu32ˉlittle(Bytesˉlength(Persistent.Offsets)),
                        Bytesˉconcat(
                            Bytesˉfromˉu32ˉlittle(Bytesˉlength(Scratch.Offsets)),
                            Bytesˉfromˉu32ˉlittle(
                                Bytesˉlength(Scratchˉblockˉoffsets)
                            )
                        )
                    )
                )
            )
        )
    );
    return Bytesˉconcat(
        Bytesˉconcat(
            Bytesˉconcat(Header, Persistent.Offsets),
            Scratch.Offsets
        ),
        Scratchˉblockˉoffsets
    );
}

export fn Compilerˉnativeˉx64ˉrecordˉstorageˉread(
    Input: bytes,
    Codeˉoffset: u32,
    Codeˉlength: u32,
    Parameters: u32,
    Returnˉtype: u8,
    Localˉtypes: bytes,
    Callˉdirectory: bytes,
    Capabilityˉkinds: bytes,
    Types: Nominalˉtypes.Compilerˉnativeˉx64ˉtypes,
    Blocks: u32,
    Leaders: bytes
) -> bytes {
    let Locals: u32 = Bytesˉlength(Localˉtypes);
    if Locals >= 2048u32 || Blocks == 0u32 || Blocks > 1024u32 {
        return Invalid(Input);
    }
    let Recordˉlocals:
        Localˉliveness.Compilerˉnativeˉx64ˉrecordˉlocalˉdirectory =
        Localˉliveness.Compilerˉnativeˉx64ˉrecordˉlocalˉdirectoryˉread(
            Input,
            Parameters,
            Localˉtypes
        );
    if Recordˉlocals.Count > 1024u32 { return Invalid(Input); }
    if Codeˉlength == 0u32 || Bytesˉlength(Leaders) < Codeˉlength {
        return Invalid(Input);
    }
    if Bytesˉreadˉu8(Leaders, 0u32) != 1u8 { return Invalid(Input); }

    var Blockˉdirectory: bytes = Empty(Input);
    var Countedˉblocks: u32 = 0u32;
    var Offset: u32 = 0u32;
    while Offset < Codeˉlength {
        if Bytesˉreadˉu8(Leaders, Offset) == 1u8 {
            if Countedˉblocks >= Blocks { return Invalid(Input); }
            Blockˉdirectory = Bytesˉconcat(
                Blockˉdirectory,
                Bytesˉconcat(
                    Bytesˉfromˉu32ˉlittle(Offset),
                    Bytesˉfromˉu32ˉlittle(Countedˉblocks)
                )
            );
            Countedˉblocks = Countedˉblocks + 1u32;
        }
        Offset = Offset + 1u32;
    }
    if Countedˉblocks != Blocks ||
        Bytesˉlength(Blockˉdirectory) != Blocks * 8u32 {
        return Invalid(Input);
    }

    var Instructionˉoffsets: bytes = Empty(Input);
    var Blockˉstarts: bytes = Empty(Input);
    var Blockˉends: bytes = Empty(Input);
    var Successorˉfirst: bytes = Empty(Input);
    var Successorˉsecond: bytes = Empty(Input);
    var Cellˉevents: bytes = Empty(Input);
    var Stackˉrecords: bytes = Empty(Input);
    var Depth: u32 = 0u32;
    var Events: bytes = Empty(Input);
    var Recordˉtypes: bytes = Empty(Input);
    var Recordˉvalues: u32 = 0u32;
    var Scratchˉvalues: u32 = 0u32;
    var Scratchˉblockˉoffsets: bytes = Empty(Input);
    var Blockˉrecordˉvalues: u32 = 0u32;
    var Currentˉblock: u32 = 4294967295u32;
    var Instructions: u32 = 0u32;
    var Cursor: u32 = 0u32;
    while Cursor < Codeˉlength {
        if Bytesˉreadˉu8(Leaders, Cursor) == 1u8 {
            if Currentˉblock != 4294967295u32 {
                if Depth != 0u32 { return Invalid(Input); }
                if Bytesˉlength(Blockˉends) / 4u32 == Currentˉblock {
                    Blockˉends = Bytesˉconcat(
                        Blockˉends,
                        Bytesˉfromˉu32ˉlittle(Instructions)
                    );
                    Successorˉfirst = Bytesˉconcat(
                        Successorˉfirst,
                        Bytesˉfromˉu32ˉlittle(Currentˉblock + 1u32)
                    );
                    Successorˉsecond = Bytesˉconcat(
                        Successorˉsecond,
                        Bytesˉfromˉu32ˉlittle(4294967295u32)
                    );
                }
                Currentˉblock = Currentˉblock + 1u32;
            } else {
                Currentˉblock = 0u32;
            }
            if Currentˉblock >= Blocks { return Invalid(Input); }
            Blockˉstarts = Bytesˉconcat(
                Blockˉstarts,
                Bytesˉfromˉu32ˉlittle(Instructions)
            );
            Stackˉrecords = Empty(Input);
            Depth = 0u32;
            Blockˉrecordˉvalues = 0u32;
            Scratchˉblockˉoffsets = Bytesˉconcat(
                Scratchˉblockˉoffsets,
                Bytesˉfromˉu32ˉlittle(Scratchˉvalues)
            );
        }
        if Currentˉblock == 4294967295u32 { return Invalid(Input); }

        let Opcode: u8 = Bytesˉreadˉu8(Input, Codeˉoffset + Cursor);
        let Numericˉopcode: u32 = U32ˉfromˉu8(Opcode);
        let Size: u32 = Instructionˉsize(Opcode);
        if Size == 0u32 || Size > Codeˉlength - Cursor {
            return Invalid(Input);
        }
        if Instructions >= 8192u32 { return Invalid(Input); }
        Instructionˉoffsets = Bytesˉconcat(
            Instructionˉoffsets,
            Bytesˉfromˉu32ˉlittle(Cursor)
        );
        var Resultˉrecord: u32 = 4294967295u32;
        var Usedˉrecord: u32 = 4294967295u32;
        var Usedˉrecords: bytes = Empty(Input);
        var Handled: bool = false;

        if Opcode == 1u8 || Opcode == 2u8 || Opcode == 3u8 ||
            Opcode == 6u8 || Opcode == 8u8 || Opcode == 9u8 ||
            Opcode == 10u8 || Opcode == 106u8 || Opcode == 129u8 {
            Stackˉrecords = Pushˉscalar(Stackˉrecords);
            Depth = Depth + 1u32;
            Handled = true;
        }

        if Opcode == 4u8 || Opcode == 205u8 {
            let Loadˉlocal: u32 = Bytesˉreadˉu32ˉlittle(
                Input,
                Codeˉoffset + Cursor + 1u32
            );
            if Loadˉlocal >= Locals { return Invalid(Input); }
            let Loadˉtype: u8 = Bytesˉreadˉu8(Localˉtypes, Loadˉlocal);
            if Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉisˉrecord(Loadˉtype) {
                if Blockˉrecordˉvalues >= 256u32 { return Invalid(Input); }
                Resultˉrecord = Scratchˉvalues;
                Scratchˉvalues = Scratchˉvalues + 1u32;
                Blockˉrecordˉvalues = Blockˉrecordˉvalues + 1u32;
                if Blockˉrecordˉvalues > Recordˉvalues {
                    Recordˉvalues = Blockˉrecordˉvalues;
                }
                Recordˉtypes = Rememberˉrecordˉtype(
                    Input,
                    Recordˉtypes,
                    Types,
                    Resultˉrecord,
                    Loadˉtype
                );
                if Loadˉlocal >= Parameters {
                    let Recordˉlocal: u32 = Bytesˉreadˉu32ˉlittle(
                        Recordˉlocals.Indices,
                        Loadˉlocal * 4u32
                    );
                    if Recordˉlocal == 4294967295u32 {
                        return Invalid(Input);
                    }
                    let Cell: u32 =
                        Currentˉblock * Recordˉlocals.Count + Recordˉlocal;
                    if !Cellˉeventˉexists(Cellˉevents, 2u8, Cell) &&
                        !Cellˉeventˉexists(Cellˉevents, 1u8, Cell) {
                        Cellˉevents = Bytesˉconcat(
                            Cellˉevents,
                            Bytesˉconcat(
                                Bytesˉfromˉu8(1u8),
                                Bytesˉfromˉu32ˉlittle(Cell)
                            )
                        );
                    }
                }
                Stackˉrecords = Pushˉrecord(Stackˉrecords, Resultˉrecord);
            } else {
                Stackˉrecords = Pushˉscalar(Stackˉrecords);
            }
            Depth = Depth + 1u32;
            Handled = true;
        }

        if Opcode == 5u8 {
            if Depth == 0u32 { return Invalid(Input); }
            let Storeˉlocal: u32 = Bytesˉreadˉu32ˉlittle(
                Input,
                Codeˉoffset + Cursor + 1u32
            );
            if Storeˉlocal >= Locals { return Invalid(Input); }
            let Storeˉtype: u8 = Bytesˉreadˉu8(Localˉtypes, Storeˉlocal);
            if Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉisˉrecord(Storeˉtype) {
                if Storeˉlocal < Parameters { return Invalid(Input); }
                Usedˉrecord = Bytesˉreadˉu32ˉlittle(
                    Stackˉrecords,
                    (Depth - 1u32) * 4u32
                );
                if Usedˉrecord == 4294967295u32 { return Invalid(Input); }
                Usedˉrecords = Bytesˉconcat(
                    Usedˉrecords,
                    Bytesˉfromˉu32ˉlittle(Usedˉrecord)
                );
                let Storeˉrecord: u32 = Bytesˉreadˉu32ˉlittle(
                    Recordˉlocals.Indices,
                    Storeˉlocal * 4u32
                );
                if Storeˉrecord == 4294967295u32 {
                    return Invalid(Input);
                }
                let Definitionˉcell: u32 =
                    Currentˉblock * Recordˉlocals.Count + Storeˉrecord;
                if !Cellˉeventˉexists(
                    Cellˉevents,
                    2u8,
                    Definitionˉcell
                ) {
                    Cellˉevents = Bytesˉconcat(
                        Cellˉevents,
                        Bytesˉconcat(
                            Bytesˉfromˉu8(2u8),
                            Bytesˉfromˉu32ˉlittle(Definitionˉcell)
                        )
                    );
                }
            }
            Depth = Depth - 1u32;
            Stackˉrecords = Popˉrecords(Stackˉrecords, Depth);
            Handled = true;
        }

        if Opcode == 7u8 || Opcode == 11u8 || Opcode == 19u8 ||
            Opcode == 176u8 ||
            Opcode == 182u8 ||
            Opcode == 40u8 ||
            Numericˉopcode >= 109u32 && Numericˉopcode <= 112u32 ||
            Numericˉopcode >= 115u32 && Numericˉopcode <= 118u32 ||
            Numericˉopcode >= 120u32 && Numericˉopcode <= 125u32 ||
            Opcode == 190u8 ||
            Opcode == 191u8 {
            if Depth == 0u32 { return Invalid(Input); }
            Depth = Depth - 1u32;
            Stackˉrecords = Popˉrecords(Stackˉrecords, Depth);
            Stackˉrecords = Pushˉscalar(Stackˉrecords);
            Depth = Depth + 1u32;
            Handled = true;
        }

        if Opcode == 12u8 {
            if Depth < 3u32 { return Invalid(Input); }
            Depth = Depth - 3u32;
            Stackˉrecords = Popˉrecords(Stackˉrecords, Depth);
            Stackˉrecords = Pushˉscalar(Stackˉrecords);
            Depth = Depth + 1u32;
            Handled = true;
        }

        if Numericˉopcode >= 13u32 && Numericˉopcode <= 18u32 ||
            Numericˉopcode >= 20u32 && Numericˉopcode <= 22u32 ||
            Numericˉopcode >= 32u32 && Numericˉopcode <= 39u32 ||
            Numericˉopcode >= 96u32 && Numericˉopcode <= 103u32 ||
            Opcode == 107u8 || Opcode == 108u8 || Opcode == 113u8 ||
            Opcode == 114u8 || Opcode == 119u8 ||
            Numericˉopcode >= 134u32 && Numericˉopcode <= 136u32 ||
            Numericˉopcode >= 143u32 && Numericˉopcode <= 148u32 ||
            Opcode == 161u8 || Opcode == 162u8 ||
            Opcode == 165u8 || Opcode == 166u8 || Opcode == 189u8 ||
            Numericˉopcode >= 173u32 && Numericˉopcode <= 175u32 ||
            Opcode == 177u8 || Opcode == 178u8 ||
            Numericˉopcode >= 179u32 && Numericˉopcode <= 181u32 ||
            Opcode == 183u8 || Opcode == 184u8 {
            if Depth < 2u32 { return Invalid(Input); }
            Depth = Depth - 2u32;
            Stackˉrecords = Popˉrecords(Stackˉrecords, Depth);
            Stackˉrecords = Pushˉscalar(Stackˉrecords);
            Depth = Depth + 1u32;
            Handled = true;
        }

        if Opcode == 104u8 {
            let Typeˉindex: u32 = Bytesˉreadˉu32ˉlittle(
                Input,
                Codeˉoffset + Cursor + 1u32
            );
            if Typeˉindex >= Types.Count { return Invalid(Input); }
            let Fields: u32 =
                Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉitemˉcount(
                    Types,
                    Typeˉindex
                );
            if Depth < Fields || Blockˉrecordˉvalues >= 256u32 {
                return Invalid(Input);
            }
            var Field: u32 = 0u32;
            while Field < Fields {
                let Fieldˉrecord: u32 = Bytesˉreadˉu32ˉlittle(
                    Stackˉrecords,
                    (Depth - Fields + Field) * 4u32
                );
                let Fieldˉtype: u8 =
                    Nominalˉtypes.Compilerˉnativeˉx64ˉrecordˉfieldˉtype(
                        Input,
                        Types,
                        Typeˉindex,
                        Field
                    );
                if Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉisˉrecord(
                    Fieldˉtype
                ) {
                    if Fieldˉrecord == 4294967295u32 {
                        return Invalid(Input);
                    }
                    Usedˉrecords = Bytesˉconcat(
                        Usedˉrecords,
                        Bytesˉfromˉu32ˉlittle(Fieldˉrecord)
                    );
                } else if Fieldˉrecord != 4294967295u32 {
                    return Invalid(Input);
                }
                Field = Field + 1u32;
            }
            Depth = Depth - Fields;
            Stackˉrecords = Popˉrecords(Stackˉrecords, Depth);
            Resultˉrecord = Scratchˉvalues;
            Scratchˉvalues = Scratchˉvalues + 1u32;
            Blockˉrecordˉvalues = Blockˉrecordˉvalues + 1u32;
            if Blockˉrecordˉvalues > Recordˉvalues {
                Recordˉvalues = Blockˉrecordˉvalues;
            }
            let Createˉtype: u8 = Nominalˉtypes.Compilerˉnativeˉx64ˉrecordˉtype(
                Typeˉindex
            );
            Recordˉtypes = Rememberˉrecordˉtype(
                Input,
                Recordˉtypes,
                Types,
                Resultˉrecord,
                Createˉtype
            );
            Stackˉrecords = Pushˉrecord(Stackˉrecords, Resultˉrecord);
            Depth = Depth + 1u32;
            Handled = true;
        }

        if Opcode == 105u8 {
            if Depth == 0u32 { return Invalid(Input); }
            Usedˉrecord = Bytesˉreadˉu32ˉlittle(
                Stackˉrecords,
                (Depth - 1u32) * 4u32
            );
            if Usedˉrecord == 4294967295u32 { return Invalid(Input); }
            Usedˉrecords = Bytesˉconcat(
                Usedˉrecords,
                Bytesˉfromˉu32ˉlittle(Usedˉrecord)
            );
            let Sourceˉtype: u8 = Bytesˉreadˉu8(
                Recordˉtypes,
                Usedˉrecord
            );
            let Sourceˉtypeˉindex: u32 =
                Nominalˉtypes.Compilerˉnativeˉx64ˉrecordˉtypeˉindex(
                    Sourceˉtype
                );
            let Fieldˉindex: u32 = Bytesˉreadˉu32ˉlittle(
                Input,
                Codeˉoffset + Cursor + 1u32
            );
            if Fieldˉindex >=
                Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉitemˉcount(
                    Types,
                    Sourceˉtypeˉindex
                ) { return Invalid(Input); }
            let Selectedˉfieldˉtype: u8 =
                Nominalˉtypes.Compilerˉnativeˉx64ˉrecordˉfieldˉtype(
                    Input,
                    Types,
                    Sourceˉtypeˉindex,
                    Fieldˉindex
                );
            Depth = Depth - 1u32;
            Stackˉrecords = Popˉrecords(Stackˉrecords, Depth);
            if Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉisˉrecord(
                Selectedˉfieldˉtype
            ) {
                if Blockˉrecordˉvalues >= 256u32 { return Invalid(Input); }
                Resultˉrecord = Scratchˉvalues;
                Scratchˉvalues = Scratchˉvalues + 1u32;
                Blockˉrecordˉvalues = Blockˉrecordˉvalues + 1u32;
                if Blockˉrecordˉvalues > Recordˉvalues {
                    Recordˉvalues = Blockˉrecordˉvalues;
                }
                Recordˉtypes = Rememberˉrecordˉtype(
                    Input,
                    Recordˉtypes,
                    Types,
                    Resultˉrecord,
                    Selectedˉfieldˉtype
                );
                Stackˉrecords = Pushˉrecord(
                    Stackˉrecords,
                    Resultˉrecord
                );
            } else {
                Stackˉrecords = Pushˉscalar(Stackˉrecords);
            }
            Depth = Depth + 1u32;
            Handled = true;
        }

        if Opcode == 220u8 {
            if Depth < 2u32 || Blockˉrecordˉvalues >= 256u32 {
                return Invalid(Input);
            }
            let Scratchˉstorageˉlengthˉrecord: u32 = Bytesˉreadˉu32ˉlittle(
                Stackˉrecords,
                (Depth - 2u32) * 4u32
            );
            let Scratchˉstorageˉalignmentˉrecord: u32 = Bytesˉreadˉu32ˉlittle(
                Stackˉrecords,
                (Depth - 1u32) * 4u32
            );
            if Scratchˉstorageˉlengthˉrecord != 4294967295u32 ||
                Scratchˉstorageˉalignmentˉrecord != 4294967295u32 {
                return Invalid(Input);
            }
            let Scratchˉstorageˉtypeˉindex: u32 = Bytesˉreadˉu32ˉlittle(
                Input,
                Codeˉoffset + Cursor + 5u32
            );
            if Scratchˉstorageˉtypeˉindex >= Types.Count ||
                Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉkind(
                    Types,
                    Scratchˉstorageˉtypeˉindex
                ) != 3u8 {
                return Invalid(Input);
            }
            Depth = Depth - 2u32;
            Stackˉrecords = Popˉrecords(Stackˉrecords, Depth);
            Resultˉrecord = Scratchˉvalues;
            Scratchˉvalues = Scratchˉvalues + 1u32;
            Blockˉrecordˉvalues = Blockˉrecordˉvalues + 1u32;
            if Blockˉrecordˉvalues > Recordˉvalues {
                Recordˉvalues = Blockˉrecordˉvalues;
            }
            Recordˉtypes = Rememberˉrecordˉtype(
                Input,
                Recordˉtypes,
                Types,
                Resultˉrecord,
                Nominalˉtypes.Compilerˉnativeˉx64ˉvariantˉtype(
                    Scratchˉstorageˉtypeˉindex
                )
            );
            Stackˉrecords = Pushˉrecord(Stackˉrecords, Resultˉrecord);
            Depth = Depth + 1u32;
            Handled = true;
        }

        if Opcode == 151u8 || Opcode == 152u8 || Opcode == 153u8 ||
            Opcode == 196u8 {
            let Variantˉstate:
                Variantˉstorage.Compilerˉnativeˉx64ˉvariantˉstorageˉstate =
                Variantˉstorage.Compilerˉnativeˉx64ˉanalyzeˉvariantˉstorage(
                    Input,
                    Codeˉoffset,
                    Cursor,
                    Opcode,
                    Types,
                    Variantˉstorage.Compilerˉnativeˉx64ˉvariantˉstorageˉinput(
                        Stackˉrecords,
                        Depth,
                        Usedˉrecords,
                        Recordˉtypes,
                        Recordˉvalues,
                        Scratchˉvalues,
                        Blockˉrecordˉvalues
                    )
                );
            if !Variantˉstate.Valid { return Invalid(Input); }
            Stackˉrecords = Variantˉstate.Stackˉrecords;
            Depth = Variantˉstate.Depth;
            Usedˉrecords = Variantˉstate.Usedˉrecords;
            Resultˉrecord = Variantˉstate.Resultˉrecord;
            Recordˉtypes = Variantˉstate.Recordˉtypes;
            Recordˉvalues = Variantˉstate.Recordˉvalues;
            Scratchˉvalues = Variantˉstate.Scratchˉvalues;
            Blockˉrecordˉvalues = Variantˉstate.Blockˉrecordˉvalues;
            Handled = true;
        }

        if Opcode == 64u8 {
            let Callˉtarget: u32 = Bytesˉreadˉu32ˉlittle(
                Input,
                Codeˉoffset + Cursor + 1u32
            );
            if Callˉtarget >= Bytesˉlength(Callˉdirectory) /
                Layout.Compilerˉnativeˉx64ˉlayoutˉentryˉbytes() {
                return Invalid(Input);
            }
            let Callˉparameters: u32 =
                Layout.Compilerˉnativeˉx64ˉlayoutˉparameters(
                    Callˉdirectory,
                    Callˉtarget
                );
            if Depth < Callˉparameters { return Invalid(Input); }
            var Parameter: u32 = 0u32;
            while Parameter < Callˉparameters {
                if Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉisˉrecord(
                    Layout.Compilerˉnativeˉx64ˉlayoutˉparameterˉtype(
                        Callˉdirectory,
                        Callˉtarget,
                        Parameter
                    )
                ) {
                    Usedˉrecord = Bytesˉreadˉu32ˉlittle(
                        Stackˉrecords,
                        (Depth - Callˉparameters + Parameter) * 4u32
                    );
                    if Usedˉrecord == 4294967295u32 { return Invalid(Input); }
                    Usedˉrecords = Bytesˉconcat(
                        Usedˉrecords,
                        Bytesˉfromˉu32ˉlittle(Usedˉrecord)
                    );
                }
                Parameter = Parameter + 1u32;
            }
            Depth = Depth - Callˉparameters;
            Stackˉrecords = Popˉrecords(Stackˉrecords, Depth);
            let Callˉreturn: u8 =
                Layout.Compilerˉnativeˉx64ˉlayoutˉreturnˉtype(
                    Callˉdirectory,
                    Callˉtarget
                );
            if Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉisˉrecord(Callˉreturn) {
                if Blockˉrecordˉvalues >= 256u32 { return Invalid(Input); }
                Resultˉrecord = Scratchˉvalues;
                Scratchˉvalues = Scratchˉvalues + 1u32;
                Blockˉrecordˉvalues = Blockˉrecordˉvalues + 1u32;
                if Blockˉrecordˉvalues > Recordˉvalues {
                    Recordˉvalues = Blockˉrecordˉvalues;
                }
                Recordˉtypes = Rememberˉrecordˉtype(
                    Input,
                    Recordˉtypes,
                    Types,
                    Resultˉrecord,
                    Callˉreturn
                );
                Stackˉrecords = Pushˉrecord(Stackˉrecords, Resultˉrecord);
            } else {
                if Callˉreturn != 0u8 {
                    Stackˉrecords = Pushˉscalar(Stackˉrecords);
                }
            }
            if Callˉreturn != 0u8 { Depth = Depth + 1u32; }
            Handled = true;
        }

        if Opcode == 65u8 {
            let Capabilityˉindex: u32 = Bytesˉreadˉu32ˉlittle(
                Input,
                Codeˉoffset + Cursor + 1u32
            );
            if Capabilityˉindex >= Bytesˉlength(Capabilityˉkinds) {
                return Invalid(Input);
            }
            let Capabilityˉkind: u8 = Bytesˉreadˉu8(
                Capabilityˉkinds,
                Capabilityˉindex
            );
            if Capabilityˉkind == 0u8 || U32ˉfromˉu8(Capabilityˉkind) > 11u32 {
                return Invalid(Input);
            }
            var Capabilityˉparameters: u32 = 1u32;
            if Capabilityˉkind ==
                Nativeˉcapabilities.Compilerˉnativeˉx64ˉprocessˉargumentˉcountˉkind() {
                Capabilityˉparameters = 0u32;
            }
            if Capabilityˉkind ==
                Nativeˉcapabilities.Compilerˉnativeˉx64ˉfileˉwriteˉbytesˉkind() {
                Capabilityˉparameters = 2u32;
            }
            if Capabilityˉkind ==
                Nativeˉcapabilities.Compilerˉnativeˉx64ˉdirectoryˉreadˉkind() {
                Capabilityˉparameters = 3u32;
            }
            if Capabilityˉkind ==
                Nativeˉcapabilities.Compilerˉnativeˉx64ˉstorageˉrandomˉaccessˉkind() {
                Capabilityˉparameters = 5u32;
            }
            if Depth < Capabilityˉparameters {
                return Invalid(Input);
            }
            var Capabilityˉparameter: u32 = 0u32;
            while Capabilityˉparameter < Capabilityˉparameters {
                if Bytesˉreadˉu32ˉlittle(
                    Stackˉrecords,
                    (Depth - Capabilityˉparameters + Capabilityˉparameter) * 4u32
                ) != 4294967295u32 { return Invalid(Input); }
                Capabilityˉparameter = Capabilityˉparameter + 1u32;
            }
            Depth = Depth - Capabilityˉparameters;
            Stackˉrecords = Popˉrecords(Stackˉrecords, Depth);
            if Capabilityˉkind ==
                    Nativeˉcapabilities.Compilerˉnativeˉx64ˉfileˉreadˉbytesˉkind() ||
                Capabilityˉkind ==
                    Nativeˉcapabilities.Compilerˉnativeˉx64ˉprocessˉargumentˉkind() ||
                Capabilityˉkind ==
                    Nativeˉcapabilities.Compilerˉnativeˉx64ˉprocessˉargumentˉcountˉkind() ||
                Capabilityˉkind ==
                    Nativeˉcapabilities.Compilerˉnativeˉx64ˉdirectoryˉreadˉkind() ||
                Capabilityˉkind ==
                    Nativeˉcapabilities.Compilerˉnativeˉx64ˉmodelˉcatalogˉkind() ||
                Capabilityˉkind ==
                    Nativeˉcapabilities.Compilerˉnativeˉx64ˉmodelˉinferenceˉkind() ||
                Capabilityˉkind ==
                    Nativeˉcapabilities.Compilerˉnativeˉx64ˉstandardˉoutputˉwriteˉkind() ||
                Capabilityˉkind ==
                    Nativeˉcapabilities.Compilerˉnativeˉx64ˉstorageˉrandomˉaccessˉkind() {
                Stackˉrecords = Pushˉscalar(Stackˉrecords);
                Depth = Depth + 1u32;
            }
            Handled = true;
        }

        if Opcode == 48u8 {
            if Depth != 0u32 { return Invalid(Input); }
            let Jumpˉtarget: u32 = Bytesˉreadˉu32ˉlittle(
                Input,
                Codeˉoffset + Cursor + 1u32
            );
            if Jumpˉtarget >= Codeˉlength { return Invalid(Input); }
            let Jumpˉtargetˉblock: u32 = Blockˉforˉleader(
                Blockˉdirectory,
                Jumpˉtarget
            );
            if Jumpˉtargetˉblock == 4294967295u32 { return Invalid(Input); }
            if Bytesˉlength(Blockˉends) / 4u32 != Currentˉblock {
                return Invalid(Input);
            }
            Blockˉends = Bytesˉconcat(
                Blockˉends,
                Bytesˉfromˉu32ˉlittle(Instructions + 1u32)
            );
            Successorˉfirst = Bytesˉconcat(
                Successorˉfirst,
                Bytesˉfromˉu32ˉlittle(Jumpˉtargetˉblock)
            );
            Successorˉsecond = Bytesˉconcat(
                Successorˉsecond,
                Bytesˉfromˉu32ˉlittle(4294967295u32)
            );
            Handled = true;
        }

        if Opcode == 49u8 {
            if Depth != 1u32 || Currentˉblock + 1u32 >= Blocks {
                return Invalid(Input);
            }
            let Branchˉtarget: u32 = Bytesˉreadˉu32ˉlittle(
                Input,
                Codeˉoffset + Cursor + 1u32
            );
            if Branchˉtarget >= Codeˉlength { return Invalid(Input); }
            let Branchˉtargetˉblock: u32 = Blockˉforˉleader(
                Blockˉdirectory,
                Branchˉtarget
            );
            if Branchˉtargetˉblock == 4294967295u32 { return Invalid(Input); }
            Depth = 0u32;
            Stackˉrecords = Empty(Input);
            if Bytesˉlength(Blockˉends) / 4u32 != Currentˉblock {
                return Invalid(Input);
            }
            Blockˉends = Bytesˉconcat(
                Blockˉends,
                Bytesˉfromˉu32ˉlittle(Instructions + 1u32)
            );
            Successorˉfirst = Bytesˉconcat(
                Successorˉfirst,
                Bytesˉfromˉu32ˉlittle(Branchˉtargetˉblock)
            );
            Successorˉsecond = Bytesˉconcat(
                Successorˉsecond,
                Bytesˉfromˉu32ˉlittle(Currentˉblock + 1u32)
            );
            Handled = true;
        }

        if Opcode == 81u8 {
            if Returnˉtype == 0u8 {
                if Depth != 0u32 { return Invalid(Input); }
            } else {
                if Depth != 1u32 { return Invalid(Input); }
            }
            if Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉisˉrecord(Returnˉtype) {
                Usedˉrecord = Bytesˉreadˉu32ˉlittle(Stackˉrecords, 0u32);
                if Usedˉrecord == 4294967295u32 { return Invalid(Input); }
                Usedˉrecords = Bytesˉconcat(
                    Usedˉrecords,
                    Bytesˉfromˉu32ˉlittle(Usedˉrecord)
                );
            }
            Depth = 0u32;
            Stackˉrecords = Empty(Input);
            if Bytesˉlength(Blockˉends) / 4u32 != Currentˉblock {
                return Invalid(Input);
            }
            Blockˉends = Bytesˉconcat(
                Blockˉends,
                Bytesˉfromˉu32ˉlittle(Instructions + 1u32)
            );
            Successorˉfirst = Bytesˉconcat(
                Successorˉfirst,
                Bytesˉfromˉu32ˉlittle(4294967295u32)
            );
            Successorˉsecond = Bytesˉconcat(
                Successorˉsecond,
                Bytesˉfromˉu32ˉlittle(4294967295u32)
            );
            Handled = true;
        }

        if !Handled { return Invalid(Input); }
        Events = Bytesˉconcat(
            Events,
            Bytesˉconcat(
                Bytesˉfromˉu32ˉlittle(Currentˉblock),
                Bytesˉconcat(
                    Bytesˉfromˉu32ˉlittle(Resultˉrecord),
                    Bytesˉconcat(
                        Bytesˉfromˉu32ˉlittle(
                            Bytesˉlength(Usedˉrecords) / 4u32
                        ),
                        Usedˉrecords
                    )
                )
            )
        );
        Cursor = Cursor + Size;
        Instructions = Instructions + 1u32;
    }
    if Cursor != Codeˉlength || Currentˉblock == 4294967295u32 ||
        Depth != 0u32 {
        return Invalid(Input);
    }
    if Bytesˉlength(Blockˉends) / 4u32 == Currentˉblock {
        Blockˉends = Bytesˉconcat(
            Blockˉends,
            Bytesˉfromˉu32ˉlittle(Instructions)
        );
        Successorˉfirst = Bytesˉconcat(
            Successorˉfirst,
            Bytesˉfromˉu32ˉlittle(4294967295u32)
        );
        Successorˉsecond = Bytesˉconcat(
            Successorˉsecond,
            Bytesˉfromˉu32ˉlittle(4294967295u32)
        );
    }
    if Bytesˉlength(Blockˉstarts) != Blocks * 4u32 ||
        Bytesˉlength(Blockˉends) != Blocks * 4u32 ||
        Bytesˉlength(Successorˉfirst) != Blocks * 4u32 ||
        Bytesˉlength(Successorˉsecond) != Blocks * 4u32 {
        return Invalid(Input);
    }

    return Buildˉstorage(
        Input,
        Codeˉoffset,
        Recordˉlocals,
        Types,
        Blocks,
        Instructionˉoffsets,
        Blockˉstarts,
        Blockˉends,
        Successorˉfirst,
        Successorˉsecond,
        Cellˉevents,
        Events,
        Recordˉtypes,
        Recordˉvalues,
        Scratchˉvalues,
        Scratchˉblockˉoffsets,
        Instructions
    );
}
