}

export fn Compilerˉsourceˉwirˉoperationˉoperandˉshapeˉisˉvalid(
    Operation: u32,
    Index: u32,
    Shape: u32
) -> bool {
    if Operation == 10u32 { return Shape == 1u32; }
    if Operation == 11u32 { return Shape == 6u32; }
    if Operation == 12u32 {
        if Index == 0u32 { return Shape == 6u32; }
        return Shape == 3u32;
    }
    if Operation >= 13u32 {
        if Operation <= 16u32 {
            if Index == 0u32 { return Shape == 6u32; }
            return Shape == 3u32;
        }
    }
    if Operation == 18u32 {
        if Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉshapeˉisˉprivate(
                Shape
            ) {
            return true;
        }
        if Shape >= 65536u32 { return Shape < 131072u32; }
        return false;
    }
    if Operation == 20u32 {
        if Shape >= 131072u32 { return Shape < 196608u32; }
        return false;
    }
    if Operation == 21u32 {
        if Shape >= 131072u32 { return Shape < 196608u32; }
        return false;
    }
    if Operation == 22u32 {
        if Shape >= 131072u32 { return Shape < 196608u32; }
        return false;
    }
    if Operation == 23u32 { return Shape == 1u32; }
    if Operation == 24u32 { return Shape == 2u32; }
    if Operation == 25u32 { return Shape == 3u32; }
    if Operation == 26u32 { return Shape == 2u32; }
    if Operation == 27u32 { return Shape == 5u32; }
    if Operation == 28u32 { return Shape == 6u32; }
    if Operation == 29u32 { return Shape == 6u32; }
    if Operation == 30u32 { return Shape == 5u32; }
    if Operation == 31u32 { return Shape == 6u32; }
    if Operation == 32u32 { return Shape == 2u32; }
    if Operation == 33u32 { return Shape == 3u32; }
    if Operation == 34u32 { return Shape == 3u32; }
    if Operation == 35u32 { return Shape == 1u32; }
    if Operation == 36u32 { return Shape == 6u32; }
    if Operation == 37u32 { return Shape == 5u32; }
    if Operation >= 38u32 {
        if Operation <= 41u32 { return Shape == 1u32; }
    }
    if Operation >= 42u32 {
        if Operation <= 44u32 { return Shape == 3u32; }
    }
    if Operation >= 45u32 {
        if Operation <= 50u32 { return Shape == 1u32; }
    }
    if Operation == 51u32 { return Shape == 4u32; }
    if Operation == 52u32 { return Shape == 4u32; }
    if Operation == 53u32 { return Shape == 4u32; }
    if Operation >= 54u32 {
        if Operation <= 59u32 { return Shape == 3u32; }
    }
    if Operation == 60u32 { return Shape == 2u32; }
    if Operation == 61u32 { return Shape == 2u32; }
    if Operation == 64u32 { return Shape != 0u32 && Shape != 10u32; }
    if Operation == 66u32 { return Shape >= 196608u32; }
    if Operation == 67u32 { return Shape >= 196608u32; }
    if Operation == 69u32 {
        if Index == 0u32 { return Wirˉconsumer.Compilerˉsourceˉwirˉshapeˉisˉbuilder(Shape); }
        return true;
    }
    if Operation == 70u32 { return Wirˉconsumer.Compilerˉsourceˉwirˉshapeˉisˉbuilder(Shape); }
    if Operation == 71u32 { return Wirˉconsumer.Compilerˉsourceˉwirˉshapeˉisˉsequence(Shape); }
    if Operation == 72u32 {
        if Index == 0u32 { return Wirˉconsumer.Compilerˉsourceˉwirˉshapeˉisˉsequence(Shape); }
        return Shape == 3u32;
    }
    if Operation == 73u32 { return Shape == 1u32; }
    if Operation == 74u32 { return Shape == 1u32; }
    if Operation == 75u32 { return Shape == 3u32; }
    if Operation == 76u32 { return Shape == 3u32; }
    if Operation >= 77u32 {
        if Operation <= 80u32 { return Shape == 2u32; }
    }
    if Operation == 81u32 || Operation == 82u32 {
        if Index == 0u32 { return Shape == 2u32; }
        return Shape == 3u32;
    }
    if Operation >= 83u32 {
        if Operation <= 88u32 { return Shape == 3u32; }
    }
    if Operation == 89u32 || Operation == 90u32 { return Shape == 5u32; }
    if Operation == 91u32 || Operation == 92u32 { return Shape == 6u32; }
    if Operation == 95u32 { return Shape == 7u32; }
    if Operation == 96u32 { return Shape == 8u32; }
    if Operation >= 97u32 {
        if Operation <= 100u32 { return Shape == 7u32; }
    }
    if Operation >= 101u32 {
        if Operation <= 103u32 { return Shape == 8u32; }
    }
    if Operation >= 104u32 {
        if Operation <= 109u32 { return Shape == 7u32; }
    }
    if Operation >= 110u32 {
        if Operation <= 115u32 { return Shape == 8u32; }
    }
    if Operation == 116u32 || Operation == 117u32 { return Shape == 7u32; }
    if Operation >= 118u32 {
        if Operation <= 123u32 { return Shape == 8u32; }
    }
    if Operation == 124u32 || Operation == 125u32 {
        if Index == 0u32 { return Shape == 8u32; }
        return Shape == 3u32;
    }
    if Operation == 126u32 {
        if Index == 0u32 { return Shape == 6u32; }
        return Shape == 3u32;
    }
    if Operation == 127u32 { return Shape == 8u32; }
    if Operation == 128u32 { return Shape == 3u32; }
    if Operation >= 130u32 {
        if Operation <= 134u32 {
            return Shape >= 11u32 && Shape <= 13u32;
        }
    }
    if Operation == 135u32 { return Shape == 11u32 || Shape == 12u32; }
    if Operation >= 136u32 {
        if Operation <= 141u32 {
            return Shape >= 11u32 && Shape <= 13u32;
        }
    }
    if Operation >= 142u32 {
        if Operation <= 145u32 { return Shape == 13u32; }
    }
    if Operation == 146u32 || Operation == 147u32 {
        if Index == 0u32 { return Shape == 13u32; }
        return Shape == 3u32;
    }
    if Operation == 149u32 || Operation == 150u32 { return Shape == 16u32; }
    if Operation >= 152u32 {
        if Operation <= 162u32 { return Shape == 14u32 || Shape == 15u32; }
    }
    if Operation == 167u32 { return Index == 0u32; }
    if Operation == 168u32 {
        if Index == 0u32 { return true; }
        return Shape == 8u32;
    }
    if Operation == 171u32 {
        if Index == 0u32 { return Shape == 8u32; }
        return Shape == 3u32;
    }
    if Operation == 172u32 { return Index == 0u32 && Shape == 8u32; }
    if Operation == 173u32 { return Index == 0u32 && Shape != 0u32; }
    if Operation == 175u32 { return Index == 0u32 && Shape == 8u32; }
    if Operation == WIR_OPERATION_CALL_INDIRECT {
        if Index == 0u32 {
            return Shape >= WIR_FUNCTION_TYPE_SHAPE_BASE &&
                Shape < WIR_FUNCTION_TYPE_SHAPE_BASE +
                    WIR_FUNCTION_TYPE_INSTANCE_LIMIT;
        }
        return Shape != 0u32 && Shape != 10u32;
    }
    return true;
}

export fn Compilerˉsourceˉwirˉinvalidˉrange() -> Compilerˉsourceˉwirˉrange {
    return Compilerˉsourceˉwirˉrange(
        false, false,
        0u32, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32,
        0u32, 0u32, 0u32
    );
}

export fn Compilerˉsourceˉwirˉfunctionˉrange(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Bindings: Sourceˉbindings.Compilerˉsourceˉbindingˉsummary,
    Functionˉtypeˉcatalog:
        Compilerˉsourceˉwirˉfunctionˉtypeˉcatalog,
    Directory: bytes,
    Function: u32,
    Expectedˉblock: u32,
    Expectedˉoperation: u32,
    Expectedˉtemporary: u32,
    Expectedˉoperand: u32,
    Blocks: u32,
    Operations: u32,
    Temporaries: u32,
    Operands: u32
) -> Compilerˉsourceˉwirˉrange {
    let Symbolˉentries: u32 = Bytesˉreadˉu32ˉlittle(
        Symbols.Directory, 8u32
    );
    let Embeddedˉcatalog: Sourceˉgenerics.Compilerˉsourceˉgenericˉcatalog =
        Genericˉbindings.Compilerˉsourceˉbindingsˉgenericˉtypesˉfunctionˉcatalog(
            Bindings.Directory
        );
    let Embeddedˉtypeˉcatalog:
        Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog =
        Genericˉbindings.Compilerˉsourceˉbindingsˉgenericˉtypesˉtypeˉcatalog(
            Bindings.Directory
        );
    var Genericˉinstance: u32 = Wirˉconsumer.Compilerˉsourceˉwirˉsentinel();
    let Declarationˉentry: u32 =
        Sourceˉbindings.Compilerˉsourceˉbindingsˉrangeˉdeclaration(
            Bindings.Directory, Function
        );
    if Function >= Symbolˉentries {
        Genericˉinstance = Function - Symbolˉentries;
    }
    if Declarationˉentry >= Symbolˉentries {
        return Compilerˉsourceˉwirˉinvalidˉrange();
    }
    let Symbolˉentry: u32 = 16u32 + Declarationˉentry * 24u32;
    let Symbolˉmodule: u32 = Bytesˉreadˉu32ˉlittle(Symbols.Directory, Symbolˉentry);
    let Symbolˉkind: u32 = Bytesˉreadˉu32ˉlittle(Symbols.Directory, Symbolˉentry + 4u32);
    let Functionˉentry: u32 =
        Wirˉconsumer.Compilerˉsourceˉwirˉfunctionsˉoffset(Directory) + Function * 48u32;
    if Symbolˉkind != 6u32 {
        var Zeroˉindex: u32 = 0u32;
        while Zeroˉindex < 12u32 {
            if Bytesˉreadˉu32ˉlittle(
                Directory, Functionˉentry + Zeroˉindex * 4u32
            ) != 0u32 {
                return Compilerˉsourceˉwirˉinvalidˉrange();
            }
            Zeroˉindex = Zeroˉindex + 1u32;
        }
        return Compilerˉsourceˉwirˉrange(
            true, false,
            Symbolˉmodule, Expectedˉblock, 0u32,
            Expectedˉoperation, 0u32,
            Expectedˉtemporary, 0u32,
            Expectedˉoperand, 0u32,
            0u32, 0u32, 0u32
        );
    }
    let Declarationˉoffset: u32 = Bytesˉreadˉu32ˉlittle(
        Symbols.Directory, Symbolˉentry + 8u32
    );
    let Functionˉview: Sourceˉset.Compilerˉsourceˉsetˉview =
        Sourceˉset.Compilerˉsourceˉsetˉmodule(
            Input, Scan, Symbolˉmodule
        );
    let Declarationˉposition: Sourceˉbodies.Compilerˉsourceˉposition =
        Sourceˉbodies.Compilerˉsourceˉposition(
            Declarationˉoffset, 1u32, 1u32
        );
    let Declaration: Sourceˉdeclarations.Compilerˉsourceˉdeclaration =
        Sourceˉdeclarations.Compilerˉparseˉnextˉdeclarationˉvalidated(
            Functionˉview.Source, Declarationˉoffset,
            Declarationˉposition.Line, Declarationˉposition.Column, true
        );
    let Generic: Sourceˉsymbols.Compilerˉsourceˉfunctionˉgeneric =
        Sourceˉsymbols.Compilerˉsourceˉsymbolsˉfunctionˉgeneric(
            Functionˉview.Source, Declaration,
            Declarationˉposition.Line, Declarationˉposition.Column
        );
    if Generic.Parameters > 0u32 &&
        Genericˉinstance == Wirˉconsumer.Compilerˉsourceˉwirˉsentinel() {
        var Genericˉzero: u32 = 0u32;
        while Genericˉzero < 12u32 {
            if Bytesˉreadˉu32ˉlittle(
                Directory, Functionˉentry + Genericˉzero * 4u32
            ) != 0u32 {
                return Compilerˉsourceˉwirˉinvalidˉrange();
            }
            Genericˉzero = Genericˉzero + 1u32;
        }
        return Compilerˉsourceˉwirˉrange(
            true, false,
            Symbolˉmodule, Expectedˉblock, 0u32,
            Expectedˉoperation, 0u32,
            Expectedˉtemporary, 0u32,
            Expectedˉoperand, 0u32,
            0u32, 0u32, 0u32
        );
    }
    if Generic.Parameters == 0u32 &&
        Genericˉinstance != Wirˉconsumer.Compilerˉsourceˉwirˉsentinel() {
        return Compilerˉsourceˉwirˉinvalidˉrange();
    }
    let Entryˉmodule: u32 = Bytesˉreadˉu32ˉlittle(Directory, Functionˉentry);
    let Firstˉblock: u32 = Bytesˉreadˉu32ˉlittle(Directory, Functionˉentry + 4u32);
    let Blockˉcount: u32 = Bytesˉreadˉu32ˉlittle(Directory, Functionˉentry + 8u32);
    let Firstˉoperation: u32 = Bytesˉreadˉu32ˉlittle(Directory, Functionˉentry + 12u32);
    let Operationˉcount: u32 = Bytesˉreadˉu32ˉlittle(Directory, Functionˉentry + 16u32);
    let Firstˉtemporary: u32 = Bytesˉreadˉu32ˉlittle(Directory, Functionˉentry + 20u32);
    let Temporaryˉcount: u32 = Bytesˉreadˉu32ˉlittle(Directory, Functionˉentry + 24u32);
    let Firstˉoperand: u32 = Bytesˉreadˉu32ˉlittle(Directory, Functionˉentry + 28u32);
    let Operandˉcount: u32 = Bytesˉreadˉu32ˉlittle(Directory, Functionˉentry + 32u32);
    let Parameters: u32 = Bytesˉreadˉu32ˉlittle(Directory, Functionˉentry + 36u32);
    let Locals: u32 = Bytesˉreadˉu32ˉlittle(Directory, Functionˉentry + 40u32);
    let Returnˉshape: u32 = Bytesˉreadˉu32ˉlittle(Directory, Functionˉentry + 44u32);
    if Entryˉmodule != Symbolˉmodule { return Compilerˉsourceˉwirˉinvalidˉrange(); }
    if Firstˉblock != Expectedˉblock { return Compilerˉsourceˉwirˉinvalidˉrange(); }
    if Firstˉoperation != Expectedˉoperation { return Compilerˉsourceˉwirˉinvalidˉrange(); }
    if Firstˉtemporary != Expectedˉtemporary { return Compilerˉsourceˉwirˉinvalidˉrange(); }
    if Firstˉoperand != Expectedˉoperand { return Compilerˉsourceˉwirˉinvalidˉrange(); }
    if Blockˉcount == 0u32 { return Compilerˉsourceˉwirˉinvalidˉrange(); }
    if Blockˉcount > Blocks - Firstˉblock { return Compilerˉsourceˉwirˉinvalidˉrange(); }
    if Operationˉcount > Operations - Firstˉoperation { return Compilerˉsourceˉwirˉinvalidˉrange(); }
    if Temporaryˉcount > Temporaries - Firstˉtemporary { return Compilerˉsourceˉwirˉinvalidˉrange(); }
    if Operandˉcount > Operands - Firstˉoperand { return Compilerˉsourceˉwirˉinvalidˉrange(); }
    let Symbolˉparameters: u32 = Bytesˉreadˉu32ˉlittle(Symbols.Directory, Symbolˉentry + 20u32);
    if Parameters != Symbolˉparameters { return Compilerˉsourceˉwirˉinvalidˉrange(); }
    let Bindingˉrange: u32 =
        Sourceˉbindings.Compilerˉsourceˉbindingsˉrangeˉoffset(
            Bindings.Directory, Function
        );
    let Bindingˉcount: u32 = Bytesˉreadˉu32ˉlittle(Bindings.Directory, Bindingˉrange + 4u32);
    if Bindingˉcount < Parameters { return Compilerˉsourceˉwirˉinvalidˉrange(); }
    if Locals != Bindingˉcount - Parameters { return Compilerˉsourceˉwirˉinvalidˉrange(); }
    if !Compilerˉsourceˉwirˉshapeˉisˉvalidˉwithˉgenericˉtypes(
        Returnˉshape, Symbols, Embeddedˉtypeˉcatalog,
        Functionˉtypeˉcatalog, true
    ) {
        return Compilerˉsourceˉwirˉinvalidˉrange();
    }
    if Generic.Parameters > 0u32 {
        // The catalog is the canonical solved substitution. Revalidating it
        // against the declaration, then checking the substituted signatures
        // below, proves the specialized boundary without replaying inference.
        var Solution: Sourceˉgenerics.Compilerˉsourceˉgenericˉsolution =
            Sourceˉsymbols.Compilerˉsourceˉsymbolsˉgenericˉsolution(
                Functionˉview.Source, Generic
            );
        var Catalogˉparameter: u32 = 0u32;
        while Catalogˉparameter < Generic.Parameters {
            let Catalogˉargument:
                Sourceˉgenerics.Compilerˉsourceˉgenericˉargument =
                Sourceˉgenerics.Compilerˉsourceˉgenericˉcatalogˉargument(
                    Embeddedˉcatalog, Genericˉinstance, Catalogˉparameter
                );
            if !Catalogˉargument.Valid {
                return Compilerˉsourceˉwirˉinvalidˉrange();
            }
            if Catalogˉargument.Kind == 1u32 &&
                !Compilerˉsourceˉwirˉshapeˉisˉvalidˉwithˉgenericˉtypes(
                    Catalogˉargument.Low, Symbols,
                    Embeddedˉtypeˉcatalog, Functionˉtypeˉcatalog, false
                ) {
                return Compilerˉsourceˉwirˉinvalidˉrange();
            }
            Solution =
                Sourceˉgenerics.Compilerˉsourceˉgenericˉsolutionˉcontribute(
                    Solution, Catalogˉparameter,
                    Catalogˉargument.Kind,
                    Catalogˉargument.Low,
                    Catalogˉargument.High,
                    Catalogˉparameter, Declarationˉoffset
                );
            if Solution.Status !=
                    Sourceˉgenerics.Compilerˉsourceˉgenericˉstatus.Valid {
                return Compilerˉsourceˉwirˉinvalidˉrange();
            }
            Catalogˉparameter = Catalogˉparameter + 1u32;
        }
        Solution = Sourceˉgenerics.Compilerˉsourceˉgenericˉsolutionˉfinish(
            Solution
        );
        if Solution.Status !=
                Sourceˉgenerics.Compilerˉsourceˉgenericˉstatus.Valid {
            return Compilerˉsourceˉwirˉinvalidˉrange();
        }
        if !Sourceˉgenerics.Compilerˉsourceˉgenericˉcatalogˉinstanceˉmatchesˉsolution(
            Embeddedˉcatalog, Genericˉinstance, Declarationˉentry, Solution
        ) {
            return Compilerˉsourceˉwirˉinvalidˉrange();
        }
        var Argument: u32 = 0u32;
        while Argument < Symbolˉparameters {
            let Parameterˉsignature: Compilerˉsourceˉwirˉsignature =
                Compilerˉsourceˉwirˉfunctionˉsignatureˉconcrete(
                    Input, Scan, Symbols, Symbolˉmodule,
                    Functionˉview.Source, Declarationˉoffset, Argument,
                    Embeddedˉcatalog,
                    Embeddedˉtypeˉcatalog,
                    Genericˉinstance
                );
            if Parameterˉsignature.Parameterˉshape !=
                    Wirˉconsumer.Compilerˉsourceˉwirˉbindingˉshape(
                        Bindings, Bytesˉreadˉu32ˉlittle(
                            Symbols.Directory, 8u32
                        ), Function, Argument
                    ) {
                return Compilerˉsourceˉwirˉinvalidˉrange();
            }
            Argument = Argument + 1u32;
        }
    }
    let Sourceˉsignature: Compilerˉsourceˉwirˉsignature =
        Compilerˉsourceˉwirˉfunctionˉsignatureˉconcrete(
            Input, Scan, Symbols, Symbolˉmodule, Functionˉview.Source,
            Declarationˉoffset, Wirˉconsumer.Compilerˉsourceˉwirˉsentinel(),
            Embeddedˉcatalog,
            Embeddedˉtypeˉcatalog,
            Genericˉinstance
        );
    if Returnˉshape != Sourceˉsignature.Returnˉshape {
        return Compilerˉsourceˉwirˉinvalidˉrange();
    }
    return Compilerˉsourceˉwirˉrange(
        true, true,
        Entryˉmodule, Firstˉblock, Blockˉcount,
        Firstˉoperation, Operationˉcount,
        Firstˉtemporary, Temporaryˉcount,
        Firstˉoperand, Operandˉcount,
        Parameters, Locals, Returnˉshape
    );
}

export fn Compilerˉsourceˉwirˉfunctionˉblocksˉareˉvalid(
    Directory: bytes,
    Blocksˉoffset: u32,
    Operationsˉoffset: u32,
    Temporariesˉoffset: u32,
    Function: u32,
    Range: Compilerˉsourceˉwirˉrange
) -> bool {
    var Blockˉindex: u32 = 0u32;
    var Coveredˉoperations: u32 = 0u32;
    var Foundˉentry: bool = false;
    while Blockˉindex < Range.Blockˉcount {
        let Blockˉentry: u32 = Blocksˉoffset + (Range.Firstˉblock + Blockˉindex) * 28u32;
        let Blockˉidentifier: u32 = Bytesˉreadˉu32ˉlittle(Directory, Blockˉentry);
        let Blockˉfirstˉoperation: u32 = Bytesˉreadˉu32ˉlittle(Directory, Blockˉentry + 4u32);
        let Blockˉoperationˉcount: u32 = Bytesˉreadˉu32ˉlittle(Directory, Blockˉentry + 8u32);
        let Blockˉterminator: u32 = Bytesˉreadˉu32ˉlittle(Directory, Blockˉentry + 12u32);
        let Blockˉvalue: u32 = Bytesˉreadˉu32ˉlittle(Directory, Blockˉentry + 16u32);
        let Blockˉfirstˉtarget: u32 = Bytesˉreadˉu32ˉlittle(Directory, Blockˉentry + 20u32);
        let Blockˉsecondˉtarget: u32 = Bytesˉreadˉu32ˉlittle(Directory, Blockˉentry + 24u32);
        if Blockˉidentifier >= Range.Blockˉcount { return false; }
        if Blockˉidentifier == 0u32 { Foundˉentry = true; }
        if Blockˉidentifier != Blockˉindex { return false; }
        if Blockˉfirstˉoperation < Range.Firstˉoperation { return false; }
        let Functionˉoperationˉend: u32 = Range.Firstˉoperation + Range.Operationˉcount;
        if Blockˉfirstˉoperation > Functionˉoperationˉend { return false; }
        if Blockˉoperationˉcount > Functionˉoperationˉend - Blockˉfirstˉoperation {
            return false;
        }
        Coveredˉoperations = Coveredˉoperations + Blockˉoperationˉcount;
        var Blockˉoperationˉindex: u32 = 0u32;
        while Blockˉoperationˉindex < Blockˉoperationˉcount {
            let Ownedˉoperationˉentry: u32 = Operationsˉoffset + (
                Blockˉfirstˉoperation + Blockˉoperationˉindex
            ) * 28u32;
            if Bytesˉreadˉu32ˉlittle(
                Directory, Ownedˉoperationˉentry
            ) != Blockˉidentifier { return false; }
            Blockˉoperationˉindex = Blockˉoperationˉindex + 1u32;
        }
        if Blockˉterminator == 1u32 {
            if Blockˉvalue != Wirˉconsumer.Compilerˉsourceˉwirˉsentinel() { return false; }
            if Blockˉsecondˉtarget != Wirˉconsumer.Compilerˉsourceˉwirˉsentinel() { return false; }
            if Blockˉfirstˉtarget >= Range.Blockˉcount ||
                Bytesˉreadˉu32ˉlittle(
                    Directory,
                    Blocksˉoffset +
                        (Range.Firstˉblock + Blockˉfirstˉtarget) * 28u32
                ) != Blockˉfirstˉtarget {
                return false;
            }
        } else {
            if Blockˉterminator == 2u32 {
                if Blockˉvalue >= Range.Temporaryˉcount { return false; }
                let Branchˉshape: u32 = Bytesˉreadˉu32ˉlittle(
                    Directory,
                    Temporariesˉoffset + (Range.Firstˉtemporary + Blockˉvalue) * 4u32
                );
                if Branchˉshape != 4u32 { return false; }
                if Blockˉfirstˉtarget >= Range.Blockˉcount ||
                    Bytesˉreadˉu32ˉlittle(
                        Directory,
                        Blocksˉoffset +
                            (Range.Firstˉblock + Blockˉfirstˉtarget) * 28u32
                    ) != Blockˉfirstˉtarget {
                    return false;
                }
                if Blockˉsecondˉtarget >= Range.Blockˉcount ||
                    Bytesˉreadˉu32ˉlittle(
                        Directory,
                        Blocksˉoffset +
                            (Range.Firstˉblock + Blockˉsecondˉtarget) * 28u32
                    ) != Blockˉsecondˉtarget {
                    return false;
                }
            } else {
                if Blockˉterminator != 3u32 { return false; }
                if Blockˉfirstˉtarget != Wirˉconsumer.Compilerˉsourceˉwirˉsentinel() { return false; }
                if Blockˉsecondˉtarget != Wirˉconsumer.Compilerˉsourceˉwirˉsentinel() { return false; }
                if Range.Returnˉshape == 0u32 {
                    if Blockˉvalue != Wirˉconsumer.Compilerˉsourceˉwirˉsentinel() { return false; }
                } else {
                    if Blockˉvalue >= Range.Temporaryˉcount { return false; }
                    let Returnˉvalueˉshape: u32 = Bytesˉreadˉu32ˉlittle(
                        Directory,
                        Temporariesˉoffset + (Range.Firstˉtemporary + Blockˉvalue) * 4u32
                    );
                    if Returnˉvalueˉshape != Range.Returnˉshape { return false; }
                }
            }
        }
        Blockˉindex = Blockˉindex + 1u32;
    }
    if !Foundˉentry { return false; }
    return Coveredˉoperations == Range.Operationˉcount;
}

export fn Compilerˉsourceˉwirˉnominalˉdirectoryˉentry(
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Nominal: u32,
    Kind: u32
) -> u32 {
    if Nominal >= Symbols.Records + Symbols.Enums + Symbols.Variants {
        return Wirˉconsumer.Compilerˉsourceˉwirˉsentinel();
    }
    let Symbolˉentries: u32 = Bytesˉreadˉu32ˉlittle(Symbols.Directory, 8u32);
    let Symbolˉindex: u32 = Bytesˉreadˉu32ˉlittle(
        Symbols.Lookup, 4112u32 + Symbolˉentries * 4u32 + Nominal * 4u32
    );
    let Symbolˉentry: u32 = 16u32 + Symbolˉindex * 24u32;
    if Bytesˉreadˉu32ˉlittle(Symbols.Directory, Symbolˉentry + 4u32) != Kind {
        return Wirˉconsumer.Compilerˉsourceˉwirˉsentinel();
    }
    return Symbolˉindex;
}

fn Compilerˉsourceˉwirˉvariantˉcaseˉviewˉbyˉindex(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Typeˉcatalog: Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog,
    Nominal: u32,
    Case: u32
) -> Compilerˉsourceˉwirˉvariantˉcaseˉview {
    let Missing: Compilerˉsourceˉwirˉvariantˉcaseˉview =
        Compilerˉsourceˉwirˉvariantˉcaseˉview(
            false, Scan.Modules, 0u32, 0u32, 0u32, 1u32, 1u32
        );
    if Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉshapeˉisˉprivate(
            Nominal
        ) {
        let Instance: u32 =
            Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉshapeˉinstance(
                Nominal
            );
        let Layout: Genericˉlayouts.Compilerˉsourceˉgenericˉtypeˉlayout =
            Genericˉlayouts.Compilerˉsourceˉgenericˉtypeˉlayoutˉcreate(
                Input, Scan, Symbols, Typeˉcatalog, Instance
            );
        let Selected: Genericˉlayouts.Compilerˉsourceˉgenericˉtypeˉcase =
            Genericˉlayouts.Compilerˉsourceˉgenericˉtypeˉlayoutˉvariantˉcase(
                Input, Scan, Symbols, Layout, Case
            );
        if Layout.Shape == Nominal && Selected.Found &&
            Selected.Fields <= 64u32 {
            return Compilerˉsourceˉwirˉvariantˉcaseˉview(
                true, Layout.Module, Case, Selected.Fields,
                0u32, 1u32, 1u32
            );
        }
        return Missing;
    }
    let Directoryˉentry: u32 = Compilerˉsourceˉwirˉnominalˉdirectoryˉentry(
        Symbols, Nominal, 8u32
    );
    if Directoryˉentry == Wirˉconsumer.Compilerˉsourceˉwirˉsentinel() { return Missing; }
    let Variant: Sourceˉsymbols.Compilerˉsourceˉsymbolˉmatch =
        Sourceˉsymbols.Compilerˉsourceˉsymbolsˉdirectoryˉentry(
            Symbols.Directory, Scan.Modules, Directoryˉentry
        );
    let View: Sourceˉset.Compilerˉsourceˉsetˉview =
        Sourceˉset.Compilerˉsourceˉsetˉmodule(Input, Scan, Variant.Module);
    let Declarationˉposition: Sourceˉbodies.Compilerˉsourceˉposition =
        Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
            View.Source, 0u32, 1u32, 1u32, Variant.Declarationˉoffset
        );
    let Declaration: Sourceˉdeclarations.Compilerˉsourceˉdeclaration =
        Sourceˉdeclarations.Compilerˉparseˉnextˉdeclarationˉvalidated(
            View.Source, Variant.Declarationˉoffset,
            Declarationˉposition.Line, Declarationˉposition.Column, true
        );
    if Case >= Declaration.Items { return Missing; }
    let Bodyˉposition: Sourceˉbodies.Compilerˉsourceˉposition =
        Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
            View.Source, Variant.Declarationˉoffset,
            Declarationˉposition.Line, Declarationˉposition.Column,
            Declaration.Bodyˉoffset
        );
    let Left: Sourceˉlexer.Compilerˉsourceˉtoken =
        Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            View.Source, Declaration.Bodyˉoffset,
            Bodyˉposition.Line, Bodyˉposition.Column
        );
    var Cursor: u32 = Left.Nextˉoffset;
    var Line: u32 = Left.Nextˉline;
    var Column: u32 = Left.Nextˉcolumn;
    var Index: u32 = 0u32;
    while Index <= Case {
        let Caseˉname: Sourceˉlexer.Compilerˉsourceˉtoken =
            Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                View.Source, Cursor, Line, Column
            );
        let Afterˉname: Sourceˉlexer.Compilerˉsourceˉtoken =
            Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                View.Source, Caseˉname.Nextˉoffset,
                Caseˉname.Nextˉline, Caseˉname.Nextˉcolumn
            );
        var End: Sourceˉlexer.Compilerˉsourceˉtoken = Afterˉname;
        var Fields: u32 = 0u32;
        var Fieldsˉoffset: u32 = Afterˉname.Offset;
        var Fieldsˉline: u32 = Afterˉname.Line;
        var Fieldsˉcolumn: u32 = Afterˉname.Column;
        if Afterˉname.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Leftˉparenthesis {
            Fieldsˉoffset = Afterˉname.Nextˉoffset;
            Fieldsˉline = Afterˉname.Nextˉline;
            Fieldsˉcolumn = Afterˉname.Nextˉcolumn;
            var Fieldˉcursor: u32 = Fieldsˉoffset;
            var Fieldˉline: u32 = Fieldsˉline;
            var Fieldˉcolumn: u32 = Fieldsˉcolumn;
            var Readingˉfields: bool = true;
            while Readingˉfields {
                let Field: Sourceˉdeclarations.Compilerˉsourceˉvariantˉfield =
                    Sourceˉdeclarations.Compilerˉparseˉvariantˉfield(
                        View.Source, Fieldˉcursor, Fieldˉline, Fieldˉcolumn
                    );
                Fields = Fields + 1u32;
                let Separator: Sourceˉlexer.Compilerˉsourceˉtoken =
                    Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                        View.Source, Field.Nextˉoffset,
                        Field.Nextˉline, Field.Nextˉcolumn
                    );
                if Separator.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Comma {
                    let Viewˉafterˉcomma:
                        Sourceˉlexer.Compilerˉsourceˉtoken =
                        Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                            View.Source, Separator.Nextˉoffset,
                            Separator.Nextˉline, Separator.Nextˉcolumn
                        );
                    if Viewˉafterˉcomma.Kind ==
                        Sourceˉlexer.Compilerˉtokenˉkind.Rightˉparenthesis {
                        Readingˉfields = false;
                        End = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                            View.Source, Viewˉafterˉcomma.Nextˉoffset,
                            Viewˉafterˉcomma.Nextˉline,
                            Viewˉafterˉcomma.Nextˉcolumn
                        );
                    } else {
                        Fieldˉcursor = Separator.Nextˉoffset;
                        Fieldˉline = Separator.Nextˉline;
                        Fieldˉcolumn = Separator.Nextˉcolumn;
                    }
                } else {
                    Readingˉfields = false;
                    End = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                        View.Source, Separator.Nextˉoffset,
                        Separator.Nextˉline, Separator.Nextˉcolumn
                    );
                }
            }
        }
        if Index == Case {
            return Compilerˉsourceˉwirˉvariantˉcaseˉview(
                true, Variant.Module, Index, Fields,
                Fieldsˉoffset, Fieldsˉline, Fieldsˉcolumn
            );
        }
        Cursor = End.Nextˉoffset;
        Line = End.Nextˉline;
        Column = End.Nextˉcolumn;
        Index = Index + 1u32;
    }
    return Missing;
}

fn Compilerˉsourceˉwirˉvariantˉfieldˉbyˉindex(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Typeˉcatalog: Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog,
    Nominal: u32,
    Case: u32,
    Fieldˉindex: u32
) -> Compilerˉsourceˉwirˉmember {
    if Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉshapeˉisˉprivate(
            Nominal
        ) {
        let Instance: u32 =
            Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉshapeˉinstance(
                Nominal
            );
        let Layout: Genericˉlayouts.Compilerˉsourceˉgenericˉtypeˉlayout =
            Genericˉlayouts.Compilerˉsourceˉgenericˉtypeˉlayoutˉcreate(
                Input, Scan, Symbols, Typeˉcatalog, Instance
            );
        let Selected: Genericˉlayouts.Compilerˉsourceˉgenericˉtypeˉfield =
            Genericˉlayouts.Compilerˉsourceˉgenericˉtypeˉlayoutˉvariantˉfield(
                Input, Scan, Symbols, Layout, Case, Fieldˉindex
            );
        if Layout.Shape != Nominal || !Selected.Found {
            return Compilerˉsourceˉwirˉmember(false, 0u32, 0u32);
        }
        return Compilerˉsourceˉwirˉmember(
            true, Fieldˉindex, Selected.Shape
        );
    }
    let Caseˉview: Compilerˉsourceˉwirˉvariantˉcaseˉview =
        Compilerˉsourceˉwirˉvariantˉcaseˉviewˉbyˉindex(
            Input, Scan, Symbols, Typeˉcatalog, Nominal, Case
        );
    if !Caseˉview.Found || Fieldˉindex >= Caseˉview.Fields {
        return Compilerˉsourceˉwirˉmember(false, 0u32, 0u32);
    }
    let View: Sourceˉset.Compilerˉsourceˉsetˉview =
        Sourceˉset.Compilerˉsourceˉsetˉmodule(
            Input, Scan, Caseˉview.Module
        );
    var Cursor: u32 = Caseˉview.Fieldsˉoffset;
    var Line: u32 = Caseˉview.Fieldsˉline;
    var Column: u32 = Caseˉview.Fieldsˉcolumn;
    var Index: u32 = 0u32;
    while Index <= Fieldˉindex {
        let Field: Sourceˉdeclarations.Compilerˉsourceˉvariantˉfield =
            Sourceˉdeclarations.Compilerˉparseˉvariantˉfield(
                View.Source, Cursor, Line, Column
            );
        if Index == Fieldˉindex {
            let Typeˉposition: Sourceˉbodies.Compilerˉsourceˉposition =
                Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
                    View.Source, Cursor, Line, Column, Field.Typeˉoffset
                );
            let Type: Sourceˉsymbols.Compilerˉsourceˉtypeˉbinding =
                Sourceˉsymbols.Compilerˉsourceˉsymbolsˉbindˉtype(
                    Input, Scan, Symbols.Directory, Symbols.Lookup,
                    Symbols.Visibility, Caseˉview.Module, View.Source,
                    Field.Typeˉoffset, Typeˉposition.Line,
                    Typeˉposition.Column, Symbols.Records,
                    Symbols.Enums, false
                );
            return Compilerˉsourceˉwirˉmember(
                true, Index,
                Sourceˉbindings.Compilerˉsourceˉbindingsˉshape(Type)
            );
        }
        let Separator: Sourceˉlexer.Compilerˉsourceˉtoken =
            Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                View.Source, Field.Nextˉoffset,
                Field.Nextˉline, Field.Nextˉcolumn
            );
        Cursor = Separator.Nextˉoffset;
        Line = Separator.Nextˉline;
        Column = Separator.Nextˉcolumn;
        Index = Index + 1u32;
    }
    return Compilerˉsourceˉwirˉmember(false, 0u32, 0u32);
}

export fn Compilerˉsourceˉwirˉdynamicˉoperandˉshape(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Bindings: Sourceˉbindings.Compilerˉsourceˉbindingˉsummary,
    Functionˉtypeˉcatalog:
        Compilerˉsourceˉwirˉfunctionˉtypeˉcatalog,
    Operation: u32,
    Target: u32,
    Auxiliary: u32,
    Index: u32
) -> u32 {
    let Symbolˉentries: u32 = Bytesˉreadˉu32ˉlittle(Symbols.Directory, 8u32);
    let Typeˉcatalog: Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog =
        Genericˉbindings.Compilerˉsourceˉbindingsˉgenericˉtypesˉtypeˉcatalog(
            Bindings.Directory
        );
    if Operation == WIR_OPERATION_CALL_INDIRECT {
        if Target >=
                Compilerˉsourceˉwirˉfunctionˉtypeˉcatalogˉinstances(
                    Functionˉtypeˉcatalog
                ) {
            return 0u32;
        }
        let Functionˉtypeˉcursor: u32 =
            Compilerˉsourceˉwirˉfunctionˉtypeˉentryˉcursor(
                Functionˉtypeˉcatalog, Target
            );
        if Index == 0u32 {
            return WIR_FUNCTION_TYPE_SHAPE_BASE + Target;
        }
        if Index - 1u32 >= Bytesˉreadˉu32ˉlittle(
                Functionˉtypeˉcatalog.Evidence,
                Functionˉtypeˉcursor + 8u32
            ) {
            return 0u32;
        }
        return Bytesˉreadˉu32ˉlittle(
            Functionˉtypeˉcatalog.Evidence,
            Functionˉtypeˉcursor + WIR_FUNCTION_TYPE_ENTRY_BYTES +
                (Index - 1u32) * 4u32
        );
    }
    if Operation == 17u32 {
        if Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉshapeˉisˉprivate(
                Target
            ) {
            let Instance: u32 =
                Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉshapeˉinstance(
                    Target
                );
            let Layout: Genericˉlayouts.Compilerˉsourceˉgenericˉtypeˉlayout =
                Genericˉlayouts.Compilerˉsourceˉgenericˉtypeˉlayoutˉcreate(
                    Input, Scan, Symbols, Typeˉcatalog, Instance
                );
            if Layout.Kind !=
                    Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Record ||
                Layout.Declaration != Auxiliary || Index >= Layout.Fields ||
                Bytesˉlength(Layout.Fieldˉevidence) != Layout.Fields * 16u32 ||
                !Genericˉlayouts.Compilerˉsourceˉgenericˉtypeˉlayoutˉisˉvalid(
                    Input, Scan, Symbols, Layout
                ) {
                return 0u32;
            }
            return Bytesˉreadˉu32ˉlittle(
                Layout.Fieldˉevidence, Index * 16u32 + 8u32
            );
        }
        if Auxiliary >= Symbolˉentries { return 0u32; }
        let Recordˉentry: u32 = 16u32 + Auxiliary * 24u32;
        if Bytesˉreadˉu32ˉlittle(Symbols.Directory, Recordˉentry + 4u32) != 4u32 {
            return 0u32;
        }
        let Recordˉmodule: u32 = Bytesˉreadˉu32ˉlittle(Symbols.Directory, Recordˉentry);
        let Recordˉitems: u32 = Bytesˉreadˉu32ˉlittle(Symbols.Directory, Recordˉentry + 20u32);
        let Recordˉcallable: Sourceˉbindings.Compilerˉsourceˉbindingˉmatch = Sourceˉbindings.Compilerˉsourceˉbindingˉmatch(
            true, true, Sourceˉbindings.Compilerˉsourceˉcallableˉkind.Record,
            Recordˉmodule, Recordˉitems, Auxiliary
        );
        let Recordˉsignature: Compilerˉsourceˉwirˉsignature = Compilerˉsourceˉwirˉrecordˉsignature(
            Input, Scan, Symbols, Recordˉcallable, Index
        );
        if Recordˉsignature.Target != Target { return 0u32; }
        return Recordˉsignature.Parameterˉshape;
    }
    if Operation == 65u32 {
        let Variantˉfield: Compilerˉsourceˉwirˉmember =
            Compilerˉsourceˉwirˉvariantˉfieldˉbyˉindex(
                Input, Scan, Symbols, Typeˉcatalog,
                Target, Auxiliary, Index
            );
        if !Variantˉfield.Found { return 0u32; }
        return Variantˉfield.Shape;
    }
    if Operation == 165u32 {
        return Compilerˉsourceˉwirˉfixedˉarrayˉelementˉshape(
            Target, Typeˉcatalog
        );
    }
    if Operation == 166u32 {
        if Index == 0u32 { return Target; }
        return 8u32;
    }
    if Operation == 173u32 {
        if Index != 0u32 ||
            !Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalogˉshapeˉisˉkind(
                Typeˉcatalog, Auxiliary, 11u32
            ) {
            return 0u32;
        }
        return Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalogˉshapeˉtypeˉargument(
                Typeˉcatalog, Auxiliary, 0u32
            );
    }
    if Operation == 62u32 {
        if Target >= Sourceˉbindings.Compilerˉsourceˉbindingsˉrangesˉcount(
            Bindings.Directory
        ) { return 0u32; }
        let Declaration: u32 =
            Sourceˉbindings.Compilerˉsourceˉbindingsˉrangeˉdeclaration(
                Bindings.Directory, Target
            );
        if Declaration >= Symbolˉentries { return 0u32; }
        let Functionˉentry: u32 = 16u32 + Declaration * 24u32;
        if Bytesˉreadˉu32ˉlittle(Symbols.Directory, Functionˉentry + 4u32) != 6u32 {
            return 0u32;
        }
        return Wirˉconsumer.Compilerˉsourceˉwirˉbindingˉshape(
            Bindings, Symbolˉentries, Target, Index
        );
    }
    if Target >= Symbolˉentries { return 0u32; }
    let Targetˉentry: u32 = 16u32 + Target * 24u32;
    let Targetˉmodule: u32 = Bytesˉreadˉu32ˉlittle(Symbols.Directory, Targetˉentry);
    let Targetˉkind: u32 = Bytesˉreadˉu32ˉlittle(Symbols.Directory, Targetˉentry + 4u32);
    let Targetˉdeclarationˉoffset: u32 = Bytesˉreadˉu32ˉlittle(
        Symbols.Directory, Targetˉentry + 8u32
    );
    let Targetˉnameˉoffset: u32 = Bytesˉreadˉu32ˉlittle(
        Symbols.Directory, Targetˉentry + 12u32
    );
    let Targetˉnameˉlength: u32 = Bytesˉreadˉu32ˉlittle(
        Symbols.Directory, Targetˉentry + 16u32
    );
    let Targetˉview: Sourceˉset.Compilerˉsourceˉsetˉview = Sourceˉset.Compilerˉsourceˉsetˉmodule(
        Input, Scan, Targetˉmodule
    );
    if Operation == 63u32 {
        if Targetˉkind != 2u32 { return 0u32; }
        return Wirˉconsumer.Compilerˉsourceˉwirˉcapabilityˉparameterˉshape(
            Targetˉview.Source, Targetˉnameˉoffset, Targetˉnameˉlength, Index
        );
    }
    return 0u32;
}

fn Compilerˉsourceˉwirˉfunctionˉreferenceˉisˉvalid(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Bindings: Sourceˉbindings.Compilerˉsourceˉbindingˉsummary,
    Directory: bytes,
    Functionˉtypeˉcatalog:
        Compilerˉsourceˉwirˉfunctionˉtypeˉcatalog,
    Shape: u32,
    Target: u32,
    Auxiliary: u32
) -> bool {
    var Instance: u32 = Wirˉconsumer.Compilerˉsourceˉwirˉsentinel();
    if Shape >= WIR_FUNCTION_TYPE_SHAPE_BASE &&
        Shape < WIR_FUNCTION_TYPE_SHAPE_BASE +
            WIR_FUNCTION_TYPE_INSTANCE_LIMIT {
        Instance = Shape - WIR_FUNCTION_TYPE_SHAPE_BASE;
    }
    let Instances: u32 =
        Compilerˉsourceˉwirˉfunctionˉtypeˉcatalogˉinstances(
            Functionˉtypeˉcatalog
        );
    let Symbolˉentries: u32 = Bytesˉreadˉu32ˉlittle(
        Symbols.Directory, 8u32
    );
    if Instance >= Instances || Auxiliary != Instance ||
        Target >= Symbolˉentries ||
        Target >= Bytesˉreadˉu32ˉlittle(Directory, 8u32) {
        return false;
    }
    let Functionˉtypeˉcursor: u32 =
        Compilerˉsourceˉwirˉfunctionˉtypeˉentryˉcursor(
            Functionˉtypeˉcatalog, Instance
        );
    let Symbolˉentry: u32 = 16u32 + Target * 24u32;
    if Bytesˉreadˉu32ˉlittle(
            Symbols.Directory, Symbolˉentry + 4u32
        ) != 6u32 ||
        Sourceˉbindings.Compilerˉsourceˉbindingsˉrangeˉdeclaration(
            Bindings.Directory, Target
        ) != Target {
        return false;
    }
    let Module: u32 = Bytesˉreadˉu32ˉlittle(
        Symbols.Directory, Symbolˉentry
    );
    let Declarationˉoffset: u32 = Bytesˉreadˉu32ˉlittle(
        Symbols.Directory, Symbolˉentry + 8u32
    );
    let View: Sourceˉset.Compilerˉsourceˉsetˉview =
        Sourceˉset.Compilerˉsourceˉsetˉmodule(Input, Scan, Module);
    let Declaration: Sourceˉdeclarations.Compilerˉsourceˉdeclaration =
        Sourceˉdeclarations.Compilerˉparseˉnextˉdeclarationˉvalidated(
            View.Source, Declarationˉoffset, 1u32, 1u32, true
        );
    let Generic: Sourceˉsymbols.Compilerˉsourceˉfunctionˉgeneric =
        Sourceˉsymbols.Compilerˉsourceˉsymbolsˉfunctionˉgeneric(
            View.Source, Declaration, 1u32, 1u32
        );
    let Header: Sourceˉdeclarations.Compilerˉsourceˉheader =
        Sourceˉdeclarations.Compilerˉparseˉheaderˉvalidated(View.Source);
    var Headerˉprofile: u32 = 0u32;
    if Header.Profile ==
            Sourceˉdeclarations.Compilerˉsourceˉprofile.Portable {
        Headerˉprofile = 1u32;
    }
    if Header.Profile ==
            Sourceˉdeclarations.Compilerˉsourceˉprofile.Hosted {
        Headerˉprofile = 2u32;
    }
    if Header.Profile ==
            Sourceˉdeclarations.Compilerˉsourceˉprofile.System {
        Headerˉprofile = 3u32;
    }
    var Referenceˉtoken: Sourceˉlexer.Compilerˉsourceˉtoken =
        Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            View.Source, Declaration.Declarationˉoffset, 1u32, 1u32
        );
    if Referenceˉtoken.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Export {
        Referenceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            View.Source, Referenceˉtoken.Nextˉoffset,
            Referenceˉtoken.Nextˉline, Referenceˉtoken.Nextˉcolumn
        );
    }
    var Functionˉflags: u32 = 0u32;
    if Referenceˉtoken.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Unsafe {
        Functionˉflags = Functionˉflags | 2u32;
        Referenceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            View.Source, Referenceˉtoken.Nextˉoffset,
            Referenceˉtoken.Nextˉline, Referenceˉtoken.Nextˉcolumn
        );
    }
    if Referenceˉtoken.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Async {
        Functionˉflags = Functionˉflags | 1u32;
    }
    if Declaration.Status != Sourceˉdeclarations.Compilerˉparseˉstatus.Valid ||
        Generic.Parameters != 0u32 || !Declaration.Hasˉeffectˉclause ||
        Declaration.Effects != 0u32 ||
        Functionˉflags != 0u32 ||
        Bytesˉreadˉu32ˉlittle(
            Functionˉtypeˉcatalog.Evidence, Functionˉtypeˉcursor
        ) != Headerˉprofile {
        return false;
    }
    let Parameters: u32 = Bytesˉreadˉu32ˉlittle(
        Symbols.Directory, Symbolˉentry + 20u32
    );
    if Parameters != Bytesˉreadˉu32ˉlittle(
            Functionˉtypeˉcatalog.Evidence,
            Functionˉtypeˉcursor + 8u32
        ) {
        return false;
    }
    let Genericˉcatalog: Sourceˉgenerics.Compilerˉsourceˉgenericˉcatalog =
        Genericˉbindings.Compilerˉsourceˉbindingsˉgenericˉtypesˉfunctionˉcatalog(
            Bindings.Directory
        );
    let Typeˉcatalog: Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog =
        Genericˉbindings.Compilerˉsourceˉbindingsˉgenericˉtypesˉtypeˉcatalog(
            Bindings.Directory
        );
    var Parameter: u32 = 0u32;
    var Returnˉshape: u32 = 0u32;
    while Parameter < Parameters {
        let Signature: Compilerˉsourceˉwirˉsignature =
            Compilerˉsourceˉwirˉfunctionˉsignatureˉconcrete(
                Input, Scan, Symbols, Module, View.Source,
                Declarationˉoffset, Parameter,
                Genericˉcatalog, Typeˉcatalog,
                Wirˉconsumer.Compilerˉsourceˉwirˉsentinel()
            );
        if Signature.Parameterˉshape != Bytesˉreadˉu32ˉlittle(
                Functionˉtypeˉcatalog.Evidence,
                Functionˉtypeˉcursor + WIR_FUNCTION_TYPE_ENTRY_BYTES +
                    Parameter * 4u32
            ) ||
            Signature.Parameterˉmode != 0u32 {
            return false;
        }
        Returnˉshape = Signature.Returnˉshape;
        Parameter = Parameter + 1u32;
    }
    if Parameters == 0u32 {
        let Emptyˉsignature: Compilerˉsourceˉwirˉsignature =
            Compilerˉsourceˉwirˉfunctionˉsignatureˉconcrete(
                Input, Scan, Symbols, Module, View.Source,
                Declarationˉoffset, Wirˉconsumer.Compilerˉsourceˉwirˉsentinel(),
                Genericˉcatalog, Typeˉcatalog,
                Wirˉconsumer.Compilerˉsourceˉwirˉsentinel()
            );
        Returnˉshape = Emptyˉsignature.Returnˉshape;
    }
    let Functionˉentry: u32 =
        Wirˉconsumer.Compilerˉsourceˉwirˉfunctionsˉoffset(Directory) + Target * 48u32;
    return Returnˉshape != 0u32 && Returnˉshape != 10u32 &&
        Returnˉshape != 15u32 &&
        Returnˉshape == Bytesˉreadˉu32ˉlittle(
            Functionˉtypeˉcatalog.Evidence,
            Functionˉtypeˉcursor + 4u32
        ) &&
        Returnˉshape == Bytesˉreadˉu32ˉlittle(
            Directory, Functionˉentry + 44u32
        );
}

export fn Compilerˉsourceˉwirˉdynamicˉresultˉisˉvalid(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Bindings: Sourceˉbindings.Compilerˉsourceˉbindingˉsummary,
    Directory: bytes,
    Functionˉtypeˉcatalog:
        Compilerˉsourceˉwirˉfunctionˉtypeˉcatalog,
    Operation: u32,
    Shape: u32,
    Operandˉcount: u32,
    Target: u32,
    Auxiliary: u32
) -> bool {
    let Symbolˉentries: u32 = Bytesˉreadˉu32ˉlittle(Symbols.Directory, 8u32);
    let Typeˉcatalog: Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog =
        Genericˉbindings.Compilerˉsourceˉbindingsˉgenericˉtypesˉtypeˉcatalog(
            Bindings.Directory
        );
    if Operation == WIR_OPERATION_FUNCTION_REFERENCE {
        return Operandˉcount == 0u32 &&
            Compilerˉsourceˉwirˉfunctionˉreferenceˉisˉvalid(
                Input, Scan, Symbols, Bindings, Directory,
                Functionˉtypeˉcatalog, Shape, Target, Auxiliary
            );
    }
    if Operation == WIR_OPERATION_CALL_INDIRECT {
        if Target >=
                Compilerˉsourceˉwirˉfunctionˉtypeˉcatalogˉinstances(
                    Functionˉtypeˉcatalog
                ) || Auxiliary != 0u32 {
            return false;
        }
        let Functionˉtypeˉcursor: u32 =
            Compilerˉsourceˉwirˉfunctionˉtypeˉentryˉcursor(
                Functionˉtypeˉcatalog, Target
            );
        return Operandˉcount == 1u32 + Bytesˉreadˉu32ˉlittle(
                Functionˉtypeˉcatalog.Evidence,
                Functionˉtypeˉcursor + 8u32
            ) &&
            Shape == Bytesˉreadˉu32ˉlittle(
                Functionˉtypeˉcatalog.Evidence,
                Functionˉtypeˉcursor + 4u32
            );
    }
    if Operation == 174u32 {
        return Shape == 0u32 && Operandˉcount == 0u32 && Auxiliary == 0u32;
    }
    if Operation == 171u32 {
        if Operandˉcount != 2u32 || Auxiliary >= Scan.Modules {
            return false;
        }
        let Resultˉlayout: Compilerˉsourceˉwirˉmember =
            Compilerˉsourceˉwirˉgenericˉfoundationˉresultˉlayout(
                Input, Scan, Symbols, Typeˉcatalog, Shape
            );
        return Resultˉlayout.Found &&
            Resultˉlayout.Index == 805306368u32 &&
            Compilerˉsourceˉwirˉisˉfoundationˉallocationˉfailure(
                Input, Scan, Symbols, Resultˉlayout.Shape, Auxiliary
            );
    }
    if Operation == 172u32 {
        if Operandˉcount != 1u32 || Auxiliary >= Scan.Modules {
            return false;
        }
        let Vectorˉresultˉlayout: Compilerˉsourceˉwirˉmember =
            Compilerˉsourceˉwirˉgenericˉfoundationˉresultˉlayout(
                Input, Scan, Symbols, Typeˉcatalog, Shape
        );
        if !Vectorˉresultˉlayout.Found ||
            !Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalogˉshapeˉisˉkind(
                Typeˉcatalog, Vectorˉresultˉlayout.Index, 11u32
            ) ||
            !Compilerˉsourceˉwirˉisˉfoundationˉallocationˉfailure(
                Input, Scan, Symbols, Vectorˉresultˉlayout.Shape, Auxiliary
            ) {
            return false;
        }
        let Vectorˉresultˉelement: u32 =
            Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalogˉshapeˉtypeˉargument(
                Typeˉcatalog, Vectorˉresultˉlayout.Index, 0u32
            );
        return Vectorˉresultˉelement == 1u32 ||
            Vectorˉresultˉelement == 2u32 ||
            Vectorˉresultˉelement == 3u32 ||
            Vectorˉresultˉelement == 4u32 ||
            Vectorˉresultˉelement == 7u32 ||
            Vectorˉresultˉelement == 8u32 ||
            (Vectorˉresultˉelement >= 11u32 &&
                Vectorˉresultˉelement <= 16u32) ||
            (Vectorˉresultˉelement >= 131072u32 + Symbols.Records &&
                Vectorˉresultˉelement <
                    131072u32 + Symbols.Records + Symbols.Enums);
    }
    if Operation == WIR_OPERATION_FOUNDATION_VECTOR_GROW_RESERVED {
        if Operandˉcount != 1u32 { return false; }
        let Growˉresultˉlayout: Compilerˉsourceˉwirˉmember =
            Compilerˉsourceˉwirˉgenericˉfoundationˉresultˉlayout(
                Input, Scan, Symbols, Typeˉcatalog, Shape
            );
        if !Growˉresultˉlayout.Found ||
            Growˉresultˉlayout.Index != 9u32 {
            return false;
        }
        let Growˉfailure:
            Sourceˉsymbols.Compilerˉsourceˉsymbolˉmatch =
            Compilerˉsourceˉwirˉnominalˉbyˉshape(
                Input, Scan, Symbols, Growˉresultˉlayout.Shape
            );
        return Growˉfailure.Found &&
            Compilerˉsourceˉwirˉisˉfoundationˉallocationˉfailure(
                Input, Scan, Symbols,
                Growˉresultˉlayout.Shape, Growˉfailure.Module
            );
    }
    if Operation == 173u32 {
        if Operandˉcount != 1u32 ||
            !Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalogˉshapeˉisˉkind(
                Typeˉcatalog, Auxiliary, 11u32
            ) {
            return false;
        }
        let Appendˉvectorˉelement: u32 =
            Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalogˉshapeˉtypeˉargument(
                    Typeˉcatalog, Auxiliary, 0u32
                );
        if !(Appendˉvectorˉelement == 1u32 ||
            Appendˉvectorˉelement == 2u32 ||
            Appendˉvectorˉelement == 3u32 ||
            Appendˉvectorˉelement == 4u32 ||
            Appendˉvectorˉelement == 7u32 ||
            Appendˉvectorˉelement == 8u32 ||
            (Appendˉvectorˉelement >= 11u32 &&
                Appendˉvectorˉelement <= 16u32) ||
            (Appendˉvectorˉelement >= 131072u32 + Symbols.Records &&
                Appendˉvectorˉelement <
                    131072u32 + Symbols.Records + Symbols.Enums)) {
            return false;
        }
        let Appendˉresultˉlayout: Compilerˉsourceˉwirˉmember =
            Compilerˉsourceˉwirˉgenericˉfoundationˉresultˉlayout(
                Input, Scan, Symbols, Typeˉcatalog, Shape
            );
        if !Appendˉresultˉlayout.Found ||
            Appendˉresultˉlayout.Index != 9u32 {
            return false;
        }
        return Compilerˉsourceˉwirˉvectorˉappendˉfailureˉelement(
                Input, Scan, Symbols, Typeˉcatalog,
                Appendˉresultˉlayout.Shape
            ) == Appendˉvectorˉelement;
    }
    if Operation == 169u32 || Operation == 170u32 {
        if Operandˉcount != 0u32 ||
            !Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalogˉshapeˉisˉkind(
                Typeˉcatalog, Auxiliary, 11u32
            ) {
            return false;
        }
        let Vectorˉelement: u32 =
            Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalogˉshapeˉtypeˉargument(
                    Typeˉcatalog, Auxiliary, 0u32
                );
        if !(Vectorˉelement == 1u32 || Vectorˉelement == 2u32 ||
            Vectorˉelement == 3u32 || Vectorˉelement == 4u32 ||
            Vectorˉelement == 7u32 || Vectorˉelement == 8u32 ||
            (Vectorˉelement >= 11u32 && Vectorˉelement <= 16u32) ||
            (Vectorˉelement >= 131072u32 + Symbols.Records &&
                Vectorˉelement <
                    131072u32 + Symbols.Records + Symbols.Enums)) {
            return false;
        }
        if Operation == 169u32 { return Shape == 8u32; }
        return Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalogˉshapeˉisˉkind(
                Typeˉcatalog, Shape, 12u32
            ) &&
            Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalogˉshapeˉtypeˉargument(
                    Typeˉcatalog, Shape, 0u32
                ) == Vectorˉelement;
    }
    if Operation == 167u32 || Operation == 168u32 {
        if Auxiliary != 0u32 ||
            !Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalogˉshapeˉisˉkind(
                Typeˉcatalog, Target, 12u32
            ) {
            return false;
        }
        let Element: u32 =
            Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalogˉshapeˉtypeˉargument(
                    Typeˉcatalog, Target, 0u32
                );
        if !(Element == 1u32 || Element == 2u32 || Element == 3u32 ||
            Element == 4u32 || Element == 7u32 || Element == 8u32 ||
            (Element >= 11u32 && Element <= 16u32) ||
            (Element >= 131072u32 + Symbols.Records &&
                Element < 131072u32 + Symbols.Records + Symbols.Enums)) {
            return false;
        }
        if Operation == 167u32 {
            return Operandˉcount == 1u32 && Shape == 8u32;
        }
        return Operandˉcount == 2u32 && Shape == Element;
    }
    if Operation == 68u32 {
        if !Wirˉconsumer.Compilerˉsourceˉwirˉshapeˉisˉbuilder(Shape) { return false; }
        if Operandˉcount != 0u32 { return false; }
        let Compactˉelement: u32 = Bytesˉreadˉu16ˉlittle(
            Bytesˉfromˉu32ˉlittle(Shape), 0u32
        );
        var Expectedˉdescriptor: u32 = Compactˉelement;
        if Compactˉelement >= 4096u32 && Compactˉelement < 8192u32 {
            Expectedˉdescriptor =
                1073741824u32 + Compactˉelement - 4096u32;
        }
        if Compactˉelement >= 8192u32 && Compactˉelement < 12288u32 {
            Expectedˉdescriptor =
                2147483648u32 + Compactˉelement - 8192u32;
        }
        if Compactˉelement >= 12288u32 {
            Expectedˉdescriptor =
                3221225472u32 + Compactˉelement - 12288u32;
        }
        if Target != Expectedˉdescriptor { return false; }
        if Auxiliary != Wirˉconsumer.Compilerˉsourceˉwirˉcollectionˉmaximum(Shape) { return false; }
        return Auxiliary > 0u32;
    }
    if Operation == 165u32 {
        if Shape != Target || Auxiliary != 0u32 ||
            !Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalogˉshapeˉisˉkind(
                Typeˉcatalog, Shape, 10u32
            ) {
            return false;
        }
        let Arrayˉinstance: u32 =
            Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉshapeˉinstance(Shape);
        let Arrayˉcount: Sourceˉgenerics.Compilerˉsourceˉgenericˉargument =
            Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalogˉargument(
                Typeˉcatalog, Arrayˉinstance, 1u32
            );
        return Arrayˉcount.Valid && Arrayˉcount.Kind == 2u32 &&
            Arrayˉcount.Shape == 8u32 && Arrayˉcount.High == 0u32 &&
            Arrayˉcount.Low <= 4095u32 && Operandˉcount == Arrayˉcount.Low;
    }
    if Operation == 166u32 {
        if Auxiliary != 0u32 || Operandˉcount != 2u32 ||
            !Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalogˉshapeˉisˉkind(
                Typeˉcatalog, Target, 10u32
            ) {
            return false;
        }
        return Shape == Compilerˉsourceˉwirˉfixedˉarrayˉelementˉshape(
            Target, Typeˉcatalog
        );
    }
    if Operation == 17u32 {
        if Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉshapeˉisˉprivate(
                Shape
            ) {
            if Target != Shape { return false; }
            let Instance: u32 =
                Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉshapeˉinstance(
                    Shape
                );
            let Layout: Genericˉlayouts.Compilerˉsourceˉgenericˉtypeˉlayout =
                Genericˉlayouts.Compilerˉsourceˉgenericˉtypeˉlayoutˉcreate(
                    Input, Scan, Symbols, Typeˉcatalog, Instance
                );
            return Layout.Shape == Shape && Layout.Declaration == Auxiliary &&
                Layout.Kind ==
                    Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Record &&
                Layout.Fields == Operandˉcount &&
                Genericˉlayouts.Compilerˉsourceˉgenericˉtypeˉlayoutˉisˉvalid(
                    Input, Scan, Symbols, Layout
                );
        }
        if Shape < 65536u32 { return false; }
        if Shape >= 131072u32 { return false; }
        if Target != Shape - 65536u32 { return false; }
        if Auxiliary >= Symbolˉentries { return false; }
        let Recordˉentry: u32 = 16u32 + Auxiliary * 24u32;
        if Bytesˉreadˉu32ˉlittle(Symbols.Directory, Recordˉentry + 4u32) != 4u32 {
            return false;
        }
        if Bytesˉreadˉu32ˉlittle(Symbols.Directory, Recordˉentry + 20u32) != Operandˉcount {
            return false;
        }
        return Compilerˉsourceˉwirˉnominalˉdirectoryˉentry(
            Symbols, Target, 4u32
        ) == Auxiliary;
    }
    if Operation == 18u32 {
        if Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉshapeˉisˉprivate(
                Target
            ) {
            let Operandˉinstance: u32 =
                Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉshapeˉinstance(
                    Target
                );
            let Operandˉlayout: Genericˉlayouts.Compilerˉsourceˉgenericˉtypeˉlayout =
                Genericˉlayouts.Compilerˉsourceˉgenericˉtypeˉlayoutˉcreate(
                    Input, Scan, Symbols, Typeˉcatalog, Operandˉinstance
                );
            if Operandˉlayout.Shape != Target || Operandˉlayout.Kind !=
                    Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Record ||
                Auxiliary >= Operandˉlayout.Fields ||
                Bytesˉlength(Operandˉlayout.Fieldˉevidence) != Operandˉlayout.Fields * 16u32 ||
                !Genericˉlayouts.Compilerˉsourceˉgenericˉtypeˉlayoutˉisˉvalid(
                    Input, Scan, Symbols, Operandˉlayout
                ) {
                return false;
            }
            return Shape == Bytesˉreadˉu32ˉlittle(
                Operandˉlayout.Fieldˉevidence, Auxiliary * 16u32 + 8u32
            );
        }
        if Target >= Symbols.Records { return false; }
        let Fieldˉrecordˉentry: u32 = Compilerˉsourceˉwirˉnominalˉdirectoryˉentry(
            Symbols, Target, 4u32
        );
        if Fieldˉrecordˉentry == Wirˉconsumer.Compilerˉsourceˉwirˉsentinel() { return false; }
        let Fieldˉsymbolˉentry: u32 = 16u32 + Fieldˉrecordˉentry * 24u32;
        let Fieldˉcount: u32 = Bytesˉreadˉu32ˉlittle(
            Symbols.Directory, Fieldˉsymbolˉentry + 20u32
        );
        if Auxiliary >= Fieldˉcount { return false; }
        let Fieldˉmodule: u32 = Bytesˉreadˉu32ˉlittle(Symbols.Directory, Fieldˉsymbolˉentry);
        let Fieldˉcallable: Sourceˉbindings.Compilerˉsourceˉbindingˉmatch = Sourceˉbindings.Compilerˉsourceˉbindingˉmatch(
            true, true, Sourceˉbindings.Compilerˉsourceˉcallableˉkind.Record,
            Fieldˉmodule, Fieldˉcount, Fieldˉrecordˉentry
        );
        let Fieldˉsignature: Compilerˉsourceˉwirˉsignature = Compilerˉsourceˉwirˉrecordˉsignature(
            Input, Scan, Symbols, Fieldˉcallable, Auxiliary
        );
        return Shape == Fieldˉsignature.Parameterˉshape;
    }
    if Operation == 19u32 {
        if Shape < 131072u32 + Symbols.Records { return false; }
        if Shape >= 131072u32 + Symbols.Records + Symbols.Enums { return false; }
        let Enumˉnominal: u32 = Shape - 131072u32;
        if Target != Enumˉnominal { return false; }
        let Enumˉentry: u32 = Compilerˉsourceˉwirˉnominalˉdirectoryˉentry(
            Symbols, Enumˉnominal, 5u32
        );
        if Enumˉentry == Wirˉconsumer.Compilerˉsourceˉwirˉsentinel() { return false; }
        let Enumˉsymbolˉentry: u32 = 16u32 + Enumˉentry * 24u32;
        return Auxiliary < Bytesˉreadˉu32ˉlittle(
            Symbols.Directory, Enumˉsymbolˉentry + 20u32
        );
    }
    if Operation >= 65u32 {
        if Operation <= 67u32 {
            let Variantˉview: Compilerˉsourceˉwirˉvariantˉcaseˉview =
                Compilerˉsourceˉwirˉvariantˉcaseˉviewˉbyˉindex(
                    Input, Scan, Symbols, Typeˉcatalog, Target, Auxiliary
                );
            if !Variantˉview.Found { return false; }
            if Operation == 65u32 {
                var Variantˉresultˉshape: u32 = 196608u32 + Target;
                if Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉshapeˉisˉprivate(
                        Target
                    ) {
                    Variantˉresultˉshape = Target;
                }
                if Shape != Variantˉresultˉshape { return false; }
                return Operandˉcount == Variantˉview.Fields;
            }
            if Operandˉcount != 1u32 { return false; }
            if Operation == 66u32 { return Shape == 4u32; }
            if Variantˉview.Fields != 1u32 { return false; }
            let Variantˉfield: Compilerˉsourceˉwirˉmember =
                Compilerˉsourceˉwirˉvariantˉfieldˉbyˉindex(
                    Input, Scan, Symbols, Typeˉcatalog,
                    Target, Auxiliary, 0u32
                );
            return Variantˉfield.Found && Shape == Variantˉfield.Shape;
        }
    }
    if Operation == 164u32 {
        let Case: u32 = Auxiliary / 64u32;
        let Fieldˉindex: u32 = Auxiliary - Case * 64u32;
        let Field: Compilerˉsourceˉwirˉmember =
            Compilerˉsourceˉwirˉvariantˉfieldˉbyˉindex(
                Input, Scan, Symbols, Typeˉcatalog,
                Target, Case, Fieldˉindex
            );
        if !Field.Found { return false; }
        if Operandˉcount != 1u32 { return false; }
        return Shape == Field.Shape;
    }
    if Operation == 62u32 {
        if Target >= Bytesˉreadˉu32ˉlittle(Directory, 8u32) { return false; }
        let Declaration: u32 =
            Sourceˉbindings.Compilerˉsourceˉbindingsˉrangeˉdeclaration(
                Bindings.Directory, Target
            );
        if Declaration >= Symbolˉentries { return false; }
        let Functionˉentry: u32 = 16u32 + Declaration * 24u32;
        if Bytesˉreadˉu32ˉlittle(Symbols.Directory, Functionˉentry + 4u32) != 6u32 {
            return false;
        }
        if Bytesˉreadˉu32ˉlittle(Symbols.Directory, Functionˉentry + 20u32) != Operandˉcount {
            return false;
        }
        if Auxiliary != 0u32 { return false; }
        let Wirˉfunctionˉentry: u32 =
            Wirˉconsumer.Compilerˉsourceˉwirˉfunctionsˉoffset(Directory) + Target * 48u32;
        let Returnˉshape: u32 = Bytesˉreadˉu32ˉlittle(
            Directory, Wirˉfunctionˉentry + 44u32
        );
        if Returnˉshape == 10u32 { return Shape == 0u32; }
        return Shape == Returnˉshape;
    }
    if Operation == 63u32 {
        if Target >= Symbolˉentries { return false; }
        let Capabilityˉentry: u32 = 16u32 + Target * 24u32;
        if Bytesˉreadˉu32ˉlittle(Symbols.Directory, Capabilityˉentry + 4u32) != 2u32 {
            return false;
        }
        let Capabilityˉmodule: u32 = Bytesˉreadˉu32ˉlittle(Symbols.Directory, Capabilityˉentry);
        let Capabilityˉnameˉoffset: u32 = Bytesˉreadˉu32ˉlittle(
            Symbols.Directory, Capabilityˉentry + 12u32
        );
        let Capabilityˉnameˉlength: u32 = Bytesˉreadˉu32ˉlittle(
            Symbols.Directory, Capabilityˉentry + 16u32
        );
        let Capabilityˉview: Sourceˉset.Compilerˉsourceˉsetˉview = Sourceˉset.Compilerˉsourceˉsetˉmodule(
            Input, Scan, Capabilityˉmodule
        );
        if Sourceˉbindings.Compilerˉsourceˉbindingsˉcapabilityˉarity(
            Capabilityˉview.Source,
            Capabilityˉnameˉoffset,
            Capabilityˉnameˉlength
        ) != Operandˉcount { return false; }
        if Auxiliary != 0u32 { return false; }
        return Shape == Wirˉconsumer.Compilerˉsourceˉwirˉcapabilityˉreturnˉshape(
            Capabilityˉview.Source, Capabilityˉnameˉoffset, Capabilityˉnameˉlength
        );
    }
    return true;
}

fn Compilerˉsourceˉwirˉownershipˉstateˉset(
    State: bytes,
    Index: u32,
    Value: u8
) -> bytes {
    if Index >= Bytesˉlength(State) { return State; }
    return Bytesˉconcat(
        Bytesˉconcat(
            Bytesˉslice(State, 0u32, Index),
            Bytesˉfromˉu8(Value)
        ),
        Bytesˉslice(
            State, Index + 1u32,
            Bytesˉlength(State) - Index - 1u32
        )
    );
}

fn Compilerˉsourceˉwirˉmemoryˉsplitˉownershipˉisˉvalid(
    Bindings: Sourceˉbindings.Compilerˉsourceˉbindingˉsummary,
    Symbolˉentries: u32,
    Directory: bytes,
    Function: u32,
    Range: Compilerˉsourceˉwirˉrange
) -> bool {
    let Functionˉentries: u32 = Bytesˉreadˉu32ˉlittle(Directory, 8u32);
    let Blocks: u32 = Bytesˉreadˉu32ˉlittle(Directory, 16u32);
    let Operations: u32 = Bytesˉreadˉu32ˉlittle(Directory, 24u32);
    let Temporaries: u32 = Bytesˉreadˉu32ˉlittle(Directory, 32u32);
    let Blocksˉoffset: u32 = Wirˉconsumer.Compilerˉsourceˉwirˉheaderˉbytes(Directory) +
        Functionˉentries * 48u32;
    let Operationsˉoffset: u32 = Blocksˉoffset + Blocks * 28u32;
    let Temporariesˉoffset: u32 = Operationsˉoffset + Operations * 28u32;
    let Operandsˉoffset: u32 = Temporariesˉoffset + Temporaries * 4u32;

    var Hasˉmemoryˉsplit: bool = false;
    var Scanˉindex: u32 = 0u32;
    while Scanˉindex < Range.Operationˉcount {
        let Scanˉentry: u32 = Operationsˉoffset +
            (Range.Firstˉoperation + Scanˉindex) * 28u32;
        if Bytesˉreadˉu16ˉlittle(Directory, Scanˉentry + 4u32) ==
                WIR_OPERATION_FOUNDATION_MEMORY_SPLIT ||
            Bytesˉreadˉu16ˉlittle(Directory, Scanˉentry + 4u32) ==
                WIR_OPERATION_FOUNDATION_VECTOR_CONSTRUCT_RESERVED ||
            Bytesˉreadˉu16ˉlittle(Directory, Scanˉentry + 4u32) ==
                WIR_OPERATION_FOUNDATION_VECTOR_GROW_RESERVED {
            Hasˉmemoryˉsplit = true;
        }
        Scanˉindex = Scanˉindex + 1u32;
    }
    if !Hasˉmemoryˉsplit { return true; }
    let Slotˉcount: u32 = Range.Parameters + Range.Locals;
    if Range.Blockˉcount == 0u32 || Range.Blockˉcount > 64u32 ||
        Slotˉcount > 64u32 {
        return false;
    }

    var Blockˉstates: bytes = Bytesˉslice(Directory, 0u32, 0u32);
    var Blockˉstateˉindex: u32 = 0u32;
    while Blockˉstateˉindex < Range.Blockˉcount * Slotˉcount {
        Blockˉstates = Bytesˉconcat(Blockˉstates, Bytesˉfromˉu8(0u8));
        Blockˉstateˉindex = Blockˉstateˉindex + 1u32;
    }
    var Reachable: bytes = Bytesˉslice(Directory, 0u32, 0u32);
    var Blockˉindex: u32 = 0u32;
    while Blockˉindex < Range.Blockˉcount {
        Reachable = Bytesˉconcat(Reachable, Bytesˉfromˉu8(0u8));
        Blockˉindex = Blockˉindex + 1u32;
    }
    Reachable = Compilerˉsourceˉwirˉownershipˉstateˉset(
        Reachable, 0u32, 1u8
    );
    var Slot: u32 = 0u32;
    while Slot < Range.Parameters {
        if Wirˉconsumer.Compilerˉsourceˉwirˉbindingˉshape(
            Bindings, Symbolˉentries, Function, Slot
        ) == 805306368u32 {
            Blockˉstates = Compilerˉsourceˉwirˉownershipˉstateˉset(
                Blockˉstates, Slot, 1u8
            );
        }
        Slot = Slot + 1u32;
    }
    var Temporaryˉstate: bytes = Bytesˉslice(Directory, 0u32, 0u32);
    var Temporaryˉblock: bytes = Bytesˉslice(Directory, 0u32, 0u32);
    Blockˉindex = 0u32;
    while Blockˉindex < Range.Blockˉcount {
        if Bytesˉreadˉu8(Reachable, Blockˉindex) != 1u8 { return false; }
        let Stateˉoffset: u32 = Blockˉindex * Slotˉcount;
        var Slotˉstate: bytes = Bytesˉslice(
            Blockˉstates, Stateˉoffset, Slotˉcount
        );
        let Blockˉentry: u32 = Blocksˉoffset +
            (Range.Firstˉblock + Blockˉindex) * 28u32;
        let Blockˉfirstˉoperation: u32 = Bytesˉreadˉu32ˉlittle(
            Directory, Blockˉentry + 4u32
        );
        let Blockˉoperationˉcount: u32 = Bytesˉreadˉu32ˉlittle(
            Directory, Blockˉentry + 8u32
        );
        var Blockˉoperation: u32 = 0u32;
        while Blockˉoperation < Blockˉoperationˉcount {
            let Operationˉentry: u32 = Operationsˉoffset +
                (Blockˉfirstˉoperation + Blockˉoperation) * 28u32;
            let Operationˉkind: u32 = Bytesˉreadˉu16ˉlittle(
                Directory, Operationˉentry + 4u32
            );
            let Operationˉshape: u32 = Bytesˉreadˉu32ˉlittle(
                Directory, Operationˉentry + 8u32
            );
            let Firstˉoperand: u32 = Bytesˉreadˉu32ˉlittle(
                Directory, Operationˉentry + 16u32
            );
            let Operandˉcount: u32 = Bytesˉreadˉu16ˉlittle(
                Directory, Operationˉentry + 6u32
            );
            let Operationˉtarget: u32 = Bytesˉreadˉu32ˉlittle(
                Directory, Operationˉentry + 20u32
            );
            let Operationˉauxiliary: u32 = Bytesˉreadˉu32ˉlittle(
                Directory, Operationˉentry + 24u32
            );
            if Operationˉshape != 0u32 {
                var Temporaryˉlive: u8 = 0u8;
                if Operationˉshape == 805306368u32 {
                    Temporaryˉlive = 1u8;
                }
                Temporaryˉstate = Bytesˉconcat(
                    Temporaryˉstate, Bytesˉfromˉu8(Temporaryˉlive)
                );
                Temporaryˉblock = Bytesˉconcat(
                    Temporaryˉblock, Bytesˉfromˉu32ˉlittle(Blockˉindex)
                );
            }

            var Operandˉindex: u32 = 0u32;
            var Firstˉoperandˉshape: u32 = 0u32;
            while Operandˉindex < Operandˉcount {
                let Operandˉtemporary: u32 = Bytesˉreadˉu32ˉlittle(
                    Directory,
                    Operandsˉoffset + (Firstˉoperand + Operandˉindex) * 4u32
                );
                let Operandˉshape: u32 = Bytesˉreadˉu32ˉlittle(
                    Directory,
                    Temporariesˉoffset +
                        (Range.Firstˉtemporary + Operandˉtemporary) * 4u32
                );
                if Operandˉindex == 0u32 {
                    Firstˉoperandˉshape = Operandˉshape;
                }
                if Operandˉshape == 805306368u32 {
                    if Operationˉkind != 8u32 || Operandˉindex != 0u32 ||
                        Bytesˉreadˉu8(
                            Temporaryˉstate, Operandˉtemporary
                        ) != 1u8 || Bytesˉreadˉu32ˉlittle(
                            Temporaryˉblock, Operandˉtemporary * 4u32
                        ) != Blockˉindex {
                        return false;
                    }
                    Temporaryˉstate =
                        Compilerˉsourceˉwirˉownershipˉstateˉset(
                            Temporaryˉstate, Operandˉtemporary, 0u8
                        );
                }
                Operandˉindex = Operandˉindex + 1u32;
            }

            if Operationˉkind == 7u32 &&
                Operationˉshape == 805306368u32 {
                if Bytesˉreadˉu8(Slotˉstate, Operationˉtarget) != 1u8 {
                    return false;
                }
                Slotˉstate = Compilerˉsourceˉwirˉownershipˉstateˉset(
                    Slotˉstate, Operationˉtarget, 0u8
                );
            }
            if Operationˉkind == 8u32 &&
                Firstˉoperandˉshape == 805306368u32 {
                if Operationˉtarget < Range.Parameters ||
                    Bytesˉreadˉu8(Slotˉstate, Operationˉtarget) != 0u8 {
                    return false;
                }
                Slotˉstate = Compilerˉsourceˉwirˉownershipˉstateˉset(
                    Slotˉstate, Operationˉtarget, 1u8
                );
            }
            if Operationˉkind == WIR_OPERATION_FOUNDATION_MEMORY_SPLIT {
                if Operationˉtarget >= Slotˉcount ||
                    Wirˉconsumer.Compilerˉsourceˉwirˉbindingˉshape(
                        Bindings, Symbolˉentries, Function, Operationˉtarget
                    ) != 805306368u32 || Bytesˉreadˉu8(
                        Slotˉstate, Operationˉtarget
                    ) != 1u8 {
                    return false;
                }
            }
            if Operationˉkind == WIR_OPERATION_FOUNDATION_VECTOR_GROW_RESERVED {
                if Operationˉauxiliary >= Slotˉcount ||
                    Wirˉconsumer.Compilerˉsourceˉwirˉbindingˉshape(
                        Bindings, Symbolˉentries, Function,
                        Operationˉauxiliary
                    ) != 805306368u32 || Bytesˉreadˉu8(
                        Slotˉstate, Operationˉauxiliary
                    ) != 1u8 {
                    return false;
                }
            }
            if Operationˉkind ==
                    WIR_OPERATION_FOUNDATION_VECTOR_CONSTRUCT_RESERVED {
                if Operationˉtarget >= Slotˉcount ||
                    Wirˉconsumer.Compilerˉsourceˉwirˉbindingˉshape(
                        Bindings, Symbolˉentries, Function, Operationˉtarget
                    ) != 805306368u32 || Bytesˉreadˉu8(
                        Slotˉstate, Operationˉtarget
                    ) != 1u8 {
                    return false;
                }
                Slotˉstate = Compilerˉsourceˉwirˉownershipˉstateˉset(
                    Slotˉstate, Operationˉtarget, 0u8
                );
            }
            Blockˉoperation = Blockˉoperation + 1u32;
        }

        var Temporary: u32 = 0u32;
        while Temporary < Bytesˉlength(Temporaryˉstate) {
            if Bytesˉreadˉu8(Temporaryˉstate, Temporary) == 1u8 &&
                Bytesˉreadˉu32ˉlittle(
                    Temporaryˉblock, Temporary * 4u32
                ) == Blockˉindex {
                return false;
            }
            Temporary = Temporary + 1u32;
        }

        let Terminator: u32 = Bytesˉreadˉu32ˉlittle(
            Directory, Blockˉentry + 12u32
        );
        var Successorˉcount: u32 = 0u32;
        if Terminator == 1u32 { Successorˉcount = 1u32; }
        if Terminator == 2u32 { Successorˉcount = 2u32; }
        var Successor: u32 = 0u32;
        while Successor < Successorˉcount {
            var Target: u32 = Bytesˉreadˉu32ˉlittle(
                Directory, Blockˉentry + 20u32
            );
            if Successor == 1u32 {
                Target = Bytesˉreadˉu32ˉlittle(
                    Directory, Blockˉentry + 24u32
                );
            }
            if Target >= Range.Blockˉcount {
                return false;
            }
            let Targetˉoffset: u32 = Target * Slotˉcount;
            if Target <= Blockˉindex {
                if !Sourceˉset.Compilerˉsourceˉspansˉequal(
                    Blockˉstates, Targetˉoffset, Slotˉcount,
                    Slotˉstate, 0u32, Slotˉcount
                ) { return false; }
            }
            var Targetˉstate: bytes = Slotˉstate;
            if Bytesˉreadˉu8(Reachable, Target) == 1u8 {
                Targetˉstate = Bytesˉslice(Directory, 0u32, 0u32);
                Slot = 0u32;
                while Slot < Slotˉcount {
                    var Joined: u8 = 0u8;
                    if Bytesˉreadˉu8(
                        Blockˉstates, Targetˉoffset + Slot
                    ) == 1u8 && Bytesˉreadˉu8(Slotˉstate, Slot) == 1u8 {
                        Joined = 1u8;
                    }
                    Targetˉstate = Bytesˉconcat(
                        Targetˉstate, Bytesˉfromˉu8(Joined)
                    );
                    Slot = Slot + 1u32;
                }
            } else {
                Reachable = Compilerˉsourceˉwirˉownershipˉstateˉset(
                    Reachable, Target, 1u8
                );
            }
            Blockˉstates = Bytesˉconcat(
                Bytesˉconcat(
                    Bytesˉslice(Blockˉstates, 0u32, Targetˉoffset),
                    Targetˉstate
                ),
                Bytesˉslice(
                    Blockˉstates,
                    Targetˉoffset + Slotˉcount,
                    Bytesˉlength(Blockˉstates) - Targetˉoffset - Slotˉcount
                )
            );
            Successor = Successor + 1u32;
        }
        Blockˉindex = Blockˉindex + 1u32;
    }
    return true;
}

fn Compilerˉsourceˉwirˉshapeˉisˉaffineˉresult(
    Directory: bytes,
    Shape: u32
) -> bool {
    let Functions: u32 = Bytesˉreadˉu32ˉlittle(Directory, 8u32);
    let Blocks: u32 = Bytesˉreadˉu32ˉlittle(Directory, 16u32);
    let Operations: u32 = Bytesˉreadˉu32ˉlittle(Directory, 24u32);
    let Offset: u32 = Wirˉconsumer.Compilerˉsourceˉwirˉheaderˉbytes(Directory) +
        Functions * 48u32 + Blocks * 28u32;
    var Operation: u32 = 0u32;
    while Operation < Operations {
        let Entry: u32 = Offset + Operation * 28u32;
        let Kind: u32 = Bytesˉreadˉu16ˉlittle(
            Directory, Entry + 4u32
        );
        if (Kind == WIR_OPERATION_FOUNDATION_MEMORY_SPLIT ||
                Kind == WIR_OPERATION_FOUNDATION_VECTOR_CONSTRUCT_RESERVED) &&
            Bytesˉreadˉu32ˉlittle(Directory, Entry + 8u32) == Shape {
            return true;
        }
        Operation = Operation + 1u32;
    }
    return false;
}

fn Compilerˉsourceˉwirˉownedˉshapeˉcacheˉlookup(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Shape: u32,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Typeˉcatalog: Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog,
    Entries: bytes
) -> Compilerˉsourceˉwirˉownedˉshapeˉcache {
    var Cursor: u32 = 0u32;
    while Cursor < Bytesˉlength(Entries) {
        if Bytesˉreadˉu32ˉlittle(Entries, Cursor) == Shape {
            return Compilerˉsourceˉwirˉownedˉshapeˉcache {
                Entries: Entries,
                Owned: Bytesˉreadˉu8(Entries, Cursor + 4u32) == 1u8
            };
        }
        Cursor = Cursor + 5u32;
    }
    let Owned: bool =
        Compilerˉsourceˉwirˉshapeˉcontainsˉownedˉvectorˉat(
            Input, Scan, Shape, Symbols, Typeˉcatalog,
            Bytesˉslice(Input, 0u32, 0u32), 0u32
        );
    var Result: bytes = Entries;
    if Bytesˉlength(Result) < 1280u32 {
        var Marker: u8 = 0u8;
        if Owned { Marker = 1u8; }
        Result = Bytesˉconcat(
            Result,
            Bytesˉconcat(
                Bytesˉfromˉu32ˉlittle(Shape), Bytesˉfromˉu8(Marker)
            )
        );
    }
    return Compilerˉsourceˉwirˉownedˉshapeˉcache {
        Entries: Result,
        Owned: Owned
    };
}

fn Compilerˉsourceˉwirˉvectorˉownershipˉisˉvalid(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Bindings: Sourceˉbindings.Compilerˉsourceˉbindingˉsummary,
    Symbolˉentries: u32,
    Directory: bytes,
    Function: u32,
    Range: Compilerˉsourceˉwirˉrange
) -> bool {
    let Functionˉentries: u32 = Bytesˉreadˉu32ˉlittle(Directory, 8u32);
    let Blocks: u32 = Bytesˉreadˉu32ˉlittle(Directory, 16u32);
    let Operations: u32 = Bytesˉreadˉu32ˉlittle(Directory, 24u32);
    let Temporaries: u32 = Bytesˉreadˉu32ˉlittle(Directory, 32u32);
    let Blocksˉoffset: u32 = Wirˉconsumer.Compilerˉsourceˉwirˉheaderˉbytes(Directory) +
        Functionˉentries * 48u32;
    let Operationsˉoffset: u32 = Blocksˉoffset + Blocks * 28u32;
    let Temporariesˉoffset: u32 = Operationsˉoffset + Operations * 28u32;
    let Operandsˉoffset: u32 = Temporariesˉoffset + Temporaries * 4u32;
    let Typeˉcatalog: Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog =
        Genericˉbindings.Compilerˉsourceˉbindingsˉgenericˉtypesˉtypeˉcatalog(
            Bindings.Directory
        );
    let Slotˉcount: u32 = Range.Parameters + Range.Locals;

    var Hasˉvector: bool = false;
    var Ownedˉshapeˉcache: bytes = Bytesˉslice(Directory, 0u32, 0u32);
    var Slotˉownedˉshapes: bytes = Bytesˉslice(Directory, 0u32, 0u32);
    var Slot: u32 = 0u32;
    while Slot < Slotˉcount {
        let Slotˉshape: u32 = Wirˉconsumer.Compilerˉsourceˉwirˉbindingˉshape(
            Bindings, Symbolˉentries, Function, Slot
        );
        let Slotˉcache: Compilerˉsourceˉwirˉownedˉshapeˉcache =
            Compilerˉsourceˉwirˉownedˉshapeˉcacheˉlookup(
            Input, Scan, Slotˉshape,
            Symbols, Typeˉcatalog, Ownedˉshapeˉcache
        );
        Ownedˉshapeˉcache = Slotˉcache.Entries;
        var Slotˉownedˉmarker: u8 = 0u8;
        if Slotˉcache.Owned && !Compilerˉsourceˉwirˉshapeˉisˉaffineˉresult(
                Directory, Slotˉshape
            ) {
            Hasˉvector = true;
            Slotˉownedˉmarker = 1u8;
        }
        Slotˉownedˉshapes = Bytesˉconcat(
            Slotˉownedˉshapes, Bytesˉfromˉu8(Slotˉownedˉmarker)
        );
        Slot = Slot + 1u32;
    }
    var Temporaryˉownedˉshapes: bytes =
        Bytesˉslice(Directory, 0u32, 0u32);
    var Temporary: u32 = 0u32;
    while Temporary < Range.Temporaryˉcount {
        let Temporaryˉshape: u32 = Bytesˉreadˉu32ˉlittle(
            Directory,
            Temporariesˉoffset +
                (Range.Firstˉtemporary + Temporary) * 4u32
        );
        let Temporaryˉcache: Compilerˉsourceˉwirˉownedˉshapeˉcache =
            Compilerˉsourceˉwirˉownedˉshapeˉcacheˉlookup(
            Input, Scan,
            Temporaryˉshape, Symbols, Typeˉcatalog, Ownedˉshapeˉcache
        );
        Ownedˉshapeˉcache = Temporaryˉcache.Entries;
        var Temporaryˉownedˉmarker: u8 = 0u8;
        if Temporaryˉcache.Owned &&
            !Compilerˉsourceˉwirˉshapeˉisˉaffineˉresult(
                Directory, Temporaryˉshape
            ) {
            Hasˉvector = true;
            Temporaryˉownedˉmarker = 1u8;
        }
        Temporaryˉownedˉshapes = Bytesˉconcat(
            Temporaryˉownedˉshapes,
            Bytesˉfromˉu8(Temporaryˉownedˉmarker)
        );
        Temporary = Temporary + 1u32;
    }
    if !Hasˉvector { return true; }
    if Range.Blockˉcount == 0u32 || Range.Blockˉcount > 64u32 ||
        Slotˉcount > 64u32 || Range.Operationˉcount > 4096u32 {
        return false;
    }

    var Blockˉstates: bytes = Bytesˉslice(Directory, 0u32, 0u32);
    var Stateˉindex: u32 = 0u32;
    while Stateˉindex < Range.Blockˉcount * Slotˉcount {
        Blockˉstates = Bytesˉconcat(Blockˉstates, Bytesˉfromˉu8(0u8));
        Stateˉindex = Stateˉindex + 1u32;
    }
    var Reachable: bytes = Bytesˉslice(Directory, 0u32, 0u32);
    var Blockˉindex: u32 = 0u32;
    while Blockˉindex < Range.Blockˉcount {
        Reachable = Bytesˉconcat(Reachable, Bytesˉfromˉu8(0u8));
        Blockˉindex = Blockˉindex + 1u32;
    }
    Reachable = Compilerˉsourceˉwirˉownershipˉstateˉset(
        Reachable, 0u32, 1u8
    );
    Slot = 0u32;
    while Slot < Range.Parameters {
        if Bytesˉreadˉu8(Slotˉownedˉshapes, Slot) == 1u8 {
            let Parameterˉmode: u32 =
                Wirˉconsumer.Compilerˉsourceˉwirˉfunctionˉparameterˉborrowˉmode(
                    Input, Scan, Symbols, Bindings, Function, Slot
                );
            if Parameterˉmode == Wirˉconsumer.Compilerˉsourceˉwirˉsentinel() {
                return false;
            }
            if Wirˉconsumer.Compilerˉsourceˉwirˉbindingˉshape(
                    Bindings, Symbolˉentries, Function, Slot
                ) == 805306369u32 && Parameterˉmode !=
                    Sourceˉdeclarations.COMPILER_SOURCE_BORROW_MODE_VALUE {
                return false;
            }
            var Initial: u8 = 1u8;
            if Parameterˉmode !=
                    Sourceˉdeclarations.COMPILER_SOURCE_BORROW_MODE_VALUE {
                Initial = 2u8;
            }
            Blockˉstates = Compilerˉsourceˉwirˉownershipˉstateˉset(
                Blockˉstates, Slot, Initial
            );
        }
        Slot = Slot + 1u32;
    }

    var Temporaryˉstate: bytes = Bytesˉslice(Directory, 0u32, 0u32);
    var Temporaryˉorigin: bytes = Bytesˉslice(Directory, 0u32, 0u32);
    var Temporaryˉblock: bytes = Bytesˉslice(Directory, 0u32, 0u32);
    Blockˉindex = 0u32;
    while Blockˉindex < Range.Blockˉcount {
        if Bytesˉreadˉu8(Reachable, Blockˉindex) != 1u8 { return false; }
        let Stateˉoffset: u32 = Blockˉindex * Slotˉcount;
        var Slotˉstate: bytes = Bytesˉslice(
            Blockˉstates, Stateˉoffset, Slotˉcount
        );
        let Blockˉentry: u32 = Blocksˉoffset +
            (Range.Firstˉblock + Blockˉindex) * 28u32;
        let Firstˉoperation: u32 = Bytesˉreadˉu32ˉlittle(
            Directory, Blockˉentry + 4u32
        );
        let Operationˉcount: u32 = Bytesˉreadˉu32ˉlittle(
            Directory, Blockˉentry + 8u32
        );
        var Inˉblock: u32 = 0u32;
        while Inˉblock < Operationˉcount {
            let Operationˉentry: u32 = Operationsˉoffset +
                (Firstˉoperation + Inˉblock) * 28u32;
            let Operationˉkind: u32 = Bytesˉreadˉu16ˉlittle(
                Directory, Operationˉentry + 4u32
            );
            let Operationˉshape: u32 = Bytesˉreadˉu32ˉlittle(
                Directory, Operationˉentry + 8u32
            );
            let Firstˉoperand: u32 = Bytesˉreadˉu32ˉlittle(
                Directory, Operationˉentry + 16u32
            );
            let Operandˉcount: u32 = Bytesˉreadˉu16ˉlittle(
                Directory, Operationˉentry + 6u32
            );
            let Operationˉtarget: u32 = Bytesˉreadˉu32ˉlittle(
                Directory, Operationˉentry + 20u32
            );
            let Operationˉcache: Compilerˉsourceˉwirˉownedˉshapeˉcache =
                Compilerˉsourceˉwirˉownedˉshapeˉcacheˉlookup(
                    Input, Scan, Operationˉshape, Symbols, Typeˉcatalog,
                    Ownedˉshapeˉcache
                );
            Ownedˉshapeˉcache = Operationˉcache.Entries;
            let Producesˉvector: bool = Operationˉcache.Owned &&
                !Compilerˉsourceˉwirˉshapeˉisˉaffineˉresult(
                    Directory, Operationˉshape
                );
            var Borrowsˉownedˉaggregate: bool = false;
            if Operandˉcount > 0u32 &&
                (Operationˉkind == WIR_OPERATION_RECORD_FIELD ||
                    Operationˉkind == WIR_OPERATION_VARIANT_FIELD ||
                    Operationˉkind == WIR_OPERATION_ARRAY_ELEMENT) {
                let Aggregateˉtemporary: u32 = Bytesˉreadˉu32ˉlittle(
                    Directory, Operandsˉoffset + Firstˉoperand * 4u32
                );
                let Aggregateˉshape: u32 = Bytesˉreadˉu32ˉlittle(
                    Directory,
                    Temporariesˉoffset +
                        (Range.Firstˉtemporary + Aggregateˉtemporary) * 4u32
                );
                Borrowsˉownedˉaggregate = Aggregateˉtemporary <
                    Range.Temporaryˉcount && Bytesˉreadˉu8(
                        Temporaryˉownedˉshapes, Aggregateˉtemporary
                    ) == 1u8 && !Compilerˉsourceˉwirˉshapeˉisˉaffineˉresult(
                        Directory, Aggregateˉshape
                    );
            }
            if Operationˉkind == WIR_OPERATION_VALUE_PHI && Producesˉvector {
                return false;
            }
            if Operationˉshape != 0u32 {
                var Producedˉstate: u8 = 0u8;
                var Producedˉorigin: u32 = Wirˉconsumer.Compilerˉsourceˉwirˉsentinel();
                if Producesˉvector {
                    Producedˉstate = 1u8;
                    if Borrowsˉownedˉaggregate { Producedˉstate = 2u8; }
                    if Operationˉkind == WIR_OPERATION_LOAD_LOCAL {
                        if Operationˉtarget >= Slotˉcount ||
                            Bytesˉreadˉu8(
                                Slotˉownedˉshapes, Operationˉtarget
                            ) != 1u8 {
                            return false;
                        }
                        Producedˉstate = Bytesˉreadˉu8(
                            Slotˉstate, Operationˉtarget
                        );
                        if Producedˉstate == 0u8 { return false; }
                        if Producedˉstate == 1u8 {
                            Producedˉorigin = Operationˉtarget;
                        }
                    }
                }
                Temporaryˉstate = Bytesˉconcat(
                    Temporaryˉstate, Bytesˉfromˉu8(Producedˉstate)
                );
                Temporaryˉorigin = Bytesˉconcat(
                    Temporaryˉorigin,
                    Bytesˉfromˉu32ˉlittle(Producedˉorigin)
                );
                Temporaryˉblock = Bytesˉconcat(
                    Temporaryˉblock,
                    Bytesˉfromˉu32ˉlittle(Blockˉindex)
                );
            }

            var Operandˉindex: u32 = 0u32;
            var Firstˉoperandˉowned: bool = false;
            while Operandˉindex < Operandˉcount {
                let Operandˉtemporary: u32 = Bytesˉreadˉu32ˉlittle(
                    Directory,
                    Operandsˉoffset + (Firstˉoperand + Operandˉindex) * 4u32
                );
                let Operandˉshape: u32 = Bytesˉreadˉu32ˉlittle(
                    Directory,
                    Temporariesˉoffset +
                        (Range.Firstˉtemporary + Operandˉtemporary) * 4u32
                );
                if Operandˉindex == 0u32 {
                    Firstˉoperandˉowned = Operandˉtemporary <
                        Range.Temporaryˉcount && Bytesˉreadˉu8(
                            Temporaryˉownedˉshapes, Operandˉtemporary
                        ) == 1u8;
                }
                if Operandˉtemporary < Range.Temporaryˉcount &&
                    Bytesˉreadˉu8(
                        Temporaryˉownedˉshapes, Operandˉtemporary
                    ) == 1u8 {
                    if Operandˉtemporary >= Bytesˉlength(Temporaryˉstate) ||
                        Bytesˉreadˉu32ˉlittle(
                            Temporaryˉblock, Operandˉtemporary * 4u32
                        ) != Blockˉindex {
                        return false;
                    }
                    let Currentˉstate: u8 = Bytesˉreadˉu8(
                        Temporaryˉstate, Operandˉtemporary
                    );
                    var Consumes: bool = false;
                    var Borrows: bool = false;
                    if Operationˉkind == WIR_OPERATION_CALL_FUNCTION {
                        let Callˉmode: u32 =
                            Wirˉconsumer.Compilerˉsourceˉwirˉfunctionˉparameterˉborrowˉmode(
                                Input, Scan, Symbols, Bindings,
                                Operationˉtarget, Operandˉindex
                            );
                        if Callˉmode == Wirˉconsumer.Compilerˉsourceˉwirˉsentinel() {
                            return false;
                        }
                        if Callˉmode ==
                                Sourceˉdeclarations.COMPILER_SOURCE_BORROW_MODE_VALUE {
                            Consumes = true;
                        } else {
                            Borrows = true;
                        }
                    }
                    if Operationˉkind == WIR_OPERATION_STORE_LOCAL ||
                        Operationˉkind == WIR_OPERATION_RECORD_CREATE ||
                        Operationˉkind == WIR_OPERATION_VARIANT_CREATE ||
                        Operationˉkind == WIR_OPERATION_ARRAY_CREATE {
                        Consumes = true;
                    }
                    if Operationˉkind == WIR_OPERATION_RECORD_FIELD ||
                        Operationˉkind == WIR_OPERATION_VARIANT_FIELD ||
                        Operationˉkind == WIR_OPERATION_ARRAY_ELEMENT {
                        Borrows = true;
                    }
                    if !Consumes && !Borrows { return false; }
                    if (Consumes && Currentˉstate != 1u8) ||
                        (Borrows && Currentˉstate == 0u8) {
                        return false;
                    }
                    Temporaryˉstate =
                        Compilerˉsourceˉwirˉownershipˉstateˉset(
                            Temporaryˉstate, Operandˉtemporary, 0u8
                        );
                    if Consumes {
                        let Consumedˉorigin: u32 = Bytesˉreadˉu32ˉlittle(
                            Temporaryˉorigin, Operandˉtemporary * 4u32
                        );
                        if Consumedˉorigin != Wirˉconsumer.Compilerˉsourceˉwirˉsentinel() {
                            if Consumedˉorigin >= Slotˉcount || Bytesˉreadˉu8(
                                    Slotˉstate, Consumedˉorigin
                                ) != 1u8 {
                                return false;
                            }
                            Slotˉstate =
                                Compilerˉsourceˉwirˉownershipˉstateˉset(
                                    Slotˉstate, Consumedˉorigin, 0u8
                                );
                        }
                    }
                }
                Operandˉindex = Operandˉindex + 1u32;
            }

            if Operationˉkind == WIR_OPERATION_STORE_LOCAL &&
                Firstˉoperandˉowned {
                if Operationˉtarget < Range.Parameters ||
                    Operationˉtarget >= Slotˉcount || Bytesˉreadˉu8(
                        Slotˉstate, Operationˉtarget
                    ) != 0u8 ||
                    Bytesˉreadˉu8(
                        Slotˉownedˉshapes, Operationˉtarget
                    ) != 1u8 {
                    return false;
                }
                Slotˉstate = Compilerˉsourceˉwirˉownershipˉstateˉset(
                    Slotˉstate, Operationˉtarget, 1u8
                );
            }
            if Operationˉkind == WIR_OPERATION_FOUNDATION_VECTOR_LENGTH ||
                Operationˉkind == WIR_OPERATION_FOUNDATION_VECTOR_APPEND ||
                Operationˉkind ==
                    WIR_OPERATION_FOUNDATION_VECTOR_GROW_RESERVED ||
                Operationˉkind == WIR_OPERATION_FOUNDATION_VECTOR_FREEZE ||
                Operationˉkind == WIR_OPERATION_PLATFORM_SOURCE_LENGTH {
                if Operationˉtarget >= Slotˉcount || Bytesˉreadˉu8(
                        Slotˉstate, Operationˉtarget
                    ) != 1u8 {
                    return false;
                }
                if Operationˉkind == WIR_OPERATION_FOUNDATION_VECTOR_FREEZE {
                    Slotˉstate = Compilerˉsourceˉwirˉownershipˉstateˉset(
                        Slotˉstate, Operationˉtarget, 0u8
                    );
                }
            }
            if Operationˉkind == WIR_OPERATION_RELEASE_LOCAL {
                if Operationˉtarget < Range.Parameters ||
                    Operationˉtarget >= Slotˉcount || Bytesˉreadˉu8(
                        Slotˉstate, Operationˉtarget
                    ) != 1u8 {
                    return false;
                }
                Slotˉstate = Compilerˉsourceˉwirˉownershipˉstateˉset(
                    Slotˉstate, Operationˉtarget, 0u8
                );
            }
            Inˉblock = Inˉblock + 1u32;
        }

        let Terminator: u32 = Bytesˉreadˉu32ˉlittle(
            Directory, Blockˉentry + 12u32
        );
        let Terminatorˉvalue: u32 = Bytesˉreadˉu32ˉlittle(
            Directory, Blockˉentry + 16u32
        );
        if Terminator == 3u32 &&
            Terminatorˉvalue != Wirˉconsumer.Compilerˉsourceˉwirˉsentinel() {
            if Terminatorˉvalue < Range.Temporaryˉcount && Bytesˉreadˉu8(
                    Temporaryˉownedˉshapes, Terminatorˉvalue
                ) == 1u8 {
                if Terminatorˉvalue >= Bytesˉlength(Temporaryˉstate) ||
                    Bytesˉreadˉu8(
                        Temporaryˉstate, Terminatorˉvalue
                    ) != 1u8 || Bytesˉreadˉu32ˉlittle(
                        Temporaryˉblock, Terminatorˉvalue * 4u32
                    ) != Blockˉindex {
                    return false;
                }
                Temporaryˉstate =
                    Compilerˉsourceˉwirˉownershipˉstateˉset(
                        Temporaryˉstate, Terminatorˉvalue, 0u8
                    );
                let Returnˉorigin: u32 = Bytesˉreadˉu32ˉlittle(
                    Temporaryˉorigin, Terminatorˉvalue * 4u32
                );
                if Returnˉorigin != Wirˉconsumer.Compilerˉsourceˉwirˉsentinel() {
                    if Returnˉorigin >= Slotˉcount || Bytesˉreadˉu8(
                            Slotˉstate, Returnˉorigin
                        ) != 1u8 {
                        return false;
                    }
                    Slotˉstate = Compilerˉsourceˉwirˉownershipˉstateˉset(
                        Slotˉstate, Returnˉorigin, 0u8
                    );
                }
            }
        }
        Temporary = 0u32;
        while Temporary < Bytesˉlength(Temporaryˉstate) {
            if Bytesˉreadˉu8(Temporaryˉstate, Temporary) != 0u8 &&
                Bytesˉreadˉu32ˉlittle(
                    Temporaryˉblock, Temporary * 4u32
                ) == Blockˉindex {
                return false;
            }
            Temporary = Temporary + 1u32;
        }

        var Successorˉcount: u32 = 0u32;
        if Terminator == 1u32 {
            Successorˉcount = 1u32;
        }
        if Terminator == 2u32 {
            Successorˉcount = 2u32;
        }
        var Successor: u32 = 0u32;
        while Successor < Successorˉcount {
            var Target: u32 = Bytesˉreadˉu32ˉlittle(
                Directory, Blockˉentry + 20u32
            );
            if Successor == 1u32 {
                Target = Bytesˉreadˉu32ˉlittle(
                    Directory, Blockˉentry + 24u32
                );
            }
            if Target >= Range.Blockˉcount {
                return false;
            }
            let Targetˉoffset: u32 = Target * Slotˉcount;
            if Target <= Blockˉindex {
                if !Sourceˉset.Compilerˉsourceˉspansˉequal(
                    Blockˉstates, Targetˉoffset, Slotˉcount,
                    Slotˉstate, 0u32, Slotˉcount
                ) { return false; }
            }
            var Targetˉstate: bytes = Slotˉstate;
            if Bytesˉreadˉu8(Reachable, Target) == 1u8 {
                Targetˉstate = Bytesˉslice(Directory, 0u32, 0u32);
                Slot = 0u32;
                while Slot < Slotˉcount {
                    var Joined: u8 = 0u8;
                    let Prior: u8 = Bytesˉreadˉu8(
                        Blockˉstates, Targetˉoffset + Slot
                    );
                    let Incoming: u8 = Bytesˉreadˉu8(Slotˉstate, Slot);
                    if Prior == Incoming { Joined = Prior; }
                    Targetˉstate = Bytesˉconcat(
                        Targetˉstate, Bytesˉfromˉu8(Joined)
                    );
                    Slot = Slot + 1u32;
                }
            } else {
                Reachable = Compilerˉsourceˉwirˉownershipˉstateˉset(
                    Reachable, Target, 1u8
                );
            }
            Blockˉstates = Bytesˉconcat(
                Bytesˉconcat(
                    Bytesˉslice(Blockˉstates, 0u32, Targetˉoffset),
                    Targetˉstate
                ),
                Bytesˉslice(
                    Blockˉstates, Targetˉoffset + Slotˉcount,
                    Bytesˉlength(Blockˉstates) - Targetˉoffset - Slotˉcount
                )
            );
            Successor = Successor + 1u32;
        }
        Blockˉindex = Blockˉindex + 1u32;
    }
    return true;
}

fn Compilerˉsourceˉwirˉresourceˉoperationˉisˉvalid(
    Operation: u32,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Bindings: Sourceˉbindings.Compilerˉsourceˉbindingˉsummary,
    Symbolˉentries: u32,
    Function: u32,
    Typeˉcatalog: Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog,
    Firstˉlocal: u32,
    Slotˉcount: u32,
    Target: u32,
    Auxiliary: u32
) -> bool {
    if Operation == WIR_OPERATION_PLATFORM_SOURCE_LENGTH {
        return Target >= Firstˉlocal && Target < Slotˉcount &&
            Auxiliary == 0u32 && Wirˉconsumer.Compilerˉsourceˉwirˉbindingˉshape(
                Bindings, Symbolˉentries, Function, Target
            ) == 805306369u32;
    }
    if Operation == WIR_OPERATION_RELEASE_LOCAL {
        if Target < Firstˉlocal || Target >= Slotˉcount ||
            Auxiliary != 0u32 {
            return false;
        }
        let Releasedˉshape: u32 = Wirˉconsumer.Compilerˉsourceˉwirˉbindingˉshape(
            Bindings, Symbolˉentries, Function, Target
        );
        return Releasedˉshape == 805306369u32 ||
            Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalogˉshapeˉisˉkind(
                Typeˉcatalog, Releasedˉshape, 11u32
            );
    }
    if Target < Firstˉlocal || Target >= Slotˉcount ||
        Auxiliary >= Slotˉcount || Target == Auxiliary {
        return false;
    }
    let Vectorˉshape: u32 = Wirˉconsumer.Compilerˉsourceˉwirˉbindingˉshape(
        Bindings, Symbolˉentries, Function, Target
    );
    if !Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalogˉshapeˉisˉkind(
            Typeˉcatalog, Vectorˉshape, 11u32
        ) {
        return false;
    }
    let Vectorˉelement: u32 =
        Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalogˉshapeˉtypeˉargument(
            Typeˉcatalog, Vectorˉshape, 0u32
        );
    if !(Vectorˉelement == 1u32 || Vectorˉelement == 2u32 ||
        Vectorˉelement == 3u32 || Vectorˉelement == 4u32 ||
        Vectorˉelement == 7u32 || Vectorˉelement == 8u32 ||
        (Vectorˉelement >= 11u32 && Vectorˉelement <= 16u32) ||
        (Vectorˉelement >= 131072u32 + Symbols.Records &&
            Vectorˉelement <
                131072u32 + Symbols.Records + Symbols.Enums)) {
        return false;
    }
    return Wirˉconsumer.Compilerˉsourceˉwirˉbindingˉshape(
        Bindings, Symbolˉentries, Function, Auxiliary
    ) == 805306368u32;
}

export fn Compilerˉsourceˉwirˉfunctionˉoperationsˉareˉvalid(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Bindings: Sourceˉbindings.Compilerˉsourceˉbindingˉsummary,
    Functionˉtypeˉcatalog:
        Compilerˉsourceˉwirˉfunctionˉtypeˉcatalog,
    Directory: bytes,
    Blocksˉoffset: u32,
    Operationsˉoffset: u32,
    Temporariesˉoffset: u32,
    Operandsˉoffset: u32,
    Function: u32,
    Range: Compilerˉsourceˉwirˉrange
) -> bool {
    let Symbolˉentries: u32 = Bytesˉreadˉu32ˉlittle(Symbols.Directory, 8u32);
    let Typeˉcatalog: Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog =
        Genericˉbindings.Compilerˉsourceˉbindingsˉgenericˉtypesˉtypeˉcatalog(
            Bindings.Directory
        );
    var Inferredˉshapes: bytes = Bytesˉslice(Directory, 0u32, 0u32);
    var Inferredˉindex: u32 = 0u32;
    var Hasˉinferredˉlocals: bool = false;
    while Inferredˉindex < Range.Locals {
        if Wirˉconsumer.Compilerˉsourceˉwirˉbindingˉshape(
            Bindings, Symbolˉentries, Function,
            Range.Parameters + Inferredˉindex
        ) == 0u32 { Hasˉinferredˉlocals = true; }
        Inferredˉindex = Inferredˉindex + 1u32;
    }
    if Hasˉinferredˉlocals {
        Inferredˉindex = 0u32;
        while Inferredˉindex < Range.Locals {
            Inferredˉshapes = Bytesˉconcat(
                Inferredˉshapes, Bytesˉfromˉu32ˉlittle(0u32)
            );
            Inferredˉindex = Inferredˉindex + 1u32;
        }
    }
    var Operationˉindex: u32 = 0u32;
    var Seenˉtemporaries: u32 = 0u32;
    var Expectedˉoperand: u32 = Range.Firstˉoperand;
    var Consumedˉvectorˉslot: u32 = Wirˉconsumer.Compilerˉsourceˉwirˉsentinel();
    while Operationˉindex < Range.Operationˉcount {
        let Globalˉoperation: u32 = Range.Firstˉoperation + Operationˉindex;
        let Operationˉentry: u32 = Operationsˉoffset + Globalˉoperation * 28u32;
        let Operationˉblock: u32 = Bytesˉreadˉu32ˉlittle(
            Directory, Operationˉentry
        );
        if Operationˉblock >= Range.Blockˉcount { return false; }
        let Ownerˉblockˉentry: u32 = Blocksˉoffset + (
            Range.Firstˉblock + Operationˉblock
        ) * 28u32;
        let Ownerˉblockˉfirst: u32 = Bytesˉreadˉu32ˉlittle(
            Directory, Ownerˉblockˉentry + 4u32
        );
        let Ownerˉblockˉcount: u32 = Bytesˉreadˉu32ˉlittle(
            Directory, Ownerˉblockˉentry + 8u32
        );
        let Operationˉkind: u32 = Bytesˉreadˉu16ˉlittle(Directory, Operationˉentry + 4u32);
        let Operationˉshape: u32 = Bytesˉreadˉu32ˉlittle(Directory, Operationˉentry + 8u32);
        let Operationˉtemporary: u32 = Bytesˉreadˉu32ˉlittle(
            Directory, Operationˉentry + 12u32
        );
        let Firstˉoperand: u32 = Bytesˉreadˉu32ˉlittle(Directory, Operationˉentry + 16u32);
        let Operandˉcount: u32 = Bytesˉreadˉu16ˉlittle(Directory, Operationˉentry + 6u32);
        let Operationˉtarget: u32 = Bytesˉreadˉu32ˉlittle(Directory, Operationˉentry + 20u32);
        let Operationˉauxiliary: u32 = Bytesˉreadˉu32ˉlittle(Directory, Operationˉentry + 24u32);
        if Bytesˉreadˉu32ˉlittle(Directory, Ownerˉblockˉentry) != Operationˉblock {
            return false;
        }
        if Globalˉoperation < Ownerˉblockˉfirst { return false; }
        if Globalˉoperation - Ownerˉblockˉfirst >= Ownerˉblockˉcount { return false; }
        if Operationˉkind == 0u32 { return false; }
        if Operationˉkind > WIR_OPERATION_CALL_INDIRECT { return false; }
        if !Compilerˉsourceˉwirˉshapeˉisˉvalidˉwithˉgenericˉtypes(
            Operationˉshape, Symbols, Typeˉcatalog,
            Functionˉtypeˉcatalog, true
        ) {
            return false;
        }
        if !Compilerˉsourceˉwirˉoperationˉresultˉisˉvalid(
            Operationˉkind, Operationˉshape
        ) { return false; }
        let Availableˉtemporaries: u32 = Seenˉtemporaries;
        if Operationˉshape == 0u32 {
            if Operationˉtemporary != Wirˉconsumer.Compilerˉsourceˉwirˉsentinel() {
                return false;
            }
        } else {
            if Operationˉtemporary != Seenˉtemporaries { return false; }
            if Seenˉtemporaries >= Range.Temporaryˉcount { return false; }
            let Resultˉtemporaryˉshape: u32 = Bytesˉreadˉu32ˉlittle(
                Directory,
                Temporariesˉoffset + (Range.Firstˉtemporary + Seenˉtemporaries) * 4u32
            );
            if Resultˉtemporaryˉshape != Operationˉshape { return false; }
            Seenˉtemporaries = Seenˉtemporaries + 1u32;
        }
        if Firstˉoperand != Expectedˉoperand { return false; }
        let Functionˉoperandˉend: u32 = Range.Firstˉoperand + Range.Operandˉcount;
        if Firstˉoperand > Functionˉoperandˉend { return false; }
        if Operandˉcount > Functionˉoperandˉend - Firstˉoperand { return false; }
        if !Compilerˉsourceˉwirˉoperationˉoperandˉcountˉisˉvalid(
            Operationˉkind, Operandˉcount
        ) { return false; }
        var Operandˉindex: u32 = 0u32;
        var Firstˉoperandˉshape: u32 = 0u32;
        while Operandˉindex < Operandˉcount {
            let Operandˉentry: u32 = Operandsˉoffset + (Firstˉoperand + Operandˉindex) * 4u32;
            let Operandˉtemporary: u32 = Bytesˉreadˉu32ˉlittle(Directory, Operandˉentry);
            if Operandˉtemporary >= Availableˉtemporaries { return false; }
            let Operandˉshape: u32 = Bytesˉreadˉu32ˉlittle(
                Directory,
                Temporariesˉoffset + (Range.Firstˉtemporary + Operandˉtemporary) * 4u32
            );
            if Operandˉindex == 0u32 { Firstˉoperandˉshape = Operandˉshape; }
            if !Compilerˉsourceˉwirˉoperationˉoperandˉshapeˉisˉvalid(
                Operationˉkind, Operandˉindex, Operandˉshape
            ) { return false; }
            if Operationˉkind == 17u32 {
                let Recordˉoperandˉshape: u32 = Compilerˉsourceˉwirˉdynamicˉoperandˉshape(
                    Input, Scan, Symbols, Bindings, Functionˉtypeˉcatalog,
                    Operationˉkind,
                    Operationˉtarget, Operationˉauxiliary, Operandˉindex
                );
                if Operandˉshape != Recordˉoperandˉshape { return false; }
            }
            if Operationˉkind == 65u32 {
                let Variantˉoperandˉshape: u32 = Compilerˉsourceˉwirˉdynamicˉoperandˉshape(
                    Input, Scan, Symbols, Bindings, Functionˉtypeˉcatalog,
                    Operationˉkind,
                    Operationˉtarget, Operationˉauxiliary, Operandˉindex
                );
                if Operandˉshape != Variantˉoperandˉshape { return false; }
            }
            if Operationˉkind == 165u32 || Operationˉkind == 166u32 {
                let Arrayˉoperandˉshape: u32 =
                    Compilerˉsourceˉwirˉdynamicˉoperandˉshape(
                        Input, Scan, Symbols, Bindings,
                        Functionˉtypeˉcatalog, Operationˉkind,
                        Operationˉtarget, Operationˉauxiliary, Operandˉindex
                    );
                if Operandˉshape != Arrayˉoperandˉshape { return false; }
            }
            if Operationˉkind == WIR_OPERATION_FOUNDATION_VECTOR_APPEND {
                let Appendˉoperandˉshape: u32 =
                    Compilerˉsourceˉwirˉdynamicˉoperandˉshape(
                        Input, Scan, Symbols, Bindings,
                        Functionˉtypeˉcatalog, Operationˉkind,
                        Operationˉtarget, Operationˉauxiliary, Operandˉindex
                    );
                if Operandˉshape != Appendˉoperandˉshape {
                    return false;
                }
            }
            if Operationˉkind == 167u32 || Operationˉkind == 168u32 {
                var Collectionˉoperandˉshape: u32 = Operationˉtarget;
                if Operandˉindex == 1u32 {
                    Collectionˉoperandˉshape = 8u32;
                }
                if Operandˉshape != Collectionˉoperandˉshape {
                    return false;
                }
            }
            if Operationˉkind == 164u32 {
                var Variantˉfieldˉownerˉshape: u32 = 196608u32 + Operationˉtarget;
                if Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉshapeˉisˉprivate(
                        Operationˉtarget
                    ) {
                    Variantˉfieldˉownerˉshape = Operationˉtarget;
                }
                if Operandˉshape != Variantˉfieldˉownerˉshape {
                    return false;
                }
            }
            if Operationˉkind == 62u32 {
                let Callˉoperandˉshape: u32 = Compilerˉsourceˉwirˉdynamicˉoperandˉshape(
                    Input, Scan, Symbols, Bindings, Functionˉtypeˉcatalog,
                    Operationˉkind,
                    Operationˉtarget, Operationˉauxiliary, Operandˉindex
                );
                if Operandˉshape != Callˉoperandˉshape { return false; }
            }
            if Operationˉkind == 63u32 {
                let Capabilityˉoperandˉshape: u32 = Compilerˉsourceˉwirˉdynamicˉoperandˉshape(
                    Input, Scan, Symbols, Bindings, Functionˉtypeˉcatalog,
                    Operationˉkind,
                    Operationˉtarget, Operationˉauxiliary, Operandˉindex
                );
                if Operandˉshape != Capabilityˉoperandˉshape { return false; }
            }
            if Operationˉkind == WIR_OPERATION_CALL_INDIRECT {
                let Indirectˉoperandˉshape: u32 =
                    Compilerˉsourceˉwirˉdynamicˉoperandˉshape(
                        Input, Scan, Symbols, Bindings,
                        Functionˉtypeˉcatalog, Operationˉkind,
                        Operationˉtarget, Operationˉauxiliary, Operandˉindex
                    );
                if Operandˉshape != Indirectˉoperandˉshape {
                    return false;
                }
            }
            if Operationˉkind == 20u32 {
                if Operandˉshape != Firstˉoperandˉshape { return false; }
            }
            if Operationˉkind == 21u32 {
                if Operandˉshape != Firstˉoperandˉshape { return false; }
            }
            if Operationˉkind == 64u32 {
                if Operandˉshape != Operationˉshape { return false; }
            }
            if Operationˉkind >= 130u32 {
                if Operationˉkind <= 145u32 {
                    if Operandˉshape != Firstˉoperandˉshape { return false; }
                }
            }
            if Operationˉkind == 149u32 || Operationˉkind == 150u32 {
                if Operandˉshape != Firstˉoperandˉshape { return false; }
            }
            if Operationˉkind == 69u32 {
                if Operandˉindex == 1u32 {
                    if Operandˉshape != Wirˉconsumer.Compilerˉsourceˉwirˉcollectionˉelementˉshape(Firstˉoperandˉshape) {
                        return false;
                    }
                }
            }
            Operandˉindex = Operandˉindex + 1u32;
        }
        if Operationˉkind == 7u32 {
            if Operationˉtarget >= Range.Parameters + Range.Locals { return false; }
            var Loadedˉshape: u32 = Wirˉconsumer.Compilerˉsourceˉwirˉbindingˉshape(
                Bindings, Symbolˉentries, Function, Operationˉtarget
            );
            if Loadedˉshape == 0u32 {
                if Operationˉtarget < Range.Parameters { return false; }
                Loadedˉshape = Bytesˉreadˉu32ˉlittle(
                    Inferredˉshapes,
                    (Operationˉtarget - Range.Parameters) * 4u32
                );
                if Loadedˉshape == 0u32 { return false; }
            }
            if Operationˉshape != Loadedˉshape { return false; }
            if Operationˉauxiliary != 0u32 { return false; }
        }
        if Operationˉkind == 8u32 {
            if Operationˉtarget >= Range.Parameters + Range.Locals { return false; }
            var Storedˉshape: u32 = Wirˉconsumer.Compilerˉsourceˉwirˉbindingˉshape(
                Bindings, Symbolˉentries, Function, Operationˉtarget
            );
            if Storedˉshape == 0u32 {
                if Operationˉtarget < Range.Parameters { return false; }
                let Inferredˉoffset: u32 = (
                    Operationˉtarget - Range.Parameters
                ) * 4u32;
                Storedˉshape = Bytesˉreadˉu32ˉlittle(
                    Inferredˉshapes, Inferredˉoffset
                );
                if Storedˉshape == 0u32 {
                    Storedˉshape = Firstˉoperandˉshape;
                    let Inferredˉsuffixˉoffset: u32 = Inferredˉoffset + 4u32;
                    Inferredˉshapes = Bytesˉconcat(
                        Bytesˉconcat(
                            Bytesˉslice(Inferredˉshapes, 0u32, Inferredˉoffset),
                            Bytesˉfromˉu32ˉlittle(Storedˉshape)
                        ),
                        Bytesˉslice(
                            Inferredˉshapes,
                            Inferredˉsuffixˉoffset,
                            Bytesˉlength(Inferredˉshapes) - Inferredˉsuffixˉoffset
                        )
                    );
                }
            }
            if Firstˉoperandˉshape != Storedˉshape { return false; }
            if Operationˉauxiliary != 0u32 { return false; }
        }
        if Operationˉkind == 169u32 || Operationˉkind == 170u32 ||
            Operationˉkind == WIR_OPERATION_FOUNDATION_VECTOR_APPEND {
            if Operationˉtarget < Range.Parameters ||
                Operationˉtarget >= Range.Parameters + Range.Locals {
                return false;
            }
            let Vectorˉlocalˉshape: u32 =
                Wirˉconsumer.Compilerˉsourceˉwirˉbindingˉshape(
                    Bindings, Symbolˉentries, Function, Operationˉtarget
                );
            if Vectorˉlocalˉshape != Operationˉauxiliary { return false; }
        }
        if Operationˉkind == WIR_OPERATION_FOUNDATION_VECTOR_GROW_RESERVED ||
            Operationˉkind == WIR_OPERATION_PLATFORM_SOURCE_LENGTH ||
            Operationˉkind == WIR_OPERATION_RELEASE_LOCAL {
            if !Compilerˉsourceˉwirˉresourceˉoperationˉisˉvalid(
                Operationˉkind, Symbols, Bindings, Symbolˉentries,
                Function, Typeˉcatalog,
                Range.Parameters, Range.Parameters + Range.Locals,
                Operationˉtarget, Operationˉauxiliary
            ) {
                return false;
            }
        }
        if Operationˉkind == 8u32 &&
            Operationˉtarget == Consumedˉvectorˉslot {
            Consumedˉvectorˉslot = Wirˉconsumer.Compilerˉsourceˉwirˉsentinel();
        }
        if Operationˉkind == 7u32 ||
            Operationˉkind == WIR_OPERATION_FOUNDATION_VECTOR_LENGTH ||
            Operationˉkind == WIR_OPERATION_FOUNDATION_VECTOR_APPEND ||
            Operationˉkind == WIR_OPERATION_FOUNDATION_VECTOR_GROW_RESERVED {
            if Operationˉtarget == Consumedˉvectorˉslot { return false; }
        }
        if Operationˉkind == WIR_OPERATION_FOUNDATION_VECTOR_FREEZE {
            if Range.Blockˉcount != 1u32 ||
                Consumedˉvectorˉslot != Wirˉconsumer.Compilerˉsourceˉwirˉsentinel() {
                return false;
            }
            Consumedˉvectorˉslot = Operationˉtarget;
        }
        if Operationˉkind == 9u32 {
            if Operationˉtarget >= Symbolˉentries { return false; }
            let Lengthˉdataˉentry: u32 = 16u32 + Operationˉtarget * 24u32;
            if Bytesˉreadˉu32ˉlittle(Symbols.Directory, Lengthˉdataˉentry + 4u32) != 3u32 {
                return false;
            }
            if Operationˉauxiliary != 0u32 { return false; }
        }
        if Operationˉkind == 10u32 {
            if Operationˉtarget >= Symbolˉentries { return false; }
            let Loadˉdataˉentry: u32 = 16u32 + Operationˉtarget * 24u32;
            if Bytesˉreadˉu32ˉlittle(Symbols.Directory, Loadˉdataˉentry + 4u32) != 3u32 {
                return false;
            }
            if Operationˉauxiliary != 0u32 { return false; }
        }
        if Operationˉkind == 18u32 {
            if Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉshapeˉisˉprivate(
                    Firstˉoperandˉshape
                ) {
                if Operationˉtarget != Firstˉoperandˉshape { return false; }
            } else {
                if Firstˉoperandˉshape < 65536u32 { return false; }
                if Firstˉoperandˉshape >= 131072u32 { return false; }
                if Operationˉtarget != Firstˉoperandˉshape - 65536u32 {
                    return false;
                }
            }
        }
        if Operationˉkind >= 66u32 {
            if Operationˉkind <= 67u32 {
                var Variantˉoperandˉownerˉshape: u32 = 196608u32 + Operationˉtarget;
                if Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉshapeˉisˉprivate(
                        Operationˉtarget
                    ) {
                    Variantˉoperandˉownerˉshape = Operationˉtarget;
                }
                if Firstˉoperandˉshape != Variantˉoperandˉownerˉshape { return false; }
            }
        }
        if Operationˉkind == 69u32 {
            if Operationˉshape != Firstˉoperandˉshape { return false; }
            if Operationˉtarget != 0u32 || Operationˉauxiliary != 0u32 { return false; }
        }
        if Operationˉkind == 70u32 {
            if Operationˉshape != Firstˉoperandˉshape - 268435456u32 { return false; }
            if Operationˉtarget != 0u32 || Operationˉauxiliary != 0u32 { return false; }
        }
        if Operationˉkind == 71u32 {
            if !Wirˉconsumer.Compilerˉsourceˉwirˉshapeˉisˉsequence(Firstˉoperandˉshape) { return false; }
            if Operationˉtarget != 0u32 || Operationˉauxiliary != 0u32 { return false; }
        }
        if Operationˉkind == 72u32 {
            if Operationˉshape != Wirˉconsumer.Compilerˉsourceˉwirˉcollectionˉelementˉshape(Firstˉoperandˉshape) {
                return false;
            }
            if Operationˉtarget != 0u32 || Operationˉauxiliary != 0u32 { return false; }
        }
        if Operationˉkind >= 130u32 {
            if Operationˉkind <= 135u32 {
                if Operationˉshape != Firstˉoperandˉshape { return false; }
            }
        }
        if Operationˉkind >= 136u32 {
            if Operationˉkind <= 141u32 {
                if Operationˉtarget != Firstˉoperandˉshape { return false; }
            }
        }
        if Operationˉkind >= 142u32 {
            if Operationˉkind <= 147u32 {
                if Operationˉshape != Firstˉoperandˉshape { return false; }
            }
        }
        if Operationˉkind == 149u32 || Operationˉkind == 150u32 {
            if Firstˉoperandˉshape != 16u32 { return false; }
        }
        if Operationˉkind >= 152u32 {
            if Operationˉkind <= 156u32 {
                if Operationˉshape != Firstˉoperandˉshape { return false; }
            }
        }
        if Operationˉkind >= 157u32 {
            if Operationˉkind <= 162u32 {
                if Operationˉtarget != Firstˉoperandˉshape { return false; }
            }
        }
        if Operationˉkind == 64u32 {
            if Globalˉoperation != Ownerˉblockˉfirst { return false; }
            if Operationˉtarget == Operationˉauxiliary { return false; }
            if Operationˉtarget >= Range.Blockˉcount { return false; }
            if Operationˉauxiliary >= Range.Blockˉcount { return false; }
            let Firstˉpredecessor: u32 = Blocksˉoffset + (
                Range.Firstˉblock + Operationˉtarget
            ) * 28u32;
            let Secondˉpredecessor: u32 = Blocksˉoffset + (
                Range.Firstˉblock + Operationˉauxiliary
            ) * 28u32;
            if Bytesˉreadˉu32ˉlittle(Directory, Firstˉpredecessor + 12u32) != 1u32 {
                return false;
            }
            if Bytesˉreadˉu32ˉlittle(Directory, Secondˉpredecessor + 12u32) != 1u32 {
                return false;
            }
            if Bytesˉreadˉu32ˉlittle(Directory, Firstˉpredecessor + 20u32) != Operationˉblock {
                return false;
            }
            if Bytesˉreadˉu32ˉlittle(Directory, Secondˉpredecessor + 20u32) != Operationˉblock {
                return false;
            }
            var Predecessorˉindex: u32 = 0u32;
            while Predecessorˉindex < Range.Blockˉcount {
                let Predecessorˉentry: u32 = Blocksˉoffset + (
                    Range.Firstˉblock + Predecessorˉindex
                ) * 28u32;
                let Predecessorˉterminator: u32 = Bytesˉreadˉu32ˉlittle(
                    Directory, Predecessorˉentry + 12u32
                );
                if Predecessorˉterminator == 1u32 {
                    if Bytesˉreadˉu32ˉlittle(Directory, Predecessorˉentry + 20u32) == Operationˉblock {
                        if Predecessorˉindex != Operationˉtarget &&
                            Predecessorˉindex != Operationˉauxiliary { return false; }
                    }
                }
                if Predecessorˉterminator == 2u32 {
                    if Bytesˉreadˉu32ˉlittle(Directory, Predecessorˉentry + 20u32) == Operationˉblock {
                        return false;
                    }
                    if Bytesˉreadˉu32ˉlittle(Directory, Predecessorˉentry + 24u32) == Operationˉblock {
                        return false;
                    }
                }
                Predecessorˉindex = Predecessorˉindex + 1u32;
            }
        }
        if !Compilerˉsourceˉwirˉdynamicˉresultˉisˉvalid(
            Input, Scan, Symbols, Bindings, Directory,
            Functionˉtypeˉcatalog,
            Operationˉkind, Operationˉshape, Operandˉcount,
            Operationˉtarget, Operationˉauxiliary
        ) { return false; }
        if Operationˉkind >= 11u32 {
            if Operationˉkind <= 16u32 {
                if Operationˉtarget != Wirˉconsumer.Compilerˉsourceˉwirˉsentinel() { return false; }
                if Operationˉauxiliary != 0u32 { return false; }
            }
        }
        if Operationˉkind >= 22u32 {
            if Operationˉkind <= 37u32 {
                if Operationˉtarget != Wirˉconsumer.Compilerˉsourceˉwirˉsentinel() { return false; }
                if Operationˉauxiliary != 0u32 { return false; }
            }
        }
        if Operationˉkind >= 38u32 {
            if Operationˉkind <= 61u32 {
                if Operationˉtarget != 0u32 { return false; }
                if Operationˉauxiliary != 0u32 { return false; }
            }
        }
        if Operationˉkind == 95u32 || Operationˉkind == 96u32 {
            if Operationˉtarget != Wirˉconsumer.Compilerˉsourceˉwirˉsentinel() { return false; }
            if Operationˉauxiliary != 0u32 { return false; }
        }
        if Operationˉkind >= 126u32 {
            if Operationˉkind <= 128u32 {
            if Operationˉtarget != Wirˉconsumer.Compilerˉsourceˉwirˉsentinel() { return false; }
            if Operationˉauxiliary != 0u32 { return false; }
            }
        }
        if Operationˉkind >= 97u32 {
            if Operationˉkind <= 125u32 {
                if Operationˉtarget != 0u32 { return false; }
                if Operationˉauxiliary != 0u32 { return false; }
            }
        }
        if Operationˉkind == 129u32 {
            if Operationˉshape == 11u32 && Operationˉtarget > 255u32 { return false; }
            if Operationˉshape == 12u32 && Operationˉtarget > 65535u32 { return false; }
            if Operationˉshape == 13u32 && Operationˉtarget > 65535u32 { return false; }
            if Operationˉauxiliary != 0u32 { return false; }
        }
        if Operationˉkind >= 130u32 {
            if Operationˉkind <= 135u32 {
                if Operationˉtarget != 0u32 || Operationˉauxiliary != 0u32 { return false; }
            }
        }
        if Operationˉkind >= 136u32 {
            if Operationˉkind <= 141u32 {
                if Operationˉtarget < 11u32 || Operationˉtarget > 13u32 { return false; }
                if Operationˉauxiliary != 0u32 { return false; }
            }
        }
        if Operationˉkind >= 142u32 {
            if Operationˉkind <= 147u32 {
                if Operationˉtarget != 0u32 || Operationˉauxiliary != 0u32 { return false; }
            }
        }
        if Operationˉkind == 148u32 {
            if Operationˉtarget > 1114111u32 { return false; }
            if Operationˉtarget >= 55296u32 && Operationˉtarget <= 57343u32 {
                return false;
            }
            if Operationˉauxiliary != 0u32 { return false; }
        }
        if Operationˉkind == 149u32 || Operationˉkind == 150u32 {
            if Operationˉtarget != 0u32 || Operationˉauxiliary != 0u32 {
                return false;
            }
        }
        if Operationˉkind == 151u32 {
            if Operationˉshape == 14u32 && Operationˉauxiliary != 0u32 {
                return false;
            }
        }
        if Operationˉkind >= 152u32 {
            if Operationˉkind <= 156u32 {
                if Operationˉtarget != 0u32 || Operationˉauxiliary != 0u32 {
                    return false;
                }
            }
        }
        if Operationˉkind >= 157u32 {
            if Operationˉkind <= 162u32 {
                if Operationˉtarget < 14u32 || Operationˉtarget > 15u32 {
                    return false;
                }
                if Operationˉauxiliary != 0u32 { return false; }
            }
        }
        if Operationˉkind == 2u32 {
            if Operationˉtarget > 255u32 { return false; }
            if Operationˉauxiliary != 0u32 { return false; }
        }
        if Operationˉkind == 4u32 {
            if Operationˉtarget > 1u32 { return false; }
            if Operationˉauxiliary != 0u32 { return false; }
        }
        if Operationˉkind == 3u32 {
            if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉshapeˉisˉcapability(
                Symbols.Directory, Operationˉshape
            ) {
                if Operationˉtarget != 0u32 { return false; }
                if Operationˉauxiliary != 0u32 { return false; }
            }
        }
        Expectedˉoperand = Firstˉoperand + Operandˉcount;
        Operationˉindex = Operationˉindex + 1u32;
    }
    if Seenˉtemporaries != Range.Temporaryˉcount { return false; }
    if Hasˉinferredˉlocals {
        Inferredˉindex = 0u32;
        while Inferredˉindex < Range.Locals {
            let Bindingˉshape: u32 = Wirˉconsumer.Compilerˉsourceˉwirˉbindingˉshape(
                Bindings, Symbolˉentries, Function,
                Range.Parameters + Inferredˉindex
            );
            if Bindingˉshape == 0u32 {
                if Bytesˉreadˉu32ˉlittle(
                    Inferredˉshapes, Inferredˉindex * 4u32
                ) == 0u32 { return false; }
            }
            Inferredˉindex = Inferredˉindex + 1u32;
        }
    }
    if Expectedˉoperand != Range.Firstˉoperand + Range.Operandˉcount {
        return false;
    }
    if !Compilerˉsourceˉwirˉmemoryˉsplitˉownershipˉisˉvalid(
            Bindings, Symbolˉentries, Directory, Function, Range
        ) {
        return false;
    }
    return Compilerˉsourceˉwirˉvectorˉownershipˉisˉvalid(
        Input, Scan, Symbols, Bindings, Symbolˉentries,
        Directory, Function, Range
    );
}

export fn Compilerˉsourceˉwirˉdirectoryˉisˉvalid(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Bindings: Sourceˉbindings.Compilerˉsourceˉbindingˉsummary,
    Directory: bytes
) -> bool {
    let Directoryˉlength: u32 = Bytesˉlength(Directory);
    if Directoryˉlength < 48u32 { return false; }
    if Directoryˉlength > 4194304u32 { return false; }
    let Magic: bytes = Textˉtoˉutf8("WVIR");
    if !Sourceˉset.Compilerˉsourceˉspansˉequal(
        Directory, 0u32, 4u32, Magic, 0u32, 4u32
    ) { return false; }
    if Bytesˉreadˉu16ˉlittle(Directory, 4u32) != 1u32 { return false; }
    let Minor: u32 = Bytesˉreadˉu16ˉlittle(Directory, 6u32);
    if Minor < 9u32 || Minor > 18u32 { return false; }
    if (Minor == 10u32 || Minor == 12u32 || Minor == 14u32 ||
            Minor == 16u32 || Minor == 17u32) &&
        Directoryˉlength < 56u32 {
        return false;
    }
    if Minor == 18u32 && Directoryˉlength < 64u32 { return false; }
    let Functionˉentries: u32 = Bytesˉreadˉu32ˉlittle(Directory, 8u32);
    if Bytesˉreadˉu32ˉlittle(Directory, 12u32) != 48u32 { return false; }
    let Blocks: u32 = Bytesˉreadˉu32ˉlittle(Directory, 16u32);
    if Bytesˉreadˉu32ˉlittle(Directory, 20u32) != 28u32 { return false; }
    let Operations: u32 = Bytesˉreadˉu32ˉlittle(Directory, 24u32);
    if Bytesˉreadˉu32ˉlittle(Directory, 28u32) != 28u32 { return false; }
    let Temporaries: u32 = Bytesˉreadˉu32ˉlittle(Directory, 32u32);
    if Bytesˉreadˉu32ˉlittle(Directory, 36u32) != 4u32 { return false; }
    let Operands: u32 = Bytesˉreadˉu32ˉlittle(Directory, 40u32);
    if Bytesˉreadˉu32ˉlittle(Directory, 44u32) != 4u32 { return false; }
    let Symbolˉentries: u32 = Bytesˉreadˉu32ˉlittle(Symbols.Directory, 8u32);
    var Catalog: Sourceˉgenerics.Compilerˉsourceˉgenericˉcatalog =
        Sourceˉgenerics.Compilerˉsourceˉgenericˉcatalogˉempty();
    var Instances: u32 = 0u32;
    let Hasˉgenericˉinstances: bool = Minor == 10u32 || Minor == 12u32 ||
        Minor == 14u32 || Minor == 16u32 || Minor == 18u32;
    let Hasˉfunctionˉtypes: bool = Minor == 17u32 || Minor == 18u32;
    if Minor == 9u32 || Minor == 11u32 || Minor == 13u32 ||
        Minor == 15u32 || Minor == 17u32 {
        if Functionˉentries != Symbolˉentries { return false; }
    } else {
        Instances = Bytesˉreadˉu32ˉlittle(Directory, 48u32);
        if Bytesˉreadˉu32ˉlittle(Directory, 52u32) != 1u32 ||
            Instances == 0u32 || Instances > 256u32 {
            return false;
        }
        Catalog = Genericˉbindings.Compilerˉsourceˉbindingsˉgenericˉtypesˉfunctionˉcatalog(
            Bindings.Directory
        );
        if !Sourceˉgenerics.Compilerˉsourceˉgenericˉcatalogˉisˉvalid(
            Catalog
        ) {
            return false;
        }
        if Sourceˉgenerics.Compilerˉsourceˉgenericˉcatalogˉinstances(Catalog) !=
                Instances ||
            Functionˉentries != Symbolˉentries + Instances {
            return false;
        }
        if Sourceˉbindings.Compilerˉsourceˉbindingsˉrangesˉcount(
            Bindings.Directory
        ) != Functionˉentries {
            return false;
        }
    }
    var Functionˉtypeˉbytes: u32 = 0u32;
    if Hasˉfunctionˉtypes {
        var Functionˉtypeˉheader: u32 = 48u32;
        if Hasˉgenericˉinstances { Functionˉtypeˉheader = 56u32; }
        Functionˉtypeˉbytes = Bytesˉreadˉu32ˉlittle(
            Directory, Functionˉtypeˉheader
        );
        if Bytesˉreadˉu32ˉlittle(
                Directory, Functionˉtypeˉheader + 4u32
            ) != 1u32 ||
            Functionˉtypeˉbytes < 24u32 ||
            Functionˉtypeˉbytes > 1048576u32 {
            return false;
        }
    }
    if Functionˉentries > 87380u32 { return false; }
    if Blocks > 149796u32 { return false; }
    if Operations > 104857u32 { return false; }
    if Temporaries > 1048564u32 { return false; }
    if Operands > 1048564u32 { return false; }
    let Blocksˉoffset: u32 =
        Wirˉconsumer.Compilerˉsourceˉwirˉfunctionsˉoffset(Directory) +
            Functionˉentries * 48u32;
    let Operationsˉoffset: u32 = Blocksˉoffset + Blocks * 28u32;
    let Temporariesˉoffset: u32 = Operationsˉoffset + Operations * 28u32;
    let Operandsˉoffset: u32 = Temporariesˉoffset + Temporaries * 4u32;
    let Functionˉtypesˉoffset: u32 = Operandsˉoffset + Operands * 4u32;
    if Functionˉtypesˉoffset > Directoryˉlength { return false; }
    if Functionˉtypeˉbytes > Directoryˉlength - Functionˉtypesˉoffset {
        return false;
    }
    let Expectedˉlength: u32 = Functionˉtypesˉoffset + Functionˉtypeˉbytes;
    if Directoryˉlength != Expectedˉlength { return false; }
    var Functionˉtypeˉcatalog:
        Compilerˉsourceˉwirˉfunctionˉtypeˉcatalog =
        Compilerˉsourceˉwirˉfunctionˉtypeˉcatalog(
            Bytesˉslice(Directory, 0u32, 0u32)
        );
    if Hasˉfunctionˉtypes {
        Functionˉtypeˉcatalog =
            Compilerˉsourceˉwirˉfunctionˉtypeˉcatalog(
                Bytesˉslice(
                    Directory, Functionˉtypesˉoffset,
                    Functionˉtypeˉbytes
                )
            );
        if !Compilerˉsourceˉwirˉfunctionˉtypeˉcatalogˉisˉvalid(
                Functionˉtypeˉcatalog
            ) ||
            Compilerˉsourceˉwirˉfunctionˉtypeˉcatalogˉinstances(
                Functionˉtypeˉcatalog
            ) == 0u32 {
            return false;
        }
    }
    var Hasˉmemoryˉsplit: bool = false;
    var Hasˉvectorˉappend: bool = false;
    var Hasˉvectorˉgrow: bool = false;
    var Hasˉcallable: bool = false;
    var Nextˉfunctionˉtype: u32 = 0u32;
    var Operationˉscan: u32 = 0u32;
    while Operationˉscan < Operations {
        let Scannedˉoperation: u32 = Bytesˉreadˉu16ˉlittle(
            Directory, Operationsˉoffset + Operationˉscan * 28u32 + 4u32
        );
        if Scannedˉoperation == WIR_OPERATION_FOUNDATION_MEMORY_SPLIT ||
            Scannedˉoperation == WIR_OPERATION_FOUNDATION_VECTOR_CONSTRUCT_RESERVED {
            Hasˉmemoryˉsplit = true;
        }
        if Scannedˉoperation == WIR_OPERATION_FOUNDATION_VECTOR_APPEND {
            Hasˉvectorˉappend = true;
        }
        if Scannedˉoperation ==
                WIR_OPERATION_FOUNDATION_VECTOR_GROW_RESERVED {
            Hasˉvectorˉgrow = true;
        }
        if Scannedˉoperation == WIR_OPERATION_FUNCTION_REFERENCE {
            Hasˉcallable = true;
            let Referenceˉinstance: u32 = Bytesˉreadˉu32ˉlittle(
                Directory,
                Operationsˉoffset + Operationˉscan * 28u32 + 24u32
            );
            if Referenceˉinstance > Nextˉfunctionˉtype {
                return false;
            }
            if Referenceˉinstance == Nextˉfunctionˉtype {
                Nextˉfunctionˉtype = Nextˉfunctionˉtype + 1u32;
            }
        }
        if Scannedˉoperation == WIR_OPERATION_CALL_INDIRECT {
            Hasˉcallable = true;
            if Bytesˉreadˉu32ˉlittle(
                    Directory,
                    Operationsˉoffset + Operationˉscan * 28u32 + 20u32
                ) >= Nextˉfunctionˉtype {
                return false;
            }
        }
        Operationˉscan = Operationˉscan + 1u32;
    }
    if Minor <= 16u32 && Hasˉcallable { return false; }
    if Hasˉfunctionˉtypes && (!Hasˉcallable ||
        Nextˉfunctionˉtype !=
            Compilerˉsourceˉwirˉfunctionˉtypeˉcatalogˉinstances(
                Functionˉtypeˉcatalog
            )) {
        return false;
    }
    if Minor < 11u32 &&
        (Hasˉmemoryˉsplit || Hasˉvectorˉappend || Hasˉvectorˉgrow) {
        return false;
    }
    if Minor >= 11u32 && Minor <= 12u32 &&
        (!Hasˉmemoryˉsplit || Hasˉvectorˉappend || Hasˉvectorˉgrow) {
        return false;
    }
    if Minor >= 13u32 && Minor <= 14u32 &&
        (!Hasˉvectorˉappend || Hasˉvectorˉgrow) {
        return false;
    }
    if Minor >= 15u32 && Minor <= 16u32 && !Hasˉvectorˉgrow {
        return false;
    }
    var Function: u32 = 0u32;
    var Expectedˉblock: u32 = 0u32;
    var Expectedˉoperation: u32 = 0u32;
    var Expectedˉtemporary: u32 = 0u32;
    var Expectedˉoperand: u32 = 0u32;
    while Function < Functionˉentries {
        let Range: Compilerˉsourceˉwirˉrange = Compilerˉsourceˉwirˉfunctionˉrange(
            Input, Scan, Symbols, Bindings, Functionˉtypeˉcatalog,
            Directory, Function,
            Expectedˉblock, Expectedˉoperation, Expectedˉtemporary, Expectedˉoperand,
            Blocks, Operations, Temporaries, Operands
        );
        if !Range.Valid { return false; }
        if Range.Isˉfunction {
            if !Compilerˉsourceˉwirˉfunctionˉblocksˉareˉvalid(
                Directory, Blocksˉoffset, Operationsˉoffset,
                Temporariesˉoffset, Function, Range
            ) { return false; }
            if !Compilerˉsourceˉwirˉfunctionˉoperationsˉareˉvalid(
                Input, Scan, Symbols, Bindings, Functionˉtypeˉcatalog,
                Directory,
                Blocksˉoffset, Operationsˉoffset,
                Temporariesˉoffset, Operandsˉoffset,
                Function, Range
            ) { return false; }
        }
        Expectedˉblock = Expectedˉblock + Range.Blockˉcount;
        Expectedˉoperation = Expectedˉoperation + Range.Operationˉcount;
        Expectedˉtemporary = Expectedˉtemporary + Range.Temporaryˉcount;
        Expectedˉoperand = Expectedˉoperand + Range.Operandˉcount;
        Function = Function + 1u32;
    }
    if Expectedˉblock != Blocks { return false; }
    if Expectedˉoperation != Operations { return false; }
    if Expectedˉtemporary != Temporaries { return false; }
    return Expectedˉoperand == Operands;
}
