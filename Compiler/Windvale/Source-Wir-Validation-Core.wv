record Compilerˉsourceˉwirˉsignature {
    Parameterˉshape: u32;
    Returnˉshape: u32;
    Target: u32;
    Auxiliary: u32;
    Parameterˉmode: u32;
    Returnˉmode: u32;
}

record Compilerˉsourceˉwirˉmember {
    Found: bool;
    Index: u32;
    Shape: u32;
}

record Compilerˉsourceˉwirˉvariantˉcaseˉview {
    Found: bool;
    Module: u32;
    Index: u32;
    Fields: u32;
    Fieldsˉoffset: u32;
    Fieldsˉline: u32;
    Fieldsˉcolumn: u32;
}

record Compilerˉsourceˉwirˉrange {
    Valid: bool;
    Isˉfunction: bool;
    Module: u32;
    Firstˉblock: u32;
    Blockˉcount: u32;
    Firstˉoperation: u32;
    Operationˉcount: u32;
    Firstˉtemporary: u32;
    Temporaryˉcount: u32;
    Firstˉoperand: u32;
    Operandˉcount: u32;
    Parameters: u32;
    Locals: u32;
    Returnˉshape: u32;
}

record Compilerˉsourceˉwirˉownedˉshapeˉcache {
    Entries: bytes;
    Owned: bool;
}

record Compilerˉsourceˉwirˉfunctionˉtypeˉcatalog {
    Evidence: bytes;
}

fn Compilerˉsourceˉwirˉfunctionˉtypeˉcatalogˉinstances(
    Catalog: Compilerˉsourceˉwirˉfunctionˉtypeˉcatalog
) -> u32 {
    if Bytesˉlength(Catalog.Evidence) < WIR_FUNCTION_TYPE_HEADER_BYTES {
        return 0u32;
    }
    return Bytesˉreadˉu32ˉlittle(Catalog.Evidence, 8u32);
}

fn Compilerˉsourceˉwirˉfunctionˉtypeˉentryˉcursor(
    Catalog: Compilerˉsourceˉwirˉfunctionˉtypeˉcatalog,
    Wanted: u32
) -> u32 {
    if Wanted >= Compilerˉsourceˉwirˉfunctionˉtypeˉcatalogˉinstances(
            Catalog
        ) {
        return Wirˉconsumer.Compilerˉsourceˉwirˉsentinel();
    }
    let Length: u32 = Bytesˉlength(Catalog.Evidence);
    var Cursor: u32 = WIR_FUNCTION_TYPE_HEADER_BYTES;
    var Instance: u32 = 0u32;
    while Instance < Wanted {
        if Cursor > Length || Length - Cursor < WIR_FUNCTION_TYPE_ENTRY_BYTES {
            return Wirˉconsumer.Compilerˉsourceˉwirˉsentinel();
        }
        let Parameters: u32 = Bytesˉreadˉu32ˉlittle(
            Catalog.Evidence, Cursor + 8u32
        );
        if Parameters > WIR_FUNCTION_TYPE_PARAMETER_LIMIT ||
            Parameters * 4u32 >
                Length - Cursor - WIR_FUNCTION_TYPE_ENTRY_BYTES {
            return Wirˉconsumer.Compilerˉsourceˉwirˉsentinel();
        }
        Cursor = Cursor + WIR_FUNCTION_TYPE_ENTRY_BYTES + Parameters * 4u32;
        Instance = Instance + 1u32;
    }
    return Cursor;
}

fn Compilerˉsourceˉwirˉfunctionˉtypeˉcatalogˉisˉvalid(
    Catalog: Compilerˉsourceˉwirˉfunctionˉtypeˉcatalog
) -> bool {
    let Length: u32 = Bytesˉlength(Catalog.Evidence);
    if Length < WIR_FUNCTION_TYPE_HEADER_BYTES ||
        Length > WIR_FUNCTION_TYPE_EVIDENCE_LIMIT ||
        Bytesˉreadˉu8(Catalog.Evidence, 0u32) != 87u8 ||
        Bytesˉreadˉu8(Catalog.Evidence, 1u32) != 86u8 ||
        Bytesˉreadˉu8(Catalog.Evidence, 2u32) != 73u8 ||
        Bytesˉreadˉu8(Catalog.Evidence, 3u32) != 67u8 ||
        Bytesˉreadˉu16ˉlittle(Catalog.Evidence, 4u32) != 1u32 ||
        Bytesˉreadˉu16ˉlittle(Catalog.Evidence, 6u32) != 0u32 ||
        Bytesˉreadˉu32ˉlittle(Catalog.Evidence, 12u32) != Length {
        return false;
    }
    let Instances: u32 = Bytesˉreadˉu32ˉlittle(Catalog.Evidence, 8u32);
    if Instances > WIR_FUNCTION_TYPE_INSTANCE_LIMIT { return false; }
    var Instance: u32 = 0u32;
    var Cursor: u32 = WIR_FUNCTION_TYPE_HEADER_BYTES;
    while Instance < Instances {
        if Cursor > Length || Length - Cursor < WIR_FUNCTION_TYPE_ENTRY_BYTES {
            return false;
        }
        let Profile: u32 = Bytesˉreadˉu32ˉlittle(Catalog.Evidence, Cursor);
        let Resultˉshape: u32 = Bytesˉreadˉu32ˉlittle(
            Catalog.Evidence, Cursor + 4u32
        );
        let Parameters: u32 = Bytesˉreadˉu32ˉlittle(
            Catalog.Evidence, Cursor + 8u32
        );
        if Profile == 0u32 || Profile > 3u32 ||
            Resultˉshape == 0u32 || Resultˉshape == 10u32 ||
            Resultˉshape == 15u32 ||
            Resultˉshape >= WIR_FUNCTION_TYPE_SHAPE_BASE ||
            Parameters > WIR_FUNCTION_TYPE_PARAMETER_LIMIT ||
            Parameters * 4u32 >
                Length - Cursor - WIR_FUNCTION_TYPE_ENTRY_BYTES {
            return false;
        }
        let Entryˉbytes: u32 = WIR_FUNCTION_TYPE_ENTRY_BYTES +
            Parameters * 4u32;
        var Parameter: u32 = 0u32;
        while Parameter < Parameters {
            let Parameterˉshape: u32 = Bytesˉreadˉu32ˉlittle(
                Catalog.Evidence,
                Cursor + WIR_FUNCTION_TYPE_ENTRY_BYTES + Parameter * 4u32
            );
            if Parameterˉshape == 0u32 || Parameterˉshape == 10u32 ||
                Parameterˉshape == 15u32 ||
                Parameterˉshape >= WIR_FUNCTION_TYPE_SHAPE_BASE {
                return false;
            }
            Parameter = Parameter + 1u32;
        }
        var Prior: u32 = 0u32;
        while Prior < Instance {
            let Priorˉcursor: u32 =
                Compilerˉsourceˉwirˉfunctionˉtypeˉentryˉcursor(
                    Catalog, Prior
                );
            if Bytesˉreadˉu32ˉlittle(
                    Catalog.Evidence, Priorˉcursor + 8u32
                ) == Parameters &&
                Sourceˉset.Compilerˉsourceˉspansˉequal(
                    Catalog.Evidence, Priorˉcursor, Entryˉbytes,
                    Catalog.Evidence, Cursor, Entryˉbytes
                ) {
                return false;
            }
            Prior = Prior + 1u32;
        }
        Cursor = Cursor + Entryˉbytes;
        Instance = Instance + 1u32;
    }
    return Cursor == Length;
}

fn Compilerˉsourceˉwirˉshapeˉisˉvalidˉwithˉgenericˉtypes(
    Shape: u32,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Typeˉcatalog: Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog,
    Functionˉtypeˉcatalog:
        Compilerˉsourceˉwirˉfunctionˉtypeˉcatalog,
    Allowˉvoid: bool
) -> bool {
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉshapeˉisˉdeclaredˉvalue(
            Shape, Symbols.Records, Symbols.Enums, Symbols.Variants,
            Allowˉvoid
        ) ||
        Sourceˉsymbols.Compilerˉsourceˉsymbolsˉshapeˉisˉcapability(
            Symbols.Directory, Shape
        ) || Shape == 805306368u32 || Shape == 805306369u32 ||
        (Shape >= 1073741824u32 && Shape < 1610612736u32) {
        return true;
    }
    if Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉshapeˉisˉprivate(Shape) {
        return Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉshapeˉinstance(Shape) <
            Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalogˉinstances(
                Typeˉcatalog
            );
    }
    if Shape >= WIR_FUNCTION_TYPE_SHAPE_BASE &&
        Shape < WIR_FUNCTION_TYPE_SHAPE_BASE +
            WIR_FUNCTION_TYPE_INSTANCE_LIMIT {
        return Shape - WIR_FUNCTION_TYPE_SHAPE_BASE <
            Compilerˉsourceˉwirˉfunctionˉtypeˉcatalogˉinstances(
                Functionˉtypeˉcatalog
            );
    }
    return false;
}

fn Compilerˉsourceˉwirˉshapeˉcontainsˉownedˉvectorˉat(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Shape: u32,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Typeˉcatalog: Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog,
    Path: bytes,
    Depth: u32
) -> bool {
    if Shape == 805306369u32 { return true; }
    if Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalogˉshapeˉisˉkind(
            Typeˉcatalog, Shape, 11u32
        ) {
        return true;
    }
    var Possibleˉaggregate: bool = Shape >= 65536u32 && Shape < 131072u32;
    if Shape >= 196608u32 + Symbols.Records + Symbols.Enums &&
        Shape < 196608u32 + Symbols.Records + Symbols.Enums +
            Symbols.Variants {
        Possibleˉaggregate = true;
    }
    if Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉshapeˉisˉprivate(Shape) {
        let Possibleˉinstance: u32 =
            Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉshapeˉinstance(Shape);
        if Possibleˉinstance <
                Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalogˉinstances(
                    Typeˉcatalog
                ) {
            let Possibleˉkind: u32 =
                Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalogˉinstanceˉkind(
                    Typeˉcatalog, Possibleˉinstance
                );
            Possibleˉaggregate = Possibleˉkind == 4u32 ||
                Possibleˉkind == 8u32 || Possibleˉkind == 10u32;
        }
    }
    if !Possibleˉaggregate { return false; }
    if Depth >= 64u32 { return false; }
    var Pathˉcursor: u32 = 0u32;
    while Pathˉcursor < Bytesˉlength(Path) {
        if Bytesˉreadˉu32ˉlittle(Path, Pathˉcursor) == Shape {
            return false;
        }
        Pathˉcursor = Pathˉcursor + 4u32;
    }
    let Nextˉpath: bytes = Bytesˉconcat(
        Path, Bytesˉfromˉu32ˉlittle(Shape)
    );
    var Genericˉkind: u32 = 0u32;
    if Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉshapeˉisˉprivate(Shape) {
        let Instance: u32 =
            Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉshapeˉinstance(Shape);
        if Instance >=
                Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalogˉinstances(
                    Typeˉcatalog
                ) {
            return false;
        }
        Genericˉkind =
            Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalogˉinstanceˉkind(
                Typeˉcatalog, Instance
            );
        if Genericˉkind == 10u32 {
            return Compilerˉsourceˉwirˉshapeˉcontainsˉownedˉvectorˉat(
                Input, Scan,
                Compilerˉsourceˉwirˉfixedˉarrayˉelementˉshape(
                    Shape, Typeˉcatalog
                ),
                Symbols, Typeˉcatalog, Nextˉpath, Depth + 1u32
            );
        }
        if Genericˉkind == 4u32 || Genericˉkind == 8u32 {
            let Layout: Genericˉlayouts.Compilerˉsourceˉgenericˉtypeˉlayout =
                Genericˉlayouts.Compilerˉsourceˉgenericˉtypeˉlayoutˉcreate(
                    Input, Scan, Symbols, Typeˉcatalog, Instance
                );
            if Layout.Shape != Shape || Layout.Fields > 64u32 ||
                Bytesˉlength(Layout.Fieldˉevidence) !=
                    Layout.Fields * 16u32 ||
                !Genericˉlayouts.Compilerˉsourceˉgenericˉtypeˉlayoutˉisˉvalid(
                    Input, Scan, Symbols, Layout
                ) {
                return false;
            }
            var Genericˉfield: u32 = 0u32;
            while Genericˉfield < Layout.Fields {
                if Compilerˉsourceˉwirˉshapeˉcontainsˉownedˉvectorˉat(
                    Input, Scan,
                    Bytesˉreadˉu32ˉlittle(
                        Layout.Fieldˉevidence, Genericˉfield * 16u32 + 8u32
                    ),
                    Symbols, Typeˉcatalog, Nextˉpath, Depth + 1u32
                ) { return true; }
                Genericˉfield = Genericˉfield + 1u32;
            }
        }
        return false;
    }
    if Shape >= 65536u32 && Shape < 131072u32 {
        let Nominal: Sourceˉsymbols.Compilerˉsourceˉsymbolˉmatch =
            Compilerˉsourceˉwirˉnominalˉbyˉshape(
                Input, Scan, Symbols, Shape
            );
        if !Nominal.Found { return false; }
        let Entry: u32 = 16u32 + Nominal.Directoryˉindex * 24u32;
        let Fields: u32 = Bytesˉreadˉu32ˉlittle(
            Symbols.Directory, Entry + 20u32
        );
        if Fields > 64u32 { return false; }
        let Callable: Sourceˉbindings.Compilerˉsourceˉbindingˉmatch =
            Sourceˉbindings.Compilerˉsourceˉbindingˉmatch(
                true, true,
                Sourceˉbindings.Compilerˉsourceˉcallableˉkind.Record,
                Nominal.Module, Fields, Nominal.Directoryˉindex
            );
        var Field: u32 = 0u32;
        while Field < Fields {
            let Signature: Compilerˉsourceˉwirˉsignature =
                Compilerˉsourceˉwirˉrecordˉsignature(
                    Input, Scan, Symbols, Callable, Field
                );
            if Compilerˉsourceˉwirˉshapeˉcontainsˉownedˉvectorˉat(
                Input, Scan, Signature.Parameterˉshape,
                Symbols, Typeˉcatalog, Nextˉpath, Depth + 1u32
            ) { return true; }
            Field = Field + 1u32;
        }
        return false;
    }
    if Shape >= 196608u32 + Symbols.Records + Symbols.Enums &&
        Shape < 196608u32 + Symbols.Records + Symbols.Enums +
            Symbols.Variants {
        let Variantˉnominal: u32 = Shape - 196608u32;
        let Directoryˉentry: u32 =
            Compilerˉsourceˉwirˉnominalˉdirectoryˉentry(
                Symbols, Variantˉnominal, 8u32
            );
        if Directoryˉentry == Wirˉconsumer.Compilerˉsourceˉwirˉsentinel() {
            return false;
        }
        let Cases: u32 = Bytesˉreadˉu32ˉlittle(
            Symbols.Directory, 16u32 + Directoryˉentry * 24u32 + 20u32
        );
        if Cases > 64u32 { return false; }
        var Case: u32 = 0u32;
        while Case < Cases {
            let View: Compilerˉsourceˉwirˉvariantˉcaseˉview =
                Compilerˉsourceˉwirˉvariantˉcaseˉviewˉbyˉindex(
                    Input, Scan, Symbols, Typeˉcatalog, Variantˉnominal, Case
                );
            if !View.Found || View.Fields > 64u32 { return false; }
            var Variantˉfield: u32 = 0u32;
            while Variantˉfield < View.Fields {
                let Member: Compilerˉsourceˉwirˉmember =
                    Compilerˉsourceˉwirˉvariantˉfieldˉbyˉindex(
                        Input, Scan, Symbols, Typeˉcatalog,
                        Variantˉnominal, Case, Variantˉfield
                    );
                if !Member.Found { return false; }
                if Compilerˉsourceˉwirˉshapeˉcontainsˉownedˉvectorˉat(
                    Input, Scan, Member.Shape, Symbols, Typeˉcatalog,
                    Nextˉpath, Depth + 1u32
                ) { return true; }
                Variantˉfield = Variantˉfield + 1u32;
            }
            Case = Case + 1u32;
        }
    }
    return false;
}

export fn Compilerˉsourceˉwirˉfixedˉarrayˉelementˉshape(
    Shape: u32,
    Typeˉcatalog: Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog
) -> u32 {
    if !Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalogˉshapeˉisˉkind(
            Typeˉcatalog, Shape, 10u32
        ) {
        return 0u32;
    }
    let Instance: u32 =
        Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉshapeˉinstance(Shape);
    let Argument: Sourceˉgenerics.Compilerˉsourceˉgenericˉargument =
        Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalogˉargument(
            Typeˉcatalog, Instance, 0u32
        );
    if !Argument.Valid || Argument.Kind != 1u32 ||
        Argument.Shape != 0u32 || Argument.High != 0u32 {
        return 0u32;
    }
    return Argument.Low;
}

export fn Compilerˉsourceˉwirˉfunctionˉsignatureˉconcrete(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Module: u32,
    Source: bytes,
    Declarationˉoffset: u32,
    Argument: u32,
    Catalog: Sourceˉgenerics.Compilerˉsourceˉgenericˉcatalog,
    Typeˉcatalog: Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog,
    Genericˉinstance: u32
) -> Compilerˉsourceˉwirˉsignature {
    // This reader returns shapes rather than source diagnostics. Starting the
    // target declaration at a relative position preserves token offsets while
    // avoiding a scan from the beginning of its module for every call argument.
    let Declarationˉposition: Sourceˉbodies.Compilerˉsourceˉposition =
        Sourceˉbodies.Compilerˉsourceˉposition(
            Declarationˉoffset, 1u32, 1u32
        );
    let Declaration: Sourceˉdeclarations.Compilerˉsourceˉdeclaration =
        Sourceˉdeclarations.Compilerˉparseˉnextˉdeclarationˉvalidated(
            Source, Declarationˉoffset,
            Declarationˉposition.Line, Declarationˉposition.Column, true
        );
    let Generic: Sourceˉsymbols.Compilerˉsourceˉfunctionˉgeneric =
        Sourceˉsymbols.Compilerˉsourceˉsymbolsˉfunctionˉgeneric(
            Source, Declaration,
            Declarationˉposition.Line, Declarationˉposition.Column
        );
    let Left: Sourceˉlexer.Compilerˉsourceˉtoken =
        Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Source, Generic.Signatureˉoffset,
            Generic.Signatureˉline, Generic.Signatureˉcolumn
        );
    var Cursor: u32 = Left.Nextˉoffset;
    var Currentˉline: u32 = Left.Nextˉline;
    var Currentˉcolumn: u32 = Left.Nextˉcolumn;
    var Parameterˉshape: u32 = 0u32;
    var Parameterˉmode: u32 =
        Sourceˉdeclarations.COMPILER_SOURCE_BORROW_MODE_VALUE;
    var Index: u32 = 0u32;
    var Reading: bool = true;
    while Reading {
        let Current: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Source, Cursor, Currentˉline, Currentˉcolumn
        );
        if Current.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Rightˉparenthesis {
            Reading = false;
            Cursor = Current.Nextˉoffset;
            Currentˉline = Current.Nextˉline;
            Currentˉcolumn = Current.Nextˉcolumn;
        } else {
            let Colon: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                Source, Current.Nextˉoffset, Current.Nextˉline, Current.Nextˉcolumn
            );
            let Parameterˉtype: Sourceˉlexer.Compilerˉsourceˉtoken =
                Sourceˉdeclarations.Compilerˉsourceˉparameterˉtypeˉstart(
                    Source, Colon.Nextˉoffset, Colon.Nextˉline,
                    Colon.Nextˉcolumn
                );
            let Currentˉparameterˉmode: u32 =
                Sourceˉdeclarations.Compilerˉsourceˉparameterˉborrowˉmode(
                    Source, Colon.Nextˉoffset, Colon.Nextˉline,
                    Colon.Nextˉcolumn
                );
            let Type: Sourceˉsymbols.Compilerˉsourceˉconcreteˉtype =
                Sourceˉsymbols.Compilerˉsourceˉsymbolsˉbindˉconcreteˉfunctionˉtype(
                    Input, Scan, Symbols.Directory, Symbols.Lookup,
                    Symbols.Visibility, Module, Source,
                    Parameterˉtype.Offset,
                    Parameterˉtype.Line,
                    Parameterˉtype.Column,
                    Symbols.Records, Symbols.Enums, Generic,
                    Catalog, Genericˉinstance, false
                );
            var Typeˉshape: u32 = Type.Shape;
            var Typeˉnextˉoffset: u32 = Type.Nextˉoffset;
            var Typeˉnextˉline: u32 = Type.Nextˉline;
            var Typeˉnextˉcolumn: u32 = Type.Nextˉcolumn;
            if Type.Status ==
                    Sourceˉsymbols.Compilerˉsourceˉsymbolˉstatus.Unknownˉtype &&
                Generic.Parameters == 0u32 {
                let General:
                    Genericˉtypeˉbinding.Compilerˉsourceˉgenericˉtypeˉbinding =
                    Genericˉtypeˉbinding.Compilerˉsourceˉgenericˉtypeˉbind(
                        Input, Scan, Symbols, Module, Source,
                        Parameterˉtype.Offset,
                        Parameterˉtype.Line,
                        Parameterˉtype.Column,
                        0u32, 0u32, 0u32, 0u32,
                        Typeˉcatalog
                    );
                Typeˉshape = General.Shape;
                Typeˉnextˉoffset = General.Nextˉoffset;
                Typeˉnextˉline = General.Nextˉline;
                Typeˉnextˉcolumn = General.Nextˉcolumn;
            }
            if Type.Status ==
                    Sourceˉsymbols.Compilerˉsourceˉsymbolˉstatus.Unknownˉtype &&
                Generic.Parameters > 0u32 &&
                Genericˉinstance != Wirˉconsumer.Compilerˉsourceˉwirˉsentinel() {
                let Specialized:
                    Genericˉtypeˉbinding.Compilerˉsourceˉgenericˉtypeˉbinding =
                    Genericˉtypeˉbinding.Compilerˉsourceˉgenericˉtypeˉbindˉfunctionˉspecialization(
                        Input, Scan, Symbols, Module, Source,
                        Parameterˉtype.Offset,
                        Parameterˉtype.Line,
                        Parameterˉtype.Column,
                        0u32, 0u32, 0u32, 0u32,
                        Typeˉcatalog, Source, Generic, Catalog, Genericˉinstance
                    );
                Typeˉshape = Specialized.Shape;
                Typeˉnextˉoffset = Specialized.Nextˉoffset;
                Typeˉnextˉline = Specialized.Nextˉline;
                Typeˉnextˉcolumn = Specialized.Nextˉcolumn;
            }
            if Index == Argument {
                Parameterˉshape = Typeˉshape;
                Parameterˉmode = Currentˉparameterˉmode;
            }
            let Separator: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                Source, Typeˉnextˉoffset, Typeˉnextˉline, Typeˉnextˉcolumn
            );
            if Separator.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Comma {
                Cursor = Separator.Nextˉoffset;
                Currentˉline = Separator.Nextˉline;
                Currentˉcolumn = Separator.Nextˉcolumn;
            } else {
                Cursor = Separator.Nextˉoffset;
                Currentˉline = Separator.Nextˉline;
                Currentˉcolumn = Separator.Nextˉcolumn;
                Reading = false;
            }
            Index = Index + 1u32;
        }
    }
    let Arrow: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
        Source, Cursor, Currentˉline, Currentˉcolumn
    );
    let Returnˉparameterˉtype: Sourceˉlexer.Compilerˉsourceˉtoken =
        Sourceˉdeclarations.Compilerˉsourceˉparameterˉtypeˉstart(
            Source, Arrow.Nextˉoffset, Arrow.Nextˉline,
            Arrow.Nextˉcolumn
        );
    let Returnˉmode: u32 =
        Sourceˉdeclarations.Compilerˉsourceˉparameterˉborrowˉmode(
            Source, Arrow.Nextˉoffset, Arrow.Nextˉline,
            Arrow.Nextˉcolumn
        );
    let Returnˉtype: Sourceˉsymbols.Compilerˉsourceˉconcreteˉtype =
        Sourceˉsymbols.Compilerˉsourceˉsymbolsˉbindˉconcreteˉfunctionˉtype(
            Input, Scan, Symbols.Directory, Symbols.Lookup,
            Symbols.Visibility, Module, Source,
            Returnˉparameterˉtype.Offset,
            Returnˉparameterˉtype.Line,
            Returnˉparameterˉtype.Column,
            Symbols.Records, Symbols.Enums, Generic,
            Catalog, Genericˉinstance, false
        );
    var Returnˉshape: u32 = Returnˉtype.Shape;
    if Returnˉtype.Status ==
            Sourceˉsymbols.Compilerˉsourceˉsymbolˉstatus.Unknownˉtype &&
        Generic.Parameters == 0u32 {
        let Generalˉreturn:
            Genericˉtypeˉbinding.Compilerˉsourceˉgenericˉtypeˉbinding =
            Genericˉtypeˉbinding.Compilerˉsourceˉgenericˉtypeˉbind(
                Input, Scan, Symbols, Module, Source,
                Returnˉparameterˉtype.Offset,
                Returnˉparameterˉtype.Line,
                Returnˉparameterˉtype.Column,
                0u32, 0u32, 0u32, 0u32,
                Typeˉcatalog
            );
        Returnˉshape = Generalˉreturn.Shape;
    }
    if Returnˉtype.Status ==
            Sourceˉsymbols.Compilerˉsourceˉsymbolˉstatus.Unknownˉtype &&
        Generic.Parameters > 0u32 &&
        Genericˉinstance != Wirˉconsumer.Compilerˉsourceˉwirˉsentinel() {
        let Specializedˉreturn:
            Genericˉtypeˉbinding.Compilerˉsourceˉgenericˉtypeˉbinding =
            Genericˉtypeˉbinding.Compilerˉsourceˉgenericˉtypeˉbindˉfunctionˉspecialization(
                Input, Scan, Symbols, Module, Source,
                Returnˉparameterˉtype.Offset,
                Returnˉparameterˉtype.Line,
                Returnˉparameterˉtype.Column,
                0u32, 0u32, 0u32, 0u32,
                Typeˉcatalog, Source, Generic, Catalog, Genericˉinstance
            );
        Returnˉshape = Specializedˉreturn.Shape;
    }
    return Compilerˉsourceˉwirˉsignature(
        Parameterˉshape, Returnˉshape, 0u32, 0u32,
        Parameterˉmode, Returnˉmode
    );
}

export fn Compilerˉsourceˉwirˉrecordˉsignature(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Callable: Sourceˉbindings.Compilerˉsourceˉbindingˉmatch,
    Argument: u32
) -> Compilerˉsourceˉwirˉsignature {
    let Entry: u32 = 16u32 + Callable.Directoryˉentry * 24u32;
    let Declarationˉoffset: u32 = Bytesˉreadˉu32ˉlittle(Symbols.Directory, Entry + 8u32);
    let Nameˉoffset: u32 = Bytesˉreadˉu32ˉlittle(Symbols.Directory, Entry + 12u32);
    let Nameˉlength: u32 = Bytesˉreadˉu32ˉlittle(Symbols.Directory, Entry + 16u32);
    let View: Sourceˉset.Compilerˉsourceˉsetˉview = Sourceˉset.Compilerˉsourceˉsetˉmodule(Input, Scan, Callable.Module);
    let Directoryˉentries: u32 = Bytesˉreadˉu32ˉlittle(Symbols.Directory, 8u32);
    let Nominals: u32 = Symbols.Records + Symbols.Enums + Symbols.Variants;
    let Nominalˉindex: u32 = Bytesˉreadˉu32ˉlittle(
        Symbols.Lookup,
        4112u32 + Directoryˉentries * 4u32 + Nominals * 4u32 + Callable.Directoryˉentry * 4u32
    );
    let Declarationˉposition: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
        View.Source, 0u32, 1u32, 1u32, Declarationˉoffset
    );
    let Declaration: Sourceˉdeclarations.Compilerˉsourceˉdeclaration = Sourceˉdeclarations.Compilerˉparseˉnextˉdeclarationˉvalidated(
        View.Source, Declarationˉoffset,
        Declarationˉposition.Line, Declarationˉposition.Column, true
    );
    let Bodyˉposition: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
        View.Source, Declarationˉoffset,
        Declarationˉposition.Line, Declarationˉposition.Column,
        Declaration.Bodyˉoffset
    );
    let Left: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
        View.Source, Declaration.Bodyˉoffset, Bodyˉposition.Line, Bodyˉposition.Column
    );
    var Cursor: u32 = Left.Nextˉoffset;
    var Currentˉline: u32 = Left.Nextˉline;
    var Currentˉcolumn: u32 = Left.Nextˉcolumn;
    var Parameterˉshape: u32 = 0u32;
    var Index: u32 = 0u32;
    while Index <= Argument {
        let Field: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            View.Source, Cursor, Currentˉline, Currentˉcolumn
        );
        let Colon: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            View.Source, Field.Nextˉoffset, Field.Nextˉline, Field.Nextˉcolumn
        );
        let Type: Sourceˉsymbols.Compilerˉsourceˉtypeˉbinding = Sourceˉsymbols.Compilerˉsourceˉsymbolsˉbindˉtype(
            Input, Scan, Symbols.Directory, Symbols.Lookup, Symbols.Visibility,
            Callable.Module, View.Source,
            Colon.Nextˉoffset, Colon.Nextˉline, Colon.Nextˉcolumn,
            Symbols.Records, Symbols.Enums, true
        );
        if Index == Argument {
            Parameterˉshape = Sourceˉbindings.Compilerˉsourceˉbindingsˉshape(Type);
        }
        let End: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            View.Source, Type.Nextˉoffset, Type.Nextˉline, Type.Nextˉcolumn
        );
        Cursor = End.Nextˉoffset;
        Currentˉline = End.Nextˉline;
        Currentˉcolumn = End.Nextˉcolumn;
        Index = Index + 1u32;
    }
    return Compilerˉsourceˉwirˉsignature(
        Parameterˉshape,
        65536u32 + Nominalˉindex,
        Nominalˉindex,
        Callable.Directoryˉentry,
        Sourceˉdeclarations.COMPILER_SOURCE_BORROW_MODE_VALUE,
        Sourceˉdeclarations.COMPILER_SOURCE_BORROW_MODE_VALUE
    );
}

export fn Compilerˉsourceˉwirˉnominalˉbyˉshape(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Shape: u32
) -> Sourceˉsymbols.Compilerˉsourceˉsymbolˉmatch {
    var Wanted: u32 = Shape - 65536u32;
    if Shape >= 131072u32 { Wanted = Shape - 131072u32; }
    if Shape >= 196608u32 { Wanted = Shape - 196608u32; }
    if Wanted >= Symbols.Records + Symbols.Enums + Symbols.Variants {
        return Sourceˉsymbols.Compilerˉsourceˉsymbolsˉmatchˉnone(Scan.Modules);
    }
    let Entries: u32 = Bytesˉreadˉu32ˉlittle(Symbols.Directory, 8u32);
    let Directoryˉindex: u32 = Bytesˉreadˉu32ˉlittle(
        Symbols.Lookup, 4112u32 + Entries * 4u32 + Wanted * 4u32
    );
    return Sourceˉsymbols.Compilerˉsourceˉsymbolsˉdirectoryˉentry(
        Symbols.Directory, Scan.Modules, Directoryˉindex
    );
}

export fn Compilerˉsourceˉwirˉnominalˉmember(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Nominal: Sourceˉsymbols.Compilerˉsourceˉsymbolˉmatch,
    Queryˉsource: bytes,
    Queryˉoffset: u32,
    Queryˉlength: u32
) -> Compilerˉsourceˉwirˉmember {
    if !Nominal.Found { return Compilerˉsourceˉwirˉmember(false, 0u32, 0u32); }
    let View: Sourceˉset.Compilerˉsourceˉsetˉview = Sourceˉset.Compilerˉsourceˉsetˉmodule(Input, Scan, Nominal.Module);
    let Declarationˉposition: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
        View.Source, 0u32, 1u32, 1u32, Nominal.Declarationˉoffset
    );
    let Declaration: Sourceˉdeclarations.Compilerˉsourceˉdeclaration = Sourceˉdeclarations.Compilerˉparseˉnextˉdeclarationˉvalidated(
        View.Source, Nominal.Declarationˉoffset,
        Declarationˉposition.Line, Declarationˉposition.Column, true
    );
    let Bodyˉposition: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
        View.Source, Nominal.Declarationˉoffset,
        Declarationˉposition.Line, Declarationˉposition.Column,
        Declaration.Bodyˉoffset
    );
    let Left: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
        View.Source, Declaration.Bodyˉoffset, Bodyˉposition.Line, Bodyˉposition.Column
    );
    var Cursor: u32 = Left.Nextˉoffset;
    var Currentˉline: u32 = Left.Nextˉline;
    var Currentˉcolumn: u32 = Left.Nextˉcolumn;
    var Index: u32 = 0u32;
    var Reading: bool = true;
    while Reading {
        let Member: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            View.Source, Cursor, Currentˉline, Currentˉcolumn
        );
        if Member.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Rightˉbrace {
            Reading = false;
        } else {
            if Member.Length == Queryˉlength {
                if Sourceˉset.Compilerˉsourceˉspansˉequal(
                    View.Source, Member.Offset, Member.Length,
                    Queryˉsource, Queryˉoffset, Queryˉlength
                ) {
                if Nominal.Kind == Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Enum {
                    let Directoryˉentries: u32 = Bytesˉreadˉu32ˉlittle(Symbols.Directory, 8u32);
                    let Nominals: u32 = Symbols.Records + Symbols.Enums + Symbols.Variants;
                    let Shape: u32 = 131072u32 + Bytesˉreadˉu32ˉlittle(
                        Symbols.Lookup,
                        4112u32 + Directoryˉentries * 4u32 + Nominals * 4u32 +
                            Nominal.Directoryˉindex * 4u32
                    );
                    return Compilerˉsourceˉwirˉmember(true, Index, Shape);
                }
                if Nominal.Kind == Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Variant {
                    let Afterˉname: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                        View.Source, Member.Nextˉoffset, Member.Nextˉline, Member.Nextˉcolumn
                    );
                    if Afterˉname.Kind != Sourceˉlexer.Compilerˉtokenˉkind.Leftˉparenthesis {
                        return Compilerˉsourceˉwirˉmember(true, Index, 0u32);
                    }
                    let Payloadˉname: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                        View.Source, Afterˉname.Nextˉoffset, Afterˉname.Nextˉline, Afterˉname.Nextˉcolumn
                    );
                    let Payloadˉcolon: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                        View.Source, Payloadˉname.Nextˉoffset, Payloadˉname.Nextˉline, Payloadˉname.Nextˉcolumn
                    );
                    let Payloadˉtype: Sourceˉsymbols.Compilerˉsourceˉtypeˉbinding = Sourceˉsymbols.Compilerˉsourceˉsymbolsˉbindˉtype(
                        Input, Scan, Symbols.Directory, Symbols.Lookup, Symbols.Visibility,
                        Nominal.Module, View.Source,
                        Payloadˉcolon.Nextˉoffset, Payloadˉcolon.Nextˉline, Payloadˉcolon.Nextˉcolumn,
                        Symbols.Records, Symbols.Enums, false
                    );
                    return Compilerˉsourceˉwirˉmember(
                        true, Index, Sourceˉbindings.Compilerˉsourceˉbindingsˉshape(Payloadˉtype)
                    );
                }
                let Matchedˉcolon: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                    View.Source, Member.Nextˉoffset, Member.Nextˉline, Member.Nextˉcolumn
                );
                let Matchedˉtype: Sourceˉsymbols.Compilerˉsourceˉtypeˉbinding = Sourceˉsymbols.Compilerˉsourceˉsymbolsˉbindˉtype(
                    Input, Scan, Symbols.Directory, Symbols.Lookup, Symbols.Visibility,
                    Nominal.Module, View.Source,
                    Matchedˉcolon.Nextˉoffset, Matchedˉcolon.Nextˉline, Matchedˉcolon.Nextˉcolumn,
                    Symbols.Records, Symbols.Enums, true
                );
                return Compilerˉsourceˉwirˉmember(
                    true, Index, Sourceˉbindings.Compilerˉsourceˉbindingsˉshape(Matchedˉtype)
                );
                }
            }
            if Nominal.Kind == Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Record {
                let Recordˉcolon: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                    View.Source, Member.Nextˉoffset, Member.Nextˉline, Member.Nextˉcolumn
                );
                let Recordˉtype: Sourceˉdeclarations.Compilerˉparseˉstep = Sourceˉdeclarations.Compilerˉparseˉtype(
                    View.Source, Recordˉcolon.Nextˉoffset, Recordˉcolon.Nextˉline, Recordˉcolon.Nextˉcolumn, false, false
                );
                let Recordˉend: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                    View.Source, Recordˉtype.Nextˉoffset, Recordˉtype.Nextˉline, Recordˉtype.Nextˉcolumn
                );
                Cursor = Recordˉend.Nextˉoffset;
                Currentˉline = Recordˉend.Nextˉline;
                Currentˉcolumn = Recordˉend.Nextˉcolumn;
            } else if Nominal.Kind == Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Enum {
                let Enumˉequals: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                    View.Source, Member.Nextˉoffset, Member.Nextˉline, Member.Nextˉcolumn
                );
                let Enumˉvalue: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                    View.Source, Enumˉequals.Nextˉoffset, Enumˉequals.Nextˉline, Enumˉequals.Nextˉcolumn
                );
                var Enumˉliteral: Sourceˉlexer.Compilerˉsourceˉtoken = Enumˉvalue;
                if Enumˉvalue.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Minus {
                    Enumˉliteral = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                        View.Source, Enumˉvalue.Nextˉoffset,
                        Enumˉvalue.Nextˉline, Enumˉvalue.Nextˉcolumn
                    );
                }
                let Enumˉend: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                    View.Source, Enumˉliteral.Nextˉoffset,
                    Enumˉliteral.Nextˉline, Enumˉliteral.Nextˉcolumn
                );
                Cursor = Enumˉend.Nextˉoffset;
                Currentˉline = Enumˉend.Nextˉline;
                Currentˉcolumn = Enumˉend.Nextˉcolumn;
            } else {
                let Variantˉafterˉname: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                    View.Source, Member.Nextˉoffset, Member.Nextˉline, Member.Nextˉcolumn
                );
                var Variantˉend: Sourceˉlexer.Compilerˉsourceˉtoken = Variantˉafterˉname;
                if Variantˉafterˉname.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Leftˉparenthesis {
                    var Fieldˉcursor: u32 = Variantˉafterˉname.Nextˉoffset;
                    var Fieldˉline: u32 = Variantˉafterˉname.Nextˉline;
                    var Fieldˉcolumn: u32 = Variantˉafterˉname.Nextˉcolumn;
                    var Readingˉfields: bool = true;
                    while Readingˉfields {
                        let Field: Sourceˉdeclarations.Compilerˉsourceˉvariantˉfield =
                            Sourceˉdeclarations.Compilerˉparseˉvariantˉfield(
                                View.Source, Fieldˉcursor, Fieldˉline,
                                Fieldˉcolumn
                            );
                        let Separator: Sourceˉlexer.Compilerˉsourceˉtoken =
                            Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                                View.Source, Field.Nextˉoffset,
                                Field.Nextˉline, Field.Nextˉcolumn
                            );
                        if Separator.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Comma {
                            let Memberˉafterˉcomma:
                                Sourceˉlexer.Compilerˉsourceˉtoken =
                                Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                                    View.Source, Separator.Nextˉoffset,
                                    Separator.Nextˉline,
                                    Separator.Nextˉcolumn
                                );
                            if Memberˉafterˉcomma.Kind ==
                                Sourceˉlexer.Compilerˉtokenˉkind.Rightˉparenthesis {
                                Readingˉfields = false;
                                Variantˉend =
                                    Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                                        View.Source,
                                        Memberˉafterˉcomma.Nextˉoffset,
                                        Memberˉafterˉcomma.Nextˉline,
                                        Memberˉafterˉcomma.Nextˉcolumn
                                    );
                            } else {
                                Fieldˉcursor = Separator.Nextˉoffset;
                                Fieldˉline = Separator.Nextˉline;
                                Fieldˉcolumn = Separator.Nextˉcolumn;
                            }
                        } else {
                            Readingˉfields = false;
                            Variantˉend = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                                View.Source, Separator.Nextˉoffset,
                                Separator.Nextˉline, Separator.Nextˉcolumn
                            );
                        }
                    }
                }
                Cursor = Variantˉend.Nextˉoffset;
                Currentˉline = Variantˉend.Nextˉline;
                Currentˉcolumn = Variantˉend.Nextˉcolumn;
            }
            Index = Index + 1u32;
        }
    }
    return Compilerˉsourceˉwirˉmember(false, 0u32, 0u32);
}

fn Compilerˉsourceˉwirˉgenericˉfoundationˉresultˉlayout(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Catalog: Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog,
    Shape: u32
) -> Compilerˉsourceˉwirˉmember {
    if !Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉshapeˉisˉprivate(
            Shape
        ) {
        return Compilerˉsourceˉwirˉmember(false, 0u32, 0u32);
    }
    let Instance: u32 =
        Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉshapeˉinstance(Shape);
    let Layout: Genericˉlayouts.Compilerˉsourceˉgenericˉtypeˉlayout =
        Genericˉlayouts.Compilerˉsourceˉgenericˉtypeˉlayoutˉcreate(
            Input, Scan, Symbols, Catalog, Instance
        );
    if Layout.Shape != Shape || Layout.Items != 2u32 || Layout.Fields != 2u32 ||
        Layout.Kind !=
            Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Variant ||
        !Genericˉlayouts.Compilerˉsourceˉgenericˉtypeˉlayoutˉisˉvalid(
            Input, Scan, Symbols, Layout
        ) {
        return Compilerˉsourceˉwirˉmember(false, 0u32, 0u32);
    }
    let Nominal: Sourceˉsymbols.Compilerˉsourceˉsymbolˉmatch =
        Sourceˉsymbols.Compilerˉsourceˉsymbolsˉdirectoryˉentry(
            Symbols.Directory, Scan.Modules, Layout.Declaration
        );
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉfoundationˉgenericˉfamily(
            Input, Scan, Nominal
        ) != 2u32 {
        return Compilerˉsourceˉwirˉmember(false, 0u32, 0u32);
    }
    let Valid: Genericˉlayouts.Compilerˉsourceˉgenericˉtypeˉcase =
        Genericˉlayouts.Compilerˉsourceˉgenericˉtypeˉlayoutˉvariantˉcase(
            Input, Scan, Symbols, Layout, 0u32
        );
    let Failure: Genericˉlayouts.Compilerˉsourceˉgenericˉtypeˉcase =
        Genericˉlayouts.Compilerˉsourceˉgenericˉtypeˉlayoutˉvariantˉcase(
            Input, Scan, Symbols, Layout, 1u32
        );
    let Value: Genericˉlayouts.Compilerˉsourceˉgenericˉtypeˉfield =
        Genericˉlayouts.Compilerˉsourceˉgenericˉtypeˉlayoutˉvariantˉfield(
            Input, Scan, Symbols, Layout, 0u32, 0u32
        );
    let Error: Genericˉlayouts.Compilerˉsourceˉgenericˉtypeˉfield =
        Genericˉlayouts.Compilerˉsourceˉgenericˉtypeˉlayoutˉvariantˉfield(
            Input, Scan, Symbols, Layout, 1u32, 0u32
        );
    if !Valid.Found || Valid.Fields != 1u32 ||
        !Failure.Found || Failure.Fields != 1u32 ||
        !Value.Found || !Error.Found {
        return Compilerˉsourceˉwirˉmember(false, 0u32, 0u32);
    }
    return Compilerˉsourceˉwirˉmember(
        true, Value.Shape, Error.Shape
    );
}

fn Compilerˉsourceˉwirˉisˉfoundationˉallocationˉfailure(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Shape: u32,
    Module: u32
) -> bool {
    if Shape < 65536u32 || Shape >= 131072u32 || Module >= Scan.Modules {
        return false;
    }
    let Nominal: Sourceˉsymbols.Compilerˉsourceˉsymbolˉmatch =
        Compilerˉsourceˉwirˉnominalˉbyˉshape(
            Input, Scan, Symbols, Shape
        );
    if !Nominal.Found || Nominal.Module != Module || Nominal.Kind !=
            Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Record {
        return false;
    }
    let View: Sourceˉset.Compilerˉsourceˉsetˉview =
        Sourceˉset.Compilerˉsourceˉsetˉmodule(Input, Scan, Module);
    if View.Edition != 1u32 { return false; }
    let Header: Sourceˉdeclarations.Compilerˉsourceˉheader =
        Sourceˉdeclarations.Compilerˉparseˉheaderˉvalidated(
            View.Source
        );
    if !Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(
            View.Source, Header.Nameˉoffset, Header.Nameˉlength,
            "Foundationˉmemory"
        ) ||
        !Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(
            View.Source, Nominal.Nameˉoffset, Nominal.Nameˉlength,
            "Allocationˉfailure"
        ) {
        return false;
    }
    let Declaration: Sourceˉdeclarations.Compilerˉsourceˉdeclaration =
        Sourceˉdeclarations.Compilerˉparseˉnextˉdeclarationˉvalidated(
            View.Source, Nominal.Declarationˉoffset, 1u32, 1u32, true
        );
    if Declaration.Kind !=
            Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Record ||
        Declaration.Items != 3u32 {
        return false;
    }
    let Reason: Compilerˉsourceˉwirˉmember =
        Compilerˉsourceˉwirˉnominalˉmember(
            Input, Scan, Symbols, Nominal,
            Textˉtoˉutf8("Reason"), 0u32, 6u32
        );
    let Requested: Compilerˉsourceˉwirˉmember =
        Compilerˉsourceˉwirˉnominalˉmember(
            Input, Scan, Symbols, Nominal,
            Textˉtoˉutf8("Requestedˉbytes"), 0u32, 16u32
        );
    let Available: Compilerˉsourceˉwirˉmember =
        Compilerˉsourceˉwirˉnominalˉmember(
            Input, Scan, Symbols, Nominal,
            Textˉtoˉutf8("Availableˉbytes"), 0u32, 16u32
        );
    if !Reason.Found || Reason.Index != 0u32 ||
        !Requested.Found || Requested.Index != 1u32 || Requested.Shape != 8u32 ||
        !Available.Found || Available.Index != 2u32 || Available.Shape != 8u32 {
        return false;
    }
    let Reasonˉnominal: Sourceˉsymbols.Compilerˉsourceˉsymbolˉmatch =
        Compilerˉsourceˉwirˉnominalˉbyˉshape(
            Input, Scan, Symbols, Reason.Shape
        );
    return Reasonˉnominal.Found && Reasonˉnominal.Module == Module &&
        Reasonˉnominal.Kind ==
            Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Enum &&
        Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(
            View.Source,
            Reasonˉnominal.Nameˉoffset, Reasonˉnominal.Nameˉlength,
            "Allocationˉreason"
        );
}

fn Compilerˉsourceˉwirˉisˉfoundationˉcollectionˉfailure(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Typeˉcatalog: Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog,
    Shape: u32,
    Module: u32
) -> bool {
    if Shape < 196608u32 || Shape >= 262144u32 || Module >= Scan.Modules {
        return false;
    }
    let Nominal: Sourceˉsymbols.Compilerˉsourceˉsymbolˉmatch =
        Compilerˉsourceˉwirˉnominalˉbyˉshape(
            Input, Scan, Symbols, Shape
        );
    if !Nominal.Found || Nominal.Module != Module || Nominal.Kind !=
            Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Variant {
        return false;
    }
    let View: Sourceˉset.Compilerˉsourceˉsetˉview =
        Sourceˉset.Compilerˉsourceˉsetˉmodule(Input, Scan, Module);
    if View.Edition != 1u32 { return false; }
    let Header: Sourceˉdeclarations.Compilerˉsourceˉheader =
        Sourceˉdeclarations.Compilerˉparseˉheaderˉvalidated(View.Source);
    if !Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(
            View.Source, Header.Nameˉoffset, Header.Nameˉlength,
            "Foundationˉcollections"
        ) ||
        !Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(
            View.Source, Nominal.Nameˉoffset, Nominal.Nameˉlength,
            "Collectionˉfailure"
        ) {
        return false;
    }
    let Declaration: Sourceˉdeclarations.Compilerˉsourceˉdeclaration =
        Sourceˉdeclarations.Compilerˉparseˉnextˉdeclarationˉvalidated(
            View.Source, Nominal.Declarationˉoffset, 1u32, 1u32, true
        );
    if Declaration.Kind !=
            Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Variant ||
        Declaration.Items != 10u32 {
        return false;
    }

    var Caseˉindex: u32 = 0u32;
    while Caseˉindex < 10u32 {
        var Expectedˉname: bytes = Textˉtoˉutf8("Retired");
        if Caseˉindex == 0u32 {
            Expectedˉname = Textˉtoˉutf8("Invalidˉlimit");
        }
        if Caseˉindex == 1u32 {
            Expectedˉname = Textˉtoˉutf8("Allocation");
        }
        if Caseˉindex == 2u32 {
            Expectedˉname = Textˉtoˉutf8("Capacityˉexhausted");
        }
        if Caseˉindex == 3u32 {
            Expectedˉname = Textˉtoˉutf8("Duplicate");
        }
        if Caseˉindex == 4u32 {
            Expectedˉname = Textˉtoˉutf8("Comparisonˉlimit");
        }
        if Caseˉindex == 5u32 {
            Expectedˉname = Textˉtoˉutf8("Wrongˉarena");
        }
        if Caseˉindex == 6u32 {
            Expectedˉname = Textˉtoˉutf8("Slotˉoutˉofˉrange");
        }
        if Caseˉindex == 7u32 {
            Expectedˉname = Textˉtoˉutf8("Vacant");
        }
        if Caseˉindex == 8u32 {
            Expectedˉname = Textˉtoˉutf8("Staleˉgeneration");
        }
        let Namedˉcase: Compilerˉsourceˉwirˉmember =
            Compilerˉsourceˉwirˉnominalˉmember(
                Input, Scan, Symbols, Nominal,
                Expectedˉname, 0u32, Bytesˉlength(Expectedˉname)
            );
        let Caseˉview: Compilerˉsourceˉwirˉvariantˉcaseˉview =
            Compilerˉsourceˉwirˉvariantˉcaseˉviewˉbyˉindex(
                Input, Scan, Symbols, Typeˉcatalog,
                Shape - 196608u32, Caseˉindex
            );
        var Expectedˉfields: u32 = 1u32;
        if Caseˉindex == 0u32 { Expectedˉfields = 4u32; }
        if Caseˉindex == 3u32 || Caseˉindex == 5u32 {
            Expectedˉfields = 0u32;
        }
        if Caseˉindex == 6u32 || Caseˉindex == 8u32 {
            Expectedˉfields = 2u32;
        }
        if !Namedˉcase.Found || Namedˉcase.Index != Caseˉindex ||
            !Caseˉview.Found || Caseˉview.Fields != Expectedˉfields {
            return false;
        }
        var Caseˉfieldˉindex: u32 = 0u32;
        while Caseˉfieldˉindex < Expectedˉfields {
            let Caseˉfield: Compilerˉsourceˉwirˉmember =
                Compilerˉsourceˉwirˉvariantˉfieldˉbyˉindex(
                    Input, Scan, Symbols, Typeˉcatalog,
                    Shape - 196608u32,
                    Caseˉindex, Caseˉfieldˉindex
                );
            if !Caseˉfield.Found { return false; }
            if Caseˉindex == 1u32 {
                let Allocationˉnominal: Sourceˉsymbols.Compilerˉsourceˉsymbolˉmatch =
                    Compilerˉsourceˉwirˉnominalˉbyˉshape(
                        Input, Scan, Symbols, Caseˉfield.Shape
                    );
                if !Allocationˉnominal.Found ||
                    !Compilerˉsourceˉwirˉisˉfoundationˉallocationˉfailure(
                        Input, Scan, Symbols,
                        Caseˉfield.Shape, Allocationˉnominal.Module
                    ) {
                    return false;
                }
            } else {
                var Expectedˉshape: u32 = 8u32;
                if Caseˉindex == 0u32 && Caseˉfieldˉindex == 0u32 {
                    Expectedˉshape = 3u32;
                }
                if Caseˉfield.Shape != Expectedˉshape { return false; }
            }
            Caseˉfieldˉindex = Caseˉfieldˉindex + 1u32;
        }
        Caseˉindex = Caseˉindex + 1u32;
    }
    return true;
}

fn Compilerˉsourceˉwirˉvectorˉappendˉfailureˉelement(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Typeˉcatalog: Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog,
    Shape: u32
) -> u32 {
    if !Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉshapeˉisˉprivate(
            Shape
        ) {
        return Wirˉconsumer.Compilerˉsourceˉwirˉsentinel();
    }
    let Instance: u32 =
        Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉshapeˉinstance(Shape);
    let Layout: Genericˉlayouts.Compilerˉsourceˉgenericˉtypeˉlayout =
        Genericˉlayouts.Compilerˉsourceˉgenericˉtypeˉlayoutˉcreate(
            Input, Scan, Symbols, Typeˉcatalog, Instance
        );
    if Layout.Shape != Shape || Layout.Module >= Scan.Modules ||
        Layout.Items != 2u32 ||
        Layout.Fields != 2u32 || Layout.Kind !=
            Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Record ||
        !Genericˉlayouts.Compilerˉsourceˉgenericˉtypeˉlayoutˉisˉvalid(
            Input, Scan, Symbols, Layout
        ) {
        return Wirˉconsumer.Compilerˉsourceˉwirˉsentinel();
    }
    let Nominal: Sourceˉsymbols.Compilerˉsourceˉsymbolˉmatch =
        Sourceˉsymbols.Compilerˉsourceˉsymbolsˉdirectoryˉentry(
            Symbols.Directory, Scan.Modules, Layout.Declaration
        );
    let View: Sourceˉset.Compilerˉsourceˉsetˉview =
        Sourceˉset.Compilerˉsourceˉsetˉmodule(Input, Scan, Layout.Module);
    let Header: Sourceˉdeclarations.Compilerˉsourceˉheader =
        Sourceˉdeclarations.Compilerˉparseˉheaderˉvalidated(View.Source);
    if View.Edition != 1u32 || !Nominal.Found ||
        Nominal.Module != Layout.Module ||
        !Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(
            View.Source, Header.Nameˉoffset, Header.Nameˉlength,
            "Foundationˉcollections"
        ) ||
        !Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(
            View.Source, Nominal.Nameˉoffset, Nominal.Nameˉlength,
            "Vectorˉappendˉfailure"
        ) {
        return Wirˉconsumer.Compilerˉsourceˉwirˉsentinel();
    }
    let Error: Genericˉlayouts.Compilerˉsourceˉgenericˉtypeˉfield =
        Genericˉlayouts.Compilerˉsourceˉgenericˉtypeˉlayoutˉrecordˉfield(
            Input, Scan, Symbols, Layout, 0u32
        );
    let Value: Genericˉlayouts.Compilerˉsourceˉgenericˉtypeˉfield =
        Genericˉlayouts.Compilerˉsourceˉgenericˉtypeˉlayoutˉrecordˉfield(
            Input, Scan, Symbols, Layout, 1u32
        );
    if !Error.Found || !Value.Found ||
        !Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(
            View.Source, Error.Nameˉoffset, Error.Nameˉlength, "Error"
        ) ||
        !Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(
            View.Source, Value.Nameˉoffset, Value.Nameˉlength, "Value"
        ) ||
        !Compilerˉsourceˉwirˉisˉfoundationˉcollectionˉfailure(
            Input, Scan, Symbols, Typeˉcatalog, Error.Shape, Layout.Module
        ) {
        return Wirˉconsumer.Compilerˉsourceˉwirˉsentinel();
    }
    return Value.Shape;
}

export fn Compilerˉsourceˉwirˉoperationˉresultˉisˉvalid(
    Operation: u32,
    Shape: u32
) -> bool {
    if Operation == 1u32 { return Shape == 1u32; }
    if Operation == 2u32 { return Shape == 2u32; }
    if Operation == 3u32 {
        if Shape == 3u32 { return true; }
        if Shape >= 268435456u32 { return Shape < 268439552u32; }
        return false;
    }
    if Operation == 4u32 { return Shape == 4u32; }
    if Operation == 5u32 { return Shape == 5u32; }
    if Operation == 6u32 { return Shape == 6u32; }
    if Operation == 7u32 { return Shape != 0u32; }
    if Operation == 8u32 { return Shape == 0u32; }
    if Operation == 9u32 { return Shape == 1u32; }
    if Operation == 10u32 { return Shape == 1u32; }
    if Operation == 11u32 { return Shape == 3u32; }
    if Operation == 12u32 { return Shape == 6u32; }
    if Operation == 13u32 { return Shape == 2u32; }
    if Operation == 14u32 { return Shape == 3u32; }
    if Operation == 15u32 { return Shape == 3u32; }
    if Operation == 16u32 { return Shape == 1u32; }
    if Operation == 17u32 {
        if Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉshapeˉisˉprivate(
                Shape
            ) {
            return true;
        }
        if Shape >= 65536u32 { return Shape < 131072u32; }
        return false;
    }
    if Operation == 18u32 { return Shape != 0u32; }
    if Operation == 19u32 {
        if Shape >= 131072u32 { return Shape < 196608u32; }
        return false;
    }
    if Operation == 20u32 { return Shape == 4u32; }
    if Operation == 21u32 { return Shape == 4u32; }
    if Operation == 22u32 { return Shape == 5u32; }
    if Operation == 23u32 { return Shape == 5u32; }
    if Operation == 24u32 { return Shape == 5u32; }
    if Operation == 25u32 { return Shape == 5u32; }
    if Operation == 26u32 { return Shape == 3u32; }
    if Operation == 27u32 { return Shape == 5u32; }
    if Operation == 28u32 { return Shape == 4u32; }
    if Operation == 29u32 { return Shape == 5u32; }
    if Operation == 30u32 { return Shape == 5u32; }
    if Operation == 31u32 { return Shape == 6u32; }
    if Operation == 32u32 { return Shape == 6u32; }
    if Operation == 33u32 { return Shape == 6u32; }
    if Operation == 34u32 { return Shape == 6u32; }
    if Operation == 35u32 { return Shape == 6u32; }
    if Operation == 36u32 { return Shape == 5u32; }
    if Operation == 37u32 { return Shape == 6u32; }
    if Operation >= 38u32 {
        if Operation <= 41u32 { return Shape == 1u32; }
    }
    if Operation >= 42u32 {
        if Operation <= 44u32 { return Shape == 3u32; }
    }
    if Operation >= 45u32 {
        if Operation <= 61u32 { return Shape == 4u32; }
    }
    if Operation == 62u32 { return true; }
    if Operation == 63u32 { return true; }
    if Operation == 64u32 { return Shape != 0u32 && Shape != 10u32; }
    if Operation == 65u32 { return Shape >= 196608u32; }
    if Operation == 66u32 { return Shape == 4u32; }
    if Operation == 67u32 { return Shape != 0u32; }
    if Operation == 68u32 { return Wirˉconsumer.Compilerˉsourceˉwirˉshapeˉisˉbuilder(Shape); }
    if Operation == 69u32 { return Wirˉconsumer.Compilerˉsourceˉwirˉshapeˉisˉbuilder(Shape); }
    if Operation == 70u32 { return Wirˉconsumer.Compilerˉsourceˉwirˉshapeˉisˉsequence(Shape); }
    if Operation == 71u32 { return Shape == 3u32; }
    if Operation == 72u32 { return Shape != 0u32; }
    if Operation == 73u32 { return Shape == 1u32; }
    if Operation == 74u32 { return Shape == 1u32; }
    if Operation == 75u32 { return Shape == 3u32; }
    if Operation == 76u32 { return Shape == 3u32; }
    if Operation >= 77u32 {
        if Operation <= 82u32 { return Shape == 2u32; }
    }
    if Operation >= 83u32 {
        if Operation <= 88u32 { return Shape == 3u32; }
    }
    if Operation >= 89u32 {
        if Operation <= 92u32 { return Shape == 4u32; }
    }
    if Operation == 93u32 { return Shape == 7u32; }
    if Operation == 94u32 { return Shape == 8u32; }
    if Operation == 95u32 || Operation == 96u32 { return Shape == 5u32; }
    if Operation >= 97u32 {
        if Operation <= 100u32 { return Shape == 7u32; }
    }
    if Operation >= 101u32 {
        if Operation <= 103u32 { return Shape == 8u32; }
    }
    if Operation >= 104u32 {
        if Operation <= 115u32 { return Shape == 4u32; }
    }
    if Operation == 116u32 || Operation == 117u32 { return Shape == 7u32; }
    if Operation >= 118u32 {
        if Operation <= 125u32 { return Shape == 8u32; }
    }
    if Operation == 126u32 { return Shape == 8u32; }
    if Operation == 127u32 { return Shape == 6u32; }
    if Operation == 128u32 { return Shape == 8u32; }
    if Operation == 129u32 {
        return Shape >= 11u32 && Shape <= 13u32;
    }
    if Operation >= 130u32 {
        if Operation <= 134u32 {
            return Shape >= 11u32 && Shape <= 13u32;
        }
    }
    if Operation == 135u32 { return Shape == 11u32 || Shape == 12u32; }
    if Operation >= 136u32 {
        if Operation <= 141u32 { return Shape == 4u32; }
    }
    if Operation >= 142u32 {
        if Operation <= 147u32 { return Shape == 13u32; }
    }
    if Operation == 148u32 { return Shape == 16u32; }
    if Operation == 149u32 || Operation == 150u32 { return Shape == 4u32; }
    if Operation == 151u32 { return Shape == 14u32 || Shape == 15u32; }
    if Operation >= 152u32 {
        if Operation <= 156u32 { return Shape == 14u32 || Shape == 15u32; }
    }
    if Operation >= 157u32 {
        if Operation <= 162u32 { return Shape == 4u32; }
    }
    if Operation == 163u32 { return Shape == 9u32; }
    if Operation == 164u32 { return Shape != 0u32; }
    if Operation == 165u32 { return Shape != 0u32; }
    if Operation == 166u32 { return Shape != 0u32; }
    if Operation == 167u32 { return Shape == 8u32; }
    if Operation == 168u32 { return Shape != 0u32; }
    if Operation == 169u32 { return Shape == 8u32; }
    if Operation == 170u32 { return Shape != 0u32; }
    if Operation == 171u32 { return Shape != 0u32; }
    if Operation == 172u32 { return Shape != 0u32; }
    if Operation == 173u32 { return Shape != 0u32; }
    if Operation == 174u32 { return Shape == 0u32; }
    if Operation == 175u32 { return Shape != 0u32; }
    if Operation == 176u32 { return Shape == 8u32; }
    if Operation == WIR_OPERATION_FUNCTION_REFERENCE {
        return Shape >= WIR_FUNCTION_TYPE_SHAPE_BASE &&
            Shape < WIR_FUNCTION_TYPE_SHAPE_BASE +
                WIR_FUNCTION_TYPE_INSTANCE_LIMIT;
    }
    if Operation == WIR_OPERATION_CALL_INDIRECT {
        return Shape != 0u32 && Shape != 10u32;
    }
    return false;
}

export fn Compilerˉsourceˉwirˉoperationˉoperandˉcountˉisˉvalid(
    Operation: u32,
