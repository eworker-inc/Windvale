    }
    if Operation == 62u32 { return true; }
    if Operation == 63u32 { return true; }
    if Operation == 64u32 { return Count == 2u32; }
    if Operation == 65u32 { return Count <= 64u32; }
    if Operation == 66u32 { return Count == 1u32; }
    if Operation == 67u32 { return Count == 1u32; }
    if Operation == 68u32 { return Count == 0u32; }
    if Operation == 69u32 { return Count == 2u32; }
    if Operation == 70u32 { return Count == 1u32; }
    if Operation == 71u32 { return Count == 1u32; }
    if Operation == 72u32 { return Count == 2u32; }
    if Operation >= 73u32 {
        if Operation <= 79u32 { return Count == 2u32; }
    }
    if Operation == 80u32 { return Count == 1u32; }
    if Operation >= 81u32 {
        if Operation <= 85u32 { return Count == 2u32; }
    }
    if Operation == 86u32 { return Count == 1u32; }
    if Operation >= 87u32 {
        if Operation <= 92u32 { return Count == 2u32; }
    }
    if Operation == 93u32 || Operation == 94u32 { return Count == 0u32; }
    if Operation == 95u32 || Operation == 96u32 { return Count == 1u32; }
    if Operation >= 97u32 {
        if Operation <= 99u32 { return Count == 2u32; }
    }
    if Operation == 100u32 { return Count == 1u32; }
    if Operation >= 101u32 {
        if Operation <= 122u32 { return Count == 2u32; }
    }
    if Operation == 123u32 { return Count == 1u32; }
    if Operation == 124u32 || Operation == 125u32 { return Count == 2u32; }
    if Operation == 126u32 { return Count == 2u32; }
    if Operation == 127u32 { return Count == 1u32; }
    if Operation == 128u32 { return Count == 1u32; }
    if Operation == 129u32 { return Count == 0u32; }
    if Operation >= 130u32 {
        if Operation <= 134u32 { return Count == 2u32; }
    }
    if Operation == 135u32 { return Count == 1u32; }
    if Operation >= 136u32 {
        if Operation <= 144u32 { return Count == 2u32; }
    }
    if Operation == 145u32 { return Count == 1u32; }
    if Operation == 146u32 || Operation == 147u32 { return Count == 2u32; }
    if Operation == 148u32 { return Count == 0u32; }
    if Operation == 149u32 || Operation == 150u32 { return Count == 2u32; }
    if Operation == 151u32 { return Count == 0u32; }
    if Operation >= 152u32 {
        if Operation <= 155u32 { return Count == 2u32; }
    }
    if Operation == 156u32 { return Count == 1u32; }
    if Operation >= 157u32 {
        if Operation <= 162u32 { return Count == 2u32; }
    }
    if Operation == 163u32 { return Count == 0u32; }
    if Operation == 164u32 { return Count == 1u32; }
    if Operation == 165u32 { return Count <= 64u32; }
    if Operation == 166u32 { return Count == 2u32; }
    if Operation == 167u32 { return Count == 1u32; }
    if Operation == 168u32 { return Count == 2u32; }
    if Operation == 169u32 || Operation == 170u32 { return Count == 0u32; }
