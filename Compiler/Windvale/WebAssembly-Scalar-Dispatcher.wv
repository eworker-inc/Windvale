export fn Compilerˉwebassemblyˉscalarˉdispatcherˉemitˉsegmentedˉartifact(
    Input: bytes,
    Codeˉoffset: u32,
    Codeˉlength: u32,
    Directory: Functions.Compilerˉwebassemblyˉfunctionˉdirectoryˉsummary,
    Types: Typeˉdirectory.Compilerˉwebassemblyˉtypeˉdirectoryˉsummary,
    Graph: Graphs.Compilerˉwebassemblyˉexecutableˉgraphˉsummary,
    Control: Controls.Compilerˉwebassemblyˉcontrolˉflowˉsummary,
    Enumˉsummary: Enums.Compilerˉwebassemblyˉenumˉsummary,
    Storage: Recordˉstorage.Compilerˉwebassemblyˉrecordˉstorageˉsummary
) -> Compilerˉwebassemblyˉscalarˉdispatcherˉsummary {
    return Emitˉmode(
        Input,
        Codeˉoffset,
        Codeˉlength,
        Directory,
        Types,
        Graph,
        Control,
        Enumˉsummary,
        Storage,
        4194304u32,
        true
    );
}
