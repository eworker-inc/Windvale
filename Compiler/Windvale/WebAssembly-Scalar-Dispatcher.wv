export record Compilerˉwebassemblyˉscalarˉdispatcherˉsummary {
    Valid: bool;
    Totalˉlength: u32;
    Webassembly: bytes;
    Segment1: bytes;
    Segment2: bytes;
    Segment3: bytes;
    Segment4: bytes;
    Segment5: bytes;
    Segment6: bytes;
    Segment7: bytes;
    Segment8: bytes;
    Segment9: bytes;
    Segment10: bytes;
    Segment11: bytes;
    Segment12: bytes;
    Segment13: bytes;
    Segment14: bytes;
    Segment15: bytes;
    Segment16: bytes;
    Segment17: bytes;
    Segment18: bytes;
    Segment19: bytes;
    Segment20: bytes;
    Segment21: bytes;
    Segment22: bytes;
    Segment23: bytes;
    Segment24: bytes;
    Segment25: bytes;
    Segment26: bytes;
    Segment27: bytes;
    Segment28: bytes;
    Segment29: bytes;
    Segment30: bytes;
    Segment31: bytes;
    Segment32: bytes;
    Segment33: bytes;
}

record Positionˉlookup {
    Found: bool;
    Position: u32;
}

record Emission {
    Valid: bool;
    Bytes: bytes;
    Failureˉoffset: u32;
    Failureˉopcode: u32;
}

record Runtimeˉhelpers {
    Hasˉdynamic: bool;
    Hasˉutf8: bool;
    Allocateˉfunction: u32;
    Referenceˉfunction: u32;
    Utf8ˉfunction: u32;
    Meterˉfunction: u32;
    Maximumˉbytes: u32;
    Frameˉlimit: u32;
}

fn Empty(Input: bytes) -> bytes {
    return Bytesˉslice(Input, 0u32, 0u32);
}

fn Codeˉsegmentˉlength(
    Block0: Artifactˉsegments.Compilerˉwebassemblyˉartifactˉsegmentˉblock,
    Block1: Artifactˉsegments.Compilerˉwebassemblyˉartifactˉsegmentˉblock,
    Block2: Artifactˉsegments.Compilerˉwebassemblyˉartifactˉsegmentˉblock,
    Block3: Artifactˉsegments.Compilerˉwebassemblyˉartifactˉsegmentˉblock,
    Segment: u32
) -> u32 {
    let Blockˉsegment: u32 = Segment % 10u32;
    if Segment < 10u32 {
        return Artifactˉsegments.Compilerˉwebassemblyˉartifactˉsegmentˉblockˉitemˉlength(
            Block0,
            Blockˉsegment
        );
    }
    if Segment < 20u32 {
        return Artifactˉsegments.Compilerˉwebassemblyˉartifactˉsegmentˉblockˉitemˉlength(
            Block1,
            Blockˉsegment
        );
    }
    if Segment < 30u32 {
        return Artifactˉsegments.Compilerˉwebassemblyˉartifactˉsegmentˉblockˉitemˉlength(
            Block2,
            Blockˉsegment
        );
    }
    return Artifactˉsegments.Compilerˉwebassemblyˉartifactˉsegmentˉblockˉitemˉlength(
        Block3,
        Blockˉsegment
    );
}

fn Invalid(
    Input: bytes,
    Function: u32,
    Offset: u32,
    Opcode: u32
) -> Compilerˉwebassemblyˉscalarˉdispatcherˉsummary {
    return Compilerˉwebassemblyˉscalarˉdispatcherˉsummary(
        false,
        0u32,
        Empty(Input),
        Empty(Input),
        Empty(Input),
        Empty(Input),
        Empty(Input),
        Empty(Input),
        Empty(Input),
        Empty(Input),
        Empty(Input),
        Empty(Input),
        Empty(Input),
        Empty(Input),
        Empty(Input),
        Empty(Input),
        Empty(Input),
        Empty(Input),
        Empty(Input),
        Empty(Input),
        Empty(Input),
        Empty(Input),
        Empty(Input),
        Empty(Input),
        Empty(Input),
        Empty(Input),
        Empty(Input),
        Empty(Input),
        Empty(Input),
        Empty(Input),
        Empty(Input),
        Empty(Input),
        Empty(Input),
        Empty(Input),
        Empty(Input),
        Empty(Input)
    );
}

fn Invalidˉemission(Input: bytes, Offset: u32, Opcode: u32) -> Emission {
    return Emission(false, Empty(Input), Offset, Opcode);
}

fn Append(First: bytes, Second: bytes) -> bytes {
    return Bytesˉconcat(First, Second);
}

fn Byte(Value: u32) -> bytes {
    return Encoding.Compilerˉwebassemblyˉbinaryˉbyte(Value);
}

fn Uleb(Value: u32) -> bytes {
    return Encoding.Compilerˉwebassemblyˉbinaryˉuleb32(Value);
}

fn Indexed(Opcode: u32, Index: u32) -> bytes {
    return Encoding.Compilerˉwebassemblyˉbinaryˉindexedˉinstruction(
        Opcode,
        Index
    );
}

fn Positiveˉconstant(Value: u32) -> bytes {
    return Encoding.Compilerˉwebassemblyˉbinaryˉpositiveˉi32ˉconstant(
        Value
    );
}

fn I32ˉminimumˉconstant() -> bytes {
    var Result: bytes = Byte(65u32);
    Result = Append(Result, Byte(128u32));
    Result = Append(Result, Byte(128u32));
    Result = Append(Result, Byte(128u32));
    Result = Append(Result, Byte(128u32));
    return Append(Result, Byte(120u32));
}

fn Globalˉi32(Mutable: bool, Initial: u32) -> bytes {
    var Result: bytes = Byte(127u32);
    if Mutable {
        Result = Append(Result, Byte(1u32));
    } else {
        Result = Append(Result, Byte(0u32));
    }
    Result = Append(Result, Positiveˉconstant(Initial));
    return Append(Result, Byte(11u32));
}

fn Exportˉentry(Name: text, Kind: u32, Index: u32) -> bytes {
    var Result: bytes = Encoding.Compilerˉwebassemblyˉbinaryˉname(
        Textˉtoˉutf8(Name)
    );
    Result = Append(Result, Byte(Kind));
    return Append(Result, Uleb(Index));
}

fn Shapeˉkind(Input: bytes, Offset: u32) -> u32 {
    return U32ˉfromˉu8(Bytesˉreadˉu8(Input, Offset));
}

fn Shapeˉwidth(Input: bytes, Offset: u32) -> u32 {
    let Kind: u32 = Shapeˉkind(Input, Offset);
    if Kind == 7u32 || Kind == 8u32 || Kind == 11u32 { return 5u32; }
    if Kind == 12u32 || Kind == 13u32 {
        let Element: u32 = Shapeˉkind(Input, Offset + 1u32);
        if Element == 7u32 || Element == 8u32 || Element == 11u32 {
            return 10u32;
        }
        return 6u32;
    }
    return 1u32;
}

fn Shapeˉoffsetˉat(Input: bytes, Start: u32, Index: u32) -> u32 {
    var Cursor: u32 = Start;
    var Current: u32 = 0u32;
    while Current < Index {
        Cursor = Cursor + Shapeˉwidth(Input, Cursor);
        Current = Current + 1u32;
    }
    return Cursor;
}

fn Localˉshapeˉoffset(
    Input: bytes,
    Directory: Functions.Compilerˉwebassemblyˉfunctionˉdirectoryˉsummary,
    Function: u32,
    Local: u32
) -> u32 {
    let Parameters: u32 =
        Functions.Compilerˉwebassemblyˉfunctionˉparameterˉcount(
            Directory,
            Function
        );
    if Local < Parameters {
        return Shapeˉoffsetˉat(
            Input,
            Functions.Compilerˉwebassemblyˉfunctionˉparameterˉtypesˉoffset(
                Directory,
                Function
            ),
            Local
        );
    }
    return Shapeˉoffsetˉat(
        Input,
        Functions.Compilerˉwebassemblyˉfunctionˉlocalˉtypesˉoffset(
            Directory,
            Function
        ),
        Local - Parameters
    );
}

fn Shapeˉisˉdescriptor(Kind: u32) -> bool {
    if Kind == 3u32 { return true; }
    return Kind == 6u32;
}

fn Emittedˉlocal(
    Directory: Functions.Compilerˉwebassemblyˉfunctionˉdirectoryˉsummary,
    Storage: Recordˉstorage.Compilerˉwebassemblyˉrecordˉstorageˉsummary,
    Function: u32,
    Local: u32
) -> u32 {
    let Parameters: u32 =
        Functions.Compilerˉwebassemblyˉfunctionˉparameterˉcount(
            Directory,
            Function
        );
    if Recordˉstorage.Compilerˉwebassemblyˉrecordˉstorageˉreturnˉfields(
        Storage,
        Function
    ) != 0u32 && Local >= Parameters {
        return Local + 1u32;
    }
    return Local;
}

fn Emitˉdescriptorˉcleanup(
    Input: bytes,
    Directory: Functions.Compilerˉwebassemblyˉfunctionˉdirectoryˉsummary,
    Storage: Recordˉstorage.Compilerˉwebassemblyˉrecordˉstorageˉsummary,
    Function: u32,
    Referenceˉfunction: u32
) -> bytes {
    let Parameters: u32 =
        Functions.Compilerˉwebassemblyˉfunctionˉparameterˉcount(
            Directory,
            Function
        );
    let Locals: u32 =
        Functions.Compilerˉwebassemblyˉfunctionˉlocalˉcount(
            Directory,
            Function
        );
    let Count: u32 = Parameters + Locals;
    var Result: bytes = Empty(Input);
    var Local: u32 = 0u32;
    while Local < Count {
        if Shapeˉisˉdescriptor(Shapeˉkind(
            Input,
            Localˉshapeˉoffset(Input, Directory, Function, Local)
        )) {
            Result = Append(
                Result,
                Descriptorˉstorage.Compilerˉwebassemblyˉdescriptorˉstorageˉreferenceˉlocal(
                    Emittedˉlocal(Directory, Storage, Function, Local),
                    false,
                    Referenceˉfunction
                )
            );
        }
        Local = Local + 1u32;
    }
    return Result;
}

fn Shapeˉisˉscalar(Kind: u32) -> bool {
    if Kind == 1u32 { return true; }
    if Kind == 2u32 { return true; }
    if Kind == 4u32 { return true; }
    if Kind == 5u32 { return true; }
    if Kind == 7u32 { return true; }
    if Kind == 8u32 { return true; }
    return false;
}

fn Segmentedˉrootˉisˉvalid(
    Input: bytes,
    Types: Typeˉdirectory.Compilerˉwebassemblyˉtypeˉdirectoryˉsummary,
    Resultˉoffset: u32
) -> bool {
    if Shapeˉkind(Input, Resultˉoffset) != 7u32 {
        return false;
    }
    let Typeˉindex: u32 = Bytesˉreadˉu32ˉlittle(
        Input,
        Resultˉoffset + 1u32
    );
    if Typeˉindex >= Types.Count ||
        Typeˉdirectory.Compilerˉwebassemblyˉtypeˉkind(
            Types,
            Typeˉindex
        ) != 1u32 ||
        Typeˉdirectory.Compilerˉwebassemblyˉtypeˉitemˉcount(
            Types,
            Typeˉindex
        ) != 36u32 {
        return false;
    }
    var Field: u32 = 0u32;
    while Field < 36u32 {
        let Shape: u32 =
            Typeˉdirectory.Compilerˉwebassemblyˉrecordˉfieldˉshapeˉoffset(
                Input,
                Types,
                Typeˉindex,
                Field
            );
        var Expected: u32 = 6u32;
        if Field == 0u32 { Expected = 2u32; }
        if Field == 1u32 { Expected = 5u32; }
        if Shape == 0u32 || Shapeˉkind(Input, Shape) != Expected {
            return false;
        }
        Field = Field + 1u32;
    }
    return true;
}

fn Reachableˉposition(Order: bytes, Function: u32) -> Positionˉlookup {
    let Length: u32 = Bytesˉlength(Order);
    if Length % 4u32 != 0u32 {
        return Positionˉlookup(false, 0u32);
    }
    var Offset: u32 = 0u32;
    while Offset < Length {
        if Bytesˉreadˉu32ˉlittle(Order, Offset) == Function {
            return Positionˉlookup(true, Offset / 4u32);
        }
        Offset = Offset + 4u32;
    }
    return Positionˉlookup(false, 0u32);
}

fn Validateˉscalarˉsignature(
    Input: bytes,
    Directory: Functions.Compilerˉwebassemblyˉfunctionˉdirectoryˉsummary,
    Function: u32
) -> bool {
    let Parameterˉcount: u32 =
        Functions.Compilerˉwebassemblyˉfunctionˉparameterˉcount(
            Directory,
            Function
        );
    var Parameterˉcursor: u32 =
        Functions.Compilerˉwebassemblyˉfunctionˉparameterˉtypesˉoffset(
            Directory,
            Function
        );
    var Parameter: u32 = 0u32;
    while Parameter < Parameterˉcount {
        let Kind: u32 = Shapeˉkind(Input, Parameterˉcursor);
        if !Shapeˉisˉscalar(Kind) { return false; }
        Parameterˉcursor = Parameterˉcursor +
            Shapeˉwidth(Input, Parameterˉcursor);
        Parameter = Parameter + 1u32;
    }
    let Resultˉkind: u32 = Shapeˉkind(
        Input,
        Functions.Compilerˉwebassemblyˉfunctionˉresultˉtypeˉoffset(
            Directory,
            Function
        )
    );
    if Resultˉkind != 0u32 && !Shapeˉisˉscalar(Resultˉkind) {
        return false;
    }
    let Localˉcount: u32 =
        Functions.Compilerˉwebassemblyˉfunctionˉlocalˉcount(
            Directory,
            Function
        );
    var Localˉcursor: u32 =
        Functions.Compilerˉwebassemblyˉfunctionˉlocalˉtypesˉoffset(
            Directory,
            Function
        );
    var Local: u32 = 0u32;
    while Local < Localˉcount {
        let Localˉkind: u32 = Shapeˉkind(Input, Localˉcursor);
        if !Shapeˉisˉscalar(Localˉkind) { return false; }
        Localˉcursor = Localˉcursor + Shapeˉwidth(Input, Localˉcursor);
        Local = Local + 1u32;
    }
    return true;
}

fn Emitˉtype(
    Input: bytes,
    Directory: Functions.Compilerˉwebassemblyˉfunctionˉdirectoryˉsummary,
    Storage: Recordˉstorage.Compilerˉwebassemblyˉrecordˉstorageˉsummary,
    Function: u32
) -> Emission {
    var Layout: Layouts.Compilerˉwebassemblyˉvalueˉlayoutˉemission =
        Layouts.Compilerˉwebassemblyˉvalueˉlayoutˉfunctionˉtype(
            Input,
            Directory,
            Function
        );
    if Recordˉstorage.Compilerˉwebassemblyˉrecordˉstorageˉreturnˉfields(
        Storage,
        Function
    ) != 0u32 {
        Layout = Layouts.Compilerˉwebassemblyˉvalueˉlayoutˉrecordˉfunctionˉtype(
            Input,
            Directory,
            Function
        );
    }
    if !Layout.Valid {
        return Invalidˉemission(Input, 0u32, 0u32);
    }
    return Emission(true, Layout.Bytes, 0u32, 0u32);
}

fn Functionˉreturnsˉvalue(
    Input: bytes,
    Directory: Functions.Compilerˉwebassemblyˉfunctionˉdirectoryˉsummary,
    Function: u32
) -> bool {
    return Shapeˉkind(
        Input,
        Functions.Compilerˉwebassemblyˉfunctionˉresultˉtypeˉoffset(
            Directory,
            Function
        )
    ) != 0u32;
}

fn Functionˉreturnsˉi64(
    Input: bytes,
    Directory: Functions.Compilerˉwebassemblyˉfunctionˉdirectoryˉsummary,
    Function: u32
) -> bool {
    return Layouts.Compilerˉwebassemblyˉvalueˉlayoutˉshapeˉisˉi64(
        Input,
        Functions.Compilerˉwebassemblyˉfunctionˉresultˉtypeˉoffset(
            Directory,
            Function
        )
    );
}

fn Emitˉearlyˉreturn(Returnsˉvalue: bool, Returnsˉi64: bool) -> bytes {
    var Result: bytes = Byte(15u32);
    if Returnsˉvalue {
        if Returnsˉi64 {
            Result = Append(Append(Byte(66u32), Byte(0u32)), Result);
        } else {
            Result = Append(Positiveˉconstant(0u32), Result);
        }
    }
    return Result;
}

fn Emitˉstatusˉreturn(
    Status: u32,
    Returnsˉvalue: bool,
    Returnsˉi64: bool
) -> bytes {
    var Result: bytes = Positiveˉconstant(Status);
    Result = Append(Result, Indexed(36u32, 3u32));
    return Append(
        Result,
        Emitˉearlyˉreturn(Returnsˉvalue, Returnsˉi64)
    );
}

fn Emitˉfailureˉguard(
    Status: u32,
    Returnsˉvalue: bool,
    Returnsˉi64: bool
) -> bytes {
    var Result: bytes = Byte(4u32);
    Result = Append(Result, Byte(64u32));
    Result = Append(
        Result,
        Emitˉstatusˉreturn(Status, Returnsˉvalue, Returnsˉi64)
    );
    return Append(Result, Byte(11u32));
}

fn I32ˉnegativeˉoneˉconstant() -> bytes {
    return Append(Byte(65u32), Byte(127u32));
}

fn Emitˉmeter(
    Count: u32,
    Returnsˉvalue: bool,
    Returnsˉi64: bool,
    Meterˉfunction: u32
) -> bytes {
    var Result: bytes = Positiveˉconstant(Count);
    Result = Append(Result, Indexed(16u32, Meterˉfunction));
    Result = Append(Result, Byte(4u32));
    Result = Append(Result, Byte(64u32));
    Result = Append(
        Result,
        Emitˉearlyˉreturn(Returnsˉvalue, Returnsˉi64)
    );
    return Append(Result, Byte(11u32));
}

fn Emitˉcallˉfailureˉpropagation(
    Returnsˉvalue: bool,
    Returnsˉi64: bool,
    Calledˉreturnsˉvalue: bool,
    Calledˉreturnsˉi64: bool,
    Scratchˉresult: u32,
    Scratchˉwide: u32
) -> bytes {
    var Result: bytes = Empty(Byte(0u32));
    if Calledˉreturnsˉvalue {
        if Calledˉreturnsˉi64 {
            Result = Append(Result, Indexed(33u32, Scratchˉwide));
        } else {
            Result = Append(Result, Indexed(33u32, Scratchˉresult));
        }
    }
    Result = Append(Result, Indexed(35u32, 3u32));
    Result = Append(Result, Byte(4u32));
    Result = Append(Result, Byte(64u32));
    Result = Append(
        Result,
        Emitˉearlyˉreturn(Returnsˉvalue, Returnsˉi64)
    );
    Result = Append(Result, Byte(11u32));
    if Calledˉreturnsˉvalue {
        if Calledˉreturnsˉi64 {
            Result = Append(Result, Indexed(32u32, Scratchˉwide));
        } else {
            Result = Append(Result, Indexed(32u32, Scratchˉresult));
        }
    }
    return Result;
}

fn Emitˉcheckedˉi32ˉadd(
    Left: u32,
    Right: u32,
    Arithmeticˉresult: u32,
    Returnsˉvalue: bool,
    Returnsˉi64: bool
) -> bytes {
    var Result: bytes = Indexed(33u32, Right);
    Result = Append(Result, Indexed(33u32, Left));
    Result = Append(Result, Indexed(32u32, Left));
    Result = Append(Result, Indexed(32u32, Right));
    Result = Append(Result, Byte(106u32));
    Result = Append(Result, Indexed(34u32, Arithmeticˉresult));
    Result = Append(Result, Indexed(32u32, Left));
    Result = Append(Result, Byte(115u32));
    Result = Append(Result, Indexed(32u32, Arithmeticˉresult));
    Result = Append(Result, Indexed(32u32, Right));
    Result = Append(Result, Byte(115u32));
    Result = Append(Result, Byte(113u32));
    Result = Append(Result, Positiveˉconstant(0u32));
    Result = Append(Result, Byte(72u32));
    Result = Append(
        Result,
        Emitˉfailureˉguard(3007u32, Returnsˉvalue, Returnsˉi64)
    );
    return Append(Result, Indexed(32u32, Arithmeticˉresult));
}

fn Emitˉcheckedˉi32ˉsubtract(
    Left: u32,
    Right: u32,
    Arithmeticˉresult: u32,
    Returnsˉvalue: bool,
    Returnsˉi64: bool
) -> bytes {
    var Result: bytes = Indexed(33u32, Right);
    Result = Append(Result, Indexed(33u32, Left));
    Result = Append(Result, Indexed(32u32, Left));
    Result = Append(Result, Indexed(32u32, Right));
    Result = Append(Result, Byte(107u32));
    Result = Append(Result, Indexed(34u32, Arithmeticˉresult));
    Result = Append(Result, Indexed(32u32, Left));
    Result = Append(Result, Byte(115u32));
    Result = Append(Result, Indexed(32u32, Left));
    Result = Append(Result, Indexed(32u32, Right));
    Result = Append(Result, Byte(115u32));
    Result = Append(Result, Byte(113u32));
    Result = Append(Result, Positiveˉconstant(0u32));
    Result = Append(Result, Byte(72u32));
    Result = Append(
        Result,
        Emitˉfailureˉguard(3007u32, Returnsˉvalue, Returnsˉi64)
    );
    return Append(Result, Indexed(32u32, Arithmeticˉresult));
}

fn Emitˉcheckedˉi32ˉmultiply(
    Left: u32,
    Right: u32,
    Arithmeticˉresult: u32,
    Wideˉresult: u32,
    Returnsˉvalue: bool,
    Returnsˉi64: bool
) -> bytes {
    var Result: bytes = Indexed(33u32, Right);
    Result = Append(Result, Indexed(33u32, Left));
    Result = Append(Result, Indexed(32u32, Left));
    Result = Append(Result, Byte(172u32));
    Result = Append(Result, Indexed(32u32, Right));
    Result = Append(Result, Byte(172u32));
    Result = Append(Result, Byte(126u32));
    Result = Append(Result, Indexed(34u32, Wideˉresult));
    Result = Append(Result, Byte(167u32));
    Result = Append(Result, Indexed(34u32, Arithmeticˉresult));
    Result = Append(Result, Byte(172u32));
    Result = Append(Result, Indexed(32u32, Wideˉresult));
    Result = Append(Result, Byte(82u32));
    Result = Append(
        Result,
        Emitˉfailureˉguard(3007u32, Returnsˉvalue, Returnsˉi64)
    );
    return Append(Result, Indexed(32u32, Arithmeticˉresult));
}

fn Emitˉcheckedˉi32ˉnegate(
    Value: u32,
    Returnsˉvalue: bool,
    Returnsˉi64: bool
) -> bytes {
    var Result: bytes = Indexed(33u32, Value);
    Result = Append(Result, Indexed(32u32, Value));
    Result = Append(Result, I32ˉminimumˉconstant());
    Result = Append(Result, Byte(70u32));
    Result = Append(
        Result,
        Emitˉfailureˉguard(3007u32, Returnsˉvalue, Returnsˉi64)
    );
    Result = Append(Result, Positiveˉconstant(0u32));
    Result = Append(Result, Indexed(32u32, Value));
    return Append(Result, Byte(107u32));
}

fn Emitˉcheckedˉu32ˉadd(
    Left: u32,
    Right: u32,
    Arithmeticˉresult: u32,
    Returnsˉvalue: bool,
    Returnsˉi64: bool
) -> bytes {
    var Result: bytes = Indexed(33u32, Right);
    Result = Append(Result, Indexed(33u32, Left));
    Result = Append(Result, Indexed(32u32, Left));
    Result = Append(Result, Indexed(32u32, Right));
    Result = Append(Result, Byte(106u32));
    Result = Append(Result, Indexed(34u32, Arithmeticˉresult));
    Result = Append(Result, Indexed(32u32, Left));
    Result = Append(Result, Byte(73u32));
    Result = Append(
        Result,
        Emitˉfailureˉguard(3007u32, Returnsˉvalue, Returnsˉi64)
    );
    return Append(Result, Indexed(32u32, Arithmeticˉresult));
}

fn Emitˉcheckedˉu32ˉsubtract(
    Left: u32,
    Right: u32,
    Returnsˉvalue: bool,
    Returnsˉi64: bool
) -> bytes {
    var Result: bytes = Indexed(33u32, Right);
    Result = Append(Result, Indexed(33u32, Left));
    Result = Append(Result, Indexed(32u32, Left));
    Result = Append(Result, Indexed(32u32, Right));
    Result = Append(Result, Byte(73u32));
    Result = Append(
        Result,
        Emitˉfailureˉguard(3007u32, Returnsˉvalue, Returnsˉi64)
    );
    Result = Append(Result, Indexed(32u32, Left));
    Result = Append(Result, Indexed(32u32, Right));
    return Append(Result, Byte(107u32));
}

fn Emitˉcheckedˉu32ˉmultiply(
    Left: u32,
    Right: u32,
    Arithmeticˉresult: u32,
    Wideˉresult: u32,
    Returnsˉvalue: bool,
    Returnsˉi64: bool
) -> bytes {
    var Result: bytes = Indexed(33u32, Right);
    Result = Append(Result, Indexed(33u32, Left));
    Result = Append(Result, Indexed(32u32, Left));
    Result = Append(Result, Byte(173u32));
    Result = Append(Result, Indexed(32u32, Right));
    Result = Append(Result, Byte(173u32));
    Result = Append(Result, Byte(126u32));
    Result = Append(Result, Indexed(34u32, Wideˉresult));
    Result = Append(Result, Byte(167u32));
    Result = Append(Result, Indexed(34u32, Arithmeticˉresult));
    Result = Append(Result, Byte(173u32));
    Result = Append(Result, Indexed(32u32, Wideˉresult));
    Result = Append(Result, Byte(82u32));
    Result = Append(
        Result,
        Emitˉfailureˉguard(3007u32, Returnsˉvalue, Returnsˉi64)
    );
    return Append(Result, Indexed(32u32, Arithmeticˉresult));
}

fn Emitˉoperation(
    Input: bytes,
    Code: u32,
    Offset: u32,
    Opcode: u8,
    Topˉkind: u32,
    Reachableˉorder: bytes,
    Directory: Functions.Compilerˉwebassemblyˉfunctionˉdirectoryˉsummary,
    Types: Typeˉdirectory.Compilerˉwebassemblyˉtypeˉdirectoryˉsummary,
    Enumˉsummary: Enums.Compilerˉwebassemblyˉenumˉsummary,
    Storage: Recordˉstorage.Compilerˉwebassemblyˉrecordˉstorageˉsummary,
    Function: u32,
    Frameˉbase: u32,
    Scratchˉleft: u32,
    Scratchˉright: u32,
    Scratchˉresult: u32,
    Scratchˉpointer: u32,
    Scratchˉwideˉleft: u32,
    Scratchˉwideˉright: u32,
    Scratchˉwideˉresult: u32,
    Runtime: Runtimeˉhelpers
) -> Emission {
    var Result: bytes = Empty(Input);
    let Returnsˉvalue: bool = Functionˉreturnsˉvalue(
        Input,
        Directory,
        Function
    );
    let Returnsˉi64: bool = Functionˉreturnsˉi64(
        Input,
        Directory,
        Function
    );
    let Runtimeˉdata:
        Staticˉdata.Compilerˉwebassemblyˉstaticˉdataˉsummary =
        Enums.Compilerˉwebassemblyˉenumˉdata(Enumˉsummary);
    let Record: Records.Compilerˉwebassemblyˉrecordˉoperationˉemission =
        Records.Compilerˉwebassemblyˉrecordˉoperationˉemit(
            Input,
            Code,
            Offset,
            Opcode,
            Types,
            Storage,
            Function,
            Frameˉbase,
            Scratchˉleft,
            Scratchˉwideˉleft,
            Records.Compilerˉwebassemblyˉrecordˉruntime(
                Runtime.Hasˉdynamic,
                Runtime.Referenceˉfunction
            )
        );
    if Record.Matched && Opcode != 64u8 {
        if !Record.Valid {
            return Invalidˉemission(Input, Offset, U32ˉfromˉu8(Opcode));
        }
        return Emission(true, Record.Bytes, 0u32, 0u32);
    }
    var Hasˉdescriptorˉruntime: bool = Runtime.Hasˉdynamic;
    if Runtime.Hasˉutf8 { Hasˉdescriptorˉruntime = true; }
    if Hasˉdescriptorˉruntime {
        let Dynamic:
            Dynamicˉdescriptors.Compilerˉwebassemblyˉdynamicˉdescriptorˉemission =
            Dynamicˉdescriptors.Compilerˉwebassemblyˉdynamicˉdescriptorˉemit(
                Input,
                Opcode,
                Scratchˉleft,
                Scratchˉright,
                Scratchˉresult,
                Scratchˉpointer,
                Scratchˉwideˉleft,
                Scratchˉwideˉright,
                Scratchˉwideˉresult,
                Runtime.Allocateˉfunction,
                Runtime.Referenceˉfunction,
                Runtime.Maximumˉbytes,
                Runtime.Hasˉdynamic,
                Runtime.Utf8ˉfunction,
                Returnsˉvalue,
                Returnsˉi64,
                3u32
            );
        if Dynamic.Matched {
            if !Dynamic.Valid {
                return Invalidˉemission(Input, Offset, U32ˉfromˉu8(Opcode));
            }
            return Emission(true, Dynamic.Bytes, 0u32, 0u32);
        }
    }
    if Opcode == 1u8 || Opcode == 9u8 {
        Result = Encoding.Compilerˉwebassemblyˉbinaryˉi32ˉconstantˉfromˉinput(
            Input,
            Code + Offset + 1u32
        );
        return Emission(true, Result, 0u32, 0u32);
    }
    if Opcode == 2u8 || Opcode == 8u8 {
        Result = Positiveˉconstant(U32ˉfromˉu8(
            Bytesˉreadˉu8(Input, Code + Offset + 1u32)
        ));
        return Emission(true, Result, 0u32, 0u32);
    }
    if Opcode == 4u8 {
        let Selectedˉloadˉlocal: u32 = Bytesˉreadˉu32ˉlittle(
            Input,
            Code + Offset + 1u32
        );
        let Loadˉlocal: u32 = Emittedˉlocal(
            Directory,
            Storage,
            Function,
            Selectedˉloadˉlocal
        );
        var Loadˉbytes: bytes = Indexed(32u32, Loadˉlocal);
        if Runtime.Hasˉdynamic && Shapeˉisˉdescriptor(Shapeˉkind(
            Input,
            Localˉshapeˉoffset(
                Input,
                Directory,
                Function,
                Selectedˉloadˉlocal
            )
        )) {
            Loadˉbytes = Append(
                Loadˉbytes,
                Indexed(34u32, Scratchˉwideˉleft)
            );
            Loadˉbytes = Append(Loadˉbytes, Positiveˉconstant(1u32));
            Loadˉbytes = Append(
                Loadˉbytes,
                Indexed(16u32, Runtime.Referenceˉfunction)
            );
            Loadˉbytes = Append(
                Loadˉbytes,
                Indexed(32u32, Scratchˉwideˉleft)
            );
        }
        return Emission(
            true,
            Loadˉbytes,
            0u32,
            0u32
        );
    }
    if Opcode == 5u8 {
        let Selectedˉstoreˉlocal: u32 = Bytesˉreadˉu32ˉlittle(
            Input,
            Code + Offset + 1u32
        );
        let Storeˉlocal: u32 = Emittedˉlocal(
            Directory,
            Storage,
            Function,
            Selectedˉstoreˉlocal
        );
        var Storeˉbytes: bytes = Indexed(33u32, Storeˉlocal);
        if Runtime.Hasˉdynamic && Shapeˉisˉdescriptor(Shapeˉkind(
            Input,
            Localˉshapeˉoffset(
                Input,
                Directory,
                Function,
                Selectedˉstoreˉlocal
            )
        )) {
            Storeˉbytes = Indexed(33u32, Scratchˉwideˉleft);
            Storeˉbytes = Append(
                Storeˉbytes,
                Descriptorˉstorage.Compilerˉwebassemblyˉdescriptorˉstorageˉreferenceˉlocal(
                    Storeˉlocal,
                    false,
                    Runtime.Referenceˉfunction
                )
            );
            Storeˉbytes = Append(
                Storeˉbytes,
                Indexed(32u32, Scratchˉwideˉleft)
            );
            Storeˉbytes = Append(
                Storeˉbytes,
                Indexed(33u32, Storeˉlocal)
            );
        }
        return Emission(
            true,
            Storeˉbytes,
            0u32,
            0u32
        );
    }
    let Scalar: Scalars.Compilerˉwebassemblyˉscalarˉoperationˉemission =
        Scalars.Compilerˉwebassemblyˉscalarˉoperationˉemit(
            Input,
            Opcode,
            Scratchˉleft,
            Scratchˉright,
            Returnsˉvalue,
            Returnsˉi64,
            3u32
        );
    if Scalar.Matched {
        return Emission(true, Scalar.Bytes, 0u32, 0u32);
    }
    let Descriptor:
        Descriptors.Compilerˉwebassemblyˉdescriptorˉoperationˉemission =
        Descriptors.Compilerˉwebassemblyˉdescriptorˉoperationˉemit(
            Input,
            Code,
            Offset,
            Opcode,
            Runtimeˉdata,
            Scratchˉleft,
            Scratchˉright,
            Scratchˉresult,
            Descriptors.Compilerˉwebassemblyˉdescriptorˉruntime(
                Scratchˉpointer,
                Scratchˉwideˉleft,
                Scratchˉwideˉresult,
                Runtime.Hasˉdynamic,
                Runtime.Allocateˉfunction,
                Runtime.Referenceˉfunction
            ),
            Returnsˉvalue,
            Returnsˉi64,
            3u32
        );
    if Descriptor.Matched {
        if !Descriptor.Valid {
            return Invalidˉemission(Input, Offset, U32ˉfromˉu8(Opcode));
        }
        return Emission(true, Descriptor.Bytes, 0u32, 0u32);
    }
    let Enum: Enums.Compilerˉwebassemblyˉenumˉoperationˉemission =
        Enums.Compilerˉwebassemblyˉenumˉoperationˉemit(
            Input,
            Code,
            Offset,
            Opcode,
            Types,
            Enumˉsummary,
            Scratchˉleft,
            Returnsˉvalue,
            Returnsˉi64,
            3u32
        );
    if Enum.Matched {
        if !Enum.Valid {
            return Invalidˉemission(Input, Offset, U32ˉfromˉu8(Opcode));
        }
        return Emission(true, Enum.Bytes, 0u32, 0u32);
    }
    if Opcode == 16u8 {
        return Emission(
            true,
            Emitˉcheckedˉi32ˉadd(
                Scratchˉleft,
                Scratchˉright,
                Scratchˉresult,
                Returnsˉvalue,
                Returnsˉi64
            ),
            0u32,
            0u32
        );
    }
    if Opcode == 17u8 {
        return Emission(
            true,
            Emitˉcheckedˉi32ˉsubtract(
                Scratchˉleft,
                Scratchˉright,
                Scratchˉresult,
                Returnsˉvalue,
                Returnsˉi64
            ),
            0u32,
            0u32
        );
    }
    if Opcode == 18u8 {
        return Emission(
            true,
            Emitˉcheckedˉi32ˉmultiply(
                Scratchˉleft,
                Scratchˉright,
                Scratchˉresult,
                Scratchˉwideˉleft,
                Returnsˉvalue,
                Returnsˉi64
            ),
            0u32,
            0u32
        );
    }
    if Opcode == 19u8 {
        return Emission(
            true,
            Emitˉcheckedˉi32ˉnegate(
                Scratchˉleft,
                Returnsˉvalue,
                Returnsˉi64
            ),
            0u32,
            0u32
        );
    }
    if Opcode == 20u8 {
        return Emission(
            true,
            Emitˉcheckedˉu32ˉadd(
                Scratchˉleft,
                Scratchˉright,
                Scratchˉresult,
                Returnsˉvalue,
                Returnsˉi64
            ),
            0u32,
            0u32
        );
    }
    if Opcode == 21u8 {
        return Emission(
            true,
            Emitˉcheckedˉu32ˉsubtract(
                Scratchˉleft,
                Scratchˉright,
                Returnsˉvalue,
                Returnsˉi64
            ),
            0u32,
            0u32
        );
    }
    if Opcode == 22u8 {
        return Emission(
            true,
            Emitˉcheckedˉu32ˉmultiply(
                Scratchˉleft,
                Scratchˉright,
                Scratchˉresult,
                Scratchˉwideˉleft,
                Returnsˉvalue,
                Returnsˉi64
            ),
            0u32,
            0u32
        );
    }
    var Wasmˉopcode: u32 = 0u32;
    if Opcode == 32u8 || Opcode == 38u8 || Opcode == 96u8 || Opcode == 102u8 {
        Wasmˉopcode = 70u32;
    }
    if Opcode == 33u8 || Opcode == 39u8 || Opcode == 97u8 || Opcode == 103u8 {
        Wasmˉopcode = 71u32;
    }
    if Opcode == 34u8 { Wasmˉopcode = 72u32; }
    if Opcode == 35u8 { Wasmˉopcode = 76u32; }
    if Opcode == 36u8 { Wasmˉopcode = 74u32; }
    if Opcode == 37u8 { Wasmˉopcode = 78u32; }
    if Opcode == 40u8 { Wasmˉopcode = 69u32; }
    if Opcode == 98u8 { Wasmˉopcode = 73u32; }
    if Opcode == 99u8 { Wasmˉopcode = 77u32; }
    if Opcode == 100u8 { Wasmˉopcode = 75u32; }
    if Opcode == 101u8 { Wasmˉopcode = 79u32; }
    if Wasmˉopcode != 0u32 {
        return Emission(true, Byte(Wasmˉopcode), 0u32, 0u32);
    }
    if Opcode == 118u8 { return Emission(true, Result, 0u32, 0u32); }
    if Opcode == 80u8 {
        if Runtime.Hasˉdynamic && Shapeˉisˉdescriptor(Topˉkind) {
            var Popˉdescriptor: bytes = Indexed(
                33u32,
                Scratchˉwideˉleft
            );
            Popˉdescriptor = Append(
                Popˉdescriptor,
                Descriptorˉstorage.Compilerˉwebassemblyˉdescriptorˉstorageˉreferenceˉlocal(
                    Scratchˉwideˉleft,
                    false,
                    Runtime.Referenceˉfunction
                )
            );
            return Emission(true, Popˉdescriptor, 0u32, 0u32);
        }
        return Emission(true, Byte(26u32), 0u32, 0u32);
    }
    if Opcode == 64u8 {
        let Target: u32 = Bytesˉreadˉu32ˉlittle(
            Input,
            Code + Offset + 1u32
        );
        let Position: Positionˉlookup = Reachableˉposition(
            Reachableˉorder,
            Target
        );
        if !Position.Found {
            return Invalidˉemission(Input, Offset, U32ˉfromˉu8(Opcode));
        }
        if Record.Matched {
            if !Record.Valid {
                return Invalidˉemission(Input, Offset, U32ˉfromˉu8(Opcode));
            }
            Result = Append(Result, Record.Bytes);
        }
        Result = Append(Result, Indexed(16u32, Position.Position));
        Result = Append(
            Result,
            Emitˉcallˉfailureˉpropagation(
                Returnsˉvalue,
                Returnsˉi64,
                Functionˉreturnsˉvalue(Input, Directory, Target),
                Functionˉreturnsˉi64(Input, Directory, Target),
                Scratchˉresult,
                Scratchˉwideˉleft
            )
        );
        return Emission(true, Result, 0u32, 0u32);
    }
    return Invalidˉemission(Input, Offset, U32ˉfromˉu8(Opcode));
}

fn Packˉemission(Value: Emission) -> bytes {
    var Valid: u32 = 0u32;
    if Value.Valid { Valid = 1u32; }
    var Result: bytes = Bytesˉfromˉu32ˉlittle(Valid);
    Result = Append(
        Result,
        Bytesˉfromˉu32ˉlittle(Value.Failureˉoffset)
    );
    Result = Append(
        Result,
        Bytesˉfromˉu32ˉlittle(Value.Failureˉopcode)
    );
    return Append(Result, Value.Bytes);
}

fn Emitˉoperationˉpacked(
    Input: bytes,
    Code: u32,
    Offset: u32,
    Opcode: u8,
    Topˉkind: u32,
    Reachableˉorder: bytes,
    Directory: Functions.Compilerˉwebassemblyˉfunctionˉdirectoryˉsummary,
    Types: Typeˉdirectory.Compilerˉwebassemblyˉtypeˉdirectoryˉsummary,
    Enumˉsummary: Enums.Compilerˉwebassemblyˉenumˉsummary,
    Storage: Recordˉstorage.Compilerˉwebassemblyˉrecordˉstorageˉsummary,
    Function: u32,
    Frameˉbase: u32,
    Scratchˉleft: u32,
    Scratchˉright: u32,
    Scratchˉresult: u32,
    Scratchˉpointer: u32,
    Scratchˉwideˉleft: u32,
    Scratchˉwideˉright: u32,
    Scratchˉwideˉresult: u32,
    Runtime: Runtimeˉhelpers
) -> bytes {
    return Packˉemission(
        Emitˉoperation(
            Input,
            Code,
            Offset,
            Opcode,
            Topˉkind,
            Reachableˉorder,
            Directory,
            Types,
            Enumˉsummary,
            Storage,
            Function,
            Frameˉbase,
            Scratchˉleft,
            Scratchˉright,
            Scratchˉresult,
            Scratchˉpointer,
            Scratchˉwideˉleft,
            Scratchˉwideˉright,
            Scratchˉwideˉresult,
            Runtime
        )
    );
}

fn Emitˉsetˉprogramˉcounter(Counter: u32, Block: u32) -> bytes {
    return Append(Positiveˉconstant(Block), Indexed(33u32, Counter));
}

fn Emitˉenumˉlocalˉdefaults(
    Input: bytes,
    Directory: Functions.Compilerˉwebassemblyˉfunctionˉdirectoryˉsummary,
    Types: Typeˉdirectory.Compilerˉwebassemblyˉtypeˉdirectoryˉsummary,
    Enumˉsummary: Enums.Compilerˉwebassemblyˉenumˉsummary,
    Function: u32,
    Parameterˉcount: u32,
    Localˉcount: u32
) -> Emission {
    var Result: bytes = Empty(Input);
    var Cursor: u32 =
        Functions.Compilerˉwebassemblyˉfunctionˉlocalˉtypesˉoffset(
            Directory,
            Function
        );
    var Local: u32 = 0u32;
    while Local < Localˉcount {
        let Kind: u32 = Shapeˉkind(Input, Cursor);
        if Kind == 8u32 {
            let Handle: u32 =
                Enums.Compilerˉwebassemblyˉenumˉfirstˉhandle(
                    Input,
                    Types,
                    Enumˉsummary,
                    Bytesˉreadˉu32ˉlittle(Input, Cursor + 1u32)
                );
            if Handle == 0u32 {
                return Invalidˉemission(Input, 0u32, 106u32);
            }
            Result = Append(Result, Positiveˉconstant(Handle));
            Result = Append(
                Result,
                Indexed(33u32, Parameterˉcount + Local)
            );
        }
        Cursor = Cursor + Shapeˉwidth(Input, Cursor);
        Local = Local + 1u32;
    }
    return Emission(true, Result, 0u32, 0u32);
}

fn Packˉinstructionˉchunkˉfailure(Offset: u32, Opcode: u32) -> bytes {
    var Result: bytes = Bytesˉfromˉu32ˉlittle(0u32);
    Result = Append(Result, Bytesˉfromˉu32ˉlittle(Offset));
    Result = Append(Result, Bytesˉfromˉu32ˉlittle(Opcode));
    var Field: u32 = 3u32;
    while Field < 16u32 {
        Result = Append(Result, Bytesˉfromˉu32ˉlittle(0u32));
        Field = Field + 1u32;
    }
    return Result;
}

fn Packˉinstructionˉchunkˉsuccess(
    Cursor: u32,
    State: Typed.Compilerˉwebassemblyˉtypedˉinstructionˉstate,
    Instructions: bytes
) -> bytes {
    var Valid: u32 = 0u32;
    if State.Valid { Valid = 1u32; }
    var Result: bytes = Bytesˉfromˉu32ˉlittle(1u32);
    Result = Append(Result, Bytesˉfromˉu32ˉlittle(0u32));
    Result = Append(Result, Bytesˉfromˉu32ˉlittle(0u32));
    Result = Append(Result, Bytesˉfromˉu32ˉlittle(Cursor));
    Result = Append(Result, Bytesˉfromˉu32ˉlittle(Valid));
    Result = Append(Result, Bytesˉfromˉu32ˉlittle(State.Depth));
    Result = Append(Result, Bytesˉfromˉu32ˉlittle(State.Maximum));
    Result = Append(Result, Bytesˉfromˉu32ˉlittle(State.Firstˉword));
    Result = Append(Result, Bytesˉfromˉu32ˉlittle(State.Secondˉword));
    Result = Append(Result, Bytesˉfromˉu32ˉlittle(State.Thirdˉword));
    Result = Append(Result, Bytesˉfromˉu32ˉlittle(State.Fourthˉword));
    Result = Append(Result, Bytesˉfromˉu32ˉlittle(State.Fifthˉword));
    Result = Append(Result, Bytesˉfromˉu32ˉlittle(State.Sixthˉword));
    Result = Append(Result, Bytesˉfromˉu32ˉlittle(State.Seventhˉword));
    Result = Append(Result, Bytesˉfromˉu32ˉlittle(State.Eighthˉword));
    Result = Append(Result, Bytesˉfromˉu32ˉlittle(State.Ninthˉword));
    return Append(Result, Instructions);
}

fn Emitˉinstructionˉchunkˉpacked(
    Input: bytes,
    Code: u32,
    Length: u32,
    End: u32,
    Kind: u32,
    Start: u32,
    Initialˉstate: Typed.Compilerˉwebassemblyˉtypedˉinstructionˉstate,
    Returnsˉvalue: bool,
    Returnsˉi64: bool,
    Reachableˉorder: bytes,
    Directory: Functions.Compilerˉwebassemblyˉfunctionˉdirectoryˉsummary,
    Types: Typeˉdirectory.Compilerˉwebassemblyˉtypeˉdirectoryˉsummary,
    Enumˉsummary: Enums.Compilerˉwebassemblyˉenumˉsummary,
    Storage: Recordˉstorage.Compilerˉwebassemblyˉrecordˉstorageˉsummary,
    Function: u32,
    Frameˉbase: u32,
    Scratchˉleft: u32,
    Scratchˉright: u32,
    Scratchˉresult: u32,
    Scratchˉpointer: u32,
    Scratchˉwideˉleft: u32,
    Scratchˉwideˉright: u32,
    Scratchˉwideˉresult: u32,
    Runtime: Runtimeˉhelpers
) -> bytes {
    var Instructions: bytes = Empty(Input);
    var State: Typed.Compilerˉwebassemblyˉtypedˉinstructionˉstate =
        Initialˉstate;
    let Localˉtypeˉoffsets: bytes =
        Typed.Compilerˉwebassemblyˉtypedˉlocalˉtypeˉoffsets(
            Input,
            Directory,
            Function
        );
    var Cursor: u32 = Start;
    var Count: u32 = 0u32;
    while Cursor < End {
        if Count >= 32u32 {
            return Packˉinstructionˉchunkˉsuccess(
                Cursor,
                State,
                Instructions
            );
        }
        let Width: u32 = Functions.Compilerˉwebassemblyˉinstructionˉwidth(
            Input,
            Code,
            Length,
            Cursor
        );
        if Width == 0u32 || Width > End - Cursor {
            return Packˉinstructionˉchunkˉfailure(Cursor, 0u32);
        }
        let Opcode: u8 = Bytesˉreadˉu8(Input, Code + Cursor);
        let Isˉterminator: bool = Cursor + Width == End && Kind != 0u32;
        if !Isˉterminator {
            let Operation: bytes = Emitˉoperationˉpacked(
                Input,
                Code,
                Cursor,
                Opcode,
                Typed.Compilerˉwebassemblyˉtypedˉinstructionˉtopˉkind(State),
                Reachableˉorder,
                Directory,
                Types,
                Enumˉsummary,
                Storage,
                Function,
                Frameˉbase,
                Scratchˉleft,
                Scratchˉright,
                Scratchˉresult,
                Scratchˉpointer,
                Scratchˉwideˉleft,
                Scratchˉwideˉright,
                Scratchˉwideˉresult,
                Runtime
            );
            if Bytesˉlength(Operation) < 12u32 ||
                Bytesˉreadˉu32ˉlittle(Operation, 0u32) != 1u32 {
                var Operationˉfailureˉoffset: u32 = Cursor;
                var Operationˉfailureˉopcode: u32 = U32ˉfromˉu8(Opcode);
                if Bytesˉlength(Operation) >= 12u32 {
                    Operationˉfailureˉoffset =
                        Bytesˉreadˉu32ˉlittle(Operation, 4u32);
                    Operationˉfailureˉopcode =
                        Bytesˉreadˉu32ˉlittle(Operation, 8u32);
                }
                return Packˉinstructionˉchunkˉfailure(
                    Operationˉfailureˉoffset,
                    Operationˉfailureˉopcode
                );
            }
            Instructions = Append(
                Instructions,
                Bytesˉslice(
                    Operation,
                    12u32,
                    Bytesˉlength(Operation) - 12u32
                )
            );
        }
        State = Typed.Compilerˉwebassemblyˉtypedˉinstructionˉapply(
            Input,
            Code,
            Length,
            Directory,
            Types,
            Localˉtypeˉoffsets,
            Function,
            Cursor,
            State
        );
        if !State.Valid {
            return Packˉinstructionˉchunkˉfailure(
                Cursor,
                U32ˉfromˉu8(Opcode)
            );
        }
        Cursor = Cursor + Width;
        Count = Count + 1u32;
    }
    return Packˉinstructionˉchunkˉsuccess(Cursor, State, Instructions);
}

fn Readˉinstructionˉchunkˉstate(
    Input: bytes
) -> Typed.Compilerˉwebassemblyˉtypedˉinstructionˉstate {
    if Bytesˉlength(Input) < 64u32 ||
        Bytesˉreadˉu32ˉlittle(Input, 0u32) != 1u32 ||
        Bytesˉreadˉu32ˉlittle(Input, 16u32) != 1u32 {
        return Typed.Compilerˉwebassemblyˉtypedˉinstructionˉstate(
            false,
            0u32,
            0u32,
            0u32,
            0u32,
            0u32,
            0u32,
            0u32,
            0u32,
            0u32,
            0u32,
            0u32
        );
    }
    return Typed.Compilerˉwebassemblyˉtypedˉinstructionˉstate(
        true,
        Bytesˉreadˉu32ˉlittle(Input, 20u32),
        Bytesˉreadˉu32ˉlittle(Input, 24u32),
        Bytesˉreadˉu32ˉlittle(Input, 28u32),
        Bytesˉreadˉu32ˉlittle(Input, 32u32),
        Bytesˉreadˉu32ˉlittle(Input, 36u32),
        Bytesˉreadˉu32ˉlittle(Input, 40u32),
        Bytesˉreadˉu32ˉlittle(Input, 44u32),
        Bytesˉreadˉu32ˉlittle(Input, 48u32),
        Bytesˉreadˉu32ˉlittle(Input, 52u32),
        Bytesˉreadˉu32ˉlittle(Input, 56u32),
        Bytesˉreadˉu32ˉlittle(Input, 60u32)
    );
}

fn Emitˉinstructionˉgroupˉpacked(
    Input: bytes,
    Code: u32,
    Length: u32,
    End: u32,
    Kind: u32,
    Start: u32,
    Initialˉstate: Typed.Compilerˉwebassemblyˉtypedˉinstructionˉstate,
    Returnsˉvalue: bool,
    Returnsˉi64: bool,
    Reachableˉorder: bytes,
    Directory: Functions.Compilerˉwebassemblyˉfunctionˉdirectoryˉsummary,
    Types: Typeˉdirectory.Compilerˉwebassemblyˉtypeˉdirectoryˉsummary,
    Enumˉsummary: Enums.Compilerˉwebassemblyˉenumˉsummary,
    Storage: Recordˉstorage.Compilerˉwebassemblyˉrecordˉstorageˉsummary,
    Function: u32,
    Frameˉbase: u32,
    Scratchˉleft: u32,
    Scratchˉright: u32,
    Scratchˉresult: u32,
    Scratchˉpointer: u32,
    Scratchˉwideˉleft: u32,
    Scratchˉwideˉright: u32,
    Scratchˉwideˉresult: u32,
    Runtime: Runtimeˉhelpers
) -> bytes {
    var Instructions: bytes = Empty(Input);
    var State: Typed.Compilerˉwebassemblyˉtypedˉinstructionˉstate =
        Initialˉstate;
    var Cursor: u32 = Start;
    var Count: u32 = 0u32;
    while Cursor < End {
        if Count >= 8u32 {
            return Packˉinstructionˉchunkˉsuccess(
                Cursor,
                State,
                Instructions
            );
        }
        let Chunk: bytes = Emitˉinstructionˉchunkˉpacked(
            Input,
            Code,
            Length,
            End,
            Kind,
            Cursor,
            State,
            Returnsˉvalue,
            Returnsˉi64,
            Reachableˉorder,
            Directory,
            Types,
            Enumˉsummary,
            Storage,
            Function,
            Frameˉbase,
            Scratchˉleft,
            Scratchˉright,
            Scratchˉresult,
            Scratchˉpointer,
            Scratchˉwideˉleft,
            Scratchˉwideˉright,
            Scratchˉwideˉresult,
            Runtime
        );
        let Nextˉstate: Typed.Compilerˉwebassemblyˉtypedˉinstructionˉstate =
            Readˉinstructionˉchunkˉstate(Chunk);
        if !Nextˉstate.Valid { return Chunk; }
        let Nextˉcursor: u32 = Bytesˉreadˉu32ˉlittle(Chunk, 12u32);
        if Nextˉcursor <= Cursor || Nextˉcursor > End {
            return Packˉinstructionˉchunkˉfailure(Cursor, 0u32);
        }
        Instructions = Append(
            Instructions,
            Bytesˉslice(Chunk, 64u32, Bytesˉlength(Chunk) - 64u32)
        );
        State = Nextˉstate;
        Cursor = Nextˉcursor;
        Count = Count + 1u32;
    }
    return Packˉinstructionˉchunkˉsuccess(Cursor, State, Instructions);
}

fn Emitˉblock(
    Input: bytes,
    Code: u32,
    Length: u32,
    Starts: u32,
    Localˉblock: u32,
    Counter: u32,
    Scratchˉleft: u32,
    Scratchˉright: u32,
    Scratchˉresult: u32,
    Scratchˉpointer: u32,
    Scratchˉwideˉleft: u32,
    Scratchˉwideˉright: u32,
    Scratchˉwideˉresult: u32,
    Frameˉbase: u32,
    Control: Controls.Compilerˉwebassemblyˉcontrolˉflowˉsummary,
    Reachableˉorder: bytes,
    Directory: Functions.Compilerˉwebassemblyˉfunctionˉdirectoryˉsummary,
    Types: Typeˉdirectory.Compilerˉwebassemblyˉtypeˉdirectoryˉsummary,
    Enumˉsummary: Enums.Compilerˉwebassemblyˉenumˉsummary,
    Storage: Recordˉstorage.Compilerˉwebassemblyˉrecordˉstorageˉsummary,
    Function: u32,
    Runtime: Runtimeˉhelpers
) -> Emission {
    let Block: u32 = Starts + Localˉblock;
    let Start: u32 = Controls.Compilerˉwebassemblyˉcontrolˉflowˉblockˉstart(
        Control,
        Block
    );
    let Blockˉlength: u32 =
        Controls.Compilerˉwebassemblyˉcontrolˉflowˉblockˉlength(
            Control,
            Block
        );
    let Kind: u32 = Controls.Compilerˉwebassemblyˉcontrolˉflowˉblockˉkind(
        Control,
        Block
    );
    if Start > Length || Blockˉlength > Length - Start {
        return Invalidˉemission(Input, Start, 0u32);
    }
    let End: u32 = Start + Blockˉlength;
    var Instructionˉcursor: u32 = Start;
    var Instructionˉcount: u32 = 0u32;
    while Instructionˉcursor < End {
        let Instructionˉwidth: u32 =
            Functions.Compilerˉwebassemblyˉinstructionˉwidth(
                Input,
                Code,
                Length,
                Instructionˉcursor
            );
        if Instructionˉwidth == 0u32 ||
            Instructionˉwidth > End - Instructionˉcursor {
            return Invalidˉemission(Input, Instructionˉcursor, 0u32);
        }
        Instructionˉcursor = Instructionˉcursor + Instructionˉwidth;
        Instructionˉcount = Instructionˉcount + 1u32;
    }
    if Instructionˉcursor != End || Instructionˉcount == 0u32 {
        return Invalidˉemission(Input, Instructionˉcursor, 0u32);
    }
    let Returnsˉvalue: bool = Functionˉreturnsˉvalue(
        Input,
        Directory,
        Function
    );
    let Returnsˉi64: bool = Functionˉreturnsˉi64(
        Input,
        Directory,
        Function
    );
    var Result: bytes = Emitˉmeter(
        Instructionˉcount,
        Returnsˉvalue,
        Returnsˉi64,
        Runtime.Meterˉfunction
    );
    var State: Typed.Compilerˉwebassemblyˉtypedˉinstructionˉstate =
        Typed.Compilerˉwebassemblyˉtypedˉinstructionˉinitial();
    var Cursor: u32 = Start;
    while Cursor < End {
        let Chunk: bytes = Emitˉinstructionˉgroupˉpacked(
            Input,
            Code,
            Length,
            End,
            Kind,
            Cursor,
            State,
            Returnsˉvalue,
            Returnsˉi64,
            Reachableˉorder,
            Directory,
            Types,
            Enumˉsummary,
            Storage,
            Function,
            Frameˉbase,
            Scratchˉleft,
            Scratchˉright,
            Scratchˉresult,
            Scratchˉpointer,
            Scratchˉwideˉleft,
            Scratchˉwideˉright,
            Scratchˉwideˉresult,
            Runtime
        );
        if Bytesˉlength(Chunk) < 64u32 ||
            Bytesˉreadˉu32ˉlittle(Chunk, 0u32) != 1u32 {
            var Chunkˉfailureˉoffset: u32 = Cursor;
            var Chunkˉfailureˉopcode: u32 = 0u32;
            if Bytesˉlength(Chunk) >= 12u32 {
                Chunkˉfailureˉoffset =
                    Bytesˉreadˉu32ˉlittle(Chunk, 4u32);
                Chunkˉfailureˉopcode =
                    Bytesˉreadˉu32ˉlittle(Chunk, 8u32);
            }
            return Invalidˉemission(
                Input,
                Chunkˉfailureˉoffset,
                Chunkˉfailureˉopcode
            );
        }
        let Nextˉcursor: u32 = Bytesˉreadˉu32ˉlittle(Chunk, 12u32);
        if Nextˉcursor <= Cursor || Nextˉcursor > End ||
            Bytesˉreadˉu32ˉlittle(Chunk, 16u32) != 1u32 {
            return Invalidˉemission(Input, Cursor, 0u32);
        }
        State = Readˉinstructionˉchunkˉstate(Chunk);
        if !State.Valid {
            return Invalidˉemission(Input, Cursor, 0u32);
        }
        Result = Append(
            Result,
            Bytesˉslice(Chunk, 64u32, Bytesˉlength(Chunk) - 64u32)
        );
        Cursor = Nextˉcursor;
    }
    if Cursor != End || State.Depth != 0u32 {
        return Invalidˉemission(Input, Cursor, 0u32);
    }

    let First: u32 =
        Controls.Compilerˉwebassemblyˉcontrolˉflowˉblockˉfirstˉsuccessor(
            Control,
            Block
        );
    if Kind == 0u32 || Kind == 1u32 {
        if First == 4294967295u32 {
            return Invalidˉemission(Input, End, 0u32);
        }
        Result = Append(Result, Emitˉsetˉprogramˉcounter(Counter, First));
        Result = Append(Result, Indexed(12u32, 1u32));
        return Emission(true, Result, 0u32, 0u32);
    }
    if Kind == 2u32 {
        let Second: u32 =
            Controls.Compilerˉwebassemblyˉcontrolˉflowˉblockˉsecondˉsuccessor(
                Control,
                Block
            );
        if First == 4294967295u32 || Second == 4294967295u32 {
            return Invalidˉemission(Input, End, 49u32);
        }
        Result = Append(Result, Byte(4u32));
        Result = Append(Result, Byte(64u32));
        Result = Append(Result, Emitˉsetˉprogramˉcounter(Counter, First));
        Result = Append(Result, Byte(5u32));
        Result = Append(Result, Emitˉsetˉprogramˉcounter(Counter, Second));
        Result = Append(Result, Byte(11u32));
        Result = Append(Result, Indexed(12u32, 1u32));
        return Emission(true, Result, 0u32, 0u32);
    }
    if Kind == 3u32 {
        let Returnˉkind: u32 = Shapeˉkind(
            Input,
            Functions.Compilerˉwebassemblyˉfunctionˉresultˉtypeˉoffset(
                Directory,
                Function
            )
        );
        if Runtime.Hasˉdynamic {
            if Shapeˉisˉdescriptor(Returnˉkind) {
                Result = Append(
                    Result,
                    Indexed(33u32, Scratchˉwideˉresult)
                );
            }
            Result = Append(
                Result,
                Emitˉdescriptorˉcleanup(
                    Input,
                    Directory,
                    Storage,
                    Function,
                    Runtime.Referenceˉfunction
                )
            );
            Result = Append(
                Result,
                Records.Compilerˉwebassemblyˉrecordˉfunctionˉcleanup(
                    Input,
                    Directory,
                    Types,
                    Storage,
                    Function,
                    Frameˉbase,
                    Records.Compilerˉwebassemblyˉrecordˉruntime(
                        Runtime.Hasˉdynamic,
                        Runtime.Referenceˉfunction
                    )
                )
            );
            if Shapeˉisˉdescriptor(Returnˉkind) {
                Result = Append(
                    Result,
                    Indexed(32u32, Scratchˉwideˉresult)
                );
            }
        }
        let Recordˉreturn:
            Records.Compilerˉwebassemblyˉrecordˉoperationˉemission =
            Records.Compilerˉwebassemblyˉrecordˉfunctionˉreturn(
                Input,
                Directory,
                Storage,
                Function,
                Frameˉbase,
                Scratchˉleft,
                4u32
            );
        if !Recordˉreturn.Valid {
            return Invalidˉemission(Input, End, 81u32);
        }
        if Recordˉreturn.Matched {
            Result = Append(Result, Recordˉreturn.Bytes);
        } else {
            Result = Append(
                Result,
                Records.Compilerˉwebassemblyˉrecordˉfunctionˉrestore(
                    Input,
                    Storage,
                    Function,
                    Frameˉbase,
                    4u32
                )
            );
            Result = Append(Result, Byte(15u32));
        }
        return Emission(true, Result, 0u32, 0u32);
    }
    return Invalidˉemission(Input, End, Kind);
}

fn Emitˉblockˉpacked(
    Input: bytes,
    Code: u32,
    Length: u32,
    Starts: u32,
    Localˉblock: u32,
    Counter: u32,
    Scratchˉleft: u32,
    Scratchˉright: u32,
    Scratchˉresult: u32,
    Scratchˉpointer: u32,
    Scratchˉwideˉleft: u32,
    Scratchˉwideˉright: u32,
    Scratchˉwideˉresult: u32,
    Frameˉbase: u32,
    Control: Controls.Compilerˉwebassemblyˉcontrolˉflowˉsummary,
    Reachableˉorder: bytes,
    Directory: Functions.Compilerˉwebassemblyˉfunctionˉdirectoryˉsummary,
    Types: Typeˉdirectory.Compilerˉwebassemblyˉtypeˉdirectoryˉsummary,
    Enumˉsummary: Enums.Compilerˉwebassemblyˉenumˉsummary,
    Storage: Recordˉstorage.Compilerˉwebassemblyˉrecordˉstorageˉsummary,
    Function: u32,
    Runtime: Runtimeˉhelpers
) -> bytes {
    return Packˉemission(
        Emitˉblock(
            Input,
            Code,
            Length,
            Starts,
            Localˉblock,
            Counter,
            Scratchˉleft,
            Scratchˉright,
            Scratchˉresult,
            Scratchˉpointer,
            Scratchˉwideˉleft,
            Scratchˉwideˉright,
            Scratchˉwideˉresult,
            Frameˉbase,
            Control,
            Reachableˉorder,
            Directory,
            Types,
            Enumˉsummary,
            Storage,
            Function,
            Runtime
        )
    );
}

fn Emitˉblockˉchunkˉpacked(
    Input: bytes,
    Code: u32,
    Length: u32,
    Starts: u32,
    Start: u32,
    End: u32,
    Counter: u32,
    Scratchˉleft: u32,
    Scratchˉright: u32,
    Scratchˉresult: u32,
    Scratchˉpointer: u32,
    Scratchˉwideˉleft: u32,
    Scratchˉwideˉright: u32,
    Scratchˉwideˉresult: u32,
    Frameˉbase: u32,
    Control: Controls.Compilerˉwebassemblyˉcontrolˉflowˉsummary,
    Reachableˉorder: bytes,
    Directory: Functions.Compilerˉwebassemblyˉfunctionˉdirectoryˉsummary,
    Types: Typeˉdirectory.Compilerˉwebassemblyˉtypeˉdirectoryˉsummary,
    Enumˉsummary: Enums.Compilerˉwebassemblyˉenumˉsummary,
    Storage: Recordˉstorage.Compilerˉwebassemblyˉrecordˉstorageˉsummary,
    Function: u32,
    Runtime: Runtimeˉhelpers
) -> bytes {
    var Result: bytes = Empty(Input);
    var Localˉblock: u32 = Start;
    while Localˉblock < End {
        Result = Append(Result, Indexed(32u32, Counter));
        Result = Append(Result, Positiveˉconstant(Localˉblock));
        Result = Append(Result, Byte(70u32));
        Result = Append(Result, Byte(4u32));
        Result = Append(Result, Byte(64u32));
        let Block: bytes = Emitˉblockˉpacked(
            Input,
            Code,
            Length,
            Starts,
            Localˉblock,
            Counter,
            Scratchˉleft,
            Scratchˉright,
            Scratchˉresult,
            Scratchˉpointer,
            Scratchˉwideˉleft,
            Scratchˉwideˉright,
            Scratchˉwideˉresult,
            Frameˉbase,
            Control,
            Reachableˉorder,
            Directory,
            Types,
            Enumˉsummary,
            Storage,
            Function,
            Runtime
        );
        if Bytesˉlength(Block) < 12u32 ||
            Bytesˉreadˉu32ˉlittle(Block, 0u32) != 1u32 {
            return Block;
        }
        Result = Append(
            Result,
            Bytesˉslice(Block, 12u32, Bytesˉlength(Block) - 12u32)
        );
        Result = Append(Result, Byte(11u32));
        Localˉblock = Localˉblock + 1u32;
    }
    return Packˉemission(Emission(true, Result, 0u32, 0u32));
}

fn Emitˉblockˉgroupˉpacked(
    Input: bytes,
    Code: u32,
    Length: u32,
    Starts: u32,
    Start: u32,
    End: u32,
    Counter: u32,
    Scratchˉleft: u32,
    Scratchˉright: u32,
    Scratchˉresult: u32,
    Scratchˉpointer: u32,
    Scratchˉwideˉleft: u32,
    Scratchˉwideˉright: u32,
    Scratchˉwideˉresult: u32,
    Frameˉbase: u32,
    Control: Controls.Compilerˉwebassemblyˉcontrolˉflowˉsummary,
    Reachableˉorder: bytes,
    Directory: Functions.Compilerˉwebassemblyˉfunctionˉdirectoryˉsummary,
    Types: Typeˉdirectory.Compilerˉwebassemblyˉtypeˉdirectoryˉsummary,
    Enumˉsummary: Enums.Compilerˉwebassemblyˉenumˉsummary,
    Storage: Recordˉstorage.Compilerˉwebassemblyˉrecordˉstorageˉsummary,
    Function: u32,
    Runtime: Runtimeˉhelpers
) -> bytes {
    var Result: bytes = Empty(Input);
    var Chunkˉstart: u32 = Start;
    while Chunkˉstart < End {
        var Chunkˉend: u32 = Chunkˉstart + 8u32;
        if Chunkˉend > End { Chunkˉend = End; }
        let Chunk: bytes = Emitˉblockˉchunkˉpacked(
            Input,
            Code,
            Length,
            Starts,
            Chunkˉstart,
            Chunkˉend,
            Counter,
            Scratchˉleft,
            Scratchˉright,
            Scratchˉresult,
            Scratchˉpointer,
            Scratchˉwideˉleft,
            Scratchˉwideˉright,
            Scratchˉwideˉresult,
            Frameˉbase,
            Control,
            Reachableˉorder,
            Directory,
            Types,
            Enumˉsummary,
            Storage,
            Function,
            Runtime
        );
        if Bytesˉlength(Chunk) < 12u32 ||
            Bytesˉreadˉu32ˉlittle(Chunk, 0u32) != 1u32 {
            return Chunk;
        }
        Result = Append(
            Result,
            Bytesˉslice(Chunk, 12u32, Bytesˉlength(Chunk) - 12u32)
        );
        Chunkˉstart = Chunkˉend;
    }
    return Packˉemission(Emission(true, Result, 0u32, 0u32));
}

fn Emitˉfunction(
    Input: bytes,
    Codeˉoffset: u32,
    Directory: Functions.Compilerˉwebassemblyˉfunctionˉdirectoryˉsummary,
    Control: Controls.Compilerˉwebassemblyˉcontrolˉflowˉsummary,
    Reachableˉorder: bytes,
    Types: Typeˉdirectory.Compilerˉwebassemblyˉtypeˉdirectoryˉsummary,
    Enumˉsummary: Enums.Compilerˉwebassemblyˉenumˉsummary,
    Storage: Recordˉstorage.Compilerˉwebassemblyˉrecordˉstorageˉsummary,
    Function: u32,
    Runtime: Runtimeˉhelpers
) -> Emission {
    var Typeˉlayout: Layouts.Compilerˉwebassemblyˉvalueˉlayoutˉemission =
        Layouts.Compilerˉwebassemblyˉvalueˉlayoutˉfunctionˉtype(
            Input,
            Directory,
            Function
        );
    let Returnˉfields: u32 =
        Recordˉstorage.Compilerˉwebassemblyˉrecordˉstorageˉreturnˉfields(
            Storage,
            Function
        );
    if Returnˉfields != 0u32 {
        Typeˉlayout =
            Layouts.Compilerˉwebassemblyˉvalueˉlayoutˉrecordˉfunctionˉtype(
                Input,
                Directory,
                Function
            );
    }
    if !Typeˉlayout.Valid {
        return Invalidˉemission(Input, 0u32, 0u32);
    }
    let Functionˉcodeˉrelative: u32 =
        Functions.Compilerˉwebassemblyˉfunctionˉcodeˉoffset(
            Directory,
            Function
        );
    let Functionˉcodeˉlength: u32 =
        Functions.Compilerˉwebassemblyˉfunctionˉcodeˉlength(
            Directory,
            Function
        );
    let Functionˉcode: u32 = Codeˉoffset + Functionˉcodeˉrelative;
    let Firstˉblock: u32 =
        Controls.Compilerˉwebassemblyˉcontrolˉflowˉfunctionˉfirstˉblock(
            Control,
            Function
        );
    let Blockˉcount: u32 =
        Controls.Compilerˉwebassemblyˉcontrolˉflowˉfunctionˉblockˉcount(
            Control,
            Function
        );
    if Blockˉcount == 0u32 { return Invalidˉemission(Input, 0u32, 0u32); }
    let Parameterˉcount: u32 =
        Functions.Compilerˉwebassemblyˉfunctionˉparameterˉcount(
            Directory,
            Function
        );
    let Localˉcount: u32 =
        Functions.Compilerˉwebassemblyˉfunctionˉlocalˉcount(
            Directory,
            Function
        );
    var Emittedˉparameterˉcount: u32 = Parameterˉcount;
    if Returnˉfields != 0u32 {
        Emittedˉparameterˉcount = Emittedˉparameterˉcount + 1u32;
    }
    let Counter: u32 = Emittedˉparameterˉcount + Localˉcount;
    let Scratchˉleft: u32 = Counter + 1u32;
    let Scratchˉright: u32 = Counter + 2u32;
    let Scratchˉresult: u32 = Counter + 3u32;
    let Frameˉbytes: u32 =
        Recordˉstorage.Compilerˉwebassemblyˉrecordˉstorageˉframeˉbytes(
            Storage,
            Function
        );
    var Additionalˉi32: u32 = 0u32;
    if Frameˉbytes != 0u32 { Additionalˉi32 = Additionalˉi32 + 1u32; }
    if Runtime.Hasˉdynamic { Additionalˉi32 = Additionalˉi32 + 1u32; }
    let Frameˉbase: u32 = Counter + 4u32;
    var Scratchˉpointer: u32 = Scratchˉresult;
    if Runtime.Hasˉdynamic {
        Scratchˉpointer = Counter + 4u32;
        if Frameˉbytes != 0u32 { Scratchˉpointer = Counter + 5u32; }
    }
    let Scratchˉwideˉleft: u32 = Counter + 4u32 + Additionalˉi32;
    let Scratchˉwideˉright: u32 = Scratchˉwideˉleft + 1u32;
    let Scratchˉwideˉresult: u32 = Scratchˉwideˉleft + 2u32;
    var Localˉlayout: Layouts.Compilerˉwebassemblyˉvalueˉlayoutˉemission =
        Layouts.Compilerˉwebassemblyˉvalueˉlayoutˉfunctionˉlocals(
            Input,
            Directory,
            Function
        );
    if Frameˉbytes != 0u32 {
        Localˉlayout =
            Layouts.Compilerˉwebassemblyˉvalueˉlayoutˉrecordˉfunctionˉlocals(
                Input,
                Directory,
                Function
            );
    }
    if Runtime.Hasˉdynamic {
        Localˉlayout =
            Layouts.Compilerˉwebassemblyˉvalueˉlayoutˉruntimeˉfunctionˉlocals(
                Input,
                Directory,
                Function,
                Additionalˉi32,
                2u32
            );
    }
    if !Localˉlayout.Valid {
        return Invalidˉemission(Input, 0u32, 0u32);
    }
    let Localˉdeclarations: bytes = Localˉlayout.Bytes;

    let Enumˉdefaults: Emission = Emitˉenumˉlocalˉdefaults(
        Input,
        Directory,
        Types,
        Enumˉsummary,
        Function,
        Emittedˉparameterˉcount,
        Localˉcount
    );
    if !Enumˉdefaults.Valid { return Enumˉdefaults; }

    var Instructions: bytes =
        Records.Compilerˉwebassemblyˉrecordˉfunctionˉprologue(
            Input,
            Directory,
            Types,
            Storage,
            Function,
            Frameˉbase,
            Scratchˉresult,
            Functionˉreturnsˉvalue(Input, Directory, Function),
            Functionˉreturnsˉi64(Input, Directory, Function),
            3u32,
            4u32,
            Runtime.Frameˉlimit,
            Records.Compilerˉwebassemblyˉrecordˉruntime(
                Runtime.Hasˉdynamic,
                Runtime.Referenceˉfunction
            )
        );
    Instructions = Append(Instructions, Enumˉdefaults.Bytes);
    Instructions = Append(
        Instructions,
        Emitˉsetˉprogramˉcounter(Counter, 0u32)
    );
    Instructions = Append(Instructions, Byte(3u32));
    Instructions = Append(Instructions, Byte(64u32));
    var Localˉblock: u32 = 0u32;
    while Localˉblock < Blockˉcount {
        var Groupˉend: u32 = Localˉblock + 64u32;
        if Groupˉend > Blockˉcount { Groupˉend = Blockˉcount; }
        let Blocks: bytes = Emitˉblockˉgroupˉpacked(
            Input,
            Functionˉcode,
            Functionˉcodeˉlength,
            Firstˉblock,
            Localˉblock,
            Groupˉend,
            Counter,
            Scratchˉleft,
            Scratchˉright,
            Scratchˉresult,
            Scratchˉpointer,
            Scratchˉwideˉleft,
            Scratchˉwideˉright,
            Scratchˉwideˉresult,
            Frameˉbase,
            Control,
            Reachableˉorder,
            Directory,
            Types,
            Enumˉsummary,
            Storage,
            Function,
            Runtime
        );
        if Bytesˉlength(Blocks) < 12u32 ||
            Bytesˉreadˉu32ˉlittle(Blocks, 0u32) != 1u32 {
            var Blockˉfailureˉoffset: u32 = 0u32;
            var Blockˉfailureˉopcode: u32 = 0u32;
            if Bytesˉlength(Blocks) >= 12u32 {
                Blockˉfailureˉoffset =
                    Bytesˉreadˉu32ˉlittle(Blocks, 4u32);
                Blockˉfailureˉopcode =
                    Bytesˉreadˉu32ˉlittle(Blocks, 8u32);
            }
            return Invalidˉemission(
                Input,
                Blockˉfailureˉoffset,
                Blockˉfailureˉopcode
            );
        }
        Instructions = Append(
            Instructions,
            Bytesˉslice(Blocks, 12u32, Bytesˉlength(Blocks) - 12u32)
        );
        Localˉblock = Groupˉend;
    }
    Instructions = Append(Instructions, Byte(0u32));
    Instructions = Append(Instructions, Byte(11u32));
    Instructions = Append(Instructions, Byte(0u32));
    return Emission(
        true,
        Encoding.Compilerˉwebassemblyˉbinaryˉfunctionˉbody(
            Localˉdeclarations,
            Instructions
        ),
        0u32,
        0u32
    );
}

fn Emitˉtypeˉpacked(
    Input: bytes,
    Directory: Functions.Compilerˉwebassemblyˉfunctionˉdirectoryˉsummary,
    Storage: Recordˉstorage.Compilerˉwebassemblyˉrecordˉstorageˉsummary,
    Function: u32
) -> bytes {
    return Packˉemission(Emitˉtype(Input, Directory, Storage, Function));
}

fn Emitˉfunctionˉpacked(
    Input: bytes,
    Codeˉoffset: u32,
    Directory: Functions.Compilerˉwebassemblyˉfunctionˉdirectoryˉsummary,
    Control: Controls.Compilerˉwebassemblyˉcontrolˉflowˉsummary,
    Reachableˉorder: bytes,
    Types: Typeˉdirectory.Compilerˉwebassemblyˉtypeˉdirectoryˉsummary,
    Enumˉsummary: Enums.Compilerˉwebassemblyˉenumˉsummary,
    Storage: Recordˉstorage.Compilerˉwebassemblyˉrecordˉstorageˉsummary,
    Function: u32,
    Runtime: Runtimeˉhelpers
) -> bytes {
    return Packˉemission(
        Emitˉfunction(
            Input,
            Codeˉoffset,
            Directory,
            Control,
            Reachableˉorder,
            Types,
            Enumˉsummary,
            Storage,
            Function,
            Runtime
        )
    );
}

fn Packˉchunkˉfailure(
    Function: u32,
    Offset: u32,
    Opcode: u32
) -> bytes {
    var Result: bytes = Bytesˉfromˉu32ˉlittle(0u32);
    Result = Append(Result, Bytesˉfromˉu32ˉlittle(Function));
    Result = Append(Result, Bytesˉfromˉu32ˉlittle(Offset));
    Result = Append(Result, Bytesˉfromˉu32ˉlittle(Opcode));
    Result = Append(Result, Bytesˉfromˉu32ˉlittle(0u32));
    return Append(Result, Bytesˉfromˉu32ˉlittle(0u32));
}

fn Packˉchunkˉsuccess(
    Typeˉentries: bytes,
    Functionˉentries: bytes,
    Codeˉentries: bytes
) -> bytes {
    var Result: bytes = Bytesˉfromˉu32ˉlittle(1u32);
    Result = Append(Result, Bytesˉfromˉu32ˉlittle(0u32));
    Result = Append(Result, Bytesˉfromˉu32ˉlittle(0u32));
    Result = Append(Result, Bytesˉfromˉu32ˉlittle(0u32));
    Result = Append(
        Result,
        Bytesˉfromˉu32ˉlittle(Bytesˉlength(Typeˉentries))
    );
    Result = Append(
        Result,
        Bytesˉfromˉu32ˉlittle(Bytesˉlength(Functionˉentries))
    );
    Result = Append(Result, Typeˉentries);
    Result = Append(Result, Functionˉentries);
    return Append(Result, Codeˉentries);
}

fn Emitˉfunctionˉchunkˉpacked(
    Input: bytes,
    Codeˉoffset: u32,
    Directory: Functions.Compilerˉwebassemblyˉfunctionˉdirectoryˉsummary,
    Control: Controls.Compilerˉwebassemblyˉcontrolˉflowˉsummary,
    Graph: Graphs.Compilerˉwebassemblyˉexecutableˉgraphˉsummary,
    Types: Typeˉdirectory.Compilerˉwebassemblyˉtypeˉdirectoryˉsummary,
    Enumˉsummary: Enums.Compilerˉwebassemblyˉenumˉsummary,
    Storage: Recordˉstorage.Compilerˉwebassemblyˉrecordˉstorageˉsummary,
    Runtime: Runtimeˉhelpers,
    Start: u32,
    End: u32
) -> bytes {
    var Typeˉentries: bytes = Empty(Input);
    var Functionˉentries: bytes = Empty(Input);
    var Codeˉentries: bytes = Empty(Input);
    var Position: u32 = Start;
    while Position < End {
        let Function: u32 = Bytesˉreadˉu32ˉlittle(
            Graph.Reachableˉorder,
            Position * 4u32
        );
        if Function >= Directory.Count {
            return Packˉchunkˉfailure(Function, 0u32, 0u32);
        }
        let Type: bytes = Emitˉtypeˉpacked(
            Input,
            Directory,
            Storage,
            Function
        );
        if Bytesˉlength(Type) < 12u32 ||
            Bytesˉreadˉu32ˉlittle(Type, 0u32) != 1u32 {
            var Typeˉfailureˉoffset: u32 = 0u32;
            var Typeˉfailureˉopcode: u32 = 0u32;
            if Bytesˉlength(Type) >= 12u32 {
                Typeˉfailureˉoffset = Bytesˉreadˉu32ˉlittle(Type, 4u32);
                Typeˉfailureˉopcode = Bytesˉreadˉu32ˉlittle(Type, 8u32);
            }
            return Packˉchunkˉfailure(
                Function,
                Typeˉfailureˉoffset,
                Typeˉfailureˉopcode
            );
        }
        Typeˉentries = Append(
            Typeˉentries,
            Bytesˉslice(Type, 12u32, Bytesˉlength(Type) - 12u32)
        );
        Functionˉentries = Append(Functionˉentries, Uleb(Position));

        let Body: bytes = Emitˉfunctionˉpacked(
            Input,
            Codeˉoffset,
            Directory,
            Control,
            Graph.Reachableˉorder,
            Types,
            Enumˉsummary,
            Storage,
            Function,
            Runtime
        );
        if Bytesˉlength(Body) < 12u32 ||
            Bytesˉreadˉu32ˉlittle(Body, 0u32) != 1u32 {
            var Bodyˉfailureˉoffset: u32 = 0u32;
            var Bodyˉfailureˉopcode: u32 = 0u32;
            if Bytesˉlength(Body) >= 12u32 {
                Bodyˉfailureˉoffset = Bytesˉreadˉu32ˉlittle(Body, 4u32);
                Bodyˉfailureˉopcode = Bytesˉreadˉu32ˉlittle(Body, 8u32);
            }
            return Packˉchunkˉfailure(
                Function,
                Bodyˉfailureˉoffset,
                Bodyˉfailureˉopcode
            );
        }
        Codeˉentries = Append(
            Codeˉentries,
            Bytesˉslice(Body, 12u32, Bytesˉlength(Body) - 12u32)
        );
        Position = Position + 1u32;
    }
    return Packˉchunkˉsuccess(
        Typeˉentries,
        Functionˉentries,
        Codeˉentries
    );
}

fn Emitˉfunctionˉgroupˉpacked(
    Input: bytes,
    Codeˉoffset: u32,
    Directory: Functions.Compilerˉwebassemblyˉfunctionˉdirectoryˉsummary,
    Control: Controls.Compilerˉwebassemblyˉcontrolˉflowˉsummary,
    Graph: Graphs.Compilerˉwebassemblyˉexecutableˉgraphˉsummary,
    Types: Typeˉdirectory.Compilerˉwebassemblyˉtypeˉdirectoryˉsummary,
    Enumˉsummary: Enums.Compilerˉwebassemblyˉenumˉsummary,
    Storage: Recordˉstorage.Compilerˉwebassemblyˉrecordˉstorageˉsummary,
    Runtime: Runtimeˉhelpers,
    Start: u32,
    End: u32
) -> bytes {
    var Typeˉentries: bytes = Empty(Input);
    var Functionˉentries: bytes = Empty(Input);
    var Codeˉentries: bytes = Empty(Input);
    var Chunkˉstart: u32 = Start;
    while Chunkˉstart < End {
        var Chunkˉend: u32 = Chunkˉstart + 8u32;
        if Chunkˉend > End { Chunkˉend = End; }
        let Chunk: bytes = Emitˉfunctionˉchunkˉpacked(
            Input,
            Codeˉoffset,
            Directory,
            Control,
            Graph,
            Types,
            Enumˉsummary,
            Storage,
            Runtime,
            Chunkˉstart,
            Chunkˉend
        );
        if Bytesˉlength(Chunk) < 24u32 ||
            Bytesˉreadˉu32ˉlittle(Chunk, 0u32) != 1u32 {
            return Chunk;
        }
        let Typeˉlength: u32 = Bytesˉreadˉu32ˉlittle(Chunk, 16u32);
        let Functionˉlength: u32 = Bytesˉreadˉu32ˉlittle(Chunk, 20u32);
        if Typeˉlength > Bytesˉlength(Chunk) - 24u32 ||
            Functionˉlength > Bytesˉlength(Chunk) - 24u32 - Typeˉlength {
            return Packˉchunkˉfailure(Graph.Root, 0u32, 0u32);
        }
        let Functionˉoffset: u32 = 24u32 + Typeˉlength;
        let Codeˉentryˉoffset: u32 = Functionˉoffset + Functionˉlength;
        Typeˉentries = Append(
            Typeˉentries,
            Bytesˉslice(Chunk, 24u32, Typeˉlength)
        );
        Functionˉentries = Append(
            Functionˉentries,
            Bytesˉslice(Chunk, Functionˉoffset, Functionˉlength)
        );
        Codeˉentries = Append(
            Codeˉentries,
            Bytesˉslice(
                Chunk,
                Codeˉentryˉoffset,
                Bytesˉlength(Chunk) - Codeˉentryˉoffset
            )
        );
        Chunkˉstart = Chunkˉend;
    }
    return Packˉchunkˉsuccess(
        Typeˉentries,
        Functionˉentries,
        Codeˉentries
    );
}

fn Descriptorˉlength(Local: u32) -> bytes {
    var Result: bytes = Indexed(32u32, Local);
    Result = Append(Result, Append(Byte(66u32), Byte(32u32)));
    Result = Append(Result, Byte(136u32));
    return Append(Result, Byte(167u32));
}

fn Descriptorˉpointer(Local: u32) -> bytes {
    return Append(Indexed(32u32, Local), Byte(167u32));
}

fn Packˉdescriptor(Pointer: u32, Length: u32) -> bytes {
    var Result: bytes = Indexed(32u32, Pointer);
    Result = Append(Result, Byte(173u32));
    Result = Append(Result, Indexed(32u32, Length));
    Result = Append(Result, Byte(173u32));
    Result = Append(Result, Append(Byte(66u32), Byte(32u32)));
    Result = Append(Result, Byte(134u32));
    return Append(Result, Byte(132u32));
}

fn Memoryˉcopy() -> bytes {
    var Result: bytes = Byte(252u32);
    Result = Append(Result, Uleb(10u32));
    Result = Append(Result, Uleb(0u32));
    return Append(Result, Uleb(0u32));
}

fn Emitˉmeterˉtype() -> bytes {
    var Result: bytes = Byte(96u32);
    Result = Append(Result, Uleb(1u32));
    Result = Append(Result, Byte(127u32));
    Result = Append(Result, Uleb(1u32));
    return Append(Result, Byte(127u32));
}

fn Emitˉmeterˉbody() -> bytes {
    var Instructions: bytes = Indexed(35u32, 2u32);
    Instructions = Append(Instructions, I32ˉnegativeˉoneˉconstant());
    Instructions = Append(Instructions, Byte(71u32));
    Instructions = Append(Instructions, Byte(4u32));
    Instructions = Append(Instructions, Byte(64u32));
    Instructions = Append(Instructions, Indexed(35u32, 2u32));
    Instructions = Append(Instructions, Indexed(35u32, 1u32));
    Instructions = Append(Instructions, Byte(107u32));
    Instructions = Append(Instructions, Indexed(32u32, 0u32));
    Instructions = Append(Instructions, Byte(73u32));
    Instructions = Append(Instructions, Byte(4u32));
    Instructions = Append(Instructions, Byte(64u32));
    Instructions = Append(Instructions, Indexed(35u32, 2u32));
    Instructions = Append(Instructions, Indexed(36u32, 1u32));
    Instructions = Append(Instructions, Positiveˉconstant(3011u32));
    Instructions = Append(Instructions, Indexed(36u32, 3u32));
    Instructions = Append(Instructions, Positiveˉconstant(1u32));
    Instructions = Append(Instructions, Byte(15u32));
    Instructions = Append(Instructions, Byte(11u32));
    Instructions = Append(Instructions, Byte(11u32));
    Instructions = Append(Instructions, Indexed(35u32, 1u32));
    Instructions = Append(Instructions, Indexed(32u32, 0u32));
    Instructions = Append(Instructions, Byte(106u32));
    Instructions = Append(Instructions, Indexed(36u32, 1u32));
    Instructions = Append(Instructions, Positiveˉconstant(0u32));
    return Encoding.Compilerˉwebassemblyˉbinaryˉfunctionˉbody(
        Uleb(0u32),
        Instructions
    );
}

fn Emitˉwrapper(
    Rootˉposition: u32,
    Hasˉrecords: bool,
    Hasˉdynamic: bool,
    Freeˉglobal: u32,
    Frameˉstart: u32
) -> bytes {
    var Localˉdeclarations: bytes = Uleb(1u32);
    Localˉdeclarations = Append(Localˉdeclarations, Uleb(1u32));
    Localˉdeclarations = Append(Localˉdeclarations, Byte(127u32));

    var Instructions: bytes = Positiveˉconstant(0u32);
    Instructions = Append(Instructions, Indexed(36u32, 0u32));
    Instructions = Append(Instructions, Positiveˉconstant(0u32));
    Instructions = Append(Instructions, Indexed(36u32, 1u32));
    Instructions = Append(Instructions, Indexed(32u32, 0u32));
    Instructions = Append(Instructions, Indexed(36u32, 2u32));
    Instructions = Append(Instructions, Positiveˉconstant(0u32));
    Instructions = Append(Instructions, Indexed(36u32, 3u32));
    if Hasˉdynamic {
        Instructions = Append(
            Instructions,
            Descriptorˉstorage.Compilerˉwebassemblyˉdescriptorˉstorageˉinitialize(
                Freeˉglobal
            )
        );
    }
    if Hasˉrecords {
        Instructions = Append(Instructions, Positiveˉconstant(Frameˉstart));
        Instructions = Append(Instructions, Indexed(36u32, 4u32));
    }

    Instructions = Append(Instructions, Indexed(32u32, 0u32));
    Instructions = Append(Instructions, Byte(69u32));
    Instructions = Append(Instructions, Byte(4u32));
    Instructions = Append(Instructions, Byte(64u32));
    Instructions = Append(Instructions, Positiveˉconstant(3011u32));
    Instructions = Append(Instructions, Indexed(36u32, 3u32));
    Instructions = Append(Instructions, Indexed(35u32, 3u32));
    Instructions = Append(Instructions, Byte(15u32));
    Instructions = Append(Instructions, Byte(11u32));

    Instructions = Append(Instructions, Indexed(16u32, Rootˉposition));
    if Hasˉrecords {
        Instructions = Append(Instructions, Positiveˉconstant(Frameˉstart));
        Instructions = Append(Instructions, Indexed(36u32, 4u32));
    }
    Instructions = Append(Instructions, Indexed(33u32, 1u32));
    Instructions = Append(Instructions, Indexed(35u32, 3u32));
    Instructions = Append(Instructions, Byte(69u32));
    Instructions = Append(Instructions, Byte(4u32));
    Instructions = Append(Instructions, Byte(64u32));
    Instructions = Append(Instructions, Indexed(32u32, 1u32));
    Instructions = Append(Instructions, Indexed(36u32, 0u32));
    Instructions = Append(Instructions, Byte(11u32));
    Instructions = Append(Instructions, Indexed(35u32, 3u32));
    return Encoding.Compilerˉwebassemblyˉbinaryˉfunctionˉbody(
        Localˉdeclarations,
        Instructions
    );
}

fn Emitˉmemoryˉwrapper(
    Rootˉposition: u32,
    Hasˉrecords: bool,
    Freeˉglobal: u32,
    Frameˉstart: u32,
    Allocateˉfunction: u32,
    Referenceˉfunction: u32,
    Outputˉlengthˉglobal: u32
) -> bytes {
    let Pointer: u32 = 2u32;
    let Descriptor: u32 = 3u32;
    var Localˉdeclarations: bytes = Uleb(2u32);
    Localˉdeclarations = Append(Localˉdeclarations, Uleb(1u32));
    Localˉdeclarations = Append(Localˉdeclarations, Byte(127u32));
    Localˉdeclarations = Append(Localˉdeclarations, Uleb(1u32));
    Localˉdeclarations = Append(Localˉdeclarations, Byte(126u32));

    var Instructions: bytes = Positiveˉconstant(0u32);
    Instructions = Append(Instructions, Indexed(36u32, 0u32));
    Instructions = Append(Instructions, Positiveˉconstant(0u32));
    Instructions = Append(Instructions, Indexed(36u32, 1u32));
    Instructions = Append(Instructions, Indexed(32u32, 0u32));
    Instructions = Append(Instructions, Indexed(36u32, 2u32));
    Instructions = Append(Instructions, Positiveˉconstant(0u32));
    Instructions = Append(Instructions, Indexed(36u32, 3u32));
    Instructions = Append(Instructions, Positiveˉconstant(0u32));
    Instructions = Append(
        Instructions,
        Indexed(36u32, Outputˉlengthˉglobal)
    );
    Instructions = Append(
        Instructions,
        Descriptorˉstorage.Compilerˉwebassemblyˉdescriptorˉstorageˉinitialize(
            Freeˉglobal
        )
    );
    if Hasˉrecords {
        Instructions = Append(Instructions, Positiveˉconstant(Frameˉstart));
        Instructions = Append(Instructions, Indexed(36u32, 4u32));
    }

    Instructions = Append(Instructions, Indexed(32u32, 0u32));
    Instructions = Append(Instructions, Byte(69u32));
    Instructions = Append(Instructions, Byte(4u32));
    Instructions = Append(Instructions, Byte(64u32));
    Instructions = Append(Instructions, Positiveˉconstant(3011u32));
    Instructions = Append(Instructions, Indexed(36u32, 3u32));
    Instructions = Append(Instructions, Indexed(35u32, 3u32));
    Instructions = Append(Instructions, Byte(15u32));
    Instructions = Append(Instructions, Byte(11u32));

    Instructions = Append(Instructions, Indexed(32u32, 1u32));
    Instructions = Append(Instructions, Positiveˉconstant(4194304u32));
    Instructions = Append(Instructions, Byte(75u32));
    Instructions = Append(Instructions, Byte(4u32));
    Instructions = Append(Instructions, Byte(64u32));
    Instructions = Append(Instructions, Positiveˉconstant(3008u32));
    Instructions = Append(Instructions, Indexed(36u32, 3u32));
    Instructions = Append(Instructions, Indexed(35u32, 3u32));
    Instructions = Append(Instructions, Byte(15u32));
    Instructions = Append(Instructions, Byte(11u32));

    Instructions = Append(Instructions, Indexed(32u32, 1u32));
    Instructions = Append(Instructions, Byte(4u32));
    Instructions = Append(Instructions, Byte(64u32));
    Instructions = Append(Instructions, Indexed(32u32, 1u32));
    Instructions = Append(
        Instructions,
        Indexed(16u32, Allocateˉfunction)
    );
    Instructions = Append(Instructions, Indexed(34u32, Pointer));
    Instructions = Append(Instructions, Byte(69u32));
    Instructions = Append(Instructions, Byte(4u32));
    Instructions = Append(Instructions, Byte(64u32));
    Instructions = Append(Instructions, Positiveˉconstant(3018u32));
    Instructions = Append(Instructions, Indexed(36u32, 3u32));
    Instructions = Append(Instructions, Indexed(35u32, 3u32));
    Instructions = Append(Instructions, Byte(15u32));
    Instructions = Append(Instructions, Byte(11u32));
    Instructions = Append(Instructions, Indexed(32u32, Pointer));
    Instructions = Append(Instructions, Positiveˉconstant(142671872u32));
    Instructions = Append(Instructions, Indexed(32u32, 1u32));
    Instructions = Append(Instructions, Memoryˉcopy());
    Instructions = Append(
        Instructions,
        Packˉdescriptor(Pointer, 1u32)
    );
    Instructions = Append(Instructions, Indexed(33u32, Descriptor));
    Instructions = Append(Instructions, Byte(11u32));

    Instructions = Append(Instructions, Indexed(32u32, Descriptor));
    Instructions = Append(Instructions, Indexed(16u32, Rootˉposition));
    Instructions = Append(Instructions, Indexed(33u32, Descriptor));
    if Hasˉrecords {
        Instructions = Append(Instructions, Positiveˉconstant(Frameˉstart));
        Instructions = Append(Instructions, Indexed(36u32, 4u32));
    }
    Instructions = Append(Instructions, Indexed(35u32, 3u32));
    Instructions = Append(Instructions, Byte(4u32));
    Instructions = Append(Instructions, Byte(64u32));
    Instructions = Append(
        Instructions,
        Descriptorˉstorage.Compilerˉwebassemblyˉdescriptorˉstorageˉreferenceˉlocal(
            Descriptor,
            false,
            Referenceˉfunction
        )
    );
    Instructions = Append(Instructions, Indexed(35u32, 3u32));
    Instructions = Append(Instructions, Byte(15u32));
    Instructions = Append(Instructions, Byte(11u32));

    Instructions = Append(Instructions, Descriptorˉlength(Descriptor));
    Instructions = Append(
        Instructions,
        Indexed(36u32, Outputˉlengthˉglobal)
    );
    Instructions = Append(
        Instructions,
        Indexed(35u32, Outputˉlengthˉglobal)
    );
    Instructions = Append(Instructions, Positiveˉconstant(16777216u32));
    Instructions = Append(Instructions, Byte(75u32));
    Instructions = Append(Instructions, Byte(4u32));
    Instructions = Append(Instructions, Byte(64u32));
    Instructions = Append(Instructions, Positiveˉconstant(3015u32));
    Instructions = Append(Instructions, Indexed(36u32, 3u32));
    Instructions = Append(
        Instructions,
        Descriptorˉstorage.Compilerˉwebassemblyˉdescriptorˉstorageˉreferenceˉlocal(
            Descriptor,
            false,
            Referenceˉfunction
        )
    );
    Instructions = Append(Instructions, Indexed(35u32, 3u32));
    Instructions = Append(Instructions, Byte(15u32));
    Instructions = Append(Instructions, Byte(11u32));

    Instructions = Append(
        Instructions,
        Positiveˉconstant(146866176u32)
    );
    Instructions = Append(Instructions, Descriptorˉpointer(Descriptor));
    Instructions = Append(Instructions, Descriptorˉlength(Descriptor));
    Instructions = Append(Instructions, Memoryˉcopy());
    Instructions = Append(Instructions, Descriptorˉlength(Descriptor));
    Instructions = Append(
        Instructions,
        Indexed(36u32, Outputˉlengthˉglobal)
    );
    Instructions = Append(
        Instructions,
        Descriptorˉstorage.Compilerˉwebassemblyˉdescriptorˉstorageˉreferenceˉlocal(
            Descriptor,
            false,
            Referenceˉfunction
        )
    );
    Instructions = Append(Instructions, Indexed(35u32, 3u32));
    return Encoding.Compilerˉwebassemblyˉbinaryˉfunctionˉbody(
        Localˉdeclarations,
        Instructions
    );
}

fn Emitˉsegmentedˉmemoryˉwrapper(
    Rootˉposition: u32,
    Hasˉrecords: bool,
    Freeˉglobal: u32,
    Frameˉstart: u32,
    Allocateˉfunction: u32,
    Referenceˉfunction: u32,
    Outputˉlengthˉglobal: u32
) -> bytes {
    let Pointer: u32 = 2u32;
    let Descriptor: u32 = 3u32;
    var Localˉdeclarations: bytes = Uleb(2u32);
    Localˉdeclarations = Append(Localˉdeclarations, Uleb(1u32));
    Localˉdeclarations = Append(Localˉdeclarations, Byte(127u32));
    Localˉdeclarations = Append(Localˉdeclarations, Uleb(1u32));
    Localˉdeclarations = Append(Localˉdeclarations, Byte(126u32));

    var Instructions: bytes = Positiveˉconstant(0u32);
    Instructions = Append(Instructions, Indexed(36u32, 0u32));
    Instructions = Append(Instructions, Positiveˉconstant(0u32));
    Instructions = Append(Instructions, Indexed(36u32, 1u32));
    Instructions = Append(Instructions, Indexed(32u32, 0u32));
    Instructions = Append(Instructions, Indexed(36u32, 2u32));
    Instructions = Append(Instructions, Positiveˉconstant(0u32));
    Instructions = Append(Instructions, Indexed(36u32, 3u32));
    Instructions = Append(Instructions, Positiveˉconstant(0u32));
    Instructions = Append(
        Instructions,
        Indexed(36u32, Outputˉlengthˉglobal)
    );
    Instructions = Append(
        Instructions,
        Descriptorˉstorage.Compilerˉwebassemblyˉdescriptorˉstorageˉinitialize(
            Freeˉglobal
        )
    );
    if Hasˉrecords {
        Instructions = Append(Instructions, Positiveˉconstant(Frameˉstart));
        Instructions = Append(Instructions, Indexed(36u32, 4u32));
    }

    Instructions = Append(Instructions, Indexed(32u32, 0u32));
    Instructions = Append(Instructions, Byte(69u32));
    Instructions = Append(Instructions, Byte(4u32));
    Instructions = Append(Instructions, Byte(64u32));
    Instructions = Append(Instructions, Positiveˉconstant(3011u32));
    Instructions = Append(Instructions, Indexed(36u32, 3u32));
    Instructions = Append(Instructions, Indexed(35u32, 3u32));
    Instructions = Append(Instructions, Byte(15u32));
    Instructions = Append(Instructions, Byte(11u32));

    Instructions = Append(Instructions, Indexed(32u32, 1u32));
    Instructions = Append(Instructions, Positiveˉconstant(4194304u32));
    Instructions = Append(Instructions, Byte(75u32));
    Instructions = Append(Instructions, Byte(4u32));
    Instructions = Append(Instructions, Byte(64u32));
    Instructions = Append(Instructions, Positiveˉconstant(3008u32));
    Instructions = Append(Instructions, Indexed(36u32, 3u32));
    Instructions = Append(Instructions, Indexed(35u32, 3u32));
    Instructions = Append(Instructions, Byte(15u32));
    Instructions = Append(Instructions, Byte(11u32));

    Instructions = Append(Instructions, Indexed(32u32, 1u32));
    Instructions = Append(Instructions, Byte(4u32));
    Instructions = Append(Instructions, Byte(64u32));
    Instructions = Append(Instructions, Indexed(32u32, 1u32));
    Instructions = Append(
        Instructions,
        Indexed(16u32, Allocateˉfunction)
    );
    Instructions = Append(Instructions, Indexed(34u32, Pointer));
    Instructions = Append(Instructions, Byte(69u32));
    Instructions = Append(Instructions, Byte(4u32));
    Instructions = Append(Instructions, Byte(64u32));
    Instructions = Append(Instructions, Positiveˉconstant(3018u32));
    Instructions = Append(Instructions, Indexed(36u32, 3u32));
    Instructions = Append(Instructions, Indexed(35u32, 3u32));
    Instructions = Append(Instructions, Byte(15u32));
    Instructions = Append(Instructions, Byte(11u32));
    Instructions = Append(Instructions, Indexed(32u32, Pointer));
    Instructions = Append(Instructions, Positiveˉconstant(142671872u32));
    Instructions = Append(Instructions, Indexed(32u32, 1u32));
    Instructions = Append(Instructions, Memoryˉcopy());
    Instructions = Append(
        Instructions,
        Packˉdescriptor(Pointer, 1u32)
    );
    Instructions = Append(Instructions, Indexed(33u32, Descriptor));
    Instructions = Append(Instructions, Byte(11u32));

    Instructions = Append(Instructions, Indexed(32u32, Descriptor));
    Instructions = Append(Instructions, Positiveˉconstant(146866176u32));
    Instructions = Append(Instructions, Indexed(16u32, Rootˉposition));
    Instructions = Append(Instructions, Indexed(33u32, Pointer));
    if Hasˉrecords {
        Instructions = Append(Instructions, Positiveˉconstant(Frameˉstart));
        Instructions = Append(Instructions, Indexed(36u32, 4u32));
    }
    Instructions = Append(
        Instructions,
        Descriptorˉstorage.Compilerˉwebassemblyˉdescriptorˉstorageˉreferenceˉlocal(
            Descriptor,
            false,
            Referenceˉfunction
        )
    );
    Instructions = Append(Instructions, Indexed(35u32, 3u32));
    Instructions = Append(Instructions, Byte(4u32));
    Instructions = Append(Instructions, Byte(64u32));
    Instructions = Append(Instructions, Indexed(35u32, 3u32));
    Instructions = Append(Instructions, Byte(15u32));
    Instructions = Append(Instructions, Byte(11u32));

    Instructions = Append(Instructions, Indexed(32u32, Pointer));
    Instructions = Append(Instructions, Positiveˉconstant(146866176u32));
    Instructions = Append(Instructions, Byte(71u32));
    Instructions = Append(Instructions, Byte(4u32));
    Instructions = Append(Instructions, Byte(64u32));
    Instructions = Append(Instructions, Positiveˉconstant(3007u32));
    Instructions = Append(Instructions, Indexed(36u32, 3u32));
    Instructions = Append(Instructions, Indexed(35u32, 3u32));
    Instructions = Append(Instructions, Byte(15u32));
    Instructions = Append(Instructions, Byte(11u32));

    Instructions = Append(Instructions, Positiveˉconstant(288u32));
    Instructions = Append(
        Instructions,
        Indexed(36u32, Outputˉlengthˉglobal)
    );
    Instructions = Append(Instructions, Indexed(35u32, 3u32));
    return Encoding.Compilerˉwebassemblyˉbinaryˉfunctionˉbody(
        Localˉdeclarations,
        Instructions
    );
}

fn Memoryˉabiˉsection() -> bytes {
    var Payload: bytes = Uleb(1u32);
    Payload = Append(Payload, Byte(1u32));
    Payload = Append(Payload, Uleb(2497u32));
    Payload = Append(Payload, Uleb(2497u32));
    return Encoding.Compilerˉwebassemblyˉbinaryˉsection(5u32, Payload);
}

fn Emitˉmode(
    Input: bytes,
    Codeˉoffset: u32,
    Codeˉlength: u32,
    Directory: Functions.Compilerˉwebassemblyˉfunctionˉdirectoryˉsummary,
    Types: Typeˉdirectory.Compilerˉwebassemblyˉtypeˉdirectoryˉsummary,
    Graph: Graphs.Compilerˉwebassemblyˉexecutableˉgraphˉsummary,
    Control: Controls.Compilerˉwebassemblyˉcontrolˉflowˉsummary,
    Enumˉsummary: Enums.Compilerˉwebassemblyˉenumˉsummary,
    Storage: Recordˉstorage.Compilerˉwebassemblyˉrecordˉstorageˉsummary,
    Maximumˉbytes: u32,
    Segmented: bool
) -> Compilerˉwebassemblyˉscalarˉdispatcherˉsummary {
    let Runtimeˉdata:
        Staticˉdata.Compilerˉwebassemblyˉstaticˉdataˉsummary =
        Enums.Compilerˉwebassemblyˉenumˉdata(Enumˉsummary);
    let Descriptorˉsummary:
        Descriptorˉstorage.Compilerˉwebassemblyˉdescriptorˉstorageˉsummary =
        Descriptorˉstorage.Compilerˉwebassemblyˉdescriptorˉstorageˉbuild(
            Input,
            Codeˉoffset,
            Codeˉlength,
            Directory,
            Graph
        );
    if !Directory.Valid || !Types.Valid || !Graph.Valid || !Control.Valid ||
        !Enumˉsummary.Valid || !Runtimeˉdata.Valid || !Storage.Valid ||
        !Descriptorˉsummary.Valid ||
        Directory.Count != Graph.Functionˉcount ||
        Control.Reachableˉfunctionˉcount != Graph.Reachableˉcount ||
        Bytesˉlength(Graph.Reachableˉorder) != Graph.Reachableˉcount * 4u32 ||
        Graph.Reachableˉcount == 0u32 || Graph.Reachableˉcount > 512u32 {
        return Invalid(Input, 0u32, 0u32, 0u32);
    }
    if Codeˉoffset > Bytesˉlength(Input) ||
        Codeˉlength > Bytesˉlength(Input) - Codeˉoffset {
        return Invalid(Input, 0u32, 0u32, 0u32);
    }
    let Rootˉposition: Positionˉlookup = Reachableˉposition(
        Graph.Reachableˉorder,
        Graph.Root
    );
    if !Rootˉposition.Found {
        return Invalid(Input, Graph.Root, 0u32, 0u32);
    }
    let Rootˉparameterˉcount: u32 =
        Functions.Compilerˉwebassemblyˉfunctionˉparameterˉcount(
            Directory,
            Graph.Root
        );
    let Rootˉresultˉoffset: u32 =
        Functions.Compilerˉwebassemblyˉfunctionˉresultˉtypeˉoffset(
            Directory,
            Graph.Root
        );
    let Rootˉresult: u32 = Shapeˉkind(Input, Rootˉresultˉoffset);
    var Memoryˉroot: bool = false;
    var Segmentedˉmemoryˉroot: bool = false;
    if Rootˉparameterˉcount == 1u32 {
        let Rootˉparameter: u32 = Shapeˉkind(
            Input,
            Functions.Compilerˉwebassemblyˉfunctionˉparameterˉtypesˉoffset(
                Directory,
                Graph.Root
            )
        );
        if Rootˉparameter == 6u32 {
            if Rootˉresult == 6u32 { Memoryˉroot = true; }
            if Segmentedˉrootˉisˉvalid(Input, Types, Rootˉresultˉoffset) {
                Segmentedˉmemoryˉroot = true;
            }
        }
    }
    let Abiˉroot: bool = Memoryˉroot || Segmentedˉmemoryˉroot;
    if !Abiˉroot && (
        Rootˉparameterˉcount != 0u32 ||
        !Shapeˉisˉscalar(Rootˉresult) ||
        Rootˉresult == 7u32
    ) {
        return Invalid(Input, Graph.Root, 0u32, 0u32);
    }

    var Hasˉdynamic: bool =
        Descriptorˉstorage.Compilerˉwebassemblyˉdescriptorˉstorageˉisˉdynamic(
            Descriptorˉsummary
        );
    if Abiˉroot { Hasˉdynamic = true; }
    let Hasˉutf8: bool =
        Descriptorˉstorage.Compilerˉwebassemblyˉdescriptorˉstorageˉrequiresˉutf8(
            Descriptorˉsummary
        );
    let Hasˉrecords: bool = Storage.Maximumˉframeˉbytes != 0u32;
    let Allocateˉfunction: u32 = Graph.Reachableˉcount;
    let Referenceˉfunction: u32 = Graph.Reachableˉcount + 1u32;
    var Utf8ˉfunction: u32 = Graph.Reachableˉcount;
    if Hasˉdynamic { Utf8ˉfunction = Utf8ˉfunction + 2u32; }
    var Meterˉfunction: u32 = Utf8ˉfunction;
    if Hasˉutf8 { Meterˉfunction = Meterˉfunction + 1u32; }
    var Frameˉstart: u32 = 65536u32;
    var Frameˉlimit: u32 = 8454144u32;
    if Hasˉdynamic {
        Frameˉstart =
            Descriptorˉstorage.Compilerˉwebassemblyˉdescriptorˉstorageˉheapˉend();
        Frameˉlimit =
            Descriptorˉstorage.Compilerˉwebassemblyˉdescriptorˉstorageˉframeˉend();
    }
    let Runtime: Runtimeˉhelpers = Runtimeˉhelpers(
        Hasˉdynamic,
        Hasˉutf8,
        Allocateˉfunction,
        Referenceˉfunction,
        Utf8ˉfunction,
        Meterˉfunction,
        Maximumˉbytes,
        Frameˉlimit
    );
    var Typeˉentries: bytes = Empty(Input);
    var Functionˉentries: bytes = Empty(Input);
    var Codeˉentries: bytes = Empty(Input);
    let Emptyˉcodeˉblock:
        Artifactˉsegments.Compilerˉwebassemblyˉartifactˉsegmentˉblock =
        Artifactˉsegments.Compilerˉwebassemblyˉartifactˉsegmentˉblockˉempty(
            Input
        );
    var Codeˉblock0: Artifactˉsegments.Compilerˉwebassemblyˉartifactˉsegmentˉblock =
        Emptyˉcodeˉblock;
    var Codeˉblock1: Artifactˉsegments.Compilerˉwebassemblyˉartifactˉsegmentˉblock =
        Emptyˉcodeˉblock;
    var Codeˉblock2: Artifactˉsegments.Compilerˉwebassemblyˉartifactˉsegmentˉblock =
        Emptyˉcodeˉblock;
    var Codeˉblock3: Artifactˉsegments.Compilerˉwebassemblyˉartifactˉsegmentˉblock =
        Emptyˉcodeˉblock;
    var Codeˉsegment: u32 = 0u32;
    var Chunkˉstart: u32 = 0u32;
    while Chunkˉstart < Graph.Reachableˉcount {
        var Chunkˉend: u32 = Chunkˉstart + 64u32;
        if Segmented { Chunkˉend = Chunkˉstart + 16u32; }
        if Chunkˉend > Graph.Reachableˉcount {
            Chunkˉend = Graph.Reachableˉcount;
        }
        var Chunk: bytes = Empty(Input);
        if Segmented {
            Chunk = Emitˉfunctionˉchunkˉpacked(
                Input,
                Codeˉoffset,
                Directory,
                Control,
                Graph,
                Types,
                Enumˉsummary,
                Storage,
                Runtime,
                Chunkˉstart,
                Chunkˉend
            );
        } else {
            Chunk = Emitˉfunctionˉgroupˉpacked(
                Input,
                Codeˉoffset,
                Directory,
                Control,
                Graph,
                Types,
                Enumˉsummary,
                Storage,
                Runtime,
                Chunkˉstart,
                Chunkˉend
            );
        }
        if Bytesˉlength(Chunk) < 24u32 ||
            Bytesˉreadˉu32ˉlittle(Chunk, 0u32) != 1u32 {
            var Failureˉfunction: u32 = Graph.Root;
            var Failureˉoffset: u32 = 0u32;
            var Failureˉopcode: u32 = 0u32;
            if Bytesˉlength(Chunk) >= 16u32 {
                Failureˉfunction = Bytesˉreadˉu32ˉlittle(Chunk, 4u32);
                Failureˉoffset = Bytesˉreadˉu32ˉlittle(Chunk, 8u32);
                Failureˉopcode = Bytesˉreadˉu32ˉlittle(Chunk, 12u32);
            }
            return Invalid(
                Input,
                Failureˉfunction,
                Failureˉoffset,
                Failureˉopcode
            );
        }
        let Typeˉlength: u32 = Bytesˉreadˉu32ˉlittle(Chunk, 16u32);
        let Functionˉlength: u32 = Bytesˉreadˉu32ˉlittle(Chunk, 20u32);
        if Typeˉlength > Bytesˉlength(Chunk) - 24u32 ||
            Functionˉlength > Bytesˉlength(Chunk) - 24u32 - Typeˉlength {
            return Invalid(Input, Graph.Root, 0u32, 0u32);
        }
        let Functionˉoffset: u32 = 24u32 + Typeˉlength;
        let Codeˉentryˉoffset: u32 = Functionˉoffset + Functionˉlength;
        Typeˉentries = Append(
            Typeˉentries,
            Bytesˉslice(Chunk, 24u32, Typeˉlength)
        );
        Functionˉentries = Append(
            Functionˉentries,
            Bytesˉslice(Chunk, Functionˉoffset, Functionˉlength)
        );
        let Codeˉpart: bytes = Bytesˉslice(
            Chunk,
            Codeˉentryˉoffset,
            Bytesˉlength(Chunk) - Codeˉentryˉoffset
        );
        if Segmented {
            let Codeˉpartˉlength: u32 = Bytesˉlength(Codeˉpart);
            if Codeˉpartˉlength > 4194304u32 {
                return Invalid(Input, Graph.Root, 0u32, 0u32);
            }
            let Existingˉlength: u32 = Codeˉsegmentˉlength(
                Codeˉblock0,
                Codeˉblock1,
                Codeˉblock2,
                Codeˉblock3,
                Codeˉsegment
            );
            if Existingˉlength > 4194304u32 - Codeˉpartˉlength {
                Codeˉsegment = Codeˉsegment + 1u32;
            }
            if Codeˉsegment >= 32u32 {
                return Invalid(Input, Graph.Root, 0u32, 0u32);
            }
            let Codeˉblock: u32 = Codeˉsegment / 10u32;
            let Blockˉsegment: u32 = Codeˉsegment % 10u32;
            if Codeˉblock == 0u32 {
                Codeˉblock0 = Artifactˉsegments.Compilerˉwebassemblyˉartifactˉsegmentˉblockˉappend(
                    Codeˉblock0,
                    Blockˉsegment,
                    Codeˉpart
                );
            } else if Codeˉblock == 1u32 {
                Codeˉblock1 = Artifactˉsegments.Compilerˉwebassemblyˉartifactˉsegmentˉblockˉappend(
                    Codeˉblock1,
                    Blockˉsegment,
                    Codeˉpart
                );
            } else if Codeˉblock == 2u32 {
                Codeˉblock2 = Artifactˉsegments.Compilerˉwebassemblyˉartifactˉsegmentˉblockˉappend(
                    Codeˉblock2,
                    Blockˉsegment,
                    Codeˉpart
                );
            } else if Codeˉblock == 3u32 {
                Codeˉblock3 = Artifactˉsegments.Compilerˉwebassemblyˉartifactˉsegmentˉblockˉappend(
                    Codeˉblock3,
                    Blockˉsegment,
                    Codeˉpart
                );
            }
        } else {
            Codeˉentries = Append(Codeˉentries, Codeˉpart);
        }
        Chunkˉstart = Chunkˉend;
    }

    var Lastˉcodeˉsegment: u32 = Codeˉsegment;
    var Helperˉentries: bytes = Empty(Input);
    var Nextˉhelper: u32 = Graph.Reachableˉcount;
    var Freeˉglobal: u32 = 4u32;
    if Hasˉrecords { Freeˉglobal = 5u32; }
    var Runtimeˉglobalˉcount: u32 = 4u32;
    if Hasˉrecords {
        Runtimeˉglobalˉcount = Runtimeˉglobalˉcount + 1u32;
    }
    if Hasˉdynamic {
        Runtimeˉglobalˉcount = Runtimeˉglobalˉcount + 1u32;
    }
    let Abiˉglobal: u32 = Runtimeˉglobalˉcount;
    let Outputˉlengthˉglobal: u32 = Abiˉglobal + 5u32;
    if Hasˉdynamic {
        Typeˉentries = Append(
            Typeˉentries,
            Descriptorˉstorage.Compilerˉwebassemblyˉdescriptorˉstorageˉallocateˉtype()
        );
        Typeˉentries = Append(
            Typeˉentries,
            Descriptorˉstorage.Compilerˉwebassemblyˉdescriptorˉstorageˉreferenceˉtype()
        );
        Functionˉentries = Append(
            Functionˉentries,
            Uleb(Graph.Reachableˉcount)
        );
        Functionˉentries = Append(
            Functionˉentries,
            Uleb(Graph.Reachableˉcount + 1u32)
        );
        let Allocateˉbody: bytes =
            Descriptorˉstorage.Compilerˉwebassemblyˉdescriptorˉstorageˉallocateˉbody(
                Freeˉglobal
            );
        let Referenceˉbody: bytes =
            Descriptorˉstorage.Compilerˉwebassemblyˉdescriptorˉstorageˉreferenceˉbody(
                Freeˉglobal
            );
        if Segmented {
            Helperˉentries = Append(Helperˉentries, Allocateˉbody);
            Helperˉentries = Append(Helperˉentries, Referenceˉbody);
        } else {
            Codeˉentries = Append(Codeˉentries, Allocateˉbody);
            Codeˉentries = Append(Codeˉentries, Referenceˉbody);
        }
        Nextˉhelper = Nextˉhelper + 2u32;
    }
    if Hasˉutf8 {
        Typeˉentries = Append(
            Typeˉentries,
            Utf8.Compilerˉwebassemblyˉutf8ˉvalidatorˉtype()
        );
        Functionˉentries = Append(Functionˉentries, Uleb(Nextˉhelper));
        let Utf8ˉbody: bytes =
            Utf8.Compilerˉwebassemblyˉutf8ˉvalidatorˉbody();
        if Segmented {
            Helperˉentries = Append(Helperˉentries, Utf8ˉbody);
        } else {
            Codeˉentries = Append(Codeˉentries, Utf8ˉbody);
        }
        Nextˉhelper = Nextˉhelper + 1u32;
    }
    if Nextˉhelper != Meterˉfunction {
        return Invalid(Input, Graph.Root, 0u32, 0u32);
    }
    Typeˉentries = Append(Typeˉentries, Emitˉmeterˉtype());
    Functionˉentries = Append(Functionˉentries, Uleb(Nextˉhelper));
    let Meterˉbody: bytes = Emitˉmeterˉbody();
    if Segmented {
        Helperˉentries = Append(Helperˉentries, Meterˉbody);
    } else {
        Codeˉentries = Append(Codeˉentries, Meterˉbody);
    }
    Nextˉhelper = Nextˉhelper + 1u32;
    let Wrapperˉtypeˉindex: u32 = Nextˉhelper;
    let Wrapperˉposition: u32 = Nextˉhelper;
    let Emittedˉfunctionˉcount: u32 = Nextˉhelper + 1u32;

    var Wrapperˉtype: bytes = Byte(96u32);
    var Wrapperˉparameterˉcount: u32 = 1u32;
    if Abiˉroot { Wrapperˉparameterˉcount = 2u32; }
    Wrapperˉtype = Append(
        Wrapperˉtype,
        Uleb(Wrapperˉparameterˉcount)
    );
    Wrapperˉtype = Append(Wrapperˉtype, Byte(127u32));
    if Abiˉroot {
        Wrapperˉtype = Append(Wrapperˉtype, Byte(127u32));
    }
    Wrapperˉtype = Append(Wrapperˉtype, Uleb(1u32));
    Wrapperˉtype = Append(Wrapperˉtype, Byte(127u32));
    Typeˉentries = Append(Typeˉentries, Wrapperˉtype);
    Functionˉentries = Append(
        Functionˉentries,
        Uleb(Wrapperˉtypeˉindex)
    );
    var Wrapperˉbody: bytes = Empty(Input);
    if Segmentedˉmemoryˉroot {
        Wrapperˉbody = Emitˉsegmentedˉmemoryˉwrapper(
                Rootˉposition.Position,
                Hasˉrecords,
                Freeˉglobal,
                Frameˉstart,
                Allocateˉfunction,
                Referenceˉfunction,
                Outputˉlengthˉglobal
            );
    } else if Memoryˉroot {
        Wrapperˉbody = Emitˉmemoryˉwrapper(
                Rootˉposition.Position,
                Hasˉrecords,
                Freeˉglobal,
                Frameˉstart,
                Allocateˉfunction,
                Referenceˉfunction,
                Outputˉlengthˉglobal
            );
    } else {
        Wrapperˉbody = Emitˉwrapper(
                Rootˉposition.Position,
                Hasˉrecords,
                Hasˉdynamic,
                Freeˉglobal,
                Frameˉstart
            );
    }
    if Segmented {
        Helperˉentries = Append(Helperˉentries, Wrapperˉbody);
        let Helperˉlength: u32 = Bytesˉlength(Helperˉentries);
        if Helperˉlength > 4194304u32 {
            return Invalid(Input, Graph.Root, 0u32, 0u32);
        }
        let Lastˉlength: u32 = Codeˉsegmentˉlength(
            Codeˉblock0,
            Codeˉblock1,
            Codeˉblock2,
            Codeˉblock3,
            Lastˉcodeˉsegment
        );
        if Lastˉlength > 4194304u32 - Helperˉlength {
            Lastˉcodeˉsegment = Lastˉcodeˉsegment + 1u32;
        }
        if Lastˉcodeˉsegment >= 32u32 {
            return Invalid(Input, Graph.Root, 0u32, 0u32);
        }
        let Lastˉblock: u32 = Lastˉcodeˉsegment / 10u32;
        let Lastˉsegment: u32 = Lastˉcodeˉsegment % 10u32;
        if Lastˉblock == 0u32 {
            Codeˉblock0 = Artifactˉsegments.Compilerˉwebassemblyˉartifactˉsegmentˉblockˉappend(
                Codeˉblock0,
                Lastˉsegment,
                Helperˉentries
            );
        } else if Lastˉblock == 1u32 {
            Codeˉblock1 = Artifactˉsegments.Compilerˉwebassemblyˉartifactˉsegmentˉblockˉappend(
                Codeˉblock1,
                Lastˉsegment,
                Helperˉentries
            );
        } else if Lastˉblock == 2u32 {
            Codeˉblock2 = Artifactˉsegments.Compilerˉwebassemblyˉartifactˉsegmentˉblockˉappend(
                Codeˉblock2,
                Lastˉsegment,
                Helperˉentries
            );
        } else {
            Codeˉblock3 = Artifactˉsegments.Compilerˉwebassemblyˉartifactˉsegmentˉblockˉappend(
                Codeˉblock3,
                Lastˉsegment,
                Helperˉentries
            );
        }
    } else {
        Codeˉentries = Append(Codeˉentries, Wrapperˉbody);
    }

    var Typeˉpayload: bytes = Uleb(Emittedˉfunctionˉcount);
    Typeˉpayload = Append(Typeˉpayload, Typeˉentries);
    var Functionˉpayload: bytes = Uleb(Emittedˉfunctionˉcount);
    Functionˉpayload = Append(Functionˉpayload, Functionˉentries);
    var Globalˉcount: u32 = Runtimeˉglobalˉcount;
    if Abiˉroot { Globalˉcount = Globalˉcount + 7u32; }
    var Globalˉpayload: bytes = Uleb(Globalˉcount);
    Globalˉpayload = Append(Globalˉpayload, Globalˉi32(true, 0u32));
    Globalˉpayload = Append(Globalˉpayload, Globalˉi32(true, 0u32));
    Globalˉpayload = Append(Globalˉpayload, Globalˉi32(true, 0u32));
    Globalˉpayload = Append(Globalˉpayload, Globalˉi32(true, 0u32));
    if Hasˉrecords {
        Globalˉpayload = Append(
            Globalˉpayload,
            Globalˉi32(true, Frameˉstart)
        );
    }
    if Hasˉdynamic {
        Globalˉpayload = Append(
            Globalˉpayload,
            Globalˉi32(true, 65536u32)
        );
    }
    if Abiˉroot {
        Globalˉpayload = Append(Globalˉpayload, Globalˉi32(false, 4u32));
        Globalˉpayload = Append(
            Globalˉpayload,
            Globalˉi32(false, 142671872u32)
        );
        Globalˉpayload = Append(
            Globalˉpayload,
            Globalˉi32(false, 4194304u32)
        );
        Globalˉpayload = Append(
            Globalˉpayload,
            Globalˉi32(false, 146866176u32)
        );
        Globalˉpayload = Append(
            Globalˉpayload,
            Globalˉi32(false, 16777216u32)
        );
        Globalˉpayload = Append(Globalˉpayload, Globalˉi32(true, 0u32));
        var Outputˉkind: u32 = 1u32;
        if Segmentedˉmemoryˉroot { Outputˉkind = 3u32; }
        Globalˉpayload = Append(
            Globalˉpayload,
            Globalˉi32(false, Outputˉkind)
        );
    }
    var Exportˉpayload: bytes = Uleb(3u32);
    if Abiˉroot {
        Exportˉpayload = Uleb(10u32);
        Exportˉpayload = Append(
            Exportˉpayload,
            Exportˉentry("Windvale.run", 0u32, Wrapperˉposition)
        );
        Exportˉpayload = Append(
            Exportˉpayload,
            Exportˉentry("Windvale.abi", 3u32, Abiˉglobal)
        );
        Exportˉpayload = Append(
            Exportˉpayload,
            Exportˉentry("Windvale.memory", 2u32, 0u32)
        );
        Exportˉpayload = Append(
            Exportˉpayload,
            Exportˉentry("Windvale.input_offset", 3u32, Abiˉglobal + 1u32)
        );
        Exportˉpayload = Append(
            Exportˉpayload,
            Exportˉentry("Windvale.input_capacity", 3u32, Abiˉglobal + 2u32)
        );
        Exportˉpayload = Append(
            Exportˉpayload,
            Exportˉentry("Windvale.output_offset", 3u32, Abiˉglobal + 3u32)
        );
        Exportˉpayload = Append(
            Exportˉpayload,
            Exportˉentry("Windvale.output_capacity", 3u32, Abiˉglobal + 4u32)
        );
        Exportˉpayload = Append(
            Exportˉpayload,
            Exportˉentry("Windvale.output_length", 3u32, Abiˉglobal + 5u32)
        );
        Exportˉpayload = Append(
            Exportˉpayload,
            Exportˉentry("Windvale.output_kind", 3u32, Abiˉglobal + 6u32)
        );
        Exportˉpayload = Append(
            Exportˉpayload,
            Exportˉentry("Windvale.instructions", 3u32, 1u32)
        );
    } else {
        Exportˉpayload = Append(
            Exportˉpayload,
            Exportˉentry(
                "Windvale.run",
                0u32,
                Wrapperˉposition
            )
        );
        Exportˉpayload = Append(
            Exportˉpayload,
            Exportˉentry("Windvale.result", 3u32, 0u32)
        );
        Exportˉpayload = Append(
            Exportˉpayload,
            Exportˉentry("Windvale.instructions", 3u32, 1u32)
        );
    }
    var Codeˉpayload: bytes = Uleb(Emittedˉfunctionˉcount);
    Codeˉpayload = Append(Codeˉpayload, Codeˉentries);
    var Memoryˉsection: bytes =
        Staticˉdata.Compilerˉwebassemblyˉstaticˉdataˉmemoryˉsection(
            Input,
            Runtimeˉdata
        );
    if Hasˉrecords {
        Memoryˉsection =
            Staticˉdata.Compilerˉwebassemblyˉstaticˉdataˉrequiredˉmemoryˉsection(
                Input,
                Runtimeˉdata
            );
    }
    if Hasˉdynamic {
        Memoryˉsection =
            Descriptorˉstorage.Compilerˉwebassemblyˉdescriptorˉstorageˉmemoryˉsection(
                Input,
                Hasˉrecords
            );
    }
    if Abiˉroot { Memoryˉsection = Memoryˉabiˉsection(); }

    let Dataˉsection: bytes =
        Staticˉdata.Compilerˉwebassemblyˉstaticˉdataˉsection(
            Input,
            Runtimeˉdata
        );

    if Segmented {
        let Codeˉentriesˉlength: u32 =
            Artifactˉsegments.Compilerˉwebassemblyˉartifactˉsegmentˉblockˉlength(
                Codeˉblock0
            ) +
            Artifactˉsegments.Compilerˉwebassemblyˉartifactˉsegmentˉblockˉlength(
                Codeˉblock1
            ) +
            Artifactˉsegments.Compilerˉwebassemblyˉartifactˉsegmentˉblockˉlength(
                Codeˉblock2
            ) +
            Artifactˉsegments.Compilerˉwebassemblyˉartifactˉsegmentˉblockˉlength(
                Codeˉblock3
            );
        let Codeˉcount: bytes = Uleb(Emittedˉfunctionˉcount);
        let Codeˉpayloadˉlength: u32 =
            Bytesˉlength(Codeˉcount) + Codeˉentriesˉlength;
        var Prefix: bytes = Encoding.Compilerˉwebassemblyˉbinaryˉheader();
        Prefix = Append(
            Prefix,
            Encoding.Compilerˉwebassemblyˉbinaryˉsection(1u32, Typeˉpayload)
        );
        Prefix = Append(
            Prefix,
            Encoding.Compilerˉwebassemblyˉbinaryˉsection(
                3u32,
                Functionˉpayload
            )
        );
        Prefix = Append(Prefix, Memoryˉsection);
        Prefix = Append(
            Prefix,
            Encoding.Compilerˉwebassemblyˉbinaryˉsection(6u32, Globalˉpayload)
        );
        Prefix = Append(
            Prefix,
            Encoding.Compilerˉwebassemblyˉbinaryˉsection(7u32, Exportˉpayload)
        );
        Prefix = Append(Prefix, Byte(10u32));
        Prefix = Append(Prefix, Uleb(Codeˉpayloadˉlength));
        Prefix = Append(Prefix, Codeˉcount);
        let Totalˉlength: u32 = Bytesˉlength(Prefix) +
            Codeˉentriesˉlength + Bytesˉlength(Dataˉsection);
        if !Artifactˉsegments.Compilerˉwebassemblyˉartifactˉsegmentˉblockˉisˉbounded(
                Codeˉblock0
            ) ||
            !Artifactˉsegments.Compilerˉwebassemblyˉartifactˉsegmentˉblockˉisˉbounded(
                Codeˉblock1
            ) ||
            !Artifactˉsegments.Compilerˉwebassemblyˉartifactˉsegmentˉblockˉisˉbounded(
                Codeˉblock2
            ) ||
            !Artifactˉsegments.Compilerˉwebassemblyˉartifactˉsegmentˉblockˉisˉbounded(
                Codeˉblock3
            ) ||
            Bytesˉlength(Prefix) > 4194304u32 ||
            Bytesˉlength(Dataˉsection) > 4194304u32 ||
            Totalˉlength > 67108864u32 {
            return Invalid(Input, 0u32, 0u32, 0u32);
        }
        return Compilerˉwebassemblyˉscalarˉdispatcherˉsummary(
            true,
            Totalˉlength,
            Prefix,
            Codeˉblock0.Segment0,
            Codeˉblock0.Segment1,
            Codeˉblock0.Segment2,
            Codeˉblock0.Segment3,
            Codeˉblock0.Segment4,
            Codeˉblock0.Segment5,
            Codeˉblock0.Segment6,
            Codeˉblock0.Segment7,
            Codeˉblock0.Segment8,
            Codeˉblock0.Segment9,
            Codeˉblock1.Segment0,
            Codeˉblock1.Segment1,
            Codeˉblock1.Segment2,
            Codeˉblock1.Segment3,
            Codeˉblock1.Segment4,
            Codeˉblock1.Segment5,
            Codeˉblock1.Segment6,
            Codeˉblock1.Segment7,
            Codeˉblock1.Segment8,
            Codeˉblock1.Segment9,
            Codeˉblock2.Segment0,
            Codeˉblock2.Segment1,
            Codeˉblock2.Segment2,
            Codeˉblock2.Segment3,
            Codeˉblock2.Segment4,
            Codeˉblock2.Segment5,
            Codeˉblock2.Segment6,
            Codeˉblock2.Segment7,
            Codeˉblock2.Segment8,
            Codeˉblock2.Segment9,
            Codeˉblock3.Segment0,
            Codeˉblock3.Segment1,
            Dataˉsection
        );
    }

    var Webassembly: bytes = Encoding.Compilerˉwebassemblyˉbinaryˉheader();
    Webassembly = Append(
        Webassembly,
        Encoding.Compilerˉwebassemblyˉbinaryˉsection(1u32, Typeˉpayload)
    );
    Webassembly = Append(
        Webassembly,
        Encoding.Compilerˉwebassemblyˉbinaryˉsection(
            3u32,
            Functionˉpayload
        )
    );
    Webassembly = Append(
        Webassembly,
        Memoryˉsection
    );
    Webassembly = Append(
        Webassembly,
        Encoding.Compilerˉwebassemblyˉbinaryˉsection(6u32, Globalˉpayload)
    );
    Webassembly = Append(
        Webassembly,
        Encoding.Compilerˉwebassemblyˉbinaryˉsection(7u32, Exportˉpayload)
    );
    Webassembly = Append(
        Webassembly,
        Encoding.Compilerˉwebassemblyˉbinaryˉsection(10u32, Codeˉpayload)
    );
    Webassembly = Append(
        Webassembly,
        Dataˉsection
    );
    if Bytesˉlength(Webassembly) > 16777216u32 {
        return Invalid(Input, 0u32, 0u32, 0u32);
    }
    return Compilerˉwebassemblyˉscalarˉdispatcherˉsummary(
        true,
        Bytesˉlength(Webassembly),
        Webassembly,
        Empty(Input),
        Empty(Input),
        Empty(Input),
        Empty(Input),
        Empty(Input),
        Empty(Input),
        Empty(Input),
        Empty(Input),
        Empty(Input),
        Empty(Input),
        Empty(Input),
        Empty(Input),
        Empty(Input),
        Empty(Input),
        Empty(Input),
        Empty(Input),
        Empty(Input),
        Empty(Input),
        Empty(Input),
        Empty(Input),
        Empty(Input),
        Empty(Input),
        Empty(Input),
        Empty(Input),
        Empty(Input),
        Empty(Input),
        Empty(Input),
        Empty(Input),
        Empty(Input),
        Empty(Input),
        Empty(Input),
        Empty(Input),
        Empty(Input)
    );
}

export fn Compilerˉwebassemblyˉscalarˉdispatcherˉemit(
    Input: bytes,
    Codeˉoffset: u32,
    Codeˉlength: u32,
    Directory: Functions.Compilerˉwebassemblyˉfunctionˉdirectoryˉsummary,
    Types: Typeˉdirectory.Compilerˉwebassemblyˉtypeˉdirectoryˉsummary,
    Graph: Graphs.Compilerˉwebassemblyˉexecutableˉgraphˉsummary,
    Control: Controls.Compilerˉwebassemblyˉcontrolˉflowˉsummary,
    Enumˉsummary: Enums.Compilerˉwebassemblyˉenumˉsummary,
    Storage: Recordˉstorage.Compilerˉwebassemblyˉrecordˉstorageˉsummary
) -> Compilerˉwebassemblyˉscalarˉdispatcherˉsummary {
    return Emitˉmode(
        Input,
        Codeˉoffset,
        Codeˉlength,
        Directory,
        Types,
        Graph,
        Control,
        Enumˉsummary,
        Storage,
        4194304u32,
        false
    );
}

