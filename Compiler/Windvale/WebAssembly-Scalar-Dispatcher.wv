import Compilerˉwebassemblyˉdynamicˉdescriptors as Dynamicˉdescriptors;
import Compilerˉwebassemblyˉutf8 as Utf8;
import Compilerˉwebassemblyˉtypeˉdirectory as Typeˉdirectory;
import Compilerˉwebassemblyˉenumˉoperations as Enums;
