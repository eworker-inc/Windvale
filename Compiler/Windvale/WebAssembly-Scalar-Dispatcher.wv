module Compilerˉwebassemblyˉscalarˉdispatcher profile portable;

import Compilerˉwebassemblyˉbinaryˉencoding as Encoding;
import Compilerˉwebassemblyˉfunctionˉdirectory as Functions;
import Compilerˉwebassemblyˉexecutableˉgraph as Graphs;
import Compilerˉwebassemblyˉcontrolˉflow as Controls;
import Compilerˉwebassemblyˉscalarˉoperations as Scalars;
import Compilerˉwebassemblyˉvalueˉlayout as Layouts;
import Compilerˉwebassemblyˉstaticˉdata as Staticˉdata;
import Compilerˉwebassemblyˉdescriptorˉoperations as Descriptors;

export record Compilerˉwebassemblyˉscalarˉdispatcherˉsummary {
    Valid: bool;
    Webassembly: bytes;
    Functionˉcount: u32;
    Blockˉcount: u32;
    Failureˉfunction: u32;
    Failureˉoffset: u32;
    Failureˉopcode: u32;
}

record Positionˉlookup {
    Found: bool;
    Position: u32;
}

record Emission {
    Valid: bool;
    Bytes: bytes;
    Failureˉoffset: u32;
    Failureˉopcode: u32;
}

fn Empty(Input: bytes) -> bytes {
    return Bytesˉslice(Input, 0u32, 0u32);
}

fn Invalid(
    Input: bytes,
    Function: u32,
    Offset: u32,
    Opcode: u32
) -> Compilerˉwebassemblyˉscalarˉdispatcherˉsummary {
    return Compilerˉwebassemblyˉscalarˉdispatcherˉsummary(
        false,
        Empty(Input),
        0u32,
        0u32,
        Function,
        Offset,
        Opcode
    );
}

fn Invalidˉemission(Input: bytes, Offset: u32, Opcode: u32) -> Emission {
    return Emission(false, Empty(Input), Offset, Opcode);
}

fn Append(First: bytes, Second: bytes) -> bytes {
    return Bytesˉconcat(First, Second);
}

fn Byte(Value: u32) -> bytes {
    return Encoding.Compilerˉwebassemblyˉbinaryˉbyte(Value);
}

fn Uleb(Value: u32) -> bytes {
    return Encoding.Compilerˉwebassemblyˉbinaryˉuleb32(Value);
}

fn Indexed(Opcode: u32, Index: u32) -> bytes {
    return Encoding.Compilerˉwebassemblyˉbinaryˉindexedˉinstruction(
        Opcode,
        Index
    );
}

fn Positiveˉconstant(Value: u32) -> bytes {
    return Encoding.Compilerˉwebassemblyˉbinaryˉpositiveˉi32ˉconstant(
        Value
    );
}

fn I32ˉminimumˉconstant() -> bytes {
    var Result: bytes = Byte(65u32);
    Result = Append(Result, Byte(128u32));
    Result = Append(Result, Byte(128u32));
    Result = Append(Result, Byte(128u32));
    Result = Append(Result, Byte(128u32));
    return Append(Result, Byte(120u32));
}

fn Globalˉi32(Mutable: bool, Initial: u32) -> bytes {
    var Result: bytes = Byte(127u32);
    if Mutable {
        Result = Append(Result, Byte(1u32));
    } else {
        Result = Append(Result, Byte(0u32));
    }
    Result = Append(Result, Positiveˉconstant(Initial));
    return Append(Result, Byte(11u32));
}

fn Exportˉentry(Name: text, Kind: u32, Index: u32) -> bytes {
    var Result: bytes = Encoding.Compilerˉwebassemblyˉbinaryˉname(
        Textˉtoˉutf8(Name)
    );
    Result = Append(Result, Byte(Kind));
    return Append(Result, Uleb(Index));
}

fn Shapeˉkind(Input: bytes, Offset: u32) -> u32 {
    return U32ˉfromˉu8(Bytesˉreadˉu8(Input, Offset));
}

fn Shapeˉwidth(Input: bytes, Offset: u32) -> u32 {
    let Kind: u32 = Shapeˉkind(Input, Offset);
    if Kind == 7u32 || Kind == 8u32 || Kind == 11u32 { return 5u32; }
    if Kind == 12u32 || Kind == 13u32 {
        let Element: u32 = Shapeˉkind(Input, Offset + 1u32);
        if Element == 7u32 || Element == 8u32 || Element == 11u32 {
            return 10u32;
        }
        return 6u32;
    }
    return 1u32;
}

fn Shapeˉisˉscalar(Kind: u32) -> bool {
    if Kind == 1u32 { return true; }
    if Kind == 2u32 { return true; }
    if Kind == 4u32 { return true; }
    if Kind == 5u32 { return true; }
    if Kind == 8u32 { return true; }
    return false;
}

fn Reachableˉposition(Order: bytes, Function: u32) -> Positionˉlookup {
    let Length: u32 = Bytesˉlength(Order);
    if Length % 4u32 != 0u32 {
        return Positionˉlookup(false, 0u32);
    }
    var Offset: u32 = 0u32;
    while Offset < Length {
        if Bytesˉreadˉu32ˉlittle(Order, Offset) == Function {
            return Positionˉlookup(true, Offset / 4u32);
        }
        Offset = Offset + 4u32;
    }
    return Positionˉlookup(false, 0u32);
}

fn Validateˉscalarˉsignature(
    Input: bytes,
    Directory: Functions.Compilerˉwebassemblyˉfunctionˉdirectoryˉsummary,
    Function: u32
) -> bool {
    let Parameterˉcount: u32 =
        Functions.Compilerˉwebassemblyˉfunctionˉparameterˉcount(
            Directory,
            Function
        );
    var Parameterˉcursor: u32 =
        Functions.Compilerˉwebassemblyˉfunctionˉparameterˉtypesˉoffset(
            Directory,
            Function
        );
    var Parameter: u32 = 0u32;
    while Parameter < Parameterˉcount {
        let Kind: u32 = Shapeˉkind(Input, Parameterˉcursor);
        if !Shapeˉisˉscalar(Kind) { return false; }
        Parameterˉcursor = Parameterˉcursor +
            Shapeˉwidth(Input, Parameterˉcursor);
        Parameter = Parameter + 1u32;
    }
    let Resultˉkind: u32 = Shapeˉkind(
        Input,
        Functions.Compilerˉwebassemblyˉfunctionˉresultˉtypeˉoffset(
            Directory,
            Function
        )
    );
    if Resultˉkind != 0u32 && !Shapeˉisˉscalar(Resultˉkind) {
        return false;
    }
    let Localˉcount: u32 =
        Functions.Compilerˉwebassemblyˉfunctionˉlocalˉcount(
            Directory,
            Function
        );
    var Localˉcursor: u32 =
        Functions.Compilerˉwebassemblyˉfunctionˉlocalˉtypesˉoffset(
            Directory,
            Function
        );
    var Local: u32 = 0u32;
    while Local < Localˉcount {
        let Localˉkind: u32 = Shapeˉkind(Input, Localˉcursor);
        if !Shapeˉisˉscalar(Localˉkind) { return false; }
        Localˉcursor = Localˉcursor + Shapeˉwidth(Input, Localˉcursor);
        Local = Local + 1u32;
    }
    return true;
}

fn Emitˉtype(
    Input: bytes,
    Directory: Functions.Compilerˉwebassemblyˉfunctionˉdirectoryˉsummary,
    Function: u32
) -> Emission {
    let Layout: Layouts.Compilerˉwebassemblyˉvalueˉlayoutˉemission =
        Layouts.Compilerˉwebassemblyˉvalueˉlayoutˉfunctionˉtype(
            Input,
            Directory,
            Function
        );
    if !Layout.Valid {
        return Invalidˉemission(Input, 0u32, 0u32);
    }
    return Emission(true, Layout.Bytes, 0u32, 0u32);
}

fn Functionˉreturnsˉvalue(
    Input: bytes,
    Directory: Functions.Compilerˉwebassemblyˉfunctionˉdirectoryˉsummary,
    Function: u32
) -> bool {
    return Shapeˉkind(
        Input,
        Functions.Compilerˉwebassemblyˉfunctionˉresultˉtypeˉoffset(
            Directory,
            Function
        )
    ) != 0u32;
}

fn Functionˉreturnsˉi64(
    Input: bytes,
    Directory: Functions.Compilerˉwebassemblyˉfunctionˉdirectoryˉsummary,
    Function: u32
) -> bool {
    return Layouts.Compilerˉwebassemblyˉvalueˉlayoutˉshapeˉisˉi64(
        Input,
        Functions.Compilerˉwebassemblyˉfunctionˉresultˉtypeˉoffset(
            Directory,
            Function
        )
    );
}

fn Emitˉearlyˉreturn(Returnsˉvalue: bool, Returnsˉi64: bool) -> bytes {
    var Result: bytes = Byte(15u32);
    if Returnsˉvalue {
        if Returnsˉi64 {
            Result = Append(Append(Byte(66u32), Byte(0u32)), Result);
        } else {
            Result = Append(Positiveˉconstant(0u32), Result);
        }
    }
    return Result;
}

fn Emitˉstatusˉreturn(
    Status: u32,
    Returnsˉvalue: bool,
    Returnsˉi64: bool
) -> bytes {
    var Result: bytes = Positiveˉconstant(Status);
    Result = Append(Result, Indexed(36u32, 3u32));
    return Append(
        Result,
        Emitˉearlyˉreturn(Returnsˉvalue, Returnsˉi64)
    );
}

fn Emitˉfailureˉguard(
    Status: u32,
    Returnsˉvalue: bool,
    Returnsˉi64: bool
) -> bytes {
    var Result: bytes = Byte(4u32);
    Result = Append(Result, Byte(64u32));
    Result = Append(
        Result,
        Emitˉstatusˉreturn(Status, Returnsˉvalue, Returnsˉi64)
    );
    return Append(Result, Byte(11u32));
}

fn Emitˉmeter(Returnsˉvalue: bool, Returnsˉi64: bool) -> bytes {
    var Result: bytes = Indexed(35u32, 1u32);
    Result = Append(Result, Indexed(35u32, 2u32));
    Result = Append(Result, Byte(79u32));
    Result = Append(
        Result,
        Emitˉfailureˉguard(3011u32, Returnsˉvalue, Returnsˉi64)
    );
    Result = Append(Result, Indexed(35u32, 1u32));
    Result = Append(Result, Positiveˉconstant(1u32));
    Result = Append(Result, Byte(106u32));
    return Append(Result, Indexed(36u32, 1u32));
}

fn Emitˉcallˉfailureˉpropagation(
    Returnsˉvalue: bool,
    Returnsˉi64: bool,
    Calledˉreturnsˉvalue: bool,
    Calledˉreturnsˉi64: bool,
    Scratchˉresult: u32,
    Scratchˉwide: u32
) -> bytes {
    var Result: bytes = Empty(Byte(0u32));
    if Calledˉreturnsˉvalue {
        if Calledˉreturnsˉi64 {
            Result = Append(Result, Indexed(33u32, Scratchˉwide));
        } else {
            Result = Append(Result, Indexed(33u32, Scratchˉresult));
        }
    }
    Result = Append(Result, Indexed(35u32, 3u32));
    Result = Append(Result, Byte(4u32));
    Result = Append(Result, Byte(64u32));
    Result = Append(
        Result,
        Emitˉearlyˉreturn(Returnsˉvalue, Returnsˉi64)
    );
    Result = Append(Result, Byte(11u32));
    if Calledˉreturnsˉvalue {
        if Calledˉreturnsˉi64 {
            Result = Append(Result, Indexed(32u32, Scratchˉwide));
        } else {
            Result = Append(Result, Indexed(32u32, Scratchˉresult));
        }
    }
    return Result;
}

fn Emitˉcheckedˉi32ˉadd(
    Left: u32,
    Right: u32,
    Arithmeticˉresult: u32,
    Returnsˉvalue: bool,
    Returnsˉi64: bool
) -> bytes {
    var Result: bytes = Indexed(33u32, Right);
    Result = Append(Result, Indexed(33u32, Left));
    Result = Append(Result, Indexed(32u32, Left));
    Result = Append(Result, Indexed(32u32, Right));
    Result = Append(Result, Byte(106u32));
    Result = Append(Result, Indexed(34u32, Arithmeticˉresult));
    Result = Append(Result, Indexed(32u32, Left));
    Result = Append(Result, Byte(115u32));
    Result = Append(Result, Indexed(32u32, Arithmeticˉresult));
    Result = Append(Result, Indexed(32u32, Right));
    Result = Append(Result, Byte(115u32));
    Result = Append(Result, Byte(113u32));
    Result = Append(Result, Positiveˉconstant(0u32));
    Result = Append(Result, Byte(72u32));
    Result = Append(
        Result,
        Emitˉfailureˉguard(3007u32, Returnsˉvalue, Returnsˉi64)
    );
    return Append(Result, Indexed(32u32, Arithmeticˉresult));
}

fn Emitˉcheckedˉi32ˉsubtract(
    Left: u32,
    Right: u32,
    Arithmeticˉresult: u32,
    Returnsˉvalue: bool,
    Returnsˉi64: bool
) -> bytes {
    var Result: bytes = Indexed(33u32, Right);
    Result = Append(Result, Indexed(33u32, Left));
    Result = Append(Result, Indexed(32u32, Left));
    Result = Append(Result, Indexed(32u32, Right));
    Result = Append(Result, Byte(107u32));
    Result = Append(Result, Indexed(34u32, Arithmeticˉresult));
    Result = Append(Result, Indexed(32u32, Left));
    Result = Append(Result, Byte(115u32));
    Result = Append(Result, Indexed(32u32, Left));
    Result = Append(Result, Indexed(32u32, Right));
    Result = Append(Result, Byte(115u32));
    Result = Append(Result, Byte(113u32));
    Result = Append(Result, Positiveˉconstant(0u32));
    Result = Append(Result, Byte(72u32));
    Result = Append(
        Result,
        Emitˉfailureˉguard(3007u32, Returnsˉvalue, Returnsˉi64)
    );
    return Append(Result, Indexed(32u32, Arithmeticˉresult));
}

fn Emitˉcheckedˉi32ˉmultiply(
    Left: u32,
    Right: u32,
    Arithmeticˉresult: u32,
    Wideˉresult: u32,
    Returnsˉvalue: bool,
    Returnsˉi64: bool
) -> bytes {
    var Result: bytes = Indexed(33u32, Right);
    Result = Append(Result, Indexed(33u32, Left));
    Result = Append(Result, Indexed(32u32, Left));
    Result = Append(Result, Byte(172u32));
    Result = Append(Result, Indexed(32u32, Right));
    Result = Append(Result, Byte(172u32));
    Result = Append(Result, Byte(126u32));
    Result = Append(Result, Indexed(34u32, Wideˉresult));
    Result = Append(Result, Byte(167u32));
    Result = Append(Result, Indexed(34u32, Arithmeticˉresult));
    Result = Append(Result, Byte(172u32));
    Result = Append(Result, Indexed(32u32, Wideˉresult));
    Result = Append(Result, Byte(82u32));
    Result = Append(
        Result,
        Emitˉfailureˉguard(3007u32, Returnsˉvalue, Returnsˉi64)
    );
    return Append(Result, Indexed(32u32, Arithmeticˉresult));
}

fn Emitˉcheckedˉi32ˉnegate(
    Value: u32,
    Returnsˉvalue: bool,
    Returnsˉi64: bool
) -> bytes {
    var Result: bytes = Indexed(33u32, Value);
    Result = Append(Result, Indexed(32u32, Value));
    Result = Append(Result, I32ˉminimumˉconstant());
    Result = Append(Result, Byte(70u32));
    Result = Append(
        Result,
        Emitˉfailureˉguard(3007u32, Returnsˉvalue, Returnsˉi64)
    );
    Result = Append(Result, Positiveˉconstant(0u32));
    Result = Append(Result, Indexed(32u32, Value));
    return Append(Result, Byte(107u32));
}

fn Emitˉcheckedˉu32ˉadd(
    Left: u32,
    Right: u32,
    Arithmeticˉresult: u32,
    Returnsˉvalue: bool,
    Returnsˉi64: bool
) -> bytes {
    var Result: bytes = Indexed(33u32, Right);
    Result = Append(Result, Indexed(33u32, Left));
    Result = Append(Result, Indexed(32u32, Left));
    Result = Append(Result, Indexed(32u32, Right));
    Result = Append(Result, Byte(106u32));
    Result = Append(Result, Indexed(34u32, Arithmeticˉresult));
    Result = Append(Result, Indexed(32u32, Left));
    Result = Append(Result, Byte(73u32));
    Result = Append(
        Result,
        Emitˉfailureˉguard(3007u32, Returnsˉvalue, Returnsˉi64)
    );
    return Append(Result, Indexed(32u32, Arithmeticˉresult));
}

fn Emitˉcheckedˉu32ˉsubtract(
    Left: u32,
    Right: u32,
    Returnsˉvalue: bool,
    Returnsˉi64: bool
) -> bytes {
    var Result: bytes = Indexed(33u32, Right);
    Result = Append(Result, Indexed(33u32, Left));
    Result = Append(Result, Indexed(32u32, Left));
    Result = Append(Result, Indexed(32u32, Right));
    Result = Append(Result, Byte(73u32));
    Result = Append(
        Result,
        Emitˉfailureˉguard(3007u32, Returnsˉvalue, Returnsˉi64)
    );
    Result = Append(Result, Indexed(32u32, Left));
    Result = Append(Result, Indexed(32u32, Right));
    return Append(Result, Byte(107u32));
}

fn Emitˉcheckedˉu32ˉmultiply(
    Left: u32,
    Right: u32,
    Arithmeticˉresult: u32,
    Wideˉresult: u32,
    Returnsˉvalue: bool,
    Returnsˉi64: bool
) -> bytes {
    var Result: bytes = Indexed(33u32, Right);
    Result = Append(Result, Indexed(33u32, Left));
    Result = Append(Result, Indexed(32u32, Left));
    Result = Append(Result, Byte(173u32));
    Result = Append(Result, Indexed(32u32, Right));
    Result = Append(Result, Byte(173u32));
    Result = Append(Result, Byte(126u32));
    Result = Append(Result, Indexed(34u32, Wideˉresult));
    Result = Append(Result, Byte(167u32));
    Result = Append(Result, Indexed(34u32, Arithmeticˉresult));
    Result = Append(Result, Byte(173u32));
    Result = Append(Result, Indexed(32u32, Wideˉresult));
    Result = Append(Result, Byte(82u32));
    Result = Append(
        Result,
        Emitˉfailureˉguard(3007u32, Returnsˉvalue, Returnsˉi64)
    );
    return Append(Result, Indexed(32u32, Arithmeticˉresult));
}

fn Emitˉoperation(
    Input: bytes,
    Code: u32,
    Offset: u32,
    Opcode: u8,
    Reachableˉorder: bytes,
    Directory: Functions.Compilerˉwebassemblyˉfunctionˉdirectoryˉsummary,
    Data: Staticˉdata.Compilerˉwebassemblyˉstaticˉdataˉsummary,
    Function: u32,
    Scratchˉleft: u32,
    Scratchˉright: u32,
    Scratchˉresult: u32,
    Scratchˉwide: u32
) -> Emission {
    var Result: bytes = Empty(Input);
    let Returnsˉvalue: bool = Functionˉreturnsˉvalue(
        Input,
        Directory,
        Function
    );
    let Returnsˉi64: bool = Functionˉreturnsˉi64(
        Input,
        Directory,
        Function
    );
    if Opcode == 1u8 || Opcode == 9u8 {
        Result = Encoding.Compilerˉwebassemblyˉbinaryˉi32ˉconstantˉfromˉinput(
            Input,
            Code + Offset + 1u32
        );
        return Emission(true, Result, 0u32, 0u32);
    }
    if Opcode == 2u8 || Opcode == 8u8 {
        Result = Positiveˉconstant(U32ˉfromˉu8(
            Bytesˉreadˉu8(Input, Code + Offset + 1u32)
        ));
        return Emission(true, Result, 0u32, 0u32);
    }
    if Opcode == 4u8 {
        return Emission(
            true,
            Indexed(
                32u32,
                Bytesˉreadˉu32ˉlittle(Input, Code + Offset + 1u32)
            ),
            0u32,
            0u32
        );
    }
    if Opcode == 5u8 {
        return Emission(
            true,
            Indexed(
                33u32,
                Bytesˉreadˉu32ˉlittle(Input, Code + Offset + 1u32)
            ),
            0u32,
            0u32
        );
    }
    let Scalar: Scalars.Compilerˉwebassemblyˉscalarˉoperationˉemission =
        Scalars.Compilerˉwebassemblyˉscalarˉoperationˉemit(
            Input,
            Opcode,
            Scratchˉleft,
            Scratchˉright,
            Returnsˉvalue,
            Returnsˉi64,
            3u32
        );
    if Scalar.Matched {
        return Emission(true, Scalar.Bytes, 0u32, 0u32);
    }
    let Descriptor:
        Descriptors.Compilerˉwebassemblyˉdescriptorˉoperationˉemission =
        Descriptors.Compilerˉwebassemblyˉdescriptorˉoperationˉemit(
            Input,
            Code,
            Offset,
            Opcode,
            Data,
            Scratchˉleft,
            Scratchˉright,
            Scratchˉresult,
            Scratchˉwide,
            Returnsˉvalue,
            Returnsˉi64,
            3u32
        );
    if Descriptor.Matched {
        if !Descriptor.Valid {
            return Invalidˉemission(Input, Offset, U32ˉfromˉu8(Opcode));
        }
        return Emission(true, Descriptor.Bytes, 0u32, 0u32);
    }
    if Opcode == 16u8 {
        return Emission(
            true,
            Emitˉcheckedˉi32ˉadd(
                Scratchˉleft,
                Scratchˉright,
                Scratchˉresult,
                Returnsˉvalue,
                Returnsˉi64
            ),
            0u32,
            0u32
        );
    }
    if Opcode == 17u8 {
        return Emission(
            true,
            Emitˉcheckedˉi32ˉsubtract(
                Scratchˉleft,
                Scratchˉright,
                Scratchˉresult,
                Returnsˉvalue,
                Returnsˉi64
            ),
            0u32,
            0u32
        );
    }
    if Opcode == 18u8 {
        return Emission(
            true,
            Emitˉcheckedˉi32ˉmultiply(
                Scratchˉleft,
                Scratchˉright,
                Scratchˉresult,
                Scratchˉwide,
                Returnsˉvalue,
                Returnsˉi64
            ),
            0u32,
            0u32
        );
    }
    if Opcode == 19u8 {
        return Emission(
            true,
            Emitˉcheckedˉi32ˉnegate(
                Scratchˉleft,
                Returnsˉvalue,
                Returnsˉi64
            ),
            0u32,
            0u32
        );
    }
    if Opcode == 20u8 {
        return Emission(
            true,
            Emitˉcheckedˉu32ˉadd(
                Scratchˉleft,
                Scratchˉright,
                Scratchˉresult,
                Returnsˉvalue,
                Returnsˉi64
            ),
            0u32,
            0u32
        );
    }
    if Opcode == 21u8 {
        return Emission(
            true,
            Emitˉcheckedˉu32ˉsubtract(
                Scratchˉleft,
                Scratchˉright,
                Returnsˉvalue,
                Returnsˉi64
            ),
            0u32,
            0u32
        );
    }
    if Opcode == 22u8 {
        return Emission(
            true,
            Emitˉcheckedˉu32ˉmultiply(
                Scratchˉleft,
                Scratchˉright,
                Scratchˉresult,
                Scratchˉwide,
                Returnsˉvalue,
                Returnsˉi64
            ),
            0u32,
            0u32
        );
    }
    var Wasmˉopcode: u32 = 0u32;
    if Opcode == 32u8 || Opcode == 38u8 || Opcode == 96u8 || Opcode == 102u8 {
        Wasmˉopcode = 70u32;
    }
    if Opcode == 33u8 || Opcode == 39u8 || Opcode == 97u8 || Opcode == 103u8 {
        Wasmˉopcode = 71u32;
    }
    if Opcode == 34u8 { Wasmˉopcode = 72u32; }
    if Opcode == 35u8 { Wasmˉopcode = 76u32; }
    if Opcode == 36u8 { Wasmˉopcode = 74u32; }
    if Opcode == 37u8 { Wasmˉopcode = 78u32; }
    if Opcode == 40u8 { Wasmˉopcode = 69u32; }
    if Opcode == 98u8 { Wasmˉopcode = 73u32; }
    if Opcode == 99u8 { Wasmˉopcode = 77u32; }
    if Opcode == 100u8 { Wasmˉopcode = 75u32; }
    if Opcode == 101u8 { Wasmˉopcode = 79u32; }
    if Wasmˉopcode != 0u32 {
        return Emission(true, Byte(Wasmˉopcode), 0u32, 0u32);
    }
    if Opcode == 118u8 { return Emission(true, Result, 0u32, 0u32); }
    if Opcode == 80u8 { return Emission(true, Byte(26u32), 0u32, 0u32); }
    if Opcode == 64u8 {
        let Target: u32 = Bytesˉreadˉu32ˉlittle(
            Input,
            Code + Offset + 1u32
        );
        let Position: Positionˉlookup = Reachableˉposition(
            Reachableˉorder,
            Target
        );
        if !Position.Found {
            return Invalidˉemission(Input, Offset, U32ˉfromˉu8(Opcode));
        }
        Result = Indexed(16u32, Position.Position);
        Result = Append(
            Result,
            Emitˉcallˉfailureˉpropagation(
                Returnsˉvalue,
                Returnsˉi64,
                Functionˉreturnsˉvalue(Input, Directory, Target),
                Functionˉreturnsˉi64(Input, Directory, Target),
                Scratchˉresult,
                Scratchˉwide
            )
        );
        return Emission(true, Result, 0u32, 0u32);
    }
    return Invalidˉemission(Input, Offset, U32ˉfromˉu8(Opcode));
}

fn Emitˉsetˉprogramˉcounter(Counter: u32, Block: u32) -> bytes {
    return Append(Positiveˉconstant(Block), Indexed(33u32, Counter));
}

fn Emitˉblock(
    Input: bytes,
    Code: u32,
    Length: u32,
    Starts: u32,
    Localˉblock: u32,
    Counter: u32,
    Scratchˉleft: u32,
    Scratchˉright: u32,
    Scratchˉresult: u32,
    Scratchˉwide: u32,
    Control: Controls.Compilerˉwebassemblyˉcontrolˉflowˉsummary,
    Reachableˉorder: bytes,
    Directory: Functions.Compilerˉwebassemblyˉfunctionˉdirectoryˉsummary,
    Data: Staticˉdata.Compilerˉwebassemblyˉstaticˉdataˉsummary,
    Function: u32
) -> Emission {
    let Block: u32 = Starts + Localˉblock;
    let Start: u32 = Controls.Compilerˉwebassemblyˉcontrolˉflowˉblockˉstart(
        Control,
        Block
    );
    let Blockˉlength: u32 =
        Controls.Compilerˉwebassemblyˉcontrolˉflowˉblockˉlength(
            Control,
            Block
        );
    let Kind: u32 = Controls.Compilerˉwebassemblyˉcontrolˉflowˉblockˉkind(
        Control,
        Block
    );
    if Start > Length || Blockˉlength > Length - Start {
        return Invalidˉemission(Input, Start, 0u32);
    }
    let End: u32 = Start + Blockˉlength;
    var Result: bytes = Empty(Input);
    let Returnsˉvalue: bool = Functionˉreturnsˉvalue(
        Input,
        Directory,
        Function
    );
    let Returnsˉi64: bool = Functionˉreturnsˉi64(
        Input,
        Directory,
        Function
    );
    var Cursor: u32 = Start;
    while Cursor < End {
        let Width: u32 = Functions.Compilerˉwebassemblyˉinstructionˉwidth(
            Input,
            Code,
            Length,
            Cursor
        );
        if Width == 0u32 || Width > End - Cursor {
            return Invalidˉemission(Input, Cursor, 0u32);
        }
        let Opcode: u8 = Bytesˉreadˉu8(Input, Code + Cursor);
        let Isˉterminator: bool = Cursor + Width == End && Kind != 0u32;
        Result = Append(
            Result,
            Emitˉmeter(Returnsˉvalue, Returnsˉi64)
        );
        if !Isˉterminator {
            let Operation: Emission = Emitˉoperation(
                Input,
                Code,
                Cursor,
                Opcode,
                Reachableˉorder,
                Directory,
                Data,
                Function,
                Scratchˉleft,
                Scratchˉright,
                Scratchˉresult,
                Scratchˉwide
            );
            if !Operation.Valid {
                return Invalidˉemission(
                    Input,
                    Operation.Failureˉoffset,
                    Operation.Failureˉopcode
                );
            }
            Result = Append(Result, Operation.Bytes);
        }
        Cursor = Cursor + Width;
    }
    if Cursor != End { return Invalidˉemission(Input, Cursor, 0u32); }

    let First: u32 =
        Controls.Compilerˉwebassemblyˉcontrolˉflowˉblockˉfirstˉsuccessor(
            Control,
            Block
        );
    if Kind == 0u32 || Kind == 1u32 {
        if First == 4294967295u32 {
            return Invalidˉemission(Input, End, 0u32);
        }
        Result = Append(Result, Emitˉsetˉprogramˉcounter(Counter, First));
        Result = Append(Result, Indexed(12u32, 1u32));
        return Emission(true, Result, 0u32, 0u32);
    }
    if Kind == 2u32 {
        let Second: u32 =
            Controls.Compilerˉwebassemblyˉcontrolˉflowˉblockˉsecondˉsuccessor(
                Control,
                Block
            );
        if First == 4294967295u32 || Second == 4294967295u32 {
            return Invalidˉemission(Input, End, 49u32);
        }
        Result = Append(Result, Byte(4u32));
        Result = Append(Result, Byte(64u32));
        Result = Append(Result, Emitˉsetˉprogramˉcounter(Counter, First));
        Result = Append(Result, Byte(5u32));
        Result = Append(Result, Emitˉsetˉprogramˉcounter(Counter, Second));
        Result = Append(Result, Byte(11u32));
        Result = Append(Result, Indexed(12u32, 1u32));
        return Emission(true, Result, 0u32, 0u32);
    }
    if Kind == 3u32 {
        Result = Append(Result, Byte(15u32));
        return Emission(true, Result, 0u32, 0u32);
    }
    return Invalidˉemission(Input, End, Kind);
}

fn Emitˉfunction(
    Input: bytes,
    Codeˉoffset: u32,
    Directory: Functions.Compilerˉwebassemblyˉfunctionˉdirectoryˉsummary,
    Control: Controls.Compilerˉwebassemblyˉcontrolˉflowˉsummary,
    Reachableˉorder: bytes,
    Data: Staticˉdata.Compilerˉwebassemblyˉstaticˉdataˉsummary,
    Function: u32
) -> Emission {
    let Typeˉlayout: Layouts.Compilerˉwebassemblyˉvalueˉlayoutˉemission =
        Layouts.Compilerˉwebassemblyˉvalueˉlayoutˉfunctionˉtype(
            Input,
            Directory,
            Function
        );
    if !Typeˉlayout.Valid {
        return Invalidˉemission(Input, 0u32, 0u32);
    }
    let Functionˉcodeˉrelative: u32 =
        Functions.Compilerˉwebassemblyˉfunctionˉcodeˉoffset(
            Directory,
            Function
        );
    let Functionˉcodeˉlength: u32 =
        Functions.Compilerˉwebassemblyˉfunctionˉcodeˉlength(
            Directory,
            Function
        );
    let Functionˉcode: u32 = Codeˉoffset + Functionˉcodeˉrelative;
    let Firstˉblock: u32 =
        Controls.Compilerˉwebassemblyˉcontrolˉflowˉfunctionˉfirstˉblock(
            Control,
            Function
        );
    let Blockˉcount: u32 =
        Controls.Compilerˉwebassemblyˉcontrolˉflowˉfunctionˉblockˉcount(
            Control,
            Function
        );
    if Blockˉcount == 0u32 { return Invalidˉemission(Input, 0u32, 0u32); }
    let Parameterˉcount: u32 =
        Functions.Compilerˉwebassemblyˉfunctionˉparameterˉcount(
            Directory,
            Function
        );
    let Localˉcount: u32 =
        Functions.Compilerˉwebassemblyˉfunctionˉlocalˉcount(
            Directory,
            Function
        );
    let Counter: u32 = Parameterˉcount + Localˉcount;
    let Scratchˉleft: u32 = Counter + 1u32;
    let Scratchˉright: u32 = Counter + 2u32;
    let Scratchˉresult: u32 = Counter + 3u32;
    let Scratchˉwide: u32 = Counter + 4u32;
    let Localˉlayout: Layouts.Compilerˉwebassemblyˉvalueˉlayoutˉemission =
        Layouts.Compilerˉwebassemblyˉvalueˉlayoutˉfunctionˉlocals(
            Input,
            Directory,
            Function
        );
    if !Localˉlayout.Valid {
        return Invalidˉemission(Input, 0u32, 0u32);
    }
    let Localˉdeclarations: bytes = Localˉlayout.Bytes;

    var Instructions: bytes = Emitˉsetˉprogramˉcounter(Counter, 0u32);
    Instructions = Append(Instructions, Byte(3u32));
    Instructions = Append(Instructions, Byte(64u32));
    var Localˉblock: u32 = 0u32;
    while Localˉblock < Blockˉcount {
        Instructions = Append(Instructions, Indexed(32u32, Counter));
        Instructions = Append(Instructions, Positiveˉconstant(Localˉblock));
        Instructions = Append(Instructions, Byte(70u32));
        Instructions = Append(Instructions, Byte(4u32));
        Instructions = Append(Instructions, Byte(64u32));
        let Block: Emission = Emitˉblock(
            Input,
            Functionˉcode,
            Functionˉcodeˉlength,
            Firstˉblock,
            Localˉblock,
            Counter,
            Scratchˉleft,
            Scratchˉright,
            Scratchˉresult,
            Scratchˉwide,
            Control,
            Reachableˉorder,
            Directory,
            Data,
            Function
        );
        if !Block.Valid { return Block; }
        Instructions = Append(Instructions, Block.Bytes);
        Instructions = Append(Instructions, Byte(11u32));
        Localˉblock = Localˉblock + 1u32;
    }
    Instructions = Append(Instructions, Byte(0u32));
    Instructions = Append(Instructions, Byte(11u32));
    Instructions = Append(Instructions, Byte(0u32));
    return Emission(
        true,
        Encoding.Compilerˉwebassemblyˉbinaryˉfunctionˉbody(
            Localˉdeclarations,
            Instructions
        ),
        0u32,
        0u32
    );
}

fn Emitˉwrapper(Rootˉposition: u32) -> bytes {
    var Localˉdeclarations: bytes = Uleb(1u32);
    Localˉdeclarations = Append(Localˉdeclarations, Uleb(1u32));
    Localˉdeclarations = Append(Localˉdeclarations, Byte(127u32));

    var Instructions: bytes = Positiveˉconstant(0u32);
    Instructions = Append(Instructions, Indexed(36u32, 0u32));
    Instructions = Append(Instructions, Positiveˉconstant(0u32));
    Instructions = Append(Instructions, Indexed(36u32, 1u32));
    Instructions = Append(Instructions, Indexed(32u32, 0u32));
    Instructions = Append(Instructions, Indexed(36u32, 2u32));
    Instructions = Append(Instructions, Positiveˉconstant(0u32));
    Instructions = Append(Instructions, Indexed(36u32, 3u32));

    Instructions = Append(Instructions, Indexed(32u32, 0u32));
    Instructions = Append(Instructions, Positiveˉconstant(0u32));
    Instructions = Append(Instructions, Byte(76u32));
    Instructions = Append(Instructions, Byte(4u32));
    Instructions = Append(Instructions, Byte(64u32));
    Instructions = Append(Instructions, Positiveˉconstant(3011u32));
    Instructions = Append(Instructions, Indexed(36u32, 3u32));
    Instructions = Append(Instructions, Indexed(35u32, 3u32));
    Instructions = Append(Instructions, Byte(15u32));
    Instructions = Append(Instructions, Byte(11u32));

    Instructions = Append(Instructions, Indexed(16u32, Rootˉposition));
    Instructions = Append(Instructions, Indexed(33u32, 1u32));
    Instructions = Append(Instructions, Indexed(35u32, 3u32));
    Instructions = Append(Instructions, Byte(69u32));
    Instructions = Append(Instructions, Byte(4u32));
    Instructions = Append(Instructions, Byte(64u32));
    Instructions = Append(Instructions, Indexed(32u32, 1u32));
    Instructions = Append(Instructions, Indexed(36u32, 0u32));
    Instructions = Append(Instructions, Byte(11u32));
    Instructions = Append(Instructions, Indexed(35u32, 3u32));
    return Encoding.Compilerˉwebassemblyˉbinaryˉfunctionˉbody(
        Localˉdeclarations,
        Instructions
    );
}

export fn Compilerˉwebassemblyˉscalarˉdispatcherˉemit(
    Input: bytes,
    Codeˉoffset: u32,
    Codeˉlength: u32,
    Directory: Functions.Compilerˉwebassemblyˉfunctionˉdirectoryˉsummary,
    Graph: Graphs.Compilerˉwebassemblyˉexecutableˉgraphˉsummary,
    Control: Controls.Compilerˉwebassemblyˉcontrolˉflowˉsummary,
    Data: Staticˉdata.Compilerˉwebassemblyˉstaticˉdataˉsummary
) -> Compilerˉwebassemblyˉscalarˉdispatcherˉsummary {
    if !Directory.Valid || !Graph.Valid || !Control.Valid || !Data.Valid ||
        Directory.Count != Graph.Functionˉcount ||
        Control.Reachableˉfunctionˉcount != Graph.Reachableˉcount ||
        Bytesˉlength(Graph.Reachableˉorder) != Graph.Reachableˉcount * 4u32 ||
        Graph.Reachableˉcount == 0u32 || Graph.Reachableˉcount > 512u32 {
        return Invalid(Input, 0u32, 0u32, 0u32);
    }
    if Codeˉoffset > Bytesˉlength(Input) ||
        Codeˉlength > Bytesˉlength(Input) - Codeˉoffset {
        return Invalid(Input, 0u32, 0u32, 0u32);
    }
    let Rootˉposition: Positionˉlookup = Reachableˉposition(
        Graph.Reachableˉorder,
        Graph.Root
    );
    if !Rootˉposition.Found {
        return Invalid(Input, Graph.Root, 0u32, 0u32);
    }
    if Functions.Compilerˉwebassemblyˉfunctionˉparameterˉcount(
        Directory,
        Graph.Root
    ) != 0u32 {
        return Invalid(Input, Graph.Root, 0u32, 0u32);
    }
    let Rootˉresult: u32 = Shapeˉkind(
        Input,
        Functions.Compilerˉwebassemblyˉfunctionˉresultˉtypeˉoffset(
            Directory,
            Graph.Root
        )
    );
    if !Shapeˉisˉscalar(Rootˉresult) {
        return Invalid(Input, Graph.Root, 0u32, 0u32);
    }

    var Typeˉentries: bytes = Empty(Input);
    var Functionˉentries: bytes = Empty(Input);
    var Codeˉentries: bytes = Empty(Input);
    var Position: u32 = 0u32;
    while Position < Graph.Reachableˉcount {
        let Function: u32 = Bytesˉreadˉu32ˉlittle(
            Graph.Reachableˉorder,
            Position * 4u32
        );
        if Function >= Directory.Count {
            return Invalid(Input, Function, 0u32, 0u32);
        }
        let Type: Emission = Emitˉtype(Input, Directory, Function);
        if !Type.Valid {
            return Invalid(
                Input,
                Function,
                Type.Failureˉoffset,
                Type.Failureˉopcode
            );
        }
        Typeˉentries = Append(Typeˉentries, Type.Bytes);
        Functionˉentries = Append(Functionˉentries, Uleb(Position));
        let Body: Emission = Emitˉfunction(
            Input,
            Codeˉoffset,
            Directory,
            Control,
            Graph.Reachableˉorder,
            Data,
            Function
        );
        if !Body.Valid {
            return Invalid(
                Input,
                Function,
                Body.Failureˉoffset,
                Body.Failureˉopcode
            );
        }
        Codeˉentries = Append(Codeˉentries, Body.Bytes);
        Position = Position + 1u32;
    }

    var Wrapperˉtype: bytes = Byte(96u32);
    Wrapperˉtype = Append(Wrapperˉtype, Uleb(1u32));
    Wrapperˉtype = Append(Wrapperˉtype, Byte(127u32));
    Wrapperˉtype = Append(Wrapperˉtype, Uleb(1u32));
    Wrapperˉtype = Append(Wrapperˉtype, Byte(127u32));
    Typeˉentries = Append(Typeˉentries, Wrapperˉtype);
    Functionˉentries = Append(
        Functionˉentries,
        Uleb(Graph.Reachableˉcount)
    );
    Codeˉentries = Append(
        Codeˉentries,
        Emitˉwrapper(Rootˉposition.Position)
    );

    var Typeˉpayload: bytes = Uleb(Graph.Reachableˉcount + 1u32);
    Typeˉpayload = Append(Typeˉpayload, Typeˉentries);
    var Functionˉpayload: bytes = Uleb(Graph.Reachableˉcount + 1u32);
    Functionˉpayload = Append(Functionˉpayload, Functionˉentries);
    var Globalˉpayload: bytes = Uleb(4u32);
    Globalˉpayload = Append(Globalˉpayload, Globalˉi32(true, 0u32));
    Globalˉpayload = Append(Globalˉpayload, Globalˉi32(true, 0u32));
    Globalˉpayload = Append(Globalˉpayload, Globalˉi32(true, 0u32));
    Globalˉpayload = Append(Globalˉpayload, Globalˉi32(true, 0u32));
    var Exportˉpayload: bytes = Uleb(3u32);
    Exportˉpayload = Append(
        Exportˉpayload,
        Exportˉentry(
            "Windvale.run",
            0u32,
            Graph.Reachableˉcount
        )
    );
    Exportˉpayload = Append(
        Exportˉpayload,
        Exportˉentry("Windvale.result", 3u32, 0u32)
    );
    Exportˉpayload = Append(
        Exportˉpayload,
        Exportˉentry("Windvale.instructions", 3u32, 1u32)
    );
    var Codeˉpayload: bytes = Uleb(Graph.Reachableˉcount + 1u32);
    Codeˉpayload = Append(Codeˉpayload, Codeˉentries);

    var Webassembly: bytes = Encoding.Compilerˉwebassemblyˉbinaryˉheader();
    Webassembly = Append(
        Webassembly,
        Encoding.Compilerˉwebassemblyˉbinaryˉsection(1u32, Typeˉpayload)
    );
    Webassembly = Append(
        Webassembly,
        Encoding.Compilerˉwebassemblyˉbinaryˉsection(
            3u32,
            Functionˉpayload
        )
    );
    Webassembly = Append(
        Webassembly,
        Staticˉdata.Compilerˉwebassemblyˉstaticˉdataˉmemoryˉsection(
            Input,
            Data
        )
    );
    Webassembly = Append(
        Webassembly,
        Encoding.Compilerˉwebassemblyˉbinaryˉsection(6u32, Globalˉpayload)
    );
    Webassembly = Append(
        Webassembly,
        Encoding.Compilerˉwebassemblyˉbinaryˉsection(7u32, Exportˉpayload)
    );
    Webassembly = Append(
        Webassembly,
        Encoding.Compilerˉwebassemblyˉbinaryˉsection(10u32, Codeˉpayload)
    );
    Webassembly = Append(
        Webassembly,
        Staticˉdata.Compilerˉwebassemblyˉstaticˉdataˉsection(
            Input,
            Data
        )
    );
    if Bytesˉlength(Webassembly) > 16777216u32 {
        return Invalid(Input, 0u32, 0u32, 0u32);
    }
    return Compilerˉwebassemblyˉscalarˉdispatcherˉsummary(
        true,
        Webassembly,
        Graph.Reachableˉcount,
        Control.Blockˉcount,
        0u32,
        0u32,
        0u32
    );
}
