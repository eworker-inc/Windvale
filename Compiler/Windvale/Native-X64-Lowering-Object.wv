module Compilerˉnativeˉx64ˉloweringˉobject profile portable;

import Compilerˉnativeˉx64ˉloweringˉdata as Staticˉdata;
import Compilerˉnativeˉx64ˉloweringˉlayout as Layout;

export record Compilerˉnativeˉx64ˉobjectˉregions {
    Valid: bool;
    Prefix: bytes;
    Readˉonlyˉheader: bytes;
    Symbols: bytes;
    Relocationˉrecords: bytes;
    Objectˉbytes: u32;
}

fn Empty(Input: bytes) -> bytes {
    return Bytesˉslice(Input, 0u32, 0u32);
}

fn Sectionˉheader(
    Kind: u8,
    Name: text,
    Dataˉlength: u32
) -> bytes {
    var Output: bytes = Bytesˉfromˉu8(Kind);
    Output = Bytesˉconcat(Output, Bytesˉfromˉu8(0u8));
    Output = Bytesˉconcat(Output, Bytesˉfromˉu16ˉlittle(0u32));
    Output = Bytesˉconcat(Output, Bytesˉfromˉu32ˉlittle(16u32));
    Output = Bytesˉconcat(Output, Bytesˉfromˉu32ˉlittle(Dataˉlength));
    Output = Bytesˉconcat(Output, Bytesˉfromˉu32ˉlittle(Dataˉlength));
    let Nameˉbytes: bytes = Textˉtoˉutf8(Name);
    Output = Bytesˉconcat(Output, Bytesˉfromˉu32ˉlittle(Bytesˉlength(Nameˉbytes)));
    return Bytesˉconcat(Output, Nameˉbytes);
}

fn Symbolˉrecord(
    Binding: u8,
    Kind: u8,
    Section: u32,
    Offset: u32,
    Size: u32,
    Name: bytes
) -> bytes {
    var Output: bytes = Bytesˉfromˉu8(Binding);
    Output = Bytesˉconcat(Output, Bytesˉfromˉu8(Kind));
    Output = Bytesˉconcat(Output, Bytesˉfromˉu16ˉlittle(0u32));
    Output = Bytesˉconcat(Output, Bytesˉfromˉu32ˉlittle(Section));
    Output = Bytesˉconcat(Output, Bytesˉfromˉu32ˉlittle(Offset));
    Output = Bytesˉconcat(Output, Bytesˉfromˉu32ˉlittle(Size));
    Output = Bytesˉconcat(Output, Bytesˉfromˉu32ˉlittle(Bytesˉlength(Name)));
    return Bytesˉconcat(Output, Name);
}

fn Relocationˉrecord(Relocations: bytes, Relocation: u32) -> bytes {
    var Result: bytes = Bytesˉfromˉu8(2u8);
    Result = Bytesˉconcat(Result, Bytesˉfromˉu8(0u8));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu16ˉlittle(0u32));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(0u32));
    Result = Bytesˉconcat(
        Result,
        Bytesˉfromˉu32ˉlittle(
            Bytesˉreadˉu32ˉlittle(Relocations, Relocation * 8u32)
        )
    );
    Result = Bytesˉconcat(
        Result,
        Bytesˉfromˉu32ˉlittle(
            Bytesˉreadˉu32ˉlittle(Relocations, Relocation * 8u32 + 4u32)
        )
    );
    return Bytesˉconcat(Result, Bytesˉfromˉi32ˉlittle(-4));
}

fn Dataˉsymbolˉname(Index: u32) -> bytes {
    return Layout.Compilerˉnativeˉx64ˉlayoutˉsymbolˉname(
        "$data_",
        Index,
        Staticˉdata.Compilerˉnativeˉx64ˉdataˉlimit()
    );
}

fn Objectˉbody(
    Code: bytes,
    Padding: bytes,
    Readˉonlyˉheader: bytes,
    Readˉonlyˉdata: bytes,
    Symbols: bytes,
    Relocationˉrecords: bytes
) -> bytes {
    let Suffix: bytes = Bytesˉconcat(
        Bytesˉconcat(Readˉonlyˉheader, Readˉonlyˉdata),
        Bytesˉconcat(Symbols, Relocationˉrecords)
    );
    return Bytesˉconcat(Code, Bytesˉconcat(Padding, Suffix));
}

fn Invalidˉregions(Input: bytes) -> Compilerˉnativeˉx64ˉobjectˉregions {
    let Emptyˉvalue: bytes = Empty(Input);
    return Compilerˉnativeˉx64ˉobjectˉregions(
        false,
        Emptyˉvalue,
        Emptyˉvalue,
        Emptyˉvalue,
        Emptyˉvalue,
        0u32
    );
}

export fn Compilerˉnativeˉx64ˉobjectˉplan(
    Input: bytes,
    Codeˉbytes: u32,
    Padding: bytes,
    Directory: bytes,
    Functionˉcount: u32,
    Mainˉfunction: u32,
    Data: Staticˉdata.Compilerˉnativeˉx64ˉdata,
    Relocations: bytes
) -> Compilerˉnativeˉx64ˉobjectˉregions {
    if Codeˉbytes > 33554432u32 { return Invalidˉregions(Input); }
    if Functionˉcount == 0u32 { return Invalidˉregions(Input); }
    if Functionˉcount >
        Layout.Compilerˉnativeˉx64ˉlayoutˉfunctionˉlimit() {
        return Invalidˉregions(Input);
    }
    if Mainˉfunction >= Functionˉcount { return Invalidˉregions(Input); }
    if !Data.Valid { return Invalidˉregions(Input); }
    if Data.Count > Staticˉdata.Compilerˉnativeˉx64ˉdataˉlimit() {
        return Invalidˉregions(Input);
    }
    if Bytesˉlength(Directory) !=
        Functionˉcount * Layout.Compilerˉnativeˉx64ˉlayoutˉentryˉbytes() {
        return Invalidˉregions(Input);
    }
    var Layoutˉfunction: u32 = 0u32;
    var Expectedˉmachineˉoffset: u32 = 0u32;
    while Layoutˉfunction < Functionˉcount {
        if Layout.Compilerˉnativeˉx64ˉlayoutˉmachineˉoffset(
            Directory,
            Layoutˉfunction
        ) != Expectedˉmachineˉoffset {
            return Invalidˉregions(Input);
        }
        let Machineˉlength: u32 =
            Layout.Compilerˉnativeˉx64ˉlayoutˉmachineˉlength(
                Directory,
                Layoutˉfunction
            );
        if Expectedˉmachineˉoffset > Codeˉbytes {
            return Invalidˉregions(Input);
        }
        if Machineˉlength > Codeˉbytes - Expectedˉmachineˉoffset {
            return Invalidˉregions(Input);
        }
        Expectedˉmachineˉoffset = Expectedˉmachineˉoffset + Machineˉlength;
        Layoutˉfunction = Layoutˉfunction + 1u32;
    }
    if Expectedˉmachineˉoffset != Codeˉbytes {
        return Invalidˉregions(Input);
    }
    if Bytesˉlength(Relocations) % 8u32 != 0u32 {
        return Invalidˉregions(Input);
    }
    let Relocationˉcount: u32 = Bytesˉlength(Relocations) / 8u32;
    if Relocationˉcount > 65536u32 { return Invalidˉregions(Input); }
    if Bytesˉlength(Data.Kinds) != Data.Count {
        return Invalidˉregions(Input);
    }
    if Bytesˉlength(Data.Lengths) != Data.Count * 4u32 {
        return Invalidˉregions(Input);
    }
    if Bytesˉlength(Data.Offsets) != Data.Count * 4u32 {
        return Invalidˉregions(Input);
    }
    if Bytesˉlength(Data.Sizes) != Data.Count * 4u32 {
        return Invalidˉregions(Input);
    }
    var Dataˉindex: u32 = 0u32;
    var Expectedˉdataˉoffset: u32 = 0u32;
    while Dataˉindex < Data.Count {
        if Staticˉdata.Compilerˉnativeˉx64ˉdataˉoffset(Data, Dataˉindex) !=
            Expectedˉdataˉoffset {
            return Invalidˉregions(Input);
        }
        let Dataˉsize: u32 =
            Staticˉdata.Compilerˉnativeˉx64ˉdataˉsize(Data, Dataˉindex);
        if Dataˉsize > Bytesˉlength(Data.Bytes) - Expectedˉdataˉoffset {
            return Invalidˉregions(Input);
        }
        Expectedˉdataˉoffset = Expectedˉdataˉoffset + Dataˉsize;
        Dataˉindex = Dataˉindex + 1u32;
    }
    if Expectedˉdataˉoffset != Bytesˉlength(Data.Bytes) {
        return Invalidˉregions(Input);
    }
    if Data.Count == 0u32 {
        if Relocationˉcount != 0u32 { return Invalidˉregions(Input); }
        if Bytesˉlength(Padding) != 0u32 { return Invalidˉregions(Input); }
    } else {
        if Bytesˉlength(Padding) > 15u32 { return Invalidˉregions(Input); }
        if (Codeˉbytes + Bytesˉlength(Padding)) % 16u32 != 0u32 {
            return Invalidˉregions(Input);
        }
        var Paddingˉindex: u32 = 0u32;
        while Paddingˉindex < Bytesˉlength(Padding) {
            if Bytesˉreadˉu8(Padding, Paddingˉindex) != 144u8 {
                return Invalidˉregions(Input);
            }
            Paddingˉindex = Paddingˉindex + 1u32;
        }
    }

    var Relocation: u32 = 0u32;
    var Previousˉoffset: u32 = 0u32;
    while Relocation < Relocationˉcount {
        let Patchˉoffset: u32 = Bytesˉreadˉu32ˉlittle(Relocations, Relocation * 8u32);
        let Targetˉdata: u32 = Bytesˉreadˉu32ˉlittle(
            Relocations,
            Relocation * 8u32 + 4u32
        );
        if Targetˉdata >= Data.Count { return Invalidˉregions(Input); }
        if Patchˉoffset > Codeˉbytes { return Invalidˉregions(Input); }
        if 4u32 > Codeˉbytes - Patchˉoffset { return Invalidˉregions(Input); }
        if Relocation > 0u32 {
            if Patchˉoffset < Previousˉoffset + 4u32 {
                return Invalidˉregions(Input);
            }
        }
        Previousˉoffset = Patchˉoffset;
        Relocation = Relocation + 1u32;
    }

    var Sectionˉcount: u32 = 1u32;
    var Symbolˉcount: u32 = Functionˉcount;
    if Data.Count > 0u32 {
        Sectionˉcount = 2u32;
        Symbolˉcount = Symbolˉcount + Data.Count;
    }
    var Header: bytes = Textˉtoˉutf8("WVO1");
    Header = Bytesˉconcat(Header, Bytesˉfromˉu16ˉlittle(1u32));
    Header = Bytesˉconcat(Header, Bytesˉfromˉu16ˉlittle(0u32));
    Header = Bytesˉconcat(Header, Bytesˉfromˉu8(1u8));
    Header = Bytesˉconcat(Header, Bytesˉfromˉu8(0u8));
    Header = Bytesˉconcat(Header, Bytesˉfromˉu16ˉlittle(0u32));
    Header = Bytesˉconcat(Header, Bytesˉfromˉu32ˉlittle(Sectionˉcount));
    Header = Bytesˉconcat(Header, Bytesˉfromˉu32ˉlittle(Symbolˉcount));
    Header = Bytesˉconcat(Header, Bytesˉfromˉu32ˉlittle(Relocationˉcount));

    let Textˉsectionˉheader: bytes = Sectionˉheader(
        1u8,
        ".text",
        Codeˉbytes + Bytesˉlength(Padding)
    );
    var Readˉonlyˉheader: bytes = Empty(Input);
    var Symbols: bytes = Empty(Input);
    if Data.Count > 0u32 {
        Readˉonlyˉheader = Sectionˉheader(
            2u8,
            ".rodata",
            Bytesˉlength(Data.Bytes)
        );
        Dataˉindex = 0u32;
        while Dataˉindex < Data.Count {
            Symbols = Bytesˉconcat(Symbols, Symbolˉrecord(
                1u8,
                2u8,
                1u32,
                Staticˉdata.Compilerˉnativeˉx64ˉdataˉoffset(Data, Dataˉindex),
                Staticˉdata.Compilerˉnativeˉx64ˉdataˉsize(Data, Dataˉindex),
                Dataˉsymbolˉname(Dataˉindex)
            ));
            Dataˉindex = Dataˉindex + 1u32;
        }
    }

    var Function: u32 = 0u32;
    while Function < Functionˉcount {
        if Function != Mainˉfunction {
            Symbols = Bytesˉconcat(Symbols, Symbolˉrecord(
                1u8,
                1u8,
                0u32,
                Layout.Compilerˉnativeˉx64ˉlayoutˉmachineˉoffset(
                    Directory,
                    Function
                ),
                Layout.Compilerˉnativeˉx64ˉlayoutˉmachineˉlength(
                    Directory,
                    Function
                ),
                Layout.Compilerˉnativeˉx64ˉlayoutˉhelperˉname(Function)
            ));
        }
        Function = Function + 1u32;
    }
    Symbols = Bytesˉconcat(Symbols, Symbolˉrecord(
        2u8,
        1u8,
        0u32,
        Layout.Compilerˉnativeˉx64ˉlayoutˉmachineˉoffset(
            Directory,
            Mainˉfunction
        ),
        Layout.Compilerˉnativeˉx64ˉlayoutˉmachineˉlength(
            Directory,
            Mainˉfunction
        ),
        Textˉtoˉutf8("Main")
    ));

    var Relocationˉrecords: bytes = Empty(Input);
    Relocation = 0u32;
    while Relocation < Relocationˉcount {
        Relocationˉrecords = Bytesˉconcat(
            Relocationˉrecords,
            Relocationˉrecord(Relocations, Relocation)
        );
        Relocation = Relocation + 1u32;
    }
    let Prefix: bytes = Bytesˉconcat(Header, Textˉsectionˉheader);
    let Objectˉbytes: u32 = Bytesˉlength(Prefix) + Codeˉbytes +
        Bytesˉlength(Padding) + Bytesˉlength(Readˉonlyˉheader) +
        Bytesˉlength(Data.Bytes) + Bytesˉlength(Symbols) +
        Bytesˉlength(Relocationˉrecords);
    return Compilerˉnativeˉx64ˉobjectˉregions(
        true,
        Prefix,
        Readˉonlyˉheader,
        Symbols,
        Relocationˉrecords,
        Objectˉbytes
    );
}

export fn Compilerˉnativeˉx64ˉobjectˉemit(
    Code: bytes,
    Padding: bytes,
    Directory: bytes,
    Functionˉcount: u32,
    Mainˉfunction: u32,
    Data: Staticˉdata.Compilerˉnativeˉx64ˉdata,
    Relocations: bytes
) -> bytes {
    let Regions: Compilerˉnativeˉx64ˉobjectˉregions =
        Compilerˉnativeˉx64ˉobjectˉplan(
            Code,
            Bytesˉlength(Code),
            Padding,
            Directory,
            Functionˉcount,
            Mainˉfunction,
            Data,
            Relocations
        );
    if !Regions.Valid { return Empty(Code); }
    var Relocation: u32 = 0u32;
    while Relocation < Bytesˉlength(Relocations) / 8u32 {
        let Patchˉoffset: u32 = Bytesˉreadˉu32ˉlittle(
            Relocations,
            Relocation * 8u32
        );
        if Bytesˉreadˉu32ˉlittle(Code, Patchˉoffset) != 0u32 {
            return Empty(Code);
        }
        Relocation = Relocation + 1u32;
    }
    let Body: bytes = Objectˉbody(
        Code,
        Padding,
        Regions.Readˉonlyˉheader,
        Data.Bytes,
        Regions.Symbols,
        Regions.Relocationˉrecords
    );
    let Result: bytes = Bytesˉconcat(Regions.Prefix, Body);
    if Bytesˉlength(Result) != Regions.Objectˉbytes { return Empty(Code); }
    return Result;
}
