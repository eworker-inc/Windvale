}
Removed = Compilerˉsourceˉgraphˉmark(Removed, Selected);
Removedˉcount = Removedˉcount + 1u32;
}
return Compilerˉsourceˉgraphˉsummary(
Compilerˉsourceˉgraphˉstatus.Valid,
Sourceˉset.Compilerˉsourceˉsetˉstatus.Valid,
Scan.Modules,
Imports,
Reachable,
Scan.Modules,
Scan.Modules,
Bytesˉlength(Input),
0u32,
0u32
);
}
