module Compilerˉsourceˉset profile portable;

import Compilerˉsourceˉbodyˉparser as Sourceˉbodies;
import Compilerˉsourceˉdeclarationˉparser as Sourceˉdeclarations;
import Compilerˉsourceˉdescriptor as Sourceˉdescriptor;
import Compilerˉsourceˉlexer as Sourceˉlexer;

export enum Compilerˉsourceˉsetˉstatus {
    Valid = 0;
    Tooˉshort = 1;
    Invalidˉmagic = 2;
    Unsupportedˉversion = 3;
    Invalidˉcount = 4;
    Invalidˉdirectory = 5;
    Invalidˉentry = 6;
    Noncanonicalˉlayout = 7;
    Sourceˉsyntax = 8;
    Bodyˉsyntax = 9;
    Duplicateˉmodule = 10;
    Dependencyˉorder = 11;
    Dependencyˉprofile = 12;
    Dependencyˉshape = 13;
    Privateˉdependencyˉfunction = 14;
    Sourceˉdescriptor = 15;
    Unsupportedˉsourceˉprofile = 16;
    Sourceˉedition = 17;
}

export record Compilerˉsourceˉsetˉscan {
    Status: Compilerˉsourceˉsetˉstatus;
    Version: u32;
    Modules: u32;
    Directoryˉoffset: u32;
    Directoryˉlength: u32;
    Sourcesˉoffset: u32;
    Sourceˉbytes: u32;
    Failureˉoffset: u32;
    Failureˉmodule: u32;
}

export record Compilerˉsourceˉsetˉview {
    Status: Compilerˉsourceˉsetˉstatus;
    Index: u32;
    Offset: u32;
    Length: u32;
    Edition: u32;
    Profileˉbinding: Sourceˉdescriptor.Compilerˉsourceˉprofileˉbinding;
    Originˉoffset: u32;
    Failureˉoffset: u32;
    Source: bytes;
}

export record Compilerˉsourceˉsetˉsummary {
    Status: Compilerˉsourceˉsetˉstatus;
    Modules: u32;
    Sourceˉbytes: u32;
    Imports: u32;
    Records: u32;
    Enums: u32;
    Functions: u32;
    Failureˉmodule: u32;
    Failureˉoffset: u32;
    Failureˉline: u32;
    Failureˉcolumn: u32;
    Parseˉstatus: Sourceˉdeclarations.Compilerˉparseˉstatus;
    Bodyˉstatus: Sourceˉbodies.Compilerˉbodyˉparseˉstatus;
}

export fn Compilerˉsourceˉsetˉscanˉfailure(
    Status: Compilerˉsourceˉsetˉstatus,
    Offset: u32,
    Module: u32
) -> Compilerˉsourceˉsetˉscan {
    return Compilerˉsourceˉsetˉscan(
        Status, 0u32, 0u32, 16u32, 0u32, 0u32, 0u32, Offset, Module
    );
}

export fn Compilerˉsourceˉsetˉscanˉvalid(
    Version: u32,
    Modules: u32,
    Directoryˉlength: u32,
    Sourcesˉoffset: u32,
    Sourceˉbytes: u32
) -> Compilerˉsourceˉsetˉscan {
    return Compilerˉsourceˉsetˉscan(
        Compilerˉsourceˉsetˉstatus.Valid,
        Version,
        Modules,
        16u32,
        Directoryˉlength,
        Sourcesˉoffset,
        Sourceˉbytes,
        Sourcesˉoffset + Sourceˉbytes,
        Modules
    );
}

export fn Compilerˉscanˉsourceˉset(Input: bytes) -> Compilerˉsourceˉsetˉscan {
    let Total: u32 = Bytesˉlength(Input);
    if Total < 16u32 {
        return Compilerˉsourceˉsetˉscanˉfailure(Compilerˉsourceˉsetˉstatus.Tooˉshort, Total, 0u32);
    }
    if Bytesˉreadˉu8(Input, 0u32) != 87u8 {
        return Compilerˉsourceˉsetˉscanˉfailure(Compilerˉsourceˉsetˉstatus.Invalidˉmagic, 0u32, 0u32);
    }
    if Bytesˉreadˉu8(Input, 1u32) != 86u8 {
        return Compilerˉsourceˉsetˉscanˉfailure(Compilerˉsourceˉsetˉstatus.Invalidˉmagic, 1u32, 0u32);
    }
    if Bytesˉreadˉu8(Input, 2u32) != 83u8 {
        return Compilerˉsourceˉsetˉscanˉfailure(Compilerˉsourceˉsetˉstatus.Invalidˉmagic, 2u32, 0u32);
    }
    if Bytesˉreadˉu8(Input, 3u32) != 83u8 {
        return Compilerˉsourceˉsetˉscanˉfailure(Compilerˉsourceˉsetˉstatus.Invalidˉmagic, 3u32, 0u32);
    }
    let Version: u32 = Bytesˉreadˉu16ˉlittle(Input, 4u32);
    if Version != 1u32 && Version != 2u32 {
        return Compilerˉsourceˉsetˉscanˉfailure(Compilerˉsourceˉsetˉstatus.Unsupportedˉversion, 4u32, 0u32);
    }
    if Bytesˉreadˉu16ˉlittle(Input, 6u32) != 0u32 {
        return Compilerˉsourceˉsetˉscanˉfailure(Compilerˉsourceˉsetˉstatus.Unsupportedˉversion, 6u32, 0u32);
    }

    let Modules: u32 = Bytesˉreadˉu32ˉlittle(Input, 8u32);
    if Modules == 0u32 {
        return Compilerˉsourceˉsetˉscanˉfailure(Compilerˉsourceˉsetˉstatus.Invalidˉcount, 8u32, 0u32);
    }
    if Modules > 64u32 {
        return Compilerˉsourceˉsetˉscanˉfailure(Compilerˉsourceˉsetˉstatus.Invalidˉcount, 8u32, 64u32);
    }
    var Entryˉbytes: u32 = 8u32;
    if Version == 2u32 { Entryˉbytes = 20u32; }
    let Requiredˉdirectory: u32 = Modules * Entryˉbytes;
    let Directoryˉlength: u32 = Bytesˉreadˉu32ˉlittle(Input, 12u32);
    if Directoryˉlength != Requiredˉdirectory {
        return Compilerˉsourceˉsetˉscanˉfailure(Compilerˉsourceˉsetˉstatus.Invalidˉdirectory, 12u32, 0u32);
    }
    if Directoryˉlength > Total - 16u32 {
        return Compilerˉsourceˉsetˉscanˉfailure(Compilerˉsourceˉsetˉstatus.Invalidˉdirectory, 12u32, 0u32);
    }

    var Expectedˉoffset: u32 = 16u32 + Directoryˉlength;
    var Index: u32 = 0u32;
    var Sourceˉbytes: u32 = 0u32;
    while Index < Modules {
        let Entryˉoffset: u32 = 16u32 + Index * Entryˉbytes;
        let Offset: u32 = Bytesˉreadˉu32ˉlittle(Input, Entryˉoffset);
        let Length: u32 = Bytesˉreadˉu32ˉlittle(Input, Entryˉoffset + 4u32);
        if Version == 2u32 {
            let Edition: u32 = Bytesˉreadˉu32ˉlittle(Input, Entryˉoffset + 8u32);
            let Binding: u32 = Bytesˉreadˉu32ˉlittle(Input, Entryˉoffset + 12u32);
            let Origin: u32 = Bytesˉreadˉu32ˉlittle(Input, Entryˉoffset + 16u32);
            if Edition != 1u32 || Binding != 1u32 || Origin == 0u32 || Origin > 129u32 {
                return Compilerˉsourceˉsetˉscanˉfailure(
                    Compilerˉsourceˉsetˉstatus.Invalidˉentry,
                    Entryˉoffset + 8u32,
                    Index
                );
            }
        }
        if Offset != Expectedˉoffset {
            return Compilerˉsourceˉsetˉscanˉfailure(
                Compilerˉsourceˉsetˉstatus.Noncanonicalˉlayout,
                Entryˉoffset,
                Index
            );
        }
        if Length == 0u32 {
            return Compilerˉsourceˉsetˉscanˉfailure(
                Compilerˉsourceˉsetˉstatus.Invalidˉentry,
                Entryˉoffset + 4u32,
                Index
            );
        }
        if Offset > Total {
            return Compilerˉsourceˉsetˉscanˉfailure(
                Compilerˉsourceˉsetˉstatus.Invalidˉentry,
                Entryˉoffset,
                Index
            );
        }
        if Length > Total - Offset {
            return Compilerˉsourceˉsetˉscanˉfailure(
                Compilerˉsourceˉsetˉstatus.Invalidˉentry,
                Entryˉoffset + 4u32,
                Index
            );
        }
        Expectedˉoffset = Offset + Length;
        Sourceˉbytes = Sourceˉbytes + Length;
        Index = Index + 1u32;
    }
    if Expectedˉoffset != Total {
        return Compilerˉsourceˉsetˉscanˉfailure(
            Compilerˉsourceˉsetˉstatus.Noncanonicalˉlayout,
            Expectedˉoffset,
            Modules
        );
    }
    return Compilerˉsourceˉsetˉscanˉvalid(
        Version,
        Modules,
        Directoryˉlength,
        16u32 + Directoryˉlength,
        Sourceˉbytes
    );
}

export fn Compilerˉsourceˉsetˉviewˉfailure(
    Status: Compilerˉsourceˉsetˉstatus,
    Index: u32,
    Input: bytes
) -> Compilerˉsourceˉsetˉview {
    return Compilerˉsourceˉsetˉview(
        Status,
        Index,
        0u32,
        0u32,
        0u32,
        Sourceˉdescriptor.Compilerˉsourceˉprofileˉbinding.None,
        0u32,
        0u32,
        Bytesˉslice(Input, 0u32, 0u32)
    );
}

export fn Compilerˉsourceˉsetˉsourceˉfailure(
    Status: Compilerˉsourceˉsetˉstatus,
    Index: u32,
    Offset: u32,
    Length: u32,
    Failureˉoffset: u32,
    Input: bytes
) -> Compilerˉsourceˉsetˉview {
    return Compilerˉsourceˉsetˉview(
        Status,
        Index,
        Offset,
        Length,
        1u32,
        Sourceˉdescriptor.Compilerˉsourceˉprofileˉbinding.None,
        0u32,
        Failureˉoffset,
        Bytesˉslice(Input, Offset, Length)
    );
}

export fn Compilerˉsourceˉsetˉmodule(
    Input: bytes,
    Scan: Compilerˉsourceˉsetˉscan,
    Index: u32
) -> Compilerˉsourceˉsetˉview {
    if Scan.Status != Compilerˉsourceˉsetˉstatus.Valid {
        return Compilerˉsourceˉsetˉviewˉfailure(Scan.Status, Index, Input);
    }
    if Index >= Scan.Modules {
        return Compilerˉsourceˉsetˉviewˉfailure(Compilerˉsourceˉsetˉstatus.Invalidˉcount, Index, Input);
    }
    var Entryˉbytes: u32 = 8u32;
    if Scan.Version == 2u32 { Entryˉbytes = 20u32; }
    let Entryˉoffset: u32 = Scan.Directoryˉoffset + Index * Entryˉbytes;
    let Offset: u32 = Bytesˉreadˉu32ˉlittle(Input, Entryˉoffset);
    let Length: u32 = Bytesˉreadˉu32ˉlittle(Input, Entryˉoffset + 4u32);
    let Rawˉsource: bytes = Bytesˉslice(Input, Offset, Length);
    if Scan.Version == 2u32 {
        let Edition: u32 = Bytesˉreadˉu32ˉlittle(Input, Entryˉoffset + 8u32);
        let Bindingˉvalue: u32 = Bytesˉreadˉu32ˉlittle(Input, Entryˉoffset + 12u32);
        let Origin: u32 = Bytesˉreadˉu32ˉlittle(Input, Entryˉoffset + 16u32);
        var Binding: Sourceˉdescriptor.Compilerˉsourceˉprofileˉbinding =
            Sourceˉdescriptor.Compilerˉsourceˉprofileˉbinding.None;
        if Bindingˉvalue == 1u32 {
            Binding = Sourceˉdescriptor.Compilerˉsourceˉprofileˉbinding.English;
        }
        return Compilerˉsourceˉsetˉview(
            Compilerˉsourceˉsetˉstatus.Valid,
            Index,
            Offset,
            Length,
            Edition,
            Binding,
            Origin,
            Origin + Length,
            Rawˉsource
        );
    }
    if Bytesˉreadˉu8(Rawˉsource, 0u32) == 35u8 {
        let Descriptor: Sourceˉdescriptor.Compilerˉsourceˉdescriptor =
            Sourceˉdescriptor.Compilerˉreadˉsourceˉdescriptor(Rawˉsource);
        if Descriptor.Status != Sourceˉdescriptor.Compilerˉsourceˉdescriptorˉstatus.Valid {
            return Compilerˉsourceˉsetˉsourceˉfailure(
                Compilerˉsourceˉsetˉstatus.Sourceˉdescriptor,
                Index,
                Offset,
                Length,
                Descriptor.Failureˉoffset,
                Input
            );
        }
        return Compilerˉsourceˉsetˉsourceˉfailure(
            Compilerˉsourceˉsetˉstatus.Unsupportedˉsourceˉprofile,
            Index,
            Offset,
            Length,
            Descriptor.Profileˉoffset,
            Input
        );
    }
    return Compilerˉsourceˉsetˉview(
        Compilerˉsourceˉsetˉstatus.Valid,
        Index,
        Offset,
        Length,
        0u32,
        Sourceˉdescriptor.Compilerˉsourceˉprofileˉbinding.None,
        0u32,
        Length,
        Rawˉsource
    );
}

export fn Compilerˉsourceˉspansˉcompare(
    Left: bytes,
    Leftˉoffset: u32,
    Leftˉlength: u32,
    Right: bytes,
    Rightˉoffset: u32,
    Rightˉlength: u32
) -> i32 {
    var Limit: u32 = Leftˉlength;
    if Rightˉlength < Limit { Limit = Rightˉlength; }
    var Index: u32 = 0u32;
    while Index < Limit {
        let Leftˉvalue: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(Left, Leftˉoffset + Index));
        let Rightˉvalue: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(Right, Rightˉoffset + Index));
        if Leftˉvalue < Rightˉvalue { return -1; }
        if Leftˉvalue > Rightˉvalue { return 1; }
        Index = Index + 1u32;
    }
    if Leftˉlength < Rightˉlength { return -1; }
    if Leftˉlength > Rightˉlength { return 1; }
    return 0;
}

export fn Compilerˉsourceˉspansˉequal(
    Left: bytes,
    Leftˉoffset: u32,
    Leftˉlength: u32,
    Right: bytes,
    Rightˉoffset: u32,
    Rightˉlength: u32
) -> bool {
    if Leftˉlength != Rightˉlength { return false; }
    var Remaining: u32 = Leftˉlength;
    while Remaining > 0u32 {
        let Index: u32 = Remaining - 1u32;
        if Bytesˉreadˉu8(Left, Leftˉoffset + Index) !=
            Bytesˉreadˉu8(Right, Rightˉoffset + Index) {
            return false;
        }
        Remaining = Index;
    }
    return true;
}

export fn Compilerˉsourceˉsetˉeditionˉtokenˉisˉallowed(
    Edition: u32,
    Kind: Sourceˉlexer.Compilerˉtokenˉkind
) -> bool {
    if Edition == 1u32 {
        if Kind == Sourceˉlexer.Compilerˉtokenˉkind.Void { return false; }
        if Kind == Sourceˉlexer.Compilerˉtokenˉkind.Portable { return false; }
        if Kind == Sourceˉlexer.Compilerˉtokenˉkind.Length { return false; }
        if Kind == Sourceˉlexer.Compilerˉtokenˉkind.Sequence { return false; }
        if Kind == Sourceˉlexer.Compilerˉtokenˉkind.Builder { return false; }
        if Kind == Sourceˉlexer.Compilerˉtokenˉkind.Freeze { return false; }
        if Kind == Sourceˉlexer.Compilerˉtokenˉkind.Push { return false; }
        return true;
    }
    if Edition == 0u32 {
        if Kind == Sourceˉlexer.Compilerˉtokenˉkind.Unit { return false; }
        if Kind == Sourceˉlexer.Compilerˉtokenˉkind.Never { return false; }
        if Kind == Sourceˉlexer.Compilerˉtokenˉkind.I8 { return false; }
        if Kind == Sourceˉlexer.Compilerˉtokenˉkind.I16 { return false; }
        if Kind == Sourceˉlexer.Compilerˉtokenˉkind.U16 { return false; }
        if Kind == Sourceˉlexer.Compilerˉtokenˉkind.F32 { return false; }
        if Kind == Sourceˉlexer.Compilerˉtokenˉkind.F64 { return false; }
        if Kind == Sourceˉlexer.Compilerˉtokenˉkind.Rune { return false; }
        if Kind == Sourceˉlexer.Compilerˉtokenˉkind.Base { return false; }
        if Kind == Sourceˉlexer.Compilerˉtokenˉkind.Effects { return false; }
        if Kind == Sourceˉlexer.Compilerˉtokenˉkind.Using { return false; }
        return true;
    }
    return false;
}

export fn Compilerˉsourceˉsetˉfirstˉinvalidˉeditionˉtoken(
    Source: bytes,
    Edition: u32
) -> Sourceˉlexer.Compilerˉsourceˉtoken {
    var Current: Sourceˉlexer.Compilerˉsourceˉtoken =
        Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(Source, 0u32, 1u32, 1u32);
    var Reading: bool = true;
    while Reading {
        if Current.Status != Sourceˉlexer.Compilerˉlexˉstatus.Valid {
            Reading = false;
        } else if Current.Kind == Sourceˉlexer.Compilerˉtokenˉkind.End {
            Reading = false;
        } else {
            if !Compilerˉsourceˉsetˉeditionˉtokenˉisˉallowed(Edition, Current.Kind) {
                return Current;
            }
            Current = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                Source, Current.Nextˉoffset, Current.Nextˉline, Current.Nextˉcolumn
            );
        }
    }
    return Current;
}

export fn Compilerˉsourceˉsetˉsummaryˉfailure(
    Status: Compilerˉsourceˉsetˉstatus,
    Modules: u32,
    Sourceˉbytes: u32,
    Module: u32,
    Offset: u32,
    Line: u32,
    Column: u32,
    Parseˉstatus: Sourceˉdeclarations.Compilerˉparseˉstatus,
    Bodyˉstatus: Sourceˉbodies.Compilerˉbodyˉparseˉstatus
) -> Compilerˉsourceˉsetˉsummary {
    return Compilerˉsourceˉsetˉsummary(
        Status,
        Modules,
        Sourceˉbytes,
        0u32,
        0u32,
        0u32,
        0u32,
        Module,
        Offset,
        Line,
        Column,
        Parseˉstatus,
        Bodyˉstatus
    );
}

export fn Compilerˉsourceˉsetˉsummaryˉfromˉscan(
    Scan: Compilerˉsourceˉsetˉscan
) -> Compilerˉsourceˉsetˉsummary {
    return Compilerˉsourceˉsetˉsummaryˉfailure(
        Scan.Status,
        Scan.Modules,
        Scan.Sourceˉbytes,
        Scan.Failureˉmodule,
        Scan.Failureˉoffset,
        0u32,
        0u32,
        Sourceˉdeclarations.Compilerˉparseˉstatus.Valid,
        Sourceˉbodies.Compilerˉbodyˉparseˉstatus.Valid
    );
}

export fn Compilerˉvalidateˉsourceˉset(Input: bytes) -> Compilerˉsourceˉsetˉsummary {
    let Scan: Compilerˉsourceˉsetˉscan = Compilerˉscanˉsourceˉset(Input);
    if Scan.Status != Compilerˉsourceˉsetˉstatus.Valid {
        return Compilerˉsourceˉsetˉsummaryˉfromˉscan(Scan);
    }

    var Index: u32 = 0u32;
    var Imports: u32 = 0u32;
    var Records: u32 = 0u32;
    var Enums: u32 = 0u32;
    var Functions: u32 = 0u32;
    while Index < Scan.Modules {
        let View: Compilerˉsourceˉsetˉview = Compilerˉsourceˉsetˉmodule(Input, Scan, Index);
        if View.Status != Compilerˉsourceˉsetˉstatus.Valid {
            return Compilerˉsourceˉsetˉsummaryˉfailure(
                View.Status,
                Scan.Modules,
                Scan.Sourceˉbytes,
                Index,
                View.Failureˉoffset,
                1u32,
                View.Failureˉoffset + 1u32,
                Sourceˉdeclarations.Compilerˉparseˉstatus.Valid,
                Sourceˉbodies.Compilerˉbodyˉparseˉstatus.Valid
            );
        }
        let Source: bytes = View.Source;
        let Invalidˉeditionˉtoken: Sourceˉlexer.Compilerˉsourceˉtoken =
            Compilerˉsourceˉsetˉfirstˉinvalidˉeditionˉtoken(Source, View.Edition);
        if Invalidˉeditionˉtoken.Status == Sourceˉlexer.Compilerˉlexˉstatus.Valid &&
            Invalidˉeditionˉtoken.Kind != Sourceˉlexer.Compilerˉtokenˉkind.End {
            return Compilerˉsourceˉsetˉsummaryˉfailure(
                Compilerˉsourceˉsetˉstatus.Sourceˉedition,
                Scan.Modules,
                Scan.Sourceˉbytes,
                Index,
                View.Originˉoffset + Invalidˉeditionˉtoken.Offset,
                Invalidˉeditionˉtoken.Line,
                Invalidˉeditionˉtoken.Column,
                Sourceˉdeclarations.Compilerˉparseˉstatus.Valid,
                Sourceˉbodies.Compilerˉbodyˉparseˉstatus.Valid
            );
        }
        let Parsed: Sourceˉdeclarations.Compilerˉsourceˉmoduleˉsummary = Sourceˉdeclarations.Compilerˉparseˉsource(Source);
        if Parsed.Status != Sourceˉdeclarations.Compilerˉparseˉstatus.Valid {
            return Compilerˉsourceˉsetˉsummaryˉfailure(
                Compilerˉsourceˉsetˉstatus.Sourceˉsyntax,
                Scan.Modules,
                Scan.Sourceˉbytes,
                Index,
                View.Originˉoffset + Parsed.Failureˉoffset,
                Parsed.Failureˉline,
                Parsed.Failureˉcolumn,
                Parsed.Status,
                Sourceˉbodies.Compilerˉbodyˉparseˉstatus.Valid
            );
        }
        let Bodies: Sourceˉbodies.Compilerˉsourceˉbodyˉsummary =
            Sourceˉbodies.Compilerˉparseˉsourceˉbodiesˉfromˉdeclarations(Source, Parsed);
        if Bodies.Status != Sourceˉbodies.Compilerˉbodyˉparseˉstatus.Valid {
            return Compilerˉsourceˉsetˉsummaryˉfailure(
                Compilerˉsourceˉsetˉstatus.Bodyˉsyntax,
                Scan.Modules,
                Scan.Sourceˉbytes,
                Index,
                View.Originˉoffset + Bodies.Failureˉoffset,
                Bodies.Failureˉline,
                Bodies.Failureˉcolumn,
                Sourceˉdeclarations.Compilerˉparseˉstatus.Valid,
                Bodies.Status
            );
        }
        let Header: Sourceˉdeclarations.Compilerˉsourceˉheader = Sourceˉdeclarations.Compilerˉparseˉheaderˉvalidated(Source);
        let Nameˉposition: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
            Source,
            0u32,
            1u32,
            1u32,
            Header.Nameˉoffset
        );
        let Standaloneˉprofile: bool =
            Sourceˉdeclarations.Compilerˉsourceˉusesˉstandaloneˉprofile(Source);
        if View.Edition == 1u32 && !Standaloneˉprofile {
            return Compilerˉsourceˉsetˉsummaryˉfailure(
                Compilerˉsourceˉsetˉstatus.Sourceˉedition,
                Scan.Modules,
                Scan.Sourceˉbytes,
                Index,
                View.Originˉoffset + Header.Nameˉoffset,
                Nameˉposition.Line,
                Nameˉposition.Column,
                Sourceˉdeclarations.Compilerˉparseˉstatus.Valid,
                Sourceˉbodies.Compilerˉbodyˉparseˉstatus.Valid
            );
        }
        if View.Edition == 0u32 && Standaloneˉprofile {
            return Compilerˉsourceˉsetˉsummaryˉfailure(
                Compilerˉsourceˉsetˉstatus.Sourceˉedition,
                Scan.Modules,
                Scan.Sourceˉbytes,
                Index,
                Header.Nameˉoffset,
                Nameˉposition.Line,
                Nameˉposition.Column,
                Sourceˉdeclarations.Compilerˉparseˉstatus.Valid,
                Sourceˉbodies.Compilerˉbodyˉparseˉstatus.Valid
            );
        }

        var Previous: u32 = 0u32;
        while Previous < Index {
            let Previousˉview: Compilerˉsourceˉsetˉview = Compilerˉsourceˉsetˉmodule(Input, Scan, Previous);
            let Previousˉheader: Sourceˉdeclarations.Compilerˉsourceˉheader = Sourceˉdeclarations.Compilerˉparseˉheaderˉvalidated(Previousˉview.Source);
            if Compilerˉsourceˉspansˉequal(
                Previousˉview.Source,
                Previousˉheader.Nameˉoffset,
                Previousˉheader.Nameˉlength,
                Source,
                Header.Nameˉoffset,
                Header.Nameˉlength
            ) {
                return Compilerˉsourceˉsetˉsummaryˉfailure(
                    Compilerˉsourceˉsetˉstatus.Duplicateˉmodule,
                    Scan.Modules,
                    Scan.Sourceˉbytes,
                    Index,
                    View.Originˉoffset + Header.Nameˉoffset,
                    Nameˉposition.Line,
                    Nameˉposition.Column,
                    Sourceˉdeclarations.Compilerˉparseˉstatus.Valid,
                    Sourceˉbodies.Compilerˉbodyˉparseˉstatus.Valid
                );
            }
            Previous = Previous + 1u32;
        }

        if Index > 1u32 {
            let Priorˉview: Compilerˉsourceˉsetˉview = Compilerˉsourceˉsetˉmodule(Input, Scan, Index - 1u32);
            let Priorˉheader: Sourceˉdeclarations.Compilerˉsourceˉheader = Sourceˉdeclarations.Compilerˉparseˉheaderˉvalidated(Priorˉview.Source);
            if Compilerˉsourceˉspansˉcompare(
                Priorˉview.Source,
                Priorˉheader.Nameˉoffset,
                Priorˉheader.Nameˉlength,
                Source,
                Header.Nameˉoffset,
                Header.Nameˉlength
            ) >= 0 {
                return Compilerˉsourceˉsetˉsummaryˉfailure(
                    Compilerˉsourceˉsetˉstatus.Dependencyˉorder,
                    Scan.Modules,
                    Scan.Sourceˉbytes,
                    Index,
                    View.Originˉoffset + Header.Nameˉoffset,
                    Nameˉposition.Line,
                    Nameˉposition.Column,
                    Sourceˉdeclarations.Compilerˉparseˉstatus.Valid,
                    Sourceˉbodies.Compilerˉbodyˉparseˉstatus.Valid
                );
            }
        }

        Imports = Imports + Parsed.Imports;
        Records = Records + Parsed.Records;
        Enums = Enums + Parsed.Enums;
        Functions = Functions + Parsed.Functions;
        Index = Index + 1u32;
    }

    return Compilerˉsourceˉsetˉsummary(
        Compilerˉsourceˉsetˉstatus.Valid,
        Scan.Modules,
        Scan.Sourceˉbytes,
        Imports,
        Records,
        Enums,
        Functions,
        Scan.Modules,
        Bytesˉlength(Input),
        0u32,
        0u32,
        Sourceˉdeclarations.Compilerˉparseˉstatus.Valid,
        Sourceˉbodies.Compilerˉbodyˉparseˉstatus.Valid
    );
}
