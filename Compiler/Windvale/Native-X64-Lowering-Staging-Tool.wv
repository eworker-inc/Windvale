module Compilerˉnativeˉx64ˉloweringˉstagingˉtool profile hosted;

import Compilerˉnativeˉx64ˉlowering as Nativeˉx64;
import Compilerˉnativeˉx64ˉloweringˉpublication as Publication;
import Compilerˉnativeˉx64ˉloweringˉstagingˉmanifest as Manifest;

capability console.write_line;
capability diagnostic.write_line;
capability file.read_bytes;
capability file.write_bytes;
capability process.argument;
capability process.argument_count;

const STAGING_RESOURCE_BYTES: u32 = 1310720u32;

record Stagingˉchunkˉwrite {
    Valid: bool;
    Position: u32;
    Length: u32;
    Steps: u32;
    Nextˉvalid: bool;
    Nextˉkind: Publication.Compilerˉnativeˉx64ˉpublicationˉkind;
    Nextˉfunction: u32;
    Nextˉposition: u32;
}

fn Empty(Input: bytes) -> bytes {
    return Bytesˉslice(Input, 0u32, 0u32);
}

fn Appendˉu32(Output: bytes, Value: u32) -> bytes {
    return Bytesˉconcat(Output, Bytesˉfromˉu32ˉlittle(Value));
}

fn Pathsˉareˉequal(First: text, Second: text) -> bool {
    let Firstˉbytes: bytes = Textˉtoˉutf8(First);
    let Secondˉbytes: bytes = Textˉtoˉutf8(Second);
    let Length: u32 = Bytesˉlength(Firstˉbytes);
    if Length != Bytesˉlength(Secondˉbytes) { return false; }
    var Index: u32 = 0u32;
    while Index < Length {
        if Bytesˉreadˉu8(Firstˉbytes, Index) !=
            Bytesˉreadˉu8(Secondˉbytes, Index) {
            return false;
        }
        Index = Index + 1u32;
    }
    return true;
}

fn Chunkˉresource(Prefix: text, Index: u32) -> text {
    return Textˉconcat(
        Textˉconcat(Prefix, ".chunk-"),
        U32ˉformat(Index)
    );
}

fn Failure(Status: Nativeˉx64.Compilerˉnativeˉx64ˉstatus) -> i32 {
    diagnostic.write_line(
        Textˉconcat("native x64 staging status=", Enumˉname(Status))
    );
    return 1;
}

fn Invalidˉchunkˉwrite(
    Cursor: Publication.Compilerˉnativeˉx64ˉpublicationˉcursor
) -> Stagingˉchunkˉwrite {
    return Stagingˉchunkˉwrite(
        false,
        0u32,
        0u32,
        0u32,
        Cursor.Valid,
        Cursor.Kind,
        Cursor.Nextˉfunction,
        Cursor.Position
    );
}

fn Completedˉchunkˉwrite(
    Position: u32,
    Length: u32,
    Steps: u32,
    Cursor: Publication.Compilerˉnativeˉx64ˉpublicationˉcursor
) -> Stagingˉchunkˉwrite {
    return Stagingˉchunkˉwrite(
        true,
        Position,
        Length,
        Steps,
        Cursor.Valid,
        Cursor.Kind,
        Cursor.Nextˉfunction,
        Cursor.Position
    );
}

fn Cursorˉafter(
    Step: Publication.Compilerˉnativeˉx64ˉpublicationˉstep
) -> Publication.Compilerˉnativeˉx64ˉpublicationˉcursor {
    return Publication.Compilerˉnativeˉx64ˉpublicationˉcursor(
        Step.Nextˉvalid,
        Step.Nextˉkind,
        Step.Nextˉfunction,
        Step.Nextˉposition
    );
}

fn Writeˉnextˉchunk(
    Input: bytes,
    Plan: Nativeˉx64.Compilerˉnativeˉx64ˉplan,
    Regions: Publication.Compilerˉnativeˉx64ˉpublicationˉregions,
    Initial: Publication.Compilerˉnativeˉx64ˉpublicationˉcursor,
    Resource: text
) -> Stagingˉchunkˉwrite {
    var Cursor: Publication.Compilerˉnativeˉx64ˉpublicationˉcursor = Initial;
    var Pending: bytes = Empty(Input);
    var Pendingˉposition: u32 = 0u32;
    var Steps: u32 = 0u32;
    while Steps <= Plan.Functionˉcount + 7u32 {
        let Step: Publication.Compilerˉnativeˉx64ˉpublicationˉstep =
            Publication.Compilerˉnativeˉx64ˉpublicationˉnext(
                Input,
                Plan,
                Regions,
                Cursor,
                4194304u32
            );
        let Pendingˉbytes: u32 = Bytesˉlength(Pending);
        if Step.Status ==
            Publication.Compilerˉnativeˉx64ˉpublicationˉstatus.Complete {
            if Pendingˉbytes == 0u32 {
                return Invalidˉchunkˉwrite(Cursor);
            }
            file.write_bytes(Resource, Pending);
            return Completedˉchunkˉwrite(
                Pendingˉposition,
                Pendingˉbytes,
                Steps,
                Cursor
            );
        }
        if Step.Status !=
                Publication.Compilerˉnativeˉx64ˉpublicationˉstatus.Valid ||
            !Step.Nextˉvalid {
            return Invalidˉchunkˉwrite(Cursor);
        }

        let Length: u32 = Bytesˉlength(Step.Value);
        if Length == 0u32 {
            Cursor = Cursorˉafter(Step);
            Steps = Steps + 1u32;
        } else {
            if Pendingˉbytes > 0u32 &&
                (Step.Kind !=
                        Publication.Compilerˉnativeˉx64ˉpublicationˉkind.Code ||
                    Pendingˉbytes > STAGING_RESOURCE_BYTES ||
                    Length > STAGING_RESOURCE_BYTES - Pendingˉbytes) {
                file.write_bytes(Resource, Pending);
                return Completedˉchunkˉwrite(
                    Pendingˉposition,
                    Pendingˉbytes,
                    Steps,
                    Cursor
                );
            }
            if Step.Kind !=
                    Publication.Compilerˉnativeˉx64ˉpublicationˉkind.Code {
                let Next: Publication.Compilerˉnativeˉx64ˉpublicationˉcursor =
                    Cursorˉafter(Step);
                file.write_bytes(Resource, Step.Value);
                return Completedˉchunkˉwrite(
                    Step.Position,
                    Length,
                    Steps + 1u32,
                    Next
                );
            }
            if Pendingˉbytes == 0u32 {
                Pendingˉposition = Step.Position;
                Pending = Step.Value;
            } else {
                Pending = Bytesˉconcat(Pending, Step.Value);
            }
            Cursor = Cursorˉafter(Step);
            Steps = Steps + 1u32;
        }
    }
    return Invalidˉchunkˉwrite(Cursor);
}

export fn Main() -> i32 {
    if process.argument_count() != 3u32 {
        diagnostic.write_line(
            "Usage: wvnative-stage <input.wvb> <chunk-prefix> <manifest.wvop>"
        );
        return 2;
    }
    let Inputˉpath: text = process.argument(0u32);
    let Chunkˉprefix: text = process.argument(1u32);
    let Manifestˉpath: text = process.argument(2u32);
    if Pathsˉareˉequal(Inputˉpath, Manifestˉpath) ||
        Bytesˉlength(Textˉtoˉutf8(Chunkˉprefix)) == 0u32 ||
        Bytesˉlength(Textˉtoˉutf8(Chunkˉprefix)) > 4078u32 {
        diagnostic.write_line(
            "Usage: wvnative-stage <input.wvb> <chunk-prefix> <manifest.wvop>"
        );
        return 2;
    }

    let Input: bytes = file.read_bytes(Inputˉpath);
    let Plan: Nativeˉx64.Compilerˉnativeˉx64ˉplan =
        Nativeˉx64.Compilerˉnativeˉx64ˉplanˉbuild(Input);
    if Plan.Status != Nativeˉx64.Compilerˉnativeˉx64ˉstatus.Valid {
        if Plan.Status ==
            Nativeˉx64.Compilerˉnativeˉx64ˉstatus.Unsupportedˉcode {
            diagnostic.write_line(
                Textˉconcat(
                    Textˉconcat(
                        "native x64 staging status=Unsupportedˉcode function=",
                        U32ˉformat(Plan.Failureˉfunction)
                    ),
                    Textˉconcat(" detail=", U32ˉformat(Plan.Failureˉdetail))
                )
            );
            return 1;
        }
        diagnostic.write_line(
            Textˉconcat(
                Textˉconcat(
                    Textˉconcat(
                        "native x64 staging status=",
                        Enumˉname(Plan.Status)
                    ),
                    Textˉconcat(
                        " function=",
                        U32ˉformat(Plan.Failureˉfunction)
                    )
                ),
                Textˉconcat(
                    " detail=",
                    U32ˉformat(Plan.Failureˉdetail)
                )
            )
        );
        return 1;
    }
    let Regions: Publication.Compilerˉnativeˉx64ˉpublicationˉregions =
        Publication.Compilerˉnativeˉx64ˉpublicationˉregionsˉbuild(
            Input,
            Plan,
            4194304u32
        );
    if !Regions.Valid {
        return Failure(Nativeˉx64.Compilerˉnativeˉx64ˉstatus.Outputˉlimit);
    }

    var Cursor: Publication.Compilerˉnativeˉx64ˉpublicationˉcursor =
        Publication.Compilerˉnativeˉx64ˉpublicationˉbegin(Regions);
    if !Cursor.Valid {
        return Failure(Nativeˉx64.Compilerˉnativeˉx64ˉstatus.Outputˉlimit);
    }
    var Entries: bytes = Empty(Input);
    var Chunks: u32 = 0u32;
    var Steps: u32 = 0u32;
    while Cursor.Kind !=
        Publication.Compilerˉnativeˉx64ˉpublicationˉkind.Complete {
        let Resource: text = Chunkˉresource(Chunkˉprefix, Chunks);
        if Pathsˉareˉequal(Resource, Inputˉpath) ||
            Pathsˉareˉequal(Resource, Manifestˉpath) {
            diagnostic.write_line("native x64 staging status=Invalidˉresource");
            return 2;
        }
        let Written: Stagingˉchunkˉwrite = Writeˉnextˉchunk(
            Input,
            Plan,
            Regions,
            Cursor,
            Resource
        );
        if !Written.Valid || Written.Length == 0u32 {
            return Failure(Nativeˉx64.Compilerˉnativeˉx64ˉstatus.Outputˉlimit);
        }
        Entries = Appendˉu32(Entries, Chunks);
        Entries = Appendˉu32(Entries, Written.Position);
        Entries = Appendˉu32(Entries, Written.Length);
        Chunks = Chunks + 1u32;
        Steps = Steps + Written.Steps;
        if Steps > Plan.Functionˉcount + 7u32 {
            return Failure(Nativeˉx64.Compilerˉnativeˉx64ˉstatus.Outputˉlimit);
        }
        Cursor = Publication.Compilerˉnativeˉx64ˉpublicationˉcursor(
            Written.Nextˉvalid,
            Written.Nextˉkind,
            Written.Nextˉfunction,
            Written.Nextˉposition
        );
    }
    let Complete: Publication.Compilerˉnativeˉx64ˉpublicationˉstep =
        Publication.Compilerˉnativeˉx64ˉpublicationˉnext(
            Input,
            Plan,
            Regions,
            Cursor,
            4194304u32
        );
    if Complete.Status !=
            Publication.Compilerˉnativeˉx64ˉpublicationˉstatus.Complete ||
        Cursor.Position != Regions.Objectˉbytes ||
        Bytesˉlength(Entries) != Chunks * 12u32 {
        return Failure(Nativeˉx64.Compilerˉnativeˉx64ˉstatus.Outputˉlimit);
    }

    let Manifestˉbytes: bytes =
        Manifest.Compilerˉnativeˉx64ˉstagingˉmanifestˉbuild(
            Entries,
            Regions.Objectˉbytes,
            Chunks
        );
    if Bytesˉlength(Manifestˉbytes) == 0u32 {
        return Failure(Nativeˉx64.Compilerˉnativeˉx64ˉstatus.Outputˉlimit);
    }
    file.write_bytes(Manifestˉpath, Manifestˉbytes);
    var Report: text = "native x64 staging status=Complete object-bytes=";
    Report = Textˉconcat(Report, U32ˉformat(Regions.Objectˉbytes));
    Report = Textˉconcat(Report, " chunks=");
    Report = Textˉconcat(Report, U32ˉformat(Chunks));
    Report = Textˉconcat(Report, " manifest-bytes=");
    console.write_line(
        Textˉconcat(Report, U32ˉformat(Bytesˉlength(Manifestˉbytes)))
    );
    return 0;
}
