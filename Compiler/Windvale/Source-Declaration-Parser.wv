            let Fieldˉend: Compilerˉparseˉstep = Compilerˉparseˉconsume(Input, Fieldˉtype.Nextˉoffset, Fieldˉtype.Nextˉline, Fieldˉtype.Nextˉcolumn, Sourceˉlexer.Compilerˉtokenˉkind.Semicolon);
