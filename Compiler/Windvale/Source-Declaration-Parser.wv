        if Generic.Status != Compilerˉparseˉstatus.Valid {
            return Compilerˉsourceˉdeclarationˉfailure(
                Generic, Compilerˉsourceˉdeclarationˉkind.Function,
                Isˉexported, Token.Offset, Name.Offset, Name.Length
            );
        }
        Parametersˉoffset = Generic.Nextˉoffset;
        Parametersˉline = Generic.Nextˉline;
        Parametersˉcolumn = Generic.Nextˉcolumn;
    }
    let Afterˉleft: Compilerˉparseˉstep = Compilerˉparseˉconsume(Input, Parametersˉoffset, Parametersˉline, Parametersˉcolumn, Sourceˉlexer.Compilerˉtokenˉkind.Leftˉparenthesis);
    if Afterˉleft.Status != Compilerˉparseˉstatus.Valid { return Compilerˉsourceˉdeclarationˉfailure(Afterˉleft, Compilerˉsourceˉdeclarationˉkind.Function, Isˉexported, Token.Offset, Name.Offset, Name.Length); }
    Cursor = Afterˉleft.Nextˉoffset;
    Currentˉline = Afterˉleft.Nextˉline;
    Currentˉcolumn = Afterˉleft.Nextˉcolumn;
    var Parameters: u32 = 0u32;
    var Reading: bool = true;
    while Reading {
        let Current: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(Input, Cursor, Currentˉline, Currentˉcolumn);
        if Current.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Rightˉparenthesis {
            Reading = false;
        } else {
            let Parameterˉname: Compilerˉparseˉstep = Compilerˉparseˉconsume(Input, Cursor, Currentˉline, Currentˉcolumn, Sourceˉlexer.Compilerˉtokenˉkind.Identifier);
            if Parameterˉname.Status != Compilerˉparseˉstatus.Valid { return Compilerˉsourceˉdeclarationˉfailure(Parameterˉname, Compilerˉsourceˉdeclarationˉkind.Function, Isˉexported, Token.Offset, Name.Offset, Name.Length); }
            let Parameterˉcolon: Compilerˉparseˉstep = Compilerˉparseˉconsume(Input, Parameterˉname.Nextˉoffset, Parameterˉname.Nextˉline, Parameterˉname.Nextˉcolumn, Sourceˉlexer.Compilerˉtokenˉkind.Colon);
            if Parameterˉcolon.Status != Compilerˉparseˉstatus.Valid { return Compilerˉsourceˉdeclarationˉfailure(Parameterˉcolon, Compilerˉsourceˉdeclarationˉkind.Function, Isˉexported, Token.Offset, Name.Offset, Name.Length); }
            let Parameterˉtype: Compilerˉparseˉstep = Compilerˉparseˉparameterˉtype(Input, Parameterˉcolon.Nextˉoffset, Parameterˉcolon.Nextˉline, Parameterˉcolon.Nextˉcolumn, false);
            if Parameterˉtype.Status != Compilerˉparseˉstatus.Valid { return Compilerˉsourceˉdeclarationˉfailure(Parameterˉtype, Compilerˉsourceˉdeclarationˉkind.Function, Isˉexported, Token.Offset, Name.Offset, Name.Length); }
            Parameters = Parameters + 1u32;
            if Parameters > 64u32 {
                let Parameterˉlimit: Compilerˉparseˉstep = Compilerˉparseˉstepˉfromˉtoken(Compilerˉparseˉstatus.Itemˉlimit, Current, Sourceˉlexer.Compilerˉtokenˉkind.Rightˉparenthesis);
                return Compilerˉsourceˉdeclarationˉfailure(Parameterˉlimit, Compilerˉsourceˉdeclarationˉkind.Function, Isˉexported, Token.Offset, Name.Offset, Name.Length);
            }
            Cursor = Parameterˉtype.Nextˉoffset;
            Currentˉline = Parameterˉtype.Nextˉline;
            Currentˉcolumn = Parameterˉtype.Nextˉcolumn;
            let Separator: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(Input, Cursor, Currentˉline, Currentˉcolumn);
            if Separator.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Comma {
                Cursor = Separator.Nextˉoffset;
                Currentˉline = Separator.Nextˉline;
                Currentˉcolumn = Separator.Nextˉcolumn;
            } else {
                Reading = false;
            }
        }
    }
    let Afterˉright: Compilerˉparseˉstep = Compilerˉparseˉconsume(Input, Cursor, Currentˉline, Currentˉcolumn, Sourceˉlexer.Compilerˉtokenˉkind.Rightˉparenthesis);
    if Afterˉright.Status != Compilerˉparseˉstatus.Valid { return Compilerˉsourceˉdeclarationˉfailure(Afterˉright, Compilerˉsourceˉdeclarationˉkind.Function, Isˉexported, Token.Offset, Name.Offset, Name.Length); }
