                return Compilerˉsourceˉdeclarationˉfailure(Caseˉname, Compilerˉsourceˉdeclarationˉkind.Variant, Isˉexported, Token.Offset, Name.Offset, Name.Length);
            }
            var Endˉoffset: u32 = Caseˉname.Nextˉoffset;
            var Endˉline: u32 = Caseˉname.Nextˉline;
            var Endˉcolumn: u32 = Caseˉname.Nextˉcolumn;
            let Payloadˉstart: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(Input, Endˉoffset, Endˉline, Endˉcolumn);
            if Payloadˉstart.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Leftˉparenthesis {
                let Afterˉleft: Compilerˉparseˉstep = Compilerˉparseˉconsume(Input, Endˉoffset, Endˉline, Endˉcolumn, Sourceˉlexer.Compilerˉtokenˉkind.Leftˉparenthesis);
                var Fieldˉcursor: u32 = Afterˉleft.Nextˉoffset;
                var Fieldˉline: u32 = Afterˉleft.Nextˉline;
                var Fieldˉcolumn: u32 = Afterˉleft.Nextˉcolumn;
