                if Afterˉright.Status != Compilerˉparseˉstatus.Valid { return Compilerˉsourceˉdeclarationˉfailure(Afterˉright, Compilerˉsourceˉdeclarationˉkind.Variant, Isˉexported, Token.Offset, Name.Offset, Name.Length); }
                Endˉoffset = Afterˉright.Nextˉoffset;
                Endˉline = Afterˉright.Nextˉline;
                Endˉcolumn = Afterˉright.Nextˉcolumn;
            }
            let Caseˉend: Compilerˉparseˉstep = Compilerˉparseˉconsume(Input, Endˉoffset, Endˉline, Endˉcolumn, Sourceˉlexer.Compilerˉtokenˉkind.Semicolon);
            if Caseˉend.Status != Compilerˉparseˉstatus.Valid { return Compilerˉsourceˉdeclarationˉfailure(Caseˉend, Compilerˉsourceˉdeclarationˉkind.Variant, Isˉexported, Token.Offset, Name.Offset, Name.Length); }
            Cases = Cases + 1u32;
            if Cases > 256u32 {
                let Caseˉlimit: Compilerˉparseˉstep = Compilerˉparseˉstepˉfromˉtoken(Compilerˉparseˉstatus.Itemˉlimit, Current, Sourceˉlexer.Compilerˉtokenˉkind.Rightˉbrace);
                return Compilerˉsourceˉdeclarationˉfailure(Caseˉlimit, Compilerˉsourceˉdeclarationˉkind.Variant, Isˉexported, Token.Offset, Name.Offset, Name.Length);
            }
            Cursor = Caseˉend.Nextˉoffset;
            Currentˉline = Caseˉend.Nextˉline;
            Currentˉcolumn = Caseˉend.Nextˉcolumn;
        }
    }
    let End: Compilerˉparseˉstep = Compilerˉparseˉconsume(Input, Cursor, Currentˉline, Currentˉcolumn, Sourceˉlexer.Compilerˉtokenˉkind.Rightˉbrace);
    if End.Status != Compilerˉparseˉstatus.Valid { return Compilerˉsourceˉdeclarationˉfailure(End, Compilerˉsourceˉdeclarationˉkind.Variant, Isˉexported, Token.Offset, Name.Offset, Name.Length); }
    return Compilerˉsourceˉdeclarationˉmake(Compilerˉparseˉstatus.Valid, Sourceˉlexer.Compilerˉlexˉstatus.Valid, Compilerˉsourceˉdeclarationˉkind.Variant, Isˉexported, Name.Offset, Name.Length, Token.Offset, End.Nextˉoffset, Bodyˉstart.Offset, End.Nextˉoffset, Cases, End.Nextˉoffset, End.Nextˉline, End.Nextˉcolumn, End.Nextˉoffset, End.Nextˉline, End.Nextˉcolumn, Sourceˉlexer.Compilerˉtokenˉkind.End, Sourceˉlexer.Compilerˉtokenˉkind.End);
