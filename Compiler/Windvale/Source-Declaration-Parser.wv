    if Afterˉplatform.Status != Compilerˉparseˉstatus.Valid {
        return Compilerˉsourceˉheader(Afterˉplatform.Status, Afterˉplatform.Lexicalˉstatus, Compilerˉsourceˉprofile.None, Name.Offset, Name.Length, Afterˉplatform.Nextˉoffset, Afterˉplatform.Nextˉline, Afterˉplatform.Nextˉcolumn, Afterˉplatform.Failureˉoffset, Afterˉplatform.Failureˉline, Afterˉplatform.Failureˉcolumn, Afterˉplatform.Expected, Afterˉplatform.Found);
    }

    Cursor = Afterˉplatform.Nextˉoffset;
    Currentˉline = Afterˉplatform.Nextˉline;
    Currentˉcolumn = Afterˉplatform.Nextˉcolumn;
    var Platforms: u32 = 0u32;
    var Readingˉplatforms: bool = true;
    while Readingˉplatforms {
        let Scope: Compilerˉparseˉstep = Compilerˉparseˉqualifiedˉname(
