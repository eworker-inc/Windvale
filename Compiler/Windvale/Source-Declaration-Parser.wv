                let Badˉseparator: Compilerˉparseˉstep = Compilerˉparseˉstepˉfromˉtoken(Compilerˉparseˉstatus.Expectedˉtoken, Separator, Sourceˉlexer.Compilerˉtokenˉkind.Semicolon);
                return Compilerˉsourceˉheader(Badˉseparator.Status, Badˉseparator.Lexicalˉstatus, Compilerˉsourceˉprofile.None, Name.Offset, Name.Length, Badˉseparator.Nextˉoffset, Badˉseparator.Nextˉline, Badˉseparator.Nextˉcolumn, Badˉseparator.Failureˉoffset, Badˉseparator.Failureˉline, Badˉseparator.Failureˉcolumn, Badˉseparator.Expected, Badˉseparator.Found);
            }
            Cursor = Separator.Nextˉoffset;
            Currentˉline = Separator.Nextˉline;
            Currentˉcolumn = Separator.Nextˉcolumn;
            Readingˉplatforms = false;
