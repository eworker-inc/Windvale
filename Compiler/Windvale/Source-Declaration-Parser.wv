    return Compilerˉsourceˉdeclarationˉmake(Compilerˉparseˉstatus.Valid, Sourceˉlexer.Compilerˉlexˉstatus.Valid, Compilerˉsourceˉdeclarationˉkind.Enum, Isˉexported, Name.Offset, Name.Length, Token.Offset, End.Nextˉoffset, Bodyˉstart.Offset, End.Nextˉoffset, Members, End.Nextˉoffset, End.Nextˉline, End.Nextˉcolumn, End.Nextˉoffset, End.Nextˉline, End.Nextˉcolumn, Sourceˉlexer.Compilerˉtokenˉkind.End, Sourceˉlexer.Compilerˉtokenˉkind.End);
