    }

    let Afterˉauthority: Compilerˉparseˉstep = Compilerˉparseˉconsume(
        Input, Cursor, Currentˉline, Currentˉcolumn, Sourceˉlexer.Compilerˉtokenˉkind.Authority
    );
    if Afterˉauthority.Status != Compilerˉparseˉstatus.Valid {
        return Compilerˉsourceˉheader(Afterˉauthority.Status, Afterˉauthority.Lexicalˉstatus, Compilerˉsourceˉprofile.None, Name.Offset, Name.Length, Afterˉauthority.Nextˉoffset, Afterˉauthority.Nextˉline, Afterˉauthority.Nextˉcolumn, Afterˉauthority.Failureˉoffset, Afterˉauthority.Failureˉline, Afterˉauthority.Failureˉcolumn, Afterˉauthority.Expected, Afterˉauthority.Found);
    }
    let Authority: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
        Input, Afterˉauthority.Nextˉoffset, Afterˉauthority.Nextˉline, Afterˉauthority.Nextˉcolumn
    );
    var Authorityˉvalid: bool = Authority.Kind == Sourceˉlexer.Compilerˉtokenˉkind.System;
    if Authority.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Identifier {
        if Sourceˉlexer.Compilerˉsourceˉspanˉequalsˉtext(Input, Authority.Offset, Authority.Length, "library") { Authorityˉvalid = true; }
        if Sourceˉlexer.Compilerˉsourceˉspanˉequalsˉtext(Input, Authority.Offset, Authority.Length, "application") { Authorityˉvalid = true; }
        if Sourceˉlexer.Compilerˉsourceˉspanˉequalsˉtext(Input, Authority.Offset, Authority.Length, "service") { Authorityˉvalid = true; }
    }
    if !Authorityˉvalid {
        let Badˉauthority: Compilerˉparseˉstep = Compilerˉparseˉstepˉfromˉtoken(Compilerˉparseˉstatus.Invalidˉmetadata, Authority, Sourceˉlexer.Compilerˉtokenˉkind.Identifier);
        return Compilerˉsourceˉheader(Badˉauthority.Status, Badˉauthority.Lexicalˉstatus, Compilerˉsourceˉprofile.None, Name.Offset, Name.Length, Badˉauthority.Nextˉoffset, Badˉauthority.Nextˉline, Badˉauthority.Nextˉcolumn, Badˉauthority.Failureˉoffset, Badˉauthority.Failureˉline, Badˉauthority.Failureˉcolumn, Badˉauthority.Expected, Badˉauthority.Found);
    }
    let End: Compilerˉparseˉstep = Compilerˉparseˉconsume(
        Input, Authority.Nextˉoffset, Authority.Nextˉline, Authority.Nextˉcolumn,
        Sourceˉlexer.Compilerˉtokenˉkind.Semicolon
    );
    if End.Status != Compilerˉparseˉstatus.Valid {
        return Compilerˉsourceˉheader(End.Status, End.Lexicalˉstatus, Compilerˉsourceˉprofile.None, Name.Offset, Name.Length, End.Nextˉoffset, End.Nextˉline, End.Nextˉcolumn, End.Failureˉoffset, End.Failureˉline, End.Failureˉcolumn, End.Expected, End.Found);
    }

    var Profile: Compilerˉsourceˉprofile = Declaredˉprofile;
    if Profile == Compilerˉsourceˉprofile.None {
        Profile = Compilerˉsourceˉprofile.Portable;
    }
    if Declaredˉprofile == Compilerˉsourceˉprofile.None &&
        Authority.Kind == Sourceˉlexer.Compilerˉtokenˉkind.System {
        Profile = Compilerˉsourceˉprofile.System;
    } else if Declaredˉprofile == Compilerˉsourceˉprofile.None {
        let Requirement: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Input, End.Nextˉoffset, End.Nextˉline, End.Nextˉcolumn
        );
        if Requirement.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Requires { Profile = Compilerˉsourceˉprofile.Hosted; }
        if Requirement.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Optional { Profile = Compilerˉsourceˉprofile.Hosted; }
    }
    return Compilerˉsourceˉheader(Compilerˉparseˉstatus.Valid, Sourceˉlexer.Compilerˉlexˉstatus.Valid, Profile, Name.Offset, Name.Length, End.Nextˉoffset, End.Nextˉline, End.Nextˉcolumn, End.Nextˉoffset, End.Nextˉline, End.Nextˉcolumn, Sourceˉlexer.Compilerˉtokenˉkind.End, Sourceˉlexer.Compilerˉtokenˉkind.End);
}

export fn Compilerˉsourceˉusesˉstandaloneˉprofile(Input: bytes) -> bool {
    let Module: Sourceˉlexer.Compilerˉsourceˉtoken =
        Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(Input, 0u32, 1u32, 1u32);
    let Name: Sourceˉlexer.Compilerˉsourceˉtoken =
        Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Input, Module.Nextˉoffset, Module.Nextˉline, Module.Nextˉcolumn
        );
    let Moduleˉend: Sourceˉlexer.Compilerˉsourceˉtoken =
        Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Input, Name.Nextˉoffset, Name.Nextˉline, Name.Nextˉcolumn
        );
    if Moduleˉend.Kind != Sourceˉlexer.Compilerˉtokenˉkind.Semicolon { return false; }
    let Next: Sourceˉlexer.Compilerˉsourceˉtoken =
        Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Input, Moduleˉend.Nextˉoffset, Moduleˉend.Nextˉline, Moduleˉend.Nextˉcolumn
        );
    return Next.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Profile;
}

export fn Compilerˉparseˉheaderˉvalidated(Input: bytes) -> Compilerˉsourceˉheader {
    let Afterˉmodule: Compilerˉparseˉstep = Compilerˉparseˉconsume(Input, 0u32, 1u32, 1u32, Sourceˉlexer.Compilerˉtokenˉkind.Module);
    if Afterˉmodule.Status != Compilerˉparseˉstatus.Valid {
        return Compilerˉsourceˉheader(Afterˉmodule.Status, Afterˉmodule.Lexicalˉstatus, Compilerˉsourceˉprofile.None, 0u32, 0u32, Afterˉmodule.Nextˉoffset, Afterˉmodule.Nextˉline, Afterˉmodule.Nextˉcolumn, Afterˉmodule.Failureˉoffset, Afterˉmodule.Failureˉline, Afterˉmodule.Failureˉcolumn, Afterˉmodule.Expected, Afterˉmodule.Found);
    }
    let Name: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(Input, Afterˉmodule.Nextˉoffset, Afterˉmodule.Nextˉline, Afterˉmodule.Nextˉcolumn);
    let Afterˉname: Compilerˉparseˉstep = Compilerˉparseˉconsume(Input, Afterˉmodule.Nextˉoffset, Afterˉmodule.Nextˉline, Afterˉmodule.Nextˉcolumn, Sourceˉlexer.Compilerˉtokenˉkind.Identifier);
    if Afterˉname.Status != Compilerˉparseˉstatus.Valid {
        return Compilerˉsourceˉheader(Afterˉname.Status, Afterˉname.Lexicalˉstatus, Compilerˉsourceˉprofile.None, Name.Offset, Name.Length, Afterˉname.Nextˉoffset, Afterˉname.Nextˉline, Afterˉname.Nextˉcolumn, Afterˉname.Failureˉoffset, Afterˉname.Failureˉline, Afterˉname.Failureˉcolumn, Afterˉname.Expected, Afterˉname.Found);
    }
    let Headerˉform: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
        Input, Afterˉname.Nextˉoffset, Afterˉname.Nextˉline, Afterˉname.Nextˉcolumn
    );
    if Headerˉform.Kind != Sourceˉlexer.Compilerˉtokenˉkind.Profile {
        return Compilerˉparseˉmetadataˉheaderˉafterˉname(Input, Name, Afterˉname);
    }
    let Afterˉprofile: Compilerˉparseˉstep = Compilerˉparseˉconsume(Input, Afterˉname.Nextˉoffset, Afterˉname.Nextˉline, Afterˉname.Nextˉcolumn, Sourceˉlexer.Compilerˉtokenˉkind.Profile);
    if Afterˉprofile.Status != Compilerˉparseˉstatus.Valid {
        return Compilerˉsourceˉheader(Afterˉprofile.Status, Afterˉprofile.Lexicalˉstatus, Compilerˉsourceˉprofile.None, Name.Offset, Name.Length, Afterˉprofile.Nextˉoffset, Afterˉprofile.Nextˉline, Afterˉprofile.Nextˉcolumn, Afterˉprofile.Failureˉoffset, Afterˉprofile.Failureˉline, Afterˉprofile.Failureˉcolumn, Afterˉprofile.Expected, Afterˉprofile.Found);
    }
    let Profileˉtoken: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(Input, Afterˉprofile.Nextˉoffset, Afterˉprofile.Nextˉline, Afterˉprofile.Nextˉcolumn);
    var Profile: Compilerˉsourceˉprofile = Compilerˉsourceˉprofile.None;
    if Profileˉtoken.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Portable { Profile = Compilerˉsourceˉprofile.Portable; }
    if Profileˉtoken.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Hosted { Profile = Compilerˉsourceˉprofile.Hosted; }
    if Profileˉtoken.Kind == Sourceˉlexer.Compilerˉtokenˉkind.System { Profile = Compilerˉsourceˉprofile.System; }
    if Profile == Compilerˉsourceˉprofile.None {
        let Badˉprofile: Compilerˉparseˉstep = Compilerˉparseˉstepˉfromˉtoken(Compilerˉparseˉstatus.Invalidˉprofile, Profileˉtoken, Sourceˉlexer.Compilerˉtokenˉkind.Portable);
        return Compilerˉsourceˉheader(Badˉprofile.Status, Badˉprofile.Lexicalˉstatus, Profile, Name.Offset, Name.Length, Badˉprofile.Nextˉoffset, Badˉprofile.Nextˉline, Badˉprofile.Nextˉcolumn, Badˉprofile.Failureˉoffset, Badˉprofile.Failureˉline, Badˉprofile.Failureˉcolumn, Badˉprofile.Expected, Badˉprofile.Found);
    }
    let End: Compilerˉparseˉstep = Compilerˉparseˉconsume(Input, Profileˉtoken.Nextˉoffset, Profileˉtoken.Nextˉline, Profileˉtoken.Nextˉcolumn, Sourceˉlexer.Compilerˉtokenˉkind.Semicolon);
    if End.Status != Compilerˉparseˉstatus.Valid {
        return Compilerˉsourceˉheader(End.Status, End.Lexicalˉstatus, Profile, Name.Offset, Name.Length, End.Nextˉoffset, End.Nextˉline, End.Nextˉcolumn, End.Failureˉoffset, End.Failureˉline, End.Failureˉcolumn, End.Expected, End.Found);
    }
    return Compilerˉsourceˉheader(Compilerˉparseˉstatus.Valid, Sourceˉlexer.Compilerˉlexˉstatus.Valid, Profile, Name.Offset, Name.Length, End.Nextˉoffset, End.Nextˉline, End.Nextˉcolumn, End.Nextˉoffset, End.Nextˉline, End.Nextˉcolumn, Sourceˉlexer.Compilerˉtokenˉkind.End, Sourceˉlexer.Compilerˉtokenˉkind.End);
}

export fn Compilerˉparseˉheader(Input: bytes) -> Compilerˉsourceˉheader {
    let Scan: Sourceˉlexer.Compilerˉsourceˉscan = Sourceˉlexer.Compilerˉlexˉsource(Input);
    if Scan.Status != Sourceˉlexer.Compilerˉlexˉstatus.Valid {
        return Compilerˉsourceˉheader(Compilerˉparseˉstatus.Lexicalˉerror, Scan.Status, Compilerˉsourceˉprofile.None, 0u32, 0u32, Scan.Endˉoffset, Scan.Endˉline, Scan.Endˉcolumn, Scan.Failureˉoffset, Scan.Failureˉline, Scan.Failureˉcolumn, Sourceˉlexer.Compilerˉtokenˉkind.End, Sourceˉlexer.Compilerˉtokenˉkind.Bad);
    }
    return Compilerˉparseˉheaderˉvalidated(Input);
}

export fn Compilerˉparseˉnextˉdeclarationˉvalidated(
    Input: bytes,
    Offset: u32,
    Line: u32,
    Column: u32,
    Sawˉnonˉimport: bool
) -> Compilerˉsourceˉdeclaration {
    let Token: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(Input, Offset, Line, Column);
    if Token.Status != Sourceˉlexer.Compilerˉlexˉstatus.Valid {
        let Lexical: Compilerˉparseˉstep = Compilerˉparseˉstepˉfromˉtoken(Compilerˉparseˉstatus.Lexicalˉerror, Token, Sourceˉlexer.Compilerˉtokenˉkind.End);
        return Compilerˉsourceˉdeclarationˉfailure(Lexical, Compilerˉsourceˉdeclarationˉkind.End, false, Offset, Offset, 0u32);
    }
    if Token.Kind == Sourceˉlexer.Compilerˉtokenˉkind.End {
        return Compilerˉsourceˉdeclarationˉmake(Compilerˉparseˉstatus.Valid, Sourceˉlexer.Compilerˉlexˉstatus.Valid, Compilerˉsourceˉdeclarationˉkind.End, false, Token.Offset, 0u32, Token.Offset, Token.Offset, Token.Offset, Token.Offset, 0u32, Token.Nextˉoffset, Token.Nextˉline, Token.Nextˉcolumn, Token.Offset, Token.Line, Token.Column, Sourceˉlexer.Compilerˉtokenˉkind.End, Sourceˉlexer.Compilerˉtokenˉkind.End);
    }
    if Token.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Import {
        if Sawˉnonˉimport {
            let Late: Compilerˉparseˉstep = Compilerˉparseˉstepˉfromˉtoken(Compilerˉparseˉstatus.Importˉafterˉdeclaration, Token, Sourceˉlexer.Compilerˉtokenˉkind.End);
            return Compilerˉsourceˉdeclarationˉfailure(Late, Compilerˉsourceˉdeclarationˉkind.Import, false, Token.Offset, Token.Offset, 0u32);
        }
        return Compilerˉparseˉimportˉdeclaration(Input, Token);
    }
    if Token.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Capability { return Compilerˉparseˉcapabilityˉdeclaration(Input, Token); }
    if Token.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Requires {
        return Compilerˉparseˉmetadataˉcapabilityˉdeclaration(Input, Token, false);
    }
    if Token.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Optional {
        return Compilerˉparseˉmetadataˉcapabilityˉdeclaration(Input, Token, true);
    }
    if Token.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Data { return Compilerˉparseˉdataˉdeclaration(Input, Token); }
    if Token.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Const { return Compilerˉparseˉconstantˉdeclaration(Input, Token); }
    if Token.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Record { return Compilerˉparseˉrecordˉdeclaration(Input, Token); }
    if Token.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Enum { return Compilerˉparseˉenumˉdeclaration(Input, Token); }
    if Token.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Variant { return Compilerˉparseˉvariantˉdeclaration(Input, Token); }
    if Token.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Export {
        let Exported: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Input, Token.Nextˉoffset, Token.Nextˉline, Token.Nextˉcolumn
        );
        if Exported.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Const {
            return Compilerˉparseˉconstantˉdeclaration(Input, Token);
        }
        if Exported.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Data {
            return Compilerˉparseˉdataˉdeclaration(Input, Token);
        }
        if Exported.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Record {
            return Compilerˉparseˉrecordˉdeclaration(Input, Token);
        }
        if Exported.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Enum {
            return Compilerˉparseˉenumˉdeclaration(Input, Token);
        }
        if Exported.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Variant {
            return Compilerˉparseˉvariantˉdeclaration(Input, Token);
        }
        return Compilerˉparseˉfunctionˉdeclaration(Input, Token);
    }
    if Token.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Fn { return Compilerˉparseˉfunctionˉdeclaration(Input, Token); }
    let Unexpected: Compilerˉparseˉstep = Compilerˉparseˉstepˉfromˉtoken(Compilerˉparseˉstatus.Unexpectedˉdeclaration, Token, Sourceˉlexer.Compilerˉtokenˉkind.Import);
    return Compilerˉsourceˉdeclarationˉfailure(Unexpected, Compilerˉsourceˉdeclarationˉkind.End, false, Token.Offset, Token.Offset, 0u32);
}

export fn Compilerˉparseˉnextˉdeclaration(
    Input: bytes,
    Offset: u32,
    Line: u32,
    Column: u32,
    Sawˉnonˉimport: bool
) -> Compilerˉsourceˉdeclaration {
    let Scan: Sourceˉlexer.Compilerˉsourceˉscan = Sourceˉlexer.Compilerˉlexˉsource(Input);
    if Scan.Status != Sourceˉlexer.Compilerˉlexˉstatus.Valid {
        let Lexical: Compilerˉparseˉstep = Compilerˉparseˉstepˉfailure(Compilerˉparseˉstatus.Lexicalˉerror, Scan.Status, Scan.Failureˉoffset, Scan.Failureˉline, Scan.Failureˉcolumn, Sourceˉlexer.Compilerˉtokenˉkind.End, Sourceˉlexer.Compilerˉtokenˉkind.Bad);
        return Compilerˉsourceˉdeclarationˉfailure(Lexical, Compilerˉsourceˉdeclarationˉkind.End, false, Offset, Offset, 0u32);
    }
    return Compilerˉparseˉnextˉdeclarationˉvalidated(Input, Offset, Line, Column, Sawˉnonˉimport);
}

export fn Compilerˉsourceˉsummaryˉfromˉfailure(
    Header: Compilerˉsourceˉheader,
    Declaration: Compilerˉsourceˉdeclaration,
    Imports: u32,
    Capabilities: u32,
    Data: u32,
    Records: u32,
    Enums: u32,
    Functions: u32,
    Tokens: u32
) -> Compilerˉsourceˉmoduleˉsummary {
    return Compilerˉsourceˉmoduleˉsummary(
        Declaration.Status,
        Declaration.Lexicalˉstatus,
        Header.Profile,
        Header.Nameˉoffset,
        Header.Nameˉlength,
        Imports,
        Capabilities,
        Data,
        Records,
        Enums,
        Functions,
        Tokens,
        Declaration.Nextˉoffset,
        Declaration.Nextˉline,
        Declaration.Nextˉcolumn,
        Declaration.Failureˉoffset,
        Declaration.Failureˉline,
        Declaration.Failureˉcolumn,
        Declaration.Expected,
        Declaration.Found
    );
}

export fn Compilerˉparseˉsource(Input: bytes) -> Compilerˉsourceˉmoduleˉsummary {
    let Scan: Sourceˉlexer.Compilerˉsourceˉscan = Sourceˉlexer.Compilerˉlexˉsource(Input);
    if Scan.Status != Sourceˉlexer.Compilerˉlexˉstatus.Valid {
        return Compilerˉsourceˉmoduleˉsummary(Compilerˉparseˉstatus.Lexicalˉerror, Scan.Status, Compilerˉsourceˉprofile.None, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32, Scan.Tokens, Scan.Endˉoffset, Scan.Endˉline, Scan.Endˉcolumn, Scan.Failureˉoffset, Scan.Failureˉline, Scan.Failureˉcolumn, Sourceˉlexer.Compilerˉtokenˉkind.End, Sourceˉlexer.Compilerˉtokenˉkind.Bad);
    }
    let Header: Compilerˉsourceˉheader = Compilerˉparseˉheaderˉvalidated(Input);
    if Header.Status != Compilerˉparseˉstatus.Valid {
        return Compilerˉsourceˉmoduleˉsummary(Header.Status, Header.Lexicalˉstatus, Header.Profile, Header.Nameˉoffset, Header.Nameˉlength, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32, Scan.Tokens, Header.Nextˉoffset, Header.Nextˉline, Header.Nextˉcolumn, Header.Failureˉoffset, Header.Failureˉline, Header.Failureˉcolumn, Header.Expected, Header.Found);
    }
    var Cursor: u32 = Header.Nextˉoffset;
    var Currentˉline: u32 = Header.Nextˉline;
    var Currentˉcolumn: u32 = Header.Nextˉcolumn;
    var Imports: u32 = 0u32;
    var Capabilities: u32 = 0u32;
    var Data: u32 = 0u32;
    var Records: u32 = 0u32;
    var Enums: u32 = 0u32;
    var Functions: u32 = 0u32;
    var Declarations: u32 = 0u32;
    var Sawˉnonˉimport: bool = false;
    var Reading: bool = true;
    while Reading {
        let Declaration: Compilerˉsourceˉdeclaration = Compilerˉparseˉnextˉdeclarationˉvalidated(Input, Cursor, Currentˉline, Currentˉcolumn, Sawˉnonˉimport);
        if Declaration.Status != Compilerˉparseˉstatus.Valid {
            return Compilerˉsourceˉsummaryˉfromˉfailure(Header, Declaration, Imports, Capabilities, Data, Records, Enums, Functions, Scan.Tokens);
        }
        if Declaration.Kind == Compilerˉsourceˉdeclarationˉkind.End {
            Reading = false;
        } else {
            Declarations = Declarations + 1u32;
            if Declarations > 4096u32 {
                let Limitˉstep: Compilerˉparseˉstep = Compilerˉparseˉstepˉfailure(Compilerˉparseˉstatus.Itemˉlimit, Sourceˉlexer.Compilerˉlexˉstatus.Valid, Declaration.Declarationˉoffset, Declaration.Failureˉline, Declaration.Failureˉcolumn, Sourceˉlexer.Compilerˉtokenˉkind.End, Declaration.Found);
                let Limitˉdeclaration: Compilerˉsourceˉdeclaration = Compilerˉsourceˉdeclarationˉfailure(Limitˉstep, Declaration.Kind, Declaration.Isˉexported, Declaration.Declarationˉoffset, Declaration.Nameˉoffset, Declaration.Nameˉlength);
                return Compilerˉsourceˉsummaryˉfromˉfailure(Header, Limitˉdeclaration, Imports, Capabilities, Data, Records, Enums, Functions, Scan.Tokens);
            }
            if Declaration.Kind == Compilerˉsourceˉdeclarationˉkind.Import { Imports = Imports + 1u32; }
            if Declaration.Kind == Compilerˉsourceˉdeclarationˉkind.Capability { Capabilities = Capabilities + 1u32; }
            if Declaration.Kind == Compilerˉsourceˉdeclarationˉkind.Data { Data = Data + 1u32; }
            if Declaration.Kind == Compilerˉsourceˉdeclarationˉkind.Record { Records = Records + 1u32; }
            if Declaration.Kind == Compilerˉsourceˉdeclarationˉkind.Enum { Enums = Enums + 1u32; }
            if Declaration.Kind == Compilerˉsourceˉdeclarationˉkind.Function { Functions = Functions + 1u32; }
            if Compilerˉsourceˉdeclarationˉclosesˉimports(Declaration) { Sawˉnonˉimport = true; }
            Cursor = Declaration.Nextˉoffset;
            Currentˉline = Declaration.Nextˉline;
            Currentˉcolumn = Declaration.Nextˉcolumn;
        }
    }
    return Compilerˉsourceˉmoduleˉsummary(Compilerˉparseˉstatus.Valid, Sourceˉlexer.Compilerˉlexˉstatus.Valid, Header.Profile, Header.Nameˉoffset, Header.Nameˉlength, Imports, Capabilities, Data, Records, Enums, Functions, Scan.Tokens, Cursor, Currentˉline, Currentˉcolumn, Cursor, Currentˉline, Currentˉcolumn, Sourceˉlexer.Compilerˉtokenˉkind.End, Sourceˉlexer.Compilerˉtokenˉkind.End);
}

export fn Compilerˉparseˉdeclarationˉat(
    Input: bytes,
    Wanted: u32
) -> Compilerˉsourceˉdeclaration {
    let Header: Compilerˉsourceˉheader = Compilerˉparseˉheader(Input);
    if Header.Status != Compilerˉparseˉstatus.Valid {
        let Failure: Compilerˉparseˉstep = Compilerˉparseˉstepˉfailure(Header.Status, Header.Lexicalˉstatus, Header.Failureˉoffset, Header.Failureˉline, Header.Failureˉcolumn, Header.Expected, Header.Found);
        return Compilerˉsourceˉdeclarationˉfailure(Failure, Compilerˉsourceˉdeclarationˉkind.End, false, Header.Failureˉoffset, Header.Failureˉoffset, 0u32);
    }
    var Cursor: u32 = Header.Nextˉoffset;
    var Currentˉline: u32 = Header.Nextˉline;
    var Currentˉcolumn: u32 = Header.Nextˉcolumn;
    var Sawˉnonˉimport: bool = false;
    var Index: u32 = 0u32;
    var Declaration: Compilerˉsourceˉdeclaration = Compilerˉparseˉnextˉdeclarationˉvalidated(Input, Cursor, Currentˉline, Currentˉcolumn, Sawˉnonˉimport);
    while Index < Wanted {
        if Declaration.Status != Compilerˉparseˉstatus.Valid { return Declaration; }
        if Declaration.Kind == Compilerˉsourceˉdeclarationˉkind.End { return Declaration; }
        if Compilerˉsourceˉdeclarationˉclosesˉimports(Declaration) { Sawˉnonˉimport = true; }
        Cursor = Declaration.Nextˉoffset;
        Currentˉline = Declaration.Nextˉline;
        Currentˉcolumn = Declaration.Nextˉcolumn;
        Declaration = Compilerˉparseˉnextˉdeclarationˉvalidated(Input, Cursor, Currentˉline, Currentˉcolumn, Sawˉnonˉimport);
        Index = Index + 1u32;
    }
    return Declaration;
}
