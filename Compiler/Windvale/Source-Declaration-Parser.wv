export fn Compilerˉparseˉgenericˉparameters(
    Input: bytes,
    Offset: u32,
    Line: u32,
    Column: u32
) -> Compilerˉparseˉstep {
    let Left: Compilerˉparseˉstep = Compilerˉparseˉconsume(
        Input, Offset, Line, Column, Sourceˉlexer.Compilerˉtokenˉkind.Less
    );
    if Left.Status != Compilerˉparseˉstatus.Valid { return Left; }
    var Cursor: u32 = Left.Nextˉoffset;
    var Currentˉline: u32 = Left.Nextˉline;
    var Currentˉcolumn: u32 = Left.Nextˉcolumn;
    var Parameters: u32 = 0u32;
    var Reading: bool = true;
    while Reading {
        let Parameter: Sourceˉlexer.Compilerˉsourceˉtoken =
            Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                Input, Cursor, Currentˉline, Currentˉcolumn
            );
        var Afterˉparameter: Compilerˉparseˉstep = Compilerˉparseˉconsume(
            Input, Cursor, Currentˉline, Currentˉcolumn,
            Sourceˉlexer.Compilerˉtokenˉkind.Identifier
        );
        if Parameter.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Const {
            let Afterˉconst: Compilerˉparseˉstep = Compilerˉparseˉconsume(
                Input, Cursor, Currentˉline, Currentˉcolumn,
                Sourceˉlexer.Compilerˉtokenˉkind.Const
            );
            let Afterˉname: Compilerˉparseˉstep = Compilerˉparseˉconsume(
                Input, Afterˉconst.Nextˉoffset, Afterˉconst.Nextˉline,
                Afterˉconst.Nextˉcolumn,
                Sourceˉlexer.Compilerˉtokenˉkind.Identifier
            );
            if Afterˉname.Status != Compilerˉparseˉstatus.Valid {
                return Afterˉname;
            }
            let Afterˉcolon: Compilerˉparseˉstep = Compilerˉparseˉconsume(
                Input, Afterˉname.Nextˉoffset, Afterˉname.Nextˉline,
                Afterˉname.Nextˉcolumn,
                Sourceˉlexer.Compilerˉtokenˉkind.Colon
            );
            if Afterˉcolon.Status != Compilerˉparseˉstatus.Valid {
                return Afterˉcolon;
            }
            let Integerˉtype: Sourceˉlexer.Compilerˉsourceˉtoken =
                Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                    Input, Afterˉcolon.Nextˉoffset, Afterˉcolon.Nextˉline,
                    Afterˉcolon.Nextˉcolumn
                );
            var Isˉinteger: bool = false;
            if Integerˉtype.Kind == Sourceˉlexer.Compilerˉtokenˉkind.I8 { Isˉinteger = true; }
            if Integerˉtype.Kind == Sourceˉlexer.Compilerˉtokenˉkind.I16 { Isˉinteger = true; }
            if Integerˉtype.Kind == Sourceˉlexer.Compilerˉtokenˉkind.I32 { Isˉinteger = true; }
            if Integerˉtype.Kind == Sourceˉlexer.Compilerˉtokenˉkind.I64 { Isˉinteger = true; }
            if Integerˉtype.Kind == Sourceˉlexer.Compilerˉtokenˉkind.U8 { Isˉinteger = true; }
            if Integerˉtype.Kind == Sourceˉlexer.Compilerˉtokenˉkind.U16 { Isˉinteger = true; }
            if Integerˉtype.Kind == Sourceˉlexer.Compilerˉtokenˉkind.U32 { Isˉinteger = true; }
            if Integerˉtype.Kind == Sourceˉlexer.Compilerˉtokenˉkind.U64 { Isˉinteger = true; }
            if !Isˉinteger {
                return Compilerˉparseˉstepˉfromˉtoken(
                    Compilerˉparseˉstatus.Invalidˉtype,
                    Integerˉtype,
                    Sourceˉlexer.Compilerˉtokenˉkind.U64
                );
            }
            Afterˉparameter = Compilerˉparseˉstepˉvalid(
                Integerˉtype.Nextˉoffset, Integerˉtype.Nextˉline,
                Integerˉtype.Nextˉcolumn,
                Compilerˉsourceˉtypeˉkind.Unknown, 0u32
            );
        }
        if Afterˉparameter.Status != Compilerˉparseˉstatus.Valid {
            return Afterˉparameter;
        }
        Parameters = Parameters + 1u32;
        if Parameters > 32u32 {
            return Compilerˉparseˉstepˉfromˉtoken(
                Compilerˉparseˉstatus.Itemˉlimit,
                Parameter,
                Sourceˉlexer.Compilerˉtokenˉkind.Greater
            );
        }
        let Separator: Sourceˉlexer.Compilerˉsourceˉtoken =
            Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                Input, Afterˉparameter.Nextˉoffset,
                Afterˉparameter.Nextˉline, Afterˉparameter.Nextˉcolumn
            );
        if Separator.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Greater {
            return Compilerˉparseˉstepˉvalid(
                Separator.Nextˉoffset, Separator.Nextˉline,
                Separator.Nextˉcolumn,
                Compilerˉsourceˉtypeˉkind.Unknown, Parameters
            );
        }
        if Separator.Kind != Sourceˉlexer.Compilerˉtokenˉkind.Comma {
            return Compilerˉparseˉstepˉfromˉtoken(
                Compilerˉparseˉstatus.Expectedˉtoken,
                Separator,
                Sourceˉlexer.Compilerˉtokenˉkind.Greater
            );
        }
        let Afterˉcomma: Sourceˉlexer.Compilerˉsourceˉtoken =
            Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                Input, Separator.Nextˉoffset, Separator.Nextˉline,
                Separator.Nextˉcolumn
            );
        if Afterˉcomma.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Greater {
            return Compilerˉparseˉstepˉvalid(
                Afterˉcomma.Nextˉoffset, Afterˉcomma.Nextˉline,
                Afterˉcomma.Nextˉcolumn,
                Compilerˉsourceˉtypeˉkind.Unknown, Parameters
            );
        }
        Cursor = Separator.Nextˉoffset;
        Currentˉline = Separator.Nextˉline;
        Currentˉcolumn = Separator.Nextˉcolumn;
    }
    return Compilerˉparseˉstepˉvalid(
        Cursor, Currentˉline, Currentˉcolumn,
        Compilerˉsourceˉtypeˉkind.Unknown, Parameters
    );
}

export fn Compilerˉparseˉvariantˉdeclaration(
    Input: bytes,
    Token: Sourceˉlexer.Compilerˉsourceˉtoken
) -> Compilerˉsourceˉdeclaration {
    var Isˉexported: bool = false;
    var Keywordˉoffset: u32 = Token.Offset;
    var Keywordˉline: u32 = Token.Line;
    var Keywordˉcolumn: u32 = Token.Column;
    if Token.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Export {
        Isˉexported = true;
        let Afterˉexport: Compilerˉparseˉstep = Compilerˉparseˉconsume(
            Input, Keywordˉoffset, Keywordˉline, Keywordˉcolumn,
            Sourceˉlexer.Compilerˉtokenˉkind.Export
        );
        if Afterˉexport.Status != Compilerˉparseˉstatus.Valid {
            return Compilerˉsourceˉdeclarationˉfailure(
                Afterˉexport, Compilerˉsourceˉdeclarationˉkind.Variant,
                true, Token.Offset, Token.Offset, 0u32
            );
        }
        Keywordˉoffset = Afterˉexport.Nextˉoffset;
        Keywordˉline = Afterˉexport.Nextˉline;
        Keywordˉcolumn = Afterˉexport.Nextˉcolumn;
    }
    let Afterˉkeyword: Compilerˉparseˉstep = Compilerˉparseˉconsume(
        Input, Keywordˉoffset, Keywordˉline, Keywordˉcolumn,
        Sourceˉlexer.Compilerˉtokenˉkind.Variant
    );
    if Afterˉkeyword.Status != Compilerˉparseˉstatus.Valid {
        return Compilerˉsourceˉdeclarationˉfailure(Afterˉkeyword, Compilerˉsourceˉdeclarationˉkind.Variant, Isˉexported, Token.Offset, Token.Offset, 0u32);
    }
    let Name: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
        Input, Afterˉkeyword.Nextˉoffset, Afterˉkeyword.Nextˉline, Afterˉkeyword.Nextˉcolumn
    );
    let Afterˉname: Compilerˉparseˉstep = Compilerˉparseˉconsume(
        Input, Afterˉkeyword.Nextˉoffset, Afterˉkeyword.Nextˉline, Afterˉkeyword.Nextˉcolumn,
        Sourceˉlexer.Compilerˉtokenˉkind.Identifier
    );
    if Afterˉname.Status != Compilerˉparseˉstatus.Valid {
        return Compilerˉsourceˉdeclarationˉfailure(Afterˉname, Compilerˉsourceˉdeclarationˉkind.Variant, Isˉexported, Token.Offset, Name.Offset, Name.Length);
    }
    var Bodyˉoffset: u32 = Afterˉname.Nextˉoffset;
    var Bodyˉline: u32 = Afterˉname.Nextˉline;
    var Bodyˉcolumn: u32 = Afterˉname.Nextˉcolumn;
    let Maybeˉparameters: Sourceˉlexer.Compilerˉsourceˉtoken =
        Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Input, Bodyˉoffset, Bodyˉline, Bodyˉcolumn
        );
    if Maybeˉparameters.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Less {
        let Parameters: Compilerˉparseˉstep = Compilerˉparseˉgenericˉparameters(
            Input, Bodyˉoffset, Bodyˉline, Bodyˉcolumn
        );
        if Parameters.Status != Compilerˉparseˉstatus.Valid {
            return Compilerˉsourceˉdeclarationˉfailure(
                Parameters, Compilerˉsourceˉdeclarationˉkind.Variant,
                Isˉexported, Token.Offset, Name.Offset, Name.Length
            );
        }
        Bodyˉoffset = Parameters.Nextˉoffset;
        Bodyˉline = Parameters.Nextˉline;
        Bodyˉcolumn = Parameters.Nextˉcolumn;
    }
    let Bodyˉstart: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
        Input, Bodyˉoffset, Bodyˉline, Bodyˉcolumn
    );
    let Afterˉbrace: Compilerˉparseˉstep = Compilerˉparseˉconsume(
        Input, Bodyˉoffset, Bodyˉline, Bodyˉcolumn,
        Sourceˉlexer.Compilerˉtokenˉkind.Leftˉbrace
    );
    if Afterˉbrace.Status != Compilerˉparseˉstatus.Valid {
        return Compilerˉsourceˉdeclarationˉfailure(Afterˉbrace, Compilerˉsourceˉdeclarationˉkind.Variant, Isˉexported, Token.Offset, Name.Offset, Name.Length);
    }
    var Cursor: u32 = Afterˉbrace.Nextˉoffset;
    var Currentˉline: u32 = Afterˉbrace.Nextˉline;
    var Currentˉcolumn: u32 = Afterˉbrace.Nextˉcolumn;
    var Cases: u32 = 0u32;
    var Reading: bool = true;
    while Reading {
        let Current: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(Input, Cursor, Currentˉline, Currentˉcolumn);
        if Current.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Rightˉbrace {
            Reading = false;
        } else {
            let Caseˉname: Compilerˉparseˉstep = Compilerˉparseˉconsume(
                Input, Cursor, Currentˉline, Currentˉcolumn,
                Sourceˉlexer.Compilerˉtokenˉkind.Identifier
            );
