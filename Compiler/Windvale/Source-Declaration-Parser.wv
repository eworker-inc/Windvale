    let Name: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(Input, Afterˉkeyword.Nextˉoffset, Afterˉkeyword.Nextˉline, Afterˉkeyword.Nextˉcolumn);
    let Afterˉname: Compilerˉparseˉstep = Compilerˉparseˉconsume(Input, Afterˉkeyword.Nextˉoffset, Afterˉkeyword.Nextˉline, Afterˉkeyword.Nextˉcolumn, Sourceˉlexer.Compilerˉtokenˉkind.Identifier);
    if Afterˉname.Status != Compilerˉparseˉstatus.Valid { return Compilerˉsourceˉdeclarationˉfailure(Afterˉname, Compilerˉsourceˉdeclarationˉkind.Enum, false, Token.Offset, Name.Offset, Name.Length); }
    let Bodyˉstart: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(Input, Afterˉname.Nextˉoffset, Afterˉname.Nextˉline, Afterˉname.Nextˉcolumn);
