    if Afterˉbrace.Status != Compilerˉparseˉstatus.Valid { return Compilerˉsourceˉdeclarationˉfailure(Afterˉbrace, Compilerˉsourceˉdeclarationˉkind.Enum, false, Token.Offset, Name.Offset, Name.Length); }
