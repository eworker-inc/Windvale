export fn Compilerˉparseˉfunctionˉdeclaration(
    Input: bytes,
    Token: Sourceˉlexer.Compilerˉsourceˉtoken
) -> Compilerˉsourceˉdeclaration {
    var Isˉexported: bool = false;
    var Cursor: u32 = Token.Offset;
    var Currentˉline: u32 = Token.Line;
    var Currentˉcolumn: u32 = Token.Column;
    if Token.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Export {
        Isˉexported = true;
        let Afterˉexport: Compilerˉparseˉstep = Compilerˉparseˉconsume(Input, Cursor, Currentˉline, Currentˉcolumn, Sourceˉlexer.Compilerˉtokenˉkind.Export);
        if Afterˉexport.Status != Compilerˉparseˉstatus.Valid { return Compilerˉsourceˉdeclarationˉfailure(Afterˉexport, Compilerˉsourceˉdeclarationˉkind.Function, true, Token.Offset, Token.Offset, 0u32); }
        Cursor = Afterˉexport.Nextˉoffset;
        Currentˉline = Afterˉexport.Nextˉline;
        Currentˉcolumn = Afterˉexport.Nextˉcolumn;
    }
    let Afterˉfn: Compilerˉparseˉstep = Compilerˉparseˉconsume(Input, Cursor, Currentˉline, Currentˉcolumn, Sourceˉlexer.Compilerˉtokenˉkind.Fn);
    if Afterˉfn.Status != Compilerˉparseˉstatus.Valid { return Compilerˉsourceˉdeclarationˉfailure(Afterˉfn, Compilerˉsourceˉdeclarationˉkind.Function, Isˉexported, Token.Offset, Token.Offset, 0u32); }
    let Name: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(Input, Afterˉfn.Nextˉoffset, Afterˉfn.Nextˉline, Afterˉfn.Nextˉcolumn);
    let Afterˉname: Compilerˉparseˉstep = Compilerˉparseˉconsume(Input, Afterˉfn.Nextˉoffset, Afterˉfn.Nextˉline, Afterˉfn.Nextˉcolumn, Sourceˉlexer.Compilerˉtokenˉkind.Identifier);
    if Afterˉname.Status != Compilerˉparseˉstatus.Valid { return Compilerˉsourceˉdeclarationˉfailure(Afterˉname, Compilerˉsourceˉdeclarationˉkind.Function, Isˉexported, Token.Offset, Name.Offset, Name.Length); }
    var Parametersˉoffset: u32 = Afterˉname.Nextˉoffset;
    var Parametersˉline: u32 = Afterˉname.Nextˉline;
    var Parametersˉcolumn: u32 = Afterˉname.Nextˉcolumn;
    let Maybeˉgeneric: Sourceˉlexer.Compilerˉsourceˉtoken =
        Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Input, Parametersˉoffset, Parametersˉline, Parametersˉcolumn
        );
    if Maybeˉgeneric.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Less {
        let Generic: Compilerˉparseˉstep = Compilerˉparseˉgenericˉparameters(
            Input, Parametersˉoffset, Parametersˉline, Parametersˉcolumn
