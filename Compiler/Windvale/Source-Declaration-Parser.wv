    while Reading {
        let Current: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(Input, Cursor, Currentˉline, Currentˉcolumn);
        if Current.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Rightˉbrace {
            Reading = false;
        } else {
            let Memberˉname: Compilerˉparseˉstep = Compilerˉparseˉconsume(Input, Cursor, Currentˉline, Currentˉcolumn, Sourceˉlexer.Compilerˉtokenˉkind.Identifier);
            if Memberˉname.Status != Compilerˉparseˉstatus.Valid { return Compilerˉsourceˉdeclarationˉfailure(Memberˉname, Compilerˉsourceˉdeclarationˉkind.Enum, false, Token.Offset, Name.Offset, Name.Length); }
            let Memberˉequals: Compilerˉparseˉstep = Compilerˉparseˉconsume(Input, Memberˉname.Nextˉoffset, Memberˉname.Nextˉline, Memberˉname.Nextˉcolumn, Sourceˉlexer.Compilerˉtokenˉkind.Equals);
            if Memberˉequals.Status != Compilerˉparseˉstatus.Valid { return Compilerˉsourceˉdeclarationˉfailure(Memberˉequals, Compilerˉsourceˉdeclarationˉkind.Enum, false, Token.Offset, Name.Offset, Name.Length); }
            let Memberˉvalue: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(Input, Memberˉequals.Nextˉoffset, Memberˉequals.Nextˉline, Memberˉequals.Nextˉcolumn);
            let Afterˉvalue: Compilerˉparseˉstep = Compilerˉparseˉconsume(Input, Memberˉequals.Nextˉoffset, Memberˉequals.Nextˉline, Memberˉequals.Nextˉcolumn, Sourceˉlexer.Compilerˉtokenˉkind.Integer);
            if Afterˉvalue.Status != Compilerˉparseˉstatus.Valid { return Compilerˉsourceˉdeclarationˉfailure(Afterˉvalue, Compilerˉsourceˉdeclarationˉkind.Enum, false, Token.Offset, Name.Offset, Name.Length); }
            if Memberˉvalue.Numericˉkind != Sourceˉlexer.Compilerˉnumericˉkind.I32 {
