    if Afterˉarrow.Status != Compilerˉparseˉstatus.Valid { return Compilerˉsourceˉdeclarationˉfailure(Afterˉarrow, Compilerˉsourceˉdeclarationˉkind.Function, Isˉexported, Token.Offset, Name.Offset, Name.Length); }
    let Returnˉtype: Compilerˉparseˉstep = Compilerˉparseˉparameterˉtype(Input, Afterˉarrow.Nextˉoffset, Afterˉarrow.Nextˉline, Afterˉarrow.Nextˉcolumn, true);
    if Returnˉtype.Status != Compilerˉparseˉstatus.Valid { return Compilerˉsourceˉdeclarationˉfailure(Returnˉtype, Compilerˉsourceˉdeclarationˉkind.Function, Isˉexported, Token.Offset, Name.Offset, Name.Length); }
    let Bodyˉstart: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(Input, Returnˉtype.Nextˉoffset, Returnˉtype.Nextˉline, Returnˉtype.Nextˉcolumn);
    let Body: Compilerˉparseˉstep = Compilerˉparseˉskipˉblockˉafterˉscan(Input, Returnˉtype.Nextˉoffset, Returnˉtype.Nextˉline, Returnˉtype.Nextˉcolumn);
    if Body.Status != Compilerˉparseˉstatus.Valid { return Compilerˉsourceˉdeclarationˉfailure(Body, Compilerˉsourceˉdeclarationˉkind.Function, Isˉexported, Token.Offset, Name.Offset, Name.Length); }
    return Compilerˉsourceˉdeclarationˉmake(Compilerˉparseˉstatus.Valid, Sourceˉlexer.Compilerˉlexˉstatus.Valid, Compilerˉsourceˉdeclarationˉkind.Function, Isˉexported, Name.Offset, Name.Length, Token.Offset, Body.Nextˉoffset, Bodyˉstart.Offset, Body.Nextˉoffset, Parameters, Body.Nextˉoffset, Body.Nextˉline, Body.Nextˉcolumn, Body.Nextˉoffset, Body.Nextˉline, Body.Nextˉcolumn, Sourceˉlexer.Compilerˉtokenˉkind.End, Sourceˉlexer.Compilerˉtokenˉkind.End);
}

export fn Compilerˉparseˉmetadataˉheaderˉafterˉname(
    Input: bytes,
    Name: Sourceˉlexer.Compilerˉsourceˉtoken,
    Afterˉname: Compilerˉparseˉstep
) -> Compilerˉsourceˉheader {
    let Afterˉmoduleˉend: Compilerˉparseˉstep = Compilerˉparseˉconsume(
        Input, Afterˉname.Nextˉoffset, Afterˉname.Nextˉline, Afterˉname.Nextˉcolumn,
        Sourceˉlexer.Compilerˉtokenˉkind.Semicolon
    );
    if Afterˉmoduleˉend.Status != Compilerˉparseˉstatus.Valid {
        return Compilerˉsourceˉheader(Afterˉmoduleˉend.Status, Afterˉmoduleˉend.Lexicalˉstatus, Compilerˉsourceˉprofile.None, Name.Offset, Name.Length, Afterˉmoduleˉend.Nextˉoffset, Afterˉmoduleˉend.Nextˉline, Afterˉmoduleˉend.Nextˉcolumn, Afterˉmoduleˉend.Failureˉoffset, Afterˉmoduleˉend.Failureˉline, Afterˉmoduleˉend.Failureˉcolumn, Afterˉmoduleˉend.Expected, Afterˉmoduleˉend.Found);
    }

    var Cursor: u32 = Afterˉmoduleˉend.Nextˉoffset;
    var Currentˉline: u32 = Afterˉmoduleˉend.Nextˉline;
    var Currentˉcolumn: u32 = Afterˉmoduleˉend.Nextˉcolumn;
    var Declaredˉprofile: Compilerˉsourceˉprofile = Compilerˉsourceˉprofile.None;
    let Metadataˉform: Sourceˉlexer.Compilerˉsourceˉtoken =
        Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(Input, Cursor, Currentˉline, Currentˉcolumn);
    if Metadataˉform.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Profile {
        let Profileˉtoken: Sourceˉlexer.Compilerˉsourceˉtoken =
            Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                Input, Metadataˉform.Nextˉoffset, Metadataˉform.Nextˉline, Metadataˉform.Nextˉcolumn
            );
        if Profileˉtoken.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Identifier &&
            Sourceˉlexer.Compilerˉsourceˉspanˉequalsˉtext(
                Input, Profileˉtoken.Offset, Profileˉtoken.Length, "core"
            ) {
            Declaredˉprofile = Compilerˉsourceˉprofile.Portable;
        }
        if Profileˉtoken.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Hosted {
            Declaredˉprofile = Compilerˉsourceˉprofile.Hosted;
        }
        if Profileˉtoken.Kind == Sourceˉlexer.Compilerˉtokenˉkind.System {
            Declaredˉprofile = Compilerˉsourceˉprofile.System;
        }
        if Declaredˉprofile == Compilerˉsourceˉprofile.None {
            let Badˉprofile: Compilerˉparseˉstep = Compilerˉparseˉstepˉfromˉtoken(
                Compilerˉparseˉstatus.Invalidˉprofile,
                Profileˉtoken,
                Sourceˉlexer.Compilerˉtokenˉkind.Identifier
            );
            return Compilerˉsourceˉheader(Badˉprofile.Status, Badˉprofile.Lexicalˉstatus, Compilerˉsourceˉprofile.None, Name.Offset, Name.Length, Badˉprofile.Nextˉoffset, Badˉprofile.Nextˉline, Badˉprofile.Nextˉcolumn, Badˉprofile.Failureˉoffset, Badˉprofile.Failureˉline, Badˉprofile.Failureˉcolumn, Badˉprofile.Expected, Badˉprofile.Found);
        }
        let Afterˉdeclaredˉprofile: Compilerˉparseˉstep = Compilerˉparseˉconsume(
            Input, Profileˉtoken.Nextˉoffset, Profileˉtoken.Nextˉline, Profileˉtoken.Nextˉcolumn,
            Sourceˉlexer.Compilerˉtokenˉkind.Semicolon
        );
        if Afterˉdeclaredˉprofile.Status != Compilerˉparseˉstatus.Valid {
            return Compilerˉsourceˉheader(Afterˉdeclaredˉprofile.Status, Afterˉdeclaredˉprofile.Lexicalˉstatus, Compilerˉsourceˉprofile.None, Name.Offset, Name.Length, Afterˉdeclaredˉprofile.Nextˉoffset, Afterˉdeclaredˉprofile.Nextˉline, Afterˉdeclaredˉprofile.Nextˉcolumn, Afterˉdeclaredˉprofile.Failureˉoffset, Afterˉdeclaredˉprofile.Failureˉline, Afterˉdeclaredˉprofile.Failureˉcolumn, Afterˉdeclaredˉprofile.Expected, Afterˉdeclaredˉprofile.Found);
        }
        Cursor = Afterˉdeclaredˉprofile.Nextˉoffset;
        Currentˉline = Afterˉdeclaredˉprofile.Nextˉline;
        Currentˉcolumn = Afterˉdeclaredˉprofile.Nextˉcolumn;
    }
    let Afterˉplatform: Compilerˉparseˉstep = Compilerˉparseˉconsume(
        Input, Cursor, Currentˉline, Currentˉcolumn,
