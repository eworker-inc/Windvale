                            Field.Status, Field.Lexicalˉstatus,
                            Field.Nextˉoffset, Field.Nextˉline, Field.Nextˉcolumn,
                            Field.Failureˉoffset, Field.Failureˉline,
                            Field.Failureˉcolumn, Field.Expected, Field.Found,
                            Compilerˉsourceˉtypeˉkind.Unknown, 0u32
                        );
                        return Compilerˉsourceˉdeclarationˉfailure(
                            Failure, Compilerˉsourceˉdeclarationˉkind.Variant,
                            Isˉexported, Token.Offset, Name.Offset, Name.Length
                        );
                    }
                    Fields = Fields + 1u32;
                    if Fields > 64u32 {
                        let Fieldˉtoken: Sourceˉlexer.Compilerˉsourceˉtoken =
                            Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                                Input, Fieldˉcursor, Fieldˉline, Fieldˉcolumn
                            );
                        let Fieldˉlimit: Compilerˉparseˉstep =
                            Compilerˉparseˉstepˉfromˉtoken(
                                Compilerˉparseˉstatus.Itemˉlimit,
                                Fieldˉtoken,
                                Sourceˉlexer.Compilerˉtokenˉkind.Rightˉparenthesis
                            );
                        return Compilerˉsourceˉdeclarationˉfailure(
                            Fieldˉlimit,
                            Compilerˉsourceˉdeclarationˉkind.Variant,
                            Isˉexported, Token.Offset, Name.Offset, Name.Length
                        );
                    }
                    let Separator: Sourceˉlexer.Compilerˉsourceˉtoken =
                        Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                            Input, Field.Nextˉoffset, Field.Nextˉline,
                            Field.Nextˉcolumn
                        );
                    if Separator.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Comma {
                        let Afterˉcomma: Sourceˉlexer.Compilerˉsourceˉtoken =
                            Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                                Input, Separator.Nextˉoffset,
                                Separator.Nextˉline, Separator.Nextˉcolumn
                            );
                        if Afterˉcomma.Kind ==
                            Sourceˉlexer.Compilerˉtokenˉkind.Rightˉparenthesis {
                            Readingˉfields = false;
                            Fieldˉcursor = Afterˉcomma.Offset;
                            Fieldˉline = Afterˉcomma.Line;
                            Fieldˉcolumn = Afterˉcomma.Column;
                        } else {
                            Fieldˉcursor = Separator.Nextˉoffset;
                            Fieldˉline = Separator.Nextˉline;
                            Fieldˉcolumn = Separator.Nextˉcolumn;
                        }
                    } else {
                        Readingˉfields = false;
                        Fieldˉcursor = Field.Nextˉoffset;
                        Fieldˉline = Field.Nextˉline;
                        Fieldˉcolumn = Field.Nextˉcolumn;
                    }
                }
                let Afterˉright: Compilerˉparseˉstep = Compilerˉparseˉconsume(
                    Input, Fieldˉcursor, Fieldˉline, Fieldˉcolumn,
                    Sourceˉlexer.Compilerˉtokenˉkind.Rightˉparenthesis
