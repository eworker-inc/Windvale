module Compilerˉsourceˉdeclarationˉparser profile portable;

import Compilerˉsourceˉlexer as Sourceˉlexer;

export enum Compilerˉparseˉstatus {
    Valid = 0;
    Lexicalˉerror = 1;
    Expectedˉtoken = 2;
    Invalidˉprofile = 3;
    Importˉafterˉdeclaration = 4;
    Unexpectedˉdeclaration = 5;
    Invalidˉtype = 6;
    Invalidˉdataˉtype = 7;
    Invalidˉliteral = 8;
    Nestingˉlimit = 9;
    Itemˉlimit = 10;
    Invalidˉmetadata = 11;
}

export enum Compilerˉsourceˉprofile {
    None = 0;
    Portable = 1;
    Hosted = 2;
    System = 3;
}

export enum Compilerˉsourceˉtypeˉkind {
    Unknown = 0;
    I32 = 1;
    U8 = 2;
    U32 = 3;
    Bool = 4;
    Text = 5;
    Bytes = 6;
    Void = 7;
    Named = 8;
    I32ˉarray = 9;
    Sequence = 10;
    Builder = 11;
    I64 = 12;
    U64 = 13;
    Unit = 14;
    Never = 15;
    I8 = 16;
    I16 = 17;
    U16 = 18;
    F32 = 19;
    F64 = 20;
    Rune = 21;
    Array = 22;
}

export const COMPILER_SOURCE_BORROW_MODE_VALUE: u32 = 0u32;
export const COMPILER_SOURCE_BORROW_MODE_IMMUTABLE: u32 = 1u32;
export const COMPILER_SOURCE_BORROW_MODE_MUTABLE: u32 = 2u32;

export enum Compilerˉsourceˉdeclarationˉkind {
    End = 0;
    Import = 1;
    Capability = 2;
    Data = 3;
    Record = 4;
    Enum = 5;
    Function = 6;
    Constant = 7;
    Optionalˉcapability = 8;
    Variant = 9;
    Fixedˉarray = 10;
}

export record Compilerˉparseˉstep {
    Status: Compilerˉparseˉstatus;
    Lexicalˉstatus: Sourceˉlexer.Compilerˉlexˉstatus;
    Nextˉoffset: u32;
    Nextˉline: u32;
    Nextˉcolumn: u32;
    Failureˉoffset: u32;
    Failureˉline: u32;
    Failureˉcolumn: u32;
    Expected: Sourceˉlexer.Compilerˉtokenˉkind;
    Found: Sourceˉlexer.Compilerˉtokenˉkind;
    Typeˉkind: Compilerˉsourceˉtypeˉkind;
    Items: u32;
}

export record Compilerˉsourceˉheader {
    Status: Compilerˉparseˉstatus;
    Lexicalˉstatus: Sourceˉlexer.Compilerˉlexˉstatus;
    Profile: Compilerˉsourceˉprofile;
    Nameˉoffset: u32;
    Nameˉlength: u32;
    Nextˉoffset: u32;
    Nextˉline: u32;
    Nextˉcolumn: u32;
    Failureˉoffset: u32;
    Failureˉline: u32;
    Failureˉcolumn: u32;
    Expected: Sourceˉlexer.Compilerˉtokenˉkind;
    Found: Sourceˉlexer.Compilerˉtokenˉkind;
}

export record Compilerˉsourceˉdeclaration {
    Status: Compilerˉparseˉstatus;
    Lexicalˉstatus: Sourceˉlexer.Compilerˉlexˉstatus;
    Kind: Compilerˉsourceˉdeclarationˉkind;
    Isˉexported: bool;
    Nameˉoffset: u32;
    Nameˉlength: u32;
    Declarationˉoffset: u32;
    Declarationˉlength: u32;
    Bodyˉoffset: u32;
    Bodyˉlength: u32;
    Items: u32;
    Nextˉoffset: u32;
    Nextˉline: u32;
    Nextˉcolumn: u32;
    Failureˉoffset: u32;
    Failureˉline: u32;
    Failureˉcolumn: u32;
    Expected: Sourceˉlexer.Compilerˉtokenˉkind;
    Found: Sourceˉlexer.Compilerˉtokenˉkind;
}

export record Compilerˉsourceˉvariantˉfield {
    Status: Compilerˉparseˉstatus;
    Lexicalˉstatus: Sourceˉlexer.Compilerˉlexˉstatus;
    Nameˉoffset: u32;
    Nameˉlength: u32;
    Typeˉoffset: u32;
    Typeˉlength: u32;
    Nextˉoffset: u32;
    Nextˉline: u32;
    Nextˉcolumn: u32;
    Failureˉoffset: u32;
    Failureˉline: u32;
    Failureˉcolumn: u32;
    Expected: Sourceˉlexer.Compilerˉtokenˉkind;
    Found: Sourceˉlexer.Compilerˉtokenˉkind;
}

export record Compilerˉsourceˉmoduleˉsummary {
    Status: Compilerˉparseˉstatus;
    Lexicalˉstatus: Sourceˉlexer.Compilerˉlexˉstatus;
    Profile: Compilerˉsourceˉprofile;
    Nameˉoffset: u32;
    Nameˉlength: u32;
    Imports: u32;
    Capabilities: u32;
    Data: u32;
    Records: u32;
    Enums: u32;
    Functions: u32;
    Tokens: u32;
    Endˉoffset: u32;
    Endˉline: u32;
    Endˉcolumn: u32;
    Failureˉoffset: u32;
    Failureˉline: u32;
    Failureˉcolumn: u32;
    Expected: Sourceˉlexer.Compilerˉtokenˉkind;
    Found: Sourceˉlexer.Compilerˉtokenˉkind;
}

export fn Compilerˉsourceˉtypeˉkindˉfromˉtoken(
    Kind: Sourceˉlexer.Compilerˉtokenˉkind
) -> Compilerˉsourceˉtypeˉkind {
    if Kind == Sourceˉlexer.Compilerˉtokenˉkind.I8 { return Compilerˉsourceˉtypeˉkind.I8; }
    if Kind == Sourceˉlexer.Compilerˉtokenˉkind.I16 { return Compilerˉsourceˉtypeˉkind.I16; }
    if Kind == Sourceˉlexer.Compilerˉtokenˉkind.I32 { return Compilerˉsourceˉtypeˉkind.I32; }
    if Kind == Sourceˉlexer.Compilerˉtokenˉkind.U8 { return Compilerˉsourceˉtypeˉkind.U8; }
    if Kind == Sourceˉlexer.Compilerˉtokenˉkind.U16 { return Compilerˉsourceˉtypeˉkind.U16; }
    if Kind == Sourceˉlexer.Compilerˉtokenˉkind.U32 { return Compilerˉsourceˉtypeˉkind.U32; }
    if Kind == Sourceˉlexer.Compilerˉtokenˉkind.I64 { return Compilerˉsourceˉtypeˉkind.I64; }
    if Kind == Sourceˉlexer.Compilerˉtokenˉkind.U64 { return Compilerˉsourceˉtypeˉkind.U64; }
    if Kind == Sourceˉlexer.Compilerˉtokenˉkind.Bool { return Compilerˉsourceˉtypeˉkind.Bool; }
    if Kind == Sourceˉlexer.Compilerˉtokenˉkind.F32 { return Compilerˉsourceˉtypeˉkind.F32; }
    if Kind == Sourceˉlexer.Compilerˉtokenˉkind.F64 { return Compilerˉsourceˉtypeˉkind.F64; }
    if Kind == Sourceˉlexer.Compilerˉtokenˉkind.Rune { return Compilerˉsourceˉtypeˉkind.Rune; }
    if Kind == Sourceˉlexer.Compilerˉtokenˉkind.Unit { return Compilerˉsourceˉtypeˉkind.Unit; }
    if Kind == Sourceˉlexer.Compilerˉtokenˉkind.Never { return Compilerˉsourceˉtypeˉkind.Never; }
    if Kind == Sourceˉlexer.Compilerˉtokenˉkind.Text { return Compilerˉsourceˉtypeˉkind.Text; }
    if Kind == Sourceˉlexer.Compilerˉtokenˉkind.Bytes { return Compilerˉsourceˉtypeˉkind.Bytes; }
    if Kind == Sourceˉlexer.Compilerˉtokenˉkind.Void { return Compilerˉsourceˉtypeˉkind.Void; }
    if Kind == Sourceˉlexer.Compilerˉtokenˉkind.Identifier { return Compilerˉsourceˉtypeˉkind.Named; }
    if Kind == Sourceˉlexer.Compilerˉtokenˉkind.Sequence { return Compilerˉsourceˉtypeˉkind.Sequence; }
    if Kind == Sourceˉlexer.Compilerˉtokenˉkind.Builder { return Compilerˉsourceˉtypeˉkind.Builder; }
    return Compilerˉsourceˉtypeˉkind.Unknown;
}

export fn Compilerˉparseˉstepˉvalid(
    Offset: u32,
    Line: u32,
    Column: u32,
    Typeˉkind: Compilerˉsourceˉtypeˉkind,
    Items: u32
) -> Compilerˉparseˉstep {
    return Compilerˉparseˉstep(
        Compilerˉparseˉstatus.Valid,
        Sourceˉlexer.Compilerˉlexˉstatus.Valid,
        Offset,
        Line,
        Column,
        Offset,
        Line,
        Column,
        Sourceˉlexer.Compilerˉtokenˉkind.End,
        Sourceˉlexer.Compilerˉtokenˉkind.End,
        Typeˉkind,
        Items
    );
}

export fn Compilerˉparseˉstepˉfailure(
    Status: Compilerˉparseˉstatus,
    Lexicalˉstatus: Sourceˉlexer.Compilerˉlexˉstatus,
    Offset: u32,
    Line: u32,
    Column: u32,
    Expected: Sourceˉlexer.Compilerˉtokenˉkind,
    Found: Sourceˉlexer.Compilerˉtokenˉkind
) -> Compilerˉparseˉstep {
    return Compilerˉparseˉstep(
        Status,
        Lexicalˉstatus,
        Offset,
        Line,
        Column,
        Offset,
        Line,
        Column,
        Expected,
        Found,
        Compilerˉsourceˉtypeˉkind.Unknown,
        0u32
    );
}

export fn Compilerˉparseˉstepˉfromˉtoken(
    Status: Compilerˉparseˉstatus,
    Token: Sourceˉlexer.Compilerˉsourceˉtoken,
    Expected: Sourceˉlexer.Compilerˉtokenˉkind
) -> Compilerˉparseˉstep {
    if Token.Status != Sourceˉlexer.Compilerˉlexˉstatus.Valid {
        return Compilerˉparseˉstepˉfailure(
            Compilerˉparseˉstatus.Lexicalˉerror,
            Token.Status,
            Token.Failureˉoffset,
            Token.Failureˉline,
            Token.Failureˉcolumn,
            Expected,
            Token.Kind
        );
    }
    return Compilerˉparseˉstepˉfailure(
        Status,
        Sourceˉlexer.Compilerˉlexˉstatus.Valid,
        Token.Offset,
        Token.Line,
        Token.Column,
        Expected,
        Token.Kind
    );
}

export fn Compilerˉparseˉconsume(
    Input: bytes,
    Offset: u32,
    Line: u32,
    Column: u32,
    Expected: Sourceˉlexer.Compilerˉtokenˉkind
) -> Compilerˉparseˉstep {
    let Token: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(Input, Offset, Line, Column);
    if Token.Status != Sourceˉlexer.Compilerˉlexˉstatus.Valid {
        return Compilerˉparseˉstepˉfromˉtoken(
            Compilerˉparseˉstatus.Lexicalˉerror,
            Token,
            Expected
        );
    }
    if Token.Kind != Expected {
        return Compilerˉparseˉstepˉfromˉtoken(
            Compilerˉparseˉstatus.Expectedˉtoken,
            Token,
            Expected
        );
    }
    return Compilerˉparseˉstepˉvalid(
        Token.Nextˉoffset,
        Token.Nextˉline,
        Token.Nextˉcolumn,
        Compilerˉsourceˉtypeˉkind.Unknown,
        0u32
    );
}

export fn Compilerˉparseˉqualifiedˉname(
    Input: bytes,
    Offset: u32,
    Line: u32,
    Column: u32,
    Allowˉlength: bool
) -> Compilerˉparseˉstep {
    let First: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(Input, Offset, Line, Column);
    if First.Status != Sourceˉlexer.Compilerˉlexˉstatus.Valid {
        return Compilerˉparseˉstepˉfromˉtoken(
            Compilerˉparseˉstatus.Lexicalˉerror,
            First,
            Sourceˉlexer.Compilerˉtokenˉkind.Identifier
        );
    }
    var Firstˉaccepted: bool = First.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Identifier;
    if Allowˉlength {
        if First.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Length { Firstˉaccepted = true; }
    }
    if !Firstˉaccepted {
        return Compilerˉparseˉstepˉfromˉtoken(
            Compilerˉparseˉstatus.Expectedˉtoken,
            First,
            Sourceˉlexer.Compilerˉtokenˉkind.Identifier
        );
    }
    var Cursor: u32 = First.Nextˉoffset;
    var Currentˉline: u32 = First.Nextˉline;
    var Currentˉcolumn: u32 = First.Nextˉcolumn;
    var Parts: u32 = 1u32;
    var Reading: bool = true;
    while Reading {
        let Current: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Input,
            Cursor,
            Currentˉline,
            Currentˉcolumn
        );
        if Current.Status != Sourceˉlexer.Compilerˉlexˉstatus.Valid {
            return Compilerˉparseˉstepˉfromˉtoken(
                Compilerˉparseˉstatus.Lexicalˉerror,
                Current,
                Sourceˉlexer.Compilerˉtokenˉkind.Identifier
            );
        }
        if Current.Kind != Sourceˉlexer.Compilerˉtokenˉkind.Dot {
            Reading = false;
        } else {
            let Part: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                Input,
                Current.Nextˉoffset,
                Current.Nextˉline,
                Current.Nextˉcolumn
            );
            if Part.Status != Sourceˉlexer.Compilerˉlexˉstatus.Valid {
                return Compilerˉparseˉstepˉfromˉtoken(
                    Compilerˉparseˉstatus.Lexicalˉerror,
                    Part,
                    Sourceˉlexer.Compilerˉtokenˉkind.Identifier
                );
            }
            if Part.Kind != Sourceˉlexer.Compilerˉtokenˉkind.Identifier {
                return Compilerˉparseˉstepˉfromˉtoken(
                    Compilerˉparseˉstatus.Expectedˉtoken,
                    Part,
                    Sourceˉlexer.Compilerˉtokenˉkind.Identifier
                );
            }
            Parts = Parts + 1u32;
            if Parts > 16u32 {
                return Compilerˉparseˉstepˉfromˉtoken(
                    Compilerˉparseˉstatus.Itemˉlimit,
                    Part,
                    Sourceˉlexer.Compilerˉtokenˉkind.Identifier
                );
            }
            Cursor = Part.Nextˉoffset;
            Currentˉline = Part.Nextˉline;
            Currentˉcolumn = Part.Nextˉcolumn;
        }
    }
    return Compilerˉparseˉstepˉvalid(
        Cursor,
        Currentˉline,
        Currentˉcolumn,
        Compilerˉsourceˉtypeˉkind.Unknown,
        Parts
    );
}

fn Compilerˉparseˉtypeˉnested(
    Input: bytes,
    Offset: u32,
    Line: u32,
    Column: u32,
    Allowˉvoid: bool,
    Allowˉarray: bool,
    Depth: u32
) -> Compilerˉparseˉstep {
    let Token: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(Input, Offset, Line, Column);
    if Depth > 32u32 {
        return Compilerˉparseˉstepˉfromˉtoken(
            Compilerˉparseˉstatus.Nestingˉlimit,
            Token,
            Sourceˉlexer.Compilerˉtokenˉkind.Greater
        );
    }
    if Token.Status != Sourceˉlexer.Compilerˉlexˉstatus.Valid {
        return Compilerˉparseˉstepˉfromˉtoken(
            Compilerˉparseˉstatus.Lexicalˉerror,
            Token,
            Sourceˉlexer.Compilerˉtokenˉkind.Identifier
        );
    }
    if Allowˉarray {
        if Token.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Leftˉbracket {
            let Arrayˉelement: Compilerˉparseˉstep = Compilerˉparseˉconsume(
                Input,
                Token.Nextˉoffset,
                Token.Nextˉline,
                Token.Nextˉcolumn,
                Sourceˉlexer.Compilerˉtokenˉkind.I32
            );
            if Arrayˉelement.Status != Compilerˉparseˉstatus.Valid { return Arrayˉelement; }
            let Arrayˉend: Compilerˉparseˉstep = Compilerˉparseˉconsume(
                Input,
                Arrayˉelement.Nextˉoffset,
                Arrayˉelement.Nextˉline,
                Arrayˉelement.Nextˉcolumn,
                Sourceˉlexer.Compilerˉtokenˉkind.Rightˉbracket
            );
            if Arrayˉend.Status != Compilerˉparseˉstatus.Valid { return Arrayˉend; }
            return Compilerˉparseˉstepˉvalid(
                Arrayˉend.Nextˉoffset,
                Arrayˉend.Nextˉline,
                Arrayˉend.Nextˉcolumn,
                Compilerˉsourceˉtypeˉkind.I32ˉarray,
                0u32
            );
        }
    }
    if Token.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Sequence || Token.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Builder {
        let Left: Compilerˉparseˉstep = Compilerˉparseˉconsume(
            Input, Token.Nextˉoffset, Token.Nextˉline, Token.Nextˉcolumn,
            Sourceˉlexer.Compilerˉtokenˉkind.Less
        );
        if Left.Status != Compilerˉparseˉstatus.Valid { return Left; }
        let Element: Compilerˉparseˉstep = Compilerˉparseˉtypeˉnested(
            Input, Left.Nextˉoffset, Left.Nextˉline, Left.Nextˉcolumn,
            false, false, Depth + 1u32
        );
        if Element.Status != Compilerˉparseˉstatus.Valid { return Element; }
        if Element.Typeˉkind == Compilerˉsourceˉtypeˉkind.Sequence || Element.Typeˉkind == Compilerˉsourceˉtypeˉkind.Builder {
            return Compilerˉparseˉstepˉfailure(
                Compilerˉparseˉstatus.Invalidˉtype,
                Sourceˉlexer.Compilerˉlexˉstatus.Valid,
                Left.Nextˉoffset, Left.Nextˉline, Left.Nextˉcolumn,
                Sourceˉlexer.Compilerˉtokenˉkind.Identifier,
                Token.Kind
            );
        }
        let Comma: Compilerˉparseˉstep = Compilerˉparseˉconsume(
            Input, Element.Nextˉoffset, Element.Nextˉline, Element.Nextˉcolumn,
            Sourceˉlexer.Compilerˉtokenˉkind.Comma
        );
        if Comma.Status != Compilerˉparseˉstatus.Valid { return Comma; }
        let Maximum: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Input, Comma.Nextˉoffset, Comma.Nextˉline, Comma.Nextˉcolumn
        );
        if Maximum.Kind != Sourceˉlexer.Compilerˉtokenˉkind.Identifier &&
            (Maximum.Kind != Sourceˉlexer.Compilerˉtokenˉkind.Integer ||
                Maximum.Numericˉkind != Sourceˉlexer.Compilerˉnumericˉkind.I32 ||
                Maximum.Numericˉvalue == 0u32 ||
                Maximum.Numericˉvalue > 4095u32) {
            return Compilerˉparseˉstepˉfromˉtoken(
                Compilerˉparseˉstatus.Invalidˉliteral,
                Maximum,
                Sourceˉlexer.Compilerˉtokenˉkind.Integer
            );
        }
        let Right: Compilerˉparseˉstep = Compilerˉparseˉconsume(
            Input, Maximum.Nextˉoffset, Maximum.Nextˉline, Maximum.Nextˉcolumn,
            Sourceˉlexer.Compilerˉtokenˉkind.Greater
        );
        if Right.Status != Compilerˉparseˉstatus.Valid { return Right; }
        var Collectionˉkind: Compilerˉsourceˉtypeˉkind = Compilerˉsourceˉtypeˉkind.Builder;
        if Token.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Sequence { Collectionˉkind = Compilerˉsourceˉtypeˉkind.Sequence; }
        return Compilerˉparseˉstepˉvalid(
            Right.Nextˉoffset, Right.Nextˉline, Right.Nextˉcolumn,
            Collectionˉkind, Maximum.Numericˉvalue
        );
    }
    var Kind: Compilerˉsourceˉtypeˉkind =
        Compilerˉsourceˉtypeˉkindˉfromˉtoken(Token.Kind);
    if Kind == Compilerˉsourceˉtypeˉkind.Void && !Allowˉvoid {
        Kind = Compilerˉsourceˉtypeˉkind.Unknown;
    }
    if Kind == Compilerˉsourceˉtypeˉkind.Unknown {
        return Compilerˉparseˉstepˉfromˉtoken(
            Compilerˉparseˉstatus.Invalidˉtype,
            Token,
            Sourceˉlexer.Compilerˉtokenˉkind.Identifier
        );
    }
    if Kind == Compilerˉsourceˉtypeˉkind.Named {
        let Qualified: Compilerˉparseˉstep = Compilerˉparseˉqualifiedˉname(
            Input,
            Offset,
            Line,
            Column,
            false
        );
        if Qualified.Status != Compilerˉparseˉstatus.Valid { return Qualified; }
        let Argumentsˉstart: Sourceˉlexer.Compilerˉsourceˉtoken =
            Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                Input, Qualified.Nextˉoffset, Qualified.Nextˉline,
                Qualified.Nextˉcolumn
            );
        if Argumentsˉstart.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Less {
            var Cursor: u32 = Argumentsˉstart.Nextˉoffset;
            var Currentˉline: u32 = Argumentsˉstart.Nextˉline;
            var Currentˉcolumn: u32 = Argumentsˉstart.Nextˉcolumn;
            var Arguments: u32 = 0u32;
            var Reading: bool = true;
            while Reading {
                let Genericˉargumentˉtoken: Sourceˉlexer.Compilerˉsourceˉtoken =
                    Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                        Input, Cursor, Currentˉline, Currentˉcolumn
                    );
                var Argument: Compilerˉparseˉstep = Compilerˉparseˉstepˉvalid(
                    Genericˉargumentˉtoken.Nextˉoffset,
                    Genericˉargumentˉtoken.Nextˉline,
                    Genericˉargumentˉtoken.Nextˉcolumn,
                    Compilerˉsourceˉtypeˉkind.Unknown, 0u32
                );
                if Genericˉargumentˉtoken.Kind !=
                    Sourceˉlexer.Compilerˉtokenˉkind.Integer {
                    Argument = Compilerˉparseˉtypeˉnested(
                        Input, Cursor, Currentˉline, Currentˉcolumn,
                        false, false, Depth + 1u32
                    );
                }
                if Argument.Status != Compilerˉparseˉstatus.Valid {
                    return Argument;
                }
                Arguments = Arguments + 1u32;
                if Arguments > 32u32 {
                    let Excess: Sourceˉlexer.Compilerˉsourceˉtoken =
                        Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                            Input, Cursor, Currentˉline, Currentˉcolumn
                        );
                    return Compilerˉparseˉstepˉfromˉtoken(
                        Compilerˉparseˉstatus.Itemˉlimit,
                        Excess,
                        Sourceˉlexer.Compilerˉtokenˉkind.Greater
                    );
                }
                let Separator: Sourceˉlexer.Compilerˉsourceˉtoken =
                    Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                        Input, Argument.Nextˉoffset, Argument.Nextˉline,
                        Argument.Nextˉcolumn
                    );
                if Separator.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Greater {
                    return Compilerˉparseˉstepˉvalid(
                        Separator.Nextˉoffset, Separator.Nextˉline,
                        Separator.Nextˉcolumn, Kind, Qualified.Items
                    );
                }
                if Separator.Kind != Sourceˉlexer.Compilerˉtokenˉkind.Comma {
                    return Compilerˉparseˉstepˉfromˉtoken(
                        Compilerˉparseˉstatus.Expectedˉtoken,
                        Separator,
                        Sourceˉlexer.Compilerˉtokenˉkind.Greater
                    );
                }
                let Afterˉcomma: Sourceˉlexer.Compilerˉsourceˉtoken =
                    Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                        Input, Separator.Nextˉoffset, Separator.Nextˉline,
                        Separator.Nextˉcolumn
                    );
                if Afterˉcomma.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Greater {
                    return Compilerˉparseˉstepˉvalid(
                        Afterˉcomma.Nextˉoffset, Afterˉcomma.Nextˉline,
                        Afterˉcomma.Nextˉcolumn, Kind, Qualified.Items
                    );
                }
                Cursor = Separator.Nextˉoffset;
                Currentˉline = Separator.Nextˉline;
                Currentˉcolumn = Separator.Nextˉcolumn;
            }
        }
        return Compilerˉparseˉstepˉvalid(
            Qualified.Nextˉoffset,
            Qualified.Nextˉline,
            Qualified.Nextˉcolumn,
            Kind,
            Qualified.Items
        );
    }
    return Compilerˉparseˉstepˉvalid(
        Token.Nextˉoffset,
        Token.Nextˉline,
        Token.Nextˉcolumn,
        Kind,
        0u32
    );
}

export fn Compilerˉparseˉtype(
    Input: bytes,
    Offset: u32,
    Line: u32,
    Column: u32,
    Allowˉvoid: bool,
    Allowˉarray: bool
) -> Compilerˉparseˉstep {
    return Compilerˉparseˉtypeˉnested(
        Input, Offset, Line, Column, Allowˉvoid, Allowˉarray, 0u32
    );
}

export fn Compilerˉsourceˉparameterˉtypeˉstart(
    Input: bytes,
    Offset: u32,
    Line: u32,
    Column: u32
) -> Sourceˉlexer.Compilerˉsourceˉtoken {
    let First: Sourceˉlexer.Compilerˉsourceˉtoken =
        Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Input, Offset, Line, Column
        );
    if First.Kind != Sourceˉlexer.Compilerˉtokenˉkind.Borrow { return First; }
    let Maybeˉmutable: Sourceˉlexer.Compilerˉsourceˉtoken =
        Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Input, First.Nextˉoffset,
            First.Nextˉline, First.Nextˉcolumn
        );
    if Maybeˉmutable.Kind != Sourceˉlexer.Compilerˉtokenˉkind.Mut {
        return Maybeˉmutable;
    }
    return Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
        Input, Maybeˉmutable.Nextˉoffset,
        Maybeˉmutable.Nextˉline, Maybeˉmutable.Nextˉcolumn
    );
}

export fn Compilerˉsourceˉparameterˉborrowˉmode(
    Input: bytes,
    Offset: u32,
    Line: u32,
    Column: u32
) -> u32 {
    let First: Sourceˉlexer.Compilerˉsourceˉtoken =
        Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Input, Offset, Line, Column
        );
    if First.Kind != Sourceˉlexer.Compilerˉtokenˉkind.Borrow {
        return COMPILER_SOURCE_BORROW_MODE_VALUE;
    }
    let Maybeˉmutable: Sourceˉlexer.Compilerˉsourceˉtoken =
        Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Input, First.Nextˉoffset,
            First.Nextˉline, First.Nextˉcolumn
        );
    if Maybeˉmutable.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Mut {
        return COMPILER_SOURCE_BORROW_MODE_MUTABLE;
    }
    return COMPILER_SOURCE_BORROW_MODE_IMMUTABLE;
}

export fn Compilerˉparseˉparameterˉtype(
    Input: bytes,
    Offset: u32,
    Line: u32,
    Column: u32,
    Allowˉvoid: bool
) -> Compilerˉparseˉstep {
    let Type: Sourceˉlexer.Compilerˉsourceˉtoken =
        Compilerˉsourceˉparameterˉtypeˉstart(
            Input, Offset, Line, Column
        );
    return Compilerˉparseˉtype(
        Input, Type.Offset, Type.Line, Type.Column, Allowˉvoid, false
    );
}

export fn Compilerˉparseˉi32ˉarray(
    Input: bytes,
    Offset: u32,
    Line: u32,
    Column: u32
) -> Compilerˉparseˉstep {
    let Start: Compilerˉparseˉstep = Compilerˉparseˉconsume(
        Input,
        Offset,
        Line,
        Column,
        Sourceˉlexer.Compilerˉtokenˉkind.Leftˉbracket
    );
    if Start.Status != Compilerˉparseˉstatus.Valid { return Start; }
    var Cursor: u32 = Start.Nextˉoffset;
    var Currentˉline: u32 = Start.Nextˉline;
    var Currentˉcolumn: u32 = Start.Nextˉcolumn;
    var Items: u32 = 0u32;
    var Reading: bool = true;
    while Reading {
        var Current: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Input,
            Cursor,
            Currentˉline,
            Currentˉcolumn
        );
        if Current.Status != Sourceˉlexer.Compilerˉlexˉstatus.Valid {
            return Compilerˉparseˉstepˉfromˉtoken(
                Compilerˉparseˉstatus.Lexicalˉerror,
                Current,
                Sourceˉlexer.Compilerˉtokenˉkind.Integer
            );
        }
        if Current.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Rightˉbracket {
            Reading = false;
        } else {
            if Current.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Minus {
                Current = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                    Input,
                    Current.Nextˉoffset,
                    Current.Nextˉline,
                    Current.Nextˉcolumn
                );
            }
            if Current.Kind != Sourceˉlexer.Compilerˉtokenˉkind.Integer {
                return Compilerˉparseˉstepˉfromˉtoken(
                    Compilerˉparseˉstatus.Invalidˉliteral,
                    Current,
                    Sourceˉlexer.Compilerˉtokenˉkind.Integer
                );
            }
            if Current.Numericˉkind != Sourceˉlexer.Compilerˉnumericˉkind.I32 {
                return Compilerˉparseˉstepˉfromˉtoken(
                    Compilerˉparseˉstatus.Invalidˉliteral,
                    Current,
                    Sourceˉlexer.Compilerˉtokenˉkind.Integer
                );
            }
            Items = Items + 1u32;
            if Items > 262144u32 {
                return Compilerˉparseˉstepˉfromˉtoken(
                    Compilerˉparseˉstatus.Itemˉlimit,
                    Current,
                    Sourceˉlexer.Compilerˉtokenˉkind.Rightˉbracket
                );
            }
            Cursor = Current.Nextˉoffset;
            Currentˉline = Current.Nextˉline;
            Currentˉcolumn = Current.Nextˉcolumn;
            let Separator: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                Input,
                Cursor,
                Currentˉline,
                Currentˉcolumn
            );
            if Separator.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Comma {
                Cursor = Separator.Nextˉoffset;
                Currentˉline = Separator.Nextˉline;
                Currentˉcolumn = Separator.Nextˉcolumn;
            } else {
                Reading = false;
            }
        }
    }
    let End: Compilerˉparseˉstep = Compilerˉparseˉconsume(
        Input,
        Cursor,
        Currentˉline,
        Currentˉcolumn,
        Sourceˉlexer.Compilerˉtokenˉkind.Rightˉbracket
    );
    if End.Status != Compilerˉparseˉstatus.Valid { return End; }
    return Compilerˉparseˉstepˉvalid(
        End.Nextˉoffset,
        End.Nextˉline,
        End.Nextˉcolumn,
        Compilerˉsourceˉtypeˉkind.I32ˉarray,
        Items
    );
}

export fn Compilerˉparseˉbytesˉarray(
    Input: bytes,
    Offset: u32,
    Line: u32,
    Column: u32
) -> Compilerˉparseˉstep {
    let Start: Compilerˉparseˉstep = Compilerˉparseˉconsume(
        Input,
        Offset,
        Line,
        Column,
        Sourceˉlexer.Compilerˉtokenˉkind.Leftˉbracket
    );
    if Start.Status != Compilerˉparseˉstatus.Valid { return Start; }
    var Cursor: u32 = Start.Nextˉoffset;
    var Currentˉline: u32 = Start.Nextˉline;
    var Currentˉcolumn: u32 = Start.Nextˉcolumn;
    var Items: u32 = 0u32;
    var Reading: bool = true;
    while Reading {
        let Current: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Input,
            Cursor,
            Currentˉline,
            Currentˉcolumn
        );
        if Current.Status != Sourceˉlexer.Compilerˉlexˉstatus.Valid {
            return Compilerˉparseˉstepˉfromˉtoken(
                Compilerˉparseˉstatus.Lexicalˉerror,
                Current,
                Sourceˉlexer.Compilerˉtokenˉkind.Integer
            );
        }
        if Current.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Rightˉbracket {
            Reading = false;
        } else {
            if Current.Kind != Sourceˉlexer.Compilerˉtokenˉkind.Integer {
                return Compilerˉparseˉstepˉfromˉtoken(
                    Compilerˉparseˉstatus.Invalidˉliteral,
                    Current,
                    Sourceˉlexer.Compilerˉtokenˉkind.Integer
                );
            }
            var Literalˉvalid: bool = false;
            if Current.Numericˉkind == Sourceˉlexer.Compilerˉnumericˉkind.U8 { Literalˉvalid = true; }
            if Current.Numericˉkind == Sourceˉlexer.Compilerˉnumericˉkind.I32 {
                if Current.Numericˉvalue <= 255u32 { Literalˉvalid = true; }
            }
            if !Literalˉvalid {
                return Compilerˉparseˉstepˉfromˉtoken(
                    Compilerˉparseˉstatus.Invalidˉliteral,
                    Current,
                    Sourceˉlexer.Compilerˉtokenˉkind.Integer
                );
            }
            Items = Items + 1u32;
            if Items > 262144u32 {
                return Compilerˉparseˉstepˉfromˉtoken(
                    Compilerˉparseˉstatus.Itemˉlimit,
                    Current,
                    Sourceˉlexer.Compilerˉtokenˉkind.Rightˉbracket
                );
            }
            Cursor = Current.Nextˉoffset;
            Currentˉline = Current.Nextˉline;
            Currentˉcolumn = Current.Nextˉcolumn;
            let Separator: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                Input,
                Cursor,
                Currentˉline,
                Currentˉcolumn
            );
            if Separator.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Comma {
                Cursor = Separator.Nextˉoffset;
                Currentˉline = Separator.Nextˉline;
                Currentˉcolumn = Separator.Nextˉcolumn;
            } else {
                Reading = false;
            }
        }
    }
    let End: Compilerˉparseˉstep = Compilerˉparseˉconsume(
        Input,
        Cursor,
        Currentˉline,
        Currentˉcolumn,
        Sourceˉlexer.Compilerˉtokenˉkind.Rightˉbracket
    );
    if End.Status != Compilerˉparseˉstatus.Valid { return End; }
    return Compilerˉparseˉstepˉvalid(
        End.Nextˉoffset,
        End.Nextˉline,
        End.Nextˉcolumn,
        Compilerˉsourceˉtypeˉkind.Bytes,
        Items
    );
}

export fn Compilerˉparseˉskipˉblock(
    Input: bytes,
    Offset: u32,
    Line: u32,
    Column: u32
) -> Compilerˉparseˉstep {
    let Start: Compilerˉparseˉstep = Compilerˉparseˉconsume(
        Input,
        Offset,
        Line,
        Column,
        Sourceˉlexer.Compilerˉtokenˉkind.Leftˉbrace
    );
    if Start.Status != Compilerˉparseˉstatus.Valid { return Start; }
    var Cursor: u32 = Start.Nextˉoffset;
    var Currentˉline: u32 = Start.Nextˉline;
    var Currentˉcolumn: u32 = Start.Nextˉcolumn;
    var Depth: u32 = 1u32;
    var Tokens: u32 = 0u32;
    while Depth > 0u32 {
        let Current: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Input,
            Cursor,
            Currentˉline,
            Currentˉcolumn
        );
        if Current.Status != Sourceˉlexer.Compilerˉlexˉstatus.Valid {
            return Compilerˉparseˉstepˉfromˉtoken(
                Compilerˉparseˉstatus.Lexicalˉerror,
                Current,
                Sourceˉlexer.Compilerˉtokenˉkind.Rightˉbrace
            );
        }
        if Current.Kind == Sourceˉlexer.Compilerˉtokenˉkind.End {
            return Compilerˉparseˉstepˉfromˉtoken(
                Compilerˉparseˉstatus.Expectedˉtoken,
                Current,
                Sourceˉlexer.Compilerˉtokenˉkind.Rightˉbrace
            );
        }
        if Current.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Leftˉbrace {
            Depth = Depth + 1u32;
            if Depth > 64u32 {
                return Compilerˉparseˉstepˉfromˉtoken(
                    Compilerˉparseˉstatus.Nestingˉlimit,
                    Current,
                    Sourceˉlexer.Compilerˉtokenˉkind.Rightˉbrace
                );
            }
        }
        if Current.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Rightˉbrace { Depth = Depth - 1u32; }
        Tokens = Tokens + 1u32;
        Cursor = Current.Nextˉoffset;
        Currentˉline = Current.Nextˉline;
        Currentˉcolumn = Current.Nextˉcolumn;
    }
    return Compilerˉparseˉstepˉvalid(
        Cursor,
        Currentˉline,
        Currentˉcolumn,
        Compilerˉsourceˉtypeˉkind.Unknown,
        Tokens
    );
}

export fn Compilerˉparseˉskipˉblockˉafterˉscan(
    Input: bytes,
    Offset: u32,
    Line: u32,
    Column: u32
) -> Compilerˉparseˉstep {
    let Start: Compilerˉparseˉstep = Compilerˉparseˉconsume(
        Input,
        Offset,
        Line,
        Column,
        Sourceˉlexer.Compilerˉtokenˉkind.Leftˉbrace
    );
    if Start.Status != Compilerˉparseˉstatus.Valid { return Start; }
    let Total: u32 = Bytesˉlength(Input);
    var Cursor: u32 = Start.Nextˉoffset;
    var Currentˉline: u32 = Start.Nextˉline;
    var Finalˉlineˉoffset: u32 = Start.Nextˉoffset;
    var Finalˉlineˉcolumn: u32 = Start.Nextˉcolumn;
    var Depth: u32 = 1u32;
    while Depth > 0u32 {
        if Cursor >= Total { return Compilerˉparseˉskipˉblock(Input, Offset, Line, Column); }
        let Current: u8 = Bytesˉreadˉu8(Input, Cursor);
        var Startsˉcomment: bool = false;
        if Current == 47u8 {
            if Total - Cursor >= 2u32 {
                if Bytesˉreadˉu8(Input, Cursor + 1u32) == 47u8 { Startsˉcomment = true; }
            }
        }
        if Startsˉcomment {
            Cursor = Cursor + 2u32;
            var Readingˉcomment: bool = true;
            while Readingˉcomment {
                if Cursor >= Total {
                    Readingˉcomment = false;
                } else {
                    if Bytesˉreadˉu8(Input, Cursor) == 10u8 {
                        Readingˉcomment = false;
                    } else {
                        Cursor = Cursor + 1u32;
                    }
                }
            }
        } else {
            if Current == 34u8 {
                Cursor = Cursor + 1u32;
                var Readingˉstring: bool = true;
                while Readingˉstring {
                    if Cursor >= Total { return Compilerˉparseˉskipˉblock(Input, Offset, Line, Column); }
                    let Stringˉcurrent: u8 = Bytesˉreadˉu8(Input, Cursor);
                    if Stringˉcurrent == 92u8 {
                        if Total - Cursor < 2u32 { return Compilerˉparseˉskipˉblock(Input, Offset, Line, Column); }
                        Cursor = Cursor + 2u32;
                    } else {
                        Cursor = Cursor + 1u32;
                        if Stringˉcurrent == 34u8 { Readingˉstring = false; }
                    }
                }
            } else {
                if Current == 123u8 {
                    Depth = Depth + 1u32;
                    if Depth > 64u32 { return Compilerˉparseˉskipˉblock(Input, Offset, Line, Column); }
                    Cursor = Cursor + 1u32;
                } else {
                    if Current == 125u8 {
                        Depth = Depth - 1u32;
                        Cursor = Cursor + 1u32;
                    } else {
                        if Current == 10u8 {
                            Cursor = Cursor + 1u32;
                            Currentˉline = Currentˉline + 1u32;
                            Finalˉlineˉoffset = Cursor;
                            Finalˉlineˉcolumn = 1u32;
                        } else {
                            if Current == 47u8 { return Compilerˉparseˉskipˉblock(Input, Offset, Line, Column); }
                            var Readingˉordinary: bool = true;
                            while Readingˉordinary {
                                Cursor = Cursor + 1u32;
                                if Cursor >= Total {
                                    Readingˉordinary = false;
                                } else {
                                    let Ordinaryˉcurrent: u8 = Bytesˉreadˉu8(Input, Cursor);
                                    let Ordinaryˉvalue: u32 = U32ˉfromˉu8(Ordinaryˉcurrent);
                                    var Ordinaryˉspecial: bool = false;
                                    if Ordinaryˉvalue <= 47u32 {
                                        if Ordinaryˉvalue == 10u32 { Ordinaryˉspecial = true; }
                                        if Ordinaryˉvalue == 34u32 { Ordinaryˉspecial = true; }
                                        if Ordinaryˉvalue == 47u32 { Ordinaryˉspecial = true; }
                                    } else {
                                        if Ordinaryˉvalue >= 123u32 {
                                            if Ordinaryˉvalue == 123u32 { Ordinaryˉspecial = true; }
                                            if Ordinaryˉvalue == 125u32 { Ordinaryˉspecial = true; }
                                        }
                                    }
                                    if Ordinaryˉspecial { Readingˉordinary = false; }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    var Position: u32 = Finalˉlineˉoffset;
    var Currentˉcolumn: u32 = Finalˉlineˉcolumn;
    while Position < Cursor {
        if U32ˉfromˉu8(Bytesˉreadˉu8(Input, Position)) < 128u32 {
            Position = Position + 1u32;
            Currentˉcolumn = Currentˉcolumn + 1u32;
        } else {
            let Characterˉlength: u32 = Sourceˉlexer.Compilerˉsourceˉutf8ˉlength(Input, Position);
            Currentˉcolumn = Currentˉcolumn + Sourceˉlexer.Compilerˉsourceˉcolumnˉwidth(Input, Position);
            Position = Position + Characterˉlength;
        }
    }
    return Compilerˉparseˉstepˉvalid(
        Cursor,
        Currentˉline,
        Currentˉcolumn,
        Compilerˉsourceˉtypeˉkind.Unknown,
        0u32
    );
}
export fn Compilerˉsourceˉdeclarationˉmake(
    Status: Compilerˉparseˉstatus,
    Lexicalˉstatus: Sourceˉlexer.Compilerˉlexˉstatus,
    Kind: Compilerˉsourceˉdeclarationˉkind,
    Isˉexported: bool,
    Nameˉoffset: u32,
    Nameˉlength: u32,
    Declarationˉoffset: u32,
    Declarationˉend: u32,
    Bodyˉoffset: u32,
    Bodyˉend: u32,
    Items: u32,
    Nextˉoffset: u32,
    Nextˉline: u32,
    Nextˉcolumn: u32,
    Failureˉoffset: u32,
    Failureˉline: u32,
    Failureˉcolumn: u32,
    Expected: Sourceˉlexer.Compilerˉtokenˉkind,
    Found: Sourceˉlexer.Compilerˉtokenˉkind
) -> Compilerˉsourceˉdeclaration {
    return Compilerˉsourceˉdeclaration(
        Status,
        Lexicalˉstatus,
        Kind,
        Isˉexported,
        Nameˉoffset,
        Nameˉlength,
        Declarationˉoffset,
        Declarationˉend - Declarationˉoffset,
        Bodyˉoffset,
        Bodyˉend - Bodyˉoffset,
        Items,
        Nextˉoffset,
        Nextˉline,
        Nextˉcolumn,
        Failureˉoffset,
        Failureˉline,
        Failureˉcolumn,
        Expected,
        Found
    );
}

export fn Compilerˉsourceˉdeclarationˉfailure(
    Step: Compilerˉparseˉstep,
    Kind: Compilerˉsourceˉdeclarationˉkind,
    Isˉexported: bool,
    Declarationˉoffset: u32,
    Nameˉoffset: u32,
    Nameˉlength: u32
) -> Compilerˉsourceˉdeclaration {
    return Compilerˉsourceˉdeclarationˉmake(
        Step.Status,
        Step.Lexicalˉstatus,
        Kind,
        Isˉexported,
        Nameˉoffset,
        Nameˉlength,
        Declarationˉoffset,
        Declarationˉoffset,
        Declarationˉoffset,
        Declarationˉoffset,
        0u32,
        Step.Nextˉoffset,
        Step.Nextˉline,
        Step.Nextˉcolumn,
        Step.Failureˉoffset,
        Step.Failureˉline,
        Step.Failureˉcolumn,
        Step.Expected,
        Step.Found
    );
}

export fn Compilerˉparseˉimportˉdeclaration(
    Input: bytes,
    Token: Sourceˉlexer.Compilerˉsourceˉtoken
) -> Compilerˉsourceˉdeclaration {
    let Afterˉkeyword: Compilerˉparseˉstep = Compilerˉparseˉconsume(
        Input,
        Token.Offset,
        Token.Line,
        Token.Column,
        Sourceˉlexer.Compilerˉtokenˉkind.Import
    );
    if Afterˉkeyword.Status != Compilerˉparseˉstatus.Valid {
        return Compilerˉsourceˉdeclarationˉfailure(
            Afterˉkeyword,
            Compilerˉsourceˉdeclarationˉkind.Import,
            false,
            Token.Offset,
            Token.Offset,
            0u32
        );
    }
    let Name: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
        Input,
        Afterˉkeyword.Nextˉoffset,
        Afterˉkeyword.Nextˉline,
        Afterˉkeyword.Nextˉcolumn
    );
    let Afterˉname: Compilerˉparseˉstep = Compilerˉparseˉconsume(
        Input,
        Afterˉkeyword.Nextˉoffset,
        Afterˉkeyword.Nextˉline,
        Afterˉkeyword.Nextˉcolumn,
        Sourceˉlexer.Compilerˉtokenˉkind.Identifier
    );
    if Afterˉname.Status != Compilerˉparseˉstatus.Valid {
        return Compilerˉsourceˉdeclarationˉfailure(
            Afterˉname,
            Compilerˉsourceˉdeclarationˉkind.Import,
            false,
            Token.Offset,
            Name.Offset,
            Name.Length
        );
    }
    let Afterˉas: Compilerˉparseˉstep = Compilerˉparseˉconsume(
        Input,
        Afterˉname.Nextˉoffset,
        Afterˉname.Nextˉline,
        Afterˉname.Nextˉcolumn,
        Sourceˉlexer.Compilerˉtokenˉkind.As
    );
    if Afterˉas.Status != Compilerˉparseˉstatus.Valid {
        return Compilerˉsourceˉdeclarationˉfailure(
            Afterˉas,
            Compilerˉsourceˉdeclarationˉkind.Import,
            false,
            Token.Offset,
            Name.Offset,
            Name.Length
        );
    }
    let Alias: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
        Input,
        Afterˉas.Nextˉoffset,
        Afterˉas.Nextˉline,
        Afterˉas.Nextˉcolumn
    );
    let Afterˉalias: Compilerˉparseˉstep = Compilerˉparseˉconsume(
        Input,
        Afterˉas.Nextˉoffset,
        Afterˉas.Nextˉline,
        Afterˉas.Nextˉcolumn,
        Sourceˉlexer.Compilerˉtokenˉkind.Identifier
    );
    if Afterˉalias.Status != Compilerˉparseˉstatus.Valid {
        return Compilerˉsourceˉdeclarationˉfailure(
            Afterˉalias,
            Compilerˉsourceˉdeclarationˉkind.Import,
            false,
            Token.Offset,
            Name.Offset,
            Name.Length
        );
    }
    let End: Compilerˉparseˉstep = Compilerˉparseˉconsume(
        Input,
        Afterˉalias.Nextˉoffset,
        Afterˉalias.Nextˉline,
        Afterˉalias.Nextˉcolumn,
        Sourceˉlexer.Compilerˉtokenˉkind.Semicolon
    );
    if End.Status != Compilerˉparseˉstatus.Valid {
        return Compilerˉsourceˉdeclarationˉfailure(
            End,
            Compilerˉsourceˉdeclarationˉkind.Import,
            false,
            Token.Offset,
            Name.Offset,
            Name.Length
        );
    }
    return Compilerˉsourceˉdeclarationˉmake(
        Compilerˉparseˉstatus.Valid,
        Sourceˉlexer.Compilerˉlexˉstatus.Valid,
        Compilerˉsourceˉdeclarationˉkind.Import,
        false,
        Name.Offset,
        Name.Length,
        Token.Offset,
        End.Nextˉoffset,
        Alias.Offset,
        Alias.Nextˉoffset,
        0u32,
        End.Nextˉoffset,
        End.Nextˉline,
        End.Nextˉcolumn,
        End.Nextˉoffset,
        End.Nextˉline,
        End.Nextˉcolumn,
        Sourceˉlexer.Compilerˉtokenˉkind.End,
        Sourceˉlexer.Compilerˉtokenˉkind.End
    );
}

export fn Compilerˉparseˉcapabilityˉdeclaration(
    Input: bytes,
    Token: Sourceˉlexer.Compilerˉsourceˉtoken
) -> Compilerˉsourceˉdeclaration {
    let Afterˉkeyword: Compilerˉparseˉstep = Compilerˉparseˉconsume(
        Input,
        Token.Offset,
        Token.Line,
        Token.Column,
        Sourceˉlexer.Compilerˉtokenˉkind.Capability
    );
    if Afterˉkeyword.Status != Compilerˉparseˉstatus.Valid {
        return Compilerˉsourceˉdeclarationˉfailure(Afterˉkeyword, Compilerˉsourceˉdeclarationˉkind.Capability, false, Token.Offset, Token.Offset, 0u32);
    }
    let Name: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(Input, Afterˉkeyword.Nextˉoffset, Afterˉkeyword.Nextˉline, Afterˉkeyword.Nextˉcolumn);
    let Qualified: Compilerˉparseˉstep = Compilerˉparseˉqualifiedˉname(Input, Afterˉkeyword.Nextˉoffset, Afterˉkeyword.Nextˉline, Afterˉkeyword.Nextˉcolumn, false);
    if Qualified.Status != Compilerˉparseˉstatus.Valid {
        return Compilerˉsourceˉdeclarationˉfailure(Qualified, Compilerˉsourceˉdeclarationˉkind.Capability, false, Token.Offset, Name.Offset, Name.Length);
    }
    let End: Compilerˉparseˉstep = Compilerˉparseˉconsume(Input, Qualified.Nextˉoffset, Qualified.Nextˉline, Qualified.Nextˉcolumn, Sourceˉlexer.Compilerˉtokenˉkind.Semicolon);
    if End.Status != Compilerˉparseˉstatus.Valid {
        return Compilerˉsourceˉdeclarationˉfailure(End, Compilerˉsourceˉdeclarationˉkind.Capability, false, Token.Offset, Name.Offset, Qualified.Nextˉoffset - Name.Offset);
    }
    return Compilerˉsourceˉdeclarationˉmake(
        Compilerˉparseˉstatus.Valid,
        Sourceˉlexer.Compilerˉlexˉstatus.Valid,
        Compilerˉsourceˉdeclarationˉkind.Capability,
        false,
        Name.Offset,
        Qualified.Nextˉoffset - Name.Offset,
        Token.Offset,
        End.Nextˉoffset,
        Token.Offset,
        Token.Offset,
        Qualified.Items,
        End.Nextˉoffset,
        End.Nextˉline,
        End.Nextˉcolumn,
        End.Nextˉoffset,
        End.Nextˉline,
        End.Nextˉcolumn,
        Sourceˉlexer.Compilerˉtokenˉkind.End,
        Sourceˉlexer.Compilerˉtokenˉkind.End
    );
}

export fn Compilerˉparseˉmetadataˉcapabilityˉdeclaration(
    Input: bytes,
    Token: Sourceˉlexer.Compilerˉsourceˉtoken,
    Isˉoptional: bool
) -> Compilerˉsourceˉdeclaration {
    var Keyword: Sourceˉlexer.Compilerˉtokenˉkind = Sourceˉlexer.Compilerˉtokenˉkind.Requires;
    var Kind: Compilerˉsourceˉdeclarationˉkind = Compilerˉsourceˉdeclarationˉkind.Capability;
    if Isˉoptional {
        Keyword = Sourceˉlexer.Compilerˉtokenˉkind.Optional;
        Kind = Compilerˉsourceˉdeclarationˉkind.Optionalˉcapability;
    }
    let Afterˉkeyword: Compilerˉparseˉstep = Compilerˉparseˉconsume(
        Input, Token.Offset, Token.Line, Token.Column, Keyword
    );
    if Afterˉkeyword.Status != Compilerˉparseˉstatus.Valid {
        return Compilerˉsourceˉdeclarationˉfailure(Afterˉkeyword, Kind, !Isˉoptional, Token.Offset, Token.Offset, 0u32);
    }
    let Afterˉcapability: Compilerˉparseˉstep = Compilerˉparseˉconsume(
        Input, Afterˉkeyword.Nextˉoffset, Afterˉkeyword.Nextˉline, Afterˉkeyword.Nextˉcolumn,
        Sourceˉlexer.Compilerˉtokenˉkind.Capability
    );
    if Afterˉcapability.Status != Compilerˉparseˉstatus.Valid {
        return Compilerˉsourceˉdeclarationˉfailure(Afterˉcapability, Kind, !Isˉoptional, Token.Offset, Token.Offset, 0u32);
    }
    let Name: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
        Input, Afterˉcapability.Nextˉoffset, Afterˉcapability.Nextˉline, Afterˉcapability.Nextˉcolumn
    );
    let Qualified: Compilerˉparseˉstep = Compilerˉparseˉqualifiedˉname(
        Input, Afterˉcapability.Nextˉoffset, Afterˉcapability.Nextˉline, Afterˉcapability.Nextˉcolumn, false
    );
    if Qualified.Status != Compilerˉparseˉstatus.Valid {
        return Compilerˉsourceˉdeclarationˉfailure(Qualified, Kind, !Isˉoptional, Token.Offset, Name.Offset, Name.Length);
    }
    let Afterˉversion: Compilerˉparseˉstep = Compilerˉparseˉconsume(
        Input, Qualified.Nextˉoffset, Qualified.Nextˉline, Qualified.Nextˉcolumn,
        Sourceˉlexer.Compilerˉtokenˉkind.Version
    );
    if Afterˉversion.Status != Compilerˉparseˉstatus.Valid {
        return Compilerˉsourceˉdeclarationˉfailure(Afterˉversion, Kind, !Isˉoptional, Token.Offset, Name.Offset, Qualified.Nextˉoffset - Name.Offset);
    }
    let Version: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
        Input, Afterˉversion.Nextˉoffset, Afterˉversion.Nextˉline, Afterˉversion.Nextˉcolumn
    );
    if Version.Kind != Sourceˉlexer.Compilerˉtokenˉkind.Integer {
        let Invalid: Compilerˉparseˉstep = Compilerˉparseˉstepˉfromˉtoken(
            Compilerˉparseˉstatus.Invalidˉmetadata,
            Version,
            Sourceˉlexer.Compilerˉtokenˉkind.Integer
        );
        return Compilerˉsourceˉdeclarationˉfailure(Invalid, Kind, !Isˉoptional, Token.Offset, Name.Offset, Qualified.Nextˉoffset - Name.Offset);
    }
    if Version.Numericˉkind != Sourceˉlexer.Compilerˉnumericˉkind.I32 {
        let Invalidˉsuffix: Compilerˉparseˉstep = Compilerˉparseˉstepˉfromˉtoken(
            Compilerˉparseˉstatus.Invalidˉmetadata,
            Version,
            Sourceˉlexer.Compilerˉtokenˉkind.Integer
        );
        return Compilerˉsourceˉdeclarationˉfailure(Invalidˉsuffix, Kind, !Isˉoptional, Token.Offset, Name.Offset, Qualified.Nextˉoffset - Name.Offset);
    }
    if Version.Numericˉvalue != 1u32 {
        let Invalidˉmajor: Compilerˉparseˉstep = Compilerˉparseˉstepˉfromˉtoken(
            Compilerˉparseˉstatus.Invalidˉmetadata,
            Version,
            Sourceˉlexer.Compilerˉtokenˉkind.Integer
        );
        return Compilerˉsourceˉdeclarationˉfailure(Invalidˉmajor, Kind, !Isˉoptional, Token.Offset, Name.Offset, Qualified.Nextˉoffset - Name.Offset);
    }
    let End: Compilerˉparseˉstep = Compilerˉparseˉconsume(
        Input, Version.Nextˉoffset, Version.Nextˉline, Version.Nextˉcolumn,
        Sourceˉlexer.Compilerˉtokenˉkind.Semicolon
    );
    if End.Status != Compilerˉparseˉstatus.Valid {
        return Compilerˉsourceˉdeclarationˉfailure(End, Kind, !Isˉoptional, Token.Offset, Name.Offset, Qualified.Nextˉoffset - Name.Offset);
    }
    return Compilerˉsourceˉdeclarationˉmake(
        Compilerˉparseˉstatus.Valid,
        Sourceˉlexer.Compilerˉlexˉstatus.Valid,
        Kind,
        !Isˉoptional,
        Name.Offset,
        Qualified.Nextˉoffset - Name.Offset,
        Token.Offset,
        End.Nextˉoffset,
        Version.Offset,
        Version.Nextˉoffset,
        Qualified.Items,
        End.Nextˉoffset,
        End.Nextˉline,
        End.Nextˉcolumn,
        End.Nextˉoffset,
        End.Nextˉline,
        End.Nextˉcolumn,
        Sourceˉlexer.Compilerˉtokenˉkind.End,
        Sourceˉlexer.Compilerˉtokenˉkind.End
    );
}

export fn Compilerˉsourceˉdeclarationˉisˉheaderˉmetadata(
    Declaration: Compilerˉsourceˉdeclaration
) -> bool {
    if Declaration.Kind == Compilerˉsourceˉdeclarationˉkind.Optionalˉcapability { return true; }
    if Declaration.Kind == Compilerˉsourceˉdeclarationˉkind.Capability { return Declaration.Isˉexported; }
    return false;
}

export fn Compilerˉsourceˉdeclarationˉclosesˉimports(
    Declaration: Compilerˉsourceˉdeclaration
) -> bool {
    if Declaration.Kind == Compilerˉsourceˉdeclarationˉkind.Import { return false; }
    return !Compilerˉsourceˉdeclarationˉisˉheaderˉmetadata(Declaration);
}

export fn Compilerˉsourceˉdeclarationˉisˉsymbol(
    Declaration: Compilerˉsourceˉdeclaration
) -> bool {
    if Declaration.Kind == Compilerˉsourceˉdeclarationˉkind.Import { return false; }
    if Declaration.Kind == Compilerˉsourceˉdeclarationˉkind.Optionalˉcapability { return false; }
    return Declaration.Kind != Compilerˉsourceˉdeclarationˉkind.End;
}

export fn Compilerˉparseˉdataˉdeclaration(
    Input: bytes,
    Token: Sourceˉlexer.Compilerˉsourceˉtoken
) -> Compilerˉsourceˉdeclaration {
    var Isˉexported: bool = false;
    var Cursor: u32 = Token.Offset;
    var Currentˉline: u32 = Token.Line;
    var Currentˉcolumn: u32 = Token.Column;
    if Token.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Export {
        Isˉexported = true;
        let Afterˉexport: Compilerˉparseˉstep = Compilerˉparseˉconsume(
            Input, Cursor, Currentˉline, Currentˉcolumn, Sourceˉlexer.Compilerˉtokenˉkind.Export
        );
        if Afterˉexport.Status != Compilerˉparseˉstatus.Valid {
            return Compilerˉsourceˉdeclarationˉfailure(
                Afterˉexport, Compilerˉsourceˉdeclarationˉkind.Data,
                true, Token.Offset, Token.Offset, 0u32
            );
        }
        Cursor = Afterˉexport.Nextˉoffset;
        Currentˉline = Afterˉexport.Nextˉline;
        Currentˉcolumn = Afterˉexport.Nextˉcolumn;
    }
    let Afterˉkeyword: Compilerˉparseˉstep = Compilerˉparseˉconsume(
        Input, Cursor, Currentˉline, Currentˉcolumn, Sourceˉlexer.Compilerˉtokenˉkind.Data
    );
    if Afterˉkeyword.Status != Compilerˉparseˉstatus.Valid {
        return Compilerˉsourceˉdeclarationˉfailure(Afterˉkeyword, Compilerˉsourceˉdeclarationˉkind.Data, Isˉexported, Token.Offset, Token.Offset, 0u32);
    }
    let Name: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(Input, Afterˉkeyword.Nextˉoffset, Afterˉkeyword.Nextˉline, Afterˉkeyword.Nextˉcolumn);
    let Afterˉname: Compilerˉparseˉstep = Compilerˉparseˉconsume(Input, Afterˉkeyword.Nextˉoffset, Afterˉkeyword.Nextˉline, Afterˉkeyword.Nextˉcolumn, Sourceˉlexer.Compilerˉtokenˉkind.Identifier);
    if Afterˉname.Status != Compilerˉparseˉstatus.Valid {
        return Compilerˉsourceˉdeclarationˉfailure(Afterˉname, Compilerˉsourceˉdeclarationˉkind.Data, Isˉexported, Token.Offset, Name.Offset, Name.Length);
    }
    let Afterˉcolon: Compilerˉparseˉstep = Compilerˉparseˉconsume(Input, Afterˉname.Nextˉoffset, Afterˉname.Nextˉline, Afterˉname.Nextˉcolumn, Sourceˉlexer.Compilerˉtokenˉkind.Colon);
    if Afterˉcolon.Status != Compilerˉparseˉstatus.Valid {
        return Compilerˉsourceˉdeclarationˉfailure(Afterˉcolon, Compilerˉsourceˉdeclarationˉkind.Data, Isˉexported, Token.Offset, Name.Offset, Name.Length);
    }
    let Type: Compilerˉparseˉstep = Compilerˉparseˉtype(Input, Afterˉcolon.Nextˉoffset, Afterˉcolon.Nextˉline, Afterˉcolon.Nextˉcolumn, false, true);
    if Type.Status != Compilerˉparseˉstatus.Valid {
        return Compilerˉsourceˉdeclarationˉfailure(Type, Compilerˉsourceˉdeclarationˉkind.Data, Isˉexported, Token.Offset, Name.Offset, Name.Length);
    }
    var Dataˉtypeˉvalid: bool = Type.Typeˉkind == Compilerˉsourceˉtypeˉkind.Text;
    if Type.Typeˉkind == Compilerˉsourceˉtypeˉkind.Bytes { Dataˉtypeˉvalid = true; }
    if Type.Typeˉkind == Compilerˉsourceˉtypeˉkind.I32ˉarray { Dataˉtypeˉvalid = true; }
    if !Dataˉtypeˉvalid {
        let Invalidˉdataˉtoken: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(Input, Afterˉcolon.Nextˉoffset, Afterˉcolon.Nextˉline, Afterˉcolon.Nextˉcolumn);
        let Invalidˉdataˉstep: Compilerˉparseˉstep = Compilerˉparseˉstepˉfromˉtoken(Compilerˉparseˉstatus.Invalidˉdataˉtype, Invalidˉdataˉtoken, Sourceˉlexer.Compilerˉtokenˉkind.Text);
        return Compilerˉsourceˉdeclarationˉfailure(Invalidˉdataˉstep, Compilerˉsourceˉdeclarationˉkind.Data, Isˉexported, Token.Offset, Name.Offset, Name.Length);
    }
    let Afterˉequals: Compilerˉparseˉstep = Compilerˉparseˉconsume(Input, Type.Nextˉoffset, Type.Nextˉline, Type.Nextˉcolumn, Sourceˉlexer.Compilerˉtokenˉkind.Equals);
    if Afterˉequals.Status != Compilerˉparseˉstatus.Valid {
        return Compilerˉsourceˉdeclarationˉfailure(Afterˉequals, Compilerˉsourceˉdeclarationˉkind.Data, Isˉexported, Token.Offset, Name.Offset, Name.Length);
    }
    let Valueˉstart: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(Input, Afterˉequals.Nextˉoffset, Afterˉequals.Nextˉline, Afterˉequals.Nextˉcolumn);
    var Value: Compilerˉparseˉstep = Compilerˉparseˉstepˉvalid(Afterˉequals.Nextˉoffset, Afterˉequals.Nextˉline, Afterˉequals.Nextˉcolumn, Type.Typeˉkind, 0u32);
    if Type.Typeˉkind == Compilerˉsourceˉtypeˉkind.Text {
        Value = Compilerˉparseˉconsume(Input, Afterˉequals.Nextˉoffset, Afterˉequals.Nextˉline, Afterˉequals.Nextˉcolumn, Sourceˉlexer.Compilerˉtokenˉkind.String);
    }
    if Type.Typeˉkind == Compilerˉsourceˉtypeˉkind.I32ˉarray {
        Value = Compilerˉparseˉi32ˉarray(Input, Afterˉequals.Nextˉoffset, Afterˉequals.Nextˉline, Afterˉequals.Nextˉcolumn);
    }
    if Type.Typeˉkind == Compilerˉsourceˉtypeˉkind.Bytes {
        Value = Compilerˉparseˉbytesˉarray(Input, Afterˉequals.Nextˉoffset, Afterˉequals.Nextˉline, Afterˉequals.Nextˉcolumn);
    }
    if Value.Status != Compilerˉparseˉstatus.Valid {
        return Compilerˉsourceˉdeclarationˉfailure(Value, Compilerˉsourceˉdeclarationˉkind.Data, Isˉexported, Token.Offset, Name.Offset, Name.Length);
    }
    let End: Compilerˉparseˉstep = Compilerˉparseˉconsume(Input, Value.Nextˉoffset, Value.Nextˉline, Value.Nextˉcolumn, Sourceˉlexer.Compilerˉtokenˉkind.Semicolon);
    if End.Status != Compilerˉparseˉstatus.Valid {
        return Compilerˉsourceˉdeclarationˉfailure(End, Compilerˉsourceˉdeclarationˉkind.Data, Isˉexported, Token.Offset, Name.Offset, Name.Length);
    }
    return Compilerˉsourceˉdeclarationˉmake(
        Compilerˉparseˉstatus.Valid,
        Sourceˉlexer.Compilerˉlexˉstatus.Valid,
        Compilerˉsourceˉdeclarationˉkind.Data,
        Isˉexported,
        Name.Offset,
        Name.Length,
        Token.Offset,
        End.Nextˉoffset,
        Valueˉstart.Offset,
        Value.Nextˉoffset,
        Value.Items,
        End.Nextˉoffset,
        End.Nextˉline,
        End.Nextˉcolumn,
        End.Nextˉoffset,
        End.Nextˉline,
        End.Nextˉcolumn,
        Sourceˉlexer.Compilerˉtokenˉkind.End,
        Sourceˉlexer.Compilerˉtokenˉkind.End
    );
}

export fn Compilerˉparseˉconstantˉdeclaration(
    Input: bytes,
    Token: Sourceˉlexer.Compilerˉsourceˉtoken
) -> Compilerˉsourceˉdeclaration {
    var Isˉexported: bool = false;
    var Constantˉtoken: Sourceˉlexer.Compilerˉsourceˉtoken = Token;
    if Token.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Export {
        Isˉexported = true;
        Constantˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Input, Token.Nextˉoffset, Token.Nextˉline, Token.Nextˉcolumn
        );
    }
    let Afterˉkeyword: Compilerˉparseˉstep = Compilerˉparseˉconsume(
        Input,
        Constantˉtoken.Offset,
        Constantˉtoken.Line,
        Constantˉtoken.Column,
        Sourceˉlexer.Compilerˉtokenˉkind.Const
    );
    if Afterˉkeyword.Status != Compilerˉparseˉstatus.Valid {
        return Compilerˉsourceˉdeclarationˉfailure(
            Afterˉkeyword, Compilerˉsourceˉdeclarationˉkind.Constant,
            Isˉexported, Token.Offset, Token.Offset, 0u32
        );
    }
    let Name: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
        Input,
        Afterˉkeyword.Nextˉoffset,
        Afterˉkeyword.Nextˉline,
        Afterˉkeyword.Nextˉcolumn
    );
    let Afterˉname: Compilerˉparseˉstep = Compilerˉparseˉconsume(
        Input,
        Afterˉkeyword.Nextˉoffset,
        Afterˉkeyword.Nextˉline,
        Afterˉkeyword.Nextˉcolumn,
        Sourceˉlexer.Compilerˉtokenˉkind.Identifier
    );
    if Afterˉname.Status != Compilerˉparseˉstatus.Valid {
        return Compilerˉsourceˉdeclarationˉfailure(
            Afterˉname, Compilerˉsourceˉdeclarationˉkind.Constant,
            Isˉexported, Token.Offset, Name.Offset, Name.Length
        );
    }
    let Afterˉcolon: Compilerˉparseˉstep = Compilerˉparseˉconsume(
        Input,
        Afterˉname.Nextˉoffset,
        Afterˉname.Nextˉline,
        Afterˉname.Nextˉcolumn,
        Sourceˉlexer.Compilerˉtokenˉkind.Colon
    );
    if Afterˉcolon.Status != Compilerˉparseˉstatus.Valid {
        return Compilerˉsourceˉdeclarationˉfailure(
            Afterˉcolon, Compilerˉsourceˉdeclarationˉkind.Constant,
            Isˉexported, Token.Offset, Name.Offset, Name.Length
        );
    }
    let Type: Compilerˉparseˉstep = Compilerˉparseˉtype(
        Input,
        Afterˉcolon.Nextˉoffset,
        Afterˉcolon.Nextˉline,
        Afterˉcolon.Nextˉcolumn,
        false,
        false
    );
    if Type.Status != Compilerˉparseˉstatus.Valid {
        return Compilerˉsourceˉdeclarationˉfailure(
            Type, Compilerˉsourceˉdeclarationˉkind.Constant,
            Isˉexported, Token.Offset, Name.Offset, Name.Length
        );
    }
    let Afterˉequals: Compilerˉparseˉstep = Compilerˉparseˉconsume(
        Input,
        Type.Nextˉoffset,
        Type.Nextˉline,
        Type.Nextˉcolumn,
        Sourceˉlexer.Compilerˉtokenˉkind.Equals
    );
    if Afterˉequals.Status != Compilerˉparseˉstatus.Valid {
        return Compilerˉsourceˉdeclarationˉfailure(
            Afterˉequals, Compilerˉsourceˉdeclarationˉkind.Constant,
            Isˉexported, Token.Offset, Name.Offset, Name.Length
        );
    }
    let Valueˉstart: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
        Input,
        Afterˉequals.Nextˉoffset,
        Afterˉequals.Nextˉline,
        Afterˉequals.Nextˉcolumn
    );
    if Valueˉstart.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Semicolon {
        let Missing: Compilerˉparseˉstep = Compilerˉparseˉstepˉfromˉtoken(
            Compilerˉparseˉstatus.Invalidˉliteral,
            Valueˉstart,
            Sourceˉlexer.Compilerˉtokenˉkind.Identifier
        );
        return Compilerˉsourceˉdeclarationˉfailure(
            Missing, Compilerˉsourceˉdeclarationˉkind.Constant,
            Isˉexported, Token.Offset, Name.Offset, Name.Length
        );
    }
    var Current: Sourceˉlexer.Compilerˉsourceˉtoken = Valueˉstart;
    var Tokens: u32 = 0u32;
    while Current.Kind != Sourceˉlexer.Compilerˉtokenˉkind.Semicolon {
        if Current.Kind == Sourceˉlexer.Compilerˉtokenˉkind.End {
            let Missingˉend: Compilerˉparseˉstep = Compilerˉparseˉstepˉfromˉtoken(
                Compilerˉparseˉstatus.Expectedˉtoken,
                Current,
                Sourceˉlexer.Compilerˉtokenˉkind.Semicolon
            );
            return Compilerˉsourceˉdeclarationˉfailure(
                Missingˉend, Compilerˉsourceˉdeclarationˉkind.Constant,
                Isˉexported, Token.Offset, Name.Offset, Name.Length
            );
        }
        Tokens = Tokens + 1u32;
        if Tokens > 4096u32 {
            let Limit: Compilerˉparseˉstep = Compilerˉparseˉstepˉfromˉtoken(
                Compilerˉparseˉstatus.Itemˉlimit,
                Current,
                Sourceˉlexer.Compilerˉtokenˉkind.Semicolon
            );
            return Compilerˉsourceˉdeclarationˉfailure(
                Limit, Compilerˉsourceˉdeclarationˉkind.Constant,
                Isˉexported, Token.Offset, Name.Offset, Name.Length
            );
        }
        Current = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Input,
            Current.Nextˉoffset,
            Current.Nextˉline,
            Current.Nextˉcolumn
        );
    }
    return Compilerˉsourceˉdeclarationˉmake(
        Compilerˉparseˉstatus.Valid,
        Sourceˉlexer.Compilerˉlexˉstatus.Valid,
        Compilerˉsourceˉdeclarationˉkind.Constant,
        Isˉexported,
        Name.Offset,
        Name.Length,
        Token.Offset,
        Current.Nextˉoffset,
        Valueˉstart.Offset,
        Current.Offset,
        0u32,
        Current.Nextˉoffset,
        Current.Nextˉline,
        Current.Nextˉcolumn,
        Current.Nextˉoffset,
        Current.Nextˉline,
        Current.Nextˉcolumn,
        Sourceˉlexer.Compilerˉtokenˉkind.End,
        Sourceˉlexer.Compilerˉtokenˉkind.End
    );
}

export fn Compilerˉparseˉrecordˉdeclaration(
    Input: bytes,
    Token: Sourceˉlexer.Compilerˉsourceˉtoken
) -> Compilerˉsourceˉdeclaration {
    var Isˉexported: bool = false;
    var Keywordˉoffset: u32 = Token.Offset;
    var Keywordˉline: u32 = Token.Line;
    var Keywordˉcolumn: u32 = Token.Column;
    if Token.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Export {
        Isˉexported = true;
        let Afterˉexport: Compilerˉparseˉstep = Compilerˉparseˉconsume(
            Input, Keywordˉoffset, Keywordˉline, Keywordˉcolumn, Sourceˉlexer.Compilerˉtokenˉkind.Export
        );
        if Afterˉexport.Status != Compilerˉparseˉstatus.Valid {
            return Compilerˉsourceˉdeclarationˉfailure(
                Afterˉexport, Compilerˉsourceˉdeclarationˉkind.Record,
                true, Token.Offset, Token.Offset, 0u32
            );
        }
        Keywordˉoffset = Afterˉexport.Nextˉoffset;
        Keywordˉline = Afterˉexport.Nextˉline;
        Keywordˉcolumn = Afterˉexport.Nextˉcolumn;
    }
    let Afterˉkeyword: Compilerˉparseˉstep = Compilerˉparseˉconsume(
        Input, Keywordˉoffset, Keywordˉline, Keywordˉcolumn, Sourceˉlexer.Compilerˉtokenˉkind.Record
    );
    if Afterˉkeyword.Status != Compilerˉparseˉstatus.Valid { return Compilerˉsourceˉdeclarationˉfailure(Afterˉkeyword, Compilerˉsourceˉdeclarationˉkind.Record, false, Token.Offset, Token.Offset, 0u32); }
    let Name: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(Input, Afterˉkeyword.Nextˉoffset, Afterˉkeyword.Nextˉline, Afterˉkeyword.Nextˉcolumn);
    let Afterˉname: Compilerˉparseˉstep = Compilerˉparseˉconsume(Input, Afterˉkeyword.Nextˉoffset, Afterˉkeyword.Nextˉline, Afterˉkeyword.Nextˉcolumn, Sourceˉlexer.Compilerˉtokenˉkind.Identifier);
    if Afterˉname.Status != Compilerˉparseˉstatus.Valid { return Compilerˉsourceˉdeclarationˉfailure(Afterˉname, Compilerˉsourceˉdeclarationˉkind.Record, false, Token.Offset, Name.Offset, Name.Length); }
    var Bodyˉoffset: u32 = Afterˉname.Nextˉoffset;
    var Bodyˉline: u32 = Afterˉname.Nextˉline;
    var Bodyˉcolumn: u32 = Afterˉname.Nextˉcolumn;
    let Maybeˉparameters: Sourceˉlexer.Compilerˉsourceˉtoken =
        Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Input, Bodyˉoffset, Bodyˉline, Bodyˉcolumn
        );
    if Maybeˉparameters.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Less {
        let Parameters: Compilerˉparseˉstep = Compilerˉparseˉgenericˉparameters(
            Input, Bodyˉoffset, Bodyˉline, Bodyˉcolumn
        );
        if Parameters.Status != Compilerˉparseˉstatus.Valid {
            return Compilerˉsourceˉdeclarationˉfailure(
                Parameters, Compilerˉsourceˉdeclarationˉkind.Record,
                Isˉexported, Token.Offset, Name.Offset, Name.Length
            );
        }
        Bodyˉoffset = Parameters.Nextˉoffset;
        Bodyˉline = Parameters.Nextˉline;
        Bodyˉcolumn = Parameters.Nextˉcolumn;
    }
    let Bodyˉstart: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(Input, Bodyˉoffset, Bodyˉline, Bodyˉcolumn);
    let Afterˉbrace: Compilerˉparseˉstep = Compilerˉparseˉconsume(Input, Bodyˉoffset, Bodyˉline, Bodyˉcolumn, Sourceˉlexer.Compilerˉtokenˉkind.Leftˉbrace);
