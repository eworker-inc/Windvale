fn Patchˉu32(Input: bytes, Offset: u32, Value: u32) -> bytes {
    var Output: bytes = Bytesˉslice(Input, 0u32, Offset);
    Output = Bytesˉconcat(Output, Bytesˉfromˉu32ˉlittle(Value));
    return Bytesˉconcat(
        Output,
        Bytesˉslice(
            Input,
            Offset + 4u32,
            Bytesˉlength(Input) - Offset - 4u32
        )
    );
}

fn Relativeˉu32(Target: u32, Origin: u32) -> u32 {
    if Target >= Origin { return Target - Origin; }
    let Magnitude: u32 = Origin - Target;
    return 4294967295u32 - Magnitude + 1u32;
}

export fn Compilerˉnativeˉx64ˉbytesˉconcatˉbytes() -> u32 {
    return 986u32;
}

export fn Compilerˉnativeˉx64ˉemitˉbytesˉconcat(
    Result: bytes,
    Left: u32,
    Right: u32,
    Target: u32,
    Runtimeˉtarget: u32
) -> bytes {
    var Instruction: bytes = Bytesˉconcatˉtemplate;

    Instruction = Patchˉu32(Instruction, 82u32, Left * 16u32);
    Instruction = Patchˉu32(Instruction, 430u32, Left * 16u32);
    Instruction = Patchˉu32(Instruction, 503u32, Left * 16u32);
    Instruction = Patchˉu32(Instruction, 861u32, Left * 16u32);
    Instruction = Patchˉu32(Instruction, 3u32, Left * 16u32 + 8u32);
    Instruction = Patchˉu32(Instruction, 170u32, Left * 16u32 + 8u32);
    Instruction = Patchˉu32(Instruction, 358u32, Left * 16u32 + 8u32);
    Instruction = Patchˉu32(Instruction, 447u32, Left * 16u32 + 8u32);
    Instruction = Patchˉu32(Instruction, 868u32, Left * 16u32 + 8u32);
    Instruction = Patchˉu32(Instruction, 64u32, Left * 16u32 + 12u32);

    Instruction = Patchˉu32(Instruction, 211u32, Right * 16u32);
    Instruction = Patchˉu32(Instruction, 369u32, Right * 16u32);
    Instruction = Patchˉu32(Instruction, 541u32, Right * 16u32);
    Instruction = Patchˉu32(Instruction, 905u32, Right * 16u32);
    Instruction = Patchˉu32(Instruction, 10u32, Right * 16u32 + 8u32);
    Instruction = Patchˉu32(Instruction, 218u32, Right * 16u32 + 8u32);
    Instruction = Patchˉu32(Instruction, 376u32, Right * 16u32 + 8u32);
    Instruction = Patchˉu32(Instruction, 466u32, Right * 16u32 + 8u32);
    Instruction = Patchˉu32(Instruction, 548u32, Right * 16u32 + 8u32);
    Instruction = Patchˉu32(Instruction, 912u32, Right * 16u32 + 8u32);

    Instruction = Patchˉu32(Instruction, 184u32, Target * 16u32);
    Instruction = Patchˉu32(Instruction, 329u32, Target * 16u32);
    Instruction = Patchˉu32(Instruction, 511u32, Target * 16u32);
    Instruction = Patchˉu32(Instruction, 648u32, Target * 16u32);
    Instruction = Patchˉu32(Instruction, 823u32, Target * 16u32);
    Instruction = Patchˉu32(Instruction, 194u32, Target * 16u32 + 8u32);
    Instruction = Patchˉu32(Instruction, 342u32, Target * 16u32 + 8u32);
    Instruction = Patchˉu32(Instruction, 521u32, Target * 16u32 + 8u32);
    Instruction = Patchˉu32(Instruction, 658u32, Target * 16u32 + 8u32);
    Instruction = Patchˉu32(Instruction, 833u32, Target * 16u32 + 8u32);
    Instruction = Patchˉu32(Instruction, 57u32, Target * 16u32 + 12u32);
    Instruction = Patchˉu32(Instruction, 203u32, Target * 16u32 + 12u32);
    Instruction = Patchˉu32(Instruction, 351u32, Target * 16u32 + 12u32);
    Instruction = Patchˉu32(Instruction, 422u32, Target * 16u32 + 12u32);
    Instruction = Patchˉu32(Instruction, 530u32, Target * 16u32 + 12u32);
    Instruction = Patchˉu32(Instruction, 667u32, Target * 16u32 + 12u32);
    Instruction = Patchˉu32(Instruction, 682u32, Target * 16u32 + 12u32);
    Instruction = Patchˉu32(Instruction, 754u32, Target * 16u32 + 12u32);
    Instruction = Patchˉu32(Instruction, 799u32, Target * 16u32 + 12u32);
    Instruction = Patchˉu32(Instruction, 845u32, Target * 16u32 + 12u32);

    let Instructionˉoffset: u32 = Bytesˉlength(Result);
    Instruction = Patchˉu32(
        Instruction,
        959u32,
        Relativeˉu32(Runtimeˉtarget, Instructionˉoffset + 963u32)
    );
    Instruction = Patchˉu32(
        Instruction,
        972u32,
        Relativeˉu32(Runtimeˉtarget, Instructionˉoffset + 976u32)
    );
    return Bytesˉconcat(Result, Instruction);
}

export fn Compilerˉnativeˉx64ˉbytesˉfromˉu8ˉbytes() -> u32 {
    return 108u32;
}

export fn Compilerˉnativeˉx64ˉemitˉbytesˉfromˉu8(
    Result: bytes,
    Source: u32,
    Target: u32,
    Runtimeˉtarget: u32
) -> bytes {
    var Instruction: bytes = Bytesˉfromˉu8ˉtemplate;
    Instruction = Patchˉu32(Instruction, 46u32, Target * 16u32);
    Instruction = Patchˉu32(Instruction, 58u32, Target * 16u32 + 8u32);
    Instruction = Patchˉu32(Instruction, 67u32, Target * 16u32 + 12u32);
    Instruction = Patchˉu32(Instruction, 74u32, Source * 16u32);
    let Instructionˉoffset: u32 = Bytesˉlength(Result);
    Instruction = Patchˉu32(
        Instruction,
        94u32,
        Relativeˉu32(Runtimeˉtarget, Instructionˉoffset + 98u32)
    );
    return Bytesˉconcat(Result, Instruction);
}
