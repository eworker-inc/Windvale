data Bytesˉfromˉu8ˉtemplate: bytes = [
    65, 139, 71, 60, 65, 137, 193, 137, 193, 131, 193, 1, 15, 130, 67, 0,
    0, 0, 65, 59, 79, 56, 15, 135, 57, 0, 0, 0, 65, 137, 79, 60,
