module Compilerˉnativeˉx64ˉloweringˉcapabilities profile portable;

import Compilerˉnativeˉx64ˉloweringˉlayout as Layout;
import Compilerˉnativeˉx64ˉproviderˉcall as Providerˉcall;

export record Compilerˉnativeˉx64ˉcapabilities {
    Valid: bool;
    Count: u32;
    Kinds: bytes;
}

export record Compilerˉnativeˉx64ˉcapabilityˉanalysis {
    Valid: bool;
    Stack: bytes;
    Depth: u32;
    Textˉvalues: u32;
    U32ˉvalues: u32;
    Bytesˉvalues: u32;
    Bodyˉbytes: u32;
}

export record Compilerˉnativeˉx64ˉcapabilityˉstate {
    Result: bytes;
    Stackˉtypes: bytes;
    Stackˉslots: bytes;
    Stackˉdepth: u32;
    Nextˉtext: u32;
    Nextˉu32: u32;
    Nextˉbytes: u32;
}

export fn Compilerˉnativeˉx64ˉemptyˉcapabilities(Input: bytes)
    -> Compilerˉnativeˉx64ˉcapabilities {
    return Compilerˉnativeˉx64ˉcapabilities(
        false,
        0u32,
        Bytesˉslice(Input, 0u32, 0u32)
    );
}

fn Spanˉequalsˉtext(
    Input: bytes,
    Offset: u32,
    Length: u32,
    Expected: text
) -> bool {
    let Expectedˉbytes: bytes = Textˉtoˉutf8(Expected);
    if Length != Bytesˉlength(Expectedˉbytes) { return false; }
    let Total: u32 = Bytesˉlength(Input);
    if Offset > Total { return false; }
    if Length > Total - Offset { return false; }
    var Index: u32 = 0u32;
    while Index < Length {
        if Bytesˉreadˉu8(Input, Offset + Index) !=
            Bytesˉreadˉu8(Expectedˉbytes, Index) {
            return false;
        }
        Index = Index + 1u32;
    }
    return true;
}

fn Capabilityˉkind(
    Input: bytes,
    Nameˉoffset: u32,
    Nameˉlength: u32
) -> u8 {
    if Spanˉequalsˉtext(Input, Nameˉoffset, Nameˉlength, "console.write_line") {
        return 1u8;
    }
    if Spanˉequalsˉtext(Input, Nameˉoffset, Nameˉlength, "diagnostic.write_line") {
        return 2u8;
    }
    if Spanˉequalsˉtext(Input, Nameˉoffset, Nameˉlength, "file.read_bytes") {
        return 3u8;
    }
    if Spanˉequalsˉtext(Input, Nameˉoffset, Nameˉlength, "file.write_bytes") {
        return 4u8;
    }
    if Spanˉequalsˉtext(
        Input, Nameˉoffset, Nameˉlength, "filesystem.directory_read_v1"
    ) {
        return 5u8;
    }
    if Spanˉequalsˉtext(Input, Nameˉoffset, Nameˉlength, "model.catalog_v1") {
        return 6u8;
    }
    if Spanˉequalsˉtext(Input, Nameˉoffset, Nameˉlength, "model.inference_v1") {
        return 7u8;
    }
    if Spanˉequalsˉtext(Input, Nameˉoffset, Nameˉlength, "process.argument") {
        return 8u8;
    }
    if Spanˉequalsˉtext(Input, Nameˉoffset, Nameˉlength, "process.argument_count") {
        return 9u8;
    }
    if Spanˉequalsˉtext(Input, Nameˉoffset, Nameˉlength, "standard_output.write_v1") {
        return 10u8;
    }
    if Spanˉequalsˉtext(Input, Nameˉoffset, Nameˉlength, "storage.random_access_v1") {
        return 11u8;
    }
    return 0u8;
}

fn Signatureˉisˉvalid(
    Input: bytes,
    Offset: u32,
    Limit: u32,
    Kind: u8
) -> u32 {
    if Limit - Offset < 5u32 { return 0u32; }
    let Parameters: u32 = Bytesˉreadˉu32ˉlittle(Input, Offset);
    if Parameters > 5u32 { return 0u32; }
    if Limit - Offset < 5u32 + Parameters { return 0u32; }
    let First: u8 = Bytesˉreadˉu8(Input, Offset + 4u32);
    var Second: u8 = 0u8;
    var Third: u8 = 0u8;
    var Fourth: u8 = 0u8;
    var Fifth: u8 = 0u8;
    if Parameters >= 2u32 { Second = Bytesˉreadˉu8(Input, Offset + 5u32); }
    if Parameters >= 3u32 { Third = Bytesˉreadˉu8(Input, Offset + 6u32); }
    if Parameters >= 4u32 { Fourth = Bytesˉreadˉu8(Input, Offset + 7u32); }
    if Parameters >= 5u32 { Fifth = Bytesˉreadˉu8(Input, Offset + 8u32); }
    let Return: u8 = Bytesˉreadˉu8(Input, Offset + 4u32 + Parameters);
    if Kind == 1u8 || Kind == 2u8 {
        if Parameters != 1u32 || First != 3u8 || Return != 0u8 { return 0u32; }
    }
    if Kind == 3u8 {
        if Parameters != 1u32 || First != 3u8 || Return != 6u8 { return 0u32; }
    }
    if Kind == 4u8 {
        if Parameters != 2u32 || First != 3u8 || Second != 6u8 || Return != 0u8 {
            return 0u32;
        }
    }
    if Kind == 5u8 {
        if Parameters != 3u32 || First != 3u8 || Second != 5u8 ||
            Third != 5u8 || Return != 6u8 {
            return 0u32;
        }
    }
    if Kind == 6u8 || Kind == 7u8 || Kind == 10u8 {
        if Parameters != 1u32 || First != 6u8 || Return != 6u8 { return 0u32; }
    }
    if Kind == 8u8 {
        if Parameters != 1u32 || First != 5u8 || Return != 3u8 { return 0u32; }
    }
    if Kind == 9u8 {
        if Parameters != 0u32 || Return != 5u8 { return 0u32; }
    }
    if Kind == 11u8 {
        if Parameters != 5u32 || First != 5u8 || Second != 10u8 ||
            Third != 10u8 || Fourth != 5u8 || Fifth != 6u8 || Return != 6u8 {
            return 0u32;
        }
    }
    return 5u32 + Parameters;
}

export fn Compilerˉnativeˉx64ˉcapabilitiesˉread(
    Input: bytes,
    Offset: u32,
    Length: u32
) -> Compilerˉnativeˉx64ˉcapabilities {
    let Invalid: Compilerˉnativeˉx64ˉcapabilities =
        Compilerˉnativeˉx64ˉemptyˉcapabilities(Input);
    let Total: u32 = Bytesˉlength(Input);
    if Offset > Total { return Invalid; }
    if Length > Total - Offset { return Invalid; }
    if Length < 4u32 { return Invalid; }
    let Limit: u32 = Offset + Length;
    let Count: u32 = Bytesˉreadˉu32ˉlittle(Input, Offset);
    if Count > 11u32 { return Invalid; }
    var Kinds: bytes = Bytesˉslice(Input, 0u32, 0u32);
    var Previous: u32 = 0u32;
    var Cursor: u32 = Offset + 4u32;
    var Index: u32 = 0u32;
    while Index < Count {
        if Limit - Cursor < 4u32 { return Invalid; }
        let Nameˉlength: u32 = Bytesˉreadˉu32ˉlittle(Input, Cursor);
        Cursor = Cursor + 4u32;
        if Nameˉlength == 0u32 { return Invalid; }
        if Nameˉlength > Limit - Cursor { return Invalid; }
        let Kind: u8 = Capabilityˉkind(Input, Cursor, Nameˉlength);
        if Kind == 0u8 { return Invalid; }
        let Numericˉkind: u32 = U32ˉfromˉu8(Kind);
        if Numericˉkind <= Previous { return Invalid; }
        Previous = Numericˉkind;
        Cursor = Cursor + Nameˉlength;
        let Signatureˉbytes: u32 = Signatureˉisˉvalid(Input, Cursor, Limit, Kind);
        if Signatureˉbytes == 0u32 { return Invalid; }
        Cursor = Cursor + Signatureˉbytes;
        Kinds = Bytesˉconcat(Kinds, Bytesˉfromˉu8(Kind));
        Index = Index + 1u32;
    }
    if Cursor != Limit { return Invalid; }
    return Compilerˉnativeˉx64ˉcapabilities(true, Count, Kinds);
}

export fn Compilerˉnativeˉx64ˉcapabilityˉkind(
    Capabilities: Compilerˉnativeˉx64ˉcapabilities,
    Index: u32
) -> u8 {
    if Index >= Capabilities.Count { return 0u8; }
    return Bytesˉreadˉu8(Capabilities.Kinds, Index);
}

export fn Compilerˉnativeˉx64ˉprocessˉargumentˉcountˉkind() -> u8 {
    return 9u8;
}

export fn Compilerˉnativeˉx64ˉconsoleˉwriteˉlineˉkind() -> u8 {
    return 1u8;
}

export fn Compilerˉnativeˉx64ˉdiagnosticˉwriteˉlineˉkind() -> u8 {
    return 2u8;
}

export fn Compilerˉnativeˉx64ˉprocessˉargumentˉkind() -> u8 {
    return 8u8;
}

export fn Compilerˉnativeˉx64ˉfileˉreadˉbytesˉkind() -> u8 {
    return 3u8;
}

export fn Compilerˉnativeˉx64ˉfileˉwriteˉbytesˉkind() -> u8 {
    return 4u8;
}

export fn Compilerˉnativeˉx64ˉstorageˉrandomˉaccessˉkind() -> u8 {
    return 11u8;
}

export fn Compilerˉnativeˉx64ˉstandardˉoutputˉwriteˉkind() -> u8 {
    return 10u8;
}

export fn Compilerˉnativeˉx64ˉdirectoryˉreadˉkind() -> u8 {
    return 5u8;
}

export fn Compilerˉnativeˉx64ˉmodelˉcatalogˉkind() -> u8 {
    return 6u8;
}

export fn Compilerˉnativeˉx64ˉmodelˉinferenceˉkind() -> u8 {
    return 7u8;
}

export fn Compilerˉnativeˉx64ˉprocessˉargumentˉcountˉbytes() -> u32 {
    return 27u32;
}

export fn Compilerˉnativeˉx64ˉtextˉoutputˉbytes() -> u32 {
    return 44u32;
}

export fn Compilerˉnativeˉx64ˉprocessˉargumentˉbytes() -> u32 {
    return 46u32;
}

export fn Compilerˉnativeˉx64ˉfileˉreadˉbytesˉbytes() -> u32 {
    return 52u32;
}

export fn Compilerˉnativeˉx64ˉfileˉwriteˉbytesˉbytes() -> u32 {
    return 59u32;
}

export fn Compilerˉnativeˉx64ˉstorageˉrandomˉaccessˉbytes() -> u32 {
    // A bytes-producing instruction also emits the standard 10-byte
    // allocation-budget guard before its capability-specific body.
    return Providerˉcall.Compilerˉnativeˉx64ˉproviderˉcallˉbytes() + 10u32;
}

export fn Compilerˉnativeˉx64ˉdirectoryˉreadˉbytes() -> u32 {
    // The provider-call frame remains five cells wide, but the provider sees
    // the exact three-cell directory signature through EDX.
    return Providerˉcall.Compilerˉnativeˉx64ˉproviderˉcallˉbytes() + 10u32;
}

export fn Compilerˉnativeˉx64ˉmodelˉcallˉbytes() -> u32 {
    // The fixed provider-call frame remains five cells wide, while EDX exposes
    // the exact one-cell bytes-to-bytes model signature.
    return Providerˉcall.Compilerˉnativeˉx64ˉproviderˉcallˉbytes() + 10u32;
}

export fn Compilerˉnativeˉx64ˉstandardˉoutputˉwriteˉbytes() -> u32 {
    return Providerˉcall.Compilerˉnativeˉx64ˉproviderˉcallˉbytes() + 10u32;
}

export fn Compilerˉnativeˉx64ˉanalyzeˉcapability(
    Kind: u8,
    Stack: bytes,
    Depth: u32,
    Textˉvalues: u32,
    U32ˉvalues: u32,
    Bytesˉvalues: u32,
    Bodyˉbytes: u32
) -> Compilerˉnativeˉx64ˉcapabilityˉanalysis {
    var Outputˉstack: bytes = Stack;
    var Outputˉdepth: u32 = Depth;
    var Outputˉtext: u32 = Textˉvalues;
    var Outputˉu32: u32 = U32ˉvalues;
    var Outputˉbytes: u32 = Bytesˉvalues;
    var Outputˉbody: u32 = Bodyˉbytes;
    if Kind == Compilerˉnativeˉx64ˉmodelˉcatalogˉkind() ||
        Kind == Compilerˉnativeˉx64ˉmodelˉinferenceˉkind() ||
        Kind == Compilerˉnativeˉx64ˉstandardˉoutputˉwriteˉkind() {
        if Outputˉdepth < 1u32 ||
            Bytesˉreadˉu8(Outputˉstack, Outputˉdepth - 1u32) != 6u8 {
            return Compilerˉnativeˉx64ˉcapabilityˉanalysis(
                false,
                Outputˉstack,
                Outputˉdepth,
                Outputˉtext,
                Outputˉu32,
                Outputˉbytes,
                Outputˉbody
            );
        }
        Outputˉdepth = Outputˉdepth - 1u32;
        Outputˉstack = Bytesˉslice(Outputˉstack, 0u32, Outputˉdepth);
        Outputˉstack = Bytesˉconcat(Outputˉstack, Bytesˉfromˉu8(6u8));
        Outputˉdepth = Outputˉdepth + 1u32;
        Outputˉbytes = Outputˉbytes + 1u32;
        if Kind == Compilerˉnativeˉx64ˉstandardˉoutputˉwriteˉkind() {
            Outputˉbody = Outputˉbody +
                Compilerˉnativeˉx64ˉstandardˉoutputˉwriteˉbytes();
        } else {
            Outputˉbody = Outputˉbody + Compilerˉnativeˉx64ˉmodelˉcallˉbytes();
        }
        return Compilerˉnativeˉx64ˉcapabilityˉanalysis(
            true,
            Outputˉstack,
            Outputˉdepth,
            Outputˉtext,
            Outputˉu32,
            Outputˉbytes,
            Outputˉbody
        );
    }
    if Kind == Compilerˉnativeˉx64ˉdirectoryˉreadˉkind() {
        if Outputˉdepth < 3u32 ||
            Bytesˉreadˉu8(Outputˉstack, Outputˉdepth - 3u32) != 3u8 ||
            Bytesˉreadˉu8(Outputˉstack, Outputˉdepth - 2u32) != 5u8 ||
            Bytesˉreadˉu8(Outputˉstack, Outputˉdepth - 1u32) != 5u8 {
            return Compilerˉnativeˉx64ˉcapabilityˉanalysis(
                false,
                Outputˉstack,
                Outputˉdepth,
                Outputˉtext,
                Outputˉu32,
                Outputˉbytes,
                Outputˉbody
            );
        }
        Outputˉdepth = Outputˉdepth - 3u32;
        Outputˉstack = Bytesˉslice(Outputˉstack, 0u32, Outputˉdepth);
        Outputˉstack = Bytesˉconcat(Outputˉstack, Bytesˉfromˉu8(6u8));
        Outputˉdepth = Outputˉdepth + 1u32;
        Outputˉbytes = Outputˉbytes + 1u32;
        Outputˉbody = Outputˉbody +
            Compilerˉnativeˉx64ˉdirectoryˉreadˉbytes();
        return Compilerˉnativeˉx64ˉcapabilityˉanalysis(
            true,
            Outputˉstack,
            Outputˉdepth,
            Outputˉtext,
            Outputˉu32,
            Outputˉbytes,
            Outputˉbody
        );
    }
    if Kind == Compilerˉnativeˉx64ˉstorageˉrandomˉaccessˉkind() {
        if Outputˉdepth < 5u32 ||
            Bytesˉreadˉu8(Outputˉstack, Outputˉdepth - 5u32) != 5u8 ||
            Bytesˉreadˉu8(Outputˉstack, Outputˉdepth - 4u32) != 10u8 ||
            Bytesˉreadˉu8(Outputˉstack, Outputˉdepth - 3u32) != 10u8 ||
            Bytesˉreadˉu8(Outputˉstack, Outputˉdepth - 2u32) != 5u8 ||
            Bytesˉreadˉu8(Outputˉstack, Outputˉdepth - 1u32) != 6u8 {
            return Compilerˉnativeˉx64ˉcapabilityˉanalysis(
                false,
                Outputˉstack,
                Outputˉdepth,
                Outputˉtext,
                Outputˉu32,
                Outputˉbytes,
                Outputˉbody
            );
        }
        Outputˉdepth = Outputˉdepth - 5u32;
        Outputˉstack = Bytesˉslice(Outputˉstack, 0u32, Outputˉdepth);
        Outputˉstack = Bytesˉconcat(Outputˉstack, Bytesˉfromˉu8(6u8));
        Outputˉdepth = Outputˉdepth + 1u32;
        Outputˉbytes = Outputˉbytes + 1u32;
        Outputˉbody = Outputˉbody +
            Compilerˉnativeˉx64ˉstorageˉrandomˉaccessˉbytes();
        return Compilerˉnativeˉx64ˉcapabilityˉanalysis(
            true,
            Outputˉstack,
            Outputˉdepth,
            Outputˉtext,
            Outputˉu32,
            Outputˉbytes,
            Outputˉbody
        );
    }
    if Kind == Compilerˉnativeˉx64ˉprocessˉargumentˉcountˉkind() {
        Outputˉstack = Bytesˉconcat(Outputˉstack, Bytesˉfromˉu8(5u8));
        Outputˉdepth = Outputˉdepth + 1u32;
        Outputˉu32 = Outputˉu32 + 1u32;
        Outputˉbody = Outputˉbody +
            Compilerˉnativeˉx64ˉprocessˉargumentˉcountˉbytes();
        return Compilerˉnativeˉx64ˉcapabilityˉanalysis(
            true,
            Outputˉstack,
            Outputˉdepth,
            Outputˉtext,
            Outputˉu32,
            Outputˉbytes,
            Outputˉbody
        );
    }
    if Kind == Compilerˉnativeˉx64ˉfileˉwriteˉbytesˉkind() {
        if Outputˉdepth < 2u32 ||
            Bytesˉreadˉu8(Outputˉstack, Outputˉdepth - 2u32) != 3u8 ||
            Bytesˉreadˉu8(Outputˉstack, Outputˉdepth - 1u32) != 6u8 {
            return Compilerˉnativeˉx64ˉcapabilityˉanalysis(
                false,
                Outputˉstack,
                Outputˉdepth,
                Outputˉtext,
                Outputˉu32,
                Outputˉbytes,
                Outputˉbody
            );
        }
        Outputˉdepth = Outputˉdepth - 2u32;
        Outputˉstack = Bytesˉslice(Outputˉstack, 0u32, Outputˉdepth);
        Outputˉbody = Outputˉbody +
            Compilerˉnativeˉx64ˉfileˉwriteˉbytesˉbytes();
        return Compilerˉnativeˉx64ˉcapabilityˉanalysis(
            true,
            Outputˉstack,
            Outputˉdepth,
            Outputˉtext,
            Outputˉu32,
            Outputˉbytes,
            Outputˉbody
        );
    }
    if Outputˉdepth == 0u32 {
        return Compilerˉnativeˉx64ˉcapabilityˉanalysis(
            false,
            Outputˉstack,
            Outputˉdepth,
            Outputˉtext,
            Outputˉu32,
            Outputˉbytes,
            Outputˉbody
        );
    }
    if Kind == Compilerˉnativeˉx64ˉconsoleˉwriteˉlineˉkind() ||
        Kind == Compilerˉnativeˉx64ˉdiagnosticˉwriteˉlineˉkind() {
        if Bytesˉreadˉu8(Outputˉstack, Outputˉdepth - 1u32) != 3u8 {
            return Compilerˉnativeˉx64ˉcapabilityˉanalysis(
                false,
                Outputˉstack,
                Outputˉdepth,
                Outputˉtext,
                Outputˉu32,
                Outputˉbytes,
                Outputˉbody
            );
        }
        Outputˉdepth = Outputˉdepth - 1u32;
        Outputˉstack = Bytesˉslice(Outputˉstack, 0u32, Outputˉdepth);
        Outputˉbody = Outputˉbody +
            Compilerˉnativeˉx64ˉtextˉoutputˉbytes();
        return Compilerˉnativeˉx64ˉcapabilityˉanalysis(
            true,
            Outputˉstack,
            Outputˉdepth,
            Outputˉtext,
            Outputˉu32,
            Outputˉbytes,
            Outputˉbody
        );
    }
    if Kind == Compilerˉnativeˉx64ˉprocessˉargumentˉkind() {
        if Bytesˉreadˉu8(Outputˉstack, Outputˉdepth - 1u32) != 5u8 {
            return Compilerˉnativeˉx64ˉcapabilityˉanalysis(
                false,
                Outputˉstack,
                Outputˉdepth,
                Outputˉtext,
                Outputˉu32,
                Outputˉbytes,
                Outputˉbody
            );
        }
        Outputˉdepth = Outputˉdepth - 1u32;
        Outputˉstack = Bytesˉslice(Outputˉstack, 0u32, Outputˉdepth);
        Outputˉstack = Bytesˉconcat(Outputˉstack, Bytesˉfromˉu8(3u8));
        Outputˉdepth = Outputˉdepth + 1u32;
        Outputˉtext = Outputˉtext + 1u32;
        Outputˉbody = Outputˉbody +
            Compilerˉnativeˉx64ˉprocessˉargumentˉbytes();
        return Compilerˉnativeˉx64ˉcapabilityˉanalysis(
            true,
            Outputˉstack,
            Outputˉdepth,
            Outputˉtext,
            Outputˉu32,
            Outputˉbytes,
            Outputˉbody
        );
    }
    if Kind != Compilerˉnativeˉx64ˉfileˉreadˉbytesˉkind() ||
        Bytesˉreadˉu8(Outputˉstack, Outputˉdepth - 1u32) != 3u8 {
        return Compilerˉnativeˉx64ˉcapabilityˉanalysis(
            false,
            Outputˉstack,
            Outputˉdepth,
            Outputˉtext,
            Outputˉu32,
            Outputˉbytes,
            Outputˉbody
        );
    }
    Outputˉdepth = Outputˉdepth - 1u32;
    Outputˉstack = Bytesˉslice(Outputˉstack, 0u32, Outputˉdepth);
    Outputˉstack = Bytesˉconcat(Outputˉstack, Bytesˉfromˉu8(6u8));
    Outputˉdepth = Outputˉdepth + 1u32;
    Outputˉbytes = Outputˉbytes + 1u32;
    Outputˉbody = Outputˉbody +
        Compilerˉnativeˉx64ˉfileˉreadˉbytesˉbytes();
    return Compilerˉnativeˉx64ˉcapabilityˉanalysis(
        true,
        Outputˉstack,
        Outputˉdepth,
        Outputˉtext,
        Outputˉu32,
        Outputˉbytes,
        Outputˉbody
    );
}

fn Appendˉbyte(Result: bytes, Value: u8) -> bytes {
    return Bytesˉconcat(Result, Bytesˉfromˉu8(Value));
}

fn Appendˉu32(Result: bytes, Value: u32) -> bytes {
    return Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Value));
}

fn Relativeˉu32(Target: u32, Origin: u32) -> u32 {
    if Target >= Origin { return Target - Origin; }
    let Magnitude: u32 = Origin - Target;
    return 4294967295u32 - Magnitude + 1u32;
}

export fn Compilerˉnativeˉx64ˉemitˉprocessˉargumentˉcount(
    Result: bytes,
    Target: u32
) -> bytes {
    var Output: bytes = Appendˉbyte(Result, 73u8);
    Output = Appendˉbyte(Output, 139u8);
    Output = Appendˉbyte(Output, 71u8);
    Output = Appendˉbyte(Output, 24u8);
    Output = Appendˉbyte(Output, 72u8);
    Output = Appendˉbyte(Output, 139u8);
    Output = Appendˉbyte(Output, 64u8);
    Output = Appendˉbyte(Output, 16u8);
    Output = Appendˉbyte(Output, 255u8);
    Output = Appendˉbyte(Output, 208u8);
    Output = Appendˉbyte(Output, 137u8);
    Output = Appendˉbyte(Output, 132u8);
    Output = Appendˉbyte(Output, 36u8);
    return Appendˉu32(Output, Target * 16u32);
}

export fn Compilerˉnativeˉx64ˉemitˉprocessˉargument(
    Result: bytes,
    Source: u32,
    Target: u32,
    Failureˉtarget: u32
) -> bytes {
    var Output: bytes = Appendˉbyte(Result, 139u8);
    Output = Appendˉbyte(Output, 132u8);
    Output = Appendˉbyte(Output, 36u8);
    Output = Appendˉu32(Output, Source * 16u32);
    Output = Appendˉbyte(Output, 65u8);
    Output = Appendˉbyte(Output, 137u8);
    Output = Appendˉbyte(Output, 192u8);
    Output = Appendˉbyte(Output, 76u8);
    Output = Appendˉbyte(Output, 141u8);
    Output = Appendˉbyte(Output, 140u8);
    Output = Appendˉbyte(Output, 36u8);
    Output = Appendˉu32(Output, Target * 16u32);
    Output = Appendˉbyte(Output, 73u8);
    Output = Appendˉbyte(Output, 139u8);
    Output = Appendˉbyte(Output, 71u8);
    Output = Appendˉbyte(Output, 24u8);
    Output = Appendˉbyte(Output, 72u8);
    Output = Appendˉbyte(Output, 139u8);
    Output = Appendˉbyte(Output, 64u8);
    Output = Appendˉbyte(Output, 24u8);
    Output = Appendˉbyte(Output, 255u8);
    Output = Appendˉbyte(Output, 208u8);
    Output = Appendˉbyte(Output, 133u8);
    Output = Appendˉbyte(Output, 192u8);
    Output = Appendˉbyte(Output, 15u8);
    Output = Appendˉbyte(Output, 133u8);
    return Appendˉu32(
        Output,
        Relativeˉu32(Failureˉtarget, Bytesˉlength(Output) + 4u32)
    );
}

export fn Compilerˉnativeˉx64ˉemitˉtextˉoutput(
    Result: bytes,
    Source: u32,
    Serviceˉoffset: u8,
    Failureˉtarget: u32
) -> bytes {
    var Output: bytes = Appendˉbyte(Result, 76u8);
    Output = Appendˉbyte(Output, 139u8);
    Output = Appendˉbyte(Output, 132u8);
    Output = Appendˉbyte(Output, 36u8);
    Output = Appendˉu32(Output, Source * 16u32);
    Output = Appendˉbyte(Output, 68u8);
    Output = Appendˉbyte(Output, 139u8);
    Output = Appendˉbyte(Output, 140u8);
    Output = Appendˉbyte(Output, 36u8);
    Output = Appendˉu32(Output, Source * 16u32 + 8u32);
    Output = Appendˉbyte(Output, 73u8);
    Output = Appendˉbyte(Output, 139u8);
    Output = Appendˉbyte(Output, 71u8);
    Output = Appendˉbyte(Output, 24u8);
    Output = Appendˉbyte(Output, 72u8);
    Output = Appendˉbyte(Output, 139u8);
    Output = Appendˉbyte(Output, 64u8);
    Output = Appendˉbyte(Output, Serviceˉoffset);
    Output = Appendˉbyte(Output, 255u8);
    Output = Appendˉbyte(Output, 208u8);
    Output = Appendˉbyte(Output, 133u8);
    Output = Appendˉbyte(Output, 192u8);
    Output = Appendˉbyte(Output, 15u8);
    Output = Appendˉbyte(Output, 133u8);
    return Appendˉu32(
        Output,
        Relativeˉu32(Failureˉtarget, Bytesˉlength(Output) + 4u32)
    );
}

export fn Compilerˉnativeˉx64ˉemitˉfileˉreadˉbytes(
    Result: bytes,
    Source: u32,
    Target: u32,
    Failureˉtarget: u32
) -> bytes {
    var Output: bytes = Appendˉbyte(Result, 76u8);
    Output = Appendˉbyte(Output, 139u8);
    Output = Appendˉbyte(Output, 132u8);
    Output = Appendˉbyte(Output, 36u8);
    Output = Appendˉu32(Output, Source * 16u32);
    Output = Appendˉbyte(Output, 68u8);
    Output = Appendˉbyte(Output, 139u8);
    Output = Appendˉbyte(Output, 140u8);
    Output = Appendˉbyte(Output, 36u8);
    Output = Appendˉu32(Output, Source * 16u32 + 8u32);
    Output = Appendˉbyte(Output, 72u8);
    Output = Appendˉbyte(Output, 141u8);
    Output = Appendˉbyte(Output, 140u8);
    Output = Appendˉbyte(Output, 36u8);
    Output = Appendˉu32(Output, Target * 16u32);
    Output = Appendˉbyte(Output, 73u8);
    Output = Appendˉbyte(Output, 139u8);
    Output = Appendˉbyte(Output, 71u8);
    Output = Appendˉbyte(Output, 24u8);
    Output = Appendˉbyte(Output, 72u8);
    Output = Appendˉbyte(Output, 139u8);
    Output = Appendˉbyte(Output, 64u8);
    Output = Appendˉbyte(Output, 32u8);
    Output = Appendˉbyte(Output, 255u8);
    Output = Appendˉbyte(Output, 208u8);
    Output = Appendˉbyte(Output, 133u8);
    Output = Appendˉbyte(Output, 192u8);
    Output = Appendˉbyte(Output, 15u8);
    Output = Appendˉbyte(Output, 133u8);
    return Appendˉu32(
        Output,
        Relativeˉu32(Failureˉtarget, Bytesˉlength(Output) + 4u32)
    );
}

export fn Compilerˉnativeˉx64ˉemitˉfileˉwriteˉbytes(
    Result: bytes,
    Nameˉsource: u32,
    Bytesˉsource: u32,
    Failureˉtarget: u32
) -> bytes {
    var Output: bytes = Appendˉbyte(Result, 76u8);
    Output = Appendˉbyte(Output, 139u8);
    Output = Appendˉbyte(Output, 132u8);
    Output = Appendˉbyte(Output, 36u8);
    Output = Appendˉu32(Output, Nameˉsource * 16u32);
    Output = Appendˉbyte(Output, 68u8);
    Output = Appendˉbyte(Output, 139u8);
    Output = Appendˉbyte(Output, 140u8);
    Output = Appendˉbyte(Output, 36u8);
    Output = Appendˉu32(Output, Nameˉsource * 16u32 + 8u32);
    Output = Appendˉbyte(Output, 72u8);
    Output = Appendˉbyte(Output, 139u8);
    Output = Appendˉbyte(Output, 140u8);
    Output = Appendˉbyte(Output, 36u8);
    Output = Appendˉu32(Output, Bytesˉsource * 16u32);
    Output = Appendˉbyte(Output, 139u8);
    Output = Appendˉbyte(Output, 148u8);
    Output = Appendˉbyte(Output, 36u8);
    Output = Appendˉu32(Output, Bytesˉsource * 16u32 + 8u32);
    Output = Appendˉbyte(Output, 73u8);
    Output = Appendˉbyte(Output, 139u8);
    Output = Appendˉbyte(Output, 71u8);
    Output = Appendˉbyte(Output, 24u8);
    Output = Appendˉbyte(Output, 72u8);
    Output = Appendˉbyte(Output, 139u8);
    Output = Appendˉbyte(Output, 64u8);
    Output = Appendˉbyte(Output, 96u8);
    Output = Appendˉbyte(Output, 255u8);
    Output = Appendˉbyte(Output, 208u8);
    Output = Appendˉbyte(Output, 133u8);
    Output = Appendˉbyte(Output, 192u8);
    Output = Appendˉbyte(Output, 15u8);
    Output = Appendˉbyte(Output, 133u8);
    return Appendˉu32(
        Output,
        Relativeˉu32(Failureˉtarget, Bytesˉlength(Output) + 4u32)
    );
}

export fn Compilerˉnativeˉx64ˉemitˉcapability(
    Kind: u8,
    Capabilityˉindex: u32,
    Result: bytes,
    Stackˉtypes: bytes,
    Stackˉslots: bytes,
    Stackˉdepth: u32,
    Nextˉtext: u32,
    Nextˉu32: u32,
    Nextˉbytes: u32,
    Locals: u32,
    I32ˉslots: u32,
    Boolˉslots: u32,
    Textˉslots: u32,
    U8ˉslots: u32,
    U32ˉslots: u32,
    Bytesˉslots: u32,
    Failureˉtarget: u32
) -> Compilerˉnativeˉx64ˉcapabilityˉstate {
    var Outputˉresult: bytes = Result;
    var Outputˉtypes: bytes = Stackˉtypes;
    var Outputˉslots: bytes = Stackˉslots;
    var Outputˉdepth: u32 = Stackˉdepth;
    var Outputˉtext: u32 = Nextˉtext;
    var Outputˉu32: u32 = Nextˉu32;
    var Outputˉbytes: u32 = Nextˉbytes;
    if Kind == Compilerˉnativeˉx64ˉmodelˉcatalogˉkind() ||
        Kind == Compilerˉnativeˉx64ˉmodelˉinferenceˉkind() ||
        Kind == Compilerˉnativeˉx64ˉstandardˉoutputˉwriteˉkind() {
        let Modelˉsource: u32 = Bytesˉreadˉu32ˉlittle(
            Outputˉslots, (Outputˉdepth - 1u32) * 4u32
        );
        let Modelˉresult: u32 =
            Layout.Compilerˉnativeˉx64ˉlayoutˉvalueˉslot(
                Locals,
                I32ˉslots,
                Boolˉslots,
                Textˉslots,
                U8ˉslots,
                U32ˉslots,
                Bytesˉslots,
                6u8,
                Outputˉbytes
            );
        let Modelˉemission: Providerˉcall.Compilerˉnativeˉx64ˉproviderˉcallˉemission =
            Providerˉcall.Compilerˉnativeˉx64ˉemitˉproviderˉcall(
                Outputˉresult,
                Capabilityˉindex,
                1u32,
                Modelˉsource,
                Modelˉsource,
                Modelˉsource,
                Modelˉsource,
                Modelˉsource,
                Modelˉresult,
                Failureˉtarget
            );
        Outputˉresult = Modelˉemission.Result;
        Outputˉdepth = Outputˉdepth - 1u32;
        Outputˉtypes = Bytesˉslice(Outputˉtypes, 0u32, Outputˉdepth);
        Outputˉslots = Bytesˉslice(Outputˉslots, 0u32, Outputˉdepth * 4u32);
        Outputˉtypes = Bytesˉconcat(Outputˉtypes, Bytesˉfromˉu8(6u8));
        Outputˉslots = Bytesˉconcat(
            Outputˉslots,
            Bytesˉfromˉu32ˉlittle(Modelˉresult)
        );
        Outputˉdepth = Outputˉdepth + 1u32;
        Outputˉbytes = Outputˉbytes + 1u32;
        return Compilerˉnativeˉx64ˉcapabilityˉstate(
            Outputˉresult,
            Outputˉtypes,
            Outputˉslots,
            Outputˉdepth,
            Outputˉtext,
            Outputˉu32,
            Outputˉbytes
        );
    }
    if Kind == Compilerˉnativeˉx64ˉdirectoryˉreadˉkind() {
        let Directoryˉnameˉsource: u32 = Bytesˉreadˉu32ˉlittle(
            Outputˉslots, (Outputˉdepth - 3u32) * 4u32
        );
        let Offsetˉsource: u32 = Bytesˉreadˉu32ˉlittle(
            Outputˉslots, (Outputˉdepth - 2u32) * 4u32
        );
        let Maximumˉsource: u32 = Bytesˉreadˉu32ˉlittle(
            Outputˉslots, (Outputˉdepth - 1u32) * 4u32
        );
        let Directoryˉresult: u32 =
            Layout.Compilerˉnativeˉx64ˉlayoutˉvalueˉslot(
                Locals,
                I32ˉslots,
                Boolˉslots,
                Textˉslots,
                U8ˉslots,
                U32ˉslots,
                Bytesˉslots,
                6u8,
                Outputˉbytes
            );
        let Directoryˉemission: Providerˉcall.Compilerˉnativeˉx64ˉproviderˉcallˉemission =
            Providerˉcall.Compilerˉnativeˉx64ˉemitˉproviderˉcall(
                Outputˉresult,
                Capabilityˉindex,
                3u32,
                Directoryˉnameˉsource,
                Offsetˉsource,
                Maximumˉsource,
                Maximumˉsource,
                Maximumˉsource,
                Directoryˉresult,
                Failureˉtarget
            );
        Outputˉresult = Directoryˉemission.Result;
        Outputˉdepth = Outputˉdepth - 3u32;
        Outputˉtypes = Bytesˉslice(Outputˉtypes, 0u32, Outputˉdepth);
        Outputˉslots = Bytesˉslice(Outputˉslots, 0u32, Outputˉdepth * 4u32);
        Outputˉtypes = Bytesˉconcat(Outputˉtypes, Bytesˉfromˉu8(6u8));
        Outputˉslots = Bytesˉconcat(
            Outputˉslots,
            Bytesˉfromˉu32ˉlittle(Directoryˉresult)
        );
        Outputˉdepth = Outputˉdepth + 1u32;
        Outputˉbytes = Outputˉbytes + 1u32;
        return Compilerˉnativeˉx64ˉcapabilityˉstate(
            Outputˉresult,
            Outputˉtypes,
            Outputˉslots,
            Outputˉdepth,
            Outputˉtext,
            Outputˉu32,
            Outputˉbytes
        );
    }
    if Kind == Compilerˉnativeˉx64ˉstorageˉrandomˉaccessˉkind() {
        let Firstˉsource: u32 = Bytesˉreadˉu32ˉlittle(
            Outputˉslots, (Outputˉdepth - 5u32) * 4u32
        );
        let Secondˉsource: u32 = Bytesˉreadˉu32ˉlittle(
            Outputˉslots, (Outputˉdepth - 4u32) * 4u32
        );
        let Thirdˉsource: u32 = Bytesˉreadˉu32ˉlittle(
            Outputˉslots, (Outputˉdepth - 3u32) * 4u32
        );
        let Fourthˉsource: u32 = Bytesˉreadˉu32ˉlittle(
            Outputˉslots, (Outputˉdepth - 2u32) * 4u32
        );
        let Fifthˉsource: u32 = Bytesˉreadˉu32ˉlittle(
            Outputˉslots, (Outputˉdepth - 1u32) * 4u32
        );
        let Storageˉresult: u32 =
            Layout.Compilerˉnativeˉx64ˉlayoutˉvalueˉslot(
                Locals,
                I32ˉslots,
                Boolˉslots,
                Textˉslots,
                U8ˉslots,
                U32ˉslots,
                Bytesˉslots,
                6u8,
                Outputˉbytes
            );
        let Emission: Providerˉcall.Compilerˉnativeˉx64ˉproviderˉcallˉemission =
            Providerˉcall.Compilerˉnativeˉx64ˉemitˉproviderˉcall(
                Outputˉresult,
                Capabilityˉindex,
                5u32,
                Firstˉsource,
                Secondˉsource,
                Thirdˉsource,
                Fourthˉsource,
                Fifthˉsource,
                Storageˉresult,
                Failureˉtarget
            );
        Outputˉresult = Emission.Result;
        Outputˉdepth = Outputˉdepth - 5u32;
        Outputˉtypes = Bytesˉslice(Outputˉtypes, 0u32, Outputˉdepth);
        Outputˉslots = Bytesˉslice(Outputˉslots, 0u32, Outputˉdepth * 4u32);
        Outputˉtypes = Bytesˉconcat(Outputˉtypes, Bytesˉfromˉu8(6u8));
        Outputˉslots = Bytesˉconcat(
            Outputˉslots,
            Bytesˉfromˉu32ˉlittle(Storageˉresult)
        );
        Outputˉdepth = Outputˉdepth + 1u32;
        Outputˉbytes = Outputˉbytes + 1u32;
        return Compilerˉnativeˉx64ˉcapabilityˉstate(
            Outputˉresult,
            Outputˉtypes,
            Outputˉslots,
            Outputˉdepth,
            Outputˉtext,
            Outputˉu32,
            Outputˉbytes
        );
    }
    if Kind == Compilerˉnativeˉx64ˉprocessˉargumentˉcountˉkind() {
        let Countˉresult: u32 = Locals + I32ˉslots + Boolˉslots +
            Textˉslots + U8ˉslots + Outputˉu32;
        Outputˉresult = Compilerˉnativeˉx64ˉemitˉprocessˉargumentˉcount(
            Outputˉresult,
            Countˉresult
        );
        Outputˉtypes = Bytesˉconcat(Outputˉtypes, Bytesˉfromˉu8(5u8));
        Outputˉslots = Bytesˉconcat(
            Outputˉslots,
            Bytesˉfromˉu32ˉlittle(Countˉresult)
        );
        Outputˉdepth = Outputˉdepth + 1u32;
        Outputˉu32 = Outputˉu32 + 1u32;
        return Compilerˉnativeˉx64ˉcapabilityˉstate(
            Outputˉresult,
            Outputˉtypes,
            Outputˉslots,
            Outputˉdepth,
            Outputˉtext,
            Outputˉu32,
            Outputˉbytes
        );
    }
    if Kind == Compilerˉnativeˉx64ˉfileˉwriteˉbytesˉkind() {
        let Bytesˉsource: u32 = Bytesˉreadˉu32ˉlittle(
            Outputˉslots,
            (Outputˉdepth - 1u32) * 4u32
        );
        let Nameˉsource: u32 = Bytesˉreadˉu32ˉlittle(
            Outputˉslots,
            (Outputˉdepth - 2u32) * 4u32
        );
        Outputˉdepth = Outputˉdepth - 2u32;
        Outputˉtypes = Bytesˉslice(Outputˉtypes, 0u32, Outputˉdepth);
        Outputˉslots = Bytesˉslice(Outputˉslots, 0u32, Outputˉdepth * 4u32);
        Outputˉresult = Compilerˉnativeˉx64ˉemitˉfileˉwriteˉbytes(
            Outputˉresult,
            Nameˉsource,
            Bytesˉsource,
            Failureˉtarget
        );
        return Compilerˉnativeˉx64ˉcapabilityˉstate(
            Outputˉresult,
            Outputˉtypes,
            Outputˉslots,
            Outputˉdepth,
            Outputˉtext,
            Outputˉu32,
            Outputˉbytes
        );
    }
    let Source: u32 = Bytesˉreadˉu32ˉlittle(
        Outputˉslots,
        (Outputˉdepth - 1u32) * 4u32
    );
    Outputˉdepth = Outputˉdepth - 1u32;
    Outputˉtypes = Bytesˉslice(Outputˉtypes, 0u32, Outputˉdepth);
    Outputˉslots = Bytesˉslice(Outputˉslots, 0u32, Outputˉdepth * 4u32);
    if Kind == Compilerˉnativeˉx64ˉconsoleˉwriteˉlineˉkind() ||
        Kind == Compilerˉnativeˉx64ˉdiagnosticˉwriteˉlineˉkind() {
        var Serviceˉoffset: u8 = 8u8;
        if Kind == Compilerˉnativeˉx64ˉdiagnosticˉwriteˉlineˉkind() {
            Serviceˉoffset = 48u8;
        }
        Outputˉresult = Compilerˉnativeˉx64ˉemitˉtextˉoutput(
            Outputˉresult,
            Source,
            Serviceˉoffset,
            Failureˉtarget
        );
        return Compilerˉnativeˉx64ˉcapabilityˉstate(
            Outputˉresult,
            Outputˉtypes,
            Outputˉslots,
            Outputˉdepth,
            Outputˉtext,
            Outputˉu32,
            Outputˉbytes
        );
    }
    if Kind == Compilerˉnativeˉx64ˉfileˉreadˉbytesˉkind() {
        let Fileˉresult: u32 = Layout.Compilerˉnativeˉx64ˉlayoutˉvalueˉslot(
            Locals,
            I32ˉslots,
            Boolˉslots,
            Textˉslots,
            U8ˉslots,
            U32ˉslots,
            Bytesˉslots,
            6u8,
            Outputˉbytes
        );
        Outputˉresult = Compilerˉnativeˉx64ˉemitˉfileˉreadˉbytes(
            Outputˉresult,
            Source,
            Fileˉresult,
            Failureˉtarget
        );
        Outputˉtypes = Bytesˉconcat(Outputˉtypes, Bytesˉfromˉu8(6u8));
        Outputˉslots = Bytesˉconcat(
            Outputˉslots,
            Bytesˉfromˉu32ˉlittle(Fileˉresult)
        );
        Outputˉdepth = Outputˉdepth + 1u32;
        Outputˉbytes = Outputˉbytes + 1u32;
    } else {
        let Argumentˉresult: u32 = Locals + I32ˉslots + Boolˉslots + Outputˉtext;
        Outputˉresult = Compilerˉnativeˉx64ˉemitˉprocessˉargument(
            Outputˉresult,
            Source,
            Argumentˉresult,
            Failureˉtarget
        );
        Outputˉtypes = Bytesˉconcat(Outputˉtypes, Bytesˉfromˉu8(3u8));
        Outputˉslots = Bytesˉconcat(
            Outputˉslots,
            Bytesˉfromˉu32ˉlittle(Argumentˉresult)
        );
        Outputˉdepth = Outputˉdepth + 1u32;
        Outputˉtext = Outputˉtext + 1u32;
    }
    return Compilerˉnativeˉx64ˉcapabilityˉstate(
        Outputˉresult,
        Outputˉtypes,
        Outputˉslots,
        Outputˉdepth,
        Outputˉtext,
        Outputˉu32,
        Outputˉbytes
    );
}
