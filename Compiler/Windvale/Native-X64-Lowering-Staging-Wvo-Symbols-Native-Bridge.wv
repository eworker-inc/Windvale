    return Result.Functions;
}

export fn Compilerˉnativeˉx64ˉstagingˉwvoˉsymbolsˉnativeˉrelocationˉposition(
    Stagingˉmanifest: bytes,
    Prefix: bytes,
    Readˉonlyˉheader: bytes,
    Symbolˉchunk: bytes
) -> u32 {
    let Result: Symbols.Compilerˉnativeˉx64ˉstagingˉwvoˉsymbolsˉsummary =
        Summary(Stagingˉmanifest, Prefix, Readˉonlyˉheader, Symbolˉchunk);
    return Result.Relocationˉposition;
}

export fn Compilerˉnativeˉx64ˉstagingˉwvoˉsymbolsˉnativeˉrelocationˉbytes(
    Stagingˉmanifest: bytes,
    Prefix: bytes,
    Readˉonlyˉheader: bytes,
    Symbolˉchunk: bytes
) -> u32 {
    let Result: Symbols.Compilerˉnativeˉx64ˉstagingˉwvoˉsymbolsˉsummary =
        Summary(Stagingˉmanifest, Prefix, Readˉonlyˉheader, Symbolˉchunk);
    return Result.Relocationˉbytes;
}
