#!wv/1 en@1
module Compilerˉsourceˉbindingsˉclosures;
profile core;
platform linux, windows, windvale;
authority library;

import Compilerˉsourceˉbindings as Bindings;
import Compilerˉsourceˉclosureˉlowering as Closures;
import Compilerˉsourceˉgenericˉlowering as Sourceˉgenerics;
import Compilerˉsourceˉgenericˉtypeˉlowering as Genericˉtypes;
import Compilerˉsourceˉset as Sourceˉset;
import Compilerˉsourceˉsymbols as Sourceˉsymbols;

const CLOSURE_BINDING_HEADER_BYTES: u32 = 48u32;
const CLOSURE_BINDING_RANGE_BYTES: u32 = 32u32;
const CLOSURE_BINDING_ENTRY_BYTES: u32 = 36u32;
const CLOSURE_BINDING_DIRECTORY_LIMIT: u32 = 4194304u32;
const CLOSURE_BINDING_ENTRY_LIMIT: u32 = 116508u32;
const CLOSURE_BINDING_CATALOG_LIMIT: u32 = 1048576u32;

fn Compilerˉsourceˉbindingsˉclosuresˉsentinel() -> u32 {
    return 4294967295u32;
}

fn Compilerˉsourceˉbindingsˉclosuresˉempty(Input: bytes) -> bytes {
    return Bytesˉslice(Input, 0u32, 0u32);
}

fn Compilerˉsourceˉbindingsˉclosuresˉappendˉu32(
    Input: bytes,
    Value: u32
) -> bytes {
    return Bytesˉconcat(Input, Bytesˉfromˉu32ˉlittle(Value));
}

fn Compilerˉsourceˉbindingsˉclosuresˉcatalogˉevidence(
    Catalog: Sourceˉgenerics.Compilerˉsourceˉgenericˉcatalog
) -> bytes {
    if Sourceˉgenerics.Compilerˉsourceˉgenericˉcatalogˉinstances(Catalog) ==
            0u32 {
        return Compilerˉsourceˉbindingsˉclosuresˉempty(Catalog.Evidence);
    }
    return Catalog.Evidence;
}

fn Compilerˉsourceˉbindingsˉclosuresˉtypeˉevidence(
    Catalog: Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog
) -> bytes {
    if Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalogˉinstances(Catalog) ==
            0u32 {
        return Compilerˉsourceˉbindingsˉclosuresˉempty(Catalog.Evidence);
    }
    return Catalog.Evidence;
}

fn Compilerˉsourceˉbindingsˉclosuresˉheader(
    Entries: u32,
    Ranges: u32,
    Functionˉcatalogˉbytes: u32,
    Typeˉcatalogˉbytes: u32,
    Closureˉcatalogˉbytes: u32,
    Baseˉfunctions: u32
) -> bytes {
    var Result: bytes = Textˉtoˉutf8("WVLB");
    Result = Bytesˉconcat(Result, Bytesˉfromˉu16ˉlittle(1u32));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu16ˉlittle(4u32));
    Result = Compilerˉsourceˉbindingsˉclosuresˉappendˉu32(Result, Entries);
    Result = Compilerˉsourceˉbindingsˉclosuresˉappendˉu32(
        Result, CLOSURE_BINDING_ENTRY_BYTES
    );
    Result = Compilerˉsourceˉbindingsˉclosuresˉappendˉu32(Result, Ranges);
    Result = Compilerˉsourceˉbindingsˉclosuresˉappendˉu32(
        Result, CLOSURE_BINDING_RANGE_BYTES
    );
    Result = Compilerˉsourceˉbindingsˉclosuresˉappendˉu32(
        Result, Functionˉcatalogˉbytes
    );
    Result = Compilerˉsourceˉbindingsˉclosuresˉappendˉu32(
        Result, Typeˉcatalogˉbytes
    );
    Result = Compilerˉsourceˉbindingsˉclosuresˉappendˉu32(
        Result, Closureˉcatalogˉbytes
    );
    Result = Compilerˉsourceˉbindingsˉclosuresˉappendˉu32(
        Result, Baseˉfunctions
    );
    Result = Compilerˉsourceˉbindingsˉclosuresˉappendˉu32(Result, 3u32);
    return Compilerˉsourceˉbindingsˉclosuresˉappendˉu32(Result, 0u32);
}

export fn Compilerˉsourceˉbindingsˉclosuresˉdeclaration(
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Functionˉcatalog: Sourceˉgenerics.Compilerˉsourceˉgenericˉcatalog,
    Function: u32
) -> u32 {
    let Symbolsˉcount: u32 = Bytesˉreadˉu32ˉlittle(
        Symbols.Directory, 8u32
    );
    if Function < Symbolsˉcount { return Function; }
    return Sourceˉgenerics.Compilerˉsourceˉgenericˉcatalogˉinstanceˉdeclaration(
        Functionˉcatalog, Function - Symbolsˉcount
    );
}

fn Compilerˉsourceˉbindingsˉclosuresˉparameters(
    Build: Bindings.Compilerˉsourceˉbindingˉbuild,
    First: u32,
    Count: u32
) -> u32 {
    var Result: u32 = 0u32;
    var Entry: u32 = First;
    while Entry < First + Count {
        if Bytesˉreadˉu32ˉlittle(
                Build.Payload, Entry * CLOSURE_BINDING_ENTRY_BYTES + 8u32
            ) == 1u32 {
            Result = Result + 1u32;
        }
        Entry = Entry + 1u32;
    }
    return Result;
}

fn Compilerˉsourceˉbindingsˉclosuresˉrangesˉvalue(
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Build: Bindings.Compilerˉsourceˉbindingˉbuild,
    Baseˉfunctions: u32,
    Functionˉcatalog: Sourceˉgenerics.Compilerˉsourceˉgenericˉcatalog,
    Closureˉcatalog: Closures.Compilerˉsourceˉclosureˉcatalog
) -> bytes {
    let Symbolsˉcount: u32 = Bytesˉreadˉu32ˉlittle(
        Symbols.Directory, 8u32
    );
    let Closureˉinstances: u32 =
        Closures.Compilerˉsourceˉclosureˉcatalogˉinstances(Closureˉcatalog);
    let Functions: u32 = Baseˉfunctions + Closureˉinstances;
    var Result: bytes = Compilerˉsourceˉbindingsˉclosuresˉempty(
        Symbols.Directory
    );
    var Binding: u32 = 0u32;
    var Function: u32 = 0u32;
    while Function < Functions {
        let First: u32 = Binding;
        var Count: u32 = 0u32;
        var Reading: bool = true;
        while Reading {
            if Binding >= Build.Entries {
                Reading = false;
            } else if Bytesˉreadˉu32ˉlittle(
                    Build.Payload,
                    Binding * CLOSURE_BINDING_ENTRY_BYTES + 4u32
                ) != Function {
                Reading = false;
            } else {
                Binding = Binding + 1u32;
                Count = Count + 1u32;
            }
        }
        var Declaration: u32 = Function;
        var Genericˉinstance: u32 =
            Compilerˉsourceˉbindingsˉclosuresˉsentinel();
        var Closureˉinstance: u32 =
            Compilerˉsourceˉbindingsˉclosuresˉsentinel();
        var Captures: u32 = 0u32;
        var Parameters: u32 = 0u32;
        var Flags: u32 = 0u32;
        if Function < Baseˉfunctions {
            Declaration = Compilerˉsourceˉbindingsˉclosuresˉdeclaration(
                Symbols, Functionˉcatalog, Function
            );
            if Function >= Symbolsˉcount {
                Genericˉinstance = Function - Symbolsˉcount;
            }
            Parameters = Bytesˉreadˉu32ˉlittle(
                Symbols.Directory,
                16u32 + Declaration * 24u32 + 20u32
            );
        } else {
            Closureˉinstance = Function - Baseˉfunctions;
            let Parent: u32 =
                Closures.Compilerˉsourceˉclosureˉcatalogˉparentˉfunction(
                    Closureˉcatalog, Closureˉinstance
                );
            Declaration = Compilerˉsourceˉbindingsˉclosuresˉdeclaration(
                Symbols, Functionˉcatalog, Parent
            );
            if Parent >= Symbolsˉcount {
                Genericˉinstance = Parent - Symbolsˉcount;
            }
            Captures = Closures.Compilerˉsourceˉclosureˉcatalogˉcaptures(
                Closureˉcatalog, Closureˉinstance
            );
            Parameters = Compilerˉsourceˉbindingsˉclosuresˉparameters(
                Build, First, Count
            );
            Flags = 1u32;
        }
        Result = Compilerˉsourceˉbindingsˉclosuresˉappendˉu32(Result, First);
        Result = Compilerˉsourceˉbindingsˉclosuresˉappendˉu32(Result, Count);
        Result = Compilerˉsourceˉbindingsˉclosuresˉappendˉu32(
            Result, Declaration
        );
        Result = Compilerˉsourceˉbindingsˉclosuresˉappendˉu32(
            Result, Genericˉinstance
        );
        Result = Compilerˉsourceˉbindingsˉclosuresˉappendˉu32(
            Result, Closureˉinstance
        );
        Result = Compilerˉsourceˉbindingsˉclosuresˉappendˉu32(
            Result, Captures
        );
        Result = Compilerˉsourceˉbindingsˉclosuresˉappendˉu32(
            Result, Parameters
        );
        Result = Compilerˉsourceˉbindingsˉclosuresˉappendˉu32(Result, Flags);
        Function = Function + 1u32;
    }
    return Result;
}

fn Compilerˉsourceˉbindingsˉclosuresˉdirectory(
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Build: Bindings.Compilerˉsourceˉbindingˉbuild,
    Baseˉfunctions: u32,
    Functionˉcatalog: Sourceˉgenerics.Compilerˉsourceˉgenericˉcatalog,
    Typeˉcatalog: Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog,
    Closureˉcatalog: Closures.Compilerˉsourceˉclosureˉcatalog
) -> bytes {
    let Functionˉevidence: bytes =
        Compilerˉsourceˉbindingsˉclosuresˉcatalogˉevidence(
            Functionˉcatalog
        );
    let Typeˉevidence: bytes =
        Compilerˉsourceˉbindingsˉclosuresˉtypeˉevidence(Typeˉcatalog);
    let Closureˉinstances: u32 =
        Closures.Compilerˉsourceˉclosureˉcatalogˉinstances(Closureˉcatalog);
    let Header: bytes = Compilerˉsourceˉbindingsˉclosuresˉheader(
        Build.Entries, Baseˉfunctions + Closureˉinstances,
        Bytesˉlength(Functionˉevidence), Bytesˉlength(Typeˉevidence),
        Bytesˉlength(Closureˉcatalog.Evidence), Baseˉfunctions
    );
    let Ranges: bytes = Compilerˉsourceˉbindingsˉclosuresˉrangesˉvalue(
        Symbols, Build, Baseˉfunctions, Functionˉcatalog, Closureˉcatalog
    );
    var Result: bytes = Bytesˉconcat(Header, Ranges);
    Result = Bytesˉconcat(Result, Functionˉevidence);
    Result = Bytesˉconcat(Result, Typeˉevidence);
    Result = Bytesˉconcat(Result, Closureˉcatalog.Evidence);
    return Bytesˉconcat(Result, Build.Payload);
}

fn Compilerˉsourceˉbindingsˉclosuresˉsitesˉareˉvalid(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Baseˉfunctions: u32,
    Functionˉcatalog: Sourceˉgenerics.Compilerˉsourceˉgenericˉcatalog,
    Closureˉcatalog: Closures.Compilerˉsourceˉclosureˉcatalog
) -> bool {
    let Symbolsˉcount: u32 = Bytesˉreadˉu32ˉlittle(
        Symbols.Directory, 8u32
    );
    let Instances: u32 =
        Closures.Compilerˉsourceˉclosureˉcatalogˉinstances(Closureˉcatalog);
    var Instance: u32 = 0u32;
    while Instance < Instances {
        let Module: u32 = Closures.Compilerˉsourceˉclosureˉcatalogˉmodule(
            Closureˉcatalog, Instance
        );
        let Parent: u32 =
            Closures.Compilerˉsourceˉclosureˉcatalogˉparentˉfunction(
                Closureˉcatalog, Instance
            );
        if Module >= Scan.Modules || Parent >= Baseˉfunctions {
            return false;
        }
        let Declaration: u32 =
            Compilerˉsourceˉbindingsˉclosuresˉdeclaration(
                Symbols, Functionˉcatalog, Parent
            );
        if Declaration >= Symbolsˉcount {
            return false;
        }
        let Symbolˉentry: u32 = 16u32 + Declaration * 24u32;
        if Bytesˉreadˉu32ˉlittle(Symbols.Directory, Symbolˉentry) != Module ||
            Bytesˉreadˉu32ˉlittle(
                Symbols.Directory, Symbolˉentry + 4u32
            ) != 6u32 {
            return false;
        }
        let View: Sourceˉset.Compilerˉsourceˉsetˉview =
            Sourceˉset.Compilerˉsourceˉsetˉmodule(Input, Scan, Module);
        let Offset: u32 = Closures.Compilerˉsourceˉclosureˉcatalogˉoffset(
            Closureˉcatalog, Instance
        );
        let Span: u32 = Closures.Compilerˉsourceˉclosureˉcatalogˉlength(
            Closureˉcatalog, Instance
        );
        if View.Status != Sourceˉset.Compilerˉsourceˉsetˉstatus.Valid ||
            Offset >= Bytesˉlength(View.Source) ||
            Span > Bytesˉlength(View.Source) - Offset {
            return false;
        }
        Instance = Instance + 1u32;
    }
    return true;
}

fn Compilerˉsourceˉbindingsˉclosuresˉfailure(
    Input: bytes,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Phase: Bindings.Compilerˉsourceˉbindingˉphase,
    Functions: u32,
    Status: Bindings.Compilerˉsourceˉbindingˉstatus
) -> Bindings.Compilerˉsourceˉbindingˉsummary {
    let Build: Bindings.Compilerˉsourceˉbindingˉbuild =
        Bindings.Compilerˉsourceˉbindingsˉphaseˉbuildˉvalue(Phase);
    let Failed: Bindings.Compilerˉsourceˉbindingˉbuild =
        Bindings.Compilerˉsourceˉbindingsˉbuildˉfailure(
            Build, Status,
            Symbols.Modules, Symbols.Modules, Functions,
            Bytesˉlength(Input), 0u32, 0u32
        );
    return Bindings.Compilerˉsourceˉbindingsˉsummaryˉfromˉbuild(
        Input, Symbols, Failed
    );
}

export fn Compilerˉsourceˉbindingsˉclosuresˉfinishˉphaseˉproduct(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Phase: Bindings.Compilerˉsourceˉbindingˉphase,
    Baseˉfunctions: u32,
    Functionˉcatalog: Sourceˉgenerics.Compilerˉsourceˉgenericˉcatalog,
    Typeˉcatalog: Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog,
    Closureˉcatalog: Closures.Compilerˉsourceˉclosureˉcatalog
) -> Bindings.Compilerˉsourceˉbindingˉsummary {
    if Phase.Buildˉstatus != Bindings.Compilerˉsourceˉbindingˉstatus.Valid {
        return Bindings.Compilerˉsourceˉbindingsˉsummaryˉfromˉbuild(
            Input, Symbols,
            Bindings.Compilerˉsourceˉbindingsˉphaseˉbuildˉvalue(Phase)
        );
    }
    if Phase.Bodyˉstatus != Bindings.Compilerˉsourceˉbindingˉstatus.Valid {
        return Bindings.Compilerˉsourceˉbindingsˉsummaryˉfromˉbody(
            Input, Symbols,
            Bindings.Compilerˉsourceˉbindingsˉphaseˉbuildˉvalue(Phase),
            Bindings.Compilerˉsourceˉbindingsˉphaseˉbodyˉvalue(Phase)
        );
    }
    if Scan.Status != Sourceˉset.Compilerˉsourceˉsetˉstatus.Valid ||
        Symbols.Status != Sourceˉsymbols.Compilerˉsourceˉsymbolˉstatus.Valid ||
        Bytesˉlength(Symbols.Directory) < 16u32 ||
        !Sourceˉgenerics.Compilerˉsourceˉgenericˉcatalogˉisˉvalid(
            Functionˉcatalog
        ) ||
        !Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalogˉisˉvalid(
            Typeˉcatalog
        ) ||
        !Closures.Compilerˉsourceˉclosureˉcatalogˉisˉvalid(Closureˉcatalog) {
        return Compilerˉsourceˉbindingsˉclosuresˉfailure(
            Input, Symbols, Phase, Baseˉfunctions,
            Bindings.Compilerˉsourceˉbindingˉstatus.Invalidˉdirectory
        );
    }
    let Functionˉinstances: u32 =
        Sourceˉgenerics.Compilerˉsourceˉgenericˉcatalogˉinstances(
            Functionˉcatalog
        );
    let Closureˉinstances: u32 =
        Closures.Compilerˉsourceˉclosureˉcatalogˉinstances(Closureˉcatalog);
    let Symbolsˉcount: u32 = Bytesˉreadˉu32ˉlittle(
        Symbols.Directory, 8u32
    );
    if !Sourceˉsymbols.Compilerˉsourceˉsymbolsˉdirectoryˉshapeˉisˉvalid(
            Symbols.Directory, Symbolsˉcount
        ) ||
        Closureˉinstances == 0u32 ||
        Symbolsˉcount > 4294967295u32 - Functionˉinstances ||
        Baseˉfunctions != Symbolsˉcount + Functionˉinstances ||
        Baseˉfunctions > 4294967295u32 - Closureˉinstances ||
        !Compilerˉsourceˉbindingsˉclosuresˉsitesˉareˉvalid(
            Input, Scan, Symbols, Baseˉfunctions,
            Functionˉcatalog, Closureˉcatalog
        ) {
        return Compilerˉsourceˉbindingsˉclosuresˉfailure(
            Input, Symbols, Phase, Baseˉfunctions,
            Bindings.Compilerˉsourceˉbindingˉstatus.Invalidˉdirectory
        );
    }
    let Functions: u32 = Baseˉfunctions + Closureˉinstances;
    let Functionˉevidence: bytes =
        Compilerˉsourceˉbindingsˉclosuresˉcatalogˉevidence(
            Functionˉcatalog
        );
    let Typeˉevidence: bytes =
        Compilerˉsourceˉbindingsˉclosuresˉtypeˉevidence(Typeˉcatalog);
    if Functions > 131070u32 || Phase.Entries > CLOSURE_BINDING_ENTRY_LIMIT {
        return Compilerˉsourceˉbindingsˉclosuresˉfailure(
            Input, Symbols, Phase, Functions,
            Bindings.Compilerˉsourceˉbindingˉstatus.Evidenceˉlimit
        );
    }
    if Bytesˉlength(Phase.Payload) !=
            Phase.Entries * CLOSURE_BINDING_ENTRY_BYTES {
        return Compilerˉsourceˉbindingsˉclosuresˉfailure(
            Input, Symbols, Phase, Functions,
            Bindings.Compilerˉsourceˉbindingˉstatus.Invalidˉdirectory
        );
    }
    let Functionˉbytes: u32 = Bytesˉlength(Functionˉevidence);
    let Typeˉbytes: u32 = Bytesˉlength(Typeˉevidence);
    let Closureˉbytes: u32 = Bytesˉlength(Closureˉcatalog.Evidence);
    var Overhead: u32 = CLOSURE_BINDING_HEADER_BYTES +
        Functions * CLOSURE_BINDING_RANGE_BYTES;
    if Functionˉbytes > CLOSURE_BINDING_CATALOG_LIMIT ||
        Typeˉbytes > CLOSURE_BINDING_CATALOG_LIMIT ||
        Closureˉbytes < 24u32 || Closureˉbytes > 8192u32 ||
        Functionˉbytes > CLOSURE_BINDING_DIRECTORY_LIMIT - Overhead {
        return Compilerˉsourceˉbindingsˉclosuresˉfailure(
            Input, Symbols, Phase, Functions,
            Bindings.Compilerˉsourceˉbindingˉstatus.Evidenceˉlimit
        );
    }
    Overhead = Overhead + Functionˉbytes;
    if Typeˉbytes > CLOSURE_BINDING_DIRECTORY_LIMIT - Overhead {
        return Compilerˉsourceˉbindingsˉclosuresˉfailure(
            Input, Symbols, Phase, Functions,
            Bindings.Compilerˉsourceˉbindingˉstatus.Evidenceˉlimit
        );
    }
    Overhead = Overhead + Typeˉbytes;
    if Closureˉbytes > CLOSURE_BINDING_DIRECTORY_LIMIT - Overhead {
        return Compilerˉsourceˉbindingsˉclosuresˉfailure(
            Input, Symbols, Phase, Functions,
            Bindings.Compilerˉsourceˉbindingˉstatus.Evidenceˉlimit
        );
    }
    Overhead = Overhead + Closureˉbytes;
    if Bytesˉlength(Phase.Payload) >
            CLOSURE_BINDING_DIRECTORY_LIMIT - Overhead {
        return Compilerˉsourceˉbindingsˉclosuresˉfailure(
            Input, Symbols, Phase, Functions,
            Bindings.Compilerˉsourceˉbindingˉstatus.Evidenceˉlimit
        );
    }
    let Directory: bytes = Compilerˉsourceˉbindingsˉclosuresˉdirectory(
        Symbols,
        Bindings.Compilerˉsourceˉbindingsˉphaseˉbuildˉvalue(Phase),
        Baseˉfunctions, Functionˉcatalog, Typeˉcatalog, Closureˉcatalog
    );
    return Bindings.Compilerˉsourceˉbindingˉsummary(
        Bindings.Compilerˉsourceˉbindingˉstatus.Valid,
        Sourceˉsymbols.Compilerˉsourceˉsymbolˉstatus.Valid,
        Symbols.Modules, Functions,
        Phase.Parameters, Phase.Locals,
        Phase.Reads, Phase.Assignments, Phase.Calls,
        Directory,
        Symbols.Modules, Symbols.Modules, Functions,
        Bytesˉlength(Input), 0u32, 0u32
    );
}
