module Compilerˉsourceˉbindings profile portable;

import Compilerˉsourceˉbodyˉparser as Sourceˉbodies;
import Compilerˉsourceˉdeclarationˉparser as Sourceˉdeclarations;
import Compilerˉsourceˉgraph as Sourceˉgraph;
import Compilerˉsourceˉlexer as Sourceˉlexer;
import Compilerˉsourceˉset as Sourceˉset;
import Compilerˉsourceˉsymbols as Sourceˉsymbols;

export enum Compilerˉsourceˉbindingˉstatus {
    Valid = 0;
    Sourceˉsymbols = 1;
    Bindingˉlimit = 2;
    Evidenceˉlimit = 3;
    Duplicateˉlocal = 4;
    Unknownˉtype = 5;
    Inaccessibleˉtype = 6;
    Invalidˉdirectory = 7;
    Unknownˉname = 8;
    Inaccessibleˉname = 9;
    Unknownˉassignment = 10;
    Immutableˉassignment = 11;
    Inaccessibleˉcall = 12;
    Undeclaredˉcapability = 13;
    Unknownˉcall = 14;
    Callˉarity = 15;
}

export enum Compilerˉsourceˉbindingˉkind {
    None = 0;
    Parameter = 1;
    Let = 2;
    Var = 3;
}

export enum Compilerˉsourceˉcallableˉkind {
    None = 0;
    Intrinsic = 1;
    Record = 2;
    Function = 3;
    Capability = 4;
    Variantˉcase = 5;
}

export record Compilerˉsourceˉbindingˉmatch {
    Found: bool;
    Accessible: bool;
    Kind: Compilerˉsourceˉcallableˉkind;
    Module: u32;
    Items: u32;
    Directoryˉentry: u32;
}

record Compilerˉsourceˉbindingˉquery {
    Qualified: bool;
    Aliasˉfound: bool;
    Target: u32;
    Nameˉoffset: u32;
    Nameˉlength: u32;
}

export record Compilerˉsourceˉlocalˉmatch {
    Found: bool;
    Kind: Compilerˉsourceˉbindingˉkind;
    Slot: u32;
    Shape: u32;
}

export record Compilerˉsourceˉbindingˉbuild {
    Status: Compilerˉsourceˉbindingˉstatus;
    Payload: bytes;
    Entries: u32;
    Parameters: u32;
    Locals: u32;
    Nextˉslot: u32;
    Failureˉmodule: u32;
    Failureˉrelatedˉmodule: u32;
    Failureˉfunction: u32;
    Failureˉoffset: u32;
    Failureˉline: u32;
    Failureˉcolumn: u32;
}

record Compilerˉsourceˉbindingˉbody {
    Status: Compilerˉsourceˉbindingˉstatus;
    Reads: u32;
    Assignments: u32;
    Calls: u32;
    Failureˉmodule: u32;
    Failureˉrelatedˉmodule: u32;
    Failureˉfunction: u32;
    Failureˉoffset: u32;
    Failureˉline: u32;
    Failureˉcolumn: u32;
}

export record Compilerˉsourceˉbindingˉsummary {
    Status: Compilerˉsourceˉbindingˉstatus;
    Symbolˉstatus: Sourceˉsymbols.Compilerˉsourceˉsymbolˉstatus;
    Modules: u32;
    Functions: u32;
    Parameters: u32;
    Locals: u32;
    Reads: u32;
    Assignments: u32;
    Calls: u32;
    Directory: bytes;
    Failureˉmodule: u32;
    Failureˉrelatedˉmodule: u32;
    Failureˉfunction: u32;
    Failureˉoffset: u32;
    Failureˉline: u32;
    Failureˉcolumn: u32;
}

export record Compilerˉsourceˉbindingˉphase {
    Buildˉstatus: Compilerˉsourceˉbindingˉstatus;
    Payload: bytes;
    Entries: u32;
    Parameters: u32;
    Locals: u32;
    Nextˉslot: u32;
    Buildˉfailureˉmodule: u32;
    Buildˉfailureˉrelatedˉmodule: u32;
    Buildˉfailureˉfunction: u32;
    Buildˉfailureˉoffset: u32;
    Buildˉfailureˉline: u32;
    Buildˉfailureˉcolumn: u32;
    Bodyˉstatus: Compilerˉsourceˉbindingˉstatus;
    Reads: u32;
    Assignments: u32;
    Calls: u32;
    Bodyˉfailureˉmodule: u32;
    Bodyˉfailureˉrelatedˉmodule: u32;
    Bodyˉfailureˉfunction: u32;
    Bodyˉfailureˉoffset: u32;
    Bodyˉfailureˉline: u32;
    Bodyˉfailureˉcolumn: u32;
}

export fn Compilerˉsourceˉbindingsˉphaseˉfrom(
    Build: Compilerˉsourceˉbindingˉbuild,
    Body: Compilerˉsourceˉbindingˉbody
) -> Compilerˉsourceˉbindingˉphase {
    return Compilerˉsourceˉbindingˉphase(
        Build.Status,
        Build.Payload,
        Build.Entries,
        Build.Parameters,
        Build.Locals,
        Build.Nextˉslot,
        Build.Failureˉmodule,
        Build.Failureˉrelatedˉmodule,
        Build.Failureˉfunction,
        Build.Failureˉoffset,
        Build.Failureˉline,
        Build.Failureˉcolumn,
        Body.Status,
        Body.Reads,
        Body.Assignments,
        Body.Calls,
        Body.Failureˉmodule,
        Body.Failureˉrelatedˉmodule,
        Body.Failureˉfunction,
        Body.Failureˉoffset,
        Body.Failureˉline,
        Body.Failureˉcolumn
    );
}

export fn Compilerˉsourceˉbindingsˉphaseˉbuildˉvalue(
    Phase: Compilerˉsourceˉbindingˉphase
) -> Compilerˉsourceˉbindingˉbuild {
    return Compilerˉsourceˉbindingˉbuild(
        Phase.Buildˉstatus,
        Phase.Payload,
        Phase.Entries,
        Phase.Parameters,
        Phase.Locals,
        Phase.Nextˉslot,
        Phase.Buildˉfailureˉmodule,
        Phase.Buildˉfailureˉrelatedˉmodule,
        Phase.Buildˉfailureˉfunction,
        Phase.Buildˉfailureˉoffset,
        Phase.Buildˉfailureˉline,
        Phase.Buildˉfailureˉcolumn
    );
}

export fn Compilerˉsourceˉbindingsˉphaseˉbodyˉvalue(
    Phase: Compilerˉsourceˉbindingˉphase
) -> Compilerˉsourceˉbindingˉbody {
    return Compilerˉsourceˉbindingˉbody(
        Phase.Bodyˉstatus,
        Phase.Reads,
        Phase.Assignments,
        Phase.Calls,
        Phase.Bodyˉfailureˉmodule,
        Phase.Bodyˉfailureˉrelatedˉmodule,
        Phase.Bodyˉfailureˉfunction,
        Phase.Bodyˉfailureˉoffset,
        Phase.Bodyˉfailureˉline,
        Phase.Bodyˉfailureˉcolumn
    );
}

export fn Compilerˉsourceˉbindingsˉempty(Input: bytes) -> bytes {
    return Bytesˉslice(Input, 0u32, 0u32);
}

export fn Compilerˉsourceˉbindingsˉkindˉvalue(
    Kind: Compilerˉsourceˉbindingˉkind
) -> u32 {
    if Kind == Compilerˉsourceˉbindingˉkind.Parameter { return 1u32; }
    if Kind == Compilerˉsourceˉbindingˉkind.Let { return 2u32; }
    if Kind == Compilerˉsourceˉbindingˉkind.Var { return 3u32; }
    return 0u32;
}

export fn Compilerˉsourceˉbindingsˉkind(Value: u32) -> Compilerˉsourceˉbindingˉkind {
    if Value == 1u32 { return Compilerˉsourceˉbindingˉkind.Parameter; }
    if Value == 2u32 { return Compilerˉsourceˉbindingˉkind.Let; }
    if Value == 3u32 { return Compilerˉsourceˉbindingˉkind.Var; }
    return Compilerˉsourceˉbindingˉkind.None;
}

export fn Compilerˉsourceˉbindingsˉshape(
    Binding: Sourceˉsymbols.Compilerˉsourceˉtypeˉbinding
) -> u32 {
    return Sourceˉsymbols.Compilerˉsourceˉsymbolsˉtypeˉshape(Binding);
}

export fn Compilerˉsourceˉbindingsˉsourceˉshape(
    Kind: Sourceˉdeclarations.Compilerˉsourceˉtypeˉkind
) -> u32 {
    return Sourceˉsymbols.Compilerˉsourceˉsymbolsˉprimitiveˉshape(Kind);
}

export fn Compilerˉsourceˉbindingsˉheader(Entries: u32, Ranges: u32) -> bytes {
    var Result: bytes = Textˉtoˉutf8("WVLB");
    Result = Bytesˉconcat(Result, Bytesˉfromˉu16ˉlittle(1u32));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu16ˉlittle(1u32));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Entries));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(36u32));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Ranges));
    return Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(8u32));
}

export fn Compilerˉsourceˉbindingsˉentry(
    Module: u32,
    Function: u32,
    Kind: Compilerˉsourceˉbindingˉkind,
    Slot: u32,
    Nameˉoffset: u32,
    Nameˉlength: u32,
    Shape: u32,
    Scopeˉstart: u32,
    Scopeˉend: u32
) -> bytes {
    var Result: bytes = Bytesˉfromˉu32ˉlittle(Module);
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Function));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Compilerˉsourceˉbindingsˉkindˉvalue(Kind)));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Slot));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Nameˉoffset));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Nameˉlength));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Shape));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Scopeˉstart));
    return Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Scopeˉend));
}

export fn Compilerˉsourceˉbindingsˉbuildˉempty(Input: bytes) -> Compilerˉsourceˉbindingˉbuild {
    return Compilerˉsourceˉbindingˉbuild(
        Compilerˉsourceˉbindingˉstatus.Valid,
        Compilerˉsourceˉbindingsˉempty(Input),
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32
    );
}

export fn Compilerˉsourceˉbindingsˉbuildˉfailure(
    Build: Compilerˉsourceˉbindingˉbuild,
    Status: Compilerˉsourceˉbindingˉstatus,
    Module: u32,
    Relatedˉmodule: u32,
    Function: u32,
    Offset: u32,
    Line: u32,
    Column: u32
) -> Compilerˉsourceˉbindingˉbuild {
    return Compilerˉsourceˉbindingˉbuild(
        Status,
        Build.Payload,
        Build.Entries,
        Build.Parameters,
        Build.Locals,
        Build.Nextˉslot,
        Module,
        Relatedˉmodule,
        Function,
        Offset,
        Line,
        Column
    );
}

export fn Compilerˉsourceˉbindingsˉbuildˉresetˉslots(
    Build: Compilerˉsourceˉbindingˉbuild
) -> Compilerˉsourceˉbindingˉbuild {
    return Compilerˉsourceˉbindingˉbuild(
        Build.Status,
        Build.Payload,
        Build.Entries,
        Build.Parameters,
        Build.Locals,
        0u32,
        Build.Failureˉmodule,
        Build.Failureˉrelatedˉmodule,
        Build.Failureˉfunction,
        Build.Failureˉoffset,
        Build.Failureˉline,
        Build.Failureˉcolumn
    );
}

export fn Compilerˉsourceˉbindingsˉappend(
    Build: Compilerˉsourceˉbindingˉbuild,
    Entry: bytes,
    Isˉparameter: bool
) -> Compilerˉsourceˉbindingˉbuild {
    var Parameters: u32 = Build.Parameters;
    var Locals: u32 = Build.Locals;
    if Isˉparameter {
        Parameters = Parameters + 1u32;
    } else {
        Locals = Locals + 1u32;
    }
    return Compilerˉsourceˉbindingˉbuild(
        Build.Status,
        Bytesˉconcat(Build.Payload, Entry),
        Build.Entries + 1u32,
        Parameters,
        Locals,
        Build.Nextˉslot + 1u32,
        Build.Failureˉmodule,
        Build.Failureˉrelatedˉmodule,
        Build.Failureˉfunction,
        Build.Failureˉoffset,
        Build.Failureˉline,
        Build.Failureˉcolumn
    );
}

export fn Compilerˉsourceˉbindingsˉpriorˉlocal(
    Source: bytes,
    Payload: bytes,
    Bindingˉfirst: u32,
    Bindingˉentries: u32,
    Module: u32,
    Function: u32,
    Nameˉoffset: u32,
    Nameˉlength: u32
) -> bool {
    var Index: u32 = Bindingˉfirst;
    while Index < Bindingˉentries {
        let Entry: u32 = Index * 36u32;
        if Bytesˉreadˉu32ˉlittle(Payload, Entry) == Module {
            if Bytesˉreadˉu32ˉlittle(Payload, Entry + 4u32) == Function {
                let Priorˉoffset: u32 = Bytesˉreadˉu32ˉlittle(Payload, Entry + 16u32);
                let Priorˉlength: u32 = Bytesˉreadˉu32ˉlittle(Payload, Entry + 20u32);
                if Sourceˉset.Compilerˉsourceˉspansˉequal(
                    Source,
                    Nameˉoffset,
                    Nameˉlength,
                    Source,
                    Priorˉoffset,
                    Priorˉlength
                ) { return true; }
            }
        }
        Index = Index + 1u32;
    }
    return false;
}

export fn Compilerˉsourceˉbindingsˉfunctionˉentry(
    Directory: bytes,
    Module: u32,
    Declarationˉoffset: u32
) -> u32 {
    let Entries: u32 = Bytesˉreadˉu32ˉlittle(Directory, 8u32);
    var Index: u32 = 0u32;
    while Index < Entries {
        let Entry: u32 = 16u32 + Index * 24u32;
        if Bytesˉreadˉu32ˉlittle(Directory, Entry) == Module {
            if Bytesˉreadˉu32ˉlittle(Directory, Entry + 4u32) == 6u32 {
                if Bytesˉreadˉu32ˉlittle(Directory, Entry + 8u32) == Declarationˉoffset {
                    return Index;
                }
            }
        }
        Index = Index + 1u32;
    }
    return Entries;
}

export fn Compilerˉsourceˉbindingsˉtypeˉstatus(
    Status: Sourceˉsymbols.Compilerˉsourceˉsymbolˉstatus
) -> Compilerˉsourceˉbindingˉstatus {
    if Status == Sourceˉsymbols.Compilerˉsourceˉsymbolˉstatus.Inaccessibleˉtype {
        return Compilerˉsourceˉbindingˉstatus.Inaccessibleˉtype;
    }
    return Compilerˉsourceˉbindingˉstatus.Unknownˉtype;
}

export fn Compilerˉsourceˉbindingsˉcollectˉlocal(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Module: u32,
    Function: u32,
    Source: bytes,
    Statement: Sourceˉbodies.Compilerˉsourceˉstatement,
    Scopeˉend: u32,
    Inferredˉshape: u32,
    Build: Compilerˉsourceˉbindingˉbuild
) -> Compilerˉsourceˉbindingˉbuild {
    var Shape: u32 = Inferredˉshape;
    if Statement.Typeˉkind != Sourceˉdeclarations.Compilerˉsourceˉtypeˉkind.Unknown {
        Shape = Compilerˉsourceˉbindingsˉsourceˉshape(Statement.Typeˉkind);
    }
    if Statement.Typeˉkind == Sourceˉdeclarations.Compilerˉsourceˉtypeˉkind.Named || Statement.Typeˉkind == Sourceˉdeclarations.Compilerˉsourceˉtypeˉkind.Sequence || Statement.Typeˉkind == Sourceˉdeclarations.Compilerˉsourceˉtypeˉkind.Builder {
        let Position: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
            Source,
            Statement.Offset,
            Statement.Line,
            Statement.Column,
            Statement.Typeˉoffset
        );
        let Type: Sourceˉsymbols.Compilerˉsourceˉtypeˉbinding = Sourceˉsymbols.Compilerˉsourceˉsymbolsˉbindˉtype(
            Input,
            Scan,
            Symbols.Directory,
            Symbols.Lookup,
            Symbols.Visibility,
            Module,
            Source,
            Statement.Typeˉoffset,
            Position.Line,
            Position.Column,
            Symbols.Records,
            Symbols.Enums,
            false
        );
        if Type.Status != Sourceˉsymbols.Compilerˉsourceˉsymbolˉstatus.Valid {
            return Compilerˉsourceˉbindingsˉbuildˉfailure(
                Build,
                Compilerˉsourceˉbindingsˉtypeˉstatus(Type.Status),
                Module,
                Type.Nominalˉmodule,
                Function,
                Type.Failureˉoffset,
                Type.Failureˉline,
                Type.Failureˉcolumn
            );
        }
        Shape = Compilerˉsourceˉbindingsˉshape(Type);
    }
    if Compilerˉsourceˉbindingsˉpriorˉlocal(
        Source,
        Build.Payload,
        Build.Entries - Build.Nextˉslot,
        Build.Entries,
        Module,
        Function,
        Statement.Nameˉoffset,
        Statement.Nameˉlength
    ) {
        let Duplicateˉnameˉposition: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
            Source,
            Statement.Offset,
            Statement.Line,
            Statement.Column,
            Statement.Nameˉoffset
        );
        return Compilerˉsourceˉbindingsˉbuildˉfailure(
            Build,
            Compilerˉsourceˉbindingˉstatus.Duplicateˉlocal,
            Module,
            Module,
            Function,
            Statement.Nameˉoffset,
            Duplicateˉnameˉposition.Line,
            Duplicateˉnameˉposition.Column
        );
    }
    if Build.Nextˉslot >= 4096u32 {
        return Compilerˉsourceˉbindingsˉbuildˉfailure(
            Build,
            Compilerˉsourceˉbindingˉstatus.Bindingˉlimit,
            Module,
            Module,
            Function,
            Statement.Nameˉoffset,
            Statement.Line,
            Statement.Column
        );
    }
    if Bytesˉlength(Build.Payload) > 4194252u32 {
        return Compilerˉsourceˉbindingsˉbuildˉfailure(
            Build,
            Compilerˉsourceˉbindingˉstatus.Evidenceˉlimit,
            Module,
            Module,
            Function,
            Statement.Nameˉoffset,
            Statement.Line,
            Statement.Column
        );
    }
    var Kind: Compilerˉsourceˉbindingˉkind = Compilerˉsourceˉbindingˉkind.Let;
    if Statement.Isˉmutable { Kind = Compilerˉsourceˉbindingˉkind.Var; }
    let Entry: bytes = Compilerˉsourceˉbindingsˉentry(
        Module,
        Function,
        Kind,
        Build.Nextˉslot,
        Statement.Nameˉoffset,
        Statement.Nameˉlength,
        Shape,
        Statement.Nextˉoffset,
        Scopeˉend
    );
    return Compilerˉsourceˉbindingsˉappend(Build, Entry, false);
}

export fn Compilerˉsourceˉbindingsˉranges(
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Build: Compilerˉsourceˉbindingˉbuild
) -> bytes {
    let Symbolˉentries: u32 = Bytesˉreadˉu32ˉlittle(Symbols.Directory, 8u32);
    var Result: bytes = Compilerˉsourceˉbindingsˉempty(Symbols.Directory);
    var Binding: u32 = 0u32;
    var Index: u32 = 0u32;
    while Index < Symbolˉentries {
        let First: u32 = Binding;
        var Count: u32 = 0u32;
        let Symbolˉentry: u32 = 16u32 + Index * 24u32;
        if Bytesˉreadˉu32ˉlittle(Symbols.Directory, Symbolˉentry + 4u32) == 6u32 {
            var Reading: bool = true;
            while Reading {
                if Binding >= Build.Entries {
                    Reading = false;
                } else {
                    let Entry: u32 = Binding * 36u32;
                    if Bytesˉreadˉu32ˉlittle(Build.Payload, Entry + 4u32) != Index {
                        Reading = false;
                    } else {
                        Binding = Binding + 1u32;
                        Count = Count + 1u32;
                    }
                }
            }
        }
        Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(First));
        Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Count));
        Index = Index + 1u32;
    }
    return Result;
}

export fn Compilerˉsourceˉbindingsˉdirectory(
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Build: Compilerˉsourceˉbindingˉbuild
) -> bytes {
    let Symbolˉentries: u32 = Bytesˉreadˉu32ˉlittle(Symbols.Directory, 8u32);
    let Header: bytes = Compilerˉsourceˉbindingsˉheader(Build.Entries, Symbolˉentries);
    let Ranges: bytes = Compilerˉsourceˉbindingsˉranges(Symbols, Build);
    return Bytesˉconcat(Bytesˉconcat(Header, Ranges), Build.Payload);
}

export fn Compilerˉsourceˉbindingsˉidentifierˉisˉvalid(
    Input: bytes,
    Offset: u32,
    Length: u32
) -> bool {
    let Total: u32 = Bytesˉlength(Input);
    if Length == 0u32 { return false; }
    if Offset >= Total { return false; }
    if Length > Total - Offset { return false; }
    if !Sourceˉlexer.Compilerˉsourceˉidentifierˉstart(Bytesˉreadˉu8(Input, Offset)) { return false; }
    var Cursor: u32 = 1u32;
    while Cursor < Length {
        let Part: u32 = Sourceˉlexer.Compilerˉsourceˉidentifierˉpartˉlength(Input, Offset + Cursor);
        if Part == 0u32 { return false; }
        if Part > Length - Cursor { return false; }
        Cursor = Cursor + Part;
    }
    if Sourceˉlexer.Compilerˉsourceˉkeywordˉkind(Input, Offset, Length) != Sourceˉlexer.Compilerˉtokenˉkind.Identifier {
        return false;
    }
    if Offset + Length < Total {
        if Sourceˉlexer.Compilerˉsourceˉidentifierˉpartˉlength(Input, Offset + Length) > 0u32 {
            return false;
        }
    }
    return true;
}

export fn Compilerˉsourceˉbindingsˉdirectoryˉisˉvalid(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Directory: bytes
) -> bool {
    let Length: u32 = Bytesˉlength(Directory);
    if Length < 24u32 { return false; }
    let Magic: bytes = Textˉtoˉutf8("WVLB");
    if !Sourceˉset.Compilerˉsourceˉspansˉequal(Directory, 0u32, 4u32, Magic, 0u32, 4u32) {
        return false;
    }
    if Bytesˉreadˉu16ˉlittle(Directory, 4u32) != 1u32 { return false; }
    if Bytesˉreadˉu16ˉlittle(Directory, 6u32) != 1u32 { return false; }
    if Bytesˉreadˉu32ˉlittle(Directory, 12u32) != 36u32 { return false; }
    let Entries: u32 = Bytesˉreadˉu32ˉlittle(Directory, 8u32);
    if Entries > 116508u32 { return false; }
    let Symbolˉentries: u32 = Bytesˉreadˉu32ˉlittle(Symbols.Directory, 8u32);
    let Ranges: u32 = Bytesˉreadˉu32ˉlittle(Directory, 16u32);
    if Ranges != Symbolˉentries { return false; }
    if Bytesˉreadˉu32ˉlittle(Directory, 20u32) != 8u32 { return false; }
    if Length != 24u32 + Ranges * 8u32 + Entries * 36u32 { return false; }
    var Rangeˉindex: u32 = 0u32;
    var Expectedˉfirst: u32 = 0u32;
    while Rangeˉindex < Ranges {
        let Range: u32 = 24u32 + Rangeˉindex * 8u32;
        let First: u32 = Bytesˉreadˉu32ˉlittle(Directory, Range);
        let Count: u32 = Bytesˉreadˉu32ˉlittle(Directory, Range + 4u32);
        if First != Expectedˉfirst { return false; }
        if Count > Entries - First { return false; }
        let Rangeˉsymbolˉentry: u32 = 16u32 + Rangeˉindex * 24u32;
        if Bytesˉreadˉu32ˉlittle(Symbols.Directory, Rangeˉsymbolˉentry + 4u32) != 6u32 {
            if Count != 0u32 { return false; }
        }
        Expectedˉfirst = First + Count;
        Rangeˉindex = Rangeˉindex + 1u32;
    }
    if Expectedˉfirst != Entries { return false; }
    let Entriesˉoffset: u32 = 24u32 + Ranges * 8u32;
    var Index: u32 = 0u32;
    var Priorˉmodule: u32 = 0u32;
    var Priorˉfunction: u32 = 0u32;
    var Priorˉslot: u32 = 0u32;
    while Index < Entries {
        let Entry: u32 = Entriesˉoffset + Index * 36u32;
        let Module: u32 = Bytesˉreadˉu32ˉlittle(Directory, Entry);
        let Function: u32 = Bytesˉreadˉu32ˉlittle(Directory, Entry + 4u32);
        let Kind: u32 = Bytesˉreadˉu32ˉlittle(Directory, Entry + 8u32);
        let Slot: u32 = Bytesˉreadˉu32ˉlittle(Directory, Entry + 12u32);
        let Nameˉoffset: u32 = Bytesˉreadˉu32ˉlittle(Directory, Entry + 16u32);
        let Nameˉlength: u32 = Bytesˉreadˉu32ˉlittle(Directory, Entry + 20u32);
        let Shape: u32 = Bytesˉreadˉu32ˉlittle(Directory, Entry + 24u32);
        let Scopeˉstart: u32 = Bytesˉreadˉu32ˉlittle(Directory, Entry + 28u32);
        let Scopeˉend: u32 = Bytesˉreadˉu32ˉlittle(Directory, Entry + 32u32);
        if Module >= Scan.Modules { return false; }
        if Function >= Symbolˉentries { return false; }
        if Kind == 0u32 { return false; }
        if Kind > 3u32 { return false; }
        if Slot >= 4096u32 { return false; }
        var Shapeˉvalid: bool = Shape <= 8u32;
        if Shape == 9u32 { Shapeˉvalid = true; }
        if Shape >= 11u32 {
            if Shape <= 15u32 { Shapeˉvalid = true; }
        }
        if Shape == 16u32 { Shapeˉvalid = true; }
        if Shape == 0u32 { Shapeˉvalid = Kind != 1u32; }
        if Shape > 8u32 {
            if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉshapeˉisˉcapability(
                Symbols.Directory, Shape
            ) { Shapeˉvalid = true; }
            if Shape >= 65536u32 {
                if Shape < 65536u32 + Symbols.Records { Shapeˉvalid = true; }
            }
            if Shape >= 131072u32 + Symbols.Records {
                if Shape < 131072u32 + Symbols.Records + Symbols.Enums {
                    Shapeˉvalid = true;
                }
            }
            if Shape >= 196608u32 + Symbols.Records + Symbols.Enums {
                if Shape < 196608u32 + Symbols.Records + Symbols.Enums + Symbols.Variants {
                    Shapeˉvalid = true;
                }
            }
            if Shape >= 1073741824u32 {
                if Shape < 1610612736u32 { Shapeˉvalid = true; }
            }
            if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉshapeˉisˉfoundationˉgeneric(
                Shape
            ) { Shapeˉvalid = true; }
        }
        if !Shapeˉvalid { return false; }
        let Symbolˉentry: u32 = 16u32 + Function * 24u32;
        if Bytesˉreadˉu32ˉlittle(Symbols.Directory, Symbolˉentry) != Module { return false; }
        if Bytesˉreadˉu32ˉlittle(Symbols.Directory, Symbolˉentry + 4u32) != 6u32 { return false; }
        let Functionˉrange: u32 = 24u32 + Function * 8u32;
        let Functionˉfirst: u32 = Bytesˉreadˉu32ˉlittle(Directory, Functionˉrange);
        let Functionˉcount: u32 = Bytesˉreadˉu32ˉlittle(Directory, Functionˉrange + 4u32);
        if Index < Functionˉfirst { return false; }
        if Index >= Functionˉfirst + Functionˉcount { return false; }
        let Parameters: u32 = Bytesˉreadˉu32ˉlittle(Symbols.Directory, Symbolˉentry + 20u32);
        if Slot < Parameters {
            if Kind != 1u32 { return false; }
        } else {
            if Kind == 1u32 { return false; }
        }
        let Sourceˉview: Sourceˉset.Compilerˉsourceˉsetˉview =
            Sourceˉset.Compilerˉsourceˉsetˉmodule(Input, Scan, Module);
        let Sourceˉlength: u32 = Bytesˉlength(Sourceˉview.Source);
        if Nameˉoffset >= Sourceˉlength { return false; }
        if Nameˉlength == 0u32 { return false; }
        if Nameˉlength > Sourceˉlength - Nameˉoffset { return false; }
        if Scopeˉstart >= Scopeˉend { return false; }
        if Scopeˉend > Sourceˉlength { return false; }
        if !Compilerˉsourceˉbindingsˉidentifierˉisˉvalid(
            Sourceˉview.Source, Nameˉoffset, Nameˉlength
        ) { return false; }
        if Index == 0u32 {
            if Slot != 0u32 { return false; }
        } else {
            if Module < Priorˉmodule { return false; }
            if Function < Priorˉfunction { return false; }
            if Function == Priorˉfunction {
                if Slot != Priorˉslot + 1u32 { return false; }
            } else {
                if Slot != 0u32 { return false; }
            }
        }
        Priorˉmodule = Module;
        Priorˉfunction = Function;
        Priorˉslot = Slot;
        Index = Index + 1u32;
    }
    return true;
}

export fn Compilerˉsourceˉbindingsˉfindˉlocal(
    Source: bytes,
    Payload: bytes,
    First: u32,
    Entries: u32,
    Nameˉoffset: u32,
    Nameˉlength: u32,
    Useˉoffset: u32
) -> Compilerˉsourceˉlocalˉmatch {
    var Index: u32 = First;
    while Index < Entries {
        let Entry: u32 = Index * 36u32;
        let Priorˉoffset: u32 = Bytesˉreadˉu32ˉlittle(Payload, Entry + 16u32);
        let Priorˉlength: u32 = Bytesˉreadˉu32ˉlittle(Payload, Entry + 20u32);
        if Priorˉlength == Nameˉlength {
            if Sourceˉset.Compilerˉsourceˉspansˉequal(
                Source, Nameˉoffset, Nameˉlength,
                Source, Priorˉoffset, Priorˉlength
            ) {
                let Scopeˉstart: u32 = Bytesˉreadˉu32ˉlittle(Payload, Entry + 28u32);
                let Scopeˉend: u32 = Bytesˉreadˉu32ˉlittle(Payload, Entry + 32u32);
                if Useˉoffset >= Scopeˉstart {
                    if Useˉoffset < Scopeˉend {
                        return Compilerˉsourceˉlocalˉmatch(
                            true,
                            Compilerˉsourceˉbindingsˉkind(Bytesˉreadˉu32ˉlittle(Payload, Entry + 8u32)),
                            Bytesˉreadˉu32ˉlittle(Payload, Entry + 12u32),
                            Bytesˉreadˉu32ˉlittle(Payload, Entry + 24u32)
                        );
                    }
                }
            }
        }
        Index = Index + 1u32;
    }
    return Compilerˉsourceˉlocalˉmatch(
        false, Compilerˉsourceˉbindingˉkind.None, 0u32, 0u32
    );
}

export fn Compilerˉsourceˉbindingsˉquery(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Lookup: bytes,
    Owner: u32,
    Source: bytes,
    Nameˉoffset: u32,
    Nameˉlength: u32
) -> Compilerˉsourceˉbindingˉquery {
    var Dot: u32 = Nameˉlength;
    var Character: u32 = 0u32;
    while Character < Nameˉlength {
        if Dot == Nameˉlength {
            if Bytesˉreadˉu8(Source, Nameˉoffset + Character) == 46u8 {
                Dot = Character;
            }
        }
        Character = Character + 1u32;
    }
    var Aliasˉfound: bool = false;
    var Target: u32 = Owner;
    if Dot < Nameˉlength {
        let Importˉtarget: Sourceˉgraph.Compilerˉsourceˉgraphˉmatch =
            Sourceˉsymbols.Compilerˉsourceˉsymbolsˉlookupˉaliasˉtarget(
                Input, Scan, Lookup, Owner, Source, Nameˉoffset, Dot
            );
        Aliasˉfound = Importˉtarget.Found;
        Target = Importˉtarget.Index;
        return Compilerˉsourceˉbindingˉquery(
            true, Aliasˉfound, Target,
            Nameˉoffset + Dot + 1u32, Nameˉlength - Dot - 1u32
        );
    }
    return Compilerˉsourceˉbindingˉquery(
        false, true, Owner, Nameˉoffset, Nameˉlength
    );
}

export fn Compilerˉsourceˉbindingsˉdeclarationˉisˉexported(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Directoryˉindex: u32
) -> bool {
    return Sourceˉsymbols.Compilerˉsourceˉsymbolsˉlookupˉisˉexported(
        Symbols.Lookup, Directoryˉindex
    );
}

export fn Compilerˉsourceˉbindingsˉfindˉdeclaration(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Owner: u32,
    Source: bytes,
    Nameˉoffset: u32,
    Nameˉlength: u32,
    Kind: Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind
) -> Compilerˉsourceˉbindingˉmatch {
    let Entries: u32 = Bytesˉreadˉu32ˉlittle(Symbols.Directory, 8u32);
    let Query: Compilerˉsourceˉbindingˉquery = Compilerˉsourceˉbindingsˉquery(
        Input, Scan, Symbols.Lookup, Owner, Source, Nameˉoffset, Nameˉlength
    );
    if Query.Qualified {
        if !Query.Aliasˉfound {
            return Compilerˉsourceˉbindingˉmatch(
                false, false, Compilerˉsourceˉcallableˉkind.None,
                Symbols.Modules, 0u32, Entries
            );
        }
    }
    let Queryˉfirst: u8 = Bytesˉreadˉu8(Source, Query.Nameˉoffset);
    let Range: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉsymbols.Compilerˉsourceˉsymbolsˉlookupˉrange(
        Symbols.Lookup, Queryˉfirst
    );
    var Index: u32 = 0u32;
    while Index < Range.Line {
        let Directoryˉindex: u32 = Bytesˉreadˉu32ˉlittle(
            Symbols.Lookup, 4112u32 + (Range.Offset + Index) * 4u32
        );
        let Entry: u32 = 16u32 + Directoryˉindex * 24u32;
        let Target: u32 = Bytesˉreadˉu32ˉlittle(Symbols.Directory, Entry);
        let Entryˉkind: Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind = Sourceˉsymbols.Compilerˉsourceˉsymbolsˉdeclarationˉkind(
            Bytesˉreadˉu32ˉlittle(Symbols.Directory, Entry + 4u32)
        );
        var Candidate: bool = Entryˉkind == Kind;
        if Target != Query.Target { Candidate = false; }
        if Candidate {
            let Targetˉview: Sourceˉset.Compilerˉsourceˉsetˉview =
                Sourceˉset.Compilerˉsourceˉsetˉmodule(
                    Input, Scan, Target
                );
            let Targetˉoffset: u32 = Bytesˉreadˉu32ˉlittle(Symbols.Directory, Entry + 12u32);
            let Targetˉlength: u32 = Bytesˉreadˉu32ˉlittle(Symbols.Directory, Entry + 16u32);
            if Targetˉlength == Query.Nameˉlength {
                if Sourceˉset.Compilerˉsourceˉspansˉequal(
                    Source, Query.Nameˉoffset, Query.Nameˉlength,
                    Targetˉview.Source, Targetˉoffset, Targetˉlength
                ) {
                    var Accessible: bool = Target == Owner;
                    if Query.Qualified {
                        if Query.Aliasˉfound {
                            Accessible = Compilerˉsourceˉbindingsˉdeclarationˉisˉexported(
                                Input, Scan, Symbols, Directoryˉindex
                            );
                        }
                    }
                    return Compilerˉsourceˉbindingˉmatch(
                        true,
                        Accessible,
                        Compilerˉsourceˉcallableˉkind.None,
                        Target,
                        Bytesˉreadˉu32ˉlittle(Symbols.Directory, Entry + 20u32),
                        Directoryˉindex
                    );
                }
            }
        }
        Index = Index + 1u32;
    }
    return Compilerˉsourceˉbindingˉmatch(
        false,
        false,
        Compilerˉsourceˉcallableˉkind.None,
        Symbols.Modules,
        0u32,
        Entries
    );
}

export fn Compilerˉsourceˉbindingsˉintrinsicˉarity(
    Source: bytes,
    Offset: u32,
    Length: u32
) -> Compilerˉsourceˉbindingˉmatch {
    // Length dispatch avoids materializing UTF-8 candidates outside the matching name group.
    if Length == 24u32 {
        if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "Bytesˉreadˉu32ˉlittle") { return Compilerˉsourceˉbindingˉmatch(true, true, Compilerˉsourceˉcallableˉkind.Intrinsic, 0u32, 2u32, 0u32); }
        if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "Bytesˉfromˉu32ˉlittle") { return Compilerˉsourceˉbindingˉmatch(true, true, Compilerˉsourceˉcallableˉkind.Intrinsic, 0u32, 1u32, 0u32); }
        if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "Bytesˉreadˉu16ˉlittle") { return Compilerˉsourceˉbindingˉmatch(true, true, Compilerˉsourceˉcallableˉkind.Intrinsic, 0u32, 2u32, 0u32); }
        if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "Bytesˉfromˉu16ˉlittle") { return Compilerˉsourceˉbindingˉmatch(true, true, Compilerˉsourceˉcallableˉkind.Intrinsic, 0u32, 1u32, 0u32); }
        if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "Bytesˉreadˉi32ˉlittle") { return Compilerˉsourceˉbindingˉmatch(true, true, Compilerˉsourceˉcallableˉkind.Intrinsic, 0u32, 2u32, 0u32); }
        if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "Bytesˉfromˉi32ˉlittle") { return Compilerˉsourceˉbindingˉmatch(true, true, Compilerˉsourceˉcallableˉkind.Intrinsic, 0u32, 1u32, 0u32); }
        if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "Bytesˉreadˉu64ˉlittle") { return Compilerˉsourceˉbindingˉmatch(true, true, Compilerˉsourceˉcallableˉkind.Intrinsic, 0u32, 2u32, 0u32); }
        if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "Bytesˉfromˉu64ˉlittle") { return Compilerˉsourceˉbindingˉmatch(true, true, Compilerˉsourceˉcallableˉkind.Intrinsic, 0u32, 1u32, 0u32); }
    }
    if Length == 13u32 {
        if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "Bytesˉconcat") { return Compilerˉsourceˉbindingˉmatch(true, true, Compilerˉsourceˉcallableˉkind.Intrinsic, 0u32, 2u32, 0u32); }
        if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "Bytesˉlength") { return Compilerˉsourceˉbindingˉmatch(true, true, Compilerˉsourceˉcallableˉkind.Intrinsic, 0u32, 1u32, 0u32); }
        if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "U32ˉfromˉu8") { return Compilerˉsourceˉbindingˉmatch(true, true, Compilerˉsourceˉcallableˉkind.Intrinsic, 0u32, 1u32, 0u32); }
    }
    if Length == 14u32 {
        if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "U64ˉfromˉu32") { return Compilerˉsourceˉbindingˉmatch(true, true, Compilerˉsourceˉcallableˉkind.Intrinsic, 0u32, 1u32, 0u32); }
    }
    if Length == 15u32 {
        if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "Bytesˉreadˉu8") { return Compilerˉsourceˉbindingˉmatch(true, true, Compilerˉsourceˉcallableˉkind.Intrinsic, 0u32, 2u32, 0u32); }
        if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "Bytesˉfromˉu8") { return Compilerˉsourceˉbindingˉmatch(true, true, Compilerˉsourceˉcallableˉkind.Intrinsic, 0u32, 1u32, 0u32); }
    }
    if Length == 12u32 {
        if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "Bytesˉslice") { return Compilerˉsourceˉbindingˉmatch(true, true, Compilerˉsourceˉcallableˉkind.Intrinsic, 0u32, 3u32, 0u32); }
        if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "Textˉconcat") { return Compilerˉsourceˉbindingˉmatch(true, true, Compilerˉsourceˉcallableˉkind.Intrinsic, 0u32, 2u32, 0u32); }
    }
    if Length == 10u32 {
        if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "U8ˉformat") { return Compilerˉsourceˉbindingˉmatch(true, true, Compilerˉsourceˉcallableˉkind.Intrinsic, 0u32, 1u32, 0u32); }
        if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "Enumˉname") { return Compilerˉsourceˉbindingˉmatch(true, true, Compilerˉsourceˉcallableˉkind.Intrinsic, 0u32, 1u32, 0u32); }
    }
    if Length == 11u32 {
        if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "I32ˉformat") { return Compilerˉsourceˉbindingˉmatch(true, true, Compilerˉsourceˉcallableˉkind.Intrinsic, 0u32, 1u32, 0u32); }
        if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "U32ˉformat") { return Compilerˉsourceˉbindingˉmatch(true, true, Compilerˉsourceˉcallableˉkind.Intrinsic, 0u32, 1u32, 0u32); }
        if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "I64ˉformat") { return Compilerˉsourceˉbindingˉmatch(true, true, Compilerˉsourceˉcallableˉkind.Intrinsic, 0u32, 1u32, 0u32); }
        if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "U64ˉformat") { return Compilerˉsourceˉbindingˉmatch(true, true, Compilerˉsourceˉcallableˉkind.Intrinsic, 0u32, 1u32, 0u32); }
        if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "Textˉquote") { return Compilerˉsourceˉbindingˉmatch(true, true, Compilerˉsourceˉcallableˉkind.Intrinsic, 0u32, 1u32, 0u32); }
    }
    if Length == 14u32 { if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "Textˉtoˉutf8") { return Compilerˉsourceˉbindingˉmatch(true, true, Compilerˉsourceˉcallableˉkind.Intrinsic, 0u32, 1u32, 0u32); } }
    if Length == 6u32 { if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "length") { return Compilerˉsourceˉbindingˉmatch(true, true, Compilerˉsourceˉcallableˉkind.Intrinsic, 0u32, 1u32, 0u32); } }
    if Length == 16u32 { if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "Textˉfromˉutf8") { return Compilerˉsourceˉbindingˉmatch(true, true, Compilerˉsourceˉcallableˉkind.Intrinsic, 0u32, 1u32, 0u32); } }
    if Length == 18u32 { if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "Bytesˉsha256ˉhex") { return Compilerˉsourceˉbindingˉmatch(true, true, Compilerˉsourceˉcallableˉkind.Intrinsic, 0u32, 1u32, 0u32); } }
    if Length == 21u32 { if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "Textˉutf8ˉisˉvalid") { return Compilerˉsourceˉbindingˉmatch(true, true, Compilerˉsourceˉcallableˉkind.Intrinsic, 0u32, 1u32, 0u32); } }
    return Compilerˉsourceˉbindingˉmatch(
        false,
        false,
        Compilerˉsourceˉcallableˉkind.Intrinsic,
        0u32,
        1u32,
        0u32
    );
}

export fn Compilerˉsourceˉbindingsˉcapabilityˉarity(
    Source: bytes,
    Offset: u32,
    Length: u32
) -> u32 {
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "file.write_bytes") {
        return 2u32;
    }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "filesystem.directory_read_v1") {
        return 3u32;
    }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "process.argument_count") {
        return 0u32;
    }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "storage.random_access_v1") {
        return 5u32;
    }
    return 1u32;
}

export fn Compilerˉsourceˉbindingsˉfindˉvariantˉcase(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Owner: u32,
    Source: bytes,
    Offset: u32,
    Length: u32
) -> Compilerˉsourceˉbindingˉmatch {
    let Entries: u32 = Bytesˉreadˉu32ˉlittle(Symbols.Directory, 8u32);
    var Lastˉdot: u32 = Length;
    var Character: u32 = 0u32;
    while Character < Length {
        if Bytesˉreadˉu8(Source, Offset + Character) == 46u8 { Lastˉdot = Character; }
        Character = Character + 1u32;
    }
    if Lastˉdot >= Length {
        return Compilerˉsourceˉbindingˉmatch(false, false, Compilerˉsourceˉcallableˉkind.Variantˉcase, Symbols.Modules, 0u32, Entries);
    }
    let Nominal: Sourceˉsymbols.Compilerˉsourceˉsymbolˉmatch = Sourceˉsymbols.Compilerˉsourceˉsymbolsˉfindˉownedˉnominal(
        Input, Scan, Symbols.Directory, Symbols.Lookup, Owner,
        Source, Offset, Lastˉdot
    );
    if !Nominal.Found {
        return Compilerˉsourceˉbindingˉmatch(false, false, Compilerˉsourceˉcallableˉkind.Variantˉcase, Symbols.Modules, 0u32, Entries);
    }
    if Nominal.Kind != Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Variant {
        return Compilerˉsourceˉbindingˉmatch(false, false, Compilerˉsourceˉcallableˉkind.Variantˉcase, Nominal.Module, 0u32, Entries);
    }
    let Accessible: bool = Sourceˉsymbols.Compilerˉsourceˉsymbolsˉownedˉmatchˉisˉaccessible(
        Input, Scan, Symbols.Visibility, Symbols.Lookup, Owner, Source,
        Offset, Lastˉdot, Nominal
    );
    let View: Sourceˉset.Compilerˉsourceˉsetˉview = Sourceˉset.Compilerˉsourceˉsetˉmodule(
        Input, Scan, Nominal.Module
    );
    let Position: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
        View.Source, 0u32, 1u32, 1u32, Nominal.Declarationˉoffset
    );
    let Declaration: Sourceˉdeclarations.Compilerˉsourceˉdeclaration = Sourceˉdeclarations.Compilerˉparseˉnextˉdeclarationˉvalidated(
        View.Source, Nominal.Declarationˉoffset, Position.Line, Position.Column, true
    );
    let Bodyˉposition: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
        View.Source, Declaration.Declarationˉoffset, Position.Line, Position.Column, Declaration.Bodyˉoffset
    );
    let Left: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
        View.Source, Declaration.Bodyˉoffset, Bodyˉposition.Line, Bodyˉposition.Column
    );
    var Cursor: u32 = Left.Nextˉoffset;
    var Line: u32 = Left.Nextˉline;
    var Column: u32 = Left.Nextˉcolumn;
    var Caseˉindex: u32 = 0u32;
    while Caseˉindex < Declaration.Items {
        let Case: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            View.Source, Cursor, Line, Column
        );
        let Afterˉname: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            View.Source, Case.Nextˉoffset, Case.Nextˉline, Case.Nextˉcolumn
        );
        var Arity: u32 = 0u32;
        var End: Sourceˉlexer.Compilerˉsourceˉtoken = Afterˉname;
        if Afterˉname.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Leftˉparenthesis {
            var Fieldˉcursor: u32 = Afterˉname.Nextˉoffset;
            var Fieldˉline: u32 = Afterˉname.Nextˉline;
            var Fieldˉcolumn: u32 = Afterˉname.Nextˉcolumn;
            var Readingˉfields: bool = true;
            while Readingˉfields {
                let Field: Sourceˉdeclarations.Compilerˉsourceˉvariantˉfield =
                    Sourceˉdeclarations.Compilerˉparseˉvariantˉfield(
                        View.Source, Fieldˉcursor, Fieldˉline, Fieldˉcolumn
                    );
                Arity = Arity + 1u32;
                let Separator: Sourceˉlexer.Compilerˉsourceˉtoken =
                    Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                        View.Source, Field.Nextˉoffset, Field.Nextˉline,
                        Field.Nextˉcolumn
                    );
                if Separator.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Comma {
                    let Callableˉafterˉcomma:
                        Sourceˉlexer.Compilerˉsourceˉtoken =
                        Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                            View.Source, Separator.Nextˉoffset,
                            Separator.Nextˉline, Separator.Nextˉcolumn
                        );
                    if Callableˉafterˉcomma.Kind ==
                        Sourceˉlexer.Compilerˉtokenˉkind.Rightˉparenthesis {
                        Readingˉfields = false;
                        End = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                            View.Source, Callableˉafterˉcomma.Nextˉoffset,
                            Callableˉafterˉcomma.Nextˉline,
                            Callableˉafterˉcomma.Nextˉcolumn
                        );
                    } else {
                        Fieldˉcursor = Separator.Nextˉoffset;
                        Fieldˉline = Separator.Nextˉline;
                        Fieldˉcolumn = Separator.Nextˉcolumn;
                    }
                } else {
                    Readingˉfields = false;
                    End = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                        View.Source, Separator.Nextˉoffset,
                        Separator.Nextˉline, Separator.Nextˉcolumn
                    );
                }
            }
        }
        let Caseˉoffset: u32 = Offset + Lastˉdot + 1u32;
        let Caseˉlength: u32 = Length - Lastˉdot - 1u32;
        if Case.Length == Caseˉlength {
            if Sourceˉset.Compilerˉsourceˉspansˉequal(
                View.Source, Case.Offset, Case.Length,
                Source, Caseˉoffset, Caseˉlength
            ) {
                return Compilerˉsourceˉbindingˉmatch(
                    true, Accessible, Compilerˉsourceˉcallableˉkind.Variantˉcase,
                    Nominal.Module, Arity, Nominal.Directoryˉindex
                );
            }
        }
        Cursor = End.Nextˉoffset;
        Line = End.Nextˉline;
        Column = End.Nextˉcolumn;
        Caseˉindex = Caseˉindex + 1u32;
    }
    return Compilerˉsourceˉbindingˉmatch(false, Accessible, Compilerˉsourceˉcallableˉkind.Variantˉcase, Nominal.Module, 0u32, Nominal.Directoryˉindex);
}

export fn Compilerˉsourceˉbindingsˉfindˉcallable(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Owner: u32,
    Source: bytes,
    Offset: u32,
    Length: u32
) -> Compilerˉsourceˉbindingˉmatch {
    let Intrinsic: Compilerˉsourceˉbindingˉmatch = Compilerˉsourceˉbindingsˉintrinsicˉarity(
        Source, Offset, Length
    );
    if Intrinsic.Found { return Intrinsic; }
    let Variantˉcase: Compilerˉsourceˉbindingˉmatch = Compilerˉsourceˉbindingsˉfindˉvariantˉcase(
        Input, Scan, Symbols, Owner, Source, Offset, Length
    );
    if Variantˉcase.Found { return Variantˉcase; }
    let Entries: u32 = Bytesˉreadˉu32ˉlittle(Symbols.Directory, 8u32);
    var Query: Compilerˉsourceˉbindingˉquery = Compilerˉsourceˉbindingsˉquery(
        Input, Scan, Symbols.Lookup, Owner, Source, Offset, Length
    );
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉisˉknownˉcapability(Source, Offset, Length) {
        Query = Compilerˉsourceˉbindingˉquery(
            false, true, Owner, Offset, Length
        );
    }
    if Query.Qualified {
        if !Query.Aliasˉfound {
            return Compilerˉsourceˉbindingˉmatch(
                false, false, Compilerˉsourceˉcallableˉkind.None,
                Symbols.Modules, 0u32, Entries
            );
        }
    }
    let Queryˉfirst: u8 = Bytesˉreadˉu8(Source, Query.Nameˉoffset);
    let Range: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉsymbols.Compilerˉsourceˉsymbolsˉlookupˉrange(
        Symbols.Lookup, Queryˉfirst
    );
    var Index: u32 = 0u32;
    while Index < Range.Line {
        let Directoryˉindex: u32 = Bytesˉreadˉu32ˉlittle(
            Symbols.Lookup, 4112u32 + (Range.Offset + Index) * 4u32
        );
        let Entry: u32 = 16u32 + Directoryˉindex * 24u32;
        let Kindˉvalue: u32 = Bytesˉreadˉu32ˉlittle(Symbols.Directory, Entry + 4u32);
        var Callableˉkind: Compilerˉsourceˉcallableˉkind = Compilerˉsourceˉcallableˉkind.None;
        if Kindˉvalue == 4u32 { Callableˉkind = Compilerˉsourceˉcallableˉkind.Record; }
        if Kindˉvalue == 6u32 { Callableˉkind = Compilerˉsourceˉcallableˉkind.Function; }
        if Kindˉvalue == 2u32 { Callableˉkind = Compilerˉsourceˉcallableˉkind.Capability; }
        if Callableˉkind != Compilerˉsourceˉcallableˉkind.None {
            let Target: u32 = Bytesˉreadˉu32ˉlittle(Symbols.Directory, Entry);
            var Candidate: bool = Target == Query.Target;
            let Targetˉview: Sourceˉset.Compilerˉsourceˉsetˉview =
                Sourceˉset.Compilerˉsourceˉsetˉmodule(
                    Input, Scan, Target
                );
            let Nameˉoffset: u32 = Bytesˉreadˉu32ˉlittle(Symbols.Directory, Entry + 12u32);
            let Nameˉlength: u32 = Bytesˉreadˉu32ˉlittle(Symbols.Directory, Entry + 16u32);
            if Candidate {
            if Nameˉlength == Query.Nameˉlength {
                if Sourceˉset.Compilerˉsourceˉspansˉequal(
                    Source, Query.Nameˉoffset, Query.Nameˉlength,
                    Targetˉview.Source, Nameˉoffset, Nameˉlength
                ) {
                    var Items: u32 = Bytesˉreadˉu32ˉlittle(Symbols.Directory, Entry + 20u32);
                    if Callableˉkind == Compilerˉsourceˉcallableˉkind.Capability {
                        Items = Compilerˉsourceˉbindingsˉcapabilityˉarity(Source, Offset, Length);
                    }
                    var Accessible: bool = Target == Owner;
                    if Query.Qualified {
                        if Query.Aliasˉfound {
                            Accessible = Compilerˉsourceˉbindingsˉdeclarationˉisˉexported(
                                Input, Scan, Symbols, Directoryˉindex
                            );
                        }
                    }
                    return Compilerˉsourceˉbindingˉmatch(
                        true,
                        Accessible,
                        Callableˉkind,
                        Target,
                        Items,
                        Directoryˉindex
                    );
                }
            }
            }
        }
        Index = Index + 1u32;
    }
    return Compilerˉsourceˉbindingˉmatch(
        false, false, Compilerˉsourceˉcallableˉkind.None,
        Symbols.Modules, 0u32, Bytesˉreadˉu32ˉlittle(Symbols.Directory, 8u32)
    );
}

export fn Compilerˉsourceˉbindingsˉfindˉlocalˉcapability(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Payload: bytes,
    Bindingˉfirst: u32,
    Bindingˉentries: u32,
    Source: bytes,
    Offset: u32,
    Length: u32,
    Useˉoffset: u32
) -> Compilerˉsourceˉbindingˉmatch {
    let Local: Compilerˉsourceˉlocalˉmatch = Compilerˉsourceˉbindingsˉfindˉlocal(
        Source, Payload, Bindingˉfirst, Bindingˉentries, Offset, Length, Useˉoffset
    );
    if Local.Found {
        if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉshapeˉisˉcapability(
            Symbols.Directory, Local.Shape
        ) {
            let Target: u32 = Local.Shape - 268435456u32;
            let Entry: u32 = 16u32 + Target * 24u32;
            let Root: Sourceˉset.Compilerˉsourceˉsetˉview = Sourceˉset.Compilerˉsourceˉsetˉmodule(
                Input, Scan, 0u32
            );
            return Compilerˉsourceˉbindingˉmatch(
                true, true, Compilerˉsourceˉcallableˉkind.Capability, 0u32,
                Compilerˉsourceˉbindingsˉcapabilityˉarity(
                    Root.Source,
                    Bytesˉreadˉu32ˉlittle(Symbols.Directory, Entry + 12u32),
                    Bytesˉreadˉu32ˉlittle(Symbols.Directory, Entry + 16u32)
                ),
                Target
            );
        }
    }
    return Compilerˉsourceˉbindingˉmatch(
        false, false, Compilerˉsourceˉcallableˉkind.None,
        Symbols.Modules, 0u32, Bytesˉreadˉu32ˉlittle(Symbols.Directory, 8u32)
        );
}

export fn Compilerˉsourceˉbindingsˉbodyˉempty() -> Compilerˉsourceˉbindingˉbody {
    return Compilerˉsourceˉbindingˉbody(
        Compilerˉsourceˉbindingˉstatus.Valid,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32
    );
}

export fn Compilerˉsourceˉbindingsˉbodyˉfailure(
    Body: Compilerˉsourceˉbindingˉbody,
    Status: Compilerˉsourceˉbindingˉstatus,
    Module: u32,
    Relatedˉmodule: u32,
    Function: u32,
    Offset: u32,
    Line: u32,
    Column: u32
) -> Compilerˉsourceˉbindingˉbody {
    return Compilerˉsourceˉbindingˉbody(
        Status,
        Body.Reads,
        Body.Assignments,
        Body.Calls,
        Module,
        Relatedˉmodule,
        Function,
        Offset,
        Line,
        Column
    );
}

export fn Compilerˉsourceˉbindingsˉbodyˉcounts(
    Reads: u32,
    Assignments: u32,
    Calls: u32
) -> Compilerˉsourceˉbindingˉbody {
    return Compilerˉsourceˉbindingˉbody(
        Compilerˉsourceˉbindingˉstatus.Valid,
        Reads,
        Assignments,
        Calls,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32
    );
}

export fn Compilerˉsourceˉbindingsˉbodyˉcombine(
    Left: Compilerˉsourceˉbindingˉbody,
    Right: Compilerˉsourceˉbindingˉbody
) -> Compilerˉsourceˉbindingˉbody {
    if Left.Status != Compilerˉsourceˉbindingˉstatus.Valid { return Left; }
    if Right.Status != Compilerˉsourceˉbindingˉstatus.Valid { return Right; }
    return Compilerˉsourceˉbindingsˉbodyˉcounts(
        Left.Reads + Right.Reads,
        Left.Assignments + Right.Assignments,
        Left.Calls + Right.Calls
    );
}

export fn Compilerˉsourceˉbindingsˉbindˉname(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Payload: bytes,
    Bindingˉfirst: u32,
    Bindingˉentries: u32,
    Module: u32,
    Function: u32,
    Source: bytes,
    Nameˉoffset: u32,
    Nameˉlength: u32,
    Useˉoffset: u32,
    Line: u32,
    Column: u32
) -> Compilerˉsourceˉbindingˉbody {
    let Local: Compilerˉsourceˉlocalˉmatch = Compilerˉsourceˉbindingsˉfindˉlocal(
        Source, Payload, Bindingˉfirst, Bindingˉentries,
        Nameˉoffset, Nameˉlength, Useˉoffset
    );
    if Local.Found { return Compilerˉsourceˉbindingsˉbodyˉcounts(1u32, 0u32, 0u32); }
    let Data: Compilerˉsourceˉbindingˉmatch = Compilerˉsourceˉbindingsˉfindˉdeclaration(
        Input, Scan, Symbols, Module, Source, Nameˉoffset, Nameˉlength,
        Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Data
    );
    if Data.Found {
        if Data.Accessible { return Compilerˉsourceˉbindingsˉbodyˉcounts(1u32, 0u32, 0u32); }
        return Compilerˉsourceˉbindingsˉbodyˉfailure(
            Compilerˉsourceˉbindingsˉbodyˉempty(),
            Compilerˉsourceˉbindingˉstatus.Inaccessibleˉname,
            Module, Data.Module, Function, Nameˉoffset, Line, Column
        );
    }
    let Constant: Compilerˉsourceˉbindingˉmatch = Compilerˉsourceˉbindingsˉfindˉdeclaration(
        Input, Scan, Symbols, Module, Source, Nameˉoffset, Nameˉlength,
        Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Constant
    );
    if Constant.Found {
        if Constant.Accessible {
            return Compilerˉsourceˉbindingsˉbodyˉcounts(1u32, 0u32, 0u32);
        }
        return Compilerˉsourceˉbindingsˉbodyˉfailure(
            Compilerˉsourceˉbindingsˉbodyˉempty(),
            Compilerˉsourceˉbindingˉstatus.Inaccessibleˉname,
            Module, Constant.Module, Function, Nameˉoffset, Line, Column
        );
    }
    let Capability: Compilerˉsourceˉbindingˉmatch = Compilerˉsourceˉbindingsˉfindˉcallable(
        Input, Scan, Symbols, 0u32, Source, Nameˉoffset, Nameˉlength
    );
    if Capability.Kind == Compilerˉsourceˉcallableˉkind.Capability {
        return Compilerˉsourceˉbindingsˉbodyˉcounts(1u32, 0u32, 0u32);
    }
    return Compilerˉsourceˉbindingsˉbodyˉfailure(
        Compilerˉsourceˉbindingsˉbodyˉempty(),
        Compilerˉsourceˉbindingˉstatus.Unknownˉname,
        Module, Symbols.Modules, Function, Nameˉoffset, Line, Column
    );
}

export fn Compilerˉsourceˉbindingsˉbindˉfield(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Payload: bytes,
    Bindingˉfirst: u32,
    Bindingˉentries: u32,
    Module: u32,
    Function: u32,
    Source: bytes,
    Expression: Sourceˉbodies.Compilerˉsourceˉexpression
) -> Compilerˉsourceˉbindingˉbody {
    let Position: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
        Source, Expression.Offset, Expression.Line, Expression.Column, Expression.Firstˉoffset
    );
    let Local: Compilerˉsourceˉlocalˉmatch = Compilerˉsourceˉbindingsˉfindˉlocal(
        Source, Payload, Bindingˉfirst, Bindingˉentries,
        Expression.Firstˉoffset, Expression.Firstˉlength, Expression.Offset
    );
    if Local.Found { return Compilerˉsourceˉbindingsˉbodyˉcounts(1u32, 0u32, 0u32); }
    let Data: Compilerˉsourceˉbindingˉmatch = Compilerˉsourceˉbindingsˉfindˉdeclaration(
        Input, Scan, Symbols, Module, Source,
        Expression.Valueˉoffset, Expression.Valueˉlength,
        Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Data
    );
    if Data.Found {
        if Data.Accessible { return Compilerˉsourceˉbindingsˉbodyˉcounts(1u32, 0u32, 0u32); }
        return Compilerˉsourceˉbindingsˉbodyˉfailure(
            Compilerˉsourceˉbindingsˉbodyˉempty(),
            Compilerˉsourceˉbindingˉstatus.Inaccessibleˉname,
            Module, Data.Module, Function,
            Expression.Valueˉoffset, Position.Line, Position.Column
        );
    }
    let Constant: Compilerˉsourceˉbindingˉmatch = Compilerˉsourceˉbindingsˉfindˉdeclaration(
        Input, Scan, Symbols, Module, Source,
        Expression.Valueˉoffset, Expression.Valueˉlength,
        Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Constant
    );
    if Constant.Found {
        if Constant.Accessible { return Compilerˉsourceˉbindingsˉbodyˉcounts(1u32, 0u32, 0u32); }
        return Compilerˉsourceˉbindingsˉbodyˉfailure(
            Compilerˉsourceˉbindingsˉbodyˉempty(),
            Compilerˉsourceˉbindingˉstatus.Inaccessibleˉname,
            Module, Constant.Module, Function,
            Expression.Valueˉoffset, Position.Line, Position.Column
        );
    }
    let Capability: Compilerˉsourceˉbindingˉmatch = Compilerˉsourceˉbindingsˉfindˉcallable(
        Input, Scan, Symbols, 0u32, Source,
        Expression.Valueˉoffset, Expression.Valueˉlength
    );
    if Capability.Kind == Compilerˉsourceˉcallableˉkind.Capability {
        return Compilerˉsourceˉbindingsˉbodyˉcounts(1u32, 0u32, 0u32);
    }
    var Lastˉdot: u32 = Expression.Valueˉlength;
    var Nameˉcharacter: u32 = 0u32;
    while Nameˉcharacter < Expression.Valueˉlength {
        if Bytesˉreadˉu8(Source, Expression.Valueˉoffset + Nameˉcharacter) == 46u8 {
            Lastˉdot = Nameˉcharacter;
        }
        Nameˉcharacter = Nameˉcharacter + 1u32;
    }
    let Nominal: Sourceˉsymbols.Compilerˉsourceˉsymbolˉmatch = Sourceˉsymbols.Compilerˉsourceˉsymbolsˉfindˉownedˉnominal(
        Input,
        Scan,
        Symbols.Directory,
        Symbols.Lookup,
        Module,
        Source,
        Expression.Valueˉoffset,
        Lastˉdot
    );
    if Nominal.Found {
        if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉownedˉmatchˉisˉaccessible(
            Input, Scan, Symbols.Visibility, Symbols.Lookup, Module, Source,
            Expression.Valueˉoffset, Lastˉdot, Nominal
        ) {
            return Compilerˉsourceˉbindingsˉbodyˉcounts(1u32, 0u32, 0u32);
        }
        return Compilerˉsourceˉbindingsˉbodyˉfailure(
            Compilerˉsourceˉbindingsˉbodyˉempty(),
            Compilerˉsourceˉbindingˉstatus.Inaccessibleˉname,
            Module, Nominal.Module, Function,
            Expression.Firstˉoffset, Position.Line, Position.Column
        );
    }
    return Compilerˉsourceˉbindingsˉbodyˉfailure(
        Compilerˉsourceˉbindingsˉbodyˉempty(),
        Compilerˉsourceˉbindingˉstatus.Unknownˉname,
        Module, Symbols.Modules, Function,
        Expression.Firstˉoffset, Position.Line, Position.Column
    );
}

export fn Compilerˉsourceˉbindingsˉbindˉassignment(
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Payload: bytes,
    Bindingˉfirst: u32,
    Bindingˉentries: u32,
    Module: u32,
    Function: u32,
    Source: bytes,
    Statement: Sourceˉbodies.Compilerˉsourceˉstatement
) -> Compilerˉsourceˉbindingˉbody {
    let Position: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
        Source, Statement.Offset, Statement.Line, Statement.Column, Statement.Nameˉoffset
    );
    let Local: Compilerˉsourceˉlocalˉmatch = Compilerˉsourceˉbindingsˉfindˉlocal(
        Source, Payload, Bindingˉfirst, Bindingˉentries,
        Statement.Nameˉoffset, Statement.Nameˉlength, Statement.Offset
    );
    if !Local.Found {
        return Compilerˉsourceˉbindingsˉbodyˉfailure(
            Compilerˉsourceˉbindingsˉbodyˉempty(),
            Compilerˉsourceˉbindingˉstatus.Unknownˉassignment,
            Module, Symbols.Modules, Function,
            Statement.Nameˉoffset, Position.Line, Position.Column
        );
    }
    if Local.Kind != Compilerˉsourceˉbindingˉkind.Var {
        return Compilerˉsourceˉbindingsˉbodyˉfailure(
            Compilerˉsourceˉbindingsˉbodyˉempty(),
            Compilerˉsourceˉbindingˉstatus.Immutableˉassignment,
            Module, Module, Function,
            Statement.Nameˉoffset, Position.Line, Position.Column
        );
    }
    let Operatorˉposition: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
        Source, Statement.Offset, Statement.Line, Statement.Column,
        Statement.Nameˉoffset + Statement.Nameˉlength
    );
    let Operator: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉbodies.Compilerˉbodyˉtoken(
        Source,
        Statement.Nameˉoffset + Statement.Nameˉlength,
        Operatorˉposition.Line,
        Operatorˉposition.Column,
        Statement.Expressionˉoffset
    );
    var Reads: u32 = 0u32;
    if Operator.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Plusˉequals { Reads = 1u32; }
    if Operator.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Minusˉequals { Reads = 1u32; }
    if Operator.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Starˉequals { Reads = 1u32; }
    return Compilerˉsourceˉbindingsˉbodyˉcounts(Reads, 1u32, 0u32);
}

export fn Compilerˉsourceˉbindingsˉbindˉexpression(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Payload: bytes,
    Bindingˉfirst: u32,
    Bindingˉentries: u32,
    Module: u32,
    Function: u32,
    Source: bytes,
    Offset: u32,
    Line: u32,
    Column: u32,
    Endˉoffset: u32
) -> Compilerˉsourceˉbindingˉbody {
    let Expression: Sourceˉbodies.Compilerˉsourceˉexpression = Sourceˉbodies.Compilerˉparseˉexpressionˉvalidated(
        Source, Offset, Line, Column, Endˉoffset, 0u32, 0u32
    );
    if Expression.Kind == Sourceˉbodies.Compilerˉsourceˉexpressionˉkind.Integer ||
        Expression.Kind == Sourceˉbodies.Compilerˉsourceˉexpressionˉkind.String ||
        Expression.Kind == Sourceˉbodies.Compilerˉsourceˉexpressionˉkind.Boolean ||
        Expression.Kind == Sourceˉbodies.Compilerˉsourceˉexpressionˉkind.Builder ||
        Expression.Kind == Sourceˉbodies.Compilerˉsourceˉexpressionˉkind.Unit ||
        Expression.Kind == Sourceˉbodies.Compilerˉsourceˉexpressionˉkind.Rune ||
        Expression.Kind == Sourceˉbodies.Compilerˉsourceˉexpressionˉkind.Floating {
        return Compilerˉsourceˉbindingsˉbodyˉempty();
    }
    if Expression.Kind == Sourceˉbodies.Compilerˉsourceˉexpressionˉkind.Name {
        let Readˉnameˉposition: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
            Source, Expression.Offset, Expression.Line, Expression.Column, Expression.Valueˉoffset
        );
        return Compilerˉsourceˉbindingsˉbindˉname(
            Input, Scan, Symbols, Payload, Bindingˉfirst, Bindingˉentries, Module, Function, Source,
            Expression.Valueˉoffset, Expression.Valueˉlength, Expression.Offset,
            Readˉnameˉposition.Line, Readˉnameˉposition.Column
        );
    }
    if Expression.Kind == Sourceˉbodies.Compilerˉsourceˉexpressionˉkind.Field {
        return Compilerˉsourceˉbindingsˉbindˉfield(
            Input, Scan, Symbols, Payload, Bindingˉfirst, Bindingˉentries, Module, Function, Source, Expression
        );
    }
    if Expression.Kind == Sourceˉbodies.Compilerˉsourceˉexpressionˉkind.Unary {
        let Unaryˉposition: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
            Source, Expression.Offset, Expression.Line, Expression.Column, Expression.Firstˉoffset
        );
        return Compilerˉsourceˉbindingsˉbindˉexpression(
            Input, Scan, Symbols, Payload, Bindingˉfirst, Bindingˉentries, Module, Function, Source,
            Expression.Firstˉoffset, Unaryˉposition.Line, Unaryˉposition.Column,
            Expression.Firstˉoffset + Expression.Firstˉlength
        );
    }
    if Expression.Kind == Sourceˉbodies.Compilerˉsourceˉexpressionˉkind.Binary {
        let Binaryˉfirstˉposition: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
            Source, Expression.Offset, Expression.Line, Expression.Column, Expression.Firstˉoffset
        );
        let First: Compilerˉsourceˉbindingˉbody = Compilerˉsourceˉbindingsˉbindˉexpression(
            Input, Scan, Symbols, Payload, Bindingˉfirst, Bindingˉentries, Module, Function, Source,
            Expression.Firstˉoffset, Binaryˉfirstˉposition.Line, Binaryˉfirstˉposition.Column,
            Expression.Firstˉoffset + Expression.Firstˉlength
        );
        if First.Status != Compilerˉsourceˉbindingˉstatus.Valid { return First; }
        let Secondˉposition: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
            Source, Expression.Offset, Expression.Line, Expression.Column, Expression.Secondˉoffset
        );
        let Second: Compilerˉsourceˉbindingˉbody = Compilerˉsourceˉbindingsˉbindˉexpression(
            Input, Scan, Symbols, Payload, Bindingˉfirst, Bindingˉentries, Module, Function, Source,
            Expression.Secondˉoffset, Secondˉposition.Line, Secondˉposition.Column,
            Expression.Secondˉoffset + Expression.Secondˉlength
        );
        return Compilerˉsourceˉbindingsˉbodyˉcombine(First, Second);
    }
    if Expression.Kind == Sourceˉbodies.Compilerˉsourceˉexpressionˉkind.Index {
        let Localˉsequence: Compilerˉsourceˉlocalˉmatch = Compilerˉsourceˉbindingsˉfindˉlocal(
            Source, Payload, Bindingˉfirst, Bindingˉentries,
            Expression.Valueˉoffset, Expression.Valueˉlength, Expression.Offset
        );
        if Localˉsequence.Found {
            let Localˉindexˉposition: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
                Source, Expression.Offset, Expression.Line, Expression.Column, Expression.Firstˉoffset
            );
            let Localˉindex: Compilerˉsourceˉbindingˉbody = Compilerˉsourceˉbindingsˉbindˉexpression(
                Input, Scan, Symbols, Payload, Bindingˉfirst, Bindingˉentries, Module, Function, Source,
                Expression.Firstˉoffset, Localˉindexˉposition.Line, Localˉindexˉposition.Column,
                Expression.Firstˉoffset + Expression.Firstˉlength
            );
            if Localˉindex.Status != Compilerˉsourceˉbindingˉstatus.Valid { return Localˉindex; }
            return Compilerˉsourceˉbindingsˉbodyˉcounts(
                Localˉindex.Reads + 1u32, Localˉindex.Assignments, Localˉindex.Calls
            );
        }
        let Dataˉposition: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
            Source, Expression.Offset, Expression.Line, Expression.Column, Expression.Valueˉoffset
        );
        let Data: Compilerˉsourceˉbindingˉmatch = Compilerˉsourceˉbindingsˉfindˉdeclaration(
            Input, Scan, Symbols, Module, Source,
            Expression.Valueˉoffset, Expression.Valueˉlength,
            Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Data
        );
        if !Data.Found {
            return Compilerˉsourceˉbindingsˉbodyˉfailure(
                Compilerˉsourceˉbindingsˉbodyˉempty(),
                Compilerˉsourceˉbindingˉstatus.Unknownˉname,
                Module, Symbols.Modules, Function,
                Expression.Valueˉoffset, Dataˉposition.Line, Dataˉposition.Column
            );
        }
        if !Data.Accessible {
            return Compilerˉsourceˉbindingsˉbodyˉfailure(
                Compilerˉsourceˉbindingsˉbodyˉempty(),
                Compilerˉsourceˉbindingˉstatus.Inaccessibleˉname,
                Module, Data.Module, Function,
                Expression.Valueˉoffset, Dataˉposition.Line, Dataˉposition.Column
            );
        }
        let Indexˉposition: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
            Source, Expression.Offset, Expression.Line, Expression.Column, Expression.Firstˉoffset
        );
        let Index: Compilerˉsourceˉbindingˉbody = Compilerˉsourceˉbindingsˉbindˉexpression(
            Input, Scan, Symbols, Payload, Bindingˉfirst, Bindingˉentries, Module, Function, Source,
            Expression.Firstˉoffset, Indexˉposition.Line, Indexˉposition.Column,
            Expression.Firstˉoffset + Expression.Firstˉlength
        );
        if Index.Status != Compilerˉsourceˉbindingˉstatus.Valid { return Index; }
        return Compilerˉsourceˉbindingsˉbodyˉcounts(Index.Reads + 1u32, Index.Assignments, Index.Calls);
    }
    if Expression.Kind == Sourceˉbodies.Compilerˉsourceˉexpressionˉkind.Namedˉrecord ||
        Expression.Kind == Sourceˉbodies.Compilerˉsourceˉexpressionˉkind.Recordˉupdate {
        var Fields: Compilerˉsourceˉbindingˉbody = Compilerˉsourceˉbindingsˉbodyˉempty();
        if Expression.Kind == Sourceˉbodies.Compilerˉsourceˉexpressionˉkind.Recordˉupdate {
            let Baseˉposition: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
                Source, Expression.Offset, Expression.Line, Expression.Column,
                Expression.Firstˉoffset
            );
            Fields = Compilerˉsourceˉbindingsˉbindˉexpression(
                Input, Scan, Symbols, Payload, Bindingˉfirst, Bindingˉentries,
                Module, Function, Source,
                Expression.Firstˉoffset, Baseˉposition.Line, Baseˉposition.Column,
                Expression.Firstˉoffset + Expression.Firstˉlength
            );
            if Fields.Status != Compilerˉsourceˉbindingˉstatus.Valid {
                return Fields;
            }
        }
        var Fieldˉcursor: u32 = Expression.Itemsˉoffset;
        var Fieldˉposition: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
            Source, Expression.Offset, Expression.Line, Expression.Column,
            Expression.Itemsˉoffset
        );
        var Fieldˉitem: u32 = 0u32;
        while Fieldˉitem < Expression.Items {
            let Field: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉbodies.Compilerˉbodyˉtoken(
                Source, Fieldˉcursor, Fieldˉposition.Line, Fieldˉposition.Column,
                Expression.Itemsˉoffset + Expression.Itemsˉlength
            );
            let Colon: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉbodies.Compilerˉbodyˉtoken(
                Source, Field.Nextˉoffset, Field.Nextˉline, Field.Nextˉcolumn,
                Expression.Itemsˉoffset + Expression.Itemsˉlength
            );
            let Fieldˉvalue: Sourceˉbodies.Compilerˉsourceˉexpression = Sourceˉbodies.Compilerˉparseˉexpressionˉvalidated(
                Source, Colon.Nextˉoffset, Colon.Nextˉline, Colon.Nextˉcolumn,
                Expression.Itemsˉoffset + Expression.Itemsˉlength, 0u32, 0u32
            );
            let Boundˉfield: Compilerˉsourceˉbindingˉbody = Compilerˉsourceˉbindingsˉbindˉexpression(
                Input, Scan, Symbols, Payload, Bindingˉfirst, Bindingˉentries,
                Module, Function, Source,
                Fieldˉvalue.Offset, Fieldˉvalue.Line, Fieldˉvalue.Column,
                Fieldˉvalue.Offset + Fieldˉvalue.Length
            );
            Fields = Compilerˉsourceˉbindingsˉbodyˉcombine(Fields, Boundˉfield);
            if Fields.Status != Compilerˉsourceˉbindingˉstatus.Valid { return Fields; }
            Fieldˉcursor = Fieldˉvalue.Nextˉoffset;
            Fieldˉposition = Sourceˉbodies.Compilerˉsourceˉposition(
                Fieldˉvalue.Nextˉoffset, Fieldˉvalue.Nextˉline, Fieldˉvalue.Nextˉcolumn
            );
            if Fieldˉitem + 1u32 < Expression.Items {
                let Recordˉseparator: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉbodies.Compilerˉbodyˉtoken(
                    Source, Fieldˉcursor, Fieldˉposition.Line, Fieldˉposition.Column,
                    Expression.Itemsˉoffset + Expression.Itemsˉlength
                );
                Fieldˉcursor = Recordˉseparator.Nextˉoffset;
                Fieldˉposition = Sourceˉbodies.Compilerˉsourceˉposition(
                    Recordˉseparator.Nextˉoffset,
                    Recordˉseparator.Nextˉline,
                    Recordˉseparator.Nextˉcolumn
                );
            }
            Fieldˉitem = Fieldˉitem + 1u32;
        }
        let Recordˉposition: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
            Source, Expression.Offset, Expression.Line, Expression.Column,
            Expression.Valueˉoffset
        );
        let Record: Compilerˉsourceˉbindingˉmatch = Compilerˉsourceˉbindingsˉfindˉcallable(
            Input, Scan, Symbols, Module, Source,
            Expression.Valueˉoffset, Expression.Valueˉlength
        );
        if !Record.Found {
            return Compilerˉsourceˉbindingsˉbodyˉfailure(
                Fields, Compilerˉsourceˉbindingˉstatus.Unknownˉcall,
                Module, Symbols.Modules, Function,
                Expression.Valueˉoffset, Recordˉposition.Line, Recordˉposition.Column
            );
        }
        if !Record.Accessible {
            return Compilerˉsourceˉbindingsˉbodyˉfailure(
                Fields, Compilerˉsourceˉbindingˉstatus.Inaccessibleˉcall,
                Module, Record.Module, Function,
                Expression.Valueˉoffset, Recordˉposition.Line, Recordˉposition.Column
            );
        }
        if Record.Kind != Compilerˉsourceˉcallableˉkind.Record &&
            (Expression.Kind == Sourceˉbodies.Compilerˉsourceˉexpressionˉkind.Recordˉupdate ||
                Record.Kind != Compilerˉsourceˉcallableˉkind.Variantˉcase) {
            return Compilerˉsourceˉbindingsˉbodyˉfailure(
                Fields, Compilerˉsourceˉbindingˉstatus.Unknownˉcall,
                Module, Record.Module, Function,
                Expression.Valueˉoffset, Recordˉposition.Line, Recordˉposition.Column
            );
        }
        return Compilerˉsourceˉbindingsˉbodyˉcounts(
            Fields.Reads, Fields.Assignments, Fields.Calls + 1u32
        );
    }
    if Expression.Kind == Sourceˉbodies.Compilerˉsourceˉexpressionˉkind.Call {
        var Arguments: Compilerˉsourceˉbindingˉbody = Compilerˉsourceˉbindingsˉbodyˉempty();
        var Cursor: u32 = Expression.Itemsˉoffset;
        var Currentˉposition: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
            Source, Expression.Offset, Expression.Line, Expression.Column, Expression.Itemsˉoffset
        );
        var Item: u32 = 0u32;
        while Item < Expression.Items {
            let Argument: Sourceˉbodies.Compilerˉsourceˉexpression = Sourceˉbodies.Compilerˉparseˉexpressionˉvalidated(
                Source, Cursor, Currentˉposition.Line, Currentˉposition.Column,
                Expression.Itemsˉoffset + Expression.Itemsˉlength, 0u32, 0u32
            );
            let Bound: Compilerˉsourceˉbindingˉbody = Compilerˉsourceˉbindingsˉbindˉexpression(
                Input, Scan, Symbols, Payload, Bindingˉfirst, Bindingˉentries, Module, Function, Source,
                Argument.Offset, Argument.Line, Argument.Column,
                Argument.Offset + Argument.Length
            );
            Arguments = Compilerˉsourceˉbindingsˉbodyˉcombine(Arguments, Bound);
            if Arguments.Status != Compilerˉsourceˉbindingˉstatus.Valid { return Arguments; }
            Cursor = Argument.Nextˉoffset;
            Currentˉposition = Sourceˉbodies.Compilerˉsourceˉposition(
                Argument.Nextˉoffset, Argument.Nextˉline, Argument.Nextˉcolumn
            );
            if Item + 1u32 < Expression.Items {
                let Separator: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉbodies.Compilerˉbodyˉtoken(
                    Source, Cursor, Currentˉposition.Line, Currentˉposition.Column,
                    Expression.Itemsˉoffset + Expression.Itemsˉlength
                );
                Cursor = Separator.Nextˉoffset;
                Currentˉposition = Sourceˉbodies.Compilerˉsourceˉposition(
                    Separator.Nextˉoffset, Separator.Nextˉline, Separator.Nextˉcolumn
                );
            }
            Item = Item + 1u32;
        }
        let Callˉnameˉposition: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
            Source, Expression.Offset, Expression.Line, Expression.Column, Expression.Valueˉoffset
        );
        let Capabilityˉlocal: Compilerˉsourceˉbindingˉmatch = Compilerˉsourceˉbindingsˉfindˉlocalˉcapability(
            Input, Scan, Symbols, Payload, Bindingˉfirst, Bindingˉentries, Source,
            Expression.Valueˉoffset, Expression.Valueˉlength, Expression.Offset
        );
        if Capabilityˉlocal.Found {
            if Capabilityˉlocal.Items != Expression.Items {
                return Compilerˉsourceˉbindingsˉbodyˉfailure(
                    Arguments,
                    Compilerˉsourceˉbindingˉstatus.Callˉarity,
                    Module, 0u32, Function,
                    Expression.Valueˉoffset, Callˉnameˉposition.Line, Callˉnameˉposition.Column
                );
            }
            return Compilerˉsourceˉbindingsˉbodyˉcounts(
                Arguments.Reads + 1u32,
                Arguments.Assignments,
                Arguments.Calls + 1u32
            );
        }
        let Callable: Compilerˉsourceˉbindingˉmatch = Compilerˉsourceˉbindingsˉfindˉcallable(
            Input, Scan, Symbols, Module, Source,
            Expression.Valueˉoffset, Expression.Valueˉlength
        );
        if !Callable.Found {
            if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉisˉknownˉcapability(
                Source, Expression.Valueˉoffset, Expression.Valueˉlength
            ) {
                return Compilerˉsourceˉbindingsˉbodyˉfailure(
                    Arguments,
                    Compilerˉsourceˉbindingˉstatus.Undeclaredˉcapability,
                    Module, Symbols.Modules, Function,
                    Expression.Valueˉoffset, Callˉnameˉposition.Line, Callˉnameˉposition.Column
                );
            }
            return Compilerˉsourceˉbindingsˉbodyˉfailure(
                Arguments,
                Compilerˉsourceˉbindingˉstatus.Unknownˉcall,
                Module, Symbols.Modules, Function,
                Expression.Valueˉoffset, Callˉnameˉposition.Line, Callˉnameˉposition.Column
            );
        }
        if !Callable.Accessible {
            return Compilerˉsourceˉbindingsˉbodyˉfailure(
                Arguments,
                Compilerˉsourceˉbindingˉstatus.Inaccessibleˉcall,
                Module, Callable.Module, Function,
                Expression.Valueˉoffset, Callˉnameˉposition.Line, Callˉnameˉposition.Column
            );
        }
        if Callable.Items != Expression.Items {
            return Compilerˉsourceˉbindingsˉbodyˉfailure(
                Arguments,
                Compilerˉsourceˉbindingˉstatus.Callˉarity,
                Module, Callable.Module, Function,
                Expression.Valueˉoffset, Callˉnameˉposition.Line, Callˉnameˉposition.Column
            );
        }
        return Compilerˉsourceˉbindingsˉbodyˉcounts(
            Arguments.Reads, Arguments.Assignments, Arguments.Calls + 1u32
        );
    }
    return Compilerˉsourceˉbindingsˉbodyˉempty();
}

export fn Compilerˉsourceˉbindingsˉphaseˉempty(Input: bytes) -> Compilerˉsourceˉbindingˉphase {
    return Compilerˉsourceˉbindingsˉphaseˉfrom(
        Compilerˉsourceˉbindingsˉbuildˉempty(Input),
        Compilerˉsourceˉbindingsˉbodyˉempty()
    );
}

export fn Compilerˉsourceˉbindingsˉphaseˉbody(
    Phase: Compilerˉsourceˉbindingˉphase,
    Body: Compilerˉsourceˉbindingˉbody
) -> Compilerˉsourceˉbindingˉphase {
    return Compilerˉsourceˉbindingsˉphaseˉfrom(
        Compilerˉsourceˉbindingsˉphaseˉbuildˉvalue(Phase),
        Compilerˉsourceˉbindingsˉbodyˉcombine(
            Compilerˉsourceˉbindingsˉphaseˉbodyˉvalue(Phase), Body
        )
    );
}

export fn Compilerˉsourceˉbindingsˉphaseˉbuild(
    Phase: Compilerˉsourceˉbindingˉphase,
    Build: Compilerˉsourceˉbindingˉbuild
) -> Compilerˉsourceˉbindingˉphase {
    return Compilerˉsourceˉbindingsˉphaseˉfrom(
        Build, Compilerˉsourceˉbindingsˉphaseˉbodyˉvalue(Phase)
    );
}

export fn Compilerˉsourceˉbindingsˉphaseˉmerge(
    Global: Compilerˉsourceˉbindingˉphase,
    Local: Compilerˉsourceˉbindingˉphase
) -> Compilerˉsourceˉbindingˉphase {
    if Local.Buildˉstatus != Compilerˉsourceˉbindingˉstatus.Valid { return Local; }
    if Local.Bodyˉstatus != Compilerˉsourceˉbindingˉstatus.Valid { return Local; }
    let Build: Compilerˉsourceˉbindingˉbuild = Compilerˉsourceˉbindingˉbuild(
        Compilerˉsourceˉbindingˉstatus.Valid,
        Bytesˉconcat(Global.Payload, Local.Payload),
        Global.Entries + Local.Entries,
        Global.Parameters + Local.Parameters,
        Global.Locals + Local.Locals,
        Local.Nextˉslot,
        0u32, 0u32, 0u32, 0u32, 0u32, 0u32
    );
    let Body: Compilerˉsourceˉbindingˉbody = Compilerˉsourceˉbindingsˉbodyˉcombine(
        Compilerˉsourceˉbindingsˉphaseˉbodyˉvalue(Global),
        Compilerˉsourceˉbindingsˉphaseˉbodyˉvalue(Local)
    );
    return Compilerˉsourceˉbindingsˉphaseˉfrom(Build, Body);
}

fn Compilerˉsourceˉbindingsˉvariantˉfieldˉshape(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Owner: u32,
    View: Sourceˉset.Compilerˉsourceˉsetˉview,
    Fields: u32,
    Fieldsˉoffset: u32,
    Fieldsˉline: u32,
    Fieldsˉcolumn: u32,
    Queryˉsource: bytes,
    Queryˉoffset: u32,
    Queryˉlength: u32
) -> u32 {
    var Cursor: u32 = Fieldsˉoffset;
    var Line: u32 = Fieldsˉline;
    var Column: u32 = Fieldsˉcolumn;
    var Index: u32 = 0u32;
    while Index < Fields {
        let Name: Sourceˉlexer.Compilerˉsourceˉtoken =
            Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                View.Source, Cursor, Line, Column
            );
        let Field: Sourceˉdeclarations.Compilerˉsourceˉvariantˉfield =
            Sourceˉdeclarations.Compilerˉparseˉvariantˉfield(
                View.Source, Cursor, Line, Column
            );
        if Name.Length == Queryˉlength {
            if Sourceˉset.Compilerˉsourceˉspansˉequal(
                View.Source, Name.Offset, Name.Length,
                Queryˉsource, Queryˉoffset, Queryˉlength
            ) {
                let Colon: Sourceˉlexer.Compilerˉsourceˉtoken =
                    Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                        View.Source, Name.Nextˉoffset,
                        Name.Nextˉline, Name.Nextˉcolumn
                    );
                let Type: Sourceˉsymbols.Compilerˉsourceˉtypeˉbinding =
                    Sourceˉsymbols.Compilerˉsourceˉsymbolsˉbindˉtype(
                        Input, Scan, Symbols.Directory, Symbols.Lookup,
                        Symbols.Visibility, Owner, View.Source,
                        Colon.Nextˉoffset, Colon.Nextˉline,
                        Colon.Nextˉcolumn,
                        Symbols.Records, Symbols.Enums, false
                    );
                return Compilerˉsourceˉbindingsˉshape(Type);
            }
        }
        let Separator: Sourceˉlexer.Compilerˉsourceˉtoken =
            Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                View.Source, Field.Nextˉoffset,
                Field.Nextˉline, Field.Nextˉcolumn
            );
        Cursor = Separator.Nextˉoffset;
        Line = Separator.Nextˉline;
        Column = Separator.Nextˉcolumn;
        Index = Index + 1u32;
    }
    return 0u32;
}

fn Compilerˉsourceˉbindingsˉcollectˉmatchˉfields(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Module: u32,
    Function: u32,
    Source: bytes,
    Case: Sourceˉbodies.Compilerˉsourceˉmatchˉcase,
    Nominal: Sourceˉsymbols.Compilerˉsourceˉsymbolˉmatch,
    View: Sourceˉset.Compilerˉsourceˉsetˉview,
    Fields: u32,
    Fieldsˉoffset: u32,
    Fieldsˉline: u32,
    Fieldsˉcolumn: u32,
    Patternˉstart: Sourceˉlexer.Compilerˉsourceˉtoken,
    Build: Compilerˉsourceˉbindingˉbuild
) -> Compilerˉsourceˉbindingˉbuild {
    var Result: Compilerˉsourceˉbindingˉbuild = Build;
    var Cursor: u32 = Patternˉstart.Nextˉoffset;
    var Line: u32 = Patternˉstart.Nextˉline;
    var Column: u32 = Patternˉstart.Nextˉcolumn;
    var Index: u32 = 0u32;
    while Index < Fields {
        let Field: Sourceˉlexer.Compilerˉsourceˉtoken =
            Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                Source, Cursor, Line, Column
            );
        let Colon: Sourceˉlexer.Compilerˉsourceˉtoken =
            Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                Source, Field.Nextˉoffset,
                Field.Nextˉline, Field.Nextˉcolumn
            );
        let Binding: Sourceˉlexer.Compilerˉsourceˉtoken =
            Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                Source, Colon.Nextˉoffset,
                Colon.Nextˉline, Colon.Nextˉcolumn
            );
        let Shape: u32 =
            Compilerˉsourceˉbindingsˉvariantˉfieldˉshape(
                Input, Scan, Symbols, Nominal.Module, View,
                Fields, Fieldsˉoffset, Fieldsˉline, Fieldsˉcolumn,
                Source, Field.Offset, Field.Length
            );
        let Discard: bool = Binding.Length == 1u32 &&
            Bytesˉreadˉu8(Source, Binding.Offset) == 95u8;
        if Shape != 0u32 && !Discard {
            let Position: Sourceˉbodies.Compilerˉsourceˉposition =
                Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
                    Source, Case.Bindingˉoffset, 1u32, 1u32,
                    Binding.Offset
                );
            if Compilerˉsourceˉbindingsˉpriorˉlocal(
                Source, Result.Payload,
                Result.Entries - Result.Nextˉslot, Result.Entries,
                Module, Function, Binding.Offset, Binding.Length
            ) {
                return Compilerˉsourceˉbindingsˉbuildˉfailure(
                    Result, Compilerˉsourceˉbindingˉstatus.Duplicateˉlocal,
                    Module, Nominal.Module, Function,
                    Binding.Offset, Position.Line, Position.Column
                );
            }
            if Result.Nextˉslot >= 4096u32 {
                return Compilerˉsourceˉbindingsˉbuildˉfailure(
                    Result, Compilerˉsourceˉbindingˉstatus.Bindingˉlimit,
                    Module, Nominal.Module, Function,
                    Binding.Offset, Position.Line, Position.Column
                );
            }
            if Bytesˉlength(Result.Payload) > 4194252u32 {
                return Compilerˉsourceˉbindingsˉbuildˉfailure(
                    Result, Compilerˉsourceˉbindingˉstatus.Evidenceˉlimit,
                    Module, Nominal.Module, Function,
                    Binding.Offset, Position.Line, Position.Column
                );
            }
            let Entry: bytes = Compilerˉsourceˉbindingsˉentry(
                Module, Function, Compilerˉsourceˉbindingˉkind.Let,
                Result.Nextˉslot, Binding.Offset, Binding.Length, Shape,
                Case.Blockˉoffset,
                Case.Blockˉoffset + Case.Blockˉlength
            );
            Result = Compilerˉsourceˉbindingsˉappend(
                Result, Entry, false
            );
        }
        let Separator: Sourceˉlexer.Compilerˉsourceˉtoken =
            Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                Source, Binding.Nextˉoffset,
                Binding.Nextˉline, Binding.Nextˉcolumn
            );
        Cursor = Separator.Nextˉoffset;
        Line = Separator.Nextˉline;
        Column = Separator.Nextˉcolumn;
        Index = Index + 1u32;
    }
    return Result;
}

export fn Compilerˉsourceˉbindingsˉcollectˉmatchˉbinding(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Module: u32,
    Function: u32,
    Source: bytes,
    Case: Sourceˉbodies.Compilerˉsourceˉmatchˉcase,
    Build: Compilerˉsourceˉbindingˉbuild
) -> Compilerˉsourceˉbindingˉbuild {
    if Case.Bindingˉlength == 0u32 { return Build; }
    let Nominal: Sourceˉsymbols.Compilerˉsourceˉsymbolˉmatch = Sourceˉsymbols.Compilerˉsourceˉsymbolsˉfindˉownedˉnominal(
        Input, Scan, Symbols.Directory, Symbols.Lookup, Module,
        Source, Case.Enumˉoffset, Case.Enumˉlength
    );
    if !Nominal.Found { return Build; }
    if Nominal.Kind != Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Variant { return Build; }
    let View: Sourceˉset.Compilerˉsourceˉsetˉview = Sourceˉset.Compilerˉsourceˉsetˉmodule(
        Input, Scan, Nominal.Module
    );
    let Position: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
        View.Source, 0u32, 1u32, 1u32, Nominal.Declarationˉoffset
    );
    let Declaration: Sourceˉdeclarations.Compilerˉsourceˉdeclaration = Sourceˉdeclarations.Compilerˉparseˉnextˉdeclarationˉvalidated(
        View.Source, Nominal.Declarationˉoffset, Position.Line, Position.Column, true
    );
    let Bodyˉposition: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
        View.Source, Declaration.Declarationˉoffset, Position.Line, Position.Column, Declaration.Bodyˉoffset
    );
    let Left: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
        View.Source, Declaration.Bodyˉoffset, Bodyˉposition.Line, Bodyˉposition.Column
    );
    var Cursor: u32 = Left.Nextˉoffset;
    var Line: u32 = Left.Nextˉline;
    var Column: u32 = Left.Nextˉcolumn;
    var Index: u32 = 0u32;
    while Index < Declaration.Items {
        let Targetˉcase: Sourceˉlexer.Compilerˉsourceˉtoken =
            Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                View.Source, Cursor, Line, Column
            );
        let Afterˉname: Sourceˉlexer.Compilerˉsourceˉtoken =
            Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                View.Source, Targetˉcase.Nextˉoffset,
                Targetˉcase.Nextˉline, Targetˉcase.Nextˉcolumn
            );
        var End: Sourceˉlexer.Compilerˉsourceˉtoken = Afterˉname;
        var Fields: u32 = 0u32;
        var Fieldsˉoffset: u32 = Afterˉname.Nextˉoffset;
        var Fieldsˉline: u32 = Afterˉname.Nextˉline;
        var Fieldsˉcolumn: u32 = Afterˉname.Nextˉcolumn;
        if Afterˉname.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Leftˉparenthesis {
            var Fieldˉcursor: u32 = Fieldsˉoffset;
            var Fieldˉline: u32 = Fieldsˉline;
            var Fieldˉcolumn: u32 = Fieldsˉcolumn;
            var Readingˉfields: bool = true;
            while Readingˉfields {
                let Field: Sourceˉdeclarations.Compilerˉsourceˉvariantˉfield =
                    Sourceˉdeclarations.Compilerˉparseˉvariantˉfield(
                        View.Source, Fieldˉcursor, Fieldˉline, Fieldˉcolumn
                    );
                Fields = Fields + 1u32;
                let Separator: Sourceˉlexer.Compilerˉsourceˉtoken =
                    Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                        View.Source, Field.Nextˉoffset,
                        Field.Nextˉline, Field.Nextˉcolumn
                    );
                if Separator.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Comma {
                    let Caseˉafterˉcomma:
                        Sourceˉlexer.Compilerˉsourceˉtoken =
                        Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                            View.Source, Separator.Nextˉoffset,
                            Separator.Nextˉline, Separator.Nextˉcolumn
                        );
                    if Caseˉafterˉcomma.Kind ==
                        Sourceˉlexer.Compilerˉtokenˉkind.Rightˉparenthesis {
                        Readingˉfields = false;
                        End = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                            View.Source, Caseˉafterˉcomma.Nextˉoffset,
                            Caseˉafterˉcomma.Nextˉline,
                            Caseˉafterˉcomma.Nextˉcolumn
                        );
                    } else {
                        Fieldˉcursor = Separator.Nextˉoffset;
                        Fieldˉline = Separator.Nextˉline;
                        Fieldˉcolumn = Separator.Nextˉcolumn;
                    }
                } else {
                    Readingˉfields = false;
                    End = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                        View.Source, Separator.Nextˉoffset,
                        Separator.Nextˉline, Separator.Nextˉcolumn
                    );
                }
            }
        }
        var Matches: bool = Targetˉcase.Length == Case.Memberˉlength;
        if Matches {
            Matches = Sourceˉset.Compilerˉsourceˉspansˉequal(
                View.Source, Targetˉcase.Offset, Targetˉcase.Length,
                Source, Case.Memberˉoffset, Case.Memberˉlength
            );
        }
        if Matches {
            let Patternˉstart: Sourceˉlexer.Compilerˉsourceˉtoken =
                Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                    Source, Case.Bindingˉoffset, 1u32, 1u32
                );
            if Patternˉstart.Kind !=
                Sourceˉlexer.Compilerˉtokenˉkind.Leftˉbrace {
                if Fields != 1u32 { return Build; }
                let Declaredˉname: Sourceˉlexer.Compilerˉsourceˉtoken =
                    Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                        View.Source, Fieldsˉoffset,
                        Fieldsˉline, Fieldsˉcolumn
                    );
                let Declaredˉcolon: Sourceˉlexer.Compilerˉsourceˉtoken =
                    Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                        View.Source, Declaredˉname.Nextˉoffset,
                        Declaredˉname.Nextˉline, Declaredˉname.Nextˉcolumn
                    );
                let Declaredˉtype:
                    Sourceˉsymbols.Compilerˉsourceˉtypeˉbinding =
                    Sourceˉsymbols.Compilerˉsourceˉsymbolsˉbindˉtype(
                        Input, Scan, Symbols.Directory, Symbols.Lookup,
                        Symbols.Visibility, Nominal.Module, View.Source,
                        Declaredˉcolon.Nextˉoffset,
                        Declaredˉcolon.Nextˉline,
                        Declaredˉcolon.Nextˉcolumn,
                        Symbols.Records, Symbols.Enums, false
                    );
                if Build.Nextˉslot >= 4096u32 {
                    return Compilerˉsourceˉbindingsˉbuildˉfailure(
                        Build, Compilerˉsourceˉbindingˉstatus.Bindingˉlimit,
                        Module, Nominal.Module, Function,
                        Case.Bindingˉoffset, Line, Column
                    );
                }
                let Entry: bytes = Compilerˉsourceˉbindingsˉentry(
                    Module, Function, Compilerˉsourceˉbindingˉkind.Let,
                    Build.Nextˉslot,
                    Case.Bindingˉoffset, Case.Bindingˉlength,
                    Compilerˉsourceˉbindingsˉshape(Declaredˉtype),
                    Case.Blockˉoffset,
                    Case.Blockˉoffset + Case.Blockˉlength
                );
                return Compilerˉsourceˉbindingsˉappend(Build, Entry, false);
            }

            return Compilerˉsourceˉbindingsˉcollectˉmatchˉfields(
                Input, Scan, Symbols, Module, Function, Source, Case,
                Nominal, View, Fields, Fieldsˉoffset,
                Fieldsˉline, Fieldsˉcolumn, Patternˉstart, Build
            );
        }
        Cursor = End.Nextˉoffset;
        Line = End.Nextˉline;
        Column = End.Nextˉcolumn;
        Index = Index + 1u32;
    }
    return Build;
}

export fn Compilerˉsourceˉbindingsˉcollectˉforˉbinding(
    Module: u32,
    Function: u32,
    Source: bytes,
    Statement: Sourceˉbodies.Compilerˉsourceˉstatement,
    Shape: u32,
    Build: Compilerˉsourceˉbindingˉbuild
) -> Compilerˉsourceˉbindingˉbuild {
    if Compilerˉsourceˉbindingsˉpriorˉlocal(
        Source, Build.Payload, Build.Entries - Build.Nextˉslot, Build.Entries,
        Module, Function, Statement.Nameˉoffset, Statement.Nameˉlength
    ) {
        return Compilerˉsourceˉbindingsˉbuildˉfailure(
            Build, Compilerˉsourceˉbindingˉstatus.Duplicateˉlocal,
            Module, Module, Function,
            Statement.Nameˉoffset, Statement.Line, Statement.Column
        );
    }
    if Build.Nextˉslot >= 4096u32 {
        return Compilerˉsourceˉbindingsˉbuildˉfailure(
            Build, Compilerˉsourceˉbindingˉstatus.Bindingˉlimit,
            Module, Module, Function,
            Statement.Nameˉoffset, Statement.Line, Statement.Column
        );
    }
    if Bytesˉlength(Build.Payload) > 4194252u32 {
        return Compilerˉsourceˉbindingsˉbuildˉfailure(
            Build, Compilerˉsourceˉbindingˉstatus.Evidenceˉlimit,
            Module, Module, Function,
            Statement.Nameˉoffset, Statement.Line, Statement.Column
        );
    }
    let Entry: bytes = Compilerˉsourceˉbindingsˉentry(
        Module, Function, Compilerˉsourceˉbindingˉkind.Let,
        Build.Nextˉslot, Statement.Nameˉoffset, Statement.Nameˉlength,
        Shape,
        Statement.Firstˉblockˉoffset,
        Statement.Firstˉblockˉoffset + Statement.Firstˉblockˉlength
    );
    return Compilerˉsourceˉbindingsˉappend(Build, Entry, false);
}

export fn Compilerˉsourceˉbindingsˉphaseˉblock(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Module: u32,
    Function: u32,
    Source: bytes,
    Offset: u32,
    Line: u32,
    Column: u32,
    Endˉoffset: u32,
    Bindˉbody: bool,
    Phase: Compilerˉsourceˉbindingˉphase
) -> Compilerˉsourceˉbindingˉphase {
    let Start: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉbodies.Compilerˉbodyˉtoken(Source, Offset, Line, Column, Endˉoffset);
    let Isˉblock: bool = Start.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Leftˉbrace;
    var Cursor: u32 = Start.Offset;
    var Currentˉline: u32 = Start.Line;
    var Currentˉcolumn: u32 = Start.Column;
    if Isˉblock {
        Cursor = Start.Nextˉoffset;
        Currentˉline = Start.Nextˉline;
        Currentˉcolumn = Start.Nextˉcolumn;
    }
    var Result: Compilerˉsourceˉbindingˉphase = Phase;
    var Reading: bool = true;
    while Reading {
        let Current: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉbodies.Compilerˉbodyˉtoken(
            Source, Cursor, Currentˉline, Currentˉcolumn, Endˉoffset
        );
        if Isˉblock {
            if Current.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Rightˉbrace {
                Reading = false;
            }
        }
        if Reading {
            let Statement: Sourceˉbodies.Compilerˉsourceˉstatement = Sourceˉbodies.Compilerˉparseˉnextˉstatementˉvalidated(
                Source, Cursor, Currentˉline, Currentˉcolumn, Endˉoffset, 0u32
            );
            let Bindingˉfirst: u32 = Result.Entries - Result.Nextˉslot;
            let Bindingˉentries: u32 = Result.Entries;
            if Statement.Kind == Sourceˉbodies.Compilerˉsourceˉstatementˉkind.Local {
                if Bindˉbody {
                    let Localˉexpressionˉposition: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
                        Source, Statement.Offset, Statement.Line, Statement.Column,
                        Statement.Expressionˉoffset
                    );
                    let Localˉbody: Compilerˉsourceˉbindingˉbody = Compilerˉsourceˉbindingsˉbindˉexpression(
                        Input, Scan, Symbols, Result.Payload, Bindingˉfirst, Bindingˉentries,
                        Module, Function, Source,
                        Statement.Expressionˉoffset,
                        Localˉexpressionˉposition.Line,
                        Localˉexpressionˉposition.Column,
                        Statement.Expressionˉoffset + Statement.Expressionˉlength
                    );
                    Result = Compilerˉsourceˉbindingsˉphaseˉbody(Result, Localˉbody);
                    if Result.Bodyˉstatus != Compilerˉsourceˉbindingˉstatus.Valid { return Result; }
                }
                let Localˉbuild: Compilerˉsourceˉbindingˉbuild = Compilerˉsourceˉbindingsˉcollectˉlocal(
                    Input, Scan, Symbols, Module, Function, Source,
                    Statement, Endˉoffset, 0u32,
                    Compilerˉsourceˉbindingsˉphaseˉbuildˉvalue(Result)
                );
                Result = Compilerˉsourceˉbindingsˉphaseˉbuild(Result, Localˉbuild);
                if Result.Buildˉstatus != Compilerˉsourceˉbindingˉstatus.Valid { return Result; }
            }
            if Statement.Kind == Sourceˉbodies.Compilerˉsourceˉstatementˉkind.Assignment {
                if Bindˉbody {
                    let Assignmentˉbody: Compilerˉsourceˉbindingˉbody = Compilerˉsourceˉbindingsˉbindˉassignment(
                        Symbols, Result.Payload, Bindingˉfirst, Bindingˉentries,
                        Module, Function, Source, Statement
                    );
                    Result = Compilerˉsourceˉbindingsˉphaseˉbody(Result, Assignmentˉbody);
                    if Result.Bodyˉstatus != Compilerˉsourceˉbindingˉstatus.Valid { return Result; }
                    let Assignmentˉvalueˉposition: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
                        Source, Statement.Offset, Statement.Line, Statement.Column,
                        Statement.Expressionˉoffset
                    );
                    let Assignmentˉvalue: Compilerˉsourceˉbindingˉbody = Compilerˉsourceˉbindingsˉbindˉexpression(
                        Input, Scan, Symbols, Result.Payload, Bindingˉfirst, Bindingˉentries,
                        Module, Function, Source,
                        Statement.Expressionˉoffset,
                        Assignmentˉvalueˉposition.Line,
                        Assignmentˉvalueˉposition.Column,
                        Statement.Expressionˉoffset + Statement.Expressionˉlength
                    );
                    Result = Compilerˉsourceˉbindingsˉphaseˉbody(Result, Assignmentˉvalue);
                }
            }
            if Statement.Kind == Sourceˉbodies.Compilerˉsourceˉstatementˉkind.Expression ||
                Statement.Kind == Sourceˉbodies.Compilerˉsourceˉstatementˉkind.Try {
                if Bindˉbody {
                    let Standaloneˉposition: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
                        Source, Statement.Offset, Statement.Line, Statement.Column,
                        Statement.Expressionˉoffset
                    );
                    let Standaloneˉbody: Compilerˉsourceˉbindingˉbody = Compilerˉsourceˉbindingsˉbindˉexpression(
                        Input, Scan, Symbols, Result.Payload, Bindingˉfirst, Bindingˉentries,
                        Module, Function, Source,
                        Statement.Expressionˉoffset, Standaloneˉposition.Line, Standaloneˉposition.Column,
                        Statement.Expressionˉoffset + Statement.Expressionˉlength
                    );
                    Result = Compilerˉsourceˉbindingsˉphaseˉbody(Result, Standaloneˉbody);
                }
            }
            if Statement.Kind == Sourceˉbodies.Compilerˉsourceˉstatementˉkind.Return {
                if Bindˉbody {
                    if Statement.Expressionˉlength > 0u32 {
                    let Returnˉvalueˉposition: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
                        Source, Statement.Offset, Statement.Line, Statement.Column,
                        Statement.Expressionˉoffset
                    );
                    let Returnˉbody: Compilerˉsourceˉbindingˉbody = Compilerˉsourceˉbindingsˉbindˉexpression(
                        Input, Scan, Symbols, Result.Payload, Bindingˉfirst, Bindingˉentries,
                        Module, Function, Source,
                        Statement.Expressionˉoffset,
                        Returnˉvalueˉposition.Line,
                        Returnˉvalueˉposition.Column,
                        Statement.Expressionˉoffset + Statement.Expressionˉlength
                    );
                        Result = Compilerˉsourceˉbindingsˉphaseˉbody(Result, Returnˉbody);
                    }
                }
            }
            if Result.Bodyˉstatus != Compilerˉsourceˉbindingˉstatus.Valid { return Result; }
            if Statement.Kind == Sourceˉbodies.Compilerˉsourceˉstatementˉkind.If {
                if Bindˉbody {
                    let Ifˉphaseˉconditionˉposition: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
                        Source, Statement.Offset, Statement.Line, Statement.Column,
                        Statement.Expressionˉoffset
                    );
                    let Ifˉconditionˉbody: Compilerˉsourceˉbindingˉbody = Compilerˉsourceˉbindingsˉbindˉexpression(
                        Input, Scan, Symbols, Result.Payload, Bindingˉfirst, Bindingˉentries,
                        Module, Function, Source,
                        Statement.Expressionˉoffset,
                        Ifˉphaseˉconditionˉposition.Line,
                        Ifˉphaseˉconditionˉposition.Column,
                        Statement.Expressionˉoffset + Statement.Expressionˉlength
                    );
                    Result = Compilerˉsourceˉbindingsˉphaseˉbody(Result, Ifˉconditionˉbody);
                    if Result.Bodyˉstatus != Compilerˉsourceˉbindingˉstatus.Valid { return Result; }
                }
                let Ifˉfirstˉposition: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
                    Source, Statement.Offset, Statement.Line, Statement.Column,
                    Statement.Firstˉblockˉoffset
                );
                Result = Compilerˉsourceˉbindingsˉphaseˉblock(
                    Input, Scan, Symbols, Module, Function, Source,
                    Statement.Firstˉblockˉoffset,
                    Ifˉfirstˉposition.Line,
                    Ifˉfirstˉposition.Column,
                    Statement.Firstˉblockˉoffset + Statement.Firstˉblockˉlength,
                    Bindˉbody, Result
                );
                if Result.Bodyˉstatus != Compilerˉsourceˉbindingˉstatus.Valid { return Result; }
                if Result.Buildˉstatus != Compilerˉsourceˉbindingˉstatus.Valid { return Result; }
                if Statement.Secondˉblockˉlength > 0u32 {
                    let Ifˉsecondˉposition: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
                        Source, Statement.Offset, Statement.Line, Statement.Column,
                        Statement.Secondˉblockˉoffset
                    );
                    Result = Compilerˉsourceˉbindingsˉphaseˉblock(
                        Input, Scan, Symbols, Module, Function, Source,
                        Statement.Secondˉblockˉoffset,
                        Ifˉsecondˉposition.Line,
                        Ifˉsecondˉposition.Column,
                        Statement.Secondˉblockˉoffset + Statement.Secondˉblockˉlength,
                        Bindˉbody, Result
                    );
                }
            }
            if Statement.Kind == Sourceˉbodies.Compilerˉsourceˉstatementˉkind.Match {
                if Bindˉbody {
                    let Matchˉvalueˉposition: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
                        Source, Statement.Offset, Statement.Line, Statement.Column,
                        Statement.Expressionˉoffset
                    );
                    let Matchˉvalueˉbody: Compilerˉsourceˉbindingˉbody = Compilerˉsourceˉbindingsˉbindˉexpression(
                        Input, Scan, Symbols, Result.Payload, Bindingˉfirst, Bindingˉentries,
                        Module, Function, Source,
                        Statement.Expressionˉoffset,
                        Matchˉvalueˉposition.Line,
                        Matchˉvalueˉposition.Column,
                        Statement.Expressionˉoffset + Statement.Expressionˉlength
                    );
                    Result = Compilerˉsourceˉbindingsˉphaseˉbody(Result, Matchˉvalueˉbody);
                    if Result.Bodyˉstatus != Compilerˉsourceˉbindingˉstatus.Valid { return Result; }
                }
                let Matchˉbodyˉposition: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
                    Source, Statement.Offset, Statement.Line, Statement.Column,
                    Statement.Firstˉblockˉoffset
                );
                let Matchˉbody: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉbodies.Compilerˉbodyˉtoken(
                    Source,
                    Statement.Firstˉblockˉoffset,
                    Matchˉbodyˉposition.Line,
                    Matchˉbodyˉposition.Column,
                    Statement.Firstˉblockˉoffset + Statement.Firstˉblockˉlength
                );
                var Matchˉcursor: u32 = Matchˉbody.Nextˉoffset;
                var Matchˉline: u32 = Matchˉbody.Nextˉline;
                var Matchˉcolumn: u32 = Matchˉbody.Nextˉcolumn;
                var Matchˉcaseˉindex: u32 = 0u32;
                while Matchˉcaseˉindex < Statement.Nameˉlength {
                    let Case: Sourceˉbodies.Compilerˉsourceˉmatchˉcase = Sourceˉbodies.Compilerˉbodyˉparseˉmatchˉcase(
                        Source,
                        Matchˉcursor,
                        Matchˉline,
                        Matchˉcolumn,
                        Statement.Firstˉblockˉoffset + Statement.Firstˉblockˉlength,
                        0u32,
                        false
                    );
                    let Caseˉposition: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
                        Source,
                        Matchˉcursor,
                        Matchˉline,
                        Matchˉcolumn,
                        Case.Blockˉoffset
                    );
                    let Caseˉbinding: Compilerˉsourceˉbindingˉbuild = Compilerˉsourceˉbindingsˉcollectˉmatchˉbinding(
                        Input, Scan, Symbols, Module, Function, Source, Case,
                        Compilerˉsourceˉbindingsˉphaseˉbuildˉvalue(Result)
                    );
                    Result = Compilerˉsourceˉbindingsˉphaseˉbuild(Result, Caseˉbinding);
                    if Result.Buildˉstatus != Compilerˉsourceˉbindingˉstatus.Valid { return Result; }
                    Result = Compilerˉsourceˉbindingsˉphaseˉblock(
                        Input, Scan, Symbols, Module, Function, Source,
                        Case.Blockˉoffset,
                        Caseˉposition.Line,
                        Caseˉposition.Column,
                        Case.Blockˉoffset + Case.Blockˉlength,
                        Bindˉbody,
                        Result
                    );
                    if Result.Bodyˉstatus != Compilerˉsourceˉbindingˉstatus.Valid { return Result; }
                    if Result.Buildˉstatus != Compilerˉsourceˉbindingˉstatus.Valid { return Result; }
                    Matchˉcursor = Case.Nextˉoffset;
                    Matchˉline = Case.Nextˉline;
                    Matchˉcolumn = Case.Nextˉcolumn;
                    Matchˉcaseˉindex = Matchˉcaseˉindex + 1u32;
                }
            }
            if Statement.Kind == Sourceˉbodies.Compilerˉsourceˉstatementˉkind.Push {
                if Bindˉbody {
                    let Collectionˉpushˉnameˉposition: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
                        Source, Statement.Offset, Statement.Line, Statement.Column, Statement.Nameˉoffset
                    );
                    let Collectionˉpushˉbuilder: Compilerˉsourceˉbindingˉbody = Compilerˉsourceˉbindingsˉbindˉname(
                        Input, Scan, Symbols, Result.Payload, Bindingˉfirst, Bindingˉentries,
                        Module, Function, Source,
                        Statement.Nameˉoffset, Statement.Nameˉlength, Statement.Offset,
                        Collectionˉpushˉnameˉposition.Line, Collectionˉpushˉnameˉposition.Column
                    );
                    Result = Compilerˉsourceˉbindingsˉphaseˉbody(Result, Collectionˉpushˉbuilder);
                    if Result.Bodyˉstatus != Compilerˉsourceˉbindingˉstatus.Valid { return Result; }
                    let Collectionˉpushˉvalueˉposition: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
                        Source, Statement.Offset, Statement.Line, Statement.Column, Statement.Expressionˉoffset
                    );
                    let Collectionˉpushˉvalue: Compilerˉsourceˉbindingˉbody = Compilerˉsourceˉbindingsˉbindˉexpression(
                        Input, Scan, Symbols, Result.Payload, Bindingˉfirst, Bindingˉentries,
                        Module, Function, Source,
                        Statement.Expressionˉoffset,
                        Collectionˉpushˉvalueˉposition.Line,
                        Collectionˉpushˉvalueˉposition.Column,
                        Statement.Expressionˉoffset + Statement.Expressionˉlength
                    );
                    Result = Compilerˉsourceˉbindingsˉphaseˉbody(Result, Collectionˉpushˉvalue);
                    if Result.Bodyˉstatus != Compilerˉsourceˉbindingˉstatus.Valid { return Result; }
                }
            }
            if Statement.Kind == Sourceˉbodies.Compilerˉsourceˉstatementˉkind.For {
                if Bindˉbody {
                    let Collectionˉforˉsequenceˉposition: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
                        Source, Statement.Offset, Statement.Line, Statement.Column, Statement.Expressionˉoffset
                    );
                    let Collectionˉforˉsequence: Compilerˉsourceˉbindingˉbody = Compilerˉsourceˉbindingsˉbindˉexpression(
                        Input, Scan, Symbols, Result.Payload, Bindingˉfirst, Bindingˉentries,
                        Module, Function, Source,
                        Statement.Expressionˉoffset,
                        Collectionˉforˉsequenceˉposition.Line,
                        Collectionˉforˉsequenceˉposition.Column,
                        Statement.Expressionˉoffset + Statement.Expressionˉlength
                    );
                    Result = Compilerˉsourceˉbindingsˉphaseˉbody(Result, Collectionˉforˉsequence);
                    if Result.Bodyˉstatus != Compilerˉsourceˉbindingˉstatus.Valid { return Result; }
                }
                Result = Compilerˉsourceˉbindingsˉphaseˉbuild(
                    Result,
                    Compilerˉsourceˉbindingsˉcollectˉforˉbinding(
                        Module, Function, Source, Statement, 0u32,
                        Compilerˉsourceˉbindingsˉphaseˉbuildˉvalue(Result)
                    )
                );
                if Result.Buildˉstatus != Compilerˉsourceˉbindingˉstatus.Valid { return Result; }
                let Collectionˉforˉbodyˉposition: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
                    Source, Statement.Offset, Statement.Line, Statement.Column, Statement.Firstˉblockˉoffset
                );
                Result = Compilerˉsourceˉbindingsˉphaseˉblock(
                    Input, Scan, Symbols, Module, Function, Source,
                    Statement.Firstˉblockˉoffset,
                    Collectionˉforˉbodyˉposition.Line,
                    Collectionˉforˉbodyˉposition.Column,
                    Statement.Firstˉblockˉoffset + Statement.Firstˉblockˉlength,
                    Bindˉbody, Result
                );
            }
            if Statement.Kind == Sourceˉbodies.Compilerˉsourceˉstatementˉkind.While {
                if Bindˉbody {
                    let Whileˉphaseˉconditionˉposition: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
                        Source, Statement.Offset, Statement.Line, Statement.Column,
                        Statement.Expressionˉoffset
                    );
                    let Whileˉconditionˉbody: Compilerˉsourceˉbindingˉbody = Compilerˉsourceˉbindingsˉbindˉexpression(
                        Input, Scan, Symbols, Result.Payload, Bindingˉfirst, Bindingˉentries,
                        Module, Function, Source,
                        Statement.Expressionˉoffset,
                        Whileˉphaseˉconditionˉposition.Line,
                        Whileˉphaseˉconditionˉposition.Column,
                        Statement.Expressionˉoffset + Statement.Expressionˉlength
                    );
                    Result = Compilerˉsourceˉbindingsˉphaseˉbody(Result, Whileˉconditionˉbody);
                    if Result.Bodyˉstatus != Compilerˉsourceˉbindingˉstatus.Valid { return Result; }
                }
                let Whileˉphaseˉbodyˉposition: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
                    Source, Statement.Offset, Statement.Line, Statement.Column,
                    Statement.Firstˉblockˉoffset
                );
                Result = Compilerˉsourceˉbindingsˉphaseˉblock(
                    Input, Scan, Symbols, Module, Function, Source,
                    Statement.Firstˉblockˉoffset,
                    Whileˉphaseˉbodyˉposition.Line,
                    Whileˉphaseˉbodyˉposition.Column,
                    Statement.Firstˉblockˉoffset + Statement.Firstˉblockˉlength,
                    Bindˉbody, Result
                );
            }
            if Statement.Kind == Sourceˉbodies.Compilerˉsourceˉstatementˉkind.Block {
                let Nestedˉposition: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
                    Source, Statement.Offset, Statement.Line, Statement.Column,
                    Statement.Firstˉblockˉoffset
                );
                Result = Compilerˉsourceˉbindingsˉphaseˉblock(
                    Input, Scan, Symbols, Module, Function, Source,
                    Statement.Firstˉblockˉoffset,
                    Nestedˉposition.Line,
                    Nestedˉposition.Column,
                    Statement.Firstˉblockˉoffset + Statement.Firstˉblockˉlength,
                    Bindˉbody, Result
                );
            }
            if Result.Bodyˉstatus != Compilerˉsourceˉbindingˉstatus.Valid { return Result; }
            if Result.Buildˉstatus != Compilerˉsourceˉbindingˉstatus.Valid { return Result; }
            Cursor = Statement.Nextˉoffset;
            Currentˉline = Statement.Nextˉline;
            Currentˉcolumn = Statement.Nextˉcolumn;
            if !Isˉblock { Reading = false; }
        }
    }
    return Result;
}

export fn Compilerˉsourceˉbindingsˉphaseˉparameters(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Module: u32,
    Function: u32,
    Source: bytes,
    Declaration: Sourceˉdeclarations.Compilerˉsourceˉdeclaration,
    Declarationˉline: u32,
    Declarationˉcolumn: u32,
    Phase: Compilerˉsourceˉbindingˉphase
) -> Compilerˉsourceˉbindingˉphase {
    var Result: Compilerˉsourceˉbindingˉphase = Compilerˉsourceˉbindingsˉphaseˉbuild(
        Phase,
        Compilerˉsourceˉbindingsˉbuildˉresetˉslots(
            Compilerˉsourceˉbindingsˉphaseˉbuildˉvalue(Phase)
        )
    );
    let First: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
        Source, Declaration.Declarationˉoffset, Declarationˉline, Declarationˉcolumn
    );
    var Functionˉtoken: Sourceˉlexer.Compilerˉsourceˉtoken = First;
    if First.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Export {
        Functionˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Source, First.Nextˉoffset, First.Nextˉline, First.Nextˉcolumn
        );
    }
    let Name: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
        Source, Functionˉtoken.Nextˉoffset, Functionˉtoken.Nextˉline, Functionˉtoken.Nextˉcolumn
    );
    let Left: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
        Source, Name.Nextˉoffset, Name.Nextˉline, Name.Nextˉcolumn
    );
    var Cursor: u32 = Left.Nextˉoffset;
    var Currentˉline: u32 = Left.Nextˉline;
    var Currentˉcolumn: u32 = Left.Nextˉcolumn;
    var Index: u32 = 0u32;
    while Index < Declaration.Items {
        let Parameter: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Source, Cursor, Currentˉline, Currentˉcolumn
        );
        let Colon: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Source, Parameter.Nextˉoffset, Parameter.Nextˉline, Parameter.Nextˉcolumn
        );
        let Type: Sourceˉdeclarations.Compilerˉparseˉstep = Sourceˉdeclarations.Compilerˉparseˉtype(
            Source,
            Colon.Nextˉoffset,
            Colon.Nextˉline,
            Colon.Nextˉcolumn,
            false,
            false
        );
        var Parameterˉshape: u32 = Compilerˉsourceˉbindingsˉsourceˉshape(Type.Typeˉkind);
        if Type.Typeˉkind == Sourceˉdeclarations.Compilerˉsourceˉtypeˉkind.Named || Type.Typeˉkind == Sourceˉdeclarations.Compilerˉsourceˉtypeˉkind.Sequence || Type.Typeˉkind == Sourceˉdeclarations.Compilerˉsourceˉtypeˉkind.Builder {
            let Parameterˉbinding: Sourceˉsymbols.Compilerˉsourceˉtypeˉbinding = Sourceˉsymbols.Compilerˉsourceˉsymbolsˉbindˉtype(
                Input, Scan, Symbols.Directory, Symbols.Lookup, Symbols.Visibility, Module, Source,
                Colon.Nextˉoffset, Colon.Nextˉline, Colon.Nextˉcolumn,
                Symbols.Records, Symbols.Enums, false
            );
            Parameterˉshape = Compilerˉsourceˉbindingsˉshape(Parameterˉbinding);
        }
        if Result.Nextˉslot >= 4096u32 {
            let Bindingˉlimited: Compilerˉsourceˉbindingˉbuild = Compilerˉsourceˉbindingsˉbuildˉfailure(
                Compilerˉsourceˉbindingsˉphaseˉbuildˉvalue(Result),
                Compilerˉsourceˉbindingˉstatus.Bindingˉlimit,
                Module, Module, Function,
                Parameter.Offset, Parameter.Line, Parameter.Column
            );
            return Compilerˉsourceˉbindingsˉphaseˉbuild(Result, Bindingˉlimited);
        }
        if Bytesˉlength(Result.Payload) > 4194252u32 {
            let Evidenceˉlimited: Compilerˉsourceˉbindingˉbuild = Compilerˉsourceˉbindingsˉbuildˉfailure(
                Compilerˉsourceˉbindingsˉphaseˉbuildˉvalue(Result),
                Compilerˉsourceˉbindingˉstatus.Evidenceˉlimit,
                Module, Module, Function,
                Parameter.Offset, Parameter.Line, Parameter.Column
            );
            return Compilerˉsourceˉbindingsˉphaseˉbuild(Result, Evidenceˉlimited);
        }
        let Entry: bytes = Compilerˉsourceˉbindingsˉentry(
            Module, Function, Compilerˉsourceˉbindingˉkind.Parameter,
            Result.Nextˉslot,
            Parameter.Offset, Parameter.Length, Parameterˉshape,
            Declaration.Bodyˉoffset,
            Declaration.Bodyˉoffset + Declaration.Bodyˉlength
        );
        Result = Compilerˉsourceˉbindingsˉphaseˉbuild(
            Result,
            Compilerˉsourceˉbindingsˉappend(
                Compilerˉsourceˉbindingsˉphaseˉbuildˉvalue(Result), Entry, true
            )
        );
        let Separator: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Source, Type.Nextˉoffset, Type.Nextˉline, Type.Nextˉcolumn
        );
        if Separator.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Comma {
            Cursor = Separator.Nextˉoffset;
            Currentˉline = Separator.Nextˉline;
            Currentˉcolumn = Separator.Nextˉcolumn;
        } else {
            Cursor = Separator.Offset;
            Currentˉline = Separator.Line;
            Currentˉcolumn = Separator.Column;
        }
        Index = Index + 1u32;
    }
    return Result;
}

export fn Compilerˉsourceˉbindingsˉphaseˉfunction(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Module: u32,
    Function: u32,
    Source: bytes,
    Declaration: Sourceˉdeclarations.Compilerˉsourceˉdeclaration,
    Declarationˉline: u32,
    Declarationˉcolumn: u32,
    Bindˉbody: bool,
    Phase: Compilerˉsourceˉbindingˉphase
) -> Compilerˉsourceˉbindingˉphase {
    let Result: Compilerˉsourceˉbindingˉphase =
        Compilerˉsourceˉbindingsˉphaseˉparameters(
            Input, Scan, Symbols, Module, Function, Source,
            Declaration, Declarationˉline, Declarationˉcolumn, Phase
        );
    if Result.Buildˉstatus != Compilerˉsourceˉbindingˉstatus.Valid {
        return Result;
    }
    let Bodyˉposition: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
        Source, Declaration.Declarationˉoffset, Declarationˉline, Declarationˉcolumn,
        Declaration.Bodyˉoffset
    );
    return Compilerˉsourceˉbindingsˉphaseˉblock(
        Input, Scan, Symbols, Module, Function, Source,
        Declaration.Bodyˉoffset, Bodyˉposition.Line, Bodyˉposition.Column,
        Declaration.Bodyˉoffset + Declaration.Bodyˉlength,
        Bindˉbody, Result
    );
}

export fn Compilerˉsourceˉbindingsˉphaseˉwithˉbody(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Bindˉbody: bool
) -> Compilerˉsourceˉbindingˉphase {
    var Phase: Compilerˉsourceˉbindingˉphase = Compilerˉsourceˉbindingsˉphaseˉempty(Input);
    var Module: u32 = 0u32;
    while Module < Scan.Modules {
        let View: Sourceˉset.Compilerˉsourceˉsetˉview = Sourceˉset.Compilerˉsourceˉsetˉmodule(Input, Scan, Module);
        let Header: Sourceˉdeclarations.Compilerˉsourceˉheader = Sourceˉdeclarations.Compilerˉparseˉheaderˉvalidated(View.Source);
        var Cursor: u32 = Header.Nextˉoffset;
        var Currentˉline: u32 = Header.Nextˉline;
        var Currentˉcolumn: u32 = Header.Nextˉcolumn;
        var Sawˉnonˉimport: bool = false;
        var Reading: bool = true;
        while Reading {
            let Declaration: Sourceˉdeclarations.Compilerˉsourceˉdeclaration = Sourceˉdeclarations.Compilerˉparseˉnextˉdeclarationˉvalidated(
                View.Source, Cursor, Currentˉline, Currentˉcolumn, Sawˉnonˉimport
            );
            if Declaration.Kind == Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.End {
                Reading = false;
            } else {
                if Declaration.Kind == Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Function {
                    let Position: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
                        View.Source, Cursor, Currentˉline, Currentˉcolumn,
                        Declaration.Declarationˉoffset
                    );
                    let Function: u32 = Compilerˉsourceˉbindingsˉfunctionˉentry(
                        Symbols.Directory, Module, Declaration.Declarationˉoffset
                    );
                    let Localˉphase: Compilerˉsourceˉbindingˉphase = Compilerˉsourceˉbindingsˉphaseˉfunction(
                        Input, Scan, Symbols, Module, Function, View.Source,
                        Declaration, Position.Line, Position.Column, Bindˉbody,
                        Compilerˉsourceˉbindingsˉphaseˉempty(Input)
                    );
                    if Localˉphase.Buildˉstatus != Compilerˉsourceˉbindingˉstatus.Valid {
                        return Localˉphase;
                    }
                    if Localˉphase.Bodyˉstatus != Compilerˉsourceˉbindingˉstatus.Valid {
                        return Localˉphase;
                    }
                    Phase = Compilerˉsourceˉbindingsˉphaseˉmerge(Phase, Localˉphase);
                }
                if Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉclosesˉimports(Declaration) {
                    Sawˉnonˉimport = true;
                }
                Cursor = Declaration.Nextˉoffset;
                Currentˉline = Declaration.Nextˉline;
                Currentˉcolumn = Declaration.Nextˉcolumn;
            }
        }
        Module = Module + 1u32;
    }
    return Phase;
}

export fn Compilerˉsourceˉbindingsˉphase(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary
) -> Compilerˉsourceˉbindingˉphase {
    return Compilerˉsourceˉbindingsˉphaseˉwithˉbody(Input, Scan, Symbols, true);
}

export fn Compilerˉsourceˉbindingsˉlocalˉphase(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary
) -> Compilerˉsourceˉbindingˉphase {
    return Compilerˉsourceˉbindingsˉphaseˉwithˉbody(Input, Scan, Symbols, false);
}

export fn Compilerˉsourceˉbindingsˉsummaryˉfromˉsymbols(
    Input: bytes,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary
) -> Compilerˉsourceˉbindingˉsummary {
    return Compilerˉsourceˉbindingˉsummary(
        Compilerˉsourceˉbindingˉstatus.Sourceˉsymbols,
        Symbols.Status,
        Symbols.Modules,
        Symbols.Functions,
        Symbols.Parameters,
        0u32,
        0u32,
        0u32,
        0u32,
        Compilerˉsourceˉbindingsˉempty(Input),
        Symbols.Failureˉmodule,
        Symbols.Failureˉrelatedˉmodule,
        Symbols.Functions,
        Symbols.Failureˉoffset,
        Symbols.Failureˉline,
        Symbols.Failureˉcolumn
    );
}

export fn Compilerˉsourceˉbindingsˉsummaryˉfromˉbuild(
    Input: bytes,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Build: Compilerˉsourceˉbindingˉbuild
) -> Compilerˉsourceˉbindingˉsummary {
    return Compilerˉsourceˉbindingˉsummary(
        Build.Status,
        Symbols.Status,
        Symbols.Modules,
        Symbols.Functions,
        Build.Parameters,
        Build.Locals,
        0u32,
        0u32,
        0u32,
        Compilerˉsourceˉbindingsˉempty(Input),
        Build.Failureˉmodule,
        Build.Failureˉrelatedˉmodule,
        Build.Failureˉfunction,
        Build.Failureˉoffset,
        Build.Failureˉline,
        Build.Failureˉcolumn
    );
}

export fn Compilerˉsourceˉbindingsˉsummaryˉfromˉbody(
    Input: bytes,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Build: Compilerˉsourceˉbindingˉbuild,
    Body: Compilerˉsourceˉbindingˉbody
) -> Compilerˉsourceˉbindingˉsummary {
    return Compilerˉsourceˉbindingˉsummary(
        Body.Status,
        Symbols.Status,
        Symbols.Modules,
        Symbols.Functions,
        Build.Parameters,
        Build.Locals,
        Body.Reads,
        Body.Assignments,
        Body.Calls,
        Compilerˉsourceˉbindingsˉempty(Input),
        Body.Failureˉmodule,
        Body.Failureˉrelatedˉmodule,
        Body.Failureˉfunction,
        Body.Failureˉoffset,
        Body.Failureˉline,
        Body.Failureˉcolumn
    );
}

export fn Compilerˉsourceˉbindingsˉsummaryˉsuccess(
    Input: bytes,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Build: Compilerˉsourceˉbindingˉbuild,
    Body: Compilerˉsourceˉbindingˉbody,
    Directory: bytes
) -> Compilerˉsourceˉbindingˉsummary {
    return Compilerˉsourceˉbindingˉsummary(
        Compilerˉsourceˉbindingˉstatus.Valid,
        Sourceˉsymbols.Compilerˉsourceˉsymbolˉstatus.Valid,
        Symbols.Modules,
        Symbols.Functions,
        Build.Parameters,
        Build.Locals,
        Body.Reads,
        Body.Assignments,
        Body.Calls,
        Directory,
        Symbols.Modules,
        Symbols.Modules,
        Bytesˉreadˉu32ˉlittle(Symbols.Directory, 8u32),
        Bytesˉlength(Input),
        0u32,
        0u32
    );
}

export fn Compilerˉsourceˉbindingsˉfinishˉphase(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Phase: Compilerˉsourceˉbindingˉphase
) -> Compilerˉsourceˉbindingˉsummary {
    let Build: Compilerˉsourceˉbindingˉbuild = Compilerˉsourceˉbindingsˉphaseˉbuildˉvalue(Phase);
    let Body: Compilerˉsourceˉbindingˉbody = Compilerˉsourceˉbindingsˉphaseˉbodyˉvalue(Phase);
    if Build.Status != Compilerˉsourceˉbindingˉstatus.Valid {
        return Compilerˉsourceˉbindingsˉsummaryˉfromˉbuild(Input, Symbols, Build);
    }
    if Body.Status != Compilerˉsourceˉbindingˉstatus.Valid {
        return Compilerˉsourceˉbindingsˉsummaryˉfromˉbody(Input, Symbols, Build, Body);
    }
    let Symbolˉentries: u32 = Bytesˉreadˉu32ˉlittle(Symbols.Directory, 8u32);
    let Directoryˉoverhead: u32 = 24u32 + Symbolˉentries * 8u32;
    if Bytesˉlength(Build.Payload) > 4194304u32 - Directoryˉoverhead {
        let Tooˉlarge: Compilerˉsourceˉbindingˉbuild = Compilerˉsourceˉbindingsˉbuildˉfailure(
            Build,
            Compilerˉsourceˉbindingˉstatus.Evidenceˉlimit,
            Symbols.Modules,
            Symbols.Modules,
            Symbols.Functions,
            Bytesˉlength(Input),
            0u32,
            0u32
        );
        return Compilerˉsourceˉbindingsˉsummaryˉfromˉbuild(Input, Symbols, Tooˉlarge);
    }
    let Directory: bytes = Compilerˉsourceˉbindingsˉdirectory(Symbols, Build);
    if !Compilerˉsourceˉbindingsˉdirectoryˉisˉvalid(Input, Scan, Symbols, Directory) {
        let Invalid: Compilerˉsourceˉbindingˉbuild = Compilerˉsourceˉbindingsˉbuildˉfailure(
            Build,
            Compilerˉsourceˉbindingˉstatus.Invalidˉdirectory,
            Symbols.Modules,
            Symbols.Modules,
            Symbols.Functions,
            Bytesˉlength(Input),
            0u32,
            0u32
        );
        return Compilerˉsourceˉbindingsˉsummaryˉfromˉbuild(Input, Symbols, Invalid);
    }
    return Compilerˉsourceˉbindingsˉsummaryˉsuccess(
        Input, Symbols, Build, Body, Directory
    );
}

export fn Compilerˉsourceˉbindingsˉfromˉsymbolsˉwithˉbody(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Bindˉbody: bool
) -> Compilerˉsourceˉbindingˉsummary {
    return Compilerˉsourceˉbindingsˉfinishˉphase(
        Input, Scan, Symbols,
        Compilerˉsourceˉbindingsˉphaseˉwithˉbody(
            Input, Scan, Symbols, Bindˉbody
        )
    );
}

export fn Compilerˉsourceˉbindingsˉfromˉsymbols(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary
) -> Compilerˉsourceˉbindingˉsummary {
    return Compilerˉsourceˉbindingsˉfromˉsymbolsˉwithˉbody(
        Input, Scan, Symbols, true
    );
}

export fn Compilerˉsourceˉbindingsˉlocalsˉfromˉsymbols(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary
) -> Compilerˉsourceˉbindingˉsummary {
    return Compilerˉsourceˉbindingsˉfromˉsymbolsˉwithˉbody(
        Input, Scan, Symbols, false
    );
}

export fn Compilerˉvalidateˉsourceˉbindings(Input: bytes) -> Compilerˉsourceˉbindingˉsummary {
    let Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary = Sourceˉsymbols.Compilerˉvalidateˉsourceˉsymbols(Input);
    if Symbols.Status != Sourceˉsymbols.Compilerˉsourceˉsymbolˉstatus.Valid {
        return Compilerˉsourceˉbindingsˉsummaryˉfromˉsymbols(Input, Symbols);
    }
    let Scan: Sourceˉset.Compilerˉsourceˉsetˉscan = Sourceˉset.Compilerˉscanˉsourceˉset(Input);
    return Compilerˉsourceˉbindingsˉfromˉsymbols(Input, Scan, Symbols);
}
