export fn Compilerˉbodyˉparseˉlocalˉstatement(
    Input: bytes,
    Start: Compilerˉsourceˉtoken,
    Endˉoffset: u32
) -> Compilerˉsourceˉstatement {
    let Name: Compilerˉsourceˉtoken = Compilerˉbodyˉtoken(Input, Start.Nextˉoffset, Start.Nextˉline, Start.Nextˉcolumn, Endˉoffset);
    let Afterˉname: Compilerˉbodyˉparseˉstep = Compilerˉbodyˉconsume(Input, Start.Nextˉoffset, Start.Nextˉline, Start.Nextˉcolumn, Endˉoffset, Compilerˉtokenˉkind.Identifier);
    if Afterˉname.Status != Compilerˉbodyˉparseˉstatus.Valid { return Compilerˉbodyˉstatementˉfailure(Afterˉname, Compilerˉsourceˉstatementˉkind.Local, Start); }
    let Afterˉcolon: Compilerˉbodyˉparseˉstep = Compilerˉbodyˉconsume(Input, Afterˉname.Nextˉoffset, Afterˉname.Nextˉline, Afterˉname.Nextˉcolumn, Endˉoffset, Compilerˉtokenˉkind.Colon);
    if Afterˉcolon.Status != Compilerˉbodyˉparseˉstatus.Valid { return Compilerˉbodyˉstatementˉfailure(Afterˉcolon, Compilerˉsourceˉstatementˉkind.Local, Start); }
    let Typeˉstart: Compilerˉsourceˉtoken = Compilerˉbodyˉtoken(Input, Afterˉcolon.Nextˉoffset, Afterˉcolon.Nextˉline, Afterˉcolon.Nextˉcolumn, Endˉoffset);
    let Type: Compilerˉparseˉstep = Compilerˉparseˉtype(Input, Afterˉcolon.Nextˉoffset, Afterˉcolon.Nextˉline, Afterˉcolon.Nextˉcolumn, false, false);
    if Type.Status != Compilerˉparseˉstatus.Valid { return Compilerˉbodyˉstatementˉfailure(Compilerˉbodyˉstepˉfromˉdeclarationˉstep(Type), Compilerˉsourceˉstatementˉkind.Local, Start); }
    if Type.Nextˉoffset > Endˉoffset {
        let Invalidˉtype: Compilerˉbodyˉparseˉstep = Compilerˉbodyˉstepˉfromˉtoken(Compilerˉbodyˉparseˉstatus.Invalidˉspan, Typeˉstart, Compilerˉtokenˉkind.Equals);
        return Compilerˉbodyˉstatementˉfailure(Invalidˉtype, Compilerˉsourceˉstatementˉkind.Local, Start);
    }
    let Afterˉequals: Compilerˉbodyˉparseˉstep = Compilerˉbodyˉconsume(Input, Type.Nextˉoffset, Type.Nextˉline, Type.Nextˉcolumn, Endˉoffset, Compilerˉtokenˉkind.Equals);
    if Afterˉequals.Status != Compilerˉbodyˉparseˉstatus.Valid { return Compilerˉbodyˉstatementˉfailure(Afterˉequals, Compilerˉsourceˉstatementˉkind.Local, Start); }
    let Initializer: Compilerˉsourceˉexpression = Compilerˉparseˉexpressionˉvalidated(Input, Afterˉequals.Nextˉoffset, Afterˉequals.Nextˉline, Afterˉequals.Nextˉcolumn, Endˉoffset, 0u32, 0u32);
    if Initializer.Status != Compilerˉbodyˉparseˉstatus.Valid { return Compilerˉbodyˉstatementˉfailure(Compilerˉbodyˉstepˉfromˉexpression(Initializer), Compilerˉsourceˉstatementˉkind.Local, Start); }
    let Semicolon: Compilerˉbodyˉparseˉstep = Compilerˉbodyˉconsume(Input, Initializer.Nextˉoffset, Initializer.Nextˉline, Initializer.Nextˉcolumn, Endˉoffset, Compilerˉtokenˉkind.Semicolon);
    if Semicolon.Status != Compilerˉbodyˉparseˉstatus.Valid { return Compilerˉbodyˉstatementˉfailure(Semicolon, Compilerˉsourceˉstatementˉkind.Local, Start); }
    let Result: Compilerˉbodyˉparseˉstep = Compilerˉbodyˉstepˉvalid(Semicolon.Nextˉoffset, Semicolon.Nextˉline, Semicolon.Nextˉcolumn, 1u32, Initializer.Nodes, 1u32, Initializer.Depth);
    return Compilerˉbodyˉstatementˉmake(Compilerˉsourceˉstatementˉkind.Local, Start.Kind == Compilerˉtokenˉkind.Var, Start, Semicolon.Nextˉoffset, Name.Offset, Name.Length, Type.Typeˉkind, Typeˉstart.Offset, Type.Nextˉoffset - Typeˉstart.Offset, Initializer.Offset, Initializer.Length, Start.Offset, 0u32, Start.Offset, 0u32, Result);
}

export fn Compilerˉbodyˉparseˉassignmentˉstatement(
    Input: bytes,
    Start: Compilerˉsourceˉtoken,
    Endˉoffset: u32
) -> Compilerˉsourceˉstatement {
    let Afterˉequals: Compilerˉbodyˉparseˉstep = Compilerˉbodyˉconsume(Input, Start.Nextˉoffset, Start.Nextˉline, Start.Nextˉcolumn, Endˉoffset, Compilerˉtokenˉkind.Equals);
    if Afterˉequals.Status != Compilerˉbodyˉparseˉstatus.Valid { return Compilerˉbodyˉstatementˉfailure(Afterˉequals, Compilerˉsourceˉstatementˉkind.Assignment, Start); }
    let Value: Compilerˉsourceˉexpression = Compilerˉparseˉexpressionˉvalidated(Input, Afterˉequals.Nextˉoffset, Afterˉequals.Nextˉline, Afterˉequals.Nextˉcolumn, Endˉoffset, 0u32, 0u32);
    if Value.Status != Compilerˉbodyˉparseˉstatus.Valid { return Compilerˉbodyˉstatementˉfailure(Compilerˉbodyˉstepˉfromˉexpression(Value), Compilerˉsourceˉstatementˉkind.Assignment, Start); }
    let Semicolon: Compilerˉbodyˉparseˉstep = Compilerˉbodyˉconsume(Input, Value.Nextˉoffset, Value.Nextˉline, Value.Nextˉcolumn, Endˉoffset, Compilerˉtokenˉkind.Semicolon);
    if Semicolon.Status != Compilerˉbodyˉparseˉstatus.Valid { return Compilerˉbodyˉstatementˉfailure(Semicolon, Compilerˉsourceˉstatementˉkind.Assignment, Start); }
    let Result: Compilerˉbodyˉparseˉstep = Compilerˉbodyˉstepˉvalid(Semicolon.Nextˉoffset, Semicolon.Nextˉline, Semicolon.Nextˉcolumn, 1u32, Value.Nodes, 1u32, Value.Depth);
    return Compilerˉbodyˉstatementˉmake(Compilerˉsourceˉstatementˉkind.Assignment, false, Start, Semicolon.Nextˉoffset, Start.Offset, Start.Length, Compilerˉsourceˉtypeˉkind.Unknown, Start.Offset, 0u32, Value.Offset, Value.Length, Start.Offset, 0u32, Start.Offset, 0u32, Result);
}

export fn Compilerˉbodyˉparseˉreturnˉstatement(
    Input: bytes,
    Start: Compilerˉsourceˉtoken,
    Endˉoffset: u32
) -> Compilerˉsourceˉstatement {
    let Current: Compilerˉsourceˉtoken = Compilerˉbodyˉtoken(Input, Start.Nextˉoffset, Start.Nextˉline, Start.Nextˉcolumn, Endˉoffset);
    if Current.Kind == Compilerˉtokenˉkind.Semicolon {
        let Emptyˉend: Compilerˉbodyˉparseˉstep = Compilerˉbodyˉconsume(Input, Start.Nextˉoffset, Start.Nextˉline, Start.Nextˉcolumn, Endˉoffset, Compilerˉtokenˉkind.Semicolon);
        if Emptyˉend.Status != Compilerˉbodyˉparseˉstatus.Valid { return Compilerˉbodyˉstatementˉfailure(Emptyˉend, Compilerˉsourceˉstatementˉkind.Return, Start); }
        let Emptyˉresult: Compilerˉbodyˉparseˉstep = Compilerˉbodyˉstepˉvalid(Emptyˉend.Nextˉoffset, Emptyˉend.Nextˉline, Emptyˉend.Nextˉcolumn, 1u32, 0u32, 1u32, 0u32);
        return Compilerˉbodyˉstatementˉmake(Compilerˉsourceˉstatementˉkind.Return, false, Start, Emptyˉend.Nextˉoffset, Start.Offset, 0u32, Compilerˉsourceˉtypeˉkind.Unknown, Start.Offset, 0u32, Start.Offset, 0u32, Start.Offset, 0u32, Start.Offset, 0u32, Emptyˉresult);
    }
    let Value: Compilerˉsourceˉexpression = Compilerˉparseˉexpressionˉvalidated(Input, Start.Nextˉoffset, Start.Nextˉline, Start.Nextˉcolumn, Endˉoffset, 0u32, 0u32);
    if Value.Status != Compilerˉbodyˉparseˉstatus.Valid { return Compilerˉbodyˉstatementˉfailure(Compilerˉbodyˉstepˉfromˉexpression(Value), Compilerˉsourceˉstatementˉkind.Return, Start); }
    let Valueˉend: Compilerˉbodyˉparseˉstep = Compilerˉbodyˉconsume(Input, Value.Nextˉoffset, Value.Nextˉline, Value.Nextˉcolumn, Endˉoffset, Compilerˉtokenˉkind.Semicolon);
    if Valueˉend.Status != Compilerˉbodyˉparseˉstatus.Valid { return Compilerˉbodyˉstatementˉfailure(Valueˉend, Compilerˉsourceˉstatementˉkind.Return, Start); }
    let Valueˉresult: Compilerˉbodyˉparseˉstep = Compilerˉbodyˉstepˉvalid(Valueˉend.Nextˉoffset, Valueˉend.Nextˉline, Valueˉend.Nextˉcolumn, 1u32, Value.Nodes, 1u32, Value.Depth);
    return Compilerˉbodyˉstatementˉmake(Compilerˉsourceˉstatementˉkind.Return, false, Start, Valueˉend.Nextˉoffset, Start.Offset, 0u32, Compilerˉsourceˉtypeˉkind.Unknown, Start.Offset, 0u32, Value.Offset, Value.Length, Start.Offset, 0u32, Start.Offset, 0u32, Valueˉresult);
}

export fn Compilerˉbodyˉparseˉexpressionˉstatement(
    Input: bytes,
    Start: Compilerˉsourceˉtoken,
    Endˉoffset: u32
) -> Compilerˉsourceˉstatement {
    let Expression: Compilerˉsourceˉexpression = Compilerˉparseˉexpressionˉvalidated(Input, Start.Offset, Start.Line, Start.Column, Endˉoffset, 0u32, 0u32);
    if Expression.Status != Compilerˉbodyˉparseˉstatus.Valid { return Compilerˉbodyˉstatementˉfailure(Compilerˉbodyˉstepˉfromˉexpression(Expression), Compilerˉsourceˉstatementˉkind.Expression, Start); }
    let Semicolon: Compilerˉbodyˉparseˉstep = Compilerˉbodyˉconsume(Input, Expression.Nextˉoffset, Expression.Nextˉline, Expression.Nextˉcolumn, Endˉoffset, Compilerˉtokenˉkind.Semicolon);
    if Semicolon.Status != Compilerˉbodyˉparseˉstatus.Valid { return Compilerˉbodyˉstatementˉfailure(Semicolon, Compilerˉsourceˉstatementˉkind.Expression, Start); }
    let Result: Compilerˉbodyˉparseˉstep = Compilerˉbodyˉstepˉvalid(Semicolon.Nextˉoffset, Semicolon.Nextˉline, Semicolon.Nextˉcolumn, 1u32, Expression.Nodes, 1u32, Expression.Depth);
    return Compilerˉbodyˉstatementˉmake(Compilerˉsourceˉstatementˉkind.Expression, false, Start, Semicolon.Nextˉoffset, Start.Offset, 0u32, Compilerˉsourceˉtypeˉkind.Unknown, Start.Offset, 0u32, Expression.Offset, Expression.Length, Start.Offset, 0u32, Start.Offset, 0u32, Result);
}

export fn Compilerˉbodyˉparseˉifˉstatement(
    Input: bytes,
    Start: Compilerˉsourceˉtoken,
    Endˉoffset: u32,
    Statementˉnesting: u32
) -> Compilerˉsourceˉstatement {
    let Condition: Compilerˉsourceˉexpression = Compilerˉparseˉexpressionˉvalidated(Input, Start.Nextˉoffset, Start.Nextˉline, Start.Nextˉcolumn, Endˉoffset, 0u32, 0u32);
    if Condition.Status != Compilerˉbodyˉparseˉstatus.Valid { return Compilerˉbodyˉstatementˉfailure(Compilerˉbodyˉstepˉfromˉexpression(Condition), Compilerˉsourceˉstatementˉkind.If, Start); }
    let Thenˉstart: Compilerˉsourceˉtoken = Compilerˉbodyˉtoken(Input, Condition.Nextˉoffset, Condition.Nextˉline, Condition.Nextˉcolumn, Endˉoffset);
    let Thenˉblock: Compilerˉbodyˉparseˉstep = Compilerˉparseˉblockˉvalidated(Input, Condition.Nextˉoffset, Condition.Nextˉline, Condition.Nextˉcolumn, Endˉoffset, Statementˉnesting + 1u32);
    if Thenˉblock.Status != Compilerˉbodyˉparseˉstatus.Valid { return Compilerˉbodyˉstatementˉfailure(Thenˉblock, Compilerˉsourceˉstatementˉkind.If, Start); }
    var Cursor: u32 = Thenˉblock.Nextˉoffset;
    var Currentˉline: u32 = Thenˉblock.Nextˉline;
    var Currentˉcolumn: u32 = Thenˉblock.Nextˉcolumn;
    var End: u32 = Thenˉblock.Nextˉoffset;
    var Secondˉoffset: u32 = Start.Offset;
    var Secondˉlength: u32 = 0u32;
    var Statements: u32 = 1u32 + Thenˉblock.Statements;
    var Expressions: u32 = Condition.Nodes + Thenˉblock.Expressions;
    var Statementˉdepth: u32 = Thenˉblock.Maximumˉstatementˉdepth + 1u32;
    var Expressionˉdepth: u32 = Compilerˉbodyˉmaximum(Condition.Depth, Thenˉblock.Maximumˉexpressionˉdepth);
    let Elseˉtoken: Compilerˉsourceˉtoken = Compilerˉbodyˉtoken(Input, Cursor, Currentˉline, Currentˉcolumn, Endˉoffset);
    if Elseˉtoken.Kind == Compilerˉtokenˉkind.Else {
        let Elseˉstart: Compilerˉsourceˉtoken = Compilerˉbodyˉtoken(Input, Elseˉtoken.Nextˉoffset, Elseˉtoken.Nextˉline, Elseˉtoken.Nextˉcolumn, Endˉoffset);
        let Elseˉblock: Compilerˉbodyˉparseˉstep = Compilerˉparseˉblockˉvalidated(Input, Elseˉtoken.Nextˉoffset, Elseˉtoken.Nextˉline, Elseˉtoken.Nextˉcolumn, Endˉoffset, Statementˉnesting + 1u32);
        if Elseˉblock.Status != Compilerˉbodyˉparseˉstatus.Valid { return Compilerˉbodyˉstatementˉfailure(Elseˉblock, Compilerˉsourceˉstatementˉkind.If, Start); }
        Secondˉoffset = Elseˉstart.Offset;
        Secondˉlength = Elseˉblock.Nextˉoffset - Elseˉstart.Offset;
        Cursor = Elseˉblock.Nextˉoffset;
        Currentˉline = Elseˉblock.Nextˉline;
        Currentˉcolumn = Elseˉblock.Nextˉcolumn;
        End = Elseˉblock.Nextˉoffset;
        Statements = Statements + Elseˉblock.Statements;
        Expressions = Expressions + Elseˉblock.Expressions;
        Statementˉdepth = Compilerˉbodyˉmaximum(Statementˉdepth, Elseˉblock.Maximumˉstatementˉdepth + 1u32);
        Expressionˉdepth = Compilerˉbodyˉmaximum(Expressionˉdepth, Elseˉblock.Maximumˉexpressionˉdepth);
    }
    if Statements > 4096u32 { return Compilerˉbodyˉstatementˉfailure(Compilerˉbodyˉstepˉfromˉtoken(Compilerˉbodyˉparseˉstatus.Itemˉlimit, Start, Compilerˉtokenˉkind.Rightˉbrace), Compilerˉsourceˉstatementˉkind.If, Start); }
    let Result: Compilerˉbodyˉparseˉstep = Compilerˉbodyˉstepˉvalid(Cursor, Currentˉline, Currentˉcolumn, Statements, Expressions, Statementˉdepth, Expressionˉdepth);
    return Compilerˉbodyˉstatementˉmake(Compilerˉsourceˉstatementˉkind.If, false, Start, End, Start.Offset, 0u32, Compilerˉsourceˉtypeˉkind.Unknown, Start.Offset, 0u32, Condition.Offset, Condition.Length, Thenˉstart.Offset, Thenˉblock.Nextˉoffset - Thenˉstart.Offset, Secondˉoffset, Secondˉlength, Result);
}

export fn Compilerˉbodyˉparseˉwhileˉstatement(
    Input: bytes,
    Start: Compilerˉsourceˉtoken,
    Endˉoffset: u32,
    Statementˉnesting: u32
) -> Compilerˉsourceˉstatement {
    let Condition: Compilerˉsourceˉexpression = Compilerˉparseˉexpressionˉvalidated(Input, Start.Nextˉoffset, Start.Nextˉline, Start.Nextˉcolumn, Endˉoffset, 0u32, 0u32);
    if Condition.Status != Compilerˉbodyˉparseˉstatus.Valid { return Compilerˉbodyˉstatementˉfailure(Compilerˉbodyˉstepˉfromˉexpression(Condition), Compilerˉsourceˉstatementˉkind.While, Start); }
    let Bodyˉstart: Compilerˉsourceˉtoken = Compilerˉbodyˉtoken(Input, Condition.Nextˉoffset, Condition.Nextˉline, Condition.Nextˉcolumn, Endˉoffset);
    let Body: Compilerˉbodyˉparseˉstep = Compilerˉparseˉblockˉvalidated(Input, Condition.Nextˉoffset, Condition.Nextˉline, Condition.Nextˉcolumn, Endˉoffset, Statementˉnesting + 1u32);
    if Body.Status != Compilerˉbodyˉparseˉstatus.Valid { return Compilerˉbodyˉstatementˉfailure(Body, Compilerˉsourceˉstatementˉkind.While, Start); }
    let Statements: u32 = 1u32 + Body.Statements;
    if Statements > 4096u32 { return Compilerˉbodyˉstatementˉfailure(Compilerˉbodyˉstepˉfromˉtoken(Compilerˉbodyˉparseˉstatus.Itemˉlimit, Start, Compilerˉtokenˉkind.Rightˉbrace), Compilerˉsourceˉstatementˉkind.While, Start); }
    let Result: Compilerˉbodyˉparseˉstep = Compilerˉbodyˉstepˉvalid(Body.Nextˉoffset, Body.Nextˉline, Body.Nextˉcolumn, Statements, Condition.Nodes + Body.Expressions, Body.Maximumˉstatementˉdepth + 1u32, Compilerˉbodyˉmaximum(Condition.Depth, Body.Maximumˉexpressionˉdepth));
    return Compilerˉbodyˉstatementˉmake(Compilerˉsourceˉstatementˉkind.While, false, Start, Body.Nextˉoffset, Start.Offset, 0u32, Compilerˉsourceˉtypeˉkind.Unknown, Start.Offset, 0u32, Condition.Offset, Condition.Length, Bodyˉstart.Offset, Body.Nextˉoffset - Bodyˉstart.Offset, Start.Offset, 0u32, Result);
}

export fn Compilerˉbodyˉparseˉblockˉstatement(
    Input: bytes,
    Start: Compilerˉsourceˉtoken,
    Endˉoffset: u32,
    Statementˉnesting: u32
) -> Compilerˉsourceˉstatement {
    let Body: Compilerˉbodyˉparseˉstep = Compilerˉparseˉblockˉvalidated(Input, Start.Offset, Start.Line, Start.Column, Endˉoffset, Statementˉnesting + 1u32);
    if Body.Status != Compilerˉbodyˉparseˉstatus.Valid { return Compilerˉbodyˉstatementˉfailure(Body, Compilerˉsourceˉstatementˉkind.Block, Start); }
    let Statements: u32 = Body.Statements + 1u32;
    if Statements > 4096u32 { return Compilerˉbodyˉstatementˉfailure(Compilerˉbodyˉstepˉfromˉtoken(Compilerˉbodyˉparseˉstatus.Itemˉlimit, Start, Compilerˉtokenˉkind.Rightˉbrace), Compilerˉsourceˉstatementˉkind.Block, Start); }
    let Result: Compilerˉbodyˉparseˉstep = Compilerˉbodyˉstepˉvalid(Body.Nextˉoffset, Body.Nextˉline, Body.Nextˉcolumn, Statements, Body.Expressions, Body.Maximumˉstatementˉdepth + 1u32, Body.Maximumˉexpressionˉdepth);
    return Compilerˉbodyˉstatementˉmake(Compilerˉsourceˉstatementˉkind.Block, false, Start, Body.Nextˉoffset, Start.Offset, 0u32, Compilerˉsourceˉtypeˉkind.Unknown, Start.Offset, 0u32, Start.Offset, 0u32, Start.Offset, Body.Nextˉoffset - Start.Offset, Start.Offset, 0u32, Result);
}

export fn Compilerˉparseˉnextˉstatementˉvalidated(
    Input: bytes,
    Offset: u32,
    Line: u32,
    Column: u32,
    Endˉoffset: u32,
    Statementˉnesting: u32
) -> Compilerˉsourceˉstatement {
    let Start: Compilerˉsourceˉtoken = Compilerˉbodyˉtoken(Input, Offset, Line, Column, Endˉoffset);
    if Start.Status != Compilerˉlexˉstatus.Valid { return Compilerˉbodyˉstatementˉfailure(Compilerˉbodyˉstepˉfromˉtoken(Compilerˉbodyˉparseˉstatus.Lexicalˉerror, Start, Compilerˉtokenˉkind.Identifier), Compilerˉsourceˉstatementˉkind.End, Start); }
    if Statementˉnesting > 64u32 { return Compilerˉbodyˉstatementˉfailure(Compilerˉbodyˉstepˉfromˉtoken(Compilerˉbodyˉparseˉstatus.Nestingˉlimit, Start, Compilerˉtokenˉkind.Rightˉbrace), Compilerˉsourceˉstatementˉkind.End, Start); }
    if Start.Kind == Compilerˉtokenˉkind.Let { return Compilerˉbodyˉparseˉlocalˉstatement(Input, Start, Endˉoffset); }
    if Start.Kind == Compilerˉtokenˉkind.Var { return Compilerˉbodyˉparseˉlocalˉstatement(Input, Start, Endˉoffset); }
    if Start.Kind == Compilerˉtokenˉkind.If { return Compilerˉbodyˉparseˉifˉstatement(Input, Start, Endˉoffset, Statementˉnesting); }
    if Start.Kind == Compilerˉtokenˉkind.While { return Compilerˉbodyˉparseˉwhileˉstatement(Input, Start, Endˉoffset, Statementˉnesting); }
    if Start.Kind == Compilerˉtokenˉkind.Return { return Compilerˉbodyˉparseˉreturnˉstatement(Input, Start, Endˉoffset); }
    if Start.Kind == Compilerˉtokenˉkind.Leftˉbrace { return Compilerˉbodyˉparseˉblockˉstatement(Input, Start, Endˉoffset, Statementˉnesting); }
    if Start.Kind == Compilerˉtokenˉkind.Identifier {
        let Lookahead: Compilerˉsourceˉtoken = Compilerˉbodyˉtoken(Input, Start.Nextˉoffset, Start.Nextˉline, Start.Nextˉcolumn, Endˉoffset);
        if Lookahead.Kind == Compilerˉtokenˉkind.Equals { return Compilerˉbodyˉparseˉassignmentˉstatement(Input, Start, Endˉoffset); }
    }
    return Compilerˉbodyˉparseˉexpressionˉstatement(Input, Start, Endˉoffset);
}

export fn Compilerˉparseˉblockˉvalidated(
    Input: bytes,
    Offset: u32,
    Line: u32,
    Column: u32,
    Endˉoffset: u32,
    Statementˉnesting: u32
) -> Compilerˉbodyˉparseˉstep {
    let Total: u32 = Bytesˉlength(Input);
    if Offset > Endˉoffset { return Compilerˉbodyˉstepˉfailure(Compilerˉbodyˉparseˉstatus.Invalidˉspan, Compilerˉlexˉstatus.Valid, Offset, Line, Column, Compilerˉtokenˉkind.Leftˉbrace, Compilerˉtokenˉkind.End); }
    if Endˉoffset > Total { return Compilerˉbodyˉstepˉfailure(Compilerˉbodyˉparseˉstatus.Invalidˉspan, Compilerˉlexˉstatus.Valid, Endˉoffset, Line, Column, Compilerˉtokenˉkind.Rightˉbrace, Compilerˉtokenˉkind.End); }
    if Statementˉnesting > 64u32 { return Compilerˉbodyˉstepˉfailure(Compilerˉbodyˉparseˉstatus.Nestingˉlimit, Compilerˉlexˉstatus.Valid, Offset, Line, Column, Compilerˉtokenˉkind.Rightˉbrace, Compilerˉtokenˉkind.Leftˉbrace); }
    let Start: Compilerˉbodyˉparseˉstep = Compilerˉbodyˉconsume(Input, Offset, Line, Column, Endˉoffset, Compilerˉtokenˉkind.Leftˉbrace);
    if Start.Status != Compilerˉbodyˉparseˉstatus.Valid { return Start; }
    var Cursor: u32 = Start.Nextˉoffset;
    var Currentˉline: u32 = Start.Nextˉline;
    var Currentˉcolumn: u32 = Start.Nextˉcolumn;
    var Statements: u32 = 0u32;
    var Topˉlevelˉstatements: u32 = 0u32;
    var Expressions: u32 = 0u32;
    var Maximumˉstatementˉdepth: u32 = 0u32;
    var Maximumˉexpressionˉdepth: u32 = 0u32;
    var Reading: bool = true;
    while Reading {
        let Current: Compilerˉsourceˉtoken = Compilerˉbodyˉtoken(Input, Cursor, Currentˉline, Currentˉcolumn, Endˉoffset);
        if Current.Kind == Compilerˉtokenˉkind.Rightˉbrace {
            let End: Compilerˉbodyˉparseˉstep = Compilerˉbodyˉconsume(Input, Cursor, Currentˉline, Currentˉcolumn, Endˉoffset, Compilerˉtokenˉkind.Rightˉbrace);
            if End.Status != Compilerˉbodyˉparseˉstatus.Valid { return End; }
            return Compilerˉbodyˉblockˉstepˉvalid(End.Nextˉoffset, End.Nextˉline, End.Nextˉcolumn, Topˉlevelˉstatements, Statements, Expressions, Maximumˉstatementˉdepth, Maximumˉexpressionˉdepth);
        }
        if Current.Kind == Compilerˉtokenˉkind.End { return Compilerˉbodyˉstepˉfromˉtoken(Compilerˉbodyˉparseˉstatus.Expectedˉtoken, Current, Compilerˉtokenˉkind.Rightˉbrace); }
        let Statement: Compilerˉsourceˉstatement = Compilerˉparseˉnextˉstatementˉvalidated(Input, Cursor, Currentˉline, Currentˉcolumn, Endˉoffset, Statementˉnesting);
        if Statement.Status != Compilerˉbodyˉparseˉstatus.Valid { return Compilerˉbodyˉstepˉfromˉstatement(Statement); }
        Topˉlevelˉstatements = Topˉlevelˉstatements + 1u32;
        Statements = Statements + Statement.Statements;
        Expressions = Expressions + Statement.Expressions;
        if Statements > 4096u32 { return Compilerˉbodyˉstepˉfromˉtoken(Compilerˉbodyˉparseˉstatus.Itemˉlimit, Current, Compilerˉtokenˉkind.Rightˉbrace); }
        if Expressions > 262144u32 { return Compilerˉbodyˉstepˉfromˉtoken(Compilerˉbodyˉparseˉstatus.Itemˉlimit, Current, Compilerˉtokenˉkind.Rightˉbrace); }
        Maximumˉstatementˉdepth = Compilerˉbodyˉmaximum(Maximumˉstatementˉdepth, Statement.Maximumˉstatementˉdepth);
        Maximumˉexpressionˉdepth = Compilerˉbodyˉmaximum(Maximumˉexpressionˉdepth, Statement.Maximumˉexpressionˉdepth);
        Cursor = Statement.Nextˉoffset;
        Currentˉline = Statement.Nextˉline;
        Currentˉcolumn = Statement.Nextˉcolumn;
    }
    return Compilerˉbodyˉblockˉstepˉvalid(Cursor, Currentˉline, Currentˉcolumn, Topˉlevelˉstatements, Statements, Expressions, Maximumˉstatementˉdepth, Maximumˉexpressionˉdepth);
}

export fn Compilerˉbodyˉsummaryˉmake(
    Functions: u32,
    Topˉlevelˉstatements: u32,
    Statements: u32,
    Expressions: u32,
    Maximumˉstatementˉdepth: u32,
    Maximumˉexpressionˉdepth: u32,
    Offset: u32,
    Line: u32,
    Column: u32
) -> Compilerˉsourceˉbodyˉsummary {
    return Compilerˉsourceˉbodyˉsummary(
        Compilerˉbodyˉparseˉstatus.Valid,
        Compilerˉlexˉstatus.Valid,
        Functions,
        Topˉlevelˉstatements,
        Statements,
        Expressions,
        Maximumˉstatementˉdepth,
        Maximumˉexpressionˉdepth,
        Offset,
        Line,
        Column,
        Offset,
        Line,
        Column,
        Compilerˉtokenˉkind.End,
        Compilerˉtokenˉkind.End
    );
}

export fn Compilerˉbodyˉsummaryˉfailureˉfromˉstep(
    Step: Compilerˉbodyˉparseˉstep
) -> Compilerˉsourceˉbodyˉsummary {
    return Compilerˉsourceˉbodyˉsummary(
        Step.Status,
        Step.Lexicalˉstatus,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        Step.Nextˉoffset,
        Step.Nextˉline,
        Step.Nextˉcolumn,
        Step.Failureˉoffset,
        Step.Failureˉline,
        Step.Failureˉcolumn,
        Step.Expected,
        Step.Found
    );
}

export fn Compilerˉbodyˉsummaryˉfailureˉfromˉdeclarations(
    Summary: Compilerˉsourceˉmoduleˉsummary
) -> Compilerˉsourceˉbodyˉsummary {
    var Status: Compilerˉbodyˉparseˉstatus = Compilerˉbodyˉparseˉstatus.Declarationˉerror;
    if Summary.Status == Compilerˉparseˉstatus.Lexicalˉerror { Status = Compilerˉbodyˉparseˉstatus.Lexicalˉerror; }
    return Compilerˉsourceˉbodyˉsummary(
        Status,
        Summary.Lexicalˉstatus,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        Summary.Endˉoffset,
        Summary.Endˉline,
        Summary.Endˉcolumn,
        Summary.Failureˉoffset,
        Summary.Failureˉline,
        Summary.Failureˉcolumn,
        Summary.Expected,
        Summary.Found
    );
}

export fn Compilerˉparseˉbodyˉspanˉvalidated(
    Input: bytes,
    Offset: u32,
    Line: u32,
    Column: u32,
    Endˉoffset: u32
) -> Compilerˉsourceˉbodyˉsummary {
    let Body: Compilerˉbodyˉparseˉstep = Compilerˉparseˉblockˉvalidated(Input, Offset, Line, Column, Endˉoffset, 0u32);
    if Body.Status != Compilerˉbodyˉparseˉstatus.Valid { return Compilerˉbodyˉsummaryˉfailureˉfromˉstep(Body); }
    if Body.Nextˉoffset != Endˉoffset {
        let Trailing: Compilerˉsourceˉtoken = Compilerˉbodyˉtoken(Input, Body.Nextˉoffset, Body.Nextˉline, Body.Nextˉcolumn, Endˉoffset);
        return Compilerˉbodyˉsummaryˉfailureˉfromˉstep(Compilerˉbodyˉstepˉfromˉtoken(Compilerˉbodyˉparseˉstatus.Invalidˉspan, Trailing, Compilerˉtokenˉkind.End));
    }
    return Compilerˉbodyˉsummaryˉmake(1u32, Body.Topˉlevelˉstatements, Body.Statements, Body.Expressions, Body.Maximumˉstatementˉdepth, Body.Maximumˉexpressionˉdepth, Body.Nextˉoffset, Body.Nextˉline, Body.Nextˉcolumn);
}

export fn Compilerˉparseˉbodyˉspan(
    Input: bytes,
    Offset: u32,
    Line: u32,
    Column: u32,
    Endˉoffset: u32
) -> Compilerˉsourceˉbodyˉsummary {
    let Scan: Compilerˉsourceˉscan = Compilerˉlexˉsource(Input);
    if Scan.Status != Compilerˉlexˉstatus.Valid {
        return Compilerˉsourceˉbodyˉsummary(Compilerˉbodyˉparseˉstatus.Lexicalˉerror, Scan.Status, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32, Scan.Failureˉoffset, Scan.Failureˉline, Scan.Failureˉcolumn, Scan.Failureˉoffset, Scan.Failureˉline, Scan.Failureˉcolumn, Compilerˉtokenˉkind.End, Compilerˉtokenˉkind.Bad);
    }
    return Compilerˉparseˉbodyˉspanˉvalidated(Input, Offset, Line, Column, Endˉoffset);
}

export fn Compilerˉparseˉsourceˉbodies(Input: bytes) -> Compilerˉsourceˉbodyˉsummary {
    let Declarationˉsummary: Compilerˉsourceˉmoduleˉsummary = Compilerˉparseˉsource(Input);
    if Declarationˉsummary.Status != Compilerˉparseˉstatus.Valid { return Compilerˉbodyˉsummaryˉfailureˉfromˉdeclarations(Declarationˉsummary); }
    let Header: Compilerˉsourceˉheader = Compilerˉparseˉheaderˉvalidated(Input);
    var Cursor: u32 = Header.Nextˉoffset;
    var Currentˉline: u32 = Header.Nextˉline;
    var Currentˉcolumn: u32 = Header.Nextˉcolumn;
    var Functions: u32 = 0u32;
    var Topˉlevelˉstatements: u32 = 0u32;
    var Statements: u32 = 0u32;
    var Expressions: u32 = 0u32;
    var Maximumˉstatementˉdepth: u32 = 0u32;
    var Maximumˉexpressionˉdepth: u32 = 0u32;
    var Sawˉnonˉimport: bool = false;
    var Reading: bool = true;
    while Reading {
        let Current: Compilerˉsourceˉtoken = Compilerˉlexˉnextˉvalidated(Input, Cursor, Currentˉline, Currentˉcolumn);
        if Current.Kind == Compilerˉtokenˉkind.End {
            Cursor = Current.Offset;
            Currentˉline = Current.Line;
            Currentˉcolumn = Current.Column;
            Reading = false;
        } else {
            let Declarationˉcursor: u32 = Cursor;
            let Declarationˉline: u32 = Currentˉline;
            let Declarationˉcolumn: u32 = Currentˉcolumn;
            let Declaration: Compilerˉsourceˉdeclaration = Compilerˉparseˉnextˉdeclarationˉvalidated(Input, Cursor, Currentˉline, Currentˉcolumn, Sawˉnonˉimport);
            if Declaration.Status != Compilerˉparseˉstatus.Valid {
                return Compilerˉsourceˉbodyˉsummary(Compilerˉbodyˉparseˉstatus.Declarationˉerror, Declaration.Lexicalˉstatus, Functions, Topˉlevelˉstatements, Statements, Expressions, Maximumˉstatementˉdepth, Maximumˉexpressionˉdepth, Declaration.Nextˉoffset, Declaration.Nextˉline, Declaration.Nextˉcolumn, Declaration.Failureˉoffset, Declaration.Failureˉline, Declaration.Failureˉcolumn, Declaration.Expected, Declaration.Found);
            }
            if Declaration.Kind != Compilerˉsourceˉdeclarationˉkind.Import { Sawˉnonˉimport = true; }
            if Declaration.Kind == Compilerˉsourceˉdeclarationˉkind.Function {
                let Bodyˉposition: Compilerˉsourceˉposition = Compilerˉbodyˉpositionˉbetween(Input, Declarationˉcursor, Declarationˉline, Declarationˉcolumn, Declaration.Bodyˉoffset);
                if Bodyˉposition.Offset != Declaration.Bodyˉoffset {
                    return Compilerˉsourceˉbodyˉsummary(Compilerˉbodyˉparseˉstatus.Invalidˉspan, Compilerˉlexˉstatus.Valid, Functions, Topˉlevelˉstatements, Statements, Expressions, Maximumˉstatementˉdepth, Maximumˉexpressionˉdepth, Bodyˉposition.Offset, Bodyˉposition.Line, Bodyˉposition.Column, Bodyˉposition.Offset, Bodyˉposition.Line, Bodyˉposition.Column, Compilerˉtokenˉkind.Leftˉbrace, Compilerˉtokenˉkind.End);
                }
                let Bodyˉend: u32 = Declaration.Bodyˉoffset + Declaration.Bodyˉlength;
                let Body: Compilerˉsourceˉbodyˉsummary = Compilerˉparseˉbodyˉspanˉvalidated(Input, Declaration.Bodyˉoffset, Bodyˉposition.Line, Bodyˉposition.Column, Bodyˉend);
                if Body.Status != Compilerˉbodyˉparseˉstatus.Valid { return Body; }
                Functions = Functions + 1u32;
                Topˉlevelˉstatements = Topˉlevelˉstatements + Body.Topˉlevelˉstatements;
                Statements = Statements + Body.Statements;
                Expressions = Expressions + Body.Expressions;
                Maximumˉstatementˉdepth = Compilerˉbodyˉmaximum(Maximumˉstatementˉdepth, Body.Maximumˉstatementˉdepth);
                Maximumˉexpressionˉdepth = Compilerˉbodyˉmaximum(Maximumˉexpressionˉdepth, Body.Maximumˉexpressionˉdepth);
            }
            Cursor = Declaration.Nextˉoffset;
            Currentˉline = Declaration.Nextˉline;
            Currentˉcolumn = Declaration.Nextˉcolumn;
        }
    }
    return Compilerˉbodyˉsummaryˉmake(Functions, Topˉlevelˉstatements, Statements, Expressions, Maximumˉstatementˉdepth, Maximumˉexpressionˉdepth, Cursor, Currentˉline, Currentˉcolumn);
}
