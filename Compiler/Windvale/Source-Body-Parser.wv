    Lexicalˉstatus: Sourceˉlexer.Compilerˉlexˉstatus;
    Offset: u32;
    Length: u32;
    Parts: u32;
    Firstˉoffset: u32;
    Firstˉlength: u32;
    Secondˉoffset: u32;
    Secondˉlength: u32;
