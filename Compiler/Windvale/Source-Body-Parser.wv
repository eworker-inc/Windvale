    if Step.Status == Sourceˉdeclarations.Compilerˉparseˉstatus.Lexicalˉerror { Status = Compilerˉbodyˉparseˉstatus.Lexicalˉerror; }
    if Step.Status == Sourceˉdeclarations.Compilerˉparseˉstatus.Invalidˉtype { Status = Compilerˉbodyˉparseˉstatus.Invalidˉtype; }
