module Compilerˉsourceˉbodyˉparser profile portable;

import Compilerˉsourceˉdeclarationˉparser;

enum Compilerˉbodyˉparseˉstatus {
    Valid = 0;
    Lexicalˉerror = 1;
    Invalidˉspan = 2;
    Expectedˉtoken = 3;
    Expectedˉexpression = 4;
    Invalidˉtype = 5;
    Nestingˉlimit = 6;
    Itemˉlimit = 7;
    Declarationˉerror = 8;
}

enum Compilerˉsourceˉstatementˉkind {
    End = 0;
    Block = 1;
    Local = 2;
    Assignment = 3;
    If = 4;
    While = 5;
    Return = 6;
    Expression = 7;
}

enum Compilerˉsourceˉexpressionˉkind {
    Invalid = 0;
    Integer = 1;
    String = 2;
    Boolean = 3;
    Name = 4;
    Field = 5;
    Call = 6;
    Index = 7;
    Unary = 8;
    Binary = 9;
}

record Compilerˉsourceˉposition {
    Offset: u32;
    Line: u32;
    Column: u32;
}

record Compilerˉbodyˉparseˉstep {
    Status: Compilerˉbodyˉparseˉstatus;
    Lexicalˉstatus: Compilerˉlexˉstatus;
    Nextˉoffset: u32;
    Nextˉline: u32;
    Nextˉcolumn: u32;
    Topˉlevelˉstatements: u32;
    Statements: u32;
    Expressions: u32;
    Maximumˉstatementˉdepth: u32;
    Maximumˉexpressionˉdepth: u32;
    Failureˉoffset: u32;
    Failureˉline: u32;
    Failureˉcolumn: u32;
    Expected: Compilerˉtokenˉkind;
    Found: Compilerˉtokenˉkind;
}

record Compilerˉsourceˉnameˉview {
    Status: Compilerˉbodyˉparseˉstatus;
    Lexicalˉstatus: Compilerˉlexˉstatus;
    Offset: u32;
    Length: u32;
    Parts: u32;
    Firstˉoffset: u32;
    Firstˉlength: u32;
    Secondˉoffset: u32;
    Secondˉlength: u32;
    Nextˉoffset: u32;
    Nextˉline: u32;
    Nextˉcolumn: u32;
    Failureˉoffset: u32;
    Failureˉline: u32;
    Failureˉcolumn: u32;
    Expected: Compilerˉtokenˉkind;
    Found: Compilerˉtokenˉkind;
}

record Compilerˉsourceˉexpression {
    Status: Compilerˉbodyˉparseˉstatus;
    Lexicalˉstatus: Compilerˉlexˉstatus;
    Kind: Compilerˉsourceˉexpressionˉkind;
    Operator: Compilerˉtokenˉkind;
    Offset: u32;
    Length: u32;
    Line: u32;
    Column: u32;
    Valueˉoffset: u32;
    Valueˉlength: u32;
    Firstˉoffset: u32;
    Firstˉlength: u32;
    Secondˉoffset: u32;
    Secondˉlength: u32;
    Itemsˉoffset: u32;
    Itemsˉlength: u32;
    Items: u32;
    Numericˉkind: Compilerˉnumericˉkind;
    Numericˉvalue: u32;
    Booleanˉvalue: bool;
    Nextˉoffset: u32;
    Nextˉline: u32;
    Nextˉcolumn: u32;
    Nodes: u32;
    Depth: u32;
    Failureˉoffset: u32;
    Failureˉline: u32;
    Failureˉcolumn: u32;
    Expected: Compilerˉtokenˉkind;
    Found: Compilerˉtokenˉkind;
}

record Compilerˉsourceˉstatement {
    Status: Compilerˉbodyˉparseˉstatus;
    Lexicalˉstatus: Compilerˉlexˉstatus;
    Kind: Compilerˉsourceˉstatementˉkind;
    Isˉmutable: bool;
    Offset: u32;
    Length: u32;
    Line: u32;
    Column: u32;
    Nameˉoffset: u32;
    Nameˉlength: u32;
    Typeˉkind: Compilerˉsourceˉtypeˉkind;
    Typeˉoffset: u32;
    Typeˉlength: u32;
    Expressionˉoffset: u32;
    Expressionˉlength: u32;
    Firstˉblockˉoffset: u32;
    Firstˉblockˉlength: u32;
    Secondˉblockˉoffset: u32;
    Secondˉblockˉlength: u32;
    Nextˉoffset: u32;
    Nextˉline: u32;
    Nextˉcolumn: u32;
    Statements: u32;
    Expressions: u32;
    Maximumˉstatementˉdepth: u32;
    Maximumˉexpressionˉdepth: u32;
    Failureˉoffset: u32;
    Failureˉline: u32;
    Failureˉcolumn: u32;
    Expected: Compilerˉtokenˉkind;
    Found: Compilerˉtokenˉkind;
}

record Compilerˉsourceˉbodyˉsummary {
    Status: Compilerˉbodyˉparseˉstatus;
    Lexicalˉstatus: Compilerˉlexˉstatus;
    Functions: u32;
    Topˉlevelˉstatements: u32;
    Statements: u32;
    Expressions: u32;
    Maximumˉstatementˉdepth: u32;
    Maximumˉexpressionˉdepth: u32;
    Endˉoffset: u32;
    Endˉline: u32;
    Endˉcolumn: u32;
    Failureˉoffset: u32;
    Failureˉline: u32;
    Failureˉcolumn: u32;
    Expected: Compilerˉtokenˉkind;
    Found: Compilerˉtokenˉkind;
}

export fn Compilerˉbodyˉmaximum(Left: u32, Right: u32) -> u32 {
    if Left >= Right { return Left; }
    return Right;
}

export fn Compilerˉbodyˉpositionˉbetween(
    Input: bytes,
    Start: u32,
    Startˉline: u32,
    Startˉcolumn: u32,
    Wanted: u32
) -> Compilerˉsourceˉposition {
    let Total: u32 = Bytesˉlength(Input);
    if Start > Wanted { return Compilerˉsourceˉposition(Start, Startˉline, Startˉcolumn); }
    if Wanted > Total { return Compilerˉsourceˉposition(Total, Startˉline, Startˉcolumn); }
    var Cursor: u32 = Start;
    var Line: u32 = Startˉline;
    var Column: u32 = Startˉcolumn;
    while Cursor < Wanted {
        if Bytesˉreadˉu8(Input, Cursor) == 10u8 {
            Line = Line + 1u32;
            Column = 1u32;
            Cursor = Cursor + 1u32;
        } else {
            let Width: u32 = Compilerˉsourceˉcolumnˉwidth(Input, Cursor);
            let Length: u32 = Compilerˉsourceˉutf8ˉlength(Input, Cursor);
            if Length == 0u32 { return Compilerˉsourceˉposition(Cursor, Line, Column); }
            if Length > Wanted - Cursor { return Compilerˉsourceˉposition(Cursor, Line, Column); }
            Column = Column + Width;
            Cursor = Cursor + Length;
        }
    }
    return Compilerˉsourceˉposition(Cursor, Line, Column);
}

export fn Compilerˉbodyˉtoken(
    Input: bytes,
    Offset: u32,
    Line: u32,
    Column: u32,
    Endˉoffset: u32
) -> Compilerˉsourceˉtoken {
    let Token: Compilerˉsourceˉtoken = Compilerˉlexˉnextˉvalidated(Input, Offset, Line, Column);
    if Token.Status != Compilerˉlexˉstatus.Valid { return Token; }
    if Token.Offset < Endˉoffset { return Token; }
    return Compilerˉsourceˉtokenˉmake(
        Compilerˉlexˉstatus.Valid,
        Compilerˉtokenˉkind.End,
        Endˉoffset,
        Endˉoffset,
        Token.Line,
        Token.Column,
        Token.Line,
        Token.Column,
        Compilerˉnumericˉkind.None,
        0u32,
        Endˉoffset,
        Token.Line,
        Token.Column
    );
}

export fn Compilerˉbodyˉstepˉvalid(
    Offset: u32,
    Line: u32,
    Column: u32,
    Statements: u32,
    Expressions: u32,
    Statementˉdepth: u32,
    Expressionˉdepth: u32
) -> Compilerˉbodyˉparseˉstep {
    return Compilerˉbodyˉparseˉstep(
        Compilerˉbodyˉparseˉstatus.Valid,
        Compilerˉlexˉstatus.Valid,
        Offset,
        Line,
        Column,
        0u32,
        Statements,
        Expressions,
        Statementˉdepth,
        Expressionˉdepth,
        Offset,
        Line,
        Column,
        Compilerˉtokenˉkind.End,
        Compilerˉtokenˉkind.End
    );
}

export fn Compilerˉbodyˉblockˉstepˉvalid(
    Offset: u32,
    Line: u32,
    Column: u32,
    Topˉlevelˉstatements: u32,
    Statements: u32,
    Expressions: u32,
    Statementˉdepth: u32,
    Expressionˉdepth: u32
) -> Compilerˉbodyˉparseˉstep {
    return Compilerˉbodyˉparseˉstep(
        Compilerˉbodyˉparseˉstatus.Valid,
        Compilerˉlexˉstatus.Valid,
        Offset,
        Line,
        Column,
        Topˉlevelˉstatements,
        Statements,
        Expressions,
        Statementˉdepth,
        Expressionˉdepth,
        Offset,
        Line,
        Column,
        Compilerˉtokenˉkind.End,
        Compilerˉtokenˉkind.End
    );
}

export fn Compilerˉbodyˉstepˉfailure(
    Status: Compilerˉbodyˉparseˉstatus,
    Lexicalˉstatus: Compilerˉlexˉstatus,
    Offset: u32,
    Line: u32,
    Column: u32,
    Expected: Compilerˉtokenˉkind,
    Found: Compilerˉtokenˉkind
) -> Compilerˉbodyˉparseˉstep {
    return Compilerˉbodyˉparseˉstep(
        Status,
        Lexicalˉstatus,
        Offset,
        Line,
        Column,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        Offset,
        Line,
        Column,
        Expected,
        Found
    );
}

export fn Compilerˉbodyˉstepˉfromˉtoken(
    Status: Compilerˉbodyˉparseˉstatus,
    Token: Compilerˉsourceˉtoken,
    Expected: Compilerˉtokenˉkind
) -> Compilerˉbodyˉparseˉstep {
    if Token.Status != Compilerˉlexˉstatus.Valid {
        return Compilerˉbodyˉstepˉfailure(
            Compilerˉbodyˉparseˉstatus.Lexicalˉerror,
            Token.Status,
            Token.Failureˉoffset,
            Token.Failureˉline,
            Token.Failureˉcolumn,
            Expected,
            Token.Kind
        );
    }
    return Compilerˉbodyˉstepˉfailure(Status, Compilerˉlexˉstatus.Valid, Token.Offset, Token.Line, Token.Column, Expected, Token.Kind);
}

export fn Compilerˉbodyˉconsume(
    Input: bytes,
    Offset: u32,
    Line: u32,
    Column: u32,
    Endˉoffset: u32,
    Expected: Compilerˉtokenˉkind
) -> Compilerˉbodyˉparseˉstep {
    let Token: Compilerˉsourceˉtoken = Compilerˉbodyˉtoken(Input, Offset, Line, Column, Endˉoffset);
    if Token.Status != Compilerˉlexˉstatus.Valid {
        return Compilerˉbodyˉstepˉfromˉtoken(Compilerˉbodyˉparseˉstatus.Lexicalˉerror, Token, Expected);
    }
    if Token.Kind != Expected {
        return Compilerˉbodyˉstepˉfromˉtoken(Compilerˉbodyˉparseˉstatus.Expectedˉtoken, Token, Expected);
    }
    return Compilerˉbodyˉstepˉvalid(Token.Nextˉoffset, Token.Nextˉline, Token.Nextˉcolumn, 0u32, 0u32, 0u32, 0u32);
}

export fn Compilerˉbodyˉnameˉfailure(
    Status: Compilerˉbodyˉparseˉstatus,
    Token: Compilerˉsourceˉtoken
) -> Compilerˉsourceˉnameˉview {
    var Bodyˉstatus: Compilerˉbodyˉparseˉstatus = Status;
    if Token.Status != Compilerˉlexˉstatus.Valid { Bodyˉstatus = Compilerˉbodyˉparseˉstatus.Lexicalˉerror; }
    return Compilerˉsourceˉnameˉview(
        Bodyˉstatus,
        Token.Status,
        Token.Offset,
        0u32,
        0u32,
        Token.Offset,
        0u32,
        Token.Offset,
        0u32,
        Token.Offset,
        Token.Line,
        Token.Column,
        Token.Failureˉoffset,
        Token.Failureˉline,
        Token.Failureˉcolumn,
        Compilerˉtokenˉkind.Identifier,
        Token.Kind
    );
}

export fn Compilerˉbodyˉparseˉname(
    Input: bytes,
    Offset: u32,
    Line: u32,
    Column: u32,
    Endˉoffset: u32,
    Allowˉlength: bool
) -> Compilerˉsourceˉnameˉview {
    let First: Compilerˉsourceˉtoken = Compilerˉbodyˉtoken(Input, Offset, Line, Column, Endˉoffset);
    var Accepted: bool = First.Kind == Compilerˉtokenˉkind.Identifier;
    if Allowˉlength {
        if First.Kind == Compilerˉtokenˉkind.Length { Accepted = true; }
    }
    if First.Status != Compilerˉlexˉstatus.Valid { return Compilerˉbodyˉnameˉfailure(Compilerˉbodyˉparseˉstatus.Lexicalˉerror, First); }
    if !Accepted { return Compilerˉbodyˉnameˉfailure(Compilerˉbodyˉparseˉstatus.Expectedˉtoken, First); }

    var Cursor: u32 = First.Nextˉoffset;
    var Currentˉline: u32 = First.Nextˉline;
    var Currentˉcolumn: u32 = First.Nextˉcolumn;
    var End: u32 = First.Nextˉoffset;
    var Parts: u32 = 1u32;
    var Secondˉoffset: u32 = First.Offset;
    var Secondˉlength: u32 = 0u32;
    var Reading: bool = true;
    while Reading {
        let Dot: Compilerˉsourceˉtoken = Compilerˉbodyˉtoken(Input, Cursor, Currentˉline, Currentˉcolumn, Endˉoffset);
        if Dot.Kind != Compilerˉtokenˉkind.Dot {
            Reading = false;
        } else {
            let Part: Compilerˉsourceˉtoken = Compilerˉbodyˉtoken(Input, Dot.Nextˉoffset, Dot.Nextˉline, Dot.Nextˉcolumn, Endˉoffset);
            if Part.Status != Compilerˉlexˉstatus.Valid { return Compilerˉbodyˉnameˉfailure(Compilerˉbodyˉparseˉstatus.Lexicalˉerror, Part); }
            if Part.Kind != Compilerˉtokenˉkind.Identifier { return Compilerˉbodyˉnameˉfailure(Compilerˉbodyˉparseˉstatus.Expectedˉtoken, Part); }
            Parts = Parts + 1u32;
            if Parts > 16u32 { return Compilerˉbodyˉnameˉfailure(Compilerˉbodyˉparseˉstatus.Itemˉlimit, Part); }
            if Parts == 2u32 {
                Secondˉoffset = Part.Offset;
                Secondˉlength = Part.Length;
            }
            Cursor = Part.Nextˉoffset;
            Currentˉline = Part.Nextˉline;
            Currentˉcolumn = Part.Nextˉcolumn;
            End = Part.Nextˉoffset;
        }
    }
    return Compilerˉsourceˉnameˉview(
        Compilerˉbodyˉparseˉstatus.Valid,
        Compilerˉlexˉstatus.Valid,
        First.Offset,
        End - First.Offset,
        Parts,
        First.Offset,
        First.Length,
        Secondˉoffset,
        Secondˉlength,
        Cursor,
        Currentˉline,
        Currentˉcolumn,
        Cursor,
        Currentˉline,
        Currentˉcolumn,
        Compilerˉtokenˉkind.End,
        Compilerˉtokenˉkind.End
    );
}

export fn Compilerˉbodyˉexpressionˉmake(
    Kind: Compilerˉsourceˉexpressionˉkind,
    Operator: Compilerˉtokenˉkind,
    Offset: u32,
    End: u32,
    Line: u32,
    Column: u32,
    Valueˉoffset: u32,
    Valueˉlength: u32,
    Firstˉoffset: u32,
    Firstˉlength: u32,
    Secondˉoffset: u32,
    Secondˉlength: u32,
    Itemsˉoffset: u32,
    Itemsˉend: u32,
    Items: u32,
    Numericˉkind: Compilerˉnumericˉkind,
    Numericˉvalue: u32,
    Booleanˉvalue: bool,
    Nextˉoffset: u32,
    Nextˉline: u32,
    Nextˉcolumn: u32,
    Nodes: u32,
    Depth: u32
) -> Compilerˉsourceˉexpression {
    return Compilerˉsourceˉexpression(
        Compilerˉbodyˉparseˉstatus.Valid,
        Compilerˉlexˉstatus.Valid,
        Kind,
        Operator,
        Offset,
        End - Offset,
        Line,
        Column,
        Valueˉoffset,
        Valueˉlength,
        Firstˉoffset,
        Firstˉlength,
        Secondˉoffset,
        Secondˉlength,
        Itemsˉoffset,
        Itemsˉend - Itemsˉoffset,
        Items,
        Numericˉkind,
        Numericˉvalue,
        Booleanˉvalue,
        Nextˉoffset,
        Nextˉline,
        Nextˉcolumn,
        Nodes,
        Depth,
        Nextˉoffset,
        Nextˉline,
        Nextˉcolumn,
        Compilerˉtokenˉkind.End,
        Compilerˉtokenˉkind.End
    );
}

export fn Compilerˉbodyˉexpressionˉfailure(
    Status: Compilerˉbodyˉparseˉstatus,
    Token: Compilerˉsourceˉtoken,
    Expected: Compilerˉtokenˉkind
) -> Compilerˉsourceˉexpression {
    var Bodyˉstatus: Compilerˉbodyˉparseˉstatus = Status;
    var Failureˉoffset: u32 = Token.Offset;
    var Failureˉline: u32 = Token.Line;
    var Failureˉcolumn: u32 = Token.Column;
    if Token.Status != Compilerˉlexˉstatus.Valid {
        Bodyˉstatus = Compilerˉbodyˉparseˉstatus.Lexicalˉerror;
        Failureˉoffset = Token.Failureˉoffset;
        Failureˉline = Token.Failureˉline;
        Failureˉcolumn = Token.Failureˉcolumn;
    }
    return Compilerˉsourceˉexpression(
        Bodyˉstatus,
        Token.Status,
        Compilerˉsourceˉexpressionˉkind.Invalid,
        Compilerˉtokenˉkind.End,
        Token.Offset,
        0u32,
        Token.Line,
        Token.Column,
        Token.Offset,
        0u32,
        Token.Offset,
        0u32,
        Token.Offset,
        0u32,
        Token.Offset,
        0u32,
        0u32,
        Compilerˉnumericˉkind.None,
        0u32,
        false,
        Token.Offset,
        Token.Line,
        Token.Column,
        0u32,
        0u32,
        Failureˉoffset,
        Failureˉline,
        Failureˉcolumn,
        Expected,
        Token.Kind
    );
}

export fn Compilerˉbodyˉexpressionˉfailureˉfromˉstep(
    Step: Compilerˉbodyˉparseˉstep
) -> Compilerˉsourceˉexpression {
    return Compilerˉsourceˉexpression(
        Step.Status,
        Step.Lexicalˉstatus,
        Compilerˉsourceˉexpressionˉkind.Invalid,
        Compilerˉtokenˉkind.End,
        Step.Failureˉoffset,
        0u32,
        Step.Failureˉline,
        Step.Failureˉcolumn,
        Step.Failureˉoffset,
        0u32,
        Step.Failureˉoffset,
        0u32,
        Step.Failureˉoffset,
        0u32,
        Step.Failureˉoffset,
        0u32,
        0u32,
        Compilerˉnumericˉkind.None,
        0u32,
        false,
        Step.Nextˉoffset,
        Step.Nextˉline,
        Step.Nextˉcolumn,
        0u32,
        0u32,
        Step.Failureˉoffset,
        Step.Failureˉline,
        Step.Failureˉcolumn,
        Step.Expected,
        Step.Found
    );
}

export fn Compilerˉbodyˉunaryˉprecedence(Kind: Compilerˉtokenˉkind) -> u32 {
    if Kind == Compilerˉtokenˉkind.Minus { return 5u32; }
    if Kind == Compilerˉtokenˉkind.Bang { return 5u32; }
    return 0u32;
}

export fn Compilerˉbodyˉbinaryˉprecedence(Kind: Compilerˉtokenˉkind) -> u32 {
    if Kind == Compilerˉtokenˉkind.Equalsˉequals { return 1u32; }
    if Kind == Compilerˉtokenˉkind.Bangˉequals { return 1u32; }
    if Kind == Compilerˉtokenˉkind.Less { return 2u32; }
    if Kind == Compilerˉtokenˉkind.Lessˉequals { return 2u32; }
    if Kind == Compilerˉtokenˉkind.Greater { return 2u32; }
    if Kind == Compilerˉtokenˉkind.Greaterˉequals { return 2u32; }
    if Kind == Compilerˉtokenˉkind.Plus { return 3u32; }
    if Kind == Compilerˉtokenˉkind.Minus { return 3u32; }
    if Kind == Compilerˉtokenˉkind.Star { return 4u32; }
    return 0u32;
}

export fn Compilerˉbodyˉparseˉprimary(
    Input: bytes,
    Offset: u32,
    Line: u32,
    Column: u32,
    Endˉoffset: u32,
    Nesting: u32
) -> Compilerˉsourceˉexpression {
    let Token: Compilerˉsourceˉtoken = Compilerˉbodyˉtoken(Input, Offset, Line, Column, Endˉoffset);
    if Token.Status != Compilerˉlexˉstatus.Valid {
        return Compilerˉbodyˉexpressionˉfailure(Compilerˉbodyˉparseˉstatus.Lexicalˉerror, Token, Compilerˉtokenˉkind.Identifier);
    }
    if Token.Kind == Compilerˉtokenˉkind.Integer {
        return Compilerˉbodyˉexpressionˉmake(
            Compilerˉsourceˉexpressionˉkind.Integer,
            Compilerˉtokenˉkind.End,
            Token.Offset,
            Token.Nextˉoffset,
            Token.Line,
            Token.Column,
            Token.Offset,
            Token.Length,
            Token.Offset,
            0u32,
            Token.Offset,
            0u32,
            Token.Offset,
            Token.Offset,
            0u32,
            Token.Numericˉkind,
            Token.Numericˉvalue,
            false,
            Token.Nextˉoffset,
            Token.Nextˉline,
            Token.Nextˉcolumn,
            1u32,
            1u32
        );
    }
    if Token.Kind == Compilerˉtokenˉkind.String {
        return Compilerˉbodyˉexpressionˉmake(Compilerˉsourceˉexpressionˉkind.String, Compilerˉtokenˉkind.End, Token.Offset, Token.Nextˉoffset, Token.Line, Token.Column, Token.Offset, Token.Length, Token.Offset, 0u32, Token.Offset, 0u32, Token.Offset, Token.Offset, 0u32, Compilerˉnumericˉkind.None, 0u32, false, Token.Nextˉoffset, Token.Nextˉline, Token.Nextˉcolumn, 1u32, 1u32);
    }
    if Token.Kind == Compilerˉtokenˉkind.True {
        return Compilerˉbodyˉexpressionˉmake(Compilerˉsourceˉexpressionˉkind.Boolean, Compilerˉtokenˉkind.End, Token.Offset, Token.Nextˉoffset, Token.Line, Token.Column, Token.Offset, Token.Length, Token.Offset, 0u32, Token.Offset, 0u32, Token.Offset, Token.Offset, 0u32, Compilerˉnumericˉkind.None, 0u32, true, Token.Nextˉoffset, Token.Nextˉline, Token.Nextˉcolumn, 1u32, 1u32);
    }
    if Token.Kind == Compilerˉtokenˉkind.False {
        return Compilerˉbodyˉexpressionˉmake(Compilerˉsourceˉexpressionˉkind.Boolean, Compilerˉtokenˉkind.End, Token.Offset, Token.Nextˉoffset, Token.Line, Token.Column, Token.Offset, Token.Length, Token.Offset, 0u32, Token.Offset, 0u32, Token.Offset, Token.Offset, 0u32, Compilerˉnumericˉkind.None, 0u32, false, Token.Nextˉoffset, Token.Nextˉline, Token.Nextˉcolumn, 1u32, 1u32);
    }
    if Token.Kind == Compilerˉtokenˉkind.Leftˉparenthesis {
        if Nesting >= 64u32 {
            return Compilerˉbodyˉexpressionˉfailure(Compilerˉbodyˉparseˉstatus.Nestingˉlimit, Token, Compilerˉtokenˉkind.Rightˉparenthesis);
        }
        let Inner: Compilerˉsourceˉexpression = Compilerˉparseˉexpressionˉvalidated(Input, Token.Nextˉoffset, Token.Nextˉline, Token.Nextˉcolumn, Endˉoffset, 0u32, Nesting + 1u32);
        if Inner.Status != Compilerˉbodyˉparseˉstatus.Valid { return Inner; }
        let Right: Compilerˉbodyˉparseˉstep = Compilerˉbodyˉconsume(Input, Inner.Nextˉoffset, Inner.Nextˉline, Inner.Nextˉcolumn, Endˉoffset, Compilerˉtokenˉkind.Rightˉparenthesis);
        if Right.Status != Compilerˉbodyˉparseˉstatus.Valid { return Compilerˉbodyˉexpressionˉfailureˉfromˉstep(Right); }
        return Compilerˉbodyˉexpressionˉmake(Inner.Kind, Inner.Operator, Token.Offset, Right.Nextˉoffset, Token.Line, Token.Column, Inner.Valueˉoffset, Inner.Valueˉlength, Inner.Firstˉoffset, Inner.Firstˉlength, Inner.Secondˉoffset, Inner.Secondˉlength, Inner.Itemsˉoffset, Inner.Itemsˉoffset + Inner.Itemsˉlength, Inner.Items, Inner.Numericˉkind, Inner.Numericˉvalue, Inner.Booleanˉvalue, Right.Nextˉoffset, Right.Nextˉline, Right.Nextˉcolumn, Inner.Nodes, Inner.Depth);
    }
    if Token.Kind != Compilerˉtokenˉkind.Identifier {
        if Token.Kind != Compilerˉtokenˉkind.Length {
            return Compilerˉbodyˉexpressionˉfailure(Compilerˉbodyˉparseˉstatus.Expectedˉexpression, Token, Compilerˉtokenˉkind.Identifier);
        }
    }

    let Name: Compilerˉsourceˉnameˉview = Compilerˉbodyˉparseˉname(Input, Offset, Line, Column, Endˉoffset, true);
    if Name.Status != Compilerˉbodyˉparseˉstatus.Valid {
        return Compilerˉsourceˉexpression(
            Name.Status, Name.Lexicalˉstatus, Compilerˉsourceˉexpressionˉkind.Invalid, Compilerˉtokenˉkind.End,
            Name.Offset, 0u32, Line, Column, Name.Offset, 0u32, Name.Offset, 0u32, Name.Offset, 0u32, Name.Offset, 0u32, 0u32,
            Compilerˉnumericˉkind.None, 0u32, false, Name.Nextˉoffset, Name.Nextˉline, Name.Nextˉcolumn, 0u32, 0u32,
            Name.Failureˉoffset, Name.Failureˉline, Name.Failureˉcolumn, Name.Expected, Name.Found
        );
    }
    let Postfix: Compilerˉsourceˉtoken = Compilerˉbodyˉtoken(Input, Name.Nextˉoffset, Name.Nextˉline, Name.Nextˉcolumn, Endˉoffset);
    if Postfix.Kind == Compilerˉtokenˉkind.Leftˉparenthesis {
        if Nesting >= 64u32 { return Compilerˉbodyˉexpressionˉfailure(Compilerˉbodyˉparseˉstatus.Nestingˉlimit, Postfix, Compilerˉtokenˉkind.Rightˉparenthesis); }
        var Cursor: u32 = Postfix.Nextˉoffset;
        var Currentˉline: u32 = Postfix.Nextˉline;
        var Currentˉcolumn: u32 = Postfix.Nextˉcolumn;
        var Itemsˉoffset: u32 = Cursor;
        var Itemsˉend: u32 = Cursor;
        var Items: u32 = 0u32;
        var Nodes: u32 = 1u32;
        var Depth: u32 = 1u32;
        var Reading: bool = true;
        while Reading {
            let Current: Compilerˉsourceˉtoken = Compilerˉbodyˉtoken(Input, Cursor, Currentˉline, Currentˉcolumn, Endˉoffset);
            if Current.Kind == Compilerˉtokenˉkind.Rightˉparenthesis {
                Reading = false;
                if Items == 0u32 { Itemsˉoffset = Current.Offset; }
                let Callˉend: Compilerˉbodyˉparseˉstep = Compilerˉbodyˉconsume(Input, Cursor, Currentˉline, Currentˉcolumn, Endˉoffset, Compilerˉtokenˉkind.Rightˉparenthesis);
                if Callˉend.Status != Compilerˉbodyˉparseˉstatus.Valid { return Compilerˉbodyˉexpressionˉfailureˉfromˉstep(Callˉend); }
                return Compilerˉbodyˉexpressionˉmake(Compilerˉsourceˉexpressionˉkind.Call, Compilerˉtokenˉkind.End, Name.Offset, Callˉend.Nextˉoffset, Line, Column, Name.Offset, Name.Length, Name.Offset, 0u32, Name.Offset, 0u32, Itemsˉoffset, Itemsˉend, Items, Compilerˉnumericˉkind.None, 0u32, false, Callˉend.Nextˉoffset, Callˉend.Nextˉline, Callˉend.Nextˉcolumn, Nodes, Depth);
            }
            if Items >= 64u32 { return Compilerˉbodyˉexpressionˉfailure(Compilerˉbodyˉparseˉstatus.Itemˉlimit, Current, Compilerˉtokenˉkind.Rightˉparenthesis); }
            let Argument: Compilerˉsourceˉexpression = Compilerˉparseˉexpressionˉvalidated(Input, Cursor, Currentˉline, Currentˉcolumn, Endˉoffset, 0u32, Nesting + 1u32);
            if Argument.Status != Compilerˉbodyˉparseˉstatus.Valid { return Argument; }
            if Items == 0u32 { Itemsˉoffset = Argument.Offset; }
            Itemsˉend = Argument.Offset + Argument.Length;
            Items = Items + 1u32;
            Nodes = Nodes + Argument.Nodes;
            Depth = Compilerˉbodyˉmaximum(Depth, Argument.Depth + 1u32);
            if Nodes > 4096u32 { return Compilerˉbodyˉexpressionˉfailure(Compilerˉbodyˉparseˉstatus.Itemˉlimit, Current, Compilerˉtokenˉkind.Rightˉparenthesis); }
            Cursor = Argument.Nextˉoffset;
            Currentˉline = Argument.Nextˉline;
            Currentˉcolumn = Argument.Nextˉcolumn;
            let Separator: Compilerˉsourceˉtoken = Compilerˉbodyˉtoken(Input, Cursor, Currentˉline, Currentˉcolumn, Endˉoffset);
            if Separator.Kind == Compilerˉtokenˉkind.Comma {
                Cursor = Separator.Nextˉoffset;
                Currentˉline = Separator.Nextˉline;
                Currentˉcolumn = Separator.Nextˉcolumn;
            } else {
                if Separator.Kind != Compilerˉtokenˉkind.Rightˉparenthesis { return Compilerˉbodyˉexpressionˉfailure(Compilerˉbodyˉparseˉstatus.Expectedˉtoken, Separator, Compilerˉtokenˉkind.Rightˉparenthesis); }
            }
        }
    }
    if Postfix.Kind == Compilerˉtokenˉkind.Leftˉbracket {
        if Nesting >= 64u32 { return Compilerˉbodyˉexpressionˉfailure(Compilerˉbodyˉparseˉstatus.Nestingˉlimit, Postfix, Compilerˉtokenˉkind.Rightˉbracket); }
        let Index: Compilerˉsourceˉexpression = Compilerˉparseˉexpressionˉvalidated(Input, Postfix.Nextˉoffset, Postfix.Nextˉline, Postfix.Nextˉcolumn, Endˉoffset, 0u32, Nesting + 1u32);
        if Index.Status != Compilerˉbodyˉparseˉstatus.Valid { return Index; }
        let Indexˉend: Compilerˉbodyˉparseˉstep = Compilerˉbodyˉconsume(Input, Index.Nextˉoffset, Index.Nextˉline, Index.Nextˉcolumn, Endˉoffset, Compilerˉtokenˉkind.Rightˉbracket);
        if Indexˉend.Status != Compilerˉbodyˉparseˉstatus.Valid { return Compilerˉbodyˉexpressionˉfailureˉfromˉstep(Indexˉend); }
        return Compilerˉbodyˉexpressionˉmake(Compilerˉsourceˉexpressionˉkind.Index, Compilerˉtokenˉkind.End, Name.Offset, Indexˉend.Nextˉoffset, Line, Column, Name.Offset, Name.Length, Index.Offset, Index.Length, Name.Offset, 0u32, Name.Offset, Name.Offset, 0u32, Compilerˉnumericˉkind.None, 0u32, false, Indexˉend.Nextˉoffset, Indexˉend.Nextˉline, Indexˉend.Nextˉcolumn, Index.Nodes + 1u32, Index.Depth + 1u32);
    }
    if Name.Parts == 2u32 {
        return Compilerˉbodyˉexpressionˉmake(Compilerˉsourceˉexpressionˉkind.Field, Compilerˉtokenˉkind.Dot, Name.Offset, Name.Offset + Name.Length, Line, Column, Name.Offset, Name.Length, Name.Firstˉoffset, Name.Firstˉlength, Name.Secondˉoffset, Name.Secondˉlength, Name.Offset, Name.Offset, 0u32, Compilerˉnumericˉkind.None, 0u32, false, Name.Nextˉoffset, Name.Nextˉline, Name.Nextˉcolumn, 1u32, 1u32);
    }
    return Compilerˉbodyˉexpressionˉmake(Compilerˉsourceˉexpressionˉkind.Name, Compilerˉtokenˉkind.End, Name.Offset, Name.Offset + Name.Length, Line, Column, Name.Offset, Name.Length, Name.Offset, 0u32, Name.Offset, 0u32, Name.Offset, Name.Offset, 0u32, Compilerˉnumericˉkind.None, 0u32, false, Name.Nextˉoffset, Name.Nextˉline, Name.Nextˉcolumn, 1u32, 1u32);
}

export fn Compilerˉparseˉexpressionˉvalidated(
    Input: bytes,
    Offset: u32,
    Line: u32,
    Column: u32,
    Endˉoffset: u32,
    Parentˉprecedence: u32,
    Nesting: u32
) -> Compilerˉsourceˉexpression {
    let Total: u32 = Bytesˉlength(Input);
    if Offset > Endˉoffset {
        let Invalidˉstart: Compilerˉsourceˉtoken = Compilerˉbodyˉtoken(Input, Total, Line, Column, Total);
        return Compilerˉbodyˉexpressionˉfailure(Compilerˉbodyˉparseˉstatus.Invalidˉspan, Invalidˉstart, Compilerˉtokenˉkind.Identifier);
    }
    if Endˉoffset > Total {
        let Invalidˉend: Compilerˉsourceˉtoken = Compilerˉbodyˉtoken(Input, Total, Line, Column, Total);
        return Compilerˉbodyˉexpressionˉfailure(Compilerˉbodyˉparseˉstatus.Invalidˉspan, Invalidˉend, Compilerˉtokenˉkind.Identifier);
    }
    if Nesting > 64u32 {
        let Invalidˉnesting: Compilerˉsourceˉtoken = Compilerˉbodyˉtoken(Input, Offset, Line, Column, Endˉoffset);
        return Compilerˉbodyˉexpressionˉfailure(Compilerˉbodyˉparseˉstatus.Nestingˉlimit, Invalidˉnesting, Compilerˉtokenˉkind.Identifier);
    }

    let First: Compilerˉsourceˉtoken = Compilerˉbodyˉtoken(Input, Offset, Line, Column, Endˉoffset);
    let Unaryˉprecedence: u32 = Compilerˉbodyˉunaryˉprecedence(First.Kind);
    var Left: Compilerˉsourceˉexpression = Compilerˉbodyˉexpressionˉfailure(Compilerˉbodyˉparseˉstatus.Expectedˉexpression, First, Compilerˉtokenˉkind.Identifier);
    if Unaryˉprecedence > 0u32 {
        if Unaryˉprecedence >= Parentˉprecedence {
            let Operand: Compilerˉsourceˉexpression = Compilerˉparseˉexpressionˉvalidated(Input, First.Nextˉoffset, First.Nextˉline, First.Nextˉcolumn, Endˉoffset, Unaryˉprecedence, Nesting + 1u32);
            if Operand.Status != Compilerˉbodyˉparseˉstatus.Valid { return Operand; }
            let Unaryˉdepth: u32 = Operand.Depth + 1u32;
            if Unaryˉdepth > 64u32 { return Compilerˉbodyˉexpressionˉfailure(Compilerˉbodyˉparseˉstatus.Nestingˉlimit, First, Compilerˉtokenˉkind.Identifier); }
            Left = Compilerˉbodyˉexpressionˉmake(Compilerˉsourceˉexpressionˉkind.Unary, First.Kind, First.Offset, Operand.Offset + Operand.Length, First.Line, First.Column, First.Offset, First.Length, Operand.Offset, Operand.Length, First.Offset, 0u32, First.Offset, First.Offset, 0u32, Compilerˉnumericˉkind.None, 0u32, false, Operand.Nextˉoffset, Operand.Nextˉline, Operand.Nextˉcolumn, Operand.Nodes + 1u32, Unaryˉdepth);
        } else {
            Left = Compilerˉbodyˉparseˉprimary(Input, Offset, Line, Column, Endˉoffset, Nesting);
        }
    } else {
        Left = Compilerˉbodyˉparseˉprimary(Input, Offset, Line, Column, Endˉoffset, Nesting);
    }
    if Left.Status != Compilerˉbodyˉparseˉstatus.Valid { return Left; }

    var Reading: bool = true;
    while Reading {
        let Operator: Compilerˉsourceˉtoken = Compilerˉbodyˉtoken(Input, Left.Nextˉoffset, Left.Nextˉline, Left.Nextˉcolumn, Endˉoffset);
        let Precedence: u32 = Compilerˉbodyˉbinaryˉprecedence(Operator.Kind);
        if Precedence == 0u32 {
            Reading = false;
        } else {
            if Precedence <= Parentˉprecedence {
                Reading = false;
            } else {
                let Right: Compilerˉsourceˉexpression = Compilerˉparseˉexpressionˉvalidated(Input, Operator.Nextˉoffset, Operator.Nextˉline, Operator.Nextˉcolumn, Endˉoffset, Precedence, Nesting + 1u32);
                if Right.Status != Compilerˉbodyˉparseˉstatus.Valid { return Right; }
                let Nodes: u32 = Left.Nodes + Right.Nodes + 1u32;
                let Binaryˉdepth: u32 = Compilerˉbodyˉmaximum(Left.Depth, Right.Depth) + 1u32;
                if Nodes > 4096u32 { return Compilerˉbodyˉexpressionˉfailure(Compilerˉbodyˉparseˉstatus.Itemˉlimit, Operator, Compilerˉtokenˉkind.End); }
                if Binaryˉdepth > 64u32 { return Compilerˉbodyˉexpressionˉfailure(Compilerˉbodyˉparseˉstatus.Nestingˉlimit, Operator, Compilerˉtokenˉkind.End); }
                Left = Compilerˉbodyˉexpressionˉmake(Compilerˉsourceˉexpressionˉkind.Binary, Operator.Kind, Left.Offset, Right.Offset + Right.Length, Left.Line, Left.Column, Operator.Offset, Operator.Length, Left.Offset, Left.Length, Right.Offset, Right.Length, Operator.Offset, Operator.Offset, 0u32, Compilerˉnumericˉkind.None, 0u32, false, Right.Nextˉoffset, Right.Nextˉline, Right.Nextˉcolumn, Nodes, Binaryˉdepth);
            }
        }
    }
    return Left;
}

export fn Compilerˉparseˉexpressionˉspan(
    Input: bytes,
    Offset: u32,
    Line: u32,
    Column: u32,
    Endˉoffset: u32
) -> Compilerˉsourceˉexpression {
    let Scan: Compilerˉsourceˉscan = Compilerˉlexˉsource(Input);
    if Scan.Status != Compilerˉlexˉstatus.Valid {
        let Token: Compilerˉsourceˉtoken = Compilerˉsourceˉtokenˉmake(
            Scan.Status,
            Compilerˉtokenˉkind.Bad,
            Scan.Failureˉoffset,
            Scan.Failureˉoffset,
            Scan.Failureˉline,
            Scan.Failureˉcolumn,
            Scan.Failureˉline,
            Scan.Failureˉcolumn,
            Compilerˉnumericˉkind.None,
            0u32,
            Scan.Failureˉoffset,
            Scan.Failureˉline,
            Scan.Failureˉcolumn
        );
        return Compilerˉbodyˉexpressionˉfailure(Compilerˉbodyˉparseˉstatus.Lexicalˉerror, Token, Compilerˉtokenˉkind.Identifier);
    }
    let Expression: Compilerˉsourceˉexpression = Compilerˉparseˉexpressionˉvalidated(Input, Offset, Line, Column, Endˉoffset, 0u32, 0u32);
    if Expression.Status != Compilerˉbodyˉparseˉstatus.Valid { return Expression; }
    let Trailing: Compilerˉsourceˉtoken = Compilerˉbodyˉtoken(Input, Expression.Nextˉoffset, Expression.Nextˉline, Expression.Nextˉcolumn, Endˉoffset);
    if Trailing.Kind != Compilerˉtokenˉkind.End {
        return Compilerˉbodyˉexpressionˉfailure(Compilerˉbodyˉparseˉstatus.Expectedˉtoken, Trailing, Compilerˉtokenˉkind.End);
    }
    return Expression;
}

export fn Compilerˉbodyˉstepˉfromˉdeclarationˉstep(
    Step: Compilerˉparseˉstep
) -> Compilerˉbodyˉparseˉstep {
    var Status: Compilerˉbodyˉparseˉstatus = Compilerˉbodyˉparseˉstatus.Expectedˉtoken;
    if Step.Status == Compilerˉparseˉstatus.Lexicalˉerror { Status = Compilerˉbodyˉparseˉstatus.Lexicalˉerror; }
    if Step.Status == Compilerˉparseˉstatus.Invalidˉtype { Status = Compilerˉbodyˉparseˉstatus.Invalidˉtype; }
    return Compilerˉbodyˉparseˉstep(
        Status,
        Step.Lexicalˉstatus,
        Step.Nextˉoffset,
        Step.Nextˉline,
        Step.Nextˉcolumn,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        Step.Failureˉoffset,
        Step.Failureˉline,
        Step.Failureˉcolumn,
        Step.Expected,
        Step.Found
    );
}

