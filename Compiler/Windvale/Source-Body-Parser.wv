}

export fn Compilerˉbodyˉmaximum(Left: u32, Right: u32) -> u32 {
    if Left >= Right { return Left; }
    return Right;
}

export fn Compilerˉbodyˉpositionˉbetween(
    Input: bytes,
    Start: u32,
    Startˉline: u32,
    Startˉcolumn: u32,
    Wanted: u32
) -> Compilerˉsourceˉposition {
    let Total: u32 = Bytesˉlength(Input);
    if Start > Wanted { return Compilerˉsourceˉposition(Start, Startˉline, Startˉcolumn); }
    if Wanted > Total { return Compilerˉsourceˉposition(Total, Startˉline, Startˉcolumn); }
    var Cursor: u32 = Start;
    var Line: u32 = Startˉline;
    var Column: u32 = Startˉcolumn;
    while Cursor < Wanted {
        if Bytesˉreadˉu8(Input, Cursor) == 10u8 {
            Line = Line + 1u32;
            Column = 1u32;
            Cursor = Cursor + 1u32;
        } else {
            let Width: u32 = Sourceˉlexer.Compilerˉsourceˉcolumnˉwidth(Input, Cursor);
            let Length: u32 = Sourceˉlexer.Compilerˉsourceˉutf8ˉlength(Input, Cursor);
            if Length == 0u32 { return Compilerˉsourceˉposition(Cursor, Line, Column); }
            if Length > Wanted - Cursor { return Compilerˉsourceˉposition(Cursor, Line, Column); }
            Column = Column + Width;
            Cursor = Cursor + Length;
        }
    }
    return Compilerˉsourceˉposition(Cursor, Line, Column);
}

export fn Compilerˉbodyˉtoken(
    Input: bytes,
    Offset: u32,
    Line: u32,
    Column: u32,
    Endˉoffset: u32
) -> Sourceˉlexer.Compilerˉsourceˉtoken {
    let Token: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(Input, Offset, Line, Column);
    if Token.Status != Sourceˉlexer.Compilerˉlexˉstatus.Valid { return Token; }
    if Token.Offset < Endˉoffset { return Token; }
    return Sourceˉlexer.Compilerˉsourceˉtokenˉmake(
        Sourceˉlexer.Compilerˉlexˉstatus.Valid,
        Sourceˉlexer.Compilerˉtokenˉkind.End,
        Endˉoffset,
        Endˉoffset,
        Token.Line,
        Token.Column,
        Token.Line,
        Token.Column,
        Sourceˉlexer.Compilerˉnumericˉkind.None,
        0u32,
        Endˉoffset,
        Token.Line,
        Token.Column
    );
}

export fn Compilerˉbodyˉstepˉvalid(
    Offset: u32,
    Line: u32,
    Column: u32,
    Statements: u32,
    Expressions: u32,
    Statementˉdepth: u32,
    Expressionˉdepth: u32
) -> Compilerˉbodyˉparseˉstep {
    return Compilerˉbodyˉparseˉstep(
        Compilerˉbodyˉparseˉstatus.Valid,
        Sourceˉlexer.Compilerˉlexˉstatus.Valid,
        Offset,
        Line,
        Column,
        0u32,
        Statements,
        Expressions,
        Statementˉdepth,
        Expressionˉdepth,
        Offset,
        Line,
        Column,
        Sourceˉlexer.Compilerˉtokenˉkind.End,
        Sourceˉlexer.Compilerˉtokenˉkind.End
    );
}

export fn Compilerˉbodyˉblockˉstepˉvalid(
    Offset: u32,
    Line: u32,
    Column: u32,
    Topˉlevelˉstatements: u32,
    Statements: u32,
    Expressions: u32,
    Statementˉdepth: u32,
    Expressionˉdepth: u32
) -> Compilerˉbodyˉparseˉstep {
    return Compilerˉbodyˉparseˉstep(
        Compilerˉbodyˉparseˉstatus.Valid,
        Sourceˉlexer.Compilerˉlexˉstatus.Valid,
        Offset,
        Line,
        Column,
        Topˉlevelˉstatements,
        Statements,
        Expressions,
        Statementˉdepth,
        Expressionˉdepth,
        Offset,
        Line,
        Column,
        Sourceˉlexer.Compilerˉtokenˉkind.End,
        Sourceˉlexer.Compilerˉtokenˉkind.End
    );
}

export fn Compilerˉbodyˉstepˉfailure(
    Status: Compilerˉbodyˉparseˉstatus,
    Lexicalˉstatus: Sourceˉlexer.Compilerˉlexˉstatus,
    Offset: u32,
    Line: u32,
    Column: u32,
    Expected: Sourceˉlexer.Compilerˉtokenˉkind,
    Found: Sourceˉlexer.Compilerˉtokenˉkind
) -> Compilerˉbodyˉparseˉstep {
    return Compilerˉbodyˉparseˉstep(
        Status,
        Lexicalˉstatus,
        Offset,
        Line,
        Column,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        Offset,
        Line,
        Column,
        Expected,
        Found
    );
}

export fn Compilerˉbodyˉstepˉfromˉtoken(
    Status: Compilerˉbodyˉparseˉstatus,
    Token: Sourceˉlexer.Compilerˉsourceˉtoken,
    Expected: Sourceˉlexer.Compilerˉtokenˉkind
) -> Compilerˉbodyˉparseˉstep {
    if Token.Status != Sourceˉlexer.Compilerˉlexˉstatus.Valid {
        return Compilerˉbodyˉstepˉfailure(
            Compilerˉbodyˉparseˉstatus.Lexicalˉerror,
            Token.Status,
            Token.Failureˉoffset,
            Token.Failureˉline,
            Token.Failureˉcolumn,
            Expected,
            Token.Kind
        );
    }
    return Compilerˉbodyˉstepˉfailure(Status, Sourceˉlexer.Compilerˉlexˉstatus.Valid, Token.Offset, Token.Line, Token.Column, Expected, Token.Kind);
}

export fn Compilerˉbodyˉconsume(
    Input: bytes,
    Offset: u32,
    Line: u32,
    Column: u32,
    Endˉoffset: u32,
    Expected: Sourceˉlexer.Compilerˉtokenˉkind
) -> Compilerˉbodyˉparseˉstep {
    let Token: Sourceˉlexer.Compilerˉsourceˉtoken = Compilerˉbodyˉtoken(Input, Offset, Line, Column, Endˉoffset);
    if Token.Status != Sourceˉlexer.Compilerˉlexˉstatus.Valid {
        return Compilerˉbodyˉstepˉfromˉtoken(Compilerˉbodyˉparseˉstatus.Lexicalˉerror, Token, Expected);
    }
    if Token.Kind != Expected {
        return Compilerˉbodyˉstepˉfromˉtoken(Compilerˉbodyˉparseˉstatus.Expectedˉtoken, Token, Expected);
    }
    return Compilerˉbodyˉstepˉvalid(Token.Nextˉoffset, Token.Nextˉline, Token.Nextˉcolumn, 0u32, 0u32, 0u32, 0u32);
}

export fn Compilerˉbodyˉnameˉfailure(
    Status: Compilerˉbodyˉparseˉstatus,
    Token: Sourceˉlexer.Compilerˉsourceˉtoken
) -> Compilerˉsourceˉnameˉview {
    var Bodyˉstatus: Compilerˉbodyˉparseˉstatus = Status;
    if Token.Status != Sourceˉlexer.Compilerˉlexˉstatus.Valid { Bodyˉstatus = Compilerˉbodyˉparseˉstatus.Lexicalˉerror; }
    return Compilerˉsourceˉnameˉview(
        Bodyˉstatus,
        Token.Status,
        Token.Offset,
        0u32,
        0u32,
        Token.Offset,
        0u32,
        Token.Offset,
        0u32,
        Token.Offset,
        Token.Line,
        Token.Column,
        Token.Failureˉoffset,
        Token.Failureˉline,
        Token.Failureˉcolumn,
        Sourceˉlexer.Compilerˉtokenˉkind.Identifier,
        Token.Kind
    );
}

export fn Compilerˉbodyˉparseˉname(
    Input: bytes,
    Offset: u32,
    Line: u32,
    Column: u32,
    Endˉoffset: u32,
    Allowˉlength: bool
) -> Compilerˉsourceˉnameˉview {
    let First: Sourceˉlexer.Compilerˉsourceˉtoken = Compilerˉbodyˉtoken(Input, Offset, Line, Column, Endˉoffset);
    var Accepted: bool = First.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Identifier;
    if Allowˉlength {
        if First.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Length { Accepted = true; }
    }
    if First.Status != Sourceˉlexer.Compilerˉlexˉstatus.Valid { return Compilerˉbodyˉnameˉfailure(Compilerˉbodyˉparseˉstatus.Lexicalˉerror, First); }
    if !Accepted { return Compilerˉbodyˉnameˉfailure(Compilerˉbodyˉparseˉstatus.Expectedˉtoken, First); }

    var Cursor: u32 = First.Nextˉoffset;
    var Currentˉline: u32 = First.Nextˉline;
    var Currentˉcolumn: u32 = First.Nextˉcolumn;
    var End: u32 = First.Nextˉoffset;
    var Parts: u32 = 1u32;
    var Secondˉoffset: u32 = First.Offset;
    var Secondˉlength: u32 = 0u32;
    var Reading: bool = true;
    while Reading {
        let Dot: Sourceˉlexer.Compilerˉsourceˉtoken = Compilerˉbodyˉtoken(Input, Cursor, Currentˉline, Currentˉcolumn, Endˉoffset);
        if Dot.Kind != Sourceˉlexer.Compilerˉtokenˉkind.Dot {
            Reading = false;
        } else {
            let Part: Sourceˉlexer.Compilerˉsourceˉtoken = Compilerˉbodyˉtoken(Input, Dot.Nextˉoffset, Dot.Nextˉline, Dot.Nextˉcolumn, Endˉoffset);
            if Part.Status != Sourceˉlexer.Compilerˉlexˉstatus.Valid { return Compilerˉbodyˉnameˉfailure(Compilerˉbodyˉparseˉstatus.Lexicalˉerror, Part); }
            if Part.Kind != Sourceˉlexer.Compilerˉtokenˉkind.Identifier { return Compilerˉbodyˉnameˉfailure(Compilerˉbodyˉparseˉstatus.Expectedˉtoken, Part); }
            Parts = Parts + 1u32;
            if Parts > 16u32 { return Compilerˉbodyˉnameˉfailure(Compilerˉbodyˉparseˉstatus.Itemˉlimit, Part); }
            if Parts == 2u32 {
                Secondˉoffset = Part.Offset;
                Secondˉlength = Part.Length;
            }
            Cursor = Part.Nextˉoffset;
            Currentˉline = Part.Nextˉline;
            Currentˉcolumn = Part.Nextˉcolumn;
            End = Part.Nextˉoffset;
        }
    }
    return Compilerˉsourceˉnameˉview(
        Compilerˉbodyˉparseˉstatus.Valid,
        Sourceˉlexer.Compilerˉlexˉstatus.Valid,
        First.Offset,
        End - First.Offset,
        Parts,
        First.Offset,
        First.Length,
        Secondˉoffset,
        Secondˉlength,
        Cursor,
        Currentˉline,
        Currentˉcolumn,
        Cursor,
        Currentˉline,
        Currentˉcolumn,
        Sourceˉlexer.Compilerˉtokenˉkind.End,
        Sourceˉlexer.Compilerˉtokenˉkind.End
    );
}

export fn Compilerˉbodyˉexpressionˉmake(
    Kind: Compilerˉsourceˉexpressionˉkind,
    Operator: Sourceˉlexer.Compilerˉtokenˉkind,
    Offset: u32,
    End: u32,
    Line: u32,
    Column: u32,
    Valueˉoffset: u32,
    Valueˉlength: u32,
    Firstˉoffset: u32,
    Firstˉlength: u32,
    Secondˉoffset: u32,
    Secondˉlength: u32,
    Itemsˉoffset: u32,
    Itemsˉend: u32,
    Items: u32,
    Numericˉkind: Sourceˉlexer.Compilerˉnumericˉkind,
    Numericˉvalue: u32,
    Booleanˉvalue: bool,
    Nextˉoffset: u32,
    Nextˉline: u32,
    Nextˉcolumn: u32,
    Nodes: u32,
    Depth: u32
) -> Compilerˉsourceˉexpression {
    return Compilerˉbodyˉexpressionˉmakeˉwide(
        Kind, Operator, Offset, End, Line, Column,
        Valueˉoffset, Valueˉlength, Firstˉoffset, Firstˉlength,
        Secondˉoffset, Secondˉlength, Itemsˉoffset, Itemsˉend, Items,
        Numericˉkind, Numericˉvalue, 0u32, Booleanˉvalue,
        Nextˉoffset, Nextˉline, Nextˉcolumn, Nodes, Depth
    );
}

fn Compilerˉbodyˉexpressionˉmakeˉwide(
    Kind: Compilerˉsourceˉexpressionˉkind,
    Operator: Sourceˉlexer.Compilerˉtokenˉkind,
    Offset: u32,
    End: u32,
    Line: u32,
    Column: u32,
    Valueˉoffset: u32,
    Valueˉlength: u32,
    Firstˉoffset: u32,
    Firstˉlength: u32,
    Secondˉoffset: u32,
    Secondˉlength: u32,
    Itemsˉoffset: u32,
    Itemsˉend: u32,
    Items: u32,
    Numericˉkind: Sourceˉlexer.Compilerˉnumericˉkind,
    Numericˉvalue: u32,
    Numericˉhigh: u32,
    Booleanˉvalue: bool,
    Nextˉoffset: u32,
    Nextˉline: u32,
    Nextˉcolumn: u32,
    Nodes: u32,
    Depth: u32
) -> Compilerˉsourceˉexpression {
    return Compilerˉsourceˉexpression(
        Compilerˉbodyˉparseˉstatus.Valid,
        Sourceˉlexer.Compilerˉlexˉstatus.Valid,
        Kind,
        Operator,
        Offset,
        End - Offset,
        Line,
        Column,
        Valueˉoffset,
        Valueˉlength,
        Firstˉoffset,
        Firstˉlength,
        Secondˉoffset,
        Secondˉlength,
        Itemsˉoffset,
        Itemsˉend - Itemsˉoffset,
        Items,
        Numericˉkind,
        Numericˉvalue,
        Numericˉhigh,
        Booleanˉvalue,
        Nextˉoffset,
        Nextˉline,
        Nextˉcolumn,
        Nodes,
        Depth,
        Nextˉoffset,
        Nextˉline,
        Nextˉcolumn,
        Sourceˉlexer.Compilerˉtokenˉkind.End,
        Sourceˉlexer.Compilerˉtokenˉkind.End
    );
}

export fn Compilerˉbodyˉexpressionˉfailure(
    Status: Compilerˉbodyˉparseˉstatus,
    Token: Sourceˉlexer.Compilerˉsourceˉtoken,
    Expected: Sourceˉlexer.Compilerˉtokenˉkind
) -> Compilerˉsourceˉexpression {
    var Bodyˉstatus: Compilerˉbodyˉparseˉstatus = Status;
    var Failureˉoffset: u32 = Token.Offset;
    var Failureˉline: u32 = Token.Line;
    var Failureˉcolumn: u32 = Token.Column;
    if Token.Status != Sourceˉlexer.Compilerˉlexˉstatus.Valid {
        Bodyˉstatus = Compilerˉbodyˉparseˉstatus.Lexicalˉerror;
        Failureˉoffset = Token.Failureˉoffset;
        Failureˉline = Token.Failureˉline;
        Failureˉcolumn = Token.Failureˉcolumn;
    }
    return Compilerˉsourceˉexpression(
        Bodyˉstatus,
        Token.Status,
        Compilerˉsourceˉexpressionˉkind.Invalid,
        Sourceˉlexer.Compilerˉtokenˉkind.End,
        Token.Offset,
        0u32,
        Token.Line,
        Token.Column,
        Token.Offset,
        0u32,
        Token.Offset,
        0u32,
        Token.Offset,
        0u32,
        Token.Offset,
        0u32,
        0u32,
        Sourceˉlexer.Compilerˉnumericˉkind.None,
        0u32,
        0u32,
        false,
        Token.Offset,
        Token.Line,
        Token.Column,
        0u32,
        0u32,
        Failureˉoffset,
        Failureˉline,
        Failureˉcolumn,
        Expected,
        Token.Kind
    );
}

export fn Compilerˉbodyˉexpressionˉfailureˉfromˉstep(
    Step: Compilerˉbodyˉparseˉstep
) -> Compilerˉsourceˉexpression {
    return Compilerˉsourceˉexpression(
        Step.Status,
        Step.Lexicalˉstatus,
        Compilerˉsourceˉexpressionˉkind.Invalid,
        Sourceˉlexer.Compilerˉtokenˉkind.End,
        Step.Failureˉoffset,
        0u32,
        Step.Failureˉline,
        Step.Failureˉcolumn,
        Step.Failureˉoffset,
        0u32,
        Step.Failureˉoffset,
        0u32,
        Step.Failureˉoffset,
        0u32,
        Step.Failureˉoffset,
        0u32,
        0u32,
        Sourceˉlexer.Compilerˉnumericˉkind.None,
        0u32,
        0u32,
        false,
        Step.Nextˉoffset,
        Step.Nextˉline,
        Step.Nextˉcolumn,
        0u32,
        0u32,
        Step.Failureˉoffset,
        Step.Failureˉline,
        Step.Failureˉcolumn,
        Step.Expected,
        Step.Found
    );
}

export fn Compilerˉbodyˉunaryˉprecedence(Kind: Sourceˉlexer.Compilerˉtokenˉkind) -> u32 {
    if Kind == Sourceˉlexer.Compilerˉtokenˉkind.Minus { return 13u32; }
    if Kind == Sourceˉlexer.Compilerˉtokenˉkind.Bang { return 13u32; }
    if Kind == Sourceˉlexer.Compilerˉtokenˉkind.Tilde { return 13u32; }
    if Kind == Sourceˉlexer.Compilerˉtokenˉkind.Freeze { return 13u32; }
    if Kind == Sourceˉlexer.Compilerˉtokenˉkind.Try { return 13u32; }
    if Kind == Sourceˉlexer.Compilerˉtokenˉkind.Await { return 13u32; }
    if Kind == Sourceˉlexer.Compilerˉtokenˉkind.Borrow { return 13u32; }
    return 0u32;
}

export fn Compilerˉbodyˉbinaryˉprecedence(Kind: Sourceˉlexer.Compilerˉtokenˉkind) -> u32 {
    if Kind == Sourceˉlexer.Compilerˉtokenˉkind.Orˉor { return 3u32; }
    if Kind == Sourceˉlexer.Compilerˉtokenˉkind.Andˉand { return 4u32; }
    if Kind == Sourceˉlexer.Compilerˉtokenˉkind.Pipe { return 5u32; }
    if Kind == Sourceˉlexer.Compilerˉtokenˉkind.Caret { return 6u32; }
    if Kind == Sourceˉlexer.Compilerˉtokenˉkind.Ampersand { return 7u32; }
    if Kind == Sourceˉlexer.Compilerˉtokenˉkind.Equalsˉequals { return 8u32; }
    if Kind == Sourceˉlexer.Compilerˉtokenˉkind.Bangˉequals { return 8u32; }
    if Kind == Sourceˉlexer.Compilerˉtokenˉkind.Less { return 9u32; }
    if Kind == Sourceˉlexer.Compilerˉtokenˉkind.Lessˉequals { return 9u32; }
    if Kind == Sourceˉlexer.Compilerˉtokenˉkind.Greater { return 9u32; }
    if Kind == Sourceˉlexer.Compilerˉtokenˉkind.Greaterˉequals { return 9u32; }
    if Kind == Sourceˉlexer.Compilerˉtokenˉkind.Shiftˉleft { return 10u32; }
    if Kind == Sourceˉlexer.Compilerˉtokenˉkind.Shiftˉright { return 10u32; }
    if Kind == Sourceˉlexer.Compilerˉtokenˉkind.Plus { return 11u32; }
    if Kind == Sourceˉlexer.Compilerˉtokenˉkind.Minus { return 11u32; }
    if Kind == Sourceˉlexer.Compilerˉtokenˉkind.Star { return 12u32; }
    if Kind == Sourceˉlexer.Compilerˉtokenˉkind.Slash { return 12u32; }
    if Kind == Sourceˉlexer.Compilerˉtokenˉkind.Percent { return 12u32; }
    return 0u32;
}

export fn Compilerˉbodyˉisˉassignmentˉoperator(Kind: Sourceˉlexer.Compilerˉtokenˉkind) -> bool {
    if Kind == Sourceˉlexer.Compilerˉtokenˉkind.Equals { return true; }
    if Kind == Sourceˉlexer.Compilerˉtokenˉkind.Plusˉequals { return true; }
    if Kind == Sourceˉlexer.Compilerˉtokenˉkind.Minusˉequals { return true; }
    if Kind == Sourceˉlexer.Compilerˉtokenˉkind.Starˉequals { return true; }
    return false;
}

fn Compilerˉbodyˉparseˉrecordˉfields(
    Input: bytes,
    Endˉoffset: u32,
    Nesting: u32,
    Name: Compilerˉsourceˉnameˉview,
    Left: Sourceˉlexer.Compilerˉsourceˉtoken,
    Kind: Compilerˉsourceˉexpressionˉkind,
    Baseˉoffset: u32,
    Baseˉlength: u32,
    Baseˉnodes: u32,
    Baseˉdepth: u32,
    Line: u32,
    Column: u32
) -> Compilerˉsourceˉexpression {
    var Recordˉcursor: u32 = Left.Nextˉoffset;
    var Recordˉline: u32 = Left.Nextˉline;
    var Recordˉcolumn: u32 = Left.Nextˉcolumn;
    let Firstˉfield: Sourceˉlexer.Compilerˉsourceˉtoken = Compilerˉbodyˉtoken(
        Input, Recordˉcursor, Recordˉline, Recordˉcolumn, Endˉoffset
    );
    var Recordˉitemsˉoffset: u32 = Firstˉfield.Offset;
    var Recordˉitemsˉend: u32 = Firstˉfield.Offset;
    var Recordˉitems: u32 = 0u32;
    var Recordˉnodes: u32 = 1u32 + Baseˉnodes;
    var Recordˉdepth: u32 = 1u32;
    if Baseˉnodes > 0u32 {
        Recordˉdepth = Compilerˉbodyˉmaximum(
            Recordˉdepth, Baseˉdepth + 1u32
        );
    }
    if Recordˉdepth > 64u32 {
        return Compilerˉbodyˉexpressionˉfailure(
            Compilerˉbodyˉparseˉstatus.Nestingˉlimit,
            Left,
            Sourceˉlexer.Compilerˉtokenˉkind.Rightˉbrace
        );
    }
    if Recordˉnodes > 4096u32 {
        return Compilerˉbodyˉexpressionˉfailure(
            Compilerˉbodyˉparseˉstatus.Itemˉlimit,
            Left,
            Sourceˉlexer.Compilerˉtokenˉkind.Rightˉbrace
        );
    }
    var Recordˉreading: bool = true;
    while Recordˉreading {
        let Field: Sourceˉlexer.Compilerˉsourceˉtoken = Compilerˉbodyˉtoken(
            Input, Recordˉcursor, Recordˉline, Recordˉcolumn, Endˉoffset
        );
        if Field.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Rightˉbrace {
            Recordˉreading = false;
            let Recordˉend: Compilerˉbodyˉparseˉstep = Compilerˉbodyˉconsume(
                Input, Recordˉcursor, Recordˉline, Recordˉcolumn,
                Endˉoffset, Sourceˉlexer.Compilerˉtokenˉkind.Rightˉbrace
            );
            if Recordˉend.Status != Compilerˉbodyˉparseˉstatus.Valid {
                return Compilerˉbodyˉexpressionˉfailureˉfromˉstep(Recordˉend);
            }
            return Compilerˉbodyˉexpressionˉmake(
                Kind,
                Sourceˉlexer.Compilerˉtokenˉkind.End,
                Name.Offset,
                Recordˉend.Nextˉoffset,
                Line,
                Column,
                Name.Offset,
                Name.Length,
                Baseˉoffset,
                Baseˉlength,
                Name.Offset,
                0u32,
                Recordˉitemsˉoffset,
                Recordˉitemsˉend,
                Recordˉitems,
                Sourceˉlexer.Compilerˉnumericˉkind.None,
                0u32,
                false,
                Recordˉend.Nextˉoffset,
                Recordˉend.Nextˉline,
                Recordˉend.Nextˉcolumn,
                Recordˉnodes,
                Recordˉdepth
            );
        }
        if Recordˉitems >= 64u32 {
            return Compilerˉbodyˉexpressionˉfailure(
                Compilerˉbodyˉparseˉstatus.Itemˉlimit,
                Field,
                Sourceˉlexer.Compilerˉtokenˉkind.Rightˉbrace
            );
        }
        let Afterˉfield: Compilerˉbodyˉparseˉstep = Compilerˉbodyˉconsume(
            Input, Recordˉcursor, Recordˉline, Recordˉcolumn,
            Endˉoffset, Sourceˉlexer.Compilerˉtokenˉkind.Identifier
        );
        if Afterˉfield.Status != Compilerˉbodyˉparseˉstatus.Valid {
            return Compilerˉbodyˉexpressionˉfailureˉfromˉstep(Afterˉfield);
        }
        let Afterˉcolon: Compilerˉbodyˉparseˉstep = Compilerˉbodyˉconsume(
            Input, Afterˉfield.Nextˉoffset, Afterˉfield.Nextˉline,
            Afterˉfield.Nextˉcolumn, Endˉoffset,
            Sourceˉlexer.Compilerˉtokenˉkind.Colon
        );
        if Afterˉcolon.Status != Compilerˉbodyˉparseˉstatus.Valid {
            return Compilerˉbodyˉexpressionˉfailureˉfromˉstep(Afterˉcolon);
        }
        let Fieldˉvalue: Compilerˉsourceˉexpression = Compilerˉparseˉexpressionˉvalidated(
            Input, Afterˉcolon.Nextˉoffset, Afterˉcolon.Nextˉline,
            Afterˉcolon.Nextˉcolumn, Endˉoffset, 0u32, Nesting + 1u32
        );
        if Fieldˉvalue.Status != Compilerˉbodyˉparseˉstatus.Valid {
            return Fieldˉvalue;
        }
        Recordˉitemsˉend = Fieldˉvalue.Offset + Fieldˉvalue.Length;
        Recordˉitems = Recordˉitems + 1u32;
        Recordˉnodes = Recordˉnodes + Fieldˉvalue.Nodes;
        Recordˉdepth = Compilerˉbodyˉmaximum(
            Recordˉdepth, Fieldˉvalue.Depth + 1u32
        );
        if Recordˉnodes > 4096u32 {
            return Compilerˉbodyˉexpressionˉfailure(
                Compilerˉbodyˉparseˉstatus.Itemˉlimit,
                Field,
                Sourceˉlexer.Compilerˉtokenˉkind.Rightˉbrace
            );
        }
        Recordˉcursor = Fieldˉvalue.Nextˉoffset;
        Recordˉline = Fieldˉvalue.Nextˉline;
        Recordˉcolumn = Fieldˉvalue.Nextˉcolumn;
        let Recordˉseparator: Sourceˉlexer.Compilerˉsourceˉtoken = Compilerˉbodyˉtoken(
            Input, Recordˉcursor, Recordˉline, Recordˉcolumn, Endˉoffset
        );
        if Recordˉseparator.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Comma {
            Recordˉcursor = Recordˉseparator.Nextˉoffset;
            Recordˉline = Recordˉseparator.Nextˉline;
            Recordˉcolumn = Recordˉseparator.Nextˉcolumn;
        } else {
            if Recordˉseparator.Kind != Sourceˉlexer.Compilerˉtokenˉkind.Rightˉbrace {
                return Compilerˉbodyˉexpressionˉfailure(
                    Compilerˉbodyˉparseˉstatus.Expectedˉtoken,
                    Recordˉseparator,
                    Sourceˉlexer.Compilerˉtokenˉkind.Rightˉbrace
                );
            }
        }
    }
    return Compilerˉbodyˉexpressionˉfailure(
        Compilerˉbodyˉparseˉstatus.Expectedˉtoken,
        Firstˉfield,
        Sourceˉlexer.Compilerˉtokenˉkind.Rightˉbrace
    );
}

export fn Compilerˉbodyˉvalueˉblockˉfailure(
    Step: Compilerˉbodyˉparseˉstep
) -> Compilerˉsourceˉvalueˉblock {
    return Compilerˉsourceˉvalueˉblock(
        Step.Status,
        Step.Lexicalˉstatus,
        Step.Failureˉoffset,
        0u32,
        Step.Failureˉoffset,
        0u32,
        Step.Failureˉoffset,
        0u32,
        Step.Nextˉoffset,
        Step.Nextˉline,
        Step.Nextˉcolumn,
        0u32,
        0u32,
        0u32,
        0u32,
        Step.Failureˉoffset,
        Step.Failureˉline,
        Step.Failureˉcolumn,
        Step.Expected,
        Step.Found
    );
}

export fn Compilerˉbodyˉexpressionˉfailureˉfromˉvalueˉblock(
    Block: Compilerˉsourceˉvalueˉblock
) -> Compilerˉsourceˉexpression {
    let Token: Sourceˉlexer.Compilerˉsourceˉtoken =
        Sourceˉlexer.Compilerˉsourceˉtokenˉmake(
            Block.Lexicalˉstatus,
            Block.Found,
            Block.Failureˉoffset,
            Block.Failureˉoffset,
            Block.Failureˉline,
            Block.Failureˉcolumn,
            Block.Failureˉline,
            Block.Failureˉcolumn,
            Sourceˉlexer.Compilerˉnumericˉkind.None,
            0u32,
            Block.Failureˉoffset,
            Block.Failureˉline,
            Block.Failureˉcolumn
        );
    return Compilerˉbodyˉexpressionˉfailure(
        Block.Status, Token, Block.Expected
    );
}

export fn Compilerˉbodyˉparseˉvalueˉblock(
    Input: bytes,
    Offset: u32,
    Line: u32,
    Column: u32,
    Endˉoffset: u32,
    Statementˉnesting: u32
) -> Compilerˉsourceˉvalueˉblock {
    let Total: u32 = Bytesˉlength(Input);
    if Offset > Endˉoffset || Endˉoffset > Total {
        return Compilerˉbodyˉvalueˉblockˉfailure(
            Compilerˉbodyˉstepˉfailure(
                Compilerˉbodyˉparseˉstatus.Invalidˉspan,
                Sourceˉlexer.Compilerˉlexˉstatus.Valid,
                Offset, Line, Column,
                Sourceˉlexer.Compilerˉtokenˉkind.Leftˉbrace,
                Sourceˉlexer.Compilerˉtokenˉkind.End
            )
        );
    }
    if Statementˉnesting > 64u32 {
        return Compilerˉbodyˉvalueˉblockˉfailure(
            Compilerˉbodyˉstepˉfailure(
                Compilerˉbodyˉparseˉstatus.Nestingˉlimit,
                Sourceˉlexer.Compilerˉlexˉstatus.Valid,
                Offset, Line, Column,
                Sourceˉlexer.Compilerˉtokenˉkind.Rightˉbrace,
                Sourceˉlexer.Compilerˉtokenˉkind.Leftˉbrace
            )
        );
    }
    let Left: Sourceˉlexer.Compilerˉsourceˉtoken = Compilerˉbodyˉtoken(
        Input, Offset, Line, Column, Endˉoffset
    );
    if Left.Kind != Sourceˉlexer.Compilerˉtokenˉkind.Leftˉbrace {
        return Compilerˉbodyˉvalueˉblockˉfailure(
            Compilerˉbodyˉstepˉfromˉtoken(
                Compilerˉbodyˉparseˉstatus.Expectedˉtoken,
                Left,
                Sourceˉlexer.Compilerˉtokenˉkind.Leftˉbrace
            )
        );
    }
    var Cursor: u32 = Left.Nextˉoffset;
    var Currentˉline: u32 = Left.Nextˉline;
    var Currentˉcolumn: u32 = Left.Nextˉcolumn;
    var Statements: u32 = 0u32;
    var Expressions: u32 = 0u32;
    var Statementˉdepth: u32 = 0u32;
    var Expressionˉdepth: u32 = 0u32;
    var Parsing: bool = true;
    while Parsing {
        let Current: Sourceˉlexer.Compilerˉsourceˉtoken = Compilerˉbodyˉtoken(
            Input, Cursor, Currentˉline, Currentˉcolumn, Endˉoffset
        );
        if Current.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Rightˉbrace ||
            Current.Kind == Sourceˉlexer.Compilerˉtokenˉkind.End {
            return Compilerˉbodyˉvalueˉblockˉfailure(
                Compilerˉbodyˉstepˉfromˉtoken(
                    Compilerˉbodyˉparseˉstatus.Expectedˉexpression,
                    Current,
                    Sourceˉlexer.Compilerˉtokenˉkind.Identifier
                )
            );
        }
        let Value: Compilerˉsourceˉexpression =
            Compilerˉparseˉexpressionˉvalidated(
                Input, Cursor, Currentˉline, Currentˉcolumn,
                Endˉoffset, 0u32, Statementˉnesting + 1u32
            );
        if Value.Status == Compilerˉbodyˉparseˉstatus.Valid {
            let Right: Sourceˉlexer.Compilerˉsourceˉtoken = Compilerˉbodyˉtoken(
                Input, Value.Nextˉoffset, Value.Nextˉline,
                Value.Nextˉcolumn, Endˉoffset
            );
            if Right.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Rightˉbrace {
                let Totalˉexpressions: u32 = Expressions + Value.Nodes;
                if Totalˉexpressions > 262144u32 {
                    return Compilerˉbodyˉvalueˉblockˉfailure(
                        Compilerˉbodyˉstepˉfromˉtoken(
                            Compilerˉbodyˉparseˉstatus.Itemˉlimit,
                            Current,
                            Sourceˉlexer.Compilerˉtokenˉkind.Rightˉbrace
                        )
                    );
                }
                return Compilerˉsourceˉvalueˉblock(
                    Compilerˉbodyˉparseˉstatus.Valid,
                    Sourceˉlexer.Compilerˉlexˉstatus.Valid,
                    Left.Offset,
                    Right.Nextˉoffset - Left.Offset,
                    Left.Nextˉoffset,
                    Value.Offset - Left.Nextˉoffset,
                    Value.Offset,
                    Value.Length,
                    Right.Nextˉoffset,
                    Right.Nextˉline,
                    Right.Nextˉcolumn,
                    Statements,
                    Totalˉexpressions,
                    Statementˉdepth,
                    Compilerˉbodyˉmaximum(Expressionˉdepth, Value.Depth),
                    Right.Nextˉoffset,
                    Right.Nextˉline,
                    Right.Nextˉcolumn,
                    Sourceˉlexer.Compilerˉtokenˉkind.End,
                    Sourceˉlexer.Compilerˉtokenˉkind.End
                );
            }
            if Right.Kind == Sourceˉlexer.Compilerˉtokenˉkind.End {
                return Compilerˉbodyˉvalueˉblockˉfailure(
                    Compilerˉbodyˉstepˉfromˉtoken(
                        Compilerˉbodyˉparseˉstatus.Expectedˉtoken,
                        Right,
                        Sourceˉlexer.Compilerˉtokenˉkind.Rightˉbrace
                    )
                );
            }
        }
        let Statement: Compilerˉsourceˉstatement =
            Compilerˉparseˉnextˉstatementˉvalidated(
                Input, Cursor, Currentˉline, Currentˉcolumn,
                Endˉoffset, Statementˉnesting
            );
        if Statement.Status != Compilerˉbodyˉparseˉstatus.Valid {
            if Value.Status != Compilerˉbodyˉparseˉstatus.Valid {
                return Compilerˉbodyˉvalueˉblockˉfailure(
                    Compilerˉbodyˉstepˉfromˉexpression(Value)
                );
            }
            return Compilerˉbodyˉvalueˉblockˉfailure(
                Compilerˉbodyˉstepˉfromˉstatement(Statement)
            );
        }
        Statements = Statements + Statement.Statements;
        Expressions = Expressions + Statement.Expressions;
        if Statements > 4096u32 || Expressions > 262144u32 {
            return Compilerˉbodyˉvalueˉblockˉfailure(
                Compilerˉbodyˉstepˉfromˉtoken(
                    Compilerˉbodyˉparseˉstatus.Itemˉlimit,
                    Current,
                    Sourceˉlexer.Compilerˉtokenˉkind.Rightˉbrace
                )
            );
        }
        Statementˉdepth = Compilerˉbodyˉmaximum(
            Statementˉdepth, Statement.Maximumˉstatementˉdepth
        );
        Expressionˉdepth = Compilerˉbodyˉmaximum(
            Expressionˉdepth, Statement.Maximumˉexpressionˉdepth
        );
        Cursor = Statement.Nextˉoffset;
        Currentˉline = Statement.Nextˉline;
        Currentˉcolumn = Statement.Nextˉcolumn;
    }
    return Compilerˉbodyˉvalueˉblockˉfailure(
        Compilerˉbodyˉstepˉfailure(
            Compilerˉbodyˉparseˉstatus.Expectedˉexpression,
            Sourceˉlexer.Compilerˉlexˉstatus.Valid,
            Cursor, Currentˉline, Currentˉcolumn,
            Sourceˉlexer.Compilerˉtokenˉkind.Identifier,
            Sourceˉlexer.Compilerˉtokenˉkind.End
        )
    );
}

export fn Compilerˉbodyˉparseˉifˉexpression(
    Input: bytes,
    Start: Sourceˉlexer.Compilerˉsourceˉtoken,
    Endˉoffset: u32,
    Nesting: u32
) -> Compilerˉsourceˉexpression {
    let Condition: Compilerˉsourceˉexpression =
        Compilerˉparseˉexpressionˉvalidated(
            Input, Start.Nextˉoffset, Start.Nextˉline, Start.Nextˉcolumn,
            Endˉoffset, 0u32, Nesting + 1u32
        );
    if Condition.Status != Compilerˉbodyˉparseˉstatus.Valid { return Condition; }
    let Then: Compilerˉsourceˉvalueˉblock = Compilerˉbodyˉparseˉvalueˉblock(
        Input, Condition.Nextˉoffset, Condition.Nextˉline,
        Condition.Nextˉcolumn, Endˉoffset, Nesting + 1u32
    );
    if Then.Status != Compilerˉbodyˉparseˉstatus.Valid {
        return Compilerˉbodyˉexpressionˉfailureˉfromˉvalueˉblock(Then);
    }
    let Elseˉtoken: Sourceˉlexer.Compilerˉsourceˉtoken = Compilerˉbodyˉtoken(
        Input, Then.Nextˉoffset, Then.Nextˉline, Then.Nextˉcolumn, Endˉoffset
    );
    if Elseˉtoken.Kind != Sourceˉlexer.Compilerˉtokenˉkind.Else {
        return Compilerˉbodyˉexpressionˉfailure(
            Compilerˉbodyˉparseˉstatus.Expectedˉtoken,
            Elseˉtoken,
            Sourceˉlexer.Compilerˉtokenˉkind.Else
        );
    }
    let Elseˉstart: Sourceˉlexer.Compilerˉsourceˉtoken = Compilerˉbodyˉtoken(
        Input, Elseˉtoken.Nextˉoffset, Elseˉtoken.Nextˉline,
        Elseˉtoken.Nextˉcolumn, Endˉoffset
    );
    var Elseˉoffset: u32 = Elseˉstart.Offset;
    var Elseˉlength: u32 = 0u32;
    var Nextˉoffset: u32 = Elseˉstart.Offset;
    var Nextˉline: u32 = Elseˉstart.Line;
    var Nextˉcolumn: u32 = Elseˉstart.Column;
    var Elseˉnodes: u32 = 0u32;
    var Elseˉdepth: u32 = 0u32;
    if Elseˉstart.Kind == Sourceˉlexer.Compilerˉtokenˉkind.If {
        let Nested: Compilerˉsourceˉexpression =
            Compilerˉbodyˉparseˉifˉexpression(
                Input, Elseˉstart, Endˉoffset, Nesting + 1u32
            );
        if Nested.Status != Compilerˉbodyˉparseˉstatus.Valid { return Nested; }
        Elseˉlength = Nested.Length;
        Nextˉoffset = Nested.Nextˉoffset;
        Nextˉline = Nested.Nextˉline;
        Nextˉcolumn = Nested.Nextˉcolumn;
        Elseˉnodes = Nested.Nodes;
        Elseˉdepth = Nested.Depth;
    } else {
        let Elseˉblock: Compilerˉsourceˉvalueˉblock =
            Compilerˉbodyˉparseˉvalueˉblock(
                Input, Elseˉstart.Offset, Elseˉstart.Line,
                Elseˉstart.Column, Endˉoffset, Nesting + 1u32
            );
        if Elseˉblock.Status != Compilerˉbodyˉparseˉstatus.Valid {
            return Compilerˉbodyˉexpressionˉfailureˉfromˉvalueˉblock(Elseˉblock);
        }
        Elseˉoffset = Elseˉblock.Blockˉoffset;
        Elseˉlength = Elseˉblock.Blockˉlength;
        Nextˉoffset = Elseˉblock.Nextˉoffset;
        Nextˉline = Elseˉblock.Nextˉline;
        Nextˉcolumn = Elseˉblock.Nextˉcolumn;
        Elseˉnodes = Elseˉblock.Expressions;
        Elseˉdepth = Elseˉblock.Maximumˉexpressionˉdepth;
    }
    let Nodes: u32 = Condition.Nodes + Then.Expressions + Elseˉnodes + 1u32;
    let Depth: u32 = Compilerˉbodyˉmaximum(
        Condition.Depth,
        Compilerˉbodyˉmaximum(
            Then.Maximumˉexpressionˉdepth, Elseˉdepth
        )
    ) + 1u32;
    if Nodes > 262144u32 {
        return Compilerˉbodyˉexpressionˉfailure(
            Compilerˉbodyˉparseˉstatus.Itemˉlimit,
            Start,
            Sourceˉlexer.Compilerˉtokenˉkind.End
        );
    }
    if Depth > 64u32 {
        return Compilerˉbodyˉexpressionˉfailure(
            Compilerˉbodyˉparseˉstatus.Nestingˉlimit,
            Start,
            Sourceˉlexer.Compilerˉtokenˉkind.End
        );
    }
    return Compilerˉbodyˉexpressionˉmake(
        Compilerˉsourceˉexpressionˉkind.If,
        Sourceˉlexer.Compilerˉtokenˉkind.If,
        Start.Offset, Nextˉoffset, Start.Line, Start.Column,
        Condition.Offset, Condition.Length,
        Then.Blockˉoffset, Then.Blockˉlength,
        Elseˉoffset, Elseˉlength,
        Start.Offset, Start.Offset, 0u32,
        Sourceˉlexer.Compilerˉnumericˉkind.None, 0u32, false,
        Nextˉoffset, Nextˉline, Nextˉcolumn, Nodes, Depth
    );
}

fn Compilerˉbodyˉparseˉbuilderˉexpression(
    Input: bytes,
    Token: Sourceˉlexer.Compilerˉsourceˉtoken,
    Endˉoffset: u32
) -> Compilerˉsourceˉexpression {
    let Type: Sourceˉdeclarations.Compilerˉparseˉstep =
        Sourceˉdeclarations.Compilerˉparseˉtype(
            Input, Token.Offset, Token.Line, Token.Column, false, false
        );
    if Type.Status != Sourceˉdeclarations.Compilerˉparseˉstatus.Valid {
        return Compilerˉbodyˉexpressionˉfailureˉfromˉstep(
            Compilerˉbodyˉstepˉfromˉdeclarationˉstep(Type)
        );
    }
    let Left: Compilerˉbodyˉparseˉstep = Compilerˉbodyˉconsume(
        Input, Type.Nextˉoffset, Type.Nextˉline, Type.Nextˉcolumn,
        Endˉoffset, Sourceˉlexer.Compilerˉtokenˉkind.Leftˉparenthesis
    );
    if Left.Status != Compilerˉbodyˉparseˉstatus.Valid {
        return Compilerˉbodyˉexpressionˉfailureˉfromˉstep(Left);
    }
    let Right: Compilerˉbodyˉparseˉstep = Compilerˉbodyˉconsume(
        Input, Left.Nextˉoffset, Left.Nextˉline, Left.Nextˉcolumn,
        Endˉoffset, Sourceˉlexer.Compilerˉtokenˉkind.Rightˉparenthesis
    );
    if Right.Status != Compilerˉbodyˉparseˉstatus.Valid {
        return Compilerˉbodyˉexpressionˉfailureˉfromˉstep(Right);
    }
    return Compilerˉbodyˉexpressionˉmake(
        Compilerˉsourceˉexpressionˉkind.Builder,
        Sourceˉlexer.Compilerˉtokenˉkind.End,
        Token.Offset, Right.Nextˉoffset, Token.Line, Token.Column,
        Token.Offset, Type.Nextˉoffset - Token.Offset,
        Token.Offset, 0u32, Token.Offset, 0u32,
        Token.Offset, Token.Offset, 0u32,
        Sourceˉlexer.Compilerˉnumericˉkind.None, 0u32, false,
        Right.Nextˉoffset, Right.Nextˉline, Right.Nextˉcolumn,
        1u32, 1u32
    );
}

fn Compilerˉbodyˉparseˉcallˉexpression(
    Input: bytes,
    Name: Compilerˉsourceˉnameˉview,
    Left: Sourceˉlexer.Compilerˉsourceˉtoken,
    Endˉoffset: u32,
    Nesting: u32,
    Line: u32,
    Column: u32,
    Kind: Compilerˉsourceˉexpressionˉkind,
    Typeˉargumentsˉoffset: u32,
    Typeˉargumentsˉlength: u32,
    Typeˉarguments: u32
) -> Compilerˉsourceˉexpression {
    if Nesting >= 64u32 {
        return Compilerˉbodyˉexpressionˉfailure(
            Compilerˉbodyˉparseˉstatus.Nestingˉlimit,
            Left,
            Sourceˉlexer.Compilerˉtokenˉkind.Rightˉparenthesis
        );
    }
    var Cursor: u32 = Left.Nextˉoffset;
    var Currentˉline: u32 = Left.Nextˉline;
    var Currentˉcolumn: u32 = Left.Nextˉcolumn;
    var Itemsˉoffset: u32 = Cursor;
    var Itemsˉend: u32 = Cursor;
    var Items: u32 = 0u32;
    var Nodes: u32 = 1u32;
    var Depth: u32 = 1u32;
    var Argumentˉmodeˉselected: bool = false;
    var Namedˉarguments: bool = false;
    var Reading: bool = true;
    while Reading {
        let Current: Sourceˉlexer.Compilerˉsourceˉtoken =
            Compilerˉbodyˉtoken(
                Input, Cursor, Currentˉline, Currentˉcolumn, Endˉoffset
            );
        if Current.Kind ==
                Sourceˉlexer.Compilerˉtokenˉkind.Rightˉparenthesis {
            Reading = false;
            if Items == 0u32 { Itemsˉoffset = Current.Offset; }
            let Callˉend: Compilerˉbodyˉparseˉstep =
                Compilerˉbodyˉconsume(
                    Input, Cursor, Currentˉline, Currentˉcolumn,
                    Endˉoffset,
                    Sourceˉlexer.Compilerˉtokenˉkind.Rightˉparenthesis
                );
            if Callˉend.Status != Compilerˉbodyˉparseˉstatus.Valid {
                return Compilerˉbodyˉexpressionˉfailureˉfromˉstep(Callˉend);
            }
            var Callˉoperator: Sourceˉlexer.Compilerˉtokenˉkind =
                Sourceˉlexer.Compilerˉtokenˉkind.End;
            if Namedˉarguments {
                Callˉoperator = Sourceˉlexer.Compilerˉtokenˉkind.Colon;
            }
            return Compilerˉbodyˉexpressionˉmake(
                Kind,
                Callˉoperator,
                Name.Offset, Callˉend.Nextˉoffset, Line, Column,
                Name.Offset, Name.Length,
                Typeˉargumentsˉoffset, Typeˉargumentsˉlength,
                Name.Offset, 0u32,
                Itemsˉoffset, Itemsˉend, Items,
                Sourceˉlexer.Compilerˉnumericˉkind.None,
                Typeˉarguments, false,
                Callˉend.Nextˉoffset, Callˉend.Nextˉline,
                Callˉend.Nextˉcolumn, Nodes, Depth
            );
        }
        if Items >= 64u32 {
            return Compilerˉbodyˉexpressionˉfailure(
                Compilerˉbodyˉparseˉstatus.Itemˉlimit,
                Current,
                Sourceˉlexer.Compilerˉtokenˉkind.Rightˉparenthesis
            );
        }
        var Argumentˉoffset: u32 = Current.Offset;
        let Afterˉargumentˉname: Sourceˉlexer.Compilerˉsourceˉtoken =
            Compilerˉbodyˉtoken(
                Input, Current.Nextˉoffset, Current.Nextˉline,
                Current.Nextˉcolumn, Endˉoffset
            );
        let Isˉnamed: bool =
            Current.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Identifier &&
            Afterˉargumentˉname.Kind ==
                Sourceˉlexer.Compilerˉtokenˉkind.Colon;
        if !Argumentˉmodeˉselected {
            Argumentˉmodeˉselected = true;
            Namedˉarguments = Isˉnamed;
        } else if Namedˉarguments != Isˉnamed {
            return Compilerˉbodyˉexpressionˉfailure(
                Compilerˉbodyˉparseˉstatus.Expectedˉexpression,
                Current, Sourceˉlexer.Compilerˉtokenˉkind.Identifier
            );
        }
        if Isˉnamed {
            Cursor = Afterˉargumentˉname.Nextˉoffset;
            Currentˉline = Afterˉargumentˉname.Nextˉline;
            Currentˉcolumn = Afterˉargumentˉname.Nextˉcolumn;
        }
        let Argument: Compilerˉsourceˉexpression =
            Compilerˉparseˉexpressionˉvalidated(
                Input, Cursor, Currentˉline, Currentˉcolumn,
                Endˉoffset, 0u32, Nesting + 1u32
            );
        if Argument.Status != Compilerˉbodyˉparseˉstatus.Valid {
            return Argument;
        }
        if Items == 0u32 { Itemsˉoffset = Argumentˉoffset; }
        Itemsˉend = Argument.Offset + Argument.Length;
        Items = Items + 1u32;
        Nodes = Nodes + Argument.Nodes;
        Depth = Compilerˉbodyˉmaximum(Depth, Argument.Depth + 1u32);
        if Nodes > 4096u32 {
            return Compilerˉbodyˉexpressionˉfailure(
                Compilerˉbodyˉparseˉstatus.Itemˉlimit,
                Current,
                Sourceˉlexer.Compilerˉtokenˉkind.Rightˉparenthesis
            );
        }
        Cursor = Argument.Nextˉoffset;
        Currentˉline = Argument.Nextˉline;
        Currentˉcolumn = Argument.Nextˉcolumn;
        let Separator: Sourceˉlexer.Compilerˉsourceˉtoken =
            Compilerˉbodyˉtoken(
                Input, Cursor, Currentˉline, Currentˉcolumn, Endˉoffset
            );
        if Separator.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Comma {
            Cursor = Separator.Nextˉoffset;
            Currentˉline = Separator.Nextˉline;
            Currentˉcolumn = Separator.Nextˉcolumn;
        } else if Separator.Kind !=
                Sourceˉlexer.Compilerˉtokenˉkind.Rightˉparenthesis {
            return Compilerˉbodyˉexpressionˉfailure(
                Compilerˉbodyˉparseˉstatus.Expectedˉtoken,
                Separator,
                Sourceˉlexer.Compilerˉtokenˉkind.Rightˉparenthesis
            );
        }
    }
    return Compilerˉbodyˉexpressionˉfailure(
        Compilerˉbodyˉparseˉstatus.Expectedˉtoken,
        Left,
        Sourceˉlexer.Compilerˉtokenˉkind.Rightˉparenthesis
    );
}

fn Compilerˉbodyˉparseˉclosureˉcaptures(
    Input: bytes,
    Offset: u32,
    Line: u32,
    Column: u32,
    Endˉoffset: u32
) -> Compilerˉbodyˉparseˉstep {
    let Left: Compilerˉbodyˉparseˉstep = Compilerˉbodyˉconsume(
        Input, Offset, Line, Column, Endˉoffset,
        Sourceˉlexer.Compilerˉtokenˉkind.Leftˉbracket
    );
    if Left.Status != Compilerˉbodyˉparseˉstatus.Valid {
        return Left;
    }
    var Cursor: u32 = Left.Nextˉoffset;
    var Currentˉline: u32 = Left.Nextˉline;
    var Currentˉcolumn: u32 = Left.Nextˉcolumn;
    let First: Sourceˉlexer.Compilerˉsourceˉtoken = Compilerˉbodyˉtoken(
        Input, Cursor, Currentˉline, Currentˉcolumn, Endˉoffset
    );
    var Itemsˉend: u32 = First.Offset;
    var Items: u32 = 0u32;
    var Reading: bool = true;
    while Reading {
        let Mode: Sourceˉlexer.Compilerˉsourceˉtoken = Compilerˉbodyˉtoken(
            Input, Cursor, Currentˉline, Currentˉcolumn, Endˉoffset
        );
        if Mode.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Rightˉbracket {
            Reading = false;
        } else {
            if Items >= 64u32 {
                let Limited: Compilerˉbodyˉparseˉstep =
                    Compilerˉbodyˉstepˉfromˉtoken(
                        Compilerˉbodyˉparseˉstatus.Itemˉlimit, Mode,
                        Sourceˉlexer.Compilerˉtokenˉkind.Rightˉbracket
                    );
                return Limited;
            }
            if Mode.Kind != Sourceˉlexer.Compilerˉtokenˉkind.Copy &&
                Mode.Kind != Sourceˉlexer.Compilerˉtokenˉkind.Move &&
                Mode.Kind != Sourceˉlexer.Compilerˉtokenˉkind.Borrow {
                let Invalid: Compilerˉbodyˉparseˉstep =
                    Compilerˉbodyˉstepˉfromˉtoken(
                        Compilerˉbodyˉparseˉstatus.Expectedˉtoken, Mode,
                        Sourceˉlexer.Compilerˉtokenˉkind.Copy
                    );
                return Invalid;
            }
            Cursor = Mode.Nextˉoffset;
            Currentˉline = Mode.Nextˉline;
            Currentˉcolumn = Mode.Nextˉcolumn;
            let Maybeˉmutable: Sourceˉlexer.Compilerˉsourceˉtoken =
                Compilerˉbodyˉtoken(
                    Input, Cursor, Currentˉline, Currentˉcolumn, Endˉoffset
                );
            if Mode.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Borrow &&
                Maybeˉmutable.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Mut {
                Cursor = Maybeˉmutable.Nextˉoffset;
                Currentˉline = Maybeˉmutable.Nextˉline;
                Currentˉcolumn = Maybeˉmutable.Nextˉcolumn;
            }
            let Name: Sourceˉlexer.Compilerˉsourceˉtoken = Compilerˉbodyˉtoken(
                Input, Cursor, Currentˉline, Currentˉcolumn, Endˉoffset
            );
            let Afterˉname: Compilerˉbodyˉparseˉstep = Compilerˉbodyˉconsume(
                Input, Cursor, Currentˉline, Currentˉcolumn, Endˉoffset,
                Sourceˉlexer.Compilerˉtokenˉkind.Identifier
            );
            if Afterˉname.Status != Compilerˉbodyˉparseˉstatus.Valid {
                return Afterˉname;
            }
            Items = Items + 1u32;
            Itemsˉend = Name.Nextˉoffset;
            Cursor = Afterˉname.Nextˉoffset;
            Currentˉline = Afterˉname.Nextˉline;
            Currentˉcolumn = Afterˉname.Nextˉcolumn;
            let Separator: Sourceˉlexer.Compilerˉsourceˉtoken =
                Compilerˉbodyˉtoken(
                    Input, Cursor, Currentˉline, Currentˉcolumn, Endˉoffset
                );
            if Separator.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Comma {
                Cursor = Separator.Nextˉoffset;
                Currentˉline = Separator.Nextˉline;
                Currentˉcolumn = Separator.Nextˉcolumn;
            } else if Separator.Kind !=
                    Sourceˉlexer.Compilerˉtokenˉkind.Rightˉbracket {
                let Invalidˉseparator: Compilerˉbodyˉparseˉstep =
                    Compilerˉbodyˉstepˉfromˉtoken(
                        Compilerˉbodyˉparseˉstatus.Expectedˉtoken, Separator,
                        Sourceˉlexer.Compilerˉtokenˉkind.Rightˉbracket
                    );
                return Invalidˉseparator;
            }
        }
    }
    let Right: Compilerˉbodyˉparseˉstep = Compilerˉbodyˉconsume(
        Input, Cursor, Currentˉline, Currentˉcolumn, Endˉoffset,
        Sourceˉlexer.Compilerˉtokenˉkind.Rightˉbracket
    );
    if Right.Status != Compilerˉbodyˉparseˉstatus.Valid { return Right; }
    return Compilerˉbodyˉstepˉvalid(
        Right.Nextˉoffset, Right.Nextˉline, Right.Nextˉcolumn,
        0u32, Items, 0u32, Itemsˉend
    );
}

fn Compilerˉbodyˉparseˉclosureˉparameters(
    Input: bytes,
    Offset: u32,
    Line: u32,
    Column: u32,
    Endˉoffset: u32
) -> Compilerˉbodyˉparseˉstep {
    let Left: Compilerˉbodyˉparseˉstep = Compilerˉbodyˉconsume(
        Input, Offset, Line, Column, Endˉoffset,
        Sourceˉlexer.Compilerˉtokenˉkind.Leftˉparenthesis
    );
    if Left.Status != Compilerˉbodyˉparseˉstatus.Valid {
        return Left;
    }
    var Cursor: u32 = Left.Nextˉoffset;
    var Currentˉline: u32 = Left.Nextˉline;
    var Currentˉcolumn: u32 = Left.Nextˉcolumn;
    let First: Sourceˉlexer.Compilerˉsourceˉtoken = Compilerˉbodyˉtoken(
        Input, Cursor, Currentˉline, Currentˉcolumn, Endˉoffset
    );
    var Itemsˉend: u32 = First.Offset;
    var Items: u32 = 0u32;
    var Reading: bool = true;
    while Reading {
        let Name: Sourceˉlexer.Compilerˉsourceˉtoken = Compilerˉbodyˉtoken(
            Input, Cursor, Currentˉline, Currentˉcolumn, Endˉoffset
        );
        if Name.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Rightˉparenthesis {
            Reading = false;
        } else {
            if Items >= 64u32 {
                let Limited: Compilerˉbodyˉparseˉstep =
                    Compilerˉbodyˉstepˉfromˉtoken(
                        Compilerˉbodyˉparseˉstatus.Itemˉlimit, Name,
                        Sourceˉlexer.Compilerˉtokenˉkind.Rightˉparenthesis
                    );
                return Limited;
            }
            let Afterˉname: Compilerˉbodyˉparseˉstep = Compilerˉbodyˉconsume(
                Input, Cursor, Currentˉline, Currentˉcolumn, Endˉoffset,
                Sourceˉlexer.Compilerˉtokenˉkind.Identifier
            );
            if Afterˉname.Status != Compilerˉbodyˉparseˉstatus.Valid {
                return Afterˉname;
            }
            let Colon: Compilerˉbodyˉparseˉstep = Compilerˉbodyˉconsume(
                Input, Afterˉname.Nextˉoffset, Afterˉname.Nextˉline,
                Afterˉname.Nextˉcolumn, Endˉoffset,
                Sourceˉlexer.Compilerˉtokenˉkind.Colon
            );
            if Colon.Status != Compilerˉbodyˉparseˉstatus.Valid {
                return Colon;
            }
            let Type: Sourceˉdeclarations.Compilerˉparseˉstep =
                Sourceˉdeclarations.Compilerˉparseˉparameterˉtype(
                    Input, Colon.Nextˉoffset, Colon.Nextˉline,
                    Colon.Nextˉcolumn, false
                );
            if Type.Status != Sourceˉdeclarations.Compilerˉparseˉstatus.Valid {
                return Compilerˉbodyˉstepˉfromˉdeclarationˉstep(Type);
            }
            Items = Items + 1u32;
            Itemsˉend = Type.Nextˉoffset;
            Cursor = Type.Nextˉoffset;
            Currentˉline = Type.Nextˉline;
            Currentˉcolumn = Type.Nextˉcolumn;
            let Separator: Sourceˉlexer.Compilerˉsourceˉtoken =
                Compilerˉbodyˉtoken(
                    Input, Cursor, Currentˉline, Currentˉcolumn, Endˉoffset
                );
            if Separator.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Comma {
                Cursor = Separator.Nextˉoffset;
                Currentˉline = Separator.Nextˉline;
                Currentˉcolumn = Separator.Nextˉcolumn;
            } else if Separator.Kind !=
                    Sourceˉlexer.Compilerˉtokenˉkind.Rightˉparenthesis {
                let Invalid: Compilerˉbodyˉparseˉstep =
                    Compilerˉbodyˉstepˉfromˉtoken(
                        Compilerˉbodyˉparseˉstatus.Expectedˉtoken, Separator,
                        Sourceˉlexer.Compilerˉtokenˉkind.Rightˉparenthesis
                    );
                return Invalid;
            }
        }
    }
    let Right: Compilerˉbodyˉparseˉstep = Compilerˉbodyˉconsume(
        Input, Cursor, Currentˉline, Currentˉcolumn, Endˉoffset,
        Sourceˉlexer.Compilerˉtokenˉkind.Rightˉparenthesis
    );
    if Right.Status != Compilerˉbodyˉparseˉstatus.Valid { return Right; }
    return Compilerˉbodyˉstepˉvalid(
        Right.Nextˉoffset, Right.Nextˉline, Right.Nextˉcolumn,
        0u32, Items, 0u32, Itemsˉend
    );
}

fn Compilerˉbodyˉclosureˉexpressionˉmake(
    Start: Sourceˉlexer.Compilerˉsourceˉtoken,
    Captureˉfirst: Sourceˉlexer.Compilerˉsourceˉtoken,
    Captures: Compilerˉbodyˉparseˉstep,
    Parameterˉfirst: Sourceˉlexer.Compilerˉsourceˉtoken,
    Parameters: Compilerˉbodyˉparseˉstep,
    Bodyˉstart: Sourceˉlexer.Compilerˉsourceˉtoken,
    Body: Sourceˉdeclarations.Compilerˉparseˉstep,
    Effectˉoperator: Sourceˉlexer.Compilerˉtokenˉkind,
    Effects: u32,
    Isˉasync: bool
) -> Compilerˉsourceˉexpression {
    return Compilerˉsourceˉexpression(
        Compilerˉbodyˉparseˉstatus.Valid,
        Sourceˉlexer.Compilerˉlexˉstatus.Valid,
        Compilerˉsourceˉexpressionˉkind.Closure,
        Effectˉoperator,
        Start.Offset,
        Body.Nextˉoffset - Start.Offset,
        Start.Line,
        Start.Column,
        Start.Offset,
        Bodyˉstart.Offset - Start.Offset,
        Captureˉfirst.Offset,
        Captures.Maximumˉexpressionˉdepth - Captureˉfirst.Offset,
        Bodyˉstart.Offset,
        Body.Nextˉoffset - Bodyˉstart.Offset,
        Parameterˉfirst.Offset,
        Parameters.Maximumˉexpressionˉdepth - Parameterˉfirst.Offset,
        Captures.Expressions,
        Sourceˉlexer.Compilerˉnumericˉkind.None,
        Parameters.Expressions,
        Effects,
        Isˉasync,
        Body.Nextˉoffset,
        Body.Nextˉline,
        Body.Nextˉcolumn,
        1u32,
        1u32,
        Body.Nextˉoffset,
        Body.Nextˉline,
        Body.Nextˉcolumn,
        Sourceˉlexer.Compilerˉtokenˉkind.End,
        Sourceˉlexer.Compilerˉtokenˉkind.End
    );
}

fn Compilerˉbodyˉparseˉclosureˉexpression(
    Input: bytes,
    Start: Sourceˉlexer.Compilerˉsourceˉtoken,
    Endˉoffset: u32,
    Nesting: u32
) -> Compilerˉsourceˉexpression {
    if Nesting >= 64u32 {
        return Compilerˉbodyˉexpressionˉfailure(
            Compilerˉbodyˉparseˉstatus.Nestingˉlimit, Start,
            Sourceˉlexer.Compilerˉtokenˉkind.Rightˉbrace
        );
    }
    var Isˉasync: bool = false;
    var Cursor: u32 = Start.Offset;
    var Currentˉline: u32 = Start.Line;
    var Currentˉcolumn: u32 = Start.Column;
    if Start.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Async {
        Isˉasync = true;
        Cursor = Start.Nextˉoffset;
        Currentˉline = Start.Nextˉline;
        Currentˉcolumn = Start.Nextˉcolumn;
    }
    let Afterˉfn: Compilerˉbodyˉparseˉstep = Compilerˉbodyˉconsume(
        Input, Cursor, Currentˉline, Currentˉcolumn, Endˉoffset,
        Sourceˉlexer.Compilerˉtokenˉkind.Fn
    );
    if Afterˉfn.Status != Compilerˉbodyˉparseˉstatus.Valid {
        return Compilerˉbodyˉexpressionˉfailureˉfromˉstep(Afterˉfn);
    }
    let Captureˉstart: Sourceˉlexer.Compilerˉsourceˉtoken =
        Compilerˉbodyˉtoken(
            Input, Afterˉfn.Nextˉoffset, Afterˉfn.Nextˉline,
            Afterˉfn.Nextˉcolumn, Endˉoffset
        );
    let Captureˉfirst: Sourceˉlexer.Compilerˉsourceˉtoken =
        Compilerˉbodyˉtoken(
            Input, Captureˉstart.Nextˉoffset, Captureˉstart.Nextˉline,
            Captureˉstart.Nextˉcolumn, Endˉoffset
        );
    let Captures: Compilerˉbodyˉparseˉstep =
        Compilerˉbodyˉparseˉclosureˉcaptures(
            Input, Afterˉfn.Nextˉoffset, Afterˉfn.Nextˉline,
            Afterˉfn.Nextˉcolumn, Endˉoffset
        );
    if Captures.Status != Compilerˉbodyˉparseˉstatus.Valid {
        return Compilerˉbodyˉexpressionˉfailureˉfromˉstep(Captures);
    }
    let Parameterˉstart: Sourceˉlexer.Compilerˉsourceˉtoken =
        Compilerˉbodyˉtoken(
            Input, Captures.Nextˉoffset, Captures.Nextˉline,
            Captures.Nextˉcolumn, Endˉoffset
        );
    let Parameterˉfirst: Sourceˉlexer.Compilerˉsourceˉtoken =
        Compilerˉbodyˉtoken(
            Input, Parameterˉstart.Nextˉoffset, Parameterˉstart.Nextˉline,
            Parameterˉstart.Nextˉcolumn, Endˉoffset
        );
    let Parameters: Compilerˉbodyˉparseˉstep =
        Compilerˉbodyˉparseˉclosureˉparameters(
            Input, Captures.Nextˉoffset, Captures.Nextˉline,
            Captures.Nextˉcolumn, Endˉoffset
        );
    if Parameters.Status != Compilerˉbodyˉparseˉstatus.Valid {
        return Compilerˉbodyˉexpressionˉfailureˉfromˉstep(Parameters);
    }
    let Arrow: Compilerˉbodyˉparseˉstep = Compilerˉbodyˉconsume(
        Input, Parameters.Nextˉoffset, Parameters.Nextˉline,
        Parameters.Nextˉcolumn, Endˉoffset,
        Sourceˉlexer.Compilerˉtokenˉkind.Arrow
    );
    if Arrow.Status != Compilerˉbodyˉparseˉstatus.Valid {
        return Compilerˉbodyˉexpressionˉfailureˉfromˉstep(Arrow);
    }
    let Result: Sourceˉdeclarations.Compilerˉparseˉstep =
        Sourceˉdeclarations.Compilerˉparseˉtype(
            Input, Arrow.Nextˉoffset, Arrow.Nextˉline, Arrow.Nextˉcolumn,
            true, false
        );
    if Result.Status != Sourceˉdeclarations.Compilerˉparseˉstatus.Valid {
        return Compilerˉbodyˉexpressionˉfailureˉfromˉstep(
            Compilerˉbodyˉstepˉfromˉdeclarationˉstep(Result)
        );
    }
    var Headerˉoffset: u32 = Result.Nextˉoffset;
    var Headerˉline: u32 = Result.Nextˉline;
    var Headerˉcolumn: u32 = Result.Nextˉcolumn;
    var Effectˉoperator: Sourceˉlexer.Compilerˉtokenˉkind =
        Sourceˉlexer.Compilerˉtokenˉkind.End;
    var Effects: u32 = 0u32;
    let Maybeˉeffects: Sourceˉlexer.Compilerˉsourceˉtoken =
        Compilerˉbodyˉtoken(
            Input, Headerˉoffset, Headerˉline, Headerˉcolumn, Endˉoffset
        );
    if Maybeˉeffects.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Effects {
        let Clause: Sourceˉdeclarations.Compilerˉparseˉstep =
            Sourceˉdeclarations.Compilerˉparseˉeffectˉclause(
                Input, Headerˉoffset, Headerˉline, Headerˉcolumn
            );
        if Clause.Status != Sourceˉdeclarations.Compilerˉparseˉstatus.Valid {
            return Compilerˉbodyˉexpressionˉfailureˉfromˉstep(
                Compilerˉbodyˉstepˉfromˉdeclarationˉstep(Clause)
            );
        }
        Effectˉoperator = Sourceˉlexer.Compilerˉtokenˉkind.Effects;
        Effects = Clause.Items;
        Headerˉoffset = Clause.Nextˉoffset;
        Headerˉline = Clause.Nextˉline;
        Headerˉcolumn = Clause.Nextˉcolumn;
    }
    let Bodyˉstart: Sourceˉlexer.Compilerˉsourceˉtoken = Compilerˉbodyˉtoken(
        Input, Headerˉoffset, Headerˉline, Headerˉcolumn, Endˉoffset
    );
    let Body: Sourceˉdeclarations.Compilerˉparseˉstep =
        Sourceˉdeclarations.Compilerˉparseˉskipˉblockˉafterˉscan(
            Input, Headerˉoffset, Headerˉline, Headerˉcolumn
        );
    if Body.Status != Sourceˉdeclarations.Compilerˉparseˉstatus.Valid {
        return Compilerˉbodyˉexpressionˉfailureˉfromˉstep(
            Compilerˉbodyˉstepˉfromˉdeclarationˉstep(Body)
        );
    }
    if Body.Nextˉoffset > Endˉoffset {
        return Compilerˉbodyˉexpressionˉfailure(
            Compilerˉbodyˉparseˉstatus.Expectedˉtoken, Bodyˉstart,
            Sourceˉlexer.Compilerˉtokenˉkind.Rightˉbrace
        );
    }
    if Captures.Maximumˉexpressionˉdepth < Captureˉfirst.Offset ||
        Parameters.Maximumˉexpressionˉdepth < Parameterˉfirst.Offset ||
        Body.Nextˉoffset < Bodyˉstart.Offset {
        return Compilerˉbodyˉexpressionˉfailure(
            Compilerˉbodyˉparseˉstatus.Invalidˉspan, Bodyˉstart,
            Sourceˉlexer.Compilerˉtokenˉkind.Rightˉbrace
        );
    }
    return Compilerˉbodyˉclosureˉexpressionˉmake(
        Start, Captureˉfirst, Captures, Parameterˉfirst, Parameters,
        Bodyˉstart, Body, Effectˉoperator, Effects, Isˉasync
    );
}

export fn Compilerˉbodyˉparseˉprimary(
    Input: bytes,
    Offset: u32,
    Line: u32,
    Column: u32,
    Endˉoffset: u32,
    Nesting: u32
) -> Compilerˉsourceˉexpression {
    let Token: Sourceˉlexer.Compilerˉsourceˉtoken = Compilerˉbodyˉtoken(Input, Offset, Line, Column, Endˉoffset);
    if Token.Status != Sourceˉlexer.Compilerˉlexˉstatus.Valid {
        return Compilerˉbodyˉexpressionˉfailure(Compilerˉbodyˉparseˉstatus.Lexicalˉerror, Token, Sourceˉlexer.Compilerˉtokenˉkind.Identifier);
    }
    if Token.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Fn ||
        Token.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Async {
        return Compilerˉbodyˉparseˉclosureˉexpression(
            Input, Token, Endˉoffset, Nesting
        );
    }
    if Token.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Integer {
        return Compilerˉbodyˉexpressionˉmakeˉwide(
            Compilerˉsourceˉexpressionˉkind.Integer,
            Sourceˉlexer.Compilerˉtokenˉkind.End,
            Token.Offset,
            Token.Nextˉoffset,
            Token.Line,
            Token.Column,
            Token.Offset,
            Token.Length,
            Token.Offset,
            0u32,
            Token.Offset,
            0u32,
            Token.Offset,
            Token.Offset,
            0u32,
            Token.Numericˉkind,
            Token.Numericˉvalue,
            Token.Numericˉhigh,
            false,
            Token.Nextˉoffset,
            Token.Nextˉline,
            Token.Nextˉcolumn,
            1u32,
            1u32
        );
    }
