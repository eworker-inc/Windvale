            if Unaryˉdepth > 64u32 { return Compilerˉbodyˉexpressionˉfailure(Compilerˉbodyˉparseˉstatus.Nestingˉlimit, First, Sourceˉlexer.Compilerˉtokenˉkind.Identifier); }
            Left = Compilerˉbodyˉexpressionˉmake(Compilerˉsourceˉexpressionˉkind.Unary, First.Kind, First.Offset, Operand.Offset + Operand.Length, First.Line, First.Column, First.Offset, First.Length, Operand.Offset, Operand.Length, First.Offset, 0u32, First.Offset, First.Offset, 0u32, Sourceˉlexer.Compilerˉnumericˉkind.None, 0u32, false, Operand.Nextˉoffset, Operand.Nextˉline, Operand.Nextˉcolumn, Operand.Nodes + 1u32, Unaryˉdepth);
