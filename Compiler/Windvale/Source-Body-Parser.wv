    Firstˉoffset: u32;
    Firstˉlength: u32;
    Secondˉoffset: u32;
    Secondˉlength: u32;
    Itemsˉoffset: u32;
    Itemsˉlength: u32;
    Items: u32;
    Numericˉkind: Sourceˉlexer.Compilerˉnumericˉkind;
    Numericˉvalue: u32;
    Numericˉhigh: u32;
    Booleanˉvalue: bool;
    Nextˉoffset: u32;
    Nextˉline: u32;
    Nextˉcolumn: u32;
    Nodes: u32;
    Depth: u32;
    Failureˉoffset: u32;
    Failureˉline: u32;
    Failureˉcolumn: u32;
    Expected: Sourceˉlexer.Compilerˉtokenˉkind;
    Found: Sourceˉlexer.Compilerˉtokenˉkind;
}

