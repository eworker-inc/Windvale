export fn Compilerˉbodyˉparseˉmatchˉcase(
    Input: bytes,
    Offset: u32,
    Line: u32,
    Column: u32,
    Endˉoffset: u32,
    Statementˉnesting: u32
) -> Compilerˉsourceˉmatchˉcase {
    let Caseˉtoken: Sourceˉlexer.Compilerˉsourceˉtoken = Compilerˉbodyˉtoken(
        Input, Offset, Line, Column, Endˉoffset
    );
    if Caseˉtoken.Kind != Sourceˉlexer.Compilerˉtokenˉkind.Case {
        return Compilerˉbodyˉmatchˉcaseˉfailure(
            Compilerˉbodyˉstepˉfromˉtoken(
                Compilerˉbodyˉparseˉstatus.Expectedˉtoken,
                Caseˉtoken,
                Sourceˉlexer.Compilerˉtokenˉkind.Case
            )
        );
    }
    let First: Sourceˉlexer.Compilerˉsourceˉtoken = Compilerˉbodyˉtoken(
        Input, Caseˉtoken.Nextˉoffset, Caseˉtoken.Nextˉline, Caseˉtoken.Nextˉcolumn, Endˉoffset
    );
    if First.Kind != Sourceˉlexer.Compilerˉtokenˉkind.Identifier {
        return Compilerˉbodyˉmatchˉcaseˉfailure(
            Compilerˉbodyˉstepˉfromˉtoken(
                Compilerˉbodyˉparseˉstatus.Expectedˉtoken,
                First,
                Sourceˉlexer.Compilerˉtokenˉkind.Identifier
            )
        );
    }
    var Cursor: u32 = First.Nextˉoffset;
    var Currentˉline: u32 = First.Nextˉline;
    var Currentˉcolumn: u32 = First.Nextˉcolumn;
    var Parts: u32 = 1u32;
    var Enumˉlength: u32 = 0u32;
    var Memberˉoffset: u32 = First.Offset;
    var Memberˉlength: u32 = First.Length;
    var Readingˉname: bool = true;
    while Readingˉname {
        let Dot: Sourceˉlexer.Compilerˉsourceˉtoken = Compilerˉbodyˉtoken(
            Input, Cursor, Currentˉline, Currentˉcolumn, Endˉoffset
        );
        if Dot.Kind != Sourceˉlexer.Compilerˉtokenˉkind.Dot {
            Readingˉname = false;
        } else {
            let Part: Sourceˉlexer.Compilerˉsourceˉtoken = Compilerˉbodyˉtoken(
                Input, Dot.Nextˉoffset, Dot.Nextˉline, Dot.Nextˉcolumn, Endˉoffset
            );
            if Part.Kind != Sourceˉlexer.Compilerˉtokenˉkind.Identifier {
                return Compilerˉbodyˉmatchˉcaseˉfailure(
                    Compilerˉbodyˉstepˉfromˉtoken(
                        Compilerˉbodyˉparseˉstatus.Expectedˉtoken,
                        Part,
                        Sourceˉlexer.Compilerˉtokenˉkind.Identifier
                    )
                );
            }
            Enumˉlength = Dot.Offset - First.Offset;
            Memberˉoffset = Part.Offset;
            Memberˉlength = Part.Length;
            Parts = Parts + 1u32;
            Cursor = Part.Nextˉoffset;
            Currentˉline = Part.Nextˉline;
            Currentˉcolumn = Part.Nextˉcolumn;
        }
    }
    if Parts < 2u32 {
        let Missingˉdot: Sourceˉlexer.Compilerˉsourceˉtoken = Compilerˉbodyˉtoken(
            Input, Cursor, Currentˉline, Currentˉcolumn, Endˉoffset
        );
        return Compilerˉbodyˉmatchˉcaseˉfailure(
            Compilerˉbodyˉstepˉfromˉtoken(
                Compilerˉbodyˉparseˉstatus.Expectedˉtoken,
                Missingˉdot,
                Sourceˉlexer.Compilerˉtokenˉkind.Dot
            )
        );
    }
    var Bindingˉoffset: u32 = Cursor;
    var Bindingˉlength: u32 = 0u32;
    let Bindingˉstart: Sourceˉlexer.Compilerˉsourceˉtoken = Compilerˉbodyˉtoken(
        Input, Cursor, Currentˉline, Currentˉcolumn, Endˉoffset
    );
    if Bindingˉstart.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Leftˉparenthesis {
        let Binding: Sourceˉlexer.Compilerˉsourceˉtoken = Compilerˉbodyˉtoken(
            Input, Bindingˉstart.Nextˉoffset, Bindingˉstart.Nextˉline,
            Bindingˉstart.Nextˉcolumn, Endˉoffset
        );
        if Binding.Kind != Sourceˉlexer.Compilerˉtokenˉkind.Identifier {
            return Compilerˉbodyˉmatchˉcaseˉfailure(
                Compilerˉbodyˉstepˉfromˉtoken(
                    Compilerˉbodyˉparseˉstatus.Expectedˉtoken,
                    Binding,
                    Sourceˉlexer.Compilerˉtokenˉkind.Identifier
                )
            );
        }
        let Right: Sourceˉlexer.Compilerˉsourceˉtoken = Compilerˉbodyˉtoken(
            Input, Binding.Nextˉoffset, Binding.Nextˉline, Binding.Nextˉcolumn, Endˉoffset
        );
        if Right.Kind != Sourceˉlexer.Compilerˉtokenˉkind.Rightˉparenthesis {
            return Compilerˉbodyˉmatchˉcaseˉfailure(
                Compilerˉbodyˉstepˉfromˉtoken(
                    Compilerˉbodyˉparseˉstatus.Expectedˉtoken,
                    Right,
                    Sourceˉlexer.Compilerˉtokenˉkind.Rightˉparenthesis
                )
            );
        }
        Bindingˉoffset = Binding.Offset;
        Bindingˉlength = Binding.Length;
        Cursor = Right.Nextˉoffset;
        Currentˉline = Right.Nextˉline;
        Currentˉcolumn = Right.Nextˉcolumn;
    }
    let Blockˉstart: Sourceˉlexer.Compilerˉsourceˉtoken = Compilerˉbodyˉtoken(
        Input, Cursor, Currentˉline, Currentˉcolumn, Endˉoffset
    );
    let Block: Compilerˉbodyˉparseˉstep = Compilerˉparseˉblockˉvalidated(
        Input, Cursor, Currentˉline, Currentˉcolumn, Endˉoffset, Statementˉnesting + 1u32
    );
    if Block.Status != Compilerˉbodyˉparseˉstatus.Valid {
        return Compilerˉbodyˉmatchˉcaseˉfailure(Block);
    }
    return Compilerˉsourceˉmatchˉcase(
        Compilerˉbodyˉparseˉstatus.Valid,
        Sourceˉlexer.Compilerˉlexˉstatus.Valid,
        First.Offset,
        Enumˉlength,
        Memberˉoffset,
        Memberˉlength,
        Bindingˉoffset,
        Bindingˉlength,
        Blockˉstart.Offset,
        Block.Nextˉoffset - Blockˉstart.Offset,
        Block.Nextˉoffset,
        Block.Nextˉline,
        Block.Nextˉcolumn,
        Block.Statements,
        Block.Expressions,
        Block.Maximumˉstatementˉdepth,
        Block.Maximumˉexpressionˉdepth,
        Block.Nextˉoffset,
        Block.Nextˉline,
        Block.Nextˉcolumn,
        Sourceˉlexer.Compilerˉtokenˉkind.End,
        Sourceˉlexer.Compilerˉtokenˉkind.End
    );
}

export fn Compilerˉbodyˉparseˉlocalˉstatement(
    Input: bytes,
    Start: Sourceˉlexer.Compilerˉsourceˉtoken,
    Endˉoffset: u32
) -> Compilerˉsourceˉstatement {
    let Name: Sourceˉlexer.Compilerˉsourceˉtoken = Compilerˉbodyˉtoken(Input, Start.Nextˉoffset, Start.Nextˉline, Start.Nextˉcolumn, Endˉoffset);
    let Afterˉname: Compilerˉbodyˉparseˉstep = Compilerˉbodyˉconsume(Input, Start.Nextˉoffset, Start.Nextˉline, Start.Nextˉcolumn, Endˉoffset, Sourceˉlexer.Compilerˉtokenˉkind.Identifier);
    if Afterˉname.Status != Compilerˉbodyˉparseˉstatus.Valid { return Compilerˉbodyˉstatementˉfailure(Afterˉname, Compilerˉsourceˉstatementˉkind.Local, Start); }
    var Typeˉkind: Sourceˉdeclarations.Compilerˉsourceˉtypeˉkind = Sourceˉdeclarations.Compilerˉsourceˉtypeˉkind.Unknown;
    var Typeˉoffset: u32 = Afterˉname.Nextˉoffset;
    var Typeˉlength: u32 = 0u32;
    var Cursor: u32 = Afterˉname.Nextˉoffset;
    var Currentˉline: u32 = Afterˉname.Nextˉline;
    var Currentˉcolumn: u32 = Afterˉname.Nextˉcolumn;
    let Separator: Sourceˉlexer.Compilerˉsourceˉtoken = Compilerˉbodyˉtoken(Input, Cursor, Currentˉline, Currentˉcolumn, Endˉoffset);
    if Separator.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Colon {
        let Typeˉstart: Sourceˉlexer.Compilerˉsourceˉtoken = Compilerˉbodyˉtoken(Input, Separator.Nextˉoffset, Separator.Nextˉline, Separator.Nextˉcolumn, Endˉoffset);
        let Type: Sourceˉdeclarations.Compilerˉparseˉstep = Sourceˉdeclarations.Compilerˉparseˉtype(Input, Separator.Nextˉoffset, Separator.Nextˉline, Separator.Nextˉcolumn, false, false);
        if Type.Status != Sourceˉdeclarations.Compilerˉparseˉstatus.Valid { return Compilerˉbodyˉstatementˉfailure(Compilerˉbodyˉstepˉfromˉdeclarationˉstep(Type), Compilerˉsourceˉstatementˉkind.Local, Start); }
        if Type.Nextˉoffset > Endˉoffset {
            let Invalidˉtype: Compilerˉbodyˉparseˉstep = Compilerˉbodyˉstepˉfromˉtoken(Compilerˉbodyˉparseˉstatus.Invalidˉspan, Typeˉstart, Sourceˉlexer.Compilerˉtokenˉkind.Equals);
            return Compilerˉbodyˉstatementˉfailure(Invalidˉtype, Compilerˉsourceˉstatementˉkind.Local, Start);
        }
        Typeˉkind = Type.Typeˉkind;
        Typeˉoffset = Typeˉstart.Offset;
        Typeˉlength = Type.Nextˉoffset - Typeˉstart.Offset;
        Cursor = Type.Nextˉoffset;
        Currentˉline = Type.Nextˉline;
        Currentˉcolumn = Type.Nextˉcolumn;
    }
    let Afterˉequals: Compilerˉbodyˉparseˉstep = Compilerˉbodyˉconsume(Input, Cursor, Currentˉline, Currentˉcolumn, Endˉoffset, Sourceˉlexer.Compilerˉtokenˉkind.Equals);
    if Afterˉequals.Status != Compilerˉbodyˉparseˉstatus.Valid { return Compilerˉbodyˉstatementˉfailure(Afterˉequals, Compilerˉsourceˉstatementˉkind.Local, Start); }
    let Initializer: Compilerˉsourceˉexpression = Compilerˉparseˉexpressionˉvalidated(Input, Afterˉequals.Nextˉoffset, Afterˉequals.Nextˉline, Afterˉequals.Nextˉcolumn, Endˉoffset, 0u32, 0u32);
    if Initializer.Status != Compilerˉbodyˉparseˉstatus.Valid { return Compilerˉbodyˉstatementˉfailure(Compilerˉbodyˉstepˉfromˉexpression(Initializer), Compilerˉsourceˉstatementˉkind.Local, Start); }
    let Semicolon: Compilerˉbodyˉparseˉstep = Compilerˉbodyˉconsume(Input, Initializer.Nextˉoffset, Initializer.Nextˉline, Initializer.Nextˉcolumn, Endˉoffset, Sourceˉlexer.Compilerˉtokenˉkind.Semicolon);
    if Semicolon.Status != Compilerˉbodyˉparseˉstatus.Valid { return Compilerˉbodyˉstatementˉfailure(Semicolon, Compilerˉsourceˉstatementˉkind.Local, Start); }
    let Result: Compilerˉbodyˉparseˉstep = Compilerˉbodyˉstepˉvalid(Semicolon.Nextˉoffset, Semicolon.Nextˉline, Semicolon.Nextˉcolumn, 1u32, Initializer.Nodes, 1u32, Initializer.Depth);
    return Compilerˉbodyˉstatementˉmake(Compilerˉsourceˉstatementˉkind.Local, Start.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Var, Start, Semicolon.Nextˉoffset, Name.Offset, Name.Length, Typeˉkind, Typeˉoffset, Typeˉlength, Initializer.Offset, Initializer.Length, Start.Offset, 0u32, Start.Offset, 0u32, Result);
}

export fn Compilerˉbodyˉparseˉassignmentˉstatement(
    Input: bytes,
    Start: Sourceˉlexer.Compilerˉsourceˉtoken,
    Endˉoffset: u32
) -> Compilerˉsourceˉstatement {
    let Operator: Sourceˉlexer.Compilerˉsourceˉtoken = Compilerˉbodyˉtoken(Input, Start.Nextˉoffset, Start.Nextˉline, Start.Nextˉcolumn, Endˉoffset);
    if !Compilerˉbodyˉisˉassignmentˉoperator(Operator.Kind) {
        return Compilerˉbodyˉstatementˉfailure(
            Compilerˉbodyˉstepˉfromˉtoken(Compilerˉbodyˉparseˉstatus.Expectedˉtoken, Operator, Sourceˉlexer.Compilerˉtokenˉkind.Equals),
            Compilerˉsourceˉstatementˉkind.Assignment,
            Start
        );
    }
    let Value: Compilerˉsourceˉexpression = Compilerˉparseˉexpressionˉvalidated(Input, Operator.Nextˉoffset, Operator.Nextˉline, Operator.Nextˉcolumn, Endˉoffset, 0u32, 0u32);
    if Value.Status != Compilerˉbodyˉparseˉstatus.Valid { return Compilerˉbodyˉstatementˉfailure(Compilerˉbodyˉstepˉfromˉexpression(Value), Compilerˉsourceˉstatementˉkind.Assignment, Start); }
    let Semicolon: Compilerˉbodyˉparseˉstep = Compilerˉbodyˉconsume(Input, Value.Nextˉoffset, Value.Nextˉline, Value.Nextˉcolumn, Endˉoffset, Sourceˉlexer.Compilerˉtokenˉkind.Semicolon);
    if Semicolon.Status != Compilerˉbodyˉparseˉstatus.Valid { return Compilerˉbodyˉstatementˉfailure(Semicolon, Compilerˉsourceˉstatementˉkind.Assignment, Start); }
    let Result: Compilerˉbodyˉparseˉstep = Compilerˉbodyˉstepˉvalid(Semicolon.Nextˉoffset, Semicolon.Nextˉline, Semicolon.Nextˉcolumn, 1u32, Value.Nodes, 1u32, Value.Depth);
    return Compilerˉbodyˉstatementˉmake(Compilerˉsourceˉstatementˉkind.Assignment, false, Start, Semicolon.Nextˉoffset, Start.Offset, Start.Length, Sourceˉdeclarations.Compilerˉsourceˉtypeˉkind.Unknown, Start.Offset, 0u32, Value.Offset, Value.Length, Start.Offset, 0u32, Start.Offset, 0u32, Result);
}

export fn Compilerˉbodyˉparseˉloopˉcontrolˉstatement(
    Input: bytes,
    Start: Sourceˉlexer.Compilerˉsourceˉtoken,
    Endˉoffset: u32
) -> Compilerˉsourceˉstatement {
    var Kind: Compilerˉsourceˉstatementˉkind = Compilerˉsourceˉstatementˉkind.Break;
    if Start.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Continue { Kind = Compilerˉsourceˉstatementˉkind.Continue; }
    let Semicolon: Compilerˉbodyˉparseˉstep = Compilerˉbodyˉconsume(
        Input,
        Start.Nextˉoffset,
        Start.Nextˉline,
        Start.Nextˉcolumn,
        Endˉoffset,
        Sourceˉlexer.Compilerˉtokenˉkind.Semicolon
    );
    if Semicolon.Status != Compilerˉbodyˉparseˉstatus.Valid {
        return Compilerˉbodyˉstatementˉfailure(Semicolon, Kind, Start);
    }
    let Result: Compilerˉbodyˉparseˉstep = Compilerˉbodyˉstepˉvalid(
        Semicolon.Nextˉoffset,
        Semicolon.Nextˉline,
        Semicolon.Nextˉcolumn,
        1u32,
        0u32,
        1u32,
        0u32
    );
    return Compilerˉbodyˉstatementˉmake(
        Kind,
        false,
        Start,
        Semicolon.Nextˉoffset,
        Start.Offset,
        0u32,
        Sourceˉdeclarations.Compilerˉsourceˉtypeˉkind.Unknown,
        Start.Offset,
        0u32,
        Start.Offset,
        0u32,
        Start.Offset,
        0u32,
        Start.Offset,
        0u32,
        Result
    );
}

export fn Compilerˉbodyˉparseˉreturnˉstatement(
    Input: bytes,
    Start: Sourceˉlexer.Compilerˉsourceˉtoken,
    Endˉoffset: u32
) -> Compilerˉsourceˉstatement {
    let Current: Sourceˉlexer.Compilerˉsourceˉtoken = Compilerˉbodyˉtoken(Input, Start.Nextˉoffset, Start.Nextˉline, Start.Nextˉcolumn, Endˉoffset);
    if Current.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Semicolon {
        let Emptyˉend: Compilerˉbodyˉparseˉstep = Compilerˉbodyˉconsume(Input, Start.Nextˉoffset, Start.Nextˉline, Start.Nextˉcolumn, Endˉoffset, Sourceˉlexer.Compilerˉtokenˉkind.Semicolon);
        if Emptyˉend.Status != Compilerˉbodyˉparseˉstatus.Valid { return Compilerˉbodyˉstatementˉfailure(Emptyˉend, Compilerˉsourceˉstatementˉkind.Return, Start); }
        let Emptyˉresult: Compilerˉbodyˉparseˉstep = Compilerˉbodyˉstepˉvalid(Emptyˉend.Nextˉoffset, Emptyˉend.Nextˉline, Emptyˉend.Nextˉcolumn, 1u32, 0u32, 1u32, 0u32);
        return Compilerˉbodyˉstatementˉmake(Compilerˉsourceˉstatementˉkind.Return, false, Start, Emptyˉend.Nextˉoffset, Start.Offset, 0u32, Sourceˉdeclarations.Compilerˉsourceˉtypeˉkind.Unknown, Start.Offset, 0u32, Start.Offset, 0u32, Start.Offset, 0u32, Start.Offset, 0u32, Emptyˉresult);
    }
    let Value: Compilerˉsourceˉexpression = Compilerˉparseˉexpressionˉvalidated(Input, Start.Nextˉoffset, Start.Nextˉline, Start.Nextˉcolumn, Endˉoffset, 0u32, 0u32);
    if Value.Status != Compilerˉbodyˉparseˉstatus.Valid { return Compilerˉbodyˉstatementˉfailure(Compilerˉbodyˉstepˉfromˉexpression(Value), Compilerˉsourceˉstatementˉkind.Return, Start); }
    let Valueˉend: Compilerˉbodyˉparseˉstep = Compilerˉbodyˉconsume(Input, Value.Nextˉoffset, Value.Nextˉline, Value.Nextˉcolumn, Endˉoffset, Sourceˉlexer.Compilerˉtokenˉkind.Semicolon);
    if Valueˉend.Status != Compilerˉbodyˉparseˉstatus.Valid { return Compilerˉbodyˉstatementˉfailure(Valueˉend, Compilerˉsourceˉstatementˉkind.Return, Start); }
    let Valueˉresult: Compilerˉbodyˉparseˉstep = Compilerˉbodyˉstepˉvalid(Valueˉend.Nextˉoffset, Valueˉend.Nextˉline, Valueˉend.Nextˉcolumn, 1u32, Value.Nodes, 1u32, Value.Depth);
    return Compilerˉbodyˉstatementˉmake(Compilerˉsourceˉstatementˉkind.Return, false, Start, Valueˉend.Nextˉoffset, Start.Offset, 0u32, Sourceˉdeclarations.Compilerˉsourceˉtypeˉkind.Unknown, Start.Offset, 0u32, Value.Offset, Value.Length, Start.Offset, 0u32, Start.Offset, 0u32, Valueˉresult);
}

fn Compilerˉbodyˉparseˉterminatedˉexpressionˉstatement(
    Input: bytes,
    Start: Sourceˉlexer.Compilerˉsourceˉtoken,
    Endˉoffset: u32,
    Kind: Compilerˉsourceˉstatementˉkind,
    Expressionˉoffset: u32,
    Expressionˉline: u32,
    Expressionˉcolumn: u32
) -> Compilerˉsourceˉstatement {
    let Expression: Compilerˉsourceˉexpression = Compilerˉparseˉexpressionˉvalidated(Input, Expressionˉoffset, Expressionˉline, Expressionˉcolumn, Endˉoffset, 0u32, 0u32);
    if Expression.Status != Compilerˉbodyˉparseˉstatus.Valid { return Compilerˉbodyˉstatementˉfailure(Compilerˉbodyˉstepˉfromˉexpression(Expression), Kind, Start); }
    let Semicolon: Compilerˉbodyˉparseˉstep = Compilerˉbodyˉconsume(Input, Expression.Nextˉoffset, Expression.Nextˉline, Expression.Nextˉcolumn, Endˉoffset, Sourceˉlexer.Compilerˉtokenˉkind.Semicolon);
    if Semicolon.Status != Compilerˉbodyˉparseˉstatus.Valid { return Compilerˉbodyˉstatementˉfailure(Semicolon, Kind, Start); }
    let Result: Compilerˉbodyˉparseˉstep = Compilerˉbodyˉstepˉvalid(Semicolon.Nextˉoffset, Semicolon.Nextˉline, Semicolon.Nextˉcolumn, 1u32, Expression.Nodes, 1u32, Expression.Depth);
    return Compilerˉbodyˉstatementˉmake(Kind, false, Start, Semicolon.Nextˉoffset, Start.Offset, 0u32, Sourceˉdeclarations.Compilerˉsourceˉtypeˉkind.Unknown, Start.Offset, 0u32, Expression.Offset, Expression.Length, Start.Offset, 0u32, Start.Offset, 0u32, Result);
}

export fn Compilerˉbodyˉparseˉifˉstatement(
    Input: bytes,
    Start: Sourceˉlexer.Compilerˉsourceˉtoken,
    Endˉoffset: u32,
    Statementˉnesting: u32
) -> Compilerˉsourceˉstatement {
    let Condition: Compilerˉsourceˉexpression = Compilerˉparseˉexpressionˉvalidated(Input, Start.Nextˉoffset, Start.Nextˉline, Start.Nextˉcolumn, Endˉoffset, 0u32, 0u32);
    if Condition.Status != Compilerˉbodyˉparseˉstatus.Valid { return Compilerˉbodyˉstatementˉfailure(Compilerˉbodyˉstepˉfromˉexpression(Condition), Compilerˉsourceˉstatementˉkind.If, Start); }
    let Thenˉstart: Sourceˉlexer.Compilerˉsourceˉtoken = Compilerˉbodyˉtoken(Input, Condition.Nextˉoffset, Condition.Nextˉline, Condition.Nextˉcolumn, Endˉoffset);
    let Thenˉblock: Compilerˉbodyˉparseˉstep = Compilerˉparseˉblockˉvalidated(Input, Condition.Nextˉoffset, Condition.Nextˉline, Condition.Nextˉcolumn, Endˉoffset, Statementˉnesting + 1u32);
    if Thenˉblock.Status != Compilerˉbodyˉparseˉstatus.Valid { return Compilerˉbodyˉstatementˉfailure(Thenˉblock, Compilerˉsourceˉstatementˉkind.If, Start); }
    var Cursor: u32 = Thenˉblock.Nextˉoffset;
    var Currentˉline: u32 = Thenˉblock.Nextˉline;
    var Currentˉcolumn: u32 = Thenˉblock.Nextˉcolumn;
    var End: u32 = Thenˉblock.Nextˉoffset;
    var Secondˉoffset: u32 = Start.Offset;
    var Secondˉlength: u32 = 0u32;
    var Statements: u32 = 1u32 + Thenˉblock.Statements;
    var Expressions: u32 = Condition.Nodes + Thenˉblock.Expressions;
    var Statementˉdepth: u32 = Thenˉblock.Maximumˉstatementˉdepth + 1u32;
    var Expressionˉdepth: u32 = Compilerˉbodyˉmaximum(Condition.Depth, Thenˉblock.Maximumˉexpressionˉdepth);
    let Elseˉtoken: Sourceˉlexer.Compilerˉsourceˉtoken = Compilerˉbodyˉtoken(Input, Cursor, Currentˉline, Currentˉcolumn, Endˉoffset);
    if Elseˉtoken.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Else {
        let Elseˉstart: Sourceˉlexer.Compilerˉsourceˉtoken = Compilerˉbodyˉtoken(Input, Elseˉtoken.Nextˉoffset, Elseˉtoken.Nextˉline, Elseˉtoken.Nextˉcolumn, Endˉoffset);
        if Elseˉstart.Kind == Sourceˉlexer.Compilerˉtokenˉkind.If {
            let Elseˉif: Compilerˉsourceˉstatement = Compilerˉbodyˉparseˉifˉstatement(
                Input, Elseˉstart, Endˉoffset, Statementˉnesting + 1u32
            );
            if Elseˉif.Status != Compilerˉbodyˉparseˉstatus.Valid {
                return Elseˉif;
            }
            Secondˉoffset = Elseˉstart.Offset;
            Secondˉlength = Elseˉif.Nextˉoffset - Elseˉstart.Offset;
            Cursor = Elseˉif.Nextˉoffset;
            Currentˉline = Elseˉif.Nextˉline;
            Currentˉcolumn = Elseˉif.Nextˉcolumn;
            End = Elseˉif.Nextˉoffset;
            Statements = Statements + Elseˉif.Statements;
            Expressions = Expressions + Elseˉif.Expressions;
            Statementˉdepth = Compilerˉbodyˉmaximum(
                Statementˉdepth, Elseˉif.Maximumˉstatementˉdepth + 1u32
            );
            Expressionˉdepth = Compilerˉbodyˉmaximum(
                Expressionˉdepth, Elseˉif.Maximumˉexpressionˉdepth
            );
        } else {
            let Elseˉblock: Compilerˉbodyˉparseˉstep = Compilerˉparseˉblockˉvalidated(Input, Elseˉtoken.Nextˉoffset, Elseˉtoken.Nextˉline, Elseˉtoken.Nextˉcolumn, Endˉoffset, Statementˉnesting + 1u32);
            if Elseˉblock.Status != Compilerˉbodyˉparseˉstatus.Valid { return Compilerˉbodyˉstatementˉfailure(Elseˉblock, Compilerˉsourceˉstatementˉkind.If, Start); }
            Secondˉoffset = Elseˉstart.Offset;
            Secondˉlength = Elseˉblock.Nextˉoffset - Elseˉstart.Offset;
            Cursor = Elseˉblock.Nextˉoffset;
            Currentˉline = Elseˉblock.Nextˉline;
            Currentˉcolumn = Elseˉblock.Nextˉcolumn;
            End = Elseˉblock.Nextˉoffset;
            Statements = Statements + Elseˉblock.Statements;
            Expressions = Expressions + Elseˉblock.Expressions;
            Statementˉdepth = Compilerˉbodyˉmaximum(Statementˉdepth, Elseˉblock.Maximumˉstatementˉdepth + 1u32);
            Expressionˉdepth = Compilerˉbodyˉmaximum(Expressionˉdepth, Elseˉblock.Maximumˉexpressionˉdepth);
        }
    }
    if Statements > 4096u32 { return Compilerˉbodyˉstatementˉfailure(Compilerˉbodyˉstepˉfromˉtoken(Compilerˉbodyˉparseˉstatus.Itemˉlimit, Start, Sourceˉlexer.Compilerˉtokenˉkind.Rightˉbrace), Compilerˉsourceˉstatementˉkind.If, Start); }
    let Result: Compilerˉbodyˉparseˉstep = Compilerˉbodyˉstepˉvalid(Cursor, Currentˉline, Currentˉcolumn, Statements, Expressions, Statementˉdepth, Expressionˉdepth);
    return Compilerˉbodyˉstatementˉmake(Compilerˉsourceˉstatementˉkind.If, false, Start, End, Start.Offset, 0u32, Sourceˉdeclarations.Compilerˉsourceˉtypeˉkind.Unknown, Start.Offset, 0u32, Condition.Offset, Condition.Length, Thenˉstart.Offset, Thenˉblock.Nextˉoffset - Thenˉstart.Offset, Secondˉoffset, Secondˉlength, Result);
}

export fn Compilerˉbodyˉparseˉmatchˉstatement(
    Input: bytes,
    Start: Sourceˉlexer.Compilerˉsourceˉtoken,
    Endˉoffset: u32,
    Statementˉnesting: u32
) -> Compilerˉsourceˉstatement {
    var Scanˉoffset: u32 = Start.Nextˉoffset;
    var Scanˉline: u32 = Start.Nextˉline;
    var Scanˉcolumn: u32 = Start.Nextˉcolumn;
    var Parentheses: u32 = 0u32;
    var Brackets: u32 = 0u32;
    var Foundˉbody: bool = false;
    var Bodyˉstart: Sourceˉlexer.Compilerˉsourceˉtoken = Compilerˉbodyˉtoken(
        Input, Scanˉoffset, Scanˉline, Scanˉcolumn, Endˉoffset
    );
    while !Foundˉbody {
        let Token: Sourceˉlexer.Compilerˉsourceˉtoken = Compilerˉbodyˉtoken(
            Input, Scanˉoffset, Scanˉline, Scanˉcolumn, Endˉoffset
        );
        if Token.Status != Sourceˉlexer.Compilerˉlexˉstatus.Valid {
            return Compilerˉbodyˉstatementˉfailure(
                Compilerˉbodyˉstepˉfromˉtoken(
                    Compilerˉbodyˉparseˉstatus.Lexicalˉerror,
                    Token,
                    Sourceˉlexer.Compilerˉtokenˉkind.Leftˉbrace
                ),
                Compilerˉsourceˉstatementˉkind.Match,
                Start
            );
        }
        if Token.Kind == Sourceˉlexer.Compilerˉtokenˉkind.End {
            return Compilerˉbodyˉstatementˉfailure(
                Compilerˉbodyˉstepˉfromˉtoken(
                    Compilerˉbodyˉparseˉstatus.Expectedˉtoken,
                    Token,
                    Sourceˉlexer.Compilerˉtokenˉkind.Leftˉbrace
                ),
                Compilerˉsourceˉstatementˉkind.Match,
                Start
            );
        }
        if Token.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Leftˉparenthesis {
            Parentheses = Parentheses + 1u32;
        }
        if Token.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Rightˉparenthesis {
            if Parentheses > 0u32 { Parentheses = Parentheses - 1u32; }
        }
        if Token.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Leftˉbracket {
            Brackets = Brackets + 1u32;
        }
        if Token.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Rightˉbracket {
            if Brackets > 0u32 { Brackets = Brackets - 1u32; }
        }
        if Token.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Leftˉbrace {
            if Parentheses == 0u32 {
                if Brackets == 0u32 {
                    Foundˉbody = true;
                    Bodyˉstart = Token;
                }
            }
        }
        if !Foundˉbody {
            Scanˉoffset = Token.Nextˉoffset;
            Scanˉline = Token.Nextˉline;
            Scanˉcolumn = Token.Nextˉcolumn;
        }
    }
    let Value: Compilerˉsourceˉexpression = Compilerˉparseˉexpressionˉvalidated(
        Input,
        Start.Nextˉoffset,
        Start.Nextˉline,
        Start.Nextˉcolumn,
        Bodyˉstart.Offset,
        0u32,
        0u32
    );
    if Value.Status != Compilerˉbodyˉparseˉstatus.Valid {
        return Compilerˉbodyˉstatementˉfailure(
            Compilerˉbodyˉstepˉfromˉexpression(Value),
            Compilerˉsourceˉstatementˉkind.Match,
            Start
        );
    }
    var Cursor: u32 = Bodyˉstart.Nextˉoffset;
    var Currentˉline: u32 = Bodyˉstart.Nextˉline;
    var Currentˉcolumn: u32 = Bodyˉstart.Nextˉcolumn;
    var Cases: u32 = 0u32;
    var Statements: u32 = 1u32;
    var Expressions: u32 = Value.Nodes;
    var Statementˉdepth: u32 = 1u32;
    var Expressionˉdepth: u32 = Value.Depth;
    var Reading: bool = true;
    while Reading {
        let Current: Sourceˉlexer.Compilerˉsourceˉtoken = Compilerˉbodyˉtoken(
            Input, Cursor, Currentˉline, Currentˉcolumn, Endˉoffset
        );
        if Current.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Rightˉbrace {
            if Cases == 0u32 {
                return Compilerˉbodyˉstatementˉfailure(
                    Compilerˉbodyˉstepˉfromˉtoken(
                        Compilerˉbodyˉparseˉstatus.Expectedˉtoken,
                        Current,
                        Sourceˉlexer.Compilerˉtokenˉkind.Case
                    ),
                    Compilerˉsourceˉstatementˉkind.Match,
                    Start
                );
            }
            let Result: Compilerˉbodyˉparseˉstep = Compilerˉbodyˉstepˉvalid(
                Current.Nextˉoffset,
                Current.Nextˉline,
                Current.Nextˉcolumn,
                Statements,
                Expressions,
                Statementˉdepth,
                Expressionˉdepth
            );
            return Compilerˉbodyˉstatementˉmake(
                Compilerˉsourceˉstatementˉkind.Match,
                false,
                Start,
                Current.Nextˉoffset,
                Bodyˉstart.Nextˉoffset,
                Cases,
                Sourceˉdeclarations.Compilerˉsourceˉtypeˉkind.Unknown,
                Start.Offset,
                0u32,
                Value.Offset,
                Value.Length,
                Bodyˉstart.Offset,
                Current.Nextˉoffset - Bodyˉstart.Offset,
                Start.Offset,
                0u32,
                Result
            );
        }
        let Case: Compilerˉsourceˉmatchˉcase = Compilerˉbodyˉparseˉmatchˉcase(
            Input, Cursor, Currentˉline, Currentˉcolumn, Endˉoffset, Statementˉnesting + 1u32
        );
        if Case.Status != Compilerˉbodyˉparseˉstatus.Valid {
            return Compilerˉbodyˉstatementˉfailure(
                Compilerˉbodyˉstepˉfromˉmatchˉcase(Case),
                Compilerˉsourceˉstatementˉkind.Match,
                Start
            );
        }
        Cases = Cases + 1u32;
        Statements = Statements + Case.Statements;
        Expressions = Expressions + Case.Expressions;
        Statementˉdepth = Compilerˉbodyˉmaximum(
            Statementˉdepth,
            Case.Maximumˉstatementˉdepth + 1u32
        );
        Expressionˉdepth = Compilerˉbodyˉmaximum(
            Expressionˉdepth,
            Case.Maximumˉexpressionˉdepth
        );
        if Cases > 4096u32 {
            return Compilerˉbodyˉstatementˉfailure(
                Compilerˉbodyˉstepˉfromˉtoken(
                    Compilerˉbodyˉparseˉstatus.Itemˉlimit,
                    Current,
                    Sourceˉlexer.Compilerˉtokenˉkind.Rightˉbrace
                ),
                Compilerˉsourceˉstatementˉkind.Match,
                Start
            );
        }
        Cursor = Case.Nextˉoffset;
        Currentˉline = Case.Nextˉline;
        Currentˉcolumn = Case.Nextˉcolumn;
    }
    return Compilerˉbodyˉstatementˉfailure(
        Compilerˉbodyˉstepˉfromˉtoken(
            Compilerˉbodyˉparseˉstatus.Expectedˉtoken,
            Bodyˉstart,
            Sourceˉlexer.Compilerˉtokenˉkind.Rightˉbrace
        ),
        Compilerˉsourceˉstatementˉkind.Match,
        Start
    );
}

export fn Compilerˉbodyˉparseˉwhileˉstatement(
    Input: bytes,
    Start: Sourceˉlexer.Compilerˉsourceˉtoken,
    Endˉoffset: u32,
    Statementˉnesting: u32
) -> Compilerˉsourceˉstatement {
    let Condition: Compilerˉsourceˉexpression = Compilerˉparseˉexpressionˉvalidated(Input, Start.Nextˉoffset, Start.Nextˉline, Start.Nextˉcolumn, Endˉoffset, 0u32, 0u32);
    if Condition.Status != Compilerˉbodyˉparseˉstatus.Valid { return Compilerˉbodyˉstatementˉfailure(Compilerˉbodyˉstepˉfromˉexpression(Condition), Compilerˉsourceˉstatementˉkind.While, Start); }
    let Bodyˉstart: Sourceˉlexer.Compilerˉsourceˉtoken = Compilerˉbodyˉtoken(Input, Condition.Nextˉoffset, Condition.Nextˉline, Condition.Nextˉcolumn, Endˉoffset);
    let Body: Compilerˉbodyˉparseˉstep = Compilerˉparseˉblockˉvalidated(Input, Condition.Nextˉoffset, Condition.Nextˉline, Condition.Nextˉcolumn, Endˉoffset, Statementˉnesting + 1u32);
    if Body.Status != Compilerˉbodyˉparseˉstatus.Valid { return Compilerˉbodyˉstatementˉfailure(Body, Compilerˉsourceˉstatementˉkind.While, Start); }
    let Statements: u32 = 1u32 + Body.Statements;
    if Statements > 4096u32 { return Compilerˉbodyˉstatementˉfailure(Compilerˉbodyˉstepˉfromˉtoken(Compilerˉbodyˉparseˉstatus.Itemˉlimit, Start, Sourceˉlexer.Compilerˉtokenˉkind.Rightˉbrace), Compilerˉsourceˉstatementˉkind.While, Start); }
    let Result: Compilerˉbodyˉparseˉstep = Compilerˉbodyˉstepˉvalid(Body.Nextˉoffset, Body.Nextˉline, Body.Nextˉcolumn, Statements, Condition.Nodes + Body.Expressions, Body.Maximumˉstatementˉdepth + 1u32, Compilerˉbodyˉmaximum(Condition.Depth, Body.Maximumˉexpressionˉdepth));
    return Compilerˉbodyˉstatementˉmake(Compilerˉsourceˉstatementˉkind.While, false, Start, Body.Nextˉoffset, Start.Offset, 0u32, Sourceˉdeclarations.Compilerˉsourceˉtypeˉkind.Unknown, Start.Offset, 0u32, Condition.Offset, Condition.Length, Bodyˉstart.Offset, Body.Nextˉoffset - Bodyˉstart.Offset, Start.Offset, 0u32, Result);
}

export fn Compilerˉbodyˉparseˉpushˉstatement(
    Input: bytes,
    Start: Sourceˉlexer.Compilerˉsourceˉtoken,
    Endˉoffset: u32
) -> Compilerˉsourceˉstatement {
    let Builder: Sourceˉlexer.Compilerˉsourceˉtoken = Compilerˉbodyˉtoken(
        Input, Start.Nextˉoffset, Start.Nextˉline, Start.Nextˉcolumn, Endˉoffset
    );
    let Afterˉbuilder: Compilerˉbodyˉparseˉstep = Compilerˉbodyˉconsume(
        Input, Start.Nextˉoffset, Start.Nextˉline, Start.Nextˉcolumn,
        Endˉoffset, Sourceˉlexer.Compilerˉtokenˉkind.Identifier
    );
    if Afterˉbuilder.Status != Compilerˉbodyˉparseˉstatus.Valid {
        return Compilerˉbodyˉstatementˉfailure(Afterˉbuilder, Compilerˉsourceˉstatementˉkind.Push, Start);
    }
    let Afterˉcomma: Compilerˉbodyˉparseˉstep = Compilerˉbodyˉconsume(
        Input, Afterˉbuilder.Nextˉoffset, Afterˉbuilder.Nextˉline, Afterˉbuilder.Nextˉcolumn,
        Endˉoffset, Sourceˉlexer.Compilerˉtokenˉkind.Comma
    );
    if Afterˉcomma.Status != Compilerˉbodyˉparseˉstatus.Valid {
        return Compilerˉbodyˉstatementˉfailure(Afterˉcomma, Compilerˉsourceˉstatementˉkind.Push, Start);
    }
    let Value: Compilerˉsourceˉexpression = Compilerˉparseˉexpressionˉvalidated(
        Input, Afterˉcomma.Nextˉoffset, Afterˉcomma.Nextˉline, Afterˉcomma.Nextˉcolumn,
        Endˉoffset, 0u32, 0u32
    );
    if Value.Status != Compilerˉbodyˉparseˉstatus.Valid {
        return Compilerˉbodyˉstatementˉfailure(Compilerˉbodyˉstepˉfromˉexpression(Value), Compilerˉsourceˉstatementˉkind.Push, Start);
    }
    let End: Compilerˉbodyˉparseˉstep = Compilerˉbodyˉconsume(
        Input, Value.Nextˉoffset, Value.Nextˉline, Value.Nextˉcolumn,
        Endˉoffset, Sourceˉlexer.Compilerˉtokenˉkind.Semicolon
    );
    if End.Status != Compilerˉbodyˉparseˉstatus.Valid {
        return Compilerˉbodyˉstatementˉfailure(End, Compilerˉsourceˉstatementˉkind.Push, Start);
    }
    let Result: Compilerˉbodyˉparseˉstep = Compilerˉbodyˉstepˉvalid(
        End.Nextˉoffset, End.Nextˉline, End.Nextˉcolumn,
        1u32, Value.Nodes, 1u32, Value.Depth
    );
    return Compilerˉbodyˉstatementˉmake(
        Compilerˉsourceˉstatementˉkind.Push, false, Start, End.Nextˉoffset,
        Builder.Offset, Builder.Length,
        Sourceˉdeclarations.Compilerˉsourceˉtypeˉkind.Unknown,
        Start.Offset, 0u32, Value.Offset, Value.Length,
        Start.Offset, 0u32, Start.Offset, 0u32, Result
    );
}

export fn Compilerˉbodyˉparseˉforˉstatement(
    Input: bytes,
    Start: Sourceˉlexer.Compilerˉsourceˉtoken,
    Endˉoffset: u32,
    Statementˉnesting: u32
) -> Compilerˉsourceˉstatement {
    let Binding: Sourceˉlexer.Compilerˉsourceˉtoken = Compilerˉbodyˉtoken(
        Input, Start.Nextˉoffset, Start.Nextˉline, Start.Nextˉcolumn, Endˉoffset
    );
    let Afterˉbinding: Compilerˉbodyˉparseˉstep = Compilerˉbodyˉconsume(
        Input, Start.Nextˉoffset, Start.Nextˉline, Start.Nextˉcolumn,
        Endˉoffset, Sourceˉlexer.Compilerˉtokenˉkind.Identifier
    );
    if Afterˉbinding.Status != Compilerˉbodyˉparseˉstatus.Valid {
        return Compilerˉbodyˉstatementˉfailure(Afterˉbinding, Compilerˉsourceˉstatementˉkind.For, Start);
    }
    let Afterˉin: Compilerˉbodyˉparseˉstep = Compilerˉbodyˉconsume(
        Input, Afterˉbinding.Nextˉoffset, Afterˉbinding.Nextˉline, Afterˉbinding.Nextˉcolumn,
        Endˉoffset, Sourceˉlexer.Compilerˉtokenˉkind.In
    );
    if Afterˉin.Status != Compilerˉbodyˉparseˉstatus.Valid {
        return Compilerˉbodyˉstatementˉfailure(Afterˉin, Compilerˉsourceˉstatementˉkind.For, Start);
    }
    let Sequence: Compilerˉsourceˉexpression = Compilerˉparseˉexpressionˉvalidated(
        Input, Afterˉin.Nextˉoffset, Afterˉin.Nextˉline, Afterˉin.Nextˉcolumn,
        Endˉoffset, 0u32, 0u32
    );
    if Sequence.Status != Compilerˉbodyˉparseˉstatus.Valid {
        return Compilerˉbodyˉstatementˉfailure(Compilerˉbodyˉstepˉfromˉexpression(Sequence), Compilerˉsourceˉstatementˉkind.For, Start);
    }
    let Bodyˉstart: Sourceˉlexer.Compilerˉsourceˉtoken = Compilerˉbodyˉtoken(
        Input, Sequence.Nextˉoffset, Sequence.Nextˉline, Sequence.Nextˉcolumn, Endˉoffset
    );
    let Body: Compilerˉbodyˉparseˉstep = Compilerˉparseˉblockˉvalidated(
        Input, Sequence.Nextˉoffset, Sequence.Nextˉline, Sequence.Nextˉcolumn,
        Endˉoffset, Statementˉnesting + 1u32
    );
    if Body.Status != Compilerˉbodyˉparseˉstatus.Valid {
        return Compilerˉbodyˉstatementˉfailure(Body, Compilerˉsourceˉstatementˉkind.For, Start);
    }
    let Statements: u32 = 1u32 + Body.Statements;
    if Statements > 4096u32 {
        return Compilerˉbodyˉstatementˉfailure(
            Compilerˉbodyˉstepˉfromˉtoken(Compilerˉbodyˉparseˉstatus.Itemˉlimit, Start, Sourceˉlexer.Compilerˉtokenˉkind.Rightˉbrace),
            Compilerˉsourceˉstatementˉkind.For, Start
        );
    }
    let Result: Compilerˉbodyˉparseˉstep = Compilerˉbodyˉstepˉvalid(
        Body.Nextˉoffset, Body.Nextˉline, Body.Nextˉcolumn,
        Statements, Sequence.Nodes + Body.Expressions,
        Body.Maximumˉstatementˉdepth + 1u32,
        Compilerˉbodyˉmaximum(Sequence.Depth, Body.Maximumˉexpressionˉdepth)
    );
    return Compilerˉbodyˉstatementˉmake(
        Compilerˉsourceˉstatementˉkind.For, false, Start, Body.Nextˉoffset,
        Binding.Offset, Binding.Length,
        Sourceˉdeclarations.Compilerˉsourceˉtypeˉkind.Unknown,
        Start.Offset, 0u32, Sequence.Offset, Sequence.Length,
        Bodyˉstart.Offset, Body.Nextˉoffset - Bodyˉstart.Offset,
        Start.Offset, 0u32, Result
    );
}

export fn Compilerˉbodyˉparseˉblockˉstatement(
    Input: bytes,
    Start: Sourceˉlexer.Compilerˉsourceˉtoken,
    Endˉoffset: u32,
    Statementˉnesting: u32
) -> Compilerˉsourceˉstatement {
    let Body: Compilerˉbodyˉparseˉstep = Compilerˉparseˉblockˉvalidated(Input, Start.Offset, Start.Line, Start.Column, Endˉoffset, Statementˉnesting + 1u32);
    if Body.Status != Compilerˉbodyˉparseˉstatus.Valid { return Compilerˉbodyˉstatementˉfailure(Body, Compilerˉsourceˉstatementˉkind.Block, Start); }
    let Statements: u32 = Body.Statements + 1u32;
    if Statements > 4096u32 { return Compilerˉbodyˉstatementˉfailure(Compilerˉbodyˉstepˉfromˉtoken(Compilerˉbodyˉparseˉstatus.Itemˉlimit, Start, Sourceˉlexer.Compilerˉtokenˉkind.Rightˉbrace), Compilerˉsourceˉstatementˉkind.Block, Start); }
    let Result: Compilerˉbodyˉparseˉstep = Compilerˉbodyˉstepˉvalid(Body.Nextˉoffset, Body.Nextˉline, Body.Nextˉcolumn, Statements, Body.Expressions, Body.Maximumˉstatementˉdepth + 1u32, Body.Maximumˉexpressionˉdepth);
    return Compilerˉbodyˉstatementˉmake(Compilerˉsourceˉstatementˉkind.Block, false, Start, Body.Nextˉoffset, Start.Offset, 0u32, Sourceˉdeclarations.Compilerˉsourceˉtypeˉkind.Unknown, Start.Offset, 0u32, Start.Offset, 0u32, Start.Offset, Body.Nextˉoffset - Start.Offset, Start.Offset, 0u32, Result);
}

export fn Compilerˉparseˉnextˉstatementˉvalidated(
    Input: bytes,
    Offset: u32,
    Line: u32,
    Column: u32,
    Endˉoffset: u32,
    Statementˉnesting: u32
) -> Compilerˉsourceˉstatement {
    let Start: Sourceˉlexer.Compilerˉsourceˉtoken = Compilerˉbodyˉtoken(Input, Offset, Line, Column, Endˉoffset);
    if Start.Status != Sourceˉlexer.Compilerˉlexˉstatus.Valid { return Compilerˉbodyˉstatementˉfailure(Compilerˉbodyˉstepˉfromˉtoken(Compilerˉbodyˉparseˉstatus.Lexicalˉerror, Start, Sourceˉlexer.Compilerˉtokenˉkind.Identifier), Compilerˉsourceˉstatementˉkind.End, Start); }
    if Statementˉnesting > 64u32 { return Compilerˉbodyˉstatementˉfailure(Compilerˉbodyˉstepˉfromˉtoken(Compilerˉbodyˉparseˉstatus.Nestingˉlimit, Start, Sourceˉlexer.Compilerˉtokenˉkind.Rightˉbrace), Compilerˉsourceˉstatementˉkind.End, Start); }
    if Start.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Let { return Compilerˉbodyˉparseˉlocalˉstatement(Input, Start, Endˉoffset); }
    if Start.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Var { return Compilerˉbodyˉparseˉlocalˉstatement(Input, Start, Endˉoffset); }
    if Start.Kind == Sourceˉlexer.Compilerˉtokenˉkind.If { return Compilerˉbodyˉparseˉifˉstatement(Input, Start, Endˉoffset, Statementˉnesting); }
    if Start.Kind == Sourceˉlexer.Compilerˉtokenˉkind.While { return Compilerˉbodyˉparseˉwhileˉstatement(Input, Start, Endˉoffset, Statementˉnesting); }
    if Start.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Push { return Compilerˉbodyˉparseˉpushˉstatement(Input, Start, Endˉoffset); }
    if Start.Kind == Sourceˉlexer.Compilerˉtokenˉkind.For { return Compilerˉbodyˉparseˉforˉstatement(Input, Start, Endˉoffset, Statementˉnesting); }
    if Start.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Match { return Compilerˉbodyˉparseˉmatchˉstatement(Input, Start, Endˉoffset, Statementˉnesting); }
    if Start.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Return { return Compilerˉbodyˉparseˉreturnˉstatement(Input, Start, Endˉoffset); }
    if Start.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Try {
        return Compilerˉbodyˉparseˉterminatedˉexpressionˉstatement(
            Input, Start, Endˉoffset, Compilerˉsourceˉstatementˉkind.Try,
            Start.Nextˉoffset, Start.Nextˉline, Start.Nextˉcolumn
        );
    }
    if Start.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Break { return Compilerˉbodyˉparseˉloopˉcontrolˉstatement(Input, Start, Endˉoffset); }
    if Start.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Continue { return Compilerˉbodyˉparseˉloopˉcontrolˉstatement(Input, Start, Endˉoffset); }
    if Start.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Leftˉbrace { return Compilerˉbodyˉparseˉblockˉstatement(Input, Start, Endˉoffset, Statementˉnesting); }
    if Start.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Identifier {
        let Lookahead: Sourceˉlexer.Compilerˉsourceˉtoken = Compilerˉbodyˉtoken(Input, Start.Nextˉoffset, Start.Nextˉline, Start.Nextˉcolumn, Endˉoffset);
        if Compilerˉbodyˉisˉassignmentˉoperator(Lookahead.Kind) { return Compilerˉbodyˉparseˉassignmentˉstatement(Input, Start, Endˉoffset); }
    }
    return Compilerˉbodyˉparseˉterminatedˉexpressionˉstatement(
        Input, Start, Endˉoffset, Compilerˉsourceˉstatementˉkind.Expression,
        Start.Offset, Start.Line, Start.Column
    );
}

export fn Compilerˉparseˉblockˉvalidated(
    Input: bytes,
    Offset: u32,
    Line: u32,
    Column: u32,
    Endˉoffset: u32,
    Statementˉnesting: u32
) -> Compilerˉbodyˉparseˉstep {
    let Total: u32 = Bytesˉlength(Input);
    if Offset > Endˉoffset { return Compilerˉbodyˉstepˉfailure(Compilerˉbodyˉparseˉstatus.Invalidˉspan, Sourceˉlexer.Compilerˉlexˉstatus.Valid, Offset, Line, Column, Sourceˉlexer.Compilerˉtokenˉkind.Leftˉbrace, Sourceˉlexer.Compilerˉtokenˉkind.End); }
    if Endˉoffset > Total { return Compilerˉbodyˉstepˉfailure(Compilerˉbodyˉparseˉstatus.Invalidˉspan, Sourceˉlexer.Compilerˉlexˉstatus.Valid, Endˉoffset, Line, Column, Sourceˉlexer.Compilerˉtokenˉkind.Rightˉbrace, Sourceˉlexer.Compilerˉtokenˉkind.End); }
    if Statementˉnesting > 64u32 { return Compilerˉbodyˉstepˉfailure(Compilerˉbodyˉparseˉstatus.Nestingˉlimit, Sourceˉlexer.Compilerˉlexˉstatus.Valid, Offset, Line, Column, Sourceˉlexer.Compilerˉtokenˉkind.Rightˉbrace, Sourceˉlexer.Compilerˉtokenˉkind.Leftˉbrace); }
    let Start: Compilerˉbodyˉparseˉstep = Compilerˉbodyˉconsume(Input, Offset, Line, Column, Endˉoffset, Sourceˉlexer.Compilerˉtokenˉkind.Leftˉbrace);
    if Start.Status != Compilerˉbodyˉparseˉstatus.Valid { return Start; }
    var Cursor: u32 = Start.Nextˉoffset;
    var Currentˉline: u32 = Start.Nextˉline;
    var Currentˉcolumn: u32 = Start.Nextˉcolumn;
    var Statements: u32 = 0u32;
    var Topˉlevelˉstatements: u32 = 0u32;
    var Expressions: u32 = 0u32;
    var Maximumˉstatementˉdepth: u32 = 0u32;
    var Maximumˉexpressionˉdepth: u32 = 0u32;
    var Reading: bool = true;
    while Reading {
        let Current: Sourceˉlexer.Compilerˉsourceˉtoken = Compilerˉbodyˉtoken(Input, Cursor, Currentˉline, Currentˉcolumn, Endˉoffset);
        if Current.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Rightˉbrace {
            let End: Compilerˉbodyˉparseˉstep = Compilerˉbodyˉconsume(Input, Cursor, Currentˉline, Currentˉcolumn, Endˉoffset, Sourceˉlexer.Compilerˉtokenˉkind.Rightˉbrace);
            if End.Status != Compilerˉbodyˉparseˉstatus.Valid { return End; }
            return Compilerˉbodyˉblockˉstepˉvalid(End.Nextˉoffset, End.Nextˉline, End.Nextˉcolumn, Topˉlevelˉstatements, Statements, Expressions, Maximumˉstatementˉdepth, Maximumˉexpressionˉdepth);
        }
        if Current.Kind == Sourceˉlexer.Compilerˉtokenˉkind.End { return Compilerˉbodyˉstepˉfromˉtoken(Compilerˉbodyˉparseˉstatus.Expectedˉtoken, Current, Sourceˉlexer.Compilerˉtokenˉkind.Rightˉbrace); }
        let Statement: Compilerˉsourceˉstatement = Compilerˉparseˉnextˉstatementˉvalidated(Input, Cursor, Currentˉline, Currentˉcolumn, Endˉoffset, Statementˉnesting);
        if Statement.Status != Compilerˉbodyˉparseˉstatus.Valid { return Compilerˉbodyˉstepˉfromˉstatement(Statement); }
        Topˉlevelˉstatements = Topˉlevelˉstatements + 1u32;
        Statements = Statements + Statement.Statements;
        Expressions = Expressions + Statement.Expressions;
        if Statements > 4096u32 { return Compilerˉbodyˉstepˉfromˉtoken(Compilerˉbodyˉparseˉstatus.Itemˉlimit, Current, Sourceˉlexer.Compilerˉtokenˉkind.Rightˉbrace); }
        if Expressions > 262144u32 { return Compilerˉbodyˉstepˉfromˉtoken(Compilerˉbodyˉparseˉstatus.Itemˉlimit, Current, Sourceˉlexer.Compilerˉtokenˉkind.Rightˉbrace); }
        Maximumˉstatementˉdepth = Compilerˉbodyˉmaximum(Maximumˉstatementˉdepth, Statement.Maximumˉstatementˉdepth);
        Maximumˉexpressionˉdepth = Compilerˉbodyˉmaximum(Maximumˉexpressionˉdepth, Statement.Maximumˉexpressionˉdepth);
        Cursor = Statement.Nextˉoffset;
        Currentˉline = Statement.Nextˉline;
        Currentˉcolumn = Statement.Nextˉcolumn;
    }
    return Compilerˉbodyˉblockˉstepˉvalid(Cursor, Currentˉline, Currentˉcolumn, Topˉlevelˉstatements, Statements, Expressions, Maximumˉstatementˉdepth, Maximumˉexpressionˉdepth);
}

export fn Compilerˉbodyˉsummaryˉmake(
    Functions: u32,
    Topˉlevelˉstatements: u32,
    Statements: u32,
    Expressions: u32,
    Maximumˉstatementˉdepth: u32,
    Maximumˉexpressionˉdepth: u32,
    Offset: u32,
    Line: u32,
    Column: u32
) -> Compilerˉsourceˉbodyˉsummary {
    return Compilerˉsourceˉbodyˉsummary(
        Compilerˉbodyˉparseˉstatus.Valid,
        Sourceˉlexer.Compilerˉlexˉstatus.Valid,
        Functions,
        Topˉlevelˉstatements,
        Statements,
        Expressions,
        Maximumˉstatementˉdepth,
        Maximumˉexpressionˉdepth,
        Offset,
        Line,
        Column,
        Offset,
        Line,
        Column,
        Sourceˉlexer.Compilerˉtokenˉkind.End,
        Sourceˉlexer.Compilerˉtokenˉkind.End
    );
}

export fn Compilerˉbodyˉsummaryˉfailureˉfromˉstep(
    Step: Compilerˉbodyˉparseˉstep
) -> Compilerˉsourceˉbodyˉsummary {
    return Compilerˉsourceˉbodyˉsummary(
        Step.Status,
        Step.Lexicalˉstatus,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        Step.Nextˉoffset,
        Step.Nextˉline,
        Step.Nextˉcolumn,
        Step.Failureˉoffset,
        Step.Failureˉline,
        Step.Failureˉcolumn,
        Step.Expected,
        Step.Found
    );
}

export fn Compilerˉbodyˉsummaryˉfailureˉfromˉdeclarations(
    Summary: Sourceˉdeclarations.Compilerˉsourceˉmoduleˉsummary
) -> Compilerˉsourceˉbodyˉsummary {
    var Status: Compilerˉbodyˉparseˉstatus = Compilerˉbodyˉparseˉstatus.Declarationˉerror;
    if Summary.Status == Sourceˉdeclarations.Compilerˉparseˉstatus.Lexicalˉerror { Status = Compilerˉbodyˉparseˉstatus.Lexicalˉerror; }
    return Compilerˉsourceˉbodyˉsummary(
        Status,
        Summary.Lexicalˉstatus,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        Summary.Endˉoffset,
        Summary.Endˉline,
        Summary.Endˉcolumn,
        Summary.Failureˉoffset,
        Summary.Failureˉline,
        Summary.Failureˉcolumn,
        Summary.Expected,
        Summary.Found
    );
}

export fn Compilerˉparseˉbodyˉspanˉvalidated(
    Input: bytes,
    Offset: u32,
    Line: u32,
    Column: u32,
    Endˉoffset: u32
) -> Compilerˉsourceˉbodyˉsummary {
    let Body: Compilerˉbodyˉparseˉstep = Compilerˉparseˉblockˉvalidated(Input, Offset, Line, Column, Endˉoffset, 0u32);
    if Body.Status != Compilerˉbodyˉparseˉstatus.Valid { return Compilerˉbodyˉsummaryˉfailureˉfromˉstep(Body); }
    if Body.Nextˉoffset != Endˉoffset {
        let Trailing: Sourceˉlexer.Compilerˉsourceˉtoken = Compilerˉbodyˉtoken(Input, Body.Nextˉoffset, Body.Nextˉline, Body.Nextˉcolumn, Endˉoffset);
        return Compilerˉbodyˉsummaryˉfailureˉfromˉstep(Compilerˉbodyˉstepˉfromˉtoken(Compilerˉbodyˉparseˉstatus.Invalidˉspan, Trailing, Sourceˉlexer.Compilerˉtokenˉkind.End));
    }
    return Compilerˉbodyˉsummaryˉmake(1u32, Body.Topˉlevelˉstatements, Body.Statements, Body.Expressions, Body.Maximumˉstatementˉdepth, Body.Maximumˉexpressionˉdepth, Body.Nextˉoffset, Body.Nextˉline, Body.Nextˉcolumn);
}

export fn Compilerˉparseˉbodyˉspan(
    Input: bytes,
    Offset: u32,
    Line: u32,
    Column: u32,
    Endˉoffset: u32
) -> Compilerˉsourceˉbodyˉsummary {
    let Scan: Sourceˉlexer.Compilerˉsourceˉscan = Sourceˉlexer.Compilerˉlexˉsource(Input);
    if Scan.Status != Sourceˉlexer.Compilerˉlexˉstatus.Valid {
        return Compilerˉsourceˉbodyˉsummary(Compilerˉbodyˉparseˉstatus.Lexicalˉerror, Scan.Status, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32, Scan.Failureˉoffset, Scan.Failureˉline, Scan.Failureˉcolumn, Scan.Failureˉoffset, Scan.Failureˉline, Scan.Failureˉcolumn, Sourceˉlexer.Compilerˉtokenˉkind.End, Sourceˉlexer.Compilerˉtokenˉkind.Bad);
    }
    let Shape: Sourceˉdeclarations.Compilerˉparseˉstep = Sourceˉdeclarations.Compilerˉparseˉskipˉblockˉafterˉscan(
        Input, Offset, Line, Column
    );
    if Shape.Status == Sourceˉdeclarations.Compilerˉparseˉstatus.Nestingˉlimit {
        return Compilerˉbodyˉsummaryˉfailureˉfromˉstep(
            Compilerˉbodyˉstepˉfailure(
                Compilerˉbodyˉparseˉstatus.Nestingˉlimit,
                Shape.Lexicalˉstatus,
                Shape.Failureˉoffset,
                Shape.Failureˉline,
                Shape.Failureˉcolumn,
                Shape.Expected,
                Shape.Found
            )
        );
    }
    return Compilerˉparseˉbodyˉspanˉvalidated(Input, Offset, Line, Column, Endˉoffset);
}

export fn Compilerˉparseˉsourceˉbodiesˉfromˉdeclarations(
    Input: bytes,
    Declarationˉsummary: Sourceˉdeclarations.Compilerˉsourceˉmoduleˉsummary
) -> Compilerˉsourceˉbodyˉsummary {
    if Declarationˉsummary.Status != Sourceˉdeclarations.Compilerˉparseˉstatus.Valid { return Compilerˉbodyˉsummaryˉfailureˉfromˉdeclarations(Declarationˉsummary); }
    let Header: Sourceˉdeclarations.Compilerˉsourceˉheader = Sourceˉdeclarations.Compilerˉparseˉheaderˉvalidated(Input);
    var Cursor: u32 = Header.Nextˉoffset;
    var Currentˉline: u32 = Header.Nextˉline;
    var Currentˉcolumn: u32 = Header.Nextˉcolumn;
    var Functions: u32 = 0u32;
    var Topˉlevelˉstatements: u32 = 0u32;
    var Statements: u32 = 0u32;
    var Expressions: u32 = 0u32;
    var Maximumˉstatementˉdepth: u32 = 0u32;
    var Maximumˉexpressionˉdepth: u32 = 0u32;
    var Sawˉnonˉimport: bool = false;
    var Reading: bool = true;
    while Reading {
        let Current: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(Input, Cursor, Currentˉline, Currentˉcolumn);
        if Current.Kind == Sourceˉlexer.Compilerˉtokenˉkind.End {
            Cursor = Current.Offset;
            Currentˉline = Current.Line;
            Currentˉcolumn = Current.Column;
            Reading = false;
        } else {
            let Declarationˉcursor: u32 = Cursor;
            let Declarationˉline: u32 = Currentˉline;
            let Declarationˉcolumn: u32 = Currentˉcolumn;
            let Declaration: Sourceˉdeclarations.Compilerˉsourceˉdeclaration = Sourceˉdeclarations.Compilerˉparseˉnextˉdeclarationˉvalidated(Input, Cursor, Currentˉline, Currentˉcolumn, Sawˉnonˉimport);
            if Declaration.Status != Sourceˉdeclarations.Compilerˉparseˉstatus.Valid {
                return Compilerˉsourceˉbodyˉsummary(Compilerˉbodyˉparseˉstatus.Declarationˉerror, Declaration.Lexicalˉstatus, Functions, Topˉlevelˉstatements, Statements, Expressions, Maximumˉstatementˉdepth, Maximumˉexpressionˉdepth, Declaration.Nextˉoffset, Declaration.Nextˉline, Declaration.Nextˉcolumn, Declaration.Failureˉoffset, Declaration.Failureˉline, Declaration.Failureˉcolumn, Declaration.Expected, Declaration.Found);
            }
            if Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉclosesˉimports(Declaration) { Sawˉnonˉimport = true; }
            if Declaration.Kind == Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Function {
                let Bodyˉposition: Compilerˉsourceˉposition = Compilerˉbodyˉpositionˉbetween(Input, Declarationˉcursor, Declarationˉline, Declarationˉcolumn, Declaration.Bodyˉoffset);
                if Bodyˉposition.Offset != Declaration.Bodyˉoffset {
                    return Compilerˉsourceˉbodyˉsummary(Compilerˉbodyˉparseˉstatus.Invalidˉspan, Sourceˉlexer.Compilerˉlexˉstatus.Valid, Functions, Topˉlevelˉstatements, Statements, Expressions, Maximumˉstatementˉdepth, Maximumˉexpressionˉdepth, Bodyˉposition.Offset, Bodyˉposition.Line, Bodyˉposition.Column, Bodyˉposition.Offset, Bodyˉposition.Line, Bodyˉposition.Column, Sourceˉlexer.Compilerˉtokenˉkind.Leftˉbrace, Sourceˉlexer.Compilerˉtokenˉkind.End);
                }
                let Bodyˉend: u32 = Declaration.Bodyˉoffset + Declaration.Bodyˉlength;
                let Body: Compilerˉsourceˉbodyˉsummary = Compilerˉparseˉbodyˉspanˉvalidated(Input, Declaration.Bodyˉoffset, Bodyˉposition.Line, Bodyˉposition.Column, Bodyˉend);
                if Body.Status != Compilerˉbodyˉparseˉstatus.Valid { return Body; }
                Functions = Functions + 1u32;
                Topˉlevelˉstatements = Topˉlevelˉstatements + Body.Topˉlevelˉstatements;
                Statements = Statements + Body.Statements;
                Expressions = Expressions + Body.Expressions;
                Maximumˉstatementˉdepth = Compilerˉbodyˉmaximum(Maximumˉstatementˉdepth, Body.Maximumˉstatementˉdepth);
                Maximumˉexpressionˉdepth = Compilerˉbodyˉmaximum(Maximumˉexpressionˉdepth, Body.Maximumˉexpressionˉdepth);
            }
            Cursor = Declaration.Nextˉoffset;
            Currentˉline = Declaration.Nextˉline;
            Currentˉcolumn = Declaration.Nextˉcolumn;
        }
    }
    return Compilerˉbodyˉsummaryˉmake(Functions, Topˉlevelˉstatements, Statements, Expressions, Maximumˉstatementˉdepth, Maximumˉexpressionˉdepth, Cursor, Currentˉline, Currentˉcolumn);
}

export fn Compilerˉparseˉsourceˉbodies(Input: bytes) -> Compilerˉsourceˉbodyˉsummary {
    let Declarationˉsummary: Sourceˉdeclarations.Compilerˉsourceˉmoduleˉsummary = Sourceˉdeclarations.Compilerˉparseˉsource(Input);
    return Compilerˉparseˉsourceˉbodiesˉfromˉdeclarations(Input, Declarationˉsummary);
}
