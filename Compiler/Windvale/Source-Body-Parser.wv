        if Nesting >= 64u32 { return Compilerˉbodyˉexpressionˉfailure(Compilerˉbodyˉparseˉstatus.Nestingˉlimit, Postfix, Sourceˉlexer.Compilerˉtokenˉkind.Rightˉbracket); }
        let Index: Compilerˉsourceˉexpression = Compilerˉparseˉexpressionˉvalidated(Input, Postfix.Nextˉoffset, Postfix.Nextˉline, Postfix.Nextˉcolumn, Endˉoffset, 0u32, Nesting + 1u32);
        if Index.Status != Compilerˉbodyˉparseˉstatus.Valid { return Index; }
        let Indexˉend: Compilerˉbodyˉparseˉstep = Compilerˉbodyˉconsume(Input, Index.Nextˉoffset, Index.Nextˉline, Index.Nextˉcolumn, Endˉoffset, Sourceˉlexer.Compilerˉtokenˉkind.Rightˉbracket);
        if Indexˉend.Status != Compilerˉbodyˉparseˉstatus.Valid { return Compilerˉbodyˉexpressionˉfailureˉfromˉstep(Indexˉend); }
        return Compilerˉbodyˉexpressionˉmake(Compilerˉsourceˉexpressionˉkind.Index, Sourceˉlexer.Compilerˉtokenˉkind.End, Name.Offset, Indexˉend.Nextˉoffset, Line, Column, Name.Offset, Name.Length, Index.Offset, Index.Length, Name.Offset, 0u32, Name.Offset, Name.Offset, 0u32, Sourceˉlexer.Compilerˉnumericˉkind.None, 0u32, false, Indexˉend.Nextˉoffset, Indexˉend.Nextˉline, Indexˉend.Nextˉcolumn, Index.Nodes + 1u32, Index.Depth + 1u32);
    }
    if Name.Parts >= 2u32 {
        return Compilerˉbodyˉexpressionˉmake(Compilerˉsourceˉexpressionˉkind.Field, Sourceˉlexer.Compilerˉtokenˉkind.Dot, Name.Offset, Name.Offset + Name.Length, Line, Column, Name.Offset, Name.Length, Name.Firstˉoffset, Name.Firstˉlength, Name.Secondˉoffset, Name.Secondˉlength, Name.Offset, Name.Offset, 0u32, Sourceˉlexer.Compilerˉnumericˉkind.None, 0u32, false, Name.Nextˉoffset, Name.Nextˉline, Name.Nextˉcolumn, 1u32, 1u32);
    }
    return Compilerˉbodyˉexpressionˉmake(Compilerˉsourceˉexpressionˉkind.Name, Sourceˉlexer.Compilerˉtokenˉkind.End, Name.Offset, Name.Offset + Name.Length, Line, Column, Name.Offset, Name.Length, Name.Offset, 0u32, Name.Offset, 0u32, Name.Offset, Name.Offset, 0u32, Sourceˉlexer.Compilerˉnumericˉkind.None, 0u32, false, Name.Nextˉoffset, Name.Nextˉline, Name.Nextˉcolumn, 1u32, 1u32);
}

export fn Compilerˉbodyˉparseˉunsafeˉexpression(
    Input: bytes,
    Start: Sourceˉlexer.Compilerˉsourceˉtoken,
    Endˉoffset: u32,
    Nesting: u32
) -> Compilerˉsourceˉexpression {
    let Block: Compilerˉsourceˉvalueˉblock =
        Compilerˉbodyˉparseˉvalueˉblock(
            Input, Start.Nextˉoffset, Start.Nextˉline,
            Start.Nextˉcolumn, Endˉoffset, Nesting + 1u32
        );
    if Block.Status != Compilerˉbodyˉparseˉstatus.Valid {
        return Compilerˉbodyˉexpressionˉfailureˉfromˉvalueˉblock(Block);
    }
    let Nodes: u32 = Block.Expressions + 1u32;
    let Depth: u32 = Block.Maximumˉexpressionˉdepth + 1u32;
    if Nodes > 262144u32 {
        return Compilerˉbodyˉexpressionˉfailure(
            Compilerˉbodyˉparseˉstatus.Itemˉlimit, Start,
            Sourceˉlexer.Compilerˉtokenˉkind.Rightˉbrace
        );
    }
    if Depth > 64u32 {
        return Compilerˉbodyˉexpressionˉfailure(
            Compilerˉbodyˉparseˉstatus.Nestingˉlimit, Start,
            Sourceˉlexer.Compilerˉtokenˉkind.Rightˉbrace
        );
    }
    return Compilerˉbodyˉexpressionˉmake(
        Compilerˉsourceˉexpressionˉkind.Unsafe,
        Sourceˉlexer.Compilerˉtokenˉkind.Unsafe,
        Start.Offset, Block.Nextˉoffset, Start.Line, Start.Column,
        Block.Valueˉoffset, Block.Valueˉlength,
        Block.Blockˉoffset, Block.Blockˉlength,
        Block.Statementsˉoffset, Block.Statementsˉlength,
        Block.Statementsˉoffset, Block.Valueˉoffset + Block.Valueˉlength,
        Block.Statements,
        Sourceˉlexer.Compilerˉnumericˉkind.None, 0u32, false,
        Block.Nextˉoffset, Block.Nextˉline, Block.Nextˉcolumn,
        Nodes, Depth
    );
}

fn Compilerˉbodyˉparseˉexpressionˉnested(
    Input: bytes,
    Offset: u32,
    Line: u32,
    Column: u32,
    Endˉoffset: u32,
    Parentˉprecedence: u32,
    Nesting: u32
) -> Compilerˉsourceˉexpression {
    let Total: u32 = Bytesˉlength(Input);
    if Offset > Endˉoffset {
        let Invalidˉstart: Sourceˉlexer.Compilerˉsourceˉtoken = Compilerˉbodyˉtoken(Input, Total, Line, Column, Total);
        return Compilerˉbodyˉexpressionˉfailure(Compilerˉbodyˉparseˉstatus.Invalidˉspan, Invalidˉstart, Sourceˉlexer.Compilerˉtokenˉkind.Identifier);
    }
    if Endˉoffset > Total {
        let Invalidˉend: Sourceˉlexer.Compilerˉsourceˉtoken = Compilerˉbodyˉtoken(Input, Total, Line, Column, Total);
        return Compilerˉbodyˉexpressionˉfailure(Compilerˉbodyˉparseˉstatus.Invalidˉspan, Invalidˉend, Sourceˉlexer.Compilerˉtokenˉkind.Identifier);
    }
    if Nesting > 64u32 {
        let Invalidˉnesting: Sourceˉlexer.Compilerˉsourceˉtoken = Compilerˉbodyˉtoken(Input, Offset, Line, Column, Endˉoffset);
        return Compilerˉbodyˉexpressionˉfailure(Compilerˉbodyˉparseˉstatus.Nestingˉlimit, Invalidˉnesting, Sourceˉlexer.Compilerˉtokenˉkind.Identifier);
    }

    let First: Sourceˉlexer.Compilerˉsourceˉtoken = Compilerˉbodyˉtoken(Input, Offset, Line, Column, Endˉoffset);
    if First.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Fn ||
        First.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Async {
        return Compilerˉbodyˉparseˉclosureˉexpression(
            Input, First, Endˉoffset, Nesting
        );
    }
    if First.Kind == Sourceˉlexer.Compilerˉtokenˉkind.If {
        return Compilerˉbodyˉparseˉifˉexpression(
            Input, First, Endˉoffset, Nesting
        );
    }
    if First.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Unsafe {
        return Compilerˉbodyˉparseˉunsafeˉexpression(
            Input, First, Endˉoffset, Nesting
        );
    }
    if First.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Match {
        let Matchˉform: Compilerˉsourceˉstatement =
            Compilerˉbodyˉparseˉmatchˉstatement(
                Input, First, Endˉoffset, Nesting, true
            );
        if Matchˉform.Status != Compilerˉbodyˉparseˉstatus.Valid {
            return Compilerˉbodyˉexpressionˉfailureˉfromˉstep(
                Compilerˉbodyˉstepˉfromˉstatement(Matchˉform)
            );
        }
        let Matchˉnodes: u32 = Matchˉform.Expressions + 1u32;
        let Matchˉdepth: u32 =
            Matchˉform.Maximumˉexpressionˉdepth + 1u32;
        if Matchˉnodes > 262144u32 {
            return Compilerˉbodyˉexpressionˉfailure(
                Compilerˉbodyˉparseˉstatus.Itemˉlimit,
                First,
                Sourceˉlexer.Compilerˉtokenˉkind.Rightˉbrace
            );
        }
        if Matchˉdepth > 64u32 {
            return Compilerˉbodyˉexpressionˉfailure(
                Compilerˉbodyˉparseˉstatus.Nestingˉlimit,
                First,
                Sourceˉlexer.Compilerˉtokenˉkind.Rightˉbrace
            );
        }
        return Compilerˉbodyˉexpressionˉmake(
            Compilerˉsourceˉexpressionˉkind.Match,
            Sourceˉlexer.Compilerˉtokenˉkind.Match,
            Matchˉform.Offset,
            Matchˉform.Offset + Matchˉform.Length,
            Matchˉform.Line,
            Matchˉform.Column,
            Matchˉform.Expressionˉoffset,
            Matchˉform.Expressionˉlength,
            Matchˉform.Firstˉblockˉoffset,
            Matchˉform.Firstˉblockˉlength,
            Matchˉform.Offset,
            0u32,
            Matchˉform.Nameˉoffset,
            Matchˉform.Firstˉblockˉoffset + Matchˉform.Firstˉblockˉlength,
            Matchˉform.Nameˉlength,
            Sourceˉlexer.Compilerˉnumericˉkind.None,
            0u32,
            false,
            Matchˉform.Nextˉoffset,
            Matchˉform.Nextˉline,
            Matchˉform.Nextˉcolumn,
            Matchˉnodes,
            Matchˉdepth
        );
    }
    let Unaryˉprecedence: u32 = Compilerˉbodyˉunaryˉprecedence(First.Kind);
    var Left: Compilerˉsourceˉexpression = Compilerˉbodyˉexpressionˉfailure(Compilerˉbodyˉparseˉstatus.Expectedˉexpression, First, Sourceˉlexer.Compilerˉtokenˉkind.Identifier);
    if Unaryˉprecedence > 0u32 {
        if Unaryˉprecedence >= Parentˉprecedence {
            var Operandˉoffset: u32 = First.Nextˉoffset;
            var Operandˉline: u32 = First.Nextˉline;
            var Operandˉcolumn: u32 = First.Nextˉcolumn;
            var Operatorˉlength: u32 = First.Length;
            var Mutableˉborrow: bool = false;
            if First.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Borrow {
                let Maybeˉmutable: Sourceˉlexer.Compilerˉsourceˉtoken =
                    Compilerˉbodyˉtoken(
                        Input, Operandˉoffset, Operandˉline,
                        Operandˉcolumn, Endˉoffset
                    );
                if Maybeˉmutable.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Mut {
                    Mutableˉborrow = true;
                    Operatorˉlength = Maybeˉmutable.Nextˉoffset - First.Offset;
                    Operandˉoffset = Maybeˉmutable.Nextˉoffset;
                    Operandˉline = Maybeˉmutable.Nextˉline;
                    Operandˉcolumn = Maybeˉmutable.Nextˉcolumn;
                }
            }
            let Operand: Compilerˉsourceˉexpression = Compilerˉparseˉexpressionˉvalidated(Input, Operandˉoffset, Operandˉline, Operandˉcolumn, Endˉoffset, Unaryˉprecedence, Nesting + 1u32);
            if Operand.Status != Compilerˉbodyˉparseˉstatus.Valid { return Operand; }
            let Unaryˉdepth: u32 = Operand.Depth + 1u32;
            if Unaryˉdepth > 64u32 { return Compilerˉbodyˉexpressionˉfailure(Compilerˉbodyˉparseˉstatus.Nestingˉlimit, First, Sourceˉlexer.Compilerˉtokenˉkind.Identifier); }
            Left = Compilerˉbodyˉexpressionˉmake(Compilerˉsourceˉexpressionˉkind.Unary, First.Kind, First.Offset, Operand.Offset + Operand.Length, First.Line, First.Column, First.Offset, Operatorˉlength, Operand.Offset, Operand.Length, First.Offset, 0u32, First.Offset, First.Offset, 0u32, Sourceˉlexer.Compilerˉnumericˉkind.None, 0u32, Mutableˉborrow, Operand.Nextˉoffset, Operand.Nextˉline, Operand.Nextˉcolumn, Operand.Nodes + 1u32, Unaryˉdepth);
        } else {
            Left = Compilerˉbodyˉparseˉprimary(Input, Offset, Line, Column, Endˉoffset, Nesting);
        }
    } else {
        Left = Compilerˉbodyˉparseˉprimary(Input, Offset, Line, Column, Endˉoffset, Nesting);
    }
    if Left.Status != Compilerˉbodyˉparseˉstatus.Valid { return Left; }

    var Reading: bool = true;
    while Reading {
        let Operator: Sourceˉlexer.Compilerˉsourceˉtoken = Compilerˉbodyˉtoken(Input, Left.Nextˉoffset, Left.Nextˉline, Left.Nextˉcolumn, Endˉoffset);
        let Precedence: u32 = Compilerˉbodyˉbinaryˉprecedence(Operator.Kind);
        if Precedence == 0u32 {
            Reading = false;
        } else {
            if Precedence <= Parentˉprecedence {
                Reading = false;
            } else {
                let Right: Compilerˉsourceˉexpression = Compilerˉparseˉexpressionˉvalidated(Input, Operator.Nextˉoffset, Operator.Nextˉline, Operator.Nextˉcolumn, Endˉoffset, Precedence, Nesting + 1u32);
                if Right.Status != Compilerˉbodyˉparseˉstatus.Valid { return Right; }
                let Nodes: u32 = Left.Nodes + Right.Nodes + 1u32;
                let Binaryˉdepth: u32 = Compilerˉbodyˉmaximum(Left.Depth, Right.Depth) + 1u32;
                if Nodes > 4096u32 { return Compilerˉbodyˉexpressionˉfailure(Compilerˉbodyˉparseˉstatus.Itemˉlimit, Operator, Sourceˉlexer.Compilerˉtokenˉkind.End); }
                if Binaryˉdepth > 64u32 { return Compilerˉbodyˉexpressionˉfailure(Compilerˉbodyˉparseˉstatus.Nestingˉlimit, Operator, Sourceˉlexer.Compilerˉtokenˉkind.End); }
                Left = Compilerˉbodyˉexpressionˉmake(Compilerˉsourceˉexpressionˉkind.Binary, Operator.Kind, Left.Offset, Right.Offset + Right.Length, Left.Line, Left.Column, Operator.Offset, Operator.Length, Left.Offset, Left.Length, Right.Offset, Right.Length, Operator.Offset, Operator.Offset, 0u32, Sourceˉlexer.Compilerˉnumericˉkind.None, 0u32, false, Right.Nextˉoffset, Right.Nextˉline, Right.Nextˉcolumn, Nodes, Binaryˉdepth);
            }
        }
    }
    return Left;
}

export fn Compilerˉparseˉexpressionˉvalidated(
    Input: bytes,
    Offset: u32,
    Line: u32,
    Column: u32,
    Endˉoffset: u32,
    Parentˉprecedence: u32,
    Nesting: u32
) -> Compilerˉsourceˉexpression {
    let Total: u32 = Bytesˉlength(Input);
    if Offset > Endˉoffset || Endˉoffset > Total {
        let Invalidˉspan: Sourceˉlexer.Compilerˉsourceˉtoken =
            Compilerˉbodyˉtoken(Input, Total, Line, Column, Total);
        return Compilerˉbodyˉexpressionˉfailure(
            Compilerˉbodyˉparseˉstatus.Invalidˉspan, Invalidˉspan,
            Sourceˉlexer.Compilerˉtokenˉkind.Identifier
        );
    }
    if Nesting > 64u32 {
        let Invalidˉnesting: Sourceˉlexer.Compilerˉsourceˉtoken =
            Compilerˉbodyˉtoken(Input, Offset, Line, Column, Endˉoffset);
        return Compilerˉbodyˉexpressionˉfailure(
            Compilerˉbodyˉparseˉstatus.Nestingˉlimit, Invalidˉnesting,
            Sourceˉlexer.Compilerˉtokenˉkind.Identifier
        );
    }
    let First: Sourceˉlexer.Compilerˉsourceˉtoken =
        Compilerˉbodyˉtoken(Input, Offset, Line, Column, Endˉoffset);
    if First.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Fn ||
        First.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Async {
        return Compilerˉbodyˉparseˉclosureˉexpression(
            Input, First, Endˉoffset, Nesting
        );
    }
    return Compilerˉbodyˉparseˉexpressionˉnested(
        Input, Offset, Line, Column, Endˉoffset, Parentˉprecedence, Nesting
    );
}

export fn Compilerˉparseˉexpressionˉspan(
    Input: bytes,
    Offset: u32,
    Line: u32,
    Column: u32,
    Endˉoffset: u32
) -> Compilerˉsourceˉexpression {
    let Scan: Sourceˉlexer.Compilerˉsourceˉscan = Sourceˉlexer.Compilerˉlexˉsource(Input);
    if Scan.Status != Sourceˉlexer.Compilerˉlexˉstatus.Valid {
        let Token: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉsourceˉtokenˉmake(
            Scan.Status,
            Sourceˉlexer.Compilerˉtokenˉkind.Bad,
            Scan.Failureˉoffset,
            Scan.Failureˉoffset,
            Scan.Failureˉline,
            Scan.Failureˉcolumn,
            Scan.Failureˉline,
            Scan.Failureˉcolumn,
            Sourceˉlexer.Compilerˉnumericˉkind.None,
            0u32,
            Scan.Failureˉoffset,
            Scan.Failureˉline,
            Scan.Failureˉcolumn
        );
        return Compilerˉbodyˉexpressionˉfailure(Compilerˉbodyˉparseˉstatus.Lexicalˉerror, Token, Sourceˉlexer.Compilerˉtokenˉkind.Identifier);
    }
    let Expression: Compilerˉsourceˉexpression = Compilerˉparseˉexpressionˉvalidated(Input, Offset, Line, Column, Endˉoffset, 0u32, 0u32);
    if Expression.Status != Compilerˉbodyˉparseˉstatus.Valid { return Expression; }
    let Trailing: Sourceˉlexer.Compilerˉsourceˉtoken = Compilerˉbodyˉtoken(Input, Expression.Nextˉoffset, Expression.Nextˉline, Expression.Nextˉcolumn, Endˉoffset);
    if Trailing.Kind != Sourceˉlexer.Compilerˉtokenˉkind.End {
        return Compilerˉbodyˉexpressionˉfailure(Compilerˉbodyˉparseˉstatus.Expectedˉtoken, Trailing, Sourceˉlexer.Compilerˉtokenˉkind.End);
    }
    return Expression;
}

