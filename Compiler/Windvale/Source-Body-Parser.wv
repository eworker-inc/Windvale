    Step: Compilerˉbodyˉparseˉstep
) -> Compilerˉsourceˉstatement {
    return Compilerˉsourceˉstatement(
        Compilerˉbodyˉparseˉstatus.Valid,
        Sourceˉlexer.Compilerˉlexˉstatus.Valid,
        Kind,
        Isˉmutable,
        Start.Offset,
        End - Start.Offset,
        Start.Line,
        Start.Column,
        Nameˉoffset,
        Nameˉlength,
        Typeˉkind,
        Typeˉoffset,
        Typeˉlength,
        Expressionˉoffset,
        Expressionˉlength,
        Firstˉblockˉoffset,
        Firstˉblockˉlength,
        Secondˉblockˉoffset,
        Secondˉblockˉlength,
        Step.Nextˉoffset,
        Step.Nextˉline,
        Step.Nextˉcolumn,
        Step.Statements,
        Step.Expressions,
        Step.Maximumˉstatementˉdepth,
        Step.Maximumˉexpressionˉdepth,
        Step.Nextˉoffset,
        Step.Nextˉline,
        Step.Nextˉcolumn,
        Sourceˉlexer.Compilerˉtokenˉkind.End,
        Sourceˉlexer.Compilerˉtokenˉkind.End
    );
}

