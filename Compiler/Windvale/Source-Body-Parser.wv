module Compilerˉsourceˉbodyˉparser profile portable;

import Compilerˉsourceˉdeclarationˉparser as Sourceˉdeclarations;
import Compilerˉsourceˉlexer as Sourceˉlexer;

export enum Compilerˉbodyˉparseˉstatus {
    Valid = 0;
    Lexicalˉerror = 1;
    Invalidˉspan = 2;
    Expectedˉtoken = 3;
    Expectedˉexpression = 4;
    Invalidˉtype = 5;
    Nestingˉlimit = 6;
    Itemˉlimit = 7;
    Declarationˉerror = 8;
    Unsafeˉprofile = 9;
}

export enum Compilerˉsourceˉstatementˉkind {
    End = 0;
    Block = 1;
    Local = 2;
    Assignment = 3;
    If = 4;
    While = 5;
    Return = 6;
    Expression = 7;
    Break = 8;
    Continue = 9;
    Match = 10;
    Push = 11;
    For = 12;
    Try = 13;
    Using = 14;
    Taskˉscope = 15;
    Unsafe = 16;
}

export enum Compilerˉsourceˉexpressionˉkind {
    Invalid = 0;
    Integer = 1;
    String = 2;
    Boolean = 3;
    Name = 4;
    Field = 5;
    Call = 6;
    Index = 7;
    Unary = 8;
    Binary = 9;
    Namedˉrecord = 10;
    Builder = 11;
    Unit = 12;
    Recordˉupdate = 13;
    Rune = 14;
    Floating = 15;
    If = 16;
    Match = 17;
    Explicitˉgenericˉcall = 18;
    Genericˉnamedˉrecord = 19;
    Array = 20;
    Closure = 21;
    Unsafe = 22;
}

