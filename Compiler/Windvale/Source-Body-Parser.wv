    Nextˉoffset: u32;
    Nextˉline: u32;
    Nextˉcolumn: u32;
    Topˉlevelˉstatements: u32;
    Statements: u32;
    Expressions: u32;
    Maximumˉstatementˉdepth: u32;
    Maximumˉexpressionˉdepth: u32;
    Failureˉoffset: u32;
    Failureˉline: u32;
    Failureˉcolumn: u32;
    Expected: Sourceˉlexer.Compilerˉtokenˉkind;
    Found: Sourceˉlexer.Compilerˉtokenˉkind;
}

