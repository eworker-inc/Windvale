module Compilerˉnativeˉx64ˉloweringˉlayout profile portable;

export fn Compilerˉnativeˉx64ˉlayoutˉentryˉbytes() -> u32 {
    return 16u32;
}

export fn Compilerˉnativeˉx64ˉlayoutˉfunctionˉlimit() -> u32 {
    return 512u32;
}

export fn Compilerˉnativeˉx64ˉlayoutˉappend(
    Directory: bytes,
    Machineˉoffset: u32,
    Machineˉlength: u32,
    Parameters: u32,
    Returnˉtype: u8,
    Parameterˉtypes: bytes
) -> bytes {
    var Result: bytes = Bytesˉconcat(
        Directory,
        Bytesˉfromˉu32ˉlittle(Machineˉoffset)
    );
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Machineˉlength));
    Result = Bytesˉconcat(
        Result,
        Bytesˉslice(Bytesˉfromˉu32ˉlittle(Parameters), 0u32, 1u32)
    );
    Result = Bytesˉconcat(Result, Bytesˉfromˉu8(Returnˉtype));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu16ˉlittle(0u32));
    var Parameter: u32 = 0u32;
    while Parameter < 4u32 {
        var Type: u8 = 0u8;
        if Parameter < Parameters {
            Type = Bytesˉreadˉu8(Parameterˉtypes, Parameter);
        }
        Result = Bytesˉconcat(Result, Bytesˉfromˉu8(Type));
        Parameter = Parameter + 1u32;
    }
    return Result;
}

export fn Compilerˉnativeˉx64ˉlayoutˉmachineˉoffset(
    Directory: bytes,
    Function: u32
) -> u32 {
    return Bytesˉreadˉu32ˉlittle(
        Directory,
        Function * Compilerˉnativeˉx64ˉlayoutˉentryˉbytes()
    );
}

export fn Compilerˉnativeˉx64ˉlayoutˉmachineˉlength(
    Directory: bytes,
    Function: u32
) -> u32 {
    return Bytesˉreadˉu32ˉlittle(
        Directory,
        Function * Compilerˉnativeˉx64ˉlayoutˉentryˉbytes() + 4u32
    );
}

export fn Compilerˉnativeˉx64ˉlayoutˉparameters(
    Directory: bytes,
    Function: u32
) -> u32 {
    return U32ˉfromˉu8(Bytesˉreadˉu8(
        Directory,
        Function * Compilerˉnativeˉx64ˉlayoutˉentryˉbytes() + 8u32
    ));
}

export fn Compilerˉnativeˉx64ˉlayoutˉreturnˉtype(
    Directory: bytes,
    Function: u32
) -> u8 {
    return Bytesˉreadˉu8(
        Directory,
        Function * Compilerˉnativeˉx64ˉlayoutˉentryˉbytes() + 9u32
    );
}

export fn Compilerˉnativeˉx64ˉlayoutˉvalueˉslot(
    Locals: u32,
    I32ˉslots: u32,
    Boolˉslots: u32,
    Textˉslots: u32,
    U8ˉslots: u32,
    U32ˉslots: u32,
    Bytesˉslots: u32,
    Type: u8,
    Index: u32
) -> u32 {
    if Type == 1u8 { return Locals + Index; }
    if Type == 2u8 { return Locals + I32ˉslots + Index; }
    if Type == 3u8 {
        return Locals + I32ˉslots + Boolˉslots + Index;
    }
    if Type == 4u8 {
        return Locals + I32ˉslots + Boolˉslots + Textˉslots + Index;
    }
    if Type == 5u8 {
        return Locals + I32ˉslots + Boolˉslots + Textˉslots + U8ˉslots + Index;
    }
    if Type == 6u8 {
        return Locals + I32ˉslots + Boolˉslots + Textˉslots + U8ˉslots +
            U32ˉslots + Index;
    }
    return Locals + I32ˉslots + Boolˉslots + Textˉslots + U8ˉslots +
        U32ˉslots + Bytesˉslots + Index;
}

export fn Compilerˉnativeˉx64ˉlayoutˉparameterˉtype(
    Directory: bytes,
    Function: u32,
    Parameter: u32
) -> u8 {
    return Bytesˉreadˉu8(
        Directory,
        Function * Compilerˉnativeˉx64ˉlayoutˉentryˉbytes() + 12u32 + Parameter
    );
}

export fn Compilerˉnativeˉx64ˉlayoutˉsymbolˉname(
    Prefix: text,
    Index: u32,
    Limit: u32
) -> bytes {
    if Index >= Limit { return Textˉtoˉutf8(""); }
    var Name: text = Prefix;
    if Index < 10u32 {
        Name = Textˉconcat(Name, "000");
    } else {
        if Index < 100u32 {
            Name = Textˉconcat(Name, "00");
        } else {
            if Index < 1000u32 {
                Name = Textˉconcat(Name, "0");
            }
        }
    }
    return Textˉtoˉutf8(Textˉconcat(Name, U32ˉformat(Index)));
}

export fn Compilerˉnativeˉx64ˉlayoutˉhelperˉname(Function: u32) -> bytes {
    return Compilerˉnativeˉx64ˉlayoutˉsymbolˉname(
        "$function_",
        Function,
        Compilerˉnativeˉx64ˉlayoutˉfunctionˉlimit()
    );
}
