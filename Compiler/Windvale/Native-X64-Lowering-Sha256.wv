fn Patchˉu32(Input: bytes, Offset: u32, Value: u32) -> bytes {
    var Output: bytes = Bytesˉslice(Input, 0u32, Offset);
    Output = Bytesˉconcat(Output, Bytesˉfromˉu32ˉlittle(Value));
    return Bytesˉconcat(
        Output,
        Bytesˉslice(Input, Offset + 4u32, Bytesˉlength(Input) - Offset - 4u32)
    );
}

fn Relativeˉu32(Target: u32, Origin: u32) -> u32 {
    if Target >= Origin { return Target - Origin; }
    let Magnitude: u32 = Origin - Target;
    return 4294967295u32 - Magnitude + 1u32;
}

export fn Compilerˉnativeˉx64ˉsha256ˉinstructionˉbytes() -> u32 {
    return 152u32;
}

export fn Compilerˉnativeˉx64ˉemitˉsha256(
    Result: bytes,
    Source: u32,
    Target: u32,
    Helperˉtarget: u32,
    Runtimeˉtarget: u32
) -> bytes {
    var Instruction: bytes = Compilerˉnativeˉx64ˉsha256ˉinstructionˉtemplate;
    Instruction = Patchˉu32(Instruction, 69u32, Target * 16u32 + 32u32);
    Instruction = Patchˉu32(Instruction, 81u32, Target * 16u32 + 40u32);
    Instruction = Patchˉu32(Instruction, 90u32, Target * 16u32 + 44u32);
    Instruction = Patchˉu32(Instruction, 98u32, Source * 16u32 + 32u32);
    Instruction = Patchˉu32(Instruction, 105u32, Source * 16u32 + 40u32);
    let Base: u32 = Bytesˉlength(Result);
    Instruction = Patchˉu32(
        Instruction, 113u32, Relativeˉu32(Helperˉtarget, Base + 117u32)
    );
    Instruction = Patchˉu32(
        Instruction, 148u32, Relativeˉu32(Runtimeˉtarget, Base + 152u32)
    );
    return Bytesˉconcat(Result, Instruction);
}

export fn Compilerˉnativeˉx64ˉsha256ˉhelperˉbytes() -> u32 {
    return 1640u32;
}

export fn Compilerˉnativeˉx64ˉsha256ˉhelper() -> bytes {
    return Compilerˉnativeˉx64ˉsha256ˉhelperˉtemplate;
}

export fn Compilerˉnativeˉx64ˉsha256ˉhelperˉisˉexact(Input: bytes) -> bool {
    if Bytesˉlength(Input) != 1640u32 { return false; }
    var Index: u32 = 0u32;
    while Index < 1640u32 {
        if Bytesˉreadˉu8(Input, Index) !=
            Bytesˉreadˉu8(Compilerˉnativeˉx64ˉsha256ˉhelperˉtemplate, Index) {
            return false;
        }
        Index = Index + 1u32;
    }
    return true;
}
