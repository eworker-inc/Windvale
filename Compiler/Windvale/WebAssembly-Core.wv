                    Second, Third
                )
            );
            Result = Bytesˉconcat(
                Result,
                Compilerˉwebassemblyˉindexedˉinstruction(32u32, Third)
            );
            Result = Bytesˉconcat(
                Result,
                Compilerˉwebassemblyˉindexedˉinstruction(32u32, First)
            );
            Result = Bytesˉconcat(
                Result,
                Compilerˉwebassemblyˉruntimeˉmemoryˉinstruction(
                    Storeˉopcode, Buildˉalignment
                )
            );
            Result = Bytesˉconcat(
                Result,
                Compilerˉwebassemblyˉruntimeˉpackˉdescriptor(Third, Second)
