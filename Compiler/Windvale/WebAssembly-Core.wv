    Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉbyte(64u32));
    Result = Bytesˉconcat(Result, Trueˉinstructions);
    return Bytesˉconcat(Result, Compilerˉwebassemblyˉbyte(11u32));
}

export fn Compilerˉwebassemblyˉutf8ˉleading() -> bytes {
    let Empty: bytes = Compilerˉwebassemblyˉempty(
        Compilerˉwebassemblyˉbyte(0u32)
    );
    let Invalid: bytes = Compilerˉwebassemblyˉutf8ˉinvalid();
    let Fourˉmaximum: bytes = Compilerˉwebassemblyˉifˉelseˉinstructions(
        Compilerˉwebassemblyˉutf8ˉrange(244u32, 244u32),
        Compilerˉwebassemblyˉutf8ˉstate(3u32, 128u32, 143u32),
        Invalid
    );
    let Fourˉordinary: bytes = Compilerˉwebassemblyˉifˉelseˉinstructions(
        Compilerˉwebassemblyˉutf8ˉrange(241u32, 243u32),
        Compilerˉwebassemblyˉutf8ˉstate(3u32, 128u32, 191u32),
        Fourˉmaximum
    );
    let Fourˉminimum: bytes = Compilerˉwebassemblyˉifˉelseˉinstructions(
        Compilerˉwebassemblyˉutf8ˉrange(240u32, 240u32),
        Compilerˉwebassemblyˉutf8ˉstate(3u32, 144u32, 191u32),
        Fourˉordinary
    );
    let Threeˉsurrogate: bytes = Compilerˉwebassemblyˉifˉelseˉinstructions(
        Compilerˉwebassemblyˉutf8ˉrange(237u32, 237u32),
        Compilerˉwebassemblyˉutf8ˉstate(2u32, 128u32, 159u32),
        Fourˉminimum
    );
    let Threeˉordinary: bytes = Compilerˉwebassemblyˉifˉelseˉinstructions(
        Compilerˉwebassemblyˉutf8ˉtwoˉranges(
            225u32,
            236u32,
            238u32,
            239u32
        ),
        Compilerˉwebassemblyˉutf8ˉstate(2u32, 128u32, 191u32),
        Threeˉsurrogate
    );
    let Threeˉminimum: bytes = Compilerˉwebassemblyˉifˉelseˉinstructions(
        Compilerˉwebassemblyˉutf8ˉrange(224u32, 224u32),
        Compilerˉwebassemblyˉutf8ˉstate(2u32, 160u32, 191u32),
        Threeˉordinary
    );
    let Twoˉbyte: bytes = Compilerˉwebassemblyˉifˉelseˉinstructions(
        Compilerˉwebassemblyˉutf8ˉrange(194u32, 223u32),
        Compilerˉwebassemblyˉutf8ˉstate(1u32, 128u32, 191u32),
        Threeˉminimum
    );
    return Compilerˉwebassemblyˉifˉelseˉinstructions(
        Compilerˉwebassemblyˉutf8ˉrange(0u32, 127u32),
        Empty,
        Twoˉbyte
    );
}

export fn Compilerˉwebassemblyˉutf8ˉcontinuation() -> bytes {
    var Below: bytes = Compilerˉwebassemblyˉindexedˉinstruction(32u32, 6u32);
    Below = Bytesˉconcat(
        Below,
        Compilerˉwebassemblyˉindexedˉinstruction(32u32, 4u32)
    );
    Below = Bytesˉconcat(Below, Compilerˉwebassemblyˉbyte(73u32));
    var Result: bytes = Compilerˉwebassemblyˉifˉinstructions(
        Below,
        Compilerˉwebassemblyˉutf8ˉinvalid()
    );

    var Above: bytes = Compilerˉwebassemblyˉindexedˉinstruction(32u32, 6u32);
    Above = Bytesˉconcat(
        Above,
        Compilerˉwebassemblyˉindexedˉinstruction(32u32, 5u32)
    );
    Above = Bytesˉconcat(Above, Compilerˉwebassemblyˉbyte(75u32));
    Result = Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉifˉinstructions(
            Above,
            Compilerˉwebassemblyˉutf8ˉinvalid()
        )
    );
    Result = Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉindexedˉinstruction(32u32, 3u32)
    );
    Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉi32ˉconstant(1));
    Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉbyte(107u32));
    Result = Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉindexedˉinstruction(33u32, 3u32)
    );
    return Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉutf8ˉordinaryˉcontinuation()
    );
}

export fn Compilerˉwebassemblyˉencodeˉutf8ˉvalidator() -> bytes {
    var Body: bytes = Compilerˉwebassemblyˉuleb32(1u32);
    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉuleb32(5u32));
    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(127u32));
    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(2u32));
    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(64u32));
    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(3u32));
    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(64u32));
    Body = Bytesˉconcat(
        Body,
        Compilerˉwebassemblyˉindexedˉinstruction(32u32, 2u32)
    );
    Body = Bytesˉconcat(
        Body,
        Compilerˉwebassemblyˉindexedˉinstruction(32u32, 1u32)
    );
    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(79u32));
    Body = Bytesˉconcat(
        Body,
        Compilerˉwebassemblyˉindexedˉinstruction(13u32, 1u32)
    );
    Body = Bytesˉconcat(
        Body,
        Compilerˉwebassemblyˉindexedˉinstruction(32u32, 0u32)
    );
    Body = Bytesˉconcat(
        Body,
        Compilerˉwebassemblyˉindexedˉinstruction(32u32, 2u32)
    );
    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(106u32));
    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(45u32));
    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉuleb32(0u32));
    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉuleb32(0u32));
    Body = Bytesˉconcat(
        Body,
        Compilerˉwebassemblyˉindexedˉinstruction(33u32, 6u32)
    );

    var Needˉisˉzero: bytes = Compilerˉwebassemblyˉindexedˉinstruction(
        32u32,
        3u32
    );
    Needˉisˉzero = Bytesˉconcat(
        Needˉisˉzero,
        Compilerˉwebassemblyˉbyte(69u32)
    );
    Body = Bytesˉconcat(
        Body,
        Compilerˉwebassemblyˉifˉelseˉinstructions(
            Needˉisˉzero,
            Compilerˉwebassemblyˉutf8ˉleading(),
            Compilerˉwebassemblyˉutf8ˉcontinuation()
        )
    );
    Body = Bytesˉconcat(
        Body,
        Compilerˉwebassemblyˉindexedˉinstruction(32u32, 2u32)
    );
    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉi32ˉconstant(1));
    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(106u32));
    Body = Bytesˉconcat(
        Body,
        Compilerˉwebassemblyˉindexedˉinstruction(33u32, 2u32)
    );
    Body = Bytesˉconcat(
        Body,
        Compilerˉwebassemblyˉindexedˉinstruction(12u32, 0u32)
    );
    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(11u32));
    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(11u32));
    Body = Bytesˉconcat(
        Body,
        Compilerˉwebassemblyˉindexedˉinstruction(32u32, 3u32)
    );
    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(69u32));
    return Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(11u32));
}

export fn Compilerˉwebassemblyˉmemoryˉmeter() -> bytes {
    var Result: bytes = Compilerˉwebassemblyˉindexedˉinstruction(35u32, 7u32);
    Result = Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉindexedˉinstruction(32u32, 0u32)
    );
    Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉbyte(79u32));
    Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉbyte(4u32));
    Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉbyte(64u32));
    Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉi32ˉconstant(3011));
    Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉbyte(15u32));
    Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉbyte(11u32));
    Result = Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉindexedˉinstruction(35u32, 7u32)
    );
    Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉi32ˉconstant(1));
    Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉbyte(106u32));
    return Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉindexedˉinstruction(36u32, 7u32)
    );
}

export fn Compilerˉwebassemblyˉencodeˉmemoryˉwrapper(Kind: u32) -> bytes {
    var Body: bytes = Compilerˉwebassemblyˉuleb32(0u32);
    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉi32ˉconstant(0));
    Body = Bytesˉconcat(
        Body,
        Compilerˉwebassemblyˉindexedˉinstruction(36u32, 5u32)
    );
    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉi32ˉconstant(0));
    Body = Bytesˉconcat(
        Body,
        Compilerˉwebassemblyˉindexedˉinstruction(36u32, 7u32)
    );

    var Oversized: bytes = Compilerˉwebassemblyˉindexedˉinstruction(32u32, 1u32);
    Oversized = Bytesˉconcat(
        Oversized,
        Compilerˉwebassemblyˉpositiveˉi32ˉconstant(4194304u32)
    );
    Oversized = Bytesˉconcat(Oversized, Compilerˉwebassemblyˉbyte(75u32));
    Body = Bytesˉconcat(
        Body,
        Compilerˉwebassemblyˉifˉinstructions(
            Oversized,
            Bytesˉconcat(
                Compilerˉwebassemblyˉi32ˉconstant(3008),
                Compilerˉwebassemblyˉbyte(15u32)
            )
        )
    );
    if Kind == 2u32 {
        var Validate: bytes = Compilerˉwebassemblyˉpositiveˉi32ˉconstant(65536u32);
        Validate = Bytesˉconcat(
            Validate,
            Compilerˉwebassemblyˉindexedˉinstruction(32u32, 1u32)
        );
        Validate = Bytesˉconcat(
            Validate,
            Compilerˉwebassemblyˉindexedˉinstruction(16u32, 1u32)
        );
        Validate = Bytesˉconcat(Validate, Compilerˉwebassemblyˉbyte(69u32));
        Body = Bytesˉconcat(
            Body,
            Compilerˉwebassemblyˉifˉinstructions(
                Validate,
                Bytesˉconcat(
                    Compilerˉwebassemblyˉi32ˉconstant(3014),
                    Compilerˉwebassemblyˉbyte(15u32)
                )
            )
        );
    }
    var Instruction: u32 = 0u32;
    while Instruction < 4u32 {
        Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉmemoryˉmeter());
        Instruction = Instruction + 1u32;
    }
    Body = Bytesˉconcat(
        Body,
        Compilerˉwebassemblyˉpositiveˉi32ˉconstant(4259840u32)
    );
    Body = Bytesˉconcat(
        Body,
        Compilerˉwebassemblyˉpositiveˉi32ˉconstant(65536u32)
    );
    Body = Bytesˉconcat(
        Body,
        Compilerˉwebassemblyˉindexedˉinstruction(32u32, 1u32)
    );
    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(252u32));
    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉuleb32(10u32));
    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉuleb32(0u32));
    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉuleb32(0u32));
    Body = Bytesˉconcat(
        Body,
        Compilerˉwebassemblyˉindexedˉinstruction(32u32, 1u32)
    );
    Body = Bytesˉconcat(
        Body,
        Compilerˉwebassemblyˉindexedˉinstruction(36u32, 5u32)
    );
    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉi32ˉconstant(0));
    return Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(11u32));
}

export fn Compilerˉwebassemblyˉencodeˉmemory(Kind: u32) -> bytes {
    var Typeˉpayload: bytes = Compilerˉwebassemblyˉuleb32(1u32);
    Typeˉpayload = Bytesˉconcat(Typeˉpayload, Compilerˉwebassemblyˉbyte(96u32));
    Typeˉpayload = Bytesˉconcat(Typeˉpayload, Compilerˉwebassemblyˉuleb32(2u32));
    Typeˉpayload = Bytesˉconcat(Typeˉpayload, Compilerˉwebassemblyˉbyte(127u32));
    Typeˉpayload = Bytesˉconcat(Typeˉpayload, Compilerˉwebassemblyˉbyte(127u32));
    Typeˉpayload = Bytesˉconcat(Typeˉpayload, Compilerˉwebassemblyˉuleb32(1u32));
    Typeˉpayload = Bytesˉconcat(Typeˉpayload, Compilerˉwebassemblyˉbyte(127u32));

    var Functionˉcount: u32 = 1u32;
    if Kind == 2u32 { Functionˉcount = 2u32; }
    var Functionˉpayload: bytes = Compilerˉwebassemblyˉuleb32(Functionˉcount);
    var Functionˉindex: u32 = 0u32;
    while Functionˉindex < Functionˉcount {
        Functionˉpayload = Bytesˉconcat(
            Functionˉpayload,
            Compilerˉwebassemblyˉuleb32(0u32)
        );
        Functionˉindex = Functionˉindex + 1u32;
    }

    var Memoryˉpayload: bytes = Compilerˉwebassemblyˉuleb32(1u32);
    Memoryˉpayload = Bytesˉconcat(
        Memoryˉpayload,
        Compilerˉwebassemblyˉuleb32(1u32)
    );
    Memoryˉpayload = Bytesˉconcat(
        Memoryˉpayload,
        Compilerˉwebassemblyˉuleb32(129u32)
    );
    Memoryˉpayload = Bytesˉconcat(
        Memoryˉpayload,
        Compilerˉwebassemblyˉuleb32(129u32)
    );

    var Globalˉpayload: bytes = Compilerˉwebassemblyˉuleb32(8u32);
    Globalˉpayload = Bytesˉconcat(
        Globalˉpayload,
        Compilerˉwebassemblyˉglobalˉi32(0u32, 3)
    );
    Globalˉpayload = Bytesˉconcat(
        Globalˉpayload,
        Compilerˉwebassemblyˉglobalˉi32(0u32, 65536)
    );
    Globalˉpayload = Bytesˉconcat(
        Globalˉpayload,
        Compilerˉwebassemblyˉglobalˉi32(0u32, 4194304)
    );
    Globalˉpayload = Bytesˉconcat(
        Globalˉpayload,
        Compilerˉwebassemblyˉglobalˉi32(0u32, 4259840)
    );
    Globalˉpayload = Bytesˉconcat(
        Globalˉpayload,
        Compilerˉwebassemblyˉglobalˉi32(0u32, 4194304)
    );
    Globalˉpayload = Bytesˉconcat(
        Globalˉpayload,
        Compilerˉwebassemblyˉglobalˉi32(1u32, 0)
    );
    var Outputˉkind: i32 = 1;
    if Kind == 2u32 { Outputˉkind = 2; }
    Globalˉpayload = Bytesˉconcat(
        Globalˉpayload,
        Compilerˉwebassemblyˉglobalˉi32(0u32, Outputˉkind)
    );
    Globalˉpayload = Bytesˉconcat(
        Globalˉpayload,
        Compilerˉwebassemblyˉglobalˉi32(1u32, 0)
    );

    var Exportˉpayload: bytes = Compilerˉwebassemblyˉuleb32(10u32);
    Exportˉpayload = Bytesˉconcat(Exportˉpayload, Compilerˉwebassemblyˉexportˉentry(Textˉtoˉutf8("Windvale.run"), 0u32, 0u32));
    Exportˉpayload = Bytesˉconcat(Exportˉpayload, Compilerˉwebassemblyˉexportˉentry(Textˉtoˉutf8("Windvale.abi"), 3u32, 0u32));
    Exportˉpayload = Bytesˉconcat(Exportˉpayload, Compilerˉwebassemblyˉexportˉentry(Textˉtoˉutf8("Windvale.memory"), 2u32, 0u32));
    Exportˉpayload = Bytesˉconcat(Exportˉpayload, Compilerˉwebassemblyˉexportˉentry(Textˉtoˉutf8("Windvale.input_offset"), 3u32, 1u32));
    Exportˉpayload = Bytesˉconcat(Exportˉpayload, Compilerˉwebassemblyˉexportˉentry(Textˉtoˉutf8("Windvale.input_capacity"), 3u32, 2u32));
    Exportˉpayload = Bytesˉconcat(Exportˉpayload, Compilerˉwebassemblyˉexportˉentry(Textˉtoˉutf8("Windvale.output_offset"), 3u32, 3u32));
    Exportˉpayload = Bytesˉconcat(Exportˉpayload, Compilerˉwebassemblyˉexportˉentry(Textˉtoˉutf8("Windvale.output_capacity"), 3u32, 4u32));
    Exportˉpayload = Bytesˉconcat(Exportˉpayload, Compilerˉwebassemblyˉexportˉentry(Textˉtoˉutf8("Windvale.output_length"), 3u32, 5u32));
    Exportˉpayload = Bytesˉconcat(Exportˉpayload, Compilerˉwebassemblyˉexportˉentry(Textˉtoˉutf8("Windvale.output_kind"), 3u32, 6u32));
    Exportˉpayload = Bytesˉconcat(Exportˉpayload, Compilerˉwebassemblyˉexportˉentry(Textˉtoˉutf8("Windvale.instructions"), 3u32, 7u32));

    let Wrapper: bytes = Compilerˉwebassemblyˉencodeˉmemoryˉwrapper(Kind);
    var Codeˉpayload: bytes = Compilerˉwebassemblyˉuleb32(Functionˉcount);
    Codeˉpayload = Bytesˉconcat(
        Codeˉpayload,
        Compilerˉwebassemblyˉuleb32(Bytesˉlength(Wrapper))
    );
    Codeˉpayload = Bytesˉconcat(Codeˉpayload, Wrapper);
    if Kind == 2u32 {
        let Validator: bytes = Compilerˉwebassemblyˉencodeˉutf8ˉvalidator();
        Codeˉpayload = Bytesˉconcat(
            Codeˉpayload,
            Compilerˉwebassemblyˉuleb32(Bytesˉlength(Validator))
        );
        Codeˉpayload = Bytesˉconcat(Codeˉpayload, Validator);
    }

    var Result: bytes = Compilerˉwebassemblyˉbyte(0u32);
    Result = Bytesˉconcat(Result, Textˉtoˉutf8("asm"));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(1u32));
    Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉsectionˉbytes(1u32, Typeˉpayload));
    Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉsectionˉbytes(3u32, Functionˉpayload));
    Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉsectionˉbytes(5u32, Memoryˉpayload));
    Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉsectionˉbytes(6u32, Globalˉpayload));
    Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉsectionˉbytes(7u32, Exportˉpayload));
    return Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉsectionˉbytes(10u32, Codeˉpayload)
    );
}

export fn Compilerˉwebassemblyˉruntimeˉwasmˉtype(Type: u8) -> u32 {
    if Type == 3u8 { return 126u32; }
    if Type == 6u8 { return 126u32; }
    return 127u32;
}

export fn Compilerˉwebassemblyˉruntimeˉi64ˉconstant(Value: u32) -> bytes {
    return Bytesˉconcat(
        Compilerˉwebassemblyˉbyte(66u32),
        Compilerˉwebassemblyˉpositiveˉsleb32(Value)
    );
}

export fn Compilerˉwebassemblyˉruntimeˉreturnˉstatus(Status: i32) -> bytes {
    return Bytesˉconcat(
        Compilerˉwebassemblyˉi32ˉconstant(Status),
        Compilerˉwebassemblyˉbyte(15u32)
    );
}

export fn Compilerˉwebassemblyˉruntimeˉprivateˉreturnˉstatus(
    Status: i32
) -> bytes {
    var Result: bytes = Compilerˉwebassemblyˉi32ˉconstant(Status);
    Result = Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉindexedˉinstruction(36u32, 8u32)
    );
    Result = Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉruntimeˉi64ˉconstant(0u32)
    );
    return Bytesˉconcat(Result, Compilerˉwebassemblyˉbyte(15u32));
}

export fn Compilerˉwebassemblyˉruntimeˉdescriptorˉlength(
    Descriptor: u32
) -> bytes {
    var Result: bytes = Compilerˉwebassemblyˉindexedˉinstruction(
        32u32, Descriptor
    );
    Result = Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉruntimeˉi64ˉconstant(32u32)
    );
    Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉbyte(136u32));
    return Bytesˉconcat(Result, Compilerˉwebassemblyˉbyte(167u32));
}

export fn Compilerˉwebassemblyˉruntimeˉdescriptorˉpointer(
    Descriptor: u32
) -> bytes {
    return Bytesˉconcat(
        Compilerˉwebassemblyˉindexedˉinstruction(32u32, Descriptor),
        Compilerˉwebassemblyˉbyte(167u32)
    );
}

export fn Compilerˉwebassemblyˉruntimeˉpackˉdescriptor(
    Pointer: u32,
    Length: u32
) -> bytes {
    var Result: bytes = Compilerˉwebassemblyˉindexedˉinstruction(32u32, Pointer);
    Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉbyte(173u32));
    Result = Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉindexedˉinstruction(32u32, Length)
    );
    Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉbyte(173u32));
    Result = Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉruntimeˉi64ˉconstant(32u32)
    );
    Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉbyte(134u32));
    return Bytesˉconcat(Result, Compilerˉwebassemblyˉbyte(132u32));
}

export fn Compilerˉwebassemblyˉruntimeˉmemoryˉcopy() -> bytes {
    var Result: bytes = Compilerˉwebassemblyˉbyte(252u32);
    Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉuleb32(10u32));
    Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉuleb32(0u32));
    return Bytesˉconcat(Result, Compilerˉwebassemblyˉuleb32(0u32));
}

export fn Compilerˉwebassemblyˉruntimeˉmemoryˉfill() -> bytes {
    var Result: bytes = Compilerˉwebassemblyˉbyte(252u32);
    Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉuleb32(11u32));
    return Bytesˉconcat(Result, Compilerˉwebassemblyˉuleb32(0u32));
}

export fn Compilerˉwebassemblyˉruntimeˉmemoryˉinstruction(
    Opcode: u32,
    Alignment: u32
) -> bytes {
    var Result: bytes = Compilerˉwebassemblyˉbyte(Opcode);
    Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉuleb32(Alignment));
    return Bytesˉconcat(Result, Compilerˉwebassemblyˉuleb32(0u32));
}

export fn Compilerˉwebassemblyˉruntimeˉreclaimingˉbinary(
    Left: bytes,
    Right: bytes,
    Opcode: u32
) -> bytes {
    return Bytesˉconcat(
        Bytesˉconcat(Left, Right),
        Compilerˉwebassemblyˉbyte(Opcode)
    );
}

export fn Compilerˉwebassemblyˉruntimeˉreclaimingˉload(
    Address: bytes
) -> bytes {
    return Bytesˉconcat(
        Address,
        Compilerˉwebassemblyˉruntimeˉmemoryˉinstruction(40u32, 2u32)
    );
}

export fn Compilerˉwebassemblyˉruntimeˉreclaimingˉstore(
    Address: bytes,
    Value: bytes
) -> bytes {
    var Result: bytes = Bytesˉconcat(Address, Value);
    return Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉruntimeˉmemoryˉinstruction(54u32, 2u32)
    );
}

export fn Compilerˉwebassemblyˉruntimeˉreclaimingˉlocal(Index: u32) -> bytes {
    return Compilerˉwebassemblyˉindexedˉinstruction(32u32, Index);
}

export fn Compilerˉwebassemblyˉruntimeˉreclaimingˉlocalˉaddress(
    Index: u32,
    Offset: u32
) -> bytes {
    return Compilerˉwebassemblyˉruntimeˉreclaimingˉbinary(
        Compilerˉwebassemblyˉruntimeˉreclaimingˉlocal(Index),
        Compilerˉwebassemblyˉpositiveˉi32ˉconstant(Offset),
        106u32
    );
}

export fn Compilerˉwebassemblyˉruntimeˉreclaimingˉreturnˉzero() -> bytes {
    return Bytesˉconcat(
        Compilerˉwebassemblyˉi32ˉconstant(0),
        Compilerˉwebassemblyˉbyte(15u32)
    );
}

export fn Compilerˉwebassemblyˉruntimeˉreclaimingˉinitialize() -> bytes {
    var Result: bytes = Compilerˉwebassemblyˉpositiveˉi32ˉconstant(512u32);
    Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉi32ˉconstant(0));
    Result = Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉpositiveˉi32ˉconstant(49188u32)
    );
    Result = Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉruntimeˉmemoryˉfill()
    );
    Result = Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉruntimeˉreclaimingˉstore(
            Compilerˉwebassemblyˉpositiveˉi32ˉconstant(50000u32),
            Compilerˉwebassemblyˉpositiveˉi32ˉconstant(4259840u32)
        )
    );
    Result = Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉruntimeˉreclaimingˉstore(
            Compilerˉwebassemblyˉpositiveˉi32ˉconstant(4259840u32),
            Compilerˉwebassemblyˉi32ˉconstant(0)
        )
    );
    return Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉruntimeˉreclaimingˉstore(
            Compilerˉwebassemblyˉpositiveˉi32ˉconstant(4259844u32),
            Compilerˉwebassemblyˉpositiveˉi32ˉconstant(4194304u32)
        )
    );
}

export fn Compilerˉwebassemblyˉruntimeˉreclaimingˉallocateˉbody() -> bytes {
    let Length: u32 = 0u32;
    let Required: u32 = 1u32;
    let Cursor: u32 = 2u32;
    let Previous: u32 = 3u32;
    let Next: u32 = 4u32;
    let Available: u32 = 5u32;
    let Entry: u32 = 6u32;
    let Candidate: u32 = 7u32;
    let Remainder: u32 = 8u32;

    var Body: bytes = Compilerˉwebassemblyˉuleb32(1u32);
    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉuleb32(8u32));
    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(127u32));

    Body = Bytesˉconcat(
        Body,
        Compilerˉwebassemblyˉruntimeˉreclaimingˉbinary(
            Compilerˉwebassemblyˉruntimeˉreclaimingˉbinary(
                Compilerˉwebassemblyˉruntimeˉreclaimingˉlocal(Length),
                Compilerˉwebassemblyˉpositiveˉi32ˉconstant(7u32),
                106u32
            ),
            Compilerˉwebassemblyˉruntimeˉu32ˉconstant(4294967288u32),
            113u32
        )
    );
    Body = Bytesˉconcat(
        Body,
        Compilerˉwebassemblyˉindexedˉinstruction(33u32, Required)
    );
    Body = Bytesˉconcat(
        Body,
        Compilerˉwebassemblyˉpositiveˉi32ˉconstant(512u32)
    );
    Body = Bytesˉconcat(
        Body,
        Compilerˉwebassemblyˉindexedˉinstruction(33u32, Entry)
    );

    var Noˉmetadata: bytes =
        Compilerˉwebassemblyˉruntimeˉreclaimingˉreturnˉzero();
    var Metadataˉloop: bytes = Compilerˉwebassemblyˉifˉinstructions(
        Compilerˉwebassemblyˉruntimeˉreclaimingˉbinary(
            Compilerˉwebassemblyˉruntimeˉreclaimingˉlocal(Entry),
            Compilerˉwebassemblyˉpositiveˉi32ˉconstant(49700u32),
            79u32
        ),
        Noˉmetadata
    );
    Metadataˉloop = Bytesˉconcat(
        Metadataˉloop,
        Compilerˉwebassemblyˉruntimeˉreclaimingˉload(
            Compilerˉwebassemblyˉruntimeˉreclaimingˉlocal(Entry)
        )
    );
    Metadataˉloop = Bytesˉconcat(
        Metadataˉloop,
        Compilerˉwebassemblyˉbyte(69u32)
    );
    Metadataˉloop = Bytesˉconcat(
        Metadataˉloop,
        Compilerˉwebassemblyˉindexedˉinstruction(13u32, 1u32)
    );
    Metadataˉloop = Bytesˉconcat(
        Metadataˉloop,
        Compilerˉwebassemblyˉruntimeˉreclaimingˉbinary(
            Compilerˉwebassemblyˉruntimeˉreclaimingˉlocal(Entry),
            Compilerˉwebassemblyˉpositiveˉi32ˉconstant(12u32),
            106u32
        )
    );
    Metadataˉloop = Bytesˉconcat(
        Metadataˉloop,
        Compilerˉwebassemblyˉindexedˉinstruction(33u32, Entry)
    );
    Metadataˉloop = Bytesˉconcat(
        Metadataˉloop,
        Compilerˉwebassemblyˉindexedˉinstruction(12u32, 0u32)
    );
    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(2u32));
    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(64u32));
    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(3u32));
    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(64u32));
    Body = Bytesˉconcat(Body, Metadataˉloop);
    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(11u32));
    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(11u32));

    Body = Bytesˉconcat(
        Body,
        Compilerˉwebassemblyˉruntimeˉreclaimingˉload(
            Compilerˉwebassemblyˉpositiveˉi32ˉconstant(50000u32)
        )
    );
    Body = Bytesˉconcat(
        Body,
        Compilerˉwebassemblyˉindexedˉinstruction(33u32, Cursor)
    );
    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉi32ˉconstant(0));
    Body = Bytesˉconcat(
        Body,
        Compilerˉwebassemblyˉindexedˉinstruction(33u32, Previous)
    );

    var Allocation: bytes = Compilerˉwebassemblyˉruntimeˉreclaimingˉload(
        Compilerˉwebassemblyˉruntimeˉreclaimingˉlocal(Cursor)
    );
    Allocation = Bytesˉconcat(
        Allocation,
        Compilerˉwebassemblyˉindexedˉinstruction(33u32, Next)
    );
    Allocation = Bytesˉconcat(
        Allocation,
        Compilerˉwebassemblyˉruntimeˉreclaimingˉbinary(
            Compilerˉwebassemblyˉruntimeˉreclaimingˉlocal(Available),
            Compilerˉwebassemblyˉruntimeˉreclaimingˉlocal(Required),
            107u32
        )
    );
    Allocation = Bytesˉconcat(
        Allocation,
        Compilerˉwebassemblyˉindexedˉinstruction(33u32, Remainder)
    );

    var Split: bytes = Compilerˉwebassemblyˉruntimeˉreclaimingˉbinary(
        Compilerˉwebassemblyˉruntimeˉreclaimingˉlocal(Cursor),
        Compilerˉwebassemblyˉruntimeˉreclaimingˉlocal(Required),
        106u32
    );
    Split = Bytesˉconcat(
        Split,
        Compilerˉwebassemblyˉindexedˉinstruction(33u32, Candidate)
    );
    Split = Bytesˉconcat(
        Split,
        Compilerˉwebassemblyˉruntimeˉreclaimingˉstore(
            Compilerˉwebassemblyˉruntimeˉreclaimingˉlocal(Candidate),
            Compilerˉwebassemblyˉruntimeˉreclaimingˉlocal(Next)
        )
    );
    Split = Bytesˉconcat(
        Split,
        Compilerˉwebassemblyˉruntimeˉreclaimingˉstore(
            Compilerˉwebassemblyˉruntimeˉreclaimingˉlocalˉaddress(
                Candidate, 4u32
            ),
            Compilerˉwebassemblyˉruntimeˉreclaimingˉlocal(Remainder)
        )
    );

    var Useˉnext: bytes = Compilerˉwebassemblyˉifˉelseˉinstructions(
        Compilerˉwebassemblyˉindexedˉinstruction(32u32, Previous),
        Compilerˉwebassemblyˉruntimeˉreclaimingˉstore(
            Compilerˉwebassemblyˉruntimeˉreclaimingˉlocal(Previous),
            Compilerˉwebassemblyˉruntimeˉreclaimingˉlocal(Next)
        ),
        Compilerˉwebassemblyˉruntimeˉreclaimingˉstore(
            Compilerˉwebassemblyˉpositiveˉi32ˉconstant(50000u32),
            Compilerˉwebassemblyˉruntimeˉreclaimingˉlocal(Next)
        )
    );
    var Useˉcandidate: bytes = Compilerˉwebassemblyˉifˉelseˉinstructions(
        Compilerˉwebassemblyˉindexedˉinstruction(32u32, Previous),
        Compilerˉwebassemblyˉruntimeˉreclaimingˉstore(
            Compilerˉwebassemblyˉruntimeˉreclaimingˉlocal(Previous),
            Compilerˉwebassemblyˉruntimeˉreclaimingˉlocal(Candidate)
        ),
        Compilerˉwebassemblyˉruntimeˉreclaimingˉstore(
            Compilerˉwebassemblyˉpositiveˉi32ˉconstant(50000u32),
            Compilerˉwebassemblyˉruntimeˉreclaimingˉlocal(Candidate)
        )
    );
    Split = Bytesˉconcat(Split, Useˉcandidate);
    Allocation = Bytesˉconcat(
        Allocation,
        Compilerˉwebassemblyˉifˉelseˉinstructions(
            Compilerˉwebassemblyˉruntimeˉreclaimingˉlocal(Remainder),
            Split,
            Useˉnext
        )
    );
    Allocation = Bytesˉconcat(
        Allocation,
        Compilerˉwebassemblyˉruntimeˉreclaimingˉstore(
            Compilerˉwebassemblyˉruntimeˉreclaimingˉlocal(Entry),
            Compilerˉwebassemblyˉruntimeˉreclaimingˉlocal(Cursor)
        )
    );
    Allocation = Bytesˉconcat(
        Allocation,
        Compilerˉwebassemblyˉruntimeˉreclaimingˉstore(
            Compilerˉwebassemblyˉruntimeˉreclaimingˉlocalˉaddress(Entry, 4u32),
            Compilerˉwebassemblyˉruntimeˉreclaimingˉlocal(Length)
        )
    );
    Allocation = Bytesˉconcat(
        Allocation,
        Compilerˉwebassemblyˉruntimeˉreclaimingˉstore(
            Compilerˉwebassemblyˉruntimeˉreclaimingˉlocalˉaddress(Entry, 8u32),
            Compilerˉwebassemblyˉpositiveˉi32ˉconstant(1u32)
        )
    );
    Allocation = Bytesˉconcat(
        Allocation,
        Compilerˉwebassemblyˉruntimeˉreclaimingˉlocal(Cursor)
    );
    Allocation = Bytesˉconcat(Allocation, Compilerˉwebassemblyˉbyte(15u32));

    var Freeˉloop: bytes = Bytesˉconcat(
        Compilerˉwebassemblyˉifˉinstructions(
            Bytesˉconcat(
                Compilerˉwebassemblyˉindexedˉinstruction(32u32, Cursor),
                Compilerˉwebassemblyˉbyte(69u32)
            ),
            Compilerˉwebassemblyˉruntimeˉreclaimingˉreturnˉzero()
        ),
        Compilerˉwebassemblyˉruntimeˉreclaimingˉload(
            Compilerˉwebassemblyˉruntimeˉreclaimingˉlocalˉaddress(
                Cursor, 4u32
            )
        )
    );
    Freeˉloop = Bytesˉconcat(
        Freeˉloop,
        Compilerˉwebassemblyˉindexedˉinstruction(33u32, Available)
    );
    Freeˉloop = Bytesˉconcat(
        Freeˉloop,
        Compilerˉwebassemblyˉifˉinstructions(
            Compilerˉwebassemblyˉruntimeˉreclaimingˉbinary(
                Compilerˉwebassemblyˉruntimeˉreclaimingˉlocal(Available),
                Compilerˉwebassemblyˉruntimeˉreclaimingˉlocal(Required),
                79u32
            ),
            Allocation
        )
    );
    Freeˉloop = Bytesˉconcat(
        Freeˉloop,
        Compilerˉwebassemblyˉruntimeˉreclaimingˉlocal(Cursor)
    );
    Freeˉloop = Bytesˉconcat(
        Freeˉloop,
        Compilerˉwebassemblyˉindexedˉinstruction(33u32, Previous)
    );
    Freeˉloop = Bytesˉconcat(
        Freeˉloop,
        Compilerˉwebassemblyˉruntimeˉreclaimingˉload(
            Compilerˉwebassemblyˉruntimeˉreclaimingˉlocal(Cursor)
        )
    );
    Freeˉloop = Bytesˉconcat(
        Freeˉloop,
        Compilerˉwebassemblyˉindexedˉinstruction(33u32, Cursor)
    );
    Freeˉloop = Bytesˉconcat(
        Freeˉloop,
        Compilerˉwebassemblyˉindexedˉinstruction(12u32, 0u32)
    );
    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(2u32));
    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(64u32));
    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(3u32));
    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(64u32));
    Body = Bytesˉconcat(Body, Freeˉloop);
    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(11u32));
    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(11u32));
    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉi32ˉconstant(0));
    return Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(11u32));
}

export fn Compilerˉwebassemblyˉruntimeˉreclaimingˉreferenceˉbody() -> bytes {
    let Descriptor: u32 = 0u32;
    let Retain: u32 = 1u32;
    let Pointer: u32 = 2u32;
    let Entry: u32 = 3u32;
    let Base: u32 = 4u32;
    let Logical: u32 = 5u32;
    let References: u32 = 6u32;
    let Charged: u32 = 7u32;
    let Previous: u32 = 8u32;
    let Cursor: u32 = 9u32;
    let Next: u32 = 10u32;

    var Body: bytes = Compilerˉwebassemblyˉuleb32(1u32);
    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉuleb32(9u32));
    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(127u32));
    Body = Bytesˉconcat(
        Body,
        Compilerˉwebassemblyˉruntimeˉreclaimingˉlocal(Descriptor)
    );
    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(167u32));
    Body = Bytesˉconcat(
        Body,
        Compilerˉwebassemblyˉindexedˉinstruction(33u32, Pointer)
    );

    var Outside: bytes = Compilerˉwebassemblyˉruntimeˉreclaimingˉbinary(
        Compilerˉwebassemblyˉruntimeˉreclaimingˉlocal(Pointer),
        Compilerˉwebassemblyˉpositiveˉi32ˉconstant(4259840u32),
        73u32
    );
    Outside = Bytesˉconcat(
        Outside,
        Compilerˉwebassemblyˉruntimeˉreclaimingˉbinary(
            Compilerˉwebassemblyˉruntimeˉreclaimingˉlocal(Pointer),
            Compilerˉwebassemblyˉpositiveˉi32ˉconstant(8454144u32),
            79u32
        )
    );
    Outside = Bytesˉconcat(Outside, Compilerˉwebassemblyˉbyte(114u32));
    Body = Bytesˉconcat(
        Body,
        Compilerˉwebassemblyˉifˉinstructions(
            Outside,
            Compilerˉwebassemblyˉbyte(15u32)
        )
    );
    Body = Bytesˉconcat(
        Body,
        Compilerˉwebassemblyˉpositiveˉi32ˉconstant(512u32)
    );
    Body = Bytesˉconcat(
        Body,
        Compilerˉwebassemblyˉindexedˉinstruction(33u32, Entry)
    );

    var Release: bytes = Compilerˉwebassemblyˉruntimeˉreclaimingˉstore(
        Compilerˉwebassemblyˉruntimeˉreclaimingˉlocal(Entry),
        Compilerˉwebassemblyˉi32ˉconstant(0)
    );
    Release = Bytesˉconcat(
        Release,
        Compilerˉwebassemblyˉruntimeˉreclaimingˉbinary(
            Compilerˉwebassemblyˉruntimeˉreclaimingˉbinary(
                Compilerˉwebassemblyˉruntimeˉreclaimingˉlocal(Logical),
                Compilerˉwebassemblyˉpositiveˉi32ˉconstant(7u32),
                106u32
            ),
            Compilerˉwebassemblyˉruntimeˉu32ˉconstant(4294967288u32),
            113u32
        )
    );
    Release = Bytesˉconcat(
        Release,
        Compilerˉwebassemblyˉindexedˉinstruction(33u32, Charged)
    );
    Release = Bytesˉconcat(Release, Compilerˉwebassemblyˉi32ˉconstant(0));
    Release = Bytesˉconcat(
        Release,
        Compilerˉwebassemblyˉindexedˉinstruction(33u32, Previous)
    );
    Release = Bytesˉconcat(
        Release,
        Compilerˉwebassemblyˉruntimeˉreclaimingˉload(
            Compilerˉwebassemblyˉpositiveˉi32ˉconstant(50000u32)
        )
    );
    Release = Bytesˉconcat(
        Release,
        Compilerˉwebassemblyˉindexedˉinstruction(33u32, Cursor)
    );

    var Insertˉloop: bytes = Bytesˉconcat(
        Compilerˉwebassemblyˉruntimeˉreclaimingˉlocal(Cursor),
        Compilerˉwebassemblyˉbyte(69u32)
    );
    Insertˉloop = Bytesˉconcat(
        Insertˉloop,
        Compilerˉwebassemblyˉindexedˉinstruction(13u32, 1u32)
    );
    Insertˉloop = Bytesˉconcat(
        Insertˉloop,
        Compilerˉwebassemblyˉruntimeˉreclaimingˉbinary(
            Compilerˉwebassemblyˉruntimeˉreclaimingˉlocal(Cursor),
            Compilerˉwebassemblyˉruntimeˉreclaimingˉlocal(Base),
            79u32
        )
    );
    Insertˉloop = Bytesˉconcat(
        Insertˉloop,
        Compilerˉwebassemblyˉindexedˉinstruction(13u32, 1u32)
    );
    Insertˉloop = Bytesˉconcat(
        Insertˉloop,
        Compilerˉwebassemblyˉruntimeˉreclaimingˉlocal(Cursor)
    );
    Insertˉloop = Bytesˉconcat(
        Insertˉloop,
        Compilerˉwebassemblyˉindexedˉinstruction(33u32, Previous)
    );
    Insertˉloop = Bytesˉconcat(
        Insertˉloop,
        Compilerˉwebassemblyˉruntimeˉreclaimingˉload(
            Compilerˉwebassemblyˉruntimeˉreclaimingˉlocal(Cursor)
        )
    );
    Insertˉloop = Bytesˉconcat(
        Insertˉloop,
        Compilerˉwebassemblyˉindexedˉinstruction(33u32, Cursor)
    );
    Insertˉloop = Bytesˉconcat(
        Insertˉloop,
        Compilerˉwebassemblyˉindexedˉinstruction(12u32, 0u32)
    );
    Release = Bytesˉconcat(Release, Compilerˉwebassemblyˉbyte(2u32));
    Release = Bytesˉconcat(Release, Compilerˉwebassemblyˉbyte(64u32));
    Release = Bytesˉconcat(Release, Compilerˉwebassemblyˉbyte(3u32));
    Release = Bytesˉconcat(Release, Compilerˉwebassemblyˉbyte(64u32));
    Release = Bytesˉconcat(Release, Insertˉloop);
    Release = Bytesˉconcat(Release, Compilerˉwebassemblyˉbyte(11u32));
    Release = Bytesˉconcat(Release, Compilerˉwebassemblyˉbyte(11u32));
    Release = Bytesˉconcat(
        Release,
        Compilerˉwebassemblyˉruntimeˉreclaimingˉstore(
            Compilerˉwebassemblyˉruntimeˉreclaimingˉlocal(Base),
            Compilerˉwebassemblyˉruntimeˉreclaimingˉlocal(Cursor)
        )
    );
    Release = Bytesˉconcat(
        Release,
        Compilerˉwebassemblyˉruntimeˉreclaimingˉstore(
            Compilerˉwebassemblyˉruntimeˉreclaimingˉlocalˉaddress(Base, 4u32),
            Compilerˉwebassemblyˉruntimeˉreclaimingˉlocal(Charged)
        )
    );

    var Coalesceˉnextˉcondition: bytes =
        Compilerˉwebassemblyˉruntimeˉreclaimingˉbinary(
            Compilerˉwebassemblyˉruntimeˉreclaimingˉlocal(Cursor),
            Compilerˉwebassemblyˉi32ˉconstant(0),
            71u32
        );
    Coalesceˉnextˉcondition = Bytesˉconcat(
        Coalesceˉnextˉcondition,
        Compilerˉwebassemblyˉruntimeˉreclaimingˉbinary(
            Compilerˉwebassemblyˉruntimeˉreclaimingˉbinary(
                Compilerˉwebassemblyˉruntimeˉreclaimingˉlocal(Base),
                Compilerˉwebassemblyˉruntimeˉreclaimingˉlocal(Charged),
                106u32
            ),
            Compilerˉwebassemblyˉruntimeˉreclaimingˉlocal(Cursor),
            70u32
        )
    );
    Coalesceˉnextˉcondition = Bytesˉconcat(
        Coalesceˉnextˉcondition,
        Compilerˉwebassemblyˉbyte(113u32)
    );
    var Coalesceˉnext: bytes = Compilerˉwebassemblyˉruntimeˉreclaimingˉload(
        Compilerˉwebassemblyˉruntimeˉreclaimingˉlocal(Cursor)
    );
    Coalesceˉnext = Bytesˉconcat(
        Coalesceˉnext,
        Compilerˉwebassemblyˉindexedˉinstruction(33u32, Next)
    );
    Coalesceˉnext = Bytesˉconcat(
        Coalesceˉnext,
        Compilerˉwebassemblyˉruntimeˉreclaimingˉbinary(
            Compilerˉwebassemblyˉruntimeˉreclaimingˉlocal(Charged),
            Compilerˉwebassemblyˉruntimeˉreclaimingˉload(
                Compilerˉwebassemblyˉruntimeˉreclaimingˉlocalˉaddress(
                    Cursor, 4u32
                )
            ),
            106u32
        )
    );
    Coalesceˉnext = Bytesˉconcat(
        Coalesceˉnext,
        Compilerˉwebassemblyˉindexedˉinstruction(33u32, Charged)
    );
    Coalesceˉnext = Bytesˉconcat(
        Coalesceˉnext,
        Compilerˉwebassemblyˉruntimeˉreclaimingˉstore(
            Compilerˉwebassemblyˉruntimeˉreclaimingˉlocal(Base),
            Compilerˉwebassemblyˉruntimeˉreclaimingˉlocal(Next)
        )
    );
    Coalesceˉnext = Bytesˉconcat(
        Coalesceˉnext,
        Compilerˉwebassemblyˉruntimeˉreclaimingˉstore(
            Compilerˉwebassemblyˉruntimeˉreclaimingˉlocalˉaddress(Base, 4u32),
            Compilerˉwebassemblyˉruntimeˉreclaimingˉlocal(Charged)
        )
    );
    Release = Bytesˉconcat(
        Release,
        Compilerˉwebassemblyˉifˉinstructions(
            Coalesceˉnextˉcondition,
            Coalesceˉnext
        )
    );

    var Coalesceˉpreviousˉcondition: bytes =
        Compilerˉwebassemblyˉruntimeˉreclaimingˉbinary(
            Compilerˉwebassemblyˉruntimeˉreclaimingˉlocal(Previous),
            Compilerˉwebassemblyˉi32ˉconstant(0),
            71u32
        );
    Coalesceˉpreviousˉcondition = Bytesˉconcat(
        Coalesceˉpreviousˉcondition,
        Compilerˉwebassemblyˉruntimeˉreclaimingˉbinary(
            Compilerˉwebassemblyˉruntimeˉreclaimingˉbinary(
                Compilerˉwebassemblyˉruntimeˉreclaimingˉlocal(Previous),
                Compilerˉwebassemblyˉruntimeˉreclaimingˉload(
                    Compilerˉwebassemblyˉruntimeˉreclaimingˉlocalˉaddress(
                        Previous, 4u32
                    )
                ),
                106u32
            ),
            Compilerˉwebassemblyˉruntimeˉreclaimingˉlocal(Base),
            70u32
        )
    );
    Coalesceˉpreviousˉcondition = Bytesˉconcat(
        Coalesceˉpreviousˉcondition,
        Compilerˉwebassemblyˉbyte(113u32)
    );
    var Coalesceˉprevious: bytes =
        Compilerˉwebassemblyˉruntimeˉreclaimingˉstore(
            Compilerˉwebassemblyˉruntimeˉreclaimingˉlocal(Previous),
            Compilerˉwebassemblyˉruntimeˉreclaimingˉload(
                Compilerˉwebassemblyˉruntimeˉreclaimingˉlocal(Base)
            )
        );
    Coalesceˉprevious = Bytesˉconcat(
        Coalesceˉprevious,
        Compilerˉwebassemblyˉruntimeˉreclaimingˉstore(
            Compilerˉwebassemblyˉruntimeˉreclaimingˉlocalˉaddress(
                Previous, 4u32
            ),
            Compilerˉwebassemblyˉruntimeˉreclaimingˉbinary(
                Compilerˉwebassemblyˉruntimeˉreclaimingˉload(
                    Compilerˉwebassemblyˉruntimeˉreclaimingˉlocalˉaddress(
                        Previous, 4u32
                    )
                ),
                Compilerˉwebassemblyˉruntimeˉreclaimingˉload(
                    Compilerˉwebassemblyˉruntimeˉreclaimingˉlocalˉaddress(
                        Base, 4u32
                    )
                ),
                106u32
            )
        )
    );
    var Linkˉbase: bytes = Compilerˉwebassemblyˉifˉelseˉinstructions(
        Compilerˉwebassemblyˉruntimeˉreclaimingˉlocal(Previous),
        Compilerˉwebassemblyˉruntimeˉreclaimingˉstore(
            Compilerˉwebassemblyˉruntimeˉreclaimingˉlocal(Previous),
            Compilerˉwebassemblyˉruntimeˉreclaimingˉlocal(Base)
        ),
        Compilerˉwebassemblyˉruntimeˉreclaimingˉstore(
            Compilerˉwebassemblyˉpositiveˉi32ˉconstant(50000u32),
            Compilerˉwebassemblyˉruntimeˉreclaimingˉlocal(Base)
        )
    );
    Release = Bytesˉconcat(
        Release,
        Compilerˉwebassemblyˉifˉelseˉinstructions(
            Coalesceˉpreviousˉcondition,
            Coalesceˉprevious,
            Linkˉbase
        )
    );
    Release = Bytesˉconcat(Release, Compilerˉwebassemblyˉbyte(15u32));

    var Releaseˉorˉdecrement: bytes =
        Compilerˉwebassemblyˉruntimeˉreclaimingˉstore(
            Compilerˉwebassemblyˉruntimeˉreclaimingˉlocalˉaddress(Entry, 8u32),
            Compilerˉwebassemblyˉruntimeˉreclaimingˉbinary(
                Compilerˉwebassemblyˉruntimeˉreclaimingˉlocal(References),
                Compilerˉwebassemblyˉpositiveˉi32ˉconstant(1u32),
                107u32
            )
        );
    Releaseˉorˉdecrement = Bytesˉconcat(
        Releaseˉorˉdecrement,
        Compilerˉwebassemblyˉbyte(15u32)
    );
    Releaseˉorˉdecrement = Compilerˉwebassemblyˉifˉelseˉinstructions(
        Compilerˉwebassemblyˉruntimeˉreclaimingˉbinary(
            Compilerˉwebassemblyˉruntimeˉreclaimingˉlocal(References),
            Compilerˉwebassemblyˉpositiveˉi32ˉconstant(1u32),
            75u32
        ),
        Releaseˉorˉdecrement,
        Release
    );

    var Retainˉreference: bytes =
        Compilerˉwebassemblyˉruntimeˉreclaimingˉstore(
            Compilerˉwebassemblyˉruntimeˉreclaimingˉlocalˉaddress(Entry, 8u32),
            Compilerˉwebassemblyˉruntimeˉreclaimingˉbinary(
                Compilerˉwebassemblyˉruntimeˉreclaimingˉlocal(References),
                Compilerˉwebassemblyˉpositiveˉi32ˉconstant(1u32),
                106u32
            )
        );
    Retainˉreference = Bytesˉconcat(
        Retainˉreference,
        Compilerˉwebassemblyˉbyte(15u32)
    );
    var Found: bytes =
        Compilerˉwebassemblyˉruntimeˉreclaimingˉload(
            Compilerˉwebassemblyˉruntimeˉreclaimingˉlocalˉaddress(Entry, 8u32)
        );
    Found = Bytesˉconcat(
        Found,
        Compilerˉwebassemblyˉindexedˉinstruction(33u32, References)
    );
    Found = Bytesˉconcat(
        Found,
        Compilerˉwebassemblyˉifˉelseˉinstructions(
            Compilerˉwebassemblyˉruntimeˉreclaimingˉlocal(Retain),
            Retainˉreference,
            Releaseˉorˉdecrement
        )
    );

    var Occupied: bytes =
        Compilerˉwebassemblyˉruntimeˉreclaimingˉload(
            Compilerˉwebassemblyˉruntimeˉreclaimingˉlocalˉaddress(Entry, 4u32)
        );
    Occupied = Bytesˉconcat(
        Occupied,
        Compilerˉwebassemblyˉindexedˉinstruction(33u32, Logical)
    );
    var Contains: bytes = Compilerˉwebassemblyˉruntimeˉreclaimingˉbinary(
        Compilerˉwebassemblyˉruntimeˉreclaimingˉlocal(Pointer),
        Compilerˉwebassemblyˉruntimeˉreclaimingˉlocal(Base),
        79u32
    );
    Contains = Bytesˉconcat(
        Contains,
        Compilerˉwebassemblyˉruntimeˉreclaimingˉbinary(
            Compilerˉwebassemblyˉruntimeˉreclaimingˉlocal(Pointer),
            Compilerˉwebassemblyˉruntimeˉreclaimingˉbinary(
                Compilerˉwebassemblyˉruntimeˉreclaimingˉlocal(Base),
                Compilerˉwebassemblyˉruntimeˉreclaimingˉlocal(Logical),
                106u32
            ),
            73u32
        )
    );
    Contains = Bytesˉconcat(Contains, Compilerˉwebassemblyˉbyte(113u32));
    Occupied = Bytesˉconcat(
        Occupied,
        Compilerˉwebassemblyˉifˉinstructions(Contains, Found)
    );

    var Searchˉloop: bytes = Compilerˉwebassemblyˉifˉinstructions(
        Compilerˉwebassemblyˉruntimeˉreclaimingˉbinary(
            Compilerˉwebassemblyˉruntimeˉreclaimingˉlocal(Entry),
            Compilerˉwebassemblyˉpositiveˉi32ˉconstant(49700u32),
            79u32
        ),
        Compilerˉwebassemblyˉbyte(15u32)
    );
    Searchˉloop = Bytesˉconcat(
        Searchˉloop,
        Compilerˉwebassemblyˉruntimeˉreclaimingˉload(
            Compilerˉwebassemblyˉruntimeˉreclaimingˉlocal(Entry)
        )
    );
    Searchˉloop = Bytesˉconcat(
        Searchˉloop,
        Compilerˉwebassemblyˉindexedˉinstruction(34u32, Base)
    );
    Searchˉloop = Bytesˉconcat(
        Searchˉloop,
        Compilerˉwebassemblyˉifˉinstructions(
            Compilerˉwebassemblyˉruntimeˉreclaimingˉlocal(Base),
            Occupied
        )
    );
    Searchˉloop = Bytesˉconcat(
        Searchˉloop,
        Compilerˉwebassemblyˉruntimeˉreclaimingˉbinary(
            Compilerˉwebassemblyˉruntimeˉreclaimingˉlocal(Entry),
            Compilerˉwebassemblyˉpositiveˉi32ˉconstant(12u32),
            106u32
        )
    );
    Searchˉloop = Bytesˉconcat(
        Searchˉloop,
        Compilerˉwebassemblyˉindexedˉinstruction(33u32, Entry)
    );
    Searchˉloop = Bytesˉconcat(
        Searchˉloop,
        Compilerˉwebassemblyˉindexedˉinstruction(12u32, 0u32)
    );
    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(3u32));
    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(64u32));
    Body = Bytesˉconcat(Body, Searchˉloop);
    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(11u32));
    return Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(11u32));
}

export fn Compilerˉwebassemblyˉruntimeˉreclaimingˉallocate(
    Length: u32,
    Pointer: u32
) -> bytes {
    var Allocation: bytes = Compilerˉwebassemblyˉindexedˉinstruction(
        32u32, Length
    );
    Allocation = Bytesˉconcat(
        Allocation,
        Compilerˉwebassemblyˉindexedˉinstruction(16u32, 1u32)
    );
    Allocation = Bytesˉconcat(
        Allocation,
        Compilerˉwebassemblyˉindexedˉinstruction(34u32, Pointer)
    );
    Allocation = Bytesˉconcat(Allocation, Compilerˉwebassemblyˉbyte(69u32));
    return Bytesˉconcat(
        Allocation,
        Compilerˉwebassemblyˉruntimeˉfailureˉif(
            Compilerˉwebassemblyˉempty(Allocation),
            3018
        )
    );
}

export fn Compilerˉwebassemblyˉruntimeˉreclaimingˉreference(
    Descriptor: u32,
    Retain: bool
) -> bytes {
    var Result: bytes = Compilerˉwebassemblyˉindexedˉinstruction(
        32u32, Descriptor
    );
    if Retain {
        Result = Bytesˉconcat(
            Result,
            Compilerˉwebassemblyˉpositiveˉi32ˉconstant(1u32)
        );
    } else {
        Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉi32ˉconstant(0));
    }
    return Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉindexedˉinstruction(16u32, 2u32)
    );
}

export fn Compilerˉwebassemblyˉruntimeˉfailureˉif(
    Condition: bytes,
    Status: i32
) -> bytes {
    return Compilerˉwebassemblyˉifˉinstructions(
        Condition,
        Compilerˉwebassemblyˉruntimeˉreturnˉstatus(Status)
    );
}

export fn Compilerˉwebassemblyˉruntimeˉmeter(
    Privateˉfunction: bool
) -> bytes {
    if !Privateˉfunction {
        return Compilerˉwebassemblyˉmemoryˉmeter();
    }
    var Condition: bytes = Compilerˉwebassemblyˉindexedˉinstruction(35u32, 7u32);
    Condition = Bytesˉconcat(
        Condition,
        Compilerˉwebassemblyˉindexedˉinstruction(35u32, 10u32)
    );
    Condition = Bytesˉconcat(Condition, Compilerˉwebassemblyˉbyte(79u32));
    var Result: bytes = Compilerˉwebassemblyˉifˉinstructions(
        Condition,
        Compilerˉwebassemblyˉruntimeˉprivateˉreturnˉstatus(3011)
    );
    Result = Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉindexedˉinstruction(35u32, 7u32)
    );
    Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉi32ˉconstant(1));
    Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉbyte(106u32));
    return Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉindexedˉinstruction(36u32, 7u32)
    );
}

export fn Compilerˉwebassemblyˉruntimeˉfailureˉifˉfor(
    Condition: bytes,
    Status: i32,
    Privateˉfunction: bool
) -> bytes {
    if !Privateˉfunction {
        return Compilerˉwebassemblyˉruntimeˉfailureˉif(Condition, Status);
    }
    return Compilerˉwebassemblyˉifˉinstructions(
        Condition,
        Compilerˉwebassemblyˉruntimeˉprivateˉreturnˉstatus(Status)
    );
}

export fn Compilerˉwebassemblyˉruntimeˉreadˉrange(
    Descriptor: u32,
    Offset: u32,
    Width: u32,
    Sourceˉlength: u32,
    Sourceˉpointer: u32,
    Privateˉfunction: bool
) -> bytes {
    var Result: bytes = Compilerˉwebassemblyˉruntimeˉdescriptorˉlength(Descriptor);
    Result = Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉindexedˉinstruction(33u32, Sourceˉlength)
    );
    Result = Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉruntimeˉdescriptorˉpointer(Descriptor)
    );
    Result = Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉindexedˉinstruction(33u32, Sourceˉpointer)
    );
    var Offsetˉinvalid: bytes = Compilerˉwebassemblyˉindexedˉinstruction(
        32u32, Offset
    );
    Offsetˉinvalid = Bytesˉconcat(
        Offsetˉinvalid,
        Compilerˉwebassemblyˉindexedˉinstruction(32u32, Sourceˉlength)
    );
    Offsetˉinvalid = Bytesˉconcat(
        Offsetˉinvalid,
        Compilerˉwebassemblyˉbyte(75u32)
    );
    Result = Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉruntimeˉfailureˉifˉfor(
            Offsetˉinvalid, 3008, Privateˉfunction
        )
    );
    var Widthˉinvalid: bytes = Compilerˉwebassemblyˉindexedˉinstruction(
        32u32, Width
    );
    Widthˉinvalid = Bytesˉconcat(
        Widthˉinvalid,
        Compilerˉwebassemblyˉindexedˉinstruction(32u32, Sourceˉlength)
    );
    Widthˉinvalid = Bytesˉconcat(
        Widthˉinvalid,
        Compilerˉwebassemblyˉindexedˉinstruction(32u32, Offset)
    );
    Widthˉinvalid = Bytesˉconcat(Widthˉinvalid, Compilerˉwebassemblyˉbyte(107u32));
    Widthˉinvalid = Bytesˉconcat(Widthˉinvalid, Compilerˉwebassemblyˉbyte(75u32));
    Result = Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉruntimeˉfailureˉifˉfor(
            Widthˉinvalid, 3008, Privateˉfunction
        )
    );
    Result = Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉindexedˉinstruction(32u32, Sourceˉpointer)
    );
    Result = Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉindexedˉinstruction(32u32, Offset)
    );
    return Bytesˉconcat(Result, Compilerˉwebassemblyˉbyte(106u32));
}

export fn Compilerˉwebassemblyˉruntimeˉu32ˉconstant(Value: u32) -> bytes {
    return Bytesˉconcat(
        Compilerˉwebassemblyˉbyte(65u32),
        Compilerˉwebassemblyˉsleb32(Bytesˉfromˉu32ˉlittle(Value), 0u32)
    );
}

export fn Compilerˉwebassemblyˉruntimeˉsha256ˉbinary(
    Left: bytes,
    Right: bytes,
    Opcode: u32
) -> bytes {
    return Bytesˉconcat(
        Bytesˉconcat(Left, Right),
        Compilerˉwebassemblyˉbyte(Opcode)
    );
}

export fn Compilerˉwebassemblyˉruntimeˉsha256ˉload(Address: u32) -> bytes {
    return Bytesˉconcat(
        Compilerˉwebassemblyˉpositiveˉi32ˉconstant(Address),
        Compilerˉwebassemblyˉruntimeˉmemoryˉinstruction(40u32, 2u32)
    );
}

export fn Compilerˉwebassemblyˉruntimeˉsha256ˉloadˉdynamic(
    Address: bytes
) -> bytes {
    return Bytesˉconcat(
        Address,
        Compilerˉwebassemblyˉruntimeˉmemoryˉinstruction(40u32, 2u32)
    );
}

export fn Compilerˉwebassemblyˉruntimeˉsha256ˉstore(
    Address: u32,
    Value: bytes
) -> bytes {
    var Result: bytes = Compilerˉwebassemblyˉpositiveˉi32ˉconstant(Address);
    Result = Bytesˉconcat(Result, Value);
    return Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉruntimeˉmemoryˉinstruction(54u32, 2u32)
    );
}

export fn Compilerˉwebassemblyˉruntimeˉsha256ˉrotateˉright(
    Value: bytes,
    Count: u32
) -> bytes {
    return Compilerˉwebassemblyˉruntimeˉsha256ˉbinary(
        Value,
        Compilerˉwebassemblyˉpositiveˉi32ˉconstant(Count),
        120u32
    );
}

export fn Compilerˉwebassemblyˉruntimeˉsha256ˉshiftˉright(
    Value: bytes,
    Count: u32
) -> bytes {
    return Compilerˉwebassemblyˉruntimeˉsha256ˉbinary(
        Value,
        Compilerˉwebassemblyˉpositiveˉi32ˉconstant(Count),
        118u32
    );
}

export fn Compilerˉwebassemblyˉruntimeˉsha256ˉconstant(Index: u32) -> u32 {
    if Index == 0u32 { return 1116352408u32; }
    if Index == 1u32 { return 1899447441u32; }
    if Index == 2u32 { return 3049323471u32; }
    if Index == 3u32 { return 3921009573u32; }
    if Index == 4u32 { return 961987163u32; }
    if Index == 5u32 { return 1508970993u32; }
    if Index == 6u32 { return 2453635748u32; }
    if Index == 7u32 { return 2870763221u32; }
    if Index == 8u32 { return 3624381080u32; }
    if Index == 9u32 { return 310598401u32; }
    if Index == 10u32 { return 607225278u32; }
    if Index == 11u32 { return 1426881987u32; }
    if Index == 12u32 { return 1925078388u32; }
    if Index == 13u32 { return 2162078206u32; }
    if Index == 14u32 { return 2614888103u32; }
    if Index == 15u32 { return 3248222580u32; }
    if Index == 16u32 { return 3835390401u32; }
    if Index == 17u32 { return 4022224774u32; }
    if Index == 18u32 { return 264347078u32; }
    if Index == 19u32 { return 604807628u32; }
    if Index == 20u32 { return 770255983u32; }
    if Index == 21u32 { return 1249150122u32; }
    if Index == 22u32 { return 1555081692u32; }
    if Index == 23u32 { return 1996064986u32; }
    if Index == 24u32 { return 2554220882u32; }
    if Index == 25u32 { return 2821834349u32; }
    if Index == 26u32 { return 2952996808u32; }
    if Index == 27u32 { return 3210313671u32; }
    if Index == 28u32 { return 3336571891u32; }
    if Index == 29u32 { return 3584528711u32; }
    if Index == 30u32 { return 113926993u32; }
    if Index == 31u32 { return 338241895u32; }
    if Index == 32u32 { return 666307205u32; }
    if Index == 33u32 { return 773529912u32; }
    if Index == 34u32 { return 1294757372u32; }
    if Index == 35u32 { return 1396182291u32; }
    if Index == 36u32 { return 1695183700u32; }
    if Index == 37u32 { return 1986661051u32; }
    if Index == 38u32 { return 2177026350u32; }
    if Index == 39u32 { return 2456956037u32; }
    if Index == 40u32 { return 2730485921u32; }
    if Index == 41u32 { return 2820302411u32; }
    if Index == 42u32 { return 3259730800u32; }
    if Index == 43u32 { return 3345764771u32; }
    if Index == 44u32 { return 3516065817u32; }
    if Index == 45u32 { return 3600352804u32; }
    if Index == 46u32 { return 4094571909u32; }
    if Index == 47u32 { return 275423344u32; }
    if Index == 48u32 { return 430227734u32; }
    if Index == 49u32 { return 506948616u32; }
    if Index == 50u32 { return 659060556u32; }
    if Index == 51u32 { return 883997877u32; }
    if Index == 52u32 { return 958139571u32; }
    if Index == 53u32 { return 1322822218u32; }
    if Index == 54u32 { return 1537002063u32; }
    if Index == 55u32 { return 1747873779u32; }
    if Index == 56u32 { return 1955562222u32; }
    if Index == 57u32 { return 2024104815u32; }
    if Index == 58u32 { return 2227730452u32; }
    if Index == 59u32 { return 2361852424u32; }
    if Index == 60u32 { return 2428436474u32; }
    if Index == 61u32 { return 2756734187u32; }
    if Index == 62u32 { return 3204031479u32; }
    return 3329325298u32;
}

export fn Compilerˉwebassemblyˉruntimeˉsha256ˉround(Index: u32) -> bytes {
    let A: bytes = Compilerˉwebassemblyˉruntimeˉsha256ˉload(288u32);
    let B: bytes = Compilerˉwebassemblyˉruntimeˉsha256ˉload(292u32);
    let C: bytes = Compilerˉwebassemblyˉruntimeˉsha256ˉload(296u32);
    let D: bytes = Compilerˉwebassemblyˉruntimeˉsha256ˉload(300u32);
    let E: bytes = Compilerˉwebassemblyˉruntimeˉsha256ˉload(304u32);
    let F: bytes = Compilerˉwebassemblyˉruntimeˉsha256ˉload(308u32);
    let G: bytes = Compilerˉwebassemblyˉruntimeˉsha256ˉload(312u32);
    let H: bytes = Compilerˉwebassemblyˉruntimeˉsha256ˉload(316u32);
    let Bigˉsigmaˉone: bytes = Compilerˉwebassemblyˉruntimeˉsha256ˉbinary(
        Compilerˉwebassemblyˉruntimeˉsha256ˉbinary(
            Compilerˉwebassemblyˉruntimeˉsha256ˉrotateˉright(E, 6u32),
            Compilerˉwebassemblyˉruntimeˉsha256ˉrotateˉright(E, 11u32),
            115u32
        ),
        Compilerˉwebassemblyˉruntimeˉsha256ˉrotateˉright(E, 25u32),
        115u32
    );
    let Choice: bytes = Compilerˉwebassemblyˉruntimeˉsha256ˉbinary(
        Compilerˉwebassemblyˉruntimeˉsha256ˉbinary(E, F, 113u32),
        Compilerˉwebassemblyˉruntimeˉsha256ˉbinary(
            Compilerˉwebassemblyˉruntimeˉsha256ˉbinary(
                E,
                Compilerˉwebassemblyˉruntimeˉu32ˉconstant(4294967295u32),
                115u32
            ),
            G,
            113u32
        ),
        115u32
    );
    var Temporaryˉone: bytes = Compilerˉwebassemblyˉruntimeˉsha256ˉbinary(
        H, Bigˉsigmaˉone, 106u32
    );
    Temporaryˉone = Compilerˉwebassemblyˉruntimeˉsha256ˉbinary(
        Temporaryˉone, Choice, 106u32
    );
    Temporaryˉone = Compilerˉwebassemblyˉruntimeˉsha256ˉbinary(
        Temporaryˉone,
        Compilerˉwebassemblyˉruntimeˉu32ˉconstant(
            Compilerˉwebassemblyˉruntimeˉsha256ˉconstant(Index)
        ),
        106u32
    );
    Temporaryˉone = Compilerˉwebassemblyˉruntimeˉsha256ˉbinary(
        Temporaryˉone,
        Compilerˉwebassemblyˉruntimeˉsha256ˉload(Index * 4u32),
        106u32
    );

    let Bigˉsigmaˉzero: bytes = Compilerˉwebassemblyˉruntimeˉsha256ˉbinary(
        Compilerˉwebassemblyˉruntimeˉsha256ˉbinary(
            Compilerˉwebassemblyˉruntimeˉsha256ˉrotateˉright(A, 2u32),
            Compilerˉwebassemblyˉruntimeˉsha256ˉrotateˉright(A, 13u32),
            115u32
        ),
        Compilerˉwebassemblyˉruntimeˉsha256ˉrotateˉright(A, 22u32),
        115u32
    );
    let Majority: bytes = Compilerˉwebassemblyˉruntimeˉsha256ˉbinary(
        Compilerˉwebassemblyˉruntimeˉsha256ˉbinary(A, B, 113u32),
        Compilerˉwebassemblyˉruntimeˉsha256ˉbinary(
            Compilerˉwebassemblyˉruntimeˉsha256ˉbinary(A, C, 113u32),
            Compilerˉwebassemblyˉruntimeˉsha256ˉbinary(B, C, 113u32),
            115u32
        ),
        115u32
    );
    let Temporaryˉtwo: bytes = Compilerˉwebassemblyˉruntimeˉsha256ˉbinary(
        Bigˉsigmaˉzero, Majority, 106u32
    );

    var Result: bytes = Compilerˉwebassemblyˉruntimeˉsha256ˉstore(
        328u32, Temporaryˉone
    );
    Result = Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉruntimeˉsha256ˉstore(332u32, Temporaryˉtwo)
    );
    Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉruntimeˉsha256ˉstore(316u32, G));
    Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉruntimeˉsha256ˉstore(312u32, F));
    Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉruntimeˉsha256ˉstore(308u32, E));
    Result = Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉruntimeˉsha256ˉstore(
            304u32,
            Compilerˉwebassemblyˉruntimeˉsha256ˉbinary(
                D,
                Compilerˉwebassemblyˉruntimeˉsha256ˉload(328u32),
                106u32
            )
        )
    );
    Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉruntimeˉsha256ˉstore(300u32, C));
    Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉruntimeˉsha256ˉstore(296u32, B));
    Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉruntimeˉsha256ˉstore(292u32, A));
    return Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉruntimeˉsha256ˉstore(
            288u32,
            Compilerˉwebassemblyˉruntimeˉsha256ˉbinary(
                Compilerˉwebassemblyˉruntimeˉsha256ˉload(328u32),
                Compilerˉwebassemblyˉruntimeˉsha256ˉload(332u32),
                106u32
            )
        )
    );
}

export fn Compilerˉwebassemblyˉruntimeˉsha256ˉfill(
    Length: u32,
    Pointer: u32,
    Index: u32,
    Value: u32
) -> bytes {
    var Result: bytes = Compilerˉwebassemblyˉi32ˉconstant(0);
    Result = Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉindexedˉinstruction(33u32, Index)
    );
    Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉbyte(2u32));
    Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉbyte(64u32));
    Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉbyte(3u32));
    Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉbyte(64u32));
    var Complete: bytes = Compilerˉwebassemblyˉindexedˉinstruction(32u32, Index);
    Complete = Bytesˉconcat(
        Complete,
        Compilerˉwebassemblyˉpositiveˉi32ˉconstant(64u32)
    );
    Complete = Bytesˉconcat(Complete, Compilerˉwebassemblyˉbyte(79u32));
    Result = Bytesˉconcat(Result, Complete);
    Result = Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉindexedˉinstruction(13u32, 1u32)
    );
    Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉi32ˉconstant(0));
    Result = Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉindexedˉinstruction(33u32, Value)
    );

    let Absolute: bytes = Compilerˉwebassemblyˉruntimeˉsha256ˉbinary(
        Compilerˉwebassemblyˉruntimeˉsha256ˉload(324u32),
        Compilerˉwebassemblyˉindexedˉinstruction(32u32, Index),
        106u32
    );
    var Inˉsource: bytes = Bytesˉconcat(
        Absolute,
        Compilerˉwebassemblyˉindexedˉinstruction(32u32, Length)
    );
    Inˉsource = Bytesˉconcat(Inˉsource, Compilerˉwebassemblyˉbyte(73u32));
    var Loadˉsource: bytes = Compilerˉwebassemblyˉindexedˉinstruction(
        32u32, Pointer
    );
    Loadˉsource = Bytesˉconcat(Loadˉsource, Absolute);
    Loadˉsource = Bytesˉconcat(Loadˉsource, Compilerˉwebassemblyˉbyte(106u32));
    Loadˉsource = Bytesˉconcat(
        Loadˉsource,
        Compilerˉwebassemblyˉruntimeˉmemoryˉinstruction(45u32, 0u32)
    );
    Loadˉsource = Bytesˉconcat(
        Loadˉsource,
        Compilerˉwebassemblyˉindexedˉinstruction(33u32, Value)
    );
    Result = Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉifˉinstructions(Inˉsource, Loadˉsource)
    );

    var Isˉmarker: bytes = Bytesˉconcat(
        Absolute,
        Compilerˉwebassemblyˉindexedˉinstruction(32u32, Length)
    );
    Isˉmarker = Bytesˉconcat(Isˉmarker, Compilerˉwebassemblyˉbyte(70u32));
    var Setˉmarker: bytes = Compilerˉwebassemblyˉpositiveˉi32ˉconstant(128u32);
    Setˉmarker = Bytesˉconcat(
        Setˉmarker,
        Compilerˉwebassemblyˉindexedˉinstruction(33u32, Value)
    );
    Result = Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉifˉinstructions(Isˉmarker, Setˉmarker)
    );

    var Isˉlength: bytes = Absolute;
    Isˉlength = Bytesˉconcat(
        Isˉlength,
        Compilerˉwebassemblyˉruntimeˉsha256ˉload(320u32)
    );
    Isˉlength = Bytesˉconcat(
        Isˉlength,
        Compilerˉwebassemblyˉpositiveˉi32ˉconstant(4u32)
    );
    Isˉlength = Bytesˉconcat(Isˉlength, Compilerˉwebassemblyˉbyte(107u32));
    Isˉlength = Bytesˉconcat(Isˉlength, Compilerˉwebassemblyˉbyte(79u32));
    var Lengthˉbyte: bytes = Compilerˉwebassemblyˉindexedˉinstruction(
        32u32, Length
    );
    Lengthˉbyte = Bytesˉconcat(
        Lengthˉbyte,
        Compilerˉwebassemblyˉpositiveˉi32ˉconstant(3u32)
    );
    Lengthˉbyte = Bytesˉconcat(Lengthˉbyte, Compilerˉwebassemblyˉbyte(116u32));
    Lengthˉbyte = Bytesˉconcat(
        Lengthˉbyte,
        Compilerˉwebassemblyˉruntimeˉsha256ˉload(320u32)
    );
    Lengthˉbyte = Bytesˉconcat(
        Lengthˉbyte,
        Compilerˉwebassemblyˉpositiveˉi32ˉconstant(1u32)
    );
    Lengthˉbyte = Bytesˉconcat(Lengthˉbyte, Compilerˉwebassemblyˉbyte(107u32));
    Lengthˉbyte = Bytesˉconcat(Lengthˉbyte, Absolute);
    Lengthˉbyte = Bytesˉconcat(Lengthˉbyte, Compilerˉwebassemblyˉbyte(107u32));
    Lengthˉbyte = Bytesˉconcat(
        Lengthˉbyte,
        Compilerˉwebassemblyˉpositiveˉi32ˉconstant(3u32)
    );
    Lengthˉbyte = Bytesˉconcat(Lengthˉbyte, Compilerˉwebassemblyˉbyte(116u32));
    Lengthˉbyte = Bytesˉconcat(Lengthˉbyte, Compilerˉwebassemblyˉbyte(118u32));
    Lengthˉbyte = Bytesˉconcat(
        Lengthˉbyte,
        Compilerˉwebassemblyˉpositiveˉi32ˉconstant(255u32)
    );
    Lengthˉbyte = Bytesˉconcat(Lengthˉbyte, Compilerˉwebassemblyˉbyte(113u32));
    Lengthˉbyte = Bytesˉconcat(
        Lengthˉbyte,
        Compilerˉwebassemblyˉindexedˉinstruction(33u32, Value)
    );
    Result = Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉifˉinstructions(Isˉlength, Lengthˉbyte)
    );

    Result = Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉindexedˉinstruction(32u32, Index)
    );
    Result = Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉindexedˉinstruction(32u32, Value)
    );
    Result = Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉruntimeˉmemoryˉinstruction(58u32, 0u32)
    );
    Result = Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉindexedˉinstruction(32u32, Index)
    );
    Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉi32ˉconstant(1));
    Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉbyte(106u32));
    Result = Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉindexedˉinstruction(33u32, Index)
    );
    Result = Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉindexedˉinstruction(12u32, 0u32)
    );
    Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉbyte(11u32));
    return Bytesˉconcat(Result, Compilerˉwebassemblyˉbyte(11u32));
}

export fn Compilerˉwebassemblyˉruntimeˉsha256ˉschedule(
    Index: u32,
    Value: u32
) -> bytes {
    var Result: bytes = Compilerˉwebassemblyˉi32ˉconstant(0);
    Result = Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉindexedˉinstruction(33u32, Index)
    );
    Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉbyte(2u32));
    Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉbyte(64u32));
    Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉbyte(3u32));
    Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉbyte(64u32));
    var Swapsˉcomplete: bytes = Compilerˉwebassemblyˉindexedˉinstruction(
        32u32, Index
    );
    Swapsˉcomplete = Bytesˉconcat(
        Swapsˉcomplete,
        Compilerˉwebassemblyˉpositiveˉi32ˉconstant(64u32)
    );
    Swapsˉcomplete = Bytesˉconcat(
        Swapsˉcomplete,
        Compilerˉwebassemblyˉbyte(79u32)
    );
    Result = Bytesˉconcat(Result, Swapsˉcomplete);
    Result = Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉindexedˉinstruction(13u32, 1u32)
    );
    Result = Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉruntimeˉsha256ˉloadˉdynamic(
            Compilerˉwebassemblyˉindexedˉinstruction(32u32, Index)
        )
    );
    Result = Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉindexedˉinstruction(33u32, Value)
    );
    let Loaded: bytes = Compilerˉwebassemblyˉindexedˉinstruction(32u32, Value);
    var Swapped: bytes = Compilerˉwebassemblyˉruntimeˉsha256ˉbinary(
        Compilerˉwebassemblyˉruntimeˉsha256ˉbinary(
            Compilerˉwebassemblyˉruntimeˉsha256ˉbinary(
                Loaded,
                Compilerˉwebassemblyˉruntimeˉu32ˉconstant(255u32),
                113u32
            ),
            Compilerˉwebassemblyˉpositiveˉi32ˉconstant(24u32),
            116u32
        ),
        Compilerˉwebassemblyˉruntimeˉsha256ˉbinary(
            Compilerˉwebassemblyˉruntimeˉsha256ˉbinary(
                Loaded,
                Compilerˉwebassemblyˉruntimeˉu32ˉconstant(65280u32),
                113u32
            ),
            Compilerˉwebassemblyˉpositiveˉi32ˉconstant(8u32),
            116u32
        ),
        114u32
    );
    Swapped = Compilerˉwebassemblyˉruntimeˉsha256ˉbinary(
        Swapped,
        Compilerˉwebassemblyˉruntimeˉsha256ˉbinary(
            Compilerˉwebassemblyˉruntimeˉsha256ˉbinary(
                Loaded,
                Compilerˉwebassemblyˉruntimeˉu32ˉconstant(16711680u32),
                113u32
            ),
            Compilerˉwebassemblyˉpositiveˉi32ˉconstant(8u32),
            118u32
        ),
        114u32
    );
    Swapped = Compilerˉwebassemblyˉruntimeˉsha256ˉbinary(
        Swapped,
        Compilerˉwebassemblyˉruntimeˉsha256ˉbinary(
            Compilerˉwebassemblyˉruntimeˉsha256ˉbinary(
                Loaded,
                Compilerˉwebassemblyˉruntimeˉu32ˉconstant(4278190080u32),
                113u32
            ),
            Compilerˉwebassemblyˉpositiveˉi32ˉconstant(24u32),
            118u32
        ),
        114u32
    );
    Result = Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉindexedˉinstruction(32u32, Index)
    );
    Result = Bytesˉconcat(Result, Swapped);
    Result = Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉruntimeˉmemoryˉinstruction(54u32, 2u32)
    );
    Result = Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉindexedˉinstruction(32u32, Index)
    );
    Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉi32ˉconstant(4));
    Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉbyte(106u32));
    Result = Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉindexedˉinstruction(33u32, Index)
    );
    Result = Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉindexedˉinstruction(12u32, 0u32)
    );
    Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉbyte(11u32));
    Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉbyte(11u32));

    Result = Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉpositiveˉi32ˉconstant(64u32)
    );
    Result = Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉindexedˉinstruction(33u32, Index)
    );
    Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉbyte(2u32));
    Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉbyte(64u32));
    Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉbyte(3u32));
    Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉbyte(64u32));
    var Expansionˉcomplete: bytes = Compilerˉwebassemblyˉindexedˉinstruction(
        32u32, Index
    );
    Expansionˉcomplete = Bytesˉconcat(
        Expansionˉcomplete,
        Compilerˉwebassemblyˉpositiveˉi32ˉconstant(256u32)
    );
    Expansionˉcomplete = Bytesˉconcat(
        Expansionˉcomplete,
        Compilerˉwebassemblyˉbyte(79u32)
    );
    Result = Bytesˉconcat(Result, Expansionˉcomplete);
    Result = Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉindexedˉinstruction(13u32, 1u32)
    );
    let Wˉfifteen: bytes = Compilerˉwebassemblyˉruntimeˉsha256ˉloadˉdynamic(
        Compilerˉwebassemblyˉruntimeˉsha256ˉbinary(
            Compilerˉwebassemblyˉindexedˉinstruction(32u32, Index),
            Compilerˉwebassemblyˉpositiveˉi32ˉconstant(60u32),
            107u32
        )
    );
    let Smallˉzero: bytes = Compilerˉwebassemblyˉruntimeˉsha256ˉbinary(
        Compilerˉwebassemblyˉruntimeˉsha256ˉbinary(
            Compilerˉwebassemblyˉruntimeˉsha256ˉrotateˉright(Wˉfifteen, 7u32),
            Compilerˉwebassemblyˉruntimeˉsha256ˉrotateˉright(Wˉfifteen, 18u32),
            115u32
        ),
        Compilerˉwebassemblyˉruntimeˉsha256ˉshiftˉright(Wˉfifteen, 3u32),
        115u32
    );
    let Wˉtwo: bytes = Compilerˉwebassemblyˉruntimeˉsha256ˉloadˉdynamic(
        Compilerˉwebassemblyˉruntimeˉsha256ˉbinary(
            Compilerˉwebassemblyˉindexedˉinstruction(32u32, Index),
            Compilerˉwebassemblyˉpositiveˉi32ˉconstant(8u32),
            107u32
        )
    );
    let Smallˉone: bytes = Compilerˉwebassemblyˉruntimeˉsha256ˉbinary(
        Compilerˉwebassemblyˉruntimeˉsha256ˉbinary(
            Compilerˉwebassemblyˉruntimeˉsha256ˉrotateˉright(Wˉtwo, 17u32),
            Compilerˉwebassemblyˉruntimeˉsha256ˉrotateˉright(Wˉtwo, 19u32),
            115u32
        ),
        Compilerˉwebassemblyˉruntimeˉsha256ˉshiftˉright(Wˉtwo, 10u32),
        115u32
    );
    var Expanded: bytes = Compilerˉwebassemblyˉruntimeˉsha256ˉloadˉdynamic(
        Compilerˉwebassemblyˉruntimeˉsha256ˉbinary(
            Compilerˉwebassemblyˉindexedˉinstruction(32u32, Index),
            Compilerˉwebassemblyˉpositiveˉi32ˉconstant(64u32),
            107u32
        )
    );
    Expanded = Compilerˉwebassemblyˉruntimeˉsha256ˉbinary(
        Expanded, Smallˉzero, 106u32
    );
    Expanded = Compilerˉwebassemblyˉruntimeˉsha256ˉbinary(
        Expanded,
        Compilerˉwebassemblyˉruntimeˉsha256ˉloadˉdynamic(
            Compilerˉwebassemblyˉruntimeˉsha256ˉbinary(
                Compilerˉwebassemblyˉindexedˉinstruction(32u32, Index),
                Compilerˉwebassemblyˉpositiveˉi32ˉconstant(28u32),
                107u32
            )
        ),
        106u32
    );
    Expanded = Compilerˉwebassemblyˉruntimeˉsha256ˉbinary(
        Expanded, Smallˉone, 106u32
    );
    Result = Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉindexedˉinstruction(32u32, Index)
    );
    Result = Bytesˉconcat(Result, Expanded);
    Result = Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉruntimeˉmemoryˉinstruction(54u32, 2u32)
    );
    Result = Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉindexedˉinstruction(32u32, Index)
    );
    Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉi32ˉconstant(4));
    Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉbyte(106u32));
    Result = Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉindexedˉinstruction(33u32, Index)
    );
    Result = Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉindexedˉinstruction(12u32, 0u32)
    );
    Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉbyte(11u32));
    return Bytesˉconcat(Result, Compilerˉwebassemblyˉbyte(11u32));
}

export fn Compilerˉwebassemblyˉruntimeˉsha256ˉhexˉdigit(
    Value: bytes
) -> bytes {
    var Result: bytes = Value;
    Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉi32ˉconstant(48));
    Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉbyte(106u32));
    Result = Bytesˉconcat(Result, Value);
    Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉi32ˉconstant(87));
    Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉbyte(106u32));
    Result = Bytesˉconcat(Result, Value);
    Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉi32ˉconstant(10));
    Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉbyte(73u32));
    return Bytesˉconcat(Result, Compilerˉwebassemblyˉbyte(27u32));
}

export fn Compilerˉwebassemblyˉruntimeˉsha256ˉoutput(Arena: u32) -> bytes {
    var Result: bytes = Compilerˉwebassemblyˉempty(Bytesˉfromˉu8(0u8));
    var Stateˉindex: u32 = 0u32;
    var Outputˉindex: u32 = 0u32;
    while Stateˉindex < 8u32 {
        var Byteˉindex: u32 = 0u32;
        while Byteˉindex < 4u32 {
            let Shift: u32 = 24u32 - Byteˉindex * 8u32;
            let Byteˉvalue: bytes = Compilerˉwebassemblyˉruntimeˉsha256ˉbinary(
                Compilerˉwebassemblyˉruntimeˉsha256ˉshiftˉright(
                    Compilerˉwebassemblyˉruntimeˉsha256ˉload(
                        256u32 + Stateˉindex * 4u32
                    ),
                    Shift
                ),
                Compilerˉwebassemblyˉpositiveˉi32ˉconstant(255u32),
                113u32
            );
            let High: bytes = Compilerˉwebassemblyˉruntimeˉsha256ˉshiftˉright(
                Byteˉvalue, 4u32
            );
            let Low: bytes = Compilerˉwebassemblyˉruntimeˉsha256ˉbinary(
                Byteˉvalue,
                Compilerˉwebassemblyˉpositiveˉi32ˉconstant(15u32),
                113u32
            );
            Result = Bytesˉconcat(
                Result,
                Compilerˉwebassemblyˉindexedˉinstruction(32u32, Arena)
            );
            Result = Bytesˉconcat(
                Result,
                Compilerˉwebassemblyˉpositiveˉi32ˉconstant(Outputˉindex)
            );
            Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉbyte(106u32));
            Result = Bytesˉconcat(
                Result,
                Compilerˉwebassemblyˉruntimeˉsha256ˉhexˉdigit(High)
            );
            Result = Bytesˉconcat(
                Result,
                Compilerˉwebassemblyˉruntimeˉmemoryˉinstruction(58u32, 0u32)
            );
            Result = Bytesˉconcat(
                Result,
                Compilerˉwebassemblyˉindexedˉinstruction(32u32, Arena)
            );
            Result = Bytesˉconcat(
                Result,
                Compilerˉwebassemblyˉpositiveˉi32ˉconstant(Outputˉindex + 1u32)
            );
            Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉbyte(106u32));
            Result = Bytesˉconcat(
                Result,
                Compilerˉwebassemblyˉruntimeˉsha256ˉhexˉdigit(Low)
            );
            Result = Bytesˉconcat(
                Result,
                Compilerˉwebassemblyˉruntimeˉmemoryˉinstruction(58u32, 0u32)
            );
            Outputˉindex = Outputˉindex + 2u32;
            Byteˉindex = Byteˉindex + 1u32;
        }
        Stateˉindex = Stateˉindex + 1u32;
    }
    return Result;
}

export fn Compilerˉwebassemblyˉruntimeˉsha256(
    Arena: u32,
    Length: u32,
    Pointer: u32,
    Index: u32,
    Value: u32,
    Descriptorˉsource: u32,
    Descriptorˉresult: u32,
    Reclaiming: bool,
    Privateˉfunction: bool
) -> bytes {
    var Result: bytes = Compilerˉwebassemblyˉindexedˉinstruction(
        33u32, Descriptorˉsource
    );
    Result = Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉruntimeˉdescriptorˉlength(Descriptorˉsource)
    );
    Result = Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉindexedˉinstruction(33u32, Length)
    );
    Result = Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉruntimeˉdescriptorˉpointer(Descriptorˉsource)
    );
    Result = Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉindexedˉinstruction(33u32, Pointer)
    );
    if Reclaiming {
        Result = Bytesˉconcat(
            Result,
            Compilerˉwebassemblyˉpositiveˉi32ˉconstant(64u32)
        );
        Result = Bytesˉconcat(
            Result,
            Compilerˉwebassemblyˉindexedˉinstruction(33u32, Value)
        );
        Result = Bytesˉconcat(
            Result,
            Compilerˉwebassemblyˉruntimeˉreclaimingˉallocate(Value, Arena)
        );
    } else {
        var Exhausted: bytes =
            Compilerˉwebassemblyˉpositiveˉi32ˉconstant(64u32);
        Exhausted = Bytesˉconcat(
            Exhausted,
            Compilerˉwebassemblyˉpositiveˉi32ˉconstant(8454144u32)
        );
        Exhausted = Bytesˉconcat(
            Exhausted,
            Compilerˉwebassemblyˉindexedˉinstruction(32u32, Arena)
        );
        Exhausted = Bytesˉconcat(
            Exhausted,
            Compilerˉwebassemblyˉbyte(107u32)
        );
        Exhausted = Bytesˉconcat(
            Exhausted,
            Compilerˉwebassemblyˉbyte(75u32)
        );
        Result = Bytesˉconcat(
            Result,
            Compilerˉwebassemblyˉruntimeˉfailureˉifˉfor(
                Exhausted, 3018, Privateˉfunction
            )
        );
    }
    var Paddedˉlength: bytes = Compilerˉwebassemblyˉindexedˉinstruction(
        32u32, Length
    );
    Paddedˉlength = Bytesˉconcat(
        Paddedˉlength,
        Compilerˉwebassemblyˉpositiveˉi32ˉconstant(72u32)
    );
    Paddedˉlength = Bytesˉconcat(
        Paddedˉlength,
        Compilerˉwebassemblyˉbyte(106u32)
    );
    Paddedˉlength = Bytesˉconcat(
        Paddedˉlength,
        Compilerˉwebassemblyˉruntimeˉu32ˉconstant(4294967232u32)
    );
    Paddedˉlength = Bytesˉconcat(
        Paddedˉlength,
        Compilerˉwebassemblyˉbyte(113u32)
    );
    Result = Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉruntimeˉsha256ˉstore(320u32, Paddedˉlength)
    );
    Result = Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉruntimeˉsha256ˉstore(
            324u32,
            Compilerˉwebassemblyˉi32ˉconstant(0)
        )
    );
    var Stateˉindex: u32 = 0u32;
    while Stateˉindex < 8u32 {
        var Initial: u32 = 1779033703u32;
        if Stateˉindex == 1u32 { Initial = 3144134277u32; }
        if Stateˉindex == 2u32 { Initial = 1013904242u32; }
        if Stateˉindex == 3u32 { Initial = 2773480762u32; }
        if Stateˉindex == 4u32 { Initial = 1359893119u32; }
        if Stateˉindex == 5u32 { Initial = 2600822924u32; }
        if Stateˉindex == 6u32 { Initial = 528734635u32; }
        if Stateˉindex == 7u32 { Initial = 1541459225u32; }
        Result = Bytesˉconcat(
            Result,
            Compilerˉwebassemblyˉruntimeˉsha256ˉstore(
                256u32 + Stateˉindex * 4u32,
                Compilerˉwebassemblyˉruntimeˉu32ˉconstant(Initial)
            )
        );
        Stateˉindex = Stateˉindex + 1u32;
    }
    Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉbyte(2u32));
    Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉbyte(64u32));
    Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉbyte(3u32));
    Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉbyte(64u32));
    var Blocksˉcomplete: bytes = Compilerˉwebassemblyˉruntimeˉsha256ˉload(
        324u32
    );
    Blocksˉcomplete = Bytesˉconcat(
        Blocksˉcomplete,
        Compilerˉwebassemblyˉruntimeˉsha256ˉload(320u32)
    );
    Blocksˉcomplete = Bytesˉconcat(
        Blocksˉcomplete,
        Compilerˉwebassemblyˉbyte(79u32)
    );
    Result = Bytesˉconcat(Result, Blocksˉcomplete);
    Result = Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉindexedˉinstruction(13u32, 1u32)
    );
    Result = Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉruntimeˉsha256ˉfill(
            Length, Pointer, Index, Value
        )
    );
    Result = Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉruntimeˉsha256ˉschedule(Index, Value)
    );
    Stateˉindex = 0u32;
    while Stateˉindex < 8u32 {
        Result = Bytesˉconcat(
            Result,
            Compilerˉwebassemblyˉruntimeˉsha256ˉstore(
                288u32 + Stateˉindex * 4u32,
                Compilerˉwebassemblyˉruntimeˉsha256ˉload(
                    256u32 + Stateˉindex * 4u32
                )
            )
        );
        Stateˉindex = Stateˉindex + 1u32;
    }
    var Round: u32 = 0u32;
    while Round < 64u32 {
        Result = Bytesˉconcat(
            Result,
            Compilerˉwebassemblyˉruntimeˉsha256ˉround(Round)
        );
        Round = Round + 1u32;
    }
    Stateˉindex = 0u32;
    while Stateˉindex < 8u32 {
        Result = Bytesˉconcat(
            Result,
            Compilerˉwebassemblyˉruntimeˉsha256ˉstore(
                256u32 + Stateˉindex * 4u32,
                Compilerˉwebassemblyˉruntimeˉsha256ˉbinary(
                    Compilerˉwebassemblyˉruntimeˉsha256ˉload(
                        256u32 + Stateˉindex * 4u32
                    ),
                    Compilerˉwebassemblyˉruntimeˉsha256ˉload(
                        288u32 + Stateˉindex * 4u32
                    ),
                    106u32
                )
            )
        );
        Stateˉindex = Stateˉindex + 1u32;
    }
    Result = Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉruntimeˉsha256ˉstore(
            324u32,
            Compilerˉwebassemblyˉruntimeˉsha256ˉbinary(
                Compilerˉwebassemblyˉruntimeˉsha256ˉload(324u32),
                Compilerˉwebassemblyˉpositiveˉi32ˉconstant(64u32),
                106u32
            )
        )
    );
    Result = Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉindexedˉinstruction(12u32, 0u32)
    );
    Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉbyte(11u32));
    Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉbyte(11u32));
    Result = Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉruntimeˉsha256ˉoutput(Arena)
    );
    Result = Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉpositiveˉi32ˉconstant(64u32)
    );
    Result = Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉindexedˉinstruction(33u32, Value)
    );
    Result = Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉruntimeˉpackˉdescriptor(Arena, Value)
    );
    Result = Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉindexedˉinstruction(33u32, Descriptorˉresult)
    );
    if !Reclaiming {
        Result = Bytesˉconcat(
            Result,
            Compilerˉwebassemblyˉindexedˉinstruction(32u32, Arena)
        );
        Result = Bytesˉconcat(
            Result,
            Compilerˉwebassemblyˉpositiveˉi32ˉconstant(64u32)
        );
        Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉbyte(106u32));
        Result = Bytesˉconcat(
            Result,
            Compilerˉwebassemblyˉindexedˉinstruction(33u32, Arena)
        );
    }
    return Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉindexedˉinstruction(32u32, Descriptorˉresult)
    );
}

export fn Compilerˉwebassemblyˉencodeˉruntimeˉinstruction(
    Input: bytes,
    Offset: u32,
    Opcode: u8,
    Arena: u32,
    First: u32,
    Second: u32,
    Third: u32,
    Fourth: u32,
    Descriptorˉfirst: u32,
    Descriptorˉsecond: u32,
    Descriptorˉresult: u32,
    Localˉoffset: u32,
    Privateˉfunction: bool,
    Reclaiming: bool,
    Descriptorˉoperation: bool
) -> bytes {
    var Result: bytes = Compilerˉwebassemblyˉruntimeˉmeter(Privateˉfunction);
    var Isˉread: bool = false;
    if Opcode == 13u8 { Isˉread = true; }
    if Opcode == 14u8 { Isˉread = true; }
    if Opcode == 15u8 { Isˉread = true; }
    if Opcode == 114u8 { Isˉread = true; }
    var Isˉbuilder: bool = false;
    if Opcode == 120u8 { Isˉbuilder = true; }
    if Opcode == 121u8 { Isˉbuilder = true; }
    if Opcode == 122u8 { Isˉbuilder = true; }
    if Opcode == 123u8 { Isˉbuilder = true; }
    if Opcode == 1u8 {
        return Bytesˉconcat(
            Result,
            Compilerˉwebassemblyˉi32ˉconstantˉfromˉinput(Input, Offset + 1u32)
        );
    }
    if Opcode == 2u8 {
        return Bytesˉconcat(
            Result,
            Compilerˉwebassemblyˉpositiveˉi32ˉconstant(
                U32ˉfromˉu8(Bytesˉreadˉu8(Input, Offset + 1u32))
            )
        );
    }
    if Opcode == 8u8 {
        return Bytesˉconcat(
            Result,
            Compilerˉwebassemblyˉpositiveˉi32ˉconstant(
                U32ˉfromˉu8(Bytesˉreadˉu8(Input, Offset + 1u32))
            )
        );
    }
    if Opcode == 9u8 {
        return Bytesˉconcat(
            Result,
            Compilerˉwebassemblyˉi32ˉconstantˉfromˉinput(Input, Offset + 1u32)
        );
    }
    if Opcode == 4u8 {
        if Reclaiming {
            if Descriptorˉoperation {
                Result = Bytesˉconcat(
                    Result,
                    Compilerˉwebassemblyˉindexedˉinstruction(
                        32u32,
                        Bytesˉreadˉu32ˉlittle(Input, Offset + 1u32) +
                            Localˉoffset
                    )
                );
                Result = Bytesˉconcat(
                    Result,
                    Compilerˉwebassemblyˉindexedˉinstruction(
                        34u32, Descriptorˉresult
                    )
                );
                Result = Bytesˉconcat(
                    Result,
                    Compilerˉwebassemblyˉpositiveˉi32ˉconstant(1u32)
                );
                Result = Bytesˉconcat(
                    Result,
                    Compilerˉwebassemblyˉindexedˉinstruction(16u32, 2u32)
                );
                return Bytesˉconcat(
                    Result,
                    Compilerˉwebassemblyˉindexedˉinstruction(
                        32u32, Descriptorˉresult
                    )
                );
            }
        }
        return Bytesˉconcat(
            Result,
            Compilerˉwebassemblyˉindexedˉinstruction(
                32u32,
                Bytesˉreadˉu32ˉlittle(Input, Offset + 1u32) + Localˉoffset
            )
        );
    }
    if Opcode == 5u8 {
        if Reclaiming {
            if Descriptorˉoperation {
                Result = Bytesˉconcat(
                    Result,
                    Compilerˉwebassemblyˉindexedˉinstruction(
                        33u32, Descriptorˉresult
                    )
                );
                Result = Bytesˉconcat(
                    Result,
                    Compilerˉwebassemblyˉruntimeˉreclaimingˉreference(
                        Bytesˉreadˉu32ˉlittle(Input, Offset + 1u32) +
                            Localˉoffset,
                        false
                    )
                );
                Result = Bytesˉconcat(
                    Result,
                    Compilerˉwebassemblyˉindexedˉinstruction(
                        32u32, Descriptorˉresult
                    )
                );
                return Bytesˉconcat(
                    Result,
                    Compilerˉwebassemblyˉindexedˉinstruction(
                        33u32,
                        Bytesˉreadˉu32ˉlittle(Input, Offset + 1u32) +
                            Localˉoffset
                    )
                );
            }
        }
        return Bytesˉconcat(
            Result,
            Compilerˉwebassemblyˉindexedˉinstruction(
                33u32,
                Bytesˉreadˉu32ˉlittle(Input, Offset + 1u32) + Localˉoffset
            )
        );
    }
    if Opcode == 16u8 {
        return Bytesˉconcat(
            Result,
            Compilerˉwebassemblyˉcheckedˉaddˉinstructions(
                First,
                Second,
                Third
            )
        );
    }
    if Opcode == 17u8 {
        return Bytesˉconcat(
            Result,
            Compilerˉwebassemblyˉcheckedˉsubtractˉinstructions(
                First,
                Second,
                Third
            )
        );
    }
    if Opcode == 18u8 {
        return Bytesˉconcat(
            Result,
            Compilerˉwebassemblyˉcheckedˉmultiplyˉinstructions(
                First,
                Second,
                Third,
                Descriptorˉresult
            )
        );
    }
    if Opcode == 19u8 {
        return Bytesˉconcat(
            Result,
            Compilerˉwebassemblyˉcheckedˉnegateˉinstructions(First)
        );
    }
    if Opcode == 20u8 {
        Result = Bytesˉconcat(
            Result,
            Compilerˉwebassemblyˉindexedˉinstruction(33u32, Second)
        );
        Result = Bytesˉconcat(
            Result,
            Compilerˉwebassemblyˉindexedˉinstruction(33u32, First)
        );
        Result = Bytesˉconcat(
            Result,
            Compilerˉwebassemblyˉindexedˉinstruction(32u32, First)
        );
        Result = Bytesˉconcat(
            Result,
            Compilerˉwebassemblyˉindexedˉinstruction(32u32, Second)
        );
        Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉbyte(106u32));
        Result = Bytesˉconcat(
            Result,
            Compilerˉwebassemblyˉindexedˉinstruction(33u32, Third)
        );
        var Additionˉoverflow: bytes =
            Compilerˉwebassemblyˉindexedˉinstruction(32u32, Third);
        Additionˉoverflow = Bytesˉconcat(
            Additionˉoverflow,
            Compilerˉwebassemblyˉindexedˉinstruction(32u32, First)
        );
        Additionˉoverflow = Bytesˉconcat(
            Additionˉoverflow,
            Compilerˉwebassemblyˉbyte(73u32)
        );
        Result = Bytesˉconcat(
            Result,
            Compilerˉwebassemblyˉruntimeˉfailureˉifˉfor(
                Additionˉoverflow, 3007, Privateˉfunction
            )
        );
        return Bytesˉconcat(
            Result,
            Compilerˉwebassemblyˉindexedˉinstruction(32u32, Third)
        );
    }
    if Opcode == 21u8 {
        Result = Bytesˉconcat(
            Result,
            Compilerˉwebassemblyˉindexedˉinstruction(33u32, Second)
        );
        Result = Bytesˉconcat(
            Result,
            Compilerˉwebassemblyˉindexedˉinstruction(33u32, First)
        );
        var Subtractionˉunderflow: bytes =
            Compilerˉwebassemblyˉindexedˉinstruction(32u32, First);
        Subtractionˉunderflow = Bytesˉconcat(
            Subtractionˉunderflow,
            Compilerˉwebassemblyˉindexedˉinstruction(32u32, Second)
        );
        Subtractionˉunderflow = Bytesˉconcat(
            Subtractionˉunderflow,
            Compilerˉwebassemblyˉbyte(73u32)
        );
        Result = Bytesˉconcat(
            Result,
            Compilerˉwebassemblyˉruntimeˉfailureˉifˉfor(
                Subtractionˉunderflow, 3007, Privateˉfunction
            )
        );
        Result = Bytesˉconcat(
            Result,
            Compilerˉwebassemblyˉindexedˉinstruction(32u32, First)
        );
        Result = Bytesˉconcat(
            Result,
            Compilerˉwebassemblyˉindexedˉinstruction(32u32, Second)
        );
        return Bytesˉconcat(Result, Compilerˉwebassemblyˉbyte(107u32));
    }
    if Opcode == 22u8 {
        Result = Bytesˉconcat(
            Result,
            Compilerˉwebassemblyˉindexedˉinstruction(33u32, Second)
        );
        Result = Bytesˉconcat(
            Result,
            Compilerˉwebassemblyˉindexedˉinstruction(33u32, First)
        );
        Result = Bytesˉconcat(
            Result,
            Compilerˉwebassemblyˉindexedˉinstruction(32u32, First)
