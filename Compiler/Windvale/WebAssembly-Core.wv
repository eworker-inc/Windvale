export fn Compilerˉwebassemblyˉglobalˉi32(
    Mutable: u32,
    Initial: i32
) -> bytes {
    var Result: bytes = Compilerˉwebassemblyˉbyte(127u32);
    Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉbyte(Mutable));
    Result = Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉi32ˉconstant(Initial)
    );
    return Bytesˉconcat(Result, Compilerˉwebassemblyˉbyte(11u32));
}

export fn Compilerˉwebassemblyˉexportˉentry(
    Name: bytes,
    Kind: u32,
    Index: u32
) -> bytes {
    var Result: bytes = Compilerˉwebassemblyˉstring(Name);
    Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉbyte(Kind));
    return Bytesˉconcat(Result, Compilerˉwebassemblyˉuleb32(Index));
}

export fn Compilerˉwebassemblyˉutf8ˉrange(
    Minimum: u32,
    Maximum: u32
) -> bytes {
    var Result: bytes = Compilerˉwebassemblyˉindexedˉinstruction(32u32, 6u32);
    Result = Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉpositiveˉi32ˉconstant(Minimum)
    );
    Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉbyte(79u32));
    Result = Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉindexedˉinstruction(32u32, 6u32)
    );
    Result = Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉpositiveˉi32ˉconstant(Maximum)
    );
    Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉbyte(77u32));
    return Bytesˉconcat(Result, Compilerˉwebassemblyˉbyte(113u32));
}

export fn Compilerˉwebassemblyˉutf8ˉtwoˉranges(
    Firstˉminimum: u32,
    Firstˉmaximum: u32,
    Secondˉminimum: u32,
    Secondˉmaximum: u32
) -> bytes {
    var Result: bytes = Compilerˉwebassemblyˉutf8ˉrange(
        Firstˉminimum,
        Firstˉmaximum
    );
    Result = Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉutf8ˉrange(Secondˉminimum, Secondˉmaximum)
    );
    return Bytesˉconcat(Result, Compilerˉwebassemblyˉbyte(114u32));
}

export fn Compilerˉwebassemblyˉutf8ˉstate(
    Needed: u32,
    Minimum: u32,
    Maximum: u32
) -> bytes {
    var Result: bytes = Compilerˉwebassemblyˉpositiveˉi32ˉconstant(Needed);
    Result = Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉindexedˉinstruction(33u32, 3u32)
    );
    Result = Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉpositiveˉi32ˉconstant(Minimum)
    );
    Result = Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉindexedˉinstruction(33u32, 4u32)
    );
    Result = Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉpositiveˉi32ˉconstant(Maximum)
    );
    return Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉindexedˉinstruction(33u32, 5u32)
    );
}

export fn Compilerˉwebassemblyˉutf8ˉordinaryˉcontinuation() -> bytes {
    var Result: bytes = Compilerˉwebassemblyˉpositiveˉi32ˉconstant(128u32);
    Result = Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉindexedˉinstruction(33u32, 4u32)
    );
    Result = Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉpositiveˉi32ˉconstant(191u32)
    );
    return Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉindexedˉinstruction(33u32, 5u32)
    );
}

export fn Compilerˉwebassemblyˉutf8ˉinvalid() -> bytes {
    return Bytesˉconcat(
        Compilerˉwebassemblyˉi32ˉconstant(0),
        Compilerˉwebassemblyˉbyte(15u32)
    );
}

export fn Compilerˉwebassemblyˉifˉelseˉinstructions(
    Condition: bytes,
    Trueˉinstructions: bytes,
    Falseˉinstructions: bytes
) -> bytes {
    var Result: bytes = Condition;
    Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉbyte(4u32));
    Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉbyte(64u32));
    Result = Bytesˉconcat(Result, Trueˉinstructions);
    Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉbyte(5u32));
    Result = Bytesˉconcat(Result, Falseˉinstructions);
    return Bytesˉconcat(Result, Compilerˉwebassemblyˉbyte(11u32));
}

export fn Compilerˉwebassemblyˉifˉinstructions(
    Condition: bytes,
    Trueˉinstructions: bytes
) -> bytes {
    var Result: bytes = Condition;
    Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉbyte(4u32));
    Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉbyte(64u32));
    Result = Bytesˉconcat(Result, Trueˉinstructions);
    return Bytesˉconcat(Result, Compilerˉwebassemblyˉbyte(11u32));
}

export fn Compilerˉwebassemblyˉutf8ˉleading() -> bytes {
    let Empty: bytes = Compilerˉwebassemblyˉempty(
        Compilerˉwebassemblyˉbyte(0u32)
    );
    let Invalid: bytes = Compilerˉwebassemblyˉutf8ˉinvalid();
    let Fourˉmaximum: bytes = Compilerˉwebassemblyˉifˉelseˉinstructions(
        Compilerˉwebassemblyˉutf8ˉrange(244u32, 244u32),
        Compilerˉwebassemblyˉutf8ˉstate(3u32, 128u32, 143u32),
        Invalid
    );
    let Fourˉordinary: bytes = Compilerˉwebassemblyˉifˉelseˉinstructions(
        Compilerˉwebassemblyˉutf8ˉrange(241u32, 243u32),
        Compilerˉwebassemblyˉutf8ˉstate(3u32, 128u32, 191u32),
        Fourˉmaximum
    );
    let Fourˉminimum: bytes = Compilerˉwebassemblyˉifˉelseˉinstructions(
        Compilerˉwebassemblyˉutf8ˉrange(240u32, 240u32),
        Compilerˉwebassemblyˉutf8ˉstate(3u32, 144u32, 191u32),
        Fourˉordinary
    );
    let Threeˉsurrogate: bytes = Compilerˉwebassemblyˉifˉelseˉinstructions(
        Compilerˉwebassemblyˉutf8ˉrange(237u32, 237u32),
        Compilerˉwebassemblyˉutf8ˉstate(2u32, 128u32, 159u32),
        Fourˉminimum
    );
    let Threeˉordinary: bytes = Compilerˉwebassemblyˉifˉelseˉinstructions(
        Compilerˉwebassemblyˉutf8ˉtwoˉranges(
            225u32,
            236u32,
            238u32,
            239u32
        ),
        Compilerˉwebassemblyˉutf8ˉstate(2u32, 128u32, 191u32),
        Threeˉsurrogate
    );
    let Threeˉminimum: bytes = Compilerˉwebassemblyˉifˉelseˉinstructions(
        Compilerˉwebassemblyˉutf8ˉrange(224u32, 224u32),
        Compilerˉwebassemblyˉutf8ˉstate(2u32, 160u32, 191u32),
        Threeˉordinary
    );
    let Twoˉbyte: bytes = Compilerˉwebassemblyˉifˉelseˉinstructions(
        Compilerˉwebassemblyˉutf8ˉrange(194u32, 223u32),
        Compilerˉwebassemblyˉutf8ˉstate(1u32, 128u32, 191u32),
        Threeˉminimum
    );
    return Compilerˉwebassemblyˉifˉelseˉinstructions(
        Compilerˉwebassemblyˉutf8ˉrange(0u32, 127u32),
        Empty,
        Twoˉbyte
    );
}

export fn Compilerˉwebassemblyˉutf8ˉcontinuation() -> bytes {
    var Below: bytes = Compilerˉwebassemblyˉindexedˉinstruction(32u32, 6u32);
    Below = Bytesˉconcat(
        Below,
        Compilerˉwebassemblyˉindexedˉinstruction(32u32, 4u32)
    );
    Below = Bytesˉconcat(Below, Compilerˉwebassemblyˉbyte(73u32));
    var Result: bytes = Compilerˉwebassemblyˉifˉinstructions(
        Below,
        Compilerˉwebassemblyˉutf8ˉinvalid()
    );

    var Above: bytes = Compilerˉwebassemblyˉindexedˉinstruction(32u32, 6u32);
    Above = Bytesˉconcat(
        Above,
        Compilerˉwebassemblyˉindexedˉinstruction(32u32, 5u32)
    );
    Above = Bytesˉconcat(Above, Compilerˉwebassemblyˉbyte(75u32));
    Result = Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉifˉinstructions(
            Above,
            Compilerˉwebassemblyˉutf8ˉinvalid()
        )
    );
    Result = Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉindexedˉinstruction(32u32, 3u32)
    );
    Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉi32ˉconstant(1));
    Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉbyte(107u32));
    Result = Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉindexedˉinstruction(33u32, 3u32)
    );
    return Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉutf8ˉordinaryˉcontinuation()
    );
}

export fn Compilerˉwebassemblyˉencodeˉutf8ˉvalidator() -> bytes {
    var Body: bytes = Compilerˉwebassemblyˉuleb32(1u32);
    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉuleb32(5u32));
    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(127u32));
    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(2u32));
    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(64u32));
    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(3u32));
    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(64u32));
    Body = Bytesˉconcat(
        Body,
        Compilerˉwebassemblyˉindexedˉinstruction(32u32, 2u32)
    );
    Body = Bytesˉconcat(
        Body,
        Compilerˉwebassemblyˉindexedˉinstruction(32u32, 1u32)
    );
    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(79u32));
    Body = Bytesˉconcat(
        Body,
        Compilerˉwebassemblyˉindexedˉinstruction(13u32, 1u32)
    );
    Body = Bytesˉconcat(
        Body,
        Compilerˉwebassemblyˉindexedˉinstruction(32u32, 0u32)
    );
    Body = Bytesˉconcat(
        Body,
        Compilerˉwebassemblyˉindexedˉinstruction(32u32, 2u32)
    );
    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(106u32));
    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(45u32));
    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉuleb32(0u32));
    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉuleb32(0u32));
    Body = Bytesˉconcat(
        Body,
        Compilerˉwebassemblyˉindexedˉinstruction(33u32, 6u32)
    );

    var Needˉisˉzero: bytes = Compilerˉwebassemblyˉindexedˉinstruction(
        32u32,
        3u32
    );
    Needˉisˉzero = Bytesˉconcat(
        Needˉisˉzero,
        Compilerˉwebassemblyˉbyte(69u32)
    );
    Body = Bytesˉconcat(
        Body,
        Compilerˉwebassemblyˉifˉelseˉinstructions(
            Needˉisˉzero,
            Compilerˉwebassemblyˉutf8ˉleading(),
            Compilerˉwebassemblyˉutf8ˉcontinuation()
        )
    );
    Body = Bytesˉconcat(
        Body,
        Compilerˉwebassemblyˉindexedˉinstruction(32u32, 2u32)
    );
    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉi32ˉconstant(1));
    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(106u32));
    Body = Bytesˉconcat(
        Body,
        Compilerˉwebassemblyˉindexedˉinstruction(33u32, 2u32)
    );
    Body = Bytesˉconcat(
        Body,
        Compilerˉwebassemblyˉindexedˉinstruction(12u32, 0u32)
    );
    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(11u32));
    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(11u32));
    Body = Bytesˉconcat(
        Body,
        Compilerˉwebassemblyˉindexedˉinstruction(32u32, 3u32)
    );
    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(69u32));
    return Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(11u32));
}

export fn Compilerˉwebassemblyˉmemoryˉmeter() -> bytes {
    var Result: bytes = Compilerˉwebassemblyˉindexedˉinstruction(35u32, 7u32);
    Result = Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉindexedˉinstruction(32u32, 0u32)
    );
    Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉbyte(79u32));
    Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉbyte(4u32));
    Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉbyte(64u32));
    Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉi32ˉconstant(3011));
    Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉbyte(15u32));
    Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉbyte(11u32));
    Result = Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉindexedˉinstruction(35u32, 7u32)
    );
    Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉi32ˉconstant(1));
    Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉbyte(106u32));
    return Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉindexedˉinstruction(36u32, 7u32)
    );
}

export fn Compilerˉwebassemblyˉencodeˉmemoryˉwrapper(Kind: u32) -> bytes {
    var Body: bytes = Compilerˉwebassemblyˉuleb32(0u32);
    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉi32ˉconstant(0));
    Body = Bytesˉconcat(
        Body,
        Compilerˉwebassemblyˉindexedˉinstruction(36u32, 5u32)
    );
    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉi32ˉconstant(0));
    Body = Bytesˉconcat(
        Body,
        Compilerˉwebassemblyˉindexedˉinstruction(36u32, 7u32)
    );

    var Oversized: bytes = Compilerˉwebassemblyˉindexedˉinstruction(32u32, 1u32);
    Oversized = Bytesˉconcat(
        Oversized,
        Compilerˉwebassemblyˉpositiveˉi32ˉconstant(4194304u32)
    );
    Oversized = Bytesˉconcat(Oversized, Compilerˉwebassemblyˉbyte(75u32));
    Body = Bytesˉconcat(
        Body,
        Compilerˉwebassemblyˉifˉinstructions(
            Oversized,
            Bytesˉconcat(
                Compilerˉwebassemblyˉi32ˉconstant(3008),
                Compilerˉwebassemblyˉbyte(15u32)
            )
        )
    );
    if Kind == 2u32 {
        var Validate: bytes = Compilerˉwebassemblyˉpositiveˉi32ˉconstant(65536u32);
        Validate = Bytesˉconcat(
            Validate,
            Compilerˉwebassemblyˉindexedˉinstruction(32u32, 1u32)
        );
        Validate = Bytesˉconcat(
            Validate,
            Compilerˉwebassemblyˉindexedˉinstruction(16u32, 1u32)
        );
        Validate = Bytesˉconcat(Validate, Compilerˉwebassemblyˉbyte(69u32));
        Body = Bytesˉconcat(
            Body,
            Compilerˉwebassemblyˉifˉinstructions(
                Validate,
                Bytesˉconcat(
                    Compilerˉwebassemblyˉi32ˉconstant(3014),
                    Compilerˉwebassemblyˉbyte(15u32)
                )
            )
        );
    }
    var Instruction: u32 = 0u32;
    while Instruction < 4u32 {
        Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉmemoryˉmeter());
        Instruction = Instruction + 1u32;
    }
    Body = Bytesˉconcat(
        Body,
        Compilerˉwebassemblyˉpositiveˉi32ˉconstant(4259840u32)
    );
    Body = Bytesˉconcat(
        Body,
        Compilerˉwebassemblyˉpositiveˉi32ˉconstant(65536u32)
    );
    Body = Bytesˉconcat(
        Body,
        Compilerˉwebassemblyˉindexedˉinstruction(32u32, 1u32)
    );
    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(252u32));
    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉuleb32(10u32));
    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉuleb32(0u32));
    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉuleb32(0u32));
    Body = Bytesˉconcat(
        Body,
        Compilerˉwebassemblyˉindexedˉinstruction(32u32, 1u32)
    );
    Body = Bytesˉconcat(
        Body,
        Compilerˉwebassemblyˉindexedˉinstruction(36u32, 5u32)
    );
    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉi32ˉconstant(0));
    return Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(11u32));
}

export fn Compilerˉwebassemblyˉencodeˉmemory(Kind: u32) -> bytes {
    var Typeˉpayload: bytes = Compilerˉwebassemblyˉuleb32(1u32);
    Typeˉpayload = Bytesˉconcat(Typeˉpayload, Compilerˉwebassemblyˉbyte(96u32));
    Typeˉpayload = Bytesˉconcat(Typeˉpayload, Compilerˉwebassemblyˉuleb32(2u32));
    Typeˉpayload = Bytesˉconcat(Typeˉpayload, Compilerˉwebassemblyˉbyte(127u32));
    Typeˉpayload = Bytesˉconcat(Typeˉpayload, Compilerˉwebassemblyˉbyte(127u32));
    Typeˉpayload = Bytesˉconcat(Typeˉpayload, Compilerˉwebassemblyˉuleb32(1u32));
    Typeˉpayload = Bytesˉconcat(Typeˉpayload, Compilerˉwebassemblyˉbyte(127u32));

    var Functionˉcount: u32 = 1u32;
    if Kind == 2u32 { Functionˉcount = 2u32; }
    var Functionˉpayload: bytes = Compilerˉwebassemblyˉuleb32(Functionˉcount);
    var Functionˉindex: u32 = 0u32;
    while Functionˉindex < Functionˉcount {
        Functionˉpayload = Bytesˉconcat(
            Functionˉpayload,
            Compilerˉwebassemblyˉuleb32(0u32)
        );
        Functionˉindex = Functionˉindex + 1u32;
    }

    var Memoryˉpayload: bytes = Compilerˉwebassemblyˉuleb32(1u32);
    Memoryˉpayload = Bytesˉconcat(
        Memoryˉpayload,
        Compilerˉwebassemblyˉuleb32(1u32)
    );
    Memoryˉpayload = Bytesˉconcat(
        Memoryˉpayload,
        Compilerˉwebassemblyˉuleb32(129u32)
    );
    Memoryˉpayload = Bytesˉconcat(
        Memoryˉpayload,
        Compilerˉwebassemblyˉuleb32(129u32)
    );

    var Globalˉpayload: bytes = Compilerˉwebassemblyˉuleb32(8u32);
    Globalˉpayload = Bytesˉconcat(
        Globalˉpayload,
        Compilerˉwebassemblyˉglobalˉi32(0u32, 3)
    );
    Globalˉpayload = Bytesˉconcat(
        Globalˉpayload,
        Compilerˉwebassemblyˉglobalˉi32(0u32, 65536)
    );
    Globalˉpayload = Bytesˉconcat(
        Globalˉpayload,
        Compilerˉwebassemblyˉglobalˉi32(0u32, 4194304)
    );
    Globalˉpayload = Bytesˉconcat(
        Globalˉpayload,
        Compilerˉwebassemblyˉglobalˉi32(0u32, 4259840)
    );
    Globalˉpayload = Bytesˉconcat(
        Globalˉpayload,
        Compilerˉwebassemblyˉglobalˉi32(0u32, 4194304)
    );
    Globalˉpayload = Bytesˉconcat(
        Globalˉpayload,
        Compilerˉwebassemblyˉglobalˉi32(1u32, 0)
    );
    var Outputˉkind: i32 = 1;
    if Kind == 2u32 { Outputˉkind = 2; }
    Globalˉpayload = Bytesˉconcat(
        Globalˉpayload,
        Compilerˉwebassemblyˉglobalˉi32(0u32, Outputˉkind)
    );
    Globalˉpayload = Bytesˉconcat(
        Globalˉpayload,
        Compilerˉwebassemblyˉglobalˉi32(1u32, 0)
    );

    var Exportˉpayload: bytes = Compilerˉwebassemblyˉuleb32(10u32);
    Exportˉpayload = Bytesˉconcat(Exportˉpayload, Compilerˉwebassemblyˉexportˉentry(Textˉtoˉutf8("Windvale.run"), 0u32, 0u32));
    Exportˉpayload = Bytesˉconcat(Exportˉpayload, Compilerˉwebassemblyˉexportˉentry(Textˉtoˉutf8("Windvale.abi"), 3u32, 0u32));
    Exportˉpayload = Bytesˉconcat(Exportˉpayload, Compilerˉwebassemblyˉexportˉentry(Textˉtoˉutf8("Windvale.memory"), 2u32, 0u32));
    Exportˉpayload = Bytesˉconcat(Exportˉpayload, Compilerˉwebassemblyˉexportˉentry(Textˉtoˉutf8("Windvale.input_offset"), 3u32, 1u32));
    Exportˉpayload = Bytesˉconcat(Exportˉpayload, Compilerˉwebassemblyˉexportˉentry(Textˉtoˉutf8("Windvale.input_capacity"), 3u32, 2u32));
    Exportˉpayload = Bytesˉconcat(Exportˉpayload, Compilerˉwebassemblyˉexportˉentry(Textˉtoˉutf8("Windvale.output_offset"), 3u32, 3u32));
    Exportˉpayload = Bytesˉconcat(Exportˉpayload, Compilerˉwebassemblyˉexportˉentry(Textˉtoˉutf8("Windvale.output_capacity"), 3u32, 4u32));
    Exportˉpayload = Bytesˉconcat(Exportˉpayload, Compilerˉwebassemblyˉexportˉentry(Textˉtoˉutf8("Windvale.output_length"), 3u32, 5u32));
    Exportˉpayload = Bytesˉconcat(Exportˉpayload, Compilerˉwebassemblyˉexportˉentry(Textˉtoˉutf8("Windvale.output_kind"), 3u32, 6u32));
    Exportˉpayload = Bytesˉconcat(Exportˉpayload, Compilerˉwebassemblyˉexportˉentry(Textˉtoˉutf8("Windvale.instructions"), 3u32, 7u32));

    let Wrapper: bytes = Compilerˉwebassemblyˉencodeˉmemoryˉwrapper(Kind);
    var Codeˉpayload: bytes = Compilerˉwebassemblyˉuleb32(Functionˉcount);
    Codeˉpayload = Bytesˉconcat(
        Codeˉpayload,
        Compilerˉwebassemblyˉuleb32(Bytesˉlength(Wrapper))
    );
    Codeˉpayload = Bytesˉconcat(Codeˉpayload, Wrapper);
    if Kind == 2u32 {
        let Validator: bytes = Compilerˉwebassemblyˉencodeˉutf8ˉvalidator();
        Codeˉpayload = Bytesˉconcat(
            Codeˉpayload,
            Compilerˉwebassemblyˉuleb32(Bytesˉlength(Validator))
        );
        Codeˉpayload = Bytesˉconcat(Codeˉpayload, Validator);
    }

    var Result: bytes = Compilerˉwebassemblyˉbyte(0u32);
    Result = Bytesˉconcat(Result, Textˉtoˉutf8("asm"));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(1u32));
    Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉsectionˉbytes(1u32, Typeˉpayload));
    Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉsectionˉbytes(3u32, Functionˉpayload));
    Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉsectionˉbytes(5u32, Memoryˉpayload));
    Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉsectionˉbytes(6u32, Globalˉpayload));
    Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉsectionˉbytes(7u32, Exportˉpayload));
    return Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉsectionˉbytes(10u32, Codeˉpayload)
    );
}

export fn Compilerˉwebassemblyˉruntimeˉwasmˉtype(Type: u8) -> u32 {
    if Type == 6u8 { return 126u32; }
    return 127u32;
}

export fn Compilerˉwebassemblyˉruntimeˉi64ˉconstant(Value: u32) -> bytes {
    return Bytesˉconcat(
        Compilerˉwebassemblyˉbyte(66u32),
        Compilerˉwebassemblyˉpositiveˉsleb32(Value)
    );
}

export fn Compilerˉwebassemblyˉruntimeˉreturnˉstatus(Status: i32) -> bytes {
    return Bytesˉconcat(
        Compilerˉwebassemblyˉi32ˉconstant(Status),
        Compilerˉwebassemblyˉbyte(15u32)
    );
}

export fn Compilerˉwebassemblyˉruntimeˉdescriptorˉlength(
    Descriptor: u32
) -> bytes {
    var Result: bytes = Compilerˉwebassemblyˉindexedˉinstruction(
        32u32, Descriptor
    );
    Result = Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉruntimeˉi64ˉconstant(32u32)
    );
    Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉbyte(136u32));
    return Bytesˉconcat(Result, Compilerˉwebassemblyˉbyte(167u32));
}

export fn Compilerˉwebassemblyˉruntimeˉdescriptorˉpointer(
    Descriptor: u32
) -> bytes {
    return Bytesˉconcat(
        Compilerˉwebassemblyˉindexedˉinstruction(32u32, Descriptor),
        Compilerˉwebassemblyˉbyte(167u32)
    );
}

export fn Compilerˉwebassemblyˉruntimeˉpackˉdescriptor(
    Pointer: u32,
    Length: u32
) -> bytes {
    var Result: bytes = Compilerˉwebassemblyˉindexedˉinstruction(32u32, Pointer);
    Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉbyte(173u32));
    Result = Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉindexedˉinstruction(32u32, Length)
    );
    Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉbyte(173u32));
    Result = Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉruntimeˉi64ˉconstant(32u32)
    );
    Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉbyte(134u32));
    return Bytesˉconcat(Result, Compilerˉwebassemblyˉbyte(132u32));
}

export fn Compilerˉwebassemblyˉruntimeˉmemoryˉcopy() -> bytes {
    var Result: bytes = Compilerˉwebassemblyˉbyte(252u32);
    Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉuleb32(10u32));
    Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉuleb32(0u32));
    return Bytesˉconcat(Result, Compilerˉwebassemblyˉuleb32(0u32));
}

export fn Compilerˉwebassemblyˉruntimeˉmemoryˉinstruction(
    Opcode: u32,
    Alignment: u32
) -> bytes {
    var Result: bytes = Compilerˉwebassemblyˉbyte(Opcode);
    Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉuleb32(Alignment));
    return Bytesˉconcat(Result, Compilerˉwebassemblyˉuleb32(0u32));
}

export fn Compilerˉwebassemblyˉruntimeˉfailureˉif(
    Condition: bytes,
    Status: i32
) -> bytes {
    return Compilerˉwebassemblyˉifˉinstructions(
        Condition,
        Compilerˉwebassemblyˉruntimeˉreturnˉstatus(Status)
    );
}

export fn Compilerˉwebassemblyˉruntimeˉreadˉrange(
    Descriptor: u32,
    Offset: u32,
    Width: u32,
    Sourceˉlength: u32,
    Sourceˉpointer: u32
) -> bytes {
    var Result: bytes = Compilerˉwebassemblyˉruntimeˉdescriptorˉlength(Descriptor);
    Result = Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉindexedˉinstruction(33u32, Sourceˉlength)
    );
    Result = Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉruntimeˉdescriptorˉpointer(Descriptor)
    );
    Result = Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉindexedˉinstruction(33u32, Sourceˉpointer)
    );
    var Offsetˉinvalid: bytes = Compilerˉwebassemblyˉindexedˉinstruction(
        32u32, Offset
    );
    Offsetˉinvalid = Bytesˉconcat(
        Offsetˉinvalid,
        Compilerˉwebassemblyˉindexedˉinstruction(32u32, Sourceˉlength)
    );
    Offsetˉinvalid = Bytesˉconcat(
        Offsetˉinvalid,
        Compilerˉwebassemblyˉbyte(75u32)
    );
    Result = Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉruntimeˉfailureˉif(Offsetˉinvalid, 3008)
    );
    var Widthˉinvalid: bytes = Compilerˉwebassemblyˉindexedˉinstruction(
        32u32, Width
    );
    Widthˉinvalid = Bytesˉconcat(
        Widthˉinvalid,
        Compilerˉwebassemblyˉindexedˉinstruction(32u32, Sourceˉlength)
    );
    Widthˉinvalid = Bytesˉconcat(
        Widthˉinvalid,
        Compilerˉwebassemblyˉindexedˉinstruction(32u32, Offset)
    );
    Widthˉinvalid = Bytesˉconcat(Widthˉinvalid, Compilerˉwebassemblyˉbyte(107u32));
    Widthˉinvalid = Bytesˉconcat(Widthˉinvalid, Compilerˉwebassemblyˉbyte(75u32));
    Result = Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉruntimeˉfailureˉif(Widthˉinvalid, 3008)
    );
    Result = Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉindexedˉinstruction(32u32, Sourceˉpointer)
    );
    Result = Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉindexedˉinstruction(32u32, Offset)
    );
    return Bytesˉconcat(Result, Compilerˉwebassemblyˉbyte(106u32));
}

export fn Compilerˉwebassemblyˉencodeˉruntimeˉinstruction(
    Input: bytes,
    Offset: u32,
    Opcode: u8,
    Arena: u32,
    First: u32,
    Second: u32,
    Third: u32,
    Fourth: u32,
    Descriptorˉfirst: u32,
    Descriptorˉsecond: u32,
    Descriptorˉresult: u32
) -> bytes {
    var Result: bytes = Compilerˉwebassemblyˉmemoryˉmeter();
    var Isˉread: bool = false;
    if Opcode == 13u8 { Isˉread = true; }
    if Opcode == 14u8 { Isˉread = true; }
    if Opcode == 15u8 { Isˉread = true; }
    if Opcode == 114u8 { Isˉread = true; }
    var Isˉbuilder: bool = false;
    if Opcode == 120u8 { Isˉbuilder = true; }
    if Opcode == 121u8 { Isˉbuilder = true; }
    if Opcode == 122u8 { Isˉbuilder = true; }
    if Opcode == 123u8 { Isˉbuilder = true; }
    if Opcode == 1u8 {
        return Bytesˉconcat(
            Result,
            Compilerˉwebassemblyˉi32ˉconstantˉfromˉinput(Input, Offset + 1u32)
        );
    }
    if Opcode == 2u8 {
        return Bytesˉconcat(
            Result,
            Compilerˉwebassemblyˉpositiveˉi32ˉconstant(
                U32ˉfromˉu8(Bytesˉreadˉu8(Input, Offset + 1u32))
            )
        );
    }
    if Opcode == 8u8 {
        return Bytesˉconcat(
            Result,
            Compilerˉwebassemblyˉpositiveˉi32ˉconstant(
                U32ˉfromˉu8(Bytesˉreadˉu8(Input, Offset + 1u32))
            )
        );
    }
    if Opcode == 9u8 {
        return Bytesˉconcat(
            Result,
            Compilerˉwebassemblyˉi32ˉconstantˉfromˉinput(Input, Offset + 1u32)
        );
    }
    if Opcode == 4u8 {
        return Bytesˉconcat(
            Result,
            Compilerˉwebassemblyˉindexedˉinstruction(
                32u32,
                Bytesˉreadˉu32ˉlittle(Input, Offset + 1u32) + 2u32
            )
        );
    }
    if Opcode == 5u8 {
        return Bytesˉconcat(
            Result,
            Compilerˉwebassemblyˉindexedˉinstruction(
                33u32,
                Bytesˉreadˉu32ˉlittle(Input, Offset + 1u32) + 2u32
            )
        );
    }
    if Opcode == 20u8 {
        Result = Bytesˉconcat(
            Result,
            Compilerˉwebassemblyˉindexedˉinstruction(33u32, Second)
        );
        Result = Bytesˉconcat(
            Result,
            Compilerˉwebassemblyˉindexedˉinstruction(33u32, First)
        );
        Result = Bytesˉconcat(
            Result,
            Compilerˉwebassemblyˉindexedˉinstruction(32u32, First)
        );
        Result = Bytesˉconcat(
            Result,
            Compilerˉwebassemblyˉindexedˉinstruction(32u32, Second)
        );
        Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉbyte(106u32));
        Result = Bytesˉconcat(
            Result,
            Compilerˉwebassemblyˉindexedˉinstruction(33u32, Third)
        );
        var Additionˉoverflow: bytes =
            Compilerˉwebassemblyˉindexedˉinstruction(32u32, Third);
        Additionˉoverflow = Bytesˉconcat(
            Additionˉoverflow,
            Compilerˉwebassemblyˉindexedˉinstruction(32u32, First)
        );
        Additionˉoverflow = Bytesˉconcat(
            Additionˉoverflow,
            Compilerˉwebassemblyˉbyte(73u32)
        );
        Result = Bytesˉconcat(
            Result,
            Compilerˉwebassemblyˉruntimeˉfailureˉif(Additionˉoverflow, 3007)
        );
        return Bytesˉconcat(
            Result,
            Compilerˉwebassemblyˉindexedˉinstruction(32u32, Third)
        );
    }
    if Opcode == 21u8 {
        Result = Bytesˉconcat(
            Result,
            Compilerˉwebassemblyˉindexedˉinstruction(33u32, Second)
        );
        Result = Bytesˉconcat(
            Result,
            Compilerˉwebassemblyˉindexedˉinstruction(33u32, First)
        );
        var Subtractionˉunderflow: bytes =
            Compilerˉwebassemblyˉindexedˉinstruction(32u32, First);
        Subtractionˉunderflow = Bytesˉconcat(
            Subtractionˉunderflow,
            Compilerˉwebassemblyˉindexedˉinstruction(32u32, Second)
        );
        Subtractionˉunderflow = Bytesˉconcat(
            Subtractionˉunderflow,
            Compilerˉwebassemblyˉbyte(73u32)
        );
        Result = Bytesˉconcat(
            Result,
            Compilerˉwebassemblyˉruntimeˉfailureˉif(Subtractionˉunderflow, 3007)
        );
        Result = Bytesˉconcat(
            Result,
            Compilerˉwebassemblyˉindexedˉinstruction(32u32, First)
        );
        Result = Bytesˉconcat(
            Result,
            Compilerˉwebassemblyˉindexedˉinstruction(32u32, Second)
        );
        return Bytesˉconcat(Result, Compilerˉwebassemblyˉbyte(107u32));
    }
    var Comparisonˉopcode: u32 = 0u32;
    if Opcode == 96u8 { Comparisonˉopcode = 70u32; }
    if Opcode == 97u8 { Comparisonˉopcode = 71u32; }
    if Opcode == 98u8 { Comparisonˉopcode = 73u32; }
    if Opcode == 99u8 { Comparisonˉopcode = 77u32; }
    if Opcode == 100u8 { Comparisonˉopcode = 75u32; }
    if Opcode == 101u8 { Comparisonˉopcode = 79u32; }
    if Opcode == 102u8 { Comparisonˉopcode = 70u32; }
    if Opcode == 103u8 { Comparisonˉopcode = 71u32; }
    if Comparisonˉopcode != 0u32 {
        return Bytesˉconcat(
            Result,
            Compilerˉwebassemblyˉbyte(Comparisonˉopcode)
        );
    }
    if Opcode == 11u8 {
        Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉruntimeˉi64ˉconstant(32u32));
        Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉbyte(136u32));
        return Bytesˉconcat(Result, Compilerˉwebassemblyˉbyte(167u32));
    }
    if Opcode == 12u8 {
        Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉindexedˉinstruction(33u32, Third));
        Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉindexedˉinstruction(33u32, Second));
        Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉindexedˉinstruction(33u32, Descriptorˉfirst));
        Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉruntimeˉdescriptorˉlength(Descriptorˉfirst));
        Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉindexedˉinstruction(33u32, First));
        Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉruntimeˉdescriptorˉpointer(Descriptorˉfirst));
        Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉindexedˉinstruction(33u32, Fourth));
        var Offsetˉinvalid: bytes = Compilerˉwebassemblyˉindexedˉinstruction(32u32, Second);
        Offsetˉinvalid = Bytesˉconcat(Offsetˉinvalid, Compilerˉwebassemblyˉindexedˉinstruction(32u32, First));
        Offsetˉinvalid = Bytesˉconcat(Offsetˉinvalid, Compilerˉwebassemblyˉbyte(75u32));
        Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉruntimeˉfailureˉif(Offsetˉinvalid, 3008));
        var Lengthˉinvalid: bytes = Compilerˉwebassemblyˉindexedˉinstruction(32u32, Third);
        Lengthˉinvalid = Bytesˉconcat(Lengthˉinvalid, Compilerˉwebassemblyˉindexedˉinstruction(32u32, First));
        Lengthˉinvalid = Bytesˉconcat(Lengthˉinvalid, Compilerˉwebassemblyˉindexedˉinstruction(32u32, Second));
        Lengthˉinvalid = Bytesˉconcat(Lengthˉinvalid, Compilerˉwebassemblyˉbyte(107u32));
        Lengthˉinvalid = Bytesˉconcat(Lengthˉinvalid, Compilerˉwebassemblyˉbyte(75u32));
        Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉruntimeˉfailureˉif(Lengthˉinvalid, 3008));
        Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉindexedˉinstruction(32u32, Fourth));
        Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉindexedˉinstruction(32u32, Second));
        Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉbyte(106u32));
        Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉindexedˉinstruction(33u32, Fourth));
        return Bytesˉconcat(Result, Compilerˉwebassemblyˉruntimeˉpackˉdescriptor(Fourth, Third));
    }
    if Isˉread {
        Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉindexedˉinstruction(33u32, Second));
        Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉindexedˉinstruction(33u32, Descriptorˉfirst));
        var Readˉwidth: u32 = 4u32;
        if Opcode == 13u8 { Readˉwidth = 1u32; }
        if Opcode == 14u8 { Readˉwidth = 2u32; }
        Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉpositiveˉi32ˉconstant(Readˉwidth));
        Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉindexedˉinstruction(33u32, Third));
        Result = Bytesˉconcat(
            Result,
            Compilerˉwebassemblyˉruntimeˉreadˉrange(
                Descriptorˉfirst, Second, Third, First, Fourth
            )
        );
        var Loadˉopcode: u32 = 40u32;
        var Readˉalignment: u32 = 2u32;
        if Opcode == 13u8 { Loadˉopcode = 45u32; Readˉalignment = 0u32; }
        if Opcode == 14u8 { Loadˉopcode = 47u32; Readˉalignment = 1u32; }
        return Bytesˉconcat(
            Result,
            Compilerˉwebassemblyˉruntimeˉmemoryˉinstruction(
                Loadˉopcode, Readˉalignment
            )
        );
    }
    if Opcode == 118u8 { return Result; }
    if Opcode == 119u8 {
        Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉindexedˉinstruction(33u32, Descriptorˉsecond));
        Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉindexedˉinstruction(33u32, Descriptorˉfirst));
        Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉruntimeˉdescriptorˉlength(Descriptorˉfirst));
        Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉindexedˉinstruction(33u32, First));
        Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉruntimeˉdescriptorˉlength(Descriptorˉsecond));
        Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉindexedˉinstruction(33u32, Second));
        Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉindexedˉinstruction(32u32, First));
        Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉindexedˉinstruction(32u32, Second));
        Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉbyte(106u32));
        Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉindexedˉinstruction(33u32, Third));
        var Tooˉlarge: bytes = Compilerˉwebassemblyˉindexedˉinstruction(32u32, Third);
        Tooˉlarge = Bytesˉconcat(Tooˉlarge, Compilerˉwebassemblyˉpositiveˉi32ˉconstant(4194304u32));
        Tooˉlarge = Bytesˉconcat(Tooˉlarge, Compilerˉwebassemblyˉbyte(75u32));
        Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉruntimeˉfailureˉif(Tooˉlarge, 3015));
        var Concatˉexhausted: bytes = Compilerˉwebassemblyˉindexedˉinstruction(32u32, Third);
        Concatˉexhausted = Bytesˉconcat(Concatˉexhausted, Compilerˉwebassemblyˉpositiveˉi32ˉconstant(8454144u32));
        Concatˉexhausted = Bytesˉconcat(Concatˉexhausted, Compilerˉwebassemblyˉindexedˉinstruction(32u32, Arena));
        Concatˉexhausted = Bytesˉconcat(Concatˉexhausted, Compilerˉwebassemblyˉbyte(107u32));
        Concatˉexhausted = Bytesˉconcat(Concatˉexhausted, Compilerˉwebassemblyˉbyte(75u32));
        Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉruntimeˉfailureˉif(Concatˉexhausted, 3018));
        Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉindexedˉinstruction(32u32, Arena));
        Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉruntimeˉdescriptorˉpointer(Descriptorˉfirst));
        Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉindexedˉinstruction(32u32, First));
        Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉruntimeˉmemoryˉcopy());
        Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉindexedˉinstruction(32u32, Arena));
        Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉindexedˉinstruction(32u32, First));
        Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉbyte(106u32));
        Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉruntimeˉdescriptorˉpointer(Descriptorˉsecond));
        Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉindexedˉinstruction(32u32, Second));
        Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉruntimeˉmemoryˉcopy());
        Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉruntimeˉpackˉdescriptor(Arena, Third));
        Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉindexedˉinstruction(33u32, Descriptorˉresult));
        Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉindexedˉinstruction(32u32, Arena));
        Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉindexedˉinstruction(32u32, Third));
        Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉbyte(106u32));
        Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉindexedˉinstruction(33u32, Arena));
        return Bytesˉconcat(Result, Compilerˉwebassemblyˉindexedˉinstruction(32u32, Descriptorˉresult));
    }
    if Isˉbuilder {
        Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉindexedˉinstruction(33u32, First));
        var Buildˉwidth: u32 = 4u32;
        var Storeˉopcode: u32 = 54u32;
        var Buildˉalignment: u32 = 2u32;
        if Opcode == 120u8 { Buildˉwidth = 1u32; Storeˉopcode = 58u32; Buildˉalignment = 0u32; }
        if Opcode == 121u8 { Buildˉwidth = 2u32; Storeˉopcode = 59u32; Buildˉalignment = 1u32; }
        if Opcode == 121u8 {
            var Tooˉwide: bytes = Compilerˉwebassemblyˉindexedˉinstruction(32u32, First);
            Tooˉwide = Bytesˉconcat(Tooˉwide, Compilerˉwebassemblyˉpositiveˉi32ˉconstant(65535u32));
            Tooˉwide = Bytesˉconcat(Tooˉwide, Compilerˉwebassemblyˉbyte(75u32));
            Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉruntimeˉfailureˉif(Tooˉwide, 3016));
        }
        Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉpositiveˉi32ˉconstant(Buildˉwidth));
        Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉindexedˉinstruction(33u32, Second));
        var Builderˉexhausted: bytes = Compilerˉwebassemblyˉindexedˉinstruction(32u32, Second);
        Builderˉexhausted = Bytesˉconcat(Builderˉexhausted, Compilerˉwebassemblyˉpositiveˉi32ˉconstant(8454144u32));
        Builderˉexhausted = Bytesˉconcat(Builderˉexhausted, Compilerˉwebassemblyˉindexedˉinstruction(32u32, Arena));
        Builderˉexhausted = Bytesˉconcat(Builderˉexhausted, Compilerˉwebassemblyˉbyte(107u32));
        Builderˉexhausted = Bytesˉconcat(Builderˉexhausted, Compilerˉwebassemblyˉbyte(75u32));
        Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉruntimeˉfailureˉif(Builderˉexhausted, 3018));
        Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉindexedˉinstruction(32u32, Arena));
        Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉindexedˉinstruction(32u32, First));
        Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉruntimeˉmemoryˉinstruction(Storeˉopcode, Buildˉalignment));
        Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉruntimeˉpackˉdescriptor(Arena, Second));
        Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉindexedˉinstruction(33u32, Descriptorˉresult));
        Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉindexedˉinstruction(32u32, Arena));
        Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉindexedˉinstruction(32u32, Second));
        Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉbyte(106u32));
        Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉindexedˉinstruction(33u32, Arena));
        return Bytesˉconcat(Result, Compilerˉwebassemblyˉindexedˉinstruction(32u32, Descriptorˉresult));
    }
    if Opcode == 80u8 {
        return Bytesˉconcat(Result, Compilerˉwebassemblyˉbyte(26u32));
    }
    return Result;
}

export fn Compilerˉwebassemblyˉencodeˉruntimeˉwrapper(
    Input: bytes,
    Codeˉoffset: u32,
    Function: Compilerˉwebassemblyˉruntimeˉfunction
) -> bytes {
    let Arena: u32 = Function.Localˉcount + 2u32;
    let First: u32 = Arena + 1u32;
    let Second: u32 = Arena + 2u32;
    let Third: u32 = Arena + 3u32;
    let Fourth: u32 = Arena + 4u32;
    let Descriptorˉfirst: u32 = Arena + 5u32;
    let Descriptorˉsecond: u32 = Arena + 6u32;
    let Descriptorˉresult: u32 = Arena + 7u32;

    var Body: bytes = Compilerˉwebassemblyˉuleb32(Function.Localˉcount + 2u32);
    var Local: u32 = 0u32;
    while Local < Function.Localˉcount {
        Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉuleb32(1u32));
        Body = Bytesˉconcat(
            Body,
            Compilerˉwebassemblyˉbyte(
                Compilerˉwebassemblyˉruntimeˉwasmˉtype(
                    Compilerˉwebassemblyˉruntimeˉlocalˉtype(
                        Input, Function, Local
                    )
                )
            )
        );
        Local = Local + 1u32;
    }
    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉuleb32(5u32));
    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(127u32));
    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉuleb32(3u32));
    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(126u32));

    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉi32ˉconstant(0));
    Body = Bytesˉconcat(
        Body,
        Compilerˉwebassemblyˉindexedˉinstruction(36u32, 5u32)
    );
    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉi32ˉconstant(0));
    Body = Bytesˉconcat(
        Body,
        Compilerˉwebassemblyˉindexedˉinstruction(36u32, 7u32)
    );
    var Oversized: bytes = Compilerˉwebassemblyˉindexedˉinstruction(32u32, 1u32);
    Oversized = Bytesˉconcat(
        Oversized,
        Compilerˉwebassemblyˉpositiveˉi32ˉconstant(4194304u32)
    );
    Oversized = Bytesˉconcat(Oversized, Compilerˉwebassemblyˉbyte(75u32));
    Body = Bytesˉconcat(
        Body,
        Compilerˉwebassemblyˉruntimeˉfailureˉif(Oversized, 3008)
    );

    Body = Bytesˉconcat(
        Body,
        Compilerˉwebassemblyˉruntimeˉi64ˉconstant(65536u32)
    );
    Body = Bytesˉconcat(
        Body,
        Compilerˉwebassemblyˉindexedˉinstruction(32u32, 1u32)
    );
    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(173u32));
    Body = Bytesˉconcat(
        Body,
        Compilerˉwebassemblyˉruntimeˉi64ˉconstant(32u32)
    );
    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(134u32));
    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(132u32));
    Body = Bytesˉconcat(
        Body,
        Compilerˉwebassemblyˉindexedˉinstruction(33u32, 2u32)
    );
    Body = Bytesˉconcat(
        Body,
        Compilerˉwebassemblyˉpositiveˉi32ˉconstant(4259840u32)
    );
    Body = Bytesˉconcat(
        Body,
        Compilerˉwebassemblyˉindexedˉinstruction(33u32, Arena)
    );

    var Cursor: u32 = 0u32;
    while Cursor < Function.Codeˉlength {
        let Opcode: u8 = Bytesˉreadˉu8(Input, Codeˉoffset + Cursor);
        var Width: u32 = 1u32;
        if Opcode == 1u8 { Width = 5u32; }
        if Opcode == 2u8 { Width = 2u32; }
        if Opcode == 4u8 { Width = 5u32; }
        if Opcode == 5u8 { Width = 5u32; }
        if Opcode == 8u8 { Width = 2u32; }
        if Opcode == 9u8 { Width = 5u32; }
        if Opcode == 81u8 {
            Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉmemoryˉmeter());
            Body = Bytesˉconcat(
                Body,
                Compilerˉwebassemblyˉindexedˉinstruction(
                    33u32, Descriptorˉfirst
                )
            );
            Body = Bytesˉconcat(
                Body,
                Compilerˉwebassemblyˉruntimeˉdescriptorˉlength(
                    Descriptorˉfirst
                )
            );
            Body = Bytesˉconcat(
                Body,
                Compilerˉwebassemblyˉindexedˉinstruction(33u32, First)
            );
            Body = Bytesˉconcat(
                Body,
                Compilerˉwebassemblyˉruntimeˉdescriptorˉpointer(
                    Descriptorˉfirst
                )
            );
            Body = Bytesˉconcat(
                Body,
                Compilerˉwebassemblyˉindexedˉinstruction(33u32, Second)
            );
            Body = Bytesˉconcat(
                Body,
                Compilerˉwebassemblyˉpositiveˉi32ˉconstant(4259840u32)
            );
            Body = Bytesˉconcat(
                Body,
                Compilerˉwebassemblyˉindexedˉinstruction(32u32, Second)
            );
            Body = Bytesˉconcat(
                Body,
                Compilerˉwebassemblyˉindexedˉinstruction(32u32, First)
            );
            Body = Bytesˉconcat(
                Body,
                Compilerˉwebassemblyˉruntimeˉmemoryˉcopy()
            );
            Body = Bytesˉconcat(
                Body,
                Compilerˉwebassemblyˉindexedˉinstruction(32u32, First)
            );
            Body = Bytesˉconcat(
                Body,
                Compilerˉwebassemblyˉindexedˉinstruction(36u32, 5u32)
            );
            Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉi32ˉconstant(0));
        } else {
            Body = Bytesˉconcat(
                Body,
                Compilerˉwebassemblyˉencodeˉruntimeˉinstruction(
                    Input,
                    Codeˉoffset + Cursor,
                    Opcode,
                    Arena,
                    First,
                    Second,
                    Third,
                    Fourth,
                    Descriptorˉfirst,
                    Descriptorˉsecond,
                    Descriptorˉresult
                )
            );
        }
        Cursor = Cursor + Width;
    }
    return Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(11u32));
}

export fn Compilerˉwebassemblyˉencodeˉruntimeˉreturn(
    Descriptor: u32,
    Length: u32,
    Pointer: u32
) -> bytes {
    var Result: bytes = Compilerˉwebassemblyˉindexedˉinstruction(
        33u32, Descriptor
    );
    Result = Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉruntimeˉdescriptorˉlength(Descriptor)
    );
    Result = Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉindexedˉinstruction(33u32, Length)
    );
    Result = Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉruntimeˉdescriptorˉpointer(Descriptor)
    );
    Result = Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉindexedˉinstruction(33u32, Pointer)
    );
    Result = Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉpositiveˉi32ˉconstant(4259840u32)
    );
    Result = Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉindexedˉinstruction(32u32, Pointer)
    );
    Result = Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉindexedˉinstruction(32u32, Length)
    );
    Result = Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉruntimeˉmemoryˉcopy()
    );
    Result = Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉindexedˉinstruction(32u32, Length)
    );
    Result = Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉindexedˉinstruction(36u32, 5u32)
    );
    Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉi32ˉconstant(0));
    return Bytesˉconcat(Result, Compilerˉwebassemblyˉbyte(15u32));
}

export fn Compilerˉwebassemblyˉencodeˉruntimeˉcontrolˉwrapper(
    Input: bytes,
    Codeˉoffset: u32,
    Function: Compilerˉwebassemblyˉruntimeˉfunction
) -> bytes {
    let Arena: u32 = Function.Localˉcount + 2u32;
    let First: u32 = Arena + 1u32;
    let Second: u32 = Arena + 2u32;
    let Third: u32 = Arena + 3u32;
    let Fourth: u32 = Arena + 4u32;
    let Programˉcounter: u32 = Arena + 5u32;
    let Descriptorˉfirst: u32 = Arena + 6u32;
    let Descriptorˉsecond: u32 = Arena + 7u32;
    let Descriptorˉresult: u32 = Arena + 8u32;

    var Body: bytes = Compilerˉwebassemblyˉuleb32(Function.Localˉcount + 2u32);
    var Local: u32 = 0u32;
    while Local < Function.Localˉcount {
        Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉuleb32(1u32));
        Body = Bytesˉconcat(
            Body,
            Compilerˉwebassemblyˉbyte(
                Compilerˉwebassemblyˉruntimeˉwasmˉtype(
                    Compilerˉwebassemblyˉruntimeˉlocalˉtype(
                        Input, Function, Local
                    )
                )
            )
        );
        Local = Local + 1u32;
    }
    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉuleb32(6u32));
    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(127u32));
    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉuleb32(3u32));
    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(126u32));

    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉi32ˉconstant(0));
    Body = Bytesˉconcat(
        Body,
        Compilerˉwebassemblyˉindexedˉinstruction(36u32, 5u32)
    );
    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉi32ˉconstant(0));
    Body = Bytesˉconcat(
        Body,
        Compilerˉwebassemblyˉindexedˉinstruction(36u32, 7u32)
    );
    var Oversized: bytes = Compilerˉwebassemblyˉindexedˉinstruction(32u32, 1u32);
    Oversized = Bytesˉconcat(
        Oversized,
        Compilerˉwebassemblyˉpositiveˉi32ˉconstant(4194304u32)
    );
    Oversized = Bytesˉconcat(Oversized, Compilerˉwebassemblyˉbyte(75u32));
    Body = Bytesˉconcat(
        Body,
        Compilerˉwebassemblyˉruntimeˉfailureˉif(Oversized, 3008)
    );

    Body = Bytesˉconcat(
        Body,
        Compilerˉwebassemblyˉruntimeˉi64ˉconstant(65536u32)
    );
    Body = Bytesˉconcat(
        Body,
        Compilerˉwebassemblyˉindexedˉinstruction(32u32, 1u32)
    );
    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(173u32));
    Body = Bytesˉconcat(
        Body,
        Compilerˉwebassemblyˉruntimeˉi64ˉconstant(32u32)
    );
    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(134u32));
    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(132u32));
    Body = Bytesˉconcat(
        Body,
        Compilerˉwebassemblyˉindexedˉinstruction(33u32, 2u32)
    );
    Body = Bytesˉconcat(
        Body,
        Compilerˉwebassemblyˉpositiveˉi32ˉconstant(4259840u32)
    );
    Body = Bytesˉconcat(
        Body,
        Compilerˉwebassemblyˉindexedˉinstruction(33u32, Arena)
    );
    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉi32ˉconstant(0));
    Body = Bytesˉconcat(
        Body,
        Compilerˉwebassemblyˉindexedˉinstruction(33u32, Programˉcounter)
    );
    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(3u32));
    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(64u32));

    var Cursor: u32 = 0u32;
    var Openˉblock: bool = false;
    while Cursor < Function.Codeˉlength {
        if !Openˉblock {
            Body = Bytesˉconcat(
                Body,
                Compilerˉwebassemblyˉindexedˉinstruction(
                    32u32, Programˉcounter
                )
            );
            Body = Bytesˉconcat(
                Body,
                Compilerˉwebassemblyˉpositiveˉi32ˉconstant(Cursor)
            );
            Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(70u32));
            Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(4u32));
            Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(64u32));
            Openˉblock = true;
        }

        let Opcode: u8 = Bytesˉreadˉu8(Input, Codeˉoffset + Cursor);
        let Width: u32 = Compilerˉwebassemblyˉruntimeˉinstructionˉwidth(
            Input, Codeˉoffset, Function.Codeˉlength, Cursor
        );
        if Opcode == 48u8 {
            Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉmemoryˉmeter());
            Body = Bytesˉconcat(
                Body,
                Compilerˉwebassemblyˉpositiveˉi32ˉconstant(
                    Bytesˉreadˉu32ˉlittle(Input, Codeˉoffset + Cursor + 1u32)
                )
            );
            Body = Bytesˉconcat(
                Body,
                Compilerˉwebassemblyˉindexedˉinstruction(
                    33u32, Programˉcounter
                )
            );
            Body = Bytesˉconcat(
                Body,
                Compilerˉwebassemblyˉindexedˉinstruction(12u32, 1u32)
            );
            Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(11u32));
            Openˉblock = false;
        } else {
            if Opcode == 49u8 {
                Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉmemoryˉmeter());
                Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(4u32));
                Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(64u32));
                Body = Bytesˉconcat(
                    Body,
                    Compilerˉwebassemblyˉpositiveˉi32ˉconstant(Cursor + Width)
                );
                Body = Bytesˉconcat(
                    Body,
                    Compilerˉwebassemblyˉindexedˉinstruction(
                        33u32, Programˉcounter
                    )
                );
                Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(5u32));
                Body = Bytesˉconcat(
                    Body,
                    Compilerˉwebassemblyˉpositiveˉi32ˉconstant(
                        Bytesˉreadˉu32ˉlittle(Input, Codeˉoffset + Cursor + 1u32)
                    )
                );
                Body = Bytesˉconcat(
                    Body,
                    Compilerˉwebassemblyˉindexedˉinstruction(
                        33u32, Programˉcounter
                    )
                );
                Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(11u32));
                Body = Bytesˉconcat(
                    Body,
                    Compilerˉwebassemblyˉindexedˉinstruction(12u32, 1u32)
                );
                Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(11u32));
                Openˉblock = false;
            } else {
                if Opcode == 81u8 {
                    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉmemoryˉmeter());
                    Body = Bytesˉconcat(
                        Body,
                        Compilerˉwebassemblyˉencodeˉruntimeˉreturn(
                            Descriptorˉfirst, First, Second
                        )
                    );
                    Body = Bytesˉconcat(
                        Body,
                        Compilerˉwebassemblyˉbyte(11u32)
                    );
                    Openˉblock = false;
                } else {
                    Body = Bytesˉconcat(
                        Body,
                        Compilerˉwebassemblyˉencodeˉruntimeˉinstruction(
                            Input,
                            Codeˉoffset + Cursor,
                            Opcode,
                            Arena,
                            First,
                            Second,
                            Third,
                            Fourth,
                            Descriptorˉfirst,
                            Descriptorˉsecond,
                            Descriptorˉresult
                        )
                    );
                }
            }
        }
        Cursor = Cursor + Width;
    }
    Body = Bytesˉconcat(
        Body,
        Compilerˉwebassemblyˉruntimeˉreturnˉstatus(3001)
    );
    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(11u32));
    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉi32ˉconstant(3001));
    return Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(11u32));
}

export fn Compilerˉwebassemblyˉencodeˉruntime(
    Input: bytes,
    Codeˉoffset: u32,
    Function: Compilerˉwebassemblyˉruntimeˉfunction
) -> bytes {
    var Typeˉpayload: bytes = Compilerˉwebassemblyˉuleb32(1u32);
    Typeˉpayload = Bytesˉconcat(Typeˉpayload, Compilerˉwebassemblyˉbyte(96u32));
    Typeˉpayload = Bytesˉconcat(Typeˉpayload, Compilerˉwebassemblyˉuleb32(2u32));
    Typeˉpayload = Bytesˉconcat(Typeˉpayload, Compilerˉwebassemblyˉbyte(127u32));
    Typeˉpayload = Bytesˉconcat(Typeˉpayload, Compilerˉwebassemblyˉbyte(127u32));
    Typeˉpayload = Bytesˉconcat(Typeˉpayload, Compilerˉwebassemblyˉuleb32(1u32));
    Typeˉpayload = Bytesˉconcat(Typeˉpayload, Compilerˉwebassemblyˉbyte(127u32));

    var Functionˉpayload: bytes = Compilerˉwebassemblyˉuleb32(1u32);
    Functionˉpayload = Bytesˉconcat(
        Functionˉpayload,
        Compilerˉwebassemblyˉuleb32(0u32)
    );
    var Memoryˉpayload: bytes = Compilerˉwebassemblyˉuleb32(1u32);
    Memoryˉpayload = Bytesˉconcat(Memoryˉpayload, Compilerˉwebassemblyˉuleb32(1u32));
    Memoryˉpayload = Bytesˉconcat(Memoryˉpayload, Compilerˉwebassemblyˉuleb32(129u32));
    Memoryˉpayload = Bytesˉconcat(Memoryˉpayload, Compilerˉwebassemblyˉuleb32(129u32));

    var Globalˉpayload: bytes = Compilerˉwebassemblyˉuleb32(8u32);
    Globalˉpayload = Bytesˉconcat(Globalˉpayload, Compilerˉwebassemblyˉglobalˉi32(0u32, 3));
    Globalˉpayload = Bytesˉconcat(Globalˉpayload, Compilerˉwebassemblyˉglobalˉi32(0u32, 65536));
    Globalˉpayload = Bytesˉconcat(Globalˉpayload, Compilerˉwebassemblyˉglobalˉi32(0u32, 4194304));
    Globalˉpayload = Bytesˉconcat(Globalˉpayload, Compilerˉwebassemblyˉglobalˉi32(0u32, 4259840));
    Globalˉpayload = Bytesˉconcat(Globalˉpayload, Compilerˉwebassemblyˉglobalˉi32(0u32, 4194304));
    Globalˉpayload = Bytesˉconcat(Globalˉpayload, Compilerˉwebassemblyˉglobalˉi32(1u32, 0));
    Globalˉpayload = Bytesˉconcat(Globalˉpayload, Compilerˉwebassemblyˉglobalˉi32(0u32, 1));
    Globalˉpayload = Bytesˉconcat(Globalˉpayload, Compilerˉwebassemblyˉglobalˉi32(1u32, 0));

    var Exportˉpayload: bytes = Compilerˉwebassemblyˉuleb32(10u32);
    Exportˉpayload = Bytesˉconcat(Exportˉpayload, Compilerˉwebassemblyˉexportˉentry(Textˉtoˉutf8("Windvale.run"), 0u32, 0u32));
    Exportˉpayload = Bytesˉconcat(Exportˉpayload, Compilerˉwebassemblyˉexportˉentry(Textˉtoˉutf8("Windvale.abi"), 3u32, 0u32));
    Exportˉpayload = Bytesˉconcat(Exportˉpayload, Compilerˉwebassemblyˉexportˉentry(Textˉtoˉutf8("Windvale.memory"), 2u32, 0u32));
    Exportˉpayload = Bytesˉconcat(Exportˉpayload, Compilerˉwebassemblyˉexportˉentry(Textˉtoˉutf8("Windvale.input_offset"), 3u32, 1u32));
    Exportˉpayload = Bytesˉconcat(Exportˉpayload, Compilerˉwebassemblyˉexportˉentry(Textˉtoˉutf8("Windvale.input_capacity"), 3u32, 2u32));
    Exportˉpayload = Bytesˉconcat(Exportˉpayload, Compilerˉwebassemblyˉexportˉentry(Textˉtoˉutf8("Windvale.output_offset"), 3u32, 3u32));
    Exportˉpayload = Bytesˉconcat(Exportˉpayload, Compilerˉwebassemblyˉexportˉentry(Textˉtoˉutf8("Windvale.output_capacity"), 3u32, 4u32));
    Exportˉpayload = Bytesˉconcat(Exportˉpayload, Compilerˉwebassemblyˉexportˉentry(Textˉtoˉutf8("Windvale.output_length"), 3u32, 5u32));
    Exportˉpayload = Bytesˉconcat(Exportˉpayload, Compilerˉwebassemblyˉexportˉentry(Textˉtoˉutf8("Windvale.output_kind"), 3u32, 6u32));
    Exportˉpayload = Bytesˉconcat(Exportˉpayload, Compilerˉwebassemblyˉexportˉentry(Textˉtoˉutf8("Windvale.instructions"), 3u32, 7u32));

    var Wrapper: bytes = Compilerˉwebassemblyˉencodeˉruntimeˉwrapper(
        Input, Codeˉoffset, Function
    );
    if Function.Hasˉcontrol {
        Wrapper = Compilerˉwebassemblyˉencodeˉruntimeˉcontrolˉwrapper(
            Input, Codeˉoffset, Function
        );
    }
    var Codeˉpayload: bytes = Compilerˉwebassemblyˉuleb32(1u32);
    Codeˉpayload = Bytesˉconcat(
        Codeˉpayload,
        Compilerˉwebassemblyˉuleb32(Bytesˉlength(Wrapper))
    );
    Codeˉpayload = Bytesˉconcat(Codeˉpayload, Wrapper);

    var Result: bytes = Compilerˉwebassemblyˉbyte(0u32);
    Result = Bytesˉconcat(Result, Textˉtoˉutf8("asm"));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(1u32));
    Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉsectionˉbytes(1u32, Typeˉpayload));
    Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉsectionˉbytes(3u32, Functionˉpayload));
    Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉsectionˉbytes(5u32, Memoryˉpayload));
    Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉsectionˉbytes(6u32, Globalˉpayload));
    Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉsectionˉbytes(7u32, Exportˉpayload));
    return Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉsectionˉbytes(10u32, Codeˉpayload)
    );
}

export fn Compilerˉwebassemblyˉencodeˉconstant(
    Input: bytes,
    Constantˉoffset: u32
) -> bytes {
    var Typeˉpayload: bytes = Compilerˉwebassemblyˉuleb32(1u32);
    Typeˉpayload = Bytesˉconcat(Typeˉpayload, Compilerˉwebassemblyˉbyte(96u32));
    Typeˉpayload = Bytesˉconcat(Typeˉpayload, Compilerˉwebassemblyˉuleb32(0u32));
    Typeˉpayload = Bytesˉconcat(Typeˉpayload, Compilerˉwebassemblyˉuleb32(1u32));
    Typeˉpayload = Bytesˉconcat(Typeˉpayload, Compilerˉwebassemblyˉbyte(127u32));

    var Functionˉpayload: bytes = Compilerˉwebassemblyˉuleb32(1u32);
    Functionˉpayload = Bytesˉconcat(
        Functionˉpayload,
        Compilerˉwebassemblyˉuleb32(0u32)
    );

    var Exportˉpayload: bytes = Compilerˉwebassemblyˉuleb32(1u32);
    Exportˉpayload = Bytesˉconcat(
        Exportˉpayload,
        Compilerˉwebassemblyˉstring(Compilerˉwebassemblyˉmainˉname())
    );
    Exportˉpayload = Bytesˉconcat(
        Exportˉpayload,
        Compilerˉwebassemblyˉbyte(0u32)
    );
    Exportˉpayload = Bytesˉconcat(
        Exportˉpayload,
        Compilerˉwebassemblyˉuleb32(0u32)
    );

    var Body: bytes = Compilerˉwebassemblyˉuleb32(0u32);
    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(65u32));
    Body = Bytesˉconcat(
        Body,
        Compilerˉwebassemblyˉsleb32(Input, Constantˉoffset)
    );
    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(11u32));
    var Codeˉpayload: bytes = Compilerˉwebassemblyˉuleb32(1u32);
    Codeˉpayload = Bytesˉconcat(
        Codeˉpayload,
        Compilerˉwebassemblyˉuleb32(Bytesˉlength(Body))
    );
    Codeˉpayload = Bytesˉconcat(Codeˉpayload, Body);

    var Result: bytes = Compilerˉwebassemblyˉbyte(0u32);
    Result = Bytesˉconcat(Result, Textˉtoˉutf8("asm"));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(1u32));
    Result = Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉsectionˉbytes(1u32, Typeˉpayload)
    );
    Result = Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉsectionˉbytes(3u32, Functionˉpayload)
    );
    Result = Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉsectionˉbytes(7u32, Exportˉpayload)
    );
    return Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉsectionˉbytes(10u32, Codeˉpayload)
    );
}

export fn Compilerˉwebassemblyˉencodeˉcheckedˉadd(
    Input: bytes,
    Leftˉoffset: u32,
    Rightˉoffset: u32
) -> bytes {
    var Typeˉpayload: bytes = Compilerˉwebassemblyˉuleb32(1u32);
    Typeˉpayload = Bytesˉconcat(Typeˉpayload, Compilerˉwebassemblyˉbyte(96u32));
    Typeˉpayload = Bytesˉconcat(Typeˉpayload, Compilerˉwebassemblyˉuleb32(0u32));
    Typeˉpayload = Bytesˉconcat(Typeˉpayload, Compilerˉwebassemblyˉuleb32(1u32));
    Typeˉpayload = Bytesˉconcat(Typeˉpayload, Compilerˉwebassemblyˉbyte(127u32));

    var Functionˉpayload: bytes = Compilerˉwebassemblyˉuleb32(1u32);
    Functionˉpayload = Bytesˉconcat(
        Functionˉpayload,
        Compilerˉwebassemblyˉuleb32(0u32)
    );

    var Globalˉpayload: bytes = Compilerˉwebassemblyˉuleb32(3u32);
    Globalˉpayload = Bytesˉconcat(
        Globalˉpayload,
        Compilerˉwebassemblyˉglobalˉi32(0u32, 1)
    );
    Globalˉpayload = Bytesˉconcat(
        Globalˉpayload,
        Compilerˉwebassemblyˉglobalˉi32(1u32, 0)
    );
    Globalˉpayload = Bytesˉconcat(
        Globalˉpayload,
        Compilerˉwebassemblyˉglobalˉi32(1u32, 0)
    );

    var Exportˉpayload: bytes = Compilerˉwebassemblyˉuleb32(4u32);
    Exportˉpayload = Bytesˉconcat(
        Exportˉpayload,
        Compilerˉwebassemblyˉexportˉentry(
            Textˉtoˉutf8("Windvale.run"),
            0u32,
            0u32
        )
    );
    Exportˉpayload = Bytesˉconcat(
        Exportˉpayload,
        Compilerˉwebassemblyˉexportˉentry(
            Textˉtoˉutf8("Windvale.abi"),
            3u32,
            0u32
        )
    );
    Exportˉpayload = Bytesˉconcat(
        Exportˉpayload,
        Compilerˉwebassemblyˉexportˉentry(
            Textˉtoˉutf8("Windvale.result"),
            3u32,
            1u32
        )
    );
    Exportˉpayload = Bytesˉconcat(
        Exportˉpayload,
        Compilerˉwebassemblyˉexportˉentry(
            Textˉtoˉutf8("Windvale.instructions"),
            3u32,
            2u32
        )
    );

    var Body: bytes = Compilerˉwebassemblyˉuleb32(1u32);
    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉuleb32(1u32));
    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(127u32));

    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉi32ˉconstant(0));
    Body = Bytesˉconcat(
        Body,
        Compilerˉwebassemblyˉindexedˉinstruction(36u32, 1u32)
    );
    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉi32ˉconstant(0));
    Body = Bytesˉconcat(
        Body,
        Compilerˉwebassemblyˉindexedˉinstruction(36u32, 2u32)
    );

    Body = Bytesˉconcat(
        Body,
        Compilerˉwebassemblyˉi32ˉconstantˉfromˉinput(Input, Leftˉoffset)
    );
    Body = Bytesˉconcat(
        Body,
        Compilerˉwebassemblyˉi32ˉconstantˉfromˉinput(Input, Rightˉoffset)
    );
    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(106u32));
    Body = Bytesˉconcat(
        Body,
        Compilerˉwebassemblyˉindexedˉinstruction(34u32, 0u32)
    );

    Body = Bytesˉconcat(
        Body,
        Compilerˉwebassemblyˉi32ˉconstantˉfromˉinput(Input, Leftˉoffset)
    );
    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(115u32));
    Body = Bytesˉconcat(
        Body,
        Compilerˉwebassemblyˉindexedˉinstruction(32u32, 0u32)
    );
    Body = Bytesˉconcat(
        Body,
        Compilerˉwebassemblyˉi32ˉconstantˉfromˉinput(Input, Rightˉoffset)
    );
    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(115u32));
    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(113u32));
    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉi32ˉconstant(0));
    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(72u32));
    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(4u32));
    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(64u32));

    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉi32ˉconstant(7));
    Body = Bytesˉconcat(
        Body,
        Compilerˉwebassemblyˉindexedˉinstruction(36u32, 2u32)
    );
    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉi32ˉconstant(3007));
    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(15u32));
    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(11u32));

    Body = Bytesˉconcat(
        Body,
        Compilerˉwebassemblyˉindexedˉinstruction(32u32, 0u32)
    );
    Body = Bytesˉconcat(
        Body,
        Compilerˉwebassemblyˉindexedˉinstruction(36u32, 1u32)
    );
    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉi32ˉconstant(10));
    Body = Bytesˉconcat(
        Body,
        Compilerˉwebassemblyˉindexedˉinstruction(36u32, 2u32)
    );
    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉi32ˉconstant(0));
    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(11u32));

    var Codeˉpayload: bytes = Compilerˉwebassemblyˉuleb32(1u32);
    Codeˉpayload = Bytesˉconcat(
        Codeˉpayload,
        Compilerˉwebassemblyˉuleb32(Bytesˉlength(Body))
    );
    Codeˉpayload = Bytesˉconcat(Codeˉpayload, Body);

    var Result: bytes = Compilerˉwebassemblyˉbyte(0u32);
    Result = Bytesˉconcat(Result, Textˉtoˉutf8("asm"));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(1u32));
    Result = Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉsectionˉbytes(1u32, Typeˉpayload)
    );
    Result = Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉsectionˉbytes(3u32, Functionˉpayload)
    );
    Result = Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉsectionˉbytes(6u32, Globalˉpayload)
    );
    Result = Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉsectionˉbytes(7u32, Exportˉpayload)
    );
    return Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉsectionˉbytes(10u32, Codeˉpayload)
    );
}

export fn Compilerˉwebassemblyˉencodeˉexecutionˉbody(Body: bytes) -> bytes {
    var Typeˉpayload: bytes = Compilerˉwebassemblyˉuleb32(1u32);
    Typeˉpayload = Bytesˉconcat(Typeˉpayload, Compilerˉwebassemblyˉbyte(96u32));
    Typeˉpayload = Bytesˉconcat(Typeˉpayload, Compilerˉwebassemblyˉuleb32(0u32));
    Typeˉpayload = Bytesˉconcat(Typeˉpayload, Compilerˉwebassemblyˉuleb32(1u32));
    Typeˉpayload = Bytesˉconcat(Typeˉpayload, Compilerˉwebassemblyˉbyte(127u32));

    var Functionˉpayload: bytes = Compilerˉwebassemblyˉuleb32(1u32);
    Functionˉpayload = Bytesˉconcat(Functionˉpayload, Compilerˉwebassemblyˉuleb32(0u32));

    var Globalˉpayload: bytes = Compilerˉwebassemblyˉuleb32(3u32);
    Globalˉpayload = Bytesˉconcat(Globalˉpayload, Compilerˉwebassemblyˉglobalˉi32(0u32, 1));
    Globalˉpayload = Bytesˉconcat(Globalˉpayload, Compilerˉwebassemblyˉglobalˉi32(1u32, 0));
    Globalˉpayload = Bytesˉconcat(Globalˉpayload, Compilerˉwebassemblyˉglobalˉi32(1u32, 0));

    var Exportˉpayload: bytes = Compilerˉwebassemblyˉuleb32(4u32);
    Exportˉpayload = Bytesˉconcat(
        Exportˉpayload,
        Compilerˉwebassemblyˉexportˉentry(Textˉtoˉutf8("Windvale.run"), 0u32, 0u32)
    );
    Exportˉpayload = Bytesˉconcat(
        Exportˉpayload,
        Compilerˉwebassemblyˉexportˉentry(Textˉtoˉutf8("Windvale.abi"), 3u32, 0u32)
    );
    Exportˉpayload = Bytesˉconcat(
        Exportˉpayload,
        Compilerˉwebassemblyˉexportˉentry(Textˉtoˉutf8("Windvale.result"), 3u32, 1u32)
    );
    Exportˉpayload = Bytesˉconcat(
        Exportˉpayload,
        Compilerˉwebassemblyˉexportˉentry(Textˉtoˉutf8("Windvale.instructions"), 3u32, 2u32)
    );

    var Codeˉpayload: bytes = Compilerˉwebassemblyˉuleb32(1u32);
    Codeˉpayload = Bytesˉconcat(
        Codeˉpayload,
        Compilerˉwebassemblyˉuleb32(Bytesˉlength(Body))
    );
    Codeˉpayload = Bytesˉconcat(Codeˉpayload, Body);

    var Result: bytes = Compilerˉwebassemblyˉbyte(0u32);
    Result = Bytesˉconcat(Result, Textˉtoˉutf8("asm"));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(1u32));
    Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉsectionˉbytes(1u32, Typeˉpayload));
    Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉsectionˉbytes(3u32, Functionˉpayload));
    Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉsectionˉbytes(6u32, Globalˉpayload));
    Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉsectionˉbytes(7u32, Exportˉpayload));
    return Bytesˉconcat(Result, Compilerˉwebassemblyˉsectionˉbytes(10u32, Codeˉpayload));
}

export fn Compilerˉwebassemblyˉencodeˉmeteredˉexecutionˉbody(
    Body: bytes
) -> bytes {
    var Typeˉpayload: bytes = Compilerˉwebassemblyˉuleb32(1u32);
    Typeˉpayload = Bytesˉconcat(Typeˉpayload, Compilerˉwebassemblyˉbyte(96u32));
    Typeˉpayload = Bytesˉconcat(Typeˉpayload, Compilerˉwebassemblyˉuleb32(1u32));
    Typeˉpayload = Bytesˉconcat(Typeˉpayload, Compilerˉwebassemblyˉbyte(127u32));
    Typeˉpayload = Bytesˉconcat(Typeˉpayload, Compilerˉwebassemblyˉuleb32(1u32));
    Typeˉpayload = Bytesˉconcat(Typeˉpayload, Compilerˉwebassemblyˉbyte(127u32));

    var Functionˉpayload: bytes = Compilerˉwebassemblyˉuleb32(1u32);
    Functionˉpayload = Bytesˉconcat(Functionˉpayload, Compilerˉwebassemblyˉuleb32(0u32));

    var Globalˉpayload: bytes = Compilerˉwebassemblyˉuleb32(3u32);
    Globalˉpayload = Bytesˉconcat(Globalˉpayload, Compilerˉwebassemblyˉglobalˉi32(0u32, 2));
    Globalˉpayload = Bytesˉconcat(Globalˉpayload, Compilerˉwebassemblyˉglobalˉi32(1u32, 0));
    Globalˉpayload = Bytesˉconcat(Globalˉpayload, Compilerˉwebassemblyˉglobalˉi32(1u32, 0));

    var Exportˉpayload: bytes = Compilerˉwebassemblyˉuleb32(4u32);
    Exportˉpayload = Bytesˉconcat(
        Exportˉpayload,
        Compilerˉwebassemblyˉexportˉentry(Textˉtoˉutf8("Windvale.run"), 0u32, 0u32)
    );
    Exportˉpayload = Bytesˉconcat(
        Exportˉpayload,
        Compilerˉwebassemblyˉexportˉentry(Textˉtoˉutf8("Windvale.abi"), 3u32, 0u32)
    );
    Exportˉpayload = Bytesˉconcat(
        Exportˉpayload,
        Compilerˉwebassemblyˉexportˉentry(Textˉtoˉutf8("Windvale.result"), 3u32, 1u32)
    );
    Exportˉpayload = Bytesˉconcat(
        Exportˉpayload,
        Compilerˉwebassemblyˉexportˉentry(Textˉtoˉutf8("Windvale.instructions"), 3u32, 2u32)
    );

    var Codeˉpayload: bytes = Compilerˉwebassemblyˉuleb32(1u32);
    Codeˉpayload = Bytesˉconcat(
        Codeˉpayload,
        Compilerˉwebassemblyˉuleb32(Bytesˉlength(Body))
    );
    Codeˉpayload = Bytesˉconcat(Codeˉpayload, Body);

    var Result: bytes = Compilerˉwebassemblyˉbyte(0u32);
    Result = Bytesˉconcat(Result, Textˉtoˉutf8("asm"));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(1u32));
    Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉsectionˉbytes(1u32, Typeˉpayload));
    Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉsectionˉbytes(3u32, Functionˉpayload));
    Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉsectionˉbytes(6u32, Globalˉpayload));
    Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉsectionˉbytes(7u32, Exportˉpayload));
    return Bytesˉconcat(Result, Compilerˉwebassemblyˉsectionˉbytes(10u32, Codeˉpayload));
}

export fn Compilerˉwebassemblyˉencodeˉstraightˉi32(
    Input: bytes,
    Codeˉoffset: u32,
    Codeˉlength: u32,
    Localˉcount: u32
) -> bytes {
    let Scratchˉleft: u32 = Localˉcount;
    let Scratchˉright: u32 = Localˉcount + 1u32;
    let Scratchˉresult: u32 = Localˉcount + 2u32;
    let Scratchˉwide: u32 = Localˉcount + 3u32;

    var Body: bytes = Compilerˉwebassemblyˉuleb32(2u32);
    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉuleb32(Localˉcount + 3u32));
    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(127u32));
    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉuleb32(1u32));
    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(126u32));
    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉi32ˉconstant(0));
    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉindexedˉinstruction(36u32, 1u32));
    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉi32ˉconstant(0));
    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉindexedˉinstruction(36u32, 2u32));

    var Cursor: u32 = 0u32;
    var Step: u32 = 0u32;
    while Cursor < Codeˉlength {
        Step = Step + 1u32;
        Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉchargeˉinstruction(Step));
        let Opcode: u8 = Bytesˉreadˉu8(Input, Codeˉoffset + Cursor);
        if Opcode == 1u8 {
            Body = Bytesˉconcat(
                Body,
                Compilerˉwebassemblyˉi32ˉconstantˉfromˉinput(
                    Input,
                    Codeˉoffset + Cursor + 1u32
                )
            );
            Cursor = Cursor + 5u32;
        }
        if Opcode == 4u8 {
            Body = Bytesˉconcat(
                Body,
                Compilerˉwebassemblyˉindexedˉinstruction(
                    32u32,
                    Bytesˉreadˉu32ˉlittle(Input, Codeˉoffset + Cursor + 1u32)
                )
            );
            Cursor = Cursor + 5u32;
        }
        if Opcode == 5u8 {
            Body = Bytesˉconcat(
                Body,
                Compilerˉwebassemblyˉindexedˉinstruction(
                    33u32,
                    Bytesˉreadˉu32ˉlittle(Input, Codeˉoffset + Cursor + 1u32)
                )
            );
            Cursor = Cursor + 5u32;
        }
        if Opcode == 16u8 {
            Body = Bytesˉconcat(
                Body,
                Compilerˉwebassemblyˉcheckedˉaddˉinstructions(
                    Scratchˉleft,
                    Scratchˉright,
                    Scratchˉresult
                )
            );
            Cursor = Cursor + 1u32;
        }
        if Opcode == 17u8 {
            Body = Bytesˉconcat(
                Body,
                Compilerˉwebassemblyˉcheckedˉsubtractˉinstructions(
                    Scratchˉleft,
                    Scratchˉright,
                    Scratchˉresult
                )
            );
            Cursor = Cursor + 1u32;
        }
        if Opcode == 18u8 {
            Body = Bytesˉconcat(
                Body,
                Compilerˉwebassemblyˉcheckedˉmultiplyˉinstructions(
                    Scratchˉleft,
                    Scratchˉright,
                    Scratchˉresult,
                    Scratchˉwide
                )
            );
            Cursor = Cursor + 1u32;
        }
        if Opcode == 19u8 {
            Body = Bytesˉconcat(
                Body,
                Compilerˉwebassemblyˉcheckedˉnegateˉinstructions(Scratchˉleft)
            );
            Cursor = Cursor + 1u32;
        }
        if Opcode == 80u8 {
            Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(26u32));
            Cursor = Cursor + 1u32;
        }
        if Opcode == 81u8 {
            Body = Bytesˉconcat(
                Body,
                Compilerˉwebassemblyˉindexedˉinstruction(36u32, 1u32)
            );
            Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉi32ˉconstant(0));
            Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(15u32));
            Cursor = Cursor + 1u32;
        }
    }
    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(11u32));
    return Compilerˉwebassemblyˉencodeˉexecutionˉbody(Body);
}

export fn Compilerˉwebassemblyˉencodeˉmeteredˉloop(
    Input: bytes,
    Codeˉoffset: u32,
    Codeˉlength: u32,
    Localˉcount: u32,
    Loopˉheader: u32
) -> bytes {
    let Scratchˉleft: u32 = Localˉcount + 1u32;
    let Scratchˉright: u32 = Localˉcount + 2u32;
    let Scratchˉresult: u32 = Localˉcount + 3u32;
    let Scratchˉwide: u32 = Localˉcount + 4u32;

    var Body: bytes = Compilerˉwebassemblyˉuleb32(2u32);
    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉuleb32(Localˉcount + 3u32));
    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(127u32));
    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉuleb32(1u32));
    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(126u32));
    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉi32ˉconstant(0));
    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉindexedˉinstruction(36u32, 1u32));
    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉi32ˉconstant(0));
    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉindexedˉinstruction(36u32, 2u32));

    var Cursor: u32 = 0u32;
    while Cursor < Codeˉlength {
        if Cursor == Loopˉheader {
            Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(2u32));
            Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(64u32));
            Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(3u32));
            Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(64u32));
        }
        Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉmeterˉinstruction());
        let Opcode: u8 = Bytesˉreadˉu8(Input, Codeˉoffset + Cursor);
        if Opcode == 1u8 {
            Body = Bytesˉconcat(
                Body,
                Compilerˉwebassemblyˉi32ˉconstantˉfromˉinput(
                    Input,
                    Codeˉoffset + Cursor + 1u32
                )
            );
            Cursor = Cursor + 5u32;
        }
        if Opcode == 4u8 {
            Body = Bytesˉconcat(
                Body,
                Compilerˉwebassemblyˉindexedˉinstruction(
                    32u32,
                    Bytesˉreadˉu32ˉlittle(Input, Codeˉoffset + Cursor + 1u32) + 1u32
                )
            );
            Cursor = Cursor + 5u32;
        }
        if Opcode == 5u8 {
            Body = Bytesˉconcat(
                Body,
                Compilerˉwebassemblyˉindexedˉinstruction(
                    33u32,
                    Bytesˉreadˉu32ˉlittle(Input, Codeˉoffset + Cursor + 1u32) + 1u32
                )
            );
            Cursor = Cursor + 5u32;
        }
        if Opcode == 16u8 {
            Body = Bytesˉconcat(
                Body,
                Compilerˉwebassemblyˉcheckedˉaddˉinstructions(
                    Scratchˉleft,
                    Scratchˉright,
                    Scratchˉresult
                )
            );
            Cursor = Cursor + 1u32;
        }
        if Opcode == 17u8 {
            Body = Bytesˉconcat(
                Body,
                Compilerˉwebassemblyˉcheckedˉsubtractˉinstructions(
                    Scratchˉleft,
                    Scratchˉright,
                    Scratchˉresult
                )
            );
            Cursor = Cursor + 1u32;
        }
        if Opcode == 18u8 {
            Body = Bytesˉconcat(
                Body,
                Compilerˉwebassemblyˉcheckedˉmultiplyˉinstructions(
                    Scratchˉleft,
                    Scratchˉright,
                    Scratchˉresult,
                    Scratchˉwide
                )
            );
            Cursor = Cursor + 1u32;
        }
        if Opcode == 19u8 {
            Body = Bytesˉconcat(
                Body,
                Compilerˉwebassemblyˉcheckedˉnegateˉinstructions(Scratchˉleft)
            );
            Cursor = Cursor + 1u32;
        }
        var Comparisonˉopcode: u32 = 0u32;
        if Opcode == 32u8 { Comparisonˉopcode = 70u32; }
        if Opcode == 33u8 { Comparisonˉopcode = 71u32; }
        if Opcode == 34u8 { Comparisonˉopcode = 72u32; }
        if Opcode == 35u8 { Comparisonˉopcode = 76u32; }
        if Opcode == 36u8 { Comparisonˉopcode = 74u32; }
        if Opcode == 37u8 { Comparisonˉopcode = 78u32; }
        if Comparisonˉopcode != 0u32 {
            Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(Comparisonˉopcode));
            Cursor = Cursor + 1u32;
        }
        if Opcode == 48u8 {
            let Target: u32 = Bytesˉreadˉu32ˉlittle(Input, Codeˉoffset + Cursor + 1u32);
            if Target < Cursor {
                Body = Bytesˉconcat(
                    Body,
                    Compilerˉwebassemblyˉindexedˉinstruction(12u32, 0u32)
                );
                Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(11u32));
                Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(11u32));
            }
            Cursor = Cursor + 5u32;
        }
        if Opcode == 49u8 {
            Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(69u32));
            Body = Bytesˉconcat(
                Body,
                Compilerˉwebassemblyˉindexedˉinstruction(13u32, 1u32)
            );
            Cursor = Cursor + 5u32;
        }
        if Opcode == 80u8 {
            Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(26u32));
            Cursor = Cursor + 1u32;
        }
        if Opcode == 81u8 {
            Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉindexedˉinstruction(36u32, 1u32));
            Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉi32ˉconstant(0));
            Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(15u32));
            Cursor = Cursor + 1u32;
        }
    }
    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(11u32));
    return Compilerˉwebassemblyˉencodeˉmeteredˉexecutionˉbody(Body);
}

export fn Compilerˉwebassemblyˉencodeˉsequentialˉcontrol(
    Input: bytes,
    Codeˉoffset: u32,
    Codeˉlength: u32,
    Localˉcount: u32
) -> bytes {
    let Scratchˉleft: u32 = Localˉcount + 1u32;
    let Scratchˉright: u32 = Localˉcount + 2u32;
    let Scratchˉresult: u32 = Localˉcount + 3u32;
    let Scratchˉwide: u32 = Localˉcount + 4u32;

    var Body: bytes = Compilerˉwebassemblyˉuleb32(2u32);
    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉuleb32(Localˉcount + 3u32));
    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(127u32));
    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉuleb32(1u32));
    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(126u32));
    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉi32ˉconstant(0));
    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉindexedˉinstruction(36u32, 1u32));
    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉi32ˉconstant(0));
    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉindexedˉinstruction(36u32, 2u32));

    var Cursor: u32 = 0u32;
    var Activeˉkind: u32 = 0u32;
    var Activeˉheader: u32 = Codeˉlength;
    var Activeˉfalse: u32 = Codeˉlength;
    var Activeˉexit: u32 = Codeˉlength;
    while Cursor < Codeˉlength {
        if Activeˉkind == 2u32 {
            if Cursor == Activeˉfalse {
                Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(11u32));
                Activeˉkind = 0u32;
            }
        }
        if Activeˉkind == 3u32 {
            if Cursor == Activeˉexit {
                Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(11u32));
                Activeˉkind = 0u32;
            }
        }
        if Activeˉkind == 0u32 {
            if Compilerˉwebassemblyˉcontrolˉhasˉbackwardˉtarget(
                Input,
                Codeˉoffset,
                Codeˉlength,
                Cursor
            ) {
                Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(2u32));
                Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(64u32));
                Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(3u32));
                Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(64u32));
                Activeˉkind = 1u32;
                Activeˉheader = Cursor;
            }
        }
        Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉmeterˉinstruction());
        let Opcode: u8 = Bytesˉreadˉu8(Input, Codeˉoffset + Cursor);
        if Opcode == 1u8 {
            Body = Bytesˉconcat(
                Body,
                Compilerˉwebassemblyˉi32ˉconstantˉfromˉinput(
                    Input,
                    Codeˉoffset + Cursor + 1u32
                )
            );
            Cursor = Cursor + 5u32;
        }
        if Opcode == 4u8 {
            Body = Bytesˉconcat(
                Body,
                Compilerˉwebassemblyˉindexedˉinstruction(
                    32u32,
                    Bytesˉreadˉu32ˉlittle(Input, Codeˉoffset + Cursor + 1u32) + 1u32
                )
            );
            Cursor = Cursor + 5u32;
        }
        if Opcode == 5u8 {
            Body = Bytesˉconcat(
                Body,
                Compilerˉwebassemblyˉindexedˉinstruction(
                    33u32,
                    Bytesˉreadˉu32ˉlittle(Input, Codeˉoffset + Cursor + 1u32) + 1u32
                )
            );
            Cursor = Cursor + 5u32;
        }
        if Opcode == 16u8 {
            Body = Bytesˉconcat(
                Body,
                Compilerˉwebassemblyˉcheckedˉaddˉinstructions(
                    Scratchˉleft,
                    Scratchˉright,
                    Scratchˉresult
                )
            );
            Cursor = Cursor + 1u32;
        }
        if Opcode == 17u8 {
            Body = Bytesˉconcat(
                Body,
                Compilerˉwebassemblyˉcheckedˉsubtractˉinstructions(
                    Scratchˉleft,
                    Scratchˉright,
                    Scratchˉresult
                )
            );
            Cursor = Cursor + 1u32;
        }
        if Opcode == 18u8 {
            Body = Bytesˉconcat(
                Body,
                Compilerˉwebassemblyˉcheckedˉmultiplyˉinstructions(
                    Scratchˉleft,
                    Scratchˉright,
                    Scratchˉresult,
                    Scratchˉwide
                )
            );
            Cursor = Cursor + 1u32;
        }
        if Opcode == 19u8 {
            Body = Bytesˉconcat(
                Body,
                Compilerˉwebassemblyˉcheckedˉnegateˉinstructions(Scratchˉleft)
            );
            Cursor = Cursor + 1u32;
        }
        var Comparisonˉopcode: u32 = 0u32;
        if Opcode == 32u8 { Comparisonˉopcode = 70u32; }
        if Opcode == 33u8 { Comparisonˉopcode = 71u32; }
        if Opcode == 34u8 { Comparisonˉopcode = 72u32; }
        if Opcode == 35u8 { Comparisonˉopcode = 76u32; }
        if Opcode == 36u8 { Comparisonˉopcode = 74u32; }
        if Opcode == 37u8 { Comparisonˉopcode = 78u32; }
        if Comparisonˉopcode != 0u32 {
            Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(Comparisonˉopcode));
            Cursor = Cursor + 1u32;
        }
        if Opcode == 48u8 {
            let Target: u32 = Bytesˉreadˉu32ˉlittle(Input, Codeˉoffset + Cursor + 1u32);
            if Target < Cursor {
                Body = Bytesˉconcat(
                    Body,
                    Compilerˉwebassemblyˉindexedˉinstruction(12u32, 0u32)
                );
                Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(11u32));
                Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(11u32));
                Activeˉkind = 0u32;
            }
            if Target > Cursor + 5u32 {
                Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(5u32));
            }
            Cursor = Cursor + 5u32;
        }
        if Opcode == 49u8 {
            let Region: Compilerˉwebassemblyˉcontrol =
                Compilerˉwebassemblyˉclassifyˉsequentialˉregion(
                    Input,
                    Codeˉoffset,
                    Codeˉlength,
                    Cursor
                );
            Activeˉkind = Region.Kind;
            Activeˉheader = Region.Header;
            Activeˉfalse = Region.Falseˉtarget;
            Activeˉexit = Region.Exitˉtarget;
            if Region.Kind == 1u32 {
                Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(69u32));
                Body = Bytesˉconcat(
                    Body,
                    Compilerˉwebassemblyˉindexedˉinstruction(13u32, 1u32)
                );
            } else {
                Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(4u32));
                Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(64u32));
            }
            Cursor = Cursor + 5u32;
        }
        if Opcode == 80u8 {
            Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(26u32));
            Cursor = Cursor + 1u32;
        }
        if Opcode == 81u8 {
            Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉindexedˉinstruction(36u32, 1u32));
            Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉi32ˉconstant(0));
            Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(15u32));
            Cursor = Cursor + 1u32;
        }
    }
    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(11u32));
    return Compilerˉwebassemblyˉencodeˉmeteredˉexecutionˉbody(Body);
}

export fn Compilerˉwebassemblyˉencodeˉboundedˉcallˉfunction(
    Input: bytes,
    Codeˉbase: u32,
    Function: Compilerˉwebassemblyˉcallˉfunction
) -> bytes {
    let Scratchˉleft: u32 = Function.Localˉcount;
    let Scratchˉright: u32 = Function.Localˉcount + 1u32;
    let Scratchˉresult: u32 = Function.Localˉcount + 2u32;
    let Scratchˉwide: u32 = Function.Localˉcount + 3u32;

    var Body: bytes = Compilerˉwebassemblyˉuleb32(2u32);
    Body = Bytesˉconcat(
        Body,
        Compilerˉwebassemblyˉuleb32(Function.Nonparameterˉlocalˉcount + 3u32)
    );
    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(127u32));
    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉuleb32(1u32));
    Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(126u32));

    var Cursor: u32 = 0u32;
    var Activeˉkind: u32 = 0u32;
    var Activeˉheader: u32 = Function.Codeˉlength;
    var Activeˉfalse: u32 = Function.Codeˉlength;
    var Activeˉexit: u32 = Function.Codeˉlength;
    while Cursor < Function.Codeˉlength {
        if Activeˉkind == 2u32 {
            if Cursor == Activeˉfalse {
                Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(11u32));
                Activeˉkind = 0u32;
            }
        }
        if Activeˉkind == 3u32 {
            if Cursor == Activeˉexit {
                Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(11u32));
                Activeˉkind = 0u32;
            }
        }
        if Activeˉkind == 0u32 {
            if Compilerˉwebassemblyˉcontrolˉhasˉbackwardˉtarget(
                Input,
                Codeˉbase + Function.Codeˉoffset,
                Function.Codeˉlength,
                Cursor
            ) {
                Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(2u32));
                Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(64u32));
                Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(3u32));
                Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(64u32));
                Activeˉkind = 1u32;
                Activeˉheader = Cursor;
            }
        }
        Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉcallˉmeterˉinstruction());
        let Opcode: u8 = Bytesˉreadˉu8(
            Input,
            Codeˉbase + Function.Codeˉoffset + Cursor
        );
        if Opcode == 1u8 {
            Body = Bytesˉconcat(
                Body,
                Compilerˉwebassemblyˉi32ˉconstantˉfromˉinput(
                    Input,
                    Codeˉbase + Function.Codeˉoffset + Cursor + 1u32
                )
            );
            Cursor = Cursor + 5u32;
        }
        if Opcode == 4u8 {
            Body = Bytesˉconcat(
                Body,
                Compilerˉwebassemblyˉindexedˉinstruction(
                    32u32,
                    Bytesˉreadˉu32ˉlittle(
                        Input,
                        Codeˉbase + Function.Codeˉoffset + Cursor + 1u32
                    )
                )
            );
            Cursor = Cursor + 5u32;
        }
        if Opcode == 5u8 {
            Body = Bytesˉconcat(
                Body,
                Compilerˉwebassemblyˉindexedˉinstruction(
                    33u32,
                    Bytesˉreadˉu32ˉlittle(
                        Input,
                        Codeˉbase + Function.Codeˉoffset + Cursor + 1u32
                    )
                )
            );
            Cursor = Cursor + 5u32;
        }
        if Opcode == 16u8 {
            Body = Bytesˉconcat(
                Body,
                Compilerˉwebassemblyˉcallˉcheckedˉaddˉinstructions(
                    Scratchˉleft,
                    Scratchˉright,
                    Scratchˉresult
                )
            );
            Cursor = Cursor + 1u32;
        }
        if Opcode == 17u8 {
            Body = Bytesˉconcat(
                Body,
                Compilerˉwebassemblyˉcallˉcheckedˉsubtractˉinstructions(
                    Scratchˉleft,
                    Scratchˉright,
                    Scratchˉresult
                )
            );
            Cursor = Cursor + 1u32;
        }
        if Opcode == 18u8 {
            Body = Bytesˉconcat(
                Body,
                Compilerˉwebassemblyˉcallˉcheckedˉmultiplyˉinstructions(
                    Scratchˉleft,
                    Scratchˉright,
                    Scratchˉresult,
                    Scratchˉwide
                )
            );
            Cursor = Cursor + 1u32;
        }
        if Opcode == 19u8 {
            Body = Bytesˉconcat(
                Body,
                Compilerˉwebassemblyˉcallˉcheckedˉnegateˉinstructions(
                    Scratchˉleft
                )
            );
            Cursor = Cursor + 1u32;
        }
        var Comparisonˉopcode: u32 = 0u32;
        if Opcode == 32u8 { Comparisonˉopcode = 70u32; }
        if Opcode == 33u8 { Comparisonˉopcode = 71u32; }
        if Opcode == 34u8 { Comparisonˉopcode = 72u32; }
        if Opcode == 35u8 { Comparisonˉopcode = 76u32; }
        if Opcode == 36u8 { Comparisonˉopcode = 74u32; }
        if Opcode == 37u8 { Comparisonˉopcode = 78u32; }
        if Comparisonˉopcode != 0u32 {
            Body = Bytesˉconcat(
                Body,
                Compilerˉwebassemblyˉbyte(Comparisonˉopcode)
            );
            Cursor = Cursor + 1u32;
        }
        if Opcode == 48u8 {
            let Jumpˉtarget: u32 = Bytesˉreadˉu32ˉlittle(
                Input,
                Codeˉbase + Function.Codeˉoffset + Cursor + 1u32
            );
            if Jumpˉtarget < Cursor {
                Body = Bytesˉconcat(
                    Body,
                    Compilerˉwebassemblyˉindexedˉinstruction(12u32, 0u32)
                );
                Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(11u32));
                Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(11u32));
                Activeˉkind = 0u32;
            }
            if Jumpˉtarget > Cursor + 5u32 {
                Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(5u32));
            }
            Cursor = Cursor + 5u32;
        }
        if Opcode == 49u8 {
            let Region: Compilerˉwebassemblyˉcontrol =
                Compilerˉwebassemblyˉclassifyˉsequentialˉregion(
                    Input,
                    Codeˉbase + Function.Codeˉoffset,
                    Function.Codeˉlength,
                    Cursor
                );
            Activeˉkind = Region.Kind;
            Activeˉheader = Region.Header;
            Activeˉfalse = Region.Falseˉtarget;
            Activeˉexit = Region.Exitˉtarget;
            if Region.Kind == 1u32 {
                Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(69u32));
                Body = Bytesˉconcat(
                    Body,
                    Compilerˉwebassemblyˉindexedˉinstruction(13u32, 1u32)
                );
            } else {
                Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(4u32));
                Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(64u32));
            }
            Cursor = Cursor + 5u32;
        }
        if Opcode == 64u8 {
            let Target: u32 = Bytesˉreadˉu32ˉlittle(
                Input,
                Codeˉbase + Function.Codeˉoffset + Cursor + 1u32
            );
            Body = Bytesˉconcat(
                Body,
                Compilerˉwebassemblyˉindexedˉinstruction(16u32, Target + 1u32)
            );
            Body = Bytesˉconcat(
                Body,
                Compilerˉwebassemblyˉindexedˉinstruction(33u32, Scratchˉleft)
            );
            Body = Bytesˉconcat(
                Body,
                Compilerˉwebassemblyˉindexedˉinstruction(35u32, 4u32)
            );
            Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(4u32));
            Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(64u32));
            Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉi32ˉconstant(0));
            Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(15u32));
            Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(11u32));
            Body = Bytesˉconcat(
                Body,
                Compilerˉwebassemblyˉindexedˉinstruction(32u32, Scratchˉleft)
            );
            Cursor = Cursor + 5u32;
        }
        if Opcode == 80u8 {
            Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(26u32));
            Cursor = Cursor + 1u32;
        }
        if Opcode == 81u8 {
            Body = Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(15u32));
            Cursor = Cursor + 1u32;
        }
    }
    return Bytesˉconcat(Body, Compilerˉwebassemblyˉbyte(11u32));
}

export fn Compilerˉwebassemblyˉencodeˉboundedˉcalls(
    Input: bytes,
    Functions: Compilerˉwebassemblyˉsection,
    Code: Compilerˉwebassemblyˉsection,
    Mainˉindex: u32
) -> bytes {
    let Functionˉcount: u32 =
        Bytesˉreadˉu32ˉlittle(Input, Functions.Payloadˉoffset);

    var Typeˉpayload: bytes =
        Compilerˉwebassemblyˉuleb32(Functionˉcount + 1u32);
    Typeˉpayload = Bytesˉconcat(Typeˉpayload, Compilerˉwebassemblyˉbyte(96u32));
    Typeˉpayload = Bytesˉconcat(Typeˉpayload, Compilerˉwebassemblyˉuleb32(1u32));
    Typeˉpayload = Bytesˉconcat(Typeˉpayload, Compilerˉwebassemblyˉbyte(127u32));
    Typeˉpayload = Bytesˉconcat(Typeˉpayload, Compilerˉwebassemblyˉuleb32(1u32));
    Typeˉpayload = Bytesˉconcat(Typeˉpayload, Compilerˉwebassemblyˉbyte(127u32));

    var Functionˉindex: u32 = 0u32;
    while Functionˉindex < Functionˉcount {
        let Typeˉfunction: Compilerˉwebassemblyˉcallˉfunction =
            Compilerˉwebassemblyˉreadˉcallˉfunction(
                Input,
                Functions,
                Functionˉindex
            );
        Typeˉpayload = Bytesˉconcat(
            Typeˉpayload,
            Compilerˉwebassemblyˉbyte(96u32)
        );
        Typeˉpayload = Bytesˉconcat(
            Typeˉpayload,
            Compilerˉwebassemblyˉuleb32(Typeˉfunction.Parameterˉcount)
        );
        var Parameter: u32 = 0u32;
        while Parameter < Typeˉfunction.Parameterˉcount {
            Typeˉpayload = Bytesˉconcat(
                Typeˉpayload,
                Compilerˉwebassemblyˉbyte(127u32)
            );
            Parameter = Parameter + 1u32;
        }
        Typeˉpayload = Bytesˉconcat(
            Typeˉpayload,
            Compilerˉwebassemblyˉuleb32(1u32)
        );
        Typeˉpayload = Bytesˉconcat(
            Typeˉpayload,
            Compilerˉwebassemblyˉbyte(127u32)
        );
        Functionˉindex = Functionˉindex + 1u32;
    }

    var Functionˉpayload: bytes =
        Compilerˉwebassemblyˉuleb32(Functionˉcount + 1u32);
    Functionˉindex = 0u32;
    while Functionˉindex <= Functionˉcount {
        Functionˉpayload = Bytesˉconcat(
            Functionˉpayload,
            Compilerˉwebassemblyˉuleb32(Functionˉindex)
        );
        Functionˉindex = Functionˉindex + 1u32;
    }

    var Globalˉpayload: bytes = Compilerˉwebassemblyˉuleb32(5u32);
    Globalˉpayload = Bytesˉconcat(
        Globalˉpayload,
        Compilerˉwebassemblyˉglobalˉi32(0u32, 2)
    );
    Globalˉpayload = Bytesˉconcat(
        Globalˉpayload,
        Compilerˉwebassemblyˉglobalˉi32(1u32, 0)
    );
    Globalˉpayload = Bytesˉconcat(
        Globalˉpayload,
        Compilerˉwebassemblyˉglobalˉi32(1u32, 0)
    );
    Globalˉpayload = Bytesˉconcat(
        Globalˉpayload,
        Compilerˉwebassemblyˉglobalˉi32(1u32, 0)
    );
    Globalˉpayload = Bytesˉconcat(
        Globalˉpayload,
        Compilerˉwebassemblyˉglobalˉi32(1u32, 0)
    );

    var Exportˉpayload: bytes = Compilerˉwebassemblyˉuleb32(4u32);
    Exportˉpayload = Bytesˉconcat(
        Exportˉpayload,
        Compilerˉwebassemblyˉexportˉentry(
            Textˉtoˉutf8("Windvale.run"),
            0u32,
            0u32
        )
    );
    Exportˉpayload = Bytesˉconcat(
        Exportˉpayload,
        Compilerˉwebassemblyˉexportˉentry(
            Textˉtoˉutf8("Windvale.abi"),
            3u32,
            0u32
        )
    );
    Exportˉpayload = Bytesˉconcat(
        Exportˉpayload,
        Compilerˉwebassemblyˉexportˉentry(
            Textˉtoˉutf8("Windvale.result"),
            3u32,
            1u32
        )
    );
    Exportˉpayload = Bytesˉconcat(
        Exportˉpayload,
        Compilerˉwebassemblyˉexportˉentry(
            Textˉtoˉutf8("Windvale.instructions"),
            3u32,
            2u32
        )
    );

    var Wrapper: bytes = Compilerˉwebassemblyˉuleb32(1u32);
    Wrapper = Bytesˉconcat(Wrapper, Compilerˉwebassemblyˉuleb32(1u32));
    Wrapper = Bytesˉconcat(Wrapper, Compilerˉwebassemblyˉbyte(127u32));
    Wrapper = Bytesˉconcat(Wrapper, Compilerˉwebassemblyˉi32ˉconstant(0));
    Wrapper = Bytesˉconcat(
        Wrapper,
        Compilerˉwebassemblyˉindexedˉinstruction(36u32, 1u32)
    );
    Wrapper = Bytesˉconcat(Wrapper, Compilerˉwebassemblyˉi32ˉconstant(0));
    Wrapper = Bytesˉconcat(
        Wrapper,
        Compilerˉwebassemblyˉindexedˉinstruction(36u32, 2u32)
    );
    Wrapper = Bytesˉconcat(
        Wrapper,
        Compilerˉwebassemblyˉindexedˉinstruction(32u32, 0u32)
    );
    Wrapper = Bytesˉconcat(
        Wrapper,
        Compilerˉwebassemblyˉindexedˉinstruction(36u32, 3u32)
    );
    Wrapper = Bytesˉconcat(Wrapper, Compilerˉwebassemblyˉi32ˉconstant(0));
    Wrapper = Bytesˉconcat(
        Wrapper,
        Compilerˉwebassemblyˉindexedˉinstruction(36u32, 4u32)
    );
    Wrapper = Bytesˉconcat(
        Wrapper,
        Compilerˉwebassemblyˉindexedˉinstruction(16u32, Mainˉindex + 1u32)
    );
    Wrapper = Bytesˉconcat(
        Wrapper,
        Compilerˉwebassemblyˉindexedˉinstruction(33u32, 1u32)
    );
    Wrapper = Bytesˉconcat(
        Wrapper,
        Compilerˉwebassemblyˉindexedˉinstruction(35u32, 4u32)
    );
    Wrapper = Bytesˉconcat(Wrapper, Compilerˉwebassemblyˉbyte(69u32));
    Wrapper = Bytesˉconcat(Wrapper, Compilerˉwebassemblyˉbyte(4u32));
    Wrapper = Bytesˉconcat(Wrapper, Compilerˉwebassemblyˉbyte(64u32));
    Wrapper = Bytesˉconcat(
        Wrapper,
        Compilerˉwebassemblyˉindexedˉinstruction(32u32, 1u32)
    );
    Wrapper = Bytesˉconcat(
        Wrapper,
        Compilerˉwebassemblyˉindexedˉinstruction(36u32, 1u32)
    );
    Wrapper = Bytesˉconcat(Wrapper, Compilerˉwebassemblyˉbyte(11u32));
    Wrapper = Bytesˉconcat(
        Wrapper,
        Compilerˉwebassemblyˉindexedˉinstruction(35u32, 4u32)
    );
    Wrapper = Bytesˉconcat(Wrapper, Compilerˉwebassemblyˉbyte(11u32));

    var Codeˉpayload: bytes =
        Compilerˉwebassemblyˉuleb32(Functionˉcount + 1u32);
    Codeˉpayload = Bytesˉconcat(
        Codeˉpayload,
        Compilerˉwebassemblyˉuleb32(Bytesˉlength(Wrapper))
    );
    Codeˉpayload = Bytesˉconcat(Codeˉpayload, Wrapper);
    Functionˉindex = 0u32;
    while Functionˉindex < Functionˉcount {
        let Bodyˉfunction: Compilerˉwebassemblyˉcallˉfunction =
            Compilerˉwebassemblyˉreadˉcallˉfunction(
                Input,
                Functions,
                Functionˉindex
            );
        let Body: bytes = Compilerˉwebassemblyˉencodeˉboundedˉcallˉfunction(
            Input,
            Code.Payloadˉoffset,
            Bodyˉfunction
        );
        Codeˉpayload = Bytesˉconcat(
            Codeˉpayload,
            Compilerˉwebassemblyˉuleb32(Bytesˉlength(Body))
        );
        Codeˉpayload = Bytesˉconcat(Codeˉpayload, Body);
        Functionˉindex = Functionˉindex + 1u32;
    }

    var Result: bytes = Compilerˉwebassemblyˉbyte(0u32);
    Result = Bytesˉconcat(Result, Textˉtoˉutf8("asm"));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(1u32));
    Result = Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉsectionˉbytes(1u32, Typeˉpayload)
    );
    Result = Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉsectionˉbytes(3u32, Functionˉpayload)
    );
    Result = Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉsectionˉbytes(6u32, Globalˉpayload)
    );
    Result = Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉsectionˉbytes(7u32, Exportˉpayload)
    );
    return Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉsectionˉbytes(10u32, Codeˉpayload)
    );
}

export fn Compilerˉlowerˉwvbˉwebassembly(
    Input: bytes
) -> Compilerˉwebassemblyˉsummary {
    let Total: u32 = Bytesˉlength(Input);
    if Total > 4194304u32 {
        return Compilerˉwebassemblyˉfailure(
            Input,
            Compilerˉwebassemblyˉstatus.Invalidˉwvb
        );
    }
    if !Compilerˉwebassemblyˉrangeˉisˉvalid(Total, 0u32, 12u32) {
        return Compilerˉwebassemblyˉfailure(
            Input,
            Compilerˉwebassemblyˉstatus.Invalidˉwvb
        );
    }
    if Bytesˉreadˉu8(Input, 0u32) != 87u8 { return Compilerˉwebassemblyˉfailure(Input, Compilerˉwebassemblyˉstatus.Invalidˉwvb); }
    if Bytesˉreadˉu8(Input, 1u32) != 86u8 { return Compilerˉwebassemblyˉfailure(Input, Compilerˉwebassemblyˉstatus.Invalidˉwvb); }
    if Bytesˉreadˉu8(Input, 2u32) != 66u8 { return Compilerˉwebassemblyˉfailure(Input, Compilerˉwebassemblyˉstatus.Invalidˉwvb); }
    if Bytesˉreadˉu8(Input, 3u32) != 49u8 { return Compilerˉwebassemblyˉfailure(Input, Compilerˉwebassemblyˉstatus.Invalidˉwvb); }
    if Bytesˉreadˉu16ˉlittle(Input, 4u32) != 1u32 { return Compilerˉwebassemblyˉfailure(Input, Compilerˉwebassemblyˉstatus.Invalidˉwvb); }
    if Bytesˉreadˉu16ˉlittle(Input, 6u32) != 6u32 { return Compilerˉwebassemblyˉfailure(Input, Compilerˉwebassemblyˉstatus.Invalidˉwvb); }
    if Bytesˉreadˉu32ˉlittle(Input, 8u32) != 7u32 { return Compilerˉwebassemblyˉfailure(Input, Compilerˉwebassemblyˉstatus.Invalidˉwvb); }

    let Module: Compilerˉwebassemblyˉsection =
        Compilerˉwebassemblyˉreadˉsection(Input, 12u32, 1u8);
    if !Module.Valid { return Compilerˉwebassemblyˉfailure(Input, Compilerˉwebassemblyˉstatus.Invalidˉwvb); }
    let Capabilities: Compilerˉwebassemblyˉsection =
        Compilerˉwebassemblyˉreadˉsection(Input, Module.Nextˉoffset, 2u8);
    if !Capabilities.Valid { return Compilerˉwebassemblyˉfailure(Input, Compilerˉwebassemblyˉstatus.Invalidˉwvb); }
    let Data: Compilerˉwebassemblyˉsection =
        Compilerˉwebassemblyˉreadˉsection(Input, Capabilities.Nextˉoffset, 3u8);
    if !Data.Valid { return Compilerˉwebassemblyˉfailure(Input, Compilerˉwebassemblyˉstatus.Invalidˉwvb); }
    let Functions: Compilerˉwebassemblyˉsection =
        Compilerˉwebassemblyˉreadˉsection(Input, Data.Nextˉoffset, 4u8);
    if !Functions.Valid { return Compilerˉwebassemblyˉfailure(Input, Compilerˉwebassemblyˉstatus.Invalidˉwvb); }
    let Code: Compilerˉwebassemblyˉsection =
        Compilerˉwebassemblyˉreadˉsection(Input, Functions.Nextˉoffset, 5u8);
    if !Code.Valid { return Compilerˉwebassemblyˉfailure(Input, Compilerˉwebassemblyˉstatus.Invalidˉwvb); }
    let Exports: Compilerˉwebassemblyˉsection =
        Compilerˉwebassemblyˉreadˉsection(Input, Code.Nextˉoffset, 6u8);
    if !Exports.Valid { return Compilerˉwebassemblyˉfailure(Input, Compilerˉwebassemblyˉstatus.Invalidˉwvb); }
    let Types: Compilerˉwebassemblyˉsection =
        Compilerˉwebassemblyˉreadˉsection(Input, Exports.Nextˉoffset, 7u8);
    if !Types.Valid { return Compilerˉwebassemblyˉfailure(Input, Compilerˉwebassemblyˉstatus.Invalidˉwvb); }
    if Types.Nextˉoffset != Total {
        return Compilerˉwebassemblyˉfailure(Input, Compilerˉwebassemblyˉstatus.Invalidˉwvb);
    }

    if Module.Payloadˉlength < 5u32 {
        return Compilerˉwebassemblyˉfailure(Input, Compilerˉwebassemblyˉstatus.Invalidˉwvb);
    }
    if Bytesˉreadˉu8(Input, Module.Payloadˉoffset) != 1u8 {
        return Compilerˉwebassemblyˉfailure(
            Input,
            Compilerˉwebassemblyˉstatus.Unsupportedˉprofile
        );
    }
    let Moduleˉnameˉlength: u32 = Bytesˉreadˉu32ˉlittle(
        Input,
        Module.Payloadˉoffset + 1u32
    );
    if Moduleˉnameˉlength == 0u32 {
        return Compilerˉwebassemblyˉfailure(Input, Compilerˉwebassemblyˉstatus.Invalidˉwvb);
    }
    if Moduleˉnameˉlength > 255u32 {
        return Compilerˉwebassemblyˉfailure(Input, Compilerˉwebassemblyˉstatus.Invalidˉwvb);
    }
    if Moduleˉnameˉlength != Module.Payloadˉlength - 5u32 {
        return Compilerˉwebassemblyˉfailure(Input, Compilerˉwebassemblyˉstatus.Invalidˉwvb);
    }

    if Capabilities.Payloadˉlength != 4u32 {
        return Compilerˉwebassemblyˉfailure(Input, Compilerˉwebassemblyˉstatus.Unsupportedˉmodule);
    }
    if Bytesˉreadˉu32ˉlittle(Input, Capabilities.Payloadˉoffset) != 0u32 {
        return Compilerˉwebassemblyˉfailure(Input, Compilerˉwebassemblyˉstatus.Unsupportedˉmodule);
    }
    if Data.Payloadˉlength != 4u32 {
        return Compilerˉwebassemblyˉfailure(Input, Compilerˉwebassemblyˉstatus.Unsupportedˉmodule);
    }
    if Bytesˉreadˉu32ˉlittle(Input, Data.Payloadˉoffset) != 0u32 {
        return Compilerˉwebassemblyˉfailure(Input, Compilerˉwebassemblyˉstatus.Unsupportedˉmodule);
    }
    if Types.Payloadˉlength != 4u32 {
        return Compilerˉwebassemblyˉfailure(Input, Compilerˉwebassemblyˉstatus.Unsupportedˉmodule);
    }
    if Bytesˉreadˉu32ˉlittle(Input, Types.Payloadˉoffset) != 0u32 {
        return Compilerˉwebassemblyˉfailure(Input, Compilerˉwebassemblyˉstatus.Unsupportedˉmodule);
    }

    if Functions.Payloadˉlength >= 4u32 {
        let Functionˉcount: u32 =
            Bytesˉreadˉu32ˉlittle(Input, Functions.Payloadˉoffset);
        if Functionˉcount > 1u32 {
            let Mainˉexport: Compilerˉwebassemblyˉexport =
                Compilerˉwebassemblyˉreadˉmainˉexport(Input, Exports);
            if !Mainˉexport.Valid {
                return Compilerˉwebassemblyˉfailure(
                    Input,
                    Compilerˉwebassemblyˉstatus.Unsupportedˉfunction
                );
            }
            let Calls: Compilerˉwebassemblyˉcallˉsummary =
                Compilerˉwebassemblyˉvalidateˉboundedˉcalls(
                    Input,
                    Functions,
                    Code,
                    Mainˉexport.Functionˉindex
                );
            if !Calls.Valid {
                return Compilerˉwebassemblyˉfailure(
                    Input,
                    Compilerˉwebassemblyˉstatus.Unsupportedˉcode
                );
            }
            let Callˉwebassembly: bytes =
                Compilerˉwebassemblyˉencodeˉboundedˉcalls(
                    Input,
                    Functions,
                    Code,
                    Mainˉexport.Functionˉindex
                );
            if Bytesˉlength(Callˉwebassembly) > 65536u32 {
                return Compilerˉwebassemblyˉfailure(
                    Input,
                    Compilerˉwebassemblyˉstatus.Outputˉlimit
                );
            }
            return Compilerˉwebassemblyˉsummary(
                Compilerˉwebassemblyˉstatus.Valid,
                Callˉwebassembly,
                0,
                2u32
            );
        }
    }

    let Memoryˉexport: Compilerˉwebassemblyˉexport =
        Compilerˉwebassemblyˉreadˉmainˉexport(Input, Exports);
    let Memoryˉfunction: Compilerˉwebassemblyˉmemoryˉfunction =
        Compilerˉwebassemblyˉvalidateˉmemoryˉfunction(
            Input,
            Functions,
            Code
        );
    if Memoryˉfunction.Valid {
        if !Memoryˉexport.Valid {
            return Compilerˉwebassemblyˉfailure(
                Input,
                Compilerˉwebassemblyˉstatus.Unsupportedˉfunction
            );
        }
        if Memoryˉexport.Functionˉindex != 0u32 {
            return Compilerˉwebassemblyˉfailure(
                Input,
                Compilerˉwebassemblyˉstatus.Unsupportedˉfunction
            );
        }
        let Memoryˉwebassembly: bytes = Compilerˉwebassemblyˉencodeˉmemory(
            Memoryˉfunction.Kind
        );
        if Bytesˉlength(Memoryˉwebassembly) > 65536u32 {
            return Compilerˉwebassemblyˉfailure(
                Input,
                Compilerˉwebassemblyˉstatus.Outputˉlimit
            );
        }
        return Compilerˉwebassemblyˉsummary(
            Compilerˉwebassemblyˉstatus.Valid,
            Memoryˉwebassembly,
            0,
            3u32
        );
    }

    let Runtimeˉfunction: Compilerˉwebassemblyˉruntimeˉfunction =
        Compilerˉwebassemblyˉvalidateˉruntimeˉfunction(
            Input,
            Functions,
            Code
        );
    if Runtimeˉfunction.Valid {
        if !Memoryˉexport.Valid {
            return Compilerˉwebassemblyˉfailure(
                Input,
                Compilerˉwebassemblyˉstatus.Unsupportedˉfunction
            );
        }
        if Memoryˉexport.Functionˉindex != 0u32 {
            return Compilerˉwebassemblyˉfailure(
                Input,
                Compilerˉwebassemblyˉstatus.Unsupportedˉfunction
            );
        }
        let Runtimeˉwebassembly: bytes =
            Compilerˉwebassemblyˉencodeˉruntime(
                Input,
                Code.Payloadˉoffset,
                Runtimeˉfunction
            );
        if Bytesˉlength(Runtimeˉwebassembly) > 65536u32 {
            return Compilerˉwebassemblyˉfailure(
                Input,
                Compilerˉwebassemblyˉstatus.Outputˉlimit
            );
        }
        return Compilerˉwebassemblyˉsummary(
            Compilerˉwebassemblyˉstatus.Valid,
            Runtimeˉwebassembly,
            0,
            3u32
        );
    }

    let Mainˉfunction: Compilerˉwebassemblyˉfunction =
        Compilerˉwebassemblyˉreadˉmainˉfunction(Input, Functions);
    if !Mainˉfunction.Valid {
        return Compilerˉwebassemblyˉfailure(Input, Compilerˉwebassemblyˉstatus.Unsupportedˉfunction);
    }
    if Mainˉfunction.Codeˉlength != Code.Payloadˉlength {
        return Compilerˉwebassemblyˉfailure(Input, Compilerˉwebassemblyˉstatus.Unsupportedˉfunction);
    }

    let Localˉtypesˉoffset: u32 = Functions.Payloadˉoffset + 21u32;
    var Allˉi32ˉlocals: bool = true;
    var Localˉindex: u32 = 0u32;
    while Localˉindex < Mainˉfunction.Localˉcount {
        if Bytesˉreadˉu8(Input, Localˉtypesˉoffset + Localˉindex) != 1u8 {
            Allˉi32ˉlocals = false;
        }
        Localˉindex = Localˉindex + 1u32;
    }

    var Constantˉmetadata: bool = false;
    if Allˉi32ˉlocals {
        if Mainˉfunction.Localˉcount == 1u32 {
            if Mainˉfunction.Codeˉlength == 16u32 {
                if Mainˉfunction.Maximumˉstack == 1u32 { Constantˉmetadata = true; }
            }
        }
    }
    var Checkedˉaddˉmetadata: bool = false;
    if Allˉi32ˉlocals {
        if Mainˉfunction.Localˉcount == 3u32 {
            if Mainˉfunction.Codeˉlength == 42u32 {
                if Mainˉfunction.Maximumˉstack == 2u32 { Checkedˉaddˉmetadata = true; }
            }
        }
    }

    if Exports.Payloadˉlength != 17u32 {
        return Compilerˉwebassemblyˉfailure(Input, Compilerˉwebassemblyˉstatus.Unsupportedˉfunction);
    }
    let Export: u32 = Exports.Payloadˉoffset;
    if Bytesˉreadˉu32ˉlittle(Input, Export) != 1u32 { return Compilerˉwebassemblyˉfailure(Input, Compilerˉwebassemblyˉstatus.Unsupportedˉfunction); }
    if Bytesˉreadˉu32ˉlittle(Input, Export + 4u32) != 4u32 { return Compilerˉwebassemblyˉfailure(Input, Compilerˉwebassemblyˉstatus.Unsupportedˉfunction); }
    if Bytesˉreadˉu8(Input, Export + 8u32) != 77u8 { return Compilerˉwebassemblyˉfailure(Input, Compilerˉwebassemblyˉstatus.Unsupportedˉfunction); }
    if Bytesˉreadˉu8(Input, Export + 9u32) != 97u8 { return Compilerˉwebassemblyˉfailure(Input, Compilerˉwebassemblyˉstatus.Unsupportedˉfunction); }
    if Bytesˉreadˉu8(Input, Export + 10u32) != 105u8 { return Compilerˉwebassemblyˉfailure(Input, Compilerˉwebassemblyˉstatus.Unsupportedˉfunction); }
    if Bytesˉreadˉu8(Input, Export + 11u32) != 110u8 { return Compilerˉwebassemblyˉfailure(Input, Compilerˉwebassemblyˉstatus.Unsupportedˉfunction); }
    if Bytesˉreadˉu8(Input, Export + 12u32) != 1u8 { return Compilerˉwebassemblyˉfailure(Input, Compilerˉwebassemblyˉstatus.Unsupportedˉfunction); }
    if Bytesˉreadˉu32ˉlittle(Input, Export + 13u32) != 0u32 { return Compilerˉwebassemblyˉfailure(Input, Compilerˉwebassemblyˉstatus.Unsupportedˉfunction); }

    var Webassembly: bytes = Compilerˉwebassemblyˉempty(Input);
    var Resultˉvalue: i32 = 0;
    var Executionˉabi: u32 = 0u32;
    var Constantˉshape: bool = Constantˉmetadata;
    if Constantˉshape {
        if Bytesˉreadˉu8(Input, Code.Payloadˉoffset) != 1u8 { Constantˉshape = false; }
        if Bytesˉreadˉu8(Input, Code.Payloadˉoffset + 5u32) != 5u8 { Constantˉshape = false; }
        if Bytesˉreadˉu32ˉlittle(Input, Code.Payloadˉoffset + 6u32) != 0u32 { Constantˉshape = false; }
        if Bytesˉreadˉu8(Input, Code.Payloadˉoffset + 10u32) != 4u8 { Constantˉshape = false; }
        if Bytesˉreadˉu32ˉlittle(Input, Code.Payloadˉoffset + 11u32) != 0u32 { Constantˉshape = false; }
        if Bytesˉreadˉu8(Input, Code.Payloadˉoffset + 15u32) != 81u8 { Constantˉshape = false; }
    }
    var Checkedˉaddˉshape: bool = Checkedˉaddˉmetadata;
    if Checkedˉaddˉshape {
        if Bytesˉreadˉu8(Input, Code.Payloadˉoffset) != 1u8 { Checkedˉaddˉshape = false; }
        if Bytesˉreadˉu8(Input, Code.Payloadˉoffset + 5u32) != 5u8 { Checkedˉaddˉshape = false; }
        if Bytesˉreadˉu32ˉlittle(Input, Code.Payloadˉoffset + 6u32) != 0u32 { Checkedˉaddˉshape = false; }
        if Bytesˉreadˉu8(Input, Code.Payloadˉoffset + 10u32) != 1u8 { Checkedˉaddˉshape = false; }
        if Bytesˉreadˉu8(Input, Code.Payloadˉoffset + 15u32) != 5u8 { Checkedˉaddˉshape = false; }
        if Bytesˉreadˉu32ˉlittle(Input, Code.Payloadˉoffset + 16u32) != 1u32 { Checkedˉaddˉshape = false; }
        if Bytesˉreadˉu8(Input, Code.Payloadˉoffset + 20u32) != 4u8 { Checkedˉaddˉshape = false; }
        if Bytesˉreadˉu32ˉlittle(Input, Code.Payloadˉoffset + 21u32) != 0u32 { Checkedˉaddˉshape = false; }
        if Bytesˉreadˉu8(Input, Code.Payloadˉoffset + 25u32) != 4u8 { Checkedˉaddˉshape = false; }
        if Bytesˉreadˉu32ˉlittle(Input, Code.Payloadˉoffset + 26u32) != 1u32 { Checkedˉaddˉshape = false; }
        if Bytesˉreadˉu8(Input, Code.Payloadˉoffset + 30u32) != 16u8 { Checkedˉaddˉshape = false; }
        if Bytesˉreadˉu8(Input, Code.Payloadˉoffset + 31u32) != 5u8 { Checkedˉaddˉshape = false; }
        if Bytesˉreadˉu32ˉlittle(Input, Code.Payloadˉoffset + 32u32) != 2u32 { Checkedˉaddˉshape = false; }
        if Bytesˉreadˉu8(Input, Code.Payloadˉoffset + 36u32) != 4u8 { Checkedˉaddˉshape = false; }
        if Bytesˉreadˉu32ˉlittle(Input, Code.Payloadˉoffset + 37u32) != 2u32 { Checkedˉaddˉshape = false; }
        if Bytesˉreadˉu8(Input, Code.Payloadˉoffset + 41u32) != 81u8 { Checkedˉaddˉshape = false; }
    }
    if Constantˉshape {
        Webassembly = Compilerˉwebassemblyˉencodeˉconstant(
            Input,
            Code.Payloadˉoffset + 1u32
        );
        Resultˉvalue = Bytesˉreadˉi32ˉlittle(Input, Code.Payloadˉoffset + 1u32);
    }
    if Checkedˉaddˉshape {
        Webassembly = Compilerˉwebassemblyˉencodeˉcheckedˉadd(
            Input,
            Code.Payloadˉoffset + 1u32,
            Code.Payloadˉoffset + 11u32
        );
        Executionˉabi = 1u32;
    }
    if !Constantˉshape {
        if !Checkedˉaddˉshape {
            var Straightˉcode: Compilerˉwebassemblyˉcode =
                Compilerˉwebassemblyˉcode(false, 0u32, 0u32);
            if Allˉi32ˉlocals {
                Straightˉcode = Compilerˉwebassemblyˉvalidateˉstraightˉi32ˉcode(
                    Input,
                    Code.Payloadˉoffset,
                    Code.Payloadˉlength,
                    Mainˉfunction.Localˉcount,
                    Mainˉfunction.Maximumˉstack
                );
            }
            if Straightˉcode.Valid {
                Webassembly = Compilerˉwebassemblyˉencodeˉstraightˉi32(
                    Input,
                    Code.Payloadˉoffset,
                    Code.Payloadˉlength,
                    Mainˉfunction.Localˉcount
                );
                Executionˉabi = 1u32;
            }
            if !Straightˉcode.Valid {
                let Meteredˉloop: Compilerˉwebassemblyˉloop =
                    Compilerˉwebassemblyˉvalidateˉmeteredˉloop(
                        Input,
                        Code.Payloadˉoffset,
                        Code.Payloadˉlength,
                        Localˉtypesˉoffset,
                        Mainˉfunction.Localˉcount,
                        Mainˉfunction.Maximumˉstack
                    );
                if Meteredˉloop.Valid {
                    Webassembly = Compilerˉwebassemblyˉencodeˉmeteredˉloop(
                        Input,
                        Code.Payloadˉoffset,
                        Code.Payloadˉlength,
                        Mainˉfunction.Localˉcount,
                        Meteredˉloop.Loopˉheader
                    );
                    Executionˉabi = 2u32;
                }
                if !Meteredˉloop.Valid {
                    let Sequentialˉcontrol: Compilerˉwebassemblyˉcode =
                        Compilerˉwebassemblyˉvalidateˉsequentialˉcontrol(
                            Input,
                            Code.Payloadˉoffset,
                            Code.Payloadˉlength,
                            Localˉtypesˉoffset,
                            Mainˉfunction.Localˉcount,
                            Mainˉfunction.Maximumˉstack
                        );
                    if !Sequentialˉcontrol.Valid {
                        return Compilerˉwebassemblyˉfailure(
                            Input,
                            Compilerˉwebassemblyˉstatus.Unsupportedˉcode
                        );
                    }
                    Webassembly = Compilerˉwebassemblyˉencodeˉsequentialˉcontrol(
                        Input,
                        Code.Payloadˉoffset,
                        Code.Payloadˉlength,
                        Mainˉfunction.Localˉcount
                    );
                    Executionˉabi = 2u32;
                }
            }
        }
    }
    if Bytesˉlength(Webassembly) > 65536u32 {
        return Compilerˉwebassemblyˉfailure(
            Input,
            Compilerˉwebassemblyˉstatus.Outputˉlimit
        );
    }
    return Compilerˉwebassemblyˉsummary(
        Compilerˉwebassemblyˉstatus.Valid,
        Webassembly,
        Resultˉvalue,
        Executionˉabi
    );
}
