module Compilerˉwebassembly profile portable;

enum Compilerˉwebassemblyˉstatus {
    Valid = 0;
    Invalidˉwvb = 1;
    Unsupportedˉprofile = 2;
    Unsupportedˉmodule = 3;
    Unsupportedˉfunction = 4;
    Unsupportedˉcode = 5;
    Outputˉlimit = 6;
}

record Compilerˉwebassemblyˉdivision {
    Quotient: u32;
    Remainder: u32;
}

record Compilerˉwebassemblyˉsection {
    Valid: bool;
    Payloadˉoffset: u32;
    Payloadˉlength: u32;
    Nextˉoffset: u32;
}

record Compilerˉwebassemblyˉfunction {
    Valid: bool;
    Localˉcount: u32;
    Codeˉlength: u32;
    Maximumˉstack: u32;
}

record Compilerˉwebassemblyˉcode {
    Valid: bool;
    Instructionˉcount: u32;
    Maximumˉstack: u32;
}

record Compilerˉwebassemblyˉloop {
    Valid: bool;
    Instructionˉcount: u32;
    Maximumˉstack: u32;
    Loopˉheader: u32;
    Exitˉoffset: u32;
}

record Compilerˉwebassemblyˉcontrol {
    Valid: bool;
    Kind: u32;
    Header: u32;
    Falseˉtarget: u32;
    Exitˉtarget: u32;
}

record Compilerˉwebassemblyˉcallˉfunction {
    Valid: bool;
    Isˉmain: bool;
    Nextˉoffset: u32;
    Parameterˉcount: u32;
    Nonparameterˉlocalˉcount: u32;
    Localˉcount: u32;
    Parameterˉtypesˉoffset: u32;
    Localˉtypesˉoffset: u32;
    Codeˉoffset: u32;
    Codeˉlength: u32;
    Maximumˉstack: u32;
}

record Compilerˉwebassemblyˉcallˉcode {
    Valid: bool;
    Instructionˉcount: u32;
    Callˉcount: u32;
}

record Compilerˉwebassemblyˉcallˉsummary {
    Valid: bool;
    Functionˉcount: u32;
    Callˉcount: u32;
    Instructionˉcount: u32;
}

record Compilerˉwebassemblyˉexport {
    Valid: bool;
    Functionˉindex: u32;
}

record Compilerˉwebassemblyˉmemoryˉfunction {
    Valid: bool;
    Kind: u32;
}

record Compilerˉwebassemblyˉruntimeˉstack {
    Valid: bool;
    Depth: u32;
    Maximum: u32;
    First: u8;
    Second: u8;
    Third: u8;
    Fourth: u8;
}

record Compilerˉwebassemblyˉruntimeˉfunction {
    Valid: bool;
    Localˉcount: u32;
    Localˉtypesˉoffset: u32;
    Codeˉlength: u32;
    Maximumˉstack: u32;
    Instructionˉcount: u32;
    Hasˉcontrol: bool;
}

record Compilerˉwebassemblyˉsummary {
    Status: Compilerˉwebassemblyˉstatus;
    Webassembly: bytes;
    Result: i32;
    Executionˉabi: u32;
}

export fn Compilerˉwebassemblyˉempty(Input: bytes) -> bytes {
    return Bytesˉslice(Input, 0u32, 0u32);
}

export fn Compilerˉwebassemblyˉfailure(
    Input: bytes,
    Status: Compilerˉwebassemblyˉstatus
) -> Compilerˉwebassemblyˉsummary {
    return Compilerˉwebassemblyˉsummary(
        Status,
        Compilerˉwebassemblyˉempty(Input),
        0,
        0u32
    );
}

export fn Compilerˉwebassemblyˉrangeˉisˉvalid(
    Total: u32,
    Offset: u32,
    Length: u32
) -> bool {
    if Offset > Total { return false; }
    return Length <= Total - Offset;
}

export fn Compilerˉwebassemblyˉreadˉsection(
    Input: bytes,
    Cursor: u32,
    Kind: u8
) -> Compilerˉwebassemblyˉsection {
    let Total: u32 = Bytesˉlength(Input);
    if !Compilerˉwebassemblyˉrangeˉisˉvalid(Total, Cursor, 8u32) {
        return Compilerˉwebassemblyˉsection(false, 0u32, 0u32, 0u32);
    }
    if Bytesˉreadˉu8(Input, Cursor) != Kind {
        return Compilerˉwebassemblyˉsection(false, 0u32, 0u32, 0u32);
    }
    if Bytesˉreadˉu8(Input, Cursor + 1u32) != 0u8 {
        return Compilerˉwebassemblyˉsection(false, 0u32, 0u32, 0u32);
    }
    if Bytesˉreadˉu16ˉlittle(Input, Cursor + 2u32) != 0u32 {
        return Compilerˉwebassemblyˉsection(false, 0u32, 0u32, 0u32);
    }
    let Payloadˉlength: u32 = Bytesˉreadˉu32ˉlittle(Input, Cursor + 4u32);
    let Payloadˉoffset: u32 = Cursor + 8u32;
    if !Compilerˉwebassemblyˉrangeˉisˉvalid(
        Total,
        Payloadˉoffset,
        Payloadˉlength
    ) {
        return Compilerˉwebassemblyˉsection(false, 0u32, 0u32, 0u32);
    }
    return Compilerˉwebassemblyˉsection(
        true,
        Payloadˉoffset,
        Payloadˉlength,
        Payloadˉoffset + Payloadˉlength
    );
}

export fn Compilerˉwebassemblyˉreadˉmainˉfunction(
    Input: bytes,
    Functions: Compilerˉwebassemblyˉsection
) -> Compilerˉwebassemblyˉfunction {
    if Functions.Payloadˉlength < 33u32 {
        return Compilerˉwebassemblyˉfunction(false, 0u32, 0u32, 0u32);
    }
    let Function: u32 = Functions.Payloadˉoffset;
    if Bytesˉreadˉu32ˉlittle(Input, Function) != 1u32 { return Compilerˉwebassemblyˉfunction(false, 0u32, 0u32, 0u32); }
    if Bytesˉreadˉu32ˉlittle(Input, Function + 4u32) != 4u32 { return Compilerˉwebassemblyˉfunction(false, 0u32, 0u32, 0u32); }
    if Bytesˉreadˉu8(Input, Function + 8u32) != 77u8 { return Compilerˉwebassemblyˉfunction(false, 0u32, 0u32, 0u32); }
    if Bytesˉreadˉu8(Input, Function + 9u32) != 97u8 { return Compilerˉwebassemblyˉfunction(false, 0u32, 0u32, 0u32); }
    if Bytesˉreadˉu8(Input, Function + 10u32) != 105u8 { return Compilerˉwebassemblyˉfunction(false, 0u32, 0u32, 0u32); }
    if Bytesˉreadˉu8(Input, Function + 11u32) != 110u8 { return Compilerˉwebassemblyˉfunction(false, 0u32, 0u32, 0u32); }
    if Bytesˉreadˉu32ˉlittle(Input, Function + 12u32) != 0u32 { return Compilerˉwebassemblyˉfunction(false, 0u32, 0u32, 0u32); }
    if Bytesˉreadˉu8(Input, Function + 16u32) != 1u8 { return Compilerˉwebassemblyˉfunction(false, 0u32, 0u32, 0u32); }

    let Localˉcount: u32 = Bytesˉreadˉu32ˉlittle(Input, Function + 17u32);
    if Localˉcount > 256u32 {
        return Compilerˉwebassemblyˉfunction(false, 0u32, 0u32, 0u32);
    }
    if Functions.Payloadˉlength != 33u32 + Localˉcount {
        return Compilerˉwebassemblyˉfunction(false, 0u32, 0u32, 0u32);
    }
    var Local: u32 = 0u32;
    while Local < Localˉcount {
        let Localˉtype: u8 = Bytesˉreadˉu8(Input, Function + 21u32 + Local);
        if Localˉtype != 1u8 {
            if Localˉtype != 2u8 {
                return Compilerˉwebassemblyˉfunction(false, 0u32, 0u32, 0u32);
            }
        }
        Local = Local + 1u32;
    }

    let Metadata: u32 = Function + 21u32 + Localˉcount;
    if Bytesˉreadˉu32ˉlittle(Input, Metadata) != 0u32 {
        return Compilerˉwebassemblyˉfunction(false, 0u32, 0u32, 0u32);
    }
    let Codeˉlength: u32 = Bytesˉreadˉu32ˉlittle(Input, Metadata + 4u32);
    if Codeˉlength == 0u32 { return Compilerˉwebassemblyˉfunction(false, 0u32, 0u32, 0u32); }
    if Codeˉlength > 16384u32 { return Compilerˉwebassemblyˉfunction(false, 0u32, 0u32, 0u32); }
    let Maximumˉstack: u32 = Bytesˉreadˉu32ˉlittle(Input, Metadata + 8u32);
    if Maximumˉstack == 0u32 { return Compilerˉwebassemblyˉfunction(false, 0u32, 0u32, 0u32); }
    if Maximumˉstack > 256u32 { return Compilerˉwebassemblyˉfunction(false, 0u32, 0u32, 0u32); }
    return Compilerˉwebassemblyˉfunction(
        true,
        Localˉcount,
        Codeˉlength,
        Maximumˉstack
    );
}

export fn Compilerˉwebassemblyˉcallˉfunctionˉfailure()
    -> Compilerˉwebassemblyˉcallˉfunction {
    return Compilerˉwebassemblyˉcallˉfunction(
        false,
        false,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32
    );
}

export fn Compilerˉwebassemblyˉreadˉcallˉfunction(
    Input: bytes,
    Functions: Compilerˉwebassemblyˉsection,
    Index: u32
) -> Compilerˉwebassemblyˉcallˉfunction {
    if Functions.Payloadˉlength < 4u32 {
        return Compilerˉwebassemblyˉcallˉfunctionˉfailure();
    }
    let Count: u32 = Bytesˉreadˉu32ˉlittle(Input, Functions.Payloadˉoffset);
    if Count < 2u32 { return Compilerˉwebassemblyˉcallˉfunctionˉfailure(); }
    if Count > 8u32 { return Compilerˉwebassemblyˉcallˉfunctionˉfailure(); }
    if Index >= Count { return Compilerˉwebassemblyˉcallˉfunctionˉfailure(); }

    let End: u32 = Functions.Payloadˉoffset + Functions.Payloadˉlength;
    var Cursor: u32 = Functions.Payloadˉoffset + 4u32;
    var Current: u32 = 0u32;
    while Current <= Index {
        if !Compilerˉwebassemblyˉrangeˉisˉvalid(End, Cursor, 4u32) {
            return Compilerˉwebassemblyˉcallˉfunctionˉfailure();
        }
        let Nameˉlength: u32 = Bytesˉreadˉu32ˉlittle(Input, Cursor);
        if Nameˉlength == 0u32 {
            return Compilerˉwebassemblyˉcallˉfunctionˉfailure();
        }
        if Nameˉlength > 255u32 {
            return Compilerˉwebassemblyˉcallˉfunctionˉfailure();
        }
        Cursor = Cursor + 4u32;
        if !Compilerˉwebassemblyˉrangeˉisˉvalid(End, Cursor, Nameˉlength) {
            return Compilerˉwebassemblyˉcallˉfunctionˉfailure();
        }
        var Isˉmain: bool = false;
        if Nameˉlength == 4u32 {
            if Bytesˉreadˉu8(Input, Cursor) == 77u8 {
                if Bytesˉreadˉu8(Input, Cursor + 1u32) == 97u8 {
                    if Bytesˉreadˉu8(Input, Cursor + 2u32) == 105u8 {
                        if Bytesˉreadˉu8(Input, Cursor + 3u32) == 110u8 {
                            Isˉmain = true;
                        }
                    }
                }
            }
        }
        Cursor = Cursor + Nameˉlength;
        if !Compilerˉwebassemblyˉrangeˉisˉvalid(End, Cursor, 4u32) {
            return Compilerˉwebassemblyˉcallˉfunctionˉfailure();
        }
        let Parameterˉcount: u32 = Bytesˉreadˉu32ˉlittle(Input, Cursor);
        if Parameterˉcount > 2u32 {
            return Compilerˉwebassemblyˉcallˉfunctionˉfailure();
        }
        Cursor = Cursor + 4u32;
        let Parameterˉtypesˉoffset: u32 = Cursor;
        if !Compilerˉwebassemblyˉrangeˉisˉvalid(End, Cursor, Parameterˉcount) {
            return Compilerˉwebassemblyˉcallˉfunctionˉfailure();
        }
        var Parameter: u32 = 0u32;
        while Parameter < Parameterˉcount {
            if Bytesˉreadˉu8(Input, Cursor + Parameter) != 1u8 {
                return Compilerˉwebassemblyˉcallˉfunctionˉfailure();
            }
            Parameter = Parameter + 1u32;
        }
        Cursor = Cursor + Parameterˉcount;
        if !Compilerˉwebassemblyˉrangeˉisˉvalid(End, Cursor, 5u32) {
            return Compilerˉwebassemblyˉcallˉfunctionˉfailure();
        }
        if Bytesˉreadˉu8(Input, Cursor) != 1u8 {
            return Compilerˉwebassemblyˉcallˉfunctionˉfailure();
        }
        Cursor = Cursor + 1u32;
        let Nonparameterˉlocalˉcount: u32 =
            Bytesˉreadˉu32ˉlittle(Input, Cursor);
        if Nonparameterˉlocalˉcount > 256u32 - Parameterˉcount {
            return Compilerˉwebassemblyˉcallˉfunctionˉfailure();
        }
        Cursor = Cursor + 4u32;
        let Localˉtypesˉoffset: u32 = Cursor;
        if !Compilerˉwebassemblyˉrangeˉisˉvalid(
            End,
            Cursor,
            Nonparameterˉlocalˉcount
        ) {
            return Compilerˉwebassemblyˉcallˉfunctionˉfailure();
        }
        var Local: u32 = 0u32;
        while Local < Nonparameterˉlocalˉcount {
            let Localˉtype: u8 = Bytesˉreadˉu8(Input, Cursor + Local);
            if Localˉtype != 1u8 {
                if Localˉtype != 2u8 {
                    return Compilerˉwebassemblyˉcallˉfunctionˉfailure();
                }
            }
            Local = Local + 1u32;
        }
        Cursor = Cursor + Nonparameterˉlocalˉcount;
        if !Compilerˉwebassemblyˉrangeˉisˉvalid(End, Cursor, 12u32) {
            return Compilerˉwebassemblyˉcallˉfunctionˉfailure();
        }
        let Codeˉoffset: u32 = Bytesˉreadˉu32ˉlittle(Input, Cursor);
        let Codeˉlength: u32 = Bytesˉreadˉu32ˉlittle(Input, Cursor + 4u32);
        let Maximumˉstack: u32 = Bytesˉreadˉu32ˉlittle(Input, Cursor + 8u32);
        if Codeˉlength == 0u32 {
            return Compilerˉwebassemblyˉcallˉfunctionˉfailure();
        }
        if Codeˉlength > 16384u32 {
            return Compilerˉwebassemblyˉcallˉfunctionˉfailure();
        }
        if Maximumˉstack == 0u32 {
            return Compilerˉwebassemblyˉcallˉfunctionˉfailure();
        }
        if Maximumˉstack > 2u32 {
            return Compilerˉwebassemblyˉcallˉfunctionˉfailure();
        }
        Cursor = Cursor + 12u32;
        if Current == Index {
            return Compilerˉwebassemblyˉcallˉfunction(
                true,
                Isˉmain,
                Cursor,
                Parameterˉcount,
                Nonparameterˉlocalˉcount,
                Parameterˉcount + Nonparameterˉlocalˉcount,
                Parameterˉtypesˉoffset,
                Localˉtypesˉoffset,
                Codeˉoffset,
                Codeˉlength,
                Maximumˉstack
            );
        }
        Current = Current + 1u32;
    }
    return Compilerˉwebassemblyˉcallˉfunctionˉfailure();
}

export fn Compilerˉwebassemblyˉcallˉlocalˉtype(
    Input: bytes,
    Function: Compilerˉwebassemblyˉcallˉfunction,
    Index: u32
) -> u8 {
    if Index < Function.Parameterˉcount {
        return Bytesˉreadˉu8(Input, Function.Parameterˉtypesˉoffset + Index);
    }
    return Bytesˉreadˉu8(
        Input,
        Function.Localˉtypesˉoffset + Index - Function.Parameterˉcount
    );
}

export fn Compilerˉwebassemblyˉreadˉmainˉexport(
    Input: bytes,
    Exports: Compilerˉwebassemblyˉsection
) -> Compilerˉwebassemblyˉexport {
    if Exports.Payloadˉlength != 17u32 {
        return Compilerˉwebassemblyˉexport(false, 0u32);
    }
    let Export: u32 = Exports.Payloadˉoffset;
    if Bytesˉreadˉu32ˉlittle(Input, Export) != 1u32 {
        return Compilerˉwebassemblyˉexport(false, 0u32);
    }
    if Bytesˉreadˉu32ˉlittle(Input, Export + 4u32) != 4u32 {
        return Compilerˉwebassemblyˉexport(false, 0u32);
    }
    if Bytesˉreadˉu8(Input, Export + 8u32) != 77u8 {
        return Compilerˉwebassemblyˉexport(false, 0u32);
    }
    if Bytesˉreadˉu8(Input, Export + 9u32) != 97u8 {
        return Compilerˉwebassemblyˉexport(false, 0u32);
    }
    if Bytesˉreadˉu8(Input, Export + 10u32) != 105u8 {
        return Compilerˉwebassemblyˉexport(false, 0u32);
    }
    if Bytesˉreadˉu8(Input, Export + 11u32) != 110u8 {
        return Compilerˉwebassemblyˉexport(false, 0u32);
    }
    if Bytesˉreadˉu8(Input, Export + 12u32) != 1u8 {
        return Compilerˉwebassemblyˉexport(false, 0u32);
    }
    return Compilerˉwebassemblyˉexport(
        true,
        Bytesˉreadˉu32ˉlittle(Input, Export + 13u32)
    );
}

export fn Compilerˉwebassemblyˉvalidateˉmemoryˉfunction(
    Input: bytes,
    Functions: Compilerˉwebassemblyˉsection,
    Code: Compilerˉwebassemblyˉsection
) -> Compilerˉwebassemblyˉmemoryˉfunction {
    if Functions.Payloadˉlength != 35u32 {
        return Compilerˉwebassemblyˉmemoryˉfunction(false, 0u32);
    }
    if Code.Payloadˉlength != 16u32 {
        return Compilerˉwebassemblyˉmemoryˉfunction(false, 0u32);
    }

    let Function: u32 = Functions.Payloadˉoffset;
    if Bytesˉreadˉu32ˉlittle(Input, Function) != 1u32 {
        return Compilerˉwebassemblyˉmemoryˉfunction(false, 0u32);
    }
    if Bytesˉreadˉu32ˉlittle(Input, Function + 4u32) != 4u32 {
        return Compilerˉwebassemblyˉmemoryˉfunction(false, 0u32);
    }
    if Bytesˉreadˉu8(Input, Function + 8u32) != 77u8 {
        return Compilerˉwebassemblyˉmemoryˉfunction(false, 0u32);
    }
    if Bytesˉreadˉu8(Input, Function + 9u32) != 97u8 {
        return Compilerˉwebassemblyˉmemoryˉfunction(false, 0u32);
    }
    if Bytesˉreadˉu8(Input, Function + 10u32) != 105u8 {
        return Compilerˉwebassemblyˉmemoryˉfunction(false, 0u32);
    }
    if Bytesˉreadˉu8(Input, Function + 11u32) != 110u8 {
        return Compilerˉwebassemblyˉmemoryˉfunction(false, 0u32);
    }
    if Bytesˉreadˉu32ˉlittle(Input, Function + 12u32) != 1u32 {
        return Compilerˉwebassemblyˉmemoryˉfunction(false, 0u32);
    }

    let Valueˉtype: u8 = Bytesˉreadˉu8(Input, Function + 16u32);
    var Kind: u32 = 0u32;
    if Valueˉtype == 6u8 { Kind = 1u32; }
    if Valueˉtype == 3u8 { Kind = 2u32; }
    if Kind == 0u32 {
        return Compilerˉwebassemblyˉmemoryˉfunction(false, 0u32);
    }
    if Bytesˉreadˉu8(Input, Function + 17u32) != Valueˉtype {
        return Compilerˉwebassemblyˉmemoryˉfunction(false, 0u32);
    }
    if Bytesˉreadˉu32ˉlittle(Input, Function + 18u32) != 1u32 {
        return Compilerˉwebassemblyˉmemoryˉfunction(false, 0u32);
    }
    if Bytesˉreadˉu8(Input, Function + 22u32) != Valueˉtype {
        return Compilerˉwebassemblyˉmemoryˉfunction(false, 0u32);
    }
    if Bytesˉreadˉu32ˉlittle(Input, Function + 23u32) != 0u32 {
        return Compilerˉwebassemblyˉmemoryˉfunction(false, 0u32);
    }
    if Bytesˉreadˉu32ˉlittle(Input, Function + 27u32) != 16u32 {
        return Compilerˉwebassemblyˉmemoryˉfunction(false, 0u32);
    }
    if Bytesˉreadˉu32ˉlittle(Input, Function + 31u32) != 1u32 {
        return Compilerˉwebassemblyˉmemoryˉfunction(false, 0u32);
    }

    let Body: u32 = Code.Payloadˉoffset;
    if Bytesˉreadˉu8(Input, Body) != 4u8 {
        return Compilerˉwebassemblyˉmemoryˉfunction(false, 0u32);
    }
    if Bytesˉreadˉu32ˉlittle(Input, Body + 1u32) != 0u32 {
        return Compilerˉwebassemblyˉmemoryˉfunction(false, 0u32);
    }
    if Bytesˉreadˉu8(Input, Body + 5u32) != 5u8 {
        return Compilerˉwebassemblyˉmemoryˉfunction(false, 0u32);
    }
    if Bytesˉreadˉu32ˉlittle(Input, Body + 6u32) != 1u32 {
        return Compilerˉwebassemblyˉmemoryˉfunction(false, 0u32);
    }
    if Bytesˉreadˉu8(Input, Body + 10u32) != 4u8 {
        return Compilerˉwebassemblyˉmemoryˉfunction(false, 0u32);
    }
    if Bytesˉreadˉu32ˉlittle(Input, Body + 11u32) != 1u32 {
        return Compilerˉwebassemblyˉmemoryˉfunction(false, 0u32);
    }
    if Bytesˉreadˉu8(Input, Body + 15u32) != 81u8 {
        return Compilerˉwebassemblyˉmemoryˉfunction(false, 0u32);
    }
    return Compilerˉwebassemblyˉmemoryˉfunction(true, Kind);
}

export fn Compilerˉwebassemblyˉruntimeˉstackˉempty()
    -> Compilerˉwebassemblyˉruntimeˉstack {
    return Compilerˉwebassemblyˉruntimeˉstack(
        true, 0u32, 0u32, 0u8, 0u8, 0u8, 0u8
    );
}

export fn Compilerˉwebassemblyˉruntimeˉstackˉfailure()
    -> Compilerˉwebassemblyˉruntimeˉstack {
    return Compilerˉwebassemblyˉruntimeˉstack(
        false, 0u32, 0u32, 0u8, 0u8, 0u8, 0u8
    );
}

export fn Compilerˉwebassemblyˉruntimeˉstackˉtop(
    Stack: Compilerˉwebassemblyˉruntimeˉstack
) -> u8 {
    if Stack.Depth == 1u32 { return Stack.First; }
    if Stack.Depth == 2u32 { return Stack.Second; }
    if Stack.Depth == 3u32 { return Stack.Third; }
    if Stack.Depth == 4u32 { return Stack.Fourth; }
    return 0u8;
}

export fn Compilerˉwebassemblyˉruntimeˉstackˉpush(
    Stack: Compilerˉwebassemblyˉruntimeˉstack,
    Type: u8
) -> Compilerˉwebassemblyˉruntimeˉstack {
    if !Stack.Valid { return Compilerˉwebassemblyˉruntimeˉstackˉfailure(); }
    if Stack.Depth >= 4u32 {
        return Compilerˉwebassemblyˉruntimeˉstackˉfailure();
    }
    var First: u8 = Stack.First;
    var Second: u8 = Stack.Second;
    var Third: u8 = Stack.Third;
    var Fourth: u8 = Stack.Fourth;
    if Stack.Depth == 0u32 { First = Type; }
    if Stack.Depth == 1u32 { Second = Type; }
    if Stack.Depth == 2u32 { Third = Type; }
    if Stack.Depth == 3u32 { Fourth = Type; }
    let Depth: u32 = Stack.Depth + 1u32;
    var Maximum: u32 = Stack.Maximum;
    if Depth > Maximum { Maximum = Depth; }
    return Compilerˉwebassemblyˉruntimeˉstack(
        true, Depth, Maximum, First, Second, Third, Fourth
    );
}

export fn Compilerˉwebassemblyˉruntimeˉstackˉpop(
    Stack: Compilerˉwebassemblyˉruntimeˉstack,
    Type: u8
) -> Compilerˉwebassemblyˉruntimeˉstack {
    if !Stack.Valid { return Compilerˉwebassemblyˉruntimeˉstackˉfailure(); }
    if Stack.Depth == 0u32 {
        return Compilerˉwebassemblyˉruntimeˉstackˉfailure();
    }
    if Compilerˉwebassemblyˉruntimeˉstackˉtop(Stack) != Type {
        return Compilerˉwebassemblyˉruntimeˉstackˉfailure();
    }
    return Compilerˉwebassemblyˉruntimeˉstack(
        true,
        Stack.Depth - 1u32,
        Stack.Maximum,
        Stack.First,
        Stack.Second,
        Stack.Third,
        Stack.Fourth
    );
}

export fn Compilerˉwebassemblyˉruntimeˉstackˉpopˉany(
    Stack: Compilerˉwebassemblyˉruntimeˉstack
) -> Compilerˉwebassemblyˉruntimeˉstack {
    if !Stack.Valid { return Compilerˉwebassemblyˉruntimeˉstackˉfailure(); }
    if Stack.Depth == 0u32 {
        return Compilerˉwebassemblyˉruntimeˉstackˉfailure();
    }
    return Compilerˉwebassemblyˉruntimeˉstack(
        true,
        Stack.Depth - 1u32,
        Stack.Maximum,
        Stack.First,
        Stack.Second,
        Stack.Third,
        Stack.Fourth
    );
}

export fn Compilerˉwebassemblyˉruntimeˉfunctionˉfailure()
    -> Compilerˉwebassemblyˉruntimeˉfunction {
    return Compilerˉwebassemblyˉruntimeˉfunction(
        false, 0u32, 0u32, 0u32, 0u32, 0u32, false
    );
}

export fn Compilerˉwebassemblyˉruntimeˉlocalˉtype(
    Input: bytes,
    Function: Compilerˉwebassemblyˉruntimeˉfunction,
    Index: u32
) -> u8 {
    if Index == 0u32 { return 6u8; }
    return Bytesˉreadˉu8(Input, Function.Localˉtypesˉoffset + Index - 1u32);
}

export fn Compilerˉwebassemblyˉruntimeˉmaskˉmake(Count: u32) -> bytes {
    var Result: bytes = Bytesˉslice(Compilerˉwebassemblyˉbyte(0u32), 0u32, 0u32);
    var Index: u32 = 0u32;
    while Index < Count {
        Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉbyte(0u32));
        Index = Index + 1u32;
    }
    return Result;
}

export fn Compilerˉwebassemblyˉruntimeˉmaskˉset(
    Mask: bytes,
    Index: u32
) -> bytes {
    let Total: u32 = Bytesˉlength(Mask);
    let Before: bytes = Bytesˉslice(Mask, 0u32, Index);
    let After: bytes = Bytesˉslice(Mask, Index + 1u32, Total - Index - 1u32);
    return Bytesˉconcat(
        Bytesˉconcat(Before, Compilerˉwebassemblyˉbyte(1u32)),
        After
    );
}

export fn Compilerˉwebassemblyˉruntimeˉtypeˉisˉsupported(Type: u8) -> bool {
    if Type == 1u8 { return true; }
    if Type == 2u8 { return true; }
    if Type == 4u8 { return true; }
    if Type == 5u8 { return true; }
    return Type == 6u8;
}

export fn Compilerˉwebassemblyˉruntimeˉinstructionˉwidth(
    Input: bytes,
    Offset: u32,
    Length: u32,
    Cursor: u32
) -> u32 {
    if Cursor >= Length { return 0u32; }
    let Opcode: u8 = Bytesˉreadˉu8(Input, Offset + Cursor);
    let Opcodeˉvalue: u32 = U32ˉfromˉu8(Opcode);
    var Width: u32 = 0u32;
    if Opcode == 1u8 { Width = 5u32; }
    if Opcode == 2u8 { Width = 2u32; }
    if Opcode == 4u8 { Width = 5u32; }
    if Opcode == 5u8 { Width = 5u32; }
    if Opcode == 8u8 { Width = 2u32; }
    if Opcode == 9u8 { Width = 5u32; }
    if Opcode == 11u8 { Width = 1u32; }
    if Opcode == 12u8 { Width = 1u32; }
    if Opcode == 13u8 { Width = 1u32; }
    if Opcode == 14u8 { Width = 1u32; }
    if Opcode == 15u8 { Width = 1u32; }
    if Opcode == 20u8 { Width = 1u32; }
    if Opcode == 21u8 { Width = 1u32; }
    if Opcode == 48u8 { Width = 5u32; }
    if Opcode == 49u8 { Width = 5u32; }
    if Opcode == 80u8 { Width = 1u32; }
    if Opcode == 81u8 { Width = 1u32; }
    if Opcodeˉvalue >= 96u32 {
        if Opcodeˉvalue <= 103u32 { Width = 1u32; }
    }
    if Opcode == 114u8 { Width = 1u32; }
    if Opcodeˉvalue >= 118u32 {
        if Opcodeˉvalue <= 123u32 { Width = 1u32; }
    }
    if Width == 0u32 { return 0u32; }
    if !Compilerˉwebassemblyˉrangeˉisˉvalid(Length, Cursor, Width) {
        return 0u32;
    }
    return Width;
}

export fn Compilerˉwebassemblyˉruntimeˉcontrolˉisˉboundary(
    Input: bytes,
    Offset: u32,
    Length: u32,
    Target: u32
) -> bool {
    if Target >= Length { return false; }
    var Cursor: u32 = 0u32;
    while Cursor < Target {
        let Width: u32 = Compilerˉwebassemblyˉruntimeˉinstructionˉwidth(
            Input, Offset, Length, Cursor
        );
        if Width == 0u32 { return false; }
        Cursor = Cursor + Width;
        if Cursor > Target { return false; }
    }
    return Cursor == Target;
}

export fn Compilerˉwebassemblyˉruntimeˉcontrolˉfollowsˉterminator(
    Input: bytes,
    Offset: u32,
    Length: u32,
    Target: u32
) -> bool {
    if Target == 0u32 { return true; }
    var Cursor: u32 = 0u32;
    var Previous: u32 = Length;
    while Cursor < Target {
        Previous = Cursor;
        let Width: u32 = Compilerˉwebassemblyˉruntimeˉinstructionˉwidth(
            Input, Offset, Length, Cursor
        );
        if Width == 0u32 { return false; }
        Cursor = Cursor + Width;
        if Cursor > Target { return false; }
    }
    if Cursor != Target { return false; }
    if Previous == Length { return false; }
    let Opcode: u8 = Bytesˉreadˉu8(Input, Offset + Previous);
    if Opcode == 48u8 { return true; }
    if Opcode == 49u8 { return true; }
    return Opcode == 81u8;
}

export fn Compilerˉwebassemblyˉvalidateˉruntimeˉfunction(
    Input: bytes,
    Functions: Compilerˉwebassemblyˉsection,
    Code: Compilerˉwebassemblyˉsection
) -> Compilerˉwebassemblyˉruntimeˉfunction {
    if Functions.Payloadˉlength < 34u32 {
        return Compilerˉwebassemblyˉruntimeˉfunctionˉfailure();
    }
    let Function: u32 = Functions.Payloadˉoffset;
    if Bytesˉreadˉu32ˉlittle(Input, Function) != 1u32 {
        return Compilerˉwebassemblyˉruntimeˉfunctionˉfailure();
    }
    if Bytesˉreadˉu32ˉlittle(Input, Function + 4u32) != 4u32 {
        return Compilerˉwebassemblyˉruntimeˉfunctionˉfailure();
    }
    if Bytesˉreadˉu8(Input, Function + 8u32) != 77u8 {
        return Compilerˉwebassemblyˉruntimeˉfunctionˉfailure();
    }
    if Bytesˉreadˉu8(Input, Function + 9u32) != 97u8 {
        return Compilerˉwebassemblyˉruntimeˉfunctionˉfailure();
    }
    if Bytesˉreadˉu8(Input, Function + 10u32) != 105u8 {
        return Compilerˉwebassemblyˉruntimeˉfunctionˉfailure();
    }
    if Bytesˉreadˉu8(Input, Function + 11u32) != 110u8 {
        return Compilerˉwebassemblyˉruntimeˉfunctionˉfailure();
    }
    if Bytesˉreadˉu32ˉlittle(Input, Function + 12u32) != 1u32 {
        return Compilerˉwebassemblyˉruntimeˉfunctionˉfailure();
    }
    if Bytesˉreadˉu8(Input, Function + 16u32) != 6u8 {
        return Compilerˉwebassemblyˉruntimeˉfunctionˉfailure();
    }
    if Bytesˉreadˉu8(Input, Function + 17u32) != 6u8 {
        return Compilerˉwebassemblyˉruntimeˉfunctionˉfailure();
    }
    let Nonparameterˉlocals: u32 = Bytesˉreadˉu32ˉlittle(Input, Function + 18u32);
    if Nonparameterˉlocals > 255u32 {
        return Compilerˉwebassemblyˉruntimeˉfunctionˉfailure();
    }
    let Localˉtypesˉoffset: u32 = Function + 22u32;
    if !Compilerˉwebassemblyˉrangeˉisˉvalid(
        Functions.Payloadˉoffset + Functions.Payloadˉlength,
        Localˉtypesˉoffset,
        Nonparameterˉlocals + 12u32
    ) {
        return Compilerˉwebassemblyˉruntimeˉfunctionˉfailure();
    }
    var Local: u32 = 0u32;
    while Local < Nonparameterˉlocals {
        if !Compilerˉwebassemblyˉruntimeˉtypeˉisˉsupported(
            Bytesˉreadˉu8(Input, Localˉtypesˉoffset + Local)
        ) {
            return Compilerˉwebassemblyˉruntimeˉfunctionˉfailure();
        }
        Local = Local + 1u32;
    }
    let Metadata: u32 = Localˉtypesˉoffset + Nonparameterˉlocals;
    if Metadata + 12u32 != Functions.Payloadˉoffset + Functions.Payloadˉlength {
        return Compilerˉwebassemblyˉruntimeˉfunctionˉfailure();
    }
    if Bytesˉreadˉu32ˉlittle(Input, Metadata) != 0u32 {
        return Compilerˉwebassemblyˉruntimeˉfunctionˉfailure();
    }
    let Codeˉlength: u32 = Bytesˉreadˉu32ˉlittle(Input, Metadata + 4u32);
    let Maximumˉstack: u32 = Bytesˉreadˉu32ˉlittle(Input, Metadata + 8u32);
    if Codeˉlength == 0u32 { return Compilerˉwebassemblyˉruntimeˉfunctionˉfailure(); }
    if Codeˉlength > 16384u32 { return Compilerˉwebassemblyˉruntimeˉfunctionˉfailure(); }
    if Codeˉlength != Code.Payloadˉlength {
        return Compilerˉwebassemblyˉruntimeˉfunctionˉfailure();
    }
    if Maximumˉstack == 0u32 { return Compilerˉwebassemblyˉruntimeˉfunctionˉfailure(); }
    if Maximumˉstack > 4u32 { return Compilerˉwebassemblyˉruntimeˉfunctionˉfailure(); }

    let Localˉcount: u32 = Nonparameterˉlocals + 1u32;
    let Provisional: Compilerˉwebassemblyˉruntimeˉfunction =
        Compilerˉwebassemblyˉruntimeˉfunction(
            true,
            Localˉcount,
            Localˉtypesˉoffset,
            Codeˉlength,
            Maximumˉstack,
            0u32,
            false
        );
    var Initialized: bytes = Compilerˉwebassemblyˉruntimeˉmaskˉmake(Localˉcount);
    Initialized = Compilerˉwebassemblyˉruntimeˉmaskˉset(Initialized, 0u32);
    var Stack: Compilerˉwebassemblyˉruntimeˉstack =
        Compilerˉwebassemblyˉruntimeˉstackˉempty();
    var Cursor: u32 = 0u32;
    var Instructionˉcount: u32 = 0u32;
    var Returnˉcount: u32 = 0u32;
    var Hasˉcontrol: bool = false;
    var Lastˉterminator: bool = false;
    while Cursor < Codeˉlength {
        if Instructionˉcount >= 4096u32 {
            return Compilerˉwebassemblyˉruntimeˉfunctionˉfailure();
        }
        let Opcode: u8 = Bytesˉreadˉu8(Input, Code.Payloadˉoffset + Cursor);
        let Width: u32 = Compilerˉwebassemblyˉruntimeˉinstructionˉwidth(
            Input, Code.Payloadˉoffset, Codeˉlength, Cursor
        );
        if Width == 0u32 {
            return Compilerˉwebassemblyˉruntimeˉfunctionˉfailure();
        }

        var Handled: bool = false;
        Lastˉterminator = false;
        if Opcode == 1u8 {
            Stack = Compilerˉwebassemblyˉruntimeˉstackˉpush(Stack, 1u8);
            Handled = true;
        }
        if Opcode == 2u8 {
            let Value: u8 = Bytesˉreadˉu8(Input, Code.Payloadˉoffset + Cursor + 1u32);
            if Value != 0u8 {
                if Value != 1u8 {
                    return Compilerˉwebassemblyˉruntimeˉfunctionˉfailure();
                }
            }
            Stack = Compilerˉwebassemblyˉruntimeˉstackˉpush(Stack, 2u8);
            Handled = true;
        }
        if Opcode == 8u8 {
            Stack = Compilerˉwebassemblyˉruntimeˉstackˉpush(Stack, 4u8);
            Handled = true;
        }
        if Opcode == 9u8 {
            Stack = Compilerˉwebassemblyˉruntimeˉstackˉpush(Stack, 5u8);
            Handled = true;
        }
        if Opcode == 4u8 {
            let Loadˉindex: u32 = Bytesˉreadˉu32ˉlittle(
                Input, Code.Payloadˉoffset + Cursor + 1u32
            );
            if Loadˉindex >= Localˉcount {
                return Compilerˉwebassemblyˉruntimeˉfunctionˉfailure();
            }
            if Bytesˉreadˉu8(Initialized, Loadˉindex) == 0u8 {
                return Compilerˉwebassemblyˉruntimeˉfunctionˉfailure();
            }
            Stack = Compilerˉwebassemblyˉruntimeˉstackˉpush(
                Stack,
                Compilerˉwebassemblyˉruntimeˉlocalˉtype(Input, Provisional, Loadˉindex)
            );
            Handled = true;
        }
        if Opcode == 5u8 {
            let Storeˉindex: u32 = Bytesˉreadˉu32ˉlittle(
                Input, Code.Payloadˉoffset + Cursor + 1u32
            );
            if Storeˉindex >= Localˉcount {
                return Compilerˉwebassemblyˉruntimeˉfunctionˉfailure();
            }
            Stack = Compilerˉwebassemblyˉruntimeˉstackˉpop(
                Stack,
                Compilerˉwebassemblyˉruntimeˉlocalˉtype(Input, Provisional, Storeˉindex)
            );
            if !Stack.Valid { return Compilerˉwebassemblyˉruntimeˉfunctionˉfailure(); }
            Initialized = Compilerˉwebassemblyˉruntimeˉmaskˉset(Initialized, Storeˉindex);
            Handled = true;
        }
        if Opcode == 11u8 {
            Stack = Compilerˉwebassemblyˉruntimeˉstackˉpop(Stack, 6u8);
            Stack = Compilerˉwebassemblyˉruntimeˉstackˉpush(Stack, 5u8);
            Handled = true;
        }
        if Opcode == 12u8 {
            Stack = Compilerˉwebassemblyˉruntimeˉstackˉpop(Stack, 5u8);
            Stack = Compilerˉwebassemblyˉruntimeˉstackˉpop(Stack, 5u8);
            Stack = Compilerˉwebassemblyˉruntimeˉstackˉpop(Stack, 6u8);
            Stack = Compilerˉwebassemblyˉruntimeˉstackˉpush(Stack, 6u8);
            Handled = true;
        }
        var Isˉread: bool = false;
        if Opcode == 13u8 { Isˉread = true; }
        if Opcode == 14u8 { Isˉread = true; }
        if Opcode == 15u8 { Isˉread = true; }
        if Opcode == 114u8 { Isˉread = true; }
        if Isˉread {
            Stack = Compilerˉwebassemblyˉruntimeˉstackˉpop(Stack, 5u8);
            Stack = Compilerˉwebassemblyˉruntimeˉstackˉpop(Stack, 6u8);
            var Resultˉtype: u8 = 5u8;
            if Opcode == 13u8 { Resultˉtype = 4u8; }
            if Opcode == 114u8 { Resultˉtype = 1u8; }
            Stack = Compilerˉwebassemblyˉruntimeˉstackˉpush(Stack, Resultˉtype);
            Handled = true;
        }
        if Opcode == 118u8 {
            Stack = Compilerˉwebassemblyˉruntimeˉstackˉpop(Stack, 4u8);
            Stack = Compilerˉwebassemblyˉruntimeˉstackˉpush(Stack, 5u8);
            Handled = true;
        }
        var U32ˉarithmetic: bool = false;
        if Opcode == 20u8 { U32ˉarithmetic = true; }
        if Opcode == 21u8 { U32ˉarithmetic = true; }
        if U32ˉarithmetic {
            Stack = Compilerˉwebassemblyˉruntimeˉstackˉpop(Stack, 5u8);
            Stack = Compilerˉwebassemblyˉruntimeˉstackˉpop(Stack, 5u8);
            Stack = Compilerˉwebassemblyˉruntimeˉstackˉpush(Stack, 5u8);
            Handled = true;
        }
        var U32ˉcomparison: bool = false;
        let Opcodeˉvalue: u32 = U32ˉfromˉu8(Opcode);
        if Opcodeˉvalue >= 96u32 {
            if Opcodeˉvalue <= 101u32 { U32ˉcomparison = true; }
        }
        if U32ˉcomparison {
            Stack = Compilerˉwebassemblyˉruntimeˉstackˉpop(Stack, 5u8);
            Stack = Compilerˉwebassemblyˉruntimeˉstackˉpop(Stack, 5u8);
            Stack = Compilerˉwebassemblyˉruntimeˉstackˉpush(Stack, 2u8);
            Handled = true;
        }
        var U8ˉcomparison: bool = false;
        if Opcode == 102u8 { U8ˉcomparison = true; }
        if Opcode == 103u8 { U8ˉcomparison = true; }
        if U8ˉcomparison {
            Stack = Compilerˉwebassemblyˉruntimeˉstackˉpop(Stack, 4u8);
            Stack = Compilerˉwebassemblyˉruntimeˉstackˉpop(Stack, 4u8);
            Stack = Compilerˉwebassemblyˉruntimeˉstackˉpush(Stack, 2u8);
            Handled = true;
        }
        if Opcode == 119u8 {
            Stack = Compilerˉwebassemblyˉruntimeˉstackˉpop(Stack, 6u8);
            Stack = Compilerˉwebassemblyˉruntimeˉstackˉpop(Stack, 6u8);
            Stack = Compilerˉwebassemblyˉruntimeˉstackˉpush(Stack, 6u8);
            Handled = true;
        }
        if Opcode == 120u8 {
            Stack = Compilerˉwebassemblyˉruntimeˉstackˉpop(Stack, 4u8);
            Stack = Compilerˉwebassemblyˉruntimeˉstackˉpush(Stack, 6u8);
            Handled = true;
        }
        if Opcode == 121u8 {
            Stack = Compilerˉwebassemblyˉruntimeˉstackˉpop(Stack, 5u8);
            Stack = Compilerˉwebassemblyˉruntimeˉstackˉpush(Stack, 6u8);
            Handled = true;
        }
        if Opcode == 122u8 {
            Stack = Compilerˉwebassemblyˉruntimeˉstackˉpop(Stack, 5u8);
            Stack = Compilerˉwebassemblyˉruntimeˉstackˉpush(Stack, 6u8);
            Handled = true;
        }
        if Opcode == 123u8 {
            Stack = Compilerˉwebassemblyˉruntimeˉstackˉpop(Stack, 1u8);
            Stack = Compilerˉwebassemblyˉruntimeˉstackˉpush(Stack, 6u8);
            Handled = true;
        }
        if Opcode == 80u8 {
            Stack = Compilerˉwebassemblyˉruntimeˉstackˉpopˉany(Stack);
            Handled = true;
        }
        if Opcode == 48u8 {
            if Stack.Depth != 0u32 {
                return Compilerˉwebassemblyˉruntimeˉfunctionˉfailure();
            }
            let Jumpˉtarget: u32 = Bytesˉreadˉu32ˉlittle(
                Input, Code.Payloadˉoffset + Cursor + 1u32
            );
            if !Compilerˉwebassemblyˉruntimeˉcontrolˉisˉboundary(
                Input, Code.Payloadˉoffset, Codeˉlength, Jumpˉtarget
            ) {
                return Compilerˉwebassemblyˉruntimeˉfunctionˉfailure();
            }
            if !Compilerˉwebassemblyˉruntimeˉcontrolˉfollowsˉterminator(
                Input, Code.Payloadˉoffset, Codeˉlength, Jumpˉtarget
            ) {
                return Compilerˉwebassemblyˉruntimeˉfunctionˉfailure();
            }
            Hasˉcontrol = true;
            Lastˉterminator = true;
            Handled = true;
        }
        if Opcode == 49u8 {
            Stack = Compilerˉwebassemblyˉruntimeˉstackˉpop(Stack, 2u8);
            if Stack.Depth != 0u32 {
                return Compilerˉwebassemblyˉruntimeˉfunctionˉfailure();
            }
            let Branchˉtarget: u32 = Bytesˉreadˉu32ˉlittle(
                Input, Code.Payloadˉoffset + Cursor + 1u32
            );
            if !Compilerˉwebassemblyˉruntimeˉcontrolˉisˉboundary(
                Input, Code.Payloadˉoffset, Codeˉlength, Branchˉtarget
            ) {
                return Compilerˉwebassemblyˉruntimeˉfunctionˉfailure();
            }
            if !Compilerˉwebassemblyˉruntimeˉcontrolˉfollowsˉterminator(
                Input, Code.Payloadˉoffset, Codeˉlength, Branchˉtarget
            ) {
                return Compilerˉwebassemblyˉruntimeˉfunctionˉfailure();
            }
            Hasˉcontrol = true;
            Lastˉterminator = true;
            Handled = true;
        }
        if Opcode == 81u8 {
            if Stack.Depth != 1u32 {
                return Compilerˉwebassemblyˉruntimeˉfunctionˉfailure();
            }
            if Compilerˉwebassemblyˉruntimeˉstackˉtop(Stack) != 6u8 {
                return Compilerˉwebassemblyˉruntimeˉfunctionˉfailure();
            }
            Stack = Compilerˉwebassemblyˉruntimeˉstackˉpop(Stack, 6u8);
            Returnˉcount = Returnˉcount + 1u32;
            Lastˉterminator = true;
            Handled = true;
        }
        if !Handled {
            return Compilerˉwebassemblyˉruntimeˉfunctionˉfailure();
        }
        if !Stack.Valid { return Compilerˉwebassemblyˉruntimeˉfunctionˉfailure(); }
        Cursor = Cursor + Width;
        Instructionˉcount = Instructionˉcount + 1u32;
    }
    if Returnˉcount == 0u32 {
        return Compilerˉwebassemblyˉruntimeˉfunctionˉfailure();
    }
    if !Hasˉcontrol {
        if Returnˉcount != 1u32 {
            return Compilerˉwebassemblyˉruntimeˉfunctionˉfailure();
        }
    }
    if !Lastˉterminator {
        return Compilerˉwebassemblyˉruntimeˉfunctionˉfailure();
    }
    if Stack.Depth != 0u32 {
        return Compilerˉwebassemblyˉruntimeˉfunctionˉfailure();
    }
    if Stack.Maximum != Maximumˉstack {
        return Compilerˉwebassemblyˉruntimeˉfunctionˉfailure();
    }
    return Compilerˉwebassemblyˉruntimeˉfunction(
        true,
        Localˉcount,
        Localˉtypesˉoffset,
        Codeˉlength,
        Maximumˉstack,
        Instructionˉcount,
        Hasˉcontrol
    );
}

export fn Compilerˉwebassemblyˉvalidateˉboundedˉcallˉcode(
    Input: bytes,
    Functions: Compilerˉwebassemblyˉsection,
    Codeˉbase: u32,
    Function: Compilerˉwebassemblyˉcallˉfunction,
    Functionˉindex: u32
) -> Compilerˉwebassemblyˉcallˉcode {
    var Cursor: u32 = 0u32;
    var Depth: u32 = 0u32;
    var Firstˉtype: u8 = 0u8;
    var Secondˉtype: u8 = 0u8;
    var Maximumˉstack: u32 = 0u32;
    var Instructionˉcount: u32 = 0u32;
    var Callˉcount: u32 = 0u32;
    var Regionˉfloor: u32 = 0u32;
    var Activeˉkind: u32 = 0u32;
    var Activeˉheader: u32 = Function.Codeˉlength;
    var Activeˉfalse: u32 = Function.Codeˉlength;
    var Activeˉexit: u32 = Function.Codeˉlength;
    var Sawˉelse: bool = false;
    var Returned: bool = false;
    while Cursor < Function.Codeˉlength {
        if Activeˉkind == 2u32 {
            if Cursor == Activeˉfalse {
                Activeˉkind = 0u32;
                Regionˉfloor = Cursor;
            }
        }
        if Activeˉkind == 3u32 {
            if Cursor == Activeˉfalse { Sawˉelse = true; }
            if Cursor == Activeˉexit {
                if !Sawˉelse {
                    return Compilerˉwebassemblyˉcallˉcode(false, 0u32, 0u32);
                }
                Activeˉkind = 0u32;
                Sawˉelse = false;
                Regionˉfloor = Cursor;
            }
        }
        if Instructionˉcount >= 4096u32 {
            return Compilerˉwebassemblyˉcallˉcode(false, 0u32, 0u32);
        }
        Instructionˉcount = Instructionˉcount + 1u32;
        let Opcode: u8 = Bytesˉreadˉu8(
            Input,
            Codeˉbase + Function.Codeˉoffset + Cursor
        );
        var Handled: bool = false;
        if Opcode == 1u8 {
            if !Compilerˉwebassemblyˉrangeˉisˉvalid(
                Function.Codeˉlength,
                Cursor,
                5u32
            ) {
                return Compilerˉwebassemblyˉcallˉcode(false, 0u32, 0u32);
            }
            if Depth >= 2u32 {
                return Compilerˉwebassemblyˉcallˉcode(false, 0u32, 0u32);
            }
            if Depth == 0u32 { Firstˉtype = 1u8; }
            if Depth == 1u32 { Secondˉtype = 1u8; }
            Depth = Depth + 1u32;
            Cursor = Cursor + 5u32;
            Handled = true;
        }
        if Opcode == 4u8 {
            if !Compilerˉwebassemblyˉrangeˉisˉvalid(
                Function.Codeˉlength,
                Cursor,
                5u32
            ) {
                return Compilerˉwebassemblyˉcallˉcode(false, 0u32, 0u32);
            }
            let Storeˉlocalˉindex: u32 = Bytesˉreadˉu32ˉlittle(
                Input,
                Codeˉbase + Function.Codeˉoffset + Cursor + 1u32
            );
            if Storeˉlocalˉindex >= Function.Localˉcount {
                return Compilerˉwebassemblyˉcallˉcode(false, 0u32, 0u32);
            }
            if Depth >= 2u32 {
                return Compilerˉwebassemblyˉcallˉcode(false, 0u32, 0u32);
            }
            let Loadˉtype: u8 = Compilerˉwebassemblyˉcallˉlocalˉtype(
                Input,
                Function,
                Storeˉlocalˉindex
            );
            if Depth == 0u32 { Firstˉtype = Loadˉtype; }
            if Depth == 1u32 { Secondˉtype = Loadˉtype; }
            Depth = Depth + 1u32;
            Cursor = Cursor + 5u32;
            Handled = true;
        }
        if Opcode == 5u8 {
            if !Compilerˉwebassemblyˉrangeˉisˉvalid(
                Function.Codeˉlength,
                Cursor,
                5u32
            ) {
                return Compilerˉwebassemblyˉcallˉcode(false, 0u32, 0u32);
            }
            let Localˉindex: u32 = Bytesˉreadˉu32ˉlittle(
                Input,
                Codeˉbase + Function.Codeˉoffset + Cursor + 1u32
            );
            if Localˉindex >= Function.Localˉcount {
                return Compilerˉwebassemblyˉcallˉcode(false, 0u32, 0u32);
            }
            if Depth == 0u32 {
                return Compilerˉwebassemblyˉcallˉcode(false, 0u32, 0u32);
            }
            let Localˉtype: u8 = Compilerˉwebassemblyˉcallˉlocalˉtype(
                Input,
                Function,
                Localˉindex
            );
            var Stackˉtype: u8 = Firstˉtype;
            if Depth == 2u32 { Stackˉtype = Secondˉtype; }
            if Stackˉtype != Localˉtype {
                return Compilerˉwebassemblyˉcallˉcode(false, 0u32, 0u32);
            }
            Depth = Depth - 1u32;
            Cursor = Cursor + 5u32;
            Handled = true;
        }
        var Arithmetic: bool = false;
        if Opcode == 16u8 { Arithmetic = true; }
        if Opcode == 17u8 { Arithmetic = true; }
        if Opcode == 18u8 { Arithmetic = true; }
        if Arithmetic {
            if Depth != 2u32 {
                return Compilerˉwebassemblyˉcallˉcode(false, 0u32, 0u32);
            }
            if Firstˉtype != 1u8 {
                return Compilerˉwebassemblyˉcallˉcode(false, 0u32, 0u32);
            }
            if Secondˉtype != 1u8 {
                return Compilerˉwebassemblyˉcallˉcode(false, 0u32, 0u32);
            }
            Depth = 1u32;
            Firstˉtype = 1u8;
            Cursor = Cursor + 1u32;
            Handled = true;
        }
        if Opcode == 19u8 {
            if Depth == 0u32 {
                return Compilerˉwebassemblyˉcallˉcode(false, 0u32, 0u32);
            }
            var Negateˉtype: u8 = Firstˉtype;
            if Depth == 2u32 { Negateˉtype = Secondˉtype; }
            if Negateˉtype != 1u8 {
                return Compilerˉwebassemblyˉcallˉcode(false, 0u32, 0u32);
            }
            Cursor = Cursor + 1u32;
            Handled = true;
        }
        var Comparison: bool = false;
        if Opcode == 32u8 { Comparison = true; }
        if Opcode == 33u8 { Comparison = true; }
        if Opcode == 34u8 { Comparison = true; }
        if Opcode == 35u8 { Comparison = true; }
        if Opcode == 36u8 { Comparison = true; }
        if Opcode == 37u8 { Comparison = true; }
        if Comparison {
            if Depth != 2u32 {
                return Compilerˉwebassemblyˉcallˉcode(false, 0u32, 0u32);
            }
            if Firstˉtype != 1u8 {
                return Compilerˉwebassemblyˉcallˉcode(false, 0u32, 0u32);
            }
            if Secondˉtype != 1u8 {
                return Compilerˉwebassemblyˉcallˉcode(false, 0u32, 0u32);
            }
            Depth = 1u32;
            Firstˉtype = 2u8;
            Cursor = Cursor + 1u32;
            Handled = true;
        }
        if Opcode == 48u8 {
            if !Compilerˉwebassemblyˉrangeˉisˉvalid(
                Function.Codeˉlength,
                Cursor,
                5u32
            ) {
                return Compilerˉwebassemblyˉcallˉcode(false, 0u32, 0u32);
            }
            if Depth != 0u32 {
                return Compilerˉwebassemblyˉcallˉcode(false, 0u32, 0u32);
            }
            let Jumpˉtarget: u32 = Bytesˉreadˉu32ˉlittle(
                Input,
                Codeˉbase + Function.Codeˉoffset + Cursor + 1u32
            );
            if Jumpˉtarget >= Function.Codeˉlength {
                return Compilerˉwebassemblyˉcallˉcode(false, 0u32, 0u32);
            }
            if Jumpˉtarget == Cursor {
                return Compilerˉwebassemblyˉcallˉcode(false, 0u32, 0u32);
            }
            if Jumpˉtarget < Cursor {
                if Activeˉkind != 1u32 {
                    return Compilerˉwebassemblyˉcallˉcode(false, 0u32, 0u32);
                }
                if Jumpˉtarget != Activeˉheader {
                    return Compilerˉwebassemblyˉcallˉcode(false, 0u32, 0u32);
                }
                if Cursor + 5u32 != Activeˉfalse {
                    return Compilerˉwebassemblyˉcallˉcode(false, 0u32, 0u32);
                }
                Activeˉkind = 0u32;
                Regionˉfloor = Activeˉfalse;
            }
            if Jumpˉtarget > Cursor + 5u32 {
                if Activeˉkind != 3u32 {
                    return Compilerˉwebassemblyˉcallˉcode(false, 0u32, 0u32);
                }
                if Cursor + 5u32 != Activeˉfalse {
                    return Compilerˉwebassemblyˉcallˉcode(false, 0u32, 0u32);
                }
                if Jumpˉtarget != Activeˉexit {
                    return Compilerˉwebassemblyˉcallˉcode(false, 0u32, 0u32);
                }
            }
            Cursor = Cursor + 5u32;
            Handled = true;
        }
        if Opcode == 49u8 {
            if Depth != 1u32 {
                return Compilerˉwebassemblyˉcallˉcode(false, 0u32, 0u32);
            }
            if Firstˉtype != 2u8 {
                return Compilerˉwebassemblyˉcallˉcode(false, 0u32, 0u32);
            }
            if Activeˉkind != 0u32 {
                return Compilerˉwebassemblyˉcallˉcode(false, 0u32, 0u32);
            }
            let Region: Compilerˉwebassemblyˉcontrol =
                Compilerˉwebassemblyˉclassifyˉsequentialˉregion(
                    Input,
                    Codeˉbase + Function.Codeˉoffset,
                    Function.Codeˉlength,
                    Cursor
                );
            if !Region.Valid {
                return Compilerˉwebassemblyˉcallˉcode(false, 0u32, 0u32);
            }
            if Region.Header < Regionˉfloor {
                return Compilerˉwebassemblyˉcallˉcode(false, 0u32, 0u32);
            }
            Activeˉkind = Region.Kind;
            Activeˉheader = Region.Header;
            Activeˉfalse = Region.Falseˉtarget;
            Activeˉexit = Region.Exitˉtarget;
            Depth = 0u32;
            Cursor = Cursor + 5u32;
            Handled = true;
        }
        if Opcode == 64u8 {
            if !Compilerˉwebassemblyˉrangeˉisˉvalid(
                Function.Codeˉlength,
                Cursor,
                5u32
            ) {
                return Compilerˉwebassemblyˉcallˉcode(false, 0u32, 0u32);
            }
            let Targetˉindex: u32 = Bytesˉreadˉu32ˉlittle(
                Input,
                Codeˉbase + Function.Codeˉoffset + Cursor + 1u32
            );
            if Targetˉindex >= Functionˉindex {
                return Compilerˉwebassemblyˉcallˉcode(false, 0u32, 0u32);
            }
            let Target: Compilerˉwebassemblyˉcallˉfunction =
                Compilerˉwebassemblyˉreadˉcallˉfunction(
                    Input,
                    Functions,
                    Targetˉindex
                );
            if !Target.Valid {
                return Compilerˉwebassemblyˉcallˉcode(false, 0u32, 0u32);
            }
            if Target.Parameterˉcount == 0u32 {
                if Depth >= 2u32 {
                    return Compilerˉwebassemblyˉcallˉcode(false, 0u32, 0u32);
                }
                if Depth == 0u32 { Firstˉtype = 1u8; }
                if Depth == 1u32 { Secondˉtype = 1u8; }
                Depth = Depth + 1u32;
            }
            if Target.Parameterˉcount == 1u32 {
                if Depth == 0u32 {
                    return Compilerˉwebassemblyˉcallˉcode(false, 0u32, 0u32);
                }
                var Argumentˉtype: u8 = Firstˉtype;
                if Depth == 2u32 { Argumentˉtype = Secondˉtype; }
                if Argumentˉtype != 1u8 {
                    return Compilerˉwebassemblyˉcallˉcode(false, 0u32, 0u32);
                }
                if Depth == 1u32 { Firstˉtype = 1u8; }
                if Depth == 2u32 { Secondˉtype = 1u8; }
            }
            if Target.Parameterˉcount == 2u32 {
                if Depth != 2u32 {
                    return Compilerˉwebassemblyˉcallˉcode(false, 0u32, 0u32);
                }
                if Firstˉtype != 1u8 {
                    return Compilerˉwebassemblyˉcallˉcode(false, 0u32, 0u32);
                }
                if Secondˉtype != 1u8 {
                    return Compilerˉwebassemblyˉcallˉcode(false, 0u32, 0u32);
                }
                Depth = 1u32;
                Firstˉtype = 1u8;
            }
            Callˉcount = Callˉcount + 1u32;
            Cursor = Cursor + 5u32;
            Handled = true;
        }
        if Opcode == 80u8 {
            if Depth == 0u32 {
                return Compilerˉwebassemblyˉcallˉcode(false, 0u32, 0u32);
            }
            Depth = Depth - 1u32;
            Cursor = Cursor + 1u32;
            Handled = true;
        }
        if Opcode == 81u8 {
            if Activeˉkind != 0u32 {
                return Compilerˉwebassemblyˉcallˉcode(false, 0u32, 0u32);
            }
            if Depth != 1u32 {
                return Compilerˉwebassemblyˉcallˉcode(false, 0u32, 0u32);
            }
            if Firstˉtype != 1u8 {
                return Compilerˉwebassemblyˉcallˉcode(false, 0u32, 0u32);
            }
            if Cursor + 1u32 != Function.Codeˉlength {
                return Compilerˉwebassemblyˉcallˉcode(false, 0u32, 0u32);
            }
            Returned = true;
            Cursor = Cursor + 1u32;
            Handled = true;
        }
        if !Handled {
            return Compilerˉwebassemblyˉcallˉcode(false, 0u32, 0u32);
        }
        if Depth > Maximumˉstack { Maximumˉstack = Depth; }
    }
    if !Returned {
        return Compilerˉwebassemblyˉcallˉcode(false, 0u32, 0u32);
    }
    if Activeˉkind != 0u32 {
        return Compilerˉwebassemblyˉcallˉcode(false, 0u32, 0u32);
    }
    if Maximumˉstack != Function.Maximumˉstack {
        return Compilerˉwebassemblyˉcallˉcode(false, 0u32, 0u32);
    }
    return Compilerˉwebassemblyˉcallˉcode(
        true,
        Instructionˉcount,
        Callˉcount
    );
}

export fn Compilerˉwebassemblyˉvalidateˉboundedˉcalls(
    Input: bytes,
    Functions: Compilerˉwebassemblyˉsection,
    Code: Compilerˉwebassemblyˉsection,
    Mainˉindex: u32
) -> Compilerˉwebassemblyˉcallˉsummary {
    if Functions.Payloadˉlength < 4u32 {
        return Compilerˉwebassemblyˉcallˉsummary(false, 0u32, 0u32, 0u32);
    }
    let Functionˉcount: u32 =
        Bytesˉreadˉu32ˉlittle(Input, Functions.Payloadˉoffset);
    if Functionˉcount < 2u32 {
        return Compilerˉwebassemblyˉcallˉsummary(false, 0u32, 0u32, 0u32);
    }
    if Functionˉcount > 8u32 {
        return Compilerˉwebassemblyˉcallˉsummary(false, 0u32, 0u32, 0u32);
    }
    if Mainˉindex + 1u32 != Functionˉcount {
        return Compilerˉwebassemblyˉcallˉsummary(false, 0u32, 0u32, 0u32);
    }
    if Code.Payloadˉlength > 32768u32 {
        return Compilerˉwebassemblyˉcallˉsummary(false, 0u32, 0u32, 0u32);
    }

    var Functionˉindex: u32 = 0u32;
    var Expectedˉcodeˉoffset: u32 = 0u32;
    var Callˉcount: u32 = 0u32;
    var Instructionˉcount: u32 = 0u32;
    var Lastˉnextˉoffset: u32 = Functions.Payloadˉoffset + 4u32;
    while Functionˉindex < Functionˉcount {
        let Function: Compilerˉwebassemblyˉcallˉfunction =
            Compilerˉwebassemblyˉreadˉcallˉfunction(
                Input,
                Functions,
                Functionˉindex
            );
        if !Function.Valid {
            return Compilerˉwebassemblyˉcallˉsummary(false, 0u32, 0u32, 0u32);
        }
        if Function.Codeˉoffset != Expectedˉcodeˉoffset {
            return Compilerˉwebassemblyˉcallˉsummary(false, 0u32, 0u32, 0u32);
        }
        if Functionˉindex == Mainˉindex {
            if !Function.Isˉmain {
                return Compilerˉwebassemblyˉcallˉsummary(false, 0u32, 0u32, 0u32);
            }
            if Function.Parameterˉcount != 0u32 {
                return Compilerˉwebassemblyˉcallˉsummary(false, 0u32, 0u32, 0u32);
            }
        } else {
            if Function.Isˉmain {
                return Compilerˉwebassemblyˉcallˉsummary(false, 0u32, 0u32, 0u32);
            }
        }
        let Validated: Compilerˉwebassemblyˉcallˉcode =
            Compilerˉwebassemblyˉvalidateˉboundedˉcallˉcode(
                Input,
                Functions,
                Code.Payloadˉoffset,
                Function,
                Functionˉindex
            );
        if !Validated.Valid {
            return Compilerˉwebassemblyˉcallˉsummary(false, 0u32, 0u32, 0u32);
        }
        Expectedˉcodeˉoffset = Expectedˉcodeˉoffset + Function.Codeˉlength;
        Instructionˉcount = Instructionˉcount + Validated.Instructionˉcount;
        Callˉcount = Callˉcount + Validated.Callˉcount;
        Lastˉnextˉoffset = Function.Nextˉoffset;
        Functionˉindex = Functionˉindex + 1u32;
    }
    if Expectedˉcodeˉoffset != Code.Payloadˉlength {
        return Compilerˉwebassemblyˉcallˉsummary(false, 0u32, 0u32, 0u32);
    }
    if Lastˉnextˉoffset != Functions.Payloadˉoffset + Functions.Payloadˉlength {
        return Compilerˉwebassemblyˉcallˉsummary(false, 0u32, 0u32, 0u32);
    }
    if Instructionˉcount > 8192u32 {
        return Compilerˉwebassemblyˉcallˉsummary(false, 0u32, 0u32, 0u32);
    }
    if Callˉcount == 0u32 {
        return Compilerˉwebassemblyˉcallˉsummary(false, 0u32, 0u32, 0u32);
    }
    return Compilerˉwebassemblyˉcallˉsummary(
        true,
        Functionˉcount,
        Callˉcount,
        Instructionˉcount
    );
}

export fn Compilerˉwebassemblyˉvalidateˉstraightˉi32ˉcode(
    Input: bytes,
    Offset: u32,
    Length: u32,
    Localˉcount: u32,
    Declaredˉmaximumˉstack: u32
) -> Compilerˉwebassemblyˉcode {
    var Cursor: u32 = 0u32;
    var Depth: u32 = 0u32;
    var Maximumˉstack: u32 = 0u32;
    var Instructionˉcount: u32 = 0u32;
    var Returned: bool = false;
    while Cursor < Length {
        if Instructionˉcount >= 4096u32 {
            return Compilerˉwebassemblyˉcode(false, 0u32, 0u32);
        }
        Instructionˉcount = Instructionˉcount + 1u32;
        let Opcode: u8 = Bytesˉreadˉu8(Input, Offset + Cursor);
        var Handled: bool = false;
        if Opcode == 1u8 {
            if !Compilerˉwebassemblyˉrangeˉisˉvalid(Length, Cursor, 5u32) { return Compilerˉwebassemblyˉcode(false, 0u32, 0u32); }
            if Depth >= 256u32 { return Compilerˉwebassemblyˉcode(false, 0u32, 0u32); }
            Depth = Depth + 1u32;
            Cursor = Cursor + 5u32;
            Handled = true;
        }
        if Opcode == 4u8 {
            if !Compilerˉwebassemblyˉrangeˉisˉvalid(Length, Cursor, 5u32) { return Compilerˉwebassemblyˉcode(false, 0u32, 0u32); }
            if Bytesˉreadˉu32ˉlittle(Input, Offset + Cursor + 1u32) >= Localˉcount { return Compilerˉwebassemblyˉcode(false, 0u32, 0u32); }
            if Depth >= 256u32 { return Compilerˉwebassemblyˉcode(false, 0u32, 0u32); }
            Depth = Depth + 1u32;
            Cursor = Cursor + 5u32;
            Handled = true;
        }
        if Opcode == 5u8 {
            if !Compilerˉwebassemblyˉrangeˉisˉvalid(Length, Cursor, 5u32) { return Compilerˉwebassemblyˉcode(false, 0u32, 0u32); }
            if Bytesˉreadˉu32ˉlittle(Input, Offset + Cursor + 1u32) >= Localˉcount { return Compilerˉwebassemblyˉcode(false, 0u32, 0u32); }
            if Depth == 0u32 { return Compilerˉwebassemblyˉcode(false, 0u32, 0u32); }
            Depth = Depth - 1u32;
            Cursor = Cursor + 5u32;
            Handled = true;
        }
        if Opcode == 16u8 {
            if Depth < 2u32 { return Compilerˉwebassemblyˉcode(false, 0u32, 0u32); }
            Depth = Depth - 1u32;
            Cursor = Cursor + 1u32;
            Handled = true;
        }
        if Opcode == 17u8 {
            if Depth < 2u32 { return Compilerˉwebassemblyˉcode(false, 0u32, 0u32); }
            Depth = Depth - 1u32;
            Cursor = Cursor + 1u32;
            Handled = true;
        }
        if Opcode == 18u8 {
            if Depth < 2u32 { return Compilerˉwebassemblyˉcode(false, 0u32, 0u32); }
            Depth = Depth - 1u32;
            Cursor = Cursor + 1u32;
            Handled = true;
        }
        if Opcode == 19u8 {
            if Depth == 0u32 { return Compilerˉwebassemblyˉcode(false, 0u32, 0u32); }
            Cursor = Cursor + 1u32;
            Handled = true;
        }
        if Opcode == 80u8 {
            if Depth == 0u32 { return Compilerˉwebassemblyˉcode(false, 0u32, 0u32); }
            Depth = Depth - 1u32;
            Cursor = Cursor + 1u32;
            Handled = true;
        }
        if Opcode == 81u8 {
            if Depth != 1u32 { return Compilerˉwebassemblyˉcode(false, 0u32, 0u32); }
            if Cursor + 1u32 != Length { return Compilerˉwebassemblyˉcode(false, 0u32, 0u32); }
            Returned = true;
            Cursor = Cursor + 1u32;
            Handled = true;
        }
        if !Handled {
            return Compilerˉwebassemblyˉcode(false, 0u32, 0u32);
        }
        if Depth > Maximumˉstack { Maximumˉstack = Depth; }
    }
    if !Returned { return Compilerˉwebassemblyˉcode(false, 0u32, 0u32); }
    if Maximumˉstack != Declaredˉmaximumˉstack {
        return Compilerˉwebassemblyˉcode(false, 0u32, 0u32);
    }
    return Compilerˉwebassemblyˉcode(true, Instructionˉcount, Maximumˉstack);
}

export fn Compilerˉwebassemblyˉloopˉfailure() -> Compilerˉwebassemblyˉloop {
    return Compilerˉwebassemblyˉloop(false, 0u32, 0u32, 0u32, 0u32);
}

export fn Compilerˉwebassemblyˉvalidateˉmeteredˉloop(
    Input: bytes,
    Offset: u32,
    Length: u32,
    Localˉtypesˉoffset: u32,
    Localˉcount: u32,
    Declaredˉmaximumˉstack: u32
) -> Compilerˉwebassemblyˉloop {
    if Declaredˉmaximumˉstack != 2u32 {
        return Compilerˉwebassemblyˉloopˉfailure();
    }
    var Cursor: u32 = 0u32;
    var Depth: u32 = 0u32;
    var Firstˉtype: u8 = 0u8;
    var Secondˉtype: u8 = 0u8;
    var Maximumˉstack: u32 = 0u32;
    var Instructionˉcount: u32 = 0u32;
    var Loopˉheader: u32 = Length;
    var Exitˉoffset: u32 = Length;
    var Branchˉcount: u32 = 0u32;
    var Backwardˉjumpˉcount: u32 = 0u32;
    var Sawˉloopˉheader: bool = false;
    var Sawˉexit: bool = false;
    var Returned: bool = false;
    while Cursor < Length {
        if Cursor == Loopˉheader { Sawˉloopˉheader = true; }
        if Cursor == Exitˉoffset { Sawˉexit = true; }
        if Instructionˉcount >= 4096u32 {
            return Compilerˉwebassemblyˉloopˉfailure();
        }
        Instructionˉcount = Instructionˉcount + 1u32;
        let Opcode: u8 = Bytesˉreadˉu8(Input, Offset + Cursor);
        var Handled: bool = false;
        if Opcode == 1u8 {
            if !Compilerˉwebassemblyˉrangeˉisˉvalid(Length, Cursor, 5u32) {
                return Compilerˉwebassemblyˉloopˉfailure();
            }
            if Depth == 0u32 { Firstˉtype = 1u8; }
            if Depth == 1u32 { Secondˉtype = 1u8; }
            if Depth >= 2u32 { return Compilerˉwebassemblyˉloopˉfailure(); }
            Depth = Depth + 1u32;
            Cursor = Cursor + 5u32;
            Handled = true;
        }
        if Opcode == 4u8 {
            if !Compilerˉwebassemblyˉrangeˉisˉvalid(Length, Cursor, 5u32) {
                return Compilerˉwebassemblyˉloopˉfailure();
            }
            let Loadˉlocalˉindex: u32 = Bytesˉreadˉu32ˉlittle(Input, Offset + Cursor + 1u32);
            if Loadˉlocalˉindex >= Localˉcount {
                return Compilerˉwebassemblyˉloopˉfailure();
            }
            let Loadˉlocalˉtype: u8 = Bytesˉreadˉu8(Input, Localˉtypesˉoffset + Loadˉlocalˉindex);
            if Depth == 0u32 { Firstˉtype = Loadˉlocalˉtype; }
            if Depth == 1u32 { Secondˉtype = Loadˉlocalˉtype; }
            if Depth >= 2u32 { return Compilerˉwebassemblyˉloopˉfailure(); }
            Depth = Depth + 1u32;
            Cursor = Cursor + 5u32;
            Handled = true;
        }
        if Opcode == 5u8 {
            if !Compilerˉwebassemblyˉrangeˉisˉvalid(Length, Cursor, 5u32) {
                return Compilerˉwebassemblyˉloopˉfailure();
            }
            let Storeˉlocalˉindex: u32 = Bytesˉreadˉu32ˉlittle(Input, Offset + Cursor + 1u32);
            if Storeˉlocalˉindex >= Localˉcount { return Compilerˉwebassemblyˉloopˉfailure(); }
            if Depth == 0u32 { return Compilerˉwebassemblyˉloopˉfailure(); }
            let Storeˉlocalˉtype: u8 = Bytesˉreadˉu8(Input, Localˉtypesˉoffset + Storeˉlocalˉindex);
            var Storeˉstackˉtype: u8 = Firstˉtype;
            if Depth == 2u32 { Storeˉstackˉtype = Secondˉtype; }
            if Storeˉstackˉtype != Storeˉlocalˉtype {
                return Compilerˉwebassemblyˉloopˉfailure();
            }
            Depth = Depth - 1u32;
            Cursor = Cursor + 5u32;
            Handled = true;
        }
        var Arithmetic: bool = false;
        if Opcode == 16u8 { Arithmetic = true; }
        if Opcode == 17u8 { Arithmetic = true; }
        if Opcode == 18u8 { Arithmetic = true; }
        if Arithmetic {
            if Depth != 2u32 { return Compilerˉwebassemblyˉloopˉfailure(); }
            if Firstˉtype != 1u8 { return Compilerˉwebassemblyˉloopˉfailure(); }
            if Secondˉtype != 1u8 { return Compilerˉwebassemblyˉloopˉfailure(); }
            Depth = 1u32;
            Firstˉtype = 1u8;
            Cursor = Cursor + 1u32;
            Handled = true;
        }
        if Opcode == 19u8 {
            var Negateˉstackˉtype: u8 = Firstˉtype;
            if Depth == 2u32 { Negateˉstackˉtype = Secondˉtype; }
            if Depth == 0u32 { return Compilerˉwebassemblyˉloopˉfailure(); }
            if Negateˉstackˉtype != 1u8 { return Compilerˉwebassemblyˉloopˉfailure(); }
            Cursor = Cursor + 1u32;
            Handled = true;
        }
        var Comparison: bool = false;
        if Opcode == 32u8 { Comparison = true; }
        if Opcode == 33u8 { Comparison = true; }
        if Opcode == 34u8 { Comparison = true; }
        if Opcode == 35u8 { Comparison = true; }
        if Opcode == 36u8 { Comparison = true; }
        if Opcode == 37u8 { Comparison = true; }
        if Comparison {
            if Depth != 2u32 { return Compilerˉwebassemblyˉloopˉfailure(); }
            if Firstˉtype != 1u8 { return Compilerˉwebassemblyˉloopˉfailure(); }
            if Secondˉtype != 1u8 { return Compilerˉwebassemblyˉloopˉfailure(); }
            Depth = 1u32;
            Firstˉtype = 2u8;
            Cursor = Cursor + 1u32;
            Handled = true;
        }
        if Opcode == 48u8 {
            if !Compilerˉwebassemblyˉrangeˉisˉvalid(Length, Cursor, 5u32) {
                return Compilerˉwebassemblyˉloopˉfailure();
            }
            if Depth != 0u32 { return Compilerˉwebassemblyˉloopˉfailure(); }
            let Jumpˉtarget: u32 = Bytesˉreadˉu32ˉlittle(Input, Offset + Cursor + 1u32);
            if Jumpˉtarget >= Length {
                return Compilerˉwebassemblyˉloopˉfailure();
            }
            if Jumpˉtarget == Cursor + 5u32 {
                if Loopˉheader == Length { Loopˉheader = Jumpˉtarget; }
            }
            if Jumpˉtarget < Cursor {
                if Backwardˉjumpˉcount != 0u32 { return Compilerˉwebassemblyˉloopˉfailure(); }
                if Jumpˉtarget != Loopˉheader { return Compilerˉwebassemblyˉloopˉfailure(); }
                if Exitˉoffset == Length { return Compilerˉwebassemblyˉloopˉfailure(); }
                if Cursor + 5u32 != Exitˉoffset { return Compilerˉwebassemblyˉloopˉfailure(); }
                Backwardˉjumpˉcount = Backwardˉjumpˉcount + 1u32;
            }
            if Jumpˉtarget > Cursor {
                if Jumpˉtarget != Cursor + 5u32 {
                    return Compilerˉwebassemblyˉloopˉfailure();
                }
            }
            Cursor = Cursor + 5u32;
            Handled = true;
        }
        if Opcode == 49u8 {
            if !Compilerˉwebassemblyˉrangeˉisˉvalid(Length, Cursor, 5u32) {
                return Compilerˉwebassemblyˉloopˉfailure();
            }
            if Depth != 1u32 { return Compilerˉwebassemblyˉloopˉfailure(); }
            if Firstˉtype != 2u8 { return Compilerˉwebassemblyˉloopˉfailure(); }
            if Branchˉcount != 0u32 { return Compilerˉwebassemblyˉloopˉfailure(); }
            let Branchˉtarget: u32 = Bytesˉreadˉu32ˉlittle(Input, Offset + Cursor + 1u32);
            if Loopˉheader == Length { return Compilerˉwebassemblyˉloopˉfailure(); }
            if Cursor <= Loopˉheader { return Compilerˉwebassemblyˉloopˉfailure(); }
            if Branchˉtarget <= Cursor + 5u32 { return Compilerˉwebassemblyˉloopˉfailure(); }
            if Branchˉtarget >= Length { return Compilerˉwebassemblyˉloopˉfailure(); }
            Exitˉoffset = Branchˉtarget;
            Branchˉcount = Branchˉcount + 1u32;
            Depth = 0u32;
            Cursor = Cursor + 5u32;
            Handled = true;
        }
        if Opcode == 80u8 {
            if Depth == 0u32 { return Compilerˉwebassemblyˉloopˉfailure(); }
            Depth = Depth - 1u32;
            Cursor = Cursor + 1u32;
            Handled = true;
        }
        if Opcode == 81u8 {
            if Depth != 1u32 { return Compilerˉwebassemblyˉloopˉfailure(); }
            if Firstˉtype != 1u8 { return Compilerˉwebassemblyˉloopˉfailure(); }
            if Cursor + 1u32 != Length { return Compilerˉwebassemblyˉloopˉfailure(); }
            Returned = true;
            Cursor = Cursor + 1u32;
            Handled = true;
        }
        if !Handled { return Compilerˉwebassemblyˉloopˉfailure(); }
        if Depth > Maximumˉstack { Maximumˉstack = Depth; }
    }
    if !Returned { return Compilerˉwebassemblyˉloopˉfailure(); }
    if Branchˉcount != 1u32 { return Compilerˉwebassemblyˉloopˉfailure(); }
    if Backwardˉjumpˉcount != 1u32 { return Compilerˉwebassemblyˉloopˉfailure(); }
    if !Sawˉloopˉheader { return Compilerˉwebassemblyˉloopˉfailure(); }
    if !Sawˉexit { return Compilerˉwebassemblyˉloopˉfailure(); }
    if Maximumˉstack != Declaredˉmaximumˉstack {
        return Compilerˉwebassemblyˉloopˉfailure();
    }
    return Compilerˉwebassemblyˉloop(
        true,
        Instructionˉcount,
        Maximumˉstack,
        Loopˉheader,
        Exitˉoffset
    );
}

export fn Compilerˉwebassemblyˉcontrolˉfailure() -> Compilerˉwebassemblyˉcontrol {
    return Compilerˉwebassemblyˉcontrol(false, 0u32, 0u32, 0u32, 0u32);
}

export fn Compilerˉwebassemblyˉcontrolˉinstructionˉwidth(
    Input: bytes,
    Offset: u32,
    Length: u32,
    Cursor: u32
) -> u32 {
    if Cursor >= Length { return 0u32; }
    let Opcode: u8 = Bytesˉreadˉu8(Input, Offset + Cursor);
    var Width: u32 = 0u32;
    if Opcode == 1u8 { Width = 5u32; }
    if Opcode == 4u8 { Width = 5u32; }
    if Opcode == 5u8 { Width = 5u32; }
    if Opcode == 16u8 { Width = 1u32; }
    if Opcode == 17u8 { Width = 1u32; }
    if Opcode == 18u8 { Width = 1u32; }
    if Opcode == 19u8 { Width = 1u32; }
    if Opcode == 32u8 { Width = 1u32; }
    if Opcode == 33u8 { Width = 1u32; }
    if Opcode == 34u8 { Width = 1u32; }
    if Opcode == 35u8 { Width = 1u32; }
    if Opcode == 36u8 { Width = 1u32; }
    if Opcode == 37u8 { Width = 1u32; }
    if Opcode == 48u8 { Width = 5u32; }
    if Opcode == 49u8 { Width = 5u32; }
    if Opcode == 64u8 { Width = 5u32; }
    if Opcode == 80u8 { Width = 1u32; }
    if Opcode == 81u8 { Width = 1u32; }
    if Width == 0u32 { return 0u32; }
    if !Compilerˉwebassemblyˉrangeˉisˉvalid(Length, Cursor, Width) { return 0u32; }
    return Width;
}

export fn Compilerˉwebassemblyˉcontrolˉisˉboundary(
    Input: bytes,
    Offset: u32,
    Length: u32,
    Target: u32
) -> bool {
    if Target >= Length { return false; }
    var Cursor: u32 = 0u32;
    while Cursor < Target {
        let Width: u32 = Compilerˉwebassemblyˉcontrolˉinstructionˉwidth(
            Input,
            Offset,
            Length,
            Cursor
        );
        if Width == 0u32 { return false; }
        Cursor = Cursor + Width;
        if Cursor > Target { return false; }
    }
    return Cursor == Target;
}

export fn Compilerˉwebassemblyˉcontrolˉhasˉentryˉjump(
    Input: bytes,
    Offset: u32,
    Length: u32,
    Header: u32
) -> bool {
    if Header == 0u32 { return false; }
    var Cursor: u32 = 0u32;
    var Previous: u32 = Length;
    while Cursor < Header {
        Previous = Cursor;
        let Width: u32 = Compilerˉwebassemblyˉcontrolˉinstructionˉwidth(
            Input,
            Offset,
            Length,
            Cursor
        );
        if Width == 0u32 { return false; }
        Cursor = Cursor + Width;
        if Cursor > Header { return false; }
    }
    if Cursor != Header { return false; }
    if Previous == Length { return false; }
    if Bytesˉreadˉu8(Input, Offset + Previous) != 48u8 { return false; }
    if Previous + 5u32 != Header { return false; }
    return Bytesˉreadˉu32ˉlittle(Input, Offset + Previous + 1u32) == Header;
}

export fn Compilerˉwebassemblyˉclassifyˉsequentialˉregion(
    Input: bytes,
    Offset: u32,
    Length: u32,
    Branch: u32
) -> Compilerˉwebassemblyˉcontrol {
    if !Compilerˉwebassemblyˉrangeˉisˉvalid(Length, Branch, 5u32) {
        return Compilerˉwebassemblyˉcontrolˉfailure();
    }
    if Bytesˉreadˉu8(Input, Offset + Branch) != 49u8 {
        return Compilerˉwebassemblyˉcontrolˉfailure();
    }
    let Falseˉtarget: u32 = Bytesˉreadˉu32ˉlittle(Input, Offset + Branch + 1u32);
    if Falseˉtarget <= Branch + 5u32 { return Compilerˉwebassemblyˉcontrolˉfailure(); }
    if !Compilerˉwebassemblyˉcontrolˉisˉboundary(
        Input,
        Offset,
        Length,
        Falseˉtarget
    ) {
        return Compilerˉwebassemblyˉcontrolˉfailure();
    }
    let Bodyˉentry: u32 = Branch + 5u32;
    if Bytesˉreadˉu8(Input, Offset + Bodyˉentry) != 48u8 {
        return Compilerˉwebassemblyˉcontrolˉfailure();
    }
    if Bytesˉreadˉu32ˉlittle(Input, Offset + Bodyˉentry + 1u32) != Bodyˉentry + 5u32 {
        return Compilerˉwebassemblyˉcontrolˉfailure();
    }

    var Cursor: u32 = Bodyˉentry;
    var Backwardˉcount: u32 = 0u32;
    var Forwardˉcount: u32 = 0u32;
    var Header: u32 = Length;
    var Exitˉtarget: u32 = Falseˉtarget;
    while Cursor < Falseˉtarget {
        let Width: u32 = Compilerˉwebassemblyˉcontrolˉinstructionˉwidth(
            Input,
            Offset,
            Length,
            Cursor
        );
        if Width == 0u32 { return Compilerˉwebassemblyˉcontrolˉfailure(); }
        if Cursor + Width > Falseˉtarget {
            return Compilerˉwebassemblyˉcontrolˉfailure();
        }
        let Opcode: u8 = Bytesˉreadˉu8(Input, Offset + Cursor);
        if Opcode == 49u8 { return Compilerˉwebassemblyˉcontrolˉfailure(); }
        if Opcode == 48u8 {
            let Target: u32 = Bytesˉreadˉu32ˉlittle(Input, Offset + Cursor + 1u32);
            if Target >= Length { return Compilerˉwebassemblyˉcontrolˉfailure(); }
            if Target == Cursor { return Compilerˉwebassemblyˉcontrolˉfailure(); }
            if Target < Cursor {
                if Cursor + 5u32 != Falseˉtarget {
                    return Compilerˉwebassemblyˉcontrolˉfailure();
                }
                Backwardˉcount = Backwardˉcount + 1u32;
                Header = Target;
            }
            if Target > Cursor + 5u32 {
                if Cursor + 5u32 != Falseˉtarget {
                    return Compilerˉwebassemblyˉcontrolˉfailure();
                }
                Forwardˉcount = Forwardˉcount + 1u32;
                Exitˉtarget = Target;
            }
        }
        Cursor = Cursor + Width;
    }
    if Cursor != Falseˉtarget { return Compilerˉwebassemblyˉcontrolˉfailure(); }
    if Backwardˉcount > 1u32 { return Compilerˉwebassemblyˉcontrolˉfailure(); }
    if Forwardˉcount > 1u32 { return Compilerˉwebassemblyˉcontrolˉfailure(); }
    if Backwardˉcount != 0u32 {
        if Forwardˉcount != 0u32 { return Compilerˉwebassemblyˉcontrolˉfailure(); }
        if Header >= Branch { return Compilerˉwebassemblyˉcontrolˉfailure(); }
        if !Compilerˉwebassemblyˉcontrolˉisˉboundary(Input, Offset, Length, Header) {
            return Compilerˉwebassemblyˉcontrolˉfailure();
        }
        if !Compilerˉwebassemblyˉcontrolˉhasˉentryˉjump(Input, Offset, Length, Header) {
            return Compilerˉwebassemblyˉcontrolˉfailure();
        }
        return Compilerˉwebassemblyˉcontrol(
            true,
            1u32,
            Header,
            Falseˉtarget,
            Falseˉtarget
        );
    }
    if Forwardˉcount == 0u32 {
        return Compilerˉwebassemblyˉcontrol(
            true,
            2u32,
            Branch,
            Falseˉtarget,
            Falseˉtarget
        );
    }
    if Exitˉtarget <= Falseˉtarget { return Compilerˉwebassemblyˉcontrolˉfailure(); }
    if !Compilerˉwebassemblyˉcontrolˉisˉboundary(
        Input,
        Offset,
        Length,
        Exitˉtarget
    ) {
        return Compilerˉwebassemblyˉcontrolˉfailure();
    }
    Cursor = Falseˉtarget;
    while Cursor < Exitˉtarget {
        let Elseˉwidth: u32 = Compilerˉwebassemblyˉcontrolˉinstructionˉwidth(
            Input,
            Offset,
            Length,
            Cursor
        );
        if Elseˉwidth == 0u32 { return Compilerˉwebassemblyˉcontrolˉfailure(); }
        if Cursor + Elseˉwidth > Exitˉtarget {
            return Compilerˉwebassemblyˉcontrolˉfailure();
        }
        let Elseˉopcode: u8 = Bytesˉreadˉu8(Input, Offset + Cursor);
        if Elseˉopcode == 49u8 { return Compilerˉwebassemblyˉcontrolˉfailure(); }
        if Elseˉopcode == 48u8 {
            let Elseˉjump: u32 = Bytesˉreadˉu32ˉlittle(Input, Offset + Cursor + 1u32);
            if Elseˉjump != Cursor + 5u32 {
                return Compilerˉwebassemblyˉcontrolˉfailure();
            }
        }
        Cursor = Cursor + Elseˉwidth;
    }
    if Cursor != Exitˉtarget { return Compilerˉwebassemblyˉcontrolˉfailure(); }
    return Compilerˉwebassemblyˉcontrol(
        true,
        3u32,
        Branch,
        Falseˉtarget,
        Exitˉtarget
    );
}

export fn Compilerˉwebassemblyˉcontrolˉhasˉbackwardˉtarget(
    Input: bytes,
    Offset: u32,
    Length: u32,
    Header: u32
) -> bool {
    var Cursor: u32 = Header;
    while Cursor < Length {
        let Width: u32 = Compilerˉwebassemblyˉcontrolˉinstructionˉwidth(
            Input,
            Offset,
            Length,
            Cursor
        );
        if Width == 0u32 { return false; }
        if Bytesˉreadˉu8(Input, Offset + Cursor) == 48u8 {
            if Bytesˉreadˉu32ˉlittle(Input, Offset + Cursor + 1u32) == Header {
                if Cursor > Header { return true; }
            }
        }
        Cursor = Cursor + Width;
    }
    return false;
}

export fn Compilerˉwebassemblyˉvalidateˉsequentialˉcontrol(
    Input: bytes,
    Offset: u32,
    Length: u32,
    Localˉtypesˉoffset: u32,
    Localˉcount: u32,
    Declaredˉmaximumˉstack: u32
) -> Compilerˉwebassemblyˉcode {
    if Declaredˉmaximumˉstack != 2u32 {
        return Compilerˉwebassemblyˉcode(false, 0u32, 0u32);
    }
    var Cursor: u32 = 0u32;
    var Depth: u32 = 0u32;
    var Firstˉtype: u8 = 0u8;
    var Secondˉtype: u8 = 0u8;
    var Maximumˉstack: u32 = 0u32;
    var Instructionˉcount: u32 = 0u32;
    var Regionˉcount: u32 = 0u32;
    var Conditionalˉcount: u32 = 0u32;
    var Regionˉfloor: u32 = 0u32;
    var Activeˉkind: u32 = 0u32;
    var Activeˉheader: u32 = Length;
    var Activeˉfalse: u32 = Length;
    var Activeˉexit: u32 = Length;
    var Sawˉelse: bool = false;
    var Returned: bool = false;
    while Cursor < Length {
        if Activeˉkind == 2u32 {
            if Cursor == Activeˉfalse {
                Activeˉkind = 0u32;
                Regionˉfloor = Cursor;
                Regionˉcount = Regionˉcount + 1u32;
            }
        }
        if Activeˉkind == 3u32 {
            if Cursor == Activeˉfalse { Sawˉelse = true; }
            if Cursor == Activeˉexit {
                if !Sawˉelse { return Compilerˉwebassemblyˉcode(false, 0u32, 0u32); }
                Activeˉkind = 0u32;
                Sawˉelse = false;
                Regionˉfloor = Cursor;
                Regionˉcount = Regionˉcount + 1u32;
            }
        }
        if Instructionˉcount >= 4096u32 {
            return Compilerˉwebassemblyˉcode(false, 0u32, 0u32);
        }
        Instructionˉcount = Instructionˉcount + 1u32;
        let Opcode: u8 = Bytesˉreadˉu8(Input, Offset + Cursor);
        var Handled: bool = false;
        if Opcode == 1u8 {
            if !Compilerˉwebassemblyˉrangeˉisˉvalid(Length, Cursor, 5u32) {
                return Compilerˉwebassemblyˉcode(false, 0u32, 0u32);
            }
            if Depth == 0u32 { Firstˉtype = 1u8; }
            if Depth == 1u32 { Secondˉtype = 1u8; }
            if Depth >= 2u32 { return Compilerˉwebassemblyˉcode(false, 0u32, 0u32); }
            Depth = Depth + 1u32;
            Cursor = Cursor + 5u32;
            Handled = true;
        }
        if Opcode == 4u8 {
            if !Compilerˉwebassemblyˉrangeˉisˉvalid(Length, Cursor, 5u32) {
                return Compilerˉwebassemblyˉcode(false, 0u32, 0u32);
            }
            let Loadˉindex: u32 = Bytesˉreadˉu32ˉlittle(Input, Offset + Cursor + 1u32);
            if Loadˉindex >= Localˉcount {
                return Compilerˉwebassemblyˉcode(false, 0u32, 0u32);
            }
            let Loadˉtype: u8 = Bytesˉreadˉu8(Input, Localˉtypesˉoffset + Loadˉindex);
            if Depth == 0u32 { Firstˉtype = Loadˉtype; }
            if Depth == 1u32 { Secondˉtype = Loadˉtype; }
            if Depth >= 2u32 { return Compilerˉwebassemblyˉcode(false, 0u32, 0u32); }
            Depth = Depth + 1u32;
            Cursor = Cursor + 5u32;
            Handled = true;
        }
        if Opcode == 5u8 {
            if !Compilerˉwebassemblyˉrangeˉisˉvalid(Length, Cursor, 5u32) {
                return Compilerˉwebassemblyˉcode(false, 0u32, 0u32);
            }
            let Storeˉindex: u32 = Bytesˉreadˉu32ˉlittle(Input, Offset + Cursor + 1u32);
            if Storeˉindex >= Localˉcount { return Compilerˉwebassemblyˉcode(false, 0u32, 0u32); }
            if Depth == 0u32 { return Compilerˉwebassemblyˉcode(false, 0u32, 0u32); }
            let Storeˉtype: u8 = Bytesˉreadˉu8(Input, Localˉtypesˉoffset + Storeˉindex);
            var Stackˉtype: u8 = Firstˉtype;
            if Depth == 2u32 { Stackˉtype = Secondˉtype; }
            if Stackˉtype != Storeˉtype {
                return Compilerˉwebassemblyˉcode(false, 0u32, 0u32);
            }
            Depth = Depth - 1u32;
            Cursor = Cursor + 5u32;
            Handled = true;
        }
        var Arithmetic: bool = false;
        if Opcode == 16u8 { Arithmetic = true; }
        if Opcode == 17u8 { Arithmetic = true; }
        if Opcode == 18u8 { Arithmetic = true; }
        if Arithmetic {
            if Depth != 2u32 { return Compilerˉwebassemblyˉcode(false, 0u32, 0u32); }
            if Firstˉtype != 1u8 { return Compilerˉwebassemblyˉcode(false, 0u32, 0u32); }
            if Secondˉtype != 1u8 { return Compilerˉwebassemblyˉcode(false, 0u32, 0u32); }
            Depth = 1u32;
            Firstˉtype = 1u8;
            Cursor = Cursor + 1u32;
            Handled = true;
        }
        if Opcode == 19u8 {
            var Negateˉtype: u8 = Firstˉtype;
            if Depth == 2u32 { Negateˉtype = Secondˉtype; }
            if Depth == 0u32 { return Compilerˉwebassemblyˉcode(false, 0u32, 0u32); }
            if Negateˉtype != 1u8 { return Compilerˉwebassemblyˉcode(false, 0u32, 0u32); }
            Cursor = Cursor + 1u32;
            Handled = true;
        }
        var Comparison: bool = false;
        if Opcode == 32u8 { Comparison = true; }
        if Opcode == 33u8 { Comparison = true; }
        if Opcode == 34u8 { Comparison = true; }
        if Opcode == 35u8 { Comparison = true; }
        if Opcode == 36u8 { Comparison = true; }
        if Opcode == 37u8 { Comparison = true; }
        if Comparison {
            if Depth != 2u32 { return Compilerˉwebassemblyˉcode(false, 0u32, 0u32); }
            if Firstˉtype != 1u8 { return Compilerˉwebassemblyˉcode(false, 0u32, 0u32); }
            if Secondˉtype != 1u8 { return Compilerˉwebassemblyˉcode(false, 0u32, 0u32); }
            Depth = 1u32;
            Firstˉtype = 2u8;
            Cursor = Cursor + 1u32;
            Handled = true;
        }
        if Opcode == 48u8 {
            if Depth != 0u32 { return Compilerˉwebassemblyˉcode(false, 0u32, 0u32); }
            let Target: u32 = Bytesˉreadˉu32ˉlittle(Input, Offset + Cursor + 1u32);
            if Target >= Length { return Compilerˉwebassemblyˉcode(false, 0u32, 0u32); }
            if Target == Cursor { return Compilerˉwebassemblyˉcode(false, 0u32, 0u32); }
            if Target < Cursor {
                if Activeˉkind != 1u32 { return Compilerˉwebassemblyˉcode(false, 0u32, 0u32); }
                if Target != Activeˉheader { return Compilerˉwebassemblyˉcode(false, 0u32, 0u32); }
                if Cursor + 5u32 != Activeˉfalse {
                    return Compilerˉwebassemblyˉcode(false, 0u32, 0u32);
                }
                Activeˉkind = 0u32;
                Regionˉfloor = Activeˉfalse;
                Regionˉcount = Regionˉcount + 1u32;
            }
            if Target > Cursor + 5u32 {
                if Activeˉkind != 3u32 { return Compilerˉwebassemblyˉcode(false, 0u32, 0u32); }
                if Cursor + 5u32 != Activeˉfalse {
                    return Compilerˉwebassemblyˉcode(false, 0u32, 0u32);
                }
                if Target != Activeˉexit { return Compilerˉwebassemblyˉcode(false, 0u32, 0u32); }
            }
            Cursor = Cursor + 5u32;
            Handled = true;
        }
        if Opcode == 49u8 {
            if Depth != 1u32 { return Compilerˉwebassemblyˉcode(false, 0u32, 0u32); }
            if Firstˉtype != 2u8 { return Compilerˉwebassemblyˉcode(false, 0u32, 0u32); }
            if Activeˉkind != 0u32 { return Compilerˉwebassemblyˉcode(false, 0u32, 0u32); }
            let Region: Compilerˉwebassemblyˉcontrol =
                Compilerˉwebassemblyˉclassifyˉsequentialˉregion(
                    Input,
                    Offset,
                    Length,
                    Cursor
                );
            if !Region.Valid { return Compilerˉwebassemblyˉcode(false, 0u32, 0u32); }
            if Region.Header < Regionˉfloor {
                return Compilerˉwebassemblyˉcode(false, 0u32, 0u32);
            }
            Activeˉkind = Region.Kind;
            Activeˉheader = Region.Header;
            Activeˉfalse = Region.Falseˉtarget;
            Activeˉexit = Region.Exitˉtarget;
            if Region.Kind != 1u32 { Conditionalˉcount = Conditionalˉcount + 1u32; }
            Depth = 0u32;
            Cursor = Cursor + 5u32;
            Handled = true;
        }
        if Opcode == 80u8 {
            if Depth == 0u32 { return Compilerˉwebassemblyˉcode(false, 0u32, 0u32); }
            Depth = Depth - 1u32;
            Cursor = Cursor + 1u32;
            Handled = true;
        }
        if Opcode == 81u8 {
            if Activeˉkind != 0u32 { return Compilerˉwebassemblyˉcode(false, 0u32, 0u32); }
            if Depth != 1u32 { return Compilerˉwebassemblyˉcode(false, 0u32, 0u32); }
            if Firstˉtype != 1u8 { return Compilerˉwebassemblyˉcode(false, 0u32, 0u32); }
            if Cursor + 1u32 != Length { return Compilerˉwebassemblyˉcode(false, 0u32, 0u32); }
            Returned = true;
            Cursor = Cursor + 1u32;
            Handled = true;
        }
        if !Handled { return Compilerˉwebassemblyˉcode(false, 0u32, 0u32); }
        if Depth > Maximumˉstack { Maximumˉstack = Depth; }
    }
    if !Returned { return Compilerˉwebassemblyˉcode(false, 0u32, 0u32); }
    if Activeˉkind != 0u32 { return Compilerˉwebassemblyˉcode(false, 0u32, 0u32); }
    if Regionˉcount < 2u32 { return Compilerˉwebassemblyˉcode(false, 0u32, 0u32); }
    if Conditionalˉcount == 0u32 { return Compilerˉwebassemblyˉcode(false, 0u32, 0u32); }
    if Maximumˉstack != Declaredˉmaximumˉstack {
        return Compilerˉwebassemblyˉcode(false, 0u32, 0u32);
    }
    return Compilerˉwebassemblyˉcode(true, Instructionˉcount, Maximumˉstack);
}

export fn Compilerˉwebassemblyˉbyte(Value: u32) -> bytes {
    return Bytesˉslice(Bytesˉfromˉu32ˉlittle(Value), 0u32, 1u32);
}

export fn Compilerˉwebassemblyˉdivideˉoneˉhundredˉtwentyˉeight(
    Value: u32
) -> Compilerˉwebassemblyˉdivision {
    var Quotient: u32 = 0u32;
    var Remainder: u32 = Value;
    if Remainder >= 2147483648u32 { Remainder = Remainder - 2147483648u32; Quotient = Quotient + 16777216u32; }
    if Remainder >= 1073741824u32 { Remainder = Remainder - 1073741824u32; Quotient = Quotient + 8388608u32; }
    if Remainder >= 536870912u32 { Remainder = Remainder - 536870912u32; Quotient = Quotient + 4194304u32; }
    if Remainder >= 268435456u32 { Remainder = Remainder - 268435456u32; Quotient = Quotient + 2097152u32; }
    if Remainder >= 134217728u32 { Remainder = Remainder - 134217728u32; Quotient = Quotient + 1048576u32; }
    if Remainder >= 67108864u32 { Remainder = Remainder - 67108864u32; Quotient = Quotient + 524288u32; }
    if Remainder >= 33554432u32 { Remainder = Remainder - 33554432u32; Quotient = Quotient + 262144u32; }
    if Remainder >= 16777216u32 { Remainder = Remainder - 16777216u32; Quotient = Quotient + 131072u32; }
    if Remainder >= 8388608u32 { Remainder = Remainder - 8388608u32; Quotient = Quotient + 65536u32; }
    if Remainder >= 4194304u32 { Remainder = Remainder - 4194304u32; Quotient = Quotient + 32768u32; }
    if Remainder >= 2097152u32 { Remainder = Remainder - 2097152u32; Quotient = Quotient + 16384u32; }
    if Remainder >= 1048576u32 { Remainder = Remainder - 1048576u32; Quotient = Quotient + 8192u32; }
    if Remainder >= 524288u32 { Remainder = Remainder - 524288u32; Quotient = Quotient + 4096u32; }
    if Remainder >= 262144u32 { Remainder = Remainder - 262144u32; Quotient = Quotient + 2048u32; }
    if Remainder >= 131072u32 { Remainder = Remainder - 131072u32; Quotient = Quotient + 1024u32; }
    if Remainder >= 65536u32 { Remainder = Remainder - 65536u32; Quotient = Quotient + 512u32; }
    if Remainder >= 32768u32 { Remainder = Remainder - 32768u32; Quotient = Quotient + 256u32; }
    if Remainder >= 16384u32 { Remainder = Remainder - 16384u32; Quotient = Quotient + 128u32; }
    if Remainder >= 8192u32 { Remainder = Remainder - 8192u32; Quotient = Quotient + 64u32; }
    if Remainder >= 4096u32 { Remainder = Remainder - 4096u32; Quotient = Quotient + 32u32; }
    if Remainder >= 2048u32 { Remainder = Remainder - 2048u32; Quotient = Quotient + 16u32; }
    if Remainder >= 1024u32 { Remainder = Remainder - 1024u32; Quotient = Quotient + 8u32; }
    if Remainder >= 512u32 { Remainder = Remainder - 512u32; Quotient = Quotient + 4u32; }
    if Remainder >= 256u32 { Remainder = Remainder - 256u32; Quotient = Quotient + 2u32; }
    if Remainder >= 128u32 { Remainder = Remainder - 128u32; Quotient = Quotient + 1u32; }
    return Compilerˉwebassemblyˉdivision(Quotient, Remainder);
}

export fn Compilerˉwebassemblyˉuleb32(Value: u32) -> bytes {
    var Remaining: u32 = Value;
    var Result: bytes = Compilerˉwebassemblyˉempty(Bytesˉfromˉu8(0u8));
    var Complete: bool = false;
    while !Complete {
        let Division: Compilerˉwebassemblyˉdivision =
            Compilerˉwebassemblyˉdivideˉoneˉhundredˉtwentyˉeight(Remaining);
        var Byteˉvalue: u32 = Division.Remainder;
        if Division.Quotient != 0u32 {
            Byteˉvalue = Byteˉvalue + 128u32;
        }
        Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉbyte(Byteˉvalue));
        Remaining = Division.Quotient;
        if Remaining == 0u32 { Complete = true; }
    }
    return Result;
}

export fn Compilerˉwebassemblyˉdivideˉbyte(
    Value: u32,
    Divisor: u32
) -> Compilerˉwebassemblyˉdivision {
    if Divisor == 0u32 {
        return Compilerˉwebassemblyˉdivision(0u32, Value);
    }
    var Quotient: u32 = 0u32;
    var Remainder: u32 = Value;
    while Remainder >= Divisor {
        Remainder = Remainder - Divisor;
        Quotient = Quotient + 1u32;
    }
    return Compilerˉwebassemblyˉdivision(Quotient, Remainder);
}

export fn Compilerˉwebassemblyˉsleb32(
    Input: bytes,
    Offset: u32
) -> bytes {
    let B0: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(Input, Offset));
    let B1: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(Input, Offset + 1u32));
    let B2: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(Input, Offset + 2u32));
    let B3: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(Input, Offset + 3u32));
    let D0: Compilerˉwebassemblyˉdivision = Compilerˉwebassemblyˉdivideˉbyte(B0, 128u32);
    let D1: Compilerˉwebassemblyˉdivision = Compilerˉwebassemblyˉdivideˉbyte(B1, 64u32);
    let D2: Compilerˉwebassemblyˉdivision = Compilerˉwebassemblyˉdivideˉbyte(B2, 32u32);
    let D3: Compilerˉwebassemblyˉdivision = Compilerˉwebassemblyˉdivideˉbyte(B3, 16u32);
    var G0: u32 = D0.Remainder;
    var G1: u32 = D0.Quotient + D1.Remainder * 2u32;
    var G2: u32 = D1.Quotient + D2.Remainder * 4u32;
    var G3: u32 = D2.Quotient + D3.Remainder * 8u32;
    var G4: u32 = D3.Quotient;
    if B3 >= 128u32 { G4 = G4 + 112u32; }

    let Value: i32 = Bytesˉreadˉi32ˉlittle(Input, Offset);
    var Length: u32 = 5u32;
    if Value >= -64 {
        if Value <= 63 { Length = 1u32; }
    }
    if Length == 5u32 {
        if Value >= -8192 {
            if Value <= 8191 { Length = 2u32; }
        }
    }
    if Length == 5u32 {
        if Value >= -1048576 {
            if Value <= 1048575 { Length = 3u32; }
        }
    }
    if Length == 5u32 {
        if Value >= -134217728 {
            if Value <= 134217727 { Length = 4u32; }
        }
    }

    if Length > 1u32 { G0 = G0 + 128u32; }
    if Length > 2u32 { G1 = G1 + 128u32; }
    if Length > 3u32 { G2 = G2 + 128u32; }
    if Length > 4u32 { G3 = G3 + 128u32; }

    var Result: bytes = Compilerˉwebassemblyˉbyte(G0);
    if Length > 1u32 { Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉbyte(G1)); }
    if Length > 2u32 { Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉbyte(G2)); }
    if Length > 3u32 { Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉbyte(G3)); }
    if Length > 4u32 { Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉbyte(G4)); }
    return Result;
}

export fn Compilerˉwebassemblyˉpositiveˉsleb32(Value: u32) -> bytes {
    var Remaining: u32 = Value;
    var Result: bytes = Compilerˉwebassemblyˉempty(Bytesˉfromˉu8(0u8));
    var Complete: bool = false;
    while !Complete {
        let Division: Compilerˉwebassemblyˉdivision =
            Compilerˉwebassemblyˉdivideˉoneˉhundredˉtwentyˉeight(Remaining);
        var Byteˉvalue: u32 = Division.Remainder;
        var More: bool = Division.Quotient != 0u32;
        if !More {
            if Division.Remainder >= 64u32 { More = true; }
        }
        if More { Byteˉvalue = Byteˉvalue + 128u32; }
        Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉbyte(Byteˉvalue));
        Remaining = Division.Quotient;
        if !More { Complete = true; }
    }
    return Result;
}

export fn Compilerˉwebassemblyˉsectionˉbytes(
    Kind: u32,
    Payload: bytes
) -> bytes {
    var Result: bytes = Compilerˉwebassemblyˉbyte(Kind);
    Result = Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉuleb32(Bytesˉlength(Payload))
    );
    return Bytesˉconcat(Result, Payload);
}

export fn Compilerˉwebassemblyˉmainˉname() -> bytes {
    return Textˉtoˉutf8("Main");
}

export fn Compilerˉwebassemblyˉstring(Value: bytes) -> bytes {
    return Bytesˉconcat(
        Compilerˉwebassemblyˉuleb32(Bytesˉlength(Value)),
        Value
    );
}

export fn Compilerˉwebassemblyˉsleb32ˉvalue(Value: i32) -> bytes {
    return Compilerˉwebassemblyˉsleb32(Bytesˉfromˉi32ˉlittle(Value), 0u32);
}

export fn Compilerˉwebassemblyˉi32ˉconstantˉfromˉinput(
    Input: bytes,
    Offset: u32
) -> bytes {
    return Bytesˉconcat(
        Compilerˉwebassemblyˉbyte(65u32),
        Compilerˉwebassemblyˉsleb32(Input, Offset)
    );
}

export fn Compilerˉwebassemblyˉi32ˉconstant(Value: i32) -> bytes {
    return Bytesˉconcat(
        Compilerˉwebassemblyˉbyte(65u32),
        Compilerˉwebassemblyˉsleb32ˉvalue(Value)
    );
}

export fn Compilerˉwebassemblyˉpositiveˉi32ˉconstant(Value: u32) -> bytes {
    return Bytesˉconcat(
        Compilerˉwebassemblyˉbyte(65u32),
        Compilerˉwebassemblyˉpositiveˉsleb32(Value)
    );
}

export fn Compilerˉwebassemblyˉindexedˉinstruction(
    Opcode: u32,
    Index: u32
) -> bytes {
    return Bytesˉconcat(
        Compilerˉwebassemblyˉbyte(Opcode),
        Compilerˉwebassemblyˉuleb32(Index)
    );
}

export fn Compilerˉwebassemblyˉchargeˉinstruction(Step: u32) -> bytes {
    return Bytesˉconcat(
        Compilerˉwebassemblyˉpositiveˉi32ˉconstant(Step),
        Compilerˉwebassemblyˉindexedˉinstruction(36u32, 2u32)
    );
}

export fn Compilerˉwebassemblyˉmeterˉinstruction() -> bytes {
    var Result: bytes = Compilerˉwebassemblyˉindexedˉinstruction(35u32, 2u32);
    Result = Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉindexedˉinstruction(32u32, 0u32)
    );
    Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉbyte(79u32));
    Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉbyte(4u32));
    Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉbyte(64u32));
    Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉi32ˉconstant(3011));
    Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉbyte(15u32));
    Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉbyte(11u32));
    Result = Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉindexedˉinstruction(35u32, 2u32)
    );
    Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉi32ˉconstant(1));
    Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉbyte(106u32));
    return Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉindexedˉinstruction(36u32, 2u32)
    );
}

export fn Compilerˉwebassemblyˉoverflowˉreturn() -> bytes {
    var Result: bytes = Compilerˉwebassemblyˉbyte(4u32);
    Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉbyte(64u32));
    Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉi32ˉconstant(3007));
    Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉbyte(15u32));
    return Bytesˉconcat(Result, Compilerˉwebassemblyˉbyte(11u32));
}

export fn Compilerˉwebassemblyˉcheckedˉaddˉinstructions(
    Left: u32,
    Right: u32,
    Arithmeticˉresult: u32
) -> bytes {
    var Result: bytes = Compilerˉwebassemblyˉindexedˉinstruction(33u32, Right);
    Result = Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉindexedˉinstruction(33u32, Left)
    );
    Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉindexedˉinstruction(32u32, Left));
    Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉindexedˉinstruction(32u32, Right));
    Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉbyte(106u32));
    Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉindexedˉinstruction(34u32, Arithmeticˉresult));
    Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉindexedˉinstruction(32u32, Left));
    Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉbyte(115u32));
    Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉindexedˉinstruction(32u32, Arithmeticˉresult));
    Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉindexedˉinstruction(32u32, Right));
    Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉbyte(115u32));
    Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉbyte(113u32));
    Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉi32ˉconstant(0));
    Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉbyte(72u32));
    Result = Bytesˉconcat(Result, Compilerˉwebassemblyˉoverflowˉreturn());
    return Bytesˉconcat(
        Result,
        Compilerˉwebassemblyˉindexedˉinstruction(32u32, Arithmeticˉresult)
    );
}

