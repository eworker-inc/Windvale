    }
    if Opcode == 11u8 {
        if Reclaiming {
            Result = Bytesˉconcat(
                Result,
                Compilerˉwebassemblyˉindexedˉinstruction(
                    33u32, Descriptorˉfirst
                )
            );
            Result = Bytesˉconcat(
                Result,
