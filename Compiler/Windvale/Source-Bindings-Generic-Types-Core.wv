#!wv/1 en@1
module Compilerˉsourceˉbindingsˉgenericˉtypes;
profile core;
platform linux, windows, windvale;
authority library;

import Compilerˉsourceˉbindings as Bindings;
import Compilerˉsourceˉgenericˉlowering as Sourceˉgenerics;
import Compilerˉsourceˉgenericˉtypeˉlowering as Genericˉtypes;
import Compilerˉsourceˉset as Sourceˉset;
import Compilerˉsourceˉsymbols as Sourceˉsymbols;

fn Compilerˉsourceˉbindingsˉgenericˉtypesˉheader(
    Entries: u32,
    Ranges: u32,
    Functionˉcatalogˉbytes: u32,
    Typeˉcatalogˉbytes: u32
) -> bytes {
    var Result: bytes = Textˉtoˉutf8("WVLB");
    Result = Bytesˉconcat(Result, Bytesˉfromˉu16ˉlittle(1u32));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu16ˉlittle(3u32));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Entries));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(36u32));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Ranges));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(16u32));
    Result = Bytesˉconcat(
        Result, Bytesˉfromˉu32ˉlittle(Functionˉcatalogˉbytes)
    );
    Result = Bytesˉconcat(
        Result, Bytesˉfromˉu32ˉlittle(Typeˉcatalogˉbytes)
    );
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(2u32));
    return Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(0u32));
}

fn Compilerˉsourceˉbindingsˉgenericˉtypesˉranges(
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Build: Bindings.Compilerˉsourceˉbindingˉbuild,
    Functions: u32,
    Catalog: Sourceˉgenerics.Compilerˉsourceˉgenericˉcatalog
) -> bytes {
    let Symbolˉentries: u32 = Bytesˉreadˉu32ˉlittle(
        Symbols.Directory, 8u32
    );
    var Result: bytes = Bindings.Compilerˉsourceˉbindingsˉempty(
        Symbols.Directory
    );
    var Binding: u32 = 0u32;
    var Function: u32 = 0u32;
    while Function < Functions {
        let First: u32 = Binding;
        var Count: u32 = 0u32;
        var Reading: bool = true;
        while Reading {
            if Binding >= Build.Entries {
                Reading = false;
            } else {
                let Entry: u32 = Binding * 36u32;
                if Bytesˉreadˉu32ˉlittle(
                        Build.Payload, Entry + 4u32
                    ) != Function {
                    Reading = false;
                } else {
                    Binding = Binding + 1u32;
                    Count = Count + 1u32;
                }
            }
        }
        var Declaration: u32 = Function;
        var Instance: u32 = 4294967295u32;
        if Function >= Symbolˉentries {
            Instance = Function - Symbolˉentries;
            Declaration =
                Sourceˉgenerics.Compilerˉsourceˉgenericˉcatalogˉinstanceˉdeclaration(
                    Catalog, Instance
                );
        }
        Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(First));
        Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Count));
        Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Declaration));
        Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Instance));
        Function = Function + 1u32;
    }
    return Result;
}

export fn Compilerˉsourceˉbindingsˉgenericˉtypesˉdirectory(
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Build: Bindings.Compilerˉsourceˉbindingˉbuild,
    Functions: u32,
    Functionˉcatalog: Sourceˉgenerics.Compilerˉsourceˉgenericˉcatalog,
    Typeˉcatalog: Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog
) -> bytes {
    let Typeˉinstances: u32 =
        Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalogˉinstances(
            Typeˉcatalog
        );
    if Typeˉinstances == 0u32 {
        return Bindings.Compilerˉsourceˉbindingsˉspecializedˉdirectory(
            Symbols, Build, Functions, Functionˉcatalog
        );
    }
    let Functionˉinstances: u32 =
        Sourceˉgenerics.Compilerˉsourceˉgenericˉcatalogˉinstances(
            Functionˉcatalog
        );
    var Functionˉevidence: bytes = Bindings.Compilerˉsourceˉbindingsˉempty(
        Typeˉcatalog.Evidence
    );
    if Functionˉinstances > 0u32 {
        Functionˉevidence = Functionˉcatalog.Evidence;
    }
    let Header: bytes = Compilerˉsourceˉbindingsˉgenericˉtypesˉheader(
        Build.Entries,
        Functions,
        Bytesˉlength(Functionˉevidence),
        Bytesˉlength(Typeˉcatalog.Evidence)
    );
    let Ranges: bytes =
        Compilerˉsourceˉbindingsˉgenericˉtypesˉranges(
            Symbols, Build, Functions, Functionˉcatalog
        );
    return Bytesˉconcat(
        Bytesˉconcat(
            Bytesˉconcat(
                Bytesˉconcat(Header, Ranges), Functionˉevidence
            ),
            Typeˉcatalog.Evidence
        ),
        Build.Payload
    );
}

fn Compilerˉsourceˉbindingsˉgenericˉtypesˉsummaryˉwithˉdirectory(
    Summary: Bindings.Compilerˉsourceˉbindingˉsummary,
    Directory: bytes
) -> Bindings.Compilerˉsourceˉbindingˉsummary {
    return Bindings.Compilerˉsourceˉbindingˉsummary(
        Summary.Status,
        Summary.Symbolˉstatus,
        Summary.Modules,
        Summary.Functions,
        Summary.Parameters,
        Summary.Locals,
        Summary.Reads,
        Summary.Assignments,
        Summary.Calls,
        Directory,
        Summary.Failureˉmodule,
        Summary.Failureˉrelatedˉmodule,
        Summary.Failureˉfunction,
        Summary.Failureˉoffset,
        Summary.Failureˉline,
        Summary.Failureˉcolumn
    );
}

export fn Compilerˉsourceˉbindingsˉgenericˉtypesˉfinishˉspecializedˉphaseˉproduct(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Phase: Bindings.Compilerˉsourceˉbindingˉphase,
    Functions: u32,
    Functionˉcatalog: Sourceˉgenerics.Compilerˉsourceˉgenericˉcatalog,
    Typeˉcatalog: Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog
) -> Bindings.Compilerˉsourceˉbindingˉsummary {
    if Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalogˉisˉvalid(
            Typeˉcatalog
        ) &&
        Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalogˉinstances(
            Typeˉcatalog
        ) == 0u32 {
        return Bindings.Compilerˉsourceˉbindingsˉfinishˉspecializedˉphaseˉproduct(
            Input, Scan, Symbols, Phase,
            Functions, Functionˉcatalog
        );
    }
    let Baseˉsummary: Bindings.Compilerˉsourceˉbindingˉsummary =
        Bindings.Compilerˉsourceˉbindingsˉfinishˉspecializedˉphaseˉproduct(
            Input, Scan, Symbols, Phase,
            Functions, Functionˉcatalog
        );
    if Baseˉsummary.Status != Bindings.Compilerˉsourceˉbindingˉstatus.Valid {
        return Baseˉsummary;
    }
    let Build: Bindings.Compilerˉsourceˉbindingˉbuild =
        Bindings.Compilerˉsourceˉbindingsˉphaseˉbuildˉvalue(Phase);
    let Functionˉinstances: u32 =
        Sourceˉgenerics.Compilerˉsourceˉgenericˉcatalogˉinstances(
            Functionˉcatalog
        );
    if !Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalogˉisˉvalid(
            Typeˉcatalog
        ) ||
        Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalogˉinstances(
            Typeˉcatalog
        ) == 0u32 {
        let Invalidˉcatalog: Bindings.Compilerˉsourceˉbindingˉbuild =
            Bindings.Compilerˉsourceˉbindingsˉbuildˉfailure(
                Build,
                Bindings.Compilerˉsourceˉbindingˉstatus.Invalidˉdirectory,
                Symbols.Modules,
                Symbols.Modules,
                Functions,
                Bytesˉlength(Input),
                0u32,
                0u32
            );
        return Bindings.Compilerˉsourceˉbindingsˉsummaryˉfromˉbuild(
            Input, Symbols, Invalidˉcatalog
        );
    }
    var Functionˉbytes: u32 = 0u32;
    if Functionˉinstances > 0u32 {
        Functionˉbytes = Bytesˉlength(Functionˉcatalog.Evidence);
    }
    if Functions > 262141u32 {
        let Tooˉmany: Bindings.Compilerˉsourceˉbindingˉbuild =
            Bindings.Compilerˉsourceˉbindingsˉbuildˉfailure(
                Build,
                Bindings.Compilerˉsourceˉbindingˉstatus.Evidenceˉlimit,
                Symbols.Modules,
                Symbols.Modules,
                Functions,
                Bytesˉlength(Input),
                0u32,
                0u32
            );
        return Bindings.Compilerˉsourceˉbindingsˉsummaryˉfromˉbuild(
            Input, Symbols, Tooˉmany
        );
    }
    let Directoryˉoverhead: u32 = 40u32 + Functions * 16u32 +
        Functionˉbytes + Bytesˉlength(Typeˉcatalog.Evidence);
    if Directoryˉoverhead > 4194304u32 ||
        Bytesˉlength(Build.Payload) > 4194304u32 - Directoryˉoverhead {
        let Tooˉlarge: Bindings.Compilerˉsourceˉbindingˉbuild =
            Bindings.Compilerˉsourceˉbindingsˉbuildˉfailure(
                Build,
                Bindings.Compilerˉsourceˉbindingˉstatus.Evidenceˉlimit,
                Symbols.Modules,
                Symbols.Modules,
                Functions,
                Bytesˉlength(Input),
                0u32,
                0u32
            );
        return Bindings.Compilerˉsourceˉbindingsˉsummaryˉfromˉbuild(
            Input, Symbols, Tooˉlarge
        );
    }
    let Directory: bytes =
        Compilerˉsourceˉbindingsˉgenericˉtypesˉdirectory(
            Symbols, Build, Functions, Functionˉcatalog, Typeˉcatalog
        );
    return Compilerˉsourceˉbindingsˉgenericˉtypesˉsummaryˉwithˉdirectory(
        Baseˉsummary, Directory
    );
}
