        }
        if First == 117u8 {
            if Compilerˉsourceˉspanˉequalsˉtext(Input, Offset, Length, "using") { return Compilerˉtokenˉkind.Using; }
        }
        return Compilerˉtokenˉkind.Identifier;
    }
    if Length == 6u32 {
        if First == 98u8 {
            if Compilerˉsourceˉspanˉequalsˉtext(Input, Offset, Length, "borrow") { return Compilerˉtokenˉkind.Borrow; }
        }
        if First == 101u8 {
            if Compilerˉsourceˉspanˉequalsˉtext(Input, Offset, Length, "export") { return Compilerˉtokenˉkind.Export; }
        }
        if First == 104u8 {
            if Compilerˉsourceˉspanˉequalsˉtext(Input, Offset, Length, "hosted") { return Compilerˉtokenˉkind.Hosted; }
        }
        if First == 112u8 {
            if Compilerˉsourceˉspanˉequalsˉtext(Input, Offset, Length, "policy") { return Compilerˉtokenˉkind.Policy; }
        }
        if First == 102u8 {
            if Compilerˉsourceˉspanˉequalsˉtext(Input, Offset, Length, "freeze") { return Compilerˉtokenˉkind.Freeze; }
        }
        if First == 105u8 {
            if Compilerˉsourceˉspanˉequalsˉtext(Input, Offset, Length, "import") { return Compilerˉtokenˉkind.Import; }
        }
        if First == 108u8 {
            if Compilerˉsourceˉspanˉequalsˉtext(Input, Offset, Length, "length") { return Compilerˉtokenˉkind.Length; }
        }
        if First == 109u8 {
            if Compilerˉsourceˉspanˉequalsˉtext(Input, Offset, Length, "module") { return Compilerˉtokenˉkind.Module; }
        }
        if First == 114u8 {
            if Compilerˉsourceˉspanˉequalsˉtext(Input, Offset, Length, "record") { return Compilerˉtokenˉkind.Record; }
            if Compilerˉsourceˉspanˉequalsˉtext(Input, Offset, Length, "return") { return Compilerˉtokenˉkind.Return; }
        }
        if First == 115u8 {
            if Compilerˉsourceˉspanˉequalsˉtext(Input, Offset, Length, "system") { return Compilerˉtokenˉkind.System; }
        }
        if First == 117u8 {
            if Compilerˉsourceˉspanˉequalsˉtext(Input, Offset, Length, "unsafe") { return Compilerˉtokenˉkind.Unsafe; }
        }
        return Compilerˉtokenˉkind.Identifier;
    }
    if Length == 11u32 {
        if First == 99u8 {
            if Compilerˉsourceˉspanˉequalsˉtext(Input, Offset, Length, "cancel_join") { return Compilerˉtokenˉkind.Cancelˉjoin; }
        }
        return Compilerˉtokenˉkind.Identifier;
    }
    if Length == 7u32 {
        if First == 102u8 {
            if Compilerˉsourceˉspanˉequalsˉtext(Input, Offset, Length, "foreign") { return Compilerˉtokenˉkind.Foreign; }
        }
        let Sevenˉhead: u32 = Bytesˉreadˉu32ˉlittle(Input, Offset);
        let Sevenˉtail: u32 = Bytesˉreadˉu32ˉlittle(Input, Offset + 3u32);
        if Sevenˉhead == 1701209701u32 {
            if Sevenˉtail == 1937007461u32 { return Compilerˉtokenˉkind.Effects; }
        }
        if Sevenˉhead == 1818850658u32 {
            if Sevenˉtail == 1919247468u32 { return Compilerˉtokenˉkind.Builder; }
        }
        if Sevenˉhead == 1718579824u32 {
            if Sevenˉtail == 1701603686u32 { return Compilerˉtokenˉkind.Profile; }
        }
        if Sevenˉhead == 1769103734u32 {
            if Sevenˉtail == 1953390953u32 { return Compilerˉtokenˉkind.Variant; }
        }
        if Sevenˉhead == 1936876918u32 {
            if Sevenˉtail == 1852795251u32 { return Compilerˉtokenˉkind.Version; }
        }
        return Compilerˉtokenˉkind.Identifier;
    }
    if Length == 8u32 {
        let Eightˉhead: u32 = Bytesˉreadˉu32ˉlittle(Input, Offset);
        let Eightˉtail: u32 = Bytesˉreadˉu32ˉlittle(Input, Offset + 4u32);
        if Eightˉhead == 1953394531u32 {
            if Eightˉtail == 1702194793u32 { return Compilerˉtokenˉkind.Continue; }
        }
        if Eightˉhead == 1769238639u32 {
            if Eightˉtail == 1818324591u32 { return Compilerˉtokenˉkind.Optional; }
        }
        if Eightˉhead == 1952541808u32 {
            if Eightˉtail == 1836216166u32 { return Compilerˉtokenˉkind.Platform; }
        }
        if Eightˉhead == 1953656688u32 {
            if Eightˉtail == 1701601889u32 { return Compilerˉtokenˉkind.Portable; }
        }
        if Eightˉhead == 1970365810u32 {
            if Eightˉtail == 1936028265u32 { return Compilerˉtokenˉkind.Requires; }
        }
        if Eightˉhead == 1970365811u32 {
            if Eightˉtail == 1701015141u32 { return Compilerˉtokenˉkind.Sequence; }
        }
        return Compilerˉtokenˉkind.Identifier;
    }
    if Length == 9u32 {
        if First == 102u8 {
            if Compilerˉsourceˉspanˉequalsˉtext(Input, Offset, Length, "fail_join") { return Compilerˉtokenˉkind.Failˉjoin; }
        }
        if Compilerˉsourceˉspanˉequalsˉtext(Input, Offset, Length, "authority") { return Compilerˉtokenˉkind.Authority; }
        return Compilerˉtokenˉkind.Identifier;
    }
    if Length == 10u32 {
        if Compilerˉsourceˉspanˉequalsˉtext(Input, Offset, Length, "capability") { return Compilerˉtokenˉkind.Capability; }
    }
    return Compilerˉtokenˉkind.Identifier;
}

export fn Compilerˉsourceˉhexˉdigit(Value: u8) -> u32 {
    let Character: u32 = U32ˉfromˉu8(Value);
    if Character >= 48u32 {
        if Character <= 57u32 { return Character - 48u32; }
    }
    if Character >= 65u32 {
        if Character <= 70u32 { return Character - 55u32; }
    }
    if Character >= 97u32 {
        if Character <= 102u32 { return Character - 87u32; }
    }
    return 16u32;
}

export fn Compilerˉsourceˉtokenˉmake(
    Status: Compilerˉlexˉstatus,
    Kind: Compilerˉtokenˉkind,
    Offset: u32,
    Nextˉoffset: u32,
    Line: u32,
    Column: u32,
    Nextˉline: u32,
    Nextˉcolumn: u32,
    Numericˉkind: Compilerˉnumericˉkind,
    Numericˉvalue: u32,
    Failureˉoffset: u32,
    Failureˉline: u32,
    Failureˉcolumn: u32
) -> Compilerˉsourceˉtoken {
    return Compilerˉsourceˉtoken(
        Status,
        Kind,
        Offset,
        Nextˉoffset - Offset,
        Nextˉoffset,
        Line,
        Column,
        Nextˉline,
        Nextˉcolumn,
        Numericˉkind,
        Numericˉvalue,
        0u32,
        Failureˉoffset,
        Failureˉline,
        Failureˉcolumn
    );
}

record Compilerˉsourceˉwideˉparse {
    Valid: bool;
    Low: u32;
    High: u32;
}

fn Compilerˉsourceˉwideˉdecimalˉparse(
    Input: bytes,
    Offset: u32,
    Length: u32
) -> Compilerˉsourceˉwideˉparse {
    let Total: u32 = Bytesˉlength(Input);
    if Offset > Total { return Compilerˉsourceˉwideˉparse(false, 0u32, 0u32); }
    if Length > Total - Offset { return Compilerˉsourceˉwideˉparse(false, 0u32, 0u32); }
    if Length == 0u32 { return Compilerˉsourceˉwideˉparse(false, 0u32, 0u32); }
    if Length > 20u32 { return Compilerˉsourceˉwideˉparse(false, 0u32, 0u32); }

    var Limbˉzero: u32 = 0u32;
    var Limbˉone: u32 = 0u32;
    var Limbˉtwo: u32 = 0u32;
    var Limbˉthree: u32 = 0u32;
    var Index: u32 = 0u32;
    while Index < Length {
        let Character: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(Input, Offset + Index));
        if Character < 48u32 { return Compilerˉsourceˉwideˉparse(false, 0u32, 0u32); }
        if Character > 57u32 { return Compilerˉsourceˉwideˉparse(false, 0u32, 0u32); }
        var Carry: u32 = Character - 48u32;
        var Expanded: u32 = Limbˉzero * 10u32 + Carry;
        Limbˉzero = Expanded % 65536u32;
        Carry = Expanded / 65536u32;
        Expanded = Limbˉone * 10u32 + Carry;
        Limbˉone = Expanded % 65536u32;
        Carry = Expanded / 65536u32;
        Expanded = Limbˉtwo * 10u32 + Carry;
        Limbˉtwo = Expanded % 65536u32;
        Carry = Expanded / 65536u32;
        Expanded = Limbˉthree * 10u32 + Carry;
        Limbˉthree = Expanded % 65536u32;
        Carry = Expanded / 65536u32;
        if Carry != 0u32 { return Compilerˉsourceˉwideˉparse(false, 0u32, 0u32); }
        Index = Index + 1u32;
    }
    return Compilerˉsourceˉwideˉparse(
        true,
        Limbˉzero + Limbˉone * 65536u32,
        Limbˉtwo + Limbˉthree * 65536u32
    );
}

fn Compilerˉsourceˉtokenˉmakeˉwide(
    Status: Compilerˉlexˉstatus,
    Kind: Compilerˉtokenˉkind,
    Offset: u32,
    Nextˉoffset: u32,
    Line: u32,
    Column: u32,
    Nextˉline: u32,
    Nextˉcolumn: u32,
    Numericˉkind: Compilerˉnumericˉkind,
    Numericˉvalue: u32,
    Numericˉhigh: u32,
    Failureˉoffset: u32,
    Failureˉline: u32,
    Failureˉcolumn: u32
) -> Compilerˉsourceˉtoken {
    return Compilerˉsourceˉtoken(
        Status, Kind, Offset, Nextˉoffset - Offset, Nextˉoffset,
        Line, Column, Nextˉline, Nextˉcolumn,
        Numericˉkind, Numericˉvalue, Numericˉhigh,
        Failureˉoffset, Failureˉline, Failureˉcolumn
    );
}

export fn Compilerˉsourceˉintegerˉfits(
    Kind: Compilerˉnumericˉkind,
    Low: u32,
    High: u32,
    Negative: bool
) -> bool {
    if Kind == Compilerˉnumericˉkind.U64 { return !Negative; }
    if Kind == Compilerˉnumericˉkind.I64 {
        if High < 2147483648u32 { return true; }
        return Negative && High == 2147483648u32 && Low == 0u32;
    }
    if High != 0u32 { return false; }
    if Kind == Compilerˉnumericˉkind.U32 { return !Negative; }
    if Kind == Compilerˉnumericˉkind.U8 {
        return !Negative && Low <= 255u32;
    }
    if Kind == Compilerˉnumericˉkind.U16 {
        return !Negative && Low <= 65535u32;
    }
    if Kind == Compilerˉnumericˉkind.I8 {
        if Negative { return Low <= 128u32; }
        return Low <= 127u32;
    }
    if Kind == Compilerˉnumericˉkind.I16 {
        if Negative { return Low <= 32768u32; }
        return Low <= 32767u32;
    }
    if Kind == Compilerˉnumericˉkind.I32 {
        if Negative { return Low <= 2147483648u32; }
        return Low <= 2147483647u32;
    }
    return false;
}

export fn Compilerˉsourceˉnumericˉkindˉfromˉtoken(
    Kind: Compilerˉtokenˉkind
) -> Compilerˉnumericˉkind {
    if Kind == Compilerˉtokenˉkind.I8 { return Compilerˉnumericˉkind.I8; }
    if Kind == Compilerˉtokenˉkind.I16 { return Compilerˉnumericˉkind.I16; }
    if Kind == Compilerˉtokenˉkind.I32 { return Compilerˉnumericˉkind.I32; }
    if Kind == Compilerˉtokenˉkind.I64 { return Compilerˉnumericˉkind.I64; }
    if Kind == Compilerˉtokenˉkind.U8 { return Compilerˉnumericˉkind.U8; }
    if Kind == Compilerˉtokenˉkind.U16 { return Compilerˉnumericˉkind.U16; }
    if Kind == Compilerˉtokenˉkind.U32 { return Compilerˉnumericˉkind.U32; }
    if Kind == Compilerˉtokenˉkind.U64 { return Compilerˉnumericˉkind.U64; }
    return Compilerˉnumericˉkind.None;
}

fn Compilerˉsourceˉsignedˉadd(
    Left: Compilerˉsourceˉsignedˉmagnitude,
    Right: Compilerˉsourceˉsignedˉmagnitude
) -> Compilerˉsourceˉsignedˉmagnitude {
    if Left.Negative == Right.Negative {
        return Compilerˉsourceˉsignedˉmagnitude(
            Left.Negative, Left.Magnitude + Right.Magnitude
        );
    }
    if Left.Magnitude >= Right.Magnitude {
        return Compilerˉsourceˉsignedˉmagnitude(
            Left.Negative, Left.Magnitude - Right.Magnitude
        );
    }
    return Compilerˉsourceˉsignedˉmagnitude(
        Right.Negative, Right.Magnitude - Left.Magnitude
    );
}

fn Compilerˉsourceˉfloatingˉshiftˉrightˉjam(
    Value: u64,
    Distance: u32,
    Sticky: bool
) -> u64 {
    if Distance == 0u32 {
        if Sticky { return Value | 1u64; }
        return Value;
    }
    if Distance >= 64u32 {
        if Value != 0u64 || Sticky { return 1u64; }
        return 0u64;
    }
    let Mask: u64 = (1u64 << Distance) - 1u64;
    var Result: u64 = Value >> Distance;
    if (Value & Mask) != 0u64 || Sticky { Result = Result | 1u64; }
    return Result;
}

fn Compilerˉsourceˉfloatingˉbitsˉfromˉraw(Raw: u64) -> Compilerˉsourceˉfloatingˉbits {
    let Encoded: bytes = Bytesˉfromˉu64ˉlittle(Raw);
    return Compilerˉsourceˉfloatingˉbits(
        true,
        Bytesˉreadˉu32ˉlittle(Encoded, 0u32),
        Bytesˉreadˉu32ˉlittle(Encoded, 4u32)
    );
}

fn Compilerˉsourceˉfloatingˉroundˉpack(
    Extended: u64,
    Exponent: Compilerˉsourceˉsignedˉmagnitude,
    Precision: u32,
    Bias: u32,
    Minimumˉexponentˉmagnitude: u32,
    Maximumˉexponent: u32,
    Exponentˉbits: u32
) -> Compilerˉsourceˉfloatingˉbits {
    let Fractionˉbits: u32 = Precision - 1u32;
    let Hidden: u64 = 1u64 << Fractionˉbits;
    let Infiniteˉfield: u64 = (1u64 << Exponentˉbits) - 1u64;
    let Infinite: u64 = Infiniteˉfield << Fractionˉbits;
    if !Exponent.Negative && Exponent.Magnitude > Maximumˉexponent {
        return Compilerˉsourceˉfloatingˉbitsˉfromˉraw(Infinite);
    }

    var Roundedˉextended: u64 = Extended;
    var Subnormal: bool = false;
    if Exponent.Negative && Exponent.Magnitude > Minimumˉexponentˉmagnitude {
        Roundedˉextended = Compilerˉsourceˉfloatingˉshiftˉrightˉjam(
            Roundedˉextended,
            Exponent.Magnitude - Minimumˉexponentˉmagnitude,
            false
        );
        Subnormal = true;
    }

    let Roundˉbits: u64 = Roundedˉextended & 7u64;
    var Main: u64 = Roundedˉextended >> 3u32;
    if Roundˉbits > 4u64 || (Roundˉbits == 4u64 && (Main & 1u64) != 0u64) {
        Main = Main + 1u64;
    }
    if Main == 0u64 {
        return Compilerˉsourceˉfloatingˉbitsˉfromˉraw(0u64);
    }
    if Subnormal {
        if Main >= Hidden {
            return Compilerˉsourceˉfloatingˉbitsˉfromˉraw(
                (1u64 << Fractionˉbits) + Main - Hidden
            );
        }
        return Compilerˉsourceˉfloatingˉbitsˉfromˉraw(Main);
    }

    var Exponentˉfield: u32 = Bias;
    if Exponent.Negative {
        Exponentˉfield = Bias - Exponent.Magnitude;
    } else {
        Exponentˉfield = Bias + Exponent.Magnitude;
    }
    if Main == Hidden * 2u64 {
        Main = Hidden;
        Exponentˉfield = Exponentˉfield + 1u32;
    }
    if Exponentˉfield >= (1u32 << Exponentˉbits) - 1u32 {
        return Compilerˉsourceˉfloatingˉbitsˉfromˉraw(Infinite);
    }
    let Raw: u64 = U64ˉfromˉu32(Exponentˉfield) << Fractionˉbits |
        (Main - Hidden);
    return Compilerˉsourceˉfloatingˉbitsˉfromˉraw(Raw);
}

fn Compilerˉsourceˉhexˉfloatingˉmantissaˉscan(
    Input: bytes,
    Start: u32,
    Startˉcolumn: u32
) -> Compilerˉsourceˉhexˉfloatingˉmantissa {
    let Total: u32 = Bytesˉlength(Input);
    var Cursor: u32 = Start + 2u32;
    var Column: u32 = Startˉcolumn + 2u32;
    var Valid: bool = Total - Start >= 3u32;
    var Digits: u32 = 0u32;
    var Digitsˉbefore: u32 = 0u32;
    var Leadingˉfound: bool = false;
    var Leadingˉindex: u32 = 0u32;
    var Leadingˉnibble: u32 = 0u32;
    var Accumulatedˉdigits: u32 = 0u32;
    var Accumulated: u64 = 0u64;
    var Sticky: bool = false;

    var Readingˉwhole: bool = Valid;
    while Readingˉwhole {
        if Cursor >= Total {
            Readingˉwhole = false;
        } else {
            let Wholeˉdigit: u32 = Compilerˉsourceˉhexˉdigit(Bytesˉreadˉu8(Input, Cursor));
            if Wholeˉdigit == 16u32 {
                Readingˉwhole = false;
            } else {
                if !Leadingˉfound && Wholeˉdigit != 0u32 {
                    Leadingˉfound = true;
                    Leadingˉindex = Digits;
                    Leadingˉnibble = Wholeˉdigit;
                }
                if Leadingˉfound {
                    if Accumulatedˉdigits < 16u32 {
                        Accumulated = Accumulated * 16u64 + U64ˉfromˉu32(Wholeˉdigit);
                        Accumulatedˉdigits = Accumulatedˉdigits + 1u32;
                    } else if Wholeˉdigit != 0u32 {
                        Sticky = true;
                    }
                }
                Digits = Digits + 1u32;
                Cursor = Cursor + 1u32;
                Column = Column + 1u32;
            }
        }
    }
    Digitsˉbefore = Digits;
    if Digitsˉbefore == 0u32 { Valid = false; }

    if Cursor < Total && Bytesˉreadˉu8(Input, Cursor) == 46u8 {
        Cursor = Cursor + 1u32;
        Column = Column + 1u32;
        let Fractionˉstart: u32 = Digits;
        var Readingˉfraction: bool = true;
        while Readingˉfraction {
            if Cursor >= Total {
                Readingˉfraction = false;
            } else {
                let Fractionˉdigit: u32 = Compilerˉsourceˉhexˉdigit(Bytesˉreadˉu8(Input, Cursor));
                if Fractionˉdigit == 16u32 {
                    Readingˉfraction = false;
                } else {
                    if !Leadingˉfound && Fractionˉdigit != 0u32 {
                        Leadingˉfound = true;
                        Leadingˉindex = Digits;
                        Leadingˉnibble = Fractionˉdigit;
                    }
                    if Leadingˉfound {
                        if Accumulatedˉdigits < 16u32 {
                            Accumulated = Accumulated * 16u64 + U64ˉfromˉu32(Fractionˉdigit);
                            Accumulatedˉdigits = Accumulatedˉdigits + 1u32;
                        } else if Fractionˉdigit != 0u32 {
                            Sticky = true;
                        }
                    }
                    Digits = Digits + 1u32;
                    Cursor = Cursor + 1u32;
                    Column = Column + 1u32;
                }
            }
        }
        if Digits == Fractionˉstart { Valid = false; }
    }

    return Compilerˉsourceˉhexˉfloatingˉmantissa(
        Valid, Cursor, Column, Digitsˉbefore,
        Leadingˉfound, Leadingˉindex, Leadingˉnibble,
        Accumulatedˉdigits, Accumulated, Sticky
    );
}

fn Compilerˉsourceˉhexˉfloatingˉexponentˉscan(
    Input: bytes,
    Start: u32,
    Startˉcolumn: u32,
    Initiallyˉvalid: bool
) -> Compilerˉsourceˉhexˉfloatingˉexponent {
    let Total: u32 = Bytesˉlength(Input);
    var Cursor: u32 = Start;
    var Column: u32 = Startˉcolumn;
    var Valid: bool = Initiallyˉvalid;

    var Exponentˉnegative: bool = false;
    var Exponentˉmagnitude: u32 = 0u32;
    if Cursor >= Total { Valid = false; }
    if Cursor < Total {
        let Marker: u8 = Bytesˉreadˉu8(Input, Cursor);
        if Marker != 112u8 && Marker != 80u8 { Valid = false; }
        else {
            Cursor = Cursor + 1u32;
            Column = Column + 1u32;
            if Cursor < Total {
                let Sign: u8 = Bytesˉreadˉu8(Input, Cursor);
                if Sign == 43u8 || Sign == 45u8 {
                    Exponentˉnegative = Sign == 45u8;
                    Cursor = Cursor + 1u32;
                    Column = Column + 1u32;
                }
            }
            var Exponentˉdigits: u32 = 0u32;
            var Readingˉexponent: bool = true;
            while Readingˉexponent {
                if Cursor >= Total {
                    Readingˉexponent = false;
                } else {
                    let Exponentˉdigit: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(Input, Cursor));
                    if Exponentˉdigit < 48u32 || Exponentˉdigit > 57u32 {
                        Readingˉexponent = false;
                    } else {
                        if Exponentˉmagnitude <= 1000000u32 {
                            Exponentˉmagnitude = Exponentˉmagnitude * 10u32 + Exponentˉdigit - 48u32;
                        }
                        Exponentˉdigits = Exponentˉdigits + 1u32;
                        Cursor = Cursor + 1u32;
                        Column = Column + 1u32;
                    }
                }
            }
            if Exponentˉdigits == 0u32 { Valid = false; }
        }
    }

    return Compilerˉsourceˉhexˉfloatingˉexponent(
        Valid, Cursor, Column, Exponentˉnegative, Exponentˉmagnitude
    );
}

fn Compilerˉsourceˉhexˉfloatingˉsuffixˉscan(
    Input: bytes,
    Start: u32,
    Startˉcolumn: u32,
    Initiallyˉvalid: bool
) -> Compilerˉsourceˉhexˉfloatingˉsuffix {
    let Total: u32 = Bytesˉlength(Input);
    var Cursor: u32 = Start;
    var Column: u32 = Startˉcolumn;
    var Valid: bool = Initiallyˉvalid;

    var Numericˉkind: Compilerˉnumericˉkind = Compilerˉnumericˉkind.None;
    if Total - Cursor >= 3u32 {
        if Compilerˉsourceˉspanˉequalsˉtext(Input, Cursor, 3u32, "f32") {
            Numericˉkind = Compilerˉnumericˉkind.F32;
        } else if Compilerˉsourceˉspanˉequalsˉtext(Input, Cursor, 3u32, "f64") {
            Numericˉkind = Compilerˉnumericˉkind.F64;
        }
        if Numericˉkind != Compilerˉnumericˉkind.None {
            let Following: u32 = Cursor + 3u32;
            if Compilerˉsourceˉidentifierˉpartˉlengthˉafterˉscan(
                Input, Following, Total
            ) != 0u32 {
                Numericˉkind = Compilerˉnumericˉkind.None;
            } else {
                Cursor = Following;
                Column = Column + 3u32;
            }
        }
    }
    if Numericˉkind == Compilerˉnumericˉkind.None { Valid = false; }

    return Compilerˉsourceˉhexˉfloatingˉsuffix(
        Valid, Cursor, Column, Numericˉkind
    );
}

fn Compilerˉsourceˉhexˉfloatingˉconvert(
    Mantissa: Compilerˉsourceˉhexˉfloatingˉmantissa,
    Exponentˉscan: Compilerˉsourceˉhexˉfloatingˉexponent,
    Numericˉkind: Compilerˉnumericˉkind
) -> Compilerˉsourceˉfloatingˉbits {
    if !Mantissa.Valid || !Exponentˉscan.Valid ||
        Numericˉkind == Compilerˉnumericˉkind.None {
        return Compilerˉsourceˉfloatingˉbits(false, 0u32, 0u32);
    }
    if !Mantissa.Leadingˉfound {
        return Compilerˉsourceˉfloatingˉbits(true, 0u32, 0u32);
    }

    var Nibbleˉhigh: u32 = 0u32;
    if Mantissa.Leadingˉnibble >= 2u32 { Nibbleˉhigh = 1u32; }
    if Mantissa.Leadingˉnibble >= 4u32 { Nibbleˉhigh = 2u32; }
    if Mantissa.Leadingˉnibble >= 8u32 { Nibbleˉhigh = 3u32; }
    var Exponent: Compilerˉsourceˉsignedˉmagnitude =
        Compilerˉsourceˉsignedˉmagnitude(
            Exponentˉscan.Negative, Exponentˉscan.Magnitude
        );
    if Mantissa.Leadingˉindex < Mantissa.Digitsˉbefore {
        Exponent = Compilerˉsourceˉsignedˉadd(
            Exponent,
            Compilerˉsourceˉsignedˉmagnitude(
                false,
                (Mantissa.Digitsˉbefore - Mantissa.Leadingˉindex - 1u32) * 4u32
            )
        );
    } else {
        Exponent = Compilerˉsourceˉsignedˉadd(
            Exponent,
            Compilerˉsourceˉsignedˉmagnitude(
                true,
                (Mantissa.Leadingˉindex - Mantissa.Digitsˉbefore + 1u32) * 4u32
            )
        );
    }
    Exponent = Compilerˉsourceˉsignedˉadd(
        Exponent,
        Compilerˉsourceˉsignedˉmagnitude(false, Nibbleˉhigh)
    );

    var Precision: u32 = 24u32;
    var Bias: u32 = 127u32;
    var Minimum: u32 = 126u32;
    var Maximum: u32 = 127u32;
    var Exponentˉbits: u32 = 8u32;
    if Numericˉkind == Compilerˉnumericˉkind.F64 {
        Precision = 53u32;
        Bias = 1023u32;
        Minimum = 1022u32;
        Maximum = 1023u32;
        Exponentˉbits = 11u32;
    }
    let Accumulatedˉbitˉlength: u32 =
        (Mantissa.Accumulatedˉdigits - 1u32) * 4u32 + Nibbleˉhigh + 1u32;
    let Targetˉbits: u32 = Precision + 3u32;
    var Extended: u64 = Mantissa.Accumulated;
    if Accumulatedˉbitˉlength > Targetˉbits {
        Extended = Compilerˉsourceˉfloatingˉshiftˉrightˉjam(
            Extended,
            Accumulatedˉbitˉlength - Targetˉbits,
            Mantissa.Sticky
        );
    } else {
        Extended = Extended << (Targetˉbits - Accumulatedˉbitˉlength);
        if Mantissa.Sticky { Extended = Extended | 1u64; }
    }
    return Compilerˉsourceˉfloatingˉroundˉpack(
        Extended, Exponent, Precision, Bias, Minimum, Maximum, Exponentˉbits
    );
}

fn Compilerˉsourceˉhexˉfloatingˉliteral(
    Input: bytes,
    Start: u32,
    Startˉline: u32,
    Startˉcolumn: u32
) -> Compilerˉsourceˉtoken {
    let Mantissa: Compilerˉsourceˉhexˉfloatingˉmantissa =
        Compilerˉsourceˉhexˉfloatingˉmantissaˉscan(
            Input, Start, Startˉcolumn
        );
    let Exponent: Compilerˉsourceˉhexˉfloatingˉexponent =
        Compilerˉsourceˉhexˉfloatingˉexponentˉscan(
            Input, Mantissa.Cursor, Mantissa.Column, Mantissa.Valid
        );
    let Suffix: Compilerˉsourceˉhexˉfloatingˉsuffix =
        Compilerˉsourceˉhexˉfloatingˉsuffixˉscan(
            Input, Exponent.Cursor, Exponent.Column, Exponent.Valid
        );
    let Bits: Compilerˉsourceˉfloatingˉbits =
        Compilerˉsourceˉhexˉfloatingˉconvert(
            Mantissa, Exponent, Suffix.Kind
        );

    var Status: Compilerˉlexˉstatus = Compilerˉlexˉstatus.Valid;
    if !Suffix.Valid || !Bits.Valid {
        Status = Compilerˉlexˉstatus.Invalidˉfloatingˉliteral;
    }
    return Compilerˉsourceˉtokenˉmakeˉwide(
        Status,
        Compilerˉtokenˉkind.Floatingˉliteral,
        Start,
        Suffix.Cursor,
        Startˉline,
        Startˉcolumn,
        Startˉline,
        Suffix.Column,
        Suffix.Kind,
        Bits.Low,
        Bits.High,
        Start,
        Startˉline,
        Startˉcolumn
    );
}

fn Compilerˉsourceˉruneˉliteral(
    Input: bytes,
    Start: u32,
    Startˉline: u32,
    Startˉcolumn: u32
) -> Compilerˉsourceˉtoken {
    let Total: u32 = Bytesˉlength(Input);
    var Cursor: u32 = Start + 1u32;
    var Column: u32 = Startˉcolumn + 1u32;
    var Runeˉstatus: Compilerˉlexˉstatus = Compilerˉlexˉstatus.Valid;
    var Runeˉvalue: u32 = 0u32;
    var Runeˉfailureˉoffset: u32 = Start;
    var Runeˉfailureˉcolumn: u32 = Startˉcolumn;
    var Runeˉitem: bool = false;

    if Cursor >= Total {
        Runeˉstatus = Compilerˉlexˉstatus.Unterminatedˉrune;
    } else {
        let Runeˉfirst: u8 = Bytesˉreadˉu8(Input, Cursor);
        if Runeˉfirst == 39u8 {
            Runeˉstatus = Compilerˉlexˉstatus.Invalidˉrune;
            Runeˉfailureˉoffset = Cursor;
            Runeˉfailureˉcolumn = Column;
        } else if Runeˉfirst == 10u8 {
            Runeˉstatus = Compilerˉlexˉstatus.Unterminatedˉrune;
        } else if Runeˉfirst == 13u8 {
            Runeˉstatus = Compilerˉlexˉstatus.Unterminatedˉrune;
        } else if Runeˉfirst == 92u8 {
            let Runeˉescapeˉoffset: u32 = Cursor;
            let Runeˉescapeˉcolumn: u32 = Column;
            Cursor = Cursor + 1u32;
            Column = Column + 1u32;
            if Cursor >= Total {
                Runeˉstatus = Compilerˉlexˉstatus.Unterminatedˉrune;
            } else {
                let Runeˉescape: u8 = Bytesˉreadˉu8(Input, Cursor);
                if Runeˉescape == 117u8 {
                    Cursor = Cursor + 1u32;
                    Column = Column + 1u32;
                    var Runeˉbraceˉpresent: bool = Cursor < Total;
                    if Runeˉbraceˉpresent {
                        Runeˉbraceˉpresent = Bytesˉreadˉu8(Input, Cursor) == 123u8;
                    }
                    if !Runeˉbraceˉpresent {
                        Runeˉstatus = Compilerˉlexˉstatus.Invalidˉunicodeˉescape;
                        Runeˉfailureˉoffset = Runeˉescapeˉoffset;
                        Runeˉfailureˉcolumn = Runeˉescapeˉcolumn;
                    } else {
                        Cursor = Cursor + 1u32;
                        Column = Column + 1u32;
                        var Runeˉdigits: u32 = 0u32;
                        var Runeˉscalar: u32 = 0u32;
                        var Readingˉruneˉhex: bool = true;
                        while Readingˉruneˉhex {
                            if Cursor >= Total {
                                Readingˉruneˉhex = false;
                            } else {
                                let Runeˉhex: u32 = Compilerˉsourceˉhexˉdigit(
                                    Bytesˉreadˉu8(Input, Cursor)
                                );
                                if Runeˉhex == 16u32 {
                                    Readingˉruneˉhex = false;
                                } else {
                                    if Runeˉdigits < 6u32 {
                                        Runeˉscalar = Runeˉscalar * 16u32 + Runeˉhex;
                                    }
                                    Runeˉdigits = Runeˉdigits + 1u32;
                                    Cursor = Cursor + 1u32;
                                    Column = Column + 1u32;
                                }
                            }
                        }
                        var Runeˉscalarˉvalid: bool =
                            Runeˉdigits >= 1u32 && Runeˉdigits <= 6u32;
                        if Cursor >= Total { Runeˉscalarˉvalid = false; }
                        if Runeˉscalarˉvalid {
                            if Bytesˉreadˉu8(Input, Cursor) != 125u8 {
                                Runeˉscalarˉvalid = false;
                            }
                        }
                        if Runeˉscalar > 1114111u32 { Runeˉscalarˉvalid = false; }
                        if Runeˉscalar >= 55296u32 && Runeˉscalar <= 57343u32 {
                            Runeˉscalarˉvalid = false;
                        }
                        if !Runeˉscalarˉvalid {
                            Runeˉstatus = Compilerˉlexˉstatus.Invalidˉunicodeˉescape;
                            Runeˉfailureˉoffset = Runeˉescapeˉoffset;
                            Runeˉfailureˉcolumn = Runeˉescapeˉcolumn;
                        } else {
                            Runeˉvalue = Runeˉscalar;
                            Runeˉitem = true;
                            Cursor = Cursor + 1u32;
                            Column = Column + 1u32;
                        }
                    }
                } else {
                    var Runeˉescapeˉvalid: bool = true;
                    if Runeˉescape == 92u8 { Runeˉvalue = 92u32; }
                    else if Runeˉescape == 39u8 { Runeˉvalue = 39u32; }
                    else if Runeˉescape == 34u8 { Runeˉvalue = 34u32; }
                    else if Runeˉescape == 110u8 { Runeˉvalue = 10u32; }
                    else if Runeˉescape == 114u8 { Runeˉvalue = 13u32; }
                    else if Runeˉescape == 116u8 { Runeˉvalue = 9u32; }
                    else if Runeˉescape == 48u8 { Runeˉvalue = 0u32; }
                    else if Runeˉescape == 123u8 { Runeˉvalue = 123u32; }
                    else if Runeˉescape == 125u8 { Runeˉvalue = 125u32; }
                    else { Runeˉescapeˉvalid = false; }
                    if !Runeˉescapeˉvalid {
                        Runeˉstatus = Compilerˉlexˉstatus.Unsupportedˉescape;
                        Runeˉfailureˉoffset = Runeˉescapeˉoffset;
                        Runeˉfailureˉcolumn = Runeˉescapeˉcolumn;
                    } else {
                        Runeˉitem = true;
                    }
                    Cursor = Cursor + 1u32;
                    Column = Column + 1u32;
                }
            }
        } else {
            Runeˉvalue = Compilerˉsourceˉutf8ˉscalar(Input, Cursor);
            let Runeˉwidth: u32 = Compilerˉsourceˉutf8ˉlength(Input, Cursor);
            Runeˉitem = Runeˉvalue <= 1114111u32;
            if Runeˉvalue >= 55296u32 && Runeˉvalue <= 57343u32 {
                Runeˉitem = false;
            }
            if !Runeˉitem {
                Runeˉstatus = Compilerˉlexˉstatus.Invalidˉrune;
                Runeˉfailureˉoffset = Cursor;
                Runeˉfailureˉcolumn = Column;
            }
            Cursor = Cursor + Runeˉwidth;
            Column = Column + Compilerˉsourceˉcolumnˉwidth(Input, Cursor - Runeˉwidth);
        }
    }

    if Runeˉitem {
        if Cursor < Total && Bytesˉreadˉu8(Input, Cursor) == 39u8 {
            Cursor = Cursor + 1u32;
            Column = Column + 1u32;
        } else {
            Runeˉstatus = Compilerˉlexˉstatus.Unterminatedˉrune;
            if Cursor < Total {
                if Bytesˉreadˉu8(Input, Cursor) != 10u8 &&
                    Bytesˉreadˉu8(Input, Cursor) != 13u8 {
                    Runeˉstatus = Compilerˉlexˉstatus.Invalidˉrune;
                    Runeˉfailureˉoffset = Cursor;
                    Runeˉfailureˉcolumn = Column;
                    var Findˉruneˉend: bool = true;
                    while Findˉruneˉend {
                        if Cursor >= Total {
                            Findˉruneˉend = false;
                        } else {
                            let Runeˉextra: u8 = Bytesˉreadˉu8(Input, Cursor);
                            if Runeˉextra == 39u8 {
                                Cursor = Cursor + 1u32;
                                Column = Column + 1u32;
                                Findˉruneˉend = false;
                            } else if Runeˉextra == 10u8 {
                                Findˉruneˉend = false;
                            } else if Runeˉextra == 13u8 {
                                Findˉruneˉend = false;
                            } else {
                                let Runeˉextraˉwidth: u32 =
                                    Compilerˉsourceˉutf8ˉlength(Input, Cursor);
                                Column = Column +
                                    Compilerˉsourceˉcolumnˉwidth(Input, Cursor);
                                Cursor = Cursor + Runeˉextraˉwidth;
                            }
                        }
                    }
                }
            }
        }
    } else if Cursor < Total && Bytesˉreadˉu8(Input, Cursor) == 39u8 {
        Cursor = Cursor + 1u32;
        Column = Column + 1u32;
    }

    return Compilerˉsourceˉtokenˉmake(
        Runeˉstatus,
        Compilerˉtokenˉkind.Runeˉliteral,
        Start,
        Cursor,
        Startˉline,
        Startˉcolumn,
        Startˉline,
        Column,
        Compilerˉnumericˉkind.None,
        Runeˉvalue,
        Runeˉfailureˉoffset,
        Startˉline,
        Runeˉfailureˉcolumn
    );
}

export fn Compilerˉlexˉnextˉvalidated(
    Input: bytes,
    Start: u32,
    Startˉline: u32,
    Startˉcolumn: u32
) -> Compilerˉsourceˉtoken {
    let Total: u32 = Bytesˉlength(Input);
    if Start > Total {
        return Compilerˉsourceˉtokenˉmake(
            Compilerˉlexˉstatus.Invalidˉcursor,
            Compilerˉtokenˉkind.Bad,
            Total,
            Total,
            Startˉline,
            Startˉcolumn,
            Startˉline,
            Startˉcolumn,
            Compilerˉnumericˉkind.None,
            0u32,
            Start,
            Startˉline,
            Startˉcolumn
        );
    }
    if Startˉline == 0u32 {
        return Compilerˉsourceˉtokenˉmake(
            Compilerˉlexˉstatus.Invalidˉcursor,
            Compilerˉtokenˉkind.Bad,
            Start,
            Start,
            1u32,
            Startˉcolumn,
            1u32,
            Startˉcolumn,
            Compilerˉnumericˉkind.None,
            0u32,
            Start,
            Startˉline,
            Startˉcolumn
        );
    }
    if Startˉcolumn == 0u32 {
        return Compilerˉsourceˉtokenˉmake(
            Compilerˉlexˉstatus.Invalidˉcursor,
            Compilerˉtokenˉkind.Bad,
            Start,
            Start,
            Startˉline,
            1u32,
            Startˉline,
            1u32,
            Compilerˉnumericˉkind.None,
            0u32,
            Start,
            Startˉline,
            Startˉcolumn
        );
    }
    if Start < Total {
        let Startˉbyte: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(Input, Start));
        if Startˉbyte >= 128u32 {
            if Startˉbyte < 192u32 {
                return Compilerˉsourceˉtokenˉmake(
                    Compilerˉlexˉstatus.Invalidˉcursor,
                    Compilerˉtokenˉkind.Bad,
                    Start,
                    Start,
                    Startˉline,
                    Startˉcolumn,
                    Startˉline,
                    Startˉcolumn,
                    Compilerˉnumericˉkind.None,
                    0u32,
                    Start,
                    Startˉline,
                    Startˉcolumn
                );
            }
        }
    }
    return Compilerˉlexˉnextˉafterˉscan(Input, Start, Startˉline, Startˉcolumn);
}

export fn Compilerˉlexˉnextˉafterˉscan(
    Input: bytes,
    Start: u32,
    Startˉline: u32,
    Startˉcolumn: u32
) -> Compilerˉsourceˉtoken {
    let Total: u32 = Bytesˉlength(Input);
    var Cursor: u32 = Start;
    var Line: u32 = Startˉline;
    var Column: u32 = Startˉcolumn;
    var Skipping: bool = true;
    while Skipping {
        if Cursor >= Total {
            Skipping = false;
        } else {
            let Cursorˉbyte: u8 = Bytesˉreadˉu8(Input, Cursor);
            let Cursorˉvalue: u32 = U32ˉfromˉu8(Cursorˉbyte);
            var Whiteˉlength: u32 = 0u32;
            if Cursorˉvalue <= 32u32 {
                if Cursorˉvalue == 32u32 {
                    Whiteˉlength = 1u32;
                } else {
                    if Cursorˉvalue >= 9u32 {
                        if Cursorˉvalue <= 13u32 { Whiteˉlength = 1u32; }
                    }
                }
            } else {
                if Cursorˉvalue == 194u32 {
                    Whiteˉlength = Compilerˉsourceˉwhitespaceˉlengthˉafterˉscan(Input, Cursor, Total);
                } else {
                    if Cursorˉvalue >= 225u32 {
                        if Cursorˉvalue <= 227u32 {
                            Whiteˉlength = Compilerˉsourceˉwhitespaceˉlengthˉafterˉscan(Input, Cursor, Total);
                        }
                    }
                }
            }
            if Whiteˉlength > 0u32 {
                if Cursorˉbyte == 10u8 {
                    Line = Line + 1u32;
                    Column = 1u32;
                } else {
                    Column = Column + 1u32;
                }
                Cursor = Cursor + Whiteˉlength;
            } else {
                if Cursorˉbyte == 47u8 {
                    if Total - Cursor >= 2u32 {
                        if Bytesˉreadˉu8(Input, Cursor + 1u32) == 47u8 {
                            Cursor = Cursor + 2u32;
                            Column = Column + 2u32;
                            var Commentˉcontinues: bool = true;
                            while Commentˉcontinues {
                                if Cursor >= Total {
                                    Commentˉcontinues = false;
                                } else {
                                    if Bytesˉreadˉu8(Input, Cursor) == 10u8 {
                                        Commentˉcontinues = false;
                                    } else {
                                        let Commentˉcharacterˉlength: u32 = Compilerˉsourceˉutf8ˉlength(Input, Cursor);
                                        Column = Column + Compilerˉsourceˉcolumnˉwidth(Input, Cursor);
                                        Cursor = Cursor + Commentˉcharacterˉlength;
                                    }
                                }
                            }
                        } else {
                            Skipping = false;
                        }
                    } else {
                        Skipping = false;
                    }
                } else {
                    Skipping = false;
                }
            }
        }
    }

    let Tokenˉstart: u32 = Cursor;
    let Tokenˉline: u32 = Line;
    let Tokenˉcolumn: u32 = Column;
    if Cursor == Total {
        return Compilerˉsourceˉtokenˉmake(
            Compilerˉlexˉstatus.Valid,
            Compilerˉtokenˉkind.End,
            Cursor,
            Cursor,
            Line,
            Column,
            Line,
            Column,
            Compilerˉnumericˉkind.None,
            0u32,
            Cursor,
            Line,
            Column
        );
    }

    let First: u8 = Bytesˉreadˉu8(Input, Cursor);
    if Compilerˉsourceˉidentifierˉstart(First) {
        Cursor = Cursor + 1u32;
        Column = Column + 1u32;
        var Readingˉidentifier: bool = true;
        while Readingˉidentifier {
            if Cursor >= Total {
                Readingˉidentifier = false;
            } else {
                let Identifierˉcharacter: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(Input, Cursor));
                var Partˉlength: u32 = 0u32;
                if Identifierˉcharacter >= 97u32 {
                    if Identifierˉcharacter <= 122u32 {
                        Partˉlength = 1u32;
                    } else {
                        if Identifierˉcharacter == 203u32 {
                            if Total - Cursor >= 2u32 {
                                if Bytesˉreadˉu8(Input, Cursor + 1u32) == 137u8 {
                                    Partˉlength = 2u32;
                                }
                            }
                        }
                    }
                } else {
                    if Identifierˉcharacter >= 65u32 {
                        if Identifierˉcharacter <= 90u32 {
                            Partˉlength = 1u32;
                        } else {
                            if Identifierˉcharacter == 95u32 { Partˉlength = 1u32; }
                        }
                    } else {
                        if Identifierˉcharacter >= 48u32 {
                            if Identifierˉcharacter <= 57u32 { Partˉlength = 1u32; }
                        }
                    }
                }
                if Partˉlength == 0u32 {
                    Readingˉidentifier = false;
                } else {
                    Cursor = Cursor + Partˉlength;
                    Column = Column + 1u32;
                }
            }
        }
        let Identifierˉkind: Compilerˉtokenˉkind = Compilerˉsourceˉkeywordˉkind(
            Input,
            Tokenˉstart,
            Cursor - Tokenˉstart
        );
        return Compilerˉsourceˉtokenˉmake(
            Compilerˉlexˉstatus.Valid,
            Identifierˉkind,
            Tokenˉstart,
            Cursor,
            Tokenˉline,
            Tokenˉcolumn,
            Line,
            Column,
            Compilerˉnumericˉkind.None,
            0u32,
            Tokenˉstart,
            Tokenˉline,
            Tokenˉcolumn
        );
    }

    let Firstˉvalue: u32 = U32ˉfromˉu8(First);
    if Firstˉvalue >= 48u32 {
        if Firstˉvalue <= 57u32 {
            if Firstˉvalue == 48u32 && Total - Tokenˉstart >= 2u32 {
                let Prefix: u8 = Bytesˉreadˉu8(Input, Tokenˉstart + 1u32);
                if Prefix == 120u8 || Prefix == 88u8 {
                    return Compilerˉsourceˉhexˉfloatingˉliteral(
                        Input, Tokenˉstart, Tokenˉline, Tokenˉcolumn
                    );
                }
            }
            Cursor = Cursor + 1u32;
            Column = Column + 1u32;
            var Readingˉdigits: bool = true;
            while Readingˉdigits {
                if Cursor >= Total {
                    Readingˉdigits = false;
                } else {
                    let Digit: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(Input, Cursor));
                    if Digit < 48u32 {
                        Readingˉdigits = false;
                    } else {
                        if Digit > 57u32 {
                            Readingˉdigits = false;
                        } else {
                            Cursor = Cursor + 1u32;
                            Column = Column + 1u32;
                        }
                    }
                }
            }
            let Digitˉend: u32 = Cursor;
            var Numericˉkind: Compilerˉnumericˉkind = Compilerˉnumericˉkind.I32;
            if Total - Cursor >= 2u32 {
                let Shortˉtoken: Compilerˉtokenˉkind =
                    Compilerˉsourceˉkeywordˉkind(Input, Cursor, 2u32);
                var Shortˉsuffix: Compilerˉnumericˉkind =
                    Compilerˉnumericˉkind.None;
                if Shortˉtoken == Compilerˉtokenˉkind.I8 {
                    Shortˉsuffix = Compilerˉnumericˉkind.I8;
                } else if Shortˉtoken == Compilerˉtokenˉkind.U8 {
                    Shortˉsuffix = Compilerˉnumericˉkind.U8;
                }
                let Shortˉfollowing: u32 = Cursor + 2u32;
                if Shortˉsuffix != Compilerˉnumericˉkind.None &&
                    Compilerˉsourceˉidentifierˉpartˉlengthˉafterˉscan(
                        Input, Shortˉfollowing, Total
                ) == 0u32 {
                    Numericˉkind = Shortˉsuffix;
                    Cursor = Shortˉfollowing;
                    Column = Column + 2u32;
                }
            }
            if Numericˉkind == Compilerˉnumericˉkind.I32 {
                if Total - Cursor >= 3u32 {
                    let Longˉtoken: Compilerˉtokenˉkind =
                        Compilerˉsourceˉkeywordˉkind(Input, Cursor, 3u32);
                    var Longˉsuffix: Compilerˉnumericˉkind =
                        Compilerˉnumericˉkind.None;
                    if Longˉtoken == Compilerˉtokenˉkind.I16 {
                        Longˉsuffix = Compilerˉnumericˉkind.I16;
                    } else if Longˉtoken == Compilerˉtokenˉkind.I32 {
                        Longˉsuffix = Compilerˉnumericˉkind.I32;
                    } else if Longˉtoken == Compilerˉtokenˉkind.I64 {
                        Longˉsuffix = Compilerˉnumericˉkind.I64;
                    } else if Longˉtoken == Compilerˉtokenˉkind.U16 {
                        Longˉsuffix = Compilerˉnumericˉkind.U16;
                    } else if Longˉtoken == Compilerˉtokenˉkind.U32 {
                        Longˉsuffix = Compilerˉnumericˉkind.U32;
                    } else if Longˉtoken == Compilerˉtokenˉkind.U64 {
                        Longˉsuffix = Compilerˉnumericˉkind.U64;
                    }
                    let Longˉfollowing: u32 = Cursor + 3u32;
                    if Longˉsuffix != Compilerˉnumericˉkind.None &&
                        Compilerˉsourceˉidentifierˉpartˉlengthˉafterˉscan(
                            Input, Longˉfollowing, Total
                        ) == 0u32 {
                        Numericˉkind = Longˉsuffix;
                        Cursor = Longˉfollowing;
                        Column = Column + 3u32;
                    }
                }
            }
            let Parsed: Compilerˉsourceˉwideˉparse = Compilerˉsourceˉwideˉdecimalˉparse(
                Input, Tokenˉstart, Digitˉend - Tokenˉstart
            );
            if Cursor == Digitˉend {
                var Contextualˉstatus: Compilerˉlexˉstatus = Compilerˉlexˉstatus.Valid;
                if !Parsed.Valid {
                    Contextualˉstatus = Compilerˉlexˉstatus.Integerˉoutˉofˉrange;
                }
                if Parsed.Valid && Parsed.High == 0u32 {
                    return Compilerˉsourceˉtokenˉmake(
                        Contextualˉstatus, Compilerˉtokenˉkind.Integer,
                        Tokenˉstart, Cursor, Tokenˉline, Tokenˉcolumn,
                        Line, Column, Numericˉkind, Parsed.Low,
                        Tokenˉstart, Tokenˉline, Tokenˉcolumn
                    );
                }
                return Compilerˉsourceˉtokenˉmakeˉwide(
                    Contextualˉstatus,
                    Compilerˉtokenˉkind.Integer,
                    Tokenˉstart,
                    Cursor,
                    Tokenˉline,
                    Tokenˉcolumn,
                    Line,
                    Column,
                    Numericˉkind,
                    Parsed.Low,
                    Parsed.High,
                    Tokenˉstart,
                    Tokenˉline,
                    Tokenˉcolumn
                );
            }
            if Numericˉkind == Compilerˉnumericˉkind.I64 ||
                Numericˉkind == Compilerˉnumericˉkind.U64 {
                var Wideˉstatus: Compilerˉlexˉstatus = Compilerˉlexˉstatus.Valid;
                if !Parsed.Valid { Wideˉstatus = Compilerˉlexˉstatus.Integerˉoutˉofˉrange; }
                if Numericˉkind == Compilerˉnumericˉkind.I64 {
                    if Parsed.High > 2147483648u32 ||
                        (Parsed.High == 2147483648u32 && Parsed.Low != 0u32) {
                        Wideˉstatus = Compilerˉlexˉstatus.Integerˉoutˉofˉrange;
                    }
                }
                return Compilerˉsourceˉtokenˉmakeˉwide(
                    Wideˉstatus,
                    Compilerˉtokenˉkind.Integer,
                    Tokenˉstart,
                    Cursor,
                    Tokenˉline,
                    Tokenˉcolumn,
                    Line,
                    Column,
                    Numericˉkind,
                    Parsed.Low,
                    Parsed.High,
                    Tokenˉstart,
                    Tokenˉline,
                    Tokenˉcolumn
                );
            }
            var Numericˉstatus: Compilerˉlexˉstatus = Compilerˉlexˉstatus.Valid;
            if !Parsed.Valid || Parsed.High != 0u32 {
                Numericˉstatus = Compilerˉlexˉstatus.Integerˉoutˉofˉrange;
            }
            if Numericˉkind == Compilerˉnumericˉkind.I32 {
                if Parsed.Low > 2147483648u32 {
                    Numericˉstatus = Compilerˉlexˉstatus.Integerˉoutˉofˉrange;
                }
            }
            if Numericˉkind == Compilerˉnumericˉkind.U8 {
                if Parsed.Low > 255u32 {
                    Numericˉstatus = Compilerˉlexˉstatus.Integerˉoutˉofˉrange;
                }
            }
            if Numericˉkind == Compilerˉnumericˉkind.I8 {
                if Parsed.Low > 128u32 {
                    Numericˉstatus = Compilerˉlexˉstatus.Integerˉoutˉofˉrange;
                }
            }
            if Numericˉkind == Compilerˉnumericˉkind.I16 {
                if Parsed.Low > 32768u32 {
                    Numericˉstatus = Compilerˉlexˉstatus.Integerˉoutˉofˉrange;
                }
            }
            if Numericˉkind == Compilerˉnumericˉkind.U16 {
                if Parsed.Low > 65535u32 {
                    Numericˉstatus = Compilerˉlexˉstatus.Integerˉoutˉofˉrange;
                }
            }
            return Compilerˉsourceˉtokenˉmake(
                Numericˉstatus,
                Compilerˉtokenˉkind.Integer,
                Tokenˉstart,
                Cursor,
                Tokenˉline,
                Tokenˉcolumn,
                Line,
                Column,
                Numericˉkind,
                Parsed.Low,
                Tokenˉstart,
                Tokenˉline,
                Tokenˉcolumn
            );
        }
    }

    if First == 39u8 {
        return Compilerˉsourceˉruneˉliteral(
            Input, Tokenˉstart, Tokenˉline, Tokenˉcolumn
        );
    }

    if First == 34u8 {
        Cursor = Cursor + 1u32;
        Column = Column + 1u32;
        var Stringˉstatus: Compilerˉlexˉstatus = Compilerˉlexˉstatus.Valid;
        var Failureˉoffset: u32 = Tokenˉstart;
        var Failureˉline: u32 = Tokenˉline;
        var Failureˉcolumn: u32 = Tokenˉcolumn;
        var Terminated: bool = false;
        var Pendingˉhighˉsurrogate: bool = false;
        var Reading: bool = true;
        while Reading {
            if Cursor >= Total {
                Reading = false;
            } else {
                let Character: u8 = Bytesˉreadˉu8(Input, Cursor);
                if Character == 34u8 {
                    Cursor = Cursor + 1u32;
                    Column = Column + 1u32;
                    Terminated = true;
                    Reading = false;
                } else {
                    if Character == 10u8 {
                        Reading = false;
                    } else {
                        if Character == 13u8 {
                            Reading = false;
                        } else {
                            if Character == 92u8 {
                                let Escapeˉoffset: u32 = Cursor;
                                let Escapeˉcolumn: u32 = Column;
                                Cursor = Cursor + 1u32;
                                Column = Column + 1u32;
                                if Cursor >= Total {
                                    Reading = false;
                                } else {
                                    let Escape: u8 = Bytesˉreadˉu8(Input, Cursor);
                                    if Escape == 117u8 {
                                        Cursor = Cursor + 1u32;
                                        Column = Column + 1u32;
                                        if Total - Cursor < 4u32 {
                                            if Stringˉstatus == Compilerˉlexˉstatus.Valid {
                                                Stringˉstatus = Compilerˉlexˉstatus.Shortˉunicodeˉescape;
                                                Failureˉoffset = Escapeˉoffset;
                                                Failureˉline = Line;
                                                Failureˉcolumn = Escapeˉcolumn;
                                            }
                                            Cursor = Total;
                                            Reading = false;
                                        } else {
                                            let H0: u32 = Compilerˉsourceˉhexˉdigit(Bytesˉreadˉu8(Input, Cursor));
                                            let H1: u32 = Compilerˉsourceˉhexˉdigit(Bytesˉreadˉu8(Input, Cursor + 1u32));
                                            let H2: u32 = Compilerˉsourceˉhexˉdigit(Bytesˉreadˉu8(Input, Cursor + 2u32));
                                            let H3: u32 = Compilerˉsourceˉhexˉdigit(Bytesˉreadˉu8(Input, Cursor + 3u32));
                                            var Hexˉvalid: bool = true;
                                            if H0 == 16u32 { Hexˉvalid = false; }
                                            if H1 == 16u32 { Hexˉvalid = false; }
                                            if H2 == 16u32 { Hexˉvalid = false; }
                                            if H3 == 16u32 { Hexˉvalid = false; }
                                            if !Hexˉvalid {
                                                if Stringˉstatus == Compilerˉlexˉstatus.Valid {
                                                    Stringˉstatus = Compilerˉlexˉstatus.Invalidˉunicodeˉescape;
                                                    Failureˉoffset = Cursor;
                                                    Failureˉline = Line;
                                                    Failureˉcolumn = Column;
                                                }
                                            } else {
                                                let Codeˉunit: u32 = H0 * 4096u32 + H1 * 256u32 + H2 * 16u32 + H3;
                                                if Codeˉunit >= 55296u32 {
                                                    if Codeˉunit <= 56319u32 {
                                                        if Pendingˉhighˉsurrogate {
                                                            if Stringˉstatus == Compilerˉlexˉstatus.Valid {
                                                                Stringˉstatus = Compilerˉlexˉstatus.Unpairedˉsurrogate;
                                                                Failureˉoffset = Escapeˉoffset;
                                                                Failureˉline = Line;
                                                                Failureˉcolumn = Escapeˉcolumn;
                                                            }
                                                        }
                                                        Pendingˉhighˉsurrogate = true;
                                                    } else {
                                                        if Codeˉunit <= 57343u32 {
                                                            if !Pendingˉhighˉsurrogate {
                                                                if Stringˉstatus == Compilerˉlexˉstatus.Valid {
                                                                    Stringˉstatus = Compilerˉlexˉstatus.Unpairedˉsurrogate;
                                                                    Failureˉoffset = Escapeˉoffset;
                                                                    Failureˉline = Line;
                                                                    Failureˉcolumn = Escapeˉcolumn;
                                                                }
                                                            }
                                                            Pendingˉhighˉsurrogate = false;
                                                        } else {
                                                            if Pendingˉhighˉsurrogate {
                                                                if Stringˉstatus == Compilerˉlexˉstatus.Valid {
                                                                    Stringˉstatus = Compilerˉlexˉstatus.Unpairedˉsurrogate;
                                                                    Failureˉoffset = Escapeˉoffset;
                                                                    Failureˉline = Line;
                                                                    Failureˉcolumn = Escapeˉcolumn;
                                                                }
                                                            }
                                                            Pendingˉhighˉsurrogate = false;
                                                        }
                                                    }
                                                } else {
                                                    if Pendingˉhighˉsurrogate {
                                                        if Stringˉstatus == Compilerˉlexˉstatus.Valid {
                                                            Stringˉstatus = Compilerˉlexˉstatus.Unpairedˉsurrogate;
                                                            Failureˉoffset = Escapeˉoffset;
                                                            Failureˉline = Line;
                                                            Failureˉcolumn = Escapeˉcolumn;
                                                        }
                                                    }
                                                    Pendingˉhighˉsurrogate = false;
                                                }
                                            }
                                            Cursor = Cursor + 4u32;
                                            Column = Column + 4u32;
                                        }
                                    } else {
                                        var Escapeˉvalid: bool = false;
                                        if Escape == 34u8 { Escapeˉvalid = true; }
                                        if Escape == 92u8 { Escapeˉvalid = true; }
                                        if Escape == 110u8 { Escapeˉvalid = true; }
                                        if Escape == 114u8 { Escapeˉvalid = true; }
                                        if Escape == 116u8 { Escapeˉvalid = true; }
                                        if !Escapeˉvalid {
                                            if Stringˉstatus == Compilerˉlexˉstatus.Valid {
                                                Stringˉstatus = Compilerˉlexˉstatus.Unsupportedˉescape;
                                                Failureˉoffset = Escapeˉoffset;
                                                Failureˉline = Line;
                                                Failureˉcolumn = Escapeˉcolumn;
                                            }
                                        }
                                        if Pendingˉhighˉsurrogate {
                                            if Stringˉstatus == Compilerˉlexˉstatus.Valid {
                                                Stringˉstatus = Compilerˉlexˉstatus.Unpairedˉsurrogate;
                                                Failureˉoffset = Escapeˉoffset;
                                                Failureˉline = Line;
                                                Failureˉcolumn = Escapeˉcolumn;
                                            }
                                        }
                                        Pendingˉhighˉsurrogate = false;
                                        Cursor = Cursor + 1u32;
                                        Column = Column + 1u32;
                                    }
                                }
                            } else {
                                if Pendingˉhighˉsurrogate {
                                    if Stringˉstatus == Compilerˉlexˉstatus.Valid {
                                        Stringˉstatus = Compilerˉlexˉstatus.Unpairedˉsurrogate;
                                        Failureˉoffset = Cursor;
                                        Failureˉline = Line;
                                        Failureˉcolumn = Column;
                                    }
                                }
                                Pendingˉhighˉsurrogate = false;
                                let Characterˉlength: u32 = Compilerˉsourceˉutf8ˉlength(Input, Cursor);
                                Column = Column + Compilerˉsourceˉcolumnˉwidth(Input, Cursor);
                                Cursor = Cursor + Characterˉlength;
                            }
                        }
                    }
                }
            }
        }
        if !Terminated {
            if Stringˉstatus == Compilerˉlexˉstatus.Valid {
                Stringˉstatus = Compilerˉlexˉstatus.Unterminatedˉstring;
                Failureˉoffset = Tokenˉstart;
                Failureˉline = Tokenˉline;
                Failureˉcolumn = Tokenˉcolumn;
            }
        } else {
            if Pendingˉhighˉsurrogate {
                if Stringˉstatus == Compilerˉlexˉstatus.Valid {
                    Stringˉstatus = Compilerˉlexˉstatus.Unpairedˉsurrogate;
                    Failureˉoffset = Tokenˉstart;
                    Failureˉline = Tokenˉline;
                    Failureˉcolumn = Tokenˉcolumn;
                }
            }
        }
        return Compilerˉsourceˉtokenˉmake(
            Stringˉstatus,
            Compilerˉtokenˉkind.String,
            Tokenˉstart,
            Cursor,
            Tokenˉline,
            Tokenˉcolumn,
            Line,
            Column,
            Compilerˉnumericˉkind.None,
            0u32,
            Failureˉoffset,
            Failureˉline,
            Failureˉcolumn
        );
    }

    var Kind: Compilerˉtokenˉkind = Compilerˉtokenˉkind.Bad;
    var Width: u32 = 1u32;
    if First == 37u8 { Kind = Compilerˉtokenˉkind.Percent; }
    if First == 38u8 { Kind = Compilerˉtokenˉkind.Ampersand; }
    if First == 47u8 { Kind = Compilerˉtokenˉkind.Slash; }
    if First == 94u8 { Kind = Compilerˉtokenˉkind.Caret; }
    if First == 124u8 { Kind = Compilerˉtokenˉkind.Pipe; }
    if First == 126u8 { Kind = Compilerˉtokenˉkind.Tilde; }
    if Firstˉvalue < 40u32 {
        if First == 33u8 {
            Kind = Compilerˉtokenˉkind.Bang;
            if Total - Cursor >= 2u32 {
                if Bytesˉreadˉu8(Input, Cursor + 1u32) == 61u8 {
                    Kind = Compilerˉtokenˉkind.Bangˉequals;
                    Width = 2u32;
                }
            }
        }
        if First == 38u8 {
            if Total - Cursor >= 2u32 {
                if Bytesˉreadˉu8(Input, Cursor + 1u32) == 38u8 {
                    Kind = Compilerˉtokenˉkind.Andˉand;
                    Width = 2u32;
                }
            }
        }
    } else {
        if Firstˉvalue <= 46u32 {
            if Firstˉvalue <= 42u32 {
                if First == 40u8 { Kind = Compilerˉtokenˉkind.Leftˉparenthesis; }
                if First == 41u8 { Kind = Compilerˉtokenˉkind.Rightˉparenthesis; }
                if First == 42u8 {
                    Kind = Compilerˉtokenˉkind.Star;
                    if Total - Cursor >= 2u32 {
                        if Bytesˉreadˉu8(Input, Cursor + 1u32) == 61u8 {
                            Kind = Compilerˉtokenˉkind.Starˉequals;
                            Width = 2u32;
                        }
                    }
                }
            } else {
                if First == 43u8 {
                    Kind = Compilerˉtokenˉkind.Plus;
                    if Total - Cursor >= 2u32 {
                        if Bytesˉreadˉu8(Input, Cursor + 1u32) == 61u8 {
                            Kind = Compilerˉtokenˉkind.Plusˉequals;
                            Width = 2u32;
                        }
                    }
                }
                if First == 44u8 { Kind = Compilerˉtokenˉkind.Comma; }
                if First == 45u8 {
                    Kind = Compilerˉtokenˉkind.Minus;
                    if Total - Cursor >= 2u32 {
                        if Bytesˉreadˉu8(Input, Cursor + 1u32) == 62u8 {
                            Kind = Compilerˉtokenˉkind.Arrow;
                            Width = 2u32;
                        }
                        if Bytesˉreadˉu8(Input, Cursor + 1u32) == 61u8 {
                            Kind = Compilerˉtokenˉkind.Minusˉequals;
                            Width = 2u32;
                        }
                    }
                }
                if First == 46u8 { Kind = Compilerˉtokenˉkind.Dot; }
            }
        } else {
            if Firstˉvalue >= 58u32 {
                if Firstˉvalue <= 62u32 {
                    if Firstˉvalue <= 59u32 {
                        if First == 58u8 { Kind = Compilerˉtokenˉkind.Colon; }
                        if First == 59u8 { Kind = Compilerˉtokenˉkind.Semicolon; }
                    } else {
                        if First == 60u8 {
                            Kind = Compilerˉtokenˉkind.Less;
                            if Total - Cursor >= 2u32 {
                                if Bytesˉreadˉu8(Input, Cursor + 1u32) == 60u8 {
                                    Kind = Compilerˉtokenˉkind.Shiftˉleft;
                                    Width = 2u32;
                                } else if Bytesˉreadˉu8(Input, Cursor + 1u32) == 61u8 {
                                    Kind = Compilerˉtokenˉkind.Lessˉequals;
                                    Width = 2u32;
                                }
                            }
                        }
                        if First == 61u8 {
                            Kind = Compilerˉtokenˉkind.Equals;
                            if Total - Cursor >= 2u32 {
                                if Bytesˉreadˉu8(Input, Cursor + 1u32) == 61u8 {
                                    Kind = Compilerˉtokenˉkind.Equalsˉequals;
                                    Width = 2u32;
                                }
                            }
                        }
                        if First == 62u8 {
                            Kind = Compilerˉtokenˉkind.Greater;
                            if Total - Cursor >= 2u32 {
                                if Bytesˉreadˉu8(Input, Cursor + 1u32) == 62u8 {
                                    Kind = Compilerˉtokenˉkind.Shiftˉright;
                                    Width = 2u32;
                                } else if Bytesˉreadˉu8(Input, Cursor + 1u32) == 61u8 {
                                    Kind = Compilerˉtokenˉkind.Greaterˉequals;
                                    Width = 2u32;
                                }
                            }
                        }
                    }
                } else {
                    if Firstˉvalue < 100u32 {
                        if First == 91u8 { Kind = Compilerˉtokenˉkind.Leftˉbracket; }
                        if First == 93u8 { Kind = Compilerˉtokenˉkind.Rightˉbracket; }
                    } else {
                        if First == 123u8 { Kind = Compilerˉtokenˉkind.Leftˉbrace; }
                        if First == 124u8 {
                            if Total - Cursor >= 2u32 {
                                if Bytesˉreadˉu8(Input, Cursor + 1u32) == 124u8 {
                                    Kind = Compilerˉtokenˉkind.Orˉor;
                                    Width = 2u32;
                                }
                            }
                        }
                        if First == 125u8 { Kind = Compilerˉtokenˉkind.Rightˉbrace; }
                    }
                }
            }
        }
    }
    if Kind != Compilerˉtokenˉkind.Bad {
        Cursor = Cursor + Width;
        Column = Column + Width;
        return Compilerˉsourceˉtokenˉmake(
            Compilerˉlexˉstatus.Valid,
            Kind,
            Tokenˉstart,
            Cursor,
            Tokenˉline,
            Tokenˉcolumn,
            Line,
            Column,
            Compilerˉnumericˉkind.None,
            0u32,
            Tokenˉstart,
            Tokenˉline,
            Tokenˉcolumn
        );
    }

    let Badˉlength: u32 = Compilerˉsourceˉutf8ˉlength(Input, Cursor);
    Cursor = Cursor + Badˉlength;
    Column = Column + Compilerˉsourceˉcolumnˉwidth(Input, Tokenˉstart);
    return Compilerˉsourceˉtokenˉmake(
        Compilerˉlexˉstatus.Unexpectedˉcharacter,
        Compilerˉtokenˉkind.Bad,
        Tokenˉstart,
        Cursor,
        Tokenˉline,
        Tokenˉcolumn,
        Line,
        Column,
        Compilerˉnumericˉkind.None,
        0u32,
        Tokenˉstart,
        Tokenˉline,
        Tokenˉcolumn
    );
}

export fn Compilerˉlexˉnext(
    Input: bytes,
    Start: u32,
    Startˉline: u32,
    Startˉcolumn: u32
) -> Compilerˉsourceˉtoken {
    let Total: u32 = Bytesˉlength(Input);
    if Total > 4194304u32 {
        return Compilerˉsourceˉtokenˉmake(
            Compilerˉlexˉstatus.Sourceˉtooˉlarge,
            Compilerˉtokenˉkind.Bad,
            0u32,
            0u32,
            1u32,
            1u32,
            1u32,
            1u32,
            Compilerˉnumericˉkind.None,
            0u32,
            4194304u32,
            1u32,
            1u32
        );
    }
    if !Textˉutf8ˉisˉvalid(Input) {
        return Compilerˉsourceˉtokenˉmake(
            Compilerˉlexˉstatus.Invalidˉutf8,
            Compilerˉtokenˉkind.Bad,
            0u32,
            0u32,
            1u32,
            1u32,
            1u32,
            1u32,
            Compilerˉnumericˉkind.None,
            0u32,
            0u32,
            1u32,
            1u32
        );
    }
    return Compilerˉlexˉnextˉvalidated(Input, Start, Startˉline, Startˉcolumn);
}

export fn Compilerˉlexˉsourceˉbounded(
    Input: bytes,
    Maximumˉtokens: u32
) -> Compilerˉsourceˉscan {
    if Maximumˉtokens > 262144u32 {
        return Compilerˉsourceˉscan(
            Compilerˉlexˉstatus.Invalidˉlimit,
            0u32,
            0u32,
            1u32,
            1u32,
            0u32,
            1u32,
            1u32
        );
    }
    var Token: Compilerˉsourceˉtoken = Compilerˉlexˉnext(Input, 0u32, 1u32, 1u32);
    var Tokens: u32 = 0u32;
    while Token.Kind != Compilerˉtokenˉkind.End {
        if Token.Status != Compilerˉlexˉstatus.Valid {
            return Compilerˉsourceˉscan(
                Token.Status,
                Tokens,
                Token.Failureˉoffset,
                Token.Failureˉline,
                Token.Failureˉcolumn,
                Token.Nextˉoffset,
                Token.Nextˉline,
                Token.Nextˉcolumn
            );
        }
        if Tokens == Maximumˉtokens {
            return Compilerˉsourceˉscan(
                Compilerˉlexˉstatus.Tooˉmanyˉtokens,
                Tokens,
                Token.Offset,
                Token.Line,
                Token.Column,
                Token.Offset,
                Token.Line,
                Token.Column
            );
        }
        Tokens = Tokens + 1u32;
        Token = Compilerˉlexˉnextˉafterˉscan(
            Input,
            Token.Nextˉoffset,
            Token.Nextˉline,
            Token.Nextˉcolumn
        );
    }
    return Compilerˉsourceˉscan(
        Token.Status,
        Tokens,
        Token.Failureˉoffset,
        Token.Failureˉline,
        Token.Failureˉcolumn,
        Token.Nextˉoffset,
        Token.Nextˉline,
        Token.Nextˉcolumn
    );
}

export fn Compilerˉlexˉsource(Input: bytes) -> Compilerˉsourceˉscan {
    return Compilerˉlexˉsourceˉbounded(Input, 262144u32);
}

export fn Compilerˉlexˉtokenˉat(Input: bytes, Wanted: u32) -> Compilerˉsourceˉtoken {
    var Token: Compilerˉsourceˉtoken = Compilerˉlexˉnext(Input, 0u32, 1u32, 1u32);
    var Index: u32 = 0u32;
    while Index < Wanted {
        if Token.Status != Compilerˉlexˉstatus.Valid { return Token; }
        if Token.Kind == Compilerˉtokenˉkind.End { return Token; }
        Token = Compilerˉlexˉnextˉafterˉscan(
            Input,
            Token.Nextˉoffset,
            Token.Nextˉline,
            Token.Nextˉcolumn
        );
        Index = Index + 1u32;
    }
    return Token;
}
