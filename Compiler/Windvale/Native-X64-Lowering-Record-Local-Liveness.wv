#!wv/1 en@1
module Compilerˉnativeˉx64ˉloweringˉrecordˉlocalˉliveness;
profile core;
platform linux, windows, windvale;
authority library;


import Compilerˉnativeˉx64ˉloweringˉtypes as Nominalˉtypes;
import Compilerˉnativeˉx64ˉloweringˉrecordˉallocation as Allocation;

export record Compilerˉnativeˉx64ˉrecordˉlocalˉdirectory {
    Indices: bytes;
    Types: bytes;
    Count: u32;
}

fn Empty(Input: bytes) -> bytes {
    return Bytesˉslice(Input, 0u32, 0u32);
}

fn Repeatˉbytes(Input: bytes, Count: u32, Value: bytes) -> bytes {
    var Result: bytes = Empty(Input);
    var Chunk: bytes = Value;
    var Remaining: u32 = Count;
    while Remaining > 0u32 {
        if Remaining % 2u32 == 1u32 {
            Result = Bytesˉconcat(Result, Chunk);
        }
        Remaining = Remaining / 2u32;
        if Remaining > 0u32 {
            Chunk = Bytesˉconcat(Chunk, Chunk);
        }
    }
    return Result;
}

fn Zeros(Input: bytes, Count: u32) -> bytes {
    return Repeatˉbytes(Input, Count, Bytesˉfromˉu8(0u8));
}

fn Setˉbyte(Input: bytes, Index: u32, Value: u8) -> bytes {
    return Bytesˉconcat(
        Bytesˉconcat(
            Bytesˉslice(Input, 0u32, Index),
            Bytesˉfromˉu8(Value)
        ),
        Bytesˉslice(Input, Index + 1u32, Bytesˉlength(Input) - Index - 1u32)
    );
}

fn Packedˉrowˉbytes(Recordˉlocals: u32) -> u32 {
    return (Recordˉlocals + 7u32) / 8u32;
}

fn Packedˉliveˉat(
    Values: bytes,
    Recordˉlocals: u32,
    Block: u32,
    Local: u32
) -> u8 {
    let Rowˉbytes: u32 = Packedˉrowˉbytes(Recordˉlocals);
    let Value: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(
        Values,
        Block * Rowˉbytes + Local / 8u32
    ));
    if (Value & (1u32 << (Local % 8u32))) != 0u32 { return 1u8; }
    return 0u8;
}

fn Packˉlive(Live: bytes, Recordˉlocals: u32) -> bytes {
    var Result: bytes = Empty(Live);
    var Byteˉindex: u32 = 0u32;
    while Byteˉindex < Packedˉrowˉbytes(Recordˉlocals) {
        var Value: u32 = 0u32;
        var Bit: u32 = 0u32;
        while Bit < 8u32 {
            let Local: u32 = Byteˉindex * 8u32 + Bit;
            if Local < Recordˉlocals {
                if Bytesˉreadˉu8(Live, Local) == 1u8 {
                    Value = Value | (1u32 << Bit);
                }
            }
            Bit = Bit + 1u32;
        }
        Result = Bytesˉconcat(
            Result,
            Bytesˉslice(Bytesˉfromˉu32ˉlittle(Value), 0u32, 1u32)
        );
        Byteˉindex = Byteˉindex + 1u32;
    }
    return Result;
}

fn Appendˉinterferenceˉevent(
    Events: bytes,
    Value: u32,
    Live: bytes,
    Recordˉlocals: u32
) -> bytes {
    return Bytesˉconcat(
        Events,
        Bytesˉconcat(
            Bytesˉfromˉu32ˉlittle(Value),
            Packˉlive(Live, Recordˉlocals)
        )
    );
}

fn Liveˉinˉat(
    Liveˉin: bytes,
    Updatedˉin: bytes,
    Updatedˉstart: u32,
    Recordˉlocals: u32,
    Block: u32,
    Local: u32
) -> u8 {
    if Block >= Updatedˉstart {
        return Packedˉliveˉat(
            Updatedˉin,
            Recordˉlocals,
            Block - Updatedˉstart,
            Local
        );
    }
    return Packedˉliveˉat(
        Liveˉin,
        Recordˉlocals,
        Block,
        Local
    );
}

fn Flowˉblock(
    Input: bytes,
    Recordˉlocals: u32,
    Block: u32,
    Successorˉfirst: bytes,
    Successorˉsecond: bytes,
    Uses: bytes,
    Definitions: bytes,
    Liveˉin: bytes,
    Updatedˉin: bytes,
    Updatedˉstart: u32
) -> bytes {
    let First: u32 = Bytesˉreadˉu32ˉlittle(
        Successorˉfirst,
        Block * 4u32
    );
    let Second: u32 = Bytesˉreadˉu32ˉlittle(
        Successorˉsecond,
        Block * 4u32
    );
    var Nextˉin: bytes = Empty(Input);
    var Changed: u8 = 0u8;
    var Local: u32 = 0u32;
    var Packed: u32 = 0u32;
    var Bit: u32 = 0u32;
    while Local < Recordˉlocals {
        var Out: u8 = 0u8;
        if First != 4294967295u32 {
            if Liveˉinˉat(
                Liveˉin,
                Updatedˉin,
                Updatedˉstart,
                Recordˉlocals,
                First,
                Local
            ) == 1u8 {
                Out = 1u8;
            }
        }
        if Second != 4294967295u32 {
            if Liveˉinˉat(
                Liveˉin,
                Updatedˉin,
                Updatedˉstart,
                Recordˉlocals,
                Second,
                Local
            ) == 1u8 {
                Out = 1u8;
            }
        }
        let Cell: u32 = Block * Recordˉlocals + Local;
        var Into: u8 = Bytesˉreadˉu8(Uses, Cell);
        if Into == 0u8 && Out == 1u8 {
            if Bytesˉreadˉu8(Definitions, Cell) == 0u8 {
                Into = 1u8;
            }
        }
        if Packedˉliveˉat(Liveˉin, Recordˉlocals, Block, Local) != Into {
            Changed = 1u8;
        }
        if Into == 1u8 { Packed = Packed | (1u32 << Bit); }
        Bit = Bit + 1u32;
        if Bit == 8u32 || Local + 1u32 == Recordˉlocals {
            Nextˉin = Bytesˉconcat(
                Nextˉin,
                Bytesˉslice(Bytesˉfromˉu32ˉlittle(Packed), 0u32, 1u32)
            );
            Packed = 0u32;
            Bit = 0u32;
        }
        Local = Local + 1u32;
    }
    return Bytesˉconcat(Bytesˉfromˉu8(Changed), Nextˉin);
}

fn Flowˉiteration(
    Input: bytes,
    Blocks: u32,
    Recordˉlocals: u32,
    Successorˉfirst: bytes,
    Successorˉsecond: bytes,
    Uses: bytes,
    Definitions: bytes,
    Liveˉin: bytes
) -> bytes {
    var Nextˉin: bytes = Empty(Input);
    var Changed: u8 = 0u8;
    let Rowˉbytes: u32 = Packedˉrowˉbytes(Recordˉlocals);
    var Remaining: u32 = Blocks;
    while Remaining > 0u32 {
        let Block: u32 = Remaining - 1u32;
        let Values: bytes = Flowˉblock(
            Input,
            Recordˉlocals,
            Block,
            Successorˉfirst,
            Successorˉsecond,
            Uses,
            Definitions,
            Liveˉin,
            Nextˉin,
            Block + 1u32
        );
        if Bytesˉreadˉu8(Values, 0u32) == 1u8 { Changed = 1u8; }
        Nextˉin = Bytesˉconcat(
            Bytesˉslice(Values, 1u32, Rowˉbytes),
            Nextˉin
        );
        Remaining = Block;
    }
    return Bytesˉconcat(Bytesˉfromˉu8(Changed), Nextˉin);
}

fn Blockˉliveˉout(
    Input: bytes,
    Recordˉlocals: u32,
    Block: u32,
    Successorˉfirst: bytes,
    Successorˉsecond: bytes,
    Liveˉin: bytes
) -> bytes {
    let First: u32 = Bytesˉreadˉu32ˉlittle(
        Successorˉfirst,
        Block * 4u32
    );
    let Second: u32 = Bytesˉreadˉu32ˉlittle(
        Successorˉsecond,
        Block * 4u32
    );
    var Result: bytes = Empty(Input);
    var Local: u32 = 0u32;
    while Local < Recordˉlocals {
        var Out: u8 = 0u8;
        if First != 4294967295u32 {
            if Packedˉliveˉat(
                Liveˉin,
                Recordˉlocals,
                First,
                Local
            ) == 1u8 { Out = 1u8; }
        }
        if Second != 4294967295u32 {
            if Packedˉliveˉat(
                Liveˉin,
                Recordˉlocals,
                Second,
                Local
            ) == 1u8 { Out = 1u8; }
        }
        Result = Bytesˉconcat(Result, Bytesˉfromˉu8(Out));
        Local = Local + 1u32;
    }
    return Result;
}

export fn Compilerˉnativeˉx64ˉrecordˉlocalˉdirectoryˉread(
    Input: bytes,
    Parameters: u32,
    Localˉtypes: bytes
) -> Compilerˉnativeˉx64ˉrecordˉlocalˉdirectory {
    var Indices: bytes = Empty(Input);
    var Types: bytes = Empty(Input);
    var Count: u32 = 0u32;
    var Local: u32 = 0u32;
    while Local < Bytesˉlength(Localˉtypes) {
        let Type: u8 = Bytesˉreadˉu8(Localˉtypes, Local);
        if Local >= Parameters &&
            Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉisˉrecord(Type) {
            Indices = Bytesˉconcat(
                Indices,
                Bytesˉfromˉu32ˉlittle(Count)
            );
            Types = Bytesˉconcat(Types, Bytesˉfromˉu8(Type));
            Count = Count + 1u32;
        } else {
            Indices = Bytesˉconcat(
                Indices,
                Bytesˉfromˉu32ˉlittle(4294967295u32)
            );
        }
        Local = Local + 1u32;
    }
    return Compilerˉnativeˉx64ˉrecordˉlocalˉdirectory(
        Indices,
        Types,
        Count
    );
}

export fn Compilerˉnativeˉx64ˉplanˉrecordˉlocalˉstorage(
    Input: bytes,
    Codeˉoffset: u32,
    Directory: Compilerˉnativeˉx64ˉrecordˉlocalˉdirectory,
    Types: Nominalˉtypes.Compilerˉnativeˉx64ˉtypes,
    Blocks: u32,
    Instructionˉoffsets: bytes,
    Blockˉstarts: bytes,
    Blockˉends: bytes,
    Successorˉfirst: bytes,
    Successorˉsecond: bytes,
    Uses: bytes,
    Definitions: bytes
) -> Allocation.Compilerˉnativeˉx64ˉrecordˉallocation {
    let Recordˉlocals: u32 = Directory.Count;
    let Liveˉinˉbytes: u32 = Blocks * Packedˉrowˉbytes(Recordˉlocals);
    var Liveˉin: bytes = Zeros(Input, Liveˉinˉbytes);
    var Iteration: u32 = 0u32;
    var Changed: bool = true;
    while Changed {
        let Next: bytes = Flowˉiteration(
            Input,
            Blocks,
            Recordˉlocals,
            Successorˉfirst,
            Successorˉsecond,
            Uses,
            Definitions,
            Liveˉin
        );
        Changed = Bytesˉreadˉu8(Next, 0u32) == 1u8;
        Liveˉin = Bytesˉslice(Next, 1u32, Liveˉinˉbytes);
        Iteration = Iteration + 1u32;
        if Iteration >= Blocks { Changed = false; }
    }

    var Present: bytes = Zeros(Input, Recordˉlocals);
    var Interference: bytes = Zeros(
        Input,
        Allocation.Compilerˉnativeˉx64ˉrecordˉinterferenceˉbytes(
            Recordˉlocals
        )
    );
    var Block: u32 = 0u32;
    while Block < Blocks {
        var Interferenceˉevents: bytes = Empty(Input);
        var Live: bytes = Blockˉliveˉout(
            Input,
            Recordˉlocals,
            Block,
            Successorˉfirst,
            Successorˉsecond,
            Liveˉin
        );
        Interferenceˉevents = Appendˉinterferenceˉevent(
            Interferenceˉevents,
            4294967295u32,
            Live,
            Recordˉlocals
        );
        var Reverse: u32 = Bytesˉreadˉu32ˉlittle(Blockˉends, Block * 4u32);
        let Start: u32 = Bytesˉreadˉu32ˉlittle(Blockˉstarts, Block * 4u32);
        while Reverse > Start {
            Reverse = Reverse - 1u32;
            let Cursor: u32 = Bytesˉreadˉu32ˉlittle(
                Instructionˉoffsets,
                Reverse * 4u32
            );
            let Opcode: u8 = Bytesˉreadˉu8(Input, Codeˉoffset + Cursor);
            if Opcode == 5u8 {
                let Storeˉlocal: u32 = Bytesˉreadˉu32ˉlittle(
                    Input,
                    Codeˉoffset + Cursor + 1u32
                );
                let Storeˉrecord: u32 = Bytesˉreadˉu32ˉlittle(
                    Directory.Indices,
                    Storeˉlocal * 4u32
                );
                if Storeˉrecord != 4294967295u32 {
                    Present = Setˉbyte(Present, Storeˉrecord, 1u8);
                    Interferenceˉevents = Appendˉinterferenceˉevent(
                        Interferenceˉevents,
                        Storeˉrecord,
                        Live,
                        Recordˉlocals
                    );
                    Live = Setˉbyte(Live, Storeˉrecord, 0u8);
                }
            }
            if Opcode == 4u8 || Opcode == 205u8 || Opcode == 225u8 {
                let Loadˉlocal: u32 = Bytesˉreadˉu32ˉlittle(
                    Input,
                    Codeˉoffset + Cursor + 1u32
                );
                let Loadˉrecord: u32 = Bytesˉreadˉu32ˉlittle(
                    Directory.Indices,
                    Loadˉlocal * 4u32
                );
                if Loadˉrecord != 4294967295u32 {
                    Present = Setˉbyte(Present, Loadˉrecord, 1u8);
                    Live = Setˉbyte(Live, Loadˉrecord, 1u8);
                    Interferenceˉevents = Appendˉinterferenceˉevent(
                        Interferenceˉevents,
                        Loadˉrecord,
                        Live,
                        Recordˉlocals
                    );
                }
            }
        }
        Interference =
            Allocation.Compilerˉnativeˉx64ˉbuildˉrecordˉinterference(
                Interference,
                Interferenceˉevents,
                Recordˉlocals
            );
        Block = Block + 1u32;
    }
    let Compact: Allocation.Compilerˉnativeˉx64ˉrecordˉallocation =
        Allocation.Compilerˉnativeˉx64ˉallocateˉrecordˉoffsets(
            Input,
            Types,
            Present,
            Directory.Types,
            Interference,
            Recordˉlocals
        );
    let Locals: u32 = Bytesˉlength(Directory.Indices) / 4u32;
    var Offsets: bytes = Empty(Input);
    var Local: u32 = 0u32;
    while Local < Locals {
        let Recordˉlocal: u32 = Bytesˉreadˉu32ˉlittle(
            Directory.Indices,
            Local * 4u32
        );
        var Offset: u32 = 4294967295u32;
        if Recordˉlocal != 4294967295u32 {
            Offset = Bytesˉreadˉu32ˉlittle(
                Compact.Offsets,
                Recordˉlocal * 4u32
            );
        }
        Offsets = Bytesˉconcat(
            Offsets,
            Bytesˉfromˉu32ˉlittle(Offset)
        );
        Local = Local + 1u32;
    }
    return Allocation.Compilerˉnativeˉx64ˉrecordˉallocation(
        Offsets,
        Compact.Fields
    );
}

// The shared profile uses the independently proved owner roots in its ordinary
// local live rows. The existing offset allocator still owns coloring.
export fn Compilerˉnativeˉx64ˉplanˉsharedˉrecordˉlocalˉstorage(
    Input: bytes, Codeˉoffset: u32,
    Directory: Compilerˉnativeˉx64ˉrecordˉlocalˉdirectory,
    Types: Nominalˉtypes.Compilerˉnativeˉx64ˉtypes,
    Rows: bytes, Locals: u32, Rowˉbytes: u32
) -> Allocation.Compilerˉnativeˉx64ˉrecordˉallocation {
    let Count: u32 = Directory.Count;
    let Invalid: Allocation.Compilerˉnativeˉx64ˉrecordˉallocation =
        Allocation.Compilerˉnativeˉx64ˉrecordˉallocation(Empty(Input), 4294967295u32);
    if Locals >= 2048u32 || Count > 1024u32 ||
        Bytesˉlength(Directory.Indices) != Locals * 4u32 ||
        Bytesˉlength(Directory.Types) != Count ||
        Rowˉbytes != 4u32 + 2u32 * ((Locals + 7u32) / 8u32) ||
        Rowˉbytes == 0u32 || Bytesˉlength(Rows) % Rowˉbytes != 0u32 ||
        Bytesˉlength(Rows) / Rowˉbytes > 32768u32 {
        return Invalid;
    }
    var Recordˉtoˉlocal: bytes = Empty(Input);
    var Local: u32 = 0u32;
    while Local < Locals {
        let Record: u32 = Bytesˉreadˉu32ˉlittle(Directory.Indices, Local * 4u32);
        if Record != 4294967295u32 {
            if Record != Bytesˉlength(Recordˉtoˉlocal) / 4u32 { return Invalid; }
            Recordˉtoˉlocal = Bytesˉconcat(Recordˉtoˉlocal, Bytesˉfromˉu32ˉlittle(Local));
        }
        Local = Local + 1u32;
    }
    if Bytesˉlength(Recordˉtoˉlocal) != Count * 4u32 { return Invalid; }
    var Present: bytes = Zeros(Input, Count);
    var Interference: bytes = Zeros(Input,
        Allocation.Compilerˉnativeˉx64ˉrecordˉinterferenceˉbytes(Count));
    var Events: bytes = Empty(Input);
    var Row: u32 = 0u32;
    var Previous: u32 = 0u32;
    while Row < Bytesˉlength(Rows) / Rowˉbytes {
        let Cursor: u32 = Bytesˉreadˉu32ˉlittle(Rows, Row * Rowˉbytes);
        if (Row > 0u32 && Cursor <= Previous) || Codeˉoffset > Bytesˉlength(Input) ||
            Cursor >= Bytesˉlength(Input) - Codeˉoffset { return Invalid; }
        Previous = Cursor;
        let Opcode: u8 = Bytesˉreadˉu8(Input, Codeˉoffset + Cursor);
        var Store: u32 = 4294967295u32;
        if Opcode == 5u8 {
            if Bytesˉlength(Input) - Codeˉoffset - Cursor < 5u32 { return Invalid; }
            let Target: u32 = Bytesˉreadˉu32ˉlittle(Input, Codeˉoffset + Cursor + 1u32);
            if Target >= Locals { return Invalid; }
            Store = Bytesˉreadˉu32ˉlittle(Directory.Indices, Target * 4u32);
            if Store != 4294967295u32 && Bytesˉreadˉu8(Present, Store) == 0u8 {
                Present = Setˉbyte(Present, Store, 1u8);
            }
        }
        var Side: u32 = 0u32;
        while Side < 2u32 {
            var Packed: bytes = Empty(Input);
            var First: u32 = 0u32;
            while First < Count {
                var Bits: u32 = 0u32;
                var Bit: u32 = 0u32;
                while Bit < 8u32 && First + Bit < Count {
                    let Actual: u32 = Bytesˉreadˉu32ˉlittle(Recordˉtoˉlocal, (First + Bit) * 4u32);
                    let Live: u8 = Bytesˉreadˉu8(Rows, Row * Rowˉbytes + 4u32 +
                        Side * ((Locals + 7u32) / 8u32) + Actual / 8u32);
                    if (U32ˉfromˉu8(Live) & (1u32 << (Actual % 8u32))) != 0u32 {
                        Bits = Bits | (1u32 << Bit);
                        if Bytesˉreadˉu8(Present, First + Bit) == 0u8 {
                            Present = Setˉbyte(Present, First + Bit, 1u8);
                        }
                    }
                    Bit = Bit + 1u32;
                }
                Packed = Bytesˉconcat(Packed, Bytesˉslice(Bytesˉfromˉu32ˉlittle(Bits), 0u32, 1u32));
                First = First + 8u32;
            }
            var Value: u32 = 4294967295u32;
            if Side == 1u32 { Value = Store; }
            Events = Bytesˉconcat(Events, Bytesˉconcat(Bytesˉfromˉu32ˉlittle(Value), Packed));
            // A definition may not overwrite a root whose final borrowed use
            // is this store: ordinary last-use cleanup runs after the copy.
            if Side == 0u32 && Store != 4294967295u32 {
                Events = Bytesˉconcat(Events, Bytesˉconcat(Bytesˉfromˉu32ˉlittle(Store), Packed));
            }
            if Bytesˉlength(Events) >= 65536u32 {
                Interference = Allocation.Compilerˉnativeˉx64ˉbuildˉrecordˉinterference(Interference, Events, Count);
                Events = Empty(Input);
            }
            Side = Side + 1u32;
        }
        Row = Row + 1u32;
    }
    Interference = Allocation.Compilerˉnativeˉx64ˉbuildˉrecordˉinterference(Interference, Events, Count);
    let Compact: Allocation.Compilerˉnativeˉx64ˉrecordˉallocation =
        Allocation.Compilerˉnativeˉx64ˉallocateˉrecordˉoffsets(Input, Types, Present,
            Directory.Types, Interference, Count);
    if Compact.Fields == 4294967295u32 || Bytesˉlength(Compact.Offsets) != Count * 4u32 { return Invalid; }
    var Offsets: bytes = Empty(Input);
    Local = 0u32;
    while Local < Locals {
        let Selectedˉrecord: u32 = Bytesˉreadˉu32ˉlittle(Directory.Indices, Local * 4u32);
        var Offset: u32 = 4294967295u32;
        if Selectedˉrecord != 4294967295u32 { Offset = Bytesˉreadˉu32ˉlittle(Compact.Offsets, Selectedˉrecord * 4u32); }
        Offsets = Bytesˉconcat(Offsets, Bytesˉfromˉu32ˉlittle(Offset));
        Local = Local + 1u32;
    }
    return Allocation.Compilerˉnativeˉx64ˉrecordˉallocation(Offsets, Compact.Fields);
}
