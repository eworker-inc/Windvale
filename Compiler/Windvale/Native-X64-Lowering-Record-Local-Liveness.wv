module Compilerˉnativeˉx64ˉloweringˉrecordˉlocalˉliveness profile portable;

import Compilerˉnativeˉx64ˉloweringˉtypes as Nominalˉtypes;
import Compilerˉnativeˉx64ˉloweringˉrecordˉallocation as Allocation;

export record Compilerˉnativeˉx64ˉrecordˉlocalˉdirectory {
    Indices: bytes;
    Types: bytes;
    Count: u32;
}

fn Empty(Input: bytes) -> bytes {
    return Bytesˉslice(Input, 0u32, 0u32);
}

fn Repeatˉbytes(Input: bytes, Count: u32, Value: bytes) -> bytes {
    var Result: bytes = Empty(Input);
    var Chunk: bytes = Value;
    var Remaining: u32 = Count;
    while Remaining > 0u32 {
        if Remaining % 2u32 == 1u32 {
            Result = Bytesˉconcat(Result, Chunk);
        }
        Remaining = Remaining / 2u32;
        if Remaining > 0u32 {
            Chunk = Bytesˉconcat(Chunk, Chunk);
        }
    }
    return Result;
}

fn Zeros(Input: bytes, Count: u32) -> bytes {
    return Repeatˉbytes(Input, Count, Bytesˉfromˉu8(0u8));
}

fn U32ˉvalues(Input: bytes, Count: u32, Value: u32) -> bytes {
    return Repeatˉbytes(
        Input,
        Count,
        Bytesˉfromˉu32ˉlittle(Value)
    );
}

fn Setˉbyte(Input: bytes, Index: u32, Value: u8) -> bytes {
    return Bytesˉconcat(
        Bytesˉconcat(
            Bytesˉslice(Input, 0u32, Index),
            Bytesˉfromˉu8(Value)
        ),
        Bytesˉslice(Input, Index + 1u32, Bytesˉlength(Input) - Index - 1u32)
    );
}

fn Setˉu32(Input: bytes, Index: u32, Value: u32) -> bytes {
    let Offset: u32 = Index * 4u32;
    return Bytesˉconcat(
        Bytesˉconcat(
            Bytesˉslice(Input, 0u32, Offset),
            Bytesˉfromˉu32ˉlittle(Value)
        ),
        Bytesˉslice(
            Input,
            Offset + 4u32,
            Bytesˉlength(Input) - Offset - 4u32
        )
    );
}

fn Packedˉrowˉbytes(Recordˉlocals: u32) -> u32 {
    return (Recordˉlocals + 7u32) / 8u32;
}

fn Packedˉliveˉat(
    Values: bytes,
    Recordˉlocals: u32,
    Block: u32,
    Local: u32
) -> u8 {
    let Rowˉbytes: u32 = Packedˉrowˉbytes(Recordˉlocals);
    let Value: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(
        Values,
        Block * Rowˉbytes + Local / 8u32
    ));
    if (Value & (1u32 << (Local % 8u32))) != 0u32 { return 1u8; }
    return 0u8;
}

fn Liveˉinˉat(
    Liveˉin: bytes,
    Updatedˉin: bytes,
    Updatedˉstart: u32,
    Recordˉlocals: u32,
    Block: u32,
    Local: u32
) -> u8 {
    if Block >= Updatedˉstart {
        return Packedˉliveˉat(
            Updatedˉin,
            Recordˉlocals,
            Block - Updatedˉstart,
            Local
        );
    }
    return Packedˉliveˉat(
        Liveˉin,
        Recordˉlocals,
        Block,
        Local
    );
}

fn Flowˉblock(
    Input: bytes,
    Recordˉlocals: u32,
    Block: u32,
    Successorˉfirst: bytes,
    Successorˉsecond: bytes,
    Uses: bytes,
    Definitions: bytes,
    Liveˉin: bytes,
    Updatedˉin: bytes,
    Updatedˉstart: u32
) -> bytes {
    let First: u32 = Bytesˉreadˉu32ˉlittle(
        Successorˉfirst,
        Block * 4u32
    );
    let Second: u32 = Bytesˉreadˉu32ˉlittle(
        Successorˉsecond,
        Block * 4u32
    );
    var Nextˉin: bytes = Empty(Input);
    var Changed: u8 = 0u8;
    var Local: u32 = 0u32;
    var Packed: u32 = 0u32;
    var Bit: u32 = 0u32;
    while Local < Recordˉlocals {
        var Out: u8 = 0u8;
        if First != 4294967295u32 {
            if Liveˉinˉat(
                Liveˉin,
                Updatedˉin,
                Updatedˉstart,
                Recordˉlocals,
                First,
                Local
            ) == 1u8 {
                Out = 1u8;
            }
        }
        if Second != 4294967295u32 {
            if Liveˉinˉat(
                Liveˉin,
                Updatedˉin,
                Updatedˉstart,
                Recordˉlocals,
                Second,
                Local
            ) == 1u8 {
                Out = 1u8;
            }
        }
        let Cell: u32 = Block * Recordˉlocals + Local;
        var Into: u8 = Bytesˉreadˉu8(Uses, Cell);
        if Into == 0u8 && Out == 1u8 {
            if Bytesˉreadˉu8(Definitions, Cell) == 0u8 {
                Into = 1u8;
            }
        }
        if Packedˉliveˉat(Liveˉin, Recordˉlocals, Block, Local) != Into {
            Changed = 1u8;
        }
        if Into == 1u8 { Packed = Packed | (1u32 << Bit); }
        Bit = Bit + 1u32;
        if Bit == 8u32 || Local + 1u32 == Recordˉlocals {
            Nextˉin = Bytesˉconcat(
                Nextˉin,
                Bytesˉslice(Bytesˉfromˉu32ˉlittle(Packed), 0u32, 1u32)
            );
            Packed = 0u32;
            Bit = 0u32;
        }
        Local = Local + 1u32;
    }
    return Bytesˉconcat(Bytesˉfromˉu8(Changed), Nextˉin);
}

fn Flowˉiteration(
    Input: bytes,
    Blocks: u32,
    Recordˉlocals: u32,
    Successorˉfirst: bytes,
    Successorˉsecond: bytes,
    Uses: bytes,
    Definitions: bytes,
    Liveˉin: bytes
) -> bytes {
    var Nextˉin: bytes = Empty(Input);
    var Changed: u8 = 0u8;
    let Rowˉbytes: u32 = Packedˉrowˉbytes(Recordˉlocals);
    var Remaining: u32 = Blocks;
    while Remaining > 0u32 {
        let Block: u32 = Remaining - 1u32;
        let Values: bytes = Flowˉblock(
            Input,
            Recordˉlocals,
            Block,
            Successorˉfirst,
            Successorˉsecond,
            Uses,
            Definitions,
            Liveˉin,
            Nextˉin,
            Block + 1u32
        );
        if Bytesˉreadˉu8(Values, 0u32) == 1u8 { Changed = 1u8; }
        Nextˉin = Bytesˉconcat(
            Bytesˉslice(Values, 1u32, Rowˉbytes),
            Nextˉin
        );
        Remaining = Block;
    }
    return Bytesˉconcat(Bytesˉfromˉu8(Changed), Nextˉin);
}

fn Blockˉliveˉout(
    Input: bytes,
    Recordˉlocals: u32,
    Block: u32,
    Successorˉfirst: bytes,
    Successorˉsecond: bytes,
    Liveˉin: bytes
) -> bytes {
    let First: u32 = Bytesˉreadˉu32ˉlittle(
        Successorˉfirst,
        Block * 4u32
    );
    let Second: u32 = Bytesˉreadˉu32ˉlittle(
        Successorˉsecond,
        Block * 4u32
    );
    var Result: bytes = Empty(Input);
    var Local: u32 = 0u32;
    while Local < Recordˉlocals {
        var Out: u8 = 0u8;
        if First != 4294967295u32 {
            if Packedˉliveˉat(
                Liveˉin,
                Recordˉlocals,
                First,
                Local
            ) == 1u8 { Out = 1u8; }
        }
        if Second != 4294967295u32 {
            if Packedˉliveˉat(
                Liveˉin,
                Recordˉlocals,
                Second,
                Local
            ) == 1u8 { Out = 1u8; }
        }
        Result = Bytesˉconcat(Result, Bytesˉfromˉu8(Out));
        Local = Local + 1u32;
    }
    return Result;
}

export fn Compilerˉnativeˉx64ˉrecordˉlocalˉdirectoryˉread(
    Input: bytes,
    Parameters: u32,
    Localˉtypes: bytes
) -> Compilerˉnativeˉx64ˉrecordˉlocalˉdirectory {
    var Indices: bytes = Empty(Input);
    var Types: bytes = Empty(Input);
    var Count: u32 = 0u32;
    var Local: u32 = 0u32;
    while Local < Bytesˉlength(Localˉtypes) {
        let Type: u8 = Bytesˉreadˉu8(Localˉtypes, Local);
        if Local >= Parameters &&
            Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉisˉrecord(Type) {
            Indices = Bytesˉconcat(
                Indices,
                Bytesˉfromˉu32ˉlittle(Count)
            );
            Types = Bytesˉconcat(Types, Bytesˉfromˉu8(Type));
            Count = Count + 1u32;
        } else {
            Indices = Bytesˉconcat(
                Indices,
                Bytesˉfromˉu32ˉlittle(4294967295u32)
            );
        }
        Local = Local + 1u32;
    }
    return Compilerˉnativeˉx64ˉrecordˉlocalˉdirectory(
        Indices,
        Types,
        Count
    );
}

export fn Compilerˉnativeˉx64ˉplanˉrecordˉlocalˉstorage(
    Input: bytes,
    Codeˉoffset: u32,
    Directory: Compilerˉnativeˉx64ˉrecordˉlocalˉdirectory,
    Types: Nominalˉtypes.Compilerˉnativeˉx64ˉtypes,
    Blocks: u32,
    Instructionˉoffsets: bytes,
    Blockˉstarts: bytes,
    Blockˉends: bytes,
    Successorˉfirst: bytes,
    Successorˉsecond: bytes,
    Uses: bytes,
    Definitions: bytes
) -> Allocation.Compilerˉnativeˉx64ˉrecordˉallocation {
    let Recordˉlocals: u32 = Directory.Count;
    let Liveˉinˉbytes: u32 = Blocks * Packedˉrowˉbytes(Recordˉlocals);
    var Liveˉin: bytes = Zeros(Input, Liveˉinˉbytes);
    var Iteration: u32 = 0u32;
    var Changed: bool = true;
    while Changed {
        let Next: bytes = Flowˉiteration(
            Input,
            Blocks,
            Recordˉlocals,
            Successorˉfirst,
            Successorˉsecond,
            Uses,
            Definitions,
            Liveˉin
        );
        Changed = Bytesˉreadˉu8(Next, 0u32) == 1u8;
        Liveˉin = Bytesˉslice(Next, 1u32, Liveˉinˉbytes);
        Iteration = Iteration + 1u32;
        if Iteration >= Blocks { Changed = false; }
    }

    var Present: bytes = Zeros(Input, Recordˉlocals);
    var Interference: bytes = Zeros(
        Input,
        Allocation.Compilerˉnativeˉx64ˉrecordˉinterferenceˉbytes(
            Recordˉlocals
        )
    );
    var Block: u32 = 0u32;
    while Block < Blocks {
        var Live: bytes = Blockˉliveˉout(
            Input,
            Recordˉlocals,
            Block,
            Successorˉfirst,
            Successorˉsecond,
            Liveˉin
        );
        Interference =
            Allocation.Compilerˉnativeˉx64ˉaddˉallˉliveˉrecordˉinterference(
                Interference,
                Live,
                Recordˉlocals
            );
        var Reverse: u32 = Bytesˉreadˉu32ˉlittle(Blockˉends, Block * 4u32);
        let Start: u32 = Bytesˉreadˉu32ˉlittle(Blockˉstarts, Block * 4u32);
        while Reverse > Start {
            Reverse = Reverse - 1u32;
            let Cursor: u32 = Bytesˉreadˉu32ˉlittle(
                Instructionˉoffsets,
                Reverse * 4u32
            );
            let Opcode: u8 = Bytesˉreadˉu8(Input, Codeˉoffset + Cursor);
            if Opcode == 5u8 {
                let Storeˉlocal: u32 = Bytesˉreadˉu32ˉlittle(
                    Input,
                    Codeˉoffset + Cursor + 1u32
                );
                let Storeˉrecord: u32 = Bytesˉreadˉu32ˉlittle(
                    Directory.Indices,
                    Storeˉlocal * 4u32
                );
                if Storeˉrecord != 4294967295u32 {
                    Present = Setˉbyte(Present, Storeˉrecord, 1u8);
                    Interference =
                        Allocation.Compilerˉnativeˉx64ˉaddˉliveˉrecordˉinterference(
                            Interference,
                            Live,
                            Recordˉlocals,
                            Storeˉrecord
                        );
                    Live = Setˉbyte(Live, Storeˉrecord, 0u8);
                }
            }
            if Opcode == 4u8 {
                let Loadˉlocal: u32 = Bytesˉreadˉu32ˉlittle(
                    Input,
                    Codeˉoffset + Cursor + 1u32
                );
                let Loadˉrecord: u32 = Bytesˉreadˉu32ˉlittle(
                    Directory.Indices,
                    Loadˉlocal * 4u32
                );
                if Loadˉrecord != 4294967295u32 {
                    Present = Setˉbyte(Present, Loadˉrecord, 1u8);
                    Live = Setˉbyte(Live, Loadˉrecord, 1u8);
                    Interference =
                        Allocation.Compilerˉnativeˉx64ˉaddˉliveˉrecordˉinterference(
                            Interference,
                            Live,
                            Recordˉlocals,
                            Loadˉrecord
                        );
                }
            }
        }
        Block = Block + 1u32;
    }
    let Compact: Allocation.Compilerˉnativeˉx64ˉrecordˉallocation =
        Allocation.Compilerˉnativeˉx64ˉallocateˉrecordˉoffsets(
            Input,
            Types,
            Present,
            Directory.Types,
            Interference,
            Recordˉlocals
        );
    let Locals: u32 = Bytesˉlength(Directory.Indices) / 4u32;
    var Offsets: bytes = U32ˉvalues(
        Input,
        Locals,
        4294967295u32
    );
    var Local: u32 = 0u32;
    while Local < Locals {
        let Recordˉlocal: u32 = Bytesˉreadˉu32ˉlittle(
            Directory.Indices,
            Local * 4u32
        );
        if Recordˉlocal != 4294967295u32 {
            Offsets = Setˉu32(
                Offsets,
                Local,
                Bytesˉreadˉu32ˉlittle(
                    Compact.Offsets,
                    Recordˉlocal * 4u32
                )
            );
        }
        Local = Local + 1u32;
    }
    return Allocation.Compilerˉnativeˉx64ˉrecordˉallocation(
        Offsets,
        Compact.Fields
    );
}
