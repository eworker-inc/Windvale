module Compilerˉnativeˉx64ˉloweringˉdata profile portable;

export record Compilerˉnativeˉx64ˉdata {
    Valid: bool;
    Count: u32;
    Kinds: bytes;
    Lengths: bytes;
    Offsets: bytes;
    Sizes: bytes;
    Bytes: bytes;
}

fn Empty(Input: bytes) -> bytes {
    return Bytesˉslice(Input, 0u32, 0u32);
}

fn Invalid(Input: bytes) -> Compilerˉnativeˉx64ˉdata {
    let Emptyˉbytes: bytes = Empty(Input);
    return Compilerˉnativeˉx64ˉdata(
        false,
        0u32,
        Emptyˉbytes,
        Emptyˉbytes,
        Emptyˉbytes,
        Emptyˉbytes,
        Emptyˉbytes
    );
}

fn Rangeˉisˉvalid(Total: u32, Offset: u32, Length: u32) -> bool {
    if Offset > Total { return false; }
    return Length <= Total - Offset;
}

fn Identifierˉisˉvalid(Input: bytes, Offset: u32, Length: u32) -> bool {
    if Length == 0u32 { return false; }
    if Length > 255u32 { return false; }
    if !Rangeˉisˉvalid(Bytesˉlength(Input), Offset, Length) { return false; }
    let End: u32 = Offset + Length;
    var Cursor: u32 = Offset;
    var Wordˉstart: bool = true;
    while Cursor < End {
        let Current: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(Input, Cursor));
        var Valid: bool = false;
        if Current >= 65u32 {
            if Current <= 90u32 { Valid = true; }
        }
        if Current >= 97u32 {
            if Current <= 122u32 { Valid = true; }
        }
        if Current == 95u32 { Valid = true; }
        if !Wordˉstart {
            if Current >= 48u32 {
                if Current <= 57u32 { Valid = true; }
            }
        }
        if Valid {
            Wordˉstart = false;
            Cursor = Cursor + 1u32;
        } else {
            if Wordˉstart { return false; }
            if Current != 203u32 { return false; }
            if Cursor + 1u32 >= End { return false; }
            if Bytesˉreadˉu8(Input, Cursor + 1u32) != 137u8 { return false; }
            Wordˉstart = true;
            Cursor = Cursor + 2u32;
        }
    }
    return !Wordˉstart;
}

export fn Compilerˉnativeˉx64ˉdataˉkind(
    Data: Compilerˉnativeˉx64ˉdata,
    Index: u32
) -> u8 {
    return Bytesˉreadˉu8(Data.Kinds, Index);
}

export fn Compilerˉnativeˉx64ˉdataˉlength(
    Data: Compilerˉnativeˉx64ˉdata,
    Index: u32
) -> u32 {
    return Bytesˉreadˉu32ˉlittle(Data.Lengths, Index * 4u32);
}

export fn Compilerˉnativeˉx64ˉdataˉoffset(
    Data: Compilerˉnativeˉx64ˉdata,
    Index: u32
) -> u32 {
    return Bytesˉreadˉu32ˉlittle(Data.Offsets, Index * 4u32);
}

export fn Compilerˉnativeˉx64ˉdataˉsize(
    Data: Compilerˉnativeˉx64ˉdata,
    Index: u32
) -> u32 {
    return Bytesˉreadˉu32ˉlittle(Data.Sizes, Index * 4u32);
}

export fn Compilerˉnativeˉx64ˉdataˉread(
    Input: bytes,
    Offset: u32,
    Length: u32
) -> Compilerˉnativeˉx64ˉdata {
    if !Rangeˉisˉvalid(Bytesˉlength(Input), Offset, Length) {
        return Invalid(Input);
    }
    if Length < 4u32 { return Invalid(Input); }
    let Count: u32 = Bytesˉreadˉu32ˉlittle(Input, Offset);
    if Count > 8u32 { return Invalid(Input); }

    let Limit: u32 = Offset + Length;
    var Cursor: u32 = Offset + 4u32;
    var Kinds: bytes = Empty(Input);
    var Lengths: bytes = Empty(Input);
    var Offsets: bytes = Empty(Input);
    var Sizes: bytes = Empty(Input);
    var Dataˉbytes: bytes = Empty(Input);
    var Index: u32 = 0u32;
    while Index < Count {
        if !Rangeˉisˉvalid(Limit, Cursor, 4u32) { return Invalid(Input); }
        let Nameˉlength: u32 = Bytesˉreadˉu32ˉlittle(Input, Cursor);
        Cursor = Cursor + 4u32;
        if !Identifierˉisˉvalid(Input, Cursor, Nameˉlength) {
            return Invalid(Input);
        }
        Cursor = Cursor + Nameˉlength;
        if !Rangeˉisˉvalid(Limit, Cursor, 5u32) { return Invalid(Input); }
        let Kind: u8 = Bytesˉreadˉu8(Input, Cursor);
        Cursor = Cursor + 1u32;
        let Itemˉlength: u32 = Bytesˉreadˉu32ˉlittle(Input, Cursor);
        Cursor = Cursor + 4u32;

        var Itemˉbytes: u32 = Itemˉlength;
        if Kind == 3u8 {
            if Itemˉlength > 1048576u32 { return Invalid(Input); }
        } else {
            if Kind == 4u8 {
                if Itemˉlength > 262144u32 { return Invalid(Input); }
                Itemˉbytes = Itemˉlength * 4u32;
            } else {
                if Kind != 5u8 { return Invalid(Input); }
                if Itemˉlength > 4194304u32 { return Invalid(Input); }
            }
        }
        if !Rangeˉisˉvalid(Limit, Cursor, Itemˉbytes) {
            return Invalid(Input);
        }
        let Item: bytes = Bytesˉslice(Input, Cursor, Itemˉbytes);
        if Kind == 3u8 {
            if !Textˉutf8ˉisˉvalid(Item) { return Invalid(Input); }
        }
        Kinds = Bytesˉconcat(Kinds, Bytesˉfromˉu8(Kind));
        Lengths = Bytesˉconcat(Lengths, Bytesˉfromˉu32ˉlittle(Itemˉlength));
        Offsets = Bytesˉconcat(
            Offsets,
            Bytesˉfromˉu32ˉlittle(Bytesˉlength(Dataˉbytes))
        );
        Sizes = Bytesˉconcat(Sizes, Bytesˉfromˉu32ˉlittle(Itemˉbytes));
        Dataˉbytes = Bytesˉconcat(Dataˉbytes, Item);
        Cursor = Cursor + Itemˉbytes;
        Index = Index + 1u32;
    }
    if Cursor != Limit { return Invalid(Input); }
    return Compilerˉnativeˉx64ˉdata(
        true,
        Count,
        Kinds,
        Lengths,
        Offsets,
        Sizes,
        Dataˉbytes
    );
}
