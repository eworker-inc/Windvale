#!wv/1 en@1
module Compilerˉsourceˉwvbˉfoundationˉborrows;
profile core;
platform linux, windows, windvale;
authority library;


export record Borrowˉplan {
    Valid: bool;
    Hasˉborrow: bool;
    Temporaryˉstate: bytes;
    Slotˉstate: bytes;
    Frozenˉslots: bytes;
}

export record Ownerˉplan {
    Valid: bool;
    Count: u32;
    Mapping: bytes;
    Temporaries: bytes;
}

export fn Zeroes(Count: u32) -> bytes {
    var Chunk: bytes = Bytesˉfromˉu8(0u8);
    var Result: bytes = Bytesˉslice(Chunk, 0u32, 0u32);
    if Count > 4096u32 { return Result; }
    var Remaining: u32 = Count;
    while Remaining > 0u32 {
        if Remaining % 2u32 != 0u32 {
            Result = Bytesˉconcat(Result, Chunk);
        }
        Remaining = Remaining / 2u32;
        if Remaining > 0u32 { Chunk = Bytesˉconcat(Chunk, Chunk); }
    }
    return Result;
}

export fn Setˉstate(State: bytes, Index: u32, Value: u8) -> bytes {
    if Index >= Bytesˉlength(State) { return State; }
    return Bytesˉconcat(
        Bytesˉconcat(Bytesˉslice(State, 0u32, Index), Bytesˉfromˉu8(Value)),
        Bytesˉslice(State, Index + 1u32, Bytesˉlength(State) - Index - 1u32)
    );
}

fn Invalid(Input: bytes) -> Borrowˉplan {
    let Empty: bytes = Bytesˉslice(Input, 0u32, 0u32);
    return Borrowˉplan(false, false, Empty, Empty, Empty);
}

// Ordinary expression results need a named owner before a loan can be stored.
// Existing loads, intrinsic views and borrowed projections already have roots.
export fn Buildˉowners(
    Wir: bytes,
    Operations: u32,
    Operands: u32,
    Firstˉoperation: u32,
    Operationˉcount: u32,
    Temporaryˉcount: u32,
    Plan: Borrowˉplan,
    Intrinsicˉloans: bytes,
    Readˉthroughˉvalues: bytes
) -> Ownerˉplan {
    let Empty: bytes = Bytesˉslice(Wir, 0u32, 0u32);
    let Failure: Ownerˉplan = Ownerˉplan(false, 0u32, Empty, Empty);
    if !Plan.Valid { return Failure; }
    if !Plan.Hasˉborrow { return Ownerˉplan(true, 0u32, Empty, Empty); }
    let Length: u32 = Bytesˉlength(Wir);
    if Operationˉcount > 4096u32 || Temporaryˉcount > 4096u32 ||
        Operations > Length || Operands > Length ||
        Bytesˉlength(Plan.Temporaryˉstate) != Temporaryˉcount ||
        Bytesˉlength(Intrinsicˉloans) != Temporaryˉcount ||
        Bytesˉlength(Readˉthroughˉvalues) != Temporaryˉcount {
        return Failure;
    }
    let Available: u32 = (Length - Operations) / 28u32;
    if Firstˉoperation > Available || Operationˉcount > Available - Firstˉoperation {
        return Failure;
    }
    var Owners: bytes = Zeroes(Temporaryˉcount);
    var Index: u32 = 0u32;
    while Index < Temporaryˉcount {
        if U32ˉfromˉu8(Bytesˉreadˉu8(Intrinsicˉloans, Index)) > 1u32 ||
            U32ˉfromˉu8(Bytesˉreadˉu8(Readˉthroughˉvalues, Index)) > 1u32 {
            return Failure;
        }
        Index = Index + 1u32;
    }
    Index = 0u32;
    while Index < Operationˉcount {
        let Entry: u32 = Operations + (Firstˉoperation + Index) * 28u32;
        let Kind: u32 = Bytesˉreadˉu16ˉlittle(Wir, Entry + 4u32);
        let Temporary: u32 = Bytesˉreadˉu32ˉlittle(Wir, Entry + 12u32);
        if Temporary != 4294967295u32 {
            if Temporary >= Temporaryˉcount { return Failure; }
            var Needsˉowner: bool = U32ˉfromˉu8(Bytesˉreadˉu8(Plan.Temporaryˉstate, Temporary)) >= 2u32 &&
                Bytesˉreadˉu8(Intrinsicˉloans, Temporary) == 0u8 &&
                Kind != 7u32 && Kind != 64u32 && Kind != 191u32 &&
                Kind != 192u32 && Kind != 205u32;
            if Needsˉowner && (Kind == 18u32 || Kind == 67u32 ||
                Kind == 164u32 || Kind == 166u32 || Kind == 168u32) {
                let First: u32 = Bytesˉreadˉu32ˉlittle(Wir, Entry + 16u32);
                if Bytesˉreadˉu16ˉlittle(Wir, Entry + 6u32) == 0u32 ||
                    First >= (Length - Operands) / 4u32 { return Failure; }
                let Source: u32 = Bytesˉreadˉu32ˉlittle(Wir, Operands + First * 4u32);
                if Source >= Temporaryˉcount { return Failure; }
                if Bytesˉreadˉu8(Plan.Temporaryˉstate, Source) != 0u8 {
                    Needsˉowner = false;
                }
            }
            if Needsˉowner {
                // A unique payload must retain its existing loan provenance;
                // this path can materialize only Copy or shared values.
                if Bytesˉreadˉu8(Readˉthroughˉvalues, Temporary) == 0u8 { return Failure; }
                Owners = Setˉstate(Owners, Temporary, 1u8);
            }
        }
        Index = Index + 1u32;
    }
    var Count: u32 = 0u32;
    var Mapping: bytes = Empty;
    var Mappingˉchunk: bytes = Empty;
    var Temporaries: bytes = Empty;
    var Temporaryˉchunk: bytes = Empty;
    Index = 0u32;
    while Index < Temporaryˉcount {
        var Slot: u32 = 0u32;
        if Bytesˉreadˉu8(Owners, Index) != 0u8 {
            Count = Count + 1u32;
            Slot = Count;
            Temporaryˉchunk = Bytesˉconcat(Temporaryˉchunk, Bytesˉfromˉu32ˉlittle(Index));
            if Bytesˉlength(Temporaryˉchunk) == 256u32 {
                Temporaries = Bytesˉconcat(Temporaries, Temporaryˉchunk);
                Temporaryˉchunk = Empty;
            }
        }
        Mappingˉchunk = Bytesˉconcat(Mappingˉchunk, Bytesˉfromˉu32ˉlittle(Slot));
        if Bytesˉlength(Mappingˉchunk) == 256u32 {
            Mapping = Bytesˉconcat(Mapping, Mappingˉchunk);
            Mappingˉchunk = Empty;
        }
        Index = Index + 1u32;
    }
    if Count == 0u32 { return Ownerˉplan(true, 0u32, Empty, Empty); }
    return Ownerˉplan(true, Count, Bytesˉconcat(Mapping, Mappingˉchunk),
        Bytesˉconcat(Temporaries, Temporaryˉchunk));
}

export fn Ownerˉslot(Plan: Ownerˉplan, Temporary: u32) -> u32 {
    if Temporary >= Bytesˉlength(Plan.Mapping) / 4u32 { return 0u32; }
    return Bytesˉreadˉu32ˉlittle(Plan.Mapping, Temporary * 4u32);
}

// The caller owns complete WVIR validation and declaration/call resolution.
// This pass only derives bounded local provenance from that immutable evidence.
export fn Build(
    Wir: bytes,
    Operations: u32,
    Operands: u32,
    Firstˉoperation: u32,
    Operationˉcount: u32,
    Temporaryˉcount: u32,
    Slotˉcount: u32,
    Parameterˉborrows: bytes,
    Callˉborrows: bytes,
    Projectionˉreads: bytes
) -> Borrowˉplan {
    let Length: u32 = Bytesˉlength(Wir);
    if Operationˉcount > 4096u32 || Temporaryˉcount > 4096u32 ||
        Slotˉcount > 4096u32 || Operations > Length || Operands > Length ||
        Bytesˉlength(Parameterˉborrows) > Slotˉcount ||
        Bytesˉlength(Callˉborrows) != Temporaryˉcount ||
        Bytesˉlength(Projectionˉreads) != Temporaryˉcount {
        return Invalid(Wir);
    }
    let Available: u32 = (Length - Operations) / 28u32;
    if Firstˉoperation > Available || Operationˉcount > Available - Firstˉoperation {
        return Invalid(Wir);
    }
    var Temporaryˉstate: bytes = Callˉborrows;
    var Slotˉstate: bytes = Bytesˉconcat(
        Parameterˉborrows, Zeroes(Slotˉcount - Bytesˉlength(Parameterˉborrows))
    );
    var Frozenˉslots: bytes = Zeroes(Slotˉcount);
    var Hasˉborrow: bool = false;
    var Index: u32 = 0u32;
    while Index < Temporaryˉcount {
        let State: u8 = Bytesˉreadˉu8(Temporaryˉstate, Index);
        if State != 0u8 && State != 2u8 { return Invalid(Wir); }
        let Read: u8 = Bytesˉreadˉu8(Projectionˉreads, Index);
        if Read != 0u8 && Read != 1u8 { return Invalid(Wir); }
        if State != 0u8 { Hasˉborrow = true; }
        Index = Index + 1u32;
    }
    Index = 0u32;
    while Index < Bytesˉlength(Parameterˉborrows) {
        let Parameterˉstate: u8 = Bytesˉreadˉu8(Parameterˉborrows, Index);
        if Parameterˉstate != 0u8 && Parameterˉstate != 1u8 { return Invalid(Wir); }
        if Parameterˉstate != 0u8 { Hasˉborrow = true; }
        Index = Index + 1u32;
    }
    Index = 0u32;
    while Index < Operationˉcount {
        let Freezeˉentry: u32 = Operations + (Firstˉoperation + Index) * 28u32;
        let Freezeˉkind: u32 = Bytesˉreadˉu16ˉlittle(Wir, Freezeˉentry + 4u32);
        if Freezeˉkind == 191u32 {
            let Owner: u32 = Bytesˉreadˉu32ˉlittle(Wir, Freezeˉentry + 20u32);
            if Owner >= Slotˉcount { return Invalid(Wir); }
            Frozenˉslots = Setˉstate(Frozenˉslots, Owner, 1u8);
            Hasˉborrow = true;
        }
        if Freezeˉkind == 192u32 || Freezeˉkind == 205u32 { Hasˉborrow = true; }
        Index = Index + 1u32;
    }
    if !Hasˉborrow {
        return Borrowˉplan(true, false, Temporaryˉstate, Slotˉstate, Frozenˉslots);
    }
    // A direct indexed Vector owner remains an ordinary Vector call source.
    // Only Foundation payload owners require wrapped load temporaries.
    let Payloadˉfrozenˉslots: bytes = Frozenˉslots;
    let Availableˉoperands: u32 = (Length - Operands) / 4u32;
    Index = 0u32;
    while Index < Operationˉcount {
        let Entry: u32 = Operations + (Firstˉoperation + Index) * 28u32;
        let Kind: u32 = Bytesˉreadˉu16ˉlittle(Wir, Entry + 4u32);
        let Resultˉtemporary: u32 = Bytesˉreadˉu32ˉlittle(Wir, Entry + 12u32);
        let Firstˉoperand: u32 = Bytesˉreadˉu32ˉlittle(Wir, Entry + 16u32);
        let Operandˉcount: u32 = Bytesˉreadˉu16ˉlittle(Wir, Entry + 6u32);
        let Target: u32 = Bytesˉreadˉu32ˉlittle(Wir, Entry + 20u32);
        if Kind == 191u32 {
            if Resultˉtemporary >= Temporaryˉcount || Operandˉcount != 0u32 {
                return Invalid(Wir);
            }
            Temporaryˉstate = Setˉstate(Temporaryˉstate, Resultˉtemporary, 1u8);
        } else if Kind == 205u32 {
            if Target >= Slotˉcount || Resultˉtemporary >= Temporaryˉcount || Operandˉcount != 3u32 ||
                Firstˉoperand > Availableˉoperands || Operandˉcount > Availableˉoperands - Firstˉoperand {
                return Invalid(Wir);
            }
            // Slice is inherently borrowed. Its owner remains an ordinary
            // bytes slot; complete WVIR validation proves this root and escape.
            Temporaryˉstate = Setˉstate(Temporaryˉstate, Resultˉtemporary, 2u8);
        } else if Kind == 192u32 {
            if Target >= Slotˉcount || Resultˉtemporary >= Temporaryˉcount || Operandˉcount != 1u32 ||
                Firstˉoperand >= Availableˉoperands ||
                Bytesˉreadˉu32ˉlittle(Wir, Operands + Firstˉoperand * 4u32) >= Temporaryˉcount {
                return Invalid(Wir);
            }
            // E3 produces a loan. Its existing result store may read through
            // Copy scalars immediately unless an immutable call needs the loan.
            if Bytesˉreadˉu8(Projectionˉreads, Resultˉtemporary) == 0u8 ||
                Bytesˉreadˉu8(Callˉborrows, Resultˉtemporary) == 2u8 {
                Temporaryˉstate = Setˉstate(Temporaryˉstate, Resultˉtemporary, 2u8);
            }
            // Earlier completed Vector calls keep their existing ownership.
            Frozenˉslots = Setˉstate(Frozenˉslots, Target, 1u8);
        } else if Kind == 7u32 {
            if Target >= Slotˉcount || Resultˉtemporary >= Temporaryˉcount {
                return Invalid(Wir);
            }
            if Bytesˉreadˉu8(Slotˉstate, Target) == 1u8 ||
                Bytesˉreadˉu8(Payloadˉfrozenˉslots, Target) == 1u8 {
                Temporaryˉstate = Setˉstate(Temporaryˉstate, Resultˉtemporary, 2u8);
            }
        } else if Kind == 8u32 || Kind == 18u32 || Kind == 67u32 ||
            Kind == 164u32 || Kind == 166u32 || Kind == 168u32 {
            if Operandˉcount == 0u32 || Firstˉoperand >= Availableˉoperands ||
                Operandˉcount > Availableˉoperands - Firstˉoperand {
                return Invalid(Wir);
            }
            let Source: u32 = Bytesˉreadˉu32ˉlittle(Wir, Operands + Firstˉoperand * 4u32);
            if Source >= Temporaryˉcount { return Invalid(Wir); }
            if Kind == 8u32 {
                if Target >= Slotˉcount { return Invalid(Wir); }
                if Bytesˉreadˉu8(Temporaryˉstate, Source) == 2u8 &&
                    Bytesˉreadˉu8(Projectionˉreads, Source) == 0u8 {
                    Slotˉstate = Setˉstate(Slotˉstate, Target, 1u8);
                    Temporaryˉstate = Setˉstate(Temporaryˉstate, Source, 3u8);
                }
            } else {
                if Resultˉtemporary >= Temporaryˉcount { return Invalid(Wir); }
                if Bytesˉreadˉu8(Temporaryˉstate, Source) != 0u8 &&
                    Bytesˉreadˉu8(Projectionˉreads, Resultˉtemporary) == 0u8 {
                    Temporaryˉstate = Setˉstate(Temporaryˉstate, Resultˉtemporary, 2u8);
                }
            }
        }
        Index = Index + 1u32;
    }
    return Borrowˉplan(true, true, Temporaryˉstate, Slotˉstate, Frozenˉslots);
}
