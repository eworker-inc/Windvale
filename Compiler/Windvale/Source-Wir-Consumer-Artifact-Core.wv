fn Compilerˉsourceˉbindingsˉclosuresˉshapeˉisˉvalid(
Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
Typeˉcatalog: Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog,
Kind: u32,
Shape: u32
) -> bool {
if Shape == 0u32 { return Kind != 1u32; }
if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉshapeˉisˉdeclaredˉvalue(
Shape, Symbols.Records, Symbols.Enums, Symbols.Variants, false
) { return true; }
if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉshapeˉisˉcapability(
Symbols.Directory, Shape
) { return true; }
if Shape >= 1073741824u32 && Shape < 1610612736u32 { return true; }
if Shape >= 2147483904u32 && Shape < 2147484160u32 { return true; }
if !Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉshapeˉisˉprivate(Shape) {
return false;
}
return Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉshapeˉinstance(Shape) <
Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalogˉinstances(
Typeˉcatalog
);
}
fn Compilerˉsourceˉbindingsˉclosuresˉrangesˉareˉvalid(
Input: bytes,
Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
Directory: bytes,
Entries: u32,
Ranges: u32,
Baseˉfunctions: u32,
Functionˉcatalog: Sourceˉgenerics.Compilerˉsourceˉgenericˉcatalog,
Closureˉcatalog: Closures.Compilerˉsourceˉclosureˉcatalog
) -> bool {
let Symbolsˉcount: u32 = Bytesˉreadˉu32ˉlittle(
Symbols.Directory, 8u32
);
var Expectedˉfirst: u32 = 0u32;
var Function: u32 = 0u32;
while Function < Ranges {
let Range: u32 =
Compilerˉsourceˉbindingsˉclosuresˉrangeˉoffset(
Directory, Function
);
let First: u32 = Bytesˉreadˉu32ˉlittle(Directory, Range);
let Count: u32 = Bytesˉreadˉu32ˉlittle(Directory, Range + 4u32);
let Declaration: u32 = Bytesˉreadˉu32ˉlittle(
Directory, Range + 8u32
);
let Genericˉinstance: u32 = Bytesˉreadˉu32ˉlittle(
Directory, Range + 12u32
);
let Closureˉinstance: u32 = Bytesˉreadˉu32ˉlittle(
Directory, Range + 16u32
);
let Captures: u32 = Bytesˉreadˉu32ˉlittle(
Directory, Range + 20u32
);
let Parameters: u32 = Bytesˉreadˉu32ˉlittle(
Directory, Range + 24u32
);
let Flags: u32 = Bytesˉreadˉu32ˉlittle(Directory, Range + 28u32);
if First != Expectedˉfirst || First > Entries ||
Count > Entries - First || Declaration >= Symbolsˉcount {
return false;
}
if Function < Baseˉfunctions {
var Baseˉgeneric: u32 =
Compilerˉsourceˉwirˉsentinel();
if Function >= Symbolsˉcount {
Baseˉgeneric = Function - Symbolsˉcount;
}
if Flags != 0u32 || Captures != 0u32 ||
Closureˉinstance !=
Compilerˉsourceˉwirˉsentinel() ||
Genericˉinstance != Baseˉgeneric ||
Declaration != Closureˉbindings.Compilerˉsourceˉbindingsˉclosuresˉdeclaration(
Symbols, Functionˉcatalog, Function
) ||
Parameters != Bytesˉreadˉu32ˉlittle(
Symbols.Directory,
16u32 + Declaration * 24u32 + 20u32
) {
return false;
}
} else {
let Expectedˉclosure: u32 = Function - Baseˉfunctions;
let Parent: u32 =
Closures.Compilerˉsourceˉclosureˉcatalogˉparentˉfunction(
Closureˉcatalog, Expectedˉclosure
);
let Module: u32 = Closures.Compilerˉsourceˉclosureˉcatalogˉmodule(
Closureˉcatalog, Expectedˉclosure
);
if Parent >= Baseˉfunctions || Module >= Scan.Modules ||
Parameters > 64u32 {
return false;
}
var Parentˉgeneric: u32 =
Compilerˉsourceˉwirˉsentinel();
if Parent >= Symbolsˉcount {
Parentˉgeneric = Parent - Symbolsˉcount;
}
let Offset: u32 = Closures.Compilerˉsourceˉclosureˉcatalogˉoffset(
Closureˉcatalog, Expectedˉclosure
);
let Span: u32 = Closures.Compilerˉsourceˉclosureˉcatalogˉlength(
Closureˉcatalog, Expectedˉclosure
);
if Flags != 1u32 || Closureˉinstance != Expectedˉclosure ||
Captures !=
Closures.Compilerˉsourceˉclosureˉcatalogˉcaptures(
Closureˉcatalog, Expectedˉclosure
) ||
Genericˉinstance != Parentˉgeneric ||
Declaration != Closureˉbindings.Compilerˉsourceˉbindingsˉclosuresˉdeclaration(
Symbols, Functionˉcatalog, Parent
) ||
Bytesˉreadˉu32ˉlittle(
Symbols.Directory, 16u32 + Declaration * 24u32
) != Module {
return false;
}
let View: Sourceˉset.Compilerˉsourceˉsetˉview =
Sourceˉset.Compilerˉsourceˉsetˉmodule(Input, Scan, Module);
if View.Status != Sourceˉset.Compilerˉsourceˉsetˉstatus.Valid ||
Offset >= Bytesˉlength(View.Source) ||
Span > Bytesˉlength(View.Source) - Offset {
return false;
}
}
let Symbolˉentry: u32 = 16u32 + Declaration * 24u32;
if Bytesˉreadˉu32ˉlittle(
Symbols.Directory, Symbolˉentry + 4u32
) != 6u32 && Count != 0u32 {
return false;
}
Expectedˉfirst = First + Count;
Function = Function + 1u32;
}
return Expectedˉfirst == Entries;
}
fn Compilerˉsourceˉbindingsˉclosuresˉentriesˉareˉvalid(
Input: bytes,
Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
Directory: bytes,
Entries: u32,
Ranges: u32,
Baseˉfunctions: u32,
Entriesˉoffset: u32,
Typeˉcatalog: Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog
) -> bool {
var Index: u32 = 0u32;
var Priorˉfunction: u32 = 0u32;
var Priorˉslot: u32 = 0u32;
while Index < Entries {
let Entry: u32 = Entriesˉoffset +
Index * CLOSURE_BINDING_ENTRY_BYTES;
let Module: u32 = Bytesˉreadˉu32ˉlittle(Directory, Entry);
let Function: u32 = Bytesˉreadˉu32ˉlittle(Directory, Entry + 4u32);
let Kind: u32 = Bytesˉreadˉu32ˉlittle(Directory, Entry + 8u32);
let Slot: u32 = Bytesˉreadˉu32ˉlittle(Directory, Entry + 12u32);
let Nameˉoffset: u32 = Bytesˉreadˉu32ˉlittle(
Directory, Entry + 16u32
);
let Nameˉlength: u32 = Bytesˉreadˉu32ˉlittle(
Directory, Entry + 20u32
);
let Shape: u32 = Bytesˉreadˉu32ˉlittle(Directory, Entry + 24u32);
let Scopeˉstart: u32 = Bytesˉreadˉu32ˉlittle(
Directory, Entry + 28u32
);
let Scopeˉend: u32 = Bytesˉreadˉu32ˉlittle(
Directory, Entry + 32u32
);
if Module >= Scan.Modules || Function >= Ranges ||
Kind == 0u32 || Kind > 7u32 || Slot >= 4096u32 ||
!Compilerˉsourceˉbindingsˉclosuresˉshapeˉisˉvalid(
Symbols, Typeˉcatalog, Kind, Shape
) {
return false;
}
let Range: u32 =
Compilerˉsourceˉbindingsˉclosuresˉrangeˉoffset(
Directory, Function
);
let First: u32 = Bytesˉreadˉu32ˉlittle(Directory, Range);
let Count: u32 = Bytesˉreadˉu32ˉlittle(Directory, Range + 4u32);
let Declaration: u32 = Bytesˉreadˉu32ˉlittle(
Directory, Range + 8u32
);
let Captures: u32 = Bytesˉreadˉu32ˉlittle(
Directory, Range + 20u32
);
let Parameters: u32 = Bytesˉreadˉu32ˉlittle(
Directory, Range + 24u32
);
let Flags: u32 = Bytesˉreadˉu32ˉlittle(Directory, Range + 28u32);
if Index < First || Index >= First + Count {
return false;
}
if Flags == 0u32 {
if (Slot < Parameters && Kind != 1u32) ||
(Slot >= Parameters && Kind == 1u32) {
return false;
}
} else {
if (Slot < Captures && (Kind < 2u32 || Kind > 3u32)) ||
(Slot >= Captures && Slot < Captures + Parameters &&
Kind != 1u32) ||
(Slot >= Captures + Parameters && Kind == 1u32) {
return false;
}
}
let Symbolˉentry: u32 = 16u32 + Declaration * 24u32;
if Bytesˉreadˉu32ˉlittle(Symbols.Directory, Symbolˉentry) != Module ||
Bytesˉreadˉu32ˉlittle(
Symbols.Directory, Symbolˉentry + 4u32
) != 6u32 {
return false;
}
let View: Sourceˉset.Compilerˉsourceˉsetˉview =
Sourceˉset.Compilerˉsourceˉsetˉmodule(Input, Scan, Module);
let Sourceˉlength: u32 = Bytesˉlength(View.Source);
if Nameˉoffset >= Sourceˉlength || Nameˉlength == 0u32 ||
Nameˉlength > Sourceˉlength - Nameˉoffset ||
Scopeˉstart >= Scopeˉend || Scopeˉend > Sourceˉlength ||
!Sourceˉbindings.Compilerˉsourceˉbindingsˉidentifierˉisˉvalid(
View.Source, Nameˉoffset, Nameˉlength
) {
return false;
}
if Index == 0u32 {
if Slot != 0u32 { return false; }
} else if Function == Priorˉfunction {
if Slot != Priorˉslot + 1u32 { return false; }
} else if Function < Priorˉfunction || Slot != 0u32 {
return false;
}
Priorˉfunction = Function;
Priorˉslot = Slot;
Index = Index + 1u32;
}
return true;
}
export fn Compilerˉsourceˉbindingsˉclosuresˉdirectoryˉisˉvalid(
Input: bytes,
Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
Directory: bytes
) -> bool {
if Scan.Status != Sourceˉset.Compilerˉsourceˉsetˉstatus.Valid ||
Symbols.Status != Sourceˉsymbols.Compilerˉsourceˉsymbolˉstatus.Valid ||
Bytesˉlength(Symbols.Directory) < 16u32 {
return false;
}
let Length: u32 = Bytesˉlength(Directory);
if Length < CLOSURE_BINDING_HEADER_BYTES ||
Length > CLOSURE_BINDING_DIRECTORY_LIMIT ||
Bytesˉreadˉu8(Directory, 0u32) != 87u8 ||
Bytesˉreadˉu8(Directory, 1u32) != 86u8 ||
Bytesˉreadˉu8(Directory, 2u32) != 76u8 ||
Bytesˉreadˉu8(Directory, 3u32) != 66u8 ||
Bytesˉreadˉu16ˉlittle(Directory, 4u32) != 1u32 ||
Bytesˉreadˉu16ˉlittle(Directory, 6u32) != 4u32 ||
Bytesˉreadˉu32ˉlittle(Directory, 12u32) !=
CLOSURE_BINDING_ENTRY_BYTES ||
Bytesˉreadˉu32ˉlittle(Directory, 20u32) !=
CLOSURE_BINDING_RANGE_BYTES ||
Bytesˉreadˉu32ˉlittle(Directory, 40u32) != 3u32 ||
Bytesˉreadˉu32ˉlittle(Directory, 44u32) != 0u32 {
return false;
}
let Entries: u32 = Bytesˉreadˉu32ˉlittle(Directory, 8u32);
let Ranges: u32 = Bytesˉreadˉu32ˉlittle(Directory, 16u32);
let Functionˉbytes: u32 = Bytesˉreadˉu32ˉlittle(Directory, 24u32);
let Typeˉbytes: u32 = Bytesˉreadˉu32ˉlittle(Directory, 28u32);
let Closureˉbytes: u32 = Bytesˉreadˉu32ˉlittle(Directory, 32u32);
let Baseˉfunctions: u32 = Bytesˉreadˉu32ˉlittle(Directory, 36u32);
let Symbolsˉcount: u32 = Bytesˉreadˉu32ˉlittle(
Symbols.Directory, 8u32
);
if !Sourceˉsymbols.Compilerˉsourceˉsymbolsˉdirectoryˉshapeˉisˉvalid(
Symbols.Directory, Symbolsˉcount
) ||
Entries > CLOSURE_BINDING_ENTRY_LIMIT ||
Functionˉbytes > CLOSURE_BINDING_CATALOG_LIMIT ||
Typeˉbytes > CLOSURE_BINDING_CATALOG_LIMIT ||
Closureˉbytes < 24u32 || Closureˉbytes > 8192u32 ||
Ranges > (Length - CLOSURE_BINDING_HEADER_BYTES) /
CLOSURE_BINDING_RANGE_BYTES {
return false;
}
let Catalogˉoffset: u32 = CLOSURE_BINDING_HEADER_BYTES +
Ranges * CLOSURE_BINDING_RANGE_BYTES;
if Functionˉbytes > Length - Catalogˉoffset { return false; }
let Typeˉoffset: u32 = Catalogˉoffset + Functionˉbytes;
if Typeˉbytes > Length - Typeˉoffset { return false; }
let Closureˉoffset: u32 = Typeˉoffset + Typeˉbytes;
if Closureˉbytes > Length - Closureˉoffset { return false; }
let Entriesˉoffset: u32 = Closureˉoffset + Closureˉbytes;
if Entries > (Length - Entriesˉoffset) / CLOSURE_BINDING_ENTRY_BYTES ||
Length != Entriesˉoffset + Entries * CLOSURE_BINDING_ENTRY_BYTES {
return false;
}
let Functionˉcatalog: Sourceˉgenerics.Compilerˉsourceˉgenericˉcatalog =
Compilerˉsourceˉbindingsˉclosuresˉfunctionˉcatalog(Directory);
let Functionˉinstances: u32 =
Sourceˉgenerics.Compilerˉsourceˉgenericˉcatalogˉinstances(
Functionˉcatalog
);
if !Sourceˉgenerics.Compilerˉsourceˉgenericˉcatalogˉisˉvalid(
Functionˉcatalog
) ||
(Functionˉbytes == 0u32) != (Functionˉinstances == 0u32) ||
Symbolsˉcount > 4294967295u32 - Functionˉinstances ||
Baseˉfunctions != Symbolsˉcount + Functionˉinstances {
return false;
}
let Typeˉcatalog: Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog =
Compilerˉsourceˉbindingsˉclosuresˉtypeˉcatalog(Directory);
let Typeˉinstances: u32 =
Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalogˉinstances(
Typeˉcatalog
);
if !Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalogˉisˉvalid(
Typeˉcatalog
) || (Typeˉbytes == 0u32) != (Typeˉinstances == 0u32) {
return false;
}
let Closureˉcatalog: Closures.Compilerˉsourceˉclosureˉcatalog =
Compilerˉsourceˉbindingsˉclosuresˉcatalog(Directory);
let Closureˉinstances: u32 =
Closures.Compilerˉsourceˉclosureˉcatalogˉinstances(Closureˉcatalog);
if !Closures.Compilerˉsourceˉclosureˉcatalogˉisˉvalid(Closureˉcatalog) ||
Closureˉinstances == 0u32 ||
Baseˉfunctions > 4294967295u32 - Closureˉinstances ||
Ranges != Baseˉfunctions + Closureˉinstances {
return false;
}
return Compilerˉsourceˉbindingsˉclosuresˉrangesˉareˉvalid(
Input, Scan, Symbols, Directory, Entries, Ranges,
Baseˉfunctions, Functionˉcatalog, Closureˉcatalog
) &&
Compilerˉsourceˉbindingsˉclosuresˉentriesˉareˉvalid(
Input, Scan, Symbols, Directory, Entries, Ranges,
Baseˉfunctions, Entriesˉoffset, Typeˉcatalog
);
}
export fn Compilerˉsourceˉbindingsˉgenericˉtypesˉheaderˉbytes(
Directory: bytes
) -> u32 {
let Length: u32 = Bytesˉlength(Directory);
if Length < 8u32 { return 0u32; }
let Minor: u32 = Bytesˉreadˉu16ˉlittle(Directory, 6u32);
if Minor == 1u32 && Length >= 24u32 { return 24u32; }
if Minor == 2u32 && Length >= 32u32 { return 32u32; }
if Minor == 3u32 && Length >= 40u32 { return 40u32; }
return 0u32;
}
