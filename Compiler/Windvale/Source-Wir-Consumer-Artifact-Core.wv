}
let Entries: u32 = Bytesˉreadˉu32ˉlittle(Directory, 8u32);
let Ranges: u32 = Bytesˉreadˉu32ˉlittle(Directory, 16u32);
let Functionˉbytes: u32 = Bytesˉreadˉu32ˉlittle(Directory, 24u32);
let Typeˉbytes: u32 = Bytesˉreadˉu32ˉlittle(Directory, 28u32);
let Symbolˉentries: u32 = Bytesˉreadˉu32ˉlittle(
Symbols.Directory, 8u32
);
if Entries > 116508u32 || Ranges < Symbolˉentries ||
