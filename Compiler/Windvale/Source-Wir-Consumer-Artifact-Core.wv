export fn Compilerˉsourceˉbindingsˉclosuresˉcatalog(
Directory: bytes
) -> Closures.Compilerˉsourceˉclosureˉcatalog {
let Empty: Closures.Compilerˉsourceˉclosureˉcatalog =
Closures.Compilerˉsourceˉclosureˉcatalogˉempty();
let Catalogˉoffset: u32 =
Compilerˉsourceˉbindingsˉclosuresˉcatalogˉoffset(Directory);
if Catalogˉoffset == Compilerˉsourceˉwirˉsentinel() {
return Closures.Compilerˉsourceˉclosureˉcatalog(
Closures.Compilerˉsourceˉclosureˉloweringˉstatus.Invalidˉevidence,
Empty.Evidence
);
}
let Functionˉbytes: u32 = Bytesˉreadˉu32ˉlittle(Directory, 24u32);
let Typeˉbytes: u32 = Bytesˉreadˉu32ˉlittle(Directory, 28u32);
let Closureˉbytes: u32 = Bytesˉreadˉu32ˉlittle(Directory, 32u32);
if Functionˉbytes > Bytesˉlength(Directory) - Catalogˉoffset {
return Closures.Compilerˉsourceˉclosureˉcatalog(
Closures.Compilerˉsourceˉclosureˉloweringˉstatus.Invalidˉevidence,
Empty.Evidence
);
}
let Typeˉoffset: u32 = Catalogˉoffset + Functionˉbytes;
if Typeˉbytes > Bytesˉlength(Directory) - Typeˉoffset {
return Closures.Compilerˉsourceˉclosureˉcatalog(
Closures.Compilerˉsourceˉclosureˉloweringˉstatus.Invalidˉevidence,
Empty.Evidence
);
}
let Offset: u32 = Typeˉoffset + Typeˉbytes;
if Closureˉbytes > Bytesˉlength(Directory) - Offset {
return Closures.Compilerˉsourceˉclosureˉcatalog(
Closures.Compilerˉsourceˉclosureˉloweringˉstatus.Invalidˉevidence,
Empty.Evidence
);
}
return Closures.Compilerˉsourceˉclosureˉcatalog(
Closures.Compilerˉsourceˉclosureˉloweringˉstatus.Valid,
