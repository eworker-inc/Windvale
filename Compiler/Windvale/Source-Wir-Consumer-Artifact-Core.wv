);
let First: u32 = Bytesˉreadˉu32ˉlittle(Directory, Range);
let Count: u32 = Bytesˉreadˉu32ˉlittle(Directory, Range + 4u32);
let Declaration: u32 =
Compilerˉsourceˉbindingsˉgenericˉtypesˉrangeˉdeclaration(
