return Compilerˉsourceˉwirˉsentinel();
}
let Ranges: u32 = Compilerˉsourceˉbindingsˉclosuresˉranges(Directory);
if Function >= Ranges ||
Ranges > (Length - CLOSURE_BINDING_HEADER_BYTES) /
CLOSURE_BINDING_RANGE_BYTES {
return Compilerˉsourceˉwirˉsentinel();
}
return CLOSURE_BINDING_HEADER_BYTES +
Function * CLOSURE_BINDING_RANGE_BYTES;
}
fn Compilerˉsourceˉbindingsˉclosuresˉcatalogˉoffset(
Directory: bytes
) -> u32 {
if Compilerˉsourceˉbindingsˉclosuresˉheaderˉbytes(Directory) == 0u32 {
return Compilerˉsourceˉwirˉsentinel();
}
let Ranges: u32 = Compilerˉsourceˉbindingsˉclosuresˉranges(Directory);
if Ranges > (Bytesˉlength(Directory) - CLOSURE_BINDING_HEADER_BYTES) /
CLOSURE_BINDING_RANGE_BYTES {
