export fn Compilerˉsourceˉbindingsˉclosuresˉtypeˉcatalog(
Directory: bytes
) -> Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog {
let Functionˉbytes: u32 = Bytesˉreadˉu32ˉlittle(Directory, 24u32);
let Typeˉbytes: u32 = Bytesˉreadˉu32ˉlittle(Directory, 28u32);
if Typeˉbytes == 0u32 {
