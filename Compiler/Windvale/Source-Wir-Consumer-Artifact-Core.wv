if Instances == 0u32 || Ranges != Symbolˉentries + Instances {
return false;
}
let Entriesˉoffset: u32 = Catalogˉoffset + Catalogˉbytes;
if Entries > (Length - Entriesˉoffset) / 36u32 ||
Length != Entriesˉoffset + Entries * 36u32 {
return false;
}
return Compilerˉsourceˉbindingsˉentriesˉareˉvalid(
Input, Scan, Symbols, Directory,
Entries, Ranges, Entriesˉoffset, Catalog, true
);
}
export fn Compilerˉsourceˉbindingsˉdirectoryˉisˉvalid(
Input: bytes,
Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
Directory: bytes
) -> bool {
let Length: u32 = Bytesˉlength(Directory);
if Length < 24u32 { return false; }
if Bytesˉreadˉu16ˉlittle(Directory, 6u32) == 2u32 {
return Compilerˉsourceˉbindingsˉspecializedˉdirectoryˉisˉvalid(
Input, Scan, Symbols, Directory
);
}
let Magic: bytes = Textˉtoˉutf8("WVLB");
if !Sourceˉset.Compilerˉsourceˉspansˉequal(Directory, 0u32, 4u32, Magic, 0u32, 4u32) {
return false;
}
if Bytesˉreadˉu16ˉlittle(Directory, 4u32) != 1u32 { return false; }
if Bytesˉreadˉu16ˉlittle(Directory, 6u32) != 1u32 { return false; }
if Bytesˉreadˉu32ˉlittle(Directory, 12u32) != 36u32 { return false; }
let Entries: u32 = Bytesˉreadˉu32ˉlittle(Directory, 8u32);
if Entries > 116508u32 { return false; }
let Symbolˉentries: u32 = Bytesˉreadˉu32ˉlittle(Symbols.Directory, 8u32);
let Ranges: u32 = Bytesˉreadˉu32ˉlittle(Directory, 16u32);
if Ranges != Symbolˉentries { return false; }
if Bytesˉreadˉu32ˉlittle(Directory, 20u32) != 8u32 { return false; }
if Length != 24u32 + Ranges * 8u32 + Entries * 36u32 { return false; }
let Entriesˉoffset: u32 = 24u32 + Ranges * 8u32;
return Compilerˉsourceˉbindingsˉentriesˉareˉvalid(
Input, Scan, Symbols, Directory,
Entries, Ranges, Entriesˉoffset,
Sourceˉgenerics.Compilerˉsourceˉgenericˉcatalogˉempty(), false
);
