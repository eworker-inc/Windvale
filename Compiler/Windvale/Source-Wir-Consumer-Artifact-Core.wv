Typeˉbytes < 24u32 || Typeˉbytes > 1048576u32 ||
Ranges > (Length - 40u32) / 16u32 {
return false;
}
let Functionˉoffset: u32 = 40u32 + Ranges * 16u32;
if Functionˉbytes > Length - Functionˉoffset { return false; }
let Typeˉoffset: u32 = Functionˉoffset + Functionˉbytes;
if Typeˉbytes > Length - Typeˉoffset { return false; }
let Entriesˉoffset: u32 = Typeˉoffset + Typeˉbytes;
if Entries > (Length - Entriesˉoffset) / 36u32 ||
Length != Entriesˉoffset + Entries * 36u32 {
return false;
}
let Functionˉcatalog:
Sourceˉgenerics.Compilerˉsourceˉgenericˉcatalog =
Compilerˉsourceˉbindingsˉgenericˉtypesˉfunctionˉcatalog(Directory);
if !Sourceˉgenerics.Compilerˉsourceˉgenericˉcatalogˉisˉvalid(
Functionˉcatalog
) {
return false;
}
let Functionˉinstances: u32 =
Sourceˉgenerics.Compilerˉsourceˉgenericˉcatalogˉinstances(
Functionˉcatalog
);
if (Functionˉbytes == 0u32) != (Functionˉinstances == 0u32) ||
