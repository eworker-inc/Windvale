export fn Compilerˉsourceˉbindingsˉclosuresˉheaderˉbytes(
Directory: bytes
) -> u32 {
if Bytesˉlength(Directory) >= CLOSURE_BINDING_HEADER_BYTES &&
Bytesˉreadˉu16ˉlittle(Directory, 4u32) == 1u32 &&
Bytesˉreadˉu16ˉlittle(Directory, 6u32) == 4u32 {
