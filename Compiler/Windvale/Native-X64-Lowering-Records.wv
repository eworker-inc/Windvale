module Compilerˉnativeˉx64ˉloweringˉrecords profile portable;

import Compilerˉnativeˉx64ˉloweringˉtypes as Nominalˉtypes;
import Compilerˉnativeˉx64ˉloweringˉcallˉarguments as Callˉarguments;

fn Appendˉbyte(Result: bytes, Value: u8) -> bytes {
    return Bytesˉconcat(Result, Bytesˉfromˉu8(Value));
}

fn Appendˉu32(Result: bytes, Value: u32) -> bytes {
    return Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Value));
}

fn Relativeˉu32(Target: u32, Origin: u32) -> u32 {
    if Target >= Origin { return Target - Origin; }
    let Magnitude: u32 = Origin - Target;
    return 4294967295u32 - Magnitude + 1u32;
}

fn Loadˉrax(Result: bytes, Slot: u32) -> bytes {
    var Output: bytes = Appendˉbyte(Result, 72u8);
    Output = Appendˉbyte(Output, 139u8);
    Output = Appendˉbyte(Output, 132u8);
    Output = Appendˉbyte(Output, 36u8);
    return Appendˉu32(Output, Slot * 16u32);
}

fn Loadˉrdx(Result: bytes, Slot: u32) -> bytes {
    var Output: bytes = Appendˉbyte(Result, 72u8);
    Output = Appendˉbyte(Output, 139u8);
    Output = Appendˉbyte(Output, 148u8);
    Output = Appendˉbyte(Output, 36u8);
    return Appendˉu32(Output, Slot * 16u32);
}

fn Storeˉrax(Result: bytes, Slot: u32) -> bytes {
    var Output: bytes = Appendˉbyte(Result, 72u8);
    Output = Appendˉbyte(Output, 137u8);
    Output = Appendˉbyte(Output, 132u8);
    Output = Appendˉbyte(Output, 36u8);
    return Appendˉu32(Output, Slot * 16u32);
}

fn Loadˉraxˉfield(Result: bytes, Slot: u32) -> bytes {
    var Output: bytes = Appendˉbyte(Result, 72u8);
    Output = Appendˉbyte(Output, 139u8);
    Output = Appendˉbyte(Output, 132u8);
    Output = Appendˉbyte(Output, 36u8);
    return Appendˉu32(Output, Slot * 16u32 + 8u32);
}

fn Storeˉraxˉfield(Result: bytes, Slot: u32) -> bytes {
    var Output: bytes = Appendˉbyte(Result, 72u8);
    Output = Appendˉbyte(Output, 137u8);
    Output = Appendˉbyte(Output, 132u8);
    Output = Appendˉbyte(Output, 36u8);
    return Appendˉu32(Output, Slot * 16u32 + 8u32);
}

fn Loadˉrecordˉfield(
    Result: bytes,
    Field: u32,
    Second: bool
) -> bytes {
    var Output: bytes = Appendˉbyte(Result, 72u8);
    Output = Appendˉbyte(Output, 139u8);
    Output = Appendˉbyte(Output, 130u8);
    var Offset: u32 = Field * 16u32;
    if Second { Offset = Offset + 8u32; }
    return Appendˉu32(Output, Offset);
}

fn Frameˉaddress(Result: bytes, Cell: u32, Stackˉbytes: u32) -> bytes {
    var Output: bytes = Appendˉbyte(Result, 72u8);
    Output = Appendˉbyte(Output, 141u8);
    Output = Appendˉbyte(Output, 132u8);
    Output = Appendˉbyte(Output, 36u8);
    return Appendˉu32(Output, Cell * 16u32 + Stackˉbytes);
}

fn Typeˉtag(Result: bytes, Typeˉindex: u32) -> bytes {
    var Output: bytes = Appendˉbyte(Result, 65u8);
    Output = Appendˉbyte(Output, 184u8);
    return Appendˉu32(Output, Typeˉindex);
}

fn Addˉraxˉoffset(Result: bytes, Offset: u32) -> bytes {
    var Output: bytes = Appendˉbyte(Result, 72u8);
    Output = Appendˉbyte(Output, 5u8);
    return Appendˉu32(Output, Offset);
}

fn Padˉto(Result: bytes, Length: u32) -> bytes {
    var Output: bytes = Result;
    while Bytesˉlength(Output) < Length {
        Output = Appendˉbyte(Output, 144u8);
    }
    return Output;
}

export fn Compilerˉnativeˉx64ˉrecordˉcreateˉbytes(
    Input: bytes,
    Types: Nominalˉtypes.Compilerˉnativeˉx64ˉtypes,
    Typeˉindex: u32
) -> u32 {
    let Fields: u32 = Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉitemˉcount(
        Types,
        Typeˉindex
    );
    var Result: u32 = 32u32;
    var Field: u32 = 0u32;
    while Field < Fields {
        let Type: u8 = Nominalˉtypes.Compilerˉnativeˉx64ˉrecordˉfieldˉtype(
            Input,
            Types,
            Typeˉindex,
            Field
        );
        if Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉisˉrecord(Type) {
            Result = Result + 8u32 + 30u32 *
                Nominalˉtypes.Compilerˉnativeˉx64ˉrecordˉwidth(
                    Input,
                    Types,
                    Nominalˉtypes.Compilerˉnativeˉx64ˉrecordˉtypeˉindex(Type)
                );
        } else {
            Result = Result + 32u32;
        }
        Field = Field + 1u32;
    }
    return Result;
}

export fn Compilerˉnativeˉx64ˉrecordˉcopyˉbytes(Fields: u32) -> u32 {
    return 40u32 + Fields * 30u32;
}

export fn Compilerˉnativeˉx64ˉrecordˉfieldˉbytes() -> u32 {
    return 54u32;
}

export fn Compilerˉnativeˉx64ˉrecordˉcallˉbytes(
    Parameterˉtypes: bytes
) -> u32 {
    return 61u32 +
        Callˉarguments.Compilerˉnativeˉx64ˉcallˉargumentˉbytes(
            Parameterˉtypes
        );
}

export fn Compilerˉnativeˉx64ˉargumentˉbytes(
    Parameterˉtypes: bytes
) -> u32 {
    return Callˉarguments.Compilerˉnativeˉx64ˉcallˉargumentˉbytes(
        Parameterˉtypes
    );
}

export fn Compilerˉnativeˉx64ˉrecordˉreturnˉbytes(
    Fields: u32,
    Hasˉdescriptors: bool
) -> u32 {
    var Result: u32 = 45u32 + Fields * 28u32;
    if !Hasˉdescriptors { Result = Result + 11u32; }
    return Result;
}

export fn Compilerˉnativeˉx64ˉemitˉhiddenˉrecordˉresult(
    Result: bytes,
    Slot: u32
) -> bytes {
    return Storeˉrax(Result, Slot);
}

export fn Compilerˉnativeˉx64ˉemitˉrecordˉcheckpoint(
    Result: bytes,
    Hiddenˉslot: u32
) -> bytes {
    var Output: bytes = Appendˉbyte(Result, 65u8);
    Output = Appendˉbyte(Output, 139u8);
    Output = Appendˉbyte(Output, 71u8);
    Output = Appendˉbyte(Output, 60u8);
    Output = Appendˉbyte(Output, 137u8);
    Output = Appendˉbyte(Output, 132u8);
    Output = Appendˉbyte(Output, 36u8);
    return Appendˉu32(Output, Hiddenˉslot * 16u32 + 8u32);
}

export fn Compilerˉnativeˉx64ˉemitˉrecordˉcall(
    Result: bytes,
    Typeˉindex: u32,
    Argumentˉslots: bytes,
    Argumentˉtypes: bytes,
    Backingˉcell: u32,
    Targetˉslot: u32,
    Targetˉmachine: u32,
    Codeˉbase: u32,
    Propagateˉoffset: u32
) -> bytes {
    var Output: bytes = Typeˉtag(Result, Typeˉindex);
    let Parameters: u32 = Bytesˉlength(Argumentˉslots) / 4u32;
    Output = Callˉarguments.Compilerˉnativeˉx64ˉemitˉcallˉarguments(
        Output,
        Argumentˉslots,
        Argumentˉtypes
    );
    let Stackˉbytes: u32 =
        Callˉarguments.Compilerˉnativeˉx64ˉcallˉstackˉbytes(Parameters);
    Output = Frameˉaddress(Output, Backingˉcell, Stackˉbytes);
    Output = Appendˉbyte(Output, 232u8);
    Output = Appendˉu32(
        Output,
        Relativeˉu32(
            Targetˉmachine,
            Codeˉbase + Bytesˉlength(Output) + 4u32
        )
    );
    Output = Callˉarguments.Compilerˉnativeˉx64ˉemitˉcallˉstackˉrelease(
        Output,
        Parameters
    );
    Output = Appendˉbyte(Output, 72u8);
    Output = Appendˉbyte(Output, 137u8);
    Output = Appendˉbyte(Output, 194u8);
    Output = Appendˉbyte(Output, 72u8);
    Output = Appendˉbyte(Output, 193u8);
    Output = Appendˉbyte(Output, 234u8);
    Output = Appendˉbyte(Output, 32u8);
    Output = Appendˉbyte(Output, 72u8);
    Output = Appendˉbyte(Output, 133u8);
    Output = Appendˉbyte(Output, 210u8);
    Output = Appendˉbyte(Output, 15u8);
    Output = Appendˉbyte(Output, 133u8);
    Output = Appendˉu32(
        Output,
        Relativeˉu32(Propagateˉoffset, Bytesˉlength(Output) + 4u32)
    );
    Output = Frameˉaddress(Output, Backingˉcell, 0u32);
    return Storeˉrax(Output, Targetˉslot);
}

export fn Compilerˉnativeˉx64ˉemitˉrecordˉreturn(
    Result: bytes,
    Typeˉindex: u32,
    Fields: u32,
    Hasˉdescriptors: bool,
    Sourceˉslot: u32,
    Hiddenˉslot: u32,
    Frameˉbytes: u32
) -> bytes {
    var Output: bytes = Typeˉtag(Result, Typeˉindex);
    Output = Loadˉrdx(Output, Hiddenˉslot);
    Output = Loadˉrax(Output, Sourceˉslot);
    var Field: u32 = 0u32;
    while Field < Fields {
        var Offset: u32 = Field * 16u32;
        Output = Appendˉbyte(Output, 72u8);
        Output = Appendˉbyte(Output, 139u8);
        Output = Appendˉbyte(Output, 136u8);
        Output = Appendˉu32(Output, Offset);
        Output = Appendˉbyte(Output, 72u8);
        Output = Appendˉbyte(Output, 137u8);
        Output = Appendˉbyte(Output, 138u8);
        Output = Appendˉu32(Output, Offset);
        Offset = Offset + 8u32;
        Output = Appendˉbyte(Output, 72u8);
        Output = Appendˉbyte(Output, 139u8);
        Output = Appendˉbyte(Output, 136u8);
        Output = Appendˉu32(Output, Offset);
        Output = Appendˉbyte(Output, 72u8);
        Output = Appendˉbyte(Output, 137u8);
        Output = Appendˉbyte(Output, 138u8);
        Output = Appendˉu32(Output, Offset);
        Field = Field + 1u32;
    }
    if !Hasˉdescriptors {
        Output = Appendˉbyte(Output, 139u8);
        Output = Appendˉbyte(Output, 132u8);
        Output = Appendˉbyte(Output, 36u8);
        Output = Appendˉu32(Output, Hiddenˉslot * 16u32 + 8u32);
        Output = Appendˉbyte(Output, 65u8);
        Output = Appendˉbyte(Output, 137u8);
        Output = Appendˉbyte(Output, 71u8);
        Output = Appendˉbyte(Output, 60u8);
    }
    Output = Appendˉbyte(Output, 49u8);
    Output = Appendˉbyte(Output, 192u8);
    Output = Appendˉbyte(Output, 72u8);
    Output = Appendˉbyte(Output, 129u8);
    Output = Appendˉbyte(Output, 196u8);
    Output = Appendˉu32(Output, Frameˉbytes);
    Output = Appendˉbyte(Output, 73u8);
    Output = Appendˉbyte(Output, 255u8);
    Output = Appendˉbyte(Output, 194u8);
    return Appendˉbyte(Output, 195u8);
}

export fn Compilerˉnativeˉx64ˉemitˉrecordˉcreate(
    Result: bytes,
    Input: bytes,
    Types: Nominalˉtypes.Compilerˉnativeˉx64ˉtypes,
    Typeˉindex: u32,
    Fieldˉslots: bytes,
    Targetˉslot: u32,
    Backingˉcell: u32
) -> bytes {
    var Output: bytes = Typeˉtag(Result, Typeˉindex);
    let Fields: u32 = Bytesˉlength(Fieldˉslots) / 4u32;
    var Field: u32 = 0u32;
    while Field < Fields {
        let Source: u32 = Bytesˉreadˉu32ˉlittle(
            Fieldˉslots,
            Field * 4u32
        );
        let Type: u8 = Nominalˉtypes.Compilerˉnativeˉx64ˉrecordˉfieldˉtype(
            Input,
            Types,
            Typeˉindex,
            Field
        );
        if Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉisˉrecord(Type) {
            Output = Loadˉrdx(Output, Source);
            let Childˉwidth: u32 =
                Nominalˉtypes.Compilerˉnativeˉx64ˉrecordˉwidth(
                    Input,
                    Types,
                    Nominalˉtypes.Compilerˉnativeˉx64ˉrecordˉtypeˉindex(Type)
                );
            let Childˉbacking: u32 = Backingˉcell +
                Nominalˉtypes.Compilerˉnativeˉx64ˉrecordˉfieldˉbackingˉoffset(
                    Input,
                    Types,
                    Typeˉindex,
                    Field
                );
            var Childˉfield: u32 = 0u32;
            while Childˉfield < Childˉwidth {
                Output = Loadˉrecordˉfield(Output, Childˉfield, false);
                Output = Storeˉrax(Output, Childˉbacking + Childˉfield);
                Output = Loadˉrecordˉfield(Output, Childˉfield, true);
                Output = Storeˉraxˉfield(Output, Childˉbacking + Childˉfield);
                Childˉfield = Childˉfield + 1u32;
            }
        } else {
            Output = Loadˉrax(Output, Source);
            Output = Storeˉrax(Output, Backingˉcell + Field);
            Output = Loadˉraxˉfield(Output, Source);
            Output = Storeˉraxˉfield(Output, Backingˉcell + Field);
        }
        Field = Field + 1u32;
    }
    Output = Frameˉaddress(Output, Backingˉcell, 0u32);
    return Storeˉrax(Output, Targetˉslot);
}

export fn Compilerˉnativeˉx64ˉemitˉrecordˉcopy(
    Result: bytes,
    Typeˉindex: u32,
    Fields: u32,
    Sourceˉhandle: u32,
    Targetˉhandle: u32,
    Backingˉcell: u32
) -> bytes {
    var Output: bytes = Typeˉtag(Result, Typeˉindex);
    Output = Loadˉrdx(Output, Sourceˉhandle);
    var Field: u32 = 0u32;
    while Field < Fields {
        Output = Loadˉrecordˉfield(Output, Field, false);
        Output = Storeˉrax(Output, Backingˉcell + Field);
        Output = Loadˉrecordˉfield(Output, Field, true);
        Output = Storeˉraxˉfield(Output, Backingˉcell + Field);
        Field = Field + 1u32;
    }
    Output = Frameˉaddress(Output, Backingˉcell, 0u32);
    return Storeˉrax(Output, Targetˉhandle);
}

export fn Compilerˉnativeˉx64ˉemitˉrecordˉfield(
    Result: bytes,
    Typeˉindex: u32,
    Field: u32,
    Sourceˉhandle: u32,
    Targetˉslot: u32
) -> bytes {
    var Output: bytes = Typeˉtag(Result, Typeˉindex);
    Output = Loadˉrdx(Output, Sourceˉhandle);
    Output = Loadˉrecordˉfield(Output, Field, false);
    Output = Storeˉrax(Output, Targetˉslot);
    Output = Loadˉrecordˉfield(Output, Field, true);
    return Storeˉraxˉfield(Output, Targetˉslot);
}

export fn Compilerˉnativeˉx64ˉemitˉrecordˉfieldˉview(
    Result: bytes,
    Typeˉindex: u32,
    Backingˉoffset: u32,
    Sourceˉhandle: u32,
    Targetˉslot: u32
) -> bytes {
    let Start: u32 = Bytesˉlength(Result);
    var Output: bytes = Typeˉtag(Result, Typeˉindex);
    Output = Loadˉrax(Output, Sourceˉhandle);
    Output = Addˉraxˉoffset(Output, Backingˉoffset * 16u32);
    Output = Storeˉrax(Output, Targetˉslot);
    // The common instruction-limit step contributes the remaining ten bytes.
    return Padˉto(Output, Start + 44u32);
}
