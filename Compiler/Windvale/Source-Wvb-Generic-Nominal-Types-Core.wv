module Compilerˉsourceˉwvbˉgenericˉnominalˉtypes profile portable;

import Compilerˉsourceˉgenericˉtypeˉlayout as Genericˉlayouts;
import Compilerˉsourceˉgenericˉlowering as Sourceˉgenerics;
import Compilerˉsourceˉgenericˉtypeˉlowering as Genericˉtypes;
import Compilerˉsourceˉgenericˉtypeˉmaterialization as Materialization;
import Compilerˉsourceˉset as Sourceˉset;
import Compilerˉsourceˉsymbols as Sourceˉsymbols;

export enum Compilerˉsourceˉwvbˉgenericˉnominalˉstatus {
    Valid = 0;
    Invalidˉmaterialization = 1;
    Invalidˉtypeˉbase = 2;
    Unsupportedˉshape = 3;
    Typeˉlimit = 4;
    Evidenceˉlimit = 5;
}

export record Compilerˉsourceˉwvbˉgenericˉnominalˉencoding {
    Status: Compilerˉsourceˉwvbˉgenericˉnominalˉstatus;
    Entries: u32;
    Payload: bytes;
    Features: u32;
    Failureˉinstance: u32;
}

record Compilerˉsourceˉwvbˉgenericˉnominalˉpart {
    Status: Compilerˉsourceˉwvbˉgenericˉnominalˉstatus;
    Payload: bytes;
    Features: u32;
}

fn Compilerˉsourceˉwvbˉgenericˉnominalˉsentinel() -> u32 {
    return 4294967295u32;
}

fn Compilerˉsourceˉwvbˉgenericˉnominalˉempty(Input: bytes) -> bytes {
    return Bytesˉslice(Input, 0u32, 0u32);
}

fn Compilerˉsourceˉwvbˉgenericˉnominalˉfailure(
    Input: bytes,
    Status: Compilerˉsourceˉwvbˉgenericˉnominalˉstatus,
    Instance: u32
) -> Compilerˉsourceˉwvbˉgenericˉnominalˉencoding {
    return Compilerˉsourceˉwvbˉgenericˉnominalˉencoding(
        Status, 0u32,
        Compilerˉsourceˉwvbˉgenericˉnominalˉempty(Input),
        0u32, Instance
    );
}

fn Compilerˉsourceˉwvbˉgenericˉnominalˉpartˉempty(
    Input: bytes
) -> Compilerˉsourceˉwvbˉgenericˉnominalˉpart {
    return Compilerˉsourceˉwvbˉgenericˉnominalˉpart(
        Compilerˉsourceˉwvbˉgenericˉnominalˉstatus.Valid,
        Compilerˉsourceˉwvbˉgenericˉnominalˉempty(Input),
        0u32
    );
}

fn Compilerˉsourceˉwvbˉgenericˉnominalˉpartˉfailure(
    Input: bytes,
    Status: Compilerˉsourceˉwvbˉgenericˉnominalˉstatus
) -> Compilerˉsourceˉwvbˉgenericˉnominalˉpart {
    return Compilerˉsourceˉwvbˉgenericˉnominalˉpart(
        Status,
        Compilerˉsourceˉwvbˉgenericˉnominalˉempty(Input),
        0u32
    );
}

fn Compilerˉsourceˉwvbˉgenericˉnominalˉpartˉappend(
    Part: Compilerˉsourceˉwvbˉgenericˉnominalˉpart,
    Value: bytes
) -> Compilerˉsourceˉwvbˉgenericˉnominalˉpart {
    if Part.Status !=
            Compilerˉsourceˉwvbˉgenericˉnominalˉstatus.Valid {
        return Part;
    }
    let Current: u32 = Bytesˉlength(Part.Payload);
    let Added: u32 = Bytesˉlength(Value);
    if Added > 4194304u32 || Current > 4194304u32 - Added {
        return Compilerˉsourceˉwvbˉgenericˉnominalˉpart(
            Compilerˉsourceˉwvbˉgenericˉnominalˉstatus.Evidenceˉlimit,
            Part.Payload, Part.Features
        );
    }
    return Compilerˉsourceˉwvbˉgenericˉnominalˉpart(
        Part.Status, Bytesˉconcat(Part.Payload, Value), Part.Features
    );
}

fn Compilerˉsourceˉwvbˉgenericˉnominalˉpartˉfeatures(
    Part: Compilerˉsourceˉwvbˉgenericˉnominalˉpart,
    Features: u32
) -> Compilerˉsourceˉwvbˉgenericˉnominalˉpart {
    return Compilerˉsourceˉwvbˉgenericˉnominalˉpart(
        Part.Status, Part.Payload, Part.Features | Features
    );
}

fn Compilerˉsourceˉwvbˉgenericˉnominalˉstring(
    Source: bytes,
    Offset: u32,
    Length: u32
) -> bytes {
    return Bytesˉconcat(
        Bytesˉfromˉu32ˉlittle(Length),
        Bytesˉslice(Source, Offset, Length)
    );
}

fn Compilerˉsourceˉwvbˉgenericˉnominalˉname(
    Instance: u32
) -> bytes {
    let Digits: bytes = Textˉtoˉutf8(U32ˉformat(10000u32 + Instance));
    return Bytesˉconcat(
        Textˉtoˉutf8("__WvY"),
        Bytesˉslice(Digits, 1u32, 4u32)
    );
}

fn Compilerˉsourceˉwvbˉgenericˉnominalˉencodedˉname(
    Instance: u32
) -> bytes {
    let Name: bytes =
        Compilerˉsourceˉwvbˉgenericˉnominalˉname(Instance);
    return Bytesˉconcat(
        Bytesˉfromˉu32ˉlittle(Bytesˉlength(Name)), Name
    );
}

fn Compilerˉsourceˉwvbˉgenericˉnominalˉscalarˉfeatures(
    Shape: u32
) -> u32 {
    if Shape >= 11u32 && Shape <= 13u32 { return 2u32; }
    if Shape == 16u32 { return 4u32; }
    if Shape == 14u32 || Shape == 15u32 { return 8u32; }
    if Shape == 9u32 || Shape == 10u32 { return 16u32; }
    if Shape == 805306368u32 { return 4096u32; }
    return 0u32;
}

fn Compilerˉsourceˉwvbˉgenericˉnominalˉshape(
    Input: bytes,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Plan: Materialization.Compilerˉsourceˉgenericˉtypeˉmaterialization,
    Recordˉtargets: bytes,
    Variantˉtargets: bytes,
    Concreteˉrecords: u32,
    Shape: u32
) -> Compilerˉsourceˉwvbˉgenericˉnominalˉpart {
    if Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉshapeˉisˉprivate(Shape) {
        let Privateˉinstance: u32 =
            Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉshapeˉinstance(Shape);
        let Privateˉoutput: u32 =
            Materialization.Compilerˉsourceˉgenericˉtypeˉmaterializationˉtypeˉword(
                Plan, Privateˉinstance, 1u32
            );
        let Privateˉkind: u32 =
            Materialization.Compilerˉsourceˉgenericˉtypeˉmaterializationˉtypeˉword(
                Plan, Privateˉinstance, 2u32
            );
        var Privateˉshapeˉkind: u8 = 0u8;
        if Privateˉkind == 4u32 { Privateˉshapeˉkind = 7u8; }
        if Privateˉkind == 8u32 { Privateˉshapeˉkind = 11u8; }
        if Privateˉkind == 10u32 { Privateˉshapeˉkind = 22u8; }
        if Privateˉkind == 11u32 { Privateˉshapeˉkind = 23u8; }
        if Privateˉkind == 12u32 { Privateˉshapeˉkind = 24u8; }
        if Privateˉshapeˉkind == 0u8 || Privateˉoutput == 4294967295u32 {
            return Compilerˉsourceˉwvbˉgenericˉnominalˉpartˉfailure(
                Input, Compilerˉsourceˉwvbˉgenericˉnominalˉstatus.Unsupportedˉshape
            );
        }
        var Privateˉfeatures: u32 = 0u32;
        if Privateˉkind == 10u32 { Privateˉfeatures = 64u32; }
        if Privateˉkind == 11u32 || Privateˉkind == 12u32 {
            Privateˉfeatures = 128u32;
        }
        return Compilerˉsourceˉwvbˉgenericˉnominalˉpart(
            Compilerˉsourceˉwvbˉgenericˉnominalˉstatus.Valid,
            Bytesˉconcat(
                Bytesˉfromˉu8(Privateˉshapeˉkind),
                Bytesˉfromˉu32ˉlittle(Privateˉoutput)
            ), Privateˉfeatures
        );
    }
    if Shape >= 1073741824u32 && Shape < 1610612736u32 {
        let Packed: bytes = Bytesˉfromˉu32ˉlittle(Shape);
        let Compact: u32 = Bytesˉreadˉu16ˉlittle(Packed, 0u32);
        let Upper: u32 = Bytesˉreadˉu16ˉlittle(Packed, 2u32);
        var Element: u32 = Compact;
        if Compact >= 4096u32 && Compact < 8192u32 {
            Element = 65536u32 + Compact - 4096u32;
        }
        if Compact >= 8192u32 && Compact < 12288u32 {
            Element = 131072u32 + Compact - 8192u32;
        }
        if Compact >= 12288u32 {
            Element = 196608u32 + Compact - 12288u32;
        }
        var Maximum: u32 = 0u32;
        var Collectionˉkind: u8 = 12u8;
        if Shape < 1342177280u32 {
            if Upper < 16384u32 { return Compilerˉsourceˉwvbˉgenericˉnominalˉpartˉfailure(
                    Input, Compilerˉsourceˉwvbˉgenericˉnominalˉstatus.Unsupportedˉshape
                ); }
            Maximum = Upper - 16384u32;
        } else {
            Collectionˉkind = 13u8;
            if Upper < 20480u32 { return Compilerˉsourceˉwvbˉgenericˉnominalˉpartˉfailure(
                    Input, Compilerˉsourceˉwvbˉgenericˉnominalˉstatus.Unsupportedˉshape
                ); }
            Maximum = Upper - 20480u32;
        }
        if Maximum == 0u32 || Maximum > 4095u32 {
            return Compilerˉsourceˉwvbˉgenericˉnominalˉpartˉfailure(
                Input,
                Compilerˉsourceˉwvbˉgenericˉnominalˉstatus.Unsupportedˉshape
            );
        }
        let Encodedˉelement:
            Compilerˉsourceˉwvbˉgenericˉnominalˉpart =
            Compilerˉsourceˉwvbˉgenericˉnominalˉshape(
                Input, Symbols, Plan,
                Recordˉtargets, Variantˉtargets, Concreteˉrecords, Element
            );
        if Encodedˉelement.Status !=
                Compilerˉsourceˉwvbˉgenericˉnominalˉstatus.Valid {
            return Encodedˉelement;
        }
        var Collection: bytes = Bytesˉfromˉu8(Collectionˉkind);
        Collection = Bytesˉconcat(Collection, Encodedˉelement.Payload);
        Collection = Bytesˉconcat(
            Collection, Bytesˉfromˉu32ˉlittle(Maximum)
        );
        return Compilerˉsourceˉwvbˉgenericˉnominalˉpart(
            Compilerˉsourceˉwvbˉgenericˉnominalˉstatus.Valid,
            Collection, Encodedˉelement.Features | 1u32
        );
    }
    var Kind: u8 = 0u8;
    if Shape == 1u32 { Kind = 1u8; }
    if Shape == 2u32 { Kind = 4u8; }
    if Shape == 3u32 { Kind = 5u8; }
    if Shape == 4u32 { Kind = 2u8; }
    if Shape == 5u32 { Kind = 3u8; }
    if Shape == 6u32 { Kind = 6u8; }
    if Shape == 7u32 { Kind = 9u8; }
    if Shape == 8u32 { Kind = 10u8; }
    if Shape == 9u32 { Kind = 20u8; }
    if Shape == 10u32 { Kind = 21u8; }
    if Shape == 11u32 { Kind = 14u8; }
    if Shape == 12u32 { Kind = 15u8; }
    if Shape == 13u32 { Kind = 16u8; }
    if Shape == 14u32 { Kind = 18u8; }
    if Shape == 15u32 { Kind = 19u8; }
    if Shape == 16u32 { Kind = 17u8; }
    if Shape == 805306368u32 { Kind = 25u8; }
    if (Shape >= 1u32 && Shape <= 16u32) || Shape == 805306368u32 {
        return Compilerˉsourceˉwvbˉgenericˉnominalˉpart(
            Compilerˉsourceˉwvbˉgenericˉnominalˉstatus.Valid,
            Bytesˉfromˉu8(Kind),
            Compilerˉsourceˉwvbˉgenericˉnominalˉscalarˉfeatures(Shape)
        );
    }
    if Shape >= 65536u32 && Shape < 65536u32 + Symbols.Records {
        let Sourceˉrecord: u32 = Shape - 65536u32;
        let Target: u32 = Bytesˉreadˉu32ˉlittle(
            Recordˉtargets, Sourceˉrecord * 4u32
        );
        if Target == 4294967295u32 {
            return Compilerˉsourceˉwvbˉgenericˉnominalˉpartˉfailure(
                Input, Compilerˉsourceˉwvbˉgenericˉnominalˉstatus.Unsupportedˉshape
            );
        }
        return Compilerˉsourceˉwvbˉgenericˉnominalˉpart(
            Compilerˉsourceˉwvbˉgenericˉnominalˉstatus.Valid,
            Bytesˉconcat(
                Bytesˉfromˉu8(7u8), Bytesˉfromˉu32ˉlittle(Target)
            ), 0u32
        );
    }
    if Shape >= 131072u32 + Symbols.Records &&
        Shape < 131072u32 + Symbols.Records + Symbols.Enums {
        return Compilerˉsourceˉwvbˉgenericˉnominalˉpart(
            Compilerˉsourceˉwvbˉgenericˉnominalˉstatus.Valid,
            Bytesˉconcat(
                Bytesˉfromˉu8(8u8),
                Bytesˉfromˉu32ˉlittle(
                    Concreteˉrecords + Shape - 131072u32 - Symbols.Records
                )
            ), 0u32
        );
    }
    if Shape >= 196608u32 + Symbols.Records + Symbols.Enums &&
        Shape < 196608u32 + Symbols.Records + Symbols.Enums + Symbols.Variants {
        let Sourceˉvariant: u32 =
            Shape - 196608u32 - Symbols.Records - Symbols.Enums;
        let Variantˉtarget: u32 = Bytesˉreadˉu32ˉlittle(
            Variantˉtargets, Sourceˉvariant * 4u32
        );
        if Variantˉtarget == 4294967295u32 {
            return Compilerˉsourceˉwvbˉgenericˉnominalˉpartˉfailure(
                Input, Compilerˉsourceˉwvbˉgenericˉnominalˉstatus.Unsupportedˉshape
            );
        }
        return Compilerˉsourceˉwvbˉgenericˉnominalˉpart(
            Compilerˉsourceˉwvbˉgenericˉnominalˉstatus.Valid,
            Bytesˉconcat(
                Bytesˉfromˉu8(11u8),
                Bytesˉfromˉu32ˉlittle(Variantˉtarget)
            ), 0u32
        );
    }
    return Compilerˉsourceˉwvbˉgenericˉnominalˉpartˉfailure(
        Input, Compilerˉsourceˉwvbˉgenericˉnominalˉstatus.Unsupportedˉshape
    );
}

fn Compilerˉsourceˉwvbˉgenericˉnominalˉfield(
    Input: bytes,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Plan: Materialization.Compilerˉsourceˉgenericˉtypeˉmaterialization,
    Recordˉtargets: bytes,
    Variantˉtargets: bytes,
    Concreteˉrecords: u32,
    Source: bytes,
    Fieldˉindex: u32
) -> Compilerˉsourceˉwvbˉgenericˉnominalˉpart {
    let Field: Genericˉlayouts.Compilerˉsourceˉgenericˉtypeˉfield =
        Materialization.Compilerˉsourceˉgenericˉtypeˉmaterializationˉfield(
            Plan, Fieldˉindex
        );
    if !Field.Found {
        return Compilerˉsourceˉwvbˉgenericˉnominalˉpartˉfailure(
            Input,
            Compilerˉsourceˉwvbˉgenericˉnominalˉstatus.Invalidˉmaterialization
        );
    }
    let Shape: Compilerˉsourceˉwvbˉgenericˉnominalˉpart =
        Compilerˉsourceˉwvbˉgenericˉnominalˉshape(
            Input, Symbols, Plan,
            Recordˉtargets, Variantˉtargets, Concreteˉrecords, Field.Shape
        );
    if Shape.Status !=
            Compilerˉsourceˉwvbˉgenericˉnominalˉstatus.Valid {
        return Shape;
    }
    var Result: Compilerˉsourceˉwvbˉgenericˉnominalˉpart =
        Compilerˉsourceˉwvbˉgenericˉnominalˉpartˉempty(Input);
    Result = Compilerˉsourceˉwvbˉgenericˉnominalˉpartˉappend(
        Result,
        Compilerˉsourceˉwvbˉgenericˉnominalˉstring(
            Source, Field.Nameˉoffset, Field.Nameˉlength
        )
    );
    Result = Compilerˉsourceˉwvbˉgenericˉnominalˉpartˉappend(
        Result, Shape.Payload
    );
    return Compilerˉsourceˉwvbˉgenericˉnominalˉpartˉfeatures(
        Result, Shape.Features
    );
}

fn Compilerˉsourceˉwvbˉgenericˉnominalˉtype(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Plan: Materialization.Compilerˉsourceˉgenericˉtypeˉmaterialization,
    Recordˉtargets: bytes,
    Variantˉtargets: bytes,
    Concreteˉrecords: u32,
    Instance: u32
) -> Compilerˉsourceˉwvbˉgenericˉnominalˉpart {
    let Typeˉoutput: u32 =
        Materialization.Compilerˉsourceˉgenericˉtypeˉmaterializationˉtypeˉword(
            Plan, Instance, 1u32
        );
    let Typeˉkind: u32 =
        Materialization.Compilerˉsourceˉgenericˉtypeˉmaterializationˉtypeˉword(
            Plan, Instance, 2u32
        );
    let Typeˉmodule: u32 =
        Materialization.Compilerˉsourceˉgenericˉtypeˉmaterializationˉtypeˉword(
            Plan, Instance, 4u32
        );
    let Typeˉfirstˉcase: u32 =
        Materialization.Compilerˉsourceˉgenericˉtypeˉmaterializationˉtypeˉword(
            Plan, Instance, 5u32
        );
    let Typeˉcases: u32 =
        Materialization.Compilerˉsourceˉgenericˉtypeˉmaterializationˉtypeˉword(
            Plan, Instance, 6u32
        );
    let Typeˉfirstˉfield: u32 =
        Materialization.Compilerˉsourceˉgenericˉtypeˉmaterializationˉtypeˉword(
            Plan, Instance, 7u32
        );
    let Typeˉfields: u32 =
        Materialization.Compilerˉsourceˉgenericˉtypeˉmaterializationˉtypeˉword(
            Plan, Instance, 8u32
        );
    if Typeˉoutput != Plan.Firstˉtype + Instance {
        return Compilerˉsourceˉwvbˉgenericˉnominalˉpartˉfailure(
            Input,
            Compilerˉsourceˉwvbˉgenericˉnominalˉstatus.Invalidˉmaterialization
        );
    }
    let View: Sourceˉset.Compilerˉsourceˉsetˉview =
        Sourceˉset.Compilerˉsourceˉsetˉmodule(Input, Scan, Typeˉmodule);
    if Typeˉkind >= 10u32 && Typeˉkind <= 12u32 {
        if Typeˉcases != 0u32 || Typeˉfields != 0u32 {
            return Compilerˉsourceˉwvbˉgenericˉnominalˉpartˉfailure(
                Input,
                Compilerˉsourceˉwvbˉgenericˉnominalˉstatus.Invalidˉmaterialization
            );
        }
        let Descriptorˉcatalog:
            Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog =
            Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog(
                Plan.Catalogˉstatus, Plan.Catalogˉevidence
            );
        let Descriptorˉelement:
            Sourceˉgenerics.Compilerˉsourceˉgenericˉargument =
            Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalogˉargument(
                Descriptorˉcatalog, Instance, 0u32
            );
        let Descriptorˉcount:
            Sourceˉgenerics.Compilerˉsourceˉgenericˉargument =
            Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalogˉargument(
                Descriptorˉcatalog, Instance, 1u32
            );
        if !Descriptorˉelement.Valid || Descriptorˉelement.Kind != 1u32 ||
            Descriptorˉelement.Shape != 0u32 ||
            Descriptorˉelement.High != 0u32 ||
            (Typeˉkind == 10u32 &&
                (!Descriptorˉcount.Valid || Descriptorˉcount.Kind != 2u32 ||
                    Descriptorˉcount.Shape != 8u32 ||
                    Descriptorˉcount.High != 0u32 ||
                    Descriptorˉcount.Low > 4095u32)) {
            return Compilerˉsourceˉwvbˉgenericˉnominalˉpartˉfailure(
                Input,
                Compilerˉsourceˉwvbˉgenericˉnominalˉstatus.Invalidˉmaterialization
            );
        }
        let Descriptorˉshape:
            Compilerˉsourceˉwvbˉgenericˉnominalˉpart =
            Compilerˉsourceˉwvbˉgenericˉnominalˉshape(
                Input, Symbols, Plan,
                Recordˉtargets, Variantˉtargets,
                Concreteˉrecords, Descriptorˉelement.Low
            );
        if Descriptorˉshape.Status !=
                Compilerˉsourceˉwvbˉgenericˉnominalˉstatus.Valid {
            return Descriptorˉshape;
        }
        var Descriptorˉresult:
            Compilerˉsourceˉwvbˉgenericˉnominalˉpart =
            Compilerˉsourceˉwvbˉgenericˉnominalˉpartˉempty(Input);
        if Typeˉkind == 10u32 {
            Descriptorˉresult =
                Compilerˉsourceˉwvbˉgenericˉnominalˉpartˉappend(
                    Descriptorˉresult, Bytesˉfromˉu8(4u8)
                );
        }
        if Typeˉkind == 11u32 {
            Descriptorˉresult =
                Compilerˉsourceˉwvbˉgenericˉnominalˉpartˉappend(
                    Descriptorˉresult, Bytesˉfromˉu8(5u8)
                );
        }
        if Typeˉkind == 12u32 {
            Descriptorˉresult =
                Compilerˉsourceˉwvbˉgenericˉnominalˉpartˉappend(
                    Descriptorˉresult, Bytesˉfromˉu8(6u8)
                );
        }
        Descriptorˉresult = Compilerˉsourceˉwvbˉgenericˉnominalˉpartˉappend(
            Descriptorˉresult,
            Compilerˉsourceˉwvbˉgenericˉnominalˉencodedˉname(Instance)
        );
        Descriptorˉresult = Compilerˉsourceˉwvbˉgenericˉnominalˉpartˉappend(
            Descriptorˉresult, Descriptorˉshape.Payload
        );
        if Typeˉkind == 10u32 {
            Descriptorˉresult =
                Compilerˉsourceˉwvbˉgenericˉnominalˉpartˉappend(
                    Descriptorˉresult,
                    Bytesˉfromˉu32ˉlittle(Descriptorˉcount.Low)
                );
            return Compilerˉsourceˉwvbˉgenericˉnominalˉpartˉfeatures(
                Descriptorˉresult, Descriptorˉshape.Features | 64u32
            );
        }
        return Compilerˉsourceˉwvbˉgenericˉnominalˉpartˉfeatures(
            Descriptorˉresult, Descriptorˉshape.Features | 128u32
        );
    }
    var Kind: u8 = 1u8;
    if Typeˉkind == 8u32 {
        Kind = 3u8;
    } else {
        if Typeˉkind != 4u32 {
            return Compilerˉsourceˉwvbˉgenericˉnominalˉpartˉfailure(
                Input,
                Compilerˉsourceˉwvbˉgenericˉnominalˉstatus.Invalidˉmaterialization
            );
        }
    }
    var Result: Compilerˉsourceˉwvbˉgenericˉnominalˉpart =
        Compilerˉsourceˉwvbˉgenericˉnominalˉpartˉempty(Input);
    Result = Compilerˉsourceˉwvbˉgenericˉnominalˉpartˉappend(
        Result, Bytesˉfromˉu8(Kind)
    );
    Result = Compilerˉsourceˉwvbˉgenericˉnominalˉpartˉappend(
        Result,
        Compilerˉsourceˉwvbˉgenericˉnominalˉencodedˉname(Instance)
    );
    if Kind == 1u8 {
        Result = Compilerˉsourceˉwvbˉgenericˉnominalˉpartˉappend(
            Result, Bytesˉfromˉu32ˉlittle(Typeˉfields)
        );
        var Fieldˉrank: u32 = 0u32;
        while Fieldˉrank < Typeˉfields {
            let Encodedˉfield:
                Compilerˉsourceˉwvbˉgenericˉnominalˉpart =
                Compilerˉsourceˉwvbˉgenericˉnominalˉfield(
                    Input, Symbols, Plan,
                    Recordˉtargets, Variantˉtargets, Concreteˉrecords, View.Source,
                    Typeˉfirstˉfield + Fieldˉrank
                );
            if Encodedˉfield.Status !=
                    Compilerˉsourceˉwvbˉgenericˉnominalˉstatus.Valid {
                return Encodedˉfield;
            }
            Result = Compilerˉsourceˉwvbˉgenericˉnominalˉpartˉappend(
                Result, Encodedˉfield.Payload
            );
            Result = Compilerˉsourceˉwvbˉgenericˉnominalˉpartˉfeatures(
                Result, Encodedˉfield.Features
            );
            Fieldˉrank = Fieldˉrank + 1u32;
        }
        return Result;
    }
    Result = Compilerˉsourceˉwvbˉgenericˉnominalˉpartˉappend(
        Result, Bytesˉfromˉu32ˉlittle(Typeˉcases)
    );
    var Caseˉrank: u32 = 0u32;
    while Caseˉrank < Typeˉcases {
        let Caseˉindex: u32 = Typeˉfirstˉcase + Caseˉrank;
        let Caseˉnameˉoffset: u32 =
            Materialization.Compilerˉsourceˉgenericˉtypeˉmaterializationˉcaseˉword(
                Plan, Caseˉindex, 0u32
            );
        let Caseˉnameˉlength: u32 =
            Materialization.Compilerˉsourceˉgenericˉtypeˉmaterializationˉcaseˉword(
                Plan, Caseˉindex, 1u32
            );
        let Caseˉfirstˉfield: u32 =
            Materialization.Compilerˉsourceˉgenericˉtypeˉmaterializationˉcaseˉword(
                Plan, Caseˉindex, 2u32
            );
        let Caseˉfields: u32 =
            Materialization.Compilerˉsourceˉgenericˉtypeˉmaterializationˉcaseˉword(
                Plan, Caseˉindex, 3u32
            );
        if Caseˉnameˉoffset == 4294967295u32 {
            return Compilerˉsourceˉwvbˉgenericˉnominalˉpartˉfailure(
                Input,
                Compilerˉsourceˉwvbˉgenericˉnominalˉstatus.Invalidˉmaterialization
            );
        }
        Result = Compilerˉsourceˉwvbˉgenericˉnominalˉpartˉappend(
            Result,
            Compilerˉsourceˉwvbˉgenericˉnominalˉstring(
                View.Source, Caseˉnameˉoffset, Caseˉnameˉlength
            )
        );
        if Caseˉfields == 0u32 {
            Result = Compilerˉsourceˉwvbˉgenericˉnominalˉpartˉappend(
                Result, Bytesˉfromˉu8(0u8)
            );
        } else {
            var Marker: bytes = Bytesˉfromˉu8(1u8);
            if Caseˉfields > 1u32 {
                Marker = Bytesˉconcat(
                    Bytesˉfromˉu8(2u8),
                    Bytesˉfromˉu32ˉlittle(Caseˉfields)
                );
                Result = Compilerˉsourceˉwvbˉgenericˉnominalˉpartˉfeatures(
                    Result, 32u32
                );
            }
            Result = Compilerˉsourceˉwvbˉgenericˉnominalˉpartˉappend(
                Result, Marker
            );
            var Caseˉfield: u32 = 0u32;
            while Caseˉfield < Caseˉfields {
                let Encodedˉcaseˉfield:
                    Compilerˉsourceˉwvbˉgenericˉnominalˉpart =
                    Compilerˉsourceˉwvbˉgenericˉnominalˉfield(
                        Input, Symbols, Plan,
                        Recordˉtargets, Variantˉtargets, Concreteˉrecords,
                        View.Source, Caseˉfirstˉfield + Caseˉfield
                    );
                if Encodedˉcaseˉfield.Status !=
                        Compilerˉsourceˉwvbˉgenericˉnominalˉstatus.Valid {
                    return Encodedˉcaseˉfield;
                }
                Result = Compilerˉsourceˉwvbˉgenericˉnominalˉpartˉappend(
                    Result, Encodedˉcaseˉfield.Payload
                );
                Result = Compilerˉsourceˉwvbˉgenericˉnominalˉpartˉfeatures(
                    Result, Encodedˉcaseˉfield.Features
                );
                Caseˉfield = Caseˉfield + 1u32;
            }
        }
        Caseˉrank = Caseˉrank + 1u32;
    }
    return Result;
}

fn Compilerˉsourceˉwvbˉgenericˉnominalˉtargetsˉareˉvalid(
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Recordˉtargets: bytes,
    Variantˉtargets: bytes,
    Concreteˉrecords: u32,
    Concreteˉdeclaredˉtypes: u32
) -> bool {
    if Bytesˉlength(Recordˉtargets) != Symbols.Records * 4u32 ||
        Bytesˉlength(Variantˉtargets) != Symbols.Variants * 4u32 {
        return false;
    }
    var Recordˉrank: u32 = 0u32;
    var Recordˉindex: u32 = 0u32;
    while Recordˉindex < Symbols.Records {
        let Recordˉtarget: u32 = Bytesˉreadˉu32ˉlittle(
            Recordˉtargets, Recordˉindex * 4u32
        );
        if Recordˉtarget != 4294967295u32 {
            if Recordˉtarget != Recordˉrank { return false; }
            Recordˉrank = Recordˉrank + 1u32;
        }
        Recordˉindex = Recordˉindex + 1u32;
    }
    if Recordˉrank != Concreteˉrecords { return false; }

    var Variantˉrank: u32 = 0u32;
    var Variantˉindex: u32 = 0u32;
    while Variantˉindex < Symbols.Variants {
        let Variantˉtarget: u32 = Bytesˉreadˉu32ˉlittle(
            Variantˉtargets, Variantˉindex * 4u32
        );
        if Variantˉtarget != 4294967295u32 {
            if Variantˉtarget !=
                    Concreteˉrecords + Symbols.Enums + Variantˉrank {
                return false;
            }
            Variantˉrank = Variantˉrank + 1u32;
        }
        Variantˉindex = Variantˉindex + 1u32;
    }
    return Concreteˉdeclaredˉtypes ==
        Concreteˉrecords + Symbols.Enums + Variantˉrank;
}

export fn Compilerˉsourceˉwvbˉencodeˉgenericˉnominalˉtypes(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Plan: Materialization.Compilerˉsourceˉgenericˉtypeˉmaterialization,
    Recordˉtargets: bytes,
    Variantˉtargets: bytes,
    Concreteˉrecords: u32,
    Concreteˉdeclaredˉtypes: u32
) -> Compilerˉsourceˉwvbˉgenericˉnominalˉencoding {
    let Sentinel: u32 =
        Compilerˉsourceˉwvbˉgenericˉnominalˉsentinel();
    if !Materialization.Compilerˉsourceˉgenericˉtypeˉmaterializationˉisˉvalid(
            Input, Scan, Symbols, Plan
        ) {
        return Compilerˉsourceˉwvbˉgenericˉnominalˉfailure(
            Input,
            Compilerˉsourceˉwvbˉgenericˉnominalˉstatus.Invalidˉmaterialization,
            Sentinel
        );
    }
    if !Compilerˉsourceˉwvbˉgenericˉnominalˉtargetsˉareˉvalid(
            Symbols, Recordˉtargets, Variantˉtargets, Concreteˉrecords,
            Concreteˉdeclaredˉtypes
        ) {
        return Compilerˉsourceˉwvbˉgenericˉnominalˉfailure(
            Input,
            Compilerˉsourceˉwvbˉgenericˉnominalˉstatus.Invalidˉtypeˉbase,
            Sentinel
        );
    }
    let Typeˉbase: u32 = Concreteˉdeclaredˉtypes;
    if Plan.Firstˉtype != Typeˉbase || Typeˉbase > 1024u32 {
        return Compilerˉsourceˉwvbˉgenericˉnominalˉfailure(
            Input,
            Compilerˉsourceˉwvbˉgenericˉnominalˉstatus.Invalidˉtypeˉbase,
            Sentinel
        );
    }
    if Typeˉbase > 1024u32 || Plan.Instances > 1024u32 - Typeˉbase {
        return Compilerˉsourceˉwvbˉgenericˉnominalˉfailure(
            Input,
            Compilerˉsourceˉwvbˉgenericˉnominalˉstatus.Typeˉlimit,
            Sentinel
        );
    }
    var Result: Compilerˉsourceˉwvbˉgenericˉnominalˉpart =
        Compilerˉsourceˉwvbˉgenericˉnominalˉpartˉempty(Input);
    var Instance: u32 = 0u32;
    while Instance < Plan.Instances {
        let Encoded: Compilerˉsourceˉwvbˉgenericˉnominalˉpart =
            Compilerˉsourceˉwvbˉgenericˉnominalˉtype(
                Input, Scan, Symbols, Plan,
                Recordˉtargets, Variantˉtargets, Concreteˉrecords, Instance
            );
        if Encoded.Status !=
                Compilerˉsourceˉwvbˉgenericˉnominalˉstatus.Valid {
            return Compilerˉsourceˉwvbˉgenericˉnominalˉfailure(
                Input, Encoded.Status, Instance
            );
        }
        Result = Compilerˉsourceˉwvbˉgenericˉnominalˉpartˉappend(
            Result, Encoded.Payload
        );
        Result = Compilerˉsourceˉwvbˉgenericˉnominalˉpartˉfeatures(
            Result, Encoded.Features
        );
        if Result.Status !=
                Compilerˉsourceˉwvbˉgenericˉnominalˉstatus.Valid {
            return Compilerˉsourceˉwvbˉgenericˉnominalˉfailure(
                Input, Result.Status, Instance
            );
        }
        Instance = Instance + 1u32;
    }
    return Compilerˉsourceˉwvbˉgenericˉnominalˉencoding(
        Compilerˉsourceˉwvbˉgenericˉnominalˉstatus.Valid, Plan.Instances,
        Result.Payload, Result.Features, Sentinel
    );
}
