module Compilerˉwebassemblyˉtypedˉcalls profile portable;

import Compilerˉwebassemblyˉfunctionˉdirectory as Functions;
import Compilerˉwebassemblyˉtypeˉdirectory as Types;

export record Compilerˉwebassemblyˉtypedˉcallˉsummary {
    Valid: bool;
    Instructionˉcount: u32;
    Callˉcount: u32;
    Maximumˉstack: u32;
    Failureˉfunction: u32;
    Failureˉoffset: u32;
    Failureˉopcode: u32;
}

record Typedˉstack {
    Valid: bool;
    Depth: u32;
    Maximum: u32;
    Firstˉword: u32;
    Secondˉword: u32;
    Thirdˉword: u32;
    Fourthˉword: u32;
    Fifthˉword: u32;
    Sixthˉword: u32;
    Seventhˉword: u32;
    Eighthˉword: u32;
    Ninthˉword: u32;
}

fn Invalidˉsummary() -> Compilerˉwebassemblyˉtypedˉcallˉsummary {
    return Compilerˉwebassemblyˉtypedˉcallˉsummary(
        false,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32
    );
}

fn Invalidˉat(
    Function: u32,
    Offset: u32,
    Opcode: u32
) -> Compilerˉwebassemblyˉtypedˉcallˉsummary {
    return Compilerˉwebassemblyˉtypedˉcallˉsummary(
        false,
        0u32,
        0u32,
        0u32,
        Function,
        Offset,
        Opcode
    );
}

fn Invalidˉstack(Stack: Typedˉstack) -> Typedˉstack {
    return Typedˉstack(
        false,
        Stack.Depth,
        Stack.Maximum,
        Stack.Firstˉword,
        Stack.Secondˉword,
        Stack.Thirdˉword,
        Stack.Fourthˉword,
        Stack.Fifthˉword,
        Stack.Sixthˉword,
        Stack.Seventhˉword,
        Stack.Eighthˉword,
        Stack.Ninthˉword
    );
}

fn Rangeˉisˉvalid(Total: u32, Offset: u32, Length: u32) -> bool {
    if Offset > Total { return false; }
    return Length <= Total - Offset;
}

fn Shapeˉkind(Input: bytes, Offset: u32) -> u32 {
    return U32ˉfromˉu8(Bytesˉreadˉu8(Input, Offset));
}

fn Shapeˉnominal(Input: bytes, Offset: u32) -> u32 {
    let Kind: u32 = Shapeˉkind(Input, Offset);
    if Kind == 7u32 || Kind == 8u32 || Kind == 11u32 {
        return Bytesˉreadˉu32ˉlittle(Input, Offset + 1u32);
    }
    return 0u32;
}

fn Shapeˉoffsetˉat(Input: bytes, Offset: u32, Index: u32) -> u32 {
    var Cursor: u32 = Offset;
    var Current: u32 = 0u32;
    while Current < Index {
        let Kind: u32 = Shapeˉkind(Input, Cursor);
        var Width: u32 = 1u32;
        if Kind == 7u32 || Kind == 8u32 || Kind == 11u32 {
            Width = 5u32;
        }
        if Kind == 12u32 || Kind == 13u32 {
            Width = 6u32;
            let Elementˉkind: u32 = Shapeˉkind(Input, Cursor + 1u32);
            if Elementˉkind == 7u32 || Elementˉkind == 8u32 ||
                Elementˉkind == 11u32 {
                Width = 10u32;
            }
        }
        Cursor = Cursor + Width;
        Current = Current + 1u32;
    }
    return Cursor;
}

fn Stackˉword(Stack: Typedˉstack, Index: u32) -> u32 {
    if Index == 0u32 { return Stack.Firstˉword; }
    if Index == 1u32 { return Stack.Secondˉword; }
    if Index == 2u32 { return Stack.Thirdˉword; }
    if Index == 3u32 { return Stack.Fourthˉword; }
    if Index == 4u32 { return Stack.Fifthˉword; }
    if Index == 5u32 { return Stack.Sixthˉword; }
    if Index == 6u32 { return Stack.Seventhˉword; }
    if Index == 7u32 { return Stack.Eighthˉword; }
    if Index == 8u32 { return Stack.Ninthˉword; }
    return 0u32;
}

fn Stackˉwithˉword(
    Stack: Typedˉstack,
    Index: u32,
    Value: u32
) -> Typedˉstack {
    if Index > 8u32 { return Invalidˉstack(Stack); }
    var Firstˉword: u32 = Stack.Firstˉword;
    var Secondˉword: u32 = Stack.Secondˉword;
    var Thirdˉword: u32 = Stack.Thirdˉword;
    var Fourthˉword: u32 = Stack.Fourthˉword;
    var Fifthˉword: u32 = Stack.Fifthˉword;
    var Sixthˉword: u32 = Stack.Sixthˉword;
    var Seventhˉword: u32 = Stack.Seventhˉword;
    var Eighthˉword: u32 = Stack.Eighthˉword;
    var Ninthˉword: u32 = Stack.Ninthˉword;
    if Index == 0u32 { Firstˉword = Value; }
    if Index == 1u32 { Secondˉword = Value; }
    if Index == 2u32 { Thirdˉword = Value; }
    if Index == 3u32 { Fourthˉword = Value; }
    if Index == 4u32 { Fifthˉword = Value; }
    if Index == 5u32 { Sixthˉword = Value; }
    if Index == 6u32 { Seventhˉword = Value; }
    if Index == 7u32 { Eighthˉword = Value; }
    if Index == 8u32 { Ninthˉword = Value; }
    return Typedˉstack(
        Stack.Valid,
        Stack.Depth,
        Stack.Maximum,
        Firstˉword,
        Secondˉword,
        Thirdˉword,
        Fourthˉword,
        Fifthˉword,
        Sixthˉword,
        Seventhˉword,
        Eighthˉword,
        Ninthˉword
    );
}

fn Stackˉwithˉdepth(Stack: Typedˉstack, Depth: u32) -> Typedˉstack {
    return Typedˉstack(
        Stack.Valid,
        Depth,
        Stack.Maximum,
        Stack.Firstˉword,
        Stack.Secondˉword,
        Stack.Thirdˉword,
        Stack.Fourthˉword,
        Stack.Fifthˉword,
        Stack.Sixthˉword,
        Stack.Seventhˉword,
        Stack.Eighthˉword,
        Stack.Ninthˉword
    );
}

fn Stackˉcode(Stack: Typedˉstack, Index: u32) -> u32 {
    let Wordˉindex: u32 = Index >> 2u32;
    let Shift: u32 = (Index & 3u32) << 3u32;
    return (Stackˉword(Stack, Wordˉindex) >> Shift) & 255u32;
}

fn Stackˉtopˉcode(Stack: Typedˉstack) -> u32 {
    if Stack.Depth == 0u32 { return 0u32; }
    return Stackˉcode(Stack, Stack.Depth - 1u32);
}

fn Stackˉtopˉnominal(Stack: Typedˉstack) -> u32 {
    let Code: u32 = Stackˉtopˉcode(Stack);
    if Code < 16u32 { return 0u32; }
    return Code - 16u32;
}

fn Stackˉtopˉisˉtypeˉkind(
    Stack: Typedˉstack,
    Directory: Types.Compilerˉwebassemblyˉtypeˉdirectoryˉsummary,
    Wanted: u32
) -> bool {
    let Code: u32 = Stackˉtopˉcode(Stack);
    if Code < 16u32 { return false; }
    let Nominal: u32 = Code - 16u32;
    if Nominal >= Directory.Count { return false; }
    return Types.Compilerˉwebassemblyˉtypeˉkind(
        Directory,
        Nominal
    ) == Wanted;
}

fn Stackˉencodedˉkind(Kind: u32, Nominal: u32) -> u32 {
    if Kind == 1u32 || Kind == 2u32 || Kind == 3u32 ||
        Kind == 4u32 || Kind == 5u32 || Kind == 6u32 ||
        Kind == 9u32 || Kind == 10u32 {
        return Kind;
    }
    if (Kind == 7u32 || Kind == 8u32 || Kind == 11u32) &&
        Nominal <= 239u32 {
        return 16u32 + Nominal;
    }
    return 0u32;
}

fn Stackˉstoreˉcode(
    Stack: Typedˉstack,
    Index: u32,
    Code: u32
) -> Typedˉstack {
    let Wordˉindex: u32 = Index >> 2u32;
    let Shift: u32 = (Index & 3u32) << 3u32;
    let Mask: u32 = 255u32 << Shift;
    let Cleared: u32 = Stackˉword(Stack, Wordˉindex) &
        (Mask ^ 4294967295u32);
    return Stackˉwithˉword(
        Stack,
        Wordˉindex,
        Cleared | (Code << Shift)
    );
}

fn Stackˉpushˉkind(
    Stack: Typedˉstack,
    Kind: u32,
    Nominal: u32,
    Limit: u32
) -> Typedˉstack {
    if !Stack.Valid || Stack.Depth >= Limit || Stack.Depth >= 36u32 {
        return Invalidˉstack(Stack);
    }
    let Code: u32 = Stackˉencodedˉkind(Kind, Nominal);
    if Code == 0u32 { return Invalidˉstack(Stack); }
    let Stored: Typedˉstack = Stackˉstoreˉcode(
        Stack,
        Stack.Depth,
        Code
    );
    if !Stored.Valid { return Stored; }
    let Depth: u32 = Stack.Depth + 1u32;
    var Maximum: u32 = Stack.Maximum;
    if Depth > Maximum { Maximum = Depth; }
    return Typedˉstack(
        true,
        Depth,
        Maximum,
        Stored.Firstˉword,
        Stored.Secondˉword,
        Stored.Thirdˉword,
        Stored.Fourthˉword,
        Stored.Fifthˉword,
        Stored.Sixthˉword,
        Stored.Seventhˉword,
        Stored.Eighthˉword,
        Stored.Ninthˉword
    );
}

fn Stackˉpushˉshape(
    Input: bytes,
    Stack: Typedˉstack,
    Offset: u32,
    Limit: u32
) -> Typedˉstack {
    return Stackˉpushˉkind(
        Stack,
        Shapeˉkind(Input, Offset),
        Shapeˉnominal(Input, Offset),
        Limit
    );
}

fn Stackˉpopˉkind(
    Stack: Typedˉstack,
    Kind: u32,
    Nominal: u32
) -> Typedˉstack {
    if !Stack.Valid || Stack.Depth == 0u32 {
        return Invalidˉstack(Stack);
    }
    if Stackˉtopˉcode(Stack) != Stackˉencodedˉkind(Kind, Nominal) {
        return Invalidˉstack(Stack);
    }
    return Stackˉwithˉdepth(Stack, Stack.Depth - 1u32);
}

fn Stackˉpopˉany(Stack: Typedˉstack) -> Typedˉstack {
    if !Stack.Valid || Stack.Depth == 0u32 {
        return Invalidˉstack(Stack);
    }
    return Stackˉwithˉdepth(Stack, Stack.Depth - 1u32);
}

fn Stackˉpopˉshape(
    Input: bytes,
    Stack: Typedˉstack,
    Offset: u32
) -> Typedˉstack {
    return Stackˉpopˉkind(
        Stack,
        Shapeˉkind(Input, Offset),
        Shapeˉnominal(Input, Offset)
    );
}

fn Applyˉeffect(
    Stack: Typedˉstack,
    Popˉcount: u32,
    Firstˉkind: u32,
    Firstˉnominal: u32,
    Secondˉkind: u32,
    Secondˉnominal: u32,
    Thirdˉkind: u32,
    Thirdˉnominal: u32,
    Hasˉpush: bool,
    Pushˉkind: u32,
    Pushˉnominal: u32,
    Limit: u32
) -> Typedˉstack {
    var Result: Typedˉstack = Stack;
    var Index: u32 = 0u32;
    while Index < Popˉcount {
        var Kind: u32 = Firstˉkind;
        var Nominal: u32 = Firstˉnominal;
        if Index == 1u32 { Kind = Secondˉkind; Nominal = Secondˉnominal; }
        if Index == 2u32 { Kind = Thirdˉkind; Nominal = Thirdˉnominal; }
        Result = Stackˉpopˉkind(Result, Kind, Nominal);
        if !Result.Valid { return Result; }
        Index = Index + 1u32;
    }
    if Hasˉpush {
        Result = Stackˉpushˉkind(Result, Pushˉkind, Pushˉnominal, Limit);
    }
    return Result;
}

record Staticˉeffect {
    Handled: bool;
    Popˉcount: u32;
    Firstˉkind: u32;
    Secondˉkind: u32;
    Thirdˉkind: u32;
    Hasˉpush: bool;
    Pushˉkind: u32;
}

