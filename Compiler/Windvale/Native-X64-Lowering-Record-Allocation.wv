module Compilerˉnativeˉx64ˉloweringˉrecordˉallocation profile portable;

import Compilerˉnativeˉx64ˉloweringˉtypes as Nominalˉtypes;

export record Compilerˉnativeˉx64ˉrecordˉallocation {
    Offsets: bytes;
    Fields: u32;
}

fn Empty(Input: bytes) -> bytes {
    return Bytesˉslice(Input, 0u32, 0u32);
}

fn Repeatˉbytes(Input: bytes, Count: u32, Value: bytes) -> bytes {
    var Result: bytes = Empty(Input);
    var Chunk: bytes = Value;
    var Remaining: u32 = Count;
    while Remaining > 0u32 {
        if Remaining % 2u32 == 1u32 {
            Result = Bytesˉconcat(Result, Chunk);
        }
        Remaining = Remaining / 2u32;
        if Remaining > 0u32 {
            Chunk = Bytesˉconcat(Chunk, Chunk);
        }
    }
    return Result;
}

fn U32ˉvalues(Input: bytes, Count: u32, Value: u32) -> bytes {
    return Repeatˉbytes(
        Input,
        Count,
        Bytesˉfromˉu32ˉlittle(Value)
    );
}

fn Setˉbyte(Input: bytes, Index: u32, Value: u8) -> bytes {
    return Bytesˉconcat(
        Bytesˉconcat(
            Bytesˉslice(Input, 0u32, Index),
            Bytesˉfromˉu8(Value)
        ),
        Bytesˉslice(Input, Index + 1u32, Bytesˉlength(Input) - Index - 1u32)
    );
}

fn Setˉu32(Input: bytes, Index: u32, Value: u32) -> bytes {
    let Offset: u32 = Index * 4u32;
    return Bytesˉconcat(
        Bytesˉconcat(
            Bytesˉslice(Input, 0u32, Offset),
            Bytesˉfromˉu32ˉlittle(Value)
        ),
        Bytesˉslice(Input, Offset + 4u32, Bytesˉlength(Input) - Offset - 4u32)
    );
}

export fn Compilerˉnativeˉx64ˉrecordˉinterferenceˉbytes(Count: u32) -> u32 {
    return Count * ((Count + 7u32) / 8u32);
}

fn Interferenceˉdirectedˉexists(
    Matrix: bytes,
    Count: u32,
    Left: u32,
    Right: u32
) -> bool {
    let Rowˉbytes: u32 = (Count + 7u32) / 8u32;
    let Current: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(
        Matrix,
        Left * Rowˉbytes + Right / 8u32
    ));
    return (Current & (1u32 << (Right % 8u32))) != 0u32;
}

fn Interferenceˉexists(
    Matrix: bytes,
    Count: u32,
    Left: u32,
    Right: u32
) -> bool {
    if Interferenceˉdirectedˉexists(Matrix, Count, Left, Right) {
        return true;
    }
    return Interferenceˉdirectedˉexists(Matrix, Count, Right, Left);
}

fn Interferenceˉaddˉrow(
    Matrix: bytes,
    Live: bytes,
    Count: u32,
    Value: u32,
    Minimumˉother: u32
) -> bytes {
    let Rowˉbytes: u32 = (Count + 7u32) / 8u32;
    let Rowˉoffset: u32 = Value * Rowˉbytes;
    var Row: bytes = Empty(Matrix);
    var Byteˉindex: u32 = 0u32;
    while Byteˉindex < Rowˉbytes {
        var Updated: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(
            Matrix,
            Rowˉoffset + Byteˉindex
        ));
        var Bit: u32 = 0u32;
        while Bit < 8u32 {
            let Other: u32 = Byteˉindex * 8u32 + Bit;
            if Other < Count && Other >= Minimumˉother && Other != Value {
                if Bytesˉreadˉu8(Live, Other) == 1u8 {
                    Updated = Updated | (1u32 << Bit);
                }
            }
            Bit = Bit + 1u32;
        }
        Row = Bytesˉconcat(
            Row,
            Bytesˉslice(Bytesˉfromˉu32ˉlittle(Updated), 0u32, 1u32)
        );
        Byteˉindex = Byteˉindex + 1u32;
    }
    return Bytesˉconcat(
        Bytesˉconcat(
            Bytesˉslice(Matrix, 0u32, Rowˉoffset),
            Row
        ),
        Bytesˉslice(
            Matrix,
            Rowˉoffset + Rowˉbytes,
            Bytesˉlength(Matrix) - Rowˉoffset - Rowˉbytes
        )
    );
}

export fn Compilerˉnativeˉx64ˉaddˉliveˉrecordˉinterference(
    Matrix: bytes,
    Live: bytes,
    Count: u32,
    Value: u32
) -> bytes {
    return Interferenceˉaddˉrow(Matrix, Live, Count, Value, 0u32);
}

export fn Compilerˉnativeˉx64ˉaddˉallˉliveˉrecordˉinterference(
    Matrix: bytes,
    Live: bytes,
    Count: u32
) -> bytes {
    var Result: bytes = Matrix;
    var Left: u32 = 0u32;
    while Left < Count {
        if Bytesˉreadˉu8(Live, Left) == 1u8 {
            Result = Interferenceˉaddˉrow(
                Result,
                Live,
                Count,
                Left,
                Left + 1u32
            );
        }
        Left = Left + 1u32;
    }
    return Result;
}

fn Interferenceˉrowˉor(
    Row: bytes,
    Events: bytes,
    Snapshotˉoffset: u32,
    Rowˉbytes: u32
) -> bytes {
    var Result: bytes = Empty(Row);
    var Index: u32 = 0u32;
    while Index < Rowˉbytes {
        let Combined: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(Row, Index)) |
            U32ˉfromˉu8(Bytesˉreadˉu8(Events, Snapshotˉoffset + Index));
        Result = Bytesˉconcat(
            Result,
            Bytesˉslice(Bytesˉfromˉu32ˉlittle(Combined), 0u32, 1u32)
        );
        Index = Index + 1u32;
    }
    return Result;
}

export fn Compilerˉnativeˉx64ˉbuildˉrecordˉinterference(
    Matrix: bytes,
    Events: bytes,
    Count: u32
) -> bytes {
    let Rowˉbytes: u32 = (Count + 7u32) / 8u32;
    let Eventˉbytes: u32 = 4u32 + Rowˉbytes;
    if Eventˉbytes == 0u32 || Bytesˉlength(Events) % Eventˉbytes != 0u32 {
        return Matrix;
    }
    var Result: bytes = Empty(Matrix);
    var Left: u32 = 0u32;
    while Left < Count {
        var Row: bytes = Bytesˉslice(
            Matrix,
            Left * Rowˉbytes,
            Rowˉbytes
        );
        var Cursor: u32 = 0u32;
        while Cursor < Bytesˉlength(Events) {
            let Value: u32 = Bytesˉreadˉu32ˉlittle(Events, Cursor);
            var Relevant: bool = Value == Left;
            if Value == 4294967295u32 {
                let Liveˉbyte: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(
                    Events,
                    Cursor + 4u32 + Left / 8u32
                ));
                Relevant = (Liveˉbyte & (1u32 << (Left % 8u32))) != 0u32;
            }
            if Relevant {
                Row = Interferenceˉrowˉor(
                    Row,
                    Events,
                    Cursor + 4u32,
                    Rowˉbytes
                );
            }
            Cursor = Cursor + Eventˉbytes;
        }
        Result = Bytesˉconcat(Result, Row);
        Left = Left + 1u32;
    }
    return Result;
}

fn Recordˉwidth(
    Types: Nominalˉtypes.Compilerˉnativeˉx64ˉtypes,
    Type: u8
) -> u32 {
    return Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉitemˉcount(
        Types,
        Nominalˉtypes.Compilerˉnativeˉx64ˉrecordˉtypeˉindex(Type)
    );
}

fn Allocateˉoffsets(
    Input: bytes,
    Types: Nominalˉtypes.Compilerˉnativeˉx64ˉtypes,
    Present: bytes,
    Typeˉbyˉidentifier: bytes,
    Interference: bytes,
    Count: u32
) -> bytes {
    var Offsets: bytes = U32ˉvalues(Input, Count, 4294967295u32);
    var Width: u32 = 64u32;
    while Width > 0u32 {
        var Identifier: u32 = 0u32;
        while Identifier < Count {
            if Bytesˉreadˉu8(Present, Identifier) == 1u8 {
                let Type: u8 = Bytesˉreadˉu8(Typeˉbyˉidentifier, Identifier);
                if Recordˉwidth(Types, Type) == Width {
                    var Candidate: u32 = 0u32;
                    var Searching: bool = true;
                    while Searching {
                        Searching = false;
                        var Next: u32 = Candidate;
                        var Other: u32 = 0u32;
                        while Other < Count {
                            let Otherˉoffset: u32 = Bytesˉreadˉu32ˉlittle(
                                Offsets,
                                Other * 4u32
                            );
                            if Otherˉoffset != 4294967295u32 {
                                if Interferenceˉexists(
                                    Interference,
                                    Count,
                                    Identifier,
                                    Other
                                ) {
                                    let Otherˉwidth: u32 = Recordˉwidth(
                                        Types,
                                        Bytesˉreadˉu8(Typeˉbyˉidentifier, Other)
                                    );
                                    if Candidate < Otherˉoffset + Otherˉwidth {
                                        if Otherˉoffset < Candidate + Width {
                                            Searching = true;
                                            if Otherˉoffset + Otherˉwidth > Next {
                                                Next = Otherˉoffset + Otherˉwidth;
                                            }
                                        }
                                    }
                                }
                            }
                            Other = Other + 1u32;
                        }
                        Candidate = Next;
                    }
                    Offsets = Setˉu32(Offsets, Identifier, Candidate);
                }
            }
            Identifier = Identifier + 1u32;
        }
        Width = Width - 1u32;
    }
    return Offsets;
}

fn Requiredˉfields(
    Types: Nominalˉtypes.Compilerˉnativeˉx64ˉtypes,
    Present: bytes,
    Typeˉbyˉidentifier: bytes,
    Offsets: bytes,
    Count: u32
) -> u32 {
    var Required: u32 = 0u32;
    var Identifier: u32 = 0u32;
    while Identifier < Count {
        if Bytesˉreadˉu8(Present, Identifier) == 1u8 {
            let End: u32 = Bytesˉreadˉu32ˉlittle(
                Offsets,
                Identifier * 4u32
            ) + Recordˉwidth(
                Types,
                Bytesˉreadˉu8(Typeˉbyˉidentifier, Identifier)
            );
            if End > Required { Required = End; }
        }
        Identifier = Identifier + 1u32;
    }
    return Required;
}

export fn Compilerˉnativeˉx64ˉallocateˉrecordˉoffsets(
    Input: bytes,
    Types: Nominalˉtypes.Compilerˉnativeˉx64ˉtypes,
    Present: bytes,
    Typeˉbyˉidentifier: bytes,
    Interference: bytes,
    Count: u32
) -> Compilerˉnativeˉx64ˉrecordˉallocation {
    let Offsets: bytes = Allocateˉoffsets(
        Input,
        Types,
        Present,
        Typeˉbyˉidentifier,
        Interference,
        Count
    );
    return Compilerˉnativeˉx64ˉrecordˉallocation(
        Offsets,
        Requiredˉfields(
            Types,
            Present,
            Typeˉbyˉidentifier,
            Offsets,
            Count
        )
    );
}
