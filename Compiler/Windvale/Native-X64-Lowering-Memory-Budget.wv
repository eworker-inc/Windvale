module Compilerˉnativeˉx64ˉloweringˉmemoryˉbudget profile portable;

import Compilerˉnativeˉx64ˉloweringˉtypes as Nominalˉtypes;
import Compilerˉnativeˉx64ˉloweringˉrecordˉinstructions as Recordˉinstructions;
import Compilerˉnativeˉx64ˉloweringˉrecordˉstorage as Recordˉstorage;

fn Appendˉbyte(Result: bytes, Value: u8) -> bytes {
    return Bytesˉconcat(Result, Bytesˉfromˉu8(Value));
}

fn Appendˉu32(Result: bytes, Value: u32) -> bytes {
    return Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Value));
}

fn Relativeˉu32(Target: u32, Origin: u32) -> u32 {
    if Target >= Origin { return Target - Origin; }
    let Magnitude: u32 = Origin - Target;
    return 4294967295u32 - Magnitude + 1u32;
}

fn Loadˉrax(Result: bytes, Slot: u32) -> bytes {
    var Output: bytes = Appendˉbyte(Result, 72u8);
    Output = Appendˉbyte(Output, 139u8);
    Output = Appendˉbyte(Output, 132u8);
    Output = Appendˉbyte(Output, 36u8);
    return Appendˉu32(Output, Slot * 16u32);
}

fn Loadˉrcx(Result: bytes, Slot: u32) -> bytes {
    var Output: bytes = Appendˉbyte(Result, 72u8);
    Output = Appendˉbyte(Output, 139u8);
    Output = Appendˉbyte(Output, 140u8);
    Output = Appendˉbyte(Output, 36u8);
    return Appendˉu32(Output, Slot * 16u32);
}

fn Loadˉrdx(Result: bytes, Slot: u32) -> bytes {
    var Output: bytes = Appendˉbyte(Result, 72u8);
    Output = Appendˉbyte(Output, 139u8);
    Output = Appendˉbyte(Output, 148u8);
    Output = Appendˉbyte(Output, 36u8);
    return Appendˉu32(Output, Slot * 16u32);
}

fn Storeˉrax(Result: bytes, Slot: u32) -> bytes {
    var Output: bytes = Appendˉbyte(Result, 72u8);
    Output = Appendˉbyte(Output, 137u8);
    Output = Appendˉbyte(Output, 132u8);
    Output = Appendˉbyte(Output, 36u8);
    return Appendˉu32(Output, Slot * 16u32);
}

fn Storeˉr8(Result: bytes, Slot: u32) -> bytes {
    var Output: bytes = Appendˉbyte(Result, 76u8);
    Output = Appendˉbyte(Output, 137u8);
    Output = Appendˉbyte(Output, 132u8);
    Output = Appendˉbyte(Output, 36u8);
    return Appendˉu32(Output, Slot * 16u32);
}

fn Storeˉr10(Result: bytes, Slot: u32) -> bytes {
    var Output: bytes = Appendˉbyte(Result, 76u8);
    Output = Appendˉbyte(Output, 137u8);
    Output = Appendˉbyte(Output, 148u8);
    Output = Appendˉbyte(Output, 36u8);
    return Appendˉu32(Output, Slot * 16u32);
}

fn Storeˉimmediate(Result: bytes, Slot: u32, Value: u32) -> bytes {
    var Output: bytes = Appendˉbyte(Result, 72u8);
    Output = Appendˉbyte(Output, 199u8);
    Output = Appendˉbyte(Output, 132u8);
    Output = Appendˉbyte(Output, 36u8);
    Output = Appendˉu32(Output, Slot * 16u32);
    return Appendˉu32(Output, Value);
}

fn Frameˉaddress(Result: bytes, Slot: u32) -> bytes {
    var Output: bytes = Appendˉbyte(Result, 72u8);
    Output = Appendˉbyte(Output, 141u8);
    Output = Appendˉbyte(Output, 132u8);
    Output = Appendˉbyte(Output, 36u8);
    return Appendˉu32(Output, Slot * 16u32);
}

fn Conditionalˉjump(Result: bytes, Condition: u8, Target: u32) -> bytes {
    var Output: bytes = Appendˉbyte(Result, 15u8);
    Output = Appendˉbyte(Output, Condition);
    return Appendˉu32(
        Output,
        Relativeˉu32(Target, Bytesˉlength(Output) + 4u32)
    );
}

fn Jump(Result: bytes, Target: u32) -> bytes {
    var Output: bytes = Appendˉbyte(Result, 233u8);
    return Appendˉu32(
        Output,
        Relativeˉu32(Target, Bytesˉlength(Output) + 4u32)
    );
}

fn Emitˉmachine(
    Result: bytes,
    Maximumˉbytesˉslot: u32,
    Maximumˉchildrenˉslot: u32,
    Parentˉslot: u32,
    Resultˉtype: u32,
    Target: u32,
    Backing: u32,
    Invalidˉlimitˉtarget: u32
) -> bytes {
    let Base: u32 = Bytesˉlength(Result);
    let Failure: u32 = Base + 118u32;
    let Finish: u32 = Base + 158u32;

    var Output: bytes = Loadˉrax(Result, Maximumˉbytesˉslot);
    Output = Loadˉrcx(Output, Maximumˉchildrenˉslot);
    Output = Loadˉrdx(Output, Parentˉslot);
    Output = Appendˉbyte(Output, 65u8);
    Output = Appendˉbyte(Output, 137u8);
    Output = Appendˉbyte(Output, 208u8);
    Output = Appendˉbyte(Output, 73u8);
    Output = Appendˉbyte(Output, 137u8);
    Output = Appendˉbyte(Output, 209u8);
    Output = Appendˉbyte(Output, 73u8);
    Output = Appendˉbyte(Output, 193u8);
    Output = Appendˉbyte(Output, 233u8);
    Output = Appendˉbyte(Output, 32u8);
    Output = Appendˉbyte(Output, 72u8);
    Output = Appendˉbyte(Output, 131u8);
    Output = Appendˉbyte(Output, 249u8);
    Output = Appendˉbyte(Output, 64u8);
    Output = Conditionalˉjump(Output, 135u8, Invalidˉlimitˉtarget);
    Output = Appendˉbyte(Output, 76u8);
    Output = Appendˉbyte(Output, 57u8);
    Output = Appendˉbyte(Output, 192u8);
    Output = Conditionalˉjump(Output, 135u8, Failure);
    Output = Appendˉbyte(Output, 77u8);
    Output = Appendˉbyte(Output, 133u8);
    Output = Appendˉbyte(Output, 201u8);
    Output = Conditionalˉjump(Output, 132u8, Failure);

    Output = Appendˉbyte(Output, 73u8);
    Output = Appendˉbyte(Output, 41u8);
    Output = Appendˉbyte(Output, 192u8);
    Output = Appendˉbyte(Output, 73u8);
    Output = Appendˉbyte(Output, 255u8);
    Output = Appendˉbyte(Output, 201u8);
    Output = Appendˉbyte(Output, 73u8);
    Output = Appendˉbyte(Output, 193u8);
    Output = Appendˉbyte(Output, 225u8);
    Output = Appendˉbyte(Output, 32u8);
    Output = Appendˉbyte(Output, 77u8);
    Output = Appendˉbyte(Output, 9u8);
    Output = Appendˉbyte(Output, 200u8);
    Output = Storeˉr8(Output, Parentˉslot);
    Output = Appendˉbyte(Output, 73u8);
    Output = Appendˉbyte(Output, 137u8);
    Output = Appendˉbyte(Output, 202u8);
    Output = Appendˉbyte(Output, 73u8);
    Output = Appendˉbyte(Output, 193u8);
    Output = Appendˉbyte(Output, 226u8);
    Output = Appendˉbyte(Output, 32u8);
    Output = Appendˉbyte(Output, 73u8);
    Output = Appendˉbyte(Output, 9u8);
    Output = Appendˉbyte(Output, 194u8);
    Output = Storeˉimmediate(Output, Backing, 0u32);
    Output = Storeˉr10(Output, Backing + 1u32);
    Output = Jump(Output, Finish);

    Output = Storeˉimmediate(Output, Backing, 1u32);
    Output = Storeˉimmediate(Output, Backing + 2u32, 1u32);
    Output = Storeˉrax(Output, Backing + 3u32);
    Output = Storeˉr8(Output, Backing + 4u32);

    Output = Appendˉbyte(Output, 65u8);
    Output = Appendˉbyte(Output, 184u8);
    Output = Appendˉu32(Output, Resultˉtype);
    Output = Frameˉaddress(Output, Backing);
    return Storeˉrax(Output, Target);
}

export fn Compilerˉnativeˉx64ˉmemoryˉbudgetˉsplitˉbytes() -> u32 {
    // The common instruction-limit charge contributes ten bytes before the
    // 180-byte operation-specific sequence.
    return 190u32;
}

export fn Compilerˉnativeˉx64ˉemitˉmemoryˉbudgetˉsplit(
    Input: bytes,
    Offset: u32,
    Shape: Recordˉinstructions.Compilerˉnativeˉx64ˉrecordˉlayout,
    Storage: Recordˉstorage.Compilerˉnativeˉx64ˉrecordˉstorage,
    Invalidˉlimitˉtarget: u32,
    State: Recordˉinstructions.Compilerˉnativeˉx64ˉrecordˉstate
) -> Recordˉinstructions.Compilerˉnativeˉx64ˉrecordˉstate {
    let Depth: u32 = State.Stackˉdepth - 2u32;
    let Maximumˉbytesˉslot: u32 = Bytesˉreadˉu32ˉlittle(
        State.Stackˉslots, Depth * 4u32
    );
    let Maximumˉchildrenˉslot: u32 = Bytesˉreadˉu32ˉlittle(
        State.Stackˉslots, (Depth + 1u32) * 4u32
    );
    let Parentˉslot: u32 = Bytesˉreadˉu32ˉlittle(Input, Offset + 1u32);
    let Resultˉtype: u32 = Bytesˉreadˉu32ˉlittle(Input, Offset + 5u32);
    let Target: u32 = Shape.Recordˉbase + State.Nextˉrecord;
    let Backing: u32 = Shape.Scratchˉbase + Bytesˉreadˉu32ˉlittle(
        Storage.Scratchˉoffsets, State.Nextˉrecord * 4u32
    );
    return Recordˉinstructions.Compilerˉnativeˉx64ˉrecordˉstate(
        Emitˉmachine(
            State.Result,
            Maximumˉbytesˉslot,
            Maximumˉchildrenˉslot,
            Parentˉslot,
            Resultˉtype,
            Target,
            Backing,
            Invalidˉlimitˉtarget
        ),
        Bytesˉconcat(
            Bytesˉslice(State.Stackˉtypes, 0u32, Depth),
            Bytesˉfromˉu8(
                Nominalˉtypes.Compilerˉnativeˉx64ˉvariantˉtype(Resultˉtype)
            )
        ),
        Bytesˉconcat(
            Bytesˉslice(State.Stackˉslots, 0u32, Depth * 4u32),
            Bytesˉfromˉu32ˉlittle(Target)
        ),
        Depth + 1u32,
        State.Nextˉi32,
        State.Nextˉbool,
        State.Nextˉtext,
        State.Nextˉu8,
        State.Nextˉu32,
        State.Nextˉbytes,
        State.Nextˉenum,
        State.Nextˉrecord + 1u32
    );
}
