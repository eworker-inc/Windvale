module Compilerˉnativeˉx64ˉloweringˉdescriptorˉcalls profile portable;

record Descriptorˉreturnˉprefix {
    Output: bytes;
    Resetˉbelowˉpatch: u32;
    Preserveˉoverflowˉpatch: u32;
    Resetˉstartˉpatch: u32;
    Resetˉendˉpatch: u32;
    Internalˉpatch: u32;
    Preserveˉrangeˉpatch: u32;
}

record Descriptorˉreturnˉreset {
    Output: bytes;
    Preserveˉoverflowˉpatch: u32;
    Internalˉpatch: u32;
    Preserveˉrangeˉpatch: u32;
    Externalˉfromˉresetˉpatch: u32;
}

record Descriptorˉreturnˉpreserve {
    Output: bytes;
    Internalˉpatch: u32;
    Preserve: u32;
}

fn Appendˉbyte(Result: bytes, Value: u8) -> bytes {
    return Bytesˉconcat(Result, Bytesˉfromˉu8(Value));
}

fn Appendˉu32(Result: bytes, Value: u32) -> bytes {
    return Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Value));
}

fn Patchˉu32(Input: bytes, Offset: u32, Value: u32) -> bytes {
    return Bytesˉconcat(
        Bytesˉconcat(
            Bytesˉslice(Input, 0u32, Offset),
            Bytesˉfromˉu32ˉlittle(Value)
        ),
        Bytesˉslice(
            Input,
            Offset + 4u32,
            Bytesˉlength(Input) - Offset - 4u32
        )
    );
}

fn Relativeˉu32(Target: u32, Origin: u32) -> u32 {
    if Target >= Origin { return Target - Origin; }
    let Magnitude: u32 = Origin - Target;
    return 4294967295u32 - Magnitude + 1u32;
}

fn Loadˉeaxˉfield(Result: bytes, Slot: u32) -> bytes {
    let Prefix: bytes = Bytesˉconcat(
        Bytesˉfromˉu16ˉlittle(33931u32),
        Bytesˉfromˉu8(36u8)
    );
    return Bytesˉconcat(
        Result,
        Bytesˉconcat(
            Prefix,
            Bytesˉfromˉu32ˉlittle(Slot * 16u32 + 8u32)
        )
    );
}

fn Loadˉecxˉfield(Result: bytes, Slot: u32) -> bytes {
    let Prefix: bytes = Bytesˉconcat(
        Bytesˉfromˉu16ˉlittle(35979u32),
        Bytesˉfromˉu8(36u8)
    );
    return Bytesˉconcat(
        Result,
        Bytesˉconcat(
            Prefix,
            Bytesˉfromˉu32ˉlittle(Slot * 16u32 + 8u32)
        )
    );
}

fn Loadˉrax(Result: bytes, Slot: u32) -> bytes {
    return Bytesˉconcat(
        Result,
        Bytesˉconcat(
            Bytesˉfromˉu32ˉlittle(612666184u32),
            Bytesˉfromˉu32ˉlittle(Slot * 16u32)
        )
    );
}

fn Loadˉrdx(Result: bytes, Slot: u32) -> bytes {
    return Bytesˉconcat(
        Result,
        Bytesˉconcat(
            Bytesˉfromˉu32ˉlittle(613714760u32),
            Bytesˉfromˉu32ˉlittle(Slot * 16u32)
        )
    );
}

fn Storeˉrax(Result: bytes, Slot: u32) -> bytes {
    return Bytesˉconcat(
        Result,
        Bytesˉconcat(
            Bytesˉfromˉu32ˉlittle(612665672u32),
            Bytesˉfromˉu32ˉlittle(Slot * 16u32)
        )
    );
}

fn Storeˉraxˉfield(Result: bytes, Slot: u32) -> bytes {
    return Bytesˉconcat(
        Result,
        Bytesˉconcat(
            Bytesˉfromˉu32ˉlittle(612665672u32),
            Bytesˉfromˉu32ˉlittle(Slot * 16u32 + 8u32)
        )
    );
}

fn Emitˉreturn(Result: bytes, Frameˉbytes: u32) -> bytes {
    let Prefix: bytes = Bytesˉconcat(
        Bytesˉfromˉu16ˉlittle(33096u32),
        Bytesˉfromˉu8(196u8)
    );
    let Suffix: bytes = Bytesˉconcat(
        Bytesˉconcat(Prefix, Bytesˉfromˉu32ˉlittle(Frameˉbytes)),
        Bytesˉfromˉu32ˉlittle(3284336457u32)
    );
    return Bytesˉconcat(Result, Suffix);
}

export fn Compilerˉnativeˉx64ˉtypeˉisˉdescriptor(Type: u8) -> bool {
    if Type == 3u8 { return true; }
    return Type == 6u8;
}

export fn Compilerˉnativeˉx64ˉdescriptorˉreturnˉbytes() -> u32 {
    // The ABI return sequence is 296 bytes plus the 10-byte instruction charge.
    return 306u32;
}

export fn Compilerˉnativeˉx64ˉemitˉdescriptorˉoutput(
    Result: bytes,
    Slot: u32,
    Stackˉbytes: u32
) -> bytes {
    return Bytesˉconcat(
        Result,
        Bytesˉconcat(
            Bytesˉfromˉu32ˉlittle(612666696u32),
            Bytesˉfromˉu32ˉlittle(Slot * 16u32 + Stackˉbytes)
        )
    );
}

export fn Compilerˉnativeˉx64ˉemitˉhiddenˉdescriptorˉresult(
    Result: bytes,
    Slot: u32
) -> bytes {
    return Storeˉrax(Result, Slot);
}

export fn Compilerˉnativeˉx64ˉemitˉdescriptorˉcheckpoint(
    Result: bytes,
    Hiddenˉslot: u32
) -> bytes {
    let Suffix: bytes = Bytesˉconcat(
        Bytesˉfromˉu32ˉlittle(1011321665u32),
        Bytesˉconcat(
            Bytesˉconcat(
                Bytesˉfromˉu16ˉlittle(33929u32),
                Bytesˉfromˉu8(36u8)
            ),
            Bytesˉfromˉu32ˉlittle(Hiddenˉslot * 16u32 + 8u32)
        )
    );
    return Bytesˉconcat(Result, Suffix);
}

fn Buildˉdescriptorˉreturnˉprefix(
    Result: bytes,
    Sourceˉslot: u32,
    Hiddenˉslot: u32
) -> Descriptorˉreturnˉprefix {
    var Output: bytes = Bytesˉslice(Result, 0u32, 0u32);
    Output = Loadˉeaxˉfield(Output, Hiddenˉslot);
    Output = Appendˉbyte(Output, 65u8);
    Output = Appendˉbyte(Output, 137u8);
    Output = Appendˉbyte(Output, 193u8);
    Output = Appendˉbyte(Output, 77u8);
    Output = Appendˉbyte(Output, 139u8);
    Output = Appendˉbyte(Output, 71u8);
    Output = Appendˉbyte(Output, 48u8);
    Output = Loadˉrax(Output, Sourceˉslot);
    Output = Loadˉecxˉfield(Output, Sourceˉslot);
    Output = Appendˉbyte(Output, 76u8);
    Output = Appendˉbyte(Output, 57u8);
    Output = Appendˉbyte(Output, 192u8);
    Output = Appendˉbyte(Output, 15u8);
    Output = Appendˉbyte(Output, 130u8);
    let Resetˉbelowˉpatch: u32 = Bytesˉlength(Output);
    Output = Appendˉu32(Output, 0u32);
    Output = Appendˉbyte(Output, 72u8);
    Output = Appendˉbyte(Output, 137u8);
    Output = Appendˉbyte(Output, 194u8);
    Output = Appendˉbyte(Output, 72u8);
    Output = Appendˉbyte(Output, 1u8);
    Output = Appendˉbyte(Output, 202u8);
    Output = Appendˉbyte(Output, 15u8);
    Output = Appendˉbyte(Output, 130u8);
    let Preserveˉoverflowˉpatch: u32 = Bytesˉlength(Output);
    Output = Appendˉu32(Output, 0u32);
    Output = Appendˉbyte(Output, 76u8);
    Output = Appendˉbyte(Output, 41u8);
    Output = Appendˉbyte(Output, 192u8);
    Output = Appendˉbyte(Output, 76u8);
    Output = Appendˉbyte(Output, 41u8);
    Output = Appendˉbyte(Output, 194u8);
    Output = Appendˉbyte(Output, 69u8);
    Output = Appendˉbyte(Output, 139u8);
    Output = Appendˉbyte(Output, 71u8);
    Output = Appendˉbyte(Output, 60u8);
    Output = Appendˉbyte(Output, 76u8);
    Output = Appendˉbyte(Output, 57u8);
    Output = Appendˉbyte(Output, 192u8);
    Output = Appendˉbyte(Output, 15u8);
    Output = Appendˉbyte(Output, 135u8);
    let Resetˉstartˉpatch: u32 = Bytesˉlength(Output);
    Output = Appendˉu32(Output, 0u32);
    Output = Appendˉbyte(Output, 76u8);
    Output = Appendˉbyte(Output, 57u8);
    Output = Appendˉbyte(Output, 194u8);
    Output = Appendˉbyte(Output, 15u8);
    Output = Appendˉbyte(Output, 135u8);
    let Resetˉendˉpatch: u32 = Bytesˉlength(Output);
    Output = Appendˉu32(Output, 0u32);
    Output = Appendˉbyte(Output, 76u8);
    Output = Appendˉbyte(Output, 57u8);
    Output = Appendˉbyte(Output, 200u8);
    Output = Appendˉbyte(Output, 15u8);
    Output = Appendˉbyte(Output, 131u8);
    let Internalˉpatch: u32 = Bytesˉlength(Output);
    Output = Appendˉu32(Output, 0u32);
    Output = Appendˉbyte(Output, 76u8);
    Output = Appendˉbyte(Output, 57u8);
    Output = Appendˉbyte(Output, 202u8);
    Output = Appendˉbyte(Output, 15u8);
    Output = Appendˉbyte(Output, 135u8);
    let Preserveˉrangeˉpatch: u32 = Bytesˉlength(Output);
    Output = Appendˉu32(Output, 0u32);
    return Descriptorˉreturnˉprefix(
        Output,
        Resetˉbelowˉpatch,
        Preserveˉoverflowˉpatch,
        Resetˉstartˉpatch,
        Resetˉendˉpatch,
        Internalˉpatch,
        Preserveˉrangeˉpatch
    );
}

fn Buildˉdescriptorˉreturnˉreset(
    Prefix: Descriptorˉreturnˉprefix,
    Hiddenˉslot: u32
) -> Descriptorˉreturnˉreset {
    var Output: bytes = Prefix.Output;
    let Reset: u32 = Bytesˉlength(Output);
    Output = Patchˉu32(
        Output,
        Prefix.Resetˉbelowˉpatch,
        Relativeˉu32(Reset, Prefix.Resetˉbelowˉpatch + 4u32)
    );
    Output = Patchˉu32(
        Output,
        Prefix.Resetˉstartˉpatch,
        Relativeˉu32(Reset, Prefix.Resetˉstartˉpatch + 4u32)
    );
    Output = Patchˉu32(
        Output,
        Prefix.Resetˉendˉpatch,
        Relativeˉu32(Reset, Prefix.Resetˉendˉpatch + 4u32)
    );
    Output = Loadˉeaxˉfield(Output, Hiddenˉslot);
    Output = Appendˉbyte(Output, 65u8);
    Output = Appendˉbyte(Output, 137u8);
    Output = Appendˉbyte(Output, 71u8);
    Output = Appendˉbyte(Output, 60u8);
    Output = Appendˉbyte(Output, 233u8);
    let Externalˉfromˉresetˉpatch: u32 = Bytesˉlength(Output);
    Output = Appendˉu32(Output, 0u32);
    return Descriptorˉreturnˉreset(
        Output,
        Prefix.Preserveˉoverflowˉpatch,
        Prefix.Internalˉpatch,
        Prefix.Preserveˉrangeˉpatch,
        Externalˉfromˉresetˉpatch
    );
}

fn Buildˉdescriptorˉreturnˉpreserve(
    Resetˉstate: Descriptorˉreturnˉreset,
    Sourceˉslot: u32,
    Hiddenˉslot: u32,
    Frameˉbytes: u32
) -> Descriptorˉreturnˉpreserve {
    var Output: bytes = Resetˉstate.Output;
    let Preserve: u32 = Bytesˉlength(Output);
    Output = Patchˉu32(
        Output,
        Resetˉstate.Preserveˉoverflowˉpatch,
        Relativeˉu32(Preserve, Resetˉstate.Preserveˉoverflowˉpatch + 4u32)
    );
    Output = Patchˉu32(
        Output,
        Resetˉstate.Preserveˉrangeˉpatch,
        Relativeˉu32(Preserve, Resetˉstate.Preserveˉrangeˉpatch + 4u32)
    );
    Output = Patchˉu32(
        Output,
        Resetˉstate.Externalˉfromˉresetˉpatch,
        Relativeˉu32(Preserve, Resetˉstate.Externalˉfromˉresetˉpatch + 4u32)
    );
    Output = Loadˉrdx(Output, Hiddenˉslot);
    Output = Loadˉrax(Output, Sourceˉslot);
    Output = Appendˉbyte(Output, 72u8);
    Output = Appendˉbyte(Output, 137u8);
    Output = Appendˉbyte(Output, 2u8);
    Output = Loadˉeaxˉfield(Output, Sourceˉslot);
    Output = Appendˉbyte(Output, 137u8);
    Output = Appendˉbyte(Output, 66u8);
    Output = Appendˉbyte(Output, 8u8);
    Output = Appendˉbyte(Output, 49u8);
    Output = Appendˉbyte(Output, 192u8);
    Output = Appendˉbyte(Output, 137u8);
    Output = Appendˉbyte(Output, 66u8);
    Output = Appendˉbyte(Output, 12u8);
    Output = Emitˉreturn(Output, Frameˉbytes);
    return Descriptorˉreturnˉpreserve(
        Output,
        Resetˉstate.Internalˉpatch,
        Preserve
    );
}

fn Buildˉdescriptorˉreturnˉinternal(
    State: Descriptorˉreturnˉpreserve,
    Sourceˉslot: u32,
    Hiddenˉslot: u32,
    Frameˉbytes: u32
) -> bytes {
    var Output: bytes = State.Output;
    let Internal: u32 = Bytesˉlength(Output);
    Output = Patchˉu32(
        Output,
        State.Internalˉpatch,
        Relativeˉu32(Internal, State.Internalˉpatch + 4u32)
    );
    Output = Loadˉeaxˉfield(Output, Hiddenˉslot);
    Output = Appendˉbyte(Output, 65u8);
    Output = Appendˉbyte(Output, 137u8);
    Output = Appendˉbyte(Output, 193u8);
    Output = Appendˉbyte(Output, 77u8);
    Output = Appendˉbyte(Output, 139u8);
    Output = Appendˉbyte(Output, 79u8);
    Output = Appendˉbyte(Output, 48u8);
    Output = Appendˉbyte(Output, 73u8);
    Output = Appendˉbyte(Output, 1u8);
    Output = Appendˉbyte(Output, 193u8);
    Output = Loadˉecxˉfield(Output, Sourceˉslot);
    Output = Appendˉbyte(Output, 137u8);
    Output = Appendˉbyte(Output, 194u8);
    Output = Appendˉbyte(Output, 1u8);
    Output = Appendˉbyte(Output, 202u8);
    Output = Appendˉbyte(Output, 15u8);
    Output = Appendˉbyte(Output, 130u8);
    let Internalˉoverflowˉpatch: u32 = Bytesˉlength(Output);
    Output = Appendˉu32(Output, 0u32);
    Output = Appendˉbyte(Output, 65u8);
    Output = Appendˉbyte(Output, 59u8);
    Output = Appendˉbyte(Output, 87u8);
    Output = Appendˉbyte(Output, 56u8);
    Output = Appendˉbyte(Output, 15u8);
    Output = Appendˉbyte(Output, 135u8);
    let Internalˉlimitˉpatch: u32 = Bytesˉlength(Output);
    Output = Appendˉu32(Output, 0u32);
    Output = Appendˉbyte(Output, 65u8);
    Output = Appendˉbyte(Output, 137u8);
    Output = Appendˉbyte(Output, 87u8);
    Output = Appendˉbyte(Output, 60u8);
    Output = Loadˉrax(Output, Sourceˉslot);
    Output = Appendˉbyte(Output, 133u8);
    Output = Appendˉbyte(Output, 201u8);
    Output = Appendˉbyte(Output, 15u8);
    Output = Appendˉbyte(Output, 132u8);
    let Copyˉendˉpatch: u32 = Bytesˉlength(Output);
    Output = Appendˉu32(Output, 0u32);
    let Copy: u32 = Bytesˉlength(Output);
    Output = Appendˉbyte(Output, 68u8);
    Output = Appendˉbyte(Output, 15u8);
    Output = Appendˉbyte(Output, 182u8);
    Output = Appendˉbyte(Output, 0u8);
    Output = Appendˉbyte(Output, 69u8);
    Output = Appendˉbyte(Output, 136u8);
    Output = Appendˉbyte(Output, 1u8);
    Output = Appendˉbyte(Output, 72u8);
    Output = Appendˉbyte(Output, 255u8);
    Output = Appendˉbyte(Output, 192u8);
    Output = Appendˉbyte(Output, 73u8);
    Output = Appendˉbyte(Output, 255u8);
    Output = Appendˉbyte(Output, 193u8);
    Output = Appendˉbyte(Output, 255u8);
    Output = Appendˉbyte(Output, 201u8);
    Output = Appendˉbyte(Output, 15u8);
    Output = Appendˉbyte(Output, 133u8);
    let Copyˉpatch: u32 = Bytesˉlength(Output);
    Output = Appendˉu32(Output, Relativeˉu32(Copy, Copyˉpatch + 4u32));
    let Copyˉend: u32 = Bytesˉlength(Output);
    Output = Patchˉu32(
        Output,
        Copyˉendˉpatch,
        Relativeˉu32(Copyˉend, Copyˉendˉpatch + 4u32)
    );
    Output = Loadˉeaxˉfield(Output, Hiddenˉslot);
    Output = Appendˉbyte(Output, 65u8);
    Output = Appendˉbyte(Output, 137u8);
    Output = Appendˉbyte(Output, 193u8);
    Output = Appendˉbyte(Output, 73u8);
    Output = Appendˉbyte(Output, 139u8);
    Output = Appendˉbyte(Output, 71u8);
    Output = Appendˉbyte(Output, 48u8);
    Output = Appendˉbyte(Output, 76u8);
    Output = Appendˉbyte(Output, 1u8);
    Output = Appendˉbyte(Output, 200u8);
    Output = Loadˉrdx(Output, Hiddenˉslot);
    Output = Appendˉbyte(Output, 72u8);
    Output = Appendˉbyte(Output, 137u8);
    Output = Appendˉbyte(Output, 2u8);
    Output = Loadˉeaxˉfield(Output, Sourceˉslot);
    Output = Appendˉbyte(Output, 137u8);
    Output = Appendˉbyte(Output, 66u8);
    Output = Appendˉbyte(Output, 8u8);
    Output = Appendˉbyte(Output, 49u8);
    Output = Appendˉbyte(Output, 192u8);
    Output = Appendˉbyte(Output, 137u8);
    Output = Appendˉbyte(Output, 66u8);
    Output = Appendˉbyte(Output, 12u8);
    Output = Emitˉreturn(Output, Frameˉbytes);
    Output = Patchˉu32(
        Output,
        Internalˉoverflowˉpatch,
        Relativeˉu32(State.Preserve, Internalˉoverflowˉpatch + 4u32)
    );
    Output = Patchˉu32(
        Output,
        Internalˉlimitˉpatch,
        Relativeˉu32(State.Preserve, Internalˉlimitˉpatch + 4u32)
    );
    return Output;
}

export fn Compilerˉnativeˉx64ˉemitˉdescriptorˉreturn(
    Result: bytes,
    Sourceˉslot: u32,
    Hiddenˉslot: u32,
    Frameˉbytes: u32
) -> bytes {
    let Prefix: Descriptorˉreturnˉprefix =
        Buildˉdescriptorˉreturnˉprefix(
            Result,
            Sourceˉslot,
            Hiddenˉslot
        );
    let Resetˉstate: Descriptorˉreturnˉreset =
        Buildˉdescriptorˉreturnˉreset(Prefix, Hiddenˉslot);
    let Preserveˉstate: Descriptorˉreturnˉpreserve =
        Buildˉdescriptorˉreturnˉpreserve(
            Resetˉstate,
            Sourceˉslot,
            Hiddenˉslot,
            Frameˉbytes
        );
    let Output: bytes = Buildˉdescriptorˉreturnˉinternal(
        Preserveˉstate,
        Sourceˉslot,
        Hiddenˉslot,
        Frameˉbytes
    );
    return Bytesˉconcat(Result, Output);
}
