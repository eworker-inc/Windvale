module Compilerˉnativeˉenumˉmetadata profile portable;

fn Empty(Input: bytes) -> bytes {
    return Bytesˉslice(Input, 0u32, 0u32);
}

fn Appendˉu32(Output: bytes, Value: u32) -> bytes {
    return Bytesˉconcat(Output, Bytesˉfromˉu32ˉlittle(Value));
}

fn Appendˉi32(Output: bytes, Value: i32) -> bytes {
    return Bytesˉconcat(Output, Bytesˉfromˉi32ˉlittle(Value));
}

fn Rangeˉisˉinside(Total: u32, Offset: u32, Length: u32) -> bool {
    if Offset > Total { return false; }
    return Length <= Total - Offset;
}

fn Asciiˉstart(Value: u32) -> bool {
    if Value == 95u32 { return true; }
    if Value >= 65u32 && Value <= 90u32 { return true; }
    if Value < 97u32 { return false; }
    if Value > 122u32 { return false; }
    return true;
}

fn Asciiˉpart(Value: u32) -> bool {
    if Asciiˉstart(Value) { return true; }
    if Value < 48u32 { return false; }
    if Value > 57u32 { return false; }
    return true;
}

fn Identifierˉisˉvalid(
    Input: bytes,
    Offset: u32,
    Length: u32
) -> bool {
    let Total: u32 = Bytesˉlength(Input);
    if Length == 0u32 || !Rangeˉisˉinside(Total, Offset, Length) {
        return false;
    }
    let End: u32 = Offset + Length;
    var Cursor: u32 = Offset;
    if !Asciiˉstart(U32ˉfromˉu8(Bytesˉreadˉu8(Input, Cursor))) { return false; }
    Cursor = Cursor + 1u32;
    while Cursor < End {
        let Value: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(Input, Cursor));
        if Asciiˉpart(Value) {
            Cursor = Cursor + 1u32;
        } else {
            if Value != 203u32 || Cursor + 2u32 >= End ||
                Bytesˉreadˉu8(Input, Cursor + 1u32) != 137u8 ||
                !Asciiˉstart(U32ˉfromˉu8(Bytesˉreadˉu8(Input, Cursor + 2u32))) {
                return false;
            }
            Cursor = Cursor + 2u32;
        }
    }
    return true;
}

fn Namesˉequal(
    Input: bytes,
    Leftˉoffset: u32,
    Leftˉlength: u32,
    Rightˉoffset: u32,
    Rightˉlength: u32
) -> bool {
    if Leftˉlength != Rightˉlength { return false; }
    var Index: u32 = 0u32;
    while Index < Leftˉlength {
        if Bytesˉreadˉu8(Input, Leftˉoffset + Index) !=
            Bytesˉreadˉu8(Input, Rightˉoffset + Index) {
            return false;
        }
        Index = Index + 1u32;
    }
    return true;
}

fn Requestˉisˉvalid(Input: bytes) -> bool {
    let Total: u32 = Bytesˉlength(Input);
    if Total < 24u32 || Bytesˉreadˉu32ˉlittle(Input, 0u32) != 1363498583u32 ||
        Bytesˉreadˉu32ˉlittle(Input, 4u32) != 1u32 ||
        Bytesˉreadˉu32ˉlittle(Input, 8u32) != Total ||
        Bytesˉreadˉu32ˉlittle(Input, 20u32) != 24u32 {
        return false;
    }

    let Typeˉcount: u32 = Bytesˉreadˉu32ˉlittle(Input, 12u32);
    let Memberˉcount: u32 = Bytesˉreadˉu32ˉlittle(Input, 16u32);
    if Typeˉcount == 0u32 || Typeˉcount > 1024u32 ||
        Memberˉcount == 0u32 || Memberˉcount > Typeˉcount * 256u32 {
        return false;
    }
    let Memberˉoffset: u32 = 24u32 + Typeˉcount * 8u32;
    let Nameˉoffset: u32 = Memberˉoffset + Memberˉcount * 12u32;
    let Outputˉnameˉoffset: u32 = Memberˉoffset + Memberˉcount * 16u32;
    if Nameˉoffset > Total || Outputˉnameˉoffset > 4194304u32 ||
        Total - Nameˉoffset > 4194304u32 - Outputˉnameˉoffset {
        return false;
    }

    var Currentˉmember: u32 = 0u32;
    var Currentˉname: u32 = Nameˉoffset;
    var Type: u32 = 0u32;
    while Type < Typeˉcount {
        let Directory: u32 = 24u32 + Type * 8u32;
        let Kind: u32 = Bytesˉreadˉu32ˉlittle(Input, Directory);
        let Count: u32 = Bytesˉreadˉu32ˉlittle(Input, Directory + 4u32);
        if (Kind == 0u32 && Count != 0u32) ||
            (Kind == 1u32 && (Count == 0u32 || Count > 256u32)) ||
            Kind > 1u32 || Count > Memberˉcount - Currentˉmember {
            return false;
        }

        var Member: u32 = 0u32;
        while Member < Count {
            let Entry: u32 = Memberˉoffset + (Currentˉmember + Member) * 12u32;
            let Value: i32 = Bytesˉreadˉi32ˉlittle(Input, Entry);
            let Nameˉstart: u32 = Bytesˉreadˉu32ˉlittle(Input, Entry + 4u32);
            let Nameˉlength: u32 = Bytesˉreadˉu32ˉlittle(Input, Entry + 8u32);
            if Nameˉstart != Currentˉname || Nameˉlength == 0u32 ||
                Nameˉlength > 255u32 ||
                !Identifierˉisˉvalid(Input, Nameˉstart, Nameˉlength) {
                return false;
            }

            var Prior: u32 = 0u32;
            while Prior < Member {
                let Priorˉentry: u32 =
                    Memberˉoffset + (Currentˉmember + Prior) * 12u32;
                let Priorˉname: u32 =
                    Bytesˉreadˉu32ˉlittle(Input, Priorˉentry + 4u32);
                let Priorˉlength: u32 =
                    Bytesˉreadˉu32ˉlittle(Input, Priorˉentry + 8u32);
                if Bytesˉreadˉi32ˉlittle(Input, Priorˉentry) == Value ||
                    Namesˉequal(
                        Input,
                        Priorˉname,
                        Priorˉlength,
                        Nameˉstart,
                        Nameˉlength
                    ) {
                    return false;
                }
                Prior = Prior + 1u32;
            }
            Currentˉname = Currentˉname + Nameˉlength;
            Member = Member + 1u32;
        }
        Currentˉmember = Currentˉmember + Count;
        Type = Type + 1u32;
    }
    if Currentˉmember != Memberˉcount { return false; }
    return Currentˉname == Total;
}

export fn Nativeˉenumˉmetadataˉbuild(Input: bytes) -> bytes {
    if !Requestˉisˉvalid(Input) { return Empty(Input); }

    let Total: u32 = Bytesˉlength(Input);
    let Typeˉcount: u32 = Bytesˉreadˉu32ˉlittle(Input, 12u32);
    let Memberˉcount: u32 = Bytesˉreadˉu32ˉlittle(Input, 16u32);
    let Memberˉoffset: u32 = 24u32 + Typeˉcount * 8u32;
    let Requestˉnameˉoffset: u32 = Memberˉoffset + Memberˉcount * 12u32;
    let Outputˉnameˉoffset: u32 = Memberˉoffset + Memberˉcount * 16u32;
    let Outputˉbytes: u32 = Outputˉnameˉoffset + Total - Requestˉnameˉoffset;

    var Output: bytes = Empty(Input);
    Output = Appendˉu32(Output, 1313166935u32);
    Output = Appendˉu32(Output, 1u32);
    Output = Appendˉu32(Output, Outputˉbytes);
    Output = Appendˉu32(Output, Typeˉcount);
    Output = Appendˉu32(Output, Memberˉcount);
    Output = Appendˉu32(Output, 24u32);

    var Currentˉmember: u32 = 0u32;
    var Type: u32 = 0u32;
    while Type < Typeˉcount {
        let Count: u32 = Bytesˉreadˉu32ˉlittle(
            Input,
            24u32 + Type * 8u32 + 4u32
        );
        Output = Appendˉu32(Output, Currentˉmember);
        Output = Appendˉu32(Output, Count);
        Currentˉmember = Currentˉmember + Count;
        Type = Type + 1u32;
    }

    var Member: u32 = 0u32;
    while Member < Memberˉcount {
        let Entry: u32 = Memberˉoffset + Member * 12u32;
        let Requestˉname: u32 = Bytesˉreadˉu32ˉlittle(Input, Entry + 4u32);
        Output = Appendˉi32(Output, Bytesˉreadˉi32ˉlittle(Input, Entry));
        Output = Appendˉu32(
            Output,
            Outputˉnameˉoffset + Requestˉname - Requestˉnameˉoffset
        );
        Output = Appendˉu32(Output, Bytesˉreadˉu32ˉlittle(Input, Entry + 8u32));
        Output = Appendˉu32(Output, 0u32);
        Member = Member + 1u32;
    }
    return Bytesˉconcat(
        Output,
        Bytesˉslice(Input, Requestˉnameˉoffset, Total - Requestˉnameˉoffset)
    );
}
