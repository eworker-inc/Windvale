module Compilerˉnativeˉx64ˉloweringˉtool profile hosted;

import Compilerˉnativeˉx64ˉlowering as Nativeˉx64;
import Compilerˉnativeˉx64ˉloweringˉmetadata as Metadataˉreader;

capability console.write_line;
capability diagnostic.write_line;
capability file.read_bytes;
capability file.write_bytes;
capability process.argument;
capability process.argument_count;

export fn Main() -> i32 {
    if process.argument_count() != 2u32 {
        diagnostic.write_line("Usage: wvnative <input.wvb> <output.wvo>");
        return 2;
    }
    let Input: bytes = file.read_bytes(process.argument(0u32));
    let Normalized: bytes =
        Metadataˉreader.Compilerˉnativeˉx64ˉmetadataˉnormalize(Input);
    var Loweringˉinput: bytes = Input;
    if Bytesˉlength(Normalized) != 0u32 { Loweringˉinput = Normalized; }
    let Summary: Nativeˉx64.Compilerˉnativeˉx64ˉsummary =
        Nativeˉx64.Compilerˉlowerˉwvbˉnativeˉx64(Loweringˉinput);
    if Summary.Status != Nativeˉx64.Compilerˉnativeˉx64ˉstatus.Valid {
        let Plan: Nativeˉx64.Compilerˉnativeˉx64ˉplan =
            Nativeˉx64.Compilerˉnativeˉx64ˉplanˉbuild(Loweringˉinput);
        var Failureˉreport: text = Textˉconcat(
            "native x64 status=", Enumˉname(Summary.Status)
        );
        Failureˉreport = Textˉconcat(Failureˉreport, " plan-status=");
        Failureˉreport = Textˉconcat(Failureˉreport, Enumˉname(Plan.Status));
        Failureˉreport = Textˉconcat(Failureˉreport, " function=");
        Failureˉreport = Textˉconcat(
            Failureˉreport, U32ˉformat(Plan.Failureˉfunction)
        );
        Failureˉreport = Textˉconcat(Failureˉreport, " detail=");
        Failureˉreport = Textˉconcat(
            Failureˉreport, U32ˉformat(Plan.Failureˉdetail)
        );
        diagnostic.write_line(Failureˉreport);
        return 1;
    }
    file.write_bytes(process.argument(1u32), Summary.Object);
    var Report: text = "native x64 status=Valid abi=";
    Report = Textˉconcat(Report, U32ˉformat(Summary.Abi));
    Report = Textˉconcat(Report, " code-bytes=");
    Report = Textˉconcat(Report, U32ˉformat(Summary.Codeˉbytes));
    Report = Textˉconcat(Report, " object-bytes=");
    Report = Textˉconcat(Report, U32ˉformat(Bytesˉlength(Summary.Object)));
    console.write_line(Report);
    return 0;
}
