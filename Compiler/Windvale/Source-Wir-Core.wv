export fn Compilerˉsourceˉwirˉblockˉplaceholder(Input: bytes) -> bytes {
    var Result: bytes = Compilerˉsourceˉwirˉempty(Input);
    var Field: u32 = 0u32;
    while Field < 7u32 {
        Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(0u32));
        Field = Field + 1u32;
    }
    return Result;
}

fn Compilerˉsourceˉwirˉchunkedˉpayloadˉlength(
    Complete: bytes,
    Pending: bytes
) -> u32 {
    return Bytesˉlength(Complete) + Bytesˉlength(Pending);
}

fn Compilerˉsourceˉwirˉchunkedˉpayloadˉmaterialize(
    Complete: bytes,
    Pending: bytes
) -> bytes {
    if Bytesˉlength(Pending) == 0u32 {
        return Complete;
    }
    return Bytesˉconcat(Complete, Pending);
}

fn Compilerˉsourceˉwirˉchunkedˉpayloadˉappend(
    Complete: bytes,
    Pending: bytes,
    Entry: bytes,
    Pendingˉlimit: u32
) -> Compilerˉsourceˉwirˉchunkedˉpayload {
    let Entryˉbytes: u32 = Bytesˉlength(Entry);
    if Entryˉbytes > Pendingˉlimit {
        return Compilerˉsourceˉwirˉchunkedˉpayload(
            Bytesˉconcat(
                Compilerˉsourceˉwirˉchunkedˉpayloadˉmaterialize(
                    Complete, Pending
                ),
                Entry
            ),
            Bytesˉslice(Entry, 0u32, 0u32)
        );
    }
    if Bytesˉlength(Pending) > Pendingˉlimit - Entryˉbytes {
        return Compilerˉsourceˉwirˉchunkedˉpayload(
            Bytesˉconcat(Complete, Pending), Entry
        );
    }
    return Compilerˉsourceˉwirˉchunkedˉpayload(
        Complete, Bytesˉconcat(Pending, Entry)
    );
}

export fn Compilerˉsourceˉwirˉstartˉfunction(
