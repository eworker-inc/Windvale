        Sourceˉsymbols.Compilerˉsourceˉsymbolsˉtypeˉshape(Abiˉtype);
    let Firstˉenum: u32 = 131072u32 + Symbols.Records;
    if Abiˉtype.Status !=
            Sourceˉsymbols.Compilerˉsourceˉsymbolˉstatus.Valid ||
        Abiˉtype.Nextˉoffset != Expression.Firstˉoffset +
            Expression.Firstˉlength ||
        Abiˉshape < Firstˉenum ||
        Abiˉshape >= Firstˉenum + Symbols.Enums {
        return Compilerˉsourceˉwirˉfailureˉvalue(
            Build, Compilerˉsourceˉwirˉstatus.Genericˉresolution,
            Callable.Module, Expression.Firstˉoffset,
            Abiˉposition.Line, Abiˉposition.Column
        );
    }
    let Scratchˉargument: Compilerˉsourceˉwirˉtaskˉargument =
        Compilerˉsourceˉwirˉtaskˉargumentˉat(
            Source, Expression, 0u32, "Scratch"
        );
    if !Scratchˉargument.Found || Scratchˉargument.Mode !=
            Sourceˉdeclarations.COMPILER_SOURCE_BORROW_MODE_IMMUTABLE {
        return Compilerˉsourceˉwirˉfailureˉvalue(
            Build, Compilerˉsourceˉwirˉstatus.Invalidˉborrow,
            Callable.Module, Expression.Offset, Expression.Line,
            Expression.Column
        );
    }
    let Scratchˉexpression: Sourceˉbodies.Compilerˉsourceˉexpression =
        Sourceˉbodies.Compilerˉparseˉexpressionˉvalidated(
            Source, Scratchˉargument.Valueˉoffset,
            Scratchˉargument.Valueˉline, Scratchˉargument.Valueˉcolumn,
            Scratchˉargument.Valueˉoffset + Scratchˉargument.Valueˉlength,
            0u32, 0u32
        );
    if Scratchˉexpression.Kind !=
            Sourceˉbodies.Compilerˉsourceˉexpressionˉkind.Name {
        return Compilerˉsourceˉwirˉfailureˉvalue(
            Build, Compilerˉsourceˉwirˉstatus.Invalidˉargument,
            Callable.Module, Scratchˉexpression.Offset,
            Scratchˉexpression.Line, Scratchˉexpression.Column
        );
    }
    let Scratch: Sourceˉbindings.Compilerˉsourceˉlocalˉmatch =
        Sourceˉbindings.Compilerˉsourceˉbindingsˉfindˉlocal(
            Source, Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
            Scratchˉexpression.Valueˉoffset,
            Scratchˉexpression.Valueˉlength, Scratchˉexpression.Offset
        );
    let Catalog: Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog =
