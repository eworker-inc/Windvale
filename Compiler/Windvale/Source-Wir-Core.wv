fn Compilerˉsourceˉwirˉscanˉgenericˉtype(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Module: u32,
    Source: bytes,
    Offset: u32,
    Line: u32,
    Column: u32,
    Allowˉvoid: bool,
    Catalog: Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog
) -> Compilerˉsourceˉwirˉgenericˉtypeˉscan {
    let Ordinary: Sourceˉsymbols.Compilerˉsourceˉtypeˉbinding =
        Sourceˉsymbols.Compilerˉsourceˉsymbolsˉbindˉtype(
            Input, Scan, Symbols.Directory, Symbols.Lookup,
            Symbols.Visibility, Module, Source, Offset, Line, Column,
            Symbols.Records, Symbols.Enums, Allowˉvoid
        );
    if Ordinary.Status !=
            Sourceˉsymbols.Compilerˉsourceˉsymbolˉstatus.Unknownˉtype {
        return Compilerˉsourceˉwirˉgenericˉtypeˉscan(
            Ordinary.Status,
            Sourceˉgenerics.Compilerˉsourceˉgenericˉstatus.Valid,
            Sourceˉsymbols.Compilerˉsourceˉsymbolsˉtypeˉshape(Ordinary),
            Catalog.Evidence,
            Ordinary.Nextˉoffset, Ordinary.Nextˉline, Ordinary.Nextˉcolumn,
            Module,
            Ordinary.Failureˉoffset,
            Ordinary.Failureˉline,
            Ordinary.Failureˉcolumn
        );
    }
    let General:
        Genericˉtypeˉbinding.Compilerˉsourceˉgenericˉtypeˉbinding =
        Genericˉtypeˉbinding.Compilerˉsourceˉgenericˉtypeˉbind(
            Input, Scan, Symbols, Module, Source,
            Offset, Line, Column, Catalog
        );
    return Compilerˉsourceˉwirˉgenericˉtypeˉscan(
        General.Status, General.Genericˉstatus, General.Shape,
        General.Catalogˉevidence,
        General.Nextˉoffset, General.Nextˉline, General.Nextˉcolumn,
        Module,
        General.Failureˉoffset, General.Failureˉline, General.Failureˉcolumn
    );
}

fn Compilerˉsourceˉwirˉscanˉgenericˉfunctionˉsignature(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Module: u32,
    Source: bytes,
    Declaration: Sourceˉdeclarations.Compilerˉsourceˉdeclaration,
    Declarationˉline: u32,
    Declarationˉcolumn: u32,
    Catalog: Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog
) -> Compilerˉsourceˉwirˉgenericˉtypeˉscan {
    let Generic: Sourceˉsymbols.Compilerˉsourceˉfunctionˉgeneric =
        Sourceˉsymbols.Compilerˉsourceˉsymbolsˉfunctionˉgeneric(
            Source, Declaration, Declarationˉline, Declarationˉcolumn
        );
    if Generic.Parameters > 0u32 {
        return Compilerˉsourceˉwirˉgenericˉtypeˉscan(
            Sourceˉsymbols.Compilerˉsourceˉsymbolˉstatus.Valid,
            Sourceˉgenerics.Compilerˉsourceˉgenericˉstatus.Valid,
            0u32, Catalog.Evidence,
            Declaration.Nextˉoffset, Declaration.Nextˉline,
            Declaration.Nextˉcolumn,
            Module, Declaration.Nextˉoffset,
            Declaration.Nextˉline, Declaration.Nextˉcolumn
        );
    }
    let Left: Sourceˉlexer.Compilerˉsourceˉtoken =
        Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Source, Generic.Signatureˉoffset,
            Generic.Signatureˉline, Generic.Signatureˉcolumn
        );
    var Cursor: u32 = Left.Nextˉoffset;
    var Currentˉline: u32 = Left.Nextˉline;
    var Currentˉcolumn: u32 = Left.Nextˉcolumn;
    var Working: Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog = Catalog;
    var Index: u32 = 0u32;
    while Index < Declaration.Items {
        let Parameter: Sourceˉlexer.Compilerˉsourceˉtoken =
            Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                Source, Cursor, Currentˉline, Currentˉcolumn
            );
        let Colon: Sourceˉlexer.Compilerˉsourceˉtoken =
            Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                Source, Parameter.Nextˉoffset,
                Parameter.Nextˉline, Parameter.Nextˉcolumn
            );
        let Type: Compilerˉsourceˉwirˉgenericˉtypeˉscan =
            Compilerˉsourceˉwirˉscanˉgenericˉtype(
                Input, Scan, Symbols, Module, Source,
                Colon.Nextˉoffset, Colon.Nextˉline, Colon.Nextˉcolumn,
                false, Working
            );
        if Type.Status !=
                Sourceˉsymbols.Compilerˉsourceˉsymbolˉstatus.Valid {
            return Type;
        }
        Working = Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog(
            Sourceˉgenerics.Compilerˉsourceˉgenericˉstatus.Valid,
            Type.Evidence
        );
        let Separator: Sourceˉlexer.Compilerˉsourceˉtoken =
            Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                Source, Type.Nextˉoffset, Type.Nextˉline, Type.Nextˉcolumn
            );
        if Separator.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Comma {
            Cursor = Separator.Nextˉoffset;
            Currentˉline = Separator.Nextˉline;
            Currentˉcolumn = Separator.Nextˉcolumn;
        } else {
            Cursor = Separator.Offset;
            Currentˉline = Separator.Line;
            Currentˉcolumn = Separator.Column;
        }
        Index = Index + 1u32;
    }
    let Right: Sourceˉlexer.Compilerˉsourceˉtoken =
        Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Source, Cursor, Currentˉline, Currentˉcolumn
        );
    let Arrow: Sourceˉlexer.Compilerˉsourceˉtoken =
        Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Source, Right.Nextˉoffset, Right.Nextˉline, Right.Nextˉcolumn
        );
    return Compilerˉsourceˉwirˉscanˉgenericˉtype(
        Input, Scan, Symbols, Module, Source,
        Arrow.Nextˉoffset, Arrow.Nextˉline, Arrow.Nextˉcolumn,
        true, Working
    );
}

fn Compilerˉsourceˉwirˉhasˉgenericˉnominalˉdeclaration(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary
) -> bool {
    let Entries: u32 = Bytesˉreadˉu32ˉlittle(Symbols.Directory, 8u32);
    var Index: u32 = 0u32;
    while Index < Entries {
        let Entry: u32 = 16u32 + Index * 24u32;
        let Kind: u32 = Bytesˉreadˉu32ˉlittle(
            Symbols.Directory, Entry + 4u32
        );
        if Kind == 4u32 || Kind == 8u32 {
            let Module: u32 = Bytesˉreadˉu32ˉlittle(
                Symbols.Directory, Entry
            );
            let View: Sourceˉset.Compilerˉsourceˉsetˉview =
                Sourceˉset.Compilerˉsourceˉsetˉmodule(
                    Input, Scan, Module
                );
            let Afterˉname: Sourceˉlexer.Compilerˉsourceˉtoken =
                Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                    View.Source,
                    Bytesˉreadˉu32ˉlittle(
                        Symbols.Directory, Entry + 12u32
                    ) + Bytesˉreadˉu32ˉlittle(
                        Symbols.Directory, Entry + 16u32
                    ),
                    1u32, 1u32
                );
            if Afterˉname.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Less {
                return true;
            }
        }
        Index = Index + 1u32;
    }
    return false;
}

fn Compilerˉsourceˉwirˉscanˉgenericˉsignatures(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary
) -> Compilerˉsourceˉwirˉgenericˉtypeˉscan {
    var Catalog: Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog =
        Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalogˉempty();
    var Last: Compilerˉsourceˉwirˉgenericˉtypeˉscan =
        Compilerˉsourceˉwirˉgenericˉtypeˉscan(
            Sourceˉsymbols.Compilerˉsourceˉsymbolˉstatus.Valid,
            Sourceˉgenerics.Compilerˉsourceˉgenericˉstatus.Valid,
            0u32, Catalog.Evidence,
            0u32, 1u32, 1u32, 0u32, 0u32, 1u32, 1u32
        );
    if !Compilerˉsourceˉwirˉhasˉgenericˉnominalˉdeclaration(
        Input, Scan, Symbols
    ) {
        return Last;
    }
    var Module: u32 = 0u32;
    while Module < Scan.Modules {
        let View: Sourceˉset.Compilerˉsourceˉsetˉview =
            Sourceˉset.Compilerˉsourceˉsetˉmodule(Input, Scan, Module);
        let Header: Sourceˉdeclarations.Compilerˉsourceˉheader =
            Sourceˉdeclarations.Compilerˉparseˉheaderˉvalidated(View.Source);
        var Cursor: u32 = Header.Nextˉoffset;
        var Currentˉline: u32 = Header.Nextˉline;
        var Currentˉcolumn: u32 = Header.Nextˉcolumn;
        var Sawˉnonˉimport: bool = false;
        var Reading: bool = true;
        while Reading {
            let Declaration:
                Sourceˉdeclarations.Compilerˉsourceˉdeclaration =
                Sourceˉdeclarations.Compilerˉparseˉnextˉdeclarationˉvalidated(
                    View.Source, Cursor, Currentˉline, Currentˉcolumn,
                    Sawˉnonˉimport
                );
            if Declaration.Kind ==
                    Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.End {
                Reading = false;
            } else {
                if Declaration.Kind ==
                        Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Function {
                    let Position: Sourceˉbodies.Compilerˉsourceˉposition =
                        Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
                            View.Source, Cursor, Currentˉline, Currentˉcolumn,
                            Declaration.Declarationˉoffset
                        );
                    Last = Compilerˉsourceˉwirˉscanˉgenericˉfunctionˉsignature(
                        Input, Scan, Symbols, Module, View.Source,
                        Declaration, Position.Line, Position.Column, Catalog
                    );
                    if Last.Status !=
                            Sourceˉsymbols.Compilerˉsourceˉsymbolˉstatus.Valid {
                        return Last;
                    }
                    Catalog = Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog(
                        Sourceˉgenerics.Compilerˉsourceˉgenericˉstatus.Valid,
                        Last.Evidence
                    );
                }
                if Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉclosesˉimports(
                        Declaration
                    ) {
                    Sawˉnonˉimport = true;
                }
                Cursor = Declaration.Nextˉoffset;
                Currentˉline = Declaration.Nextˉline;
                Currentˉcolumn = Declaration.Nextˉcolumn;
            }
        }
        Module = Module + 1u32;
    }
    return Compilerˉsourceˉwirˉgenericˉtypeˉscan(
        Sourceˉsymbols.Compilerˉsourceˉsymbolˉstatus.Valid,
        Sourceˉgenerics.Compilerˉsourceˉgenericˉstatus.Valid,
        Last.Shape, Catalog.Evidence,
        Last.Nextˉoffset, Last.Nextˉline, Last.Nextˉcolumn,
        Scan.Modules, Last.Failureˉoffset,
        Last.Failureˉline, Last.Failureˉcolumn
    );
}

fn Compilerˉprepareˉsourceˉwirˉbuildˉwithˉsymbols(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary
) -> Compilerˉsourceˉwirˉbuild {
    let Emptyˉcatalog: Sourceˉgenerics.Compilerˉsourceˉgenericˉcatalog =
        Sourceˉgenerics.Compilerˉsourceˉgenericˉcatalogˉempty();
    let Typeˉscan: Compilerˉsourceˉwirˉgenericˉtypeˉscan =
        Compilerˉsourceˉwirˉscanˉgenericˉsignatures(
            Input, Scan, Symbols
        );
    let Typeˉcatalog: Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog =
        Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog(
            Sourceˉgenerics.Compilerˉsourceˉgenericˉstatus.Valid,
            Typeˉscan.Evidence
        );
    let Initialˉevidence: bytes = Compilerˉsourceˉwirˉgenericˉevidence(
        Emptyˉcatalog, Typeˉcatalog
    );
    if Typeˉscan.Status !=
            Sourceˉsymbols.Compilerˉsourceˉsymbolˉstatus.Valid {
        return Compilerˉsourceˉwirˉbuildˉfailure(
            Compilerˉsourceˉwirˉbuildˉempty(
                Input, Scan.Modules, Symbols.Functions, Initialˉevidence
            ),
            Compilerˉsourceˉwirˉstatus.Genericˉresolution,
            Typeˉscan.Failureˉmodule,
            Typeˉscan.Failureˉmodule,
            Symbols.Functions,
            Typeˉscan.Failureˉoffset,
            Typeˉscan.Failureˉline,
            Typeˉscan.Failureˉcolumn
        );
    }
    var Build: Compilerˉsourceˉwirˉbuild = Compilerˉsourceˉwirˉphase(
        Input, Scan, Symbols, Initialˉevidence, true
    );
    if Build.Status == Compilerˉsourceˉwirˉstatus.Valid {
        var Catalog: Sourceˉgenerics.Compilerˉsourceˉgenericˉcatalog =
            Compilerˉsourceˉwirˉgenericˉcatalog(
                Build.Genericˉevidence
            );
        var Priorˉinstances: u32 =
            Sourceˉgenerics.Compilerˉsourceˉgenericˉcatalogˉinstances(Catalog);
        if Priorˉinstances > 0u32 {
            Build = Compilerˉsourceˉwirˉphase(
                Input, Scan, Symbols, Build.Genericˉevidence, false
            );
            var Iterations: u32 = 1u32;
            var Resolving: bool = Build.Status == Compilerˉsourceˉwirˉstatus.Valid &&
                Sourceˉgenerics.Compilerˉsourceˉgenericˉcatalogˉinstances(
                    Compilerˉsourceˉwirˉgenericˉcatalog(
                        Build.Genericˉevidence
                    )
                ) > Priorˉinstances;
            while Resolving {
                if Iterations >= 32u32 {
                    Build = Compilerˉsourceˉwirˉbuildˉfailure(
                        Build,
                        Compilerˉsourceˉwirˉstatus.Genericˉiterationˉlimit,
                        Build.Currentˉmodule, Build.Currentˉmodule,
                        Build.Currentˉfunction,
                        Build.Failureˉoffset,
                        Build.Failureˉline,
                        Build.Failureˉcolumn
                    );
                    Resolving = false;
                } else {
                    Catalog = Compilerˉsourceˉwirˉgenericˉcatalog(
                        Build.Genericˉevidence
                    );
                    Priorˉinstances = Sourceˉgenerics.Compilerˉsourceˉgenericˉcatalogˉinstances(
                        Catalog
                    );
                    Build = Compilerˉsourceˉwirˉphase(
                        Input, Scan, Symbols, Build.Genericˉevidence, false
                    );
                    Iterations = Iterations + 1u32;
                    Resolving = Build.Status == Compilerˉsourceˉwirˉstatus.Valid &&
                        Sourceˉgenerics.Compilerˉsourceˉgenericˉcatalogˉinstances(
                            Compilerˉsourceˉwirˉgenericˉcatalog(
                                Build.Genericˉevidence
                            )
                        ) > Priorˉinstances;
                }
            }
        }
    }
    return Build;
}

fn Compilerˉprepareˉsourceˉwirˉfailureˉwithˉsymbols(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Build: Compilerˉsourceˉwirˉbuild
) -> Compilerˉsourceˉwirˉcompilation {
    if Build.Status != Compilerˉsourceˉwirˉstatus.Valid {
        if Build.Status != Compilerˉsourceˉwirˉstatus.Sourceˉbindings {
            let Partialˉbindings:
                Sourceˉbindings.Compilerˉsourceˉbindingˉsummary =
                Sourceˉbindings.Compilerˉsourceˉbindingsˉsummaryˉfromˉbuild(
                    Input, Symbols,
                    Sourceˉbindings.Compilerˉsourceˉbindingsˉphaseˉbuildˉvalue(
                        Compilerˉsourceˉwirˉbuildˉbindings(Input, Build)
                    )
                );
            return Compilerˉsourceˉwirˉcompilationˉfromˉbuild(
                Input, Partialˉbindings, Build
            );
        }
        let Localˉbindings: Sourceˉbindings.Compilerˉsourceˉbindingˉsummary =
            Sourceˉbindings.Compilerˉsourceˉbindingsˉlocalsˉfromˉsymbols(
                Input, Scan, Symbols
            );
        if Localˉbindings.Status != Sourceˉbindings.Compilerˉsourceˉbindingˉstatus.Valid {
            return Compilerˉsourceˉwirˉcompilationˉfromˉbindings(
                Input, Localˉbindings
            );
        }
        let Completeˉbindings: Sourceˉbindings.Compilerˉsourceˉbindingˉsummary = Sourceˉbindings.Compilerˉsourceˉbindingsˉfromˉsymbols(
            Input, Scan, Symbols
        );
        if Completeˉbindings.Status != Sourceˉbindings.Compilerˉsourceˉbindingˉstatus.Valid {
            return Compilerˉsourceˉwirˉcompilationˉfromˉbindings(
                Input, Completeˉbindings
            );
        }
        return Compilerˉsourceˉwirˉcompilationˉfromˉbuild(
            Input, Localˉbindings, Build
        );
    }
    let Unexpected: Sourceˉbindings.Compilerˉsourceˉbindingˉsummary =
        Sourceˉbindings.Compilerˉsourceˉbindingsˉsummaryˉfromˉbuild(
            Input, Symbols,
            Sourceˉbindings.Compilerˉsourceˉbindingsˉphaseˉbuildˉvalue(
                Compilerˉsourceˉwirˉbuildˉbindings(Input, Build)
            )
        );
    return Compilerˉsourceˉwirˉcompilationˉfromˉbuild(
        Input, Unexpected, Build
    );
}

fn Compilerˉprepareˉsourceˉwirˉproductˉfailureˉwithˉsymbols(
    Input: bytes,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Build: Compilerˉsourceˉwirˉbuild
) -> Compilerˉsourceˉwirˉcompilation {
    if Build.Status == Compilerˉsourceˉwirˉstatus.Sourceˉbindings {
        let Bindingˉfailure:
            Sourceˉbindings.Compilerˉsourceˉbindingˉsummary =
            Sourceˉbindings.Compilerˉsourceˉbindingˉsummary(
                Compilerˉsourceˉwirˉbindingˉfailureˉstatus(
                    Build.Failureˉrelatedˉmodule
                ),
                Symbols.Status,
                Symbols.Modules,
                Symbols.Functions,
                Build.Bindingˉparameters,
                Build.Bindingˉlocals,
                0u32, 0u32, 0u32,
                Compilerˉsourceˉwirˉempty(Input),
                Build.Failureˉmodule,
                Build.Failureˉrelatedˉmodule % 64u32,
                Build.Failureˉfunction,
                Build.Failureˉoffset,
                Build.Failureˉline,
                Build.Failureˉcolumn
            );
        return Compilerˉsourceˉwirˉcompilationˉfromˉbindings(
            Input, Bindingˉfailure
        );
    }
    let Partialˉbindings: Sourceˉbindings.Compilerˉsourceˉbindingˉsummary =
        Sourceˉbindings.Compilerˉsourceˉbindingsˉsummaryˉfromˉbuild(
            Input, Symbols,
            Sourceˉbindings.Compilerˉsourceˉbindingsˉphaseˉbuildˉvalue(
                Compilerˉsourceˉwirˉbuildˉbindings(Input, Build)
            )
        );
    return Compilerˉsourceˉwirˉcompilationˉfromˉbuild(
        Input, Partialˉbindings, Build
    );
}

fn Compilerˉprepareˉsourceˉwirˉwithˉsymbolsˉmode(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Validate: bool
) -> Compilerˉsourceˉwirˉcompilation {
    if Symbols.Status != Sourceˉsymbols.Compilerˉsourceˉsymbolˉstatus.Valid {
        let Failedˉbindings: Sourceˉbindings.Compilerˉsourceˉbindingˉsummary = Sourceˉbindings.Compilerˉsourceˉbindingsˉsummaryˉfromˉsymbols(
            Input, Symbols
        );
        return Compilerˉsourceˉwirˉcompilationˉfromˉbindings(
            Input, Failedˉbindings
        );
    }
    var Build: Compilerˉsourceˉwirˉbuild =
        Compilerˉprepareˉsourceˉwirˉbuildˉwithˉsymbols(
            Input, Scan, Symbols
        );
    if Build.Status != Compilerˉsourceˉwirˉstatus.Valid {
        return Compilerˉprepareˉsourceˉwirˉfailureˉwithˉsymbols(
            Input, Scan, Symbols, Build
        );
    }
    let Finalˉcatalog: Sourceˉgenerics.Compilerˉsourceˉgenericˉcatalog =
        Compilerˉsourceˉwirˉgenericˉcatalog(Build.Genericˉevidence);
    let Finalˉtypeˉcatalog:
        Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog =
        Compilerˉsourceˉwirˉgenericˉtypeˉcatalog(Build.Genericˉevidence);
    let Bindings: Sourceˉbindings.Compilerˉsourceˉbindingˉsummary =
        Genericˉbindings.Compilerˉsourceˉbindingsˉgenericˉtypesˉfinishˉspecializedˉphase(
            Input, Scan, Symbols,
            Compilerˉsourceˉwirˉbuildˉbindings(Input, Build),
            Build.Functionˉentries, Finalˉcatalog, Finalˉtypeˉcatalog, Validate
        );
    if Bindings.Status != Sourceˉbindings.Compilerˉsourceˉbindingˉstatus.Valid {
        return Compilerˉsourceˉwirˉcompilationˉfromˉbindings(Input, Bindings);
    }
    if !Compilerˉsourceˉwirˉevidenceˉfits(Build) {
        Build = Compilerˉsourceˉwirˉbuildˉfailure(
            Build,
            Compilerˉsourceˉwirˉstatus.Evidenceˉlimit,
            Bindings.Modules,
            Bindings.Modules,
            Build.Functionˉentries,
            Bytesˉlength(Input),
            0u32,
            0u32
        );
        return Compilerˉsourceˉwirˉcompilationˉfromˉbuild(Input, Bindings, Build);
    }
    let Directory: bytes = Compilerˉsourceˉwirˉdirectory(Build);
    if Validate && !Compilerˉsourceˉwirˉdirectoryˉisˉvalid(
        Input, Scan, Symbols, Bindings, Directory
    ) {
        Build = Compilerˉsourceˉwirˉbuildˉfailure(
            Build,
            Compilerˉsourceˉwirˉstatus.Invalidˉdirectory,
            Bindings.Modules,
            Bindings.Modules,
            Build.Functionˉentries,
            Bytesˉlength(Input),
            0u32,
            0u32
        );
        return Compilerˉsourceˉwirˉcompilationˉfromˉbuild(Input, Bindings, Build);
    }
    return Compilerˉsourceˉwirˉcompilationˉsuccess(
        Input, Bindings, Build, Directory
    );
}

export fn Compilerˉprepareˉsourceˉwirˉproductˉwithˉsymbols(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary
) -> Compilerˉsourceˉwirˉcompilation {
    if Symbols.Status != Sourceˉsymbols.Compilerˉsourceˉsymbolˉstatus.Valid {
        let Failedˉbindings: Sourceˉbindings.Compilerˉsourceˉbindingˉsummary =
            Sourceˉbindings.Compilerˉsourceˉbindingsˉsummaryˉfromˉsymbols(
                Input, Symbols
            );
        return Compilerˉsourceˉwirˉcompilationˉfromˉbindings(
            Input, Failedˉbindings
        );
    }
    var Build: Compilerˉsourceˉwirˉbuild =
        Compilerˉprepareˉsourceˉwirˉbuildˉwithˉsymbols(
            Input, Scan, Symbols
        );
    if Build.Status != Compilerˉsourceˉwirˉstatus.Valid {
        return Compilerˉprepareˉsourceˉwirˉproductˉfailureˉwithˉsymbols(
            Input, Symbols, Build
        );
    }
    let Finalˉcatalog: Sourceˉgenerics.Compilerˉsourceˉgenericˉcatalog =
        Compilerˉsourceˉwirˉgenericˉcatalog(Build.Genericˉevidence);
    let Finalˉtypeˉcatalog:
        Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog =
        Compilerˉsourceˉwirˉgenericˉtypeˉcatalog(Build.Genericˉevidence);
    let Bindings: Sourceˉbindings.Compilerˉsourceˉbindingˉsummary =
        Genericˉbindings.Compilerˉsourceˉbindingsˉgenericˉtypesˉfinishˉspecializedˉphaseˉproduct(
            Input, Scan, Symbols,
            Compilerˉsourceˉwirˉbuildˉbindings(Input, Build),
            Build.Functionˉentries, Finalˉcatalog, Finalˉtypeˉcatalog
        );
    if Bindings.Status != Sourceˉbindings.Compilerˉsourceˉbindingˉstatus.Valid {
        return Compilerˉsourceˉwirˉcompilationˉfromˉbindings(Input, Bindings);
    }
    if !Compilerˉsourceˉwirˉevidenceˉfits(Build) {
        Build = Compilerˉsourceˉwirˉbuildˉfailure(
            Build,
            Compilerˉsourceˉwirˉstatus.Evidenceˉlimit,
            Bindings.Modules,
            Bindings.Modules,
            Build.Functionˉentries,
            Bytesˉlength(Input),
            0u32,
            0u32
        );
        return Compilerˉsourceˉwirˉcompilationˉfromˉbuild(
            Input, Bindings, Build
        );
    }
    return Compilerˉsourceˉwirˉcompilationˉsuccess(
        Input, Bindings, Build, Compilerˉsourceˉwirˉdirectory(Build)
    );
}

export fn Compilerˉprepareˉsourceˉwirˉwithˉsymbols(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary
) -> Compilerˉsourceˉwirˉcompilation {
    return Compilerˉprepareˉsourceˉwirˉwithˉsymbolsˉmode(
        Input, Scan, Symbols, true
    );
}

fn Compilerˉvalidateˉsourceˉwirˉwithˉsymbols(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary
) -> Compilerˉsourceˉwirˉsummary {
    let Compilation: Compilerˉsourceˉwirˉcompilation =
        Compilerˉprepareˉsourceˉwirˉwithˉsymbols(Input, Scan, Symbols);
    return Compilerˉsourceˉwirˉcompilationˉsummary(Compilation);
}

export fn Compilerˉvalidateˉsourceˉwir(Input: bytes) -> Compilerˉsourceˉwirˉsummary {
    let Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary =
        Sourceˉsymbols.Compilerˉvalidateˉsourceˉsymbols(Input);
    if Symbols.Status != Sourceˉsymbols.Compilerˉsourceˉsymbolˉstatus.Valid {
        let Failedˉbindings: Sourceˉbindings.Compilerˉsourceˉbindingˉsummary =
            Sourceˉbindings.Compilerˉsourceˉbindingsˉsummaryˉfromˉsymbols(
                Input, Symbols
            );
        return Compilerˉsourceˉwirˉsummaryˉfromˉbindings(Input, Failedˉbindings);
    }
    let Scan: Sourceˉset.Compilerˉsourceˉsetˉscan =
        Sourceˉset.Compilerˉscanˉsourceˉset(Input);
    return Compilerˉvalidateˉsourceˉwirˉwithˉsymbols(Input, Scan, Symbols);
}
