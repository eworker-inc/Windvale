export fn Compilerˉsourceˉwirˉoperationˉoperandˉshapeˉisˉvalid(
    Operation: u32,
    Index: u32,
    Shape: u32
) -> bool {
    if Operation == 10u32 { return Shape == 1u32; }
    if Operation == 11u32 { return Shape == 6u32; }
    if Operation == 12u32 {
        if Index == 0u32 { return Shape == 6u32; }
        return Shape == 3u32;
    }
    if Operation >= 13u32 {
        if Operation <= 16u32 {
            if Index == 0u32 { return Shape == 6u32; }
            return Shape == 3u32;
        }
    }
    if Operation == 18u32 {
        if Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉshapeˉisˉprivate(
                Shape
            ) {
            return true;
        }
        if Shape >= 65536u32 { return Shape < 131072u32; }
        return false;
    }
    if Operation == 20u32 {
        if Shape >= 131072u32 { return Shape < 196608u32; }
        return false;
    }
    if Operation == 21u32 {
        if Shape >= 131072u32 { return Shape < 196608u32; }
        return false;
    }
    if Operation == 22u32 {
        if Shape >= 131072u32 { return Shape < 196608u32; }
        return false;
    }
    if Operation == 23u32 { return Shape == 1u32; }
    if Operation == 24u32 { return Shape == 2u32; }
    if Operation == 25u32 { return Shape == 3u32; }
    if Operation == 26u32 { return Shape == 2u32; }
    if Operation == 27u32 { return Shape == 5u32; }
    if Operation == 28u32 { return Shape == 6u32; }
    if Operation == 29u32 { return Shape == 6u32; }
    if Operation == 30u32 { return Shape == 5u32; }
    if Operation == 31u32 { return Shape == 6u32; }
    if Operation == 32u32 { return Shape == 2u32; }
    if Operation == 33u32 { return Shape == 3u32; }
    if Operation == 34u32 { return Shape == 3u32; }
    if Operation == 35u32 { return Shape == 1u32; }
    if Operation == 36u32 { return Shape == 6u32; }
    if Operation == 37u32 { return Shape == 5u32; }
    if Operation >= 38u32 {
        if Operation <= 41u32 { return Shape == 1u32; }
    }
    if Operation >= 42u32 {
        if Operation <= 44u32 { return Shape == 3u32; }
    }
    if Operation >= 45u32 {
        if Operation <= 50u32 { return Shape == 1u32; }
    }
    if Operation == 51u32 { return Shape == 4u32; }
    if Operation == 52u32 { return Shape == 4u32; }
    if Operation == 53u32 { return Shape == 4u32; }
    if Operation >= 54u32 {
        if Operation <= 59u32 { return Shape == 3u32; }
    }
    if Operation == 60u32 { return Shape == 2u32; }
    if Operation == 61u32 { return Shape == 2u32; }
    if Operation == 64u32 { return Shape != 0u32 && Shape != 10u32; }
    if Operation == 66u32 { return Shape >= 196608u32; }
    if Operation == 67u32 { return Shape >= 196608u32; }
    if Operation == 69u32 {
        if Index == 0u32 { return Compilerˉsourceˉwirˉshapeˉisˉbuilder(Shape); }
        return true;
    }
    if Operation == 70u32 { return Compilerˉsourceˉwirˉshapeˉisˉbuilder(Shape); }
    if Operation == 71u32 { return Compilerˉsourceˉwirˉshapeˉisˉsequence(Shape); }
    if Operation == 72u32 {
        if Index == 0u32 { return Compilerˉsourceˉwirˉshapeˉisˉsequence(Shape); }
        return Shape == 3u32;
    }
    if Operation == 73u32 { return Shape == 1u32; }
    if Operation == 74u32 { return Shape == 1u32; }
    if Operation == 75u32 { return Shape == 3u32; }
    if Operation == 76u32 { return Shape == 3u32; }
    if Operation >= 77u32 {
        if Operation <= 80u32 { return Shape == 2u32; }
    }
    if Operation == 81u32 || Operation == 82u32 {
        if Index == 0u32 { return Shape == 2u32; }
        return Shape == 3u32;
    }
    if Operation >= 83u32 {
        if Operation <= 88u32 { return Shape == 3u32; }
    }
    if Operation == 89u32 || Operation == 90u32 { return Shape == 5u32; }
    if Operation == 91u32 || Operation == 92u32 { return Shape == 6u32; }
    if Operation == 95u32 { return Shape == 7u32; }
    if Operation == 96u32 { return Shape == 8u32; }
    if Operation >= 97u32 {
        if Operation <= 100u32 { return Shape == 7u32; }
    }
    if Operation >= 101u32 {
        if Operation <= 103u32 { return Shape == 8u32; }
    }
    if Operation >= 104u32 {
        if Operation <= 109u32 { return Shape == 7u32; }
    }
    if Operation >= 110u32 {
        if Operation <= 115u32 { return Shape == 8u32; }
    }
    if Operation == 116u32 || Operation == 117u32 { return Shape == 7u32; }
    if Operation >= 118u32 {
        if Operation <= 123u32 { return Shape == 8u32; }
    }
    if Operation == 124u32 || Operation == 125u32 {
        if Index == 0u32 { return Shape == 8u32; }
        return Shape == 3u32;
    }
    if Operation == 126u32 {
        if Index == 0u32 { return Shape == 6u32; }
        return Shape == 3u32;
    }
    if Operation == 127u32 { return Shape == 8u32; }
    if Operation == 128u32 { return Shape == 3u32; }
    if Operation >= 130u32 {
        if Operation <= 134u32 {
            return Shape >= 11u32 && Shape <= 13u32;
        }
    }
    if Operation == 135u32 { return Shape == 11u32 || Shape == 12u32; }
    if Operation >= 136u32 {
        if Operation <= 141u32 {
            return Shape >= 11u32 && Shape <= 13u32;
        }
    }
    if Operation >= 142u32 {
        if Operation <= 145u32 { return Shape == 13u32; }
    }
    if Operation == 146u32 || Operation == 147u32 {
        if Index == 0u32 { return Shape == 13u32; }
        return Shape == 3u32;
    }
    if Operation == 149u32 || Operation == 150u32 { return Shape == 16u32; }
    if Operation >= 152u32 {
        if Operation <= 162u32 { return Shape == 14u32 || Shape == 15u32; }
    }
    return true;
}

export fn Compilerˉsourceˉwirˉblockˉexists(
    Directory: bytes,
    Blocksˉoffset: u32,
    Firstˉblock: u32,
    Blockˉcount: u32,
    Module: u32,
    Function: u32,
    Wanted: u32
) -> bool {
    if Wanted >= Blockˉcount { return false; }
    let Blockˉentry: u32 = Blocksˉoffset + (Firstˉblock + Wanted) * 28u32;
    return Bytesˉreadˉu32ˉlittle(Directory, Blockˉentry) == Wanted;
}

export fn Compilerˉsourceˉwirˉbindingˉdirectoryˉshape(
    Bindingˉdirectory: bytes,
    Symbolˉentries: u32,
    Function: u32,
    Slot: u32
) -> u32 {
    let Rangeˉentry: u32 =
        Sourceˉbindings.Compilerˉsourceˉbindingsˉrangeˉoffset(
            Bindingˉdirectory, Function
        );
    let Bindingˉfirst: u32 = Bytesˉreadˉu32ˉlittle(Bindingˉdirectory, Rangeˉentry);
    let Bindingˉcount: u32 = Bytesˉreadˉu32ˉlittle(Bindingˉdirectory, Rangeˉentry + 4u32);
    if Slot >= Bindingˉcount { return 0u32; }
    let Bindingsˉoffset: u32 =
        Sourceˉbindings.Compilerˉsourceˉbindingsˉentriesˉoffset(
            Bindingˉdirectory
        );
    let Bindingˉentry: u32 = Bindingsˉoffset + (Bindingˉfirst + Slot) * 36u32;
    if Bytesˉreadˉu32ˉlittle(Bindingˉdirectory, Bindingˉentry + 12u32) != Slot {
        return 0u32;
    }
    return Bytesˉreadˉu32ˉlittle(Bindingˉdirectory, Bindingˉentry + 24u32);
}

export fn Compilerˉsourceˉwirˉbindingˉshape(
    Bindings: Sourceˉbindings.Compilerˉsourceˉbindingˉsummary,
    Symbolˉentries: u32,
    Function: u32,
    Slot: u32
) -> u32 {
    return Compilerˉsourceˉwirˉbindingˉdirectoryˉshape(
        Bindings.Directory, Symbolˉentries, Function, Slot
    );
}

export fn Compilerˉsourceˉwirˉinvalidˉrange() -> Compilerˉsourceˉwirˉrange {
    return Compilerˉsourceˉwirˉrange(
        false, false,
        0u32, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32,
        0u32, 0u32, 0u32
    );
}

export fn Compilerˉsourceˉwirˉfunctionˉrange(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Bindings: Sourceˉbindings.Compilerˉsourceˉbindingˉsummary,
    Directory: bytes,
    Function: u32,
    Expectedˉblock: u32,
    Expectedˉoperation: u32,
    Expectedˉtemporary: u32,
    Expectedˉoperand: u32,
    Blocks: u32,
    Operations: u32,
    Temporaries: u32,
    Operands: u32
) -> Compilerˉsourceˉwirˉrange {
    let Symbolˉentries: u32 = Bytesˉreadˉu32ˉlittle(
        Symbols.Directory, 8u32
    );
    let Embeddedˉcatalog: Sourceˉgenerics.Compilerˉsourceˉgenericˉcatalog =
        Genericˉbindings.Compilerˉsourceˉbindingsˉgenericˉtypesˉfunctionˉcatalog(
            Bindings.Directory
        );
    let Embeddedˉtypeˉcatalog:
        Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog =
        Genericˉbindings.Compilerˉsourceˉbindingsˉgenericˉtypesˉtypeˉcatalog(
            Bindings.Directory
        );
    var Genericˉinstance: u32 = Compilerˉsourceˉwirˉsentinel();
    let Declarationˉentry: u32 =
        Sourceˉbindings.Compilerˉsourceˉbindingsˉrangeˉdeclaration(
            Bindings.Directory, Function
        );
    if Function >= Symbolˉentries {
        Genericˉinstance = Function - Symbolˉentries;
    }
    if Declarationˉentry >= Symbolˉentries {
        return Compilerˉsourceˉwirˉinvalidˉrange();
    }
    let Symbolˉentry: u32 = 16u32 + Declarationˉentry * 24u32;
    let Symbolˉmodule: u32 = Bytesˉreadˉu32ˉlittle(Symbols.Directory, Symbolˉentry);
    let Symbolˉkind: u32 = Bytesˉreadˉu32ˉlittle(Symbols.Directory, Symbolˉentry + 4u32);
    let Functionˉentry: u32 =
        Compilerˉsourceˉwirˉfunctionsˉoffset(Directory) + Function * 48u32;
    if Symbolˉkind != 6u32 {
        var Zeroˉindex: u32 = 0u32;
        while Zeroˉindex < 12u32 {
            if Bytesˉreadˉu32ˉlittle(
                Directory, Functionˉentry + Zeroˉindex * 4u32
            ) != 0u32 {
                return Compilerˉsourceˉwirˉinvalidˉrange();
            }
            Zeroˉindex = Zeroˉindex + 1u32;
        }
        return Compilerˉsourceˉwirˉrange(
            true, false,
            Symbolˉmodule, Expectedˉblock, 0u32,
            Expectedˉoperation, 0u32,
            Expectedˉtemporary, 0u32,
            Expectedˉoperand, 0u32,
            0u32, 0u32, 0u32
        );
    }
    let Declarationˉoffset: u32 = Bytesˉreadˉu32ˉlittle(
        Symbols.Directory, Symbolˉentry + 8u32
    );
    let Functionˉview: Sourceˉset.Compilerˉsourceˉsetˉview =
        Sourceˉset.Compilerˉsourceˉsetˉmodule(
            Input, Scan, Symbolˉmodule
        );
    let Declarationˉposition: Sourceˉbodies.Compilerˉsourceˉposition =
        Sourceˉbodies.Compilerˉsourceˉposition(
            Declarationˉoffset, 1u32, 1u32
        );
    let Declaration: Sourceˉdeclarations.Compilerˉsourceˉdeclaration =
        Sourceˉdeclarations.Compilerˉparseˉnextˉdeclarationˉvalidated(
            Functionˉview.Source, Declarationˉoffset,
            Declarationˉposition.Line, Declarationˉposition.Column, true
        );
    let Generic: Sourceˉsymbols.Compilerˉsourceˉfunctionˉgeneric =
        Sourceˉsymbols.Compilerˉsourceˉsymbolsˉfunctionˉgeneric(
            Functionˉview.Source, Declaration,
            Declarationˉposition.Line, Declarationˉposition.Column
        );
    if Generic.Parameters > 0u32 &&
        Genericˉinstance == Compilerˉsourceˉwirˉsentinel() {
        var Genericˉzero: u32 = 0u32;
        while Genericˉzero < 12u32 {
            if Bytesˉreadˉu32ˉlittle(
                Directory, Functionˉentry + Genericˉzero * 4u32
            ) != 0u32 {
                return Compilerˉsourceˉwirˉinvalidˉrange();
            }
            Genericˉzero = Genericˉzero + 1u32;
        }
        return Compilerˉsourceˉwirˉrange(
            true, false,
            Symbolˉmodule, Expectedˉblock, 0u32,
            Expectedˉoperation, 0u32,
            Expectedˉtemporary, 0u32,
            Expectedˉoperand, 0u32,
            0u32, 0u32, 0u32
        );
    }
    if Generic.Parameters == 0u32 &&
        Genericˉinstance != Compilerˉsourceˉwirˉsentinel() {
        return Compilerˉsourceˉwirˉinvalidˉrange();
    }
    let Entryˉmodule: u32 = Bytesˉreadˉu32ˉlittle(Directory, Functionˉentry);
    let Firstˉblock: u32 = Bytesˉreadˉu32ˉlittle(Directory, Functionˉentry + 4u32);
    let Blockˉcount: u32 = Bytesˉreadˉu32ˉlittle(Directory, Functionˉentry + 8u32);
    let Firstˉoperation: u32 = Bytesˉreadˉu32ˉlittle(Directory, Functionˉentry + 12u32);
    let Operationˉcount: u32 = Bytesˉreadˉu32ˉlittle(Directory, Functionˉentry + 16u32);
    let Firstˉtemporary: u32 = Bytesˉreadˉu32ˉlittle(Directory, Functionˉentry + 20u32);
    let Temporaryˉcount: u32 = Bytesˉreadˉu32ˉlittle(Directory, Functionˉentry + 24u32);
    let Firstˉoperand: u32 = Bytesˉreadˉu32ˉlittle(Directory, Functionˉentry + 28u32);
    let Operandˉcount: u32 = Bytesˉreadˉu32ˉlittle(Directory, Functionˉentry + 32u32);
    let Parameters: u32 = Bytesˉreadˉu32ˉlittle(Directory, Functionˉentry + 36u32);
    let Locals: u32 = Bytesˉreadˉu32ˉlittle(Directory, Functionˉentry + 40u32);
    let Returnˉshape: u32 = Bytesˉreadˉu32ˉlittle(Directory, Functionˉentry + 44u32);
    if Entryˉmodule != Symbolˉmodule { return Compilerˉsourceˉwirˉinvalidˉrange(); }
    if Firstˉblock != Expectedˉblock { return Compilerˉsourceˉwirˉinvalidˉrange(); }
    if Firstˉoperation != Expectedˉoperation { return Compilerˉsourceˉwirˉinvalidˉrange(); }
    if Firstˉtemporary != Expectedˉtemporary { return Compilerˉsourceˉwirˉinvalidˉrange(); }
    if Firstˉoperand != Expectedˉoperand { return Compilerˉsourceˉwirˉinvalidˉrange(); }
    if Blockˉcount == 0u32 { return Compilerˉsourceˉwirˉinvalidˉrange(); }
    if Blockˉcount > Blocks - Firstˉblock { return Compilerˉsourceˉwirˉinvalidˉrange(); }
    if Operationˉcount > Operations - Firstˉoperation { return Compilerˉsourceˉwirˉinvalidˉrange(); }
    if Temporaryˉcount > Temporaries - Firstˉtemporary { return Compilerˉsourceˉwirˉinvalidˉrange(); }
    if Operandˉcount > Operands - Firstˉoperand { return Compilerˉsourceˉwirˉinvalidˉrange(); }
    let Symbolˉparameters: u32 = Bytesˉreadˉu32ˉlittle(Symbols.Directory, Symbolˉentry + 20u32);
    if Parameters != Symbolˉparameters { return Compilerˉsourceˉwirˉinvalidˉrange(); }
    let Bindingˉrange: u32 =
        Sourceˉbindings.Compilerˉsourceˉbindingsˉrangeˉoffset(
            Bindings.Directory, Function
        );
    let Bindingˉcount: u32 = Bytesˉreadˉu32ˉlittle(Bindings.Directory, Bindingˉrange + 4u32);
    if Bindingˉcount < Parameters { return Compilerˉsourceˉwirˉinvalidˉrange(); }
    if Locals != Bindingˉcount - Parameters { return Compilerˉsourceˉwirˉinvalidˉrange(); }
    if !Compilerˉsourceˉwirˉshapeˉisˉvalidˉwithˉgenericˉtypes(
        Returnˉshape, Symbols, Embeddedˉtypeˉcatalog, true
    ) {
        return Compilerˉsourceˉwirˉinvalidˉrange();
    }
    if Generic.Parameters > 0u32 {
        // The catalog is the canonical solved substitution. Revalidating it
        // against the declaration, then checking the substituted signatures
        // below, proves the specialized boundary without replaying inference.
        var Solution: Sourceˉgenerics.Compilerˉsourceˉgenericˉsolution =
            Sourceˉsymbols.Compilerˉsourceˉsymbolsˉgenericˉsolution(
                Functionˉview.Source, Generic
            );
        var Catalogˉparameter: u32 = 0u32;
        while Catalogˉparameter < Generic.Parameters {
            let Catalogˉargument:
                Sourceˉgenerics.Compilerˉsourceˉgenericˉargument =
                Sourceˉgenerics.Compilerˉsourceˉgenericˉcatalogˉargument(
                    Embeddedˉcatalog, Genericˉinstance, Catalogˉparameter
                );
            if !Catalogˉargument.Valid {
                return Compilerˉsourceˉwirˉinvalidˉrange();
            }
            if Catalogˉargument.Kind == 1u32 &&
                !Compilerˉsourceˉwirˉshapeˉisˉvalidˉwithˉgenericˉtypes(
                    Catalogˉargument.Low, Symbols,
                    Embeddedˉtypeˉcatalog, false
                ) {
                return Compilerˉsourceˉwirˉinvalidˉrange();
            }
            Solution =
                Sourceˉgenerics.Compilerˉsourceˉgenericˉsolutionˉcontribute(
                    Solution, Catalogˉparameter,
                    Catalogˉargument.Kind,
                    Catalogˉargument.Low,
                    Catalogˉargument.High,
                    Catalogˉparameter, Declarationˉoffset
                );
            if Solution.Status !=
                    Sourceˉgenerics.Compilerˉsourceˉgenericˉstatus.Valid {
                return Compilerˉsourceˉwirˉinvalidˉrange();
            }
            Catalogˉparameter = Catalogˉparameter + 1u32;
        }
        Solution = Sourceˉgenerics.Compilerˉsourceˉgenericˉsolutionˉfinish(
            Solution
        );
        if Solution.Status !=
                Sourceˉgenerics.Compilerˉsourceˉgenericˉstatus.Valid {
            return Compilerˉsourceˉwirˉinvalidˉrange();
        }
        if !Sourceˉgenerics.Compilerˉsourceˉgenericˉcatalogˉinstanceˉmatchesˉsolution(
            Embeddedˉcatalog, Genericˉinstance, Declarationˉentry, Solution
        ) {
            return Compilerˉsourceˉwirˉinvalidˉrange();
        }
        var Argument: u32 = 0u32;
        while Argument < Symbolˉparameters {
            let Parameterˉsignature: Compilerˉsourceˉwirˉsignature =
                Compilerˉsourceˉwirˉfunctionˉsignatureˉconcrete(
                    Input, Scan, Symbols, Symbolˉmodule,
                    Functionˉview.Source, Declarationˉoffset, Argument,
                    Embeddedˉcatalog,
                    Embeddedˉtypeˉcatalog,
                    Genericˉinstance
                );
            if Parameterˉsignature.Parameterˉshape !=
                    Compilerˉsourceˉwirˉbindingˉshape(
                        Bindings, Bytesˉreadˉu32ˉlittle(
                            Symbols.Directory, 8u32
                        ), Function, Argument
                    ) {
                return Compilerˉsourceˉwirˉinvalidˉrange();
            }
            Argument = Argument + 1u32;
        }
    }
    let Sourceˉsignature: Compilerˉsourceˉwirˉsignature =
        Compilerˉsourceˉwirˉfunctionˉsignatureˉconcrete(
            Input, Scan, Symbols, Symbolˉmodule, Functionˉview.Source,
            Declarationˉoffset, Compilerˉsourceˉwirˉsentinel(),
            Embeddedˉcatalog,
            Embeddedˉtypeˉcatalog,
            Genericˉinstance
        );
    if Returnˉshape != Sourceˉsignature.Returnˉshape {
        return Compilerˉsourceˉwirˉinvalidˉrange();
    }
    return Compilerˉsourceˉwirˉrange(
        true, true,
        Entryˉmodule, Firstˉblock, Blockˉcount,
        Firstˉoperation, Operationˉcount,
        Firstˉtemporary, Temporaryˉcount,
        Firstˉoperand, Operandˉcount,
        Parameters, Locals, Returnˉshape
    );
}

export fn Compilerˉsourceˉwirˉfunctionˉblocksˉareˉvalid(
    Directory: bytes,
    Blocksˉoffset: u32,
    Operationsˉoffset: u32,
    Temporariesˉoffset: u32,
    Function: u32,
    Range: Compilerˉsourceˉwirˉrange
) -> bool {
    var Blockˉindex: u32 = 0u32;
    var Coveredˉoperations: u32 = 0u32;
    var Foundˉentry: bool = false;
    while Blockˉindex < Range.Blockˉcount {
        let Blockˉentry: u32 = Blocksˉoffset + (Range.Firstˉblock + Blockˉindex) * 28u32;
        let Blockˉidentifier: u32 = Bytesˉreadˉu32ˉlittle(Directory, Blockˉentry);
        let Blockˉfirstˉoperation: u32 = Bytesˉreadˉu32ˉlittle(Directory, Blockˉentry + 4u32);
        let Blockˉoperationˉcount: u32 = Bytesˉreadˉu32ˉlittle(Directory, Blockˉentry + 8u32);
        let Blockˉterminator: u32 = Bytesˉreadˉu32ˉlittle(Directory, Blockˉentry + 12u32);
        let Blockˉvalue: u32 = Bytesˉreadˉu32ˉlittle(Directory, Blockˉentry + 16u32);
        let Blockˉfirstˉtarget: u32 = Bytesˉreadˉu32ˉlittle(Directory, Blockˉentry + 20u32);
        let Blockˉsecondˉtarget: u32 = Bytesˉreadˉu32ˉlittle(Directory, Blockˉentry + 24u32);
        if Blockˉidentifier >= Range.Blockˉcount { return false; }
        if Blockˉidentifier == 0u32 { Foundˉentry = true; }
        if Blockˉidentifier != Blockˉindex { return false; }
        if Blockˉfirstˉoperation < Range.Firstˉoperation { return false; }
        let Functionˉoperationˉend: u32 = Range.Firstˉoperation + Range.Operationˉcount;
        if Blockˉfirstˉoperation > Functionˉoperationˉend { return false; }
        if Blockˉoperationˉcount > Functionˉoperationˉend - Blockˉfirstˉoperation {
            return false;
        }
        Coveredˉoperations = Coveredˉoperations + Blockˉoperationˉcount;
        var Blockˉoperationˉindex: u32 = 0u32;
        while Blockˉoperationˉindex < Blockˉoperationˉcount {
            let Ownedˉoperationˉentry: u32 = Operationsˉoffset + (
                Blockˉfirstˉoperation + Blockˉoperationˉindex
            ) * 32u32;
            if Bytesˉreadˉu32ˉlittle(
                Directory, Ownedˉoperationˉentry
            ) != Blockˉidentifier { return false; }
            Blockˉoperationˉindex = Blockˉoperationˉindex + 1u32;
        }
        if Blockˉterminator == 1u32 {
            if Blockˉvalue != Compilerˉsourceˉwirˉsentinel() { return false; }
            if Blockˉsecondˉtarget != Compilerˉsourceˉwirˉsentinel() { return false; }
            if !Compilerˉsourceˉwirˉblockˉexists(
                Directory, Blocksˉoffset, Range.Firstˉblock, Range.Blockˉcount,
                Range.Module, Function, Blockˉfirstˉtarget
            ) { return false; }
        } else {
            if Blockˉterminator == 2u32 {
                if Blockˉvalue >= Range.Temporaryˉcount { return false; }
                let Branchˉshape: u32 = Bytesˉreadˉu32ˉlittle(
                    Directory,
                    Temporariesˉoffset + (Range.Firstˉtemporary + Blockˉvalue) * 4u32
                );
                if Branchˉshape != 4u32 { return false; }
                if !Compilerˉsourceˉwirˉblockˉexists(
                    Directory, Blocksˉoffset, Range.Firstˉblock, Range.Blockˉcount,
                    Range.Module, Function, Blockˉfirstˉtarget
                ) { return false; }
                if !Compilerˉsourceˉwirˉblockˉexists(
                    Directory, Blocksˉoffset, Range.Firstˉblock, Range.Blockˉcount,
                    Range.Module, Function, Blockˉsecondˉtarget
                ) { return false; }
            } else {
                if Blockˉterminator != 3u32 { return false; }
                if Blockˉfirstˉtarget != Compilerˉsourceˉwirˉsentinel() { return false; }
                if Blockˉsecondˉtarget != Compilerˉsourceˉwirˉsentinel() { return false; }
                if Range.Returnˉshape == 0u32 {
                    if Blockˉvalue != Compilerˉsourceˉwirˉsentinel() { return false; }
                } else {
                    if Blockˉvalue >= Range.Temporaryˉcount { return false; }
                    let Returnˉvalueˉshape: u32 = Bytesˉreadˉu32ˉlittle(
                        Directory,
                        Temporariesˉoffset + (Range.Firstˉtemporary + Blockˉvalue) * 4u32
                    );
                    if Returnˉvalueˉshape != Range.Returnˉshape { return false; }
                }
            }
        }
        Blockˉindex = Blockˉindex + 1u32;
    }
    if !Foundˉentry { return false; }
    return Coveredˉoperations == Range.Operationˉcount;
}

export fn Compilerˉsourceˉwirˉnominalˉdirectoryˉentry(
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Nominal: u32,
    Kind: u32
) -> u32 {
    if Nominal >= Symbols.Records + Symbols.Enums + Symbols.Variants {
        return Compilerˉsourceˉwirˉsentinel();
    }
    let Symbolˉentries: u32 = Bytesˉreadˉu32ˉlittle(Symbols.Directory, 8u32);
    let Symbolˉindex: u32 = Bytesˉreadˉu32ˉlittle(
        Symbols.Lookup, 4112u32 + Symbolˉentries * 4u32 + Nominal * 4u32
    );
    let Symbolˉentry: u32 = 16u32 + Symbolˉindex * 24u32;
    if Bytesˉreadˉu32ˉlittle(Symbols.Directory, Symbolˉentry + 4u32) != Kind {
        return Compilerˉsourceˉwirˉsentinel();
    }
    return Symbolˉindex;
}

fn Compilerˉsourceˉwirˉvariantˉcaseˉviewˉbyˉindex(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Nominal: u32,
    Case: u32
) -> Compilerˉsourceˉwirˉvariantˉcaseˉview {
    let Missing: Compilerˉsourceˉwirˉvariantˉcaseˉview =
        Compilerˉsourceˉwirˉvariantˉcaseˉview(
            false, Scan.Modules, 0u32, 0u32, 0u32, 1u32, 1u32
        );
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉshapeˉisˉfoundationˉoption(Nominal) {
        if Case == 0u32 {
            return Compilerˉsourceˉwirˉvariantˉcaseˉview(
                true, Scan.Modules, Case, 1u32, 0u32, 1u32, 1u32
            );
        }
        if Case == 1u32 {
            return Compilerˉsourceˉwirˉvariantˉcaseˉview(
                true, Scan.Modules, Case, 0u32, 0u32, 1u32, 1u32
            );
        }
        return Missing;
    }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉshapeˉisˉfoundationˉresult(Nominal) {
        if Case <= 1u32 {
            return Compilerˉsourceˉwirˉvariantˉcaseˉview(
                true, Scan.Modules, Case, 1u32, 0u32, 1u32, 1u32
            );
        }
        return Missing;
    }
    let Directoryˉentry: u32 = Compilerˉsourceˉwirˉnominalˉdirectoryˉentry(
        Symbols, Nominal, 8u32
    );
    if Directoryˉentry == Compilerˉsourceˉwirˉsentinel() { return Missing; }
    let Variant: Sourceˉsymbols.Compilerˉsourceˉsymbolˉmatch =
        Sourceˉsymbols.Compilerˉsourceˉsymbolsˉdirectoryˉentry(
            Symbols.Directory, Scan.Modules, Directoryˉentry
        );
    let View: Sourceˉset.Compilerˉsourceˉsetˉview =
        Sourceˉset.Compilerˉsourceˉsetˉmodule(Input, Scan, Variant.Module);
    let Declarationˉposition: Sourceˉbodies.Compilerˉsourceˉposition =
        Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
            View.Source, 0u32, 1u32, 1u32, Variant.Declarationˉoffset
        );
    let Declaration: Sourceˉdeclarations.Compilerˉsourceˉdeclaration =
        Sourceˉdeclarations.Compilerˉparseˉnextˉdeclarationˉvalidated(
            View.Source, Variant.Declarationˉoffset,
            Declarationˉposition.Line, Declarationˉposition.Column, true
        );
    if Case >= Declaration.Items { return Missing; }
    let Bodyˉposition: Sourceˉbodies.Compilerˉsourceˉposition =
        Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
            View.Source, Variant.Declarationˉoffset,
            Declarationˉposition.Line, Declarationˉposition.Column,
            Declaration.Bodyˉoffset
        );
    let Left: Sourceˉlexer.Compilerˉsourceˉtoken =
        Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            View.Source, Declaration.Bodyˉoffset,
            Bodyˉposition.Line, Bodyˉposition.Column
        );
    var Cursor: u32 = Left.Nextˉoffset;
    var Line: u32 = Left.Nextˉline;
    var Column: u32 = Left.Nextˉcolumn;
    var Index: u32 = 0u32;
    while Index <= Case {
        let Caseˉname: Sourceˉlexer.Compilerˉsourceˉtoken =
            Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                View.Source, Cursor, Line, Column
            );
        let Afterˉname: Sourceˉlexer.Compilerˉsourceˉtoken =
            Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                View.Source, Caseˉname.Nextˉoffset,
                Caseˉname.Nextˉline, Caseˉname.Nextˉcolumn
            );
        var End: Sourceˉlexer.Compilerˉsourceˉtoken = Afterˉname;
        var Fields: u32 = 0u32;
        var Fieldsˉoffset: u32 = Afterˉname.Offset;
        var Fieldsˉline: u32 = Afterˉname.Line;
        var Fieldsˉcolumn: u32 = Afterˉname.Column;
        if Afterˉname.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Leftˉparenthesis {
            Fieldsˉoffset = Afterˉname.Nextˉoffset;
            Fieldsˉline = Afterˉname.Nextˉline;
            Fieldsˉcolumn = Afterˉname.Nextˉcolumn;
            var Fieldˉcursor: u32 = Fieldsˉoffset;
            var Fieldˉline: u32 = Fieldsˉline;
            var Fieldˉcolumn: u32 = Fieldsˉcolumn;
            var Readingˉfields: bool = true;
            while Readingˉfields {
                let Field: Sourceˉdeclarations.Compilerˉsourceˉvariantˉfield =
                    Sourceˉdeclarations.Compilerˉparseˉvariantˉfield(
                        View.Source, Fieldˉcursor, Fieldˉline, Fieldˉcolumn
                    );
                Fields = Fields + 1u32;
                let Separator: Sourceˉlexer.Compilerˉsourceˉtoken =
                    Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                        View.Source, Field.Nextˉoffset,
                        Field.Nextˉline, Field.Nextˉcolumn
                    );
                if Separator.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Comma {
                    let Viewˉafterˉcomma:
                        Sourceˉlexer.Compilerˉsourceˉtoken =
                        Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                            View.Source, Separator.Nextˉoffset,
                            Separator.Nextˉline, Separator.Nextˉcolumn
                        );
                    if Viewˉafterˉcomma.Kind ==
                        Sourceˉlexer.Compilerˉtokenˉkind.Rightˉparenthesis {
                        Readingˉfields = false;
                        End = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                            View.Source, Viewˉafterˉcomma.Nextˉoffset,
                            Viewˉafterˉcomma.Nextˉline,
                            Viewˉafterˉcomma.Nextˉcolumn
                        );
                    } else {
                        Fieldˉcursor = Separator.Nextˉoffset;
                        Fieldˉline = Separator.Nextˉline;
                        Fieldˉcolumn = Separator.Nextˉcolumn;
                    }
                } else {
                    Readingˉfields = false;
                    End = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                        View.Source, Separator.Nextˉoffset,
                        Separator.Nextˉline, Separator.Nextˉcolumn
                    );
                }
            }
        }
        if Index == Case {
            return Compilerˉsourceˉwirˉvariantˉcaseˉview(
                true, Variant.Module, Index, Fields,
                Fieldsˉoffset, Fieldsˉline, Fieldsˉcolumn
            );
        }
        Cursor = End.Nextˉoffset;
        Line = End.Nextˉline;
        Column = End.Nextˉcolumn;
        Index = Index + 1u32;
    }
    return Missing;
}

fn Compilerˉsourceˉwirˉvariantˉfieldˉbyˉindex(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Nominal: u32,
    Case: u32,
    Fieldˉindex: u32
) -> Compilerˉsourceˉwirˉmember {
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉshapeˉisˉfoundationˉoption(Nominal) {
        if Case == 0u32 && Fieldˉindex == 0u32 {
            return Compilerˉsourceˉwirˉmember(
                true, 0u32,
                Sourceˉsymbols.Compilerˉsourceˉsymbolsˉgenericˉexpandedˉshape(
                    Nominal - 1610612736u32
                )
            );
        }
        return Compilerˉsourceˉwirˉmember(false, 0u32, 0u32);
    }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉshapeˉisˉfoundationˉresult(Nominal) {
        if Fieldˉindex == 0u32 && Case <= 1u32 {
            var Genericˉfieldˉshape: u32 =
                Sourceˉsymbols.Compilerˉsourceˉsymbolsˉfoundationˉresultˉvalidˉshape(Nominal);
            if Case == 1u32 {
                Genericˉfieldˉshape =
                    Sourceˉsymbols.Compilerˉsourceˉsymbolsˉfoundationˉresultˉerrorˉshape(Nominal);
            }
            return Compilerˉsourceˉwirˉmember(true, 0u32, Genericˉfieldˉshape);
        }
        return Compilerˉsourceˉwirˉmember(false, 0u32, 0u32);
    }
    let Caseˉview: Compilerˉsourceˉwirˉvariantˉcaseˉview =
        Compilerˉsourceˉwirˉvariantˉcaseˉviewˉbyˉindex(
            Input, Scan, Symbols, Nominal, Case
        );
    if !Caseˉview.Found || Fieldˉindex >= Caseˉview.Fields {
        return Compilerˉsourceˉwirˉmember(false, 0u32, 0u32);
    }
    let View: Sourceˉset.Compilerˉsourceˉsetˉview =
        Sourceˉset.Compilerˉsourceˉsetˉmodule(
            Input, Scan, Caseˉview.Module
        );
    var Cursor: u32 = Caseˉview.Fieldsˉoffset;
    var Line: u32 = Caseˉview.Fieldsˉline;
    var Column: u32 = Caseˉview.Fieldsˉcolumn;
    var Index: u32 = 0u32;
    while Index <= Fieldˉindex {
        let Field: Sourceˉdeclarations.Compilerˉsourceˉvariantˉfield =
            Sourceˉdeclarations.Compilerˉparseˉvariantˉfield(
                View.Source, Cursor, Line, Column
            );
        if Index == Fieldˉindex {
            let Typeˉposition: Sourceˉbodies.Compilerˉsourceˉposition =
                Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
                    View.Source, Cursor, Line, Column, Field.Typeˉoffset
                );
            let Type: Sourceˉsymbols.Compilerˉsourceˉtypeˉbinding =
                Sourceˉsymbols.Compilerˉsourceˉsymbolsˉbindˉtype(
                    Input, Scan, Symbols.Directory, Symbols.Lookup,
                    Symbols.Visibility, Caseˉview.Module, View.Source,
                    Field.Typeˉoffset, Typeˉposition.Line,
                    Typeˉposition.Column, Symbols.Records,
                    Symbols.Enums, false
                );
            return Compilerˉsourceˉwirˉmember(
                true, Index,
                Sourceˉbindings.Compilerˉsourceˉbindingsˉshape(Type)
            );
        }
        let Separator: Sourceˉlexer.Compilerˉsourceˉtoken =
            Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                View.Source, Field.Nextˉoffset,
                Field.Nextˉline, Field.Nextˉcolumn
            );
        Cursor = Separator.Nextˉoffset;
        Line = Separator.Nextˉline;
        Column = Separator.Nextˉcolumn;
        Index = Index + 1u32;
    }
    return Compilerˉsourceˉwirˉmember(false, 0u32, 0u32);
}

fn Compilerˉsourceˉwirˉvariantˉfieldˉbyˉname(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Nominal: u32,
    Case: u32,
    Queryˉsource: bytes,
    Queryˉoffset: u32,
    Queryˉlength: u32
) -> Compilerˉsourceˉwirˉmember {
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉshapeˉisˉfoundationˉgeneric(Nominal) {
        var Genericˉfieldˉnameˉvalid: bool = false;
        if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉshapeˉisˉfoundationˉoption(Nominal) &&
            Case == 0u32 {
            Genericˉfieldˉnameˉvalid = Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(
                Queryˉsource, Queryˉoffset, Queryˉlength, "Value"
            );
        }
        if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉshapeˉisˉfoundationˉresult(Nominal) {
            if Case == 0u32 {
                Genericˉfieldˉnameˉvalid = Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(
                    Queryˉsource, Queryˉoffset, Queryˉlength, "Value"
                );
            }
            if Case == 1u32 {
                Genericˉfieldˉnameˉvalid = Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(
                    Queryˉsource, Queryˉoffset, Queryˉlength, "Error"
                );
            }
        }
        if !Genericˉfieldˉnameˉvalid {
            return Compilerˉsourceˉwirˉmember(false, 0u32, 0u32);
        }
        return Compilerˉsourceˉwirˉvariantˉfieldˉbyˉindex(
            Input, Scan, Symbols, Nominal, Case, 0u32
        );
    }
    let Caseˉview: Compilerˉsourceˉwirˉvariantˉcaseˉview =
        Compilerˉsourceˉwirˉvariantˉcaseˉviewˉbyˉindex(
            Input, Scan, Symbols, Nominal, Case
        );
    if !Caseˉview.Found {
        return Compilerˉsourceˉwirˉmember(false, 0u32, 0u32);
    }
    let View: Sourceˉset.Compilerˉsourceˉsetˉview =
        Sourceˉset.Compilerˉsourceˉsetˉmodule(
            Input, Scan, Caseˉview.Module
        );
    var Cursor: u32 = Caseˉview.Fieldsˉoffset;
    var Line: u32 = Caseˉview.Fieldsˉline;
    var Column: u32 = Caseˉview.Fieldsˉcolumn;
    var Index: u32 = 0u32;
    while Index < Caseˉview.Fields {
        let Name: Sourceˉlexer.Compilerˉsourceˉtoken =
            Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                View.Source, Cursor, Line, Column
            );
        let Field: Sourceˉdeclarations.Compilerˉsourceˉvariantˉfield =
            Sourceˉdeclarations.Compilerˉparseˉvariantˉfield(
                View.Source, Cursor, Line, Column
            );
        if Name.Length == Queryˉlength &&
            Sourceˉset.Compilerˉsourceˉspansˉequal(
                View.Source, Name.Offset, Name.Length,
                Queryˉsource, Queryˉoffset, Queryˉlength
            ) {
            let Typeˉposition: Sourceˉbodies.Compilerˉsourceˉposition =
                Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
                    View.Source, Cursor, Line, Column, Field.Typeˉoffset
                );
            let Type: Sourceˉsymbols.Compilerˉsourceˉtypeˉbinding =
                Sourceˉsymbols.Compilerˉsourceˉsymbolsˉbindˉtype(
                    Input, Scan, Symbols.Directory, Symbols.Lookup,
                    Symbols.Visibility, Caseˉview.Module, View.Source,
                    Field.Typeˉoffset, Typeˉposition.Line,
                    Typeˉposition.Column, Symbols.Records,
                    Symbols.Enums, false
                );
            return Compilerˉsourceˉwirˉmember(
                true, Index,
                Sourceˉbindings.Compilerˉsourceˉbindingsˉshape(Type)
            );
        }
        let Separator: Sourceˉlexer.Compilerˉsourceˉtoken =
            Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                View.Source, Field.Nextˉoffset,
                Field.Nextˉline, Field.Nextˉcolumn
            );
        Cursor = Separator.Nextˉoffset;
        Line = Separator.Nextˉline;
        Column = Separator.Nextˉcolumn;
        Index = Index + 1u32;
    }
    return Compilerˉsourceˉwirˉmember(false, 0u32, 0u32);
}

fn Compilerˉsourceˉwirˉvariantˉpatternˉisˉvalid(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Source: bytes,
    Case: Sourceˉbodies.Compilerˉsourceˉmatchˉcase,
    Nominal: u32,
    Caseˉindex: u32
) -> bool {
    let View: Compilerˉsourceˉwirˉvariantˉcaseˉview =
        Compilerˉsourceˉwirˉvariantˉcaseˉviewˉbyˉindex(
            Input, Scan, Symbols, Nominal, Caseˉindex
        );
    if !View.Found { return false; }
    if View.Fields == 0u32 { return Case.Bindingˉlength == 0u32; }
    if Case.Bindingˉlength == 0u32 { return false; }
    let Patternˉstart: Sourceˉlexer.Compilerˉsourceˉtoken =
        Sourceˉbodies.Compilerˉbodyˉtoken(
            Source, Case.Bindingˉoffset, 1u32, 1u32,
            Case.Bindingˉoffset + Case.Bindingˉlength
        );
    if Patternˉstart.Kind != Sourceˉlexer.Compilerˉtokenˉkind.Leftˉbrace {
        return View.Fields == 1u32;
    }
    let Seenˉresult: Byteˉconstruction.Foundationˉbytesˉresult =
        Byteˉconstruction.Foundationˉbytesˉrepeat(0u8, View.Fields);
    if !Seenˉresult.Valid { return false; }
    var Seen: bytes = Seenˉresult.Value;
    var Cursor: u32 = Patternˉstart.Nextˉoffset;
    var Line: u32 = Patternˉstart.Nextˉline;
    var Column: u32 = Patternˉstart.Nextˉcolumn;
    var Fields: u32 = 0u32;
    var Reading: bool = true;
    var Valid: bool = true;
    while Reading {
        let Field: Sourceˉlexer.Compilerˉsourceˉtoken =
            Sourceˉbodies.Compilerˉbodyˉtoken(
                Source, Cursor, Line, Column,
                Case.Bindingˉoffset + Case.Bindingˉlength
            );
        if Field.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Rightˉbrace {
            Reading = false;
        } else {
            let Member: Compilerˉsourceˉwirˉmember =
                Compilerˉsourceˉwirˉvariantˉfieldˉbyˉname(
                    Input, Scan, Symbols, Nominal, Caseˉindex,
                    Source, Field.Offset, Field.Length
                );
            if !Member.Found || Member.Index >= View.Fields {
                Valid = false;
            } else {
                if Bytesˉreadˉu8(Seen, Member.Index) != 0u8 {
                    Valid = false;
                }
                let Updated: Byteˉconstruction.Foundationˉbytesˉresult =
                    Byteˉconstruction.Foundationˉbytesˉreplace(
                        Seen, Member.Index, 1u32, Bytesˉfromˉu8(1u8)
                    );
                if !Updated.Valid {
                    Valid = false;
                } else {
                    Seen = Updated.Value;
                }
            }
            Fields = Fields + 1u32;
            let Colon: Sourceˉlexer.Compilerˉsourceˉtoken =
                Sourceˉbodies.Compilerˉbodyˉtoken(
                    Source, Field.Nextˉoffset,
                    Field.Nextˉline, Field.Nextˉcolumn,
                    Case.Bindingˉoffset + Case.Bindingˉlength
                );
            let Pattern: Sourceˉlexer.Compilerˉsourceˉtoken =
                Sourceˉbodies.Compilerˉbodyˉtoken(
                    Source, Colon.Nextˉoffset,
                    Colon.Nextˉline, Colon.Nextˉcolumn,
                    Case.Bindingˉoffset + Case.Bindingˉlength
                );
            let Separator: Sourceˉlexer.Compilerˉsourceˉtoken =
                Sourceˉbodies.Compilerˉbodyˉtoken(
                    Source, Pattern.Nextˉoffset,
                    Pattern.Nextˉline, Pattern.Nextˉcolumn,
                    Case.Bindingˉoffset + Case.Bindingˉlength
                );
            if Separator.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Comma {
                Cursor = Separator.Nextˉoffset;
                Line = Separator.Nextˉline;
                Column = Separator.Nextˉcolumn;
            } else {
                Reading = false;
            }
        }
    }
    return Valid && Fields == View.Fields;
}

fn Compilerˉsourceˉwirˉbindˉvariantˉpattern(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Source: bytes,
    Value: u32,
    Nominal: u32,
    Caseˉindex: u32,
    Case: Sourceˉbodies.Compilerˉsourceˉmatchˉcase,
    Bindings: Sourceˉbindings.Compilerˉsourceˉbindingˉbuild,
    Build: Compilerˉsourceˉwirˉbuild
) -> Compilerˉsourceˉwirˉbuild {
    let View: Compilerˉsourceˉwirˉvariantˉcaseˉview =
        Compilerˉsourceˉwirˉvariantˉcaseˉviewˉbyˉindex(
            Input, Scan, Symbols, Nominal, Caseˉindex
        );
    if !View.Found || View.Fields == 0u32 { return Build; }
    let Patternˉstart: Sourceˉlexer.Compilerˉsourceˉtoken =
        Sourceˉbodies.Compilerˉbodyˉtoken(
            Source, Case.Bindingˉoffset, 1u32, 1u32,
            Case.Bindingˉoffset + Case.Bindingˉlength
        );
    if Patternˉstart.Kind != Sourceˉlexer.Compilerˉtokenˉkind.Leftˉbrace {
        let Legacyˉbinding: Sourceˉbindings.Compilerˉsourceˉlocalˉmatch =
            Sourceˉbindings.Compilerˉsourceˉbindingsˉfindˉlocal(
                Source, Bindings.Payload,
                Bindings.Entries - Bindings.Nextˉslot, Bindings.Entries,
                Case.Bindingˉoffset, Case.Bindingˉlength,
                Case.Blockˉoffset
            );
        if !Legacyˉbinding.Found {
            return Compilerˉsourceˉwirˉbuildˉfailure(
                Build, Compilerˉsourceˉwirˉstatus.Invalidˉvariantˉbinding,
                Build.Currentˉmodule, Build.Currentˉmodule,
                Build.Currentˉfunction, Case.Bindingˉoffset, 1u32, 1u32
            );
        }
        let Legacyˉfield: Compilerˉsourceˉwirˉmember =
            Compilerˉsourceˉwirˉvariantˉfieldˉbyˉindex(
                Input, Scan, Symbols, Nominal, Caseˉindex, 0u32
            );
        let Payload: Compilerˉsourceˉwirˉvalue =
            Compilerˉsourceˉwirˉemit(
                Build, WIR_OPERATION_VARIANT_PAYLOAD,
                Legacyˉfield.Shape,
                Compilerˉsourceˉwirˉoneˉoperand(Value),
                Nominal, Caseˉindex,
                Case.Bindingˉoffset, Case.Bindingˉlength
            );
        let Legacyˉstored: Compilerˉsourceˉwirˉvalue =
            Compilerˉsourceˉwirˉemit(
                Compilerˉsourceˉwirˉvalueˉbuild(Payload),
                WIR_OPERATION_STORE_LOCAL, 0u32,
                Compilerˉsourceˉwirˉoneˉoperand(Payload.Temporary),
                Legacyˉbinding.Slot, 0u32,
                Case.Bindingˉoffset, Case.Bindingˉlength
            );
        return Compilerˉsourceˉwirˉvalueˉbuild(Legacyˉstored);
    }
    var Result: Compilerˉsourceˉwirˉbuild = Build;
    var Cursor: u32 = Patternˉstart.Nextˉoffset;
    var Line: u32 = Patternˉstart.Nextˉline;
    var Column: u32 = Patternˉstart.Nextˉcolumn;
    var Index: u32 = 0u32;
    while Index < View.Fields {
        let Field: Sourceˉlexer.Compilerˉsourceˉtoken =
            Sourceˉbodies.Compilerˉbodyˉtoken(
                Source, Cursor, Line, Column,
                Case.Bindingˉoffset + Case.Bindingˉlength
            );
        let Colon: Sourceˉlexer.Compilerˉsourceˉtoken =
            Sourceˉbodies.Compilerˉbodyˉtoken(
                Source, Field.Nextˉoffset,
                Field.Nextˉline, Field.Nextˉcolumn,
                Case.Bindingˉoffset + Case.Bindingˉlength
            );
        let Name: Sourceˉlexer.Compilerˉsourceˉtoken =
            Sourceˉbodies.Compilerˉbodyˉtoken(
                Source, Colon.Nextˉoffset,
                Colon.Nextˉline, Colon.Nextˉcolumn,
                Case.Bindingˉoffset + Case.Bindingˉlength
            );
        let Member: Compilerˉsourceˉwirˉmember =
            Compilerˉsourceˉwirˉvariantˉfieldˉbyˉname(
                Input, Scan, Symbols, Nominal, Caseˉindex,
                Source, Field.Offset, Field.Length
            );
        let Discard: bool = Name.Length == 1u32 &&
            Bytesˉreadˉu8(Source, Name.Offset) == 95u8;
        if !Discard {
            let Fieldˉbinding: Sourceˉbindings.Compilerˉsourceˉlocalˉmatch =
                Sourceˉbindings.Compilerˉsourceˉbindingsˉfindˉlocal(
                    Source, Bindings.Payload,
                    Bindings.Entries - Bindings.Nextˉslot,
                    Bindings.Entries, Name.Offset, Name.Length,
                    Case.Blockˉoffset
                );
            if !Fieldˉbinding.Found || !Member.Found {
                return Compilerˉsourceˉwirˉbuildˉfailure(
                    Result,
                    Compilerˉsourceˉwirˉstatus.Invalidˉvariantˉbinding,
                    Build.Currentˉmodule, Build.Currentˉmodule,
                    Build.Currentˉfunction, Name.Offset, 1u32, 1u32
                );
            }
            let Selected: Compilerˉsourceˉwirˉvalue =
                Compilerˉsourceˉwirˉemit(
                    Result,
                    WIR_OPERATION_VARIANT_FIELD,
                    Member.Shape,
                    Compilerˉsourceˉwirˉoneˉoperand(Value),
                    Nominal, Caseˉindex * 64u32 + Member.Index,
                    Field.Offset, Field.Length
                );
            let Fieldˉstored: Compilerˉsourceˉwirˉvalue =
                Compilerˉsourceˉwirˉemit(
                    Compilerˉsourceˉwirˉvalueˉbuild(Selected),
                    WIR_OPERATION_STORE_LOCAL, 0u32,
                    Compilerˉsourceˉwirˉoneˉoperand(Selected.Temporary),
                    Fieldˉbinding.Slot, 0u32,
                    Name.Offset, Name.Length
                );
            Result = Compilerˉsourceˉwirˉvalueˉbuild(Fieldˉstored);
        }
        let Separator: Sourceˉlexer.Compilerˉsourceˉtoken =
            Sourceˉbodies.Compilerˉbodyˉtoken(
                Source, Name.Nextˉoffset,
                Name.Nextˉline, Name.Nextˉcolumn,
                Case.Bindingˉoffset + Case.Bindingˉlength
            );
        Cursor = Separator.Nextˉoffset;
        Line = Separator.Nextˉline;
        Column = Separator.Nextˉcolumn;
        Index = Index + 1u32;
    }
    return Result;
}

export fn Compilerˉsourceˉwirˉvariantˉcaseˉbyˉindex(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Nominal: u32,
    Case: u32
) -> Compilerˉsourceˉwirˉmember {
    let View: Compilerˉsourceˉwirˉvariantˉcaseˉview =
        Compilerˉsourceˉwirˉvariantˉcaseˉviewˉbyˉindex(
            Input, Scan, Symbols, Nominal, Case
        );
    if !View.Found {
        return Compilerˉsourceˉwirˉmember(false, 0u32, 0u32);
    }
    if View.Fields == 0u32 {
        return Compilerˉsourceˉwirˉmember(true, Case, 0u32);
    }
    let Field: Compilerˉsourceˉwirˉmember =
        Compilerˉsourceˉwirˉvariantˉfieldˉbyˉindex(
            Input, Scan, Symbols, Nominal, Case, 0u32
        );
    return Compilerˉsourceˉwirˉmember(Field.Found, Case, Field.Shape);
}

export fn Compilerˉsourceˉwirˉdynamicˉoperandˉshape(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Bindings: Sourceˉbindings.Compilerˉsourceˉbindingˉsummary,
    Operation: u32,
    Target: u32,
    Auxiliary: u32,
    Index: u32
) -> u32 {
    let Symbolˉentries: u32 = Bytesˉreadˉu32ˉlittle(Symbols.Directory, 8u32);
    if Operation == 17u32 {
        if Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉshapeˉisˉprivate(
                Target
            ) {
            let Typeˉcatalog:
                Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog =
                Genericˉbindings.Compilerˉsourceˉbindingsˉgenericˉtypesˉtypeˉcatalog(
                    Bindings.Directory
                );
            let Instance: u32 =
                Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉshapeˉinstance(
                    Target
                );
            let Layout: Genericˉlayouts.Compilerˉsourceˉgenericˉtypeˉlayout =
                Genericˉlayouts.Compilerˉsourceˉgenericˉtypeˉlayoutˉcreate(
                    Input, Scan, Symbols, Typeˉcatalog, Instance
                );
            if Layout.Kind !=
                    Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Record ||
                Layout.Declaration != Auxiliary || Index >= Layout.Fields ||
                Bytesˉlength(Layout.Fieldˉevidence) != Layout.Fields * 16u32 ||
                !Genericˉlayouts.Compilerˉsourceˉgenericˉtypeˉlayoutˉisˉvalid(
                    Input, Scan, Symbols, Layout
                ) {
                return 0u32;
            }
            return Bytesˉreadˉu32ˉlittle(
                Layout.Fieldˉevidence, Index * 16u32 + 8u32
            );
        }
        if Auxiliary >= Symbolˉentries { return 0u32; }
        let Recordˉentry: u32 = 16u32 + Auxiliary * 24u32;
        if Bytesˉreadˉu32ˉlittle(Symbols.Directory, Recordˉentry + 4u32) != 4u32 {
            return 0u32;
        }
        let Recordˉmodule: u32 = Bytesˉreadˉu32ˉlittle(Symbols.Directory, Recordˉentry);
        let Recordˉitems: u32 = Bytesˉreadˉu32ˉlittle(Symbols.Directory, Recordˉentry + 20u32);
        let Recordˉcallable: Sourceˉbindings.Compilerˉsourceˉbindingˉmatch = Sourceˉbindings.Compilerˉsourceˉbindingˉmatch(
            true, true, Sourceˉbindings.Compilerˉsourceˉcallableˉkind.Record,
            Recordˉmodule, Recordˉitems, Auxiliary
        );
        let Recordˉsignature: Compilerˉsourceˉwirˉsignature = Compilerˉsourceˉwirˉrecordˉsignature(
            Input, Scan, Symbols, Recordˉcallable, Index
        );
        if Recordˉsignature.Target != Target { return 0u32; }
        return Recordˉsignature.Parameterˉshape;
    }
    if Operation == 65u32 {
        let Variantˉfield: Compilerˉsourceˉwirˉmember =
            Compilerˉsourceˉwirˉvariantˉfieldˉbyˉindex(
                Input, Scan, Symbols, Target, Auxiliary, Index
            );
        if !Variantˉfield.Found { return 0u32; }
        return Variantˉfield.Shape;
    }
    if Operation == 62u32 {
        if Target >= Sourceˉbindings.Compilerˉsourceˉbindingsˉrangesˉcount(
            Bindings.Directory
        ) { return 0u32; }
        let Declaration: u32 =
            Sourceˉbindings.Compilerˉsourceˉbindingsˉrangeˉdeclaration(
                Bindings.Directory, Target
            );
        if Declaration >= Symbolˉentries { return 0u32; }
        let Functionˉentry: u32 = 16u32 + Declaration * 24u32;
        if Bytesˉreadˉu32ˉlittle(Symbols.Directory, Functionˉentry + 4u32) != 6u32 {
            return 0u32;
        }
        return Compilerˉsourceˉwirˉbindingˉshape(
            Bindings, Symbolˉentries, Target, Index
        );
    }
    if Target >= Symbolˉentries { return 0u32; }
    let Targetˉentry: u32 = 16u32 + Target * 24u32;
    let Targetˉmodule: u32 = Bytesˉreadˉu32ˉlittle(Symbols.Directory, Targetˉentry);
    let Targetˉkind: u32 = Bytesˉreadˉu32ˉlittle(Symbols.Directory, Targetˉentry + 4u32);
    let Targetˉdeclarationˉoffset: u32 = Bytesˉreadˉu32ˉlittle(
        Symbols.Directory, Targetˉentry + 8u32
    );
    let Targetˉnameˉoffset: u32 = Bytesˉreadˉu32ˉlittle(
        Symbols.Directory, Targetˉentry + 12u32
    );
    let Targetˉnameˉlength: u32 = Bytesˉreadˉu32ˉlittle(
        Symbols.Directory, Targetˉentry + 16u32
    );
    let Targetˉview: Sourceˉset.Compilerˉsourceˉsetˉview = Sourceˉset.Compilerˉsourceˉsetˉmodule(
        Input, Scan, Targetˉmodule
    );
    if Operation == 63u32 {
        if Targetˉkind != 2u32 { return 0u32; }
        return Compilerˉsourceˉwirˉcapabilityˉparameterˉshape(
            Targetˉview.Source, Targetˉnameˉoffset, Targetˉnameˉlength, Index
        );
    }
    return 0u32;
}

export fn Compilerˉsourceˉwirˉdynamicˉresultˉisˉvalid(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Bindings: Sourceˉbindings.Compilerˉsourceˉbindingˉsummary,
    Directory: bytes,
    Operation: u32,
    Shape: u32,
    Operandˉcount: u32,
    Target: u32,
    Auxiliary: u32
) -> bool {
    let Symbolˉentries: u32 = Bytesˉreadˉu32ˉlittle(Symbols.Directory, 8u32);
    let Typeˉcatalog: Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog =
        Genericˉbindings.Compilerˉsourceˉbindingsˉgenericˉtypesˉtypeˉcatalog(
            Bindings.Directory
        );
    if Operation == 68u32 {
        if !Compilerˉsourceˉwirˉshapeˉisˉbuilder(Shape) { return false; }
        if Operandˉcount != 0u32 { return false; }
        if Target != Compilerˉsourceˉwirˉcollectionˉdescriptor(Shape) { return false; }
        if Auxiliary != Compilerˉsourceˉwirˉcollectionˉmaximum(Shape) { return false; }
        return Auxiliary > 0u32;
    }
    if Operation == 17u32 {
        if Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉshapeˉisˉprivate(
                Shape
            ) {
            if Target != Shape { return false; }
            let Instance: u32 =
                Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉshapeˉinstance(
                    Shape
                );
            let Layout: Genericˉlayouts.Compilerˉsourceˉgenericˉtypeˉlayout =
                Genericˉlayouts.Compilerˉsourceˉgenericˉtypeˉlayoutˉcreate(
                    Input, Scan, Symbols, Typeˉcatalog, Instance
                );
            return Layout.Shape == Shape && Layout.Declaration == Auxiliary &&
                Layout.Kind ==
                    Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Record &&
                Layout.Fields == Operandˉcount &&
                Genericˉlayouts.Compilerˉsourceˉgenericˉtypeˉlayoutˉisˉvalid(
                    Input, Scan, Symbols, Layout
                );
        }
        if Shape < 65536u32 { return false; }
        if Shape >= 131072u32 { return false; }
        if Target != Shape - 65536u32 { return false; }
        if Auxiliary >= Symbolˉentries { return false; }
        let Recordˉentry: u32 = 16u32 + Auxiliary * 24u32;
        if Bytesˉreadˉu32ˉlittle(Symbols.Directory, Recordˉentry + 4u32) != 4u32 {
            return false;
        }
        if Bytesˉreadˉu32ˉlittle(Symbols.Directory, Recordˉentry + 20u32) != Operandˉcount {
            return false;
        }
        return Compilerˉsourceˉwirˉnominalˉdirectoryˉentry(
            Symbols, Target, 4u32
        ) == Auxiliary;
    }
    if Operation == 18u32 {
        if Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉshapeˉisˉprivate(
                Target
            ) {
            let Operandˉinstance: u32 =
                Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉshapeˉinstance(
                    Target
                );
            let Operandˉlayout: Genericˉlayouts.Compilerˉsourceˉgenericˉtypeˉlayout =
                Genericˉlayouts.Compilerˉsourceˉgenericˉtypeˉlayoutˉcreate(
                    Input, Scan, Symbols, Typeˉcatalog, Operandˉinstance
                );
            if Operandˉlayout.Shape != Target || Operandˉlayout.Kind !=
                    Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Record ||
                Auxiliary >= Operandˉlayout.Fields ||
                Bytesˉlength(Operandˉlayout.Fieldˉevidence) != Operandˉlayout.Fields * 16u32 ||
                !Genericˉlayouts.Compilerˉsourceˉgenericˉtypeˉlayoutˉisˉvalid(
                    Input, Scan, Symbols, Operandˉlayout
                ) {
                return false;
            }
            return Shape == Bytesˉreadˉu32ˉlittle(
                Operandˉlayout.Fieldˉevidence, Auxiliary * 16u32 + 8u32
            );
        }
        if Target >= Symbols.Records { return false; }
        let Fieldˉrecordˉentry: u32 = Compilerˉsourceˉwirˉnominalˉdirectoryˉentry(
            Symbols, Target, 4u32
        );
        if Fieldˉrecordˉentry == Compilerˉsourceˉwirˉsentinel() { return false; }
        let Fieldˉsymbolˉentry: u32 = 16u32 + Fieldˉrecordˉentry * 24u32;
        let Fieldˉcount: u32 = Bytesˉreadˉu32ˉlittle(
            Symbols.Directory, Fieldˉsymbolˉentry + 20u32
        );
        if Auxiliary >= Fieldˉcount { return false; }
        let Fieldˉmodule: u32 = Bytesˉreadˉu32ˉlittle(Symbols.Directory, Fieldˉsymbolˉentry);
        let Fieldˉcallable: Sourceˉbindings.Compilerˉsourceˉbindingˉmatch = Sourceˉbindings.Compilerˉsourceˉbindingˉmatch(
            true, true, Sourceˉbindings.Compilerˉsourceˉcallableˉkind.Record,
            Fieldˉmodule, Fieldˉcount, Fieldˉrecordˉentry
        );
        let Fieldˉsignature: Compilerˉsourceˉwirˉsignature = Compilerˉsourceˉwirˉrecordˉsignature(
            Input, Scan, Symbols, Fieldˉcallable, Auxiliary
        );
        return Shape == Fieldˉsignature.Parameterˉshape;
    }
    if Operation == 19u32 {
        if Shape < 131072u32 + Symbols.Records { return false; }
        if Shape >= 131072u32 + Symbols.Records + Symbols.Enums { return false; }
        let Enumˉnominal: u32 = Shape - 131072u32;
        if Target != Enumˉnominal { return false; }
        let Enumˉentry: u32 = Compilerˉsourceˉwirˉnominalˉdirectoryˉentry(
            Symbols, Enumˉnominal, 5u32
        );
        if Enumˉentry == Compilerˉsourceˉwirˉsentinel() { return false; }
        let Enumˉsymbolˉentry: u32 = 16u32 + Enumˉentry * 24u32;
        return Auxiliary < Bytesˉreadˉu32ˉlittle(
            Symbols.Directory, Enumˉsymbolˉentry + 20u32
        );
    }
    if Operation >= 65u32 {
        if Operation <= 67u32 {
            let Variantˉcase: Compilerˉsourceˉwirˉmember =
                Compilerˉsourceˉwirˉvariantˉcaseˉbyˉindex(
                    Input, Scan, Symbols, Target, Auxiliary
                );
            if !Variantˉcase.Found { return false; }
            let Variantˉview: Compilerˉsourceˉwirˉvariantˉcaseˉview =
                Compilerˉsourceˉwirˉvariantˉcaseˉviewˉbyˉindex(
                    Input, Scan, Symbols, Target, Auxiliary
                );
            if !Variantˉview.Found { return false; }
            if Operation == 65u32 {
                var Variantˉresultˉshape: u32 = 196608u32 + Target;
                if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉshapeˉisˉfoundationˉgeneric(Target) {
                    Variantˉresultˉshape = Target;
                }
                if Shape != Variantˉresultˉshape { return false; }
                return Operandˉcount == Variantˉview.Fields;
            }
            if Operandˉcount != 1u32 { return false; }
            if Operation == 66u32 { return Shape == 4u32; }
            if Variantˉview.Fields != 1u32 { return false; }
            return Shape == Variantˉcase.Shape;
        }
    }
    if Operation == 164u32 {
        let Case: u32 = Auxiliary / 64u32;
        let Fieldˉindex: u32 = Auxiliary - Case * 64u32;
        let Field: Compilerˉsourceˉwirˉmember =
            Compilerˉsourceˉwirˉvariantˉfieldˉbyˉindex(
                Input, Scan, Symbols, Target, Case, Fieldˉindex
            );
        if !Field.Found { return false; }
        if Operandˉcount != 1u32 { return false; }
        return Shape == Field.Shape;
    }
    if Operation == 62u32 {
        if Target >= Bytesˉreadˉu32ˉlittle(Directory, 8u32) { return false; }
        let Declaration: u32 =
            Sourceˉbindings.Compilerˉsourceˉbindingsˉrangeˉdeclaration(
                Bindings.Directory, Target
            );
        if Declaration >= Symbolˉentries { return false; }
        let Functionˉentry: u32 = 16u32 + Declaration * 24u32;
        if Bytesˉreadˉu32ˉlittle(Symbols.Directory, Functionˉentry + 4u32) != 6u32 {
            return false;
        }
        if Bytesˉreadˉu32ˉlittle(Symbols.Directory, Functionˉentry + 20u32) != Operandˉcount {
            return false;
        }
        if Auxiliary != 0u32 { return false; }
        let Wirˉfunctionˉentry: u32 =
            Compilerˉsourceˉwirˉfunctionsˉoffset(Directory) + Target * 48u32;
        let Returnˉshape: u32 = Bytesˉreadˉu32ˉlittle(
            Directory, Wirˉfunctionˉentry + 44u32
        );
        if Returnˉshape == 10u32 { return Shape == 0u32; }
        return Shape == Returnˉshape;
    }
    if Operation == 63u32 {
        if Target >= Symbolˉentries { return false; }
        let Capabilityˉentry: u32 = 16u32 + Target * 24u32;
        if Bytesˉreadˉu32ˉlittle(Symbols.Directory, Capabilityˉentry + 4u32) != 2u32 {
            return false;
        }
        let Capabilityˉmodule: u32 = Bytesˉreadˉu32ˉlittle(Symbols.Directory, Capabilityˉentry);
        let Capabilityˉnameˉoffset: u32 = Bytesˉreadˉu32ˉlittle(
            Symbols.Directory, Capabilityˉentry + 12u32
        );
        let Capabilityˉnameˉlength: u32 = Bytesˉreadˉu32ˉlittle(
            Symbols.Directory, Capabilityˉentry + 16u32
        );
        let Capabilityˉview: Sourceˉset.Compilerˉsourceˉsetˉview = Sourceˉset.Compilerˉsourceˉsetˉmodule(
            Input, Scan, Capabilityˉmodule
        );
        if Sourceˉbindings.Compilerˉsourceˉbindingsˉcapabilityˉarity(
            Capabilityˉview.Source,
            Capabilityˉnameˉoffset,
            Capabilityˉnameˉlength
        ) != Operandˉcount { return false; }
        if Auxiliary != 0u32 { return false; }
        return Shape == Compilerˉsourceˉwirˉcapabilityˉreturnˉshape(
            Capabilityˉview.Source, Capabilityˉnameˉoffset, Capabilityˉnameˉlength
        );
    }
    return true;
}

export fn Compilerˉsourceˉwirˉfunctionˉoperationsˉareˉvalid(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Bindings: Sourceˉbindings.Compilerˉsourceˉbindingˉsummary,
    Directory: bytes,
    Blocksˉoffset: u32,
    Operationsˉoffset: u32,
    Temporariesˉoffset: u32,
    Operandsˉoffset: u32,
    Function: u32,
    Range: Compilerˉsourceˉwirˉrange
) -> bool {
    let Symbolˉentries: u32 = Bytesˉreadˉu32ˉlittle(Symbols.Directory, 8u32);
    let Typeˉcatalog: Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog =
        Genericˉbindings.Compilerˉsourceˉbindingsˉgenericˉtypesˉtypeˉcatalog(
            Bindings.Directory
        );
    var Inferredˉshapes: bytes = Compilerˉsourceˉwirˉempty(Directory);
    var Inferredˉindex: u32 = 0u32;
    var Hasˉinferredˉlocals: bool = false;
    while Inferredˉindex < Range.Locals {
        if Compilerˉsourceˉwirˉbindingˉshape(
            Bindings, Symbolˉentries, Function,
            Range.Parameters + Inferredˉindex
        ) == 0u32 { Hasˉinferredˉlocals = true; }
        Inferredˉindex = Inferredˉindex + 1u32;
    }
    if Hasˉinferredˉlocals {
        Inferredˉindex = 0u32;
        while Inferredˉindex < Range.Locals {
            Inferredˉshapes = Bytesˉconcat(
                Inferredˉshapes, Bytesˉfromˉu32ˉlittle(0u32)
            );
            Inferredˉindex = Inferredˉindex + 1u32;
        }
    }
    var Operationˉindex: u32 = 0u32;
    var Seenˉtemporaries: u32 = 0u32;
    var Expectedˉoperand: u32 = Range.Firstˉoperand;
    while Operationˉindex < Range.Operationˉcount {
        let Globalˉoperation: u32 = Range.Firstˉoperation + Operationˉindex;
        let Operationˉentry: u32 = Operationsˉoffset + Globalˉoperation * 32u32;
        let Operationˉblock: u32 = Bytesˉreadˉu32ˉlittle(
            Directory, Operationˉentry
        );
        if Operationˉblock >= Range.Blockˉcount { return false; }
        let Ownerˉblockˉentry: u32 = Blocksˉoffset + (
            Range.Firstˉblock + Operationˉblock
        ) * 28u32;
        let Ownerˉblockˉfirst: u32 = Bytesˉreadˉu32ˉlittle(
            Directory, Ownerˉblockˉentry + 4u32
        );
        let Ownerˉblockˉcount: u32 = Bytesˉreadˉu32ˉlittle(
            Directory, Ownerˉblockˉentry + 8u32
        );
        let Operationˉkind: u32 = Bytesˉreadˉu32ˉlittle(Directory, Operationˉentry + 4u32);
        let Operationˉshape: u32 = Bytesˉreadˉu32ˉlittle(Directory, Operationˉentry + 8u32);
        let Operationˉtemporary: u32 = Bytesˉreadˉu32ˉlittle(
            Directory, Operationˉentry + 12u32
        );
        let Firstˉoperand: u32 = Bytesˉreadˉu32ˉlittle(Directory, Operationˉentry + 16u32);
        let Operandˉcount: u32 = Bytesˉreadˉu32ˉlittle(Directory, Operationˉentry + 20u32);
        let Operationˉtarget: u32 = Bytesˉreadˉu32ˉlittle(Directory, Operationˉentry + 24u32);
        let Operationˉauxiliary: u32 = Bytesˉreadˉu32ˉlittle(Directory, Operationˉentry + 28u32);
        if Bytesˉreadˉu32ˉlittle(Directory, Ownerˉblockˉentry) != Operationˉblock {
            return false;
        }
        if Globalˉoperation < Ownerˉblockˉfirst { return false; }
        if Globalˉoperation - Ownerˉblockˉfirst >= Ownerˉblockˉcount { return false; }
        if Operationˉkind == 0u32 { return false; }
        if Operationˉkind > 164u32 { return false; }
        if !Compilerˉsourceˉwirˉshapeˉisˉvalidˉwithˉgenericˉtypes(
            Operationˉshape, Symbols, Typeˉcatalog, true
        ) {
            return false;
        }
        if !Compilerˉsourceˉwirˉoperationˉresultˉisˉvalid(
            Operationˉkind, Operationˉshape
        ) { return false; }
        let Availableˉtemporaries: u32 = Seenˉtemporaries;
        if Operationˉshape == 0u32 {
            if Operationˉtemporary != Compilerˉsourceˉwirˉsentinel() {
                return false;
            }
        } else {
            if Operationˉtemporary != Seenˉtemporaries { return false; }
            if Seenˉtemporaries >= Range.Temporaryˉcount { return false; }
            let Resultˉtemporaryˉshape: u32 = Bytesˉreadˉu32ˉlittle(
                Directory,
                Temporariesˉoffset + (Range.Firstˉtemporary + Seenˉtemporaries) * 4u32
            );
            if Resultˉtemporaryˉshape != Operationˉshape { return false; }
            Seenˉtemporaries = Seenˉtemporaries + 1u32;
        }
        if Firstˉoperand != Expectedˉoperand { return false; }
        let Functionˉoperandˉend: u32 = Range.Firstˉoperand + Range.Operandˉcount;
        if Firstˉoperand > Functionˉoperandˉend { return false; }
        if Operandˉcount > Functionˉoperandˉend - Firstˉoperand { return false; }
        if !Compilerˉsourceˉwirˉoperationˉoperandˉcountˉisˉvalid(
            Operationˉkind, Operandˉcount
        ) { return false; }
        var Operandˉindex: u32 = 0u32;
        var Firstˉoperandˉshape: u32 = 0u32;
        while Operandˉindex < Operandˉcount {
            let Operandˉentry: u32 = Operandsˉoffset + (Firstˉoperand + Operandˉindex) * 4u32;
            let Operandˉtemporary: u32 = Bytesˉreadˉu32ˉlittle(Directory, Operandˉentry);
            if Operandˉtemporary >= Availableˉtemporaries { return false; }
            let Operandˉshape: u32 = Bytesˉreadˉu32ˉlittle(
                Directory,
                Temporariesˉoffset + (Range.Firstˉtemporary + Operandˉtemporary) * 4u32
            );
            if Operandˉindex == 0u32 { Firstˉoperandˉshape = Operandˉshape; }
            if !Compilerˉsourceˉwirˉoperationˉoperandˉshapeˉisˉvalid(
                Operationˉkind, Operandˉindex, Operandˉshape
            ) { return false; }
            if Operationˉkind == 17u32 {
                let Recordˉoperandˉshape: u32 = Compilerˉsourceˉwirˉdynamicˉoperandˉshape(
                    Input, Scan, Symbols, Bindings, Operationˉkind,
                    Operationˉtarget, Operationˉauxiliary, Operandˉindex
                );
                if Operandˉshape != Recordˉoperandˉshape { return false; }
            }
            if Operationˉkind == 65u32 {
                let Variantˉoperandˉshape: u32 = Compilerˉsourceˉwirˉdynamicˉoperandˉshape(
                    Input, Scan, Symbols, Bindings, Operationˉkind,
                    Operationˉtarget, Operationˉauxiliary, Operandˉindex
                );
                if Operandˉshape != Variantˉoperandˉshape { return false; }
            }
            if Operationˉkind == 164u32 {
                var Variantˉfieldˉownerˉshape: u32 = 196608u32 + Operationˉtarget;
                if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉshapeˉisˉfoundationˉgeneric(Operationˉtarget) {
                    Variantˉfieldˉownerˉshape = Operationˉtarget;
                }
                if Operandˉshape != Variantˉfieldˉownerˉshape {
                    return false;
                }
            }
            if Operationˉkind == 62u32 {
                let Callˉoperandˉshape: u32 = Compilerˉsourceˉwirˉdynamicˉoperandˉshape(
                    Input, Scan, Symbols, Bindings, Operationˉkind,
                    Operationˉtarget, Operationˉauxiliary, Operandˉindex
                );
                if Operandˉshape != Callˉoperandˉshape { return false; }
            }
            if Operationˉkind == 63u32 {
                let Capabilityˉoperandˉshape: u32 = Compilerˉsourceˉwirˉdynamicˉoperandˉshape(
                    Input, Scan, Symbols, Bindings, Operationˉkind,
                    Operationˉtarget, Operationˉauxiliary, Operandˉindex
                );
                if Operandˉshape != Capabilityˉoperandˉshape { return false; }
            }
            if Operationˉkind == 20u32 {
                if Operandˉshape != Firstˉoperandˉshape { return false; }
            }
            if Operationˉkind == 21u32 {
                if Operandˉshape != Firstˉoperandˉshape { return false; }
            }
            if Operationˉkind == 64u32 {
                if Operandˉshape != Operationˉshape { return false; }
            }
            if Operationˉkind >= 130u32 {
                if Operationˉkind <= 145u32 {
                    if Operandˉshape != Firstˉoperandˉshape { return false; }
                }
            }
            if Operationˉkind == 149u32 || Operationˉkind == 150u32 {
                if Operandˉshape != Firstˉoperandˉshape { return false; }
            }
            if Operationˉkind == 69u32 {
                if Operandˉindex == 1u32 {
                    if Operandˉshape != Compilerˉsourceˉwirˉcollectionˉelementˉshape(Firstˉoperandˉshape) {
                        return false;
                    }
                }
            }
            Operandˉindex = Operandˉindex + 1u32;
        }
        if Operationˉkind == 7u32 {
            if Operationˉtarget >= Range.Parameters + Range.Locals { return false; }
            var Loadedˉshape: u32 = Compilerˉsourceˉwirˉbindingˉshape(
                Bindings, Symbolˉentries, Function, Operationˉtarget
            );
            if Loadedˉshape == 0u32 {
                if Operationˉtarget < Range.Parameters { return false; }
                Loadedˉshape = Bytesˉreadˉu32ˉlittle(
                    Inferredˉshapes,
                    (Operationˉtarget - Range.Parameters) * 4u32
                );
                if Loadedˉshape == 0u32 { return false; }
            }
            if Operationˉshape != Loadedˉshape { return false; }
            if Operationˉauxiliary != 0u32 { return false; }
        }
        if Operationˉkind == 8u32 {
            if Operationˉtarget >= Range.Parameters + Range.Locals { return false; }
            var Storedˉshape: u32 = Compilerˉsourceˉwirˉbindingˉshape(
                Bindings, Symbolˉentries, Function, Operationˉtarget
            );
            if Storedˉshape == 0u32 {
                if Operationˉtarget < Range.Parameters { return false; }
                let Inferredˉoffset: u32 = (
                    Operationˉtarget - Range.Parameters
                ) * 4u32;
                Storedˉshape = Bytesˉreadˉu32ˉlittle(
                    Inferredˉshapes, Inferredˉoffset
                );
                if Storedˉshape == 0u32 {
                    Storedˉshape = Firstˉoperandˉshape;
                    let Inferredˉsuffixˉoffset: u32 = Inferredˉoffset + 4u32;
                    Inferredˉshapes = Bytesˉconcat(
                        Bytesˉconcat(
                            Bytesˉslice(Inferredˉshapes, 0u32, Inferredˉoffset),
                            Bytesˉfromˉu32ˉlittle(Storedˉshape)
                        ),
                        Bytesˉslice(
                            Inferredˉshapes,
                            Inferredˉsuffixˉoffset,
                            Bytesˉlength(Inferredˉshapes) - Inferredˉsuffixˉoffset
                        )
                    );
                }
            }
            if Firstˉoperandˉshape != Storedˉshape { return false; }
            if Operationˉauxiliary != 0u32 { return false; }
        }
        if Operationˉkind == 9u32 {
            if Operationˉtarget >= Symbolˉentries { return false; }
            let Lengthˉdataˉentry: u32 = 16u32 + Operationˉtarget * 24u32;
            if Bytesˉreadˉu32ˉlittle(Symbols.Directory, Lengthˉdataˉentry + 4u32) != 3u32 {
                return false;
            }
            if Operationˉauxiliary != 0u32 { return false; }
        }
        if Operationˉkind == 10u32 {
            if Operationˉtarget >= Symbolˉentries { return false; }
            let Loadˉdataˉentry: u32 = 16u32 + Operationˉtarget * 24u32;
            if Bytesˉreadˉu32ˉlittle(Symbols.Directory, Loadˉdataˉentry + 4u32) != 3u32 {
                return false;
            }
            if Operationˉauxiliary != 0u32 { return false; }
        }
        if Operationˉkind == 18u32 {
            if Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉshapeˉisˉprivate(
                    Firstˉoperandˉshape
                ) {
                if Operationˉtarget != Firstˉoperandˉshape { return false; }
            } else {
                if Firstˉoperandˉshape < 65536u32 { return false; }
                if Firstˉoperandˉshape >= 131072u32 { return false; }
                if Operationˉtarget != Firstˉoperandˉshape - 65536u32 {
                    return false;
                }
            }
        }
        if Operationˉkind >= 66u32 {
            if Operationˉkind <= 67u32 {
                var Variantˉoperandˉownerˉshape: u32 = 196608u32 + Operationˉtarget;
                if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉshapeˉisˉfoundationˉgeneric(Operationˉtarget) {
                    Variantˉoperandˉownerˉshape = Operationˉtarget;
                }
                if Firstˉoperandˉshape != Variantˉoperandˉownerˉshape { return false; }
            }
        }
        if Operationˉkind == 69u32 {
            if Operationˉshape != Firstˉoperandˉshape { return false; }
            if Operationˉtarget != 0u32 || Operationˉauxiliary != 0u32 { return false; }
        }
        if Operationˉkind == 70u32 {
            if Operationˉshape != Firstˉoperandˉshape - 268435456u32 { return false; }
            if Operationˉtarget != 0u32 || Operationˉauxiliary != 0u32 { return false; }
        }
        if Operationˉkind == 71u32 {
            if !Compilerˉsourceˉwirˉshapeˉisˉsequence(Firstˉoperandˉshape) { return false; }
            if Operationˉtarget != 0u32 || Operationˉauxiliary != 0u32 { return false; }
        }
        if Operationˉkind == 72u32 {
            if Operationˉshape != Compilerˉsourceˉwirˉcollectionˉelementˉshape(Firstˉoperandˉshape) {
                return false;
            }
            if Operationˉtarget != 0u32 || Operationˉauxiliary != 0u32 { return false; }
        }
        if Operationˉkind >= 130u32 {
            if Operationˉkind <= 135u32 {
                if Operationˉshape != Firstˉoperandˉshape { return false; }
            }
        }
        if Operationˉkind >= 136u32 {
            if Operationˉkind <= 141u32 {
                if Operationˉtarget != Firstˉoperandˉshape { return false; }
            }
        }
        if Operationˉkind >= 142u32 {
            if Operationˉkind <= 147u32 {
                if Operationˉshape != Firstˉoperandˉshape { return false; }
            }
        }
        if Operationˉkind == 149u32 || Operationˉkind == 150u32 {
            if Firstˉoperandˉshape != 16u32 { return false; }
        }
        if Operationˉkind >= 152u32 {
            if Operationˉkind <= 156u32 {
                if Operationˉshape != Firstˉoperandˉshape { return false; }
            }
        }
        if Operationˉkind >= 157u32 {
            if Operationˉkind <= 162u32 {
                if Operationˉtarget != Firstˉoperandˉshape { return false; }
            }
        }
        if Operationˉkind == 64u32 {
            if Globalˉoperation != Ownerˉblockˉfirst { return false; }
            if Operationˉtarget == Operationˉauxiliary { return false; }
            if Operationˉtarget >= Range.Blockˉcount { return false; }
            if Operationˉauxiliary >= Range.Blockˉcount { return false; }
            let Firstˉpredecessor: u32 = Blocksˉoffset + (
                Range.Firstˉblock + Operationˉtarget
            ) * 28u32;
            let Secondˉpredecessor: u32 = Blocksˉoffset + (
                Range.Firstˉblock + Operationˉauxiliary
            ) * 28u32;
            if Bytesˉreadˉu32ˉlittle(Directory, Firstˉpredecessor + 12u32) != 1u32 {
                return false;
            }
            if Bytesˉreadˉu32ˉlittle(Directory, Secondˉpredecessor + 12u32) != 1u32 {
                return false;
            }
            if Bytesˉreadˉu32ˉlittle(Directory, Firstˉpredecessor + 20u32) != Operationˉblock {
                return false;
            }
            if Bytesˉreadˉu32ˉlittle(Directory, Secondˉpredecessor + 20u32) != Operationˉblock {
                return false;
            }
            var Predecessorˉindex: u32 = 0u32;
            while Predecessorˉindex < Range.Blockˉcount {
                let Predecessorˉentry: u32 = Blocksˉoffset + (
                    Range.Firstˉblock + Predecessorˉindex
                ) * 28u32;
                let Predecessorˉterminator: u32 = Bytesˉreadˉu32ˉlittle(
                    Directory, Predecessorˉentry + 12u32
                );
                if Predecessorˉterminator == 1u32 {
                    if Bytesˉreadˉu32ˉlittle(Directory, Predecessorˉentry + 20u32) == Operationˉblock {
                        if Predecessorˉindex != Operationˉtarget &&
                            Predecessorˉindex != Operationˉauxiliary { return false; }
                    }
                }
                if Predecessorˉterminator == 2u32 {
                    if Bytesˉreadˉu32ˉlittle(Directory, Predecessorˉentry + 20u32) == Operationˉblock {
                        return false;
                    }
                    if Bytesˉreadˉu32ˉlittle(Directory, Predecessorˉentry + 24u32) == Operationˉblock {
                        return false;
                    }
                }
                Predecessorˉindex = Predecessorˉindex + 1u32;
            }
        }
        if !Compilerˉsourceˉwirˉdynamicˉresultˉisˉvalid(
            Input, Scan, Symbols, Bindings, Directory,
            Operationˉkind, Operationˉshape, Operandˉcount,
            Operationˉtarget, Operationˉauxiliary
        ) { return false; }
        if Operationˉkind >= 11u32 {
            if Operationˉkind <= 16u32 {
                if Operationˉtarget != Compilerˉsourceˉwirˉsentinel() { return false; }
                if Operationˉauxiliary != 0u32 { return false; }
            }
        }
        if Operationˉkind >= 22u32 {
            if Operationˉkind <= 37u32 {
                if Operationˉtarget != Compilerˉsourceˉwirˉsentinel() { return false; }
                if Operationˉauxiliary != 0u32 { return false; }
            }
        }
        if Operationˉkind >= 38u32 {
            if Operationˉkind <= 61u32 {
                if Operationˉtarget != 0u32 { return false; }
                if Operationˉauxiliary != 0u32 { return false; }
            }
        }
        if Operationˉkind == 95u32 || Operationˉkind == 96u32 {
            if Operationˉtarget != Compilerˉsourceˉwirˉsentinel() { return false; }
            if Operationˉauxiliary != 0u32 { return false; }
        }
        if Operationˉkind >= 126u32 {
            if Operationˉkind <= 128u32 {
            if Operationˉtarget != Compilerˉsourceˉwirˉsentinel() { return false; }
            if Operationˉauxiliary != 0u32 { return false; }
            }
        }
        if Operationˉkind >= 97u32 {
            if Operationˉkind <= 125u32 {
                if Operationˉtarget != 0u32 { return false; }
                if Operationˉauxiliary != 0u32 { return false; }
            }
        }
        if Operationˉkind == 129u32 {
            if Operationˉshape == 11u32 && Operationˉtarget > 255u32 { return false; }
            if Operationˉshape == 12u32 && Operationˉtarget > 65535u32 { return false; }
            if Operationˉshape == 13u32 && Operationˉtarget > 65535u32 { return false; }
            if Operationˉauxiliary != 0u32 { return false; }
        }
        if Operationˉkind >= 130u32 {
            if Operationˉkind <= 135u32 {
                if Operationˉtarget != 0u32 || Operationˉauxiliary != 0u32 { return false; }
            }
        }
        if Operationˉkind >= 136u32 {
            if Operationˉkind <= 141u32 {
                if Operationˉtarget < 11u32 || Operationˉtarget > 13u32 { return false; }
                if Operationˉauxiliary != 0u32 { return false; }
            }
        }
        if Operationˉkind >= 142u32 {
            if Operationˉkind <= 147u32 {
                if Operationˉtarget != 0u32 || Operationˉauxiliary != 0u32 { return false; }
            }
        }
        if Operationˉkind == 148u32 {
            if Operationˉtarget > 1114111u32 { return false; }
            if Operationˉtarget >= 55296u32 && Operationˉtarget <= 57343u32 {
                return false;
            }
            if Operationˉauxiliary != 0u32 { return false; }
        }
        if Operationˉkind == 149u32 || Operationˉkind == 150u32 {
            if Operationˉtarget != 0u32 || Operationˉauxiliary != 0u32 {
                return false;
            }
        }
        if Operationˉkind == 151u32 {
            if Operationˉshape == 14u32 && Operationˉauxiliary != 0u32 {
                return false;
            }
        }
        if Operationˉkind >= 152u32 {
            if Operationˉkind <= 156u32 {
                if Operationˉtarget != 0u32 || Operationˉauxiliary != 0u32 {
                    return false;
                }
            }
        }
        if Operationˉkind >= 157u32 {
            if Operationˉkind <= 162u32 {
                if Operationˉtarget < 14u32 || Operationˉtarget > 15u32 {
                    return false;
                }
                if Operationˉauxiliary != 0u32 { return false; }
            }
        }
        if Operationˉkind == 2u32 {
            if Operationˉtarget > 255u32 { return false; }
            if Operationˉauxiliary != 0u32 { return false; }
        }
        if Operationˉkind == 4u32 {
            if Operationˉtarget > 1u32 { return false; }
            if Operationˉauxiliary != 0u32 { return false; }
        }
        if Operationˉkind == 3u32 {
            if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉshapeˉisˉcapability(
                Symbols.Directory, Operationˉshape
            ) {
                if Operationˉtarget != 0u32 { return false; }
                if Operationˉauxiliary != 0u32 { return false; }
            }
        }
        Expectedˉoperand = Firstˉoperand + Operandˉcount;
        Operationˉindex = Operationˉindex + 1u32;
    }
    if Seenˉtemporaries != Range.Temporaryˉcount { return false; }
    if Hasˉinferredˉlocals {
        Inferredˉindex = 0u32;
        while Inferredˉindex < Range.Locals {
            let Bindingˉshape: u32 = Compilerˉsourceˉwirˉbindingˉshape(
                Bindings, Symbolˉentries, Function,
                Range.Parameters + Inferredˉindex
            );
            if Bindingˉshape == 0u32 {
                if Bytesˉreadˉu32ˉlittle(
                    Inferredˉshapes, Inferredˉindex * 4u32
                ) == 0u32 { return false; }
            }
            Inferredˉindex = Inferredˉindex + 1u32;
        }
    }
    return Expectedˉoperand == Range.Firstˉoperand + Range.Operandˉcount;
}

export fn Compilerˉsourceˉwirˉdirectoryˉisˉvalid(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Bindings: Sourceˉbindings.Compilerˉsourceˉbindingˉsummary,
    Directory: bytes
) -> bool {
    let Directoryˉlength: u32 = Bytesˉlength(Directory);
    if Directoryˉlength < 48u32 { return false; }
    if Directoryˉlength > 4194304u32 { return false; }
    let Magic: bytes = Textˉtoˉutf8("WVIR");
    if !Sourceˉset.Compilerˉsourceˉspansˉequal(
        Directory, 0u32, 4u32, Magic, 0u32, 4u32
    ) { return false; }
    if Bytesˉreadˉu16ˉlittle(Directory, 4u32) != 1u32 { return false; }
    let Minor: u32 = Bytesˉreadˉu16ˉlittle(Directory, 6u32);
    if Minor != 3u32 && Minor != 4u32 { return false; }
    if Minor == 4u32 && Directoryˉlength < 56u32 { return false; }
    let Functionˉentries: u32 = Bytesˉreadˉu32ˉlittle(Directory, 8u32);
    if Bytesˉreadˉu32ˉlittle(Directory, 12u32) != 48u32 { return false; }
    let Blocks: u32 = Bytesˉreadˉu32ˉlittle(Directory, 16u32);
    if Bytesˉreadˉu32ˉlittle(Directory, 20u32) != 28u32 { return false; }
    let Operations: u32 = Bytesˉreadˉu32ˉlittle(Directory, 24u32);
    if Bytesˉreadˉu32ˉlittle(Directory, 28u32) != 32u32 { return false; }
    let Temporaries: u32 = Bytesˉreadˉu32ˉlittle(Directory, 32u32);
    if Bytesˉreadˉu32ˉlittle(Directory, 36u32) != 4u32 { return false; }
    let Operands: u32 = Bytesˉreadˉu32ˉlittle(Directory, 40u32);
    if Bytesˉreadˉu32ˉlittle(Directory, 44u32) != 4u32 { return false; }
    let Symbolˉentries: u32 = Bytesˉreadˉu32ˉlittle(Symbols.Directory, 8u32);
    var Catalog: Sourceˉgenerics.Compilerˉsourceˉgenericˉcatalog =
        Sourceˉgenerics.Compilerˉsourceˉgenericˉcatalogˉempty();
    var Instances: u32 = 0u32;
    if Minor == 3u32 {
        if Functionˉentries != Symbolˉentries { return false; }
    } else {
        Instances = Bytesˉreadˉu32ˉlittle(Directory, 48u32);
        if Bytesˉreadˉu32ˉlittle(Directory, 52u32) != 1u32 ||
            Instances == 0u32 || Instances > 256u32 {
            return false;
        }
        Catalog = Genericˉbindings.Compilerˉsourceˉbindingsˉgenericˉtypesˉfunctionˉcatalog(
            Bindings.Directory
        );
        if !Sourceˉgenerics.Compilerˉsourceˉgenericˉcatalogˉisˉvalid(
            Catalog
        ) {
            return false;
        }
        if Sourceˉgenerics.Compilerˉsourceˉgenericˉcatalogˉinstances(Catalog) !=
                Instances ||
            Functionˉentries != Symbolˉentries + Instances {
            return false;
        }
        if Sourceˉbindings.Compilerˉsourceˉbindingsˉrangesˉcount(
            Bindings.Directory
        ) != Functionˉentries {
            return false;
        }
    }
    if Functionˉentries > 87380u32 { return false; }
    if Blocks > 149796u32 { return false; }
    if Operations > 104857u32 { return false; }
    if Temporaries > 1048564u32 { return false; }
    if Operands > 1048564u32 { return false; }
    let Blocksˉoffset: u32 =
        Compilerˉsourceˉwirˉfunctionsˉoffset(Directory) +
            Functionˉentries * 48u32;
    let Operationsˉoffset: u32 = Blocksˉoffset + Blocks * 28u32;
    let Temporariesˉoffset: u32 = Operationsˉoffset + Operations * 32u32;
    let Operandsˉoffset: u32 = Temporariesˉoffset + Temporaries * 4u32;
    let Expectedˉlength: u32 = Operandsˉoffset + Operands * 4u32;
    if Directoryˉlength != Expectedˉlength { return false; }
    var Function: u32 = 0u32;
    var Expectedˉblock: u32 = 0u32;
    var Expectedˉoperation: u32 = 0u32;
    var Expectedˉtemporary: u32 = 0u32;
    var Expectedˉoperand: u32 = 0u32;
    while Function < Functionˉentries {
        let Range: Compilerˉsourceˉwirˉrange = Compilerˉsourceˉwirˉfunctionˉrange(
            Input, Scan, Symbols, Bindings, Directory, Function,
            Expectedˉblock, Expectedˉoperation, Expectedˉtemporary, Expectedˉoperand,
            Blocks, Operations, Temporaries, Operands
        );
        if !Range.Valid { return false; }
        if Range.Isˉfunction {
            if !Compilerˉsourceˉwirˉfunctionˉblocksˉareˉvalid(
                Directory, Blocksˉoffset, Operationsˉoffset,
                Temporariesˉoffset, Function, Range
            ) { return false; }
            if !Compilerˉsourceˉwirˉfunctionˉoperationsˉareˉvalid(
                Input, Scan, Symbols, Bindings, Directory,
                Blocksˉoffset, Operationsˉoffset,
                Temporariesˉoffset, Operandsˉoffset,
                Function, Range
            ) { return false; }
        }
        Expectedˉblock = Expectedˉblock + Range.Blockˉcount;
        Expectedˉoperation = Expectedˉoperation + Range.Operationˉcount;
        Expectedˉtemporary = Expectedˉtemporary + Range.Temporaryˉcount;
        Expectedˉoperand = Expectedˉoperand + Range.Operandˉcount;
        Function = Function + 1u32;
    }
    if Expectedˉblock != Blocks { return false; }
    if Expectedˉoperation != Operations { return false; }
    if Expectedˉtemporary != Temporaries { return false; }
    return Expectedˉoperand == Operands;
}

export fn Compilerˉsourceˉwirˉevidenceˉfits(Build: Compilerˉsourceˉwirˉbuild) -> bool {
    let Payloadˉbytes: u32 = Bytesˉlength(Build.Functionˉpayload) +
        Bytesˉlength(Build.Blockˉpayload) +
        Bytesˉlength(Build.Operationˉpayload) +
        Bytesˉlength(Build.Temporaryˉpayload) +
        Bytesˉlength(Build.Operandˉpayload);
    let Catalog: Sourceˉgenerics.Compilerˉsourceˉgenericˉcatalog =
        Compilerˉsourceˉwirˉgenericˉcatalog(Build.Genericˉevidence);
    if Sourceˉgenerics.Compilerˉsourceˉgenericˉcatalogˉinstances(Catalog) > 0u32 {
        return Payloadˉbytes <= 4194248u32;
    }
    return Payloadˉbytes <= 4194256u32;
}

export fn Compilerˉsourceˉwirˉsummaryˉfromˉbindings(
    Input: bytes,
    Bindings: Sourceˉbindings.Compilerˉsourceˉbindingˉsummary
) -> Compilerˉsourceˉwirˉsummary {
    return Compilerˉsourceˉwirˉsummary(
        Compilerˉsourceˉwirˉstatus.Sourceˉbindings,
        Bindings.Status,
        Bindings.Modules,
        Bindings.Functions,
        0u32, 0u32, 0u32, 0u32,
        Compilerˉsourceˉwirˉempty(Input),
        Bindings.Failureˉmodule,
        Bindings.Failureˉrelatedˉmodule,
        Bindings.Failureˉfunction,
        Bindings.Failureˉoffset,
        Bindings.Failureˉline,
        Bindings.Failureˉcolumn
    );
}

