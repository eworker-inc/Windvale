    );
}

fn Compilerˉsourceˉwirˉisˉexactˉfoundationˉvariant(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Shape: u32,
    Moduleˉname: text,
    Typeˉname: text
) -> bool {
    if Shape < 196608u32 || Shape >= 262144u32 { return false; }
    let Nominal: Sourceˉsymbols.Compilerˉsourceˉsymbolˉmatch =
        Compilerˉsourceˉwirˉnominalˉbyˉshape(
            Input, Scan, Symbols, Shape
        );
    if !Nominal.Found || Nominal.Module >= Scan.Modules || Nominal.Kind !=
            Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Variant {
        return false;
    }
    let View: Sourceˉset.Compilerˉsourceˉsetˉview =
        Sourceˉset.Compilerˉsourceˉsetˉmodule(Input, Scan, Nominal.Module);
    let Header: Sourceˉdeclarations.Compilerˉsourceˉheader =
        Sourceˉdeclarations.Compilerˉparseˉheaderˉvalidated(View.Source);
    return View.Edition == 1u32 && Header.Profile ==
            Sourceˉdeclarations.Compilerˉsourceˉprofile.Hosted &&
        Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(
            View.Source, Header.Nameˉoffset, Header.Nameˉlength,
            Moduleˉname
        ) &&
        Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(
            View.Source, Nominal.Nameˉoffset, Nominal.Nameˉlength,
