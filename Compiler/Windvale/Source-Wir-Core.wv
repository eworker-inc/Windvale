    if Genericˉparameters > 0u32 {
        Target = Bytesˉreadˉu32ˉlittle(
            Symbols.Directory, 8u32
        ) + Genericˉinstance;
    }
    if Callable.Kind == Sourceˉbindings.Compilerˉsourceˉcallableˉkind.Intrinsic {
        if Foundationˉsequenceˉoperation != 0u32 {
            Operation = Foundationˉsequenceˉoperation;
            Target = Foundationˉsequenceˉshape;
            if Operation == WIR_OPERATION_FOUNDATION_SEQUENCE_ELEMENT {
                Returnˉshape = Foundationˉsequenceˉelement;
            }
        } else {
            Operation = Callable.Directoryˉentry;
            Target = Compilerˉsourceˉwirˉsentinel();
        }
        Auxiliary = 0u32;
    }
    if Callable.Kind == Sourceˉbindings.Compilerˉsourceˉcallableˉkind.Record {
        Operation = WIR_OPERATION_RECORD_CREATE;
    }
    if Callable.Kind == Sourceˉbindings.Compilerˉsourceˉcallableˉkind.Variantˉcase {
        Operation = WIR_OPERATION_VARIANT_CREATE;
    }
    if Callable.Kind == Sourceˉbindings.Compilerˉsourceˉcallableˉkind.Capability {
        Operation = WIR_OPERATION_CALL_CAPABILITY;
    }
    if Callable.Kind == Sourceˉbindings.Compilerˉsourceˉcallableˉkind.Foreign {
        Operation = WIR_OPERATION_CALL_FOREIGN;
        Target = Callable.Directoryˉentry;
        Auxiliary = 0u32;
    }
    if Signature.Returnˉmode !=
            Sourceˉdeclarations.COMPILER_SOURCE_BORROW_MODE_VALUE {
        return Compilerˉsourceˉwirˉfailureˉvalue(
            Result, Compilerˉsourceˉwirˉstatus.Invalidˉborrow,
            Callable.Module,
            Expression.Offset, Expression.Line, Expression.Column
        );
    }
    if Returnˉshape == 10u32 {
        let Neverˉcall: Compilerˉsourceˉwirˉvalue = Compilerˉsourceˉwirˉemit(
            Result, Operation, 0u32,
            Argumentˉoperands, Target, Auxiliary,
            Expression.Offset, Expression.Length
        );
        let Neverˉblock: u32 = Neverˉcall.Currentˉblock;
        let Neverˉclosed: Compilerˉsourceˉwirˉbuild =
            Compilerˉsourceˉwirˉcloseˉcurrentˉblock(
                Compilerˉsourceˉwirˉvalueˉbuild(Neverˉcall),
                Compilerˉsourceˉwirˉterminator.Jump,
                Compilerˉsourceˉwirˉsentinel(),
                Neverˉblock,
                Compilerˉsourceˉwirˉsentinel()
            );
        return Compilerˉsourceˉwirˉvalueˉfrom(
            Neverˉclosed, 10u32, Compilerˉsourceˉwirˉsentinel()
        );
    }
    return Compilerˉsourceˉwirˉemit(
        Result, Operation, Returnˉshape,
        Argumentˉoperands, Target, Auxiliary,
        Expression.Offset, Expression.Length
    );
}

fn Compilerˉsourceˉwirˉcompileˉfor(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Bindings: Sourceˉbindings.Compilerˉsourceˉbindingˉphase,
    Source: bytes,
    Statement: Sourceˉbodies.Compilerˉsourceˉstatement,
    Returnˉshape: u32,
    Build: Compilerˉsourceˉwirˉbuild
) -> Compilerˉsourceˉwirˉbuild {
    var Result: Compilerˉsourceˉwirˉbuild = Compilerˉsourceˉwirˉfusedˉfrom(Build, Bindings);
    var Bindingˉphase: Sourceˉbindings.Compilerˉsourceˉbindingˉphase = Bindings;
    let Bindingˉbuild: Sourceˉbindings.Compilerˉsourceˉbindingˉbuild =
        Sourceˉbindings.Compilerˉsourceˉbindingsˉphaseˉbuildˉvalue(Bindingˉphase);
    let Bindingˉpayload: bytes = Bindingˉbuild.Payload;
    let Bindingˉfirst: u32 = Bindingˉbuild.Entries - Bindingˉbuild.Nextˉslot;
    let Bindingˉentries: u32 = Bindingˉbuild.Entries;
    let Collectionˉforˉsequenceˉposition: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
        Source, Statement.Offset, Statement.Line, Statement.Column,
        Statement.Expressionˉoffset
    );
    let Collectionˉforˉsequence: Compilerˉsourceˉwirˉvalue = Compilerˉsourceˉwirˉcompileˉexpression(
        Input, Scan, Symbols,
        Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
        Source,
        Statement.Expressionˉoffset,
        Collectionˉforˉsequenceˉposition.Line,
        Collectionˉforˉsequenceˉposition.Column,
        Statement.Expressionˉoffset + Statement.Expressionˉlength,
        Result
    );
    if Collectionˉforˉsequence.Status != Compilerˉsourceˉwirˉstatus.Valid {
        return Compilerˉsourceˉwirˉfusedˉfrom(
            Compilerˉsourceˉwirˉvalueˉbuild(Collectionˉforˉsequence),
            Bindingˉphase
        );
    }
    if !Compilerˉsourceˉwirˉshapeˉisˉsequence(Collectionˉforˉsequence.Shape) {
        return Compilerˉsourceˉwirˉfusedˉfrom(
            Compilerˉsourceˉwirˉbuildˉfailure(
                Compilerˉsourceˉwirˉvalueˉbuild(Collectionˉforˉsequence),
                Compilerˉsourceˉwirˉstatus.Invalidˉcollection,
                Result.Currentˉmodule, Result.Currentˉmodule, Result.Currentˉfunction,
                Statement.Expressionˉoffset,
                Collectionˉforˉsequenceˉposition.Line,
                Collectionˉforˉsequenceˉposition.Column
            ), Bindingˉphase
        );
    }
    var Collectionˉforˉbindings: Sourceˉbindings.Compilerˉsourceˉbindingˉbuild = Bindingˉbuild;
    if Collectionˉforˉbindings.Nextˉslot > 4093u32 {
        return Compilerˉsourceˉwirˉfusedˉfrom(
            Compilerˉsourceˉwirˉbuildˉfailure(
                Compilerˉsourceˉwirˉvalueˉbuild(Collectionˉforˉsequence),
                Compilerˉsourceˉwirˉstatus.Sourceˉbindings,
                Result.Currentˉmodule,
                Compilerˉsourceˉwirˉbindingˉfailureˉrelated(
                    Sourceˉbindings.Compilerˉsourceˉbindingˉstatus.Bindingˉlimit,
                    Result.Currentˉmodule
                ),
                Result.Currentˉfunction,
                Statement.Offset, Statement.Line, Statement.Column
            ), Bindingˉphase
        );
    }
    Collectionˉforˉbindings = Sourceˉbindings.Compilerˉsourceˉbindingsˉcollectˉforˉbinding(
        Result.Currentˉmodule, Result.Currentˉfunction,
        Source, Statement,
        Compilerˉsourceˉwirˉcollectionˉelementˉshape(Collectionˉforˉsequence.Shape),
        Collectionˉforˉbindings
    );
    if Collectionˉforˉbindings.Status == Sourceˉbindings.Compilerˉsourceˉbindingˉstatus.Valid {
        Collectionˉforˉbindings = Bindingˉbuild;
    }
    let Collectionˉforˉsequenceˉslot: u32 = Collectionˉforˉbindings.Nextˉslot;
    let Collectionˉforˉsequenceˉentry: bytes = Sourceˉbindings.Compilerˉsourceˉbindingsˉentry(
        Result.Currentˉmodule, Result.Currentˉfunction,
        Sourceˉbindings.Compilerˉsourceˉbindingˉkind.Let,
        Collectionˉforˉsequenceˉslot,
        Statement.Nameˉoffset, Statement.Nameˉlength,
        Collectionˉforˉsequence.Shape,
        Statement.Offset, Statement.Firstˉblockˉoffset
    );
    Collectionˉforˉbindings = Sourceˉbindings.Compilerˉsourceˉbindingsˉappend(
        Collectionˉforˉbindings, Collectionˉforˉsequenceˉentry, false
    );
    let Collectionˉforˉindexˉslot: u32 = Collectionˉforˉbindings.Nextˉslot;
    let Collectionˉforˉindexˉentry: bytes = Sourceˉbindings.Compilerˉsourceˉbindingsˉentry(
        Result.Currentˉmodule, Result.Currentˉfunction,
        Sourceˉbindings.Compilerˉsourceˉbindingˉkind.Var,
        Collectionˉforˉindexˉslot,
        Statement.Nameˉoffset, Statement.Nameˉlength, 3u32,
        Statement.Offset, Statement.Firstˉblockˉoffset
    );
    Collectionˉforˉbindings = Sourceˉbindings.Compilerˉsourceˉbindingsˉappend(
        Collectionˉforˉbindings, Collectionˉforˉindexˉentry, false
    );
    let Collectionˉforˉbindingˉslot: u32 = Collectionˉforˉbindings.Nextˉslot;
    let Collectionˉforˉbindingˉentry: bytes = Sourceˉbindings.Compilerˉsourceˉbindingsˉentry(
        Result.Currentˉmodule, Result.Currentˉfunction,
        Sourceˉbindings.Compilerˉsourceˉbindingˉkind.Let,
        Collectionˉforˉbindingˉslot,
        Statement.Nameˉoffset, Statement.Nameˉlength,
        Compilerˉsourceˉwirˉcollectionˉelementˉshape(Collectionˉforˉsequence.Shape),
        Statement.Firstˉblockˉoffset,
        Statement.Firstˉblockˉoffset + Statement.Firstˉblockˉlength
    );
    Collectionˉforˉbindings = Sourceˉbindings.Compilerˉsourceˉbindingsˉappend(
        Collectionˉforˉbindings, Collectionˉforˉbindingˉentry, false
    );
    Bindingˉphase = Sourceˉbindings.Compilerˉsourceˉbindingsˉphaseˉbuild(
        Bindingˉphase, Collectionˉforˉbindings
    );
    if Bindingˉphase.Buildˉstatus != Sourceˉbindings.Compilerˉsourceˉbindingˉstatus.Valid {
        return Compilerˉsourceˉwirˉbuildˉfailure(
            Compilerˉsourceˉwirˉvalueˉbuild(Collectionˉforˉsequence),
            Compilerˉsourceˉwirˉstatus.Sourceˉbindings,
            Bindingˉphase.Buildˉfailureˉmodule,
            Compilerˉsourceˉwirˉbindingˉfailureˉrelated(
                Bindingˉphase.Buildˉstatus,
                Bindingˉphase.Buildˉfailureˉrelatedˉmodule
            ),
            Bindingˉphase.Buildˉfailureˉfunction,
            Bindingˉphase.Buildˉfailureˉoffset,
            Bindingˉphase.Buildˉfailureˉline,
            Bindingˉphase.Buildˉfailureˉcolumn
        );
    }
    let Collectionˉforˉbinding: Sourceˉbindings.Compilerˉsourceˉlocalˉmatch = Sourceˉbindings.Compilerˉsourceˉbindingsˉfindˉlocal(
        Source, Collectionˉforˉbindings.Payload,
        Collectionˉforˉbindings.Entries - Collectionˉforˉbindings.Nextˉslot,
        Collectionˉforˉbindings.Entries,
        Statement.Nameˉoffset, Statement.Nameˉlength,
        Statement.Firstˉblockˉoffset
    );
    let Collectionˉforˉsequenceˉstored: Compilerˉsourceˉwirˉvalue = Compilerˉsourceˉwirˉemit(
        Compilerˉsourceˉwirˉvalueˉbuild(Collectionˉforˉsequence),
        WIR_OPERATION_STORE_LOCAL,
        0u32,
        Compilerˉsourceˉwirˉoneˉoperand(Collectionˉforˉsequence.Temporary),
        Collectionˉforˉsequenceˉslot, 0u32,
        Statement.Expressionˉoffset, Statement.Expressionˉlength
    );
    let Collectionˉforˉzero: Compilerˉsourceˉwirˉvalue = Compilerˉsourceˉwirˉemit(
        Compilerˉsourceˉwirˉvalueˉbuild(Collectionˉforˉsequenceˉstored),
        WIR_OPERATION_U32_CONSTANT,
        3u32, Compilerˉsourceˉwirˉempty(Source),
        0u32, 0u32, Statement.Offset, Statement.Length
    );
    let Collectionˉforˉindexˉinitialized: Compilerˉsourceˉwirˉvalue = Compilerˉsourceˉwirˉemit(
        Compilerˉsourceˉwirˉvalueˉbuild(Collectionˉforˉzero),
        WIR_OPERATION_STORE_LOCAL,
        0u32, Compilerˉsourceˉwirˉoneˉoperand(Collectionˉforˉzero.Temporary),
        Collectionˉforˉindexˉslot, 0u32,
        Statement.Offset, Statement.Length
    );
    Result = Compilerˉsourceˉwirˉfusedˉfrom(
        Compilerˉsourceˉwirˉvalueˉbuild(Collectionˉforˉindexˉinitialized),
        Bindingˉphase
    );
    let Collectionˉforˉheader: u32 = Result.Nextˉblock;
    let Collectionˉforˉbody: u32 = Collectionˉforˉheader + 1u32;
    let Collectionˉforˉincrement: u32 = Collectionˉforˉheader + 2u32;
    let Collectionˉforˉafter: u32 = Collectionˉforˉheader + 3u32;
    Result = Compilerˉsourceˉwirˉreserveˉblocks(Result, 4u32);
    Result = Compilerˉsourceˉwirˉcloseˉcurrentˉblock(
        Result, Compilerˉsourceˉwirˉterminator.Jump,
        Compilerˉsourceˉwirˉsentinel(),
        Collectionˉforˉheader, Compilerˉsourceˉwirˉsentinel()
    );
    Result = Compilerˉsourceˉwirˉbeginˉreservedˉblock(Result, Collectionˉforˉheader);
    let Collectionˉforˉheaderˉindex: Compilerˉsourceˉwirˉvalue = Compilerˉsourceˉwirˉemit(
        Result, WIR_OPERATION_LOAD_LOCAL,
        3u32, Compilerˉsourceˉwirˉempty(Source),
        Collectionˉforˉindexˉslot, 0u32,
        Statement.Offset, Statement.Length
    );
    let Collectionˉforˉheaderˉsequence: Compilerˉsourceˉwirˉvalue = Compilerˉsourceˉwirˉemit(
        Compilerˉsourceˉwirˉvalueˉbuild(Collectionˉforˉheaderˉindex),
        WIR_OPERATION_LOAD_LOCAL,
        Collectionˉforˉsequence.Shape, Compilerˉsourceˉwirˉempty(Source),
        Collectionˉforˉsequenceˉslot, 0u32,
        Statement.Expressionˉoffset, Statement.Expressionˉlength
    );
    let Collectionˉforˉlength: Compilerˉsourceˉwirˉvalue = Compilerˉsourceˉwirˉemit(
        Compilerˉsourceˉwirˉvalueˉbuild(Collectionˉforˉheaderˉsequence),
        WIR_OPERATION_SEQUENCE_LENGTH,
        3u32,
        Compilerˉsourceˉwirˉoneˉoperand(Collectionˉforˉheaderˉsequence.Temporary),
        0u32, 0u32, Statement.Expressionˉoffset, Statement.Expressionˉlength
    );
    let Collectionˉforˉcondition: Compilerˉsourceˉwirˉvalue = Compilerˉsourceˉwirˉemit(
        Compilerˉsourceˉwirˉvalueˉbuild(Collectionˉforˉlength),
        WIR_OPERATION_U32_LESS,
        4u32,
        Compilerˉsourceˉwirˉtwoˉoperands(
            Collectionˉforˉheaderˉindex.Temporary,
            Collectionˉforˉlength.Temporary
        ),
        0u32, 0u32, Statement.Offset, Statement.Length
    );
    Result = Compilerˉsourceˉwirˉcloseˉcurrentˉblock(
        Compilerˉsourceˉwirˉvalueˉbuild(Collectionˉforˉcondition),
        Compilerˉsourceˉwirˉterminator.Branch,
        Collectionˉforˉcondition.Temporary,
        Collectionˉforˉbody, Collectionˉforˉafter
    );
    Result = Compilerˉsourceˉwirˉbeginˉreservedˉblock(Result, Collectionˉforˉbody);
    let Collectionˉforˉbodyˉsequence: Compilerˉsourceˉwirˉvalue = Compilerˉsourceˉwirˉemit(
        Result, WIR_OPERATION_LOAD_LOCAL,
        Collectionˉforˉsequence.Shape, Compilerˉsourceˉwirˉempty(Source),
        Collectionˉforˉsequenceˉslot, 0u32,
        Statement.Expressionˉoffset, Statement.Expressionˉlength
    );
    let Collectionˉforˉbodyˉindex: Compilerˉsourceˉwirˉvalue = Compilerˉsourceˉwirˉemit(
        Compilerˉsourceˉwirˉvalueˉbuild(Collectionˉforˉbodyˉsequence),
        WIR_OPERATION_LOAD_LOCAL,
        3u32, Compilerˉsourceˉwirˉempty(Source),
        Collectionˉforˉindexˉslot, 0u32,
        Statement.Offset, Statement.Length
    );
    let Collectionˉforˉelement: Compilerˉsourceˉwirˉvalue = Compilerˉsourceˉwirˉemit(
        Compilerˉsourceˉwirˉvalueˉbuild(Collectionˉforˉbodyˉindex),
        WIR_OPERATION_SEQUENCE_ELEMENT,
        Collectionˉforˉbinding.Shape,
        Compilerˉsourceˉwirˉtwoˉoperands(
            Collectionˉforˉbodyˉsequence.Temporary,
            Collectionˉforˉbodyˉindex.Temporary
        ),
        0u32, 0u32, Statement.Offset, Statement.Length
    );
    let Collectionˉforˉelementˉstored: Compilerˉsourceˉwirˉvalue = Compilerˉsourceˉwirˉemit(
        Compilerˉsourceˉwirˉvalueˉbuild(Collectionˉforˉelement),
        WIR_OPERATION_STORE_LOCAL,
        0u32, Compilerˉsourceˉwirˉoneˉoperand(Collectionˉforˉelement.Temporary),
        Collectionˉforˉbinding.Slot, 0u32,
        Statement.Offset, Statement.Length
    );
    let Collectionˉforˉbodyˉposition: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
        Source, Statement.Offset, Statement.Line, Statement.Column,
        Statement.Firstˉblockˉoffset
    );
    let Collectionˉforˉbodyˉcompiled: Compilerˉsourceˉwirˉbuild = Compilerˉsourceˉwirˉcompileˉblock(
        Input, Scan, Symbols, Bindingˉphase,
        Source,
        Statement.Firstˉblockˉoffset,
        Collectionˉforˉbodyˉposition.Line,
        Collectionˉforˉbodyˉposition.Column,
        Statement.Firstˉblockˉoffset + Statement.Firstˉblockˉlength,
        Statement.Firstˉblockˉoffset + Statement.Firstˉblockˉlength,
        Returnˉshape, Collectionˉforˉincrement, Collectionˉforˉafter,
        Statement.Offset,
        Compilerˉsourceˉwirˉvalueˉbuild(Collectionˉforˉelementˉstored)
    );
    if Collectionˉforˉbodyˉcompiled.Status != Compilerˉsourceˉwirˉstatus.Valid {
        return Collectionˉforˉbodyˉcompiled;
    }
    Result = Collectionˉforˉbodyˉcompiled;
    Bindingˉphase = Compilerˉsourceˉwirˉbuildˉbindings(Input, Collectionˉforˉbodyˉcompiled);
    if Result.Hasˉcurrentˉblock {
        Result = Compilerˉsourceˉwirˉcloseˉcurrentˉblock(
            Result, Compilerˉsourceˉwirˉterminator.Jump,
            Compilerˉsourceˉwirˉsentinel(),
            Collectionˉforˉincrement, Compilerˉsourceˉwirˉsentinel()
        );
    }
    Result = Compilerˉsourceˉwirˉbeginˉreservedˉblock(Result, Collectionˉforˉincrement);
    let Collectionˉforˉincrementˉindex: Compilerˉsourceˉwirˉvalue = Compilerˉsourceˉwirˉemit(
        Result, WIR_OPERATION_LOAD_LOCAL,
        3u32, Compilerˉsourceˉwirˉempty(Source),
        Collectionˉforˉindexˉslot, 0u32,
        Statement.Offset, Statement.Length
    );
    let Collectionˉforˉone: Compilerˉsourceˉwirˉvalue = Compilerˉsourceˉwirˉemit(
        Compilerˉsourceˉwirˉvalueˉbuild(Collectionˉforˉincrementˉindex),
        WIR_OPERATION_U32_CONSTANT,
        3u32, Compilerˉsourceˉwirˉempty(Source),
        1u32, 0u32, Statement.Offset, Statement.Length
    );
    let Collectionˉforˉincremented: Compilerˉsourceˉwirˉvalue = Compilerˉsourceˉwirˉemit(
        Compilerˉsourceˉwirˉvalueˉbuild(Collectionˉforˉone),
        WIR_OPERATION_U32_ADD,
        3u32,
        Compilerˉsourceˉwirˉtwoˉoperands(
            Collectionˉforˉincrementˉindex.Temporary,
            Collectionˉforˉone.Temporary
        ),
        0u32, 0u32, Statement.Offset, Statement.Length
    );
    let Collectionˉforˉincrementˉstored: Compilerˉsourceˉwirˉvalue = Compilerˉsourceˉwirˉemit(
        Compilerˉsourceˉwirˉvalueˉbuild(Collectionˉforˉincremented),
        WIR_OPERATION_STORE_LOCAL,
        0u32, Compilerˉsourceˉwirˉoneˉoperand(Collectionˉforˉincremented.Temporary),
        Collectionˉforˉindexˉslot, 0u32,
        Statement.Offset, Statement.Length
    );
    Result = Compilerˉsourceˉwirˉcloseˉcurrentˉblock(
        Compilerˉsourceˉwirˉvalueˉbuild(Collectionˉforˉincrementˉstored),
        Compilerˉsourceˉwirˉterminator.Jump,
        Compilerˉsourceˉwirˉsentinel(),
        Collectionˉforˉheader, Compilerˉsourceˉwirˉsentinel()
    );
    Result = Compilerˉsourceˉwirˉbeginˉreservedˉblock(Result, Collectionˉforˉafter);
    return Compilerˉsourceˉwirˉfusedˉfrom(Result, Bindingˉphase);
}

fn Compilerˉsourceˉwirˉcompileˉpush(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Bindings: Sourceˉbindings.Compilerˉsourceˉbindingˉphase,
    Source: bytes,
    Statement: Sourceˉbodies.Compilerˉsourceˉstatement,
    Build: Compilerˉsourceˉwirˉbuild
) -> Compilerˉsourceˉwirˉbuild {
    var Result: Compilerˉsourceˉwirˉbuild = Compilerˉsourceˉwirˉfusedˉfrom(Build, Bindings);
    let Bindingˉphase: Sourceˉbindings.Compilerˉsourceˉbindingˉphase = Bindings;
    let Bindingˉbuild: Sourceˉbindings.Compilerˉsourceˉbindingˉbuild =
        Sourceˉbindings.Compilerˉsourceˉbindingsˉphaseˉbuildˉvalue(Bindings);
    let Bindingˉpayload: bytes = Bindingˉbuild.Payload;
    let Bindingˉfirst: u32 = Bindingˉbuild.Entries - Bindingˉbuild.Nextˉslot;
    let Bindingˉentries: u32 = Bindingˉbuild.Entries;
    let Collectionˉpushˉbinding: Sourceˉbindings.Compilerˉsourceˉlocalˉmatch = Sourceˉbindings.Compilerˉsourceˉbindingsˉfindˉlocal(
        Source, Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
        Statement.Nameˉoffset, Statement.Nameˉlength, Statement.Offset
    );
    if !Collectionˉpushˉbinding.Found || Collectionˉpushˉbinding.Kind != Sourceˉbindings.Compilerˉsourceˉbindingˉkind.Var || !Compilerˉsourceˉwirˉshapeˉisˉbuilder(Collectionˉpushˉbinding.Shape) {
        return Compilerˉsourceˉwirˉfusedˉfrom(
            Compilerˉsourceˉwirˉbuildˉfailure(
                Result, Compilerˉsourceˉwirˉstatus.Invalidˉbuilder,
                Result.Currentˉmodule, Result.Currentˉmodule, Result.Currentˉfunction,
                Statement.Nameˉoffset, Statement.Line, Statement.Column
            ),
            Bindingˉphase
        );
    }
    let Collectionˉpushˉposition: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
        Source, Statement.Offset, Statement.Line, Statement.Column, Statement.Expressionˉoffset
    );
    let Collectionˉpushˉvalue: Compilerˉsourceˉwirˉvalue = Compilerˉsourceˉwirˉcompileˉexpression(
        Input, Scan, Symbols, Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
        Source, Statement.Expressionˉoffset,
        Collectionˉpushˉposition.Line, Collectionˉpushˉposition.Column,
        Statement.Expressionˉoffset + Statement.Expressionˉlength,
        Result
    );
    if Collectionˉpushˉvalue.Status != Compilerˉsourceˉwirˉstatus.Valid {
        return Compilerˉsourceˉwirˉfusedˉfrom(
            Compilerˉsourceˉwirˉvalueˉbuild(Collectionˉpushˉvalue), Bindingˉphase
        );
    }
    if Collectionˉpushˉvalue.Shape != Compilerˉsourceˉwirˉcollectionˉelementˉshape(Collectionˉpushˉbinding.Shape) {
        return Compilerˉsourceˉwirˉfusedˉfrom(
            Compilerˉsourceˉwirˉbuildˉfailure(
                Compilerˉsourceˉwirˉvalueˉbuild(Collectionˉpushˉvalue),
                Compilerˉsourceˉwirˉstatus.Typeˉmismatch,
                Result.Currentˉmodule, Result.Currentˉmodule, Result.Currentˉfunction,
                Statement.Expressionˉoffset,
                Collectionˉpushˉposition.Line, Collectionˉpushˉposition.Column
            ), Bindingˉphase
        );
    }
    let Collectionˉpushˉloaded: Compilerˉsourceˉwirˉvalue = Compilerˉsourceˉwirˉemit(
        Compilerˉsourceˉwirˉvalueˉbuild(Collectionˉpushˉvalue),
        WIR_OPERATION_LOAD_LOCAL,
        Collectionˉpushˉbinding.Shape,
        Compilerˉsourceˉwirˉempty(Source),
        Collectionˉpushˉbinding.Slot, 0u32,
        Statement.Nameˉoffset, Statement.Nameˉlength
    );
    let Collectionˉpushed: Compilerˉsourceˉwirˉvalue = Compilerˉsourceˉwirˉemit(
        Compilerˉsourceˉwirˉvalueˉbuild(Collectionˉpushˉloaded),
        WIR_OPERATION_BUILDER_PUSH,
        Collectionˉpushˉbinding.Shape,
        Compilerˉsourceˉwirˉtwoˉoperands(
            Collectionˉpushˉloaded.Temporary,
            Collectionˉpushˉvalue.Temporary
        ),
        0u32, 0u32, Statement.Offset, Statement.Length
    );
    let Collectionˉpushˉstored: Compilerˉsourceˉwirˉvalue = Compilerˉsourceˉwirˉemit(
        Compilerˉsourceˉwirˉvalueˉbuild(Collectionˉpushed),
        WIR_OPERATION_STORE_LOCAL,
        0u32, Compilerˉsourceˉwirˉoneˉoperand(Collectionˉpushed.Temporary),
        Collectionˉpushˉbinding.Slot, 0u32,
        Statement.Offset, Statement.Length
    );
    Result = Compilerˉsourceˉwirˉvalueˉbuild(Collectionˉpushˉstored);
    return Compilerˉsourceˉwirˉfusedˉfrom(Result, Bindings);
}

fn Compilerˉsourceˉwirˉcompileˉmatch(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Source: bytes,
    Match: Compilerˉsourceˉwirˉmatchˉview,
    Valueˉform: bool,
    Returnˉshape: u32,
    Continueˉtarget: u32,
    Breakˉtarget: u32,
    Loopˉscopeˉoffset: u32,
    Build: Compilerˉsourceˉwirˉbuild
) -> Compilerˉsourceˉwirˉvalue {
    let Bindings: Sourceˉbindings.Compilerˉsourceˉbindingˉphase =
        Compilerˉsourceˉwirˉbuildˉbindings(Input, Build);
    var Result: Compilerˉsourceˉwirˉbuild = Compilerˉsourceˉwirˉfusedˉfrom(Build, Bindings);
    var Bindingˉphase: Sourceˉbindings.Compilerˉsourceˉbindingˉphase = Bindings;
    if Valueˉform {
        if Scan.Version != 2u32 {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Result,
                Compilerˉsourceˉwirˉstatus.Invalidˉmatch,
                Result.Currentˉmodule,
                Match.Offset,
                Match.Line,
                Match.Column
            );
        }
    }
    let Bindingˉbuild: Sourceˉbindings.Compilerˉsourceˉbindingˉbuild =
        Sourceˉbindings.Compilerˉsourceˉbindingsˉphaseˉbuildˉvalue(Bindingˉphase);
    let Bindingˉpayload: bytes = Bindingˉbuild.Payload;
    let Bindingˉfirst: u32 = Bindingˉbuild.Entries - Bindingˉbuild.Nextˉslot;
    let Bindingˉentries: u32 = Bindingˉbuild.Entries;
    let Matchˉvalueˉposition: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
        Source, Match.Offset, Match.Line, Match.Column,
        Match.Valueˉoffset
    );
    let Matchˉvalue: Compilerˉsourceˉwirˉvalue = Compilerˉsourceˉwirˉcompileˉexpression(
        Input, Scan, Symbols,
        Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
        Source,
        Match.Valueˉoffset,
        Matchˉvalueˉposition.Line,
        Matchˉvalueˉposition.Column,
        Match.Valueˉoffset + Match.Valueˉlength,
        Result
    );
    if Matchˉvalue.Status != Compilerˉsourceˉwirˉstatus.Valid {
        return Matchˉvalue;
    }
    let Matchˉtypeˉcatalog:
        Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog =
        Compilerˉsourceˉwirˉgenericˉtypeˉcatalog(
            Matchˉvalue.Genericˉevidence
        );
    var Matchˉshapeˉisˉsupported: bool = false;
    if Matchˉvalue.Shape >= 131072u32 + Symbols.Records {
        if Matchˉvalue.Shape < 131072u32 + Symbols.Records + Symbols.Enums {
            Matchˉshapeˉisˉsupported = true;
        }
    }
    if Matchˉvalue.Shape >= 196608u32 + Symbols.Records + Symbols.Enums {
        if Matchˉvalue.Shape < 196608u32 + Symbols.Records + Symbols.Enums + Symbols.Variants {
            Matchˉshapeˉisˉsupported = true;
        }
    }
    if Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉshapeˉisˉprivate(
            Matchˉvalue.Shape
        ) {
        let Matchˉgenericˉinstance: u32 =
            Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉshapeˉinstance(
                Matchˉvalue.Shape
            );
        Matchˉshapeˉisˉsupported =
            Matchˉgenericˉinstance <
                Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalogˉinstances(
                    Matchˉtypeˉcatalog
                ) &&
            Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalogˉinstanceˉkind(
                Matchˉtypeˉcatalog, Matchˉgenericˉinstance
            ) == 8u32;
    }
    if !Matchˉshapeˉisˉsupported {
        return Compilerˉsourceˉwirˉfailureˉvalue(
            Compilerˉsourceˉwirˉvalueˉbuild(Matchˉvalue),
            Compilerˉsourceˉwirˉstatus.Invalidˉmatch,
            Result.Currentˉmodule,
            Match.Valueˉoffset,
            Matchˉvalueˉposition.Line,
            Matchˉvalueˉposition.Column
        );
    }
    var Matchˉnominal: Sourceˉsymbols.Compilerˉsourceˉsymbolˉmatch =
        Compilerˉsourceˉwirˉnominalˉbyˉshape(
            Input, Scan, Symbols, Matchˉvalue.Shape
        );
    if Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉshapeˉisˉprivate(
            Matchˉvalue.Shape
        ) {
        let Matchˉdirectoryˉentry: u32 =
            Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalogˉinstanceˉdeclaration(
                Matchˉtypeˉcatalog,
                Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉshapeˉinstance(
                    Matchˉvalue.Shape
                )
            );
        Matchˉnominal =
            Sourceˉsymbols.Compilerˉsourceˉsymbolsˉdirectoryˉentry(
                Symbols.Directory, Scan.Modules, Matchˉdirectoryˉentry
            );
    }
    if !Matchˉnominal.Found {
        return Compilerˉsourceˉwirˉfailureˉvalue(
            Compilerˉsourceˉwirˉvalueˉbuild(Matchˉvalue),
            Compilerˉsourceˉwirˉstatus.Invalidˉmatch,
            Result.Currentˉmodule,
            Match.Valueˉoffset,
            Matchˉvalueˉposition.Line,
            Matchˉvalueˉposition.Column
        );
    }
    let Matchˉisˉvariant: bool =
        Matchˉnominal.Kind == Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Variant;
    let Matchˉdeclarationˉview: Sourceˉset.Compilerˉsourceˉsetˉview = Sourceˉset.Compilerˉsourceˉsetˉmodule(
        Input, Scan, Matchˉnominal.Module
    );
    let Matchˉdeclarationˉposition: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
        Matchˉdeclarationˉview.Source, 0u32, 1u32, 1u32,
        Matchˉnominal.Declarationˉoffset
    );
    let Matchˉdeclaration: Sourceˉdeclarations.Compilerˉsourceˉdeclaration = Sourceˉdeclarations.Compilerˉparseˉnextˉdeclarationˉvalidated(
        Matchˉdeclarationˉview.Source,
        Matchˉnominal.Declarationˉoffset,
        Matchˉdeclarationˉposition.Line,
        Matchˉdeclarationˉposition.Column,
        true
    );
    if Match.Cases != Matchˉdeclaration.Items {
        return Compilerˉsourceˉwirˉfailureˉvalue(
            Compilerˉsourceˉwirˉvalueˉbuild(Matchˉvalue),
            Compilerˉsourceˉwirˉstatus.Missingˉmatchˉcase,
            Matchˉnominal.Module,
            Match.Bodyˉoffset,
            Match.Line,
            Match.Column
        );
    }
    let Matchˉseenˉresult: Byteˉconstruction.Foundationˉbytesˉresult = Byteˉconstruction.Foundationˉbytesˉrepeat(
        0u8, Matchˉdeclaration.Items
    );
    if !Matchˉseenˉresult.Valid {
        return Compilerˉsourceˉwirˉfailureˉvalue(
            Compilerˉsourceˉwirˉvalueˉbuild(Matchˉvalue),
            Compilerˉsourceˉwirˉstatus.Evidenceˉlimit,
            Matchˉnominal.Module,
            Match.Bodyˉoffset,
            Match.Line,
            Match.Column
        );
    }
    var Matchˉseen: bytes = Matchˉseenˉresult.Value;
    let Matchˉbodyˉposition: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
        Source, Match.Offset, Match.Line, Match.Column,
        Match.Bodyˉoffset
    );
    let Matchˉbody: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉbodies.Compilerˉbodyˉtoken(
        Source,
        Match.Bodyˉoffset,
        Matchˉbodyˉposition.Line,
        Matchˉbodyˉposition.Column,
        Match.Bodyˉoffset + Match.Bodyˉlength
    );
    var Matchˉcursor: u32 = Matchˉbody.Nextˉoffset;
    var Matchˉline: u32 = Matchˉbody.Nextˉline;
    var Matchˉcolumn: u32 = Matchˉbody.Nextˉcolumn;
    var Matchˉcaseˉindex: u32 = 0u32;
    var Matchˉbodies: Compilerˉsourceˉwirˉbuild = Compilerˉsourceˉwirˉvalueˉbuild(Matchˉvalue);
    var Matchˉresult: Compilerˉsourceˉwirˉvalue =
        Compilerˉsourceˉwirˉvalueˉfrom(
            Compilerˉsourceˉwirˉwithoutˉcurrentˉblock(Matchˉbodies),
            0u32,
            Compilerˉsourceˉwirˉsentinel()
        );
    var Hasˉmatchˉresult: bool = false;
    let Matchˉcaseˉblocks: u32 = Matchˉbodies.Nextˉblock;
    Matchˉcursor = Matchˉbody.Nextˉoffset;
    Matchˉline = Matchˉbody.Nextˉline;
    Matchˉcolumn = Matchˉbody.Nextˉcolumn;
    Matchˉcaseˉindex = 0u32;
    while Matchˉcaseˉindex < Match.Cases {
        let Bodyˉcase: Sourceˉbodies.Compilerˉsourceˉmatchˉcase = Sourceˉbodies.Compilerˉbodyˉparseˉmatchˉcase(
            Source,
            Matchˉcursor,
            Matchˉline,
            Matchˉcolumn,
            Match.Bodyˉoffset + Match.Bodyˉlength,
            0u32,
            Valueˉform
        );
        let Caseˉnominal: Sourceˉsymbols.Compilerˉsourceˉsymbolˉmatch =
            Sourceˉsymbols.Compilerˉsourceˉsymbolsˉfindˉownedˉnominal(
                Input, Scan, Symbols.Directory, Symbols.Lookup,
                Result.Currentˉmodule,
                Source, Bodyˉcase.Enumˉoffset, Bodyˉcase.Enumˉlength
            );
        var Sameˉnominal: bool = Caseˉnominal.Found;
        if Sameˉnominal {
            Sameˉnominal = Caseˉnominal.Kind == Matchˉnominal.Kind;
        }
        if Sameˉnominal {
            Sameˉnominal =
                Caseˉnominal.Directoryˉindex == Matchˉnominal.Directoryˉindex;
        }
        if Sameˉnominal {
            Sameˉnominal = Sourceˉsymbols.Compilerˉsourceˉsymbolsˉownedˉmatchˉisˉaccessible(
                Input, Scan, Symbols.Visibility, Symbols.Lookup,
                Result.Currentˉmodule, Source,
                Bodyˉcase.Enumˉoffset, Bodyˉcase.Enumˉlength, Caseˉnominal
            );
        }
        if !Sameˉnominal {
            let Caseˉenumˉposition:
                Sourceˉbodies.Compilerˉsourceˉposition =
                Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
                    Source, Matchˉcursor, Matchˉline, Matchˉcolumn,
                    Bodyˉcase.Enumˉoffset
                );
            var Mismatchˉstatus: Compilerˉsourceˉwirˉstatus =
                Compilerˉsourceˉwirˉstatus.Matchˉenumˉmismatch;
            if Matchˉisˉvariant {
                Mismatchˉstatus =
                    Compilerˉsourceˉwirˉstatus.Matchˉvariantˉmismatch;
            }
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Compilerˉsourceˉwirˉvalueˉbuild(Matchˉvalue),
                Mismatchˉstatus,
                Caseˉnominal.Module,
                Bodyˉcase.Enumˉoffset,
                Caseˉenumˉposition.Line,
                Caseˉenumˉposition.Column
            );
        }
        let Bodyˉmember: Compilerˉsourceˉwirˉmember = Compilerˉsourceˉwirˉnominalˉmember(
            Input, Scan, Symbols, Matchˉnominal,
            Source, Bodyˉcase.Memberˉoffset, Bodyˉcase.Memberˉlength
        );
        let Caseˉmemberˉposition:
            Sourceˉbodies.Compilerˉsourceˉposition =
            Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
                Source, Matchˉcursor, Matchˉline, Matchˉcolumn,
                Bodyˉcase.Memberˉoffset
            );
        if !Bodyˉmember.Found {
            var Unknownˉstatus: Compilerˉsourceˉwirˉstatus =
                Compilerˉsourceˉwirˉstatus.Unknownˉenumˉmember;
            if Matchˉisˉvariant {
                Unknownˉstatus =
                    Compilerˉsourceˉwirˉstatus.Unknownˉvariantˉcase;
            }
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Compilerˉsourceˉwirˉvalueˉbuild(Matchˉvalue),
                Unknownˉstatus,
                Matchˉnominal.Module,
                Bodyˉcase.Memberˉoffset,
                Caseˉmemberˉposition.Line,
                Caseˉmemberˉposition.Column
            );
        }
        var Matchˉfieldˉshapes: bytes =
            Compilerˉsourceˉwirˉempty(Source);
        if Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉshapeˉisˉprivate(
                Matchˉvalue.Shape
            ) {
            let Specializedˉcase:
                Compilerˉsourceˉwirˉvariantˉcaseˉview =
                Compilerˉsourceˉwirˉvariantˉcaseˉviewˉbyˉindex(
                    Input, Scan, Symbols, Matchˉtypeˉcatalog,
                    Matchˉvalue.Shape, Bodyˉmember.Index
                );
            if !Specializedˉcase.Found {
                return Compilerˉsourceˉwirˉfailureˉvalue(
                    Compilerˉsourceˉwirˉvalueˉbuild(Matchˉvalue),
                    Compilerˉsourceˉwirˉstatus.Invalidˉvariantˉbinding,
                    Matchˉnominal.Module,
                    Bodyˉcase.Memberˉoffset,
                    Caseˉmemberˉposition.Line,
                    Caseˉmemberˉposition.Column
                );
            }
            var Specializedˉfield: u32 = 0u32;
            while Specializedˉfield < Specializedˉcase.Fields {
                let Specializedˉmember: Compilerˉsourceˉwirˉmember =
                    Compilerˉsourceˉwirˉvariantˉfieldˉbyˉindex(
                        Input, Scan, Symbols, Matchˉtypeˉcatalog,
                        Matchˉvalue.Shape, Bodyˉmember.Index,
                        Specializedˉfield
                    );
                if !Specializedˉmember.Found || Specializedˉmember.Shape == 0u32 {
                    return Compilerˉsourceˉwirˉfailureˉvalue(
                        Compilerˉsourceˉwirˉvalueˉbuild(Matchˉvalue),
                        Compilerˉsourceˉwirˉstatus.Invalidˉvariantˉbinding,
                        Matchˉnominal.Module,
                        Bodyˉcase.Memberˉoffset,
                        Caseˉmemberˉposition.Line,
                        Caseˉmemberˉposition.Column
                    );
                }
                Matchˉfieldˉshapes = Bytesˉconcat(
                    Matchˉfieldˉshapes,
                    Bytesˉfromˉu32ˉlittle(Specializedˉmember.Shape)
                );
                Specializedˉfield = Specializedˉfield + 1u32;
            }
        }
        var Bindingˉvalid: bool = Bodyˉcase.Bindingˉlength == 0u32;
        if Matchˉisˉvariant {
            Bindingˉvalid = Compilerˉsourceˉwirˉvariantˉpatternˉisˉvalid(
                Input, Scan, Symbols, Matchˉtypeˉcatalog,
                Source, Bodyˉcase,
                Compilerˉsourceˉwirˉvariantˉtarget(Matchˉvalue.Shape),
                Bodyˉmember.Index
            );
        }
        if !Bindingˉvalid {
            var Bindingˉfailureˉoffset: u32 = Bodyˉcase.Memberˉoffset;
            if Bodyˉcase.Bindingˉlength > 0u32 {
                Bindingˉfailureˉoffset = Bodyˉcase.Bindingˉoffset;
            }
            let Bindingˉfailureˉposition:
                Sourceˉbodies.Compilerˉsourceˉposition =
                Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
                    Source, Matchˉcursor, Matchˉline, Matchˉcolumn,
                    Bindingˉfailureˉoffset
                );
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Compilerˉsourceˉwirˉvalueˉbuild(Matchˉvalue),
                Compilerˉsourceˉwirˉstatus.Invalidˉvariantˉbinding,
                Matchˉnominal.Module,
                Bindingˉfailureˉoffset,
                Bindingˉfailureˉposition.Line,
                Bindingˉfailureˉposition.Column
            );
        }
        if Bytesˉreadˉu8(Matchˉseen, Bodyˉmember.Index) != 0u8 {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Compilerˉsourceˉwirˉvalueˉbuild(Matchˉvalue),
                Compilerˉsourceˉwirˉstatus.Duplicateˉmatchˉcase,
                Matchˉnominal.Module,
                Bodyˉcase.Memberˉoffset,
                Caseˉmemberˉposition.Line,
                Caseˉmemberˉposition.Column
            );
        }
        let Updatedˉseen: Byteˉconstruction.Foundationˉbytesˉresult =
            Byteˉconstruction.Foundationˉbytesˉreplace(
                Matchˉseen,
                Bodyˉmember.Index,
                1u32,
                Bytesˉfromˉu8(1u8)
            );
        if !Updatedˉseen.Valid {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Compilerˉsourceˉwirˉvalueˉbuild(Matchˉvalue),
                Compilerˉsourceˉwirˉstatus.Invalidˉdirectory,
                Matchˉnominal.Module,
                Bodyˉcase.Memberˉoffset,
                Caseˉmemberˉposition.Line,
                Caseˉmemberˉposition.Column
            );
        }
        Matchˉseen = Updatedˉseen.Value;
        let Bodyˉcaseˉblock: u32 = Matchˉbodies.Nextˉblock;
        Matchˉbodies = Compilerˉsourceˉwirˉreserveˉblocks(Matchˉbodies, 1u32);
        var Nextˉtestˉblock: u32 = Compilerˉsourceˉwirˉsentinel();
        if Matchˉcaseˉindex + 1u32 == Match.Cases {
            Matchˉbodies = Compilerˉsourceˉwirˉcloseˉcurrentˉblock(
                Matchˉbodies,
                Compilerˉsourceˉwirˉterminator.Jump,
                Compilerˉsourceˉwirˉsentinel(),
                Bodyˉcaseˉblock,
                Compilerˉsourceˉwirˉsentinel()
            );
        } else {
            var Dispatchˉtemporary: u32 = Compilerˉsourceˉwirˉsentinel();
            if Matchˉisˉvariant {
                let Dispatchˉcase: Compilerˉsourceˉwirˉvalue = Compilerˉsourceˉwirˉemit(
                    Matchˉbodies,
                    WIR_OPERATION_VARIANT_IS_CASE,
                    4u32,
                    Compilerˉsourceˉwirˉoneˉoperand(Matchˉvalue.Temporary),
                    Compilerˉsourceˉwirˉvariantˉtarget(Matchˉvalue.Shape),
                    Bodyˉmember.Index,
                    Bodyˉcase.Memberˉoffset,
                    Bodyˉcase.Memberˉlength
                );
                Matchˉbodies = Compilerˉsourceˉwirˉvalueˉbuild(Dispatchˉcase);
                Dispatchˉtemporary = Dispatchˉcase.Temporary;
            } else {
                let Dispatchˉconstant: Compilerˉsourceˉwirˉvalue = Compilerˉsourceˉwirˉemit(
                    Matchˉbodies,
                    WIR_OPERATION_ENUM_CONSTANT,
                    Matchˉvalue.Shape,
                    Compilerˉsourceˉwirˉempty(Source),
                    Matchˉvalue.Shape - 131072u32,
                    Bodyˉmember.Index,
                    Bodyˉcase.Memberˉoffset,
                    Bodyˉcase.Memberˉlength
                );
                let Dispatchˉequal: Compilerˉsourceˉwirˉvalue = Compilerˉsourceˉwirˉemit(
                    Compilerˉsourceˉwirˉvalueˉbuild(Dispatchˉconstant),
                    WIR_OPERATION_ENUM_EQUAL,
                    4u32,
                    Compilerˉsourceˉwirˉtwoˉoperands(
                        Matchˉvalue.Temporary,
                        Dispatchˉconstant.Temporary
                    ),
                    0u32,
                    0u32,
                    Bodyˉcase.Memberˉoffset,
                    Bodyˉcase.Memberˉlength
                );
                Matchˉbodies = Compilerˉsourceˉwirˉvalueˉbuild(Dispatchˉequal);
                Dispatchˉtemporary = Dispatchˉequal.Temporary;
            }
            Nextˉtestˉblock = Matchˉbodies.Nextˉblock;
            Matchˉbodies = Compilerˉsourceˉwirˉreserveˉblocks(Matchˉbodies, 1u32);
            Matchˉbodies = Compilerˉsourceˉwirˉcloseˉcurrentˉblock(
                Matchˉbodies,
                Compilerˉsourceˉwirˉterminator.Branch,
                Dispatchˉtemporary,
                Bodyˉcaseˉblock,
                Nextˉtestˉblock
            );
        }
        let Bodyˉcaseˉposition: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
            Source, Matchˉcursor, Matchˉline, Matchˉcolumn,
            Bodyˉcase.Blockˉoffset
        );
        let Caseˉbinding: Sourceˉbindings.Compilerˉsourceˉbindingˉbuild =
            Sourceˉbindings.Compilerˉsourceˉbindingsˉcollectˉmatchˉbinding(
                Input, Scan, Symbols,
                Result.Currentˉmodule, Result.Currentˉfunction,
                Source, Bodyˉcase,
                Matchˉfieldˉshapes,
                Sourceˉbindings.Compilerˉsourceˉbindingsˉphaseˉbuildˉvalue(Bindingˉphase)
            );
        Bindingˉphase = Sourceˉbindings.Compilerˉsourceˉbindingsˉphaseˉbuild(
            Bindingˉphase, Caseˉbinding
        );
        if Bindingˉphase.Buildˉstatus != Sourceˉbindings.Compilerˉsourceˉbindingˉstatus.Valid {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Compilerˉsourceˉwirˉfusedˉfrom(Matchˉbodies, Bindingˉphase),
                Compilerˉsourceˉwirˉstatus.Sourceˉbindings,
                Compilerˉsourceˉwirˉbindingˉfailureˉrelated(
                    Bindingˉphase.Buildˉstatus,
                    Bindingˉphase.Buildˉfailureˉrelatedˉmodule
                ),
                Bindingˉphase.Buildˉfailureˉoffset,
                Bindingˉphase.Buildˉfailureˉline,
                Bindingˉphase.Buildˉfailureˉcolumn
            );
        }
        var Bodyˉcaseˉstart: Compilerˉsourceˉwirˉbuild = Compilerˉsourceˉwirˉbeginˉreservedˉblock(
            Matchˉbodies,
            Bodyˉcaseˉblock
        );
        if Matchˉisˉvariant {
            Bodyˉcaseˉstart =
                Compilerˉsourceˉwirˉbindˉvariantˉpattern(
                    Input, Scan, Symbols, Matchˉtypeˉcatalog, Source,
                    Matchˉvalue.Temporary,
                    Compilerˉsourceˉwirˉvariantˉtarget(Matchˉvalue.Shape),
                    Bodyˉmember.Index,
                    Bodyˉcase,
                    Sourceˉbindings.Compilerˉsourceˉbindingsˉphaseˉbuildˉvalue(
                        Bindingˉphase
                    ),
                    Bodyˉcaseˉstart
                );
            if Bodyˉcaseˉstart.Status !=
                Compilerˉsourceˉwirˉstatus.Valid {
                return Compilerˉsourceˉwirˉvalueˉfrom(
                    Compilerˉsourceˉwirˉfusedˉfrom(
                        Bodyˉcaseˉstart, Bindingˉphase
                    ),
                    0u32,
                    Compilerˉsourceˉwirˉsentinel()
                );
            }
        }
        if Valueˉform {
            let Bodyˉvalueˉblock:
                Sourceˉbodies.Compilerˉsourceˉvalueˉblock =
                Sourceˉbodies.Compilerˉbodyˉparseˉvalueˉblock(
                    Source,
                    Bodyˉcase.Blockˉoffset,
                    Bodyˉcaseˉposition.Line,
                    Bodyˉcaseˉposition.Column,
                    Bodyˉcase.Blockˉoffset + Bodyˉcase.Blockˉlength,
                    0u32
                );
            var Bodyˉcaseˉvalue: Compilerˉsourceˉwirˉvalue =
                Compilerˉsourceˉwirˉcompileˉvalueˉblock(
                    Input, Scan, Symbols, Bindingˉphase, Source,
                    Bodyˉvalueˉblock,
                    Bodyˉcaseˉposition.Line,
                    Bodyˉcaseˉposition.Column,
                    Returnˉshape,
                    Continueˉtarget,
                    Breakˉtarget,
                    Loopˉscopeˉoffset,
                    Bodyˉcaseˉstart
                );
            if Bodyˉcaseˉvalue.Status != Compilerˉsourceˉwirˉstatus.Valid {
                return Bodyˉcaseˉvalue;
            }
            if Hasˉmatchˉresult {
                Bodyˉcaseˉvalue = Compilerˉsourceˉwirˉjoinˉbranchˉvalues(
                    Bodyˉcaseˉstart,
                    Bodyˉcase.Blockˉoffset,
                    Bodyˉcaseˉposition.Line,
                    Bodyˉcaseˉposition.Column,
                    Match.Offset,
                    Match.Length,
                    Matchˉresult,
                    Bodyˉcaseˉvalue
                );
                if Bodyˉcaseˉvalue.Status !=
                    Compilerˉsourceˉwirˉstatus.Valid {
                    return Bodyˉcaseˉvalue;
                }
            }
            Bindingˉphase = Compilerˉsourceˉwirˉbuildˉbindings(
                Input, Compilerˉsourceˉwirˉvalueˉbuild(Bodyˉcaseˉvalue)
            );
            Matchˉresult = Bodyˉcaseˉvalue;
            Hasˉmatchˉresult = true;
            Matchˉbodies = Compilerˉsourceˉwirˉvalueˉbuild(Matchˉresult);
        } else {
            let Bodyˉcaseˉresult: Compilerˉsourceˉwirˉbuild =
                Compilerˉsourceˉwirˉcompileˉblock(
                    Input, Scan, Symbols,
                    Bindingˉphase,
                    Source,
                    Bodyˉcase.Blockˉoffset,
                    Bodyˉcaseˉposition.Line,
                    Bodyˉcaseˉposition.Column,
                    Bodyˉcase.Blockˉoffset + Bodyˉcase.Blockˉlength,
                    Bodyˉcase.Blockˉoffset + Bodyˉcase.Blockˉlength,
                    Returnˉshape,
                    Continueˉtarget,
                    Breakˉtarget,
                    Loopˉscopeˉoffset,
                    Bodyˉcaseˉstart
                );
            if Bodyˉcaseˉresult.Status != Compilerˉsourceˉwirˉstatus.Valid {
                return Compilerˉsourceˉwirˉvalueˉfrom(
                    Compilerˉsourceˉwirˉfusedˉfrom(
                        Bodyˉcaseˉresult, Bindingˉphase
                    ),
                    0u32,
                    Compilerˉsourceˉwirˉsentinel()
                );
            }
            Bindingˉphase = Compilerˉsourceˉwirˉbuildˉbindings(
                Input, Bodyˉcaseˉresult
            );
            Matchˉbodies = Bodyˉcaseˉresult;
            if Matchˉbodies.Hasˉcurrentˉblock {
                Matchˉbodies = Compilerˉsourceˉwirˉcloseˉcurrentˉblock(
                    Matchˉbodies,
                    Compilerˉsourceˉwirˉterminator.Jump,
                    Compilerˉsourceˉwirˉsentinel(),
                    Compilerˉsourceˉwirˉsentinel(),
                    Compilerˉsourceˉwirˉsentinel()
                );
            }
        }
        Matchˉbodies = Compilerˉsourceˉwirˉwithoutˉcurrentˉblock(Matchˉbodies);
        if Matchˉcaseˉindex + 1u32 < Match.Cases {
            Matchˉbodies = Compilerˉsourceˉwirˉbeginˉreservedˉblock(
                Matchˉbodies, Nextˉtestˉblock
            );
        }
        Matchˉcursor = Bodyˉcase.Nextˉoffset;
        Matchˉline = Bodyˉcase.Nextˉline;
        Matchˉcolumn = Bodyˉcase.Nextˉcolumn;
        Matchˉcaseˉindex = Matchˉcaseˉindex + 1u32;
    }
    if Valueˉform {
        return Matchˉresult;
    }
    var Matchˉfallthroughs: u32 = 0u32;
    var Matchˉblockˉindex: u32 = Matchˉcaseˉblocks;
    while Matchˉblockˉindex < Matchˉbodies.Nextˉblock {
        let Matchˉblockˉoffset: u32 = Matchˉblockˉindex * 28u32;
        if Bytesˉreadˉu32ˉlittle(Matchˉbodies.Blockˉpayload, Matchˉblockˉoffset + 12u32) == 1u32 {
            if Bytesˉreadˉu32ˉlittle(Matchˉbodies.Blockˉpayload, Matchˉblockˉoffset + 20u32) == Compilerˉsourceˉwirˉsentinel() {
                Matchˉfallthroughs = Matchˉfallthroughs + 1u32;
            }
        }
        Matchˉblockˉindex = Matchˉblockˉindex + 1u32;
    }
    Result = Compilerˉsourceˉwirˉwithoutˉcurrentˉblock(Matchˉbodies);
    if Matchˉfallthroughs > 0u32 {
        let Matchˉjoin: u32 = Result.Nextˉblock;
        Result = Compilerˉsourceˉwirˉreserveˉblocks(Result, 1u32);
        Matchˉblockˉindex = Matchˉcaseˉblocks;
        while Matchˉblockˉindex < Matchˉjoin {
            let Matchˉpatchedˉblockˉoffset: u32 = Matchˉblockˉindex * 28u32;
            if Bytesˉreadˉu32ˉlittle(Result.Blockˉpayload, Matchˉpatchedˉblockˉoffset + 12u32) == 1u32 {
                if Bytesˉreadˉu32ˉlittle(Result.Blockˉpayload, Matchˉpatchedˉblockˉoffset + 20u32) == Compilerˉsourceˉwirˉsentinel() {
                    Result = Compilerˉsourceˉwirˉappendˉblock(
                        Result,
                        Matchˉblockˉindex,
                        Bytesˉreadˉu32ˉlittle(Result.Blockˉpayload, Matchˉpatchedˉblockˉoffset + 4u32),
                        Bytesˉreadˉu32ˉlittle(Result.Blockˉpayload, Matchˉpatchedˉblockˉoffset + 8u32),
                        Compilerˉsourceˉwirˉterminator.Jump,
                        Compilerˉsourceˉwirˉsentinel(),
                        Matchˉjoin,
                        Compilerˉsourceˉwirˉsentinel()
                    );
                }
            }
            Matchˉblockˉindex = Matchˉblockˉindex + 1u32;
        }
        Result = Compilerˉsourceˉwirˉbeginˉreservedˉblock(Result, Matchˉjoin);
    }
    return Compilerˉsourceˉwirˉvalueˉfrom(
        Compilerˉsourceˉwirˉfusedˉfrom(Result, Bindingˉphase),
        0u32,
        Compilerˉsourceˉwirˉsentinel()
    );
}

fn Compilerˉsourceˉwirˉcompileˉtry(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Bindings: Sourceˉbindings.Compilerˉsourceˉbindingˉphase,
    Source: bytes,
    Statement: Sourceˉbodies.Compilerˉsourceˉstatement,
    Build: Compilerˉsourceˉwirˉbuild
) -> Compilerˉsourceˉwirˉbuild {
    let Bindingˉbuild: Sourceˉbindings.Compilerˉsourceˉbindingˉbuild =
        Sourceˉbindings.Compilerˉsourceˉbindingsˉphaseˉbuildˉvalue(Bindings);
    let Currentˉview: Sourceˉset.Compilerˉsourceˉsetˉview =
        Sourceˉset.Compilerˉsourceˉsetˉmodule(
            Input, Scan, Build.Currentˉmodule
        );
    let Tryˉposition: Sourceˉbodies.Compilerˉsourceˉposition =
        Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
            Source,
            Statement.Offset,
            Statement.Line,
            Statement.Column,
            Statement.Expressionˉoffset
        );
    let Tryˉvalue: Compilerˉsourceˉwirˉvalue =
        Compilerˉsourceˉwirˉcompileˉexpression(
            Input,
            Scan,
            Symbols,
            Bindingˉbuild.Payload,
            Bindingˉbuild.Entries - Bindingˉbuild.Nextˉslot,
            Bindingˉbuild.Entries,
            Source,
            Statement.Expressionˉoffset,
            Tryˉposition.Line,
            Tryˉposition.Column,
            Statement.Expressionˉoffset + Statement.Expressionˉlength,
            Compilerˉsourceˉwirˉfusedˉfrom(Build, Bindings)
        );
    if Tryˉvalue.Status != Compilerˉsourceˉwirˉstatus.Valid {
        return Compilerˉsourceˉwirˉfusedˉfrom(
            Compilerˉsourceˉwirˉvalueˉbuild(Tryˉvalue), Bindings
        );
    }
    let Result: Compilerˉsourceˉwirˉvalue =
        Compilerˉsourceˉwirˉcompileˉvalueˉtry(
            Input, Scan, Symbols, Source,
            Statement.Offset, Statement.Line, Statement.Column,
            Statement.Length, Tryˉvalue, Currentˉview.Edition == 1u32
        );
    return Compilerˉsourceˉwirˉfusedˉfrom(
        Compilerˉsourceˉwirˉvalueˉbuild(Result), Bindings
    );
}

fn Compilerˉsourceˉwirˉcompileˉwhile(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Bindings: Sourceˉbindings.Compilerˉsourceˉbindingˉphase,
    Source: bytes,
    Statement: Sourceˉbodies.Compilerˉsourceˉstatement,
    Returnˉshape: u32,
    Build: Compilerˉsourceˉwirˉbuild
) -> Compilerˉsourceˉwirˉbuild {
    var Bindingˉphase: Sourceˉbindings.Compilerˉsourceˉbindingˉphase = Bindings;
    let Bindingˉbuild: Sourceˉbindings.Compilerˉsourceˉbindingˉbuild =
        Sourceˉbindings.Compilerˉsourceˉbindingsˉphaseˉbuildˉvalue(
            Bindingˉphase
        );
    let Bindingˉpayload: bytes = Bindingˉbuild.Payload;
    let Bindingˉfirst: u32 = Bindingˉbuild.Entries - Bindingˉbuild.Nextˉslot;
    let Bindingˉentries: u32 = Bindingˉbuild.Entries;
    let Headerˉblock: u32 = Build.Nextˉblock;
    var Result: Compilerˉsourceˉwirˉbuild =
        Compilerˉsourceˉwirˉreserveˉblocks(Build, 1u32);
    Result = Compilerˉsourceˉwirˉcloseˉcurrentˉblock(
        Result,
        Compilerˉsourceˉwirˉterminator.Jump,
        Compilerˉsourceˉwirˉsentinel(),
        Headerˉblock,
        Compilerˉsourceˉwirˉsentinel()
    );
    Result = Compilerˉsourceˉwirˉbeginˉreservedˉblock(Result, Headerˉblock);
    let Conditionˉposition: Sourceˉbodies.Compilerˉsourceˉposition =
        Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
            Source, Statement.Offset, Statement.Line, Statement.Column,
            Statement.Expressionˉoffset
        );
    let Conditionˉexpression: Sourceˉbodies.Compilerˉsourceˉexpression =
        Sourceˉbodies.Compilerˉparseˉexpressionˉvalidated(
            Source,
            Statement.Expressionˉoffset,
            Conditionˉposition.Line,
            Conditionˉposition.Column,
            Statement.Expressionˉoffset + Statement.Expressionˉlength,
            0u32,
            0u32
        );
    let Isˉunconditional: bool =
        Conditionˉexpression.Kind ==
            Sourceˉbodies.Compilerˉsourceˉexpressionˉkind.Boolean &&
        Conditionˉexpression.Booleanˉvalue;
    let Condition: Compilerˉsourceˉwirˉvalue =
        Compilerˉsourceˉwirˉcompileˉexpression(
            Input, Scan, Symbols,
            Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
            Source,
            Statement.Expressionˉoffset,
            Conditionˉposition.Line,
            Conditionˉposition.Column,
            Statement.Expressionˉoffset + Statement.Expressionˉlength,
            Result
        );
    if Condition.Status != Compilerˉsourceˉwirˉstatus.Valid {
        return Compilerˉsourceˉwirˉfusedˉfrom(
            Compilerˉsourceˉwirˉvalueˉbuild(Condition), Bindingˉphase
        );
    }
    if Condition.Shape == 10u32 {
        return Compilerˉsourceˉwirˉfusedˉfrom(
            Compilerˉsourceˉwirˉvalueˉbuild(Condition), Bindingˉphase
        );
    }
    if Condition.Shape != 4u32 {
        return Compilerˉsourceˉwirˉfusedˉfrom(
            Compilerˉsourceˉwirˉbuildˉfailure(
                Compilerˉsourceˉwirˉvalueˉbuild(Condition),
                Compilerˉsourceˉwirˉstatus.Invalidˉcondition,
                Build.Currentˉmodule, Build.Currentˉmodule,
                Build.Currentˉfunction,
                Statement.Expressionˉoffset,
                Conditionˉposition.Line,
                Conditionˉposition.Column
            ),
            Bindingˉphase
        );
    }
    let Bodyˉblock: u32 = Condition.Nextˉblock;
    let Afterˉblock: u32 = Bodyˉblock + 1u32;
    Result = Compilerˉsourceˉwirˉreserveˉblocks(
        Compilerˉsourceˉwirˉvalueˉbuild(Condition), 2u32
    );
    Result = Compilerˉsourceˉwirˉcloseˉcurrentˉblock(
        Result,
        Compilerˉsourceˉwirˉterminator.Branch,
        Condition.Temporary,
        Bodyˉblock,
        Afterˉblock
    );
    Result = Compilerˉsourceˉwirˉbeginˉreservedˉblock(Result, Bodyˉblock);
    let Bodyˉposition: Sourceˉbodies.Compilerˉsourceˉposition =
        Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
            Source, Statement.Offset, Statement.Line, Statement.Column,
            Statement.Firstˉblockˉoffset
        );
    let Bodyˉcompiled: Compilerˉsourceˉwirˉbuild =
        Compilerˉsourceˉwirˉcompileˉblock(
            Input, Scan, Symbols,
            Bindingˉphase,
            Source,
            Statement.Firstˉblockˉoffset,
            Bodyˉposition.Line,
            Bodyˉposition.Column,
            Statement.Firstˉblockˉoffset + Statement.Firstˉblockˉlength,
            Statement.Firstˉblockˉoffset + Statement.Firstˉblockˉlength,
            Returnˉshape,
            Headerˉblock,
            Afterˉblock,
            Statement.Offset,
            Result
        );
    if Bodyˉcompiled.Status != Compilerˉsourceˉwirˉstatus.Valid {
        return Bodyˉcompiled;
    }
    Result = Bodyˉcompiled;
    Bindingˉphase = Compilerˉsourceˉwirˉbuildˉbindings(Input, Bodyˉcompiled);
    if Result.Hasˉcurrentˉblock {
        Result = Compilerˉsourceˉwirˉcloseˉcurrentˉblock(
            Result,
            Compilerˉsourceˉwirˉterminator.Jump,
            Compilerˉsourceˉwirˉsentinel(),
            Headerˉblock,
            Compilerˉsourceˉwirˉsentinel()
        );
    }
    var Hasˉafterˉpredecessor: bool = !Isˉunconditional;
    if Isˉunconditional {
        var Blockˉindex: u32 = Bodyˉblock;
        while Blockˉindex < Result.Nextˉblock {
            let Blockˉoffset: u32 = Blockˉindex * 28u32;
            let Terminator: u32 = Bytesˉreadˉu32ˉlittle(
                Result.Blockˉpayload, Blockˉoffset + 12u32
            );
            if Terminator == 1u32 {
                if Bytesˉreadˉu32ˉlittle(
                    Result.Blockˉpayload, Blockˉoffset + 20u32
                ) == Afterˉblock {
                    Hasˉafterˉpredecessor = true;
                }
            }
            if Terminator == 2u32 {
                if Bytesˉreadˉu32ˉlittle(
                    Result.Blockˉpayload, Blockˉoffset + 20u32
                ) == Afterˉblock {
                    Hasˉafterˉpredecessor = true;
                }
                if Bytesˉreadˉu32ˉlittle(
                    Result.Blockˉpayload, Blockˉoffset + 24u32
                ) == Afterˉblock {
                    Hasˉafterˉpredecessor = true;
                }
            }
            Blockˉindex = Blockˉindex + 1u32;
        }
    }
    if Hasˉafterˉpredecessor {
        Result = Compilerˉsourceˉwirˉbeginˉreservedˉblock(
            Result, Afterˉblock
        );
    } else {
        Result = Compilerˉsourceˉwirˉappendˉblock(
            Result,
            Afterˉblock,
            Result.Operations,
            0u32,
            Compilerˉsourceˉwirˉterminator.Jump,
            Compilerˉsourceˉwirˉsentinel(),
            Afterˉblock,
            Compilerˉsourceˉwirˉsentinel()
        );
    }
    return Compilerˉsourceˉwirˉfusedˉfrom(Result, Bindingˉphase);
}

fn Compilerˉsourceˉwirˉcompileˉreturn(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Bindings: Sourceˉbindings.Compilerˉsourceˉbindingˉphase,
    Source: bytes,
    Statement: Sourceˉbodies.Compilerˉsourceˉstatement,
    Returnˉshape: u32,
    Build: Compilerˉsourceˉwirˉbuild
) -> Compilerˉsourceˉwirˉbuild {
    var Result: Compilerˉsourceˉwirˉbuild =
        Compilerˉsourceˉwirˉfusedˉfrom(Build, Bindings);
    let Bindingˉbuild: Sourceˉbindings.Compilerˉsourceˉbindingˉbuild =
        Sourceˉbindings.Compilerˉsourceˉbindingsˉphaseˉbuildˉvalue(Bindings);
    let Bindingˉpayload: bytes = Bindingˉbuild.Payload;
    let Bindingˉfirst: u32 = Bindingˉbuild.Entries - Bindingˉbuild.Nextˉslot;
    let Bindingˉentries: u32 = Bindingˉbuild.Entries;
    if Returnˉshape == 9u32 && Statement.Expressionˉlength == 0u32 {
        let Unitˉreturnˉvalue: Compilerˉsourceˉwirˉvalue =
            Compilerˉsourceˉwirˉemit(
                Result,
                WIR_OPERATION_UNIT_CONSTANT,
                9u32,
                Compilerˉsourceˉwirˉempty(Source),
                0u32,
                0u32,
                Statement.Offset,
                Statement.Length
            );
        return Compilerˉsourceˉwirˉreturnˉafterˉreleasing(
            Compilerˉsourceˉwirˉvalueˉbuild(Unitˉreturnˉvalue),
            Statement.Offset, Unitˉreturnˉvalue.Temporary
        );
    }
    if Returnˉshape == 0u32 {
        if Statement.Expressionˉlength > 0u32 {
            let Voidˉreturnˉposition: Sourceˉbodies.Compilerˉsourceˉposition =
                Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
                    Source, Statement.Offset, Statement.Line, Statement.Column,
                    Statement.Expressionˉoffset
                );
            let Voidˉreturnˉvalue: Compilerˉsourceˉwirˉvalue =
                Compilerˉsourceˉwirˉcompileˉexpression(
                    Input, Scan, Symbols,
                    Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
                    Source,
                    Statement.Expressionˉoffset,
                    Voidˉreturnˉposition.Line,
                    Voidˉreturnˉposition.Column,
                    Statement.Expressionˉoffset + Statement.Expressionˉlength,
                    Result
                );
            if Voidˉreturnˉvalue.Status != Compilerˉsourceˉwirˉstatus.Valid {
                return Compilerˉsourceˉwirˉfusedˉfrom(
                    Compilerˉsourceˉwirˉvalueˉbuild(Voidˉreturnˉvalue),
                    Bindings
                );
            }
            let Returnˉview: Sourceˉset.Compilerˉsourceˉsetˉview =
                Sourceˉset.Compilerˉsourceˉsetˉmodule(
                    Input, Scan, Result.Currentˉmodule
                );
            if Returnˉview.Edition != 1u32 || Voidˉreturnˉvalue.Shape != 0u32 {
                return Compilerˉsourceˉwirˉfusedˉfrom(
                    Compilerˉsourceˉwirˉbuildˉfailure(
                        Compilerˉsourceˉwirˉvalueˉbuild(Voidˉreturnˉvalue),
                        Compilerˉsourceˉwirˉstatus.Invalidˉreturn,
                        Result.Currentˉmodule, Result.Currentˉmodule,
                        Result.Currentˉfunction, Statement.Expressionˉoffset,
                        Voidˉreturnˉposition.Line,
                        Voidˉreturnˉposition.Column
                    ),
                    Bindings
                );
            }
            Result = Compilerˉsourceˉwirˉvalueˉbuild(Voidˉreturnˉvalue);
        }
        return Compilerˉsourceˉwirˉreturnˉafterˉreleasing(
            Result, Statement.Offset, Compilerˉsourceˉwirˉsentinel()
        );
    }
    if Statement.Expressionˉlength == 0u32 {
        return Compilerˉsourceˉwirˉfusedˉfrom(
            Compilerˉsourceˉwirˉbuildˉfailure(
                Result,
                Compilerˉsourceˉwirˉstatus.Invalidˉreturn,
                Result.Currentˉmodule, Result.Currentˉmodule,
                Result.Currentˉfunction, Statement.Offset,
                Statement.Line, Statement.Column
            ),
            Bindings
        );
    }
    let Returnˉposition: Sourceˉbodies.Compilerˉsourceˉposition =
        Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
            Source, Statement.Offset, Statement.Line, Statement.Column,
            Statement.Expressionˉoffset
        );
    let Returnˉvalue: Compilerˉsourceˉwirˉvalue =
        Compilerˉsourceˉwirˉcompileˉcontextualˉexpression(
            Input, Scan, Symbols,
            Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
            Source,
            Statement.Expressionˉoffset,
            Returnˉposition.Line, Returnˉposition.Column,
            Statement.Expressionˉoffset + Statement.Expressionˉlength,
            Returnˉshape, Result
        );
    if Returnˉvalue.Status != Compilerˉsourceˉwirˉstatus.Valid {
        return Compilerˉsourceˉwirˉfusedˉfrom(
            Compilerˉsourceˉwirˉvalueˉbuild(Returnˉvalue), Bindings
        );
    }
    if Returnˉvalue.Shape == 10u32 {
        return Compilerˉsourceˉwirˉfusedˉfrom(
            Compilerˉsourceˉwirˉvalueˉbuild(Returnˉvalue), Bindings
        );
    }
    if Returnˉvalue.Shape != Returnˉshape {
        return Compilerˉsourceˉwirˉfusedˉfrom(
            Compilerˉsourceˉwirˉbuildˉfailure(
                Compilerˉsourceˉwirˉvalueˉbuild(Returnˉvalue),
                Compilerˉsourceˉwirˉstatus.Typeˉmismatch,
                Result.Currentˉmodule, Result.Currentˉmodule,
                Result.Currentˉfunction, Statement.Expressionˉoffset,
                Returnˉposition.Line, Returnˉposition.Column
            ),
            Bindings
        );
    }
    return Compilerˉsourceˉwirˉreturnˉafterˉreleasing(
        Compilerˉsourceˉwirˉvalueˉbuild(Returnˉvalue),
        Statement.Offset, Returnˉvalue.Temporary
    );
}

fn Compilerˉsourceˉwirˉstoreˉdeclaredˉlocal(
    Input: bytes,
    Source: bytes,
    Statement: Sourceˉbodies.Compilerˉsourceˉstatement,
    Scopeˉend: u32,
    Declaredˉshape: u32,
    Value: Compilerˉsourceˉwirˉvalue,
    Bindings: Sourceˉbindings.Compilerˉsourceˉbindingˉphase
) -> Compilerˉsourceˉwirˉbuild {
    let Valueˉbuild: Compilerˉsourceˉwirˉbuild =
        Compilerˉsourceˉwirˉvalueˉbuild(Value);
    var Bindingˉphase: Sourceˉbindings.Compilerˉsourceˉbindingˉphase =
        Sourceˉbindings.Compilerˉsourceˉbindingsˉphaseˉbuild(
            Bindings,
            Sourceˉbindings.Compilerˉsourceˉbindingsˉcollectˉlocalˉshape(
                Valueˉbuild.Currentˉmodule, Valueˉbuild.Currentˉfunction,
                Source, Statement, Scopeˉend, Declaredˉshape,
                Sourceˉbindings.Compilerˉsourceˉbindingsˉphaseˉbuildˉvalue(
                    Compilerˉsourceˉwirˉbuildˉbindings(Input, Valueˉbuild)
                )
            )
        );
    if Bindingˉphase.Buildˉstatus !=
            Sourceˉbindings.Compilerˉsourceˉbindingˉstatus.Valid {
        return Compilerˉsourceˉwirˉbuildˉfailure(
            Valueˉbuild,
            Compilerˉsourceˉwirˉstatus.Sourceˉbindings,
            Bindingˉphase.Buildˉfailureˉmodule,
            Compilerˉsourceˉwirˉbindingˉfailureˉrelated(
                Bindingˉphase.Buildˉstatus,
                Bindingˉphase.Buildˉfailureˉrelatedˉmodule
            ),
            Bindingˉphase.Buildˉfailureˉfunction,
            Bindingˉphase.Buildˉfailureˉoffset,
            Bindingˉphase.Buildˉfailureˉline,
            Bindingˉphase.Buildˉfailureˉcolumn
        );
    }
    let Localˉbindings: Sourceˉbindings.Compilerˉsourceˉbindingˉbuild =
        Sourceˉbindings.Compilerˉsourceˉbindingsˉphaseˉbuildˉvalue(
            Bindingˉphase
        );
    var Useˉoffset: u32 = Statement.Nextˉoffset;
    var Expectedˉkind: Sourceˉbindings.Compilerˉsourceˉbindingˉkind =
        Sourceˉbindings.Compilerˉsourceˉbindingˉkind.Let;
    var Failureˉstatus: Compilerˉsourceˉwirˉstatus =
        Compilerˉsourceˉwirˉstatus.Typeˉmismatch;
    if Statement.Isˉmutable {
        Expectedˉkind = Sourceˉbindings.Compilerˉsourceˉbindingˉkind.Var;
    }
    if Statement.Kind == Sourceˉbodies.Compilerˉsourceˉstatementˉkind.Using {
        Useˉoffset = Statement.Firstˉblockˉoffset + 1u32;
        Expectedˉkind = Sourceˉbindings.Compilerˉsourceˉbindingˉkind.Using;
        Failureˉstatus = Compilerˉsourceˉwirˉstatus.Invalidˉresource;
    }
    if Statement.Kind ==
            Sourceˉbodies.Compilerˉsourceˉstatementˉkind.Taskˉscope {
        Useˉoffset = Statement.Firstˉblockˉoffset + 1u32;
        Expectedˉkind =
            Sourceˉbindings.Compilerˉsourceˉbindingˉkind.Taskˉjoin;
        if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(
                Source, Statement.Typeˉoffset, Statement.Typeˉlength,
                "cancel_join"
            ) {
            Expectedˉkind = Sourceˉbindings.Compilerˉsourceˉbindingˉkind.Taskˉcancelˉjoin;
        }
        if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(
                Source, Statement.Typeˉoffset, Statement.Typeˉlength,
                "fail_join"
            ) {
            Expectedˉkind = Sourceˉbindings.Compilerˉsourceˉbindingˉkind.Taskˉfailˉjoin;
        }
        Failureˉstatus = Compilerˉsourceˉwirˉstatus.Invalidˉtask;
    }
    let Local: Sourceˉbindings.Compilerˉsourceˉlocalˉmatch =
        Sourceˉbindings.Compilerˉsourceˉbindingsˉfindˉlocal(
            Source, Localˉbindings.Payload,
            Localˉbindings.Entries - Localˉbindings.Nextˉslot,
            Localˉbindings.Entries,
            Statement.Nameˉoffset, Statement.Nameˉlength, Useˉoffset
        );
    if !Local.Found || Local.Kind != Expectedˉkind ||
        Local.Shape != Value.Shape {
        let Failureˉposition: Sourceˉbodies.Compilerˉsourceˉposition =
            Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
                Source, Statement.Offset, Statement.Line, Statement.Column,
                Statement.Expressionˉoffset
            );
        return Compilerˉsourceˉwirˉfusedˉfrom(
            Compilerˉsourceˉwirˉbuildˉfailure(
                Valueˉbuild, Failureˉstatus,
                Valueˉbuild.Currentˉmodule, Valueˉbuild.Currentˉmodule,
                Valueˉbuild.Currentˉfunction, Statement.Expressionˉoffset,
                Failureˉposition.Line, Failureˉposition.Column
            ),
            Bindingˉphase
        );
    }
    let Stored: Compilerˉsourceˉwirˉvalue = Compilerˉsourceˉwirˉemit(
        Valueˉbuild,
        WIR_OPERATION_STORE_LOCAL, 0u32,
        Compilerˉsourceˉwirˉoneˉoperand(Value.Temporary),
        Local.Slot, 0u32, Statement.Offset, Statement.Length
    );
    return Compilerˉsourceˉwirˉfusedˉfrom(
        Compilerˉsourceˉwirˉvalueˉbuild(Stored), Bindingˉphase
    );
}

fn Compilerˉsourceˉwirˉcompileˉusing(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Bindings: Sourceˉbindings.Compilerˉsourceˉbindingˉphase,
    Source: bytes,
    Statement: Sourceˉbodies.Compilerˉsourceˉstatement,
    Returnˉshape: u32,
    Continueˉtarget: u32,
    Breakˉtarget: u32,
    Loopˉscopeˉoffset: u32,
    Build: Compilerˉsourceˉwirˉbuild
) -> Compilerˉsourceˉwirˉbuild {
    let Bindingˉbuild: Sourceˉbindings.Compilerˉsourceˉbindingˉbuild =
        Sourceˉbindings.Compilerˉsourceˉbindingsˉphaseˉbuildˉvalue(Bindings);
    let Resourceˉposition: Sourceˉbodies.Compilerˉsourceˉposition =
        Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
            Source, Statement.Offset, Statement.Line, Statement.Column,
            Statement.Expressionˉoffset
        );
    let Resource: Compilerˉsourceˉwirˉvalue =
        Compilerˉsourceˉwirˉcompileˉcontextualˉexpression(
            Input, Scan, Symbols,
            Bindingˉbuild.Payload,
            Bindingˉbuild.Entries - Bindingˉbuild.Nextˉslot,
            Bindingˉbuild.Entries,
            Source, Statement.Expressionˉoffset,
            Resourceˉposition.Line, Resourceˉposition.Column,
            Statement.Expressionˉoffset + Statement.Expressionˉlength,
            0u32, Compilerˉsourceˉwirˉfusedˉfrom(Build, Bindings)
        );
    if Resource.Status != Compilerˉsourceˉwirˉstatus.Valid ||
        Resource.Shape == 10u32 {
        return Compilerˉsourceˉwirˉfusedˉfrom(
            Compilerˉsourceˉwirˉvalueˉbuild(Resource), Bindings
        );
    }
    let Typeˉcatalog: Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog =
        Compilerˉsourceˉwirˉgenericˉtypeˉcatalog(Resource.Genericˉevidence);
    if !Compilerˉsourceˉwirˉshapeˉisˉfoundationˉvector(
            Resource.Shape, Typeˉcatalog
        ) && Resource.Shape != 805306369u32 {
        return Compilerˉsourceˉwirˉfusedˉfrom(
            Compilerˉsourceˉwirˉbuildˉfailure(
                Compilerˉsourceˉwirˉvalueˉbuild(Resource),
                Compilerˉsourceˉwirˉstatus.Invalidˉresource,
                Build.Currentˉmodule, Build.Currentˉmodule,
                Build.Currentˉfunction, Statement.Expressionˉoffset,
                Resourceˉposition.Line, Resourceˉposition.Column
            ), Bindings
        );
    }
    let Scopeˉend: u32 = Statement.Firstˉblockˉoffset +
        Statement.Firstˉblockˉlength;
    var Result: Compilerˉsourceˉwirˉbuild =
        Compilerˉsourceˉwirˉstoreˉdeclaredˉlocal(
            Input, Source, Statement, Scopeˉend, Resource.Shape,
            Resource, Bindings
        );
    if Result.Status != Compilerˉsourceˉwirˉstatus.Valid {
        return Result;
    }
    let Bindingˉphase: Sourceˉbindings.Compilerˉsourceˉbindingˉphase =
        Compilerˉsourceˉwirˉbuildˉbindings(Input, Result);
    let Bodyˉposition: Sourceˉbodies.Compilerˉsourceˉposition =
        Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
            Source, Statement.Offset, Statement.Line, Statement.Column,
            Statement.Firstˉblockˉoffset
        );
    Result = Compilerˉsourceˉwirˉcompileˉblock(
        Input, Scan, Symbols, Bindingˉphase, Source,
        Statement.Firstˉblockˉoffset,
        Bodyˉposition.Line, Bodyˉposition.Column,
        Scopeˉend, Scopeˉend, Returnˉshape,
        Continueˉtarget, Breakˉtarget,
        Loopˉscopeˉoffset,
        Result
    );
    if Result.Status != Compilerˉsourceˉwirˉstatus.Valid {
        return Result;
    }
    if Result.Hasˉcurrentˉblock {
        Result = Compilerˉsourceˉwirˉreleaseˉscopedˉforˉexit(
            Result, Scopeˉend - 1u32, Scopeˉend
        );
    }
    return Result;
}

fn Compilerˉsourceˉwirˉcompileˉtaskˉscope(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Bindings: Sourceˉbindings.Compilerˉsourceˉbindingˉphase,
    Source: bytes,
    Statement: Sourceˉbodies.Compilerˉsourceˉstatement,
    Returnˉshape: u32,
    Continueˉtarget: u32,
    Breakˉtarget: u32,
    Loopˉscopeˉoffset: u32,
    Build: Compilerˉsourceˉwirˉbuild
) -> Compilerˉsourceˉwirˉbuild {
    let Bindingˉbuild: Sourceˉbindings.Compilerˉsourceˉbindingˉbuild =
        Sourceˉbindings.Compilerˉsourceˉbindingsˉphaseˉbuildˉvalue(
            Bindings
        );
    let Constructionˉposition:
        Sourceˉbodies.Compilerˉsourceˉposition =
        Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
            Source, Statement.Offset, Statement.Line, Statement.Column,
            Statement.Expressionˉoffset
        );
    let Scope: Compilerˉsourceˉwirˉvalue =
        Compilerˉsourceˉwirˉcompileˉcontextualˉexpression(
            Input, Scan, Symbols,
            Bindingˉbuild.Payload,
            Bindingˉbuild.Entries - Bindingˉbuild.Nextˉslot,
            Bindingˉbuild.Entries,
            Source, Statement.Expressionˉoffset,
            Constructionˉposition.Line, Constructionˉposition.Column,
            Statement.Expressionˉoffset + Statement.Expressionˉlength,
            0u32, Compilerˉsourceˉwirˉfusedˉfrom(Build, Bindings)
        );
    if Scope.Status != Compilerˉsourceˉwirˉstatus.Valid ||
        Scope.Shape == 10u32 {
        return Compilerˉsourceˉwirˉfusedˉfrom(
            Compilerˉsourceˉwirˉvalueˉbuild(Scope), Bindings
        );
    }
    if !Compilerˉsourceˉwirˉshapeˉisˉtaskˉscope(
            Input, Scan, Symbols, Scope.Shape
        ) {
        return Compilerˉsourceˉwirˉfusedˉfrom(
            Compilerˉsourceˉwirˉbuildˉfailure(
                Compilerˉsourceˉwirˉvalueˉbuild(Scope),
                Compilerˉsourceˉwirˉstatus.Invalidˉtask,
                Build.Currentˉmodule, Build.Currentˉmodule,
                Build.Currentˉfunction, Statement.Expressionˉoffset,
                Constructionˉposition.Line, Constructionˉposition.Column
            ), Bindings
        );
    }
    let Scopeˉend: u32 = Statement.Firstˉblockˉoffset +
        Statement.Firstˉblockˉlength;
    var Result: Compilerˉsourceˉwirˉbuild =
        Compilerˉsourceˉwirˉstoreˉdeclaredˉlocal(
            Input, Source, Statement, Scopeˉend, Scope.Shape,
            Scope, Bindings
        );
    if Result.Status != Compilerˉsourceˉwirˉstatus.Valid { return Result; }
    let Scopeˉbindings: Sourceˉbindings.Compilerˉsourceˉbindingˉphase =
        Compilerˉsourceˉwirˉbuildˉbindings(Input, Result);
    let Bodyˉposition: Sourceˉbodies.Compilerˉsourceˉposition =
        Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
            Source, Statement.Offset, Statement.Line, Statement.Column,
            Statement.Firstˉblockˉoffset
        );
    Result = Compilerˉsourceˉwirˉcompileˉblock(
        Input, Scan, Symbols, Scopeˉbindings, Source,
        Statement.Firstˉblockˉoffset,
        Bodyˉposition.Line, Bodyˉposition.Column,
        Scopeˉend, Scopeˉend, Returnˉshape,
        Continueˉtarget, Breakˉtarget, Loopˉscopeˉoffset, Result
    );
    if Result.Status != Compilerˉsourceˉwirˉstatus.Valid { return Result; }
    if Result.Hasˉcurrentˉblock {
        Result = Compilerˉsourceˉwirˉreleaseˉscopedˉforˉexit(
            Result, Scopeˉend - 1u32, Scopeˉend
        );
    }
    return Result;
}

export fn Compilerˉsourceˉwirˉcompileˉblock(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Bindings: Sourceˉbindings.Compilerˉsourceˉbindingˉphase,
    Source: bytes,
    Offset: u32,
    Line: u32,
    Column: u32,
    Endˉoffset: u32,
    Scopeˉendˉoffset: u32,
    Returnˉshape: u32,
    Continueˉtarget: u32,
    Breakˉtarget: u32,
    Loopˉscopeˉoffset: u32,
    Build: Compilerˉsourceˉwirˉbuild
) -> Compilerˉsourceˉwirˉbuild {
    let Start: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉbodies.Compilerˉbodyˉtoken(
        Source, Offset, Line, Column, Endˉoffset
    );
    let Isˉblock: bool = Start.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Leftˉbrace;
    var Cursor: u32 = Start.Offset;
    var Currentˉline: u32 = Start.Line;
    var Currentˉcolumn: u32 = Start.Column;
    if Isˉblock {
        Cursor = Start.Nextˉoffset;
        Currentˉline = Start.Nextˉline;
        Currentˉcolumn = Start.Nextˉcolumn;
    }
    var Result: Compilerˉsourceˉwirˉbuild =
        Compilerˉsourceˉwirˉfusedˉfrom(Build, Bindings);
    var Bindingˉphase: Sourceˉbindings.Compilerˉsourceˉbindingˉphase = Bindings;
    var Reading: bool = true;
    while Reading {
        let Current: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉbodies.Compilerˉbodyˉtoken(
            Source, Cursor, Currentˉline, Currentˉcolumn, Endˉoffset
        );
        if Isˉblock {
            if Current.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Rightˉbrace {
                Reading = false;
            }
        } else {
            if Current.Kind == Sourceˉlexer.Compilerˉtokenˉkind.End {
                Reading = false;
            }
        }
        if Reading {
            if !Result.Hasˉcurrentˉblock {
                return Compilerˉsourceˉwirˉfusedˉfrom(
                    Compilerˉsourceˉwirˉbuildˉfailure(
                        Result,
                        Compilerˉsourceˉwirˉstatus.Unreachableˉstatement,
                        Result.Currentˉmodule,
                        Result.Currentˉmodule,
                        Result.Currentˉfunction,
                        Current.Offset,
                        Current.Line,
                        Current.Column
                    ),
                    Bindingˉphase
                );
