    Failureˉcolumn: u32;
}

export record Compilerˉsourceˉwirˉcompilation {
    Status: Compilerˉsourceˉwirˉstatus;
    Bindingˉstatus: Sourceˉbindings.Compilerˉsourceˉbindingˉstatus;
    Modules: u32;
    Functions: u32;
    Blocks: u32;
    Operations: u32;
    Temporaries: u32;
    Operands: u32;
    Directory: bytes;
    Failureˉmodule: u32;
    Failureˉrelatedˉmodule: u32;
    Failureˉfunction: u32;
    Failureˉoffset: u32;
    Failureˉline: u32;
    Failureˉcolumn: u32;
    Bindingˉparameters: u32;
    Bindingˉlocals: u32;
    Bindingˉreads: u32;
    Bindingˉassignments: u32;
    Bindingˉcalls: u32;
    Bindingˉdirectory: bytes;
}

export fn Compilerˉsourceˉwirˉempty(Input: bytes) -> bytes {
    return Bytesˉslice(Input, 0u32, 0u32);
}

fn Compilerˉsourceˉwirˉcanonicalˉfunctionˉtypeˉcatalog(
    Catalog: Compilerˉsourceˉwirˉfunctionˉtypeˉcatalog
) -> Functionˉtypes.Compilerˉsourceˉfunctionˉtypeˉcatalog {
    return Functionˉtypes.Compilerˉsourceˉfunctionˉtypeˉcatalog(
        Functionˉtypes.Compilerˉsourceˉfunctionˉtypeˉstatus.Valid,
        Catalog.Evidence
    );
}

fn Compilerˉsourceˉwirˉfunctionˉtypeˉcatalogˉempty(
) -> Compilerˉsourceˉwirˉfunctionˉtypeˉcatalog {
    let Catalog: Functionˉtypes.Compilerˉsourceˉfunctionˉtypeˉcatalog =
        Functionˉtypes.Compilerˉsourceˉfunctionˉtypeˉcatalogˉempty();
    return Compilerˉsourceˉwirˉfunctionˉtypeˉcatalog(Catalog.Evidence);
}

fn Compilerˉsourceˉwirˉfunctionˉtypeˉcatalogˉinstances(
    Catalog: Compilerˉsourceˉwirˉfunctionˉtypeˉcatalog
) -> u32 {
    return Functionˉtypes.Compilerˉsourceˉfunctionˉtypeˉcatalogˉinstances(
        Compilerˉsourceˉwirˉcanonicalˉfunctionˉtypeˉcatalog(Catalog)
    );
}

fn Compilerˉsourceˉwirˉfunctionˉtypeˉshape(Instance: u32) -> u32 {
    return Functionˉtypes.Compilerˉsourceˉfunctionˉtypeˉshape(Instance);
}

fn Compilerˉsourceˉwirˉfunctionˉtypeˉshapeˉisˉprivate(
    Shape: u32
) -> bool {
    return Functionˉtypes.Compilerˉsourceˉfunctionˉtypeˉshapeˉisˉprivate(
        Shape
    );
}

fn Compilerˉsourceˉwirˉfunctionˉtypeˉshapeˉinstance(
    Shape: u32
) -> u32 {
    return Functionˉtypes.Compilerˉsourceˉfunctionˉtypeˉshapeˉinstance(
        Shape
    );
}

fn Compilerˉsourceˉwirˉfunctionˉtypeˉcatalogˉisˉvalid(
    Catalog: Compilerˉsourceˉwirˉfunctionˉtypeˉcatalog
) -> bool {
    return Functionˉtypes.Compilerˉsourceˉfunctionˉtypeˉcatalogˉisˉvalid(
        Compilerˉsourceˉwirˉcanonicalˉfunctionˉtypeˉcatalog(Catalog)
    );
}

fn Compilerˉsourceˉwirˉfunctionˉtypeˉparametersˉfromˉshapes(
    Shapes: bytes
) -> bytes {
    var Result: bytes = Bytesˉslice(Shapes, 0u32, 0u32);
    if Bytesˉlength(Shapes) % 4u32 != 0u32 { return Result; }
    var Offset: u32 = 0u32;
    while Offset < Bytesˉlength(Shapes) {
        Result =
            Functionˉtypes.Compilerˉsourceˉfunctionˉtypeˉparametersˉappend(
                Result, Bytesˉreadˉu32ˉlittle(Shapes, Offset),
                Sourceˉdeclarations.COMPILER_SOURCE_BORROW_MODE_VALUE
            );
        Offset = Offset + 4u32;
    }
    return Result;
}

fn Compilerˉsourceˉwirˉfunctionˉtypeˉcatalogˉadmitˉexact(
    Catalog: Compilerˉsourceˉwirˉfunctionˉtypeˉcatalog,
    Flags: u32,
    Profile: u32,
    Resultˉshape: u32,
    Resultˉmode: u32,
    Languageˉeffects: u32,
    Capabilityˉeffects: u32,
    Parameters: bytes
) -> Compilerˉsourceˉwirˉfunctionˉtypeˉadmission {
    let Admission:
        Functionˉtypes.Compilerˉsourceˉfunctionˉtypeˉadmission =
        Functionˉtypes.Compilerˉsourceˉfunctionˉtypeˉcatalogˉadmit(
            Compilerˉsourceˉwirˉcanonicalˉfunctionˉtypeˉcatalog(Catalog),
            Flags, Profile, Resultˉshape, Resultˉmode,
            Languageˉeffects, Capabilityˉeffects, Parameters, 0u32
        );
    return Compilerˉsourceˉwirˉfunctionˉtypeˉadmission(
        Admission.Status ==
            Functionˉtypes.Compilerˉsourceˉfunctionˉtypeˉstatus.Valid,
        Admission.Catalogˉevidence, Admission.Instance
    );
}

fn Compilerˉsourceˉwirˉfunctionˉtypeˉcatalogˉadmit(
    Catalog: Compilerˉsourceˉwirˉfunctionˉtypeˉcatalog,
    Profile: u32,
    Resultˉshape: u32,
    Parameters: bytes
) -> Compilerˉsourceˉwirˉfunctionˉtypeˉadmission {
    return Compilerˉsourceˉwirˉfunctionˉtypeˉcatalogˉadmitˉexact(
        Catalog, 0u32, Profile, Resultˉshape,
        Sourceˉdeclarations.COMPILER_SOURCE_BORROW_MODE_VALUE,
        0u32, 0u32,
        Compilerˉsourceˉwirˉfunctionˉtypeˉparametersˉfromˉshapes(
            Parameters
        )
    );
}

fn Compilerˉsourceˉwirˉfunctionˉtypeˉflags(
    Catalog: Compilerˉsourceˉwirˉfunctionˉtypeˉcatalog,
    Instance: u32
) -> u32 {
    return Functionˉtypes.Compilerˉsourceˉfunctionˉtypeˉflags(
        Compilerˉsourceˉwirˉcanonicalˉfunctionˉtypeˉcatalog(Catalog),
        Instance
    );
}

fn Compilerˉsourceˉwirˉfunctionˉtypeˉprofile(
    Catalog: Compilerˉsourceˉwirˉfunctionˉtypeˉcatalog,
    Instance: u32
) -> u32 {
    return Functionˉtypes.Compilerˉsourceˉfunctionˉtypeˉprofile(
        Compilerˉsourceˉwirˉcanonicalˉfunctionˉtypeˉcatalog(Catalog),
        Instance
    );
}

fn Compilerˉsourceˉwirˉfunctionˉtypeˉresultˉshape(
    Catalog: Compilerˉsourceˉwirˉfunctionˉtypeˉcatalog,
    Instance: u32
) -> u32 {
    return Functionˉtypes.Compilerˉsourceˉfunctionˉtypeˉresultˉshape(
        Compilerˉsourceˉwirˉcanonicalˉfunctionˉtypeˉcatalog(Catalog),
        Instance
    );
}

fn Compilerˉsourceˉwirˉfunctionˉtypeˉresultˉmode(
