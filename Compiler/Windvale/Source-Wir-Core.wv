        Compilerˉsourceˉwirˉvalueˉbuild(Maximumˉchildren),
        WIR_OPERATION_FOUNDATION_MEMORY_SPLIT, Expectedˉshape,
        Operands, Parentˉlocal.Slot, Callable.Module,
        Expression.Offset, Expression.Length
    );
}

fn Compilerˉsourceˉwirˉcallˉoperands(
    Source: bytes,
    Items: u32,
    Named: bool
) -> bytes {
    if !Named { return Compilerˉsourceˉwirˉempty(Source); }
    let Repeated: Byteˉconstruction.Foundationˉbytesˉresult =
        Byteˉconstruction.Foundationˉbytesˉrepeat(
            255u8, Items * 4u32
        );
    return Repeated.Value;
}

fn Compilerˉsourceˉwirˉcompileˉindirectˉcall(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Bindingˉpayload: bytes,
    Bindingˉfirst: u32,
    Bindingˉentries: u32,
    Source: bytes,
    Expression: Sourceˉbodies.Compilerˉsourceˉexpression,
    Local: Sourceˉbindings.Compilerˉsourceˉlocalˉmatch,
    Awaited: bool,
    Build: Compilerˉsourceˉwirˉbuild
) -> Compilerˉsourceˉwirˉvalue {
    let Catalog: Compilerˉsourceˉwirˉfunctionˉtypeˉcatalog =
        Compilerˉsourceˉwirˉfunctionˉtypeˉcatalogˉfromˉgeneric(
            Build.Genericˉevidence
        );
    let Instance: u32 =
        Compilerˉsourceˉwirˉfunctionˉtypeˉshapeˉinstance(
            Local.Shape
        );
    if !Compilerˉsourceˉwirˉfunctionˉtypeˉcatalogˉisˉvalid(
            Catalog
        ) ||
        Instance >=
            Compilerˉsourceˉwirˉfunctionˉtypeˉcatalogˉinstances(
                Catalog
            ) ||
        Expression.Kind !=
            Sourceˉbodies.Compilerˉsourceˉexpressionˉkind.Call ||
        Expression.Operator == Sourceˉlexer.Compilerˉtokenˉkind.Colon ||
        Expression.Items !=
            Compilerˉsourceˉwirˉfunctionˉtypeˉparameters(
                Catalog, Instance
            ) {
        return Compilerˉsourceˉwirˉfailureˉvalue(
            Build, Compilerˉsourceˉwirˉstatus.Invalidˉcallable,
            Build.Currentˉmodule,
            Expression.Offset, Expression.Line, Expression.Column
        );
    }
    if Awaited != ((Compilerˉsourceˉwirˉfunctionˉtypeˉflags(
            Catalog, Instance
        ) & 1u32) != 0u32) ||
        (Awaited && !Compilerˉsourceˉwirˉcurrentˉfunctionˉisˉasync(
            Input, Scan, Symbols, Build
        )) {
        return Compilerˉsourceˉwirˉfailureˉvalue(
            Build, Compilerˉsourceˉwirˉstatus.Invalidˉtask,
            Build.Currentˉmodule,
            Expression.Offset, Expression.Line, Expression.Column
        );
    }
    if (Compilerˉsourceˉwirˉfunctionˉtypeˉflags(
            Catalog, Instance
        ) & 2u32) != 0u32 && Build.Unsafeˉdepth == 0u32 {
        return Compilerˉsourceˉwirˉfailureˉvalue(
            Build, Compilerˉsourceˉwirˉstatus.Unsafeˉcontextˉrequired,
            Build.Currentˉmodule,
            Expression.Offset, Expression.Line, Expression.Column
        );
    }
    let Reference: Compilerˉsourceˉwirˉvalue =
        Compilerˉsourceˉwirˉemit(
            Build, WIR_OPERATION_LOAD_LOCAL, Local.Shape,
            Compilerˉsourceˉwirˉempty(Source),
            Local.Slot, 0u32, Expression.Valueˉoffset,
            Expression.Valueˉlength
        );
    var Result: Compilerˉsourceˉwirˉbuild =
        Compilerˉsourceˉwirˉvalueˉbuild(Reference);
    var Operands: bytes = Bytesˉfromˉu32ˉlittle(Reference.Temporary);
    var Cursor: u32 = Expression.Itemsˉoffset;
    var Position: Sourceˉbodies.Compilerˉsourceˉposition =
        Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
            Source, Expression.Offset, Expression.Line, Expression.Column,
            Expression.Itemsˉoffset
        );
    var Parameter: u32 = 0u32;
    while Parameter < Expression.Items {
        let Argument: Sourceˉbodies.Compilerˉsourceˉexpression =
            Sourceˉbodies.Compilerˉparseˉexpressionˉvalidated(
                Source, Cursor, Position.Line, Position.Column,
                Expression.Itemsˉoffset + Expression.Itemsˉlength,
                0u32, 0u32
            );
        if Argument.Kind ==
                Sourceˉbodies.Compilerˉsourceˉexpressionˉkind.Unary &&
            Argument.Operator == Sourceˉlexer.Compilerˉtokenˉkind.Borrow {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Result, Compilerˉsourceˉwirˉstatus.Invalidˉcallable,
                Build.Currentˉmodule,
                Argument.Offset, Argument.Line, Argument.Column
            );
        }
        let Expected: u32 =
            Compilerˉsourceˉwirˉfunctionˉtypeˉparameterˉshape(
                Catalog, Instance, Parameter
            );
        let Value: Compilerˉsourceˉwirˉvalue =
            Compilerˉsourceˉwirˉcompileˉcontextualˉexpression(
                Input, Scan, Symbols,
                Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
                Source, Argument.Offset, Argument.Line, Argument.Column,
                Argument.Offset + Argument.Length, Expected, Result
            );
        if Value.Status != Compilerˉsourceˉwirˉstatus.Valid {
            return Value;
        }
        if Value.Shape != Expected {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Compilerˉsourceˉwirˉvalueˉbuild(Value),
                Compilerˉsourceˉwirˉstatus.Invalidˉargument,
                Build.Currentˉmodule,
                Argument.Offset, Argument.Line, Argument.Column
            );
        }
        Operands = Bytesˉconcat(
            Operands, Bytesˉfromˉu32ˉlittle(Value.Temporary)
        );
        Result = Compilerˉsourceˉwirˉvalueˉbuild(Value);
        Cursor = Argument.Nextˉoffset;
        Position = Sourceˉbodies.Compilerˉsourceˉposition(
            Argument.Nextˉoffset, Argument.Nextˉline,
            Argument.Nextˉcolumn
        );
        if Parameter + 1u32 < Expression.Items {
            let Separator: Sourceˉlexer.Compilerˉsourceˉtoken =
                Sourceˉbodies.Compilerˉbodyˉtoken(
                    Source, Cursor, Position.Line, Position.Column,
                    Expression.Itemsˉoffset + Expression.Itemsˉlength
                );
            Cursor = Separator.Nextˉoffset;
            Position = Sourceˉbodies.Compilerˉsourceˉposition(
                Separator.Nextˉoffset, Separator.Nextˉline,
                Separator.Nextˉcolumn
            );
        }
        Parameter = Parameter + 1u32;
    }
    let Returnˉshape: u32 =
        Compilerˉsourceˉwirˉfunctionˉtypeˉresultˉshape(
            Catalog, Instance
        );
    if Returnˉshape == 0u32 || Returnˉshape == 10u32 {
        return Compilerˉsourceˉwirˉfailureˉvalue(
            Result, Compilerˉsourceˉwirˉstatus.Invalidˉcallable,
            Build.Currentˉmodule,
            Expression.Offset, Expression.Line, Expression.Column
        );
    }
    return Compilerˉsourceˉwirˉemit(
        Result, WIR_OPERATION_CALL_INDIRECT, Returnˉshape,
        Operands, Instance, 0u32,
        Expression.Offset, Expression.Length
    );
}

fn Compilerˉsourceˉwirˉtaskˉfailure(
    Build: Compilerˉsourceˉwirˉbuild,
    Expression: Sourceˉbodies.Compilerˉsourceˉexpression
) -> Compilerˉsourceˉwirˉvalue {
    return Compilerˉsourceˉwirˉfailureˉvalue(
        Build, Compilerˉsourceˉwirˉstatus.Invalidˉtask,
        Build.Currentˉmodule,
        Expression.Offset, Expression.Line, Expression.Column
    );
}

fn Compilerˉsourceˉwirˉcallableˉisˉasync(
    Callable: Sourceˉbindings.Compilerˉsourceˉbindingˉmatch
) -> bool {
    return Callable.Kind ==
        Sourceˉbindings.Compilerˉsourceˉcallableˉkind.Asynchronousˉfunction;
}

fn Compilerˉsourceˉwirˉcallableˉisˉunsafe(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Callable: Sourceˉbindings.Compilerˉsourceˉbindingˉmatch
) -> bool {
    if Callable.Kind ==
            Sourceˉbindings.Compilerˉsourceˉcallableˉkind.Intrinsic &&
        (Callable.Directoryˉentry ==
            WIR_OPERATION_FOUNDATION_UNSAFE_BORROW_WRITE_REGION ||
        Callable.Directoryˉentry ==
            WIR_OPERATION_FOUNDATION_UNSAFE_WRITE_POINTER) {
        return true;
    }
    if Callable.Kind ==
            Sourceˉbindings.Compilerˉsourceˉcallableˉkind.Foreign {
        return true;
    }
    if Callable.Kind !=
            Sourceˉbindings.Compilerˉsourceˉcallableˉkind.Function &&
        Callable.Kind !=
            Sourceˉbindings.Compilerˉsourceˉcallableˉkind.Asynchronousˉfunction {
        return false;
    }
    let Directoryˉentry: u32 = 16u32 + Callable.Directoryˉentry * 24u32;
    if Directoryˉentry > Bytesˉlength(Symbols.Directory) ||
        Bytesˉlength(Symbols.Directory) - Directoryˉentry < 24u32 {
        return false;
    }
    let Declarationˉoffset: u32 = Bytesˉreadˉu32ˉlittle(
        Symbols.Directory, Directoryˉentry + 8u32
    );
    let View: Sourceˉset.Compilerˉsourceˉsetˉview =
        Sourceˉset.Compilerˉsourceˉsetˉmodule(Input, Scan, Callable.Module);
    if Declarationˉoffset >= Bytesˉlength(View.Source) { return false; }
    var Current: Sourceˉlexer.Compilerˉsourceˉtoken =
        Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            View.Source, Declarationˉoffset, 1u32, 1u32
        );
    if Current.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Export {
        Current = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            View.Source, Current.Nextˉoffset,
            Current.Nextˉline, Current.Nextˉcolumn
        );
    }
    return Current.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Unsafe;
}

fn Compilerˉsourceˉwirˉtaskˉargumentˉexpression(
    Source: bytes,
    Argument: Compilerˉsourceˉwirˉtaskˉargument
) -> Sourceˉbodies.Compilerˉsourceˉexpression {
    return Sourceˉbodies.Compilerˉparseˉexpressionˉvalidated(
        Source, Argument.Valueˉoffset,
        Argument.Valueˉline, Argument.Valueˉcolumn,
        Argument.Valueˉoffset + Argument.Valueˉlength, 0u32, 0u32
    );
}

fn Compilerˉsourceˉwirˉtaskˉlocal(
    Bindingˉpayload: bytes,
    Bindingˉfirst: u32,
    Bindingˉentries: u32,
    Source: bytes,
    Argument: Compilerˉsourceˉwirˉtaskˉargument
) -> Sourceˉbindings.Compilerˉsourceˉlocalˉmatch {
    if !Argument.Found {
        return Sourceˉbindings.Compilerˉsourceˉlocalˉmatch(
            false, Sourceˉbindings.Compilerˉsourceˉbindingˉkind.None,
            0u32, 0u32, 0u32
        );
    }
    let Expression: Sourceˉbodies.Compilerˉsourceˉexpression =
        Compilerˉsourceˉwirˉtaskˉargumentˉexpression(Source, Argument);
    if Expression.Kind !=
            Sourceˉbodies.Compilerˉsourceˉexpressionˉkind.Name {
        return Sourceˉbindings.Compilerˉsourceˉlocalˉmatch(
            false, Sourceˉbindings.Compilerˉsourceˉbindingˉkind.None,
            0u32, 0u32, 0u32
        );
    }
    return Sourceˉbindings.Compilerˉsourceˉbindingsˉfindˉlocal(
        Source, Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
        Expression.Valueˉoffset, Expression.Valueˉlength,
        Expression.Offset
    );
}

fn Compilerˉsourceˉwirˉtaskˉscopeˉlocal(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Bindingˉpayload: bytes,
    Bindingˉfirst: u32,
    Bindingˉentries: u32,
    Source: bytes,
    Argument: Compilerˉsourceˉwirˉtaskˉargument,
    Mode: u32
) -> Sourceˉbindings.Compilerˉsourceˉlocalˉmatch {
    let Local: Sourceˉbindings.Compilerˉsourceˉlocalˉmatch =
        Compilerˉsourceˉwirˉtaskˉlocal(
            Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
            Source, Argument
        );
    let Kind: u32 = Sourceˉbindings.Compilerˉsourceˉbindingsˉkindˉvalue(
        Local.Kind
    );
    if Argument.Mode != Mode || !Local.Found ||
        Kind < 5u32 || Kind > 7u32 ||
        !Compilerˉsourceˉwirˉshapeˉisˉtaskˉscope(
            Input, Scan, Symbols, Local.Shape
        ) {
        return Sourceˉbindings.Compilerˉsourceˉlocalˉmatch(
            false, Sourceˉbindings.Compilerˉsourceˉbindingˉkind.None,
            0u32, 0u32, 0u32
        );
    }
    return Local;
}

fn Compilerˉsourceˉwirˉcurrentˉfunctionˉisˉasync(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Build: Compilerˉsourceˉwirˉbuild
) -> bool {
    let Genericˉcatalog: Sourceˉgenerics.Compilerˉsourceˉgenericˉcatalog =
        Compilerˉsourceˉwirˉgenericˉcatalog(Build.Genericˉevidence);
    let Genericˉinstances: u32 =
        Sourceˉgenerics.Compilerˉsourceˉgenericˉcatalogˉinstances(
            Genericˉcatalog
        );
    let Baseˉfunctions: u32 =
        Compilerˉsourceˉwirˉsymbolˉentries(Symbols) + Genericˉinstances;
    var Module: u32 = Build.Currentˉmodule;
    var Offset: u32 = Compilerˉsourceˉwirˉsentinel();
    if Build.Currentˉfunction < Baseˉfunctions {
        var Declaration: u32 = Build.Currentˉfunction;
        if Build.Genericˉinstance != Compilerˉsourceˉwirˉsentinel() {
            Declaration =
                Sourceˉgenerics.Compilerˉsourceˉgenericˉcatalogˉinstanceˉdeclaration(
                    Genericˉcatalog, Build.Genericˉinstance
                );
        }
        if Declaration >= Bytesˉreadˉu32ˉlittle(Symbols.Directory, 8u32) {
            return false;
        }
        let Entry: Sourceˉsymbols.Compilerˉsourceˉsymbolˉmatch =
            Sourceˉsymbols.Compilerˉsourceˉsymbolsˉdirectoryˉentry(
                Symbols.Directory, Scan.Modules, Declaration
            );
        if !Entry.Found { return false; }
        Module = Entry.Module;
        Offset = Entry.Declarationˉoffset;
    } else {
        let Closures: Closureˉlowering.Compilerˉsourceˉclosureˉcatalog =
            Compilerˉsourceˉwirˉclosureˉcatalog(Build);
        let Instance: u32 = Build.Currentˉfunction - Baseˉfunctions;
        Module = Closureˉlowering.Compilerˉsourceˉclosureˉcatalogˉmodule(
            Closures, Instance
        );
        Offset = Closureˉlowering.Compilerˉsourceˉclosureˉcatalogˉoffset(
            Closures, Instance
        );
        if Module >= Scan.Modules ||
            Offset == Compilerˉsourceˉwirˉsentinel() {
            return false;
        }
        let Closureˉview: Sourceˉset.Compilerˉsourceˉsetˉview =
            Sourceˉset.Compilerˉsourceˉsetˉmodule(Input, Scan, Module);
        let Position: Sourceˉbodies.Compilerˉsourceˉposition =
            Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
                Closureˉview.Source, 0u32, 1u32, 1u32, Offset
            );
        let Expression: Sourceˉbodies.Compilerˉsourceˉexpression =
            Sourceˉbodies.Compilerˉparseˉexpressionˉvalidated(
                Closureˉview.Source, Offset, Position.Line, Position.Column,
                Offset +
                    Closureˉlowering.Compilerˉsourceˉclosureˉcatalogˉlength(
                        Closures, Instance
                    ), 0u32, 0u32
            );
        return Expression.Kind ==
                Sourceˉbodies.Compilerˉsourceˉexpressionˉkind.Closure &&
            Expression.Booleanˉvalue;
    }
    if Module >= Scan.Modules || Offset == Compilerˉsourceˉwirˉsentinel() {
        return false;
    }
    let View: Sourceˉset.Compilerˉsourceˉsetˉview =
        Sourceˉset.Compilerˉsourceˉsetˉmodule(Input, Scan, Module);
    let Functionˉdeclaration: Sourceˉdeclarations.Compilerˉsourceˉdeclaration =
        Sourceˉdeclarations.Compilerˉparseˉnextˉdeclarationˉvalidated(
            View.Source, Offset, 1u32, 1u32, true
        );
    return Functionˉdeclaration.Status ==
            Sourceˉdeclarations.Compilerˉparseˉstatus.Valid &&
        (Compilerˉsourceˉwirˉfunctionˉflags(
            View.Source, Functionˉdeclaration
        ) & 1u32) != 0u32;
}

fn Compilerˉsourceˉwirˉtaskˉoriginˉscope(
    Build: Compilerˉsourceˉwirˉbuild,
    Useˉoffset: u32
) -> u32 {
    var Index: u32 = Build.Bindingˉentries;
    while Index > Build.Bindingˉentries - Build.Bindingˉnextˉslot {
        Index = Index - 1u32;
        let Entry: u32 = Index * 36u32;
        let Kind: u32 = Bytesˉreadˉu32ˉlittle(
            Build.Bindingˉpayload, Entry + 8u32
        );
        if Bytesˉreadˉu32ˉlittle(Build.Bindingˉpayload, Entry) ==
                Build.Currentˉmodule &&
            Bytesˉreadˉu32ˉlittle(Build.Bindingˉpayload, Entry + 4u32) ==
                Build.Currentˉfunction &&
            Kind >= 5u32 && Kind <= 7u32 &&
            Useˉoffset >= Bytesˉreadˉu32ˉlittle(
                Build.Bindingˉpayload, Entry + 28u32
            ) &&
            Useˉoffset < Bytesˉreadˉu32ˉlittle(
                Build.Bindingˉpayload, Entry + 32u32
            ) {
            return Bytesˉreadˉu32ˉlittle(
                Build.Bindingˉpayload, Entry + 12u32
            );
        }
    }
    return Compilerˉsourceˉwirˉsentinel();
}

fn Compilerˉsourceˉwirˉcompileˉtaskˉconstruct(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Bindingˉpayload: bytes,
    Bindingˉfirst: u32,
    Bindingˉentries: u32,
    Source: bytes,
    Expression: Sourceˉbodies.Compilerˉsourceˉexpression,
    Expectedˉshape: u32,
    Build: Compilerˉsourceˉwirˉbuild
) -> Compilerˉsourceˉwirˉvalue {
    let Budgetˉargument: Compilerˉsourceˉwirˉtaskˉargument =
        Compilerˉsourceˉwirˉtaskˉargumentˉat(
            Source, Expression, 0u32, "Budget"
        );
    let Limitsˉargument: Compilerˉsourceˉwirˉtaskˉargument =
        Compilerˉsourceˉwirˉtaskˉargumentˉat(
            Source, Expression, 1u32, "Limits"
        );
    let Parentˉargument: Compilerˉsourceˉwirˉtaskˉargument =
        Compilerˉsourceˉwirˉtaskˉargumentˉat(
            Source, Expression, 2u32, "Parentˉcontext"
        );
    let Budget: Sourceˉbindings.Compilerˉsourceˉlocalˉmatch =
        Compilerˉsourceˉwirˉtaskˉlocal(
            Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
            Source, Budgetˉargument
        );
    let Scopeˉshape: u32 =
        Compilerˉsourceˉwirˉfindˉexactˉfoundationˉshape(
            Input, Scan, Symbols,
            "Foundationˉtask", "Taskˉscope", false
        );
    let Limitsˉshape: u32 =
        Compilerˉsourceˉwirˉfindˉexactˉfoundationˉshape(
            Input, Scan, Symbols,
            "Foundationˉtask", "Taskˉlimits", false
        );
    let Failureˉshape: u32 =
        Compilerˉsourceˉwirˉfindˉexactˉfoundationˉshape(
            Input, Scan, Symbols,
            "Foundationˉtask", "Taskˉscopeˉfailure", true
        );
    let Contextˉshape: u32 =
        Compilerˉsourceˉwirˉfindˉexactˉfoundationˉshape(
            Input, Scan, Symbols,
            "Foundationˉoperation", "Operationˉcontext", false
        );
    let Catalog: Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog =
        Compilerˉsourceˉwirˉgenericˉtypeˉcatalog(Build.Genericˉevidence);
    var Resultˉshape: u32 = Expectedˉshape;
    if Resultˉshape == 0u32 ||
        Resultˉshape == Compilerˉsourceˉwirˉsentinel() {
        Resultˉshape = Compilerˉsourceˉwirˉfindˉexactˉgenericˉshape(
            Input, Scan, Symbols, Catalog,
            "Foundationˉresult", "Result", 2u32,
            Scopeˉshape, Failureˉshape
        );
    }
    let Resultˉlayout: Compilerˉsourceˉwirˉmember =
        Compilerˉsourceˉwirˉgenericˉfoundationˉresultˉlayout(
            Input, Scan, Symbols, Catalog, Resultˉshape
        );
    if !Budgetˉargument.Found || !Limitsˉargument.Found ||
        !Parentˉargument.Found ||
        Budgetˉargument.Mode !=
            Sourceˉdeclarations.COMPILER_SOURCE_BORROW_MODE_VALUE ||
        Limitsˉargument.Mode !=
            Sourceˉdeclarations.COMPILER_SOURCE_BORROW_MODE_VALUE ||
        Parentˉargument.Mode !=
            Sourceˉdeclarations.COMPILER_SOURCE_BORROW_MODE_IMMUTABLE {
        return Compilerˉsourceˉwirˉfailureˉvalue(
            Build, Compilerˉsourceˉwirˉstatus.Invalidˉargument,
            Build.Currentˉmodule,
            Expression.Offset, Expression.Line, Expression.Column
        );
    }
    if !Budget.Found || Budget.Shape != 805306368u32 {
        return Compilerˉsourceˉwirˉfailureˉvalue(
            Build, Compilerˉsourceˉwirˉstatus.Invalidˉdataˉuse,
            Build.Currentˉmodule,
            Expression.Offset, Expression.Line, Expression.Column
        );
    }
    if
        Scopeˉshape == Compilerˉsourceˉwirˉsentinel() ||
        Limitsˉshape == Compilerˉsourceˉwirˉsentinel() ||
        Failureˉshape == Compilerˉsourceˉwirˉsentinel() ||
        Contextˉshape == Compilerˉsourceˉwirˉsentinel() {
        return Compilerˉsourceˉwirˉtaskˉfailure(Build, Expression);
    }
    if
        Resultˉshape == Compilerˉsourceˉwirˉsentinel() ||
        !Resultˉlayout.Found || Resultˉlayout.Index != Scopeˉshape ||
        Resultˉlayout.Shape != Failureˉshape {
        return Compilerˉsourceˉwirˉfailureˉvalue(
            Build, Compilerˉsourceˉwirˉstatus.Genericˉresolution,
            Build.Currentˉmodule,
            Expression.Offset, Expression.Line, Expression.Column
        );
    }
    let Limits: Compilerˉsourceˉwirˉvalue =
        Compilerˉsourceˉwirˉcompileˉcontextualˉexpression(
            Input, Scan, Symbols,
            Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
            Source,
            Limitsˉargument.Valueˉoffset,
            Limitsˉargument.Valueˉline, Limitsˉargument.Valueˉcolumn,
            Limitsˉargument.Valueˉoffset + Limitsˉargument.Valueˉlength,
            Limitsˉshape, Build
        );
    if Limits.Status != Compilerˉsourceˉwirˉstatus.Valid ||
        Limits.Shape != Limitsˉshape {
        return Limits;
    }
    let Parent: Compilerˉsourceˉwirˉvalue =
        Compilerˉsourceˉwirˉcompileˉcontextualˉexpression(
            Input, Scan, Symbols,
            Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
            Source,
            Parentˉargument.Valueˉoffset,
            Parentˉargument.Valueˉline, Parentˉargument.Valueˉcolumn,
            Parentˉargument.Valueˉoffset + Parentˉargument.Valueˉlength,
            Contextˉshape, Compilerˉsourceˉwirˉvalueˉbuild(Limits)
        );
    if Parent.Status != Compilerˉsourceˉwirˉstatus.Valid ||
        Parent.Shape != Contextˉshape {
        return Parent;
    }
    let Operands: bytes = Bytesˉconcat(
        Compilerˉsourceˉwirˉoneˉoperand(Limits.Temporary),
        Compilerˉsourceˉwirˉoneˉoperand(Parent.Temporary)
    );
    return Compilerˉsourceˉwirˉemit(
        Compilerˉsourceˉwirˉvalueˉbuild(Parent),
        WIR_OPERATION_TASK_SCOPE_CONSTRUCT, Resultˉshape,
        Operands, Budget.Slot, Scopeˉshape,
        Expression.Offset, Expression.Length
    );
}

fn Compilerˉsourceˉwirˉcompileˉtaskˉoperationˉcontext(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Bindingˉpayload: bytes,
    Bindingˉfirst: u32,
    Bindingˉentries: u32,
    Source: bytes,
    Expression: Sourceˉbodies.Compilerˉsourceˉexpression,
    Expectedˉshape: u32,
    Build: Compilerˉsourceˉwirˉbuild
) -> Compilerˉsourceˉwirˉvalue {
    let Argument: Compilerˉsourceˉwirˉtaskˉargument =
        Compilerˉsourceˉwirˉtaskˉargumentˉat(
            Source, Expression, 0u32, "Scope"
        );
    let Scope: Sourceˉbindings.Compilerˉsourceˉlocalˉmatch =
        Compilerˉsourceˉwirˉtaskˉscopeˉlocal(
            Input, Scan, Symbols,
            Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
            Source, Argument,
            Sourceˉdeclarations.COMPILER_SOURCE_BORROW_MODE_IMMUTABLE
        );
    let Resultˉshape: u32 =
        Compilerˉsourceˉwirˉfindˉexactˉfoundationˉshape(
            Input, Scan, Symbols,
            "Foundationˉoperation", "Operationˉcontext", false
        );
    if !Scope.Found || Resultˉshape == Compilerˉsourceˉwirˉsentinel() ||
        (Expectedˉshape != 0u32 &&
         Expectedˉshape != Compilerˉsourceˉwirˉsentinel() &&
         Expectedˉshape != Resultˉshape) {
        return Compilerˉsourceˉwirˉtaskˉfailure(Build, Expression);
    }
    return Compilerˉsourceˉwirˉemit(
        Build, WIR_OPERATION_TASK_OPERATION_CONTEXT, Resultˉshape,
        Compilerˉsourceˉwirˉempty(Source), Scope.Slot, 0u32,
        Expression.Offset, Expression.Length
    );
}

fn Compilerˉsourceˉwirˉcompileˉtaskˉrequestˉcancel(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Bindingˉpayload: bytes,
    Bindingˉfirst: u32,
    Bindingˉentries: u32,
    Source: bytes,
    Expression: Sourceˉbodies.Compilerˉsourceˉexpression,
    Expectedˉshape: u32,
    Build: Compilerˉsourceˉwirˉbuild
) -> Compilerˉsourceˉwirˉvalue {
    let Argument: Compilerˉsourceˉwirˉtaskˉargument =
        Compilerˉsourceˉwirˉtaskˉargumentˉat(
            Source, Expression, 0u32, "Scope"
        );
    let Scope: Sourceˉbindings.Compilerˉsourceˉlocalˉmatch =
        Compilerˉsourceˉwirˉtaskˉscopeˉlocal(
            Input, Scan, Symbols,
            Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
            Source, Argument,
            Sourceˉdeclarations.COMPILER_SOURCE_BORROW_MODE_MUTABLE
        );
    let Resultˉshape: u32 =
        Compilerˉsourceˉwirˉfindˉexactˉfoundationˉshape(
            Input, Scan, Symbols,
            "Foundationˉtask", "Cancelˉrequestˉoutcome", true
        );
    if !Scope.Found || Resultˉshape == Compilerˉsourceˉwirˉsentinel() ||
        (Expectedˉshape != 0u32 &&
         Expectedˉshape != Compilerˉsourceˉwirˉsentinel() &&
         Expectedˉshape != Resultˉshape) {
        return Compilerˉsourceˉwirˉtaskˉfailure(Build, Expression);
    }
    return Compilerˉsourceˉwirˉemit(
        Build, WIR_OPERATION_TASK_REQUEST_CANCEL, Resultˉshape,
        Compilerˉsourceˉwirˉempty(Source), Scope.Slot, 0u32,
        Expression.Offset, Expression.Length
    );
}

fn Compilerˉsourceˉwirˉcompileˉtaskˉspawn(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Bindingˉpayload: bytes,
    Bindingˉfirst: u32,
    Bindingˉentries: u32,
    Source: bytes,
    Expression: Sourceˉbodies.Compilerˉsourceˉexpression,
    Expectedˉshape: u32,
    Build: Compilerˉsourceˉwirˉbuild
) -> Compilerˉsourceˉwirˉvalue {
    let Scopeˉargument: Compilerˉsourceˉwirˉtaskˉargument =
        Compilerˉsourceˉwirˉtaskˉargumentˉat(
            Source, Expression, 0u32, "Scope"
        );
    let Workˉargument: Compilerˉsourceˉwirˉtaskˉargument =
        Compilerˉsourceˉwirˉtaskˉargumentˉat(
            Source, Expression, 1u32, "Work"
        );
    let Scope: Sourceˉbindings.Compilerˉsourceˉlocalˉmatch =
        Compilerˉsourceˉwirˉtaskˉscopeˉlocal(
            Input, Scan, Symbols,
            Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
            Source, Scopeˉargument,
            Sourceˉdeclarations.COMPILER_SOURCE_BORROW_MODE_MUTABLE
        );
    let Workˉlocal: Sourceˉbindings.Compilerˉsourceˉlocalˉmatch =
        Compilerˉsourceˉwirˉtaskˉlocal(
            Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
            Source, Workˉargument
        );
    if !Scope.Found || !Workˉargument.Found ||
        Workˉargument.Mode !=
            Sourceˉdeclarations.COMPILER_SOURCE_BORROW_MODE_VALUE ||
        !Workˉlocal.Found ||
        !Compilerˉsourceˉwirˉfunctionˉtypeˉshapeˉisˉprivate(
            Workˉlocal.Shape
        ) {
        return Compilerˉsourceˉwirˉtaskˉfailure(Build, Expression);
    }
    let Work: Compilerˉsourceˉwirˉvalue =
        Compilerˉsourceˉwirˉcompileˉcontextualˉexpression(
            Input, Scan, Symbols,
            Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
            Source,
            Workˉargument.Valueˉoffset,
            Workˉargument.Valueˉline, Workˉargument.Valueˉcolumn,
            Workˉargument.Valueˉoffset + Workˉargument.Valueˉlength,
            Workˉlocal.Shape, Build
        );
    if Work.Status != Compilerˉsourceˉwirˉstatus.Valid ||
        Work.Shape != Workˉlocal.Shape {
        return Compilerˉsourceˉwirˉtaskˉfailure(
            Compilerˉsourceˉwirˉvalueˉbuild(Work), Expression
        );
    }
    let Functionˉcatalog: Compilerˉsourceˉwirˉfunctionˉtypeˉcatalog =
        Compilerˉsourceˉwirˉfunctionˉtypeˉcatalogˉfromˉgeneric(
            Work.Genericˉevidence
        );
    let Functionˉinstance: u32 =
        Compilerˉsourceˉwirˉfunctionˉtypeˉshapeˉinstance(Work.Shape);
    if !Compilerˉsourceˉwirˉfunctionˉtypeˉcatalogˉisˉvalid(
            Functionˉcatalog
        ) ||
        Functionˉinstance >=
            Compilerˉsourceˉwirˉfunctionˉtypeˉcatalogˉinstances(
                Functionˉcatalog
            ) ||
        (Compilerˉsourceˉwirˉfunctionˉtypeˉflags(
            Functionˉcatalog, Functionˉinstance
        ) & 1u32) == 0u32 ||
        Compilerˉsourceˉwirˉfunctionˉtypeˉparameters(
            Functionˉcatalog, Functionˉinstance
        ) != 0u32 {
        return Compilerˉsourceˉwirˉtaskˉfailure(
            Compilerˉsourceˉwirˉvalueˉbuild(Work), Expression
        );
    }
    let Catalog: Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog =
        Compilerˉsourceˉwirˉgenericˉtypeˉcatalog(Work.Genericˉevidence);
    let Workˉresultˉshape: u32 =
        Compilerˉsourceˉwirˉfunctionˉtypeˉresultˉshape(
            Functionˉcatalog, Functionˉinstance
        );
    let Workˉresult: Compilerˉsourceˉwirˉmember =
        Compilerˉsourceˉwirˉgenericˉfoundationˉresultˉlayout(
            Input, Scan, Symbols, Catalog, Workˉresultˉshape
        );
    if !Workˉresult.Found {
        return Compilerˉsourceˉwirˉtaskˉfailure(
            Compilerˉsourceˉwirˉvalueˉbuild(Work), Expression
        );
    }
    var Taskˉshape: u32 = Compilerˉsourceˉwirˉsentinel();
    var Failureˉshape: u32 = Compilerˉsourceˉwirˉsentinel();
    var Resultˉshape: u32 = Expectedˉshape;
    var Resultˉlayout: Compilerˉsourceˉwirˉmember =
        Compilerˉsourceˉwirˉresultˉlayoutˉmissing();
    if Resultˉshape != 0u32 &&
        Resultˉshape != Compilerˉsourceˉwirˉsentinel() {
        Resultˉlayout =
            Compilerˉsourceˉwirˉgenericˉfoundationˉresultˉlayout(
                Input, Scan, Symbols, Catalog, Resultˉshape
            );
        if Resultˉlayout.Found {
            Taskˉshape = Resultˉlayout.Index;
            Failureˉshape = Resultˉlayout.Shape;
        }
    } else {
        Taskˉshape = Compilerˉsourceˉwirˉfindˉexactˉgenericˉshape(
            Input, Scan, Symbols, Catalog,
            "Foundationˉtask", "Task", 2u32,
            Workˉresult.Index, Workˉresult.Shape
        );
        Failureˉshape = Compilerˉsourceˉwirˉfindˉexactˉgenericˉshape(
            Input, Scan, Symbols, Catalog,
            "Foundationˉtask", "Spawnˉfailure", 1u32,
            Work.Shape, 0u32
        );
        Resultˉshape = Compilerˉsourceˉwirˉfindˉexactˉgenericˉshape(
            Input, Scan, Symbols, Catalog,
            "Foundationˉresult", "Result", 2u32,
            Taskˉshape, Failureˉshape
        );
        Resultˉlayout =
            Compilerˉsourceˉwirˉgenericˉfoundationˉresultˉlayout(
                Input, Scan, Symbols, Catalog, Resultˉshape
            );
    }
    if !Resultˉlayout.Found ||
        !Compilerˉsourceˉwirˉgenericˉshapeˉisˉexact(
            Input, Scan, Symbols, Catalog, Taskˉshape,
            "Foundationˉtask", "Task", 2u32,
            Workˉresult.Index, Workˉresult.Shape
        ) ||
        !Compilerˉsourceˉwirˉgenericˉshapeˉisˉexact(
            Input, Scan, Symbols, Catalog, Failureˉshape,
            "Foundationˉtask", "Spawnˉfailure", 1u32,
            Work.Shape, 0u32
        ) {
        return Compilerˉsourceˉwirˉtaskˉfailure(
            Compilerˉsourceˉwirˉvalueˉbuild(Work), Expression
        );
    }
    return Compilerˉsourceˉwirˉemit(
        Compilerˉsourceˉwirˉvalueˉbuild(Work),
        WIR_OPERATION_TASK_SPAWN, Resultˉshape,
        Compilerˉsourceˉwirˉoneˉoperand(Work.Temporary),
        Scope.Slot, Taskˉshape,
        Expression.Offset, Expression.Length
    );
}

fn Compilerˉsourceˉwirˉcompileˉtaskˉawait(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Bindingˉpayload: bytes,
    Bindingˉfirst: u32,
    Bindingˉentries: u32,
    Source: bytes,
    Expression: Sourceˉbodies.Compilerˉsourceˉexpression,
    Expectedˉshape: u32,
    Awaited: bool,
    Build: Compilerˉsourceˉwirˉbuild
) -> Compilerˉsourceˉwirˉvalue {
    let Argument: Compilerˉsourceˉwirˉtaskˉargument =
        Compilerˉsourceˉwirˉtaskˉargumentˉat(
            Source, Expression, 0u32, "Handle"
        );
    let Handle: Sourceˉbindings.Compilerˉsourceˉlocalˉmatch =
        Compilerˉsourceˉwirˉtaskˉlocal(
            Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
            Source, Argument
        );
    let Catalog: Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog =
        Compilerˉsourceˉwirˉgenericˉtypeˉcatalog(Build.Genericˉevidence);
    let Firstˉshape: u32 =
        Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalogˉshapeˉtypeˉargument(
            Catalog, Handle.Shape, 0u32
        );
    let Secondˉshape: u32 =
        Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalogˉshapeˉtypeˉargument(
            Catalog, Handle.Shape, 1u32
        );
    var Resultˉshape: u32 = Expectedˉshape;
    if Resultˉshape == 0u32 ||
        Resultˉshape == Compilerˉsourceˉwirˉsentinel() {
        Resultˉshape = Compilerˉsourceˉwirˉfindˉexactˉgenericˉshape(
            Input, Scan, Symbols, Catalog,
            "Foundationˉtask", "Taskˉoutcome", 2u32,
            Firstˉshape, Secondˉshape
        );
    }
    let Originˉscope: u32 =
        Compilerˉsourceˉwirˉtaskˉoriginˉscope(Build, Expression.Offset);
    if !Awaited || !Argument.Found ||
        Argument.Mode !=
            Sourceˉdeclarations.COMPILER_SOURCE_BORROW_MODE_VALUE ||
        !Handle.Found ||
        !Compilerˉsourceˉwirˉgenericˉshapeˉisˉexact(
            Input, Scan, Symbols, Catalog, Handle.Shape,
            "Foundationˉtask", "Task", 2u32,
            Firstˉshape, Secondˉshape
        ) ||
        !Compilerˉsourceˉwirˉgenericˉshapeˉisˉexact(
            Input, Scan, Symbols, Catalog, Resultˉshape,
            "Foundationˉtask", "Taskˉoutcome", 2u32,
            Firstˉshape, Secondˉshape
        ) ||
        Originˉscope == Compilerˉsourceˉwirˉsentinel() ||
        !Compilerˉsourceˉwirˉcurrentˉfunctionˉisˉasync(
            Input, Scan, Symbols, Build
        ) {
        return Compilerˉsourceˉwirˉtaskˉfailure(Build, Expression);
    }
    return Compilerˉsourceˉwirˉemit(
        Build, WIR_OPERATION_TASK_AWAIT, Resultˉshape,
        Compilerˉsourceˉwirˉempty(Source), Handle.Slot, Originˉscope,
        Expression.Offset, Expression.Length
    );
}

export fn Compilerˉsourceˉwirˉcompileˉcall(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Bindingˉpayload: bytes,
    Bindingˉfirst: u32,
    Bindingˉentries: u32,
    Source: bytes,
    Expression: Sourceˉbodies.Compilerˉsourceˉexpression,
    Expectedˉshape: u32,
    Awaited: bool,
    Build: Compilerˉsourceˉwirˉbuild
) -> Compilerˉsourceˉwirˉvalue {
    let Indirectˉlocal:
        Sourceˉbindings.Compilerˉsourceˉlocalˉmatch =
        Sourceˉbindings.Compilerˉsourceˉbindingsˉfindˉlocal(
            Source, Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
            Expression.Valueˉoffset, Expression.Valueˉlength,
            Expression.Offset
        );
    if Indirectˉlocal.Found &&
        Compilerˉsourceˉwirˉfunctionˉtypeˉshapeˉisˉprivate(
            Indirectˉlocal.Shape
        ) {
        return Compilerˉsourceˉwirˉcompileˉindirectˉcall(
            Input, Scan, Symbols,
            Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
            Source, Expression, Indirectˉlocal, Awaited, Build
        );
    }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(
        Source, Expression.Valueˉoffset, Expression.Valueˉlength, "length"
    ) {
        if Expression.Items != 1u32 {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Build, Compilerˉsourceˉwirˉstatus.Invalidˉargument,
                Build.Currentˉmodule,
                Expression.Offset, Expression.Line, Expression.Column
            );
        }
        let Lengthˉposition: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
            Source, Expression.Offset, Expression.Line, Expression.Column,
            Expression.Itemsˉoffset
        );
        let Lengthˉargument: Sourceˉbodies.Compilerˉsourceˉexpression = Sourceˉbodies.Compilerˉparseˉexpressionˉvalidated(
            Source,
            Expression.Itemsˉoffset,
            Lengthˉposition.Line,
            Lengthˉposition.Column,
            Expression.Itemsˉoffset + Expression.Itemsˉlength,
            0u32,
            0u32
        );
        if Lengthˉargument.Kind == Sourceˉbodies.Compilerˉsourceˉexpressionˉkind.Name {
            let Collectionˉlengthˉlocal: Sourceˉbindings.Compilerˉsourceˉlocalˉmatch = Sourceˉbindings.Compilerˉsourceˉbindingsˉfindˉlocal(
                Source, Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
                Lengthˉargument.Valueˉoffset, Lengthˉargument.Valueˉlength,
                Lengthˉargument.Offset
            );
            if Collectionˉlengthˉlocal.Found {
                if !Compilerˉsourceˉwirˉshapeˉisˉsequence(Collectionˉlengthˉlocal.Shape) {
                    return Compilerˉsourceˉwirˉfailureˉvalue(
                        Build, Compilerˉsourceˉwirˉstatus.Invalidˉcollection,
                        Build.Currentˉmodule,
                        Lengthˉargument.Offset, Lengthˉargument.Line, Lengthˉargument.Column
                    );
                }
                let Collectionˉlengthˉvalue: Compilerˉsourceˉwirˉvalue = Compilerˉsourceˉwirˉcompileˉname(
                    Input, Scan, Symbols, Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
                    Source, Lengthˉargument, Build
                );
                return Compilerˉsourceˉwirˉemit(
                    Compilerˉsourceˉwirˉvalueˉbuild(Collectionˉlengthˉvalue),
                    WIR_OPERATION_SEQUENCE_LENGTH,
                    3u32,
                    Compilerˉsourceˉwirˉoneˉoperand(Collectionˉlengthˉvalue.Temporary),
                    0u32, 0u32, Expression.Offset, Expression.Length
                );
            }
        }
        if Lengthˉargument.Kind != Sourceˉbodies.Compilerˉsourceˉexpressionˉkind.Name {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Build, Compilerˉsourceˉwirˉstatus.Invalidˉdataˉuse,
                Build.Currentˉmodule,
                Expression.Offset, Expression.Line, Expression.Column
            );
        }
        let Data: Sourceˉbindings.Compilerˉsourceˉbindingˉmatch = Sourceˉbindings.Compilerˉsourceˉbindingsˉfindˉdeclaration(
            Input, Scan, Symbols, Build.Currentˉmodule, Source,
            Lengthˉargument.Valueˉoffset, Lengthˉargument.Valueˉlength,
            Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Data
        );
        if !Data.Found || !Data.Accessible {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Build, Compilerˉsourceˉwirˉstatus.Invalidˉdataˉuse,
                Data.Module,
                Lengthˉargument.Offset, Lengthˉargument.Line, Lengthˉargument.Column
            );
        }
        if Compilerˉsourceˉwirˉdataˉkind(Input, Scan, Symbols, Data) != Compilerˉsourceˉwirˉdataˉkind.I32ˉarray {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Build, Compilerˉsourceˉwirˉstatus.Invalidˉdataˉuse,
                Data.Module,
                Lengthˉargument.Offset, Lengthˉargument.Line, Lengthˉargument.Column
            );
        }
        return Compilerˉsourceˉwirˉemit(
            Build, WIR_OPERATION_DATA_LENGTH, 1u32,
            Compilerˉsourceˉwirˉempty(Source),
            Data.Directoryˉentry, 0u32,
            Expression.Offset, Expression.Length
        );
    }
    var Callable: Sourceˉbindings.Compilerˉsourceˉbindingˉmatch = Sourceˉbindings.Compilerˉsourceˉbindingsˉfindˉcallable(
        Input, Scan, Symbols, Build.Currentˉmodule, Source,
        Expression.Valueˉoffset, Expression.Valueˉlength
    );
    let Capabilityˉlocal: Sourceˉbindings.Compilerˉsourceˉbindingˉmatch = Sourceˉbindings.Compilerˉsourceˉbindingsˉfindˉlocalˉcapability(
        Input, Scan, Symbols, Bindingˉpayload, Bindingˉfirst, Bindingˉentries, Source,
        Expression.Valueˉoffset, Expression.Valueˉlength, Expression.Offset
    );
    if Capabilityˉlocal.Found {
        Callable = Capabilityˉlocal;
    }
    if !Callable.Found || !Callable.Accessible {
        return Compilerˉsourceˉwirˉfailureˉvalue(
            Build, Compilerˉsourceˉwirˉstatus.Invalidˉargument,
            Callable.Module, Expression.Offset, Expression.Line, Expression.Column
        );
    }
    if Callable.Items != Expression.Items {
        return Compilerˉsourceˉwirˉfailureˉvalue(
            Build, Compilerˉsourceˉwirˉstatus.Invalidˉargument,
            Callable.Module, Expression.Offset, Expression.Line, Expression.Column
        );
    }
    if Compilerˉsourceˉwirˉcallableˉisˉunsafe(
            Input, Scan, Symbols, Callable
        ) && Build.Unsafeˉdepth == 0u32 {
        return Compilerˉsourceˉwirˉfailureˉvalue(
            Build, Compilerˉsourceˉwirˉstatus.Unsafeˉcontextˉrequired,
            Callable.Module,
            Expression.Offset, Expression.Line, Expression.Column
        );
    }
    if Callable.Kind ==
            Sourceˉbindings.Compilerˉsourceˉcallableˉkind.Intrinsic &&
        Callable.Directoryˉentry ==
            WIR_OPERATION_FOUNDATION_UNSAFE_CONSTRUCT_SCRATCH {
        return Compilerˉsourceˉwirˉcompileˉfoundationˉunsafeˉconstructˉscratch(
            Input, Scan, Symbols,
            Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
            Source, Expression, Callable, Expectedˉshape, Build
        );
    }
    if Callable.Kind ==
            Sourceˉbindings.Compilerˉsourceˉcallableˉkind.Intrinsic &&
        Callable.Directoryˉentry ==
            WIR_OPERATION_FOUNDATION_UNSAFE_SCRATCH_LENGTH {
        return Compilerˉsourceˉwirˉcompileˉfoundationˉunsafeˉscratchˉlength(
            Input, Scan, Symbols,
            Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
            Source, Expression, Callable, Expectedˉshape, Build
        );
    }
    if Callable.Kind ==
            Sourceˉbindings.Compilerˉsourceˉcallableˉkind.Intrinsic &&
        Callable.Directoryˉentry ==
            WIR_OPERATION_FOUNDATION_UNSAFE_BORROW_WRITE_REGION {
        return Compilerˉsourceˉwirˉcompileˉfoundationˉunsafeˉborrowˉwriteˉregion(
            Input, Scan, Symbols,
            Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
            Source, Expression, Callable, Expectedˉshape, Build
        );
    }
    if Callable.Kind ==
            Sourceˉbindings.Compilerˉsourceˉcallableˉkind.Intrinsic &&
        Callable.Directoryˉentry ==
            WIR_OPERATION_FOUNDATION_UNSAFE_WRITE_POINTER {
        return Compilerˉsourceˉwirˉcompileˉfoundationˉunsafeˉwriteˉpointer(
            Input, Scan, Symbols,
            Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
            Source, Expression, Callable, Expectedˉshape, Build
        );
    }
    if Callable.Kind ==
            Sourceˉbindings.Compilerˉsourceˉcallableˉkind.Intrinsic &&
        Callable.Directoryˉentry >= WIR_OPERATION_TASK_SCOPE_CONSTRUCT &&
        Callable.Directoryˉentry <= WIR_OPERATION_TASK_REQUEST_CANCEL {
        if Expression.Kind ==
                Sourceˉbodies.Compilerˉsourceˉexpressionˉkind.Explicitˉgenericˉcall {
            return Compilerˉsourceˉwirˉtaskˉfailure(Build, Expression);
        }
        if Callable.Directoryˉentry == WIR_OPERATION_TASK_SCOPE_CONSTRUCT {
            if Awaited {
                return Compilerˉsourceˉwirˉtaskˉfailure(Build, Expression);
            }
            return Compilerˉsourceˉwirˉcompileˉtaskˉconstruct(
                Input, Scan, Symbols,
                Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
                Source, Expression, Expectedˉshape, Build
            );
        }
        if Callable.Directoryˉentry == WIR_OPERATION_TASK_OPERATION_CONTEXT {
            if Awaited {
                return Compilerˉsourceˉwirˉtaskˉfailure(Build, Expression);
            }
            return Compilerˉsourceˉwirˉcompileˉtaskˉoperationˉcontext(
                Input, Scan, Symbols,
                Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
                Source, Expression, Expectedˉshape, Build
            );
        }
        if Callable.Directoryˉentry == WIR_OPERATION_TASK_SPAWN {
            if Awaited {
                return Compilerˉsourceˉwirˉtaskˉfailure(Build, Expression);
            }
            return Compilerˉsourceˉwirˉcompileˉtaskˉspawn(
                Input, Scan, Symbols,
                Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
                Source, Expression, Expectedˉshape, Build
            );
        }
        if Callable.Directoryˉentry == WIR_OPERATION_TASK_AWAIT {
            return Compilerˉsourceˉwirˉcompileˉtaskˉawait(
                Input, Scan, Symbols,
                Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
                Source, Expression, Expectedˉshape, Awaited, Build
            );
        }
        if Awaited {
            return Compilerˉsourceˉwirˉtaskˉfailure(Build, Expression);
        }
        return Compilerˉsourceˉwirˉcompileˉtaskˉrequestˉcancel(
            Input, Scan, Symbols,
            Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
            Source, Expression, Expectedˉshape, Build
        );
    }
    let Callableˉisˉasync: bool =
        Compilerˉsourceˉwirˉcallableˉisˉasync(Callable);
    if Awaited != Callableˉisˉasync ||
