        Sourceˉbindings.Compilerˉsourceˉbindingˉstatus.Valid,
        Bindings.Modules,
        Build.Functionˉentries,
        Build.Blocks,
        Build.Operations,
        Build.Temporaries,
        Build.Operands,
        Directory,
        Bindings.Modules,
        Bindings.Modules,
        Build.Functionˉentries,
        Bytesˉlength(Input),
        0u32,
        0u32
    );
}

