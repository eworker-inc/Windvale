fn Compilerˉsourceˉwirˉwithˉdiscoveryˉevidence(
    Build: Compilerˉsourceˉwirˉbuild,
    Discovered: Compilerˉsourceˉwirˉbuild
) -> Compilerˉsourceˉwirˉbuild {
    return Compilerˉsourceˉwirˉwithˉanalysisˉstate(
        Build,
        Build.Status,
        Build.Currentˉblock,
        Build.Currentˉblockˉfirstˉoperation,
        Build.Hasˉcurrentˉblock,
        Build.Bindingˉpayload,
        Build.Bindingˉentries,
        Build.Bindingˉparameters,
        Build.Bindingˉlocals,
        Build.Bindingˉnextˉslot,
        Discovered.Genericˉevidence,
        Build.Genericˉinstance,
        Discovered.Closureˉevidence,
        Build.Unsafeˉdepth,
        Build.Failureˉmodule,
        Build.Failureˉrelatedˉmodule,
        Build.Failureˉfunction,
        Build.Failureˉoffset,
        Build.Failureˉline,
        Build.Failureˉcolumn
    );
}

fn Compilerˉsourceˉwirˉwithˉclosureˉevidence(
    Build: Compilerˉsourceˉwirˉbuild,
    Evidence: bytes
) -> Compilerˉsourceˉwirˉbuild {
    return Compilerˉsourceˉwirˉwithˉanalysisˉstate(
        Build, Build.Status,
        Build.Currentˉblock, Build.Currentˉblockˉfirstˉoperation,
        Build.Hasˉcurrentˉblock,
        Build.Bindingˉpayload, Build.Bindingˉentries,
        Build.Bindingˉparameters, Build.Bindingˉlocals,
        Build.Bindingˉnextˉslot,
        Build.Genericˉevidence, Build.Genericˉinstance, Evidence,
        Build.Unsafeˉdepth,
        Build.Failureˉmodule, Build.Failureˉrelatedˉmodule,
        Build.Failureˉfunction, Build.Failureˉoffset,
        Build.Failureˉline, Build.Failureˉcolumn
    );
}

export fn Compilerˉsourceˉwirˉsentinel() -> u32 {
    return 4294967295u32;
}

fn Compilerˉsourceˉwirˉbindingˉfailureˉrelated(
    Status: Sourceˉbindings.Compilerˉsourceˉbindingˉstatus,
    Relatedˉmodule: u32
) -> u32 {
    var Code: u32 = 5u32;
    if Status == Sourceˉbindings.Compilerˉsourceˉbindingˉstatus.Sourceˉsymbols {
        Code = 1u32;
    }
    if Status == Sourceˉbindings.Compilerˉsourceˉbindingˉstatus.Bindingˉlimit {
        Code = 2u32;
    }
    if Status == Sourceˉbindings.Compilerˉsourceˉbindingˉstatus.Evidenceˉlimit {
        Code = 3u32;
    }
    if Status == Sourceˉbindings.Compilerˉsourceˉbindingˉstatus.Duplicateˉlocal {
        Code = 4u32;
    }
    if Status == Sourceˉbindings.Compilerˉsourceˉbindingˉstatus.Inaccessibleˉtype {
        Code = 6u32;
    }
    if Status == Sourceˉbindings.Compilerˉsourceˉbindingˉstatus.Invalidˉdirectory {
        Code = 7u32;
    }
    if Status == Sourceˉbindings.Compilerˉsourceˉbindingˉstatus.Unknownˉname {
        Code = 8u32;
    }
    if Status == Sourceˉbindings.Compilerˉsourceˉbindingˉstatus.Inaccessibleˉname {
        Code = 9u32;
    }
    if Status == Sourceˉbindings.Compilerˉsourceˉbindingˉstatus.Unknownˉassignment {
        Code = 10u32;
    }
    if Status == Sourceˉbindings.Compilerˉsourceˉbindingˉstatus.Immutableˉassignment {
        Code = 11u32;
    }
    if Status == Sourceˉbindings.Compilerˉsourceˉbindingˉstatus.Inaccessibleˉcall {
        Code = 12u32;
    }
    if Status == Sourceˉbindings.Compilerˉsourceˉbindingˉstatus.Undeclaredˉcapability {
        Code = 13u32;
    }
    if Status == Sourceˉbindings.Compilerˉsourceˉbindingˉstatus.Unknownˉcall {
        Code = 14u32;
    }
    if Status == Sourceˉbindings.Compilerˉsourceˉbindingˉstatus.Callˉarity {
        Code = 15u32;
    }
    return Code * 64u32 + Relatedˉmodule;
}

fn Compilerˉsourceˉwirˉbindingˉfailureˉstatus(
    Encoded: u32
) -> Sourceˉbindings.Compilerˉsourceˉbindingˉstatus {
    let Code: u32 = Encoded / 64u32;
    if Code == 1u32 { return Sourceˉbindings.Compilerˉsourceˉbindingˉstatus.Sourceˉsymbols; }
    if Code == 2u32 { return Sourceˉbindings.Compilerˉsourceˉbindingˉstatus.Bindingˉlimit; }
    if Code == 3u32 { return Sourceˉbindings.Compilerˉsourceˉbindingˉstatus.Evidenceˉlimit; }
    if Code == 4u32 { return Sourceˉbindings.Compilerˉsourceˉbindingˉstatus.Duplicateˉlocal; }
    if Code == 6u32 { return Sourceˉbindings.Compilerˉsourceˉbindingˉstatus.Inaccessibleˉtype; }
    if Code == 7u32 { return Sourceˉbindings.Compilerˉsourceˉbindingˉstatus.Invalidˉdirectory; }
    if Code == 8u32 { return Sourceˉbindings.Compilerˉsourceˉbindingˉstatus.Unknownˉname; }
    if Code == 9u32 { return Sourceˉbindings.Compilerˉsourceˉbindingˉstatus.Inaccessibleˉname; }
    if Code == 10u32 { return Sourceˉbindings.Compilerˉsourceˉbindingˉstatus.Unknownˉassignment; }
    if Code == 11u32 { return Sourceˉbindings.Compilerˉsourceˉbindingˉstatus.Immutableˉassignment; }
    if Code == 12u32 { return Sourceˉbindings.Compilerˉsourceˉbindingˉstatus.Inaccessibleˉcall; }
    if Code == 13u32 { return Sourceˉbindings.Compilerˉsourceˉbindingˉstatus.Undeclaredˉcapability; }
    if Code == 14u32 { return Sourceˉbindings.Compilerˉsourceˉbindingˉstatus.Unknownˉcall; }
    if Code == 15u32 { return Sourceˉbindings.Compilerˉsourceˉbindingˉstatus.Callˉarity; }
    return Sourceˉbindings.Compilerˉsourceˉbindingˉstatus.Unknownˉtype;
}

export fn Compilerˉsourceˉwirˉshapeˉisˉsequence(Shape: u32) -> bool {
    if Shape < 1073741824u32 { return false; }
    return Shape < 1342177280u32;
}

export fn Compilerˉsourceˉwirˉshapeˉisˉbuilder(Shape: u32) -> bool {
    if Shape < 1342177280u32 { return false; }
    return Shape < 1610612736u32;
}

fn Compilerˉsourceˉwirˉvalueˉclassify(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Shape: u32,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Typeˉcatalog: Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog
) -> u32 {
    if Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉshapeˉisˉprivate(Shape) {
        if Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉshapeˉinstance(Shape) <
            Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalogˉinstances(
                Typeˉcatalog
            ) {
            if Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalogˉinstanceˉkind(
                Typeˉcatalog,
                Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉshapeˉinstance(Shape)
            ) == 12u32 { return WIR_VALUE_CLASS_SHARED; }
            if Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalogˉinstanceˉkind(
                Typeˉcatalog,
                Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉshapeˉinstance(Shape)
            ) == 11u32 { return WIR_VALUE_CLASS_OWNED; }
            let Resultˉlayout: Compilerˉsourceˉwirˉmember =
                Compilerˉsourceˉwirˉgenericˉfoundationˉresultˉlayout(
                    Input, Scan, Symbols, Typeˉcatalog, Shape
                );
            if Resultˉlayout.Found &&
                Resultˉlayout.Index == 805306368u32 {
                return WIR_VALUE_CLASS_OWNED;
            }
        }
    }
    if Shape == 5u32 || Shape == 6u32 ||
        Compilerˉsourceˉwirˉshapeˉisˉsequence(Shape) {
        return WIR_VALUE_CLASS_SHARED;
    }
    if (Shape >= 1u32 && Shape <= 4u32) ||
        (Shape >= 7u32 && Shape <= 16u32) ||
        (Shape >= 131072u32 + Symbols.Records &&
            Shape < 131072u32 + Symbols.Records + Symbols.Enums) {
        return WIR_VALUE_CLASS_COPY;
    }
    if Compilerˉsourceˉwirˉshapeˉisˉbuilder(Shape) ||
        Sourceˉsymbols.Compilerˉsourceˉsymbolsˉshapeˉisˉcapability(
            Symbols.Directory, Shape
        ) || Shape == 805306368u32 || Shape == 805306369u32 {
        return WIR_VALUE_CLASS_OWNED;
    }
    return WIR_VALUE_CLASS_UNKNOWN;
}

export fn Compilerˉsourceˉwirˉshapeˉisˉfixedˉarray(
    Shape: u32,
    Typeˉcatalog: Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog
) -> bool {
    if !Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉshapeˉisˉprivate(Shape) {
        return false;
    }
    let Instance: u32 =
        Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉshapeˉinstance(Shape);
    if Instance >=
        Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalogˉinstances(
            Typeˉcatalog
        ) {
        return false;
    }
    return Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalogˉinstanceˉkind(
        Typeˉcatalog, Instance
    ) == 10u32;
}

export fn Compilerˉsourceˉwirˉfixedˉarrayˉelementˉshape(
    Shape: u32,
    Typeˉcatalog: Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog
) -> u32 {
    if !Compilerˉsourceˉwirˉshapeˉisˉfixedˉarray(
        Shape, Typeˉcatalog
    ) {
        return 0u32;
    }
    let Instance: u32 =
        Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉshapeˉinstance(Shape);
    let Argument: Sourceˉgenerics.Compilerˉsourceˉgenericˉargument =
        Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalogˉargument(
            Typeˉcatalog, Instance, 0u32
        );
    if !Argument.Valid || Argument.Kind != 1u32 ||
        Argument.Shape != 0u32 || Argument.High != 0u32 {
        return 0u32;
    }
    return Argument.Low;
}

export fn Compilerˉsourceˉwirˉfixedˉarrayˉcount(
    Shape: u32,
    Typeˉcatalog: Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog
) -> u32 {
    if !Compilerˉsourceˉwirˉshapeˉisˉfixedˉarray(
        Shape, Typeˉcatalog
    ) {
        return Compilerˉsourceˉwirˉsentinel();
    }
    let Instance: u32 =
        Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉshapeˉinstance(Shape);
    let Argument: Sourceˉgenerics.Compilerˉsourceˉgenericˉargument =
        Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalogˉargument(
            Typeˉcatalog, Instance, 1u32
        );
    if !Argument.Valid || Argument.Kind != 2u32 ||
        Argument.Shape != 8u32 || Argument.High != 0u32 ||
        Argument.Low > 4095u32 {
        return Compilerˉsourceˉwirˉsentinel();
    }
    return Argument.Low;
}

export fn Compilerˉsourceˉwirˉcollectionˉcompactˉelement(Shape: u32) -> u32 {
    return Bytesˉreadˉu16ˉlittle(Bytesˉfromˉu32ˉlittle(Shape), 0u32);
}

export fn Compilerˉsourceˉwirˉcollectionˉelementˉshape(Shape: u32) -> u32 {
    let Element: u32 = Compilerˉsourceˉwirˉcollectionˉcompactˉelement(Shape);
    if Element < 4096u32 { return Element; }
    if Element < 8192u32 { return 65536u32 + Element - 4096u32; }
    if Element < 12288u32 { return 131072u32 + Element - 8192u32; }
    return 196608u32 + Element - 12288u32;
}

export fn Compilerˉsourceˉwirˉcollectionˉmaximum(Shape: u32) -> u32 {
    let Upper: u32 = Bytesˉreadˉu16ˉlittle(Bytesˉfromˉu32ˉlittle(Shape), 2u32);
    if Compilerˉsourceˉwirˉshapeˉisˉsequence(Shape) { return Upper - 16384u32; }
    return Upper - 20480u32;
}

export fn Compilerˉsourceˉwirˉcollectionˉdescriptor(Shape: u32) -> u32 {
    let Element: u32 = Compilerˉsourceˉwirˉcollectionˉcompactˉelement(Shape);
    if Element < 4096u32 { return Element; }
    if Element < 8192u32 { return 1073741824u32 + Element - 4096u32; }
    if Element < 12288u32 { return 2147483648u32 + Element - 8192u32; }
    return 3221225472u32 + Element - 12288u32;
}

export fn Compilerˉsourceˉwirˉshapeˉisˉfoundationˉsequence(
    Shape: u32,
    Catalog: Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog
) -> bool {
    return Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalogˉshapeˉisˉkind(
        Catalog, Shape, 12u32
    );
}

export fn Compilerˉsourceˉwirˉshapeˉisˉfoundationˉvector(
    Shape: u32,
    Catalog: Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog
) -> bool {
    return Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalogˉshapeˉisˉkind(
