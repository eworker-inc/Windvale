export enum Compilerˉsourceˉwirˉstatus {
    Valid = 0;
    Sourceˉbindings = 1;
    Evidenceˉlimit = 2;
    Invalidˉdirectory = 3;
    Typeˉmismatch = 4;
    Invalidˉcondition = 5;
    Invalidˉreturn = 6;
    Missingˉreturn = 7;
    Unreachableˉstatement = 8;
    Invalidˉdataˉuse = 9;
    Invalidˉindex = 10;
    Invalidˉfieldˉtarget = 11;
    Unknownˉfield = 12;
    Unknownˉenumˉmember = 13;
    Invalidˉoperator = 14;
    Invalidˉargument = 15;
    Invalidˉinference = 16;
    Invalidˉconstant = 17;
    Invalidˉrecordˉliteral = 18;
    Duplicateˉrecordˉfield = 19;
    Missingˉrecordˉfield = 20;
    Invalidˉbreak = 21;
    Invalidˉcontinue = 22;
    Invalidˉmatch = 23;
    Matchˉenumˉmismatch = 24;
    Duplicateˉmatchˉcase = 25;
    Missingˉmatchˉcase = 26;
    Unknownˉvariantˉcase = 27;
    Matchˉvariantˉmismatch = 28;
    Invalidˉvariantˉbinding = 29;
    Invalidˉcollection = 30;
    Invalidˉbuilder = 31;
    Invalidˉtry = 32;
    Invalidˉunit = 33;
    Invalidˉrecordˉupdate = 34;
    Invalidˉvariantˉliteral = 35;
    Duplicateˉvariantˉfield = 36;
    Missingˉvariantˉfield = 37;
    Invalidˉvalueˉblock = 38;
    Genericˉresolution = 39;
    Genericˉspecialization = 40;
    Genericˉiterationˉlimit = 41;
}


