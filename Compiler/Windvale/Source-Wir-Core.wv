module Compilerˉsourceˉwir profile portable;

import Compilerˉsourceˉbindings;

enum Compilerˉsourceˉwirˉstatus {
    Valid = 0;
    Sourceˉbindings = 1;
    Evidenceˉlimit = 2;
    Invalidˉdirectory = 3;
    Typeˉmismatch = 4;
    Invalidˉcondition = 5;
    Invalidˉreturn = 6;
    Missingˉreturn = 7;
    Unreachableˉstatement = 8;
    Invalidˉdataˉuse = 9;
    Invalidˉindex = 10;
    Invalidˉfieldˉtarget = 11;
    Unknownˉfield = 12;
    Unknownˉenumˉmember = 13;
    Invalidˉoperator = 14;
    Invalidˉargument = 15;
}

enum Compilerˉsourceˉwirˉoperation {
    None = 0;
    I32ˉconstant = 1;
    U8ˉconstant = 2;
    U32ˉconstant = 3;
    Boolˉconstant = 4;
    Textˉconstant = 5;
    Bytesˉconstant = 6;
    Loadˉlocal = 7;
    Storeˉlocal = 8;
    Dataˉlength = 9;
    Dataˉloadˉi32 = 10;
    Bytesˉlength = 11;
    Bytesˉslice = 12;
    Bytesˉreadˉu8 = 13;
    Bytesˉreadˉu16ˉlittle = 14;
    Bytesˉreadˉu32ˉlittle = 15;
    Bytesˉreadˉi32ˉlittle = 16;
    Recordˉcreate = 17;
    Recordˉfield = 18;
    Enumˉconstant = 19;
    Enumˉequal = 20;
    Enumˉnotˉequal = 21;
    Enumˉname = 22;
    I32ˉformat = 23;
    U8ˉformat = 24;
    U32ˉformat = 25;
    U32ˉfromˉu8 = 26;
    Textˉconcat = 27;
    Textˉutf8ˉisˉvalid = 28;
    Textˉfromˉutf8 = 29;
    Textˉquote = 30;
    Bytesˉconcat = 31;
    Bytesˉfromˉu8 = 32;
    Bytesˉfromˉu16ˉlittle = 33;
    Bytesˉfromˉu32ˉlittle = 34;
    Bytesˉfromˉi32ˉlittle = 35;
    Bytesˉsha256ˉhex = 36;
    Textˉtoˉutf8 = 37;
    I32ˉadd = 38;
    I32ˉsubtract = 39;
    I32ˉmultiply = 40;
    I32ˉnegate = 41;
    U32ˉadd = 42;
    U32ˉsubtract = 43;
    U32ˉmultiply = 44;
    I32ˉequal = 45;
    I32ˉnotˉequal = 46;
    I32ˉless = 47;
    I32ˉlessˉequal = 48;
    I32ˉgreater = 49;
    I32ˉgreaterˉequal = 50;
    Boolˉequal = 51;
    Boolˉnotˉequal = 52;
    Boolˉnot = 53;
    U32ˉequal = 54;
    U32ˉnotˉequal = 55;
    U32ˉless = 56;
    U32ˉlessˉequal = 57;
    U32ˉgreater = 58;
    U32ˉgreaterˉequal = 59;
    U8ˉequal = 60;
    U8ˉnotˉequal = 61;
    Callˉfunction = 62;
    Callˉcapability = 63;
}

enum Compilerˉsourceˉwirˉterminator {
    None = 0;
    Jump = 1;
    Branch = 2;
    Return = 3;
}

enum Compilerˉsourceˉwirˉdataˉkind {
    None = 0;
    I32ˉarray = 1;
    Text = 2;
    Bytes = 3;
}

record Compilerˉsourceˉwirˉsignature {
    Parameterˉshape: u32;
    Returnˉshape: u32;
    Target: u32;
    Auxiliary: u32;
}

record Compilerˉsourceˉwirˉmember {
    Found: bool;
    Index: u32;
    Shape: u32;
}

record Compilerˉsourceˉwirˉrange {
    Valid: bool;
    Isˉfunction: bool;
    Module: u32;
    Firstˉblock: u32;
    Blockˉcount: u32;
    Firstˉoperation: u32;
    Operationˉcount: u32;
    Firstˉtemporary: u32;
    Temporaryˉcount: u32;
    Firstˉoperand: u32;
    Operandˉcount: u32;
    Parameters: u32;
    Locals: u32;
    Returnˉshape: u32;
}

record Compilerˉsourceˉwirˉbuild {
    Status: Compilerˉsourceˉwirˉstatus;
    Functionˉpayload: bytes;
    Blockˉpayload: bytes;
    Operationˉpayload: bytes;
    Temporaryˉpayload: bytes;
    Operandˉpayload: bytes;
    Functionˉentries: u32;
    Blocks: u32;
    Operations: u32;
    Temporaries: u32;
    Operands: u32;
    Currentˉmodule: u32;
    Currentˉfunction: u32;
    Functionˉfirstˉblock: u32;
    Functionˉfirstˉoperation: u32;
    Functionˉfirstˉtemporary: u32;
    Functionˉfirstˉoperand: u32;
    Nextˉblock: u32;
    Currentˉblock: u32;
    Currentˉblockˉfirstˉoperation: u32;
    Hasˉcurrentˉblock: bool;
    Bindingˉpayload: bytes;
    Bindingˉentries: u32;
    Bindingˉparameters: u32;
    Bindingˉlocals: u32;
    Bindingˉnextˉslot: u32;
    Failureˉmodule: u32;
    Failureˉrelatedˉmodule: u32;
    Failureˉfunction: u32;
    Failureˉoffset: u32;
    Failureˉline: u32;
    Failureˉcolumn: u32;
}

record Compilerˉsourceˉwirˉvalue {
    Status: Compilerˉsourceˉwirˉstatus;
    Functionˉpayload: bytes;
    Blockˉpayload: bytes;
    Operationˉpayload: bytes;
    Temporaryˉpayload: bytes;
    Operandˉpayload: bytes;
    Functionˉentries: u32;
    Blocks: u32;
    Operations: u32;
    Temporaries: u32;
    Operands: u32;
    Currentˉmodule: u32;
    Currentˉfunction: u32;
    Functionˉfirstˉblock: u32;
    Functionˉfirstˉoperation: u32;
    Functionˉfirstˉtemporary: u32;
    Functionˉfirstˉoperand: u32;
    Nextˉblock: u32;
    Currentˉblock: u32;
    Currentˉblockˉfirstˉoperation: u32;
    Hasˉcurrentˉblock: bool;
    Bindingˉpayload: bytes;
    Bindingˉentries: u32;
    Bindingˉparameters: u32;
    Bindingˉlocals: u32;
    Bindingˉnextˉslot: u32;
    Failureˉmodule: u32;
    Failureˉrelatedˉmodule: u32;
    Failureˉfunction: u32;
