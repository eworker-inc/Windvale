export fn Compilerˉsourceˉwirˉblockˉplaceholder(Input: bytes) -> bytes {
    var Result: bytes = Compilerˉsourceˉwirˉempty(Input);
    var Field: u32 = 0u32;
    while Field < 7u32 {
        Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(0u32));
        Field = Field + 1u32;
    }
    return Result;
}

export fn Compilerˉsourceˉwirˉstartˉfunction(
    Build: Compilerˉsourceˉwirˉbuild,
    Module: u32,
    Function: u32
) -> Compilerˉsourceˉwirˉbuild {
    let Empty: bytes = Compilerˉsourceˉwirˉempty(Build.Blockˉpayload);
    let Rootˉblock: bytes = Compilerˉsourceˉwirˉblockˉplaceholder(Empty);
    return Compilerˉsourceˉwirˉbuild(
        Build.Status,
        Empty, Rootˉblock, Empty, Empty, Empty,
        Build.Functionˉentries, Build.Blocks + 1u32, Build.Operations,
        Build.Temporaries, Build.Operands,
        Module, Function,
        Build.Blocks, Build.Operations, Build.Temporaries, Build.Operands,
        1u32, 0u32, Build.Operations, true,
        Build.Bindingˉpayload, Build.Bindingˉentries,
        Build.Bindingˉparameters, Build.Bindingˉlocals, Build.Bindingˉnextˉslot,
        Build.Genericˉevidence, Build.Genericˉinstance,
        Build.Failureˉmodule, Build.Failureˉrelatedˉmodule,
        Build.Failureˉfunction, Build.Failureˉoffset,
        Build.Failureˉline, Build.Failureˉcolumn
    );
}

fn Compilerˉsourceˉwirˉwithˉcurrentˉblock(
