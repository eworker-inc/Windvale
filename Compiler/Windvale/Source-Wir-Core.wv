export fn Compilerˉsourceˉwirˉempty(Input: bytes) -> bytes {
    return Bytesˉslice(Input, 0u32, 0u32);
}

export fn Compilerˉsourceˉwirˉbuildˉbindings(
    Input: bytes,
    Build: Compilerˉsourceˉwirˉbuild
) -> Sourceˉbindings.Compilerˉsourceˉbindingˉphase {
    let Bindingˉbuild: Sourceˉbindings.Compilerˉsourceˉbindingˉbuild = Sourceˉbindings.Compilerˉsourceˉbindingˉbuild(
        Sourceˉbindings.Compilerˉsourceˉbindingˉstatus.Valid,
        Build.Bindingˉpayload,
        Build.Bindingˉentries,
        Build.Bindingˉparameters,
        Build.Bindingˉlocals,
        Build.Bindingˉnextˉslot,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32
    );
    return Sourceˉbindings.Compilerˉsourceˉbindingsˉphaseˉfrom(
        Bindingˉbuild, Sourceˉbindings.Compilerˉsourceˉbindingsˉbodyˉempty()
    );
}

export fn Compilerˉsourceˉwirˉfusedˉfrom(
    Build: Compilerˉsourceˉwirˉbuild,
    Bindings: Sourceˉbindings.Compilerˉsourceˉbindingˉphase
) -> Compilerˉsourceˉwirˉbuild {
    return Compilerˉsourceˉwirˉbuild(
        Build.Status,
        Build.Functionˉpayload, Build.Blockˉpayload, Build.Operationˉpayload,
        Build.Temporaryˉpayload, Build.Operandˉpayload,
        Build.Functionˉentries, Build.Blocks, Build.Operations,
        Build.Temporaries, Build.Operands,
        Build.Currentˉmodule, Build.Currentˉfunction,
        Build.Functionˉfirstˉblock, Build.Functionˉfirstˉoperation,
        Build.Functionˉfirstˉtemporary, Build.Functionˉfirstˉoperand,
        Build.Nextˉblock, Build.Currentˉblock,
        Build.Currentˉblockˉfirstˉoperation, Build.Hasˉcurrentˉblock,
        Bindings.Payload, Bindings.Entries, Bindings.Parameters,
        Bindings.Locals, Bindings.Nextˉslot,
        Build.Failureˉmodule, Build.Failureˉrelatedˉmodule,
        Build.Failureˉfunction, Build.Failureˉoffset,
        Build.Failureˉline, Build.Failureˉcolumn
    );
}

export fn Compilerˉsourceˉwirˉsentinel() -> u32 {
    return 4294967295u32;
}

export fn Compilerˉsourceˉwirˉshapeˉisˉvalid(
    Shape: u32,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Allowˉvoid: bool
) -> bool {
    if Shape == 0u32 { return Allowˉvoid; }
    if Shape <= 8u32 { return true; }
    if Shape >= 65536u32 {
        if Shape < 65536u32 + Symbols.Records { return true; }
    }
    if Shape >= 131072u32 + Symbols.Records {
        if Shape < 131072u32 + Symbols.Records + Symbols.Enums { return true; }
    }
    if Shape >= 196608u32 + Symbols.Records + Symbols.Enums {
        if Shape < 196608u32 + Symbols.Records + Symbols.Enums + Symbols.Variants { return true; }
    }
    if Shape >= 1073741824u32 {
        if Shape < 1610612736u32 { return true; }
    }
    return false;
}

export fn Compilerˉsourceˉwirˉshapeˉisˉsequence(Shape: u32) -> bool {
    if Shape < 1073741824u32 { return false; }
    return Shape < 1342177280u32;
}

export fn Compilerˉsourceˉwirˉshapeˉisˉbuilder(Shape: u32) -> bool {
    if Shape < 1342177280u32 { return false; }
    return Shape < 1610612736u32;
}

export fn Compilerˉsourceˉwirˉcollectionˉcompactˉelement(Shape: u32) -> u32 {
    return Bytesˉreadˉu16ˉlittle(Bytesˉfromˉu32ˉlittle(Shape), 0u32);
}

export fn Compilerˉsourceˉwirˉcollectionˉelementˉshape(Shape: u32) -> u32 {
    let Element: u32 = Compilerˉsourceˉwirˉcollectionˉcompactˉelement(Shape);
    if Element < 4096u32 { return Element; }
    if Element < 8192u32 { return 65536u32 + Element - 4096u32; }
    if Element < 12288u32 { return 131072u32 + Element - 8192u32; }
    return 196608u32 + Element - 12288u32;
}

export fn Compilerˉsourceˉwirˉcollectionˉmaximum(Shape: u32) -> u32 {
    let Upper: u32 = Bytesˉreadˉu16ˉlittle(Bytesˉfromˉu32ˉlittle(Shape), 2u32);
    if Compilerˉsourceˉwirˉshapeˉisˉsequence(Shape) { return Upper - 16384u32; }
    return Upper - 20480u32;
}

export fn Compilerˉsourceˉwirˉcollectionˉdescriptor(Shape: u32) -> u32 {
    let Element: u32 = Compilerˉsourceˉwirˉcollectionˉcompactˉelement(Shape);
    if Element < 4096u32 { return Element; }
    if Element < 8192u32 { return 1073741824u32 + Element - 4096u32; }
    if Element < 12288u32 { return 2147483648u32 + Element - 8192u32; }
    return 3221225472u32 + Element - 12288u32;
}

export fn Compilerˉsourceˉwirˉoperationˉvalue(
    Operation: Compilerˉsourceˉwirˉoperation
) -> u32 {
    if Operation == Compilerˉsourceˉwirˉoperation.I32ˉconstant { return 1u32; }
    if Operation == Compilerˉsourceˉwirˉoperation.U8ˉconstant { return 2u32; }
    if Operation == Compilerˉsourceˉwirˉoperation.U32ˉconstant { return 3u32; }
    if Operation == Compilerˉsourceˉwirˉoperation.Boolˉconstant { return 4u32; }
    if Operation == Compilerˉsourceˉwirˉoperation.Textˉconstant { return 5u32; }
    if Operation == Compilerˉsourceˉwirˉoperation.Bytesˉconstant { return 6u32; }
    if Operation == Compilerˉsourceˉwirˉoperation.Loadˉlocal { return 7u32; }
    if Operation == Compilerˉsourceˉwirˉoperation.Storeˉlocal { return 8u32; }
    if Operation == Compilerˉsourceˉwirˉoperation.Dataˉlength { return 9u32; }
    if Operation == Compilerˉsourceˉwirˉoperation.Dataˉloadˉi32 { return 10u32; }
    if Operation == Compilerˉsourceˉwirˉoperation.Bytesˉlength { return 11u32; }
    if Operation == Compilerˉsourceˉwirˉoperation.Bytesˉslice { return 12u32; }
    if Operation == Compilerˉsourceˉwirˉoperation.Bytesˉreadˉu8 { return 13u32; }
    if Operation == Compilerˉsourceˉwirˉoperation.Bytesˉreadˉu16ˉlittle { return 14u32; }
    if Operation == Compilerˉsourceˉwirˉoperation.Bytesˉreadˉu32ˉlittle { return 15u32; }
    if Operation == Compilerˉsourceˉwirˉoperation.Bytesˉreadˉi32ˉlittle { return 16u32; }
    if Operation == Compilerˉsourceˉwirˉoperation.Recordˉcreate { return 17u32; }
    if Operation == Compilerˉsourceˉwirˉoperation.Recordˉfield { return 18u32; }
    if Operation == Compilerˉsourceˉwirˉoperation.Enumˉconstant { return 19u32; }
    if Operation == Compilerˉsourceˉwirˉoperation.Enumˉequal { return 20u32; }
    if Operation == Compilerˉsourceˉwirˉoperation.Enumˉnotˉequal { return 21u32; }
    if Operation == Compilerˉsourceˉwirˉoperation.Enumˉname { return 22u32; }
    if Operation == Compilerˉsourceˉwirˉoperation.I32ˉformat { return 23u32; }
    if Operation == Compilerˉsourceˉwirˉoperation.U8ˉformat { return 24u32; }
    if Operation == Compilerˉsourceˉwirˉoperation.U32ˉformat { return 25u32; }
    if Operation == Compilerˉsourceˉwirˉoperation.U32ˉfromˉu8 { return 26u32; }
    if Operation == Compilerˉsourceˉwirˉoperation.Textˉconcat { return 27u32; }
    if Operation == Compilerˉsourceˉwirˉoperation.Textˉutf8ˉisˉvalid { return 28u32; }
    if Operation == Compilerˉsourceˉwirˉoperation.Textˉfromˉutf8 { return 29u32; }
    if Operation == Compilerˉsourceˉwirˉoperation.Textˉquote { return 30u32; }
    if Operation == Compilerˉsourceˉwirˉoperation.Bytesˉconcat { return 31u32; }
    if Operation == Compilerˉsourceˉwirˉoperation.Bytesˉfromˉu8 { return 32u32; }
    if Operation == Compilerˉsourceˉwirˉoperation.Bytesˉfromˉu16ˉlittle { return 33u32; }
    if Operation == Compilerˉsourceˉwirˉoperation.Bytesˉfromˉu32ˉlittle { return 34u32; }
    if Operation == Compilerˉsourceˉwirˉoperation.Bytesˉfromˉi32ˉlittle { return 35u32; }
    if Operation == Compilerˉsourceˉwirˉoperation.Bytesˉsha256ˉhex { return 36u32; }
    if Operation == Compilerˉsourceˉwirˉoperation.Textˉtoˉutf8 { return 37u32; }
    if Operation == Compilerˉsourceˉwirˉoperation.I32ˉadd { return 38u32; }
    if Operation == Compilerˉsourceˉwirˉoperation.I32ˉsubtract { return 39u32; }
    if Operation == Compilerˉsourceˉwirˉoperation.I32ˉmultiply { return 40u32; }
    if Operation == Compilerˉsourceˉwirˉoperation.I32ˉnegate { return 41u32; }
    if Operation == Compilerˉsourceˉwirˉoperation.U32ˉadd { return 42u32; }
    if Operation == Compilerˉsourceˉwirˉoperation.U32ˉsubtract { return 43u32; }
    if Operation == Compilerˉsourceˉwirˉoperation.U32ˉmultiply { return 44u32; }
    if Operation == Compilerˉsourceˉwirˉoperation.I32ˉequal { return 45u32; }
    if Operation == Compilerˉsourceˉwirˉoperation.I32ˉnotˉequal { return 46u32; }
    if Operation == Compilerˉsourceˉwirˉoperation.I32ˉless { return 47u32; }
    if Operation == Compilerˉsourceˉwirˉoperation.I32ˉlessˉequal { return 48u32; }
    if Operation == Compilerˉsourceˉwirˉoperation.I32ˉgreater { return 49u32; }
    if Operation == Compilerˉsourceˉwirˉoperation.I32ˉgreaterˉequal { return 50u32; }
    if Operation == Compilerˉsourceˉwirˉoperation.Boolˉequal { return 51u32; }
    if Operation == Compilerˉsourceˉwirˉoperation.Boolˉnotˉequal { return 52u32; }
    if Operation == Compilerˉsourceˉwirˉoperation.Boolˉnot { return 53u32; }
    if Operation == Compilerˉsourceˉwirˉoperation.U32ˉequal { return 54u32; }
    if Operation == Compilerˉsourceˉwirˉoperation.U32ˉnotˉequal { return 55u32; }
    if Operation == Compilerˉsourceˉwirˉoperation.U32ˉless { return 56u32; }
    if Operation == Compilerˉsourceˉwirˉoperation.U32ˉlessˉequal { return 57u32; }
    if Operation == Compilerˉsourceˉwirˉoperation.U32ˉgreater { return 58u32; }
    if Operation == Compilerˉsourceˉwirˉoperation.U32ˉgreaterˉequal { return 59u32; }
    if Operation == Compilerˉsourceˉwirˉoperation.U8ˉequal { return 60u32; }
    if Operation == Compilerˉsourceˉwirˉoperation.U8ˉnotˉequal { return 61u32; }
    if Operation == Compilerˉsourceˉwirˉoperation.Callˉfunction { return 62u32; }
    if Operation == Compilerˉsourceˉwirˉoperation.Callˉcapability { return 63u32; }
    if Operation == Compilerˉsourceˉwirˉoperation.Boolˉphi { return 64u32; }
