    Currentˉblock: u32,
    Firstˉoperation: u32,
    Hasˉcurrentˉblock: bool
) -> Compilerˉsourceˉwirˉbuild {
    return Compilerˉsourceˉwirˉwithˉanalysisˉstate(
        Build,
        Build.Status,
        Currentˉblock, Firstˉoperation, Hasˉcurrentˉblock,
        Build.Bindingˉpayload, Build.Bindingˉentries,
        Build.Bindingˉparameters, Build.Bindingˉlocals, Build.Bindingˉnextˉslot,
        Build.Genericˉevidence, Build.Genericˉinstance,
        Build.Failureˉmodule, Build.Failureˉrelatedˉmodule,
        Build.Failureˉfunction, Build.Failureˉoffset,
        Build.Failureˉline, Build.Failureˉcolumn
    );
}

export fn Compilerˉsourceˉwirˉwithoutˉcurrentˉblock(
    Build: Compilerˉsourceˉwirˉbuild
) -> Compilerˉsourceˉwirˉbuild {
    return Compilerˉsourceˉwirˉwithˉcurrentˉblock(
        Build,
        Build.Currentˉblock,
        Build.Currentˉblockˉfirstˉoperation,
        false
    );
}

fn Compilerˉsourceˉwirˉwithˉreservedˉblocks(
    Build: Compilerˉsourceˉwirˉbuild,
    Blockˉpayload: bytes,
    Added: u32
) -> Compilerˉsourceˉwirˉbuild {
    return Compilerˉsourceˉwirˉbuild(
        Build.Status,
        Build.Functionˉpayload, Blockˉpayload, Build.Operationˉpayload,
        Build.Temporaryˉpayload, Build.Operandˉpayload,
        Build.Functionˉentries, Build.Blocks + Added, Build.Operations,
        Build.Temporaries, Build.Operands,
        Build.Currentˉmodule, Build.Currentˉfunction,
        Build.Functionˉfirstˉblock, Build.Functionˉfirstˉoperation,
        Build.Functionˉfirstˉtemporary, Build.Functionˉfirstˉoperand,
        Build.Nextˉblock + Added, Build.Currentˉblock,
        Build.Currentˉblockˉfirstˉoperation, Build.Hasˉcurrentˉblock,
        Build.Bindingˉpayload, Build.Bindingˉentries,
        Build.Bindingˉparameters, Build.Bindingˉlocals, Build.Bindingˉnextˉslot,
        Build.Genericˉevidence, Build.Genericˉinstance,
        Build.Failureˉmodule, Build.Failureˉrelatedˉmodule,
        Build.Failureˉfunction, Build.Failureˉoffset,
        Build.Failureˉline, Build.Failureˉcolumn
    );
}

export fn Compilerˉsourceˉwirˉreserveˉblocks(
    Build: Compilerˉsourceˉwirˉbuild,
    Count: u32
) -> Compilerˉsourceˉwirˉbuild {
    var Blockˉpayload: bytes = Build.Blockˉpayload;
    var Added: u32 = 0u32;
    while Added < Count {
        if Bytesˉlength(Blockˉpayload) > 4194276u32 {
            let Partial: Compilerˉsourceˉwirˉbuild =
                Compilerˉsourceˉwirˉwithˉreservedˉblocks(
                    Build, Blockˉpayload, Added
                );
            return Compilerˉsourceˉwirˉbuildˉfailure(
                Partial,
                Compilerˉsourceˉwirˉstatus.Evidenceˉlimit,
                Build.Currentˉmodule, Build.Currentˉmodule,
                Build.Currentˉfunction, 0u32, 0u32, 0u32
            );
        }
        Blockˉpayload = Bytesˉconcat(
            Blockˉpayload,
            Compilerˉsourceˉwirˉblockˉplaceholder(Blockˉpayload)
        );
        Added = Added + 1u32;
    }
    return Compilerˉsourceˉwirˉwithˉreservedˉblocks(
        Build, Blockˉpayload, Count
    );
}

export fn Compilerˉsourceˉwirˉbeginˉreservedˉblock(
    Build: Compilerˉsourceˉwirˉbuild,
    Block: u32
) -> Compilerˉsourceˉwirˉbuild {
    return Compilerˉsourceˉwirˉwithˉcurrentˉblock(
        Build, Block, Build.Operations, true
    );
}

export fn Compilerˉsourceˉwirˉappendˉblock(
    Build: Compilerˉsourceˉwirˉbuild,
    Block: u32,
    Firstˉoperation: u32,
    Operationˉcount: u32,
    Terminator: Compilerˉsourceˉwirˉterminator,
    Value: u32,
    Firstˉtarget: u32,
    Secondˉtarget: u32
) -> Compilerˉsourceˉwirˉbuild {
    if Block >= Build.Nextˉblock {
        return Compilerˉsourceˉwirˉbuildˉfailure(
            Build,
            Compilerˉsourceˉwirˉstatus.Invalidˉdirectory,
            Build.Currentˉmodule,
            Build.Currentˉmodule,
            Build.Currentˉfunction,
            0u32,
            0u32,
            0u32
        );
    }
    var Entry: bytes = Bytesˉfromˉu32ˉlittle(Block);
    Entry = Bytesˉconcat(Entry, Bytesˉfromˉu32ˉlittle(Firstˉoperation));
    Entry = Bytesˉconcat(Entry, Bytesˉfromˉu32ˉlittle(Operationˉcount));
    Entry = Bytesˉconcat(Entry, Bytesˉfromˉu32ˉlittle(Compilerˉsourceˉwirˉterminatorˉvalue(Terminator)));
    Entry = Bytesˉconcat(Entry, Bytesˉfromˉu32ˉlittle(Value));
    Entry = Bytesˉconcat(Entry, Bytesˉfromˉu32ˉlittle(Firstˉtarget));
    Entry = Bytesˉconcat(Entry, Bytesˉfromˉu32ˉlittle(Secondˉtarget));
    let Blockˉoffset: u32 = Block * 28u32;
    let Replaced: Byteˉconstruction.Foundationˉbytesˉresult = Byteˉconstruction.Foundationˉbytesˉreplace(
        Build.Blockˉpayload, Blockˉoffset, 28u32, Entry
    );
    if !Replaced.Valid {
        return Compilerˉsourceˉwirˉbuildˉfailure(
            Build,
            Compilerˉsourceˉwirˉstatus.Invalidˉdirectory,
            Build.Currentˉmodule,
            Build.Currentˉmodule,
            Build.Currentˉfunction,
            0u32,
            0u32,
            0u32
        );
    }
    return Compilerˉsourceˉwirˉbuild(
        Build.Status,
        Build.Functionˉpayload,
        Replaced.Value,
        Build.Operationˉpayload, Build.Temporaryˉpayload, Build.Operandˉpayload,
        Build.Functionˉentries, Build.Blocks, Build.Operations,
        Build.Temporaries, Build.Operands,
        Build.Currentˉmodule, Build.Currentˉfunction,
        Build.Functionˉfirstˉblock, Build.Functionˉfirstˉoperation,
        Build.Functionˉfirstˉtemporary, Build.Functionˉfirstˉoperand,
        Build.Nextˉblock, Build.Currentˉblock,
        Build.Currentˉblockˉfirstˉoperation, Build.Hasˉcurrentˉblock,
        Build.Bindingˉpayload, Build.Bindingˉentries,
        Build.Bindingˉparameters, Build.Bindingˉlocals, Build.Bindingˉnextˉslot,
        Build.Genericˉevidence, Build.Genericˉinstance,
        Build.Failureˉmodule, Build.Failureˉrelatedˉmodule,
        Build.Failureˉfunction, Build.Failureˉoffset,
        Build.Failureˉline, Build.Failureˉcolumn
    );
}

export fn Compilerˉsourceˉwirˉcloseˉcurrentˉblock(
    Build: Compilerˉsourceˉwirˉbuild,
    Terminator: Compilerˉsourceˉwirˉterminator,
    Value: u32,
    Firstˉtarget: u32,
    Secondˉtarget: u32
) -> Compilerˉsourceˉwirˉbuild {
    let Closed: Compilerˉsourceˉwirˉbuild = Compilerˉsourceˉwirˉappendˉblock(
        Build,
        Build.Currentˉblock,
        Build.Currentˉblockˉfirstˉoperation,
        Build.Operations - Build.Currentˉblockˉfirstˉoperation,
        Terminator,
        Value,
        Firstˉtarget,
        Secondˉtarget
    );
    return Compilerˉsourceˉwirˉwithoutˉcurrentˉblock(Closed);
}

export fn Compilerˉsourceˉwirˉappendˉfunctionˉentry(
    Build: Compilerˉsourceˉwirˉbuild,
    Isˉfunction: bool,
    Parameters: u32,
    Locals: u32,
    Returnˉshape: u32
) -> Compilerˉsourceˉwirˉbuild {
    if Bytesˉlength(Build.Functionˉpayload) > 4194256u32 {
        return Compilerˉsourceˉwirˉbuildˉfailure(
            Build,
            Compilerˉsourceˉwirˉstatus.Evidenceˉlimit,
            Build.Currentˉmodule,
            Build.Currentˉmodule,
            Build.Currentˉfunction,
            0u32,
            0u32,
            0u32
        );
    }
    var Entry: bytes = Compilerˉsourceˉwirˉempty(Build.Functionˉpayload);
    if Isˉfunction {
        Entry = Bytesˉfromˉu32ˉlittle(Build.Currentˉmodule);
        Entry = Bytesˉconcat(Entry, Bytesˉfromˉu32ˉlittle(Build.Functionˉfirstˉblock));
        Entry = Bytesˉconcat(Entry, Bytesˉfromˉu32ˉlittle(Build.Blocks - Build.Functionˉfirstˉblock));
        Entry = Bytesˉconcat(Entry, Bytesˉfromˉu32ˉlittle(Build.Functionˉfirstˉoperation));
        Entry = Bytesˉconcat(Entry, Bytesˉfromˉu32ˉlittle(Build.Operations - Build.Functionˉfirstˉoperation));
        Entry = Bytesˉconcat(Entry, Bytesˉfromˉu32ˉlittle(Build.Functionˉfirstˉtemporary));
        Entry = Bytesˉconcat(Entry, Bytesˉfromˉu32ˉlittle(Build.Temporaries - Build.Functionˉfirstˉtemporary));
        Entry = Bytesˉconcat(Entry, Bytesˉfromˉu32ˉlittle(Build.Functionˉfirstˉoperand));
        Entry = Bytesˉconcat(Entry, Bytesˉfromˉu32ˉlittle(Build.Operands - Build.Functionˉfirstˉoperand));
        Entry = Bytesˉconcat(Entry, Bytesˉfromˉu32ˉlittle(Parameters));
        Entry = Bytesˉconcat(Entry, Bytesˉfromˉu32ˉlittle(Locals));
        Entry = Bytesˉconcat(Entry, Bytesˉfromˉu32ˉlittle(Returnˉshape));
    } else {
        var Index: u32 = 0u32;
        while Index < 12u32 {
            Entry = Bytesˉconcat(Entry, Bytesˉfromˉu32ˉlittle(0u32));
            Index = Index + 1u32;
        }
    }
    return Compilerˉsourceˉwirˉbuild(
        Build.Status,
        Bytesˉconcat(Build.Functionˉpayload, Entry),
        Build.Blockˉpayload, Build.Operationˉpayload,
        Build.Temporaryˉpayload, Build.Operandˉpayload,
        Build.Functionˉentries + 1u32, Build.Blocks, Build.Operations,
        Build.Temporaries, Build.Operands,
        Build.Currentˉmodule, Build.Currentˉfunction,
        Build.Functionˉfirstˉblock, Build.Functionˉfirstˉoperation,
        Build.Functionˉfirstˉtemporary, Build.Functionˉfirstˉoperand,
        Build.Nextˉblock, Build.Currentˉblock,
        Build.Currentˉblockˉfirstˉoperation, Build.Hasˉcurrentˉblock,
        Build.Bindingˉpayload, Build.Bindingˉentries,
        Build.Bindingˉparameters, Build.Bindingˉlocals, Build.Bindingˉnextˉslot,
        Build.Genericˉevidence, Build.Genericˉinstance,
        Build.Failureˉmodule, Build.Failureˉrelatedˉmodule,
        Build.Failureˉfunction, Build.Failureˉoffset,
        Build.Failureˉline, Build.Failureˉcolumn
    );
}

export fn Compilerˉsourceˉwirˉmergeˉfunction(
    Outer: Compilerˉsourceˉwirˉbuild,
    Function: Compilerˉsourceˉwirˉbuild
) -> Compilerˉsourceˉwirˉbuild {
    let Functionˉbytes: u32 = Bytesˉlength(Function.Functionˉpayload);
    if Bytesˉlength(Outer.Functionˉpayload) > 4194304u32 - Functionˉbytes {
        return Compilerˉsourceˉwirˉbuildˉfailure(
            Function, Compilerˉsourceˉwirˉstatus.Evidenceˉlimit,
            Function.Currentˉmodule, Function.Currentˉmodule,
            Function.Currentˉfunction, 0u32, 0u32, 0u32
        );
    }
    let Blockˉbytes: u32 = Bytesˉlength(Function.Blockˉpayload);
    if Bytesˉlength(Outer.Blockˉpayload) > 4194304u32 - Blockˉbytes {
        return Compilerˉsourceˉwirˉbuildˉfailure(
            Function, Compilerˉsourceˉwirˉstatus.Evidenceˉlimit,
            Function.Currentˉmodule, Function.Currentˉmodule,
            Function.Currentˉfunction, 0u32, 0u32, 0u32
        );
    }
    let Operationˉbytes: u32 = Bytesˉlength(Function.Operationˉpayload);
    if Bytesˉlength(Outer.Operationˉpayload) > 4194304u32 - Operationˉbytes {
        return Compilerˉsourceˉwirˉbuildˉfailure(
            Function, Compilerˉsourceˉwirˉstatus.Evidenceˉlimit,
            Function.Currentˉmodule, Function.Currentˉmodule,
            Function.Currentˉfunction, 0u32, 0u32, 0u32
        );
    }
    let Temporaryˉbytes: u32 = Bytesˉlength(Function.Temporaryˉpayload);
    if Bytesˉlength(Outer.Temporaryˉpayload) > 4194304u32 - Temporaryˉbytes {
        return Compilerˉsourceˉwirˉbuildˉfailure(
            Function, Compilerˉsourceˉwirˉstatus.Evidenceˉlimit,
            Function.Currentˉmodule, Function.Currentˉmodule,
            Function.Currentˉfunction, 0u32, 0u32, 0u32
        );
    }
    let Operandˉbytes: u32 = Bytesˉlength(Function.Operandˉpayload);
    if Bytesˉlength(Outer.Operandˉpayload) > 4194304u32 - Operandˉbytes {
        return Compilerˉsourceˉwirˉbuildˉfailure(
            Function, Compilerˉsourceˉwirˉstatus.Evidenceˉlimit,
            Function.Currentˉmodule, Function.Currentˉmodule,
            Function.Currentˉfunction, 0u32, 0u32, 0u32
        );
    }
    return Compilerˉsourceˉwirˉbuild(
        Function.Status,
        Bytesˉconcat(Outer.Functionˉpayload, Function.Functionˉpayload),
        Bytesˉconcat(Outer.Blockˉpayload, Function.Blockˉpayload),
        Bytesˉconcat(Outer.Operationˉpayload, Function.Operationˉpayload),
        Bytesˉconcat(Outer.Temporaryˉpayload, Function.Temporaryˉpayload),
        Bytesˉconcat(Outer.Operandˉpayload, Function.Operandˉpayload),
        Function.Functionˉentries, Function.Blocks, Function.Operations,
        Function.Temporaries, Function.Operands,
        Function.Currentˉmodule, Function.Currentˉfunction,
        Function.Functionˉfirstˉblock, Function.Functionˉfirstˉoperation,
        Function.Functionˉfirstˉtemporary, Function.Functionˉfirstˉoperand,
        Function.Nextˉblock, Function.Currentˉblock,
        Function.Currentˉblockˉfirstˉoperation, Function.Hasˉcurrentˉblock,
        Function.Bindingˉpayload, Function.Bindingˉentries,
        Function.Bindingˉparameters, Function.Bindingˉlocals, Function.Bindingˉnextˉslot,
        Function.Genericˉevidence, Function.Genericˉinstance,
        Function.Failureˉmodule, Function.Failureˉrelatedˉmodule,
        Function.Failureˉfunction, Function.Failureˉoffset,
        Function.Failureˉline, Function.Failureˉcolumn
    );
}

export fn Compilerˉsourceˉwirˉemit(
    Build: Compilerˉsourceˉwirˉbuild,
    Operation: u32,
    Shape: u32,
    Operandˉbytes: bytes,
    Target: u32,
    Auxiliary: u32,
    Offset: u32,
    Length: u32
) -> Compilerˉsourceˉwirˉvalue {
    if Bytesˉlength(Build.Operationˉpayload) > 4194272u32 {
        return Compilerˉsourceˉwirˉfailureˉvalue(
            Build, Compilerˉsourceˉwirˉstatus.Evidenceˉlimit,
            Build.Currentˉmodule, Offset, 0u32, 0u32
        );
    }
    if Shape != 0u32 {
        if Bytesˉlength(Build.Temporaryˉpayload) > 4194300u32 {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Build, Compilerˉsourceˉwirˉstatus.Evidenceˉlimit,
                Build.Currentˉmodule, Offset, 0u32, 0u32
            );
        }
    }
    if Bytesˉlength(Operandˉbytes) > 4194304u32 {
        return Compilerˉsourceˉwirˉfailureˉvalue(
            Build, Compilerˉsourceˉwirˉstatus.Evidenceˉlimit,
            Build.Currentˉmodule, Offset, 0u32, 0u32
        );
    }
    if Bytesˉlength(Build.Operandˉpayload) > 4194304u32 - Bytesˉlength(Operandˉbytes) {
        return Compilerˉsourceˉwirˉfailureˉvalue(
            Build, Compilerˉsourceˉwirˉstatus.Evidenceˉlimit,
            Build.Currentˉmodule, Offset, 0u32, 0u32
        );
    }
    var Operandˉremaining: u32 = Bytesˉlength(Operandˉbytes);
    var Operandˉcount: u32 = 0u32;
    while Operandˉremaining > 0u32 {
        Operandˉremaining = Operandˉremaining - 4u32;
        Operandˉcount = Operandˉcount + 1u32;
    }
    let Firstˉoperand: u32 = Build.Operands;
    var Temporary: u32 = Compilerˉsourceˉwirˉsentinel();
    var Temporaryˉpayload: bytes = Build.Temporaryˉpayload;
    var Temporaries: u32 = Build.Temporaries;
    if Shape != 0u32 {
        Temporary = Build.Temporaries - Build.Functionˉfirstˉtemporary;
        Temporaryˉpayload = Bytesˉconcat(Temporaryˉpayload, Bytesˉfromˉu32ˉlittle(Shape));
        Temporaries = Temporaries + 1u32;
    }
    var Entry: bytes = Bytesˉfromˉu32ˉlittle(Build.Currentˉblock);
    Entry = Bytesˉconcat(Entry, Bytesˉfromˉu32ˉlittle(Operation));
    Entry = Bytesˉconcat(Entry, Bytesˉfromˉu32ˉlittle(Shape));
    Entry = Bytesˉconcat(Entry, Bytesˉfromˉu32ˉlittle(Temporary));
    Entry = Bytesˉconcat(Entry, Bytesˉfromˉu32ˉlittle(Firstˉoperand));
    Entry = Bytesˉconcat(Entry, Bytesˉfromˉu32ˉlittle(Operandˉcount));
    Entry = Bytesˉconcat(Entry, Bytesˉfromˉu32ˉlittle(Target));
    Entry = Bytesˉconcat(Entry, Bytesˉfromˉu32ˉlittle(Auxiliary));
    let Result: Compilerˉsourceˉwirˉbuild = Compilerˉsourceˉwirˉbuild(
        Build.Status,
        Build.Functionˉpayload, Build.Blockˉpayload,
        Bytesˉconcat(Build.Operationˉpayload, Entry),
        Temporaryˉpayload,
        Bytesˉconcat(Build.Operandˉpayload, Operandˉbytes),
        Build.Functionˉentries, Build.Blocks, Build.Operations + 1u32,
        Temporaries, Build.Operands + Operandˉcount,
        Build.Currentˉmodule, Build.Currentˉfunction,
        Build.Functionˉfirstˉblock, Build.Functionˉfirstˉoperation,
        Build.Functionˉfirstˉtemporary, Build.Functionˉfirstˉoperand,
        Build.Nextˉblock, Build.Currentˉblock,
        Build.Currentˉblockˉfirstˉoperation, Build.Hasˉcurrentˉblock,
        Build.Bindingˉpayload, Build.Bindingˉentries,
        Build.Bindingˉparameters, Build.Bindingˉlocals, Build.Bindingˉnextˉslot,
        Build.Genericˉevidence, Build.Genericˉinstance,
        Build.Failureˉmodule, Build.Failureˉrelatedˉmodule,
        Build.Failureˉfunction, Build.Failureˉoffset,
        Build.Failureˉline, Build.Failureˉcolumn
    );
    return Compilerˉsourceˉwirˉvalueˉfrom(Result, Shape, Temporary);
}

export fn Compilerˉsourceˉwirˉoneˉoperand(Temporary: u32) -> bytes {
    return Bytesˉfromˉu32ˉlittle(Temporary);
}

export fn Compilerˉsourceˉwirˉtwoˉoperands(First: u32, Second: u32) -> bytes {
    return Bytesˉconcat(
        Bytesˉfromˉu32ˉlittle(First),
        Bytesˉfromˉu32ˉlittle(Second)
    );
}

export fn Compilerˉsourceˉwirˉintrinsicˉoperation(
    Source: bytes,
    Offset: u32,
    Length: u32
) -> u32 {
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "Bytesˉlength") { return WIR_OPERATION_BYTES_LENGTH; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "Bytesˉslice") { return WIR_OPERATION_BYTES_SLICE; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "Bytesˉreadˉu8") { return WIR_OPERATION_BYTES_READ_U8; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "Bytesˉreadˉu16ˉlittle") { return WIR_OPERATION_BYTES_READ_U16_LITTLE; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "Bytesˉreadˉu32ˉlittle") { return WIR_OPERATION_BYTES_READ_U32_LITTLE; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "Bytesˉreadˉi32ˉlittle") { return WIR_OPERATION_BYTES_READ_I32_LITTLE; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "Bytesˉreadˉu64ˉlittle") { return WIR_OPERATION_BYTES_READ_U64_LITTLE; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "Bytesˉconcat") { return WIR_OPERATION_BYTES_CONCAT; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "Bytesˉfromˉu8") { return WIR_OPERATION_BYTES_FROM_U8; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "Bytesˉfromˉu16ˉlittle") { return WIR_OPERATION_BYTES_FROM_U16_LITTLE; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "Bytesˉfromˉu32ˉlittle") { return WIR_OPERATION_BYTES_FROM_U32_LITTLE; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "Bytesˉfromˉi32ˉlittle") { return WIR_OPERATION_BYTES_FROM_I32_LITTLE; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "Bytesˉfromˉu64ˉlittle") { return WIR_OPERATION_BYTES_FROM_U64_LITTLE; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "Bytesˉsha256ˉhex") { return WIR_OPERATION_BYTES_SHA256_HEX; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "U32ˉfromˉu8") { return WIR_OPERATION_U32_FROM_U8; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "U64ˉfromˉu32") { return WIR_OPERATION_U64_FROM_U32; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "I32ˉformat") { return WIR_OPERATION_I32_FORMAT; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "U8ˉformat") { return WIR_OPERATION_U8_FORMAT; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "U32ˉformat") { return WIR_OPERATION_U32_FORMAT; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "I64ˉformat") { return WIR_OPERATION_I64_FORMAT; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "U64ˉformat") { return WIR_OPERATION_U64_FORMAT; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "Textˉconcat") { return WIR_OPERATION_TEXT_CONCAT; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "Textˉutf8ˉisˉvalid") { return WIR_OPERATION_TEXT_UTF8_IS_VALID; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "Textˉfromˉutf8") { return WIR_OPERATION_TEXT_FROM_UTF8; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "Textˉquote") { return WIR_OPERATION_TEXT_QUOTE; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "Textˉtoˉutf8") { return WIR_OPERATION_TEXT_TO_UTF8; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "Enumˉname") { return WIR_OPERATION_ENUM_NAME; }
    return WIR_OPERATION_NONE;
}

export fn Compilerˉsourceˉwirˉintrinsicˉparameterˉshape(
    Source: bytes,
    Offset: u32,
    Length: u32,
    Index: u32
) -> u32 {
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "Bytesˉslice") {
        if Index == 0u32 { return 6u32; }
        return 3u32;
    }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "Bytesˉreadˉu8") {
        if Index == 0u32 { return 6u32; }
        return 3u32;
    }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "Bytesˉreadˉu16ˉlittle") {
        if Index == 0u32 { return 6u32; }
        return 3u32;
    }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "Bytesˉreadˉu32ˉlittle") {
        if Index == 0u32 { return 6u32; }
        return 3u32;
    }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "Bytesˉreadˉi32ˉlittle") {
        if Index == 0u32 { return 6u32; }
        return 3u32;
    }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "Bytesˉreadˉu64ˉlittle") {
        if Index == 0u32 { return 6u32; }
        return 3u32;
    }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "Bytesˉconcat") { return 6u32; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "Textˉconcat") { return 5u32; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "Bytesˉfromˉu8") { return 2u32; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "Bytesˉfromˉu16ˉlittle") { return 3u32; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "Bytesˉfromˉu32ˉlittle") { return 3u32; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "Bytesˉfromˉi32ˉlittle") { return 1u32; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "Bytesˉfromˉu64ˉlittle") { return 8u32; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "U32ˉfromˉu8") { return 2u32; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "U64ˉfromˉu32") { return 3u32; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "I32ˉformat") { return 1u32; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "U8ˉformat") { return 2u32; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "U32ˉformat") { return 3u32; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "I64ˉformat") { return 7u32; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "U64ˉformat") { return 8u32; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "Textˉquote") { return 5u32; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "Textˉtoˉutf8") { return 5u32; }
    return 6u32;
}

export fn Compilerˉsourceˉwirˉintrinsicˉreturnˉshape(
    Source: bytes,
    Offset: u32,
    Length: u32
) -> u32 {
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "Bytesˉlength") { return 3u32; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "Bytesˉreadˉu8") { return 2u32; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "Bytesˉreadˉu16ˉlittle") { return 3u32; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "Bytesˉreadˉu32ˉlittle") { return 3u32; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "Bytesˉreadˉi32ˉlittle") { return 1u32; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "Bytesˉreadˉu64ˉlittle") { return 8u32; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "U32ˉfromˉu8") { return 3u32; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "U64ˉfromˉu32") { return 8u32; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "Textˉutf8ˉisˉvalid") { return 4u32; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "I32ˉformat") { return 5u32; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "U8ˉformat") { return 5u32; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "U32ˉformat") { return 5u32; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "I64ˉformat") { return 5u32; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "U64ˉformat") { return 5u32; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "Textˉconcat") { return 5u32; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "Bytesˉsha256ˉhex") { return 5u32; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "Textˉfromˉutf8") { return 5u32; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "Textˉquote") { return 5u32; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "Enumˉname") { return 5u32; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "Textˉtoˉutf8") { return 6u32; }
    return 6u32;
}

export fn Compilerˉsourceˉwirˉcapabilityˉparameterˉshape(
    Source: bytes,
    Offset: u32,
    Length: u32,
    Index: u32
) -> u32 {
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "file.write_bytes") {
        if Index == 0u32 { return 5u32; }
        return 6u32;
    }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "filesystem.directory_read_v1") {
        if Index == 0u32 { return 5u32; }
        return 3u32;
    }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "model.catalog_v1") ||
        Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "model.inference_v1") {
        return 6u32;
    }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "standard_output.write_v1") {
        return 6u32;
    }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "process.argument") {
        return 3u32;
    }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "storage.random_access_v1") {
        if Index == 1u32 { return 8u32; }
        if Index == 2u32 { return 8u32; }
        if Index == 4u32 { return 6u32; }
        return 3u32;
    }
    return 5u32;
}

export fn Compilerˉsourceˉwirˉcapabilityˉreturnˉshape(
    Source: bytes,
    Offset: u32,
    Length: u32
) -> u32 {
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "file.read_bytes") { return 6u32; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "filesystem.directory_read_v1") { return 6u32; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "model.catalog_v1") { return 6u32; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "model.inference_v1") { return 6u32; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "process.argument") { return 5u32; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "process.argument_count") { return 3u32; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "standard_output.write_v1") { return 6u32; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "storage.random_access_v1") { return 6u32; }
    return 0u32;
}

export fn Compilerˉsourceˉwirˉdataˉkind(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Match: Sourceˉbindings.Compilerˉsourceˉbindingˉmatch
) -> Compilerˉsourceˉwirˉdataˉkind {
    if !Match.Found { return Compilerˉsourceˉwirˉdataˉkind.None; }
    let Entry: u32 = 16u32 + Match.Directoryˉentry * 24u32;
    let Declarationˉoffset: u32 = Bytesˉreadˉu32ˉlittle(Symbols.Directory, Entry + 8u32);
    let View: Sourceˉset.Compilerˉsourceˉsetˉview = Sourceˉset.Compilerˉsourceˉsetˉmodule(Input, Scan, Match.Module);
    let Declarationˉposition: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
        View.Source, 0u32, 1u32, 1u32, Declarationˉoffset
    );
    let Declaration: Sourceˉdeclarations.Compilerˉsourceˉdeclaration = Sourceˉdeclarations.Compilerˉparseˉnextˉdeclarationˉvalidated(
        View.Source, Declarationˉoffset,
        Declarationˉposition.Line, Declarationˉposition.Column, true
    );
    let Nameˉposition: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
        View.Source, Declarationˉoffset,
        Declarationˉposition.Line, Declarationˉposition.Column,
        Declaration.Nameˉoffset
    );
    let Name: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
        View.Source, Declaration.Nameˉoffset, Nameˉposition.Line, Nameˉposition.Column
    );
    let Colon: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(View.Source, Name.Nextˉoffset, Name.Nextˉline, Name.Nextˉcolumn);
    let Type: Sourceˉdeclarations.Compilerˉparseˉstep = Sourceˉdeclarations.Compilerˉparseˉtype(
        View.Source, Colon.Nextˉoffset, Colon.Nextˉline, Colon.Nextˉcolumn, false, true
    );
    if Type.Typeˉkind == Sourceˉdeclarations.Compilerˉsourceˉtypeˉkind.I32ˉarray {
        return Compilerˉsourceˉwirˉdataˉkind.I32ˉarray;
    }
    if Type.Typeˉkind == Sourceˉdeclarations.Compilerˉsourceˉtypeˉkind.Text {
        return Compilerˉsourceˉwirˉdataˉkind.Text;
    }
    if Type.Typeˉkind == Sourceˉdeclarations.Compilerˉsourceˉtypeˉkind.Bytes {
        return Compilerˉsourceˉwirˉdataˉkind.Bytes;
    }
    return Compilerˉsourceˉwirˉdataˉkind.None;
}

export fn Compilerˉsourceˉwirˉfunctionˉsignatureˉconcrete(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Module: u32,
    Source: bytes,
    Declarationˉoffset: u32,
    Argument: u32,
    Catalog: Sourceˉgenerics.Compilerˉsourceˉgenericˉcatalog,
    Typeˉcatalog: Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog,
    Genericˉinstance: u32
) -> Compilerˉsourceˉwirˉsignature {
    // This reader returns shapes rather than source diagnostics. Starting the
    // target declaration at a relative position preserves token offsets while
    // avoiding a scan from the beginning of its module for every call argument.
    let Declarationˉposition: Sourceˉbodies.Compilerˉsourceˉposition =
        Sourceˉbodies.Compilerˉsourceˉposition(
            Declarationˉoffset, 1u32, 1u32
        );
    let Declaration: Sourceˉdeclarations.Compilerˉsourceˉdeclaration =
        Sourceˉdeclarations.Compilerˉparseˉnextˉdeclarationˉvalidated(
            Source, Declarationˉoffset,
            Declarationˉposition.Line, Declarationˉposition.Column, true
        );
    let Generic: Sourceˉsymbols.Compilerˉsourceˉfunctionˉgeneric =
        Sourceˉsymbols.Compilerˉsourceˉsymbolsˉfunctionˉgeneric(
            Source, Declaration,
            Declarationˉposition.Line, Declarationˉposition.Column
        );
    let Left: Sourceˉlexer.Compilerˉsourceˉtoken =
        Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Source, Generic.Signatureˉoffset,
            Generic.Signatureˉline, Generic.Signatureˉcolumn
        );
    var Cursor: u32 = Left.Nextˉoffset;
    var Currentˉline: u32 = Left.Nextˉline;
    var Currentˉcolumn: u32 = Left.Nextˉcolumn;
    var Parameterˉshape: u32 = 0u32;
    var Index: u32 = 0u32;
    var Reading: bool = true;
    while Reading {
        let Current: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Source, Cursor, Currentˉline, Currentˉcolumn
        );
        if Current.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Rightˉparenthesis {
            Reading = false;
            Cursor = Current.Nextˉoffset;
            Currentˉline = Current.Nextˉline;
            Currentˉcolumn = Current.Nextˉcolumn;
        } else {
            let Colon: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                Source, Current.Nextˉoffset, Current.Nextˉline, Current.Nextˉcolumn
            );
            let Type: Sourceˉsymbols.Compilerˉsourceˉconcreteˉtype =
                Sourceˉsymbols.Compilerˉsourceˉsymbolsˉbindˉconcreteˉfunctionˉtype(
                    Input, Scan, Symbols.Directory, Symbols.Lookup,
                    Symbols.Visibility, Module, Source,
                    Colon.Nextˉoffset, Colon.Nextˉline, Colon.Nextˉcolumn,
                    Symbols.Records, Symbols.Enums, Generic,
                    Catalog, Genericˉinstance, Generic.Parameters == 0u32
                );
            var Typeˉshape: u32 = Type.Shape;
            var Typeˉnextˉoffset: u32 = Type.Nextˉoffset;
            var Typeˉnextˉline: u32 = Type.Nextˉline;
            var Typeˉnextˉcolumn: u32 = Type.Nextˉcolumn;
            if Type.Status ==
                    Sourceˉsymbols.Compilerˉsourceˉsymbolˉstatus.Unknownˉtype &&
                Generic.Parameters == 0u32 {
                let General:
                    Genericˉtypeˉbinding.Compilerˉsourceˉgenericˉtypeˉbinding =
                    Genericˉtypeˉbinding.Compilerˉsourceˉgenericˉtypeˉbind(
                        Input, Scan, Symbols, Module, Source,
                        Colon.Nextˉoffset, Colon.Nextˉline, Colon.Nextˉcolumn,
                        Typeˉcatalog
                    );
                Typeˉshape = General.Shape;
                Typeˉnextˉoffset = General.Nextˉoffset;
                Typeˉnextˉline = General.Nextˉline;
                Typeˉnextˉcolumn = General.Nextˉcolumn;
            }
            if Type.Status ==
                    Sourceˉsymbols.Compilerˉsourceˉsymbolˉstatus.Unknownˉtype &&
                Generic.Parameters > 0u32 &&
                Genericˉinstance != Compilerˉsourceˉwirˉsentinel() {
                let Specialized:
                    Genericˉtypeˉbinding.Compilerˉsourceˉgenericˉtypeˉbinding =
                    Genericˉtypeˉbinding.Compilerˉsourceˉgenericˉtypeˉbindˉfunctionˉspecialization(
                        Input, Scan, Symbols, Module, Source,
                        Colon.Nextˉoffset, Colon.Nextˉline, Colon.Nextˉcolumn,
                        Typeˉcatalog, Source, Generic, Catalog, Genericˉinstance
                    );
                Typeˉshape = Specialized.Shape;
                Typeˉnextˉoffset = Specialized.Nextˉoffset;
                Typeˉnextˉline = Specialized.Nextˉline;
                Typeˉnextˉcolumn = Specialized.Nextˉcolumn;
            }
            if Index == Argument {
                Parameterˉshape = Typeˉshape;
            }
            let Separator: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                Source, Typeˉnextˉoffset, Typeˉnextˉline, Typeˉnextˉcolumn
            );
            if Separator.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Comma {
                Cursor = Separator.Nextˉoffset;
                Currentˉline = Separator.Nextˉline;
                Currentˉcolumn = Separator.Nextˉcolumn;
            } else {
                Cursor = Separator.Nextˉoffset;
                Currentˉline = Separator.Nextˉline;
                Currentˉcolumn = Separator.Nextˉcolumn;
                Reading = false;
            }
            Index = Index + 1u32;
        }
    }
    let Arrow: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
        Source, Cursor, Currentˉline, Currentˉcolumn
    );
    let Returnˉtype: Sourceˉsymbols.Compilerˉsourceˉconcreteˉtype =
        Sourceˉsymbols.Compilerˉsourceˉsymbolsˉbindˉconcreteˉfunctionˉtype(
            Input, Scan, Symbols.Directory, Symbols.Lookup,
            Symbols.Visibility, Module, Source,
            Arrow.Nextˉoffset, Arrow.Nextˉline, Arrow.Nextˉcolumn,
            Symbols.Records, Symbols.Enums, Generic,
            Catalog, Genericˉinstance, Generic.Parameters == 0u32
        );
    var Returnˉshape: u32 = Returnˉtype.Shape;
    if Returnˉtype.Status ==
            Sourceˉsymbols.Compilerˉsourceˉsymbolˉstatus.Unknownˉtype &&
        Generic.Parameters == 0u32 {
        let Generalˉreturn:
            Genericˉtypeˉbinding.Compilerˉsourceˉgenericˉtypeˉbinding =
            Genericˉtypeˉbinding.Compilerˉsourceˉgenericˉtypeˉbind(
                Input, Scan, Symbols, Module, Source,
                Arrow.Nextˉoffset, Arrow.Nextˉline, Arrow.Nextˉcolumn,
                Typeˉcatalog
            );
        Returnˉshape = Generalˉreturn.Shape;
    }
    if Returnˉtype.Status ==
            Sourceˉsymbols.Compilerˉsourceˉsymbolˉstatus.Unknownˉtype &&
        Generic.Parameters > 0u32 &&
        Genericˉinstance != Compilerˉsourceˉwirˉsentinel() {
        let Specializedˉreturn:
            Genericˉtypeˉbinding.Compilerˉsourceˉgenericˉtypeˉbinding =
            Genericˉtypeˉbinding.Compilerˉsourceˉgenericˉtypeˉbindˉfunctionˉspecialization(
                Input, Scan, Symbols, Module, Source,
                Arrow.Nextˉoffset, Arrow.Nextˉline, Arrow.Nextˉcolumn,
                Typeˉcatalog, Source, Generic, Catalog, Genericˉinstance
            );
        Returnˉshape = Specializedˉreturn.Shape;
    }
    return Compilerˉsourceˉwirˉsignature(
        Parameterˉshape, Returnˉshape, 0u32, 0u32
    );
}

export fn Compilerˉsourceˉwirˉfunctionˉsignature(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Module: u32,
    Source: bytes,
    Declarationˉoffset: u32,
    Argument: u32
) -> Compilerˉsourceˉwirˉsignature {
    return Compilerˉsourceˉwirˉfunctionˉsignatureˉconcrete(
        Input, Scan, Symbols, Module, Source, Declarationˉoffset, Argument,
        Sourceˉgenerics.Compilerˉsourceˉgenericˉcatalogˉempty(),
        Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalogˉempty(),
        Compilerˉsourceˉwirˉsentinel()
    );
}

export fn Compilerˉsourceˉwirˉrecordˉsignature(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Callable: Sourceˉbindings.Compilerˉsourceˉbindingˉmatch,
    Argument: u32
) -> Compilerˉsourceˉwirˉsignature {
    let Entry: u32 = 16u32 + Callable.Directoryˉentry * 24u32;
    let Declarationˉoffset: u32 = Bytesˉreadˉu32ˉlittle(Symbols.Directory, Entry + 8u32);
    let Nameˉoffset: u32 = Bytesˉreadˉu32ˉlittle(Symbols.Directory, Entry + 12u32);
    let Nameˉlength: u32 = Bytesˉreadˉu32ˉlittle(Symbols.Directory, Entry + 16u32);
    let View: Sourceˉset.Compilerˉsourceˉsetˉview = Sourceˉset.Compilerˉsourceˉsetˉmodule(Input, Scan, Callable.Module);
    let Directoryˉentries: u32 = Bytesˉreadˉu32ˉlittle(Symbols.Directory, 8u32);
    let Nominals: u32 = Symbols.Records + Symbols.Enums + Symbols.Variants;
    let Nominalˉindex: u32 = Bytesˉreadˉu32ˉlittle(
        Symbols.Lookup,
        4112u32 + Directoryˉentries * 4u32 + Nominals * 4u32 + Callable.Directoryˉentry * 4u32
    );
    let Declarationˉposition: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
        View.Source, 0u32, 1u32, 1u32, Declarationˉoffset
    );
    let Declaration: Sourceˉdeclarations.Compilerˉsourceˉdeclaration = Sourceˉdeclarations.Compilerˉparseˉnextˉdeclarationˉvalidated(
        View.Source, Declarationˉoffset,
        Declarationˉposition.Line, Declarationˉposition.Column, true
    );
    let Bodyˉposition: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
        View.Source, Declarationˉoffset,
        Declarationˉposition.Line, Declarationˉposition.Column,
        Declaration.Bodyˉoffset
    );
    let Left: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
        View.Source, Declaration.Bodyˉoffset, Bodyˉposition.Line, Bodyˉposition.Column
    );
    var Cursor: u32 = Left.Nextˉoffset;
    var Currentˉline: u32 = Left.Nextˉline;
    var Currentˉcolumn: u32 = Left.Nextˉcolumn;
    var Parameterˉshape: u32 = 0u32;
    var Index: u32 = 0u32;
    while Index <= Argument {
        let Field: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            View.Source, Cursor, Currentˉline, Currentˉcolumn
        );
        let Colon: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            View.Source, Field.Nextˉoffset, Field.Nextˉline, Field.Nextˉcolumn
        );
        let Type: Sourceˉsymbols.Compilerˉsourceˉtypeˉbinding = Sourceˉsymbols.Compilerˉsourceˉsymbolsˉbindˉtype(
            Input, Scan, Symbols.Directory, Symbols.Lookup, Symbols.Visibility,
            Callable.Module, View.Source,
            Colon.Nextˉoffset, Colon.Nextˉline, Colon.Nextˉcolumn,
            Symbols.Records, Symbols.Enums, true
        );
        if Index == Argument {
            Parameterˉshape = Sourceˉbindings.Compilerˉsourceˉbindingsˉshape(Type);
        }
        let End: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            View.Source, Type.Nextˉoffset, Type.Nextˉline, Type.Nextˉcolumn
        );
        Cursor = End.Nextˉoffset;
        Currentˉline = End.Nextˉline;
        Currentˉcolumn = End.Nextˉcolumn;
        Index = Index + 1u32;
    }
    return Compilerˉsourceˉwirˉsignature(
        Parameterˉshape,
        65536u32 + Nominalˉindex,
        Nominalˉindex,
        Callable.Directoryˉentry
    );
}

export fn Compilerˉsourceˉwirˉcallableˉsignatureˉconcrete(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Callable: Sourceˉbindings.Compilerˉsourceˉbindingˉmatch,
    Nameˉsource: bytes,
    Nameˉoffset: u32,
    Nameˉlength: u32,
    Argument: u32,
    Catalog: Sourceˉgenerics.Compilerˉsourceˉgenericˉcatalog,
    Typeˉcatalog: Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog,
    Genericˉinstance: u32
) -> Compilerˉsourceˉwirˉsignature {
    if Callable.Kind == Sourceˉbindings.Compilerˉsourceˉcallableˉkind.Intrinsic {
        return Compilerˉsourceˉwirˉsignature(
            Compilerˉsourceˉwirˉintrinsicˉparameterˉshape(
                Nameˉsource, Nameˉoffset, Nameˉlength, Argument
            ),
            Compilerˉsourceˉwirˉintrinsicˉreturnˉshape(
                Nameˉsource, Nameˉoffset, Nameˉlength
            ),
            Compilerˉsourceˉwirˉsentinel(),
            0u32
        );
    }
    if Callable.Kind == Sourceˉbindings.Compilerˉsourceˉcallableˉkind.Capability {
        let Capabilityˉentry: u32 = 16u32 + Callable.Directoryˉentry * 24u32;
        let Capabilityˉview: Sourceˉset.Compilerˉsourceˉsetˉview = Sourceˉset.Compilerˉsourceˉsetˉmodule(
            Input, Scan, Callable.Module
        );
        let Capabilityˉnameˉoffset: u32 = Bytesˉreadˉu32ˉlittle(
            Symbols.Directory, Capabilityˉentry + 12u32
        );
        let Capabilityˉnameˉlength: u32 = Bytesˉreadˉu32ˉlittle(
            Symbols.Directory, Capabilityˉentry + 16u32
        );
        return Compilerˉsourceˉwirˉsignature(
            Compilerˉsourceˉwirˉcapabilityˉparameterˉshape(
                Capabilityˉview.Source,
                Capabilityˉnameˉoffset,
                Capabilityˉnameˉlength,
                Argument
            ),
            Compilerˉsourceˉwirˉcapabilityˉreturnˉshape(
                Capabilityˉview.Source,
                Capabilityˉnameˉoffset,
                Capabilityˉnameˉlength
            ),
            Callable.Directoryˉentry,
            0u32
        );
    }
    if Callable.Kind == Sourceˉbindings.Compilerˉsourceˉcallableˉkind.Record {
        return Compilerˉsourceˉwirˉrecordˉsignature(
            Input, Scan, Symbols, Callable, Argument
        );
    }
    if Callable.Kind == Sourceˉbindings.Compilerˉsourceˉcallableˉkind.Variantˉcase {
        let Nominal: Sourceˉsymbols.Compilerˉsourceˉsymbolˉmatch = Sourceˉsymbols.Compilerˉsourceˉsymbolsˉdirectoryˉentry(
            Symbols.Directory, Scan.Modules, Callable.Directoryˉentry
        );
        var Lastˉdot: u32 = Nameˉlength;
        var Character: u32 = 0u32;
        while Character < Nameˉlength {
            if Bytesˉreadˉu8(Nameˉsource, Nameˉoffset + Character) == 46u8 { Lastˉdot = Character; }
            Character = Character + 1u32;
        }
        let Member: Compilerˉsourceˉwirˉmember = Compilerˉsourceˉwirˉnominalˉmember(
            Input, Scan, Symbols, Nominal,
            Nameˉsource, Nameˉoffset + Lastˉdot + 1u32, Nameˉlength - Lastˉdot - 1u32
        );
        let Entries: u32 = Bytesˉreadˉu32ˉlittle(Symbols.Directory, 8u32);
        let Nominals: u32 = Symbols.Records + Symbols.Enums + Symbols.Variants;
        let Nominalˉindex: u32 = Bytesˉreadˉu32ˉlittle(
            Symbols.Lookup,
            4112u32 + Entries * 4u32 + Nominals * 4u32 + Callable.Directoryˉentry * 4u32
        );
        let Field: Compilerˉsourceˉwirˉmember =
            Compilerˉsourceˉwirˉvariantˉfieldˉbyˉindex(
                Input, Scan, Symbols, Nominalˉindex, Member.Index, Argument
            );
        var Parameterˉshape: u32 = 0u32;
        if Field.Found { Parameterˉshape = Field.Shape; }
        return Compilerˉsourceˉwirˉsignature(
            Parameterˉshape,
            196608u32 + Nominalˉindex,
            Nominalˉindex,
            Member.Index
        );
    }
    let Entry: u32 = 16u32 + Callable.Directoryˉentry * 24u32;
    let Declarationˉoffset: u32 = Bytesˉreadˉu32ˉlittle(Symbols.Directory, Entry + 8u32);
    let View: Sourceˉset.Compilerˉsourceˉsetˉview = Sourceˉset.Compilerˉsourceˉsetˉmodule(Input, Scan, Callable.Module);
    let Function: Compilerˉsourceˉwirˉsignature = Compilerˉsourceˉwirˉfunctionˉsignatureˉconcrete(
        Input, Scan, Symbols, Callable.Module, View.Source,
        Declarationˉoffset, Argument, Catalog, Typeˉcatalog, Genericˉinstance
    );
    return Compilerˉsourceˉwirˉsignature(
        Function.Parameterˉshape,
        Function.Returnˉshape,
        Callable.Directoryˉentry,
        0u32
    );
}

export fn Compilerˉsourceˉwirˉcallableˉsignature(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Callable: Sourceˉbindings.Compilerˉsourceˉbindingˉmatch,
    Nameˉsource: bytes,
    Nameˉoffset: u32,
    Nameˉlength: u32,
    Argument: u32
) -> Compilerˉsourceˉwirˉsignature {
    return Compilerˉsourceˉwirˉcallableˉsignatureˉconcrete(
        Input, Scan, Symbols, Callable,
        Nameˉsource, Nameˉoffset, Nameˉlength, Argument,
        Sourceˉgenerics.Compilerˉsourceˉgenericˉcatalogˉempty(),
        Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalogˉempty(),
        Compilerˉsourceˉwirˉsentinel()
    );
}

export fn Compilerˉsourceˉwirˉnominalˉbyˉshape(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Shape: u32
) -> Sourceˉsymbols.Compilerˉsourceˉsymbolˉmatch {
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉshapeˉisˉfoundationˉgeneric(Shape) {
        var Genericˉentry: u32 = 0u32;
        let Genericˉentries: u32 = Bytesˉreadˉu32ˉlittle(Symbols.Directory, 8u32);
        var Genericˉfamily: u32 = 1u32;
        if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉshapeˉisˉfoundationˉresult(Shape) {
            Genericˉfamily = 2u32;
        }
        while Genericˉentry < Genericˉentries {
            let Genericˉnominal: Sourceˉsymbols.Compilerˉsourceˉsymbolˉmatch =
                Sourceˉsymbols.Compilerˉsourceˉsymbolsˉdirectoryˉentry(
                    Symbols.Directory, Scan.Modules, Genericˉentry
                );
            if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉfoundationˉgenericˉfamily(
                Input, Scan, Genericˉnominal
            ) == Genericˉfamily {
                return Genericˉnominal;
            }
            Genericˉentry = Genericˉentry + 1u32;
        }
        return Sourceˉsymbols.Compilerˉsourceˉsymbolsˉmatchˉnone(Scan.Modules);
    }
    var Wanted: u32 = Shape - 65536u32;
    if Shape >= 131072u32 { Wanted = Shape - 131072u32; }
    if Shape >= 196608u32 { Wanted = Shape - 196608u32; }
    if Wanted >= Symbols.Records + Symbols.Enums + Symbols.Variants {
        return Sourceˉsymbols.Compilerˉsourceˉsymbolsˉmatchˉnone(Scan.Modules);
    }
    let Entries: u32 = Bytesˉreadˉu32ˉlittle(Symbols.Directory, 8u32);
    let Directoryˉindex: u32 = Bytesˉreadˉu32ˉlittle(
        Symbols.Lookup, 4112u32 + Entries * 4u32 + Wanted * 4u32
    );
    return Sourceˉsymbols.Compilerˉsourceˉsymbolsˉdirectoryˉentry(
        Symbols.Directory, Scan.Modules, Directoryˉindex
    );
}

fn Compilerˉsourceˉwirˉvariantˉtarget(Shape: u32) -> u32 {
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉshapeˉisˉfoundationˉgeneric(Shape) {
        return Shape;
    }
    return Shape - 196608u32;
}

export fn Compilerˉsourceˉwirˉnominalˉmember(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Nominal: Sourceˉsymbols.Compilerˉsourceˉsymbolˉmatch,
    Queryˉsource: bytes,
    Queryˉoffset: u32,
    Queryˉlength: u32
) -> Compilerˉsourceˉwirˉmember {
    if !Nominal.Found { return Compilerˉsourceˉwirˉmember(false, 0u32, 0u32); }
    let View: Sourceˉset.Compilerˉsourceˉsetˉview = Sourceˉset.Compilerˉsourceˉsetˉmodule(Input, Scan, Nominal.Module);
    let Declarationˉposition: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
        View.Source, 0u32, 1u32, 1u32, Nominal.Declarationˉoffset
    );
    let Declaration: Sourceˉdeclarations.Compilerˉsourceˉdeclaration = Sourceˉdeclarations.Compilerˉparseˉnextˉdeclarationˉvalidated(
        View.Source, Nominal.Declarationˉoffset,
        Declarationˉposition.Line, Declarationˉposition.Column, true
    );
    let Bodyˉposition: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
        View.Source, Nominal.Declarationˉoffset,
        Declarationˉposition.Line, Declarationˉposition.Column,
        Declaration.Bodyˉoffset
    );
    let Left: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
        View.Source, Declaration.Bodyˉoffset, Bodyˉposition.Line, Bodyˉposition.Column
    );
    var Cursor: u32 = Left.Nextˉoffset;
    var Currentˉline: u32 = Left.Nextˉline;
    var Currentˉcolumn: u32 = Left.Nextˉcolumn;
    var Index: u32 = 0u32;
    var Reading: bool = true;
    while Reading {
        let Member: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            View.Source, Cursor, Currentˉline, Currentˉcolumn
        );
        if Member.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Rightˉbrace {
            Reading = false;
        } else {
            if Member.Length == Queryˉlength {
                if Sourceˉset.Compilerˉsourceˉspansˉequal(
                    View.Source, Member.Offset, Member.Length,
                    Queryˉsource, Queryˉoffset, Queryˉlength
                ) {
                if Nominal.Kind == Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Enum {
                    let Directoryˉentries: u32 = Bytesˉreadˉu32ˉlittle(Symbols.Directory, 8u32);
                    let Nominals: u32 = Symbols.Records + Symbols.Enums + Symbols.Variants;
                    let Shape: u32 = 131072u32 + Bytesˉreadˉu32ˉlittle(
                        Symbols.Lookup,
                        4112u32 + Directoryˉentries * 4u32 + Nominals * 4u32 +
                            Nominal.Directoryˉindex * 4u32
                    );
                    return Compilerˉsourceˉwirˉmember(true, Index, Shape);
                }
                if Nominal.Kind == Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Variant {
                    let Afterˉname: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                        View.Source, Member.Nextˉoffset, Member.Nextˉline, Member.Nextˉcolumn
                    );
                    if Afterˉname.Kind != Sourceˉlexer.Compilerˉtokenˉkind.Leftˉparenthesis {
                        return Compilerˉsourceˉwirˉmember(true, Index, 0u32);
                    }
                    let Payloadˉname: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                        View.Source, Afterˉname.Nextˉoffset, Afterˉname.Nextˉline, Afterˉname.Nextˉcolumn
                    );
                    let Payloadˉcolon: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                        View.Source, Payloadˉname.Nextˉoffset, Payloadˉname.Nextˉline, Payloadˉname.Nextˉcolumn
                    );
                    let Payloadˉtype: Sourceˉsymbols.Compilerˉsourceˉtypeˉbinding = Sourceˉsymbols.Compilerˉsourceˉsymbolsˉbindˉtype(
                        Input, Scan, Symbols.Directory, Symbols.Lookup, Symbols.Visibility,
                        Nominal.Module, View.Source,
                        Payloadˉcolon.Nextˉoffset, Payloadˉcolon.Nextˉline, Payloadˉcolon.Nextˉcolumn,
                        Symbols.Records, Symbols.Enums, false
                    );
                    return Compilerˉsourceˉwirˉmember(
                        true, Index, Sourceˉbindings.Compilerˉsourceˉbindingsˉshape(Payloadˉtype)
                    );
                }
                let Matchedˉcolon: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                    View.Source, Member.Nextˉoffset, Member.Nextˉline, Member.Nextˉcolumn
                );
                let Matchedˉtype: Sourceˉsymbols.Compilerˉsourceˉtypeˉbinding = Sourceˉsymbols.Compilerˉsourceˉsymbolsˉbindˉtype(
                    Input, Scan, Symbols.Directory, Symbols.Lookup, Symbols.Visibility,
                    Nominal.Module, View.Source,
                    Matchedˉcolon.Nextˉoffset, Matchedˉcolon.Nextˉline, Matchedˉcolon.Nextˉcolumn,
                    Symbols.Records, Symbols.Enums, true
                );
                return Compilerˉsourceˉwirˉmember(
                    true, Index, Sourceˉbindings.Compilerˉsourceˉbindingsˉshape(Matchedˉtype)
                );
                }
            }
            if Nominal.Kind == Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Record {
                let Recordˉcolon: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                    View.Source, Member.Nextˉoffset, Member.Nextˉline, Member.Nextˉcolumn
                );
                let Recordˉtype: Sourceˉdeclarations.Compilerˉparseˉstep = Sourceˉdeclarations.Compilerˉparseˉtype(
                    View.Source, Recordˉcolon.Nextˉoffset, Recordˉcolon.Nextˉline, Recordˉcolon.Nextˉcolumn, false, false
                );
                let Recordˉend: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                    View.Source, Recordˉtype.Nextˉoffset, Recordˉtype.Nextˉline, Recordˉtype.Nextˉcolumn
                );
                Cursor = Recordˉend.Nextˉoffset;
                Currentˉline = Recordˉend.Nextˉline;
                Currentˉcolumn = Recordˉend.Nextˉcolumn;
            } else if Nominal.Kind == Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Enum {
                let Enumˉequals: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                    View.Source, Member.Nextˉoffset, Member.Nextˉline, Member.Nextˉcolumn
                );
                let Enumˉvalue: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                    View.Source, Enumˉequals.Nextˉoffset, Enumˉequals.Nextˉline, Enumˉequals.Nextˉcolumn
                );
                let Enumˉend: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                    View.Source, Enumˉvalue.Nextˉoffset, Enumˉvalue.Nextˉline, Enumˉvalue.Nextˉcolumn
                );
                Cursor = Enumˉend.Nextˉoffset;
                Currentˉline = Enumˉend.Nextˉline;
                Currentˉcolumn = Enumˉend.Nextˉcolumn;
            } else {
                let Variantˉafterˉname: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                    View.Source, Member.Nextˉoffset, Member.Nextˉline, Member.Nextˉcolumn
                );
                var Variantˉend: Sourceˉlexer.Compilerˉsourceˉtoken = Variantˉafterˉname;
                if Variantˉafterˉname.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Leftˉparenthesis {
                    var Fieldˉcursor: u32 = Variantˉafterˉname.Nextˉoffset;
                    var Fieldˉline: u32 = Variantˉafterˉname.Nextˉline;
                    var Fieldˉcolumn: u32 = Variantˉafterˉname.Nextˉcolumn;
                    var Readingˉfields: bool = true;
                    while Readingˉfields {
                        let Field: Sourceˉdeclarations.Compilerˉsourceˉvariantˉfield =
                            Sourceˉdeclarations.Compilerˉparseˉvariantˉfield(
                                View.Source, Fieldˉcursor, Fieldˉline,
                                Fieldˉcolumn
                            );
                        let Separator: Sourceˉlexer.Compilerˉsourceˉtoken =
                            Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                                View.Source, Field.Nextˉoffset,
                                Field.Nextˉline, Field.Nextˉcolumn
                            );
                        if Separator.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Comma {
                            let Memberˉafterˉcomma:
                                Sourceˉlexer.Compilerˉsourceˉtoken =
                                Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                                    View.Source, Separator.Nextˉoffset,
                                    Separator.Nextˉline,
                                    Separator.Nextˉcolumn
                                );
                            if Memberˉafterˉcomma.Kind ==
                                Sourceˉlexer.Compilerˉtokenˉkind.Rightˉparenthesis {
                                Readingˉfields = false;
                                Variantˉend =
                                    Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                                        View.Source,
                                        Memberˉafterˉcomma.Nextˉoffset,
                                        Memberˉafterˉcomma.Nextˉline,
                                        Memberˉafterˉcomma.Nextˉcolumn
                                    );
                            } else {
                                Fieldˉcursor = Separator.Nextˉoffset;
                                Fieldˉline = Separator.Nextˉline;
                                Fieldˉcolumn = Separator.Nextˉcolumn;
                            }
                        } else {
                            Readingˉfields = false;
                            Variantˉend = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                                View.Source, Separator.Nextˉoffset,
                                Separator.Nextˉline, Separator.Nextˉcolumn
                            );
                        }
                    }
                }
                Cursor = Variantˉend.Nextˉoffset;
                Currentˉline = Variantˉend.Nextˉline;
                Currentˉcolumn = Variantˉend.Nextˉcolumn;
            }
            Index = Index + 1u32;
        }
    }
    return Compilerˉsourceˉwirˉmember(false, 0u32, 0u32);
}

export fn Compilerˉsourceˉwirˉfailureˉvalue(
    Build: Compilerˉsourceˉwirˉbuild,
    Status: Compilerˉsourceˉwirˉstatus,
    Relatedˉmodule: u32,
    Offset: u32,
    Line: u32,
    Column: u32
) -> Compilerˉsourceˉwirˉvalue {
    let Failed: Compilerˉsourceˉwirˉbuild = Compilerˉsourceˉwirˉbuildˉfailure(
        Build,
        Status,
        Build.Currentˉmodule,
        Relatedˉmodule,
        Build.Currentˉfunction,
        Offset,
        Line,
        Column
    );
    return Compilerˉsourceˉwirˉvalueˉfrom(
        Failed, 0u32, Compilerˉsourceˉwirˉsentinel()
    );
}

export fn Compilerˉsourceˉwirˉcompileˉname(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Bindingˉpayload: bytes,
    Bindingˉfirst: u32,
    Bindingˉentries: u32,
    Source: bytes,
    Expression: Sourceˉbodies.Compilerˉsourceˉexpression,
    Build: Compilerˉsourceˉwirˉbuild
) -> Compilerˉsourceˉwirˉvalue {
    let Local: Sourceˉbindings.Compilerˉsourceˉlocalˉmatch = Sourceˉbindings.Compilerˉsourceˉbindingsˉfindˉlocal(
        Source, Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
        Expression.Valueˉoffset, Expression.Valueˉlength, Expression.Offset
    );
    if Local.Found {
        return Compilerˉsourceˉwirˉemit(
            Build,
            WIR_OPERATION_LOAD_LOCAL,
            Local.Shape,
            Compilerˉsourceˉwirˉempty(Source),
            Local.Slot,
            0u32,
            Expression.Offset,
            Expression.Length
        );
    }
    let Constant: Sourceˉbindings.Compilerˉsourceˉbindingˉmatch = Sourceˉbindings.Compilerˉsourceˉbindingsˉfindˉdeclaration(
        Input, Scan, Symbols, Build.Currentˉmodule, Source,
        Expression.Valueˉoffset, Expression.Valueˉlength,
        Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Constant
    );
    if Constant.Found {
        if !Constant.Accessible {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Build, Compilerˉsourceˉwirˉstatus.Invalidˉconstant,
                Constant.Module, Expression.Offset, Expression.Line, Expression.Column
            );
        }
        let View: Sourceˉset.Compilerˉsourceˉsetˉview = Sourceˉset.Compilerˉsourceˉsetˉmodule(
            Input, Scan, Constant.Module
        );
        let Entry: u32 = 16u32 + Constant.Directoryˉentry * 24u32;
        let Declarationˉoffset: u32 = Bytesˉreadˉu32ˉlittle(
            Symbols.Directory, Entry + 8u32
        );
        let Position: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
            View.Source, 0u32, 1u32, 1u32, Declarationˉoffset
        );
        let Declaration: Sourceˉdeclarations.Compilerˉsourceˉdeclaration = Sourceˉdeclarations.Compilerˉparseˉnextˉdeclarationˉvalidated(
            View.Source,
            Declarationˉoffset,
            Position.Line,
            Position.Column,
            true
        );
        let Value: Sourceˉsymbols.Compilerˉsourceˉconstantˉvalue =
            Sourceˉsymbols.Compilerˉsourceˉsymbolsˉconstantˉevaluateˉdeclaration(
                Input, Scan, Symbols, Constant.Module, View.Source,
                Declaration, Position.Line, Position.Column, 0u32
            );
        if Value.Status != Sourceˉsymbols.Compilerˉsourceˉsymbolˉstatus.Valid {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Build, Compilerˉsourceˉwirˉstatus.Invalidˉconstant,
                Value.Failureˉmodule,
                Value.Failureˉoffset, Value.Failureˉline, Value.Failureˉcolumn
            );
        }
        var Operation: u32 =
            WIR_OPERATION_I32_CONSTANT;
        var Target: u32 = Value.Magnitude;
        var Auxiliary: u32 = Value.High;
        if Value.Shape == 1u32 {
            if Value.Negative {
                Target = 4294967295u32 - Value.Magnitude + 1u32;
            }
        }
        if Value.Shape == 2u32 {
            Operation = WIR_OPERATION_U8_CONSTANT;
        }
        if Value.Shape == 3u32 {
            Operation = WIR_OPERATION_U32_CONSTANT;
        }
        if Value.Shape == 7u32 {
            Operation = WIR_OPERATION_I64_CONSTANT;
            if Value.Negative {
                if Target == 0u32 {
                    Auxiliary = 4294967295u32 - Auxiliary + 1u32;
                } else {
                    Target = 4294967295u32 - Target + 1u32;
                    Auxiliary = 4294967295u32 - Auxiliary;
                }
            }
        }
        if Value.Shape == 8u32 {
            Operation = WIR_OPERATION_U64_CONSTANT;
        }
        if Value.Shape == 11u32 || Value.Shape == 12u32 {
            Operation = WIR_OPERATION_FIXED_INTEGER_CONSTANT;
            if Value.Negative {
                if Value.Shape == 11u32 {
                    Target = 256u32 - Value.Magnitude;
                } else {
                    Target = 65536u32 - Value.Magnitude;
                }
            }
        }
        if Value.Shape == 13u32 {
            Operation = WIR_OPERATION_FIXED_INTEGER_CONSTANT;
        }
        if Value.Shape == 16u32 {
            Operation = WIR_OPERATION_RUNE_CONSTANT;
        }
        if Value.Shape == 14u32 || Value.Shape == 15u32 {
            Operation = WIR_OPERATION_FLOATING_CONSTANT;
        }
        if Value.Shape == 4u32 {
            Operation = WIR_OPERATION_BOOL_CONSTANT;
        }
        if Value.Shape >= 131072u32 + Symbols.Records {
            if Value.Shape < 131072u32 + Symbols.Records + Symbols.Enums {
            Operation = WIR_OPERATION_ENUM_CONSTANT;
            Target = Value.Shape - 131072u32;
            Auxiliary = Value.Magnitude;
            }
        }
        return Compilerˉsourceˉwirˉemit(
            Build, Operation, Value.Shape,
            Compilerˉsourceˉwirˉempty(Source), Target, Auxiliary,
            Expression.Offset, Expression.Length
        );
    }
    let Capability: Sourceˉbindings.Compilerˉsourceˉbindingˉmatch = Sourceˉbindings.Compilerˉsourceˉbindingsˉfindˉcallable(
        Input, Scan, Symbols, 0u32, Source,
        Expression.Valueˉoffset, Expression.Valueˉlength
    );
    if Capability.Kind == Sourceˉbindings.Compilerˉsourceˉcallableˉkind.Capability {
        return Compilerˉsourceˉwirˉemit(
            Build,
            WIR_OPERATION_U32_CONSTANT,
            268435456u32 + Capability.Directoryˉentry,
            Compilerˉsourceˉwirˉempty(Source),
            0u32,
            0u32,
            Expression.Offset,
            Expression.Length
        );
    }
    let Data: Sourceˉbindings.Compilerˉsourceˉbindingˉmatch = Sourceˉbindings.Compilerˉsourceˉbindingsˉfindˉdeclaration(
        Input, Scan, Symbols, Build.Currentˉmodule, Source,
        Expression.Valueˉoffset, Expression.Valueˉlength,
        Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Data
    );
    if !Data.Found || !Data.Accessible {
        return Compilerˉsourceˉwirˉfailureˉvalue(
            Build, Compilerˉsourceˉwirˉstatus.Invalidˉdataˉuse,
            Data.Module, Expression.Offset, Expression.Line, Expression.Column
        );
    }
    let Kind: Compilerˉsourceˉwirˉdataˉkind = Compilerˉsourceˉwirˉdataˉkind(
        Input, Scan, Symbols, Data
    );
    if Kind == Compilerˉsourceˉwirˉdataˉkind.Text {
        return Compilerˉsourceˉwirˉemit(
            Build, WIR_OPERATION_TEXT_CONSTANT, 5u32,
            Compilerˉsourceˉwirˉempty(Source), Data.Directoryˉentry, 0u32,
            Expression.Offset, Expression.Length
        );
    }
    if Kind == Compilerˉsourceˉwirˉdataˉkind.Bytes {
        return Compilerˉsourceˉwirˉemit(
            Build, WIR_OPERATION_BYTES_CONSTANT, 6u32,
            Compilerˉsourceˉwirˉempty(Source), Data.Directoryˉentry, 0u32,
            Expression.Offset, Expression.Length
        );
    }
    return Compilerˉsourceˉwirˉfailureˉvalue(
        Build,
        Compilerˉsourceˉwirˉstatus.Invalidˉdataˉuse,
        Data.Module,
        Expression.Offset,
        Expression.Line,
        Expression.Column
    );
}

fn Compilerˉsourceˉwirˉbindˉgenericˉtype(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Source: bytes,
    Offset: u32,
    Line: u32,
    Column: u32,
    Build: Compilerˉsourceˉwirˉbuild
) -> Genericˉtypeˉbinding.Compilerˉsourceˉgenericˉtypeˉbinding {
    let Typeˉcatalog: Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog =
        Compilerˉsourceˉwirˉgenericˉtypeˉcatalog(Build.Genericˉevidence);
    if Build.Genericˉinstance == Compilerˉsourceˉwirˉsentinel() {
        return Genericˉtypeˉbinding.Compilerˉsourceˉgenericˉtypeˉbind(
            Input, Scan, Symbols, Build.Currentˉmodule, Source,
            Offset, Line, Column, Typeˉcatalog
        );
    }
    let Functionˉcatalog: Sourceˉgenerics.Compilerˉsourceˉgenericˉcatalog =
        Compilerˉsourceˉwirˉgenericˉcatalog(Build.Genericˉevidence);
    let Declarationˉentry: u32 =
        Sourceˉgenerics.Compilerˉsourceˉgenericˉcatalogˉinstanceˉdeclaration(
            Functionˉcatalog, Build.Genericˉinstance
        );
    let Symbolˉentries: u32 = Bytesˉreadˉu32ˉlittle(Symbols.Directory, 8u32);
    if Declarationˉentry >= Symbolˉentries {
        return Genericˉtypeˉbinding.Compilerˉsourceˉgenericˉtypeˉbind(
            Input, Scan, Symbols, Build.Currentˉmodule, Source,
            Offset, Line, Column, Typeˉcatalog
        );
    }
    let Symbolˉentry: u32 = 16u32 + Declarationˉentry * 24u32;
    let Formalˉmodule: u32 = Bytesˉreadˉu32ˉlittle(
        Symbols.Directory, Symbolˉentry
    );
    let Formalˉdeclarationˉoffset: u32 = Bytesˉreadˉu32ˉlittle(
        Symbols.Directory, Symbolˉentry + 8u32
    );
    let Formalˉview: Sourceˉset.Compilerˉsourceˉsetˉview =
        Sourceˉset.Compilerˉsourceˉsetˉmodule(Input, Scan, Formalˉmodule);
    let Formalˉdeclaration:
        Sourceˉdeclarations.Compilerˉsourceˉdeclaration =
        Sourceˉdeclarations.Compilerˉparseˉnextˉdeclarationˉvalidated(
            Formalˉview.Source, Formalˉdeclarationˉoffset,
            1u32, 1u32, true
        );
    let Formalˉgeneric: Sourceˉsymbols.Compilerˉsourceˉfunctionˉgeneric =
        Sourceˉsymbols.Compilerˉsourceˉsymbolsˉfunctionˉgeneric(
            Formalˉview.Source, Formalˉdeclaration, 1u32, 1u32
        );
    return Genericˉtypeˉbinding.Compilerˉsourceˉgenericˉtypeˉbindˉfunctionˉspecialization(
        Input, Scan, Symbols, Build.Currentˉmodule, Source,
        Offset, Line, Column, Typeˉcatalog,
        Formalˉview.Source, Formalˉgeneric,
        Functionˉcatalog, Build.Genericˉinstance
    );
}

fn Compilerˉsourceˉwirˉrecordˉfieldˉbyˉshape(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Typeˉcatalog: Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog,
    Shape: u32,
    Queryˉsource: bytes,
    Queryˉoffset: u32,
    Queryˉlength: u32
) -> Compilerˉsourceˉwirˉmember {
    if Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉshapeˉisˉprivate(Shape) {
        let Instance: u32 =
            Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉshapeˉinstance(Shape);
        let Layout: Genericˉlayouts.Compilerˉsourceˉgenericˉtypeˉlayout =
            Genericˉlayouts.Compilerˉsourceˉgenericˉtypeˉlayoutˉcreate(
                Input, Scan, Symbols, Typeˉcatalog, Instance
            );
        if Layout.Kind !=
                Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Record ||
            Layout.Fields > 64u32 ||
            Bytesˉlength(Layout.Fieldˉevidence) != Layout.Fields * 16u32 ||
            !Genericˉlayouts.Compilerˉsourceˉgenericˉtypeˉlayoutˉisˉvalid(
                Input, Scan, Symbols, Layout
            ) {
            return Compilerˉsourceˉwirˉmember(false, 0u32, 0u32);
        }
        let View: Sourceˉset.Compilerˉsourceˉsetˉview =
            Sourceˉset.Compilerˉsourceˉsetˉmodule(
                Input, Scan, Layout.Module
            );
        var Field: u32 = 0u32;
        while Field < Layout.Fields {
            let Entry: u32 = Field * 16u32;
            let Nameˉoffset: u32 = Bytesˉreadˉu32ˉlittle(
                Layout.Fieldˉevidence, Entry
            );
            let Nameˉlength: u32 = Bytesˉreadˉu32ˉlittle(
                Layout.Fieldˉevidence, Entry + 4u32
            );
            if Sourceˉset.Compilerˉsourceˉspansˉequal(
                    View.Source, Nameˉoffset, Nameˉlength,
                    Queryˉsource, Queryˉoffset, Queryˉlength
                ) {
                return Compilerˉsourceˉwirˉmember(
                    true, Field,
                    Bytesˉreadˉu32ˉlittle(
                        Layout.Fieldˉevidence, Entry + 8u32
                    )
                );
            }
            Field = Field + 1u32;
        }
        return Compilerˉsourceˉwirˉmember(false, 0u32, 0u32);
    }
    if Shape < 65536u32 || Shape >= 131072u32 {
        return Compilerˉsourceˉwirˉmember(false, 0u32, 0u32);
    }
    let Nominal: Sourceˉsymbols.Compilerˉsourceˉsymbolˉmatch =
        Compilerˉsourceˉwirˉnominalˉbyˉshape(
            Input, Scan, Symbols, Shape
        );
    return Compilerˉsourceˉwirˉnominalˉmember(
        Input, Scan, Symbols, Nominal,
        Queryˉsource, Queryˉoffset, Queryˉlength
    );
}

fn Compilerˉsourceˉwirˉcompileˉrecordˉpath(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Source: bytes,
    Expression: Sourceˉbodies.Compilerˉsourceˉexpression,
    Base: Compilerˉsourceˉwirˉvalue,
    Cursor: u32,
    Line: u32,
    Column: u32
) -> Compilerˉsourceˉwirˉvalue {
    var Result: Compilerˉsourceˉwirˉvalue = Base;
    var Pathˉcursor: u32 = Cursor;
    var Pathˉline: u32 = Line;
    var Pathˉcolumn: u32 = Column;
    let Pathˉend: u32 = Expression.Valueˉoffset + Expression.Valueˉlength;
    let Typeˉcatalog: Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog =
        Compilerˉsourceˉwirˉgenericˉtypeˉcatalog(Result.Genericˉevidence);
    while Pathˉcursor < Pathˉend {
        let Dot: Sourceˉlexer.Compilerˉsourceˉtoken =
            Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                Source, Pathˉcursor, Pathˉline, Pathˉcolumn
            );
        let Member: Sourceˉlexer.Compilerˉsourceˉtoken =
            Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                Source, Dot.Nextˉoffset, Dot.Nextˉline, Dot.Nextˉcolumn
            );
        var Isˉrecord: bool =
            Result.Shape >= 65536u32 && Result.Shape < 131072u32;
        if Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉshapeˉisˉprivate(
                Result.Shape
            ) {
            let Instance: u32 =
                Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉshapeˉinstance(
                    Result.Shape
                );
            Isˉrecord = Instance <
                Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalogˉinstances(
                    Typeˉcatalog
                ) &&
                Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalogˉinstanceˉkind(
                    Typeˉcatalog, Instance
                ) == 4u32;
        }
        if !Isˉrecord {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Compilerˉsourceˉwirˉvalueˉbuild(Result),
                Compilerˉsourceˉwirˉstatus.Invalidˉfieldˉtarget,
                Result.Currentˉmodule,
                Member.Offset, Member.Line, Member.Column
            );
        }
        let Pathˉfield: Compilerˉsourceˉwirˉmember =
            Compilerˉsourceˉwirˉrecordˉfieldˉbyˉshape(
                Input, Scan, Symbols, Typeˉcatalog, Result.Shape,
                Source, Member.Offset, Member.Length
            );
        if !Pathˉfield.Found {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Compilerˉsourceˉwirˉvalueˉbuild(Result),
                Compilerˉsourceˉwirˉstatus.Unknownˉfield,
                Result.Currentˉmodule,
                Member.Offset,
                Member.Line,
                Member.Column
            );
        }
        var Pathˉtarget: u32 = Result.Shape - 65536u32;
        if Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉshapeˉisˉprivate(
                Result.Shape
            ) {
            Pathˉtarget = Result.Shape;
        }
        Result = Compilerˉsourceˉwirˉemit(
            Compilerˉsourceˉwirˉvalueˉbuild(Result),
            WIR_OPERATION_RECORD_FIELD,
            Pathˉfield.Shape,
            Compilerˉsourceˉwirˉoneˉoperand(Result.Temporary),
            Pathˉtarget,
            Pathˉfield.Index,
            Expression.Offset,
            Expression.Length
        );
        Pathˉcursor = Member.Nextˉoffset;
        Pathˉline = Member.Nextˉline;
        Pathˉcolumn = Member.Nextˉcolumn;
    }
    return Result;
}

export fn Compilerˉsourceˉwirˉcompileˉfield(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Bindingˉpayload: bytes,
    Bindingˉfirst: u32,
    Bindingˉentries: u32,
    Source: bytes,
    Expression: Sourceˉbodies.Compilerˉsourceˉexpression,
    Build: Compilerˉsourceˉwirˉbuild
) -> Compilerˉsourceˉwirˉvalue {
    let Firstˉposition: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
        Source, Expression.Offset, Expression.Line, Expression.Column,
        Expression.Firstˉoffset
    );
    let Position: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
        Source, Expression.Offset, Expression.Line, Expression.Column,
        Expression.Secondˉoffset
    );
    let Local: Sourceˉbindings.Compilerˉsourceˉlocalˉmatch = Sourceˉbindings.Compilerˉsourceˉbindingsˉfindˉlocal(
        Source, Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
        Expression.Firstˉoffset, Expression.Firstˉlength, Expression.Offset
    );
    if Local.Found {
        let Typeˉcatalog:
            Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog =
            Compilerˉsourceˉwirˉgenericˉtypeˉcatalog(Build.Genericˉevidence);
        var Isˉrecord: bool =
            Local.Shape >= 65536u32 && Local.Shape < 131072u32;
        if Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉshapeˉisˉprivate(
                Local.Shape
            ) {
            let Instance: u32 =
                Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉshapeˉinstance(
                    Local.Shape
                );
            Isˉrecord = Instance <
                Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalogˉinstances(
                    Typeˉcatalog
                ) &&
                Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalogˉinstanceˉkind(
                    Typeˉcatalog, Instance
                ) == 4u32;
        }
        if !Isˉrecord {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Build,
                Compilerˉsourceˉwirˉstatus.Invalidˉfieldˉtarget,
                Build.Currentˉmodule,
                Expression.Firstˉoffset,
                Firstˉposition.Line,
                Firstˉposition.Column
            );
        }
        let Field: Compilerˉsourceˉwirˉmember =
            Compilerˉsourceˉwirˉrecordˉfieldˉbyˉshape(
                Input, Scan, Symbols, Typeˉcatalog, Local.Shape,
                Source, Expression.Secondˉoffset, Expression.Secondˉlength
            );
        if !Field.Found {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Build,
                Compilerˉsourceˉwirˉstatus.Unknownˉfield,
                Build.Currentˉmodule,
                Expression.Secondˉoffset,
                Position.Line,
                Position.Column
            );
        }
        var Fieldˉtarget: u32 = Local.Shape - 65536u32;
        if Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉshapeˉisˉprivate(
                Local.Shape
            ) {
            Fieldˉtarget = Local.Shape;
        }
        let Target: Compilerˉsourceˉwirˉvalue = Compilerˉsourceˉwirˉemit(
            Build, WIR_OPERATION_LOAD_LOCAL, Local.Shape,
            Compilerˉsourceˉwirˉempty(Source), Local.Slot, 0u32,
            Expression.Firstˉoffset, Expression.Firstˉlength
        );
        let Firstˉfield: Compilerˉsourceˉwirˉvalue =
            Compilerˉsourceˉwirˉemit(
                Compilerˉsourceˉwirˉvalueˉbuild(Target),
                WIR_OPERATION_RECORD_FIELD,
                Field.Shape,
                Compilerˉsourceˉwirˉoneˉoperand(Target.Temporary),
                Fieldˉtarget,
                Field.Index,
                Expression.Offset,
                Expression.Length
            );
        let Secondˉtoken: Sourceˉlexer.Compilerˉsourceˉtoken =
            Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                Source,
                Expression.Secondˉoffset,
                Position.Line,
                Position.Column
            );
        return Compilerˉsourceˉwirˉcompileˉrecordˉpath(
            Input,
            Scan,
            Symbols,
            Source,
            Expression,
            Firstˉfield,
            Secondˉtoken.Nextˉoffset,
            Secondˉtoken.Nextˉline,
            Secondˉtoken.Nextˉcolumn
        );
    }
    let Capability: Sourceˉbindings.Compilerˉsourceˉbindingˉmatch = Sourceˉbindings.Compilerˉsourceˉbindingsˉfindˉcallable(
        Input, Scan, Symbols, 0u32, Source,
        Expression.Valueˉoffset, Expression.Valueˉlength
    );
    if Capability.Kind == Sourceˉbindings.Compilerˉsourceˉcallableˉkind.Capability {
        return Compilerˉsourceˉwirˉemit(
            Build,
            WIR_OPERATION_U32_CONSTANT,
            268435456u32 + Capability.Directoryˉentry,
            Compilerˉsourceˉwirˉempty(Source),
            0u32,
            0u32,
            Expression.Offset,
            Expression.Length
        );
    }
    let Qualifiedˉconstant: Sourceˉbindings.Compilerˉsourceˉbindingˉmatch =
        Sourceˉbindings.Compilerˉsourceˉbindingsˉfindˉdeclaration(
            Input, Scan, Symbols, Build.Currentˉmodule, Source,
            Expression.Valueˉoffset, Expression.Valueˉlength,
            Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Constant
        );
    let Qualifiedˉdata: Sourceˉbindings.Compilerˉsourceˉbindingˉmatch =
        Sourceˉbindings.Compilerˉsourceˉbindingsˉfindˉdeclaration(
            Input, Scan, Symbols, Build.Currentˉmodule, Source,
            Expression.Valueˉoffset, Expression.Valueˉlength,
            Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Data
        );
    if Qualifiedˉconstant.Found {
        return Compilerˉsourceˉwirˉcompileˉname(
            Input, Scan, Symbols, Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
            Source, Expression, Build
        );
    }
    if Qualifiedˉdata.Found {
        return Compilerˉsourceˉwirˉcompileˉname(
            Input, Scan, Symbols, Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
            Source, Expression, Build
        );
    }
    var Lastˉdot: u32 = Expression.Valueˉlength;
    var Nameˉcharacter: u32 = 0u32;
    while Nameˉcharacter < Expression.Valueˉlength {
        if Bytesˉreadˉu8(Source, Expression.Valueˉoffset + Nameˉcharacter) == 46u8 {
            Lastˉdot = Nameˉcharacter;
        }
        Nameˉcharacter = Nameˉcharacter + 1u32;
    }
    let Memberˉoffset: u32 = Expression.Valueˉoffset + Lastˉdot + 1u32;
    let Memberˉlength: u32 = Expression.Valueˉlength - Lastˉdot - 1u32;
    let Memberˉposition: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
        Source, Expression.Offset, Expression.Line, Expression.Column, Memberˉoffset
    );
    let Enumˉnominal: Sourceˉsymbols.Compilerˉsourceˉsymbolˉmatch = Sourceˉsymbols.Compilerˉsourceˉsymbolsˉfindˉownedˉnominal(
        Input, Scan, Symbols.Directory, Symbols.Lookup, Build.Currentˉmodule,
        Source, Expression.Valueˉoffset, Lastˉdot
    );
    if Enumˉnominal.Kind != Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Enum {
        return Compilerˉsourceˉwirˉfailureˉvalue(
            Build, Compilerˉsourceˉwirˉstatus.Invalidˉfieldˉtarget,
            Enumˉnominal.Module,
            Expression.Firstˉoffset, Firstˉposition.Line, Firstˉposition.Column
        );
    }
    if !Sourceˉsymbols.Compilerˉsourceˉsymbolsˉownedˉmatchˉisˉaccessible(
        Input, Scan, Symbols.Visibility, Symbols.Lookup, Build.Currentˉmodule, Source,
        Expression.Valueˉoffset, Lastˉdot, Enumˉnominal
    ) {
        return Compilerˉsourceˉwirˉfailureˉvalue(
            Build, Compilerˉsourceˉwirˉstatus.Invalidˉfieldˉtarget,
            Enumˉnominal.Module,
            Expression.Firstˉoffset, Firstˉposition.Line, Firstˉposition.Column
        );
    }
    let Member: Compilerˉsourceˉwirˉmember = Compilerˉsourceˉwirˉnominalˉmember(
        Input, Scan, Symbols, Enumˉnominal,
        Source, Memberˉoffset, Memberˉlength
    );
    if !Member.Found {
        return Compilerˉsourceˉwirˉfailureˉvalue(
            Build, Compilerˉsourceˉwirˉstatus.Unknownˉenumˉmember,
            Enumˉnominal.Module,
            Memberˉoffset, Memberˉposition.Line, Memberˉposition.Column
        );
    }
    return Compilerˉsourceˉwirˉemit(
        Build,
        WIR_OPERATION_ENUM_CONSTANT,
        Member.Shape,
        Compilerˉsourceˉwirˉempty(Source),
        Member.Shape - 131072u32,
        Member.Index,
        Expression.Offset,
        Expression.Length
    );
}

export fn Compilerˉsourceˉwirˉbinaryˉoperation(
    Operator: Sourceˉlexer.Compilerˉtokenˉkind,
    Shape: u32
) -> u32 {
    if Shape == 14u32 || Shape == 15u32 {
        if Operator == Sourceˉlexer.Compilerˉtokenˉkind.Plus {
            return WIR_OPERATION_FLOATING_ADD;
        }
        if Operator == Sourceˉlexer.Compilerˉtokenˉkind.Minus {
            return WIR_OPERATION_FLOATING_SUBTRACT;
        }
        if Operator == Sourceˉlexer.Compilerˉtokenˉkind.Star {
            return WIR_OPERATION_FLOATING_MULTIPLY;
        }
        if Operator == Sourceˉlexer.Compilerˉtokenˉkind.Slash {
            return WIR_OPERATION_FLOATING_DIVIDE;
        }
        if Operator == Sourceˉlexer.Compilerˉtokenˉkind.Equalsˉequals {
            return WIR_OPERATION_FLOATING_EQUAL;
        }
        if Operator == Sourceˉlexer.Compilerˉtokenˉkind.Bangˉequals {
            return WIR_OPERATION_FLOATING_NOT_EQUAL;
        }
        if Operator == Sourceˉlexer.Compilerˉtokenˉkind.Less {
            return WIR_OPERATION_FLOATING_LESS;
        }
        if Operator == Sourceˉlexer.Compilerˉtokenˉkind.Lessˉequals {
            return WIR_OPERATION_FLOATING_LESS_EQUAL;
        }
        if Operator == Sourceˉlexer.Compilerˉtokenˉkind.Greater {
            return WIR_OPERATION_FLOATING_GREATER;
        }
        return WIR_OPERATION_FLOATING_GREATER_EQUAL;
    }
    if Shape == 16u32 {
        if Operator == Sourceˉlexer.Compilerˉtokenˉkind.Equalsˉequals {
            return WIR_OPERATION_RUNE_EQUAL;
        }
        return WIR_OPERATION_RUNE_NOT_EQUAL;
    }
    if Shape >= 11u32 {
        if Shape <= 13u32 {
            if Operator == Sourceˉlexer.Compilerˉtokenˉkind.Plus {
                return WIR_OPERATION_FIXED_INTEGER_ADD;
            }
            if Operator == Sourceˉlexer.Compilerˉtokenˉkind.Minus {
                return WIR_OPERATION_FIXED_INTEGER_SUBTRACT;
            }
            if Operator == Sourceˉlexer.Compilerˉtokenˉkind.Star {
                return WIR_OPERATION_FIXED_INTEGER_MULTIPLY;
            }
            if Operator == Sourceˉlexer.Compilerˉtokenˉkind.Slash {
                return WIR_OPERATION_FIXED_INTEGER_DIVIDE;
            }
            if Operator == Sourceˉlexer.Compilerˉtokenˉkind.Percent {
                return WIR_OPERATION_FIXED_INTEGER_REMAINDER;
            }
            if Operator == Sourceˉlexer.Compilerˉtokenˉkind.Equalsˉequals {
                return WIR_OPERATION_FIXED_INTEGER_EQUAL;
            }
            if Operator == Sourceˉlexer.Compilerˉtokenˉkind.Bangˉequals {
                return WIR_OPERATION_FIXED_INTEGER_NOT_EQUAL;
            }
            if Operator == Sourceˉlexer.Compilerˉtokenˉkind.Less {
                return WIR_OPERATION_FIXED_INTEGER_LESS;
            }
            if Operator == Sourceˉlexer.Compilerˉtokenˉkind.Lessˉequals {
                return WIR_OPERATION_FIXED_INTEGER_LESS_EQUAL;
            }
            if Operator == Sourceˉlexer.Compilerˉtokenˉkind.Greater {
                return WIR_OPERATION_FIXED_INTEGER_GREATER;
            }
            if Operator == Sourceˉlexer.Compilerˉtokenˉkind.Greaterˉequals {
                return WIR_OPERATION_FIXED_INTEGER_GREATER_EQUAL;
            }
            if Operator == Sourceˉlexer.Compilerˉtokenˉkind.Ampersand {
                return WIR_OPERATION_FIXED_INTEGER_BITWISE_AND;
            }
            if Operator == Sourceˉlexer.Compilerˉtokenˉkind.Pipe {
                return WIR_OPERATION_FIXED_INTEGER_BITWISE_OR;
            }
            if Operator == Sourceˉlexer.Compilerˉtokenˉkind.Caret {
                return WIR_OPERATION_FIXED_INTEGER_BITWISE_XOR;
            }
            if Operator == Sourceˉlexer.Compilerˉtokenˉkind.Shiftˉleft {
                return WIR_OPERATION_FIXED_INTEGER_SHIFT_LEFT;
            }
            if Operator == Sourceˉlexer.Compilerˉtokenˉkind.Shiftˉright {
                return WIR_OPERATION_FIXED_INTEGER_SHIFT_RIGHT;
            }
        }
    }
    if Operator == Sourceˉlexer.Compilerˉtokenˉkind.Plus {
        if Shape == 1u32 { return WIR_OPERATION_I32_ADD; }
        if Shape == 7u32 { return WIR_OPERATION_I64_ADD; }
        if Shape == 8u32 { return WIR_OPERATION_U64_ADD; }
        return WIR_OPERATION_U32_ADD;
    }
    if Operator == Sourceˉlexer.Compilerˉtokenˉkind.Minus {
        if Shape == 1u32 { return WIR_OPERATION_I32_SUBTRACT; }
        if Shape == 7u32 { return WIR_OPERATION_I64_SUBTRACT; }
        if Shape == 8u32 { return WIR_OPERATION_U64_SUBTRACT; }
        return WIR_OPERATION_U32_SUBTRACT;
    }
    if Operator == Sourceˉlexer.Compilerˉtokenˉkind.Star {
        if Shape == 1u32 { return WIR_OPERATION_I32_MULTIPLY; }
        if Shape == 7u32 { return WIR_OPERATION_I64_MULTIPLY; }
        if Shape == 8u32 { return WIR_OPERATION_U64_MULTIPLY; }
        return WIR_OPERATION_U32_MULTIPLY;
    }
    if Operator == Sourceˉlexer.Compilerˉtokenˉkind.Slash {
        if Shape == 1u32 { return WIR_OPERATION_I32_DIVIDE; }
        if Shape == 7u32 { return WIR_OPERATION_I64_DIVIDE; }
        if Shape == 8u32 { return WIR_OPERATION_U64_DIVIDE; }
        return WIR_OPERATION_U32_DIVIDE;
    }
    if Operator == Sourceˉlexer.Compilerˉtokenˉkind.Percent {
        if Shape == 1u32 { return WIR_OPERATION_I32_REMAINDER; }
        if Shape == 7u32 { return WIR_OPERATION_I64_REMAINDER; }
        if Shape == 8u32 { return WIR_OPERATION_U64_REMAINDER; }
        return WIR_OPERATION_U32_REMAINDER;
    }
    if Operator == Sourceˉlexer.Compilerˉtokenˉkind.Ampersand {
        if Shape == 2u32 { return WIR_OPERATION_U8_BITWISE_AND; }
        if Shape == 8u32 { return WIR_OPERATION_U64_BITWISE_AND; }
        return WIR_OPERATION_U32_BITWISE_AND;
    }
    if Operator == Sourceˉlexer.Compilerˉtokenˉkind.Pipe {
        if Shape == 2u32 { return WIR_OPERATION_U8_BITWISE_OR; }
        if Shape == 8u32 { return WIR_OPERATION_U64_BITWISE_OR; }
        return WIR_OPERATION_U32_BITWISE_OR;
    }
    if Operator == Sourceˉlexer.Compilerˉtokenˉkind.Caret {
        if Shape == 2u32 { return WIR_OPERATION_U8_BITWISE_XOR; }
        if Shape == 8u32 { return WIR_OPERATION_U64_BITWISE_XOR; }
        return WIR_OPERATION_U32_BITWISE_XOR;
    }
    if Operator == Sourceˉlexer.Compilerˉtokenˉkind.Shiftˉleft {
        if Shape == 2u32 { return WIR_OPERATION_U8_SHIFT_LEFT; }
        if Shape == 8u32 { return WIR_OPERATION_U64_SHIFT_LEFT; }
        return WIR_OPERATION_U32_SHIFT_LEFT;
    }
    if Operator == Sourceˉlexer.Compilerˉtokenˉkind.Shiftˉright {
        if Shape == 2u32 { return WIR_OPERATION_U8_SHIFT_RIGHT; }
        if Shape == 8u32 { return WIR_OPERATION_U64_SHIFT_RIGHT; }
        return WIR_OPERATION_U32_SHIFT_RIGHT;
    }
    if Operator == Sourceˉlexer.Compilerˉtokenˉkind.Less {
        if Shape == 1u32 { return WIR_OPERATION_I32_LESS; }
        if Shape == 7u32 { return WIR_OPERATION_I64_LESS; }
        if Shape == 8u32 { return WIR_OPERATION_U64_LESS; }
        return WIR_OPERATION_U32_LESS;
    }
    if Operator == Sourceˉlexer.Compilerˉtokenˉkind.Lessˉequals {
        if Shape == 1u32 { return WIR_OPERATION_I32_LESS_EQUAL; }
        if Shape == 7u32 { return WIR_OPERATION_I64_LESS_EQUAL; }
        if Shape == 8u32 { return WIR_OPERATION_U64_LESS_EQUAL; }
        return WIR_OPERATION_U32_LESS_EQUAL;
    }
    if Operator == Sourceˉlexer.Compilerˉtokenˉkind.Greater {
        if Shape == 1u32 { return WIR_OPERATION_I32_GREATER; }
        if Shape == 7u32 { return WIR_OPERATION_I64_GREATER; }
        if Shape == 8u32 { return WIR_OPERATION_U64_GREATER; }
        return WIR_OPERATION_U32_GREATER;
    }
    if Operator == Sourceˉlexer.Compilerˉtokenˉkind.Greaterˉequals {
        if Shape == 1u32 { return WIR_OPERATION_I32_GREATER_EQUAL; }
        if Shape == 7u32 { return WIR_OPERATION_I64_GREATER_EQUAL; }
        if Shape == 8u32 { return WIR_OPERATION_U64_GREATER_EQUAL; }
        return WIR_OPERATION_U32_GREATER_EQUAL;
    }
    if Operator == Sourceˉlexer.Compilerˉtokenˉkind.Equalsˉequals {
        if Shape == 1u32 { return WIR_OPERATION_I32_EQUAL; }
        if Shape == 2u32 { return WIR_OPERATION_U8_EQUAL; }
        if Shape == 3u32 { return WIR_OPERATION_U32_EQUAL; }
        if Shape == 4u32 { return WIR_OPERATION_BOOL_EQUAL; }
        if Shape == 5u32 { return WIR_OPERATION_TEXT_EQUAL; }
        if Shape == 6u32 { return WIR_OPERATION_BYTES_EQUAL; }
        if Shape == 7u32 { return WIR_OPERATION_I64_EQUAL; }
        if Shape == 8u32 { return WIR_OPERATION_U64_EQUAL; }
        return WIR_OPERATION_ENUM_EQUAL;
    }
    if Shape == 1u32 { return WIR_OPERATION_I32_NOT_EQUAL; }
    if Shape == 2u32 { return WIR_OPERATION_U8_NOT_EQUAL; }
    if Shape == 3u32 { return WIR_OPERATION_U32_NOT_EQUAL; }
    if Shape == 4u32 { return WIR_OPERATION_BOOL_NOT_EQUAL; }
    if Shape == 5u32 { return WIR_OPERATION_TEXT_NOT_EQUAL; }
    if Shape == 6u32 { return WIR_OPERATION_BYTES_NOT_EQUAL; }
    if Shape == 7u32 { return WIR_OPERATION_I64_NOT_EQUAL; }
    if Shape == 8u32 { return WIR_OPERATION_U64_NOT_EQUAL; }
    return WIR_OPERATION_ENUM_NOT_EQUAL;
}

fn Compilerˉsourceˉwirˉcompileˉnamedˉvariant(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Bindingˉpayload: bytes,
    Bindingˉfirst: u32,
    Bindingˉentries: u32,
    Source: bytes,
    Expression: Sourceˉbodies.Compilerˉsourceˉexpression,
    Callable: Sourceˉbindings.Compilerˉsourceˉbindingˉmatch,
    Build: Compilerˉsourceˉwirˉbuild
) -> Compilerˉsourceˉwirˉvalue {
    let View: Sourceˉset.Compilerˉsourceˉsetˉview =
        Sourceˉset.Compilerˉsourceˉsetˉmodule(
            Input, Scan, Build.Currentˉmodule
        );
    if View.Edition != 1u32 {
        return Compilerˉsourceˉwirˉfailureˉvalue(
            Build, Compilerˉsourceˉwirˉstatus.Invalidˉvariantˉliteral,
            Callable.Module,
            Expression.Offset, Expression.Line, Expression.Column
        );
    }
    let Signature: Compilerˉsourceˉwirˉsignature =
        Compilerˉsourceˉwirˉcallableˉsignature(
            Input, Scan, Symbols, Callable, Source,
            Expression.Valueˉoffset, Expression.Valueˉlength, 0u32
        );
    let Constructionˉnominal: Sourceˉsymbols.Compilerˉsourceˉsymbolˉmatch =
        Sourceˉsymbols.Compilerˉsourceˉsymbolsˉdirectoryˉentry(
            Symbols.Directory, Scan.Modules, Callable.Directoryˉentry
        );
    let Constructionˉfamily: u32 =
        Sourceˉsymbols.Compilerˉsourceˉsymbolsˉfoundationˉgenericˉfamily(
            Input, Scan, Constructionˉnominal
        );
    var Constructionˉshape: u32 = Signature.Returnˉshape;
    var Constructionˉtarget: u32 = Signature.Target;
    if Constructionˉfamily != 0u32 {
        let Constructionˉreturnˉshape: u32 =
            Compilerˉsourceˉwirˉcurrentˉreturnˉshape(
                Input, Scan, Symbols, Source, Build
            );
        var Constructionˉmatches: bool =
            Constructionˉfamily == 1u32 &&
            Sourceˉsymbols.Compilerˉsourceˉsymbolsˉshapeˉisˉfoundationˉoption(
                Constructionˉreturnˉshape
            );
        if Constructionˉfamily == 2u32 {
            Constructionˉmatches =
                Sourceˉsymbols.Compilerˉsourceˉsymbolsˉshapeˉisˉfoundationˉresult(
                    Constructionˉreturnˉshape
                );
        }
        if !Constructionˉmatches {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Build, Compilerˉsourceˉwirˉstatus.Invalidˉvariantˉliteral,
                Callable.Module,
                Expression.Offset, Expression.Line, Expression.Column
            );
        }
        Constructionˉshape = Constructionˉreturnˉshape;
        Constructionˉtarget = Constructionˉreturnˉshape;
    }
    let Caseˉview: Compilerˉsourceˉwirˉvariantˉcaseˉview =
        Compilerˉsourceˉwirˉvariantˉcaseˉviewˉbyˉindex(
            Input, Scan, Symbols, Constructionˉtarget, Signature.Auxiliary
        );
    let Fieldˉcount: u32 = Caseˉview.Fields;
    if !Caseˉview.Found || Fieldˉcount != Callable.Items {
        return Compilerˉsourceˉwirˉfailureˉvalue(
            Build, Compilerˉsourceˉwirˉstatus.Invalidˉvariantˉliteral,
            Callable.Module,
            Expression.Offset, Expression.Line, Expression.Column
        );
    }
    let Empty: bytes = Compilerˉsourceˉwirˉempty(Source);
    var Operands: bytes = Empty;
    var Operandˉindex: u32 = 0u32;
    while Operandˉindex < Fieldˉcount {
        Operands = Bytesˉconcat(Operands, Bytesˉfromˉu32ˉlittle(0u32));
        Operandˉindex = Operandˉindex + 1u32;
    }
    let Seenˉresult: Byteˉconstruction.Foundationˉbytesˉresult =
        Byteˉconstruction.Foundationˉbytesˉrepeat(0u8, Fieldˉcount);
    if !Seenˉresult.Valid {
        return Compilerˉsourceˉwirˉfailureˉvalue(
            Build, Compilerˉsourceˉwirˉstatus.Evidenceˉlimit,
            Callable.Module,
            Expression.Offset, Expression.Line, Expression.Column
        );
    }
    var Seen: bytes = Seenˉresult.Value;
    var Result: Compilerˉsourceˉwirˉbuild = Build;
    var Cursor: u32 = Expression.Itemsˉoffset;
    var Position: Sourceˉbodies.Compilerˉsourceˉposition =
        Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
            Source, Expression.Offset, Expression.Line, Expression.Column,
            Expression.Itemsˉoffset
        );
    var Item: u32 = 0u32;
    while Item < Expression.Items {
        let Field: Sourceˉlexer.Compilerˉsourceˉtoken =
            Sourceˉbodies.Compilerˉbodyˉtoken(
                Source, Cursor, Position.Line, Position.Column,
                Expression.Itemsˉoffset + Expression.Itemsˉlength
            );
        let Colon: Sourceˉlexer.Compilerˉsourceˉtoken =
            Sourceˉbodies.Compilerˉbodyˉtoken(
                Source, Field.Nextˉoffset, Field.Nextˉline,
                Field.Nextˉcolumn,
                Expression.Itemsˉoffset + Expression.Itemsˉlength
            );
        let Fieldˉexpression: Sourceˉbodies.Compilerˉsourceˉexpression =
            Sourceˉbodies.Compilerˉparseˉexpressionˉvalidated(
                Source, Colon.Nextˉoffset, Colon.Nextˉline,
                Colon.Nextˉcolumn,
                Expression.Itemsˉoffset + Expression.Itemsˉlength,
                0u32, 0u32
            );
        let Value: Compilerˉsourceˉwirˉvalue =
            Compilerˉsourceˉwirˉcompileˉexpression(
                Input, Scan, Symbols,
                Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
                Source, Fieldˉexpression.Offset, Fieldˉexpression.Line,
                Fieldˉexpression.Column,
                Fieldˉexpression.Offset + Fieldˉexpression.Length,
                Result
            );
        if Value.Status != Compilerˉsourceˉwirˉstatus.Valid { return Value; }
        if Value.Shape == 10u32 { return Value; }
        let Member: Compilerˉsourceˉwirˉmember =
            Compilerˉsourceˉwirˉvariantˉfieldˉbyˉname(
                Input, Scan, Symbols, Constructionˉtarget,
                Signature.Auxiliary, Source, Field.Offset, Field.Length
            );
        if !Member.Found {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Compilerˉsourceˉwirˉvalueˉbuild(Value),
                Compilerˉsourceˉwirˉstatus.Unknownˉfield,
                Callable.Module, Field.Offset, Field.Line, Field.Column
            );
        }
        if Bytesˉreadˉu8(Seen, Member.Index) != 0u8 {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Compilerˉsourceˉwirˉvalueˉbuild(Value),
                Compilerˉsourceˉwirˉstatus.Duplicateˉvariantˉfield,
                Callable.Module, Field.Offset, Field.Line, Field.Column
            );
        }
        if Value.Shape != Member.Shape {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Compilerˉsourceˉwirˉvalueˉbuild(Value),
                Compilerˉsourceˉwirˉstatus.Typeˉmismatch,
                Callable.Module, Fieldˉexpression.Offset,
                Fieldˉexpression.Line, Fieldˉexpression.Column
            );
        }
        let Updatedˉoperands: Byteˉconstruction.Foundationˉbytesˉresult =
            Byteˉconstruction.Foundationˉbytesˉreplace(
                Operands, Member.Index * 4u32, 4u32,
                Bytesˉfromˉu32ˉlittle(Value.Temporary)
            );
        let Updatedˉseen: Byteˉconstruction.Foundationˉbytesˉresult =
            Byteˉconstruction.Foundationˉbytesˉreplace(
                Seen, Member.Index, 1u32, Bytesˉfromˉu8(1u8)
            );
        if !Updatedˉoperands.Valid || !Updatedˉseen.Valid {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Compilerˉsourceˉwirˉvalueˉbuild(Value),
                Compilerˉsourceˉwirˉstatus.Invalidˉdirectory,
                Callable.Module, Field.Offset, Field.Line, Field.Column
            );
        }
        Operands = Updatedˉoperands.Value;
        Seen = Updatedˉseen.Value;
        Result = Compilerˉsourceˉwirˉvalueˉbuild(Value);
        Cursor = Fieldˉexpression.Nextˉoffset;
        Position = Sourceˉbodies.Compilerˉsourceˉposition(
            Fieldˉexpression.Nextˉoffset, Fieldˉexpression.Nextˉline,
            Fieldˉexpression.Nextˉcolumn
        );
        if Item + 1u32 < Expression.Items {
            let Separator: Sourceˉlexer.Compilerˉsourceˉtoken =
                Sourceˉbodies.Compilerˉbodyˉtoken(
                    Source, Cursor, Position.Line, Position.Column,
                    Expression.Itemsˉoffset + Expression.Itemsˉlength
                );
            Cursor = Separator.Nextˉoffset;
            Position = Sourceˉbodies.Compilerˉsourceˉposition(
                Separator.Nextˉoffset, Separator.Nextˉline,
                Separator.Nextˉcolumn
            );
        }
        Item = Item + 1u32;
    }
    var Missing: u32 = 0u32;
    while Missing < Fieldˉcount {
        if Bytesˉreadˉu8(Seen, Missing) == 0u8 {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Result, Compilerˉsourceˉwirˉstatus.Missingˉvariantˉfield,
                Callable.Module,
                Expression.Offset, Expression.Line, Expression.Column
            );
        }
        Missing = Missing + 1u32;
    }
    return Compilerˉsourceˉwirˉemit(
        Result, WIR_OPERATION_VARIANT_CREATE,
        Constructionˉshape, Operands,
        Constructionˉtarget, Signature.Auxiliary,
        Expression.Offset, Expression.Length
    );
}

fn Compilerˉsourceˉwirˉcompileˉgenericˉnamedˉrecord(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Bindingˉpayload: bytes,
    Bindingˉfirst: u32,
    Bindingˉentries: u32,
    Source: bytes,
    Expression: Sourceˉbodies.Compilerˉsourceˉexpression,
    Build: Compilerˉsourceˉwirˉbuild
) -> Compilerˉsourceˉwirˉvalue {
    let Bound: Genericˉtypeˉbinding.Compilerˉsourceˉgenericˉtypeˉbinding =
        Compilerˉsourceˉwirˉbindˉgenericˉtype(
            Input, Scan, Symbols, Source,
            Expression.Valueˉoffset, Expression.Line, Expression.Column,
            Build
        );
    if Bound.Status !=
            Sourceˉsymbols.Compilerˉsourceˉsymbolˉstatus.Valid ||
        Bound.Genericˉstatus !=
            Sourceˉgenerics.Compilerˉsourceˉgenericˉstatus.Valid ||
        Bound.Nominalˉkind !=
            Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Record {
        return Compilerˉsourceˉwirˉfailureˉvalue(
            Build, Compilerˉsourceˉwirˉstatus.Invalidˉrecordˉliteral,
            Bound.Module,
            Bound.Failureˉoffset, Bound.Failureˉline, Bound.Failureˉcolumn
        );
    }
    let Catalog: Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog =
        Genericˉtypeˉbinding.Compilerˉsourceˉgenericˉtypeˉbindingˉcatalog(
            Bound
        );
    let Instance: u32 =
        Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉshapeˉinstance(
            Bound.Shape
        );
    let Layout: Genericˉlayouts.Compilerˉsourceˉgenericˉtypeˉlayout =
        Genericˉlayouts.Compilerˉsourceˉgenericˉtypeˉlayoutˉcreate(
            Input, Scan, Symbols, Catalog, Instance
        );
    if Layout.Shape != Bound.Shape || Layout.Declaration != Bound.Declaration ||
        Layout.Kind !=
            Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Record ||
        Layout.Fields > 64u32 ||
        Bytesˉlength(Layout.Fieldˉevidence) != Layout.Fields * 16u32 ||
        !Genericˉlayouts.Compilerˉsourceˉgenericˉtypeˉlayoutˉisˉvalid(
            Input, Scan, Symbols, Layout
        ) {
        return Compilerˉsourceˉwirˉfailureˉvalue(
            Build, Compilerˉsourceˉwirˉstatus.Invalidˉrecordˉliteral,
            Bound.Module,
            Expression.Offset, Expression.Line, Expression.Column
        );
    }
    var Result: Compilerˉsourceˉwirˉbuild =
        Compilerˉsourceˉwirˉwithˉgenericˉtypeˉevidence(
            Build, Bound.Catalogˉevidence
        );
    var Operands: bytes = Compilerˉsourceˉwirˉempty(Source);
    var Operand: u32 = 0u32;
    while Operand < Layout.Fields {
        Operands = Bytesˉconcat(Operands, Bytesˉfromˉu32ˉlittle(0u32));
        Operand = Operand + 1u32;
    }
    let Seenˉresult: Byteˉconstruction.Foundationˉbytesˉresult =
        Byteˉconstruction.Foundationˉbytesˉrepeat(0u8, Layout.Fields);
    if !Seenˉresult.Valid {
        return Compilerˉsourceˉwirˉfailureˉvalue(
            Result, Compilerˉsourceˉwirˉstatus.Evidenceˉlimit,
            Bound.Module,
            Expression.Offset, Expression.Line, Expression.Column
        );
    }
    var Seen: bytes = Seenˉresult.Value;
    var Cursor: u32 = Expression.Itemsˉoffset;
    var Position: Sourceˉbodies.Compilerˉsourceˉposition =
        Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
            Source, Expression.Offset, Expression.Line, Expression.Column,
            Expression.Itemsˉoffset
        );
    var Item: u32 = 0u32;
    while Item < Expression.Items {
        let Field: Sourceˉlexer.Compilerˉsourceˉtoken =
            Sourceˉbodies.Compilerˉbodyˉtoken(
                Source, Cursor, Position.Line, Position.Column,
                Expression.Itemsˉoffset + Expression.Itemsˉlength
            );
        let Colon: Sourceˉlexer.Compilerˉsourceˉtoken =
            Sourceˉbodies.Compilerˉbodyˉtoken(
                Source, Field.Nextˉoffset, Field.Nextˉline, Field.Nextˉcolumn,
                Expression.Itemsˉoffset + Expression.Itemsˉlength
            );
        let Fieldˉexpression: Sourceˉbodies.Compilerˉsourceˉexpression =
            Sourceˉbodies.Compilerˉparseˉexpressionˉvalidated(
                Source, Colon.Nextˉoffset, Colon.Nextˉline, Colon.Nextˉcolumn,
                Expression.Itemsˉoffset + Expression.Itemsˉlength, 0u32, 0u32
            );
        let Value: Compilerˉsourceˉwirˉvalue =
            Compilerˉsourceˉwirˉcompileˉexpression(
                Input, Scan, Symbols,
                Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
                Source,
                Fieldˉexpression.Offset, Fieldˉexpression.Line,
                Fieldˉexpression.Column,
                Fieldˉexpression.Offset + Fieldˉexpression.Length,
                Result
            );
        if Value.Status != Compilerˉsourceˉwirˉstatus.Valid { return Value; }
        if Value.Shape == 10u32 { return Value; }
        let Member: Compilerˉsourceˉwirˉmember =
            Compilerˉsourceˉwirˉrecordˉfieldˉbyˉshape(
                Input, Scan, Symbols, Catalog, Bound.Shape,
                Source, Field.Offset, Field.Length
            );
        if !Member.Found {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Compilerˉsourceˉwirˉvalueˉbuild(Value),
                Compilerˉsourceˉwirˉstatus.Unknownˉfield,
                Bound.Module, Field.Offset, Field.Line, Field.Column
            );
        }
        if Bytesˉreadˉu8(Seen, Member.Index) != 0u8 {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Compilerˉsourceˉwirˉvalueˉbuild(Value),
                Compilerˉsourceˉwirˉstatus.Duplicateˉrecordˉfield,
                Bound.Module, Field.Offset, Field.Line, Field.Column
            );
        }
        if Value.Shape != Member.Shape {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Compilerˉsourceˉwirˉvalueˉbuild(Value),
                Compilerˉsourceˉwirˉstatus.Typeˉmismatch,
                Bound.Module,
                Fieldˉexpression.Offset,
                Fieldˉexpression.Line, Fieldˉexpression.Column
            );
        }
        let Updatedˉoperands: Byteˉconstruction.Foundationˉbytesˉresult =
            Byteˉconstruction.Foundationˉbytesˉreplace(
                Operands, Member.Index * 4u32, 4u32,
                Bytesˉfromˉu32ˉlittle(Value.Temporary)
            );
        let Updatedˉseen: Byteˉconstruction.Foundationˉbytesˉresult =
            Byteˉconstruction.Foundationˉbytesˉreplace(
                Seen, Member.Index, 1u32, Bytesˉfromˉu8(1u8)
            );
        if !Updatedˉoperands.Valid || !Updatedˉseen.Valid {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Compilerˉsourceˉwirˉvalueˉbuild(Value),
                Compilerˉsourceˉwirˉstatus.Invalidˉdirectory,
                Bound.Module, Field.Offset, Field.Line, Field.Column
            );
        }
        Operands = Updatedˉoperands.Value;
        Seen = Updatedˉseen.Value;
        Result = Compilerˉsourceˉwirˉvalueˉbuild(Value);
        Cursor = Fieldˉexpression.Nextˉoffset;
        Position = Sourceˉbodies.Compilerˉsourceˉposition(
            Fieldˉexpression.Nextˉoffset,
            Fieldˉexpression.Nextˉline, Fieldˉexpression.Nextˉcolumn
        );
        if Item + 1u32 < Expression.Items {
            let Separator: Sourceˉlexer.Compilerˉsourceˉtoken =
                Sourceˉbodies.Compilerˉbodyˉtoken(
                    Source, Cursor, Position.Line, Position.Column,
                    Expression.Itemsˉoffset + Expression.Itemsˉlength
                );
            Cursor = Separator.Nextˉoffset;
            Position = Sourceˉbodies.Compilerˉsourceˉposition(
                Separator.Nextˉoffset,
                Separator.Nextˉline, Separator.Nextˉcolumn
            );
        }
        Item = Item + 1u32;
    }
    var Missing: u32 = 0u32;
    while Missing < Layout.Fields {
        if Bytesˉreadˉu8(Seen, Missing) == 0u8 {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Result, Compilerˉsourceˉwirˉstatus.Missingˉrecordˉfield,
                Bound.Module,
                Expression.Offset, Expression.Line, Expression.Column
            );
        }
        Missing = Missing + 1u32;
    }
    return Compilerˉsourceˉwirˉemit(
        Result, WIR_OPERATION_RECORD_CREATE,
        Bound.Shape, Operands, Bound.Shape, Bound.Declaration,
        Expression.Offset, Expression.Length
    );
}

export fn Compilerˉsourceˉwirˉcompileˉnamedˉrecord(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Bindingˉpayload: bytes,
    Bindingˉfirst: u32,
    Bindingˉentries: u32,
    Source: bytes,
    Expression: Sourceˉbodies.Compilerˉsourceˉexpression,
    Build: Compilerˉsourceˉwirˉbuild
) -> Compilerˉsourceˉwirˉvalue {
    let Isˉupdate: bool =
        Expression.Kind == Sourceˉbodies.Compilerˉsourceˉexpressionˉkind.Recordˉupdate;
    if Expression.Kind ==
            Sourceˉbodies.Compilerˉsourceˉexpressionˉkind.Genericˉnamedˉrecord {
        return Compilerˉsourceˉwirˉcompileˉgenericˉnamedˉrecord(
            Input, Scan, Symbols,
            Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
            Source, Expression, Build
        );
    }
    if Isˉupdate {
        let Updateˉview: Sourceˉset.Compilerˉsourceˉsetˉview =
            Sourceˉset.Compilerˉsourceˉsetˉmodule(
                Input, Scan, Build.Currentˉmodule
            );
        if Updateˉview.Edition != 1u32 {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Build, Compilerˉsourceˉwirˉstatus.Invalidˉrecordˉupdate,
                Build.Currentˉmodule,
                Expression.Offset, Expression.Line, Expression.Column
            );
        }
    }
    let Callable: Sourceˉbindings.Compilerˉsourceˉbindingˉmatch = Sourceˉbindings.Compilerˉsourceˉbindingsˉfindˉcallable(
        Input, Scan, Symbols, Build.Currentˉmodule, Source,
        Expression.Valueˉoffset, Expression.Valueˉlength
    );
    if !Callable.Found || !Callable.Accessible {
        return Compilerˉsourceˉwirˉfailureˉvalue(
            Build, Compilerˉsourceˉwirˉstatus.Invalidˉrecordˉliteral,
            Callable.Module, Expression.Offset, Expression.Line, Expression.Column
        );
    }
    if !Isˉupdate &&
        Callable.Kind == Sourceˉbindings.Compilerˉsourceˉcallableˉkind.Variantˉcase {
        return Compilerˉsourceˉwirˉcompileˉnamedˉvariant(
            Input, Scan, Symbols,
            Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
            Source, Expression, Callable, Build
        );
    }
    if Callable.Kind != Sourceˉbindings.Compilerˉsourceˉcallableˉkind.Record {
        return Compilerˉsourceˉwirˉfailureˉvalue(
            Build, Compilerˉsourceˉwirˉstatus.Invalidˉrecordˉliteral,
            Callable.Module, Expression.Offset, Expression.Line, Expression.Column
        );
    }
    let Nominal: Sourceˉsymbols.Compilerˉsourceˉsymbolˉmatch = Sourceˉsymbols.Compilerˉsourceˉsymbolsˉdirectoryˉentry(
        Symbols.Directory, Scan.Modules, Callable.Directoryˉentry
    );
    let Signature: Compilerˉsourceˉwirˉsignature = Compilerˉsourceˉwirˉrecordˉsignature(
        Input, Scan, Symbols, Callable, 0u32
    );
    let Empty: bytes = Compilerˉsourceˉwirˉempty(Source);
    var Recordˉoperands: bytes = Empty;
    var Operandˉindex: u32 = 0u32;
    while Operandˉindex < Callable.Items {
        Recordˉoperands = Bytesˉconcat(
            Recordˉoperands, Bytesˉfromˉu32ˉlittle(0u32)
        );
        Operandˉindex = Operandˉindex + 1u32;
    }
    let Seenˉresult: Byteˉconstruction.Foundationˉbytesˉresult = Byteˉconstruction.Foundationˉbytesˉrepeat(
        0u8, Callable.Items
    );
    if !Seenˉresult.Valid {
        return Compilerˉsourceˉwirˉfailureˉvalue(
            Build, Compilerˉsourceˉwirˉstatus.Evidenceˉlimit,
            Callable.Module, Expression.Offset, Expression.Line, Expression.Column
        );
    }
    var Seen: bytes = Seenˉresult.Value;
    var Result: Compilerˉsourceˉwirˉbuild = Build;
    var Baseˉtemporary: u32 = Compilerˉsourceˉwirˉsentinel();
    if Isˉupdate {
        let Baseˉposition: Sourceˉbodies.Compilerˉsourceˉposition =
            Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
                Source, Expression.Offset, Expression.Line, Expression.Column,
                Expression.Firstˉoffset
            );
        let Baseˉvalue: Compilerˉsourceˉwirˉvalue =
            Compilerˉsourceˉwirˉcompileˉexpression(
                Input, Scan, Symbols,
                Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
                Source,
                Expression.Firstˉoffset, Baseˉposition.Line,
                Baseˉposition.Column,
                Expression.Firstˉoffset + Expression.Firstˉlength,
                Result
            );
        if Baseˉvalue.Status != Compilerˉsourceˉwirˉstatus.Valid {
            return Baseˉvalue;
        }
        if Baseˉvalue.Shape == 10u32 { return Baseˉvalue; }
        if Baseˉvalue.Shape != Signature.Returnˉshape {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Compilerˉsourceˉwirˉvalueˉbuild(Baseˉvalue),
                Compilerˉsourceˉwirˉstatus.Invalidˉrecordˉupdate,
                Callable.Module,
                Expression.Firstˉoffset,
                Baseˉposition.Line,
                Baseˉposition.Column
            );
        }
        Baseˉtemporary = Baseˉvalue.Temporary;
        Result = Compilerˉsourceˉwirˉvalueˉbuild(Baseˉvalue);
    }
    var Cursor: u32 = Expression.Itemsˉoffset;
    var Currentˉposition: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
        Source, Expression.Offset, Expression.Line, Expression.Column,
        Expression.Itemsˉoffset
    );
    var Item: u32 = 0u32;
    while Item < Expression.Items {
        let Field: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉbodies.Compilerˉbodyˉtoken(
            Source, Cursor, Currentˉposition.Line, Currentˉposition.Column,
            Expression.Itemsˉoffset + Expression.Itemsˉlength
        );
        let Colon: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉbodies.Compilerˉbodyˉtoken(
            Source, Field.Nextˉoffset, Field.Nextˉline, Field.Nextˉcolumn,
            Expression.Itemsˉoffset + Expression.Itemsˉlength
        );
        let Fieldˉvalue: Sourceˉbodies.Compilerˉsourceˉexpression = Sourceˉbodies.Compilerˉparseˉexpressionˉvalidated(
            Source, Colon.Nextˉoffset, Colon.Nextˉline, Colon.Nextˉcolumn,
            Expression.Itemsˉoffset + Expression.Itemsˉlength, 0u32, 0u32
        );
        let Value: Compilerˉsourceˉwirˉvalue = Compilerˉsourceˉwirˉcompileˉexpression(
            Input, Scan, Symbols, Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
            Source,
            Fieldˉvalue.Offset, Fieldˉvalue.Line, Fieldˉvalue.Column,
            Fieldˉvalue.Offset + Fieldˉvalue.Length,
            Result
        );
        if Value.Status != Compilerˉsourceˉwirˉstatus.Valid { return Value; }
        if Value.Shape == 10u32 { return Value; }
        let Member: Compilerˉsourceˉwirˉmember = Compilerˉsourceˉwirˉnominalˉmember(
            Input, Scan, Symbols, Nominal, Source, Field.Offset, Field.Length
        );
        if !Member.Found {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Compilerˉsourceˉwirˉvalueˉbuild(Value),
                Compilerˉsourceˉwirˉstatus.Unknownˉfield,
                Callable.Module, Field.Offset, Field.Line, Field.Column
            );
        }
        if Bytesˉreadˉu8(Seen, Member.Index) != 0u8 {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Compilerˉsourceˉwirˉvalueˉbuild(Value),
                Compilerˉsourceˉwirˉstatus.Duplicateˉrecordˉfield,
                Callable.Module, Field.Offset, Field.Line, Field.Column
            );
        }
        if Value.Shape != Member.Shape {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Compilerˉsourceˉwirˉvalueˉbuild(Value),
                Compilerˉsourceˉwirˉstatus.Typeˉmismatch,
                Callable.Module,
                Fieldˉvalue.Offset, Fieldˉvalue.Line, Fieldˉvalue.Column
            );
        }
        let Updatedˉoperands: Byteˉconstruction.Foundationˉbytesˉresult = Byteˉconstruction.Foundationˉbytesˉreplace(
            Recordˉoperands, Member.Index * 4u32, 4u32,
            Bytesˉfromˉu32ˉlittle(Value.Temporary)
        );
        let Updatedˉseen: Byteˉconstruction.Foundationˉbytesˉresult = Byteˉconstruction.Foundationˉbytesˉreplace(
            Seen, Member.Index, 1u32, Bytesˉfromˉu8(1u8)
        );
        if !Updatedˉoperands.Valid {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Compilerˉsourceˉwirˉvalueˉbuild(Value),
                Compilerˉsourceˉwirˉstatus.Invalidˉdirectory,
                Callable.Module, Field.Offset, Field.Line, Field.Column
            );
        }
        if !Updatedˉseen.Valid {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Compilerˉsourceˉwirˉvalueˉbuild(Value),
                Compilerˉsourceˉwirˉstatus.Invalidˉdirectory,
                Callable.Module, Field.Offset, Field.Line, Field.Column
            );
        }
        Recordˉoperands = Updatedˉoperands.Value;
        Seen = Updatedˉseen.Value;
        Result = Compilerˉsourceˉwirˉvalueˉbuild(Value);
        Cursor = Fieldˉvalue.Nextˉoffset;
        Currentˉposition = Sourceˉbodies.Compilerˉsourceˉposition(
            Fieldˉvalue.Nextˉoffset, Fieldˉvalue.Nextˉline, Fieldˉvalue.Nextˉcolumn
        );
        if Item + 1u32 < Expression.Items {
            let Separator: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉbodies.Compilerˉbodyˉtoken(
                Source, Cursor, Currentˉposition.Line, Currentˉposition.Column,
                Expression.Itemsˉoffset + Expression.Itemsˉlength
            );
            Cursor = Separator.Nextˉoffset;
            Currentˉposition = Sourceˉbodies.Compilerˉsourceˉposition(
                Separator.Nextˉoffset, Separator.Nextˉline, Separator.Nextˉcolumn
            );
        }
        Item = Item + 1u32;
    }
    var Missing: u32 = 0u32;
    while Missing < Callable.Items {
        if Bytesˉreadˉu8(Seen, Missing) == 0u8 {
            if !Isˉupdate {
                return Compilerˉsourceˉwirˉfailureˉvalue(
                    Result, Compilerˉsourceˉwirˉstatus.Missingˉrecordˉfield,
                    Callable.Module,
                    Expression.Offset, Expression.Line, Expression.Column
                );
            }
            let Preservedˉsignature: Compilerˉsourceˉwirˉsignature =
                Compilerˉsourceˉwirˉrecordˉsignature(
                    Input, Scan, Symbols, Callable, Missing
                );
            let Preserved: Compilerˉsourceˉwirˉvalue =
                Compilerˉsourceˉwirˉemit(
                    Result,
                    WIR_OPERATION_RECORD_FIELD,
                    Preservedˉsignature.Parameterˉshape,
                    Compilerˉsourceˉwirˉoneˉoperand(Baseˉtemporary),
                    Signature.Target,
                    Missing,
                    Expression.Firstˉoffset,
                    Expression.Firstˉlength
                );
            if Preserved.Status != Compilerˉsourceˉwirˉstatus.Valid {
                return Preserved;
            }
            let Preservedˉoperands: Byteˉconstruction.Foundationˉbytesˉresult =
                Byteˉconstruction.Foundationˉbytesˉreplace(
                    Recordˉoperands, Missing * 4u32, 4u32,
                    Bytesˉfromˉu32ˉlittle(Preserved.Temporary)
                );
            if !Preservedˉoperands.Valid {
                return Compilerˉsourceˉwirˉfailureˉvalue(
                    Compilerˉsourceˉwirˉvalueˉbuild(Preserved),
                    Compilerˉsourceˉwirˉstatus.Invalidˉdirectory,
                    Callable.Module,
                    Expression.Offset, Expression.Line, Expression.Column
                );
            }
            Recordˉoperands = Preservedˉoperands.Value;
            Result = Compilerˉsourceˉwirˉvalueˉbuild(Preserved);
        }
        Missing = Missing + 1u32;
    }
    return Compilerˉsourceˉwirˉemit(
        Result, WIR_OPERATION_RECORD_CREATE,
        Signature.Returnˉshape, Recordˉoperands,
        Signature.Target, Signature.Auxiliary,
        Expression.Offset, Expression.Length
    );
}

fn Compilerˉsourceˉwirˉcurrentˉreturnˉshape(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Source: bytes,
    Build: Compilerˉsourceˉwirˉbuild
) -> u32 {
    var Declaration: u32 = Build.Currentˉfunction;
    let Catalog: Sourceˉgenerics.Compilerˉsourceˉgenericˉcatalog =
        Compilerˉsourceˉwirˉgenericˉcatalog(Build.Genericˉevidence);
    if Build.Genericˉinstance != Compilerˉsourceˉwirˉsentinel() {
        Declaration =
            Sourceˉgenerics.Compilerˉsourceˉgenericˉcatalogˉinstanceˉdeclaration(
                Catalog, Build.Genericˉinstance
            );
    }
    let Entry: u32 = 16u32 + Declaration * 24u32;
    let Declarationˉoffset: u32 = Bytesˉreadˉu32ˉlittle(
        Symbols.Directory, Entry + 8u32
    );
    let Signature: Compilerˉsourceˉwirˉsignature =
        Compilerˉsourceˉwirˉfunctionˉsignatureˉconcrete(
            Input, Scan, Symbols,
            Build.Currentˉmodule,
            Source,
            Declarationˉoffset,
            Compilerˉsourceˉwirˉsentinel(),
            Catalog,
            Compilerˉsourceˉwirˉgenericˉtypeˉcatalog(Build.Genericˉevidence),
            Build.Genericˉinstance
        );
    return Signature.Returnˉshape;
}

fn Compilerˉsourceˉwirˉisˉfoundationˉresult(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Nominal: Sourceˉsymbols.Compilerˉsourceˉsymbolˉmatch
) -> bool {
    if !Nominal.Found || Nominal.Kind !=
        Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Variant {
        return false;
    }
    let View: Sourceˉset.Compilerˉsourceˉsetˉview =
        Sourceˉset.Compilerˉsourceˉsetˉmodule(Input, Scan, Nominal.Module);
    if View.Edition != 1u32 { return false; }
    let Header: Sourceˉdeclarations.Compilerˉsourceˉheader =
        Sourceˉdeclarations.Compilerˉparseˉheaderˉvalidated(View.Source);
    return Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(
            View.Source, Header.Nameˉoffset, Header.Nameˉlength,
            "Foundationˉresult"
        ) &&
        Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(
            View.Source, Nominal.Nameˉoffset, Nominal.Nameˉlength, "Result"
        );
}

fn Compilerˉsourceˉwirˉpropagateˉtry(
    Operand: Compilerˉsourceˉwirˉvalue,
    Returnˉshape: u32,
    Offset: u32,
    Length: u32
) -> Compilerˉsourceˉwirˉbuild {
    let Isˉvalid: Compilerˉsourceˉwirˉvalue = Compilerˉsourceˉwirˉemit(
        Compilerˉsourceˉwirˉvalueˉbuild(Operand),
        WIR_OPERATION_VARIANT_IS_CASE, 4u32,
        Compilerˉsourceˉwirˉoneˉoperand(Operand.Temporary),
        Compilerˉsourceˉwirˉvariantˉtarget(Operand.Shape),
        0u32, Offset, Length
    );
    var Result: Compilerˉsourceˉwirˉbuild =
        Compilerˉsourceˉwirˉvalueˉbuild(Isˉvalid);
    let Successˉblock: u32 = Result.Nextˉblock;
    let Failureˉblock: u32 = Successˉblock + 1u32;
    Result = Compilerˉsourceˉwirˉreserveˉblocks(Result, 2u32);
    Result = Compilerˉsourceˉwirˉcloseˉcurrentˉblock(
        Result, Compilerˉsourceˉwirˉterminator.Branch,
        Isˉvalid.Temporary, Successˉblock, Failureˉblock
    );
    Result = Compilerˉsourceˉwirˉbeginˉreservedˉblock(Result, Failureˉblock);
    var Failureˉtemporary: u32 = Operand.Temporary;
    if Operand.Shape != Returnˉshape {
        let Failureˉpayload: Compilerˉsourceˉwirˉvalue =
            Compilerˉsourceˉwirˉemit(
                Result, WIR_OPERATION_VARIANT_PAYLOAD,
                Sourceˉsymbols.Compilerˉsourceˉsymbolsˉfoundationˉresultˉerrorˉshape(
                    Operand.Shape
                ),
                Compilerˉsourceˉwirˉoneˉoperand(Operand.Temporary),
                Operand.Shape, 1u32, Offset, Length
            );
        let Failureˉbuild: Compilerˉsourceˉwirˉbuild =
            Compilerˉsourceˉwirˉvalueˉbuild(Failureˉpayload);
        let Propagatedˉfailure: Compilerˉsourceˉwirˉvalue =
            Compilerˉsourceˉwirˉemit(
                Failureˉbuild,
                WIR_OPERATION_VARIANT_CREATE, Returnˉshape,
                Compilerˉsourceˉwirˉoneˉoperand(Failureˉpayload.Temporary),
                Returnˉshape, 1u32, Offset, Length
            );
        Result = Compilerˉsourceˉwirˉvalueˉbuild(Propagatedˉfailure);
        Failureˉtemporary = Propagatedˉfailure.Temporary;
    }
    Result = Compilerˉsourceˉwirˉcloseˉcurrentˉblock(
        Result, Compilerˉsourceˉwirˉterminator.Return, Failureˉtemporary,
        Compilerˉsourceˉwirˉsentinel(), Compilerˉsourceˉwirˉsentinel()
    );
    return Compilerˉsourceˉwirˉbeginˉreservedˉblock(Result, Successˉblock);
}

fn Compilerˉsourceˉwirˉcompileˉvalueˉtry(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Source: bytes,
    Offset: u32,
    Line: u32,
    Column: u32,
    Length: u32,
    Operand: Compilerˉsourceˉwirˉvalue,
    Valueˉrequired: bool
) -> Compilerˉsourceˉwirˉvalue {
    let Build: Compilerˉsourceˉwirˉbuild =
        Compilerˉsourceˉwirˉvalueˉbuild(Operand);
    let Returnˉshape: u32 = Compilerˉsourceˉwirˉcurrentˉreturnˉshape(
        Input, Scan, Symbols, Source, Build
    );
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉshapeˉisˉfoundationˉresult(Operand.Shape) ||
        Sourceˉsymbols.Compilerˉsourceˉsymbolsˉshapeˉisˉfoundationˉresult(Returnˉshape) {
        if !Sourceˉsymbols.Compilerˉsourceˉsymbolsˉshapeˉisˉfoundationˉresult(Operand.Shape) ||
            !Sourceˉsymbols.Compilerˉsourceˉsymbolsˉshapeˉisˉfoundationˉresult(Returnˉshape) ||
            Sourceˉsymbols.Compilerˉsourceˉsymbolsˉfoundationˉresultˉerrorˉshape(Operand.Shape) !=
                Sourceˉsymbols.Compilerˉsourceˉsymbolsˉfoundationˉresultˉerrorˉshape(Returnˉshape) {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Build, Compilerˉsourceˉwirˉstatus.Invalidˉtry,
                Build.Currentˉmodule, Offset, Line, Column
            );
        }
        let Genericˉpropagated: Compilerˉsourceˉwirˉbuild =
            Compilerˉsourceˉwirˉpropagateˉtry(
                Operand, Returnˉshape, Offset, Length
            );
        if !Valueˉrequired {
            return Compilerˉsourceˉwirˉvalueˉfrom(
                Genericˉpropagated, 0u32, Compilerˉsourceˉwirˉsentinel()
            );
        }
        return Compilerˉsourceˉwirˉemit(
            Genericˉpropagated, WIR_OPERATION_VARIANT_PAYLOAD,
            Sourceˉsymbols.Compilerˉsourceˉsymbolsˉfoundationˉresultˉvalidˉshape(Operand.Shape),
            Compilerˉsourceˉwirˉoneˉoperand(Operand.Temporary),
            Operand.Shape, 0u32, Offset, Length
        );
    }
    if Operand.Shape < 196608u32 || Returnˉshape < 196608u32 {
        return Compilerˉsourceˉwirˉfailureˉvalue(
            Build, Compilerˉsourceˉwirˉstatus.Invalidˉtry,
            Build.Currentˉmodule,
            Offset, Line, Column
        );
    }
    let Tryˉnominal: Sourceˉsymbols.Compilerˉsourceˉsymbolˉmatch =
        Compilerˉsourceˉwirˉnominalˉbyˉshape(
            Input, Scan, Symbols, Operand.Shape
        );
    let Validˉcase: Compilerˉsourceˉwirˉmember =
        Compilerˉsourceˉwirˉnominalˉmember(
            Input, Scan, Symbols, Tryˉnominal,
            Textˉtoˉutf8("Valid"), 0u32, 5u32
        );
    let Failureˉcase: Compilerˉsourceˉwirˉmember =
        Compilerˉsourceˉwirˉnominalˉmember(
            Input, Scan, Symbols, Tryˉnominal,
            Textˉtoˉutf8("Failure"), 0u32, 7u32
        );
    let Extraˉcase: Compilerˉsourceˉwirˉmember =
        Compilerˉsourceˉwirˉvariantˉcaseˉbyˉindex(
            Input, Scan, Symbols, Operand.Shape - 196608u32, 2u32
        );
    let Validˉview: Compilerˉsourceˉwirˉvariantˉcaseˉview =
        Compilerˉsourceˉwirˉvariantˉcaseˉviewˉbyˉindex(
            Input, Scan, Symbols, Operand.Shape - 196608u32, 0u32
        );
    let Failureˉview: Compilerˉsourceˉwirˉvariantˉcaseˉview =
        Compilerˉsourceˉwirˉvariantˉcaseˉviewˉbyˉindex(
            Input, Scan, Symbols, Operand.Shape - 196608u32, 1u32
        );
    let Validˉfield: Compilerˉsourceˉwirˉmember =
        Compilerˉsourceˉwirˉvariantˉfieldˉbyˉname(
            Input, Scan, Symbols, Operand.Shape - 196608u32, 0u32,
            Textˉtoˉutf8("Value"), 0u32, 5u32
        );
    let Failureˉfield: Compilerˉsourceˉwirˉmember =
        Compilerˉsourceˉwirˉvariantˉfieldˉbyˉname(
            Input, Scan, Symbols, Operand.Shape - 196608u32, 1u32,
            Textˉtoˉutf8("Error"), 0u32, 5u32
        );
    var Accepted: bool = Operand.Shape == Returnˉshape &&
        Validˉcase.Found && Validˉcase.Index == 0u32 &&
        Failureˉcase.Found && Failureˉcase.Index == 1u32 &&
        !Extraˉcase.Found;
    if Valueˉrequired {
        Accepted = Accepted && Compilerˉsourceˉwirˉisˉfoundationˉresult(
                Input, Scan, Tryˉnominal
            ) && Validˉview.Found && Validˉview.Fields == 1u32 &&
            Failureˉview.Found && Failureˉview.Fields == 1u32 &&
            Validˉfield.Found && Validˉfield.Index == 0u32 &&
            Failureˉfield.Found && Failureˉfield.Index == 0u32;
    } else {
        Accepted = Accepted && Validˉcase.Shape == 0u32 &&
            Failureˉcase.Shape != 0u32;
    }
    if !Accepted {
        return Compilerˉsourceˉwirˉfailureˉvalue(
            Build, Compilerˉsourceˉwirˉstatus.Invalidˉtry,
            Tryˉnominal.Module,
            Offset, Line, Column
        );
    }
    let Propagated: Compilerˉsourceˉwirˉbuild =
        Compilerˉsourceˉwirˉpropagateˉtry(
            Operand, Returnˉshape, Offset, Length
        );
    if !Valueˉrequired {
        return Compilerˉsourceˉwirˉvalueˉfrom(
            Propagated, 0u32, Compilerˉsourceˉwirˉsentinel()
        );
    }
    return Compilerˉsourceˉwirˉemit(
        Propagated, WIR_OPERATION_VARIANT_PAYLOAD,
        Validˉfield.Shape,
        Compilerˉsourceˉwirˉoneˉoperand(Operand.Temporary),
        Compilerˉsourceˉwirˉvariantˉtarget(Operand.Shape), 0u32,
        Offset, Length
    );
}

fn Compilerˉsourceˉwirˉexpressionˉisˉliteral(
    Kind: Sourceˉbodies.Compilerˉsourceˉexpressionˉkind
) -> bool {
    return Kind == Sourceˉbodies.Compilerˉsourceˉexpressionˉkind.Integer ||
        Kind == Sourceˉbodies.Compilerˉsourceˉexpressionˉkind.String ||
        Kind == Sourceˉbodies.Compilerˉsourceˉexpressionˉkind.Boolean ||
        Kind == Sourceˉbodies.Compilerˉsourceˉexpressionˉkind.Unit ||
        Kind == Sourceˉbodies.Compilerˉsourceˉexpressionˉkind.Rune ||
        Kind == Sourceˉbodies.Compilerˉsourceˉexpressionˉkind.Floating;
}

fn Compilerˉsourceˉwirˉcompileˉvalueˉblock(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Bindings: Sourceˉbindings.Compilerˉsourceˉbindingˉphase,
    Source: bytes,
    Block: Sourceˉbodies.Compilerˉsourceˉvalueˉblock,
    Blockˉline: u32,
    Blockˉcolumn: u32,
    Returnˉshape: u32,
    Continueˉtarget: u32,
    Breakˉtarget: u32,
    Build: Compilerˉsourceˉwirˉbuild
) -> Compilerˉsourceˉwirˉvalue {
    if Block.Status != Sourceˉbodies.Compilerˉbodyˉparseˉstatus.Valid {
        return Compilerˉsourceˉwirˉfailureˉvalue(
            Build,
            Compilerˉsourceˉwirˉstatus.Invalidˉvalueˉblock,
            Build.Currentˉmodule,
            Block.Failureˉoffset,
            Block.Failureˉline,
            Block.Failureˉcolumn
        );
    }
    var Result: Compilerˉsourceˉwirˉbuild =
        Compilerˉsourceˉwirˉfusedˉfrom(Build, Bindings);
    var Bindingˉphase: Sourceˉbindings.Compilerˉsourceˉbindingˉphase = Bindings;
    if Block.Statements > 0u32 {
        let Statementsˉposition: Sourceˉbodies.Compilerˉsourceˉposition =
            Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
                Source,
                Block.Blockˉoffset,
                Blockˉline,
                Blockˉcolumn,
                Block.Statementsˉoffset
            );
        Result = Compilerˉsourceˉwirˉcompileˉblock(
            Input, Scan, Symbols,
            Bindingˉphase,
            Source,
            Block.Statementsˉoffset,
            Statementsˉposition.Line,
            Statementsˉposition.Column,
            Block.Valueˉoffset,
            Block.Blockˉoffset + Block.Blockˉlength,
            Returnˉshape,
            Continueˉtarget,
            Breakˉtarget,
            Result
        );
        if Result.Status != Compilerˉsourceˉwirˉstatus.Valid {
            return Compilerˉsourceˉwirˉvalueˉfrom(
                Result, 0u32, Compilerˉsourceˉwirˉsentinel()
            );
        }
        Bindingˉphase = Compilerˉsourceˉwirˉbuildˉbindings(Input, Result);
    }
    if !Result.Hasˉcurrentˉblock {
        return Compilerˉsourceˉwirˉvalueˉfrom(
            Result, 10u32, Compilerˉsourceˉwirˉsentinel()
        );
    }
    let Bindingˉbuild: Sourceˉbindings.Compilerˉsourceˉbindingˉbuild =
        Sourceˉbindings.Compilerˉsourceˉbindingsˉphaseˉbuildˉvalue(
            Bindingˉphase
        );
    let Valueˉposition: Sourceˉbodies.Compilerˉsourceˉposition =
        Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
            Source,
            Block.Blockˉoffset,
            Blockˉline,
            Blockˉcolumn,
            Block.Valueˉoffset
        );
    let Valueˉexpression: Sourceˉbodies.Compilerˉsourceˉexpression =
        Sourceˉbodies.Compilerˉparseˉexpressionˉvalidated(
            Source,
            Block.Valueˉoffset,
            Valueˉposition.Line,
            Valueˉposition.Column,
            Block.Blockˉoffset + Block.Blockˉlength,
            0u32,
            0u32
        );
    if Valueˉexpression.Status !=
        Sourceˉbodies.Compilerˉbodyˉparseˉstatus.Valid {
        return Compilerˉsourceˉwirˉfailureˉvalue(
            Result,
            Compilerˉsourceˉwirˉstatus.Invalidˉvalueˉblock,
            Result.Currentˉmodule,
            Valueˉexpression.Failureˉoffset,
            Valueˉexpression.Failureˉline,
            Valueˉexpression.Failureˉcolumn
        );
    }
    if Compilerˉsourceˉwirˉexpressionˉisˉliteral(Valueˉexpression.Kind) {
        return Compilerˉsourceˉwirˉcompileˉliteralˉexpression(
            Input, Scan, Symbols, Source, Valueˉexpression, Result
        );
    }
    return Compilerˉsourceˉwirˉcompileˉexpression(
        Input, Scan, Symbols,
        Bindingˉbuild.Payload,
        Bindingˉbuild.Entries - Bindingˉbuild.Nextˉslot,
        Bindingˉbuild.Entries,
        Source,
        Block.Valueˉoffset,
        Valueˉposition.Line,
        Valueˉposition.Column,
        Block.Blockˉoffset + Block.Blockˉlength,
        Result
    );
}

fn Compilerˉsourceˉwirˉjoinˉbranchˉvalues(
    Failureˉbuild: Compilerˉsourceˉwirˉbuild,
    Failureˉoffset: u32,
    Failureˉline: u32,
    Failureˉcolumn: u32,
    Valueˉoffset: u32,
    Valueˉlength: u32,
    First: Compilerˉsourceˉwirˉvalue,
    Second: Compilerˉsourceˉwirˉvalue
) -> Compilerˉsourceˉwirˉvalue {
    let Firstˉhasˉcurrent: bool = First.Hasˉcurrentˉblock;
    let Firstˉcurrent: u32 = First.Currentˉblock;
    let Firstˉfirst: u32 = First.Currentˉblockˉfirstˉoperation;
    let Firstˉcount: u32 = First.Operations - Firstˉfirst;
    let Secondˉhasˉcurrent: bool = Second.Hasˉcurrentˉblock;
    let Secondˉcurrent: u32 = Second.Currentˉblock;
    let Secondˉfirst: u32 = Second.Currentˉblockˉfirstˉoperation;
    let Secondˉcount: u32 = Second.Operations - Secondˉfirst;
    var Result: Compilerˉsourceˉwirˉbuild =
        Compilerˉsourceˉwirˉwithoutˉcurrentˉblock(
            Compilerˉsourceˉwirˉvalueˉbuild(Second)
        );
    if !Firstˉhasˉcurrent && !Secondˉhasˉcurrent {
        return Compilerˉsourceˉwirˉvalueˉfrom(
            Result, 10u32, Compilerˉsourceˉwirˉsentinel()
        );
    }
    if Firstˉhasˉcurrent && Secondˉhasˉcurrent {
        if First.Shape != Second.Shape {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Result,
                Compilerˉsourceˉwirˉstatus.Typeˉmismatch,
                Failureˉbuild.Currentˉmodule,
                Failureˉoffset,
                Failureˉline,
                Failureˉcolumn
            );
        }
        let Bothˉjoin: u32 = Result.Nextˉblock;
        Result = Compilerˉsourceˉwirˉreserveˉblocks(Result, 1u32);
        Result = Compilerˉsourceˉwirˉappendˉblock(
            Result, Firstˉcurrent, Firstˉfirst, Firstˉcount,
            Compilerˉsourceˉwirˉterminator.Jump,
            Compilerˉsourceˉwirˉsentinel(), Bothˉjoin,
            Compilerˉsourceˉwirˉsentinel()
        );
        Result = Compilerˉsourceˉwirˉappendˉblock(
            Result, Secondˉcurrent, Secondˉfirst, Secondˉcount,
            Compilerˉsourceˉwirˉterminator.Jump,
            Compilerˉsourceˉwirˉsentinel(), Bothˉjoin,
            Compilerˉsourceˉwirˉsentinel()
        );
        return Compilerˉsourceˉwirˉemit(
            Compilerˉsourceˉwirˉbeginˉreservedˉblock(Result, Bothˉjoin),
            WIR_OPERATION_VALUE_PHI,
            First.Shape,
            Compilerˉsourceˉwirˉtwoˉoperands(
                First.Temporary, Second.Temporary
            ),
            Firstˉcurrent,
            Secondˉcurrent,
            Valueˉoffset,
            Valueˉlength
        );
    }
    let Liveˉjoin: u32 = Result.Nextˉblock;
    Result = Compilerˉsourceˉwirˉreserveˉblocks(Result, 1u32);
    if Firstˉhasˉcurrent {
        Result = Compilerˉsourceˉwirˉappendˉblock(
            Result, Firstˉcurrent, Firstˉfirst, Firstˉcount,
            Compilerˉsourceˉwirˉterminator.Jump,
            Compilerˉsourceˉwirˉsentinel(), Liveˉjoin,
            Compilerˉsourceˉwirˉsentinel()
        );
        return Compilerˉsourceˉwirˉvalueˉfrom(
            Compilerˉsourceˉwirˉbeginˉreservedˉblock(Result, Liveˉjoin),
            First.Shape,
            First.Temporary
        );
    }
    Result = Compilerˉsourceˉwirˉappendˉblock(
        Result, Secondˉcurrent, Secondˉfirst, Secondˉcount,
        Compilerˉsourceˉwirˉterminator.Jump,
        Compilerˉsourceˉwirˉsentinel(), Liveˉjoin,
        Compilerˉsourceˉwirˉsentinel()
    );
    return Compilerˉsourceˉwirˉvalueˉfrom(
        Compilerˉsourceˉwirˉbeginˉreservedˉblock(Result, Liveˉjoin),
        Second.Shape,
        Second.Temporary
    );
}

fn Compilerˉsourceˉwirˉcompileˉifˉelseˉbranch(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Source: bytes,
    Expression: Sourceˉbodies.Compilerˉsourceˉexpression,
    Failureˉbuild: Compilerˉsourceˉwirˉbuild,
    First: Compilerˉsourceˉwirˉvalue,
    Elseˉblock: u32
) -> Compilerˉsourceˉwirˉvalue {
    let Elseˉposition: Sourceˉbodies.Compilerˉsourceˉposition =
        Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
            Source, Expression.Offset, Expression.Line, Expression.Column,
            Expression.Secondˉoffset
        );
    let Elseˉtoken: Sourceˉlexer.Compilerˉsourceˉtoken =
        Sourceˉbodies.Compilerˉbodyˉtoken(
            Source,
            Expression.Secondˉoffset,
            Elseˉposition.Line,
            Elseˉposition.Column,
            Expression.Secondˉoffset + Expression.Secondˉlength
        );
    let Elseˉstart: Compilerˉsourceˉwirˉbuild =
        Compilerˉsourceˉwirˉbeginˉreservedˉblock(
            Compilerˉsourceˉwirˉwithoutˉcurrentˉblock(
                Compilerˉsourceˉwirˉvalueˉbuild(First)
            ),
            Elseˉblock
        );
    var Second: Compilerˉsourceˉwirˉvalue =
        Compilerˉsourceˉwirˉvalueˉfrom(
            Elseˉstart, 0u32, Compilerˉsourceˉwirˉsentinel()
        );
    if Elseˉtoken.Kind == Sourceˉlexer.Compilerˉtokenˉkind.If {
        Second = Compilerˉsourceˉwirˉcompileˉexpression(
            Input, Scan, Symbols,
            Elseˉstart.Bindingˉpayload,
            Elseˉstart.Bindingˉentries - Elseˉstart.Bindingˉnextˉslot,
            Elseˉstart.Bindingˉentries,
            Source,
            Expression.Secondˉoffset,
            Elseˉposition.Line,
            Elseˉposition.Column,
            Expression.Secondˉoffset + Expression.Secondˉlength,
            Elseˉstart
        );
    } else {
        let Elseˉblockˉview: Sourceˉbodies.Compilerˉsourceˉvalueˉblock =
            Sourceˉbodies.Compilerˉbodyˉparseˉvalueˉblock(
                Source,
                Expression.Secondˉoffset,
                Elseˉposition.Line,
                Elseˉposition.Column,
                Expression.Offset + Expression.Length,
                0u32
            );
        Second = Compilerˉsourceˉwirˉcompileˉvalueˉblock(
            Input, Scan, Symbols,
            Compilerˉsourceˉwirˉbuildˉbindings(Input, Elseˉstart),
            Source,
            Elseˉblockˉview,
            Elseˉposition.Line,
            Elseˉposition.Column,
            Compilerˉsourceˉwirˉcurrentˉreturnˉshape(
                Input, Scan, Symbols, Source, Elseˉstart
            ),
            Compilerˉsourceˉwirˉsentinel(),
            Compilerˉsourceˉwirˉsentinel(),
            Elseˉstart
        );
    }
    if Second.Status != Compilerˉsourceˉwirˉstatus.Valid { return Second; }
    return Compilerˉsourceˉwirˉjoinˉbranchˉvalues(
        Failureˉbuild,
        Expression.Secondˉoffset,
        Elseˉposition.Line,
        Elseˉposition.Column,
        Expression.Offset,
        Expression.Length,
        First,
        Second
    );
}

fn Compilerˉsourceˉwirˉcompileˉifˉthenˉbranch(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Source: bytes,
    Expression: Sourceˉbodies.Compilerˉsourceˉexpression,
    Failureˉbuild: Compilerˉsourceˉwirˉbuild,
    Condition: Compilerˉsourceˉwirˉvalue
) -> Compilerˉsourceˉwirˉvalue {
    let Thenˉposition: Sourceˉbodies.Compilerˉsourceˉposition =
        Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
            Source, Expression.Offset, Expression.Line, Expression.Column,
            Expression.Firstˉoffset
        );
    let Thenˉblockˉview: Sourceˉbodies.Compilerˉsourceˉvalueˉblock =
        Sourceˉbodies.Compilerˉbodyˉparseˉvalueˉblock(
            Source,
            Expression.Firstˉoffset,
            Thenˉposition.Line,
            Thenˉposition.Column,
            Expression.Offset + Expression.Length,
            0u32
        );
    var Branch: Compilerˉsourceˉwirˉbuild =
        Compilerˉsourceˉwirˉvalueˉbuild(Condition);
    let Thenˉblock: u32 = Branch.Nextˉblock;
    let Elseˉblock: u32 = Thenˉblock + 1u32;
    Branch = Compilerˉsourceˉwirˉreserveˉblocks(Branch, 2u32);
    Branch = Compilerˉsourceˉwirˉcloseˉcurrentˉblock(
        Branch,
        Compilerˉsourceˉwirˉterminator.Branch,
        Condition.Temporary,
        Thenˉblock,
        Elseˉblock
    );
    let First: Compilerˉsourceˉwirˉvalue =
        Compilerˉsourceˉwirˉcompileˉvalueˉblock(
            Input, Scan, Symbols,
            Compilerˉsourceˉwirˉbuildˉbindings(Input, Branch),
            Source,
            Thenˉblockˉview,
            Thenˉposition.Line,
            Thenˉposition.Column,
            Compilerˉsourceˉwirˉcurrentˉreturnˉshape(
                Input, Scan, Symbols, Source, Branch
            ),
            Compilerˉsourceˉwirˉsentinel(),
            Compilerˉsourceˉwirˉsentinel(),
            Compilerˉsourceˉwirˉbeginˉreservedˉblock(Branch, Thenˉblock)
        );
    if First.Status != Compilerˉsourceˉwirˉstatus.Valid { return First; }
    return Compilerˉsourceˉwirˉcompileˉifˉelseˉbranch(
        Input, Scan, Symbols, Source, Expression, Failureˉbuild,
        First, Elseˉblock
    );
}

fn Compilerˉsourceˉwirˉcompileˉifˉexpression(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Bindingˉpayload: bytes,
    Bindingˉfirst: u32,
    Bindingˉentries: u32,
    Source: bytes,
    Expression: Sourceˉbodies.Compilerˉsourceˉexpression,
    Build: Compilerˉsourceˉwirˉbuild
) -> Compilerˉsourceˉwirˉvalue {
    let Conditionˉposition: Sourceˉbodies.Compilerˉsourceˉposition =
        Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
            Source, Expression.Offset, Expression.Line, Expression.Column,
            Expression.Valueˉoffset
        );
    let Condition: Compilerˉsourceˉwirˉvalue =
        Compilerˉsourceˉwirˉcompileˉexpression(
            Input, Scan, Symbols,
            Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
            Source,
            Expression.Valueˉoffset,
            Conditionˉposition.Line,
            Conditionˉposition.Column,
            Expression.Valueˉoffset + Expression.Valueˉlength,
            Build
        );
    if Condition.Status != Compilerˉsourceˉwirˉstatus.Valid { return Condition; }
    var Requiredˉshape: u32 = 4u32;
    if Scan.Version != 2u32 { Requiredˉshape = 0u32; }
    if Condition.Shape == 10u32 {
        if Requiredˉshape == 4u32 { return Condition; }
    }
    if Condition.Shape != Requiredˉshape {
        return Compilerˉsourceˉwirˉfailureˉvalue(
            Compilerˉsourceˉwirˉvalueˉbuild(Condition),
            Compilerˉsourceˉwirˉstatus.Invalidˉcondition,
            Build.Currentˉmodule,
            Expression.Valueˉoffset,
            Conditionˉposition.Line,
            Conditionˉposition.Column
        );
    }
    return Compilerˉsourceˉwirˉcompileˉifˉthenˉbranch(
        Input, Scan, Symbols, Source, Expression, Build, Condition
    );
}

fn Compilerˉsourceˉwirˉcompileˉliteralˉexpression(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Source: bytes,
    Expression: Sourceˉbodies.Compilerˉsourceˉexpression,
    Build: Compilerˉsourceˉwirˉbuild
) -> Compilerˉsourceˉwirˉvalue {
    if Expression.Kind == Sourceˉbodies.Compilerˉsourceˉexpressionˉkind.Integer {
        var Integerˉshape: u32 = 1u32;
        var Integerˉoperation: u32 =
            WIR_OPERATION_I32_CONSTANT;
        if Expression.Numericˉkind == Sourceˉlexer.Compilerˉnumericˉkind.U8 {
            Integerˉshape = 2u32;
            Integerˉoperation = WIR_OPERATION_U8_CONSTANT;
        }
        if Expression.Numericˉkind == Sourceˉlexer.Compilerˉnumericˉkind.U32 {
            Integerˉshape = 3u32;
            Integerˉoperation = WIR_OPERATION_U32_CONSTANT;
        }
        if Expression.Numericˉkind == Sourceˉlexer.Compilerˉnumericˉkind.I64 {
            Integerˉshape = 7u32;
            Integerˉoperation = WIR_OPERATION_I64_CONSTANT;
        }
        if Expression.Numericˉkind == Sourceˉlexer.Compilerˉnumericˉkind.U64 {
            Integerˉshape = 8u32;
            Integerˉoperation = WIR_OPERATION_U64_CONSTANT;
        }
        if Expression.Numericˉkind == Sourceˉlexer.Compilerˉnumericˉkind.I8 {
            Integerˉshape = 11u32;
            Integerˉoperation = WIR_OPERATION_FIXED_INTEGER_CONSTANT;
        }
        if Expression.Numericˉkind == Sourceˉlexer.Compilerˉnumericˉkind.I16 {
            Integerˉshape = 12u32;
            Integerˉoperation = WIR_OPERATION_FIXED_INTEGER_CONSTANT;
        }
        if Expression.Numericˉkind == Sourceˉlexer.Compilerˉnumericˉkind.U16 {
            Integerˉshape = 13u32;
            Integerˉoperation = WIR_OPERATION_FIXED_INTEGER_CONSTANT;
        }
        return Compilerˉsourceˉwirˉemit(
            Build, Integerˉoperation, Integerˉshape,
            Compilerˉsourceˉwirˉempty(Source),
            Expression.Numericˉvalue, Expression.Numericˉhigh,
            Expression.Offset, Expression.Length
        );
    }
    if Expression.Kind == Sourceˉbodies.Compilerˉsourceˉexpressionˉkind.Floating {
        var Floatingˉshape: u32 = 14u32;
        if Expression.Numericˉkind == Sourceˉlexer.Compilerˉnumericˉkind.F64 {
            Floatingˉshape = 15u32;
        }
        return Compilerˉsourceˉwirˉemit(
            Build, WIR_OPERATION_FLOATING_CONSTANT,
            Floatingˉshape, Compilerˉsourceˉwirˉempty(Source),
            Expression.Numericˉvalue, Expression.Numericˉhigh,
            Expression.Offset, Expression.Length
        );
    }
    if Expression.Kind == Sourceˉbodies.Compilerˉsourceˉexpressionˉkind.String {
        return Compilerˉsourceˉwirˉemit(
            Build, WIR_OPERATION_TEXT_CONSTANT, 5u32,
            Compilerˉsourceˉwirˉempty(Source),
            Expression.Valueˉoffset, Expression.Valueˉlength,
            Expression.Offset, Expression.Length
        );
    }
    if Expression.Kind == Sourceˉbodies.Compilerˉsourceˉexpressionˉkind.Boolean {
        var Boolean: u32 = 0u32;
        if Expression.Booleanˉvalue { Boolean = 1u32; }
        return Compilerˉsourceˉwirˉemit(
            Build, WIR_OPERATION_BOOL_CONSTANT, 4u32,
            Compilerˉsourceˉwirˉempty(Source), Boolean, 0u32,
            Expression.Offset, Expression.Length
        );
    }
    if Expression.Kind == Sourceˉbodies.Compilerˉsourceˉexpressionˉkind.Rune {
        return Compilerˉsourceˉwirˉemit(
            Build, WIR_OPERATION_RUNE_CONSTANT, 16u32,
            Compilerˉsourceˉwirˉempty(Source), Expression.Numericˉvalue, 0u32,
            Expression.Offset, Expression.Length
        );
    }
    let View: Sourceˉset.Compilerˉsourceˉsetˉview =
        Sourceˉset.Compilerˉsourceˉsetˉmodule(
            Input, Scan, Build.Currentˉmodule
        );
    if View.Edition != 1u32 {
        return Compilerˉsourceˉwirˉfailureˉvalue(
            Build, Compilerˉsourceˉwirˉstatus.Invalidˉunit,
            Build.Currentˉmodule,
            Expression.Offset, Expression.Line, Expression.Column
        );
    }
    return Compilerˉsourceˉwirˉemit(
        Build, WIR_OPERATION_UNIT_CONSTANT, 9u32,
        Compilerˉsourceˉwirˉempty(Source), 0u32, 0u32,
        Expression.Offset, Expression.Length
    );
}

fn Compilerˉsourceˉwirˉcompileˉunaryˉexpression(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Bindingˉpayload: bytes,
    Bindingˉfirst: u32,
    Bindingˉentries: u32,
    Source: bytes,
    Expression: Sourceˉbodies.Compilerˉsourceˉexpression,
    Build: Compilerˉsourceˉwirˉbuild
) -> Compilerˉsourceˉwirˉvalue {
    let Position: Sourceˉbodies.Compilerˉsourceˉposition =
        Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
            Source, Expression.Offset, Expression.Line, Expression.Column,
            Expression.Firstˉoffset
        );
    let Operand: Compilerˉsourceˉwirˉvalue =
        Compilerˉsourceˉwirˉcompileˉexpression(
            Input, Scan, Symbols,
            Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
            Source, Expression.Firstˉoffset, Position.Line, Position.Column,
            Expression.Firstˉoffset + Expression.Firstˉlength, Build
        );
    if Operand.Status != Compilerˉsourceˉwirˉstatus.Valid ||
        Operand.Shape == 10u32 { return Operand; }
    if Expression.Operator == Sourceˉlexer.Compilerˉtokenˉkind.Try {
        return Compilerˉsourceˉwirˉcompileˉvalueˉtry(
            Input, Scan, Symbols, Source,
            Expression.Offset, Expression.Line, Expression.Column,
            Expression.Length, Operand, true
        );
    }
    if Expression.Operator == Sourceˉlexer.Compilerˉtokenˉkind.Freeze {
        if !Compilerˉsourceˉwirˉshapeˉisˉbuilder(Operand.Shape) {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Compilerˉsourceˉwirˉvalueˉbuild(Operand),
                Compilerˉsourceˉwirˉstatus.Invalidˉbuilder,
                Build.Currentˉmodule,
                Expression.Offset, Expression.Line, Expression.Column
            );
        }
        return Compilerˉsourceˉwirˉemit(
            Compilerˉsourceˉwirˉvalueˉbuild(Operand),
            WIR_OPERATION_BUILDER_FREEZE,
            Operand.Shape - 268435456u32,
            Compilerˉsourceˉwirˉoneˉoperand(Operand.Temporary),
            0u32, 0u32, Expression.Offset, Expression.Length
        );
    }
    var Required: u32 = 4u32;
    var Operation: u32 =
        WIR_OPERATION_BOOL_NOT;
    if Expression.Operator == Sourceˉlexer.Compilerˉtokenˉkind.Minus {
        Required = Operand.Shape;
        if Operand.Shape == 1u32 {
            Operation = WIR_OPERATION_I32_NEGATE;
        } else if Operand.Shape == 7u32 {
            Operation = WIR_OPERATION_I64_NEGATE;
        } else if Operand.Shape == 11u32 || Operand.Shape == 12u32 {
            Operation = WIR_OPERATION_FIXED_INTEGER_NEGATE;
        } else if Operand.Shape == 14u32 || Operand.Shape == 15u32 {
            Operation = WIR_OPERATION_FLOATING_NEGATE;
        } else {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Compilerˉsourceˉwirˉvalueˉbuild(Operand),
                Compilerˉsourceˉwirˉstatus.Invalidˉoperator,
                Build.Currentˉmodule,
                Expression.Offset, Expression.Line, Expression.Column
            );
        }
    }
    if Expression.Operator == Sourceˉlexer.Compilerˉtokenˉkind.Tilde {
        Required = Operand.Shape;
        if Operand.Shape == 2u32 {
            Operation = WIR_OPERATION_U8_BITWISE_NOT;
        } else if Operand.Shape == 3u32 {
            Operation = WIR_OPERATION_U32_BITWISE_NOT;
        } else if Operand.Shape == 8u32 {
            Operation = WIR_OPERATION_U64_BITWISE_NOT;
        } else if Operand.Shape == 13u32 {
            Operation = WIR_OPERATION_FIXED_INTEGER_BITWISE_NOT;
        } else {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Compilerˉsourceˉwirˉvalueˉbuild(Operand),
                Compilerˉsourceˉwirˉstatus.Invalidˉoperator,
                Build.Currentˉmodule,
                Expression.Offset, Expression.Line, Expression.Column
            );
        }
    }
    if Operand.Shape != Required {
        return Compilerˉsourceˉwirˉfailureˉvalue(
            Compilerˉsourceˉwirˉvalueˉbuild(Operand),
            Compilerˉsourceˉwirˉstatus.Invalidˉoperator,
            Build.Currentˉmodule,
            Expression.Offset, Expression.Line, Expression.Column
        );
    }
    return Compilerˉsourceˉwirˉemit(
        Compilerˉsourceˉwirˉvalueˉbuild(Operand), Operation, Required,
        Compilerˉsourceˉwirˉoneˉoperand(Operand.Temporary),
        0u32, 0u32, Expression.Offset, Expression.Length
    );
}

export fn Compilerˉsourceˉwirˉcompileˉexpression(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Bindingˉpayload: bytes,
    Bindingˉfirst: u32,
    Bindingˉentries: u32,
    Source: bytes,
    Offset: u32,
    Line: u32,
    Column: u32,
    Endˉoffset: u32,
    Build: Compilerˉsourceˉwirˉbuild
) -> Compilerˉsourceˉwirˉvalue {
    let Expression: Sourceˉbodies.Compilerˉsourceˉexpression = Sourceˉbodies.Compilerˉparseˉexpressionˉvalidated(
        Source, Offset, Line, Column, Endˉoffset, 0u32, 0u32
    );
    if Expression.Kind == Sourceˉbodies.Compilerˉsourceˉexpressionˉkind.If {
        return Compilerˉsourceˉwirˉcompileˉifˉexpression(
            Input, Scan, Symbols,
            Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
            Source, Expression, Build
        );
    }
    if Expression.Kind == Sourceˉbodies.Compilerˉsourceˉexpressionˉkind.Match {
        let Match: Compilerˉsourceˉwirˉmatchˉview =
            Compilerˉsourceˉwirˉmatchˉview(
                Expression.Offset,
                Expression.Length,
                Expression.Line,
                Expression.Column,
                Expression.Items,
                Expression.Valueˉoffset,
                Expression.Valueˉlength,
                Expression.Firstˉoffset,
                Expression.Firstˉlength
            );
        return Compilerˉsourceˉwirˉcompileˉmatch(
            Input, Scan, Symbols,
            Source, Match, true,
            Compilerˉsourceˉwirˉcurrentˉreturnˉshape(
                Input, Scan, Symbols, Source, Build
            ),
            Compilerˉsourceˉwirˉsentinel(),
            Compilerˉsourceˉwirˉsentinel(),
            Build
        );
    }
    if Compilerˉsourceˉwirˉexpressionˉisˉliteral(Expression.Kind) {
        return Compilerˉsourceˉwirˉcompileˉliteralˉexpression(
            Input, Scan, Symbols, Source, Expression, Build
        );
    }
    if Expression.Kind == Sourceˉbodies.Compilerˉsourceˉexpressionˉkind.Builder {
        let Builderˉtype: Sourceˉsymbols.Compilerˉsourceˉtypeˉbinding = Sourceˉsymbols.Compilerˉsourceˉsymbolsˉbindˉtype(
            Input, Scan, Symbols.Directory, Symbols.Lookup, Symbols.Visibility,
            Build.Currentˉmodule, Source,
            Expression.Valueˉoffset, Expression.Line, Expression.Column,
            Symbols.Records, Symbols.Enums, false
        );
        let Builderˉshape: u32 = Sourceˉbindings.Compilerˉsourceˉbindingsˉshape(Builderˉtype);
        if !Compilerˉsourceˉwirˉshapeˉisˉbuilder(Builderˉshape) {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Build, Compilerˉsourceˉwirˉstatus.Invalidˉbuilder,
                Build.Currentˉmodule,
                Expression.Offset, Expression.Line, Expression.Column
            );
        }
        return Compilerˉsourceˉwirˉemit(
            Build, WIR_OPERATION_BUILDER_CREATE,
            Builderˉshape, Compilerˉsourceˉwirˉempty(Source),
            Compilerˉsourceˉwirˉcollectionˉdescriptor(Builderˉshape),
            Compilerˉsourceˉwirˉcollectionˉmaximum(Builderˉshape),
            Expression.Offset, Expression.Length
        );
    }
    if Expression.Kind == Sourceˉbodies.Compilerˉsourceˉexpressionˉkind.Name {
        return Compilerˉsourceˉwirˉcompileˉname(
            Input, Scan, Symbols, Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
            Source, Expression, Build
        );
    }
    if Expression.Kind == Sourceˉbodies.Compilerˉsourceˉexpressionˉkind.Field {
        return Compilerˉsourceˉwirˉcompileˉfield(
            Input, Scan, Symbols, Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
            Source, Expression, Build
        );
    }
    if Expression.Kind == Sourceˉbodies.Compilerˉsourceˉexpressionˉkind.Unary {
        return Compilerˉsourceˉwirˉcompileˉunaryˉexpression(
            Input, Scan, Symbols,
            Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
            Source, Expression, Build
        );
    }
    if Expression.Kind == Sourceˉbodies.Compilerˉsourceˉexpressionˉkind.Binary {
        let Firstˉposition: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
            Source, Expression.Offset, Expression.Line, Expression.Column,
            Expression.Firstˉoffset
        );
        let Left: Compilerˉsourceˉwirˉvalue = Compilerˉsourceˉwirˉcompileˉexpression(
            Input, Scan, Symbols, Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
            Source,
            Expression.Firstˉoffset, Firstˉposition.Line, Firstˉposition.Column,
            Expression.Firstˉoffset + Expression.Firstˉlength,
            Build
        );
        if Left.Status != Compilerˉsourceˉwirˉstatus.Valid { return Left; }
        if Left.Shape == 10u32 { return Left; }
        if Expression.Operator == Sourceˉlexer.Compilerˉtokenˉkind.Andˉand ||
            Expression.Operator == Sourceˉlexer.Compilerˉtokenˉkind.Orˉor {
            if Left.Shape != 4u32 {
                return Compilerˉsourceˉwirˉfailureˉvalue(
                    Compilerˉsourceˉwirˉvalueˉbuild(Left),
                    Compilerˉsourceˉwirˉstatus.Invalidˉoperator,
                    Build.Currentˉmodule,
                    Expression.Offset, Expression.Line, Expression.Column
                );
            }
            var Branchˉbuild: Compilerˉsourceˉwirˉbuild = Compilerˉsourceˉwirˉvalueˉbuild(Left);
            let Rightˉblock: u32 = Branchˉbuild.Nextˉblock;
            let Shortˉblock: u32 = Rightˉblock + 1u32;
            let Joinˉblock: u32 = Rightˉblock + 2u32;
            Branchˉbuild = Compilerˉsourceˉwirˉreserveˉblocks(Branchˉbuild, 3u32);
            var Trueˉtarget: u32 = Rightˉblock;
            var Falseˉtarget: u32 = Shortˉblock;
            var Shortˉvalue: u32 = 0u32;
            if Expression.Operator == Sourceˉlexer.Compilerˉtokenˉkind.Orˉor {
                Trueˉtarget = Shortˉblock;
                Falseˉtarget = Rightˉblock;
                Shortˉvalue = 1u32;
            }
            Branchˉbuild = Compilerˉsourceˉwirˉcloseˉcurrentˉblock(
                Branchˉbuild,
                Compilerˉsourceˉwirˉterminator.Branch,
                Left.Temporary,
                Trueˉtarget,
                Falseˉtarget
            );
            let Short: Compilerˉsourceˉwirˉvalue = Compilerˉsourceˉwirˉemit(
                Compilerˉsourceˉwirˉbeginˉreservedˉblock(Branchˉbuild, Shortˉblock),
                WIR_OPERATION_BOOL_CONSTANT,
                4u32,
                Compilerˉsourceˉwirˉempty(Source),
                Shortˉvalue,
                0u32,
                Expression.Offset,
                Expression.Length
            );
            let Afterˉshort: Compilerˉsourceˉwirˉbuild = Compilerˉsourceˉwirˉcloseˉcurrentˉblock(
                Compilerˉsourceˉwirˉvalueˉbuild(Short),
                Compilerˉsourceˉwirˉterminator.Jump,
                Compilerˉsourceˉwirˉsentinel(),
                Joinˉblock,
                Compilerˉsourceˉwirˉsentinel()
            );
            let Shortˉrightˉposition: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
                Source, Expression.Offset, Expression.Line, Expression.Column,
                Expression.Secondˉoffset
            );
            let Shortˉright: Compilerˉsourceˉwirˉvalue = Compilerˉsourceˉwirˉcompileˉexpression(
                Input, Scan, Symbols, Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
                Source,
                Expression.Secondˉoffset, Shortˉrightˉposition.Line, Shortˉrightˉposition.Column,
                Expression.Secondˉoffset + Expression.Secondˉlength,
                Compilerˉsourceˉwirˉbeginˉreservedˉblock(Afterˉshort, Rightˉblock)
            );
            if Shortˉright.Status != Compilerˉsourceˉwirˉstatus.Valid { return Shortˉright; }
            if Shortˉright.Shape == 10u32 {
                return Compilerˉsourceˉwirˉvalueˉfrom(
                    Compilerˉsourceˉwirˉbeginˉreservedˉblock(
                        Compilerˉsourceˉwirˉvalueˉbuild(Shortˉright), Joinˉblock
                    ),
                    4u32,
                    Short.Temporary
                );
            }
            if Shortˉright.Shape != 4u32 {
                return Compilerˉsourceˉwirˉfailureˉvalue(
                    Compilerˉsourceˉwirˉvalueˉbuild(Shortˉright),
                    Compilerˉsourceˉwirˉstatus.Invalidˉoperator,
                    Build.Currentˉmodule,
                    Expression.Offset, Expression.Line, Expression.Column
                );
            }
            let Rightˉpredecessor: u32 = Shortˉright.Currentˉblock;
            let Joined: Compilerˉsourceˉwirˉbuild = Compilerˉsourceˉwirˉcloseˉcurrentˉblock(
                Compilerˉsourceˉwirˉvalueˉbuild(Shortˉright),
                Compilerˉsourceˉwirˉterminator.Jump,
                Compilerˉsourceˉwirˉsentinel(),
                Joinˉblock,
                Compilerˉsourceˉwirˉsentinel()
            );
            return Compilerˉsourceˉwirˉemit(
                Compilerˉsourceˉwirˉbeginˉreservedˉblock(Joined, Joinˉblock),
                WIR_OPERATION_VALUE_PHI,
                4u32,
                Compilerˉsourceˉwirˉtwoˉoperands(Short.Temporary, Shortˉright.Temporary),
                Shortˉblock,
                Rightˉpredecessor,
                Expression.Offset,
                Expression.Length
            );
        }
        let Secondˉposition: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
            Source, Expression.Offset, Expression.Line, Expression.Column,
            Expression.Secondˉoffset
        );
        let Right: Compilerˉsourceˉwirˉvalue = Compilerˉsourceˉwirˉcompileˉexpression(
            Input, Scan, Symbols, Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
            Source,
            Expression.Secondˉoffset, Secondˉposition.Line, Secondˉposition.Column,
            Expression.Secondˉoffset + Expression.Secondˉlength,
            Compilerˉsourceˉwirˉvalueˉbuild(Left)
        );
        if Right.Status != Compilerˉsourceˉwirˉstatus.Valid { return Right; }
        if Right.Shape == 10u32 { return Right; }
        var Compatibleˉshapes: bool = Left.Shape == Right.Shape;
        if Expression.Operator == Sourceˉlexer.Compilerˉtokenˉkind.Shiftˉleft ||
            Expression.Operator == Sourceˉlexer.Compilerˉtokenˉkind.Shiftˉright {
            Compatibleˉshapes = Right.Shape == 3u32;
        }
        if !Compatibleˉshapes {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Compilerˉsourceˉwirˉvalueˉbuild(Right),
                Compilerˉsourceˉwirˉstatus.Invalidˉoperator,
                Build.Currentˉmodule,
                Expression.Offset, Expression.Line, Expression.Column
            );
        }
        var Resultˉshape: u32 = Left.Shape;
        var Allowed: bool = false;
        let Fixedˉinteger: bool = Left.Shape >= 11u32 && Left.Shape <= 13u32;
        let Floating: bool = Left.Shape == 14u32 || Left.Shape == 15u32;
        let Arithmeticˉshape: bool = Left.Shape == 1u32 ||
            Left.Shape == 3u32 || Left.Shape == 7u32 ||
            Left.Shape == 8u32 || Fixedˉinteger;
        let Bitwiseˉshape: bool = Left.Shape == 2u32 ||
            Left.Shape == 3u32 || Left.Shape == 8u32 || Left.Shape == 13u32;
        if Expression.Operator == Sourceˉlexer.Compilerˉtokenˉkind.Plus ||
            Expression.Operator == Sourceˉlexer.Compilerˉtokenˉkind.Minus ||
            Expression.Operator == Sourceˉlexer.Compilerˉtokenˉkind.Star {
            Allowed = Arithmeticˉshape || Floating;
        }
        if Expression.Operator == Sourceˉlexer.Compilerˉtokenˉkind.Slash {
            Allowed = Arithmeticˉshape || Floating;
        }
        if Expression.Operator == Sourceˉlexer.Compilerˉtokenˉkind.Percent {
            Allowed = Arithmeticˉshape;
        }
        if Expression.Operator == Sourceˉlexer.Compilerˉtokenˉkind.Ampersand ||
            Expression.Operator == Sourceˉlexer.Compilerˉtokenˉkind.Pipe ||
            Expression.Operator == Sourceˉlexer.Compilerˉtokenˉkind.Caret ||
            Expression.Operator == Sourceˉlexer.Compilerˉtokenˉkind.Shiftˉleft ||
            Expression.Operator == Sourceˉlexer.Compilerˉtokenˉkind.Shiftˉright {
            Allowed = Bitwiseˉshape;
        }
        if Expression.Operator == Sourceˉlexer.Compilerˉtokenˉkind.Less ||
            Expression.Operator == Sourceˉlexer.Compilerˉtokenˉkind.Lessˉequals ||
            Expression.Operator == Sourceˉlexer.Compilerˉtokenˉkind.Greater ||
            Expression.Operator == Sourceˉlexer.Compilerˉtokenˉkind.Greaterˉequals {
            Allowed = Arithmeticˉshape || Floating;
            Resultˉshape = 4u32;
        }
        if Expression.Operator == Sourceˉlexer.Compilerˉtokenˉkind.Equalsˉequals ||
            Expression.Operator == Sourceˉlexer.Compilerˉtokenˉkind.Bangˉequals {
            Allowed = Left.Shape >= 1u32;
            if Left.Shape > 8u32 {
                Allowed = Fixedˉinteger;
                if !Fixedˉinteger {
                    Allowed = Floating || Left.Shape == 16u32 ||
                        Left.Shape >= 131072u32 + Symbols.Records;
                    if Left.Shape >= 131072u32 + Symbols.Records + Symbols.Enums {
                        Allowed = false;
                    }
                }
            }
            Resultˉshape = 4u32;
        }
        if !Allowed {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Compilerˉsourceˉwirˉvalueˉbuild(Right),
                Compilerˉsourceˉwirˉstatus.Invalidˉoperator,
                Build.Currentˉmodule,
                Expression.Offset, Expression.Line, Expression.Column
            );
        }
        var Binaryˉtarget: u32 = 0u32;
        if Fixedˉinteger && Resultˉshape == 4u32 { Binaryˉtarget = Left.Shape; }
        if Floating && Resultˉshape == 4u32 { Binaryˉtarget = Left.Shape; }
        return Compilerˉsourceˉwirˉemit(
            Compilerˉsourceˉwirˉvalueˉbuild(Right),
            Compilerˉsourceˉwirˉbinaryˉoperation(Expression.Operator, Left.Shape),
            Resultˉshape,
            Compilerˉsourceˉwirˉtwoˉoperands(Left.Temporary, Right.Temporary),
            Binaryˉtarget, 0u32, Expression.Offset, Expression.Length
        );
    }
    if Expression.Kind == Sourceˉbodies.Compilerˉsourceˉexpressionˉkind.Index {
        let Indexˉposition: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
            Source, Expression.Offset, Expression.Line, Expression.Column,
            Expression.Firstˉoffset
        );
        let Index: Compilerˉsourceˉwirˉvalue = Compilerˉsourceˉwirˉcompileˉexpression(
            Input, Scan, Symbols, Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
            Source,
            Expression.Firstˉoffset, Indexˉposition.Line, Indexˉposition.Column,
            Expression.Firstˉoffset + Expression.Firstˉlength,
            Build
        );
        if Index.Status != Compilerˉsourceˉwirˉstatus.Valid { return Index; }
        if Index.Shape == 10u32 { return Index; }
        let Indexedˉlocal: Sourceˉbindings.Compilerˉsourceˉlocalˉmatch = Sourceˉbindings.Compilerˉsourceˉbindingsˉfindˉlocal(
            Source, Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
            Expression.Valueˉoffset, Expression.Valueˉlength, Expression.Offset
        );
        if Indexedˉlocal.Found {
            if !Compilerˉsourceˉwirˉshapeˉisˉsequence(Indexedˉlocal.Shape) || Index.Shape != 3u32 {
                return Compilerˉsourceˉwirˉfailureˉvalue(
                    Compilerˉsourceˉwirˉvalueˉbuild(Index),
                    Compilerˉsourceˉwirˉstatus.Invalidˉindex,
                    Build.Currentˉmodule,
                    Expression.Offset, Expression.Line, Expression.Column
                );
            }
            let Indexedˉsequence: Compilerˉsourceˉwirˉvalue = Compilerˉsourceˉwirˉemit(
                Compilerˉsourceˉwirˉvalueˉbuild(Index),
                WIR_OPERATION_LOAD_LOCAL,
                Indexedˉlocal.Shape, Compilerˉsourceˉwirˉempty(Source),
                Indexedˉlocal.Slot, 0u32,
                Expression.Valueˉoffset, Expression.Valueˉlength
            );
            return Compilerˉsourceˉwirˉemit(
                Compilerˉsourceˉwirˉvalueˉbuild(Indexedˉsequence),
                WIR_OPERATION_SEQUENCE_ELEMENT,
                Compilerˉsourceˉwirˉcollectionˉelementˉshape(Indexedˉlocal.Shape),
                Compilerˉsourceˉwirˉtwoˉoperands(Indexedˉsequence.Temporary, Index.Temporary),
                0u32, 0u32, Expression.Offset, Expression.Length
            );
        }
        if Index.Shape != 1u32 {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Compilerˉsourceˉwirˉvalueˉbuild(Index),
                Compilerˉsourceˉwirˉstatus.Invalidˉindex,
                Build.Currentˉmodule,
                Expression.Firstˉoffset, Indexˉposition.Line, Indexˉposition.Column
            );
        }
        let Data: Sourceˉbindings.Compilerˉsourceˉbindingˉmatch = Sourceˉbindings.Compilerˉsourceˉbindingsˉfindˉdeclaration(
            Input, Scan, Symbols, Build.Currentˉmodule, Source,
            Expression.Valueˉoffset, Expression.Valueˉlength,
            Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Data
        );
        if !Data.Found || !Data.Accessible {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Compilerˉsourceˉwirˉvalueˉbuild(Index),
                Compilerˉsourceˉwirˉstatus.Invalidˉdataˉuse,
                Data.Module,
                Expression.Valueˉoffset, Expression.Line, Expression.Column
            );
        }
        if Compilerˉsourceˉwirˉdataˉkind(Input, Scan, Symbols, Data) != Compilerˉsourceˉwirˉdataˉkind.I32ˉarray {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Compilerˉsourceˉwirˉvalueˉbuild(Index),
                Compilerˉsourceˉwirˉstatus.Invalidˉdataˉuse,
                Data.Module,
                Expression.Valueˉoffset, Expression.Line, Expression.Column
            );
        }
        return Compilerˉsourceˉwirˉemit(
            Compilerˉsourceˉwirˉvalueˉbuild(Index),
            WIR_OPERATION_DATA_LOAD_I32,
            1u32,
            Compilerˉsourceˉwirˉoneˉoperand(Index.Temporary),
            Data.Directoryˉentry, 0u32,
            Expression.Offset, Expression.Length
        );
    }
    if Expression.Kind == Sourceˉbodies.Compilerˉsourceˉexpressionˉkind.Namedˉrecord ||
        Expression.Kind == Sourceˉbodies.Compilerˉsourceˉexpressionˉkind.Recordˉupdate ||
        Expression.Kind ==
            Sourceˉbodies.Compilerˉsourceˉexpressionˉkind.Genericˉnamedˉrecord {
        return Compilerˉsourceˉwirˉcompileˉnamedˉrecord(
            Input, Scan, Symbols, Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
            Source, Expression, Build
        );
    }
    return Compilerˉsourceˉwirˉcompileˉcall(
        Input, Scan, Symbols, Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
        Source, Expression, Build
    );
}

fn Compilerˉsourceˉwirˉfunctionˉgenericˉformal(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Callable: Sourceˉbindings.Compilerˉsourceˉbindingˉmatch,
    Argument: u32
) -> Compilerˉsourceˉwirˉgenericˉformal {
    let Emptyˉformalˉsource: bytes = Compilerˉsourceˉwirˉempty(Input);
    let Emptyˉformalˉgeneric: Sourceˉsymbols.Compilerˉsourceˉfunctionˉgeneric =
        Sourceˉsymbols.Compilerˉsourceˉfunctionˉgeneric(
            0u32, 0u32, 1u32, 1u32, 0u32, 1u32, 1u32
        );
    if Callable.Kind != Sourceˉbindings.Compilerˉsourceˉcallableˉkind.Function {
        return Compilerˉsourceˉwirˉgenericˉformal(
            false, Emptyˉformalˉsource, Emptyˉformalˉgeneric,
            0u32, 1u32, 1u32
        );
    }
    let Formalˉentry: u32 = 16u32 + Callable.Directoryˉentry * 24u32;
    let Formalˉdeclarationˉoffset: u32 = Bytesˉreadˉu32ˉlittle(
        Symbols.Directory, Formalˉentry + 8u32
    );
    let Formalˉview: Sourceˉset.Compilerˉsourceˉsetˉview =
        Sourceˉset.Compilerˉsourceˉsetˉmodule(Input, Scan, Callable.Module);
    let Formalˉsource: bytes = Formalˉview.Source;
    let Formalˉdeclarationˉposition: Sourceˉbodies.Compilerˉsourceˉposition =
        Sourceˉbodies.Compilerˉsourceˉposition(
            Formalˉdeclarationˉoffset, 1u32, 1u32
        );
    let Formalˉdeclaration: Sourceˉdeclarations.Compilerˉsourceˉdeclaration =
        Sourceˉdeclarations.Compilerˉparseˉnextˉdeclarationˉvalidated(
            Formalˉsource, Formalˉdeclarationˉoffset,
            Formalˉdeclarationˉposition.Line,
            Formalˉdeclarationˉposition.Column, true
        );
    let Formalˉgeneric: Sourceˉsymbols.Compilerˉsourceˉfunctionˉgeneric =
        Sourceˉsymbols.Compilerˉsourceˉsymbolsˉfunctionˉgeneric(
            Formalˉsource, Formalˉdeclaration,
            Formalˉdeclarationˉposition.Line,
            Formalˉdeclarationˉposition.Column
        );
    let Formalˉleft: Sourceˉlexer.Compilerˉsourceˉtoken =
        Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Formalˉsource, Formalˉgeneric.Signatureˉoffset,
            Formalˉgeneric.Signatureˉline, Formalˉgeneric.Signatureˉcolumn
        );
    var Formalˉcursor: u32 = Formalˉleft.Nextˉoffset;
    var Formalˉline: u32 = Formalˉleft.Nextˉline;
    var Formalˉcolumn: u32 = Formalˉleft.Nextˉcolumn;
    var Formalˉindex: u32 = 0u32;
    while Formalˉindex < Formalˉdeclaration.Items {
        let Formalˉparameter: Sourceˉlexer.Compilerˉsourceˉtoken =
            Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                Formalˉsource, Formalˉcursor, Formalˉline, Formalˉcolumn
            );
        let Formalˉcolon: Sourceˉlexer.Compilerˉsourceˉtoken =
            Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                Formalˉsource, Formalˉparameter.Nextˉoffset,
                Formalˉparameter.Nextˉline, Formalˉparameter.Nextˉcolumn
            );
        if Formalˉindex == Argument {
            return Compilerˉsourceˉwirˉgenericˉformal(
                true, Formalˉsource, Formalˉgeneric,
                Formalˉcolon.Nextˉoffset,
                Formalˉcolon.Nextˉline,
                Formalˉcolon.Nextˉcolumn
            );
        }
        let Formalˉtype: Sourceˉdeclarations.Compilerˉparseˉstep =
            Sourceˉdeclarations.Compilerˉparseˉtype(
                Formalˉsource,
                Formalˉcolon.Nextˉoffset,
                Formalˉcolon.Nextˉline,
                Formalˉcolon.Nextˉcolumn,
                false, false
            );
        let Formalˉseparator: Sourceˉlexer.Compilerˉsourceˉtoken =
            Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                Formalˉsource, Formalˉtype.Nextˉoffset,
                Formalˉtype.Nextˉline, Formalˉtype.Nextˉcolumn
            );
        Formalˉcursor = Formalˉseparator.Nextˉoffset;
        Formalˉline = Formalˉseparator.Nextˉline;
        Formalˉcolumn = Formalˉseparator.Nextˉcolumn;
        Formalˉindex = Formalˉindex + 1u32;
    }
    if Argument == Compilerˉsourceˉwirˉsentinel() {
        if Formalˉdeclaration.Items == 0u32 {
            let Formalˉright: Sourceˉlexer.Compilerˉsourceˉtoken =
                Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                    Formalˉsource, Formalˉcursor,
                    Formalˉline, Formalˉcolumn
                );
            Formalˉcursor = Formalˉright.Nextˉoffset;
            Formalˉline = Formalˉright.Nextˉline;
            Formalˉcolumn = Formalˉright.Nextˉcolumn;
        }
        let Formalˉarrow: Sourceˉlexer.Compilerˉsourceˉtoken =
            Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                Formalˉsource, Formalˉcursor,
                Formalˉline, Formalˉcolumn
            );
        return Compilerˉsourceˉwirˉgenericˉformal(
            true, Formalˉsource, Formalˉgeneric,
            Formalˉarrow.Nextˉoffset,
            Formalˉarrow.Nextˉline,
            Formalˉarrow.Nextˉcolumn
        );
    }
    return Compilerˉsourceˉwirˉgenericˉformal(
        false, Emptyˉformalˉsource, Emptyˉformalˉgeneric,
        0u32, 1u32, 1u32
    );
}

fn Compilerˉsourceˉwirˉgenericˉcontributionˉvalue(
    Valid: bool,
    Matched: bool,
    Solution: Sourceˉgenerics.Compilerˉsourceˉgenericˉsolution
) -> Compilerˉsourceˉwirˉgenericˉcontribution {
    return Compilerˉsourceˉwirˉgenericˉcontribution(
        Valid, Matched, Solution
    );
}

fn Compilerˉsourceˉwirˉgenericˉcontributeˉnominalˉformal(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Callable: Sourceˉbindings.Compilerˉsourceˉbindingˉmatch,
    Pattern: Compilerˉsourceˉwirˉgenericˉformal,
    Actualˉshape: u32,
    Originˉargument: u32,
    Originˉoffset: u32,
    Typeˉcatalog: Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog,
    Solution: Sourceˉgenerics.Compilerˉsourceˉgenericˉsolution
) -> Compilerˉsourceˉwirˉgenericˉcontribution {
    let Patternˉtoken: Sourceˉlexer.Compilerˉsourceˉtoken =
        Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Pattern.Source, Pattern.Offset, Pattern.Line, Pattern.Column
        );
    if Patternˉtoken.Kind != Sourceˉlexer.Compilerˉtokenˉkind.Identifier ||
        !Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉshapeˉisˉprivate(
            Actualˉshape
        ) {
        return Compilerˉsourceˉwirˉgenericˉcontributionˉvalue(
            true, false, Solution
        );
    }
    let Qualified: Sourceˉdeclarations.Compilerˉparseˉstep =
        Sourceˉdeclarations.Compilerˉparseˉqualifiedˉname(
            Pattern.Source, Pattern.Offset, Pattern.Line, Pattern.Column, false
        );
    let Left: Sourceˉlexer.Compilerˉsourceˉtoken =
        Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Pattern.Source, Qualified.Nextˉoffset,
            Qualified.Nextˉline, Qualified.Nextˉcolumn
        );
    if Left.Kind != Sourceˉlexer.Compilerˉtokenˉkind.Less {
        return Compilerˉsourceˉwirˉgenericˉcontributionˉvalue(
            true, false, Solution
        );
    }
    let Match: Sourceˉsymbols.Compilerˉsourceˉsymbolˉmatch =
        Sourceˉsymbols.Compilerˉsourceˉsymbolsˉfindˉownedˉnominal(
            Input, Scan, Symbols.Directory, Symbols.Lookup,
            Callable.Module, Pattern.Source, Patternˉtoken.Offset,
            Qualified.Nextˉoffset - Patternˉtoken.Offset
        );
    let Actualˉinstance: u32 =
        Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉshapeˉinstance(
            Actualˉshape
        );
    if !Match.Found ||
        Actualˉinstance >=
            Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalogˉinstances(
                Typeˉcatalog
            ) ||
        Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalogˉinstanceˉdeclaration(
            Typeˉcatalog, Actualˉinstance
        ) != Match.Directoryˉindex {
        return Compilerˉsourceˉwirˉgenericˉcontributionˉvalue(
            false, true, Solution
        );
    }
    let Target: Sourceˉset.Compilerˉsourceˉsetˉview =
        Sourceˉset.Compilerˉsourceˉsetˉmodule(Input, Scan, Match.Module);
    let Declaration: Sourceˉdeclarations.Compilerˉsourceˉdeclaration =
        Sourceˉdeclarations.Compilerˉparseˉnextˉdeclarationˉvalidated(
            Target.Source, Match.Declarationˉoffset, 1u32, 1u32, true
        );
    let Generic: Sourceˉsymbols.Compilerˉsourceˉfunctionˉgeneric =
        Sourceˉsymbols.Compilerˉsourceˉsymbolsˉfunctionˉgeneric(
            Target.Source, Declaration, 1u32, 1u32
        );
    if Generic.Parameters == 0u32 ||
        Generic.Parameters !=
            Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalogˉinstanceˉparameters(
                Typeˉcatalog, Actualˉinstance
            ) {
        return Compilerˉsourceˉwirˉgenericˉcontributionˉvalue(
            false, true, Solution
        );
    }
    var Working: Sourceˉgenerics.Compilerˉsourceˉgenericˉsolution = Solution;
    var Cursor: u32 = Left.Nextˉoffset;
    var Currentˉline: u32 = Left.Nextˉline;
    var Currentˉcolumn: u32 = Left.Nextˉcolumn;
    var Parameter: u32 = 0u32;
    while Parameter < Generic.Parameters {
        let Argumentˉtoken: Sourceˉlexer.Compilerˉsourceˉtoken =
            Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                Pattern.Source, Cursor, Currentˉline, Currentˉcolumn
            );
        let Declared:
            Sourceˉsymbols.Compilerˉsourceˉgenericˉparameterˉmatch =
            Sourceˉsymbols.Compilerˉsourceˉsymbolsˉgenericˉparameterˉat(
                Target.Source, Generic, Parameter
            );
        let Actual: Sourceˉgenerics.Compilerˉsourceˉgenericˉargument =
            Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalogˉargument(
                Typeˉcatalog, Actualˉinstance, Parameter
            );
        let Formal:
            Sourceˉsymbols.Compilerˉsourceˉgenericˉparameterˉmatch =
            Sourceˉsymbols.Compilerˉsourceˉsymbolsˉgenericˉparameter(
                Pattern.Source, Pattern.Generic,
                Argumentˉtoken.Offset, Argumentˉtoken.Length
            );
        var Nextˉoffset: u32 = Argumentˉtoken.Nextˉoffset;
        var Nextˉline: u32 = Argumentˉtoken.Nextˉline;
        var Nextˉcolumn: u32 = Argumentˉtoken.Nextˉcolumn;
        if !Declared.Found || !Actual.Valid {
            return Compilerˉsourceˉwirˉgenericˉcontributionˉvalue(
                false, true, Working
            );
        }
        if Formal.Found {
            var Formalˉkind: u32 = 2u32;
            if Formal.Isˉtype { Formalˉkind = 1u32; }
            if Declared.Isˉtype != Formal.Isˉtype ||
                Actual.Kind != Formalˉkind ||
                (!Formal.Isˉtype &&
                    (Formal.Shape != Declared.Shape ||
                        Actual.Shape != Declared.Shape)) {
                return Compilerˉsourceˉwirˉgenericˉcontributionˉvalue(
                    false, true, Working
                );
            }
            Working =
                Sourceˉgenerics.Compilerˉsourceˉgenericˉsolutionˉcontribute(
                    Working, Formal.Index, Actual.Kind,
                    Actual.Low, Actual.High,
                    Originˉargument, Originˉoffset
                );
        } else if Declared.Isˉtype {
            let Concrete:
                Genericˉtypeˉbinding.Compilerˉsourceˉgenericˉtypeˉbinding =
                Genericˉtypeˉbinding.Compilerˉsourceˉgenericˉtypeˉbind(
                    Input, Scan, Symbols, Callable.Module, Pattern.Source,
                    Cursor, Currentˉline, Currentˉcolumn, Typeˉcatalog
                );
            if Concrete.Status !=
                    Sourceˉsymbols.Compilerˉsourceˉsymbolˉstatus.Valid ||
                Concrete.Genericˉstatus !=
                    Sourceˉgenerics.Compilerˉsourceˉgenericˉstatus.Valid ||
                Actual.Kind != 1u32 || Concrete.Shape != Actual.Low {
                return Compilerˉsourceˉwirˉgenericˉcontributionˉvalue(
                    false, true, Working
                );
            }
            Nextˉoffset = Concrete.Nextˉoffset;
            Nextˉline = Concrete.Nextˉline;
            Nextˉcolumn = Concrete.Nextˉcolumn;
        } else if Argumentˉtoken.Kind !=
                Sourceˉlexer.Compilerˉtokenˉkind.Integer ||
            Actual.Kind != 2u32 || Actual.Shape != Declared.Shape ||
            Actual.Low != Argumentˉtoken.Numericˉvalue ||
            Actual.High != Argumentˉtoken.Numericˉhigh {
            return Compilerˉsourceˉwirˉgenericˉcontributionˉvalue(
                false, true, Working
            );
        }
        if Working.Status !=
                Sourceˉgenerics.Compilerˉsourceˉgenericˉstatus.Valid {
            return Compilerˉsourceˉwirˉgenericˉcontributionˉvalue(
                false, true, Working
            );
        }
        let Separator: Sourceˉlexer.Compilerˉsourceˉtoken =
            Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                Pattern.Source, Nextˉoffset, Nextˉline, Nextˉcolumn
            );
        Cursor = Separator.Nextˉoffset;
        Currentˉline = Separator.Nextˉline;
        Currentˉcolumn = Separator.Nextˉcolumn;
        Parameter = Parameter + 1u32;
    }
    return Compilerˉsourceˉwirˉgenericˉcontributionˉvalue(
        true, true, Working
    );
}

fn Compilerˉsourceˉwirˉgenericˉcontributeˉformal(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Callable: Sourceˉbindings.Compilerˉsourceˉbindingˉmatch,
    Argument: u32,
    Actualˉshape: u32,
    Originˉargument: u32,
    Originˉoffset: u32,
    Typeˉcatalog: Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog,
    Solution: Sourceˉgenerics.Compilerˉsourceˉgenericˉsolution
) -> Compilerˉsourceˉwirˉgenericˉcontribution {
    let Patternˉformal: Compilerˉsourceˉwirˉgenericˉformal =
        Compilerˉsourceˉwirˉfunctionˉgenericˉformal(
            Input, Scan, Symbols, Callable, Argument
        );
    if !Patternˉformal.Found {
        return Compilerˉsourceˉwirˉgenericˉcontributionˉvalue(
            true, false, Solution
        );
    }
    let Patternˉtoken: Sourceˉlexer.Compilerˉsourceˉtoken =
        Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Patternˉformal.Source, Patternˉformal.Offset,
            Patternˉformal.Line, Patternˉformal.Column
        );
    if Patternˉtoken.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Identifier {
        let Patternˉdirect: Sourceˉsymbols.Compilerˉsourceˉgenericˉparameterˉmatch =
            Sourceˉsymbols.Compilerˉsourceˉsymbolsˉgenericˉparameter(
                Patternˉformal.Source, Patternˉformal.Generic,
                Patternˉtoken.Offset, Patternˉtoken.Length
            );
        if Patternˉdirect.Found {
            if !Patternˉdirect.Isˉtype {
                return Compilerˉsourceˉwirˉgenericˉcontributionˉvalue(
                    false, true, Solution
                );
            }
            let Patternˉdirectˉsolution:
                Sourceˉgenerics.Compilerˉsourceˉgenericˉsolution =
                Sourceˉgenerics.Compilerˉsourceˉgenericˉsolutionˉcontribute(
                    Solution, Patternˉdirect.Index, 1u32,
                    Actualˉshape, 0u32, Originˉargument, Originˉoffset
                );
            return Compilerˉsourceˉwirˉgenericˉcontributionˉvalue(
                Patternˉdirectˉsolution.Status ==
                    Sourceˉgenerics.Compilerˉsourceˉgenericˉstatus.Valid,
                true, Patternˉdirectˉsolution
            );
        }
    }
    let Nominal: Compilerˉsourceˉwirˉgenericˉcontribution =
        Compilerˉsourceˉwirˉgenericˉcontributeˉnominalˉformal(
            Input, Scan, Symbols, Callable, Patternˉformal,
            Actualˉshape, Originˉargument, Originˉoffset,
            Typeˉcatalog, Solution
        );
    if Nominal.Matched { return Nominal; }
    let Patternˉisˉsequence: bool = Patternˉtoken.Kind ==
        Sourceˉlexer.Compilerˉtokenˉkind.Sequence;
    let Patternˉisˉbuilder: bool = Patternˉtoken.Kind ==
        Sourceˉlexer.Compilerˉtokenˉkind.Builder;
    if !Patternˉisˉsequence && !Patternˉisˉbuilder {
        return Compilerˉsourceˉwirˉgenericˉcontributionˉvalue(
            true, false, Solution
        );
    }
    let Patternˉleft: Sourceˉlexer.Compilerˉsourceˉtoken =
        Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Patternˉformal.Source, Patternˉtoken.Nextˉoffset,
            Patternˉtoken.Nextˉline, Patternˉtoken.Nextˉcolumn
        );
    let Patternˉelement: Sourceˉlexer.Compilerˉsourceˉtoken =
        Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Patternˉformal.Source, Patternˉleft.Nextˉoffset,
            Patternˉleft.Nextˉline, Patternˉleft.Nextˉcolumn
        );
    let Patternˉelementˉtype: Sourceˉdeclarations.Compilerˉparseˉstep =
        Sourceˉdeclarations.Compilerˉparseˉtype(
            Patternˉformal.Source, Patternˉleft.Nextˉoffset,
            Patternˉleft.Nextˉline, Patternˉleft.Nextˉcolumn,
            false, false
        );
    let Patternˉcomma: Sourceˉlexer.Compilerˉsourceˉtoken =
        Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Patternˉformal.Source, Patternˉelementˉtype.Nextˉoffset,
            Patternˉelementˉtype.Nextˉline,
            Patternˉelementˉtype.Nextˉcolumn
        );
    let Patternˉmaximum: Sourceˉlexer.Compilerˉsourceˉtoken =
        Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Patternˉformal.Source, Patternˉcomma.Nextˉoffset,
            Patternˉcomma.Nextˉline, Patternˉcomma.Nextˉcolumn
        );
    let Patternˉelementˉparameter:
        Sourceˉsymbols.Compilerˉsourceˉgenericˉparameterˉmatch =
        Sourceˉsymbols.Compilerˉsourceˉsymbolsˉgenericˉparameter(
            Patternˉformal.Source, Patternˉformal.Generic,
            Patternˉelement.Offset, Patternˉelement.Length
        );
    let Patternˉmaximumˉparameter:
        Sourceˉsymbols.Compilerˉsourceˉgenericˉparameterˉmatch =
        Sourceˉsymbols.Compilerˉsourceˉsymbolsˉgenericˉparameter(
            Patternˉformal.Source, Patternˉformal.Generic,
            Patternˉmaximum.Offset, Patternˉmaximum.Length
        );
    let Patternˉmatched: bool = Patternˉelementˉparameter.Found ||
        Patternˉmaximumˉparameter.Found;
    if !Patternˉmatched {
        return Compilerˉsourceˉwirˉgenericˉcontributionˉvalue(
            true, false, Solution
        );
    }
    if (Patternˉisˉsequence &&
            !Compilerˉsourceˉwirˉshapeˉisˉsequence(Actualˉshape)) ||
        (Patternˉisˉbuilder &&
            !Compilerˉsourceˉwirˉshapeˉisˉbuilder(Actualˉshape)) {
        return Compilerˉsourceˉwirˉgenericˉcontributionˉvalue(
            false, true, Solution
        );
    }
    let Patternˉactualˉelement: u32 =
        Compilerˉsourceˉwirˉcollectionˉelementˉshape(Actualˉshape);
    let Patternˉactualˉmaximum: u32 =
        Compilerˉsourceˉwirˉcollectionˉmaximum(Actualˉshape);
    var Patternˉsolution: Sourceˉgenerics.Compilerˉsourceˉgenericˉsolution =
        Solution;
    if Patternˉelementˉparameter.Found {
        if !Patternˉelementˉparameter.Isˉtype {
            return Compilerˉsourceˉwirˉgenericˉcontributionˉvalue(
                false, true, Patternˉsolution
            );
        }
        Patternˉsolution =
            Sourceˉgenerics.Compilerˉsourceˉgenericˉsolutionˉcontribute(
                Patternˉsolution, Patternˉelementˉparameter.Index, 1u32,
                Patternˉactualˉelement, 0u32,
                Originˉargument, Originˉoffset
            );
    } else {
        let Patternˉconcreteˉelement:
            Sourceˉsymbols.Compilerˉsourceˉtypeˉbinding =
            Sourceˉsymbols.Compilerˉsourceˉsymbolsˉbindˉtype(
                Input, Scan, Symbols.Directory, Symbols.Lookup,
                Symbols.Visibility, Callable.Module, Patternˉformal.Source,
                Patternˉleft.Nextˉoffset,
                Patternˉleft.Nextˉline,
                Patternˉleft.Nextˉcolumn,
                Symbols.Records, Symbols.Enums, false
            );
        if Patternˉconcreteˉelement.Status !=
                Sourceˉsymbols.Compilerˉsourceˉsymbolˉstatus.Valid ||
            Sourceˉsymbols.Compilerˉsourceˉsymbolsˉtypeˉshape(
                Patternˉconcreteˉelement
            ) != Patternˉactualˉelement {
            return Compilerˉsourceˉwirˉgenericˉcontributionˉvalue(
                false, true, Patternˉsolution
            );
        }
    }
    if Patternˉsolution.Status !=
            Sourceˉgenerics.Compilerˉsourceˉgenericˉstatus.Valid {
        return Compilerˉsourceˉwirˉgenericˉcontributionˉvalue(
            false, true, Patternˉsolution
        );
    }
    if Patternˉmaximumˉparameter.Found {
        if Patternˉmaximumˉparameter.Isˉtype {
            return Compilerˉsourceˉwirˉgenericˉcontributionˉvalue(
                false, true, Patternˉsolution
            );
        }
        Patternˉsolution =
            Sourceˉgenerics.Compilerˉsourceˉgenericˉsolutionˉcontribute(
                Patternˉsolution, Patternˉmaximumˉparameter.Index, 2u32,
                Patternˉactualˉmaximum, 0u32,
                Originˉargument, Originˉoffset
            );
    } else if Patternˉmaximum.Kind !=
            Sourceˉlexer.Compilerˉtokenˉkind.Integer ||
        Patternˉmaximum.Numericˉvalue != Patternˉactualˉmaximum {
        return Compilerˉsourceˉwirˉgenericˉcontributionˉvalue(
            false, true, Patternˉsolution
        );
    }
    return Compilerˉsourceˉwirˉgenericˉcontributionˉvalue(
        Patternˉsolution.Status ==
            Sourceˉgenerics.Compilerˉsourceˉgenericˉstatus.Valid,
        true, Patternˉsolution
    );
}

fn Compilerˉsourceˉwirˉfunctionˉisˉgeneric(
    Source: bytes,
    Declarationˉoffset: u32
) -> bool {
    // Absolute token offsets are independent of the synthetic position used by
    // this prefilter; exact source positions are computed only for a generic.
    let First: Sourceˉlexer.Compilerˉsourceˉtoken =
        Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Source, Declarationˉoffset, 1u32, 1u32
        );
    var Functionˉtoken: Sourceˉlexer.Compilerˉsourceˉtoken = First;
    if First.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Export {
        Functionˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Source, First.Nextˉoffset, First.Nextˉline, First.Nextˉcolumn
        );
    }
    let Name: Sourceˉlexer.Compilerˉsourceˉtoken =
        Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Source, Functionˉtoken.Nextˉoffset,
            Functionˉtoken.Nextˉline, Functionˉtoken.Nextˉcolumn
        );
    let Afterˉname: Sourceˉlexer.Compilerˉsourceˉtoken =
        Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Source, Name.Nextˉoffset, Name.Nextˉline, Name.Nextˉcolumn
        );
    return Afterˉname.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Less;
}

export fn Compilerˉsourceˉwirˉcompileˉcall(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Bindingˉpayload: bytes,
    Bindingˉfirst: u32,
    Bindingˉentries: u32,
    Source: bytes,
    Expression: Sourceˉbodies.Compilerˉsourceˉexpression,
    Build: Compilerˉsourceˉwirˉbuild
) -> Compilerˉsourceˉwirˉvalue {
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(
        Source, Expression.Valueˉoffset, Expression.Valueˉlength, "length"
    ) {
        if Expression.Items != 1u32 {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Build, Compilerˉsourceˉwirˉstatus.Invalidˉargument,
                Build.Currentˉmodule,
                Expression.Offset, Expression.Line, Expression.Column
            );
        }
        let Lengthˉposition: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
            Source, Expression.Offset, Expression.Line, Expression.Column,
            Expression.Itemsˉoffset
        );
        let Lengthˉargument: Sourceˉbodies.Compilerˉsourceˉexpression = Sourceˉbodies.Compilerˉparseˉexpressionˉvalidated(
            Source,
            Expression.Itemsˉoffset,
            Lengthˉposition.Line,
            Lengthˉposition.Column,
            Expression.Itemsˉoffset + Expression.Itemsˉlength,
            0u32,
            0u32
        );
        if Lengthˉargument.Kind == Sourceˉbodies.Compilerˉsourceˉexpressionˉkind.Name {
            let Collectionˉlengthˉlocal: Sourceˉbindings.Compilerˉsourceˉlocalˉmatch = Sourceˉbindings.Compilerˉsourceˉbindingsˉfindˉlocal(
                Source, Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
                Lengthˉargument.Valueˉoffset, Lengthˉargument.Valueˉlength,
                Lengthˉargument.Offset
            );
            if Collectionˉlengthˉlocal.Found {
                if !Compilerˉsourceˉwirˉshapeˉisˉsequence(Collectionˉlengthˉlocal.Shape) {
                    return Compilerˉsourceˉwirˉfailureˉvalue(
                        Build, Compilerˉsourceˉwirˉstatus.Invalidˉcollection,
                        Build.Currentˉmodule,
                        Lengthˉargument.Offset, Lengthˉargument.Line, Lengthˉargument.Column
                    );
                }
                let Collectionˉlengthˉvalue: Compilerˉsourceˉwirˉvalue = Compilerˉsourceˉwirˉcompileˉname(
                    Input, Scan, Symbols, Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
                    Source, Lengthˉargument, Build
                );
                return Compilerˉsourceˉwirˉemit(
                    Compilerˉsourceˉwirˉvalueˉbuild(Collectionˉlengthˉvalue),
                    WIR_OPERATION_SEQUENCE_LENGTH,
                    3u32,
                    Compilerˉsourceˉwirˉoneˉoperand(Collectionˉlengthˉvalue.Temporary),
                    0u32, 0u32, Expression.Offset, Expression.Length
                );
            }
        }
        if Lengthˉargument.Kind != Sourceˉbodies.Compilerˉsourceˉexpressionˉkind.Name {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Build, Compilerˉsourceˉwirˉstatus.Invalidˉdataˉuse,
                Build.Currentˉmodule,
                Expression.Offset, Expression.Line, Expression.Column
            );
        }
        let Data: Sourceˉbindings.Compilerˉsourceˉbindingˉmatch = Sourceˉbindings.Compilerˉsourceˉbindingsˉfindˉdeclaration(
            Input, Scan, Symbols, Build.Currentˉmodule, Source,
            Lengthˉargument.Valueˉoffset, Lengthˉargument.Valueˉlength,
            Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Data
        );
        if !Data.Found || !Data.Accessible {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Build, Compilerˉsourceˉwirˉstatus.Invalidˉdataˉuse,
                Data.Module,
                Lengthˉargument.Offset, Lengthˉargument.Line, Lengthˉargument.Column
            );
        }
        if Compilerˉsourceˉwirˉdataˉkind(Input, Scan, Symbols, Data) != Compilerˉsourceˉwirˉdataˉkind.I32ˉarray {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Build, Compilerˉsourceˉwirˉstatus.Invalidˉdataˉuse,
                Data.Module,
                Lengthˉargument.Offset, Lengthˉargument.Line, Lengthˉargument.Column
            );
        }
        return Compilerˉsourceˉwirˉemit(
            Build, WIR_OPERATION_DATA_LENGTH, 1u32,
            Compilerˉsourceˉwirˉempty(Source),
            Data.Directoryˉentry, 0u32,
            Expression.Offset, Expression.Length
        );
    }
    var Callable: Sourceˉbindings.Compilerˉsourceˉbindingˉmatch = Sourceˉbindings.Compilerˉsourceˉbindingsˉfindˉcallable(
        Input, Scan, Symbols, Build.Currentˉmodule, Source,
        Expression.Valueˉoffset, Expression.Valueˉlength
    );
    let Capabilityˉlocal: Sourceˉbindings.Compilerˉsourceˉbindingˉmatch = Sourceˉbindings.Compilerˉsourceˉbindingsˉfindˉlocalˉcapability(
        Input, Scan, Symbols, Bindingˉpayload, Bindingˉfirst, Bindingˉentries, Source,
        Expression.Valueˉoffset, Expression.Valueˉlength, Expression.Offset
    );
    if Capabilityˉlocal.Found {
        Callable = Capabilityˉlocal;
    }
    if !Callable.Found || !Callable.Accessible {
        return Compilerˉsourceˉwirˉfailureˉvalue(
            Build, Compilerˉsourceˉwirˉstatus.Invalidˉargument,
            Callable.Module, Expression.Offset, Expression.Line, Expression.Column
        );
    }
    if Callable.Items != Expression.Items {
        return Compilerˉsourceˉwirˉfailureˉvalue(
            Build, Compilerˉsourceˉwirˉstatus.Invalidˉargument,
            Callable.Module, Expression.Offset, Expression.Line, Expression.Column
        );
    }
    var Genericˉparameters: u32 = 0u32;
    let Emptyˉgenericˉparameters: bytes = Compilerˉsourceˉwirˉempty(Source);
    var Genericˉsource: bytes = Source;
    var Genericˉdefinition: Sourceˉsymbols.Compilerˉsourceˉfunctionˉgeneric =
        Sourceˉsymbols.Compilerˉsourceˉfunctionˉgeneric(
            0u32, 0u32, 1u32, 1u32, 0u32, 1u32, 1u32
        );
    var Solution: Sourceˉgenerics.Compilerˉsourceˉgenericˉsolution =
        Sourceˉgenerics.Compilerˉsourceˉgenericˉsolutionˉcreate(
            Emptyˉgenericˉparameters, Emptyˉgenericˉparameters
        );
    if Callable.Kind == Sourceˉbindings.Compilerˉsourceˉcallableˉkind.Function {
        let Genericˉentry: u32 = 16u32 + Callable.Directoryˉentry * 24u32;
        let Genericˉdeclarationˉoffset: u32 = Bytesˉreadˉu32ˉlittle(
            Symbols.Directory, Genericˉentry + 8u32
        );
        let Genericˉview: Sourceˉset.Compilerˉsourceˉsetˉview =
            Sourceˉset.Compilerˉsourceˉsetˉmodule(
                Input, Scan, Callable.Module
            );
        if Compilerˉsourceˉwirˉfunctionˉisˉgeneric(
            Genericˉview.Source, Genericˉdeclarationˉoffset
        ) {
            let Genericˉposition: Sourceˉbodies.Compilerˉsourceˉposition =
                Sourceˉbodies.Compilerˉsourceˉposition(
                    Genericˉdeclarationˉoffset, 1u32, 1u32
                );
            let Genericˉdeclaration: Sourceˉdeclarations.Compilerˉsourceˉdeclaration =
                Sourceˉdeclarations.Compilerˉparseˉnextˉdeclarationˉvalidated(
                    Genericˉview.Source, Genericˉdeclarationˉoffset,
                    Genericˉposition.Line, Genericˉposition.Column, true
                );
            let Generic: Sourceˉsymbols.Compilerˉsourceˉfunctionˉgeneric =
                Sourceˉsymbols.Compilerˉsourceˉsymbolsˉfunctionˉgeneric(
                    Genericˉview.Source, Genericˉdeclaration,
                    Genericˉposition.Line, Genericˉposition.Column
                );
            Genericˉparameters = Generic.Parameters;
            Genericˉsource = Genericˉview.Source;
            Genericˉdefinition = Generic;
            Solution = Sourceˉsymbols.Compilerˉsourceˉsymbolsˉgenericˉsolution(
                Genericˉview.Source, Generic
            );
        }
    }
    let Explicitˉgeneric: bool = Expression.Kind ==
        Sourceˉbodies.Compilerˉsourceˉexpressionˉkind.Explicitˉgenericˉcall;
    if Explicitˉgeneric {
        if Genericˉparameters == 0u32 ||
            Expression.Numericˉvalue != Genericˉparameters {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Build, Compilerˉsourceˉwirˉstatus.Genericˉresolution,
                Callable.Module, Expression.Offset, Expression.Line, Expression.Column
            );
        }
        var Typeˉcursor: u32 = Expression.Firstˉoffset;
        var Typeˉposition: Sourceˉbodies.Compilerˉsourceˉposition =
            Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
                Source, Expression.Offset, Expression.Line, Expression.Column,
                Expression.Firstˉoffset
            );
        var Typeˉargument: u32 = 0u32;
        while Typeˉargument < Genericˉparameters {
            let Declaredˉgenericˉargument:
                Sourceˉsymbols.Compilerˉsourceˉgenericˉparameterˉmatch =
                Sourceˉsymbols.Compilerˉsourceˉsymbolsˉgenericˉparameterˉat(
                    Genericˉsource, Genericˉdefinition, Typeˉargument
                );
            var Explicitˉargumentˉkind: u32 = 1u32;
            var Explicitˉargumentˉlow: u32 = 0u32;
            var Explicitˉargumentˉhigh: u32 = 0u32;
            var Explicitˉargumentˉnextˉoffset: u32 = Typeˉcursor;
            var Explicitˉargumentˉnextˉline: u32 = Typeˉposition.Line;
            var Explicitˉargumentˉnextˉcolumn: u32 = Typeˉposition.Column;
            if Declaredˉgenericˉargument.Isˉtype {
                let Explicitˉtype: Sourceˉsymbols.Compilerˉsourceˉtypeˉbinding =
                    Sourceˉsymbols.Compilerˉsourceˉsymbolsˉbindˉtype(
                        Input, Scan, Symbols.Directory, Symbols.Lookup,
                        Symbols.Visibility, Build.Currentˉmodule, Source,
                        Typeˉcursor, Typeˉposition.Line, Typeˉposition.Column,
                        Symbols.Records, Symbols.Enums, false
                    );
                if Explicitˉtype.Status !=
                        Sourceˉsymbols.Compilerˉsourceˉsymbolˉstatus.Valid {
                    return Compilerˉsourceˉwirˉfailureˉvalue(
                        Build, Compilerˉsourceˉwirˉstatus.Genericˉresolution,
                        Callable.Module,
                        Explicitˉtype.Failureˉoffset,
                        Explicitˉtype.Failureˉline,
                        Explicitˉtype.Failureˉcolumn
                    );
                }
                Explicitˉargumentˉlow =
                    Sourceˉsymbols.Compilerˉsourceˉsymbolsˉtypeˉshape(
                        Explicitˉtype
                    );
                Explicitˉargumentˉnextˉoffset = Explicitˉtype.Nextˉoffset;
                Explicitˉargumentˉnextˉline = Explicitˉtype.Nextˉline;
                Explicitˉargumentˉnextˉcolumn = Explicitˉtype.Nextˉcolumn;
            } else {
                let Explicitˉconstant: Sourceˉlexer.Compilerˉsourceˉtoken =
                    Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                        Source, Typeˉcursor,
                        Typeˉposition.Line, Typeˉposition.Column
                    );
                if Explicitˉconstant.Kind !=
                        Sourceˉlexer.Compilerˉtokenˉkind.Integer ||
                    Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnumericˉshape(
                        Explicitˉconstant.Numericˉkind
                    ) != Declaredˉgenericˉargument.Shape {
                    return Compilerˉsourceˉwirˉfailureˉvalue(
                        Build, Compilerˉsourceˉwirˉstatus.Genericˉresolution,
                        Callable.Module,
                        Explicitˉconstant.Offset,
                        Explicitˉconstant.Line,
                        Explicitˉconstant.Column
                    );
                }
                Explicitˉargumentˉkind = 2u32;
                Explicitˉargumentˉlow = Explicitˉconstant.Numericˉvalue;
                Explicitˉargumentˉhigh = Explicitˉconstant.Numericˉhigh;
                Explicitˉargumentˉnextˉoffset = Explicitˉconstant.Nextˉoffset;
                Explicitˉargumentˉnextˉline = Explicitˉconstant.Nextˉline;
                Explicitˉargumentˉnextˉcolumn = Explicitˉconstant.Nextˉcolumn;
            }
            Solution =
                Sourceˉgenerics.Compilerˉsourceˉgenericˉsolutionˉcontribute(
                    Solution, Typeˉargument,
                    Explicitˉargumentˉkind,
                    Explicitˉargumentˉlow,
                    Explicitˉargumentˉhigh,
                    Typeˉargument, Typeˉcursor
                );
            if Solution.Status !=
                    Sourceˉgenerics.Compilerˉsourceˉgenericˉstatus.Valid {
                return Compilerˉsourceˉwirˉfailureˉvalue(
                    Build, Compilerˉsourceˉwirˉstatus.Genericˉresolution,
                    Callable.Module,
                    Typeˉcursor, Typeˉposition.Line, Typeˉposition.Column
                );
            }
            let Typeˉseparator: Sourceˉlexer.Compilerˉsourceˉtoken =
                Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                    Source, Explicitˉargumentˉnextˉoffset,
                    Explicitˉargumentˉnextˉline,
                    Explicitˉargumentˉnextˉcolumn
                );
            Typeˉcursor = Typeˉseparator.Nextˉoffset;
            Typeˉposition = Sourceˉbodies.Compilerˉsourceˉposition(
                Typeˉseparator.Nextˉoffset,
                Typeˉseparator.Nextˉline,
                Typeˉseparator.Nextˉcolumn
            );
            Typeˉargument = Typeˉargument + 1u32;
        }
    }
    var Result: Compilerˉsourceˉwirˉbuild = Build;
    var Argumentˉoperands: bytes = Compilerˉsourceˉwirˉempty(Source);
    var Cursor: u32 = Expression.Itemsˉoffset;
    var Currentˉposition: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
        Source, Expression.Offset, Expression.Line, Expression.Column,
        Expression.Itemsˉoffset
    );
    var Item: u32 = 0u32;
    while Item < Expression.Items {
        let Callˉargument: Sourceˉbodies.Compilerˉsourceˉexpression = Sourceˉbodies.Compilerˉparseˉexpressionˉvalidated(
            Source, Cursor, Currentˉposition.Line, Currentˉposition.Column,
            Expression.Itemsˉoffset + Expression.Itemsˉlength, 0u32, 0u32
        );
        let Value: Compilerˉsourceˉwirˉvalue = Compilerˉsourceˉwirˉcompileˉexpression(
            Input, Scan, Symbols, Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
            Source,
            Callˉargument.Offset, Callˉargument.Line, Callˉargument.Column,
            Callˉargument.Offset + Callˉargument.Length,
            Result
        );
        if Value.Status != Compilerˉsourceˉwirˉstatus.Valid { return Value; }
        if Value.Shape == 10u32 { return Value; }
        var Expected: u32 = 0u32;
        if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(
            Source, Expression.Valueˉoffset, Expression.Valueˉlength, "Enumˉname"
        ) {
            if Value.Shape >= 131072u32 + Symbols.Records {
                if Value.Shape < 131072u32 + Symbols.Records + Symbols.Enums {
                    Expected = Value.Shape;
                }
            }
        } else {
            var Genericˉargumentˉmatched: bool = false;
            if Genericˉparameters > 0u32 {
                let Genericˉargumentˉcontribution:
                    Compilerˉsourceˉwirˉgenericˉcontribution =
                    Compilerˉsourceˉwirˉgenericˉcontributeˉformal(
                        Input, Scan, Symbols, Callable, Item,
                        Value.Shape, Item, Callˉargument.Offset,
                        Compilerˉsourceˉwirˉgenericˉtypeˉcatalog(
                            Value.Genericˉevidence
                        ),
                        Solution
                    );
                Genericˉargumentˉmatched =
                    Genericˉargumentˉcontribution.Matched;
                Solution = Genericˉargumentˉcontribution.Solution;
                if !Genericˉargumentˉcontribution.Valid {
                    return Compilerˉsourceˉwirˉfailureˉvalue(
                        Compilerˉsourceˉwirˉvalueˉbuild(Value),
                        Compilerˉsourceˉwirˉstatus.Genericˉresolution,
                        Callable.Module,
                        Callˉargument.Offset,
                        Callˉargument.Line,
                        Callˉargument.Column
                    );
                }
            }
            if Genericˉargumentˉmatched {
                Expected = Value.Shape;
            } else {
                let Argumentˉsignature: Compilerˉsourceˉwirˉsignature = Compilerˉsourceˉwirˉcallableˉsignature(
                    Input, Scan, Symbols, Callable,
                    Source, Expression.Valueˉoffset, Expression.Valueˉlength, Item
                );
                Expected = Argumentˉsignature.Parameterˉshape;
            }
        }
        if Value.Shape != Expected {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Compilerˉsourceˉwirˉvalueˉbuild(Value),
                Compilerˉsourceˉwirˉstatus.Invalidˉargument,
                Callable.Module,
                Callˉargument.Offset, Callˉargument.Line, Callˉargument.Column
            );
        }
        Argumentˉoperands = Bytesˉconcat(
            Argumentˉoperands, Bytesˉfromˉu32ˉlittle(Value.Temporary)
        );
        Result = Compilerˉsourceˉwirˉvalueˉbuild(Value);
        Cursor = Callˉargument.Nextˉoffset;
        Currentˉposition = Sourceˉbodies.Compilerˉsourceˉposition(
            Callˉargument.Nextˉoffset, Callˉargument.Nextˉline, Callˉargument.Nextˉcolumn
        );
        if Item + 1u32 < Expression.Items {
            let Separator: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉbodies.Compilerˉbodyˉtoken(
                Source, Cursor, Currentˉposition.Line, Currentˉposition.Column,
                Expression.Itemsˉoffset + Expression.Itemsˉlength
            );
            Cursor = Separator.Nextˉoffset;
            Currentˉposition = Sourceˉbodies.Compilerˉsourceˉposition(
                Separator.Nextˉoffset, Separator.Nextˉline, Separator.Nextˉcolumn
            );
        }
        Item = Item + 1u32;
    }
    var Genericˉinstance: u32 = Compilerˉsourceˉwirˉsentinel();
    if Genericˉparameters > 0u32 {
        Solution = Sourceˉgenerics.Compilerˉsourceˉgenericˉsolutionˉfinish(Solution);
        if Solution.Status != Sourceˉgenerics.Compilerˉsourceˉgenericˉstatus.Valid {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Result, Compilerˉsourceˉwirˉstatus.Genericˉresolution,
                Callable.Module, Expression.Offset, Expression.Line, Expression.Column
            );
        }
        let Genericˉcatalog: Sourceˉgenerics.Compilerˉsourceˉgenericˉcatalog =
            Compilerˉsourceˉwirˉgenericˉcatalog(
                Result.Genericˉevidence
            );
        var Genericˉdepth: u32 = 1u32;
        if Result.Genericˉinstance != Compilerˉsourceˉwirˉsentinel() {
            Genericˉdepth = Sourceˉgenerics.Compilerˉsourceˉgenericˉcatalogˉinstanceˉdepth(
                Genericˉcatalog, Result.Genericˉinstance
            ) + 1u32;
        }
        let Admission: Sourceˉgenerics.Compilerˉsourceˉgenericˉadmission =
            Sourceˉgenerics.Compilerˉsourceˉgenericˉcatalogˉadmit(
                Genericˉcatalog,
                Callable.Directoryˉentry,
                Genericˉdepth,
                Build.Currentˉmodule,
                Expression.Offset,
                Expression.Length,
                Solution
            );
        if Admission.Status != Sourceˉgenerics.Compilerˉsourceˉgenericˉstatus.Valid {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Result, Compilerˉsourceˉwirˉstatus.Genericˉresolution,
                Callable.Module, Expression.Offset, Expression.Line, Expression.Column
            );
        }
        Genericˉinstance = Admission.Instance;
        Result = Compilerˉsourceˉwirˉwithˉgenericˉevidence(
            Result, Admission.Catalogˉevidence
        );
    } else if Explicitˉgeneric {
        return Compilerˉsourceˉwirˉfailureˉvalue(
            Result, Compilerˉsourceˉwirˉstatus.Genericˉresolution,
            Callable.Module, Expression.Offset, Expression.Line, Expression.Column
        );
    }
    let Signature: Compilerˉsourceˉwirˉsignature =
        Compilerˉsourceˉwirˉcallableˉsignatureˉconcrete(
            Input, Scan, Symbols, Callable,
            Source, Expression.Valueˉoffset, Expression.Valueˉlength, 0u32,
            Compilerˉsourceˉwirˉgenericˉcatalog(
                Result.Genericˉevidence
            ),
            Compilerˉsourceˉwirˉgenericˉtypeˉcatalog(
                Result.Genericˉevidence
            ),
            Genericˉinstance
        );
    var Operation: u32 = WIR_OPERATION_CALL_FUNCTION;
    var Target: u32 = Signature.Target;
    var Auxiliary: u32 = Signature.Auxiliary;
    if Genericˉparameters > 0u32 {
        Target = Bytesˉreadˉu32ˉlittle(
            Symbols.Directory, 8u32
        ) + Genericˉinstance;
    }
    if Callable.Kind == Sourceˉbindings.Compilerˉsourceˉcallableˉkind.Intrinsic {
        Operation = Compilerˉsourceˉwirˉintrinsicˉoperation(
            Source, Expression.Valueˉoffset, Expression.Valueˉlength
        );
        Target = Compilerˉsourceˉwirˉsentinel();
        Auxiliary = 0u32;
    }
    if Callable.Kind == Sourceˉbindings.Compilerˉsourceˉcallableˉkind.Record {
        Operation = WIR_OPERATION_RECORD_CREATE;
    }
    if Callable.Kind == Sourceˉbindings.Compilerˉsourceˉcallableˉkind.Variantˉcase {
        Operation = WIR_OPERATION_VARIANT_CREATE;
    }
    if Callable.Kind == Sourceˉbindings.Compilerˉsourceˉcallableˉkind.Capability {
        Operation = WIR_OPERATION_CALL_CAPABILITY;
    }
    if Signature.Returnˉshape == 10u32 {
        let Neverˉcall: Compilerˉsourceˉwirˉvalue = Compilerˉsourceˉwirˉemit(
            Result, Operation, 0u32,
            Argumentˉoperands, Target, Auxiliary,
            Expression.Offset, Expression.Length
        );
        let Neverˉblock: u32 = Neverˉcall.Currentˉblock;
        let Neverˉclosed: Compilerˉsourceˉwirˉbuild =
            Compilerˉsourceˉwirˉcloseˉcurrentˉblock(
                Compilerˉsourceˉwirˉvalueˉbuild(Neverˉcall),
                Compilerˉsourceˉwirˉterminator.Jump,
                Compilerˉsourceˉwirˉsentinel(),
                Neverˉblock,
                Compilerˉsourceˉwirˉsentinel()
            );
        return Compilerˉsourceˉwirˉvalueˉfrom(
            Neverˉclosed, 10u32, Compilerˉsourceˉwirˉsentinel()
        );
    }
    return Compilerˉsourceˉwirˉemit(
        Result, Operation, Signature.Returnˉshape,
        Argumentˉoperands, Target, Auxiliary,
        Expression.Offset, Expression.Length
    );
}

fn Compilerˉsourceˉwirˉcompileˉfor(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Bindings: Sourceˉbindings.Compilerˉsourceˉbindingˉphase,
    Source: bytes,
    Statement: Sourceˉbodies.Compilerˉsourceˉstatement,
    Returnˉshape: u32,
    Build: Compilerˉsourceˉwirˉbuild
) -> Compilerˉsourceˉwirˉbuild {
    var Result: Compilerˉsourceˉwirˉbuild = Compilerˉsourceˉwirˉfusedˉfrom(Build, Bindings);
    var Bindingˉphase: Sourceˉbindings.Compilerˉsourceˉbindingˉphase = Bindings;
    let Bindingˉbuild: Sourceˉbindings.Compilerˉsourceˉbindingˉbuild =
        Sourceˉbindings.Compilerˉsourceˉbindingsˉphaseˉbuildˉvalue(Bindingˉphase);
    let Bindingˉpayload: bytes = Bindingˉbuild.Payload;
    let Bindingˉfirst: u32 = Bindingˉbuild.Entries - Bindingˉbuild.Nextˉslot;
    let Bindingˉentries: u32 = Bindingˉbuild.Entries;
    let Collectionˉforˉsequenceˉposition: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
        Source, Statement.Offset, Statement.Line, Statement.Column,
        Statement.Expressionˉoffset
    );
    let Collectionˉforˉsequence: Compilerˉsourceˉwirˉvalue = Compilerˉsourceˉwirˉcompileˉexpression(
        Input, Scan, Symbols,
        Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
        Source,
        Statement.Expressionˉoffset,
        Collectionˉforˉsequenceˉposition.Line,
        Collectionˉforˉsequenceˉposition.Column,
        Statement.Expressionˉoffset + Statement.Expressionˉlength,
        Result
    );
    if Collectionˉforˉsequence.Status != Compilerˉsourceˉwirˉstatus.Valid {
        return Compilerˉsourceˉwirˉfusedˉfrom(
            Compilerˉsourceˉwirˉvalueˉbuild(Collectionˉforˉsequence),
            Bindingˉphase
        );
    }
    if !Compilerˉsourceˉwirˉshapeˉisˉsequence(Collectionˉforˉsequence.Shape) {
        return Compilerˉsourceˉwirˉfusedˉfrom(
            Compilerˉsourceˉwirˉbuildˉfailure(
                Compilerˉsourceˉwirˉvalueˉbuild(Collectionˉforˉsequence),
                Compilerˉsourceˉwirˉstatus.Invalidˉcollection,
                Result.Currentˉmodule, Result.Currentˉmodule, Result.Currentˉfunction,
                Statement.Expressionˉoffset,
                Collectionˉforˉsequenceˉposition.Line,
                Collectionˉforˉsequenceˉposition.Column
            ), Bindingˉphase
        );
    }
    var Collectionˉforˉbindings: Sourceˉbindings.Compilerˉsourceˉbindingˉbuild = Bindingˉbuild;
    if Collectionˉforˉbindings.Nextˉslot > 4093u32 {
        return Compilerˉsourceˉwirˉfusedˉfrom(
            Compilerˉsourceˉwirˉbuildˉfailure(
                Compilerˉsourceˉwirˉvalueˉbuild(Collectionˉforˉsequence),
                Compilerˉsourceˉwirˉstatus.Sourceˉbindings,
                Result.Currentˉmodule,
                Compilerˉsourceˉwirˉbindingˉfailureˉrelated(
                    Sourceˉbindings.Compilerˉsourceˉbindingˉstatus.Bindingˉlimit,
                    Result.Currentˉmodule
                ),
                Result.Currentˉfunction,
                Statement.Offset, Statement.Line, Statement.Column
            ), Bindingˉphase
        );
    }
    Collectionˉforˉbindings = Sourceˉbindings.Compilerˉsourceˉbindingsˉcollectˉforˉbinding(
        Result.Currentˉmodule, Result.Currentˉfunction,
        Source, Statement,
        Compilerˉsourceˉwirˉcollectionˉelementˉshape(Collectionˉforˉsequence.Shape),
        Collectionˉforˉbindings
    );
    if Collectionˉforˉbindings.Status == Sourceˉbindings.Compilerˉsourceˉbindingˉstatus.Valid {
        Collectionˉforˉbindings = Bindingˉbuild;
    }
    let Collectionˉforˉsequenceˉslot: u32 = Collectionˉforˉbindings.Nextˉslot;
    let Collectionˉforˉsequenceˉentry: bytes = Sourceˉbindings.Compilerˉsourceˉbindingsˉentry(
        Result.Currentˉmodule, Result.Currentˉfunction,
        Sourceˉbindings.Compilerˉsourceˉbindingˉkind.Let,
        Collectionˉforˉsequenceˉslot,
        Statement.Nameˉoffset, Statement.Nameˉlength,
        Collectionˉforˉsequence.Shape,
        Statement.Offset, Statement.Firstˉblockˉoffset
    );
    Collectionˉforˉbindings = Sourceˉbindings.Compilerˉsourceˉbindingsˉappend(
        Collectionˉforˉbindings, Collectionˉforˉsequenceˉentry, false
    );
    let Collectionˉforˉindexˉslot: u32 = Collectionˉforˉbindings.Nextˉslot;
    let Collectionˉforˉindexˉentry: bytes = Sourceˉbindings.Compilerˉsourceˉbindingsˉentry(
        Result.Currentˉmodule, Result.Currentˉfunction,
        Sourceˉbindings.Compilerˉsourceˉbindingˉkind.Var,
        Collectionˉforˉindexˉslot,
        Statement.Nameˉoffset, Statement.Nameˉlength, 3u32,
        Statement.Offset, Statement.Firstˉblockˉoffset
    );
    Collectionˉforˉbindings = Sourceˉbindings.Compilerˉsourceˉbindingsˉappend(
        Collectionˉforˉbindings, Collectionˉforˉindexˉentry, false
    );
    let Collectionˉforˉbindingˉslot: u32 = Collectionˉforˉbindings.Nextˉslot;
    let Collectionˉforˉbindingˉentry: bytes = Sourceˉbindings.Compilerˉsourceˉbindingsˉentry(
        Result.Currentˉmodule, Result.Currentˉfunction,
        Sourceˉbindings.Compilerˉsourceˉbindingˉkind.Let,
        Collectionˉforˉbindingˉslot,
        Statement.Nameˉoffset, Statement.Nameˉlength,
        Compilerˉsourceˉwirˉcollectionˉelementˉshape(Collectionˉforˉsequence.Shape),
        Statement.Firstˉblockˉoffset,
        Statement.Firstˉblockˉoffset + Statement.Firstˉblockˉlength
    );
    Collectionˉforˉbindings = Sourceˉbindings.Compilerˉsourceˉbindingsˉappend(
        Collectionˉforˉbindings, Collectionˉforˉbindingˉentry, false
    );
    Bindingˉphase = Sourceˉbindings.Compilerˉsourceˉbindingsˉphaseˉbuild(
        Bindingˉphase, Collectionˉforˉbindings
    );
    if Bindingˉphase.Buildˉstatus != Sourceˉbindings.Compilerˉsourceˉbindingˉstatus.Valid {
        return Compilerˉsourceˉwirˉbuildˉfailure(
            Compilerˉsourceˉwirˉvalueˉbuild(Collectionˉforˉsequence),
            Compilerˉsourceˉwirˉstatus.Sourceˉbindings,
            Bindingˉphase.Buildˉfailureˉmodule,
            Compilerˉsourceˉwirˉbindingˉfailureˉrelated(
                Bindingˉphase.Buildˉstatus,
                Bindingˉphase.Buildˉfailureˉrelatedˉmodule
            ),
            Bindingˉphase.Buildˉfailureˉfunction,
            Bindingˉphase.Buildˉfailureˉoffset,
            Bindingˉphase.Buildˉfailureˉline,
            Bindingˉphase.Buildˉfailureˉcolumn
        );
    }
    let Collectionˉforˉbinding: Sourceˉbindings.Compilerˉsourceˉlocalˉmatch = Sourceˉbindings.Compilerˉsourceˉbindingsˉfindˉlocal(
        Source, Collectionˉforˉbindings.Payload,
        Collectionˉforˉbindings.Entries - Collectionˉforˉbindings.Nextˉslot,
        Collectionˉforˉbindings.Entries,
        Statement.Nameˉoffset, Statement.Nameˉlength,
        Statement.Firstˉblockˉoffset
    );
    let Collectionˉforˉsequenceˉstored: Compilerˉsourceˉwirˉvalue = Compilerˉsourceˉwirˉemit(
        Compilerˉsourceˉwirˉvalueˉbuild(Collectionˉforˉsequence),
        WIR_OPERATION_STORE_LOCAL,
        0u32,
        Compilerˉsourceˉwirˉoneˉoperand(Collectionˉforˉsequence.Temporary),
        Collectionˉforˉsequenceˉslot, 0u32,
        Statement.Expressionˉoffset, Statement.Expressionˉlength
    );
    let Collectionˉforˉzero: Compilerˉsourceˉwirˉvalue = Compilerˉsourceˉwirˉemit(
        Compilerˉsourceˉwirˉvalueˉbuild(Collectionˉforˉsequenceˉstored),
        WIR_OPERATION_U32_CONSTANT,
        3u32, Compilerˉsourceˉwirˉempty(Source),
        0u32, 0u32, Statement.Offset, Statement.Length
    );
    let Collectionˉforˉindexˉinitialized: Compilerˉsourceˉwirˉvalue = Compilerˉsourceˉwirˉemit(
        Compilerˉsourceˉwirˉvalueˉbuild(Collectionˉforˉzero),
        WIR_OPERATION_STORE_LOCAL,
        0u32, Compilerˉsourceˉwirˉoneˉoperand(Collectionˉforˉzero.Temporary),
        Collectionˉforˉindexˉslot, 0u32,
        Statement.Offset, Statement.Length
    );
    Result = Compilerˉsourceˉwirˉfusedˉfrom(
        Compilerˉsourceˉwirˉvalueˉbuild(Collectionˉforˉindexˉinitialized),
        Bindingˉphase
    );
    let Collectionˉforˉheader: u32 = Result.Nextˉblock;
    let Collectionˉforˉbody: u32 = Collectionˉforˉheader + 1u32;
    let Collectionˉforˉincrement: u32 = Collectionˉforˉheader + 2u32;
    let Collectionˉforˉafter: u32 = Collectionˉforˉheader + 3u32;
    Result = Compilerˉsourceˉwirˉreserveˉblocks(Result, 4u32);
    Result = Compilerˉsourceˉwirˉcloseˉcurrentˉblock(
        Result, Compilerˉsourceˉwirˉterminator.Jump,
        Compilerˉsourceˉwirˉsentinel(),
        Collectionˉforˉheader, Compilerˉsourceˉwirˉsentinel()
    );
    Result = Compilerˉsourceˉwirˉbeginˉreservedˉblock(Result, Collectionˉforˉheader);
    let Collectionˉforˉheaderˉindex: Compilerˉsourceˉwirˉvalue = Compilerˉsourceˉwirˉemit(
        Result, WIR_OPERATION_LOAD_LOCAL,
        3u32, Compilerˉsourceˉwirˉempty(Source),
        Collectionˉforˉindexˉslot, 0u32,
        Statement.Offset, Statement.Length
    );
    let Collectionˉforˉheaderˉsequence: Compilerˉsourceˉwirˉvalue = Compilerˉsourceˉwirˉemit(
        Compilerˉsourceˉwirˉvalueˉbuild(Collectionˉforˉheaderˉindex),
        WIR_OPERATION_LOAD_LOCAL,
        Collectionˉforˉsequence.Shape, Compilerˉsourceˉwirˉempty(Source),
        Collectionˉforˉsequenceˉslot, 0u32,
        Statement.Expressionˉoffset, Statement.Expressionˉlength
    );
    let Collectionˉforˉlength: Compilerˉsourceˉwirˉvalue = Compilerˉsourceˉwirˉemit(
        Compilerˉsourceˉwirˉvalueˉbuild(Collectionˉforˉheaderˉsequence),
        WIR_OPERATION_SEQUENCE_LENGTH,
        3u32,
        Compilerˉsourceˉwirˉoneˉoperand(Collectionˉforˉheaderˉsequence.Temporary),
        0u32, 0u32, Statement.Expressionˉoffset, Statement.Expressionˉlength
    );
    let Collectionˉforˉcondition: Compilerˉsourceˉwirˉvalue = Compilerˉsourceˉwirˉemit(
        Compilerˉsourceˉwirˉvalueˉbuild(Collectionˉforˉlength),
        WIR_OPERATION_U32_LESS,
        4u32,
        Compilerˉsourceˉwirˉtwoˉoperands(
            Collectionˉforˉheaderˉindex.Temporary,
            Collectionˉforˉlength.Temporary
        ),
        0u32, 0u32, Statement.Offset, Statement.Length
    );
    Result = Compilerˉsourceˉwirˉcloseˉcurrentˉblock(
        Compilerˉsourceˉwirˉvalueˉbuild(Collectionˉforˉcondition),
        Compilerˉsourceˉwirˉterminator.Branch,
        Collectionˉforˉcondition.Temporary,
        Collectionˉforˉbody, Collectionˉforˉafter
    );
    Result = Compilerˉsourceˉwirˉbeginˉreservedˉblock(Result, Collectionˉforˉbody);
    let Collectionˉforˉbodyˉsequence: Compilerˉsourceˉwirˉvalue = Compilerˉsourceˉwirˉemit(
        Result, WIR_OPERATION_LOAD_LOCAL,
        Collectionˉforˉsequence.Shape, Compilerˉsourceˉwirˉempty(Source),
        Collectionˉforˉsequenceˉslot, 0u32,
        Statement.Expressionˉoffset, Statement.Expressionˉlength
    );
    let Collectionˉforˉbodyˉindex: Compilerˉsourceˉwirˉvalue = Compilerˉsourceˉwirˉemit(
        Compilerˉsourceˉwirˉvalueˉbuild(Collectionˉforˉbodyˉsequence),
        WIR_OPERATION_LOAD_LOCAL,
        3u32, Compilerˉsourceˉwirˉempty(Source),
        Collectionˉforˉindexˉslot, 0u32,
        Statement.Offset, Statement.Length
    );
    let Collectionˉforˉelement: Compilerˉsourceˉwirˉvalue = Compilerˉsourceˉwirˉemit(
        Compilerˉsourceˉwirˉvalueˉbuild(Collectionˉforˉbodyˉindex),
        WIR_OPERATION_SEQUENCE_ELEMENT,
        Collectionˉforˉbinding.Shape,
        Compilerˉsourceˉwirˉtwoˉoperands(
            Collectionˉforˉbodyˉsequence.Temporary,
            Collectionˉforˉbodyˉindex.Temporary
        ),
        0u32, 0u32, Statement.Offset, Statement.Length
    );
    let Collectionˉforˉelementˉstored: Compilerˉsourceˉwirˉvalue = Compilerˉsourceˉwirˉemit(
        Compilerˉsourceˉwirˉvalueˉbuild(Collectionˉforˉelement),
        WIR_OPERATION_STORE_LOCAL,
        0u32, Compilerˉsourceˉwirˉoneˉoperand(Collectionˉforˉelement.Temporary),
        Collectionˉforˉbinding.Slot, 0u32,
        Statement.Offset, Statement.Length
    );
    let Collectionˉforˉbodyˉposition: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
        Source, Statement.Offset, Statement.Line, Statement.Column,
        Statement.Firstˉblockˉoffset
    );
    let Collectionˉforˉbodyˉcompiled: Compilerˉsourceˉwirˉbuild = Compilerˉsourceˉwirˉcompileˉblock(
        Input, Scan, Symbols, Bindingˉphase,
        Source,
        Statement.Firstˉblockˉoffset,
        Collectionˉforˉbodyˉposition.Line,
        Collectionˉforˉbodyˉposition.Column,
        Statement.Firstˉblockˉoffset + Statement.Firstˉblockˉlength,
        Statement.Firstˉblockˉoffset + Statement.Firstˉblockˉlength,
        Returnˉshape, Collectionˉforˉincrement, Collectionˉforˉafter,
        Compilerˉsourceˉwirˉvalueˉbuild(Collectionˉforˉelementˉstored)
    );
    if Collectionˉforˉbodyˉcompiled.Status != Compilerˉsourceˉwirˉstatus.Valid {
        return Collectionˉforˉbodyˉcompiled;
    }
    Result = Collectionˉforˉbodyˉcompiled;
    Bindingˉphase = Compilerˉsourceˉwirˉbuildˉbindings(Input, Collectionˉforˉbodyˉcompiled);
    if Result.Hasˉcurrentˉblock {
        Result = Compilerˉsourceˉwirˉcloseˉcurrentˉblock(
            Result, Compilerˉsourceˉwirˉterminator.Jump,
            Compilerˉsourceˉwirˉsentinel(),
            Collectionˉforˉincrement, Compilerˉsourceˉwirˉsentinel()
        );
    }
    Result = Compilerˉsourceˉwirˉbeginˉreservedˉblock(Result, Collectionˉforˉincrement);
    let Collectionˉforˉincrementˉindex: Compilerˉsourceˉwirˉvalue = Compilerˉsourceˉwirˉemit(
        Result, WIR_OPERATION_LOAD_LOCAL,
        3u32, Compilerˉsourceˉwirˉempty(Source),
        Collectionˉforˉindexˉslot, 0u32,
        Statement.Offset, Statement.Length
    );
    let Collectionˉforˉone: Compilerˉsourceˉwirˉvalue = Compilerˉsourceˉwirˉemit(
        Compilerˉsourceˉwirˉvalueˉbuild(Collectionˉforˉincrementˉindex),
        WIR_OPERATION_U32_CONSTANT,
        3u32, Compilerˉsourceˉwirˉempty(Source),
        1u32, 0u32, Statement.Offset, Statement.Length
    );
    let Collectionˉforˉincremented: Compilerˉsourceˉwirˉvalue = Compilerˉsourceˉwirˉemit(
        Compilerˉsourceˉwirˉvalueˉbuild(Collectionˉforˉone),
        WIR_OPERATION_U32_ADD,
        3u32,
        Compilerˉsourceˉwirˉtwoˉoperands(
            Collectionˉforˉincrementˉindex.Temporary,
            Collectionˉforˉone.Temporary
        ),
        0u32, 0u32, Statement.Offset, Statement.Length
    );
    let Collectionˉforˉincrementˉstored: Compilerˉsourceˉwirˉvalue = Compilerˉsourceˉwirˉemit(
        Compilerˉsourceˉwirˉvalueˉbuild(Collectionˉforˉincremented),
        WIR_OPERATION_STORE_LOCAL,
        0u32, Compilerˉsourceˉwirˉoneˉoperand(Collectionˉforˉincremented.Temporary),
        Collectionˉforˉindexˉslot, 0u32,
        Statement.Offset, Statement.Length
    );
    Result = Compilerˉsourceˉwirˉcloseˉcurrentˉblock(
        Compilerˉsourceˉwirˉvalueˉbuild(Collectionˉforˉincrementˉstored),
        Compilerˉsourceˉwirˉterminator.Jump,
        Compilerˉsourceˉwirˉsentinel(),
        Collectionˉforˉheader, Compilerˉsourceˉwirˉsentinel()
    );
    Result = Compilerˉsourceˉwirˉbeginˉreservedˉblock(Result, Collectionˉforˉafter);
    return Compilerˉsourceˉwirˉfusedˉfrom(Result, Bindingˉphase);
}

fn Compilerˉsourceˉwirˉcompileˉpush(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Bindings: Sourceˉbindings.Compilerˉsourceˉbindingˉphase,
    Source: bytes,
    Statement: Sourceˉbodies.Compilerˉsourceˉstatement,
    Build: Compilerˉsourceˉwirˉbuild
) -> Compilerˉsourceˉwirˉbuild {
    var Result: Compilerˉsourceˉwirˉbuild = Compilerˉsourceˉwirˉfusedˉfrom(Build, Bindings);
    let Bindingˉphase: Sourceˉbindings.Compilerˉsourceˉbindingˉphase = Bindings;
    let Bindingˉbuild: Sourceˉbindings.Compilerˉsourceˉbindingˉbuild =
        Sourceˉbindings.Compilerˉsourceˉbindingsˉphaseˉbuildˉvalue(Bindings);
    let Bindingˉpayload: bytes = Bindingˉbuild.Payload;
    let Bindingˉfirst: u32 = Bindingˉbuild.Entries - Bindingˉbuild.Nextˉslot;
    let Bindingˉentries: u32 = Bindingˉbuild.Entries;
    let Collectionˉpushˉbinding: Sourceˉbindings.Compilerˉsourceˉlocalˉmatch = Sourceˉbindings.Compilerˉsourceˉbindingsˉfindˉlocal(
        Source, Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
        Statement.Nameˉoffset, Statement.Nameˉlength, Statement.Offset
    );
    if !Collectionˉpushˉbinding.Found || Collectionˉpushˉbinding.Kind != Sourceˉbindings.Compilerˉsourceˉbindingˉkind.Var || !Compilerˉsourceˉwirˉshapeˉisˉbuilder(Collectionˉpushˉbinding.Shape) {
        return Compilerˉsourceˉwirˉfusedˉfrom(
            Compilerˉsourceˉwirˉbuildˉfailure(
                Result, Compilerˉsourceˉwirˉstatus.Invalidˉbuilder,
                Result.Currentˉmodule, Result.Currentˉmodule, Result.Currentˉfunction,
                Statement.Nameˉoffset, Statement.Line, Statement.Column
            ),
            Bindingˉphase
        );
    }
    let Collectionˉpushˉposition: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
        Source, Statement.Offset, Statement.Line, Statement.Column, Statement.Expressionˉoffset
    );
    let Collectionˉpushˉvalue: Compilerˉsourceˉwirˉvalue = Compilerˉsourceˉwirˉcompileˉexpression(
        Input, Scan, Symbols, Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
        Source, Statement.Expressionˉoffset,
        Collectionˉpushˉposition.Line, Collectionˉpushˉposition.Column,
        Statement.Expressionˉoffset + Statement.Expressionˉlength,
        Result
    );
    if Collectionˉpushˉvalue.Status != Compilerˉsourceˉwirˉstatus.Valid {
        return Compilerˉsourceˉwirˉfusedˉfrom(
            Compilerˉsourceˉwirˉvalueˉbuild(Collectionˉpushˉvalue), Bindingˉphase
        );
    }
    if Collectionˉpushˉvalue.Shape != Compilerˉsourceˉwirˉcollectionˉelementˉshape(Collectionˉpushˉbinding.Shape) {
        return Compilerˉsourceˉwirˉfusedˉfrom(
            Compilerˉsourceˉwirˉbuildˉfailure(
                Compilerˉsourceˉwirˉvalueˉbuild(Collectionˉpushˉvalue),
                Compilerˉsourceˉwirˉstatus.Typeˉmismatch,
                Result.Currentˉmodule, Result.Currentˉmodule, Result.Currentˉfunction,
                Statement.Expressionˉoffset,
                Collectionˉpushˉposition.Line, Collectionˉpushˉposition.Column
            ), Bindingˉphase
        );
    }
    let Collectionˉpushˉloaded: Compilerˉsourceˉwirˉvalue = Compilerˉsourceˉwirˉemit(
        Compilerˉsourceˉwirˉvalueˉbuild(Collectionˉpushˉvalue),
        WIR_OPERATION_LOAD_LOCAL,
        Collectionˉpushˉbinding.Shape,
        Compilerˉsourceˉwirˉempty(Source),
        Collectionˉpushˉbinding.Slot, 0u32,
        Statement.Nameˉoffset, Statement.Nameˉlength
    );
    let Collectionˉpushed: Compilerˉsourceˉwirˉvalue = Compilerˉsourceˉwirˉemit(
        Compilerˉsourceˉwirˉvalueˉbuild(Collectionˉpushˉloaded),
        WIR_OPERATION_BUILDER_PUSH,
        Collectionˉpushˉbinding.Shape,
        Compilerˉsourceˉwirˉtwoˉoperands(
            Collectionˉpushˉloaded.Temporary,
            Collectionˉpushˉvalue.Temporary
        ),
        0u32, 0u32, Statement.Offset, Statement.Length
    );
    let Collectionˉpushˉstored: Compilerˉsourceˉwirˉvalue = Compilerˉsourceˉwirˉemit(
        Compilerˉsourceˉwirˉvalueˉbuild(Collectionˉpushed),
        WIR_OPERATION_STORE_LOCAL,
        0u32, Compilerˉsourceˉwirˉoneˉoperand(Collectionˉpushed.Temporary),
        Collectionˉpushˉbinding.Slot, 0u32,
        Statement.Offset, Statement.Length
    );
    Result = Compilerˉsourceˉwirˉvalueˉbuild(Collectionˉpushˉstored);
    return Compilerˉsourceˉwirˉfusedˉfrom(Result, Bindings);
}

fn Compilerˉsourceˉwirˉcompileˉmatch(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Source: bytes,
    Match: Compilerˉsourceˉwirˉmatchˉview,
    Valueˉform: bool,
    Returnˉshape: u32,
    Continueˉtarget: u32,
    Breakˉtarget: u32,
    Build: Compilerˉsourceˉwirˉbuild
) -> Compilerˉsourceˉwirˉvalue {
    let Bindings: Sourceˉbindings.Compilerˉsourceˉbindingˉphase =
        Compilerˉsourceˉwirˉbuildˉbindings(Input, Build);
    var Result: Compilerˉsourceˉwirˉbuild = Compilerˉsourceˉwirˉfusedˉfrom(Build, Bindings);
    var Bindingˉphase: Sourceˉbindings.Compilerˉsourceˉbindingˉphase = Bindings;
    if Valueˉform {
        if Scan.Version != 2u32 {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Result,
                Compilerˉsourceˉwirˉstatus.Invalidˉmatch,
                Result.Currentˉmodule,
                Match.Offset,
                Match.Line,
                Match.Column
            );
        }
    }
    let Bindingˉbuild: Sourceˉbindings.Compilerˉsourceˉbindingˉbuild =
        Sourceˉbindings.Compilerˉsourceˉbindingsˉphaseˉbuildˉvalue(Bindingˉphase);
    let Bindingˉpayload: bytes = Bindingˉbuild.Payload;
    let Bindingˉfirst: u32 = Bindingˉbuild.Entries - Bindingˉbuild.Nextˉslot;
    let Bindingˉentries: u32 = Bindingˉbuild.Entries;
    let Matchˉvalueˉposition: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
        Source, Match.Offset, Match.Line, Match.Column,
        Match.Valueˉoffset
    );
    let Matchˉvalue: Compilerˉsourceˉwirˉvalue = Compilerˉsourceˉwirˉcompileˉexpression(
        Input, Scan, Symbols,
        Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
        Source,
        Match.Valueˉoffset,
        Matchˉvalueˉposition.Line,
        Matchˉvalueˉposition.Column,
        Match.Valueˉoffset + Match.Valueˉlength,
        Result
    );
    if Matchˉvalue.Status != Compilerˉsourceˉwirˉstatus.Valid {
        return Matchˉvalue;
    }
    var Matchˉshapeˉisˉsupported: bool = false;
    if Matchˉvalue.Shape >= 131072u32 + Symbols.Records {
        if Matchˉvalue.Shape < 131072u32 + Symbols.Records + Symbols.Enums {
            Matchˉshapeˉisˉsupported = true;
        }
    }
    if Matchˉvalue.Shape >= 196608u32 + Symbols.Records + Symbols.Enums {
        if Matchˉvalue.Shape < 196608u32 + Symbols.Records + Symbols.Enums + Symbols.Variants {
            Matchˉshapeˉisˉsupported = true;
        }
    }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉshapeˉisˉfoundationˉgeneric(
        Matchˉvalue.Shape
    ) { Matchˉshapeˉisˉsupported = true; }
    if !Matchˉshapeˉisˉsupported {
        return Compilerˉsourceˉwirˉfailureˉvalue(
            Compilerˉsourceˉwirˉvalueˉbuild(Matchˉvalue),
            Compilerˉsourceˉwirˉstatus.Invalidˉmatch,
            Result.Currentˉmodule,
            Match.Valueˉoffset,
            Matchˉvalueˉposition.Line,
            Matchˉvalueˉposition.Column
        );
    }
    let Matchˉnominal: Sourceˉsymbols.Compilerˉsourceˉsymbolˉmatch = Compilerˉsourceˉwirˉnominalˉbyˉshape(
        Input, Scan, Symbols, Matchˉvalue.Shape
    );
    if !Matchˉnominal.Found {
        return Compilerˉsourceˉwirˉfailureˉvalue(
            Compilerˉsourceˉwirˉvalueˉbuild(Matchˉvalue),
            Compilerˉsourceˉwirˉstatus.Invalidˉmatch,
            Result.Currentˉmodule,
            Match.Valueˉoffset,
            Matchˉvalueˉposition.Line,
            Matchˉvalueˉposition.Column
        );
    }
    let Matchˉisˉvariant: bool =
        Matchˉnominal.Kind == Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Variant;
    let Matchˉdeclarationˉview: Sourceˉset.Compilerˉsourceˉsetˉview = Sourceˉset.Compilerˉsourceˉsetˉmodule(
        Input, Scan, Matchˉnominal.Module
    );
    let Matchˉdeclarationˉposition: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
        Matchˉdeclarationˉview.Source, 0u32, 1u32, 1u32,
        Matchˉnominal.Declarationˉoffset
    );
    let Matchˉdeclaration: Sourceˉdeclarations.Compilerˉsourceˉdeclaration = Sourceˉdeclarations.Compilerˉparseˉnextˉdeclarationˉvalidated(
        Matchˉdeclarationˉview.Source,
        Matchˉnominal.Declarationˉoffset,
        Matchˉdeclarationˉposition.Line,
        Matchˉdeclarationˉposition.Column,
        true
    );
    if Match.Cases != Matchˉdeclaration.Items {
        return Compilerˉsourceˉwirˉfailureˉvalue(
            Compilerˉsourceˉwirˉvalueˉbuild(Matchˉvalue),
            Compilerˉsourceˉwirˉstatus.Missingˉmatchˉcase,
            Matchˉnominal.Module,
            Match.Bodyˉoffset,
            Match.Line,
            Match.Column
        );
    }
    let Matchˉseenˉresult: Byteˉconstruction.Foundationˉbytesˉresult = Byteˉconstruction.Foundationˉbytesˉrepeat(
        0u8, Matchˉdeclaration.Items
    );
    if !Matchˉseenˉresult.Valid {
        return Compilerˉsourceˉwirˉfailureˉvalue(
            Compilerˉsourceˉwirˉvalueˉbuild(Matchˉvalue),
            Compilerˉsourceˉwirˉstatus.Evidenceˉlimit,
            Matchˉnominal.Module,
            Match.Bodyˉoffset,
            Match.Line,
            Match.Column
        );
    }
    var Matchˉseen: bytes = Matchˉseenˉresult.Value;
    let Matchˉbodyˉposition: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
        Source, Match.Offset, Match.Line, Match.Column,
        Match.Bodyˉoffset
    );
    let Matchˉbody: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉbodies.Compilerˉbodyˉtoken(
        Source,
        Match.Bodyˉoffset,
        Matchˉbodyˉposition.Line,
        Matchˉbodyˉposition.Column,
        Match.Bodyˉoffset + Match.Bodyˉlength
    );
    var Matchˉcursor: u32 = Matchˉbody.Nextˉoffset;
    var Matchˉline: u32 = Matchˉbody.Nextˉline;
    var Matchˉcolumn: u32 = Matchˉbody.Nextˉcolumn;
    var Matchˉcaseˉindex: u32 = 0u32;
    var Matchˉbodies: Compilerˉsourceˉwirˉbuild = Compilerˉsourceˉwirˉvalueˉbuild(Matchˉvalue);
    var Matchˉresult: Compilerˉsourceˉwirˉvalue =
        Compilerˉsourceˉwirˉvalueˉfrom(
            Compilerˉsourceˉwirˉwithoutˉcurrentˉblock(Matchˉbodies),
            0u32,
            Compilerˉsourceˉwirˉsentinel()
        );
    var Hasˉmatchˉresult: bool = false;
    let Matchˉcaseˉblocks: u32 = Matchˉbodies.Nextˉblock;
    Matchˉcursor = Matchˉbody.Nextˉoffset;
    Matchˉline = Matchˉbody.Nextˉline;
    Matchˉcolumn = Matchˉbody.Nextˉcolumn;
    Matchˉcaseˉindex = 0u32;
    while Matchˉcaseˉindex < Match.Cases {
        let Bodyˉcase: Sourceˉbodies.Compilerˉsourceˉmatchˉcase = Sourceˉbodies.Compilerˉbodyˉparseˉmatchˉcase(
            Source,
            Matchˉcursor,
            Matchˉline,
            Matchˉcolumn,
            Match.Bodyˉoffset + Match.Bodyˉlength,
            0u32,
            Valueˉform
        );
        let Caseˉnominal: Sourceˉsymbols.Compilerˉsourceˉsymbolˉmatch =
            Sourceˉsymbols.Compilerˉsourceˉsymbolsˉfindˉownedˉnominal(
                Input, Scan, Symbols.Directory, Symbols.Lookup,
                Result.Currentˉmodule,
                Source, Bodyˉcase.Enumˉoffset, Bodyˉcase.Enumˉlength
            );
        var Sameˉnominal: bool = Caseˉnominal.Found;
        if Sameˉnominal {
            Sameˉnominal = Caseˉnominal.Kind == Matchˉnominal.Kind;
        }
        if Sameˉnominal {
            Sameˉnominal =
                Caseˉnominal.Directoryˉindex == Matchˉnominal.Directoryˉindex;
        }
        if Sameˉnominal {
            Sameˉnominal = Sourceˉsymbols.Compilerˉsourceˉsymbolsˉownedˉmatchˉisˉaccessible(
                Input, Scan, Symbols.Visibility, Symbols.Lookup,
                Result.Currentˉmodule, Source,
                Bodyˉcase.Enumˉoffset, Bodyˉcase.Enumˉlength, Caseˉnominal
            );
        }
        if !Sameˉnominal {
            let Caseˉenumˉposition:
                Sourceˉbodies.Compilerˉsourceˉposition =
                Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
                    Source, Matchˉcursor, Matchˉline, Matchˉcolumn,
                    Bodyˉcase.Enumˉoffset
                );
            var Mismatchˉstatus: Compilerˉsourceˉwirˉstatus =
                Compilerˉsourceˉwirˉstatus.Matchˉenumˉmismatch;
            if Matchˉisˉvariant {
                Mismatchˉstatus =
                    Compilerˉsourceˉwirˉstatus.Matchˉvariantˉmismatch;
            }
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Compilerˉsourceˉwirˉvalueˉbuild(Matchˉvalue),
                Mismatchˉstatus,
                Caseˉnominal.Module,
                Bodyˉcase.Enumˉoffset,
                Caseˉenumˉposition.Line,
                Caseˉenumˉposition.Column
            );
        }
        let Bodyˉmember: Compilerˉsourceˉwirˉmember = Compilerˉsourceˉwirˉnominalˉmember(
            Input, Scan, Symbols, Matchˉnominal,
            Source, Bodyˉcase.Memberˉoffset, Bodyˉcase.Memberˉlength
        );
        let Caseˉmemberˉposition:
            Sourceˉbodies.Compilerˉsourceˉposition =
            Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
                Source, Matchˉcursor, Matchˉline, Matchˉcolumn,
                Bodyˉcase.Memberˉoffset
            );
        if !Bodyˉmember.Found {
            var Unknownˉstatus: Compilerˉsourceˉwirˉstatus =
                Compilerˉsourceˉwirˉstatus.Unknownˉenumˉmember;
            if Matchˉisˉvariant {
                Unknownˉstatus =
                    Compilerˉsourceˉwirˉstatus.Unknownˉvariantˉcase;
            }
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Compilerˉsourceˉwirˉvalueˉbuild(Matchˉvalue),
                Unknownˉstatus,
                Matchˉnominal.Module,
                Bodyˉcase.Memberˉoffset,
                Caseˉmemberˉposition.Line,
                Caseˉmemberˉposition.Column
            );
        }
        var Bindingˉvalid: bool = Bodyˉcase.Bindingˉlength == 0u32;
        if Matchˉisˉvariant {
            Bindingˉvalid = Compilerˉsourceˉwirˉvariantˉpatternˉisˉvalid(
                Input, Scan, Symbols, Source, Bodyˉcase,
                Compilerˉsourceˉwirˉvariantˉtarget(Matchˉvalue.Shape),
                Bodyˉmember.Index
            );
        }
        if !Bindingˉvalid {
            var Bindingˉfailureˉoffset: u32 = Bodyˉcase.Memberˉoffset;
            if Bodyˉcase.Bindingˉlength > 0u32 {
                Bindingˉfailureˉoffset = Bodyˉcase.Bindingˉoffset;
            }
            let Bindingˉfailureˉposition:
                Sourceˉbodies.Compilerˉsourceˉposition =
                Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
                    Source, Matchˉcursor, Matchˉline, Matchˉcolumn,
                    Bindingˉfailureˉoffset
                );
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Compilerˉsourceˉwirˉvalueˉbuild(Matchˉvalue),
                Compilerˉsourceˉwirˉstatus.Invalidˉvariantˉbinding,
                Matchˉnominal.Module,
                Bindingˉfailureˉoffset,
                Bindingˉfailureˉposition.Line,
                Bindingˉfailureˉposition.Column
            );
        }
        if Bytesˉreadˉu8(Matchˉseen, Bodyˉmember.Index) != 0u8 {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Compilerˉsourceˉwirˉvalueˉbuild(Matchˉvalue),
                Compilerˉsourceˉwirˉstatus.Duplicateˉmatchˉcase,
                Matchˉnominal.Module,
                Bodyˉcase.Memberˉoffset,
                Caseˉmemberˉposition.Line,
                Caseˉmemberˉposition.Column
            );
        }
        let Updatedˉseen: Byteˉconstruction.Foundationˉbytesˉresult =
            Byteˉconstruction.Foundationˉbytesˉreplace(
                Matchˉseen,
                Bodyˉmember.Index,
                1u32,
                Bytesˉfromˉu8(1u8)
            );
        if !Updatedˉseen.Valid {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Compilerˉsourceˉwirˉvalueˉbuild(Matchˉvalue),
                Compilerˉsourceˉwirˉstatus.Invalidˉdirectory,
                Matchˉnominal.Module,
                Bodyˉcase.Memberˉoffset,
                Caseˉmemberˉposition.Line,
                Caseˉmemberˉposition.Column
            );
        }
        Matchˉseen = Updatedˉseen.Value;
        let Bodyˉcaseˉblock: u32 = Matchˉbodies.Nextˉblock;
        Matchˉbodies = Compilerˉsourceˉwirˉreserveˉblocks(Matchˉbodies, 1u32);
        var Nextˉtestˉblock: u32 = Compilerˉsourceˉwirˉsentinel();
        if Matchˉcaseˉindex + 1u32 == Match.Cases {
            Matchˉbodies = Compilerˉsourceˉwirˉcloseˉcurrentˉblock(
                Matchˉbodies,
                Compilerˉsourceˉwirˉterminator.Jump,
                Compilerˉsourceˉwirˉsentinel(),
                Bodyˉcaseˉblock,
                Compilerˉsourceˉwirˉsentinel()
            );
        } else {
            var Dispatchˉtemporary: u32 = Compilerˉsourceˉwirˉsentinel();
            if Matchˉisˉvariant {
                let Dispatchˉcase: Compilerˉsourceˉwirˉvalue = Compilerˉsourceˉwirˉemit(
                    Matchˉbodies,
                    WIR_OPERATION_VARIANT_IS_CASE,
                    4u32,
                    Compilerˉsourceˉwirˉoneˉoperand(Matchˉvalue.Temporary),
                    Compilerˉsourceˉwirˉvariantˉtarget(Matchˉvalue.Shape),
                    Bodyˉmember.Index,
                    Bodyˉcase.Memberˉoffset,
                    Bodyˉcase.Memberˉlength
                );
                Matchˉbodies = Compilerˉsourceˉwirˉvalueˉbuild(Dispatchˉcase);
                Dispatchˉtemporary = Dispatchˉcase.Temporary;
            } else {
                let Dispatchˉconstant: Compilerˉsourceˉwirˉvalue = Compilerˉsourceˉwirˉemit(
                    Matchˉbodies,
                    WIR_OPERATION_ENUM_CONSTANT,
                    Matchˉvalue.Shape,
                    Compilerˉsourceˉwirˉempty(Source),
                    Matchˉvalue.Shape - 131072u32,
                    Bodyˉmember.Index,
                    Bodyˉcase.Memberˉoffset,
                    Bodyˉcase.Memberˉlength
                );
                let Dispatchˉequal: Compilerˉsourceˉwirˉvalue = Compilerˉsourceˉwirˉemit(
                    Compilerˉsourceˉwirˉvalueˉbuild(Dispatchˉconstant),
                    WIR_OPERATION_ENUM_EQUAL,
                    4u32,
                    Compilerˉsourceˉwirˉtwoˉoperands(
                        Matchˉvalue.Temporary,
                        Dispatchˉconstant.Temporary
                    ),
                    0u32,
                    0u32,
                    Bodyˉcase.Memberˉoffset,
                    Bodyˉcase.Memberˉlength
                );
                Matchˉbodies = Compilerˉsourceˉwirˉvalueˉbuild(Dispatchˉequal);
                Dispatchˉtemporary = Dispatchˉequal.Temporary;
            }
            Nextˉtestˉblock = Matchˉbodies.Nextˉblock;
            Matchˉbodies = Compilerˉsourceˉwirˉreserveˉblocks(Matchˉbodies, 1u32);
            Matchˉbodies = Compilerˉsourceˉwirˉcloseˉcurrentˉblock(
                Matchˉbodies,
                Compilerˉsourceˉwirˉterminator.Branch,
                Dispatchˉtemporary,
                Bodyˉcaseˉblock,
                Nextˉtestˉblock
            );
        }
        let Bodyˉcaseˉposition: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
            Source, Matchˉcursor, Matchˉline, Matchˉcolumn,
            Bodyˉcase.Blockˉoffset
        );
        let Caseˉbinding: Sourceˉbindings.Compilerˉsourceˉbindingˉbuild =
            Sourceˉbindings.Compilerˉsourceˉbindingsˉcollectˉmatchˉbinding(
                Input, Scan, Symbols,
                Result.Currentˉmodule, Result.Currentˉfunction,
                Source, Bodyˉcase,
                Sourceˉbindings.Compilerˉsourceˉbindingsˉphaseˉbuildˉvalue(Bindingˉphase)
            );
        Bindingˉphase = Sourceˉbindings.Compilerˉsourceˉbindingsˉphaseˉbuild(
            Bindingˉphase, Caseˉbinding
        );
        if Bindingˉphase.Buildˉstatus != Sourceˉbindings.Compilerˉsourceˉbindingˉstatus.Valid {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Compilerˉsourceˉwirˉfusedˉfrom(Matchˉbodies, Bindingˉphase),
                Compilerˉsourceˉwirˉstatus.Sourceˉbindings,
                Compilerˉsourceˉwirˉbindingˉfailureˉrelated(
                    Bindingˉphase.Buildˉstatus,
                    Bindingˉphase.Buildˉfailureˉrelatedˉmodule
                ),
                Bindingˉphase.Buildˉfailureˉoffset,
                Bindingˉphase.Buildˉfailureˉline,
                Bindingˉphase.Buildˉfailureˉcolumn
            );
        }
        var Bodyˉcaseˉstart: Compilerˉsourceˉwirˉbuild = Compilerˉsourceˉwirˉbeginˉreservedˉblock(
            Matchˉbodies,
            Bodyˉcaseˉblock
        );
        if Matchˉisˉvariant {
            Bodyˉcaseˉstart =
                Compilerˉsourceˉwirˉbindˉvariantˉpattern(
                    Input, Scan, Symbols, Source,
                    Matchˉvalue.Temporary,
                    Compilerˉsourceˉwirˉvariantˉtarget(Matchˉvalue.Shape),
                    Bodyˉmember.Index,
                    Bodyˉcase,
                    Sourceˉbindings.Compilerˉsourceˉbindingsˉphaseˉbuildˉvalue(
                        Bindingˉphase
                    ),
                    Bodyˉcaseˉstart
                );
            if Bodyˉcaseˉstart.Status !=
                Compilerˉsourceˉwirˉstatus.Valid {
                return Compilerˉsourceˉwirˉvalueˉfrom(
                    Compilerˉsourceˉwirˉfusedˉfrom(
                        Bodyˉcaseˉstart, Bindingˉphase
                    ),
                    0u32,
                    Compilerˉsourceˉwirˉsentinel()
                );
            }
        }
        if Valueˉform {
            let Bodyˉvalueˉblock:
                Sourceˉbodies.Compilerˉsourceˉvalueˉblock =
                Sourceˉbodies.Compilerˉbodyˉparseˉvalueˉblock(
                    Source,
                    Bodyˉcase.Blockˉoffset,
                    Bodyˉcaseˉposition.Line,
                    Bodyˉcaseˉposition.Column,
                    Bodyˉcase.Blockˉoffset + Bodyˉcase.Blockˉlength,
                    0u32
                );
            var Bodyˉcaseˉvalue: Compilerˉsourceˉwirˉvalue =
                Compilerˉsourceˉwirˉcompileˉvalueˉblock(
                    Input, Scan, Symbols, Bindingˉphase, Source,
                    Bodyˉvalueˉblock,
                    Bodyˉcaseˉposition.Line,
                    Bodyˉcaseˉposition.Column,
                    Returnˉshape,
                    Continueˉtarget,
                    Breakˉtarget,
                    Bodyˉcaseˉstart
                );
            if Bodyˉcaseˉvalue.Status != Compilerˉsourceˉwirˉstatus.Valid {
                return Bodyˉcaseˉvalue;
            }
            if Hasˉmatchˉresult {
                Bodyˉcaseˉvalue = Compilerˉsourceˉwirˉjoinˉbranchˉvalues(
                    Bodyˉcaseˉstart,
                    Bodyˉcase.Blockˉoffset,
                    Bodyˉcaseˉposition.Line,
                    Bodyˉcaseˉposition.Column,
                    Match.Offset,
                    Match.Length,
                    Matchˉresult,
                    Bodyˉcaseˉvalue
                );
                if Bodyˉcaseˉvalue.Status !=
                    Compilerˉsourceˉwirˉstatus.Valid {
                    return Bodyˉcaseˉvalue;
                }
            }
            Bindingˉphase = Compilerˉsourceˉwirˉbuildˉbindings(
                Input, Compilerˉsourceˉwirˉvalueˉbuild(Bodyˉcaseˉvalue)
            );
            Matchˉresult = Bodyˉcaseˉvalue;
            Hasˉmatchˉresult = true;
            Matchˉbodies = Compilerˉsourceˉwirˉvalueˉbuild(Matchˉresult);
        } else {
            let Bodyˉcaseˉresult: Compilerˉsourceˉwirˉbuild =
                Compilerˉsourceˉwirˉcompileˉblock(
                    Input, Scan, Symbols,
                    Bindingˉphase,
                    Source,
                    Bodyˉcase.Blockˉoffset,
                    Bodyˉcaseˉposition.Line,
                    Bodyˉcaseˉposition.Column,
                    Bodyˉcase.Blockˉoffset + Bodyˉcase.Blockˉlength,
                    Bodyˉcase.Blockˉoffset + Bodyˉcase.Blockˉlength,
                    Returnˉshape,
                    Continueˉtarget,
                    Breakˉtarget,
                    Bodyˉcaseˉstart
                );
            if Bodyˉcaseˉresult.Status != Compilerˉsourceˉwirˉstatus.Valid {
                return Compilerˉsourceˉwirˉvalueˉfrom(
                    Compilerˉsourceˉwirˉfusedˉfrom(
                        Bodyˉcaseˉresult, Bindingˉphase
                    ),
                    0u32,
                    Compilerˉsourceˉwirˉsentinel()
                );
            }
            Bindingˉphase = Compilerˉsourceˉwirˉbuildˉbindings(
                Input, Bodyˉcaseˉresult
            );
            Matchˉbodies = Bodyˉcaseˉresult;
            if Matchˉbodies.Hasˉcurrentˉblock {
                Matchˉbodies = Compilerˉsourceˉwirˉcloseˉcurrentˉblock(
                    Matchˉbodies,
                    Compilerˉsourceˉwirˉterminator.Jump,
                    Compilerˉsourceˉwirˉsentinel(),
                    Compilerˉsourceˉwirˉsentinel(),
                    Compilerˉsourceˉwirˉsentinel()
                );
            }
        }
        Matchˉbodies = Compilerˉsourceˉwirˉwithoutˉcurrentˉblock(Matchˉbodies);
        if Matchˉcaseˉindex + 1u32 < Match.Cases {
            Matchˉbodies = Compilerˉsourceˉwirˉbeginˉreservedˉblock(
                Matchˉbodies, Nextˉtestˉblock
            );
        }
        Matchˉcursor = Bodyˉcase.Nextˉoffset;
        Matchˉline = Bodyˉcase.Nextˉline;
        Matchˉcolumn = Bodyˉcase.Nextˉcolumn;
        Matchˉcaseˉindex = Matchˉcaseˉindex + 1u32;
    }
    if Valueˉform {
        return Matchˉresult;
    }
    var Matchˉfallthroughs: u32 = 0u32;
    var Matchˉblockˉindex: u32 = Matchˉcaseˉblocks;
    while Matchˉblockˉindex < Matchˉbodies.Nextˉblock {
        let Matchˉblockˉoffset: u32 = Matchˉblockˉindex * 28u32;
        if Bytesˉreadˉu32ˉlittle(Matchˉbodies.Blockˉpayload, Matchˉblockˉoffset + 12u32) == 1u32 {
            if Bytesˉreadˉu32ˉlittle(Matchˉbodies.Blockˉpayload, Matchˉblockˉoffset + 20u32) == Compilerˉsourceˉwirˉsentinel() {
                Matchˉfallthroughs = Matchˉfallthroughs + 1u32;
            }
        }
        Matchˉblockˉindex = Matchˉblockˉindex + 1u32;
    }
    Result = Compilerˉsourceˉwirˉwithoutˉcurrentˉblock(Matchˉbodies);
    if Matchˉfallthroughs > 0u32 {
        let Matchˉjoin: u32 = Result.Nextˉblock;
        Result = Compilerˉsourceˉwirˉreserveˉblocks(Result, 1u32);
        Matchˉblockˉindex = Matchˉcaseˉblocks;
        while Matchˉblockˉindex < Matchˉjoin {
            let Matchˉpatchedˉblockˉoffset: u32 = Matchˉblockˉindex * 28u32;
            if Bytesˉreadˉu32ˉlittle(Result.Blockˉpayload, Matchˉpatchedˉblockˉoffset + 12u32) == 1u32 {
                if Bytesˉreadˉu32ˉlittle(Result.Blockˉpayload, Matchˉpatchedˉblockˉoffset + 20u32) == Compilerˉsourceˉwirˉsentinel() {
                    Result = Compilerˉsourceˉwirˉappendˉblock(
                        Result,
                        Matchˉblockˉindex,
                        Bytesˉreadˉu32ˉlittle(Result.Blockˉpayload, Matchˉpatchedˉblockˉoffset + 4u32),
                        Bytesˉreadˉu32ˉlittle(Result.Blockˉpayload, Matchˉpatchedˉblockˉoffset + 8u32),
                        Compilerˉsourceˉwirˉterminator.Jump,
                        Compilerˉsourceˉwirˉsentinel(),
                        Matchˉjoin,
                        Compilerˉsourceˉwirˉsentinel()
                    );
                }
            }
            Matchˉblockˉindex = Matchˉblockˉindex + 1u32;
        }
        Result = Compilerˉsourceˉwirˉbeginˉreservedˉblock(Result, Matchˉjoin);
    }
    return Compilerˉsourceˉwirˉvalueˉfrom(
        Compilerˉsourceˉwirˉfusedˉfrom(Result, Bindingˉphase),
        0u32,
        Compilerˉsourceˉwirˉsentinel()
    );
}

fn Compilerˉsourceˉwirˉcompileˉtry(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Bindings: Sourceˉbindings.Compilerˉsourceˉbindingˉphase,
    Source: bytes,
    Statement: Sourceˉbodies.Compilerˉsourceˉstatement,
    Build: Compilerˉsourceˉwirˉbuild
) -> Compilerˉsourceˉwirˉbuild {
    let Bindingˉbuild: Sourceˉbindings.Compilerˉsourceˉbindingˉbuild =
        Sourceˉbindings.Compilerˉsourceˉbindingsˉphaseˉbuildˉvalue(Bindings);
    let Currentˉview: Sourceˉset.Compilerˉsourceˉsetˉview =
        Sourceˉset.Compilerˉsourceˉsetˉmodule(
            Input, Scan, Build.Currentˉmodule
        );
    let Tryˉposition: Sourceˉbodies.Compilerˉsourceˉposition =
        Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
            Source,
            Statement.Offset,
            Statement.Line,
            Statement.Column,
            Statement.Expressionˉoffset
        );
    let Tryˉvalue: Compilerˉsourceˉwirˉvalue =
        Compilerˉsourceˉwirˉcompileˉexpression(
            Input,
            Scan,
            Symbols,
            Bindingˉbuild.Payload,
            Bindingˉbuild.Entries - Bindingˉbuild.Nextˉslot,
            Bindingˉbuild.Entries,
            Source,
            Statement.Expressionˉoffset,
            Tryˉposition.Line,
            Tryˉposition.Column,
            Statement.Expressionˉoffset + Statement.Expressionˉlength,
            Compilerˉsourceˉwirˉfusedˉfrom(Build, Bindings)
        );
    if Tryˉvalue.Status != Compilerˉsourceˉwirˉstatus.Valid {
        return Compilerˉsourceˉwirˉfusedˉfrom(
            Compilerˉsourceˉwirˉvalueˉbuild(Tryˉvalue), Bindings
        );
    }
    let Result: Compilerˉsourceˉwirˉvalue =
        Compilerˉsourceˉwirˉcompileˉvalueˉtry(
            Input, Scan, Symbols, Source,
            Statement.Offset, Statement.Line, Statement.Column,
            Statement.Length, Tryˉvalue, Currentˉview.Edition == 1u32
        );
    return Compilerˉsourceˉwirˉfusedˉfrom(
        Compilerˉsourceˉwirˉvalueˉbuild(Result), Bindings
    );
}

fn Compilerˉsourceˉwirˉcompileˉwhile(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Bindings: Sourceˉbindings.Compilerˉsourceˉbindingˉphase,
    Source: bytes,
    Statement: Sourceˉbodies.Compilerˉsourceˉstatement,
    Returnˉshape: u32,
    Build: Compilerˉsourceˉwirˉbuild
) -> Compilerˉsourceˉwirˉbuild {
    var Bindingˉphase: Sourceˉbindings.Compilerˉsourceˉbindingˉphase = Bindings;
    let Bindingˉbuild: Sourceˉbindings.Compilerˉsourceˉbindingˉbuild =
        Sourceˉbindings.Compilerˉsourceˉbindingsˉphaseˉbuildˉvalue(
            Bindingˉphase
        );
    let Bindingˉpayload: bytes = Bindingˉbuild.Payload;
    let Bindingˉfirst: u32 = Bindingˉbuild.Entries - Bindingˉbuild.Nextˉslot;
    let Bindingˉentries: u32 = Bindingˉbuild.Entries;
    let Headerˉblock: u32 = Build.Nextˉblock;
    var Result: Compilerˉsourceˉwirˉbuild =
        Compilerˉsourceˉwirˉreserveˉblocks(Build, 1u32);
    Result = Compilerˉsourceˉwirˉcloseˉcurrentˉblock(
        Result,
        Compilerˉsourceˉwirˉterminator.Jump,
        Compilerˉsourceˉwirˉsentinel(),
        Headerˉblock,
        Compilerˉsourceˉwirˉsentinel()
    );
    Result = Compilerˉsourceˉwirˉbeginˉreservedˉblock(Result, Headerˉblock);
    let Conditionˉposition: Sourceˉbodies.Compilerˉsourceˉposition =
        Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
            Source, Statement.Offset, Statement.Line, Statement.Column,
            Statement.Expressionˉoffset
        );
    let Conditionˉexpression: Sourceˉbodies.Compilerˉsourceˉexpression =
        Sourceˉbodies.Compilerˉparseˉexpressionˉvalidated(
            Source,
            Statement.Expressionˉoffset,
            Conditionˉposition.Line,
            Conditionˉposition.Column,
            Statement.Expressionˉoffset + Statement.Expressionˉlength,
            0u32,
            0u32
        );
    let Isˉunconditional: bool =
        Conditionˉexpression.Kind ==
            Sourceˉbodies.Compilerˉsourceˉexpressionˉkind.Boolean &&
        Conditionˉexpression.Booleanˉvalue;
    let Condition: Compilerˉsourceˉwirˉvalue =
        Compilerˉsourceˉwirˉcompileˉexpression(
            Input, Scan, Symbols,
            Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
            Source,
            Statement.Expressionˉoffset,
            Conditionˉposition.Line,
            Conditionˉposition.Column,
            Statement.Expressionˉoffset + Statement.Expressionˉlength,
            Result
        );
    if Condition.Status != Compilerˉsourceˉwirˉstatus.Valid {
        return Compilerˉsourceˉwirˉfusedˉfrom(
            Compilerˉsourceˉwirˉvalueˉbuild(Condition), Bindingˉphase
        );
    }
    if Condition.Shape == 10u32 {
        return Compilerˉsourceˉwirˉfusedˉfrom(
            Compilerˉsourceˉwirˉvalueˉbuild(Condition), Bindingˉphase
        );
    }
    if Condition.Shape != 4u32 {
        return Compilerˉsourceˉwirˉfusedˉfrom(
            Compilerˉsourceˉwirˉbuildˉfailure(
                Compilerˉsourceˉwirˉvalueˉbuild(Condition),
                Compilerˉsourceˉwirˉstatus.Invalidˉcondition,
                Build.Currentˉmodule, Build.Currentˉmodule,
                Build.Currentˉfunction,
                Statement.Expressionˉoffset,
                Conditionˉposition.Line,
                Conditionˉposition.Column
            ),
            Bindingˉphase
        );
    }
    let Bodyˉblock: u32 = Condition.Nextˉblock;
    let Afterˉblock: u32 = Bodyˉblock + 1u32;
    Result = Compilerˉsourceˉwirˉreserveˉblocks(
        Compilerˉsourceˉwirˉvalueˉbuild(Condition), 2u32
    );
    Result = Compilerˉsourceˉwirˉcloseˉcurrentˉblock(
        Result,
        Compilerˉsourceˉwirˉterminator.Branch,
        Condition.Temporary,
        Bodyˉblock,
        Afterˉblock
    );
    Result = Compilerˉsourceˉwirˉbeginˉreservedˉblock(Result, Bodyˉblock);
    let Bodyˉposition: Sourceˉbodies.Compilerˉsourceˉposition =
        Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
            Source, Statement.Offset, Statement.Line, Statement.Column,
            Statement.Firstˉblockˉoffset
        );
    let Bodyˉcompiled: Compilerˉsourceˉwirˉbuild =
        Compilerˉsourceˉwirˉcompileˉblock(
            Input, Scan, Symbols,
            Bindingˉphase,
            Source,
            Statement.Firstˉblockˉoffset,
            Bodyˉposition.Line,
            Bodyˉposition.Column,
            Statement.Firstˉblockˉoffset + Statement.Firstˉblockˉlength,
            Statement.Firstˉblockˉoffset + Statement.Firstˉblockˉlength,
            Returnˉshape,
            Headerˉblock,
            Afterˉblock,
            Result
        );
    if Bodyˉcompiled.Status != Compilerˉsourceˉwirˉstatus.Valid {
        return Bodyˉcompiled;
    }
    Result = Bodyˉcompiled;
    Bindingˉphase = Compilerˉsourceˉwirˉbuildˉbindings(Input, Bodyˉcompiled);
    if Result.Hasˉcurrentˉblock {
        Result = Compilerˉsourceˉwirˉcloseˉcurrentˉblock(
            Result,
            Compilerˉsourceˉwirˉterminator.Jump,
            Compilerˉsourceˉwirˉsentinel(),
            Headerˉblock,
            Compilerˉsourceˉwirˉsentinel()
        );
    }
    var Hasˉafterˉpredecessor: bool = !Isˉunconditional;
    if Isˉunconditional {
        var Blockˉindex: u32 = Bodyˉblock;
        while Blockˉindex < Result.Nextˉblock {
            let Blockˉoffset: u32 = Blockˉindex * 28u32;
            let Terminator: u32 = Bytesˉreadˉu32ˉlittle(
                Result.Blockˉpayload, Blockˉoffset + 12u32
            );
            if Terminator == 1u32 {
                if Bytesˉreadˉu32ˉlittle(
                    Result.Blockˉpayload, Blockˉoffset + 20u32
                ) == Afterˉblock {
                    Hasˉafterˉpredecessor = true;
                }
            }
            if Terminator == 2u32 {
                if Bytesˉreadˉu32ˉlittle(
                    Result.Blockˉpayload, Blockˉoffset + 20u32
                ) == Afterˉblock {
                    Hasˉafterˉpredecessor = true;
                }
                if Bytesˉreadˉu32ˉlittle(
                    Result.Blockˉpayload, Blockˉoffset + 24u32
                ) == Afterˉblock {
                    Hasˉafterˉpredecessor = true;
                }
            }
            Blockˉindex = Blockˉindex + 1u32;
        }
    }
    if Hasˉafterˉpredecessor {
        Result = Compilerˉsourceˉwirˉbeginˉreservedˉblock(
            Result, Afterˉblock
        );
    } else {
        Result = Compilerˉsourceˉwirˉappendˉblock(
            Result,
            Afterˉblock,
            Result.Operations,
            0u32,
            Compilerˉsourceˉwirˉterminator.Jump,
            Compilerˉsourceˉwirˉsentinel(),
            Afterˉblock,
            Compilerˉsourceˉwirˉsentinel()
        );
    }
    return Compilerˉsourceˉwirˉfusedˉfrom(Result, Bindingˉphase);
}

export fn Compilerˉsourceˉwirˉcompileˉblock(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Bindings: Sourceˉbindings.Compilerˉsourceˉbindingˉphase,
    Source: bytes,
    Offset: u32,
    Line: u32,
    Column: u32,
    Endˉoffset: u32,
    Scopeˉendˉoffset: u32,
    Returnˉshape: u32,
    Continueˉtarget: u32,
    Breakˉtarget: u32,
    Build: Compilerˉsourceˉwirˉbuild
) -> Compilerˉsourceˉwirˉbuild {
    let Start: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉbodies.Compilerˉbodyˉtoken(
        Source, Offset, Line, Column, Endˉoffset
    );
    let Isˉblock: bool = Start.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Leftˉbrace;
    var Cursor: u32 = Start.Offset;
    var Currentˉline: u32 = Start.Line;
    var Currentˉcolumn: u32 = Start.Column;
    if Isˉblock {
        Cursor = Start.Nextˉoffset;
        Currentˉline = Start.Nextˉline;
        Currentˉcolumn = Start.Nextˉcolumn;
    }
    var Result: Compilerˉsourceˉwirˉbuild =
        Compilerˉsourceˉwirˉfusedˉfrom(Build, Bindings);
    var Bindingˉphase: Sourceˉbindings.Compilerˉsourceˉbindingˉphase = Bindings;
    var Reading: bool = true;
    while Reading {
        let Current: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉbodies.Compilerˉbodyˉtoken(
            Source, Cursor, Currentˉline, Currentˉcolumn, Endˉoffset
        );
        if Isˉblock {
            if Current.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Rightˉbrace {
                Reading = false;
            }
        } else {
            if Current.Kind == Sourceˉlexer.Compilerˉtokenˉkind.End {
                Reading = false;
            }
        }
        if Reading {
            if !Result.Hasˉcurrentˉblock {
                return Compilerˉsourceˉwirˉfusedˉfrom(
                    Compilerˉsourceˉwirˉbuildˉfailure(
                        Result,
                        Compilerˉsourceˉwirˉstatus.Unreachableˉstatement,
                        Result.Currentˉmodule,
                        Result.Currentˉmodule,
                        Result.Currentˉfunction,
                        Current.Offset,
                        Current.Line,
                        Current.Column
                    ),
                    Bindingˉphase
                );
            }
            let Statement: Sourceˉbodies.Compilerˉsourceˉstatement = Sourceˉbodies.Compilerˉparseˉnextˉstatementˉvalidated(
                Source, Cursor, Currentˉline, Currentˉcolumn, Endˉoffset, 0u32
            );
            let Bindingˉbuild: Sourceˉbindings.Compilerˉsourceˉbindingˉbuild =
                Sourceˉbindings.Compilerˉsourceˉbindingsˉphaseˉbuildˉvalue(Bindingˉphase);
            let Bindingˉpayload: bytes = Bindingˉbuild.Payload;
            let Bindingˉfirst: u32 = Bindingˉbuild.Entries - Bindingˉbuild.Nextˉslot;
            let Bindingˉentries: u32 = Bindingˉbuild.Entries;
            if Statement.Kind == Sourceˉbodies.Compilerˉsourceˉstatementˉkind.Local {
                let Localˉposition: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
                    Source, Statement.Offset, Statement.Line, Statement.Column,
                    Statement.Expressionˉoffset
                );
                let Localˉvalue: Compilerˉsourceˉwirˉvalue = Compilerˉsourceˉwirˉcompileˉexpression(
                    Input, Scan, Symbols,
                    Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
                    Source,
                    Statement.Expressionˉoffset, Localˉposition.Line, Localˉposition.Column,
                    Statement.Expressionˉoffset + Statement.Expressionˉlength,
                    Result
                );
                if Localˉvalue.Status != Compilerˉsourceˉwirˉstatus.Valid {
                    return Compilerˉsourceˉwirˉfusedˉfrom(
                        Compilerˉsourceˉwirˉvalueˉbuild(Localˉvalue), Bindingˉphase
                    );
                }
                if Localˉvalue.Shape == 10u32 {
                    Result = Compilerˉsourceˉwirˉvalueˉbuild(Localˉvalue);
                } else {
                if Compilerˉsourceˉwirˉshapeˉisˉbuilder(Localˉvalue.Shape) && !Statement.Isˉmutable {
                    return Compilerˉsourceˉwirˉfusedˉfrom(
                        Compilerˉsourceˉwirˉbuildˉfailure(
                            Compilerˉsourceˉwirˉvalueˉbuild(Localˉvalue),
                            Compilerˉsourceˉwirˉstatus.Invalidˉbuilder,
                            Result.Currentˉmodule, Result.Currentˉmodule, Result.Currentˉfunction,
                            Statement.Offset, Statement.Line, Statement.Column
                        ), Bindingˉphase
                    );
                }
                if Statement.Typeˉkind == Sourceˉdeclarations.Compilerˉsourceˉtypeˉkind.Unknown {
                    if Localˉvalue.Shape == 0u32 {
                        return Compilerˉsourceˉwirˉfusedˉfrom(
                            Compilerˉsourceˉwirˉbuildˉfailure(
                                Compilerˉsourceˉwirˉvalueˉbuild(Localˉvalue),
                                Compilerˉsourceˉwirˉstatus.Invalidˉinference,
                                Result.Currentˉmodule, Result.Currentˉmodule,
                                Result.Currentˉfunction,
                                Statement.Expressionˉoffset,
                                Localˉposition.Line,
                                Localˉposition.Column
                            ),
                            Bindingˉphase
                        );
                    }
                }
                var Localˉbuild: Compilerˉsourceˉwirˉbuild =
                    Compilerˉsourceˉwirˉvalueˉbuild(Localˉvalue);
                var Declaredˉshape: u32 = Localˉvalue.Shape;
                if Statement.Typeˉkind !=
                        Sourceˉdeclarations.Compilerˉsourceˉtypeˉkind.Unknown {
                    let Typeˉposition: Sourceˉbodies.Compilerˉsourceˉposition =
                        Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
                            Source, Statement.Offset,
                            Statement.Line, Statement.Column,
                            Statement.Typeˉoffset
                        );
                    let Declared:
                        Genericˉtypeˉbinding.Compilerˉsourceˉgenericˉtypeˉbinding =
                        Compilerˉsourceˉwirˉbindˉgenericˉtype(
                            Input, Scan, Symbols, Source,
                            Statement.Typeˉoffset,
                            Typeˉposition.Line, Typeˉposition.Column,
                            Localˉbuild
                        );
                    if Declared.Status !=
                            Sourceˉsymbols.Compilerˉsourceˉsymbolˉstatus.Valid ||
                        Declared.Genericˉstatus !=
                            Sourceˉgenerics.Compilerˉsourceˉgenericˉstatus.Valid {
                        return Compilerˉsourceˉwirˉfusedˉfrom(
                            Compilerˉsourceˉwirˉbuildˉfailure(
                                Localˉbuild,
                                Compilerˉsourceˉwirˉstatus.Genericˉresolution,
                                Result.Currentˉmodule,
                                Result.Currentˉmodule,
                                Result.Currentˉfunction,
                                Declared.Failureˉoffset,
                                Declared.Failureˉline,
                                Declared.Failureˉcolumn
                            ),
                            Bindingˉphase
                        );
                    }
                    Declaredˉshape = Declared.Shape;
                    Localˉbuild =
                        Compilerˉsourceˉwirˉwithˉgenericˉtypeˉevidence(
                            Localˉbuild, Declared.Catalogˉevidence
                        );
                }
                Bindingˉphase = Sourceˉbindings.Compilerˉsourceˉbindingsˉphaseˉbuild(
                    Bindingˉphase,
                    Sourceˉbindings.Compilerˉsourceˉbindingsˉcollectˉlocalˉshape(
