    if Operation == Compilerˉsourceˉwirˉoperation.Variantˉpayload { return 67u32; }
    if Operation == Compilerˉsourceˉwirˉoperation.Builderˉcreate { return 68u32; }
    if Operation == Compilerˉsourceˉwirˉoperation.Builderˉpush { return 69u32; }
    if Operation == Compilerˉsourceˉwirˉoperation.Builderˉfreeze { return 70u32; }
    if Operation == Compilerˉsourceˉwirˉoperation.Sequenceˉlength { return 71u32; }
    if Operation == Compilerˉsourceˉwirˉoperation.Sequenceˉelement { return 72u32; }
    if Operation == Compilerˉsourceˉwirˉoperation.I32ˉdivide { return 73u32; }
    if Operation == Compilerˉsourceˉwirˉoperation.I32ˉremainder { return 74u32; }
    if Operation == Compilerˉsourceˉwirˉoperation.U32ˉdivide { return 75u32; }
    if Operation == Compilerˉsourceˉwirˉoperation.U32ˉremainder { return 76u32; }
    if Operation == Compilerˉsourceˉwirˉoperation.U8ˉbitwiseˉand { return 77u32; }
    if Operation == Compilerˉsourceˉwirˉoperation.U8ˉbitwiseˉor { return 78u32; }
    if Operation == Compilerˉsourceˉwirˉoperation.U8ˉbitwiseˉxor { return 79u32; }
    if Operation == Compilerˉsourceˉwirˉoperation.U8ˉbitwiseˉnot { return 80u32; }
    if Operation == Compilerˉsourceˉwirˉoperation.U8ˉshiftˉleft { return 81u32; }
    if Operation == Compilerˉsourceˉwirˉoperation.U8ˉshiftˉright { return 82u32; }
    if Operation == Compilerˉsourceˉwirˉoperation.U32ˉbitwiseˉand { return 83u32; }
    if Operation == Compilerˉsourceˉwirˉoperation.U32ˉbitwiseˉor { return 84u32; }
    if Operation == Compilerˉsourceˉwirˉoperation.U32ˉbitwiseˉxor { return 85u32; }
    if Operation == Compilerˉsourceˉwirˉoperation.U32ˉbitwiseˉnot { return 86u32; }
    if Operation == Compilerˉsourceˉwirˉoperation.U32ˉshiftˉleft { return 87u32; }
    if Operation == Compilerˉsourceˉwirˉoperation.U32ˉshiftˉright { return 88u32; }
    if Operation == Compilerˉsourceˉwirˉoperation.Textˉequal { return 89u32; }
    if Operation == Compilerˉsourceˉwirˉoperation.Textˉnotˉequal { return 90u32; }
    if Operation == Compilerˉsourceˉwirˉoperation.Bytesˉequal { return 91u32; }
    if Operation == Compilerˉsourceˉwirˉoperation.Bytesˉnotˉequal { return 92u32; }
    if Operation == Compilerˉsourceˉwirˉoperation.I64ˉconstant { return 93u32; }
    if Operation == Compilerˉsourceˉwirˉoperation.U64ˉconstant { return 94u32; }
    if Operation == Compilerˉsourceˉwirˉoperation.I64ˉformat { return 95u32; }
    if Operation == Compilerˉsourceˉwirˉoperation.U64ˉformat { return 96u32; }
    if Operation == Compilerˉsourceˉwirˉoperation.I64ˉadd { return 97u32; }
    if Operation == Compilerˉsourceˉwirˉoperation.I64ˉsubtract { return 98u32; }
    if Operation == Compilerˉsourceˉwirˉoperation.I64ˉmultiply { return 99u32; }
    if Operation == Compilerˉsourceˉwirˉoperation.I64ˉnegate { return 100u32; }
    if Operation == Compilerˉsourceˉwirˉoperation.U64ˉadd { return 101u32; }
    if Operation == Compilerˉsourceˉwirˉoperation.U64ˉsubtract { return 102u32; }
    if Operation == Compilerˉsourceˉwirˉoperation.U64ˉmultiply { return 103u32; }
    if Operation == Compilerˉsourceˉwirˉoperation.I64ˉequal { return 104u32; }
    if Operation == Compilerˉsourceˉwirˉoperation.I64ˉnotˉequal { return 105u32; }
    if Operation == Compilerˉsourceˉwirˉoperation.I64ˉless { return 106u32; }
    if Operation == Compilerˉsourceˉwirˉoperation.I64ˉlessˉequal { return 107u32; }
    if Operation == Compilerˉsourceˉwirˉoperation.I64ˉgreater { return 108u32; }
    if Operation == Compilerˉsourceˉwirˉoperation.I64ˉgreaterˉequal { return 109u32; }
    if Operation == Compilerˉsourceˉwirˉoperation.U64ˉequal { return 110u32; }
    if Operation == Compilerˉsourceˉwirˉoperation.U64ˉnotˉequal { return 111u32; }
    if Operation == Compilerˉsourceˉwirˉoperation.U64ˉless { return 112u32; }
    if Operation == Compilerˉsourceˉwirˉoperation.U64ˉlessˉequal { return 113u32; }
    if Operation == Compilerˉsourceˉwirˉoperation.U64ˉgreater { return 114u32; }
    if Operation == Compilerˉsourceˉwirˉoperation.U64ˉgreaterˉequal { return 115u32; }
    if Operation == Compilerˉsourceˉwirˉoperation.I64ˉdivide { return 116u32; }
    if Operation == Compilerˉsourceˉwirˉoperation.I64ˉremainder { return 117u32; }
    if Operation == Compilerˉsourceˉwirˉoperation.U64ˉdivide { return 118u32; }
    if Operation == Compilerˉsourceˉwirˉoperation.U64ˉremainder { return 119u32; }
    if Operation == Compilerˉsourceˉwirˉoperation.U64ˉbitwiseˉand { return 120u32; }
    if Operation == Compilerˉsourceˉwirˉoperation.U64ˉbitwiseˉor { return 121u32; }
    if Operation == Compilerˉsourceˉwirˉoperation.U64ˉbitwiseˉxor { return 122u32; }
    if Operation == Compilerˉsourceˉwirˉoperation.U64ˉbitwiseˉnot { return 123u32; }
    if Operation == Compilerˉsourceˉwirˉoperation.U64ˉshiftˉleft { return 124u32; }
    if Operation == Compilerˉsourceˉwirˉoperation.U64ˉshiftˉright { return 125u32; }
    if Operation == Compilerˉsourceˉwirˉoperation.Bytesˉreadˉu64ˉlittle { return 126u32; }
    if Operation == Compilerˉsourceˉwirˉoperation.Bytesˉfromˉu64ˉlittle { return 127u32; }
    if Operation == Compilerˉsourceˉwirˉoperation.U64ˉfromˉu32 { return 128u32; }
    return 0u32;
}

export fn Compilerˉsourceˉwirˉterminatorˉvalue(
    Terminator: Compilerˉsourceˉwirˉterminator
) -> u32 {
    if Terminator == Compilerˉsourceˉwirˉterminator.Jump { return 1u32; }
    if Terminator == Compilerˉsourceˉwirˉterminator.Branch { return 2u32; }
    if Terminator == Compilerˉsourceˉwirˉterminator.Return { return 3u32; }
    return 0u32;
}

export fn Compilerˉsourceˉwirˉbuildˉempty(
    Input: bytes,
    Modules: u32,
    Functions: u32
) -> Compilerˉsourceˉwirˉbuild {
    let Empty: bytes = Compilerˉsourceˉwirˉempty(Input);
    return Compilerˉsourceˉwirˉbuild(
        Compilerˉsourceˉwirˉstatus.Valid,
        Empty, Empty, Empty, Empty, Empty,
        0u32, 0u32, 0u32, 0u32, 0u32,
        Modules, Functions,
        0u32, 0u32, 0u32, 0u32,
        0u32, 0u32, 0u32, false,
        Empty, 0u32, 0u32, 0u32, 0u32,
        Modules, Modules, Functions, Bytesˉlength(Input), 0u32, 0u32
    );
}

export fn Compilerˉsourceˉwirˉbuildˉfailure(
    Build: Compilerˉsourceˉwirˉbuild,
    Status: Compilerˉsourceˉwirˉstatus,
    Module: u32,
    Relatedˉmodule: u32,
    Function: u32,
    Offset: u32,
    Line: u32,
    Column: u32
) -> Compilerˉsourceˉwirˉbuild {
    return Compilerˉsourceˉwirˉbuild(
        Status,
        Build.Functionˉpayload, Build.Blockˉpayload, Build.Operationˉpayload,
        Build.Temporaryˉpayload, Build.Operandˉpayload,
        Build.Functionˉentries, Build.Blocks, Build.Operations,
        Build.Temporaries, Build.Operands,
        Build.Currentˉmodule, Build.Currentˉfunction,
        Build.Functionˉfirstˉblock, Build.Functionˉfirstˉoperation,
        Build.Functionˉfirstˉtemporary, Build.Functionˉfirstˉoperand,
        Build.Nextˉblock, Build.Currentˉblock,
        Build.Currentˉblockˉfirstˉoperation, Build.Hasˉcurrentˉblock,
        Build.Bindingˉpayload, Build.Bindingˉentries,
        Build.Bindingˉparameters, Build.Bindingˉlocals, Build.Bindingˉnextˉslot,
        Module, Relatedˉmodule, Function, Offset, Line, Column
    );
}

