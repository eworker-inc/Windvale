fn Compilerˉsourceˉwirˉfindˉexactˉfoundationˉshape(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Moduleˉname: text,
    Typeˉname: text,
    Isˉvariant: bool
) -> u32 {
    var First: u32 = 65536u32;
    var Count: u32 = Symbols.Records;
    if Isˉvariant {
        First = 196608u32 + Symbols.Records + Symbols.Enums;
        Count = Symbols.Variants;
    }
    var Index: u32 = 0u32;
    while Index < Count {
        let Shape: u32 = First + Index;
        var Matches: bool = Compilerˉsourceˉwirˉisˉexactˉfoundationˉrecord(
            Input, Scan, Symbols, Shape, Moduleˉname, Typeˉname
        );
        if Isˉvariant {
            Matches = Compilerˉsourceˉwirˉisˉexactˉfoundationˉvariant(
                Input, Scan, Symbols, Shape, Moduleˉname, Typeˉname
            );
        }
        if Matches { return Shape; }
        Index = Index + 1u32;
    }
    return Compilerˉsourceˉwirˉsentinel();
}

fn Compilerˉsourceˉwirˉgenericˉshapeˉisˉexact(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Catalog: Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog,
    Shape: u32,
    Moduleˉname: text,
    Typeˉname: text,
    Parameters: u32,
    Firstˉshape: u32,
    Secondˉshape: u32
) -> bool {
    if Parameters == 0u32 || Parameters > 2u32 ||
        !Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉshapeˉisˉprivate(
            Shape
        ) {
        return false;
    }
    let Instance: u32 =
        Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉshapeˉinstance(Shape);
    if Instance >=
        Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalogˉinstances(Catalog) ||
        Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalogˉinstanceˉparameters(
            Catalog, Instance
        ) != Parameters {
        return false;
    }
    let Nominal: Sourceˉsymbols.Compilerˉsourceˉsymbolˉmatch =
        Sourceˉsymbols.Compilerˉsourceˉsymbolsˉdirectoryˉentry(
            Symbols.Directory, Scan.Modules,
            Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalogˉinstanceˉdeclaration(
                Catalog, Instance
            )
        );
    if !Nominal.Found || Nominal.Module >= Scan.Modules ||
        (Nominal.Kind !=
            Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Record &&
         Nominal.Kind !=
            Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Variant) {
        return false;
    }
    let View: Sourceˉset.Compilerˉsourceˉsetˉview =
        Sourceˉset.Compilerˉsourceˉsetˉmodule(Input, Scan, Nominal.Module);
    let Header: Sourceˉdeclarations.Compilerˉsourceˉheader =
        Sourceˉdeclarations.Compilerˉparseˉheaderˉvalidated(View.Source);
    if View.Edition != 1u32 || Header.Profile !=
            Sourceˉdeclarations.Compilerˉsourceˉprofile.Hosted ||
        !Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(
            View.Source, Header.Nameˉoffset, Header.Nameˉlength,
            Moduleˉname
        ) ||
        !Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(
            View.Source, Nominal.Nameˉoffset, Nominal.Nameˉlength,
            Typeˉname
        ) ||
        Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalogˉshapeˉtypeˉargument(
            Catalog, Shape, 0u32
        ) != Firstˉshape {
        return false;
    }
    if Parameters == 2u32 {
        return Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalogˉshapeˉtypeˉargument(
            Catalog, Shape, 1u32
        ) == Secondˉshape;
    }
    return true;
}

fn Compilerˉsourceˉwirˉshapeˉisˉfoundationˉunsafeˉopaque(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Catalog: Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog,
    Shape: u32
) -> bool {
    if !Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉshapeˉisˉprivate(
            Shape
        ) {
        return false;
    }
    let Instance: u32 =
        Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉshapeˉinstance(Shape);
    if Instance >=
        Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalogˉinstances(Catalog) {
        return false;
    }
    let Parameters: u32 =
        Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalogˉinstanceˉparameters(
            Catalog, Instance
        );
    if Parameters < 1u32 || Parameters > 2u32 { return false; }
    let Layout: Genericˉlayouts.Compilerˉsourceˉgenericˉtypeˉlayout =
        Genericˉlayouts.Compilerˉsourceˉgenericˉtypeˉlayoutˉcreate(
            Input, Scan, Symbols, Catalog, Instance
        );
    if Layout.Shape != Shape || Layout.Fields != 1u32 || Layout.Items != 1u32 ||
        Layout.Kind !=
            Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Record ||
        !Genericˉlayouts.Compilerˉsourceˉgenericˉtypeˉlayoutˉisˉvalid(
            Input, Scan, Symbols, Layout
        ) {
        return false;
    }
    let Nominal: Sourceˉsymbols.Compilerˉsourceˉsymbolˉmatch =
        Sourceˉsymbols.Compilerˉsourceˉsymbolsˉdirectoryˉentry(
            Symbols.Directory, Scan.Modules, Layout.Declaration
        );
    if !Nominal.Found || Nominal.Module >= Scan.Modules { return false; }
    let View: Sourceˉset.Compilerˉsourceˉsetˉview =
        Sourceˉset.Compilerˉsourceˉsetˉmodule(Input, Scan, Nominal.Module);
    let Header: Sourceˉdeclarations.Compilerˉsourceˉheader =
        Sourceˉdeclarations.Compilerˉparseˉheaderˉvalidated(View.Source);
    if View.Edition != 1u32 || Header.Profile !=
            Sourceˉdeclarations.Compilerˉsourceˉprofile.System ||
        !Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(
            View.Source, Header.Nameˉoffset, Header.Nameˉlength,
            "Foundationˉunsafe"
        ) {
        return false;
    }
    var Expectedˉparameters: u32 = 0u32;
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(
            View.Source, Nominal.Nameˉoffset, Nominal.Nameˉlength,
            "Foreignˉpointer"
        ) ||
        Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(
            View.Source, Nominal.Nameˉoffset, Nominal.Nameˉlength,
            "Nullableˉforeignˉpointer"
        ) {
        Expectedˉparameters = 2u32;
    }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(
            View.Source, Nominal.Nameˉoffset, Nominal.Nameˉlength,
            "Foreignˉscratch"
        ) ||
        Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(
            View.Source, Nominal.Nameˉoffset, Nominal.Nameˉlength,
            "Foreignˉwriteˉregion"
        ) {
        Expectedˉparameters = 1u32;
    }
    if Parameters != Expectedˉparameters { return false; }
    let Field: Genericˉlayouts.Compilerˉsourceˉgenericˉtypeˉfield =
        Genericˉlayouts.Compilerˉsourceˉgenericˉtypeˉlayoutˉrecordˉfield(
            Input, Scan, Symbols, Layout, 0u32
        );
    return Field.Found && Field.Shape == 8u32 &&
        Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(
            View.Source, Field.Nameˉoffset, Field.Nameˉlength,
            "Opaqueˉidentity"
        );
}

fn Compilerˉsourceˉwirˉfoundationˉunsafeˉgenericˉisˉexact(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Catalog: Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog,
    Shape: u32,
    Typeˉname: text,
    Parameters: u32,
    Firstˉshape: u32,
    Secondˉshape: u32
) -> bool {
    if !Compilerˉsourceˉwirˉshapeˉisˉfoundationˉunsafeˉopaque(
            Input, Scan, Symbols, Catalog, Shape
        ) {
        return false;
    }
    let Instance: u32 =
        Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉshapeˉinstance(Shape);
    if Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalogˉinstanceˉparameters(
            Catalog, Instance
        ) != Parameters ||
        Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalogˉshapeˉtypeˉargument(
            Catalog, Shape, 0u32
        ) != Firstˉshape {
        return false;
    }
    if Parameters == 2u32 &&
        Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalogˉshapeˉtypeˉargument(
            Catalog, Shape, 1u32
        ) != Secondˉshape {
        return false;
    }
    let Nominal: Sourceˉsymbols.Compilerˉsourceˉsymbolˉmatch =
        Sourceˉsymbols.Compilerˉsourceˉsymbolsˉdirectoryˉentry(
            Symbols.Directory, Scan.Modules,
            Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalogˉinstanceˉdeclaration(
                Catalog, Instance
            )
        );
    if !Nominal.Found || Nominal.Module >= Scan.Modules { return false; }
    let View: Sourceˉset.Compilerˉsourceˉsetˉview =
        Sourceˉset.Compilerˉsourceˉsetˉmodule(Input, Scan, Nominal.Module);
    return Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(
        View.Source, Nominal.Nameˉoffset, Nominal.Nameˉlength, Typeˉname
    );
}

fn Compilerˉsourceˉwirˉforeignˉfailureˉnames() -> bytes {
    return Textˉtoˉutf8(
        "InvalidˉlengthInvalidˉalignmentAllocationUnsupportedˉabiNullAddressˉoverflowOutˉofˉrangeMisalignedAliasingLifetimeˉendedForeignˉpointerˉfailure"
    );
}

fn Compilerˉsourceˉwirˉforeignˉmemoryˉfailureˉcaseˉname(
    Index: u32
) -> bytes {
    let Names: bytes = Compilerˉsourceˉwirˉforeignˉfailureˉnames();
    if Index == 0u32 { return Bytesˉslice(Names, 0u32, 15u32); }
    if Index == 1u32 { return Bytesˉslice(Names, 15u32, 18u32); }
    if Index == 2u32 { return Bytesˉslice(Names, 33u32, 10u32); }
    return Bytesˉslice(Names, 43u32, 16u32);
}

fn Compilerˉsourceˉwirˉforeignˉmemoryˉfailureˉcaseˉfields(
    Index: u32
) -> u32 {
    if Index == 0u32 { return 2u32; }
    if Index == 1u32 || Index == 2u32 { return 1u32; }
    return 0u32;
}

fn Compilerˉsourceˉwirˉisˉfoundationˉforeignˉmemoryˉfailure(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Typeˉcatalog: Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog,
    Shape: u32,
    Module: u32
) -> bool {
    if Shape < 196608u32 || Shape >= 262144u32 || Module >= Scan.Modules {
        return false;
    }
    let Nominal: Sourceˉsymbols.Compilerˉsourceˉsymbolˉmatch =
        Compilerˉsourceˉwirˉnominalˉbyˉshape(Input, Scan, Symbols, Shape);
    if !Nominal.Found || Nominal.Module != Module || Nominal.Kind !=
            Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Variant {
        return false;
    }
    let View: Sourceˉset.Compilerˉsourceˉsetˉview =
        Sourceˉset.Compilerˉsourceˉsetˉmodule(Input, Scan, Module);
    let Header: Sourceˉdeclarations.Compilerˉsourceˉheader =
        Sourceˉdeclarations.Compilerˉparseˉheaderˉvalidated(View.Source);
    if View.Edition != 1u32 || Header.Profile !=
            Sourceˉdeclarations.Compilerˉsourceˉprofile.System ||
        !Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(
            View.Source, Header.Nameˉoffset, Header.Nameˉlength,
            "Foundationˉunsafe"
        ) ||
        !Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(
            View.Source, Nominal.Nameˉoffset, Nominal.Nameˉlength,
            "Foreignˉmemoryˉfailure"
        ) {
        return false;
    }
    let Declaration: Sourceˉdeclarations.Compilerˉsourceˉdeclaration =
        Sourceˉdeclarations.Compilerˉparseˉnextˉdeclarationˉvalidated(
            View.Source, Nominal.Declarationˉoffset, 1u32, 1u32, true
        );
    if Declaration.Kind !=
            Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Variant ||
        Declaration.Items != 4u32 {
        return false;
    }
    var Case: u32 = 0u32;
    while Case < 4u32 {
        let Name: bytes =
            Compilerˉsourceˉwirˉforeignˉmemoryˉfailureˉcaseˉname(Case);
        let Named: Compilerˉsourceˉwirˉmember =
            Compilerˉsourceˉwirˉnominalˉmember(
                Input, Scan, Symbols, Nominal,
                Name, 0u32, Bytesˉlength(Name)
            );
        let Caseˉview: Compilerˉsourceˉwirˉvariantˉcaseˉview =
            Compilerˉsourceˉwirˉvariantˉcaseˉviewˉbyˉindex(
                Input, Scan, Symbols, Typeˉcatalog,
                Shape - 196608u32, Case
            );
        let Fields: u32 =
            Compilerˉsourceˉwirˉforeignˉmemoryˉfailureˉcaseˉfields(Case);
        if !Named.Found || Named.Index != Case || !Caseˉview.Found ||
            Caseˉview.Fields != Fields {
            return false;
        }
        var Field: u32 = 0u32;
        while Field < Fields {
            let Member: Compilerˉsourceˉwirˉmember =
                Compilerˉsourceˉwirˉvariantˉfieldˉbyˉindex(
                    Input, Scan, Symbols, Typeˉcatalog,
                    Shape - 196608u32, Case, Field
                );
            if !Member.Found { return false; }
            if Case == 2u32 {
                let Allocation: Sourceˉsymbols.Compilerˉsourceˉsymbolˉmatch =
                    Compilerˉsourceˉwirˉnominalˉbyˉshape(
                        Input, Scan, Symbols, Member.Shape
                    );
                if !Allocation.Found ||
                    !Compilerˉsourceˉwirˉisˉfoundationˉallocationˉfailure(
                        Input, Scan, Symbols, Member.Shape, Allocation.Module
                    ) {
                    return false;
                }
            } else if Member.Shape != 8u32 {
                return false;
            }
            Field = Field + 1u32;
        }
        Case = Case + 1u32;
    }
    return true;
}

fn Compilerˉsourceˉwirˉforeignˉpointerˉfailureˉcaseˉname(
    Index: u32
) -> bytes {
    let Names: bytes = Compilerˉsourceˉwirˉforeignˉfailureˉnames();
    if Index == 0u32 { return Bytesˉslice(Names, 59u32, 4u32); }
    if Index == 1u32 { return Bytesˉslice(Names, 63u32, 17u32); }
    if Index == 2u32 { return Bytesˉslice(Names, 80u32, 14u32); }
    if Index == 3u32 { return Bytesˉslice(Names, 94u32, 10u32); }
    if Index == 4u32 { return Bytesˉslice(Names, 104u32, 8u32); }
    if Index == 5u32 { return Bytesˉslice(Names, 112u32, 15u32); }
    return Bytesˉslice(Names, 43u32, 16u32);
}

fn Compilerˉsourceˉwirˉforeignˉpointerˉfailureˉcaseˉfields(
    Index: u32
) -> u32 {
    if Index == 1u32 || Index == 2u32 { return 3u32; }
    if Index == 3u32 { return 2u32; }
    return 0u32;
}

fn Compilerˉsourceˉwirˉforeignˉpointerˉfailureˉfieldˉshape(
    Case: u32,
    Field: u32
) -> u32 {
    if Case == 1u32 && Field == 2u32 { return 3u32; }
    return 8u32;
}

fn Compilerˉsourceˉwirˉisˉfoundationˉforeignˉpointerˉfailure(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Typeˉcatalog: Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog,
    Shape: u32,
    Module: u32
) -> bool {
    if Shape < 196608u32 || Shape >= 262144u32 || Module >= Scan.Modules {
        return false;
    }
    let Nominal: Sourceˉsymbols.Compilerˉsourceˉsymbolˉmatch =
        Compilerˉsourceˉwirˉnominalˉbyˉshape(Input, Scan, Symbols, Shape);
    if !Nominal.Found || Nominal.Module != Module || Nominal.Kind !=
            Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Variant {
        return false;
    }
    let View: Sourceˉset.Compilerˉsourceˉsetˉview =
        Sourceˉset.Compilerˉsourceˉsetˉmodule(Input, Scan, Module);
    let Header: Sourceˉdeclarations.Compilerˉsourceˉheader =
        Sourceˉdeclarations.Compilerˉparseˉheaderˉvalidated(View.Source);
    if View.Edition != 1u32 || Header.Profile !=
            Sourceˉdeclarations.Compilerˉsourceˉprofile.System ||
        !Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(
            View.Source, Header.Nameˉoffset, Header.Nameˉlength,
            "Foundationˉunsafe"
        ) ||
        Nominal.Nameˉlength != 25u32 ||
        !Sourceˉset.Compilerˉsourceˉspansˉequal(
            View.Source, Nominal.Nameˉoffset, Nominal.Nameˉlength,
            Compilerˉsourceˉwirˉforeignˉfailureˉnames(),
            127u32, 25u32
        ) {
        return false;
    }
    let Declaration: Sourceˉdeclarations.Compilerˉsourceˉdeclaration =
        Sourceˉdeclarations.Compilerˉparseˉnextˉdeclarationˉvalidated(
            View.Source, Nominal.Declarationˉoffset, 1u32, 1u32, true
        );
    if Declaration.Kind !=
            Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Variant ||
        Declaration.Items != 7u32 {
        return false;
    }
    var Case: u32 = 0u32;
    while Case < 7u32 {
        let Name: bytes =
            Compilerˉsourceˉwirˉforeignˉpointerˉfailureˉcaseˉname(Case);
        let Named: Compilerˉsourceˉwirˉmember =
            Compilerˉsourceˉwirˉnominalˉmember(
                Input, Scan, Symbols, Nominal,
                Name, 0u32, Bytesˉlength(Name)
            );
        let Caseˉview: Compilerˉsourceˉwirˉvariantˉcaseˉview =
            Compilerˉsourceˉwirˉvariantˉcaseˉviewˉbyˉindex(
                Input, Scan, Symbols, Typeˉcatalog,
                Shape - 196608u32, Case
            );
        let Fields: u32 =
            Compilerˉsourceˉwirˉforeignˉpointerˉfailureˉcaseˉfields(Case);
        if !Named.Found || Named.Index != Case || !Caseˉview.Found ||
            Caseˉview.Fields != Fields {
            return false;
        }
        var Field: u32 = 0u32;
        while Field < Fields {
            let Member: Compilerˉsourceˉwirˉmember =
                Compilerˉsourceˉwirˉvariantˉfieldˉbyˉindex(
                    Input, Scan, Symbols, Typeˉcatalog,
                    Shape - 196608u32, Case, Field
                );
            if !Member.Found || Member.Shape !=
                    Compilerˉsourceˉwirˉforeignˉpointerˉfailureˉfieldˉshape(
                        Case, Field
                    ) {
                return false;
            }
            Field = Field + 1u32;
        }
        Case = Case + 1u32;
    }
    return true;
}

fn Compilerˉsourceˉwirˉfindˉexactˉgenericˉshape(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Catalog: Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog,
    Moduleˉname: text,
    Typeˉname: text,
    Parameters: u32,
    Firstˉshape: u32,
    Secondˉshape: u32
) -> u32 {
    let Instances: u32 =
        Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalogˉinstances(Catalog);
    var Instance: u32 = 0u32;
    while Instance < Instances {
        let Shape: u32 =
            Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉshape(Instance);
        if Compilerˉsourceˉwirˉgenericˉshapeˉisˉexact(
                Input, Scan, Symbols, Catalog, Shape,
                Moduleˉname, Typeˉname, Parameters,
                Firstˉshape, Secondˉshape
            ) {
            return Shape;
        }
        Instance = Instance + 1u32;
    }
    return Compilerˉsourceˉwirˉsentinel();
}

fn Compilerˉsourceˉwirˉtaskˉargumentˉmissing(
) -> Compilerˉsourceˉwirˉtaskˉargument {
    return Compilerˉsourceˉwirˉtaskˉargument(
        false, Sourceˉdeclarations.COMPILER_SOURCE_BORROW_MODE_VALUE,
        0u32, 0u32, 1u32, 1u32, 0u32, 0u32, 1u32, 1u32
    );
}

fn Compilerˉsourceˉwirˉtaskˉargumentˉat(
    Source: bytes,
    Call: Sourceˉbodies.Compilerˉsourceˉexpression,
    Selected: u32,
    Label: text
) -> Compilerˉsourceˉwirˉtaskˉargument {
    var Cursor: u32 = Call.Itemsˉoffset;
    var Position: Sourceˉbodies.Compilerˉsourceˉposition =
        Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
            Source, Call.Offset, Call.Line, Call.Column,
            Call.Itemsˉoffset
        );
    var Item: u32 = 0u32;
    while Item < Call.Items {
        var Matches: bool = Item == Selected;
        if Call.Operator == Sourceˉlexer.Compilerˉtokenˉkind.Colon {
            let Name: Sourceˉlexer.Compilerˉsourceˉtoken =
                Sourceˉbodies.Compilerˉbodyˉtoken(
                    Source, Cursor, Position.Line, Position.Column,
                    Call.Itemsˉoffset + Call.Itemsˉlength
                );
            let Colon: Sourceˉlexer.Compilerˉsourceˉtoken =
                Sourceˉbodies.Compilerˉbodyˉtoken(
                    Source, Name.Nextˉoffset, Name.Nextˉline,
                    Name.Nextˉcolumn,
                    Call.Itemsˉoffset + Call.Itemsˉlength
                );
            Matches = Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(
                Source, Name.Offset, Name.Length, Label
            );
            Cursor = Colon.Nextˉoffset;
            Position = Sourceˉbodies.Compilerˉsourceˉposition(
                Colon.Nextˉoffset, Colon.Nextˉline, Colon.Nextˉcolumn
            );
        }
        let Argument: Sourceˉbodies.Compilerˉsourceˉexpression =
            Sourceˉbodies.Compilerˉparseˉexpressionˉvalidated(
                Source, Cursor, Position.Line, Position.Column,
                Call.Itemsˉoffset + Call.Itemsˉlength, 0u32, 0u32
            );
        var Mode: u32 =
            Sourceˉdeclarations.COMPILER_SOURCE_BORROW_MODE_VALUE;
        var Valueˉoffset: u32 = Argument.Offset;
        var Valueˉlength: u32 = Argument.Length;
        var Valueˉline: u32 = Argument.Line;
        var Valueˉcolumn: u32 = Argument.Column;
        if Argument.Kind ==
                Sourceˉbodies.Compilerˉsourceˉexpressionˉkind.Unary &&
            Argument.Operator == Sourceˉlexer.Compilerˉtokenˉkind.Borrow {
            Mode = Sourceˉdeclarations.COMPILER_SOURCE_BORROW_MODE_IMMUTABLE;
            if Argument.Booleanˉvalue {
                Mode = Sourceˉdeclarations.COMPILER_SOURCE_BORROW_MODE_MUTABLE;
            }
            let Valueˉposition: Sourceˉbodies.Compilerˉsourceˉposition =
                Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
                    Source, Argument.Offset, Argument.Line, Argument.Column,
                    Argument.Firstˉoffset
                );
            Valueˉoffset = Argument.Firstˉoffset;
            Valueˉlength = Argument.Firstˉlength;
            Valueˉline = Valueˉposition.Line;
            Valueˉcolumn = Valueˉposition.Column;
        }
        if Matches {
            return Compilerˉsourceˉwirˉtaskˉargument(
                true, Mode,
                Argument.Offset, Argument.Length,
                Argument.Line, Argument.Column,
                Valueˉoffset, Valueˉlength, Valueˉline, Valueˉcolumn
            );
        }
        Cursor = Argument.Nextˉoffset;
        Position = Sourceˉbodies.Compilerˉsourceˉposition(
            Argument.Nextˉoffset, Argument.Nextˉline, Argument.Nextˉcolumn
        );
        if Item + 1u32 < Call.Items {
            let Separator: Sourceˉlexer.Compilerˉsourceˉtoken =
                Sourceˉbodies.Compilerˉbodyˉtoken(
                    Source, Cursor, Position.Line, Position.Column,
                    Call.Itemsˉoffset + Call.Itemsˉlength
                );
            Cursor = Separator.Nextˉoffset;
            Position = Sourceˉbodies.Compilerˉsourceˉposition(
                Separator.Nextˉoffset,
                Separator.Nextˉline, Separator.Nextˉcolumn
            );
        }
        Item = Item + 1u32;
    }
    return Compilerˉsourceˉwirˉtaskˉargumentˉmissing();
}

fn Compilerˉsourceˉwirˉcollectionˉfailureˉcaseˉname(Index: u32) -> bytes {
    if Index == 0u32 { return Textˉtoˉutf8("Invalidˉlimit"); }
    if Index == 1u32 { return Textˉtoˉutf8("Allocation"); }
    if Index == 2u32 { return Textˉtoˉutf8("Capacityˉexhausted"); }
    if Index == 3u32 { return Textˉtoˉutf8("Duplicate"); }
    if Index == 4u32 { return Textˉtoˉutf8("Comparisonˉlimit"); }
    if Index == 5u32 { return Textˉtoˉutf8("Wrongˉarena"); }
    if Index == 6u32 { return Textˉtoˉutf8("Slotˉoutˉofˉrange"); }
    if Index == 7u32 { return Textˉtoˉutf8("Vacant"); }
    if Index == 8u32 { return Textˉtoˉutf8("Staleˉgeneration"); }
    return Textˉtoˉutf8("Retired");
}

fn Compilerˉsourceˉwirˉcollectionˉfailureˉcaseˉfields(Index: u32) -> u32 {
    if Index == 0u32 { return 4u32; }
    if Index == 3u32 || Index == 5u32 { return 0u32; }
    if Index == 6u32 || Index == 8u32 { return 2u32; }
    return 1u32;
}

fn Compilerˉsourceˉwirˉisˉfoundationˉcollectionˉfailure(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Typeˉcatalog: Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog,
    Shape: u32,
    Module: u32
) -> bool {
    if Shape < 196608u32 || Shape >= 262144u32 || Module >= Scan.Modules {
        return false;
    }
    let Nominal: Sourceˉsymbols.Compilerˉsourceˉsymbolˉmatch =
        Compilerˉsourceˉwirˉnominalˉbyˉshape(Input, Scan, Symbols, Shape);
    if !Nominal.Found || Nominal.Module != Module || Nominal.Kind !=
            Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Variant {
        return false;
    }
    let View: Sourceˉset.Compilerˉsourceˉsetˉview =
        Sourceˉset.Compilerˉsourceˉsetˉmodule(Input, Scan, Module);
    if View.Edition != 1u32 { return false; }
    let Header: Sourceˉdeclarations.Compilerˉsourceˉheader =
        Sourceˉdeclarations.Compilerˉparseˉheaderˉvalidated(View.Source);
    if !Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(
            View.Source, Header.Nameˉoffset, Header.Nameˉlength,
            "Foundationˉcollections"
        ) ||
        !Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(
            View.Source, Nominal.Nameˉoffset, Nominal.Nameˉlength,
            "Collectionˉfailure"
        ) {
        return false;
    }
    let Declaration: Sourceˉdeclarations.Compilerˉsourceˉdeclaration =
        Sourceˉdeclarations.Compilerˉparseˉnextˉdeclarationˉvalidated(
            View.Source, Nominal.Declarationˉoffset, 1u32, 1u32, true
        );
    if Declaration.Kind !=
            Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Variant ||
        Declaration.Items != 10u32 {
        return false;
    }

    var Caseˉindex: u32 = 0u32;
    while Caseˉindex < 10u32 {
        let Expectedˉname: bytes =
            Compilerˉsourceˉwirˉcollectionˉfailureˉcaseˉname(Caseˉindex);
        let Namedˉcase: Compilerˉsourceˉwirˉmember =
            Compilerˉsourceˉwirˉnominalˉmember(
                Input, Scan, Symbols, Nominal,
                Expectedˉname, 0u32, Bytesˉlength(Expectedˉname)
            );
        let Caseˉview: Compilerˉsourceˉwirˉvariantˉcaseˉview =
            Compilerˉsourceˉwirˉvariantˉcaseˉviewˉbyˉindex(
                Input, Scan, Symbols, Typeˉcatalog,
                Shape - 196608u32, Caseˉindex
            );
        let Expectedˉfields: u32 =
            Compilerˉsourceˉwirˉcollectionˉfailureˉcaseˉfields(Caseˉindex);
        if !Namedˉcase.Found || Namedˉcase.Index != Caseˉindex ||
            !Caseˉview.Found || Caseˉview.Fields != Expectedˉfields {
            return false;
        }
        var Caseˉfieldˉindex: u32 = 0u32;
        while Caseˉfieldˉindex < Expectedˉfields {
            let Caseˉfield: Compilerˉsourceˉwirˉmember =
                Compilerˉsourceˉwirˉvariantˉfieldˉbyˉindex(
                    Input, Scan, Symbols, Typeˉcatalog,
                    Shape - 196608u32, Caseˉindex, Caseˉfieldˉindex
                );
            if !Caseˉfield.Found { return false; }
            if Caseˉindex == 1u32 {
                let Allocationˉnominal:
                    Sourceˉsymbols.Compilerˉsourceˉsymbolˉmatch =
                    Compilerˉsourceˉwirˉnominalˉbyˉshape(
                        Input, Scan, Symbols, Caseˉfield.Shape
                    );
                if !Allocationˉnominal.Found ||
                    !Compilerˉsourceˉwirˉisˉfoundationˉallocationˉfailure(
                        Input, Scan, Symbols,
                        Caseˉfield.Shape, Allocationˉnominal.Module
                    ) {
                    return false;
                }
            } else {
                var Expectedˉshape: u32 = 8u32;
                if Caseˉindex == 0u32 && Caseˉfieldˉindex == 0u32 {
                    Expectedˉshape = 3u32;
                }
                if Caseˉfield.Shape != Expectedˉshape { return false; }
            }
            Caseˉfieldˉindex = Caseˉfieldˉindex + 1u32;
        }
        Caseˉindex = Caseˉindex + 1u32;
    }
    return true;
}

fn Compilerˉsourceˉwirˉvectorˉappendˉfailureˉelement(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Typeˉcatalog: Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog,
    Shape: u32
) -> u32 {
    if !Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉshapeˉisˉprivate(
            Shape
        ) {
        return Compilerˉsourceˉwirˉsentinel();
    }
    let Instance: u32 =
        Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉshapeˉinstance(Shape);
    let Layout: Genericˉlayouts.Compilerˉsourceˉgenericˉtypeˉlayout =
        Genericˉlayouts.Compilerˉsourceˉgenericˉtypeˉlayoutˉcreate(
            Input, Scan, Symbols, Typeˉcatalog, Instance
        );
    if Layout.Shape != Shape || Layout.Module >= Scan.Modules ||
        Layout.Items != 2u32 ||
        Layout.Fields != 2u32 || Layout.Kind !=
            Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Record ||
        !Genericˉlayouts.Compilerˉsourceˉgenericˉtypeˉlayoutˉisˉvalid(
            Input, Scan, Symbols, Layout
        ) {
        return Compilerˉsourceˉwirˉsentinel();
    }
    let Nominal: Sourceˉsymbols.Compilerˉsourceˉsymbolˉmatch =
        Sourceˉsymbols.Compilerˉsourceˉsymbolsˉdirectoryˉentry(
            Symbols.Directory, Scan.Modules, Layout.Declaration
        );
    let View: Sourceˉset.Compilerˉsourceˉsetˉview =
        Sourceˉset.Compilerˉsourceˉsetˉmodule(Input, Scan, Layout.Module);
    let Header: Sourceˉdeclarations.Compilerˉsourceˉheader =
        Sourceˉdeclarations.Compilerˉparseˉheaderˉvalidated(View.Source);
    if View.Edition != 1u32 || !Nominal.Found ||
        Nominal.Module != Layout.Module ||
        !Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(
            View.Source, Header.Nameˉoffset, Header.Nameˉlength,
            "Foundationˉcollections"
        ) ||
        !Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(
            View.Source, Nominal.Nameˉoffset, Nominal.Nameˉlength,
            "Vectorˉappendˉfailure"
        ) {
        return Compilerˉsourceˉwirˉsentinel();
    }
    let Error: Genericˉlayouts.Compilerˉsourceˉgenericˉtypeˉfield =
        Genericˉlayouts.Compilerˉsourceˉgenericˉtypeˉlayoutˉrecordˉfield(
            Input, Scan, Symbols, Layout, 0u32
        );
    let Value: Genericˉlayouts.Compilerˉsourceˉgenericˉtypeˉfield =
        Genericˉlayouts.Compilerˉsourceˉgenericˉtypeˉlayoutˉrecordˉfield(
            Input, Scan, Symbols, Layout, 1u32
        );
    if !Error.Found || !Value.Found ||
        !Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(
            View.Source, Error.Nameˉoffset, Error.Nameˉlength, "Error"
        ) ||
        !Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(
            View.Source, Value.Nameˉoffset, Value.Nameˉlength, "Value"
        ) ||
        !Compilerˉsourceˉwirˉisˉfoundationˉcollectionˉfailure(
            Input, Scan, Symbols, Typeˉcatalog, Error.Shape, Layout.Module
        ) {
        return Compilerˉsourceˉwirˉsentinel();
    }
    return Value.Shape;
}

fn Compilerˉsourceˉwirˉreleaseˉscopedˉforˉexit(
    Build: Compilerˉsourceˉwirˉbuild,
    Useˉoffset: u32,
    Exitˉoffset: u32
) -> Compilerˉsourceˉwirˉbuild {
    var Result: Compilerˉsourceˉwirˉbuild = Build;
    var Remaining: u32 = Build.Bindingˉentries;
    while Remaining > 0u32 {
        Remaining = Remaining - 1u32;
        let Entry: u32 = Remaining * 36u32;
        if Bytesˉreadˉu32ˉlittle(Build.Bindingˉpayload, Entry) ==
                Build.Currentˉmodule &&
            Bytesˉreadˉu32ˉlittle(Build.Bindingˉpayload, Entry + 4u32) ==
                Build.Currentˉfunction &&
            Bytesˉreadˉu32ˉlittle(Build.Bindingˉpayload, Entry + 8u32) >= 4u32 &&
            Bytesˉreadˉu32ˉlittle(Build.Bindingˉpayload, Entry + 8u32) <= 7u32 {
            let Scopeˉstart: u32 = Bytesˉreadˉu32ˉlittle(
                Build.Bindingˉpayload, Entry + 28u32
            );
            let Scopeˉend: u32 = Bytesˉreadˉu32ˉlittle(
                Build.Bindingˉpayload, Entry + 32u32
            );
            if Useˉoffset >= Scopeˉstart && Useˉoffset < Scopeˉend &&
                (Exitˉoffset == Compilerˉsourceˉwirˉsentinel() ||
                    Exitˉoffset < Scopeˉstart || Exitˉoffset >= Scopeˉend) {
                let Kind: u32 = Bytesˉreadˉu32ˉlittle(
                    Build.Bindingˉpayload, Entry + 8u32
                );
                var Operation: u32 = WIR_OPERATION_RELEASE_LOCAL;
                var Policy: u32 = 0u32;
                if Kind >= 5u32 {
                    Operation = WIR_OPERATION_TASK_SCOPE_EXIT;
                    Policy = Kind - 5u32;
                }
                Result = Compilerˉsourceˉwirˉvalueˉbuild(
                    Compilerˉsourceˉwirˉemit(
                        Result, Operation, 0u32,
                        Compilerˉsourceˉwirˉempty(Build.Bindingˉpayload),
                        Bytesˉreadˉu32ˉlittle(
                            Build.Bindingˉpayload, Entry + 12u32
                        ), Policy, Useˉoffset, 0u32
                    )
                );
            }
        }
    }
    return Result;
}

fn Compilerˉsourceˉwirˉreturnˉafterˉreleasing(
    Build: Compilerˉsourceˉwirˉbuild,
    Offset: u32,
    Value: u32
) -> Compilerˉsourceˉwirˉbuild {
    let Released: Compilerˉsourceˉwirˉbuild =
        Compilerˉsourceˉwirˉreleaseˉscopedˉforˉexit(
            Build, Offset, Compilerˉsourceˉwirˉsentinel()
        );
    return Compilerˉsourceˉwirˉcloseˉcurrentˉblock(
        Released, Compilerˉsourceˉwirˉterminator.Return, Value,
        Compilerˉsourceˉwirˉsentinel(),
        Compilerˉsourceˉwirˉsentinel()
    );
}

fn Compilerˉsourceˉwirˉpropagateˉtry(
    Operand: Compilerˉsourceˉwirˉvalue,
    Returnˉshape: u32,
    Errorˉshape: u32,
    Genericˉfields: bool,
    Offset: u32,
    Length: u32
) -> Compilerˉsourceˉwirˉbuild {
    let Isˉvalid: Compilerˉsourceˉwirˉvalue = Compilerˉsourceˉwirˉemit(
        Compilerˉsourceˉwirˉvalueˉbuild(Operand),
        WIR_OPERATION_VARIANT_IS_CASE, 4u32,
        Compilerˉsourceˉwirˉoneˉoperand(Operand.Temporary),
        Compilerˉsourceˉwirˉvariantˉtarget(Operand.Shape),
        0u32, Offset, Length
    );
    var Result: Compilerˉsourceˉwirˉbuild =
        Compilerˉsourceˉwirˉvalueˉbuild(Isˉvalid);
    let Successˉblock: u32 = Result.Nextˉblock;
    let Failureˉblock: u32 = Successˉblock + 1u32;
    Result = Compilerˉsourceˉwirˉreserveˉblocks(Result, 2u32);
    Result = Compilerˉsourceˉwirˉcloseˉcurrentˉblock(
        Result, Compilerˉsourceˉwirˉterminator.Branch,
        Isˉvalid.Temporary, Successˉblock, Failureˉblock
    );
    Result = Compilerˉsourceˉwirˉbeginˉreservedˉblock(Result, Failureˉblock);
    var Failureˉtemporary: u32 = Operand.Temporary;
    if Operand.Shape != Returnˉshape {
        var Failureˉoperation: u32 = WIR_OPERATION_VARIANT_PAYLOAD;
        var Failureˉtarget: u32 = Operand.Shape;
        var Failureˉauxiliary: u32 = 1u32;
        if Genericˉfields {
            Failureˉoperation = WIR_OPERATION_VARIANT_FIELD;
            Failureˉtarget = Compilerˉsourceˉwirˉvariantˉtarget(Operand.Shape);
            Failureˉauxiliary = 64u32;
        }
        let Failureˉpayload: Compilerˉsourceˉwirˉvalue =
            Compilerˉsourceˉwirˉemit(
                Result, Failureˉoperation, Errorˉshape,
                Compilerˉsourceˉwirˉoneˉoperand(Operand.Temporary),
                Failureˉtarget, Failureˉauxiliary, Offset, Length
            );
        let Failureˉbuild: Compilerˉsourceˉwirˉbuild =
            Compilerˉsourceˉwirˉvalueˉbuild(Failureˉpayload);
        let Propagatedˉfailure: Compilerˉsourceˉwirˉvalue =
            Compilerˉsourceˉwirˉemit(
                Failureˉbuild,
                WIR_OPERATION_VARIANT_CREATE, Returnˉshape,
                Compilerˉsourceˉwirˉoneˉoperand(Failureˉpayload.Temporary),
                Returnˉshape, 1u32, Offset, Length
            );
        Result = Compilerˉsourceˉwirˉvalueˉbuild(Propagatedˉfailure);
        Failureˉtemporary = Propagatedˉfailure.Temporary;
    }
    Result = Compilerˉsourceˉwirˉreturnˉafterˉreleasing(
        Result, Offset, Failureˉtemporary
    );
    return Compilerˉsourceˉwirˉbeginˉreservedˉblock(Result, Successˉblock);
}

fn Compilerˉsourceˉwirˉcompileˉvalueˉtry(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Source: bytes,
    Offset: u32,
    Line: u32,
    Column: u32,
    Length: u32,
    Operand: Compilerˉsourceˉwirˉvalue,
    Valueˉrequired: bool
) -> Compilerˉsourceˉwirˉvalue {
    let Build: Compilerˉsourceˉwirˉbuild =
        Compilerˉsourceˉwirˉvalueˉbuild(Operand);
    let Returnˉshape: u32 = Compilerˉsourceˉwirˉcurrentˉreturnˉshape(
        Input, Scan, Symbols, Source, Build
    );
    let Typeˉcatalog: Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog =
        Compilerˉsourceˉwirˉgenericˉtypeˉcatalog(Build.Genericˉevidence);
    if Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉshapeˉisˉprivate(
            Operand.Shape
        ) || Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉshapeˉisˉprivate(
            Returnˉshape
        ) {
        let Operandˉresult: Compilerˉsourceˉwirˉmember =
            Compilerˉsourceˉwirˉgenericˉfoundationˉresultˉlayout(
                Input, Scan, Symbols, Typeˉcatalog, Operand.Shape
            );
        let Returnˉresult: Compilerˉsourceˉwirˉmember =
            Compilerˉsourceˉwirˉgenericˉfoundationˉresultˉlayout(
                Input, Scan, Symbols, Typeˉcatalog, Returnˉshape
            );
        if !Operandˉresult.Found || !Returnˉresult.Found ||
            Operandˉresult.Shape != Returnˉresult.Shape {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Build, Compilerˉsourceˉwirˉstatus.Invalidˉtry,
                Build.Currentˉmodule, Offset, Line, Column
            );
        }
        let Privateˉpropagated: Compilerˉsourceˉwirˉbuild =
            Compilerˉsourceˉwirˉpropagateˉtry(
                Operand, Returnˉshape, Operandˉresult.Shape, true,
                Offset, Length
            );
        if !Valueˉrequired {
            return Compilerˉsourceˉwirˉvalueˉfrom(
                Privateˉpropagated, 0u32, Compilerˉsourceˉwirˉsentinel()
            );
        }
        return Compilerˉsourceˉwirˉemit(
            Privateˉpropagated, WIR_OPERATION_VARIANT_FIELD,
            Operandˉresult.Index,
            Compilerˉsourceˉwirˉoneˉoperand(Operand.Temporary),
            Operand.Shape, 0u32, Offset, Length
        );
    }
    if Operand.Shape < 196608u32 || Returnˉshape < 196608u32 {
        return Compilerˉsourceˉwirˉfailureˉvalue(
            Build, Compilerˉsourceˉwirˉstatus.Invalidˉtry,
            Build.Currentˉmodule,
            Offset, Line, Column
        );
    }
    let Tryˉnominal: Sourceˉsymbols.Compilerˉsourceˉsymbolˉmatch =
        Compilerˉsourceˉwirˉnominalˉbyˉshape(
            Input, Scan, Symbols, Operand.Shape
        );
    let Validˉcase: Compilerˉsourceˉwirˉmember =
        Compilerˉsourceˉwirˉnominalˉmember(
            Input, Scan, Symbols, Tryˉnominal,
            Textˉtoˉutf8("Valid"), 0u32, 5u32
        );
    let Failureˉcase: Compilerˉsourceˉwirˉmember =
        Compilerˉsourceˉwirˉnominalˉmember(
            Input, Scan, Symbols, Tryˉnominal,
            Textˉtoˉutf8("Failure"), 0u32, 7u32
        );
    let Extraˉcase: Compilerˉsourceˉwirˉmember =
        Compilerˉsourceˉwirˉvariantˉcaseˉbyˉindex(
            Input, Scan, Symbols, Operand.Shape - 196608u32, 2u32
        );
    let Validˉview: Compilerˉsourceˉwirˉvariantˉcaseˉview =
        Compilerˉsourceˉwirˉvariantˉcaseˉviewˉbyˉindex(
            Input, Scan, Symbols,
            Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalogˉempty(),
            Operand.Shape - 196608u32, 0u32
        );
    let Failureˉview: Compilerˉsourceˉwirˉvariantˉcaseˉview =
        Compilerˉsourceˉwirˉvariantˉcaseˉviewˉbyˉindex(
            Input, Scan, Symbols,
            Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalogˉempty(),
            Operand.Shape - 196608u32, 1u32
        );
    let Validˉfield: Compilerˉsourceˉwirˉmember =
        Compilerˉsourceˉwirˉvariantˉfieldˉbyˉname(
            Input, Scan, Symbols,
            Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalogˉempty(),
            Operand.Shape - 196608u32, 0u32,
            Textˉtoˉutf8("Value"), 0u32, 5u32
        );
    let Failureˉfield: Compilerˉsourceˉwirˉmember =
        Compilerˉsourceˉwirˉvariantˉfieldˉbyˉname(
            Input, Scan, Symbols,
            Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalogˉempty(),
            Operand.Shape - 196608u32, 1u32,
            Textˉtoˉutf8("Error"), 0u32, 5u32
        );
    var Accepted: bool = Operand.Shape == Returnˉshape &&
        Validˉcase.Found && Validˉcase.Index == 0u32 &&
        Failureˉcase.Found && Failureˉcase.Index == 1u32 &&
        !Extraˉcase.Found;
    if Valueˉrequired {
        Accepted = Accepted && Compilerˉsourceˉwirˉisˉfoundationˉresult(
                Input, Scan, Tryˉnominal
            ) && Validˉview.Found && Validˉview.Fields == 1u32 &&
            Failureˉview.Found && Failureˉview.Fields == 1u32 &&
            Validˉfield.Found && Validˉfield.Index == 0u32 &&
            Failureˉfield.Found && Failureˉfield.Index == 0u32;
    } else {
        Accepted = Accepted && Validˉcase.Shape == 0u32 &&
            Failureˉcase.Shape != 0u32;
    }
    if !Accepted {
        return Compilerˉsourceˉwirˉfailureˉvalue(
            Build, Compilerˉsourceˉwirˉstatus.Invalidˉtry,
            Tryˉnominal.Module,
            Offset, Line, Column
        );
    }
    let Propagated: Compilerˉsourceˉwirˉbuild =
        Compilerˉsourceˉwirˉpropagateˉtry(
            Operand, Returnˉshape, Failureˉfield.Shape, false,
            Offset, Length
        );
    if !Valueˉrequired {
        return Compilerˉsourceˉwirˉvalueˉfrom(
            Propagated, 0u32, Compilerˉsourceˉwirˉsentinel()
        );
    }
    return Compilerˉsourceˉwirˉemit(
        Propagated, WIR_OPERATION_VARIANT_PAYLOAD,
        Validˉfield.Shape,
        Compilerˉsourceˉwirˉoneˉoperand(Operand.Temporary),
        Compilerˉsourceˉwirˉvariantˉtarget(Operand.Shape), 0u32,
        Offset, Length
    );
}

fn Compilerˉsourceˉwirˉexpressionˉisˉliteral(
    Kind: Sourceˉbodies.Compilerˉsourceˉexpressionˉkind
) -> bool {
    return Kind == Sourceˉbodies.Compilerˉsourceˉexpressionˉkind.Integer ||
        Kind == Sourceˉbodies.Compilerˉsourceˉexpressionˉkind.String ||
        Kind == Sourceˉbodies.Compilerˉsourceˉexpressionˉkind.Boolean ||
        Kind == Sourceˉbodies.Compilerˉsourceˉexpressionˉkind.Unit ||
        Kind == Sourceˉbodies.Compilerˉsourceˉexpressionˉkind.Rune ||
        Kind == Sourceˉbodies.Compilerˉsourceˉexpressionˉkind.Floating;
}

fn Compilerˉsourceˉwirˉcompileˉvalueˉblock(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Bindings: Sourceˉbindings.Compilerˉsourceˉbindingˉphase,
    Source: bytes,
    Block: Sourceˉbodies.Compilerˉsourceˉvalueˉblock,
    Blockˉline: u32,
    Blockˉcolumn: u32,
    Returnˉshape: u32,
    Continueˉtarget: u32,
    Breakˉtarget: u32,
    Loopˉscopeˉoffset: u32,
    Build: Compilerˉsourceˉwirˉbuild
) -> Compilerˉsourceˉwirˉvalue {
    if Block.Status != Sourceˉbodies.Compilerˉbodyˉparseˉstatus.Valid {
        return Compilerˉsourceˉwirˉfailureˉvalue(
            Build,
            Compilerˉsourceˉwirˉstatus.Invalidˉvalueˉblock,
            Build.Currentˉmodule,
            Block.Failureˉoffset,
            Block.Failureˉline,
            Block.Failureˉcolumn
        );
    }
    var Result: Compilerˉsourceˉwirˉbuild =
        Compilerˉsourceˉwirˉfusedˉfrom(Build, Bindings);
    var Bindingˉphase: Sourceˉbindings.Compilerˉsourceˉbindingˉphase = Bindings;
    if Block.Statements > 0u32 {
        let Statementsˉposition: Sourceˉbodies.Compilerˉsourceˉposition =
            Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
                Source,
                Block.Blockˉoffset,
                Blockˉline,
                Blockˉcolumn,
                Block.Statementsˉoffset
            );
        Result = Compilerˉsourceˉwirˉcompileˉblock(
            Input, Scan, Symbols,
            Bindingˉphase,
            Source,
            Block.Statementsˉoffset,
            Statementsˉposition.Line,
            Statementsˉposition.Column,
            Block.Valueˉoffset,
            Block.Blockˉoffset + Block.Blockˉlength,
            Returnˉshape,
            Continueˉtarget,
            Breakˉtarget,
            Loopˉscopeˉoffset,
            Result
        );
        if Result.Status != Compilerˉsourceˉwirˉstatus.Valid {
            return Compilerˉsourceˉwirˉvalueˉfrom(
                Result, 0u32, Compilerˉsourceˉwirˉsentinel()
            );
        }
        Bindingˉphase = Compilerˉsourceˉwirˉbuildˉbindings(Input, Result);
    }
    if !Result.Hasˉcurrentˉblock {
        return Compilerˉsourceˉwirˉvalueˉfrom(
            Result, 10u32, Compilerˉsourceˉwirˉsentinel()
        );
    }
    let Bindingˉbuild: Sourceˉbindings.Compilerˉsourceˉbindingˉbuild =
        Sourceˉbindings.Compilerˉsourceˉbindingsˉphaseˉbuildˉvalue(
            Bindingˉphase
        );
    let Valueˉposition: Sourceˉbodies.Compilerˉsourceˉposition =
        Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
            Source,
            Block.Blockˉoffset,
            Blockˉline,
            Blockˉcolumn,
            Block.Valueˉoffset
        );
    let Valueˉexpression: Sourceˉbodies.Compilerˉsourceˉexpression =
        Sourceˉbodies.Compilerˉparseˉexpressionˉvalidated(
            Source,
            Block.Valueˉoffset,
            Valueˉposition.Line,
            Valueˉposition.Column,
            Block.Blockˉoffset + Block.Blockˉlength,
            0u32,
            0u32
        );
    if Valueˉexpression.Status !=
        Sourceˉbodies.Compilerˉbodyˉparseˉstatus.Valid {
        return Compilerˉsourceˉwirˉfailureˉvalue(
            Result,
            Compilerˉsourceˉwirˉstatus.Invalidˉvalueˉblock,
            Result.Currentˉmodule,
            Valueˉexpression.Failureˉoffset,
            Valueˉexpression.Failureˉline,
            Valueˉexpression.Failureˉcolumn
        );
    }
    if Compilerˉsourceˉwirˉexpressionˉisˉliteral(Valueˉexpression.Kind) {
        return Compilerˉsourceˉwirˉcompileˉliteralˉexpression(
            Input, Scan, Symbols, Source, Valueˉexpression, Result
        );
    }
    return Compilerˉsourceˉwirˉcompileˉexpression(
        Input, Scan, Symbols,
        Bindingˉbuild.Payload,
        Bindingˉbuild.Entries - Bindingˉbuild.Nextˉslot,
        Bindingˉbuild.Entries,
        Source,
        Block.Valueˉoffset,
        Valueˉposition.Line,
        Valueˉposition.Column,
        Block.Blockˉoffset + Block.Blockˉlength,
        Result
    );
}

fn Compilerˉsourceˉwirˉjoinˉbranchˉvalues(
    Failureˉbuild: Compilerˉsourceˉwirˉbuild,
    Failureˉoffset: u32,
    Failureˉline: u32,
    Failureˉcolumn: u32,
    Valueˉoffset: u32,
    Valueˉlength: u32,
    First: Compilerˉsourceˉwirˉvalue,
    Second: Compilerˉsourceˉwirˉvalue
) -> Compilerˉsourceˉwirˉvalue {
    let Firstˉhasˉcurrent: bool = First.Hasˉcurrentˉblock;
    let Firstˉcurrent: u32 = First.Currentˉblock;
    let Firstˉfirst: u32 = First.Currentˉblockˉfirstˉoperation;
    let Firstˉcount: u32 = First.Operations - Firstˉfirst;
    let Secondˉhasˉcurrent: bool = Second.Hasˉcurrentˉblock;
    let Secondˉcurrent: u32 = Second.Currentˉblock;
    let Secondˉfirst: u32 = Second.Currentˉblockˉfirstˉoperation;
    let Secondˉcount: u32 = Second.Operations - Secondˉfirst;
    var Result: Compilerˉsourceˉwirˉbuild =
        Compilerˉsourceˉwirˉwithoutˉcurrentˉblock(
            Compilerˉsourceˉwirˉvalueˉbuild(Second)
        );
    if !Firstˉhasˉcurrent && !Secondˉhasˉcurrent {
        return Compilerˉsourceˉwirˉvalueˉfrom(
            Result, 10u32, Compilerˉsourceˉwirˉsentinel()
        );
    }
    if Firstˉhasˉcurrent && Secondˉhasˉcurrent {
        if First.Shape != Second.Shape {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Result,
                Compilerˉsourceˉwirˉstatus.Typeˉmismatch,
                Failureˉbuild.Currentˉmodule,
                Failureˉoffset,
                Failureˉline,
                Failureˉcolumn
            );
        }
        let Bothˉjoin: u32 = Result.Nextˉblock;
        Result = Compilerˉsourceˉwirˉreserveˉblocks(Result, 1u32);
        Result = Compilerˉsourceˉwirˉappendˉblock(
            Result, Firstˉcurrent, Firstˉfirst, Firstˉcount,
            Compilerˉsourceˉwirˉterminator.Jump,
            Compilerˉsourceˉwirˉsentinel(), Bothˉjoin,
            Compilerˉsourceˉwirˉsentinel()
        );
        Result = Compilerˉsourceˉwirˉappendˉblock(
            Result, Secondˉcurrent, Secondˉfirst, Secondˉcount,
            Compilerˉsourceˉwirˉterminator.Jump,
            Compilerˉsourceˉwirˉsentinel(), Bothˉjoin,
            Compilerˉsourceˉwirˉsentinel()
        );
        return Compilerˉsourceˉwirˉemit(
            Compilerˉsourceˉwirˉbeginˉreservedˉblock(Result, Bothˉjoin),
            WIR_OPERATION_VALUE_PHI,
            First.Shape,
            Compilerˉsourceˉwirˉtwoˉoperands(
                First.Temporary, Second.Temporary
            ),
            Firstˉcurrent,
            Secondˉcurrent,
            Valueˉoffset,
            Valueˉlength
        );
    }
    let Liveˉjoin: u32 = Result.Nextˉblock;
    Result = Compilerˉsourceˉwirˉreserveˉblocks(Result, 1u32);
    if Firstˉhasˉcurrent {
        Result = Compilerˉsourceˉwirˉappendˉblock(
            Result, Firstˉcurrent, Firstˉfirst, Firstˉcount,
            Compilerˉsourceˉwirˉterminator.Jump,
            Compilerˉsourceˉwirˉsentinel(), Liveˉjoin,
            Compilerˉsourceˉwirˉsentinel()
        );
        return Compilerˉsourceˉwirˉvalueˉfrom(
            Compilerˉsourceˉwirˉbeginˉreservedˉblock(Result, Liveˉjoin),
            First.Shape,
            First.Temporary
        );
    }
    Result = Compilerˉsourceˉwirˉappendˉblock(
        Result, Secondˉcurrent, Secondˉfirst, Secondˉcount,
        Compilerˉsourceˉwirˉterminator.Jump,
        Compilerˉsourceˉwirˉsentinel(), Liveˉjoin,
        Compilerˉsourceˉwirˉsentinel()
    );
    return Compilerˉsourceˉwirˉvalueˉfrom(
        Compilerˉsourceˉwirˉbeginˉreservedˉblock(Result, Liveˉjoin),
        Second.Shape,
        Second.Temporary
    );
}

fn Compilerˉsourceˉwirˉcompileˉifˉelseˉbranch(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Source: bytes,
    Expression: Sourceˉbodies.Compilerˉsourceˉexpression,
    Failureˉbuild: Compilerˉsourceˉwirˉbuild,
    First: Compilerˉsourceˉwirˉvalue,
    Elseˉblock: u32
) -> Compilerˉsourceˉwirˉvalue {
    let Elseˉposition: Sourceˉbodies.Compilerˉsourceˉposition =
        Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
            Source, Expression.Offset, Expression.Line, Expression.Column,
            Expression.Secondˉoffset
        );
    let Elseˉtoken: Sourceˉlexer.Compilerˉsourceˉtoken =
        Sourceˉbodies.Compilerˉbodyˉtoken(
            Source,
            Expression.Secondˉoffset,
            Elseˉposition.Line,
            Elseˉposition.Column,
            Expression.Secondˉoffset + Expression.Secondˉlength
        );
    let Elseˉstart: Compilerˉsourceˉwirˉbuild =
        Compilerˉsourceˉwirˉbeginˉreservedˉblock(
            Compilerˉsourceˉwirˉwithoutˉcurrentˉblock(
                Compilerˉsourceˉwirˉvalueˉbuild(First)
            ),
            Elseˉblock
        );
    var Second: Compilerˉsourceˉwirˉvalue =
        Compilerˉsourceˉwirˉvalueˉfrom(
            Elseˉstart, 0u32, Compilerˉsourceˉwirˉsentinel()
        );
    if Elseˉtoken.Kind == Sourceˉlexer.Compilerˉtokenˉkind.If {
        Second = Compilerˉsourceˉwirˉcompileˉexpression(
            Input, Scan, Symbols,
            Elseˉstart.Bindingˉpayload,
            Elseˉstart.Bindingˉentries - Elseˉstart.Bindingˉnextˉslot,
            Elseˉstart.Bindingˉentries,
            Source,
            Expression.Secondˉoffset,
            Elseˉposition.Line,
            Elseˉposition.Column,
            Expression.Secondˉoffset + Expression.Secondˉlength,
            Elseˉstart
        );
    } else {
        let Elseˉblockˉview: Sourceˉbodies.Compilerˉsourceˉvalueˉblock =
            Sourceˉbodies.Compilerˉbodyˉparseˉvalueˉblock(
                Source,
                Expression.Secondˉoffset,
                Elseˉposition.Line,
                Elseˉposition.Column,
                Expression.Offset + Expression.Length,
                0u32
            );
        Second = Compilerˉsourceˉwirˉcompileˉvalueˉblock(
            Input, Scan, Symbols,
            Compilerˉsourceˉwirˉbuildˉbindings(Input, Elseˉstart),
            Source,
            Elseˉblockˉview,
            Elseˉposition.Line,
            Elseˉposition.Column,
            Compilerˉsourceˉwirˉcurrentˉreturnˉshape(
                Input, Scan, Symbols, Source, Elseˉstart
            ),
            Compilerˉsourceˉwirˉsentinel(),
            Compilerˉsourceˉwirˉsentinel(),
            Compilerˉsourceˉwirˉsentinel(),
            Elseˉstart
        );
    }
    if Second.Status != Compilerˉsourceˉwirˉstatus.Valid { return Second; }
    return Compilerˉsourceˉwirˉjoinˉbranchˉvalues(
        Failureˉbuild,
        Expression.Secondˉoffset,
        Elseˉposition.Line,
        Elseˉposition.Column,
        Expression.Offset,
        Expression.Length,
        First,
        Second
    );
}

fn Compilerˉsourceˉwirˉcompileˉifˉthenˉbranch(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Source: bytes,
    Expression: Sourceˉbodies.Compilerˉsourceˉexpression,
    Failureˉbuild: Compilerˉsourceˉwirˉbuild,
    Condition: Compilerˉsourceˉwirˉvalue
) -> Compilerˉsourceˉwirˉvalue {
    let Thenˉposition: Sourceˉbodies.Compilerˉsourceˉposition =
        Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
            Source, Expression.Offset, Expression.Line, Expression.Column,
            Expression.Firstˉoffset
        );
    let Thenˉblockˉview: Sourceˉbodies.Compilerˉsourceˉvalueˉblock =
        Sourceˉbodies.Compilerˉbodyˉparseˉvalueˉblock(
            Source,
            Expression.Firstˉoffset,
            Thenˉposition.Line,
            Thenˉposition.Column,
            Expression.Offset + Expression.Length,
            0u32
        );
    var Branch: Compilerˉsourceˉwirˉbuild =
        Compilerˉsourceˉwirˉvalueˉbuild(Condition);
    let Thenˉblock: u32 = Branch.Nextˉblock;
    let Elseˉblock: u32 = Thenˉblock + 1u32;
    Branch = Compilerˉsourceˉwirˉreserveˉblocks(Branch, 2u32);
    Branch = Compilerˉsourceˉwirˉcloseˉcurrentˉblock(
        Branch,
        Compilerˉsourceˉwirˉterminator.Branch,
        Condition.Temporary,
        Thenˉblock,
        Elseˉblock
    );
    let First: Compilerˉsourceˉwirˉvalue =
        Compilerˉsourceˉwirˉcompileˉvalueˉblock(
            Input, Scan, Symbols,
            Compilerˉsourceˉwirˉbuildˉbindings(Input, Branch),
            Source,
            Thenˉblockˉview,
            Thenˉposition.Line,
            Thenˉposition.Column,
            Compilerˉsourceˉwirˉcurrentˉreturnˉshape(
                Input, Scan, Symbols, Source, Branch
            ),
            Compilerˉsourceˉwirˉsentinel(),
            Compilerˉsourceˉwirˉsentinel(),
            Compilerˉsourceˉwirˉsentinel(),
            Compilerˉsourceˉwirˉbeginˉreservedˉblock(Branch, Thenˉblock)
        );
    if First.Status != Compilerˉsourceˉwirˉstatus.Valid { return First; }
    return Compilerˉsourceˉwirˉcompileˉifˉelseˉbranch(
        Input, Scan, Symbols, Source, Expression, Failureˉbuild,
        First, Elseˉblock
    );
}

fn Compilerˉsourceˉwirˉcompileˉifˉexpression(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Bindingˉpayload: bytes,
    Bindingˉfirst: u32,
    Bindingˉentries: u32,
    Source: bytes,
    Expression: Sourceˉbodies.Compilerˉsourceˉexpression,
    Build: Compilerˉsourceˉwirˉbuild
) -> Compilerˉsourceˉwirˉvalue {
    let Conditionˉposition: Sourceˉbodies.Compilerˉsourceˉposition =
        Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
            Source, Expression.Offset, Expression.Line, Expression.Column,
            Expression.Valueˉoffset
        );
    let Condition: Compilerˉsourceˉwirˉvalue =
        Compilerˉsourceˉwirˉcompileˉexpression(
            Input, Scan, Symbols,
            Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
            Source,
            Expression.Valueˉoffset,
            Conditionˉposition.Line,
            Conditionˉposition.Column,
            Expression.Valueˉoffset + Expression.Valueˉlength,
            Build
        );
    if Condition.Status != Compilerˉsourceˉwirˉstatus.Valid { return Condition; }
    var Requiredˉshape: u32 = 4u32;
    if Scan.Version != 2u32 { Requiredˉshape = 0u32; }
    if Condition.Shape == 10u32 {
        if Requiredˉshape == 4u32 { return Condition; }
    }
    if Condition.Shape != Requiredˉshape {
        return Compilerˉsourceˉwirˉfailureˉvalue(
            Compilerˉsourceˉwirˉvalueˉbuild(Condition),
            Compilerˉsourceˉwirˉstatus.Invalidˉcondition,
            Build.Currentˉmodule,
            Expression.Valueˉoffset,
            Conditionˉposition.Line,
            Conditionˉposition.Column
        );
    }
    return Compilerˉsourceˉwirˉcompileˉifˉthenˉbranch(
        Input, Scan, Symbols, Source, Expression, Build, Condition
    );
}

fn Compilerˉsourceˉwirˉcompileˉliteralˉexpression(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Source: bytes,
    Expression: Sourceˉbodies.Compilerˉsourceˉexpression,
    Build: Compilerˉsourceˉwirˉbuild
) -> Compilerˉsourceˉwirˉvalue {
    if Expression.Kind == Sourceˉbodies.Compilerˉsourceˉexpressionˉkind.Integer {
        var Integerˉshape: u32 = 1u32;
        var Integerˉoperation: u32 =
            WIR_OPERATION_I32_CONSTANT;
        if Expression.Numericˉkind == Sourceˉlexer.Compilerˉnumericˉkind.U8 {
            Integerˉshape = 2u32;
            Integerˉoperation = WIR_OPERATION_U8_CONSTANT;
        }
        if Expression.Numericˉkind == Sourceˉlexer.Compilerˉnumericˉkind.U32 {
            Integerˉshape = 3u32;
            Integerˉoperation = WIR_OPERATION_U32_CONSTANT;
        }
        if Expression.Numericˉkind == Sourceˉlexer.Compilerˉnumericˉkind.I64 {
            Integerˉshape = 7u32;
            Integerˉoperation = WIR_OPERATION_I64_CONSTANT;
        }
        if Expression.Numericˉkind == Sourceˉlexer.Compilerˉnumericˉkind.U64 {
            Integerˉshape = 8u32;
            Integerˉoperation = WIR_OPERATION_U64_CONSTANT;
        }
        if Expression.Numericˉkind == Sourceˉlexer.Compilerˉnumericˉkind.I8 {
            Integerˉshape = 11u32;
            Integerˉoperation = WIR_OPERATION_FIXED_INTEGER_CONSTANT;
        }
        if Expression.Numericˉkind == Sourceˉlexer.Compilerˉnumericˉkind.I16 {
            Integerˉshape = 12u32;
            Integerˉoperation = WIR_OPERATION_FIXED_INTEGER_CONSTANT;
        }
        if Expression.Numericˉkind == Sourceˉlexer.Compilerˉnumericˉkind.U16 {
            Integerˉshape = 13u32;
            Integerˉoperation = WIR_OPERATION_FIXED_INTEGER_CONSTANT;
        }
        var Positiveˉoverflow: bool = false;
        if Integerˉshape == 1u32 {
            Positiveˉoverflow = Expression.Numericˉhigh != 0u32 ||
                Expression.Numericˉvalue > 2147483647u32;
        }
        if Integerˉshape == 7u32 {
            Positiveˉoverflow = Expression.Numericˉhigh >= 2147483648u32;
        }
        if Integerˉshape == 11u32 {
            Positiveˉoverflow = Expression.Numericˉhigh != 0u32 ||
                Expression.Numericˉvalue > 127u32;
        }
        if Integerˉshape == 12u32 {
            Positiveˉoverflow = Expression.Numericˉhigh != 0u32 ||
                Expression.Numericˉvalue > 32767u32;
        }
        if Positiveˉoverflow {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Build, Compilerˉsourceˉwirˉstatus.Invalidˉconstant,
                Build.Currentˉmodule,
                Expression.Offset, Expression.Line, Expression.Column
            );
        }
        return Compilerˉsourceˉwirˉemit(
            Build, Integerˉoperation, Integerˉshape,
            Compilerˉsourceˉwirˉempty(Source),
            Expression.Numericˉvalue, Expression.Numericˉhigh,
            Expression.Offset, Expression.Length
        );
    }
    if Expression.Kind == Sourceˉbodies.Compilerˉsourceˉexpressionˉkind.Floating {
        var Floatingˉshape: u32 = 14u32;
        if Expression.Numericˉkind == Sourceˉlexer.Compilerˉnumericˉkind.F64 {
            Floatingˉshape = 15u32;
        }
        return Compilerˉsourceˉwirˉemit(
            Build, WIR_OPERATION_FLOATING_CONSTANT,
            Floatingˉshape, Compilerˉsourceˉwirˉempty(Source),
            Expression.Numericˉvalue, Expression.Numericˉhigh,
            Expression.Offset, Expression.Length
        );
    }
    if Expression.Kind == Sourceˉbodies.Compilerˉsourceˉexpressionˉkind.String {
        return Compilerˉsourceˉwirˉemit(
            Build, WIR_OPERATION_TEXT_CONSTANT, 5u32,
            Compilerˉsourceˉwirˉempty(Source),
            Expression.Valueˉoffset, Expression.Valueˉlength,
            Expression.Offset, Expression.Length
        );
    }
    if Expression.Kind == Sourceˉbodies.Compilerˉsourceˉexpressionˉkind.Boolean {
        var Boolean: u32 = 0u32;
        if Expression.Booleanˉvalue { Boolean = 1u32; }
        return Compilerˉsourceˉwirˉemit(
            Build, WIR_OPERATION_BOOL_CONSTANT, 4u32,
            Compilerˉsourceˉwirˉempty(Source), Boolean, 0u32,
            Expression.Offset, Expression.Length
        );
    }
    if Expression.Kind == Sourceˉbodies.Compilerˉsourceˉexpressionˉkind.Rune {
        return Compilerˉsourceˉwirˉemit(
            Build, WIR_OPERATION_RUNE_CONSTANT, 16u32,
            Compilerˉsourceˉwirˉempty(Source), Expression.Numericˉvalue, 0u32,
            Expression.Offset, Expression.Length
        );
    }
    let View: Sourceˉset.Compilerˉsourceˉsetˉview =
        Sourceˉset.Compilerˉsourceˉsetˉmodule(
            Input, Scan, Build.Currentˉmodule
        );
    if View.Edition != 1u32 {
        return Compilerˉsourceˉwirˉfailureˉvalue(
            Build, Compilerˉsourceˉwirˉstatus.Invalidˉunit,
            Build.Currentˉmodule,
            Expression.Offset, Expression.Line, Expression.Column
        );
    }
    return Compilerˉsourceˉwirˉemit(
        Build, WIR_OPERATION_UNIT_CONSTANT, 9u32,
        Compilerˉsourceˉwirˉempty(Source), 0u32, 0u32,
        Expression.Offset, Expression.Length
    );
}

fn Compilerˉsourceˉwirˉcompileˉunaryˉexpression(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Bindingˉpayload: bytes,
    Bindingˉfirst: u32,
    Bindingˉentries: u32,
    Source: bytes,
    Expression: Sourceˉbodies.Compilerˉsourceˉexpression,
    Build: Compilerˉsourceˉwirˉbuild
) -> Compilerˉsourceˉwirˉvalue {
    let Position: Sourceˉbodies.Compilerˉsourceˉposition =
        Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
            Source, Expression.Offset, Expression.Line, Expression.Column,
            Expression.Firstˉoffset
        );
    if Expression.Operator == Sourceˉlexer.Compilerˉtokenˉkind.Minus {
        let Literal: Sourceˉbodies.Compilerˉsourceˉexpression =
            Sourceˉbodies.Compilerˉparseˉexpressionˉvalidated(
                Source, Expression.Firstˉoffset, Position.Line, Position.Column,
                Expression.Firstˉoffset + Expression.Firstˉlength,
                0u32, 0u32
            );
        if Literal.Kind == Sourceˉbodies.Compilerˉsourceˉexpressionˉkind.Integer {
            let Kind: Sourceˉlexer.Compilerˉnumericˉkind = Literal.Numericˉkind;
            if !Sourceˉlexer.Compilerˉsourceˉintegerˉfits(
                    Kind, Literal.Numericˉvalue, Literal.Numericˉhigh, false
                ) && Sourceˉlexer.Compilerˉsourceˉintegerˉfits(
                    Kind, Literal.Numericˉvalue, Literal.Numericˉhigh, true
                ) {
                let Minimumˉshape: u32 =
                    Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnumericˉshape(Kind);
                var Minimumˉoperation: u32 = WIR_OPERATION_FIXED_INTEGER_CONSTANT;
                if Minimumˉshape == 1u32 { Minimumˉoperation = WIR_OPERATION_I32_CONSTANT; }
                if Minimumˉshape == 7u32 { Minimumˉoperation = WIR_OPERATION_I64_CONSTANT; }
                return Compilerˉsourceˉwirˉemit(
                    Build, Minimumˉoperation, Minimumˉshape,
                    Compilerˉsourceˉwirˉempty(Source),
                    Literal.Numericˉvalue, Literal.Numericˉhigh,
                    Expression.Offset, Expression.Length
                );
            }
        }
    }
    if Expression.Operator == Sourceˉlexer.Compilerˉtokenˉkind.Await {
        let Awaited: Sourceˉbodies.Compilerˉsourceˉexpression =
            Sourceˉbodies.Compilerˉparseˉexpressionˉvalidated(
                Source, Expression.Firstˉoffset,
                Position.Line, Position.Column,
                Expression.Firstˉoffset + Expression.Firstˉlength,
                0u32, 0u32
            );
        if Awaited.Kind !=
                Sourceˉbodies.Compilerˉsourceˉexpressionˉkind.Call &&
            Awaited.Kind !=
                Sourceˉbodies.Compilerˉsourceˉexpressionˉkind.Explicitˉgenericˉcall {
            return Compilerˉsourceˉwirˉtaskˉfailure(Build, Expression);
        }
        return Compilerˉsourceˉwirˉcompileˉcall(
            Input, Scan, Symbols,
            Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
            Source, Awaited, Compilerˉsourceˉwirˉsentinel(), true, Build
        );
    }
    let Operand: Compilerˉsourceˉwirˉvalue =
        Compilerˉsourceˉwirˉcompileˉexpression(
            Input, Scan, Symbols,
            Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
            Source, Expression.Firstˉoffset, Position.Line, Position.Column,
            Expression.Firstˉoffset + Expression.Firstˉlength, Build
        );
    if Operand.Status != Compilerˉsourceˉwirˉstatus.Valid ||
        Operand.Shape == 10u32 { return Operand; }
    if Expression.Operator == Sourceˉlexer.Compilerˉtokenˉkind.Borrow {
        return Compilerˉsourceˉwirˉfailureˉvalue(
            Compilerˉsourceˉwirˉvalueˉbuild(Operand),
            Compilerˉsourceˉwirˉstatus.Invalidˉborrow,
            Build.Currentˉmodule,
            Expression.Offset, Expression.Line, Expression.Column
        );
    }
    if Expression.Operator == Sourceˉlexer.Compilerˉtokenˉkind.Try {
        return Compilerˉsourceˉwirˉcompileˉvalueˉtry(
            Input, Scan, Symbols, Source,
            Expression.Offset, Expression.Line, Expression.Column,
            Expression.Length, Operand, true
        );
    }
    if Expression.Operator == Sourceˉlexer.Compilerˉtokenˉkind.Freeze {
        if !Compilerˉsourceˉwirˉshapeˉisˉbuilder(Operand.Shape) {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Compilerˉsourceˉwirˉvalueˉbuild(Operand),
                Compilerˉsourceˉwirˉstatus.Invalidˉbuilder,
                Build.Currentˉmodule,
                Expression.Offset, Expression.Line, Expression.Column
            );
        }
        return Compilerˉsourceˉwirˉemit(
            Compilerˉsourceˉwirˉvalueˉbuild(Operand),
            WIR_OPERATION_BUILDER_FREEZE,
            Operand.Shape - 268435456u32,
            Compilerˉsourceˉwirˉoneˉoperand(Operand.Temporary),
            0u32, 0u32, Expression.Offset, Expression.Length
        );
    }
    var Required: u32 = 4u32;
    var Operation: u32 =
        WIR_OPERATION_BOOL_NOT;
    if Expression.Operator == Sourceˉlexer.Compilerˉtokenˉkind.Minus {
        Required = Operand.Shape;
        if Operand.Shape == 1u32 {
            Operation = WIR_OPERATION_I32_NEGATE;
        } else if Operand.Shape == 7u32 {
            Operation = WIR_OPERATION_I64_NEGATE;
        } else if Operand.Shape == 11u32 || Operand.Shape == 12u32 {
            Operation = WIR_OPERATION_FIXED_INTEGER_NEGATE;
        } else if Operand.Shape == 14u32 || Operand.Shape == 15u32 {
            Operation = WIR_OPERATION_FLOATING_NEGATE;
        } else {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Compilerˉsourceˉwirˉvalueˉbuild(Operand),
                Compilerˉsourceˉwirˉstatus.Invalidˉoperator,
                Build.Currentˉmodule,
                Expression.Offset, Expression.Line, Expression.Column
            );
        }
    }
    if Expression.Operator == Sourceˉlexer.Compilerˉtokenˉkind.Tilde {
        Required = Operand.Shape;
        if Operand.Shape == 2u32 {
            Operation = WIR_OPERATION_U8_BITWISE_NOT;
        } else if Operand.Shape == 3u32 {
            Operation = WIR_OPERATION_U32_BITWISE_NOT;
        } else if Operand.Shape == 8u32 {
            Operation = WIR_OPERATION_U64_BITWISE_NOT;
        } else if Operand.Shape == 13u32 {
            Operation = WIR_OPERATION_FIXED_INTEGER_BITWISE_NOT;
        } else {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Compilerˉsourceˉwirˉvalueˉbuild(Operand),
                Compilerˉsourceˉwirˉstatus.Invalidˉoperator,
                Build.Currentˉmodule,
                Expression.Offset, Expression.Line, Expression.Column
            );
        }
    }
    if Operand.Shape != Required {
        return Compilerˉsourceˉwirˉfailureˉvalue(
            Compilerˉsourceˉwirˉvalueˉbuild(Operand),
            Compilerˉsourceˉwirˉstatus.Invalidˉoperator,
            Build.Currentˉmodule,
            Expression.Offset, Expression.Line, Expression.Column
        );
    }
    return Compilerˉsourceˉwirˉemit(
        Compilerˉsourceˉwirˉvalueˉbuild(Operand), Operation, Required,
        Compilerˉsourceˉwirˉoneˉoperand(Operand.Temporary),
        0u32, 0u32, Expression.Offset, Expression.Length
    );
}

fn Compilerˉsourceˉwirˉcompileˉcontextualˉexpression(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Bindingˉpayload: bytes,
    Bindingˉfirst: u32,
    Bindingˉentries: u32,
    Source: bytes,
    Offset: u32,
    Line: u32,
    Column: u32,
    Endˉoffset: u32,
    Expectedˉshape: u32,
    Build: Compilerˉsourceˉwirˉbuild
) -> Compilerˉsourceˉwirˉvalue {
    if Offset >= Endˉoffset {
        return Compilerˉsourceˉwirˉfailureˉvalue(
            Build, Compilerˉsourceˉwirˉstatus.Typeˉmismatch,
            Build.Currentˉmodule, Offset, Line, Column
        );
    }
    let Contextualˉexpression:
        Sourceˉbodies.Compilerˉsourceˉexpression =
        Sourceˉbodies.Compilerˉparseˉexpressionˉvalidated(
            Source, Offset, Line, Column, Endˉoffset, 0u32, 0u32
        );
    if Contextualˉexpression.Kind ==
            Sourceˉbodies.Compilerˉsourceˉexpressionˉkind.Unary &&
        Contextualˉexpression.Operator ==
            Sourceˉlexer.Compilerˉtokenˉkind.Await {
        let Awaitedˉposition: Sourceˉbodies.Compilerˉsourceˉposition =
            Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
                Source,
                Contextualˉexpression.Offset,
                Contextualˉexpression.Line,
                Contextualˉexpression.Column,
                Contextualˉexpression.Firstˉoffset
            );
        let Awaited: Sourceˉbodies.Compilerˉsourceˉexpression =
            Sourceˉbodies.Compilerˉparseˉexpressionˉvalidated(
                Source, Contextualˉexpression.Firstˉoffset,
                Awaitedˉposition.Line, Awaitedˉposition.Column,
                Contextualˉexpression.Firstˉoffset +
                    Contextualˉexpression.Firstˉlength,
                0u32, 0u32
            );
        if Awaited.Kind !=
                Sourceˉbodies.Compilerˉsourceˉexpressionˉkind.Call &&
            Awaited.Kind !=
                Sourceˉbodies.Compilerˉsourceˉexpressionˉkind.Explicitˉgenericˉcall {
            return Compilerˉsourceˉwirˉtaskˉfailure(
                Build, Contextualˉexpression
            );
        }
        return Compilerˉsourceˉwirˉcompileˉcall(
            Input, Scan, Symbols,
            Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
            Source, Awaited, Expectedˉshape, true, Build
        );
    }
    if Contextualˉexpression.Kind ==
            Sourceˉbodies.Compilerˉsourceˉexpressionˉkind.Call ||
        Contextualˉexpression.Kind ==
            Sourceˉbodies.Compilerˉsourceˉexpressionˉkind.Explicitˉgenericˉcall {
        return Compilerˉsourceˉwirˉcompileˉcall(
            Input, Scan, Symbols,
            Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
            Source, Contextualˉexpression, Expectedˉshape, false, Build
        );
    }
    if Contextualˉexpression.Kind !=
        Sourceˉbodies.Compilerˉsourceˉexpressionˉkind.Array {
        return Compilerˉsourceˉwirˉcompileˉexpression(
            Input, Scan, Symbols,
            Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
            Source, Offset, Line, Column, Endˉoffset, Build
        );
    }
    let Arrayˉcatalog:
        Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog =
        Compilerˉsourceˉwirˉgenericˉtypeˉcatalog(Build.Genericˉevidence);
    let Arrayˉcount: u32 = Compilerˉsourceˉwirˉfixedˉarrayˉcount(
        Expectedˉshape, Arrayˉcatalog
    );
    let Arrayˉelementˉshape: u32 =
        Compilerˉsourceˉwirˉfixedˉarrayˉelementˉshape(
            Expectedˉshape, Arrayˉcatalog
        );
    if Arrayˉcount == Compilerˉsourceˉwirˉsentinel() ||
        Arrayˉelementˉshape == 0u32 ||
        Arrayˉcount != Contextualˉexpression.Items {
        return Compilerˉsourceˉwirˉfailureˉvalue(
            Build, Compilerˉsourceˉwirˉstatus.Invalidˉarray,
            Build.Currentˉmodule,
            Contextualˉexpression.Offset,
            Contextualˉexpression.Line, Contextualˉexpression.Column
        );
    }
    var Arrayˉbuild: Compilerˉsourceˉwirˉbuild = Build;
    var Arrayˉoperands: bytes = Compilerˉsourceˉwirˉempty(Source);
    var Arrayˉcursor: u32 = Contextualˉexpression.Itemsˉoffset;
    var Arrayˉposition: Sourceˉbodies.Compilerˉsourceˉposition =
        Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
            Source,
            Contextualˉexpression.Offset,
            Contextualˉexpression.Line,
            Contextualˉexpression.Column,
            Contextualˉexpression.Itemsˉoffset
        );
    var Arrayˉitem: u32 = 0u32;
    while Arrayˉitem < Contextualˉexpression.Items {
        let Arrayˉitemˉexpression:
            Sourceˉbodies.Compilerˉsourceˉexpression =
            Sourceˉbodies.Compilerˉparseˉexpressionˉvalidated(
                Source, Arrayˉcursor,
                Arrayˉposition.Line, Arrayˉposition.Column,
                Contextualˉexpression.Itemsˉoffset +
                    Contextualˉexpression.Itemsˉlength,
                0u32, 0u32
            );
        let Arrayˉitemˉend: u32 =
            Arrayˉitemˉexpression.Offset + Arrayˉitemˉexpression.Length;
        let Arrayˉitemˉposition:
            Sourceˉbodies.Compilerˉsourceˉposition =
            Sourceˉbodies.Compilerˉsourceˉposition(
                Arrayˉitemˉexpression.Offset,
                Arrayˉitemˉexpression.Line,
                Arrayˉitemˉexpression.Column
            );
        let Arrayˉitemˉvalue: Compilerˉsourceˉwirˉvalue =
            Compilerˉsourceˉwirˉcompileˉcontextualˉexpression(
                Input, Scan, Symbols,
                Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
                Source,
                Arrayˉitemˉexpression.Offset,
                Arrayˉitemˉposition.Line,
                Arrayˉitemˉposition.Column,
                Arrayˉitemˉend,
                Arrayˉelementˉshape,
                Arrayˉbuild
            );
        if Arrayˉitemˉvalue.Status !=
            Compilerˉsourceˉwirˉstatus.Valid {
            return Arrayˉitemˉvalue;
        }
        if Arrayˉitemˉvalue.Shape != Arrayˉelementˉshape {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Compilerˉsourceˉwirˉvalueˉbuild(Arrayˉitemˉvalue),
                Compilerˉsourceˉwirˉstatus.Typeˉmismatch,
                Build.Currentˉmodule,
                Arrayˉitemˉexpression.Offset,
                Arrayˉitemˉexpression.Line,
                Arrayˉitemˉexpression.Column
            );
        }
        Arrayˉoperands = Bytesˉconcat(
            Arrayˉoperands,
            Bytesˉfromˉu32ˉlittle(Arrayˉitemˉvalue.Temporary)
        );
        Arrayˉbuild = Compilerˉsourceˉwirˉvalueˉbuild(Arrayˉitemˉvalue);
        Arrayˉcursor = Arrayˉitemˉexpression.Nextˉoffset;
        Arrayˉposition = Sourceˉbodies.Compilerˉsourceˉposition(
            Arrayˉitemˉexpression.Nextˉoffset,
            Arrayˉitemˉexpression.Nextˉline,
            Arrayˉitemˉexpression.Nextˉcolumn
        );
        if Arrayˉitem + 1u32 < Contextualˉexpression.Items {
            let Arrayˉseparator: Sourceˉlexer.Compilerˉsourceˉtoken =
                Sourceˉbodies.Compilerˉbodyˉtoken(
                    Source, Arrayˉcursor,
                    Arrayˉposition.Line, Arrayˉposition.Column,
                    Contextualˉexpression.Itemsˉoffset +
                        Contextualˉexpression.Itemsˉlength
                );
            Arrayˉcursor = Arrayˉseparator.Nextˉoffset;
            Arrayˉposition = Sourceˉbodies.Compilerˉsourceˉposition(
                Arrayˉseparator.Nextˉoffset,
                Arrayˉseparator.Nextˉline,
                Arrayˉseparator.Nextˉcolumn
            );
        }
        Arrayˉitem = Arrayˉitem + 1u32;
    }
    return Compilerˉsourceˉwirˉemit(
        Arrayˉbuild, WIR_OPERATION_ARRAY_CREATE,
        Expectedˉshape, Arrayˉoperands,
        Expectedˉshape, 0u32,
        Contextualˉexpression.Offset, Contextualˉexpression.Length
    );
}

export fn Compilerˉsourceˉwirˉcompileˉexpression(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Bindingˉpayload: bytes,
    Bindingˉfirst: u32,
    Bindingˉentries: u32,
    Source: bytes,
    Offset: u32,
    Line: u32,
    Column: u32,
    Endˉoffset: u32,
    Build: Compilerˉsourceˉwirˉbuild
) -> Compilerˉsourceˉwirˉvalue {
    let Expression: Sourceˉbodies.Compilerˉsourceˉexpression = Sourceˉbodies.Compilerˉparseˉexpressionˉvalidated(
        Source, Offset, Line, Column, Endˉoffset, 0u32, 0u32
    );
    if Expression.Kind ==
            Sourceˉbodies.Compilerˉsourceˉexpressionˉkind.Unsafe {
        if Build.Unsafeˉdepth >= 64u32 {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Build, Compilerˉsourceˉwirˉstatus.Invalidˉvalueˉblock,
                Build.Currentˉmodule,
                Expression.Offset, Expression.Line, Expression.Column
            );
        }
        let Unsafeˉposition: Sourceˉbodies.Compilerˉsourceˉposition =
            Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
                Source, Expression.Offset, Expression.Line, Expression.Column,
                Expression.Firstˉoffset
            );
        let Unsafeˉblock: Sourceˉbodies.Compilerˉsourceˉvalueˉblock =
            Sourceˉbodies.Compilerˉbodyˉparseˉvalueˉblock(
                Source,
                Expression.Firstˉoffset,
                Unsafeˉposition.Line,
                Unsafeˉposition.Column,
                Expression.Offset + Expression.Length,
                0u32
            );
        let Unsafeˉvalue: Compilerˉsourceˉwirˉvalue =
            Compilerˉsourceˉwirˉcompileˉvalueˉblock(
                Input, Scan, Symbols,
                Compilerˉsourceˉwirˉbuildˉbindings(Input, Build),
                Source,
                Unsafeˉblock,
                Unsafeˉposition.Line,
                Unsafeˉposition.Column,
                Compilerˉsourceˉwirˉcurrentˉreturnˉshape(
                    Input, Scan, Symbols, Source, Build
                ),
                Compilerˉsourceˉwirˉsentinel(),
                Compilerˉsourceˉwirˉsentinel(),
                Compilerˉsourceˉwirˉsentinel(),
                Compilerˉsourceˉwirˉwithˉunsafeˉdepth(
                    Build, Build.Unsafeˉdepth + 1u32
                )
            );
        return Compilerˉsourceˉwirˉvalueˉwithˉunsafeˉdepth(
            Unsafeˉvalue, Build.Unsafeˉdepth
        );
    }
    if Expression.Kind ==
            Sourceˉbodies.Compilerˉsourceˉexpressionˉkind.Closure {
        return Compilerˉsourceˉwirˉcompileˉclosureˉexpression(
            Input, Scan, Symbols,
            Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
            Source, Expression, Build
        );
    }
    if Expression.Kind == Sourceˉbodies.Compilerˉsourceˉexpressionˉkind.Array {
        return Compilerˉsourceˉwirˉfailureˉvalue(
            Build, Compilerˉsourceˉwirˉstatus.Invalidˉarray,
            Build.Currentˉmodule,
            Expression.Offset, Expression.Line, Expression.Column
        );
    }
    if Expression.Kind == Sourceˉbodies.Compilerˉsourceˉexpressionˉkind.If {
        return Compilerˉsourceˉwirˉcompileˉifˉexpression(
            Input, Scan, Symbols,
            Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
            Source, Expression, Build
        );
    }
    if Expression.Kind == Sourceˉbodies.Compilerˉsourceˉexpressionˉkind.Match {
        let Match: Compilerˉsourceˉwirˉmatchˉview =
            Compilerˉsourceˉwirˉmatchˉview(
                Expression.Offset,
                Expression.Length,
                Expression.Line,
                Expression.Column,
                Expression.Items,
                Expression.Valueˉoffset,
                Expression.Valueˉlength,
                Expression.Firstˉoffset,
                Expression.Firstˉlength
            );
        return Compilerˉsourceˉwirˉcompileˉmatch(
            Input, Scan, Symbols,
            Source, Match, true,
            Compilerˉsourceˉwirˉcurrentˉreturnˉshape(
                Input, Scan, Symbols, Source, Build
            ),
            Compilerˉsourceˉwirˉsentinel(),
            Compilerˉsourceˉwirˉsentinel(),
            Compilerˉsourceˉwirˉsentinel(),
            Build
        );
    }
    if Compilerˉsourceˉwirˉexpressionˉisˉliteral(Expression.Kind) {
        return Compilerˉsourceˉwirˉcompileˉliteralˉexpression(
            Input, Scan, Symbols, Source, Expression, Build
        );
    }
    if Expression.Kind == Sourceˉbodies.Compilerˉsourceˉexpressionˉkind.Builder {
        let Builderˉtype: Sourceˉsymbols.Compilerˉsourceˉtypeˉbinding = Sourceˉsymbols.Compilerˉsourceˉsymbolsˉbindˉtype(
            Input, Scan, Symbols.Directory, Symbols.Lookup, Symbols.Visibility,
            Build.Currentˉmodule, Source,
            Expression.Valueˉoffset, Expression.Line, Expression.Column,
            Symbols.Records, Symbols.Enums, false
        );
        let Builderˉshape: u32 = Sourceˉbindings.Compilerˉsourceˉbindingsˉshape(Builderˉtype);
        if !Compilerˉsourceˉwirˉshapeˉisˉbuilder(Builderˉshape) {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Build, Compilerˉsourceˉwirˉstatus.Invalidˉbuilder,
                Build.Currentˉmodule,
                Expression.Offset, Expression.Line, Expression.Column
            );
        }
        return Compilerˉsourceˉwirˉemit(
            Build, WIR_OPERATION_BUILDER_CREATE,
            Builderˉshape, Compilerˉsourceˉwirˉempty(Source),
            Compilerˉsourceˉwirˉcollectionˉdescriptor(Builderˉshape),
            Compilerˉsourceˉwirˉcollectionˉmaximum(Builderˉshape),
            Expression.Offset, Expression.Length
        );
    }
    if Expression.Kind == Sourceˉbodies.Compilerˉsourceˉexpressionˉkind.Name {
        return Compilerˉsourceˉwirˉcompileˉname(
            Input, Scan, Symbols, Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
            Source, Expression, Build
        );
    }
    if Expression.Kind == Sourceˉbodies.Compilerˉsourceˉexpressionˉkind.Field {
        return Compilerˉsourceˉwirˉcompileˉfield(
            Input, Scan, Symbols, Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
            Source, Expression, Build
        );
    }
    if Expression.Kind == Sourceˉbodies.Compilerˉsourceˉexpressionˉkind.Unary {
        return Compilerˉsourceˉwirˉcompileˉunaryˉexpression(
            Input, Scan, Symbols,
            Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
            Source, Expression, Build
        );
    }
    if Expression.Kind == Sourceˉbodies.Compilerˉsourceˉexpressionˉkind.Binary {
        let Firstˉposition: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
            Source, Expression.Offset, Expression.Line, Expression.Column,
            Expression.Firstˉoffset
        );
        let Left: Compilerˉsourceˉwirˉvalue = Compilerˉsourceˉwirˉcompileˉexpression(
            Input, Scan, Symbols, Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
            Source,
            Expression.Firstˉoffset, Firstˉposition.Line, Firstˉposition.Column,
            Expression.Firstˉoffset + Expression.Firstˉlength,
            Build
        );
        if Left.Status != Compilerˉsourceˉwirˉstatus.Valid { return Left; }
        if Left.Shape == 10u32 { return Left; }
        if Expression.Operator == Sourceˉlexer.Compilerˉtokenˉkind.Andˉand ||
            Expression.Operator == Sourceˉlexer.Compilerˉtokenˉkind.Orˉor {
            if Left.Shape != 4u32 {
                return Compilerˉsourceˉwirˉfailureˉvalue(
                    Compilerˉsourceˉwirˉvalueˉbuild(Left),
                    Compilerˉsourceˉwirˉstatus.Invalidˉoperator,
                    Build.Currentˉmodule,
                    Expression.Offset, Expression.Line, Expression.Column
                );
            }
            var Branchˉbuild: Compilerˉsourceˉwirˉbuild = Compilerˉsourceˉwirˉvalueˉbuild(Left);
            let Rightˉblock: u32 = Branchˉbuild.Nextˉblock;
            let Shortˉblock: u32 = Rightˉblock + 1u32;
            let Joinˉblock: u32 = Rightˉblock + 2u32;
            Branchˉbuild = Compilerˉsourceˉwirˉreserveˉblocks(Branchˉbuild, 3u32);
            var Trueˉtarget: u32 = Rightˉblock;
            var Falseˉtarget: u32 = Shortˉblock;
            var Shortˉvalue: u32 = 0u32;
            if Expression.Operator == Sourceˉlexer.Compilerˉtokenˉkind.Orˉor {
                Trueˉtarget = Shortˉblock;
                Falseˉtarget = Rightˉblock;
                Shortˉvalue = 1u32;
            }
            Branchˉbuild = Compilerˉsourceˉwirˉcloseˉcurrentˉblock(
                Branchˉbuild,
                Compilerˉsourceˉwirˉterminator.Branch,
                Left.Temporary,
                Trueˉtarget,
                Falseˉtarget
            );
            let Short: Compilerˉsourceˉwirˉvalue = Compilerˉsourceˉwirˉemit(
                Compilerˉsourceˉwirˉbeginˉreservedˉblock(Branchˉbuild, Shortˉblock),
                WIR_OPERATION_BOOL_CONSTANT,
                4u32,
                Compilerˉsourceˉwirˉempty(Source),
                Shortˉvalue,
                0u32,
                Expression.Offset,
                Expression.Length
            );
            let Afterˉshort: Compilerˉsourceˉwirˉbuild = Compilerˉsourceˉwirˉcloseˉcurrentˉblock(
                Compilerˉsourceˉwirˉvalueˉbuild(Short),
                Compilerˉsourceˉwirˉterminator.Jump,
                Compilerˉsourceˉwirˉsentinel(),
                Joinˉblock,
                Compilerˉsourceˉwirˉsentinel()
            );
            let Shortˉrightˉposition: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
                Source, Expression.Offset, Expression.Line, Expression.Column,
                Expression.Secondˉoffset
            );
            let Shortˉright: Compilerˉsourceˉwirˉvalue = Compilerˉsourceˉwirˉcompileˉexpression(
                Input, Scan, Symbols, Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
                Source,
                Expression.Secondˉoffset, Shortˉrightˉposition.Line, Shortˉrightˉposition.Column,
                Expression.Secondˉoffset + Expression.Secondˉlength,
                Compilerˉsourceˉwirˉbeginˉreservedˉblock(Afterˉshort, Rightˉblock)
            );
            if Shortˉright.Status != Compilerˉsourceˉwirˉstatus.Valid { return Shortˉright; }
            if Shortˉright.Shape == 10u32 {
                return Compilerˉsourceˉwirˉvalueˉfrom(
                    Compilerˉsourceˉwirˉbeginˉreservedˉblock(
                        Compilerˉsourceˉwirˉvalueˉbuild(Shortˉright), Joinˉblock
                    ),
                    4u32,
                    Short.Temporary
                );
            }
            if Shortˉright.Shape != 4u32 {
                return Compilerˉsourceˉwirˉfailureˉvalue(
                    Compilerˉsourceˉwirˉvalueˉbuild(Shortˉright),
                    Compilerˉsourceˉwirˉstatus.Invalidˉoperator,
                    Build.Currentˉmodule,
                    Expression.Offset, Expression.Line, Expression.Column
                );
            }
            let Rightˉpredecessor: u32 = Shortˉright.Currentˉblock;
            let Joined: Compilerˉsourceˉwirˉbuild = Compilerˉsourceˉwirˉcloseˉcurrentˉblock(
                Compilerˉsourceˉwirˉvalueˉbuild(Shortˉright),
                Compilerˉsourceˉwirˉterminator.Jump,
                Compilerˉsourceˉwirˉsentinel(),
                Joinˉblock,
                Compilerˉsourceˉwirˉsentinel()
            );
            return Compilerˉsourceˉwirˉemit(
                Compilerˉsourceˉwirˉbeginˉreservedˉblock(Joined, Joinˉblock),
                WIR_OPERATION_VALUE_PHI,
                4u32,
                Compilerˉsourceˉwirˉtwoˉoperands(Short.Temporary, Shortˉright.Temporary),
                Shortˉblock,
                Rightˉpredecessor,
                Expression.Offset,
                Expression.Length
            );
        }
        let Secondˉposition: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
            Source, Expression.Offset, Expression.Line, Expression.Column,
            Expression.Secondˉoffset
        );
        let Right: Compilerˉsourceˉwirˉvalue = Compilerˉsourceˉwirˉcompileˉexpression(
            Input, Scan, Symbols, Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
            Source,
            Expression.Secondˉoffset, Secondˉposition.Line, Secondˉposition.Column,
            Expression.Secondˉoffset + Expression.Secondˉlength,
            Compilerˉsourceˉwirˉvalueˉbuild(Left)
        );
        if Right.Status != Compilerˉsourceˉwirˉstatus.Valid { return Right; }
        if Right.Shape == 10u32 { return Right; }
        var Compatibleˉshapes: bool = Left.Shape == Right.Shape;
        if Expression.Operator == Sourceˉlexer.Compilerˉtokenˉkind.Shiftˉleft ||
            Expression.Operator == Sourceˉlexer.Compilerˉtokenˉkind.Shiftˉright {
            Compatibleˉshapes = Right.Shape == 3u32;
        }
        if !Compatibleˉshapes {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Compilerˉsourceˉwirˉvalueˉbuild(Right),
                Compilerˉsourceˉwirˉstatus.Invalidˉoperator,
                Build.Currentˉmodule,
                Expression.Offset, Expression.Line, Expression.Column
            );
        }
        var Resultˉshape: u32 = Left.Shape;
        var Allowed: bool = false;
        let Fixedˉinteger: bool = Left.Shape >= 11u32 && Left.Shape <= 13u32;
        let Floating: bool = Left.Shape == 14u32 || Left.Shape == 15u32;
        let Arithmeticˉshape: bool = Left.Shape == 1u32 ||
            Left.Shape == 3u32 || Left.Shape == 7u32 ||
            Left.Shape == 8u32 || Fixedˉinteger;
        let Bitwiseˉshape: bool = Left.Shape == 2u32 ||
            Left.Shape == 3u32 || Left.Shape == 8u32 || Left.Shape == 13u32;
        if Expression.Operator == Sourceˉlexer.Compilerˉtokenˉkind.Plus ||
            Expression.Operator == Sourceˉlexer.Compilerˉtokenˉkind.Minus ||
            Expression.Operator == Sourceˉlexer.Compilerˉtokenˉkind.Star {
            Allowed = Arithmeticˉshape || Floating;
        }
        if Expression.Operator == Sourceˉlexer.Compilerˉtokenˉkind.Slash {
            Allowed = Arithmeticˉshape || Floating;
        }
        if Expression.Operator == Sourceˉlexer.Compilerˉtokenˉkind.Percent {
            Allowed = Arithmeticˉshape;
        }
        if Expression.Operator == Sourceˉlexer.Compilerˉtokenˉkind.Ampersand ||
            Expression.Operator == Sourceˉlexer.Compilerˉtokenˉkind.Pipe ||
            Expression.Operator == Sourceˉlexer.Compilerˉtokenˉkind.Caret ||
            Expression.Operator == Sourceˉlexer.Compilerˉtokenˉkind.Shiftˉleft ||
            Expression.Operator == Sourceˉlexer.Compilerˉtokenˉkind.Shiftˉright {
            Allowed = Bitwiseˉshape;
        }
        if Expression.Operator == Sourceˉlexer.Compilerˉtokenˉkind.Less ||
            Expression.Operator == Sourceˉlexer.Compilerˉtokenˉkind.Lessˉequals ||
            Expression.Operator == Sourceˉlexer.Compilerˉtokenˉkind.Greater ||
            Expression.Operator == Sourceˉlexer.Compilerˉtokenˉkind.Greaterˉequals {
            Allowed = Arithmeticˉshape || Floating;
            Resultˉshape = 4u32;
        }
        if Expression.Operator == Sourceˉlexer.Compilerˉtokenˉkind.Equalsˉequals ||
            Expression.Operator == Sourceˉlexer.Compilerˉtokenˉkind.Bangˉequals {
            Allowed = Left.Shape >= 1u32;
            if Left.Shape > 8u32 {
                Allowed = Fixedˉinteger;
                if !Fixedˉinteger {
                    Allowed = Floating || Left.Shape == 16u32 ||
                        Left.Shape >= 131072u32 + Symbols.Records;
                    if Left.Shape >= 131072u32 + Symbols.Records + Symbols.Enums {
                        Allowed = false;
                    }
                }
            }
            Resultˉshape = 4u32;
        }
        if !Allowed {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Compilerˉsourceˉwirˉvalueˉbuild(Right),
                Compilerˉsourceˉwirˉstatus.Invalidˉoperator,
                Build.Currentˉmodule,
                Expression.Offset, Expression.Line, Expression.Column
            );
        }
        var Binaryˉtarget: u32 = 0u32;
        if Fixedˉinteger && Resultˉshape == 4u32 { Binaryˉtarget = Left.Shape; }
        if Floating && Resultˉshape == 4u32 { Binaryˉtarget = Left.Shape; }
        return Compilerˉsourceˉwirˉemit(
            Compilerˉsourceˉwirˉvalueˉbuild(Right),
            Compilerˉsourceˉwirˉbinaryˉoperation(Expression.Operator, Left.Shape),
            Resultˉshape,
            Compilerˉsourceˉwirˉtwoˉoperands(Left.Temporary, Right.Temporary),
            Binaryˉtarget, 0u32, Expression.Offset, Expression.Length
        );
    }
    if Expression.Kind == Sourceˉbodies.Compilerˉsourceˉexpressionˉkind.Index {
        let Indexˉposition: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
            Source, Expression.Offset, Expression.Line, Expression.Column,
            Expression.Firstˉoffset
        );
        let Index: Compilerˉsourceˉwirˉvalue = Compilerˉsourceˉwirˉcompileˉexpression(
            Input, Scan, Symbols, Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
            Source,
            Expression.Firstˉoffset, Indexˉposition.Line, Indexˉposition.Column,
            Expression.Firstˉoffset + Expression.Firstˉlength,
            Build
        );
        if Index.Status != Compilerˉsourceˉwirˉstatus.Valid { return Index; }
        if Index.Shape == 10u32 { return Index; }
        let Indexedˉlocal: Sourceˉbindings.Compilerˉsourceˉlocalˉmatch = Sourceˉbindings.Compilerˉsourceˉbindingsˉfindˉlocal(
            Source, Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
            Expression.Valueˉoffset, Expression.Valueˉlength, Expression.Offset
        );
        if Indexedˉlocal.Found {
            let Indexedˉcatalog:
                Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog =
                Compilerˉsourceˉwirˉgenericˉtypeˉcatalog(
                    Index.Genericˉevidence
                );
            let Indexedˉisˉsequence: bool =
                Compilerˉsourceˉwirˉshapeˉisˉsequence(Indexedˉlocal.Shape);
            let Indexedˉisˉarray: bool =
                Compilerˉsourceˉwirˉshapeˉisˉfixedˉarray(
                    Indexedˉlocal.Shape, Indexedˉcatalog
                );
            if (!Indexedˉisˉsequence && !Indexedˉisˉarray) ||
                (Indexedˉisˉsequence && Index.Shape != 3u32) ||
                (Indexedˉisˉarray && Index.Shape != 8u32) {
                return Compilerˉsourceˉwirˉfailureˉvalue(
                    Compilerˉsourceˉwirˉvalueˉbuild(Index),
                    Compilerˉsourceˉwirˉstatus.Invalidˉindex,
                    Build.Currentˉmodule,
                    Expression.Offset, Expression.Line, Expression.Column
                );
            }
            let Indexedˉvalue: Compilerˉsourceˉwirˉvalue =
                Compilerˉsourceˉwirˉemit(
                Compilerˉsourceˉwirˉvalueˉbuild(Index),
                WIR_OPERATION_LOAD_LOCAL,
                Indexedˉlocal.Shape, Compilerˉsourceˉwirˉempty(Source),
                Indexedˉlocal.Slot, 0u32,
                Expression.Valueˉoffset, Expression.Valueˉlength
            );
            var Indexedˉoperation: u32 = WIR_OPERATION_SEQUENCE_ELEMENT;
            var Indexedˉshape: u32 =
                Compilerˉsourceˉwirˉcollectionˉelementˉshape(
                    Indexedˉlocal.Shape
                );
            if Indexedˉisˉarray {
                Indexedˉoperation = WIR_OPERATION_ARRAY_ELEMENT;
                Indexedˉshape =
                    Compilerˉsourceˉwirˉfixedˉarrayˉelementˉshape(
                        Indexedˉlocal.Shape, Indexedˉcatalog
                    );
            }
            return Compilerˉsourceˉwirˉemit(
                Compilerˉsourceˉwirˉvalueˉbuild(Indexedˉvalue),
                Indexedˉoperation, Indexedˉshape,
                Compilerˉsourceˉwirˉtwoˉoperands(
                    Indexedˉvalue.Temporary, Index.Temporary
                ),
                Indexedˉlocal.Shape, 0u32,
                Expression.Offset, Expression.Length
            );
        }
        if Index.Shape != 1u32 {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Compilerˉsourceˉwirˉvalueˉbuild(Index),
                Compilerˉsourceˉwirˉstatus.Invalidˉindex,
                Build.Currentˉmodule,
                Expression.Firstˉoffset, Indexˉposition.Line, Indexˉposition.Column
            );
        }
        let Data: Sourceˉbindings.Compilerˉsourceˉbindingˉmatch = Sourceˉbindings.Compilerˉsourceˉbindingsˉfindˉdeclaration(
            Input, Scan, Symbols, Build.Currentˉmodule, Source,
            Expression.Valueˉoffset, Expression.Valueˉlength,
            Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Data
        );
        if !Data.Found || !Data.Accessible {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Compilerˉsourceˉwirˉvalueˉbuild(Index),
                Compilerˉsourceˉwirˉstatus.Invalidˉdataˉuse,
                Data.Module,
                Expression.Valueˉoffset, Expression.Line, Expression.Column
            );
        }
        if Compilerˉsourceˉwirˉdataˉkind(Input, Scan, Symbols, Data) != Compilerˉsourceˉwirˉdataˉkind.I32ˉarray {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Compilerˉsourceˉwirˉvalueˉbuild(Index),
                Compilerˉsourceˉwirˉstatus.Invalidˉdataˉuse,
                Data.Module,
                Expression.Valueˉoffset, Expression.Line, Expression.Column
            );
        }
        return Compilerˉsourceˉwirˉemit(
            Compilerˉsourceˉwirˉvalueˉbuild(Index),
            WIR_OPERATION_DATA_LOAD_I32,
            1u32,
            Compilerˉsourceˉwirˉoneˉoperand(Index.Temporary),
            Data.Directoryˉentry, 0u32,
            Expression.Offset, Expression.Length
        );
    }
    if Expression.Kind == Sourceˉbodies.Compilerˉsourceˉexpressionˉkind.Namedˉrecord ||
        Expression.Kind == Sourceˉbodies.Compilerˉsourceˉexpressionˉkind.Recordˉupdate ||
        Expression.Kind ==
            Sourceˉbodies.Compilerˉsourceˉexpressionˉkind.Genericˉnamedˉrecord {
        return Compilerˉsourceˉwirˉcompileˉnamedˉrecord(
            Input, Scan, Symbols, Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
            Source, Expression, Build
        );
    }
    return Compilerˉsourceˉwirˉcompileˉcall(
        Input, Scan, Symbols, Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
        Source, Expression, Compilerˉsourceˉwirˉsentinel(), false, Build
    );
}

fn Compilerˉsourceˉwirˉfunctionˉgenericˉformal(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Callable: Sourceˉbindings.Compilerˉsourceˉbindingˉmatch,
    Argument: u32
) -> Compilerˉsourceˉwirˉgenericˉformal {
    let Emptyˉformalˉsource: bytes = Compilerˉsourceˉwirˉempty(Input);
    let Emptyˉformalˉgeneric: Sourceˉsymbols.Compilerˉsourceˉfunctionˉgeneric =
        Sourceˉsymbols.Compilerˉsourceˉfunctionˉgeneric(
            0u32, 0u32, 1u32, 1u32, 0u32, 1u32, 1u32
        );
    if Callable.Kind != Sourceˉbindings.Compilerˉsourceˉcallableˉkind.Function &&
        Callable.Kind !=
            Sourceˉbindings.Compilerˉsourceˉcallableˉkind.Asynchronousˉfunction {
        return Compilerˉsourceˉwirˉgenericˉformal(
            false, Emptyˉformalˉsource, Emptyˉformalˉgeneric,
            0u32, 1u32, 1u32
        );
    }
    let Formalˉentry: u32 = 16u32 + Callable.Directoryˉentry * 24u32;
    let Formalˉdeclarationˉoffset: u32 = Bytesˉreadˉu32ˉlittle(
        Symbols.Directory, Formalˉentry + 8u32
    );
    let Formalˉview: Sourceˉset.Compilerˉsourceˉsetˉview =
        Sourceˉset.Compilerˉsourceˉsetˉmodule(Input, Scan, Callable.Module);
    let Formalˉsource: bytes = Formalˉview.Source;
    let Formalˉdeclarationˉposition: Sourceˉbodies.Compilerˉsourceˉposition =
        Sourceˉbodies.Compilerˉsourceˉposition(
            Formalˉdeclarationˉoffset, 1u32, 1u32
        );
    let Formalˉdeclaration: Sourceˉdeclarations.Compilerˉsourceˉdeclaration =
        Sourceˉdeclarations.Compilerˉparseˉnextˉdeclarationˉvalidated(
            Formalˉsource, Formalˉdeclarationˉoffset,
            Formalˉdeclarationˉposition.Line,
            Formalˉdeclarationˉposition.Column, true
        );
    let Formalˉgeneric: Sourceˉsymbols.Compilerˉsourceˉfunctionˉgeneric =
        Sourceˉsymbols.Compilerˉsourceˉsymbolsˉfunctionˉgeneric(
            Formalˉsource, Formalˉdeclaration,
            Formalˉdeclarationˉposition.Line,
            Formalˉdeclarationˉposition.Column
        );
    let Formalˉleft: Sourceˉlexer.Compilerˉsourceˉtoken =
        Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Formalˉsource, Formalˉgeneric.Signatureˉoffset,
            Formalˉgeneric.Signatureˉline, Formalˉgeneric.Signatureˉcolumn
        );
    var Formalˉcursor: u32 = Formalˉleft.Nextˉoffset;
    var Formalˉline: u32 = Formalˉleft.Nextˉline;
    var Formalˉcolumn: u32 = Formalˉleft.Nextˉcolumn;
    var Formalˉindex: u32 = 0u32;
    while Formalˉindex < Formalˉdeclaration.Items {
        let Formalˉparameter: Sourceˉlexer.Compilerˉsourceˉtoken =
            Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                Formalˉsource, Formalˉcursor, Formalˉline, Formalˉcolumn
            );
        let Formalˉcolon: Sourceˉlexer.Compilerˉsourceˉtoken =
            Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                Formalˉsource, Formalˉparameter.Nextˉoffset,
                Formalˉparameter.Nextˉline, Formalˉparameter.Nextˉcolumn
            );
        let Formalˉparameterˉtype: Sourceˉlexer.Compilerˉsourceˉtoken =
            Sourceˉdeclarations.Compilerˉsourceˉparameterˉtypeˉstart(
                Formalˉsource, Formalˉcolon.Nextˉoffset,
                Formalˉcolon.Nextˉline, Formalˉcolon.Nextˉcolumn
            );
        if Formalˉindex == Argument {
            return Compilerˉsourceˉwirˉgenericˉformal(
                true, Formalˉsource, Formalˉgeneric,
                Formalˉparameterˉtype.Offset,
                Formalˉparameterˉtype.Line,
                Formalˉparameterˉtype.Column
            );
        }
        let Formalˉtype: Sourceˉdeclarations.Compilerˉparseˉstep =
            Sourceˉdeclarations.Compilerˉparseˉparameterˉtype(
                Formalˉsource, Formalˉcolon.Nextˉoffset,
                Formalˉcolon.Nextˉline, Formalˉcolon.Nextˉcolumn, false
            );
        let Formalˉseparator: Sourceˉlexer.Compilerˉsourceˉtoken =
            Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                Formalˉsource, Formalˉtype.Nextˉoffset,
                Formalˉtype.Nextˉline, Formalˉtype.Nextˉcolumn
            );
        Formalˉcursor = Formalˉseparator.Nextˉoffset;
        Formalˉline = Formalˉseparator.Nextˉline;
        Formalˉcolumn = Formalˉseparator.Nextˉcolumn;
        Formalˉindex = Formalˉindex + 1u32;
    }
    if Argument == Compilerˉsourceˉwirˉsentinel() {
        if Formalˉdeclaration.Items == 0u32 {
            let Formalˉright: Sourceˉlexer.Compilerˉsourceˉtoken =
                Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                    Formalˉsource, Formalˉcursor,
                    Formalˉline, Formalˉcolumn
                );
            Formalˉcursor = Formalˉright.Nextˉoffset;
            Formalˉline = Formalˉright.Nextˉline;
            Formalˉcolumn = Formalˉright.Nextˉcolumn;
        }
        let Formalˉarrow: Sourceˉlexer.Compilerˉsourceˉtoken =
            Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                Formalˉsource, Formalˉcursor,
                Formalˉline, Formalˉcolumn
            );
        let Formalˉreturn: Sourceˉlexer.Compilerˉsourceˉtoken =
            Sourceˉdeclarations.Compilerˉsourceˉparameterˉtypeˉstart(
                Formalˉsource, Formalˉarrow.Nextˉoffset,
                Formalˉarrow.Nextˉline, Formalˉarrow.Nextˉcolumn
            );
        return Compilerˉsourceˉwirˉgenericˉformal(
            true, Formalˉsource, Formalˉgeneric,
            Formalˉreturn.Offset,
            Formalˉreturn.Line,
            Formalˉreturn.Column
        );
    }
    return Compilerˉsourceˉwirˉgenericˉformal(
        false, Emptyˉformalˉsource, Emptyˉformalˉgeneric,
        0u32, 1u32, 1u32
    );
}

fn Compilerˉsourceˉwirˉgenericˉcontributionˉvalue(
    Valid: bool,
    Matched: bool,
    Solution: Sourceˉgenerics.Compilerˉsourceˉgenericˉsolution
) -> Compilerˉsourceˉwirˉgenericˉcontribution {
    return Compilerˉsourceˉwirˉgenericˉcontribution(
        Valid, Matched, Solution
    );
}

fn Compilerˉsourceˉwirˉgenericˉcontributeˉnominalˉformal(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Callable: Sourceˉbindings.Compilerˉsourceˉbindingˉmatch,
    Pattern: Compilerˉsourceˉwirˉgenericˉformal,
    Actualˉshape: u32,
    Originˉargument: u32,
    Originˉoffset: u32,
    Typeˉcatalog: Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog,
    Solution: Sourceˉgenerics.Compilerˉsourceˉgenericˉsolution
) -> Compilerˉsourceˉwirˉgenericˉcontribution {
    let Patternˉtoken: Sourceˉlexer.Compilerˉsourceˉtoken =
        Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Pattern.Source, Pattern.Offset, Pattern.Line, Pattern.Column
        );
    if Patternˉtoken.Kind != Sourceˉlexer.Compilerˉtokenˉkind.Identifier ||
        !Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉshapeˉisˉprivate(
            Actualˉshape
        ) {
        return Compilerˉsourceˉwirˉgenericˉcontributionˉvalue(
            true, false, Solution
        );
    }
    let Qualified: Sourceˉdeclarations.Compilerˉparseˉstep =
        Sourceˉdeclarations.Compilerˉparseˉqualifiedˉname(
            Pattern.Source, Pattern.Offset, Pattern.Line, Pattern.Column, false
        );
    let Left: Sourceˉlexer.Compilerˉsourceˉtoken =
        Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Pattern.Source, Qualified.Nextˉoffset,
            Qualified.Nextˉline, Qualified.Nextˉcolumn
        );
    if Left.Kind != Sourceˉlexer.Compilerˉtokenˉkind.Less {
        return Compilerˉsourceˉwirˉgenericˉcontributionˉvalue(
            true, false, Solution
        );
    }
    let Match: Sourceˉsymbols.Compilerˉsourceˉsymbolˉmatch =
        Sourceˉsymbols.Compilerˉsourceˉsymbolsˉfindˉownedˉnominal(
            Input, Scan, Symbols.Directory, Symbols.Lookup,
            Callable.Module, Pattern.Source, Patternˉtoken.Offset,
            Qualified.Nextˉoffset - Patternˉtoken.Offset
        );
    let Actualˉinstance: u32 =
        Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉshapeˉinstance(
            Actualˉshape
        );
    if !Match.Found ||
        Actualˉinstance >=
            Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalogˉinstances(
                Typeˉcatalog
            ) ||
        Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalogˉinstanceˉdeclaration(
            Typeˉcatalog, Actualˉinstance
        ) != Match.Directoryˉindex {
        return Compilerˉsourceˉwirˉgenericˉcontributionˉvalue(
            false, true, Solution
        );
    }
    let Target: Sourceˉset.Compilerˉsourceˉsetˉview =
        Sourceˉset.Compilerˉsourceˉsetˉmodule(Input, Scan, Match.Module);
    let Declaration: Sourceˉdeclarations.Compilerˉsourceˉdeclaration =
        Sourceˉdeclarations.Compilerˉparseˉnextˉdeclarationˉvalidated(
            Target.Source, Match.Declarationˉoffset, 1u32, 1u32, true
        );
    let Generic: Sourceˉsymbols.Compilerˉsourceˉfunctionˉgeneric =
        Sourceˉsymbols.Compilerˉsourceˉsymbolsˉfunctionˉgeneric(
            Target.Source, Declaration, 1u32, 1u32
        );
    if Generic.Parameters == 0u32 ||
        Generic.Parameters !=
            Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalogˉinstanceˉparameters(
                Typeˉcatalog, Actualˉinstance
            ) {
        return Compilerˉsourceˉwirˉgenericˉcontributionˉvalue(
            false, true, Solution
        );
    }
    var Working: Sourceˉgenerics.Compilerˉsourceˉgenericˉsolution = Solution;
    var Cursor: u32 = Left.Nextˉoffset;
    var Currentˉline: u32 = Left.Nextˉline;
    var Currentˉcolumn: u32 = Left.Nextˉcolumn;
    var Parameter: u32 = 0u32;
    while Parameter < Generic.Parameters {
        let Argumentˉtoken: Sourceˉlexer.Compilerˉsourceˉtoken =
            Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                Pattern.Source, Cursor, Currentˉline, Currentˉcolumn
            );
        let Declared:
            Sourceˉsymbols.Compilerˉsourceˉgenericˉparameterˉmatch =
            Sourceˉsymbols.Compilerˉsourceˉsymbolsˉgenericˉparameterˉat(
                Target.Source, Generic, Parameter
            );
        let Actual: Sourceˉgenerics.Compilerˉsourceˉgenericˉargument =
            Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalogˉargument(
                Typeˉcatalog, Actualˉinstance, Parameter
            );
        let Formal:
            Sourceˉsymbols.Compilerˉsourceˉgenericˉparameterˉmatch =
            Sourceˉsymbols.Compilerˉsourceˉsymbolsˉgenericˉparameter(
                Pattern.Source, Pattern.Generic,
                Argumentˉtoken.Offset, Argumentˉtoken.Length
            );
        var Nextˉoffset: u32 = Argumentˉtoken.Nextˉoffset;
        var Nextˉline: u32 = Argumentˉtoken.Nextˉline;
        var Nextˉcolumn: u32 = Argumentˉtoken.Nextˉcolumn;
        if !Declared.Found || !Actual.Valid {
            return Compilerˉsourceˉwirˉgenericˉcontributionˉvalue(
                false, true, Working
            );
        }
        if Formal.Found {
            var Formalˉkind: u32 = 2u32;
            if Formal.Isˉtype { Formalˉkind = 1u32; }
            if Declared.Isˉtype != Formal.Isˉtype ||
                Actual.Kind != Formalˉkind ||
                (!Formal.Isˉtype &&
                    (Formal.Shape != Declared.Shape ||
                        Actual.Shape != Declared.Shape)) {
                return Compilerˉsourceˉwirˉgenericˉcontributionˉvalue(
                    false, true, Working
                );
            }
            Working =
                Sourceˉgenerics.Compilerˉsourceˉgenericˉsolutionˉcontribute(
                    Working, Formal.Index, Actual.Kind,
                    Actual.Low, Actual.High,
                    Originˉargument, Originˉoffset
                );
        } else if Declared.Isˉtype {
            let Concrete:
                Genericˉtypeˉbinding.Compilerˉsourceˉgenericˉtypeˉbinding =
                Genericˉtypeˉbinding.Compilerˉsourceˉgenericˉtypeˉbind(
                    Input, Scan, Symbols, Callable.Module, Pattern.Source,
                    Cursor, Currentˉline, Currentˉcolumn,
                    0u32, 0u32, 0u32, 0u32, Typeˉcatalog
                );
            if Concrete.Status !=
                    Sourceˉsymbols.Compilerˉsourceˉsymbolˉstatus.Valid ||
                Concrete.Genericˉstatus !=
                    Sourceˉgenerics.Compilerˉsourceˉgenericˉstatus.Valid ||
                Actual.Kind != 1u32 || Concrete.Shape != Actual.Low {
                return Compilerˉsourceˉwirˉgenericˉcontributionˉvalue(
                    false, true, Working
                );
            }
            Nextˉoffset = Concrete.Nextˉoffset;
            Nextˉline = Concrete.Nextˉline;
            Nextˉcolumn = Concrete.Nextˉcolumn;
        } else if Argumentˉtoken.Kind !=
                Sourceˉlexer.Compilerˉtokenˉkind.Integer ||
            Actual.Kind != 2u32 || Actual.Shape != Declared.Shape ||
            Actual.Low != Argumentˉtoken.Numericˉvalue ||
            Actual.High != Argumentˉtoken.Numericˉhigh {
            return Compilerˉsourceˉwirˉgenericˉcontributionˉvalue(
                false, true, Working
            );
        }
        if Working.Status !=
                Sourceˉgenerics.Compilerˉsourceˉgenericˉstatus.Valid {
            return Compilerˉsourceˉwirˉgenericˉcontributionˉvalue(
                false, true, Working
            );
        }
        let Separator: Sourceˉlexer.Compilerˉsourceˉtoken =
            Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                Pattern.Source, Nextˉoffset, Nextˉline, Nextˉcolumn
            );
        Cursor = Separator.Nextˉoffset;
        Currentˉline = Separator.Nextˉline;
        Currentˉcolumn = Separator.Nextˉcolumn;
        Parameter = Parameter + 1u32;
    }
    return Compilerˉsourceˉwirˉgenericˉcontributionˉvalue(
        true, true, Working
    );
}

fn Compilerˉsourceˉwirˉgenericˉcontributeˉformal(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Callable: Sourceˉbindings.Compilerˉsourceˉbindingˉmatch,
    Argument: u32,
    Actualˉshape: u32,
    Originˉargument: u32,
    Originˉoffset: u32,
    Typeˉcatalog: Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog,
    Solution: Sourceˉgenerics.Compilerˉsourceˉgenericˉsolution
) -> Compilerˉsourceˉwirˉgenericˉcontribution {
    let Patternˉformal: Compilerˉsourceˉwirˉgenericˉformal =
        Compilerˉsourceˉwirˉfunctionˉgenericˉformal(
            Input, Scan, Symbols, Callable, Argument
        );
    if !Patternˉformal.Found {
        return Compilerˉsourceˉwirˉgenericˉcontributionˉvalue(
            true, false, Solution
        );
    }
    let Patternˉtoken: Sourceˉlexer.Compilerˉsourceˉtoken =
        Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Patternˉformal.Source, Patternˉformal.Offset,
            Patternˉformal.Line, Patternˉformal.Column
        );
    if Patternˉtoken.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Identifier {
        let Patternˉdirect: Sourceˉsymbols.Compilerˉsourceˉgenericˉparameterˉmatch =
            Sourceˉsymbols.Compilerˉsourceˉsymbolsˉgenericˉparameter(
                Patternˉformal.Source, Patternˉformal.Generic,
                Patternˉtoken.Offset, Patternˉtoken.Length
            );
        if Patternˉdirect.Found {
            if !Patternˉdirect.Isˉtype {
                return Compilerˉsourceˉwirˉgenericˉcontributionˉvalue(
                    false, true, Solution
                );
            }
            let Patternˉdirectˉsolution:
                Sourceˉgenerics.Compilerˉsourceˉgenericˉsolution =
                Sourceˉgenerics.Compilerˉsourceˉgenericˉsolutionˉcontribute(
                    Solution, Patternˉdirect.Index, 1u32,
                    Actualˉshape, 0u32, Originˉargument, Originˉoffset
                );
            return Compilerˉsourceˉwirˉgenericˉcontributionˉvalue(
                Patternˉdirectˉsolution.Status ==
                    Sourceˉgenerics.Compilerˉsourceˉgenericˉstatus.Valid,
                true, Patternˉdirectˉsolution
            );
        }
    }
    let Nominal: Compilerˉsourceˉwirˉgenericˉcontribution =
        Compilerˉsourceˉwirˉgenericˉcontributeˉnominalˉformal(
            Input, Scan, Symbols, Callable, Patternˉformal,
            Actualˉshape, Originˉargument, Originˉoffset,
            Typeˉcatalog, Solution
        );
    if Nominal.Matched { return Nominal; }
    let Patternˉisˉsequence: bool = Patternˉtoken.Kind ==
        Sourceˉlexer.Compilerˉtokenˉkind.Sequence;
    let Patternˉisˉbuilder: bool = Patternˉtoken.Kind ==
        Sourceˉlexer.Compilerˉtokenˉkind.Builder;
    if !Patternˉisˉsequence && !Patternˉisˉbuilder {
        return Compilerˉsourceˉwirˉgenericˉcontributionˉvalue(
            true, false, Solution
        );
    }
    let Patternˉleft: Sourceˉlexer.Compilerˉsourceˉtoken =
        Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Patternˉformal.Source, Patternˉtoken.Nextˉoffset,
            Patternˉtoken.Nextˉline, Patternˉtoken.Nextˉcolumn
        );
    let Patternˉelement: Sourceˉlexer.Compilerˉsourceˉtoken =
        Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Patternˉformal.Source, Patternˉleft.Nextˉoffset,
            Patternˉleft.Nextˉline, Patternˉleft.Nextˉcolumn
        );
    let Patternˉelementˉtype: Sourceˉdeclarations.Compilerˉparseˉstep =
        Sourceˉdeclarations.Compilerˉparseˉtype(
            Patternˉformal.Source, Patternˉleft.Nextˉoffset,
            Patternˉleft.Nextˉline, Patternˉleft.Nextˉcolumn,
            false, false
        );
    let Patternˉcomma: Sourceˉlexer.Compilerˉsourceˉtoken =
        Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Patternˉformal.Source, Patternˉelementˉtype.Nextˉoffset,
            Patternˉelementˉtype.Nextˉline,
            Patternˉelementˉtype.Nextˉcolumn
        );
    let Patternˉmaximum: Sourceˉlexer.Compilerˉsourceˉtoken =
        Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Patternˉformal.Source, Patternˉcomma.Nextˉoffset,
            Patternˉcomma.Nextˉline, Patternˉcomma.Nextˉcolumn
        );
    let Patternˉelementˉparameter:
        Sourceˉsymbols.Compilerˉsourceˉgenericˉparameterˉmatch =
        Sourceˉsymbols.Compilerˉsourceˉsymbolsˉgenericˉparameter(
            Patternˉformal.Source, Patternˉformal.Generic,
            Patternˉelement.Offset, Patternˉelement.Length
        );
    let Patternˉmaximumˉparameter:
        Sourceˉsymbols.Compilerˉsourceˉgenericˉparameterˉmatch =
        Sourceˉsymbols.Compilerˉsourceˉsymbolsˉgenericˉparameter(
            Patternˉformal.Source, Patternˉformal.Generic,
            Patternˉmaximum.Offset, Patternˉmaximum.Length
        );
    let Patternˉmatched: bool = Patternˉelementˉparameter.Found ||
        Patternˉmaximumˉparameter.Found;
    if !Patternˉmatched {
        return Compilerˉsourceˉwirˉgenericˉcontributionˉvalue(
            true, false, Solution
        );
    }
    if (Patternˉisˉsequence &&
            !Compilerˉsourceˉwirˉshapeˉisˉsequence(Actualˉshape)) ||
        (Patternˉisˉbuilder &&
            !Compilerˉsourceˉwirˉshapeˉisˉbuilder(Actualˉshape)) {
        return Compilerˉsourceˉwirˉgenericˉcontributionˉvalue(
            false, true, Solution
        );
    }
    let Patternˉactualˉelement: u32 =
        Compilerˉsourceˉwirˉcollectionˉelementˉshape(Actualˉshape);
    let Patternˉactualˉmaximum: u32 =
        Compilerˉsourceˉwirˉcollectionˉmaximum(Actualˉshape);
    var Patternˉsolution: Sourceˉgenerics.Compilerˉsourceˉgenericˉsolution =
        Solution;
    if Patternˉelementˉparameter.Found {
        if !Patternˉelementˉparameter.Isˉtype {
            return Compilerˉsourceˉwirˉgenericˉcontributionˉvalue(
                false, true, Patternˉsolution
            );
        }
        Patternˉsolution =
            Sourceˉgenerics.Compilerˉsourceˉgenericˉsolutionˉcontribute(
                Patternˉsolution, Patternˉelementˉparameter.Index, 1u32,
                Patternˉactualˉelement, 0u32,
                Originˉargument, Originˉoffset
            );
    } else {
        let Patternˉconcreteˉelement:
            Sourceˉsymbols.Compilerˉsourceˉtypeˉbinding =
            Sourceˉsymbols.Compilerˉsourceˉsymbolsˉbindˉtype(
                Input, Scan, Symbols.Directory, Symbols.Lookup,
                Symbols.Visibility, Callable.Module, Patternˉformal.Source,
                Patternˉleft.Nextˉoffset,
                Patternˉleft.Nextˉline,
                Patternˉleft.Nextˉcolumn,
                Symbols.Records, Symbols.Enums, false
            );
        if Patternˉconcreteˉelement.Status !=
                Sourceˉsymbols.Compilerˉsourceˉsymbolˉstatus.Valid ||
            Sourceˉsymbols.Compilerˉsourceˉsymbolsˉtypeˉshape(
                Patternˉconcreteˉelement
            ) != Patternˉactualˉelement {
            return Compilerˉsourceˉwirˉgenericˉcontributionˉvalue(
                false, true, Patternˉsolution
            );
        }
    }
    if Patternˉsolution.Status !=
            Sourceˉgenerics.Compilerˉsourceˉgenericˉstatus.Valid {
        return Compilerˉsourceˉwirˉgenericˉcontributionˉvalue(
            false, true, Patternˉsolution
        );
    }
    if Patternˉmaximumˉparameter.Found {
        if Patternˉmaximumˉparameter.Isˉtype {
            return Compilerˉsourceˉwirˉgenericˉcontributionˉvalue(
                false, true, Patternˉsolution
            );
        }
        Patternˉsolution =
            Sourceˉgenerics.Compilerˉsourceˉgenericˉsolutionˉcontribute(
                Patternˉsolution, Patternˉmaximumˉparameter.Index, 2u32,
                Patternˉactualˉmaximum, 0u32,
                Originˉargument, Originˉoffset
            );
    } else if Patternˉmaximum.Kind !=
            Sourceˉlexer.Compilerˉtokenˉkind.Integer ||
        Patternˉmaximum.Numericˉvalue != Patternˉactualˉmaximum {
        return Compilerˉsourceˉwirˉgenericˉcontributionˉvalue(
            false, true, Patternˉsolution
        );
    }
    return Compilerˉsourceˉwirˉgenericˉcontributionˉvalue(
        Patternˉsolution.Status ==
            Sourceˉgenerics.Compilerˉsourceˉgenericˉstatus.Valid,
        true, Patternˉsolution
    );
}

fn Compilerˉsourceˉwirˉfunctionˉisˉgeneric(
    Source: bytes,
    Declarationˉoffset: u32
) -> bool {
    // Absolute token offsets are independent of the synthetic position used by
    // this prefilter; exact source positions are computed only for a generic.
    let First: Sourceˉlexer.Compilerˉsourceˉtoken =
        Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Source, Declarationˉoffset, 1u32, 1u32
        );
    var Functionˉtoken: Sourceˉlexer.Compilerˉsourceˉtoken = First;
    if First.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Export {
        Functionˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Source, First.Nextˉoffset, First.Nextˉline, First.Nextˉcolumn
        );
    }
    let Name: Sourceˉlexer.Compilerˉsourceˉtoken =
        Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Source, Functionˉtoken.Nextˉoffset,
            Functionˉtoken.Nextˉline, Functionˉtoken.Nextˉcolumn
        );
    let Afterˉname: Sourceˉlexer.Compilerˉsourceˉtoken =
        Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Source, Name.Nextˉoffset, Name.Nextˉline, Name.Nextˉcolumn
        );
    return Afterˉname.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Less;
}

fn Compilerˉsourceˉwirˉborrowˉmodeˉisˉaccepted(
    Formal: u32,
    Actual: u32,
    Class: u32
) -> bool {
    if Formal == Actual { return true; }
    if Formal == Sourceˉdeclarations.COMPILER_SOURCE_BORROW_MODE_VALUE &&
        Actual != Sourceˉdeclarations.COMPILER_SOURCE_BORROW_MODE_VALUE {
        return Class == WIR_VALUE_CLASS_COPY ||
            Class == WIR_VALUE_CLASS_SHARED;
    }
    return false;
}

fn Compilerˉsourceˉwirˉmutableˉborrowˉoriginˉisˉvalid(
    Bindingˉpayload: bytes,
    Bindingˉfirst: u32,
    Bindingˉentries: u32,
    Source: bytes,
    Expression: Sourceˉbodies.Compilerˉsourceˉexpression
) -> bool {
    var Nameˉoffset: u32 = Expression.Valueˉoffset;
    var Nameˉlength: u32 = Expression.Valueˉlength;
    if Expression.Kind == Sourceˉbodies.Compilerˉsourceˉexpressionˉkind.Field {
        Nameˉoffset = Expression.Firstˉoffset;
        Nameˉlength = Expression.Firstˉlength;
    } else if Expression.Kind !=
            Sourceˉbodies.Compilerˉsourceˉexpressionˉkind.Name {
        return false;
    }
    let Local: Sourceˉbindings.Compilerˉsourceˉlocalˉmatch =
        Sourceˉbindings.Compilerˉsourceˉbindingsˉfindˉlocal(
            Source, Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
            Nameˉoffset, Nameˉlength,
            Expression.Offset
        );
    if !Local.Found { return false; }
    if Local.Kind == Sourceˉbindings.Compilerˉsourceˉbindingˉkind.Var {
        return true;
    }
    if Local.Kind == Sourceˉbindings.Compilerˉsourceˉbindingˉkind.Parameter {
        return Compilerˉsourceˉwirˉparameterˉborrowˉmode(Source, Local) ==
            Sourceˉdeclarations.COMPILER_SOURCE_BORROW_MODE_MUTABLE;
    }
    return false;
}

fn Compilerˉsourceˉwirˉdirectˉborrowˉmode(
    Bindingˉpayload: bytes,
    Bindingˉfirst: u32,
    Bindingˉentries: u32,
    Source: bytes,
    Expression: Sourceˉbodies.Compilerˉsourceˉexpression
) -> u32 {
    var Nameˉoffset: u32 = Expression.Valueˉoffset;
    var Nameˉlength: u32 = Expression.Valueˉlength;
    if Expression.Kind == Sourceˉbodies.Compilerˉsourceˉexpressionˉkind.Field {
        Nameˉoffset = Expression.Firstˉoffset;
        Nameˉlength = Expression.Firstˉlength;
    } else if Expression.Kind !=
            Sourceˉbodies.Compilerˉsourceˉexpressionˉkind.Name {
        return Sourceˉdeclarations.COMPILER_SOURCE_BORROW_MODE_VALUE;
    }
    let Local: Sourceˉbindings.Compilerˉsourceˉlocalˉmatch =
        Sourceˉbindings.Compilerˉsourceˉbindingsˉfindˉlocal(
            Source, Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
            Nameˉoffset, Nameˉlength, Expression.Offset
        );
    return Compilerˉsourceˉwirˉparameterˉborrowˉmode(Source, Local);
}

fn Compilerˉsourceˉwirˉcompileˉfoundationˉvectorˉgrowˉcall(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Bindingˉpayload: bytes,
    Bindingˉfirst: u32,
    Bindingˉentries: u32,
    Source: bytes,
    Expression: Sourceˉbodies.Compilerˉsourceˉexpression,
    Callable: Sourceˉbindings.Compilerˉsourceˉbindingˉmatch,
    Operation: u32,
    Expectedˉshape: u32,
    Build: Compilerˉsourceˉwirˉbuild
) -> Compilerˉsourceˉwirˉvalue {
    if Operation == WIR_OPERATION_FOUNDATION_VECTOR_GROW_RESERVED {
        if Expression.Kind !=
                Sourceˉbodies.Compilerˉsourceˉexpressionˉkind.Explicitˉgenericˉcall ||
            Expression.Numericˉvalue != 1u32 {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Build, Compilerˉsourceˉwirˉstatus.Genericˉresolution,
                Callable.Module, Expression.Offset, Expression.Line,
                Expression.Column
            );
        }
        let Growˉtypeˉposition: Sourceˉbodies.Compilerˉsourceˉposition =
            Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
                Source, Expression.Offset, Expression.Line,
                Expression.Column, Expression.Firstˉoffset
            );
        let Growˉexplicitˉtype:
            Sourceˉsymbols.Compilerˉsourceˉtypeˉbinding =
            Sourceˉsymbols.Compilerˉsourceˉsymbolsˉbindˉtype(
                Input, Scan, Symbols.Directory, Symbols.Lookup,
                Symbols.Visibility, Build.Currentˉmodule, Source,
                Expression.Firstˉoffset,
                Growˉtypeˉposition.Line, Growˉtypeˉposition.Column,
                Symbols.Records, Symbols.Enums, false
            );
        if Growˉexplicitˉtype.Status !=
                Sourceˉsymbols.Compilerˉsourceˉsymbolˉstatus.Valid ||
            Growˉexplicitˉtype.Nextˉoffset !=
                Expression.Firstˉoffset + Expression.Firstˉlength {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Build, Compilerˉsourceˉwirˉstatus.Genericˉresolution,
                Callable.Module, Expression.Firstˉoffset,
                Growˉtypeˉposition.Line, Growˉtypeˉposition.Column
            );
        }
        let Growˉelement: u32 =
            Sourceˉsymbols.Compilerˉsourceˉsymbolsˉtypeˉshape(
                Growˉexplicitˉtype
            );
        let Growˉcatalog:
            Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog =
            Compilerˉsourceˉwirˉgenericˉtypeˉcatalog(
                Build.Genericˉevidence
            );
        let Growˉresultˉlayout: Compilerˉsourceˉwirˉmember =
            Compilerˉsourceˉwirˉgenericˉfoundationˉresultˉlayout(
                Input, Scan, Symbols, Growˉcatalog, Expectedˉshape
            );
        if !Growˉresultˉlayout.Found ||
            Growˉresultˉlayout.Index != 9u32 ||
            !Compilerˉsourceˉwirˉfoundationˉcollectionˉscalarˉisˉsupported(
                Growˉelement, Symbols
            ) {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Build, Compilerˉsourceˉwirˉstatus.Genericˉresolution,
                Callable.Module, Expression.Offset, Expression.Line,
                Expression.Column
            );
        }
        let Growˉfailure:
            Sourceˉsymbols.Compilerˉsourceˉsymbolˉmatch =
            Compilerˉsourceˉwirˉnominalˉbyˉshape(
                Input, Scan, Symbols, Growˉresultˉlayout.Shape
            );
        if !Growˉfailure.Found ||
            !Compilerˉsourceˉwirˉisˉfoundationˉallocationˉfailure(
                Input, Scan, Symbols,
                Growˉresultˉlayout.Shape, Growˉfailure.Module
            ) {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Build, Compilerˉsourceˉwirˉstatus.Genericˉresolution,
                Callable.Module, Expression.Offset, Expression.Line,
                Expression.Column
            );
        }

        let Growˉvectorˉposition:
            Sourceˉbodies.Compilerˉsourceˉposition =
            Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
                Source, Expression.Offset, Expression.Line,
                Expression.Column, Expression.Itemsˉoffset
            );
        let Growˉvectorˉargument:
            Sourceˉbodies.Compilerˉsourceˉexpression =
            Sourceˉbodies.Compilerˉparseˉexpressionˉvalidated(
                Source, Expression.Itemsˉoffset,
                Growˉvectorˉposition.Line,
                Growˉvectorˉposition.Column,
                Expression.Itemsˉoffset + Expression.Itemsˉlength,
                0u32, 0u32
            );
        if Growˉvectorˉargument.Kind !=
                Sourceˉbodies.Compilerˉsourceˉexpressionˉkind.Unary ||
            Growˉvectorˉargument.Operator !=
                Sourceˉlexer.Compilerˉtokenˉkind.Borrow ||
            !Growˉvectorˉargument.Booleanˉvalue {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Build, Compilerˉsourceˉwirˉstatus.Invalidˉborrow,
                Callable.Module, Growˉvectorˉargument.Offset,
                Growˉvectorˉargument.Line,
                Growˉvectorˉargument.Column
            );
        }
        let Growˉvectorˉborrowedˉposition:
            Sourceˉbodies.Compilerˉsourceˉposition =
            Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
                Source, Growˉvectorˉargument.Offset,
                Growˉvectorˉargument.Line,
                Growˉvectorˉargument.Column,
                Growˉvectorˉargument.Firstˉoffset
            );
        let Growˉvectorˉexpression:
            Sourceˉbodies.Compilerˉsourceˉexpression =
            Sourceˉbodies.Compilerˉparseˉexpressionˉvalidated(
                Source, Growˉvectorˉargument.Firstˉoffset,
                Growˉvectorˉborrowedˉposition.Line,
                Growˉvectorˉborrowedˉposition.Column,
                Growˉvectorˉargument.Firstˉoffset +
                    Growˉvectorˉargument.Firstˉlength,
                0u32, 0u32
            );
        if Growˉvectorˉexpression.Kind !=
                Sourceˉbodies.Compilerˉsourceˉexpressionˉkind.Name ||
            !Compilerˉsourceˉwirˉmutableˉborrowˉoriginˉisˉvalid(
                Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
                Source, Growˉvectorˉexpression
            ) {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Build, Compilerˉsourceˉwirˉstatus.Invalidˉborrow,
                Callable.Module, Growˉvectorˉexpression.Offset,
                Growˉvectorˉexpression.Line,
                Growˉvectorˉexpression.Column
            );
        }
        let Growˉvector: Sourceˉbindings.Compilerˉsourceˉlocalˉmatch =
            Sourceˉbindings.Compilerˉsourceˉbindingsˉfindˉlocal(
                Source, Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
                Growˉvectorˉexpression.Valueˉoffset,
                Growˉvectorˉexpression.Valueˉlength,
                Growˉvectorˉexpression.Offset
            );
        if !Growˉvector.Found || Growˉvector.Kind ==
                Sourceˉbindings.Compilerˉsourceˉbindingˉkind.Parameter ||
            !Compilerˉsourceˉwirˉshapeˉisˉfoundationˉvector(
                Growˉvector.Shape, Growˉcatalog
            ) ||
            Compilerˉsourceˉwirˉfoundationˉcollectionˉelementˉshape(
                Growˉvector.Shape, Growˉcatalog
            ) != Growˉelement {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Build, Compilerˉsourceˉwirˉstatus.Invalidˉcollection,
                Callable.Module, Growˉvectorˉexpression.Offset,
                Growˉvectorˉexpression.Line,
                Growˉvectorˉexpression.Column
            );
        }

        let Growˉfirstˉseparator: Sourceˉlexer.Compilerˉsourceˉtoken =
            Sourceˉbodies.Compilerˉbodyˉtoken(
                Source, Growˉvectorˉargument.Nextˉoffset,
                Growˉvectorˉargument.Nextˉline,
                Growˉvectorˉargument.Nextˉcolumn,
                Expression.Itemsˉoffset + Expression.Itemsˉlength
            );
        if Growˉfirstˉseparator.Kind !=
                Sourceˉlexer.Compilerˉtokenˉkind.Comma {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Build, Compilerˉsourceˉwirˉstatus.Invalidˉargument,
                Callable.Module, Growˉfirstˉseparator.Offset,
                Growˉfirstˉseparator.Line,
                Growˉfirstˉseparator.Column
            );
        }
        let Growˉbudgetˉargument:
            Sourceˉbodies.Compilerˉsourceˉexpression =
            Sourceˉbodies.Compilerˉparseˉexpressionˉvalidated(
                Source, Growˉfirstˉseparator.Nextˉoffset,
                Growˉfirstˉseparator.Nextˉline,
                Growˉfirstˉseparator.Nextˉcolumn,
                Expression.Itemsˉoffset + Expression.Itemsˉlength,
                0u32, 0u32
            );
        if Growˉbudgetˉargument.Kind !=
                Sourceˉbodies.Compilerˉsourceˉexpressionˉkind.Unary ||
            Growˉbudgetˉargument.Operator !=
                Sourceˉlexer.Compilerˉtokenˉkind.Borrow ||
            !Growˉbudgetˉargument.Booleanˉvalue {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Build, Compilerˉsourceˉwirˉstatus.Invalidˉborrow,
                Callable.Module, Growˉbudgetˉargument.Offset,
                Growˉbudgetˉargument.Line,
                Growˉbudgetˉargument.Column
            );
        }
        let Growˉbudgetˉborrowedˉposition:
            Sourceˉbodies.Compilerˉsourceˉposition =
            Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
                Source, Growˉbudgetˉargument.Offset,
                Growˉbudgetˉargument.Line,
                Growˉbudgetˉargument.Column,
                Growˉbudgetˉargument.Firstˉoffset
            );
        let Growˉbudgetˉexpression:
            Sourceˉbodies.Compilerˉsourceˉexpression =
            Sourceˉbodies.Compilerˉparseˉexpressionˉvalidated(
                Source, Growˉbudgetˉargument.Firstˉoffset,
                Growˉbudgetˉborrowedˉposition.Line,
                Growˉbudgetˉborrowedˉposition.Column,
                Growˉbudgetˉargument.Firstˉoffset +
                    Growˉbudgetˉargument.Firstˉlength,
                0u32, 0u32
            );
        if Growˉbudgetˉexpression.Kind !=
                Sourceˉbodies.Compilerˉsourceˉexpressionˉkind.Name ||
            !Compilerˉsourceˉwirˉmutableˉborrowˉoriginˉisˉvalid(
                Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
                Source, Growˉbudgetˉexpression
            ) {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Build, Compilerˉsourceˉwirˉstatus.Invalidˉborrow,
                Callable.Module, Growˉbudgetˉexpression.Offset,
                Growˉbudgetˉexpression.Line,
                Growˉbudgetˉexpression.Column
            );
        }
        let Growˉbudget: Sourceˉbindings.Compilerˉsourceˉlocalˉmatch =
            Sourceˉbindings.Compilerˉsourceˉbindingsˉfindˉlocal(
                Source, Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
                Growˉbudgetˉexpression.Valueˉoffset,
                Growˉbudgetˉexpression.Valueˉlength,
                Growˉbudgetˉexpression.Offset
            );
        if !Growˉbudget.Found || Growˉbudget.Shape != 805306368u32 {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Build, Compilerˉsourceˉwirˉstatus.Invalidˉargument,
                Callable.Module, Growˉbudgetˉexpression.Offset,
                Growˉbudgetˉexpression.Line,
                Growˉbudgetˉexpression.Column
            );
        }

        let Growˉsecondˉseparator: Sourceˉlexer.Compilerˉsourceˉtoken =
            Sourceˉbodies.Compilerˉbodyˉtoken(
                Source, Growˉbudgetˉargument.Nextˉoffset,
                Growˉbudgetˉargument.Nextˉline,
                Growˉbudgetˉargument.Nextˉcolumn,
                Expression.Itemsˉoffset + Expression.Itemsˉlength
            );
        if Growˉsecondˉseparator.Kind !=
                Sourceˉlexer.Compilerˉtokenˉkind.Comma {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Build, Compilerˉsourceˉwirˉstatus.Invalidˉargument,
                Callable.Module, Growˉsecondˉseparator.Offset,
                Growˉsecondˉseparator.Line,
                Growˉsecondˉseparator.Column
            );
        }
        let Growˉmaximumˉexpression:
            Sourceˉbodies.Compilerˉsourceˉexpression =
            Sourceˉbodies.Compilerˉparseˉexpressionˉvalidated(
                Source, Growˉsecondˉseparator.Nextˉoffset,
                Growˉsecondˉseparator.Nextˉline,
                Growˉsecondˉseparator.Nextˉcolumn,
                Expression.Itemsˉoffset + Expression.Itemsˉlength,
                0u32, 0u32
            );
        let Growˉmaximum: Compilerˉsourceˉwirˉvalue =
            Compilerˉsourceˉwirˉcompileˉcontextualˉexpression(
                Input, Scan, Symbols,
                Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
                Source, Growˉmaximumˉexpression.Offset,
                Growˉmaximumˉexpression.Line,
                Growˉmaximumˉexpression.Column,
                Growˉmaximumˉexpression.Offset +
                    Growˉmaximumˉexpression.Length,
                8u32, Build
            );
        if Growˉmaximum.Status != Compilerˉsourceˉwirˉstatus.Valid {
            return Growˉmaximum;
        }
        if Growˉmaximum.Shape != 8u32 {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Compilerˉsourceˉwirˉvalueˉbuild(Growˉmaximum),
                Compilerˉsourceˉwirˉstatus.Invalidˉargument,
                Callable.Module, Growˉmaximumˉexpression.Offset,
                Growˉmaximumˉexpression.Line,
                Growˉmaximumˉexpression.Column
            );
        }
        return Compilerˉsourceˉwirˉemit(
            Compilerˉsourceˉwirˉvalueˉbuild(Growˉmaximum),
            WIR_OPERATION_FOUNDATION_VECTOR_GROW_RESERVED,
            Expectedˉshape,
            Compilerˉsourceˉwirˉoneˉoperand(Growˉmaximum.Temporary),
            Growˉvector.Slot, Growˉbudget.Slot,
            Expression.Offset, Expression.Length
        );
    }
    return Compilerˉsourceˉwirˉfailureˉvalue(
        Build, Compilerˉsourceˉwirˉstatus.Invalidˉcollection,
        Callable.Module, Expression.Offset, Expression.Line,
        Expression.Column
    );
}

fn Compilerˉsourceˉwirˉcompileˉfoundationˉvectorˉcall(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Bindingˉpayload: bytes,
    Bindingˉfirst: u32,
    Bindingˉentries: u32,
    Source: bytes,
    Expression: Sourceˉbodies.Compilerˉsourceˉexpression,
    Callable: Sourceˉbindings.Compilerˉsourceˉbindingˉmatch,
    Operation: u32,
    Expectedˉshape: u32,
    Build: Compilerˉsourceˉwirˉbuild
) -> Compilerˉsourceˉwirˉvalue {
    if Operation == WIR_OPERATION_FOUNDATION_VECTOR_GROW_RESERVED {
        return Compilerˉsourceˉwirˉcompileˉfoundationˉvectorˉgrowˉcall(
            Input, Scan, Symbols,
            Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
            Source, Expression, Callable, Operation, Expectedˉshape, Build
        );
    }
    if Operation == WIR_OPERATION_FOUNDATION_VECTOR_CONSTRUCT_RESERVED {
        if Expression.Kind !=
                Sourceˉbodies.Compilerˉsourceˉexpressionˉkind.Explicitˉgenericˉcall ||
            Expression.Numericˉvalue != 1u32 {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Build, Compilerˉsourceˉwirˉstatus.Genericˉresolution,
                Callable.Module, Expression.Offset, Expression.Line, Expression.Column
            );
        }
        let Constructˉtypeˉposition: Sourceˉbodies.Compilerˉsourceˉposition =
            Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
                Source, Expression.Offset, Expression.Line, Expression.Column,
                Expression.Firstˉoffset
            );
        let Constructˉexplicitˉtype:
            Sourceˉsymbols.Compilerˉsourceˉtypeˉbinding =
            Sourceˉsymbols.Compilerˉsourceˉsymbolsˉbindˉtype(
                Input, Scan, Symbols.Directory, Symbols.Lookup,
                Symbols.Visibility, Build.Currentˉmodule, Source,
                Expression.Firstˉoffset,
                Constructˉtypeˉposition.Line, Constructˉtypeˉposition.Column,
                Symbols.Records, Symbols.Enums, false
            );
        if Constructˉexplicitˉtype.Status !=
                Sourceˉsymbols.Compilerˉsourceˉsymbolˉstatus.Valid ||
            Constructˉexplicitˉtype.Nextˉoffset !=
                Expression.Firstˉoffset + Expression.Firstˉlength {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Build, Compilerˉsourceˉwirˉstatus.Genericˉresolution,
                Callable.Module, Expression.Firstˉoffset,
                Constructˉtypeˉposition.Line, Constructˉtypeˉposition.Column
            );
        }
        let Constructˉelement: u32 =
            Sourceˉsymbols.Compilerˉsourceˉsymbolsˉtypeˉshape(
                Constructˉexplicitˉtype
            );
        let Constructˉtypeˉcatalog:
            Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog =
            Compilerˉsourceˉwirˉgenericˉtypeˉcatalog(Build.Genericˉevidence);
        let Constructˉresultˉlayout: Compilerˉsourceˉwirˉmember =
            Compilerˉsourceˉwirˉgenericˉfoundationˉresultˉlayout(
                Input, Scan, Symbols, Constructˉtypeˉcatalog, Expectedˉshape
            );
        if !Constructˉresultˉlayout.Found ||
            !Compilerˉsourceˉwirˉshapeˉisˉfoundationˉvector(
                Constructˉresultˉlayout.Index, Constructˉtypeˉcatalog
            ) || Compilerˉsourceˉwirˉfoundationˉcollectionˉelementˉshape(
                Constructˉresultˉlayout.Index, Constructˉtypeˉcatalog
            ) != Constructˉelement ||
            !Compilerˉsourceˉwirˉfoundationˉcollectionˉscalarˉisˉsupported(
                Constructˉelement, Symbols
            ) {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Build, Compilerˉsourceˉwirˉstatus.Genericˉresolution,
                Callable.Module, Expression.Offset, Expression.Line, Expression.Column
            );
        }
        let Constructˉfailure:
            Sourceˉsymbols.Compilerˉsourceˉsymbolˉmatch =
            Compilerˉsourceˉwirˉnominalˉbyˉshape(
                Input, Scan, Symbols, Constructˉresultˉlayout.Shape
            );
        if !Constructˉfailure.Found ||
            !Compilerˉsourceˉwirˉisˉfoundationˉallocationˉfailure(
                Input, Scan, Symbols,
                Constructˉresultˉlayout.Shape, Constructˉfailure.Module
            ) {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Build, Compilerˉsourceˉwirˉstatus.Genericˉresolution,
                Callable.Module, Expression.Offset, Expression.Line, Expression.Column
            );
        }
        let Constructˉbudgetˉposition:
            Sourceˉbodies.Compilerˉsourceˉposition =
            Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
                Source, Expression.Offset, Expression.Line, Expression.Column,
                Expression.Itemsˉoffset
            );
        let Constructˉbudgetˉexpression:
            Sourceˉbodies.Compilerˉsourceˉexpression =
            Sourceˉbodies.Compilerˉparseˉexpressionˉvalidated(
                Source, Expression.Itemsˉoffset,
                Constructˉbudgetˉposition.Line,
                Constructˉbudgetˉposition.Column,
                Expression.Itemsˉoffset + Expression.Itemsˉlength,
                0u32, 0u32
            );
        if Constructˉbudgetˉexpression.Kind !=
                Sourceˉbodies.Compilerˉsourceˉexpressionˉkind.Name {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Build, Compilerˉsourceˉwirˉstatus.Invalidˉargument,
                Callable.Module, Constructˉbudgetˉexpression.Offset,
                Constructˉbudgetˉexpression.Line,
                Constructˉbudgetˉexpression.Column
            );
        }
        let Constructˉbudget: Sourceˉbindings.Compilerˉsourceˉlocalˉmatch =
            Sourceˉbindings.Compilerˉsourceˉbindingsˉfindˉlocal(
                Source, Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
                Constructˉbudgetˉexpression.Valueˉoffset,
                Constructˉbudgetˉexpression.Valueˉlength,
                Constructˉbudgetˉexpression.Offset
            );
        if !Constructˉbudget.Found ||
            Constructˉbudget.Shape != 805306368u32 {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Build, Compilerˉsourceˉwirˉstatus.Invalidˉargument,
                Callable.Module, Constructˉbudgetˉexpression.Offset,
                Constructˉbudgetˉexpression.Line,
                Constructˉbudgetˉexpression.Column
            );
        }
        let Constructˉseparator: Sourceˉlexer.Compilerˉsourceˉtoken =
            Sourceˉbodies.Compilerˉbodyˉtoken(
                Source, Constructˉbudgetˉexpression.Nextˉoffset,
                Constructˉbudgetˉexpression.Nextˉline,
                Constructˉbudgetˉexpression.Nextˉcolumn,
                Expression.Itemsˉoffset + Expression.Itemsˉlength
            );
        let Constructˉmaximumˉexpression:
            Sourceˉbodies.Compilerˉsourceˉexpression =
            Sourceˉbodies.Compilerˉparseˉexpressionˉvalidated(
                Source, Constructˉseparator.Nextˉoffset,
                Constructˉseparator.Nextˉline, Constructˉseparator.Nextˉcolumn,
                Expression.Itemsˉoffset + Expression.Itemsˉlength,
                0u32, 0u32
            );
        let Constructˉmaximum: Compilerˉsourceˉwirˉvalue =
            Compilerˉsourceˉwirˉcompileˉcontextualˉexpression(
                Input, Scan, Symbols,
                Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
                Source, Constructˉmaximumˉexpression.Offset,
                Constructˉmaximumˉexpression.Line,
                Constructˉmaximumˉexpression.Column,
                Constructˉmaximumˉexpression.Offset +
                    Constructˉmaximumˉexpression.Length,
                8u32, Build
            );
        if Constructˉmaximum.Status != Compilerˉsourceˉwirˉstatus.Valid {
            return Constructˉmaximum;
        }
        if Constructˉmaximum.Shape != 8u32 {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Compilerˉsourceˉwirˉvalueˉbuild(Constructˉmaximum),
                Compilerˉsourceˉwirˉstatus.Invalidˉargument,
                Callable.Module, Constructˉmaximumˉexpression.Offset,
                Constructˉmaximumˉexpression.Line,
                Constructˉmaximumˉexpression.Column
            );
        }
        return Compilerˉsourceˉwirˉemit(
            Compilerˉsourceˉwirˉvalueˉbuild(Constructˉmaximum),
            WIR_OPERATION_FOUNDATION_VECTOR_CONSTRUCT_RESERVED,
            Expectedˉshape,
            Compilerˉsourceˉwirˉoneˉoperand(Constructˉmaximum.Temporary),
            Constructˉbudget.Slot, Constructˉfailure.Module,
            Expression.Offset, Expression.Length
        );
    }
    if Operation == WIR_OPERATION_FOUNDATION_VECTOR_APPEND {
        let Appendˉcatalog:
            Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog =
            Compilerˉsourceˉwirˉgenericˉtypeˉcatalog(Build.Genericˉevidence);
        let Appendˉresultˉlayout: Compilerˉsourceˉwirˉmember =
            Compilerˉsourceˉwirˉgenericˉfoundationˉresultˉlayout(
                Input, Scan, Symbols, Appendˉcatalog, Expectedˉshape
        );
        if !Appendˉresultˉlayout.Found ||
            Appendˉresultˉlayout.Index != 9u32 {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Build, Compilerˉsourceˉwirˉstatus.Genericˉresolution,
                Callable.Module,
                Expression.Offset, Expression.Line, Expression.Column
            );
        }
        let Appendˉelement: u32 =
            Compilerˉsourceˉwirˉvectorˉappendˉfailureˉelement(
                Input, Scan, Symbols, Appendˉcatalog,
                Appendˉresultˉlayout.Shape
            );
        if Appendˉelement == Compilerˉsourceˉwirˉsentinel() ||
            !Compilerˉsourceˉwirˉfoundationˉcollectionˉscalarˉisˉsupported(
                Appendˉelement, Symbols
            ) {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Build, Compilerˉsourceˉwirˉstatus.Genericˉresolution,
                Callable.Module,
                Expression.Offset, Expression.Line, Expression.Column
            );
        }
        let Appendˉvectorˉposition:
            Sourceˉbodies.Compilerˉsourceˉposition =
            Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
                Source, Expression.Offset, Expression.Line, Expression.Column,
                Expression.Itemsˉoffset
            );
        let Appendˉvectorˉargument:
            Sourceˉbodies.Compilerˉsourceˉexpression =
            Sourceˉbodies.Compilerˉparseˉexpressionˉvalidated(
                Source, Expression.Itemsˉoffset,
                Appendˉvectorˉposition.Line,
                Appendˉvectorˉposition.Column,
                Expression.Itemsˉoffset + Expression.Itemsˉlength,
                0u32, 0u32
            );
        if Appendˉvectorˉargument.Kind !=
                Sourceˉbodies.Compilerˉsourceˉexpressionˉkind.Unary ||
            Appendˉvectorˉargument.Operator !=
                Sourceˉlexer.Compilerˉtokenˉkind.Borrow ||
            !Appendˉvectorˉargument.Booleanˉvalue {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Build, Compilerˉsourceˉwirˉstatus.Invalidˉborrow,
                Callable.Module,
                Appendˉvectorˉargument.Offset,
                Appendˉvectorˉargument.Line,
                Appendˉvectorˉargument.Column
            );
        }
        let Appendˉborrowedˉposition:
            Sourceˉbodies.Compilerˉsourceˉposition =
            Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
                Source,
                Appendˉvectorˉargument.Offset,
                Appendˉvectorˉargument.Line,
                Appendˉvectorˉargument.Column,
                Appendˉvectorˉargument.Firstˉoffset
            );
        let Appendˉvectorˉexpression:
            Sourceˉbodies.Compilerˉsourceˉexpression =
            Sourceˉbodies.Compilerˉparseˉexpressionˉvalidated(
                Source, Appendˉvectorˉargument.Firstˉoffset,
                Appendˉborrowedˉposition.Line,
                Appendˉborrowedˉposition.Column,
                Appendˉvectorˉargument.Firstˉoffset +
                    Appendˉvectorˉargument.Firstˉlength,
                0u32, 0u32
            );
        if Appendˉvectorˉexpression.Kind !=
                Sourceˉbodies.Compilerˉsourceˉexpressionˉkind.Name ||
            !Compilerˉsourceˉwirˉmutableˉborrowˉoriginˉisˉvalid(
                Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
                Source, Appendˉvectorˉexpression
            ) {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Build, Compilerˉsourceˉwirˉstatus.Invalidˉborrow,
                Callable.Module,
                Appendˉvectorˉexpression.Offset,
                Appendˉvectorˉexpression.Line,
                Appendˉvectorˉexpression.Column
            );
        }
        let Appendˉvector: Sourceˉbindings.Compilerˉsourceˉlocalˉmatch =
            Sourceˉbindings.Compilerˉsourceˉbindingsˉfindˉlocal(
                Source, Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
                Appendˉvectorˉexpression.Valueˉoffset,
                Appendˉvectorˉexpression.Valueˉlength,
                Appendˉvectorˉexpression.Offset
            );
        if !Appendˉvector.Found || Appendˉvector.Kind ==
                Sourceˉbindings.Compilerˉsourceˉbindingˉkind.Parameter ||
            !Compilerˉsourceˉwirˉshapeˉisˉfoundationˉvector(
                Appendˉvector.Shape, Appendˉcatalog
            ) ||
            Compilerˉsourceˉwirˉfoundationˉcollectionˉelementˉshape(
                Appendˉvector.Shape, Appendˉcatalog
            ) != Appendˉelement {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Build, Compilerˉsourceˉwirˉstatus.Invalidˉcollection,
                Callable.Module,
                Appendˉvectorˉexpression.Offset,
                Appendˉvectorˉexpression.Line,
                Appendˉvectorˉexpression.Column
            );
        }
        let Appendˉseparator: Sourceˉlexer.Compilerˉsourceˉtoken =
            Sourceˉbodies.Compilerˉbodyˉtoken(
                Source,
                Appendˉvectorˉargument.Nextˉoffset,
                Appendˉvectorˉargument.Nextˉline,
                Appendˉvectorˉargument.Nextˉcolumn,
                Expression.Itemsˉoffset + Expression.Itemsˉlength
            );
        if Appendˉseparator.Kind != Sourceˉlexer.Compilerˉtokenˉkind.Comma {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Build, Compilerˉsourceˉwirˉstatus.Invalidˉargument,
                Callable.Module,
                Appendˉseparator.Offset,
                Appendˉseparator.Line,
                Appendˉseparator.Column
            );
        }
        let Appendˉvalueˉexpression:
            Sourceˉbodies.Compilerˉsourceˉexpression =
            Sourceˉbodies.Compilerˉparseˉexpressionˉvalidated(
                Source, Appendˉseparator.Nextˉoffset,
                Appendˉseparator.Nextˉline,
                Appendˉseparator.Nextˉcolumn,
                Expression.Itemsˉoffset + Expression.Itemsˉlength,
                0u32, 0u32
            );
        let Appendˉvalue: Compilerˉsourceˉwirˉvalue =
            Compilerˉsourceˉwirˉcompileˉcontextualˉexpression(
                Input, Scan, Symbols,
                Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
                Source,
                Appendˉvalueˉexpression.Offset,
                Appendˉvalueˉexpression.Line,
                Appendˉvalueˉexpression.Column,
                Appendˉvalueˉexpression.Offset +
                    Appendˉvalueˉexpression.Length,
                Appendˉelement, Build
            );
        if Appendˉvalue.Status != Compilerˉsourceˉwirˉstatus.Valid {
            return Appendˉvalue;
        }
        if Appendˉvalue.Shape != Appendˉelement {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Compilerˉsourceˉwirˉvalueˉbuild(Appendˉvalue),
                Compilerˉsourceˉwirˉstatus.Invalidˉargument,
                Callable.Module,
                Appendˉvalueˉexpression.Offset,
                Appendˉvalueˉexpression.Line,
                Appendˉvalueˉexpression.Column
            );
        }
        return Compilerˉsourceˉwirˉemit(
            Compilerˉsourceˉwirˉvalueˉbuild(Appendˉvalue),
            WIR_OPERATION_FOUNDATION_VECTOR_APPEND,
            Expectedˉshape,
            Compilerˉsourceˉwirˉoneˉoperand(Appendˉvalue.Temporary),
            Appendˉvector.Slot, Appendˉvector.Shape,
            Expression.Offset, Expression.Length
        );
    }
    let Position: Sourceˉbodies.Compilerˉsourceˉposition =
        Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
            Source, Expression.Offset, Expression.Line, Expression.Column,
            Expression.Itemsˉoffset
        );
    let Argument: Sourceˉbodies.Compilerˉsourceˉexpression =
        Sourceˉbodies.Compilerˉparseˉexpressionˉvalidated(
            Source, Expression.Itemsˉoffset, Position.Line, Position.Column,
            Expression.Itemsˉoffset + Expression.Itemsˉlength, 0u32, 0u32
        );
    var Valueˉexpression: Sourceˉbodies.Compilerˉsourceˉexpression = Argument;
    if Operation == WIR_OPERATION_FOUNDATION_VECTOR_LENGTH ||
        Operation == WIR_OPERATION_PLATFORM_SOURCE_LENGTH {
        if Argument.Kind != Sourceˉbodies.Compilerˉsourceˉexpressionˉkind.Unary ||
            Argument.Operator != Sourceˉlexer.Compilerˉtokenˉkind.Borrow ||
            Argument.Booleanˉvalue {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Build, Compilerˉsourceˉwirˉstatus.Invalidˉborrow,
                Callable.Module, Argument.Offset, Argument.Line, Argument.Column
            );
        }
        let Borrowedˉposition: Sourceˉbodies.Compilerˉsourceˉposition =
            Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
                Source, Argument.Offset, Argument.Line, Argument.Column,
                Argument.Firstˉoffset
            );
        Valueˉexpression = Sourceˉbodies.Compilerˉparseˉexpressionˉvalidated(
            Source, Argument.Firstˉoffset,
            Borrowedˉposition.Line, Borrowedˉposition.Column,
            Argument.Firstˉoffset + Argument.Firstˉlength, 0u32, 0u32
        );
    } else if Argument.Kind ==
            Sourceˉbodies.Compilerˉsourceˉexpressionˉkind.Unary &&
        Argument.Operator == Sourceˉlexer.Compilerˉtokenˉkind.Borrow {
        return Compilerˉsourceˉwirˉfailureˉvalue(
            Build, Compilerˉsourceˉwirˉstatus.Invalidˉborrow,
            Callable.Module, Argument.Offset, Argument.Line, Argument.Column
        );
    }
    if Valueˉexpression.Kind !=
            Sourceˉbodies.Compilerˉsourceˉexpressionˉkind.Name {
        return Compilerˉsourceˉwirˉfailureˉvalue(
            Build, Compilerˉsourceˉwirˉstatus.Invalidˉcollection,
            Callable.Module,
            Valueˉexpression.Offset, Valueˉexpression.Line,
            Valueˉexpression.Column
        );
    }
    let Local: Sourceˉbindings.Compilerˉsourceˉlocalˉmatch =
        Sourceˉbindings.Compilerˉsourceˉbindingsˉfindˉlocal(
            Source, Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
            Valueˉexpression.Valueˉoffset, Valueˉexpression.Valueˉlength,
            Valueˉexpression.Offset
        );
    if !Local.Found ||
        Local.Kind == Sourceˉbindings.Compilerˉsourceˉbindingˉkind.Parameter {
        return Compilerˉsourceˉwirˉfailureˉvalue(
            Build, Compilerˉsourceˉwirˉstatus.Invalidˉcollection,
            Callable.Module,
            Valueˉexpression.Offset, Valueˉexpression.Line,
            Valueˉexpression.Column
        );
    }
    if Operation == WIR_OPERATION_PLATFORM_SOURCE_LENGTH {
        if Local.Shape != 805306369u32 ||
            (Expectedˉshape != 0u32 &&
                Expectedˉshape != Compilerˉsourceˉwirˉsentinel() &&
                Expectedˉshape != 8u32) {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Build, Compilerˉsourceˉwirˉstatus.Invalidˉresource,
                Callable.Module, Valueˉexpression.Offset,
                Valueˉexpression.Line, Valueˉexpression.Column
            );
        }
        return Compilerˉsourceˉwirˉemit(
            Build, Operation, 8u32, Compilerˉsourceˉwirˉempty(Source),
            Local.Slot, 0u32, Expression.Offset, Expression.Length
        );
    }
    let Catalog: Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog =
        Compilerˉsourceˉwirˉgenericˉtypeˉcatalog(Build.Genericˉevidence);
    let Element: u32 =
        Compilerˉsourceˉwirˉfoundationˉcollectionˉelementˉshape(
            Local.Shape, Catalog
        );
    if !Compilerˉsourceˉwirˉshapeˉisˉfoundationˉvector(
            Local.Shape, Catalog
        ) ||
        !Compilerˉsourceˉwirˉfoundationˉcollectionˉscalarˉisˉsupported(
            Element, Symbols
        ) {
        return Compilerˉsourceˉwirˉfailureˉvalue(
            Build, Compilerˉsourceˉwirˉstatus.Invalidˉcollection,
            Callable.Module,
            Valueˉexpression.Offset, Valueˉexpression.Line,
            Valueˉexpression.Column
        );
    }
    if Operation == WIR_OPERATION_FOUNDATION_VECTOR_LENGTH {
        return Compilerˉsourceˉwirˉemit(
            Build, Operation, 8u32, Compilerˉsourceˉwirˉempty(Source),
            Local.Slot, Local.Shape, Expression.Offset, Expression.Length
        );
    }
    let Sequenceˉshape: u32 = Expectedˉshape;
    if Sequenceˉshape == 0u32 ||
        Sequenceˉshape == Compilerˉsourceˉwirˉsentinel() ||
        !Compilerˉsourceˉwirˉshapeˉisˉfoundationˉsequence(
            Sequenceˉshape, Catalog
        ) ||
        Compilerˉsourceˉwirˉfoundationˉcollectionˉelementˉshape(
            Sequenceˉshape, Catalog
        ) != Element {
        return Compilerˉsourceˉwirˉfailureˉvalue(
            Build, Compilerˉsourceˉwirˉstatus.Invalidˉcollection,
            Callable.Module,
            Valueˉexpression.Offset, Valueˉexpression.Line,
            Valueˉexpression.Column
        );
    }
    return Compilerˉsourceˉwirˉemit(
        Build, Operation, Sequenceˉshape,
        Compilerˉsourceˉwirˉempty(Source),
        Local.Slot, Local.Shape, Expression.Offset, Expression.Length
    );
}

fn Compilerˉsourceˉwirˉcompileˉfoundationˉunsafeˉconstructˉscratch(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Bindingˉpayload: bytes,
    Bindingˉfirst: u32,
    Bindingˉentries: u32,
    Source: bytes,
    Expression: Sourceˉbodies.Compilerˉsourceˉexpression,
    Callable: Sourceˉbindings.Compilerˉsourceˉbindingˉmatch,
    Expectedˉshape: u32,
    Build: Compilerˉsourceˉwirˉbuild
) -> Compilerˉsourceˉwirˉvalue {
    if Expression.Kind !=
            Sourceˉbodies.Compilerˉsourceˉexpressionˉkind.Explicitˉgenericˉcall ||
        Expression.Numericˉvalue != 1u32 {
        return Compilerˉsourceˉwirˉfailureˉvalue(
            Build, Compilerˉsourceˉwirˉstatus.Genericˉresolution,
            Callable.Module, Expression.Offset, Expression.Line,
            Expression.Column
        );
    }
    let Abiˉposition: Sourceˉbodies.Compilerˉsourceˉposition =
        Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
            Source, Expression.Offset, Expression.Line, Expression.Column,
            Expression.Firstˉoffset
        );
    let Abiˉtype: Sourceˉsymbols.Compilerˉsourceˉtypeˉbinding =
        Sourceˉsymbols.Compilerˉsourceˉsymbolsˉbindˉtype(
            Input, Scan, Symbols.Directory, Symbols.Lookup,
            Symbols.Visibility, Build.Currentˉmodule, Source,
            Expression.Firstˉoffset,
            Abiˉposition.Line, Abiˉposition.Column,
            Symbols.Records, Symbols.Enums, false
        );
    let Abiˉshape: u32 =
        Sourceˉsymbols.Compilerˉsourceˉsymbolsˉtypeˉshape(Abiˉtype);
    let Firstˉenum: u32 = 131072u32 + Symbols.Records;
    if Abiˉtype.Status !=
            Sourceˉsymbols.Compilerˉsourceˉsymbolˉstatus.Valid ||
        Abiˉtype.Nextˉoffset != Expression.Firstˉoffset +
            Expression.Firstˉlength ||
        Abiˉshape < Firstˉenum ||
        Abiˉshape >= Firstˉenum + Symbols.Enums {
        return Compilerˉsourceˉwirˉfailureˉvalue(
            Build, Compilerˉsourceˉwirˉstatus.Genericˉresolution,
            Callable.Module, Expression.Firstˉoffset,
            Abiˉposition.Line, Abiˉposition.Column
        );
    }
    let Catalog: Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog =
        Compilerˉsourceˉwirˉgenericˉtypeˉcatalog(Build.Genericˉevidence);
    let Resultˉlayout: Compilerˉsourceˉwirˉmember =
        Compilerˉsourceˉwirˉgenericˉfoundationˉresultˉlayout(
            Input, Scan, Symbols, Catalog, Expectedˉshape
        );
    if !Resultˉlayout.Found ||
        !Compilerˉsourceˉwirˉfoundationˉunsafeˉgenericˉisˉexact(
            Input, Scan, Symbols, Catalog, Resultˉlayout.Index,
            "Foreignˉscratch", 1u32, Abiˉshape, 0u32
        ) ||
        !Compilerˉsourceˉwirˉisˉfoundationˉforeignˉmemoryˉfailure(
            Input, Scan, Symbols, Catalog,
            Resultˉlayout.Shape, Callable.Module
        ) {
        return Compilerˉsourceˉwirˉfailureˉvalue(
            Build, Compilerˉsourceˉwirˉstatus.Genericˉresolution,
            Callable.Module, Expression.Offset, Expression.Line,
            Expression.Column
        );
    }
    let Budgetˉargument: Compilerˉsourceˉwirˉtaskˉargument =
        Compilerˉsourceˉwirˉtaskˉargumentˉat(
            Source, Expression, 0u32, "Budget"
        );
    let Lengthˉargument: Compilerˉsourceˉwirˉtaskˉargument =
        Compilerˉsourceˉwirˉtaskˉargumentˉat(
            Source, Expression, 1u32, "Length"
        );
    let Alignmentˉargument: Compilerˉsourceˉwirˉtaskˉargument =
        Compilerˉsourceˉwirˉtaskˉargumentˉat(
            Source, Expression, 2u32, "Alignment"
        );
    if !Budgetˉargument.Found || !Lengthˉargument.Found ||
        !Alignmentˉargument.Found ||
        Budgetˉargument.Mode !=
            Sourceˉdeclarations.COMPILER_SOURCE_BORROW_MODE_VALUE ||
        Lengthˉargument.Mode !=
            Sourceˉdeclarations.COMPILER_SOURCE_BORROW_MODE_VALUE ||
        Alignmentˉargument.Mode !=
            Sourceˉdeclarations.COMPILER_SOURCE_BORROW_MODE_VALUE {
        return Compilerˉsourceˉwirˉfailureˉvalue(
            Build, Compilerˉsourceˉwirˉstatus.Invalidˉargument,
            Callable.Module, Expression.Offset, Expression.Line,
            Expression.Column
        );
    }
    let Budgetˉexpression: Sourceˉbodies.Compilerˉsourceˉexpression =
        Sourceˉbodies.Compilerˉparseˉexpressionˉvalidated(
            Source, Budgetˉargument.Valueˉoffset,
            Budgetˉargument.Valueˉline, Budgetˉargument.Valueˉcolumn,
            Budgetˉargument.Valueˉoffset + Budgetˉargument.Valueˉlength,
            0u32, 0u32
        );
    if Budgetˉexpression.Kind !=
            Sourceˉbodies.Compilerˉsourceˉexpressionˉkind.Name {
        return Compilerˉsourceˉwirˉfailureˉvalue(
            Build, Compilerˉsourceˉwirˉstatus.Invalidˉargument,
            Callable.Module, Budgetˉexpression.Offset,
            Budgetˉexpression.Line, Budgetˉexpression.Column
        );
    }
    let Budget: Sourceˉbindings.Compilerˉsourceˉlocalˉmatch =
        Sourceˉbindings.Compilerˉsourceˉbindingsˉfindˉlocal(
            Source, Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
            Budgetˉexpression.Valueˉoffset,
            Budgetˉexpression.Valueˉlength, Budgetˉexpression.Offset
        );
    if !Budget.Found || Budget.Shape != 805306368u32 {
        return Compilerˉsourceˉwirˉfailureˉvalue(
            Build, Compilerˉsourceˉwirˉstatus.Invalidˉargument,
            Callable.Module, Budgetˉexpression.Offset,
            Budgetˉexpression.Line, Budgetˉexpression.Column
        );
    }
    let Lengthˉvalue: Compilerˉsourceˉwirˉvalue =
        Compilerˉsourceˉwirˉcompileˉcontextualˉexpression(
            Input, Scan, Symbols,
            Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
            Source, Lengthˉargument.Valueˉoffset,
            Lengthˉargument.Valueˉline, Lengthˉargument.Valueˉcolumn,
            Lengthˉargument.Valueˉoffset + Lengthˉargument.Valueˉlength,
            8u32, Build
        );
    if Lengthˉvalue.Status != Compilerˉsourceˉwirˉstatus.Valid {
        return Lengthˉvalue;
    }
    if Lengthˉvalue.Shape != 8u32 {
        return Compilerˉsourceˉwirˉfailureˉvalue(
            Compilerˉsourceˉwirˉvalueˉbuild(Lengthˉvalue),
            Compilerˉsourceˉwirˉstatus.Invalidˉargument,
            Callable.Module, Lengthˉargument.Valueˉoffset,
            Lengthˉargument.Valueˉline, Lengthˉargument.Valueˉcolumn
        );
    }
    let Alignmentˉvalue: Compilerˉsourceˉwirˉvalue =
        Compilerˉsourceˉwirˉcompileˉcontextualˉexpression(
            Input, Scan, Symbols,
            Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
            Source, Alignmentˉargument.Valueˉoffset,
            Alignmentˉargument.Valueˉline,
            Alignmentˉargument.Valueˉcolumn,
            Alignmentˉargument.Valueˉoffset +
                Alignmentˉargument.Valueˉlength,
            8u32, Compilerˉsourceˉwirˉvalueˉbuild(Lengthˉvalue)
        );
    if Alignmentˉvalue.Status != Compilerˉsourceˉwirˉstatus.Valid {
        return Alignmentˉvalue;
    }
    if Alignmentˉvalue.Shape != 8u32 {
        return Compilerˉsourceˉwirˉfailureˉvalue(
            Compilerˉsourceˉwirˉvalueˉbuild(Alignmentˉvalue),
            Compilerˉsourceˉwirˉstatus.Invalidˉargument,
            Callable.Module, Alignmentˉargument.Valueˉoffset,
            Alignmentˉargument.Valueˉline,
            Alignmentˉargument.Valueˉcolumn
        );
    }
    var Operands: bytes = Bytesˉfromˉu32ˉlittle(Lengthˉvalue.Temporary);
    Operands = Bytesˉconcat(
        Operands, Bytesˉfromˉu32ˉlittle(Alignmentˉvalue.Temporary)
    );
    return Compilerˉsourceˉwirˉemit(
        Compilerˉsourceˉwirˉvalueˉbuild(Alignmentˉvalue),
        WIR_OPERATION_FOUNDATION_UNSAFE_CONSTRUCT_SCRATCH,
        Expectedˉshape, Operands, Budget.Slot, Abiˉshape,
        Expression.Offset, Expression.Length
    );
}

fn Compilerˉsourceˉwirˉcompileˉfoundationˉunsafeˉscratchˉlength(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Bindingˉpayload: bytes,
    Bindingˉfirst: u32,
    Bindingˉentries: u32,
    Source: bytes,
    Expression: Sourceˉbodies.Compilerˉsourceˉexpression,
    Callable: Sourceˉbindings.Compilerˉsourceˉbindingˉmatch,
