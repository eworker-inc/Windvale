                        Compilerˉsourceˉwirˉvalueˉbuild(Assignmentˉvalue), Bindingˉphase
                    );
                }
                if Assignmentˉvalue.Shape == 10u32 {
                    Result = Compilerˉsourceˉwirˉvalueˉbuild(Assignmentˉvalue);
                } else {
                if Assignmentˉvalue.Shape != Assignmentˉbinding.Shape {
                    return Compilerˉsourceˉwirˉfusedˉfrom(
                        Compilerˉsourceˉwirˉbuildˉfailure(
                            Compilerˉsourceˉwirˉvalueˉbuild(Assignmentˉvalue),
                            Compilerˉsourceˉwirˉstatus.Typeˉmismatch,
                            Result.Currentˉmodule, Result.Currentˉmodule, Result.Currentˉfunction,
                            Statement.Expressionˉoffset, Assignmentˉposition.Line, Assignmentˉposition.Column
                        ),
                        Bindingˉphase
                    );
                }
                if Isˉcompound {
                    if Assignmentˉbinding.Shape != 1u32 &&
                        Assignmentˉbinding.Shape != 3u32 &&
                        Assignmentˉbinding.Shape != 7u32 &&
                        Assignmentˉbinding.Shape != 8u32 &&
                        Assignmentˉbinding.Shape != 11u32 &&
                        Assignmentˉbinding.Shape != 12u32 &&
                        Assignmentˉbinding.Shape != 13u32 {
                        return Compilerˉsourceˉwirˉfusedˉfrom(
                            Compilerˉsourceˉwirˉbuildˉfailure(
                                Compilerˉsourceˉwirˉvalueˉbuild(Assignmentˉvalue),
                                Compilerˉsourceˉwirˉstatus.Invalidˉoperator,
                                Result.Currentˉmodule, Result.Currentˉmodule, Result.Currentˉfunction,
                                Statement.Offset, Statement.Line, Statement.Column
                            ),
                            Bindingˉphase
                        );
                    }
                    var Binaryˉoperator: Sourceˉlexer.Compilerˉtokenˉkind = Sourceˉlexer.Compilerˉtokenˉkind.Plus;
                    if Assignmentˉoperator.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Minusˉequals {
                        Binaryˉoperator = Sourceˉlexer.Compilerˉtokenˉkind.Minus;
                    }
                    if Assignmentˉoperator.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Starˉequals {
                        Binaryˉoperator = Sourceˉlexer.Compilerˉtokenˉkind.Star;
                    }
                    Assignmentˉvalue = Compilerˉsourceˉwirˉemit(
                        Compilerˉsourceˉwirˉvalueˉbuild(Assignmentˉvalue),
                        Compilerˉsourceˉwirˉbinaryˉoperation(Binaryˉoperator, Assignmentˉbinding.Shape),
                        Assignmentˉbinding.Shape,
                        Compilerˉsourceˉwirˉtwoˉoperands(
                            Assignmentˉleft, Assignmentˉvalue.Temporary
                        ),
                        0u32, 0u32,
                        Statement.Offset, Statement.Length
                    );
                }
                let Assignmentˉstored: Compilerˉsourceˉwirˉvalue = Compilerˉsourceˉwirˉemit(
                    Compilerˉsourceˉwirˉvalueˉbuild(Assignmentˉvalue),
                    WIR_OPERATION_STORE_LOCAL,
                    0u32,
                    Compilerˉsourceˉwirˉoneˉoperand(Assignmentˉvalue.Temporary),
                    Assignmentˉbinding.Slot, 0u32,
                    Statement.Offset, Statement.Length
                );
                Result = Compilerˉsourceˉwirˉvalueˉbuild(Assignmentˉstored);
                }
            }
            if Statement.Kind == Sourceˉbodies.Compilerˉsourceˉstatementˉkind.Push {
                Result = Compilerˉsourceˉwirˉcompileˉpush(
                    Input, Scan, Symbols, Bindingˉphase, Source, Statement, Result
                );
                if Result.Status != Compilerˉsourceˉwirˉstatus.Valid {
                    return Result;
                }
            }
            if Statement.Kind == Sourceˉbodies.Compilerˉsourceˉstatementˉkind.Expression {
                let Expressionˉposition: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
                    Source, Statement.Offset, Statement.Line, Statement.Column,
                    Statement.Expressionˉoffset
                );
                let Expressionˉvalue: Compilerˉsourceˉwirˉvalue = Compilerˉsourceˉwirˉcompileˉexpression(
                    Input, Scan, Symbols,
                    Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
                    Source,
                    Statement.Expressionˉoffset, Expressionˉposition.Line, Expressionˉposition.Column,
                    Statement.Expressionˉoffset + Statement.Expressionˉlength,
                    Result
                );
                if Expressionˉvalue.Status != Compilerˉsourceˉwirˉstatus.Valid {
                    return Compilerˉsourceˉwirˉfusedˉfrom(
                        Compilerˉsourceˉwirˉvalueˉbuild(Expressionˉvalue), Bindingˉphase
                    );
                }
                Result = Compilerˉsourceˉwirˉvalueˉbuild(Expressionˉvalue);
            }
            if Statement.Kind == Sourceˉbodies.Compilerˉsourceˉstatementˉkind.Break {
                if Breakˉtarget == Compilerˉsourceˉwirˉsentinel() {
                    return Compilerˉsourceˉwirˉfusedˉfrom(
                        Compilerˉsourceˉwirˉbuildˉfailure(
                            Result,
                            Compilerˉsourceˉwirˉstatus.Invalidˉbreak,
                            Result.Currentˉmodule, Result.Currentˉmodule, Result.Currentˉfunction,
                            Statement.Offset, Statement.Line, Statement.Column
                        ),
                        Bindingˉphase
                    );
                }
                Result = Compilerˉsourceˉwirˉreleaseˉscopedˉforˉexit(
                    Result, Statement.Offset, Loopˉscopeˉoffset
                );
                Result = Compilerˉsourceˉwirˉcloseˉcurrentˉblock(
                    Result,
                    Compilerˉsourceˉwirˉterminator.Jump,
                    Compilerˉsourceˉwirˉsentinel(),
                    Breakˉtarget,
                    Compilerˉsourceˉwirˉsentinel()
                );
            }
            if Statement.Kind == Sourceˉbodies.Compilerˉsourceˉstatementˉkind.Continue {
                if Continueˉtarget == Compilerˉsourceˉwirˉsentinel() {
                    return Compilerˉsourceˉwirˉfusedˉfrom(
                        Compilerˉsourceˉwirˉbuildˉfailure(
                            Result,
                            Compilerˉsourceˉwirˉstatus.Invalidˉcontinue,
                            Result.Currentˉmodule, Result.Currentˉmodule, Result.Currentˉfunction,
                            Statement.Offset, Statement.Line, Statement.Column
                        ),
                        Bindingˉphase
                    );
                }
                Result = Compilerˉsourceˉwirˉreleaseˉscopedˉforˉexit(
                    Result, Statement.Offset, Loopˉscopeˉoffset
                );
                Result = Compilerˉsourceˉwirˉcloseˉcurrentˉblock(
                    Result,
                    Compilerˉsourceˉwirˉterminator.Jump,
                    Compilerˉsourceˉwirˉsentinel(),
                    Continueˉtarget,
                    Compilerˉsourceˉwirˉsentinel()
                );
            }
            if Statement.Kind == Sourceˉbodies.Compilerˉsourceˉstatementˉkind.Return {
                Result = Compilerˉsourceˉwirˉcompileˉreturn(
                    Input, Scan, Symbols, Bindingˉphase, Source,
                    Statement, Returnˉshape, Result
                );
                if Result.Status != Compilerˉsourceˉwirˉstatus.Valid {
                    return Result;
                }
            }
            if Statement.Kind == Sourceˉbodies.Compilerˉsourceˉstatementˉkind.If {
                let Ifˉconditionˉposition: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
                    Source, Statement.Offset, Statement.Line, Statement.Column,
                    Statement.Expressionˉoffset
                );
                let Ifˉcondition: Compilerˉsourceˉwirˉvalue = Compilerˉsourceˉwirˉcompileˉexpression(
                    Input, Scan, Symbols,
                    Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
                    Source,
                    Statement.Expressionˉoffset,
                    Ifˉconditionˉposition.Line, Ifˉconditionˉposition.Column,
                    Statement.Expressionˉoffset + Statement.Expressionˉlength,
                    Result
                );
                if Ifˉcondition.Status != Compilerˉsourceˉwirˉstatus.Valid {
                    return Compilerˉsourceˉwirˉfusedˉfrom(
                        Compilerˉsourceˉwirˉvalueˉbuild(Ifˉcondition), Bindingˉphase
                    );
                }
                if Ifˉcondition.Shape == 10u32 {
                    Result = Compilerˉsourceˉwirˉvalueˉbuild(Ifˉcondition);
                } else {
                if Ifˉcondition.Shape != 4u32 {
                    return Compilerˉsourceˉwirˉfusedˉfrom(
                        Compilerˉsourceˉwirˉbuildˉfailure(
                            Compilerˉsourceˉwirˉvalueˉbuild(Ifˉcondition),
                            Compilerˉsourceˉwirˉstatus.Invalidˉcondition,
                            Result.Currentˉmodule, Result.Currentˉmodule, Result.Currentˉfunction,
                            Statement.Expressionˉoffset,
                            Ifˉconditionˉposition.Line, Ifˉconditionˉposition.Column
                        ),
                        Bindingˉphase
                    );
                }
                var Branch: Compilerˉsourceˉwirˉbuild = Compilerˉsourceˉwirˉvalueˉbuild(Ifˉcondition);
                let Thenˉblock: u32 = Branch.Nextˉblock;
                let Elseˉblock: u32 = Thenˉblock + 1u32;
                Branch = Compilerˉsourceˉwirˉreserveˉblocks(Branch, 2u32);
                Branch = Compilerˉsourceˉwirˉcloseˉcurrentˉblock(
                    Branch,
                    Compilerˉsourceˉwirˉterminator.Branch,
                    Ifˉcondition.Temporary,
                    Thenˉblock,
                    Elseˉblock
                );
                let Thenˉposition: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
                    Source, Statement.Offset, Statement.Line, Statement.Column,
                    Statement.Firstˉblockˉoffset
                );
                let Thenˉstart: Compilerˉsourceˉwirˉbuild = Compilerˉsourceˉwirˉbeginˉreservedˉblock(
                    Branch, Thenˉblock
                );
                let Thenˉresult: Compilerˉsourceˉwirˉbuild = Compilerˉsourceˉwirˉcompileˉblock(
                    Input, Scan, Symbols,
                    Bindingˉphase,
                    Source,
                    Statement.Firstˉblockˉoffset,
                    Thenˉposition.Line, Thenˉposition.Column,
                    Statement.Firstˉblockˉoffset + Statement.Firstˉblockˉlength,
                    Statement.Firstˉblockˉoffset + Statement.Firstˉblockˉlength,
                    Returnˉshape,
                    Continueˉtarget,
                    Breakˉtarget,
                    Loopˉscopeˉoffset,
                    Thenˉstart
                );
                if Thenˉresult.Status != Compilerˉsourceˉwirˉstatus.Valid {
                    return Thenˉresult;
                }
                Bindingˉphase = Compilerˉsourceˉwirˉbuildˉbindings(Input, Thenˉresult);
                let Thenˉhasˉcurrent: bool = Thenˉresult.Hasˉcurrentˉblock;
                let Thenˉcurrent: u32 = Thenˉresult.Currentˉblock;
                let Thenˉfirst: u32 = Thenˉresult.Currentˉblockˉfirstˉoperation;
                let Thenˉcount: u32 = Thenˉresult.Operations - Thenˉfirst;
                var Elseˉresult: Compilerˉsourceˉwirˉbuild = Compilerˉsourceˉwirˉbeginˉreservedˉblock(
                    Compilerˉsourceˉwirˉwithoutˉcurrentˉblock(Thenˉresult),
                    Elseˉblock
                );
                if Statement.Secondˉblockˉlength > 0u32 {
                    let Elseˉposition: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
                        Source, Statement.Offset, Statement.Line, Statement.Column,
                        Statement.Secondˉblockˉoffset
                    );
                    let Elseˉcompiled: Compilerˉsourceˉwirˉbuild =
                        Compilerˉsourceˉwirˉcompileˉblock(
                            Input, Scan, Symbols,
                            Bindingˉphase,
                            Source,
                            Statement.Secondˉblockˉoffset,
                            Elseˉposition.Line, Elseˉposition.Column,
                            Statement.Secondˉblockˉoffset + Statement.Secondˉblockˉlength,
                            Statement.Secondˉblockˉoffset + Statement.Secondˉblockˉlength,
                            Returnˉshape,
                            Continueˉtarget,
                            Breakˉtarget,
                            Loopˉscopeˉoffset,
                            Elseˉresult
                        );
                    if Elseˉcompiled.Status != Compilerˉsourceˉwirˉstatus.Valid {
                        return Elseˉcompiled;
                    }
                    Bindingˉphase = Compilerˉsourceˉwirˉbuildˉbindings(Input, Elseˉcompiled);
                    Elseˉresult = Elseˉcompiled;
                }
                let Elseˉhasˉcurrent: bool = Elseˉresult.Hasˉcurrentˉblock;
                let Elseˉcurrent: u32 = Elseˉresult.Currentˉblock;
                let Elseˉfirst: u32 = Elseˉresult.Currentˉblockˉfirstˉoperation;
                let Elseˉcount: u32 = Elseˉresult.Operations - Elseˉfirst;
                Result = Compilerˉsourceˉwirˉwithoutˉcurrentˉblock(Elseˉresult);
                if Thenˉhasˉcurrent {
                    let Thenˉjoin: u32 = Result.Nextˉblock;
                    if Elseˉhasˉcurrent {
                        Result = Compilerˉsourceˉwirˉreserveˉblocks(Result, 1u32);
                        Result = Compilerˉsourceˉwirˉappendˉblock(
                            Result, Thenˉcurrent, Thenˉfirst, Thenˉcount,
                            Compilerˉsourceˉwirˉterminator.Jump,
                            Compilerˉsourceˉwirˉsentinel(), Thenˉjoin, Compilerˉsourceˉwirˉsentinel()
                        );
                        Result = Compilerˉsourceˉwirˉappendˉblock(
                            Result, Elseˉcurrent, Elseˉfirst, Elseˉcount,
                            Compilerˉsourceˉwirˉterminator.Jump,
                            Compilerˉsourceˉwirˉsentinel(), Thenˉjoin, Compilerˉsourceˉwirˉsentinel()
                        );
                        Result = Compilerˉsourceˉwirˉbeginˉreservedˉblock(Result, Thenˉjoin);
                    } else {
                        Result = Compilerˉsourceˉwirˉreserveˉblocks(Result, 1u32);
                        Result = Compilerˉsourceˉwirˉappendˉblock(
                            Result, Thenˉcurrent, Thenˉfirst, Thenˉcount,
                            Compilerˉsourceˉwirˉterminator.Jump,
                            Compilerˉsourceˉwirˉsentinel(), Thenˉjoin, Compilerˉsourceˉwirˉsentinel()
                        );
                        Result = Compilerˉsourceˉwirˉbeginˉreservedˉblock(Result, Thenˉjoin);
                    }
                } else {
                    if Elseˉhasˉcurrent {
                        let Elseˉjoin: u32 = Result.Nextˉblock;
                        Result = Compilerˉsourceˉwirˉreserveˉblocks(Result, 1u32);
                        Result = Compilerˉsourceˉwirˉappendˉblock(
                            Result, Elseˉcurrent, Elseˉfirst, Elseˉcount,
                            Compilerˉsourceˉwirˉterminator.Jump,
                            Compilerˉsourceˉwirˉsentinel(), Elseˉjoin, Compilerˉsourceˉwirˉsentinel()
                        );
                        Result = Compilerˉsourceˉwirˉbeginˉreservedˉblock(Result, Elseˉjoin);
                    }
                }
                }
            }
            if Statement.Kind == Sourceˉbodies.Compilerˉsourceˉstatementˉkind.Match {
                let Statementˉmatch: Compilerˉsourceˉwirˉmatchˉview =
                    Compilerˉsourceˉwirˉmatchˉview(
                        Statement.Offset,
                        Statement.Length,
                        Statement.Line,
                        Statement.Column,
                        Statement.Nameˉlength,
                        Statement.Expressionˉoffset,
                        Statement.Expressionˉlength,
                        Statement.Firstˉblockˉoffset,
                        Statement.Firstˉblockˉlength
                    );
                Result = Compilerˉsourceˉwirˉvalueˉbuild(
                    Compilerˉsourceˉwirˉcompileˉmatch(
                        Input, Scan, Symbols, Source,
                        Statementˉmatch,
                        false,
                        Returnˉshape, Continueˉtarget, Breakˉtarget,
                        Loopˉscopeˉoffset,
                        Result
                    )
                );
                if Result.Status != Compilerˉsourceˉwirˉstatus.Valid {
                    return Result;
                }
                Bindingˉphase = Compilerˉsourceˉwirˉbuildˉbindings(Input, Result);
            }
            if Statement.Kind == Sourceˉbodies.Compilerˉsourceˉstatementˉkind.Try {
                Result = Compilerˉsourceˉwirˉcompileˉtry(
                    Input, Scan, Symbols, Bindingˉphase, Source, Statement,
                    Result
                );
                if Result.Status != Compilerˉsourceˉwirˉstatus.Valid {
                    return Result;
                }
                Bindingˉphase = Compilerˉsourceˉwirˉbuildˉbindings(Input, Result);
            }
            if Statement.Kind == Sourceˉbodies.Compilerˉsourceˉstatementˉkind.Using {
                Result = Compilerˉsourceˉwirˉcompileˉusing(
                    Input, Scan, Symbols, Bindingˉphase, Source, Statement,
                    Returnˉshape, Continueˉtarget, Breakˉtarget,
                    Loopˉscopeˉoffset,
                    Result
                );
                if Result.Status != Compilerˉsourceˉwirˉstatus.Valid {
                    return Result;
                }
                Bindingˉphase = Compilerˉsourceˉwirˉbuildˉbindings(Input, Result);
            }
            if Statement.Kind ==
                    Sourceˉbodies.Compilerˉsourceˉstatementˉkind.Taskˉscope {
                Result = Compilerˉsourceˉwirˉcompileˉtaskˉscope(
                    Input, Scan, Symbols, Bindingˉphase, Source, Statement,
                    Returnˉshape, Continueˉtarget, Breakˉtarget,
                    Loopˉscopeˉoffset, Result
                );
                if Result.Status != Compilerˉsourceˉwirˉstatus.Valid {
                    return Result;
                }
                Bindingˉphase =
                    Compilerˉsourceˉwirˉbuildˉbindings(Input, Result);
            }
            if Statement.Kind == Sourceˉbodies.Compilerˉsourceˉstatementˉkind.For {
                Result = Compilerˉsourceˉwirˉcompileˉfor(
                    Input, Scan, Symbols, Bindingˉphase, Source, Statement,
                    Returnˉshape, Result
                );
                if Result.Status != Compilerˉsourceˉwirˉstatus.Valid {
                    return Result;
                }
                Bindingˉphase = Compilerˉsourceˉwirˉbuildˉbindings(Input, Result);
            }
            if Statement.Kind == Sourceˉbodies.Compilerˉsourceˉstatementˉkind.While {
                Result = Compilerˉsourceˉwirˉcompileˉwhile(
                    Input, Scan, Symbols, Bindingˉphase, Source, Statement,
                    Returnˉshape, Result
                );
                if Result.Status != Compilerˉsourceˉwirˉstatus.Valid {
                    return Result;
                }
                Bindingˉphase = Compilerˉsourceˉwirˉbuildˉbindings(Input, Result);
            }
            if Statement.Kind ==
                    Sourceˉbodies.Compilerˉsourceˉstatementˉkind.Block ||
                Statement.Kind ==
                    Sourceˉbodies.Compilerˉsourceˉstatementˉkind.Unsafe {
                let Unsafeˉstatement: bool = Statement.Kind ==
                    Sourceˉbodies.Compilerˉsourceˉstatementˉkind.Unsafe;
                if Unsafeˉstatement && Result.Unsafeˉdepth >= 64u32 {
                    return Compilerˉsourceˉwirˉbuildˉfailure(
                        Result,
                        Compilerˉsourceˉwirˉstatus.Invalidˉvalueˉblock,
                        Result.Currentˉmodule,
                        Result.Currentˉmodule,
                        Result.Currentˉfunction,
                        Statement.Offset,
                        Statement.Line,
                        Statement.Column
                    );
                }
                let Nestedˉposition: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
                    Source, Statement.Offset, Statement.Line, Statement.Column,
                    Statement.Firstˉblockˉoffset
                );
                var Nestedˉstart: Compilerˉsourceˉwirˉbuild = Result;
                if Unsafeˉstatement {
                    Nestedˉstart = Compilerˉsourceˉwirˉwithˉunsafeˉdepth(
                        Result, Result.Unsafeˉdepth + 1u32
                    );
                }
                let Nestedˉcompiled: Compilerˉsourceˉwirˉbuild = Compilerˉsourceˉwirˉcompileˉblock(
                    Input, Scan, Symbols,
                    Bindingˉphase,
                    Source,
                    Statement.Firstˉblockˉoffset,
                    Nestedˉposition.Line, Nestedˉposition.Column,
                    Statement.Firstˉblockˉoffset + Statement.Firstˉblockˉlength,
                    Statement.Firstˉblockˉoffset + Statement.Firstˉblockˉlength,
                    Returnˉshape,
                    Continueˉtarget,
                    Breakˉtarget,
                    Loopˉscopeˉoffset,
                    Nestedˉstart
                );
                if Nestedˉcompiled.Status != Compilerˉsourceˉwirˉstatus.Valid {
                    return Compilerˉsourceˉwirˉwithˉunsafeˉdepth(
                        Nestedˉcompiled, Result.Unsafeˉdepth
                    );
                }
                Result = Compilerˉsourceˉwirˉwithˉunsafeˉdepth(
                    Nestedˉcompiled, Result.Unsafeˉdepth
                );
                Bindingˉphase =
                    Compilerˉsourceˉwirˉbuildˉbindings(Input, Result);
            }
            Cursor = Statement.Nextˉoffset;
            Currentˉline = Statement.Nextˉline;
            Currentˉcolumn = Statement.Nextˉcolumn;
        }
    }
    return Result;
}

fn Compilerˉsourceˉwirˉbindˉfunctionˉparameters(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Bindings: Sourceˉbindings.Compilerˉsourceˉbindingˉphase,
    Module: u32,
    Function: u32,
    Source: bytes,
    Declaration: Sourceˉdeclarations.Compilerˉsourceˉdeclaration,
    Declarationˉline: u32,
    Declarationˉcolumn: u32,
    Build: Compilerˉsourceˉwirˉbuild
) -> Compilerˉsourceˉwirˉbuild {
    let Generic: Sourceˉsymbols.Compilerˉsourceˉfunctionˉgeneric =
        Sourceˉsymbols.Compilerˉsourceˉsymbolsˉfunctionˉgeneric(
            Source, Declaration, Declarationˉline, Declarationˉcolumn
        );
    if Generic.Parameters > 0u32 {
        let Concrete: Sourceˉbindings.Compilerˉsourceˉbindingˉphase =
            Sourceˉbindings.Compilerˉsourceˉbindingsˉphaseˉparametersˉconcrete(
                Input, Scan, Symbols, Module, Function, Source,
                Declaration, Declarationˉline, Declarationˉcolumn,
                Compilerˉsourceˉwirˉgenericˉcatalog(Build.Genericˉevidence),
                Build.Genericˉinstance,
                Compilerˉsourceˉwirˉgenericˉtypeˉcatalog(
                    Build.Genericˉevidence
                ),
                Bindings
            );
        if Concrete.Buildˉstatus !=
                Sourceˉbindings.Compilerˉsourceˉbindingˉstatus.Valid {
            return Compilerˉsourceˉwirˉbuildˉfailure(
                Build, Compilerˉsourceˉwirˉstatus.Sourceˉbindings,
                Concrete.Buildˉfailureˉmodule,
                Compilerˉsourceˉwirˉbindingˉfailureˉrelated(
                    Concrete.Buildˉstatus,
                    Concrete.Buildˉfailureˉrelatedˉmodule
                ),
                Concrete.Buildˉfailureˉfunction,
                Concrete.Buildˉfailureˉoffset,
                Concrete.Buildˉfailureˉline,
                Concrete.Buildˉfailureˉcolumn
            );
        }
        return Compilerˉsourceˉwirˉfusedˉfrom(Build, Concrete);
    }
    var Phase: Sourceˉbindings.Compilerˉsourceˉbindingˉphase =
        Sourceˉbindings.Compilerˉsourceˉbindingsˉphaseˉbuild(
            Bindings,
            Sourceˉbindings.Compilerˉsourceˉbindingsˉbuildˉresetˉslots(
                Sourceˉbindings.Compilerˉsourceˉbindingsˉphaseˉbuildˉvalue(
                    Bindings
                )
            )
        );
    let Left: Sourceˉlexer.Compilerˉsourceˉtoken =
        Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Source, Generic.Signatureˉoffset,
            Generic.Signatureˉline, Generic.Signatureˉcolumn
        );
    var Cursor: u32 = Left.Nextˉoffset;
    var Currentˉline: u32 = Left.Nextˉline;
    var Currentˉcolumn: u32 = Left.Nextˉcolumn;
    var Result: Compilerˉsourceˉwirˉbuild = Build;
    var Index: u32 = 0u32;
    while Index < Declaration.Items {
        let Parameter: Sourceˉlexer.Compilerˉsourceˉtoken =
            Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                Source, Cursor, Currentˉline, Currentˉcolumn
            );
        let Colon: Sourceˉlexer.Compilerˉsourceˉtoken =
            Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                Source, Parameter.Nextˉoffset,
                Parameter.Nextˉline, Parameter.Nextˉcolumn
            );
        let Parameterˉtype: Sourceˉlexer.Compilerˉsourceˉtoken =
            Sourceˉdeclarations.Compilerˉsourceˉparameterˉtypeˉstart(
                Source, Colon.Nextˉoffset, Colon.Nextˉline,
                Colon.Nextˉcolumn
            );
        let Type: Compilerˉsourceˉwirˉgenericˉtypeˉscan =
            Compilerˉsourceˉwirˉscanˉgenericˉtype(
                Input, Scan, Symbols, Module, Source,
                Parameterˉtype.Offset,
                Parameterˉtype.Line, Parameterˉtype.Column,
                false,
                Compilerˉsourceˉwirˉgenericˉtypeˉcatalog(
                    Result.Genericˉevidence
                )
            );
        if Type.Status !=
                Sourceˉsymbols.Compilerˉsourceˉsymbolˉstatus.Valid {
            return Compilerˉsourceˉwirˉbuildˉfailure(
                Result, Compilerˉsourceˉwirˉstatus.Genericˉresolution,
                Module, Module, Function,
                Type.Failureˉoffset, Type.Failureˉline, Type.Failureˉcolumn
            );
        }
        Result = Compilerˉsourceˉwirˉwithˉgenericˉtypeˉevidence(
            Result, Type.Evidence
        );
        let Parameterˉbuild: Sourceˉbindings.Compilerˉsourceˉbindingˉbuild =
            Sourceˉbindings.Compilerˉsourceˉbindingsˉappendˉparameter(
                Module, Function, Parameter,
                Declaration.Bodyˉoffset, Declaration.Bodyˉlength,
                Type.Shape,
                Sourceˉbindings.Compilerˉsourceˉbindingsˉphaseˉbuildˉvalue(
                    Phase
                )
            );
        Phase = Sourceˉbindings.Compilerˉsourceˉbindingsˉphaseˉbuild(
            Phase, Parameterˉbuild
        );
        if Phase.Buildˉstatus !=
                Sourceˉbindings.Compilerˉsourceˉbindingˉstatus.Valid {
            return Compilerˉsourceˉwirˉbuildˉfailure(
                Result, Compilerˉsourceˉwirˉstatus.Sourceˉbindings,
                Phase.Buildˉfailureˉmodule,
                Compilerˉsourceˉwirˉbindingˉfailureˉrelated(
                    Phase.Buildˉstatus,
                    Phase.Buildˉfailureˉrelatedˉmodule
                ),
                Phase.Buildˉfailureˉfunction,
                Phase.Buildˉfailureˉoffset,
                Phase.Buildˉfailureˉline,
                Phase.Buildˉfailureˉcolumn
            );
        }
        let Separator: Sourceˉlexer.Compilerˉsourceˉtoken =
            Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                Source, Type.Nextˉoffset, Type.Nextˉline, Type.Nextˉcolumn
            );
        if Separator.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Comma {
            Cursor = Separator.Nextˉoffset;
            Currentˉline = Separator.Nextˉline;
            Currentˉcolumn = Separator.Nextˉcolumn;
        } else {
            Cursor = Separator.Offset;
            Currentˉline = Separator.Line;
            Currentˉcolumn = Separator.Column;
        }
        Index = Index + 1u32;
    }
    return Compilerˉsourceˉwirˉfusedˉfrom(Result, Phase);
}

fn Compilerˉsourceˉwirˉcompileˉfunctionˉlocal(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Bindings: Sourceˉbindings.Compilerˉsourceˉbindingˉphase,
    Module: u32,
    Function: u32,
    Source: bytes,
    Declaration: Sourceˉdeclarations.Compilerˉsourceˉdeclaration,
    Declarationˉline: u32,
    Declarationˉcolumn: u32,
    Build: Compilerˉsourceˉwirˉbuild
) -> Compilerˉsourceˉwirˉbuild {
    let Genericˉcatalog: Sourceˉgenerics.Compilerˉsourceˉgenericˉcatalog =
        Compilerˉsourceˉwirˉgenericˉcatalog(
            Build.Genericˉevidence
        );
    let Parameterˉbuild: Compilerˉsourceˉwirˉbuild =
        Compilerˉsourceˉwirˉbindˉfunctionˉparameters(
            Input, Scan, Symbols, Bindings,
            Module, Function, Source, Declaration,
            Declarationˉline, Declarationˉcolumn, Build
        );
    if Parameterˉbuild.Status != Compilerˉsourceˉwirˉstatus.Valid {
        return Parameterˉbuild;
    }
    var Bindingˉphase: Sourceˉbindings.Compilerˉsourceˉbindingˉphase =
        Compilerˉsourceˉwirˉbuildˉbindings(Input, Parameterˉbuild);
    var Result: Compilerˉsourceˉwirˉbuild = Compilerˉsourceˉwirˉstartˉfunction(
        Compilerˉsourceˉwirˉfusedˉfrom(Parameterˉbuild, Bindingˉphase),
        Module,
        Function
    );
    if Result.Status != Compilerˉsourceˉwirˉstatus.Valid {
        return Result;
    }
    let Signature: Compilerˉsourceˉwirˉsignature =
        Compilerˉsourceˉwirˉfunctionˉsignatureˉconcrete(
            Input, Scan, Symbols, Module, Source,
            Declaration.Declarationˉoffset,
            Compilerˉsourceˉwirˉsentinel(),
            Genericˉcatalog,
            Compilerˉsourceˉwirˉgenericˉtypeˉcatalog(
                Result.Genericˉevidence
            ),
            Result.Genericˉinstance
    );
    if Signature.Returnˉmode !=
            Sourceˉdeclarations.COMPILER_SOURCE_BORROW_MODE_VALUE {
        return Compilerˉsourceˉwirˉbuildˉfailure(
            Result, Compilerˉsourceˉwirˉstatus.Invalidˉborrow,
            Module, Module, Function,
            Declaration.Declarationˉoffset,
            Declarationˉline, Declarationˉcolumn
        );
    }
    let Bodyˉposition: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
        Source,
        Declaration.Declarationˉoffset,
        Declarationˉline,
        Declarationˉcolumn,
        Declaration.Bodyˉoffset
    );
    Result = Compilerˉsourceˉwirˉcompileˉblock(
        Input, Scan, Symbols,
        Bindingˉphase,
        Source,
        Declaration.Bodyˉoffset,
        Bodyˉposition.Line,
        Bodyˉposition.Column,
        Declaration.Bodyˉoffset + Declaration.Bodyˉlength,
        Declaration.Bodyˉoffset + Declaration.Bodyˉlength,
        Signature.Returnˉshape,
        Compilerˉsourceˉwirˉsentinel(),
        Compilerˉsourceˉwirˉsentinel(),
        Compilerˉsourceˉwirˉsentinel(),
        Result
    );
    if Result.Status != Compilerˉsourceˉwirˉstatus.Valid { return Result; }
    Bindingˉphase = Compilerˉsourceˉwirˉbuildˉbindings(Input, Result);
    if Result.Hasˉcurrentˉblock {
        if Signature.Returnˉshape == 9u32 {
            let Unitˉfallthrough: Compilerˉsourceˉwirˉvalue =
                Compilerˉsourceˉwirˉemit(
                    Result,
                    WIR_OPERATION_UNIT_CONSTANT,
                    9u32,
                    Compilerˉsourceˉwirˉempty(Source),
                    0u32,
                    0u32,
                    Declaration.Bodyˉoffset + Declaration.Bodyˉlength - 1u32,
                    1u32
                );
            Result = Compilerˉsourceˉwirˉcloseˉcurrentˉblock(
                Compilerˉsourceˉwirˉvalueˉbuild(Unitˉfallthrough),
                Compilerˉsourceˉwirˉterminator.Return,
                Unitˉfallthrough.Temporary,
                Compilerˉsourceˉwirˉsentinel(),
                Compilerˉsourceˉwirˉsentinel()
            );
        } else if Signature.Returnˉshape != 0u32 {
            let Failureˉoffset: u32 = Declaration.Bodyˉoffset + Declaration.Bodyˉlength - 1u32;
            let Failureˉposition: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
                Source,
                Declaration.Declarationˉoffset,
                Declarationˉline,
                Declarationˉcolumn,
                Failureˉoffset
            );
            return Compilerˉsourceˉwirˉfusedˉfrom(
                Compilerˉsourceˉwirˉbuildˉfailure(
                    Result,
                    Compilerˉsourceˉwirˉstatus.Missingˉreturn,
                    Module, Module, Function,
                    Failureˉoffset,
                    Failureˉposition.Line,
                    Failureˉposition.Column
                ),
                Bindingˉphase
            );
        } else {
            Result = Compilerˉsourceˉwirˉcloseˉcurrentˉblock(
                Result,
                Compilerˉsourceˉwirˉterminator.Return,
                Compilerˉsourceˉwirˉsentinel(),
                Compilerˉsourceˉwirˉsentinel(),
                Compilerˉsourceˉwirˉsentinel()
            );
        }
    }
    let Bindingˉbuild: Sourceˉbindings.Compilerˉsourceˉbindingˉbuild =
        Sourceˉbindings.Compilerˉsourceˉbindingsˉphaseˉbuildˉvalue(Bindingˉphase);
    let Completed: Compilerˉsourceˉwirˉbuild = Compilerˉsourceˉwirˉappendˉfunctionˉentry(
        Result,
        true,
        Bindingˉbuild.Parameters,
        Bindingˉbuild.Locals,
        Signature.Returnˉshape
    );
    if Completed.Status != Compilerˉsourceˉwirˉstatus.Valid {
        return Completed;
    }
    return Completed;
}

fn Compilerˉsourceˉwirˉcompileˉspecializations(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Firstˉinstance: u32,
    Build: Compilerˉsourceˉwirˉbuild
) -> Compilerˉsourceˉwirˉbuild {
    var Result: Compilerˉsourceˉwirˉbuild = Build;
    var Bindings: Sourceˉbindings.Compilerˉsourceˉbindingˉphase =
        Compilerˉsourceˉwirˉbuildˉbindings(Input, Build);
    let Catalog: Sourceˉgenerics.Compilerˉsourceˉgenericˉcatalog =
        Compilerˉsourceˉwirˉgenericˉcatalog(Build.Genericˉevidence);
    let Instances: u32 =
        Sourceˉgenerics.Compilerˉsourceˉgenericˉcatalogˉinstances(Catalog);
    let Symbolˉentries: u32 = Bytesˉreadˉu32ˉlittle(
        Symbols.Directory, 8u32
    );
    var Instance: u32 = Firstˉinstance;
    while Instance < Instances {
        let Declarationˉentry: u32 =
            Sourceˉgenerics.Compilerˉsourceˉgenericˉcatalogˉinstanceˉdeclaration(
                Catalog, Instance
            );
        let Symbolˉentry: u32 = 16u32 + Declarationˉentry * 24u32;
        let Module: u32 = Bytesˉreadˉu32ˉlittle(
            Symbols.Directory, Symbolˉentry
        );
        let Declarationˉoffset: u32 = Bytesˉreadˉu32ˉlittle(
            Symbols.Directory, Symbolˉentry + 8u32
        );
        let View: Sourceˉset.Compilerˉsourceˉsetˉview =
            Sourceˉset.Compilerˉsourceˉsetˉmodule(Input, Scan, Module);
        let Position: Sourceˉbodies.Compilerˉsourceˉposition =
            Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
                View.Source, 0u32, 1u32, 1u32, Declarationˉoffset
            );
        let Declaration: Sourceˉdeclarations.Compilerˉsourceˉdeclaration =
            Sourceˉdeclarations.Compilerˉparseˉnextˉdeclarationˉvalidated(
                View.Source, Declarationˉoffset,
                Position.Line, Position.Column, true
            );
        let Function: u32 = Result.Functionˉentries;
        if Function != Symbolˉentries + Instance ||
            Bytesˉreadˉu32ˉlittle(
                Symbols.Directory, Symbolˉentry + 4u32
            ) != 6u32 {
            return Compilerˉsourceˉwirˉbuildˉfailure(
                Result, Compilerˉsourceˉwirˉstatus.Invalidˉdirectory,
                Module, Module, Function,
                Declarationˉoffset, Position.Line, Position.Column
            );
        }
        let Functionˉlocal: Compilerˉsourceˉwirˉbuild =
            Compilerˉsourceˉwirˉcompileˉfunctionˉlocal(
                Input, Scan, Symbols,
                Sourceˉbindings.Compilerˉsourceˉbindingsˉphaseˉempty(Input),
                Module, Function, View.Source, Declaration,
                Position.Line, Position.Column,
                Compilerˉsourceˉwirˉwithˉgenericˉinstance(Result, Instance)
            );
        if Functionˉlocal.Status != Compilerˉsourceˉwirˉstatus.Valid {
            return Functionˉlocal;
        }
        let Functionˉresult: Compilerˉsourceˉwirˉbuild =
            Compilerˉsourceˉwirˉmergeˉfunction(Result, Functionˉlocal);
        if Functionˉresult.Status != Compilerˉsourceˉwirˉstatus.Valid {
            return Functionˉresult;
        }
        let Functionˉbindings:
            Sourceˉbindings.Compilerˉsourceˉbindingˉphase =
            Compilerˉsourceˉwirˉbuildˉbindings(Input, Functionˉlocal);
        Bindings = Sourceˉbindings.Compilerˉsourceˉbindingsˉphaseˉmerge(
            Bindings, Functionˉbindings
        );
        Result = Compilerˉsourceˉwirˉfusedˉfrom(
            Functionˉresult, Bindings
        );
        Instance = Instance + 1u32;
    }
    return Result;
}

fn Compilerˉsourceˉwirˉbindingˉrangeˉforˉfunction(
    Bindings: Sourceˉbindings.Compilerˉsourceˉbindingˉphase,
    Module: u32,
    Function: u32
) -> Compilerˉsourceˉwirˉbindingˉrange {
    if Bindings.Buildˉstatus !=
            Sourceˉbindings.Compilerˉsourceˉbindingˉstatus.Valid ||
        Bindings.Bodyˉstatus !=
            Sourceˉbindings.Compilerˉsourceˉbindingˉstatus.Valid ||
        Bindings.Entries > 116508u32 ||
        Bytesˉlength(Bindings.Payload) != Bindings.Entries * 36u32 {
        return Compilerˉsourceˉwirˉbindingˉrange(false, 0u32, 0u32);
    }
    var First: u32 = Compilerˉsourceˉwirˉsentinel();
    var Count: u32 = 0u32;
    var Closed: bool = false;
    var Entry: u32 = 0u32;
    while Entry < Bindings.Entries {
        let Cursor: u32 = Entry * 36u32;
        let Matches: bool = Bytesˉreadˉu32ˉlittle(
                Bindings.Payload, Cursor
            ) == Module &&
            Bytesˉreadˉu32ˉlittle(
                Bindings.Payload, Cursor + 4u32
            ) == Function;
        if Matches {
            if Closed {
                return Compilerˉsourceˉwirˉbindingˉrange(
                    false, 0u32, 0u32
                );
            }
            if First == Compilerˉsourceˉwirˉsentinel() { First = Entry; }
            Count = Count + 1u32;
        } else if First != Compilerˉsourceˉwirˉsentinel() {
            Closed = true;
        }
        Entry = Entry + 1u32;
    }
    return Compilerˉsourceˉwirˉbindingˉrange(
        First != Compilerˉsourceˉwirˉsentinel() && Count > 0u32,
        First, Count
    );
}

fn Compilerˉsourceˉwirˉclosureˉbindingˉprefix(
    Input: bytes,
    Phase: Sourceˉbindings.Compilerˉsourceˉbindingˉphase,
    Captures: u32,
    Parameters: u32
) -> Sourceˉbindings.Compilerˉsourceˉbindingˉphase {
    let Entries: u32 = Captures + Parameters;
    if Captures > 64u32 || Parameters > 64u32 || Entries > 64u32 ||
        Phase.Buildˉstatus !=
            Sourceˉbindings.Compilerˉsourceˉbindingˉstatus.Valid ||
        Phase.Bodyˉstatus !=
            Sourceˉbindings.Compilerˉsourceˉbindingˉstatus.Valid ||
        Entries > Phase.Entries ||
        Entries * 36u32 > Bytesˉlength(Phase.Payload) {
        return Sourceˉbindings.Compilerˉsourceˉbindingsˉphaseˉempty(Input);
    }
    let Build: Sourceˉbindings.Compilerˉsourceˉbindingˉbuild =
        Sourceˉbindings.Compilerˉsourceˉbindingˉbuild(
            Sourceˉbindings.Compilerˉsourceˉbindingˉstatus.Valid,
            Bytesˉslice(Phase.Payload, 0u32, Entries * 36u32),
            Entries, Parameters, Captures, Entries,
            0u32, 0u32, 0u32, 0u32, 0u32, 0u32
        );
    return Sourceˉbindings.Compilerˉsourceˉbindingsˉphaseˉfrom(
        Build, Sourceˉbindings.Compilerˉsourceˉbindingsˉbodyˉempty()
    );
}

fn Compilerˉsourceˉwirˉclosureˉbindingˉfailure(
    Build: Compilerˉsourceˉwirˉbuild,
    Phase: Sourceˉbindings.Compilerˉsourceˉbindingˉphase
) -> Compilerˉsourceˉwirˉbuild {
    if Phase.Buildˉstatus !=
            Sourceˉbindings.Compilerˉsourceˉbindingˉstatus.Valid {
        return Compilerˉsourceˉwirˉbuildˉfailure(
            Build, Compilerˉsourceˉwirˉstatus.Sourceˉbindings,
            Phase.Buildˉfailureˉmodule,
            Compilerˉsourceˉwirˉbindingˉfailureˉrelated(
                Phase.Buildˉstatus, Phase.Buildˉfailureˉrelatedˉmodule
            ),
            Phase.Buildˉfailureˉfunction,
            Phase.Buildˉfailureˉoffset,
            Phase.Buildˉfailureˉline,
            Phase.Buildˉfailureˉcolumn
        );
    }
    return Compilerˉsourceˉwirˉbuildˉfailure(
        Build, Compilerˉsourceˉwirˉstatus.Sourceˉbindings,
        Phase.Bodyˉfailureˉmodule,
        Compilerˉsourceˉwirˉbindingˉfailureˉrelated(
            Phase.Bodyˉstatus, Phase.Bodyˉfailureˉrelatedˉmodule
        ),
        Phase.Bodyˉfailureˉfunction,
        Phase.Bodyˉfailureˉoffset,
        Phase.Bodyˉfailureˉline,
        Phase.Bodyˉfailureˉcolumn
    );
}

fn Compilerˉsourceˉwirˉcompileˉclosureˉinstance(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Bindings: Sourceˉbindings.Compilerˉsourceˉbindingˉphase,
    Instance: u32,
    Build: Compilerˉsourceˉwirˉbuild
) -> Compilerˉsourceˉwirˉbuild {
    let Catalog: Closureˉlowering.Compilerˉsourceˉclosureˉcatalog =
        Compilerˉsourceˉwirˉclosureˉcatalog(Build);
    let Genericˉinstances: u32 =
        Sourceˉgenerics.Compilerˉsourceˉgenericˉcatalogˉinstances(
            Compilerˉsourceˉwirˉgenericˉcatalog(Build.Genericˉevidence)
        );
    let Baseˉfunctions: u32 =
        Compilerˉsourceˉwirˉsymbolˉentries(Symbols) + Genericˉinstances;
    let Function: u32 =
        Closureˉlowering.Compilerˉsourceˉclosureˉcatalogˉtarget(
            Baseˉfunctions, Instance
        );
    let Module: u32 =
        Closureˉlowering.Compilerˉsourceˉclosureˉcatalogˉmodule(
            Catalog, Instance
        );
    let Parent: u32 =
        Closureˉlowering.Compilerˉsourceˉclosureˉcatalogˉparentˉfunction(
            Catalog, Instance
        );
    let Offset: u32 =
        Closureˉlowering.Compilerˉsourceˉclosureˉcatalogˉoffset(
            Catalog, Instance
        );
    let Length: u32 =
        Closureˉlowering.Compilerˉsourceˉclosureˉcatalogˉlength(
            Catalog, Instance
        );
    let Functionˉtype: u32 =
        Closureˉlowering.Compilerˉsourceˉclosureˉcatalogˉfunctionˉtype(
            Catalog, Instance
        );
    let Captureˉcount: u32 =
        Closureˉlowering.Compilerˉsourceˉclosureˉcatalogˉcaptures(
            Catalog, Instance
        );
    if !Closureˉlowering.Compilerˉsourceˉclosureˉcatalogˉisˉvalid(
            Catalog
        ) ||
        Function == Compilerˉsourceˉwirˉsentinel() ||
        Function != Build.Functionˉentries || Module >= Scan.Modules ||
        Parent >= Function || Length == 0u32 {
        return Compilerˉsourceˉwirˉbuildˉfailure(
            Build, Compilerˉsourceˉwirˉstatus.Invalidˉdirectory,
            Module, Module, Function, Offset, 1u32, 1u32
        );
    }
    let View: Sourceˉset.Compilerˉsourceˉsetˉview =
        Sourceˉset.Compilerˉsourceˉsetˉmodule(Input, Scan, Module);
    if View.Status != Sourceˉset.Compilerˉsourceˉsetˉstatus.Valid ||
        Offset > Bytesˉlength(View.Source) ||
        Length > Bytesˉlength(View.Source) - Offset {
        return Compilerˉsourceˉwirˉbuildˉfailure(
            Build, Compilerˉsourceˉwirˉstatus.Invalidˉdirectory,
            Module, Module, Function, Offset, 1u32, 1u32
        );
    }
    let Position: Sourceˉbodies.Compilerˉsourceˉposition =
        Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
            View.Source, 0u32, 1u32, 1u32, Offset
        );
    let Expression: Sourceˉbodies.Compilerˉsourceˉexpression =
        Sourceˉbodies.Compilerˉparseˉexpressionˉvalidated(
            View.Source, Offset, Position.Line, Position.Column,
            Offset + Length, 0u32, 0u32
        );
    let Parentˉrange: Compilerˉsourceˉwirˉbindingˉrange =
        Compilerˉsourceˉwirˉbindingˉrangeˉforˉfunction(
            Bindings, Module, Parent
        );
    if Expression.Status != Sourceˉbodies.Compilerˉbodyˉparseˉstatus.Valid ||
        Expression.Kind != Sourceˉbodies.Compilerˉsourceˉexpressionˉkind.Closure ||
        Expression.Offset != Offset || Expression.Length != Length ||
        Expression.Secondˉlength == 0u32 || !Parentˉrange.Valid {
        return Compilerˉsourceˉwirˉbuildˉfailure(
            Build, Compilerˉsourceˉwirˉstatus.Invalidˉcallable,
            Module, Module, Function,
            Offset, Position.Line, Position.Column
        );
    }
    let Captures: Closureˉcaptures.Compilerˉsourceˉclosureˉcaptureˉsummary =
        Compilerˉsourceˉwirˉclosureˉcapturesˉvalidateˉresolved(
            Input, Scan, Symbols,
            Bindings.Payload, Parentˉrange.First, Parentˉrange.Entries,
            Module, Parent, View.Source, Expression
        );
    let Functionˉtypes: Compilerˉsourceˉwirˉfunctionˉtypeˉcatalog =
        Compilerˉsourceˉwirˉfunctionˉtypeˉcatalogˉfromˉgeneric(
            Build.Genericˉevidence
        );
    let Publicˉparameters: u32 =
        Compilerˉsourceˉwirˉfunctionˉtypeˉparameters(
            Functionˉtypes, Functionˉtype
        );
    let Returnˉshape: u32 =
        Compilerˉsourceˉwirˉfunctionˉtypeˉresultˉshape(
            Functionˉtypes, Functionˉtype
        );
    let Functionˉflags: u32 =
        Compilerˉsourceˉwirˉfunctionˉtypeˉflags(
            Functionˉtypes, Functionˉtype
        );
    let Functionˉlanguageˉeffects: u32 =
        Compilerˉsourceˉwirˉfunctionˉtypeˉlanguageˉeffects(
            Functionˉtypes, Functionˉtype
        );
    let Functionˉcapabilityˉeffects: u32 =
        Compilerˉsourceˉwirˉfunctionˉtypeˉcapabilityˉeffects(
            Functionˉtypes, Functionˉtype
        );
    if !Compilerˉsourceˉwirˉfunctionˉtypeˉcatalogˉisˉvalid(
            Functionˉtypes
        ) ||
        Functionˉtype >=
            Compilerˉsourceˉwirˉfunctionˉtypeˉcatalogˉinstances(
                Functionˉtypes
            ) ||
        Captures.Status !=
            Closureˉcaptures.Compilerˉsourceˉclosureˉcaptureˉstatus.Valid ||
        Captures.Effectˉstatus !=
            Closureˉcaptures.Compilerˉsourceˉclosureˉcaptureˉeffectˉstatus.Valid ||
        Captures.Captures != Captureˉcount ||
        Captures.Parameters != Publicˉparameters ||
        (Expression.Booleanˉvalue && (Functionˉflags & 1u32) == 0u32) ||
        (!Expression.Booleanˉvalue && (Functionˉflags & 1u32) != 0u32) ||
        (Functionˉflags & 2u32) != 0u32 ||
        Captures.Languageˉeffects != Functionˉlanguageˉeffects ||
        Captures.Capabilityˉeffects != Functionˉcapabilityˉeffects ||
        Captureˉcount > 64u32 - Publicˉparameters ||
        Returnˉshape == 0u32 {
        return Compilerˉsourceˉwirˉbuildˉfailure(
            Build, Compilerˉsourceˉwirˉstatus.Invalidˉcallable,
            Module, Module, Function,
            Offset, Position.Line, Position.Column
        );
    }
    var Capture: u32 = 0u32;
    while Capture < Captureˉcount {
        if Closureˉcaptures.Compilerˉsourceˉclosureˉcaptureˉmodeˉat(
                Captures, Capture
            ) > 2u32 ||
            !Compilerˉsourceˉwirˉclosureˉcaptureˉshapeˉisˉplain(
                Closureˉcaptures.Compilerˉsourceˉclosureˉcaptureˉshapeˉat(
                    Captures, Capture
                )
            ) {
            return Compilerˉsourceˉwirˉbuildˉfailure(
                Build, Compilerˉsourceˉwirˉstatus.Invalidˉcallable,
                Module, Module, Function,
                Offset, Position.Line, Position.Column
            );
        }
        Capture = Capture + 1u32;
    }
    let Completeˉphase: Sourceˉbindings.Compilerˉsourceˉbindingˉphase =
        Closureˉcaptures.Compilerˉsourceˉclosureˉcapturesˉphase(
            Input, Scan, Symbols, Module, Function,
            View.Source, Expression, Captures
        );
    if Completeˉphase.Buildˉstatus !=
            Sourceˉbindings.Compilerˉsourceˉbindingˉstatus.Valid ||
        Completeˉphase.Bodyˉstatus !=
            Sourceˉbindings.Compilerˉsourceˉbindingˉstatus.Valid {
        return Compilerˉsourceˉwirˉclosureˉbindingˉfailure(
            Build, Completeˉphase
        );
    }
    var Bindingˉphase: Sourceˉbindings.Compilerˉsourceˉbindingˉphase =
        Compilerˉsourceˉwirˉclosureˉbindingˉprefix(
            Input, Completeˉphase, Captureˉcount, Publicˉparameters
        );
    if Bindingˉphase.Entries != Captureˉcount + Publicˉparameters {
        return Compilerˉsourceˉwirˉbuildˉfailure(
            Build, Compilerˉsourceˉwirˉstatus.Invalidˉdirectory,
            Module, Module, Function,
            Offset, Position.Line, Position.Column
        );
    }
    var Result: Compilerˉsourceˉwirˉbuild =
        Compilerˉsourceˉwirˉstartˉfunction(
            Compilerˉsourceˉwirˉfusedˉfrom(
                Compilerˉsourceˉwirˉwithˉgenericˉinstance(
                    Build, Compilerˉsourceˉwirˉsentinel()
                ),
                Bindingˉphase
            ),
            Module, Function
        );
    let Bodyˉposition: Sourceˉbodies.Compilerˉsourceˉposition =
        Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
            View.Source, Expression.Offset, Expression.Line, Expression.Column,
            Expression.Secondˉoffset
        );
    Result = Compilerˉsourceˉwirˉcompileˉblock(
        Input, Scan, Symbols, Bindingˉphase, View.Source,
        Expression.Secondˉoffset, Bodyˉposition.Line, Bodyˉposition.Column,
        Expression.Secondˉoffset + Expression.Secondˉlength,
        Expression.Secondˉoffset + Expression.Secondˉlength,
        Returnˉshape,
        Compilerˉsourceˉwirˉsentinel(),
        Compilerˉsourceˉwirˉsentinel(),
        Compilerˉsourceˉwirˉsentinel(),
        Result
    );
    if Result.Status != Compilerˉsourceˉwirˉstatus.Valid { return Result; }
    Bindingˉphase = Compilerˉsourceˉwirˉbuildˉbindings(Input, Result);
    let Bodyˉend: u32 = Expression.Secondˉoffset + Expression.Secondˉlength;
    if Result.Hasˉcurrentˉblock {
        if Returnˉshape == 9u32 {
            let Unitˉfallthrough: Compilerˉsourceˉwirˉvalue =
                Compilerˉsourceˉwirˉemit(
                    Result, WIR_OPERATION_UNIT_CONSTANT, 9u32,
                    Compilerˉsourceˉwirˉempty(View.Source),
                    0u32, 0u32, Bodyˉend - 1u32, 1u32
                );
            Result = Compilerˉsourceˉwirˉcloseˉcurrentˉblock(
                Compilerˉsourceˉwirˉvalueˉbuild(Unitˉfallthrough),
                Compilerˉsourceˉwirˉterminator.Return,
                Unitˉfallthrough.Temporary,
                Compilerˉsourceˉwirˉsentinel(),
                Compilerˉsourceˉwirˉsentinel()
            );
        } else {
            let Failureˉposition: Sourceˉbodies.Compilerˉsourceˉposition =
                Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
                    View.Source, Expression.Offset,
                    Expression.Line, Expression.Column, Bodyˉend - 1u32
                );
            return Compilerˉsourceˉwirˉbuildˉfailure(
                Result, Compilerˉsourceˉwirˉstatus.Missingˉreturn,
                Module, Module, Function, Bodyˉend - 1u32,
                Failureˉposition.Line, Failureˉposition.Column
            );
        }
    }
    let Bindingˉbuild: Sourceˉbindings.Compilerˉsourceˉbindingˉbuild =
        Sourceˉbindings.Compilerˉsourceˉbindingsˉphaseˉbuildˉvalue(
            Bindingˉphase
        );
    if Bindingˉbuild.Locals < Captureˉcount {
        return Compilerˉsourceˉwirˉbuildˉfailure(
            Result, Compilerˉsourceˉwirˉstatus.Invalidˉdirectory,
            Module, Module, Function,
            Offset, Position.Line, Position.Column
        );
    }
    let Completed: Compilerˉsourceˉwirˉbuild =
        Compilerˉsourceˉwirˉappendˉfunctionˉentry(
            Result, true,
            Captureˉcount + Publicˉparameters,
            Bindingˉbuild.Locals - Captureˉcount,
            Returnˉshape
        );
    if Completed.Status != Compilerˉsourceˉwirˉstatus.Valid {
        return Completed;
    }
    return Compilerˉsourceˉwirˉmergeˉfunction(Build, Completed);
}

fn Compilerˉsourceˉwirˉcompileˉclosures(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Build: Compilerˉsourceˉwirˉbuild
) -> Compilerˉsourceˉwirˉbuild {
    var Result: Compilerˉsourceˉwirˉbuild = Build;
    var Bindings: Sourceˉbindings.Compilerˉsourceˉbindingˉphase =
        Compilerˉsourceˉwirˉbuildˉbindings(Input, Build);
    let Startingˉgenericˉinstances: u32 =
        Sourceˉgenerics.Compilerˉsourceˉgenericˉcatalogˉinstances(
            Compilerˉsourceˉwirˉgenericˉcatalog(Build.Genericˉevidence)
        );
    var Instance: u32 = 0u32;
    var Reading: bool = true;
    while Reading {
        let Catalog: Closureˉlowering.Compilerˉsourceˉclosureˉcatalog =
            Compilerˉsourceˉwirˉclosureˉcatalog(Result);
        let Instances: u32 =
            Closureˉlowering.Compilerˉsourceˉclosureˉcatalogˉinstances(
                Catalog
            );
        if Instance >= Instances {
            Reading = false;
        } else {
            let Functionˉresult: Compilerˉsourceˉwirˉbuild =
                Compilerˉsourceˉwirˉcompileˉclosureˉinstance(
                    Input, Scan, Symbols, Bindings, Instance, Result
                );
            if Functionˉresult.Status != Compilerˉsourceˉwirˉstatus.Valid {
                return Functionˉresult;
            }
            let Currentˉgenericˉinstances: u32 =
                Sourceˉgenerics.Compilerˉsourceˉgenericˉcatalogˉinstances(
                    Compilerˉsourceˉwirˉgenericˉcatalog(
                        Functionˉresult.Genericˉevidence
                    )
                );
            if Currentˉgenericˉinstances > Startingˉgenericˉinstances {
                return Functionˉresult;
            }
            let Functionˉbindings:
                Sourceˉbindings.Compilerˉsourceˉbindingˉphase =
                Compilerˉsourceˉwirˉbuildˉbindings(
                    Input, Functionˉresult
                );
            Bindings = Sourceˉbindings.Compilerˉsourceˉbindingsˉphaseˉmerge(
                Bindings, Functionˉbindings
            );
            Result = Compilerˉsourceˉwirˉfusedˉfrom(
                Functionˉresult, Bindings
            );
            Instance = Instance + 1u32;
        }
    }
    return Result;
}

export fn Compilerˉsourceˉwirˉphase(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Genericˉevidence: bytes,
    Planning: bool
) -> Compilerˉsourceˉwirˉbuild {
    var Result: Compilerˉsourceˉwirˉbuild = Compilerˉsourceˉwirˉbuildˉempty(
        Input, Scan.Modules, Symbols.Functions, Genericˉevidence
    );
    var Bindings: Sourceˉbindings.Compilerˉsourceˉbindingˉphase =
        Sourceˉbindings.Compilerˉsourceˉbindingsˉphaseˉempty(Input);
    var Functionˉbatch: Compilerˉsourceˉwirˉbuild = Result;
    var Functionˉbatchˉbindings:
        Sourceˉbindings.Compilerˉsourceˉbindingˉphase =
        Sourceˉbindings.Compilerˉsourceˉbindingsˉphaseˉempty(Input);
    var Functionˉbatchˉentries: u32 = 0u32;
    var Module: u32 = 0u32;
    while Module < Scan.Modules {
        let View: Sourceˉset.Compilerˉsourceˉsetˉview = Sourceˉset.Compilerˉsourceˉsetˉmodule(Input, Scan, Module);
        let Header: Sourceˉdeclarations.Compilerˉsourceˉheader = Sourceˉdeclarations.Compilerˉparseˉheaderˉvalidated(View.Source);
        var Cursor: u32 = Header.Nextˉoffset;
        var Currentˉline: u32 = Header.Nextˉline;
        var Currentˉcolumn: u32 = Header.Nextˉcolumn;
        var Sawˉnonˉimport: bool = false;
        var Reading: bool = true;
        while Reading {
            let Declaration: Sourceˉdeclarations.Compilerˉsourceˉdeclaration = Sourceˉdeclarations.Compilerˉparseˉnextˉdeclarationˉvalidated(
                View.Source, Cursor, Currentˉline, Currentˉcolumn, Sawˉnonˉimport
            );
            if Declaration.Kind == Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.End {
                Reading = false;
            } else {
                if Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉisˉsymbol(Declaration) {
                    if Declaration.Kind == Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Function {
                        let Position: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
                            View.Source, Cursor, Currentˉline, Currentˉcolumn,
                            Declaration.Declarationˉoffset
                        );
                        let Function: u32 = Functionˉbatch.Functionˉentries;
                        let Generic: Sourceˉsymbols.Compilerˉsourceˉfunctionˉgeneric =
                            Sourceˉsymbols.Compilerˉsourceˉsymbolsˉfunctionˉgeneric(
                                View.Source, Declaration,
                                Position.Line, Position.Column
                            );
                        if Generic.Parameters > 0u32 {
                            if Functionˉbatchˉentries > 0u32 {
                                Result = Compilerˉsourceˉwirˉmergeˉfunction(
                                    Result, Functionˉbatch
                                );
                                if Result.Status !=
                                        Compilerˉsourceˉwirˉstatus.Valid {
                                    return Result;
                                }
                                Bindings = Sourceˉbindings.Compilerˉsourceˉbindingsˉphaseˉmerge(
                                    Bindings, Functionˉbatchˉbindings
                                );
                                Result = Compilerˉsourceˉwirˉfusedˉfrom(
                                    Result, Bindings
                                );
                                Functionˉbatchˉentries = 0u32;
                            }
                            Result = Compilerˉsourceˉwirˉappendˉfunctionˉentry(
                                Compilerˉsourceˉwirˉwithˉgenericˉinstance(
                                    Result, Compilerˉsourceˉwirˉsentinel()
                                ),
                                false, 0u32, 0u32, 0u32
                            );
                            Functionˉbatch = Result;
                            Functionˉbatchˉbindings =
                                Sourceˉbindings.Compilerˉsourceˉbindingsˉphaseˉempty(Input);
                        } else {
                            var Functionˉbuild: Compilerˉsourceˉwirˉbuild =
                                Compilerˉsourceˉwirˉwithˉgenericˉinstance(
                                    Functionˉbatch,
                                    Compilerˉsourceˉwirˉsentinel()
                                );
                            let Functionˉresult: Compilerˉsourceˉwirˉbuild =
                                Compilerˉsourceˉwirˉcompileˉfunctionˉlocal(
                                    Input, Scan, Symbols,
                                    Sourceˉbindings.Compilerˉsourceˉbindingsˉphaseˉempty(Input),
                                    Module, Function, View.Source, Declaration,
                                    Position.Line, Position.Column, Functionˉbuild
                                );
                            if Functionˉresult.Status != Compilerˉsourceˉwirˉstatus.Valid {
                                return Functionˉresult;
                            }
                            let Functionˉbindings: Sourceˉbindings.Compilerˉsourceˉbindingˉphase =
                                Compilerˉsourceˉwirˉbuildˉbindings(Input, Functionˉresult);
                            if Functionˉbatchˉentries == 0u32 {
                                Functionˉbatch = Functionˉresult;
                            } else {
                                Functionˉbatch = Compilerˉsourceˉwirˉmergeˉfunction(
                                    Functionˉbatch, Functionˉresult
                                );
                            }
                            if Functionˉbatch.Status !=
                                    Compilerˉsourceˉwirˉstatus.Valid {
                                return Functionˉbatch;
                            }
                            Functionˉbatchˉbindings =
                                Sourceˉbindings.Compilerˉsourceˉbindingsˉphaseˉmerge(
                                    Functionˉbatchˉbindings,
                                    Functionˉbindings
                                );
                            Functionˉbatchˉentries =
                                Functionˉbatchˉentries + 1u32;
                            if Functionˉbatchˉentries ==
                                    WIR_FUNCTION_PUBLICATION_BATCH_LIMIT {
                                Result = Compilerˉsourceˉwirˉmergeˉfunction(
                                    Result, Functionˉbatch
                                );
                                if Result.Status !=
                                        Compilerˉsourceˉwirˉstatus.Valid {
                                    return Result;
                                }
                                Bindings = Sourceˉbindings.Compilerˉsourceˉbindingsˉphaseˉmerge(
                                    Bindings, Functionˉbatchˉbindings
                                );
                                Result = Compilerˉsourceˉwirˉfusedˉfrom(
                                    Result, Bindings
                                );
                                Functionˉbatch = Result;
                                Functionˉbatchˉbindings =
                                    Sourceˉbindings.Compilerˉsourceˉbindingsˉphaseˉempty(Input);
                                Functionˉbatchˉentries = 0u32;
                            }
                        }
                    } else {
                        if Functionˉbatchˉentries > 0u32 {
                            Result = Compilerˉsourceˉwirˉmergeˉfunction(
                                Result, Functionˉbatch
                            );
                            if Result.Status !=
                                    Compilerˉsourceˉwirˉstatus.Valid {
                                return Result;
                            }
                            Bindings = Sourceˉbindings.Compilerˉsourceˉbindingsˉphaseˉmerge(
                                Bindings, Functionˉbatchˉbindings
                            );
                            Result = Compilerˉsourceˉwirˉfusedˉfrom(
                                Result, Bindings
                            );
                            Functionˉbatchˉentries = 0u32;
                        }
                        Result = Compilerˉsourceˉwirˉappendˉfunctionˉentry(
                            Result, false, 0u32, 0u32, 0u32
                        );
                        Functionˉbatch = Result;
                        Functionˉbatchˉbindings =
                            Sourceˉbindings.Compilerˉsourceˉbindingsˉphaseˉempty(Input);
                    }
                }
                if Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉclosesˉimports(Declaration) {
                    Sawˉnonˉimport = true;
                }
                Cursor = Declaration.Nextˉoffset;
                Currentˉline = Declaration.Nextˉline;
                Currentˉcolumn = Declaration.Nextˉcolumn;
            }
        }
        if Functionˉbatchˉentries > 0u32 {
            Result = Compilerˉsourceˉwirˉmergeˉfunction(
                Result, Functionˉbatch
            );
            if Result.Status != Compilerˉsourceˉwirˉstatus.Valid {
                return Result;
            }
            Bindings = Sourceˉbindings.Compilerˉsourceˉbindingsˉphaseˉmerge(
                Bindings, Functionˉbatchˉbindings
            );
            Result = Compilerˉsourceˉwirˉfusedˉfrom(Result, Bindings);
            Functionˉbatch = Result;
            Functionˉbatchˉbindings =
                Sourceˉbindings.Compilerˉsourceˉbindingsˉphaseˉempty(Input);
            Functionˉbatchˉentries = 0u32;
        }
        Module = Module + 1u32;
    }
    if !Planning {
        Result = Compilerˉsourceˉwirˉcompileˉspecializations(
            Input, Scan, Symbols, 0u32,
            Compilerˉsourceˉwirˉfusedˉfrom(Result, Bindings)
        );
        if Result.Status != Compilerˉsourceˉwirˉstatus.Valid { return Result; }
        Bindings = Compilerˉsourceˉwirˉbuildˉbindings(Input, Result);
    }
    let Currentˉgenericˉinstances: u32 =
        Sourceˉgenerics.Compilerˉsourceˉgenericˉcatalogˉinstances(
            Compilerˉsourceˉwirˉgenericˉcatalog(Result.Genericˉevidence)
        );
    if Result.Functionˉentries ==
            Compilerˉsourceˉwirˉsymbolˉentries(Symbols) +
                Currentˉgenericˉinstances {
        Result = Compilerˉsourceˉwirˉcompileˉclosures(
            Input, Scan, Symbols,
            Compilerˉsourceˉwirˉfusedˉfrom(Result, Bindings)
        );
        if Result.Status != Compilerˉsourceˉwirˉstatus.Valid { return Result; }
        Bindings = Compilerˉsourceˉwirˉbuildˉbindings(Input, Result);
    }
    return Compilerˉsourceˉwirˉfusedˉfrom(Result, Bindings);
}

export fn Compilerˉsourceˉwirˉheader(Build: Compilerˉsourceˉwirˉbuild) -> bytes {
    let Catalog: Sourceˉgenerics.Compilerˉsourceˉgenericˉcatalog =
        Compilerˉsourceˉwirˉgenericˉcatalog(Build.Genericˉevidence);
    let Instances: u32 =
        Sourceˉgenerics.Compilerˉsourceˉgenericˉcatalogˉinstances(Catalog);
    let Functionˉtypeˉcatalog:
        Compilerˉsourceˉwirˉfunctionˉtypeˉcatalog =
        Compilerˉsourceˉwirˉfunctionˉtypeˉcatalogˉfromˉgeneric(
            Build.Genericˉevidence
        );
    let Functionˉtypeˉinstances: u32 =
        Compilerˉsourceˉwirˉfunctionˉtypeˉcatalogˉinstances(
            Functionˉtypeˉcatalog
        );
    var Hasˉmemoryˉsplit: bool = false;
    var Hasˉvectorˉappend: bool = false;
    var Hasˉvectorˉgrow: bool = false;
    var Hasˉclosureˉenvironment: bool = false;
    var Hasˉtask: bool = false;
    var Hasˉunsafeˉscratch: bool = false;
    var Hasˉunsafeˉscratchˉlength: bool = false;
    var Hasˉunsafeˉwriteˉregion: bool = false;
    var Hasˉunsafeˉwriteˉpointer: bool = false;
    var Hasˉforeignˉcall: bool = false;
    let Operationˉpayload: bytes =
        Compilerˉsourceˉwirˉchunkedˉpayloadˉmaterialize(
            Build.Operationˉpayload, Build.Operationˉpending
        );
    var Operationˉindex: u32 = 0u32;
    while Operationˉindex < Build.Operations {
        let Headerˉoperation: u32 = Bytesˉreadˉu16ˉlittle(
            Operationˉpayload, Operationˉindex * 28u32 + 4u32
        );
        if Headerˉoperation == WIR_OPERATION_FOUNDATION_MEMORY_SPLIT ||
            Headerˉoperation == WIR_OPERATION_FOUNDATION_VECTOR_CONSTRUCT_RESERVED {
            Hasˉmemoryˉsplit = true;
        }
        if Headerˉoperation == WIR_OPERATION_FOUNDATION_VECTOR_APPEND {
            Hasˉvectorˉappend = true;
        }
        if Headerˉoperation == WIR_OPERATION_FOUNDATION_VECTOR_GROW_RESERVED {
            Hasˉvectorˉgrow = true;
        }
        if Headerˉoperation == WIR_OPERATION_CLOSURE_CREATE {
            Hasˉclosureˉenvironment = true;
        }
        if Headerˉoperation >= WIR_OPERATION_TASK_SCOPE_CONSTRUCT &&
            Headerˉoperation <= WIR_OPERATION_TASK_SCOPE_EXIT {
            Hasˉtask = true;
        }
        if Headerˉoperation ==
                WIR_OPERATION_FOUNDATION_UNSAFE_CONSTRUCT_SCRATCH {
            Hasˉunsafeˉscratch = true;
        }
        if Headerˉoperation ==
                WIR_OPERATION_FOUNDATION_UNSAFE_SCRATCH_LENGTH {
            Hasˉunsafeˉscratch = true;
            Hasˉunsafeˉscratchˉlength = true;
        }
        if Headerˉoperation ==
                WIR_OPERATION_FOUNDATION_UNSAFE_BORROW_WRITE_REGION {
            Hasˉunsafeˉscratch = true;
            Hasˉunsafeˉwriteˉregion = true;
        }
        if Headerˉoperation ==
                WIR_OPERATION_FOUNDATION_UNSAFE_WRITE_POINTER {
            Hasˉunsafeˉscratch = true;
            Hasˉunsafeˉwriteˉpointer = true;
        }
        if Headerˉoperation == WIR_OPERATION_CALL_FOREIGN {
            Hasˉforeignˉcall = true;
        }
        Operationˉindex = Operationˉindex + 1u32;
    }
    var Result: bytes = Textˉtoˉutf8("WVIR");
    Result = Bytesˉconcat(Result, Bytesˉfromˉu16ˉlittle(1u32));
    if Hasˉforeignˉcall && Instances > 0u32 {
        Result = Bytesˉconcat(Result, Bytesˉfromˉu16ˉlittle(32u32));
    } else if Hasˉforeignˉcall {
        Result = Bytesˉconcat(Result, Bytesˉfromˉu16ˉlittle(31u32));
    } else if Hasˉunsafeˉwriteˉpointer && Instances > 0u32 {
        Result = Bytesˉconcat(Result, Bytesˉfromˉu16ˉlittle(30u32));
    } else if Hasˉunsafeˉwriteˉpointer {
        Result = Bytesˉconcat(Result, Bytesˉfromˉu16ˉlittle(29u32));
    } else if Hasˉunsafeˉwriteˉregion && Instances > 0u32 {
        Result = Bytesˉconcat(Result, Bytesˉfromˉu16ˉlittle(28u32));
    } else if Hasˉunsafeˉwriteˉregion {
        Result = Bytesˉconcat(Result, Bytesˉfromˉu16ˉlittle(27u32));
    } else if Hasˉunsafeˉscratchˉlength && Instances > 0u32 {
        Result = Bytesˉconcat(Result, Bytesˉfromˉu16ˉlittle(26u32));
    } else if Hasˉunsafeˉscratchˉlength {
        Result = Bytesˉconcat(Result, Bytesˉfromˉu16ˉlittle(25u32));
    } else if Hasˉunsafeˉscratch && Instances > 0u32 {
        Result = Bytesˉconcat(Result, Bytesˉfromˉu16ˉlittle(24u32));
    } else if Hasˉunsafeˉscratch {
        Result = Bytesˉconcat(Result, Bytesˉfromˉu16ˉlittle(23u32));
    } else if Hasˉtask && Instances > 0u32 {
        Result = Bytesˉconcat(Result, Bytesˉfromˉu16ˉlittle(22u32));
    } else if Hasˉtask {
        Result = Bytesˉconcat(Result, Bytesˉfromˉu16ˉlittle(21u32));
    } else if Hasˉclosureˉenvironment && Instances > 0u32 {
        Result = Bytesˉconcat(Result, Bytesˉfromˉu16ˉlittle(20u32));
    } else if Hasˉclosureˉenvironment {
        Result = Bytesˉconcat(Result, Bytesˉfromˉu16ˉlittle(19u32));
    } else if Functionˉtypeˉinstances > 0u32 && Instances > 0u32 {
        Result = Bytesˉconcat(Result, Bytesˉfromˉu16ˉlittle(18u32));
    } else if Functionˉtypeˉinstances > 0u32 {
        Result = Bytesˉconcat(Result, Bytesˉfromˉu16ˉlittle(17u32));
    } else if Hasˉvectorˉgrow && Instances > 0u32 {
        Result = Bytesˉconcat(Result, Bytesˉfromˉu16ˉlittle(16u32));
    } else if Hasˉvectorˉgrow {
        Result = Bytesˉconcat(Result, Bytesˉfromˉu16ˉlittle(15u32));
    } else if Hasˉvectorˉappend && Instances > 0u32 {
        Result = Bytesˉconcat(Result, Bytesˉfromˉu16ˉlittle(14u32));
    } else if Hasˉvectorˉappend {
        Result = Bytesˉconcat(Result, Bytesˉfromˉu16ˉlittle(13u32));
    } else if Hasˉmemoryˉsplit && Instances > 0u32 {
        Result = Bytesˉconcat(Result, Bytesˉfromˉu16ˉlittle(12u32));
    } else if Hasˉmemoryˉsplit {
        Result = Bytesˉconcat(Result, Bytesˉfromˉu16ˉlittle(11u32));
    } else if Instances > 0u32 {
        Result = Bytesˉconcat(Result, Bytesˉfromˉu16ˉlittle(10u32));
    } else {
        Result = Bytesˉconcat(Result, Bytesˉfromˉu16ˉlittle(9u32));
    }
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Build.Functionˉentries));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(48u32));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Build.Blocks));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(28u32));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Build.Operations));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(28u32));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Build.Temporaries));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(4u32));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Build.Operands));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(4u32));
    if Instances > 0u32 {
        Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Instances));
        Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(1u32));
    }
    if Functionˉtypeˉinstances > 0u32 || Hasˉtask ||
        Hasˉunsafeˉscratch || Hasˉforeignˉcall {
        var Functionˉtypeˉbytes: u32 = 0u32;
        if Functionˉtypeˉinstances > 0u32 {
            Functionˉtypeˉbytes = Bytesˉlength(
                Functionˉtypeˉcatalog.Evidence
            );
        }
        Result = Bytesˉconcat(
            Result, Bytesˉfromˉu32ˉlittle(Functionˉtypeˉbytes)
        );
        Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(1u32));
    }
    return Result;
}

export fn Compilerˉsourceˉwirˉdirectory(Build: Compilerˉsourceˉwirˉbuild) -> bytes {
    var Result: bytes = Compilerˉsourceˉwirˉheader(Build);
    Result = Bytesˉconcat(Result, Build.Functionˉpayload);
    Result = Bytesˉconcat(Result, Build.Blockˉpayload);
    Result = Bytesˉconcat(
        Result,
        Compilerˉsourceˉwirˉchunkedˉpayloadˉmaterialize(
            Build.Operationˉpayload, Build.Operationˉpending
        )
    );
    Result = Bytesˉconcat(
        Result,
        Compilerˉsourceˉwirˉchunkedˉpayloadˉmaterialize(
            Build.Temporaryˉpayload, Build.Temporaryˉpending
        )
    );
    Result = Bytesˉconcat(
        Result,
        Compilerˉsourceˉwirˉchunkedˉpayloadˉmaterialize(
            Build.Operandˉpayload, Build.Operandˉpending
        )
    );
    let Functionˉtypeˉcatalog:
        Compilerˉsourceˉwirˉfunctionˉtypeˉcatalog =
        Compilerˉsourceˉwirˉfunctionˉtypeˉcatalogˉfromˉgeneric(
            Build.Genericˉevidence
        );
    if Compilerˉsourceˉwirˉfunctionˉtypeˉcatalogˉinstances(
            Functionˉtypeˉcatalog
        ) > 0u32 {
        Result = Bytesˉconcat(Result, Functionˉtypeˉcatalog.Evidence);
    }
    return Result;
}

fn Compilerˉsourceˉwirˉvariantˉcaseˉviewˉbyˉindex(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Typeˉcatalog: Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog,
    Nominal: u32,
    Case: u32
) -> Compilerˉsourceˉwirˉvariantˉcaseˉview {
    let Missing: Compilerˉsourceˉwirˉvariantˉcaseˉview =
        Compilerˉsourceˉwirˉvariantˉcaseˉview(
            false, Scan.Modules, 0u32, 0u32, 0u32, 1u32, 1u32
        );
    if Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉshapeˉisˉprivate(
            Nominal
        ) {
        let Instance: u32 =
            Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉshapeˉinstance(
                Nominal
            );
        let Layout: Genericˉlayouts.Compilerˉsourceˉgenericˉtypeˉlayout =
            Genericˉlayouts.Compilerˉsourceˉgenericˉtypeˉlayoutˉcreate(
                Input, Scan, Symbols, Typeˉcatalog, Instance
            );
        let Selected: Genericˉlayouts.Compilerˉsourceˉgenericˉtypeˉcase =
            Genericˉlayouts.Compilerˉsourceˉgenericˉtypeˉlayoutˉvariantˉcase(
                Input, Scan, Symbols, Layout, Case
            );
        if Layout.Shape == Nominal && Selected.Found &&
            Selected.Fields <= 64u32 {
            return Compilerˉsourceˉwirˉvariantˉcaseˉview(
                true, Layout.Module, Case, Selected.Fields,
                0u32, 1u32, 1u32
            );
        }
        return Missing;
    }
    let Directoryˉentry: u32 = Compilerˉsourceˉwirˉnominalˉdirectoryˉentry(
        Symbols, Nominal, 8u32
    );
    if Directoryˉentry == Compilerˉsourceˉwirˉsentinel() { return Missing; }
    let Variant: Sourceˉsymbols.Compilerˉsourceˉsymbolˉmatch =
        Sourceˉsymbols.Compilerˉsourceˉsymbolsˉdirectoryˉentry(
            Symbols.Directory, Scan.Modules, Directoryˉentry
        );
    let View: Sourceˉset.Compilerˉsourceˉsetˉview =
        Sourceˉset.Compilerˉsourceˉsetˉmodule(Input, Scan, Variant.Module);
    let Declarationˉposition: Sourceˉbodies.Compilerˉsourceˉposition =
        Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
            View.Source, 0u32, 1u32, 1u32, Variant.Declarationˉoffset
        );
    let Declaration: Sourceˉdeclarations.Compilerˉsourceˉdeclaration =
        Sourceˉdeclarations.Compilerˉparseˉnextˉdeclarationˉvalidated(
            View.Source, Variant.Declarationˉoffset,
            Declarationˉposition.Line, Declarationˉposition.Column, true
        );
    if Case >= Declaration.Items { return Missing; }
    let Bodyˉposition: Sourceˉbodies.Compilerˉsourceˉposition =
        Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
            View.Source, Variant.Declarationˉoffset,
            Declarationˉposition.Line, Declarationˉposition.Column,
            Declaration.Bodyˉoffset
        );
    let Left: Sourceˉlexer.Compilerˉsourceˉtoken =
        Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            View.Source, Declaration.Bodyˉoffset,
            Bodyˉposition.Line, Bodyˉposition.Column
        );
    var Cursor: u32 = Left.Nextˉoffset;
    var Line: u32 = Left.Nextˉline;
    var Column: u32 = Left.Nextˉcolumn;
    var Index: u32 = 0u32;
    while Index <= Case {
        let Caseˉname: Sourceˉlexer.Compilerˉsourceˉtoken =
            Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                View.Source, Cursor, Line, Column
            );
        let Afterˉname: Sourceˉlexer.Compilerˉsourceˉtoken =
            Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                View.Source, Caseˉname.Nextˉoffset,
                Caseˉname.Nextˉline, Caseˉname.Nextˉcolumn
            );
        var End: Sourceˉlexer.Compilerˉsourceˉtoken = Afterˉname;
        var Fields: u32 = 0u32;
        var Fieldsˉoffset: u32 = Afterˉname.Offset;
        var Fieldsˉline: u32 = Afterˉname.Line;
        var Fieldsˉcolumn: u32 = Afterˉname.Column;
        if Afterˉname.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Leftˉparenthesis {
            Fieldsˉoffset = Afterˉname.Nextˉoffset;
            Fieldsˉline = Afterˉname.Nextˉline;
            Fieldsˉcolumn = Afterˉname.Nextˉcolumn;
            var Fieldˉcursor: u32 = Fieldsˉoffset;
            var Fieldˉline: u32 = Fieldsˉline;
            var Fieldˉcolumn: u32 = Fieldsˉcolumn;
            var Readingˉfields: bool = true;
            while Readingˉfields {
                let Field: Sourceˉdeclarations.Compilerˉsourceˉvariantˉfield =
                    Sourceˉdeclarations.Compilerˉparseˉvariantˉfield(
                        View.Source, Fieldˉcursor, Fieldˉline, Fieldˉcolumn
                    );
                Fields = Fields + 1u32;
                let Separator: Sourceˉlexer.Compilerˉsourceˉtoken =
                    Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                        View.Source, Field.Nextˉoffset,
                        Field.Nextˉline, Field.Nextˉcolumn
                    );
                if Separator.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Comma {
                    let Viewˉafterˉcomma:
                        Sourceˉlexer.Compilerˉsourceˉtoken =
                        Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                            View.Source, Separator.Nextˉoffset,
                            Separator.Nextˉline, Separator.Nextˉcolumn
                        );
                    if Viewˉafterˉcomma.Kind ==
                        Sourceˉlexer.Compilerˉtokenˉkind.Rightˉparenthesis {
                        Readingˉfields = false;
                        End = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                            View.Source, Viewˉafterˉcomma.Nextˉoffset,
                            Viewˉafterˉcomma.Nextˉline,
                            Viewˉafterˉcomma.Nextˉcolumn
                        );
                    } else {
                        Fieldˉcursor = Separator.Nextˉoffset;
                        Fieldˉline = Separator.Nextˉline;
                        Fieldˉcolumn = Separator.Nextˉcolumn;
                    }
                } else {
                    Readingˉfields = false;
                    End = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                        View.Source, Separator.Nextˉoffset,
                        Separator.Nextˉline, Separator.Nextˉcolumn
                    );
                }
            }
        }
        if Index == Case {
            return Compilerˉsourceˉwirˉvariantˉcaseˉview(
                true, Variant.Module, Index, Fields,
                Fieldsˉoffset, Fieldsˉline, Fieldsˉcolumn
            );
        }
        Cursor = End.Nextˉoffset;
        Line = End.Nextˉline;
        Column = End.Nextˉcolumn;
        Index = Index + 1u32;
    }
    return Missing;
}

fn Compilerˉsourceˉwirˉvariantˉfieldˉbyˉindex(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Typeˉcatalog: Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog,
    Nominal: u32,
    Case: u32,
    Fieldˉindex: u32
) -> Compilerˉsourceˉwirˉmember {
    if Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉshapeˉisˉprivate(
            Nominal
        ) {
        let Instance: u32 =
            Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉshapeˉinstance(
                Nominal
            );
        let Layout: Genericˉlayouts.Compilerˉsourceˉgenericˉtypeˉlayout =
            Genericˉlayouts.Compilerˉsourceˉgenericˉtypeˉlayoutˉcreate(
                Input, Scan, Symbols, Typeˉcatalog, Instance
            );
        let Selected: Genericˉlayouts.Compilerˉsourceˉgenericˉtypeˉfield =
            Genericˉlayouts.Compilerˉsourceˉgenericˉtypeˉlayoutˉvariantˉfield(
                Input, Scan, Symbols, Layout, Case, Fieldˉindex
            );
        if Layout.Shape != Nominal || !Selected.Found {
            return Compilerˉsourceˉwirˉmember(false, 0u32, 0u32);
        }
        return Compilerˉsourceˉwirˉmember(
            true, Fieldˉindex, Selected.Shape
        );
    }
    let Caseˉview: Compilerˉsourceˉwirˉvariantˉcaseˉview =
        Compilerˉsourceˉwirˉvariantˉcaseˉviewˉbyˉindex(
            Input, Scan, Symbols, Typeˉcatalog, Nominal, Case
        );
    if !Caseˉview.Found || Fieldˉindex >= Caseˉview.Fields {
        return Compilerˉsourceˉwirˉmember(false, 0u32, 0u32);
    }
    let View: Sourceˉset.Compilerˉsourceˉsetˉview =
        Sourceˉset.Compilerˉsourceˉsetˉmodule(
            Input, Scan, Caseˉview.Module
        );
    var Cursor: u32 = Caseˉview.Fieldsˉoffset;
    var Line: u32 = Caseˉview.Fieldsˉline;
    var Column: u32 = Caseˉview.Fieldsˉcolumn;
    var Index: u32 = 0u32;
    while Index <= Fieldˉindex {
        let Field: Sourceˉdeclarations.Compilerˉsourceˉvariantˉfield =
            Sourceˉdeclarations.Compilerˉparseˉvariantˉfield(
                View.Source, Cursor, Line, Column
            );
        if Index == Fieldˉindex {
            let Typeˉposition: Sourceˉbodies.Compilerˉsourceˉposition =
                Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
                    View.Source, Cursor, Line, Column, Field.Typeˉoffset
                );
            let Type: Sourceˉsymbols.Compilerˉsourceˉtypeˉbinding =
                Sourceˉsymbols.Compilerˉsourceˉsymbolsˉbindˉtype(
                    Input, Scan, Symbols.Directory, Symbols.Lookup,
                    Symbols.Visibility, Caseˉview.Module, View.Source,
                    Field.Typeˉoffset, Typeˉposition.Line,
                    Typeˉposition.Column, Symbols.Records,
                    Symbols.Enums, false
                );
            return Compilerˉsourceˉwirˉmember(
                true, Index,
                Sourceˉbindings.Compilerˉsourceˉbindingsˉshape(Type)
            );
        }
        let Separator: Sourceˉlexer.Compilerˉsourceˉtoken =
            Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                View.Source, Field.Nextˉoffset,
                Field.Nextˉline, Field.Nextˉcolumn
            );
        Cursor = Separator.Nextˉoffset;
        Line = Separator.Nextˉline;
        Column = Separator.Nextˉcolumn;
        Index = Index + 1u32;
    }
    return Compilerˉsourceˉwirˉmember(false, 0u32, 0u32);
}

fn Compilerˉsourceˉwirˉvariantˉfieldˉbyˉname(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Typeˉcatalog: Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog,
    Nominal: u32,
    Case: u32,
    Queryˉsource: bytes,
    Queryˉoffset: u32,
    Queryˉlength: u32
) -> Compilerˉsourceˉwirˉmember {
    if Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉshapeˉisˉprivate(
            Nominal
        ) {
        let Instance: u32 =
            Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉshapeˉinstance(
                Nominal
            );
        let Layout: Genericˉlayouts.Compilerˉsourceˉgenericˉtypeˉlayout =
            Genericˉlayouts.Compilerˉsourceˉgenericˉtypeˉlayoutˉcreate(
                Input, Scan, Symbols, Typeˉcatalog, Instance
            );
        let Genericˉcaseˉview:
            Genericˉlayouts.Compilerˉsourceˉgenericˉtypeˉcase =
            Genericˉlayouts.Compilerˉsourceˉgenericˉtypeˉlayoutˉvariantˉcase(
                Input, Scan, Symbols, Layout, Case
            );
        if !Genericˉcaseˉview.Found || Genericˉcaseˉview.Fields > 64u32 {
            return Compilerˉsourceˉwirˉmember(false, 0u32, 0u32);
        }
        let Genericˉview: Sourceˉset.Compilerˉsourceˉsetˉview =
            Sourceˉset.Compilerˉsourceˉsetˉmodule(
                Input, Scan, Layout.Module
            );
        var Genericˉindex: u32 = 0u32;
        while Genericˉindex < Genericˉcaseˉview.Fields {
            let Genericˉfield:
                Genericˉlayouts.Compilerˉsourceˉgenericˉtypeˉfield =
                Genericˉlayouts.Compilerˉsourceˉgenericˉtypeˉlayoutˉvariantˉfield(
                    Input, Scan, Symbols, Layout, Case, Genericˉindex
                );
            if Genericˉfield.Found &&
                Genericˉfield.Nameˉlength == Queryˉlength &&
                Sourceˉset.Compilerˉsourceˉspansˉequal(
                    Genericˉview.Source,
                    Genericˉfield.Nameˉoffset, Genericˉfield.Nameˉlength,
                    Queryˉsource, Queryˉoffset, Queryˉlength
                ) {
                return Compilerˉsourceˉwirˉmember(
                    true, Genericˉindex, Genericˉfield.Shape
                );
            }
            Genericˉindex = Genericˉindex + 1u32;
        }
        return Compilerˉsourceˉwirˉmember(false, 0u32, 0u32);
    }
    let Caseˉview: Compilerˉsourceˉwirˉvariantˉcaseˉview =
        Compilerˉsourceˉwirˉvariantˉcaseˉviewˉbyˉindex(
            Input, Scan, Symbols, Typeˉcatalog, Nominal, Case
        );
    if !Caseˉview.Found {
        return Compilerˉsourceˉwirˉmember(false, 0u32, 0u32);
    }
    let View: Sourceˉset.Compilerˉsourceˉsetˉview =
        Sourceˉset.Compilerˉsourceˉsetˉmodule(
            Input, Scan, Caseˉview.Module
        );
    var Cursor: u32 = Caseˉview.Fieldsˉoffset;
    var Line: u32 = Caseˉview.Fieldsˉline;
    var Column: u32 = Caseˉview.Fieldsˉcolumn;
    var Index: u32 = 0u32;
    while Index < Caseˉview.Fields {
        let Name: Sourceˉlexer.Compilerˉsourceˉtoken =
            Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                View.Source, Cursor, Line, Column
            );
        let Field: Sourceˉdeclarations.Compilerˉsourceˉvariantˉfield =
            Sourceˉdeclarations.Compilerˉparseˉvariantˉfield(
                View.Source, Cursor, Line, Column
            );
        if Name.Length == Queryˉlength &&
            Sourceˉset.Compilerˉsourceˉspansˉequal(
                View.Source, Name.Offset, Name.Length,
                Queryˉsource, Queryˉoffset, Queryˉlength
            ) {
            let Typeˉposition: Sourceˉbodies.Compilerˉsourceˉposition =
                Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
                    View.Source, Cursor, Line, Column, Field.Typeˉoffset
                );
            let Type: Sourceˉsymbols.Compilerˉsourceˉtypeˉbinding =
                Sourceˉsymbols.Compilerˉsourceˉsymbolsˉbindˉtype(
                    Input, Scan, Symbols.Directory, Symbols.Lookup,
                    Symbols.Visibility, Caseˉview.Module, View.Source,
                    Field.Typeˉoffset, Typeˉposition.Line,
                    Typeˉposition.Column, Symbols.Records,
                    Symbols.Enums, false
                );
            return Compilerˉsourceˉwirˉmember(
                true, Index,
                Sourceˉbindings.Compilerˉsourceˉbindingsˉshape(Type)
            );
        }
        let Separator: Sourceˉlexer.Compilerˉsourceˉtoken =
            Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                View.Source, Field.Nextˉoffset,
                Field.Nextˉline, Field.Nextˉcolumn
            );
        Cursor = Separator.Nextˉoffset;
        Line = Separator.Nextˉline;
        Column = Separator.Nextˉcolumn;
        Index = Index + 1u32;
    }
    return Compilerˉsourceˉwirˉmember(false, 0u32, 0u32);
}

fn Compilerˉsourceˉwirˉvariantˉpatternˉisˉvalid(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Typeˉcatalog: Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog,
    Source: bytes,
    Case: Sourceˉbodies.Compilerˉsourceˉmatchˉcase,
    Nominal: u32,
    Caseˉindex: u32
) -> bool {
    let View: Compilerˉsourceˉwirˉvariantˉcaseˉview =
        Compilerˉsourceˉwirˉvariantˉcaseˉviewˉbyˉindex(
            Input, Scan, Symbols, Typeˉcatalog, Nominal, Caseˉindex
        );
    if !View.Found { return false; }
    if View.Fields == 0u32 { return Case.Bindingˉlength == 0u32; }
    if Case.Bindingˉlength == 0u32 { return false; }
    let Patternˉstart: Sourceˉlexer.Compilerˉsourceˉtoken =
        Sourceˉbodies.Compilerˉbodyˉtoken(
            Source, Case.Bindingˉoffset, 1u32, 1u32,
            Case.Bindingˉoffset + Case.Bindingˉlength
        );
    if Patternˉstart.Kind != Sourceˉlexer.Compilerˉtokenˉkind.Leftˉbrace {
        return View.Fields == 1u32;
    }
    let Seenˉresult: Byteˉconstruction.Foundationˉbytesˉresult =
        Byteˉconstruction.Foundationˉbytesˉrepeat(0u8, View.Fields);
    if !Seenˉresult.Valid { return false; }
    var Seen: bytes = Seenˉresult.Value;
    var Cursor: u32 = Patternˉstart.Nextˉoffset;
    var Line: u32 = Patternˉstart.Nextˉline;
    var Column: u32 = Patternˉstart.Nextˉcolumn;
    var Fields: u32 = 0u32;
    var Reading: bool = true;
    var Valid: bool = true;
    while Reading {
        let Field: Sourceˉlexer.Compilerˉsourceˉtoken =
            Sourceˉbodies.Compilerˉbodyˉtoken(
                Source, Cursor, Line, Column,
                Case.Bindingˉoffset + Case.Bindingˉlength
            );
        if Field.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Rightˉbrace {
            Reading = false;
        } else {
            let Member: Compilerˉsourceˉwirˉmember =
                Compilerˉsourceˉwirˉvariantˉfieldˉbyˉname(
                    Input, Scan, Symbols, Typeˉcatalog,
                    Nominal, Caseˉindex,
                    Source, Field.Offset, Field.Length
                );
            if !Member.Found || Member.Index >= View.Fields {
                Valid = false;
            } else {
                if Bytesˉreadˉu8(Seen, Member.Index) != 0u8 {
                    Valid = false;
                }
                let Updated: Byteˉconstruction.Foundationˉbytesˉresult =
                    Byteˉconstruction.Foundationˉbytesˉreplace(
                        Seen, Member.Index, 1u32, Bytesˉfromˉu8(1u8)
                    );
                if !Updated.Valid {
                    Valid = false;
                } else {
                    Seen = Updated.Value;
                }
            }
            Fields = Fields + 1u32;
            let Colon: Sourceˉlexer.Compilerˉsourceˉtoken =
                Sourceˉbodies.Compilerˉbodyˉtoken(
                    Source, Field.Nextˉoffset,
                    Field.Nextˉline, Field.Nextˉcolumn,
                    Case.Bindingˉoffset + Case.Bindingˉlength
                );
            let Pattern: Sourceˉlexer.Compilerˉsourceˉtoken =
                Sourceˉbodies.Compilerˉbodyˉtoken(
                    Source, Colon.Nextˉoffset,
                    Colon.Nextˉline, Colon.Nextˉcolumn,
                    Case.Bindingˉoffset + Case.Bindingˉlength
                );
            let Separator: Sourceˉlexer.Compilerˉsourceˉtoken =
                Sourceˉbodies.Compilerˉbodyˉtoken(
                    Source, Pattern.Nextˉoffset,
                    Pattern.Nextˉline, Pattern.Nextˉcolumn,
                    Case.Bindingˉoffset + Case.Bindingˉlength
                );
            if Separator.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Comma {
                Cursor = Separator.Nextˉoffset;
                Line = Separator.Nextˉline;
                Column = Separator.Nextˉcolumn;
            } else {
                Reading = false;
            }
        }
    }
    return Valid && Fields == View.Fields;
}

fn Compilerˉsourceˉwirˉbindˉvariantˉpattern(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Typeˉcatalog: Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog,
    Source: bytes,
    Value: u32,
    Nominal: u32,
    Caseˉindex: u32,
    Case: Sourceˉbodies.Compilerˉsourceˉmatchˉcase,
    Bindings: Sourceˉbindings.Compilerˉsourceˉbindingˉbuild,
    Build: Compilerˉsourceˉwirˉbuild
) -> Compilerˉsourceˉwirˉbuild {
    let View: Compilerˉsourceˉwirˉvariantˉcaseˉview =
        Compilerˉsourceˉwirˉvariantˉcaseˉviewˉbyˉindex(
            Input, Scan, Symbols, Typeˉcatalog, Nominal, Caseˉindex
        );
    if !View.Found || View.Fields == 0u32 { return Build; }
    let Patternˉstart: Sourceˉlexer.Compilerˉsourceˉtoken =
        Sourceˉbodies.Compilerˉbodyˉtoken(
            Source, Case.Bindingˉoffset, 1u32, 1u32,
            Case.Bindingˉoffset + Case.Bindingˉlength
        );
    if Patternˉstart.Kind != Sourceˉlexer.Compilerˉtokenˉkind.Leftˉbrace {
        let Legacyˉbinding: Sourceˉbindings.Compilerˉsourceˉlocalˉmatch =
            Sourceˉbindings.Compilerˉsourceˉbindingsˉfindˉlocal(
                Source, Bindings.Payload,
                Bindings.Entries - Bindings.Nextˉslot, Bindings.Entries,
                Case.Bindingˉoffset, Case.Bindingˉlength,
                Case.Blockˉoffset
            );
        if !Legacyˉbinding.Found {
            return Compilerˉsourceˉwirˉbuildˉfailure(
                Build, Compilerˉsourceˉwirˉstatus.Invalidˉvariantˉbinding,
                Build.Currentˉmodule, Build.Currentˉmodule,
                Build.Currentˉfunction, Case.Bindingˉoffset, 1u32, 1u32
            );
        }
        let Legacyˉfield: Compilerˉsourceˉwirˉmember =
            Compilerˉsourceˉwirˉvariantˉfieldˉbyˉindex(
                Input, Scan, Symbols, Typeˉcatalog,
                Nominal, Caseˉindex, 0u32
            );
        let Payload: Compilerˉsourceˉwirˉvalue =
            Compilerˉsourceˉwirˉemit(
                Build, WIR_OPERATION_VARIANT_PAYLOAD,
                Legacyˉfield.Shape,
                Compilerˉsourceˉwirˉoneˉoperand(Value),
                Nominal, Caseˉindex,
                Case.Bindingˉoffset, Case.Bindingˉlength
            );
        let Legacyˉstored: Compilerˉsourceˉwirˉvalue =
            Compilerˉsourceˉwirˉemit(
                Compilerˉsourceˉwirˉvalueˉbuild(Payload),
                WIR_OPERATION_STORE_LOCAL, 0u32,
                Compilerˉsourceˉwirˉoneˉoperand(Payload.Temporary),
                Legacyˉbinding.Slot, 0u32,
                Case.Bindingˉoffset, Case.Bindingˉlength
            );
        return Compilerˉsourceˉwirˉvalueˉbuild(Legacyˉstored);
    }
    var Result: Compilerˉsourceˉwirˉbuild = Build;
    var Cursor: u32 = Patternˉstart.Nextˉoffset;
    var Line: u32 = Patternˉstart.Nextˉline;
    var Column: u32 = Patternˉstart.Nextˉcolumn;
    var Index: u32 = 0u32;
    while Index < View.Fields {
        let Field: Sourceˉlexer.Compilerˉsourceˉtoken =
            Sourceˉbodies.Compilerˉbodyˉtoken(
                Source, Cursor, Line, Column,
                Case.Bindingˉoffset + Case.Bindingˉlength
            );
        let Colon: Sourceˉlexer.Compilerˉsourceˉtoken =
            Sourceˉbodies.Compilerˉbodyˉtoken(
                Source, Field.Nextˉoffset,
                Field.Nextˉline, Field.Nextˉcolumn,
                Case.Bindingˉoffset + Case.Bindingˉlength
            );
        let Name: Sourceˉlexer.Compilerˉsourceˉtoken =
            Sourceˉbodies.Compilerˉbodyˉtoken(
                Source, Colon.Nextˉoffset,
                Colon.Nextˉline, Colon.Nextˉcolumn,
                Case.Bindingˉoffset + Case.Bindingˉlength
            );
        let Member: Compilerˉsourceˉwirˉmember =
            Compilerˉsourceˉwirˉvariantˉfieldˉbyˉname(
                Input, Scan, Symbols, Typeˉcatalog,
                Nominal, Caseˉindex,
                Source, Field.Offset, Field.Length
            );
        let Discard: bool = Name.Length == 1u32 &&
            Bytesˉreadˉu8(Source, Name.Offset) == 95u8;
        if !Discard {
            let Fieldˉbinding: Sourceˉbindings.Compilerˉsourceˉlocalˉmatch =
                Sourceˉbindings.Compilerˉsourceˉbindingsˉfindˉlocal(
                    Source, Bindings.Payload,
                    Bindings.Entries - Bindings.Nextˉslot,
                    Bindings.Entries, Name.Offset, Name.Length,
                    Case.Blockˉoffset
                );
            if !Fieldˉbinding.Found || !Member.Found {
                return Compilerˉsourceˉwirˉbuildˉfailure(
                    Result,
                    Compilerˉsourceˉwirˉstatus.Invalidˉvariantˉbinding,
                    Build.Currentˉmodule, Build.Currentˉmodule,
                    Build.Currentˉfunction, Name.Offset, 1u32, 1u32
                );
            }
            let Selected: Compilerˉsourceˉwirˉvalue =
                Compilerˉsourceˉwirˉemit(
                    Result,
                    WIR_OPERATION_VARIANT_FIELD,
                    Member.Shape,
                    Compilerˉsourceˉwirˉoneˉoperand(Value),
                    Nominal, Caseˉindex * 64u32 + Member.Index,
                    Field.Offset, Field.Length
                );
            let Fieldˉstored: Compilerˉsourceˉwirˉvalue =
                Compilerˉsourceˉwirˉemit(
                    Compilerˉsourceˉwirˉvalueˉbuild(Selected),
                    WIR_OPERATION_STORE_LOCAL, 0u32,
                    Compilerˉsourceˉwirˉoneˉoperand(Selected.Temporary),
                    Fieldˉbinding.Slot, 0u32,
                    Name.Offset, Name.Length
                );
            Result = Compilerˉsourceˉwirˉvalueˉbuild(Fieldˉstored);
        }
        let Separator: Sourceˉlexer.Compilerˉsourceˉtoken =
            Sourceˉbodies.Compilerˉbodyˉtoken(
                Source, Name.Nextˉoffset,
                Name.Nextˉline, Name.Nextˉcolumn,
                Case.Bindingˉoffset + Case.Bindingˉlength
            );
        Cursor = Separator.Nextˉoffset;
        Line = Separator.Nextˉline;
        Column = Separator.Nextˉcolumn;
        Index = Index + 1u32;
    }
    return Result;
}

export fn Compilerˉsourceˉwirˉnominalˉdirectoryˉentry(
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Nominal: u32,
    Kind: u32
) -> u32 {
    if Nominal >= Symbols.Records + Symbols.Enums + Symbols.Variants {
        return Compilerˉsourceˉwirˉsentinel();
    }
    let Symbolˉentries: u32 = Bytesˉreadˉu32ˉlittle(
        Symbols.Directory, 8u32
    );
    let Symbolˉindex: u32 = Bytesˉreadˉu32ˉlittle(
        Symbols.Lookup, 4112u32 + Symbolˉentries * 4u32 + Nominal * 4u32
    );
    let Symbolˉentry: u32 = 16u32 + Symbolˉindex * 24u32;
    if Bytesˉreadˉu32ˉlittle(
            Symbols.Directory, Symbolˉentry + 4u32
        ) != Kind {
        return Compilerˉsourceˉwirˉsentinel();
    }
    return Symbolˉindex;
}

export fn Compilerˉsourceˉwirˉvariantˉcaseˉbyˉindex(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Nominal: u32,
    Case: u32
) -> Compilerˉsourceˉwirˉmember {
    let View: Compilerˉsourceˉwirˉvariantˉcaseˉview =
        Compilerˉsourceˉwirˉvariantˉcaseˉviewˉbyˉindex(
            Input, Scan, Symbols,
            Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalogˉempty(),
            Nominal, Case
        );
    if !View.Found {
        return Compilerˉsourceˉwirˉmember(false, 0u32, 0u32);
    }
    if View.Fields == 0u32 {
        return Compilerˉsourceˉwirˉmember(true, Case, 0u32);
    }
    let Field: Compilerˉsourceˉwirˉmember =
        Compilerˉsourceˉwirˉvariantˉfieldˉbyˉindex(
            Input, Scan, Symbols,
            Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalogˉempty(),
            Nominal, Case, 0u32
        );
    return Compilerˉsourceˉwirˉmember(Field.Found, Case, Field.Shape);
}

export fn Compilerˉsourceˉwirˉevidenceˉfits(Build: Compilerˉsourceˉwirˉbuild) -> bool {
    let Payloadˉbytes: u32 = Bytesˉlength(Build.Functionˉpayload) +
        Bytesˉlength(Build.Blockˉpayload) +
        Compilerˉsourceˉwirˉchunkedˉpayloadˉlength(
            Build.Operationˉpayload, Build.Operationˉpending
        ) +
        Compilerˉsourceˉwirˉchunkedˉpayloadˉlength(
            Build.Temporaryˉpayload, Build.Temporaryˉpending
        ) +
        Compilerˉsourceˉwirˉchunkedˉpayloadˉlength(
            Build.Operandˉpayload, Build.Operandˉpending
        );
    let Catalog: Sourceˉgenerics.Compilerˉsourceˉgenericˉcatalog =
        Compilerˉsourceˉwirˉgenericˉcatalog(Build.Genericˉevidence);
    let Genericˉinstances: u32 =
        Sourceˉgenerics.Compilerˉsourceˉgenericˉcatalogˉinstances(Catalog);
    let Functionˉtypeˉcatalog:
        Compilerˉsourceˉwirˉfunctionˉtypeˉcatalog =
        Compilerˉsourceˉwirˉfunctionˉtypeˉcatalogˉfromˉgeneric(
            Build.Genericˉevidence
        );
    if !Compilerˉsourceˉwirˉfunctionˉtypeˉcatalogˉisˉvalid(
            Functionˉtypeˉcatalog
        ) {
        return false;
    }
    let Functionˉtypeˉinstances: u32 =
        Compilerˉsourceˉwirˉfunctionˉtypeˉcatalogˉinstances(
            Functionˉtypeˉcatalog
        );
    var Headerˉbytes: u32 = 48u32;
    if Genericˉinstances > 0u32 { Headerˉbytes = Headerˉbytes + 8u32; }
    var Functionˉtypeˉbytes: u32 = 0u32;
    if Functionˉtypeˉinstances > 0u32 {
        Headerˉbytes = Headerˉbytes + 8u32;
        Functionˉtypeˉbytes = Bytesˉlength(Functionˉtypeˉcatalog.Evidence);
    }
    if Headerˉbytes > 4194304u32 ||
        Functionˉtypeˉbytes > 4194304u32 - Headerˉbytes {
        return false;
    }
    return Payloadˉbytes <=
        4194304u32 - Headerˉbytes - Functionˉtypeˉbytes;
}

export fn Compilerˉsourceˉwirˉsummaryˉfromˉbindings(
    Input: bytes,
    Bindings: Sourceˉbindings.Compilerˉsourceˉbindingˉsummary
) -> Compilerˉsourceˉwirˉsummary {
    return Compilerˉsourceˉwirˉsummary(
        Compilerˉsourceˉwirˉstatus.Sourceˉbindings,
        Bindings.Status,
        Bindings.Modules,
        Bindings.Functions,
        0u32, 0u32, 0u32, 0u32,
        Compilerˉsourceˉwirˉempty(Input),
        Bindings.Failureˉmodule,
        Bindings.Failureˉrelatedˉmodule,
        Bindings.Failureˉfunction,
        Bindings.Failureˉoffset,
        Bindings.Failureˉline,
        Bindings.Failureˉcolumn
