                        Result = Compilerˉsourceˉwirˉappendˉblock(
                            Result, Thenˉcurrent, Thenˉfirst, Thenˉcount,
                            Compilerˉsourceˉwirˉterminator.Jump,
                            Compilerˉsourceˉwirˉsentinel(), Thenˉjoin, Compilerˉsourceˉwirˉsentinel()
                        );
                        Result = Compilerˉsourceˉwirˉbeginˉreservedˉblock(Result, Thenˉjoin);
                    }
                } else {
                    if Elseˉhasˉcurrent {
                        let Elseˉjoin: u32 = Result.Nextˉblock;
                        Result = Compilerˉsourceˉwirˉreserveˉblocks(Result, 1u32);
                        Result = Compilerˉsourceˉwirˉappendˉblock(
                            Result, Elseˉcurrent, Elseˉfirst, Elseˉcount,
                            Compilerˉsourceˉwirˉterminator.Jump,
                            Compilerˉsourceˉwirˉsentinel(), Elseˉjoin, Compilerˉsourceˉwirˉsentinel()
                        );
                        Result = Compilerˉsourceˉwirˉbeginˉreservedˉblock(Result, Elseˉjoin);
                    }
                }
                }
            }
            if Statement.Kind == Sourceˉbodies.Compilerˉsourceˉstatementˉkind.Match {
                let Statementˉmatch: Compilerˉsourceˉwirˉmatchˉview =
                    Compilerˉsourceˉwirˉmatchˉview(
                        Statement.Offset,
                        Statement.Length,
                        Statement.Line,
                        Statement.Column,
                        Statement.Nameˉlength,
                        Statement.Expressionˉoffset,
                        Statement.Expressionˉlength,
                        Statement.Firstˉblockˉoffset,
                        Statement.Firstˉblockˉlength
                    );
                Result = Compilerˉsourceˉwirˉvalueˉbuild(
                    Compilerˉsourceˉwirˉcompileˉmatch(
                        Input, Scan, Symbols, Source,
                        Statementˉmatch,
                        false,
                        Returnˉshape, Continueˉtarget, Breakˉtarget, Result
                    )
                );
                if Result.Status != Compilerˉsourceˉwirˉstatus.Valid {
                    return Result;
                }
                Bindingˉphase = Compilerˉsourceˉwirˉbuildˉbindings(Input, Result);
            }
            if Statement.Kind == Sourceˉbodies.Compilerˉsourceˉstatementˉkind.Try {
                Result = Compilerˉsourceˉwirˉcompileˉtry(
                    Input, Scan, Symbols, Bindingˉphase, Source, Statement,
                    Result
                );
                if Result.Status != Compilerˉsourceˉwirˉstatus.Valid {
                    return Result;
                }
                Bindingˉphase = Compilerˉsourceˉwirˉbuildˉbindings(Input, Result);
            }
            if Statement.Kind == Sourceˉbodies.Compilerˉsourceˉstatementˉkind.For {
                Result = Compilerˉsourceˉwirˉcompileˉfor(
                    Input, Scan, Symbols, Bindingˉphase, Source, Statement,
                    Returnˉshape, Result
                );
                if Result.Status != Compilerˉsourceˉwirˉstatus.Valid {
                    return Result;
                }
                Bindingˉphase = Compilerˉsourceˉwirˉbuildˉbindings(Input, Result);
            }
            if Statement.Kind == Sourceˉbodies.Compilerˉsourceˉstatementˉkind.While {
                Result = Compilerˉsourceˉwirˉcompileˉwhile(
                    Input, Scan, Symbols, Bindingˉphase, Source, Statement,
                    Returnˉshape, Result
                );
                if Result.Status != Compilerˉsourceˉwirˉstatus.Valid {
                    return Result;
                }
                Bindingˉphase = Compilerˉsourceˉwirˉbuildˉbindings(Input, Result);
            }
            if Statement.Kind == Sourceˉbodies.Compilerˉsourceˉstatementˉkind.Block {
                let Nestedˉposition: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
                    Source, Statement.Offset, Statement.Line, Statement.Column,
                    Statement.Firstˉblockˉoffset
                );
                let Nestedˉcompiled: Compilerˉsourceˉwirˉbuild = Compilerˉsourceˉwirˉcompileˉblock(
                    Input, Scan, Symbols,
                    Bindingˉphase,
                    Source,
                    Statement.Firstˉblockˉoffset,
                    Nestedˉposition.Line, Nestedˉposition.Column,
                    Statement.Firstˉblockˉoffset + Statement.Firstˉblockˉlength,
                    Statement.Firstˉblockˉoffset + Statement.Firstˉblockˉlength,
                    Returnˉshape,
                    Continueˉtarget,
                    Breakˉtarget,
                    Result
                );
                if Nestedˉcompiled.Status != Compilerˉsourceˉwirˉstatus.Valid {
                    return Nestedˉcompiled;
                }
                Result = Nestedˉcompiled;
                Bindingˉphase = Compilerˉsourceˉwirˉbuildˉbindings(Input, Nestedˉcompiled);
            }
            Cursor = Statement.Nextˉoffset;
            Currentˉline = Statement.Nextˉline;
            Currentˉcolumn = Statement.Nextˉcolumn;
        }
    }
    return Result;
}

fn Compilerˉsourceˉwirˉbindˉfunctionˉparameters(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Bindings: Sourceˉbindings.Compilerˉsourceˉbindingˉphase,
    Module: u32,
    Function: u32,
    Source: bytes,
    Declaration: Sourceˉdeclarations.Compilerˉsourceˉdeclaration,
    Declarationˉline: u32,
    Declarationˉcolumn: u32,
    Build: Compilerˉsourceˉwirˉbuild
) -> Compilerˉsourceˉwirˉbuild {
    let Generic: Sourceˉsymbols.Compilerˉsourceˉfunctionˉgeneric =
        Sourceˉsymbols.Compilerˉsourceˉsymbolsˉfunctionˉgeneric(
            Source, Declaration, Declarationˉline, Declarationˉcolumn
        );
    if Generic.Parameters > 0u32 {
        let Concrete: Sourceˉbindings.Compilerˉsourceˉbindingˉphase =
            Sourceˉbindings.Compilerˉsourceˉbindingsˉphaseˉparametersˉconcrete(
                Input, Scan, Symbols, Module, Function, Source,
                Declaration, Declarationˉline, Declarationˉcolumn,
                Compilerˉsourceˉwirˉgenericˉcatalog(Build.Genericˉevidence),
                Build.Genericˉinstance,
                Compilerˉsourceˉwirˉgenericˉtypeˉcatalog(
                    Build.Genericˉevidence
                ),
                Bindings
            );
        if Concrete.Buildˉstatus !=
                Sourceˉbindings.Compilerˉsourceˉbindingˉstatus.Valid {
            return Compilerˉsourceˉwirˉbuildˉfailure(
                Build, Compilerˉsourceˉwirˉstatus.Sourceˉbindings,
                Concrete.Buildˉfailureˉmodule,
                Compilerˉsourceˉwirˉbindingˉfailureˉrelated(
                    Concrete.Buildˉstatus,
                    Concrete.Buildˉfailureˉrelatedˉmodule
                ),
                Concrete.Buildˉfailureˉfunction,
                Concrete.Buildˉfailureˉoffset,
                Concrete.Buildˉfailureˉline,
                Concrete.Buildˉfailureˉcolumn
            );
        }
        return Compilerˉsourceˉwirˉfusedˉfrom(Build, Concrete);
    }
    var Phase: Sourceˉbindings.Compilerˉsourceˉbindingˉphase =
        Sourceˉbindings.Compilerˉsourceˉbindingsˉphaseˉbuild(
            Bindings,
            Sourceˉbindings.Compilerˉsourceˉbindingsˉbuildˉresetˉslots(
                Sourceˉbindings.Compilerˉsourceˉbindingsˉphaseˉbuildˉvalue(
                    Bindings
                )
            )
        );
    let Left: Sourceˉlexer.Compilerˉsourceˉtoken =
        Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Source, Generic.Signatureˉoffset,
            Generic.Signatureˉline, Generic.Signatureˉcolumn
        );
    var Cursor: u32 = Left.Nextˉoffset;
    var Currentˉline: u32 = Left.Nextˉline;
    var Currentˉcolumn: u32 = Left.Nextˉcolumn;
    var Result: Compilerˉsourceˉwirˉbuild = Build;
    var Index: u32 = 0u32;
    while Index < Declaration.Items {
        let Parameter: Sourceˉlexer.Compilerˉsourceˉtoken =
            Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                Source, Cursor, Currentˉline, Currentˉcolumn
            );
        let Colon: Sourceˉlexer.Compilerˉsourceˉtoken =
            Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                Source, Parameter.Nextˉoffset,
                Parameter.Nextˉline, Parameter.Nextˉcolumn
            );
        let Type: Compilerˉsourceˉwirˉgenericˉtypeˉscan =
            Compilerˉsourceˉwirˉscanˉgenericˉtype(
                Input, Scan, Symbols, Module, Source,
                Colon.Nextˉoffset, Colon.Nextˉline, Colon.Nextˉcolumn,
                false,
                Compilerˉsourceˉwirˉgenericˉtypeˉcatalog(
                    Result.Genericˉevidence
                )
            );
        if Type.Status !=
                Sourceˉsymbols.Compilerˉsourceˉsymbolˉstatus.Valid {
            return Compilerˉsourceˉwirˉbuildˉfailure(
                Result, Compilerˉsourceˉwirˉstatus.Genericˉresolution,
                Module, Module, Function,
                Type.Failureˉoffset, Type.Failureˉline, Type.Failureˉcolumn
            );
        }
        Result = Compilerˉsourceˉwirˉwithˉgenericˉtypeˉevidence(
            Result, Type.Evidence
        );
        let Parameterˉbuild: Sourceˉbindings.Compilerˉsourceˉbindingˉbuild =
            Sourceˉbindings.Compilerˉsourceˉbindingsˉappendˉparameter(
                Module, Function, Parameter,
                Declaration.Bodyˉoffset, Declaration.Bodyˉlength,
                Type.Shape,
                Sourceˉbindings.Compilerˉsourceˉbindingsˉphaseˉbuildˉvalue(
                    Phase
                )
            );
        Phase = Sourceˉbindings.Compilerˉsourceˉbindingsˉphaseˉbuild(
            Phase, Parameterˉbuild
        );
        if Phase.Buildˉstatus !=
                Sourceˉbindings.Compilerˉsourceˉbindingˉstatus.Valid {
            return Compilerˉsourceˉwirˉbuildˉfailure(
                Result, Compilerˉsourceˉwirˉstatus.Sourceˉbindings,
                Phase.Buildˉfailureˉmodule,
                Compilerˉsourceˉwirˉbindingˉfailureˉrelated(
                    Phase.Buildˉstatus,
                    Phase.Buildˉfailureˉrelatedˉmodule
                ),
                Phase.Buildˉfailureˉfunction,
                Phase.Buildˉfailureˉoffset,
                Phase.Buildˉfailureˉline,
                Phase.Buildˉfailureˉcolumn
            );
        }
        let Separator: Sourceˉlexer.Compilerˉsourceˉtoken =
            Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                Source, Type.Nextˉoffset, Type.Nextˉline, Type.Nextˉcolumn
            );
        if Separator.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Comma {
            Cursor = Separator.Nextˉoffset;
            Currentˉline = Separator.Nextˉline;
            Currentˉcolumn = Separator.Nextˉcolumn;
        } else {
            Cursor = Separator.Offset;
            Currentˉline = Separator.Line;
            Currentˉcolumn = Separator.Column;
        }
        Index = Index + 1u32;
    }
    return Compilerˉsourceˉwirˉfusedˉfrom(Result, Phase);
}

export fn Compilerˉsourceˉwirˉcompileˉfunction(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Bindings: Sourceˉbindings.Compilerˉsourceˉbindingˉphase,
    Module: u32,
    Function: u32,
    Source: bytes,
    Declaration: Sourceˉdeclarations.Compilerˉsourceˉdeclaration,
    Declarationˉline: u32,
    Declarationˉcolumn: u32,
    Build: Compilerˉsourceˉwirˉbuild
) -> Compilerˉsourceˉwirˉbuild {
    let Genericˉcatalog: Sourceˉgenerics.Compilerˉsourceˉgenericˉcatalog =
        Compilerˉsourceˉwirˉgenericˉcatalog(
            Build.Genericˉevidence
        );
    let Parameterˉbuild: Compilerˉsourceˉwirˉbuild =
        Compilerˉsourceˉwirˉbindˉfunctionˉparameters(
            Input, Scan, Symbols, Bindings,
            Module, Function, Source, Declaration,
            Declarationˉline, Declarationˉcolumn, Build
        );
    if Parameterˉbuild.Status != Compilerˉsourceˉwirˉstatus.Valid {
        return Parameterˉbuild;
    }
    var Bindingˉphase: Sourceˉbindings.Compilerˉsourceˉbindingˉphase =
        Compilerˉsourceˉwirˉbuildˉbindings(Input, Parameterˉbuild);
    var Result: Compilerˉsourceˉwirˉbuild = Compilerˉsourceˉwirˉstartˉfunction(
        Compilerˉsourceˉwirˉfusedˉfrom(Parameterˉbuild, Bindingˉphase),
        Module,
        Function
    );
    if Result.Status != Compilerˉsourceˉwirˉstatus.Valid {
        return Result;
    }
    let Signature: Compilerˉsourceˉwirˉsignature =
        Compilerˉsourceˉwirˉfunctionˉsignatureˉconcrete(
            Input, Scan, Symbols, Module, Source,
            Declaration.Declarationˉoffset,
            Compilerˉsourceˉwirˉsentinel(),
            Genericˉcatalog,
            Compilerˉsourceˉwirˉgenericˉtypeˉcatalog(
                Result.Genericˉevidence
            ),
            Result.Genericˉinstance
    );
    let Bodyˉposition: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
        Source,
        Declaration.Declarationˉoffset,
        Declarationˉline,
        Declarationˉcolumn,
        Declaration.Bodyˉoffset
    );
    Result = Compilerˉsourceˉwirˉcompileˉblock(
        Input, Scan, Symbols,
        Bindingˉphase,
        Source,
        Declaration.Bodyˉoffset,
        Bodyˉposition.Line,
        Bodyˉposition.Column,
        Declaration.Bodyˉoffset + Declaration.Bodyˉlength,
        Declaration.Bodyˉoffset + Declaration.Bodyˉlength,
        Signature.Returnˉshape,
        Compilerˉsourceˉwirˉsentinel(),
        Compilerˉsourceˉwirˉsentinel(),
        Result
    );
    if Result.Status != Compilerˉsourceˉwirˉstatus.Valid { return Result; }
    Bindingˉphase = Compilerˉsourceˉwirˉbuildˉbindings(Input, Result);
    if Result.Hasˉcurrentˉblock {
        if Signature.Returnˉshape == 9u32 {
            let Unitˉfallthrough: Compilerˉsourceˉwirˉvalue =
                Compilerˉsourceˉwirˉemit(
                    Result,
                    WIR_OPERATION_UNIT_CONSTANT,
                    9u32,
                    Compilerˉsourceˉwirˉempty(Source),
                    0u32,
                    0u32,
                    Declaration.Bodyˉoffset + Declaration.Bodyˉlength - 1u32,
                    1u32
                );
            Result = Compilerˉsourceˉwirˉcloseˉcurrentˉblock(
                Compilerˉsourceˉwirˉvalueˉbuild(Unitˉfallthrough),
                Compilerˉsourceˉwirˉterminator.Return,
                Unitˉfallthrough.Temporary,
                Compilerˉsourceˉwirˉsentinel(),
                Compilerˉsourceˉwirˉsentinel()
            );
        } else if Signature.Returnˉshape != 0u32 {
            let Failureˉoffset: u32 = Declaration.Bodyˉoffset + Declaration.Bodyˉlength - 1u32;
            let Failureˉposition: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
                Source,
                Declaration.Declarationˉoffset,
                Declarationˉline,
                Declarationˉcolumn,
                Failureˉoffset
            );
            return Compilerˉsourceˉwirˉfusedˉfrom(
                Compilerˉsourceˉwirˉbuildˉfailure(
                    Result,
                    Compilerˉsourceˉwirˉstatus.Missingˉreturn,
                    Module, Module, Function,
                    Failureˉoffset,
                    Failureˉposition.Line,
                    Failureˉposition.Column
                ),
                Bindingˉphase
            );
        } else {
            Result = Compilerˉsourceˉwirˉcloseˉcurrentˉblock(
                Result,
                Compilerˉsourceˉwirˉterminator.Return,
                Compilerˉsourceˉwirˉsentinel(),
                Compilerˉsourceˉwirˉsentinel(),
                Compilerˉsourceˉwirˉsentinel()
            );
        }
    }
    let Bindingˉbuild: Sourceˉbindings.Compilerˉsourceˉbindingˉbuild =
        Sourceˉbindings.Compilerˉsourceˉbindingsˉphaseˉbuildˉvalue(Bindingˉphase);
    let Completed: Compilerˉsourceˉwirˉbuild = Compilerˉsourceˉwirˉappendˉfunctionˉentry(
        Result,
        true,
        Bindingˉbuild.Parameters,
        Bindingˉbuild.Locals,
        Signature.Returnˉshape
    );
    if Completed.Status != Compilerˉsourceˉwirˉstatus.Valid {
        return Completed;
    }
    return Compilerˉsourceˉwirˉmergeˉfunction(Build, Completed);
}

fn Compilerˉsourceˉwirˉcompileˉspecializations(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Build: Compilerˉsourceˉwirˉbuild
) -> Compilerˉsourceˉwirˉbuild {
    var Result: Compilerˉsourceˉwirˉbuild = Build;
    var Bindings: Sourceˉbindings.Compilerˉsourceˉbindingˉphase =
        Compilerˉsourceˉwirˉbuildˉbindings(Input, Build);
    let Catalog: Sourceˉgenerics.Compilerˉsourceˉgenericˉcatalog =
        Compilerˉsourceˉwirˉgenericˉcatalog(Build.Genericˉevidence);
    let Instances: u32 =
        Sourceˉgenerics.Compilerˉsourceˉgenericˉcatalogˉinstances(Catalog);
    let Symbolˉentries: u32 = Bytesˉreadˉu32ˉlittle(
        Symbols.Directory, 8u32
    );
    var Instance: u32 = 0u32;
    while Instance < Instances {
        let Declarationˉentry: u32 =
            Sourceˉgenerics.Compilerˉsourceˉgenericˉcatalogˉinstanceˉdeclaration(
                Catalog, Instance
            );
        let Symbolˉentry: u32 = 16u32 + Declarationˉentry * 24u32;
        let Module: u32 = Bytesˉreadˉu32ˉlittle(
            Symbols.Directory, Symbolˉentry
        );
        let Declarationˉoffset: u32 = Bytesˉreadˉu32ˉlittle(
            Symbols.Directory, Symbolˉentry + 8u32
        );
        let View: Sourceˉset.Compilerˉsourceˉsetˉview =
            Sourceˉset.Compilerˉsourceˉsetˉmodule(Input, Scan, Module);
        let Position: Sourceˉbodies.Compilerˉsourceˉposition =
            Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
                View.Source, 0u32, 1u32, 1u32, Declarationˉoffset
            );
        let Declaration: Sourceˉdeclarations.Compilerˉsourceˉdeclaration =
            Sourceˉdeclarations.Compilerˉparseˉnextˉdeclarationˉvalidated(
                View.Source, Declarationˉoffset,
                Position.Line, Position.Column, true
            );
        let Function: u32 = Result.Functionˉentries;
        if Function != Symbolˉentries + Instance ||
            Bytesˉreadˉu32ˉlittle(
                Symbols.Directory, Symbolˉentry + 4u32
            ) != 6u32 {
            return Compilerˉsourceˉwirˉbuildˉfailure(
                Result, Compilerˉsourceˉwirˉstatus.Invalidˉdirectory,
                Module, Module, Function,
                Declarationˉoffset, Position.Line, Position.Column
            );
        }
        let Functionˉresult: Compilerˉsourceˉwirˉbuild =
            Compilerˉsourceˉwirˉcompileˉfunction(
                Input, Scan, Symbols,
                Sourceˉbindings.Compilerˉsourceˉbindingsˉphaseˉempty(Input),
                Module, Function, View.Source, Declaration,
                Position.Line, Position.Column,
                Compilerˉsourceˉwirˉwithˉgenericˉinstance(Result, Instance)
            );
        if Functionˉresult.Status != Compilerˉsourceˉwirˉstatus.Valid {
            return Functionˉresult;
        }
        let Functionˉbindings:
            Sourceˉbindings.Compilerˉsourceˉbindingˉphase =
            Compilerˉsourceˉwirˉbuildˉbindings(Input, Functionˉresult);
        Bindings = Sourceˉbindings.Compilerˉsourceˉbindingsˉphaseˉmerge(
            Bindings, Functionˉbindings
        );
        Result = Compilerˉsourceˉwirˉfusedˉfrom(
            Functionˉresult, Bindings
        );
        Instance = Instance + 1u32;
    }
    return Result;
}

export fn Compilerˉsourceˉwirˉphase(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Genericˉevidence: bytes,
    Planning: bool
) -> Compilerˉsourceˉwirˉbuild {
    var Result: Compilerˉsourceˉwirˉbuild = Compilerˉsourceˉwirˉbuildˉempty(
        Input, Scan.Modules, Symbols.Functions, Genericˉevidence
    );
    var Bindings: Sourceˉbindings.Compilerˉsourceˉbindingˉphase =
        Sourceˉbindings.Compilerˉsourceˉbindingsˉphaseˉempty(Input);
    var Module: u32 = 0u32;
    while Module < Scan.Modules {
        let View: Sourceˉset.Compilerˉsourceˉsetˉview = Sourceˉset.Compilerˉsourceˉsetˉmodule(Input, Scan, Module);
        let Header: Sourceˉdeclarations.Compilerˉsourceˉheader = Sourceˉdeclarations.Compilerˉparseˉheaderˉvalidated(View.Source);
        var Cursor: u32 = Header.Nextˉoffset;
        var Currentˉline: u32 = Header.Nextˉline;
        var Currentˉcolumn: u32 = Header.Nextˉcolumn;
        var Sawˉnonˉimport: bool = false;
        var Reading: bool = true;
        while Reading {
            let Declaration: Sourceˉdeclarations.Compilerˉsourceˉdeclaration = Sourceˉdeclarations.Compilerˉparseˉnextˉdeclarationˉvalidated(
                View.Source, Cursor, Currentˉline, Currentˉcolumn, Sawˉnonˉimport
            );
            if Declaration.Kind == Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.End {
                Reading = false;
            } else {
                if Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉisˉsymbol(Declaration) {
                    if Declaration.Kind == Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Function {
                        let Position: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
                            View.Source, Cursor, Currentˉline, Currentˉcolumn,
                            Declaration.Declarationˉoffset
                        );
                        let Function: u32 = Result.Functionˉentries;
                        let Generic: Sourceˉsymbols.Compilerˉsourceˉfunctionˉgeneric =
                            Sourceˉsymbols.Compilerˉsourceˉsymbolsˉfunctionˉgeneric(
                                View.Source, Declaration,
                                Position.Line, Position.Column
                            );
                        if Generic.Parameters > 0u32 {
                            Result = Compilerˉsourceˉwirˉappendˉfunctionˉentry(
                                Compilerˉsourceˉwirˉwithˉgenericˉinstance(
                                    Result, Compilerˉsourceˉwirˉsentinel()
                                ),
                                false, 0u32, 0u32, 0u32
                            );
                        } else {
                            var Functionˉbuild: Compilerˉsourceˉwirˉbuild =
                                Compilerˉsourceˉwirˉwithˉgenericˉinstance(
                                    Result, Compilerˉsourceˉwirˉsentinel()
                                );
                            let Functionˉresult: Compilerˉsourceˉwirˉbuild =
                                Compilerˉsourceˉwirˉcompileˉfunction(
                                    Input, Scan, Symbols,
                                    Sourceˉbindings.Compilerˉsourceˉbindingsˉphaseˉempty(Input),
                                    Module, Function, View.Source, Declaration,
                                    Position.Line, Position.Column, Functionˉbuild
                                );
                            if Functionˉresult.Status != Compilerˉsourceˉwirˉstatus.Valid {
                                return Functionˉresult;
                            }
                            Result = Functionˉresult;
                            let Functionˉbindings: Sourceˉbindings.Compilerˉsourceˉbindingˉphase =
                                Compilerˉsourceˉwirˉbuildˉbindings(Input, Functionˉresult);
                            Bindings = Sourceˉbindings.Compilerˉsourceˉbindingsˉphaseˉmerge(
                                Bindings, Functionˉbindings
                            );
                            Result = Compilerˉsourceˉwirˉfusedˉfrom(Result, Bindings);
                        }
                    } else {
                        Result = Compilerˉsourceˉwirˉappendˉfunctionˉentry(
                            Result, false, 0u32, 0u32, 0u32
                        );
                    }
                }
                if Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉclosesˉimports(Declaration) {
                    Sawˉnonˉimport = true;
                }
                Cursor = Declaration.Nextˉoffset;
                Currentˉline = Declaration.Nextˉline;
                Currentˉcolumn = Declaration.Nextˉcolumn;
            }
        }
        Module = Module + 1u32;
    }
    if !Planning {
        Result = Compilerˉsourceˉwirˉcompileˉspecializations(
            Input, Scan, Symbols,
            Compilerˉsourceˉwirˉfusedˉfrom(Result, Bindings)
        );
        if Result.Status != Compilerˉsourceˉwirˉstatus.Valid { return Result; }
        Bindings = Compilerˉsourceˉwirˉbuildˉbindings(Input, Result);
    }
    return Compilerˉsourceˉwirˉfusedˉfrom(Result, Bindings);
}

export fn Compilerˉsourceˉwirˉheader(Build: Compilerˉsourceˉwirˉbuild) -> bytes {
    let Catalog: Sourceˉgenerics.Compilerˉsourceˉgenericˉcatalog =
        Compilerˉsourceˉwirˉgenericˉcatalog(Build.Genericˉevidence);
    let Instances: u32 =
        Sourceˉgenerics.Compilerˉsourceˉgenericˉcatalogˉinstances(Catalog);
    var Result: bytes = Textˉtoˉutf8("WVIR");
    Result = Bytesˉconcat(Result, Bytesˉfromˉu16ˉlittle(1u32));
    if Instances > 0u32 {
        Result = Bytesˉconcat(Result, Bytesˉfromˉu16ˉlittle(4u32));
    } else {
        Result = Bytesˉconcat(Result, Bytesˉfromˉu16ˉlittle(3u32));
    }
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Build.Functionˉentries));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(48u32));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Build.Blocks));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(28u32));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Build.Operations));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(32u32));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Build.Temporaries));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(4u32));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Build.Operands));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(4u32));
    if Instances > 0u32 {
        Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Instances));
        Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(1u32));
    }
    return Result;
}

export fn Compilerˉsourceˉwirˉheaderˉbytes(Directory: bytes) -> u32 {
    if Bytesˉlength(Directory) >= 56u32 &&
        Bytesˉreadˉu16ˉlittle(Directory, 6u32) == 4u32 {
        return 56u32;
    }
    return 48u32;
}

export fn Compilerˉsourceˉwirˉfunctionsˉoffset(Directory: bytes) -> u32 {
    return Compilerˉsourceˉwirˉheaderˉbytes(Directory);
}

export fn Compilerˉsourceˉwirˉdirectory(Build: Compilerˉsourceˉwirˉbuild) -> bytes {
    var Result: bytes = Compilerˉsourceˉwirˉheader(Build);
    Result = Bytesˉconcat(Result, Build.Functionˉpayload);
    Result = Bytesˉconcat(Result, Build.Blockˉpayload);
    Result = Bytesˉconcat(Result, Build.Operationˉpayload);
    Result = Bytesˉconcat(Result, Build.Temporaryˉpayload);
    Result = Bytesˉconcat(Result, Build.Operandˉpayload);
    return Result;
}

export fn Compilerˉsourceˉwirˉoperationˉresultˉisˉvalid(
    Operation: u32,
    Shape: u32
) -> bool {
    if Operation == 1u32 { return Shape == 1u32; }
    if Operation == 2u32 { return Shape == 2u32; }
    if Operation == 3u32 {
        if Shape == 3u32 { return true; }
        if Shape >= 268435456u32 { return Shape < 268439552u32; }
        return false;
    }
    if Operation == 4u32 { return Shape == 4u32; }
    if Operation == 5u32 { return Shape == 5u32; }
    if Operation == 6u32 { return Shape == 6u32; }
    if Operation == 7u32 { return Shape != 0u32; }
    if Operation == 8u32 { return Shape == 0u32; }
    if Operation == 9u32 { return Shape == 1u32; }
    if Operation == 10u32 { return Shape == 1u32; }
    if Operation == 11u32 { return Shape == 3u32; }
    if Operation == 12u32 { return Shape == 6u32; }
    if Operation == 13u32 { return Shape == 2u32; }
    if Operation == 14u32 { return Shape == 3u32; }
    if Operation == 15u32 { return Shape == 3u32; }
    if Operation == 16u32 { return Shape == 1u32; }
    if Operation == 17u32 {
        if Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉshapeˉisˉprivate(
                Shape
            ) {
            return true;
        }
        if Shape >= 65536u32 { return Shape < 131072u32; }
        return false;
    }
    if Operation == 18u32 { return Shape != 0u32; }
    if Operation == 19u32 {
        if Shape >= 131072u32 { return Shape < 196608u32; }
        return false;
    }
    if Operation == 20u32 { return Shape == 4u32; }
    if Operation == 21u32 { return Shape == 4u32; }
    if Operation == 22u32 { return Shape == 5u32; }
    if Operation == 23u32 { return Shape == 5u32; }
    if Operation == 24u32 { return Shape == 5u32; }
    if Operation == 25u32 { return Shape == 5u32; }
    if Operation == 26u32 { return Shape == 3u32; }
    if Operation == 27u32 { return Shape == 5u32; }
    if Operation == 28u32 { return Shape == 4u32; }
    if Operation == 29u32 { return Shape == 5u32; }
    if Operation == 30u32 { return Shape == 5u32; }
    if Operation == 31u32 { return Shape == 6u32; }
    if Operation == 32u32 { return Shape == 6u32; }
    if Operation == 33u32 { return Shape == 6u32; }
    if Operation == 34u32 { return Shape == 6u32; }
    if Operation == 35u32 { return Shape == 6u32; }
    if Operation == 36u32 { return Shape == 5u32; }
    if Operation == 37u32 { return Shape == 6u32; }
    if Operation >= 38u32 {
        if Operation <= 41u32 { return Shape == 1u32; }
    }
    if Operation >= 42u32 {
        if Operation <= 44u32 { return Shape == 3u32; }
    }
    if Operation >= 45u32 {
        if Operation <= 61u32 { return Shape == 4u32; }
    }
    if Operation == 62u32 { return true; }
    if Operation == 63u32 { return true; }
    if Operation == 64u32 { return Shape != 0u32 && Shape != 10u32; }
    if Operation == 65u32 { return Shape >= 196608u32; }
    if Operation == 66u32 { return Shape == 4u32; }
    if Operation == 67u32 { return Shape != 0u32; }
    if Operation == 68u32 { return Compilerˉsourceˉwirˉshapeˉisˉbuilder(Shape); }
    if Operation == 69u32 { return Compilerˉsourceˉwirˉshapeˉisˉbuilder(Shape); }
    if Operation == 70u32 { return Compilerˉsourceˉwirˉshapeˉisˉsequence(Shape); }
    if Operation == 71u32 { return Shape == 3u32; }
    if Operation == 72u32 { return Shape != 0u32; }
    if Operation == 73u32 { return Shape == 1u32; }
    if Operation == 74u32 { return Shape == 1u32; }
    if Operation == 75u32 { return Shape == 3u32; }
    if Operation == 76u32 { return Shape == 3u32; }
    if Operation >= 77u32 {
        if Operation <= 82u32 { return Shape == 2u32; }
    }
    if Operation >= 83u32 {
        if Operation <= 88u32 { return Shape == 3u32; }
    }
    if Operation >= 89u32 {
        if Operation <= 92u32 { return Shape == 4u32; }
    }
    if Operation == 93u32 { return Shape == 7u32; }
    if Operation == 94u32 { return Shape == 8u32; }
    if Operation == 95u32 || Operation == 96u32 { return Shape == 5u32; }
    if Operation >= 97u32 {
        if Operation <= 100u32 { return Shape == 7u32; }
    }
    if Operation >= 101u32 {
        if Operation <= 103u32 { return Shape == 8u32; }
    }
    if Operation >= 104u32 {
        if Operation <= 115u32 { return Shape == 4u32; }
    }
    if Operation == 116u32 || Operation == 117u32 { return Shape == 7u32; }
    if Operation >= 118u32 {
        if Operation <= 125u32 { return Shape == 8u32; }
    }
    if Operation == 126u32 { return Shape == 8u32; }
    if Operation == 127u32 { return Shape == 6u32; }
    if Operation == 128u32 { return Shape == 8u32; }
    if Operation == 129u32 {
        return Shape >= 11u32 && Shape <= 13u32;
    }
    if Operation >= 130u32 {
        if Operation <= 134u32 {
            return Shape >= 11u32 && Shape <= 13u32;
        }
    }
    if Operation == 135u32 { return Shape == 11u32 || Shape == 12u32; }
    if Operation >= 136u32 {
        if Operation <= 141u32 { return Shape == 4u32; }
    }
    if Operation >= 142u32 {
        if Operation <= 147u32 { return Shape == 13u32; }
    }
    if Operation == 148u32 { return Shape == 16u32; }
    if Operation == 149u32 || Operation == 150u32 { return Shape == 4u32; }
    if Operation == 151u32 { return Shape == 14u32 || Shape == 15u32; }
    if Operation >= 152u32 {
        if Operation <= 156u32 { return Shape == 14u32 || Shape == 15u32; }
    }
    if Operation >= 157u32 {
        if Operation <= 162u32 { return Shape == 4u32; }
    }
    if Operation == 163u32 { return Shape == 9u32; }
    if Operation == 164u32 { return Shape != 0u32; }
    return false;
}

export fn Compilerˉsourceˉwirˉoperationˉoperandˉcountˉisˉvalid(
    Operation: u32,
    Count: u32
) -> bool {
