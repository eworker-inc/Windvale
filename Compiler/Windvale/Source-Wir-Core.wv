                                Result.Currentˉmodule,
                                Result.Currentˉfunction,
                                Statement.Expressionˉoffset,
                                Localˉposition.Line,
                                Localˉposition.Column
                            ),
                            Bindingˉphase
                        );
                    }
                    Declaredˉshape = Localˉvalue.Shape;
                }
                if Localˉvalue.Shape == 10u32 {
                    Result = Compilerˉsourceˉwirˉvalueˉbuild(Localˉvalue);
                } else {
                if Compilerˉsourceˉwirˉshapeˉisˉbuilder(Localˉvalue.Shape) && !Statement.Isˉmutable {
                    return Compilerˉsourceˉwirˉfusedˉfrom(
                        Compilerˉsourceˉwirˉbuildˉfailure(
                            Compilerˉsourceˉwirˉvalueˉbuild(Localˉvalue),
                            Compilerˉsourceˉwirˉstatus.Invalidˉbuilder,
                            Result.Currentˉmodule, Result.Currentˉmodule, Result.Currentˉfunction,
                            Statement.Offset, Statement.Line, Statement.Column
                        ), Bindingˉphase
                    );
                }
                if Statement.Typeˉkind == Sourceˉdeclarations.Compilerˉsourceˉtypeˉkind.Unknown {
                    if Localˉvalue.Shape == 0u32 {
                        return Compilerˉsourceˉwirˉfusedˉfrom(
                            Compilerˉsourceˉwirˉbuildˉfailure(
                                Compilerˉsourceˉwirˉvalueˉbuild(Localˉvalue),
                                Compilerˉsourceˉwirˉstatus.Invalidˉinference,
                                Result.Currentˉmodule, Result.Currentˉmodule,
                                Result.Currentˉfunction,
                                Statement.Expressionˉoffset,
                                Localˉposition.Line,
                                Localˉposition.Column
                            ),
                            Bindingˉphase
                        );
                    }
                    Declaredˉshape = Localˉvalue.Shape;
                }
                Result = Compilerˉsourceˉwirˉstoreˉdeclaredˉlocal(
                    Input, Source, Statement, Scopeˉendˉoffset,
                    Declaredˉshape, Localˉvalue, Bindingˉphase
                );
                if Result.Status != Compilerˉsourceˉwirˉstatus.Valid {
                    return Result;
                }
                Bindingˉphase =
                    Compilerˉsourceˉwirˉbuildˉbindings(Input, Result);
                }
            }
            if Statement.Kind == Sourceˉbodies.Compilerˉsourceˉstatementˉkind.Assignment {
                let Assignmentˉbinding: Sourceˉbindings.Compilerˉsourceˉlocalˉmatch = Sourceˉbindings.Compilerˉsourceˉbindingsˉfindˉlocal(
                    Source, Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
                    Statement.Nameˉoffset, Statement.Nameˉlength, Statement.Offset
                );
                if !Assignmentˉbinding.Found {
                    return Compilerˉsourceˉwirˉfusedˉfrom(
                        Compilerˉsourceˉwirˉbuildˉfailure(
                            Result,
                            Compilerˉsourceˉwirˉstatus.Typeˉmismatch,
                            Result.Currentˉmodule, Result.Currentˉmodule, Result.Currentˉfunction,
                            Statement.Offset, Statement.Line, Statement.Column
                        ),
                        Bindingˉphase
                    );
                }
                if Assignmentˉbinding.Kind != Sourceˉbindings.Compilerˉsourceˉbindingˉkind.Var {
                    return Compilerˉsourceˉwirˉfusedˉfrom(
                        Compilerˉsourceˉwirˉbuildˉfailure(
                            Result,
                            Compilerˉsourceˉwirˉstatus.Typeˉmismatch,
                            Result.Currentˉmodule, Result.Currentˉmodule, Result.Currentˉfunction,
                            Statement.Offset, Statement.Line, Statement.Column
                        ),
                        Bindingˉphase
                    );
                }
                if Compilerˉsourceˉwirˉshapeˉisˉbuilder(Assignmentˉbinding.Shape) {
                    return Compilerˉsourceˉwirˉfusedˉfrom(
                        Compilerˉsourceˉwirˉbuildˉfailure(
                            Result, Compilerˉsourceˉwirˉstatus.Invalidˉbuilder,
                            Result.Currentˉmodule, Result.Currentˉmodule, Result.Currentˉfunction,
                            Statement.Offset, Statement.Line, Statement.Column
                        ), Bindingˉphase
                    );
                }
                let Operatorˉposition: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
                    Source, Statement.Offset, Statement.Line, Statement.Column,
                    Statement.Nameˉoffset + Statement.Nameˉlength
                );
                let Assignmentˉoperator: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉbodies.Compilerˉbodyˉtoken(
                    Source,
                    Statement.Nameˉoffset + Statement.Nameˉlength,
                    Operatorˉposition.Line,
                    Operatorˉposition.Column,
                    Statement.Expressionˉoffset
                );
                let Isˉcompound: bool =
                    Assignmentˉoperator.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Plusˉequals ||
                    Assignmentˉoperator.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Minusˉequals ||
                    Assignmentˉoperator.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Starˉequals;
                var Assignmentˉbuild: Compilerˉsourceˉwirˉbuild = Result;
                var Assignmentˉleft: u32 = Compilerˉsourceˉwirˉsentinel();
                if Isˉcompound {
                    let Loaded: Compilerˉsourceˉwirˉvalue = Compilerˉsourceˉwirˉemit(
                        Assignmentˉbuild,
                        WIR_OPERATION_LOAD_LOCAL,
                        Assignmentˉbinding.Shape,
                        Compilerˉsourceˉwirˉempty(Source),
                        Assignmentˉbinding.Slot,
                        0u32,
                        Statement.Nameˉoffset,
                        Statement.Nameˉlength
                    );
                    Assignmentˉleft = Loaded.Temporary;
                    Assignmentˉbuild = Compilerˉsourceˉwirˉvalueˉbuild(Loaded);
                }
                let Assignmentˉposition: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
                    Source, Statement.Offset, Statement.Line, Statement.Column,
                    Statement.Expressionˉoffset
                );
                var Assignmentˉvalue: Compilerˉsourceˉwirˉvalue =
                    Compilerˉsourceˉwirˉcompileˉcontextualˉexpression(
                    Input, Scan, Symbols,
                    Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
                    Source,
                    Statement.Expressionˉoffset, Assignmentˉposition.Line, Assignmentˉposition.Column,
                    Statement.Expressionˉoffset + Statement.Expressionˉlength,
