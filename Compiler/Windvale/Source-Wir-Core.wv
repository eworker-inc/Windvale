export fn Compilerˉsourceˉwirˉreserveˉblocks(
    Build: Compilerˉsourceˉwirˉbuild,
    Count: u32
) -> Compilerˉsourceˉwirˉbuild {
    var Blockˉpayload: bytes = Build.Blockˉpayload;
    var Added: u32 = 0u32;
    while Added < Count {
        if Bytesˉlength(Blockˉpayload) > 4194276u32 {
            let Partial: Compilerˉsourceˉwirˉbuild =
                Compilerˉsourceˉwirˉwithˉreservedˉblocks(
                    Build, Blockˉpayload, Added
                );
            return Compilerˉsourceˉwirˉbuildˉfailure(
                Partial,
                Compilerˉsourceˉwirˉstatus.Evidenceˉlimit,
                Build.Currentˉmodule, Build.Currentˉmodule,
                Build.Currentˉfunction, 0u32, 0u32, 0u32
            );
        }
        Blockˉpayload = Bytesˉconcat(
            Blockˉpayload,
            Compilerˉsourceˉwirˉblockˉplaceholder(Blockˉpayload)
        );
        Added = Added + 1u32;
    }
    return Compilerˉsourceˉwirˉwithˉreservedˉblocks(
        Build, Blockˉpayload, Count
    );
}

export fn Compilerˉsourceˉwirˉbeginˉreservedˉblock(
    Build: Compilerˉsourceˉwirˉbuild,
    Block: u32
) -> Compilerˉsourceˉwirˉbuild {
    return Compilerˉsourceˉwirˉwithˉcurrentˉblock(
        Build, Block, Build.Operations, true
    );
}

export fn Compilerˉsourceˉwirˉappendˉblock(
    Build: Compilerˉsourceˉwirˉbuild,
    Block: u32,
    Firstˉoperation: u32,
    Operationˉcount: u32,
    Terminator: Compilerˉsourceˉwirˉterminator,
    Value: u32,
    Firstˉtarget: u32,
    Secondˉtarget: u32
) -> Compilerˉsourceˉwirˉbuild {
    if Block >= Build.Nextˉblock {
        return Compilerˉsourceˉwirˉbuildˉfailure(
            Build,
            Compilerˉsourceˉwirˉstatus.Invalidˉdirectory,
            Build.Currentˉmodule,
            Build.Currentˉmodule,
            Build.Currentˉfunction,
            0u32,
            0u32,
            0u32
        );
    }
    var Entry: bytes = Bytesˉfromˉu32ˉlittle(Block);
    Entry = Bytesˉconcat(Entry, Bytesˉfromˉu32ˉlittle(Firstˉoperation));
    Entry = Bytesˉconcat(Entry, Bytesˉfromˉu32ˉlittle(Operationˉcount));
    Entry = Bytesˉconcat(Entry, Bytesˉfromˉu32ˉlittle(Compilerˉsourceˉwirˉterminatorˉvalue(Terminator)));
    Entry = Bytesˉconcat(Entry, Bytesˉfromˉu32ˉlittle(Value));
    Entry = Bytesˉconcat(Entry, Bytesˉfromˉu32ˉlittle(Firstˉtarget));
    Entry = Bytesˉconcat(Entry, Bytesˉfromˉu32ˉlittle(Secondˉtarget));
    let Blockˉoffset: u32 = Block * 28u32;
    let Replaced: Byteˉconstruction.Foundationˉbytesˉresult = Byteˉconstruction.Foundationˉbytesˉreplace(
        Build.Blockˉpayload, Blockˉoffset, 28u32, Entry
    );
    if !Replaced.Valid {
        return Compilerˉsourceˉwirˉbuildˉfailure(
            Build,
            Compilerˉsourceˉwirˉstatus.Invalidˉdirectory,
            Build.Currentˉmodule,
            Build.Currentˉmodule,
            Build.Currentˉfunction,
            0u32,
            0u32,
            0u32
        );
    }
    return Compilerˉsourceˉwirˉbuild(
        Build.Status,
        Build.Functionˉpayload,
        Replaced.Value,
        Build.Operationˉpayload, Build.Temporaryˉpayload, Build.Operandˉpayload,
        Build.Operationˉpending, Build.Temporaryˉpending,
        Build.Operandˉpending,
        Build.Functionˉentries, Build.Blocks, Build.Operations,
        Build.Temporaries, Build.Operands,
        Build.Currentˉmodule, Build.Currentˉfunction,
        Build.Functionˉfirstˉblock, Build.Functionˉfirstˉoperation,
        Build.Functionˉfirstˉtemporary, Build.Functionˉfirstˉoperand,
        Build.Nextˉblock, Build.Currentˉblock,
        Build.Currentˉblockˉfirstˉoperation, Build.Hasˉcurrentˉblock,
        Build.Bindingˉpayload, Build.Bindingˉentries,
        Build.Bindingˉparameters, Build.Bindingˉlocals, Build.Bindingˉnextˉslot,
        Build.Genericˉevidence, Build.Genericˉinstance,
        Build.Closureˉevidence, Build.Unsafeˉdepth,
        Build.Failureˉmodule, Build.Failureˉrelatedˉmodule,
        Build.Failureˉfunction, Build.Failureˉoffset,
        Build.Failureˉline, Build.Failureˉcolumn
    );
}

export fn Compilerˉsourceˉwirˉcloseˉcurrentˉblock(
    Build: Compilerˉsourceˉwirˉbuild,
    Terminator: Compilerˉsourceˉwirˉterminator,
    Value: u32,
    Firstˉtarget: u32,
    Secondˉtarget: u32
) -> Compilerˉsourceˉwirˉbuild {
    let Closed: Compilerˉsourceˉwirˉbuild = Compilerˉsourceˉwirˉappendˉblock(
        Build,
        Build.Currentˉblock,
        Build.Currentˉblockˉfirstˉoperation,
        Build.Operations - Build.Currentˉblockˉfirstˉoperation,
        Terminator,
        Value,
        Firstˉtarget,
        Secondˉtarget
    );
    return Compilerˉsourceˉwirˉwithoutˉcurrentˉblock(Closed);
}

export fn Compilerˉsourceˉwirˉappendˉfunctionˉentry(
    Build: Compilerˉsourceˉwirˉbuild,
    Isˉfunction: bool,
    Parameters: u32,
    Locals: u32,
    Returnˉshape: u32
) -> Compilerˉsourceˉwirˉbuild {
    if Bytesˉlength(Build.Functionˉpayload) > 4194256u32 {
        return Compilerˉsourceˉwirˉbuildˉfailure(
            Build,
            Compilerˉsourceˉwirˉstatus.Evidenceˉlimit,
            Build.Currentˉmodule,
            Build.Currentˉmodule,
            Build.Currentˉfunction,
            0u32,
            0u32,
            0u32
        );
    }
    var Entry: bytes = Compilerˉsourceˉwirˉempty(Build.Functionˉpayload);
    if Isˉfunction {
        Entry = Bytesˉfromˉu32ˉlittle(Build.Currentˉmodule);
        Entry = Bytesˉconcat(Entry, Bytesˉfromˉu32ˉlittle(Build.Functionˉfirstˉblock));
        Entry = Bytesˉconcat(Entry, Bytesˉfromˉu32ˉlittle(Build.Blocks - Build.Functionˉfirstˉblock));
        Entry = Bytesˉconcat(Entry, Bytesˉfromˉu32ˉlittle(Build.Functionˉfirstˉoperation));
        Entry = Bytesˉconcat(Entry, Bytesˉfromˉu32ˉlittle(Build.Operations - Build.Functionˉfirstˉoperation));
        Entry = Bytesˉconcat(Entry, Bytesˉfromˉu32ˉlittle(Build.Functionˉfirstˉtemporary));
        Entry = Bytesˉconcat(Entry, Bytesˉfromˉu32ˉlittle(Build.Temporaries - Build.Functionˉfirstˉtemporary));
        Entry = Bytesˉconcat(Entry, Bytesˉfromˉu32ˉlittle(Build.Functionˉfirstˉoperand));
        Entry = Bytesˉconcat(Entry, Bytesˉfromˉu32ˉlittle(Build.Operands - Build.Functionˉfirstˉoperand));
        Entry = Bytesˉconcat(Entry, Bytesˉfromˉu32ˉlittle(Parameters));
        Entry = Bytesˉconcat(Entry, Bytesˉfromˉu32ˉlittle(Locals));
        Entry = Bytesˉconcat(Entry, Bytesˉfromˉu32ˉlittle(Returnˉshape));
    } else {
        var Index: u32 = 0u32;
        while Index < 12u32 {
            Entry = Bytesˉconcat(Entry, Bytesˉfromˉu32ˉlittle(0u32));
            Index = Index + 1u32;
        }
    }
    return Compilerˉsourceˉwirˉbuild(
        Build.Status,
        Bytesˉconcat(Build.Functionˉpayload, Entry),
        Build.Blockˉpayload, Build.Operationˉpayload,
        Build.Temporaryˉpayload, Build.Operandˉpayload,
        Build.Operationˉpending, Build.Temporaryˉpending,
        Build.Operandˉpending,
        Build.Functionˉentries + 1u32, Build.Blocks, Build.Operations,
        Build.Temporaries, Build.Operands,
        Build.Currentˉmodule, Build.Currentˉfunction,
        Build.Functionˉfirstˉblock, Build.Functionˉfirstˉoperation,
        Build.Functionˉfirstˉtemporary, Build.Functionˉfirstˉoperand,
        Build.Nextˉblock, Build.Currentˉblock,
        Build.Currentˉblockˉfirstˉoperation, Build.Hasˉcurrentˉblock,
        Build.Bindingˉpayload, Build.Bindingˉentries,
        Build.Bindingˉparameters, Build.Bindingˉlocals, Build.Bindingˉnextˉslot,
        Build.Genericˉevidence, Build.Genericˉinstance,
        Build.Closureˉevidence, Build.Unsafeˉdepth,
        Build.Failureˉmodule, Build.Failureˉrelatedˉmodule,
        Build.Failureˉfunction, Build.Failureˉoffset,
        Build.Failureˉline, Build.Failureˉcolumn
    );
}

export fn Compilerˉsourceˉwirˉmergeˉfunction(
    Outer: Compilerˉsourceˉwirˉbuild,
    Function: Compilerˉsourceˉwirˉbuild
) -> Compilerˉsourceˉwirˉbuild {
    let Functionˉbytes: u32 = Bytesˉlength(Function.Functionˉpayload);
    if Bytesˉlength(Outer.Functionˉpayload) > 4194304u32 - Functionˉbytes {
        return Compilerˉsourceˉwirˉbuildˉfailure(
            Function, Compilerˉsourceˉwirˉstatus.Evidenceˉlimit,
            Function.Currentˉmodule, Function.Currentˉmodule,
            Function.Currentˉfunction, 0u32, 0u32, 0u32
        );
    }
    let Blockˉbytes: u32 = Bytesˉlength(Function.Blockˉpayload);
    if Bytesˉlength(Outer.Blockˉpayload) > 4194304u32 - Blockˉbytes {
        return Compilerˉsourceˉwirˉbuildˉfailure(
            Function, Compilerˉsourceˉwirˉstatus.Evidenceˉlimit,
            Function.Currentˉmodule, Function.Currentˉmodule,
            Function.Currentˉfunction, 0u32, 0u32, 0u32
        );
    }
    let Operationˉbytes: u32 = Compilerˉsourceˉwirˉchunkedˉpayloadˉlength(
        Function.Operationˉpayload, Function.Operationˉpending
    );
    if Compilerˉsourceˉwirˉchunkedˉpayloadˉlength(
            Outer.Operationˉpayload, Outer.Operationˉpending
        ) > 4194304u32 - Operationˉbytes {
        return Compilerˉsourceˉwirˉbuildˉfailure(
            Function, Compilerˉsourceˉwirˉstatus.Evidenceˉlimit,
            Function.Currentˉmodule, Function.Currentˉmodule,
            Function.Currentˉfunction, 0u32, 0u32, 0u32
        );
    }
    let Temporaryˉbytes: u32 = Compilerˉsourceˉwirˉchunkedˉpayloadˉlength(
        Function.Temporaryˉpayload, Function.Temporaryˉpending
    );
    if Compilerˉsourceˉwirˉchunkedˉpayloadˉlength(
            Outer.Temporaryˉpayload, Outer.Temporaryˉpending
        ) > 4194304u32 - Temporaryˉbytes {
        return Compilerˉsourceˉwirˉbuildˉfailure(
            Function, Compilerˉsourceˉwirˉstatus.Evidenceˉlimit,
            Function.Currentˉmodule, Function.Currentˉmodule,
            Function.Currentˉfunction, 0u32, 0u32, 0u32
        );
    }
    let Operandˉbytes: u32 = Compilerˉsourceˉwirˉchunkedˉpayloadˉlength(
        Function.Operandˉpayload, Function.Operandˉpending
    );
    if Compilerˉsourceˉwirˉchunkedˉpayloadˉlength(
            Outer.Operandˉpayload, Outer.Operandˉpending
        ) > 4194304u32 - Operandˉbytes {
        return Compilerˉsourceˉwirˉbuildˉfailure(
            Function, Compilerˉsourceˉwirˉstatus.Evidenceˉlimit,
            Function.Currentˉmodule, Function.Currentˉmodule,
            Function.Currentˉfunction, 0u32, 0u32, 0u32
        );
    }
    let Operationˉpayload: Compilerˉsourceˉwirˉchunkedˉpayload =
        Compilerˉsourceˉwirˉchunkedˉpayloadˉappend(
            Outer.Operationˉpayload,
            Outer.Operationˉpending,
            Compilerˉsourceˉwirˉchunkedˉpayloadˉmaterialize(
                Function.Operationˉpayload, Function.Operationˉpending
            ),
            65536u32
        );
    let Temporaryˉpayload: Compilerˉsourceˉwirˉchunkedˉpayload =
        Compilerˉsourceˉwirˉchunkedˉpayloadˉappend(
            Outer.Temporaryˉpayload,
            Outer.Temporaryˉpending,
            Compilerˉsourceˉwirˉchunkedˉpayloadˉmaterialize(
                Function.Temporaryˉpayload, Function.Temporaryˉpending
            ),
            65536u32
        );
    let Operandˉpayload: Compilerˉsourceˉwirˉchunkedˉpayload =
        Compilerˉsourceˉwirˉchunkedˉpayloadˉappend(
            Outer.Operandˉpayload,
            Outer.Operandˉpending,
            Compilerˉsourceˉwirˉchunkedˉpayloadˉmaterialize(
                Function.Operandˉpayload, Function.Operandˉpending
            ),
            65536u32
        );
    return Compilerˉsourceˉwirˉbuild(
        Function.Status,
        Bytesˉconcat(Outer.Functionˉpayload, Function.Functionˉpayload),
        Bytesˉconcat(Outer.Blockˉpayload, Function.Blockˉpayload),
        Operationˉpayload.Complete,
        Temporaryˉpayload.Complete,
        Operandˉpayload.Complete,
        Operationˉpayload.Pending,
        Temporaryˉpayload.Pending,
        Operandˉpayload.Pending,
        Function.Functionˉentries, Function.Blocks, Function.Operations,
        Function.Temporaries, Function.Operands,
        Function.Currentˉmodule, Function.Currentˉfunction,
        Function.Functionˉfirstˉblock, Function.Functionˉfirstˉoperation,
        Function.Functionˉfirstˉtemporary, Function.Functionˉfirstˉoperand,
        Function.Nextˉblock, Function.Currentˉblock,
        Function.Currentˉblockˉfirstˉoperation, Function.Hasˉcurrentˉblock,
        Function.Bindingˉpayload, Function.Bindingˉentries,
        Function.Bindingˉparameters, Function.Bindingˉlocals, Function.Bindingˉnextˉslot,
        Function.Genericˉevidence, Function.Genericˉinstance,
        Function.Closureˉevidence, Function.Unsafeˉdepth,
        Function.Failureˉmodule, Function.Failureˉrelatedˉmodule,
        Function.Failureˉfunction, Function.Failureˉoffset,
        Function.Failureˉline, Function.Failureˉcolumn
    );
}

export fn Compilerˉsourceˉwirˉemit(
    Build: Compilerˉsourceˉwirˉbuild,
    Operation: u32,
    Shape: u32,
    Operandˉbytes: bytes,
    Target: u32,
    Auxiliary: u32,
    Offset: u32,
    Length: u32
) -> Compilerˉsourceˉwirˉvalue {
    if Compilerˉsourceˉwirˉchunkedˉpayloadˉlength(
            Build.Operationˉpayload, Build.Operationˉpending
        ) > 4194276u32 {
        return Compilerˉsourceˉwirˉfailureˉvalue(
            Build, Compilerˉsourceˉwirˉstatus.Evidenceˉlimit,
            Build.Currentˉmodule, Offset, 0u32, 0u32
        );
    }
    if Shape != 0u32 {
        if Compilerˉsourceˉwirˉchunkedˉpayloadˉlength(
                Build.Temporaryˉpayload, Build.Temporaryˉpending
            ) > 4194300u32 {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Build, Compilerˉsourceˉwirˉstatus.Evidenceˉlimit,
                Build.Currentˉmodule, Offset, 0u32, 0u32
            );
        }
    }
    if Bytesˉlength(Operandˉbytes) > 4194304u32 {
        return Compilerˉsourceˉwirˉfailureˉvalue(
            Build, Compilerˉsourceˉwirˉstatus.Evidenceˉlimit,
            Build.Currentˉmodule, Offset, 0u32, 0u32
        );
    }
    if Compilerˉsourceˉwirˉchunkedˉpayloadˉlength(
            Build.Operandˉpayload, Build.Operandˉpending
        ) > 4194304u32 - Bytesˉlength(Operandˉbytes) {
        return Compilerˉsourceˉwirˉfailureˉvalue(
            Build, Compilerˉsourceˉwirˉstatus.Evidenceˉlimit,
            Build.Currentˉmodule, Offset, 0u32, 0u32
        );
    }
    var Operandˉremaining: u32 = Bytesˉlength(Operandˉbytes);
    var Operandˉcount: u32 = 0u32;
    while Operandˉremaining > 0u32 {
        Operandˉremaining = Operandˉremaining - 4u32;
        Operandˉcount = Operandˉcount + 1u32;
    }
    if Operation > 65535u32 || Operandˉcount > 65535u32 {
        return Compilerˉsourceˉwirˉfailureˉvalue(
            Build, Compilerˉsourceˉwirˉstatus.Evidenceˉlimit,
            Build.Currentˉmodule, Offset, 0u32, 0u32
        );
    }
    let Firstˉoperand: u32 = Build.Operands;
    var Temporary: u32 = Compilerˉsourceˉwirˉsentinel();
    var Temporaryˉpayload: Compilerˉsourceˉwirˉchunkedˉpayload =
        Compilerˉsourceˉwirˉchunkedˉpayload(
            Build.Temporaryˉpayload, Build.Temporaryˉpending
        );
    var Temporaries: u32 = Build.Temporaries;
    if Shape != 0u32 {
        Temporary = Build.Temporaries - Build.Functionˉfirstˉtemporary;
        Temporaryˉpayload = Compilerˉsourceˉwirˉchunkedˉpayloadˉappend(
            Temporaryˉpayload.Complete,
            Temporaryˉpayload.Pending,
            Bytesˉfromˉu32ˉlittle(Shape),
            4096u32
        );
        Temporaries = Temporaries + 1u32;
    }
    var Entry: bytes = Bytesˉfromˉu32ˉlittle(Build.Currentˉblock);
    Entry = Bytesˉconcat(Entry, Bytesˉfromˉu16ˉlittle(Operation));
    Entry = Bytesˉconcat(Entry, Bytesˉfromˉu16ˉlittle(Operandˉcount));
    Entry = Bytesˉconcat(Entry, Bytesˉfromˉu32ˉlittle(Shape));
    Entry = Bytesˉconcat(Entry, Bytesˉfromˉu32ˉlittle(Temporary));
    Entry = Bytesˉconcat(Entry, Bytesˉfromˉu32ˉlittle(Firstˉoperand));
    Entry = Bytesˉconcat(Entry, Bytesˉfromˉu32ˉlittle(Target));
    Entry = Bytesˉconcat(Entry, Bytesˉfromˉu32ˉlittle(Auxiliary));
    let Operationˉpayload: Compilerˉsourceˉwirˉchunkedˉpayload =
        Compilerˉsourceˉwirˉchunkedˉpayloadˉappend(
            Build.Operationˉpayload, Build.Operationˉpending, Entry, 4032u32
        );
    let Operandˉpayload: Compilerˉsourceˉwirˉchunkedˉpayload =
        Compilerˉsourceˉwirˉchunkedˉpayloadˉappend(
            Build.Operandˉpayload,
            Build.Operandˉpending,
            Operandˉbytes,
            4096u32
        );
    let Result: Compilerˉsourceˉwirˉbuild = Compilerˉsourceˉwirˉbuild(
        Build.Status,
        Build.Functionˉpayload, Build.Blockˉpayload,
        Operationˉpayload.Complete,
        Temporaryˉpayload.Complete,
        Operandˉpayload.Complete,
        Operationˉpayload.Pending,
        Temporaryˉpayload.Pending,
        Operandˉpayload.Pending,
        Build.Functionˉentries, Build.Blocks, Build.Operations + 1u32,
        Temporaries, Build.Operands + Operandˉcount,
        Build.Currentˉmodule, Build.Currentˉfunction,
        Build.Functionˉfirstˉblock, Build.Functionˉfirstˉoperation,
        Build.Functionˉfirstˉtemporary, Build.Functionˉfirstˉoperand,
        Build.Nextˉblock, Build.Currentˉblock,
        Build.Currentˉblockˉfirstˉoperation, Build.Hasˉcurrentˉblock,
        Build.Bindingˉpayload, Build.Bindingˉentries,
        Build.Bindingˉparameters, Build.Bindingˉlocals, Build.Bindingˉnextˉslot,
        Build.Genericˉevidence, Build.Genericˉinstance,
        Build.Closureˉevidence, Build.Unsafeˉdepth,
        Build.Failureˉmodule, Build.Failureˉrelatedˉmodule,
        Build.Failureˉfunction, Build.Failureˉoffset,
        Build.Failureˉline, Build.Failureˉcolumn
    );
    return Compilerˉsourceˉwirˉvalueˉfrom(Result, Shape, Temporary);
}

export fn Compilerˉsourceˉwirˉoneˉoperand(Temporary: u32) -> bytes {
    return Bytesˉfromˉu32ˉlittle(Temporary);
}

export fn Compilerˉsourceˉwirˉtwoˉoperands(First: u32, Second: u32) -> bytes {
    return Bytesˉconcat(
        Bytesˉfromˉu32ˉlittle(First),
        Bytesˉfromˉu32ˉlittle(Second)
    );
}

fn Compilerˉsourceˉwirˉintrinsicˉparameterˉshapeˉfromˉoperation(
    Operation: u32,
    Index: u32
) -> u32 {
    if Operation == WIR_OPERATION_BYTES_SLICE ||
        Operation == WIR_OPERATION_BYTES_READ_U8 ||
        Operation == WIR_OPERATION_BYTES_READ_U16_LITTLE ||
        Operation == WIR_OPERATION_BYTES_READ_U32_LITTLE ||
        Operation == WIR_OPERATION_BYTES_READ_I32_LITTLE ||
        Operation == WIR_OPERATION_BYTES_READ_U64_LITTLE {
        if Index == 0u32 { return 6u32; }
        return 3u32;
    }
    if Operation == WIR_OPERATION_BYTES_CONCAT { return 6u32; }
    if Operation == WIR_OPERATION_TEXT_CONCAT { return 5u32; }
    if Operation == WIR_OPERATION_BYTES_FROM_U8 { return 2u32; }
    if Operation == WIR_OPERATION_BYTES_FROM_U16_LITTLE ||
        Operation == WIR_OPERATION_BYTES_FROM_U32_LITTLE {
        return 3u32;
    }
    if Operation == WIR_OPERATION_BYTES_FROM_I32_LITTLE { return 1u32; }
    if Operation == WIR_OPERATION_BYTES_FROM_U64_LITTLE { return 8u32; }
    if Operation == WIR_OPERATION_U32_FROM_U8 { return 2u32; }
    if Operation == WIR_OPERATION_U64_FROM_U32 { return 3u32; }
    if Operation == WIR_OPERATION_I32_FORMAT { return 1u32; }
    if Operation == WIR_OPERATION_U8_FORMAT { return 2u32; }
    if Operation == WIR_OPERATION_U32_FORMAT { return 3u32; }
    if Operation == WIR_OPERATION_I64_FORMAT { return 7u32; }
    if Operation == WIR_OPERATION_U64_FORMAT { return 8u32; }
    if Operation == WIR_OPERATION_TEXT_QUOTE ||
        Operation == WIR_OPERATION_TEXT_TO_UTF8 {
        return 5u32;
    }
    return 6u32;
}

fn Compilerˉsourceˉwirˉintrinsicˉreturnˉshapeˉfromˉoperation(
    Operation: u32
) -> u32 {
    if Operation == WIR_OPERATION_BYTES_LENGTH ||
        Operation == WIR_OPERATION_BYTES_READ_U16_LITTLE ||
        Operation == WIR_OPERATION_BYTES_READ_U32_LITTLE ||
        Operation == WIR_OPERATION_U32_FROM_U8 {
        return 3u32;
    }
    if Operation == WIR_OPERATION_BYTES_READ_U8 { return 2u32; }
    if Operation == WIR_OPERATION_BYTES_READ_I32_LITTLE { return 1u32; }
    if Operation == WIR_OPERATION_BYTES_READ_U64_LITTLE ||
        Operation == WIR_OPERATION_U64_FROM_U32 {
        return 8u32;
    }
    if Operation == WIR_OPERATION_TEXT_UTF8_IS_VALID { return 4u32; }
    if Operation == WIR_OPERATION_I32_FORMAT ||
        Operation == WIR_OPERATION_U8_FORMAT ||
        Operation == WIR_OPERATION_U32_FORMAT ||
        Operation == WIR_OPERATION_I64_FORMAT ||
        Operation == WIR_OPERATION_U64_FORMAT ||
        Operation == WIR_OPERATION_TEXT_CONCAT ||
        Operation == WIR_OPERATION_BYTES_SHA256_HEX ||
        Operation == WIR_OPERATION_TEXT_FROM_UTF8 ||
        Operation == WIR_OPERATION_TEXT_QUOTE ||
        Operation == WIR_OPERATION_ENUM_NAME {
        return 5u32;
    }
    return 6u32;
}

export fn Compilerˉsourceˉwirˉcapabilityˉparameterˉshape(
    Source: bytes,
    Offset: u32,
    Length: u32,
    Index: u32
) -> u32 {
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "file.write_bytes") {
        if Index == 0u32 { return 5u32; }
        return 6u32;
    }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "filesystem.directory_read_v1") {
        if Index == 0u32 { return 5u32; }
        return 3u32;
    }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "model.catalog_v1") ||
        Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "model.inference_v1") {
        return 6u32;
    }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "standard_output.write_v1") {
        return 6u32;
    }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "process.argument") {
        return 3u32;
    }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "storage.random_access_v1") {
        if Index == 1u32 { return 8u32; }
        if Index == 2u32 { return 8u32; }
        if Index == 4u32 { return 6u32; }
        return 3u32;
    }
    return 5u32;
}

export fn Compilerˉsourceˉwirˉcapabilityˉreturnˉshape(
    Source: bytes,
    Offset: u32,
    Length: u32
) -> u32 {
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "file.read_bytes") { return 6u32; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "filesystem.directory_read_v1") { return 6u32; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "model.catalog_v1") { return 6u32; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "model.inference_v1") { return 6u32; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "process.argument") { return 5u32; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "process.argument_count") { return 3u32; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "standard_output.write_v1") { return 6u32; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "storage.random_access_v1") { return 6u32; }
    return 0u32;
}

export fn Compilerˉsourceˉwirˉdataˉkind(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Match: Sourceˉbindings.Compilerˉsourceˉbindingˉmatch
) -> Compilerˉsourceˉwirˉdataˉkind {
    if !Match.Found { return Compilerˉsourceˉwirˉdataˉkind.None; }
    let Entry: u32 = 16u32 + Match.Directoryˉentry * 24u32;
    let Declarationˉoffset: u32 = Bytesˉreadˉu32ˉlittle(Symbols.Directory, Entry + 8u32);
    let View: Sourceˉset.Compilerˉsourceˉsetˉview = Sourceˉset.Compilerˉsourceˉsetˉmodule(Input, Scan, Match.Module);
    let Declarationˉposition: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
        View.Source, 0u32, 1u32, 1u32, Declarationˉoffset
    );
    let Declaration: Sourceˉdeclarations.Compilerˉsourceˉdeclaration = Sourceˉdeclarations.Compilerˉparseˉnextˉdeclarationˉvalidated(
        View.Source, Declarationˉoffset,
        Declarationˉposition.Line, Declarationˉposition.Column, true
    );
    let Nameˉposition: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
        View.Source, Declarationˉoffset,
        Declarationˉposition.Line, Declarationˉposition.Column,
        Declaration.Nameˉoffset
    );
    let Name: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
        View.Source, Declaration.Nameˉoffset, Nameˉposition.Line, Nameˉposition.Column
    );
    let Colon: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(View.Source, Name.Nextˉoffset, Name.Nextˉline, Name.Nextˉcolumn);
    let Type: Sourceˉdeclarations.Compilerˉparseˉstep = Sourceˉdeclarations.Compilerˉparseˉtype(
        View.Source, Colon.Nextˉoffset, Colon.Nextˉline, Colon.Nextˉcolumn, false, true
    );
    if Type.Typeˉkind == Sourceˉdeclarations.Compilerˉsourceˉtypeˉkind.I32ˉarray {
        return Compilerˉsourceˉwirˉdataˉkind.I32ˉarray;
    }
    if Type.Typeˉkind == Sourceˉdeclarations.Compilerˉsourceˉtypeˉkind.Text {
        return Compilerˉsourceˉwirˉdataˉkind.Text;
    }
    if Type.Typeˉkind == Sourceˉdeclarations.Compilerˉsourceˉtypeˉkind.Bytes {
        return Compilerˉsourceˉwirˉdataˉkind.Bytes;
    }
    return Compilerˉsourceˉwirˉdataˉkind.None;
}

export fn Compilerˉsourceˉwirˉfunctionˉsignatureˉconcrete(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Module: u32,
    Source: bytes,
    Declarationˉoffset: u32,
    Argument: u32,
    Catalog: Sourceˉgenerics.Compilerˉsourceˉgenericˉcatalog,
    Typeˉcatalog: Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog,
    Genericˉinstance: u32
) -> Compilerˉsourceˉwirˉsignature {
    // This reader returns shapes rather than source diagnostics. Starting the
    // target declaration at a relative position preserves token offsets while
    // avoiding a scan from the beginning of its module for every call argument.
    let Declarationˉposition: Sourceˉbodies.Compilerˉsourceˉposition =
        Sourceˉbodies.Compilerˉsourceˉposition(
            Declarationˉoffset, 1u32, 1u32
        );
    let Declaration: Sourceˉdeclarations.Compilerˉsourceˉdeclaration =
        Sourceˉdeclarations.Compilerˉparseˉnextˉdeclarationˉvalidated(
            Source, Declarationˉoffset,
            Declarationˉposition.Line, Declarationˉposition.Column, true
        );
    let Generic: Sourceˉsymbols.Compilerˉsourceˉfunctionˉgeneric =
        Sourceˉsymbols.Compilerˉsourceˉsymbolsˉfunctionˉgeneric(
            Source, Declaration,
            Declarationˉposition.Line, Declarationˉposition.Column
        );
    let Left: Sourceˉlexer.Compilerˉsourceˉtoken =
        Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Source, Generic.Signatureˉoffset,
            Generic.Signatureˉline, Generic.Signatureˉcolumn
        );
    var Cursor: u32 = Left.Nextˉoffset;
    var Currentˉline: u32 = Left.Nextˉline;
    var Currentˉcolumn: u32 = Left.Nextˉcolumn;
    var Parameterˉshape: u32 = 0u32;
    var Parameterˉmode: u32 =
        Sourceˉdeclarations.COMPILER_SOURCE_BORROW_MODE_VALUE;
    var Index: u32 = 0u32;
    var Reading: bool = true;
    while Reading {
        let Current: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Source, Cursor, Currentˉline, Currentˉcolumn
        );
        if Current.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Rightˉparenthesis {
            Reading = false;
            Cursor = Current.Nextˉoffset;
            Currentˉline = Current.Nextˉline;
            Currentˉcolumn = Current.Nextˉcolumn;
        } else {
            let Colon: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                Source, Current.Nextˉoffset, Current.Nextˉline, Current.Nextˉcolumn
            );
            let Parameterˉtype: Sourceˉlexer.Compilerˉsourceˉtoken =
                Sourceˉdeclarations.Compilerˉsourceˉparameterˉtypeˉstart(
                    Source, Colon.Nextˉoffset, Colon.Nextˉline,
                    Colon.Nextˉcolumn
                );
            let Parsedˉtype: Sourceˉdeclarations.Compilerˉparseˉstep =
                Sourceˉdeclarations.Compilerˉparseˉparameterˉtype(
                    Source, Colon.Nextˉoffset, Colon.Nextˉline,
                    Colon.Nextˉcolumn, false
                );
            var Typeˉnextˉoffset: u32 = Parsedˉtype.Nextˉoffset;
            var Typeˉnextˉline: u32 = Parsedˉtype.Nextˉline;
            var Typeˉnextˉcolumn: u32 = Parsedˉtype.Nextˉcolumn;
            if Index == Argument {
                let Currentˉparameterˉmode: u32 =
                    Sourceˉdeclarations.Compilerˉsourceˉparameterˉborrowˉmode(
                        Source, Colon.Nextˉoffset, Colon.Nextˉline,
                        Colon.Nextˉcolumn
                    );
                let Type: Sourceˉsymbols.Compilerˉsourceˉconcreteˉtype =
                    Sourceˉsymbols.Compilerˉsourceˉsymbolsˉbindˉconcreteˉfunctionˉtype(
                        Input, Scan, Symbols.Directory, Symbols.Lookup,
                        Symbols.Visibility, Module, Source,
                        Parameterˉtype.Offset,
                        Parameterˉtype.Line,
                        Parameterˉtype.Column,
                        Symbols.Records, Symbols.Enums, Generic,
                        Catalog, Genericˉinstance, false
                    );
                var Typeˉshape: u32 = Type.Shape;
                Typeˉnextˉoffset = Type.Nextˉoffset;
                Typeˉnextˉline = Type.Nextˉline;
                Typeˉnextˉcolumn = Type.Nextˉcolumn;
                if Type.Status ==
                        Sourceˉsymbols.Compilerˉsourceˉsymbolˉstatus.Unknownˉtype &&
                    Generic.Parameters == 0u32 {
                    let General:
                        Genericˉtypeˉbinding.Compilerˉsourceˉgenericˉtypeˉbinding =
                        Genericˉtypeˉbinding.Compilerˉsourceˉgenericˉtypeˉbind(
                            Input, Scan, Symbols, Module, Source,
                            Parameterˉtype.Offset,
                            Parameterˉtype.Line,
                            Parameterˉtype.Column,
                            0u32, 0u32, 0u32, 0u32,
                            Typeˉcatalog
                        );
                    Typeˉshape = General.Shape;
                    Typeˉnextˉoffset = General.Nextˉoffset;
                    Typeˉnextˉline = General.Nextˉline;
                    Typeˉnextˉcolumn = General.Nextˉcolumn;
                }
                if Type.Status ==
                        Sourceˉsymbols.Compilerˉsourceˉsymbolˉstatus.Unknownˉtype &&
                    Generic.Parameters > 0u32 &&
                    Genericˉinstance != Compilerˉsourceˉwirˉsentinel() {
                    let Specialized:
                        Genericˉtypeˉbinding.Compilerˉsourceˉgenericˉtypeˉbinding =
                        Genericˉtypeˉbinding.Compilerˉsourceˉgenericˉtypeˉbindˉfunctionˉspecialization(
                            Input, Scan, Symbols, Module, Source,
                            Parameterˉtype.Offset,
                            Parameterˉtype.Line,
                            Parameterˉtype.Column,
                            0u32, 0u32, 0u32, 0u32,
                            Typeˉcatalog, Source, Generic, Catalog,
                            Genericˉinstance
                        );
                    Typeˉshape = Specialized.Shape;
                    Typeˉnextˉoffset = Specialized.Nextˉoffset;
                    Typeˉnextˉline = Specialized.Nextˉline;
                    Typeˉnextˉcolumn = Specialized.Nextˉcolumn;
                }
                Parameterˉshape = Typeˉshape;
                Parameterˉmode = Currentˉparameterˉmode;
            }
            let Separator: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                Source, Typeˉnextˉoffset, Typeˉnextˉline, Typeˉnextˉcolumn
            );
            if Separator.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Comma {
                Cursor = Separator.Nextˉoffset;
                Currentˉline = Separator.Nextˉline;
                Currentˉcolumn = Separator.Nextˉcolumn;
            } else {
                Cursor = Separator.Nextˉoffset;
                Currentˉline = Separator.Nextˉline;
                Currentˉcolumn = Separator.Nextˉcolumn;
                Reading = false;
            }
            Index = Index + 1u32;
        }
    }
    let Arrow: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
        Source, Cursor, Currentˉline, Currentˉcolumn
    );
    let Returnˉparameterˉtype: Sourceˉlexer.Compilerˉsourceˉtoken =
        Sourceˉdeclarations.Compilerˉsourceˉparameterˉtypeˉstart(
            Source, Arrow.Nextˉoffset, Arrow.Nextˉline,
            Arrow.Nextˉcolumn
        );
    let Returnˉmode: u32 =
        Sourceˉdeclarations.Compilerˉsourceˉparameterˉborrowˉmode(
            Source, Arrow.Nextˉoffset, Arrow.Nextˉline,
            Arrow.Nextˉcolumn
        );
    let Returnˉtype: Sourceˉsymbols.Compilerˉsourceˉconcreteˉtype =
        Sourceˉsymbols.Compilerˉsourceˉsymbolsˉbindˉconcreteˉfunctionˉtype(
            Input, Scan, Symbols.Directory, Symbols.Lookup,
            Symbols.Visibility, Module, Source,
            Returnˉparameterˉtype.Offset,
            Returnˉparameterˉtype.Line,
            Returnˉparameterˉtype.Column,
            Symbols.Records, Symbols.Enums, Generic,
            Catalog, Genericˉinstance, false
        );
    var Returnˉshape: u32 = Returnˉtype.Shape;
    if Returnˉtype.Status ==
            Sourceˉsymbols.Compilerˉsourceˉsymbolˉstatus.Unknownˉtype &&
        Generic.Parameters == 0u32 {
        let Generalˉreturn:
            Genericˉtypeˉbinding.Compilerˉsourceˉgenericˉtypeˉbinding =
            Genericˉtypeˉbinding.Compilerˉsourceˉgenericˉtypeˉbind(
                Input, Scan, Symbols, Module, Source,
                Returnˉparameterˉtype.Offset,
                Returnˉparameterˉtype.Line,
                Returnˉparameterˉtype.Column,
                0u32, 0u32, 0u32, 0u32,
                Typeˉcatalog
            );
        Returnˉshape = Generalˉreturn.Shape;
    }
    if Returnˉtype.Status ==
            Sourceˉsymbols.Compilerˉsourceˉsymbolˉstatus.Unknownˉtype &&
        Generic.Parameters > 0u32 &&
        Genericˉinstance != Compilerˉsourceˉwirˉsentinel() {
        let Specializedˉreturn:
            Genericˉtypeˉbinding.Compilerˉsourceˉgenericˉtypeˉbinding =
            Genericˉtypeˉbinding.Compilerˉsourceˉgenericˉtypeˉbindˉfunctionˉspecialization(
                Input, Scan, Symbols, Module, Source,
                Returnˉparameterˉtype.Offset,
                Returnˉparameterˉtype.Line,
                Returnˉparameterˉtype.Column,
                0u32, 0u32, 0u32, 0u32,
                Typeˉcatalog, Source, Generic, Catalog, Genericˉinstance
            );
        Returnˉshape = Specializedˉreturn.Shape;
    }
    return Compilerˉsourceˉwirˉsignature(
        Parameterˉshape, Returnˉshape, 0u32, 0u32,
        Parameterˉmode, Returnˉmode
    );
}

export fn Compilerˉsourceˉwirˉfunctionˉsignature(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Module: u32,
    Source: bytes,
    Declarationˉoffset: u32,
    Argument: u32
) -> Compilerˉsourceˉwirˉsignature {
    return Compilerˉsourceˉwirˉfunctionˉsignatureˉconcrete(
        Input, Scan, Symbols, Module, Source, Declarationˉoffset, Argument,
        Sourceˉgenerics.Compilerˉsourceˉgenericˉcatalogˉempty(),
        Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalogˉempty(),
        Compilerˉsourceˉwirˉsentinel()
    );
}

export fn Compilerˉsourceˉwirˉrecordˉsignature(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Callable: Sourceˉbindings.Compilerˉsourceˉbindingˉmatch,
    Argument: u32
) -> Compilerˉsourceˉwirˉsignature {
    let Entry: u32 = 16u32 + Callable.Directoryˉentry * 24u32;
    let Declarationˉoffset: u32 = Bytesˉreadˉu32ˉlittle(Symbols.Directory, Entry + 8u32);
    let Nameˉoffset: u32 = Bytesˉreadˉu32ˉlittle(Symbols.Directory, Entry + 12u32);
    let Nameˉlength: u32 = Bytesˉreadˉu32ˉlittle(Symbols.Directory, Entry + 16u32);
    let View: Sourceˉset.Compilerˉsourceˉsetˉview = Sourceˉset.Compilerˉsourceˉsetˉmodule(Input, Scan, Callable.Module);
    let Directoryˉentries: u32 = Bytesˉreadˉu32ˉlittle(Symbols.Directory, 8u32);
    let Nominals: u32 = Symbols.Records + Symbols.Enums + Symbols.Variants;
    let Nominalˉindex: u32 = Bytesˉreadˉu32ˉlittle(
        Symbols.Lookup,
        4112u32 + Directoryˉentries * 4u32 + Nominals * 4u32 + Callable.Directoryˉentry * 4u32
    );
    let Declarationˉposition: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
        View.Source, 0u32, 1u32, 1u32, Declarationˉoffset
    );
    let Declaration: Sourceˉdeclarations.Compilerˉsourceˉdeclaration = Sourceˉdeclarations.Compilerˉparseˉnextˉdeclarationˉvalidated(
        View.Source, Declarationˉoffset,
        Declarationˉposition.Line, Declarationˉposition.Column, true
    );
    let Bodyˉposition: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
        View.Source, Declarationˉoffset,
        Declarationˉposition.Line, Declarationˉposition.Column,
        Declaration.Bodyˉoffset
    );
    let Left: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
        View.Source, Declaration.Bodyˉoffset, Bodyˉposition.Line, Bodyˉposition.Column
    );
    var Cursor: u32 = Left.Nextˉoffset;
    var Currentˉline: u32 = Left.Nextˉline;
    var Currentˉcolumn: u32 = Left.Nextˉcolumn;
    var Parameterˉshape: u32 = 0u32;
    var Index: u32 = 0u32;
    while Index <= Argument {
        let Field: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            View.Source, Cursor, Currentˉline, Currentˉcolumn
        );
        let Colon: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            View.Source, Field.Nextˉoffset, Field.Nextˉline, Field.Nextˉcolumn
        );
        let Type: Sourceˉsymbols.Compilerˉsourceˉtypeˉbinding = Sourceˉsymbols.Compilerˉsourceˉsymbolsˉbindˉtype(
            Input, Scan, Symbols.Directory, Symbols.Lookup, Symbols.Visibility,
            Callable.Module, View.Source,
            Colon.Nextˉoffset, Colon.Nextˉline, Colon.Nextˉcolumn,
            Symbols.Records, Symbols.Enums, true
        );
        if Index == Argument {
            Parameterˉshape = Sourceˉbindings.Compilerˉsourceˉbindingsˉshape(Type);
        }
        let End: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            View.Source, Type.Nextˉoffset, Type.Nextˉline, Type.Nextˉcolumn
        );
        Cursor = End.Nextˉoffset;
        Currentˉline = End.Nextˉline;
        Currentˉcolumn = End.Nextˉcolumn;
        Index = Index + 1u32;
    }
    return Compilerˉsourceˉwirˉsignature(
        Parameterˉshape,
        65536u32 + Nominalˉindex,
        Nominalˉindex,
        Callable.Directoryˉentry,
        Sourceˉdeclarations.COMPILER_SOURCE_BORROW_MODE_VALUE,
        Sourceˉdeclarations.COMPILER_SOURCE_BORROW_MODE_VALUE
    );
}

export fn Compilerˉsourceˉwirˉcallableˉsignatureˉconcrete(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Callable: Sourceˉbindings.Compilerˉsourceˉbindingˉmatch,
    Nameˉsource: bytes,
    Nameˉoffset: u32,
    Nameˉlength: u32,
    Argument: u32,
    Catalog: Sourceˉgenerics.Compilerˉsourceˉgenericˉcatalog,
    Typeˉcatalog: Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog,
    Genericˉinstance: u32
) -> Compilerˉsourceˉwirˉsignature {
    if Callable.Kind == Sourceˉbindings.Compilerˉsourceˉcallableˉkind.Intrinsic {
        if Callable.Directoryˉentry ==
                WIR_OPERATION_FOUNDATION_SEQUENCE_LENGTH {
            return Compilerˉsourceˉwirˉsignature(
                0u32, 8u32, Compilerˉsourceˉwirˉsentinel(), 0u32,
                Sourceˉdeclarations.COMPILER_SOURCE_BORROW_MODE_IMMUTABLE,
                Sourceˉdeclarations.COMPILER_SOURCE_BORROW_MODE_VALUE
            );
        }
        if Callable.Directoryˉentry ==
                WIR_OPERATION_FOUNDATION_SEQUENCE_ELEMENT {
            var Sequenceˉparameterˉshape: u32 = 0u32;
            var Sequenceˉparameterˉmode: u32 =
                Sourceˉdeclarations.COMPILER_SOURCE_BORROW_MODE_VALUE;
            if Argument == 0u32 {
                Sequenceˉparameterˉmode =
                    Sourceˉdeclarations.COMPILER_SOURCE_BORROW_MODE_IMMUTABLE;
            } else {
                Sequenceˉparameterˉshape = 8u32;
            }
            return Compilerˉsourceˉwirˉsignature(
                Sequenceˉparameterˉshape, 0u32,
                Compilerˉsourceˉwirˉsentinel(), 0u32,
                Sequenceˉparameterˉmode,
                Sourceˉdeclarations.COMPILER_SOURCE_BORROW_MODE_VALUE
            );
        }
        if Callable.Directoryˉentry ==
                WIR_OPERATION_FOUNDATION_VECTOR_LENGTH {
            return Compilerˉsourceˉwirˉsignature(
                0u32, 8u32, Compilerˉsourceˉwirˉsentinel(), 0u32,
                Sourceˉdeclarations.COMPILER_SOURCE_BORROW_MODE_IMMUTABLE,
                Sourceˉdeclarations.COMPILER_SOURCE_BORROW_MODE_VALUE
            );
        }
        if Callable.Directoryˉentry ==
                WIR_OPERATION_FOUNDATION_VECTOR_FREEZE {
            return Compilerˉsourceˉwirˉsignature(
                0u32, 0u32, Compilerˉsourceˉwirˉsentinel(), 0u32,
                Sourceˉdeclarations.COMPILER_SOURCE_BORROW_MODE_VALUE,
                Sourceˉdeclarations.COMPILER_SOURCE_BORROW_MODE_VALUE
            );
        }
        return Compilerˉsourceˉwirˉsignature(
            Compilerˉsourceˉwirˉintrinsicˉparameterˉshapeˉfromˉoperation(
                Callable.Directoryˉentry, Argument
            ),
            Compilerˉsourceˉwirˉintrinsicˉreturnˉshapeˉfromˉoperation(
                Callable.Directoryˉentry
            ),
            Compilerˉsourceˉwirˉsentinel(),
            0u32,
            Sourceˉdeclarations.COMPILER_SOURCE_BORROW_MODE_VALUE,
            Sourceˉdeclarations.COMPILER_SOURCE_BORROW_MODE_VALUE
        );
    }
    if Callable.Kind == Sourceˉbindings.Compilerˉsourceˉcallableˉkind.Capability {
        let Capabilityˉentry: u32 = 16u32 + Callable.Directoryˉentry * 24u32;
        let Capabilityˉview: Sourceˉset.Compilerˉsourceˉsetˉview = Sourceˉset.Compilerˉsourceˉsetˉmodule(
            Input, Scan, Callable.Module
        );
        let Capabilityˉnameˉoffset: u32 = Bytesˉreadˉu32ˉlittle(
            Symbols.Directory, Capabilityˉentry + 12u32
        );
        let Capabilityˉnameˉlength: u32 = Bytesˉreadˉu32ˉlittle(
            Symbols.Directory, Capabilityˉentry + 16u32
        );
        return Compilerˉsourceˉwirˉsignature(
            Compilerˉsourceˉwirˉcapabilityˉparameterˉshape(
                Capabilityˉview.Source,
                Capabilityˉnameˉoffset,
                Capabilityˉnameˉlength,
                Argument
            ),
            Compilerˉsourceˉwirˉcapabilityˉreturnˉshape(
                Capabilityˉview.Source,
                Capabilityˉnameˉoffset,
                Capabilityˉnameˉlength
            ),
            Callable.Directoryˉentry,
            0u32,
            Sourceˉdeclarations.COMPILER_SOURCE_BORROW_MODE_VALUE,
            Sourceˉdeclarations.COMPILER_SOURCE_BORROW_MODE_VALUE
        );
    }
    if Callable.Kind == Sourceˉbindings.Compilerˉsourceˉcallableˉkind.Record {
        return Compilerˉsourceˉwirˉrecordˉsignature(
            Input, Scan, Symbols, Callable, Argument
        );
    }
    if Callable.Kind == Sourceˉbindings.Compilerˉsourceˉcallableˉkind.Variantˉcase {
        let Nominal: Sourceˉsymbols.Compilerˉsourceˉsymbolˉmatch = Sourceˉsymbols.Compilerˉsourceˉsymbolsˉdirectoryˉentry(
            Symbols.Directory, Scan.Modules, Callable.Directoryˉentry
        );
        var Lastˉdot: u32 = Nameˉlength;
        var Character: u32 = 0u32;
        while Character < Nameˉlength {
            if Bytesˉreadˉu8(Nameˉsource, Nameˉoffset + Character) == 46u8 { Lastˉdot = Character; }
            Character = Character + 1u32;
        }
        let Member: Compilerˉsourceˉwirˉmember = Compilerˉsourceˉwirˉnominalˉmember(
            Input, Scan, Symbols, Nominal,
            Nameˉsource, Nameˉoffset + Lastˉdot + 1u32, Nameˉlength - Lastˉdot - 1u32
        );
        let Entries: u32 = Bytesˉreadˉu32ˉlittle(Symbols.Directory, 8u32);
        let Nominals: u32 = Symbols.Records + Symbols.Enums + Symbols.Variants;
        let Nominalˉindex: u32 = Bytesˉreadˉu32ˉlittle(
            Symbols.Lookup,
            4112u32 + Entries * 4u32 + Nominals * 4u32 + Callable.Directoryˉentry * 4u32
        );
        let Field: Compilerˉsourceˉwirˉmember =
            Compilerˉsourceˉwirˉvariantˉfieldˉbyˉindex(
                Input, Scan, Symbols,
                Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalogˉempty(),
                Nominalˉindex, Member.Index, Argument
            );
        var Parameterˉshape: u32 = 0u32;
        if Field.Found { Parameterˉshape = Field.Shape; }
        return Compilerˉsourceˉwirˉsignature(
            Parameterˉshape,
            196608u32 + Nominalˉindex,
            Nominalˉindex,
            Member.Index,
            Sourceˉdeclarations.COMPILER_SOURCE_BORROW_MODE_VALUE,
            Sourceˉdeclarations.COMPILER_SOURCE_BORROW_MODE_VALUE
        );
    }
    let Entry: u32 = 16u32 + Callable.Directoryˉentry * 24u32;
    let Declarationˉoffset: u32 = Bytesˉreadˉu32ˉlittle(Symbols.Directory, Entry + 8u32);
    let View: Sourceˉset.Compilerˉsourceˉsetˉview = Sourceˉset.Compilerˉsourceˉsetˉmodule(Input, Scan, Callable.Module);
    let Function: Compilerˉsourceˉwirˉsignature = Compilerˉsourceˉwirˉfunctionˉsignatureˉconcrete(
        Input, Scan, Symbols, Callable.Module, View.Source,
        Declarationˉoffset, Argument, Catalog, Typeˉcatalog, Genericˉinstance
    );
    return Compilerˉsourceˉwirˉsignature(
        Function.Parameterˉshape,
        Function.Returnˉshape,
        Callable.Directoryˉentry,
        0u32,
        Function.Parameterˉmode,
        Function.Returnˉmode
    );
}

export fn Compilerˉsourceˉwirˉcallableˉsignature(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Callable: Sourceˉbindings.Compilerˉsourceˉbindingˉmatch,
    Nameˉsource: bytes,
    Nameˉoffset: u32,
    Nameˉlength: u32,
    Argument: u32
) -> Compilerˉsourceˉwirˉsignature {
    return Compilerˉsourceˉwirˉcallableˉsignatureˉconcrete(
        Input, Scan, Symbols, Callable,
        Nameˉsource, Nameˉoffset, Nameˉlength, Argument,
        Sourceˉgenerics.Compilerˉsourceˉgenericˉcatalogˉempty(),
        Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalogˉempty(),
        Compilerˉsourceˉwirˉsentinel()
    );
}

export fn Compilerˉsourceˉwirˉnominalˉbyˉshape(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Shape: u32
) -> Sourceˉsymbols.Compilerˉsourceˉsymbolˉmatch {
    var Wanted: u32 = Shape - 65536u32;
    if Shape >= 131072u32 { Wanted = Shape - 131072u32; }
    if Shape >= 196608u32 { Wanted = Shape - 196608u32; }
    if Wanted >= Symbols.Records + Symbols.Enums + Symbols.Variants {
        return Sourceˉsymbols.Compilerˉsourceˉsymbolsˉmatchˉnone(Scan.Modules);
    }
    let Entries: u32 = Bytesˉreadˉu32ˉlittle(Symbols.Directory, 8u32);
    let Directoryˉindex: u32 = Bytesˉreadˉu32ˉlittle(
        Symbols.Lookup, 4112u32 + Entries * 4u32 + Wanted * 4u32
    );
    return Sourceˉsymbols.Compilerˉsourceˉsymbolsˉdirectoryˉentry(
        Symbols.Directory, Scan.Modules, Directoryˉindex
    );
}

fn Compilerˉsourceˉwirˉvariantˉtarget(Shape: u32) -> u32 {
    if Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉshapeˉisˉprivate(
            Shape
        ) {
        return Shape;
    }
    return Shape - 196608u32;
}

export fn Compilerˉsourceˉwirˉnominalˉmember(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Nominal: Sourceˉsymbols.Compilerˉsourceˉsymbolˉmatch,
    Queryˉsource: bytes,
    Queryˉoffset: u32,
    Queryˉlength: u32
) -> Compilerˉsourceˉwirˉmember {
    if !Nominal.Found { return Compilerˉsourceˉwirˉmember(false, 0u32, 0u32); }
    let View: Sourceˉset.Compilerˉsourceˉsetˉview = Sourceˉset.Compilerˉsourceˉsetˉmodule(Input, Scan, Nominal.Module);
    let Declarationˉposition: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
        View.Source, 0u32, 1u32, 1u32, Nominal.Declarationˉoffset
    );
    let Declaration: Sourceˉdeclarations.Compilerˉsourceˉdeclaration = Sourceˉdeclarations.Compilerˉparseˉnextˉdeclarationˉvalidated(
        View.Source, Nominal.Declarationˉoffset,
        Declarationˉposition.Line, Declarationˉposition.Column, true
    );
    let Bodyˉposition: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
        View.Source, Nominal.Declarationˉoffset,
        Declarationˉposition.Line, Declarationˉposition.Column,
        Declaration.Bodyˉoffset
    );
    let Left: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
        View.Source, Declaration.Bodyˉoffset, Bodyˉposition.Line, Bodyˉposition.Column
    );
    var Cursor: u32 = Left.Nextˉoffset;
    var Currentˉline: u32 = Left.Nextˉline;
    var Currentˉcolumn: u32 = Left.Nextˉcolumn;
    var Index: u32 = 0u32;
    var Reading: bool = true;
    while Reading {
        let Member: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            View.Source, Cursor, Currentˉline, Currentˉcolumn
        );
        if Member.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Rightˉbrace {
            Reading = false;
        } else {
            if Member.Length == Queryˉlength {
                if Sourceˉset.Compilerˉsourceˉspansˉequal(
                    View.Source, Member.Offset, Member.Length,
                    Queryˉsource, Queryˉoffset, Queryˉlength
                ) {
                if Nominal.Kind == Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Enum {
                    let Directoryˉentries: u32 = Bytesˉreadˉu32ˉlittle(Symbols.Directory, 8u32);
                    let Nominals: u32 = Symbols.Records + Symbols.Enums + Symbols.Variants;
                    let Shape: u32 = 131072u32 + Bytesˉreadˉu32ˉlittle(
                        Symbols.Lookup,
                        4112u32 + Directoryˉentries * 4u32 + Nominals * 4u32 +
                            Nominal.Directoryˉindex * 4u32
                    );
                    return Compilerˉsourceˉwirˉmember(true, Index, Shape);
                }
                if Nominal.Kind == Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Variant {
                    let Afterˉname: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                        View.Source, Member.Nextˉoffset, Member.Nextˉline, Member.Nextˉcolumn
                    );
                    if Afterˉname.Kind != Sourceˉlexer.Compilerˉtokenˉkind.Leftˉparenthesis {
                        return Compilerˉsourceˉwirˉmember(true, Index, 0u32);
                    }
                    let Payloadˉname: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                        View.Source, Afterˉname.Nextˉoffset, Afterˉname.Nextˉline, Afterˉname.Nextˉcolumn
                    );
                    let Payloadˉcolon: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                        View.Source, Payloadˉname.Nextˉoffset, Payloadˉname.Nextˉline, Payloadˉname.Nextˉcolumn
                    );
                    let Payloadˉtype: Sourceˉsymbols.Compilerˉsourceˉtypeˉbinding = Sourceˉsymbols.Compilerˉsourceˉsymbolsˉbindˉtype(
                        Input, Scan, Symbols.Directory, Symbols.Lookup, Symbols.Visibility,
                        Nominal.Module, View.Source,
                        Payloadˉcolon.Nextˉoffset, Payloadˉcolon.Nextˉline, Payloadˉcolon.Nextˉcolumn,
                        Symbols.Records, Symbols.Enums, false
                    );
                    return Compilerˉsourceˉwirˉmember(
                        true, Index, Sourceˉbindings.Compilerˉsourceˉbindingsˉshape(Payloadˉtype)
                    );
                }
                let Matchedˉcolon: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                    View.Source, Member.Nextˉoffset, Member.Nextˉline, Member.Nextˉcolumn
                );
                let Matchedˉtype: Sourceˉsymbols.Compilerˉsourceˉtypeˉbinding = Sourceˉsymbols.Compilerˉsourceˉsymbolsˉbindˉtype(
                    Input, Scan, Symbols.Directory, Symbols.Lookup, Symbols.Visibility,
                    Nominal.Module, View.Source,
                    Matchedˉcolon.Nextˉoffset, Matchedˉcolon.Nextˉline, Matchedˉcolon.Nextˉcolumn,
                    Symbols.Records, Symbols.Enums, true
                );
                return Compilerˉsourceˉwirˉmember(
                    true, Index, Sourceˉbindings.Compilerˉsourceˉbindingsˉshape(Matchedˉtype)
                );
                }
            }
            if Nominal.Kind == Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Record {
                let Recordˉcolon: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                    View.Source, Member.Nextˉoffset, Member.Nextˉline, Member.Nextˉcolumn
                );
                let Recordˉtype: Sourceˉdeclarations.Compilerˉparseˉstep = Sourceˉdeclarations.Compilerˉparseˉtype(
                    View.Source, Recordˉcolon.Nextˉoffset, Recordˉcolon.Nextˉline, Recordˉcolon.Nextˉcolumn, false, false
                );
                let Recordˉend: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                    View.Source, Recordˉtype.Nextˉoffset, Recordˉtype.Nextˉline, Recordˉtype.Nextˉcolumn
                );
                Cursor = Recordˉend.Nextˉoffset;
                Currentˉline = Recordˉend.Nextˉline;
                Currentˉcolumn = Recordˉend.Nextˉcolumn;
            } else if Nominal.Kind == Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Enum {
                let Enumˉequals: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                    View.Source, Member.Nextˉoffset, Member.Nextˉline, Member.Nextˉcolumn
                );
                let Enumˉvalue: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                    View.Source, Enumˉequals.Nextˉoffset, Enumˉequals.Nextˉline, Enumˉequals.Nextˉcolumn
                );
                var Enumˉliteral: Sourceˉlexer.Compilerˉsourceˉtoken = Enumˉvalue;
                if Enumˉvalue.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Minus {
                    Enumˉliteral = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                        View.Source, Enumˉvalue.Nextˉoffset,
                        Enumˉvalue.Nextˉline, Enumˉvalue.Nextˉcolumn
                    );
                }
                let Enumˉend: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                    View.Source, Enumˉliteral.Nextˉoffset,
                    Enumˉliteral.Nextˉline, Enumˉliteral.Nextˉcolumn
                );
                Cursor = Enumˉend.Nextˉoffset;
                Currentˉline = Enumˉend.Nextˉline;
                Currentˉcolumn = Enumˉend.Nextˉcolumn;
            } else {
                let Variantˉafterˉname: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                    View.Source, Member.Nextˉoffset, Member.Nextˉline, Member.Nextˉcolumn
                );
                var Variantˉend: Sourceˉlexer.Compilerˉsourceˉtoken = Variantˉafterˉname;
                if Variantˉafterˉname.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Leftˉparenthesis {
                    var Fieldˉcursor: u32 = Variantˉafterˉname.Nextˉoffset;
                    var Fieldˉline: u32 = Variantˉafterˉname.Nextˉline;
                    var Fieldˉcolumn: u32 = Variantˉafterˉname.Nextˉcolumn;
                    var Readingˉfields: bool = true;
                    while Readingˉfields {
                        let Field: Sourceˉdeclarations.Compilerˉsourceˉvariantˉfield =
                            Sourceˉdeclarations.Compilerˉparseˉvariantˉfield(
                                View.Source, Fieldˉcursor, Fieldˉline,
                                Fieldˉcolumn
                            );
                        let Separator: Sourceˉlexer.Compilerˉsourceˉtoken =
                            Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                                View.Source, Field.Nextˉoffset,
                                Field.Nextˉline, Field.Nextˉcolumn
                            );
                        if Separator.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Comma {
                            let Memberˉafterˉcomma:
                                Sourceˉlexer.Compilerˉsourceˉtoken =
                                Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                                    View.Source, Separator.Nextˉoffset,
                                    Separator.Nextˉline,
                                    Separator.Nextˉcolumn
                                );
                            if Memberˉafterˉcomma.Kind ==
                                Sourceˉlexer.Compilerˉtokenˉkind.Rightˉparenthesis {
                                Readingˉfields = false;
                                Variantˉend =
                                    Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                                        View.Source,
                                        Memberˉafterˉcomma.Nextˉoffset,
                                        Memberˉafterˉcomma.Nextˉline,
                                        Memberˉafterˉcomma.Nextˉcolumn
                                    );
                            } else {
                                Fieldˉcursor = Separator.Nextˉoffset;
                                Fieldˉline = Separator.Nextˉline;
                                Fieldˉcolumn = Separator.Nextˉcolumn;
                            }
                        } else {
                            Readingˉfields = false;
                            Variantˉend = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                                View.Source, Separator.Nextˉoffset,
                                Separator.Nextˉline, Separator.Nextˉcolumn
                            );
                        }
                    }
                }
                Cursor = Variantˉend.Nextˉoffset;
                Currentˉline = Variantˉend.Nextˉline;
                Currentˉcolumn = Variantˉend.Nextˉcolumn;
            }
            Index = Index + 1u32;
        }
    }
    return Compilerˉsourceˉwirˉmember(false, 0u32, 0u32);
}

export fn Compilerˉsourceˉwirˉfailureˉvalue(
    Build: Compilerˉsourceˉwirˉbuild,
    Status: Compilerˉsourceˉwirˉstatus,
    Relatedˉmodule: u32,
    Offset: u32,
    Line: u32,
    Column: u32
) -> Compilerˉsourceˉwirˉvalue {
    let Failed: Compilerˉsourceˉwirˉbuild = Compilerˉsourceˉwirˉbuildˉfailure(
        Build,
        Status,
        Build.Currentˉmodule,
        Relatedˉmodule,
        Build.Currentˉfunction,
        Offset,
        Line,
        Column
    );
    return Compilerˉsourceˉwirˉvalueˉfrom(
        Failed, 0u32, Compilerˉsourceˉwirˉsentinel()
    );
}

fn Compilerˉsourceˉwirˉfunctionˉreferenceˉfailure(
    Build: Compilerˉsourceˉwirˉbuild
) -> Compilerˉsourceˉwirˉfunctionˉreference {
    return Compilerˉsourceˉwirˉfunctionˉreference(
        false, Build, 0u32, Compilerˉsourceˉwirˉsentinel()
    );
}

fn Compilerˉsourceˉwirˉfunctionˉflags(
    Source: bytes,
    Declaration: Sourceˉdeclarations.Compilerˉsourceˉdeclaration
) -> u32 {
    var Current: Sourceˉlexer.Compilerˉsourceˉtoken =
        Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Source, Declaration.Declarationˉoffset, 1u32, 1u32
        );
    if Current.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Export {
        Current = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Source, Current.Nextˉoffset,
            Current.Nextˉline, Current.Nextˉcolumn
        );
    }
    var Flags: u32 = 0u32;
    if Current.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Unsafe {
        Flags = Flags | 2u32;
        Current = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Source, Current.Nextˉoffset,
            Current.Nextˉline, Current.Nextˉcolumn
        );
    }
    if Current.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Async {
        Flags = Flags | 1u32;
    }
    return Flags;
}

fn Compilerˉsourceˉwirˉprofileˉidentity(
    Header: Sourceˉdeclarations.Compilerˉsourceˉheader
) -> u32 {
    if Header.Profile ==
        Sourceˉdeclarations.Compilerˉsourceˉprofile.Portable {
        return 1u32;
    }
    if Header.Profile ==
        Sourceˉdeclarations.Compilerˉsourceˉprofile.Hosted {
        return 2u32;
    }
    if Header.Profile ==
        Sourceˉdeclarations.Compilerˉsourceˉprofile.System {
        return 3u32;
    }
    return 0u32;
}

fn Compilerˉsourceˉwirˉsymbolˉentries(
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary
) -> u32 {
    if Bytesˉlength(Symbols.Directory) < 16u32 { return 0u32; }
    return Bytesˉreadˉu32ˉlittle(Symbols.Directory, 8u32);
}

fn Compilerˉsourceˉwirˉclosureˉsignatureˉfailure(
    Build: Compilerˉsourceˉwirˉbuild,
    Source: bytes
) -> Compilerˉsourceˉwirˉclosureˉsignature {
    return Compilerˉsourceˉwirˉclosureˉsignature(
        false, Build, 0u32, Compilerˉsourceˉwirˉempty(Source), 0u32
    );
}

fn Compilerˉsourceˉwirˉclosureˉcaptureˉshapeˉisˉplain(
    Shape: u32
) -> bool {
    return Shape == 1u32 || Shape == 2u32 || Shape == 4u32 ||
        Shape == 5u32 || Shape == 7u32 || Shape == 8u32 ||
        (Shape >= 11u32 && Shape <= 16u32) ||
        (Shape >= 131072u32 && Shape < 196608u32);
}

fn Compilerˉsourceˉwirˉclosureˉcaptureˉbindingˉkind(
    Bindingˉpayload: bytes,
    Bindingˉfirst: u32,
    Bindingˉentries: u32,
    Slot: u32
) -> u32 {
    if Bindingˉfirst > Bindingˉentries ||
        Slot >= Bindingˉentries - Bindingˉfirst {
        return Compilerˉsourceˉwirˉsentinel();
    }
    let Entry: u32 = (Bindingˉfirst + Slot) * 36u32;
    if Entry > Bytesˉlength(Bindingˉpayload) ||
        Bytesˉlength(Bindingˉpayload) - Entry < 36u32 {
        return Compilerˉsourceˉwirˉsentinel();
    }
    return Bytesˉreadˉu32ˉlittle(Bindingˉpayload, Entry + 8u32);
}

fn Compilerˉsourceˉwirˉclosureˉsignatureˉread(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Source: bytes,
    Expression: Sourceˉbodies.Compilerˉsourceˉexpression,
    Build: Compilerˉsourceˉwirˉbuild
) -> Compilerˉsourceˉwirˉclosureˉsignature {
    let Header: Sourceˉdeclarations.Compilerˉsourceˉheader =
        Sourceˉdeclarations.Compilerˉparseˉheaderˉvalidated(Source);
    let Profile: u32 = Compilerˉsourceˉwirˉprofileˉidentity(Header);
    if Profile == 0u32 || Expression.Status !=
            Sourceˉbodies.Compilerˉbodyˉparseˉstatus.Valid ||
        Expression.Kind != Sourceˉbodies.Compilerˉsourceˉexpressionˉkind.Closure {
        return Compilerˉsourceˉwirˉclosureˉsignatureˉfailure(Build, Source);
    }
    var Result: Compilerˉsourceˉwirˉbuild = Build;
    var Parameters: bytes = Compilerˉsourceˉwirˉempty(Source);
    let Parameterˉposition: Sourceˉbodies.Compilerˉsourceˉposition =
        Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
            Source, Expression.Offset, Expression.Line, Expression.Column,
            Expression.Itemsˉoffset
        );
    var Cursor: u32 = Expression.Itemsˉoffset;
    var Currentˉline: u32 = Parameterˉposition.Line;
    var Currentˉcolumn: u32 = Parameterˉposition.Column;
    var Parameter: u32 = 0u32;
    while Parameter < Expression.Numericˉvalue {
        let Name: Sourceˉlexer.Compilerˉsourceˉtoken =
            Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                Source, Cursor, Currentˉline, Currentˉcolumn
            );
        let Colon: Sourceˉlexer.Compilerˉsourceˉtoken =
            Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                Source, Name.Nextˉoffset, Name.Nextˉline, Name.Nextˉcolumn
            );
        let Typeˉstart: Sourceˉlexer.Compilerˉsourceˉtoken =
            Sourceˉdeclarations.Compilerˉsourceˉparameterˉtypeˉstart(
                Source, Colon.Nextˉoffset, Colon.Nextˉline, Colon.Nextˉcolumn
            );
        let Mode: u32 =
            Sourceˉdeclarations.Compilerˉsourceˉparameterˉborrowˉmode(
                Source, Colon.Nextˉoffset, Colon.Nextˉline, Colon.Nextˉcolumn
            );
        let Type: Compilerˉsourceˉwirˉgenericˉtypeˉscan =
            Compilerˉsourceˉwirˉscanˉgenericˉtype(
                Input, Scan, Symbols, Build.Currentˉmodule, Source,
                Typeˉstart.Offset, Typeˉstart.Line, Typeˉstart.Column,
                false,
                Compilerˉsourceˉwirˉgenericˉtypeˉcatalog(
                    Result.Genericˉevidence
                )
            );
        if Name.Kind != Sourceˉlexer.Compilerˉtokenˉkind.Identifier ||
            Colon.Kind != Sourceˉlexer.Compilerˉtokenˉkind.Colon ||
            Mode != Sourceˉdeclarations.COMPILER_SOURCE_BORROW_MODE_VALUE ||
            Type.Status != Sourceˉsymbols.Compilerˉsourceˉsymbolˉstatus.Valid ||
            Type.Genericˉstatus !=
                Sourceˉgenerics.Compilerˉsourceˉgenericˉstatus.Valid ||
            Type.Shape == 0u32 || Type.Shape == 10u32 || Type.Shape == 15u32 ||
            Type.Shape >= WIR_FUNCTION_TYPE_SHAPE_BASE {
            return Compilerˉsourceˉwirˉclosureˉsignatureˉfailure(
                Result, Source
            );
        }
        Result = Compilerˉsourceˉwirˉwithˉgenericˉtypeˉevidence(
            Result, Type.Evidence
        );
        Parameters = Bytesˉconcat(
            Parameters, Bytesˉfromˉu32ˉlittle(Type.Shape)
        );
        let Separator: Sourceˉlexer.Compilerˉsourceˉtoken =
            Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                Source, Type.Nextˉoffset, Type.Nextˉline, Type.Nextˉcolumn
            );
        Cursor = Separator.Offset;
        Currentˉline = Separator.Line;
        Currentˉcolumn = Separator.Column;
        if Separator.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Comma {
            Cursor = Separator.Nextˉoffset;
            Currentˉline = Separator.Nextˉline;
            Currentˉcolumn = Separator.Nextˉcolumn;
        }
        Parameter = Parameter + 1u32;
    }
    let Right: Sourceˉlexer.Compilerˉsourceˉtoken =
        Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Source, Cursor, Currentˉline, Currentˉcolumn
        );
    let Arrow: Sourceˉlexer.Compilerˉsourceˉtoken =
        Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Source, Right.Nextˉoffset, Right.Nextˉline, Right.Nextˉcolumn
        );
    let Returnˉstart: Sourceˉlexer.Compilerˉsourceˉtoken =
        Sourceˉdeclarations.Compilerˉsourceˉparameterˉtypeˉstart(
            Source, Arrow.Nextˉoffset, Arrow.Nextˉline, Arrow.Nextˉcolumn
        );
    let Returnˉmode: u32 =
        Sourceˉdeclarations.Compilerˉsourceˉparameterˉborrowˉmode(
            Source, Arrow.Nextˉoffset, Arrow.Nextˉline, Arrow.Nextˉcolumn
        );
    let Returnˉtype: Compilerˉsourceˉwirˉgenericˉtypeˉscan =
        Compilerˉsourceˉwirˉscanˉgenericˉtype(
            Input, Scan, Symbols, Build.Currentˉmodule, Source,
            Returnˉstart.Offset, Returnˉstart.Line, Returnˉstart.Column,
            true,
            Compilerˉsourceˉwirˉgenericˉtypeˉcatalog(Result.Genericˉevidence)
        );
    if Right.Kind != Sourceˉlexer.Compilerˉtokenˉkind.Rightˉparenthesis ||
        Arrow.Kind != Sourceˉlexer.Compilerˉtokenˉkind.Arrow ||
        Returnˉmode != Sourceˉdeclarations.COMPILER_SOURCE_BORROW_MODE_VALUE ||
        Returnˉtype.Status !=
            Sourceˉsymbols.Compilerˉsourceˉsymbolˉstatus.Valid ||
        Returnˉtype.Genericˉstatus !=
            Sourceˉgenerics.Compilerˉsourceˉgenericˉstatus.Valid ||
        Returnˉtype.Shape == 0u32 || Returnˉtype.Shape == 10u32 ||
        Returnˉtype.Shape == 15u32 ||
        Returnˉtype.Shape >= WIR_FUNCTION_TYPE_SHAPE_BASE {
        return Compilerˉsourceˉwirˉclosureˉsignatureˉfailure(Result, Source);
    }
    Result = Compilerˉsourceˉwirˉwithˉgenericˉtypeˉevidence(
        Result, Returnˉtype.Evidence
    );
    return Compilerˉsourceˉwirˉclosureˉsignature(
        true, Result, Profile, Parameters, Returnˉtype.Shape
    );
}

fn Compilerˉsourceˉwirˉfunctionˉtypeˉannotationˉmatchesˉshape(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Source: bytes,
    Offset: u32,
    Line: u32,
    Column: u32,
    Length: u32,
    Build: Compilerˉsourceˉwirˉbuild,
    Shape: u32
) -> bool {
    if Offset > Bytesˉlength(Source) ||
        Length > Bytesˉlength(Source) - Offset || Length == 0u32 ||
        !Compilerˉsourceˉwirˉfunctionˉtypeˉshapeˉisˉprivate(Shape) {
        return false;
    }
    let Parsed: Sourceˉdeclarations.Compilerˉparseˉstep =
        Sourceˉdeclarations.Compilerˉparseˉtype(
            Source, Offset, Line, Column, true, false
        );
    if Parsed.Status != Sourceˉdeclarations.Compilerˉparseˉstatus.Valid ||
        Parsed.Typeˉkind !=
            Sourceˉdeclarations.Compilerˉsourceˉtypeˉkind.Function ||
        Parsed.Nextˉoffset != Offset + Length {
        return false;
    }
    let Catalog: Compilerˉsourceˉwirˉfunctionˉtypeˉcatalog =
        Compilerˉsourceˉwirˉfunctionˉtypeˉcatalogˉfromˉgeneric(
            Build.Genericˉevidence
        );
    let Instance: u32 =
        Compilerˉsourceˉwirˉfunctionˉtypeˉshapeˉinstance(Shape);
    if Instance >=
            Compilerˉsourceˉwirˉfunctionˉtypeˉcatalogˉinstances(Catalog) {
        return false;
    }
    let Header: Sourceˉdeclarations.Compilerˉsourceˉheader =
        Sourceˉdeclarations.Compilerˉparseˉheaderˉvalidated(Source);
    var Current: Sourceˉlexer.Compilerˉsourceˉtoken =
        Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Source, Offset, Line, Column
        );
    var Flags: u32 = 0u32;
    if Current.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Unsafe {
        Flags = Flags | 2u32;
        Current = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Source, Current.Nextˉoffset,
            Current.Nextˉline, Current.Nextˉcolumn
        );
    }
    if Current.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Async {
        Flags = Flags | 1u32;
        Current = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Source, Current.Nextˉoffset,
            Current.Nextˉline, Current.Nextˉcolumn
        );
    }
    if Current.Kind != Sourceˉlexer.Compilerˉtokenˉkind.Fn ||
        Flags != Compilerˉsourceˉwirˉfunctionˉtypeˉflags(
            Catalog, Instance
        ) ||
        Compilerˉsourceˉwirˉprofileˉidentity(Header) !=
            Compilerˉsourceˉwirˉfunctionˉtypeˉprofile(Catalog, Instance) {
        return false;
    }
    let Left: Sourceˉlexer.Compilerˉsourceˉtoken =
        Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Source, Current.Nextˉoffset,
            Current.Nextˉline, Current.Nextˉcolumn
        );
    if Left.Kind != Sourceˉlexer.Compilerˉtokenˉkind.Leftˉparenthesis {
        return false;
    }
    var Typeˉcatalog:
        Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog =
        Compilerˉsourceˉwirˉgenericˉtypeˉcatalog(
            Build.Genericˉevidence
        );
    var Cursor: u32 = Left.Nextˉoffset;
    var Currentˉline: u32 = Left.Nextˉline;
    var Currentˉcolumn: u32 = Left.Nextˉcolumn;
    var Parameter: u32 = 0u32;
    Current = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
        Source, Cursor, Currentˉline, Currentˉcolumn
    );
    while Current.Kind !=
            Sourceˉlexer.Compilerˉtokenˉkind.Rightˉparenthesis {
        if Parameter >=
                Compilerˉsourceˉwirˉfunctionˉtypeˉparameters(
                    Catalog, Instance
                ) {
            return false;
        }
        let Mode: u32 =
            Sourceˉdeclarations.Compilerˉsourceˉparameterˉborrowˉmode(
                Source, Cursor, Currentˉline, Currentˉcolumn
            );
        let Typeˉstart: Sourceˉlexer.Compilerˉsourceˉtoken =
            Sourceˉdeclarations.Compilerˉsourceˉparameterˉtypeˉstart(
                Source, Cursor, Currentˉline, Currentˉcolumn
            );
        let Type: Compilerˉsourceˉwirˉgenericˉtypeˉscan =
            Compilerˉsourceˉwirˉscanˉgenericˉtype(
                Input, Scan, Symbols,
                Build.Currentˉmodule,
                Source, Typeˉstart.Offset,
                Typeˉstart.Line, Typeˉstart.Column, false, Typeˉcatalog
            );
        if Type.Status !=
                Sourceˉsymbols.Compilerˉsourceˉsymbolˉstatus.Valid ||
            Type.Genericˉstatus !=
                Sourceˉgenerics.Compilerˉsourceˉgenericˉstatus.Valid ||
            Type.Shape == 0u32 ||
            Type.Shape !=
                Compilerˉsourceˉwirˉfunctionˉtypeˉparameterˉshape(
                    Catalog, Instance, Parameter
                ) ||
            Mode != Compilerˉsourceˉwirˉfunctionˉtypeˉparameterˉmode(
                Catalog, Instance, Parameter
            ) {
            return false;
        }
        Typeˉcatalog = Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog(
            Sourceˉgenerics.Compilerˉsourceˉgenericˉstatus.Valid,
            Type.Evidence
        );
        Current = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Source, Type.Nextˉoffset, Type.Nextˉline, Type.Nextˉcolumn
        );
        Parameter = Parameter + 1u32;
        if Current.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Comma {
            Cursor = Current.Nextˉoffset;
            Currentˉline = Current.Nextˉline;
            Currentˉcolumn = Current.Nextˉcolumn;
            Current = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                Source, Cursor, Currentˉline, Currentˉcolumn
            );
        } else if Current.Kind !=
                Sourceˉlexer.Compilerˉtokenˉkind.Rightˉparenthesis {
            return false;
        }
    }
    if Parameter != Compilerˉsourceˉwirˉfunctionˉtypeˉparameters(
            Catalog, Instance
        ) {
        return false;
    }
    let Arrow: Sourceˉlexer.Compilerˉsourceˉtoken =
        Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Source, Current.Nextˉoffset,
            Current.Nextˉline, Current.Nextˉcolumn
        );
    if Arrow.Kind != Sourceˉlexer.Compilerˉtokenˉkind.Arrow {
        return false;
    }
    let Returnˉmode: u32 =
        Sourceˉdeclarations.Compilerˉsourceˉparameterˉborrowˉmode(
            Source, Arrow.Nextˉoffset,
            Arrow.Nextˉline, Arrow.Nextˉcolumn
        );
    let Returnˉstart: Sourceˉlexer.Compilerˉsourceˉtoken =
        Sourceˉdeclarations.Compilerˉsourceˉparameterˉtypeˉstart(
            Source, Arrow.Nextˉoffset,
            Arrow.Nextˉline, Arrow.Nextˉcolumn
        );
    let Returnˉtype: Compilerˉsourceˉwirˉgenericˉtypeˉscan =
        Compilerˉsourceˉwirˉscanˉgenericˉtype(
            Input, Scan, Symbols,
            Build.Currentˉmodule,
            Source, Returnˉstart.Offset,
            Returnˉstart.Line, Returnˉstart.Column, true, Typeˉcatalog
        );
    if Returnˉtype.Status !=
            Sourceˉsymbols.Compilerˉsourceˉsymbolˉstatus.Valid ||
        Returnˉtype.Genericˉstatus !=
            Sourceˉgenerics.Compilerˉsourceˉgenericˉstatus.Valid ||
        Returnˉtype.Shape == 0u32 ||
        Returnˉtype.Shape !=
            Compilerˉsourceˉwirˉfunctionˉtypeˉresultˉshape(
                Catalog, Instance
            ) ||
        Returnˉmode != Compilerˉsourceˉwirˉfunctionˉtypeˉresultˉmode(
            Catalog, Instance
        ) {
        return false;
    }
    let Maybeˉeffects: Sourceˉlexer.Compilerˉsourceˉtoken =
        Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Source, Returnˉtype.Nextˉoffset,
            Returnˉtype.Nextˉline, Returnˉtype.Nextˉcolumn
        );
    let Hasˉeffects: bool = Maybeˉeffects.Kind ==
        Sourceˉlexer.Compilerˉtokenˉkind.Effects;
    let Effects: Sourceˉeffects.Compilerˉsourceˉeffectˉset =
        Sourceˉeffects.Compilerˉsourceˉeffectsˉresolveˉclause(
            Input, Scan, Symbols, Source, Hasˉeffects,
            Maybeˉeffects.Offset, Maybeˉeffects.Line, Maybeˉeffects.Column,
            Offset
        );
    return Effects.Status ==
            Sourceˉeffects.Compilerˉsourceˉeffectˉstatus.Valid &&
        Effects.Language ==
            Compilerˉsourceˉwirˉfunctionˉtypeˉlanguageˉeffects(
                Catalog, Instance
            ) &&
        Effects.Capabilities ==
            Compilerˉsourceˉwirˉfunctionˉtypeˉcapabilityˉeffects(
                Catalog, Instance
            );
}

fn Compilerˉsourceˉwirˉfunctionˉtypeˉannotationˉmatches(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Source: bytes,
    Offset: u32,
    Line: u32,
    Column: u32,
    Length: u32,
    Value: Compilerˉsourceˉwirˉvalue
) -> bool {
    return Compilerˉsourceˉwirˉfunctionˉtypeˉannotationˉmatchesˉshape(
        Input, Scan, Symbols, Source, Offset, Line, Column, Length,
        Compilerˉsourceˉwirˉvalueˉbuild(Value), Value.Shape
    );
}

fn Compilerˉsourceˉwirˉprivateˉtypeˉevidenceˉappend(
    Evidence: bytes,
    Offset: u32,
    Nextˉoffset: u32,
    Shape: u32
) -> bytes {
    var Result: bytes = Bytesˉconcat(
        Evidence, Bytesˉfromˉu32ˉlittle(Offset)
    );
    Result = Bytesˉconcat(
        Result, Bytesˉfromˉu32ˉlittle(Nextˉoffset)
    );
    return Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Shape));
}

fn Compilerˉsourceˉwirˉprivateˉtypeˉevidence(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Source: bytes,
    Offset: u32,
    Line: u32,
    Column: u32,
    Build: Compilerˉsourceˉwirˉbuild
) -> bytes {
    var Evidence: bytes = Compilerˉsourceˉwirˉempty(Source);
    let Parsed: Sourceˉdeclarations.Compilerˉparseˉstep =
        Sourceˉdeclarations.Compilerˉparseˉtype(
            Source, Offset, Line, Column, true, false
        );
    if Parsed.Status != Sourceˉdeclarations.Compilerˉparseˉstatus.Valid ||
        Parsed.Nextˉoffset <= Offset {
        return Evidence;
    }
    let Catalog: Compilerˉsourceˉwirˉfunctionˉtypeˉcatalog =
        Compilerˉsourceˉwirˉfunctionˉtypeˉcatalogˉfromˉgeneric(
            Build.Genericˉevidence
        );
    var Current: Sourceˉlexer.Compilerˉsourceˉtoken =
        Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Source, Offset, Line, Column
        );
    while Current.Kind != Sourceˉlexer.Compilerˉtokenˉkind.End &&
        Current.Offset < Parsed.Nextˉoffset {
        if Current.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Fn ||
            Current.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Async ||
            Current.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Unsafe {
            let Candidate: Sourceˉdeclarations.Compilerˉparseˉstep =
                Sourceˉdeclarations.Compilerˉparseˉtype(
                    Source, Current.Offset, Current.Line, Current.Column,
                    true, false
                );
            if Candidate.Status ==
                    Sourceˉdeclarations.Compilerˉparseˉstatus.Valid &&
                Candidate.Typeˉkind ==
                    Sourceˉdeclarations.Compilerˉsourceˉtypeˉkind.Function &&
                Candidate.Nextˉoffset <= Parsed.Nextˉoffset {
                var Instance: u32 = 0u32;
                var Matched: bool = false;
                while !Matched && Instance <
                        Compilerˉsourceˉwirˉfunctionˉtypeˉcatalogˉinstances(
                            Catalog
                        ) {
                    let Shape: u32 =
                        Compilerˉsourceˉwirˉfunctionˉtypeˉshape(
                            Instance
                        );
                    if Compilerˉsourceˉwirˉfunctionˉtypeˉannotationˉmatchesˉshape(
                            Input, Scan, Symbols, Source,
                            Current.Offset, Current.Line, Current.Column,
                            Candidate.Nextˉoffset - Current.Offset,
                            Build, Shape
                        ) {
                        Evidence =
                            Compilerˉsourceˉwirˉprivateˉtypeˉevidenceˉappend(
                                Evidence, Current.Offset,
                                Candidate.Nextˉoffset, Shape
                            );
                        Matched = true;
                    }
                    Instance = Instance + 1u32;
                }
                if Matched {
                    Current = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                        Source, Candidate.Nextˉoffset,
                        Candidate.Nextˉline, Candidate.Nextˉcolumn
                    );
                } else {
                    Current = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                        Source, Current.Nextˉoffset,
                        Current.Nextˉline, Current.Nextˉcolumn
                    );
                }
            } else {
                Current = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                    Source, Current.Nextˉoffset,
                    Current.Nextˉline, Current.Nextˉcolumn
                );
            }
        } else {
            Current = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                Source, Current.Nextˉoffset,
                Current.Nextˉline, Current.Nextˉcolumn
            );
        }
    }
    return Evidence;
}

fn Compilerˉsourceˉwirˉclosureˉcapturesˉvalidateˉresolved(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Parentˉpayload: bytes,
    Parentˉfirst: u32,
    Parentˉentries: u32,
    Module: u32,
    Function: u32,
    Source: bytes,
    Expression: Sourceˉbodies.Compilerˉsourceˉexpression
) -> Closureˉcaptures.Compilerˉsourceˉclosureˉcaptureˉsummary {
    if Expression.Status != Sourceˉbodies.Compilerˉbodyˉparseˉstatus.Valid ||
        Expression.Kind !=
            Sourceˉbodies.Compilerˉsourceˉexpressionˉkind.Closure {
        return Closureˉcaptures.Compilerˉsourceˉclosureˉcapturesˉvalidateˉrange(
            Input, Scan, Symbols,
            Parentˉpayload, Parentˉfirst, Parentˉentries,
            Module, Function, Source, Expression
        );
    }
    let Effects: Sourceˉeffects.Compilerˉsourceˉeffectˉset =
        Sourceˉeffects.Compilerˉsourceˉeffectsˉresolveˉclosure(
            Input, Scan, Symbols, Source, Expression
        );
    var Effectˉstatus:
        Closureˉcaptures.Compilerˉsourceˉclosureˉcaptureˉeffectˉstatus =
        Closureˉcaptures.Compilerˉsourceˉclosureˉcaptureˉeffectˉstatus.Invalid;
    if Effects.Status ==
        Sourceˉeffects.Compilerˉsourceˉeffectˉstatus.Valid {
        Effectˉstatus =
            Closureˉcaptures.Compilerˉsourceˉclosureˉcaptureˉeffectˉstatus.Valid;
    }
    return Closureˉcaptures.Compilerˉsourceˉclosureˉcapturesˉvalidateˉrangeˉwithˉeffects(
        Input, Scan, Symbols,
        Parentˉpayload, Parentˉfirst, Parentˉentries,
        Module, Function, Source, Expression,
        Effectˉstatus, Effects.Count,
        Effects.Language, Effects.Capabilities, Effects.Failureˉoffset
    );
}

fn Compilerˉsourceˉwirˉcompileˉclosureˉexpression(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Bindingˉpayload: bytes,
    Bindingˉfirst: u32,
    Bindingˉentries: u32,
    Source: bytes,
    Expression: Sourceˉbodies.Compilerˉsourceˉexpression,
    Build: Compilerˉsourceˉwirˉbuild
) -> Compilerˉsourceˉwirˉvalue {
    if Bindingˉfirst > Bindingˉentries {
        return Compilerˉsourceˉwirˉfailureˉvalue(
            Build, Compilerˉsourceˉwirˉstatus.Invalidˉcallable,
            Build.Currentˉmodule,
            Expression.Offset, Expression.Line, Expression.Column
        );
    }
    let Captures: Closureˉcaptures.Compilerˉsourceˉclosureˉcaptureˉsummary =
        Compilerˉsourceˉwirˉclosureˉcapturesˉvalidateˉresolved(
            Input, Scan, Symbols,
            Bindingˉpayload, Bindingˉfirst,
            Bindingˉentries - Bindingˉfirst,
            Build.Currentˉmodule, Build.Currentˉfunction,
            Source, Expression
    );
    if Captures.Status !=
            Closureˉcaptures.Compilerˉsourceˉclosureˉcaptureˉstatus.Valid ||
        Captures.Effectˉstatus !=
            Closureˉcaptures.Compilerˉsourceˉclosureˉcaptureˉeffectˉstatus.Valid ||
        Captures.Captures == 0u32 {
        return Compilerˉsourceˉwirˉfailureˉvalue(
            Build, Compilerˉsourceˉwirˉstatus.Invalidˉcallable,
            Build.Currentˉmodule,
            Expression.Offset, Expression.Line, Expression.Column
        );
    }
    var Capture: u32 = 0u32;
    while Capture < Captures.Captures {
        let Captureˉshape: u32 =
            Closureˉcaptures.Compilerˉsourceˉclosureˉcaptureˉshapeˉat(
                Captures, Capture
            );
        let Captureˉmode: u32 =
            Closureˉcaptures.Compilerˉsourceˉclosureˉcaptureˉmodeˉat(
                Captures, Capture
            );
        let Captureˉslot: u32 =
            Closureˉcaptures.Compilerˉsourceˉclosureˉcaptureˉslotˉat(
                Captures, Capture
            );
        let Captureˉkind: u32 =
            Compilerˉsourceˉwirˉclosureˉcaptureˉbindingˉkind(
                Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
                Captureˉslot
            );
        if Captureˉmode > 2u32 ||
            (Captureˉmode == 2u32 &&
                Captureˉkind != 1u32 && Captureˉkind != 2u32) ||
            !Compilerˉsourceˉwirˉclosureˉcaptureˉshapeˉisˉplain(
                Captureˉshape
            ) {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Build, Compilerˉsourceˉwirˉstatus.Invalidˉcallable,
                Build.Currentˉmodule,
                Expression.Offset, Expression.Line, Expression.Column
            );
        }
        Capture = Capture + 1u32;
    }
    let Signature: Compilerˉsourceˉwirˉclosureˉsignature =
        Compilerˉsourceˉwirˉclosureˉsignatureˉread(
            Input, Scan, Symbols, Source, Expression, Build
        );
    if !Signature.Valid {
        return Compilerˉsourceˉwirˉfailureˉvalue(
            Signature.Build, Compilerˉsourceˉwirˉstatus.Invalidˉcallable,
            Build.Currentˉmodule,
            Expression.Offset, Expression.Line, Expression.Column
        );
    }
    let Functionˉtypes: Compilerˉsourceˉwirˉfunctionˉtypeˉcatalog =
        Compilerˉsourceˉwirˉfunctionˉtypeˉcatalogˉfromˉgeneric(
            Signature.Build.Genericˉevidence
        );
    var Functionˉflags: u32 = 0u32;
    if Expression.Booleanˉvalue { Functionˉflags = 1u32; }
    let Typeˉadmission: Compilerˉsourceˉwirˉfunctionˉtypeˉadmission =
        Compilerˉsourceˉwirˉfunctionˉtypeˉcatalogˉadmitˉexact(
            Functionˉtypes, Functionˉflags, Signature.Profile,
            Signature.Returnˉshape,
            Sourceˉdeclarations.COMPILER_SOURCE_BORROW_MODE_VALUE,
            Captures.Languageˉeffects, Captures.Capabilityˉeffects,
            Compilerˉsourceˉwirˉfunctionˉtypeˉparametersˉfromˉshapes(
                Signature.Parameters
            )
        );
    if !Typeˉadmission.Valid {
        return Compilerˉsourceˉwirˉfailureˉvalue(
            Signature.Build, Compilerˉsourceˉwirˉstatus.Invalidˉcallable,
            Build.Currentˉmodule,
            Expression.Offset, Expression.Line, Expression.Column
        );
    }
    if Captures.Captures > 64u32 - Expression.Numericˉvalue {
        return Compilerˉsourceˉwirˉfailureˉvalue(
            Signature.Build, Compilerˉsourceˉwirˉstatus.Invalidˉcallable,
            Build.Currentˉmodule,
            Expression.Offset, Expression.Line, Expression.Column
        );
    }
    let Typed: Compilerˉsourceˉwirˉbuild =
        Compilerˉsourceˉwirˉwithˉfunctionˉtypes(
            Signature.Build, Typeˉadmission.Evidence
        );
    let Closures: Closureˉlowering.Compilerˉsourceˉclosureˉcatalog =
        Compilerˉsourceˉwirˉclosureˉcatalog(Typed);
    let Genericˉinstances: u32 =
        Sourceˉgenerics.Compilerˉsourceˉgenericˉcatalogˉinstances(
            Compilerˉsourceˉwirˉgenericˉcatalog(Typed.Genericˉevidence)
        );
    let Baseˉfunctions: u32 =
        Compilerˉsourceˉwirˉsymbolˉentries(Symbols) + Genericˉinstances;
    let Closureˉinstances: u32 =
        Closureˉlowering.Compilerˉsourceˉclosureˉcatalogˉinstances(Closures);
    if Build.Currentˉfunction >= Baseˉfunctions {
        return Compilerˉsourceˉwirˉfailureˉvalue(
            Typed, Compilerˉsourceˉwirˉstatus.Invalidˉcallable,
            Build.Currentˉmodule,
            Expression.Offset, Expression.Line, Expression.Column
        );
    }
    if Baseˉfunctions > 4294967295u32 - Closureˉinstances {
        return Compilerˉsourceˉwirˉfailureˉvalue(
            Typed, Compilerˉsourceˉwirˉstatus.Evidenceˉlimit,
            Build.Currentˉmodule,
            Expression.Offset, Expression.Line, Expression.Column
        );
    }
    let Admission: Closureˉlowering.Compilerˉsourceˉclosureˉadmission =
        Closureˉlowering.Compilerˉsourceˉclosureˉcatalogˉadmit(
            Closures,
            Scan.Modules, Baseˉfunctions + Closureˉinstances,
            Bytesˉlength(Source),
            Compilerˉsourceˉwirˉfunctionˉtypeˉcatalogˉinstances(
                Compilerˉsourceˉwirˉfunctionˉtypeˉcatalog(
                    Typeˉadmission.Evidence
                )
            ),
            Build.Currentˉmodule, Build.Currentˉfunction,
            Expression.Offset, Expression.Length,
            Typeˉadmission.Instance, Captures.Captures
        );
    if Admission.Status !=
            Closureˉlowering.Compilerˉsourceˉclosureˉloweringˉstatus.Valid {
        return Compilerˉsourceˉwirˉfailureˉvalue(
            Typed, Compilerˉsourceˉwirˉstatus.Invalidˉcallable,
            Build.Currentˉmodule,
            Expression.Offset, Expression.Line, Expression.Column
        );
    }
    var Result: Compilerˉsourceˉwirˉbuild =
        Compilerˉsourceˉwirˉwithˉclosureˉevidence(
            Typed, Admission.Catalogˉevidence
        );
    var Operands: bytes = Compilerˉsourceˉwirˉempty(Source);
    Capture = 0u32;
    while Capture < Captures.Captures {
        let Shape: u32 =
            Closureˉcaptures.Compilerˉsourceˉclosureˉcaptureˉshapeˉat(
                Captures, Capture
            );
        let Slot: u32 =
            Closureˉcaptures.Compilerˉsourceˉclosureˉcaptureˉslotˉat(
                Captures, Capture
            );
        if Shape == 0u32 || Slot == Compilerˉsourceˉwirˉsentinel() {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Result, Compilerˉsourceˉwirˉstatus.Invalidˉcallable,
                Build.Currentˉmodule,
                Expression.Offset, Expression.Line, Expression.Column
            );
        }
        let Loaded: Compilerˉsourceˉwirˉvalue =
            Compilerˉsourceˉwirˉemit(
                Result, WIR_OPERATION_LOAD_LOCAL, Shape,
                Compilerˉsourceˉwirˉempty(Source),
                Slot, 0u32, Expression.Offset, Expression.Length
            );
        if Loaded.Status != Compilerˉsourceˉwirˉstatus.Valid {
            return Loaded;
        }
        Operands = Bytesˉconcat(
            Operands, Bytesˉfromˉu32ˉlittle(Loaded.Temporary)
        );
        Result = Compilerˉsourceˉwirˉvalueˉbuild(Loaded);
        Capture = Capture + 1u32;
    }
    let Target: u32 =
        Closureˉlowering.Compilerˉsourceˉclosureˉcatalogˉtarget(
            Baseˉfunctions, Admission.Instance
        );
    if Target == Compilerˉsourceˉwirˉsentinel() {
        return Compilerˉsourceˉwirˉfailureˉvalue(
            Result, Compilerˉsourceˉwirˉstatus.Evidenceˉlimit,
            Build.Currentˉmodule,
            Expression.Offset, Expression.Line, Expression.Column
        );
    }
    return Compilerˉsourceˉwirˉemit(
        Result, WIR_OPERATION_CLOSURE_CREATE,
        Compilerˉsourceˉwirˉfunctionˉtypeˉshape(Typeˉadmission.Instance),
        Operands, Target, Typeˉadmission.Instance,
        Expression.Offset, Expression.Length
    );
}

fn Compilerˉsourceˉwirˉadmitˉnamedˉfunctionˉreference(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Source: bytes,
    Expression: Sourceˉbodies.Compilerˉsourceˉexpression,
    Callable: Sourceˉbindings.Compilerˉsourceˉbindingˉmatch,
    Build: Compilerˉsourceˉwirˉbuild
) -> Compilerˉsourceˉwirˉfunctionˉreference {
    if !Callable.Found || !Callable.Accessible ||
        (Callable.Kind !=
                Sourceˉbindings.Compilerˉsourceˉcallableˉkind.Function &&
            Callable.Kind !=
                Sourceˉbindings.Compilerˉsourceˉcallableˉkind.Asynchronousˉfunction) {
        return Compilerˉsourceˉwirˉfunctionˉreferenceˉfailure(Build);
    }
    let View: Sourceˉset.Compilerˉsourceˉsetˉview =
        Sourceˉset.Compilerˉsourceˉsetˉmodule(
            Input, Scan, Callable.Module
        );
    let Entry: u32 = 16u32 + Callable.Directoryˉentry * 24u32;
    let Declaration: Sourceˉdeclarations.Compilerˉsourceˉdeclaration =
        Sourceˉdeclarations.Compilerˉparseˉnextˉdeclarationˉvalidated(
            View.Source,
            Bytesˉreadˉu32ˉlittle(Symbols.Directory, Entry + 8u32),
            1u32, 1u32, true
        );
    let Generic: Sourceˉsymbols.Compilerˉsourceˉfunctionˉgeneric =
        Sourceˉsymbols.Compilerˉsourceˉsymbolsˉfunctionˉgeneric(
            View.Source, Declaration, 1u32, 1u32
        );
    let Functionˉflags: u32 = Compilerˉsourceˉwirˉfunctionˉflags(
        View.Source, Declaration
    );
    if Declaration.Status != Sourceˉdeclarations.Compilerˉparseˉstatus.Valid ||
        Generic.Parameters != 0u32 || !Declaration.Hasˉeffectˉclause ||
        Declaration.Effects != 0u32 ||
        (Functionˉflags & 4294967292u32) != 0u32 {
        return Compilerˉsourceˉwirˉfunctionˉreferenceˉfailure(Build);
    }
    let Header: Sourceˉdeclarations.Compilerˉsourceˉheader =
        Sourceˉdeclarations.Compilerˉparseˉheaderˉvalidated(View.Source);
    let Profile: u32 = Compilerˉsourceˉwirˉprofileˉidentity(Header);
    if Profile == 0u32 {
        return Compilerˉsourceˉwirˉfunctionˉreferenceˉfailure(Build);
    }
    var Parameters: bytes = Compilerˉsourceˉwirˉempty(Source);
    var Resultˉshape: u32 = 0u32;
    var Resultˉmode: u32 = 0u32;
    var Parameter: u32 = 0u32;
    while Parameter < Callable.Items {
        let Signature: Compilerˉsourceˉwirˉsignature =
            Compilerˉsourceˉwirˉcallableˉsignatureˉconcrete(
                Input, Scan, Symbols, Callable,
                Source, Expression.Valueˉoffset, Expression.Valueˉlength,
                Parameter,
                Compilerˉsourceˉwirˉgenericˉcatalog(
                    Build.Genericˉevidence
                ),
                Compilerˉsourceˉwirˉgenericˉtypeˉcatalog(
                    Build.Genericˉevidence
                ),
                Compilerˉsourceˉwirˉsentinel()
            );
        if Signature.Parameterˉshape == 0u32 ||
            Signature.Parameterˉmode != 0u32 ||
            Signature.Returnˉshape == 0u32 ||
            Signature.Returnˉmode != 0u32 {
            return Compilerˉsourceˉwirˉfunctionˉreferenceˉfailure(Build);
        }
        Parameters = Bytesˉconcat(
            Parameters, Bytesˉfromˉu32ˉlittle(Signature.Parameterˉshape)
        );
        Resultˉshape = Signature.Returnˉshape;
        Resultˉmode = Signature.Returnˉmode;
        Parameter = Parameter + 1u32;
    }
    if Callable.Items == 0u32 {
        let Emptyˉsignature: Compilerˉsourceˉwirˉsignature =
            Compilerˉsourceˉwirˉcallableˉsignatureˉconcrete(
                Input, Scan, Symbols, Callable,
                Source, Expression.Valueˉoffset, Expression.Valueˉlength,
                0u32,
                Compilerˉsourceˉwirˉgenericˉcatalog(
                    Build.Genericˉevidence
                ),
                Compilerˉsourceˉwirˉgenericˉtypeˉcatalog(
                    Build.Genericˉevidence
                ),
                Compilerˉsourceˉwirˉsentinel()
            );
        Resultˉshape = Emptyˉsignature.Returnˉshape;
        Resultˉmode = Emptyˉsignature.Returnˉmode;
    }
    if Resultˉshape == 0u32 || Resultˉshape == 10u32 ||
        Resultˉshape == 15u32 ||
        Resultˉmode != 0u32 {
        return Compilerˉsourceˉwirˉfunctionˉreferenceˉfailure(Build);
    }
    let Catalog: Compilerˉsourceˉwirˉfunctionˉtypeˉcatalog =
        Compilerˉsourceˉwirˉfunctionˉtypeˉcatalogˉfromˉgeneric(
            Build.Genericˉevidence
        );
    let Admission:
        Compilerˉsourceˉwirˉfunctionˉtypeˉadmission =
        Compilerˉsourceˉwirˉfunctionˉtypeˉcatalogˉadmitˉexact(
            Catalog, Functionˉflags, Profile, Resultˉshape,
            Resultˉmode, 0u32, 0u32,
            Compilerˉsourceˉwirˉfunctionˉtypeˉparametersˉfromˉshapes(
                Parameters
            )
        );
    if !Admission.Valid {
        return Compilerˉsourceˉwirˉfunctionˉreferenceˉfailure(Build);
    }
    return Compilerˉsourceˉwirˉfunctionˉreference(
        true,
        Compilerˉsourceˉwirˉwithˉfunctionˉtypes(
            Build, Admission.Evidence
        ),
        Compilerˉsourceˉwirˉfunctionˉtypeˉshape(
            Admission.Instance
        ),
        Callable.Directoryˉentry
    );
}

export fn Compilerˉsourceˉwirˉcompileˉname(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Bindingˉpayload: bytes,
    Bindingˉfirst: u32,
    Bindingˉentries: u32,
    Source: bytes,
    Expression: Sourceˉbodies.Compilerˉsourceˉexpression,
    Build: Compilerˉsourceˉwirˉbuild
) -> Compilerˉsourceˉwirˉvalue {
    let Local: Sourceˉbindings.Compilerˉsourceˉlocalˉmatch = Sourceˉbindings.Compilerˉsourceˉbindingsˉfindˉlocal(
        Source, Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
        Expression.Valueˉoffset, Expression.Valueˉlength, Expression.Offset
    );
    if Local.Found {
        return Compilerˉsourceˉwirˉemit(
            Build,
            WIR_OPERATION_LOAD_LOCAL,
            Local.Shape,
            Compilerˉsourceˉwirˉempty(Source),
            Local.Slot,
            0u32,
            Expression.Offset,
            Expression.Length
        );
    }
    let Constant: Sourceˉbindings.Compilerˉsourceˉbindingˉmatch = Sourceˉbindings.Compilerˉsourceˉbindingsˉfindˉdeclaration(
        Input, Scan, Symbols, Build.Currentˉmodule, Source,
        Expression.Valueˉoffset, Expression.Valueˉlength,
        Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Constant
    );
    if Constant.Found {
        if !Constant.Accessible {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Build, Compilerˉsourceˉwirˉstatus.Invalidˉconstant,
                Constant.Module, Expression.Offset, Expression.Line, Expression.Column
            );
        }
        let View: Sourceˉset.Compilerˉsourceˉsetˉview = Sourceˉset.Compilerˉsourceˉsetˉmodule(
            Input, Scan, Constant.Module
        );
        let Entry: u32 = 16u32 + Constant.Directoryˉentry * 24u32;
        let Declarationˉoffset: u32 = Bytesˉreadˉu32ˉlittle(
            Symbols.Directory, Entry + 8u32
        );
        let Position: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
            View.Source, 0u32, 1u32, 1u32, Declarationˉoffset
        );
        let Declaration: Sourceˉdeclarations.Compilerˉsourceˉdeclaration = Sourceˉdeclarations.Compilerˉparseˉnextˉdeclarationˉvalidated(
            View.Source,
            Declarationˉoffset,
            Position.Line,
            Position.Column,
            true
        );
        let Value: Sourceˉsymbols.Compilerˉsourceˉconstantˉvalue =
            Sourceˉsymbols.Compilerˉsourceˉsymbolsˉconstantˉevaluateˉdeclaration(
                Input, Scan, Symbols, Constant.Module, View.Source,
                Declaration, Position.Line, Position.Column, 0u32
            );
        if Value.Status != Sourceˉsymbols.Compilerˉsourceˉsymbolˉstatus.Valid {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Build, Compilerˉsourceˉwirˉstatus.Invalidˉconstant,
                Value.Failureˉmodule,
                Value.Failureˉoffset, Value.Failureˉline, Value.Failureˉcolumn
            );
        }
        var Operation: u32 =
            WIR_OPERATION_I32_CONSTANT;
        var Target: u32 = Value.Magnitude;
        var Auxiliary: u32 = Value.High;
        if Value.Shape == 1u32 {
            if Value.Negative {
                Target = 4294967295u32 - Value.Magnitude + 1u32;
            }
        }
        if Value.Shape == 2u32 {
            Operation = WIR_OPERATION_U8_CONSTANT;
        }
        if Value.Shape == 3u32 {
            Operation = WIR_OPERATION_U32_CONSTANT;
        }
        if Value.Shape == 7u32 {
            Operation = WIR_OPERATION_I64_CONSTANT;
            if Value.Negative {
                if Target == 0u32 {
                    Auxiliary = 4294967295u32 - Auxiliary + 1u32;
                } else {
                    Target = 4294967295u32 - Target + 1u32;
                    Auxiliary = 4294967295u32 - Auxiliary;
                }
            }
        }
        if Value.Shape == 8u32 {
            Operation = WIR_OPERATION_U64_CONSTANT;
        }
        if Value.Shape == 11u32 || Value.Shape == 12u32 {
            Operation = WIR_OPERATION_FIXED_INTEGER_CONSTANT;
            if Value.Negative {
                if Value.Shape == 11u32 {
                    Target = 256u32 - Value.Magnitude;
                } else {
                    Target = 65536u32 - Value.Magnitude;
                }
            }
        }
        if Value.Shape == 13u32 {
            Operation = WIR_OPERATION_FIXED_INTEGER_CONSTANT;
        }
        if Value.Shape == 16u32 {
            Operation = WIR_OPERATION_RUNE_CONSTANT;
        }
        if Value.Shape == 14u32 || Value.Shape == 15u32 {
            Operation = WIR_OPERATION_FLOATING_CONSTANT;
        }
        if Value.Shape == 4u32 {
            Operation = WIR_OPERATION_BOOL_CONSTANT;
        }
        if Value.Shape >= 131072u32 + Symbols.Records {
            if Value.Shape < 131072u32 + Symbols.Records + Symbols.Enums {
            Operation = WIR_OPERATION_ENUM_CONSTANT;
            Target = Value.Shape - 131072u32;
            Auxiliary = Value.Magnitude;
            }
        }
        return Compilerˉsourceˉwirˉemit(
            Build, Operation, Value.Shape,
            Compilerˉsourceˉwirˉempty(Source), Target, Auxiliary,
            Expression.Offset, Expression.Length
        );
    }
    let Namedˉfunction:
        Sourceˉbindings.Compilerˉsourceˉbindingˉmatch =
        Sourceˉbindings.Compilerˉsourceˉbindingsˉfindˉcallable(
            Input, Scan, Symbols, Build.Currentˉmodule, Source,
            Expression.Valueˉoffset, Expression.Valueˉlength
        );
    if Namedˉfunction.Found &&
        (Namedˉfunction.Kind ==
                Sourceˉbindings.Compilerˉsourceˉcallableˉkind.Function ||
            Namedˉfunction.Kind ==
                Sourceˉbindings.Compilerˉsourceˉcallableˉkind.Asynchronousˉfunction) {
        let Reference: Compilerˉsourceˉwirˉfunctionˉreference =
            Compilerˉsourceˉwirˉadmitˉnamedˉfunctionˉreference(
                Input, Scan, Symbols, Source, Expression,
                Namedˉfunction, Build
            );
        if !Reference.Valid {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Build, Compilerˉsourceˉwirˉstatus.Invalidˉcallable,
                Namedˉfunction.Module,
                Expression.Offset, Expression.Line, Expression.Column
            );
        }
        return Compilerˉsourceˉwirˉemit(
            Reference.Build, WIR_OPERATION_FUNCTION_REFERENCE,
            Reference.Shape, Compilerˉsourceˉwirˉempty(Source),
            Reference.Target,
            Compilerˉsourceˉwirˉfunctionˉtypeˉshapeˉinstance(
                Reference.Shape
            ),
            Expression.Offset, Expression.Length
        );
    }
    let Capability: Sourceˉbindings.Compilerˉsourceˉbindingˉmatch = Sourceˉbindings.Compilerˉsourceˉbindingsˉfindˉcallable(
        Input, Scan, Symbols, 0u32, Source,
        Expression.Valueˉoffset, Expression.Valueˉlength
    );
    if Capability.Kind == Sourceˉbindings.Compilerˉsourceˉcallableˉkind.Capability {
        return Compilerˉsourceˉwirˉemit(
            Build,
            WIR_OPERATION_U32_CONSTANT,
            268435456u32 + Capability.Directoryˉentry,
            Compilerˉsourceˉwirˉempty(Source),
            0u32,
            0u32,
            Expression.Offset,
            Expression.Length
        );
    }
    let Data: Sourceˉbindings.Compilerˉsourceˉbindingˉmatch = Sourceˉbindings.Compilerˉsourceˉbindingsˉfindˉdeclaration(
        Input, Scan, Symbols, Build.Currentˉmodule, Source,
        Expression.Valueˉoffset, Expression.Valueˉlength,
        Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Data
    );
    if !Data.Found || !Data.Accessible {
        return Compilerˉsourceˉwirˉfailureˉvalue(
            Build, Compilerˉsourceˉwirˉstatus.Invalidˉdataˉuse,
            Data.Module, Expression.Offset, Expression.Line, Expression.Column
        );
    }
    let Kind: Compilerˉsourceˉwirˉdataˉkind = Compilerˉsourceˉwirˉdataˉkind(
        Input, Scan, Symbols, Data
    );
    if Kind == Compilerˉsourceˉwirˉdataˉkind.Text {
        return Compilerˉsourceˉwirˉemit(
            Build, WIR_OPERATION_TEXT_CONSTANT, 5u32,
            Compilerˉsourceˉwirˉempty(Source), Data.Directoryˉentry, 0u32,
            Expression.Offset, Expression.Length
        );
    }
    if Kind == Compilerˉsourceˉwirˉdataˉkind.Bytes {
        return Compilerˉsourceˉwirˉemit(
            Build, WIR_OPERATION_BYTES_CONSTANT, 6u32,
            Compilerˉsourceˉwirˉempty(Source), Data.Directoryˉentry, 0u32,
            Expression.Offset, Expression.Length
        );
    }
    return Compilerˉsourceˉwirˉfailureˉvalue(
        Build,
        Compilerˉsourceˉwirˉstatus.Invalidˉdataˉuse,
        Data.Module,
        Expression.Offset,
        Expression.Line,
        Expression.Column
    );
}

fn Compilerˉsourceˉwirˉbindˉgenericˉtypeˉat(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Source: bytes,
    Offset: u32,
    Line: u32,
    Column: u32,
    Constructorˉnameˉlength: u32,
    Constructorˉargumentsˉoffset: u32,
    Constructorˉargumentsˉline: u32,
    Constructorˉargumentsˉcolumn: u32,
    Build: Compilerˉsourceˉwirˉbuild
) -> Genericˉtypeˉbinding.Compilerˉsourceˉgenericˉtypeˉbinding {
    let Typeˉcatalog: Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog =
        Compilerˉsourceˉwirˉgenericˉtypeˉcatalog(Build.Genericˉevidence);
    let Privateˉtypes: bytes =
        Compilerˉsourceˉwirˉprivateˉtypeˉevidence(
            Input, Scan, Symbols, Source, Offset, Line, Column, Build
        );
    if Build.Genericˉinstance == Compilerˉsourceˉwirˉsentinel() {
        return Genericˉtypeˉbinding.Compilerˉsourceˉgenericˉtypeˉbindˉwithˉprivateˉtypes(
            Input, Scan, Symbols, Build.Currentˉmodule, Source,
            Offset, Line, Column, Constructorˉnameˉlength,
            Constructorˉargumentsˉoffset,
            Constructorˉargumentsˉline,
            Constructorˉargumentsˉcolumn, Typeˉcatalog, Privateˉtypes
        );
    }
    let Functionˉcatalog: Sourceˉgenerics.Compilerˉsourceˉgenericˉcatalog =
        Compilerˉsourceˉwirˉgenericˉcatalog(Build.Genericˉevidence);
    let Declarationˉentry: u32 =
        Sourceˉgenerics.Compilerˉsourceˉgenericˉcatalogˉinstanceˉdeclaration(
            Functionˉcatalog, Build.Genericˉinstance
        );
    let Symbolˉentries: u32 = Bytesˉreadˉu32ˉlittle(Symbols.Directory, 8u32);
    if Declarationˉentry >= Symbolˉentries {
        return Genericˉtypeˉbinding.Compilerˉsourceˉgenericˉtypeˉbindˉwithˉprivateˉtypes(
            Input, Scan, Symbols, Build.Currentˉmodule, Source,
            Offset, Line, Column, Constructorˉnameˉlength,
            Constructorˉargumentsˉoffset,
            Constructorˉargumentsˉline,
            Constructorˉargumentsˉcolumn, Typeˉcatalog, Privateˉtypes
        );
    }
    let Symbolˉentry: u32 = 16u32 + Declarationˉentry * 24u32;
    let Formalˉmodule: u32 = Bytesˉreadˉu32ˉlittle(
        Symbols.Directory, Symbolˉentry
    );
    let Formalˉdeclarationˉoffset: u32 = Bytesˉreadˉu32ˉlittle(
        Symbols.Directory, Symbolˉentry + 8u32
    );
    let Formalˉview: Sourceˉset.Compilerˉsourceˉsetˉview =
        Sourceˉset.Compilerˉsourceˉsetˉmodule(Input, Scan, Formalˉmodule);
    let Formalˉdeclaration:
        Sourceˉdeclarations.Compilerˉsourceˉdeclaration =
        Sourceˉdeclarations.Compilerˉparseˉnextˉdeclarationˉvalidated(
            Formalˉview.Source, Formalˉdeclarationˉoffset,
            1u32, 1u32, true
        );
    let Formalˉgeneric: Sourceˉsymbols.Compilerˉsourceˉfunctionˉgeneric =
        Sourceˉsymbols.Compilerˉsourceˉsymbolsˉfunctionˉgeneric(
            Formalˉview.Source, Formalˉdeclaration, 1u32, 1u32
        );
    return Genericˉtypeˉbinding.Compilerˉsourceˉgenericˉtypeˉbindˉfunctionˉspecializationˉwithˉprivateˉtypes(
        Input, Scan, Symbols, Build.Currentˉmodule, Source,
        Offset, Line, Column, Constructorˉnameˉlength,
        Constructorˉargumentsˉoffset,
        Constructorˉargumentsˉline,
        Constructorˉargumentsˉcolumn, Typeˉcatalog,
        Formalˉview.Source, Formalˉgeneric,
        Functionˉcatalog, Build.Genericˉinstance, Privateˉtypes
    );
}

fn Compilerˉsourceˉwirˉrecordˉfieldˉbyˉshape(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Typeˉcatalog: Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog,
    Shape: u32,
    Queryˉsource: bytes,
    Queryˉoffset: u32,
    Queryˉlength: u32
) -> Compilerˉsourceˉwirˉmember {
    if Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉshapeˉisˉprivate(Shape) {
        let Instance: u32 =
            Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉshapeˉinstance(Shape);
        let Layout: Genericˉlayouts.Compilerˉsourceˉgenericˉtypeˉlayout =
            Genericˉlayouts.Compilerˉsourceˉgenericˉtypeˉlayoutˉcreate(
                Input, Scan, Symbols, Typeˉcatalog, Instance
            );
        if Layout.Kind !=
                Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Record ||
            Layout.Fields > 64u32 ||
            Bytesˉlength(Layout.Fieldˉevidence) != Layout.Fields * 16u32 ||
            !Genericˉlayouts.Compilerˉsourceˉgenericˉtypeˉlayoutˉisˉvalid(
                Input, Scan, Symbols, Layout
            ) {
            return Compilerˉsourceˉwirˉmember(false, 0u32, 0u32);
        }
        let View: Sourceˉset.Compilerˉsourceˉsetˉview =
            Sourceˉset.Compilerˉsourceˉsetˉmodule(
                Input, Scan, Layout.Module
            );
        var Field: u32 = 0u32;
        while Field < Layout.Fields {
            let Entry: u32 = Field * 16u32;
            let Nameˉoffset: u32 = Bytesˉreadˉu32ˉlittle(
                Layout.Fieldˉevidence, Entry
            );
            let Nameˉlength: u32 = Bytesˉreadˉu32ˉlittle(
                Layout.Fieldˉevidence, Entry + 4u32
            );
            if Sourceˉset.Compilerˉsourceˉspansˉequal(
                    View.Source, Nameˉoffset, Nameˉlength,
                    Queryˉsource, Queryˉoffset, Queryˉlength
                ) {
                return Compilerˉsourceˉwirˉmember(
                    true, Field,
                    Bytesˉreadˉu32ˉlittle(
                        Layout.Fieldˉevidence, Entry + 8u32
                    )
                );
            }
            Field = Field + 1u32;
        }
        return Compilerˉsourceˉwirˉmember(false, 0u32, 0u32);
    }
    if Shape < 65536u32 || Shape >= 131072u32 {
        return Compilerˉsourceˉwirˉmember(false, 0u32, 0u32);
    }
    let Nominal: Sourceˉsymbols.Compilerˉsourceˉsymbolˉmatch =
        Compilerˉsourceˉwirˉnominalˉbyˉshape(
            Input, Scan, Symbols, Shape
        );
    return Compilerˉsourceˉwirˉnominalˉmember(
        Input, Scan, Symbols, Nominal,
        Queryˉsource, Queryˉoffset, Queryˉlength
    );
}

fn Compilerˉsourceˉwirˉcompileˉrecordˉpath(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Source: bytes,
    Expression: Sourceˉbodies.Compilerˉsourceˉexpression,
    Base: Compilerˉsourceˉwirˉvalue,
    Cursor: u32,
    Line: u32,
    Column: u32
) -> Compilerˉsourceˉwirˉvalue {
    var Result: Compilerˉsourceˉwirˉvalue = Base;
    var Pathˉcursor: u32 = Cursor;
    var Pathˉline: u32 = Line;
    var Pathˉcolumn: u32 = Column;
    let Pathˉend: u32 = Expression.Valueˉoffset + Expression.Valueˉlength;
    let Typeˉcatalog: Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog =
        Compilerˉsourceˉwirˉgenericˉtypeˉcatalog(Result.Genericˉevidence);
    while Pathˉcursor < Pathˉend {
        let Dot: Sourceˉlexer.Compilerˉsourceˉtoken =
            Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                Source, Pathˉcursor, Pathˉline, Pathˉcolumn
            );
        let Member: Sourceˉlexer.Compilerˉsourceˉtoken =
            Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                Source, Dot.Nextˉoffset, Dot.Nextˉline, Dot.Nextˉcolumn
            );
        if Compilerˉsourceˉwirˉshapeˉisˉfoundationˉunsafeˉopaque(
                Input, Scan, Symbols, Typeˉcatalog, Result.Shape
            ) {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Compilerˉsourceˉwirˉvalueˉbuild(Result),
                Compilerˉsourceˉwirˉstatus.Invalidˉunsafeˉvalue,
                Result.Currentˉmodule,
                Member.Offset, Member.Line, Member.Column
            );
        }
        var Isˉrecord: bool =
            Result.Shape >= 65536u32 && Result.Shape < 131072u32;
        if Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉshapeˉisˉprivate(
                Result.Shape
            ) {
            let Instance: u32 =
                Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉshapeˉinstance(
                    Result.Shape
                );
            Isˉrecord = Instance <
                Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalogˉinstances(
                    Typeˉcatalog
                ) &&
                Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalogˉinstanceˉkind(
                    Typeˉcatalog, Instance
                ) == 4u32;
        }
        if !Isˉrecord {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Compilerˉsourceˉwirˉvalueˉbuild(Result),
                Compilerˉsourceˉwirˉstatus.Invalidˉfieldˉtarget,
                Result.Currentˉmodule,
                Member.Offset, Member.Line, Member.Column
            );
        }
        let Pathˉfield: Compilerˉsourceˉwirˉmember =
            Compilerˉsourceˉwirˉrecordˉfieldˉbyˉshape(
                Input, Scan, Symbols, Typeˉcatalog, Result.Shape,
                Source, Member.Offset, Member.Length
            );
        if !Pathˉfield.Found {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Compilerˉsourceˉwirˉvalueˉbuild(Result),
                Compilerˉsourceˉwirˉstatus.Unknownˉfield,
                Result.Currentˉmodule,
                Member.Offset,
                Member.Line,
                Member.Column
            );
        }
        var Pathˉtarget: u32 = Result.Shape - 65536u32;
        if Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉshapeˉisˉprivate(
                Result.Shape
            ) {
            Pathˉtarget = Result.Shape;
        }
        Result = Compilerˉsourceˉwirˉemit(
            Compilerˉsourceˉwirˉvalueˉbuild(Result),
            WIR_OPERATION_RECORD_FIELD,
            Pathˉfield.Shape,
            Compilerˉsourceˉwirˉoneˉoperand(Result.Temporary),
            Pathˉtarget,
            Pathˉfield.Index,
            Expression.Offset,
            Expression.Length
        );
        Pathˉcursor = Member.Nextˉoffset;
        Pathˉline = Member.Nextˉline;
        Pathˉcolumn = Member.Nextˉcolumn;
    }
    return Result;
}

export fn Compilerˉsourceˉwirˉcompileˉfield(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Bindingˉpayload: bytes,
    Bindingˉfirst: u32,
    Bindingˉentries: u32,
    Source: bytes,
    Expression: Sourceˉbodies.Compilerˉsourceˉexpression,
    Build: Compilerˉsourceˉwirˉbuild
) -> Compilerˉsourceˉwirˉvalue {
    let Firstˉposition: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
        Source, Expression.Offset, Expression.Line, Expression.Column,
        Expression.Firstˉoffset
    );
    let Position: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
        Source, Expression.Offset, Expression.Line, Expression.Column,
        Expression.Secondˉoffset
    );
    let Local: Sourceˉbindings.Compilerˉsourceˉlocalˉmatch = Sourceˉbindings.Compilerˉsourceˉbindingsˉfindˉlocal(
        Source, Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
        Expression.Firstˉoffset, Expression.Firstˉlength, Expression.Offset
    );
    if Local.Found {
        let Typeˉcatalog:
            Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog =
            Compilerˉsourceˉwirˉgenericˉtypeˉcatalog(Build.Genericˉevidence);
        if Compilerˉsourceˉwirˉshapeˉisˉfoundationˉunsafeˉopaque(
                Input, Scan, Symbols, Typeˉcatalog, Local.Shape
            ) {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Build, Compilerˉsourceˉwirˉstatus.Invalidˉunsafeˉvalue,
                Build.Currentˉmodule,
                Expression.Secondˉoffset, Position.Line, Position.Column
            );
        }
        var Isˉrecord: bool =
            Local.Shape >= 65536u32 && Local.Shape < 131072u32;
        if Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉshapeˉisˉprivate(
                Local.Shape
            ) {
            let Instance: u32 =
                Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉshapeˉinstance(
                    Local.Shape
                );
            Isˉrecord = Instance <
                Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalogˉinstances(
                    Typeˉcatalog
                ) &&
                Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalogˉinstanceˉkind(
                    Typeˉcatalog, Instance
                ) == 4u32;
        }
        if !Isˉrecord {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Build,
                Compilerˉsourceˉwirˉstatus.Invalidˉfieldˉtarget,
                Build.Currentˉmodule,
                Expression.Firstˉoffset,
                Firstˉposition.Line,
                Firstˉposition.Column
            );
        }
        let Field: Compilerˉsourceˉwirˉmember =
            Compilerˉsourceˉwirˉrecordˉfieldˉbyˉshape(
                Input, Scan, Symbols, Typeˉcatalog, Local.Shape,
                Source, Expression.Secondˉoffset, Expression.Secondˉlength
            );
        if !Field.Found {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Build,
                Compilerˉsourceˉwirˉstatus.Unknownˉfield,
                Build.Currentˉmodule,
                Expression.Secondˉoffset,
                Position.Line,
                Position.Column
            );
        }
        var Fieldˉtarget: u32 = Local.Shape - 65536u32;
        if Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉshapeˉisˉprivate(
                Local.Shape
            ) {
            Fieldˉtarget = Local.Shape;
        }
        let Target: Compilerˉsourceˉwirˉvalue = Compilerˉsourceˉwirˉemit(
            Build, WIR_OPERATION_LOAD_LOCAL, Local.Shape,
            Compilerˉsourceˉwirˉempty(Source), Local.Slot, 0u32,
            Expression.Firstˉoffset, Expression.Firstˉlength
        );
        let Firstˉfield: Compilerˉsourceˉwirˉvalue =
            Compilerˉsourceˉwirˉemit(
                Compilerˉsourceˉwirˉvalueˉbuild(Target),
                WIR_OPERATION_RECORD_FIELD,
                Field.Shape,
                Compilerˉsourceˉwirˉoneˉoperand(Target.Temporary),
                Fieldˉtarget,
                Field.Index,
                Expression.Offset,
                Expression.Length
            );
        let Secondˉtoken: Sourceˉlexer.Compilerˉsourceˉtoken =
            Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                Source,
                Expression.Secondˉoffset,
                Position.Line,
                Position.Column
            );
        return Compilerˉsourceˉwirˉcompileˉrecordˉpath(
            Input,
            Scan,
            Symbols,
            Source,
            Expression,
            Firstˉfield,
            Secondˉtoken.Nextˉoffset,
            Secondˉtoken.Nextˉline,
            Secondˉtoken.Nextˉcolumn
        );
    }
    let Capability: Sourceˉbindings.Compilerˉsourceˉbindingˉmatch = Sourceˉbindings.Compilerˉsourceˉbindingsˉfindˉcallable(
        Input, Scan, Symbols, 0u32, Source,
        Expression.Valueˉoffset, Expression.Valueˉlength
    );
    if Capability.Kind == Sourceˉbindings.Compilerˉsourceˉcallableˉkind.Capability {
        return Compilerˉsourceˉwirˉemit(
            Build,
            WIR_OPERATION_U32_CONSTANT,
            268435456u32 + Capability.Directoryˉentry,
            Compilerˉsourceˉwirˉempty(Source),
            0u32,
            0u32,
            Expression.Offset,
            Expression.Length
        );
    }
    let Qualifiedˉconstant: Sourceˉbindings.Compilerˉsourceˉbindingˉmatch =
        Sourceˉbindings.Compilerˉsourceˉbindingsˉfindˉdeclaration(
            Input, Scan, Symbols, Build.Currentˉmodule, Source,
            Expression.Valueˉoffset, Expression.Valueˉlength,
            Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Constant
        );
    let Qualifiedˉdata: Sourceˉbindings.Compilerˉsourceˉbindingˉmatch =
        Sourceˉbindings.Compilerˉsourceˉbindingsˉfindˉdeclaration(
            Input, Scan, Symbols, Build.Currentˉmodule, Source,
            Expression.Valueˉoffset, Expression.Valueˉlength,
            Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Data
        );
    if Qualifiedˉconstant.Found {
        return Compilerˉsourceˉwirˉcompileˉname(
            Input, Scan, Symbols, Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
            Source, Expression, Build
        );
    }
    if Qualifiedˉdata.Found {
        return Compilerˉsourceˉwirˉcompileˉname(
            Input, Scan, Symbols, Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
            Source, Expression, Build
        );
    }
    var Lastˉdot: u32 = Expression.Valueˉlength;
    var Nameˉcharacter: u32 = 0u32;
    while Nameˉcharacter < Expression.Valueˉlength {
        if Bytesˉreadˉu8(Source, Expression.Valueˉoffset + Nameˉcharacter) == 46u8 {
            Lastˉdot = Nameˉcharacter;
        }
        Nameˉcharacter = Nameˉcharacter + 1u32;
    }
    let Memberˉoffset: u32 = Expression.Valueˉoffset + Lastˉdot + 1u32;
    let Memberˉlength: u32 = Expression.Valueˉlength - Lastˉdot - 1u32;
    let Memberˉposition: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
        Source, Expression.Offset, Expression.Line, Expression.Column, Memberˉoffset
    );
    let Enumˉnominal: Sourceˉsymbols.Compilerˉsourceˉsymbolˉmatch = Sourceˉsymbols.Compilerˉsourceˉsymbolsˉfindˉownedˉnominal(
        Input, Scan, Symbols.Directory, Symbols.Lookup, Build.Currentˉmodule,
        Source, Expression.Valueˉoffset, Lastˉdot
    );
    if Enumˉnominal.Kind != Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Enum {
        return Compilerˉsourceˉwirˉfailureˉvalue(
            Build, Compilerˉsourceˉwirˉstatus.Invalidˉfieldˉtarget,
            Enumˉnominal.Module,
            Expression.Firstˉoffset, Firstˉposition.Line, Firstˉposition.Column
        );
    }
    if !Sourceˉsymbols.Compilerˉsourceˉsymbolsˉownedˉmatchˉisˉaccessible(
        Input, Scan, Symbols.Visibility, Symbols.Lookup, Build.Currentˉmodule, Source,
        Expression.Valueˉoffset, Lastˉdot, Enumˉnominal
    ) {
        return Compilerˉsourceˉwirˉfailureˉvalue(
            Build, Compilerˉsourceˉwirˉstatus.Invalidˉfieldˉtarget,
            Enumˉnominal.Module,
            Expression.Firstˉoffset, Firstˉposition.Line, Firstˉposition.Column
        );
    }
    let Member: Compilerˉsourceˉwirˉmember = Compilerˉsourceˉwirˉnominalˉmember(
        Input, Scan, Symbols, Enumˉnominal,
        Source, Memberˉoffset, Memberˉlength
    );
    if !Member.Found {
        return Compilerˉsourceˉwirˉfailureˉvalue(
            Build, Compilerˉsourceˉwirˉstatus.Unknownˉenumˉmember,
            Enumˉnominal.Module,
            Memberˉoffset, Memberˉposition.Line, Memberˉposition.Column
        );
    }
    return Compilerˉsourceˉwirˉemit(
        Build,
        WIR_OPERATION_ENUM_CONSTANT,
        Member.Shape,
        Compilerˉsourceˉwirˉempty(Source),
        Member.Shape - 131072u32,
        Member.Index,
        Expression.Offset,
        Expression.Length
    );
}

export fn Compilerˉsourceˉwirˉbinaryˉoperation(
    Operator: Sourceˉlexer.Compilerˉtokenˉkind,
    Shape: u32
) -> u32 {
    if Shape == 14u32 || Shape == 15u32 {
        if Operator == Sourceˉlexer.Compilerˉtokenˉkind.Plus {
            return WIR_OPERATION_FLOATING_ADD;
        }
        if Operator == Sourceˉlexer.Compilerˉtokenˉkind.Minus {
            return WIR_OPERATION_FLOATING_SUBTRACT;
        }
        if Operator == Sourceˉlexer.Compilerˉtokenˉkind.Star {
            return WIR_OPERATION_FLOATING_MULTIPLY;
        }
        if Operator == Sourceˉlexer.Compilerˉtokenˉkind.Slash {
            return WIR_OPERATION_FLOATING_DIVIDE;
        }
        if Operator == Sourceˉlexer.Compilerˉtokenˉkind.Equalsˉequals {
            return WIR_OPERATION_FLOATING_EQUAL;
        }
        if Operator == Sourceˉlexer.Compilerˉtokenˉkind.Bangˉequals {
            return WIR_OPERATION_FLOATING_NOT_EQUAL;
        }
        if Operator == Sourceˉlexer.Compilerˉtokenˉkind.Less {
            return WIR_OPERATION_FLOATING_LESS;
        }
        if Operator == Sourceˉlexer.Compilerˉtokenˉkind.Lessˉequals {
            return WIR_OPERATION_FLOATING_LESS_EQUAL;
        }
        if Operator == Sourceˉlexer.Compilerˉtokenˉkind.Greater {
            return WIR_OPERATION_FLOATING_GREATER;
        }
        return WIR_OPERATION_FLOATING_GREATER_EQUAL;
    }
    if Shape == 16u32 {
        if Operator == Sourceˉlexer.Compilerˉtokenˉkind.Equalsˉequals {
            return WIR_OPERATION_RUNE_EQUAL;
        }
        return WIR_OPERATION_RUNE_NOT_EQUAL;
    }
    if Shape >= 11u32 {
        if Shape <= 13u32 {
            if Operator == Sourceˉlexer.Compilerˉtokenˉkind.Plus {
                return WIR_OPERATION_FIXED_INTEGER_ADD;
            }
            if Operator == Sourceˉlexer.Compilerˉtokenˉkind.Minus {
                return WIR_OPERATION_FIXED_INTEGER_SUBTRACT;
            }
            if Operator == Sourceˉlexer.Compilerˉtokenˉkind.Star {
                return WIR_OPERATION_FIXED_INTEGER_MULTIPLY;
            }
            if Operator == Sourceˉlexer.Compilerˉtokenˉkind.Slash {
                return WIR_OPERATION_FIXED_INTEGER_DIVIDE;
            }
            if Operator == Sourceˉlexer.Compilerˉtokenˉkind.Percent {
                return WIR_OPERATION_FIXED_INTEGER_REMAINDER;
            }
            if Operator == Sourceˉlexer.Compilerˉtokenˉkind.Equalsˉequals {
                return WIR_OPERATION_FIXED_INTEGER_EQUAL;
            }
            if Operator == Sourceˉlexer.Compilerˉtokenˉkind.Bangˉequals {
                return WIR_OPERATION_FIXED_INTEGER_NOT_EQUAL;
            }
            if Operator == Sourceˉlexer.Compilerˉtokenˉkind.Less {
                return WIR_OPERATION_FIXED_INTEGER_LESS;
            }
            if Operator == Sourceˉlexer.Compilerˉtokenˉkind.Lessˉequals {
                return WIR_OPERATION_FIXED_INTEGER_LESS_EQUAL;
            }
            if Operator == Sourceˉlexer.Compilerˉtokenˉkind.Greater {
                return WIR_OPERATION_FIXED_INTEGER_GREATER;
            }
            if Operator == Sourceˉlexer.Compilerˉtokenˉkind.Greaterˉequals {
                return WIR_OPERATION_FIXED_INTEGER_GREATER_EQUAL;
            }
            if Operator == Sourceˉlexer.Compilerˉtokenˉkind.Ampersand {
                return WIR_OPERATION_FIXED_INTEGER_BITWISE_AND;
            }
            if Operator == Sourceˉlexer.Compilerˉtokenˉkind.Pipe {
                return WIR_OPERATION_FIXED_INTEGER_BITWISE_OR;
            }
            if Operator == Sourceˉlexer.Compilerˉtokenˉkind.Caret {
                return WIR_OPERATION_FIXED_INTEGER_BITWISE_XOR;
            }
            if Operator == Sourceˉlexer.Compilerˉtokenˉkind.Shiftˉleft {
                return WIR_OPERATION_FIXED_INTEGER_SHIFT_LEFT;
            }
            if Operator == Sourceˉlexer.Compilerˉtokenˉkind.Shiftˉright {
                return WIR_OPERATION_FIXED_INTEGER_SHIFT_RIGHT;
            }
        }
    }
    if Operator == Sourceˉlexer.Compilerˉtokenˉkind.Plus {
        if Shape == 1u32 { return WIR_OPERATION_I32_ADD; }
        if Shape == 7u32 { return WIR_OPERATION_I64_ADD; }
        if Shape == 8u32 { return WIR_OPERATION_U64_ADD; }
        return WIR_OPERATION_U32_ADD;
    }
    if Operator == Sourceˉlexer.Compilerˉtokenˉkind.Minus {
        if Shape == 1u32 { return WIR_OPERATION_I32_SUBTRACT; }
        if Shape == 7u32 { return WIR_OPERATION_I64_SUBTRACT; }
        if Shape == 8u32 { return WIR_OPERATION_U64_SUBTRACT; }
        return WIR_OPERATION_U32_SUBTRACT;
    }
    if Operator == Sourceˉlexer.Compilerˉtokenˉkind.Star {
        if Shape == 1u32 { return WIR_OPERATION_I32_MULTIPLY; }
        if Shape == 7u32 { return WIR_OPERATION_I64_MULTIPLY; }
        if Shape == 8u32 { return WIR_OPERATION_U64_MULTIPLY; }
        return WIR_OPERATION_U32_MULTIPLY;
    }
    if Operator == Sourceˉlexer.Compilerˉtokenˉkind.Slash {
        if Shape == 1u32 { return WIR_OPERATION_I32_DIVIDE; }
        if Shape == 7u32 { return WIR_OPERATION_I64_DIVIDE; }
        if Shape == 8u32 { return WIR_OPERATION_U64_DIVIDE; }
        return WIR_OPERATION_U32_DIVIDE;
    }
    if Operator == Sourceˉlexer.Compilerˉtokenˉkind.Percent {
        if Shape == 1u32 { return WIR_OPERATION_I32_REMAINDER; }
        if Shape == 7u32 { return WIR_OPERATION_I64_REMAINDER; }
        if Shape == 8u32 { return WIR_OPERATION_U64_REMAINDER; }
        return WIR_OPERATION_U32_REMAINDER;
    }
    if Operator == Sourceˉlexer.Compilerˉtokenˉkind.Ampersand {
        if Shape == 2u32 { return WIR_OPERATION_U8_BITWISE_AND; }
        if Shape == 8u32 { return WIR_OPERATION_U64_BITWISE_AND; }
        return WIR_OPERATION_U32_BITWISE_AND;
    }
    if Operator == Sourceˉlexer.Compilerˉtokenˉkind.Pipe {
        if Shape == 2u32 { return WIR_OPERATION_U8_BITWISE_OR; }
        if Shape == 8u32 { return WIR_OPERATION_U64_BITWISE_OR; }
        return WIR_OPERATION_U32_BITWISE_OR;
    }
    if Operator == Sourceˉlexer.Compilerˉtokenˉkind.Caret {
        if Shape == 2u32 { return WIR_OPERATION_U8_BITWISE_XOR; }
        if Shape == 8u32 { return WIR_OPERATION_U64_BITWISE_XOR; }
        return WIR_OPERATION_U32_BITWISE_XOR;
    }
    if Operator == Sourceˉlexer.Compilerˉtokenˉkind.Shiftˉleft {
        if Shape == 2u32 { return WIR_OPERATION_U8_SHIFT_LEFT; }
        if Shape == 8u32 { return WIR_OPERATION_U64_SHIFT_LEFT; }
        return WIR_OPERATION_U32_SHIFT_LEFT;
    }
    if Operator == Sourceˉlexer.Compilerˉtokenˉkind.Shiftˉright {
        if Shape == 2u32 { return WIR_OPERATION_U8_SHIFT_RIGHT; }
        if Shape == 8u32 { return WIR_OPERATION_U64_SHIFT_RIGHT; }
        return WIR_OPERATION_U32_SHIFT_RIGHT;
    }
    if Operator == Sourceˉlexer.Compilerˉtokenˉkind.Less {
        if Shape == 1u32 { return WIR_OPERATION_I32_LESS; }
        if Shape == 7u32 { return WIR_OPERATION_I64_LESS; }
        if Shape == 8u32 { return WIR_OPERATION_U64_LESS; }
        return WIR_OPERATION_U32_LESS;
    }
    if Operator == Sourceˉlexer.Compilerˉtokenˉkind.Lessˉequals {
        if Shape == 1u32 { return WIR_OPERATION_I32_LESS_EQUAL; }
        if Shape == 7u32 { return WIR_OPERATION_I64_LESS_EQUAL; }
        if Shape == 8u32 { return WIR_OPERATION_U64_LESS_EQUAL; }
        return WIR_OPERATION_U32_LESS_EQUAL;
    }
    if Operator == Sourceˉlexer.Compilerˉtokenˉkind.Greater {
        if Shape == 1u32 { return WIR_OPERATION_I32_GREATER; }
        if Shape == 7u32 { return WIR_OPERATION_I64_GREATER; }
        if Shape == 8u32 { return WIR_OPERATION_U64_GREATER; }
        return WIR_OPERATION_U32_GREATER;
    }
    if Operator == Sourceˉlexer.Compilerˉtokenˉkind.Greaterˉequals {
        if Shape == 1u32 { return WIR_OPERATION_I32_GREATER_EQUAL; }
        if Shape == 7u32 { return WIR_OPERATION_I64_GREATER_EQUAL; }
        if Shape == 8u32 { return WIR_OPERATION_U64_GREATER_EQUAL; }
        return WIR_OPERATION_U32_GREATER_EQUAL;
    }
    if Operator == Sourceˉlexer.Compilerˉtokenˉkind.Equalsˉequals {
        if Shape == 1u32 { return WIR_OPERATION_I32_EQUAL; }
        if Shape == 2u32 { return WIR_OPERATION_U8_EQUAL; }
        if Shape == 3u32 { return WIR_OPERATION_U32_EQUAL; }
        if Shape == 4u32 { return WIR_OPERATION_BOOL_EQUAL; }
        if Shape == 5u32 { return WIR_OPERATION_TEXT_EQUAL; }
        if Shape == 6u32 { return WIR_OPERATION_BYTES_EQUAL; }
        if Shape == 7u32 { return WIR_OPERATION_I64_EQUAL; }
        if Shape == 8u32 { return WIR_OPERATION_U64_EQUAL; }
        return WIR_OPERATION_ENUM_EQUAL;
    }
    if Shape == 1u32 { return WIR_OPERATION_I32_NOT_EQUAL; }
    if Shape == 2u32 { return WIR_OPERATION_U8_NOT_EQUAL; }
    if Shape == 3u32 { return WIR_OPERATION_U32_NOT_EQUAL; }
    if Shape == 4u32 { return WIR_OPERATION_BOOL_NOT_EQUAL; }
    if Shape == 5u32 { return WIR_OPERATION_TEXT_NOT_EQUAL; }
    if Shape == 6u32 { return WIR_OPERATION_BYTES_NOT_EQUAL; }
    if Shape == 7u32 { return WIR_OPERATION_I64_NOT_EQUAL; }
    if Shape == 8u32 { return WIR_OPERATION_U64_NOT_EQUAL; }
    return WIR_OPERATION_ENUM_NOT_EQUAL;
}

fn Compilerˉsourceˉwirˉcompileˉnominalˉfields(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Typeˉcatalog: Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog,
    Bindingˉpayload: bytes,
    Bindingˉfirst: u32,
    Bindingˉentries: u32,
    Source: bytes,
    Expression: Sourceˉbodies.Compilerˉsourceˉexpression,
    Module: u32,
    Shape: u32,
    Target: u32,
    Auxiliary: u32,
    Fields: u32,
    Isˉvariant: bool,
    Preservedˉshapes: bytes,
    Baseˉtemporary: u32,
    Build: Compilerˉsourceˉwirˉbuild
) -> Compilerˉsourceˉwirˉvalue {
    var Operands: bytes = Compilerˉsourceˉwirˉempty(Source);
    var Operand: u32 = 0u32;
    while Operand < Fields {
        Operands = Bytesˉconcat(Operands, Bytesˉfromˉu32ˉlittle(0u32));
        Operand = Operand + 1u32;
    }
    let Seenˉresult: Byteˉconstruction.Foundationˉbytesˉresult =
        Byteˉconstruction.Foundationˉbytesˉrepeat(0u8, Fields);
    if !Seenˉresult.Valid {
        return Compilerˉsourceˉwirˉfailureˉvalue(
            Build, Compilerˉsourceˉwirˉstatus.Evidenceˉlimit,
            Module, Expression.Offset, Expression.Line, Expression.Column
        );
    }
    var Seen: bytes = Seenˉresult.Value;
    var Result: Compilerˉsourceˉwirˉbuild = Build;
    var Cursor: u32 = Expression.Itemsˉoffset;
    var Position: Sourceˉbodies.Compilerˉsourceˉposition =
        Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
            Source, Expression.Offset, Expression.Line, Expression.Column,
            Expression.Itemsˉoffset
        );
    var Item: u32 = 0u32;
    while Item < Expression.Items {
        let Field: Sourceˉlexer.Compilerˉsourceˉtoken =
            Sourceˉbodies.Compilerˉbodyˉtoken(
                Source, Cursor, Position.Line, Position.Column,
                Expression.Itemsˉoffset + Expression.Itemsˉlength
            );
        let Colon: Sourceˉlexer.Compilerˉsourceˉtoken =
            Sourceˉbodies.Compilerˉbodyˉtoken(
                Source, Field.Nextˉoffset, Field.Nextˉline,
                Field.Nextˉcolumn,
                Expression.Itemsˉoffset + Expression.Itemsˉlength
            );
        let Fieldˉexpression: Sourceˉbodies.Compilerˉsourceˉexpression =
            Sourceˉbodies.Compilerˉparseˉexpressionˉvalidated(
                Source, Colon.Nextˉoffset, Colon.Nextˉline,
                Colon.Nextˉcolumn,
                Expression.Itemsˉoffset + Expression.Itemsˉlength,
                0u32, 0u32
            );
        let Value: Compilerˉsourceˉwirˉvalue =
            Compilerˉsourceˉwirˉcompileˉexpression(
                Input, Scan, Symbols,
                Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
                Source, Fieldˉexpression.Offset, Fieldˉexpression.Line,
                Fieldˉexpression.Column,
                Fieldˉexpression.Offset + Fieldˉexpression.Length,
                Result
            );
        if Value.Status != Compilerˉsourceˉwirˉstatus.Valid { return Value; }
        if Value.Shape == 10u32 { return Value; }
        var Member: Compilerˉsourceˉwirˉmember =
            Compilerˉsourceˉwirˉrecordˉfieldˉbyˉshape(
                Input, Scan, Symbols, Typeˉcatalog, Shape,
                Source, Field.Offset, Field.Length
            );
        if Isˉvariant {
            Member = Compilerˉsourceˉwirˉvariantˉfieldˉbyˉname(
                Input, Scan, Symbols, Typeˉcatalog, Target, Auxiliary,
                Source, Field.Offset, Field.Length
            );
        }
        if !Member.Found {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Compilerˉsourceˉwirˉvalueˉbuild(Value),
                Compilerˉsourceˉwirˉstatus.Unknownˉfield,
                Module, Field.Offset, Field.Line, Field.Column
            );
        }
        if Bytesˉreadˉu8(Seen, Member.Index) != 0u8 {
            var Duplicateˉstatus: Compilerˉsourceˉwirˉstatus =
                Compilerˉsourceˉwirˉstatus.Duplicateˉrecordˉfield;
            if Isˉvariant {
                Duplicateˉstatus =
                    Compilerˉsourceˉwirˉstatus.Duplicateˉvariantˉfield;
            }
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Compilerˉsourceˉwirˉvalueˉbuild(Value),
                Duplicateˉstatus,
                Module, Field.Offset, Field.Line, Field.Column
            );
        }
        if Value.Shape != Member.Shape {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Compilerˉsourceˉwirˉvalueˉbuild(Value),
                Compilerˉsourceˉwirˉstatus.Typeˉmismatch,
                Module, Fieldˉexpression.Offset,
                Fieldˉexpression.Line, Fieldˉexpression.Column
            );
        }
        let Updatedˉoperands: Byteˉconstruction.Foundationˉbytesˉresult =
            Byteˉconstruction.Foundationˉbytesˉreplace(
                Operands, Member.Index * 4u32, 4u32,
                Bytesˉfromˉu32ˉlittle(Value.Temporary)
            );
        let Updatedˉseen: Byteˉconstruction.Foundationˉbytesˉresult =
            Byteˉconstruction.Foundationˉbytesˉreplace(
                Seen, Member.Index, 1u32, Bytesˉfromˉu8(1u8)
            );
        if !Updatedˉoperands.Valid || !Updatedˉseen.Valid {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Compilerˉsourceˉwirˉvalueˉbuild(Value),
                Compilerˉsourceˉwirˉstatus.Invalidˉdirectory,
                Module, Field.Offset, Field.Line, Field.Column
            );
        }
        Operands = Updatedˉoperands.Value;
        Seen = Updatedˉseen.Value;
        Result = Compilerˉsourceˉwirˉvalueˉbuild(Value);
        Cursor = Fieldˉexpression.Nextˉoffset;
        Position = Sourceˉbodies.Compilerˉsourceˉposition(
            Fieldˉexpression.Nextˉoffset,
            Fieldˉexpression.Nextˉline,
            Fieldˉexpression.Nextˉcolumn
        );
        if Item + 1u32 < Expression.Items {
            let Separator: Sourceˉlexer.Compilerˉsourceˉtoken =
                Sourceˉbodies.Compilerˉbodyˉtoken(
                    Source, Cursor, Position.Line, Position.Column,
                    Expression.Itemsˉoffset + Expression.Itemsˉlength
                );
            Cursor = Separator.Nextˉoffset;
            Position = Sourceˉbodies.Compilerˉsourceˉposition(
                Separator.Nextˉoffset,
                Separator.Nextˉline, Separator.Nextˉcolumn
            );
        }
        Item = Item + 1u32;
    }
    var Missing: u32 = 0u32;
    while Missing < Fields {
        if Bytesˉreadˉu8(Seen, Missing) == 0u8 {
            if Bytesˉlength(Preservedˉshapes) != Fields * 4u32 {
                var Missingˉstatus: Compilerˉsourceˉwirˉstatus =
                    Compilerˉsourceˉwirˉstatus.Missingˉrecordˉfield;
                if Isˉvariant {
                    Missingˉstatus =
                        Compilerˉsourceˉwirˉstatus.Missingˉvariantˉfield;
                }
                return Compilerˉsourceˉwirˉfailureˉvalue(
                    Result, Missingˉstatus,
                    Module, Expression.Offset,
                    Expression.Line, Expression.Column
                );
            }
            let Preserved: Compilerˉsourceˉwirˉvalue =
                Compilerˉsourceˉwirˉemit(
                    Result, WIR_OPERATION_RECORD_FIELD,
                    Bytesˉreadˉu32ˉlittle(
                        Preservedˉshapes, Missing * 4u32
                    ),
                    Compilerˉsourceˉwirˉoneˉoperand(Baseˉtemporary),
                    Target, Missing,
                    Expression.Firstˉoffset, Expression.Firstˉlength
                );
            if Preserved.Status != Compilerˉsourceˉwirˉstatus.Valid {
                return Preserved;
            }
            let Preservedˉoperands:
                Byteˉconstruction.Foundationˉbytesˉresult =
                Byteˉconstruction.Foundationˉbytesˉreplace(
                    Operands, Missing * 4u32, 4u32,
                    Bytesˉfromˉu32ˉlittle(Preserved.Temporary)
                );
            if !Preservedˉoperands.Valid {
                return Compilerˉsourceˉwirˉfailureˉvalue(
                    Compilerˉsourceˉwirˉvalueˉbuild(Preserved),
                    Compilerˉsourceˉwirˉstatus.Invalidˉdirectory,
                    Module, Expression.Offset,
                    Expression.Line, Expression.Column
                );
            }
            Operands = Preservedˉoperands.Value;
            Result = Compilerˉsourceˉwirˉvalueˉbuild(Preserved);
        }
        Missing = Missing + 1u32;
    }
    var Operation: u32 = WIR_OPERATION_RECORD_CREATE;
    if Isˉvariant { Operation = WIR_OPERATION_VARIANT_CREATE; }
    return Compilerˉsourceˉwirˉemit(
        Result, Operation, Shape, Operands, Target, Auxiliary,
        Expression.Offset, Expression.Length
    );
}

fn Compilerˉsourceˉwirˉcompileˉnamedˉvariant(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Bindingˉpayload: bytes,
    Bindingˉfirst: u32,
    Bindingˉentries: u32,
    Source: bytes,
    Expression: Sourceˉbodies.Compilerˉsourceˉexpression,
    Callable: Sourceˉbindings.Compilerˉsourceˉbindingˉmatch,
    Build: Compilerˉsourceˉwirˉbuild
) -> Compilerˉsourceˉwirˉvalue {
    let View: Sourceˉset.Compilerˉsourceˉsetˉview =
        Sourceˉset.Compilerˉsourceˉsetˉmodule(
            Input, Scan, Build.Currentˉmodule
        );
    if View.Edition != 1u32 {
        return Compilerˉsourceˉwirˉfailureˉvalue(
            Build, Compilerˉsourceˉwirˉstatus.Invalidˉvariantˉliteral,
            Callable.Module,
            Expression.Offset, Expression.Line, Expression.Column
        );
    }
    let Signature: Compilerˉsourceˉwirˉsignature =
        Compilerˉsourceˉwirˉcallableˉsignature(
            Input, Scan, Symbols, Callable, Source,
            Expression.Valueˉoffset, Expression.Valueˉlength, 0u32
        );
    let Constructionˉshape: u32 = Signature.Returnˉshape;
    let Constructionˉtarget: u32 = Signature.Target;
    let Caseˉview: Compilerˉsourceˉwirˉvariantˉcaseˉview =
        Compilerˉsourceˉwirˉvariantˉcaseˉviewˉbyˉindex(
            Input, Scan, Symbols,
            Compilerˉsourceˉwirˉgenericˉtypeˉcatalog(
                Build.Genericˉevidence
            ),
            Constructionˉtarget, Signature.Auxiliary
        );
    let Fieldˉcount: u32 = Caseˉview.Fields;
    if !Caseˉview.Found || Fieldˉcount != Callable.Items {
        return Compilerˉsourceˉwirˉfailureˉvalue(
            Build, Compilerˉsourceˉwirˉstatus.Invalidˉvariantˉliteral,
            Callable.Module,
            Expression.Offset, Expression.Line, Expression.Column
        );
    }
    return Compilerˉsourceˉwirˉcompileˉnominalˉfields(
        Input, Scan, Symbols,
        Compilerˉsourceˉwirˉgenericˉtypeˉcatalog(
            Build.Genericˉevidence
        ),
        Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
        Source, Expression, Callable.Module,
        Constructionˉshape, Constructionˉtarget,
        Signature.Auxiliary, Fieldˉcount, true,
        Compilerˉsourceˉwirˉempty(Source),
        Compilerˉsourceˉwirˉsentinel(), Build
    );
}

fn Compilerˉsourceˉwirˉcompileˉgenericˉnamedˉvariant(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Bindingˉpayload: bytes,
    Bindingˉfirst: u32,
    Bindingˉentries: u32,
    Source: bytes,
    Expression: Sourceˉbodies.Compilerˉsourceˉexpression,
    Bound: Genericˉtypeˉbinding.Compilerˉsourceˉgenericˉtypeˉbinding,
    Caseˉoffset: u32,
    Caseˉlength: u32,
    Build: Compilerˉsourceˉwirˉbuild
) -> Compilerˉsourceˉwirˉvalue {
    if Bound.Status !=
            Sourceˉsymbols.Compilerˉsourceˉsymbolˉstatus.Valid ||
        Bound.Genericˉstatus !=
            Sourceˉgenerics.Compilerˉsourceˉgenericˉstatus.Valid ||
        Bound.Nominalˉkind !=
            Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Variant ||
        !Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉshapeˉisˉprivate(
            Bound.Shape
        ) {
        return Compilerˉsourceˉwirˉfailureˉvalue(
            Build, Compilerˉsourceˉwirˉstatus.Invalidˉvariantˉliteral,
            Bound.Module,
            Bound.Failureˉoffset, Bound.Failureˉline, Bound.Failureˉcolumn
        );
    }
    let Catalog: Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog =
        Genericˉtypeˉbinding.Compilerˉsourceˉgenericˉtypeˉbindingˉcatalog(
            Bound
        );
    let Instance: u32 =
        Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉshapeˉinstance(
            Bound.Shape
        );
    let Layout: Genericˉlayouts.Compilerˉsourceˉgenericˉtypeˉlayout =
        Genericˉlayouts.Compilerˉsourceˉgenericˉtypeˉlayoutˉcreate(
            Input, Scan, Symbols, Catalog, Instance
        );
    if Layout.Shape != Bound.Shape || Layout.Declaration != Bound.Declaration ||
        Layout.Kind !=
            Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Variant ||
        Layout.Items > 256u32 ||
        !Genericˉlayouts.Compilerˉsourceˉgenericˉtypeˉlayoutˉisˉvalid(
            Input, Scan, Symbols, Layout
        ) {
        return Compilerˉsourceˉwirˉfailureˉvalue(
            Build, Compilerˉsourceˉwirˉstatus.Invalidˉvariantˉliteral,
            Bound.Module,
            Expression.Offset, Expression.Line, Expression.Column
        );
    }
    let Templateˉnominal: Sourceˉsymbols.Compilerˉsourceˉsymbolˉmatch =
        Sourceˉsymbols.Compilerˉsourceˉsymbolsˉdirectoryˉentry(
            Symbols.Directory, Scan.Modules, Bound.Declaration
        );
    let Selected: Compilerˉsourceˉwirˉmember =
        Compilerˉsourceˉwirˉnominalˉmember(
            Input, Scan, Symbols, Templateˉnominal,
            Source, Caseˉoffset, Caseˉlength
        );
    if !Selected.Found {
        return Compilerˉsourceˉwirˉfailureˉvalue(
            Build, Compilerˉsourceˉwirˉstatus.Unknownˉvariantˉcase,
            Bound.Module,
            Caseˉoffset, Expression.Line, Expression.Column
        );
    }
    let Caseˉview: Genericˉlayouts.Compilerˉsourceˉgenericˉtypeˉcase =
        Genericˉlayouts.Compilerˉsourceˉgenericˉtypeˉlayoutˉvariantˉcase(
            Input, Scan, Symbols, Layout, Selected.Index
        );
    if !Caseˉview.Found || Caseˉview.Fields > 64u32 {
        return Compilerˉsourceˉwirˉfailureˉvalue(
            Build, Compilerˉsourceˉwirˉstatus.Invalidˉvariantˉliteral,
            Bound.Module,
            Expression.Offset, Expression.Line, Expression.Column
        );
    }
    var Result: Compilerˉsourceˉwirˉbuild =
        Compilerˉsourceˉwirˉwithˉgenericˉtypeˉevidence(
            Build, Bound.Catalogˉevidence
        );
    return Compilerˉsourceˉwirˉcompileˉnominalˉfields(
        Input, Scan, Symbols, Catalog,
        Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
        Source, Expression, Bound.Module,
        Bound.Shape, Bound.Shape, Selected.Index,
        Caseˉview.Fields, true,
        Compilerˉsourceˉwirˉempty(Source),
        Compilerˉsourceˉwirˉsentinel(), Result
    );
}

fn Compilerˉsourceˉwirˉcompileˉgenericˉnamedˉrecord(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Bindingˉpayload: bytes,
    Bindingˉfirst: u32,
    Bindingˉentries: u32,
    Source: bytes,
    Expression: Sourceˉbodies.Compilerˉsourceˉexpression,
    Bound: Genericˉtypeˉbinding.Compilerˉsourceˉgenericˉtypeˉbinding,
    Build: Compilerˉsourceˉwirˉbuild
) -> Compilerˉsourceˉwirˉvalue {
    if Bound.Status !=
            Sourceˉsymbols.Compilerˉsourceˉsymbolˉstatus.Valid ||
        Bound.Genericˉstatus !=
            Sourceˉgenerics.Compilerˉsourceˉgenericˉstatus.Valid ||
        Bound.Nominalˉkind !=
            Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Record {
        return Compilerˉsourceˉwirˉfailureˉvalue(
            Build, Compilerˉsourceˉwirˉstatus.Invalidˉrecordˉliteral,
            Bound.Module,
            Bound.Failureˉoffset, Bound.Failureˉline, Bound.Failureˉcolumn
        );
    }
    let Catalog: Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog =
        Genericˉtypeˉbinding.Compilerˉsourceˉgenericˉtypeˉbindingˉcatalog(
            Bound
        );
    let Instance: u32 =
        Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉshapeˉinstance(
            Bound.Shape
        );
    let Layout: Genericˉlayouts.Compilerˉsourceˉgenericˉtypeˉlayout =
        Genericˉlayouts.Compilerˉsourceˉgenericˉtypeˉlayoutˉcreate(
            Input, Scan, Symbols, Catalog, Instance
        );
    if Layout.Shape != Bound.Shape || Layout.Declaration != Bound.Declaration ||
        Layout.Kind !=
            Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Record ||
        Layout.Fields > 64u32 ||
        Bytesˉlength(Layout.Fieldˉevidence) != Layout.Fields * 16u32 ||
        !Genericˉlayouts.Compilerˉsourceˉgenericˉtypeˉlayoutˉisˉvalid(
            Input, Scan, Symbols, Layout
        ) {
        return Compilerˉsourceˉwirˉfailureˉvalue(
            Build, Compilerˉsourceˉwirˉstatus.Invalidˉrecordˉliteral,
            Bound.Module,
            Expression.Offset, Expression.Line, Expression.Column
        );
    }
    if Compilerˉsourceˉwirˉshapeˉisˉfoundationˉunsafeˉopaque(
            Input, Scan, Symbols, Catalog, Bound.Shape
        ) {
        return Compilerˉsourceˉwirˉfailureˉvalue(
            Build, Compilerˉsourceˉwirˉstatus.Invalidˉunsafeˉvalue,
            Bound.Module,
            Expression.Offset, Expression.Line, Expression.Column
        );
    }
    var Result: Compilerˉsourceˉwirˉbuild =
        Compilerˉsourceˉwirˉwithˉgenericˉtypeˉevidence(
            Build, Bound.Catalogˉevidence
        );
    return Compilerˉsourceˉwirˉcompileˉnominalˉfields(
        Input, Scan, Symbols, Catalog,
        Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
        Source, Expression, Bound.Module,
        Bound.Shape, Bound.Shape, Bound.Declaration,
        Layout.Fields, false,
        Compilerˉsourceˉwirˉempty(Source),
        Compilerˉsourceˉwirˉsentinel(), Result
    );
}

fn Compilerˉsourceˉwirˉcompileˉgenericˉnamedˉnominal(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Bindingˉpayload: bytes,
    Bindingˉfirst: u32,
    Bindingˉentries: u32,
    Source: bytes,
    Expression: Sourceˉbodies.Compilerˉsourceˉexpression,
    Build: Compilerˉsourceˉwirˉbuild
) -> Compilerˉsourceˉwirˉvalue {
    var Lastˉdot: u32 = Expression.Valueˉlength;
    var Character: u32 = 0u32;
    while Character < Expression.Valueˉlength {
        if Bytesˉreadˉu8(
                Source, Expression.Valueˉoffset + Character
            ) == 46u8 {
            Lastˉdot = Character;
        }
        Character = Character + 1u32;
    }
    if Lastˉdot < Expression.Valueˉlength {
        let Constructorˉnominal:
            Sourceˉsymbols.Compilerˉsourceˉsymbolˉmatch =
            Sourceˉsymbols.Compilerˉsourceˉsymbolsˉfindˉownedˉnominal(
                Input, Scan, Symbols.Directory, Symbols.Lookup,
                Build.Currentˉmodule, Source,
                Expression.Valueˉoffset, Lastˉdot
            );
        if Constructorˉnominal.Found && Constructorˉnominal.Kind ==
                Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Variant {
            let Argumentsˉposition:
                Sourceˉbodies.Compilerˉsourceˉposition =
                Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
                    Source, Expression.Offset,
                    Expression.Line, Expression.Column,
                    Expression.Valueˉoffset + Expression.Valueˉlength
                );
            let Arguments: Sourceˉlexer.Compilerˉsourceˉtoken =
                Sourceˉbodies.Compilerˉbodyˉtoken(
                    Source,
                    Expression.Valueˉoffset + Expression.Valueˉlength,
                    Argumentsˉposition.Line, Argumentsˉposition.Column,
                    Expression.Offset + Expression.Length
                );
            let Bound:
                Genericˉtypeˉbinding.Compilerˉsourceˉgenericˉtypeˉbinding =
                Compilerˉsourceˉwirˉbindˉgenericˉtypeˉat(
                    Input, Scan, Symbols, Source,
                    Expression.Valueˉoffset,
                    Expression.Line, Expression.Column,
                    Lastˉdot, Arguments.Offset,
                    Arguments.Line, Arguments.Column, Build
                );
            return Compilerˉsourceˉwirˉcompileˉgenericˉnamedˉvariant(
                Input, Scan, Symbols,
                Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
                Source, Expression, Bound,
                Expression.Valueˉoffset + Lastˉdot + 1u32,
                Expression.Valueˉlength - Lastˉdot - 1u32, Build
            );
        }
    }
    let Direct: Genericˉtypeˉbinding.Compilerˉsourceˉgenericˉtypeˉbinding =
        Compilerˉsourceˉwirˉbindˉgenericˉtypeˉat(
            Input, Scan, Symbols, Source,
            Expression.Valueˉoffset, Expression.Line, Expression.Column,
            0u32, 0u32, 0u32, 0u32, Build
        );
    return Compilerˉsourceˉwirˉcompileˉgenericˉnamedˉrecord(
        Input, Scan, Symbols,
        Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
        Source, Expression, Direct, Build
    );
}

export fn Compilerˉsourceˉwirˉcompileˉnamedˉrecord(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Bindingˉpayload: bytes,
    Bindingˉfirst: u32,
    Bindingˉentries: u32,
    Source: bytes,
    Expression: Sourceˉbodies.Compilerˉsourceˉexpression,
    Build: Compilerˉsourceˉwirˉbuild
) -> Compilerˉsourceˉwirˉvalue {
    let Isˉupdate: bool =
        Expression.Kind == Sourceˉbodies.Compilerˉsourceˉexpressionˉkind.Recordˉupdate;
    if Expression.Kind ==
            Sourceˉbodies.Compilerˉsourceˉexpressionˉkind.Genericˉnamedˉrecord {
        return Compilerˉsourceˉwirˉcompileˉgenericˉnamedˉnominal(
            Input, Scan, Symbols,
            Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
            Source, Expression, Build
        );
    }
    if Isˉupdate {
        let Updateˉview: Sourceˉset.Compilerˉsourceˉsetˉview =
            Sourceˉset.Compilerˉsourceˉsetˉmodule(
                Input, Scan, Build.Currentˉmodule
            );
        if Updateˉview.Edition != 1u32 {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Build, Compilerˉsourceˉwirˉstatus.Invalidˉrecordˉupdate,
                Build.Currentˉmodule,
                Expression.Offset, Expression.Line, Expression.Column
            );
        }
    }
    let Callable: Sourceˉbindings.Compilerˉsourceˉbindingˉmatch = Sourceˉbindings.Compilerˉsourceˉbindingsˉfindˉcallable(
        Input, Scan, Symbols, Build.Currentˉmodule, Source,
        Expression.Valueˉoffset, Expression.Valueˉlength
    );
    if !Callable.Found || !Callable.Accessible {
        return Compilerˉsourceˉwirˉfailureˉvalue(
            Build, Compilerˉsourceˉwirˉstatus.Invalidˉrecordˉliteral,
            Callable.Module, Expression.Offset, Expression.Line, Expression.Column
        );
    }
    if !Isˉupdate &&
        Callable.Kind == Sourceˉbindings.Compilerˉsourceˉcallableˉkind.Variantˉcase {
        return Compilerˉsourceˉwirˉcompileˉnamedˉvariant(
            Input, Scan, Symbols,
            Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
            Source, Expression, Callable, Build
        );
    }
    if Callable.Kind != Sourceˉbindings.Compilerˉsourceˉcallableˉkind.Record {
        return Compilerˉsourceˉwirˉfailureˉvalue(
            Build, Compilerˉsourceˉwirˉstatus.Invalidˉrecordˉliteral,
            Callable.Module, Expression.Offset, Expression.Line, Expression.Column
        );
    }
    let Signature: Compilerˉsourceˉwirˉsignature = Compilerˉsourceˉwirˉrecordˉsignature(
        Input, Scan, Symbols, Callable, 0u32
    );
    var Result: Compilerˉsourceˉwirˉbuild = Build;
    var Baseˉtemporary: u32 = Compilerˉsourceˉwirˉsentinel();
    var Preservedˉshapes: bytes = Compilerˉsourceˉwirˉempty(Source);
    if Isˉupdate {
        let Baseˉposition: Sourceˉbodies.Compilerˉsourceˉposition =
            Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
                Source, Expression.Offset, Expression.Line, Expression.Column,
                Expression.Firstˉoffset
            );
        let Baseˉvalue: Compilerˉsourceˉwirˉvalue =
            Compilerˉsourceˉwirˉcompileˉexpression(
                Input, Scan, Symbols,
                Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
                Source, Expression.Firstˉoffset, Baseˉposition.Line,
                Baseˉposition.Column,
                Expression.Firstˉoffset + Expression.Firstˉlength,
                Result
            );
        if Baseˉvalue.Status != Compilerˉsourceˉwirˉstatus.Valid {
            return Baseˉvalue;
        }
        if Baseˉvalue.Shape == 10u32 { return Baseˉvalue; }
        if Baseˉvalue.Shape != Signature.Returnˉshape {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Compilerˉsourceˉwirˉvalueˉbuild(Baseˉvalue),
                Compilerˉsourceˉwirˉstatus.Invalidˉrecordˉupdate,
                Callable.Module, Expression.Firstˉoffset,
                Baseˉposition.Line, Baseˉposition.Column
            );
        }
        Baseˉtemporary = Baseˉvalue.Temporary;
        Result = Compilerˉsourceˉwirˉvalueˉbuild(Baseˉvalue);
        var Preservedˉindex: u32 = 0u32;
        while Preservedˉindex < Callable.Items {
            let Preservedˉsignature: Compilerˉsourceˉwirˉsignature =
                Compilerˉsourceˉwirˉrecordˉsignature(
                    Input, Scan, Symbols, Callable, Preservedˉindex
                );
            Preservedˉshapes = Bytesˉconcat(
                Preservedˉshapes,
                Bytesˉfromˉu32ˉlittle(
                    Preservedˉsignature.Parameterˉshape
                )
            );
            Preservedˉindex = Preservedˉindex + 1u32;
        }
    }
    return Compilerˉsourceˉwirˉcompileˉnominalˉfields(
        Input, Scan, Symbols,
        Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalogˉempty(),
        Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
        Source, Expression, Callable.Module,
        Signature.Returnˉshape, Signature.Target, Signature.Auxiliary,
        Callable.Items, false, Preservedˉshapes, Baseˉtemporary, Result
    );
}

fn Compilerˉsourceˉwirˉcurrentˉreturnˉshape(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Source: bytes,
    Build: Compilerˉsourceˉwirˉbuild
) -> u32 {
    let Genericˉcatalog: Sourceˉgenerics.Compilerˉsourceˉgenericˉcatalog =
        Compilerˉsourceˉwirˉgenericˉcatalog(Build.Genericˉevidence);
    let Baseˉfunctions: u32 = Compilerˉsourceˉwirˉsymbolˉentries(Symbols) +
        Sourceˉgenerics.Compilerˉsourceˉgenericˉcatalogˉinstances(
            Genericˉcatalog
        );
    if Build.Currentˉfunction >= Baseˉfunctions {
        let Closures: Closureˉlowering.Compilerˉsourceˉclosureˉcatalog =
            Compilerˉsourceˉwirˉclosureˉcatalog(Build);
        let Closureˉinstance: u32 = Build.Currentˉfunction - Baseˉfunctions;
        let Functionˉtype: u32 =
            Closureˉlowering.Compilerˉsourceˉclosureˉcatalogˉfunctionˉtype(
                Closures, Closureˉinstance
            );
        return Compilerˉsourceˉwirˉfunctionˉtypeˉresultˉshape(
            Compilerˉsourceˉwirˉfunctionˉtypeˉcatalogˉfromˉgeneric(
                Build.Genericˉevidence
            ),
            Functionˉtype
        );
    }
    var Declaration: u32 = Build.Currentˉfunction;
    if Build.Genericˉinstance != Compilerˉsourceˉwirˉsentinel() {
        Declaration =
            Sourceˉgenerics.Compilerˉsourceˉgenericˉcatalogˉinstanceˉdeclaration(
                Genericˉcatalog, Build.Genericˉinstance
            );
    }
    let Entry: u32 = 16u32 + Declaration * 24u32;
    let Declarationˉoffset: u32 = Bytesˉreadˉu32ˉlittle(
        Symbols.Directory, Entry + 8u32
    );
    let Signature: Compilerˉsourceˉwirˉsignature =
        Compilerˉsourceˉwirˉfunctionˉsignatureˉconcrete(
            Input, Scan, Symbols,
            Build.Currentˉmodule,
            Source,
            Declarationˉoffset,
            Compilerˉsourceˉwirˉsentinel(),
            Genericˉcatalog,
            Compilerˉsourceˉwirˉgenericˉtypeˉcatalog(Build.Genericˉevidence),
            Build.Genericˉinstance
        );
    return Signature.Returnˉshape;
}

fn Compilerˉsourceˉwirˉparameterˉborrowˉmode(
    Source: bytes,
    Local: Sourceˉbindings.Compilerˉsourceˉlocalˉmatch
) -> u32 {
    if !Local.Found ||
        Local.Kind != Sourceˉbindings.Compilerˉsourceˉbindingˉkind.Parameter {
        return Sourceˉdeclarations.COMPILER_SOURCE_BORROW_MODE_VALUE;
    }
    let Name: Sourceˉlexer.Compilerˉsourceˉtoken =
        Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Source, Local.Declarationˉoffset, 1u32, 1u32
        );
    let Colon: Sourceˉlexer.Compilerˉsourceˉtoken =
        Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Source, Name.Nextˉoffset, Name.Nextˉline, Name.Nextˉcolumn
        );
    return Sourceˉdeclarations.Compilerˉsourceˉparameterˉborrowˉmode(
        Source, Colon.Nextˉoffset, Colon.Nextˉline, Colon.Nextˉcolumn
    );
}

fn Compilerˉsourceˉwirˉisˉfoundationˉresult(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Nominal: Sourceˉsymbols.Compilerˉsourceˉsymbolˉmatch
) -> bool {
    if !Nominal.Found || Nominal.Kind !=
        Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Variant {
        return false;
    }
    let View: Sourceˉset.Compilerˉsourceˉsetˉview =
        Sourceˉset.Compilerˉsourceˉsetˉmodule(Input, Scan, Nominal.Module);
    if View.Edition != 1u32 { return false; }
    let Header: Sourceˉdeclarations.Compilerˉsourceˉheader =
        Sourceˉdeclarations.Compilerˉparseˉheaderˉvalidated(View.Source);
    return Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(
            View.Source, Header.Nameˉoffset, Header.Nameˉlength,
            "Foundationˉresult"
        ) &&
        Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(
            View.Source, Nominal.Nameˉoffset, Nominal.Nameˉlength, "Result"
        );
}

fn Compilerˉsourceˉwirˉresultˉlayoutˉmissing(
) -> Compilerˉsourceˉwirˉmember {
    return Compilerˉsourceˉwirˉmember(false, 0u32, 0u32);
}

fn Compilerˉsourceˉwirˉgenericˉfoundationˉresultˉlayout(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Catalog: Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog,
    Shape: u32
) -> Compilerˉsourceˉwirˉmember {
    if !Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉshapeˉisˉprivate(
            Shape
        ) {
        return Compilerˉsourceˉwirˉresultˉlayoutˉmissing();
    }
    let Instance: u32 =
        Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉshapeˉinstance(Shape);
    let Layout: Genericˉlayouts.Compilerˉsourceˉgenericˉtypeˉlayout =
        Genericˉlayouts.Compilerˉsourceˉgenericˉtypeˉlayoutˉcreate(
            Input, Scan, Symbols, Catalog, Instance
        );
    if Layout.Shape != Shape || Layout.Items != 2u32 || Layout.Fields != 2u32 ||
        Layout.Kind !=
            Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Variant ||
        !Genericˉlayouts.Compilerˉsourceˉgenericˉtypeˉlayoutˉisˉvalid(
            Input, Scan, Symbols, Layout
        ) {
        return Compilerˉsourceˉwirˉresultˉlayoutˉmissing();
    }
    let Nominal: Sourceˉsymbols.Compilerˉsourceˉsymbolˉmatch =
        Sourceˉsymbols.Compilerˉsourceˉsymbolsˉdirectoryˉentry(
            Symbols.Directory, Scan.Modules, Layout.Declaration
        );
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉfoundationˉgenericˉfamily(
            Input, Scan, Nominal
        ) != 2u32 {
        return Compilerˉsourceˉwirˉresultˉlayoutˉmissing();
    }
    let Valid: Genericˉlayouts.Compilerˉsourceˉgenericˉtypeˉcase =
        Genericˉlayouts.Compilerˉsourceˉgenericˉtypeˉlayoutˉvariantˉcase(
            Input, Scan, Symbols, Layout, 0u32
        );
    let Failure: Genericˉlayouts.Compilerˉsourceˉgenericˉtypeˉcase =
        Genericˉlayouts.Compilerˉsourceˉgenericˉtypeˉlayoutˉvariantˉcase(
            Input, Scan, Symbols, Layout, 1u32
        );
    let Value: Genericˉlayouts.Compilerˉsourceˉgenericˉtypeˉfield =
        Genericˉlayouts.Compilerˉsourceˉgenericˉtypeˉlayoutˉvariantˉfield(
            Input, Scan, Symbols, Layout, 0u32, 0u32
        );
    let Error: Genericˉlayouts.Compilerˉsourceˉgenericˉtypeˉfield =
        Genericˉlayouts.Compilerˉsourceˉgenericˉtypeˉlayoutˉvariantˉfield(
            Input, Scan, Symbols, Layout, 1u32, 0u32
        );
    if !Valid.Found || Valid.Fields != 1u32 ||
        !Failure.Found || Failure.Fields != 1u32 ||
        !Value.Found || !Error.Found {
        return Compilerˉsourceˉwirˉresultˉlayoutˉmissing();
    }
    return Compilerˉsourceˉwirˉmember(
        true, Value.Shape, Error.Shape
    );
}

fn Compilerˉsourceˉwirˉisˉfoundationˉallocationˉfailure(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Shape: u32,
    Module: u32
) -> bool {
    if Shape < 65536u32 || Shape >= 131072u32 || Module >= Scan.Modules {
        return false;
    }
    let Nominal: Sourceˉsymbols.Compilerˉsourceˉsymbolˉmatch =
        Compilerˉsourceˉwirˉnominalˉbyˉshape(
            Input, Scan, Symbols, Shape
        );
    if !Nominal.Found || Nominal.Module != Module || Nominal.Kind !=
            Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Record {
        return false;
    }
    let View: Sourceˉset.Compilerˉsourceˉsetˉview =
        Sourceˉset.Compilerˉsourceˉsetˉmodule(Input, Scan, Module);
    if View.Edition != 1u32 { return false; }
    let Header: Sourceˉdeclarations.Compilerˉsourceˉheader =
        Sourceˉdeclarations.Compilerˉparseˉheaderˉvalidated(
            View.Source
        );
    if !Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(
            View.Source, Header.Nameˉoffset, Header.Nameˉlength,
            "Foundationˉmemory"
        ) ||
        !Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(
            View.Source, Nominal.Nameˉoffset, Nominal.Nameˉlength,
            "Allocationˉfailure"
        ) {
        return false;
    }
    let Declaration: Sourceˉdeclarations.Compilerˉsourceˉdeclaration =
        Sourceˉdeclarations.Compilerˉparseˉnextˉdeclarationˉvalidated(
            View.Source, Nominal.Declarationˉoffset, 1u32, 1u32, true
        );
    if Declaration.Kind !=
            Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Record ||
        Declaration.Items != 3u32 {
        return false;
    }
    let Reason: Compilerˉsourceˉwirˉmember =
        Compilerˉsourceˉwirˉnominalˉmember(
            Input, Scan, Symbols, Nominal,
            Textˉtoˉutf8("Reason"), 0u32, 6u32
        );
    let Requested: Compilerˉsourceˉwirˉmember =
        Compilerˉsourceˉwirˉnominalˉmember(
            Input, Scan, Symbols, Nominal,
            Textˉtoˉutf8("Requestedˉbytes"), 0u32, 16u32
        );
    let Available: Compilerˉsourceˉwirˉmember =
        Compilerˉsourceˉwirˉnominalˉmember(
            Input, Scan, Symbols, Nominal,
            Textˉtoˉutf8("Availableˉbytes"), 0u32, 16u32
        );
    if !Reason.Found || Reason.Index != 0u32 ||
        !Requested.Found || Requested.Index != 1u32 || Requested.Shape != 8u32 ||
        !Available.Found || Available.Index != 2u32 || Available.Shape != 8u32 {
        return false;
    }
    let Reasonˉnominal: Sourceˉsymbols.Compilerˉsourceˉsymbolˉmatch =
        Compilerˉsourceˉwirˉnominalˉbyˉshape(
            Input, Scan, Symbols, Reason.Shape
        );
    return Reasonˉnominal.Found && Reasonˉnominal.Module == Module &&
        Reasonˉnominal.Kind ==
            Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Enum &&
        Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(
            View.Source,
            Reasonˉnominal.Nameˉoffset, Reasonˉnominal.Nameˉlength,
            "Allocationˉreason"
        );
}

fn Compilerˉsourceˉwirˉisˉexactˉfoundationˉrecord(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Shape: u32,
    Moduleˉname: text,
    Typeˉname: text
) -> bool {
    if Shape < 65536u32 || Shape >= 131072u32 { return false; }
    let Nominal: Sourceˉsymbols.Compilerˉsourceˉsymbolˉmatch =
        Compilerˉsourceˉwirˉnominalˉbyˉshape(
            Input, Scan, Symbols, Shape
        );
    if !Nominal.Found || Nominal.Module >= Scan.Modules || Nominal.Kind !=
            Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Record {
        return false;
    }
    let View: Sourceˉset.Compilerˉsourceˉsetˉview =
        Sourceˉset.Compilerˉsourceˉsetˉmodule(Input, Scan, Nominal.Module);
    let Header: Sourceˉdeclarations.Compilerˉsourceˉheader =
        Sourceˉdeclarations.Compilerˉparseˉheaderˉvalidated(View.Source);
    return View.Edition == 1u32 && Header.Profile ==
            Sourceˉdeclarations.Compilerˉsourceˉprofile.Hosted &&
        Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(
            View.Source, Header.Nameˉoffset, Header.Nameˉlength,
            Moduleˉname
        ) &&
        Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(
            View.Source, Nominal.Nameˉoffset, Nominal.Nameˉlength,
            Typeˉname
        );
}

fn Compilerˉsourceˉwirˉshapeˉisˉtaskˉscope(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
