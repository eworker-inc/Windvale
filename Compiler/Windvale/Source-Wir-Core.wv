        Value.Status,
        Value.Functionˉpayload, Value.Blockˉpayload, Value.Operationˉpayload,
        Value.Temporaryˉpayload, Value.Operandˉpayload,
        Value.Functionˉentries, Value.Blocks, Value.Operations,
        Value.Temporaries, Value.Operands,
        Value.Currentˉmodule, Value.Currentˉfunction,
        Value.Functionˉfirstˉblock, Value.Functionˉfirstˉoperation,
        Value.Functionˉfirstˉtemporary, Value.Functionˉfirstˉoperand,
        Value.Nextˉblock, Value.Currentˉblock,
        Value.Currentˉblockˉfirstˉoperation, Value.Hasˉcurrentˉblock,
        Value.Bindingˉpayload, Value.Bindingˉentries,
        Value.Bindingˉparameters, Value.Bindingˉlocals, Value.Bindingˉnextˉslot,
        Value.Failureˉmodule, Value.Failureˉrelatedˉmodule,
        Value.Failureˉfunction, Value.Failureˉoffset,
        Value.Failureˉline, Value.Failureˉcolumn
    );
}

export fn Compilerˉsourceˉwirˉblockˉplaceholder(Input: bytes) -> bytes {
    var Result: bytes = Compilerˉsourceˉwirˉempty(Input);
    var Field: u32 = 0u32;
    while Field < 9u32 {
        Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(0u32));
        Field = Field + 1u32;
    }
    return Result;
}

export fn Compilerˉsourceˉwirˉstartˉfunction(
    Build: Compilerˉsourceˉwirˉbuild,
    Module: u32,
    Function: u32
) -> Compilerˉsourceˉwirˉbuild {
    let Empty: bytes = Compilerˉsourceˉwirˉempty(Build.Blockˉpayload);
    let Rootˉblock: bytes = Compilerˉsourceˉwirˉblockˉplaceholder(Empty);
    return Compilerˉsourceˉwirˉbuild(
        Build.Status,
        Empty, Rootˉblock, Empty, Empty, Empty,
        Build.Functionˉentries, Build.Blocks + 1u32, Build.Operations,
        Build.Temporaries, Build.Operands,
        Module, Function,
        Build.Blocks, Build.Operations, Build.Temporaries, Build.Operands,
        1u32, 0u32, Build.Operations, true,
        Build.Bindingˉpayload, Build.Bindingˉentries,
        Build.Bindingˉparameters, Build.Bindingˉlocals, Build.Bindingˉnextˉslot,
        Build.Failureˉmodule, Build.Failureˉrelatedˉmodule,
        Build.Failureˉfunction, Build.Failureˉoffset,
        Build.Failureˉline, Build.Failureˉcolumn
    );
}

export fn Compilerˉsourceˉwirˉwithoutˉcurrentˉblock(
    Build: Compilerˉsourceˉwirˉbuild
) -> Compilerˉsourceˉwirˉbuild {
    return Compilerˉsourceˉwirˉbuild(
        Build.Status,
        Build.Functionˉpayload, Build.Blockˉpayload, Build.Operationˉpayload,
        Build.Temporaryˉpayload, Build.Operandˉpayload,
        Build.Functionˉentries, Build.Blocks, Build.Operations,
        Build.Temporaries, Build.Operands,
        Build.Currentˉmodule, Build.Currentˉfunction,
        Build.Functionˉfirstˉblock, Build.Functionˉfirstˉoperation,
        Build.Functionˉfirstˉtemporary, Build.Functionˉfirstˉoperand,
        Build.Nextˉblock, Build.Currentˉblock,
        Build.Currentˉblockˉfirstˉoperation, false,
        Build.Bindingˉpayload, Build.Bindingˉentries,
        Build.Bindingˉparameters, Build.Bindingˉlocals, Build.Bindingˉnextˉslot,
        Build.Failureˉmodule, Build.Failureˉrelatedˉmodule,
        Build.Failureˉfunction, Build.Failureˉoffset,
        Build.Failureˉline, Build.Failureˉcolumn
    );
}

export fn Compilerˉsourceˉwirˉreserveˉblocks(
    Build: Compilerˉsourceˉwirˉbuild,
    Count: u32
) -> Compilerˉsourceˉwirˉbuild {
    var Blockˉpayload: bytes = Build.Blockˉpayload;
    var Added: u32 = 0u32;
    while Added < Count {
        if Bytesˉlength(Blockˉpayload) > 4194268u32 {
            let Partial: Compilerˉsourceˉwirˉbuild = Compilerˉsourceˉwirˉbuild(
                Build.Status,
                Build.Functionˉpayload, Blockˉpayload, Build.Operationˉpayload,
                Build.Temporaryˉpayload, Build.Operandˉpayload,
                Build.Functionˉentries, Build.Blocks + Added, Build.Operations,
                Build.Temporaries, Build.Operands,
                Build.Currentˉmodule, Build.Currentˉfunction,
                Build.Functionˉfirstˉblock, Build.Functionˉfirstˉoperation,
                Build.Functionˉfirstˉtemporary, Build.Functionˉfirstˉoperand,
                Build.Nextˉblock + Added, Build.Currentˉblock,
                Build.Currentˉblockˉfirstˉoperation, Build.Hasˉcurrentˉblock,
                Build.Bindingˉpayload, Build.Bindingˉentries,
                Build.Bindingˉparameters, Build.Bindingˉlocals, Build.Bindingˉnextˉslot,
                Build.Failureˉmodule, Build.Failureˉrelatedˉmodule,
                Build.Failureˉfunction, Build.Failureˉoffset,
                Build.Failureˉline, Build.Failureˉcolumn
            );
            return Compilerˉsourceˉwirˉbuildˉfailure(
                Partial,
                Compilerˉsourceˉwirˉstatus.Evidenceˉlimit,
                Build.Currentˉmodule, Build.Currentˉmodule,
                Build.Currentˉfunction, 0u32, 0u32, 0u32
            );
        }
        Blockˉpayload = Bytesˉconcat(
            Blockˉpayload,
            Compilerˉsourceˉwirˉblockˉplaceholder(Blockˉpayload)
        );
        Added = Added + 1u32;
    }
    return Compilerˉsourceˉwirˉbuild(
        Build.Status,
        Build.Functionˉpayload, Blockˉpayload, Build.Operationˉpayload,
        Build.Temporaryˉpayload, Build.Operandˉpayload,
        Build.Functionˉentries, Build.Blocks + Count, Build.Operations,
        Build.Temporaries, Build.Operands,
        Build.Currentˉmodule, Build.Currentˉfunction,
        Build.Functionˉfirstˉblock, Build.Functionˉfirstˉoperation,
        Build.Functionˉfirstˉtemporary, Build.Functionˉfirstˉoperand,
        Build.Nextˉblock + Count, Build.Currentˉblock,
        Build.Currentˉblockˉfirstˉoperation, Build.Hasˉcurrentˉblock,
        Build.Bindingˉpayload, Build.Bindingˉentries,
        Build.Bindingˉparameters, Build.Bindingˉlocals, Build.Bindingˉnextˉslot,
        Build.Failureˉmodule, Build.Failureˉrelatedˉmodule,
        Build.Failureˉfunction, Build.Failureˉoffset,
        Build.Failureˉline, Build.Failureˉcolumn
    );
}

export fn Compilerˉsourceˉwirˉbeginˉreservedˉblock(
    Build: Compilerˉsourceˉwirˉbuild,
    Block: u32
) -> Compilerˉsourceˉwirˉbuild {
    return Compilerˉsourceˉwirˉbuild(
        Build.Status,
        Build.Functionˉpayload, Build.Blockˉpayload, Build.Operationˉpayload,
        Build.Temporaryˉpayload, Build.Operandˉpayload,
        Build.Functionˉentries, Build.Blocks, Build.Operations,
        Build.Temporaries, Build.Operands,
        Build.Currentˉmodule, Build.Currentˉfunction,
        Build.Functionˉfirstˉblock, Build.Functionˉfirstˉoperation,
        Build.Functionˉfirstˉtemporary, Build.Functionˉfirstˉoperand,
        Build.Nextˉblock, Block, Build.Operations, true,
        Build.Bindingˉpayload, Build.Bindingˉentries,
        Build.Bindingˉparameters, Build.Bindingˉlocals, Build.Bindingˉnextˉslot,
        Build.Failureˉmodule, Build.Failureˉrelatedˉmodule,
        Build.Failureˉfunction, Build.Failureˉoffset,
        Build.Failureˉline, Build.Failureˉcolumn
    );
}

export fn Compilerˉsourceˉwirˉappendˉblock(
    Build: Compilerˉsourceˉwirˉbuild,
    Block: u32,
    Firstˉoperation: u32,
    Operationˉcount: u32,
    Terminator: Compilerˉsourceˉwirˉterminator,
    Value: u32,
    Firstˉtarget: u32,
    Secondˉtarget: u32
) -> Compilerˉsourceˉwirˉbuild {
    if Block >= Build.Nextˉblock {
        return Compilerˉsourceˉwirˉbuildˉfailure(
            Build,
            Compilerˉsourceˉwirˉstatus.Invalidˉdirectory,
            Build.Currentˉmodule,
            Build.Currentˉmodule,
            Build.Currentˉfunction,
            0u32,
            0u32,
            0u32
        );
    }
    var Entry: bytes = Bytesˉfromˉu32ˉlittle(Build.Currentˉmodule);
    Entry = Bytesˉconcat(Entry, Bytesˉfromˉu32ˉlittle(Build.Currentˉfunction));
    Entry = Bytesˉconcat(Entry, Bytesˉfromˉu32ˉlittle(Block));
    Entry = Bytesˉconcat(Entry, Bytesˉfromˉu32ˉlittle(Firstˉoperation));
    Entry = Bytesˉconcat(Entry, Bytesˉfromˉu32ˉlittle(Operationˉcount));
    Entry = Bytesˉconcat(Entry, Bytesˉfromˉu32ˉlittle(Compilerˉsourceˉwirˉterminatorˉvalue(Terminator)));
    Entry = Bytesˉconcat(Entry, Bytesˉfromˉu32ˉlittle(Value));
    Entry = Bytesˉconcat(Entry, Bytesˉfromˉu32ˉlittle(Firstˉtarget));
    Entry = Bytesˉconcat(Entry, Bytesˉfromˉu32ˉlittle(Secondˉtarget));
    let Blockˉoffset: u32 = Block * 36u32;
    let Replaced: Byteˉconstruction.Foundationˉbytesˉresult = Byteˉconstruction.Foundationˉbytesˉreplace(
        Build.Blockˉpayload, Blockˉoffset, 36u32, Entry
    );
    if !Replaced.Valid {
        return Compilerˉsourceˉwirˉbuildˉfailure(
            Build,
            Compilerˉsourceˉwirˉstatus.Invalidˉdirectory,
            Build.Currentˉmodule,
            Build.Currentˉmodule,
            Build.Currentˉfunction,
            0u32,
            0u32,
            0u32
        );
    }
    return Compilerˉsourceˉwirˉbuild(
        Build.Status,
        Build.Functionˉpayload,
        Replaced.Value,
        Build.Operationˉpayload, Build.Temporaryˉpayload, Build.Operandˉpayload,
        Build.Functionˉentries, Build.Blocks, Build.Operations,
        Build.Temporaries, Build.Operands,
        Build.Currentˉmodule, Build.Currentˉfunction,
        Build.Functionˉfirstˉblock, Build.Functionˉfirstˉoperation,
        Build.Functionˉfirstˉtemporary, Build.Functionˉfirstˉoperand,
        Build.Nextˉblock, Build.Currentˉblock,
        Build.Currentˉblockˉfirstˉoperation, Build.Hasˉcurrentˉblock,
        Build.Bindingˉpayload, Build.Bindingˉentries,
        Build.Bindingˉparameters, Build.Bindingˉlocals, Build.Bindingˉnextˉslot,
        Build.Failureˉmodule, Build.Failureˉrelatedˉmodule,
        Build.Failureˉfunction, Build.Failureˉoffset,
        Build.Failureˉline, Build.Failureˉcolumn
    );
}

export fn Compilerˉsourceˉwirˉcloseˉcurrentˉblock(
    Build: Compilerˉsourceˉwirˉbuild,
    Terminator: Compilerˉsourceˉwirˉterminator,
    Value: u32,
    Firstˉtarget: u32,
    Secondˉtarget: u32
) -> Compilerˉsourceˉwirˉbuild {
    let Closed: Compilerˉsourceˉwirˉbuild = Compilerˉsourceˉwirˉappendˉblock(
        Build,
        Build.Currentˉblock,
        Build.Currentˉblockˉfirstˉoperation,
        Build.Operations - Build.Currentˉblockˉfirstˉoperation,
        Terminator,
        Value,
        Firstˉtarget,
        Secondˉtarget
    );
    return Compilerˉsourceˉwirˉwithoutˉcurrentˉblock(Closed);
}

export fn Compilerˉsourceˉwirˉappendˉfunctionˉentry(
    Build: Compilerˉsourceˉwirˉbuild,
    Isˉfunction: bool,
    Parameters: u32,
    Locals: u32,
    Returnˉshape: u32
) -> Compilerˉsourceˉwirˉbuild {
    if Bytesˉlength(Build.Functionˉpayload) > 4194256u32 {
        return Compilerˉsourceˉwirˉbuildˉfailure(
            Build,
            Compilerˉsourceˉwirˉstatus.Evidenceˉlimit,
            Build.Currentˉmodule,
            Build.Currentˉmodule,
            Build.Currentˉfunction,
            0u32,
            0u32,
            0u32
        );
    }
    var Entry: bytes = Compilerˉsourceˉwirˉempty(Build.Functionˉpayload);
    if Isˉfunction {
        Entry = Bytesˉfromˉu32ˉlittle(Build.Currentˉmodule);
        Entry = Bytesˉconcat(Entry, Bytesˉfromˉu32ˉlittle(Build.Functionˉfirstˉblock));
        Entry = Bytesˉconcat(Entry, Bytesˉfromˉu32ˉlittle(Build.Blocks - Build.Functionˉfirstˉblock));
        Entry = Bytesˉconcat(Entry, Bytesˉfromˉu32ˉlittle(Build.Functionˉfirstˉoperation));
        Entry = Bytesˉconcat(Entry, Bytesˉfromˉu32ˉlittle(Build.Operations - Build.Functionˉfirstˉoperation));
        Entry = Bytesˉconcat(Entry, Bytesˉfromˉu32ˉlittle(Build.Functionˉfirstˉtemporary));
        Entry = Bytesˉconcat(Entry, Bytesˉfromˉu32ˉlittle(Build.Temporaries - Build.Functionˉfirstˉtemporary));
        Entry = Bytesˉconcat(Entry, Bytesˉfromˉu32ˉlittle(Build.Functionˉfirstˉoperand));
        Entry = Bytesˉconcat(Entry, Bytesˉfromˉu32ˉlittle(Build.Operands - Build.Functionˉfirstˉoperand));
        Entry = Bytesˉconcat(Entry, Bytesˉfromˉu32ˉlittle(Parameters));
        Entry = Bytesˉconcat(Entry, Bytesˉfromˉu32ˉlittle(Locals));
        Entry = Bytesˉconcat(Entry, Bytesˉfromˉu32ˉlittle(Returnˉshape));
    } else {
        var Index: u32 = 0u32;
        while Index < 12u32 {
            Entry = Bytesˉconcat(Entry, Bytesˉfromˉu32ˉlittle(0u32));
            Index = Index + 1u32;
        }
    }
    return Compilerˉsourceˉwirˉbuild(
        Build.Status,
        Bytesˉconcat(Build.Functionˉpayload, Entry),
        Build.Blockˉpayload, Build.Operationˉpayload,
        Build.Temporaryˉpayload, Build.Operandˉpayload,
        Build.Functionˉentries + 1u32, Build.Blocks, Build.Operations,
        Build.Temporaries, Build.Operands,
        Build.Currentˉmodule, Build.Currentˉfunction,
        Build.Functionˉfirstˉblock, Build.Functionˉfirstˉoperation,
        Build.Functionˉfirstˉtemporary, Build.Functionˉfirstˉoperand,
        Build.Nextˉblock, Build.Currentˉblock,
        Build.Currentˉblockˉfirstˉoperation, Build.Hasˉcurrentˉblock,
        Build.Bindingˉpayload, Build.Bindingˉentries,
        Build.Bindingˉparameters, Build.Bindingˉlocals, Build.Bindingˉnextˉslot,
        Build.Failureˉmodule, Build.Failureˉrelatedˉmodule,
        Build.Failureˉfunction, Build.Failureˉoffset,
        Build.Failureˉline, Build.Failureˉcolumn
    );
}

export fn Compilerˉsourceˉwirˉmergeˉfunction(
    Outer: Compilerˉsourceˉwirˉbuild,
    Function: Compilerˉsourceˉwirˉbuild
) -> Compilerˉsourceˉwirˉbuild {
    let Functionˉbytes: u32 = Bytesˉlength(Function.Functionˉpayload);
    if Bytesˉlength(Outer.Functionˉpayload) > 4194304u32 - Functionˉbytes {
        return Compilerˉsourceˉwirˉbuildˉfailure(
            Function, Compilerˉsourceˉwirˉstatus.Evidenceˉlimit,
            Function.Currentˉmodule, Function.Currentˉmodule,
            Function.Currentˉfunction, 0u32, 0u32, 0u32
        );
    }
    let Blockˉbytes: u32 = Bytesˉlength(Function.Blockˉpayload);
    if Bytesˉlength(Outer.Blockˉpayload) > 4194304u32 - Blockˉbytes {
        return Compilerˉsourceˉwirˉbuildˉfailure(
            Function, Compilerˉsourceˉwirˉstatus.Evidenceˉlimit,
            Function.Currentˉmodule, Function.Currentˉmodule,
            Function.Currentˉfunction, 0u32, 0u32, 0u32
        );
    }
    let Operationˉbytes: u32 = Bytesˉlength(Function.Operationˉpayload);
    if Bytesˉlength(Outer.Operationˉpayload) > 4194304u32 - Operationˉbytes {
        return Compilerˉsourceˉwirˉbuildˉfailure(
            Function, Compilerˉsourceˉwirˉstatus.Evidenceˉlimit,
            Function.Currentˉmodule, Function.Currentˉmodule,
            Function.Currentˉfunction, 0u32, 0u32, 0u32
        );
    }
    let Temporaryˉbytes: u32 = Bytesˉlength(Function.Temporaryˉpayload);
    if Bytesˉlength(Outer.Temporaryˉpayload) > 4194304u32 - Temporaryˉbytes {
        return Compilerˉsourceˉwirˉbuildˉfailure(
            Function, Compilerˉsourceˉwirˉstatus.Evidenceˉlimit,
            Function.Currentˉmodule, Function.Currentˉmodule,
            Function.Currentˉfunction, 0u32, 0u32, 0u32
        );
    }
    let Operandˉbytes: u32 = Bytesˉlength(Function.Operandˉpayload);
    if Bytesˉlength(Outer.Operandˉpayload) > 4194304u32 - Operandˉbytes {
        return Compilerˉsourceˉwirˉbuildˉfailure(
            Function, Compilerˉsourceˉwirˉstatus.Evidenceˉlimit,
            Function.Currentˉmodule, Function.Currentˉmodule,
            Function.Currentˉfunction, 0u32, 0u32, 0u32
        );
    }
    return Compilerˉsourceˉwirˉbuild(
        Function.Status,
        Bytesˉconcat(Outer.Functionˉpayload, Function.Functionˉpayload),
        Bytesˉconcat(Outer.Blockˉpayload, Function.Blockˉpayload),
        Bytesˉconcat(Outer.Operationˉpayload, Function.Operationˉpayload),
        Bytesˉconcat(Outer.Temporaryˉpayload, Function.Temporaryˉpayload),
        Bytesˉconcat(Outer.Operandˉpayload, Function.Operandˉpayload),
        Function.Functionˉentries, Function.Blocks, Function.Operations,
        Function.Temporaries, Function.Operands,
        Function.Currentˉmodule, Function.Currentˉfunction,
        Function.Functionˉfirstˉblock, Function.Functionˉfirstˉoperation,
        Function.Functionˉfirstˉtemporary, Function.Functionˉfirstˉoperand,
        Function.Nextˉblock, Function.Currentˉblock,
        Function.Currentˉblockˉfirstˉoperation, Function.Hasˉcurrentˉblock,
        Function.Bindingˉpayload, Function.Bindingˉentries,
        Function.Bindingˉparameters, Function.Bindingˉlocals, Function.Bindingˉnextˉslot,
        Function.Failureˉmodule, Function.Failureˉrelatedˉmodule,
        Function.Failureˉfunction, Function.Failureˉoffset,
        Function.Failureˉline, Function.Failureˉcolumn
    );
}

export fn Compilerˉsourceˉwirˉemit(
    Build: Compilerˉsourceˉwirˉbuild,
    Operation: Compilerˉsourceˉwirˉoperation,
    Shape: u32,
    Operandˉbytes: bytes,
    Target: u32,
    Auxiliary: u32,
    Offset: u32,
    Length: u32
) -> Compilerˉsourceˉwirˉvalue {
    if Bytesˉlength(Build.Operationˉpayload) > 4194256u32 {
        return Compilerˉsourceˉwirˉfailureˉvalue(
            Build, Compilerˉsourceˉwirˉstatus.Evidenceˉlimit,
            Build.Currentˉmodule, Offset, 0u32, 0u32
        );
    }
    if Shape != 0u32 {
        if Bytesˉlength(Build.Temporaryˉpayload) > 4194300u32 {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Build, Compilerˉsourceˉwirˉstatus.Evidenceˉlimit,
                Build.Currentˉmodule, Offset, 0u32, 0u32
            );
        }
    }
    if Bytesˉlength(Operandˉbytes) > 4194304u32 {
        return Compilerˉsourceˉwirˉfailureˉvalue(
            Build, Compilerˉsourceˉwirˉstatus.Evidenceˉlimit,
            Build.Currentˉmodule, Offset, 0u32, 0u32
        );
    }
    if Bytesˉlength(Build.Operandˉpayload) > 4194304u32 - Bytesˉlength(Operandˉbytes) {
        return Compilerˉsourceˉwirˉfailureˉvalue(
            Build, Compilerˉsourceˉwirˉstatus.Evidenceˉlimit,
            Build.Currentˉmodule, Offset, 0u32, 0u32
        );
    }
    var Operandˉremaining: u32 = Bytesˉlength(Operandˉbytes);
    var Operandˉcount: u32 = 0u32;
    while Operandˉremaining > 0u32 {
        Operandˉremaining = Operandˉremaining - 4u32;
        Operandˉcount = Operandˉcount + 1u32;
    }
    let Firstˉoperand: u32 = Build.Operands;
    var Temporary: u32 = Compilerˉsourceˉwirˉsentinel();
    var Temporaryˉpayload: bytes = Build.Temporaryˉpayload;
    var Temporaries: u32 = Build.Temporaries;
    if Shape != 0u32 {
        Temporary = Build.Temporaries - Build.Functionˉfirstˉtemporary;
        Temporaryˉpayload = Bytesˉconcat(Temporaryˉpayload, Bytesˉfromˉu32ˉlittle(Shape));
        Temporaries = Temporaries + 1u32;
    }
    var Entry: bytes = Bytesˉfromˉu32ˉlittle(Build.Currentˉmodule);
    Entry = Bytesˉconcat(Entry, Bytesˉfromˉu32ˉlittle(Build.Currentˉfunction));
    Entry = Bytesˉconcat(Entry, Bytesˉfromˉu32ˉlittle(Build.Currentˉblock));
    Entry = Bytesˉconcat(Entry, Bytesˉfromˉu32ˉlittle(Compilerˉsourceˉwirˉoperationˉvalue(Operation)));
    Entry = Bytesˉconcat(Entry, Bytesˉfromˉu32ˉlittle(Shape));
    Entry = Bytesˉconcat(Entry, Bytesˉfromˉu32ˉlittle(Temporary));
    Entry = Bytesˉconcat(Entry, Bytesˉfromˉu32ˉlittle(Firstˉoperand));
    Entry = Bytesˉconcat(Entry, Bytesˉfromˉu32ˉlittle(Operandˉcount));
    Entry = Bytesˉconcat(Entry, Bytesˉfromˉu32ˉlittle(Target));
    Entry = Bytesˉconcat(Entry, Bytesˉfromˉu32ˉlittle(Auxiliary));
    Entry = Bytesˉconcat(Entry, Bytesˉfromˉu32ˉlittle(Offset));
    Entry = Bytesˉconcat(Entry, Bytesˉfromˉu32ˉlittle(Length));
    let Result: Compilerˉsourceˉwirˉbuild = Compilerˉsourceˉwirˉbuild(
        Build.Status,
        Build.Functionˉpayload, Build.Blockˉpayload,
        Bytesˉconcat(Build.Operationˉpayload, Entry),
        Temporaryˉpayload,
        Bytesˉconcat(Build.Operandˉpayload, Operandˉbytes),
        Build.Functionˉentries, Build.Blocks, Build.Operations + 1u32,
        Temporaries, Build.Operands + Operandˉcount,
        Build.Currentˉmodule, Build.Currentˉfunction,
        Build.Functionˉfirstˉblock, Build.Functionˉfirstˉoperation,
        Build.Functionˉfirstˉtemporary, Build.Functionˉfirstˉoperand,
        Build.Nextˉblock, Build.Currentˉblock,
        Build.Currentˉblockˉfirstˉoperation, Build.Hasˉcurrentˉblock,
        Build.Bindingˉpayload, Build.Bindingˉentries,
        Build.Bindingˉparameters, Build.Bindingˉlocals, Build.Bindingˉnextˉslot,
        Build.Failureˉmodule, Build.Failureˉrelatedˉmodule,
        Build.Failureˉfunction, Build.Failureˉoffset,
        Build.Failureˉline, Build.Failureˉcolumn
    );
    return Compilerˉsourceˉwirˉvalueˉfrom(Result, Shape, Temporary);
}

export fn Compilerˉsourceˉwirˉoneˉoperand(Temporary: u32) -> bytes {
    return Bytesˉfromˉu32ˉlittle(Temporary);
}

export fn Compilerˉsourceˉwirˉtwoˉoperands(First: u32, Second: u32) -> bytes {
    return Bytesˉconcat(
        Bytesˉfromˉu32ˉlittle(First),
        Bytesˉfromˉu32ˉlittle(Second)
    );
}

export fn Compilerˉsourceˉwirˉintrinsicˉoperation(
    Source: bytes,
    Offset: u32,
    Length: u32
) -> Compilerˉsourceˉwirˉoperation {
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "Bytesˉlength") { return Compilerˉsourceˉwirˉoperation.Bytesˉlength; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "Bytesˉslice") { return Compilerˉsourceˉwirˉoperation.Bytesˉslice; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "Bytesˉreadˉu8") { return Compilerˉsourceˉwirˉoperation.Bytesˉreadˉu8; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "Bytesˉreadˉu16ˉlittle") { return Compilerˉsourceˉwirˉoperation.Bytesˉreadˉu16ˉlittle; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "Bytesˉreadˉu32ˉlittle") { return Compilerˉsourceˉwirˉoperation.Bytesˉreadˉu32ˉlittle; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "Bytesˉreadˉi32ˉlittle") { return Compilerˉsourceˉwirˉoperation.Bytesˉreadˉi32ˉlittle; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "Bytesˉreadˉu64ˉlittle") { return Compilerˉsourceˉwirˉoperation.Bytesˉreadˉu64ˉlittle; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "Bytesˉconcat") { return Compilerˉsourceˉwirˉoperation.Bytesˉconcat; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "Bytesˉfromˉu8") { return Compilerˉsourceˉwirˉoperation.Bytesˉfromˉu8; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "Bytesˉfromˉu16ˉlittle") { return Compilerˉsourceˉwirˉoperation.Bytesˉfromˉu16ˉlittle; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "Bytesˉfromˉu32ˉlittle") { return Compilerˉsourceˉwirˉoperation.Bytesˉfromˉu32ˉlittle; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "Bytesˉfromˉi32ˉlittle") { return Compilerˉsourceˉwirˉoperation.Bytesˉfromˉi32ˉlittle; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "Bytesˉfromˉu64ˉlittle") { return Compilerˉsourceˉwirˉoperation.Bytesˉfromˉu64ˉlittle; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "Bytesˉsha256ˉhex") { return Compilerˉsourceˉwirˉoperation.Bytesˉsha256ˉhex; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "U32ˉfromˉu8") { return Compilerˉsourceˉwirˉoperation.U32ˉfromˉu8; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "U64ˉfromˉu32") { return Compilerˉsourceˉwirˉoperation.U64ˉfromˉu32; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "I32ˉformat") { return Compilerˉsourceˉwirˉoperation.I32ˉformat; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "U8ˉformat") { return Compilerˉsourceˉwirˉoperation.U8ˉformat; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "U32ˉformat") { return Compilerˉsourceˉwirˉoperation.U32ˉformat; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "I64ˉformat") { return Compilerˉsourceˉwirˉoperation.I64ˉformat; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "U64ˉformat") { return Compilerˉsourceˉwirˉoperation.U64ˉformat; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "Textˉconcat") { return Compilerˉsourceˉwirˉoperation.Textˉconcat; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "Textˉutf8ˉisˉvalid") { return Compilerˉsourceˉwirˉoperation.Textˉutf8ˉisˉvalid; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "Textˉfromˉutf8") { return Compilerˉsourceˉwirˉoperation.Textˉfromˉutf8; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "Textˉquote") { return Compilerˉsourceˉwirˉoperation.Textˉquote; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "Textˉtoˉutf8") { return Compilerˉsourceˉwirˉoperation.Textˉtoˉutf8; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "Enumˉname") { return Compilerˉsourceˉwirˉoperation.Enumˉname; }
    return Compilerˉsourceˉwirˉoperation.None;
}

export fn Compilerˉsourceˉwirˉintrinsicˉparameterˉshape(
    Source: bytes,
    Offset: u32,
    Length: u32,
    Index: u32
) -> u32 {
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "Bytesˉslice") {
        if Index == 0u32 { return 6u32; }
        return 3u32;
    }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "Bytesˉreadˉu8") {
        if Index == 0u32 { return 6u32; }
        return 3u32;
    }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "Bytesˉreadˉu16ˉlittle") {
        if Index == 0u32 { return 6u32; }
        return 3u32;
    }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "Bytesˉreadˉu32ˉlittle") {
        if Index == 0u32 { return 6u32; }
        return 3u32;
    }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "Bytesˉreadˉi32ˉlittle") {
        if Index == 0u32 { return 6u32; }
        return 3u32;
    }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "Bytesˉreadˉu64ˉlittle") {
        if Index == 0u32 { return 6u32; }
        return 3u32;
    }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "Bytesˉconcat") { return 6u32; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "Textˉconcat") { return 5u32; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "Bytesˉfromˉu8") { return 2u32; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "Bytesˉfromˉu16ˉlittle") { return 3u32; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "Bytesˉfromˉu32ˉlittle") { return 3u32; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "Bytesˉfromˉi32ˉlittle") { return 1u32; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "Bytesˉfromˉu64ˉlittle") { return 8u32; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "U32ˉfromˉu8") { return 2u32; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "U64ˉfromˉu32") { return 3u32; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "I32ˉformat") { return 1u32; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "U8ˉformat") { return 2u32; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "U32ˉformat") { return 3u32; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "I64ˉformat") { return 7u32; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "U64ˉformat") { return 8u32; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "Textˉquote") { return 5u32; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "Textˉtoˉutf8") { return 5u32; }
    return 6u32;
}

export fn Compilerˉsourceˉwirˉintrinsicˉreturnˉshape(
    Source: bytes,
    Offset: u32,
    Length: u32
) -> u32 {
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "Bytesˉlength") { return 3u32; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "Bytesˉreadˉu8") { return 2u32; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "Bytesˉreadˉu16ˉlittle") { return 3u32; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "Bytesˉreadˉu32ˉlittle") { return 3u32; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "Bytesˉreadˉi32ˉlittle") { return 1u32; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "Bytesˉreadˉu64ˉlittle") { return 8u32; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "U32ˉfromˉu8") { return 3u32; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "U64ˉfromˉu32") { return 8u32; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "Textˉutf8ˉisˉvalid") { return 4u32; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "I32ˉformat") { return 5u32; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "U8ˉformat") { return 5u32; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "U32ˉformat") { return 5u32; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "I64ˉformat") { return 5u32; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "U64ˉformat") { return 5u32; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "Textˉconcat") { return 5u32; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "Bytesˉsha256ˉhex") { return 5u32; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "Textˉfromˉutf8") { return 5u32; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "Textˉquote") { return 5u32; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "Enumˉname") { return 5u32; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "Textˉtoˉutf8") { return 6u32; }
    return 6u32;
}

export fn Compilerˉsourceˉwirˉcapabilityˉparameterˉshape(
    Source: bytes,
    Offset: u32,
    Length: u32,
    Index: u32
) -> u32 {
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "file.write_bytes") {
        if Index == 0u32 { return 5u32; }
        return 6u32;
    }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "filesystem.directory_read_v1") {
        if Index == 0u32 { return 5u32; }
        return 3u32;
    }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "model.catalog_v1") ||
        Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "model.inference_v1") {
        return 6u32;
    }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "standard_output.write_v1") {
        return 6u32;
    }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "process.argument") {
        return 3u32;
    }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "storage.random_access_v1") {
        if Index == 1u32 { return 8u32; }
        if Index == 2u32 { return 8u32; }
        if Index == 4u32 { return 6u32; }
        return 3u32;
    }
    return 5u32;
}

export fn Compilerˉsourceˉwirˉcapabilityˉreturnˉshape(
    Source: bytes,
    Offset: u32,
    Length: u32
) -> u32 {
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "file.read_bytes") { return 6u32; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "filesystem.directory_read_v1") { return 6u32; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "model.catalog_v1") { return 6u32; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "model.inference_v1") { return 6u32; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "process.argument") { return 5u32; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "process.argument_count") { return 3u32; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "standard_output.write_v1") { return 6u32; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(Source, Offset, Length, "storage.random_access_v1") { return 6u32; }
    return 0u32;
}

export fn Compilerˉsourceˉwirˉdataˉkind(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Match: Sourceˉbindings.Compilerˉsourceˉbindingˉmatch
) -> Compilerˉsourceˉwirˉdataˉkind {
    if !Match.Found { return Compilerˉsourceˉwirˉdataˉkind.None; }
    let Entry: u32 = 16u32 + Match.Directoryˉentry * 24u32;
    let Declarationˉoffset: u32 = Bytesˉreadˉu32ˉlittle(Symbols.Directory, Entry + 8u32);
    let View: Sourceˉset.Compilerˉsourceˉsetˉview = Sourceˉset.Compilerˉsourceˉsetˉmodule(Input, Scan, Match.Module);
    let Declarationˉposition: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
        View.Source, 0u32, 1u32, 1u32, Declarationˉoffset
    );
    let Declaration: Sourceˉdeclarations.Compilerˉsourceˉdeclaration = Sourceˉdeclarations.Compilerˉparseˉnextˉdeclarationˉvalidated(
        View.Source, Declarationˉoffset,
        Declarationˉposition.Line, Declarationˉposition.Column, true
    );
    let Nameˉposition: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
        View.Source, Declarationˉoffset,
        Declarationˉposition.Line, Declarationˉposition.Column,
        Declaration.Nameˉoffset
    );
    let Name: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
        View.Source, Declaration.Nameˉoffset, Nameˉposition.Line, Nameˉposition.Column
    );
    let Colon: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(View.Source, Name.Nextˉoffset, Name.Nextˉline, Name.Nextˉcolumn);
    let Type: Sourceˉdeclarations.Compilerˉparseˉstep = Sourceˉdeclarations.Compilerˉparseˉtype(
        View.Source, Colon.Nextˉoffset, Colon.Nextˉline, Colon.Nextˉcolumn, false, true
    );
    if Type.Typeˉkind == Sourceˉdeclarations.Compilerˉsourceˉtypeˉkind.I32ˉarray {
        return Compilerˉsourceˉwirˉdataˉkind.I32ˉarray;
    }
    if Type.Typeˉkind == Sourceˉdeclarations.Compilerˉsourceˉtypeˉkind.Text {
        return Compilerˉsourceˉwirˉdataˉkind.Text;
    }
    if Type.Typeˉkind == Sourceˉdeclarations.Compilerˉsourceˉtypeˉkind.Bytes {
        return Compilerˉsourceˉwirˉdataˉkind.Bytes;
    }
    return Compilerˉsourceˉwirˉdataˉkind.None;
}

export fn Compilerˉsourceˉwirˉfunctionˉsignature(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Module: u32,
    Source: bytes,
    Declarationˉoffset: u32,
    Argument: u32
) -> Compilerˉsourceˉwirˉsignature {
    let First: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
        Source, Declarationˉoffset, 1u32, 1u32
    );
    var Functionˉtoken: Sourceˉlexer.Compilerˉsourceˉtoken = First;
    if First.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Export {
        Functionˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Source, First.Nextˉoffset, First.Nextˉline, First.Nextˉcolumn
        );
    }
    let Name: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
        Source, Functionˉtoken.Nextˉoffset, Functionˉtoken.Nextˉline, Functionˉtoken.Nextˉcolumn
    );
    let Left: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
        Source, Name.Nextˉoffset, Name.Nextˉline, Name.Nextˉcolumn
    );
    var Cursor: u32 = Left.Nextˉoffset;
    var Currentˉline: u32 = Left.Nextˉline;
    var Currentˉcolumn: u32 = Left.Nextˉcolumn;
    var Parameterˉshape: u32 = 0u32;
    var Index: u32 = 0u32;
    var Reading: bool = true;
    while Reading {
        let Current: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            Source, Cursor, Currentˉline, Currentˉcolumn
        );
        if Current.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Rightˉparenthesis {
            Reading = false;
            Cursor = Current.Nextˉoffset;
            Currentˉline = Current.Nextˉline;
            Currentˉcolumn = Current.Nextˉcolumn;
        } else {
            let Colon: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                Source, Current.Nextˉoffset, Current.Nextˉline, Current.Nextˉcolumn
            );
            let Type: Sourceˉsymbols.Compilerˉsourceˉtypeˉbinding = Sourceˉsymbols.Compilerˉsourceˉsymbolsˉbindˉtype(
                Input, Scan, Symbols.Directory, Symbols.Lookup, Symbols.Visibility,
                Module, Source,
                Colon.Nextˉoffset, Colon.Nextˉline, Colon.Nextˉcolumn,
                Symbols.Records, Symbols.Enums, false
            );
            if Index == Argument {
                Parameterˉshape = Sourceˉbindings.Compilerˉsourceˉbindingsˉshape(Type);
            }
            let Separator: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                Source, Type.Nextˉoffset, Type.Nextˉline, Type.Nextˉcolumn
            );
            if Separator.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Comma {
                Cursor = Separator.Nextˉoffset;
                Currentˉline = Separator.Nextˉline;
                Currentˉcolumn = Separator.Nextˉcolumn;
            } else {
                Cursor = Separator.Nextˉoffset;
                Currentˉline = Separator.Nextˉline;
                Currentˉcolumn = Separator.Nextˉcolumn;
                Reading = false;
            }
            Index = Index + 1u32;
        }
    }
    let Arrow: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
        Source, Cursor, Currentˉline, Currentˉcolumn
    );
    let Returnˉtype: Sourceˉsymbols.Compilerˉsourceˉtypeˉbinding = Sourceˉsymbols.Compilerˉsourceˉsymbolsˉbindˉtype(
        Input, Scan, Symbols.Directory, Symbols.Lookup, Symbols.Visibility,
        Module, Source,
        Arrow.Nextˉoffset, Arrow.Nextˉline, Arrow.Nextˉcolumn,
        Symbols.Records, Symbols.Enums, false
    );
    return Compilerˉsourceˉwirˉsignature(
        Parameterˉshape,
        Sourceˉbindings.Compilerˉsourceˉbindingsˉshape(Returnˉtype),
        0u32,
        0u32
    );
}

export fn Compilerˉsourceˉwirˉrecordˉsignature(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Callable: Sourceˉbindings.Compilerˉsourceˉbindingˉmatch,
    Argument: u32
) -> Compilerˉsourceˉwirˉsignature {
    let Entry: u32 = 16u32 + Callable.Directoryˉentry * 24u32;
    let Declarationˉoffset: u32 = Bytesˉreadˉu32ˉlittle(Symbols.Directory, Entry + 8u32);
    let Nameˉoffset: u32 = Bytesˉreadˉu32ˉlittle(Symbols.Directory, Entry + 12u32);
    let Nameˉlength: u32 = Bytesˉreadˉu32ˉlittle(Symbols.Directory, Entry + 16u32);
    let View: Sourceˉset.Compilerˉsourceˉsetˉview = Sourceˉset.Compilerˉsourceˉsetˉmodule(Input, Scan, Callable.Module);
    let Directoryˉentries: u32 = Bytesˉreadˉu32ˉlittle(Symbols.Directory, 8u32);
    let Nominals: u32 = Symbols.Records + Symbols.Enums + Symbols.Variants;
    let Nominalˉindex: u32 = Bytesˉreadˉu32ˉlittle(
        Symbols.Lookup,
        4112u32 + Directoryˉentries * 4u32 + Nominals * 4u32 + Callable.Directoryˉentry * 4u32
    );
    let Declarationˉposition: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
        View.Source, 0u32, 1u32, 1u32, Declarationˉoffset
    );
    let Declaration: Sourceˉdeclarations.Compilerˉsourceˉdeclaration = Sourceˉdeclarations.Compilerˉparseˉnextˉdeclarationˉvalidated(
        View.Source, Declarationˉoffset,
        Declarationˉposition.Line, Declarationˉposition.Column, true
    );
    let Bodyˉposition: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
        View.Source, Declarationˉoffset,
        Declarationˉposition.Line, Declarationˉposition.Column,
        Declaration.Bodyˉoffset
    );
    let Left: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
        View.Source, Declaration.Bodyˉoffset, Bodyˉposition.Line, Bodyˉposition.Column
    );
    var Cursor: u32 = Left.Nextˉoffset;
    var Currentˉline: u32 = Left.Nextˉline;
    var Currentˉcolumn: u32 = Left.Nextˉcolumn;
    var Parameterˉshape: u32 = 0u32;
    var Index: u32 = 0u32;
    while Index <= Argument {
        let Field: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            View.Source, Cursor, Currentˉline, Currentˉcolumn
        );
        let Colon: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            View.Source, Field.Nextˉoffset, Field.Nextˉline, Field.Nextˉcolumn
        );
        let Type: Sourceˉsymbols.Compilerˉsourceˉtypeˉbinding = Sourceˉsymbols.Compilerˉsourceˉsymbolsˉbindˉtype(
            Input, Scan, Symbols.Directory, Symbols.Lookup, Symbols.Visibility,
            Callable.Module, View.Source,
            Colon.Nextˉoffset, Colon.Nextˉline, Colon.Nextˉcolumn,
            Symbols.Records, Symbols.Enums, true
        );
        if Index == Argument {
            Parameterˉshape = Sourceˉbindings.Compilerˉsourceˉbindingsˉshape(Type);
        }
        let End: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            View.Source, Type.Nextˉoffset, Type.Nextˉline, Type.Nextˉcolumn
        );
        Cursor = End.Nextˉoffset;
        Currentˉline = End.Nextˉline;
        Currentˉcolumn = End.Nextˉcolumn;
        Index = Index + 1u32;
    }
    return Compilerˉsourceˉwirˉsignature(
        Parameterˉshape,
        65536u32 + Nominalˉindex,
        Nominalˉindex,
        Callable.Directoryˉentry
    );
}

export fn Compilerˉsourceˉwirˉcallableˉsignature(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Callable: Sourceˉbindings.Compilerˉsourceˉbindingˉmatch,
    Nameˉsource: bytes,
    Nameˉoffset: u32,
    Nameˉlength: u32,
    Argument: u32
) -> Compilerˉsourceˉwirˉsignature {
    if Callable.Kind == Sourceˉbindings.Compilerˉsourceˉcallableˉkind.Intrinsic {
        return Compilerˉsourceˉwirˉsignature(
            Compilerˉsourceˉwirˉintrinsicˉparameterˉshape(
                Nameˉsource, Nameˉoffset, Nameˉlength, Argument
            ),
            Compilerˉsourceˉwirˉintrinsicˉreturnˉshape(
                Nameˉsource, Nameˉoffset, Nameˉlength
            ),
            Compilerˉsourceˉwirˉsentinel(),
            0u32
        );
    }
    if Callable.Kind == Sourceˉbindings.Compilerˉsourceˉcallableˉkind.Capability {
        return Compilerˉsourceˉwirˉsignature(
            Compilerˉsourceˉwirˉcapabilityˉparameterˉshape(
                Nameˉsource, Nameˉoffset, Nameˉlength, Argument
            ),
            Compilerˉsourceˉwirˉcapabilityˉreturnˉshape(
                Nameˉsource, Nameˉoffset, Nameˉlength
            ),
            Callable.Directoryˉentry,
            0u32
        );
    }
    if Callable.Kind == Sourceˉbindings.Compilerˉsourceˉcallableˉkind.Record {
        return Compilerˉsourceˉwirˉrecordˉsignature(
            Input, Scan, Symbols, Callable, Argument
        );
    }
    if Callable.Kind == Sourceˉbindings.Compilerˉsourceˉcallableˉkind.Variantˉcase {
        let Nominal: Sourceˉsymbols.Compilerˉsourceˉsymbolˉmatch = Sourceˉsymbols.Compilerˉsourceˉsymbolsˉdirectoryˉentry(
            Symbols.Directory, Scan.Modules, Callable.Directoryˉentry
        );
        var Lastˉdot: u32 = Nameˉlength;
        var Character: u32 = 0u32;
        while Character < Nameˉlength {
            if Bytesˉreadˉu8(Nameˉsource, Nameˉoffset + Character) == 46u8 { Lastˉdot = Character; }
            Character = Character + 1u32;
        }
        let Member: Compilerˉsourceˉwirˉmember = Compilerˉsourceˉwirˉnominalˉmember(
            Input, Scan, Symbols, Nominal,
            Nameˉsource, Nameˉoffset + Lastˉdot + 1u32, Nameˉlength - Lastˉdot - 1u32
        );
        let Entries: u32 = Bytesˉreadˉu32ˉlittle(Symbols.Directory, 8u32);
        let Nominals: u32 = Symbols.Records + Symbols.Enums + Symbols.Variants;
        let Nominalˉindex: u32 = Bytesˉreadˉu32ˉlittle(
            Symbols.Lookup,
            4112u32 + Entries * 4u32 + Nominals * 4u32 + Callable.Directoryˉentry * 4u32
        );
        return Compilerˉsourceˉwirˉsignature(
            Member.Shape,
            196608u32 + Nominalˉindex,
            Nominalˉindex,
            Member.Index
        );
    }
    let Entry: u32 = 16u32 + Callable.Directoryˉentry * 24u32;
    let Declarationˉoffset: u32 = Bytesˉreadˉu32ˉlittle(Symbols.Directory, Entry + 8u32);
    let View: Sourceˉset.Compilerˉsourceˉsetˉview = Sourceˉset.Compilerˉsourceˉsetˉmodule(Input, Scan, Callable.Module);
    let Function: Compilerˉsourceˉwirˉsignature = Compilerˉsourceˉwirˉfunctionˉsignature(
        Input, Scan, Symbols, Callable.Module, View.Source, Declarationˉoffset, Argument
    );
    return Compilerˉsourceˉwirˉsignature(
        Function.Parameterˉshape,
        Function.Returnˉshape,
        Callable.Directoryˉentry,
        0u32
    );
}

export fn Compilerˉsourceˉwirˉnominalˉbyˉshape(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Shape: u32
) -> Sourceˉsymbols.Compilerˉsourceˉsymbolˉmatch {
    var Wanted: u32 = Shape - 65536u32;
    if Shape >= 131072u32 { Wanted = Shape - 131072u32; }
    if Shape >= 196608u32 { Wanted = Shape - 196608u32; }
    if Wanted >= Symbols.Records + Symbols.Enums + Symbols.Variants {
        return Sourceˉsymbols.Compilerˉsourceˉsymbolsˉmatchˉnone(Scan.Modules);
    }
    let Entries: u32 = Bytesˉreadˉu32ˉlittle(Symbols.Directory, 8u32);
    let Directoryˉindex: u32 = Bytesˉreadˉu32ˉlittle(
        Symbols.Lookup, 4112u32 + Entries * 4u32 + Wanted * 4u32
    );
    return Sourceˉsymbols.Compilerˉsourceˉsymbolsˉdirectoryˉentry(
        Symbols.Directory, Scan.Modules, Directoryˉindex
    );
}

export fn Compilerˉsourceˉwirˉnominalˉmember(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Nominal: Sourceˉsymbols.Compilerˉsourceˉsymbolˉmatch,
    Queryˉsource: bytes,
    Queryˉoffset: u32,
    Queryˉlength: u32
) -> Compilerˉsourceˉwirˉmember {
    if !Nominal.Found { return Compilerˉsourceˉwirˉmember(false, 0u32, 0u32); }
    let View: Sourceˉset.Compilerˉsourceˉsetˉview = Sourceˉset.Compilerˉsourceˉsetˉmodule(Input, Scan, Nominal.Module);
    let Declarationˉposition: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
        View.Source, 0u32, 1u32, 1u32, Nominal.Declarationˉoffset
    );
    let Declaration: Sourceˉdeclarations.Compilerˉsourceˉdeclaration = Sourceˉdeclarations.Compilerˉparseˉnextˉdeclarationˉvalidated(
        View.Source, Nominal.Declarationˉoffset,
        Declarationˉposition.Line, Declarationˉposition.Column, true
    );
    let Bodyˉposition: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
        View.Source, Nominal.Declarationˉoffset,
        Declarationˉposition.Line, Declarationˉposition.Column,
        Declaration.Bodyˉoffset
    );
    let Left: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
        View.Source, Declaration.Bodyˉoffset, Bodyˉposition.Line, Bodyˉposition.Column
    );
    var Cursor: u32 = Left.Nextˉoffset;
    var Currentˉline: u32 = Left.Nextˉline;
    var Currentˉcolumn: u32 = Left.Nextˉcolumn;
    var Index: u32 = 0u32;
    var Reading: bool = true;
    while Reading {
        let Member: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
            View.Source, Cursor, Currentˉline, Currentˉcolumn
        );
        if Member.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Rightˉbrace {
            Reading = false;
        } else {
            if Member.Length == Queryˉlength {
                if Sourceˉset.Compilerˉsourceˉspansˉequal(
                    View.Source, Member.Offset, Member.Length,
                    Queryˉsource, Queryˉoffset, Queryˉlength
                ) {
                if Nominal.Kind == Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Enum {
                    let Directoryˉentries: u32 = Bytesˉreadˉu32ˉlittle(Symbols.Directory, 8u32);
                    let Nominals: u32 = Symbols.Records + Symbols.Enums + Symbols.Variants;
                    let Shape: u32 = 131072u32 + Bytesˉreadˉu32ˉlittle(
                        Symbols.Lookup,
                        4112u32 + Directoryˉentries * 4u32 + Nominals * 4u32 +
                            Nominal.Directoryˉindex * 4u32
                    );
                    return Compilerˉsourceˉwirˉmember(true, Index, Shape);
                }
                if Nominal.Kind == Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Variant {
                    let Afterˉname: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                        View.Source, Member.Nextˉoffset, Member.Nextˉline, Member.Nextˉcolumn
                    );
                    if Afterˉname.Kind != Sourceˉlexer.Compilerˉtokenˉkind.Leftˉparenthesis {
                        return Compilerˉsourceˉwirˉmember(true, Index, 0u32);
                    }
                    let Payloadˉname: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                        View.Source, Afterˉname.Nextˉoffset, Afterˉname.Nextˉline, Afterˉname.Nextˉcolumn
                    );
                    let Payloadˉcolon: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                        View.Source, Payloadˉname.Nextˉoffset, Payloadˉname.Nextˉline, Payloadˉname.Nextˉcolumn
                    );
                    let Payloadˉtype: Sourceˉsymbols.Compilerˉsourceˉtypeˉbinding = Sourceˉsymbols.Compilerˉsourceˉsymbolsˉbindˉtype(
                        Input, Scan, Symbols.Directory, Symbols.Lookup, Symbols.Visibility,
                        Nominal.Module, View.Source,
                        Payloadˉcolon.Nextˉoffset, Payloadˉcolon.Nextˉline, Payloadˉcolon.Nextˉcolumn,
                        Symbols.Records, Symbols.Enums, false
                    );
                    return Compilerˉsourceˉwirˉmember(
                        true, Index, Sourceˉbindings.Compilerˉsourceˉbindingsˉshape(Payloadˉtype)
                    );
                }
                let Matchedˉcolon: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                    View.Source, Member.Nextˉoffset, Member.Nextˉline, Member.Nextˉcolumn
                );
                let Matchedˉtype: Sourceˉsymbols.Compilerˉsourceˉtypeˉbinding = Sourceˉsymbols.Compilerˉsourceˉsymbolsˉbindˉtype(
                    Input, Scan, Symbols.Directory, Symbols.Lookup, Symbols.Visibility,
                    Nominal.Module, View.Source,
                    Matchedˉcolon.Nextˉoffset, Matchedˉcolon.Nextˉline, Matchedˉcolon.Nextˉcolumn,
                    Symbols.Records, Symbols.Enums, true
                );
                return Compilerˉsourceˉwirˉmember(
                    true, Index, Sourceˉbindings.Compilerˉsourceˉbindingsˉshape(Matchedˉtype)
                );
                }
            }
            if Nominal.Kind == Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Record {
                let Recordˉcolon: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                    View.Source, Member.Nextˉoffset, Member.Nextˉline, Member.Nextˉcolumn
                );
                let Recordˉtype: Sourceˉdeclarations.Compilerˉparseˉstep = Sourceˉdeclarations.Compilerˉparseˉtype(
                    View.Source, Recordˉcolon.Nextˉoffset, Recordˉcolon.Nextˉline, Recordˉcolon.Nextˉcolumn, false, false
                );
                let Recordˉend: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                    View.Source, Recordˉtype.Nextˉoffset, Recordˉtype.Nextˉline, Recordˉtype.Nextˉcolumn
                );
                Cursor = Recordˉend.Nextˉoffset;
                Currentˉline = Recordˉend.Nextˉline;
                Currentˉcolumn = Recordˉend.Nextˉcolumn;
            } else if Nominal.Kind == Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Enum {
                let Enumˉequals: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                    View.Source, Member.Nextˉoffset, Member.Nextˉline, Member.Nextˉcolumn
                );
                let Enumˉvalue: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                    View.Source, Enumˉequals.Nextˉoffset, Enumˉequals.Nextˉline, Enumˉequals.Nextˉcolumn
                );
                let Enumˉend: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                    View.Source, Enumˉvalue.Nextˉoffset, Enumˉvalue.Nextˉline, Enumˉvalue.Nextˉcolumn
                );
                Cursor = Enumˉend.Nextˉoffset;
                Currentˉline = Enumˉend.Nextˉline;
                Currentˉcolumn = Enumˉend.Nextˉcolumn;
            } else {
                let Variantˉafterˉname: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                    View.Source, Member.Nextˉoffset, Member.Nextˉline, Member.Nextˉcolumn
                );
                var Variantˉend: Sourceˉlexer.Compilerˉsourceˉtoken = Variantˉafterˉname;
                if Variantˉafterˉname.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Leftˉparenthesis {
                    let Variantˉpayloadˉname: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                        View.Source, Variantˉafterˉname.Nextˉoffset, Variantˉafterˉname.Nextˉline, Variantˉafterˉname.Nextˉcolumn
                    );
                    let Variantˉcolon: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                        View.Source, Variantˉpayloadˉname.Nextˉoffset, Variantˉpayloadˉname.Nextˉline, Variantˉpayloadˉname.Nextˉcolumn
                    );
                    let Variantˉtype: Sourceˉdeclarations.Compilerˉparseˉstep = Sourceˉdeclarations.Compilerˉparseˉtype(
                        View.Source, Variantˉcolon.Nextˉoffset, Variantˉcolon.Nextˉline, Variantˉcolon.Nextˉcolumn, false, false
                    );
                    let Variantˉright: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                        View.Source, Variantˉtype.Nextˉoffset, Variantˉtype.Nextˉline, Variantˉtype.Nextˉcolumn
                    );
                    Variantˉend = Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                        View.Source, Variantˉright.Nextˉoffset, Variantˉright.Nextˉline, Variantˉright.Nextˉcolumn
                    );
                }
                Cursor = Variantˉend.Nextˉoffset;
                Currentˉline = Variantˉend.Nextˉline;
                Currentˉcolumn = Variantˉend.Nextˉcolumn;
            }
            Index = Index + 1u32;
        }
    }
    return Compilerˉsourceˉwirˉmember(false, 0u32, 0u32);
}

export fn Compilerˉsourceˉwirˉfailureˉvalue(
    Build: Compilerˉsourceˉwirˉbuild,
    Status: Compilerˉsourceˉwirˉstatus,
    Relatedˉmodule: u32,
    Offset: u32,
    Line: u32,
    Column: u32
) -> Compilerˉsourceˉwirˉvalue {
    let Failed: Compilerˉsourceˉwirˉbuild = Compilerˉsourceˉwirˉbuildˉfailure(
        Build,
        Status,
        Build.Currentˉmodule,
        Relatedˉmodule,
        Build.Currentˉfunction,
        Offset,
        Line,
        Column
    );
    return Compilerˉsourceˉwirˉvalueˉfrom(
        Failed, 0u32, Compilerˉsourceˉwirˉsentinel()
    );
}

export fn Compilerˉsourceˉwirˉcompileˉname(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Bindingˉpayload: bytes,
    Bindingˉfirst: u32,
    Bindingˉentries: u32,
    Source: bytes,
    Expression: Sourceˉbodies.Compilerˉsourceˉexpression,
    Build: Compilerˉsourceˉwirˉbuild
) -> Compilerˉsourceˉwirˉvalue {
    let Local: Sourceˉbindings.Compilerˉsourceˉlocalˉmatch = Sourceˉbindings.Compilerˉsourceˉbindingsˉfindˉlocal(
        Source, Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
        Expression.Valueˉoffset, Expression.Valueˉlength, Expression.Offset
    );
    if Local.Found {
        return Compilerˉsourceˉwirˉemit(
            Build,
            Compilerˉsourceˉwirˉoperation.Loadˉlocal,
            Local.Shape,
            Compilerˉsourceˉwirˉempty(Source),
            Local.Slot,
            0u32,
            Expression.Offset,
            Expression.Length
        );
    }
    let Constant: Sourceˉbindings.Compilerˉsourceˉbindingˉmatch = Sourceˉbindings.Compilerˉsourceˉbindingsˉfindˉdeclaration(
        Input, Scan, Symbols, Build.Currentˉmodule, Source,
        Expression.Valueˉoffset, Expression.Valueˉlength,
        Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Constant
    );
    if Constant.Found {
        if !Constant.Accessible {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Build, Compilerˉsourceˉwirˉstatus.Invalidˉconstant,
                Constant.Module, Expression.Offset, Expression.Line, Expression.Column
            );
        }
        let View: Sourceˉset.Compilerˉsourceˉsetˉview = Sourceˉset.Compilerˉsourceˉsetˉmodule(
            Input, Scan, Constant.Module
        );
        let Entry: u32 = 16u32 + Constant.Directoryˉentry * 24u32;
        let Declarationˉoffset: u32 = Bytesˉreadˉu32ˉlittle(
            Symbols.Directory, Entry + 8u32
        );
        let Position: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
            View.Source, 0u32, 1u32, 1u32, Declarationˉoffset
        );
        let Declaration: Sourceˉdeclarations.Compilerˉsourceˉdeclaration = Sourceˉdeclarations.Compilerˉparseˉnextˉdeclarationˉvalidated(
            View.Source,
            Declarationˉoffset,
            Position.Line,
            Position.Column,
            true
        );
        let Value: Sourceˉsymbols.Compilerˉsourceˉconstantˉvalue =
            Sourceˉsymbols.Compilerˉsourceˉsymbolsˉconstantˉevaluateˉdeclaration(
                Input, Scan, Symbols, Constant.Module, View.Source,
                Declaration, Position.Line, Position.Column, 0u32
            );
        if Value.Status != Sourceˉsymbols.Compilerˉsourceˉsymbolˉstatus.Valid {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Build, Compilerˉsourceˉwirˉstatus.Invalidˉconstant,
                Value.Failureˉmodule,
                Value.Failureˉoffset, Value.Failureˉline, Value.Failureˉcolumn
            );
        }
        var Operation: Compilerˉsourceˉwirˉoperation =
            Compilerˉsourceˉwirˉoperation.I32ˉconstant;
        var Target: u32 = Value.Magnitude;
        var Auxiliary: u32 = Value.High;
        if Value.Shape == 1u32 {
            if Value.Negative {
                Target = 4294967295u32 - Value.Magnitude + 1u32;
            }
        }
        if Value.Shape == 2u32 {
            Operation = Compilerˉsourceˉwirˉoperation.U8ˉconstant;
        }
        if Value.Shape == 3u32 {
            Operation = Compilerˉsourceˉwirˉoperation.U32ˉconstant;
        }
        if Value.Shape == 7u32 {
            Operation = Compilerˉsourceˉwirˉoperation.I64ˉconstant;
            if Value.Negative {
                if Target == 0u32 {
                    Auxiliary = 4294967295u32 - Auxiliary + 1u32;
                } else {
                    Target = 4294967295u32 - Target + 1u32;
                    Auxiliary = 4294967295u32 - Auxiliary;
                }
            }
        }
        if Value.Shape == 8u32 {
            Operation = Compilerˉsourceˉwirˉoperation.U64ˉconstant;
        }
        if Value.Shape == 4u32 {
            Operation = Compilerˉsourceˉwirˉoperation.Boolˉconstant;
        }
        if Value.Shape >= 131072u32 + Symbols.Records {
            if Value.Shape < 131072u32 + Symbols.Records + Symbols.Enums {
            Operation = Compilerˉsourceˉwirˉoperation.Enumˉconstant;
            Target = Value.Shape - 131072u32;
            Auxiliary = Value.Magnitude;
            }
        }
        return Compilerˉsourceˉwirˉemit(
            Build, Operation, Value.Shape,
            Compilerˉsourceˉwirˉempty(Source), Target, Auxiliary,
            Expression.Offset, Expression.Length
        );
    }
    let Data: Sourceˉbindings.Compilerˉsourceˉbindingˉmatch = Sourceˉbindings.Compilerˉsourceˉbindingsˉfindˉdeclaration(
        Input, Scan, Symbols, Build.Currentˉmodule, Source,
        Expression.Valueˉoffset, Expression.Valueˉlength,
        Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Data
    );
    if !Data.Found {
        return Compilerˉsourceˉwirˉfailureˉvalue(
            Build, Compilerˉsourceˉwirˉstatus.Invalidˉdataˉuse,
            Data.Module, Expression.Offset, Expression.Line, Expression.Column
        );
    }
    if !Data.Accessible {
        return Compilerˉsourceˉwirˉfailureˉvalue(
            Build, Compilerˉsourceˉwirˉstatus.Invalidˉdataˉuse,
            Data.Module, Expression.Offset, Expression.Line, Expression.Column
        );
    }
    let Kind: Compilerˉsourceˉwirˉdataˉkind = Compilerˉsourceˉwirˉdataˉkind(
        Input, Scan, Symbols, Data
    );
    if Kind == Compilerˉsourceˉwirˉdataˉkind.Text {
        return Compilerˉsourceˉwirˉemit(
            Build, Compilerˉsourceˉwirˉoperation.Textˉconstant, 5u32,
            Compilerˉsourceˉwirˉempty(Source), Data.Directoryˉentry, 0u32,
            Expression.Offset, Expression.Length
        );
    }
    if Kind == Compilerˉsourceˉwirˉdataˉkind.Bytes {
        return Compilerˉsourceˉwirˉemit(
            Build, Compilerˉsourceˉwirˉoperation.Bytesˉconstant, 6u32,
            Compilerˉsourceˉwirˉempty(Source), Data.Directoryˉentry, 0u32,
            Expression.Offset, Expression.Length
        );
    }
    return Compilerˉsourceˉwirˉfailureˉvalue(
        Build,
        Compilerˉsourceˉwirˉstatus.Invalidˉdataˉuse,
        Data.Module,
        Expression.Offset,
        Expression.Line,
        Expression.Column
    );
}

fn Compilerˉsourceˉwirˉcompileˉrecordˉpath(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Source: bytes,
    Expression: Sourceˉbodies.Compilerˉsourceˉexpression,
    Base: Compilerˉsourceˉwirˉvalue,
    Cursor: u32,
    Line: u32,
    Column: u32
) -> Compilerˉsourceˉwirˉvalue {
    var Result: Compilerˉsourceˉwirˉvalue = Base;
    var Pathˉcursor: u32 = Cursor;
    var Pathˉline: u32 = Line;
    var Pathˉcolumn: u32 = Column;
    let Pathˉend: u32 = Expression.Valueˉoffset + Expression.Valueˉlength;
    while Pathˉcursor < Pathˉend {
        let Dot: Sourceˉlexer.Compilerˉsourceˉtoken =
            Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                Source, Pathˉcursor, Pathˉline, Pathˉcolumn
            );
        let Member: Sourceˉlexer.Compilerˉsourceˉtoken =
            Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                Source, Dot.Nextˉoffset, Dot.Nextˉline, Dot.Nextˉcolumn
            );
        if Result.Shape < 65536u32 || Result.Shape >= 131072u32 {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Compilerˉsourceˉwirˉvalueˉbuild(Result),
                Compilerˉsourceˉwirˉstatus.Invalidˉfieldˉtarget,
                Result.Currentˉmodule,
                Member.Offset,
                Member.Line,
                Member.Column
            );
        }
        let Pathˉnominal: Sourceˉsymbols.Compilerˉsourceˉsymbolˉmatch =
            Compilerˉsourceˉwirˉnominalˉbyˉshape(
                Input, Scan, Symbols, Result.Shape
            );
        let Pathˉfield: Compilerˉsourceˉwirˉmember =
            Compilerˉsourceˉwirˉnominalˉmember(
                Input,
                Scan,
                Symbols,
                Pathˉnominal,
                Source,
                Member.Offset,
                Member.Length
            );
        if !Pathˉfield.Found {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Compilerˉsourceˉwirˉvalueˉbuild(Result),
                Compilerˉsourceˉwirˉstatus.Unknownˉfield,
                Pathˉnominal.Module,
                Member.Offset,
                Member.Line,
                Member.Column
            );
        }
        Result = Compilerˉsourceˉwirˉemit(
            Compilerˉsourceˉwirˉvalueˉbuild(Result),
            Compilerˉsourceˉwirˉoperation.Recordˉfield,
            Pathˉfield.Shape,
            Compilerˉsourceˉwirˉoneˉoperand(Result.Temporary),
            Result.Shape - 65536u32,
            Pathˉfield.Index,
            Expression.Offset,
            Expression.Length
        );
        Pathˉcursor = Member.Nextˉoffset;
        Pathˉline = Member.Nextˉline;
        Pathˉcolumn = Member.Nextˉcolumn;
    }
    return Result;
}

export fn Compilerˉsourceˉwirˉcompileˉfield(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Bindingˉpayload: bytes,
    Bindingˉfirst: u32,
    Bindingˉentries: u32,
    Source: bytes,
    Expression: Sourceˉbodies.Compilerˉsourceˉexpression,
    Build: Compilerˉsourceˉwirˉbuild
) -> Compilerˉsourceˉwirˉvalue {
    let Firstˉposition: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
        Source, Expression.Offset, Expression.Line, Expression.Column,
        Expression.Firstˉoffset
    );
    let Position: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
        Source, Expression.Offset, Expression.Line, Expression.Column,
        Expression.Secondˉoffset
    );
    let Local: Sourceˉbindings.Compilerˉsourceˉlocalˉmatch = Sourceˉbindings.Compilerˉsourceˉbindingsˉfindˉlocal(
        Source, Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
        Expression.Firstˉoffset, Expression.Firstˉlength, Expression.Offset
    );
    if Local.Found {
        if Local.Shape < 65536u32 || Local.Shape >= 131072u32 {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Build,
                Compilerˉsourceˉwirˉstatus.Invalidˉfieldˉtarget,
                Build.Currentˉmodule,
                Expression.Firstˉoffset,
                Firstˉposition.Line,
                Firstˉposition.Column
            );
        }
        let Recordˉnominal: Sourceˉsymbols.Compilerˉsourceˉsymbolˉmatch =
            Compilerˉsourceˉwirˉnominalˉbyˉshape(
                Input, Scan, Symbols, Local.Shape
            );
        let Field: Compilerˉsourceˉwirˉmember =
            Compilerˉsourceˉwirˉnominalˉmember(
                Input,
                Scan,
                Symbols,
                Recordˉnominal,
                Source,
                Expression.Secondˉoffset,
                Expression.Secondˉlength
            );
        if !Field.Found {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Build,
                Compilerˉsourceˉwirˉstatus.Unknownˉfield,
                Recordˉnominal.Module,
                Expression.Secondˉoffset,
                Position.Line,
                Position.Column
            );
        }
        let Target: Compilerˉsourceˉwirˉvalue = Compilerˉsourceˉwirˉemit(
            Build, Compilerˉsourceˉwirˉoperation.Loadˉlocal, Local.Shape,
            Compilerˉsourceˉwirˉempty(Source), Local.Slot, 0u32,
            Expression.Firstˉoffset, Expression.Firstˉlength
        );
        let Firstˉfield: Compilerˉsourceˉwirˉvalue =
            Compilerˉsourceˉwirˉemit(
                Compilerˉsourceˉwirˉvalueˉbuild(Target),
                Compilerˉsourceˉwirˉoperation.Recordˉfield,
                Field.Shape,
                Compilerˉsourceˉwirˉoneˉoperand(Target.Temporary),
                Local.Shape - 65536u32,
                Field.Index,
                Expression.Offset,
                Expression.Length
            );
        let Secondˉtoken: Sourceˉlexer.Compilerˉsourceˉtoken =
            Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                Source,
                Expression.Secondˉoffset,
                Position.Line,
                Position.Column
            );
        return Compilerˉsourceˉwirˉcompileˉrecordˉpath(
            Input,
            Scan,
            Symbols,
            Source,
            Expression,
            Firstˉfield,
            Secondˉtoken.Nextˉoffset,
            Secondˉtoken.Nextˉline,
            Secondˉtoken.Nextˉcolumn
        );
    }
    let Qualifiedˉconstant: Sourceˉbindings.Compilerˉsourceˉbindingˉmatch =
        Sourceˉbindings.Compilerˉsourceˉbindingsˉfindˉdeclaration(
            Input, Scan, Symbols, Build.Currentˉmodule, Source,
            Expression.Valueˉoffset, Expression.Valueˉlength,
            Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Constant
        );
    let Qualifiedˉdata: Sourceˉbindings.Compilerˉsourceˉbindingˉmatch =
        Sourceˉbindings.Compilerˉsourceˉbindingsˉfindˉdeclaration(
            Input, Scan, Symbols, Build.Currentˉmodule, Source,
            Expression.Valueˉoffset, Expression.Valueˉlength,
            Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Data
        );
    if Qualifiedˉconstant.Found {
        return Compilerˉsourceˉwirˉcompileˉname(
            Input, Scan, Symbols, Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
            Source, Expression, Build
        );
    }
    if Qualifiedˉdata.Found {
        return Compilerˉsourceˉwirˉcompileˉname(
            Input, Scan, Symbols, Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
            Source, Expression, Build
        );
    }
    var Lastˉdot: u32 = Expression.Valueˉlength;
    var Nameˉcharacter: u32 = 0u32;
    while Nameˉcharacter < Expression.Valueˉlength {
        if Bytesˉreadˉu8(Source, Expression.Valueˉoffset + Nameˉcharacter) == 46u8 {
            Lastˉdot = Nameˉcharacter;
        }
        Nameˉcharacter = Nameˉcharacter + 1u32;
    }
    let Memberˉoffset: u32 = Expression.Valueˉoffset + Lastˉdot + 1u32;
    let Memberˉlength: u32 = Expression.Valueˉlength - Lastˉdot - 1u32;
    let Memberˉposition: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
        Source, Expression.Offset, Expression.Line, Expression.Column, Memberˉoffset
    );
    let Enumˉnominal: Sourceˉsymbols.Compilerˉsourceˉsymbolˉmatch = Sourceˉsymbols.Compilerˉsourceˉsymbolsˉfindˉownedˉnominal(
        Input, Scan, Symbols.Directory, Symbols.Lookup, Build.Currentˉmodule,
        Source, Expression.Valueˉoffset, Lastˉdot
    );
    if Enumˉnominal.Kind != Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Enum {
        return Compilerˉsourceˉwirˉfailureˉvalue(
            Build, Compilerˉsourceˉwirˉstatus.Invalidˉfieldˉtarget,
            Enumˉnominal.Module,
            Expression.Firstˉoffset, Firstˉposition.Line, Firstˉposition.Column
        );
    }
    if !Sourceˉsymbols.Compilerˉsourceˉsymbolsˉownedˉmatchˉisˉaccessible(
        Input, Scan, Symbols.Visibility, Symbols.Lookup, Build.Currentˉmodule, Source,
        Expression.Valueˉoffset, Lastˉdot, Enumˉnominal
    ) {
        return Compilerˉsourceˉwirˉfailureˉvalue(
            Build, Compilerˉsourceˉwirˉstatus.Invalidˉfieldˉtarget,
            Enumˉnominal.Module,
            Expression.Firstˉoffset, Firstˉposition.Line, Firstˉposition.Column
        );
    }
    let Member: Compilerˉsourceˉwirˉmember = Compilerˉsourceˉwirˉnominalˉmember(
        Input, Scan, Symbols, Enumˉnominal,
        Source, Memberˉoffset, Memberˉlength
    );
    if !Member.Found {
        return Compilerˉsourceˉwirˉfailureˉvalue(
            Build, Compilerˉsourceˉwirˉstatus.Unknownˉenumˉmember,
            Enumˉnominal.Module,
            Memberˉoffset, Memberˉposition.Line, Memberˉposition.Column
        );
    }
    return Compilerˉsourceˉwirˉemit(
        Build,
        Compilerˉsourceˉwirˉoperation.Enumˉconstant,
        Member.Shape,
        Compilerˉsourceˉwirˉempty(Source),
        Member.Shape - 131072u32,
        Member.Index,
        Expression.Offset,
        Expression.Length
    );
}

export fn Compilerˉsourceˉwirˉbinaryˉoperation(
    Operator: Sourceˉlexer.Compilerˉtokenˉkind,
    Shape: u32
) -> Compilerˉsourceˉwirˉoperation {
    if Operator == Sourceˉlexer.Compilerˉtokenˉkind.Plus {
        if Shape == 1u32 { return Compilerˉsourceˉwirˉoperation.I32ˉadd; }
        if Shape == 7u32 { return Compilerˉsourceˉwirˉoperation.I64ˉadd; }
        if Shape == 8u32 { return Compilerˉsourceˉwirˉoperation.U64ˉadd; }
        return Compilerˉsourceˉwirˉoperation.U32ˉadd;
    }
    if Operator == Sourceˉlexer.Compilerˉtokenˉkind.Minus {
        if Shape == 1u32 { return Compilerˉsourceˉwirˉoperation.I32ˉsubtract; }
        if Shape == 7u32 { return Compilerˉsourceˉwirˉoperation.I64ˉsubtract; }
        if Shape == 8u32 { return Compilerˉsourceˉwirˉoperation.U64ˉsubtract; }
        return Compilerˉsourceˉwirˉoperation.U32ˉsubtract;
    }
    if Operator == Sourceˉlexer.Compilerˉtokenˉkind.Star {
        if Shape == 1u32 { return Compilerˉsourceˉwirˉoperation.I32ˉmultiply; }
        if Shape == 7u32 { return Compilerˉsourceˉwirˉoperation.I64ˉmultiply; }
        if Shape == 8u32 { return Compilerˉsourceˉwirˉoperation.U64ˉmultiply; }
        return Compilerˉsourceˉwirˉoperation.U32ˉmultiply;
    }
    if Operator == Sourceˉlexer.Compilerˉtokenˉkind.Slash {
        if Shape == 1u32 { return Compilerˉsourceˉwirˉoperation.I32ˉdivide; }
        if Shape == 7u32 { return Compilerˉsourceˉwirˉoperation.I64ˉdivide; }
        if Shape == 8u32 { return Compilerˉsourceˉwirˉoperation.U64ˉdivide; }
        return Compilerˉsourceˉwirˉoperation.U32ˉdivide;
    }
    if Operator == Sourceˉlexer.Compilerˉtokenˉkind.Percent {
        if Shape == 1u32 { return Compilerˉsourceˉwirˉoperation.I32ˉremainder; }
        if Shape == 7u32 { return Compilerˉsourceˉwirˉoperation.I64ˉremainder; }
        if Shape == 8u32 { return Compilerˉsourceˉwirˉoperation.U64ˉremainder; }
        return Compilerˉsourceˉwirˉoperation.U32ˉremainder;
    }
    if Operator == Sourceˉlexer.Compilerˉtokenˉkind.Ampersand {
        if Shape == 2u32 { return Compilerˉsourceˉwirˉoperation.U8ˉbitwiseˉand; }
        if Shape == 8u32 { return Compilerˉsourceˉwirˉoperation.U64ˉbitwiseˉand; }
        return Compilerˉsourceˉwirˉoperation.U32ˉbitwiseˉand;
    }
    if Operator == Sourceˉlexer.Compilerˉtokenˉkind.Pipe {
        if Shape == 2u32 { return Compilerˉsourceˉwirˉoperation.U8ˉbitwiseˉor; }
        if Shape == 8u32 { return Compilerˉsourceˉwirˉoperation.U64ˉbitwiseˉor; }
        return Compilerˉsourceˉwirˉoperation.U32ˉbitwiseˉor;
    }
    if Operator == Sourceˉlexer.Compilerˉtokenˉkind.Caret {
        if Shape == 2u32 { return Compilerˉsourceˉwirˉoperation.U8ˉbitwiseˉxor; }
        if Shape == 8u32 { return Compilerˉsourceˉwirˉoperation.U64ˉbitwiseˉxor; }
        return Compilerˉsourceˉwirˉoperation.U32ˉbitwiseˉxor;
    }
    if Operator == Sourceˉlexer.Compilerˉtokenˉkind.Shiftˉleft {
        if Shape == 2u32 { return Compilerˉsourceˉwirˉoperation.U8ˉshiftˉleft; }
        if Shape == 8u32 { return Compilerˉsourceˉwirˉoperation.U64ˉshiftˉleft; }
        return Compilerˉsourceˉwirˉoperation.U32ˉshiftˉleft;
    }
    if Operator == Sourceˉlexer.Compilerˉtokenˉkind.Shiftˉright {
        if Shape == 2u32 { return Compilerˉsourceˉwirˉoperation.U8ˉshiftˉright; }
        if Shape == 8u32 { return Compilerˉsourceˉwirˉoperation.U64ˉshiftˉright; }
        return Compilerˉsourceˉwirˉoperation.U32ˉshiftˉright;
    }
    if Operator == Sourceˉlexer.Compilerˉtokenˉkind.Less {
        if Shape == 1u32 { return Compilerˉsourceˉwirˉoperation.I32ˉless; }
        if Shape == 7u32 { return Compilerˉsourceˉwirˉoperation.I64ˉless; }
        if Shape == 8u32 { return Compilerˉsourceˉwirˉoperation.U64ˉless; }
        return Compilerˉsourceˉwirˉoperation.U32ˉless;
    }
    if Operator == Sourceˉlexer.Compilerˉtokenˉkind.Lessˉequals {
        if Shape == 1u32 { return Compilerˉsourceˉwirˉoperation.I32ˉlessˉequal; }
        if Shape == 7u32 { return Compilerˉsourceˉwirˉoperation.I64ˉlessˉequal; }
        if Shape == 8u32 { return Compilerˉsourceˉwirˉoperation.U64ˉlessˉequal; }
        return Compilerˉsourceˉwirˉoperation.U32ˉlessˉequal;
    }
    if Operator == Sourceˉlexer.Compilerˉtokenˉkind.Greater {
        if Shape == 1u32 { return Compilerˉsourceˉwirˉoperation.I32ˉgreater; }
        if Shape == 7u32 { return Compilerˉsourceˉwirˉoperation.I64ˉgreater; }
        if Shape == 8u32 { return Compilerˉsourceˉwirˉoperation.U64ˉgreater; }
        return Compilerˉsourceˉwirˉoperation.U32ˉgreater;
    }
    if Operator == Sourceˉlexer.Compilerˉtokenˉkind.Greaterˉequals {
        if Shape == 1u32 { return Compilerˉsourceˉwirˉoperation.I32ˉgreaterˉequal; }
        if Shape == 7u32 { return Compilerˉsourceˉwirˉoperation.I64ˉgreaterˉequal; }
        if Shape == 8u32 { return Compilerˉsourceˉwirˉoperation.U64ˉgreaterˉequal; }
        return Compilerˉsourceˉwirˉoperation.U32ˉgreaterˉequal;
    }
    if Operator == Sourceˉlexer.Compilerˉtokenˉkind.Equalsˉequals {
        if Shape == 1u32 { return Compilerˉsourceˉwirˉoperation.I32ˉequal; }
        if Shape == 2u32 { return Compilerˉsourceˉwirˉoperation.U8ˉequal; }
        if Shape == 3u32 { return Compilerˉsourceˉwirˉoperation.U32ˉequal; }
        if Shape == 4u32 { return Compilerˉsourceˉwirˉoperation.Boolˉequal; }
        if Shape == 5u32 { return Compilerˉsourceˉwirˉoperation.Textˉequal; }
        if Shape == 6u32 { return Compilerˉsourceˉwirˉoperation.Bytesˉequal; }
        if Shape == 7u32 { return Compilerˉsourceˉwirˉoperation.I64ˉequal; }
        if Shape == 8u32 { return Compilerˉsourceˉwirˉoperation.U64ˉequal; }
        return Compilerˉsourceˉwirˉoperation.Enumˉequal;
    }
    if Shape == 1u32 { return Compilerˉsourceˉwirˉoperation.I32ˉnotˉequal; }
    if Shape == 2u32 { return Compilerˉsourceˉwirˉoperation.U8ˉnotˉequal; }
    if Shape == 3u32 { return Compilerˉsourceˉwirˉoperation.U32ˉnotˉequal; }
    if Shape == 4u32 { return Compilerˉsourceˉwirˉoperation.Boolˉnotˉequal; }
    if Shape == 5u32 { return Compilerˉsourceˉwirˉoperation.Textˉnotˉequal; }
    if Shape == 6u32 { return Compilerˉsourceˉwirˉoperation.Bytesˉnotˉequal; }
    if Shape == 7u32 { return Compilerˉsourceˉwirˉoperation.I64ˉnotˉequal; }
    if Shape == 8u32 { return Compilerˉsourceˉwirˉoperation.U64ˉnotˉequal; }
    return Compilerˉsourceˉwirˉoperation.Enumˉnotˉequal;
}

export fn Compilerˉsourceˉwirˉcompileˉnamedˉrecord(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Bindingˉpayload: bytes,
    Bindingˉfirst: u32,
    Bindingˉentries: u32,
    Source: bytes,
    Expression: Sourceˉbodies.Compilerˉsourceˉexpression,
    Build: Compilerˉsourceˉwirˉbuild
) -> Compilerˉsourceˉwirˉvalue {
    let Callable: Sourceˉbindings.Compilerˉsourceˉbindingˉmatch = Sourceˉbindings.Compilerˉsourceˉbindingsˉfindˉcallable(
        Input, Scan, Symbols, Build.Currentˉmodule, Source,
        Expression.Valueˉoffset, Expression.Valueˉlength
    );
    if !Callable.Found {
        return Compilerˉsourceˉwirˉfailureˉvalue(
            Build, Compilerˉsourceˉwirˉstatus.Invalidˉrecordˉliteral,
            Callable.Module, Expression.Offset, Expression.Line, Expression.Column
        );
    }
    if !Callable.Accessible {
        return Compilerˉsourceˉwirˉfailureˉvalue(
            Build, Compilerˉsourceˉwirˉstatus.Invalidˉrecordˉliteral,
            Callable.Module, Expression.Offset, Expression.Line, Expression.Column
        );
    }
    if Callable.Kind != Sourceˉbindings.Compilerˉsourceˉcallableˉkind.Record {
        return Compilerˉsourceˉwirˉfailureˉvalue(
            Build, Compilerˉsourceˉwirˉstatus.Invalidˉrecordˉliteral,
            Callable.Module, Expression.Offset, Expression.Line, Expression.Column
        );
    }
    let Nominal: Sourceˉsymbols.Compilerˉsourceˉsymbolˉmatch = Sourceˉsymbols.Compilerˉsourceˉsymbolsˉdirectoryˉentry(
        Symbols.Directory, Scan.Modules, Callable.Directoryˉentry
    );
    let Signature: Compilerˉsourceˉwirˉsignature = Compilerˉsourceˉwirˉrecordˉsignature(
        Input, Scan, Symbols, Callable, 0u32
    );
    let Empty: bytes = Compilerˉsourceˉwirˉempty(Source);
    var Recordˉoperands: bytes = Empty;
    var Operandˉindex: u32 = 0u32;
    while Operandˉindex < Callable.Items {
        Recordˉoperands = Bytesˉconcat(
            Recordˉoperands, Bytesˉfromˉu32ˉlittle(0u32)
        );
        Operandˉindex = Operandˉindex + 1u32;
    }
    let Seenˉresult: Byteˉconstruction.Foundationˉbytesˉresult = Byteˉconstruction.Foundationˉbytesˉrepeat(
        0u8, Callable.Items
    );
    if !Seenˉresult.Valid {
        return Compilerˉsourceˉwirˉfailureˉvalue(
            Build, Compilerˉsourceˉwirˉstatus.Evidenceˉlimit,
            Callable.Module, Expression.Offset, Expression.Line, Expression.Column
        );
    }
    var Seen: bytes = Seenˉresult.Value;
    var Result: Compilerˉsourceˉwirˉbuild = Build;
    var Cursor: u32 = Expression.Itemsˉoffset;
    var Currentˉposition: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
        Source, Expression.Offset, Expression.Line, Expression.Column,
        Expression.Itemsˉoffset
    );
    var Item: u32 = 0u32;
    while Item < Expression.Items {
        let Field: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉbodies.Compilerˉbodyˉtoken(
            Source, Cursor, Currentˉposition.Line, Currentˉposition.Column,
            Expression.Itemsˉoffset + Expression.Itemsˉlength
        );
        let Colon: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉbodies.Compilerˉbodyˉtoken(
            Source, Field.Nextˉoffset, Field.Nextˉline, Field.Nextˉcolumn,
            Expression.Itemsˉoffset + Expression.Itemsˉlength
        );
        let Fieldˉvalue: Sourceˉbodies.Compilerˉsourceˉexpression = Sourceˉbodies.Compilerˉparseˉexpressionˉvalidated(
            Source, Colon.Nextˉoffset, Colon.Nextˉline, Colon.Nextˉcolumn,
            Expression.Itemsˉoffset + Expression.Itemsˉlength, 0u32, 0u32
        );
        let Value: Compilerˉsourceˉwirˉvalue = Compilerˉsourceˉwirˉcompileˉexpression(
            Input, Scan, Symbols, Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
            Source,
            Fieldˉvalue.Offset, Fieldˉvalue.Line, Fieldˉvalue.Column,
            Fieldˉvalue.Offset + Fieldˉvalue.Length,
            Result
        );
        if Value.Status != Compilerˉsourceˉwirˉstatus.Valid { return Value; }
        let Member: Compilerˉsourceˉwirˉmember = Compilerˉsourceˉwirˉnominalˉmember(
            Input, Scan, Symbols, Nominal, Source, Field.Offset, Field.Length
        );
        if !Member.Found {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Compilerˉsourceˉwirˉvalueˉbuild(Value),
                Compilerˉsourceˉwirˉstatus.Unknownˉfield,
                Callable.Module, Field.Offset, Field.Line, Field.Column
            );
        }
        if Bytesˉreadˉu8(Seen, Member.Index) != 0u8 {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Compilerˉsourceˉwirˉvalueˉbuild(Value),
                Compilerˉsourceˉwirˉstatus.Duplicateˉrecordˉfield,
                Callable.Module, Field.Offset, Field.Line, Field.Column
            );
        }
        if Value.Shape != Member.Shape {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Compilerˉsourceˉwirˉvalueˉbuild(Value),
                Compilerˉsourceˉwirˉstatus.Typeˉmismatch,
                Callable.Module,
                Fieldˉvalue.Offset, Fieldˉvalue.Line, Fieldˉvalue.Column
            );
        }
        let Updatedˉoperands: Byteˉconstruction.Foundationˉbytesˉresult = Byteˉconstruction.Foundationˉbytesˉreplace(
            Recordˉoperands, Member.Index * 4u32, 4u32,
            Bytesˉfromˉu32ˉlittle(Value.Temporary)
        );
        let Updatedˉseen: Byteˉconstruction.Foundationˉbytesˉresult = Byteˉconstruction.Foundationˉbytesˉreplace(
            Seen, Member.Index, 1u32, Bytesˉfromˉu8(1u8)
        );
        if !Updatedˉoperands.Valid {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Compilerˉsourceˉwirˉvalueˉbuild(Value),
                Compilerˉsourceˉwirˉstatus.Invalidˉdirectory,
                Callable.Module, Field.Offset, Field.Line, Field.Column
            );
        }
        if !Updatedˉseen.Valid {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Compilerˉsourceˉwirˉvalueˉbuild(Value),
                Compilerˉsourceˉwirˉstatus.Invalidˉdirectory,
                Callable.Module, Field.Offset, Field.Line, Field.Column
            );
        }
        Recordˉoperands = Updatedˉoperands.Value;
        Seen = Updatedˉseen.Value;
        Result = Compilerˉsourceˉwirˉvalueˉbuild(Value);
        Cursor = Fieldˉvalue.Nextˉoffset;
        Currentˉposition = Sourceˉbodies.Compilerˉsourceˉposition(
            Fieldˉvalue.Nextˉoffset, Fieldˉvalue.Nextˉline, Fieldˉvalue.Nextˉcolumn
        );
        if Item + 1u32 < Expression.Items {
            let Separator: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉbodies.Compilerˉbodyˉtoken(
                Source, Cursor, Currentˉposition.Line, Currentˉposition.Column,
                Expression.Itemsˉoffset + Expression.Itemsˉlength
            );
            Cursor = Separator.Nextˉoffset;
            Currentˉposition = Sourceˉbodies.Compilerˉsourceˉposition(
                Separator.Nextˉoffset, Separator.Nextˉline, Separator.Nextˉcolumn
            );
        }
        Item = Item + 1u32;
    }
    var Missing: u32 = 0u32;
    while Missing < Callable.Items {
        if Bytesˉreadˉu8(Seen, Missing) == 0u8 {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Result, Compilerˉsourceˉwirˉstatus.Missingˉrecordˉfield,
                Callable.Module,
                Expression.Offset, Expression.Line, Expression.Column
            );
        }
        Missing = Missing + 1u32;
    }
    return Compilerˉsourceˉwirˉemit(
        Result, Compilerˉsourceˉwirˉoperation.Recordˉcreate,
        Signature.Returnˉshape, Recordˉoperands,
        Signature.Target, Signature.Auxiliary,
        Expression.Offset, Expression.Length
    );
}

export fn Compilerˉsourceˉwirˉcompileˉexpression(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Bindingˉpayload: bytes,
    Bindingˉfirst: u32,
    Bindingˉentries: u32,
    Source: bytes,
    Offset: u32,
    Line: u32,
    Column: u32,
    Endˉoffset: u32,
    Build: Compilerˉsourceˉwirˉbuild
) -> Compilerˉsourceˉwirˉvalue {
    let Expression: Sourceˉbodies.Compilerˉsourceˉexpression = Sourceˉbodies.Compilerˉparseˉexpressionˉvalidated(
        Source, Offset, Line, Column, Endˉoffset, 0u32, 0u32
    );
    if Expression.Kind == Sourceˉbodies.Compilerˉsourceˉexpressionˉkind.Integer {
        var Shape: u32 = 1u32;
        var Literalˉoperation: Compilerˉsourceˉwirˉoperation = Compilerˉsourceˉwirˉoperation.I32ˉconstant;
        if Expression.Numericˉkind == Sourceˉlexer.Compilerˉnumericˉkind.U8 {
            Shape = 2u32;
            Literalˉoperation = Compilerˉsourceˉwirˉoperation.U8ˉconstant;
        }
        if Expression.Numericˉkind == Sourceˉlexer.Compilerˉnumericˉkind.U32 {
            Shape = 3u32;
            Literalˉoperation = Compilerˉsourceˉwirˉoperation.U32ˉconstant;
        }
        if Expression.Numericˉkind == Sourceˉlexer.Compilerˉnumericˉkind.I64 {
            Shape = 7u32;
            Literalˉoperation = Compilerˉsourceˉwirˉoperation.I64ˉconstant;
        }
        if Expression.Numericˉkind == Sourceˉlexer.Compilerˉnumericˉkind.U64 {
            Shape = 8u32;
            Literalˉoperation = Compilerˉsourceˉwirˉoperation.U64ˉconstant;
        }
        return Compilerˉsourceˉwirˉemit(
            Build, Literalˉoperation, Shape, Compilerˉsourceˉwirˉempty(Source),
            Expression.Numericˉvalue, Expression.Numericˉhigh,
            Expression.Offset, Expression.Length
        );
    }
    if Expression.Kind == Sourceˉbodies.Compilerˉsourceˉexpressionˉkind.String {
        return Compilerˉsourceˉwirˉemit(
            Build, Compilerˉsourceˉwirˉoperation.Textˉconstant, 5u32,
            Compilerˉsourceˉwirˉempty(Source),
            Expression.Valueˉoffset, Expression.Valueˉlength,
            Expression.Offset, Expression.Length
        );
    }
    if Expression.Kind == Sourceˉbodies.Compilerˉsourceˉexpressionˉkind.Boolean {
        var Boolean: u32 = 0u32;
        if Expression.Booleanˉvalue { Boolean = 1u32; }
        return Compilerˉsourceˉwirˉemit(
            Build, Compilerˉsourceˉwirˉoperation.Boolˉconstant, 4u32,
            Compilerˉsourceˉwirˉempty(Source), Boolean, 0u32,
            Expression.Offset, Expression.Length
        );
    }
    if Expression.Kind == Sourceˉbodies.Compilerˉsourceˉexpressionˉkind.Builder {
        let Builderˉtype: Sourceˉsymbols.Compilerˉsourceˉtypeˉbinding = Sourceˉsymbols.Compilerˉsourceˉsymbolsˉbindˉtype(
            Input, Scan, Symbols.Directory, Symbols.Lookup, Symbols.Visibility,
            Build.Currentˉmodule, Source,
            Expression.Valueˉoffset, Expression.Line, Expression.Column,
            Symbols.Records, Symbols.Enums, false
        );
        let Builderˉshape: u32 = Sourceˉbindings.Compilerˉsourceˉbindingsˉshape(Builderˉtype);
        if !Compilerˉsourceˉwirˉshapeˉisˉbuilder(Builderˉshape) {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Build, Compilerˉsourceˉwirˉstatus.Invalidˉbuilder,
                Build.Currentˉmodule,
                Expression.Offset, Expression.Line, Expression.Column
            );
        }
        return Compilerˉsourceˉwirˉemit(
            Build, Compilerˉsourceˉwirˉoperation.Builderˉcreate,
            Builderˉshape, Compilerˉsourceˉwirˉempty(Source),
            Compilerˉsourceˉwirˉcollectionˉdescriptor(Builderˉshape),
            Compilerˉsourceˉwirˉcollectionˉmaximum(Builderˉshape),
            Expression.Offset, Expression.Length
        );
    }
    if Expression.Kind == Sourceˉbodies.Compilerˉsourceˉexpressionˉkind.Name {
        return Compilerˉsourceˉwirˉcompileˉname(
            Input, Scan, Symbols, Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
            Source, Expression, Build
        );
    }
    if Expression.Kind == Sourceˉbodies.Compilerˉsourceˉexpressionˉkind.Field {
        return Compilerˉsourceˉwirˉcompileˉfield(
            Input, Scan, Symbols, Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
            Source, Expression, Build
        );
    }
    if Expression.Kind == Sourceˉbodies.Compilerˉsourceˉexpressionˉkind.Unary {
        let Unaryˉposition: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
            Source, Expression.Offset, Expression.Line, Expression.Column,
            Expression.Firstˉoffset
        );
        let Operand: Compilerˉsourceˉwirˉvalue = Compilerˉsourceˉwirˉcompileˉexpression(
            Input, Scan, Symbols, Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
            Source,
            Expression.Firstˉoffset, Unaryˉposition.Line, Unaryˉposition.Column,
            Expression.Firstˉoffset + Expression.Firstˉlength,
            Build
        );
        if Operand.Status != Compilerˉsourceˉwirˉstatus.Valid { return Operand; }
        if Expression.Operator == Sourceˉlexer.Compilerˉtokenˉkind.Freeze {
            if !Compilerˉsourceˉwirˉshapeˉisˉbuilder(Operand.Shape) {
                return Compilerˉsourceˉwirˉfailureˉvalue(
                    Compilerˉsourceˉwirˉvalueˉbuild(Operand),
                    Compilerˉsourceˉwirˉstatus.Invalidˉbuilder,
                    Build.Currentˉmodule,
                    Expression.Offset, Expression.Line, Expression.Column
                );
            }
            return Compilerˉsourceˉwirˉemit(
                Compilerˉsourceˉwirˉvalueˉbuild(Operand),
                Compilerˉsourceˉwirˉoperation.Builderˉfreeze,
                Operand.Shape - 268435456u32,
                Compilerˉsourceˉwirˉoneˉoperand(Operand.Temporary),
                0u32, 0u32, Expression.Offset, Expression.Length
            );
        }
        var Required: u32 = 4u32;
        var Unaryˉoperation: Compilerˉsourceˉwirˉoperation = Compilerˉsourceˉwirˉoperation.Boolˉnot;
        if Expression.Operator == Sourceˉlexer.Compilerˉtokenˉkind.Minus {
            Required = Operand.Shape;
            if Operand.Shape == 1u32 {
                Unaryˉoperation = Compilerˉsourceˉwirˉoperation.I32ˉnegate;
            } else if Operand.Shape == 7u32 {
                Unaryˉoperation = Compilerˉsourceˉwirˉoperation.I64ˉnegate;
            } else {
                return Compilerˉsourceˉwirˉfailureˉvalue(
                    Compilerˉsourceˉwirˉvalueˉbuild(Operand),
                    Compilerˉsourceˉwirˉstatus.Invalidˉoperator,
                    Build.Currentˉmodule,
                    Expression.Offset, Expression.Line, Expression.Column
                );
            }
        }
        if Expression.Operator == Sourceˉlexer.Compilerˉtokenˉkind.Tilde {
            Required = Operand.Shape;
            if Operand.Shape == 2u32 {
                Unaryˉoperation = Compilerˉsourceˉwirˉoperation.U8ˉbitwiseˉnot;
            } else if Operand.Shape == 3u32 {
                Unaryˉoperation = Compilerˉsourceˉwirˉoperation.U32ˉbitwiseˉnot;
            } else if Operand.Shape == 8u32 {
                Unaryˉoperation = Compilerˉsourceˉwirˉoperation.U64ˉbitwiseˉnot;
            } else {
                return Compilerˉsourceˉwirˉfailureˉvalue(
                    Compilerˉsourceˉwirˉvalueˉbuild(Operand),
                    Compilerˉsourceˉwirˉstatus.Invalidˉoperator,
                    Build.Currentˉmodule,
                    Expression.Offset, Expression.Line, Expression.Column
                );
            }
        }
        if Operand.Shape != Required {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Compilerˉsourceˉwirˉvalueˉbuild(Operand),
                Compilerˉsourceˉwirˉstatus.Invalidˉoperator,
                Build.Currentˉmodule,
                Expression.Offset, Expression.Line, Expression.Column
            );
        }
        return Compilerˉsourceˉwirˉemit(
            Compilerˉsourceˉwirˉvalueˉbuild(Operand), Unaryˉoperation, Required,
            Compilerˉsourceˉwirˉoneˉoperand(Operand.Temporary),
            0u32, 0u32, Expression.Offset, Expression.Length
        );
    }
    if Expression.Kind == Sourceˉbodies.Compilerˉsourceˉexpressionˉkind.Binary {
        let Firstˉposition: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
            Source, Expression.Offset, Expression.Line, Expression.Column,
            Expression.Firstˉoffset
        );
        let Left: Compilerˉsourceˉwirˉvalue = Compilerˉsourceˉwirˉcompileˉexpression(
            Input, Scan, Symbols, Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
            Source,
            Expression.Firstˉoffset, Firstˉposition.Line, Firstˉposition.Column,
            Expression.Firstˉoffset + Expression.Firstˉlength,
            Build
        );
        if Left.Status != Compilerˉsourceˉwirˉstatus.Valid { return Left; }
        if Expression.Operator == Sourceˉlexer.Compilerˉtokenˉkind.Andˉand ||
            Expression.Operator == Sourceˉlexer.Compilerˉtokenˉkind.Orˉor {
            if Left.Shape != 4u32 {
                return Compilerˉsourceˉwirˉfailureˉvalue(
                    Compilerˉsourceˉwirˉvalueˉbuild(Left),
                    Compilerˉsourceˉwirˉstatus.Invalidˉoperator,
                    Build.Currentˉmodule,
                    Expression.Offset, Expression.Line, Expression.Column
                );
            }
            var Branchˉbuild: Compilerˉsourceˉwirˉbuild = Compilerˉsourceˉwirˉvalueˉbuild(Left);
            let Rightˉblock: u32 = Branchˉbuild.Nextˉblock;
            let Shortˉblock: u32 = Rightˉblock + 1u32;
            let Joinˉblock: u32 = Rightˉblock + 2u32;
            Branchˉbuild = Compilerˉsourceˉwirˉreserveˉblocks(Branchˉbuild, 3u32);
            var Trueˉtarget: u32 = Rightˉblock;
            var Falseˉtarget: u32 = Shortˉblock;
            var Shortˉvalue: u32 = 0u32;
            if Expression.Operator == Sourceˉlexer.Compilerˉtokenˉkind.Orˉor {
                Trueˉtarget = Shortˉblock;
                Falseˉtarget = Rightˉblock;
                Shortˉvalue = 1u32;
            }
            Branchˉbuild = Compilerˉsourceˉwirˉcloseˉcurrentˉblock(
                Branchˉbuild,
                Compilerˉsourceˉwirˉterminator.Branch,
                Left.Temporary,
                Trueˉtarget,
                Falseˉtarget
            );
            let Short: Compilerˉsourceˉwirˉvalue = Compilerˉsourceˉwirˉemit(
                Compilerˉsourceˉwirˉbeginˉreservedˉblock(Branchˉbuild, Shortˉblock),
                Compilerˉsourceˉwirˉoperation.Boolˉconstant,
                4u32,
                Compilerˉsourceˉwirˉempty(Source),
                Shortˉvalue,
                0u32,
                Expression.Offset,
                Expression.Length
            );
            let Afterˉshort: Compilerˉsourceˉwirˉbuild = Compilerˉsourceˉwirˉcloseˉcurrentˉblock(
                Compilerˉsourceˉwirˉvalueˉbuild(Short),
                Compilerˉsourceˉwirˉterminator.Jump,
                Compilerˉsourceˉwirˉsentinel(),
                Joinˉblock,
                Compilerˉsourceˉwirˉsentinel()
            );
            let Shortˉrightˉposition: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
                Source, Expression.Offset, Expression.Line, Expression.Column,
                Expression.Secondˉoffset
            );
            let Shortˉright: Compilerˉsourceˉwirˉvalue = Compilerˉsourceˉwirˉcompileˉexpression(
                Input, Scan, Symbols, Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
                Source,
                Expression.Secondˉoffset, Shortˉrightˉposition.Line, Shortˉrightˉposition.Column,
                Expression.Secondˉoffset + Expression.Secondˉlength,
                Compilerˉsourceˉwirˉbeginˉreservedˉblock(Afterˉshort, Rightˉblock)
            );
            if Shortˉright.Status != Compilerˉsourceˉwirˉstatus.Valid { return Shortˉright; }
            if Shortˉright.Shape != 4u32 {
                return Compilerˉsourceˉwirˉfailureˉvalue(
                    Compilerˉsourceˉwirˉvalueˉbuild(Shortˉright),
                    Compilerˉsourceˉwirˉstatus.Invalidˉoperator,
                    Build.Currentˉmodule,
                    Expression.Offset, Expression.Line, Expression.Column
                );
            }
            let Rightˉpredecessor: u32 = Shortˉright.Currentˉblock;
            let Joined: Compilerˉsourceˉwirˉbuild = Compilerˉsourceˉwirˉcloseˉcurrentˉblock(
                Compilerˉsourceˉwirˉvalueˉbuild(Shortˉright),
                Compilerˉsourceˉwirˉterminator.Jump,
                Compilerˉsourceˉwirˉsentinel(),
                Joinˉblock,
                Compilerˉsourceˉwirˉsentinel()
            );
            return Compilerˉsourceˉwirˉemit(
                Compilerˉsourceˉwirˉbeginˉreservedˉblock(Joined, Joinˉblock),
                Compilerˉsourceˉwirˉoperation.Boolˉphi,
                4u32,
                Compilerˉsourceˉwirˉtwoˉoperands(Short.Temporary, Shortˉright.Temporary),
                Shortˉblock,
                Rightˉpredecessor,
                Expression.Offset,
                Expression.Length
            );
        }
        let Secondˉposition: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
            Source, Expression.Offset, Expression.Line, Expression.Column,
            Expression.Secondˉoffset
        );
        let Right: Compilerˉsourceˉwirˉvalue = Compilerˉsourceˉwirˉcompileˉexpression(
            Input, Scan, Symbols, Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
            Source,
            Expression.Secondˉoffset, Secondˉposition.Line, Secondˉposition.Column,
            Expression.Secondˉoffset + Expression.Secondˉlength,
            Compilerˉsourceˉwirˉvalueˉbuild(Left)
        );
        if Right.Status != Compilerˉsourceˉwirˉstatus.Valid { return Right; }
        var Compatibleˉshapes: bool = Left.Shape == Right.Shape;
        if Expression.Operator == Sourceˉlexer.Compilerˉtokenˉkind.Shiftˉleft ||
            Expression.Operator == Sourceˉlexer.Compilerˉtokenˉkind.Shiftˉright {
            Compatibleˉshapes = Right.Shape == 3u32;
        }
        if !Compatibleˉshapes {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Compilerˉsourceˉwirˉvalueˉbuild(Right),
                Compilerˉsourceˉwirˉstatus.Invalidˉoperator,
                Build.Currentˉmodule,
                Expression.Offset, Expression.Line, Expression.Column
            );
        }
        var Resultˉshape: u32 = Left.Shape;
        var Allowed: bool = false;
        if Expression.Operator == Sourceˉlexer.Compilerˉtokenˉkind.Plus { Allowed = Left.Shape == 1u32 || Left.Shape == 3u32 || Left.Shape == 7u32 || Left.Shape == 8u32; }
        if Expression.Operator == Sourceˉlexer.Compilerˉtokenˉkind.Minus { Allowed = Left.Shape == 1u32 || Left.Shape == 3u32 || Left.Shape == 7u32 || Left.Shape == 8u32; }
        if Expression.Operator == Sourceˉlexer.Compilerˉtokenˉkind.Star { Allowed = Left.Shape == 1u32 || Left.Shape == 3u32 || Left.Shape == 7u32 || Left.Shape == 8u32; }
        if Expression.Operator == Sourceˉlexer.Compilerˉtokenˉkind.Slash { Allowed = Left.Shape == 1u32 || Left.Shape == 3u32 || Left.Shape == 7u32 || Left.Shape == 8u32; }
        if Expression.Operator == Sourceˉlexer.Compilerˉtokenˉkind.Percent { Allowed = Left.Shape == 1u32 || Left.Shape == 3u32 || Left.Shape == 7u32 || Left.Shape == 8u32; }
        if Expression.Operator == Sourceˉlexer.Compilerˉtokenˉkind.Ampersand { Allowed = Left.Shape == 2u32 || Left.Shape == 3u32 || Left.Shape == 8u32; }
        if Expression.Operator == Sourceˉlexer.Compilerˉtokenˉkind.Pipe { Allowed = Left.Shape == 2u32 || Left.Shape == 3u32 || Left.Shape == 8u32; }
        if Expression.Operator == Sourceˉlexer.Compilerˉtokenˉkind.Caret { Allowed = Left.Shape == 2u32 || Left.Shape == 3u32 || Left.Shape == 8u32; }
        if Expression.Operator == Sourceˉlexer.Compilerˉtokenˉkind.Shiftˉleft { Allowed = Left.Shape == 2u32 || Left.Shape == 3u32 || Left.Shape == 8u32; }
        if Expression.Operator == Sourceˉlexer.Compilerˉtokenˉkind.Shiftˉright { Allowed = Left.Shape == 2u32 || Left.Shape == 3u32 || Left.Shape == 8u32; }
        if Expression.Operator == Sourceˉlexer.Compilerˉtokenˉkind.Less { Allowed = Left.Shape == 1u32 || Left.Shape == 3u32 || Left.Shape == 7u32 || Left.Shape == 8u32; Resultˉshape = 4u32; }
        if Expression.Operator == Sourceˉlexer.Compilerˉtokenˉkind.Lessˉequals { Allowed = Left.Shape == 1u32 || Left.Shape == 3u32 || Left.Shape == 7u32 || Left.Shape == 8u32; Resultˉshape = 4u32; }
        if Expression.Operator == Sourceˉlexer.Compilerˉtokenˉkind.Greater { Allowed = Left.Shape == 1u32 || Left.Shape == 3u32 || Left.Shape == 7u32 || Left.Shape == 8u32; Resultˉshape = 4u32; }
        if Expression.Operator == Sourceˉlexer.Compilerˉtokenˉkind.Greaterˉequals { Allowed = Left.Shape == 1u32 || Left.Shape == 3u32 || Left.Shape == 7u32 || Left.Shape == 8u32; Resultˉshape = 4u32; }
        if Expression.Operator == Sourceˉlexer.Compilerˉtokenˉkind.Equalsˉequals {
            Allowed = Left.Shape >= 1u32;
            if Left.Shape > 8u32 {
                Allowed = Left.Shape >= 131072u32 + Symbols.Records;
                if Left.Shape >= 131072u32 + Symbols.Records + Symbols.Enums { Allowed = false; }
            }
            Resultˉshape = 4u32;
        }
        if Expression.Operator == Sourceˉlexer.Compilerˉtokenˉkind.Bangˉequals {
            Allowed = Left.Shape >= 1u32;
            if Left.Shape > 8u32 {
                Allowed = Left.Shape >= 131072u32 + Symbols.Records;
                if Left.Shape >= 131072u32 + Symbols.Records + Symbols.Enums { Allowed = false; }
            }
            Resultˉshape = 4u32;
        }
        if !Allowed {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Compilerˉsourceˉwirˉvalueˉbuild(Right),
                Compilerˉsourceˉwirˉstatus.Invalidˉoperator,
                Build.Currentˉmodule,
                Expression.Offset, Expression.Line, Expression.Column
            );
        }
        return Compilerˉsourceˉwirˉemit(
            Compilerˉsourceˉwirˉvalueˉbuild(Right),
            Compilerˉsourceˉwirˉbinaryˉoperation(Expression.Operator, Left.Shape),
            Resultˉshape,
            Compilerˉsourceˉwirˉtwoˉoperands(Left.Temporary, Right.Temporary),
            0u32, 0u32, Expression.Offset, Expression.Length
        );
    }
    if Expression.Kind == Sourceˉbodies.Compilerˉsourceˉexpressionˉkind.Index {
        let Indexˉposition: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
            Source, Expression.Offset, Expression.Line, Expression.Column,
            Expression.Firstˉoffset
        );
        let Index: Compilerˉsourceˉwirˉvalue = Compilerˉsourceˉwirˉcompileˉexpression(
            Input, Scan, Symbols, Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
            Source,
            Expression.Firstˉoffset, Indexˉposition.Line, Indexˉposition.Column,
            Expression.Firstˉoffset + Expression.Firstˉlength,
            Build
        );
        if Index.Status != Compilerˉsourceˉwirˉstatus.Valid { return Index; }
        let Indexedˉlocal: Sourceˉbindings.Compilerˉsourceˉlocalˉmatch = Sourceˉbindings.Compilerˉsourceˉbindingsˉfindˉlocal(
            Source, Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
            Expression.Valueˉoffset, Expression.Valueˉlength, Expression.Offset
        );
        if Indexedˉlocal.Found {
            if !Compilerˉsourceˉwirˉshapeˉisˉsequence(Indexedˉlocal.Shape) || Index.Shape != 3u32 {
                return Compilerˉsourceˉwirˉfailureˉvalue(
                    Compilerˉsourceˉwirˉvalueˉbuild(Index),
                    Compilerˉsourceˉwirˉstatus.Invalidˉindex,
                    Build.Currentˉmodule,
                    Expression.Offset, Expression.Line, Expression.Column
                );
            }
            let Indexedˉsequence: Compilerˉsourceˉwirˉvalue = Compilerˉsourceˉwirˉemit(
                Compilerˉsourceˉwirˉvalueˉbuild(Index),
                Compilerˉsourceˉwirˉoperation.Loadˉlocal,
                Indexedˉlocal.Shape, Compilerˉsourceˉwirˉempty(Source),
                Indexedˉlocal.Slot, 0u32,
                Expression.Valueˉoffset, Expression.Valueˉlength
            );
            return Compilerˉsourceˉwirˉemit(
                Compilerˉsourceˉwirˉvalueˉbuild(Indexedˉsequence),
                Compilerˉsourceˉwirˉoperation.Sequenceˉelement,
                Compilerˉsourceˉwirˉcollectionˉelementˉshape(Indexedˉlocal.Shape),
                Compilerˉsourceˉwirˉtwoˉoperands(Indexedˉsequence.Temporary, Index.Temporary),
                0u32, 0u32, Expression.Offset, Expression.Length
            );
        }
        if Index.Shape != 1u32 {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Compilerˉsourceˉwirˉvalueˉbuild(Index),
                Compilerˉsourceˉwirˉstatus.Invalidˉindex,
                Build.Currentˉmodule,
                Expression.Firstˉoffset, Indexˉposition.Line, Indexˉposition.Column
            );
        }
        let Data: Sourceˉbindings.Compilerˉsourceˉbindingˉmatch = Sourceˉbindings.Compilerˉsourceˉbindingsˉfindˉdeclaration(
            Input, Scan, Symbols, Build.Currentˉmodule, Source,
            Expression.Valueˉoffset, Expression.Valueˉlength,
            Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Data
        );
        if !Data.Found {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Compilerˉsourceˉwirˉvalueˉbuild(Index),
                Compilerˉsourceˉwirˉstatus.Invalidˉdataˉuse,
                Data.Module,
                Expression.Valueˉoffset, Expression.Line, Expression.Column
            );
        }
        if !Data.Accessible {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Compilerˉsourceˉwirˉvalueˉbuild(Index),
                Compilerˉsourceˉwirˉstatus.Invalidˉdataˉuse,
                Data.Module,
                Expression.Valueˉoffset, Expression.Line, Expression.Column
            );
        }
        if Compilerˉsourceˉwirˉdataˉkind(Input, Scan, Symbols, Data) != Compilerˉsourceˉwirˉdataˉkind.I32ˉarray {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Compilerˉsourceˉwirˉvalueˉbuild(Index),
                Compilerˉsourceˉwirˉstatus.Invalidˉdataˉuse,
                Data.Module,
                Expression.Valueˉoffset, Expression.Line, Expression.Column
            );
        }
        return Compilerˉsourceˉwirˉemit(
            Compilerˉsourceˉwirˉvalueˉbuild(Index),
            Compilerˉsourceˉwirˉoperation.Dataˉloadˉi32,
            1u32,
            Compilerˉsourceˉwirˉoneˉoperand(Index.Temporary),
            Data.Directoryˉentry, 0u32,
            Expression.Offset, Expression.Length
        );
    }
    if Expression.Kind == Sourceˉbodies.Compilerˉsourceˉexpressionˉkind.Namedˉrecord {
        return Compilerˉsourceˉwirˉcompileˉnamedˉrecord(
            Input, Scan, Symbols, Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
            Source, Expression, Build
        );
    }
    return Compilerˉsourceˉwirˉcompileˉcall(
        Input, Scan, Symbols, Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
        Source, Expression, Build
    );
}

export fn Compilerˉsourceˉwirˉcompileˉcall(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Bindingˉpayload: bytes,
    Bindingˉfirst: u32,
    Bindingˉentries: u32,
    Source: bytes,
    Expression: Sourceˉbodies.Compilerˉsourceˉexpression,
    Build: Compilerˉsourceˉwirˉbuild
) -> Compilerˉsourceˉwirˉvalue {
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(
        Source, Expression.Valueˉoffset, Expression.Valueˉlength, "length"
    ) {
        if Expression.Items != 1u32 {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Build, Compilerˉsourceˉwirˉstatus.Invalidˉargument,
                Build.Currentˉmodule,
                Expression.Offset, Expression.Line, Expression.Column
            );
        }
        let Lengthˉposition: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
            Source, Expression.Offset, Expression.Line, Expression.Column,
            Expression.Itemsˉoffset
        );
        let Lengthˉargument: Sourceˉbodies.Compilerˉsourceˉexpression = Sourceˉbodies.Compilerˉparseˉexpressionˉvalidated(
            Source,
            Expression.Itemsˉoffset,
            Lengthˉposition.Line,
            Lengthˉposition.Column,
            Expression.Itemsˉoffset + Expression.Itemsˉlength,
            0u32,
            0u32
        );
        if Lengthˉargument.Kind == Sourceˉbodies.Compilerˉsourceˉexpressionˉkind.Name {
            let Collectionˉlengthˉlocal: Sourceˉbindings.Compilerˉsourceˉlocalˉmatch = Sourceˉbindings.Compilerˉsourceˉbindingsˉfindˉlocal(
                Source, Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
                Lengthˉargument.Valueˉoffset, Lengthˉargument.Valueˉlength,
                Lengthˉargument.Offset
            );
            if Collectionˉlengthˉlocal.Found {
                if !Compilerˉsourceˉwirˉshapeˉisˉsequence(Collectionˉlengthˉlocal.Shape) {
                    return Compilerˉsourceˉwirˉfailureˉvalue(
                        Build, Compilerˉsourceˉwirˉstatus.Invalidˉcollection,
                        Build.Currentˉmodule,
                        Lengthˉargument.Offset, Lengthˉargument.Line, Lengthˉargument.Column
                    );
                }
                let Collectionˉlengthˉvalue: Compilerˉsourceˉwirˉvalue = Compilerˉsourceˉwirˉcompileˉname(
                    Input, Scan, Symbols, Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
                    Source, Lengthˉargument, Build
                );
                return Compilerˉsourceˉwirˉemit(
                    Compilerˉsourceˉwirˉvalueˉbuild(Collectionˉlengthˉvalue),
                    Compilerˉsourceˉwirˉoperation.Sequenceˉlength,
                    3u32,
                    Compilerˉsourceˉwirˉoneˉoperand(Collectionˉlengthˉvalue.Temporary),
                    0u32, 0u32, Expression.Offset, Expression.Length
                );
            }
        }
        if Lengthˉargument.Kind != Sourceˉbodies.Compilerˉsourceˉexpressionˉkind.Name {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Build, Compilerˉsourceˉwirˉstatus.Invalidˉdataˉuse,
                Build.Currentˉmodule,
                Expression.Offset, Expression.Line, Expression.Column
            );
        }
        let Data: Sourceˉbindings.Compilerˉsourceˉbindingˉmatch = Sourceˉbindings.Compilerˉsourceˉbindingsˉfindˉdeclaration(
            Input, Scan, Symbols, Build.Currentˉmodule, Source,
            Lengthˉargument.Valueˉoffset, Lengthˉargument.Valueˉlength,
            Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Data
        );
        if !Data.Found {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Build, Compilerˉsourceˉwirˉstatus.Invalidˉdataˉuse,
                Data.Module,
                Lengthˉargument.Offset, Lengthˉargument.Line, Lengthˉargument.Column
            );
        }
        if !Data.Accessible {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Build, Compilerˉsourceˉwirˉstatus.Invalidˉdataˉuse,
                Data.Module,
                Lengthˉargument.Offset, Lengthˉargument.Line, Lengthˉargument.Column
            );
        }
        if Compilerˉsourceˉwirˉdataˉkind(Input, Scan, Symbols, Data) != Compilerˉsourceˉwirˉdataˉkind.I32ˉarray {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Build, Compilerˉsourceˉwirˉstatus.Invalidˉdataˉuse,
                Data.Module,
                Lengthˉargument.Offset, Lengthˉargument.Line, Lengthˉargument.Column
            );
        }
        return Compilerˉsourceˉwirˉemit(
            Build, Compilerˉsourceˉwirˉoperation.Dataˉlength, 1u32,
            Compilerˉsourceˉwirˉempty(Source),
            Data.Directoryˉentry, 0u32,
            Expression.Offset, Expression.Length
        );
    }
    let Callable: Sourceˉbindings.Compilerˉsourceˉbindingˉmatch = Sourceˉbindings.Compilerˉsourceˉbindingsˉfindˉcallable(
        Input, Scan, Symbols, Build.Currentˉmodule, Source,
        Expression.Valueˉoffset, Expression.Valueˉlength
    );
    if !Callable.Found {
        return Compilerˉsourceˉwirˉfailureˉvalue(
            Build, Compilerˉsourceˉwirˉstatus.Invalidˉargument,
            Callable.Module, Expression.Offset, Expression.Line, Expression.Column
        );
    }
    if !Callable.Accessible {
        return Compilerˉsourceˉwirˉfailureˉvalue(
            Build, Compilerˉsourceˉwirˉstatus.Invalidˉargument,
            Callable.Module, Expression.Offset, Expression.Line, Expression.Column
        );
    }
    if Callable.Items != Expression.Items {
        return Compilerˉsourceˉwirˉfailureˉvalue(
            Build, Compilerˉsourceˉwirˉstatus.Invalidˉargument,
            Callable.Module, Expression.Offset, Expression.Line, Expression.Column
        );
    }
    var Result: Compilerˉsourceˉwirˉbuild = Build;
    var Argumentˉoperands: bytes = Compilerˉsourceˉwirˉempty(Source);
    var Cursor: u32 = Expression.Itemsˉoffset;
    var Currentˉposition: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
        Source, Expression.Offset, Expression.Line, Expression.Column,
        Expression.Itemsˉoffset
    );
    var Item: u32 = 0u32;
    while Item < Expression.Items {
        let Callˉargument: Sourceˉbodies.Compilerˉsourceˉexpression = Sourceˉbodies.Compilerˉparseˉexpressionˉvalidated(
            Source, Cursor, Currentˉposition.Line, Currentˉposition.Column,
            Expression.Itemsˉoffset + Expression.Itemsˉlength, 0u32, 0u32
        );
        let Value: Compilerˉsourceˉwirˉvalue = Compilerˉsourceˉwirˉcompileˉexpression(
            Input, Scan, Symbols, Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
            Source,
            Callˉargument.Offset, Callˉargument.Line, Callˉargument.Column,
            Callˉargument.Offset + Callˉargument.Length,
            Result
        );
        if Value.Status != Compilerˉsourceˉwirˉstatus.Valid { return Value; }
        var Expected: u32 = 0u32;
        if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(
            Source, Expression.Valueˉoffset, Expression.Valueˉlength, "Enumˉname"
        ) {
            if Value.Shape >= 131072u32 + Symbols.Records {
                if Value.Shape < 131072u32 + Symbols.Records + Symbols.Enums {
                    Expected = Value.Shape;
                }
            }
        } else {
            let Argumentˉsignature: Compilerˉsourceˉwirˉsignature = Compilerˉsourceˉwirˉcallableˉsignature(
                Input, Scan, Symbols, Callable,
                Source, Expression.Valueˉoffset, Expression.Valueˉlength, Item
            );
            Expected = Argumentˉsignature.Parameterˉshape;
        }
        if Value.Shape != Expected {
            return Compilerˉsourceˉwirˉfailureˉvalue(
                Compilerˉsourceˉwirˉvalueˉbuild(Value),
                Compilerˉsourceˉwirˉstatus.Invalidˉargument,
                Callable.Module,
                Callˉargument.Offset, Callˉargument.Line, Callˉargument.Column
            );
        }
        Argumentˉoperands = Bytesˉconcat(
            Argumentˉoperands, Bytesˉfromˉu32ˉlittle(Value.Temporary)
        );
        Result = Compilerˉsourceˉwirˉvalueˉbuild(Value);
        Cursor = Callˉargument.Nextˉoffset;
        Currentˉposition = Sourceˉbodies.Compilerˉsourceˉposition(
            Callˉargument.Nextˉoffset, Callˉargument.Nextˉline, Callˉargument.Nextˉcolumn
        );
        if Item + 1u32 < Expression.Items {
            let Separator: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉbodies.Compilerˉbodyˉtoken(
                Source, Cursor, Currentˉposition.Line, Currentˉposition.Column,
                Expression.Itemsˉoffset + Expression.Itemsˉlength
            );
            Cursor = Separator.Nextˉoffset;
            Currentˉposition = Sourceˉbodies.Compilerˉsourceˉposition(
                Separator.Nextˉoffset, Separator.Nextˉline, Separator.Nextˉcolumn
            );
        }
        Item = Item + 1u32;
    }
    let Signature: Compilerˉsourceˉwirˉsignature = Compilerˉsourceˉwirˉcallableˉsignature(
        Input, Scan, Symbols, Callable,
        Source, Expression.Valueˉoffset, Expression.Valueˉlength, 0u32
    );
    var Operation: Compilerˉsourceˉwirˉoperation = Compilerˉsourceˉwirˉoperation.Callˉfunction;
    var Target: u32 = Signature.Target;
    var Auxiliary: u32 = Signature.Auxiliary;
    if Callable.Kind == Sourceˉbindings.Compilerˉsourceˉcallableˉkind.Intrinsic {
        Operation = Compilerˉsourceˉwirˉintrinsicˉoperation(
            Source, Expression.Valueˉoffset, Expression.Valueˉlength
        );
        Target = Compilerˉsourceˉwirˉsentinel();
        Auxiliary = 0u32;
    }
    if Callable.Kind == Sourceˉbindings.Compilerˉsourceˉcallableˉkind.Record {
        Operation = Compilerˉsourceˉwirˉoperation.Recordˉcreate;
    }
    if Callable.Kind == Sourceˉbindings.Compilerˉsourceˉcallableˉkind.Variantˉcase {
        Operation = Compilerˉsourceˉwirˉoperation.Variantˉcreate;
    }
    if Callable.Kind == Sourceˉbindings.Compilerˉsourceˉcallableˉkind.Capability {
        Operation = Compilerˉsourceˉwirˉoperation.Callˉcapability;
    }
    return Compilerˉsourceˉwirˉemit(
        Result, Operation, Signature.Returnˉshape,
        Argumentˉoperands, Target, Auxiliary,
        Expression.Offset, Expression.Length
    );
}

fn Compilerˉsourceˉwirˉcompileˉfor(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Bindings: Sourceˉbindings.Compilerˉsourceˉbindingˉphase,
    Source: bytes,
    Statement: Sourceˉbodies.Compilerˉsourceˉstatement,
    Returnˉshape: u32,
    Build: Compilerˉsourceˉwirˉbuild
) -> Compilerˉsourceˉwirˉbuild {
    var Result: Compilerˉsourceˉwirˉbuild = Compilerˉsourceˉwirˉfusedˉfrom(Build, Bindings);
    var Bindingˉphase: Sourceˉbindings.Compilerˉsourceˉbindingˉphase = Bindings;
    let Bindingˉbuild: Sourceˉbindings.Compilerˉsourceˉbindingˉbuild =
        Sourceˉbindings.Compilerˉsourceˉbindingsˉphaseˉbuildˉvalue(Bindingˉphase);
    let Bindingˉpayload: bytes = Bindingˉbuild.Payload;
    let Bindingˉfirst: u32 = Bindingˉbuild.Entries - Bindingˉbuild.Nextˉslot;
    let Bindingˉentries: u32 = Bindingˉbuild.Entries;
    let Collectionˉforˉsequenceˉposition: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
        Source, Statement.Offset, Statement.Line, Statement.Column,
        Statement.Expressionˉoffset
    );
    let Collectionˉforˉsequence: Compilerˉsourceˉwirˉvalue = Compilerˉsourceˉwirˉcompileˉexpression(
        Input, Scan, Symbols,
        Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
        Source,
        Statement.Expressionˉoffset,
        Collectionˉforˉsequenceˉposition.Line,
        Collectionˉforˉsequenceˉposition.Column,
        Statement.Expressionˉoffset + Statement.Expressionˉlength,
        Result
    );
    if Collectionˉforˉsequence.Status != Compilerˉsourceˉwirˉstatus.Valid {
        return Compilerˉsourceˉwirˉfusedˉfrom(
            Compilerˉsourceˉwirˉvalueˉbuild(Collectionˉforˉsequence),
            Bindingˉphase
        );
    }
    if !Compilerˉsourceˉwirˉshapeˉisˉsequence(Collectionˉforˉsequence.Shape) {
        return Compilerˉsourceˉwirˉfusedˉfrom(
            Compilerˉsourceˉwirˉbuildˉfailure(
                Compilerˉsourceˉwirˉvalueˉbuild(Collectionˉforˉsequence),
                Compilerˉsourceˉwirˉstatus.Invalidˉcollection,
                Result.Currentˉmodule, Result.Currentˉmodule, Result.Currentˉfunction,
                Statement.Expressionˉoffset,
                Collectionˉforˉsequenceˉposition.Line,
                Collectionˉforˉsequenceˉposition.Column
            ), Bindingˉphase
        );
    }
    var Collectionˉforˉbindings: Sourceˉbindings.Compilerˉsourceˉbindingˉbuild = Bindingˉbuild;
    if Collectionˉforˉbindings.Nextˉslot > 4093u32 {
        return Compilerˉsourceˉwirˉfusedˉfrom(
            Compilerˉsourceˉwirˉbuildˉfailure(
                Compilerˉsourceˉwirˉvalueˉbuild(Collectionˉforˉsequence),
                Compilerˉsourceˉwirˉstatus.Sourceˉbindings,
                Result.Currentˉmodule, Result.Currentˉmodule, Result.Currentˉfunction,
                Statement.Offset, Statement.Line, Statement.Column
            ), Bindingˉphase
        );
    }
    Collectionˉforˉbindings = Sourceˉbindings.Compilerˉsourceˉbindingsˉcollectˉforˉbinding(
        Result.Currentˉmodule, Result.Currentˉfunction,
        Source, Statement,
        Compilerˉsourceˉwirˉcollectionˉelementˉshape(Collectionˉforˉsequence.Shape),
        Collectionˉforˉbindings
    );
    if Collectionˉforˉbindings.Status == Sourceˉbindings.Compilerˉsourceˉbindingˉstatus.Valid {
        Collectionˉforˉbindings = Bindingˉbuild;
    }
    let Collectionˉforˉsequenceˉslot: u32 = Collectionˉforˉbindings.Nextˉslot;
    let Collectionˉforˉsequenceˉentry: bytes = Sourceˉbindings.Compilerˉsourceˉbindingsˉentry(
        Result.Currentˉmodule, Result.Currentˉfunction,
        Sourceˉbindings.Compilerˉsourceˉbindingˉkind.Let,
        Collectionˉforˉsequenceˉslot,
        Statement.Nameˉoffset, Statement.Nameˉlength,
        Collectionˉforˉsequence.Shape,
        Statement.Offset, Statement.Firstˉblockˉoffset
    );
    Collectionˉforˉbindings = Sourceˉbindings.Compilerˉsourceˉbindingsˉappend(
        Collectionˉforˉbindings, Collectionˉforˉsequenceˉentry, false
    );
    let Collectionˉforˉindexˉslot: u32 = Collectionˉforˉbindings.Nextˉslot;
    let Collectionˉforˉindexˉentry: bytes = Sourceˉbindings.Compilerˉsourceˉbindingsˉentry(
        Result.Currentˉmodule, Result.Currentˉfunction,
        Sourceˉbindings.Compilerˉsourceˉbindingˉkind.Var,
        Collectionˉforˉindexˉslot,
        Statement.Nameˉoffset, Statement.Nameˉlength, 3u32,
        Statement.Offset, Statement.Firstˉblockˉoffset
    );
    Collectionˉforˉbindings = Sourceˉbindings.Compilerˉsourceˉbindingsˉappend(
        Collectionˉforˉbindings, Collectionˉforˉindexˉentry, false
    );
    let Collectionˉforˉbindingˉslot: u32 = Collectionˉforˉbindings.Nextˉslot;
    let Collectionˉforˉbindingˉentry: bytes = Sourceˉbindings.Compilerˉsourceˉbindingsˉentry(
        Result.Currentˉmodule, Result.Currentˉfunction,
        Sourceˉbindings.Compilerˉsourceˉbindingˉkind.Let,
        Collectionˉforˉbindingˉslot,
        Statement.Nameˉoffset, Statement.Nameˉlength,
        Compilerˉsourceˉwirˉcollectionˉelementˉshape(Collectionˉforˉsequence.Shape),
        Statement.Firstˉblockˉoffset,
        Statement.Firstˉblockˉoffset + Statement.Firstˉblockˉlength
    );
    Collectionˉforˉbindings = Sourceˉbindings.Compilerˉsourceˉbindingsˉappend(
        Collectionˉforˉbindings, Collectionˉforˉbindingˉentry, false
    );
    Bindingˉphase = Sourceˉbindings.Compilerˉsourceˉbindingsˉphaseˉbuild(
        Bindingˉphase, Collectionˉforˉbindings
    );
    if Bindingˉphase.Buildˉstatus != Sourceˉbindings.Compilerˉsourceˉbindingˉstatus.Valid {
        return Compilerˉsourceˉwirˉbuildˉfailure(
            Compilerˉsourceˉwirˉvalueˉbuild(Collectionˉforˉsequence),
            Compilerˉsourceˉwirˉstatus.Sourceˉbindings,
            Bindingˉphase.Buildˉfailureˉmodule,
            Bindingˉphase.Buildˉfailureˉrelatedˉmodule,
            Bindingˉphase.Buildˉfailureˉfunction,
            Bindingˉphase.Buildˉfailureˉoffset,
            Bindingˉphase.Buildˉfailureˉline,
            Bindingˉphase.Buildˉfailureˉcolumn
        );
    }
    let Collectionˉforˉbinding: Sourceˉbindings.Compilerˉsourceˉlocalˉmatch = Sourceˉbindings.Compilerˉsourceˉbindingsˉfindˉlocal(
        Source, Collectionˉforˉbindings.Payload,
        Collectionˉforˉbindings.Entries - Collectionˉforˉbindings.Nextˉslot,
        Collectionˉforˉbindings.Entries,
        Statement.Nameˉoffset, Statement.Nameˉlength,
        Statement.Firstˉblockˉoffset
    );
    let Collectionˉforˉsequenceˉstored: Compilerˉsourceˉwirˉvalue = Compilerˉsourceˉwirˉemit(
        Compilerˉsourceˉwirˉvalueˉbuild(Collectionˉforˉsequence),
        Compilerˉsourceˉwirˉoperation.Storeˉlocal,
        0u32,
        Compilerˉsourceˉwirˉoneˉoperand(Collectionˉforˉsequence.Temporary),
        Collectionˉforˉsequenceˉslot, 0u32,
        Statement.Expressionˉoffset, Statement.Expressionˉlength
    );
    let Collectionˉforˉzero: Compilerˉsourceˉwirˉvalue = Compilerˉsourceˉwirˉemit(
        Compilerˉsourceˉwirˉvalueˉbuild(Collectionˉforˉsequenceˉstored),
        Compilerˉsourceˉwirˉoperation.U32ˉconstant,
        3u32, Compilerˉsourceˉwirˉempty(Source),
        0u32, 0u32, Statement.Offset, Statement.Length
    );
    let Collectionˉforˉindexˉinitialized: Compilerˉsourceˉwirˉvalue = Compilerˉsourceˉwirˉemit(
        Compilerˉsourceˉwirˉvalueˉbuild(Collectionˉforˉzero),
        Compilerˉsourceˉwirˉoperation.Storeˉlocal,
        0u32, Compilerˉsourceˉwirˉoneˉoperand(Collectionˉforˉzero.Temporary),
        Collectionˉforˉindexˉslot, 0u32,
        Statement.Offset, Statement.Length
    );
    Result = Compilerˉsourceˉwirˉfusedˉfrom(
        Compilerˉsourceˉwirˉvalueˉbuild(Collectionˉforˉindexˉinitialized),
        Bindingˉphase
    );
    let Collectionˉforˉheader: u32 = Result.Nextˉblock;
    let Collectionˉforˉbody: u32 = Collectionˉforˉheader + 1u32;
    let Collectionˉforˉincrement: u32 = Collectionˉforˉheader + 2u32;
    let Collectionˉforˉafter: u32 = Collectionˉforˉheader + 3u32;
    Result = Compilerˉsourceˉwirˉreserveˉblocks(Result, 4u32);
    Result = Compilerˉsourceˉwirˉcloseˉcurrentˉblock(
        Result, Compilerˉsourceˉwirˉterminator.Jump,
        Compilerˉsourceˉwirˉsentinel(),
        Collectionˉforˉheader, Compilerˉsourceˉwirˉsentinel()
    );
    Result = Compilerˉsourceˉwirˉbeginˉreservedˉblock(Result, Collectionˉforˉheader);
    let Collectionˉforˉheaderˉindex: Compilerˉsourceˉwirˉvalue = Compilerˉsourceˉwirˉemit(
        Result, Compilerˉsourceˉwirˉoperation.Loadˉlocal,
        3u32, Compilerˉsourceˉwirˉempty(Source),
        Collectionˉforˉindexˉslot, 0u32,
        Statement.Offset, Statement.Length
    );
    let Collectionˉforˉheaderˉsequence: Compilerˉsourceˉwirˉvalue = Compilerˉsourceˉwirˉemit(
        Compilerˉsourceˉwirˉvalueˉbuild(Collectionˉforˉheaderˉindex),
        Compilerˉsourceˉwirˉoperation.Loadˉlocal,
        Collectionˉforˉsequence.Shape, Compilerˉsourceˉwirˉempty(Source),
        Collectionˉforˉsequenceˉslot, 0u32,
        Statement.Expressionˉoffset, Statement.Expressionˉlength
    );
    let Collectionˉforˉlength: Compilerˉsourceˉwirˉvalue = Compilerˉsourceˉwirˉemit(
        Compilerˉsourceˉwirˉvalueˉbuild(Collectionˉforˉheaderˉsequence),
        Compilerˉsourceˉwirˉoperation.Sequenceˉlength,
        3u32,
        Compilerˉsourceˉwirˉoneˉoperand(Collectionˉforˉheaderˉsequence.Temporary),
        0u32, 0u32, Statement.Expressionˉoffset, Statement.Expressionˉlength
    );
    let Collectionˉforˉcondition: Compilerˉsourceˉwirˉvalue = Compilerˉsourceˉwirˉemit(
        Compilerˉsourceˉwirˉvalueˉbuild(Collectionˉforˉlength),
        Compilerˉsourceˉwirˉoperation.U32ˉless,
        4u32,
        Compilerˉsourceˉwirˉtwoˉoperands(
            Collectionˉforˉheaderˉindex.Temporary,
            Collectionˉforˉlength.Temporary
        ),
        0u32, 0u32, Statement.Offset, Statement.Length
    );
    Result = Compilerˉsourceˉwirˉcloseˉcurrentˉblock(
        Compilerˉsourceˉwirˉvalueˉbuild(Collectionˉforˉcondition),
        Compilerˉsourceˉwirˉterminator.Branch,
        Collectionˉforˉcondition.Temporary,
        Collectionˉforˉbody, Collectionˉforˉafter
    );
    Result = Compilerˉsourceˉwirˉbeginˉreservedˉblock(Result, Collectionˉforˉbody);
    let Collectionˉforˉbodyˉsequence: Compilerˉsourceˉwirˉvalue = Compilerˉsourceˉwirˉemit(
        Result, Compilerˉsourceˉwirˉoperation.Loadˉlocal,
        Collectionˉforˉsequence.Shape, Compilerˉsourceˉwirˉempty(Source),
        Collectionˉforˉsequenceˉslot, 0u32,
        Statement.Expressionˉoffset, Statement.Expressionˉlength
    );
    let Collectionˉforˉbodyˉindex: Compilerˉsourceˉwirˉvalue = Compilerˉsourceˉwirˉemit(
        Compilerˉsourceˉwirˉvalueˉbuild(Collectionˉforˉbodyˉsequence),
        Compilerˉsourceˉwirˉoperation.Loadˉlocal,
        3u32, Compilerˉsourceˉwirˉempty(Source),
        Collectionˉforˉindexˉslot, 0u32,
        Statement.Offset, Statement.Length
    );
    let Collectionˉforˉelement: Compilerˉsourceˉwirˉvalue = Compilerˉsourceˉwirˉemit(
        Compilerˉsourceˉwirˉvalueˉbuild(Collectionˉforˉbodyˉindex),
        Compilerˉsourceˉwirˉoperation.Sequenceˉelement,
        Collectionˉforˉbinding.Shape,
        Compilerˉsourceˉwirˉtwoˉoperands(
            Collectionˉforˉbodyˉsequence.Temporary,
            Collectionˉforˉbodyˉindex.Temporary
        ),
        0u32, 0u32, Statement.Offset, Statement.Length
    );
    let Collectionˉforˉelementˉstored: Compilerˉsourceˉwirˉvalue = Compilerˉsourceˉwirˉemit(
        Compilerˉsourceˉwirˉvalueˉbuild(Collectionˉforˉelement),
        Compilerˉsourceˉwirˉoperation.Storeˉlocal,
        0u32, Compilerˉsourceˉwirˉoneˉoperand(Collectionˉforˉelement.Temporary),
        Collectionˉforˉbinding.Slot, 0u32,
        Statement.Offset, Statement.Length
    );
    let Collectionˉforˉbodyˉposition: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
        Source, Statement.Offset, Statement.Line, Statement.Column,
        Statement.Firstˉblockˉoffset
    );
    let Collectionˉforˉbodyˉcompiled: Compilerˉsourceˉwirˉbuild = Compilerˉsourceˉwirˉcompileˉblock(
        Input, Scan, Symbols, Bindingˉphase,
        Source,
        Statement.Firstˉblockˉoffset,
        Collectionˉforˉbodyˉposition.Line,
        Collectionˉforˉbodyˉposition.Column,
        Statement.Firstˉblockˉoffset + Statement.Firstˉblockˉlength,
        Returnˉshape, Collectionˉforˉincrement, Collectionˉforˉafter,
        Compilerˉsourceˉwirˉvalueˉbuild(Collectionˉforˉelementˉstored)
    );
    if Collectionˉforˉbodyˉcompiled.Status != Compilerˉsourceˉwirˉstatus.Valid {
        return Collectionˉforˉbodyˉcompiled;
    }
    Result = Collectionˉforˉbodyˉcompiled;
    Bindingˉphase = Compilerˉsourceˉwirˉbuildˉbindings(Input, Collectionˉforˉbodyˉcompiled);
    if Result.Hasˉcurrentˉblock {
        Result = Compilerˉsourceˉwirˉcloseˉcurrentˉblock(
            Result, Compilerˉsourceˉwirˉterminator.Jump,
            Compilerˉsourceˉwirˉsentinel(),
            Collectionˉforˉincrement, Compilerˉsourceˉwirˉsentinel()
        );
    }
    Result = Compilerˉsourceˉwirˉbeginˉreservedˉblock(Result, Collectionˉforˉincrement);
    let Collectionˉforˉincrementˉindex: Compilerˉsourceˉwirˉvalue = Compilerˉsourceˉwirˉemit(
        Result, Compilerˉsourceˉwirˉoperation.Loadˉlocal,
        3u32, Compilerˉsourceˉwirˉempty(Source),
        Collectionˉforˉindexˉslot, 0u32,
        Statement.Offset, Statement.Length
    );
    let Collectionˉforˉone: Compilerˉsourceˉwirˉvalue = Compilerˉsourceˉwirˉemit(
        Compilerˉsourceˉwirˉvalueˉbuild(Collectionˉforˉincrementˉindex),
        Compilerˉsourceˉwirˉoperation.U32ˉconstant,
        3u32, Compilerˉsourceˉwirˉempty(Source),
        1u32, 0u32, Statement.Offset, Statement.Length
    );
    let Collectionˉforˉincremented: Compilerˉsourceˉwirˉvalue = Compilerˉsourceˉwirˉemit(
        Compilerˉsourceˉwirˉvalueˉbuild(Collectionˉforˉone),
        Compilerˉsourceˉwirˉoperation.U32ˉadd,
        3u32,
        Compilerˉsourceˉwirˉtwoˉoperands(
            Collectionˉforˉincrementˉindex.Temporary,
            Collectionˉforˉone.Temporary
        ),
        0u32, 0u32, Statement.Offset, Statement.Length
    );
    let Collectionˉforˉincrementˉstored: Compilerˉsourceˉwirˉvalue = Compilerˉsourceˉwirˉemit(
        Compilerˉsourceˉwirˉvalueˉbuild(Collectionˉforˉincremented),
        Compilerˉsourceˉwirˉoperation.Storeˉlocal,
        0u32, Compilerˉsourceˉwirˉoneˉoperand(Collectionˉforˉincremented.Temporary),
        Collectionˉforˉindexˉslot, 0u32,
        Statement.Offset, Statement.Length
    );
    Result = Compilerˉsourceˉwirˉcloseˉcurrentˉblock(
        Compilerˉsourceˉwirˉvalueˉbuild(Collectionˉforˉincrementˉstored),
        Compilerˉsourceˉwirˉterminator.Jump,
        Compilerˉsourceˉwirˉsentinel(),
        Collectionˉforˉheader, Compilerˉsourceˉwirˉsentinel()
    );
    Result = Compilerˉsourceˉwirˉbeginˉreservedˉblock(Result, Collectionˉforˉafter);
    return Compilerˉsourceˉwirˉfusedˉfrom(Result, Bindingˉphase);
}

fn Compilerˉsourceˉwirˉcompileˉpush(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Bindings: Sourceˉbindings.Compilerˉsourceˉbindingˉphase,
    Source: bytes,
    Statement: Sourceˉbodies.Compilerˉsourceˉstatement,
    Build: Compilerˉsourceˉwirˉbuild
) -> Compilerˉsourceˉwirˉbuild {
    var Result: Compilerˉsourceˉwirˉbuild = Compilerˉsourceˉwirˉfusedˉfrom(Build, Bindings);
    let Bindingˉphase: Sourceˉbindings.Compilerˉsourceˉbindingˉphase = Bindings;
    let Bindingˉbuild: Sourceˉbindings.Compilerˉsourceˉbindingˉbuild =
        Sourceˉbindings.Compilerˉsourceˉbindingsˉphaseˉbuildˉvalue(Bindings);
    let Bindingˉpayload: bytes = Bindingˉbuild.Payload;
    let Bindingˉfirst: u32 = Bindingˉbuild.Entries - Bindingˉbuild.Nextˉslot;
    let Bindingˉentries: u32 = Bindingˉbuild.Entries;
    let Collectionˉpushˉbinding: Sourceˉbindings.Compilerˉsourceˉlocalˉmatch = Sourceˉbindings.Compilerˉsourceˉbindingsˉfindˉlocal(
        Source, Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
        Statement.Nameˉoffset, Statement.Nameˉlength, Statement.Offset
    );
    if !Collectionˉpushˉbinding.Found || Collectionˉpushˉbinding.Kind != Sourceˉbindings.Compilerˉsourceˉbindingˉkind.Var || !Compilerˉsourceˉwirˉshapeˉisˉbuilder(Collectionˉpushˉbinding.Shape) {
        return Compilerˉsourceˉwirˉfusedˉfrom(
            Compilerˉsourceˉwirˉbuildˉfailure(
                Result, Compilerˉsourceˉwirˉstatus.Invalidˉbuilder,
                Result.Currentˉmodule, Result.Currentˉmodule, Result.Currentˉfunction,
                Statement.Nameˉoffset, Statement.Line, Statement.Column
            ),
            Bindingˉphase
        );
    }
    let Collectionˉpushˉposition: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
        Source, Statement.Offset, Statement.Line, Statement.Column, Statement.Expressionˉoffset
    );
    let Collectionˉpushˉvalue: Compilerˉsourceˉwirˉvalue = Compilerˉsourceˉwirˉcompileˉexpression(
        Input, Scan, Symbols, Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
        Source, Statement.Expressionˉoffset,
        Collectionˉpushˉposition.Line, Collectionˉpushˉposition.Column,
        Statement.Expressionˉoffset + Statement.Expressionˉlength,
        Result
    );
    if Collectionˉpushˉvalue.Status != Compilerˉsourceˉwirˉstatus.Valid {
        return Compilerˉsourceˉwirˉfusedˉfrom(
            Compilerˉsourceˉwirˉvalueˉbuild(Collectionˉpushˉvalue), Bindingˉphase
        );
    }
    if Collectionˉpushˉvalue.Shape != Compilerˉsourceˉwirˉcollectionˉelementˉshape(Collectionˉpushˉbinding.Shape) {
        return Compilerˉsourceˉwirˉfusedˉfrom(
            Compilerˉsourceˉwirˉbuildˉfailure(
                Compilerˉsourceˉwirˉvalueˉbuild(Collectionˉpushˉvalue),
                Compilerˉsourceˉwirˉstatus.Typeˉmismatch,
                Result.Currentˉmodule, Result.Currentˉmodule, Result.Currentˉfunction,
                Statement.Expressionˉoffset,
                Collectionˉpushˉposition.Line, Collectionˉpushˉposition.Column
            ), Bindingˉphase
        );
    }
    let Collectionˉpushˉloaded: Compilerˉsourceˉwirˉvalue = Compilerˉsourceˉwirˉemit(
        Compilerˉsourceˉwirˉvalueˉbuild(Collectionˉpushˉvalue),
        Compilerˉsourceˉwirˉoperation.Loadˉlocal,
        Collectionˉpushˉbinding.Shape,
        Compilerˉsourceˉwirˉempty(Source),
        Collectionˉpushˉbinding.Slot, 0u32,
        Statement.Nameˉoffset, Statement.Nameˉlength
    );
    let Collectionˉpushed: Compilerˉsourceˉwirˉvalue = Compilerˉsourceˉwirˉemit(
        Compilerˉsourceˉwirˉvalueˉbuild(Collectionˉpushˉloaded),
        Compilerˉsourceˉwirˉoperation.Builderˉpush,
        Collectionˉpushˉbinding.Shape,
        Compilerˉsourceˉwirˉtwoˉoperands(
            Collectionˉpushˉloaded.Temporary,
            Collectionˉpushˉvalue.Temporary
        ),
        0u32, 0u32, Statement.Offset, Statement.Length
    );
    let Collectionˉpushˉstored: Compilerˉsourceˉwirˉvalue = Compilerˉsourceˉwirˉemit(
        Compilerˉsourceˉwirˉvalueˉbuild(Collectionˉpushed),
        Compilerˉsourceˉwirˉoperation.Storeˉlocal,
        0u32, Compilerˉsourceˉwirˉoneˉoperand(Collectionˉpushed.Temporary),
        Collectionˉpushˉbinding.Slot, 0u32,
        Statement.Offset, Statement.Length
    );
    Result = Compilerˉsourceˉwirˉvalueˉbuild(Collectionˉpushˉstored);
    return Compilerˉsourceˉwirˉfusedˉfrom(Result, Bindings);
}

fn Compilerˉsourceˉwirˉcompileˉmatch(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Bindings: Sourceˉbindings.Compilerˉsourceˉbindingˉphase,
    Source: bytes,
    Statement: Sourceˉbodies.Compilerˉsourceˉstatement,
    Returnˉshape: u32,
    Continueˉtarget: u32,
    Breakˉtarget: u32,
    Build: Compilerˉsourceˉwirˉbuild
) -> Compilerˉsourceˉwirˉbuild {
    var Result: Compilerˉsourceˉwirˉbuild = Compilerˉsourceˉwirˉfusedˉfrom(Build, Bindings);
    var Bindingˉphase: Sourceˉbindings.Compilerˉsourceˉbindingˉphase = Bindings;
    let Bindingˉbuild: Sourceˉbindings.Compilerˉsourceˉbindingˉbuild =
        Sourceˉbindings.Compilerˉsourceˉbindingsˉphaseˉbuildˉvalue(Bindingˉphase);
    let Bindingˉpayload: bytes = Bindingˉbuild.Payload;
    let Bindingˉfirst: u32 = Bindingˉbuild.Entries - Bindingˉbuild.Nextˉslot;
    let Bindingˉentries: u32 = Bindingˉbuild.Entries;
    let Matchˉvalueˉposition: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
        Source, Statement.Offset, Statement.Line, Statement.Column,
        Statement.Expressionˉoffset
    );
    let Matchˉvalue: Compilerˉsourceˉwirˉvalue = Compilerˉsourceˉwirˉcompileˉexpression(
        Input, Scan, Symbols,
        Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
        Source,
        Statement.Expressionˉoffset,
        Matchˉvalueˉposition.Line,
        Matchˉvalueˉposition.Column,
        Statement.Expressionˉoffset + Statement.Expressionˉlength,
        Result
    );
    if Matchˉvalue.Status != Compilerˉsourceˉwirˉstatus.Valid {
        return Compilerˉsourceˉwirˉfusedˉfrom(
            Compilerˉsourceˉwirˉvalueˉbuild(Matchˉvalue), Bindingˉphase
        );
    }
    var Matchˉshapeˉisˉsupported: bool = false;
    if Matchˉvalue.Shape >= 131072u32 + Symbols.Records {
        if Matchˉvalue.Shape < 131072u32 + Symbols.Records + Symbols.Enums {
            Matchˉshapeˉisˉsupported = true;
        }
    }
    if Matchˉvalue.Shape >= 196608u32 + Symbols.Records + Symbols.Enums {
        if Matchˉvalue.Shape < 196608u32 + Symbols.Records + Symbols.Enums + Symbols.Variants {
            Matchˉshapeˉisˉsupported = true;
        }
    }
    if !Matchˉshapeˉisˉsupported {
        return Compilerˉsourceˉwirˉfusedˉfrom(
            Compilerˉsourceˉwirˉbuildˉfailure(
                Compilerˉsourceˉwirˉvalueˉbuild(Matchˉvalue),
                Compilerˉsourceˉwirˉstatus.Invalidˉmatch,
                Result.Currentˉmodule, Result.Currentˉmodule, Result.Currentˉfunction,
                Statement.Expressionˉoffset,
                Matchˉvalueˉposition.Line,
                Matchˉvalueˉposition.Column
            ),
            Bindingˉphase
        );
    }
    let Matchˉnominal: Sourceˉsymbols.Compilerˉsourceˉsymbolˉmatch = Compilerˉsourceˉwirˉnominalˉbyˉshape(
        Input, Scan, Symbols, Matchˉvalue.Shape
    );
    if !Matchˉnominal.Found {
        return Compilerˉsourceˉwirˉfusedˉfrom(
            Compilerˉsourceˉwirˉbuildˉfailure(
                Compilerˉsourceˉwirˉvalueˉbuild(Matchˉvalue),
                Compilerˉsourceˉwirˉstatus.Invalidˉmatch,
                Result.Currentˉmodule, Result.Currentˉmodule, Result.Currentˉfunction,
                Statement.Expressionˉoffset,
                Matchˉvalueˉposition.Line,
                Matchˉvalueˉposition.Column
            ),
            Bindingˉphase
        );
    }
    let Matchˉisˉvariant: bool =
        Matchˉnominal.Kind == Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Variant;
    let Matchˉdeclarationˉview: Sourceˉset.Compilerˉsourceˉsetˉview = Sourceˉset.Compilerˉsourceˉsetˉmodule(
        Input, Scan, Matchˉnominal.Module
    );
    let Matchˉdeclarationˉposition: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
        Matchˉdeclarationˉview.Source, 0u32, 1u32, 1u32,
        Matchˉnominal.Declarationˉoffset
    );
    let Matchˉdeclaration: Sourceˉdeclarations.Compilerˉsourceˉdeclaration = Sourceˉdeclarations.Compilerˉparseˉnextˉdeclarationˉvalidated(
        Matchˉdeclarationˉview.Source,
        Matchˉnominal.Declarationˉoffset,
        Matchˉdeclarationˉposition.Line,
        Matchˉdeclarationˉposition.Column,
        true
    );
    if Statement.Nameˉlength != Matchˉdeclaration.Items {
        return Compilerˉsourceˉwirˉfusedˉfrom(
            Compilerˉsourceˉwirˉbuildˉfailure(
                Compilerˉsourceˉwirˉvalueˉbuild(Matchˉvalue),
                Compilerˉsourceˉwirˉstatus.Missingˉmatchˉcase,
                Result.Currentˉmodule, Matchˉnominal.Module, Result.Currentˉfunction,
                Statement.Firstˉblockˉoffset,
                Statement.Line,
                Statement.Column
            ),
            Bindingˉphase
        );
    }
    let Matchˉseenˉresult: Byteˉconstruction.Foundationˉbytesˉresult = Byteˉconstruction.Foundationˉbytesˉrepeat(
        0u8, Matchˉdeclaration.Items
    );
    if !Matchˉseenˉresult.Valid {
        return Compilerˉsourceˉwirˉfusedˉfrom(
            Compilerˉsourceˉwirˉbuildˉfailure(
                Compilerˉsourceˉwirˉvalueˉbuild(Matchˉvalue),
                Compilerˉsourceˉwirˉstatus.Evidenceˉlimit,
                Result.Currentˉmodule, Matchˉnominal.Module, Result.Currentˉfunction,
                Statement.Firstˉblockˉoffset,
                Statement.Line,
                Statement.Column
            ),
            Bindingˉphase
        );
    }
    var Matchˉseen: bytes = Matchˉseenˉresult.Value;
    let Matchˉbodyˉposition: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
        Source, Statement.Offset, Statement.Line, Statement.Column,
        Statement.Firstˉblockˉoffset
    );
    let Matchˉbody: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉbodies.Compilerˉbodyˉtoken(
        Source,
        Statement.Firstˉblockˉoffset,
        Matchˉbodyˉposition.Line,
        Matchˉbodyˉposition.Column,
        Statement.Firstˉblockˉoffset + Statement.Firstˉblockˉlength
    );
    var Matchˉcursor: u32 = Matchˉbody.Nextˉoffset;
    var Matchˉline: u32 = Matchˉbody.Nextˉline;
    var Matchˉcolumn: u32 = Matchˉbody.Nextˉcolumn;
    var Matchˉcaseˉindex: u32 = 0u32;
    while Matchˉcaseˉindex < Statement.Nameˉlength {
        let Case: Sourceˉbodies.Compilerˉsourceˉmatchˉcase = Sourceˉbodies.Compilerˉbodyˉparseˉmatchˉcase(
            Source,
            Matchˉcursor,
            Matchˉline,
            Matchˉcolumn,
            Statement.Firstˉblockˉoffset + Statement.Firstˉblockˉlength,
            0u32
        );
        let Caseˉnominal: Sourceˉsymbols.Compilerˉsourceˉsymbolˉmatch = Sourceˉsymbols.Compilerˉsourceˉsymbolsˉfindˉownedˉnominal(
            Input, Scan, Symbols.Directory, Symbols.Lookup,
            Result.Currentˉmodule,
            Source, Case.Enumˉoffset, Case.Enumˉlength
        );
        var Sameˉnominal: bool = Caseˉnominal.Found;
        if Sameˉnominal {
            Sameˉnominal = Caseˉnominal.Kind == Matchˉnominal.Kind;
        }
        if Sameˉnominal {
            Sameˉnominal = Caseˉnominal.Directoryˉindex == Matchˉnominal.Directoryˉindex;
        }
        if Sameˉnominal {
            Sameˉnominal = Sourceˉsymbols.Compilerˉsourceˉsymbolsˉownedˉmatchˉisˉaccessible(
                Input, Scan, Symbols.Visibility, Symbols.Lookup,
                Result.Currentˉmodule, Source,
                Case.Enumˉoffset, Case.Enumˉlength, Caseˉnominal
            );
        }
        if !Sameˉnominal {
            let Caseˉenumˉposition: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
                Source, Matchˉcursor, Matchˉline, Matchˉcolumn,
                Case.Enumˉoffset
            );
            var Matchˉmismatchˉstatus: Compilerˉsourceˉwirˉstatus =
                Compilerˉsourceˉwirˉstatus.Matchˉenumˉmismatch;
            if Matchˉisˉvariant {
                Matchˉmismatchˉstatus = Compilerˉsourceˉwirˉstatus.Matchˉvariantˉmismatch;
            }
            return Compilerˉsourceˉwirˉfusedˉfrom(
                Compilerˉsourceˉwirˉbuildˉfailure(
                    Compilerˉsourceˉwirˉvalueˉbuild(Matchˉvalue),
                    Matchˉmismatchˉstatus,
                    Result.Currentˉmodule, Caseˉnominal.Module, Result.Currentˉfunction,
                    Case.Enumˉoffset,
                    Caseˉenumˉposition.Line,
                    Caseˉenumˉposition.Column
                ),
                Bindingˉphase
            );
        }
        let Caseˉmember: Compilerˉsourceˉwirˉmember = Compilerˉsourceˉwirˉnominalˉmember(
            Input, Scan, Symbols, Matchˉnominal,
            Source, Case.Memberˉoffset, Case.Memberˉlength
        );
        let Caseˉmemberˉposition: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
            Source, Matchˉcursor, Matchˉline, Matchˉcolumn,
            Case.Memberˉoffset
        );
        if !Caseˉmember.Found {
            var Unknownˉmemberˉstatus: Compilerˉsourceˉwirˉstatus =
                Compilerˉsourceˉwirˉstatus.Unknownˉenumˉmember;
            if Matchˉisˉvariant {
                Unknownˉmemberˉstatus = Compilerˉsourceˉwirˉstatus.Unknownˉvariantˉcase;
            }
            return Compilerˉsourceˉwirˉfusedˉfrom(
                Compilerˉsourceˉwirˉbuildˉfailure(
                    Compilerˉsourceˉwirˉvalueˉbuild(Matchˉvalue),
                    Unknownˉmemberˉstatus,
                    Result.Currentˉmodule, Matchˉnominal.Module, Result.Currentˉfunction,
                    Case.Memberˉoffset,
                    Caseˉmemberˉposition.Line,
                    Caseˉmemberˉposition.Column
                ),
                Bindingˉphase
            );
        }
        var Bindingˉisˉvalid: bool = Case.Bindingˉlength == 0u32;
        if Matchˉisˉvariant {
            Bindingˉisˉvalid = Caseˉmember.Shape == 0u32;
            if Caseˉmember.Shape != 0u32 {
                Bindingˉisˉvalid = Case.Bindingˉlength > 0u32;
            }
        }
        if !Bindingˉisˉvalid {
            var Bindingˉfailureˉoffset: u32 = Case.Memberˉoffset;
            if Case.Bindingˉlength > 0u32 {
                Bindingˉfailureˉoffset = Case.Bindingˉoffset;
            }
            let Bindingˉfailureˉposition: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
                Source, Matchˉcursor, Matchˉline, Matchˉcolumn,
                Bindingˉfailureˉoffset
            );
            return Compilerˉsourceˉwirˉfusedˉfrom(
                Compilerˉsourceˉwirˉbuildˉfailure(
                    Compilerˉsourceˉwirˉvalueˉbuild(Matchˉvalue),
                    Compilerˉsourceˉwirˉstatus.Invalidˉvariantˉbinding,
                    Result.Currentˉmodule, Matchˉnominal.Module, Result.Currentˉfunction,
                    Bindingˉfailureˉoffset,
                    Bindingˉfailureˉposition.Line,
                    Bindingˉfailureˉposition.Column
                ),
                Bindingˉphase
            );
        }
        if Bytesˉreadˉu8(Matchˉseen, Caseˉmember.Index) != 0u8 {
            return Compilerˉsourceˉwirˉfusedˉfrom(
                Compilerˉsourceˉwirˉbuildˉfailure(
                    Compilerˉsourceˉwirˉvalueˉbuild(Matchˉvalue),
                    Compilerˉsourceˉwirˉstatus.Duplicateˉmatchˉcase,
                    Result.Currentˉmodule, Matchˉnominal.Module, Result.Currentˉfunction,
                    Case.Memberˉoffset,
                    Caseˉmemberˉposition.Line,
                    Caseˉmemberˉposition.Column
                ),
                Bindingˉphase
            );
        }
        let Updatedˉseen: Byteˉconstruction.Foundationˉbytesˉresult = Byteˉconstruction.Foundationˉbytesˉreplace(
            Matchˉseen,
            Caseˉmember.Index,
            1u32,
            Bytesˉfromˉu8(1u8)
        );
        if !Updatedˉseen.Valid {
            return Compilerˉsourceˉwirˉfusedˉfrom(
                Compilerˉsourceˉwirˉbuildˉfailure(
                    Compilerˉsourceˉwirˉvalueˉbuild(Matchˉvalue),
                    Compilerˉsourceˉwirˉstatus.Invalidˉdirectory,
                    Result.Currentˉmodule, Matchˉnominal.Module, Result.Currentˉfunction,
                    Case.Memberˉoffset,
                    Caseˉmemberˉposition.Line,
                    Caseˉmemberˉposition.Column
                ),
                Bindingˉphase
            );
        }
        Matchˉseen = Updatedˉseen.Value;
        Matchˉcursor = Case.Nextˉoffset;
        Matchˉline = Case.Nextˉline;
        Matchˉcolumn = Case.Nextˉcolumn;
        Matchˉcaseˉindex = Matchˉcaseˉindex + 1u32;
    }
    var Matchˉbodies: Compilerˉsourceˉwirˉbuild = Compilerˉsourceˉwirˉvalueˉbuild(Matchˉvalue);
    let Matchˉcaseˉblocks: u32 = Matchˉbodies.Nextˉblock;
    Matchˉcursor = Matchˉbody.Nextˉoffset;
    Matchˉline = Matchˉbody.Nextˉline;
    Matchˉcolumn = Matchˉbody.Nextˉcolumn;
    Matchˉcaseˉindex = 0u32;
    while Matchˉcaseˉindex < Statement.Nameˉlength {
        let Bodyˉcase: Sourceˉbodies.Compilerˉsourceˉmatchˉcase = Sourceˉbodies.Compilerˉbodyˉparseˉmatchˉcase(
            Source,
            Matchˉcursor,
            Matchˉline,
            Matchˉcolumn,
            Statement.Firstˉblockˉoffset + Statement.Firstˉblockˉlength,
            0u32
        );
        let Bodyˉmember: Compilerˉsourceˉwirˉmember = Compilerˉsourceˉwirˉnominalˉmember(
            Input, Scan, Symbols, Matchˉnominal,
            Source, Bodyˉcase.Memberˉoffset, Bodyˉcase.Memberˉlength
        );
        let Bodyˉcaseˉblock: u32 = Matchˉbodies.Nextˉblock;
        Matchˉbodies = Compilerˉsourceˉwirˉreserveˉblocks(Matchˉbodies, 1u32);
        var Nextˉtestˉblock: u32 = Compilerˉsourceˉwirˉsentinel();
        if Matchˉcaseˉindex + 1u32 == Statement.Nameˉlength {
            Matchˉbodies = Compilerˉsourceˉwirˉcloseˉcurrentˉblock(
                Matchˉbodies,
                Compilerˉsourceˉwirˉterminator.Jump,
                Compilerˉsourceˉwirˉsentinel(),
                Bodyˉcaseˉblock,
                Compilerˉsourceˉwirˉsentinel()
            );
        } else {
            var Dispatchˉtemporary: u32 = Compilerˉsourceˉwirˉsentinel();
            if Matchˉisˉvariant {
                let Dispatchˉcase: Compilerˉsourceˉwirˉvalue = Compilerˉsourceˉwirˉemit(
                    Matchˉbodies,
                    Compilerˉsourceˉwirˉoperation.Variantˉisˉcase,
                    4u32,
                    Compilerˉsourceˉwirˉoneˉoperand(Matchˉvalue.Temporary),
                    Matchˉvalue.Shape - 196608u32,
                    Bodyˉmember.Index,
                    Bodyˉcase.Memberˉoffset,
                    Bodyˉcase.Memberˉlength
                );
                Matchˉbodies = Compilerˉsourceˉwirˉvalueˉbuild(Dispatchˉcase);
                Dispatchˉtemporary = Dispatchˉcase.Temporary;
            } else {
                let Dispatchˉconstant: Compilerˉsourceˉwirˉvalue = Compilerˉsourceˉwirˉemit(
                    Matchˉbodies,
                    Compilerˉsourceˉwirˉoperation.Enumˉconstant,
                    Matchˉvalue.Shape,
                    Compilerˉsourceˉwirˉempty(Source),
                    Matchˉvalue.Shape - 131072u32,
                    Bodyˉmember.Index,
                    Bodyˉcase.Memberˉoffset,
                    Bodyˉcase.Memberˉlength
                );
                let Dispatchˉequal: Compilerˉsourceˉwirˉvalue = Compilerˉsourceˉwirˉemit(
                    Compilerˉsourceˉwirˉvalueˉbuild(Dispatchˉconstant),
                    Compilerˉsourceˉwirˉoperation.Enumˉequal,
                    4u32,
                    Compilerˉsourceˉwirˉtwoˉoperands(
                        Matchˉvalue.Temporary,
                        Dispatchˉconstant.Temporary
                    ),
                    0u32,
                    0u32,
                    Bodyˉcase.Memberˉoffset,
                    Bodyˉcase.Memberˉlength
                );
                Matchˉbodies = Compilerˉsourceˉwirˉvalueˉbuild(Dispatchˉequal);
                Dispatchˉtemporary = Dispatchˉequal.Temporary;
            }
            Nextˉtestˉblock = Matchˉbodies.Nextˉblock;
            Matchˉbodies = Compilerˉsourceˉwirˉreserveˉblocks(Matchˉbodies, 1u32);
            Matchˉbodies = Compilerˉsourceˉwirˉcloseˉcurrentˉblock(
                Matchˉbodies,
                Compilerˉsourceˉwirˉterminator.Branch,
                Dispatchˉtemporary,
                Bodyˉcaseˉblock,
                Nextˉtestˉblock
            );
        }
        let Bodyˉcaseˉposition: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
            Source, Matchˉcursor, Matchˉline, Matchˉcolumn,
            Bodyˉcase.Blockˉoffset
        );
        let Caseˉbinding: Sourceˉbindings.Compilerˉsourceˉbindingˉbuild =
            Sourceˉbindings.Compilerˉsourceˉbindingsˉcollectˉmatchˉbinding(
                Input, Scan, Symbols,
                Result.Currentˉmodule, Result.Currentˉfunction,
                Source, Bodyˉcase,
                Sourceˉbindings.Compilerˉsourceˉbindingsˉphaseˉbuildˉvalue(Bindingˉphase)
            );
        Bindingˉphase = Sourceˉbindings.Compilerˉsourceˉbindingsˉphaseˉbuild(
            Bindingˉphase, Caseˉbinding
        );
        if Bindingˉphase.Buildˉstatus != Sourceˉbindings.Compilerˉsourceˉbindingˉstatus.Valid {
            return Compilerˉsourceˉwirˉbuildˉfailure(
                Matchˉbodies,
                Compilerˉsourceˉwirˉstatus.Sourceˉbindings,
                Bindingˉphase.Buildˉfailureˉmodule,
                Bindingˉphase.Buildˉfailureˉrelatedˉmodule,
                Bindingˉphase.Buildˉfailureˉfunction,
                Bindingˉphase.Buildˉfailureˉoffset,
                Bindingˉphase.Buildˉfailureˉline,
                Bindingˉphase.Buildˉfailureˉcolumn
            );
        }
        var Bodyˉcaseˉstart: Compilerˉsourceˉwirˉbuild = Compilerˉsourceˉwirˉbeginˉreservedˉblock(
            Matchˉbodies,
            Bodyˉcaseˉblock
        );
        if Matchˉisˉvariant {
            if Bodyˉmember.Shape != 0u32 {
                let Caseˉbindings: Sourceˉbindings.Compilerˉsourceˉbindingˉbuild =
                    Sourceˉbindings.Compilerˉsourceˉbindingsˉphaseˉbuildˉvalue(Bindingˉphase);
                let Payloadˉbinding: Sourceˉbindings.Compilerˉsourceˉlocalˉmatch =
                    Sourceˉbindings.Compilerˉsourceˉbindingsˉfindˉlocal(
                        Source, Caseˉbindings.Payload,
                        Caseˉbindings.Entries - Caseˉbindings.Nextˉslot,
                        Caseˉbindings.Entries,
                        Bodyˉcase.Bindingˉoffset, Bodyˉcase.Bindingˉlength,
                        Bodyˉcase.Blockˉoffset
                    );
                if !Payloadˉbinding.Found {
                    return Compilerˉsourceˉwirˉbuildˉfailure(
                        Bodyˉcaseˉstart,
                        Compilerˉsourceˉwirˉstatus.Invalidˉvariantˉbinding,
                        Result.Currentˉmodule, Matchˉnominal.Module, Result.Currentˉfunction,
                        Bodyˉcase.Bindingˉoffset,
                        Bodyˉcaseˉposition.Line,
                        Bodyˉcaseˉposition.Column
                    );
                }
                let Payloadˉvalue: Compilerˉsourceˉwirˉvalue = Compilerˉsourceˉwirˉemit(
                    Bodyˉcaseˉstart,
                    Compilerˉsourceˉwirˉoperation.Variantˉpayload,
                    Bodyˉmember.Shape,
                    Compilerˉsourceˉwirˉoneˉoperand(Matchˉvalue.Temporary),
                    Matchˉvalue.Shape - 196608u32,
                    Bodyˉmember.Index,
                    Bodyˉcase.Memberˉoffset,
                    Bodyˉcase.Memberˉlength
                );
                let Payloadˉstored: Compilerˉsourceˉwirˉvalue = Compilerˉsourceˉwirˉemit(
                    Compilerˉsourceˉwirˉvalueˉbuild(Payloadˉvalue),
                    Compilerˉsourceˉwirˉoperation.Storeˉlocal,
                    0u32,
                    Compilerˉsourceˉwirˉoneˉoperand(Payloadˉvalue.Temporary),
                    Payloadˉbinding.Slot,
                    0u32,
                    Bodyˉcase.Bindingˉoffset,
                    Bodyˉcase.Bindingˉlength
                );
                Bodyˉcaseˉstart = Compilerˉsourceˉwirˉvalueˉbuild(Payloadˉstored);
            }
        }
        let Bodyˉcaseˉresult: Compilerˉsourceˉwirˉbuild = Compilerˉsourceˉwirˉcompileˉblock(
            Input, Scan, Symbols,
            Bindingˉphase,
            Source,
            Bodyˉcase.Blockˉoffset,
            Bodyˉcaseˉposition.Line,
            Bodyˉcaseˉposition.Column,
            Bodyˉcase.Blockˉoffset + Bodyˉcase.Blockˉlength,
            Returnˉshape,
            Continueˉtarget,
            Breakˉtarget,
            Bodyˉcaseˉstart
        );
        if Bodyˉcaseˉresult.Status != Compilerˉsourceˉwirˉstatus.Valid {
            return Bodyˉcaseˉresult;
        }
        Bindingˉphase = Compilerˉsourceˉwirˉbuildˉbindings(Input, Bodyˉcaseˉresult);
        Matchˉbodies = Bodyˉcaseˉresult;
        if Matchˉbodies.Hasˉcurrentˉblock {
            Matchˉbodies = Compilerˉsourceˉwirˉcloseˉcurrentˉblock(
                Matchˉbodies,
                Compilerˉsourceˉwirˉterminator.Jump,
                Compilerˉsourceˉwirˉsentinel(),
                Compilerˉsourceˉwirˉsentinel(),
                Compilerˉsourceˉwirˉsentinel()
            );
        }
        Matchˉbodies = Compilerˉsourceˉwirˉwithoutˉcurrentˉblock(Matchˉbodies);
        if Matchˉcaseˉindex + 1u32 < Statement.Nameˉlength {
            Matchˉbodies = Compilerˉsourceˉwirˉbeginˉreservedˉblock(
                Matchˉbodies, Nextˉtestˉblock
            );
        }
        Matchˉcursor = Bodyˉcase.Nextˉoffset;
        Matchˉline = Bodyˉcase.Nextˉline;
        Matchˉcolumn = Bodyˉcase.Nextˉcolumn;
        Matchˉcaseˉindex = Matchˉcaseˉindex + 1u32;
    }
    var Matchˉfallthroughs: u32 = 0u32;
    var Matchˉblockˉindex: u32 = Matchˉcaseˉblocks;
    while Matchˉblockˉindex < Matchˉbodies.Nextˉblock {
        let Matchˉblockˉoffset: u32 = Matchˉblockˉindex * 36u32;
        if Bytesˉreadˉu32ˉlittle(Matchˉbodies.Blockˉpayload, Matchˉblockˉoffset + 20u32) == 1u32 {
            if Bytesˉreadˉu32ˉlittle(Matchˉbodies.Blockˉpayload, Matchˉblockˉoffset + 28u32) == Compilerˉsourceˉwirˉsentinel() {
                Matchˉfallthroughs = Matchˉfallthroughs + 1u32;
            }
        }
        Matchˉblockˉindex = Matchˉblockˉindex + 1u32;
    }
    Result = Compilerˉsourceˉwirˉwithoutˉcurrentˉblock(Matchˉbodies);
    if Matchˉfallthroughs > 0u32 {
        let Matchˉjoin: u32 = Result.Nextˉblock;
        Result = Compilerˉsourceˉwirˉreserveˉblocks(Result, 1u32);
        Matchˉblockˉindex = Matchˉcaseˉblocks;
        while Matchˉblockˉindex < Matchˉjoin {
            let Matchˉpatchedˉblockˉoffset: u32 = Matchˉblockˉindex * 36u32;
            if Bytesˉreadˉu32ˉlittle(Result.Blockˉpayload, Matchˉpatchedˉblockˉoffset + 20u32) == 1u32 {
                if Bytesˉreadˉu32ˉlittle(Result.Blockˉpayload, Matchˉpatchedˉblockˉoffset + 28u32) == Compilerˉsourceˉwirˉsentinel() {
                    Result = Compilerˉsourceˉwirˉappendˉblock(
                        Result,
                        Matchˉblockˉindex,
                        Bytesˉreadˉu32ˉlittle(Result.Blockˉpayload, Matchˉpatchedˉblockˉoffset + 12u32),
                        Bytesˉreadˉu32ˉlittle(Result.Blockˉpayload, Matchˉpatchedˉblockˉoffset + 16u32),
                        Compilerˉsourceˉwirˉterminator.Jump,
                        Compilerˉsourceˉwirˉsentinel(),
                        Matchˉjoin,
                        Compilerˉsourceˉwirˉsentinel()
                    );
                }
            }
            Matchˉblockˉindex = Matchˉblockˉindex + 1u32;
        }
        Result = Compilerˉsourceˉwirˉbeginˉreservedˉblock(Result, Matchˉjoin);
    }
    Result = Compilerˉsourceˉwirˉfusedˉfrom(Result, Bindingˉphase);
    return Compilerˉsourceˉwirˉfusedˉfrom(Result, Bindingˉphase);
}

export fn Compilerˉsourceˉwirˉcompileˉblock(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Bindings: Sourceˉbindings.Compilerˉsourceˉbindingˉphase,
    Source: bytes,
    Offset: u32,
    Line: u32,
    Column: u32,
    Endˉoffset: u32,
    Returnˉshape: u32,
    Continueˉtarget: u32,
    Breakˉtarget: u32,
    Build: Compilerˉsourceˉwirˉbuild
) -> Compilerˉsourceˉwirˉbuild {
    let Start: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉbodies.Compilerˉbodyˉtoken(
        Source, Offset, Line, Column, Endˉoffset
    );
    let Isˉblock: bool = Start.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Leftˉbrace;
    var Cursor: u32 = Start.Offset;
    var Currentˉline: u32 = Start.Line;
    var Currentˉcolumn: u32 = Start.Column;
    if Isˉblock {
        Cursor = Start.Nextˉoffset;
        Currentˉline = Start.Nextˉline;
        Currentˉcolumn = Start.Nextˉcolumn;
    }
    var Result: Compilerˉsourceˉwirˉbuild =
        Compilerˉsourceˉwirˉfusedˉfrom(Build, Bindings);
    var Bindingˉphase: Sourceˉbindings.Compilerˉsourceˉbindingˉphase = Bindings;
    var Reading: bool = true;
    while Reading {
        let Current: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉbodies.Compilerˉbodyˉtoken(
            Source, Cursor, Currentˉline, Currentˉcolumn, Endˉoffset
        );
        if Isˉblock {
            if Current.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Rightˉbrace {
                Reading = false;
            }
        }
        if Reading {
            if !Result.Hasˉcurrentˉblock {
                return Compilerˉsourceˉwirˉfusedˉfrom(
                    Compilerˉsourceˉwirˉbuildˉfailure(
                        Result,
                        Compilerˉsourceˉwirˉstatus.Unreachableˉstatement,
                        Result.Currentˉmodule,
                        Result.Currentˉmodule,
                        Result.Currentˉfunction,
                        Current.Offset,
                        Current.Line,
                        Current.Column
                    ),
                    Bindingˉphase
                );
            }
            let Statement: Sourceˉbodies.Compilerˉsourceˉstatement = Sourceˉbodies.Compilerˉparseˉnextˉstatementˉvalidated(
                Source, Cursor, Currentˉline, Currentˉcolumn, Endˉoffset, 0u32
            );
            let Bindingˉbuild: Sourceˉbindings.Compilerˉsourceˉbindingˉbuild =
                Sourceˉbindings.Compilerˉsourceˉbindingsˉphaseˉbuildˉvalue(Bindingˉphase);
            let Bindingˉpayload: bytes = Bindingˉbuild.Payload;
            let Bindingˉfirst: u32 = Bindingˉbuild.Entries - Bindingˉbuild.Nextˉslot;
            let Bindingˉentries: u32 = Bindingˉbuild.Entries;
            if Statement.Kind == Sourceˉbodies.Compilerˉsourceˉstatementˉkind.Local {
                let Localˉposition: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
                    Source, Statement.Offset, Statement.Line, Statement.Column,
                    Statement.Expressionˉoffset
                );
                let Localˉvalue: Compilerˉsourceˉwirˉvalue = Compilerˉsourceˉwirˉcompileˉexpression(
                    Input, Scan, Symbols,
                    Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
                    Source,
                    Statement.Expressionˉoffset, Localˉposition.Line, Localˉposition.Column,
                    Statement.Expressionˉoffset + Statement.Expressionˉlength,
                    Result
                );
                if Localˉvalue.Status != Compilerˉsourceˉwirˉstatus.Valid {
                    return Compilerˉsourceˉwirˉfusedˉfrom(
                        Compilerˉsourceˉwirˉvalueˉbuild(Localˉvalue), Bindingˉphase
                    );
                }
                if Compilerˉsourceˉwirˉshapeˉisˉbuilder(Localˉvalue.Shape) && !Statement.Isˉmutable {
                    return Compilerˉsourceˉwirˉfusedˉfrom(
                        Compilerˉsourceˉwirˉbuildˉfailure(
                            Compilerˉsourceˉwirˉvalueˉbuild(Localˉvalue),
                            Compilerˉsourceˉwirˉstatus.Invalidˉbuilder,
                            Result.Currentˉmodule, Result.Currentˉmodule, Result.Currentˉfunction,
                            Statement.Offset, Statement.Line, Statement.Column
                        ), Bindingˉphase
                    );
                }
                if Statement.Typeˉkind == Sourceˉdeclarations.Compilerˉsourceˉtypeˉkind.Unknown {
                    if Localˉvalue.Shape == 0u32 {
                        return Compilerˉsourceˉwirˉfusedˉfrom(
                            Compilerˉsourceˉwirˉbuildˉfailure(
                                Compilerˉsourceˉwirˉvalueˉbuild(Localˉvalue),
                                Compilerˉsourceˉwirˉstatus.Invalidˉinference,
                                Result.Currentˉmodule, Result.Currentˉmodule,
                                Result.Currentˉfunction,
                                Statement.Expressionˉoffset,
                                Localˉposition.Line,
                                Localˉposition.Column
                            ),
                            Bindingˉphase
                        );
                    }
                }
                Bindingˉphase = Sourceˉbindings.Compilerˉsourceˉbindingsˉphaseˉbuild(
                    Bindingˉphase,
                    Sourceˉbindings.Compilerˉsourceˉbindingsˉcollectˉlocal(
                        Input, Scan, Symbols,
                        Result.Currentˉmodule, Result.Currentˉfunction,
                        Source, Statement, Endˉoffset, Localˉvalue.Shape,
                        Bindingˉbuild
                    )
                );
                if Bindingˉphase.Buildˉstatus != Sourceˉbindings.Compilerˉsourceˉbindingˉstatus.Valid {
                    return Compilerˉsourceˉwirˉbuildˉfailure(
                        Compilerˉsourceˉwirˉvalueˉbuild(Localˉvalue),
                        Compilerˉsourceˉwirˉstatus.Sourceˉbindings,
                        Bindingˉphase.Buildˉfailureˉmodule,
                        Bindingˉphase.Buildˉfailureˉrelatedˉmodule,
                        Bindingˉphase.Buildˉfailureˉfunction,
                        Bindingˉphase.Buildˉfailureˉoffset,
                        Bindingˉphase.Buildˉfailureˉline,
                        Bindingˉphase.Buildˉfailureˉcolumn
                    );
                }
                let Localˉbindings: Sourceˉbindings.Compilerˉsourceˉbindingˉbuild =
                    Sourceˉbindings.Compilerˉsourceˉbindingsˉphaseˉbuildˉvalue(Bindingˉphase);
                let Localˉbinding: Sourceˉbindings.Compilerˉsourceˉlocalˉmatch = Sourceˉbindings.Compilerˉsourceˉbindingsˉfindˉlocal(
                    Source, Localˉbindings.Payload,
                    Localˉbindings.Entries - Localˉbindings.Nextˉslot,
                    Localˉbindings.Entries,
                    Statement.Nameˉoffset, Statement.Nameˉlength, Statement.Nextˉoffset
                );
                if Localˉvalue.Shape != Localˉbinding.Shape {
                    return Compilerˉsourceˉwirˉfusedˉfrom(
                        Compilerˉsourceˉwirˉbuildˉfailure(
                            Compilerˉsourceˉwirˉvalueˉbuild(Localˉvalue),
                            Compilerˉsourceˉwirˉstatus.Typeˉmismatch,
                            Result.Currentˉmodule, Result.Currentˉmodule, Result.Currentˉfunction,
                            Statement.Expressionˉoffset, Localˉposition.Line, Localˉposition.Column
                        ),
                        Bindingˉphase
                    );
                }
                let Localˉstored: Compilerˉsourceˉwirˉvalue = Compilerˉsourceˉwirˉemit(
                    Compilerˉsourceˉwirˉvalueˉbuild(Localˉvalue),
                    Compilerˉsourceˉwirˉoperation.Storeˉlocal,
                    0u32,
                    Compilerˉsourceˉwirˉoneˉoperand(Localˉvalue.Temporary),
                    Localˉbinding.Slot, 0u32,
                    Statement.Offset, Statement.Length
                );
                Result = Compilerˉsourceˉwirˉfusedˉfrom(
                    Compilerˉsourceˉwirˉvalueˉbuild(Localˉstored), Bindingˉphase
                );
            }
            if Statement.Kind == Sourceˉbodies.Compilerˉsourceˉstatementˉkind.Assignment {
                let Assignmentˉbinding: Sourceˉbindings.Compilerˉsourceˉlocalˉmatch = Sourceˉbindings.Compilerˉsourceˉbindingsˉfindˉlocal(
                    Source, Bindingˉpayload, Bindingˉfirst, Bindingˉentries,
                    Statement.Nameˉoffset, Statement.Nameˉlength, Statement.Offset
                );
                if !Assignmentˉbinding.Found {
                    return Compilerˉsourceˉwirˉfusedˉfrom(
                        Compilerˉsourceˉwirˉbuildˉfailure(
                            Result,
                            Compilerˉsourceˉwirˉstatus.Typeˉmismatch,
                            Result.Currentˉmodule, Result.Currentˉmodule, Result.Currentˉfunction,
                            Statement.Offset, Statement.Line, Statement.Column
                        ),
                        Bindingˉphase
                    );
                }
                if Assignmentˉbinding.Kind != Sourceˉbindings.Compilerˉsourceˉbindingˉkind.Var {
                    return Compilerˉsourceˉwirˉfusedˉfrom(
                        Compilerˉsourceˉwirˉbuildˉfailure(
