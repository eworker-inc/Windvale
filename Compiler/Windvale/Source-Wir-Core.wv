) -> u32 {
    return Functionˉtypes.Compilerˉsourceˉfunctionˉtypeˉlanguageˉeffects(
        Compilerˉsourceˉwirˉcanonicalˉfunctionˉtypeˉcatalog(Catalog),
        Instance
    );
}

fn Compilerˉsourceˉwirˉfunctionˉtypeˉcapabilityˉeffects(
    Catalog: Compilerˉsourceˉwirˉfunctionˉtypeˉcatalog,
    Instance: u32
) -> u32 {
    return Functionˉtypes.Compilerˉsourceˉfunctionˉtypeˉcapabilityˉeffects(
        Compilerˉsourceˉwirˉcanonicalˉfunctionˉtypeˉcatalog(Catalog),
        Instance
    );
}

fn Compilerˉsourceˉwirˉfunctionˉtypeˉparameters(
    Catalog: Compilerˉsourceˉwirˉfunctionˉtypeˉcatalog,
    Instance: u32
) -> u32 {
    return Functionˉtypes.Compilerˉsourceˉfunctionˉtypeˉparameters(
        Compilerˉsourceˉwirˉcanonicalˉfunctionˉtypeˉcatalog(Catalog),
        Instance
    );
}

fn Compilerˉsourceˉwirˉfunctionˉtypeˉparameterˉshape(
    Catalog: Compilerˉsourceˉwirˉfunctionˉtypeˉcatalog,
    Instance: u32,
    Parameter: u32
) -> u32 {
    return Functionˉtypes.Compilerˉsourceˉfunctionˉtypeˉparameterˉshape(
        Compilerˉsourceˉwirˉcanonicalˉfunctionˉtypeˉcatalog(Catalog),
        Instance, Parameter
    );
}

fn Compilerˉsourceˉwirˉfunctionˉtypeˉparameterˉmode(
    Catalog: Compilerˉsourceˉwirˉfunctionˉtypeˉcatalog,
    Instance: u32,
    Parameter: u32
) -> u32 {
    return Functionˉtypes.Compilerˉsourceˉfunctionˉtypeˉparameterˉmode(
        Compilerˉsourceˉwirˉcanonicalˉfunctionˉtypeˉcatalog(Catalog),
        Instance, Parameter
    );
}

fn Compilerˉsourceˉwirˉgenericˉevidenceˉisˉcombined(
    Evidence: bytes
) -> bool {
    let Length: u32 = Bytesˉlength(Evidence);
    if Length < 16u32 { return false; }
    if Bytesˉreadˉu8(Evidence, 0u32) != 87u8 ||
        Bytesˉreadˉu8(Evidence, 1u32) != 86u8 ||
        Bytesˉreadˉu8(Evidence, 2u32) != 71u8 ||
        Bytesˉreadˉu8(Evidence, 3u32) != 73u8 ||
        Bytesˉreadˉu16ˉlittle(Evidence, 4u32) != 1u32 ||
        Bytesˉreadˉu16ˉlittle(Evidence, 6u32) != 0u32 {
        return false;
    }
    let Functionˉbytes: u32 = Bytesˉreadˉu32ˉlittle(Evidence, 8u32);
    let Typeˉbytes: u32 = Bytesˉreadˉu32ˉlittle(Evidence, 12u32);
    if Functionˉbytes > 1048576u32 || Typeˉbytes > 1048576u32 ||
        Functionˉbytes > Length - 16u32 {
        return false;
    }
    if Typeˉbytes > Length - 16u32 - Functionˉbytes { return false; }
    let Baseˉbytes: u32 = 16u32 + Functionˉbytes + Typeˉbytes;
    if Baseˉbytes == Length { return true; }
    let Functionˉtypes: Compilerˉsourceˉwirˉfunctionˉtypeˉcatalog =
        Compilerˉsourceˉwirˉfunctionˉtypeˉcatalog(
            Bytesˉslice(Evidence, Baseˉbytes, Length - Baseˉbytes)
        );
    return Compilerˉsourceˉwirˉfunctionˉtypeˉcatalogˉisˉvalid(
            Functionˉtypes
        ) &&
        Compilerˉsourceˉwirˉfunctionˉtypeˉcatalogˉinstances(
            Functionˉtypes
        ) > 0u32;
}

fn Compilerˉsourceˉwirˉgenericˉcatalog(
    Evidence: bytes
) -> Sourceˉgenerics.Compilerˉsourceˉgenericˉcatalog {
    if Compilerˉsourceˉwirˉgenericˉevidenceˉisˉcombined(Evidence) {
        let Functionˉbytes: u32 = Bytesˉreadˉu32ˉlittle(Evidence, 8u32);
        return Sourceˉgenerics.Compilerˉsourceˉgenericˉcatalog(
            Sourceˉgenerics.Compilerˉsourceˉgenericˉstatus.Valid,
            Bytesˉslice(Evidence, 16u32, Functionˉbytes)
        );
    }
    return Sourceˉgenerics.Compilerˉsourceˉgenericˉcatalog(
        Sourceˉgenerics.Compilerˉsourceˉgenericˉstatus.Valid,
        Evidence
    );
}

fn Compilerˉsourceˉwirˉgenericˉtypeˉcatalog(
    Evidence: bytes
) -> Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog {
    if !Compilerˉsourceˉwirˉgenericˉevidenceˉisˉcombined(Evidence) {
        return Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalogˉempty();
    }
    let Functionˉbytes: u32 = Bytesˉreadˉu32ˉlittle(Evidence, 8u32);
    let Typeˉbytes: u32 = Bytesˉreadˉu32ˉlittle(Evidence, 12u32);
    return Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog(
        Sourceˉgenerics.Compilerˉsourceˉgenericˉstatus.Valid,
        Bytesˉslice(Evidence, 16u32 + Functionˉbytes, Typeˉbytes)
    );
}

fn Compilerˉsourceˉwirˉfunctionˉtypeˉcatalogˉfromˉgeneric(
    Evidence: bytes
) -> Compilerˉsourceˉwirˉfunctionˉtypeˉcatalog {
    let Empty: Compilerˉsourceˉwirˉfunctionˉtypeˉcatalog =
        Compilerˉsourceˉwirˉfunctionˉtypeˉcatalogˉempty();
    if !Compilerˉsourceˉwirˉgenericˉevidenceˉisˉcombined(Evidence) {
        return Empty;
    }
    let Baseˉbytes: u32 = 16u32 +
        Bytesˉreadˉu32ˉlittle(Evidence, 8u32) +
        Bytesˉreadˉu32ˉlittle(Evidence, 12u32);
    if Baseˉbytes == Bytesˉlength(Evidence) { return Empty; }
    return Compilerˉsourceˉwirˉfunctionˉtypeˉcatalog(
        Bytesˉslice(
            Evidence, Baseˉbytes, Bytesˉlength(Evidence) - Baseˉbytes
        )
    );
}

fn Compilerˉsourceˉwirˉcombinedˉgenericˉevidence(
    Functionˉcatalog: Sourceˉgenerics.Compilerˉsourceˉgenericˉcatalog,
    Typeˉcatalog: Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog,
    Functionˉtypes: Compilerˉsourceˉwirˉfunctionˉtypeˉcatalog
) -> bytes {
    let Typeˉinstances: u32 =
        Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalogˉinstances(
            Typeˉcatalog
        );
    let Functionˉtypeˉinstances: u32 =
        Compilerˉsourceˉwirˉfunctionˉtypeˉcatalogˉinstances(
            Functionˉtypes
        );
    if Typeˉinstances == 0u32 && Functionˉtypeˉinstances == 0u32 {
        return Functionˉcatalog.Evidence;
    }
    var Result: bytes = Textˉtoˉutf8("WVGI");
    Result = Bytesˉconcat(Result, Bytesˉfromˉu16ˉlittle(1u32));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu16ˉlittle(0u32));
    Result = Bytesˉconcat(
        Result, Bytesˉfromˉu32ˉlittle(Bytesˉlength(Functionˉcatalog.Evidence))
    );
    Result = Bytesˉconcat(
        Result, Bytesˉfromˉu32ˉlittle(Bytesˉlength(Typeˉcatalog.Evidence))
    );
    Result = Bytesˉconcat(Result, Functionˉcatalog.Evidence);
    Result = Bytesˉconcat(Result, Typeˉcatalog.Evidence);
    if Functionˉtypeˉinstances > 0u32 {
        Result = Bytesˉconcat(Result, Functionˉtypes.Evidence);
    }
    return Result;
}

fn Compilerˉsourceˉwirˉgenericˉevidence(
    Functionˉcatalog: Sourceˉgenerics.Compilerˉsourceˉgenericˉcatalog,
    Typeˉcatalog: Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog
) -> bytes {
    return Compilerˉsourceˉwirˉcombinedˉgenericˉevidence(
        Functionˉcatalog, Typeˉcatalog,
        Compilerˉsourceˉwirˉfunctionˉtypeˉcatalogˉempty()
    );
}

export fn Compilerˉsourceˉwirˉbuildˉbindings(
    Input: bytes,
    Build: Compilerˉsourceˉwirˉbuild
) -> Sourceˉbindings.Compilerˉsourceˉbindingˉphase {
    let Bindingˉbuild: Sourceˉbindings.Compilerˉsourceˉbindingˉbuild = Sourceˉbindings.Compilerˉsourceˉbindingˉbuild(
        Sourceˉbindings.Compilerˉsourceˉbindingˉstatus.Valid,
        Build.Bindingˉpayload,
        Build.Bindingˉentries,
        Build.Bindingˉparameters,
        Build.Bindingˉlocals,
        Build.Bindingˉnextˉslot,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32
    );
    return Sourceˉbindings.Compilerˉsourceˉbindingsˉphaseˉfrom(
        Bindingˉbuild, Sourceˉbindings.Compilerˉsourceˉbindingsˉbodyˉempty()
    );
}

fn Compilerˉsourceˉwirˉwithˉanalysisˉstate(
    Build: Compilerˉsourceˉwirˉbuild,
    Status: Compilerˉsourceˉwirˉstatus,
    Currentˉblock: u32,
    Firstˉoperation: u32,
    Hasˉcurrentˉblock: bool,
    Bindingˉpayload: bytes,
    Bindingˉentries: u32,
    Bindingˉparameters: u32,
    Bindingˉlocals: u32,
    Bindingˉnextˉslot: u32,
    Genericˉevidence: bytes,
    Genericˉinstance: u32,
    Closureˉevidence: bytes,
    Unsafeˉdepth: u32,
    Failureˉmodule: u32,
    Failureˉrelatedˉmodule: u32,
    Failureˉfunction: u32,
    Failureˉoffset: u32,
    Failureˉline: u32,
    Failureˉcolumn: u32
) -> Compilerˉsourceˉwirˉbuild {
    return Compilerˉsourceˉwirˉbuild(
        Status,
        Build.Functionˉpayload, Build.Blockˉpayload, Build.Operationˉpayload,
        Build.Temporaryˉpayload, Build.Operandˉpayload,
        Build.Operationˉpending, Build.Temporaryˉpending,
        Build.Operandˉpending,
        Build.Functionˉentries, Build.Blocks, Build.Operations,
        Build.Temporaries, Build.Operands,
        Build.Currentˉmodule, Build.Currentˉfunction,
        Build.Functionˉfirstˉblock, Build.Functionˉfirstˉoperation,
        Build.Functionˉfirstˉtemporary, Build.Functionˉfirstˉoperand,
        Build.Nextˉblock, Currentˉblock, Firstˉoperation, Hasˉcurrentˉblock,
        Bindingˉpayload, Bindingˉentries, Bindingˉparameters,
        Bindingˉlocals, Bindingˉnextˉslot,
        Genericˉevidence, Genericˉinstance, Closureˉevidence, Unsafeˉdepth,
        Failureˉmodule, Failureˉrelatedˉmodule,
        Failureˉfunction, Failureˉoffset, Failureˉline, Failureˉcolumn
    );
}

export fn Compilerˉsourceˉwirˉfusedˉfrom(
    Build: Compilerˉsourceˉwirˉbuild,
    Bindings: Sourceˉbindings.Compilerˉsourceˉbindingˉphase
) -> Compilerˉsourceˉwirˉbuild {
    return Compilerˉsourceˉwirˉwithˉanalysisˉstate(
        Build,
        Build.Status,
        Build.Currentˉblock,
        Build.Currentˉblockˉfirstˉoperation,
        Build.Hasˉcurrentˉblock,
        Bindings.Payload, Bindings.Entries, Bindings.Parameters,
        Bindings.Locals, Bindings.Nextˉslot,
        Build.Genericˉevidence, Build.Genericˉinstance,
        Build.Closureˉevidence, Build.Unsafeˉdepth,
        Build.Failureˉmodule, Build.Failureˉrelatedˉmodule,
        Build.Failureˉfunction, Build.Failureˉoffset,
        Build.Failureˉline, Build.Failureˉcolumn
    );
}

fn Compilerˉsourceˉwirˉwithˉfunctionˉtypes(
    Build: Compilerˉsourceˉwirˉbuild,
    Evidence: bytes
) -> Compilerˉsourceˉwirˉbuild {
    return Compilerˉsourceˉwirˉwithˉgeneric(
        Build,
        Compilerˉsourceˉwirˉcombinedˉgenericˉevidence(
            Compilerˉsourceˉwirˉgenericˉcatalog(Build.Genericˉevidence),
            Compilerˉsourceˉwirˉgenericˉtypeˉcatalog(
                Build.Genericˉevidence
            ),
            Compilerˉsourceˉwirˉfunctionˉtypeˉcatalog(Evidence)
        ),
        Build.Genericˉinstance
    );
}

fn Compilerˉsourceˉwirˉclosureˉcatalog(
    Build: Compilerˉsourceˉwirˉbuild
) -> Closureˉlowering.Compilerˉsourceˉclosureˉcatalog {
    return Closureˉlowering.Compilerˉsourceˉclosureˉcatalog(
