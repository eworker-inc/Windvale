enum Compilerˉsourceˉwirˉdataˉkind {
    None = 0;
    I32ˉarray = 1;
    Text = 2;
    Bytes = 3;
}

record Compilerˉsourceˉwirˉsignature {
    Parameterˉshape: u32;
    Returnˉshape: u32;
    Target: u32;
    Auxiliary: u32;
    Parameterˉmode: u32;
    Returnˉmode: u32;
}

const WIR_VALUE_CLASS_UNKNOWN: u32 = 0u32;
const WIR_VALUE_CLASS_COPY: u32 = 1u32;
const WIR_VALUE_CLASS_SHARED: u32 = 2u32;
const WIR_VALUE_CLASS_OWNED: u32 = 3u32;

record Compilerˉsourceˉwirˉgenericˉformal {
