fn Empty(Input: bytes) -> bytes { return Bytesˉslice(Input, 0u32, 0u32); }
fn Word(Output: bytes, Value: u32) -> bytes {
    return Bytesˉconcat(Output, Bytesˉfromˉu32ˉlittle(Value));
}
fn Relative(Target: u32, Origin: u32) -> u32 {
    if Target >= Origin { return Target - Origin; }
    return 4294967295u32 - (Origin - Target) + 1u32;
}
fn Patch(Input: bytes, Offset: u32, Value: u32) -> bytes {
    return Bytesˉconcat(Bytesˉconcat(Bytesˉslice(Input, 0u32, Offset),
        Bytesˉfromˉu32ˉlittle(Value)),
        Bytesˉslice(Input, Offset + 4u32, Bytesˉlength(Input) - Offset - 4u32));
}

export fn Helper() -> bytes {
    return Bytesˉconcat(Bytesˉconcat(Valueˉtemplate, Valueˉpadding),
        Nativeˉsha256.Compilerˉnativeˉx64ˉsha256ˉhelper());
}
export fn Helperˉisˉexact(Input: bytes) -> bool {
    if Bytesˉlength(Input) != 12280u32 { return false; }
    var Index: u32 = 0u32;
    while Index < 10636u32 {
        if Bytesˉreadˉu8(Input, Index) != Bytesˉreadˉu8(Valueˉtemplate, Index) { return false; }
        Index = Index + 1u32;
    }
    while Index < 10640u32 {
        if Bytesˉreadˉu8(Input, Index) != 144u8 { return false; }
        Index = Index + 1u32;
    }
    return Nativeˉsha256.Compilerˉnativeˉx64ˉsha256ˉhelperˉisˉexact(
        Bytesˉslice(Input, 10640u32, 1640u32));
}
export fn Helperˉbytes() -> u32 { return 12280u32; }
export fn Entryˉbytes() -> u32 { return 3158u32; }
export fn Entryˉresultˉcloseˉoffset() -> u32 { return 32u32; }
export fn Entryˉresultˉcloseˉbytes() -> u32 { return 17u32; }
export fn Entry(Returnˉtype: u8) -> bytes {
    // Prefix5 is a forward jump to one exact exported entry. Only its body
    // edge may reach generated code; the other body edge ends at the UD2 stub.
    if Returnˉtype == 6u8 {
        return Patch(Entryˉtemplate, 2791u32, Relative(3158u32, 2795u32));
    }
    if Returnˉtype == 1u8 {
        return Patch(Patch(Entryˉtemplate, 1u32, 15u32),
            2839u32, Relative(3158u32, 2843u32));
    }
    return Empty(Entryˉtemplate);
}
export fn Entryˉisˉexact(Code: bytes, Offset: u32, Returnˉtype: u8) -> bool {
    if Returnˉtype != 1u8 && Returnˉtype != 6u8 { return false; }
    if Offset > Bytesˉlength(Code) || Entryˉbytes() > Bytesˉlength(Code) - Offset { return false; }
    let Expected: bytes = Entry(Returnˉtype);
    var Index: u32 = 0u32;
    while Index < Entryˉbytes() {
        if Bytesˉreadˉu8(Code, Offset + Index) != Bytesˉreadˉu8(Expected, Index) { return false; }
        Index = Index + 1u32;
    }
    return true;
}
export fn Entryˉproviderˉrelocations(Codeˉbase: u32) -> bytes {
    return Word(Word(Word(Bytesˉfromˉu32ˉlittle(Codeˉbase + 1395u32),
        4294967294u32), Codeˉbase + 1419u32), 4294967293u32);
}
