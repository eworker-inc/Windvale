#!wv/1 en@1
module Compilerˉnativeˉx64ˉloweringˉvariantˉanalysis;
profile core;
platform linux, windows, windvale;
authority library;


import Compilerˉnativeˉx64ˉloweringˉvalueˉstate as Valueˉstate;
import Compilerˉnativeˉx64ˉloweringˉtypes as Nominalˉtypes;
import Compilerˉnativeˉx64ˉloweringˉrecords as Records;
import Compilerˉnativeˉx64ˉloweringˉvariantˉinstructions as Variantˉinstructions;

fn Analyzeˉcreate(
    Input: bytes,
    Instructionˉoffset: u32,
    Types: Nominalˉtypes.Compilerˉnativeˉx64ˉtypes,
    State: Valueˉstate.State
) -> Valueˉstate.State {
    let Typeˉindex: u32 = Bytesˉreadˉu32ˉlittle(
        Input,
        Instructionˉoffset + 1u32
    );
    let Caseˉindex: u32 = Bytesˉreadˉu32ˉlittle(
        Input,
        Instructionˉoffset + 5u32
    );
    if Typeˉindex >= Types.Count ||
        Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉkind(Types, Typeˉindex) != 3u8 ||
        Caseˉindex >= Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉitemˉcount(
            Types,
            Typeˉindex
        ) {
        return Valueˉstate.Invalid(Input);
    }
    let Variantˉtype: u8 =
        Nominalˉtypes.Compilerˉnativeˉx64ˉvariantˉtype(Types, Typeˉindex);
    let Fields: u32 = Nominalˉtypes.Compilerˉnativeˉx64ˉvariantˉcaseˉfieldˉcount(
        Input, Types, Typeˉindex, Caseˉindex);
    if Fields > 64u32 || Fields > State.Depth || Variantˉtype == 0u8 {
        return Valueˉstate.Invalid(Input);
    }
    let Depth: u32 = State.Depth - Fields;
    var Field: u32 = 0u32;
    while Field < Fields {
        let Payload: Nominalˉtypes.Compilerˉnativeˉx64ˉshape =
            Nominalˉtypes.Compilerˉnativeˉx64ˉvariantˉcaseˉfield(
                Input, Types, Typeˉindex, Caseˉindex, Field);
        if !Payload.Valid || Bytesˉreadˉu8(State.Stack, Depth + Field) != Payload.Type {
            return Valueˉstate.Invalid(Input);
        }
        Field = Field + 1u32;
    }
    let Stack: bytes = Bytesˉslice(State.Stack, 0u32, Depth);
    return Valueˉstate.State(
        true,
        Bytesˉconcat(Stack, Bytesˉfromˉu8(Variantˉtype)),
        Depth + 1u32,
        State.I32ˉvalues,
        State.Boolˉvalues,
        State.Textˉvalues,
        State.U8ˉvalues,
        State.U32ˉvalues,
        State.Bytesˉvalues,
        State.Enumˉvalues,
        State.Recordˉvalues + 1u32,
        State.Bodyˉbytes +
            Variantˉinstructions.Compilerˉnativeˉx64ˉvariantˉcreateˉbytes(
                Input,
                Types,
                Typeˉindex,
                Caseˉindex
            )
    );
}

fn Analyzeˉinspect(
    Input: bytes,
    Instructionˉoffset: u32,
    Opcode: u8,
    Types: Nominalˉtypes.Compilerˉnativeˉx64ˉtypes,
    State: Valueˉstate.State
) -> Valueˉstate.State {
    let Typeˉindex: u32 = Bytesˉreadˉu32ˉlittle(
        Input,
        Instructionˉoffset + 1u32
    );
    let Caseˉindex: u32 = Bytesˉreadˉu32ˉlittle(
        Input,
        Instructionˉoffset + 5u32
    );
    if Typeˉindex >= Types.Count ||
        Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉkind(Types, Typeˉindex) != 3u8 ||
        Caseˉindex >= Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉitemˉcount(
            Types,
            Typeˉindex
        ) {
        return Valueˉstate.Invalid(Input);
    }
    let Variantˉtype: u8 =
        Nominalˉtypes.Compilerˉnativeˉx64ˉvariantˉtype(Types, Typeˉindex);
    if State.Depth == 0u32 ||
        Bytesˉreadˉu8(State.Stack, State.Depth - 1u32) != Variantˉtype {
        return Valueˉstate.Invalid(Input);
    }
    let Depth: u32 = State.Depth - 1u32;
    var Stack: bytes = Bytesˉslice(State.Stack, 0u32, Depth);
    if Opcode == 152u8 {
        return Valueˉstate.State(
            true,
            Bytesˉconcat(Stack, Bytesˉfromˉu8(2u8)),
            Depth + 1u32,
            State.I32ˉvalues,
            State.Boolˉvalues + 1u32,
            State.Textˉvalues,
            State.U8ˉvalues,
            State.U32ˉvalues,
            State.Bytesˉvalues,
            State.Enumˉvalues,
            State.Recordˉvalues,
            State.Bodyˉbytes +
                Variantˉinstructions.Compilerˉnativeˉx64ˉvariantˉisˉcaseˉbytes()
        );
    }
    let Payload: Nominalˉtypes.Compilerˉnativeˉx64ˉshape =
        Nominalˉtypes.Compilerˉnativeˉx64ˉvariantˉcaseˉpayload(
            Input,
            Types,
            Typeˉindex,
            Caseˉindex
        );
    if !Payload.Valid { return Valueˉstate.Invalid(Input); }
    if Opcode != 153u8 || Payload.Type == 0u8 { return Valueˉstate.Invalid(Input); }
    Stack = Bytesˉconcat(Stack, Bytesˉfromˉu8(Payload.Type));
    var I32ˉvalues: u32 = State.I32ˉvalues;
    var Boolˉvalues: u32 = State.Boolˉvalues;
    var Textˉvalues: u32 = State.Textˉvalues;
    var U8ˉvalues: u32 = State.U8ˉvalues;
    var U32ˉvalues: u32 = State.U32ˉvalues;
    var Bytesˉvalues: u32 = State.Bytesˉvalues;
    var Enumˉvalues: u32 = State.Enumˉvalues;
    var Recordˉvalues: u32 = State.Recordˉvalues;
    if Payload.Type == 1u8 { I32ˉvalues = I32ˉvalues + 1u32; }
    if Payload.Type == 2u8 { Boolˉvalues = Boolˉvalues + 1u32; }
    if Payload.Type == 3u8 { Textˉvalues = Textˉvalues + 1u32; }
    if Payload.Type == 4u8 { U8ˉvalues = U8ˉvalues + 1u32; }
    if Payload.Type == 5u8 || Payload.Type == 8u8 || Payload.Type == 9u8 || Payload.Type == 10u8 {
        U32ˉvalues = U32ˉvalues + 1u32;
    }
    if Payload.Type == 6u8 || Payload.Type == 7u8 { Bytesˉvalues = Bytesˉvalues + 1u32; }
    if Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉisˉenum(Payload.Type) {
        Enumˉvalues = Enumˉvalues + 1u32;
    }
    if Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉisˉrecord(Payload.Type) {
        Recordˉvalues = Recordˉvalues + 1u32;
    }
    return Valueˉstate.State(
        true,
        Stack,
        Depth + 1u32,
        I32ˉvalues,
        Boolˉvalues,
        Textˉvalues,
        U8ˉvalues,
        U32ˉvalues,
        Bytesˉvalues,
        Enumˉvalues,
        Recordˉvalues,
        State.Bodyˉbytes +
            Extractionˉbytes(Input, Types, Payload.Type)
    );
}

fn Analyzeˉfield(
    Input: bytes,
    Instructionˉoffset: u32,
    Types: Nominalˉtypes.Compilerˉnativeˉx64ˉtypes,
    State: Valueˉstate.State
) -> Valueˉstate.State {
    let Typeˉindex: u32 = Bytesˉreadˉu32ˉlittle(
        Input, Instructionˉoffset + 1u32
    );
    let Selection: u32 = Bytesˉreadˉu32ˉlittle(
        Input, Instructionˉoffset + 5u32
    );
    let Caseˉindex: u32 = Selection / 64u32;
    let Fieldˉindex: u32 = Selection % 64u32;
    if Typeˉindex >= Types.Count ||
        Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉkind(
            Types, Typeˉindex
        ) != 3u8 || State.Depth == 0u32 || Bytesˉreadˉu8(
            State.Stack, State.Depth - 1u32
        ) != Nominalˉtypes.Compilerˉnativeˉx64ˉvariantˉtype(Types, Typeˉindex) {
        return Valueˉstate.Invalid(Input);
    }
    let Field: Nominalˉtypes.Compilerˉnativeˉx64ˉshape =
        Nominalˉtypes.Compilerˉnativeˉx64ˉvariantˉcaseˉfield(
            Input, Types, Typeˉindex, Caseˉindex, Fieldˉindex
        );
    if !Field.Valid { return Valueˉstate.Invalid(Input); }
    let Depth: u32 = State.Depth - 1u32;
    let Stack: bytes = Bytesˉconcat(
        Bytesˉslice(State.Stack, 0u32, Depth),
        Bytesˉfromˉu8(Field.Type)
    );
    var I32ˉvalues: u32 = State.I32ˉvalues;
    var Boolˉvalues: u32 = State.Boolˉvalues;
    var Textˉvalues: u32 = State.Textˉvalues;
    var U8ˉvalues: u32 = State.U8ˉvalues;
    var U32ˉvalues: u32 = State.U32ˉvalues;
    var Bytesˉvalues: u32 = State.Bytesˉvalues;
    var Enumˉvalues: u32 = State.Enumˉvalues;
    var Recordˉvalues: u32 = State.Recordˉvalues;
    if Field.Type == 1u8 { I32ˉvalues = I32ˉvalues + 1u32; }
    if Field.Type == 2u8 { Boolˉvalues = Boolˉvalues + 1u32; }
    if Field.Type == 3u8 { Textˉvalues = Textˉvalues + 1u32; }
    if Field.Type == 4u8 { U8ˉvalues = U8ˉvalues + 1u32; }
    if Field.Type == 5u8 || Field.Type == 8u8 || Field.Type == 9u8 || Field.Type == 10u8 {
        U32ˉvalues = U32ˉvalues + 1u32;
    }
    if Field.Type == 6u8 || Field.Type == 7u8 { Bytesˉvalues = Bytesˉvalues + 1u32; }
    if Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉisˉenum(Field.Type) {
        Enumˉvalues = Enumˉvalues + 1u32;
    }
    if Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉisˉrecord(Field.Type) {
        Recordˉvalues = Recordˉvalues + 1u32;
    }
    return Valueˉstate.State(
        true,
        Stack,
        Depth + 1u32,
        I32ˉvalues,
        Boolˉvalues,
        Textˉvalues,
        U8ˉvalues,
        U32ˉvalues,
        Bytesˉvalues,
        Enumˉvalues,
        Recordˉvalues,
        State.Bodyˉbytes +
            Extractionˉbytes(Input, Types, Field.Type)
    );
}

export fn Compilerˉnativeˉx64ˉanalyzeˉvariantˉinstruction(
    Input: bytes,
    Instructionˉoffset: u32,
    Opcode: u8,
    Types: Nominalˉtypes.Compilerˉnativeˉx64ˉtypes,
    State: Valueˉstate.State
) -> Valueˉstate.State {
    if Opcode == 225u8 {
        if Instructionˉoffset > Bytesˉlength(Input) ||
            Bytesˉlength(Input) - Instructionˉoffset < 13u32 {
            return Valueˉstate.Invalid(Input);
        }
        let Viewˉtype: u32 = Bytesˉreadˉu32ˉlittle(Input, Instructionˉoffset + 5u32);
        let Projection: u32 = Bytesˉreadˉu32ˉlittle(Input, Instructionˉoffset + 9u32);
        if Viewˉtype >= Types.Count || Projection < 1u32 || Projection > 3u32 ||
            Nominalˉtypes.Compilerˉnativeˉx64ˉfoundationˉvariantˉkind(
                Input, Types, Viewˉtype
            ) != 1u8 { return Valueˉstate.Invalid(Input); }
        return Valueˉstate.State(
            true,
            Bytesˉconcat(State.Stack,
                Bytesˉfromˉu8(Nominalˉtypes.Compilerˉnativeˉx64ˉvariantˉtype(Types, Viewˉtype))),
            State.Depth + 1u32,
            State.I32ˉvalues, State.Boolˉvalues, State.Textˉvalues, State.U8ˉvalues,
            State.U32ˉvalues, State.Bytesˉvalues, State.Enumˉvalues,
            State.Recordˉvalues + 1u32,
            State.Bodyˉbytes + 10u32 + Variantˉinstructions.Compilerˉnativeˉx64ˉfoundationˉborrowˉbytes(
                Input, Types, Viewˉtype
            )
        );
    }
    if Opcode == 151u8 {
        return Analyzeˉcreate(Input, Instructionˉoffset, Types, State);
    }
    if Opcode == 196u8 {
        return Analyzeˉfield(Input, Instructionˉoffset, Types, State);
    }
    return Analyzeˉinspect(Input, Instructionˉoffset, Opcode, Types, State);
}

export fn Compilerˉnativeˉx64ˉanalyzeˉvariantˉvalue(
    Input: bytes,
    Instructionˉoffset: u32,
    Opcode: u8,
    Types: Nominalˉtypes.Compilerˉnativeˉx64ˉtypes,
    State: Valueˉstate.State
) -> Valueˉstate.State {
    if !Valueˉstate.Isˉvalid(State) { return Valueˉstate.Invalid(Input); }
    return Compilerˉnativeˉx64ˉanalyzeˉvariantˉinstruction(
        Input, Instructionˉoffset, Opcode, Types, State);
}

fn Extractionˉbytes(Input: bytes, Types: Nominalˉtypes.Compilerˉnativeˉx64ˉtypes, Type: u8) -> u32 {
    if Nominalˉtypes.Compilerˉnativeˉx64ˉsharedˉminor(Bytesˉreadˉu16ˉlittle(Input, 6u32)) && Nominalˉtypes.Compilerˉnativeˉx64ˉtypeˉisˉrecord(Type) {
        return Records.Compilerˉnativeˉx64ˉrecordˉfieldˉcopyˉbytes(
            Nominalˉtypes.Compilerˉnativeˉx64ˉrecordˉwidth(Input, Types,
                Nominalˉtypes.Compilerˉnativeˉx64ˉrecordˉtypeˉindex(Types, Type)));
    }
    return Variantˉinstructions.Compilerˉnativeˉx64ˉvariantˉpayloadˉbytes(Type);
}
