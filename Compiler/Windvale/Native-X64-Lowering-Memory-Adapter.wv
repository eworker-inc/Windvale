module Compilerˉnativeˉx64ˉloweringˉmemory profile portable;

import Compilerˉnativeˉx64ˉlowering;

export fn Main(Input: bytes) -> bytes {
    let Summary: Compilerˉnativeˉx64ˉsummary =
        Compilerˉlowerˉwvbˉnativeˉx64(Input);
    if Summary.Status != Compilerˉnativeˉx64ˉstatus.Valid {
        return Bytesˉslice(Input, 0u32, 0u32);
    }
    return Summary.Object;
}
