module Compilerˉnativeˉpublicationˉlifetimeˉbridge profile hosted;

import Compilerˉnativeˉpublicationˉlifetime as Publicationˉlifetime;

capability file.read_bytes;

data Requestˉname: text = "native-publication-lifetime-request.bin";

export fn Main() -> bytes {
    let Input: bytes = file.read_bytes(Requestˉname);
    let Plan: Publicationˉlifetime.Nativeˉpublicationˉlifetimeˉresult =
        Publicationˉlifetime.Nativeˉpublicationˉlifetimeˉplan(Input);
    return Plan.Value;
}
