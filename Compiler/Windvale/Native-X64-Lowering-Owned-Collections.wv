export fn Entry() -> bytes { return Entryˉtemplate; }
export fn Entryˉbytes() -> u32 { return Bytesˉlength(Entryˉtemplate); }

export fn Minorˉisˉsupported(Minor: u32) -> bool {
    return Types.Compilerˉnativeˉx64ˉownedˉminor(Minor);
}

export fn Operationˉisˉsupported(Opcode: u8) -> bool {
    return Opcode == 80u8 || Opcode == 195u8 || Opcode == 202u8 || Opcode == 206u8 ||
        Opcode == 207u8 || Opcode == 208u8 || Opcode == 209u8 || Opcode == 227u8;
}

export fn Opcodeˉisˉsupported(Opcode: u8) -> bool {
    let Numeric: u32 = U32ˉfromˉu8(Opcode);
    return Opcode == 1u8 || Opcode == 2u8 || Opcode == 4u8 || Opcode == 5u8 ||
        Opcode == 8u8 || Opcode == 9u8 ||
        (Numeric >= 16u32 && Numeric <= 22u32) ||
        (Numeric >= 32u32 && Numeric <= 40u32) ||
        Opcode == 48u8 || Opcode == 49u8 || Opcode == 64u8 || Opcode == 80u8 || Opcode == 81u8 ||
        (Numeric >= 96u32 && Numeric <= 108u32) ||
        Opcode == 128u8 || Opcode == 129u8 ||
        (Numeric >= 133u32 && Numeric <= 148u32) ||
        (Numeric >= 151u32 && Numeric <= 153u32) ||
        Opcode == 196u8 || Opcode == 205u8 || Operationˉisˉsupported(Opcode);
}

fn Isˉowner(Shape: Types.Compilerˉnativeˉx64ˉshape) -> bool {
    return Shape.Type == 10u8 && (Shape.Identity == 25u32 ||
        (Shape.Identity >= 2147483648u32 && Shape.Identity != 4294967295u32));
}

fn Isˉscalar(Shape: Types.Compilerˉnativeˉx64ˉshape) -> bool {
    return Shape.Valid && !Isˉowner(Shape) &&
        (Shape.Type == 1u8 || Shape.Type == 2u8 || Shape.Type == 4u8 ||
         Shape.Type == 5u8 || Shape.Type == 9u8 || Shape.Type == 10u8 ||
         Types.Compilerˉnativeˉx64ˉtypeˉisˉenum(Shape.Type));
}

export fn Shapeˉisˉsupported(Shape: Types.Compilerˉnativeˉx64ˉshape) -> bool {
    return Shape.Valid && (Isˉscalar(Shape) || Isˉowner(Shape) ||
        Types.Compilerˉnativeˉx64ˉtypeˉisˉrecord(Shape.Type));
}

export fn Parameterˉisˉsupported(Shape: Types.Compilerˉnativeˉx64ˉshape) -> bool {
    if !Shapeˉisˉsupported(Shape) { return false; }
    if Shape.Borrowˉkind == 0u8 { return true; }
    return Shape.Type == 10u8 && Shape.Identity >= 2147483648u32 &&
        Shape.Identity != 4294967295u32 &&
        (Shape.Borrowˉkind == 26u8 || Shape.Borrowˉkind == 27u8);
}

fn Scalarˉrecord(Input: bytes, Table: Types.Compilerˉnativeˉx64ˉtypes, Index: u32) -> bool {
    if Types.Compilerˉnativeˉx64ˉtypeˉkind(Table, Index) != 1u8 { return false; }
    var Field: u32 = 0u32;
    while Field < Types.Compilerˉnativeˉx64ˉtypeˉitemˉcount(Table, Index) {
        if !Isˉscalar(Types.Compilerˉnativeˉx64ˉrecordˉfieldˉshape(Input, Table, Index, Field)) { return false; }
        Field = Field + 1u32;
    }
    return true;
}

fn Collectionˉfailure(Input: bytes, Table: Types.Compilerˉnativeˉx64ˉtypes, Index: u32) -> bool {
    if Types.Compilerˉnativeˉx64ˉtypeˉkind(Table, Index) != 3u8 ||
        Types.Compilerˉnativeˉx64ˉtypeˉitemˉcount(Table, Index) != 10u32 ||
        Types.Compilerˉnativeˉx64ˉrecordˉwidth(Input, Table, Index) != 6u32 ||
        !Types.Compilerˉnativeˉx64ˉvariantˉcaseˉnameˉis(Input, Table, Index, 2u32, "Capacityˉexhausted") ||
        !Types.Compilerˉnativeˉx64ˉvariantˉfieldˉnameˉis(Input, Table, Index, 2u32, 0u32, "Maximum") {
        return false;
    }
    let Maximum: Types.Compilerˉnativeˉx64ˉshape = Types.Compilerˉnativeˉx64ˉvariantˉcaseˉfield(Input, Table, Index, 2u32, 0u32);
    if !Isˉscalar(Maximum) || Maximum.Type != 10u8 { return false; }
    var Case: u32 = 0u32;
    while Case < 10u32 {
        var Field: u32 = 0u32;
        var More: bool = true;
        while Field < 5u32 && More {
            let Shape: Types.Compilerˉnativeˉx64ˉshape = Types.Compilerˉnativeˉx64ˉvariantˉcaseˉfield(Input, Table, Index, Case, Field);
            if !Shape.Valid { More = false; }
            else if !Isˉscalar(Shape) {
                if !Types.Compilerˉnativeˉx64ˉtypeˉisˉrecord(Shape.Type) || !Scalarˉrecord(Input, Table, Shape.Identity) { return false; }
            }
            Field = Field + 1u32;
        }
        if More { return false; }
        Case = Case + 1u32;
    }
    return true;
}

fn Appendˉfailure(Input: bytes, Table: Types.Compilerˉnativeˉx64ˉtypes, Index: u32) -> bool {
    if Types.Compilerˉnativeˉx64ˉtypeˉkind(Table, Index) != 1u8 ||
        Types.Compilerˉnativeˉx64ˉtypeˉitemˉcount(Table, Index) != 2u32 ||
        Types.Compilerˉnativeˉx64ˉrecordˉwidth(Input, Table, Index) != 8u32 ||
        !Types.Compilerˉnativeˉx64ˉrecordˉfieldˉnameˉis(Input, Table, Index, 0u32, "Error") ||
        !Types.Compilerˉnativeˉx64ˉrecordˉfieldˉnameˉis(Input, Table, Index, 1u32, "Value") { return false; }
    let Error: Types.Compilerˉnativeˉx64ˉshape = Types.Compilerˉnativeˉx64ˉrecordˉfieldˉshape(Input, Table, Index, 0u32);
    return Types.Compilerˉnativeˉx64ˉtypeˉisˉrecord(Error.Type) && Collectionˉfailure(Input, Table, Error.Identity) &&
        Isˉscalar(Types.Compilerˉnativeˉx64ˉrecordˉfieldˉshape(Input, Table, Index, 1u32));
}

export fn Vectorˉelement(Input: bytes, Table: Types.Compilerˉnativeˉx64ˉtypes, Index: u32) -> u8 {
    if Index >= Table.Count || Types.Compilerˉnativeˉx64ˉtypeˉkind(Table, Index) != 5u8 { return 0u8; }
    return Bytesˉreadˉu8(Input, Types.Compilerˉnativeˉx64ˉtypeˉitemˉoffset(Table, Index));
}

export fn Appendˉresult(Input: bytes, Table: Types.Compilerˉnativeˉx64ˉtypes, Index: u32, Element: u8) -> bool {
    if Types.Compilerˉnativeˉx64ˉtypeˉkind(Table, Index) != 3u8 ||
        Types.Compilerˉnativeˉx64ˉtypeˉitemˉcount(Table, Index) != 2u32 ||
        Types.Compilerˉnativeˉx64ˉrecordˉwidth(Input, Table, Index) != 10u32 ||
        !Types.Compilerˉnativeˉx64ˉvariantˉcaseˉnameˉis(Input, Table, Index, 0u32, "Valid") ||
        !Types.Compilerˉnativeˉx64ˉvariantˉcaseˉnameˉis(Input, Table, Index, 1u32, "Failure") { return false; }
    let Valid: Types.Compilerˉnativeˉx64ˉshape = Types.Compilerˉnativeˉx64ˉvariantˉcaseˉpayload(Input, Table, Index, 0u32);
    let Failure: Types.Compilerˉnativeˉx64ˉshape = Types.Compilerˉnativeˉx64ˉvariantˉcaseˉpayload(Input, Table, Index, 1u32);
    if !Valid.Valid || Valid.Type != 5u8 || Valid.Identity != 20u32 || !Failure.Valid ||
        !Types.Compilerˉnativeˉx64ˉtypeˉisˉrecord(Failure.Type) || !Appendˉfailure(Input, Table, Failure.Identity) { return false; }
    let Value: Types.Compilerˉnativeˉx64ˉshape = Types.Compilerˉnativeˉx64ˉrecordˉfieldˉshape(Input, Table, Failure.Identity, 1u32);
    return Value.Type == Element;
}

export fn Typesˉareˉsupported(Input: bytes, Table: Types.Compilerˉnativeˉx64ˉtypes) -> bool {
    // Scalar records, canonical allocation Results and append refusal payloads.
    // The only nested value record admitted here is the exact append failure;
    // no recursive aggregate walk or nested owner aggregate is introduced.
    var Index: u32 = 0u32;
    while Index < Table.Count {
        let Kind: u8 = Types.Compilerˉnativeˉx64ˉtypeˉkind(Table, Index);
        let Items: u32 = Types.Compilerˉnativeˉx64ˉtypeˉitemˉcount(Table, Index);
        var Item: u32 = 0u32;
        if Kind == 1u8 {
            if !Scalarˉrecord(Input, Table, Index) && !Appendˉfailure(Input, Table, Index) { return false; }
        } else if Kind == 3u8 {
            while Item < Items {
                var Field: u32 = 0u32;
                var More: bool = true;
                while Field < 64u32 && More {
                    let Shape: Types.Compilerˉnativeˉx64ˉshape =
                        Types.Compilerˉnativeˉx64ˉvariantˉcaseˉfield(Input, Table, Index, Item, Field);
                    if !Shape.Valid { More = false; }
                    else if Isˉowner(Shape) {
                        if !Types.Compilerˉnativeˉx64ˉmemoryˉbudgetˉresultˉisˉexact(Input, Table, Index) &&
                            !Types.Compilerˉnativeˉx64ˉvectorˉresultˉisˉexact(Input, Table, Index) { return false; }
                    } else if !Isˉscalar(Shape) {
                        if !Types.Compilerˉnativeˉx64ˉtypeˉisˉrecord(Shape.Type) ||
                            (!Scalarˉrecord(Input, Table, Shape.Identity) && !Appendˉfailure(Input, Table, Shape.Identity)) {
                            return false;
                        }
                    }
                    Field = Field + 1u32;
                }
                Item = Item + 1u32;
            }
        } else if Kind != 2u8 && Kind != 7u8 && Kind != 5u8 { return false; }
        Index = Index + 1u32;
    }
    return true;
}

export fn Operationˉbytes(Opcode: u8) -> u32 {
    if Opcode == 80u8 { return 36u32; }
    if Opcode == 207u8 { return 65u32; }
    if Opcode == 195u8 { return 20u32; }
    if Opcode == 208u8 { return 68u32; }
    if Opcode == 202u8 { return 44u32; }
    if Opcode == 227u8 { return 52u32; }
    return 71u32;
}

fn Word(Output: bytes, Value: u32) -> bytes {
    return Bytesˉconcat(Output, Bytesˉfromˉu32ˉlittle(Value));
}

fn Relative(Target: u32, Origin: u32) -> u32 {
    if Target >= Origin { return Target - Origin; }
    return 4294967295u32 - (Origin - Target) + 1u32;
}

fn Load(Output: bytes, Register: u8, Slot: u32) -> bytes {
    return Word(Bytesˉconcat(Bytesˉconcat(Output, Loadˉprefix),
        Bytesˉconcat(Bytesˉfromˉu8(Register), Stackˉindex)), Slot * 16u32);
}

fn Call(Output: bytes, Helper: u32, Emittedˉoffset: u32, Invalidˉtarget: u32, Entryˉbase: u32, Codeˉbase: u32) -> bytes {
    var Result: bytes = Bytesˉconcat(Output, Callˉrelative);
    Result = Word(Result, Relative(Entryˉbase + Helper, Codeˉbase + Emittedˉoffset + Bytesˉlength(Result) + 4u32));
    Result = Bytesˉconcat(Result, Rejectˉnonzero);
    return Word(Result, Relative(Invalidˉtarget, Bytesˉlength(Result) + 4u32));
}

export fn Emitˉoperation(
    Input: bytes, Offset: u32, Opcode: u8, Emittedˉoffset: u32,
    Entryˉbase: u32, Codeˉbase: u32,
    Localˉidentities: bytes,
    Table: Types.Compilerˉnativeˉx64ˉtypes,
    Layout: Instructions.Compilerˉnativeˉx64ˉrecordˉlayout,
    Backings: Storage.Compilerˉnativeˉx64ˉrecordˉstorage,
    Invalidˉtarget: u32,
    State: Instructions.Compilerˉnativeˉx64ˉrecordˉstate
) -> Instructions.Compilerˉnativeˉx64ˉrecordˉstate {
    var Depth: u32 = State.Stackˉdepth;
    if Opcode != 195u8 { Depth = Depth - 1u32; }
    var Output: bytes = State.Result;
    var Stackˉtypes: bytes = Bytesˉslice(State.Stackˉtypes, 0u32, Depth);
    var Stackˉslots: bytes = Bytesˉslice(State.Stackˉslots, 0u32, Depth * 4u32);
    var Nextˉrecord: u32 = State.Nextˉrecord;
    var Nextˉi32: u32 = State.Nextˉi32;
    var Nextˉbool: u32 = State.Nextˉbool;
    var Nextˉu8: u32 = State.Nextˉu8;
    var Nextˉu32: u32 = State.Nextˉu32;
    if Opcode == 80u8 {
        let Local: u32 = Bytesˉreadˉu32ˉlittle(Input, Offset - 4u32);
        var Operation: u32 = 9u32;
        if Bytesˉreadˉu32ˉlittle(Localˉidentities, Local * 4u32) == 25u32 { Operation = 7u32; }
        Output = Load(Output, 132u8, Bytesˉreadˉu32ˉlittle(State.Stackˉslots, Depth * 4u32));
        Output = Word(Bytesˉconcat(Output, Moveˉecx), Operation);
        Output = Call(Output, 1151u32, Emittedˉoffset, Invalidˉtarget, Entryˉbase, Codeˉbase);
    } else if Opcode == 195u8 || Opcode == 202u8 || Opcode == 227u8 {
        var Valueˉtype: u8 = 10u8;
        var Valueˉindex: u32 = Nextˉu32;
        var Accessˉoperation: u32 = 0u32;
        if Opcode == 195u8 {
            Valueˉtype = 5u8;
        } else if Opcode == 202u8 {
            Output = Load(Output, 132u8, Bytesˉreadˉu32ˉlittle(State.Stackˉslots, Depth * 4u32));
            Depth = Depth + 1u32;
        } else {
            Output = Load(Output, 132u8, Bytesˉreadˉu32ˉlittle(Input, Offset + 1u32));
            Output = Load(Output, 148u8, Bytesˉreadˉu32ˉlittle(State.Stackˉslots, Depth * 4u32));
            Valueˉtype = Vectorˉelement(Input, Table, Bytesˉreadˉu32ˉlittle(Input, Offset + 5u32));
            Accessˉoperation = 1u32;
            if Valueˉtype == 1u8 { Valueˉindex = Nextˉi32; }
            if Valueˉtype == 2u8 { Valueˉindex = Nextˉbool; }
            if Valueˉtype == 4u8 { Valueˉindex = Nextˉu8; }
        }
        let Valueˉslot: u32 = Frames.Compilerˉnativeˉx64ˉlayoutˉvalueˉslot(Layout.Locals,
            Layout.I32ˉslots, Layout.Boolˉslots, Layout.Textˉslots, Layout.U8ˉslots,
            Layout.U32ˉslots, Layout.Bytesˉslots, Valueˉtype, Valueˉindex);
        if Opcode == 195u8 { Output = Bytesˉconcat(Output, Bytesˉfromˉu16ˉlittle(53809u32)); }
        else {
            Output = Word(Bytesˉconcat(Output, Moveˉecx), Accessˉoperation);
            Output = Call(Output, 1451u32, Emittedˉoffset, Invalidˉtarget, Entryˉbase, Codeˉbase);
        }
        Output = Word(Bytesˉconcat(Output, Storeˉrdx), Valueˉslot * 16u32);
        Stackˉtypes = Bytesˉconcat(Bytesˉslice(State.Stackˉtypes, 0u32, Depth), Bytesˉfromˉu8(Valueˉtype));
        Stackˉslots = Bytesˉconcat(Bytesˉslice(State.Stackˉslots, 0u32, Depth * 4u32), Bytesˉfromˉu32ˉlittle(Valueˉslot));
        Depth = Depth + 1u32;
        if Valueˉtype == 1u8 { Nextˉi32 = Nextˉi32 + 1u32; }
        else if Valueˉtype == 2u8 { Nextˉbool = Nextˉbool + 1u32; }
        else if Valueˉtype == 4u8 { Nextˉu8 = Nextˉu8 + 1u32; }
        else { Nextˉu32 = Nextˉu32 + 1u32; }
    } else {
        if Opcode == 206u8 { Depth = Depth - 1u32; }
        let Owner: u32 = Bytesˉreadˉu32ˉlittle(Input, Offset + 1u32);
        var Resultˉoffset: u32 = 5u32;
        if Opcode == 209u8 { Resultˉoffset = 9u32; }
        let Resultˉtype: u32 = Bytesˉreadˉu32ˉlittle(Input, Offset + Resultˉoffset);
        let Target: u32 = Layout.Recordˉbase + State.Nextˉrecord;
        let Backing: u32 = Layout.Scratchˉbase + Bytesˉreadˉu32ˉlittle(Backings.Scratchˉoffsets, State.Nextˉrecord * 4u32);
        if Opcode == 209u8 { Output = Word(Bytesˉconcat(Output, Addressˉrax), Owner * 16u32); }
        else { Output = Load(Output, 132u8, Owner); }
        Output = Load(Output, 148u8, Bytesˉreadˉu32ˉlittle(State.Stackˉslots, Depth * 4u32));
        var Helper: u32 = 705u32;
        if Opcode == 206u8 {
            Output = Load(Output, 140u8, Bytesˉreadˉu32ˉlittle(State.Stackˉslots, (Depth + 1u32) * 4u32));
            Helper = 442u32;
        } else if Opcode == 209u8 {
            Output = Word(Bytesˉconcat(Output, Loadˉr9), Bytesˉreadˉu32ˉlittle(Input, Offset + 5u32) * 16u32);
            Helper = 1686u32;
        } else if Opcode == 208u8 {
            Output = Word(Bytesˉconcat(Output, Moveˉecx), 2u32);
            Helper = 1451u32;
        } else { Output = Bytesˉconcat(Output, Clearˉecx); }
        Output = Word(Bytesˉconcat(Output, Addressˉr8), Backing * 16u32);
        Output = Call(Output, Helper, Emittedˉoffset, Invalidˉtarget, Entryˉbase, Codeˉbase);
        Output = Word(Bytesˉconcat(Output, Addressˉrax), Backing * 16u32);
        Output = Word(Bytesˉconcat(Output, Storeˉrax), Target * 16u32);
        Stackˉtypes = Bytesˉconcat(Bytesˉslice(State.Stackˉtypes, 0u32, Depth),
            Bytesˉfromˉu8(Types.Compilerˉnativeˉx64ˉvariantˉtype(Resultˉtype)));
        Stackˉslots = Bytesˉconcat(Bytesˉslice(State.Stackˉslots, 0u32, Depth * 4u32), Bytesˉfromˉu32ˉlittle(Target));
        Depth = Depth + 1u32;
        Nextˉrecord = Nextˉrecord + 1u32;
    }
    return Instructions.Compilerˉnativeˉx64ˉrecordˉstate(
        Output, Stackˉtypes, Stackˉslots, Depth,
        Nextˉi32, Nextˉbool, State.Nextˉtext, Nextˉu8,
        Nextˉu32, State.Nextˉbytes, State.Nextˉenum, Nextˉrecord);
}

export record Analysis {
    Valid: bool;
    Stack: bytes;
    Depth: u32;
    I32ˉvalues: u32;
    Boolˉvalues: u32;
    U8ˉvalues: u32;
    U32ˉvalues: u32;
    Recordˉvalues: u32;
    Bodyˉbytes: u32;
}

export fn Analyze(Input: bytes, Instructionˉoffset: u32, Opcode: u8, Localˉtypeˉidentities: bytes, Table: Types.Compilerˉnativeˉx64ˉtypes, InitialˉStack: bytes, InitialˉDepth: u32, InitialˉI32ˉvalues: u32, InitialˉBoolˉvalues: u32, InitialˉU8ˉvalues: u32, InitialˉU32ˉvalues: u32, InitialˉRecordˉvalues: u32, InitialˉBodyˉbytes: u32) -> Analysis {
    var Stack: bytes = InitialˉStack;
    var Depth: u32 = InitialˉDepth;
    var I32ˉvalues: u32 = InitialˉI32ˉvalues;
    var Boolˉvalues: u32 = InitialˉBoolˉvalues;
    var U8ˉvalues: u32 = InitialˉU8ˉvalues;
    var U32ˉvalues: u32 = InitialˉU32ˉvalues;
    var Recordˉvalues: u32 = InitialˉRecordˉvalues;
    var Bodyˉbytes: u32 = InitialˉBodyˉbytes;
    if Opcode == 195u8 {
        Stack = Bytesˉconcat(Stack, Bytesˉfromˉu8(5u8));
        Depth = Depth + 1u32;
        U32ˉvalues = U32ˉvalues + 1u32;
        Bodyˉbytes = Bodyˉbytes + Operationˉbytes(Opcode);
    }
    if Opcode == 202u8 {
        if Depth == 0u32 || Bytesˉreadˉu8(Stack, Depth - 1u32) != 10u8 ||
            Vectorˉelement(Input, Table, Bytesˉreadˉu32ˉlittle(Input, Instructionˉoffset + 1u32)) == 0u8 {
            return Analysis(false, Stack, Depth, I32ˉvalues, Boolˉvalues, U8ˉvalues, U32ˉvalues, Recordˉvalues, Bodyˉbytes);
        }
        Stack = Bytesˉconcat(Stack, Bytesˉfromˉu8(10u8));
        Depth = Depth + 1u32;
        U32ˉvalues = U32ˉvalues + 1u32;
        Bodyˉbytes = Bodyˉbytes + Operationˉbytes(Opcode);
    }
    if Opcode == 208u8 || Opcode == 209u8 || Opcode == 227u8 {
        let Vectorˉlocal: u32 = Bytesˉreadˉu32ˉlittle(Input, Instructionˉoffset + 1u32);
        if Depth == 0u32 || Vectorˉlocal >= Bytesˉlength(Localˉtypeˉidentities) / 4u32 {
            return Analysis(false, Stack, Depth, I32ˉvalues, Boolˉvalues, U8ˉvalues, U32ˉvalues, Recordˉvalues, Bodyˉbytes);
        }
        let Vectorˉidentity: u32 = Bytesˉreadˉu32ˉlittle(Localˉtypeˉidentities, Vectorˉlocal * 4u32);
        if Vectorˉidentity < 2147483648u32 || Vectorˉidentity == 4294967295u32 {
            return Analysis(false, Stack, Depth, I32ˉvalues, Boolˉvalues, U8ˉvalues, U32ˉvalues, Recordˉvalues, Bodyˉbytes);
        }
        let Element: u8 = Vectorˉelement(Input, Table, Vectorˉidentity - 2147483648u32);
        var Expected: u8 = 10u8;
        if Opcode == 208u8 { Expected = Element; }
        if Element == 0u8 || Bytesˉreadˉu8(Stack, Depth - 1u32) != Expected {
            return Analysis(false, Stack, Depth, I32ˉvalues, Boolˉvalues, U8ˉvalues, U32ˉvalues, Recordˉvalues, Bodyˉbytes);
        }
        var Produced: u8 = Element;
        if Opcode == 227u8 {
            if Bytesˉreadˉu32ˉlittle(Input, Instructionˉoffset + 5u32) != Vectorˉidentity - 2147483648u32 {
                return Analysis(false, Stack, Depth, I32ˉvalues, Boolˉvalues, U8ˉvalues, U32ˉvalues, Recordˉvalues, Bodyˉbytes);
            }
            if Element == 1u8 { I32ˉvalues = I32ˉvalues + 1u32; }
            else if Element == 2u8 { Boolˉvalues = Boolˉvalues + 1u32; }
            else if Element == 4u8 { U8ˉvalues = U8ˉvalues + 1u32; }
            else { U32ˉvalues = U32ˉvalues + 1u32; }
        } else {
            var Resultˉoffset: u32 = 5u32;
            if Opcode == 209u8 {
                Resultˉoffset = 9u32;
                let Funding: u32 = Bytesˉreadˉu32ˉlittle(Input, Instructionˉoffset + 5u32);
                if Funding >= Bytesˉlength(Localˉtypeˉidentities) / 4u32 ||
                    Bytesˉreadˉu32ˉlittle(Localˉtypeˉidentities, Funding * 4u32) != 25u32 {
                    return Analysis(false, Stack, Depth, I32ˉvalues, Boolˉvalues, U8ˉvalues, U32ˉvalues, Recordˉvalues, Bodyˉbytes);
                }
            }
            let Outcome: u32 = Bytesˉreadˉu32ˉlittle(Input, Instructionˉoffset + Resultˉoffset);
            if (Opcode == 208u8 && !Appendˉresult(Input, Table, Outcome, Element)) ||
                (Opcode == 209u8 && !Types.Compilerˉnativeˉx64ˉunitˉallocationˉresultˉisˉexact(Input, Table, Outcome)) {
                return Analysis(false, Stack, Depth, I32ˉvalues, Boolˉvalues, U8ˉvalues, U32ˉvalues, Recordˉvalues, Bodyˉbytes);
            }
            Produced = Types.Compilerˉnativeˉx64ˉvariantˉtype(Outcome);
            Recordˉvalues = Recordˉvalues + 1u32;
        }
        Stack = Bytesˉconcat(Bytesˉslice(Stack, 0u32, Depth - 1u32), Bytesˉfromˉu8(Produced));
        Bodyˉbytes = Bodyˉbytes + Operationˉbytes(Opcode);
    }
    return Analysis(true, Stack, Depth, I32ˉvalues, Boolˉvalues, U8ˉvalues, U32ˉvalues, Recordˉvalues, Bodyˉbytes);
}
