if Build.Nextˉslot >= 4096u32 {
return Compilerˉsourceˉbindingsˉbuildˉfailure(
Build,
Compilerˉsourceˉbindingˉstatus.Bindingˉlimit,
Module, Module, Function,
Capture.Offset, Capture.Line, Capture.Column
);
}
if Bytesˉlength(Build.Payload) > 4194252u32 {
return Compilerˉsourceˉbindingsˉbuildˉfailure(
Build,
Compilerˉsourceˉbindingˉstatus.Evidenceˉlimit,
Module, Module, Function,
Capture.Offset, Capture.Line, Capture.Column
);
}
var Kind: Compilerˉsourceˉbindingˉkind =
Compilerˉsourceˉbindingˉkind.Let;
if Isˉmutable { Kind = Compilerˉsourceˉbindingˉkind.Var; }
let Entry: bytes = Compilerˉsourceˉbindingsˉentry(
Module, Function, Kind, Build.Nextˉslot,
Capture.Offset, Capture.Length, Shape,
Bodyˉoffset, Bodyˉoffset + Bodyˉlength
);
return Compilerˉsourceˉbindingsˉappend(Build, Entry, false);
}
