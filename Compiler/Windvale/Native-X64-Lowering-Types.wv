module Compilerˉnativeˉx64ˉloweringˉtypes profile portable;

export record Compilerˉnativeˉx64ˉtypes {
    Valid: bool;
    Count: u32;
    Kinds: bytes;
    Itemˉoffsets: bytes;
    Itemˉcounts: bytes;
    Recordˉwidths: bytes;
}

export record Compilerˉnativeˉx64ˉshape {
    Valid: bool;
    Next: u32;
    Type: u8;
    Identity: u32;
}

fn Empty(Input: bytes) -> bytes {
    return Bytesˉslice(Input, 0u32, 0u32);
}

fn Invalid(Input: bytes) -> Compilerˉnativeˉx64ˉtypes {
    let Emptyˉbytes: bytes = Empty(Input);
    return Compilerˉnativeˉx64ˉtypes(
        false,
        0u32,
        Emptyˉbytes,
        Emptyˉbytes,
        Emptyˉbytes,
        Emptyˉbytes
    );
}

fn Invalidˉshape() -> Compilerˉnativeˉx64ˉshape {
    return Compilerˉnativeˉx64ˉshape(false, 0u32, 0u8, 4294967295u32);
}

fn Rangeˉisˉvalid(Total: u32, Offset: u32, Length: u32) -> bool {
    if Offset > Total { return false; }
    return Length <= Total - Offset;
}

export fn Compilerˉnativeˉx64ˉtypesˉlimit() -> u32 {
    return 128u32;
}

export fn Compilerˉnativeˉx64ˉrecordˉtypesˉlimit() -> u32 {
    return 116u32;
}

fn Identifierˉisˉvalid(Input: bytes, Offset: u32, Length: u32) -> bool {
    if Length == 0u32 { return false; }
    if Length > 255u32 { return false; }
    if !Rangeˉisˉvalid(Bytesˉlength(Input), Offset, Length) { return false; }
    let End: u32 = Offset + Length;
    var Cursor: u32 = Offset;
    var Wordˉstart: bool = true;
    while Cursor < End {
        let Current: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(Input, Cursor));
        var Valid: bool = false;
        if Current >= 65u32 {
            if Current <= 90u32 { Valid = true; }
        }
        if Current >= 97u32 {
            if Current <= 122u32 { Valid = true; }
        }
        if Current == 95u32 { Valid = true; }
        if !Wordˉstart {
            if Current >= 48u32 {
                if Current <= 57u32 { Valid = true; }
            }
        }
        if Valid {
            Wordˉstart = false;
            Cursor = Cursor + 1u32;
        } else {
            if Wordˉstart { return false; }
            if Current != 203u32 { return false; }
            if Cursor + 1u32 >= End { return false; }
            if Bytesˉreadˉu8(Input, Cursor + 1u32) != 137u8 { return false; }
            Wordˉstart = true;
            Cursor = Cursor + 2u32;
        }
    }
    return !Wordˉstart;
}

fn Skipˉname(Input: bytes, Cursor: u32, Limit: u32) -> u32 {
    if !Rangeˉisˉvalid(Limit, Cursor, 4u32) { return 0u32; }
    let Length: u32 = Bytesˉreadˉu32ˉlittle(Input, Cursor);
    if !Rangeˉisˉvalid(Limit, Cursor + 4u32, Length) { return 0u32; }
    if !Identifierˉisˉvalid(Input, Cursor + 4u32, Length) { return 0u32; }
    return Cursor + 4u32 + Length;
}

export fn Compilerˉnativeˉx64ˉtypeˉkind(
    Types: Compilerˉnativeˉx64ˉtypes,
    Index: u32
) -> u8 {
    return Bytesˉreadˉu8(Types.Kinds, Index);
}

export fn Compilerˉnativeˉx64ˉtypeˉitemˉoffset(
    Types: Compilerˉnativeˉx64ˉtypes,
    Index: u32
) -> u32 {
    return Bytesˉreadˉu32ˉlittle(Types.Itemˉoffsets, Index * 4u32);
}

export fn Compilerˉnativeˉx64ˉtypeˉitemˉcount(
    Types: Compilerˉnativeˉx64ˉtypes,
    Index: u32
) -> u32 {
    return Bytesˉreadˉu32ˉlittle(Types.Itemˉcounts, Index * 4u32);
}

export fn Compilerˉnativeˉx64ˉenumˉtype(
    Types: Compilerˉnativeˉx64ˉtypes,
    Typeˉindex: u32
) -> u8 {
    if Typeˉindex >= Types.Count { return 0u8; }
    let Kind: u8 = Compilerˉnativeˉx64ˉtypeˉkind(Types, Typeˉindex);
    if Kind != 2u8 && Kind != 7u8 { return 0u8; }
    var Ordinal: u32 = 0u32;
    var Index: u32 = 0u32;
    while Index < Typeˉindex {
        let Priorˉkind: u8 = Compilerˉnativeˉx64ˉtypeˉkind(Types, Index);
        if Priorˉkind == 2u8 || Priorˉkind == 7u8 {
            Ordinal = Ordinal + 1u32;
        }
        Index = Index + 1u32;
    }
    if Ordinal >= 64u32 { return 0u8; }
    return Bytesˉreadˉu8(
        Bytesˉfromˉu32ˉlittle(128u32 + Ordinal),
        0u32
    );
}

export fn Compilerˉnativeˉx64ˉtypeˉisˉenum(Type: u8) -> bool {
    let Numeric: u32 = U32ˉfromˉu8(Type);
    if Numeric < 128u32 { return false; }
    return Numeric < 192u32;
}

export fn Compilerˉnativeˉx64ˉenumˉtypeˉindex(
    Types: Compilerˉnativeˉx64ˉtypes,
    Type: u8
) -> u32 {
    let Wanted: u32 = U32ˉfromˉu8(Type) - 128u32;
    var Ordinal: u32 = 0u32;
    var Index: u32 = 0u32;
    while Index < Types.Count {
        let Kind: u8 = Compilerˉnativeˉx64ˉtypeˉkind(Types, Index);
        if Kind == 2u8 || Kind == 7u8 {
            if Ordinal == Wanted { return Index; }
            Ordinal = Ordinal + 1u32;
        }
        Index = Index + 1u32;
    }
    return Types.Count;
}

export fn Compilerˉnativeˉx64ˉrecordˉtype(Typeˉindex: u32) -> u8 {
    if Typeˉindex >= 64u32 {
        return Bytesˉreadˉu8(
            Bytesˉfromˉu32ˉlittle(12u32 + Typeˉindex - 64u32),
            0u32
        );
    }
    return Bytesˉreadˉu8(
        Bytesˉfromˉu32ˉlittle(192u32 + Typeˉindex),
        0u32
    );
}

export fn Compilerˉnativeˉx64ˉvariantˉtype(Typeˉindex: u32) -> u8 {
    if Typeˉindex >= 64u32 { return 0u8; }
    return Bytesˉreadˉu8(
        Bytesˉfromˉu32ˉlittle(64u32 + Typeˉindex),
        0u32
    );
}

export fn Compilerˉnativeˉx64ˉtypeˉisˉvariant(Type: u8) -> bool {
    let Numeric: u32 = U32ˉfromˉu8(Type);
    return Numeric >= 64u32 && Numeric < 128u32;
}

export fn Compilerˉnativeˉx64ˉtypeˉisˉrecord(Type: u8) -> bool {
    // Record-backed values include finite non-recursive variants. Keeping one
    // internal predicate lets locals, calls, returns, and liveness share the
    // same bounded backing allocator.
    if Compilerˉnativeˉx64ˉtypeˉisˉvariant(Type) { return true; }
    let Numeric: u32 = U32ˉfromˉu8(Type);
    if Numeric >= 192u32 { return true; }
    return Numeric >= 12u32 && Numeric < 64u32;
}

export fn Compilerˉnativeˉx64ˉrecordˉtypeˉindex(Type: u8) -> u32 {
    if Compilerˉnativeˉx64ˉtypeˉisˉvariant(Type) {
        return U32ˉfromˉu8(Type) - 64u32;
    }
    if U32ˉfromˉu8(Type) < 64u32 {
        return 64u32 + U32ˉfromˉu8(Type) - 12u32;
    }
    return U32ˉfromˉu8(Type) - 192u32;
}

export fn Compilerˉnativeˉx64ˉruntimeˉtype(Type: u8) -> u8 {
    if Compilerˉnativeˉx64ˉtypeˉisˉvariant(Type) { return 11u8; }
    if Compilerˉnativeˉx64ˉtypeˉisˉrecord(Type) { return 7u8; }
    if Compilerˉnativeˉx64ˉtypeˉisˉenum(Type) { return 8u8; }
    return Type;
}

export fn Compilerˉnativeˉx64ˉtypeˉisˉcallable(Type: u8) -> bool {
    return Type == 11u8;
}

export fn Compilerˉnativeˉx64ˉshapeˉread(
    Input: bytes,
    Cursor: u32,
    Limit: u32,
    Types: Compilerˉnativeˉx64ˉtypes
) -> Compilerˉnativeˉx64ˉshape {
    if !Rangeˉisˉvalid(Limit, Cursor, 1u32) { return Invalidˉshape(); }
    let Kind: u8 = Bytesˉreadˉu8(Input, Cursor);
    if Kind == 25u8 {
        return Compilerˉnativeˉx64ˉshape(
            true, Cursor + 1u32, 10u8, 25u32
        );
    }
    if U32ˉfromˉu8(Kind) >= 1u32 {
        if U32ˉfromˉu8(Kind) <= 10u32 && Kind != 7u8 && Kind != 8u8 {
            return Compilerˉnativeˉx64ˉshape(
                true, Cursor + 1u32, Kind, 4294967295u32
            );
        }
    }
    if Kind != 7u8 && Kind != 8u8 && Kind != 11u8 && Kind != 35u8 {
        return Invalidˉshape();
    }
    if !Rangeˉisˉvalid(Limit, Cursor, 5u32) { return Invalidˉshape(); }
    let Typeˉindex: u32 = Bytesˉreadˉu32ˉlittle(Input, Cursor + 1u32);
    if Typeˉindex >= Types.Count { return Invalidˉshape(); }
    let Nominalˉkind: u8 = Compilerˉnativeˉx64ˉtypeˉkind(
        Types,
        Typeˉindex
    );
    var Type: u8 = Compilerˉnativeˉx64ˉrecordˉtype(Typeˉindex);
    if Kind == 7u8 {
        if Nominalˉkind != 1u8 { return Invalidˉshape(); }
    } else if Kind == 8u8 {
        if Nominalˉkind != 2u8 && Nominalˉkind != 7u8 {
            return Invalidˉshape();
        }
        Type = Compilerˉnativeˉx64ˉenumˉtype(Types, Typeˉindex);
    } else if Kind == 11u8 {
        if Nominalˉkind != 3u8 || Typeˉindex >= 64u32 {
            return Invalidˉshape();
        }
        Type = Compilerˉnativeˉx64ˉvariantˉtype(Typeˉindex);
    } else {
        if Nominalˉkind != 8u8 { return Invalidˉshape(); }
        Type = 11u8;
    }
    return Compilerˉnativeˉx64ˉshape(
        true,
        Cursor + 5u32,
        Type,
        Typeˉindex
    );
}

export fn Compilerˉnativeˉx64ˉreturnˉshapeˉread(
    Input: bytes,
    Cursor: u32,
    Limit: u32,
    Types: Compilerˉnativeˉx64ˉtypes
) -> Compilerˉnativeˉx64ˉshape {
    if Rangeˉisˉvalid(Limit, Cursor, 1u32) {
        if Bytesˉreadˉu8(Input, Cursor) == 0u8 {
            return Compilerˉnativeˉx64ˉshape(
                true, Cursor + 1u32, 0u8, 4294967295u32
            );
        }
    }
    return Compilerˉnativeˉx64ˉshapeˉread(Input, Cursor, Limit, Types);
}

fn Skipˉuncheckedˉshape(Input: bytes, Cursor: u32, Limit: u32) -> u32 {
    if !Rangeˉisˉvalid(Limit, Cursor, 1u32) { return 0u32; }
    let Kind: u8 = Bytesˉreadˉu8(Input, Cursor);
    if U32ˉfromˉu8(Kind) >= 1u32 {
        if U32ˉfromˉu8(Kind) <= 10u32 && Kind != 7u8 && Kind != 8u8 {
            return Cursor + 1u32;
        }
    }
    if Kind == 25u8 { return Cursor + 1u32; }
    if Kind != 7u8 && Kind != 8u8 && Kind != 11u8 && Kind != 35u8 {
        return 0u32;
    }
    if !Rangeˉisˉvalid(Limit, Cursor, 5u32) { return 0u32; }
    return Cursor + 5u32;
}

fn Skipˉhostedˉshape(Input: bytes, Cursor: u32, Limit: u32) -> u32 {
    if !Rangeˉisˉvalid(Limit, Cursor, 1u32) { return 0u32; }
    let Kind: u8 = Bytesˉreadˉu8(Input, Cursor);
    let Numeric: u32 = U32ˉfromˉu8(Kind);
    if Numeric >= 1u32 && Numeric <= 10u32 && Kind != 7u8 && Kind != 8u8 {
        return Cursor + 1u32;
    }
    if Kind == 25u8 { return Cursor + 1u32; }
    if Kind != 7u8 && Kind != 8u8 && Kind != 11u8 && Kind != 35u8 {
        return 0u32;
    }
    if !Rangeˉisˉvalid(Limit, Cursor, 5u32) { return 0u32; }
    return Cursor + 5u32;
}

fn Checkedˉhostedˉshape(
    Input: bytes,
    Cursor: u32,
    Limit: u32,
    Types: Compilerˉnativeˉx64ˉtypes,
    Allowˉvariant: bool
) -> u32 {
    let Next: u32 = Skipˉhostedˉshape(Input, Cursor, Limit);
    if Next == 0u32 { return 0u32; }
    let Kind: u8 = Bytesˉreadˉu8(Input, Cursor);
    if Kind != 7u8 && Kind != 8u8 && Kind != 11u8 && Kind != 35u8 {
        return Next;
    }
    if Kind == 35u8 { return 0u32; }
    if Kind == 11u8 && !Allowˉvariant { return 0u32; }
    let Typeˉindex: u32 = Bytesˉreadˉu32ˉlittle(Input, Cursor + 1u32);
    if Typeˉindex >= Types.Count { return 0u32; }
    let Expectedˉkind: u8 = Compilerˉnativeˉx64ˉtypeˉkind(
        Types,
        Typeˉindex
    );
    if Kind == 7u8 && Expectedˉkind != 1u8 { return 0u32; }
    if Kind == 8u8 && Expectedˉkind != 2u8 && Expectedˉkind != 7u8 {
        return 0u32;
    }
    if Kind == 11u8 && Expectedˉkind != 3u8 { return 0u32; }
    if Kind == 35u8 && Expectedˉkind != 8u8 { return 0u32; }
    return Next;
}

fn Compilerˉnativeˉx64ˉcallableˉshapeˉisˉsupported(
    Shape: Compilerˉnativeˉx64ˉshape
) -> bool {
    if !Shape.Valid || Shape.Type == 0u8 || Shape.Type == 11u8 {
        return false;
    }
    if Shape.Type == 1u8 || Shape.Type == 2u8 || Shape.Type == 4u8 ||
        Shape.Type == 5u8 || Shape.Type == 10u8 {
        return true;
    }
    return Compilerˉnativeˉx64ˉtypeˉisˉenum(Shape.Type);
}

fn Compilerˉnativeˉx64ˉtypesˉreadˉmode(
    Input: bytes,
    Offset: u32,
    Length: u32,
    Allowˉvariants: bool
) -> Compilerˉnativeˉx64ˉtypes {
    if !Rangeˉisˉvalid(Bytesˉlength(Input), Offset, Length) {
        return Invalid(Input);
    }
    if Length < 4u32 { return Invalid(Input); }
    let Count: u32 = Bytesˉreadˉu32ˉlittle(Input, Offset);
    if Count > Compilerˉnativeˉx64ˉtypesˉlimit() { return Invalid(Input); }
    let Limit: u32 = Offset + Length;
    var Cursor: u32 = Offset + 4u32;
    var Kinds: bytes = Empty(Input);
    var Itemˉoffsets: bytes = Empty(Input);
    var Itemˉcounts: bytes = Empty(Input);
    var Priorˉkind: u8 = 0u8;
    var Records: u32 = 0u32;
    var Enums: u32 = 0u32;
    var Variants: u32 = 0u32;
    var Callables: u32 = 0u32;
    var Index: u32 = 0u32;
    while Index < Count {
        if !Rangeˉisˉvalid(Limit, Cursor, 1u32) { return Invalid(Input); }
        let Kind: u8 = Bytesˉreadˉu8(Input, Cursor);
        if Kind != 1u8 && Kind != 2u8 {
            if !Allowˉvariants ||
                (Kind != 3u8 && Kind != 7u8 && Kind != 8u8) {
                return Invalid(Input);
            }
        }
        var Kindˉrank: u8 = Kind;
        var Priorˉrank: u8 = Priorˉkind;
        if Kind == 7u8 { Kindˉrank = 2u8; }
        if Priorˉkind == 7u8 { Priorˉrank = 2u8; }
        if U32ˉfromˉu8(Kindˉrank) < U32ˉfromˉu8(Priorˉrank) {
            return Invalid(Input);
        }
        Priorˉkind = Kind;
        if Kind == 1u8 {
            Records = Records + 1u32;
            if Records > Compilerˉnativeˉx64ˉrecordˉtypesˉlimit() {
                return Invalid(Input);
            }
        } else if Kind == 2u8 || Kind == 7u8 {
            Enums = Enums + 1u32;
            if Enums > 64u32 { return Invalid(Input); }
        } else if Kind == 3u8 {
            Variants = Variants + 1u32;
            if Variants > 64u32 { return Invalid(Input); }
        } else {
            Callables = Callables + 1u32;
            if Callables > 128u32 { return Invalid(Input); }
        }
        Cursor = Cursor + 1u32;
        Kinds = Bytesˉconcat(Kinds, Bytesˉfromˉu8(Kind));
        if Kind == 8u8 {
            Itemˉoffsets = Bytesˉconcat(
                Itemˉoffsets,
                Bytesˉfromˉu32ˉlittle(Cursor)
            );
            if !Rangeˉisˉvalid(Limit, Cursor, 1u32) {
                return Invalid(Input);
            }
            Cursor = Cursor + 1u32;
            Cursor = Skipˉhostedˉshape(Input, Cursor, Limit);
            if Cursor == 0u32 || !Rangeˉisˉvalid(Limit, Cursor, 4u32) {
                return Invalid(Input);
            }
            let Callableˉparameters: u32 =
                Bytesˉreadˉu32ˉlittle(Input, Cursor);
            if Callableˉparameters > 64u32 { return Invalid(Input); }
            Itemˉcounts = Bytesˉconcat(
                Itemˉcounts,
                Bytesˉfromˉu32ˉlittle(Callableˉparameters)
            );
            Cursor = Cursor + 4u32;
            var Callableˉparameter: u32 = 0u32;
            while Callableˉparameter < Callableˉparameters {
                Cursor = Skipˉhostedˉshape(Input, Cursor, Limit);
                if Cursor == 0u32 { return Invalid(Input); }
                Callableˉparameter = Callableˉparameter + 1u32;
            }
        } else {
        Cursor = Skipˉname(Input, Cursor, Limit);
        if Cursor == 0u32 { return Invalid(Input); }
        if Kind == 7u8 {
            if !Rangeˉisˉvalid(Limit, Cursor, 1u32) ||
                Bytesˉreadˉu8(Input, Cursor) != 6u8 {
                return Invalid(Input);
            }
            Cursor = Cursor + 1u32;
        }
        if !Rangeˉisˉvalid(Limit, Cursor, 4u32) { return Invalid(Input); }
        let Items: u32 = Bytesˉreadˉu32ˉlittle(Input, Cursor);
        Cursor = Cursor + 4u32;
        if Items == 0u32 { return Invalid(Input); }
        if Kind == 1u8 {
            if Items > 64u32 { return Invalid(Input); }
        } else {
            if Items > 256u32 { return Invalid(Input); }
        }
        Itemˉoffsets = Bytesˉconcat(
            Itemˉoffsets,
            Bytesˉfromˉu32ˉlittle(Cursor)
        );
        Itemˉcounts = Bytesˉconcat(
            Itemˉcounts,
            Bytesˉfromˉu32ˉlittle(Items)
        );
        var Item: u32 = 0u32;
        while Item < Items {
            Cursor = Skipˉname(Input, Cursor, Limit);
            if Cursor == 0u32 { return Invalid(Input); }
            if Kind == 1u8 {
                Cursor = Skipˉuncheckedˉshape(Input, Cursor, Limit);
                if Cursor == 0u32 { return Invalid(Input); }
            } else if Kind == 2u8 || Kind == 7u8 {
                var Enumˉwidth: u32 = 4u32;
                if Kind == 7u8 { Enumˉwidth = 1u32; }
                if !Rangeˉisˉvalid(Limit, Cursor, Enumˉwidth) {
                    return Invalid(Input);
                }
                Cursor = Cursor + Enumˉwidth;
            } else {
                if !Rangeˉisˉvalid(Limit, Cursor, 1u32) {
                    return Invalid(Input);
                }
                let Payloadˉpresent: u8 = Bytesˉreadˉu8(Input, Cursor);
                Cursor = Cursor + 1u32;
                if Payloadˉpresent == 1u8 {
                    Cursor = Skipˉname(Input, Cursor, Limit);
                    if Cursor == 0u32 { return Invalid(Input); }
                    Cursor = Skipˉhostedˉshape(Input, Cursor, Limit);
                    if Cursor == 0u32 { return Invalid(Input); }
                } else if Payloadˉpresent == 2u8 {
                    if !Rangeˉisˉvalid(Limit, Cursor, 4u32) {
                        return Invalid(Input);
                    }
                    let Payloadˉfields: u32 = Bytesˉreadˉu32ˉlittle(Input, Cursor);
                    Cursor = Cursor + 4u32;
                    if Payloadˉfields < 2u32 || Payloadˉfields > 64u32 {
                        return Invalid(Input);
                    }
                    var Payloadˉfield: u32 = 0u32;
                    while Payloadˉfield < Payloadˉfields {
                        Cursor = Skipˉname(Input, Cursor, Limit);
                        if Cursor == 0u32 { return Invalid(Input); }
                        Cursor = Skipˉhostedˉshape(Input, Cursor, Limit);
                        if Cursor == 0u32 { return Invalid(Input); }
                        Payloadˉfield = Payloadˉfield + 1u32;
                    }
                } else if Payloadˉpresent != 0u8 {
                    return Invalid(Input);
                }
            }
            Item = Item + 1u32;
        }
        }
        Index = Index + 1u32;
    }
    if Cursor != Limit { return Invalid(Input); }
    let Types: Compilerˉnativeˉx64ˉtypes = Compilerˉnativeˉx64ˉtypes(
        true,
        Count,
        Kinds,
        Itemˉoffsets,
        Itemˉcounts,
        Empty(Input)
    );

    Index = 0u32;
    while Index < Count {
        let Scanˉkind: u8 = Compilerˉnativeˉx64ˉtypeˉkind(Types, Index);
        let Scanˉitems: u32 = Compilerˉnativeˉx64ˉtypeˉitemˉcount(Types, Index);
        Cursor = Compilerˉnativeˉx64ˉtypeˉitemˉoffset(Types, Index);
        if Scanˉkind == 8u8 {
            let Callableˉprofile: u8 = Bytesˉreadˉu8(Input, Cursor);
            let Numericˉcallableˉprofile: u32 =
                U32ˉfromˉu8(Callableˉprofile);
            if Numericˉcallableˉprofile < 1u32 ||
                Numericˉcallableˉprofile > 3u32 {
                return Invalid(Input);
            }
            let Callableˉresult: Compilerˉnativeˉx64ˉshape =
                Compilerˉnativeˉx64ˉshapeˉread(
                    Input, Cursor + 1u32, Limit, Types
                );
            if !Compilerˉnativeˉx64ˉcallableˉshapeˉisˉsupported(
                Callableˉresult
            ) {
                return Invalid(Input);
            }
            Cursor = Callableˉresult.Next;
            if !Rangeˉisˉvalid(Limit, Cursor, 4u32) ||
                Bytesˉreadˉu32ˉlittle(Input, Cursor) != Scanˉitems {
                return Invalid(Input);
            }
            Cursor = Cursor + 4u32;
            var Callableˉitem: u32 = 0u32;
            while Callableˉitem < Scanˉitems {
                let Checkedˉcallableˉparameter:
                    Compilerˉnativeˉx64ˉshape =
                    Compilerˉnativeˉx64ˉshapeˉread(
                        Input, Cursor, Limit, Types
                    );
                if !Compilerˉnativeˉx64ˉcallableˉshapeˉisˉsupported(
                    Checkedˉcallableˉparameter
                ) {
                    return Invalid(Input);
                }
                Cursor = Checkedˉcallableˉparameter.Next;
                Callableˉitem = Callableˉitem + 1u32;
            }
        } else {
        var Scanˉitem: u32 = 0u32;
        while Scanˉitem < Scanˉitems {
            Cursor = Skipˉname(Input, Cursor, Limit);
            if Scanˉkind == 1u8 {
                if Allowˉvariants {
                    Cursor = Checkedˉhostedˉshape(
                        Input,
                        Cursor,
                        Limit,
                        Types,
                        true
                    );
                    if Cursor == 0u32 { return Invalid(Input); }
                } else {
                    let Shape: Compilerˉnativeˉx64ˉshape =
                        Compilerˉnativeˉx64ˉshapeˉread(
                            Input,
                            Cursor,
                            Limit,
                            Types
                        );
                    if !Shape.Valid { return Invalid(Input); }
                    Cursor = Shape.Next;
                }
            } else if Scanˉkind == 2u8 {
                Cursor = Cursor + 4u32;
            } else if Scanˉkind == 7u8 {
                Cursor = Cursor + 1u32;
            } else {
                let Scanˉpayloadˉpresent: u8 = Bytesˉreadˉu8(Input, Cursor);
                Cursor = Cursor + 1u32;
                if Scanˉpayloadˉpresent == 1u8 {
                    Cursor = Skipˉname(Input, Cursor, Limit);
                    if Cursor == 0u32 { return Invalid(Input); }
                    Cursor = Checkedˉhostedˉshape(
                        Input,
                        Cursor,
                        Limit,
                        Types,
                        true
                    );
                    if Cursor == 0u32 { return Invalid(Input); }
                } else if Scanˉpayloadˉpresent == 2u8 {
                    if !Rangeˉisˉvalid(Limit, Cursor, 4u32) {
                        return Invalid(Input);
                    }
                    let Scanˉfields: u32 = Bytesˉreadˉu32ˉlittle(Input, Cursor);
                    Cursor = Cursor + 4u32;
                    var Scanˉfield: u32 = 0u32;
                    while Scanˉfield < Scanˉfields {
                        Cursor = Skipˉname(Input, Cursor, Limit);
                        if Cursor == 0u32 { return Invalid(Input); }
                        Cursor = Checkedˉhostedˉshape(
                            Input, Cursor, Limit, Types, true
                        );
                        if Cursor == 0u32 { return Invalid(Input); }
                        Scanˉfield = Scanˉfield + 1u32;
                    }
                }
            }
            Scanˉitem = Scanˉitem + 1u32;
        }
        }
        Index = Index + 1u32;
    }
    var Recordˉwidths: bytes = Empty(Input);
    Index = 0u32;
    while Index < Count {
        let Widthˉkind: u8 = Compilerˉnativeˉx64ˉtypeˉkind(
            Types,
            Index
        );
        if Widthˉkind == 1u8 || Widthˉkind == 3u8 {
            let Width: u32 =
                Compilerˉnativeˉx64ˉrecordˉwidth(Input, Types, Index);
            if Width == 0u32 {
                return Invalid(Input);
            }
            Recordˉwidths = Bytesˉconcat(
                Recordˉwidths,
                Bytesˉfromˉu32ˉlittle(Width)
            );
        } else {
            Recordˉwidths = Bytesˉconcat(
                Recordˉwidths,
                Bytesˉfromˉu32ˉlittle(0u32)
            );
        }
        Index = Index + 1u32;
    }
    return Compilerˉnativeˉx64ˉtypes(
        Types.Valid,
        Types.Count,
        Types.Kinds,
        Types.Itemˉoffsets,
        Types.Itemˉcounts,
        Recordˉwidths
    );
}

export fn Compilerˉnativeˉx64ˉtypesˉread(
    Input: bytes,
    Offset: u32,
    Length: u32
) -> Compilerˉnativeˉx64ˉtypes {
    return Compilerˉnativeˉx64ˉtypesˉreadˉmode(
        Input,
        Offset,
        Length,
        false
    );
}

export fn Compilerˉnativeˉx64ˉhostedˉtypesˉread(
    Input: bytes,
    Offset: u32,
    Length: u32
) -> Compilerˉnativeˉx64ˉtypes {
    return Compilerˉnativeˉx64ˉtypesˉreadˉmode(
        Input,
        Offset,
        Length,
        true
    );
}

export fn Compilerˉnativeˉx64ˉcallableˉprofile(
    Input: bytes,
    Types: Compilerˉnativeˉx64ˉtypes,
    Typeˉindex: u32
) -> u8 {
    if Typeˉindex >= Types.Count ||
        Compilerˉnativeˉx64ˉtypeˉkind(Types, Typeˉindex) != 8u8 {
        return 0u8;
    }
    return Bytesˉreadˉu8(
        Input,
        Compilerˉnativeˉx64ˉtypeˉitemˉoffset(Types, Typeˉindex)
    );
}

export fn Compilerˉnativeˉx64ˉcallableˉresult(
    Input: bytes,
    Types: Compilerˉnativeˉx64ˉtypes,
    Typeˉindex: u32
) -> Compilerˉnativeˉx64ˉshape {
    if Compilerˉnativeˉx64ˉcallableˉprofile(
        Input, Types, Typeˉindex
    ) == 0u8 {
        return Invalidˉshape();
    }
    return Compilerˉnativeˉx64ˉshapeˉread(
        Input,
        Compilerˉnativeˉx64ˉtypeˉitemˉoffset(Types, Typeˉindex) + 1u32,
        Bytesˉlength(Input),
        Types
    );
}

export fn Compilerˉnativeˉx64ˉcallableˉparameters(
    Types: Compilerˉnativeˉx64ˉtypes,
    Typeˉindex: u32
) -> u32 {
    if Typeˉindex >= Types.Count ||
        Compilerˉnativeˉx64ˉtypeˉkind(Types, Typeˉindex) != 8u8 {
        return 4294967295u32;
    }
    return Compilerˉnativeˉx64ˉtypeˉitemˉcount(Types, Typeˉindex);
}

export fn Compilerˉnativeˉx64ˉcallableˉparameter(
    Input: bytes,
    Types: Compilerˉnativeˉx64ˉtypes,
    Typeˉindex: u32,
    Parameterˉindex: u32
) -> Compilerˉnativeˉx64ˉshape {
    let Parameters: u32 = Compilerˉnativeˉx64ˉcallableˉparameters(
        Types, Typeˉindex
    );
    if Parameterˉindex >= Parameters { return Invalidˉshape(); }
    let Result: Compilerˉnativeˉx64ˉshape =
        Compilerˉnativeˉx64ˉcallableˉresult(Input, Types, Typeˉindex);
    if !Result.Valid { return Invalidˉshape(); }
    var Cursor: u32 = Result.Next + 4u32;
    var Parameter: u32 = 0u32;
    while Parameter <= Parameterˉindex {
        let Shape: Compilerˉnativeˉx64ˉshape =
            Compilerˉnativeˉx64ˉshapeˉread(
                Input, Cursor, Bytesˉlength(Input), Types
            );
        if !Shape.Valid { return Invalidˉshape(); }
        if Parameter == Parameterˉindex { return Shape; }
        Cursor = Shape.Next;
        Parameter = Parameter + 1u32;
    }
    return Invalidˉshape();
}

export fn Compilerˉnativeˉx64ˉenumˉmemberˉvalue(
    Input: bytes,
    Types: Compilerˉnativeˉx64ˉtypes,
    Typeˉindex: u32,
    Memberˉindex: u32
) -> i32 {
    var Width: u32 = 4u32;
    if Compilerˉnativeˉx64ˉtypeˉkind(Types, Typeˉindex) == 7u8 {
        Width = 1u32;
    }
    var Cursor: u32 = Compilerˉnativeˉx64ˉtypeˉitemˉoffset(
        Types,
        Typeˉindex
    );
    var Member: u32 = 0u32;
    while Member < Memberˉindex {
        let Nameˉlength: u32 = Bytesˉreadˉu32ˉlittle(Input, Cursor);
        Cursor = Cursor + 4u32 + Nameˉlength + Width;
        Member = Member + 1u32;
    }
    let Selectedˉlength: u32 = Bytesˉreadˉu32ˉlittle(Input, Cursor);
    if Width == 1u32 {
        return Bytesˉreadˉi32ˉlittle(
            Bytesˉfromˉu32ˉlittle(U32ˉfromˉu8(Bytesˉreadˉu8(
                Input, Cursor + 4u32 + Selectedˉlength
            ))),
            0u32
        );
    }
    return Bytesˉreadˉi32ˉlittle(Input, Cursor + 4u32 + Selectedˉlength);
}

export fn Compilerˉnativeˉx64ˉrecordˉfieldˉtype(
    Input: bytes,
    Types: Compilerˉnativeˉx64ˉtypes,
    Typeˉindex: u32,
    Fieldˉindex: u32
) -> u8 {
    var Cursor: u32 = Compilerˉnativeˉx64ˉtypeˉitemˉoffset(
        Types,
        Typeˉindex
    );
    var Field: u32 = 0u32;
    while Field <= Fieldˉindex {
        Cursor = Skipˉname(Input, Cursor, Bytesˉlength(Input));
        let Shape: Compilerˉnativeˉx64ˉshape =
            Compilerˉnativeˉx64ˉshapeˉread(
                Input,
                Cursor,
                Bytesˉlength(Input),
                Types
            );
        if Field == Fieldˉindex { return Shape.Type; }
        Cursor = Shape.Next;
        Field = Field + 1u32;
    }
    return 0u8;
}

export fn Compilerˉnativeˉx64ˉvariantˉcaseˉpayload(
    Input: bytes,
    Types: Compilerˉnativeˉx64ˉtypes,
    Typeˉindex: u32,
    Caseˉindex: u32
) -> Compilerˉnativeˉx64ˉshape {
    if Typeˉindex >= Types.Count ||
        Compilerˉnativeˉx64ˉtypeˉkind(Types, Typeˉindex) != 3u8 ||
        Caseˉindex >= Compilerˉnativeˉx64ˉtypeˉitemˉcount(
            Types,
            Typeˉindex
        ) {
        return Invalidˉshape();
    }
    var Cursor: u32 = Compilerˉnativeˉx64ˉtypeˉitemˉoffset(
        Types,
        Typeˉindex
    );
    var Case: u32 = 0u32;
    while Case <= Caseˉindex {
        Cursor = Skipˉname(Input, Cursor, Bytesˉlength(Input));
        if Cursor == 0u32 { return Invalidˉshape(); }
        let Present: u8 = Bytesˉreadˉu8(Input, Cursor);
        Cursor = Cursor + 1u32;
        if Case == Caseˉindex {
            if Present == 0u8 {
                return Compilerˉnativeˉx64ˉshape(
                    true, Cursor, 0u8, 4294967295u32
                );
            }
            if Present != 1u8 { return Invalidˉshape(); }
            Cursor = Skipˉname(Input, Cursor, Bytesˉlength(Input));
            if Cursor == 0u32 { return Invalidˉshape(); }
            return Compilerˉnativeˉx64ˉshapeˉread(
                Input,
                Cursor,
                Bytesˉlength(Input),
                Types
            );
        }
        if Present == 1u8 {
            Cursor = Skipˉname(Input, Cursor, Bytesˉlength(Input));
            if Cursor == 0u32 { return Invalidˉshape(); }
            Cursor = Skipˉhostedˉshape(
                Input,
                Cursor,
                Bytesˉlength(Input)
            );
            if Cursor == 0u32 { return Invalidˉshape(); }
        } else if Present == 2u8 {
            if !Rangeˉisˉvalid(Bytesˉlength(Input), Cursor, 4u32) {
                return Invalidˉshape();
            }
            let Fields: u32 = Bytesˉreadˉu32ˉlittle(Input, Cursor);
            Cursor = Cursor + 4u32;
            if Fields < 2u32 || Fields > 64u32 {
                return Invalidˉshape();
            }
            var Field: u32 = 0u32;
            while Field < Fields {
                Cursor = Skipˉname(Input, Cursor, Bytesˉlength(Input));
                if Cursor == 0u32 { return Invalidˉshape(); }
                Cursor = Skipˉhostedˉshape(
                    Input, Cursor, Bytesˉlength(Input)
                );
                if Cursor == 0u32 { return Invalidˉshape(); }
                Field = Field + 1u32;
            }
        } else if Present != 0u8 {
            return Invalidˉshape();
        }
        Case = Case + 1u32;
    }
    return Invalidˉshape();
}

export fn Compilerˉnativeˉx64ˉvariantˉcaseˉfield(
    Input: bytes,
    Types: Compilerˉnativeˉx64ˉtypes,
    Typeˉindex: u32,
    Caseˉindex: u32,
    Fieldˉindex: u32
) -> Compilerˉnativeˉx64ˉshape {
    if Typeˉindex >= Types.Count ||
        Compilerˉnativeˉx64ˉtypeˉkind(Types, Typeˉindex) != 3u8 ||
        Caseˉindex >= Compilerˉnativeˉx64ˉtypeˉitemˉcount(
            Types, Typeˉindex
        ) {
        return Invalidˉshape();
    }
    var Cursor: u32 = Compilerˉnativeˉx64ˉtypeˉitemˉoffset(
        Types, Typeˉindex
    );
    var Case: u32 = 0u32;
    while Case <= Caseˉindex {
        Cursor = Skipˉname(Input, Cursor, Bytesˉlength(Input));
        if Cursor == 0u32 { return Invalidˉshape(); }
        let Encoding: u8 = Bytesˉreadˉu8(Input, Cursor);
        Cursor = Cursor + 1u32;
        if Encoding == 0u8 {
            if Case == Caseˉindex { return Invalidˉshape(); }
        } else if Encoding == 1u8 {
            Cursor = Skipˉname(Input, Cursor, Bytesˉlength(Input));
            if Cursor == 0u32 { return Invalidˉshape(); }
            let Singleˉshape: Compilerˉnativeˉx64ˉshape =
                Compilerˉnativeˉx64ˉshapeˉread(
                    Input, Cursor, Bytesˉlength(Input), Types
                );
            if !Singleˉshape.Valid { return Invalidˉshape(); }
            if Case == Caseˉindex {
                if Fieldˉindex != 0u32 { return Invalidˉshape(); }
                return Singleˉshape;
            }
            Cursor = Singleˉshape.Next;
        } else if Encoding == 2u8 {
            if !Rangeˉisˉvalid(Bytesˉlength(Input), Cursor, 4u32) {
                return Invalidˉshape();
            }
            let Fields: u32 = Bytesˉreadˉu32ˉlittle(Input, Cursor);
            Cursor = Cursor + 4u32;
            if Fields < 2u32 || Fields > 64u32 ||
                (Case == Caseˉindex && Fieldˉindex >= Fields) {
                return Invalidˉshape();
            }
            var Field: u32 = 0u32;
            while Field < Fields {
                Cursor = Skipˉname(Input, Cursor, Bytesˉlength(Input));
                if Cursor == 0u32 { return Invalidˉshape(); }
                let Inlineˉshape: Compilerˉnativeˉx64ˉshape =
                    Compilerˉnativeˉx64ˉshapeˉread(
                        Input, Cursor, Bytesˉlength(Input), Types
                    );
                if !Inlineˉshape.Valid { return Invalidˉshape(); }
                if Case == Caseˉindex && Field == Fieldˉindex {
                    return Inlineˉshape;
                }
                Cursor = Inlineˉshape.Next;
                Field = Field + 1u32;
            }
        } else {
            return Invalidˉshape();
        }
        Case = Case + 1u32;
    }
    return Invalidˉshape();
}

fn Compilerˉnativeˉx64ˉvariantˉcaseˉencoding(
    Input: bytes,
    Types: Compilerˉnativeˉx64ˉtypes,
    Typeˉindex: u32,
    Caseˉindex: u32
) -> u8 {
    if Typeˉindex >= Types.Count ||
        Compilerˉnativeˉx64ˉtypeˉkind(Types, Typeˉindex) != 3u8 ||
        Caseˉindex >=
        Compilerˉnativeˉx64ˉtypeˉitemˉcount(Types, Typeˉindex) {
        return 255u8;
    }
    var Cursor: u32 = Compilerˉnativeˉx64ˉtypeˉitemˉoffset(
        Types, Typeˉindex
    );
    var Case: u32 = 0u32;
    while Case <= Caseˉindex {
        Cursor = Skipˉname(Input, Cursor, Bytesˉlength(Input));
        if Cursor == 0u32 { return 255u8; }
        let Encoding: u8 = Bytesˉreadˉu8(Input, Cursor);
        Cursor = Cursor + 1u32;
        if Case == Caseˉindex { return Encoding; }
        if Encoding == 1u8 {
            Cursor = Skipˉname(Input, Cursor, Bytesˉlength(Input));
            if Cursor == 0u32 { return 255u8; }
            Cursor = Skipˉhostedˉshape(
                Input, Cursor, Bytesˉlength(Input)
            );
            if Cursor == 0u32 { return 255u8; }
        } else if Encoding == 2u8 {
            if !Rangeˉisˉvalid(Bytesˉlength(Input), Cursor, 4u32) {
                return 255u8;
            }
            let Fields: u32 = Bytesˉreadˉu32ˉlittle(Input, Cursor);
            Cursor = Cursor + 4u32;
            var Field: u32 = 0u32;
            while Field < Fields {
                Cursor = Skipˉname(Input, Cursor, Bytesˉlength(Input));
                if Cursor == 0u32 { return 255u8; }
                Cursor = Skipˉhostedˉshape(
                    Input, Cursor, Bytesˉlength(Input)
                );
                if Cursor == 0u32 { return 255u8; }
                Field = Field + 1u32;
            }
        } else if Encoding != 0u8 {
            return 255u8;
        }
        Case = Case + 1u32;
    }
    return 255u8;
}

export fn Compilerˉnativeˉx64ˉvariantˉcaseˉfieldˉbackingˉoffset(
    Input: bytes,
    Types: Compilerˉnativeˉx64ˉtypes,
    Typeˉindex: u32,
    Caseˉindex: u32,
    Fieldˉindex: u32
) -> u32 {
    let Selected: Compilerˉnativeˉx64ˉshape =
        Compilerˉnativeˉx64ˉvariantˉcaseˉfield(
            Input, Types, Typeˉindex, Caseˉindex, Fieldˉindex
        );
    if !Selected.Valid { return 0u32; }
    let Encoding: u8 = Compilerˉnativeˉx64ˉvariantˉcaseˉencoding(
        Input, Types, Typeˉindex, Caseˉindex
    );
    if Encoding == 1u8 {
        if Compilerˉnativeˉx64ˉtypeˉisˉrecord(Selected.Type) {
            return 2u32;
        }
        return 1u32;
    }
    if Encoding != 2u8 { return 0u32; }
    if !Compilerˉnativeˉx64ˉtypeˉisˉrecord(Selected.Type) {
        return 2u32 + Fieldˉindex;
    }
    var Fields: u32 = Fieldˉindex + 1u32;
    var Hasˉfield: bool = true;
    while Hasˉfield {
        if Fields >= 64u32 {
            Hasˉfield = false;
        } else {
            let Candidate: Compilerˉnativeˉx64ˉshape =
                Compilerˉnativeˉx64ˉvariantˉcaseˉfield(
                    Input, Types, Typeˉindex, Caseˉindex, Fields
                );
            Hasˉfield = Candidate.Valid;
            if Hasˉfield { Fields = Fields + 1u32; }
        }
    }
    var Offset: u32 = 2u32 + Fields;
    var Prior: u32 = 0u32;
    while Prior < Fieldˉindex {
        let Priorˉshape: Compilerˉnativeˉx64ˉshape =
            Compilerˉnativeˉx64ˉvariantˉcaseˉfield(
                Input, Types, Typeˉindex, Caseˉindex, Prior
            );
        if Compilerˉnativeˉx64ˉtypeˉisˉrecord(Priorˉshape.Type) {
            Offset = Offset + Compilerˉnativeˉx64ˉrecordˉwidth(
                Input,
                Types,
                Compilerˉnativeˉx64ˉrecordˉtypeˉindex(Priorˉshape.Type)
            );
        }
        Prior = Prior + 1u32;
    }
    return Offset;
}

fn Compilerˉnativeˉx64ˉvariantˉwidthˉfrom(
    Input: bytes,
    Types: Compilerˉnativeˉx64ˉtypes,
    Typeˉindex: u32,
    Rootˉtype: u32,
    Depth: u32
) -> u32 {
    let Cases: u32 = Compilerˉnativeˉx64ˉtypeˉitemˉcount(
        Types,
        Typeˉindex
    );
    var Variantˉwidth: u32 = 1u32;
    var Cursor: u32 = Compilerˉnativeˉx64ˉtypeˉitemˉoffset(
        Types,
        Typeˉindex
    );
    var Case: u32 = 0u32;
    while Case < Cases {
        Cursor = Skipˉname(Input, Cursor, Bytesˉlength(Input));
        if Cursor == 0u32 { return 0u32; }
        let Encoding: u8 = Bytesˉreadˉu8(Input, Cursor);
        Cursor = Cursor + 1u32;
        var Caseˉwidth: u32 = 1u32;
        if Encoding == 1u8 {
            Cursor = Skipˉname(Input, Cursor, Bytesˉlength(Input));
            if Cursor == 0u32 { return 0u32; }
            let Payload: Compilerˉnativeˉx64ˉshape =
                Compilerˉnativeˉx64ˉshapeˉread(
                    Input, Cursor, Bytesˉlength(Input), Types
                );
            if !Payload.Valid { return 0u32; }
            Cursor = Payload.Next;
            Caseˉwidth = 2u32;
            if Compilerˉnativeˉx64ˉtypeˉisˉrecord(Payload.Type) {
                let Childˉwidth: u32 =
                    Compilerˉnativeˉx64ˉrecordˉwidthˉfrom(
                        Input,
                        Types,
                        Compilerˉnativeˉx64ˉrecordˉtypeˉindex(
                            Payload.Type
                        ),
                        Rootˉtype,
                        Depth + 1u32
                    );
                if Childˉwidth == 0u32 || Childˉwidth > 62u32 {
                    return 0u32;
                }
                Caseˉwidth = 2u32 + Childˉwidth;
            }
        } else if Encoding == 2u8 {
            let Inlineˉfields: u32 = Bytesˉreadˉu32ˉlittle(Input, Cursor);
            Cursor = Cursor + 4u32;
            if Inlineˉfields < 2u32 || Inlineˉfields > 64u32 {
                return 0u32;
            }
            var Inlineˉwidth: u32 = Inlineˉfields;
            var Inlineˉfield: u32 = 0u32;
            while Inlineˉfield < Inlineˉfields {
                Cursor = Skipˉname(Input, Cursor, Bytesˉlength(Input));
                if Cursor == 0u32 { return 0u32; }
                let Inlineˉshape: Compilerˉnativeˉx64ˉshape =
                    Compilerˉnativeˉx64ˉshapeˉread(
                        Input, Cursor, Bytesˉlength(Input), Types
                    );
                if !Inlineˉshape.Valid { return 0u32; }
                Cursor = Inlineˉshape.Next;
                if Compilerˉnativeˉx64ˉtypeˉisˉrecord(
                    Inlineˉshape.Type
                ) {
                    let Inlineˉchildˉwidth: u32 =
                        Compilerˉnativeˉx64ˉrecordˉwidthˉfrom(
                            Input,
                            Types,
                            Compilerˉnativeˉx64ˉrecordˉtypeˉindex(
                                Inlineˉshape.Type
                            ),
                            Rootˉtype,
                            Depth + 1u32
                        );
                    if Inlineˉchildˉwidth == 0u32 ||
                        Inlineˉwidth > 62u32 - Inlineˉchildˉwidth {
                        return 0u32;
                    }
                    Inlineˉwidth = Inlineˉwidth + Inlineˉchildˉwidth;
                }
                Inlineˉfield = Inlineˉfield + 1u32;
            }
            Caseˉwidth = 2u32 + Inlineˉwidth;
        } else if Encoding != 0u8 {
            return 0u32;
        }
        if Caseˉwidth > Variantˉwidth {
            Variantˉwidth = Caseˉwidth;
        }
        Case = Case + 1u32;
    }
    return Variantˉwidth;
}

fn Compilerˉnativeˉx64ˉrecordˉwidthˉfrom(
    Input: bytes,
    Types: Compilerˉnativeˉx64ˉtypes,
    Typeˉindex: u32,
    Rootˉtype: u32,
    Depth: u32
) -> u32 {
    if Typeˉindex >= Types.Count || Depth >= 64u32 {
        return 0u32;
    }
    let Kind: u8 = Compilerˉnativeˉx64ˉtypeˉkind(
        Types,
        Typeˉindex
    );
    if Kind != 1u8 && Kind != 3u8 {
        return 0u32;
    }
    if Kind == 1u8 && Typeˉindex >=
            Compilerˉnativeˉx64ˉrecordˉtypesˉlimit() {
        return 0u32;
    }
    if Kind == 3u8 && Typeˉindex >= 64u32 { return 0u32; }
    if Depth > 0u32 && Typeˉindex == Rootˉtype { return 0u32; }
    if Kind == 3u8 {
        return Compilerˉnativeˉx64ˉvariantˉwidthˉfrom(
            Input,
            Types,
            Typeˉindex,
            Rootˉtype,
            Depth
        );
    }
    let Fields: u32 = Compilerˉnativeˉx64ˉtypeˉitemˉcount(
        Types,
        Typeˉindex
    );
    var Width: u32 = Fields;
    var Field: u32 = 0u32;
    while Field < Fields {
        let Fieldˉtype: u8 = Compilerˉnativeˉx64ˉrecordˉfieldˉtype(
            Input,
            Types,
            Typeˉindex,
            Field
        );
        if Compilerˉnativeˉx64ˉtypeˉisˉrecord(Fieldˉtype) {
            let Childˉwidth: u32 = Compilerˉnativeˉx64ˉrecordˉwidthˉfrom(
                Input,
                Types,
                Compilerˉnativeˉx64ˉrecordˉtypeˉindex(Fieldˉtype),
                Rootˉtype,
                Depth + 1u32
            );
            if Childˉwidth == 0u32 || Width > 64u32 - Childˉwidth {
                return 0u32;
            }
            Width = Width + Childˉwidth;
        }
        Field = Field + 1u32;
    }
    return Width;
}

export fn Compilerˉnativeˉx64ˉrecordˉwidth(
    Input: bytes,
    Types: Compilerˉnativeˉx64ˉtypes,
    Typeˉindex: u32
) -> u32 {
    if Bytesˉlength(Types.Recordˉwidths) == Types.Count * 4u32 {
        return Bytesˉreadˉu32ˉlittle(
            Types.Recordˉwidths,
            Typeˉindex * 4u32
        );
    }
    return Compilerˉnativeˉx64ˉrecordˉwidthˉfrom(
        Input,
        Types,
        Typeˉindex,
        Typeˉindex,
        0u32
    );
}

export fn Compilerˉnativeˉx64ˉrecordˉfieldˉbackingˉoffset(
    Input: bytes,
    Types: Compilerˉnativeˉx64ˉtypes,
    Typeˉindex: u32,
    Fieldˉindex: u32
) -> u32 {
    let Fields: u32 = Compilerˉnativeˉx64ˉtypeˉitemˉcount(
        Types,
        Typeˉindex
    );
    if Fieldˉindex >= Fields { return 0u32; }
    var Offset: u32 = Fields;
    var Field: u32 = 0u32;
    while Field < Fieldˉindex {
        let Fieldˉtype: u8 = Compilerˉnativeˉx64ˉrecordˉfieldˉtype(
            Input,
            Types,
            Typeˉindex,
            Field
        );
        if Compilerˉnativeˉx64ˉtypeˉisˉrecord(Fieldˉtype) {
            Offset = Offset + Compilerˉnativeˉx64ˉrecordˉwidth(
                Input,
                Types,
                Compilerˉnativeˉx64ˉrecordˉtypeˉindex(Fieldˉtype)
            );
        }
        Field = Field + 1u32;
    }
    return Offset;
}

fn Compilerˉnativeˉx64ˉvariantˉhasˉdescriptorsˉfrom(
    Input: bytes,
    Types: Compilerˉnativeˉx64ˉtypes,
    Typeˉindex: u32,
    Depth: u32
) -> bool {
    let Cases: u32 = Compilerˉnativeˉx64ˉtypeˉitemˉcount(
        Types,
        Typeˉindex
    );
    var Case: u32 = 0u32;
    while Case < Cases {
        let Encoding: u8 = Compilerˉnativeˉx64ˉvariantˉcaseˉencoding(
            Input, Types, Typeˉindex, Case
        );
        var Fields: u32 = 0u32;
        if Encoding == 1u8 { Fields = 1u32; }
        if Encoding == 2u8 { Fields = 64u32; }
        var Field: u32 = 0u32;
        while Field < Fields {
            let Payload: Compilerˉnativeˉx64ˉshape =
                Compilerˉnativeˉx64ˉvariantˉcaseˉfield(
                    Input, Types, Typeˉindex, Case, Field
                );
            if !Payload.Valid { Fields = Field; } else {
                if Payload.Type == 3u8 || Payload.Type == 6u8 { return true; }
                if Compilerˉnativeˉx64ˉtypeˉisˉrecord(Payload.Type) {
                    if Compilerˉnativeˉx64ˉrecordˉhasˉdescriptorsˉfrom(
                        Input,
                        Types,
                        Compilerˉnativeˉx64ˉrecordˉtypeˉindex(Payload.Type),
                        Depth + 1u32
                    ) { return true; }
                }
                Field = Field + 1u32;
            }
        }
        Case = Case + 1u32;
    }
    return false;
}

fn Compilerˉnativeˉx64ˉrecordˉhasˉdescriptorsˉfrom(
    Input: bytes,
    Types: Compilerˉnativeˉx64ˉtypes,
    Typeˉindex: u32,
    Depth: u32
) -> bool {
    if Typeˉindex >= Types.Count || Depth >= 64u32 {
        return false;
    }
    let Kind: u8 = Compilerˉnativeˉx64ˉtypeˉkind(Types, Typeˉindex);
    if Kind == 1u8 && Typeˉindex >=
            Compilerˉnativeˉx64ˉrecordˉtypesˉlimit() {
        return false;
    }
    if Kind == 3u8 && Typeˉindex >= 64u32 { return false; }
    if Kind == 3u8 {
        return Compilerˉnativeˉx64ˉvariantˉhasˉdescriptorsˉfrom(
            Input,
            Types,
            Typeˉindex,
            Depth
        );
    }
    let Fields: u32 = Compilerˉnativeˉx64ˉtypeˉitemˉcount(
        Types,
        Typeˉindex
    );
    var Field: u32 = 0u32;
    while Field < Fields {
        let Type: u8 = Compilerˉnativeˉx64ˉrecordˉfieldˉtype(
            Input,
            Types,
            Typeˉindex,
            Field
        );
        if Type == 3u8 || Type == 6u8 { return true; }
        if Compilerˉnativeˉx64ˉtypeˉisˉrecord(Type) {
            if Compilerˉnativeˉx64ˉrecordˉhasˉdescriptorsˉfrom(
                Input,
                Types,
                Compilerˉnativeˉx64ˉrecordˉtypeˉindex(Type),
                Depth + 1u32
            ) { return true; }
        }
        Field = Field + 1u32;
    }
    return false;
}

export fn Compilerˉnativeˉx64ˉrecordˉhasˉdescriptors(
    Input: bytes,
    Types: Compilerˉnativeˉx64ˉtypes,
    Typeˉindex: u32
) -> bool {
    return Compilerˉnativeˉx64ˉrecordˉhasˉdescriptorsˉfrom(
        Input,
        Types,
        Typeˉindex,
        0u32
    );
}

export fn Compilerˉnativeˉx64ˉanalyzeˉscalarˉarithmetic(
    Opcode: u8,
    Stack: bytes,
    Depth: u32,
    I32ˉvalues: u32,
    U32ˉvalues: u32,
    Bodyˉbytes: u32
) -> bytes {
    let Numeric: u32 = U32ˉfromˉu8(Opcode);
    var Consumed: u32 = 2u32;
    var Type: u8 = 1u8;
    var Emittedˉbytes: u32 = 39u32;
    if Opcode == 18u8 { Emittedˉbytes = 40u32; }
    if Opcode == 19u8 {
        Consumed = 1u32;
        Emittedˉbytes = 32u32;
    }
    if Numeric >= 20u32 { Type = 5u8; }
    if Numeric >= 134u32 && Numeric <= 136u32 {
        Type = 10u8;
        Emittedˉbytes = 43u32;
        if Opcode == 136u8 { Emittedˉbytes = 46u32; }
    }
    if Opcode == 22u8 { Emittedˉbytes = 41u32; }
    if Numeric >= 173u32 { Emittedˉbytes = 33u32; }
    if Opcode == 176u8 {
        Consumed = 1u32;
        Emittedˉbytes = 26u32;
    }
    if Opcode == 177u8 || Opcode == 178u8 { Emittedˉbytes = 42u32; }
    if Depth < Consumed { return Bytesˉfromˉu8(0u8); }
    var Operand: u32 = 0u32;
    while Operand < Consumed {
        if Bytesˉreadˉu8(Stack, Depth - Operand - 1u32) != Type {
            return Bytesˉfromˉu8(0u8);
        }
        Operand = Operand + 1u32;
    }
    let Resultˉdepth: u32 = Depth - Consumed + 1u32;
    let Resultˉstack: bytes = Bytesˉconcat(
        Bytesˉslice(Stack, 0u32, Depth - Consumed),
        Bytesˉfromˉu8(Type)
    );
    var Resultˉi32ˉvalues: u32 = I32ˉvalues;
    var Resultˉu32ˉvalues: u32 = U32ˉvalues;
    if Type == 1u8 {
        Resultˉi32ˉvalues = Resultˉi32ˉvalues + 1u32;
    } else {
        Resultˉu32ˉvalues = Resultˉu32ˉvalues + 1u32;
    }
    var Result: bytes = Bytesˉfromˉu8(1u8);
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Resultˉdepth));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Resultˉi32ˉvalues));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Resultˉu32ˉvalues));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Bodyˉbytes + Emittedˉbytes));
    return Bytesˉconcat(Result, Resultˉstack);
}
