module Compilerˉwebassemblyˉdescriptorˉoperations profile portable;

import Compilerˉwebassemblyˉbinaryˉencoding as Encoding;
import Compilerˉwebassemblyˉstaticˉdata as Staticˉdata;
import Compilerˉwebassemblyˉdescriptorˉstorage as Storage;

export record Compilerˉwebassemblyˉdescriptorˉoperationˉemission {
    Matched: bool;
    Valid: bool;
    Bytes: bytes;
}

export record Compilerˉwebassemblyˉdescriptorˉruntime {
    Scratchˉpointer: u32;
    Scratchˉwideˉleft: u32;
    Scratchˉwideˉresult: u32;
    Manageˉownership: bool;
    Allocateˉfunction: u32;
    Referenceˉfunction: u32;
}

fn Empty(Input: bytes) -> bytes {
    return Bytesˉslice(Input, 0u32, 0u32);
}

fn Append(First: bytes, Second: bytes) -> bytes {
    return Bytesˉconcat(First, Second);
}

fn Byte(Value: u32) -> bytes {
    return Encoding.Compilerˉwebassemblyˉbinaryˉbyte(Value);
}

fn Indexed(Opcode: u32, Index: u32) -> bytes {
    return Encoding.Compilerˉwebassemblyˉbinaryˉindexedˉinstruction(
        Opcode,
        Index
    );
}

fn Positiveˉconstant(Value: u32) -> bytes {
    return Encoding.Compilerˉwebassemblyˉbinaryˉpositiveˉi32ˉconstant(
        Value
    );
}

fn I64ˉconstant(Value: u32) -> bytes {
    return Append(
        Byte(66u32),
        Encoding.Compilerˉwebassemblyˉbinaryˉpositiveˉsleb32(Value)
    );
}

fn Emitˉearlyˉreturn(Returnsˉvalue: bool, Returnsˉi64: bool) -> bytes {
    var Result: bytes = Byte(15u32);
    if Returnsˉvalue {
        if Returnsˉi64 {
            Result = Append(I64ˉconstant(0u32), Result);
        } else {
            Result = Append(Positiveˉconstant(0u32), Result);
        }
    }
    return Result;
}

fn Emitˉfailureˉguard(
    Status: u32,
    Returnsˉvalue: bool,
    Returnsˉi64: bool,
    Statusˉglobal: u32
) -> bytes {
    var Result: bytes = Byte(4u32);
    Result = Append(Result, Byte(64u32));
    Result = Append(Result, Positiveˉconstant(Status));
    Result = Append(Result, Indexed(36u32, Statusˉglobal));
    Result = Append(
        Result,
        Emitˉearlyˉreturn(Returnsˉvalue, Returnsˉi64)
    );
    return Append(Result, Byte(11u32));
}

fn Emitˉdescriptorˉconstant(Pointer: u32, Length: u32) -> bytes {
    var Result: bytes = I64ˉconstant(Pointer);
    Result = Append(Result, I64ˉconstant(Length));
    Result = Append(Result, I64ˉconstant(32u32));
    Result = Append(Result, Byte(134u32));
    return Append(Result, Byte(132u32));
}

fn Emitˉpackˉdescriptor(Pointer: u32, Length: u32) -> bytes {
    var Result: bytes = Indexed(32u32, Pointer);
    Result = Append(Result, Byte(173u32));
    Result = Append(Result, Indexed(32u32, Length));
    Result = Append(Result, Byte(173u32));
    Result = Append(Result, I64ˉconstant(32u32));
    Result = Append(Result, Byte(134u32));
    return Append(Result, Byte(132u32));
}

fn Emitˉmemoryˉcopy() -> bytes {
    var Result: bytes = Byte(252u32);
    Result = Append(Result, Encoding.Compilerˉwebassemblyˉbinaryˉuleb32(10u32));
    Result = Append(Result, Encoding.Compilerˉwebassemblyˉbinaryˉuleb32(0u32));
    return Append(Result, Encoding.Compilerˉwebassemblyˉbinaryˉuleb32(0u32));
}

fn Emitˉlengthˉvalue() -> bytes {
    var Result: bytes = I64ˉconstant(32u32);
    Result = Append(Result, Byte(136u32));
    return Append(Result, Byte(167u32));
}

fn Emitˉlength(
    Scratchˉresult: u32,
    Scratchˉdescriptor: u32,
    Manageˉownership: bool,
    Referenceˉfunction: u32
) -> bytes {
    if !Manageˉownership { return Emitˉlengthˉvalue(); }
    var Result: bytes = Indexed(33u32, Scratchˉdescriptor);
    Result = Append(Result, Indexed(32u32, Scratchˉdescriptor));
    Result = Append(Result, Emitˉlengthˉvalue());
    Result = Append(Result, Indexed(33u32, Scratchˉresult));
    Result = Append(
        Result,
        Storage.Compilerˉwebassemblyˉdescriptorˉstorageˉreferenceˉlocal(
            Scratchˉdescriptor,
            false,
            Referenceˉfunction
        )
    );
    return Append(Result, Indexed(32u32, Scratchˉresult));
}

fn Emitˉslice(
    Scratchˉlength: u32,
    Scratchˉoffset: u32,
    Scratchˉresult: u32,
    Scratchˉdescriptor: u32,
    Returnsˉvalue: bool,
    Returnsˉi64: bool,
    Statusˉglobal: u32,
    Manageˉownership: bool,
    Referenceˉfunction: u32,
    Scratchˉpointer: u32,
    Scratchˉwideˉresult: u32,
    Allocateˉfunction: u32
) -> bytes {
    var Result: bytes = Indexed(33u32, Scratchˉresult);
    Result = Append(Result, Indexed(33u32, Scratchˉoffset));
    Result = Append(Result, Indexed(33u32, Scratchˉdescriptor));
    Result = Append(Result, Indexed(32u32, Scratchˉdescriptor));
    Result = Append(Result, Emitˉlengthˉvalue());
    Result = Append(Result, Indexed(33u32, Scratchˉlength));

    Result = Append(Result, Indexed(32u32, Scratchˉoffset));
    Result = Append(Result, Indexed(32u32, Scratchˉlength));
    Result = Append(Result, Byte(75u32));
    Result = Append(
        Result,
        Emitˉfailureˉguard(
            3008u32,
            Returnsˉvalue,
            Returnsˉi64,
            Statusˉglobal
        )
    );
    Result = Append(Result, Indexed(32u32, Scratchˉresult));
    Result = Append(Result, Indexed(32u32, Scratchˉlength));
    Result = Append(Result, Indexed(32u32, Scratchˉoffset));
    Result = Append(Result, Byte(107u32));
    Result = Append(Result, Byte(75u32));
    Result = Append(
        Result,
        Emitˉfailureˉguard(
            3008u32,
            Returnsˉvalue,
            Returnsˉi64,
            Statusˉglobal
        )
    );

    if !Manageˉownership {
        Result = Append(Result, Indexed(32u32, Scratchˉdescriptor));
        Result = Append(Result, Byte(167u32));
        Result = Append(Result, Indexed(32u32, Scratchˉoffset));
        Result = Append(Result, Byte(106u32));
        Result = Append(Result, Byte(173u32));
        Result = Append(Result, Indexed(32u32, Scratchˉresult));
        Result = Append(Result, Byte(173u32));
        Result = Append(Result, I64ˉconstant(32u32));
        Result = Append(Result, Byte(134u32));
        return Append(Result, Byte(132u32));
    }

    Result = Append(Result, Indexed(32u32, Scratchˉresult));
    Result = Append(Result, Byte(69u32));
    Result = Append(Result, Byte(4u32));
    Result = Append(Result, Byte(64u32));
    Result = Append(
        Result,
        Storage.Compilerˉwebassemblyˉdescriptorˉstorageˉreferenceˉlocal(
            Scratchˉdescriptor,
            false,
            Referenceˉfunction
        )
    );
    Result = Append(Result, I64ˉconstant(0u32));
    Result = Append(Result, Indexed(33u32, Scratchˉwideˉresult));
    Result = Append(Result, Byte(5u32));

    Result = Append(Result, Indexed(32u32, Scratchˉresult));
    Result = Append(Result, Indexed(16u32, Allocateˉfunction));
    Result = Append(Result, Indexed(34u32, Scratchˉpointer));
    Result = Append(Result, Byte(69u32));
    Result = Append(
        Result,
        Emitˉfailureˉguard(
            3018u32,
            Returnsˉvalue,
            Returnsˉi64,
            Statusˉglobal
        )
    );
    Result = Append(Result, Indexed(32u32, Scratchˉpointer));
    Result = Append(Result, Indexed(32u32, Scratchˉdescriptor));
    Result = Append(Result, Byte(167u32));
    Result = Append(Result, Indexed(32u32, Scratchˉoffset));
    Result = Append(Result, Byte(106u32));
    Result = Append(Result, Indexed(32u32, Scratchˉresult));
    Result = Append(Result, Emitˉmemoryˉcopy());
    Result = Append(
        Result,
        Emitˉpackˉdescriptor(Scratchˉpointer, Scratchˉresult)
    );
    Result = Append(Result, Indexed(33u32, Scratchˉwideˉresult));
    Result = Append(
        Result,
        Storage.Compilerˉwebassemblyˉdescriptorˉstorageˉreferenceˉlocal(
            Scratchˉdescriptor,
            false,
            Referenceˉfunction
        )
    );
    Result = Append(Result, Byte(11u32));
    return Append(Result, Indexed(32u32, Scratchˉwideˉresult));
}

fn Emitˉread(
    Opcode: u8,
    Scratchˉlength: u32,
    Scratchˉoffset: u32,
    Scratchˉwidth: u32,
    Scratchˉdescriptor: u32,
    Returnsˉvalue: bool,
    Returnsˉi64: bool,
    Statusˉglobal: u32,
    Manageˉownership: bool,
    Referenceˉfunction: u32
) -> bytes {
    var Width: u32 = 4u32;
    var Loadˉopcode: u32 = 40u32;
    var Alignment: u32 = 2u32;
    if Opcode == 13u8 {
        Width = 1u32;
        Loadˉopcode = 45u32;
        Alignment = 0u32;
    }
    if Opcode == 14u8 {
        Width = 2u32;
        Loadˉopcode = 47u32;
        Alignment = 1u32;
    }

    var Result: bytes = Indexed(33u32, Scratchˉoffset);
    Result = Append(Result, Indexed(33u32, Scratchˉdescriptor));
    Result = Append(Result, Indexed(32u32, Scratchˉdescriptor));
    Result = Append(Result, Emitˉlengthˉvalue());
    Result = Append(Result, Indexed(33u32, Scratchˉlength));
    Result = Append(Result, Positiveˉconstant(Width));
    Result = Append(Result, Indexed(33u32, Scratchˉwidth));

    Result = Append(Result, Indexed(32u32, Scratchˉoffset));
    Result = Append(Result, Indexed(32u32, Scratchˉlength));
    Result = Append(Result, Byte(75u32));
    Result = Append(
        Result,
        Emitˉfailureˉguard(
            3008u32,
            Returnsˉvalue,
            Returnsˉi64,
            Statusˉglobal
        )
    );
    Result = Append(Result, Indexed(32u32, Scratchˉwidth));
    Result = Append(Result, Indexed(32u32, Scratchˉlength));
    Result = Append(Result, Indexed(32u32, Scratchˉoffset));
    Result = Append(Result, Byte(107u32));
    Result = Append(Result, Byte(75u32));
    Result = Append(
        Result,
        Emitˉfailureˉguard(
            3008u32,
            Returnsˉvalue,
            Returnsˉi64,
            Statusˉglobal
        )
    );

    Result = Append(Result, Indexed(32u32, Scratchˉdescriptor));
    Result = Append(Result, Byte(167u32));
    Result = Append(Result, Indexed(32u32, Scratchˉoffset));
    Result = Append(Result, Byte(106u32));
    Result = Append(Result, Byte(Loadˉopcode));
    Result = Append(Result, Encoding.Compilerˉwebassemblyˉbinaryˉuleb32(Alignment));
    Result = Append(Result, Encoding.Compilerˉwebassemblyˉbinaryˉuleb32(0u32));
    if Manageˉownership {
        Result = Append(Result, Indexed(33u32, Scratchˉwidth));
        Result = Append(
            Result,
            Storage.Compilerˉwebassemblyˉdescriptorˉstorageˉreferenceˉlocal(
                Scratchˉdescriptor,
                false,
                Referenceˉfunction
            )
        );
        Result = Append(Result, Indexed(32u32, Scratchˉwidth));
    }
    return Result;
}

export fn Compilerˉwebassemblyˉdescriptorˉoperationˉemit(
    Input: bytes,
    Code: u32,
    Offset: u32,
    Opcode: u8,
    Data: Staticˉdata.Compilerˉwebassemblyˉstaticˉdataˉsummary,
    Scratchˉleft: u32,
    Scratchˉright: u32,
    Scratchˉresult: u32,
    Runtime: Compilerˉwebassemblyˉdescriptorˉruntime,
    Returnsˉvalue: bool,
    Returnsˉi64: bool,
    Statusˉglobal: u32
) -> Compilerˉwebassemblyˉdescriptorˉoperationˉemission {
    var Result: bytes = Empty(Input);
    if Opcode == 3u8 || Opcode == 10u8 {
        let Entry: Staticˉdata.Compilerˉwebassemblyˉstaticˉdataˉentry =
            Staticˉdata.Compilerˉwebassemblyˉstaticˉdataˉentryˉat(
                Data,
                Bytesˉreadˉu32ˉlittle(Input, Code + Offset + 1u32)
            );
        var Expectedˉkind: u32 = 3u32;
        if Opcode == 10u8 { Expectedˉkind = 5u32; }
        if !Entry.Valid || Entry.Kind != Expectedˉkind {
            return Compilerˉwebassemblyˉdescriptorˉoperationˉemission(
                true,
                false,
                Result
            );
        }
        return Compilerˉwebassemblyˉdescriptorˉoperationˉemission(
            true,
            true,
            Emitˉdescriptorˉconstant(
                Entry.Staticˉoffset,
                Entry.Valueˉlength
            )
        );
    }
    if Opcode == 11u8 {
        return Compilerˉwebassemblyˉdescriptorˉoperationˉemission(
            true,
            true,
            Emitˉlength(
                Scratchˉresult,
                Runtime.Scratchˉwideˉleft,
                Runtime.Manageˉownership,
                Runtime.Referenceˉfunction
            )
        );
    }
    if Opcode == 12u8 {
        return Compilerˉwebassemblyˉdescriptorˉoperationˉemission(
            true,
            true,
            Emitˉslice(
                Scratchˉleft,
                Scratchˉright,
                Scratchˉresult,
                Runtime.Scratchˉwideˉleft,
                Returnsˉvalue,
                Returnsˉi64,
                Statusˉglobal,
                Runtime.Manageˉownership,
                Runtime.Referenceˉfunction,
                Runtime.Scratchˉpointer,
                Runtime.Scratchˉwideˉresult,
                Runtime.Allocateˉfunction
            )
        );
    }
    if Opcode == 13u8 || Opcode == 14u8 || Opcode == 15u8 || Opcode == 114u8 {
        return Compilerˉwebassemblyˉdescriptorˉoperationˉemission(
            true,
            true,
            Emitˉread(
                Opcode,
                Scratchˉleft,
                Scratchˉright,
                Scratchˉresult,
                Runtime.Scratchˉwideˉleft,
                Returnsˉvalue,
                Returnsˉi64,
                Statusˉglobal,
                Runtime.Manageˉownership,
                Runtime.Referenceˉfunction
            )
        );
    }
    if Opcode == 124u8 {
        return Compilerˉwebassemblyˉdescriptorˉoperationˉemission(
            true, true, Result
        );
    }
    return Compilerˉwebassemblyˉdescriptorˉoperationˉemission(
        false, true, Result
    );
}
