module Compilerˉnativeˉx64ˉloweringˉunsafeˉscratch profile portable;

import Compilerˉnativeˉx64ˉloweringˉtypes as Nominalˉtypes;
import Compilerˉnativeˉx64ˉloweringˉlayout as Layout;
import Compilerˉnativeˉx64ˉloweringˉrecordˉinstructions as Recordˉinstructions;
import Compilerˉnativeˉx64ˉloweringˉrecordˉstorage as Recordˉstorage;
import Compilerˉnativeˉx64ˉloweringˉaffine as Affineˉownership;

export fn Compilerˉnativeˉx64ˉaffineˉownershipˉisˉvalid(
    Input: bytes,
    Codeˉoffset: u32,
    Codeˉlength: u32,
    Parameters: u32,
    Localˉtypes: bytes,
    Localˉtypeˉidentities: bytes,
    Localˉborrowˉkinds: bytes,
    Typeˉcount: u32,
    Instructions: bytes
) -> bool {
    return Affineˉownership.Compilerˉnativeˉx64ˉaffineˉownershipˉisˉvalid(
        Input,
        Codeˉoffset,
        Codeˉlength,
        Parameters,
        Localˉtypes,
        Localˉtypeˉidentities,
        Localˉborrowˉkinds,
        Typeˉcount,
        Instructions
    );
}

fn Empty() -> bytes {
    let Zero: bytes = Bytesˉfromˉu8(0u8);
    return Bytesˉslice(Zero, 0u32, 0u32);
}

fn Appendˉbyte(Result: bytes, Value: u8) -> bytes {
    return Bytesˉconcat(Result, Bytesˉfromˉu8(Value));
}

fn Appendˉu32(Result: bytes, Value: u32) -> bytes {
    return Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Value));
}

fn Relativeˉu32(Target: u32, Origin: u32) -> u32 {
    if Target >= Origin { return Target - Origin; }
    let Magnitude: u32 = Origin - Target;
    return 4294967295u32 - Magnitude + 1u32;
}

fn Loadˉrax(Result: bytes, Slot: u32) -> bytes {
    var Output: bytes = Appendˉbyte(Result, 72u8);
    Output = Appendˉbyte(Output, 139u8);
    Output = Appendˉbyte(Output, 132u8);
    Output = Appendˉbyte(Output, 36u8);
    return Appendˉu32(Output, Slot * 16u32);
}

fn Loadˉraxˉrecordˉfieldˉzero(Result: bytes, Slot: u32) -> bytes {
    var Output: bytes = Loadˉrax(Result, Slot);
    Output = Appendˉbyte(Output, 72u8);
    Output = Appendˉbyte(Output, 139u8);
    return Appendˉbyte(Output, 0u8);
}

fn Loadˉrcx(Result: bytes, Slot: u32) -> bytes {
    var Output: bytes = Appendˉbyte(Result, 72u8);
    Output = Appendˉbyte(Output, 139u8);
    Output = Appendˉbyte(Output, 140u8);
    Output = Appendˉbyte(Output, 36u8);
    return Appendˉu32(Output, Slot * 16u32);
}

fn Loadˉrdx(Result: bytes, Slot: u32) -> bytes {
    var Output: bytes = Appendˉbyte(Result, 72u8);
    Output = Appendˉbyte(Output, 139u8);
    Output = Appendˉbyte(Output, 148u8);
    Output = Appendˉbyte(Output, 36u8);
    return Appendˉu32(Output, Slot * 16u32);
}

fn Storeˉrax(Result: bytes, Slot: u32) -> bytes {
    var Output: bytes = Appendˉbyte(Result, 72u8);
    Output = Appendˉbyte(Output, 137u8);
    Output = Appendˉbyte(Output, 132u8);
    Output = Appendˉbyte(Output, 36u8);
    return Appendˉu32(Output, Slot * 16u32);
}

fn Storeˉraxˉoffset(Result: bytes, Offset: u32) -> bytes {
    var Output: bytes = Appendˉbyte(Result, 72u8);
    Output = Appendˉbyte(Output, 137u8);
    Output = Appendˉbyte(Output, 132u8);
    Output = Appendˉbyte(Output, 36u8);
    return Appendˉu32(Output, Offset);
}

fn Storeˉrcx(Result: bytes, Slot: u32) -> bytes {
    var Output: bytes = Appendˉbyte(Result, 72u8);
    Output = Appendˉbyte(Output, 137u8);
    Output = Appendˉbyte(Output, 140u8);
    Output = Appendˉbyte(Output, 36u8);
    return Appendˉu32(Output, Slot * 16u32);
}

fn Storeˉrdx(Result: bytes, Slot: u32) -> bytes {
    var Output: bytes = Appendˉbyte(Result, 72u8);
    Output = Appendˉbyte(Output, 137u8);
    Output = Appendˉbyte(Output, 148u8);
    Output = Appendˉbyte(Output, 36u8);
    return Appendˉu32(Output, Slot * 16u32);
}

fn Storeˉimmediate(Result: bytes, Slot: u32, Value: u32) -> bytes {
    var Output: bytes = Appendˉbyte(Result, 72u8);
    Output = Appendˉbyte(Output, 199u8);
    Output = Appendˉbyte(Output, 132u8);
    Output = Appendˉbyte(Output, 36u8);
    Output = Appendˉu32(Output, Slot * 16u32);
    return Appendˉu32(Output, Value);
}

fn Frameˉaddress(Result: bytes, Slot: u32) -> bytes {
    var Output: bytes = Appendˉbyte(Result, 72u8);
    Output = Appendˉbyte(Output, 141u8);
    Output = Appendˉbyte(Output, 132u8);
    Output = Appendˉbyte(Output, 36u8);
    return Appendˉu32(Output, Slot * 16u32);
}

fn Conditionalˉjump(Result: bytes, Condition: u8, Target: u32) -> bytes {
    var Output: bytes = Appendˉbyte(Result, 15u8);
    Output = Appendˉbyte(Output, Condition);
    return Appendˉu32(
        Output,
        Relativeˉu32(Target, Bytesˉlength(Output) + 4u32)
    );
}

fn Jump(Result: bytes, Target: u32) -> bytes {
    var Output: bytes = Appendˉbyte(Result, 233u8);
    return Appendˉu32(
        Output,
        Relativeˉu32(Target, Bytesˉlength(Output) + 4u32)
    );
}

fn Prefix(
    Lengthˉslot: u32,
    Alignmentˉslot: u32,
    Budgetˉslot: u32,
    Invalidˉlength: u32,
    Invalidˉalignment: u32,
    Budgetˉrefusal: u32
) -> bytes {
    var Output: bytes = Loadˉrax(Empty(), Lengthˉslot);
    Output = Loadˉrcx(Output, Alignmentˉslot);
    Output = Loadˉrdx(Output, Budgetˉslot);
    // A native budget packs remaining bytes in the low word and remaining
    // child slots in the high word. Scratch consumes the complete owner but
    // compares and reports only its byte allowance.
    Output = Appendˉbyte(Output, 137u8);
    Output = Appendˉbyte(Output, 210u8);
    Output = Storeˉimmediate(Output, Budgetˉslot, 0u32);
    Output = Appendˉbyte(Output, 72u8);
    Output = Appendˉbyte(Output, 133u8);
    Output = Appendˉbyte(Output, 192u8);
    Output = Conditionalˉjump(Output, 132u8, Invalidˉlength);
    Output = Appendˉbyte(Output, 72u8);
    Output = Appendˉbyte(Output, 131u8);
    Output = Appendˉbyte(Output, 248u8);
    Output = Appendˉbyte(Output, 64u8);
    Output = Conditionalˉjump(Output, 135u8, Invalidˉlength);
    Output = Appendˉbyte(Output, 72u8);
    Output = Appendˉbyte(Output, 133u8);
    Output = Appendˉbyte(Output, 201u8);
    Output = Conditionalˉjump(Output, 132u8, Invalidˉalignment);
    Output = Appendˉbyte(Output, 72u8);
    Output = Appendˉbyte(Output, 131u8);
    Output = Appendˉbyte(Output, 249u8);
    Output = Appendˉbyte(Output, 8u8);
    Output = Conditionalˉjump(Output, 135u8, Invalidˉalignment);
    Output = Appendˉbyte(Output, 76u8);
    Output = Appendˉbyte(Output, 141u8);
    Output = Appendˉbyte(Output, 65u8);
    Output = Appendˉbyte(Output, 255u8);
    Output = Appendˉbyte(Output, 76u8);
    Output = Appendˉbyte(Output, 133u8);
    Output = Appendˉbyte(Output, 193u8);
    Output = Conditionalˉjump(Output, 133u8, Invalidˉalignment);
    Output = Appendˉbyte(Output, 72u8);
    Output = Appendˉbyte(Output, 57u8);
    Output = Appendˉbyte(Output, 194u8);
    return Conditionalˉjump(Output, 130u8, Budgetˉrefusal);
}

fn Emitˉmachine(
    Lengthˉslot: u32,
    Alignmentˉslot: u32,
    Budgetˉslot: u32,
    Resultˉtype: u32,
    Target: u32,
    Backing: u32,
    Unsafeˉbacking: u32,
    Packedˉdescriptor: bool,
    Nativeˉbacking: bool
) -> bytes {
    let Prefixˉbytes: u32 = 98u32;
    var Successˉbytes: u32 = 29u32;
    if Packedˉdescriptor { Successˉbytes = 32u32; }
    if Nativeˉbacking { Successˉbytes = 48u32; }
    let Invalidˉlengthˉbytes: u32 = 49u32;
    let Invalidˉalignmentˉbytes: u32 = 37u32;
    let Budgetˉbytes: u32 = 52u32;
    let Invalidˉlength: u32 = Prefixˉbytes + Successˉbytes;
    let Invalidˉalignment: u32 = Invalidˉlength + Invalidˉlengthˉbytes;
    let Budgetˉrefusal: u32 = Invalidˉalignment + Invalidˉalignmentˉbytes;
    let Finish: u32 = Budgetˉrefusal + Budgetˉbytes;

    var Output: bytes = Prefix(
        Lengthˉslot,
        Alignmentˉslot,
        Budgetˉslot,
        Invalidˉlength,
        Invalidˉalignment,
        Budgetˉrefusal
    );
    Output = Storeˉimmediate(Output, Backing, 0u32);
    if Packedˉdescriptor {
        // WVB 1.36 retains the admitted construction alignment beside the
        // bounded length. Both values are at most 32 bits in this provider.
        Output = Appendˉbyte(Output, 72u8);
        Output = Appendˉbyte(Output, 193u8);
        Output = Appendˉbyte(Output, 225u8);
        Output = Appendˉbyte(Output, 32u8);
        Output = Appendˉbyte(Output, 72u8);
        Output = Appendˉbyte(Output, 9u8);
        Output = Appendˉbyte(Output, 200u8);
    }
    Output = Storeˉrax(Output, Backing + 2u32);
    if Nativeˉbacking {
        // WVB 1.38 retains the logical length/alignment descriptor in the low
        // word and stores the private frame address in its unused high word.
        // The address is never copied into source-visible state.
        Output = Frameˉaddress(Output, Unsafeˉbacking);
        Output = Storeˉraxˉoffset(
            Output,
            (Backing + 2u32) * 16u32 + 8u32
        );
    }
    if !Packedˉdescriptor {
        // Preserve the qualified block geometry after replacing the old
        // immediate sentinel with the exact length carried in rax.
        Output = Appendˉbyte(Output, 144u8);
        Output = Appendˉbyte(Output, 144u8);
        Output = Appendˉbyte(Output, 144u8);
        Output = Appendˉbyte(Output, 144u8);
    }
    Output = Jump(Output, Finish);

    Output = Storeˉimmediate(Output, Backing, 1u32);
    Output = Storeˉimmediate(Output, Backing + 2u32, 0u32);
    Output = Storeˉrax(Output, Backing + 4u32);
    Output = Storeˉimmediate(Output, Backing + 5u32, 64u32);
    Output = Jump(Output, Finish);

    Output = Storeˉimmediate(Output, Backing, 1u32);
    Output = Storeˉimmediate(Output, Backing + 2u32, 1u32);
    Output = Storeˉrcx(Output, Backing + 3u32);
    Output = Jump(Output, Finish);

    Output = Storeˉimmediate(Output, Backing, 1u32);
    Output = Storeˉimmediate(Output, Backing + 2u32, 2u32);
    Output = Storeˉimmediate(Output, Backing + 4u32, 1u32);
    Output = Storeˉrax(Output, Backing + 5u32);
    Output = Storeˉrdx(Output, Backing + 6u32);

    Output = Appendˉbyte(Output, 65u8);
    Output = Appendˉbyte(Output, 184u8);
    Output = Appendˉu32(Output, Resultˉtype);
    Output = Frameˉaddress(Output, Backing);
    return Storeˉrax(Output, Target);
}

export fn Compilerˉnativeˉx64ˉunsafeˉscratchˉbytes(
    Minor: u32
) -> u32 {
    // The common instruction-limit charge contributes ten bytes before the
    // 287-byte operation-specific sequence.
    if Minor == 38u32 { return 316u32; }
    if Minor == 36u32 || Minor == 37u32 { return 300u32; }
    return 297u32;
}

export fn Compilerˉnativeˉx64ˉunsafeˉscratchˉlengthˉbytes(
    Minor: u32
) -> u32 {
    // The common instruction-limit charge contributes ten bytes before one
    // record-handle load, its private field-zero observation, and one u64
    // result store.
    if Minor == 36u32 || Minor == 37u32 || Minor == 38u32 { return 31u32; }
    return 29u32;
}

export fn Compilerˉnativeˉx64ˉemitˉunsafeˉscratchˉlength(
    Input: bytes,
    Offset: u32,
    Shape: Recordˉinstructions.Compilerˉnativeˉx64ˉrecordˉlayout,
    State: Recordˉinstructions.Compilerˉnativeˉx64ˉrecordˉstate
) -> Recordˉinstructions.Compilerˉnativeˉx64ˉrecordˉstate {
    let Scratchˉlocal: u32 = Bytesˉreadˉu32ˉlittle(
        Input, Offset + 1u32
    );
    let Target: u32 = Layout.Compilerˉnativeˉx64ˉlayoutˉvalueˉslot(
        Shape.Locals,
        Shape.I32ˉslots,
        Shape.Boolˉslots,
        Shape.Textˉslots,
        Shape.U8ˉslots,
        Shape.U32ˉslots,
        Shape.Bytesˉslots,
        10u8,
        State.Nextˉu32
    );
    var Result: bytes = Loadˉraxˉrecordˉfieldˉzero(
        State.Result, Scratchˉlocal
    );
    let Minor: u32 = Bytesˉreadˉu16ˉlittle(Input, 6u32);
    if Minor == 36u32 || Minor == 37u32 || Minor == 38u32 {
        // Writing eax to itself retains the low descriptor word and clears
        // the private construction-alignment word.
        Result = Appendˉbyte(Result, 137u8);
        Result = Appendˉbyte(Result, 192u8);
    }
    Result = Storeˉrax(Result, Target);
    return Recordˉinstructions.Compilerˉnativeˉx64ˉrecordˉstate(
        Result,
        Bytesˉconcat(State.Stackˉtypes, Bytesˉfromˉu8(10u8)),
        Bytesˉconcat(
            State.Stackˉslots, Bytesˉfromˉu32ˉlittle(Target)
        ),
        State.Stackˉdepth + 1u32,
        State.Nextˉi32,
        State.Nextˉbool,
        State.Nextˉtext,
        State.Nextˉu8,
        State.Nextˉu32 + 1u32,
        State.Nextˉbytes,
        State.Nextˉenum,
        State.Nextˉrecord
    );
}

export fn Compilerˉnativeˉx64ˉemitˉunsafeˉscratch(
    Input: bytes,
    Offset: u32,
    Shape: Recordˉinstructions.Compilerˉnativeˉx64ˉrecordˉlayout,
    Storage: Recordˉstorage.Compilerˉnativeˉx64ˉrecordˉstorage,
    Unsafeˉbacking: u32,
    State: Recordˉinstructions.Compilerˉnativeˉx64ˉrecordˉstate
) -> Recordˉinstructions.Compilerˉnativeˉx64ˉrecordˉstate {
    let Depth: u32 = State.Stackˉdepth - 2u32;
    let Lengthˉslot: u32 = Bytesˉreadˉu32ˉlittle(
        State.Stackˉslots,
        Depth * 4u32
    );
    let Alignmentˉslot: u32 = Bytesˉreadˉu32ˉlittle(
        State.Stackˉslots,
        (Depth + 1u32) * 4u32
    );
    let Budgetˉslot: u32 = Bytesˉreadˉu32ˉlittle(Input, Offset + 1u32);
    let Resultˉtype: u32 = Bytesˉreadˉu32ˉlittle(Input, Offset + 5u32);
    let Target: u32 = Shape.Recordˉbase + State.Nextˉrecord;
    let Backing: u32 = Shape.Scratchˉbase + Bytesˉreadˉu32ˉlittle(
        Storage.Scratchˉoffsets,
        State.Nextˉrecord * 4u32
    );
    return Recordˉinstructions.Compilerˉnativeˉx64ˉrecordˉstate(
        Bytesˉconcat(
            State.Result,
            Emitˉmachine(
                Lengthˉslot,
                Alignmentˉslot,
                Budgetˉslot,
                Resultˉtype,
                Target,
                Backing,
                Unsafeˉbacking,
                Bytesˉreadˉu16ˉlittle(Input, 6u32) == 36u32 ||
                    Bytesˉreadˉu16ˉlittle(Input, 6u32) == 37u32 ||
                    Bytesˉreadˉu16ˉlittle(Input, 6u32) == 38u32,
                Bytesˉreadˉu16ˉlittle(Input, 6u32) == 38u32
            )
        ),
        Bytesˉconcat(
            Bytesˉslice(State.Stackˉtypes, 0u32, Depth),
            Bytesˉfromˉu8(
                Nominalˉtypes.Compilerˉnativeˉx64ˉvariantˉtype(Resultˉtype)
            )
        ),
        Bytesˉconcat(
            Bytesˉslice(State.Stackˉslots, 0u32, Depth * 4u32),
            Bytesˉfromˉu32ˉlittle(Target)
        ),
        Depth + 1u32,
        State.Nextˉi32,
        State.Nextˉbool,
        State.Nextˉtext,
        State.Nextˉu8,
        State.Nextˉu32,
        State.Nextˉbytes,
        State.Nextˉenum,
        State.Nextˉrecord + 1u32
    );
}
