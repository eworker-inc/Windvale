module Compilerˉnativeˉpublicationˉbridge profile hosted;

import Compilerˉnativeˉpublication as Nativeˉpublication;

capability file.read_bytes;

data Requestˉname: text = "native-publication-request.bin";

export fn Main() -> bytes {
    let Input: bytes = file.read_bytes(Requestˉname);
    let Plan: Nativeˉpublication.Nativeˉpublicationˉresult = Nativeˉpublication.Nativeˉpublicationˉplan(Input);
    return Plan.Value;
}
