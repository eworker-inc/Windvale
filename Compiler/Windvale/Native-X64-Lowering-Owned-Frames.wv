data Addressˉrax: bytes = [72, 141, 132, 36];
data Addressˉrdxˉrelative: bytes = [72, 141, 21];
data Addressˉr8: bytes = [76, 141, 4, 36];
data Addressˉr9ˉrelative: bytes = [76, 141, 13];
data Storeˉword: bytes = [199, 132, 36];
data Rejectˉnonzero: bytes = [133, 192, 15, 133];

fn Empty(Input: bytes) -> bytes { return Bytesˉslice(Input, 0u32, 0u32); }
fn Word(Output: bytes, Value: u32) -> bytes {
    return Bytesˉconcat(Output, Bytesˉfromˉu32ˉlittle(Value));
}
fn Relative(Target: u32, Origin: u32) -> u32 {
    if Target >= Origin { return Target - Origin; }
    return 4294967295u32 - (Origin - Target) + 1u32;
}
fn Store(Output: bytes, Offset: u32, Value: u32) -> bytes {
    return Word(Word(Bytesˉconcat(Output, Storeˉword), Offset), Value);
}
fn Parameterˉcount(Locals: bytes, Parameters: u32) -> u32 {
    var Count: u32 = 0u32;
    while Count < Bytesˉlength(Locals) / 8u32 &&
        Bytesˉreadˉu32ˉlittle(Locals, Count * 8u32) < Parameters * 16u32 {
        Count = Count + 1u32;
    }
    return Count;
}
fn Rank(Locals: bytes, Local: u32) -> u32 {
    var Index: u32 = 0u32;
    while Index < Bytesˉlength(Locals) / 8u32 {
        if Bytesˉreadˉu32ˉlittle(Locals, Index * 8u32) == Local * 16u32 {
            return Index;
        }
        Index = Index + 1u32;
    }
    return 4294967295u32;
}

export fn Helper() -> bytes { return Template; }
export fn Helperˉisˉexact(Input: bytes) -> bool {
    if Bytesˉlength(Input) != 720u32 { return false; }
    var Index: u32 = 0u32;
    while Index < 720u32 {
        if Bytesˉreadˉu8(Input, Index) != Bytesˉreadˉu8(Template, Index) {
            return false;
        }
        Index = Index + 1u32;
    }
    return true;
}
export fn Slots(Locals: bytes) -> u32 {
    if Bytesˉlength(Locals) == 0u32 { return 0u32; }
    return (8u32 + Bytesˉlength(Locals) / 2u32 + 15u32) / 16u32;
}
export fn Prologueˉbytes(Locals: bytes, Parameters: u32) -> u32 {
    if Bytesˉlength(Locals) == 0u32 { return 0u32; }
    return 27u32 + Bytesˉlength(Locals) +
        Parameterˉcount(Locals, Parameters) * 11u32;
}
export fn Emitˉprologue(Locals: bytes, Parameters: u32, Frameˉbase: u32)
    -> bytes {
    var Output: bytes = Empty(Locals);
    if Bytesˉlength(Locals) == 0u32 { return Output; }
    // The forward jump keeps immutable cleanup metadata out of execution.
    Output = Word(Bytesˉfromˉu8(233u8), Bytesˉlength(Locals));
    Output = Bytesˉconcat(Output, Locals);
    let Count: u32 = Parameterˉcount(Locals, Parameters);
    Output = Store(Output, Frameˉbase, Count);
    Output = Store(Output, Frameˉbase + 4u32, Bytesˉlength(Locals) / 8u32);
    var Index: u32 = 0u32;
    while Index < Count {
        Output = Store(Output, Frameˉbase + 8u32 + Index * 4u32, Index);
        Index = Index + 1u32;
    }
    return Output;
}
export fn Hookˉbytes(Input: bytes, Offset: u32, Opcode: u8, Locals: bytes)
    -> u32 {
    if Bytesˉlength(Locals) == 0u32 { return 0u32; }
    if Opcode == 81u8 { return 39u32; }
    if Opcode != 5u8 && Opcode != 205u8 && Opcode != 207u8 { return 0u32; }
    if Rank(Locals, Bytesˉreadˉu32ˉlittle(Input, Offset + 1u32)) ==
        4294967295u32 { return 0u32; }
    return 31u32;
}
export fn Emitˉhook(
    Input: bytes, Offset: u32, Opcode: u8, Locals: bytes,
    Frameˉbase: u32, Metadataˉoffset: u32, Helperˉbase: u32,
    Entryˉbase: u32, Codeˉbase: u32, Emittedˉoffset: u32,
    Invalidˉtarget: u32
) -> bytes {
    var Output: bytes = Empty(Input);
    if Hookˉbytes(Input, Offset, Opcode, Locals) == 0u32 { return Output; }
    Output = Word(Addressˉrax, Frameˉbase);
    var Target: u32 = Helperˉbase;
    if Opcode == 81u8 {
        Output = Bytesˉconcat(Output, Addressˉrdxˉrelative);
        Output = Word(Output, Relative(Codeˉbase + Metadataˉoffset,
            Codeˉbase + Emittedˉoffset + Bytesˉlength(Output) + 4u32));
        Output = Bytesˉconcat(Output, Addressˉr8);
        Output = Bytesˉconcat(Output, Addressˉr9ˉrelative);
        Output = Word(Output, Relative(Entryˉbase + 1151u32,
            Codeˉbase + Emittedˉoffset + Bytesˉlength(Output) + 4u32));
        Target = Target + 456u32;
    } else {
        Output = Word(Bytesˉconcat(Output, Bytesˉfromˉu8(185u8)),
            Rank(Locals, Bytesˉreadˉu32ˉlittle(Input, Offset + 1u32)));
        var Operation: u32 = 1u32;
        if Opcode == 5u8 { Operation = 0u32; }
        Output = Word(Bytesˉconcat(Output, Bytesˉfromˉu8(186u8)), Operation);
    }
    Output = Bytesˉconcat(Output, Bytesˉfromˉu8(232u8));
    Output = Word(Output, Relative(Target,
        Codeˉbase + Emittedˉoffset + Bytesˉlength(Output) + 4u32));
    Output = Bytesˉconcat(Output, Rejectˉnonzero);
    return Word(Output, Relative(Invalidˉtarget,
        Emittedˉoffset + Bytesˉlength(Output) + 4u32));
}
