module Compilerˉwebassemblyˉvalueˉlayout profile portable;

import Compilerˉwebassemblyˉbinaryˉencoding as Encoding;
import Compilerˉwebassemblyˉfunctionˉdirectory as Functions;

export record Compilerˉwebassemblyˉvalueˉlayoutˉemission {
    Valid: bool;
    Bytes: bytes;
    I32ˉcount: u32;
    I64ˉcount: u32;
}

fn Empty(Input: bytes) -> bytes {
    return Bytesˉslice(Input, 0u32, 0u32);
}

fn Append(First: bytes, Second: bytes) -> bytes {
    return Bytesˉconcat(First, Second);
}

fn Byte(Value: u32) -> bytes {
    return Encoding.Compilerˉwebassemblyˉbinaryˉbyte(Value);
}

fn Uleb(Value: u32) -> bytes {
    return Encoding.Compilerˉwebassemblyˉbinaryˉuleb32(Value);
}

export fn Compilerˉwebassemblyˉvalueˉlayoutˉshapeˉkind(
    Input: bytes,
    Offset: u32
) -> u32 {
    return U32ˉfromˉu8(Bytesˉreadˉu8(Input, Offset));
}

export fn Compilerˉwebassemblyˉvalueˉlayoutˉshapeˉwidth(
    Input: bytes,
    Offset: u32
) -> u32 {
    let Kind: u32 =
        Compilerˉwebassemblyˉvalueˉlayoutˉshapeˉkind(Input, Offset);
    if Kind == 7u32 || Kind == 8u32 || Kind == 11u32 { return 5u32; }
    if Kind == 12u32 || Kind == 13u32 {
        let Element: u32 =
            Compilerˉwebassemblyˉvalueˉlayoutˉshapeˉkind(
                Input,
                Offset + 1u32
            );
        if Element == 7u32 || Element == 8u32 || Element == 11u32 {
            return 10u32;
        }
        return 6u32;
    }
    return 1u32;
}

export fn Compilerˉwebassemblyˉvalueˉlayoutˉwasmˉtype(
    Kind: u32
) -> u32 {
    if Kind == 1u32 || Kind == 2u32 || Kind == 4u32 || Kind == 5u32 ||
        Kind == 7u32 || Kind == 8u32 || Kind == 11u32 ||
        Kind == 12u32 || Kind == 13u32 {
        return 127u32;
    }
    if Kind == 3u32 || Kind == 6u32 || Kind == 9u32 || Kind == 10u32 {
        return 126u32;
    }
    return 0u32;
}

export fn Compilerˉwebassemblyˉvalueˉlayoutˉshapeˉisˉi64(
    Input: bytes,
    Offset: u32
) -> bool {
    return Compilerˉwebassemblyˉvalueˉlayoutˉwasmˉtype(
        Compilerˉwebassemblyˉvalueˉlayoutˉshapeˉkind(Input, Offset)
    ) == 126u32;
}

fn Functionˉtype(
    Input: bytes,
    Directory: Functions.Compilerˉwebassemblyˉfunctionˉdirectoryˉsummary,
    Function: u32,
    Recordˉdestination: bool
) -> Compilerˉwebassemblyˉvalueˉlayoutˉemission {
    if !Directory.Valid || Function >= Directory.Count {
        return Compilerˉwebassemblyˉvalueˉlayoutˉemission(
            false,
            Empty(Input),
            0u32,
            0u32
        );
    }
    let Parameterˉcount: u32 =
        Functions.Compilerˉwebassemblyˉfunctionˉparameterˉcount(
            Directory,
            Function
        );
    var Emittedˉparameters: u32 = Parameterˉcount;
    if Recordˉdestination {
        Emittedˉparameters = Emittedˉparameters + 1u32;
    }
    var Result: bytes = Byte(96u32);
    Result = Append(Result, Uleb(Emittedˉparameters));
    var Cursor: u32 =
        Functions.Compilerˉwebassemblyˉfunctionˉparameterˉtypesˉoffset(
            Directory,
            Function
        );
    var Parameter: u32 = 0u32;
    var I32ˉcount: u32 = 0u32;
    var I64ˉcount: u32 = 0u32;
    while Parameter < Parameterˉcount {
        let Wasmˉtype: u32 =
            Compilerˉwebassemblyˉvalueˉlayoutˉwasmˉtype(
                Compilerˉwebassemblyˉvalueˉlayoutˉshapeˉkind(Input, Cursor)
            );
        if Wasmˉtype == 0u32 {
            return Compilerˉwebassemblyˉvalueˉlayoutˉemission(
                false,
                Empty(Input),
                0u32,
                0u32
            );
        }
        Result = Append(Result, Byte(Wasmˉtype));
        if Wasmˉtype == 127u32 { I32ˉcount = I32ˉcount + 1u32; }
        if Wasmˉtype == 126u32 { I64ˉcount = I64ˉcount + 1u32; }
        Cursor = Cursor +
            Compilerˉwebassemblyˉvalueˉlayoutˉshapeˉwidth(Input, Cursor);
        Parameter = Parameter + 1u32;
    }
    if Recordˉdestination {
        Result = Append(Result, Byte(127u32));
        I32ˉcount = I32ˉcount + 1u32;
    }
    let Resultˉoffset: u32 =
        Functions.Compilerˉwebassemblyˉfunctionˉresultˉtypeˉoffset(
            Directory,
            Function
        );
    let Resultˉkind: u32 =
        Compilerˉwebassemblyˉvalueˉlayoutˉshapeˉkind(Input, Resultˉoffset);
    if Resultˉkind == 0u32 {
        Result = Append(Result, Uleb(0u32));
    } else {
        let Resultˉtype: u32 =
            Compilerˉwebassemblyˉvalueˉlayoutˉwasmˉtype(Resultˉkind);
        if Resultˉtype == 0u32 {
            return Compilerˉwebassemblyˉvalueˉlayoutˉemission(
                false,
                Empty(Input),
                0u32,
                0u32
            );
        }
        Result = Append(Result, Uleb(1u32));
        Result = Append(Result, Byte(Resultˉtype));
        if Resultˉtype == 127u32 { I32ˉcount = I32ˉcount + 1u32; }
        if Resultˉtype == 126u32 { I64ˉcount = I64ˉcount + 1u32; }
    }
    return Compilerˉwebassemblyˉvalueˉlayoutˉemission(
        true,
        Result,
        I32ˉcount,
        I64ˉcount
    );
}

export fn Compilerˉwebassemblyˉvalueˉlayoutˉfunctionˉtype(
    Input: bytes,
    Directory: Functions.Compilerˉwebassemblyˉfunctionˉdirectoryˉsummary,
    Function: u32
) -> Compilerˉwebassemblyˉvalueˉlayoutˉemission {
    return Functionˉtype(Input, Directory, Function, false);
}

export fn Compilerˉwebassemblyˉvalueˉlayoutˉrecordˉfunctionˉtype(
    Input: bytes,
    Directory: Functions.Compilerˉwebassemblyˉfunctionˉdirectoryˉsummary,
    Function: u32
) -> Compilerˉwebassemblyˉvalueˉlayoutˉemission {
    return Functionˉtype(Input, Directory, Function, true);
}

fn Appendˉrun(Entries: bytes, Count: u32, Wasmˉtype: u32) -> bytes {
    var Result: bytes = Append(Entries, Uleb(Count));
    return Append(Result, Byte(Wasmˉtype));
}

fn Functionˉlocals(
    Input: bytes,
    Directory: Functions.Compilerˉwebassemblyˉfunctionˉdirectoryˉsummary,
    Function: u32,
    Additionalˉi32: u32,
    Additionalˉi64: u32
) -> Compilerˉwebassemblyˉvalueˉlayoutˉemission {
    if !Directory.Valid || Function >= Directory.Count {
        return Compilerˉwebassemblyˉvalueˉlayoutˉemission(
            false,
            Empty(Input),
            0u32,
            0u32
        );
    }
    let Localˉcount: u32 =
        Functions.Compilerˉwebassemblyˉfunctionˉlocalˉcount(
            Directory,
            Function
        );
    var Cursor: u32 =
        Functions.Compilerˉwebassemblyˉfunctionˉlocalˉtypesˉoffset(
            Directory,
            Function
        );
    var Entries: bytes = Empty(Input);
    var Groupˉcount: u32 = 0u32;
    var Runˉcount: u32 = 0u32;
    var Runˉtype: u32 = 0u32;
    var Local: u32 = 0u32;
    var I32ˉcount: u32 = 0u32;
    var I64ˉcount: u32 = 0u32;
    while Local < Localˉcount {
        let Wasmˉtype: u32 =
            Compilerˉwebassemblyˉvalueˉlayoutˉwasmˉtype(
                Compilerˉwebassemblyˉvalueˉlayoutˉshapeˉkind(Input, Cursor)
            );
        if Wasmˉtype == 0u32 {
            return Compilerˉwebassemblyˉvalueˉlayoutˉemission(
                false,
                Empty(Input),
                0u32,
                0u32
            );
        }
        if Wasmˉtype == 127u32 { I32ˉcount = I32ˉcount + 1u32; }
        if Wasmˉtype == 126u32 { I64ˉcount = I64ˉcount + 1u32; }
        if Runˉcount == 0u32 {
            Runˉtype = Wasmˉtype;
            Runˉcount = 1u32;
        } else {
            if Runˉtype == Wasmˉtype {
                Runˉcount = Runˉcount + 1u32;
            } else {
                Entries = Appendˉrun(Entries, Runˉcount, Runˉtype);
                Groupˉcount = Groupˉcount + 1u32;
                Runˉtype = Wasmˉtype;
                Runˉcount = 1u32;
            }
        }
        Cursor = Cursor +
            Compilerˉwebassemblyˉvalueˉlayoutˉshapeˉwidth(Input, Cursor);
        Local = Local + 1u32;
    }

    if Runˉcount == 0u32 {
        Runˉtype = 127u32;
        Runˉcount = 4u32 + Additionalˉi32;
    } else {
        if Runˉtype == 127u32 {
            Runˉcount = Runˉcount + 4u32 + Additionalˉi32;
        } else {
            Entries = Appendˉrun(Entries, Runˉcount, Runˉtype);
            Groupˉcount = Groupˉcount + 1u32;
            Runˉtype = 127u32;
            Runˉcount = 4u32 + Additionalˉi32;
        }
    }
    I32ˉcount = I32ˉcount + 4u32 + Additionalˉi32;
    Entries = Appendˉrun(Entries, Runˉcount, Runˉtype);
    Groupˉcount = Groupˉcount + 1u32;
    Entries = Appendˉrun(Entries, 1u32 + Additionalˉi64, 126u32);
    Groupˉcount = Groupˉcount + 1u32;
    I64ˉcount = I64ˉcount + 1u32 + Additionalˉi64;

    return Compilerˉwebassemblyˉvalueˉlayoutˉemission(
        true,
        Append(Uleb(Groupˉcount), Entries),
        I32ˉcount,
        I64ˉcount
    );
}

export fn Compilerˉwebassemblyˉvalueˉlayoutˉfunctionˉlocals(
    Input: bytes,
    Directory: Functions.Compilerˉwebassemblyˉfunctionˉdirectoryˉsummary,
    Function: u32
) -> Compilerˉwebassemblyˉvalueˉlayoutˉemission {
    return Functionˉlocals(Input, Directory, Function, 0u32, 0u32);
}

export fn Compilerˉwebassemblyˉvalueˉlayoutˉrecordˉfunctionˉlocals(
    Input: bytes,
    Directory: Functions.Compilerˉwebassemblyˉfunctionˉdirectoryˉsummary,
    Function: u32
) -> Compilerˉwebassemblyˉvalueˉlayoutˉemission {
    return Functionˉlocals(Input, Directory, Function, 1u32, 0u32);
}

export fn Compilerˉwebassemblyˉvalueˉlayoutˉruntimeˉfunctionˉlocals(
    Input: bytes,
    Directory: Functions.Compilerˉwebassemblyˉfunctionˉdirectoryˉsummary,
    Function: u32,
    Additionalˉi32: u32,
    Additionalˉi64: u32
) -> Compilerˉwebassemblyˉvalueˉlayoutˉemission {
    return Functionˉlocals(
        Input,
        Directory,
        Function,
        Additionalˉi32,
        Additionalˉi64
    );
}
