module Compilerˉwebassemblyˉscalarˉoperations profile portable;

import Compilerˉwebassemblyˉbinaryˉencoding as Encoding;

export record Compilerˉwebassemblyˉscalarˉoperationˉemission {
    Matched: bool;
    Bytes: bytes;
}

fn Empty(Input: bytes) -> bytes {
    return Bytesˉslice(Input, 0u32, 0u32);
}

fn Append(First: bytes, Second: bytes) -> bytes {
    return Bytesˉconcat(First, Second);
}

fn Byte(Value: u32) -> bytes {
    return Encoding.Compilerˉwebassemblyˉbinaryˉbyte(Value);
}

fn Indexed(Opcode: u32, Index: u32) -> bytes {
    return Encoding.Compilerˉwebassemblyˉbinaryˉindexedˉinstruction(
        Opcode,
        Index
    );
}

fn Positiveˉconstant(Value: u32) -> bytes {
    return Encoding.Compilerˉwebassemblyˉbinaryˉpositiveˉi32ˉconstant(
        Value
    );
}

fn Negativeˉoneˉconstant() -> bytes {
    return Append(Byte(65u32), Byte(127u32));
}

fn Emitˉearlyˉreturn(Returnsˉvalue: bool) -> bytes {
    var Result: bytes = Byte(15u32);
    if Returnsˉvalue {
        Result = Append(Positiveˉconstant(0u32), Result);
    }
    return Result;
}

fn Emitˉstatusˉreturn(
    Status: u32,
    Returnsˉvalue: bool,
    Statusˉglobal: u32
) -> bytes {
    var Result: bytes = Positiveˉconstant(Status);
    Result = Append(Result, Indexed(36u32, Statusˉglobal));
    return Append(Result, Emitˉearlyˉreturn(Returnsˉvalue));
}

fn Emitˉfailureˉguard(
    Status: u32,
    Returnsˉvalue: bool,
    Statusˉglobal: u32
) -> bytes {
    var Result: bytes = Byte(4u32);
    Result = Append(Result, Byte(64u32));
    Result = Append(
        Result,
        Emitˉstatusˉreturn(Status, Returnsˉvalue, Statusˉglobal)
    );
    return Append(Result, Byte(11u32));
}

fn Emitˉu32ˉdivision(
    Opcode: u8,
    First: u32,
    Second: u32,
    Returnsˉvalue: bool,
    Statusˉglobal: u32
) -> bytes {
    var Result: bytes = Indexed(33u32, Second);
    Result = Append(Result, Indexed(33u32, First));
    Result = Append(Result, Indexed(32u32, Second));
    Result = Append(Result, Byte(69u32));
    Result = Append(
        Result,
        Emitˉfailureˉguard(3032u32, Returnsˉvalue, Statusˉglobal)
    );
    Result = Append(Result, Indexed(32u32, First));
    Result = Append(Result, Indexed(32u32, Second));
    if Opcode == 161u8 {
        return Append(Result, Byte(110u32));
    }
    return Append(Result, Byte(112u32));
}

fn Emitˉu32ˉshift(
    Opcode: u8,
    First: u32,
    Second: u32,
    Returnsˉvalue: bool,
    Statusˉglobal: u32
) -> bytes {
    var Result: bytes = Indexed(33u32, Second);
    Result = Append(Result, Indexed(33u32, First));
    Result = Append(Result, Indexed(32u32, Second));
    Result = Append(Result, Positiveˉconstant(32u32));
    Result = Append(Result, Byte(79u32));
    Result = Append(
        Result,
        Emitˉfailureˉguard(3033u32, Returnsˉvalue, Statusˉglobal)
    );
    Result = Append(Result, Indexed(32u32, First));
    Result = Append(Result, Indexed(32u32, Second));
    if Opcode == 177u8 {
        return Append(Result, Byte(116u32));
    }
    return Append(Result, Byte(118u32));
}

export fn Compilerˉwebassemblyˉscalarˉoperationˉemit(
    Input: bytes,
    Opcode: u8,
    Scratchˉfirst: u32,
    Scratchˉsecond: u32,
    Returnsˉvalue: bool,
    Statusˉglobal: u32
) -> Compilerˉwebassemblyˉscalarˉoperationˉemission {
    var Result: bytes = Empty(Input);
    if Opcode == 161u8 || Opcode == 162u8 {
        return Compilerˉwebassemblyˉscalarˉoperationˉemission(
            true,
            Emitˉu32ˉdivision(
                Opcode,
                Scratchˉfirst,
                Scratchˉsecond,
                Returnsˉvalue,
                Statusˉglobal
            )
        );
    }
    if Opcode == 173u8 {
        return Compilerˉwebassemblyˉscalarˉoperationˉemission(
            true,
            Byte(113u32)
        );
    }
    if Opcode == 174u8 {
        return Compilerˉwebassemblyˉscalarˉoperationˉemission(
            true,
            Byte(114u32)
        );
    }
    if Opcode == 175u8 {
        return Compilerˉwebassemblyˉscalarˉoperationˉemission(
            true,
            Byte(115u32)
        );
    }
    if Opcode == 176u8 {
        Result = Negativeˉoneˉconstant();
        Result = Append(Result, Byte(115u32));
        return Compilerˉwebassemblyˉscalarˉoperationˉemission(true, Result);
    }
    if Opcode == 177u8 || Opcode == 178u8 {
        return Compilerˉwebassemblyˉscalarˉoperationˉemission(
            true,
            Emitˉu32ˉshift(
                Opcode,
                Scratchˉfirst,
                Scratchˉsecond,
                Returnsˉvalue,
                Statusˉglobal
            )
        );
    }
    return Compilerˉwebassemblyˉscalarˉoperationˉemission(false, Result);
}
