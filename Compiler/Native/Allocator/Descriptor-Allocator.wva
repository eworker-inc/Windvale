test r11d r11d
branch equal acquire_split_head
load_memory_u64 rax r8 none 1 0
move ecx r11d
subtract_i32 ecx 1
add rax rcx
store_memory_u32 rax none 1 8 edx
jump_label acquire_publish

label acquire_split_head
store_memory_u32 r8 none 1 16 edx
jump_label acquire_publish

label acquire_exact
