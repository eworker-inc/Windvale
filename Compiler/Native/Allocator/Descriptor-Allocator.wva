branch not_equal invalid_request
load_memory_u32 eax r9 none 1 32
test eax eax
branch not_equal invalid_request
load_memory_u32 eax r9 none 1 36
test eax eax
branch not_equal invalid_request

# Clear the deterministic output fields after their zero-input proof.
move_u32 eax 0
store_memory_u32 r9 none 1 20 eax
store_memory_u64 r9 none 1 24 rax
store_memory_u32 r9 none 1 32 eax

# Operation-specific input fields are validated before lazy state mutation.
