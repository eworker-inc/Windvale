windvale-assembly 1

# Successor-native descriptor allocator leaf candidate.
#
# R8 points to one 32-byte allocator state and R9 points to one 40-byte
# request. These registers are volatile on both Windows x64 and System V.
# The leaf returns the exact request status in EAX and clobbers only the
# platform-common volatile registers RAX, RCX, RDX, R8, R9, R10, and R11.
#
# State:   arena u64, length u32, magic u32, free-head token u32,
#          allocated blocks u32, charged bytes u32, reserved u32.
# Request: version u32, size u32, operation u32, payload bytes u32,
#          owner token u32, status u32, data pointer u64,
#          charged bytes u32, reserved u32.
#
# Owner token zero is borrowed. A nonzero token is arena header offset plus
# one. Blocks have a 16-byte header: charged size, references, next-free
# token, and allocated/free magic. Operation 1 acquires, 2 retains, and 3
# releases. Status 0 succeeds; 1 is a malformed request, 2 is exhaustion,
# 3 is corrupt allocator state, 4 is an invalid owner, and 5 is reference
# overflow.
symbol export function Windvale_descriptor_allocator in .text

section code .text align 16
define Windvale_descriptor_allocator
# Validate the two bounded records before reading or mutating their fields.
test r8 r8
branch equal invalid_pointer
move rax r8
and_i32 rax 7
branch not_equal invalid_pointer
test r9 r9
branch equal invalid_pointer
move rax r9
and_i32 rax 7
branch not_equal invalid_pointer
load_memory_u32 eax r9 none 1 0
