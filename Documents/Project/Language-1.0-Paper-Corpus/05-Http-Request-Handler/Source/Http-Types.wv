#!wv/1 en@1
module Httpˉtypes;
profile core;
platform windows, linux, windvale;
authority library;

import Foundationˉbytes as Bytes;
import Foundationˉcollections as Collections;
import Foundationˉmemory as Memory;
import Foundationˉoption as Option;

export enum Method: u8 {
    Get = 1u8;
    Post = 2u8;
    Other = 3u8;
}

export enum Target: u8 {
    Health = 1u8;
    Echo = 2u8;
    Other = 3u8;
}

export enum Route: u8 {
    Health = 1u8;
    Echo = 2u8;
    Notˉfound = 3u8;
    Methodˉnotˉallowed = 4u8;
}

export enum Headerˉname: u8 {
    Host = 1u8;
    Contentˉlength = 2u8;
    Contentˉtype = 3u8;
    Connection = 4u8;
}

export enum Status: u16 {
    Ok = 200u16;
    Badˉrequest = 400u16;
    Notˉfound = 404u16;
    Methodˉnotˉallowed = 405u16;
    Payloadˉtooˉlarge = 413u16;
}

export enum Resourceˉkind: u8 {
    Inputˉbuffer = 1u8;
    Headerˉmap = 2u8;
    Bodyˉtext = 3u8;
    Response = 4u8;
}

export enum Streamˉreason: u8 {
    Rejected = 1u8;
    Timedˉout = 2u8;
    Cancelled = 3u8;
    Peerˉreset = 4u8;
    Revoked = 5u8;
    Providerˉlost = 6u8;
    Providerˉrestarted = 7u8;
    Invalidˉresponse = 8u8;
}

export variant Requestˉrejection {
    Startˉlineˉlimit(Observed: u64, Maximum: u64);
    Headerˉbytesˉlimit(Observed: u64, Maximum: u64);
    Headerˉcountˉlimit(Observed: u64, Maximum: u64);
    Malformedˉstartˉline(Byteˉoffset: u64);
    Unsupportedˉversion(Byteˉoffset: u64);
    Malformedˉheader(Byteˉoffset: u64);
    Transferˉencodingˉforbidden(Byteˉoffset: u64);
    Duplicateˉheader(Header: Headerˉname);
    Hostˉmissing;
    Invalidˉhost(Byteˉoffset: u64);
    Invalidˉcontentˉlength(Byteˉoffset: u64);
    Bodyˉlimit(Observed: u64, Maximum: u64);
    Unexpectedˉbody(Observed: u64);
    Contentˉlengthˉrequired;
    Contentˉtypeˉrequired;
    Invalidˉcontentˉtype;
    Invalidˉconnection;
    Invalidˉutf8(Byteˉoffset: u64);
    Trailingˉbytes(Observed: u64, Expected: u64);
}

export record Limits {
    Maximumˉstartˉlineˉbytes: u64;
    Maximumˉheaderˉbytes: u64;
    Maximumˉheaders: u64;
    Maximumˉbodyˉbytes: u64;
    Maximumˉbodyˉrunes: u64;
    Maximumˉrequestˉbytes: u64;
    Maximumˉreadˉbytes: u64;
    Maximumˉresponseˉbytes: u64;
    Maximumˉoperations: u64;
    Maximumˉwork: u64;
}

export record Workˉmeter {
    Completed: u64;
    Maximum: u64;
}

export record Byteˉrange {
    Start: u64;
    Length: u64;
}

export record Headerˉvalue {
    Range: Byteˉrange;
}

export record Headerˉscanˉstate {
    Nextˉstart: u64;
    Firstˉlineˉend: Option.Option<u64>;
}

export variant Headerˉscan {
    Needˉmore(State: Headerˉscanˉstate);
    Complete(Firstˉlineˉend: u64, Headerˉend: u64);
}

export record Parsedˉhead {
    Route: Route;
    Bodyˉstart: u64;
    Bodyˉlength: u64;
}

export record Parsedˉstartˉline {
    Method: Method;
    Target: Target;
}

export record Receivedˉrequest {
    Buffer: Bytes.Byteˉbuffer;
    Head: Parsedˉhead;
    Receivedˉbytes: u64;
    Readˉoperations: u64;
}

export variant Receiveˉoutcome {
    Complete(Request: Receivedˉrequest);
    Rejected(
        Error: Requestˉrejection,
        Receivedˉbytes: u64,
        Readˉoperations: u64,
    );
}

export variant Responseˉbody {
    Bytes(Value: bytes);
    Text(Value: text);
}

export record Responseˉplan {
    Status: Status;
    Body: Responseˉbody;
}

export variant Handlerˉoutcome {
    Served(Route: Route);
    Requestˉrejected(Error: Requestˉrejection);
}

export record Handlerˉreport {
    Status: Status;
    Outcome: Handlerˉoutcome;
    Requestˉbytes: u64;
    Responseˉbytes: u64;
    Readˉoperations: u64;
    Writeˉoperations: u64;
    Work: u64;
}

export record Preparedˉresponse {
    Plan: Responseˉplan;
    Outcome: Handlerˉoutcome;
    Requestˉbytes: u64;
    Readˉoperations: u64;
}

export record Writeˉreport {
    Acceptedˉbytes: u64;
    Writeˉoperations: u64;
}

export variant Handlerˉfailure {
    Invalidˉconfiguration(
        Field: u32,
        Observed: u64,
        Minimum: u64,
        Maximum: u64,
    );
    Allocation(
        Resource: Resourceˉkind,
        Error: Memory.Allocationˉfailure,
    );
    Collection(Error: Collections.Collectionˉfailure);
    Request(Error: Requestˉrejection);
    Acceptˉrejected(
        Reason: Streamˉreason,
        Expectedˉgeneration: u64,
        Observedˉgeneration: u64,
    );
    Readˉrejected(
        Reason: Streamˉreason,
        Expectedˉgeneration: u64,
        Observedˉgeneration: u64,
        Receivedˉbytes: u64,
    );
    Earlyˉpeerˉclose(Receivedˉbytes: u64, Requiredˉbytes: u64);
    Writeˉrejected(
        Reason: Streamˉreason,
        Expectedˉgeneration: u64,
        Observedˉgeneration: u64,
        Acceptedˉbytes: u64,
    );
    Writeˉindeterminate(
        Reason: Streamˉreason,
        Expectedˉgeneration: u64,
        Observedˉgeneration: u64,
        Knownˉacceptedˉbytes: u64,
    );
    Invalidˉprogress(
        Requested: u64,
        Reported: u64,
        Completed: u64,
    );
    Invalidˉstate(Stage: u32);
    Responseˉlimit(Maximum: u64);
    Operationˉlimit(Completed: u64, Maximum: u64);
    Workˉexhausted(Completed: u64, Maximum: u64);
}
