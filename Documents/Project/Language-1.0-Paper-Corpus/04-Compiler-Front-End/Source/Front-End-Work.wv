edition 1;
module Frontˉendˉwork;
profile core;
platform windows, linux, windvale;
authority library;

import Foundationˉresult as Result;
import Frontˉendˉtypes as Types;

export fn Charge(
    Meter: borrow mut Types.Workˉmeter,
    Amount: u64,
) -> Result.Result<unit, Types.Frontˉendˉfailure> effects() {
    if Amount > Meter.Maximum - Meter.Completed {
        return Result.Result.Failure {
            Error: Types.Frontˉendˉfailure.Workˉexhausted {
                Completed: Meter.Completed,
                Maximum: Meter.Maximum,
            },
        };
    }
    Meter.Completed = Meter.Completed + Amount;
    return Result.Result.Valid { Value: () };
}
