module Compilerˉsourceˉsetˉtool profile hosted;

import Compilerˉsourceˉset;

capability console.write_line;
capability diagnostic.write_line;
capability file.read_bytes;
capability process.argument;
capability process.argument_count;

data Sourceˉsetˉtoolˉmagic: bytes = [87, 86, 83, 83];

fn Compilerˉsourceˉsetˉtoolˉheader(Modules: u32) -> bytes {
    var Header: bytes = Sourceˉsetˉtoolˉmagic;
    Header = Bytesˉconcat(Header, Bytesˉfromˉu16ˉlittle(1u32));
    Header = Bytesˉconcat(Header, Bytesˉfromˉu16ˉlittle(0u32));
    Header = Bytesˉconcat(Header, Bytesˉfromˉu32ˉlittle(Modules));
    return Bytesˉconcat(Header, Bytesˉfromˉu32ˉlittle(Modules * 8u32));
}

fn Compilerˉsourceˉsetˉtoolˉbuild(Modules: u32) -> bytes {
    var Directory: bytes = Bytesˉslice(Sourceˉsetˉtoolˉmagic, 0u32, 0u32);
    var Sourceˉoffset: u32 = 16u32 + Modules * 8u32;
    var Index: u32 = 0u32;
    while Index < Modules {
        let Source: bytes = file.read_bytes(process.argument(Index));
        let Length: u32 = Bytesˉlength(Source);
        if Length == 0u32 { return Directory; }
        if Length > 4194304u32 - Sourceˉoffset { return Directory; }
        Directory = Bytesˉconcat(Directory, Bytesˉfromˉu32ˉlittle(Sourceˉoffset));
        Directory = Bytesˉconcat(Directory, Bytesˉfromˉu32ˉlittle(Length));
        Sourceˉoffset = Sourceˉoffset + Length;
        Index = Index + 1u32;
    }

    var Result: bytes = Bytesˉconcat(Compilerˉsourceˉsetˉtoolˉheader(Modules), Directory);
    Index = 0u32;
    while Index < Modules {
        Result = Bytesˉconcat(Result, file.read_bytes(process.argument(Index)));
        Index = Index + 1u32;
    }
    return Result;
}

fn Compilerˉsourceˉsetˉtoolˉsuccess(
    Summary: Compilerˉsourceˉsetˉsummary
) -> text {
    var Report: text = "source set status=";
    Report = Textˉconcat(Report, Enumˉname(Summary.Status));
    Report = Textˉconcat(Report, " modules=");
    Report = Textˉconcat(Report, U32ˉformat(Summary.Modules));
    Report = Textˉconcat(Report, " source-bytes=");
    Report = Textˉconcat(Report, U32ˉformat(Summary.Sourceˉbytes));
    Report = Textˉconcat(Report, " imports=");
    Report = Textˉconcat(Report, U32ˉformat(Summary.Imports));
    Report = Textˉconcat(Report, " records=");
    Report = Textˉconcat(Report, U32ˉformat(Summary.Records));
    Report = Textˉconcat(Report, " enums=");
    Report = Textˉconcat(Report, U32ˉformat(Summary.Enums));
    Report = Textˉconcat(Report, " functions=");
    return Textˉconcat(Report, U32ˉformat(Summary.Functions));
}

fn Compilerˉsourceˉsetˉtoolˉfailure(
    Summary: Compilerˉsourceˉsetˉsummary
) -> text {
    var Report: text = "source set status=";
    Report = Textˉconcat(Report, Enumˉname(Summary.Status));
    Report = Textˉconcat(Report, " module=");
    Report = Textˉconcat(Report, U32ˉformat(Summary.Failureˉmodule));
    Report = Textˉconcat(Report, " offset=");
    Report = Textˉconcat(Report, U32ˉformat(Summary.Failureˉoffset));
    Report = Textˉconcat(Report, " line=");
    Report = Textˉconcat(Report, U32ˉformat(Summary.Failureˉline));
    Report = Textˉconcat(Report, " column=");
    Report = Textˉconcat(Report, U32ˉformat(Summary.Failureˉcolumn));
    Report = Textˉconcat(Report, " parse-status=");
    Report = Textˉconcat(Report, Enumˉname(Summary.Parseˉstatus));
    Report = Textˉconcat(Report, " body-status=");
    return Textˉconcat(Report, Enumˉname(Summary.Bodyˉstatus));
}

export fn Main() -> i32 {
    let Modules: u32 = process.argument_count();
    if Modules == 0u32 {
        diagnostic.write_line("Usage: source-set <root.wv> [sorted-dependency.wv ...]");
        return 64;
    }
    if Modules > 64u32 {
        diagnostic.write_line("source set status=Invalidˉcount");
        return 64;
    }
    let Input: bytes = Compilerˉsourceˉsetˉtoolˉbuild(Modules);
    let Summary: Compilerˉsourceˉsetˉsummary = Compilerˉvalidateˉsourceˉset(Input);
    if Summary.Status != Compilerˉsourceˉsetˉstatus.Valid {
        diagnostic.write_line(Compilerˉsourceˉsetˉtoolˉfailure(Summary));
        return 1;
    }
    console.write_line(Compilerˉsourceˉsetˉtoolˉsuccess(Summary));
    return 0;
}
