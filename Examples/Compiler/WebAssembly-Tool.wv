module Compilerˉwebassemblyˉtool profile hosted;

import Compilerˉwebassembly as Webassembly;

capability console.write_line;
capability diagnostic.write_line;
capability file.read_bytes;
capability file.write_bytes;
capability process.argument;
capability process.argument_count;

export fn Main() -> i32 {
    if process.argument_count() != 2u32 {
        diagnostic.write_line("Usage: wvwasm <input.wvb> <output.wasm>");
        return 2;
    }
    let Input: bytes = file.read_bytes(process.argument(0u32));
    let Summary: Webassembly.Compilerˉwebassemblyˉsummary =
        Webassembly.Compilerˉlowerˉwvbˉwebassembly(Input);
    if Summary.Status != Webassembly.Compilerˉwebassemblyˉstatus.Valid {
        diagnostic.write_line(
            Textˉconcat(
                "webassembly status=",
                Enumˉname(Summary.Status)
            )
        );
        return 1;
    }
    file.write_bytes(process.argument(1u32), Summary.Webassembly);
    var Report: text = "webassembly status=Valid module-bytes=";
    Report = Textˉconcat(Report, U32ˉformat(Bytesˉlength(Summary.Webassembly)));
    if Summary.Executionˉabi == 0u32 {
        Report = Textˉconcat(Report, " result=");
        Report = Textˉconcat(Report, I32ˉformat(Summary.Result));
    }
    if Summary.Executionˉabi != 0u32 {
        Report = Textˉconcat(Report, " execution-abi=");
        Report = Textˉconcat(Report, U32ˉformat(Summary.Executionˉabi));
    }
    console.write_line(Report);
    return 0;
}
