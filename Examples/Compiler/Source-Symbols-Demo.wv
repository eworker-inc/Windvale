module Compilerˉsourceˉsymbolsˉdemo profile portable;

import Compilerˉsourceˉgraph as Sourceˉgraph;
import Compilerˉsourceˉset as Sourceˉset;
import Compilerˉsourceˉsymbols as Sourceˉsymbols;
import Foundationˉbyteˉconstruction as Byteˉconstruction;

data Sourceˉsymbolsˉmagic: bytes = [87, 86, 83, 83];

fn Sourceˉsymbolsˉheader(Modules: u32) -> bytes {
    var Header: bytes = Sourceˉsymbolsˉmagic;
    Header = Bytesˉconcat(Header, Bytesˉfromˉu16ˉlittle(1u32));
    Header = Bytesˉconcat(Header, Bytesˉfromˉu16ˉlittle(0u32));
    Header = Bytesˉconcat(Header, Bytesˉfromˉu32ˉlittle(Modules));
    return Bytesˉconcat(Header, Bytesˉfromˉu32ˉlittle(Modules * 8u32));
}

fn Sourceˉsymbolsˉone(First: text) -> bytes {
    let Firstˉbytes: bytes = Textˉtoˉutf8(First);
    var Directory: bytes = Bytesˉfromˉu32ˉlittle(24u32);
    Directory = Bytesˉconcat(Directory, Bytesˉfromˉu32ˉlittle(Bytesˉlength(Firstˉbytes)));
    var Result: bytes = Bytesˉconcat(Sourceˉsymbolsˉheader(1u32), Directory);
    return Bytesˉconcat(Result, Firstˉbytes);
}

fn Sourceˉsymbolsˉtwo(First: text, Second: text) -> bytes {
    let Firstˉbytes: bytes = Textˉtoˉutf8(First);
    let Secondˉbytes: bytes = Textˉtoˉutf8(Second);
    let Firstˉoffset: u32 = 32u32;
    let Secondˉoffset: u32 = Firstˉoffset + Bytesˉlength(Firstˉbytes);
    var Directory: bytes = Bytesˉfromˉu32ˉlittle(Firstˉoffset);
    Directory = Bytesˉconcat(Directory, Bytesˉfromˉu32ˉlittle(Bytesˉlength(Firstˉbytes)));
    Directory = Bytesˉconcat(Directory, Bytesˉfromˉu32ˉlittle(Secondˉoffset));
    Directory = Bytesˉconcat(Directory, Bytesˉfromˉu32ˉlittle(Bytesˉlength(Secondˉbytes)));
    var Result: bytes = Bytesˉconcat(Sourceˉsymbolsˉheader(2u32), Directory);
    Result = Bytesˉconcat(Result, Firstˉbytes);
    return Bytesˉconcat(Result, Secondˉbytes);
}

fn Sourceˉsymbolsˉthree(First: text, Second: text, Third: text) -> bytes {
    let Firstˉbytes: bytes = Textˉtoˉutf8(First);
    let Secondˉbytes: bytes = Textˉtoˉutf8(Second);
    let Thirdˉbytes: bytes = Textˉtoˉutf8(Third);
    let Firstˉoffset: u32 = 40u32;
    let Secondˉoffset: u32 = Firstˉoffset + Bytesˉlength(Firstˉbytes);
    let Thirdˉoffset: u32 = Secondˉoffset + Bytesˉlength(Secondˉbytes);
    var Directory: bytes = Bytesˉfromˉu32ˉlittle(Firstˉoffset);
    Directory = Bytesˉconcat(Directory, Bytesˉfromˉu32ˉlittle(Bytesˉlength(Firstˉbytes)));
    Directory = Bytesˉconcat(Directory, Bytesˉfromˉu32ˉlittle(Secondˉoffset));
    Directory = Bytesˉconcat(Directory, Bytesˉfromˉu32ˉlittle(Bytesˉlength(Secondˉbytes)));
    Directory = Bytesˉconcat(Directory, Bytesˉfromˉu32ˉlittle(Thirdˉoffset));
    Directory = Bytesˉconcat(Directory, Bytesˉfromˉu32ˉlittle(Bytesˉlength(Thirdˉbytes)));
    var Result: bytes = Bytesˉconcat(Sourceˉsymbolsˉheader(3u32), Directory);
    Result = Bytesˉconcat(Result, Firstˉbytes);
    Result = Bytesˉconcat(Result, Secondˉbytes);
    return Bytesˉconcat(Result, Thirdˉbytes);
}

fn Sourceˉsymbolsˉfour(First: text, Second: text, Third: text, Fourth: text) -> bytes {
    let Firstˉbytes: bytes = Textˉtoˉutf8(First);
    let Secondˉbytes: bytes = Textˉtoˉutf8(Second);
    let Thirdˉbytes: bytes = Textˉtoˉutf8(Third);
    let Fourthˉbytes: bytes = Textˉtoˉutf8(Fourth);
    let Firstˉoffset: u32 = 48u32;
    let Secondˉoffset: u32 = Firstˉoffset + Bytesˉlength(Firstˉbytes);
    let Thirdˉoffset: u32 = Secondˉoffset + Bytesˉlength(Secondˉbytes);
    let Fourthˉoffset: u32 = Thirdˉoffset + Bytesˉlength(Thirdˉbytes);
    var Directory: bytes = Bytesˉfromˉu32ˉlittle(Firstˉoffset);
    Directory = Bytesˉconcat(Directory, Bytesˉfromˉu32ˉlittle(Bytesˉlength(Firstˉbytes)));
    Directory = Bytesˉconcat(Directory, Bytesˉfromˉu32ˉlittle(Secondˉoffset));
    Directory = Bytesˉconcat(Directory, Bytesˉfromˉu32ˉlittle(Bytesˉlength(Secondˉbytes)));
    Directory = Bytesˉconcat(Directory, Bytesˉfromˉu32ˉlittle(Thirdˉoffset));
    Directory = Bytesˉconcat(Directory, Bytesˉfromˉu32ˉlittle(Bytesˉlength(Thirdˉbytes)));
    Directory = Bytesˉconcat(Directory, Bytesˉfromˉu32ˉlittle(Fourthˉoffset));
    Directory = Bytesˉconcat(Directory, Bytesˉfromˉu32ˉlittle(Bytesˉlength(Fourthˉbytes)));
    var Result: bytes = Bytesˉconcat(Sourceˉsymbolsˉheader(4u32), Directory);
    Result = Bytesˉconcat(Result, Firstˉbytes);
    Result = Bytesˉconcat(Result, Secondˉbytes);
    Result = Bytesˉconcat(Result, Thirdˉbytes);
    return Bytesˉconcat(Result, Fourthˉbytes);
}

fn Sourceˉsymbolsˉstatus(Source: text) -> Sourceˉsymbols.Compilerˉsourceˉsymbolˉstatus {
    let Summary: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary = Sourceˉsymbols.Compilerˉvalidateˉsourceˉsymbols(
        Sourceˉsymbolsˉone(Source)
    );
    return Summary.Status;
}

fn Sourceˉsymbolsˉreplaceˉu8(Input: bytes, Offset: u32, Value: u8) -> bytes {
    let Replaced: Byteˉconstruction.Foundationˉbytesˉresult = Byteˉconstruction.Foundationˉbytesˉreplace(
        Input, Offset, 1u32, Bytesˉfromˉu8(Value)
    );
    return Replaced.Value;
}

fn Sourceˉsymbolsˉreplaceˉu32(Input: bytes, Offset: u32, Value: u32) -> bytes {
    let Replaced: Byteˉconstruction.Foundationˉbytesˉresult = Byteˉconstruction.Foundationˉbytesˉreplace(
        Input, Offset, 4u32, Bytesˉfromˉu32ˉlittle(Value)
    );
    return Replaced.Value;
}

export fn Main() -> i32 {
    let Root: text = "module Symbolsˉroot profile hosted; import Symbolsˉalpha as Alpha; import Symbolsˉbeta as Beta; capability console.write_line; data Message: text = \"ready\"; record Rootˉpair { Choice: Alpha.Symbolsˉchoice; Count: u32; } enum Rootˉstate { Ready = 0; Stopped = 1; } export fn Main(Value: Alpha.Alphaˉrecord) -> Rootˉstate { return Rootˉstate.Ready; }";
    let Alpha: text = "module Symbolsˉalpha profile portable; import Symbolsˉleaf as Leaf; export record Alphaˉrecord { Code: Leaf.Symbolsˉleafˉstate; } export enum Symbolsˉchoice { First = 0; Second = 1; } export fn Alphaˉuse(Value: Leaf.Symbolsˉleaf) -> Symbolsˉchoice { return Symbolsˉchoice.First; }";
    let Beta: text = "module Symbolsˉbeta profile portable; export record Betaˉrecord { Count: u32; } export fn Betaˉuse(Value: Betaˉrecord) -> u32 { return Value.Count; }";
    let Leaf: text = "module Symbolsˉleaf profile portable; export record Symbolsˉleaf { Value: u32; } export enum Symbolsˉleafˉstate { Cold = 0; Warm = 1; } export fn Leafˉuse(Value: Symbolsˉleaf) -> Symbolsˉleafˉstate { return Symbolsˉleafˉstate.Warm; }";
    let Validˉinput: bytes = Sourceˉsymbolsˉfour(Root, Alpha, Beta, Leaf);
    let Valid: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary = Sourceˉsymbols.Compilerˉvalidateˉsourceˉsymbols(Validˉinput);
    if Valid.Status != Sourceˉsymbols.Compilerˉsourceˉsymbolˉstatus.Valid { return 1; }
    if Valid.Modules != 4u32 { return 2; }
    if Valid.Capabilities != 1u32 { return 3; }
    if Valid.Data != 1u32 { return 4; }
    if Valid.Records != 4u32 { return 5; }
    if Valid.Enums != 3u32 { return 6; }
    if Valid.Functions != 4u32 { return 7; }
    if Valid.Fields != 5u32 { return 8; }
    if Valid.Members != 6u32 { return 9; }
    if Valid.Parameters != 4u32 { return 10; }
    if Bytesˉlength(Valid.Directory) != 328u32 { return 11; }
    if Bytesˉlength(Valid.Visibility) != 16u32 { return 12; }
    if Bytesˉreadˉu8(Valid.Visibility, 0u32) != 1u8 { return 13; }
    if Bytesˉreadˉu8(Valid.Visibility, 3u32) != 1u8 { return 14; }
    if Bytesˉreadˉu8(Valid.Visibility, 6u32) != 0u8 { return 15; }
    if Bytesˉreadˉu8(Valid.Visibility, 7u32) != 1u8 { return 16; }
    if Bytesˉreadˉu8(Valid.Visibility, 11u32) != 0u8 { return 17; }
    let Scan: Sourceˉset.Compilerˉsourceˉsetˉscan = Sourceˉset.Compilerˉscanˉsourceˉset(Validˉinput);
    if !Sourceˉsymbols.Compilerˉsourceˉsymbolsˉdirectoryˉisˉvalid(
        Validˉinput, Scan, Valid.Directory, 13u32
    ) { return 18; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉdirectoryˉisˉvalid(
        Validˉinput, Scan, Sourceˉsymbolsˉreplaceˉu8(Valid.Directory, 0u32, 0u8), 13u32
    ) { return 19; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉdirectoryˉisˉvalid(
        Validˉinput, Scan, Sourceˉsymbolsˉreplaceˉu32(Valid.Directory, 8u32, 12u32), 13u32
    ) { return 20; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉdirectoryˉisˉvalid(
        Validˉinput, Scan, Sourceˉsymbolsˉreplaceˉu32(Valid.Directory, 16u32, 4u32), 13u32
    ) { return 21; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉdirectoryˉisˉvalid(
        Validˉinput, Scan, Bytesˉconcat(Valid.Directory, Bytesˉfromˉu8(0u8)), 13u32
    ) { return 22; }
    let Leafˉname: bytes = Textˉtoˉutf8("Symbolsˉleaf");
    let Leafˉmatch: Sourceˉsymbols.Compilerˉsourceˉsymbolˉmatch = Sourceˉsymbols.Compilerˉsourceˉsymbolsˉfindˉnominalˉinˉdirectory(
        Validˉinput, Scan, Valid.Directory, Valid.Lookup,
        Leafˉname, 0u32, Bytesˉlength(Leafˉname)
    );
    if !Leafˉmatch.Found { return 23; }
    if Leafˉmatch.Module != 3u32 { return 24; }
    if Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnominalˉindexˉinˉdirectory(
        Validˉinput, Scan, Valid.Directory, Valid.Lookup, Leafˉmatch.Kind,
        Leafˉname, 0u32, Bytesˉlength(Leafˉname), Valid.Records
    ) != 3u32 { return 25; }
    if Bytesˉlength(Valid.Lookup) != 4603u32 { return 26; }
    if Bytesˉreadˉu16ˉlittle(Valid.Lookup, 6u32) != 1u32 { return 27; }
    if Leafˉmatch.Directoryˉindex != 10u32 { return 28; }
    if Bytesˉreadˉu32ˉlittle(Valid.Lookup, 4164u32 + 3u32 * 4u32) != 10u32 { return 29; }
    if Bytesˉreadˉu32ˉlittle(Valid.Lookup, 4192u32 + 10u32 * 4u32) != 3u32 { return 53; }

    if Sourceˉsymbolsˉstatus("module Duplicateˉcapability profile hosted; capability console.write; capability console.write; export fn Main() -> i32 { return 0; }") != Sourceˉsymbols.Compilerˉsourceˉsymbolˉstatus.Duplicateˉcapability { return 30; }
    if Sourceˉsymbolsˉstatus("module Unknownˉcapability profile hosted; capability console.unknown; export fn Main() -> i32 { return 0; }") != Sourceˉsymbols.Compilerˉsourceˉsymbolˉstatus.Unknownˉcapability { return 31; }
    if Sourceˉsymbolsˉstatus("module Portableˉcapability profile portable; capability console.write; export fn Main() -> i32 { return 0; }") != Sourceˉsymbols.Compilerˉsourceˉsymbolˉstatus.Capabilityˉprofile { return 32; }
    if Sourceˉsymbolsˉstatus("module Duplicateˉdata profile portable; data Value: text = \"a\"; data Value: text = \"b\"; export fn Main() -> i32 { return 0; }") != Sourceˉsymbols.Compilerˉsourceˉsymbolˉstatus.Duplicateˉdata { return 33; }
    if Sourceˉsymbolsˉstatus("module Duplicateˉtype profile portable; record Value { Field: i32; } enum Value { One = 1; } export fn Main() -> i32 { return 0; }") != Sourceˉsymbols.Compilerˉsourceˉsymbolˉstatus.Duplicateˉtype { return 34; }
    if Sourceˉsymbolsˉstatus("module Duplicateˉfunction profile portable; fn Value() -> i32 { return 1; } export fn Value() -> i32 { return 2; }") != Sourceˉsymbols.Compilerˉsourceˉsymbolˉstatus.Duplicateˉfunction { return 35; }
    if Sourceˉsymbolsˉstatus("module Constructorˉconflict profile portable; record Value { Field: i32; } export fn Value() -> i32 { return 0; }") != Sourceˉsymbols.Compilerˉsourceˉsymbolˉstatus.Constructorˉconflict { return 36; }
    if Sourceˉsymbolsˉstatus("module Reservedˉname profile portable; export fn Bytesˉlength() -> i32 { return 0; }") != Sourceˉsymbols.Compilerˉsourceˉsymbolˉstatus.Reservedˉname { return 37; }
    if Sourceˉsymbolsˉstatus("module Emptyˉrecord profile portable; record Empty { } export fn Main() -> i32 { return 0; }") != Sourceˉsymbols.Compilerˉsourceˉsymbolˉstatus.Emptyˉrecord { return 38; }
    if Sourceˉsymbolsˉstatus("module Duplicateˉfield profile portable; record Pair { Value: i32; Value: u32; } export fn Main() -> i32 { return 0; }") != Sourceˉsymbols.Compilerˉsourceˉsymbolˉstatus.Duplicateˉfield { return 39; }
    if Sourceˉsymbolsˉstatus("module Emptyˉenum profile portable; enum Empty { } export fn Main() -> i32 { return 0; }") != Sourceˉsymbols.Compilerˉsourceˉsymbolˉstatus.Emptyˉenum { return 40; }
    if Sourceˉsymbolsˉstatus("module Duplicateˉmember profile portable; enum State { Ready = 0; Ready = 1; } export fn Main() -> i32 { return 0; }") != Sourceˉsymbols.Compilerˉsourceˉsymbolˉstatus.Duplicateˉenumˉmember { return 41; }
    if Sourceˉsymbolsˉstatus("module Duplicateˉvalue profile portable; enum State { Ready = 0; Stopped = 0; } export fn Main() -> i32 { return 0; }") != Sourceˉsymbols.Compilerˉsourceˉsymbolˉstatus.Duplicateˉenumˉvalue { return 42; }
    if Sourceˉsymbolsˉstatus("module Unknownˉtype profile portable; export fn Main(Value: Missing) -> i32 { return 0; }") != Sourceˉsymbols.Compilerˉsourceˉsymbolˉstatus.Unknownˉtype { return 44; }
    if Sourceˉsymbolsˉstatus("module Nestedˉfield profile portable; record Inner { Value: i32; } record Outer { Value: Inner; } export fn Main() -> i32 { return 0; }") != Sourceˉsymbols.Compilerˉsourceˉsymbolˉstatus.Valid { return 45; }
    if Sourceˉsymbolsˉstatus("module Capabilityˉfield profile hosted; capability console.write_line; record Outputˉbox { Output: console.write_line; } export fn Main() -> i32 { return 0; }") != Sourceˉsymbols.Compilerˉsourceˉsymbolˉstatus.Invalidˉfieldˉtype { return 72; }
    if Sourceˉsymbolsˉstatus("module Capabilityˉvariant profile hosted; capability console.write_line; variant Outputˉoption { Some(Value: console.write_line); None; } export fn Main() -> i32 { return 0; }") != Sourceˉsymbols.Compilerˉsourceˉsymbolˉstatus.Invalidˉvariantˉpayload { return 73; }
    if Sourceˉsymbolsˉstatus("module Capabilityˉsequence profile hosted; capability console.write_line; fn Use(Outputs: sequence<console.write_line, 1>) -> void { } export fn Main() -> i32 { return 0; }") != Sourceˉsymbols.Compilerˉsourceˉsymbolˉstatus.Invalidˉcollectionˉelement { return 74; }
    if Sourceˉsymbolsˉstatus("module Optionalˉcapabilityˉtype; platform windows; authority application; optional capability file.read_bytes version 1; fn Use(Input: file.read_bytes) -> void { } export fn Main() -> i32 { return 0; }") != Sourceˉsymbols.Compilerˉsourceˉsymbolˉstatus.Unknownˉtype { return 75; }
    if Sourceˉsymbolsˉstatus("module Duplicateˉparameter profile portable; export fn Main(Value: i32, Value: i32) -> i32 { return Value; }") != Sourceˉsymbols.Compilerˉsourceˉsymbolˉstatus.Duplicateˉparameter { return 46; }
    if Sourceˉsymbolsˉstatus("module Validˉconstant profile portable; enum Mode { Ready = 1; } const START: i32 = 1; const STEP: i32 = START + 2; const ENABLED: bool = STEP == 3; const MODE: Mode = Mode.Ready; export fn Main() -> i32 { return STEP; }") != Sourceˉsymbols.Compilerˉsourceˉsymbolˉstatus.Valid { return 62; }
    if Sourceˉsymbolsˉstatus("module Shortˉconstant profile portable; const ENABLED: bool = true || MISSING; const DISABLED: bool = false && (4294967295u32 + 1u32 == 0u32); export fn Main() -> i32 { return 0; }") != Sourceˉsymbols.Compilerˉsourceˉsymbolˉstatus.Valid { return 71; }
    if Sourceˉsymbolsˉstatus("module Invalidˉconstantˉname profile portable; const Mixed: i32 = 1; export fn Main() -> i32 { return 0; }") != Sourceˉsymbols.Compilerˉsourceˉsymbolˉstatus.Invalidˉconstantˉname { return 63; }
    if Sourceˉsymbolsˉstatus("module Invalidˉconstantˉtype profile portable; const VALUE: text = \"x\"; export fn Main() -> i32 { return 0; }") != Sourceˉsymbols.Compilerˉsourceˉsymbolˉstatus.Invalidˉconstantˉtype { return 64; }
    if Sourceˉsymbolsˉstatus("module Invalidˉconstantˉinitializer profile portable; const VALUE: i32 = Length(); export fn Main() -> i32 { return 0; }") != Sourceˉsymbols.Compilerˉsourceˉsymbolˉstatus.Invalidˉconstantˉinitializer { return 65; }
    if Sourceˉsymbolsˉstatus("module Constantˉtypeˉmismatch profile portable; const VALUE: u32 = 1; export fn Main() -> i32 { return 0; }") != Sourceˉsymbols.Compilerˉsourceˉsymbolˉstatus.Constantˉtypeˉmismatch { return 66; }
    if Sourceˉsymbolsˉstatus("module Constantˉforwardˉreference profile portable; const VALUE: i32 = LATER; const LATER: i32 = 1; export fn Main() -> i32 { return 0; }") != Sourceˉsymbols.Compilerˉsourceˉsymbolˉstatus.Constantˉforwardˉreference { return 67; }
    if Sourceˉsymbolsˉstatus("module Constantˉoverflow profile portable; const MAXIMUM: u32 = 4294967295u32; const OVERFLOW: u32 = MAXIMUM + 1u32; export fn Main() -> i32 { return 0; }") != Sourceˉsymbols.Compilerˉsourceˉsymbolˉstatus.Constantˉoverflow { return 68; }

    let Crossˉmoduleˉduplicate: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary = Sourceˉsymbols.Compilerˉvalidateˉsourceˉsymbols(
        Sourceˉsymbolsˉtwo(
            "module Crossˉduplicateˉroot profile portable; import Crossˉduplicateˉdependency as Dependency; record Sharedˉtype { Value: i32; } export fn Main() -> i32 { return 0; }",
            "module Crossˉduplicateˉdependency profile portable; record Sharedˉtype { Value: u32; } export fn Dependencyˉmain() -> i32 { return 0; }"
        )
    );
    if Crossˉmoduleˉduplicate.Status != Sourceˉsymbols.Compilerˉsourceˉsymbolˉstatus.Valid { return 47; }

    let Inaccessible: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary = Sourceˉsymbols.Compilerˉvalidateˉsourceˉsymbols(
        Sourceˉsymbolsˉthree(
            "module Visibilityˉroot profile portable; import Visibilityˉalpha as Alpha; export fn Main() -> i32 { return 0; }",
            "module Visibilityˉalpha profile portable; import Visibilityˉbeta as Beta; export fn Alphaˉuse(Value: Beta.Visibilityˉbetaˉtype) -> i32 { return 0; }",
            "module Visibilityˉbeta profile portable; record Visibilityˉbetaˉtype { Value: i32; } export fn Betaˉuse(Value: Visibilityˉbetaˉtype) -> i32 { return Value.Value; }"
        )
    );
    if Inaccessible.Status != Sourceˉsymbols.Compilerˉsourceˉsymbolˉstatus.Inaccessibleˉtype { return 50; }
    if Inaccessible.Failureˉmodule != 1u32 { return 51; }
    if Inaccessible.Failureˉrelatedˉmodule != 2u32 { return 52; }

    let Importedˉconstant: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary = Sourceˉsymbols.Compilerˉvalidateˉsourceˉsymbols(
        Sourceˉsymbolsˉtwo(
            "module Importedˉconstantˉroot profile portable; import Importedˉconstantˉdependency as Dependency; export fn Main() -> i32 { return 0; }",
            "module Importedˉconstantˉdependency profile portable; const VALUE: i32 = 1; export fn Dependencyˉmain() -> i32 { return VALUE; }"
        )
    );
    if Importedˉconstant.Status != Sourceˉsymbols.Compilerˉsourceˉsymbolˉstatus.Valid { return 69; }

    let Graphˉfailure: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary = Sourceˉsymbols.Compilerˉvalidateˉsourceˉsymbols(
        Sourceˉsymbolsˉone("module Missingˉimport profile portable; import Missingˉdependency as Dependency;")
    );
    if Graphˉfailure.Status != Sourceˉsymbols.Compilerˉsourceˉsymbolˉstatus.Sourceˉgraph { return 60; }
    if Graphˉfailure.Graphˉstatus != Sourceˉgraph.Compilerˉsourceˉgraphˉstatus.Missingˉimport { return 61; }
    return 0;
}
