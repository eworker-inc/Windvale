module Compilerˉsourceˉbindingsˉdemo profile portable;

import Compilerˉsourceˉbindings as Sourceˉbindings;
import Compilerˉsourceˉset as Sourceˉset;
import Compilerˉsourceˉsymbols as Sourceˉsymbols;
import Foundationˉbyteˉconstruction as Byteˉconstruction;

fn Sourceˉbindingsˉheader(Modules: u32) -> bytes {
    var Header: bytes = Textˉtoˉutf8("WVSS");
    Header = Bytesˉconcat(Header, Bytesˉfromˉu16ˉlittle(1u32));
    Header = Bytesˉconcat(Header, Bytesˉfromˉu16ˉlittle(0u32));
    Header = Bytesˉconcat(Header, Bytesˉfromˉu32ˉlittle(Modules));
    return Bytesˉconcat(Header, Bytesˉfromˉu32ˉlittle(Modules * 8u32));
}

fn Sourceˉbindingsˉone(First: text) -> bytes {
    let Firstˉbytes: bytes = Textˉtoˉutf8(First);
    var Directory: bytes = Bytesˉfromˉu32ˉlittle(24u32);
    Directory = Bytesˉconcat(Directory, Bytesˉfromˉu32ˉlittle(Bytesˉlength(Firstˉbytes)));
    var Result: bytes = Bytesˉconcat(Sourceˉbindingsˉheader(1u32), Directory);
    return Bytesˉconcat(Result, Firstˉbytes);
}

fn Sourceˉbindingsˉtwo(First: text, Second: text) -> bytes {
    let Firstˉbytes: bytes = Textˉtoˉutf8(First);
    let Secondˉbytes: bytes = Textˉtoˉutf8(Second);
    let Firstˉoffset: u32 = 32u32;
    let Secondˉoffset: u32 = Firstˉoffset + Bytesˉlength(Firstˉbytes);
    var Directory: bytes = Bytesˉfromˉu32ˉlittle(Firstˉoffset);
    Directory = Bytesˉconcat(Directory, Bytesˉfromˉu32ˉlittle(Bytesˉlength(Firstˉbytes)));
    Directory = Bytesˉconcat(Directory, Bytesˉfromˉu32ˉlittle(Secondˉoffset));
    Directory = Bytesˉconcat(Directory, Bytesˉfromˉu32ˉlittle(Bytesˉlength(Secondˉbytes)));
    var Result: bytes = Bytesˉconcat(Sourceˉbindingsˉheader(2u32), Directory);
    Result = Bytesˉconcat(Result, Firstˉbytes);
    return Bytesˉconcat(Result, Secondˉbytes);
}

fn Sourceˉbindingsˉthree(First: text, Second: text, Third: text) -> bytes {
    let Firstˉbytes: bytes = Textˉtoˉutf8(First);
    let Secondˉbytes: bytes = Textˉtoˉutf8(Second);
    let Thirdˉbytes: bytes = Textˉtoˉutf8(Third);
    let Firstˉoffset: u32 = 40u32;
    let Secondˉoffset: u32 = Firstˉoffset + Bytesˉlength(Firstˉbytes);
    let Thirdˉoffset: u32 = Secondˉoffset + Bytesˉlength(Secondˉbytes);
    var Directory: bytes = Bytesˉfromˉu32ˉlittle(Firstˉoffset);
    Directory = Bytesˉconcat(Directory, Bytesˉfromˉu32ˉlittle(Bytesˉlength(Firstˉbytes)));
    Directory = Bytesˉconcat(Directory, Bytesˉfromˉu32ˉlittle(Secondˉoffset));
    Directory = Bytesˉconcat(Directory, Bytesˉfromˉu32ˉlittle(Bytesˉlength(Secondˉbytes)));
    Directory = Bytesˉconcat(Directory, Bytesˉfromˉu32ˉlittle(Thirdˉoffset));
    Directory = Bytesˉconcat(Directory, Bytesˉfromˉu32ˉlittle(Bytesˉlength(Thirdˉbytes)));
    var Result: bytes = Bytesˉconcat(Sourceˉbindingsˉheader(3u32), Directory);
    Result = Bytesˉconcat(Result, Firstˉbytes);
    Result = Bytesˉconcat(Result, Secondˉbytes);
    return Bytesˉconcat(Result, Thirdˉbytes);
}

fn Sourceˉbindingsˉstatus(Source: text) -> Sourceˉbindings.Compilerˉsourceˉbindingˉstatus {
    let Input: bytes = Sourceˉbindingsˉone(Source);
    let Summary: Sourceˉbindings.Compilerˉsourceˉbindingˉsummary = Sourceˉbindings.Compilerˉvalidateˉsourceˉbindings(Input);
    return Summary.Status;
}

fn Sourceˉbindingsˉreplaceˉu8(Input: bytes, Offset: u32, Value: u8) -> bytes {
    let Replaced: Byteˉconstruction.Foundationˉbytesˉresult = Byteˉconstruction.Foundationˉbytesˉreplace(
        Input, Offset, 1u32, Bytesˉfromˉu8(Value)
    );
    return Replaced.Value;
}

fn Sourceˉbindingsˉreplaceˉu32(Input: bytes, Offset: u32, Value: u32) -> bytes {
    let Replaced: Byteˉconstruction.Foundationˉbytesˉresult = Byteˉconstruction.Foundationˉbytesˉreplace(
        Input, Offset, 4u32, Bytesˉfromˉu32ˉlittle(Value)
    );
    return Replaced.Value;
}

export fn Main() -> i32 {
    let Validˉsource: text = "module Bindingsˉvalid profile hosted; capability console.write_line; data Message: text = \"ready\"; record Pair { Left: i32; Right: i32; } enum State { Ready = 0; } fn Add(Value: i32) -> i32 { return Value + 1; } export fn Main() -> i32 { let Base: i32 = 1; var Result: i32 = Add(Base); if true { let Text: text = Message; console.write_line(Text); Result += Add(Result); } return Result; }";
    let Validˉinput: bytes = Sourceˉbindingsˉone(Validˉsource);
    let Valid: Sourceˉbindings.Compilerˉsourceˉbindingˉsummary = Sourceˉbindings.Compilerˉvalidateˉsourceˉbindings(Validˉinput);
    if Valid.Status != Sourceˉbindings.Compilerˉsourceˉbindingˉstatus.Valid { return 1; }
    if Valid.Modules != 1u32 { return 2; }
    if Valid.Functions != 2u32 { return 3; }
    if Valid.Parameters != 1u32 { return 4; }
    if Valid.Locals != 3u32 { return 5; }
    if Valid.Reads != 7u32 { return 6; }
    if Valid.Assignments != 1u32 { return 7; }
    if Valid.Calls != 3u32 { return 8; }
    if Bytesˉlength(Valid.Directory) != 216u32 { return 9; }
    if Bytesˉreadˉu16ˉlittle(Valid.Directory, 4u32) != 1u32 { return 16; }
    if Bytesˉreadˉu16ˉlittle(Valid.Directory, 6u32) != 1u32 { return 17; }
    let Scan: Sourceˉset.Compilerˉsourceˉsetˉscan = Sourceˉset.Compilerˉscanˉsourceˉset(Validˉinput);
    let Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary = Sourceˉsymbols.Compilerˉvalidateˉsourceˉsymbols(Validˉinput);
    if !Sourceˉbindings.Compilerˉsourceˉbindingsˉdirectoryˉisˉvalid(
        Validˉinput, Scan, Symbols, Valid.Directory
    ) { return 10; }
    if Sourceˉbindings.Compilerˉsourceˉbindingsˉdirectoryˉisˉvalid(
        Validˉinput, Scan, Symbols,
        Sourceˉbindingsˉreplaceˉu8(Valid.Directory, 0u32, 0u8)
    ) { return 11; }
    if Sourceˉbindings.Compilerˉsourceˉbindingsˉdirectoryˉisˉvalid(
        Validˉinput, Scan, Symbols,
        Sourceˉbindingsˉreplaceˉu32(Valid.Directory, 8u32, 3u32)
    ) { return 12; }
    if Sourceˉbindings.Compilerˉsourceˉbindingsˉdirectoryˉisˉvalid(
        Validˉinput, Scan, Symbols,
        Sourceˉbindingsˉreplaceˉu32(Valid.Directory, 16u32, 1u32)
    ) { return 13; }
    if Sourceˉbindings.Compilerˉsourceˉbindingsˉdirectoryˉisˉvalid(
        Validˉinput, Scan, Symbols,
        Bytesˉconcat(Valid.Directory, Bytesˉfromˉu8(0u8))
    ) { return 14; }
    if Sourceˉbindings.Compilerˉsourceˉbindingsˉdirectoryˉisˉvalid(
        Validˉinput, Scan, Symbols,
        Sourceˉbindingsˉreplaceˉu32(Valid.Directory, 72u32, 1u32)
    ) { return 15; }

    if Sourceˉbindingsˉstatus("module Bindingsˉduplicate profile portable; export fn Main(Value: i32) -> i32 { let Value: i32 = 1; return Value; }") != Sourceˉbindings.Compilerˉsourceˉbindingˉstatus.Duplicateˉlocal { return 20; }
    if Sourceˉbindingsˉstatus("module Bindingsˉunknownˉtype profile portable; export fn Main() -> i32 { let Value: Missing = 1; return 0; }") != Sourceˉbindings.Compilerˉsourceˉbindingˉstatus.Unknownˉtype { return 21; }
    if Sourceˉbindingsˉstatus("module Bindingsˉunknownˉname profile portable; export fn Main() -> i32 { return Missing; }") != Sourceˉbindings.Compilerˉsourceˉbindingˉstatus.Unknownˉname { return 22; }
    if Sourceˉbindingsˉstatus("module Bindingsˉexpired profile portable; export fn Main() -> i32 { { let Inner: i32 = 1; } return Inner; }") != Sourceˉbindings.Compilerˉsourceˉbindingˉstatus.Unknownˉname { return 23; }
    if Sourceˉbindingsˉstatus("module Bindingsˉself profile portable; export fn Main() -> i32 { let Value: i32 = Value; return 0; }") != Sourceˉbindings.Compilerˉsourceˉbindingˉstatus.Unknownˉname { return 24; }
    if Sourceˉbindingsˉstatus("module Bindingsˉunknownˉassignment profile portable; export fn Main() -> i32 { Missing = 1; return 0; }") != Sourceˉbindings.Compilerˉsourceˉbindingˉstatus.Unknownˉassignment { return 25; }
    if Sourceˉbindingsˉstatus("module Bindingsˉimmutable profile portable; export fn Main() -> i32 { let Value: i32 = 1; Value = 2; return Value; }") != Sourceˉbindings.Compilerˉsourceˉbindingˉstatus.Immutableˉassignment { return 26; }
    if Sourceˉbindingsˉstatus("module Bindingsˉunknownˉcall profile portable; export fn Main() -> i32 { return Missing(); }") != Sourceˉbindings.Compilerˉsourceˉbindingˉstatus.Unknownˉcall { return 27; }
    if Sourceˉbindingsˉstatus("module Bindingsˉcapability profile hosted; export fn Main() -> i32 { console.write_line(\"missing\"); return 0; }") != Sourceˉbindings.Compilerˉsourceˉbindingˉstatus.Undeclaredˉcapability { return 28; }
    if Sourceˉbindingsˉstatus("module Bindingsˉarity profile portable; fn Value(Input: i32) -> i32 { return Input; } export fn Main() -> i32 { return Value(); }") != Sourceˉbindings.Compilerˉsourceˉbindingˉstatus.Callˉarity { return 29; }
    if Sourceˉbindingsˉstatus("module Bindingsˉinference profile portable; export fn Main() -> i32 { let Value = 1; var Result = Value; Result = Result + 1; return Result; }") != Sourceˉbindings.Compilerˉsourceˉbindingˉstatus.Valid { return 36; }
    if Sourceˉbindingsˉstatus("module Bindingsˉnamed profile portable; record Pair { Left: i32; Right: i32; } export fn Main(Value: i32) -> i32 { let Pairˉvalue = Pair { Right: 2, Left: Value }; if Value < 0 { return Pairˉvalue.Left; } else if Value > 0 { return Pairˉvalue.Right; } else { return 0; } }") != Sourceˉbindings.Compilerˉsourceˉbindingˉstatus.Valid { return 37; }
    if Sourceˉbindingsˉstatus("module Bindingsˉcontrol profile portable; export fn Main() -> i32 { var Value = 0; while true { Value += 1; if Value == 1 { continue; } if Value > 1 && true { break; } } return Value; }") != Sourceˉbindings.Compilerˉsourceˉbindingˉstatus.Valid { return 38; }
    if Sourceˉbindingsˉstatus("module Bindingsˉcapabilityˉreference profile hosted; capability console.write_line; fn Copy(Output: console.write_line) -> console.write_line { return Output; } fn Use(Output: console.write_line, Value: text) -> void { Output(Value); } export fn Main() -> i32 { let Output: console.write_line = Copy(console.write_line); if false { Use(Output, \"unused\"); } return 0; }") != Sourceˉbindings.Compilerˉsourceˉbindingˉstatus.Valid { return 39; }

    let Inaccessibleˉcall: Sourceˉbindings.Compilerˉsourceˉbindingˉsummary = Sourceˉbindings.Compilerˉvalidateˉsourceˉbindings(
        Sourceˉbindingsˉthree(
            "module Bindingsˉcallˉroot profile portable; import Bindingsˉcallˉalpha as Alpha; export fn Main() -> i32 { return Alpha.Alpha(); }",
            "module Bindingsˉcallˉalpha profile portable; import Bindingsˉcallˉbeta as Beta; export fn Alpha() -> i32 { return Beta.Beta(); }",
            "module Bindingsˉcallˉbeta profile portable; fn Beta() -> i32 { return 1; }"
        )
    );
    if Inaccessibleˉcall.Status != Sourceˉbindings.Compilerˉsourceˉbindingˉstatus.Inaccessibleˉcall { return 30; }
    if Inaccessibleˉcall.Failureˉmodule != 1u32 { return 31; }
    if Inaccessibleˉcall.Failureˉrelatedˉmodule != 2u32 { return 32; }

    let Inaccessibleˉname: Sourceˉbindings.Compilerˉsourceˉbindingˉsummary = Sourceˉbindings.Compilerˉvalidateˉsourceˉbindings(
        Sourceˉbindingsˉtwo(
            "module Bindingsˉnameˉroot profile portable; import Bindingsˉnameˉdependency as Dependency; export fn Main() -> text { return Dependency.Dependencyˉvalue; }",
            "module Bindingsˉnameˉdependency profile portable; data Dependencyˉvalue: text = \"private\"; export fn Dependency() -> text { return Dependencyˉvalue; }"
        )
    );
    if Inaccessibleˉname.Status != Sourceˉbindings.Compilerˉsourceˉbindingˉstatus.Inaccessibleˉname { return 33; }
    if Inaccessibleˉname.Failureˉmodule != 0u32 { return 34; }
    if Inaccessibleˉname.Failureˉrelatedˉmodule != 1u32 { return 35; }

    let Symbolˉfailure: Sourceˉbindings.Compilerˉsourceˉbindingˉsummary = Sourceˉbindings.Compilerˉvalidateˉsourceˉbindings(
        Sourceˉbindingsˉone("module Bindingsˉsymbolˉfailure profile portable; export fn Main(Value: Missing) -> i32 { return 0; }")
    );
    if Symbolˉfailure.Status != Sourceˉbindings.Compilerˉsourceˉbindingˉstatus.Sourceˉsymbols { return 40; }
    if Symbolˉfailure.Symbolˉstatus != Sourceˉsymbols.Compilerˉsourceˉsymbolˉstatus.Unknownˉtype { return 41; }

    let Metadataˉimport: Sourceˉbindings.Compilerˉsourceˉbindingˉsummary =
        Sourceˉbindings.Compilerˉvalidateˉsourceˉbindings(
            Sourceˉbindingsˉtwo(
                "module Bindingsˉmetadataˉroot; platform linux, windows; authority application; import Bindingsˉmetadataˉdependency as Dependency; export fn Main() -> i32 { return Dependency.Value(); }",
                "module Bindingsˉmetadataˉdependency profile portable; export fn Value() -> i32 { return 42; }"
            )
        );
    if Metadataˉimport.Status != Sourceˉbindings.Compilerˉsourceˉbindingˉstatus.Valid { return 42; }
    return 0;
}
