module Compilerˉsourceˉlexerˉdemo profile portable;

import Compilerˉsourceˉlexer as Sourceˉlexer;

data Invalidˉutf8: bytes = [195, 40];

export fn Main() -> i32 {
    let Complete: bytes = Textˉtoˉutf8("module profile portable hosted system import capability data record enum export fn let var if else while return true false i32 u8 u32 bool text bytes void length Alphaˉbeta 0 255u8 4294967295u32 \"x\\n\\u0041\" ( ) { } [ ] ; : , . -> + - * ! = == != < <= > >= const break continue && || += -= *=");
    let Scan: Sourceˉlexer.Compilerˉsourceˉscan = Sourceˉlexer.Compilerˉlexˉsource(Complete);
    if Scan.Status != Sourceˉlexer.Compilerˉlexˉstatus.Valid { return 1; }
    if Scan.Tokens != 63u32 { return 2; }

    let First: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉtokenˉat(Complete, 0u32);
    if First.Kind != Sourceˉlexer.Compilerˉtokenˉkind.Module { return 3; }
    let Lastˉkeyword: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉtokenˉat(Complete, 27u32);
    if Lastˉkeyword.Kind != Sourceˉlexer.Compilerˉtokenˉkind.Length { return 4; }
    let Identifier: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉtokenˉat(Complete, 28u32);
    if Identifier.Kind != Sourceˉlexer.Compilerˉtokenˉkind.Identifier { return 5; }
    if Identifier.Length != 11u32 { return 6; }
    let I32ˉliteral: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉtokenˉat(Complete, 29u32);
    if I32ˉliteral.Numericˉkind != Sourceˉlexer.Compilerˉnumericˉkind.I32 { return 7; }
    if I32ˉliteral.Numericˉvalue != 0u32 { return 8; }
    let U8ˉliteral: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉtokenˉat(Complete, 30u32);
    if U8ˉliteral.Numericˉkind != Sourceˉlexer.Compilerˉnumericˉkind.U8 { return 9; }
    if U8ˉliteral.Numericˉvalue != 255u32 { return 10; }
    let U32ˉliteral: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉtokenˉat(Complete, 31u32);
    if U32ˉliteral.Numericˉkind != Sourceˉlexer.Compilerˉnumericˉkind.U32 { return 11; }
    if U32ˉliteral.Numericˉvalue != 4294967295u32 { return 12; }
    let Stringˉliteral: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉtokenˉat(Complete, 32u32);
    if Stringˉliteral.Kind != Sourceˉlexer.Compilerˉtokenˉkind.String { return 13; }
    if Stringˉliteral.Status != Sourceˉlexer.Compilerˉlexˉstatus.Valid { return 14; }
    let Arrow: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉtokenˉat(Complete, 43u32);
    if Arrow.Kind != Sourceˉlexer.Compilerˉtokenˉkind.Arrow { return 15; }
    let Last: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉtokenˉat(Complete, 54u32);
    if Last.Kind != Sourceˉlexer.Compilerˉtokenˉkind.Greaterˉequals { return 16; }
    let Constant: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉtokenˉat(Complete, 55u32);
    if Constant.Kind != Sourceˉlexer.Compilerˉtokenˉkind.Const { return 40; }
    let Break: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉtokenˉat(Complete, 56u32);
    if Break.Kind != Sourceˉlexer.Compilerˉtokenˉkind.Break { return 41; }
    let Continue: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉtokenˉat(Complete, 57u32);
    if Continue.Kind != Sourceˉlexer.Compilerˉtokenˉkind.Continue { return 42; }
    let And: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉtokenˉat(Complete, 58u32);
    if And.Kind != Sourceˉlexer.Compilerˉtokenˉkind.Andˉand { return 43; }
    let Or: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉtokenˉat(Complete, 59u32);
    if Or.Kind != Sourceˉlexer.Compilerˉtokenˉkind.Orˉor { return 44; }
    let Plusˉassignment: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉtokenˉat(Complete, 60u32);
    if Plusˉassignment.Kind != Sourceˉlexer.Compilerˉtokenˉkind.Plusˉequals { return 45; }
    let Minusˉassignment: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉtokenˉat(Complete, 61u32);
    if Minusˉassignment.Kind != Sourceˉlexer.Compilerˉtokenˉkind.Minusˉequals { return 46; }
    let Starˉassignment: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉtokenˉat(Complete, 62u32);
    if Starˉassignment.Kind != Sourceˉlexer.Compilerˉtokenˉkind.Starˉequals { return 47; }

    let Withˉtrivia: bytes = Textˉtoˉutf8("// 😀\r\n\u00A0module");
    let Triviaˉtoken: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉtokenˉat(Withˉtrivia, 0u32);
    if Triviaˉtoken.Kind != Sourceˉlexer.Compilerˉtokenˉkind.Module { return 17; }
    if Triviaˉtoken.Line != 2u32 { return 18; }
    if Triviaˉtoken.Column != 2u32 { return 19; }

    let Unicodeˉwhitespace: bytes = Textˉtoˉutf8("\u0085\u00A0\u1680\u2000\u2028\u205F\u3000module");
    let Unicodeˉwhitespaceˉtoken: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉtokenˉat(Unicodeˉwhitespace, 0u32);
    if Unicodeˉwhitespaceˉtoken.Kind != Sourceˉlexer.Compilerˉtokenˉkind.Module { return 34; }
    if Unicodeˉwhitespaceˉtoken.Line != 1u32 { return 35; }
    if Unicodeˉwhitespaceˉtoken.Column != 8u32 { return 36; }

    let Nearˉkeywords: bytes = Textˉtoˉutf8("f fx ix ux i33 lex u33 vex boox date elso enux texx trux vood bytex breakx falsy whilx exporx hostex imporx lengtx modulx recorx returx systex profilx continux portablx capabilit capabilitx capabilityx constx");
    let Nearˉkeywordˉscan: Sourceˉlexer.Compilerˉsourceˉscan = Sourceˉlexer.Compilerˉlexˉsource(Nearˉkeywords);
    if Nearˉkeywordˉscan.Status != Sourceˉlexer.Compilerˉlexˉstatus.Valid { return 37; }
    if Nearˉkeywordˉscan.Tokens != 34u32 { return 38; }
    var Nearˉkeywordˉindex: u32 = 0u32;
    while Nearˉkeywordˉindex < Nearˉkeywordˉscan.Tokens {
        let Nearˉkeyword: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉtokenˉat(Nearˉkeywords, Nearˉkeywordˉindex);
        if Nearˉkeyword.Kind != Sourceˉlexer.Compilerˉtokenˉkind.Identifier { return 39; }
        Nearˉkeywordˉindex = Nearˉkeywordˉindex + 1u32;
    }

    let Invalidˉencoding: Sourceˉlexer.Compilerˉsourceˉscan = Sourceˉlexer.Compilerˉlexˉsource(Invalidˉutf8);
    if Invalidˉencoding.Status != Sourceˉlexer.Compilerˉlexˉstatus.Invalidˉutf8 { return 20; }
    let Invalidˉcursor: Sourceˉlexer.Compilerˉsourceˉtoken = Sourceˉlexer.Compilerˉlexˉnext(Complete, 9999u32, 1u32, 1u32);
    if Invalidˉcursor.Status != Sourceˉlexer.Compilerˉlexˉstatus.Invalidˉcursor { return 21; }
    let Badˉcharacter: Sourceˉlexer.Compilerˉsourceˉscan = Sourceˉlexer.Compilerˉlexˉsource(Textˉtoˉutf8("@"));
    if Badˉcharacter.Status != Sourceˉlexer.Compilerˉlexˉstatus.Unexpectedˉcharacter { return 22; }
    let I32ˉoverflow: Sourceˉlexer.Compilerˉsourceˉscan = Sourceˉlexer.Compilerˉlexˉsource(Textˉtoˉutf8("2147483648"));
    if I32ˉoverflow.Status != Sourceˉlexer.Compilerˉlexˉstatus.Integerˉoutˉofˉrange { return 23; }
    let U8ˉoverflow: Sourceˉlexer.Compilerˉsourceˉscan = Sourceˉlexer.Compilerˉlexˉsource(Textˉtoˉutf8("256u8"));
    if U8ˉoverflow.Status != Sourceˉlexer.Compilerˉlexˉstatus.Integerˉoutˉofˉrange { return 24; }
    let U32ˉoverflow: Sourceˉlexer.Compilerˉsourceˉscan = Sourceˉlexer.Compilerˉlexˉsource(Textˉtoˉutf8("4294967296u32"));
    if U32ˉoverflow.Status != Sourceˉlexer.Compilerˉlexˉstatus.Integerˉoutˉofˉrange { return 25; }
    let Badˉescape: Sourceˉlexer.Compilerˉsourceˉscan = Sourceˉlexer.Compilerˉlexˉsource(Textˉtoˉutf8("\"x\\q\""));
    if Badˉescape.Status != Sourceˉlexer.Compilerˉlexˉstatus.Unsupportedˉescape { return 26; }
    let Unterminated: Sourceˉlexer.Compilerˉsourceˉscan = Sourceˉlexer.Compilerˉlexˉsource(Textˉtoˉutf8("\"hello"));
    if Unterminated.Status != Sourceˉlexer.Compilerˉlexˉstatus.Unterminatedˉstring { return 27; }
    let Shortˉunicode: Sourceˉlexer.Compilerˉsourceˉscan = Sourceˉlexer.Compilerˉlexˉsource(Textˉtoˉutf8("\"\\u12"));
    if Shortˉunicode.Status != Sourceˉlexer.Compilerˉlexˉstatus.Shortˉunicodeˉescape { return 28; }
    let Badˉunicode: Sourceˉlexer.Compilerˉsourceˉscan = Sourceˉlexer.Compilerˉlexˉsource(Textˉtoˉutf8("\"\\u12xz\""));
    if Badˉunicode.Status != Sourceˉlexer.Compilerˉlexˉstatus.Invalidˉunicodeˉescape { return 29; }
    let Unpaired: Sourceˉlexer.Compilerˉsourceˉscan = Sourceˉlexer.Compilerˉlexˉsource(Textˉtoˉutf8("\"\\uD800\""));
    if Unpaired.Status != Sourceˉlexer.Compilerˉlexˉstatus.Unpairedˉsurrogate { return 30; }
    let Paired: Sourceˉlexer.Compilerˉsourceˉscan = Sourceˉlexer.Compilerˉlexˉsource(Textˉtoˉutf8("\"\\uD83D\\uDE00\""));
    if Paired.Status != Sourceˉlexer.Compilerˉlexˉstatus.Valid { return 31; }
    let Limited: Sourceˉlexer.Compilerˉsourceˉscan = Sourceˉlexer.Compilerˉlexˉsourceˉbounded(Textˉtoˉutf8("! ! !"), 2u32);
    if Limited.Status != Sourceˉlexer.Compilerˉlexˉstatus.Tooˉmanyˉtokens { return 32; }
    let Badˉlimit: Sourceˉlexer.Compilerˉsourceˉscan = Sourceˉlexer.Compilerˉlexˉsourceˉbounded(Complete, 262145u32);
    if Badˉlimit.Status != Sourceˉlexer.Compilerˉlexˉstatus.Invalidˉlimit { return 33; }
    return 0;
}
