module Compilerˉsourceˉwvbˉtool profile hosted;

import Compilerˉsourceˉprofile as Sourceˉprofile;
import Compilerˉsourceˉwvb as Sourceˉwvb;

capability console.write_line;
capability diagnostic.write_line;
capability file.read_bytes;
capability file.write_bytes;
capability process.argument;
capability process.argument_count;

fn Compilerˉsourceˉwvbˉtoolˉheader(Modules: u32) -> bytes {
    var Header: bytes = Textˉtoˉutf8("WVSS");
    Header = Bytesˉconcat(Header, Bytesˉfromˉu16ˉlittle(1u32));
    Header = Bytesˉconcat(Header, Bytesˉfromˉu16ˉlittle(0u32));
    Header = Bytesˉconcat(Header, Bytesˉfromˉu32ˉlittle(Modules));
    return Bytesˉconcat(Header, Bytesˉfromˉu32ˉlittle(Modules * 8u32));
}

fn Compilerˉsourceˉwvbˉtoolˉinput(First: u32, Modules: u32) -> bytes {
    let Empty: bytes = Textˉtoˉutf8("");
    var Directory: bytes = Empty;
    var Payload: bytes = Empty;
    var Sourceˉoffset: u32 = 16u32 + Modules * 8u32;
    var Index: u32 = 0u32;
    while Index < Modules {
        let Source: bytes = file.read_bytes(process.argument(First + Index));
        let Length: u32 = Bytesˉlength(Source);
        if Length == 0u32 { return Empty; }
        if Length > 4194304u32 - Sourceˉoffset { return Empty; }
        Directory = Bytesˉconcat(Directory, Bytesˉfromˉu32ˉlittle(Sourceˉoffset));
        Directory = Bytesˉconcat(Directory, Bytesˉfromˉu32ˉlittle(Length));
        Payload = Bytesˉconcat(Payload, Source);
        Sourceˉoffset = Sourceˉoffset + Length;
        Index = Index + 1u32;
    }
    return Bytesˉconcat(
        Bytesˉconcat(Compilerˉsourceˉwvbˉtoolˉheader(Modules), Directory),
        Payload
    );
}

fn Compilerˉsourceˉwvbˉtoolˉargumentˉequals(
    Argument: text,
    Expectedˉtext: text
) -> bool {
    let Value: bytes = Textˉtoˉutf8(Argument);
    let Expected: bytes = Textˉtoˉutf8(Expectedˉtext);
    if Bytesˉlength(Value) != Bytesˉlength(Expected) { return false; }
    var Index: u32 = 0u32;
    while Index < Bytesˉlength(Expected) {
        if Bytesˉreadˉu8(Value, Index) != Bytesˉreadˉu8(Expected, Index) {
            return false;
        }
        Index = Index + 1u32;
    }
    return true;
}

fn Compilerˉsourceˉwvbˉtoolˉisˉcomplete(Argument: text) -> bool {
    return Compilerˉsourceˉwvbˉtoolˉargumentˉequals(Argument, "--complete");
}

fn Compilerˉsourceˉwvbˉtoolˉcompile(Input: bytes, Optimize: bool)
    -> Sourceˉwvb.Compilerˉsourceˉwvbˉsummary {
    if Optimize {
        return Sourceˉwvb.Compilerˉcompileˉsourceˉwvbˉoptimized(Input);
    }
    return Sourceˉwvb.Compilerˉcompileˉsourceˉwvb(Input);
}

fn Compilerˉsourceˉwvbˉtoolˉreport(
    Summary: Sourceˉwvb.Compilerˉsourceˉwvbˉsummary
) -> text {
    var Report: text = "source wvb status=";
    Report = Textˉconcat(Report, Enumˉname(Summary.Status));
    Report = Textˉconcat(Report, " functions=");
    Report = Textˉconcat(Report, U32ˉformat(Summary.Functions));
    Report = Textˉconcat(Report, " code-bytes=");
    Report = Textˉconcat(Report, U32ˉformat(Summary.Codeˉbytes));
    Report = Textˉconcat(Report, " module-bytes=");
    return Textˉconcat(Report, U32ˉformat(Bytesˉlength(Summary.Bytecode)));
}

fn Compilerˉsourceˉwvbˉtoolˉfailure(
    Summary: Sourceˉwvb.Compilerˉsourceˉwvbˉsummary
) -> text {
    var Report: text = "source wvb status=";
    Report = Textˉconcat(Report, Enumˉname(Summary.Status));
    Report = Textˉconcat(Report, " wir-status=");
    Report = Textˉconcat(Report, Enumˉname(Summary.Wirˉstatus));
    Report = Textˉconcat(Report, " function=");
    Report = Textˉconcat(Report, U32ˉformat(Summary.Failureˉfunction));
    Report = Textˉconcat(Report, " operation=");
    return Textˉconcat(Report, U32ˉformat(Summary.Failureˉoperation));
}

fn Compilerˉsourceˉwvbˉtoolˉprofileˉfailure(
    Compilation: Sourceˉwvb.Compilerˉsourceˉwvbˉprofileˉcompilation
) -> text {
    var Report: text = "source profile status=";
    Report = Textˉconcat(Report, Enumˉname(Compilation.Profileˉstatus));
    Report = Textˉconcat(Report, " offset=");
    return Textˉconcat(Report, U32ˉformat(Compilation.Failureˉoffset));
}

export fn Main() -> i32 {
    let Arguments: u32 = process.argument_count();
    var First: u32 = 0u32;
    var Optimize: bool = true;
    if Arguments > 0u32 && Compilerˉsourceˉwvbˉtoolˉisˉcomplete(
        process.argument(0u32)
    ) {
        First = 1u32;
        Optimize = false;
    }
    var Hasˉprofileˉinputs: bool = false;
    var Lockˉargument: u32 = 0u32;
    var Lockˉhashˉargument: u32 = 0u32;
    var Profileˉargument: u32 = 0u32;
    if Arguments > First && Compilerˉsourceˉwvbˉtoolˉargumentˉequals(
        process.argument(First), "--source-input-lock"
    ) {
        if Arguments - First < 7u32 ||
            !Compilerˉsourceˉwvbˉtoolˉargumentˉequals(
                process.argument(First + 3u32), "--source-profile"
            ) {
            diagnostic.write_line(
                "Usage: source-wvb [--complete] --source-input-lock <inputs.wvlock> <sha256> --source-profile <profile.wvsp> <root.wv> [sorted-dependency.wv ...] <output.wvb>"
            );
            return 64;
        }
        Hasˉprofileˉinputs = true;
        Lockˉargument = First + 1u32;
        Lockˉhashˉargument = First + 2u32;
        Profileˉargument = First + 4u32;
        First = First + 5u32;
    }
    if Arguments - First < 2u32 {
        diagnostic.write_line(
            "Usage: source-wvb [--complete] <root.wv> [sorted-dependency.wv ...] <output.wvb>"
        );
        return 64;
    }
    let Modules: u32 = Arguments - First - 1u32;
    if Modules > 64u32 {
        diagnostic.write_line("source wvb status=Sourceˉwir wir-status=Sourceˉbindings");
        return 64;
    }
    let Input: bytes = Compilerˉsourceˉwvbˉtoolˉinput(First, Modules);
    var Summary: Sourceˉwvb.Compilerˉsourceˉwvbˉsummary =
        Compilerˉsourceˉwvbˉtoolˉcompile(Textˉtoˉutf8(""), Optimize);
    if Hasˉprofileˉinputs {
        let Compilation: Sourceˉwvb.Compilerˉsourceˉwvbˉprofileˉcompilation =
            Sourceˉwvb.Compilerˉcompileˉsourceˉwvbˉwithˉprofileˉinputs(
                Input,
                file.read_bytes(process.argument(Lockˉargument)),
                Textˉtoˉutf8(process.argument(Lockˉhashˉargument)),
                file.read_bytes(process.argument(Profileˉargument)),
                Optimize
            );
        if Compilation.Profileˉstatus !=
            Sourceˉprofile.Compilerˉsourceˉprofileˉstatus.Valid {
            diagnostic.write_line(
                Compilerˉsourceˉwvbˉtoolˉprofileˉfailure(Compilation)
            );
            return 1;
        }
        Summary = Compilation.Summary;
    } else {
        Summary = Compilerˉsourceˉwvbˉtoolˉcompile(Input, Optimize);
    }
    if Summary.Status != Sourceˉwvb.Compilerˉsourceˉwvbˉstatus.Valid {
        diagnostic.write_line(Compilerˉsourceˉwvbˉtoolˉfailure(Summary));
        return 1;
    }
    file.write_bytes(process.argument(First + Modules), Summary.Bytecode);
    console.write_line(Compilerˉsourceˉwvbˉtoolˉreport(Summary));
    return 0;
}
