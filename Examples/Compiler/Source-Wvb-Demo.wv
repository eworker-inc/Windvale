module Compilerˉsourceˉwvbˉdemo profile portable;

import Compilerˉsourceˉwirˉconsumer as Wirˉconsumer;
import Compilerˉsourceˉwvb as Sourceˉwvb;
import Compilerˉsourceˉwvbˉcompilation as Sourceˉcompilation;

fn Compilerˉsourceˉwvbˉdemoˉinput(Source: text) -> bytes {
    let Sourceˉbytes: bytes = Textˉtoˉutf8(Source);
    var Header: bytes = Textˉtoˉutf8("WVSS");
    Header = Bytesˉconcat(Header, Bytesˉfromˉu16ˉlittle(1u32));
    Header = Bytesˉconcat(Header, Bytesˉfromˉu16ˉlittle(0u32));
    Header = Bytesˉconcat(Header, Bytesˉfromˉu32ˉlittle(1u32));
    Header = Bytesˉconcat(Header, Bytesˉfromˉu32ˉlittle(8u32));
    Header = Bytesˉconcat(Header, Bytesˉfromˉu32ˉlittle(24u32));
    Header = Bytesˉconcat(Header, Bytesˉfromˉu32ˉlittle(Bytesˉlength(Sourceˉbytes)));
    return Bytesˉconcat(Header, Sourceˉbytes);
}

fn Compilerˉsourceˉwvbˉdemoˉstatus(
    Source: text
) -> Sourceˉwvb.Compilerˉsourceˉwvbˉstatus {
    let Summary: Sourceˉwvb.Compilerˉsourceˉwvbˉsummary = Sourceˉcompilation.Compilerˉcompileˉsourceˉwvb(
        Compilerˉsourceˉwvbˉdemoˉinput(Source)
    );
    return Summary.Status;
}

fn Compilerˉsourceˉwvbˉdemoˉpair(Root: text, Dependency: text) -> bytes {
    let Rootˉbytes: bytes = Textˉtoˉutf8(Root);
    let Dependencyˉbytes: bytes = Textˉtoˉutf8(Dependency);
    var Header: bytes = Textˉtoˉutf8("WVSS");
    Header = Bytesˉconcat(Header, Bytesˉfromˉu16ˉlittle(1u32));
    Header = Bytesˉconcat(Header, Bytesˉfromˉu16ˉlittle(0u32));
    Header = Bytesˉconcat(Header, Bytesˉfromˉu32ˉlittle(2u32));
    Header = Bytesˉconcat(Header, Bytesˉfromˉu32ˉlittle(16u32));
    Header = Bytesˉconcat(Header, Bytesˉfromˉu32ˉlittle(32u32));
    Header = Bytesˉconcat(Header, Bytesˉfromˉu32ˉlittle(Bytesˉlength(Rootˉbytes)));
    Header = Bytesˉconcat(
        Header,
        Bytesˉfromˉu32ˉlittle(32u32 + Bytesˉlength(Rootˉbytes))
    );
    Header = Bytesˉconcat(
        Header, Bytesˉfromˉu32ˉlittle(Bytesˉlength(Dependencyˉbytes))
    );
    return Bytesˉconcat(
        Bytesˉconcat(Header, Rootˉbytes), Dependencyˉbytes
    );
}

fn Compilerˉsourceˉwvbˉdemoˉdataˉcount(Bytecode: bytes) -> u32 {
    var Offset: u32 = 12u32;
    var Section: u32 = 0u32;
    while Section < 7u32 {
        let Kind: u8 = Bytesˉreadˉu8(Bytecode, Offset);
        let Length: u32 = Bytesˉreadˉu32ˉlittle(Bytecode, Offset + 4u32);
        if Kind == 3u8 {
            return Bytesˉreadˉu32ˉlittle(Bytecode, Offset + 8u32);
        }
        Offset = Offset + 8u32 + Length;
        Section = Section + 1u32;
    }
    return 4294967295u32;
}

export fn Main() -> i32 {
    let Valid: Sourceˉwvb.Compilerˉsourceˉwvbˉsummary = Sourceˉcompilation.Compilerˉcompileˉsourceˉwvb(
        Compilerˉsourceˉwvbˉdemoˉinput(
            "module Wvbˉdemo profile portable; fn Add(Value: i32) -> i32 { return Value + 1; } export fn Main() -> i32 { return Add(41); }"
        )
    );
    if Valid.Status != Sourceˉwvb.Compilerˉsourceˉwvbˉstatus.Valid { return 1; }
    if Valid.Wirˉstatus != Wirˉconsumer.Compilerˉsourceˉwirˉstatus.Valid { return 2; }
    if Valid.Functions != 2u32 { return 3; }
    if Bytesˉlength(Valid.Bytecode) == 0u32 { return 4; }
    if Bytesˉreadˉu8(Valid.Bytecode, 0u32) != 87u8 { return 5; }
    if Bytesˉreadˉu8(Valid.Bytecode, 1u32) != 86u8 { return 6; }
    if Bytesˉreadˉu8(Valid.Bytecode, 2u32) != 66u8 { return 7; }
    if Bytesˉreadˉu8(Valid.Bytecode, 3u32) != 49u8 { return 8; }
    if Compilerˉsourceˉwvbˉdemoˉstatus(
        "module Wvbˉdata profile portable; data Value: text = \"x\"; export fn Main() -> i32 { return 0; }"
    ) != Sourceˉwvb.Compilerˉsourceˉwvbˉstatus.Valid { return 9; }
    if Compilerˉsourceˉwvbˉdemoˉstatus(
        "module Wvbˉhosted profile hosted; export fn Main() -> i32 { return 0; }"
    ) != Sourceˉwvb.Compilerˉsourceˉwvbˉstatus.Valid { return 10; }
    if Compilerˉsourceˉwvbˉdemoˉstatus(
        "module Wvbˉorder profile portable; export fn Zed() -> i32 { return 0; } fn Alpha() -> i32 { return 1; }"
    ) != Sourceˉwvb.Compilerˉsourceˉwvbˉstatus.Valid { return 11; }
    if Compilerˉsourceˉwvbˉdemoˉstatus(
        "module Wvbˉrecord profile portable; record Pair { Value: i32; } export fn Main() -> i32 { return 0; }"
    ) != Sourceˉwvb.Compilerˉsourceˉwvbˉstatus.Valid { return 12; }
    if Compilerˉsourceˉwvbˉdemoˉstatus(
        "module Wvbˉsystem profile system; capability process.argument_count; export fn Main() -> i32 { return 0; }"
    ) != Sourceˉwvb.Compilerˉsourceˉwvbˉstatus.Valid { return 13; }
    if Compilerˉsourceˉwvbˉdemoˉstatus(
        "module Wvbˉcapabilityˉreference profile hosted; capability console.write_line; fn Copy(Output: console.write_line) -> console.write_line { return Output; } fn Use(Output: console.write_line, Value: text) -> void { Output(Value); } export fn Main() -> i32 { let Output: console.write_line = Copy(console.write_line); if false { Use(Output, \"unused\"); } return 0; }"
    ) != Sourceˉwvb.Compilerˉsourceˉwvbˉstatus.Valid { return 35; }
    if Compilerˉsourceˉwvbˉdemoˉstatus(
        "module Wvbˉtry profile portable; variant Outcome { Valid; Failure(Error: u32); } fn Check(Fail: bool) -> Outcome { if Fail { return Outcome.Failure(1u32); } return Outcome.Valid(); } export fn Main() -> Outcome { try Check(false); return Outcome.Valid(); }"
    ) != Sourceˉwvb.Compilerˉsourceˉwvbˉstatus.Valid { return 36; }
    let Composed: Sourceˉwvb.Compilerˉsourceˉwvbˉsummary = Sourceˉcompilation.Compilerˉcompileˉsourceˉwvb(
        Compilerˉsourceˉwvbˉdemoˉpair(
            "module Wvbˉroot profile portable; import Wvbˉdependency as Dependency; export fn Main() -> i32 { return Dependency.Wvbˉvalue(); }",
            "module Wvbˉdependency profile portable; export fn Wvbˉvalue() -> i32 { return 42; }"
        )
    );
    if Composed.Status != Sourceˉwvb.Compilerˉsourceˉwvbˉstatus.Valid { return 14; }
    if Composed.Functions != 2u32 { return 15; }
    if Compilerˉsourceˉwvbˉdemoˉstatus(
        "module Wvbˉinference profile portable; data Values: bytes = [3u8, 5u8]; record Pair { Left: u32; Right: u32; } enum State { Ready = 0; } fn Add(Left: u32, Right: u32) -> u32 { return Left + Right; } export fn Main() -> u32 { let Count = Bytesˉlength(Values); let Pairˉvalue = Pair { Left: Count, Right: 2u32 }; let Stateˉvalue = State.Ready; var Result = Add(Pairˉvalue.Left, Pairˉvalue.Right); if Stateˉvalue != State.Ready { return 0u32; } else if Stateˉvalue == State.Ready { Result = Result + 1u32; } return Result; }"
    ) != Sourceˉwvb.Compilerˉsourceˉwvbˉstatus.Valid { return 16; }
    if Compilerˉsourceˉwvbˉdemoˉstatus(
        "module Wvbˉcontrol profile portable; export fn Main() -> i32 { var Result = 0; var Index = 0; if false || true && true { while Index < 5 { Index += 1; if Index == 2 { continue; } if Index == 4 { break; } Result += Index; } Result *= 2; Result -= 1; } return Result; }"
    ) != Sourceˉwvb.Compilerˉsourceˉwvbˉstatus.Valid { return 17; }
    let Reachabilityˉinput: bytes = Compilerˉsourceˉwvbˉdemoˉinput(
        "module Wvbˉreachability profile portable; fn Dead() -> i32 { return 0; } fn Leaf() -> i32 { return 42; } fn Middle() -> i32 { return Leaf(); } export fn Main() -> i32 { return Middle(); }"
    );
    let Reachability: Sourceˉwvb.Compilerˉsourceˉwvbˉreachability =
        Sourceˉcompilation.Compilerˉanalyzeˉsourceˉwvbˉreachability(
            Reachabilityˉinput
        );
    if Reachability.Status != Sourceˉwvb.Compilerˉsourceˉwvbˉstatus.Valid {
        return 18;
    }
    if Reachability.Functions != 4u32 || Reachability.Roots != 1u32 {
        return 19;
    }
    if Reachability.Reachable != 3u32 || Reachability.Unreachable != 1u32 {
        return 20;
    }
    if Reachability.Calls != 2u32 || Reachability.Reachableˉcalls != 2u32 {
        return 21;
    }
    let Reachabilityˉcompiled: Sourceˉwvb.Compilerˉsourceˉwvbˉsummary =
        Sourceˉcompilation.Compilerˉcompileˉsourceˉwvb(Reachabilityˉinput);
    if Reachability.Codeˉbytes != Reachabilityˉcompiled.Codeˉbytes {
        return 22;
    }
    if Reachability.Codeˉbytes != Reachability.Reachableˉcodeˉbytes +
        Reachability.Unreachableˉcodeˉbytes {
        return 23;
    }
    if Reachability.Unreachableˉcodeˉbytes == 0u32 { return 24; }
    let Multipleˉroots: Sourceˉwvb.Compilerˉsourceˉwvbˉreachability =
        Sourceˉcompilation.Compilerˉanalyzeˉsourceˉwvbˉreachability(
            Compilerˉsourceˉwvbˉdemoˉinput(
                "module Wvbˉroots profile portable; fn Dead() -> i32 { return 0; } fn Used() -> i32 { return 1; } export fn Main() -> i32 { return Used(); } export fn Public() -> i32 { return 2; }"
            )
        );
    if Multipleˉroots.Status != Sourceˉwvb.Compilerˉsourceˉwvbˉstatus.Valid ||
        Multipleˉroots.Roots != 2u32 || Multipleˉroots.Reachable != 3u32 ||
        Multipleˉroots.Unreachable != 1u32 {
        return 25;
    }
    let Cyclic: Sourceˉwvb.Compilerˉsourceˉwvbˉreachability =
        Sourceˉcompilation.Compilerˉanalyzeˉsourceˉwvbˉreachability(
            Compilerˉsourceˉwvbˉdemoˉinput(
                "module Wvbˉcycle profile portable; fn Cycle() -> i32 { return Main(); } export fn Main() -> i32 { return Cycle(); }"
            )
        );
    if Cyclic.Status != Sourceˉwvb.Compilerˉsourceˉwvbˉstatus.Valid ||
        Cyclic.Roots != 1u32 || Cyclic.Reachable != 2u32 ||
        Cyclic.Calls != 2u32 {
        return 26;
    }
    let Invalidˉreachability: Sourceˉwvb.Compilerˉsourceˉwvbˉreachability =
        Sourceˉcompilation.Compilerˉanalyzeˉsourceˉwvbˉreachability(
            Compilerˉsourceˉwvbˉdemoˉinput(
                "module Wvbˉinvalid profile portable; export fn Main() -> i32 { return Missing(); }"
            )
        );
    if Invalidˉreachability.Status !=
        Sourceˉwvb.Compilerˉsourceˉwvbˉstatus.Sourceˉwir ||
        Invalidˉreachability.Wirˉstatus !=
        Wirˉconsumer.Compilerˉsourceˉwirˉstatus.Sourceˉbindings ||
        Bytesˉlength(Invalidˉreachability.Map) != 0u32 {
        return 27;
    }
    let Optimized: Sourceˉwvb.Compilerˉsourceˉwvbˉsummary =
        Sourceˉcompilation.Compilerˉcompileˉsourceˉwvbˉoptimized(
            Reachabilityˉinput
        );
    if Optimized.Status != Sourceˉwvb.Compilerˉsourceˉwvbˉstatus.Valid ||
        Optimized.Functions != Reachability.Reachable ||
        Optimized.Codeˉbytes != Reachability.Reachableˉcodeˉbytes {
        return 28;
    }
    if Bytesˉlength(Optimized.Bytecode) >=
        Bytesˉlength(Reachabilityˉcompiled.Bytecode) {
        return 29;
    }
    let Repeatedˉoptimized: Sourceˉwvb.Compilerˉsourceˉwvbˉsummary =
        Sourceˉcompilation.Compilerˉcompileˉsourceˉwvbˉoptimized(
            Reachabilityˉinput
        );
    if Repeatedˉoptimized.Bytecode != Optimized.Bytecode { return 30; }
    let Literalˉinput: bytes = Compilerˉsourceˉwvbˉdemoˉinput(
        "module Wvbˉliteralˉpruning profile portable; fn Dead() -> text { return \"unused\"; } fn Live() -> text { return \"used\"; } export fn Main() -> text { return Live(); }"
    );
    let Literalˉfull: Sourceˉwvb.Compilerˉsourceˉwvbˉsummary =
        Sourceˉcompilation.Compilerˉcompileˉsourceˉwvb(Literalˉinput);
    let Literalˉoptimized: Sourceˉwvb.Compilerˉsourceˉwvbˉsummary =
        Sourceˉcompilation.Compilerˉcompileˉsourceˉwvbˉoptimized(Literalˉinput);
    if Literalˉfull.Status != Sourceˉwvb.Compilerˉsourceˉwvbˉstatus.Valid ||
        Literalˉoptimized.Status !=
        Sourceˉwvb.Compilerˉsourceˉwvbˉstatus.Valid {
        return 31;
    }
    if Compilerˉsourceˉwvbˉdemoˉdataˉcount(Literalˉfull.Bytecode) != 2u32 ||
        Compilerˉsourceˉwvbˉdemoˉdataˉcount(
            Literalˉoptimized.Bytecode
        ) != 1u32 {
        return 32;
    }
    let Explicitˉdataˉinput: bytes = Compilerˉsourceˉwvbˉdemoˉinput(
        "module Wvbˉexplicitˉdataˉpruning profile portable; data Dead: bytes = [1u8]; data Used: bytes = [42u8]; export fn Main() -> u32 { return Bytesˉlength(Used); }"
    );
    let Explicitˉdataˉfull: Sourceˉwvb.Compilerˉsourceˉwvbˉsummary =
        Sourceˉcompilation.Compilerˉcompileˉsourceˉwvb(Explicitˉdataˉinput);
    let Explicitˉdataˉoptimized: Sourceˉwvb.Compilerˉsourceˉwvbˉsummary =
        Sourceˉcompilation.Compilerˉcompileˉsourceˉwvbˉoptimized(
            Explicitˉdataˉinput
        );
    if Explicitˉdataˉfull.Status !=
        Sourceˉwvb.Compilerˉsourceˉwvbˉstatus.Valid ||
        Explicitˉdataˉoptimized.Status !=
        Sourceˉwvb.Compilerˉsourceˉwvbˉstatus.Valid {
        return 33;
    }
    if Compilerˉsourceˉwvbˉdemoˉdataˉcount(
        Explicitˉdataˉfull.Bytecode
    ) != 2u32 || Compilerˉsourceˉwvbˉdemoˉdataˉcount(
        Explicitˉdataˉoptimized.Bytecode
    ) != 1u32 {
        return 34;
    }
    return 0;
}
