];

fn Replaceˉu8(Input: bytes, Offset: u32, Value: u8) -> bytes {
    let Prefix: bytes = Bytesˉslice(Input, 0u32, Offset);
    let Suffixˉoffset: u32 = Offset + 1u32;
    let Suffix: bytes = Bytesˉslice(
        Input,
        Suffixˉoffset,
        Bytesˉlength(Input) - Suffixˉoffset
    );
    let Encoded: bytes = Bytesˉslice(
        Bytesˉfromˉu32ˉlittle(U32ˉfromˉu8(Value)),
        0u32,
        1u32
    );
    return Bytesˉconcat(Bytesˉconcat(Prefix, Encoded), Suffix);
}

fn Same(Left: bytes, Right: bytes) -> bool {
    if Bytesˉlength(Left) != Bytesˉlength(Right) { return false; }
    var Index: u32 = 0u32;
    while Index < Bytesˉlength(Left) {
        if Bytesˉreadˉu8(Left, Index) != Bytesˉreadˉu8(Right, Index) { return false; }
        Index = Index + 1u32;
    }
    return true;
}

fn Differentˉu8(Value: u8) -> u8 {
    if Value == 0u8 { return 1u8; }
    return 0u8;
}

export fn Main() -> i32 {
    let Count: Nativeˉstencil.Nativeˉstencilˉresult =
        Nativeˉstencil.Nativeˉstencilˉprocessˉargumentˉcount(Argumentˉcountˉobject);
    if Count.Status != Nativeˉstencil.Nativeˉstencilˉstatus.Valid { return 1; }
    if Bytesˉlength(Count.Value) != 5u32 { return 2; }
    if Bytesˉreadˉu8(Count.Value, 3u32) != 80u8 { return 3; }

    let Argument: Nativeˉstencil.Nativeˉstencilˉresult =
        Nativeˉstencil.Nativeˉstencilˉprocessˉargument(Argumentˉobject);
    if Argument.Status != Nativeˉstencil.Nativeˉstencilˉstatus.Valid { return 4; }
    if Bytesˉlength(Argument.Value) != 70u32 { return 5; }
    if Bytesˉreadˉu8(Argument.Value, 3u32) != 64u8 { return 6; }
    if Bytesˉreadˉu8(Argument.Value, 11u32) != 80u8 { return 7; }
    if Bytesˉreadˉu8(Argument.Value, 21u32) != 72u8 { return 8; }
    if Bytesˉreadˉu8(Argument.Value, 40u32) != 8u8 { return 9; }
    if Bytesˉreadˉu8(Argument.Value, 44u32) != 8u8 { return 10; }
    if Bytesˉreadˉu8(Argument.Value, 48u32) != 12u8 { return 11; }
    if Bytesˉreadˉu8(Argument.Value, 59u32) != 64u8 { return 12; }
    if Bytesˉreadˉu8(Argument.Value, 60u32) != 3u8 { return 13; }

    let Repeated: Nativeˉstencil.Nativeˉstencilˉresult = Nativeˉstencil.Nativeˉstencilˉprocessˉargument(Argumentˉobject);
    if Repeated.Status != Nativeˉstencil.Nativeˉstencilˉstatus.Valid { return 14; }
    if !Same(Argument.Value, Repeated.Value) { return 15; }

    let Short: Nativeˉstencil.Nativeˉstencilˉresult = Nativeˉstencil.Nativeˉstencilˉprocessˉargumentˉcount(
        Bytesˉslice(Argumentˉcountˉobject, 0u32, 165u32)
    );
    if Short.Status != Nativeˉstencil.Nativeˉstencilˉstatus.Invalidˉsize { return 16; }
    if Bytesˉlength(Short.Value) != 0u32 { return 17; }

    let Badˉheader: Nativeˉstencil.Nativeˉstencilˉresult = Nativeˉstencil.Nativeˉstencilˉprocessˉargumentˉcount(
        Replaceˉu8(Argumentˉcountˉobject, 0u32, 0u8)
    );
    if Badˉheader.Status != Nativeˉstencil.Nativeˉstencilˉstatus.Invalidˉobject { return 18; }

    let Badˉsection: Nativeˉstencil.Nativeˉstencilˉresult = Nativeˉstencil.Nativeˉstencilˉprocessˉargument(
        Replaceˉu8(Argumentˉobject, 28u32, 2u8)
    );
    if Badˉsection.Status != Nativeˉstencil.Nativeˉstencilˉstatus.Invalidˉobject { return 19; }

    let Badˉsymbol: Nativeˉstencil.Nativeˉstencilˉresult = Nativeˉstencil.Nativeˉstencilˉprocessˉargumentˉcount(
        Replaceˉu8(Argumentˉcountˉobject, 96u32, 66u8)
    );
    if Badˉsymbol.Status != Nativeˉstencil.Nativeˉstencilˉstatus.Invalidˉobject { return 20; }

    let Badˉmetadata: Nativeˉstencil.Nativeˉstencilˉresult = Nativeˉstencil.Nativeˉstencilˉprocessˉargument(
        Replaceˉu8(Argumentˉobject, 59u32, 7u8)
    );
    if Badˉmetadata.Status != Nativeˉstencil.Nativeˉstencilˉstatus.Invalidˉmetadata { return 21; }

    let Badˉpatch: Nativeˉstencil.Nativeˉstencilˉresult = Nativeˉstencil.Nativeˉstencilˉprocessˉargumentˉcount(
        Replaceˉu8(Argumentˉcountˉobject, 59u32, 4u8)
    );
    if Badˉpatch.Status != Nativeˉstencil.Nativeˉstencilˉstatus.Invalidˉmetadata { return 22; }

    let Badˉtemplate: Nativeˉstencil.Nativeˉstencilˉresult = Nativeˉstencil.Nativeˉstencilˉprocessˉargument(
        Replaceˉu8(Argumentˉobject, 163u32, 0u8)
    );
    if Badˉtemplate.Status != Nativeˉstencil.Nativeˉstencilˉstatus.Invalidˉtemplate { return 23; }

    let Filledˉhole: Nativeˉstencil.Nativeˉstencilˉresult = Nativeˉstencil.Nativeˉstencilˉprocessˉargumentˉcount(
        Replaceˉu8(Argumentˉcountˉobject, 74u32, 80u8)
    );
    if Filledˉhole.Status != Nativeˉstencil.Nativeˉstencilˉstatus.Invalidˉtemplate { return 24; }

    var Countˉindex: u32 = 0u32;
    while Countˉindex < Bytesˉlength(Argumentˉcountˉobject) {
        let Mutatedˉcount: Nativeˉstencil.Nativeˉstencilˉresult =
            Nativeˉstencil.Nativeˉstencilˉprocessˉargumentˉcount(
                Replaceˉu8(
                    Argumentˉcountˉobject,
                    Countˉindex,
                    Differentˉu8(Bytesˉreadˉu8(Argumentˉcountˉobject, Countˉindex))
                )
            );
        if Mutatedˉcount.Status == Nativeˉstencil.Nativeˉstencilˉstatus.Valid { return 25; }
        Countˉindex = Countˉindex + 1u32;
    }

    var Argumentˉindex: u32 = 0u32;
    while Argumentˉindex < Bytesˉlength(Argumentˉobject) {
        let Mutatedˉargument: Nativeˉstencil.Nativeˉstencilˉresult =
            Nativeˉstencil.Nativeˉstencilˉprocessˉargument(
                Replaceˉu8(
                    Argumentˉobject,
                    Argumentˉindex,
                    Differentˉu8(Bytesˉreadˉu8(Argumentˉobject, Argumentˉindex))
                )
            );
        if Mutatedˉargument.Status == Nativeˉstencil.Nativeˉstencilˉstatus.Valid { return 26; }
        Argumentˉindex = Argumentˉindex + 1u32;
    }
    return 0;
}
