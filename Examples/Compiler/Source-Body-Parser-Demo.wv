module Compilerˉsourceˉbodyˉparserˉdemo profile portable;

import Compilerˉsourceˉbodyˉparser as Sourceˉbodies;
import Compilerˉsourceˉdeclarationˉparser as Sourceˉdeclarations;
import Compilerˉsourceˉlexer as Sourceˉlexer;

data Invalidˉutf8: bytes = [195, 40];

export fn Main() -> i32 {
    let Complete: bytes = Textˉtoˉutf8("module Bodyˉtest profile portable; fn Helper(Value: i32) -> i32 { var Total: i32 = -Value + 2 * 3; Total = Total + 1; if Total >= 0 { while Total > 0 { Total = Total - 1; } } else { { return 1; } } Console.writeˉline(\"x\"); return Values[Call(1, 2)] + Pair.Left; } fn Empty() -> void { return; }");
    let Summary: Sourceˉbodies.Compilerˉsourceˉbodyˉsummary = Sourceˉbodies.Compilerˉparseˉsourceˉbodies(Complete);
    if Summary.Status != Sourceˉbodies.Compilerˉbodyˉparseˉstatus.Valid { return 1; }
    if Summary.Functions != 2u32 { return 2; }
    if Summary.Topˉlevelˉstatements != 6u32 { return 3; }
    if Summary.Statements != 10u32 { return 4; }
    if Summary.Expressions != 27u32 { return 5; }
    if Summary.Maximumˉstatementˉdepth != 3u32 { return 6; }
    if Summary.Maximumˉexpressionˉdepth != 4u32 { return 7; }
    let Declarations: Sourceˉdeclarations.Compilerˉsourceˉmoduleˉsummary = Sourceˉdeclarations.Compilerˉparseˉsource(Complete);
    let Reused: Sourceˉbodies.Compilerˉsourceˉbodyˉsummary =
        Sourceˉbodies.Compilerˉparseˉsourceˉbodiesˉfromˉdeclarations(Complete, Declarations);
    if Reused.Status != Summary.Status { return 33; }
    if Reused.Functions != Summary.Functions { return 34; }
    if Reused.Topˉlevelˉstatements != Summary.Topˉlevelˉstatements { return 35; }
    if Reused.Statements != Summary.Statements { return 36; }
    if Reused.Expressions != Summary.Expressions { return 37; }
    if Reused.Maximumˉstatementˉdepth != Summary.Maximumˉstatementˉdepth { return 38; }
    if Reused.Maximumˉexpressionˉdepth != Summary.Maximumˉexpressionˉdepth { return 39; }
    if Reused.Endˉoffset != Summary.Endˉoffset { return 40; }

    let Body: bytes = Textˉtoˉutf8("{ var Total: i32 = -Value + 2 * 3; return Total; }");
    let Bodyˉsummary: Sourceˉbodies.Compilerˉsourceˉbodyˉsummary = Sourceˉbodies.Compilerˉparseˉbodyˉspan(Body, 0u32, 1u32, 1u32, Bytesˉlength(Body));
    if Bodyˉsummary.Status != Sourceˉbodies.Compilerˉbodyˉparseˉstatus.Valid { return 8; }
    if Bodyˉsummary.Topˉlevelˉstatements != 2u32 { return 9; }
    let First: Sourceˉbodies.Compilerˉsourceˉstatement = Sourceˉbodies.Compilerˉparseˉnextˉstatementˉvalidated(Body, 1u32, 1u32, 2u32, Bytesˉlength(Body), 0u32);
    if First.Status != Sourceˉbodies.Compilerˉbodyˉparseˉstatus.Valid { return 10; }
    if First.Kind != Sourceˉbodies.Compilerˉsourceˉstatementˉkind.Local { return 11; }
    if !First.Isˉmutable { return 12; }
    if First.Typeˉkind != Sourceˉdeclarations.Compilerˉsourceˉtypeˉkind.I32 { return 13; }
    if First.Expressions != 6u32 { return 14; }

    let Inferredˉbody: bytes = Textˉtoˉutf8("{ let Value = 1u32; }");
    let Inferredˉsummary: Sourceˉbodies.Compilerˉsourceˉbodyˉsummary = Sourceˉbodies.Compilerˉparseˉbodyˉspan(Inferredˉbody, 0u32, 1u32, 1u32, Bytesˉlength(Inferredˉbody));
    if Inferredˉsummary.Status != Sourceˉbodies.Compilerˉbodyˉparseˉstatus.Valid { return 41; }
    let Inferred: Sourceˉbodies.Compilerˉsourceˉstatement = Sourceˉbodies.Compilerˉparseˉnextˉstatementˉvalidated(Inferredˉbody, 1u32, 1u32, 2u32, Bytesˉlength(Inferredˉbody), 0u32);
    if Inferred.Typeˉkind != Sourceˉdeclarations.Compilerˉsourceˉtypeˉkind.Unknown { return 42; }
    if Inferred.Typeˉlength != 0u32 { return 43; }

    let Precedenceˉsource: bytes = Textˉtoˉutf8("A + B * C");
    let Precedence: Sourceˉbodies.Compilerˉsourceˉexpression = Sourceˉbodies.Compilerˉparseˉexpressionˉspan(Precedenceˉsource, 0u32, 1u32, 1u32, Bytesˉlength(Precedenceˉsource));
    if Precedence.Status != Sourceˉbodies.Compilerˉbodyˉparseˉstatus.Valid { return 15; }
    if Precedence.Kind != Sourceˉbodies.Compilerˉsourceˉexpressionˉkind.Binary { return 16; }
    if Precedence.Operator != Sourceˉlexer.Compilerˉtokenˉkind.Plus { return 17; }
    if Precedence.Nodes != 5u32 { return 18; }
    if Precedence.Depth != 3u32 { return 19; }
    let Rightˉposition: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(Precedenceˉsource, Precedence.Offset, Precedence.Line, Precedence.Column, Precedence.Secondˉoffset);
    let Right: Sourceˉbodies.Compilerˉsourceˉexpression = Sourceˉbodies.Compilerˉparseˉexpressionˉspan(Precedenceˉsource, Precedence.Secondˉoffset, Rightˉposition.Line, Rightˉposition.Column, Precedence.Secondˉoffset + Precedence.Secondˉlength);
    if Right.Operator != Sourceˉlexer.Compilerˉtokenˉkind.Star { return 20; }
    if Right.Nodes != 3u32 { return 21; }

    let Callˉsource: bytes = Textˉtoˉutf8("Call(1, Values[2])");
    let Call: Sourceˉbodies.Compilerˉsourceˉexpression = Sourceˉbodies.Compilerˉparseˉexpressionˉspan(Callˉsource, 0u32, 1u32, 1u32, Bytesˉlength(Callˉsource));
    if Call.Kind != Sourceˉbodies.Compilerˉsourceˉexpressionˉkind.Call { return 22; }
    if Call.Items != 2u32 { return 23; }
    if Call.Nodes != 4u32 { return 24; }
    if Call.Depth != 3u32 { return 25; }

    let Recordˉsource: bytes = Textˉtoˉutf8(
        "Pair { Right: Call(1), Left: 2, }"
    );
    let Recordˉliteral: Sourceˉbodies.Compilerˉsourceˉexpression = Sourceˉbodies.Compilerˉparseˉexpressionˉspan(
        Recordˉsource, 0u32, 1u32, 1u32, Bytesˉlength(Recordˉsource)
    );
    if Recordˉliteral.Status != Sourceˉbodies.Compilerˉbodyˉparseˉstatus.Valid { return 44; }
    if Recordˉliteral.Kind != Sourceˉbodies.Compilerˉsourceˉexpressionˉkind.Namedˉrecord { return 45; }
    if Recordˉliteral.Items != 2u32 { return 46; }
    if Recordˉliteral.Nodes != 4u32 { return 47; }
    if Recordˉliteral.Depth != 3u32 { return 48; }

    let Elseˉifˉsource: bytes = Textˉtoˉutf8(
        "module Elseˉif profile portable; export fn Main(Value: i32) -> i32 { if Value < 0 { return 1; } else if Value > 0 { return 2; } else { return 3; } }"
    );
    let Elseˉifˉsummary: Sourceˉbodies.Compilerˉsourceˉbodyˉsummary =
        Sourceˉbodies.Compilerˉparseˉsourceˉbodies(Elseˉifˉsource);
    if Elseˉifˉsummary.Status != Sourceˉbodies.Compilerˉbodyˉparseˉstatus.Valid { return 49; }

    let Booleanˉsource: bytes = Textˉtoˉutf8("false || true && false");
    let Booleanˉexpression: Sourceˉbodies.Compilerˉsourceˉexpression = Sourceˉbodies.Compilerˉparseˉexpressionˉspan(
        Booleanˉsource, 0u32, 1u32, 1u32, Bytesˉlength(Booleanˉsource)
    );
    if Booleanˉexpression.Status != Sourceˉbodies.Compilerˉbodyˉparseˉstatus.Valid { return 50; }
    if Booleanˉexpression.Operator != Sourceˉlexer.Compilerˉtokenˉkind.Orˉor { return 51; }
    let Booleanˉrightˉposition: Sourceˉbodies.Compilerˉsourceˉposition = Sourceˉbodies.Compilerˉbodyˉpositionˉbetween(
        Booleanˉsource,
        Booleanˉexpression.Offset,
        Booleanˉexpression.Line,
        Booleanˉexpression.Column,
        Booleanˉexpression.Secondˉoffset
    );
    let Booleanˉright: Sourceˉbodies.Compilerˉsourceˉexpression = Sourceˉbodies.Compilerˉparseˉexpressionˉspan(
        Booleanˉsource,
        Booleanˉexpression.Secondˉoffset,
        Booleanˉrightˉposition.Line,
        Booleanˉrightˉposition.Column,
        Booleanˉexpression.Secondˉoffset + Booleanˉexpression.Secondˉlength
    );
    if Booleanˉright.Operator != Sourceˉlexer.Compilerˉtokenˉkind.Andˉand { return 52; }

    let Loopˉsource: bytes = Textˉtoˉutf8(
        "{ var Index = 0; while true { Index += 1; if Index == 2 { continue; } break; } }"
    );
    let Loopˉsummary: Sourceˉbodies.Compilerˉsourceˉbodyˉsummary = Sourceˉbodies.Compilerˉparseˉbodyˉspan(
        Loopˉsource, 0u32, 1u32, 1u32, Bytesˉlength(Loopˉsource)
    );
    if Loopˉsummary.Status != Sourceˉbodies.Compilerˉbodyˉparseˉstatus.Valid { return 53; }
    if Loopˉsummary.Statements != 6u32 { return 54; }

    let Tryˉsource: bytes = Textˉtoˉutf8("{ try Validate(); }");
    let Tryˉsummary: Sourceˉbodies.Compilerˉsourceˉbodyˉsummary =
        Sourceˉbodies.Compilerˉparseˉbodyˉspan(
            Tryˉsource, 0u32, 1u32, 1u32, Bytesˉlength(Tryˉsource)
        );
    if Tryˉsummary.Status != Sourceˉbodies.Compilerˉbodyˉparseˉstatus.Valid { return 55; }
    let Tryˉstatement: Sourceˉbodies.Compilerˉsourceˉstatement =
        Sourceˉbodies.Compilerˉparseˉnextˉstatementˉvalidated(
            Tryˉsource, 1u32, 1u32, 2u32,
            Bytesˉlength(Tryˉsource), 0u32
        );
    if Tryˉstatement.Kind != Sourceˉbodies.Compilerˉsourceˉstatementˉkind.Try { return 56; }
    if Tryˉstatement.Expressions != 1u32 { return 57; }

    let Missingˉsemicolon: Sourceˉbodies.Compilerˉsourceˉbodyˉsummary = Sourceˉbodies.Compilerˉparseˉsourceˉbodies(Textˉtoˉutf8("module Bad profile portable; fn Main() -> i32 { return 0 }"));
    if Missingˉsemicolon.Status != Sourceˉbodies.Compilerˉbodyˉparseˉstatus.Expectedˉtoken { return 26; }
    if Missingˉsemicolon.Expected != Sourceˉlexer.Compilerˉtokenˉkind.Semicolon { return 27; }
    let Missingˉexpression: Sourceˉbodies.Compilerˉsourceˉbodyˉsummary = Sourceˉbodies.Compilerˉparseˉsourceˉbodies(Textˉtoˉutf8("module Bad profile portable; fn Main() -> i32 { return +; }"));
    if Missingˉexpression.Status != Sourceˉbodies.Compilerˉbodyˉparseˉstatus.Expectedˉexpression { return 28; }
    let Declarationˉfailure: Sourceˉbodies.Compilerˉsourceˉbodyˉsummary = Sourceˉbodies.Compilerˉparseˉsourceˉbodies(Textˉtoˉutf8("module Bad profile maybe;"));
    if Declarationˉfailure.Status != Sourceˉbodies.Compilerˉbodyˉparseˉstatus.Declarationˉerror { return 29; }
    let Invalidˉspan: Sourceˉbodies.Compilerˉsourceˉexpression = Sourceˉbodies.Compilerˉparseˉexpressionˉspan(Callˉsource, 0u32, 1u32, 1u32, Bytesˉlength(Callˉsource) + 1u32);
    if Invalidˉspan.Status != Sourceˉbodies.Compilerˉbodyˉparseˉstatus.Invalidˉspan { return 30; }
    let Invalidˉencoding: Sourceˉbodies.Compilerˉsourceˉbodyˉsummary = Sourceˉbodies.Compilerˉparseˉbodyˉspan(Invalidˉutf8, 0u32, 1u32, 1u32, Bytesˉlength(Invalidˉutf8));
    if Invalidˉencoding.Status != Sourceˉbodies.Compilerˉbodyˉparseˉstatus.Lexicalˉerror { return 31; }
    if Invalidˉencoding.Lexicalˉstatus != Sourceˉlexer.Compilerˉlexˉstatus.Invalidˉutf8 { return 32; }
    return 0;
}
