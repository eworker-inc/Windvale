module Compilerˉsourceˉdeclarationˉparserˉdemo profile portable;

import Compilerˉsourceˉdeclarationˉparser;

data Invalidˉutf8: bytes = [195, 40];

export fn Main() -> i32 {
    let Complete: bytes = Textˉtoˉutf8("module Exampleˉcompiler profile hosted; import Foundationˉdecimalˉparsing; capability console.write_line; data Message: text = \"hello\"; data Values: [i32] = [-1, 2]; data Blob: bytes = [0, 255u8]; record Pair { Left: u32; Ready: bool; } enum State { Ready = 1; Done = 2; } fn Helper(Value: Pair, Stateˉvalue: State) -> void { console.write_line(\"{\\\"}\"); if true { return; } } export fn Main() -> i32 { return 0; }");
    let Summary: Compilerˉsourceˉmoduleˉsummary = Compilerˉparseˉsource(Complete);
    if Summary.Status != Compilerˉparseˉstatus.Valid { return 1; }
    if Summary.Profile != Compilerˉsourceˉprofile.Hosted { return 2; }
    if Summary.Imports != 1u32 { return 3; }
    if Summary.Capabilities != 1u32 { return 4; }
    if Summary.Data != 3u32 { return 5; }
    if Summary.Records != 1u32 { return 6; }
    if Summary.Enums != 1u32 { return 7; }
    if Summary.Functions != 2u32 { return 8; }

    let Importˉview: Compilerˉsourceˉdeclaration = Compilerˉparseˉdeclarationˉat(Complete, 0u32);
    if Importˉview.Kind != Compilerˉsourceˉdeclarationˉkind.Import { return 9; }
    let Capabilityˉview: Compilerˉsourceˉdeclaration = Compilerˉparseˉdeclarationˉat(Complete, 1u32);
    if Capabilityˉview.Kind != Compilerˉsourceˉdeclarationˉkind.Capability { return 10; }
    if Capabilityˉview.Items != 2u32 { return 11; }
    let Recordˉview: Compilerˉsourceˉdeclaration = Compilerˉparseˉdeclarationˉat(Complete, 5u32);
    if Recordˉview.Kind != Compilerˉsourceˉdeclarationˉkind.Record { return 12; }
    if Recordˉview.Items != 2u32 { return 13; }
    let Enumˉview: Compilerˉsourceˉdeclaration = Compilerˉparseˉdeclarationˉat(Complete, 6u32);
    if Enumˉview.Kind != Compilerˉsourceˉdeclarationˉkind.Enum { return 14; }
    if Enumˉview.Items != 2u32 { return 15; }
    let Functionˉview: Compilerˉsourceˉdeclaration = Compilerˉparseˉdeclarationˉat(Complete, 7u32);
    if Functionˉview.Kind != Compilerˉsourceˉdeclarationˉkind.Function { return 16; }
    if Functionˉview.Items != 2u32 { return 17; }
    if Functionˉview.Bodyˉlength == 0u32 { return 18; }
    let Mainˉview: Compilerˉsourceˉdeclaration = Compilerˉparseˉdeclarationˉat(Complete, 8u32);
    if !Mainˉview.Isˉexported { return 19; }

    let Lateˉimport: Compilerˉsourceˉmoduleˉsummary = Compilerˉparseˉsource(Textˉtoˉutf8("module Bad profile portable; data Value: text = \"x\"; import Other;"));
    if Lateˉimport.Status != Compilerˉparseˉstatus.Importˉafterˉdeclaration { return 20; }
    let Missingˉsemicolon: Compilerˉsourceˉmoduleˉsummary = Compilerˉparseˉsource(Textˉtoˉutf8("module Bad profile portable record Value { Field: i32; }"));
    if Missingˉsemicolon.Status != Compilerˉparseˉstatus.Expectedˉtoken { return 21; }
    if Missingˉsemicolon.Expected != Compilerˉtokenˉkind.Semicolon { return 22; }
    let Badˉprofile: Compilerˉsourceˉmoduleˉsummary = Compilerˉparseˉsource(Textˉtoˉutf8("module Bad profile maybe;"));
    if Badˉprofile.Status != Compilerˉparseˉstatus.Invalidˉprofile { return 23; }
    let Badˉdataˉtype: Compilerˉsourceˉmoduleˉsummary = Compilerˉparseˉsource(Textˉtoˉutf8("module Bad profile portable; data Value: u32 = 1u32;"));
    if Badˉdataˉtype.Status != Compilerˉparseˉstatus.Invalidˉdataˉtype { return 24; }
    let Badˉbytes: Compilerˉsourceˉmoduleˉsummary = Compilerˉparseˉsource(Textˉtoˉutf8("module Bad profile portable; data Value: bytes = [256];"));
    if Badˉbytes.Status != Compilerˉparseˉstatus.Invalidˉliteral { return 25; }
    let Badˉrecordˉtype: Compilerˉsourceˉmoduleˉsummary = Compilerˉparseˉsource(Textˉtoˉutf8("module Bad profile portable; record Value { Field: void; }"));
    if Badˉrecordˉtype.Status != Compilerˉparseˉstatus.Invalidˉtype { return 26; }
    let Badˉdeclaration: Compilerˉsourceˉmoduleˉsummary = Compilerˉparseˉsource(Textˉtoˉutf8("module Bad profile portable; let Value: i32 = 0;"));
    if Badˉdeclaration.Status != Compilerˉparseˉstatus.Unexpectedˉdeclaration { return 27; }
    let Missingˉbrace: Compilerˉsourceˉmoduleˉsummary = Compilerˉparseˉsource(Textˉtoˉutf8("module Bad profile portable; fn Main() -> i32 { return 0;"));
    if Missingˉbrace.Status != Compilerˉparseˉstatus.Expectedˉtoken { return 28; }
    let Invalidˉencoding: Compilerˉsourceˉmoduleˉsummary = Compilerˉparseˉsource(Invalidˉutf8);
    if Invalidˉencoding.Status != Compilerˉparseˉstatus.Lexicalˉerror { return 29; }
    if Invalidˉencoding.Lexicalˉstatus != Compilerˉlexˉstatus.Invalidˉutf8 { return 30; }
    return 0;
}
