module Runtimeˉnativeˉserviceˉbundleˉmaterialization profile portable;

import Compilerˉnativeˉpublication as Nativeˉpublication;
import Foundationˉbyteˉconstruction as Byteˉconstruction;

export record Nativeˉserviceˉbundleˉmaterializationˉresult {
    Valid: bool;
    Value: bytes;
}

fn Empty(Input: bytes) -> bytes {
    return Bytesˉslice(Input, 0u32, 0u32);
}

fn Appendˉu32(Input: bytes, Value: u32) -> bytes {
    return Bytesˉconcat(Input, Bytesˉfromˉu32ˉlittle(Value));
}

fn Responseˉheader(
    Input: bytes,
    Totalˉbytes: u32,
    Status: u32,
    Failureˉoffset: u32,
    Planˉbytes: u32,
    Fragmentˉbytes: u32,
    Imageˉbytes: u32,
    Serviceˉcount: u32
) -> bytes {
    var Result: bytes = Empty(Input);
    Result = Appendˉu32(Result, 1230198359u32);
    Result = Appendˉu32(Result, 1u32);
    Result = Appendˉu32(Result, Totalˉbytes);
    Result = Appendˉu32(Result, Status);
    Result = Appendˉu32(Result, Failureˉoffset);
    Result = Appendˉu32(Result, Planˉbytes);
    Result = Appendˉu32(Result, Fragmentˉbytes);
    Result = Appendˉu32(Result, Imageˉbytes);
    return Appendˉu32(Result, Serviceˉcount);
}

fn Failure(Input: bytes, Status: u32, Failureˉoffset: u32)
    -> Nativeˉserviceˉbundleˉmaterializationˉresult {
    return Nativeˉserviceˉbundleˉmaterializationˉresult(
        false,
        Responseˉheader(
            Input,
            36u32,
            Status,
            Failureˉoffset,
            0u32,
            0u32,
            0u32,
            0u32
        )
    );
}

fn Appendˉrepeat(Input: bytes, Value: u8, Count: u32)
    -> Nativeˉserviceˉbundleˉmaterializationˉresult {
    let Repeated: Byteˉconstruction.Foundationˉbytesˉresult =
        Byteˉconstruction.Foundationˉbytesˉrepeat(Value, Count);
    if !Repeated.Valid {
        return Nativeˉserviceˉbundleˉmaterializationˉresult(false, Empty(Input));
    }
    return Nativeˉserviceˉbundleˉmaterializationˉresult(
        true,
        Bytesˉconcat(Input, Repeated.Value)
    );
}

export fn Nativeˉserviceˉbundleˉmaterialize(Input: bytes)
    -> Nativeˉserviceˉbundleˉmaterializationˉresult {
    let Total: u32 = Bytesˉlength(Input);
    if Total < 24u32 {
        return Failure(Input, 1u32, Total);
    }
    if Bytesˉreadˉu32ˉlittle(Input, 0u32) != 1364416087u32 {
        return Failure(Input, 2u32, 0u32);
    }
    if Bytesˉreadˉu32ˉlittle(Input, 4u32) != 1u32 {
        return Failure(Input, 3u32, 4u32);
    }
    if Bytesˉreadˉu32ˉlittle(Input, 8u32) != Total {
        return Failure(Input, 1u32, 8u32);
    }
    if Bytesˉreadˉu32ˉlittle(Input, 20u32) != 0u32 {
        return Failure(Input, 4u32, 20u32);
    }

    let Planˉbytes: u32 = Bytesˉreadˉu32ˉlittle(Input, 12u32);
    let Payloadˉbytes: u32 = Bytesˉreadˉu32ˉlittle(Input, 16u32);
    if Planˉbytes < 24u32 || Planˉbytes > Total - 24u32 {
        return Failure(Input, 1u32, 12u32);
    }
    if Payloadˉbytes != Total - 24u32 - Planˉbytes {
        return Failure(Input, 1u32, 16u32);
    }

    let Planˉrequest: bytes = Bytesˉslice(Input, 24u32, Planˉbytes);
    let Plan: Nativeˉpublication.Nativeˉpublicationˉresult =
        Nativeˉpublication.Nativeˉpublicationˉplan(Planˉrequest);
    if Bytesˉreadˉu32ˉlittle(Plan.Value, 12u32) != 0u32 {
        return Failure(Input, 5u32, 24u32 + Plan.Failureˉoffset);
    }

    let Fragmentˉbytes: u32 = Bytesˉreadˉu32ˉlittle(Plan.Value, 20u32);
    let Imageˉbytes: u32 = Bytesˉreadˉu32ˉlittle(Plan.Value, 24u32);
    let Serviceˉcount: u32 = Bytesˉreadˉu32ˉlittle(Plan.Value, 28u32);
    let Recordˉbytes: u32 = Serviceˉcount * 12u32;
    if Bytesˉlength(Plan.Value) != 32u32 + Recordˉbytes {
        return Failure(Input, 5u32, 24u32);
    }

    var Requiredˉpayload: u32 = Fragmentˉbytes;
    if Requiredˉpayload > Payloadˉbytes {
        return Failure(Input, 6u32, 24u32 + Planˉbytes);
    }
    var Index: u32 = 0u32;
    while Index < Serviceˉcount {
        let Recordˉoffset: u32 = 32u32 + Index * 12u32;
        let Serviceˉbytes: u32 = Bytesˉreadˉu32ˉlittle(
            Plan.Value,
            Recordˉoffset + 8u32
        );
        if Serviceˉbytes > Payloadˉbytes - Requiredˉpayload {
            return Failure(Input, 6u32, 24u32 + Planˉbytes + Requiredˉpayload);
        }
        Requiredˉpayload = Requiredˉpayload + Serviceˉbytes;
        Index = Index + 1u32;
    }
    if Requiredˉpayload != Payloadˉbytes {
        return Failure(Input, 6u32, 24u32 + Planˉbytes + Requiredˉpayload);
    }

    let Responseˉmetadataˉbytes: u32 = 36u32 + Recordˉbytes;
    if Imageˉbytes > 4194304u32 - Responseˉmetadataˉbytes {
        return Failure(Input, 7u32, 16u32);
    }

    let Payloadˉoffset: u32 = 24u32 + Planˉbytes;
    var Image: bytes = Bytesˉslice(Input, Payloadˉoffset, Fragmentˉbytes);
    var Sourceˉoffset: u32 = Payloadˉoffset + Fragmentˉbytes;
    Index = 0u32;
    while Index < Serviceˉcount {
        let Placementˉrecordˉoffset: u32 = 32u32 + Index * 12u32;
        let Placementˉoffset: u32 = Bytesˉreadˉu32ˉlittle(
            Plan.Value,
            Placementˉrecordˉoffset + 4u32
        );
        let Placementˉbytes: u32 = Bytesˉreadˉu32ˉlittle(
            Plan.Value,
            Placementˉrecordˉoffset + 8u32
        );
        let Paddingˉbytes: u32 = Placementˉoffset - Bytesˉlength(Image);
        var Padding: Nativeˉserviceˉbundleˉmaterializationˉresult =
            Appendˉrepeat(Image, 144u8, Paddingˉbytes);
        if Index == 0u32 {
            Padding = Appendˉrepeat(Image, 0u8, Paddingˉbytes);
        }
        if !Padding.Valid {
            return Failure(Input, 7u32, 16u32);
        }
        Image = Bytesˉconcat(
            Padding.Value,
            Bytesˉslice(Input, Sourceˉoffset, Placementˉbytes)
        );
        Sourceˉoffset = Sourceˉoffset + Placementˉbytes;
        Index = Index + 1u32;
    }

    if Serviceˉcount == 0u32 {
        let Trailing: Nativeˉserviceˉbundleˉmaterializationˉresult =
            Appendˉrepeat(Image, 0u8, Imageˉbytes - Bytesˉlength(Image));
        if !Trailing.Valid {
            return Failure(Input, 7u32, 16u32);
        }
        Image = Trailing.Value;
    }
    if Sourceˉoffset != Total || Bytesˉlength(Image) != Imageˉbytes {
        return Failure(Input, 6u32, Sourceˉoffset);
    }

    let Responseˉbytes: u32 = Responseˉmetadataˉbytes + Imageˉbytes;
    var Response: bytes = Responseˉheader(
        Input,
        Responseˉbytes,
        0u32,
        Total,
        Planˉbytes,
        Fragmentˉbytes,
        Imageˉbytes,
        Serviceˉcount
    );
    Response = Bytesˉconcat(
        Response,
        Bytesˉslice(Plan.Value, 32u32, Recordˉbytes)
    );
    return Nativeˉserviceˉbundleˉmaterializationˉresult(
        true,
        Bytesˉconcat(Response, Image)
    );
}
