export fn Nativeˉx64ˉwindowsˉfileˉoutputˉserviceˉbuild() -> bytes {
    let Writeˉloopˉtarget: u32 = 0u32;
    let Flushˉtarget: u32 = 1u32;
    let Openˉerrorˉtarget: u32 = 2u32;
    let Closeˉlastˉerrorˉtarget: u32 = 3u32;
    let Mapˉopenˉerrorˉtarget: u32 = 4u32;
    let Mapˉcloseˉerrorˉtarget: u32 = 5u32;
    let Closeˉinvalidˉtarget: u32 = 6u32;
    let Closeˉnotˉfoundˉtarget: u32 = 7u32;
    let Closeˉdeniedˉtarget: u32 = 8u32;
    let Closeˉtooˉlargeˉtarget: u32 = 9u32;
    let Closeˉunavailableˉtarget: u32 = 10u32;
    let Closeˉfailureˉtarget: u32 = 11u32;
    let Failureˉinvalidˉtarget: u32 = 12u32;
    let Failureˉnotˉfoundˉtarget: u32 = 13u32;
    let Failureˉdeniedˉtarget: u32 = 14u32;
    let Failureˉunavailableˉtarget: u32 = 15u32;
    let Failureˉtooˉlargeˉtarget: u32 = 16u32;
    let Returnˉtarget: u32 = 17u32;

    var Builder: Serviceˉcode.Nativeˉx64ˉserviceˉbuilder =
        Serviceˉcode.Nativeˉx64ˉserviceˉbuilderˉempty();
    Builder = Emitˉentryˉvalidation(
        Builder, Failureˉtooˉlargeˉtarget, Failureˉinvalidˉtarget
    );

    Builder = Emitˉopen(
        Builder,
        Failureˉinvalidˉtarget,
        Openˉerrorˉtarget
    );

    let Writeˉloopˉoffset: u32 = Bytesˉlength(Builder.Code);
    Builder = Serviceˉcode.Nativeˉx64ˉserviceˉemitˉfour(
        Builder, 139u8, 68u8, 36u8, 64u8
    );
    Builder = Serviceˉcode.Nativeˉx64ˉserviceˉemitˉfour(
        Builder, 59u8, 68u8, 36u8, 56u8
    );
    Builder = Serviceˉcode.Nativeˉx64ˉserviceˉbranch(
        Builder, 132u8, Flushˉtarget
    );
    Builder = Serviceˉcode.Nativeˉx64ˉserviceˉemitˉthree(
        Builder, 76u8, 137u8, 241u8
    );
    Builder = Serviceˉcode.Nativeˉx64ˉserviceˉemitˉthree(
        Builder, 76u8, 137u8, 226u8
    );
    Builder = Serviceˉcode.Nativeˉx64ˉserviceˉemitˉthree(
        Builder, 72u8, 1u8, 194u8
    );
    Builder = Serviceˉcode.Nativeˉx64ˉserviceˉemitˉfive(
        Builder, 68u8, 139u8, 68u8, 36u8, 56u8
    );
    Builder = Serviceˉcode.Nativeˉx64ˉserviceˉemitˉthree(
        Builder, 65u8, 41u8, 192u8
    );
    Builder = Serviceˉcode.Nativeˉx64ˉserviceˉemitˉfive(
        Builder, 68u8, 137u8, 68u8, 36u8, 68u8
    );
    Builder = Serviceˉcode.Nativeˉx64ˉserviceˉemitˉfive(
        Builder, 76u8, 141u8, 76u8, 36u8, 72u8
    );
    Builder = Serviceˉcode.Nativeˉx64ˉserviceˉemitˉfive(
        Builder, 72u8, 199u8, 68u8, 36u8, 32u8
    );
    Builder = Serviceˉcode.Nativeˉx64ˉserviceˉemitˉu32(Builder, 0u32);
    Builder = Serviceˉcode.Nativeˉx64ˉserviceˉemitˉthree(
        Builder, 255u8, 83u8, 48u8
    );
    Builder = Serviceˉcode.Nativeˉx64ˉserviceˉemitˉtwo(Builder, 133u8, 192u8);
    Builder = Serviceˉcode.Nativeˉx64ˉserviceˉbranch(
        Builder, 132u8, Closeˉlastˉerrorˉtarget
    );
    Builder = Serviceˉcode.Nativeˉx64ˉserviceˉemitˉfour(
        Builder, 139u8, 68u8, 36u8, 72u8
    );
    Builder = Serviceˉcode.Nativeˉx64ˉserviceˉemitˉtwo(Builder, 133u8, 192u8);
    Builder = Serviceˉcode.Nativeˉx64ˉserviceˉbranch(
        Builder, 132u8, Closeˉunavailableˉtarget
    );
    Builder = Serviceˉcode.Nativeˉx64ˉserviceˉemitˉfour(
        Builder, 59u8, 68u8, 36u8, 68u8
    );
    Builder = Serviceˉcode.Nativeˉx64ˉserviceˉbranch(
        Builder, 135u8, Closeˉunavailableˉtarget
    );
    Builder = Serviceˉcode.Nativeˉx64ˉserviceˉemitˉfour(
        Builder, 1u8, 68u8, 36u8, 64u8
    );
    Builder = Serviceˉcode.Nativeˉx64ˉserviceˉjump(Builder, Writeˉloopˉtarget);

    let Flushˉoffset: u32 = Bytesˉlength(Builder.Code);
    Builder = Serviceˉcode.Nativeˉx64ˉserviceˉemitˉthree(
        Builder, 76u8, 137u8, 241u8
    );
    Builder = Serviceˉcode.Nativeˉx64ˉserviceˉemitˉthree(
        Builder, 255u8, 83u8, 56u8
    );
    Builder = Serviceˉcode.Nativeˉx64ˉserviceˉemitˉtwo(Builder, 133u8, 192u8);
    Builder = Serviceˉcode.Nativeˉx64ˉserviceˉbranch(
        Builder, 132u8, Closeˉlastˉerrorˉtarget
    );
    Builder = Serviceˉcode.Nativeˉx64ˉserviceˉemitˉthree(
        Builder, 76u8, 137u8, 241u8
    );
    Builder = Serviceˉcode.Nativeˉx64ˉserviceˉemitˉthree(
        Builder, 255u8, 83u8, 64u8
    );
    Builder = Serviceˉcode.Nativeˉx64ˉserviceˉemitˉtwo(Builder, 133u8, 192u8);
    Builder = Serviceˉcode.Nativeˉx64ˉserviceˉbranch(
        Builder, 132u8, Failureˉunavailableˉtarget
    );
    Builder = Serviceˉcode.Nativeˉx64ˉserviceˉemitˉtwo(Builder, 49u8, 192u8);
    Builder = Serviceˉcode.Nativeˉx64ˉserviceˉjump(Builder, Returnˉtarget);

    let Openˉerrorˉoffset: u32 = Bytesˉlength(Builder.Code);
    Builder = Serviceˉcode.Nativeˉx64ˉserviceˉemitˉthree(
        Builder, 255u8, 83u8, 72u8
    );
    Builder = Serviceˉcode.Nativeˉx64ˉserviceˉjump(Builder, Mapˉopenˉerrorˉtarget);
    let Closeˉlastˉerrorˉoffset: u32 = Bytesˉlength(Builder.Code);
    Builder = Serviceˉcode.Nativeˉx64ˉserviceˉemitˉthree(
        Builder, 255u8, 83u8, 72u8
    );
    Builder = Serviceˉcode.Nativeˉx64ˉserviceˉjump(Builder, Mapˉcloseˉerrorˉtarget);
    let Mapˉopenˉerrorˉoffset: u32 = Bytesˉlength(Builder.Code);
    Builder = Fileˉcode.Nativeˉx64ˉfileˉoutputˉwindowsˉerrorˉmapping(
        Builder,
        Failureˉinvalidˉtarget,
        Failureˉnotˉfoundˉtarget,
        Failureˉdeniedˉtarget,
        Failureˉunavailableˉtarget
    );
    let Mapˉcloseˉerrorˉoffset: u32 = Bytesˉlength(Builder.Code);
    Builder = Fileˉcode.Nativeˉx64ˉfileˉoutputˉwindowsˉerrorˉmapping(
        Builder,
        Closeˉinvalidˉtarget,
        Closeˉnotˉfoundˉtarget,
        Closeˉdeniedˉtarget,
        Closeˉunavailableˉtarget
    );

    let Closeˉinvalidˉoffset: u32 = Bytesˉlength(Builder.Code);
    Builder = Fileˉcode.Nativeˉx64ˉfileˉoutputˉstoreˉdetail(
        Builder, 76u8, 5u8
    );
    Builder = Serviceˉcode.Nativeˉx64ˉserviceˉjump(Builder, Closeˉfailureˉtarget);
    let Closeˉnotˉfoundˉoffset: u32 = Bytesˉlength(Builder.Code);
    Builder = Fileˉcode.Nativeˉx64ˉfileˉoutputˉstoreˉdetail(
        Builder, 76u8, 6u8
    );
    Builder = Serviceˉcode.Nativeˉx64ˉserviceˉjump(Builder, Closeˉfailureˉtarget);
    let Closeˉdeniedˉoffset: u32 = Bytesˉlength(Builder.Code);
    Builder = Fileˉcode.Nativeˉx64ˉfileˉoutputˉstoreˉdetail(
        Builder, 76u8, 7u8
    );
    Builder = Serviceˉcode.Nativeˉx64ˉserviceˉjump(Builder, Closeˉfailureˉtarget);
    let Closeˉtooˉlargeˉoffset: u32 = Bytesˉlength(Builder.Code);
    Builder = Fileˉcode.Nativeˉx64ˉfileˉoutputˉstoreˉdetail(
        Builder, 76u8, 9u8
    );
    Builder = Serviceˉcode.Nativeˉx64ˉserviceˉjump(Builder, Closeˉfailureˉtarget);
    let Closeˉunavailableˉoffset: u32 = Bytesˉlength(Builder.Code);
    Builder = Fileˉcode.Nativeˉx64ˉfileˉoutputˉstoreˉdetail(
        Builder, 76u8, 8u8
    );

    let Closeˉfailureˉoffset: u32 = Bytesˉlength(Builder.Code);
    Builder = Serviceˉcode.Nativeˉx64ˉserviceˉemitˉthree(
        Builder, 76u8, 137u8, 241u8
    );
    Builder = Serviceˉcode.Nativeˉx64ˉserviceˉemitˉthree(
        Builder, 255u8, 83u8, 64u8
    );
    Builder = Serviceˉcode.Nativeˉx64ˉserviceˉemitˉfour(
        Builder, 139u8, 68u8, 36u8, 76u8
    );
    Builder = Serviceˉcode.Nativeˉx64ˉserviceˉemitˉfour(
        Builder, 65u8, 137u8, 71u8, 64u8
    );
    Builder = Serviceˉcode.Nativeˉx64ˉserviceˉemitˉu8(Builder, 184u8);
    Builder = Serviceˉcode.Nativeˉx64ˉserviceˉemitˉu32(Builder, 1u32);
    Builder = Serviceˉcode.Nativeˉx64ˉserviceˉjump(Builder, Returnˉtarget);

    let Failureˉinvalidˉoffset: u32 = Bytesˉlength(Builder.Code);
    Builder = Fileˉcode.Nativeˉx64ˉfileˉoutputˉdirectˉfailure(
        Builder, 5u8, Returnˉtarget
    );
    let Failureˉnotˉfoundˉoffset: u32 = Bytesˉlength(Builder.Code);
    Builder = Fileˉcode.Nativeˉx64ˉfileˉoutputˉdirectˉfailure(
        Builder, 6u8, Returnˉtarget
    );
    let Failureˉdeniedˉoffset: u32 = Bytesˉlength(Builder.Code);
    Builder = Fileˉcode.Nativeˉx64ˉfileˉoutputˉdirectˉfailure(
        Builder, 7u8, Returnˉtarget
    );
    let Failureˉunavailableˉoffset: u32 = Bytesˉlength(Builder.Code);
    Builder = Fileˉcode.Nativeˉx64ˉfileˉoutputˉdirectˉfailure(
        Builder, 8u8, Returnˉtarget
    );
    let Failureˉtooˉlargeˉoffset: u32 = Bytesˉlength(Builder.Code);
    Builder = Fileˉcode.Nativeˉx64ˉfileˉoutputˉdirectˉfailure(
        Builder, 9u8, Returnˉtarget
    );

    let Returnˉoffset: u32 = Bytesˉlength(Builder.Code);
    Builder = Serviceˉcode.Nativeˉx64ˉserviceˉemitˉfour(
        Builder, 76u8, 139u8, 164u8, 36u8
    );
    Builder = Serviceˉcode.Nativeˉx64ˉserviceˉemitˉu32(Builder, 128u32);
    Builder = Serviceˉcode.Nativeˉx64ˉserviceˉemitˉfour(
        Builder, 76u8, 139u8, 172u8, 36u8
    );
    Builder = Serviceˉcode.Nativeˉx64ˉserviceˉemitˉu32(Builder, 136u32);
    Builder = Serviceˉcode.Nativeˉx64ˉserviceˉemitˉfour(
        Builder, 76u8, 139u8, 180u8, 36u8
    );
    Builder = Serviceˉcode.Nativeˉx64ˉserviceˉemitˉu32(Builder, 144u32);
    Builder = Serviceˉcode.Nativeˉx64ˉserviceˉemitˉfour(
        Builder, 72u8, 139u8, 180u8, 36u8
    );
    Builder = Serviceˉcode.Nativeˉx64ˉserviceˉemitˉu32(Builder, 152u32);
    Builder = Serviceˉcode.Nativeˉx64ˉserviceˉemitˉfour(
        Builder, 72u8, 139u8, 188u8, 36u8
    );
    Builder = Serviceˉcode.Nativeˉx64ˉserviceˉemitˉu32(Builder, 160u32);
    Builder = Serviceˉcode.Nativeˉx64ˉserviceˉemitˉfive(
        Builder, 72u8, 139u8, 92u8, 36u8, 112u8
    );
    Builder = Serviceˉcode.Nativeˉx64ˉserviceˉemitˉfive(
        Builder, 72u8, 139u8, 108u8, 36u8, 120u8
    );
    Builder = Serviceˉcode.Nativeˉx64ˉserviceˉemitˉfive(
        Builder, 76u8, 139u8, 84u8, 36u8, 96u8
    );
    Builder = Serviceˉcode.Nativeˉx64ˉserviceˉemitˉfive(
        Builder, 76u8, 139u8, 92u8, 36u8, 104u8
    );
    Builder = Serviceˉcode.Nativeˉx64ˉserviceˉemitˉfive(
        Builder, 72u8, 139u8, 100u8, 36u8, 88u8
    );
    Builder = Serviceˉcode.Nativeˉx64ˉserviceˉemitˉu8(Builder, 195u8);

    var Labels: bytes = Bytesˉfromˉu32ˉlittle(Writeˉloopˉoffset);
    Labels = Appendˉlabel(Labels, Flushˉoffset);
    Labels = Appendˉlabel(Labels, Openˉerrorˉoffset);
    Labels = Appendˉlabel(Labels, Closeˉlastˉerrorˉoffset);
    Labels = Appendˉlabel(Labels, Mapˉopenˉerrorˉoffset);
    Labels = Appendˉlabel(Labels, Mapˉcloseˉerrorˉoffset);
    Labels = Appendˉlabel(Labels, Closeˉinvalidˉoffset);
    Labels = Appendˉlabel(Labels, Closeˉnotˉfoundˉoffset);
    Labels = Appendˉlabel(Labels, Closeˉdeniedˉoffset);
    Labels = Appendˉlabel(Labels, Closeˉtooˉlargeˉoffset);
    Labels = Appendˉlabel(Labels, Closeˉunavailableˉoffset);
    Labels = Appendˉlabel(Labels, Closeˉfailureˉoffset);
    Labels = Appendˉlabel(Labels, Failureˉinvalidˉoffset);
    Labels = Appendˉlabel(Labels, Failureˉnotˉfoundˉoffset);
    Labels = Appendˉlabel(Labels, Failureˉdeniedˉoffset);
    Labels = Appendˉlabel(Labels, Failureˉunavailableˉoffset);
    Labels = Appendˉlabel(Labels, Failureˉtooˉlargeˉoffset);
    Labels = Appendˉlabel(Labels, Returnˉoffset);
    return Serviceˉcode.Nativeˉx64ˉserviceˉfinish(Builder, Labels);
}
