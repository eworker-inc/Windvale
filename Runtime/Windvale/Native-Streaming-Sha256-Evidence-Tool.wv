module Nativeˉstreamingˉsha256ˉevidenceˉtool profile hosted;

import Runtimeˉstreamingˉsha256ˉresourceˉevidence as Resources;

capability console.write_line;
capability diagnostic.write_line;
capability file.read_bytes;
capability file.write_bytes;
capability process.argument;
capability process.argument_count;

enum Nativeˉstreamingˉsha256ˉevidenceˉstatus {
    Valid = 0;
    Rejected = 1;
}

fn Bytesˉareˉequal(Left: bytes, Right: bytes) -> bool {
    let Length: u32 = Bytesˉlength(Left);
    if Length != Bytesˉlength(Right) { return false; }
    var Index: u32 = 0u32;
    while Index < Length {
        if Bytesˉreadˉu8(Left, Index) != Bytesˉreadˉu8(Right, Index) {
            return false;
        }
        Index = Index + 1u32;
    }
    return true;
}

fn Pathsˉareˉequal(Left: text, Right: text) -> bool {
    return Bytesˉareˉequal(Textˉtoˉutf8(Left), Textˉtoˉutf8(Right));
}

fn Reject() -> i32 {
    diagnostic.write_line(
        Textˉconcat(
            "streaming sha256 evidence status=",
            Enumˉname(Nativeˉstreamingˉsha256ˉevidenceˉstatus.Rejected)
        )
    );
    return 2;
}

export fn Main() -> i32 {
    if process.argument_count() != 3u32 {
        diagnostic.write_line(
            "Usage: wvsha256evidence <manifest.wvhs> <chunk-prefix> <evidence.wvhe>"
        );
        return 64;
    }
    let Manifestˉpath: text = process.argument(0u32);
    let Prefix: text = process.argument(1u32);
    let Evidenceˉpath: text = process.argument(2u32);
    if Pathsˉareˉequal(Manifestˉpath, Evidenceˉpath) {
        return Reject();
    }

    let Manifest: bytes = file.read_bytes(Manifestˉpath);
    let Chunks: u32 = Resources.Streamingˉsha256ˉresourceˉcount(Manifest);
    let Regions: u32 =
        Resources.Streamingˉsha256ˉresourceˉregionˉcount(Manifest);
    if Chunks == 0u32 || Regions == 0u32 ||
        !Resources.Streamingˉsha256ˉresourceˉprefixˉisˉvalid(Prefix) {
        return Reject();
    }
    var Index: u32 = 0u32;
    while Index < Chunks {
        let Resourceˉpath: text =
            Resources.Streamingˉsha256ˉresourceˉname(Prefix, Index);
        if Pathsˉareˉequal(Resourceˉpath, Manifestˉpath) ||
            Pathsˉareˉequal(Resourceˉpath, Evidenceˉpath) {
            return Reject();
        }
        Index = Index + 1u32;
    }

    var Output: bytes =
        Resources.Streamingˉsha256ˉresourceˉevidenceˉbegin(Manifest);
    var Region: u32 = 0u32;
    while Region < Regions {
        var State = Resources.Streamingˉsha256ˉresourceˉregionˉbegin(
            Manifest, Region
        );
        Index = 0u32;
        while Index < Chunks {
            if Resources.Streamingˉsha256ˉresourceˉregionˉusesˉchunk(
                State, Manifest, Index
            ) {
                State = Resources.Streamingˉsha256ˉresourceˉregionˉupdate(
                    State,
                    Manifest,
                    Index,
                    file.read_bytes(
                        Resources.Streamingˉsha256ˉresourceˉname(Prefix, Index)
                    )
                );
            }
            Index = Index + 1u32;
        }
        Output = Resources.Streamingˉsha256ˉresourceˉevidenceˉappend(
            Output,
            Manifest,
            Region,
            Resources.Streamingˉsha256ˉresourceˉregionˉfinish(State)
        );
        Region = Region + 1u32;
    }
    if !Resources.Streamingˉsha256ˉresourceˉevidenceˉisˉvalid(
        Manifest, Output
    ) {
        return Reject();
    }
    file.write_bytes(Evidenceˉpath, Output);
    console.write_line(
        Textˉconcat(
            "streaming sha256 evidence status=Valid bytes=",
            U32ˉformat(Bytesˉlength(Output))
        )
    );
    return 0;
}
