module Runtimeˉnativeˉhostedˉtoolˉmetadataˉadmission profile portable;

fn Allˉzero(Input: bytes, Offset: u32, Count: u32) -> bool {
    var Index: u32 = 0u32;
    while Index < Count {
        if Bytesˉreadˉu8(Input, Offset + Index) != 0u8 { return false; }
        Index = Index + 1u32;
    }
    return true;
}

fn Profileˉmagic(Profile: u32) -> u32 {
    if Profile == 1u32 { return 1095259735u32; }
    if Profile == 2u32 { return 1112036951u32; }
    if Profile == 3u32 { return 1397249623u32; }
    if Profile == 4u32 { return 1279809111u32; }
    if Profile == 5u32 { return 1346917975u32; }
    return 1313363543u32;
}

fn Profileˉcontainer(Profile: u32) -> u32 {
    if Profile == 1u32 { return 3u32; }
    return Profile + 3u32;
}

fn Profileˉflags(Profile: u32) -> u32 {
    if Profile == 1u32 { return 1u32; }
    return Profile + 1u32;
}

fn Capabilityˉservice(Index: u32) -> u32 {
    if Index == 0u32 { return 1u32; }
    if Index == 1u32 { return 6u32; }
    if Index == 2u32 { return 4u32; }
    if Index == 3u32 { return 12u32; }
    if Index == 4u32 { return 3u32; }
    return 2u32;
}

fn Capabilityˉsignature(Index: u32) -> u32 {
    if Index < 2u32 { return 1u32; }
    return Index;
}

fn Serviceˉidentity(Index: u32) -> u32 {
    if Index < 8u32 { return Index + 1u32; }
    return Index + 3u32;
}

fn Serviceˉcapability(Index: u32) -> u32 {
    if Index == 0u32 { return 1u32; }
    if Index == 1u32 { return 6u32; }
    if Index == 2u32 { return 5u32; }
    if Index == 3u32 { return 3u32; }
    if Index == 5u32 { return 2u32; }
    if Index == 9u32 { return 4u32; }
    return 0u32;
}

fn Serviceˉtableˉoffset(Index: u32) -> u32 {
    if Index < 8u32 { return 8u32 + Index * 8u32; }
    return 88u32 + (Index - 8u32) * 8u32;
}

fn Serviceˉadapter(Index: u32, Target: u32) -> u32 {
    if Index == 0u32 { return Target; }
    if Index == 1u32 || Index == 2u32 { return 3u32; }
    if Index == 3u32 { return Target + 3u32; }
    if Index == 4u32 { return 6u32; }
    if Index == 5u32 { return Target + 6u32; }
    if Index == 6u32 { return 9u32; }
    if Index == 7u32 { return 10u32; }
    if Index == 8u32 { return 13u32; }
    return Target + 13u32;
}

fn Serviceˉflags(Capability: u32) -> u32 {
    if Capability == 0u32 { return 2u32; }
    return 1u32;
}

export fn Nativeˉhostedˉtoolˉmetadataˉisˉvalid(
    Input: bytes,
    Offset: u32,
    Target: u32,
    Profile: u32
) -> bool {
    if Target < 1u32 || Target > 2u32 || Profile < 1u32 || Profile > 6u32 {
        return false;
    }
    let Total: u32 = Bytesˉlength(Input);
    if Offset > Total || 1024u32 > Total - Offset { return false; }
    let Metadata: bytes = Bytesˉslice(Input, Offset, 1024u32);

    if Bytesˉreadˉu32ˉlittle(Metadata, 0u32) != Profileˉmagic(Profile) ||
        Bytesˉreadˉu32ˉlittle(Metadata, 4u32) != 1u32 ||
        Bytesˉreadˉu32ˉlittle(Metadata, 8u32) != 1024u32 ||
        Bytesˉreadˉu32ˉlittle(Metadata, 12u32) != Target ||
        Bytesˉreadˉu32ˉlittle(Metadata, 16u32) != Profileˉcontainer(Profile) ||
        Bytesˉreadˉu32ˉlittle(Metadata, 20u32) != 22u32 ||
        Bytesˉreadˉu32ˉlittle(Metadata, 24u32) != 7u32 ||
        Bytesˉreadˉu32ˉlittle(Metadata, 28u32) != 5u32 ||
        Bytesˉreadˉu32ˉlittle(Metadata, 32u32) != 6u32 ||
        Bytesˉreadˉu32ˉlittle(Metadata, 36u32) != 10u32 ||
        Bytesˉreadˉu32ˉlittle(Metadata, 40u32) != 128u32 ||
        Bytesˉreadˉu32ˉlittle(Metadata, 44u32) != 16u32 ||
        Bytesˉreadˉu32ˉlittle(Metadata, 48u32) != 224u32 ||
        Bytesˉreadˉu32ˉlittle(Metadata, 52u32) != 64u32 ||
        Bytesˉreadˉu32ˉlittle(Metadata, 56u32) != 4096u32 ||
        Bytesˉreadˉu32ˉlittle(Metadata, 64u32) != 0u32 ||
        Bytesˉreadˉu32ˉlittle(Metadata, 76u32) != 2097152u32 ||
        Bytesˉreadˉu32ˉlittle(Metadata, 80u32) != 134217728u32 ||
        Bytesˉreadˉu32ˉlittle(Metadata, 84u32) != Profileˉflags(Profile) ||
        Bytesˉreadˉu32ˉlittle(Metadata, 88u32) != 755359744u32 ||
        Bytesˉreadˉu32ˉlittle(Metadata, 92u32) != 11u32 ||
        Allˉzero(Metadata, 96u32, 32u32) {
        return false;
    }

    let Bundleˉbytes: u32 = Bytesˉreadˉu32ˉlittle(Metadata, 60u32);
    let Nativeˉbytes: u32 = Bytesˉreadˉu32ˉlittle(Metadata, 68u32);
    let Nativeˉentry: u32 = Bytesˉreadˉu32ˉlittle(Metadata, 72u32);
    if Bundleˉbytes == 0u32 || Nativeˉbytes == 0u32 ||
        Nativeˉbytes > Bundleˉbytes || Nativeˉentry >= Nativeˉbytes {
        return false;
    }

    var Index: u32 = 0u32;
    while Index < 6u32 {
        let Capabilityˉrecord: u32 = 128u32 + Index * 16u32;
        if Bytesˉreadˉu32ˉlittle(Metadata, Capabilityˉrecord) != Index + 1u32 ||
            Bytesˉreadˉu32ˉlittle(Metadata, Capabilityˉrecord + 4u32) != Capabilityˉservice(Index) ||
            Bytesˉreadˉu32ˉlittle(Metadata, Capabilityˉrecord + 8u32) != Capabilityˉsignature(Index) ||
            Bytesˉreadˉu32ˉlittle(Metadata, Capabilityˉrecord + 12u32) != 1u32 {
            return false;
        }
        Index = Index + 1u32;
    }

    var Previousˉend: u32 = Nativeˉbytes;
    Index = 0u32;
    while Index < 10u32 {
        let Serviceˉrecord: u32 = 224u32 + Index * 64u32;
        let Capability: u32 = Serviceˉcapability(Index);
        let Imageˉoffset: u32 = Bytesˉreadˉu32ˉlittle(Metadata, Serviceˉrecord + 16u32);
        let Codeˉbytes: u32 = Bytesˉreadˉu32ˉlittle(Metadata, Serviceˉrecord + 20u32);
        if Bytesˉreadˉu32ˉlittle(Metadata, Serviceˉrecord) != Serviceˉidentity(Index) ||
            Bytesˉreadˉu32ˉlittle(Metadata, Serviceˉrecord + 4u32) != Capability ||
            Bytesˉreadˉu32ˉlittle(Metadata, Serviceˉrecord + 8u32) != Serviceˉtableˉoffset(Index) ||
            Bytesˉreadˉu32ˉlittle(Metadata, Serviceˉrecord + 12u32) != Serviceˉadapter(Index, Target) ||
            Bytesˉreadˉu32ˉlittle(Metadata, Serviceˉrecord + 24u32) !=
                Serviceˉflags(Capability) ||
            Bytesˉreadˉu32ˉlittle(Metadata, Serviceˉrecord + 28u32) != 0u32 ||
            Imageˉoffset < Previousˉend || Imageˉoffset >= Bundleˉbytes ||
            Codeˉbytes == 0u32 || Codeˉbytes > Bundleˉbytes - Imageˉoffset ||
            Allˉzero(Metadata, Serviceˉrecord + 32u32, 32u32) {
            return false;
        }
        Previousˉend = Imageˉoffset + Codeˉbytes;
        Index = Index + 1u32;
    }
    return Allˉzero(Metadata, 864u32, 160u32);
}
