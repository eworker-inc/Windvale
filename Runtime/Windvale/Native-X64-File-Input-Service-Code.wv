    Next = Serviceˉcode.Nativeˉx64ˉserviceˉemitˉthree(Next, 0u8, 0u8, 0u8);
    Next = Serviceˉcode.Nativeˉx64ˉserviceˉemitˉu8(Next, 184u8);
    Next = Serviceˉcode.Nativeˉx64ˉserviceˉemitˉu32(Next, 1u32);
    return Serviceˉcode.Nativeˉx64ˉserviceˉjump(Next, Returnˉtarget);
