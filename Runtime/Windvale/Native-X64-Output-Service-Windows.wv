module Runtimeˉnativeˉx64ˉoutputˉserviceˉwindows profile portable;

import Runtimeˉnativeˉx64ˉserviceˉcodeˉbuilder as Serviceˉcode;

fn Appendˉlabel(Labels: bytes, Offset: u32) -> bytes {
    return Bytesˉconcat(Labels, Bytesˉfromˉu32ˉlittle(Offset));
}

fn Emitˉwriteˉcall(
    Builder: Serviceˉcode.Nativeˉx64ˉserviceˉbuilder,
    Bufferˉoffset: u8,
    Lengthˉfromˉstack: bool
) -> Serviceˉcode.Nativeˉx64ˉserviceˉbuilder {
    var Next: Serviceˉcode.Nativeˉx64ˉserviceˉbuilder =
        Serviceˉcode.Nativeˉx64ˉserviceˉemitˉfive(
            Builder, 72u8, 139u8, 76u8, 36u8, 88u8
        );
    if Lengthˉfromˉstack {
        Next = Serviceˉcode.Nativeˉx64ˉserviceˉemitˉfive(
            Next, 72u8, 139u8, 84u8, 36u8, Bufferˉoffset
        );
        Next = Serviceˉcode.Nativeˉx64ˉserviceˉemitˉfive(
            Next, 68u8, 139u8, 68u8, 36u8, 80u8
        );
    } else {
        Next = Serviceˉcode.Nativeˉx64ˉserviceˉemitˉfive(
            Next, 72u8, 141u8, 84u8, 36u8, Bufferˉoffset
        );
        Next = Serviceˉcode.Nativeˉx64ˉserviceˉemitˉtwo(Next, 65u8, 184u8);
        Next = Serviceˉcode.Nativeˉx64ˉserviceˉemitˉu32(Next, 1u32);
    }
    Next = Serviceˉcode.Nativeˉx64ˉserviceˉemitˉfive(
        Next, 76u8, 141u8, 76u8, 36u8, 84u8
    );
    Next = Serviceˉcode.Nativeˉx64ˉserviceˉemitˉfive(
        Next, 72u8, 199u8, 68u8, 36u8, 32u8
    );
    Next = Serviceˉcode.Nativeˉx64ˉserviceˉemitˉu32(Next, 0u32);
    return Serviceˉcode.Nativeˉx64ˉserviceˉemitˉfour(
        Next, 255u8, 84u8, 36u8, 96u8
    );
}

export fn Nativeˉx64ˉwindowsˉoutputˉserviceˉbuild(
    Targetˉfieldˉoffset: u8
) -> bytes {
    let Textˉtarget: u32 = 0u32;
    let Newlineˉtarget: u32 = 1u32;
    let Failureˉtarget: u32 = 2u32;
    let Returnˉtarget: u32 = 3u32;

    var Builder: Serviceˉcode.Nativeˉx64ˉserviceˉbuilder =
        Serviceˉcode.Nativeˉx64ˉserviceˉbuilderˉempty();
    Builder = Serviceˉcode.Nativeˉx64ˉserviceˉemitˉthree(
        Builder, 72u8, 137u8, 224u8
    );
    Builder = Serviceˉcode.Nativeˉx64ˉserviceˉemitˉfour(
        Builder, 72u8, 131u8, 228u8, 240u8
    );
    Builder = Serviceˉcode.Nativeˉx64ˉserviceˉemitˉfour(
        Builder, 72u8, 131u8, 236u8, 112u8
    );
    Builder = Serviceˉcode.Nativeˉx64ˉserviceˉemitˉfive(
        Builder, 72u8, 137u8, 68u8, 36u8, 40u8
    );
    Builder = Serviceˉcode.Nativeˉx64ˉserviceˉemitˉfive(
        Builder, 76u8, 137u8, 84u8, 36u8, 48u8
    );
    Builder = Serviceˉcode.Nativeˉx64ˉserviceˉemitˉfive(
        Builder, 76u8, 137u8, 92u8, 36u8, 56u8
    );
    Builder = Serviceˉcode.Nativeˉx64ˉserviceˉemitˉfive(
        Builder, 76u8, 137u8, 124u8, 36u8, 64u8
    );
    Builder = Serviceˉcode.Nativeˉx64ˉserviceˉemitˉfive(
        Builder, 76u8, 137u8, 68u8, 36u8, 72u8
    );
    Builder = Serviceˉcode.Nativeˉx64ˉserviceˉemitˉfive(
        Builder, 68u8, 137u8, 76u8, 36u8, 80u8
    );
    Builder = Serviceˉcode.Nativeˉx64ˉserviceˉemitˉfour(
        Builder, 65u8, 199u8, 71u8, 64u8
    );
    Builder = Serviceˉcode.Nativeˉx64ˉserviceˉemitˉu32(Builder, 0u32);
    Builder = Serviceˉcode.Nativeˉx64ˉserviceˉemitˉfour(
        Builder, 73u8, 139u8, 71u8, 88u8
    );
    Builder = Serviceˉcode.Nativeˉx64ˉserviceˉemitˉfour(
        Builder, 72u8, 139u8, 72u8, Targetˉfieldˉoffset
    );
    Builder = Serviceˉcode.Nativeˉx64ˉserviceˉemitˉfive(
        Builder, 72u8, 137u8, 76u8, 36u8, 88u8
    );
    Builder = Serviceˉcode.Nativeˉx64ˉserviceˉemitˉfour(
        Builder, 72u8, 139u8, 64u8, 40u8
    );
    Builder = Serviceˉcode.Nativeˉx64ˉserviceˉemitˉfive(
        Builder, 72u8, 137u8, 68u8, 36u8, 96u8
    );

    let Textˉoffset: u32 = Bytesˉlength(Builder.Code);
    Builder = Serviceˉcode.Nativeˉx64ˉserviceˉemitˉfive(
        Builder, 131u8, 124u8, 36u8, 80u8, 0u8
    );
    Builder = Serviceˉcode.Nativeˉx64ˉserviceˉbranch(
        Builder, 132u8, Newlineˉtarget
    );
    Builder = Emitˉwriteˉcall(Builder, 72u8, true);
    Builder = Serviceˉcode.Nativeˉx64ˉserviceˉemitˉtwo(Builder, 133u8, 192u8);
    Builder = Serviceˉcode.Nativeˉx64ˉserviceˉbranch(
        Builder, 132u8, Failureˉtarget
    );
    Builder = Serviceˉcode.Nativeˉx64ˉserviceˉemitˉfour(
        Builder, 139u8, 68u8, 36u8, 84u8
    );
    Builder = Serviceˉcode.Nativeˉx64ˉserviceˉemitˉtwo(Builder, 133u8, 192u8);
    Builder = Serviceˉcode.Nativeˉx64ˉserviceˉbranch(
        Builder, 132u8, Failureˉtarget
    );
    Builder = Serviceˉcode.Nativeˉx64ˉserviceˉemitˉfour(
        Builder, 59u8, 68u8, 36u8, 80u8
    );
    Builder = Serviceˉcode.Nativeˉx64ˉserviceˉbranch(
        Builder, 135u8, Failureˉtarget
    );
    Builder = Serviceˉcode.Nativeˉx64ˉserviceˉemitˉfive(
        Builder, 72u8, 1u8, 68u8, 36u8, 72u8
    );
    Builder = Serviceˉcode.Nativeˉx64ˉserviceˉemitˉfour(
        Builder, 41u8, 68u8, 36u8, 80u8
    );
    Builder = Serviceˉcode.Nativeˉx64ˉserviceˉjump(Builder, Textˉtarget);

    let Newlineˉoffset: u32 = Bytesˉlength(Builder.Code);
    Builder = Serviceˉcode.Nativeˉx64ˉserviceˉemitˉfive(
        Builder, 198u8, 68u8, 36u8, 104u8, 10u8
    );
    Builder = Emitˉwriteˉcall(Builder, 104u8, false);
    Builder = Serviceˉcode.Nativeˉx64ˉserviceˉemitˉtwo(Builder, 133u8, 192u8);
    Builder = Serviceˉcode.Nativeˉx64ˉserviceˉbranch(
        Builder, 132u8, Failureˉtarget
    );
    Builder = Serviceˉcode.Nativeˉx64ˉserviceˉemitˉfive(
        Builder, 131u8, 124u8, 36u8, 84u8, 1u8
    );
    Builder = Serviceˉcode.Nativeˉx64ˉserviceˉbranch(
        Builder, 133u8, Failureˉtarget
    );
    Builder = Serviceˉcode.Nativeˉx64ˉserviceˉemitˉtwo(Builder, 49u8, 192u8);
    Builder = Serviceˉcode.Nativeˉx64ˉserviceˉjump(Builder, Returnˉtarget);

    let Failureˉoffset: u32 = Bytesˉlength(Builder.Code);
    Builder = Serviceˉcode.Nativeˉx64ˉserviceˉemitˉfour(
        Builder, 65u8, 199u8, 71u8, 64u8
    );
    Builder = Serviceˉcode.Nativeˉx64ˉserviceˉemitˉu32(Builder, 4u32);
    Builder = Serviceˉcode.Nativeˉx64ˉserviceˉemitˉu8(Builder, 184u8);
    Builder = Serviceˉcode.Nativeˉx64ˉserviceˉemitˉu32(Builder, 1u32);

    let Returnˉoffset: u32 = Bytesˉlength(Builder.Code);
    Builder = Serviceˉcode.Nativeˉx64ˉserviceˉemitˉfive(
        Builder, 76u8, 139u8, 84u8, 36u8, 48u8
    );
    Builder = Serviceˉcode.Nativeˉx64ˉserviceˉemitˉfive(
        Builder, 76u8, 139u8, 92u8, 36u8, 56u8
    );
    Builder = Serviceˉcode.Nativeˉx64ˉserviceˉemitˉfive(
        Builder, 76u8, 139u8, 124u8, 36u8, 64u8
    );
    Builder = Serviceˉcode.Nativeˉx64ˉserviceˉemitˉfive(
        Builder, 72u8, 139u8, 100u8, 36u8, 40u8
    );
    Builder = Serviceˉcode.Nativeˉx64ˉserviceˉemitˉu8(Builder, 195u8);

    var Labels: bytes = Bytesˉfromˉu32ˉlittle(Textˉoffset);
    Labels = Appendˉlabel(Labels, Newlineˉoffset);
    Labels = Appendˉlabel(Labels, Failureˉoffset);
    Labels = Appendˉlabel(Labels, Returnˉoffset);
    return Serviceˉcode.Nativeˉx64ˉserviceˉfinish(Builder, Labels);
}
