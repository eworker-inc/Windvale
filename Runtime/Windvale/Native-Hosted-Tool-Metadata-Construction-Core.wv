module Runtimeˉnativeˉhostedˉtoolˉmetadataˉconstruction profile portable;

import Foundationˉbyteˉconstruction as Byteˉconstruction;
import Runtimeˉnativeˉhostedˉtoolˉmetadataˉadmission as Metadataˉadmission;

fn Empty(Input: bytes) -> bytes {
    return Bytesˉslice(Input, 0u32, 0u32);
}

fn Appendˉu32(Input: bytes, Value: u32) -> bytes {
    return Bytesˉconcat(Input, Bytesˉfromˉu32ˉlittle(Value));
}

fn Appendˉu64(Input: bytes, Low: u32, High: u32) -> bytes {
    return Appendˉu32(Appendˉu32(Input, Low), High);
}

fn Zeroes(Input: bytes, Count: u32) -> bytes {
    let Result: Byteˉconstruction.Foundationˉbytesˉresult =
        Byteˉconstruction.Foundationˉbytesˉrepeat(0u8, Count);
    return Result.Value;
}

fn Allˉzero(Input: bytes, Offset: u32, Count: u32) -> bool {
    var Index: u32 = 0u32;
    while Index < Count {
        if Bytesˉreadˉu8(Input, Offset + Index) != 0u8 { return false; }
        Index = Index + 1u32;
    }
    return true;
}

fn Responseˉheader(
    Input: bytes,
    Totalˉbytes: u32,
    Status: u32,
    Failureˉoffset: u32,
    Metadataˉbytes: u32
) -> bytes {
    var Result: bytes = Empty(Input);
    Result = Appendˉu32(Result, 1145591383u32);
    Result = Appendˉu32(Result, 1u32);
    Result = Appendˉu32(Result, Totalˉbytes);
    Result = Appendˉu32(Result, Status);
    Result = Appendˉu32(Result, Failureˉoffset);
    Result = Appendˉu32(Result, Metadataˉbytes);
    Result = Appendˉu32(Result, 0u32);
    return Appendˉu32(Result, 0u32);
}

fn Failure(Input: bytes, Status: u32, Failureˉoffset: u32) -> bytes {
    return Responseˉheader(Input, 32u32, Status, Failureˉoffset, 0u32);
}

fn Profileˉmagic(Profile: u32) -> u32 {
    if Profile == 1u32 { return 1095259735u32; }
    if Profile == 2u32 { return 1112036951u32; }
    if Profile == 3u32 { return 1397249623u32; }
    if Profile == 4u32 { return 1279809111u32; }
    if Profile == 5u32 { return 1346917975u32; }
    if Profile == 6u32 { return 1313363543u32; }
    return 1195923031u32;
}

fn Profileˉcontainer(Profile: u32) -> u32 {
    if Profile == 1u32 { return 3u32; }
    return Profile + 3u32;
}

fn Profileˉflags(Profile: u32) -> u32 {
    if Profile == 1u32 { return 1u32; }
    return Profile + 1u32;
}

fn Textˉarenaˉbytes(Profile: u32) -> u32 {
    if Profile == 2u32 || Profile == 6u32 { return 234881024u32; }
    return 134217728u32;
}

fn Instructionˉlimitˉlow(Profile: u32) -> u32 {
    if Profile == 7u32 { return 2690588672u32; }
    return 3870457856u32;
}

fn Instructionˉlimitˉhigh(Profile: u32) -> u32 {
    if Profile == 7u32 { return 18u32; }
    return 14u32;
}

fn Capabilityˉservice(Index: u32) -> u32 {
    if Index == 0u32 { return 1u32; }
    if Index == 1u32 { return 6u32; }
    if Index == 2u32 { return 4u32; }
    if Index == 3u32 { return 12u32; }
    if Index == 4u32 { return 3u32; }
    return 2u32;
}

fn Capabilityˉsignature(Index: u32) -> u32 {
    if Index < 2u32 { return 1u32; }
    return Index;
}

fn Serviceˉidentity(Index: u32) -> u32 {
    if Index < 8u32 { return Index + 1u32; }
    return Index + 3u32;
}

fn Serviceˉcapability(Index: u32) -> u32 {
    if Index == 0u32 { return 1u32; }
    if Index == 1u32 { return 6u32; }
    if Index == 2u32 { return 5u32; }
    if Index == 3u32 { return 3u32; }
    if Index == 5u32 { return 2u32; }
    if Index == 9u32 { return 4u32; }
    return 0u32;
}

fn Serviceˉtableˉoffset(Index: u32) -> u32 {
    if Index < 8u32 { return 8u32 + Index * 8u32; }
    return 88u32 + (Index - 8u32) * 8u32;
}

fn Serviceˉadapter(Index: u32, Target: u32) -> u32 {
    if Index == 0u32 { return Target; }
    if Index == 1u32 || Index == 2u32 { return 3u32; }
    if Index == 3u32 { return Target + 3u32; }
    if Index == 4u32 { return 6u32; }
    if Index == 5u32 { return Target + 6u32; }
    if Index == 6u32 { return 9u32; }
    if Index == 7u32 { return 10u32; }
    if Index == 8u32 { return 13u32; }
    return Target + 13u32;
}

fn Appendˉcapabilities(Input: bytes, Metadata: bytes) -> bytes {
    var Result: bytes = Metadata;
    var Index: u32 = 0u32;
    while Index < 6u32 {
        Result = Appendˉu32(Result, Index + 1u32);
        Result = Appendˉu32(Result, Capabilityˉservice(Index));
        Result = Appendˉu32(Result, Capabilityˉsignature(Index));
        Result = Appendˉu32(Result, 1u32);
        Index = Index + 1u32;
    }
    return Result;
}

fn Appendˉservices(
    Input: bytes,
    Metadata: bytes,
    Target: u32
) -> bytes {
    var Result: bytes = Metadata;
    var Index: u32 = 0u32;
    while Index < 10u32 {
        let Requestˉrecord: u32 = 96u32 + Index * 48u32;
        let Capability: u32 = Serviceˉcapability(Index);
        Result = Appendˉu32(Result, Serviceˉidentity(Index));
        Result = Appendˉu32(Result, Capability);
        Result = Appendˉu32(Result, Serviceˉtableˉoffset(Index));
        Result = Appendˉu32(Result, Serviceˉadapter(Index, Target));
        Result = Bytesˉconcat(Result, Bytesˉslice(Input, Requestˉrecord, 8u32));
        if Capability == 0u32 {
            Result = Appendˉu32(Result, 2u32);
        } else {
            Result = Appendˉu32(Result, 1u32);
        }
        Result = Appendˉu32(Result, 0u32);
        Result = Bytesˉconcat(Result, Bytesˉslice(Input, Requestˉrecord + 8u32, 32u32));
        Index = Index + 1u32;
    }
    return Result;
}

export fn Nativeˉhostedˉtoolˉmetadataˉbuild(Input: bytes) -> bytes {
    let Total: u32 = Bytesˉlength(Input);
    if Total != 576u32 { return Failure(Input, 1u32, Total); }
    if Bytesˉreadˉu32ˉlittle(Input, 0u32) != 1296586327u32 {
        return Failure(Input, 2u32, 0u32);
    }
    if Bytesˉreadˉu32ˉlittle(Input, 4u32) != 1u32 {
        return Failure(Input, 3u32, 4u32);
    }
    if Bytesˉreadˉu32ˉlittle(Input, 8u32) != Total {
        return Failure(Input, 1u32, 8u32);
    }

    let Target: u32 = Bytesˉreadˉu32ˉlittle(Input, 12u32);
    let Profile: u32 = Bytesˉreadˉu32ˉlittle(Input, 16u32);
    let Bundleˉoffset: u32 = Bytesˉreadˉu32ˉlittle(Input, 20u32);
    let Bundleˉbytes: u32 = Bytesˉreadˉu32ˉlittle(Input, 24u32);
    let Nativeˉbytes: u32 = Bytesˉreadˉu32ˉlittle(Input, 28u32);
    let Nativeˉentry: u32 = Bytesˉreadˉu32ˉlittle(Input, 32u32);
    if Target < 1u32 || Target > 2u32 ||
        Profile < 1u32 || Profile > 7u32 ||
        Bundleˉoffset != 4096u32 ||
        Bundleˉbytes == 0u32 || Bundleˉbytes > 35651584u32 ||
        Nativeˉbytes == 0u32 || Nativeˉbytes > 33554432u32 ||
        Nativeˉbytes > Bundleˉbytes || Nativeˉentry >= Nativeˉbytes ||
        Bytesˉreadˉu32ˉlittle(Input, 36u32) != 10u32 ||
        Allˉzero(Input, 40u32, 32u32) ||
        !Allˉzero(Input, 72u32, 24u32) {
        return Failure(Input, 4u32, 12u32);
    }

    var Previousˉend: u32 = Nativeˉbytes;
    var Index: u32 = 0u32;
    while Index < 10u32 {
        let Record: u32 = 96u32 + Index * 48u32;
        let Imageˉoffset: u32 = Bytesˉreadˉu32ˉlittle(Input, Record);
        let Codeˉbytes: u32 = Bytesˉreadˉu32ˉlittle(Input, Record + 4u32);
        if Imageˉoffset < Previousˉend || Imageˉoffset >= Bundleˉbytes ||
            Codeˉbytes == 0u32 || Codeˉbytes > Bundleˉbytes - Imageˉoffset ||
            Allˉzero(Input, Record + 8u32, 32u32) ||
            !Allˉzero(Input, Record + 40u32, 8u32) {
            return Failure(Input, 5u32, Record);
        }
        Previousˉend = Imageˉoffset + Codeˉbytes;
        Index = Index + 1u32;
    }

    var Metadata: bytes = Empty(Input);
    Metadata = Appendˉu32(Metadata, Profileˉmagic(Profile));
    Metadata = Appendˉu32(Metadata, 1u32);
    Metadata = Appendˉu32(Metadata, 1024u32);
    Metadata = Appendˉu32(Metadata, Target);
    Metadata = Appendˉu32(Metadata, Profileˉcontainer(Profile));
    Metadata = Appendˉu32(Metadata, 22u32);
    Metadata = Appendˉu32(Metadata, 7u32);
    Metadata = Appendˉu32(Metadata, 5u32);
    Metadata = Appendˉu32(Metadata, 6u32);
    Metadata = Appendˉu32(Metadata, 10u32);
    Metadata = Appendˉu32(Metadata, 128u32);
    Metadata = Appendˉu32(Metadata, 16u32);
    Metadata = Appendˉu32(Metadata, 224u32);
    Metadata = Appendˉu32(Metadata, 64u32);
    Metadata = Appendˉu32(Metadata, Bundleˉoffset);
    Metadata = Appendˉu32(Metadata, Bundleˉbytes);
    Metadata = Appendˉu32(Metadata, 0u32);
    Metadata = Appendˉu32(Metadata, Nativeˉbytes);
    Metadata = Appendˉu32(Metadata, Nativeˉentry);
    Metadata = Appendˉu32(Metadata, 2097152u32);
    Metadata = Appendˉu32(Metadata, Textˉarenaˉbytes(Profile));
    Metadata = Appendˉu32(Metadata, Profileˉflags(Profile));
    Metadata = Appendˉu64(
        Metadata,
        Instructionˉlimitˉlow(Profile),
        Instructionˉlimitˉhigh(Profile)
    );
    Metadata = Bytesˉconcat(Metadata, Bytesˉslice(Input, 40u32, 32u32));
    Metadata = Appendˉcapabilities(Input, Metadata);
    Metadata = Appendˉservices(Input, Metadata, Target);
    Metadata = Bytesˉconcat(Metadata, Zeroes(Input, 160u32));
    if !Metadataˉadmission.Nativeˉhostedˉtoolˉmetadataˉisˉvalid(
        Metadata,
        0u32,
        Target,
        Profile
    ) {
        return Failure(Input, 6u32, 12u32);
    }
    return Bytesˉconcat(
        Responseˉheader(Input, 1056u32, 0u32, Total, 1024u32),
        Metadata
    );
}
