module Runtimeˉnativeˉhostedˉverifierˉmetadataˉadmission profile portable;

fn Rangeˉisˉvalid(Total: u32, Offset: u32, Count: u32) -> bool {
    return Offset <= Total && Count <= Total - Offset;
}

fn Allˉzero(Input: bytes, Offset: u32, Count: u32) -> bool {
    var Index: u32 = 0u32;
    while Index < Count {
        if Bytesˉreadˉu8(Input, Offset + Index) != 0u8 { return false; }
        Index = Index + 1u32;
    }
    return true;
}

fn Serviceˉcapability(Index: u32) -> u32 {
    if Index == 0u32 { return 1u32; }
    if Index == 1u32 { return 5u32; }
    if Index == 2u32 { return 4u32; }
    if Index == 3u32 { return 3u32; }
    if Index == 5u32 { return 2u32; }
    return 0u32;
}

fn Serviceˉadapter(Index: u32, Target: u32) -> u32 {
    if Index == 0u32 { return Target; }
    if Index == 1u32 || Index == 2u32 { return 3u32; }
    if Index == 3u32 { return Target + 3u32; }
    if Index == 4u32 { return 6u32; }
    if Index == 5u32 { return Target + 6u32; }
    return Index + 3u32;
}

fn Capabilitiesˉareˉvalid(Input: bytes, Offset: u32) -> bool {
    var Index: u32 = 0u32;
    while Index < 5u32 {
        let Record: u32 = Offset + 128u32 + Index * 16u32;
        var Service: u32 = 0u32;
        var Signature: u32 = 0u32;
        if Index == 0u32 { Service = 1u32; Signature = 1u32; }
        if Index == 1u32 { Service = 6u32; Signature = 1u32; }
        if Index == 2u32 { Service = 4u32; Signature = 2u32; }
        if Index == 3u32 { Service = 3u32; Signature = 3u32; }
        if Index == 4u32 { Service = 2u32; Signature = 4u32; }
        if Bytesˉreadˉu32ˉlittle(Input, Record) != Index + 1u32 ||
            Bytesˉreadˉu32ˉlittle(Input, Record + 4u32) != Service ||
            Bytesˉreadˉu32ˉlittle(Input, Record + 8u32) != Signature ||
            Bytesˉreadˉu32ˉlittle(Input, Record + 12u32) != 1u32 {
            return false;
        }
        Index = Index + 1u32;
    }
    return true;
}

fn Servicesˉareˉvalid(
    Input: bytes,
    Offset: u32,
    Target: u32,
    Nativeˉbytes: u32,
    Bundleˉbytes: u32,
    Serviceˉcount: u32
) -> bool {
    var Previousˉend: u32 = Nativeˉbytes;
    var Index: u32 = 0u32;
    while Index < Serviceˉcount {
        let Record: u32 = Offset + 208u32 + Index * 64u32;
        let Imageˉoffset: u32 = Bytesˉreadˉu32ˉlittle(Input, Record + 16u32);
        let Codeˉbytes: u32 = Bytesˉreadˉu32ˉlittle(Input, Record + 20u32);
        let Capability: u32 = Serviceˉcapability(Index);
        var Flags: u32 = 1u32;
        if Capability == 0u32 { Flags = 2u32; }
        if Bytesˉreadˉu32ˉlittle(Input, Record) != Index + 1u32 ||
            Bytesˉreadˉu32ˉlittle(Input, Record + 4u32) != Capability ||
            Bytesˉreadˉu32ˉlittle(Input, Record + 8u32) != 8u32 + Index * 8u32 ||
            Bytesˉreadˉu32ˉlittle(Input, Record + 12u32) !=
                Serviceˉadapter(Index, Target) ||
            Imageˉoffset < Previousˉend || Imageˉoffset >= Bundleˉbytes ||
            Codeˉbytes == 0u32 || Codeˉbytes > Bundleˉbytes - Imageˉoffset ||
            Bytesˉreadˉu32ˉlittle(Input, Record + 24u32) != Flags ||
            Bytesˉreadˉu32ˉlittle(Input, Record + 28u32) != 0u32 ||
            Allˉzero(Input, Record + 32u32, 32u32) {
            return false;
        }
        Previousˉend = Imageˉoffset + Codeˉbytes;
        Index = Index + 1u32;
    }
    return true;
}

export fn Nativeˉhostedˉverifierˉmetadataˉisˉvalidˉforˉprofile(
    Input: bytes,
    Offset: u32,
    Target: u32,
    Profile: u32
) -> bool {
    let Total: u32 = Bytesˉlength(Input);
    var Serviceˉcount: u32 = 6u32;
    if Profile == 6u32 || Profile == 7u32 { Serviceˉcount = 11u32; }
    if !Rangeˉisˉvalid(Total, Offset, 1024u32) ||
        Target < 1u32 || Target > 2u32 ||
        (Profile != 2u32 && Profile != 6u32 && Profile != 7u32 &&
            Profile != 8u32) {
        return false;
    }
    if Bytesˉreadˉu32ˉlittle(Input, Offset) != 1447581271u32 ||
        Bytesˉreadˉu32ˉlittle(Input, Offset + 4u32) != 1u32 ||
        Bytesˉreadˉu32ˉlittle(Input, Offset + 8u32) != 1024u32 ||
        Bytesˉreadˉu32ˉlittle(Input, Offset + 12u32) != Target ||
        Bytesˉreadˉu32ˉlittle(Input, Offset + 16u32) != 4u32 ||
        Bytesˉreadˉu32ˉlittle(Input, Offset + 20u32) != 22u32 ||
        Bytesˉreadˉu32ˉlittle(Input, Offset + 24u32) != 7u32 ||
        Bytesˉreadˉu32ˉlittle(Input, Offset + 28u32) != 5u32 ||
        Bytesˉreadˉu32ˉlittle(Input, Offset + 32u32) != 5u32 ||
        Bytesˉreadˉu32ˉlittle(Input, Offset + 36u32) != Serviceˉcount ||
        Bytesˉreadˉu32ˉlittle(Input, Offset + 40u32) != 128u32 ||
        Bytesˉreadˉu32ˉlittle(Input, Offset + 44u32) != 16u32 ||
        Bytesˉreadˉu32ˉlittle(Input, Offset + 48u32) != 208u32 ||
        Bytesˉreadˉu32ˉlittle(Input, Offset + 52u32) != 64u32 {
        return false;
    }
    let Bundleˉoffset: u32 = Bytesˉreadˉu32ˉlittle(Input, Offset + 56u32);
    let Bundleˉbytes: u32 = Bytesˉreadˉu32ˉlittle(Input, Offset + 60u32);
    let Nativeˉbytes: u32 = Bytesˉreadˉu32ˉlittle(Input, Offset + 68u32);
    let Nativeˉentry: u32 = Bytesˉreadˉu32ˉlittle(Input, Offset + 72u32);
    if Bundleˉoffset != 4096u32 || Bundleˉoffset % 16u32 != 0u32 ||
        Bundleˉbytes == 0u32 || Bundleˉbytes > 35651584u32 ||
        Bytesˉreadˉu32ˉlittle(Input, Offset + 64u32) != 0u32 ||
        Nativeˉbytes == 0u32 || Nativeˉbytes > 33554432u32 ||
        Nativeˉbytes > Bundleˉbytes || Nativeˉentry >= Nativeˉbytes ||
        Bytesˉreadˉu32ˉlittle(Input, Offset + 76u32) != 2097152u32 ||
        Bytesˉreadˉu32ˉlittle(Input, Offset + 80u32) != 134217728u32 ||
        Bytesˉreadˉu32ˉlittle(Input, Offset + 84u32) != Profile ||
        Bytesˉreadˉu32ˉlittle(Input, Offset + 88u32) != 3115098112u32 ||
        Bytesˉreadˉu32ˉlittle(Input, Offset + 92u32) != 3u32 ||
        Allˉzero(Input, Offset + 96u32, 32u32) ||
        !Capabilitiesˉareˉvalid(Input, Offset) ||
        !Servicesˉareˉvalid(
            Input,
            Offset,
            Target,
            Nativeˉbytes,
            Bundleˉbytes,
            Serviceˉcount
        ) ||
        !Allˉzero(
            Input,
            Offset + 208u32 + Serviceˉcount * 64u32,
            1024u32 - (208u32 + Serviceˉcount * 64u32)
        ) {
        return false;
    }
    return true;
}

export fn Nativeˉhostedˉverifierˉmetadataˉisˉvalid(
    Input: bytes,
    Offset: u32,
    Target: u32
) -> bool {
    return Nativeˉhostedˉverifierˉmetadataˉisˉvalidˉforˉprofile(
        Input,
        Offset,
        Target,
        2u32
    );
}
