module Nativeˉhostedˉenumˉserviceˉtool profile hosted;

import Nativeˉhostedˉenumˉservice as Enumˉservice;
import Runtimeˉnativeˉx64ˉenumˉnameˉservice as Enumˉleaf;

capability console.write_line;
capability diagnostic.write_line;
capability file.read_bytes;
capability file.write_bytes;
capability process.argument;
capability process.argument_count;

enum Nativeˉhostedˉenumˉserviceˉstatus {
    Valid = 0;
    Rejected = 1;
}

fn Reject() -> i32 {
    diagnostic.write_line(
        Textˉconcat(
            "hosted enum service status=",
            Enumˉname(Nativeˉhostedˉenumˉserviceˉstatus.Rejected)
        )
    );
    return 2;
}

fn Pathsˉareˉequal(Left: text, Right: text) -> bool {
    let Leftˉbytes: bytes = Textˉtoˉutf8(Left);
    let Rightˉbytes: bytes = Textˉtoˉutf8(Right);
    let Length: u32 = Bytesˉlength(Leftˉbytes);
    if Length != Bytesˉlength(Rightˉbytes) { return false; }
    var Index: u32 = 0u32;
    while Index < Length {
        if Bytesˉreadˉu8(Leftˉbytes, Index) !=
            Bytesˉreadˉu8(Rightˉbytes, Index) {
            return false;
        }
        Index = Index + 1u32;
    }
    return true;
}

export fn Main() -> i32 {
    if process.argument_count() != 2u32 {
        diagnostic.write_line(
            "Usage: wvhostenumservice <request.wveq> <service.bin>"
        );
        return 64;
    }
    let Inputˉpath: text = process.argument(0u32);
    let Outputˉpath: text = process.argument(1u32);
    if Pathsˉareˉequal(Inputˉpath, Outputˉpath) {
        return Reject();
    }
    let Result: Enumˉservice.Nativeˉhostedˉenumˉserviceˉresult =
        Enumˉservice.Nativeˉhostedˉenumˉserviceˉbuild(
            file.read_bytes(Inputˉpath),
            Enumˉleaf.Nativeˉx64ˉenumˉnameˉserviceˉbuild()
        );
    if !Result.Valid {
        return Reject();
    }
    file.write_bytes(Outputˉpath, Result.Value);
    console.write_line(
        Textˉconcat(
            Textˉconcat(
                "hosted enum service status=",
                Enumˉname(Nativeˉhostedˉenumˉserviceˉstatus.Valid)
            ),
            Textˉconcat(" bytes=", U32ˉformat(Bytesˉlength(Result.Value)))
        )
    );
    return 0;
}
