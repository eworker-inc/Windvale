module Nativeˉhostedˉenumˉservice profile portable;

import Compilerˉnativeˉenumˉmetadata as Metadata;

export record Nativeˉhostedˉenumˉserviceˉresult {
    Valid: bool;
    Value: bytes;
}

fn Empty(Input: bytes) -> bytes {
    return Bytesˉslice(Input, 0u32, 0u32);
}

export fn Nativeˉhostedˉenumˉserviceˉbuild(
    Request: bytes,
    Leaf: bytes
) -> Nativeˉhostedˉenumˉserviceˉresult {
    let Response: bytes = Metadata.Nativeˉenumˉmetadataˉbuild(Request);
    if Bytesˉlength(Response) < 56u32 ||
        Bytesˉreadˉu32ˉlittle(Response, 0u32) != 1128617559u32 ||
        Bytesˉreadˉu32ˉlittle(Response, 4u32) != 1u32 ||
        Bytesˉreadˉu32ˉlittle(Response, 8u32) != Bytesˉlength(Response) ||
        Bytesˉreadˉu32ˉlittle(Response, 12u32) != 24u32 ||
        Bytesˉreadˉu32ˉlittle(Response, 28u32) != 0u32 {
        return Nativeˉhostedˉenumˉserviceˉresult(false, Empty(Request));
    }
    let Metadataˉbytes: u32 = Bytesˉlength(Response) - 32u32;
    let Wven: bytes = Bytesˉslice(Response, 32u32, Metadataˉbytes);
    if Bytesˉreadˉu32ˉlittle(Wven, 0u32) != 1313166935u32 ||
        Bytesˉreadˉu32ˉlittle(Wven, 4u32) != 1u32 ||
        Bytesˉreadˉu32ˉlittle(Wven, 8u32) != Metadataˉbytes {
        return Nativeˉhostedˉenumˉserviceˉresult(false, Empty(Request));
    }
    return Nativeˉhostedˉenumˉserviceˉresult(
        true,
        Bytesˉconcat(Leaf, Wven)
    );
}
