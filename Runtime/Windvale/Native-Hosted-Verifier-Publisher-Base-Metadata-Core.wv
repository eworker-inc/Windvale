module Runtimeˉnativeˉhostedˉverifierˉpublisherˉbaseˉmetadata profile portable;

import Compilerˉnativeˉpublication as Publication;
import Foundationˉsha256ˉstreaming as Sha;
import Runtimeˉnativeˉhostedˉverifierˉmetadataˉconstruction as Construction;
import Runtimeˉnativeˉhostedˉverifierˉmetadataˉrequest as Request;

export record Nativeˉhostedˉverifierˉpublisherˉbaseˉmetadataˉresult {
    Valid: bool;
    Value: bytes;
}

fn Empty(Input: bytes) -> bytes {
    return Bytesˉslice(Input, 0u32, 0u32);
}

fn Failure(Input: bytes)
    -> Nativeˉhostedˉverifierˉpublisherˉbaseˉmetadataˉresult {
    return Nativeˉhostedˉverifierˉpublisherˉbaseˉmetadataˉresult(
        false,
        Empty(Input)
    );
}

fn Appendˉu32(Output: bytes, Value: u32) -> bytes {
    return Bytesˉconcat(Output, Bytesˉfromˉu32ˉlittle(Value));
}

fn Digest(Input: bytes) -> bytes {
    var State: Sha.Foundationˉsha256ˉstream =
        Sha.Foundationˉsha256ˉbegin(Input);
    State = Sha.Foundationˉsha256ˉupdate(State, Input);
    return Sha.Foundationˉsha256ˉfinishˉraw(State);
}

fn Planˉisˉcanonical(Input: bytes) -> bool {
    if Bytesˉreadˉu32ˉlittle(Input, 32u32) != 1364219479u32 ||
        Bytesˉreadˉu32ˉlittle(Input, 36u32) != 1u32 ||
        Bytesˉreadˉu32ˉlittle(Input, 40u32) != 96u32 ||
        Bytesˉreadˉu32ˉlittle(Input, 44u32) == 0u32 ||
        Bytesˉreadˉu32ˉlittle(Input, 48u32) != 6u32 ||
        Bytesˉreadˉu32ˉlittle(Input, 52u32) != 0u32 {
        return false;
    }
    var Index: u32 = 0u32;
    while Index < 6u32 {
        let Record: u32 = 56u32 + Index * 12u32;
        if Bytesˉreadˉu32ˉlittle(Input, Record) != Index + 1u32 ||
            Bytesˉreadˉu32ˉlittle(Input, Record + 4u32) == 0u32 ||
            Bytesˉreadˉu32ˉlittle(Input, Record + 8u32) != 0u32 {
            return false;
        }
        Index = Index + 1u32;
    }
    return true;
}

export fn Nativeˉhostedˉverifierˉpublisherˉbaseˉmetadataˉbuildˉforˉprofile(
    Target: u32,
    Profile: u32,
    Nativeˉentry: u32,
    Input: bytes
) -> Nativeˉhostedˉverifierˉpublisherˉbaseˉmetadataˉresult {
    let Total: u32 = Bytesˉlength(Input);
    if (Target != 1u32 && Target != 2u32) ||
        (Profile != 2u32 && Profile != 8u32) ||
        Total < 128u32 || Total > 4194304u32 ||
        Bytesˉreadˉu32ˉlittle(Input, 0u32) != 1364416087u32 ||
        Bytesˉreadˉu32ˉlittle(Input, 4u32) != 2u32 ||
        Bytesˉreadˉu32ˉlittle(Input, 8u32) != Total ||
        Bytesˉreadˉu32ˉlittle(Input, 12u32) != 96u32 ||
        Bytesˉreadˉu32ˉlittle(Input, 16u32) != 0u32 ||
        Bytesˉreadˉu32ˉlittle(Input, 24u32) != Total - 128u32 ||
        Bytesˉreadˉu32ˉlittle(Input, 28u32) != 0u32 ||
        !Planˉisˉcanonical(Input) {
        return Failure(Input);
    }

    let Plan = Publication.Nativeˉpublicationˉplan(
        Bytesˉslice(Input, 32u32, 96u32)
    );
    if Bytesˉlength(Plan.Value) != 104u32 ||
        Bytesˉreadˉu32ˉlittle(Plan.Value, 12u32) != 0u32 ||
        Bytesˉreadˉu32ˉlittle(Plan.Value, 20u32) !=
            Bytesˉreadˉu32ˉlittle(Input, 44u32) ||
        Bytesˉreadˉu32ˉlittle(Plan.Value, 24u32) !=
            Bytesˉreadˉu32ˉlittle(Input, 20u32) ||
        Bytesˉreadˉu32ˉlittle(Plan.Value, 28u32) != 6u32 {
        return Failure(Input);
    }

    var Evidence: bytes = Empty(Input);
    Evidence = Appendˉu32(Evidence, 1163286103u32);
    Evidence = Appendˉu32(Evidence, 1u32);
    Evidence = Appendˉu32(Evidence, 352u32);
    Evidence = Appendˉu32(Evidence, Target);
    Evidence = Appendˉu32(Evidence, Profile);
    Evidence = Appendˉu32(Evidence, Nativeˉentry);
    Evidence = Bytesˉconcat(Evidence, Bytesˉslice(Input, 32u32, 96u32));

    var Payloadˉoffset: u32 = 128u32;
    var Region: u32 = 0u32;
    while Region < 7u32 {
        var Regionˉbytes: u32 = Bytesˉreadˉu32ˉlittle(Input, 44u32);
        if Region > 0u32 {
            Regionˉbytes = Bytesˉreadˉu32ˉlittle(
                Input,
                48u32 + Region * 12u32
            );
        }
        if Payloadˉoffset > Total || Regionˉbytes > Total - Payloadˉoffset {
            return Failure(Input);
        }
        Evidence = Bytesˉconcat(
            Evidence,
            Digest(Bytesˉslice(Input, Payloadˉoffset, Regionˉbytes))
        );
        Payloadˉoffset = Payloadˉoffset + Regionˉbytes;
        Region = Region + 1u32;
    }
    if Payloadˉoffset != Total { return Failure(Input); }
    Evidence = Appendˉu32(Evidence, 0u32);
    Evidence = Appendˉu32(Evidence, 0u32);
    if Bytesˉlength(Evidence) != 352u32 { return Failure(Input); }

    let Requestˉresponse: bytes =
        Request.Nativeˉhostedˉverifierˉmetadataˉrequestˉbuild(Evidence);
    if Bytesˉlength(Requestˉresponse) != 416u32 ||
        Bytesˉreadˉu32ˉlittle(Requestˉresponse, 0u32) != 1146508887u32 ||
        Bytesˉreadˉu32ˉlittle(Requestˉresponse, 4u32) != 1u32 ||
        Bytesˉreadˉu32ˉlittle(Requestˉresponse, 8u32) != 416u32 ||
        Bytesˉreadˉu32ˉlittle(Requestˉresponse, 12u32) != 0u32 ||
        Bytesˉreadˉu32ˉlittle(Requestˉresponse, 16u32) != 352u32 ||
        Bytesˉreadˉu32ˉlittle(Requestˉresponse, 20u32) != 384u32 {
        return Failure(Input);
    }

    let Metadataˉresponse: bytes =
        Construction.Nativeˉhostedˉverifierˉmetadataˉbuild(
            Bytesˉslice(Requestˉresponse, 32u32, 384u32)
        );
    if Bytesˉlength(Metadataˉresponse) != 1056u32 ||
        Bytesˉreadˉu32ˉlittle(Metadataˉresponse, 0u32) != 1145591383u32 ||
        Bytesˉreadˉu32ˉlittle(Metadataˉresponse, 4u32) != 1u32 ||
        Bytesˉreadˉu32ˉlittle(Metadataˉresponse, 8u32) != 1056u32 ||
        Bytesˉreadˉu32ˉlittle(Metadataˉresponse, 12u32) != 0u32 ||
        Bytesˉreadˉu32ˉlittle(Metadataˉresponse, 16u32) != 384u32 ||
        Bytesˉreadˉu32ˉlittle(Metadataˉresponse, 20u32) != 1024u32 {
        return Failure(Input);
    }
    return Nativeˉhostedˉverifierˉpublisherˉbaseˉmetadataˉresult(
        true,
        Bytesˉslice(Metadataˉresponse, 32u32, 1024u32)
    );
}

export fn Nativeˉhostedˉverifierˉpublisherˉbaseˉmetadataˉbuild(
    Target: u32,
    Nativeˉentry: u32,
    Input: bytes
) -> Nativeˉhostedˉverifierˉpublisherˉbaseˉmetadataˉresult {
    return Nativeˉhostedˉverifierˉpublisherˉbaseˉmetadataˉbuildˉforˉprofile(
        Target,
        2u32,
        Nativeˉentry,
        Input
    );
}
