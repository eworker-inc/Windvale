module Nativeˉhostedˉorchestrationˉcontrolˉtool profile hosted;

import Foundationˉdecimalˉparsing as Decimal;
import Nativeˉhostedˉorchestrationˉcontrol as Control;

capability console.write_line;
capability diagnostic.write_line;
capability file.read_bytes;
capability file.write_bytes;
capability process.argument;
capability process.argument_count;

enum Nativeˉhostedˉorchestrationˉcontrolˉstatus {
    Valid = 0;
    Rejected = 1;
}

fn Textˉisˉequal(Left: text, Right: text) -> bool {
    let Leftˉbytes: bytes = Textˉtoˉutf8(Left);
    let Rightˉbytes: bytes = Textˉtoˉutf8(Right);
    let Length: u32 = Bytesˉlength(Leftˉbytes);
    if Length != Bytesˉlength(Rightˉbytes) { return false; }
    var Index: u32 = 0u32;
    while Index < Length {
        if Bytesˉreadˉu8(Leftˉbytes, Index) !=
            Bytesˉreadˉu8(Rightˉbytes, Index) { return false; }
        Index = Index + 1u32;
    }
    return true;
}

fn Parseˉu32(Value: text) -> Decimal.Foundationˉu32ˉparse {
    let Bytes: bytes = Textˉtoˉutf8(Value);
    return Decimal.Foundationˉu32ˉdecimalˉparse(
        Bytes, 0u32, Bytesˉlength(Bytes)
    );
}

fn Reject() -> i32 {
    diagnostic.write_line(
        Textˉconcat(
            "hosted orchestration control status=",
            Enumˉname(Nativeˉhostedˉorchestrationˉcontrolˉstatus.Rejected)
        )
    );
    return 2;
}

fn Metadata() -> i32 {
    let Targetˉtext: text = process.argument(1u32);
    var Target: u32 = 0u32;
    if Textˉisˉequal(Targetˉtext, "windows") { Target = 1u32; }
    if Textˉisˉequal(Targetˉtext, "linux") { Target = 2u32; }
    let Profile: Decimal.Foundationˉu32ˉparse =
        Parseˉu32(process.argument(2u32));
    let Entry: Decimal.Foundationˉu32ˉparse =
        Parseˉu32(process.argument(3u32));
    let Result: Control.Nativeˉhostedˉcontrolˉresult =
        Control.Nativeˉhostedˉmetadataˉinputˉbuild(
            Textˉtoˉutf8(Targetˉtext),
            Target,
            Profile.Value,
            Entry.Value
        );
    if !Profile.Valid || !Entry.Valid || !Result.Valid { return Reject(); }
    file.write_bytes(process.argument(4u32), Result.Value);
    console.write_line("hosted orchestration control status=Valid kind=metadata bytes=32");
    return 0;
}

fn Evidence() -> i32 {
    let Inputˉpath: text = process.argument(1u32);
    let Outputˉpath: text = process.argument(2u32);
    if Textˉisˉequal(Inputˉpath, Outputˉpath) { return Reject(); }
    let Result: Control.Nativeˉhostedˉcontrolˉresult =
        Control.Nativeˉhostedˉevidenceˉmanifestˉbuild(
            file.read_bytes(Inputˉpath)
        );
    if !Result.Valid { return Reject(); }
    file.write_bytes(Outputˉpath, Result.Value);
    console.write_line(
        Textˉconcat(
            "hosted orchestration control status=Valid kind=evidence bytes=",
            U32ˉformat(Bytesˉlength(Result.Value))
        )
    );
    return 0;
}

export fn Main() -> i32 {
    let Arguments: u32 = process.argument_count();
    if Arguments == 5u32 && Textˉisˉequal(process.argument(0u32), "metadata") {
        return Metadata();
    }
    if Arguments == 3u32 && Textˉisˉequal(process.argument(0u32), "evidence") {
        return Evidence();
    }
    diagnostic.write_line(
        "Usage: wvhostcontrol metadata <windows|linux> <profile> <native-entry> <output.wvmi> | wvhostcontrol evidence <sources.wvsg> <output.wvhs>"
    );
    return 64;
}
