        Next, 72u8, 139u8, 124u8, 36u8, 40u8
    );
    Next = Serviceˉcode.Nativeˉx64ˉserviceˉemitˉfour(
        Next, 139u8, 76u8, 36u8, 48u8
    );
    Next = Serviceˉcode.Nativeˉx64ˉserviceˉemitˉtwo(Next, 242u8, 174u8);
    Next = Serviceˉcode.Nativeˉx64ˉserviceˉbranch(
