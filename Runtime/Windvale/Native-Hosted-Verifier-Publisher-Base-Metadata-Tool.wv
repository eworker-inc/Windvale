module Runtimeˉnativeˉhostedˉverifierˉpublisherˉbaseˉmetadataˉtool profile hosted;

import Foundationˉdecimalˉparsing as Decimal;
import Runtimeˉnativeˉhostedˉverifierˉpublisherˉbaseˉfileˉtoolˉsupport as Support;
import Runtimeˉnativeˉhostedˉverifierˉpublisherˉbaseˉmetadata as Metadata;

capability file.read_bytes;
capability file.write_bytes;
capability process.argument;
capability process.argument_count;

fn Textˉequals(Left: text, Right: text) -> bool {
    let Leftˉbytes: bytes = Textˉtoˉutf8(Left);
    let Rightˉbytes: bytes = Textˉtoˉutf8(Right);
    let Length: u32 = Bytesˉlength(Leftˉbytes);
    if Length != Bytesˉlength(Rightˉbytes) { return false; }
    var Index: u32 = 0u32;
    while Index < Length {
        if Bytesˉreadˉu8(Leftˉbytes, Index) !=
            Bytesˉreadˉu8(Rightˉbytes, Index) {
            return false;
        }
        Index = Index + 1u32;
    }
    return true;
}

export fn Main() -> i32 {
    let Arguments: u32 = process.argument_count();
    if Arguments != 4u32 && Arguments != 5u32 { return 64; }
    var Base: u32 = 0u32;
    var Profile: u32 = 2u32;
    if Arguments == 5u32 {
        if Textˉequals(process.argument(0u32), "publisher-admission") {
            Profile = 8u32;
        } else {
            if !Textˉequals(process.argument(0u32), "wvo-inspector") {
                return 64;
            }
            Profile = 6u32;
        }
        Base = 1u32;
    }
    let Inputˉpath: text = process.argument(Base + 2u32);
    let Outputˉpath: text = process.argument(Base + 3u32);
    if Support.Pathsˉareˉequal(Inputˉpath, Outputˉpath) { return 64; }

    let Targetˉtext: bytes = Textˉtoˉutf8(process.argument(Base));
    let Entryˉtext: bytes = Textˉtoˉutf8(process.argument(Base + 1u32));
    let Target: Decimal.Foundationˉu32ˉparse =
        Decimal.Foundationˉu32ˉdecimalˉparse(
            Targetˉtext,
            0u32,
            Bytesˉlength(Targetˉtext)
        );
    let Entry: Decimal.Foundationˉu32ˉparse =
        Decimal.Foundationˉu32ˉdecimalˉparse(
            Entryˉtext,
            0u32,
            Bytesˉlength(Entryˉtext)
        );
    if !Target.Valid || !Entry.Valid { return 2; }

    let Result: Metadata.Nativeˉhostedˉverifierˉpublisherˉbaseˉmetadataˉresult =
        Metadata.Nativeˉhostedˉverifierˉpublisherˉbaseˉmetadataˉbuildˉforˉprofile(
            Target.Value,
            Profile,
            Entry.Value,
            file.read_bytes(Inputˉpath)
        );
    if !Result.Valid { return 2; }
    file.write_bytes(Outputˉpath, Result.Value);
    return 0;
}
