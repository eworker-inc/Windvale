module Nativeˉhostedˉverifierˉserviceˉbundleˉrequestˉtool profile hosted;

import Nativeˉhostedˉverifierˉserviceˉbundleˉrequest as Request;

capability console.write_line;
capability diagnostic.write_line;
capability file.read_bytes;
capability file.write_bytes;
capability process.argument;
capability process.argument_count;

enum Nativeˉhostedˉverifierˉbundleˉrequestˉstatus {
    Valid = 0;
    Rejected = 1;
}

fn Pathsˉareˉequal(Left: text, Right: text) -> bool {
    let Leftˉbytes: bytes = Textˉtoˉutf8(Left);
    let Rightˉbytes: bytes = Textˉtoˉutf8(Right);
    let Length: u32 = Bytesˉlength(Leftˉbytes);
    if Length != Bytesˉlength(Rightˉbytes) { return false; }
    var Index: u32 = 0u32;
    while Index < Length {
        if Bytesˉreadˉu8(Leftˉbytes, Index) !=
            Bytesˉreadˉu8(Rightˉbytes, Index) {
            return false;
        }
        Index = Index + 1u32;
    }
    return true;
}

fn Usage() -> i32 {
    diagnostic.write_line(
        "Usage: wvhostverifierbundle <fragment> <console> <argument-count> <argument> <file-input> <utf8> <diagnostic> <request.wvsq>"
    );
    diagnostic.write_line(
        "       wvhostverifierbundle <wvo-inspector|console-verifier> <fragment> <console> <argument-count> <argument> <file-input> <utf8> <diagnostic> <enum-name> <text-concat> <text-quote> <i32-format> <u32-format> <request.wvsq>"
    );
    return 64;
}

fn Reject() -> i32 {
    diagnostic.write_line(
        Textˉconcat(
            "verifier service-bundle request status=",
            Enumˉname(Nativeˉhostedˉverifierˉbundleˉrequestˉstatus.Rejected)
        )
    );
    return 2;
}

export fn Main() -> i32 {
    let Arguments: u32 = process.argument_count();
    if Arguments != 8u32 && Arguments != 14u32 { return Usage(); }
    var Base: u32 = 0u32;
    var Inputˉcount: u32 = 7u32;
    var Outputˉindex: u32 = 7u32;
    if Arguments == 14u32 {
        if !Pathsˉareˉequal(process.argument(0u32), "wvo-inspector") &&
            !Pathsˉareˉequal(process.argument(0u32), "console-verifier") {
            return Usage();
        }
        Base = 1u32;
        Inputˉcount = 12u32;
        Outputˉindex = 13u32;
    }
    let Outputˉpath: text = process.argument(Outputˉindex);
    var Index: u32 = 0u32;
    while Index < Inputˉcount {
        let Argumentˉindex: u32 = Base + Index;
        let Inputˉpath: text = process.argument(Argumentˉindex);
        if Pathsˉareˉequal(Inputˉpath, Outputˉpath) { return Usage(); }
        var Prior: u32 = 0u32;
        while Prior < Index {
            if Pathsˉareˉequal(
                Inputˉpath,
                process.argument(Base + Prior)
            ) {
                return Reject();
            }
            Prior = Prior + 1u32;
        }
        Index = Index + 1u32;
    }

    if Arguments == 14u32 {
        if Pathsˉareˉequal(process.argument(0u32), "console-verifier") {
            let Consoleˉresult =
                Request.Nativeˉhostedˉverifierˉserviceˉbundleˉrequestˉforˉconsoleˉverifier(
                    file.read_bytes(process.argument(1u32)),
                    file.read_bytes(process.argument(2u32)),
                    file.read_bytes(process.argument(3u32)),
                    file.read_bytes(process.argument(4u32)),
                    file.read_bytes(process.argument(5u32)),
                    file.read_bytes(process.argument(6u32)),
                    file.read_bytes(process.argument(7u32)),
                    file.read_bytes(process.argument(8u32)),
                    file.read_bytes(process.argument(9u32)),
                    file.read_bytes(process.argument(10u32)),
                    file.read_bytes(process.argument(11u32)),
                    file.read_bytes(process.argument(12u32))
                );
            if !Consoleˉresult.Valid { return Reject(); }
            file.write_bytes(Outputˉpath, Consoleˉresult.Value);
            console.write_line(
                Textˉconcat(
                    "verifier service-bundle request status=Valid bytes=",
                    U32ˉformat(Bytesˉlength(Consoleˉresult.Value))
                )
            );
            return 0;
        }
        let Inspectorˉresult =
            Request.Nativeˉhostedˉverifierˉserviceˉbundleˉrequestˉforˉwvoˉinspector(
                file.read_bytes(process.argument(1u32)),
                file.read_bytes(process.argument(2u32)),
                file.read_bytes(process.argument(3u32)),
                file.read_bytes(process.argument(4u32)),
                file.read_bytes(process.argument(5u32)),
                file.read_bytes(process.argument(6u32)),
                file.read_bytes(process.argument(7u32)),
                file.read_bytes(process.argument(8u32)),
                file.read_bytes(process.argument(9u32)),
                file.read_bytes(process.argument(10u32)),
                file.read_bytes(process.argument(11u32)),
                file.read_bytes(process.argument(12u32))
            );
        if !Inspectorˉresult.Valid { return Reject(); }
        file.write_bytes(Outputˉpath, Inspectorˉresult.Value);
        console.write_line(
            Textˉconcat(
                "verifier service-bundle request status=Valid bytes=",
                U32ˉformat(Bytesˉlength(Inspectorˉresult.Value))
            )
        );
        return 0;
    }
    let Result: Request.Nativeˉhostedˉverifierˉserviceˉbundleˉrequestˉresult =
        Request.Nativeˉhostedˉverifierˉserviceˉbundleˉrequest(
            file.read_bytes(process.argument(0u32)),
            file.read_bytes(process.argument(1u32)),
            file.read_bytes(process.argument(2u32)),
            file.read_bytes(process.argument(3u32)),
            file.read_bytes(process.argument(4u32)),
            file.read_bytes(process.argument(5u32)),
            file.read_bytes(process.argument(6u32))
        );
    if !Result.Valid { return Reject(); }
    file.write_bytes(Outputˉpath, Result.Value);
    console.write_line(
        Textˉconcat(
            "verifier service-bundle request status=Valid bytes=",
            U32ˉformat(Bytesˉlength(Result.Value))
        )
    );
    return 0;
}
