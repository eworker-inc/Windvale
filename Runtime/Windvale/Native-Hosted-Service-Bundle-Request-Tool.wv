module Nativeˉhostedˉserviceˉbundleˉrequestˉtool profile hosted;

import Compilerˉnativeˉpublication as Publication;
import Foundationˉdecimalˉparsing as Decimal;
import Foundationˉimmutableˉsourceˉregions as Sources;

capability console.write_line;
capability diagnostic.write_line;
capability file.read_bytes;
capability file.write_bytes;
capability process.argument;
capability process.argument_count;

enum Nativeˉhostedˉbundleˉrequestˉstatus {
    Valid = 0;
    Rejected = 1;
}

const SEGMENT_BYTES: u32 = 4194104u32;

fn Empty(Input: bytes) -> bytes {
    return Bytesˉslice(Input, 0u32, 0u32);
}

fn Appendˉu32(Output: bytes, Value: u32) -> bytes {
    return Bytesˉconcat(Output, Bytesˉfromˉu32ˉlittle(Value));
}

fn Maximum(Left: u32, Right: u32) -> u32 {
    if Left > Right { return Left; }
    return Right;
}

fn Minimum(Left: u32, Right: u32) -> u32 {
    if Left < Right { return Left; }
    return Right;
}

fn Bytesˉareˉequal(Left: bytes, Right: bytes) -> bool {
    let Length: u32 = Bytesˉlength(Left);
    if Length != Bytesˉlength(Right) { return false; }
    var Index: u32 = 0u32;
    while Index < Length {
        if Bytesˉreadˉu8(Left, Index) != Bytesˉreadˉu8(Right, Index) {
            return false;
        }
        Index = Index + 1u32;
    }
    return true;
}

fn Pathsˉareˉequal(Left: text, Right: text) -> bool {
    return Bytesˉareˉequal(Textˉtoˉutf8(Left), Textˉtoˉutf8(Right));
}

fn Serviceˉidentity(Index: u32) -> u32 {
    if Index < 8u32 { return Index + 1u32; }
    return Index + 3u32;
}

fn Reject() -> i32 {
    diagnostic.write_line(
        Textˉconcat(
            "hosted service-bundle request status=",
            Enumˉname(Nativeˉhostedˉbundleˉrequestˉstatus.Rejected)
        )
    );
    return 2;
}

fn Sourcesˉmatchˉplan(
    Request: bytes,
    Layout: bytes,
    Manifest: bytes,
    Plan: Sources.Immutableˉsourceˉregionˉplan
) -> bool {
    if Bytesˉlength(Request) != 144u32 || Bytesˉlength(Layout) != 152u32 ||
        Bytesˉreadˉu32ˉlittle(Layout, 12u32) != 0u32 ||
        Bytesˉreadˉu32ˉlittle(Layout, 28u32) != 10u32 ||
        !Plan.Valid || Plan.Regions != 11u32 ||
        Plan.Imageˉbytes != Bytesˉreadˉu32ˉlittle(Layout, 24u32) {
        return false;
    }
    let Fragmentˉbytes: u32 =
        Bytesˉreadˉu32ˉlittle(Layout, 20u32);
    var Expectedˉlogical: u32 = 0u32;
    var Index: u32 = 0u32;
    while Index < 11u32 {
        let Region: u32 = Plan.Regionˉbase + Index * 16u32;
        var Expectedˉimage: u32 = 0u32;
        var Expectedˉbytes: u32 = Fragmentˉbytes;
        if Index > 0u32 {
            let Requestˉrecord: u32 = 24u32 + (Index - 1u32) * 12u32;
            let Placement: u32 = 32u32 + (Index - 1u32) * 12u32;
            if Bytesˉreadˉu32ˉlittle(Request, Requestˉrecord) !=
                    Serviceˉidentity(Index - 1u32) ||
                Bytesˉreadˉu32ˉlittle(Layout, Placement) !=
                    Serviceˉidentity(Index - 1u32) {
                return false;
            }
            Expectedˉimage =
                Bytesˉreadˉu32ˉlittle(Layout, Placement + 4u32);
            Expectedˉbytes =
                Bytesˉreadˉu32ˉlittle(Layout, Placement + 8u32);
        }
        if Bytesˉreadˉu32ˉlittle(Manifest, Region) != Index ||
            Bytesˉreadˉu32ˉlittle(Manifest, Region + 4u32) !=
                Expectedˉlogical ||
            Bytesˉreadˉu32ˉlittle(Manifest, Region + 8u32) !=
                Expectedˉimage ||
            Bytesˉreadˉu32ˉlittle(Manifest, Region + 12u32) !=
                Expectedˉbytes {
            return false;
        }
        Expectedˉlogical = Expectedˉlogical + Expectedˉbytes;
        Index = Index + 1u32;
    }
    return Expectedˉlogical == Plan.Logicalˉbytes;
}

fn Payloadˉbytes(
    Manifest: bytes,
    Plan: Sources.Immutableˉsourceˉregionˉplan,
    Segmentˉstart: u32,
    Segmentˉend: u32
) -> u32 {
    var Total: u32 = 0u32;
    var Index: u32 = 0u32;
    while Index < Plan.Regions {
        let Region: u32 = Plan.Regionˉbase + Index * 16u32;
        let Imageˉstart: u32 =
            Bytesˉreadˉu32ˉlittle(Manifest, Region + 8u32);
        let Imageˉend: u32 = Imageˉstart +
            Bytesˉreadˉu32ˉlittle(Manifest, Region + 12u32);
        let Start: u32 = Maximum(Imageˉstart, Segmentˉstart);
        let End: u32 = Minimum(Imageˉend, Segmentˉend);
        if Start < End { Total = Total + End - Start; }
        Index = Index + 1u32;
    }
    return Total;
}

fn Appendˉregion(
    Output: bytes,
    Manifest: bytes,
    Prefix: text,
    Plan: Sources.Immutableˉsourceˉregionˉplan,
    Region: u32,
    Segmentˉstart: u32,
    Segmentˉend: u32
) -> Sources.Immutableˉsourceˉappend {
    let Record: u32 = Plan.Regionˉbase + Region * 16u32;
    let Logicalˉstart: u32 =
        Bytesˉreadˉu32ˉlittle(Manifest, Record + 4u32);
    let Imageˉstart: u32 =
        Bytesˉreadˉu32ˉlittle(Manifest, Record + 8u32);
    let Regionˉbytes: u32 =
        Bytesˉreadˉu32ˉlittle(Manifest, Record + 12u32);
    let Start: u32 = Maximum(Imageˉstart, Segmentˉstart);
    let End: u32 = Minimum(Imageˉstart + Regionˉbytes, Segmentˉend);
    if Start >= End {
        return Sources.Immutableˉsourceˉappend(true, Output, 0u32);
    }
    let Sourceˉstart: u32 = Logicalˉstart + Start - Imageˉstart;
    let Sourceˉbytes: u32 = End - Start;
    var Value: bytes = Output;
    var Appended: u32 = 0u32;
    var Chunk: u32 = 0u32;
    while Chunk < Plan.Chunks {
        let Part: Sources.Immutableˉsourceˉappend =
            Sources.Immutableˉsourceˉappendˉchunk(
                Value,
                Manifest,
                Chunk,
                file.read_bytes(
                    Sources.Immutableˉsourceˉresourceˉname(Prefix, Chunk)
                ),
                Sourceˉstart,
                Sourceˉbytes
            );
        if !Part.Valid {
            return Sources.Immutableˉsourceˉappend(false, Value, Appended);
        }
        Value = Part.Value;
        Appended = Appended + Part.Appendedˉbytes;
        Chunk = Chunk + 1u32;
    }
    return Sources.Immutableˉsourceˉappend(
        Appended == Sourceˉbytes, Value, Appended
    );
}

export fn Main() -> i32 {
    if process.argument_count() != 5u32 {
        diagnostic.write_line(
            "Usage: wvhostbundlerequest <plan.wvpq> <sources.wvsg> <chunk-prefix> <segment-index> <request.wvsq>"
        );
        return 64;
    }
    let Requestˉpath: text = process.argument(0u32);
    let Manifestˉpath: text = process.argument(1u32);
    let Prefix: text = process.argument(2u32);
    let Indexˉtext: bytes = Textˉtoˉutf8(process.argument(3u32));
    let Outputˉpath: text = process.argument(4u32);
    if Pathsˉareˉequal(Requestˉpath, Manifestˉpath) ||
        Pathsˉareˉequal(Requestˉpath, Outputˉpath) ||
        Pathsˉareˉequal(Manifestˉpath, Outputˉpath) ||
        !Sources.Immutableˉsourceˉprefixˉisˉvalid(Prefix) {
        return Reject();
    }
    let Parsed: Decimal.Foundationˉu32ˉparse =
        Decimal.Foundationˉu32ˉdecimalˉparse(
            Indexˉtext, 0u32, Bytesˉlength(Indexˉtext)
        );
    if !Parsed.Valid { return Reject(); }

    let Manifest: bytes = file.read_bytes(Manifestˉpath);
    let Plan: Sources.Immutableˉsourceˉregionˉplan =
        Sources.Immutableˉsourceˉregionsˉadmit(Manifest);
    if !Plan.Valid { return Reject(); }
    var Chunk: u32 = 0u32;
    while Chunk < Plan.Chunks {
        let Resourceˉpath: text =
            Sources.Immutableˉsourceˉresourceˉname(Prefix, Chunk);
        if Pathsˉareˉequal(Resourceˉpath, Requestˉpath) ||
            Pathsˉareˉequal(Resourceˉpath, Manifestˉpath) ||
            Pathsˉareˉequal(Resourceˉpath, Outputˉpath) ||
            !Sources.Immutableˉsourceˉresourceˉisˉvalid(
                Manifest, Chunk, file.read_bytes(Resourceˉpath)
            ) {
            return Reject();
        }
        Chunk = Chunk + 1u32;
    }

    let Publicationˉrequest: bytes = file.read_bytes(Requestˉpath);
    let Layout = Publication.Nativeˉpublicationˉplan(Publicationˉrequest);
    if !Sourcesˉmatchˉplan(
        Publicationˉrequest, Layout.Value, Manifest, Plan
    ) {
        return Reject();
    }
    let Imageˉbytes: u32 = Plan.Imageˉbytes;
    var Segments: u32 = Imageˉbytes / SEGMENT_BYTES;
    if Imageˉbytes % SEGMENT_BYTES != 0u32 { Segments = Segments + 1u32; }
    if Parsed.Value >= Segments { return Reject(); }
    let Segmentˉstart: u32 = Parsed.Value * SEGMENT_BYTES;
    var Segmentˉlength: u32 = Imageˉbytes - Segmentˉstart;
    if Segmentˉlength > SEGMENT_BYTES { Segmentˉlength = SEGMENT_BYTES; }
    let Segmentˉend: u32 = Segmentˉstart + Segmentˉlength;
    let Payload: u32 = Payloadˉbytes(
        Manifest, Plan, Segmentˉstart, Segmentˉend
    );
    let Total: u32 = 32u32 + Bytesˉlength(Publicationˉrequest) + Payload;
    if Total > 4194304u32 { return Reject(); }

    var Result: bytes = Empty(Publicationˉrequest);
    Result = Appendˉu32(Result, 1364416087u32);
    Result = Appendˉu32(Result, 2u32);
    Result = Appendˉu32(Result, Total);
    Result = Appendˉu32(Result, Bytesˉlength(Publicationˉrequest));
    Result = Appendˉu32(Result, Segmentˉstart);
    Result = Appendˉu32(Result, Segmentˉlength);
    Result = Appendˉu32(Result, Payload);
    Result = Appendˉu32(Result, 0u32);
    Result = Bytesˉconcat(Result, Publicationˉrequest);
    var Appended: u32 = 0u32;
    var Region: u32 = 0u32;
    while Region < Plan.Regions {
        let Part: Sources.Immutableˉsourceˉappend = Appendˉregion(
            Result,
            Manifest,
            Prefix,
            Plan,
            Region,
            Segmentˉstart,
            Segmentˉend
        );
        if !Part.Valid { return Reject(); }
        Result = Part.Value;
        Appended = Appended + Part.Appendedˉbytes;
        Region = Region + 1u32;
    }
    if Appended != Payload || Bytesˉlength(Result) != Total { return Reject(); }
    file.write_bytes(Outputˉpath, Result);
    console.write_line(
        Textˉconcat(
            Textˉconcat(
                Textˉconcat(
                    "hosted service-bundle request status=Valid segment=",
                    U32ˉformat(Parsed.Value)
                ),
                " bytes="
            ),
            U32ˉformat(Total)
        )
    );
    return 0;
}
