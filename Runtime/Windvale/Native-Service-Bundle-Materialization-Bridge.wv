#!wv/1 en@1
module Runtimeˉnativeˉserviceˉbundleˉmaterializationˉbridge;
profile core;
platform linux, windows, windvale;
authority application;


import Runtimeˉnativeˉserviceˉbundleˉmaterialization as Materialization;

export fn Main(Input: bytes) -> bytes {
    let Result: Materialization.Nativeˉserviceˉbundleˉmaterializationˉresult =
        Materialization.Nativeˉserviceˉbundleˉmaterialize(Input);
    return Result.Value;
}
