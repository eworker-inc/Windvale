windvale-assembly 1

# Linux x64 WVJP 1 publication owner. It is the only code in this candidate
# permitted to hold a raw mapping address or issue publication syscalls.
symbol local function Linux_baseline_jit_run_one in .text
symbol local function Linux_baseline_jit_seal_failure in .text
symbol export function Linux_baseline_jit_entry in .text
symbol import data Baseline_jit_lifetime_invalid
symbol import data Baseline_jit_lifetime_plan
symbol import function Baseline_jit_lifetime_verify
symbol import data Baseline_jit_plan_invalid
symbol import function Baseline_jit_plan_verify
symbol import function Baseline_jit_produce_bundle

section code .text align 16
define Linux_baseline_jit_run_one
push rbx
push r12
push r13
push r14
subtract_i32 rsp 136
move r12d r8d
move r13d r9d

# Give the Windvale producer one bounded RW/NX arena. Copy its admitted result
# into the private stack buffer, then release the arena before JIT publication.
xor edi edi
move_u32 esi 16777216
move_u32 edx 3
move_u32 r10d 34
xor r8 r8
subtract_i32 r8 1
xor r9d r9d
move_u32 eax 9
syscall
compare_i32 rax -4095
branch above_equal Producer_allocate_failed
move rbx rax

move r8 rbx
move rcx rsp
call Baseline_jit_produce_bundle
move r14d eax

move rdi rbx
move_u32 esi 16777216
move_u32 eax 11
syscall
test rax rax
branch not_equal Producer_release_failed
test r14d r14d
branch not_equal Invalid_bundle

move r14 rsp
add r14 r12
move r8 r14
call Baseline_jit_plan_verify
test eax eax
branch not_equal Invalid_plan

# mmap(NULL, 4096, PROT_READ | PROT_WRITE,
#      MAP_PRIVATE | MAP_ANONYMOUS, -1, 0)
xor edi edi
move_u32 esi 4096
move_u32 edx 3
move_u32 r10d 34
xor r8 r8
subtract_i32 r8 1
xor r9d r9d
move_u32 eax 9
syscall
compare_i32 rax -4095
branch above_equal Allocate_failed
move rbx rax

# Materialize exactly B8 <i32> C3 while the page is RW/NX.
move_u8 al 184
store_memory_u8 rbx none 1 0 al
load_memory_u32 eax r14 none 1 44
store_memory_u32 rbx none 1 1 eax
move_u8 al 195
store_memory_u8 rbx none 1 5 al

# mprotect(base, 4096, PROT_READ | PROT_EXEC)
move rdi rbx
move_u32 esi 4096
move_u32 edx 5
move_u32 eax 10
syscall
test rax rax
branch not_equal Seal_failed

call_register rbx
xor r12d r12d
compare eax r13d
branch equal Release
move_u32 r12d 4

label Release
move rdi rbx
move_u32 esi 4096
move_u32 eax 11
syscall
test rax rax
branch equal Complete
move_u32 r12d 5
label Complete
move eax r12d
add_i32 rsp 136
pop r14
pop r13
pop r12
pop rbx
return

label Seal_failed
move_u32 r12d 3
jump_label Release

label Allocate_failed
move_u32 eax 2
add_i32 rsp 136
pop r14
pop r13
pop r12
pop rbx
return

label Invalid_plan
move_u32 eax 11
add_i32 rsp 136
pop r14
pop r13
pop r12
pop rbx
return

label Invalid_bundle
move_u32 eax 1
add_i32 rsp 136
pop r14
pop r13
pop r12
pop rbx
return

label Producer_allocate_failed
move_u32 eax 9
add_i32 rsp 136
pop r14
pop r13
pop r12
pop rbx
return

label Producer_release_failed
move_u32 eax 10
add_i32 rsp 136
pop r14
pop r13
pop r12
pop rbx
return
end define

define Linux_baseline_jit_seal_failure
push rbx
push r12
xor edi edi
move_u32 esi 4096
move_u32 edx 3
move_u32 r10d 34
xor r8 r8
subtract_i32 r8 1
xor r9d r9d
move_u32 eax 9
syscall
compare_i32 rax -4095
branch above_equal Failure_allocate
move rbx rax

# An unaligned address must be rejected without changing this RW/NX mapping.
move rdi rbx
add_i32 rdi 1
move_u32 esi 4096
move_u32 edx 5
move_u32 eax 10
syscall
compare_i32 rax -4095
branch above_equal Expected_failure
move_u32 r12d 6
jump_label Failure_release

label Expected_failure
xor r12d r12d
label Failure_release
move rdi rbx
move_u32 esi 4096
move_u32 eax 11
syscall
test rax rax
branch equal Failure_complete
move_u32 r12d 7
label Failure_complete
move eax r12d
pop r12
pop rbx
return

label Failure_allocate
move_u32 eax 8
pop r12
pop rbx
return
end define

define Linux_baseline_jit_entry
push rbx

# Bind the host owner to the exact Windvale-authored WVLT 1 graph.
load_address r8 Baseline_jit_lifetime_plan
call Baseline_jit_lifetime_verify
test eax eax
branch equal Invalid_lifetime_case
move_u32 eax 10
jump_label Main_complete

label Invalid_lifetime_case
load_address r8 Baseline_jit_lifetime_invalid
call Baseline_jit_lifetime_verify
test eax eax
branch not_equal Invalid_patch_case
move_u32 eax 11
jump_label Main_complete

# Rejection occurs before any allocation call is reachable.
label Invalid_patch_case
load_address r8 Baseline_jit_plan_invalid
call Baseline_jit_plan_verify
test eax eax
branch not_equal Valid_cases
move_u32 eax 12
jump_label Main_complete

label Valid_cases
xor r8d r8d
move_u32 r9d 42
call Linux_baseline_jit_run_one
test eax eax
branch equal Negative_case
add_i32 eax 20
jump_label Main_complete

label Negative_case
move_u32 r8d 54
move_i32 r9d -1
call Linux_baseline_jit_run_one
test eax eax
branch equal Seal_failure_case
add_i32 eax 30
jump_label Main_complete

label Seal_failure_case
call Linux_baseline_jit_seal_failure
test eax eax
branch equal Main_success
add_i32 eax 40
jump_label Main_complete

label Main_success
xor eax eax
label Main_complete
pop rbx
return
end define
end section
