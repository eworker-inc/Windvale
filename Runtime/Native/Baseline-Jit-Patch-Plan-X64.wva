bytes 20 0 0 0 6 0 0 0 9 0 0 0 0 0 0 0
bytes 0 0 0 0 1 0 0 0 1 0 0 0
bytes 1 0 0 0 2 0 0 0 2 0 0 0
bytes 1 0 0 0 5 0 0 0 5 0 0 0
bytes 2 0 0 0 3 0 0 0 3 0 0 0
bytes 2 0 0 0 5 0 0 0 5 0 0 0
bytes 3 0 0 0 4 0 0 0 4 0 0 0
bytes 3 0 0 0 5 0 0 0 5 0 0 0
bytes 4 0 0 0 5 0 0 0 5 0 0 0
bytes 5 0 0 0 6 0 0 0 5 0 0 0
