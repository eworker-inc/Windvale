windvale-assembly 1

# Platform-neutral ABI-23 host for the Windvale model chat. The supervising
# launcher dedicates the worker's standard output to WVMQ requests and standard
# input to WVMC/WVMG responses. Separate platform leaves bind the user's real
# terminal for standard_output.write_v1 and terminal.line_read_v1.
symbol local data Model_gateway_host_identities in .rodata
symbol local function Model_gateway_host_output_provider in .text
symbol local function Model_gateway_host_provider in .text
symbol local function Model_gateway_host_terminal_provider in .text
symbol export function Model_gateway_host_entry in .text
symbol import function Main
symbol import function Model_gateway_platform_open
symbol import function Model_gateway_platform_read
symbol import function Model_gateway_platform_terminal_read
symbol import function Model_gateway_platform_terminal_write
symbol import function Model_gateway_platform_write

