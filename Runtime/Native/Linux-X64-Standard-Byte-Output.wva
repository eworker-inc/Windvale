windvale-assembly 1

# Linux standard-output byte leaf. It writes the exact supplied bytes through
# the already admitted runtime-private stdout descriptor and reports only the
# exact positively completed syscall prefix.
symbol export function Standard_output_platform_write in .text

section code .text align 16
define Standard_output_platform_write
push rbx
push r12
push r13
push r14
push r15
push r10
push r11
move r12 r8
move r13 r9
move r14d r10d
move r15 r11
xor eax eax
store_memory_u32 r15 none 1 0 eax

load_memory_u64 rbx r12 none 1 88
test rbx rbx
branch equal Standard_output_linux_failure
load_memory_u32 eax rbx none 1 0
compare_i32 eax 1330206295
branch not_equal Standard_output_linux_failure
load_memory_u32 eax rbx none 1 4
compare_i32 eax 1
branch not_equal Standard_output_linux_failure
load_memory_u32 eax rbx none 1 8
compare_i32 eax 48
branch not_equal Standard_output_linux_failure
load_memory_u32 eax rbx none 1 12
compare_i32 eax 2
branch not_equal Standard_output_linux_failure
load_memory_u32 eax rbx none 1 16
and_i32 eax 1
test eax eax
branch equal Standard_output_linux_failure
load_memory_u64 r12 rbx none 1 24
test r12 r12
branch equal Standard_output_linux_failure

label Standard_output_linux_next
test r14d r14d
branch equal Standard_output_linux_complete
move rdi r12
move rsi r13
move edx r14d
move_u32 eax 1
syscall
compare_i32 rax -4
branch equal Standard_output_linux_next
compare_i32 rax -4095
branch above_equal Standard_output_linux_failure
test rax rax
branch equal Standard_output_linux_failure
compare rax r14
branch above Standard_output_linux_failure
add r13 rax
subtract r14 rax
load_memory_u32 ecx r15 none 1 0
add ecx eax
store_memory_u32 r15 none 1 0 ecx
jump_label Standard_output_linux_next

label Standard_output_linux_complete
xor eax eax
jump_label Standard_output_linux_return
label Standard_output_linux_failure
move_u32 eax 1
label Standard_output_linux_return
pop r11
pop r10
pop r15
pop r14
pop r13
pop r12
pop rbx
return
end define
end section
