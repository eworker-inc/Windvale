jump_label Status
label Closed
move_u32 eax 9
label Status
store_memory_u32 r13 none 1 64 eax
label Finish
add_i32 rsp 376
pop r11
pop r10
pop r15
pop r14
pop r13
pop r12
pop rdi
pop rsi
pop rbp
pop rbx
return
label Invalid_extent
move_u32 eax 1
jump_label Finish
label Invalid_pointer
move_u32 eax 1
return
label Invariant
# Serialized complete preflight makes local release/teardown infallible.
trap
jump_label Invariant
end define
define Request_reset
move r9 rsp
add_i32 r9 40
xor eax eax
xor ecx ecx
label Clear
store_memory_u64 r9 rcx 1 0 rax
add_i32 ecx 8
compare_i32 ecx 96
branch below Clear
move_u32 eax 1
store_memory_u32 r9 none 1 0 eax
move_u32 eax 96
store_memory_u32 r9 none 1 4 eax
load_memory_u64 rax r12 none 1 24
store_memory_u64 r9 none 1 16 rax
move r8 r14
return
end define
end section
