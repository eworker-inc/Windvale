windvale-assembly 1

# Read-only validation of the existing 2616-byte accounting state. This is the
# native counterpart of Memory_budget_state_is_valid, not a second token format.
# R8 points to a complete mapped state. EAX=0 valid, 5 invalid. Preserve all
# nonvolatile registers and R10/R11. No allocation or host calls.
# Per-call child totals use 592 scratch bytes; saved registers bring the leaf
# stack extent to 632 bytes. No validation trust survives the call.
symbol export function Windvale_memory_budget_validate in .text
section code .text align 16
define Windvale_memory_budget_validate
push rbx
push rsi
push rdi
push r10
push r11
subtract_i32 rsp 592
move rbx r8
test rbx rbx
branch equal Invalid
load_memory_u32 eax rbx none 1 0
compare_i32 eax 1112364631
branch not_equal Invalid
load_memory_u32 eax rbx none 1 4
compare_i32 eax 1
branch not_equal Invalid
load_memory_u32 eax rbx none 1 8
compare_i32 eax 65
branch not_equal Invalid
load_memory_u32 eax rbx none 1 12
compare_i32 eax 1
branch not_equal Invalid

# Validate every parent index before following any ancestor chain.
# R11 bounds later accounting scans only after the complete structure has
# proved every later entry inactive. Retired generations remain permitted.
move_u32 r11d 1
move_u32 edi 1
move rsi rbx
add_i32 rsi 16
label Structure
load_memory_u32 eax rsi none 1 8
compare_i32 eax 1
branch above Invalid
load_memory_u32 ecx rsi none 1 12
compare ecx eax
branch above Invalid
test eax eax
branch not_equal Active
# Active and owner were already proved zero. Check every remaining field
# except the retained generation without a per-word loop.
load_memory_u32 eax rsi none 1 4
load_memory_u64 rcx rsi none 1 16
or rax rcx
load_memory_u64 rcx rsi none 1 24
or rax rcx
load_memory_u64 rcx rsi none 1 32
or rax rcx
test rax rax
branch not_equal Invalid
jump_label Structure_next
label Active
move r11d edi
load_memory_u32 eax rsi none 1 0
test eax eax
branch equal Invalid
load_memory_u32 eax rsi none 1 4
compare_i32 edi 1
branch not_equal Child
test eax eax
branch not_equal Invalid
jump_label Limits
label Child
test eax eax
branch equal Invalid
compare_i32 eax 65
branch above Invalid
subtract_i32 eax 1
move r10d eax
shift_left eax 5
shift_left r10d 3
add eax r10d
load_memory_u32 ecx rbx rax 1 24
compare_i32 ecx 1
branch not_equal Invalid
label Limits
load_memory_u64 rax rsi none 1 32
load_memory_u64 rcx rsi none 1 24
compare rax rcx
branch above Invalid
load_memory_u32 eax rsi none 1 20
load_memory_u32 ecx rsi none 1 16
compare eax ecx
branch above Invalid
label Structure_next
add_i32 edi 1
add_i32 rsi 40
compare_i32 edi 65
branch below_equal Structure

# The complete structure pass proved every active parent index before lookup.
# Accumulate each child's maximum and count once; all scratch expires here.
compare_i32 r11d 1
branch not_equal Aggregate
# Every other entry is inactive; the root must have no children or reservation.
load_memory_u64 rax rbx none 1 48
load_memory_u32 ecx rbx none 1 36
or rax rcx
branch not_equal Invalid
xor eax eax
jump_label Finish
label Aggregate
xor eax eax
xor ecx ecx
move r10d r11d
shift_left r10d 3
label Clear_sums
store_memory_u64 rsp rcx 1 0 rax
add_i32 ecx 8
compare ecx r10d
branch below Clear_sums
xor ecx ecx
label Clear_counts
store_memory_u64 rsp rcx 1 520 rax
add_i32 ecx 8
compare ecx r11d
branch below Clear_counts
move_u32 edi 2
move rsi rbx
add_i32 rsi 56
label Accumulate_children
compare edi r11d
branch above Accounting_start
load_memory_u32 eax rsi none 1 8
test eax eax
branch equal Accumulate_next
load_memory_u32 edx rsi none 1 4
subtract_i32 edx 1
load_memory_u64 rax rsi none 1 24
load_memory_u64 r8 rsp rdx 8 0
add r8 rax
branch below Invalid
store_memory_u64 rsp rdx 8 0 r8
xor ecx ecx
load_memory_u8 cl rsp rdx 1 520
add_i32 ecx 1
store_memory_u8 rsp rdx 1 520 cl
label Accumulate_next
add_i32 edi 1
add_i32 rsi 40
jump_label Accumulate_children
label Accounting_start
move_u32 edi 1
move rsi rbx
add_i32 rsi 16
label Accounting
load_memory_u32 eax rsi none 1 8
test eax eax
branch equal Accounting_next
load_memory_u32 eax rsi none 1 4
xor ecx ecx
label Ancestors
test eax eax
branch equal Children
compare eax edi
branch equal Invalid
add_i32 ecx 1
compare_i32 ecx 65
branch above Invalid
subtract_i32 eax 1
move r10d eax
shift_left eax 5
shift_left r10d 3
add eax r10d
load_memory_u32 eax rbx rax 1 20
jump_label Ancestors
label Children
move eax edi
subtract_i32 eax 1
load_memory_u64 r8 rsp rax 8 0
xor ecx ecx
load_memory_u8 cl rsp rax 1 520
load_memory_u64 rax rsi none 1 32
compare rax r8
branch not_equal Invalid
load_memory_u32 eax rsi none 1 20
compare eax ecx
branch not_equal Invalid
label Accounting_next
add_i32 edi 1
add_i32 rsi 40
compare edi r11d
branch below_equal Accounting
xor eax eax
jump_label Finish
label Invalid
move_u32 eax 5
label Finish
add_i32 rsp 592
pop r11
pop r10
pop rdi
pop rsi
pop rbx
return
end define
end section
