# Internal bounded scans over exactly 5,952 bytes of fresh metadata.
define Metadata_zero_check
label Region
load_memory_u64 rcx rsp rsi 1 8
load_memory_u64 rdx rsp rsi 1 16
label Cell
load_memory_u64 rax rcx none 1 0
test rax rax
branch not_equal Nonzero
add_i32 rcx 8
compare rcx rdx
branch below Cell
add_i32 esi 16
compare_i32 esi 176
branch below Region
xor eax eax
return
label Nonzero
move_u32 eax 1
return
end define

define Metadata_clear
label Region
load_memory_u64 rcx rsp rsi 1 8
load_memory_u64 rdx rsp rsi 1 16
label Cell
xor eax eax
store_memory_u64 rcx none 1 0 rax
add_i32 rcx 8
compare rcx rdx
branch below Cell
add_i32 esi 16
compare_i32 esi 176
branch below Region
xor eax eax
return
end define

