move_u32 eax 136
store_memory_u32 rsp none 1 36 eax
move rax rsp
add_i32 rax 168
store_memory_u64 rsp none 1 160 rax

# Exact one-entry WVPT 1 table and canonical storage.random_access_v1 identity.
