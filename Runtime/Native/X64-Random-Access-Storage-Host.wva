windvale-assembly 1

# Platform-neutral ABI-23 owner for one rights-limited mutable storage object.
# The platform shell opens exactly one configured object before Windvale code
# runs. Source receives only the target/state pair in WVPT 1; it never receives
# a path, native handle, or ambient filesystem authority.
symbol local function Storage_host_provider in .text
symbol export function Storage_host_entry in .text
symbol import function Main
symbol import function Storage_platform_close
symbol import function Storage_platform_flush
symbol import function Storage_platform_open
symbol import function Storage_platform_read
symbol import function Storage_platform_resize
symbol import function Storage_platform_write

section code .text align 16
define Storage_host_entry
push rbx
move rbx rdx

# Reserve and probe a 65,920-byte execution-owned frame. The staged fragment is
# RX, so mutable provider scratch cannot live in its object zero-fill section.
# Touching each descending page also respects the Windows stack guard contract.
xor rax rax
xor ecx ecx
subtract_i32 rsp 384
store_memory_u64 rsp none 1 0 rax
label Storage_host_entry_probe
