move rax rsp
add_i32 rax 272
store_memory_u64 rsp none 1 216 rax
move_u32 eax 24
store_memory_u32 rsp none 1 224 eax
move_u32 eax 1919906931
store_memory_u32 rsp none 1 228 eax
move_u32 eax 778397537
store_memory_u32 rsp none 1 232 eax
move_u32 eax 1684955506
store_memory_u32 rsp none 1 236 eax
move_u32 eax 1633643887
