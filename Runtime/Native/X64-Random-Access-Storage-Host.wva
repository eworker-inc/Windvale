move_u32 eax 84544005
store_memory_u32 rsp none 1 256 eax
move_u32 eax 1542
store_memory_u16 rsp none 1 260 ax

# Generation 1 is a process-lifetime writer fence. The platform leaf opens one
# fixed object, acquires its writer lease, and publishes its current length.
move r8 rsp
add_i32 r8 272
move_u32 eax 1
store_memory_u64 r8 none 1 16 rax
xor eax eax
store_memory_u32 r8 none 1 24 eax
store_memory_u64 r8 none 1 65616 rbx
call Storage_platform_open
test eax eax
branch not_equal Storage_host_entry_open_failure

xor rcx rcx
move rdx rsp
add_i32 rdx 32
move r8 rdx
xor r9 r9
call Main
move rbx rax

move r8 rsp
add_i32 r8 272
call Storage_platform_close
test rbx rbx
branch not_equal Storage_host_entry_main_failure
test eax eax
