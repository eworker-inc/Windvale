load_memory_u32 r15d r8 none 1 24
test r10d r10d
branch equal Storage_windows_resolve_failure
test r15d r15d
branch equal Storage_windows_resolve_failure
compare_i32 r10d 65536
branch above Storage_windows_resolve_failure
compare_i32 r15d 65536
branch above Storage_windows_resolve_failure

# Validate and materialize the function, name, and ordinal tables.
load_memory_u32 eax r8 none 1 28
move ecx r10d
