windvale-assembly 1

# Windows x64 leaf for one fixed database object. The hosted container already
# owns the admitted KERNEL32 import table. This leaf reuses its immutable file
# tables and resolves only two same-module positioning exports from the already
# admitted CreateFileW address; it creates no second ambient import boundary.
symbol local data Storage_windows_name_set_end_of_file in .rodata
symbol local data Storage_windows_name_set_file_pointer in .rodata
