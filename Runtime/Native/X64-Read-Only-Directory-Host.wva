windvale-assembly 1

# Platform-neutral ABI-23 owner for one rights-reduced directory entry. The
# platform leaf opens exactly Windvale-Database-Storage.bin read-only before
# Windvale source runs. Source receives only filesystem.directory_read_v1 and
# never receives a native path, directory handle, or write authority.
symbol local data Directory_host_file_name in .rodata
symbol local data Directory_host_identities in .rodata
symbol local function Directory_host_provider in .text
symbol export function Directory_host_entry in .text
symbol import function Directory_platform_close
symbol import function Directory_platform_open
symbol import function Directory_platform_read
symbol import function Main

section code .text align 16
define Directory_host_entry
push rbx
move rbx rdx
subtract_i32 rsp 4096

# Clear the complete execution-owned context, table, provider state, and
# response scratch before deriving context 9 from the admitted context 7.
xor rax rax
xor ecx ecx
label Directory_host_entry_clear
compare_i32 ecx 4096
branch above_equal Directory_host_entry_copy
store_memory_u64 rsp rcx 1 0 rax
add_i32 ecx 8
jump_label Directory_host_entry_clear

label Directory_host_entry_copy
xor ecx ecx
label Directory_host_entry_copy_next
compare_i32 ecx 112
branch above_equal Directory_host_entry_context
load_memory_u64 rax rbx rcx 1 0
store_memory_u64 rsp rcx 1 32 rax
add_i32 ecx 8
jump_label Directory_host_entry_copy_next

label Directory_host_entry_context
move_u32 eax 9
store_memory_u32 rsp none 1 32 eax
move_u32 eax 136
store_memory_u32 rsp none 1 36 eax
move rax rsp
add_i32 rax 168
store_memory_u64 rsp none 1 160 rax

# Exact five-entry WVPT 1 table copied from the admitted WVDB capability
# directory. Only ordinal two is selected; fixed services retain zero target
# and state values. Identity bytes are immutable rodata copied into this
# execution-owned table before Main.
move_u32 eax 1414551127
store_memory_u32 rsp none 1 168 eax
move_u32 eax 1
store_memory_u32 rsp none 1 172 eax
move_u32 eax 308
store_memory_u32 rsp none 1 176 eax
move_u32 eax 5
store_memory_u32 rsp none 1 180 eax
move_u32 eax 4
store_memory_u32 rsp none 1 184 eax
move_u32 eax 24
store_memory_u32 rsp none 1 188 eax
move_u32 eax 156
store_memory_u32 rsp none 1 192 eax

move_u32 eax 152
store_memory_u32 rsp none 1 200 eax
move_u32 eax 28
store_memory_u32 rsp none 1 204 eax
move_u32 eax 180
store_memory_u32 rsp none 1 224 eax
move_u32 eax 31
store_memory_u32 rsp none 1 228 eax
move_u32 eax 211
store_memory_u32 rsp none 1 248 eax
move_u32 eax 40
store_memory_u32 rsp none 1 252 eax
load_address rax Directory_host_provider
store_memory_u64 rsp none 1 256 rax
move rax rsp
add_i32 rax 480
store_memory_u64 rsp none 1 264 rax
move_u32 eax 251
store_memory_u32 rsp none 1 272 eax
move_u32 eax 26
store_memory_u32 rsp none 1 276 eax
move_u32 eax 277
store_memory_u32 rsp none 1 296 eax
move_u32 eax 31
store_memory_u32 rsp none 1 300 eax

# Retain the admitted host context only in private provider state for the
# Windows read-only leaf's already-admitted import table.
move rax rsp
add_i32 rax 480
store_memory_u64 rax none 1 3144 rbx
load_address rbx Directory_host_identities
move rdx rsp
add_i32 rdx 320
xor ecx ecx
label Directory_host_entry_identity_copy
compare_i32 ecx 156
branch above_equal Directory_host_entry_open
load_memory_u8 al rbx rcx 1 0
store_memory_u8 rdx rcx 1 0 al
add_i32 ecx 1
jump_label Directory_host_entry_identity_copy

label Directory_host_entry_open
move r8 rsp
add_i32 r8 480
call Directory_platform_open
move r8 rsp
add_i32 r8 480
test eax eax
branch equal Directory_host_entry_main
move_u32 eax 4
store_memory_u32 r8 none 1 28 eax

label Directory_host_entry_main
xor rcx rcx
move rdx rsp
add_i32 rdx 32
move r8 rdx
xor r9 r9
call Main
move rbx rax

move r8 rsp
add_i32 r8 480
load_memory_u32 eax r8 none 1 28
test eax eax
branch not_equal Directory_host_entry_return_main
call Directory_platform_close
test eax eax
branch equal Directory_host_entry_return_main
test rbx rbx
branch not_equal Directory_host_entry_return_main
move_u32 ebx 71

label Directory_host_entry_return_main
move rax rbx
add_i32 rsp 4096
pop rbx
return
end define

define Directory_host_provider
# Preserve both permanent host ABIs and generated execution budgets across the
# rights-limited platform read.
push rbx
push rbp
push rsi
push rdi
push r12
push r13
push r14
push r10
push r11
push r15
subtract_i32 rsp 40
move r12 rcx
move r13 r8
move r14 r9

test r12 r12
branch equal Directory_host_provider_abi_failure
test r13 r13
branch equal Directory_host_provider_abi_failure
test r14 r14
branch equal Directory_host_provider_abi_failure
compare_i32 edx 3
branch not_equal Directory_host_provider_abi_failure
move rax r15
add_i32 rax 448
compare r13 rax
branch not_equal Directory_host_provider_abi_failure

# Revalidate all three complete argument cells. The generated descriptor is
# borrowed for this call only; u32 padding must remain zero.
load_memory_u64 rsi r14 none 1 0
load_memory_u64 rax r14 none 1 8
compare_i32 eax 29
branch not_equal Directory_host_provider_invalid_request
shift_right rax 32
test rax rax
branch not_equal Directory_host_provider_invalid_request
test rsi rsi
branch equal Directory_host_provider_invalid_request
load_memory_u32 ebp r14 none 1 16
load_memory_u32 eax r14 none 1 20
test eax eax
branch not_equal Directory_host_provider_invalid_request
load_memory_u64 rax r14 none 1 24
test rax rax
branch not_equal Directory_host_provider_invalid_request
load_memory_u32 edi r14 none 1 32
load_memory_u32 eax r14 none 1 36
test eax eax
branch not_equal Directory_host_provider_invalid_request
load_memory_u64 rax r14 none 1 40
test rax rax
branch not_equal Directory_host_provider_invalid_request
compare_i32 edi 3072
branch above Directory_host_provider_invalid_request
move eax ebp
add eax edi
branch below Directory_host_provider_invalid_request

# Construct the fixed WVDR 1 prefix in state-owned response scratch.
move r8 r13
add_i32 r8 32
move_u32 eax 1380210263
store_memory_u32 r8 none 1 0 eax
move_u32 eax 1
store_memory_u32 r8 none 1 4 eax
xor eax eax
store_memory_u32 r8 none 1 8 eax
load_memory_u32 eax r13 none 1 8
store_memory_u32 r8 none 1 12 eax
store_memory_u32 r8 none 1 16 ebp
xor eax eax
store_memory_u32 r8 none 1 20 eax

load_memory_u32 eax r13 none 1 28
test eax eax
branch equal Directory_host_provider_name
compare_i32 eax 3
branch equal Directory_host_provider_denied
jump_label Directory_host_provider_unavailable

label Directory_host_provider_name
load_address rbx Directory_host_file_name
xor ecx ecx
label Directory_host_provider_name_next
compare_i32 ecx 29
branch above_equal Directory_host_provider_geometry
load_memory_u8 al rsi rcx 1 0
load_memory_u8 dl rbx rcx 1 0
compare al dl
branch not_equal Directory_host_provider_not_found
add_i32 ecx 1
jump_label Directory_host_provider_name_next

label Directory_host_provider_geometry
load_memory_u32 eax r13 none 1 8
compare ebp eax
branch above Directory_host_provider_invalid_offset
subtract eax ebp
compare eax edi
branch below Directory_host_provider_chunk_ready
move eax edi
label Directory_host_provider_chunk_ready
store_memory_u32 r8 none 1 20 eax
test eax eax
branch equal Directory_host_provider_publish
xor ecx ecx
store_memory_u32 r13 none 1 24 ecx
move r8 r13
move r9 rbp
move r10d eax
move r11 r13
add_i32 r11 56
call Directory_platform_read
test eax eax
branch not_equal Directory_host_provider_unavailable_after_read
move r8 r13
add_i32 r8 32
load_memory_u32 eax r13 none 1 24
load_memory_u32 ecx r8 none 1 20
compare eax ecx
branch not_equal Directory_host_provider_unavailable_after_read
jump_label Directory_host_provider_publish

label Directory_host_provider_not_found
move_u32 eax 1
jump_label Directory_host_provider_failure
label Directory_host_provider_denied
move_u32 eax 3
jump_label Directory_host_provider_failure
label Directory_host_provider_unavailable_after_read
move r8 r13
add_i32 r8 32
label Directory_host_provider_unavailable
move_u32 eax 4
label Directory_host_provider_failure
store_memory_u32 r8 none 1 8 eax
xor eax eax
store_memory_u32 r8 none 1 12 eax
store_memory_u32 r8 none 1 20 eax
jump_label Directory_host_provider_publish

label Directory_host_provider_invalid_offset
move_u32 eax 8
store_memory_u32 r8 none 1 8 eax
jump_label Directory_host_provider_publish

label Directory_host_provider_invalid_request
move_u32 eax 1
jump_label Directory_host_provider_complete

label Directory_host_provider_publish
load_memory_u32 ebx r8 none 1 20
add_i32 ebx 24
store_memory_u64 r12 none 1 0 r8
store_memory_u32 r12 none 1 8 ebx
xor eax eax
store_memory_u32 r12 none 1 12 eax
jump_label Directory_host_provider_complete

label Directory_host_provider_abi_failure
move_u32 eax 1

label Directory_host_provider_complete
add_i32 rsp 40
pop r15
pop r11
pop r10
pop r14
pop r13
pop r12
pop rdi
pop rsi
pop rbp
pop rbx
return
end define
end section

