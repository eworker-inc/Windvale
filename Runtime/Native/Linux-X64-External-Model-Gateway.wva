windvale-assembly 1

# Linux x64 leaf for the supervisor-dedicated model worker pipes plus one
# independently opened /dev/tty endpoint for visible user input and output.
# The terminal descriptor never carries WVMQ/WVMC traffic.
symbol local data Model_gateway_linux_tty_path in .rodata
symbol export function Model_gateway_platform_open in .text
symbol export function Model_gateway_platform_read in .text
symbol export function Model_gateway_platform_terminal_read in .text
symbol export function Model_gateway_platform_terminal_write in .text
symbol export function Model_gateway_platform_write in .text

section code .text align 16
define Model_gateway_platform_open
move_u32 eax 0
store_memory_u64 r8 none 1 0 rax
move_u32 eax 1
store_memory_u64 r8 none 1 8 rax
push rdi
push rsi
move_i32 eax -1
store_memory_u64 r8 none 1 16 rax
move_i32 edi -100
load_address rsi Model_gateway_linux_tty_path
move_u32 edx 2
xor r10d r10d
move_u32 eax 257
syscall
compare_i32 rax -4095
branch above_equal Model_gateway_linux_open_failure
store_memory_u64 r8 none 1 16 rax
xor eax eax
pop rsi
pop rdi
return
label Model_gateway_linux_open_failure
xor eax eax
pop rsi
pop rdi
return
end define

define Model_gateway_platform_read
push rdi
push rsi
push r12
push r13
push r14
move r12 r9
move r13d r10d
load_memory_u64 r14 r8 none 1 0
label Model_gateway_linux_read_next
test r13d r13d
branch equal Model_gateway_linux_read_complete
move rdi r14
move rsi r12
move edx r13d
xor eax eax
syscall
compare_i32 rax -4
branch equal Model_gateway_linux_read_next
compare_i32 rax -4095
branch above_equal Model_gateway_linux_read_failure
test rax rax
branch equal Model_gateway_linux_read_failure
compare rax r13
branch above Model_gateway_linux_read_failure
add r12 rax
subtract r13 rax
jump_label Model_gateway_linux_read_next
label Model_gateway_linux_read_complete
xor eax eax
jump_label Model_gateway_linux_read_return
label Model_gateway_linux_read_failure
move_u32 eax 1
label Model_gateway_linux_read_return
pop r14
pop r13
pop r12
pop rsi
pop rdi
return
end define

define Model_gateway_platform_write
push rdi
push rsi
push r12
push r13
push r14
move r12 r9
move r13d r10d
load_memory_u64 r14 r8 none 1 8
label Model_gateway_linux_write_next
