end define

define Model_gateway_platform_terminal_read
push rbx
push rbp
push rdi
push rsi
push r12
push r13
push r14
push r15
subtract_i32 rsp 16
move r12 r8
move r13 r9
move r14d r10d
move r15 r11
xor ebx ebx
xor ebp ebp
store_memory_u32 r15 none 1 0 ebx

label Model_gateway_linux_terminal_read_next
load_memory_u64 rdi r12 none 1 16
compare_i32 rdi -1
branch equal Model_gateway_linux_terminal_read_lost
move rsi rsp
move_u32 edx 1
xor eax eax
syscall
compare_i32 rax -4
branch equal Model_gateway_linux_terminal_read_interrupted
compare_i32 rax -4095
branch above_equal Model_gateway_linux_terminal_read_lost
test rax rax
branch equal Model_gateway_linux_terminal_read_eof
compare_i32 rax 1
branch not_equal Model_gateway_linux_terminal_read_lost
load_memory_u8 al rsp none 1 0
