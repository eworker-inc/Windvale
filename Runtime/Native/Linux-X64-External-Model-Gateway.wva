compare_i32 rax -4
branch equal Model_gateway_linux_write_next
compare_i32 rax -4095
branch above_equal Model_gateway_linux_write_failure
test rax rax
branch equal Model_gateway_linux_write_failure
compare rax r13
branch above Model_gateway_linux_write_failure
add r12 rax
subtract r13 rax
jump_label Model_gateway_linux_write_next
label Model_gateway_linux_write_complete
xor eax eax
jump_label Model_gateway_linux_write_return
label Model_gateway_linux_write_failure
move_u32 eax 1
label Model_gateway_linux_write_return
pop r14
pop r13
pop r12
pop rsi
pop rdi
