label Model_gateway_linux_terminal_read_interrupted
move_u32 eax 2
jump_label Model_gateway_linux_terminal_read_return

label Model_gateway_linux_terminal_read_reject_start
move_u32 ebp 1
label Model_gateway_linux_terminal_read_drain
compare_i32 ebp 65536
branch above_equal Model_gateway_linux_terminal_read_lost
load_memory_u64 rdi r12 none 1 16
compare_i32 rdi -1
branch equal Model_gateway_linux_terminal_read_lost
move rsi rsp
move_u32 edx 1
xor eax eax
syscall
compare_i32 rax -4
branch equal Model_gateway_linux_terminal_read_interrupted
compare_i32 rax -4095
branch above_equal Model_gateway_linux_terminal_read_lost
test rax rax
branch equal Model_gateway_linux_terminal_read_lost
compare_i32 rax 1
branch not_equal Model_gateway_linux_terminal_read_lost
load_memory_u8 al rsp none 1 0
add_i32 ebp 1
compare_i8 al 10
branch not_equal Model_gateway_linux_terminal_read_drain
move_u32 eax 3
jump_label Model_gateway_linux_terminal_read_return

label Model_gateway_linux_terminal_read_lost
move_u32 eax 4
label Model_gateway_linux_terminal_read_return
add_i32 rsp 16
pop r15
pop r14
pop r13
pop r12
pop rsi
pop rdi
pop rbp
pop rbx
return
end define

