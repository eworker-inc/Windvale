compare_i32 rsi 2047
branch above Target_limit
xor eax eax
store_memory_u64 rsp none 1 112 rax
move_u32 eax 11
store_memory_u32 rsp none 1 40 eax
load_memory_u64 rax rbx none 1 0
store_memory_u64 rsp none 1 56 rax
move eax esi
shift_left eax 3
add_i32 eax 8
store_memory_u32 rsp none 1 44 eax
store_memory_u32 rsp none 1 68 eax
move_u32 eax 16
store_memory_u32 rsp none 1 64 eax
move eax edi
shift_left eax 3
add_i32 eax 8
store_memory_u32 rsp none 1 120 eax
load_memory_u64 r8 r15 none 1 112
move r9 rsp
add_i32 r9 32
load_memory_u64 rax r15 none 1 120
call_register rax
test eax eax
branch equal Valid
compare_i32 eax 2
branch equal Exhausted
compare_i32 eax 3
branch equal Fragmented
compare_i32 eax 6
branch not_equal Invalid
move_u32 eax 3
jump_label Failure
label Exhausted
move_u32 eax 1
jump_label Failure
label Fragmented
move_u32 eax 4
jump_label Failure
label Overflow
move_u32 edx 4294967295
move rax rdx
shift_left rdx 32
or rdx rax
label Target_limit
store_memory_u64 r12 none 1 48 rdx
move_u32 eax 2
label Failure
store_memory_u64 r12 none 1 32 rax
store_memory_u64 r12 none 1 64 rbp
move_u32 eax 1
store_memory_u64 r12 none 1 0 rax
move rax r12
add_i32 rax 32
store_memory_u64 r12 none 1 16 rax
jump_label Success
label Valid
load_memory_u64 rax rsp none 1 56
store_memory_u64 rbx none 1 0 rax
load_memory_u64 rdx rsp none 1 80
store_memory_u32 rdx none 1 4 esi
xor eax eax
store_memory_u64 r12 none 1 0 rax
store_memory_u64 r12 none 1 16 rax
label Success
xor eax eax
jump_label Finished
label Invalid
move_u32 eax 1
label Finished
add_i32 rsp 136
pop rdi
pop rsi
pop rbp
pop rbx
pop r13
pop r12
return
end define

# Initialize and execute a query in the caller's 128-byte request frame.
# R13 carries the budget owner. The extra return address accounts for +8.
define Memory_call
xor eax eax
move_u32 ecx 40
label Clear
store_memory_u64 rsp rcx 1 0 rax
add_i32 ecx 8
compare_i32 ecx 136
branch below Clear
move_u32 eax 1
store_memory_u32 rsp none 1 40 eax
move_u32 eax 96
store_memory_u32 rsp none 1 44 eax
move_u32 eax 8
store_memory_u32 rsp none 1 48 eax
store_memory_u64 rsp none 1 104 r13
load_memory_u64 r8 r15 none 1 112
load_memory_u64 rax r8 none 1 32
store_memory_u64 rsp none 1 56 rax
move r9 rsp
add_i32 r9 40
load_memory_u64 rax r15 none 1 120
# Tail call retains the caller's aligned shadow space and return address.
jump_register rax
end define
end section
