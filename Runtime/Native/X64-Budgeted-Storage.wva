windvale-assembly 1

# Connects canonical accounting state to owned physical storage. R8 points to
# 1088 bytes of exclusive binding state; R9 points to a 96-byte request.
# No publication occurs until both accounting and physical preflight succeed.
# See Windvale-Native-Budgeted-Storage.md. All nonvolatile and budget registers
# are preserved. The caller owns and maps every complete disjoint extent.
symbol export function Windvale_budgeted_storage in .text
symbol import function Windvale_memory_budget_validate
