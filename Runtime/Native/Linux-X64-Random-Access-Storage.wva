windvale-assembly 1

# Linux x64 leaf for one fixed database object. Only this module holds the raw
# file descriptor or issues storage syscalls. Its open-time flock is the
# process-lifetime writer fence for cooperating Windvale providers.
symbol local data Storage_linux_path in .rodata
symbol export function Storage_platform_close in .text
symbol export function Storage_platform_flush in .text
symbol export function Storage_platform_open in .text
symbol export function Storage_platform_read in .text
symbol export function Storage_platform_resize in .text
symbol export function Storage_platform_write in .text

section code .text align 16
define Storage_platform_open
push rbx
push r12
move r12 r8

# openat(AT_FDCWD, path, O_RDWR | O_CREAT | O_CLOEXEC, 0600)
move_i32 edi -100
load_address rsi Storage_linux_path
move_u32 edx 524354
move_u32 r10d 384
move_u32 eax 257
syscall
compare_i32 rax -4095
branch above_equal Storage_linux_open_failure
move rbx rax
store_memory_u64 r12 none 1 0 rax

# flock(fd, LOCK_EX | LOCK_NB) establishes one cooperating writer.
move edi ebx
move_u32 esi 6
move_u32 eax 73
syscall
test rax rax
branch not_equal Storage_linux_open_close_failure

# lseek(fd, 0, SEEK_END) obtains the exact initial u64-compatible length.
move edi ebx
xor esi esi
move_u32 edx 2
move_u32 eax 8
syscall
compare_i32 rax -4095
branch above_equal Storage_linux_open_close_failure
store_memory_u64 r12 none 1 8 rax
xor eax eax
pop r12
pop rbx
return

label Storage_linux_open_close_failure
move edi ebx
move_u32 eax 3
syscall
label Storage_linux_open_failure
move_u32 eax 1
pop r12
pop rbx
return
end define

define Storage_platform_read
