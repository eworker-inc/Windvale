push r13
push r14
push r15
move r12 r8
move r13 r9
move r14 r11
move r15d r10d
xor eax eax
store_memory_u32 r12 none 1 24 eax
test r13 r13
branch sign Storage_linux_read_unsupported

label Storage_linux_read_next
test r15d r15d
branch equal Storage_linux_read_complete
load_memory_u64 rdi r12 none 1 0
move rsi r14
move edx r15d
move r10 r13
move_u32 eax 17
syscall
compare_i32 rax -4095
branch above_equal Storage_linux_read_failure
test rax rax
branch equal Storage_linux_read_failure
compare rax r15
branch above Storage_linux_read_failure
add r14 rax
add r13 rax
subtract r15 rax
load_memory_u32 ecx r12 none 1 24
add ecx eax
store_memory_u32 r12 none 1 24 ecx
jump_label Storage_linux_read_next

label Storage_linux_read_complete
xor eax eax
jump_label Storage_linux_read_return
label Storage_linux_read_failure
move_u32 eax 1
jump_label Storage_linux_read_return
label Storage_linux_read_unsupported
move_u32 eax 3
label Storage_linux_read_return
pop r15
pop r14
pop r13
pop r12
return
end define

define Storage_platform_write
push r12
push r13
push r14
push r15
move r12 r8
move r13 r9
move r14 r11
move r15d r10d
xor eax eax
store_memory_u32 r12 none 1 24 eax
test r13 r13
branch sign Storage_linux_write_unsupported
move rax r13
add rax r15
branch below Storage_linux_write_unsupported
test rax rax
branch sign Storage_linux_write_unsupported

label Storage_linux_write_next
test r15d r15d
branch equal Storage_linux_write_complete
load_memory_u64 rdi r12 none 1 0
move rsi r14
move edx r15d
move r10 r13
move_u32 eax 18
syscall
compare_i32 rax -4095
branch above_equal Storage_linux_write_failure
test rax rax
branch equal Storage_linux_write_failure
compare rax r15
branch above Storage_linux_write_failure
add r14 rax
add r13 rax
subtract r15 rax
load_memory_u32 ecx r12 none 1 24
add ecx eax
store_memory_u32 r12 none 1 24 ecx
jump_label Storage_linux_write_next

label Storage_linux_write_complete
load_memory_u64 rax r12 none 1 8
compare r13 rax
branch below_equal Storage_linux_write_length_ready
store_memory_u64 r12 none 1 8 r13
label Storage_linux_write_length_ready
xor eax eax
jump_label Storage_linux_write_return
label Storage_linux_write_failure
move_u32 eax 2
jump_label Storage_linux_write_return
label Storage_linux_write_unsupported
move_u32 eax 3
label Storage_linux_write_return
pop r15
pop r14
pop r13
pop r12
return
end define

define Storage_platform_resize
push r12
move r12 r8
test r9 r9
branch sign Storage_linux_resize_unsupported
load_memory_u64 rdi r12 none 1 0
move rsi r9
move_u32 eax 77
