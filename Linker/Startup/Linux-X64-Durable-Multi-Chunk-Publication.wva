windvale-assembly 1

# Linux x64 durable replacement over an admitted immutable snapshot sequence.
# Input: RDI anchored directory fd, RSI NUL-terminated destination basename,
# EDX first snapshot ordinal, ECX one-past snapshot ordinal, R8D stride (1/2),
# R9D fixed bytes skipped at the beginning of every selected snapshot.
# Result: EAX 0 complete, 1 rejected/unchanged, 2 indeterminate after replace.
symbol local function Linux_durable_multi_chunk_hex8 in .text
symbol export function Linux_durable_multi_chunk_publication_run in .text
symbol import data File_input_scratch
symbol import function Native_publication_apply
symbol import function Native_publication_begin
symbol import data Snapshot_table

section code .text align 16
define Linux_durable_multi_chunk_hex8
move_u32 r8d 8
label Hex_loop
rotate_left eax 4
move edx eax
and_i32 edx 15
add_i8 dl 48
compare_i8 dl 57
branch below_equal Hex_digit
add_i8 dl 39
label Hex_digit
store_memory_u8 rdi none 1 0 dl
add_i32 rdi 1
subtract_i32 r8d 1
branch not_equal Hex_loop
return
end define

define Linux_durable_multi_chunk_publication_run
push rbx
push rbp
push r12
push r13
push r14
push r15
subtract_i32 rsp 96
store_memory_u64 rsp none 1 24 rdi
store_memory_u64 rsp none 1 32 rsi
