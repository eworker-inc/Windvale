windvale-assembly 1

# Staged-WVO policy wrapper over the shared immutable snapshot-sequence
# validator. WVO chunks begin at ordinal 2, are contiguous, have no envelope,
# and retain the contract's 32 MiB aggregate ceiling.
symbol export function X64_wvo_staging_snapshot_table_validate in .text
symbol import function X64_immutable_snapshot_sequence_validate

section code .text align 16
define X64_wvo_staging_snapshot_table_validate
move_u32 esi 3
move_u32 edx 64
move_u32 ecx 2
move_u32 r8d 1
xor r9d r9d
move_u32 r10d 33554432
call X64_immutable_snapshot_sequence_validate
return
end define
end section
