windvale-assembly 1

# Staged-WVO policy entry over the shared immutable-snapshot publisher shell.
symbol export function Linux_wvo_staging_publisher_run in .text
symbol import function Linux_immutable_snapshot_publisher_run
symbol import function X64_wvo_staging_snapshot_table_validate

section code .text align 16
define Linux_wvo_staging_publisher_run
move_u32 edi 2
move_u32 esi 1
xor ebp ebp
load_address r10 X64_wvo_staging_snapshot_table_validate
jump Linux_immutable_snapshot_publisher_run
end define
end section
