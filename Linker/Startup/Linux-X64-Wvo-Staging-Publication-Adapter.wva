windvale-assembly 1

# Linux x64 staged-WVO publisher. Portable Windvale code admits the exact
# input/manifest/chunk sequence; this adapter independently validates and
# rereads those immutable snapshots, rejects destination aliases, and owns the
# exclusive-sibling durable atomic-replacement transaction.
symbol local function Linux_wvo_staging_hex8 in .text
symbol export function Linux_wvo_staging_publisher_run in .text
