section code .text align 16
define Linux_wvo_staging_hex8
# Input: EAX value, RDI eight-byte destination. Output uses lowercase hex.
move_u32 r8d 8
label Hex_loop
rotate_left eax 4
move edx eax
and_i32 edx 15
add_i8 dl 48
compare_i8 dl 57
branch below_equal Hex_digit
add_i8 dl 39
label Hex_digit
store_memory_u8 rdi none 1 0 dl
add_i32 rdi 1
subtract_i32 r8d 1
branch not_equal Hex_loop
return
end define

