end define
define Report_valid
bytes 86 97 108 105 100
end define
define Report_invalid_wvb
bytes 73 110 118 97 108 105 100 203 137 119 118 98
end define
define Report_unsupported_profile
bytes 85 110 115 117 112 112 111 114 116 101 100 203 137 112 114 111 102 105 108 101
end define
define Report_unsupported_module
bytes 85 110 115 117 112 112 111 114 116 101 100 203 137 109 111 100 117 108 101
end define
define Report_unsupported_function
bytes 85 110 115 117 112 112 111 114 116 101 100 203 137 102 117 110 99 116 105 111 110
end define
define Report_unsupported_code
bytes 85 110 115 117 112 112 111 114 116 101 100 203 137 99 111 100 101
end define
define Report_output_limit
bytes 79 117 116 112 117 116 203 137 108 105 109 105 116
end define
define Report_abi
bytes 32 97 98 105 61
end define
define Report_code
bytes 32 99 111 100 101 45 98 121 116 101 115 61
end define
define Report_object
bytes 32 111 98 106 101 99 116 45 98 121 116 101 115 61
end define
end section
