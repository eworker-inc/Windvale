label Admission_write_copy
load_memory_u64 r9 rcx rax 1 0
store_memory_u64 r8 rax 1 0 r9
add_i32 eax 8
compare eax edx
branch below Admission_write_copy
xor eax eax
return
label Admission_write_failed
move_u32 eax 10
store_memory_u32 r15 none 1 64 eax
move_u32 eax 1
return
end define

define Closure_check
load_memory_u32 eax r12 none 1 220
compare_i32 eax 1
branch not_equal Invalid
load_memory_u32 eax r12 none 1 2352
compare_i32 eax 0
branch not_equal Invalid
load_memory_u32 eax r12 none 1 4968
compare_i32 eax 1
branch not_equal Invalid
load_memory_u32 eax r12 none 1 6176
compare_i32 eax 1
branch not_equal Invalid
load_memory_u32 eax r12 none 1 6020
compare_i32 eax 0
branch not_equal Invalid
load_memory_u32 eax r12 none 1 6084
compare_i32 eax 0
branch not_equal Invalid
load_memory_u32 eax r12 none 1 8264
compare_i32 eax 0
branch not_equal Invalid
load_memory_u32 eax r12 none 1 8296
compare_i32 eax 0
branch not_equal Invalid
load_memory_u64 rax r12 none 1 248
test rax rax
branch not_equal Invalid
load_memory_u64 rax r12 none 1 2328
test rax rax
branch not_equal Invalid
xor ecx ecx
label Slots
move edx ecx
shift_left edx 5
load_memory_u32 eax r12 rdx 1 260
test eax eax
branch not_equal Invalid
load_memory_u64 rax r12 rdx 1 6208
test rax rax
branch not_equal Invalid
load_memory_u32 eax r12 rdx 1 6216
test eax eax
branch not_equal Invalid
add_i32 ecx 1
compare_i32 ecx 64
branch below Slots
xor eax eax
return
label Invalid
move_u32 eax 1
return
end define
define Report_build
# Private post-closure helpers may clobber rax/rcx/rdx/r8-r11 and rbx/rdi;
# the driver no longer needs their old values. r12/r15 and other saved registers stay live.
# Fixed spans and admitted ABI/counts append at most86B in the160B buffer.
# The separate ten-digit scratch and report both stay inside prepaid12288B metadata.
# rsp is eight bytes below the driver frame; rbx retains that exact base.
move rbx rsp
add_i32 rbx 8
move rdi r12
add_i32 rdi 10912
load_address rcx Report_prefix
move_u32 edx 18
call Report_append_span
load_memory_u32 eax rbx none 1 88
compare_i32 eax 0
branch equal Status_0
compare_i32 eax 1
branch equal Status_1
compare_i32 eax 2
branch equal Status_2
compare_i32 eax 3
branch equal Status_3
compare_i32 eax 4
branch equal Status_4
compare_i32 eax 5
branch equal Status_5
compare_i32 eax 6
branch equal Status_6
trap
label Status_0
load_address rcx Report_valid
move_u32 edx 5
jump_label Status_ready
label Status_1
load_address rcx Report_invalid_wvb
move_u32 edx 12
jump_label Status_ready
label Status_2
load_address rcx Report_unsupported_profile
move_u32 edx 20
jump_label Status_ready
label Status_3
load_address rcx Report_unsupported_module
move_u32 edx 19
jump_label Status_ready
label Status_4
load_address rcx Report_unsupported_function
move_u32 edx 21
jump_label Status_ready
label Status_5
load_address rcx Report_unsupported_code
move_u32 edx 17
jump_label Status_ready
label Status_6
load_address rcx Report_output_limit
move_u32 edx 13
jump_label Status_ready
label Status_ready
call Report_append_span
load_address rcx Report_abi
move_u32 edx 5
call Report_append_span
load_memory_u32 eax rbx none 1 92
call Report_append_u32
load_address rcx Report_code
move_u32 edx 12
call Report_append_span
load_memory_u32 eax rbx none 1 96
call Report_append_u32
load_address rcx Report_object
move_u32 edx 14
call Report_append_span
load_memory_u32 eax rbx none 1 80
call Report_append_u32
move r8 r12
add_i32 r8 10912
move r9 rdi
subtract r9 r8
return
end define

define Report_append_span
test edx edx
branch equal Done
label Next
load_memory_u8 al rcx none 1 0
store_memory_u8 rdi none 1 0 al
add_i32 rcx 1
add_i32 rdi 1
subtract_i32 edx 1
branch not_equal Next
label Done
return
end define

define Report_append_u32
# At most ten decimal digits, each with exactly32 bit steps.
xor edx edx
label Digit
move r8d eax
xor r9d r9d
xor r10d r10d
move_u32 r11d 32
label Divide
shift_left r10d 1
move ecx r8d
shift_right ecx 31
or r10d ecx
shift_left r8d 1
shift_left r9d 1
compare_i32 r10d 10
branch below Bit_ready
subtract_i32 r10d 10
or_i32 r9d 1
label Bit_ready
subtract_i32 r11d 1
branch not_equal Divide
add_i32 r10d 48
store_memory_u8 r12 rdx 1 11104 r10b
add_i32 edx 1
move eax r9d
test eax eax
branch not_equal Digit
label Copy
subtract_i32 edx 1
load_memory_u8 al r12 rdx 1 11104
store_memory_u8 rdi none 1 0 al
add_i32 rdi 1
test edx edx
branch not_equal Copy
return
end define

end section

