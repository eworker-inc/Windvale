module Linkerˉconsoleˉapplicationˉconstructionˉbridge profile hosted;

import Linkerˉconsoleˉapplicationˉconstruction as Applicationˉconstruction;

capability file.read_bytes;

data Requestˉname: text = "console-application-construction-request.bin";

export fn Main() -> bytes {
    let Input: bytes = file.read_bytes(Requestˉname);
    return Applicationˉconstruction.Consoleˉapplicationˉconstruction(Input);
}
