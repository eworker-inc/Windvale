module Linkerˉnativeˉhostedˉverifierˉpublisherˉlinuxˉmaterializationˉtool profile hosted;

import Linkerˉnativeˉhostedˉverifierˉpublisherˉfileˉtoolˉsupport as Support;
import Linkerˉnativeˉhostedˉverifierˉpublisherˉlinuxˉmaterialization as Materialization;

capability console.write_line;
capability diagnostic.write_line;
capability file.read_bytes;
capability file.write_bytes;
capability process.argument;
capability process.argument_count;

fn Usage() -> i32 {
    diagnostic.write_line("Usage: wvhostverifierpublishlinux <base.elf> <request.wvcr> <objects.wvio> <metadata.wvvp> <application.elf>");
    return 64;
}

export fn Main() -> i32 {
    if process.argument_count() != 5u32 { return Usage(); }
    let Outputˉpath: text = process.argument(4u32);
    var Index: u32 = 0u32;
    while Index < 4u32 {
        if Support.Pathsˉareˉequal(process.argument(Index), Outputˉpath) { return Usage(); }
        Index = Index + 1u32;
    }
    let Base: bytes = file.read_bytes(process.argument(0u32));
    let Construction: bytes = file.read_bytes(process.argument(1u32));
    let Objects: bytes = file.read_bytes(process.argument(2u32));
    let Metadata: bytes = file.read_bytes(process.argument(3u32));
    if Bytesˉlength(Construction) != 416u32 {
        diagnostic.write_line("publisher Linux materialization status=Rejected");
        return 2;
    }
    let Variant: u32 = Bytesˉreadˉu32ˉlittle(Construction, 28u32);
    var Outputˉbytes: u32 = 254917u32;
    if Variant == 1u32 { Outputˉbytes = 680901u32; }
    if Variant == 2u32 { Outputˉbytes = 1340357u32; }
    if Variant == 3u32 { Outputˉbytes = 426949u32; }
    if Variant > 3u32 {
        diagnostic.write_line("publisher Linux materialization status=Rejected");
        return 2;
    }
    let Constructionˉoffset: u32 = 64u32 + Bytesˉlength(Base);
    let Objectsˉoffset: u32 = Constructionˉoffset + Bytesˉlength(Construction);
    let Metadataˉoffset: u32 = Objectsˉoffset + Bytesˉlength(Objects);
    let Total: u32 = Metadataˉoffset + Bytesˉlength(Metadata);
    var Request: bytes = Bytesˉfromˉu32ˉlittle(1296848471u32);
    Request = Support.Appendˉu32(Request, 1u32);
    Request = Support.Appendˉu32(Request, Total);
    Request = Support.Appendˉu32(Request, 2u32);
    Request = Support.Appendˉu32(Request, 64u32);
    Request = Support.Appendˉu32(Request, Bytesˉlength(Base));
    Request = Support.Appendˉu32(Request, Constructionˉoffset);
    Request = Support.Appendˉu32(Request, Bytesˉlength(Construction));
    Request = Support.Appendˉu32(Request, Objectsˉoffset);
    Request = Support.Appendˉu32(Request, Bytesˉlength(Objects));
    Request = Support.Appendˉu32(Request, Metadataˉoffset);
    Request = Support.Appendˉu32(Request, Bytesˉlength(Metadata));
    Request = Support.Appendˉu32(Request, 0u32);
    Request = Support.Appendˉu32(Request, 0u32);
    Request = Support.Appendˉu32(Request, 0u32);
    Request = Support.Appendˉu32(Request, 0u32);
    Request = Bytesˉconcat(Request, Base);
    Request = Bytesˉconcat(Request, Construction);
    Request = Bytesˉconcat(Request, Objects);
    Request = Bytesˉconcat(Request, Metadata);
    let Response: bytes = Materialization.Publisherˉlinuxˉmaterialize(Request);
    if Bytesˉlength(Response) != 32u32 + Outputˉbytes ||
        Bytesˉreadˉu32ˉlittle(Response, 12u32) != 0u32 {
        diagnostic.write_line("publisher Linux materialization status=Rejected");
        return 2;
    }
    file.write_bytes(Outputˉpath, Bytesˉslice(Response, 32u32, Outputˉbytes));
    console.write_line(
        Textˉconcat(
            "publisher Linux materialization status=Valid bytes=",
            U32ˉformat(Outputˉbytes)
        )
    );
    return 0;
}
