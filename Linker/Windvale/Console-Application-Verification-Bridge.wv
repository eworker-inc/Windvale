module Linkerˉconsoleˉapplicationˉverificationˉbridge profile hosted;

import Linkerˉconsoleˉapplicationˉverification as Applicationˉverification;

capability file.read_bytes;
capability file.write_bytes;

data Firstˉname: text = "console-application-first.bin";
data Secondˉname: text = "console-application-second.bin";
data Nativeˉimageˉname: text = "console-application-native-image.bin";

export fn Main() -> bytes {
    let First: bytes = file.read_bytes(Firstˉname);
    let Second: bytes = file.read_bytes(Secondˉname);
    let Verified: Applicationˉverification.Consoleˉapplicationˉverificationˉresult =
        Applicationˉverification.Consoleˉapplicationˉverification(First, Second);
    if Verified.Status == Applicationˉverification.Consoleˉapplicationˉverificationˉstatus.Valid {
        file.write_bytes(Nativeˉimageˉname, Verified.Nativeˉimage);
    }
    return Verified.Evidence;
}
