    if Index == 4u32 { return 3530955624u32; }
    if Index == 5u32 { return 3139781555u32; }
    if Index == 6u32 { return 320650148u32; }
    return 3619038940u32;
}

fn Moduleˉdigestˉword(Index: u32, Variant: u32) -> u32 {
    if Variant == 4u32 {
        if Index == 0u32 { return 3072266984u32; }
        if Index == 1u32 { return 2613279852u32; }
        if Index == 2u32 { return 2740165909u32; }
        if Index == 3u32 { return 2820509122u32; }
