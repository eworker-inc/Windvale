    }
    if Variant == 2u32 {
        if Index == 0u32 { return 2385151233u32; }
        if Index == 1u32 { return 4186734187u32; }
        if Index == 2u32 { return 241307273u32; }
        if Index == 3u32 { return 1361852982u32; }
        if Index == 4u32 { return 1437019936u32; }
        if Index == 5u32 { return 2181250393u32; }
        if Index == 6u32 { return 2840191171u32; }
        return 646086525u32;
    }
    if Target == 1u32 {
        if Index == 0u32 { return 2925244891u32; }
        if Index == 1u32 { return 3665714992u32; }
        if Index == 2u32 { return 1586712129u32; }
        if Index == 3u32 { return 4186885183u32; }
