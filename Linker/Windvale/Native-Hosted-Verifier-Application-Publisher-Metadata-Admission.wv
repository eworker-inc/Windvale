module Linkerˉnativeˉhostedˉverifierˉapplicationˉpublisherˉmetadataˉadmission profile portable;

fn Allˉzero(Input: bytes, Offset: u32, Count: u32) -> bool {
    var Index: u32 = 0u32;
    while Index < Count {
        if Bytesˉreadˉu8(Input, Offset + Index) != 0u8 { return false; }
        Index = Index + 1u32;
    }
    return true;
}

