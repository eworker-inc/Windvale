export fn Nativeˉhostedˉverifierˉpublisherˉstartupˉdigestˉisˉvalid(
    Input: bytes,
    Offset: u32,
    Target: u32
) -> bool {
    return Nativeˉhostedˉverifierˉpublisherˉstartupˉdigestˉisˉvalidˉforˉvariant(
        Input, Offset, Target, 0u32
    );
}

export fn Nativeˉhostedˉverifierˉpublisherˉstartupˉdigestˉisˉvalidˉforˉvariant(
    Input: bytes,
    Offset: u32,
    Target: u32,
    Variant: u32
) -> bool {
    if Target < 1u32 || Target > 2u32 ||
        Variant > 4u32 ||
        Offset > Bytesˉlength(Input) ||
        32u32 > Bytesˉlength(Input) - Offset {
        return false;
    }
    var Index: u32 = 0u32;
    while Index < 8u32 {
        if Bytesˉreadˉu32ˉlittle(Input, Offset + Index * 4u32) !=
            Startupˉdigestˉword(Index, Target, Variant) {
            return false;
        }
        Index = Index + 1u32;
    }
    return true;
}

export fn Nativeˉhostedˉverifierˉpublisherˉmoduleˉdigestˉisˉvalidˉforˉvariant(
    Input: bytes,
    Offset: u32,
    Variant: u32
) -> bool {
    if Variant > 4u32 ||
        Offset > Bytesˉlength(Input) ||
        32u32 > Bytesˉlength(Input) - Offset {
        return false;
    }
    var Index: u32 = 0u32;
    while Index < 8u32 {
        if Bytesˉreadˉu32ˉlittle(Input, Offset + Index * 4u32) !=
            Moduleˉdigestˉword(Index, Variant) {
            return false;
        }
        Index = Index + 1u32;
    }
    return true;
}

export fn Nativeˉhostedˉverifierˉpublisherˉmoduleˉdigestˉisˉvalid(
    Input: bytes,
    Offset: u32
) -> bool {
    return Nativeˉhostedˉverifierˉpublisherˉmoduleˉdigestˉisˉvalidˉforˉvariant(
        Input, Offset, 0u32
    );
}

export fn Nativeˉhostedˉverifierˉpublisherˉmetadataˉisˉvalidˉforˉvariant(
    Input: bytes,
    Offset: u32,
    Target: u32,
    Variant: u32
) -> bool {
    if Offset > Bytesˉlength(Input) ||
        128u32 > Bytesˉlength(Input) - Offset ||
        Target < 1u32 || Target > 2u32 || Variant > 4u32 {
        return false;
    }
    var Mainˉoffset: u32 = 3001u32;
    var Beginˉoffset: u32 = 789u32;
    var Applyˉoffset: u32 = 0u32;
    if Variant == 1u32 { Mainˉoffset = 1178u32; }
    if Variant == 2u32 {
        Mainˉoffset = 0u32;
        Beginˉoffset = 5475u32;
        Applyˉoffset = 4686u32;
    }
    if Variant == 3u32 {
        Mainˉoffset = 0u32;
        Beginˉoffset = 5475u32;
        Applyˉoffset = 4686u32;
    }
    if Variant == 4u32 { Mainˉoffset = 18902u32; }
    var Magic: u32 = 1347835479u32;
    var Storedˉvariant: u32 = Variant;
    if Variant == 2u32 {
        Magic = 1112561239u32;
        Storedˉvariant = 0u32;
    }
    if Variant == 3u32 {
        Magic = 1330665047u32;
        Storedˉvariant = 0u32;
    }
    if Variant == 4u32 {
        Magic = 1095784023u32;
        Storedˉvariant = 0u32;
    }
    if Bytesˉreadˉu32ˉlittle(Input, Offset) != Magic ||
        Bytesˉreadˉu32ˉlittle(Input, Offset + 4u32) != 1u32 ||
        Bytesˉreadˉu32ˉlittle(Input, Offset + 8u32) != 128u32 ||
        Bytesˉreadˉu32ˉlittle(Input, Offset + 12u32) != Target ||
        Bytesˉreadˉu32ˉlittle(Input, Offset + 16u32) != 5u32 ||
        Bytesˉreadˉu32ˉlittle(Input, Offset + 20u32) != 5u32 ||
        Bytesˉreadˉu32ˉlittle(Input, Offset + 24u32) != 0u32 ||
        Bytesˉreadˉu32ˉlittle(Input, Offset + 28u32) != Mainˉoffset ||
        Bytesˉreadˉu32ˉlittle(Input, Offset + 32u32) != Beginˉoffset ||
        Bytesˉreadˉu32ˉlittle(Input, Offset + 36u32) != Applyˉoffset ||
        Bytesˉreadˉu32ˉlittle(Input, Offset + 40u32) != 4194304u32 ||
        Bytesˉreadˉu32ˉlittle(Input, Offset + 44u32) != 1u32 ||
        !Nativeˉhostedˉverifierˉpublisherˉstartupˉdigestˉisˉvalidˉforˉvariant(
            Input, Offset + 48u32, Target, Variant
        ) ||
        !Nativeˉhostedˉverifierˉpublisherˉmoduleˉdigestˉisˉvalidˉforˉvariant(
            Input, Offset + 80u32, Variant
        ) ||
        Bytesˉreadˉu32ˉlittle(Input, Offset + 112u32) != Storedˉvariant ||
        !Allˉzero(Input, Offset + 116u32, 12u32) {
        return false;
    }
    return true;
}

export fn Nativeˉhostedˉverifierˉpublisherˉmetadataˉisˉvalid(
    Input: bytes,
    Offset: u32,
    Target: u32
) -> bool {
    return Nativeˉhostedˉverifierˉpublisherˉmetadataˉisˉvalidˉforˉvariant(
        Input, Offset, Target, 0u32
    );
}
