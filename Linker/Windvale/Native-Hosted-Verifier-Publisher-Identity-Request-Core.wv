module Linkerˉnativeˉhostedˉverifierˉpublisherˉidentityˉrequest profile portable;

import Foundationˉsha256ˉstreaming as Sha;
import Linkerˉnativeˉhostedˉverifierˉpublisherˉconstructionˉdigests as Digests;

export record Publisherˉidentityˉrequestˉresult {
    Valid: bool;
    Value: bytes;
    Failureˉinput: u32;
}

fn Empty(Input: bytes) -> bytes {
    return Bytesˉslice(Input, 0u32, 0u32);
}

fn Failure(Input: bytes, Field: u32) -> Publisherˉidentityˉrequestˉresult {
    return Publisherˉidentityˉrequestˉresult(false, Empty(Input), Field);
}

fn Appendˉu32(Output: bytes, Value: u32) -> bytes {
    return Bytesˉconcat(Output, Bytesˉfromˉu32ˉlittle(Value));
}

fn Digest(Input: bytes) -> bytes {
    var State: Sha.Foundationˉsha256ˉstream =
        Sha.Foundationˉsha256ˉbegin(Input);
    State = Sha.Foundationˉsha256ˉupdate(State, Input);
    return Sha.Foundationˉsha256ˉfinishˉraw(State);
}

fn Identityˉmatches(
    Input: bytes,
    Length: u32,
    Identity: u32,
    Target: u32,
    Variant: u32
) -> bool {
    if Bytesˉlength(Input) != Length { return false; }
    let Actual: bytes = Digest(Input);
    let Expected: bytes =
        Digests.Publisherˉconstructionˉexpectedˉdigestˉforˉvariant(
            Input, Identity, Target, Variant
        );
    if Bytesˉlength(Actual) != 32u32 ||
        Bytesˉlength(Expected) != 32u32 {
        return false;
    }
    var Index: u32 = 0u32;
    while Index < 32u32 {
        if Bytesˉreadˉu8(Actual, Index) != Bytesˉreadˉu8(Expected, Index) {
            return false;
        }
        Index = Index + 1u32;
    }
    return true;
}

fn Moduleˉvariant(Input: bytes, Target: u32) -> u32 {
    if Identityˉmatches(Input, 29170u32, 1u32, Target, 0u32) {
        return 0u32;
    }
    if Identityˉmatches(Input, 41268u32, 1u32, Target, 1u32) {
        return 1u32;
    }
    if Identityˉmatches(Input, 181772u32, 1u32, Target, 2u32) {
        return 2u32;
    }
    if Identityˉmatches(Input, 41365u32, 1u32, Target, 3u32) {
        return 3u32;
    }
    if Identityˉmatches(Input, 115107u32, 1u32, Target, 4u32) {
        return 4u32;
    }
    return 5u32;
}

export fn Publisherˉidentityˉvariant(
    Module: bytes,
    Publisherˉobject: bytes,
    Target: u32
) -> u32 {
    let Variant: u32 = Moduleˉvariant(Module, Target);
    if Variant == 0u32 &&
        Identityˉmatches(
            Publisherˉobject, 233804u32, 2u32, Target, Variant
        ) {
        return Variant;
    }
    if Variant == 1u32 &&
        Identityˉmatches(
            Publisherˉobject, 660123u32, 2u32, Target, Variant
        ) {
        return Variant;
    }
    if Variant == 2u32 &&
        Identityˉmatches(
            Publisherˉobject, 1523708u32, 2u32, Target, Variant
        ) {
        return Variant;
    }
    if Variant == 3u32 &&
        Identityˉmatches(
            Publisherˉobject, 408284u32, 2u32, Target, Variant
        ) {
        return Variant;
    }
    if Variant == 4u32 &&
        Identityˉmatches(
            Publisherˉobject, 1139440u32, 2u32, Target, Variant
        ) {
        return Variant;
    }
    return 5u32;
}

fn Resourceˉlength(Variant: u32, Identity: u32, Target: u32) -> u32 {
    if Identity == 1u32 {
        if Variant == 4u32 { return 115107u32; }
        if Variant == 3u32 { return 41365u32; }
        if Variant == 2u32 { return 181772u32; }
        if Variant == 1u32 { return 41268u32; }
        return 29170u32;
    }
    if Identity == 2u32 {
        if Variant == 4u32 { return 1139440u32; }
        if Variant == 3u32 { return 408284u32; }
        if Variant == 2u32 { return 1523708u32; }
        if Variant == 1u32 { return 660123u32; }
        return 233804u32;
    }
    if Identity == 3u32 {
        if Target == 2u32 { return 164u32; }
        return 168u32;
    }
    if Identity == 4u32 {
        if Target == 2u32 { return 5559u32; }
        return 9544u32;
    }
    if Identity == 5u32 { return 2176u32; }
    return 128u32;
}

fn Appendˉresourceˉrecord(
    Header: bytes,
    Offset: u32,
    Resource: bytes
) -> bytes {
    var Result: bytes = Appendˉu32(Header, Offset);
    return Appendˉu32(Result, Bytesˉlength(Resource));
}

export fn Publisherˉidentityˉrequest(
    Target: u32,
    Module: bytes,
    Publisherˉobject: bytes,
    Startupˉobject: bytes,
    Adapterˉobject: bytes,
    Sha256ˉobject: bytes,
    Metadata: bytes
) -> Publisherˉidentityˉrequestˉresult {
    if Target != 1u32 && Target != 2u32 { return Failure(Module, 0u32); }
    let Variant: u32 = Moduleˉvariant(Module, Target);
    if Variant > 4u32 { return Failure(Module, 1u32); }
    let Moduleˉbytes: u32 = Resourceˉlength(Variant, 1u32, Target);
    let Publisherˉbytes: u32 = Resourceˉlength(Variant, 2u32, Target);
    let Startupˉbytes: u32 = Resourceˉlength(Variant, 3u32, Target);
    let Adapterˉbytes: u32 = Resourceˉlength(Variant, 4u32, Target);
    if !Identityˉmatches(
        Publisherˉobject, Publisherˉbytes, 2u32, Target, Variant
    ) {
        return Failure(Module, 2u32);
    }
    if !Identityˉmatches(
        Startupˉobject, Startupˉbytes, 3u32, Target, Variant
    ) {
        return Failure(Module, 3u32);
    }
    if !Identityˉmatches(
        Adapterˉobject, Adapterˉbytes, 4u32, Target, Variant
    ) {
        return Failure(Module, 4u32);
    }
    if !Identityˉmatches(
        Sha256ˉobject, 2176u32, 5u32, Target, Variant
    ) {
        return Failure(Module, 5u32);
    }
    if !Identityˉmatches(Metadata, 128u32, 6u32, Target, Variant) {
        return Failure(Module, 6u32);
    }

    let Total: u32 = 64u32 + Moduleˉbytes + Publisherˉbytes +
        Startupˉbytes + Adapterˉbytes + 2176u32 + 128u32;
    var Result: bytes = Empty(Module);
    Result = Appendˉu32(Result, 1230001751u32);
    Result = Appendˉu32(Result, 1u32);
    Result = Appendˉu32(Result, Total);
    Result = Appendˉu32(Result, Target);
    var Offset: u32 = 64u32;
    Result = Appendˉresourceˉrecord(Result, Offset, Module);
    Offset = Offset + Bytesˉlength(Module);
    Result = Appendˉresourceˉrecord(Result, Offset, Publisherˉobject);
    Offset = Offset + Bytesˉlength(Publisherˉobject);
    Result = Appendˉresourceˉrecord(Result, Offset, Startupˉobject);
    Offset = Offset + Bytesˉlength(Startupˉobject);
    Result = Appendˉresourceˉrecord(Result, Offset, Adapterˉobject);
    Offset = Offset + Bytesˉlength(Adapterˉobject);
    Result = Appendˉresourceˉrecord(Result, Offset, Sha256ˉobject);
    Offset = Offset + Bytesˉlength(Sha256ˉobject);
    Result = Appendˉresourceˉrecord(Result, Offset, Metadata);
    if Bytesˉlength(Result) != 64u32 { return Failure(Module, 7u32); }
    Result = Bytesˉconcat(Result, Module);
    Result = Bytesˉconcat(Result, Publisherˉobject);
    Result = Bytesˉconcat(Result, Startupˉobject);
    Result = Bytesˉconcat(Result, Adapterˉobject);
    Result = Bytesˉconcat(Result, Sha256ˉobject);
    Result = Bytesˉconcat(Result, Metadata);
    if Bytesˉlength(Result) != Total { return Failure(Module, 8u32); }
    return Publisherˉidentityˉrequestˉresult(true, Result, Total);
}
