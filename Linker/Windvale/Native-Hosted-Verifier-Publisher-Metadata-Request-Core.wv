module Linkerˉnativeˉhostedˉverifierˉpublisherˉmetadataˉrequest profile portable;

import Foundationˉsha256ˉstreaming as Sha;
import Linkerˉnativeˉhostedˉverifierˉapplicationˉpublisherˉmetadataˉadmission as Admission;
import Linkerˉnativeˉhostedˉverifierˉpublisherˉconstructionˉdigests as Digests;

export record Publisherˉmetadataˉrequestˉresult {
    Valid: bool;
    Value: bytes;
}

fn Empty(Input: bytes) -> bytes {
    return Bytesˉslice(Input, 0u32, 0u32);
}

fn Appendˉu32(Output: bytes, Value: u32) -> bytes {
    return Bytesˉconcat(Output, Bytesˉfromˉu32ˉlittle(Value));
}

fn Digest(Input: bytes) -> bytes {
    var State: Sha.Foundationˉsha256ˉstream =
        Sha.Foundationˉsha256ˉbegin(Input);
    State = Sha.Foundationˉsha256ˉupdate(State, Input);
    return Sha.Foundationˉsha256ˉfinishˉraw(State);
}

fn Digestˉmatches(
    Actual: bytes,
    Identity: u32,
    Target: u32
) -> bool {
    if Bytesˉlength(Actual) != 32u32 { return false; }
    let Expected: bytes =
        Digests.Publisherˉconstructionˉexpectedˉdigest(
            Actual, Identity, Target
        );
    var Index: u32 = 0u32;
    while Index < 32u32 {
        if Bytesˉreadˉu8(Actual, Index) !=
            Bytesˉreadˉu8(Expected, Index) {
            return false;
        }
        Index = Index + 1u32;
    }
    return true;
}

fn Startupˉimageˉdigest(Input: bytes, Target: u32, Variant: u32) -> bytes {
    var Result: bytes = Empty(Input);
    var Index: u32 = 0u32;
    while Index < 8u32 {
        var Word: u32 = 0u32;
        if Variant == 4u32 && Target == 1u32 {
            if Index == 0u32 { Word = 2259744943u32; }
            else if Index == 1u32 { Word = 498043574u32; }
            else if Index == 2u32 { Word = 303251925u32; }
            else if Index == 3u32 { Word = 1038007152u32; }
            else if Index == 4u32 { Word = 3814723233u32; }
            else if Index == 5u32 { Word = 2276987604u32; }
            else if Index == 6u32 { Word = 226358341u32; }
            else { Word = 1010034804u32; }
        } else if Variant == 4u32 {
            if Index == 0u32 { Word = 3211355519u32; }
            else if Index == 1u32 { Word = 3676139264u32; }
            else if Index == 2u32 { Word = 2139486241u32; }
            else if Index == 3u32 { Word = 1624357721u32; }
            else if Index == 4u32 { Word = 3607672032u32; }
            else if Index == 5u32 { Word = 205798076u32; }
            else if Index == 6u32 { Word = 1445018914u32; }
            else { Word = 519770980u32; }
        } else if Variant == 3u32 && Target == 1u32 {
            if Index == 0u32 { Word = 4293010631u32; }
            else if Index == 1u32 { Word = 3620289198u32; }
            else if Index == 2u32 { Word = 360485465u32; }
            else if Index == 3u32 { Word = 2531147558u32; }
            else if Index == 4u32 { Word = 1873302768u32; }
            else if Index == 5u32 { Word = 1355050762u32; }
            else if Index == 6u32 { Word = 2970522518u32; }
            else { Word = 3208098414u32; }
        } else if Variant == 3u32 {
            if Index == 0u32 { Word = 897654718u32; }
            else if Index == 1u32 { Word = 1292077660u32; }
            else if Index == 2u32 { Word = 972422720u32; }
            else if Index == 3u32 { Word = 508625042u32; }
            else if Index == 4u32 { Word = 1194962076u32; }
            else if Index == 5u32 { Word = 1030826941u32; }
            else if Index == 6u32 { Word = 3537249253u32; }
            else { Word = 337348453u32; }
        } else if Variant == 2u32 && Target == 1u32 {
            if Index == 0u32 { Word = 3961799919u32; }
            else if Index == 1u32 { Word = 3493610123u32; }
            else if Index == 2u32 { Word = 1817578004u32; }
            else if Index == 3u32 { Word = 781503590u32; }
            else if Index == 4u32 { Word = 3673921536u32; }
            else if Index == 5u32 { Word = 2161293896u32; }
            else if Index == 6u32 { Word = 2536171503u32; }
            else { Word = 2611448061u32; }
        } else if Variant == 2u32 {
            if Index == 0u32 { Word = 2253515727u32; }
            else if Index == 1u32 { Word = 296468090u32; }
            else if Index == 2u32 { Word = 296649641u32; }
            else if Index == 3u32 { Word = 1495805468u32; }
            else if Index == 4u32 { Word = 3582698382u32; }
            else if Index == 5u32 { Word = 2908821218u32; }
            else if Index == 6u32 { Word = 3784447422u32; }
            else { Word = 1449443083u32; }
        } else if Target == 1u32 {
            if Index == 0u32 { Word = 2925244891u32; }
            else if Index == 1u32 { Word = 3665714992u32; }
            else if Index == 2u32 { Word = 1586712129u32; }
            else if Index == 3u32 { Word = 4186885183u32; }
            else if Index == 4u32 { Word = 3911555790u32; }
            else if Index == 5u32 { Word = 340654835u32; }
            else if Index == 6u32 { Word = 1565791272u32; }
            else { Word = 2661219382u32; }
        } else {
            if Index == 0u32 { Word = 961867554u32; }
            else if Index == 1u32 { Word = 1835165924u32; }
            else if Index == 2u32 { Word = 1819063489u32; }
            else if Index == 3u32 { Word = 1775435410u32; }
            else if Index == 4u32 { Word = 3530955624u32; }
            else if Index == 5u32 { Word = 3139781555u32; }
            else if Index == 6u32 { Word = 320650148u32; }
            else { Word = 3619038940u32; }
        }
        Result = Appendˉu32(Result, Word);
        Index = Index + 1u32;
    }
    return Result;
}

export fn Publisherˉmetadataˉrequestˉforˉvariant(
    Target: u32,
    Variant: u32,
    Module: bytes,
    Startupˉobject: bytes
) -> Publisherˉmetadataˉrequestˉresult {
    if (Target != 1u32 && Target != 2u32) || Variant > 4u32 {
        return Publisherˉmetadataˉrequestˉresult(false, Empty(Module));
    }
    var Startupˉbytes: u32 = 168u32;
    if Target == 2u32 { Startupˉbytes = 164u32; }
    var Moduleˉbytes: u32 = 29170u32;
    var Mainˉoffset: u32 = 3001u32;
    var Beginˉoffset: u32 = 789u32;
    var Applyˉoffset: u32 = 0u32;
    if Variant == 1u32 {
        Moduleˉbytes = 41268u32;
        Mainˉoffset = 1178u32;
    }
    if Variant == 2u32 {
        Moduleˉbytes = 181772u32;
        Mainˉoffset = 0u32;
        Beginˉoffset = 5475u32;
        Applyˉoffset = 4686u32;
    }
    if Variant == 3u32 {
        Moduleˉbytes = 41365u32;
        Mainˉoffset = 0u32;
        Beginˉoffset = 5475u32;
        Applyˉoffset = 4686u32;
    }
    if Variant == 4u32 {
        Moduleˉbytes = 115107u32;
        Mainˉoffset = 18902u32;
    }
    if Bytesˉlength(Module) != Moduleˉbytes ||
        Bytesˉlength(Startupˉobject) != Startupˉbytes {
        return Publisherˉmetadataˉrequestˉresult(false, Empty(Module));
    }
    let Moduleˉdigest: bytes = Digest(Module);
    let Startupˉdigest: bytes = Digest(Startupˉobject);
    if !Admission.Nativeˉhostedˉverifierˉpublisherˉmoduleˉdigestˉisˉvalidˉforˉvariant(
            Moduleˉdigest, 0u32, Variant
        ) ||
        !Digestˉmatches(Startupˉdigest, 3u32, Target) {
        return Publisherˉmetadataˉrequestˉresult(false, Empty(Module));
    }

    var Result: bytes = Empty(Module);
    Result = Appendˉu32(Result, 1297110615u32);
    Result = Appendˉu32(Result, 1u32);
    Result = Appendˉu32(Result, 112u32);
    Result = Appendˉu32(Result, Target);
    Result = Appendˉu32(Result, 5u32);
    Result = Appendˉu32(Result, 0u32);
    Result = Appendˉu32(Result, Mainˉoffset);
    Result = Appendˉu32(Result, Beginˉoffset);
    Result = Appendˉu32(Result, Applyˉoffset);
    Result = Appendˉu32(Result, Variant);
    Result = Appendˉu32(Result, 0u32);
    Result = Appendˉu32(Result, 0u32);
    Result = Bytesˉconcat(Result, Startupˉimageˉdigest(Module, Target, Variant));
    Result = Bytesˉconcat(Result, Moduleˉdigest);
    return Publisherˉmetadataˉrequestˉresult(
        Bytesˉlength(Result) == 112u32,
        Result
    );
}

export fn Publisherˉmetadataˉrequest(
    Target: u32,
    Module: bytes,
    Startupˉobject: bytes
) -> Publisherˉmetadataˉrequestˉresult {
    return Publisherˉmetadataˉrequestˉforˉvariant(
        Target, 0u32, Module, Startupˉobject
    );
}
