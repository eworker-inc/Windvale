module Linkerˉnativeˉhostedˉverifierˉpublisherˉmetadataˉrequest profile portable;

import Foundationˉsha256ˉstreaming as Sha;
import Linkerˉnativeˉhostedˉverifierˉapplicationˉpublisherˉmetadataˉadmission as Admission;
import Linkerˉnativeˉhostedˉverifierˉpublisherˉconstructionˉdigests as Digests;

export record Publisherˉmetadataˉrequestˉresult {
    Valid: bool;
    Value: bytes;
}

fn Empty(Input: bytes) -> bytes {
    return Bytesˉslice(Input, 0u32, 0u32);
}

fn Appendˉu32(Output: bytes, Value: u32) -> bytes {
    return Bytesˉconcat(Output, Bytesˉfromˉu32ˉlittle(Value));
}

fn Digest(Input: bytes) -> bytes {
    var State: Sha.Foundationˉsha256ˉstream =
        Sha.Foundationˉsha256ˉbegin(Input);
    State = Sha.Foundationˉsha256ˉupdate(State, Input);
    return Sha.Foundationˉsha256ˉfinishˉraw(State);
}

fn Digestˉmatches(
    Actual: bytes,
    Identity: u32,
    Target: u32
) -> bool {
    if Bytesˉlength(Actual) != 32u32 { return false; }
    let Expected: bytes =
        Digests.Publisherˉconstructionˉexpectedˉdigest(
            Actual, Identity, Target
        );
    var Index: u32 = 0u32;
    while Index < 32u32 {
        if Bytesˉreadˉu8(Actual, Index) !=
            Bytesˉreadˉu8(Expected, Index) {
            return false;
        }
        Index = Index + 1u32;
    }
    return true;
}

fn Startupˉimageˉdigest(Input: bytes, Target: u32) -> bytes {
    var Result: bytes = Empty(Input);
    var Index: u32 = 0u32;
    while Index < 8u32 {
        var Word: u32 = 0u32;
        if Target == 1u32 {
            if Index == 0u32 { Word = 2925244891u32; }
            else if Index == 1u32 { Word = 3665714992u32; }
            else if Index == 2u32 { Word = 1586712129u32; }
            else if Index == 3u32 { Word = 4186885183u32; }
            else if Index == 4u32 { Word = 3911555790u32; }
            else if Index == 5u32 { Word = 340654835u32; }
            else if Index == 6u32 { Word = 1565791272u32; }
            else { Word = 2661219382u32; }
        } else {
            if Index == 0u32 { Word = 961867554u32; }
            else if Index == 1u32 { Word = 1835165924u32; }
            else if Index == 2u32 { Word = 1819063489u32; }
            else if Index == 3u32 { Word = 1775435410u32; }
            else if Index == 4u32 { Word = 3530955624u32; }
            else if Index == 5u32 { Word = 3139781555u32; }
            else if Index == 6u32 { Word = 320650148u32; }
            else { Word = 3619038940u32; }
        }
        Result = Appendˉu32(Result, Word);
        Index = Index + 1u32;
    }
    return Result;
}

export fn Publisherˉmetadataˉrequestˉforˉvariant(
    Target: u32,
    Variant: u32,
    Module: bytes,
    Startupˉobject: bytes
) -> Publisherˉmetadataˉrequestˉresult {
    if (Target != 1u32 && Target != 2u32) || Variant > 1u32 {
        return Publisherˉmetadataˉrequestˉresult(false, Empty(Module));
    }
    var Startupˉbytes: u32 = 168u32;
    if Target == 2u32 { Startupˉbytes = 164u32; }
    var Moduleˉbytes: u32 = 29170u32;
    var Mainˉoffset: u32 = 3001u32;
    if Variant == 1u32 {
        Moduleˉbytes = 41268u32;
        Mainˉoffset = 1178u32;
    }
    if Bytesˉlength(Module) != Moduleˉbytes ||
        Bytesˉlength(Startupˉobject) != Startupˉbytes {
        return Publisherˉmetadataˉrequestˉresult(false, Empty(Module));
    }
    let Moduleˉdigest: bytes = Digest(Module);
    let Startupˉdigest: bytes = Digest(Startupˉobject);
    if !Admission.Nativeˉhostedˉverifierˉpublisherˉmoduleˉdigestˉisˉvalidˉforˉvariant(
            Moduleˉdigest, 0u32, Variant
        ) ||
        !Digestˉmatches(Startupˉdigest, 3u32, Target) {
        return Publisherˉmetadataˉrequestˉresult(false, Empty(Module));
    }

    var Result: bytes = Empty(Module);
    Result = Appendˉu32(Result, 1297110615u32);
    Result = Appendˉu32(Result, 1u32);
    Result = Appendˉu32(Result, 112u32);
    Result = Appendˉu32(Result, Target);
    Result = Appendˉu32(Result, 5u32);
    Result = Appendˉu32(Result, 0u32);
    Result = Appendˉu32(Result, Mainˉoffset);
    Result = Appendˉu32(Result, 789u32);
    Result = Appendˉu32(Result, 0u32);
    Result = Appendˉu32(Result, Variant);
    Result = Appendˉu32(Result, 0u32);
    Result = Appendˉu32(Result, 0u32);
    Result = Bytesˉconcat(Result, Startupˉimageˉdigest(Module, Target));
    Result = Bytesˉconcat(Result, Moduleˉdigest);
    return Publisherˉmetadataˉrequestˉresult(
        Bytesˉlength(Result) == 112u32,
        Result
    );
}

export fn Publisherˉmetadataˉrequest(
    Target: u32,
    Module: bytes,
    Startupˉobject: bytes
) -> Publisherˉmetadataˉrequestˉresult {
    return Publisherˉmetadataˉrequestˉforˉvariant(
        Target, 0u32, Module, Startupˉobject
    );
}
