module Linkerˉnativeˉhostedˉverifierˉpublisherˉwindowsˉmaterialization profile portable;

import Linkerˉnativeˉhostedˉcontainerˉbyteˉconstruction as Build;

fn Response(Input: bytes, Status: u32) -> bytes {
    var Result: bytes = Build.Empty(Input);
    Result = Build.Appendˉu32(Result, 1331123799u32);
    Result = Build.Appendˉu32(Result, 1u32);
    var Total: u32 = 32u32;
    var Offset: u32 = 0u32;
    var Applicationˉbytes: u32 = 0u32;
    var Target: u32 = 0u32;
    if Status == 0u32 {
        Total = 256032u32;
        Offset = 32u32;
        Applicationˉbytes = 256000u32;
        Target = 1u32;
    }
    Result = Build.Appendˉu32(Result, Total);
    Result = Build.Appendˉu32(Result, Status);
    Result = Build.Appendˉu32(Result, Bytesˉlength(Input));
    Result = Build.Appendˉu32(Result, Offset);
    Result = Build.Appendˉu32(Result, Applicationˉbytes);
    return Build.Appendˉu32(Result, Target);
}

fn Envelopeˉvalid(Input: bytes) -> bool {
    return Bytesˉlength(Input) == 260608u32 &&
        Bytesˉreadˉu32ˉlittle(Input, 0u32) == 1297569367u32 &&
        Bytesˉreadˉu32ˉlittle(Input, 4u32) == 1u32 &&
        Bytesˉreadˉu32ˉlittle(Input, 8u32) == 260608u32 &&
        Bytesˉreadˉu32ˉlittle(Input, 12u32) == 1u32 &&
        Bytesˉreadˉu32ˉlittle(Input, 16u32) == 64u32 &&
        Bytesˉreadˉu32ˉlittle(Input, 20u32) == 248832u32 &&
        Bytesˉreadˉu32ˉlittle(Input, 24u32) == 248896u32 &&
        Bytesˉreadˉu32ˉlittle(Input, 28u32) == 416u32 &&
        Bytesˉreadˉu32ˉlittle(Input, 32u32) == 249312u32 &&
        Bytesˉreadˉu32ˉlittle(Input, 36u32) == 7040u32 &&
        Bytesˉreadˉu32ˉlittle(Input, 40u32) == 256352u32 &&
        Bytesˉreadˉu32ˉlittle(Input, 44u32) == 128u32 &&
        Bytesˉreadˉu32ˉlittle(Input, 48u32) == 256480u32 &&
        Bytesˉreadˉu32ˉlittle(Input, 52u32) == 4128u32 &&
        Bytesˉreadˉu32ˉlittle(Input, 56u32) == 0u32 &&
        Bytesˉreadˉu32ˉlittle(Input, 60u32) == 0u32;
}

fn Baseˉvalid(Base: bytes) -> bool {
    return Bytesˉlength(Base) == 248832u32 &&
        Bytesˉreadˉu16ˉlittle(Base, 0u32) == 23117u32 &&
        Bytesˉreadˉu32ˉlittle(Base, 60u32) == 128u32 &&
        Bytesˉreadˉu32ˉlittle(Base, 128u32) == 17744u32 &&
        Bytesˉreadˉu16ˉlittle(Base, 132u32) == 34404u32 &&
        Bytesˉreadˉu16ˉlittle(Base, 134u32) == 3u32 &&
        Bytesˉreadˉu16ˉlittle(Base, 152u32) == 523u32 &&
        Bytesˉreadˉu32ˉlittle(Base, 156u32) == 239616u32 &&
        Bytesˉreadˉu32ˉlittle(Base, 168u32) == 4096u32 &&
        Bytesˉreadˉu32ˉlittle(Base, 208u32) == 143986688u32 &&
        Bytesˉreadˉu32ˉlittle(Base, 272u32) == 245760u32 &&
        Bytesˉreadˉu32ˉlittle(Base, 304u32) == 143982592u32 &&
        Bytesˉreadˉu32ˉlittle(Base, 360u32) == 245952u32 &&
        Bytesˉreadˉu32ˉlittle(Base, 364u32) == 128u32 &&
        Bytesˉreadˉu32ˉlittle(Base, 400u32) == 239490u32 &&
        Bytesˉreadˉu32ˉlittle(Base, 408u32) == 239616u32 &&
        Bytesˉreadˉu32ˉlittle(Base, 412u32) == 512u32 &&
        Bytesˉreadˉu32ˉlittle(Base, 444u32) == 245760u32 &&
        Bytesˉreadˉu32ˉlittle(Base, 452u32) == 240128u32 &&
        Bytesˉreadˉu32ˉlittle(Base, 484u32) == 143982592u32 &&
        Bytesˉreadˉu32ˉlittle(Base, 492u32) == 248320u32;
}

fn Recordsˉvalid(Construction: bytes, Objects: bytes, Metadata: bytes, Imports: bytes) -> bool {
    return Bytesˉlength(Construction) == 416u32 &&
        Bytesˉreadˉu32ˉlittle(Construction, 0u32) == 1380144727u32 &&
        Bytesˉreadˉu32ˉlittle(Construction, 4u32) == 1u32 &&
        Bytesˉreadˉu32ˉlittle(Construction, 12u32) == 1u32 &&
        Bytesˉreadˉu32ˉlittle(Construction, 72u32) == 235394u32 &&
        Bytesˉreadˉu32ˉlittle(Construction, 132u32) == 240016u32 &&
        Bytesˉreadˉu32ˉlittle(Construction, 136u32) == 243600u32 &&
        Bytesˉreadˉu32ˉlittle(Construction, 156u32) == 256000u32 &&
        Bytesˉlength(Objects) == 7040u32 &&
        Bytesˉreadˉu32ˉlittle(Objects, 0u32) == 1330206295u32 &&
        Bytesˉreadˉu32ˉlittle(Objects, 4u32) == 1u32 &&
        Bytesˉreadˉu32ˉlittle(Objects, 8u32) == 7040u32 &&
        Bytesˉreadˉu32ˉlittle(Objects, 12u32) == 0u32 &&
        Bytesˉreadˉu32ˉlittle(Objects, 20u32) == 1u32 &&
        Bytesˉreadˉu32ˉlittle(Objects, 24u32) == 64u32 &&
        Bytesˉreadˉu32ˉlittle(Objects, 28u32) == 5u32 &&
        Bytesˉreadˉu32ˉlittle(Objects, 32u32) == 69u32 &&
        Bytesˉreadˉu32ˉlittle(Objects, 36u32) == 5286u32 &&
        Bytesˉreadˉu32ˉlittle(Objects, 40u32) == 5355u32 &&
        Bytesˉreadˉu32ˉlittle(Objects, 44u32) == 1685u32 &&
        Bytesˉlength(Metadata) == 128u32 &&
        Bytesˉreadˉu32ˉlittle(Metadata, 0u32) == 1347835479u32 &&
        Bytesˉreadˉu32ˉlittle(Metadata, 4u32) == 1u32 &&
        Bytesˉreadˉu32ˉlittle(Metadata, 8u32) == 128u32 &&
        Bytesˉreadˉu32ˉlittle(Metadata, 12u32) == 1u32 &&
        Bytesˉlength(Imports) == 4128u32 &&
        Bytesˉreadˉu32ˉlittle(Imports, 0u32) == 1296651863u32 &&
        Bytesˉreadˉu32ˉlittle(Imports, 4u32) == 1u32 &&
        Bytesˉreadˉu32ˉlittle(Imports, 8u32) == 4128u32 &&
        Bytesˉreadˉu32ˉlittle(Imports, 12u32) == 0u32 &&
        Bytesˉreadˉu32ˉlittle(Imports, 20u32) == 32u32 &&
        Bytesˉreadˉu32ˉlittle(Imports, 24u32) == 4096u32 &&
        Bytesˉreadˉu32ˉlittle(Imports, 28u32) == 253952u32;
}

fn Header(Base: bytes) -> bytes {
    var Result: bytes = Bytesˉslice(Base, 0u32, 512u32);
    Result = Build.Patchˉu8(Result, 154u32, 5u8);
    Result = Build.Patchˉu32(Result, 156u32, 246784u32);
    Result = Build.Patchˉu32(Result, 168u32, 4096u32);
    Result = Build.Patchˉu32(Result, 208u32, 143994880u32);
    Result = Build.Patchˉu32(Result, 272u32, 253952u32);
    Result = Build.Patchˉu32(Result, 304u32, 143990784u32);
    Result = Build.Patchˉu32(Result, 360u32, 254192u32);
    Result = Build.Patchˉu32(Result, 364u32, 160u32);
    Result = Build.Patchˉu32(Result, 400u32, 246485u32);
    Result = Build.Patchˉu32(Result, 408u32, 246784u32);
    Result = Build.Patchˉu32(Result, 444u32, 253952u32);
    Result = Build.Patchˉu32(Result, 452u32, 247296u32);
    Result = Build.Patchˉu32(Result, 484u32, 143990784u32);
    return Build.Patchˉu32(Result, 492u32, 255488u32);
}

export fn Publisherˉwindowsˉmaterialize(Input: bytes) -> bytes {
    if !Envelopeˉvalid(Input) { return Response(Input, 1u32); }
    let Base: bytes = Bytesˉslice(Input, 64u32, 248832u32);
    let Construction: bytes = Bytesˉslice(Input, 248896u32, 416u32);
    let Objects: bytes = Bytesˉslice(Input, 249312u32, 7040u32);
    let Metadata: bytes = Bytesˉslice(Input, 256352u32, 128u32);
    let Imports: bytes = Bytesˉslice(Input, 256480u32, 4128u32);
    if !Baseˉvalid(Base) || !Recordsˉvalid(Construction, Objects, Metadata, Imports) {
        return Response(Input, 2u32);
    }
    var Application: bytes = Header(Base);
    Application = Bytesˉconcat(Application, Bytesˉslice(Objects, 64u32, 5u32));
    Application = Bytesˉconcat(Application, Build.Zeros(4091u32));
    Application = Bytesˉconcat(Application, Bytesˉslice(Base, 4608u32, 235394u32));
    Application = Bytesˉconcat(Application, Build.Zeros(14u32));
    Application = Bytesˉconcat(Application, Bytesˉslice(Objects, 69u32, 5286u32));
    Application = Bytesˉconcat(Application, Build.Zeros(10u32));
    Application = Bytesˉconcat(Application, Bytesˉslice(Objects, 5355u32, 1685u32));
    Application = Bytesˉconcat(Application, Build.Zeros(299u32));
    Application = Bytesˉconcat(Application, Bytesˉslice(Imports, 32u32, 4096u32));
    Application = Bytesˉconcat(Application, Bytesˉslice(Base, 244224u32, 1504u32));
    Application = Bytesˉconcat(Application, Metadata);
    Application = Bytesˉconcat(Application, Bytesˉslice(Base, 245856u32, 2976u32));
    if Bytesˉlength(Application) != 256000u32 { return Response(Input, 3u32); }
    return Bytesˉconcat(Response(Input, 0u32), Application);
}
