module Linkerˉnativeˉhostedˉverifierˉstartupˉadmission profile portable;

import Foundationˉsha256ˉstreaming as Sha256;
import Linkerˉnativeˉhostedˉcontainerˉbyteˉconstruction as Build;
import Linkerˉnativeˉhostedˉverifierˉlayout as Layout;
import Linkerˉnativeˉhostedˉverifierˉstartupˉtargets as Targets;

fn Hexˉascii(Value: u32) -> u32 {
    if Value < 10u32 { return Value + 48u32; }
    return Value + 87u32;
}

fn Digestˉmatches(Input: bytes, Expected: text) -> bool {
    var State: Sha256.Foundationˉsha256ˉstream =
        Sha256.Foundationˉsha256ˉbegin(Input);
    State = Sha256.Foundationˉsha256ˉupdate(State, Input);
    let Digest: bytes = Sha256.Foundationˉsha256ˉfinishˉraw(State);
    let Expectedˉbytes: bytes = Textˉtoˉutf8(Expected);
    if Bytesˉlength(Digest) != 32u32 ||
        Bytesˉlength(Expectedˉbytes) != 64u32 {
        return false;
    }
    var Index: u32 = 0u32;
    while Index < 32u32 {
        let Value: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(Digest, Index));
        if U32ˉfromˉu8(Bytesˉreadˉu8(Expectedˉbytes, Index * 2u32)) !=
                Hexˉascii(Value >> 4u32) ||
            U32ˉfromˉu8(Bytesˉreadˉu8(Expectedˉbytes, Index * 2u32 + 1u32)) !=
                Hexˉascii(Value & 15u32) {
            return false;
        }
        Index = Index + 1u32;
    }
    return true;
}

fn Windowsˉverifierˉpatch(Index: u32) -> u32 {
    if Index == 0u32 { return 25u32; }
    if Index == 1u32 { return 32u32; }
    if Index == 2u32 { return 47u32; }
    if Index == 3u32 { return 62u32; }
    if Index == 4u32 { return 77u32; }
    if Index == 5u32 { return 92u32; }
    if Index == 6u32 { return 107u32; }
    if Index == 7u32 { return 122u32; }
    if Index == 8u32 { return 129u32; }
    if Index == 9u32 { return 144u32; }
    if Index == 10u32 { return 159u32; }
    if Index == 11u32 { return 174u32; }
    if Index == 12u32 { return 189u32; }
    if Index == 13u32 { return 212u32; }
    if Index == 14u32 { return 235u32; }
    if Index == 15u32 { return 258u32; }
    if Index == 16u32 { return 281u32; }
    if Index == 17u32 { return 304u32; }
    if Index == 18u32 { return 319u32; }
    if Index == 19u32 { return 347u32; }
    if Index == 20u32 { return 364u32; }
    if Index == 21u32 { return 384u32; }
    if Index == 22u32 { return 409u32; }
    if Index == 23u32 { return 432u32; }
    if Index == 24u32 { return 439u32; }
    if Index == 25u32 { return 454u32; }
    if Index == 26u32 { return 469u32; }
    if Index == 27u32 { return 484u32; }
    if Index == 28u32 { return 499u32; }
    if Index == 29u32 { return 514u32; }
    if Index == 30u32 { return 529u32; }
    if Index == 31u32 { return 568u32; }
    if Index == 32u32 { return 646u32; }
    if Index == 33u32 { return 653u32; }
    if Index == 34u32 { return 660u32; }
    if Index == 35u32 { return 749u32; }
    if Index == 36u32 { return 838u32; }
    if Index == 37u32 { return 957u32; }
    if Index == 38u32 { return 986u32; }
    if Index == 39u32 { return 1000u32; }
    if Index == 40u32 { return 1046u32; }
    if Index == 41u32 { return 1114u32; }
    if Index == 42u32 { return 1130u32; }
    if Index == 43u32 { return 1197u32; }
    return 1255u32;
}

