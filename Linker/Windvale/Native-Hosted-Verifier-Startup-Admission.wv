export fn Nativeˉhostedˉverifierˉstartupˉrelocationsˉareˉvalidˉforˉprofile(
    Runtime: bytes,
    Startup: bytes,
    Expectedˉprofile: u32
) -> bool {
    let Value: Layout.Nativeˉhostedˉverifierˉlayout =
        Layout.Nativeˉhostedˉverifierˉplanˉforˉprofile(
            Runtime,
            Expectedˉprofile
        );
    if !Value.Valid || Bytesˉlength(Startup) != Value.Startupˉbytes {
        return false;
    }
    var Count: u32 = 24u32;
    var Expected: text =
        "1d1379ec117e347283cbc4c9bc1750a246a9d6e43d09ef9217f9353670e9e2b5";
    if Value.Target == 1u32 {
        Count = 45u32;
        Expected =
            "b75a6601cae7bb96d42f85b68a3aedfdb40145af5ddbbf5b548c7f8c898559d9";
    }
    if Expectedˉprofile == 6u32 {
        Count = 29u32;
        Expected =
            "2c75cbfa34b188d8a5847ac462a00c9e3f799a44fb09b6959bd2b310a289f20f";
        if Value.Target == 1u32 {
            Count = 50u32;
            Expected =
                "d95553d1ba1f1299a48f42ba75a95068b2137702302ca947ddaa0387c4c7edc8";
        }
    }
    let Targetˉbytes: bytes =
        Targets.Nativeˉhostedˉverifierˉstartupˉtargets(Runtime, Value);
    if Bytesˉlength(Targetˉbytes) != Count * 4u32 { return false; }
    var Normalized: bytes = Bytesˉslice(
        Startup,
        0u32,
        Bytesˉlength(Startup)
    );
    var Index: u32 = 0u32;
    while Index < Count {
        var Patch: u32 = Linuxˉverifierˉpatch(Index);
        if Expectedˉprofile == 6u32 {
            Patch = Linuxˉinspectorˉpatch(Index);
        }
        if Value.Target == 1u32 {
            Patch = Windowsˉverifierˉpatch(Index);
            if Expectedˉprofile == 6u32 {
                Patch = Windowsˉinspectorˉpatch(Index);
            }
        }
        let Sourceˉend: u32 = Value.Textˉaddress + Patch + 4u32;
        let Target: u32 = Bytesˉreadˉu32ˉlittle(Targetˉbytes, Index * 4u32);
        if Target < Sourceˉend ||
            Bytesˉreadˉu32ˉlittle(Startup, Patch) != Target - Sourceˉend {
            return false;
        }
        Normalized = Build.Replace(
            Normalized,
            Patch,
            4u32,
            Build.Zeros(4u32)
        );
        Index = Index + 1u32;
    }
    return Digestˉmatches(Normalized, Expected);
}

export fn Nativeˉhostedˉverifierˉstartupˉrelocationsˉareˉvalid(
    Runtime: bytes,
    Startup: bytes
) -> bool {
    return Nativeˉhostedˉverifierˉstartupˉrelocationsˉareˉvalidˉforˉprofile(
        Runtime,
        Startup,
        2u32
    );
}
