module Linkerˉconsoleˉapplicationˉplanˉbridge profile hosted;

import Linkerˉconsoleˉapplicationˉplan as Applicationˉplan;

capability file.read_bytes;

data Requestˉname: text = "console-application-plan-request.bin";

export fn Main() -> bytes {
    let Input: bytes = file.read_bytes(Requestˉname);
    let Plan: Applicationˉplan.Consoleˉapplicationˉplanˉresult = Applicationˉplan.Consoleˉapplicationˉplan(Input);
    return Plan.Value;
}
