module Nativeˉhostedˉverifierˉcontainerˉtool profile hosted;

import Linkerˉnativeˉhostedˉverifierˉcontainer as Container;

capability console.write_line;
capability diagnostic.write_line;
capability file.read_bytes;
capability file.write_bytes;
capability process.argument;
capability process.argument_count;

fn Pathsˉareˉequal(Left: text, Right: text) -> bool {
    let Leftˉbytes: bytes = Textˉtoˉutf8(Left);
    let Rightˉbytes: bytes = Textˉtoˉutf8(Right);
    let Length: u32 = Bytesˉlength(Leftˉbytes);
    if Length != Bytesˉlength(Rightˉbytes) { return false; }
    var Index: u32 = 0u32;
    while Index < Length {
        if Bytesˉreadˉu8(Leftˉbytes, Index) !=
            Bytesˉreadˉu8(Rightˉbytes, Index) {
            return false;
        }
        Index = Index + 1u32;
    }
    return true;
}

fn Usage() -> i32 {
    diagnostic.write_line(
        "Usage: wvhostverifiercompose [publisher-admission|wvb-runner|wvo-inspector|console-verifier] <runtime.wvhr> <platform.wvhb> <startup.wvsd> <bundle.wvsi> <application>"
    );
    return 64;
}

fn Outputˉaliasesˉinput(Output: text, Base: u32) -> bool {
    var Index: u32 = 0u32;
    while Index < 4u32 {
        if Pathsˉareˉequal(Output, process.argument(Base + Index)) {
            return true;
        }
        Index = Index + 1u32;
    }
    return false;
}

export fn Main() -> i32 {
    let Arguments: u32 = process.argument_count();
    if Arguments != 5u32 && Arguments != 6u32 { return Usage(); }
    var Base: u32 = 0u32;
    var Expectedˉprofile: u32 = 2u32;
    if Arguments == 6u32 {
        if Pathsˉareˉequal(process.argument(0u32), "publisher-admission") {
            Expectedˉprofile = 8u32;
        } else if Pathsˉareˉequal(process.argument(0u32), "wvb-runner") {
            Expectedˉprofile = 5u32;
        } else if Pathsˉareˉequal(process.argument(0u32), "wvo-inspector") {
            Expectedˉprofile = 6u32;
        } else if Pathsˉareˉequal(process.argument(0u32), "console-verifier") {
            Expectedˉprofile = 7u32;
        } else {
            return Usage();
        }
        Base = 1u32;
    }
    let Outputˉpath: text = process.argument(Base + 4u32);
    if Outputˉaliasesˉinput(Outputˉpath, Base) { return Usage(); }
    let Result: Container.Nativeˉhostedˉverifierˉcontainerˉresult =
        Container.Nativeˉhostedˉverifierˉcontainerˉforˉprofile(
            file.read_bytes(process.argument(Base)),
            file.read_bytes(process.argument(Base + 1u32)),
            file.read_bytes(process.argument(Base + 2u32)),
            file.read_bytes(process.argument(Base + 3u32)),
            Expectedˉprofile
        );
    if !Result.Valid {
        diagnostic.write_line(
            Textˉconcat(
                "verifier container status=Rejected phase=",
                U32ˉformat(Result.Failure)
            )
        );
        return 2;
    }
    file.write_bytes(Outputˉpath, Result.Value);
    console.write_line(
        Textˉconcat(
            "verifier container status=Valid bytes=",
            U32ˉformat(Bytesˉlength(Result.Value))
        )
    );
    return 0;
}
