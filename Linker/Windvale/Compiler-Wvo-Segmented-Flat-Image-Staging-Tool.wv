#!wv/1 en@1
module Linkerˉcompilerˉwvoˉsegmentedˉflatˉimageˉstagingˉtool;
profile hosted;
platform linux, windows;
authority application;
requires capability console.write_line version 1;
requires capability diagnostic.write_line version 1;
requires capability file.read_bytes version 1;
requires capability file.write_bytes version 1;
requires capability process.argument version 1;
requires capability process.argument_count version 1;

import Compilerˉnativeˉx64ˉloweringˉstagingˉwvoˉenvelope as Envelope;
import Compilerˉnativeˉx64ˉloweringˉstagingˉwvoˉsymbols as Symbols;
import Compilerˉnativeˉx64ˉloweringˉstagingˉwvoˉrelocations as Relocations;
import Linkerˉcompilerˉflatˉimageˉstagingˉmanifest as Imageˉmanifest;
import Linkerˉcompilerˉflatˉimageˉstagingˉresources as Resources;
import Linkerˉcompilerˉwvoˉsegmentedˉflatˉimage as Flat;
import Linkerˉcompilerˉwvoˉsegmentedˉflatˉimageˉverification as Verification;


fn Empty(Input: bytes) -> bytes {
    return Bytesˉslice(Input, 0u32, 0u32);
}

fn Appendˉu32(Output: bytes, Value: u32) -> bytes {
    return Bytesˉconcat(Output, Bytesˉfromˉu32ˉlittle(Value));
}

fn Resourceˉfailure(
    Status: Resources.Linkerˉcompilerˉflatˉimageˉresourceˉstatus
) -> i32 {
    diagnostic.write_line(
        Textˉconcat(
            "segmented compiler image staging resource=",
            Enumˉname(Status)
        )
    );
    return 1;
}

fn Envelopeˉfailure(
    Status: Envelope.Compilerˉnativeˉx64ˉstagingˉwvoˉenvelopeˉstatus
) -> i32 {
    diagnostic.write_line(
        Textˉconcat(
            "segmented compiler image staging envelope=",
            Enumˉname(Status)
        )
    );
    return 1;
}

fn Symbolˉfailure(
    Status: Symbols.Compilerˉnativeˉx64ˉstagingˉwvoˉsymbolsˉstatus
) -> i32 {
    diagnostic.write_line(
        Textˉconcat(
            "segmented compiler image staging symbols=",
            Enumˉname(Status)
        )
    );
    return 1;
}

fn Linkˉfailure(
    Status: Flat.Linkerˉcompilerˉwvoˉsegmentedˉstatus
) -> i32 {
    diagnostic.write_line(
        Textˉconcat(
            "segmented compiler image staging link=",
            Enumˉname(Status)
        )
    );
    return 1;
}

fn Verificationˉfailure(
    Status:
        Verification.Linkerˉcompilerˉwvoˉsegmentedˉverificationˉstatus
) -> i32 {
    diagnostic.write_line(
        Textˉconcat(
            "segmented compiler image staging verification=",
            Enumˉname(Status)
        )
    );
    return 1;
}

fn Sourceˉchunk(Prefix: text, Index: u32) -> bytes {
    return file.read_bytes(
        Resources.Linkerˉcompilerˉflatˉimageˉsourceˉchunkˉresource(
            Prefix,
            Index
        )
    );
}

fn Chunkˉatˉposition(
    Stagingˉmanifest: bytes,
    Chunks: u32,
    Position: u32
) -> u32 {
    var Index: u32 = 0u32;
    while Index < Chunks {
        let Entry: u32 = 24u32 + Index * 12u32;
        let Current: u32 =
            Bytesˉreadˉu32ˉlittle(Stagingˉmanifest, Entry + 4u32);
        if Current == Position { return Index; }
        if Current > Position { return 4294967295u32; }
        Index = Index + 1u32;
    }
    return 4294967295u32;
}

fn Textˉequal(Left: text, Right: text) -> bool {
    let A: bytes = Textˉtoˉutf8(Left);
    let B: bytes = Textˉtoˉutf8(Right);
    if Bytesˉlength(A) != Bytesˉlength(B) { return false; }
    var Index: u32 = 0u32;
    while Index < Bytesˉlength(A) {
        if Bytesˉreadˉu8(A, Index) != Bytesˉreadˉu8(B, Index) { return false; }
        Index = Index + 1u32;
    }
    return true;
}

fn Extraˉresourceˉvalid(
    Name: text, Sourceˉprefix: text, Sourceˉmanifest: text,
    Outputˉprefix: text, Outputˉmanifest: text, Chunks: u32
) -> bool {
    let Length: u32 = Bytesˉlength(Textˉtoˉutf8(Name));
    if Length == 0u32 || Length > 4095u32 ||
        Textˉequal(Name, Sourceˉmanifest) || Textˉequal(Name, Outputˉmanifest) { return false; }
    var Index: u32 = 0u32;
    while Index < Chunks {
        if Textˉequal(Name, Resources.Linkerˉcompilerˉflatˉimageˉsourceˉchunkˉresource(
            Sourceˉprefix, Index)) ||
            Textˉequal(Name, Resources.Linkerˉcompilerˉflatˉimageˉoutputˉchunkˉresource(
                Outputˉprefix, Index)) { return false; }
        Index = Index + 1u32;
    }
    return true;
}

fn Sharedˉconfiguration(
    Summary: Symbols.Compilerˉnativeˉx64ˉstagingˉwvoˉsymbolsˉsummary,
    Envelopeˉsummary: Envelope.Compilerˉnativeˉx64ˉstagingˉwvoˉenvelopeˉsummary,
    Providers: bytes
) -> bytes {
    var Output: bytes = Textˉtoˉutf8("WVSC");
    Output = Appendˉu32(Output, 1u32);
    Output = Appendˉu32(Output, 64u32);
    Output = Appendˉu32(Output, Envelopeˉsummary.Textˉbytes + Envelopeˉsummary.Readˉonlyˉbytes);
    Output = Appendˉu32(Output, Summary.Mainˉoffset);
    Output = Appendˉu32(Output, Summary.Mainˉbytes);
    Output = Appendˉu32(Output, Envelopeˉsummary.Textˉbytes);
    Output = Appendˉu32(Output, Summary.Blobˉbytes);
    Output = Appendˉu32(Output, Envelopeˉsummary.Textˉbytes + Summary.Directoryˉoffset);
    Output = Appendˉu32(Output, Summary.Directoryˉbytes);
    Output = Appendˉu32(Output, Summary.Closeˉoffset);
    Output = Appendˉu32(Output, 17u32);
    if Bytesˉlength(Providers) == 40u32 {
        Output = Appendˉu32(Output, Bytesˉreadˉu32ˉlittle(Providers, 12u32));
        Output = Appendˉu32(Output, Bytesˉreadˉu32ˉlittle(Providers, 16u32));
        Output = Appendˉu32(Output, Bytesˉreadˉu32ˉlittle(Providers, 20u32));
    } else {
        Output = Appendˉu32(Output, 0u32);
        Output = Appendˉu32(Output, 0u32);
        Output = Appendˉu32(Output, 0u32);
    }
    return Appendˉu32(Output, 0u32);
}

fn Sharedˉsourceˉvalidate(
    Sourceˉprefix: text, Stagingˉmanifest: bytes, Prefix: bytes,
    Readˉonlyˉheader: bytes, Symbolˉchunk: bytes, Relocationˉchunk: bytes,
    Summary: Symbols.Compilerˉnativeˉx64ˉstagingˉwvoˉsymbolsˉsummary,
    Envelopeˉsummary: Envelope.Compilerˉnativeˉx64ˉstagingˉwvoˉenvelopeˉsummary,
    Chunks: u32
) -> bool {
    if !Summary.Sharedˉprofile { return false; }
    let R: Relocations.Compilerˉnativeˉx64ˉstagingˉwvoˉrelocationsˉsummary =
        Relocations.Compilerˉnativeˉx64ˉstagingˉwvoˉrelocationsˉvalidate(
            Stagingˉmanifest, Prefix, Readˉonlyˉheader, Symbolˉchunk, Relocationˉchunk);
    if R.Status != Relocations.Compilerˉnativeˉx64ˉstagingˉwvoˉrelocationsˉstatus.Valid {
        return false;
    }
    var Index: u32 = 0u32;
    var Readˉonlyˉchunks: u32 = 0u32;
    let Textˉend: u32 = 49u32 + Envelopeˉsummary.Textˉbytes;
    while Index < Chunks {
        let Position: u32 = Bytesˉreadˉu32ˉlittle(Stagingˉmanifest, 28u32 + Index * 12u32);
        if Position >= 49u32 && Position < Textˉend {
            if Relocations.Compilerˉnativeˉx64ˉstagingˉwvoˉtextˉchunkˉvalidate(
                Stagingˉmanifest, Prefix, Readˉonlyˉheader, Symbolˉchunk,
                Relocationˉchunk, Index, Sourceˉchunk(Sourceˉprefix, Index)) !=
                Relocations.Compilerˉnativeˉx64ˉstagingˉwvoˉrelocationsˉstatus.Valid {
                return false;
            }
        }
        if Position >= Textˉend + 27u32 && Position < Envelopeˉsummary.Symbolˉposition {
            if Position != Textˉend + 27u32 ||
                !Symbols.Compilerˉnativeˉx64ˉstagingˉwvoˉsharedˉdataˉvalidate(
                    Summary, Symbolˉchunk, Sourceˉchunk(Sourceˉprefix, Index)) { return false; }
            Readˉonlyˉchunks = Readˉonlyˉchunks + 1u32;
        }
        Index = Index + 1u32;
    }
    if Envelopeˉsummary.Readˉonlyˉbytes == 0u32 { return Readˉonlyˉchunks == 0u32; }
    return Readˉonlyˉchunks == 1u32;
}

export fn Main() -> i32 {
    let Arguments: u32 = process.argument_count();
    if Arguments != 4u32 && Arguments != 6u32 {
        diagnostic.write_line(
            "Usage: wvlink-stage <wvo-prefix> <manifest.wvop> <image-prefix> <image.wvli> [inspect|providers.wvsp configuration.wvsc]"
        );
        return 2;
    }
    let Sourceˉprefix: text = process.argument(0u32);
    let Sourceˉmanifestˉresource: text = process.argument(1u32);
    let Outputˉprefix: text = process.argument(2u32);
    let Outputˉmanifestˉresource: text = process.argument(3u32);
    var Inspect: bool = false;
    var Providerˉresource: text = "";
    var Configurationˉresource: text = "";
    if Arguments == 6u32 {
        Providerˉresource = process.argument(4u32);
        Configurationˉresource = process.argument(5u32);
        Inspect = Textˉequal(Providerˉresource, "inspect");
    }
    let Preflight: Resources.Linkerˉcompilerˉflatˉimageˉresourceˉstatus =
        Resources.Linkerˉcompilerˉflatˉimageˉresourceˉpreflight(
            Sourceˉprefix,
            Sourceˉmanifestˉresource,
            Outputˉprefix,
            Outputˉmanifestˉresource
        );
    if Preflight !=
        Resources.Linkerˉcompilerˉflatˉimageˉresourceˉstatus.Valid {
        return Resourceˉfailure(Preflight);
    }

    let Stagingˉmanifest: bytes =
        file.read_bytes(Sourceˉmanifestˉresource);
    let Resourceˉplan:
        Resources.Linkerˉcompilerˉflatˉimageˉresourceˉplan =
        Resources.Linkerˉcompilerˉflatˉimageˉresourceˉplanˉbuild(
            Sourceˉprefix,
            Sourceˉmanifestˉresource,
            Outputˉprefix,
            Outputˉmanifestˉresource,
            Stagingˉmanifest
        );
    if Resourceˉplan.Status !=
        Resources.Linkerˉcompilerˉflatˉimageˉresourceˉstatus.Valid {
        return Resourceˉfailure(Resourceˉplan.Status);
    }
    if Arguments == 6u32 &&
        (!Extraˉresourceˉvalid(Configurationˉresource, Sourceˉprefix,
            Sourceˉmanifestˉresource, Outputˉprefix, Outputˉmanifestˉresource,
            Resourceˉplan.Sourceˉchunks) ||
            (!Inspect && (!Extraˉresourceˉvalid(Providerˉresource, Sourceˉprefix,
                Sourceˉmanifestˉresource, Outputˉprefix, Outputˉmanifestˉresource,
                Resourceˉplan.Sourceˉchunks) ||
                Textˉequal(Providerˉresource, Configurationˉresource)))) {
        return Resourceˉfailure(Resources.Linkerˉcompilerˉflatˉimageˉresourceˉstatus.Collision);
    }

    var Snapshot: u32 = 0u32;
    while Snapshot < Resourceˉplan.Sourceˉchunks {
        let Value: bytes = Sourceˉchunk(Sourceˉprefix, Snapshot);
        let Entry: u32 = 24u32 + Snapshot * 12u32;
        if Bytesˉlength(Value) !=
            Bytesˉreadˉu32ˉlittle(Stagingˉmanifest, Entry + 8u32) {
            return Resourceˉfailure(
                Resources.Linkerˉcompilerˉflatˉimageˉresourceˉstatus.Chunkˉlength
            );
        }
        Snapshot = Snapshot + 1u32;
    }

    let Prefix: bytes = Sourceˉchunk(Sourceˉprefix, 0u32);
    if Bytesˉlength(Prefix) != 49u32 {
        return Envelopeˉfailure(
            Envelope.Compilerˉnativeˉx64ˉstagingˉwvoˉenvelopeˉstatus.Prefixˉsize
        );
    }
    let Sections: u32 = Bytesˉreadˉu32ˉlittle(Prefix, 12u32);
    let Textˉbytes: u32 = Bytesˉreadˉu32ˉlittle(Prefix, 36u32);
    if Textˉbytes > 67108864u32 {
        return Envelopeˉfailure(
            Envelope.Compilerˉnativeˉx64ˉstagingˉwvoˉenvelopeˉstatus.Sectionˉextent
        );
    }
    var Readˉonlyˉheader: bytes = Empty(Prefix);
    if Sections == 2u32 {
        let Readˉonlyˉindex: u32 = Chunkˉatˉposition(
            Stagingˉmanifest,
            Resourceˉplan.Sourceˉchunks,
            49u32 + Textˉbytes
        );
        if Readˉonlyˉindex == 4294967295u32 {
            return Envelopeˉfailure(
                Envelope.Compilerˉnativeˉx64ˉstagingˉwvoˉenvelopeˉstatus.Chunkˉboundary
            );
        }
        Readˉonlyˉheader = Sourceˉchunk(
            Sourceˉprefix,
            Readˉonlyˉindex
        );
    }
    let Envelopeˉsummary:
        Envelope.Compilerˉnativeˉx64ˉstagingˉwvoˉenvelopeˉsummary =
        Envelope.Compilerˉnativeˉx64ˉstagingˉwvoˉenvelopeˉvalidate(
            Stagingˉmanifest,
            Prefix,
            Readˉonlyˉheader
        );
    if Envelopeˉsummary.Status !=
        Envelope.Compilerˉnativeˉx64ˉstagingˉwvoˉenvelopeˉstatus.Valid {
        return Envelopeˉfailure(Envelopeˉsummary.Status);
    }

    let Symbolˉindex: u32 = Chunkˉatˉposition(
        Stagingˉmanifest,
        Resourceˉplan.Sourceˉchunks,
        Envelopeˉsummary.Symbolˉposition
    );
    if Symbolˉindex == 4294967295u32 {
        return Symbolˉfailure(
            Symbols.Compilerˉnativeˉx64ˉstagingˉwvoˉsymbolsˉstatus.Symbolˉchunk
        );
    }
    let Symbolˉchunk: bytes = Sourceˉchunk(Sourceˉprefix, Symbolˉindex);
    let Symbolˉsummary:
        Symbols.Compilerˉnativeˉx64ˉstagingˉwvoˉsymbolsˉsummary =
        Symbols.Compilerˉnativeˉx64ˉstagingˉwvoˉsymbolsˉvalidate(
            Stagingˉmanifest,
            Prefix,
            Readˉonlyˉheader,
            Symbolˉchunk
        );
    if Symbolˉsummary.Status !=
        Symbols.Compilerˉnativeˉx64ˉstagingˉwvoˉsymbolsˉstatus.Valid {
        return Symbolˉfailure(Symbolˉsummary.Status);
    }

    var Relocationˉchunk: bytes = Empty(Prefix);
    if Symbolˉsummary.Relocationˉbytes > 0u32 {
        let Relocationˉindex: u32 = Chunkˉatˉposition(
            Stagingˉmanifest,
            Resourceˉplan.Sourceˉchunks,
            Symbolˉsummary.Relocationˉposition
        );
        if Relocationˉindex == 4294967295u32 {
            return Linkˉfailure(
                Flat.Linkerˉcompilerˉwvoˉsegmentedˉstatus.Relocations
            );
        }
        Relocationˉchunk = Sourceˉchunk(
            Sourceˉprefix,
            Relocationˉindex
        );
    }

    var Providers: bytes = Empty(Prefix);
    if Arguments == 6u32 {
        if !Sharedˉsourceˉvalidate(Sourceˉprefix, Stagingˉmanifest, Prefix,
            Readˉonlyˉheader, Symbolˉchunk, Relocationˉchunk, Symbolˉsummary,
            Envelopeˉsummary, Resourceˉplan.Sourceˉchunks) {
            return Linkˉfailure(Flat.Linkerˉcompilerˉwvoˉsegmentedˉstatus.Chunkˉcontent);
        }
        if Inspect {
            file.write_bytes(Configurationˉresource,
                Sharedˉconfiguration(Symbolˉsummary, Envelopeˉsummary, Providers));
            console.write_line("segmented shared compiler staging status=Admitted configuration-bytes=64");
            return 0;
        }
        Providers = file.read_bytes(Providerˉresource);
    }
    let Plan: Flat.Linkerˉcompilerˉwvoˉsegmentedˉplan =
        Flat.Linkerˉcompilerˉwvoˉsegmentedˉsharedˉplanˉbuild(
            Stagingˉmanifest,
            Prefix,
            Readˉonlyˉheader,
            Symbolˉchunk,
            Relocationˉchunk,
            Providers
        );
    if Plan.Status != Flat.Linkerˉcompilerˉwvoˉsegmentedˉstatus.Valid {
        return Linkˉfailure(Plan.Status);
    }
    var Cursor:
        Verification.Linkerˉcompilerˉwvoˉsegmentedˉverificationˉcursor =
        Verification.Linkerˉcompilerˉwvoˉsegmentedˉsharedˉverificationˉbegin(
            Stagingˉmanifest,
            Prefix,
            Readˉonlyˉheader,
            Symbolˉchunk,
            Relocationˉchunk,
            Providers
        );
    if Cursor.Status !=
        Verification.Linkerˉcompilerˉwvoˉsegmentedˉverificationˉstatus.Active {
        return Verificationˉfailure(Cursor.Status);
    }

    var Entries: bytes = Empty(Prefix);
    var Sourceˉindex: u32 = 0u32;
    var Outputˉindex: u32 = 0u32;
    while Sourceˉindex < Plan.Manifestˉchunks {
        let Source: bytes = Sourceˉchunk(Sourceˉprefix, Sourceˉindex);
        let Linked: Flat.Linkerˉcompilerˉwvoˉsegmentedˉchunk =
            Flat.Linkerˉcompilerˉwvoˉsegmentedˉsharedˉchunkˉlink(
                Stagingˉmanifest,
                Prefix,
                Readˉonlyˉheader,
                Symbolˉchunk,
                Relocationˉchunk,
                Sourceˉindex,
                Source,
                Providers
            );
        if Linked.Status !=
            Flat.Linkerˉcompilerˉwvoˉsegmentedˉstatus.Valid {
            return Linkˉfailure(Linked.Status);
        }
        let Candidateˉposition: u32 = Cursor.Imageˉposition;
        let Candidateˉbytes: u32 = Bytesˉlength(Linked.Value);
        if Candidateˉbytes > 0u32 &&
            Linked.Imageˉposition != Candidateˉposition {
            return Linkˉfailure(
                Flat.Linkerˉcompilerˉwvoˉsegmentedˉstatus.Chunkˉrange
            );
        }
        let Next:
            Verification.Linkerˉcompilerˉwvoˉsegmentedˉverificationˉcursor =
            Verification.Linkerˉcompilerˉwvoˉsegmentedˉsharedˉverificationˉnext(
                Stagingˉmanifest,
                Prefix,
                Readˉonlyˉheader,
                Symbolˉchunk,
                Relocationˉchunk,
                Cursor,
                Source,
                Candidateˉposition,
                Linked.Value,
                Providers
            );
        if Next.Status !=
            Verification.Linkerˉcompilerˉwvoˉsegmentedˉverificationˉstatus.Active {
            return Verificationˉfailure(Next.Status);
        }
        if Candidateˉbytes > 0u32 {
            file.write_bytes(
                Resources.Linkerˉcompilerˉflatˉimageˉoutputˉchunkˉresource(
                    Outputˉprefix,
                    Outputˉindex
                ),
                Linked.Value
            );
            Entries = Appendˉu32(Entries, Outputˉindex);
            Entries = Appendˉu32(Entries, Candidateˉposition);
            Entries = Appendˉu32(Entries, Candidateˉbytes);
            Outputˉindex = Outputˉindex + 1u32;
        }
        Cursor = Next;
        Sourceˉindex = Sourceˉindex + 1u32;
    }

    Cursor = Verification.Linkerˉcompilerˉwvoˉsegmentedˉsharedˉverificationˉfinish(
        Stagingˉmanifest,
        Prefix,
        Readˉonlyˉheader,
        Symbolˉchunk,
        Relocationˉchunk,
        Cursor,
        Providers
    );
    if Cursor.Status !=
            Verification.Linkerˉcompilerˉwvoˉsegmentedˉverificationˉstatus.Complete ||
        Outputˉindex != Plan.Outputˉchunks ||
        Bytesˉlength(Entries) != Outputˉindex * 12u32 {
        return Verificationˉfailure(Cursor.Status);
    }

    let Manifestˉbytes: bytes =
        Imageˉmanifest.Linkerˉcompilerˉflatˉimageˉmanifestˉbuild(
            Entries,
            Plan.Imageˉbytes,
            Plan.Entryˉoffset,
            Outputˉindex
        );
    if Bytesˉlength(Manifestˉbytes) == 0u32 {
        return Verificationˉfailure(
            Verification.Linkerˉcompilerˉwvoˉsegmentedˉverificationˉstatus.Invalidˉcursor
        );
    }
    file.write_bytes(Outputˉmanifestˉresource, Manifestˉbytes);
    if Arguments == 6u32 {
        file.write_bytes(Configurationˉresource,
            Sharedˉconfiguration(Symbolˉsummary, Envelopeˉsummary, Providers));
    }
    var Report: text =
        "segmented compiler image staging status=Complete image-bytes=";
    Report = Textˉconcat(Report, U32ˉformat(Plan.Imageˉbytes));
    Report = Textˉconcat(Report, " entry-offset=");
    Report = Textˉconcat(Report, U32ˉformat(Plan.Entryˉoffset));
    Report = Textˉconcat(Report, " chunks=");
    Report = Textˉconcat(Report, U32ˉformat(Outputˉindex));
    Report = Textˉconcat(Report, " manifest-bytes=");
    console.write_line(
        Textˉconcat(Report, U32ˉformat(Bytesˉlength(Manifestˉbytes)))
    );
    return 0;
}
