module Linkerˉnativeˉhostedˉverifierˉpublisherˉconstructionˉrequest profile portable;

import Linkerˉnativeˉhostedˉverifierˉpublisherˉconstructionˉdigests as Digests;

export record Publisherˉconstructionˉrequestˉresult {
    Valid: bool;
    Value: bytes;
    Failureˉinput: u32;
}

fn Empty(Input: bytes) -> bytes {
    return Bytesˉslice(Input, 0u32, 0u32);
}

fn Failure(Input: bytes, Field: u32) -> Publisherˉconstructionˉrequestˉresult {
    return Publisherˉconstructionˉrequestˉresult(
        false, Empty(Input), Field
    );
}

fn Appendˉu32(Output: bytes, Value: u32) -> bytes {
    return Bytesˉconcat(Output, Bytesˉfromˉu32ˉlittle(Value));
}

fn Structureˉisˉvalid(Input: bytes) -> bool {
    if Bytesˉlength(Input) != 128u32 ||
        Bytesˉreadˉu32ˉlittle(Input, 0u32) != 1397773911u32 ||
        Bytesˉreadˉu32ˉlittle(Input, 4u32) != 1u32 ||
        Bytesˉreadˉu32ˉlittle(Input, 8u32) != 128u32 {
        return false;
    }
    let Target: u32 = Bytesˉreadˉu32ˉlittle(Input, 12u32);
    if Target != 1u32 && Target != 2u32 { return false; }
    let Variant: u32 = Bytesˉreadˉu32ˉlittle(Input, 120u32);
    if Variant > 4u32 { return false; }
    var Identityˉbytes: u32 = 275054u32;
    if Target == 2u32 {
        Identityˉbytes = 271065u32;
    }
    var Moduleˉbytes: u32 = 29170u32;
    var Objectˉbytes: u32 = 233804u32;
    var Mainˉoffset: u32 = 3001u32;
    if Variant == 1u32 {
        Moduleˉbytes = 41268u32;
        Objectˉbytes = 660123u32;
        Mainˉoffset = 1178u32;
        Identityˉbytes = 713471u32;
        if Target == 2u32 { Identityˉbytes = 709482u32; }
    }
    if Variant == 2u32 {
        Moduleˉbytes = 159770u32;
        Objectˉbytes = 1319377u32;
        Mainˉoffset = 0u32;
        Identityˉbytes = 1491227u32;
        if Target == 2u32 { Identityˉbytes = 1487314u32; }
    }
    if Variant == 3u32 {
        Moduleˉbytes = 41365u32;
        Objectˉbytes = 408284u32;
        Mainˉoffset = 0u32;
        Identityˉbytes = 461729u32;
        if Target == 2u32 { Identityˉbytes = 457816u32; }
    }
    if Variant == 4u32 {
        Moduleˉbytes = 115107u32;
        Objectˉbytes = 1139440u32;
        Mainˉoffset = 18902u32;
        Identityˉbytes = 1266627u32;
        if Target == 2u32 { Identityˉbytes = 1262714u32; }
    }
    var Beginˉoffset: u32 = 789u32;
    var Applyˉoffset: u32 = 0u32;
    if Variant == 2u32 || Variant == 3u32 {
        Beginˉoffset = 5475u32;
        Applyˉoffset = 4686u32;
    }
    return Bytesˉreadˉu32ˉlittle(Input, 16u32) == Moduleˉbytes &&
        Bytesˉreadˉu32ˉlittle(Input, 20u32) == Objectˉbytes &&
        Bytesˉreadˉu32ˉlittle(Input, 36u32) == Mainˉoffset &&
        Bytesˉreadˉu32ˉlittle(Input, 40u32) == Beginˉoffset &&
        Bytesˉreadˉu32ˉlittle(Input, 44u32) == Applyˉoffset &&
        Bytesˉreadˉu32ˉlittle(Input, 112u32) == Identityˉbytes &&
        Bytesˉreadˉu32ˉlittle(Input, 116u32) == 1u32 &&
        Bytesˉreadˉu32ˉlittle(Input, 124u32) == 0u32;
}

export fn Publisherˉconstructionˉrequest(
    Structure: bytes
) -> Publisherˉconstructionˉrequestˉresult {
    if !Structureˉisˉvalid(Structure) { return Failure(Structure, 0u32); }
    let Target: u32 = Bytesˉreadˉu32ˉlittle(Structure, 12u32);
    let Variant: u32 = Bytesˉreadˉu32ˉlittle(Structure, 120u32);

    var Moduleˉbytes: u32 = 29170u32;
    var Objectˉbytes: u32 = 233804u32;
    var Codeˉbytes: u32 = 232448u32;
    var Dataˉbytes: u32 = 288u32;
    var Mainˉoffset: u32 = 3001u32;
    var Symbols: u32 = 27u32;
    var Relocations: u32 = 5u32;
    var Beginˉoffset: u32 = 789u32;
    var Applyˉoffset: u32 = 0u32;
    if Variant == 1u32 {
        Moduleˉbytes = 41268u32;
        Objectˉbytes = 660123u32;
        Codeˉbytes = 658160u32;
        Dataˉbytes = 179u32;
        Mainˉoffset = 1178u32;
        Symbols = 49u32;
        Relocations = 3u32;
    }
    if Variant == 2u32 {
        Moduleˉbytes = 159770u32;
        Objectˉbytes = 1319377u32;
        Codeˉbytes = 1317376u32;
        Dataˉbytes = 237u32;
        Mainˉoffset = 0u32;
        Beginˉoffset = 5475u32;
        Applyˉoffset = 4686u32;
        Symbols = 47u32;
        Relocations = 6u32;
    }
    if Variant == 3u32 {
        Moduleˉbytes = 41365u32;
        Objectˉbytes = 408284u32;
        Codeˉbytes = 406752u32;
        Dataˉbytes = 88u32;
        Mainˉoffset = 0u32;
        Beginˉoffset = 5475u32;
        Applyˉoffset = 4686u32;
        Symbols = 39u32;
        Relocations = 3u32;
    }
    if Variant == 4u32 {
        Moduleˉbytes = 115107u32;
        Objectˉbytes = 1139440u32;
        Codeˉbytes = 1134976u32;
        Dataˉbytes = 448u32;
        Mainˉoffset = 18902u32;
        Symbols = 109u32;
        Relocations = 15u32;
    }

    var Bundleˉbytes: u32 = 235394u32;
    var Startupˉwvoˉbytes: u32 = 168u32;
    var Adapterˉwvoˉbytes: u32 = 9544u32;
    var Adapterˉimageˉbytes: u32 = 5286u32;
    var Adapterˉsymbols: u32 = 46u32;
    var Adapterˉrelocations: u32 = 111u32;
    var Adapterˉfile: u32 = 240016u32;
    var Adapterˉaddress: u32 = 243600u32;
    var Sha256ˉfile: u32 = 245312u32;
    var Sha256ˉaddress: u32 = 248896u32;
    var Metadataˉfile: u32 = 252896u32;
    var Metadataˉaddress: u32 = 259552u32;
    var Outputˉbytes: u32 = 256000u32;
    var Imageˉend: u32 = 143994880u32;
    var Importˉpageˉbytes: u32 = 4096u32;
    var Platformˉimports: u32 = 17u32;
    var Adapterˉimports: u32 = 43u32;
    var Targetˉbindings: u32 = 44u32;
    var Adapterˉexport: u32 = 251u32;
    var Mutationˉflags: u32 = 63u32;
    if Variant == 1u32 {
        Bundleˉbytes = 661010u32;
        Adapterˉfile = 665664u32;
        Adapterˉaddress = 669248u32;
        Sha256ˉfile = 670960u32;
        Sha256ˉaddress = 674544u32;
        Metadataˉfile = 678368u32;
        Metadataˉaddress = 685536u32;
        Outputˉbytes = 681472u32;
        Imageˉend = 144420864u32;
    }
    if Variant == 2u32 {
        Bundleˉbytes = 1320274u32;
        Adapterˉfile = 1324896u32;
        Adapterˉaddress = 1328480u32;
        Sha256ˉfile = 1330192u32;
        Sha256ˉaddress = 1333776u32;
        Metadataˉfile = 1337824u32;
        Metadataˉaddress = 1344992u32;
        Outputˉbytes = 1340928u32;
        Imageˉend = 145080320u32;
    }
    if Variant == 3u32 {
        Bundleˉbytes = 409506u32;
        Adapterˉfile = 414128u32;
        Adapterˉaddress = 417712u32;
        Sha256ˉfile = 419424u32;
        Sha256ˉaddress = 423008u32;
        Metadataˉfile = 426976u32;
        Metadataˉaddress = 431584u32;
        Outputˉbytes = 430080u32;
        Imageˉend = 144166912u32;
    }
    if Variant == 4u32 {
        Bundleˉbytes = 1138082u32;
        Adapterˉfile = 1142704u32;
        Adapterˉaddress = 1146288u32;
        Sha256ˉfile = 1148000u32;
        Sha256ˉaddress = 1151584u32;
        Metadataˉfile = 1155552u32;
        Metadataˉaddress = 1160672u32;
        Outputˉbytes = 1158656u32;
        Imageˉend = 144896000u32;
    }
    if Target == 2u32 {
        Bundleˉbytes = 235077u32;
        Startupˉwvoˉbytes = 164u32;
        Adapterˉwvoˉbytes = 5559u32;
        Adapterˉimageˉbytes = 3415u32;
        Adapterˉsymbols = 28u32;
        Adapterˉrelocations = 49u32;
        Adapterˉfile = 249856u32;
        Adapterˉaddress = 142929920u32;
        Sha256ˉfile = 253280u32;
        Sha256ˉaddress = 142933344u32;
        Metadataˉfile = 247264u32;
        Metadataˉaddress = 247264u32;
        Outputˉbytes = 254965u32;
        Imageˉend = 142935109u32;
        Importˉpageˉbytes = 0u32;
        Platformˉimports = 0u32;
        Adapterˉimports = 26u32;
        Targetˉbindings = 27u32;
        Adapterˉexport = 60u32;
        Mutationˉflags = 207u32;
        if Variant == 1u32 {
            Bundleˉbytes = 660693u32;
            Adapterˉfile = 675840u32;
            Adapterˉaddress = 143355904u32;
            Sha256ˉfile = 679264u32;
            Sha256ˉaddress = 143359328u32;
            Metadataˉfile = 673248u32;
            Metadataˉaddress = 673248u32;
            Outputˉbytes = 680949u32;
            Imageˉend = 143361013u32;
        }
        if Variant == 2u32 {
            Bundleˉbytes = 1319957u32;
            Adapterˉfile = 1335296u32;
            Adapterˉaddress = 144015360u32;
            Sha256ˉfile = 1338720u32;
            Sha256ˉaddress = 144018784u32;
            Metadataˉfile = 1332704u32;
            Metadataˉaddress = 1332704u32;
            Outputˉbytes = 1340405u32;
            Imageˉend = 144020469u32;
        }
        if Variant == 3u32 {
            Bundleˉbytes = 409189u32;
            Adapterˉfile = 421888u32;
            Adapterˉaddress = 143101952u32;
            Sha256ˉfile = 425312u32;
            Sha256ˉaddress = 143105376u32;
            Metadataˉfile = 419296u32;
            Metadataˉaddress = 419296u32;
            Outputˉbytes = 426997u32;
            Imageˉend = 143107061u32;
        }
        if Variant == 4u32 {
            Bundleˉbytes = 1137765u32;
            Adapterˉfile = 1150976u32;
            Adapterˉaddress = 143831040u32;
            Sha256ˉfile = 1154400u32;
            Sha256ˉaddress = 143834464u32;
            Metadataˉfile = 1148384u32;
            Metadataˉaddress = 1148384u32;
            Outputˉbytes = 1156085u32;
            Imageˉend = 143836149u32;
        }
    }

    var Result: bytes = Empty(Structure);
    Result = Appendˉu32(Result, 1380144727u32);
    Result = Appendˉu32(Result, 1u32);
    let Total: u32 = 416u32;
    Result = Appendˉu32(Result, Total);
    Result = Appendˉu32(Result, Target);
    Result = Appendˉu32(Result, 6u32);
    Result = Appendˉu32(Result, Targetˉbindings);
    Result = Appendˉu32(Result, Mutationˉflags);
    Result = Appendˉu32(Result, Variant);
    Result = Appendˉu32(Result, Moduleˉbytes);
    Result = Appendˉu32(Result, Objectˉbytes);
    Result = Appendˉu32(Result, Codeˉbytes);
    Result = Appendˉu32(Result, Dataˉbytes);
    Result = Appendˉu32(Result, Mainˉoffset);
    Result = Appendˉu32(Result, Beginˉoffset);
    Result = Appendˉu32(Result, Applyˉoffset);
    Result = Appendˉu32(Result, 2u32);
    Result = Appendˉu32(Result, Symbols);
    Result = Appendˉu32(Result, Relocations);
    Result = Appendˉu32(Result, Bundleˉbytes);
    Result = Appendˉu32(Result, Startupˉwvoˉbytes);
    Result = Appendˉu32(Result, 5u32);
    Result = Appendˉu32(Result, 2u32);
    Result = Appendˉu32(Result, 1u32);
    Result = Appendˉu32(Result, Adapterˉwvoˉbytes);
    Result = Appendˉu32(Result, Adapterˉimageˉbytes);
    Result = Appendˉu32(Result, Adapterˉsymbols);
    Result = Appendˉu32(Result, Adapterˉrelocations);
    Result = Appendˉu32(Result, 2176u32);
    Result = Appendˉu32(Result, 1685u32);
    Result = Appendˉu32(Result, 1350u32);
    Result = Appendˉu32(Result, 333u32);
    Result = Appendˉu32(Result, 7u32);
    Result = Appendˉu32(Result, 2u32);
    Result = Appendˉu32(Result, Adapterˉfile);
    Result = Appendˉu32(Result, Adapterˉaddress);
    Result = Appendˉu32(Result, Sha256ˉfile);
    Result = Appendˉu32(Result, Sha256ˉaddress);
    Result = Appendˉu32(Result, Metadataˉfile);
    Result = Appendˉu32(Result, Metadataˉaddress);
    Result = Appendˉu32(Result, Outputˉbytes);
    Result = Appendˉu32(Result, Imageˉend);
    Result = Appendˉu32(Result, Importˉpageˉbytes);
    Result = Appendˉu32(Result, Platformˉimports);
    Result = Appendˉu32(Result, Adapterˉimports);
    Result = Appendˉu32(Result, Adapterˉexport);
    Result = Appendˉu32(Result, 4096u32);
    Result = Appendˉu32(Result, 0u32);
    Result = Appendˉu32(Result, 0u32);
    var Digestˉidentity: u32 = 1u32;
    while Digestˉidentity < 8u32 {
        Result = Bytesˉconcat(
            Result,
            Digests.Publisherˉconstructionˉexpectedˉdigestˉforˉvariant(
                Structure, Digestˉidentity, Target, Variant
            )
        );
        Digestˉidentity = Digestˉidentity + 1u32;
    }
    if Bytesˉlength(Result) != Total { return Failure(Structure, 7u32); }
    return Publisherˉconstructionˉrequestˉresult(true, Result, Total);
}
