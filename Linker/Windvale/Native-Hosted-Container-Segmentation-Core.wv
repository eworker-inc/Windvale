module Linkerˉnativeˉhostedˉcontainerˉsegmentationˉcore profile portable;

import Linkerˉnativeˉhostedˉcontainerˉbyteˉconstruction as Build;
import Linkerˉnativeˉhostedˉcontainerˉlayout as Layout;

record Nativeˉhostedˉcontainerˉsegmentˉappend {
    Valid: bool;
    Value: bytes;
    Payloadˉoffset: u32;
    Imageˉcursor: u32;
}

fn Read(Input: bytes, Offset: u32) -> u32 {
    return Bytesˉreadˉu32ˉlittle(Input, Offset);
}

fn Empty(Input: bytes) -> bytes {
    return Bytesˉslice(Input, 0u32, 0u32);
}

fn Response(
    Input: bytes,
    Totalˉbytes: u32,
    Status: u32,
    Failureˉoffset: u32,
    Applicationˉbytes: u32,
    Segmentˉoffset: u32,
    Segmentˉbytes: u32
) -> bytes {
    var Result: bytes = Empty(Input);
    Result = Build.Appendˉu32(Result, 1430804055u32);
    Result = Build.Appendˉu32(Result, 1u32);
    Result = Build.Appendˉu32(Result, Totalˉbytes);
    Result = Build.Appendˉu32(Result, Status);
    Result = Build.Appendˉu32(Result, Failureˉoffset);
    Result = Build.Appendˉu32(Result, 128u32);
    Result = Build.Appendˉu32(Result, Applicationˉbytes);
    Result = Build.Appendˉu32(Result, Segmentˉoffset);
    Result = Build.Appendˉu32(Result, Segmentˉbytes);
    return Build.Appendˉu32(Result, 6u32);
}

fn Failure(Input: bytes, Status: u32, Offset: u32) -> bytes {
    return Response(Input, 40u32, Status, Offset, 0u32, 0u32, 0u32);
}

fn Maximum(Left: u32, Right: u32) -> u32 {
    if Left > Right { return Left; }
    return Right;
}

fn Minimum(Left: u32, Right: u32) -> u32 {
    if Left < Right { return Left; }
    return Right;
}

fn Planˉisˉvalid(Plan: bytes) -> bool {
    if Bytesˉlength(Plan) != 128u32 || Read(Plan, 0u32) != 1145263703u32 ||
        Read(Plan, 4u32) != 1u32 || Read(Plan, 12u32) != 0u32 ||
        Read(Plan, 16u32) != 4128u32 {
        return false;
    }
    let Target: u32 = Read(Plan, 20u32);
    let Profile: u32 = Read(Plan, 24u32);
    let Bundleˉbytes: u32 = Read(Plan, 52u32);
    if Target < 1u32 || Target > 2u32 || Profile < 1u32 || Profile > 7u32 ||
        Bundleˉbytes == 0u32 || Bundleˉbytes > 67108864u32 {
        return false;
    }
    var Metadata: bytes = Build.Zeros(1024u32);
    Metadata = Build.Patchˉu32(Metadata, 60u32, Bundleˉbytes);
    Metadata = Build.Patchˉu32(Metadata, 68u32, 1u32);
    Metadata = Build.Patchˉu32(Metadata, 72u32, 0u32);
    let Value: Layout.Nativeˉhostedˉcontainerˉlayout =
        Layout.Nativeˉhostedˉcontainerˉplan(Metadata, Target, Profile);
    if !Value.Valid || Read(Plan, 8u32) != 128u32 + Read(Plan, 100u32) ||
        Read(Plan, 28u32) != Value.Applicationˉbytes || Read(Plan, 32u32) != 0u32 ||
        Read(Plan, 36u32) != Value.Headerˉbytes ||
        Read(Plan, 40u32) != Value.Textˉfileˉoffset ||
        Read(Plan, 44u32) != Value.Startupˉbytes ||
        Read(Plan, 48u32) != Value.Textˉfileˉoffset + Value.Bundleˉoffset {
        return false;
    }
    var Importˉbytes: u32 = 0u32;
    var Relocationˉbytes: u32 = 0u32;
    var Targetˉbytes: u32 = 124u32;
    if Target == 1u32 {
        Importˉbytes = 4096u32;
        Relocationˉbytes = 12u32;
        Targetˉbytes = 232u32;
    }
    if Read(Plan, 56u32) != Value.Importˉfileˉoffset ||
        Read(Plan, 60u32) != Importˉbytes ||
        Read(Plan, 64u32) != Value.Runtimeˉfileˉoffset ||
        Read(Plan, 68u32) != 4096u32 ||
        Read(Plan, 72u32) != Value.Relocationˉfileˉoffset ||
        Read(Plan, 76u32) != Relocationˉbytes ||
        Read(Plan, 80u32) != Value.Textˉaddress ||
        Read(Plan, 84u32) != Value.Dataˉaddress ||
        Read(Plan, 88u32) != Value.Runtimeˉaddress {
        return false;
    }
    if Read(Plan, 92u32) != Value.Imageˉvirtualˉbytes ||
        Read(Plan, 96u32) != 128u32 || Read(Plan, 100u32) != Targetˉbytes ||
        Read(Plan, 104u32) != Value.Relocationˉaddress ||
        Read(Plan, 108u32) != Value.Importˉaddress {
        return false;
    }
    if Read(Plan, 112u32) != Value.Textˉvirtualˉbytes ||
        Read(Plan, 116u32) != Value.Textˉfileˉbytes ||
        Read(Plan, 120u32) != Value.Dataˉfileˉbytes ||
        Read(Plan, 124u32) != Value.Dataˉvirtualˉbytes {
        return false;
    }
    return true;
}

fn Appendˉfill(
    Input: bytes,
    Current: Nativeˉhostedˉcontainerˉsegmentˉappend,
    Regionˉend: u32,
    Segmentˉstart: u32,
    Segmentˉend: u32
) -> Nativeˉhostedˉcontainerˉsegmentˉappend {
    if !Current.Valid || Regionˉend < Current.Imageˉcursor {
        return Nativeˉhostedˉcontainerˉsegmentˉappend(
            false, Current.Value, Current.Payloadˉoffset, Current.Imageˉcursor
        );
    }
    let Start: u32 = Maximum(Current.Imageˉcursor, Segmentˉstart);
    let End: u32 = Minimum(Regionˉend, Segmentˉend);
    var Value: bytes = Current.Value;
    if Start < End {
        Value = Bytesˉconcat(Value, Build.Zeros(End - Start));
    }
    return Nativeˉhostedˉcontainerˉsegmentˉappend(
        true, Value, Current.Payloadˉoffset, Regionˉend
    );
}

fn Appendˉregion(
    Input: bytes,
    Current: Nativeˉhostedˉcontainerˉsegmentˉappend,
    Regionˉstart: u32,
    Regionˉbytes: u32,
    Segmentˉstart: u32,
    Segmentˉend: u32
) -> Nativeˉhostedˉcontainerˉsegmentˉappend {
    if Regionˉbytes == 0u32 { return Current; }
    var Result: Nativeˉhostedˉcontainerˉsegmentˉappend = Appendˉfill(
        Input, Current, Regionˉstart, Segmentˉstart, Segmentˉend
    );
    if !Result.Valid { return Result; }
    let Start: u32 = Maximum(Regionˉstart, Segmentˉstart);
    let Regionˉend: u32 = Regionˉstart + Regionˉbytes;
    let End: u32 = Minimum(Regionˉend, Segmentˉend);
    var Value: bytes = Result.Value;
    var Payloadˉoffset: u32 = Result.Payloadˉoffset;
    if Start < End {
        let Count: u32 = End - Start;
        if Payloadˉoffset > Bytesˉlength(Input) ||
            Count > Bytesˉlength(Input) - Payloadˉoffset {
            return Nativeˉhostedˉcontainerˉsegmentˉappend(
                false, Value, Payloadˉoffset, Regionˉstart
            );
        }
        Value = Bytesˉconcat(Value, Bytesˉslice(Input, Payloadˉoffset, Count));
        Payloadˉoffset = Payloadˉoffset + Count;
    }
    return Nativeˉhostedˉcontainerˉsegmentˉappend(
        true, Value, Payloadˉoffset, Regionˉend
    );
}

export fn Nativeˉhostedˉcontainerˉsegmentˉconstruct(Input: bytes) -> bytes {
    let Total: u32 = Bytesˉlength(Input);
    if Total < 160u32 { return Failure(Input, 1u32, Total); }
    if Read(Input, 0u32) != 1414026839u32 { return Failure(Input, 2u32, 0u32); }
    if Read(Input, 4u32) != 1u32 { return Failure(Input, 3u32, 4u32); }
    if Read(Input, 8u32) != Total { return Failure(Input, 1u32, 8u32); }
    if Read(Input, 12u32) != 128u32 || Read(Input, 28u32) != 0u32 {
        return Failure(Input, 4u32, 12u32);
    }
    let Segmentˉoffset: u32 = Read(Input, 16u32);
    let Segmentˉbytes: u32 = Read(Input, 20u32);
    let Payloadˉbytes: u32 = Read(Input, 24u32);
    if Payloadˉbytes != Total - 160u32 { return Failure(Input, 4u32, 24u32); }
    let Plan: bytes = Bytesˉslice(Input, 32u32, 128u32);
    if !Planˉisˉvalid(Plan) { return Failure(Input, 5u32, 32u32); }
    let Applicationˉbytes: u32 = Read(Plan, 28u32);
    if Segmentˉoffset >= Applicationˉbytes ||
        Segmentˉoffset % 4194144u32 != 0u32 {
        return Failure(Input, 6u32, 16u32);
    }
    var Expectedˉsegment: u32 = Applicationˉbytes - Segmentˉoffset;
    if Expectedˉsegment > 4194144u32 { Expectedˉsegment = 4194144u32; }
    if Segmentˉbytes != Expectedˉsegment { return Failure(Input, 6u32, 20u32); }
    let Segmentˉend: u32 = Segmentˉoffset + Segmentˉbytes;
    var Current: Nativeˉhostedˉcontainerˉsegmentˉappend =
        Nativeˉhostedˉcontainerˉsegmentˉappend(
            true, Empty(Input), 160u32, 0u32
        );
    Current = Appendˉregion(
        Input, Current, 0u32, Read(Plan, 36u32), Segmentˉoffset, Segmentˉend
    );
    Current = Appendˉregion(
        Input, Current, Read(Plan, 40u32), Read(Plan, 44u32),
        Segmentˉoffset, Segmentˉend
    );
    Current = Appendˉregion(
        Input, Current, Read(Plan, 48u32), Read(Plan, 52u32),
        Segmentˉoffset, Segmentˉend
    );
    Current = Appendˉregion(
        Input, Current, Read(Plan, 56u32), Read(Plan, 60u32),
        Segmentˉoffset, Segmentˉend
    );
    Current = Appendˉregion(
        Input, Current, Read(Plan, 64u32), Read(Plan, 68u32),
        Segmentˉoffset, Segmentˉend
    );
    Current = Appendˉregion(
        Input, Current, Read(Plan, 72u32), Read(Plan, 76u32),
        Segmentˉoffset, Segmentˉend
    );
    Current = Appendˉfill(
        Input, Current, Applicationˉbytes, Segmentˉoffset, Segmentˉend
    );
    if !Current.Valid || Current.Payloadˉoffset != Total ||
        Bytesˉlength(Current.Value) != Segmentˉbytes {
        return Failure(Input, 7u32, Current.Payloadˉoffset);
    }
    let Header: bytes = Response(
        Input, 40u32 + Segmentˉbytes, 0u32, Total, Applicationˉbytes,
        Segmentˉoffset, Segmentˉbytes
    );
    return Bytesˉconcat(Header, Current.Value);
}
