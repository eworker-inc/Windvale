    if Index == 6u32 { return 3181191855u32; }
    return 719332331u32;
}

export fn Publisherˉconstructionˉexpectedˉdigest(
    Input: bytes,
    Identity: u32,
    Target: u32
) -> bytes {
    var Result: bytes = Bytesˉslice(Input, 0u32, 0u32);
    var Index: u32 = 0u32;
    while Index < 8u32 {
        Result = Bytesˉconcat(
            Result,
            Bytesˉfromˉu32ˉlittle(Expectedˉword(Identity, Target, Index))
        );
        Index = Index + 1u32;
    }
    return Result;
}
