export fn Publisherˉconstructionˉexpectedˉdigestˉforˉvariant(
    Input: bytes,
    Identity: u32,
    Target: u32,
    Variant: u32
) -> bytes {
    var Result: bytes = Bytesˉslice(Input, 0u32, 0u32);
    if Variant > 2u32 { return Result; }
    var Index: u32 = 0u32;
    while Index < 8u32 {
        var Word: u32 = Expectedˉword(Identity, Target, Index);
        if Variant == 1u32 &&
            (Identity == 1u32 || Identity == 2u32 ||
                Identity == 6u32 || Identity == 7u32) {
            Word = Promoterˉword(Identity, Target, Index);
        }
        if Variant == 2u32 &&
            (Identity == 1u32 || Identity == 2u32 ||
                Identity == 6u32 || Identity == 7u32) {
            Word = Wvbˉpublisherˉword(Identity, Target, Index);
        }
        Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Word));
        Index = Index + 1u32;
    }
    return Result;
}

export fn Publisherˉconstructionˉexpectedˉdigest(
    Input: bytes,
    Identity: u32,
    Target: u32
) -> bytes {
    return Publisherˉconstructionˉexpectedˉdigestˉforˉvariant(
        Input, Identity, Target, 0u32
    );
}
