        if Index == 5u32 { return 1975500695u32; }
        if Index == 6u32 { return 3530959939u32; }
        return 602683588u32;
    }
    if Identity == 3u32 && Target == 1u32 {
        if Index == 0u32 { return 4033483707u32; }
        if Index == 1u32 { return 1915693880u32; }
        if Index == 2u32 { return 2141243631u32; }
        if Index == 3u32 { return 1747188568u32; }
