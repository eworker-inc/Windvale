module Linkerˉnativeˉhostedˉverifierˉpublisherˉconstructionˉdigests profile portable;

fn Expectedˉword(Identity: u32, Target: u32, Index: u32) -> u32 {
    if Identity == 1u32 {
        if Index == 0u32 { return 1257490039u32; }
        if Index == 1u32 { return 298073986u32; }
