module Linkerˉnativeˉhostedˉverifierˉpublisherˉwindowsˉimportsˉtool profile hosted;

import Linkerˉnativeˉhostedˉverifierˉpublisherˉwindowsˉimports as Imports;

capability console.write_line;
capability diagnostic.write_line;
capability file.write_bytes;
capability process.argument;
capability process.argument_count;

fn Textˉequals(Left: text, Right: text) -> bool {
    let Leftˉbytes: bytes = Textˉtoˉutf8(Left);
    let Rightˉbytes: bytes = Textˉtoˉutf8(Right);
    let Length: u32 = Bytesˉlength(Leftˉbytes);
    if Length != Bytesˉlength(Rightˉbytes) { return false; }
    var Index: u32 = 0u32;
    while Index < Length {
        if Bytesˉreadˉu8(Leftˉbytes, Index) !=
            Bytesˉreadˉu8(Rightˉbytes, Index) {
            return false;
        }
        Index = Index + 1u32;
    }
    return true;
}

fn Usage() -> i32 {
    diagnostic.write_line(
        "Usage: wvhostverifierpublishimports [promoter|wvb-publisher|wvo-publisher|console-application-publisher] <imports.wvim>"
    );
    return 64;
}

export fn Main() -> i32 {
    let Count: u32 = process.argument_count();
    if Count < 1u32 || Count > 2u32 { return Usage(); }
    var Address: u32 = 253952u32;
    var Outputˉindex: u32 = 0u32;
    if Count == 2u32 {
        let Role: text = process.argument(0u32);
        if !Textˉequals(Role, "promoter") &&
            !Textˉequals(Role, "wvb-publisher") &&
            !Textˉequals(Role, "wvo-publisher") &&
            !Textˉequals(Role, "console-application-publisher") { return Usage(); }
        if Textˉequals(Role, "promoter") { Address = 679936u32; }
        if Textˉequals(Role, "wvb-publisher") { Address = 1339392u32; }
        if Textˉequals(Role, "wvo-publisher") { Address = 425984u32; }
        if Textˉequals(Role, "console-application-publisher") {
            Address = 1155072u32;
        }
        Outputˉindex = 1u32;
    }
    var Request: bytes = Bytesˉfromˉu32ˉlittle(1380537943u32);
    Request = Bytesˉconcat(Request, Bytesˉfromˉu32ˉlittle(1u32));
    Request = Bytesˉconcat(Request, Bytesˉfromˉu32ˉlittle(16u32));
    Request = Bytesˉconcat(Request, Bytesˉfromˉu32ˉlittle(Address));
    let Response: bytes = Imports.Publisherˉwindowsˉimports(Request);
    if Bytesˉlength(Response) != 4128u32 ||
        Bytesˉreadˉu32ˉlittle(Response, 0u32) != 1296651863u32 ||
        Bytesˉreadˉu32ˉlittle(Response, 12u32) != 0u32 {
        diagnostic.write_line("publisher Windows imports status=Rejected");
        return 2;
    }
    file.write_bytes(process.argument(Outputˉindex), Response);
    console.write_line("publisher Windows imports status=Valid bytes=4128");
    return 0;
}
