module Linkerˉnativeˉhostedˉverifierˉstartupˉrequest profile portable;

import Foundationˉsha256 as Sha256;
import Linkerˉnativeˉhostedˉverifierˉlayout as Layout;
import Linkerˉnativeˉhostedˉverifierˉstartupˉtargets as Startupˉtargets;

export record Nativeˉhostedˉverifierˉstartupˉrequestˉresult {
    Valid: bool;
    Value: bytes;
    Codeˉbytes: u32;
    Failure: u32;
}

fn Empty(Input: bytes) -> bytes {
    return Bytesˉslice(Input, 0u32, 0u32);
}

fn Add(Input: bytes, Value: u32) -> bytes {
    return Bytesˉconcat(Input, Bytesˉfromˉu32ˉlittle(Value));
}

fn Failure(Input: bytes, Code: u32)
    -> Nativeˉhostedˉverifierˉstartupˉrequestˉresult {
    return Nativeˉhostedˉverifierˉstartupˉrequestˉresult(
        false,
        Empty(Input),
        0u32,
        Code
    );
}

fn Objectˉisˉexact(Object: bytes, Target: u32, Profile: u32) -> bool {
    var Expectedˉbytes: u32 = 1925u32;
    var Expectedˉdigest: bytes = Textˉtoˉutf8(
        "08a7afefb69904af8d8c899a86bec76e957dfe255d397dbd9015d9acaa018ae8"
    );
    if Target == 1u32 {
        Expectedˉbytes = 3651u32;
        Expectedˉdigest = Textˉtoˉutf8(
            "4d97a1f30d9c871f2a72911cea2644b32d3ea29a2dbbc76105ec4ab1d001b95f"
        );
    }
    if Profile == 4u32 || Profile == 5u32 || Profile == 6u32 ||
        Profile == 7u32 {
        Expectedˉbytes = 2291u32;
        Expectedˉdigest = Textˉtoˉutf8(
            "5d316c109b5c8964c019c44f96f42370408820c7db1ec278268cef541ba17ebb"
        );
        if Target == 1u32 {
            Expectedˉbytes = 4017u32;
            Expectedˉdigest = Textˉtoˉutf8(
                "95ff213a8e59f28d148eb8223a100a5b24dcbc3eb1b444264783a860f159fe49"
            );
        }
    }
    if Bytesˉlength(Object) != Expectedˉbytes { return false; }
    let Actual: bytes = Sha256.Foundationˉsha256ˉhex(Object);
    let Length: u32 = Bytesˉlength(Actual);
    if Length != Bytesˉlength(Expectedˉdigest) { return false; }
    var Index: u32 = 0u32;
    while Index < Length {
        if Bytesˉreadˉu8(Actual, Index) != Bytesˉreadˉu8(Expectedˉdigest, Index) {
            return false;
        }
        Index = Index + 1u32;
    }
    return true;
}

export fn Nativeˉhostedˉverifierˉstartupˉrequestˉforˉprofile(
    Runtime: bytes,
    Object: bytes,
    Expectedˉprofile: u32
) -> Nativeˉhostedˉverifierˉstartupˉrequestˉresult {
    let Value: Layout.Nativeˉhostedˉverifierˉlayout =
        Layout.Nativeˉhostedˉverifierˉplanˉforˉprofile(
            Runtime,
            Expectedˉprofile
        );
    if !Value.Valid { return Failure(Runtime, 1u32); }
    if !Objectˉisˉexact(Object, Value.Target, Expectedˉprofile) {
        return Failure(Runtime, 2u32);
    }
    let Targets: bytes =
        Startupˉtargets.Nativeˉhostedˉverifierˉstartupˉtargets(Runtime, Value);
    var Codeˉbytes: u32 = 668u32;
    var Symbols: u32 = 20u32;
    var Relocations: u32 = 24u32;
    var Targetˉpolicy: u32 = 0u32;
    if Value.Target == 1u32 {
        Codeˉbytes = 1301u32;
        Symbols = 34u32;
        Relocations = 46u32;
    }
    if Expectedˉprofile == 4u32 || Expectedˉprofile == 5u32 ||
        Expectedˉprofile == 6u32 ||
        Expectedˉprofile == 7u32 {
        Codeˉbytes = 743u32;
        Symbols = 25u32;
        Relocations = 29u32;
        if Value.Target == 1u32 {
            Codeˉbytes = 1376u32;
            Symbols = 39u32;
            Relocations = 51u32;
        }
    }
    if Expectedˉprofile == 5u32 { Targetˉpolicy = 1u32; }
    if Bytesˉlength(Targets) != Relocations * 4u32 {
        return Failure(Runtime, 3u32);
    }

    var Request: bytes = Empty(Runtime);
    Request = Add(Request, 1230198359u32);
    Request = Add(Request, 1u32);
    Request = Add(
        Request,
        40u32 + Bytesˉlength(Targets) + Bytesˉlength(Object)
    );
    Request = Add(Request, Value.Textˉaddress);
    Request = Add(Request, Codeˉbytes);
    Request = Add(Request, Symbols);
    Request = Add(Request, Relocations);
    Request = Add(Request, Relocations);
    Request = Add(Request, Bytesˉlength(Object));
    Request = Add(Request, Targetˉpolicy);
    Request = Bytesˉconcat(Request, Targets);
    Request = Bytesˉconcat(Request, Object);
    return Nativeˉhostedˉverifierˉstartupˉrequestˉresult(
        true,
        Request,
        Codeˉbytes,
        0u32
    );
}

export fn Nativeˉhostedˉverifierˉstartupˉrequest(
    Runtime: bytes,
    Object: bytes
) -> Nativeˉhostedˉverifierˉstartupˉrequestˉresult {
    return Nativeˉhostedˉverifierˉstartupˉrequestˉforˉprofile(
        Runtime,
        Object,
        2u32
    );
}
