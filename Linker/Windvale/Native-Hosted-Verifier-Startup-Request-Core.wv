module Linkerˉnativeˉhostedˉverifierˉstartupˉrequest profile portable;

import Foundationˉsha256 as Sha256;
import Linkerˉnativeˉhostedˉverifierˉlayout as Layout;

export record Nativeˉhostedˉverifierˉstartupˉrequestˉresult {
    Valid: bool;
    Value: bytes;
    Codeˉbytes: u32;
    Failure: u32;
}

fn Empty(Input: bytes) -> bytes {
    return Bytesˉslice(Input, 0u32, 0u32);
}

fn Add(Input: bytes, Value: u32) -> bytes {
    return Bytesˉconcat(Input, Bytesˉfromˉu32ˉlittle(Value));
}

fn Failure(Input: bytes, Code: u32)
    -> Nativeˉhostedˉverifierˉstartupˉrequestˉresult {
    return Nativeˉhostedˉverifierˉstartupˉrequestˉresult(
        false,
        Empty(Input),
        0u32,
        Code
    );
}

fn Runtimeˉaddress(
    Value: Layout.Nativeˉhostedˉverifierˉlayout,
    Index: u32
) -> u32 {
    return Value.Runtimeˉaddress +
        Layout.Nativeˉhostedˉverifierˉruntimeˉoffset(Index);
}

fn Windowsˉtargets(
    Runtime: bytes,
    Value: Layout.Nativeˉhostedˉverifierˉlayout
) -> bytes {
    let Import: u32 = Value.Importˉaddress;
    var Result: bytes = Empty(Runtime);
    Result = Add(Result, Runtimeˉaddress(Value, 0u32));
    Result = Add(Result, Runtimeˉaddress(Value, 1u32));
    Result = Add(Result, Runtimeˉaddress(Value, 2u32));
    Result = Add(Result, Runtimeˉaddress(Value, 3u32));
    Result = Add(Result, Runtimeˉaddress(Value, 4u32));
    Result = Add(Result, Runtimeˉaddress(Value, 6u32));
    Result = Add(Result, Runtimeˉaddress(Value, 7u32));
    Result = Add(Result, Runtimeˉaddress(Value, 7u32));
    Result = Add(Result, Runtimeˉaddress(Value, 8u32));
    Result = Add(Result, Runtimeˉaddress(Value, 9u32));
    Result = Add(Result, Runtimeˉaddress(Value, 10u32));
    Result = Add(Result, Runtimeˉaddress(Value, 11u32));
    Result = Add(Result, Import + 248u32);
    Result = Add(Result, Import + 200u32);
    Result = Add(Result, Import + 216u32);
    Result = Add(Result, Import + 256u32);
    Result = Add(Result, Import + 192u32);
    Result = Add(Result, Value.Textˉaddress + 1085u32);
    Result = Add(Result, Import + 224u32);
    Result = Add(Result, Import + 232u32);
    Result = Add(Result, Runtimeˉaddress(Value, 6u32));
    Result = Add(Result, Import + 232u32);
    Result = Add(Result, Import + 272u32);
    Result = Add(Result, Runtimeˉaddress(Value, 1u32));
    Result = Add(Result, Layout.Nativeˉhostedˉverifierˉserviceˉaddress(Runtime, 0u32));
    Result = Add(Result, Layout.Nativeˉhostedˉverifierˉserviceˉaddress(Runtime, 1u32));
    Result = Add(Result, Layout.Nativeˉhostedˉverifierˉserviceˉaddress(Runtime, 2u32));
    Result = Add(Result, Layout.Nativeˉhostedˉverifierˉserviceˉaddress(Runtime, 3u32));
    Result = Add(Result, Layout.Nativeˉhostedˉverifierˉserviceˉaddress(Runtime, 4u32));
    Result = Add(Result, Layout.Nativeˉhostedˉverifierˉserviceˉaddress(Runtime, 5u32));
    Result = Add(Result, Import + 208u32);
    Result = Add(Result, Import + 304u32);
    Result = Add(Result, Runtimeˉaddress(Value, 4u32));
    Result = Add(Result, Runtimeˉaddress(Value, 5u32));
    Result = Add(Result, Runtimeˉaddress(Value, 11u32));
    Result = Add(Result, Import + 264u32);
    Result = Add(Result, Layout.Nativeˉhostedˉverifierˉserviceˉaddress(Runtime, 4u32));
    Result = Add(Result, Import + 240u32);
    Result = Add(Result, Runtimeˉaddress(Value, 0u32));
    Result = Add(Result, 8192u32 + Value.Nativeˉentry);
    Result = Add(Result, Import + 240u32);
    Result = Add(Result, Runtimeˉaddress(Value, 10u32));
    Result = Add(Result, Runtimeˉaddress(Value, 9u32));
    Result = Add(Result, Runtimeˉaddress(Value, 10u32));
    return Add(Result, Runtimeˉaddress(Value, 11u32));
}

fn Linuxˉtargets(
    Runtime: bytes,
    Value: Layout.Nativeˉhostedˉverifierˉlayout
) -> bytes {
    var Result: bytes = Empty(Runtime);
    Result = Add(Result, Runtimeˉaddress(Value, 0u32));
    Result = Add(Result, Runtimeˉaddress(Value, 1u32));
    Result = Add(Result, Runtimeˉaddress(Value, 2u32));
    Result = Add(Result, Runtimeˉaddress(Value, 3u32));
    Result = Add(Result, Runtimeˉaddress(Value, 4u32));
    Result = Add(Result, Runtimeˉaddress(Value, 6u32));
    Result = Add(Result, Runtimeˉaddress(Value, 7u32));
    Result = Add(Result, Runtimeˉaddress(Value, 7u32));
    Result = Add(Result, Runtimeˉaddress(Value, 8u32));
    Result = Add(Result, Runtimeˉaddress(Value, 9u32));
    Result = Add(Result, Runtimeˉaddress(Value, 10u32));
    Result = Add(Result, Runtimeˉaddress(Value, 11u32));
    Result = Add(Result, Runtimeˉaddress(Value, 1u32));
    Result = Add(Result, Layout.Nativeˉhostedˉverifierˉserviceˉaddress(Runtime, 0u32));
    Result = Add(Result, Layout.Nativeˉhostedˉverifierˉserviceˉaddress(Runtime, 1u32));
    Result = Add(Result, Layout.Nativeˉhostedˉverifierˉserviceˉaddress(Runtime, 2u32));
    Result = Add(Result, Layout.Nativeˉhostedˉverifierˉserviceˉaddress(Runtime, 3u32));
    Result = Add(Result, Layout.Nativeˉhostedˉverifierˉserviceˉaddress(Runtime, 4u32));
    Result = Add(Result, Layout.Nativeˉhostedˉverifierˉserviceˉaddress(Runtime, 5u32));
    Result = Add(Result, Runtimeˉaddress(Value, 4u32));
    Result = Add(Result, Runtimeˉaddress(Value, 5u32));
    Result = Add(Result, Layout.Nativeˉhostedˉverifierˉserviceˉaddress(Runtime, 4u32));
    Result = Add(Result, Runtimeˉaddress(Value, 0u32));
    return Add(Result, 8192u32 + Value.Nativeˉentry);
}

fn Objectˉisˉexact(Object: bytes, Target: u32) -> bool {
    var Expectedˉbytes: u32 = 1925u32;
    var Expectedˉdigest: bytes = Textˉtoˉutf8(
        "08a7afefb69904af8d8c899a86bec76e957dfe255d397dbd9015d9acaa018ae8"
    );
    if Target == 1u32 {
        Expectedˉbytes = 3561u32;
        Expectedˉdigest = Textˉtoˉutf8(
            "755ffb99cba6a838dd9eec353ce72d4adfb3af130ec4bce5a2278828dd136616"
        );
    }
    if Bytesˉlength(Object) != Expectedˉbytes { return false; }
    let Actual: bytes = Sha256.Foundationˉsha256ˉhex(Object);
    let Length: u32 = Bytesˉlength(Actual);
    if Length != Bytesˉlength(Expectedˉdigest) { return false; }
    var Index: u32 = 0u32;
    while Index < Length {
        if Bytesˉreadˉu8(Actual, Index) != Bytesˉreadˉu8(Expectedˉdigest, Index) {
            return false;
        }
        Index = Index + 1u32;
    }
    return true;
}

export fn Nativeˉhostedˉverifierˉstartupˉrequest(
    Runtime: bytes,
    Object: bytes
) -> Nativeˉhostedˉverifierˉstartupˉrequestˉresult {
    let Value: Layout.Nativeˉhostedˉverifierˉlayout =
        Layout.Nativeˉhostedˉverifierˉplan(Runtime);
    if !Value.Valid { return Failure(Runtime, 1u32); }
    if !Objectˉisˉexact(Object, Value.Target) {
        return Failure(Runtime, 2u32);
    }
    var Targets: bytes = Linuxˉtargets(Runtime, Value);
    var Codeˉbytes: u32 = 668u32;
    var Symbols: u32 = 20u32;
    var Relocations: u32 = 24u32;
    if Value.Target == 1u32 {
        Targets = Windowsˉtargets(Runtime, Value);
        Codeˉbytes = 1275u32;
        Symbols = 33u32;
        Relocations = 45u32;
    }
    if Bytesˉlength(Targets) != Relocations * 4u32 {
        return Failure(Runtime, 3u32);
    }

    var Request: bytes = Empty(Runtime);
    Request = Add(Request, 1230198359u32);
    Request = Add(Request, 1u32);
    Request = Add(
        Request,
        40u32 + Bytesˉlength(Targets) + Bytesˉlength(Object)
    );
    Request = Add(Request, Value.Textˉaddress);
    Request = Add(Request, Codeˉbytes);
    Request = Add(Request, Symbols);
    Request = Add(Request, Relocations);
    Request = Add(Request, Relocations);
    Request = Add(Request, Bytesˉlength(Object));
    Request = Add(Request, 0u32);
    Request = Bytesˉconcat(Request, Targets);
    Request = Bytesˉconcat(Request, Object);
    return Nativeˉhostedˉverifierˉstartupˉrequestˉresult(
        true,
        Request,
        Codeˉbytes,
        0u32
    );
}
