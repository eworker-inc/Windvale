module Linkerˉnativeˉhostedˉverifierˉpublisherˉstructureˉrequestˉtool profile hosted;

import Linkerˉnativeˉhostedˉverifierˉpublisherˉstructureˉrequest as Request;
import Linkerˉnativeˉcurrentˉpublisherˉobjectˉadmission as Current;

capability console.write_line;
capability diagnostic.write_line;
capability file.read_bytes;
capability file.write_bytes;
capability process.argument;
capability process.argument_count;

fn Pathsˉareˉequal(Left: text, Right: text) -> bool {
    let Leftˉbytes: bytes = Textˉtoˉutf8(Left);
    let Rightˉbytes: bytes = Textˉtoˉutf8(Right);
    if Bytesˉlength(Leftˉbytes) != Bytesˉlength(Rightˉbytes) { return false; }
    var Index: u32 = 0u32;
    while Index < Bytesˉlength(Leftˉbytes) {
        if Bytesˉreadˉu8(Leftˉbytes, Index) != Bytesˉreadˉu8(Rightˉbytes, Index) { return false; }
        Index = Index + 1u32;
    }
    return true;
}

fn Usage() -> i32 {
    diagnostic.write_line("Usage: wvhostverifierstructure <identity.wvpi> <structure.wvps>");
    diagnostic.write_line("   or: wvhostverifierstructure --current-object <role-1-through-6> <object.wvo>");
    return 64;
}

fn Inspectˉcurrentˉobject() -> i32 {
    if !Pathsˉareˉequal(process.argument(0u32), "--current-object") { return Usage(); }
    let Roleˉbytes: bytes = Textˉtoˉutf8(process.argument(1u32));
    if Bytesˉlength(Roleˉbytes) != 1u32 { return Usage(); }
    let Digit: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(Roleˉbytes, 0u32));
    if Digit < 49u32 || Digit > 54u32 { return Usage(); }
    let Role: u32 = Digit - 48u32;
    let Inspection: Current.Publisherˉobjectˉinspection =
        Current.Publisherˉcurrentˉobjectˉinspect(file.read_bytes(process.argument(2u32)), Role);
    if !Inspection.Valid {
        diagnostic.write_line("publisher current object status=Rejected");
        return 2;
    }
    var Report: text = Textˉconcat("publisher current object status=Valid format=1 role=", U32ˉformat(Role));
    Report = Textˉconcat(Report, Textˉconcat(" code-bytes=", U32ˉformat(Inspection.Codeˉbytes)));
    Report = Textˉconcat(Report, Textˉconcat(" read-only-bytes=", U32ˉformat(Inspection.Readˉonlyˉbytes)));
    Report = Textˉconcat(Report, Textˉconcat(" entry-offset=", U32ˉformat(Inspection.Entryˉoffset)));
    Report = Textˉconcat(Report, Textˉconcat(" secondary-offset=", U32ˉformat(Inspection.Secondaryˉoffset)));
    Report = Textˉconcat(Report, Textˉconcat(" imports=", U32ˉformat(Inspection.Imports)));
    console.write_line(Report);
    return 0;
}

export fn Main() -> i32 {
    if process.argument_count() == 3u32 { return Inspectˉcurrentˉobject(); }
    if process.argument_count() != 2u32 { return Usage(); }
    let Inputˉpath: text = process.argument(0u32);
    let Outputˉpath: text = process.argument(1u32);
    if Pathsˉareˉequal(Inputˉpath, Outputˉpath) { return Usage(); }
    let Result: Request.Publisherˉstructureˉrequestˉresult =
        Request.Publisherˉstructureˉrequest(file.read_bytes(Inputˉpath));
    if !Result.Valid {
        diagnostic.write_line("publisher structure request status=Rejected");
        return 2;
    }
    file.write_bytes(Outputˉpath, Result.Value);
    console.write_line("publisher structure request status=Valid bytes=128");
    return 0;
}
