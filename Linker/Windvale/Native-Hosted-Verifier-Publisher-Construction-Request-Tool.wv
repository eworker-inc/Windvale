module Linkerˉnativeˉhostedˉverifierˉpublisherˉconstructionˉrequestˉtool profile hosted;

import Linkerˉnativeˉhostedˉverifierˉpublisherˉconstructionˉrequest as Request;

capability console.write_line;
capability diagnostic.write_line;
capability file.read_bytes;
capability file.write_bytes;
capability process.argument;
capability process.argument_count;

fn Pathsˉareˉequal(Left: text, Right: text) -> bool {
    let Leftˉbytes: bytes = Textˉtoˉutf8(Left);
    let Rightˉbytes: bytes = Textˉtoˉutf8(Right);
    let Length: u32 = Bytesˉlength(Leftˉbytes);
    if Length != Bytesˉlength(Rightˉbytes) { return false; }
    var Index: u32 = 0u32;
    while Index < Length {
        if Bytesˉreadˉu8(Leftˉbytes, Index) !=
            Bytesˉreadˉu8(Rightˉbytes, Index) {
            return false;
        }
        Index = Index + 1u32;
    }
    return true;
}

fn Usage() -> i32 {
    diagnostic.write_line(
        "Usage: wvhostverifierconstructrequest <structure.wvps> <request.wvcr>"
    );
    return 64;
}

fn Reject() -> i32 {
    diagnostic.write_line("publisher construction request status=Rejected");
    return 2;
}

export fn Main() -> i32 {
    if process.argument_count() != 2u32 { return Usage(); }
    let Inputˉpath: text = process.argument(0u32);
    let Outputˉpath: text = process.argument(1u32);
    if Pathsˉareˉequal(Inputˉpath, Outputˉpath) { return Usage(); }
    let Result: Request.Publisherˉconstructionˉrequestˉresult =
        Request.Publisherˉconstructionˉrequest(
            file.read_bytes(Inputˉpath)
        );
    if !Result.Valid { return Reject(); }
    file.write_bytes(Outputˉpath, Result.Value);
    console.write_line(
        Textˉconcat(
            "publisher construction request status=Valid bytes=",
            U32ˉformat(Bytesˉlength(Result.Value))
        )
    );
    return 0;
}
