module Linkerˉnativeˉhostedˉverifierˉpublisherˉwindowsˉmaterializationˉtool profile hosted;

import Linkerˉnativeˉhostedˉverifierˉpublisherˉfileˉtoolˉsupport as Support;
import Linkerˉnativeˉhostedˉverifierˉpublisherˉwindowsˉmaterialization as Materialization;

capability console.write_line;
capability diagnostic.write_line;
capability file.read_bytes;
capability file.write_bytes;
capability process.argument;
capability process.argument_count;

fn Usage() -> i32 {
    diagnostic.write_line("Usage: wvhostverifierpublishwindows <base.exe> <request.wvcr> <objects.wvio> <metadata.wvvp> <imports.wvim> <application.exe>");
    return 64;
}

export fn Main() -> i32 {
    if process.argument_count() != 6u32 { return Usage(); }
    let Outputˉpath: text = process.argument(5u32);
    var Index: u32 = 0u32;
    while Index < 5u32 {
        if Support.Pathsˉareˉequal(process.argument(Index), Outputˉpath) { return Usage(); }
        Index = Index + 1u32;
    }
    let Base: bytes = file.read_bytes(process.argument(0u32));
    let Construction: bytes = file.read_bytes(process.argument(1u32));
    let Objects: bytes = file.read_bytes(process.argument(2u32));
    let Metadata: bytes = file.read_bytes(process.argument(3u32));
    let Imports: bytes = file.read_bytes(process.argument(4u32));
    var Request: bytes = Bytesˉfromˉu32ˉlittle(1297569367u32);
    Request = Support.Appendˉu32(Request, 1u32);
    Request = Support.Appendˉu32(Request, 260608u32);
    Request = Support.Appendˉu32(Request, 1u32);
    Request = Support.Appendˉu32(Request, 64u32);
    Request = Support.Appendˉu32(Request, Bytesˉlength(Base));
    Request = Support.Appendˉu32(Request, 248896u32);
    Request = Support.Appendˉu32(Request, Bytesˉlength(Construction));
    Request = Support.Appendˉu32(Request, 249312u32);
    Request = Support.Appendˉu32(Request, Bytesˉlength(Objects));
    Request = Support.Appendˉu32(Request, 256352u32);
    Request = Support.Appendˉu32(Request, Bytesˉlength(Metadata));
    Request = Support.Appendˉu32(Request, 256480u32);
    Request = Support.Appendˉu32(Request, Bytesˉlength(Imports));
    Request = Support.Appendˉu32(Request, 0u32);
    Request = Support.Appendˉu32(Request, 0u32);
    Request = Bytesˉconcat(Request, Base);
    Request = Bytesˉconcat(Request, Construction);
    Request = Bytesˉconcat(Request, Objects);
    Request = Bytesˉconcat(Request, Metadata);
    Request = Bytesˉconcat(Request, Imports);
    let Response: bytes = Materialization.Publisherˉwindowsˉmaterialize(Request);
    if Bytesˉlength(Response) != 256032u32 ||
        Bytesˉreadˉu32ˉlittle(Response, 12u32) != 0u32 {
        diagnostic.write_line("publisher Windows materialization status=Rejected");
        return 2;
    }
    file.write_bytes(Outputˉpath, Bytesˉslice(Response, 32u32, 256000u32));
    console.write_line("publisher Windows materialization status=Valid bytes=256000");
    return 0;
}
