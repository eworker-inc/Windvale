export fn Publisherˉconstructionˉtarget(Target: u32, Variant: u32, Index: u32) -> u32 {
    if Variant == 4u32 && Target == 1u32 && Index < 44u32 {
        return Consoleˉpublisherˉwindowsˉtarget(Index);
    }
    if Variant == 4u32 && Target == 2u32 && Index < 27u32 {
        return Consoleˉpublisherˉlinuxˉtarget(Index);
    }
    if Variant == 3u32 && Target == 1u32 && Index < 44u32 {
        return Wvoˉpublisherˉwindowsˉtarget(Index);
    }
    if Variant == 3u32 && Target == 2u32 && Index < 27u32 {
        return Wvoˉpublisherˉlinuxˉtarget(Index);
    }
    if Variant == 2u32 && Target == 1u32 && Index < 44u32 {
        return Wvbˉpublisherˉwindowsˉtarget(Index);
    }
    if Variant == 2u32 && Target == 2u32 && Index < 27u32 {
        return Wvbˉpublisherˉlinuxˉtarget(Index);
    }
    if Variant == 1u32 && Target == 1u32 && Index < 44u32 {
        return Promoterˉwindowsˉtarget(Index);
    }
    if Variant == 1u32 && Target == 2u32 && Index < 27u32 {
        return Promoterˉlinuxˉtarget(Index);
    }
    if Target == 1u32 && Index < 44u32 { return Windowsˉtarget(Index); }
    if Target == 2u32 && Index < 27u32 { return Linuxˉtarget(Index); }
    return 0u32;
}
