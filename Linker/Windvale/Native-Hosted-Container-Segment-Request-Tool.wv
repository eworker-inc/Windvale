module Nativeˉhostedˉcontainerˉsegmentˉrequestˉtool profile hosted;

import Foundationˉdecimalˉparsing as Decimal;
import Foundationˉimmutableˉsourceˉregions as Sources;
import Linkerˉnativeˉhostedˉcontainerˉsegmentationˉcore as Segmentation;

capability console.write_line;
capability diagnostic.write_line;
capability file.read_bytes;
capability file.write_bytes;
capability process.argument;
capability process.argument_count;

enum Nativeˉhostedˉcontainerˉsegmentˉrequestˉstatus {
    Valid = 0;
    Rejected = 1;
}

const SEGMENT_BYTES: u32 = 4194144u32;

fn Empty(Input: bytes) -> bytes {
    return Bytesˉslice(Input, 0u32, 0u32);
}

fn Appendˉu32(Output: bytes, Value: u32) -> bytes {
    return Bytesˉconcat(Output, Bytesˉfromˉu32ˉlittle(Value));
}

fn Maximum(Left: u32, Right: u32) -> u32 {
    if Left > Right { return Left; }
    return Right;
}

fn Minimum(Left: u32, Right: u32) -> u32 {
    if Left < Right { return Left; }
    return Right;
}

fn Bytesˉareˉequal(Left: bytes, Right: bytes) -> bool {
    let Length: u32 = Bytesˉlength(Left);
    if Length != Bytesˉlength(Right) { return false; }
    var Index: u32 = 0u32;
    while Index < Length {
        if Bytesˉreadˉu8(Left, Index) != Bytesˉreadˉu8(Right, Index) {
            return false;
        }
        Index = Index + 1u32;
    }
    return true;
}

fn Pathsˉareˉequal(Left: text, Right: text) -> bool {
    return Bytesˉareˉequal(Textˉtoˉutf8(Left), Textˉtoˉutf8(Right));
}

fn Reject() -> i32 {
    diagnostic.write_line(
        Textˉconcat(
            "hosted container segment request status=",
            Enumˉname(
                Nativeˉhostedˉcontainerˉsegmentˉrequestˉstatus.Rejected
            )
        )
    );
    return 2;
}

fn Sourcesˉmatchˉplan(
    Planˉbytes: bytes,
    Manifest: bytes,
    Plan: Sources.Immutableˉsourceˉregionˉplan
) -> bool {
    if Bytesˉlength(Planˉbytes) < 128u32 ||
        Bytesˉreadˉu32ˉlittle(Planˉbytes, 8u32) !=
            Bytesˉlength(Planˉbytes) ||
        Bytesˉreadˉu32ˉlittle(Planˉbytes, 12u32) != 0u32 ||
        !Segmentation.Nativeˉhostedˉcontainerˉplanˉisˉvalid(
            Bytesˉslice(Planˉbytes, 0u32, 128u32)
        ) ||
        !Plan.Valid || Plan.Regions != 6u32 ||
        Plan.Imageˉbytes !=
            Bytesˉreadˉu32ˉlittle(Planˉbytes, 28u32) {
        return false;
    }
    var Expectedˉlogical: u32 = 0u32;
    var Index: u32 = 0u32;
    while Index < 6u32 {
        let Record: u32 = Plan.Regionˉbase + Index * 16u32;
        var Expectedˉimage: u32 = 0u32;
        var Expectedˉbytes: u32 =
            Bytesˉreadˉu32ˉlittle(Planˉbytes, 36u32);
        if Index == 1u32 {
            Expectedˉimage =
                Bytesˉreadˉu32ˉlittle(Planˉbytes, 40u32);
            Expectedˉbytes =
                Bytesˉreadˉu32ˉlittle(Planˉbytes, 44u32);
        }
        if Index == 2u32 {
            Expectedˉimage =
                Bytesˉreadˉu32ˉlittle(Planˉbytes, 48u32);
            Expectedˉbytes =
                Bytesˉreadˉu32ˉlittle(Planˉbytes, 52u32);
        }
        if Index == 3u32 {
            Expectedˉimage =
                Bytesˉreadˉu32ˉlittle(Planˉbytes, 56u32);
            Expectedˉbytes =
                Bytesˉreadˉu32ˉlittle(Planˉbytes, 60u32);
        }
        if Index == 4u32 {
            Expectedˉimage =
                Bytesˉreadˉu32ˉlittle(Planˉbytes, 64u32);
            Expectedˉbytes =
                Bytesˉreadˉu32ˉlittle(Planˉbytes, 68u32);
        }
        if Index == 5u32 {
            Expectedˉimage =
                Bytesˉreadˉu32ˉlittle(Planˉbytes, 72u32);
            Expectedˉbytes =
                Bytesˉreadˉu32ˉlittle(Planˉbytes, 76u32);
        }
        if Bytesˉreadˉu32ˉlittle(Manifest, Record) != Index ||
            Bytesˉreadˉu32ˉlittle(Manifest, Record + 4u32) !=
                Expectedˉlogical ||
            Bytesˉreadˉu32ˉlittle(Manifest, Record + 8u32) !=
                Expectedˉimage ||
            Bytesˉreadˉu32ˉlittle(Manifest, Record + 12u32) !=
                Expectedˉbytes {
            return false;
        }
        Expectedˉlogical = Expectedˉlogical + Expectedˉbytes;
        Index = Index + 1u32;
    }
    return Expectedˉlogical == Plan.Logicalˉbytes;
}

fn Payloadˉbytes(
    Manifest: bytes,
    Plan: Sources.Immutableˉsourceˉregionˉplan,
    Segmentˉstart: u32,
    Segmentˉend: u32
) -> u32 {
    var Total: u32 = 0u32;
    var Index: u32 = 0u32;
    while Index < Plan.Regions {
        let Record: u32 = Plan.Regionˉbase + Index * 16u32;
        let Imageˉstart: u32 =
            Bytesˉreadˉu32ˉlittle(Manifest, Record + 8u32);
        let Imageˉend: u32 = Imageˉstart +
            Bytesˉreadˉu32ˉlittle(Manifest, Record + 12u32);
        let Start: u32 = Maximum(Imageˉstart, Segmentˉstart);
        let End: u32 = Minimum(Imageˉend, Segmentˉend);
        if Start < End { Total = Total + End - Start; }
        Index = Index + 1u32;
    }
    return Total;
}

export fn Main() -> i32 {
    if process.argument_count() != 5u32 {
        diagnostic.write_line(
            "Usage: wvhostsegmentrequest <plan.wvcd> <sources.wvsg> <chunk-prefix> <segment-index> <request.wvht>"
        );
        return 64;
    }
    let Planˉpath: text = process.argument(0u32);
    let Manifestˉpath: text = process.argument(1u32);
    let Prefix: text = process.argument(2u32);
    let Indexˉtext: bytes = Textˉtoˉutf8(process.argument(3u32));
    let Outputˉpath: text = process.argument(4u32);
    if Pathsˉareˉequal(Planˉpath, Manifestˉpath) ||
        Pathsˉareˉequal(Planˉpath, Outputˉpath) ||
        Pathsˉareˉequal(Manifestˉpath, Outputˉpath) ||
        !Sources.Immutableˉsourceˉprefixˉisˉvalid(Prefix) {
        return Reject();
    }
    let Parsed: Decimal.Foundationˉu32ˉparse =
        Decimal.Foundationˉu32ˉdecimalˉparse(
            Indexˉtext, 0u32, Bytesˉlength(Indexˉtext)
        );
    if !Parsed.Valid { return Reject(); }

    let Manifest: bytes = file.read_bytes(Manifestˉpath);
    let Sourceˉplan: Sources.Immutableˉsourceˉregionˉplan =
        Sources.Immutableˉsourceˉregionsˉadmit(Manifest);
    if !Sourceˉplan.Valid { return Reject(); }
    var Chunk: u32 = 0u32;
    while Chunk < Sourceˉplan.Chunks {
        let Resourceˉpath: text =
            Sources.Immutableˉsourceˉresourceˉname(Prefix, Chunk);
        if Pathsˉareˉequal(Resourceˉpath, Planˉpath) ||
            Pathsˉareˉequal(Resourceˉpath, Manifestˉpath) ||
            Pathsˉareˉequal(Resourceˉpath, Outputˉpath) ||
            !Sources.Immutableˉsourceˉresourceˉisˉvalid(
                Manifest, Chunk, file.read_bytes(Resourceˉpath)
            ) {
            return Reject();
        }
        Chunk = Chunk + 1u32;
    }

    let Containerˉplan: bytes = file.read_bytes(Planˉpath);
    if !Sourcesˉmatchˉplan(Containerˉplan, Manifest, Sourceˉplan) {
        return Reject();
    }
    let Imageˉbytes: u32 = Sourceˉplan.Imageˉbytes;
    var Segments: u32 = Imageˉbytes / SEGMENT_BYTES;
    if Imageˉbytes % SEGMENT_BYTES != 0u32 { Segments = Segments + 1u32; }
    if Parsed.Value >= Segments { return Reject(); }
    let Segmentˉstart: u32 = Parsed.Value * SEGMENT_BYTES;
    var Segmentˉlength: u32 = Imageˉbytes - Segmentˉstart;
    if Segmentˉlength > SEGMENT_BYTES { Segmentˉlength = SEGMENT_BYTES; }
    let Segmentˉend: u32 = Segmentˉstart + Segmentˉlength;
    let Payload: u32 = Payloadˉbytes(
        Manifest, Sourceˉplan, Segmentˉstart, Segmentˉend
    );
    let Total: u32 = 160u32 + Payload;
    if Total > 4194304u32 { return Reject(); }

    var Result: bytes = Empty(Containerˉplan);
    Result = Appendˉu32(Result, 1414026839u32);
    Result = Appendˉu32(Result, 1u32);
    Result = Appendˉu32(Result, Total);
    Result = Appendˉu32(Result, 128u32);
    Result = Appendˉu32(Result, Segmentˉstart);
    Result = Appendˉu32(Result, Segmentˉlength);
    Result = Appendˉu32(Result, Payload);
    Result = Appendˉu32(Result, 0u32);
    Result = Bytesˉconcat(Result, Bytesˉslice(Containerˉplan, 0u32, 128u32));
    var Appended: u32 = 0u32;
    var Region: u32 = 0u32;
    while Region < Sourceˉplan.Regions {
        var Sourceˉstate: Sources.Immutableˉsourceˉregionˉappend =
            Sources.Immutableˉsourceˉregionˉappendˉbegin(
                Result,
                Manifest,
                Sourceˉplan,
                Region,
                Segmentˉstart,
                Segmentˉend
            );
        Chunk = 0u32;
        while Chunk < Sourceˉplan.Chunks {
            Sourceˉstate = Sources.Immutableˉsourceˉregionˉappendˉupdate(
                Sourceˉstate,
                Manifest,
                Chunk,
                file.read_bytes(
                    Sources.Immutableˉsourceˉresourceˉname(Prefix, Chunk)
                )
            );
            Chunk = Chunk + 1u32;
        }
        let Part: Sources.Immutableˉsourceˉappend =
            Sources.Immutableˉsourceˉregionˉappendˉfinish(Sourceˉstate);
        if !Part.Valid { return Reject(); }
        Result = Part.Value;
        Appended = Appended + Part.Appendedˉbytes;
        Region = Region + 1u32;
    }
    if Appended != Payload || Bytesˉlength(Result) != Total { return Reject(); }
    file.write_bytes(Outputˉpath, Result);
    console.write_line(
        Textˉconcat(
            Textˉconcat(
                Textˉconcat(
                    "hosted container segment request status=Valid segment=",
                    U32ˉformat(Parsed.Value)
                ),
                " bytes="
            ),
            U32ˉformat(Total)
        )
    );
    return 0;
}
