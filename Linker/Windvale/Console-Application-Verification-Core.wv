module Linkerˉconsoleˉapplicationˉverification profile portable;

import Linkerˉconsoleˉapplicationˉconstruction as Applicationˉconstruction;

export enum Consoleˉapplicationˉverificationˉstatus {
    Valid = 0;
    Invalidˉchunk = 1;
    Invalidˉsize = 2;
    Invalidˉidentity = 3;
    Invalidˉnativeˉimage = 4;
    Invalidˉentry = 5;
    Invalidˉrecipe = 6;
    Invalidˉcontainer = 7;
}

export record Consoleˉapplicationˉverificationˉresult {
    Status: Consoleˉapplicationˉverificationˉstatus;
    Failureˉoffset: u32;
    Target: u32;
    Applicationˉbytes: u32;
    Nativeˉimage: bytes;
    Nativeˉentryˉoffset: u32;
    Evidence: bytes;
}

record Consoleˉapplicationˉrecipeˉheaderˉverification {
    Valid: bool;
    Failureˉoffset: u32;
    Segmentˉcount: u32;
    Payloadˉoffset: u32;
}

record Consoleˉapplicationˉrecipeˉsegmentˉverification {
    Status: Consoleˉapplicationˉverificationˉstatus;
    Failureˉoffset: u32;
    Nativeˉoffset: u32;
}

record Consoleˉapplicationˉheaderˉverification {
    Status: Consoleˉapplicationˉverificationˉstatus;
    Failureˉoffset: u32;
    Target: u32;
    Nativeˉimageˉbytes: u32;
    Nativeˉentryˉoffset: u32;
}

export fn Consoleˉapplicationˉverificationˉstatusˉvalue(
    Status: Consoleˉapplicationˉverificationˉstatus
) -> u32 {
    if Status == Consoleˉapplicationˉverificationˉstatus.Invalidˉchunk { return 1u32; }
    if Status == Consoleˉapplicationˉverificationˉstatus.Invalidˉsize { return 2u32; }
    if Status == Consoleˉapplicationˉverificationˉstatus.Invalidˉidentity { return 3u32; }
    if Status == Consoleˉapplicationˉverificationˉstatus.Invalidˉnativeˉimage { return 4u32; }
    if Status == Consoleˉapplicationˉverificationˉstatus.Invalidˉentry { return 5u32; }
    if Status == Consoleˉapplicationˉverificationˉstatus.Invalidˉrecipe { return 6u32; }
    if Status == Consoleˉapplicationˉverificationˉstatus.Invalidˉcontainer { return 7u32; }
    return 0u32;
}

export fn Consoleˉapplicationˉverificationˉevidence(
    Input: bytes,
    Status: Consoleˉapplicationˉverificationˉstatus,
    Failureˉoffset: u32,
    Target: u32,
    Applicationˉbytes: u32,
    Nativeˉimageˉbytes: u32,
    Nativeˉentryˉoffset: u32
) -> bytes {
    var Result: bytes = Bytesˉslice(Input, 0u32, 0u32);
    Result = Applicationˉconstruction.Consoleˉapplicationˉconstructionˉappendˉu32(Result, 1447253591u32);
    Result = Applicationˉconstruction.Consoleˉapplicationˉconstructionˉappendˉu32(Result, 1u32);
    Result = Applicationˉconstruction.Consoleˉapplicationˉconstructionˉappendˉu32(Result, 36u32);
    Result = Applicationˉconstruction.Consoleˉapplicationˉconstructionˉappendˉu32(
        Result, Consoleˉapplicationˉverificationˉstatusˉvalue(Status)
    );
    Result = Applicationˉconstruction.Consoleˉapplicationˉconstructionˉappendˉu32(Result, Failureˉoffset);
    Result = Applicationˉconstruction.Consoleˉapplicationˉconstructionˉappendˉu32(Result, Target);
    Result = Applicationˉconstruction.Consoleˉapplicationˉconstructionˉappendˉu32(Result, Applicationˉbytes);
    Result = Applicationˉconstruction.Consoleˉapplicationˉconstructionˉappendˉu32(Result, Nativeˉimageˉbytes);
    return Applicationˉconstruction.Consoleˉapplicationˉconstructionˉappendˉu32(Result, Nativeˉentryˉoffset);
}

export fn Consoleˉapplicationˉverificationˉfailure(
    Input: bytes,
    Status: Consoleˉapplicationˉverificationˉstatus,
    Failureˉoffset: u32,
    Target: u32,
    Applicationˉbytes: u32
) -> Consoleˉapplicationˉverificationˉresult {
    let Empty: bytes = Bytesˉslice(Input, 0u32, 0u32);
    return Consoleˉapplicationˉverificationˉresult(
        Status,
        Failureˉoffset,
        Target,
        Applicationˉbytes,
        Empty,
        0u32,
        Consoleˉapplicationˉverificationˉevidence(
            Input, Status, Failureˉoffset, Target, Applicationˉbytes, 0u32, 0u32
        )
    );
}

export fn Consoleˉapplicationˉverificationˉbyte(
    First: bytes,
    Second: bytes,
    Offset: u32
) -> u8 {
    let Firstˉbytes: u32 = Bytesˉlength(First);
    if Offset < Firstˉbytes { return Bytesˉreadˉu8(First, Offset); }
    return Bytesˉreadˉu8(Second, Offset - Firstˉbytes);
}

export fn Consoleˉapplicationˉverificationˉcompare(
    First: bytes,
    Second: bytes,
    Candidateˉoffset: u32,
    Expected: bytes,
    Expectedˉoffset: u32,
    Length: u32,
    Equalˉoffset: u32
) -> u32 {
    var Index: u32 = 0u32;
    while Index < Length {
        if Consoleˉapplicationˉverificationˉbyte(
            First, Second, Candidateˉoffset + Index
        ) != Bytesˉreadˉu8(Expected, Expectedˉoffset + Index) {
            return Candidateˉoffset + Index;
        }
        Index = Index + 1u32;
    }
    return Equalˉoffset;
}

export fn Consoleˉapplicationˉverificationˉzeros(
    First: bytes,
    Second: bytes,
    Offset: u32,
    Length: u32,
    Equalˉoffset: u32
) -> u32 {
    var Index: u32 = 0u32;
    while Index < Length {
        if Consoleˉapplicationˉverificationˉbyte(First, Second, Offset + Index) != 0u8 {
            return Offset + Index;
        }
        Index = Index + 1u32;
    }
    return Equalˉoffset;
}

export fn Consoleˉapplicationˉverificationˉrequest(
    Input: bytes,
    Target: u32,
    Nativeˉimageˉbytes: u32,
    Nativeˉentryˉoffset: u32
) -> bytes {
    var Result: bytes = Bytesˉslice(Input, 0u32, 0u32);
    Result = Applicationˉconstruction.Consoleˉapplicationˉconstructionˉappendˉu32(Result, 1363367511u32);
    Result = Applicationˉconstruction.Consoleˉapplicationˉconstructionˉappendˉu32(Result, 1u32);
    Result = Applicationˉconstruction.Consoleˉapplicationˉconstructionˉappendˉu32(Result, 32u32);
    Result = Applicationˉconstruction.Consoleˉapplicationˉconstructionˉappendˉu32(Result, Target);
    Result = Applicationˉconstruction.Consoleˉapplicationˉconstructionˉappendˉu32(Result, Nativeˉimageˉbytes);
    Result = Applicationˉconstruction.Consoleˉapplicationˉconstructionˉappendˉu32(Result, Nativeˉentryˉoffset);
    Result = Applicationˉconstruction.Consoleˉapplicationˉconstructionˉappendˉu32(Result, 0u32);
    return Applicationˉconstruction.Consoleˉapplicationˉconstructionˉappendˉu32(Result, 0u32);
}

export fn Consoleˉapplicationˉverificationˉnativeˉimage(
    First: bytes,
    Second: bytes,
    Offset: u32,
    Length: u32
) -> bytes {
    let Firstˉbytes: u32 = Bytesˉlength(First);
    if Offset >= Firstˉbytes {
        return Bytesˉslice(Second, Offset - Firstˉbytes, Length);
    }
    let Available: u32 = Firstˉbytes - Offset;
    if Length <= Available { return Bytesˉslice(First, Offset, Length); }
    return Bytesˉconcat(
        Bytesˉslice(First, Offset, Available),
        Bytesˉslice(Second, 0u32, Length - Available)
    );
}

fn Consoleˉapplicationˉverificationˉrecipeˉheader(
    Recipe: bytes,
    Target: u32,
    Applicationˉbytes: u32,
    Nativeˉimageˉbytes: u32,
    Nativeˉentryˉoffset: u32
) -> Consoleˉapplicationˉrecipeˉheaderˉverification {
    let Recipeˉbytes: u32 = Bytesˉlength(Recipe);
    if Recipeˉbytes < 40u32 {
        return Consoleˉapplicationˉrecipeˉheaderˉverification(
            false, 0u32, 0u32, 0u32
        );
    }
    if Bytesˉreadˉu32ˉlittle(Recipe, 0u32) != 1128486487u32 {
        return Consoleˉapplicationˉrecipeˉheaderˉverification(
            false, 0u32, 0u32, 0u32
        );
    }
    if Bytesˉreadˉu32ˉlittle(Recipe, 4u32) != 1u32 {
        return Consoleˉapplicationˉrecipeˉheaderˉverification(
            false, 4u32, 0u32, 0u32
        );
    }
    if Bytesˉreadˉu32ˉlittle(Recipe, 8u32) != Recipeˉbytes {
        return Consoleˉapplicationˉrecipeˉheaderˉverification(
            false, 8u32, 0u32, 0u32
        );
    }
    if Bytesˉreadˉu32ˉlittle(Recipe, 12u32) != 0u32 {
        return Consoleˉapplicationˉrecipeˉheaderˉverification(
            false, 12u32, 0u32, 0u32
        );
    }
    if Bytesˉreadˉu32ˉlittle(Recipe, 16u32) != 32u32 {
        return Consoleˉapplicationˉrecipeˉheaderˉverification(
            false, 16u32, 0u32, 0u32
        );
    }
    if Bytesˉreadˉu32ˉlittle(Recipe, 20u32) != Target {
        return Consoleˉapplicationˉrecipeˉheaderˉverification(
            false, 20u32, 0u32, 0u32
        );
    }
    if Bytesˉreadˉu32ˉlittle(Recipe, 24u32) != Applicationˉbytes {
        return Consoleˉapplicationˉrecipeˉheaderˉverification(
            false, 24u32, 0u32, 0u32
        );
    }
    if Bytesˉreadˉu32ˉlittle(Recipe, 28u32) != Nativeˉimageˉbytes {
        return Consoleˉapplicationˉrecipeˉheaderˉverification(
            false, 28u32, 0u32, 0u32
        );
    }
    if Bytesˉreadˉu32ˉlittle(Recipe, 32u32) != Nativeˉentryˉoffset {
        return Consoleˉapplicationˉrecipeˉheaderˉverification(
            false, 32u32, 0u32, 0u32
        );
    }
    let Segmentˉcount: u32 = Bytesˉreadˉu32ˉlittle(Recipe, 36u32);
    if Segmentˉcount == 0u32 {
        return Consoleˉapplicationˉrecipeˉheaderˉverification(
            false, 36u32, 0u32, 0u32
        );
    }
    if Segmentˉcount > 5u32 {
        return Consoleˉapplicationˉrecipeˉheaderˉverification(
            false, 36u32, 0u32, 0u32
        );
    }
    let Payloadˉoffset: u32 = 40u32 + Segmentˉcount * 12u32;
    if Payloadˉoffset > Recipeˉbytes {
        return Consoleˉapplicationˉrecipeˉheaderˉverification(
            false, 40u32, 0u32, 0u32
        );
    }
    return Consoleˉapplicationˉrecipeˉheaderˉverification(
        true, Recipeˉbytes, Segmentˉcount, Payloadˉoffset
    );
}

fn Consoleˉapplicationˉverificationˉrecipeˉsegments(
    First: bytes,
    Second: bytes,
    Applicationˉbytes: u32,
    Nativeˉimageˉbytes: u32,
    Recipe: bytes,
    Segmentˉcount: u32,
    Initialˉpayloadˉoffset: u32
) -> Consoleˉapplicationˉrecipeˉsegmentˉverification {
    let Recipeˉbytes: u32 = Bytesˉlength(Recipe);
    var Descriptorˉoffset: u32 = 40u32;
    var Payloadˉoffset: u32 = Initialˉpayloadˉoffset;
    var Previousˉend: u32 = 0u32;
    var Nativeˉoffset: u32 = 0u32;
    var Nativeˉsegments: u32 = 0u32;
    var Segmentˉindex: u32 = 0u32;
    while Segmentˉindex < Segmentˉcount {
        let Kind: u32 = Bytesˉreadˉu32ˉlittle(Recipe, Descriptorˉoffset);
        let Offset: u32 = Bytesˉreadˉu32ˉlittle(Recipe, Descriptorˉoffset + 4u32);
        let Length: u32 = Bytesˉreadˉu32ˉlittle(Recipe, Descriptorˉoffset + 8u32);
        if Offset < Previousˉend {
            return Consoleˉapplicationˉrecipeˉsegmentˉverification(
                Consoleˉapplicationˉverificationˉstatus.Invalidˉrecipe,
                Descriptorˉoffset + 4u32, 0u32
            );
        }
        if Offset > Applicationˉbytes {
            return Consoleˉapplicationˉrecipeˉsegmentˉverification(
                Consoleˉapplicationˉverificationˉstatus.Invalidˉrecipe,
                Descriptorˉoffset + 4u32, 0u32
            );
        }
        if Length > Applicationˉbytes - Offset {
            return Consoleˉapplicationˉrecipeˉsegmentˉverification(
                Consoleˉapplicationˉverificationˉstatus.Invalidˉrecipe,
                Descriptorˉoffset + 8u32, 0u32
            );
        }
        let Gapˉmismatch: u32 = Consoleˉapplicationˉverificationˉzeros(
            First, Second, Previousˉend, Offset - Previousˉend, Applicationˉbytes
        );
        if Gapˉmismatch != Applicationˉbytes {
            return Consoleˉapplicationˉrecipeˉsegmentˉverification(
                Consoleˉapplicationˉverificationˉstatus.Invalidˉcontainer,
                Gapˉmismatch, 0u32
            );
        }
        if Kind == 1u32 {
            if Payloadˉoffset > Recipeˉbytes {
                return Consoleˉapplicationˉrecipeˉsegmentˉverification(
                    Consoleˉapplicationˉverificationˉstatus.Invalidˉrecipe,
                    Payloadˉoffset, 0u32
                );
            }
            if Length > Recipeˉbytes - Payloadˉoffset {
                return Consoleˉapplicationˉrecipeˉsegmentˉverification(
                    Consoleˉapplicationˉverificationˉstatus.Invalidˉrecipe,
                    Payloadˉoffset, 0u32
                );
            }
            let Literalˉmismatch: u32 = Consoleˉapplicationˉverificationˉcompare(
                First, Second, Offset, Recipe, Payloadˉoffset, Length, Applicationˉbytes
            );
            if Literalˉmismatch != Applicationˉbytes {
                return Consoleˉapplicationˉrecipeˉsegmentˉverification(
                    Consoleˉapplicationˉverificationˉstatus.Invalidˉcontainer,
                    Literalˉmismatch, 0u32
                );
            }
            Payloadˉoffset = Payloadˉoffset + Length;
        } else {
            if Kind != 2u32 {
                return Consoleˉapplicationˉrecipeˉsegmentˉverification(
                    Consoleˉapplicationˉverificationˉstatus.Invalidˉrecipe,
                    Descriptorˉoffset, 0u32
                );
            }
            if Nativeˉsegments != 0u32 {
                return Consoleˉapplicationˉrecipeˉsegmentˉverification(
                    Consoleˉapplicationˉverificationˉstatus.Invalidˉrecipe,
                    Descriptorˉoffset, 0u32
                );
            }
            if Length != Nativeˉimageˉbytes {
                return Consoleˉapplicationˉrecipeˉsegmentˉverification(
                    Consoleˉapplicationˉverificationˉstatus.Invalidˉrecipe,
                    Descriptorˉoffset + 8u32, 0u32
                );
            }
            Nativeˉsegments = 1u32;
            Nativeˉoffset = Offset;
        }
        Previousˉend = Offset + Length;
        Descriptorˉoffset = Descriptorˉoffset + 12u32;
        Segmentˉindex = Segmentˉindex + 1u32;
    }
    if Nativeˉsegments != 1u32 {
        return Consoleˉapplicationˉrecipeˉsegmentˉverification(
            Consoleˉapplicationˉverificationˉstatus.Invalidˉrecipe,
            36u32, 0u32
        );
    }
    if Payloadˉoffset != Recipeˉbytes {
        return Consoleˉapplicationˉrecipeˉsegmentˉverification(
            Consoleˉapplicationˉverificationˉstatus.Invalidˉrecipe,
            Payloadˉoffset, 0u32
        );
    }
    let Trailingˉmismatch: u32 = Consoleˉapplicationˉverificationˉzeros(
        First,
        Second,
        Previousˉend,
        Applicationˉbytes - Previousˉend,
        Applicationˉbytes
    );
    if Trailingˉmismatch != Applicationˉbytes {
        return Consoleˉapplicationˉrecipeˉsegmentˉverification(
            Consoleˉapplicationˉverificationˉstatus.Invalidˉcontainer,
            Trailingˉmismatch, 0u32
        );
    }
    return Consoleˉapplicationˉrecipeˉsegmentˉverification(
        Consoleˉapplicationˉverificationˉstatus.Valid,
        Applicationˉbytes,
        Nativeˉoffset
    );
}

export fn Consoleˉapplicationˉverificationˉrecipe(
    First: bytes,
    Second: bytes,
    Target: u32,
    Applicationˉbytes: u32,
    Nativeˉimageˉbytes: u32,
    Nativeˉentryˉoffset: u32,
    Recipe: bytes
) -> Consoleˉapplicationˉverificationˉresult {
    let Header: Consoleˉapplicationˉrecipeˉheaderˉverification =
        Consoleˉapplicationˉverificationˉrecipeˉheader(
            Recipe,
            Target,
            Applicationˉbytes,
            Nativeˉimageˉbytes,
            Nativeˉentryˉoffset
        );
    if !Header.Valid {
        return Consoleˉapplicationˉverificationˉfailure(
            First,
            Consoleˉapplicationˉverificationˉstatus.Invalidˉrecipe,
            Header.Failureˉoffset,
            Target,
            Applicationˉbytes
        );
    }

    let Segments: Consoleˉapplicationˉrecipeˉsegmentˉverification =
        Consoleˉapplicationˉverificationˉrecipeˉsegments(
            First,
            Second,
            Applicationˉbytes,
            Nativeˉimageˉbytes,
            Recipe,
            Header.Segmentˉcount,
            Header.Payloadˉoffset
        );
    if Segments.Status != Consoleˉapplicationˉverificationˉstatus.Valid {
        return Consoleˉapplicationˉverificationˉfailure(
            First,
            Segments.Status,
            Segments.Failureˉoffset,
            Target,
            Applicationˉbytes
        );
    }
    let Nativeˉimage: bytes = Consoleˉapplicationˉverificationˉnativeˉimage(
        First, Second, Segments.Nativeˉoffset, Nativeˉimageˉbytes
    );
    let Evidence: bytes = Consoleˉapplicationˉverificationˉevidence(
        First,
        Consoleˉapplicationˉverificationˉstatus.Valid,
        Applicationˉbytes,
        Target,
        Applicationˉbytes,
        Nativeˉimageˉbytes,
        Nativeˉentryˉoffset
    );
    return Consoleˉapplicationˉverificationˉresult(
        Consoleˉapplicationˉverificationˉstatus.Valid,
        Applicationˉbytes,
        Target,
        Applicationˉbytes,
        Nativeˉimage,
        Nativeˉentryˉoffset,
        Evidence
    );
}

fn Consoleˉapplicationˉverificationˉwindowsˉheader(
    First: bytes,
    Second: bytes,
    Applicationˉbytes: u32
) -> Consoleˉapplicationˉheaderˉverification {
    if Consoleˉapplicationˉverificationˉbyte(First, Second, 1u32) != 90u8 {
        return Consoleˉapplicationˉheaderˉverification(
            Consoleˉapplicationˉverificationˉstatus.Invalidˉidentity,
            1u32, 0u32, 0u32, 0u32
        );
    }
    if Applicationˉbytes < 2048u32 {
        return Consoleˉapplicationˉheaderˉverification(
            Consoleˉapplicationˉverificationˉstatus.Invalidˉsize,
            Applicationˉbytes, 1u32, 0u32, 0u32
        );
    }
    if Applicationˉbytes > 4196352u32 {
        return Consoleˉapplicationˉheaderˉverification(
            Consoleˉapplicationˉverificationˉstatus.Invalidˉsize,
            Applicationˉbytes, 1u32, 0u32, 0u32
        );
    }
    let Windowsˉtextˉbytes: u32 = Bytesˉreadˉu32ˉlittle(First, 400u32);
    if Windowsˉtextˉbytes <= 112u32 {
        return Consoleˉapplicationˉheaderˉverification(
            Consoleˉapplicationˉverificationˉstatus.Invalidˉnativeˉimage,
            400u32, 1u32, 0u32, 0u32
        );
    }
    let Nativeˉimageˉbytes: u32 = Windowsˉtextˉbytes - 112u32;
    if Nativeˉimageˉbytes > 4194304u32 {
        return Consoleˉapplicationˉheaderˉverification(
            Consoleˉapplicationˉverificationˉstatus.Invalidˉnativeˉimage,
            400u32, 1u32, 0u32, 0u32
        );
    }
    let Windowsˉcallˉdisplacement: u32 = Bytesˉreadˉu32ˉlittle(First, 566u32);
    if Windowsˉcallˉdisplacement < 54u32 {
        return Consoleˉapplicationˉheaderˉverification(
            Consoleˉapplicationˉverificationˉstatus.Invalidˉentry,
            566u32, 1u32, 0u32, 0u32
        );
    }
    return Consoleˉapplicationˉheaderˉverification(
        Consoleˉapplicationˉverificationˉstatus.Valid,
        Applicationˉbytes,
        1u32,
        Nativeˉimageˉbytes,
        Windowsˉcallˉdisplacement - 54u32
    );
}

fn Consoleˉapplicationˉverificationˉlinuxˉheader(
    First: bytes,
    Second: bytes,
    Applicationˉbytes: u32
) -> Consoleˉapplicationˉheaderˉverification {
    if Consoleˉapplicationˉverificationˉbyte(First, Second, 0u32) != 127u8 {
        return Consoleˉapplicationˉheaderˉverification(
            Consoleˉapplicationˉverificationˉstatus.Invalidˉidentity,
            0u32, 0u32, 0u32, 0u32
        );
    }
    if Consoleˉapplicationˉverificationˉbyte(First, Second, 1u32) != 69u8 {
        return Consoleˉapplicationˉheaderˉverification(
            Consoleˉapplicationˉverificationˉstatus.Invalidˉidentity,
            1u32, 0u32, 0u32, 0u32
        );
    }
    if Consoleˉapplicationˉverificationˉbyte(First, Second, 2u32) != 76u8 {
        return Consoleˉapplicationˉheaderˉverification(
            Consoleˉapplicationˉverificationˉstatus.Invalidˉidentity,
            2u32, 0u32, 0u32, 0u32
        );
    }
    if Consoleˉapplicationˉverificationˉbyte(First, Second, 3u32) != 70u8 {
        return Consoleˉapplicationˉheaderˉverification(
            Consoleˉapplicationˉverificationˉstatus.Invalidˉidentity,
            3u32, 0u32, 0u32, 0u32
        );
    }
    if Applicationˉbytes < 8304u32 {
        return Consoleˉapplicationˉheaderˉverification(
            Consoleˉapplicationˉverificationˉstatus.Invalidˉsize,
            Applicationˉbytes, 2u32, 0u32, 0u32
        );
    }
    if Applicationˉbytes > 4202608u32 {
        return Consoleˉapplicationˉheaderˉverification(
            Consoleˉapplicationˉverificationˉstatus.Invalidˉsize,
            Applicationˉbytes, 2u32, 0u32, 0u32
        );
    }
    let Linuxˉtextˉbytes: u32 = Bytesˉreadˉu32ˉlittle(First, 152u32);
    if Linuxˉtextˉbytes <= 160u32 {
        return Consoleˉapplicationˉheaderˉverification(
            Consoleˉapplicationˉverificationˉstatus.Invalidˉnativeˉimage,
            152u32, 2u32, 0u32, 0u32
        );
    }
    let Nativeˉimageˉbytes: u32 = Linuxˉtextˉbytes - 160u32;
    if Nativeˉimageˉbytes > 4194304u32 {
        return Consoleˉapplicationˉheaderˉverification(
            Consoleˉapplicationˉverificationˉstatus.Invalidˉnativeˉimage,
            152u32, 2u32, 0u32, 0u32
        );
    }
    let Linuxˉcallˉdisplacement: u32 = Bytesˉreadˉu32ˉlittle(First, 4208u32);
    if Linuxˉcallˉdisplacement < 44u32 {
        return Consoleˉapplicationˉheaderˉverification(
            Consoleˉapplicationˉverificationˉstatus.Invalidˉentry,
            4208u32, 2u32, 0u32, 0u32
        );
    }
    return Consoleˉapplicationˉheaderˉverification(
        Consoleˉapplicationˉverificationˉstatus.Valid,
        Applicationˉbytes,
        2u32,
        Nativeˉimageˉbytes,
        Linuxˉcallˉdisplacement - 44u32
    );
}

fn Consoleˉapplicationˉverificationˉheader(
    First: bytes,
    Second: bytes,
    Applicationˉbytes: u32
) -> Consoleˉapplicationˉheaderˉverification {
    if Consoleˉapplicationˉverificationˉbyte(First, Second, 0u32) == 77u8 {
        return Consoleˉapplicationˉverificationˉwindowsˉheader(
            First, Second, Applicationˉbytes
        );
    }
    return Consoleˉapplicationˉverificationˉlinuxˉheader(
        First, Second, Applicationˉbytes
    );
}

export fn Consoleˉapplicationˉverification(
    First: bytes,
    Second: bytes
) -> Consoleˉapplicationˉverificationˉresult {
    let Firstˉbytes: u32 = Bytesˉlength(First);
    let Secondˉbytes: u32 = Bytesˉlength(Second);
    let Applicationˉbytes: u32 = Firstˉbytes + Secondˉbytes;
    if Secondˉbytes > 8304u32 {
        return Consoleˉapplicationˉverificationˉfailure(
            First, Consoleˉapplicationˉverificationˉstatus.Invalidˉchunk,
            Firstˉbytes, 0u32, Applicationˉbytes
        );
    }
    if Secondˉbytes > 0u32 {
        if Firstˉbytes != 4194304u32 {
            return Consoleˉapplicationˉverificationˉfailure(
                First, Consoleˉapplicationˉverificationˉstatus.Invalidˉchunk,
                Firstˉbytes, 0u32, Applicationˉbytes
            );
        }
    }
    if Applicationˉbytes < 4u32 {
        return Consoleˉapplicationˉverificationˉfailure(
            First, Consoleˉapplicationˉverificationˉstatus.Invalidˉsize,
            Applicationˉbytes, 0u32, Applicationˉbytes
        );
    }
    let Header: Consoleˉapplicationˉheaderˉverification =
        Consoleˉapplicationˉverificationˉheader(
            First, Second, Applicationˉbytes
        );
    if Header.Status != Consoleˉapplicationˉverificationˉstatus.Valid {
        return Consoleˉapplicationˉverificationˉfailure(
            First,
            Header.Status,
            Header.Failureˉoffset,
            Header.Target,
            Applicationˉbytes
        );
    }
    if Header.Nativeˉentryˉoffset >= Header.Nativeˉimageˉbytes {
        var Entryˉoffset: u32 = 566u32;
        if Header.Target == 2u32 { Entryˉoffset = 4208u32; }
        return Consoleˉapplicationˉverificationˉfailure(
            First, Consoleˉapplicationˉverificationˉstatus.Invalidˉentry,
            Entryˉoffset, Header.Target, Applicationˉbytes
        );
    }
    let Request: bytes = Consoleˉapplicationˉverificationˉrequest(
        First,
        Header.Target,
        Header.Nativeˉimageˉbytes,
        Header.Nativeˉentryˉoffset
    );
    let Recipe: bytes = Applicationˉconstruction.Consoleˉapplicationˉconstruction(Request);
    return Consoleˉapplicationˉverificationˉrecipe(
        First,
        Second,
        Header.Target,
        Applicationˉbytes,
        Header.Nativeˉimageˉbytes,
        Header.Nativeˉentryˉoffset,
        Recipe
    );
}
