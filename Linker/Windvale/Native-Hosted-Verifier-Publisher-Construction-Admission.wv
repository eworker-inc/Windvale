module Linkerˉnativeˉhostedˉverifierˉpublisherˉconstructionˉadmission profile portable;

fn Bytesˉareˉequal(Left: bytes, Right: bytes) -> bool {
    let Length: u32 = Bytesˉlength(Left);
    if Length != Bytesˉlength(Right) { return false; }
    var Index: u32 = 0u32;
    while Index < Length {
        if Bytesˉreadˉu8(Left, Index) != Bytesˉreadˉu8(Right, Index) {
            return false;
        }
        Index = Index + 1u32;
    }
    return true;
}

fn Nameˉmatches(
    Input: bytes,
    Offset: u32,
    Length: u32,
    Expected: text
) -> bool {
    if Offset > Bytesˉlength(Input) ||
        Length > Bytesˉlength(Input) - Offset {
        return false;
    }
    return Bytesˉareˉequal(
        Bytesˉslice(Input, Offset, Length),
        Textˉtoˉutf8(Expected)
    );
}

fn Sectionˉrecordsˉend(Input: bytes, Sectionˉcount: u32) -> u32 {
    var Cursor: u32 = 24u32;
    var Index: u32 = 0u32;
    while Index < Sectionˉcount {
        if Cursor > Bytesˉlength(Input) ||
            20u32 > Bytesˉlength(Input) - Cursor {
            return Bytesˉlength(Input);
        }
        let Dataˉlength: u32 = Bytesˉreadˉu32ˉlittle(Input, Cursor + 12u32);
        let Nameˉlength: u32 = Bytesˉreadˉu32ˉlittle(Input, Cursor + 16u32);
        if Nameˉlength > Bytesˉlength(Input) - Cursor - 20u32 ||
            Dataˉlength > Bytesˉlength(Input) - Cursor - 20u32 - Nameˉlength {
            return Bytesˉlength(Input);
        }
        Cursor = Cursor + 20u32 + Nameˉlength + Dataˉlength;
        Index = Index + 1u32;
    }
    return Cursor;
}

fn Sectionˉmatches(
    Input: bytes,
    Sectionˉcount: u32,
    Wanted: u32,
    Kind: u32,
    Alignment: u32,
    Dataˉlength: u32,
    Name: text
) -> bool {
    if Wanted >= Sectionˉcount { return false; }
    var Cursor: u32 = 24u32;
    var Index: u32 = 0u32;
    while Index < Sectionˉcount {
        if Cursor > Bytesˉlength(Input) ||
            20u32 > Bytesˉlength(Input) - Cursor {
            return false;
        }
        let Currentˉdata: u32 =
            Bytesˉreadˉu32ˉlittle(Input, Cursor + 12u32);
        let Nameˉlength: u32 =
            Bytesˉreadˉu32ˉlittle(Input, Cursor + 16u32);
        if Nameˉlength > Bytesˉlength(Input) - Cursor - 20u32 ||
            Currentˉdata >
                Bytesˉlength(Input) - Cursor - 20u32 - Nameˉlength {
            return false;
        }
        if Index == Wanted {
            return U32ˉfromˉu8(Bytesˉreadˉu8(Input, Cursor)) == Kind &&
                Bytesˉreadˉu8(Input, Cursor + 1u32) == 0u8 &&
                Bytesˉreadˉu16ˉlittle(Input, Cursor + 2u32) == 0u32 &&
                Bytesˉreadˉu32ˉlittle(Input, Cursor + 4u32) == Alignment &&
                Bytesˉreadˉu32ˉlittle(Input, Cursor + 8u32) == Dataˉlength &&
                Currentˉdata == Dataˉlength &&
                Nameˉmatches(
                    Input, Cursor + 20u32, Nameˉlength, Name
                );
        }
        Cursor = Cursor + 20u32 + Nameˉlength + Currentˉdata;
        Index = Index + 1u32;
    }
    return false;
}

fn Symbolˉmatches(
    Input: bytes,
    Symbolˉstart: u32,
    Symbolˉcount: u32,
    Index: u32,
    Binding: u32,
    Kind: u32,
    Section: u32,
    Offset: u32,
    Size: u32,
    Name: text
) -> bool {
    if Index >= Symbolˉcount { return false; }
    var Cursor: u32 = Symbolˉstart;
    var Current: u32 = 0u32;
    while Current < Symbolˉcount {
        if Cursor > Bytesˉlength(Input) ||
            20u32 > Bytesˉlength(Input) - Cursor {
            return false;
        }
        let Nameˉlength: u32 = Bytesˉreadˉu32ˉlittle(Input, Cursor + 16u32);
        if Nameˉlength > Bytesˉlength(Input) - Cursor - 20u32 {
            return false;
        }
        if Current == Index {
            return U32ˉfromˉu8(Bytesˉreadˉu8(Input, Cursor)) == Binding &&
                U32ˉfromˉu8(Bytesˉreadˉu8(Input, Cursor + 1u32)) == Kind &&
                Bytesˉreadˉu32ˉlittle(Input, Cursor + 4u32) == Section &&
                Bytesˉreadˉu32ˉlittle(Input, Cursor + 8u32) == Offset &&
                Bytesˉreadˉu32ˉlittle(Input, Cursor + 12u32) == Size &&
                Nameˉmatches(Input, Cursor + 20u32, Nameˉlength, Name);
        }
        Cursor = Cursor + 20u32 + Nameˉlength;
        Current = Current + 1u32;
    }
    return false;
}

fn Structureˉmatches(
    Input: bytes,
    Sections: u32,
    Symbols: u32,
    Relocations: u32
) -> bool {
    if Bytesˉlength(Input) < 24u32 ||
        Bytesˉreadˉu8(Input, 0u32) != 87u8 ||
        Bytesˉreadˉu8(Input, 1u32) != 86u8 ||
        Bytesˉreadˉu8(Input, 2u32) != 79u8 ||
        Bytesˉreadˉu8(Input, 3u32) != 49u8 ||
        Bytesˉreadˉu16ˉlittle(Input, 4u32) != 1u32 ||
        Bytesˉreadˉu16ˉlittle(Input, 6u32) != 0u32 ||
        Bytesˉreadˉu8(Input, 8u32) != 1u8 ||
        Bytesˉreadˉu8(Input, 9u32) != 0u8 ||
        Bytesˉreadˉu16ˉlittle(Input, 10u32) != 0u32 ||
        Bytesˉreadˉu32ˉlittle(Input, 12u32) != Sections ||
        Bytesˉreadˉu32ˉlittle(Input, 16u32) != Symbols ||
        Bytesˉreadˉu32ˉlittle(Input, 20u32) != Relocations {
        return false;
    }
    var Cursor: u32 = Sectionˉrecordsˉend(Input, Sections);
    var Index: u32 = 0u32;
    while Index < Symbols {
        if Cursor > Bytesˉlength(Input) ||
            20u32 > Bytesˉlength(Input) - Cursor {
            return false;
        }
        let Nameˉlength: u32 = Bytesˉreadˉu32ˉlittle(Input, Cursor + 16u32);
        if Nameˉlength > Bytesˉlength(Input) - Cursor - 20u32 {
            return false;
        }
        Cursor = Cursor + 20u32 + Nameˉlength;
        Index = Index + 1u32;
    }
    return Relocations <= (Bytesˉlength(Input) - Cursor) / 20u32 &&
        Cursor + Relocations * 20u32 == Bytesˉlength(Input);
}

export fn Publisherˉmoduleˉvariant(Input: bytes) -> u32 {
    if Bytesˉlength(Input) == 29170u32 { return 0u32; }
    if Bytesˉlength(Input) == 41268u32 { return 1u32; }
    if Bytesˉlength(Input) == 181772u32 { return 2u32; }
    if Bytesˉlength(Input) == 41365u32 { return 3u32; }
    if Bytesˉlength(Input) == 115107u32 { return 4u32; }
    return 5u32;
}

export fn Publisherˉmoduleˉisˉvalidˉfor(
    Input: bytes,
    Variant: u32
) -> bool {
    return Variant <= 4u32 && Publisherˉmoduleˉvariant(Input) == Variant;
}

export fn Publisherˉmoduleˉisˉvalid(Input: bytes) -> bool {
    return Publisherˉmoduleˉisˉvalidˉfor(Input, 0u32);
}

export fn Publisherˉobjectˉvariant(Input: bytes) -> u32 {
    var Variant: u32 = 0u32;
    var Length: u32 = 233804u32;
    var Symbols: u32 = 27u32;
    var Relocations: u32 = 5u32;
    var Textˉbytes: u32 = 232448u32;
    var Rodataˉbytes: u32 = 288u32;
    var Mainˉindex: u32 = 26u32;
    var Mainˉoffset: u32 = 3001u32;
    var Mainˉbytes: u32 = 5280u32;
    var Beginˉindex: u32 = 5u32;
    var Beginˉoffset: u32 = 789u32;
    var Beginˉbytes: u32 = 389u32;
    var Beginˉname: text = "$function_0001";
    var Applyˉindex: u32 = 4u32;
    var Applyˉoffset: u32 = 0u32;
    var Applyˉbytes: u32 = 789u32;
    var Applyˉname: text = "$function_0000";
    if Bytesˉlength(Input) == 660123u32 {
        Variant = 1u32;
        Length = 660123u32;
        Symbols = 49u32;
        Relocations = 3u32;
        Textˉbytes = 658160u32;
        Rodataˉbytes = 179u32;
        Mainˉindex = 48u32;
        Mainˉoffset = 1178u32;
        Beginˉindex = 3u32;
        Applyˉindex = 2u32;
    } else if Bytesˉlength(Input) == 1523708u32 {
        Variant = 2u32;
        Length = 1523708u32;
        Symbols = 78u32;
        Relocations = 15u32;
        Textˉbytes = 1520336u32;
        Rodataˉbytes = 410u32;
        Mainˉindex = 77u32;
        Mainˉoffset = 0u32;
        Mainˉbytes = 4686u32;
        Beginˉindex = 15u32;
        Beginˉoffset = 5475u32;
        Beginˉname = "$function_0002";
        Applyˉindex = 14u32;
        Applyˉoffset = 4686u32;
        Applyˉname = "$function_0001";
    } else if Bytesˉlength(Input) == 408284u32 {
        Variant = 3u32;
        Length = 408284u32;
        Symbols = 39u32;
        Relocations = 3u32;
        Textˉbytes = 406752u32;
        Rodataˉbytes = 88u32;
        Mainˉindex = 38u32;
        Mainˉoffset = 0u32;
        Mainˉbytes = 4686u32;
        Beginˉindex = 3u32;
        Beginˉoffset = 5475u32;
        Beginˉname = "$function_0002";
        Applyˉindex = 2u32;
        Applyˉoffset = 4686u32;
        Applyˉname = "$function_0001";
    } else if Bytesˉlength(Input) == 1139440u32 {
        Variant = 4u32;
        Length = 1139440u32;
        Symbols = 109u32;
        Relocations = 15u32;
        Textˉbytes = 1134976u32;
        Rodataˉbytes = 448u32;
        Mainˉindex = 108u32;
        Mainˉoffset = 18902u32;
        Mainˉbytes = 5436u32;
        Beginˉindex = 15u32;
        Beginˉoffset = 789u32;
        Beginˉbytes = 389u32;
        Applyˉindex = 14u32;
        Applyˉoffset = 0u32;
        Applyˉbytes = 789u32;
    } else if Bytesˉlength(Input) != Length {
        return 5u32;
    }
    if !Structureˉmatches(Input, 2u32, Symbols, Relocations) ||
        !Sectionˉmatches(
            Input, 2u32, 0u32, 1u32, 16u32, Textˉbytes, ".text"
        ) ||
        !Sectionˉmatches(
            Input, 2u32, 1u32, 2u32, 16u32, Rodataˉbytes, ".rodata"
        ) {
        return 5u32;
    }
    let Symbolˉstart: u32 = Sectionˉrecordsˉend(Input, 2u32);
    if !Symbolˉmatches(
            Input, Symbolˉstart, Symbols, Mainˉindex,
            2u32, 1u32, 0u32, Mainˉoffset,
            Mainˉbytes, "Main"
        ) ||
        !Symbolˉmatches(
            Input, Symbolˉstart, Symbols, Beginˉindex,
            1u32, 1u32, 0u32, Beginˉoffset, Beginˉbytes, Beginˉname
        ) ||
        !Symbolˉmatches(
            Input, Symbolˉstart, Symbols, Applyˉindex,
            1u32, 1u32, 0u32, Applyˉoffset, Applyˉbytes, Applyˉname
        ) {
        return 5u32;
    }
    return Variant;
}

export fn Publisherˉobjectˉisˉvalidˉfor(
    Input: bytes,
    Variant: u32
) -> bool {
    if Variant > 4u32 {
        return false;
    }
    return Publisherˉobjectˉvariant(Input) == Variant;
}

export fn Publisherˉobjectˉisˉvalid(Input: bytes) -> bool {
    return Publisherˉobjectˉisˉvalidˉfor(Input, 0u32);
}

export fn Publisherˉstartupˉisˉvalid(Input: bytes, Target: u32) -> bool {
    var Length: u32 = 168u32;
    var Exportˉname: text = "Windows_wvb_publisher_startup";
    var Importˉname: text = "Windows_wvb_publisher_run";
    if Target == 2u32 {
        Length = 164u32;
        Exportˉname = "Linux_wvb_publisher_startup";
        Importˉname = "Linux_wvb_publisher_run";
    }
    if (Target != 1u32 && Target != 2u32) ||
        Bytesˉlength(Input) != Length ||
        !Structureˉmatches(Input, 1u32, 2u32, 1u32) {
        return false;
    }
    let Symbolˉstart: u32 = Sectionˉrecordsˉend(Input, 1u32);
    return Symbolˉmatches(
            Input, Symbolˉstart, 2u32, 0u32,
            2u32, 1u32, 0u32, 0u32, 5u32, Exportˉname
        ) &&
        Symbolˉmatches(
            Input, Symbolˉstart, 2u32, 1u32,
            3u32, 1u32, 4294967295u32, 0u32, 0u32, Importˉname
        );
}

export fn Publisherˉadapterˉisˉvalid(Input: bytes, Target: u32) -> bool {
    var Length: u32 = 9544u32;
    var Symbols: u32 = 46u32;
    var Relocations: u32 = 111u32;
    var Exportˉindex: u32 = 2u32;
    var Exportˉoffset: u32 = 251u32;
    var Exportˉsize: u32 = 5035u32;
    var Exportˉname: text = "Windows_wvb_publisher_run";
    var Mainˉindex: u32 = 10u32;
    var Beginˉindex: u32 = 12u32;
    var Applyˉindex: u32 = 11u32;
    if Target == 2u32 {
        Length = 5559u32;
        Symbols = 28u32;
        Relocations = 49u32;
        Exportˉindex = 1u32;
        Exportˉoffset = 60u32;
        Exportˉsize = 3355u32;
        Exportˉname = "Linux_wvb_publisher_run";
        Mainˉindex = 9u32;
        Beginˉindex = 11u32;
        Applyˉindex = 10u32;
    }
    if (Target != 1u32 && Target != 2u32) ||
        Bytesˉlength(Input) != Length ||
        !Structureˉmatches(Input, 1u32, Symbols, Relocations) {
        return false;
    }
    let Symbolˉstart: u32 = Sectionˉrecordsˉend(Input, 1u32);
    return Symbolˉmatches(
            Input, Symbolˉstart, Symbols, Exportˉindex,
            2u32, 1u32, 0u32, Exportˉoffset, Exportˉsize, Exportˉname
        ) &&
        Symbolˉmatches(
            Input, Symbolˉstart, Symbols, Mainˉindex,
            3u32, 1u32, 4294967295u32, 0u32, 0u32, "Native_main"
        ) &&
        Symbolˉmatches(
            Input, Symbolˉstart, Symbols, Beginˉindex,
            3u32, 1u32, 4294967295u32, 0u32, 0u32,
            "Native_publication_begin"
        ) &&
        Symbolˉmatches(
            Input, Symbolˉstart, Symbols, Applyˉindex,
            3u32, 1u32, 4294967295u32, 0u32, 0u32,
            "Native_publication_apply"
        );
}

export fn Publisherˉsha256ˉobjectˉisˉvalid(Input: bytes) -> bool {
    if Bytesˉlength(Input) != 2176u32 ||
        !Structureˉmatches(Input, 2u32, 7u32, 2u32) {
        return false;
    }
    let Symbolˉstart: u32 = Sectionˉrecordsˉend(Input, 2u32);
    return Symbolˉmatches(
            Input, Symbolˉstart, 7u32, 5u32,
            2u32, 1u32, 0u32, 0u32, 1290u32,
            "X64_wvb_publication_sha256_hex"
        ) &&
        Symbolˉmatches(
            Input, Symbolˉstart, 7u32, 6u32,
            2u32, 1u32, 0u32, 1290u32, 60u32,
            "X64_wvb_publication_u32_hex8"
        );
}

export fn Publisherˉmetadataˉisˉvalid(Input: bytes, Target: u32) -> bool {
    return (Target == 1u32 || Target == 2u32) &&
        Bytesˉlength(Input) == 128u32;
}
