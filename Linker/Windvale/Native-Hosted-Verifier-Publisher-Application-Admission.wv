module Linkerˉnativeˉhostedˉverifierˉpublisherˉapplicationˉadmission profile portable;

import Foundationˉsha256ˉstreaming as Sha256;

fn Digest(Input: bytes) -> bytes {
    var State: Sha256.Foundationˉsha256ˉstream =
        Sha256.Foundationˉsha256ˉbegin(Input);
    State = Sha256.Foundationˉsha256ˉupdate(State, Input);
    return Sha256.Foundationˉsha256ˉfinishˉraw(State);
}

fn Expectedˉword(Target: u32, Index: u32) -> u32 {
    if Target == 1u32 {
        if Index == 0u32 { return 1113377559u32; }
        if Index == 1u32 { return 2252662824u32; }
        if Index == 2u32 { return 461353363u32; }
        if Index == 3u32 { return 3495913843u32; }
        if Index == 4u32 { return 3607363052u32; }
        if Index == 5u32 { return 2032314797u32; }
        if Index == 6u32 { return 3186842442u32; }
        return 2533135477u32;
    }
    if Index == 0u32 { return 3848015697u32; }
    if Index == 1u32 { return 3935610066u32; }
    if Index == 2u32 { return 2061241039u32; }
    if Index == 3u32 { return 3162584417u32; }
    if Index == 4u32 { return 2915332387u32; }
    if Index == 5u32 { return 1603821327u32; }
    if Index == 6u32 { return 3984659280u32; }
    return 2888786881u32;
}

fn Digestˉmatches(Input: bytes, Target: u32) -> bool {
    let Actual: bytes = Digest(Input);
    if Bytesˉlength(Actual) != 32u32 { return false; }
    var Index: u32 = 0u32;
    while Index < 8u32 {
        if Bytesˉreadˉu32ˉlittle(Actual, Index * 4u32) !=
            Expectedˉword(Target, Index) {
            return false;
        }
        Index = Index + 1u32;
    }
    return true;
}

export fn Nativeˉhostedˉverifierˉpublisherˉapplicationˉverification(
    Input: bytes,
    Target: u32
) -> bool {
    var Expectedˉbytes: u32 = 256000u32;
    if Target == 2u32 {
        Expectedˉbytes = 254965u32;
    }
    if Target < 1u32 || Target > 2u32 ||
        Bytesˉlength(Input) != Expectedˉbytes {
        return false;
    }
    return Digestˉmatches(Input, Target);
}
