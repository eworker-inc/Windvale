module Linkerˉnativeˉhostedˉverifierˉpublisherˉlinuxˉmaterialization profile portable;

import Linkerˉnativeˉhostedˉcontainerˉbyteˉconstruction as Build;

fn Response(Input: bytes, Status: u32) -> bytes {
    var Result: bytes = Build.Empty(Input);
    Result = Build.Appendˉu32(Result, 1330402903u32);
    Result = Build.Appendˉu32(Result, 1u32);
    var Total: u32 = 32u32;
    var Offset: u32 = 0u32;
    var Applicationˉbytes: u32 = 0u32;
    var Target: u32 = 0u32;
    if Status == 0u32 {
        Total = 254949u32;
        Offset = 32u32;
        Applicationˉbytes = 254917u32;
        Target = 2u32;
    }
    Result = Build.Appendˉu32(Result, Total);
    Result = Build.Appendˉu32(Result, Status);
    Result = Build.Appendˉu32(Result, Bytesˉlength(Input));
    Result = Build.Appendˉu32(Result, Offset);
    Result = Build.Appendˉu32(Result, Applicationˉbytes);
    return Build.Appendˉu32(Result, Target);
}

fn Envelopeˉvalid(Input: bytes) -> bool {
    return Bytesˉlength(Input) == 255581u32 &&
        Bytesˉreadˉu32ˉlittle(Input, 0u32) == 1296848471u32 &&
        Bytesˉreadˉu32ˉlittle(Input, 4u32) == 1u32 &&
        Bytesˉreadˉu32ˉlittle(Input, 8u32) == 255581u32 &&
        Bytesˉreadˉu32ˉlittle(Input, 12u32) == 2u32 &&
        Bytesˉreadˉu32ˉlittle(Input, 16u32) == 64u32 &&
        Bytesˉreadˉu32ˉlittle(Input, 20u32) == 249856u32 &&
        Bytesˉreadˉu32ˉlittle(Input, 24u32) == 249920u32 &&
        Bytesˉreadˉu32ˉlittle(Input, 28u32) == 416u32 &&
        Bytesˉreadˉu32ˉlittle(Input, 32u32) == 250336u32 &&
        Bytesˉreadˉu32ˉlittle(Input, 36u32) == 5117u32 &&
        Bytesˉreadˉu32ˉlittle(Input, 40u32) == 255453u32 &&
        Bytesˉreadˉu32ˉlittle(Input, 44u32) == 128u32 &&
        Bytesˉreadˉu32ˉlittle(Input, 48u32) == 0u32 &&
        Bytesˉreadˉu32ˉlittle(Input, 52u32) == 0u32 &&
        Bytesˉreadˉu32ˉlittle(Input, 56u32) == 0u32 &&
        Bytesˉreadˉu32ˉlittle(Input, 60u32) == 0u32;
}

fn Inputsˉvalid(Base: bytes, Construction: bytes, Objects: bytes, Metadata: bytes) -> bool {
    return Bytesˉlength(Base) == 249856u32 &&
        Bytesˉreadˉu32ˉlittle(Base, 0u32) == 1179403647u32 &&
        Bytesˉreadˉu8(Base, 4u32) == 2u8 &&
        Bytesˉreadˉu8(Base, 5u32) == 1u8 &&
        Bytesˉreadˉu32ˉlittle(Base, 24u32) == 4096u32 &&
        Bytesˉreadˉu32ˉlittle(Base, 28u32) == 0u32 &&
        Bytesˉreadˉu32ˉlittle(Base, 32u32) == 64u32 &&
        Bytesˉreadˉu32ˉlittle(Base, 36u32) == 0u32 &&
        Bytesˉreadˉu16ˉlittle(Base, 54u32) == 56u32 &&
        Bytesˉreadˉu16ˉlittle(Base, 56u32) == 5u32 &&
        Bytesˉreadˉu32ˉlittle(Base, 240u32) == 384u32 &&
        Bytesˉreadˉu32ˉlittle(Base, 244u32) == 0u32 &&
        Bytesˉreadˉu32ˉlittle(Base, 248u32) == 384u32 &&
        Bytesˉreadˉu32ˉlittle(Base, 252u32) == 0u32 &&
        Bytesˉlength(Construction) == 416u32 &&
        Bytesˉreadˉu32ˉlittle(Construction, 0u32) == 1380144727u32 &&
        Bytesˉreadˉu32ˉlittle(Construction, 4u32) == 1u32 &&
        Bytesˉreadˉu32ˉlittle(Construction, 12u32) == 2u32 &&
        Bytesˉreadˉu32ˉlittle(Construction, 72u32) == 235077u32 &&
        Bytesˉreadˉu32ˉlittle(Construction, 132u32) == 249856u32 &&
        Bytesˉreadˉu32ˉlittle(Construction, 136u32) == 142929920u32 &&
        Bytesˉreadˉu32ˉlittle(Construction, 156u32) == 254917u32 &&
        Bytesˉlength(Objects) == 5117u32 &&
        Bytesˉreadˉu32ˉlittle(Objects, 0u32) == 1330206295u32 &&
        Bytesˉreadˉu32ˉlittle(Objects, 4u32) == 1u32 &&
        Bytesˉreadˉu32ˉlittle(Objects, 8u32) == 5117u32 &&
        Bytesˉreadˉu32ˉlittle(Objects, 12u32) == 0u32 &&
        Bytesˉreadˉu32ˉlittle(Objects, 20u32) == 2u32 &&
        Bytesˉreadˉu32ˉlittle(Objects, 24u32) == 64u32 &&
        Bytesˉreadˉu32ˉlittle(Objects, 28u32) == 5u32 &&
        Bytesˉreadˉu32ˉlittle(Objects, 32u32) == 69u32 &&
        Bytesˉreadˉu32ˉlittle(Objects, 36u32) == 3363u32 &&
        Bytesˉreadˉu32ˉlittle(Objects, 40u32) == 3432u32 &&
        Bytesˉreadˉu32ˉlittle(Objects, 44u32) == 1685u32 &&
        Bytesˉlength(Metadata) == 128u32 &&
        Bytesˉreadˉu32ˉlittle(Metadata, 0u32) == 1347835479u32 &&
        Bytesˉreadˉu32ˉlittle(Metadata, 4u32) == 1u32 &&
        Bytesˉreadˉu32ˉlittle(Metadata, 8u32) == 128u32 &&
        Bytesˉreadˉu32ˉlittle(Metadata, 12u32) == 2u32;
}

fn Header(Base: bytes) -> bytes {
    let Note: bytes = Bytesˉslice(Base, 384u32, 28u32);
    var Result: bytes = Bytesˉslice(Base, 0u32, 4096u32);
    Result = Build.Replace(Result, 384u32, 28u32, Build.Zeros(28u32));
    Result = Build.Patchˉu64(Result, 24u32, 4096u32, 0u32);
    Result = Build.Patchˉu16(Result, 56u32, 6u32);
    Result = Build.Patchˉu64(Result, 240u32, 512u32, 0u32);
    Result = Build.Patchˉu64(Result, 248u32, 512u32, 0u32);
    Result = Build.Replace(Result, 344u32, 56u32, Build.Zeros(56u32));
    Result = Build.Patchˉu32(Result, 344u32, 1u32);
    Result = Build.Patchˉu32(Result, 348u32, 5u32);
    Result = Build.Patchˉu64(Result, 352u32, 249856u32, 0u32);
    Result = Build.Patchˉu64(Result, 360u32, 142929920u32, 0u32);
    Result = Build.Patchˉu64(Result, 376u32, 5061u32, 0u32);
    Result = Build.Patchˉu64(Result, 384u32, 5061u32, 0u32);
    Result = Build.Patchˉu64(Result, 392u32, 4096u32, 0u32);
    Result = Build.Replace(Result, 512u32, 28u32, Note);
    return Build.Patchˉu32(Result, 536u32, 5u32);
}

export fn Publisherˉlinuxˉmaterialize(Input: bytes) -> bytes {
    if !Envelopeˉvalid(Input) { return Response(Input, 1u32); }
    let Base: bytes = Bytesˉslice(Input, 64u32, 249856u32);
    let Construction: bytes = Bytesˉslice(Input, 249920u32, 416u32);
    let Objects: bytes = Bytesˉslice(Input, 250336u32, 5117u32);
    let Metadata: bytes = Bytesˉslice(Input, 255453u32, 128u32);
    if !Inputsˉvalid(Base, Construction, Objects, Metadata) {
        return Response(Input, 2u32);
    }
    var Application: bytes = Header(Base);
    Application = Bytesˉconcat(Application, Bytesˉslice(Objects, 64u32, 5u32));
    Application = Bytesˉconcat(Application, Build.Zeros(4091u32));
    Application = Bytesˉconcat(Application, Bytesˉslice(Base, 8192u32, 239072u32));
    Application = Bytesˉconcat(Application, Metadata);
    Application = Bytesˉconcat(Application, Bytesˉslice(Base, 247392u32, 2464u32));
    Application = Bytesˉconcat(Application, Bytesˉslice(Objects, 69u32, 3363u32));
    Application = Bytesˉconcat(Application, Build.Zeros(13u32));
    Application = Bytesˉconcat(Application, Bytesˉslice(Objects, 3432u32, 1685u32));
    if Bytesˉlength(Application) != 254917u32 { return Response(Input, 3u32); }
    return Bytesˉconcat(Response(Input, 0u32), Application);
}
