module Linkerˉnativeˉhostedˉverifierˉapplicationˉadmission profile portable;

import Foundationˉsha256 as Sha256;

fn Bytesˉequal(Left: bytes, Right: bytes) -> bool {
    let Length: u32 = Bytesˉlength(Left);
    if Length != Bytesˉlength(Right) { return false; }
    var Index: u32 = 0u32;
    while Index < Length {
        if Bytesˉreadˉu8(Left, Index) != Bytesˉreadˉu8(Right, Index) {
            return false;
        }
        Index = Index + 1u32;
    }
    return true;
}

export fn Nativeˉhostedˉverifierˉapplicationˉverification(
    Input: bytes,
    Target: u32
) -> bool {
    var Expectedˉbytes: u32 = 1004032u32;
    var Expectedˉsha256: text =
        "5f0a83681f54c7e047d6b68c86f71767d6c3584330bef1e68108f9b3465167a7";
    if Target == 2u32 {
        Expectedˉbytes = 1003520u32;
        Expectedˉsha256 =
            "824e90ae07e82af3d6d0b4cf23bc4d3327fc3367684215171247fa71ab274982";
    }
    if Target < 1u32 || Target > 2u32 ||
        Bytesˉlength(Input) != Expectedˉbytes {
        return false;
    }
    return Bytesˉequal(
        Sha256.Foundationˉsha256ˉhex(Input),
        Textˉtoˉutf8(Expectedˉsha256)
    );
}
