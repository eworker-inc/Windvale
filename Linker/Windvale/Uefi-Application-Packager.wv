module Uefiˉapplicationˉpackager profile hosted;

import Foundationˉdecimalˉparsing as Decimalˉparsing;
import Linkerˉuefiˉapplicationˉconstruction as Construction;

capability console.write_line;
capability diagnostic.write_line;
capability file.read_bytes;
capability file.write_bytes;
capability process.argument;
capability process.argument_count;

fn Empty(Input: bytes) -> bytes {
    return Bytesˉslice(Input, 0u32, 0u32);
}

fn Description(
    Result: Construction.Uefiˉapplicationˉconstructionˉresult,
    Nativeˉimageˉbytes: u32
) -> text {
    var Value: text = Textˉconcat(
        "uefi-package status=",
        Enumˉname(Result.Status)
    );
    Value = Textˉconcat(
        Value,
        Textˉconcat(" native-image-bytes=", U32ˉformat(Nativeˉimageˉbytes))
    );
    Value = Textˉconcat(
        Value,
        Textˉconcat(" entry-offset=", U32ˉformat(Result.Entryˉoffset))
    );
    return Textˉconcat(
        Value,
        Textˉconcat(" application-bytes=", U32ˉformat(Bytesˉlength(Result.Image)))
    );
}

fn Invalidˉentry(Input: bytes) -> Construction.Uefiˉapplicationˉconstructionˉresult {
    return Construction.Uefiˉapplicationˉconstructionˉresult(
        Construction.Uefiˉapplicationˉconstructionˉstatus.Invalidˉentry,
        0u32,
        0u32,
        Empty(Input)
    );
}

fn Runˉselfˉtests() -> i32 {
    let Code: bytes = Bytesˉconcat(
        Bytesˉfromˉu16ˉlittle(49201u32),
        Bytesˉfromˉu8(195u8)
    );
    let Valid: Construction.Uefiˉapplicationˉconstructionˉresult =
        Construction.Uefiˉapplicationˉconstruct(Code, 0u32);
    if Valid.Status != Construction.Uefiˉapplicationˉconstructionˉstatus.Valid {
        return 11;
    }
    if Bytesˉlength(Valid.Image) != 1536u32 { return 12; }
    if Bytesˉreadˉu16ˉlittle(Valid.Image, 0u32) != 23117u32 { return 13; }
    let Invalid: Construction.Uefiˉapplicationˉconstructionˉresult =
        Construction.Uefiˉapplicationˉconstruct(Code, Bytesˉlength(Code));
    if Invalid.Status !=
        Construction.Uefiˉapplicationˉconstructionˉstatus.Invalidˉentry {
        return 14;
    }
    return 0;
}

export fn Main() -> i32 {
    if process.argument_count() == 0u32 { return Runˉselfˉtests(); }
    if process.argument_count() != 3u32 {
        diagnostic.write_line(
            "Usage: wvuefi <native-image.bin> <entry-offset> <output.efi>"
        );
        return 64;
    }

    let Entryˉbytes: bytes = Textˉtoˉutf8(process.argument(1u32));
    let Entry: Decimalˉparsing.Foundationˉu32ˉparse =
        Decimalˉparsing.Foundationˉu32ˉdecimalˉparse(
            Entryˉbytes,
            0u32,
            Bytesˉlength(Entryˉbytes)
        );
    if !Entry.Valid {
        diagnostic.write_line(Description(Invalidˉentry(Entryˉbytes), 0u32));
        return 2;
    }

    let Nativeˉimage: bytes = file.read_bytes(process.argument(0u32));
    let Result: Construction.Uefiˉapplicationˉconstructionˉresult =
        Construction.Uefiˉapplicationˉconstruct(Nativeˉimage, Entry.Value);
    let Report: text = Description(Result, Bytesˉlength(Nativeˉimage));
    if Result.Status != Construction.Uefiˉapplicationˉconstructionˉstatus.Valid {
        diagnostic.write_line(Report);
        return 2;
    }
    file.write_bytes(process.argument(2u32), Result.Image);
    console.write_line(Report);
    return 0;
}
