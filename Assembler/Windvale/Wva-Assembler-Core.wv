}

fn Typedˉregisterˉwidth(Input: bytes, Value: Wvaˉtoken) -> u32 {
    if Registerˉbyteˉisˉvalid(Input, Value) { return 8u32; }
    if Registerˉwordˉisˉvalid(Input, Value) { return 16u32; }
    if Registerˉisˉvalid(Input, Value) { return 32u32; }
    if Registerˉwideˉisˉvalid(Input, Value) { return 64u32; }
    return 0u32;
}

fn Binaryˉstatementˉkind(Input: bytes, Value: Wvaˉtoken) -> u32 {
    if Tokenˉequalsˉtext(Input, Value, "move") { return 23u32; }
    if Tokenˉequalsˉtext(Input, Value, "add") { return 24u32; }
