    if Kind == 80u32 { return 16u32; }
    if Kind == 54u32 { return 64u32; }
    if Kind == 56u32 { return 64u32; }
    return 32u32;
}

fn Expandedˉcodeˉstatementˉisˉrecognized(Input: bytes, Value: Wvaˉtoken) -> bool {
    if Binaryˉstatementˉkind(Input, Value) != 0u32 { return true; }
    if Immediateˉstatementˉkind(Input, Value) != 0u32 { return true; }
    if Narrowˉimmediateˉstatementˉkind(Input, Value) != 0u32 { return true; }
    if Shiftˉstatementˉkind(Input, Value) != 0u32 { return true; }
    if Memoryˉstatementˉkind(Input, Value) != 0u32 { return true; }
    if Tokenˉequalsˉtext(Input, Value, "label") { return true; }
    if Tokenˉequalsˉtext(Input, Value, "jump_label") { return true; }
    if Tokenˉequalsˉtext(Input, Value, "branch") { return true; }
    if Tokenˉequalsˉtext(Input, Value, "push") { return true; }
    if Tokenˉequalsˉtext(Input, Value, "pop") { return true; }
    if Tokenˉequalsˉtext(Input, Value, "call_register") { return true; }
    if Tokenˉequalsˉtext(Input, Value, "jump_register") { return true; }
    if Tokenˉequalsˉtext(Input, Value, "load_u32") { return true; }
    if Tokenˉequalsˉtext(Input, Value, "load_u64") { return true; }
    if Tokenˉequalsˉtext(Input, Value, "store_u32") { return true; }
    if Tokenˉequalsˉtext(Input, Value, "store_u64") { return true; }
    if Tokenˉequalsˉtext(Input, Value, "move_u8") { return true; }
    if Tokenˉequalsˉtext(Input, Value, "move_u16") { return true; }
    if Tokenˉequalsˉtext(Input, Value, "load_u8") { return true; }
    if Tokenˉequalsˉtext(Input, Value, "load_u16") { return true; }
    if Tokenˉequalsˉtext(Input, Value, "store_u8") { return true; }
    if Tokenˉequalsˉtext(Input, Value, "store_u16") { return true; }
    if Tokenˉequalsˉtext(Input, Value, "set_condition") { return true; }
    if Tokenˉequalsˉtext(Input, Value, "zero_extend_u8") { return true; }
    if Tokenˉequalsˉtext(Input, Value, "zero_extend_u16") { return true; }
    if Tokenˉequalsˉtext(Input, Value, "sign_extend_i8") { return true; }
    if Tokenˉequalsˉtext(Input, Value, "sign_extend_i16") { return true; }
    if Tokenˉequalsˉtext(Input, Value, "in_u8") { return true; }
    if Tokenˉequalsˉtext(Input, Value, "out_u8") { return true; }
    return Tokenˉequalsˉtext(Input, Value, "load_address");
}

fn Conditionˉtag(Input: bytes, Value: Wvaˉtoken) -> u32 {
    if Tokenˉequalsˉtext(Input, Value, "overflow") { return 0u32; }
    if Tokenˉequalsˉtext(Input, Value, "not_overflow") { return 1u32; }
    if Tokenˉequalsˉtext(Input, Value, "below") { return 2u32; }
    if Tokenˉequalsˉtext(Input, Value, "above_equal") { return 3u32; }
    if Tokenˉequalsˉtext(Input, Value, "equal") { return 4u32; }
    if Tokenˉequalsˉtext(Input, Value, "not_equal") { return 5u32; }
    if Tokenˉequalsˉtext(Input, Value, "below_equal") { return 6u32; }
    if Tokenˉequalsˉtext(Input, Value, "above") { return 7u32; }
    if Tokenˉequalsˉtext(Input, Value, "sign") { return 8u32; }
    if Tokenˉequalsˉtext(Input, Value, "not_sign") { return 9u32; }
    if Tokenˉequalsˉtext(Input, Value, "parity") { return 10u32; }
    if Tokenˉequalsˉtext(Input, Value, "not_parity") { return 11u32; }
    if Tokenˉequalsˉtext(Input, Value, "less") { return 12u32; }
    if Tokenˉequalsˉtext(Input, Value, "greater_equal") { return 13u32; }
    if Tokenˉequalsˉtext(Input, Value, "less_equal") { return 14u32; }
    if Tokenˉequalsˉtext(Input, Value, "greater") { return 15u32; }
    return 16u32;
}

fn Parseˉu32(Input: bytes, Value: Wvaˉtoken) -> Foundationˉu32ˉparse {
    return Foundationˉu32ˉdecimalˉparse(Input, Value.Offset, Value.Length);
}

fn Digitˉi32(Value: u8) -> i32 {
    if Value == 48u8 { return 0; }
    if Value == 49u8 { return 1; }
    if Value == 50u8 { return 2; }
    if Value == 51u8 { return 3; }
    if Value == 52u8 { return 4; }
    if Value == 53u8 { return 5; }
    if Value == 54u8 { return 6; }
    if Value == 55u8 { return 7; }
    if Value == 56u8 { return 8; }
    if Value == 57u8 { return 9; }
    return -1;
}

fn Parseˉi32(Input: bytes, Value: Wvaˉtoken) -> Wvaˉi32ˉparse {
    if Value.Length == 0u32 { return Wvaˉi32ˉparse(false, 0); }
    var Index: u32 = 0u32;
    var Negative: bool = false;
    if Bytesˉreadˉu8(Input, Value.Offset) == 45u8 {
        Negative = true;
        Index = 1u32;
        if Value.Length == 1u32 { return Wvaˉi32ˉparse(false, 0); }
    }

    var Result: i32 = 0;
    while Index < Value.Length {
        let Digit: i32 = Digitˉi32(Bytesˉreadˉu8(Input, Value.Offset + Index));
        if Digit < 0 { return Wvaˉi32ˉparse(false, 0); }
        if Negative {
            if Result < -214748364 { return Wvaˉi32ˉparse(false, 0); }
            if Result == -214748364 {
                if Digit > 8 { return Wvaˉi32ˉparse(false, 0); }
            }
            Result = Result * 10 - Digit;
        } else {
            if Result > 214748364 { return Wvaˉi32ˉparse(false, 0); }
            if Result == 214748364 {
                if Digit > 7 { return Wvaˉi32ˉparse(false, 0); }
            }
            Result = Result * 10 + Digit;
        }
        Index = Index + 1u32;
    }
    return Wvaˉi32ˉparse(true, Result);
}

fn Statementˉfailure(Status: Wvaˉsemanticˉstatus, Value: Wvaˉtoken) -> Wvaˉstatementˉcheck {
    return Wvaˉstatementˉcheck(
        Status,
        0u32,
        0u32,
        false,
        0u32,
        0u32,
        Value.Offset,
        Value.Line,
        Value.Column
    );
}

fn Statementˉsuccess(
    Kind: u32,
    Size: u32,
    Reference: Wvaˉtoken,
    Hasˉreference: bool,
    First: Wvaˉtoken
) -> Wvaˉstatementˉcheck {
    return Wvaˉstatementˉcheck(
        Wvaˉsemanticˉstatus.Valid,
        Kind,
        Size,
        Hasˉreference,
        Reference.Offset,
        Reference.Length,
        First.Offset,
        First.Line,
        First.Column
    );
}

fn Byteˉregisterˉrequiresˉrex(Input: bytes, Value: Wvaˉtoken) -> bool {
    if Typedˉregisterˉwidth(Input, Value) != 8u32 { return false; }
    return Registerˉindex(Input, Value) >= 4u32;
}

fn Statementˉisˉallowed(Sectionˉkind: u32, Statementˉkind: u32) -> bool {
    if Sectionˉkind == 1u32 {
        if Statementˉkind <= 7u32 { return true; }
        if Statementˉkind >= 13u32 { return Statementˉkind <= 92u32; }
        return false;
    }
    if Sectionˉkind == 2u32 {
        if Statementˉkind >= 8u32 { return Statementˉkind <= 11u32; }
        return false;
    }
    if Sectionˉkind == 3u32 {
        if Statementˉkind >= 8u32 { return Statementˉkind <= 11u32; }
        return false;
    }
    if Sectionˉkind == 4u32 { return Statementˉkind == 12u32; }
    return false;
}

fn Checkˉstatement(Input: bytes, Line: Wvaˉline, Sectionˉkind: u32) -> Wvaˉstatementˉcheck {
    let First: Wvaˉtoken = Lineˉtoken(Input, Line, 0u32);
    var Kind: u32 = 0u32;
    var Size: u32 = 0u32;
    var Hasˉreference: bool = false;
    var Reference: Wvaˉtoken = First;

    if Expandedˉcodeˉstatementˉisˉrecognized(Input, First) {
        if Sectionˉkind != 1u32 {
            return Statementˉfailure(Wvaˉsemanticˉstatus.Wva1008, First);
        }
    }

    if Tokenˉequalsˉtext(Input, First, "label") {
        if Line.Tokens != 2u32 { return Statementˉfailure(Wvaˉsemanticˉstatus.Wva1003, First); }
        Reference = Lineˉtoken(Input, Line, 1u32);
        if !Machineˉnameˉisˉvalid(Input, Reference) {
            return Statementˉfailure(Wvaˉsemanticˉstatus.Wva1003, First);
        }
        return Statementˉsuccess(20u32, 0u32, Reference, false, First);
    }
    if Tokenˉequalsˉtext(Input, First, "jump_label") {
        if Line.Tokens != 2u32 { return Statementˉfailure(Wvaˉsemanticˉstatus.Wva1003, First); }
        Reference = Lineˉtoken(Input, Line, 1u32);
        if !Machineˉnameˉisˉvalid(Input, Reference) {
            return Statementˉfailure(Wvaˉsemanticˉstatus.Wva1003, First);
        }
        return Statementˉsuccess(21u32, 5u32, Reference, false, First);
    }
    if Tokenˉequalsˉtext(Input, First, "branch") {
        if Line.Tokens != 3u32 { return Statementˉfailure(Wvaˉsemanticˉstatus.Wva1003, First); }
        let Condition: Wvaˉtoken = Lineˉtoken(Input, Line, 1u32);
        if Conditionˉtag(Input, Condition) > 15u32 {
            return Statementˉfailure(Wvaˉsemanticˉstatus.Wva1003, First);
        }
        Reference = Lineˉtoken(Input, Line, 2u32);
        if !Machineˉnameˉisˉvalid(Input, Reference) {
            return Statementˉfailure(Wvaˉsemanticˉstatus.Wva1003, First);
        }
        return Statementˉsuccess(22u32, 6u32, Reference, false, First);
    }

    if Tokenˉequalsˉtext(Input, First, "in_u8") {
        if Line.Tokens != 1u32 { return Statementˉfailure(Wvaˉsemanticˉstatus.Wva1003, First); }
        return Statementˉsuccess(86u32, 1u32, Reference, false, First);
    }
    if Tokenˉequalsˉtext(Input, First, "out_u8") {
        if Line.Tokens != 1u32 { return Statementˉfailure(Wvaˉsemanticˉstatus.Wva1003, First); }
        return Statementˉsuccess(87u32, 1u32, Reference, false, First);
    }

    if Tokenˉequalsˉtext(Input, First, "move_u8") {
        if Line.Tokens != 3u32 { return Statementˉfailure(Wvaˉsemanticˉstatus.Wva1003, First); }
        let Moveˉu8ˉregister: Wvaˉtoken = Lineˉtoken(Input, Line, 1u32);
        if !Registerˉbyteˉisˉvalid(Input, Moveˉu8ˉregister) {
            return Statementˉfailure(Wvaˉsemanticˉstatus.Wva1003, First);
        }
        let Moveˉu8ˉvalue: Wvaˉtoken = Lineˉtoken(Input, Line, 2u32);
        let Moveˉu8ˉparsed: Foundationˉu32ˉparse = Parseˉu32(Input, Moveˉu8ˉvalue);
        if !Moveˉu8ˉparsed.Valid { return Statementˉfailure(Wvaˉsemanticˉstatus.Wva1005, Moveˉu8ˉvalue); }
        if Moveˉu8ˉparsed.Value > 255u32 {
            return Statementˉfailure(Wvaˉsemanticˉstatus.Wva1005, Moveˉu8ˉvalue);
        }
        Size = 2u32;
        if Byteˉregisterˉrequiresˉrex(Input, Moveˉu8ˉregister) { Size = 3u32; }
        return Statementˉsuccess(57u32, Size, Reference, false, First);
    }
    if Tokenˉequalsˉtext(Input, First, "move_u16") {
        if Line.Tokens != 3u32 { return Statementˉfailure(Wvaˉsemanticˉstatus.Wva1003, First); }
        let Moveˉu16ˉregister: Wvaˉtoken = Lineˉtoken(Input, Line, 1u32);
        if !Registerˉwordˉisˉvalid(Input, Moveˉu16ˉregister) {
            return Statementˉfailure(Wvaˉsemanticˉstatus.Wva1003, First);
        }
        let Moveˉu16ˉvalue: Wvaˉtoken = Lineˉtoken(Input, Line, 2u32);
        let Moveˉu16ˉparsed: Foundationˉu32ˉparse = Parseˉu32(Input, Moveˉu16ˉvalue);
        if !Moveˉu16ˉparsed.Valid { return Statementˉfailure(Wvaˉsemanticˉstatus.Wva1005, Moveˉu16ˉvalue); }
        if Moveˉu16ˉparsed.Value > 65535u32 {
            return Statementˉfailure(Wvaˉsemanticˉstatus.Wva1005, Moveˉu16ˉvalue);
        }
        Size = 4u32;
        if Registerˉindex(Input, Moveˉu16ˉregister) >= 8u32 { Size = 5u32; }
        return Statementˉsuccess(58u32, Size, Reference, false, First);
    }

    if Tokenˉequalsˉtext(Input, First, "set_condition") {
        if Line.Tokens != 3u32 { return Statementˉfailure(Wvaˉsemanticˉstatus.Wva1003, First); }
        let Setˉcondition: Wvaˉtoken = Lineˉtoken(Input, Line, 1u32);
        let Setˉregister: Wvaˉtoken = Lineˉtoken(Input, Line, 2u32);
        if Conditionˉtag(Input, Setˉcondition) > 15u32 {
            return Statementˉfailure(Wvaˉsemanticˉstatus.Wva1003, First);
        }
        if !Registerˉbyteˉisˉvalid(Input, Setˉregister) {
            return Statementˉfailure(Wvaˉsemanticˉstatus.Wva1003, First);
        }
        Size = 3u32;
        if Byteˉregisterˉrequiresˉrex(Input, Setˉregister) { Size = 4u32; }
        return Statementˉsuccess(81u32, Size, Reference, false, First);
    }

    var Extensionˉkind: u32 = 0u32;
    if Tokenˉequalsˉtext(Input, First, "zero_extend_u8") { Extensionˉkind = 82u32; }
    if Tokenˉequalsˉtext(Input, First, "zero_extend_u16") { Extensionˉkind = 83u32; }
    if Tokenˉequalsˉtext(Input, First, "sign_extend_i8") { Extensionˉkind = 84u32; }
    if Tokenˉequalsˉtext(Input, First, "sign_extend_i16") { Extensionˉkind = 85u32; }
    if Extensionˉkind != 0u32 {
        if Line.Tokens != 3u32 { return Statementˉfailure(Wvaˉsemanticˉstatus.Wva1003, First); }
        let Extensionˉdestination: Wvaˉtoken = Lineˉtoken(Input, Line, 1u32);
        let Extensionˉsource: Wvaˉtoken = Lineˉtoken(Input, Line, 2u32);
        let Extensionˉdestinationˉwidth: u32 = Typedˉregisterˉwidth(Input, Extensionˉdestination);
        if Extensionˉdestinationˉwidth != 32u32 {
            if Extensionˉdestinationˉwidth != 64u32 {
                return Statementˉfailure(Wvaˉsemanticˉstatus.Wva1003, First);
            }
        }
        var Extensionˉsourceˉwidth: u32 = 8u32;
        if Extensionˉkind == 83u32 { Extensionˉsourceˉwidth = 16u32; }
        if Extensionˉkind == 85u32 { Extensionˉsourceˉwidth = 16u32; }
        if Typedˉregisterˉwidth(Input, Extensionˉsource) != Extensionˉsourceˉwidth {
            return Statementˉfailure(Wvaˉsemanticˉstatus.Wva1003, First);
        }
        Size = 3u32;
        if Extensionˉdestinationˉwidth == 64u32 { Size = 4u32; }
        else {
            if Registerˉindex(Input, Extensionˉdestination) >= 8u32 { Size = 4u32; }
            else {
                if Registerˉindex(Input, Extensionˉsource) >= 8u32 { Size = 4u32; }
                else {
                    if Byteˉregisterˉrequiresˉrex(Input, Extensionˉsource) { Size = 4u32; }
                }
            }
        }
        return Statementˉsuccess(Extensionˉkind, Size, Reference, false, First);
    }

    let Binaryˉkind: u32 = Binaryˉstatementˉkind(Input, First);
    if Binaryˉkind != 0u32 {
        if Line.Tokens != 3u32 { return Statementˉfailure(Wvaˉsemanticˉstatus.Wva1003, First); }
        let Destination: Wvaˉtoken = Lineˉtoken(Input, Line, 1u32);
        let Source: Wvaˉtoken = Lineˉtoken(Input, Line, 2u32);
        let Destinationˉwidth: u32 = Typedˉregisterˉwidth(Input, Destination);
        let Sourceˉwidth: u32 = Typedˉregisterˉwidth(Input, Source);
        if Destinationˉwidth == 0u32 { return Statementˉfailure(Wvaˉsemanticˉstatus.Wva1003, First); }
        if Destinationˉwidth != Sourceˉwidth { return Statementˉfailure(Wvaˉsemanticˉstatus.Wva1003, First); }
        if Binaryˉkind == 40u32 {
            if Destinationˉwidth == 8u32 {
                return Statementˉfailure(Wvaˉsemanticˉstatus.Wva1003, First);
            }
        }
        Size = 2u32;
        if Binaryˉkind == 40u32 { Size = 3u32; }
        if Destinationˉwidth == 16u32 { Size = Size + 1u32; }
        if Destinationˉwidth == 64u32 { Size = Size + 1u32; }
        else {
            if Registerˉindex(Input, Destination) >= 8u32 { Size = Size + 1u32; }
            else {
                if Registerˉindex(Input, Source) >= 8u32 { Size = Size + 1u32; }
                else {
                    if Byteˉregisterˉrequiresˉrex(Input, Destination) { Size = Size + 1u32; }
                    else {
                        if Byteˉregisterˉrequiresˉrex(Input, Source) { Size = Size + 1u32; }
                    }
                }
            }
        }
        return Statementˉsuccess(Binaryˉkind, Size, Reference, false, First);
    }

    let Immediateˉkind: u32 = Immediateˉstatementˉkind(Input, First);
    if Immediateˉkind != 0u32 {
        if Line.Tokens != 3u32 { return Statementˉfailure(Wvaˉsemanticˉstatus.Wva1003, First); }
        let Immediateˉregister: Wvaˉtoken = Lineˉtoken(Input, Line, 1u32);
        let Immediateˉwidth: u32 = Typedˉregisterˉwidth(Input, Immediateˉregister);
        if Immediateˉwidth != 32u32 {
            if Immediateˉwidth != 64u32 {
                return Statementˉfailure(Wvaˉsemanticˉstatus.Wva1003, First);
            }
        }
        let Immediateˉtoken: Wvaˉtoken = Lineˉtoken(Input, Line, 2u32);
        let Immediateˉparsed: Wvaˉi32ˉparse = Parseˉi32(Input, Immediateˉtoken);
        if !Immediateˉparsed.Valid {
            return Statementˉfailure(Wvaˉsemanticˉstatus.Wva1005, Immediateˉtoken);
        }
        Size = 6u32;
        if Immediateˉwidth == 64u32 { Size = 7u32; }
        else {
            if Registerˉindex(Input, Immediateˉregister) >= 8u32 { Size = 7u32; }
        }
        return Statementˉsuccess(Immediateˉkind, Size, Reference, false, First);
    }

    let Narrowˉimmediateˉkind: u32 = Narrowˉimmediateˉstatementˉkind(Input, First);
    if Narrowˉimmediateˉkind != 0u32 {
        if Line.Tokens != 3u32 { return Statementˉfailure(Wvaˉsemanticˉstatus.Wva1003, First); }
        let Narrowˉregister: Wvaˉtoken = Lineˉtoken(Input, Line, 1u32);
        var Narrowˉwidth: u32 = 8u32;
        if Narrowˉimmediateˉkind >= 66u32 { Narrowˉwidth = 16u32; }
        if Typedˉregisterˉwidth(Input, Narrowˉregister) != Narrowˉwidth {
            return Statementˉfailure(Wvaˉsemanticˉstatus.Wva1003, First);
        }
        let Narrowˉtoken: Wvaˉtoken = Lineˉtoken(Input, Line, 2u32);
        let Narrowˉparsed: Wvaˉi32ˉparse = Parseˉi32(Input, Narrowˉtoken);
        if !Narrowˉparsed.Valid { return Statementˉfailure(Wvaˉsemanticˉstatus.Wva1005, Narrowˉtoken); }
        if Narrowˉwidth == 8u32 {
            if Narrowˉparsed.Value < -128 { return Statementˉfailure(Wvaˉsemanticˉstatus.Wva1005, Narrowˉtoken); }
            if Narrowˉparsed.Value > 127 { return Statementˉfailure(Wvaˉsemanticˉstatus.Wva1005, Narrowˉtoken); }
            Size = 3u32;
            if Byteˉregisterˉrequiresˉrex(Input, Narrowˉregister) { Size = 4u32; }
        } else {
            if Narrowˉparsed.Value < -32768 { return Statementˉfailure(Wvaˉsemanticˉstatus.Wva1005, Narrowˉtoken); }
            if Narrowˉparsed.Value > 32767 { return Statementˉfailure(Wvaˉsemanticˉstatus.Wva1005, Narrowˉtoken); }
            Size = 5u32;
            if Registerˉindex(Input, Narrowˉregister) >= 8u32 { Size = 6u32; }
        }
        return Statementˉsuccess(Narrowˉimmediateˉkind, Size, Reference, false, First);
    }

    let Shiftˉkind: u32 = Shiftˉstatementˉkind(Input, First);
    if Shiftˉkind != 0u32 {
        if Line.Tokens != 3u32 { return Statementˉfailure(Wvaˉsemanticˉstatus.Wva1003, First); }
        let Shiftˉregister: Wvaˉtoken = Lineˉtoken(Input, Line, 1u32);
        let Shiftˉwidth: u32 = Typedˉregisterˉwidth(Input, Shiftˉregister);
        if Shiftˉwidth == 0u32 { return Statementˉfailure(Wvaˉsemanticˉstatus.Wva1003, First); }
        let Shiftˉtoken: Wvaˉtoken = Lineˉtoken(Input, Line, 2u32);
        let Shiftˉparsed: Foundationˉu32ˉparse = Parseˉu32(Input, Shiftˉtoken);
        if !Shiftˉparsed.Valid { return Statementˉfailure(Wvaˉsemanticˉstatus.Wva1005, Shiftˉtoken); }
        if Shiftˉparsed.Value >= Shiftˉwidth {
            return Statementˉfailure(Wvaˉsemanticˉstatus.Wva1005, Shiftˉtoken);
        }
        Size = 3u32;
        if Shiftˉwidth == 16u32 { Size = 4u32; }
        if Shiftˉwidth == 64u32 { Size = 4u32; }
        else {
            if Registerˉindex(Input, Shiftˉregister) >= 8u32 { Size = Size + 1u32; }
            else {
                if Byteˉregisterˉrequiresˉrex(Input, Shiftˉregister) { Size = Size + 1u32; }
            }
        }
        return Statementˉsuccess(Shiftˉkind, Size, Reference, false, First);
    }

    let Memoryˉkind: u32 = Memoryˉstatementˉkind(Input, First);
    if Memoryˉkind != 0u32 {
        if Line.Tokens != 6u32 { return Statementˉfailure(Wvaˉsemanticˉstatus.Wva1003, First); }
        var Valueˉtoken: Wvaˉtoken = Lineˉtoken(Input, Line, 1u32);
        var Baseˉtoken: Wvaˉtoken = Lineˉtoken(Input, Line, 2u32);
        var Indexˉtoken: Wvaˉtoken = Lineˉtoken(Input, Line, 3u32);
        var Scaleˉtoken: Wvaˉtoken = Lineˉtoken(Input, Line, 4u32);
        var Displacementˉtoken: Wvaˉtoken = Lineˉtoken(Input, Line, 5u32);
        if Memoryˉstatementˉisˉstore(Memoryˉkind) {
            Baseˉtoken = Lineˉtoken(Input, Line, 1u32);
            Indexˉtoken = Lineˉtoken(Input, Line, 2u32);
            Scaleˉtoken = Lineˉtoken(Input, Line, 3u32);
            Displacementˉtoken = Lineˉtoken(Input, Line, 4u32);
            Valueˉtoken = Lineˉtoken(Input, Line, 5u32);
        }
        let Memoryˉwidth: u32 = Memoryˉstatementˉwidth(Memoryˉkind);
        if Typedˉregisterˉwidth(Input, Valueˉtoken) != Memoryˉwidth {
            return Statementˉfailure(Wvaˉsemanticˉstatus.Wva1003, Valueˉtoken);
        }
        if !Registerˉwideˉisˉvalid(Input, Baseˉtoken) {
            return Statementˉfailure(Wvaˉsemanticˉstatus.Wva1003, Baseˉtoken);
        }
        let Hasˉindex: bool = !Tokenˉequalsˉtext(Input, Indexˉtoken, "none");
        if Hasˉindex {
            if !Registerˉwideˉisˉvalid(Input, Indexˉtoken) {
                return Statementˉfailure(Wvaˉsemanticˉstatus.Wva1003, Indexˉtoken);
            }
            if Tokenˉequalsˉtext(Input, Indexˉtoken, "rsp") {
                return Statementˉfailure(Wvaˉsemanticˉstatus.Wva1003, Indexˉtoken);
            }
        }
        let Scaleˉparsed: Foundationˉu32ˉparse = Parseˉu32(Input, Scaleˉtoken);
        if !Scaleˉparsed.Valid { return Statementˉfailure(Wvaˉsemanticˉstatus.Wva1005, Scaleˉtoken); }
        if Scaleˉparsed.Value != 1u32 {
            if Scaleˉparsed.Value != 2u32 {
                if Scaleˉparsed.Value != 4u32 {
                    if Scaleˉparsed.Value != 8u32 {
                        return Statementˉfailure(Wvaˉsemanticˉstatus.Wva1005, Scaleˉtoken);
                    }
                }
            }
        }
        if !Hasˉindex {
            if Scaleˉparsed.Value != 1u32 {
                return Statementˉfailure(Wvaˉsemanticˉstatus.Wva1005, Scaleˉtoken);
            }
        }
        let Displacementˉparsed: Wvaˉi32ˉparse = Parseˉi32(Input, Displacementˉtoken);
        if !Displacementˉparsed.Valid {
            return Statementˉfailure(Wvaˉsemanticˉstatus.Wva1005, Displacementˉtoken);
        }
        Size = 7u32;
        if Memoryˉwidth == 16u32 { Size = 8u32; }
        if Memoryˉwidth == 64u32 { Size = 8u32; }
        else {
            if Registerˉindex(Input, Valueˉtoken) >= 8u32 { Size = Size + 1u32; }
            else {
                if Registerˉindex(Input, Baseˉtoken) >= 8u32 { Size = Size + 1u32; }
                else {
                    if Hasˉindex {
                        if Registerˉindex(Input, Indexˉtoken) >= 8u32 { Size = Size + 1u32; }
                        else {
                            if Byteˉregisterˉrequiresˉrex(Input, Valueˉtoken) { Size = Size + 1u32; }
                        }
                    } else {
                        if Byteˉregisterˉrequiresˉrex(Input, Valueˉtoken) { Size = Size + 1u32; }
                    }
                }
            }
        }
        return Statementˉsuccess(Memoryˉkind, Size, Reference, false, First);
    }

    var Controlˉkind: u32 = 0u32;
    if Tokenˉequalsˉtext(Input, First, "push") { Controlˉkind = 31u32; }
    if Tokenˉequalsˉtext(Input, First, "pop") { Controlˉkind = 32u32; }
    if Tokenˉequalsˉtext(Input, First, "call_register") { Controlˉkind = 33u32; }
    if Tokenˉequalsˉtext(Input, First, "jump_register") { Controlˉkind = 34u32; }
    if Controlˉkind != 0u32 {
        if Line.Tokens != 2u32 { return Statementˉfailure(Wvaˉsemanticˉstatus.Wva1003, First); }
        let Controlˉregister: Wvaˉtoken = Lineˉtoken(Input, Line, 1u32);
        if !Registerˉwideˉisˉvalid(Input, Controlˉregister) {
            return Statementˉfailure(Wvaˉsemanticˉstatus.Wva1003, First);
        }
        Size = 1u32;
        if Controlˉkind >= 33u32 { Size = 2u32; }
        if Registerˉindex(Input, Controlˉregister) >= 8u32 { Size = Size + 1u32; }
        return Statementˉsuccess(Controlˉkind, Size, Reference, false, First);
    }

    var Ripˉkind: u32 = 0u32;
    if Tokenˉequalsˉtext(Input, First, "load_u32") { Ripˉkind = 35u32; }
    if Tokenˉequalsˉtext(Input, First, "load_u64") { Ripˉkind = 36u32; }
    if Tokenˉequalsˉtext(Input, First, "store_u32") { Ripˉkind = 37u32; }
    if Tokenˉequalsˉtext(Input, First, "store_u64") { Ripˉkind = 38u32; }
    if Tokenˉequalsˉtext(Input, First, "load_address") { Ripˉkind = 39u32; }
    if Tokenˉequalsˉtext(Input, First, "load_u8") { Ripˉkind = 73u32; }
    if Tokenˉequalsˉtext(Input, First, "load_u16") { Ripˉkind = 74u32; }
    if Tokenˉequalsˉtext(Input, First, "store_u8") { Ripˉkind = 75u32; }
    if Tokenˉequalsˉtext(Input, First, "store_u16") { Ripˉkind = 76u32; }
    if Ripˉkind != 0u32 {
        if Line.Tokens != 3u32 { return Statementˉfailure(Wvaˉsemanticˉstatus.Wva1003, First); }
        var Ripˉregister: Wvaˉtoken = Lineˉtoken(Input, Line, 1u32);
        Reference = Lineˉtoken(Input, Line, 2u32);
        var Requiredˉwidth: u32 = 32u32;
        if Ripˉkind == 36u32 { Requiredˉwidth = 64u32; }
        if Ripˉkind == 38u32 { Requiredˉwidth = 64u32; }
        if Ripˉkind == 39u32 { Requiredˉwidth = 64u32; }
        if Ripˉkind == 73u32 { Requiredˉwidth = 8u32; }
        if Ripˉkind == 74u32 { Requiredˉwidth = 16u32; }
        if Ripˉkind == 75u32 { Requiredˉwidth = 8u32; }
        if Ripˉkind == 76u32 { Requiredˉwidth = 16u32; }
        if Ripˉkind == 37u32 {
            Reference = Lineˉtoken(Input, Line, 1u32);
            Ripˉregister = Lineˉtoken(Input, Line, 2u32);
        }
        if Ripˉkind == 38u32 {
            Reference = Lineˉtoken(Input, Line, 1u32);
            Ripˉregister = Lineˉtoken(Input, Line, 2u32);
        }
        if Ripˉkind == 75u32 {
            Reference = Lineˉtoken(Input, Line, 1u32);
            Ripˉregister = Lineˉtoken(Input, Line, 2u32);
        }
        if Ripˉkind == 76u32 {
            Reference = Lineˉtoken(Input, Line, 1u32);
            Ripˉregister = Lineˉtoken(Input, Line, 2u32);
        }
        if Typedˉregisterˉwidth(Input, Ripˉregister) != Requiredˉwidth {
            return Statementˉfailure(Wvaˉsemanticˉstatus.Wva1003, First);
        }
        if !Machineˉnameˉisˉvalid(Input, Reference) {
            return Statementˉfailure(Wvaˉsemanticˉstatus.Wva1003, First);
        }
        Size = 6u32;
        if Requiredˉwidth == 16u32 { Size = 7u32; }
        if Requiredˉwidth == 64u32 { Size = 7u32; }
        else {
            if Registerˉindex(Input, Ripˉregister) >= 8u32 { Size = Size + 1u32; }
            else {
                if Byteˉregisterˉrequiresˉrex(Input, Ripˉregister) { Size = Size + 1u32; }
            }
        }
        return Statementˉsuccess(Ripˉkind, Size, Reference, true, First);
    }

    if Tokenˉequalsˉtext(Input, First, "nop") {
        Kind = 1u32;
        Size = 1u32;
        if Line.Tokens != 1u32 { return Statementˉfailure(Wvaˉsemanticˉstatus.Wva1003, First); }
    } else {
        if Tokenˉequalsˉtext(Input, First, "return") {
            Kind = 2u32;
            Size = 1u32;
            if Line.Tokens != 1u32 { return Statementˉfailure(Wvaˉsemanticˉstatus.Wva1003, First); }
        } else {
            if Tokenˉequalsˉtext(Input, First, "trap") {
                Kind = 3u32;
                Size = 1u32;
                if Line.Tokens != 1u32 { return Statementˉfailure(Wvaˉsemanticˉstatus.Wva1003, First); }
            } else {
                if Tokenˉequalsˉtext(Input, First, "call") {
                    Kind = 4u32;
                    Size = 5u32;
                    Hasˉreference = true;
                } else {
                    if Tokenˉequalsˉtext(Input, First, "jump") {
                        Kind = 5u32;
                        Size = 5u32;
                        Hasˉreference = true;
                    } else {
                        if Tokenˉequalsˉtext(Input, First, "address_u32") {
                            Kind = 11u32;
                            Size = 4u32;
                            Hasˉreference = true;
                        }
                    }
                }
                if Hasˉreference {
                    if Line.Tokens != 2u32 { return Statementˉfailure(Wvaˉsemanticˉstatus.Wva1003, First); }
                    Reference = Lineˉtoken(Input, Line, 1u32);
                    if !Machineˉnameˉisˉvalid(Input, Reference) {
                        return Statementˉfailure(Wvaˉsemanticˉstatus.Wva1003, First);
                    }
                } else {
                    if Tokenˉequalsˉtext(Input, First, "move_i32") {
                        Kind = 6u32;
                        Size = 5u32;
                        if Line.Tokens != 3u32 { return Statementˉfailure(Wvaˉsemanticˉstatus.Wva1003, First); }
                        if !Registerˉisˉvalid(Input, Lineˉtoken(Input, Line, 1u32)) {
                            return Statementˉfailure(Wvaˉsemanticˉstatus.Wva1003, First);
                        }
                        if Registerˉindex(Input, Lineˉtoken(Input, Line, 1u32)) >= 8u32 { Size = 6u32; }
                        let Moveˉi32ˉnumber: Wvaˉtoken = Lineˉtoken(Input, Line, 2u32);
                        let Moveˉi32ˉparsed: Wvaˉi32ˉparse = Parseˉi32(Input, Moveˉi32ˉnumber);
                        if !Moveˉi32ˉparsed.Valid {
                            return Statementˉfailure(Wvaˉsemanticˉstatus.Wva1005, Moveˉi32ˉnumber);
                        }
                    } else {
                        if Tokenˉequalsˉtext(Input, First, "move_u32") {
                            Kind = 7u32;
                            Size = 5u32;
                            if Line.Tokens != 3u32 { return Statementˉfailure(Wvaˉsemanticˉstatus.Wva1003, First); }
                            if !Registerˉisˉvalid(Input, Lineˉtoken(Input, Line, 1u32)) {
                                return Statementˉfailure(Wvaˉsemanticˉstatus.Wva1003, First);
                            }
                            if Registerˉindex(Input, Lineˉtoken(Input, Line, 1u32)) >= 8u32 { Size = 6u32; }
                            let Moveˉu32ˉnumber: Wvaˉtoken = Lineˉtoken(Input, Line, 2u32);
                            let Moveˉu32ˉparsed: Foundationˉu32ˉparse = Parseˉu32(Input, Moveˉu32ˉnumber);
                            if !Moveˉu32ˉparsed.Valid {
                                return Statementˉfailure(Wvaˉsemanticˉstatus.Wva1005, Moveˉu32ˉnumber);
                            }
                        } else {
                            if Tokenˉequalsˉtext(Input, First, "bytes") {
                                Kind = 8u32;
                                if Line.Tokens < 2u32 { return Statementˉfailure(Wvaˉsemanticˉstatus.Wva1003, First); }
                                if Line.Tokens > 4097u32 { return Statementˉfailure(Wvaˉsemanticˉstatus.Wva1003, First); }
                                Size = Line.Tokens - 1u32;
                                var Index: u32 = 1u32;
                                while Index < Line.Tokens {
                                    let Byteˉnumber: Wvaˉtoken = Lineˉtoken(Input, Line, Index);
                                    let Byteˉparsed: Foundationˉu32ˉparse = Parseˉu32(Input, Byteˉnumber);
                                    if !Byteˉparsed.Valid { return Statementˉfailure(Wvaˉsemanticˉstatus.Wva1005, Byteˉnumber); }
                                    if Byteˉparsed.Value > 255u32 { return Statementˉfailure(Wvaˉsemanticˉstatus.Wva1005, Byteˉnumber); }
                                    Index = Index + 1u32;
                                }
                            } else {
                                if Tokenˉequalsˉtext(Input, First, "u32") {
                                    Kind = 9u32;
                                    Size = 4u32;
                                    if Line.Tokens != 2u32 { return Statementˉfailure(Wvaˉsemanticˉstatus.Wva1005, First); }
                                    let U32ˉnumber: Wvaˉtoken = Lineˉtoken(Input, Line, 1u32);
                                    let U32ˉparsed: Foundationˉu32ˉparse = Parseˉu32(Input, U32ˉnumber);
                                    if !U32ˉparsed.Valid {
                                        return Statementˉfailure(Wvaˉsemanticˉstatus.Wva1005, First);
                                    }
                                } else {
                                    if Tokenˉequalsˉtext(Input, First, "i32") {
                                        Kind = 10u32;
                                        Size = 4u32;
                                        if Line.Tokens != 2u32 { return Statementˉfailure(Wvaˉsemanticˉstatus.Wva1005, First); }
                                        let I32ˉnumber: Wvaˉtoken = Lineˉtoken(Input, Line, 1u32);
                                        let I32ˉparsed: Wvaˉi32ˉparse = Parseˉi32(Input, I32ˉnumber);
                                        if !I32ˉparsed.Valid {
                                            return Statementˉfailure(Wvaˉsemanticˉstatus.Wva1005, First);
                                        }
                                    } else {
                                        if Tokenˉequalsˉtext(Input, First, "disable_interrupts") {
                                            Kind = 13u32;
                                            Size = 1u32;
                                            if Line.Tokens != 1u32 { return Statementˉfailure(Wvaˉsemanticˉstatus.Wva1003, First); }
                                        } else {
                                            if Tokenˉequalsˉtext(Input, First, "halt") {
                                                Kind = 14u32;
                                                Size = 1u32;
                                                if Line.Tokens != 1u32 { return Statementˉfailure(Wvaˉsemanticˉstatus.Wva1003, First); }
                                            } else {
                                                if Tokenˉequalsˉtext(Input, First, "out_u16") {
                                                    Kind = 15u32;
                                                    Size = 2u32;
                                                    if Line.Tokens != 1u32 { return Statementˉfailure(Wvaˉsemanticˉstatus.Wva1003, First); }
                                                } else {
                                                    if Tokenˉequalsˉtext(Input, First, "push_i32") {
                                                        Kind = 16u32;
                                                        Size = 5u32;
                                                        if Line.Tokens != 2u32 { return Statementˉfailure(Wvaˉsemanticˉstatus.Wva1003, First); }
                                                        let Pushˉnumber: Wvaˉtoken = Lineˉtoken(Input, Line, 1u32);
                                                        let Pushˉparsed: Wvaˉi32ˉparse = Parseˉi32(Input, Pushˉnumber);
                                                        if !Pushˉparsed.Valid {
                                                            return Statementˉfailure(Wvaˉsemanticˉstatus.Wva1005, Pushˉnumber);
                                                        }
                                                    } else {
                                                        if Tokenˉequalsˉtext(Input, First, "enable_page_protection") {
                                                            Kind = 17u32;
                                                            Size = 24u32;
                                                            if Line.Tokens != 1u32 { return Statementˉfailure(Wvaˉsemanticˉstatus.Wva1003, First); }
                                                        } else {
                                                            if Tokenˉequalsˉtext(Input, First, "activate_page_table") {
                                                                Kind = 18u32;
                                                                Size = 6u32;
                                                                if Line.Tokens != 1u32 { return Statementˉfailure(Wvaˉsemanticˉstatus.Wva1003, First); }
                                                            } else {
                                                                if Tokenˉequalsˉtext(Input, First, "syscall") {
                                                                    Kind = 19u32;
                                                                    Size = 2u32;
                                                                    if Line.Tokens != 1u32 { return Statementˉfailure(Wvaˉsemanticˉstatus.Wva1003, First); }
                                                                } else {
                                                                    if Tokenˉequalsˉtext(Input, First, "swap_gs") {
                                                                        Kind = 88u32;
                                                                        Size = 3u32;
                                                                        if Line.Tokens != 1u32 { return Statementˉfailure(Wvaˉsemanticˉstatus.Wva1003, First); }
                                                                    } else {
                                                                        if Tokenˉequalsˉtext(Input, First, "interrupt_return") {
                                                                            Kind = 89u32;
                                                                            Size = 2u32;
                                                                            if Line.Tokens != 1u32 { return Statementˉfailure(Wvaˉsemanticˉstatus.Wva1003, First); }
                                                                        } else {
                                                                            if Tokenˉequalsˉtext(Input, First, "cpuid") {
                                                                                Kind = 90u32;
                                                                                Size = 2u32;
                                                                                if Line.Tokens != 1u32 { return Statementˉfailure(Wvaˉsemanticˉstatus.Wva1003, First); }
                                                                            } else {
                                                                                if Tokenˉequalsˉtext(Input, First, "read_tsc") {
                                                                                    Kind = 91u32;
                                                                                    Size = 2u32;
                                                                                    if Line.Tokens != 1u32 { return Statementˉfailure(Wvaˉsemanticˉstatus.Wva1003, First); }
                                                                                } else {
                                                                                    if Tokenˉequalsˉtext(Input, First, "read_msr") {
                                                                                        Kind = 92u32;
                                                                                        Size = 2u32;
                                                                                        if Line.Tokens != 1u32 { return Statementˉfailure(Wvaˉsemanticˉstatus.Wva1003, First); }
                                                                                    } else {
                                                                                        if Tokenˉequalsˉtext(Input, First, "zero") {
                                                                                            Kind = 12u32;
                                                                                            if Line.Tokens != 2u32 { return Statementˉfailure(Wvaˉsemanticˉstatus.Wva1005, First); }
                                                                                            let Zeroˉnumber: Wvaˉtoken = Lineˉtoken(Input, Line, 1u32);
                                                                                            let Zeroˉparsed: Foundationˉu32ˉparse = Parseˉu32(Input, Zeroˉnumber);
                                                                                            if !Zeroˉparsed.Valid { return Statementˉfailure(Wvaˉsemanticˉstatus.Wva1005, First); }
                                                                                            if Zeroˉparsed.Value == 0u32 { return Statementˉfailure(Wvaˉsemanticˉstatus.Wva1005, First); }
                                                                                            Size = Zeroˉparsed.Value;
                                                                                        } else {
                                                                                            return Statementˉfailure(Wvaˉsemanticˉstatus.Wva1002, First);
                                                                                        }
                                                                                    }
                                                                                }
                                                                            }
                                                                        }
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    if !Statementˉisˉallowed(Sectionˉkind, Kind) {
        return Statementˉfailure(Wvaˉsemanticˉstatus.Wva1008, First);
    }
    return Statementˉsuccess(Kind, Size, Reference, Hasˉreference, First);
}

fn Countˉsymbolˉdeclarations(Input: bytes, Name: Wvaˉtoken) -> u32 {
    let Header: Wvaˉline = Readˉmeaningfulˉline(Input, 0u32, 1u32, 1u32);
    var Current: Wvaˉline = Readˉmeaningfulˉline(
        Input,
        Header.Nextˉcursor,
        Header.Nextˉline,
        Header.Nextˉcolumn
    );
    var Count: u32 = 0u32;
    while Current.Present {
        let First: Wvaˉtoken = Lineˉtoken(Input, Current, 0u32);
        if Tokenˉequalsˉtext(Input, First, "section") { return Count; }
        if Tokenˉequalsˉtext(Input, First, "symbol") {
            let Declaredˉname: Wvaˉtoken = Lineˉtoken(Input, Current, 3u32);
            if Spanˉequalsˉtoken(Input, Name.Offset, Name.Length, Declaredˉname) {
                Count = Count + 1u32;
            }
        }
        Current = Readˉmeaningfulˉline(
            Input,
            Current.Nextˉcursor,
            Current.Nextˉline,
            Current.Nextˉcolumn
        );
    }
    return Count;
}

fn Findˉsymbol(Input: bytes, Nameˉoffset: u32, Nameˉlength: u32) -> Wvaˉsymbolˉlookup {
    let Header: Wvaˉline = Readˉmeaningfulˉline(Input, 0u32, 1u32, 1u32);
    var Current: Wvaˉline = Readˉmeaningfulˉline(
        Input,
        Header.Nextˉcursor,
        Header.Nextˉline,
        Header.Nextˉcolumn
    );
    while Current.Present {
        let First: Wvaˉtoken = Lineˉtoken(Input, Current, 0u32);
        if Tokenˉequalsˉtext(Input, First, "section") {
            return Wvaˉsymbolˉlookup(false, 0u32, 0u32, 0u32, 0u32);
        }
        if Tokenˉequalsˉtext(Input, First, "symbol") {
            let Declaredˉname: Wvaˉtoken = Lineˉtoken(Input, Current, 3u32);
            if Spansˉequal(Input, Nameˉoffset, Nameˉlength, Declaredˉname.Offset, Declaredˉname.Length) {
                let Binding: u32 = Bindingˉtag(Input, Lineˉtoken(Input, Current, 1u32));
                let Kind: u32 = Symbolˉkindˉtag(Input, Lineˉtoken(Input, Current, 2u32));
                if Binding == 3u32 {
                    return Wvaˉsymbolˉlookup(true, Binding, Kind, 0u32, 0u32);
                }
                let Section: Wvaˉtoken = Lineˉtoken(Input, Current, 5u32);
                return Wvaˉsymbolˉlookup(true, Binding, Kind, Section.Offset, Section.Length);
            }
        }
        Current = Readˉmeaningfulˉline(
            Input,
            Current.Nextˉcursor,
            Current.Nextˉline,
            Current.Nextˉcolumn
        );
    }
    return Wvaˉsymbolˉlookup(false, 0u32, 0u32, 0u32, 0u32);
}

fn Countˉsectionˉdeclarations(Input: bytes, Name: Wvaˉtoken) -> u32 {
    let Header: Wvaˉline = Readˉmeaningfulˉline(Input, 0u32, 1u32, 1u32);
    var Current: Wvaˉline = Readˉmeaningfulˉline(
        Input,
        Header.Nextˉcursor,
        Header.Nextˉline,
        Header.Nextˉcolumn
    );
    var Count: u32 = 0u32;
    while Current.Present {
        let First: Wvaˉtoken = Lineˉtoken(Input, Current, 0u32);
        if Tokenˉequalsˉtext(Input, First, "section") {
            let Declaredˉname: Wvaˉtoken = Lineˉtoken(Input, Current, 2u32);
            if Spanˉequalsˉtoken(Input, Name.Offset, Name.Length, Declaredˉname) {
                Count = Count + 1u32;
            }
        }
        Current = Readˉmeaningfulˉline(
            Input,
            Current.Nextˉcursor,
            Current.Nextˉline,
            Current.Nextˉcolumn
        );
    }
    return Count;
}

fn Findˉsection(Input: bytes, Nameˉoffset: u32, Nameˉlength: u32) -> Wvaˉsectionˉlookup {
    let Header: Wvaˉline = Readˉmeaningfulˉline(Input, 0u32, 1u32, 1u32);
    var Current: Wvaˉline = Readˉmeaningfulˉline(
        Input,
        Header.Nextˉcursor,
        Header.Nextˉline,
        Header.Nextˉcolumn
    );
    var Index: u32 = 0u32;
    while Current.Present {
        let First: Wvaˉtoken = Lineˉtoken(Input, Current, 0u32);
        if Tokenˉequalsˉtext(Input, First, "section") {
            let Declaredˉname: Wvaˉtoken = Lineˉtoken(Input, Current, 2u32);
            if Spansˉequal(Input, Nameˉoffset, Nameˉlength, Declaredˉname.Offset, Declaredˉname.Length) {
                return Wvaˉsectionˉlookup(
                    true,
                    Sectionˉkindˉtag(Input, Lineˉtoken(Input, Current, 1u32)),
                    Index
                );
            }
            Index = Index + 1u32;
        }
        Current = Readˉmeaningfulˉline(
            Input,
            Current.Nextˉcursor,
            Current.Nextˉline,
            Current.Nextˉcolumn
        );
    }
    return Wvaˉsectionˉlookup(false, 0u32, 0u32);
}

fn Findˉdefinitions(Input: bytes, Name: Wvaˉtoken) -> Wvaˉdefinitionˉlookup {
    let Header: Wvaˉline = Readˉmeaningfulˉline(Input, 0u32, 1u32, 1u32);
    var Current: Wvaˉline = Readˉmeaningfulˉline(
        Input,
        Header.Nextˉcursor,
        Header.Nextˉline,
        Header.Nextˉcolumn
    );
    var Currentˉsectionˉoffset: u32 = 0u32;
    var Currentˉsectionˉlength: u32 = 0u32;
    var Foundˉsectionˉoffset: u32 = 0u32;
    var Foundˉsectionˉlength: u32 = 0u32;
    var Foundˉdefinitionˉoffset: u32 = 0u32;
    var Foundˉdefinitionˉline: u32 = 1u32;
    var Foundˉdefinitionˉcolumn: u32 = 1u32;
    var Count: u32 = 0u32;
    while Current.Present {
        let First: Wvaˉtoken = Lineˉtoken(Input, Current, 0u32);
        if Tokenˉequalsˉtext(Input, First, "section") {
            let Sectionˉname: Wvaˉtoken = Lineˉtoken(Input, Current, 2u32);
            Currentˉsectionˉoffset = Sectionˉname.Offset;
            Currentˉsectionˉlength = Sectionˉname.Length;
        }
        if Tokenˉequalsˉtext(Input, First, "define") {
            let Definitionˉname: Wvaˉtoken = Lineˉtoken(Input, Current, 1u32);
            if Spanˉequalsˉtoken(Input, Name.Offset, Name.Length, Definitionˉname) {
                Count = Count + 1u32;
                if Count == 1u32 {
                    Foundˉsectionˉoffset = Currentˉsectionˉoffset;
                    Foundˉsectionˉlength = Currentˉsectionˉlength;
                    Foundˉdefinitionˉoffset = Definitionˉname.Offset;
                    Foundˉdefinitionˉline = Definitionˉname.Line;
                    Foundˉdefinitionˉcolumn = Definitionˉname.Column;
                }
            }
        }
        Current = Readˉmeaningfulˉline(
            Input,
            Current.Nextˉcursor,
            Current.Nextˉline,
            Current.Nextˉcolumn
        );
    }
    return Wvaˉdefinitionˉlookup(
        Count,
        Foundˉsectionˉoffset,
        Foundˉsectionˉlength,
        Foundˉdefinitionˉoffset,
        Foundˉdefinitionˉline,
        Foundˉdefinitionˉcolumn
    );
}

fn Definitionˉwasˉseen(
    Input: bytes,
    Name: Wvaˉtoken,
    Beforeˉoffset: u32
) -> bool {
    let Header: Wvaˉline = Readˉmeaningfulˉline(Input, 0u32, 1u32, 1u32);
    var Current: Wvaˉline = Readˉmeaningfulˉline(
        Input,
        Header.Nextˉcursor,
        Header.Nextˉline,
        Header.Nextˉcolumn
    );
    while Current.Present {
        if Current.Firstˉoffset >= Beforeˉoffset { return false; }
        let First: Wvaˉtoken = Lineˉtoken(Input, Current, 0u32);
        if Tokenˉequalsˉtext(Input, First, "define") {
            let Definitionˉname: Wvaˉtoken = Lineˉtoken(Input, Current, 1u32);
            if Spanˉequalsˉtoken(Input, Name.Offset, Name.Length, Definitionˉname) {
                return true;
            }
        }
        Current = Readˉmeaningfulˉline(
            Input,
            Current.Nextˉcursor,
            Current.Nextˉline,
            Current.Nextˉcolumn
        );
    }
    return false;
}

fn Findˉlocalˉlabel(
    Input: bytes,
    Definition: Wvaˉtoken,
    Nameˉoffset: u32,
    Nameˉlength: u32
) -> Wvaˉlocalˉlabelˉlookup {
    let Header: Wvaˉline = Readˉmeaningfulˉline(Input, 0u32, 1u32, 1u32);
    var Current: Wvaˉline = Readˉmeaningfulˉline(
        Input,
        Header.Nextˉcursor,
        Header.Nextˉline,
        Header.Nextˉcolumn
    );
    var Sectionˉkind: u32 = 0u32;
    var Wantedˉdefinition: bool = false;
    var Currentˉoffset: u32 = 0u32;
    var Count: u32 = 0u32;
    var Foundˉoffset: u32 = 0u32;
    while Current.Present {
        let First: Wvaˉtoken = Lineˉtoken(Input, Current, 0u32);
        if Tokenˉequalsˉtext(Input, First, "section") {
            Sectionˉkind = Sectionˉkindˉtag(Input, Lineˉtoken(Input, Current, 1u32));
        } else {
            if Tokenˉequalsˉtext(Input, First, "define") {
                let Definitionˉname: Wvaˉtoken = Lineˉtoken(Input, Current, 1u32);
                Wantedˉdefinition = Spansˉequal(
                    Input,
                    Definition.Offset,
                    Definition.Length,
                    Definitionˉname.Offset,
                    Definitionˉname.Length
                );
                Currentˉoffset = 0u32;
            } else {
                if Lineˉisˉend(Input, Current, "define") {
                    if Wantedˉdefinition { return Wvaˉlocalˉlabelˉlookup(Count, Foundˉoffset); }
                    Wantedˉdefinition = false;
                } else {
                    if Wantedˉdefinition {
                        let Statement: Wvaˉstatementˉcheck = Checkˉstatement(Input, Current, Sectionˉkind);
                        if Statement.Kind == 20u32 {
                            if Spansˉequal(
                                Input,
                                Nameˉoffset,
                                Nameˉlength,
                                Statement.Referenceˉoffset,
                                Statement.Referenceˉlength
                            ) {
                                Count = Count + 1u32;
                                if Count == 1u32 { Foundˉoffset = Currentˉoffset; }
                            }
                        }
                        Currentˉoffset = Currentˉoffset + Statement.Size;
                    }
                }
            }
        }
        Current = Readˉmeaningfulˉline(
            Input,
            Current.Nextˉcursor,
            Current.Nextˉline,
            Current.Nextˉcolumn
        );
    }
    return Wvaˉlocalˉlabelˉlookup(Count, Foundˉoffset);
}

fn Semanticˉfailureˉat(
    Base: Wvaˉsemanticˉinspection,
    Status: Wvaˉsemanticˉstatus,
    Offset: u32,
    Line: u32,
    Column: u32
) -> Wvaˉsemanticˉinspection {
    return Wvaˉsemanticˉinspection(
        Status,
        Base.Sections,
        Base.Symbols,
        Base.Definitions,
        Base.Relocations,
        Base.Dataˉbytes,
        Base.Memoryˉbytes,
        Offset,
        Line,
        Column
    );
}

fn Semanticˉfailure(
    Base: Wvaˉsemanticˉinspection,
    Status: Wvaˉsemanticˉstatus,
    Value: Wvaˉtoken
) -> Wvaˉsemanticˉinspection {
    return Semanticˉfailureˉat(Base, Status, Value.Offset, Value.Line, Value.Column);
}

fn Semanticˉprogress(
    Sections: u32,
    Symbols: u32,
    Definitions: u32,
    Relocations: u32,
    Dataˉbytes: u32,
    Memoryˉbytes: u32,
    Offset: u32,
    Line: u32,
    Column: u32
) -> Wvaˉsemanticˉinspection {
    return Wvaˉsemanticˉinspection(
        Wvaˉsemanticˉstatus.Valid,
        Sections,
        Symbols,
        Definitions,
        Relocations,
        Dataˉbytes,
        Memoryˉbytes,
        Offset,
        Line,
        Column
    );
}

fn Structuralˉfailure(
    Status: Wvaˉsemanticˉstatus,
    Value: Wvaˉtoken,
    Sections: u32,
    Symbols: u32,
    Definitions: u32,
    Relocations: u32,
    Dataˉbytes: u32,
    Memoryˉbytes: u32
) -> Wvaˉsemanticˉinspection {
    return Wvaˉsemanticˉinspection(
        Status,
        Sections,
        Symbols,
        Definitions,
        Relocations,
        Dataˉbytes,
        Memoryˉbytes,
        Value.Offset,
        Value.Line,
        Value.Column
    );
}

fn Inspectˉwvaˉsemantics(Input: bytes) -> Wvaˉsemanticˉinspection {
    let Scan: Wvaˉscan = Scanˉwva(Input);
    if Scan.Status != Wvaˉscanˉstatus.Valid {
        var Failureˉstatus: Wvaˉsemanticˉstatus = Wvaˉsemanticˉstatus.Wva1001;
        if Scan.Status == Wvaˉscanˉstatus.Sourceˉtooˉlarge {
            Failureˉstatus = Wvaˉsemanticˉstatus.Wva1011;
        }
        if Scan.Status == Wvaˉscanˉstatus.Lineˉtooˉlong {
            Failureˉstatus = Wvaˉsemanticˉstatus.Wva1011;
        }
        return Wvaˉsemanticˉinspection(
            Failureˉstatus,
            0u32,
            0u32,
            0u32,
            0u32,
            0u32,
            0u32,
            Scan.Failureˉoffset,
            Scan.Failureˉline,
            Scan.Failureˉcolumn
        );
    }

    let Headerˉline: Wvaˉline = Readˉmeaningfulˉline(Input, 0u32, 1u32, 1u32);
    var Current: Wvaˉline = Readˉmeaningfulˉline(
        Input,
        Headerˉline.Nextˉcursor,
        Headerˉline.Nextˉline,
        Headerˉline.Nextˉcolumn
    );
    var State: u32 = 0u32;
    var Sectionsˉstarted: bool = false;
    var Sectionˉcount: u32 = 0u32;
    var Symbolˉcount: u32 = 0u32;
    var Definitionˉcount: u32 = 0u32;
    var Relocationˉcount: u32 = 0u32;
    var Totalˉdata: u32 = 0u32;
    var Totalˉmemory: u32 = 0u32;
    var Sectionˉdata: u32 = 0u32;
    var Sectionˉmemory: u32 = 0u32;
    var Currentˉsectionˉkind: u32 = 0u32;
    var Currentˉsectionˉoffset: u32 = 0u32;
    var Currentˉsectionˉlength: u32 = 0u32;
    var Currentˉsectionˉline: u32 = 1u32;
    var Currentˉsectionˉcolumn: u32 = 1u32;
    var Currentˉdefinitionˉoffset: u32 = 0u32;
    var Currentˉdefinitionˉline: u32 = 1u32;
    var Currentˉdefinitionˉcolumn: u32 = 1u32;
    var Previousˉsymbolˉseen: bool = false;
    var Previousˉsymbolˉbinding: u32 = 0u32;
    var Previousˉsymbolˉoffset: u32 = 0u32;
    var Previousˉsymbolˉlength: u32 = 0u32;
    var Previousˉsectionˉseen: bool = false;
    var Previousˉsectionˉkind: u32 = 0u32;
    var Previousˉsectionˉoffset: u32 = 0u32;
    var Previousˉsectionˉlength: u32 = 0u32;

    while Current.Present {
        let First: Wvaˉtoken = Lineˉtoken(Input, Current, 0u32);
        if State == 0u32 {
            if Tokenˉequalsˉtext(Input, First, "symbol") {
                if Sectionsˉstarted {
                    return Structuralˉfailure(
                        Wvaˉsemanticˉstatus.Wva1002,
                        First,
                        Sectionˉcount,
                        Symbolˉcount,
                        Definitionˉcount,
                        Relocationˉcount,
                        Totalˉdata,
                        Totalˉmemory
                    );
                }
                if Current.Tokens < 4u32 {
                    return Structuralˉfailure(
                        Wvaˉsemanticˉstatus.Wva1003,
                        First,
                        Sectionˉcount,
                        Symbolˉcount,
                        Definitionˉcount,
                        Relocationˉcount,
                        Totalˉdata,
                        Totalˉmemory
                    );
                }
                let Symbolˉbindingˉtoken: Wvaˉtoken = Lineˉtoken(Input, Current, 1u32);
                let Symbolˉkindˉtoken: Wvaˉtoken = Lineˉtoken(Input, Current, 2u32);
                let Symbolˉnameˉtoken: Wvaˉtoken = Lineˉtoken(Input, Current, 3u32);
                let Symbolˉbinding: u32 = Bindingˉtag(Input, Symbolˉbindingˉtoken);
                let Symbolˉkind: u32 = Symbolˉkindˉtag(Input, Symbolˉkindˉtoken);
                if Symbolˉbinding == 0u32 {
                    return Structuralˉfailure(
                        Wvaˉsemanticˉstatus.Wva1002,
                        Symbolˉbindingˉtoken,
                        Sectionˉcount,
                        Symbolˉcount,
                        Definitionˉcount,
                        Relocationˉcount,
                        Totalˉdata,
                        Totalˉmemory
                    );
                }
                if Symbolˉkind == 0u32 {
                    return Structuralˉfailure(
                        Wvaˉsemanticˉstatus.Wva1002,
                        Symbolˉkindˉtoken,
                        Sectionˉcount,
                        Symbolˉcount,
                        Definitionˉcount,
                        Relocationˉcount,
                        Totalˉdata,
                        Totalˉmemory
                    );
                }
                if !Machineˉnameˉisˉvalid(Input, Symbolˉnameˉtoken) {
                    return Structuralˉfailure(
                        Wvaˉsemanticˉstatus.Wva1004,
                        Symbolˉnameˉtoken,
                        Sectionˉcount,
                        Symbolˉcount,
                        Definitionˉcount,
                        Relocationˉcount,
                        Totalˉdata,
                        Totalˉmemory
                    );
                }
                if Symbolˉbinding == 3u32 {
                    if Current.Tokens != 4u32 {
                        return Structuralˉfailure(
                            Wvaˉsemanticˉstatus.Wva1003,
                            First,
                            Sectionˉcount,
                            Symbolˉcount,
                            Definitionˉcount,
                            Relocationˉcount,
                            Totalˉdata,
                            Totalˉmemory
                        );
                    }
                } else {
                    if Current.Tokens != 6u32 {
                        return Structuralˉfailure(
                            Wvaˉsemanticˉstatus.Wva1003,
                            First,
                            Sectionˉcount,
                            Symbolˉcount,
                            Definitionˉcount,
                            Relocationˉcount,
                            Totalˉdata,
                            Totalˉmemory
                        );
                    }
                    let Inˉtoken: Wvaˉtoken = Lineˉtoken(Input, Current, 4u32);
                    let Symbolˉsectionˉtoken: Wvaˉtoken = Lineˉtoken(Input, Current, 5u32);
                    if !Tokenˉequalsˉtext(Input, Inˉtoken, "in") {
                        return Structuralˉfailure(
                            Wvaˉsemanticˉstatus.Wva1003,
                            First,
                            Sectionˉcount,
                            Symbolˉcount,
                            Definitionˉcount,
                            Relocationˉcount,
                            Totalˉdata,
                            Totalˉmemory
                        );
                    }
                    if !Machineˉnameˉisˉvalid(Input, Symbolˉsectionˉtoken) {
                        return Structuralˉfailure(
                            Wvaˉsemanticˉstatus.Wva1004,
                            Symbolˉsectionˉtoken,
                            Sectionˉcount,
                            Symbolˉcount,
                            Definitionˉcount,
                            Relocationˉcount,
                            Totalˉdata,
                            Totalˉmemory
                        );
                    }
                }
                if Previousˉsymbolˉseen {
                    if Symbolˉbinding < Previousˉsymbolˉbinding {
                        return Structuralˉfailure(
                            Wvaˉsemanticˉstatus.Wva1006,
                            Symbolˉnameˉtoken,
                            Sectionˉcount,
                            Symbolˉcount,
                            Definitionˉcount,
                            Relocationˉcount,
                            Totalˉdata,
                            Totalˉmemory
                        );
                    }
                    if Symbolˉbinding == Previousˉsymbolˉbinding {
                        if Compareˉspans(
                            Input,
                            Previousˉsymbolˉoffset,
                            Previousˉsymbolˉlength,
                            Symbolˉnameˉtoken.Offset,
                            Symbolˉnameˉtoken.Length
                        ) >= 0 {
                            return Structuralˉfailure(
                                Wvaˉsemanticˉstatus.Wva1006,
                                Symbolˉnameˉtoken,
                                Sectionˉcount,
                                Symbolˉcount,
                                Definitionˉcount,
                                Relocationˉcount,
                                Totalˉdata,
                                Totalˉmemory
                            );
                        }
                    }
                }
                Symbolˉcount = Symbolˉcount + 1u32;
                if Symbolˉcount > 4096u32 {
                    return Structuralˉfailure(
                        Wvaˉsemanticˉstatus.Wva1011,
                        Symbolˉnameˉtoken,
                        Sectionˉcount,
                        Symbolˉcount,
                        Definitionˉcount,
                        Relocationˉcount,
                        Totalˉdata,
                        Totalˉmemory
                    );
                }
                Previousˉsymbolˉseen = true;
                Previousˉsymbolˉbinding = Symbolˉbinding;
                Previousˉsymbolˉoffset = Symbolˉnameˉtoken.Offset;
                Previousˉsymbolˉlength = Symbolˉnameˉtoken.Length;
            } else {
                if Tokenˉequalsˉtext(Input, First, "section") {
                    Sectionsˉstarted = true;
                    if Current.Tokens != 5u32 {
                        return Structuralˉfailure(
                            Wvaˉsemanticˉstatus.Wva1003,
                            First,
                            Sectionˉcount,
                            Symbolˉcount,
                            Definitionˉcount,
                            Relocationˉcount,
                            Totalˉdata,
                            Totalˉmemory
                        );
                    }
                    let Sectionˉkindˉtoken: Wvaˉtoken = Lineˉtoken(Input, Current, 1u32);
                    let Sectionˉnameˉtoken: Wvaˉtoken = Lineˉtoken(Input, Current, 2u32);
                    let Alignˉtoken: Wvaˉtoken = Lineˉtoken(Input, Current, 3u32);
                    let Alignmentˉtoken: Wvaˉtoken = Lineˉtoken(Input, Current, 4u32);
                    let Sectionˉkind: u32 = Sectionˉkindˉtag(Input, Sectionˉkindˉtoken);
                    if Sectionˉkind == 0u32 {
                        return Structuralˉfailure(
                            Wvaˉsemanticˉstatus.Wva1002,
                            Sectionˉkindˉtoken,
                            Sectionˉcount,
                            Symbolˉcount,
                            Definitionˉcount,
                            Relocationˉcount,
                            Totalˉdata,
                            Totalˉmemory
                        );
                    }
                    if !Machineˉnameˉisˉvalid(Input, Sectionˉnameˉtoken) {
                        return Structuralˉfailure(
                            Wvaˉsemanticˉstatus.Wva1004,
                            Sectionˉnameˉtoken,
                            Sectionˉcount,
                            Symbolˉcount,
                            Definitionˉcount,
                            Relocationˉcount,
                            Totalˉdata,
                            Totalˉmemory
                        );
                    }
                    if !Tokenˉequalsˉtext(Input, Alignˉtoken, "align") {
                        return Structuralˉfailure(
                            Wvaˉsemanticˉstatus.Wva1003,
                            First,
                            Sectionˉcount,
                            Symbolˉcount,
                            Definitionˉcount,
                            Relocationˉcount,
                            Totalˉdata,
                            Totalˉmemory
                        );
                    }
                    let Alignment: Foundationˉu32ˉparse = Parseˉu32(Input, Alignmentˉtoken);
                    if !Alignment.Valid {
                        return Structuralˉfailure(
                            Wvaˉsemanticˉstatus.Wva1005,
                            Alignmentˉtoken,
                            Sectionˉcount,
                            Symbolˉcount,
                            Definitionˉcount,
                            Relocationˉcount,
                            Totalˉdata,
                            Totalˉmemory
                        );
                    }
                    if !Foundationˉalignmentˉisˉvalid(Alignment.Value) {
                        return Structuralˉfailure(
                            Wvaˉsemanticˉstatus.Wva1005,
                            Alignmentˉtoken,
                            Sectionˉcount,
                            Symbolˉcount,
                            Definitionˉcount,
                            Relocationˉcount,
                            Totalˉdata,
                            Totalˉmemory
                        );
                    }
                    if Previousˉsectionˉseen {
                        if Sectionˉkind < Previousˉsectionˉkind {
                            return Structuralˉfailure(
                                Wvaˉsemanticˉstatus.Wva1006,
                                Sectionˉnameˉtoken,
                                Sectionˉcount,
                                Symbolˉcount,
                                Definitionˉcount,
                                Relocationˉcount,
                                Totalˉdata,
                                Totalˉmemory
                            );
                        }
                        if Sectionˉkind == Previousˉsectionˉkind {
                            if Compareˉspans(
                                Input,
                                Previousˉsectionˉoffset,
                                Previousˉsectionˉlength,
                                Sectionˉnameˉtoken.Offset,
                                Sectionˉnameˉtoken.Length
                            ) >= 0 {
                                return Structuralˉfailure(
                                    Wvaˉsemanticˉstatus.Wva1006,
                                    Sectionˉnameˉtoken,
                                    Sectionˉcount,
                                    Symbolˉcount,
                                    Definitionˉcount,
                                    Relocationˉcount,
                                    Totalˉdata,
                                    Totalˉmemory
                                );
                            }
                        }
                    }
                    if Sectionˉcount >= 64u32 {
                        return Structuralˉfailure(
                            Wvaˉsemanticˉstatus.Wva1011,
                            Sectionˉnameˉtoken,
                            Sectionˉcount,
                            Symbolˉcount,
                            Definitionˉcount,
                            Relocationˉcount,
                            Totalˉdata,
                            Totalˉmemory
                        );
                    }
                    Sectionˉcount = Sectionˉcount + 1u32;
                    Previousˉsectionˉseen = true;
                    Previousˉsectionˉkind = Sectionˉkind;
                    Previousˉsectionˉoffset = Sectionˉnameˉtoken.Offset;
                    Previousˉsectionˉlength = Sectionˉnameˉtoken.Length;
                    Currentˉsectionˉkind = Sectionˉkind;
                    Currentˉsectionˉoffset = Sectionˉnameˉtoken.Offset;
                    Currentˉsectionˉlength = Sectionˉnameˉtoken.Length;
                    Currentˉsectionˉline = Sectionˉnameˉtoken.Line;
                    Currentˉsectionˉcolumn = Sectionˉnameˉtoken.Column;
                    Sectionˉdata = 0u32;
                    Sectionˉmemory = 0u32;
                    State = 1u32;
                } else {
                    return Structuralˉfailure(
                        Wvaˉsemanticˉstatus.Wva1002,
                        First,
                        Sectionˉcount,
                        Symbolˉcount,
                        Definitionˉcount,
                        Relocationˉcount,
                        Totalˉdata,
                        Totalˉmemory
                    );
                }
            }
        } else {
            if State == 1u32 {
                if Tokenˉequalsˉtext(Input, First, "define") {
                    if Current.Tokens != 2u32 {
                        return Structuralˉfailure(
                            Wvaˉsemanticˉstatus.Wva1003,
                            First,
                            Sectionˉcount,
                            Symbolˉcount,
                            Definitionˉcount,
                            Relocationˉcount,
                            Totalˉdata,
                            Totalˉmemory
                        );
                    }
                    let Definitionˉnameˉtoken: Wvaˉtoken = Lineˉtoken(Input, Current, 1u32);
                    if !Machineˉnameˉisˉvalid(Input, Definitionˉnameˉtoken) {
                        return Structuralˉfailure(
                            Wvaˉsemanticˉstatus.Wva1004,
                            Definitionˉnameˉtoken,
                            Sectionˉcount,
                            Symbolˉcount,
                            Definitionˉcount,
                            Relocationˉcount,
                            Totalˉdata,
                            Totalˉmemory
                        );
                    }
                    Definitionˉcount = Definitionˉcount + 1u32;
                    Currentˉdefinitionˉoffset = Definitionˉnameˉtoken.Offset;
                    Currentˉdefinitionˉline = Definitionˉnameˉtoken.Line;
                    Currentˉdefinitionˉcolumn = Definitionˉnameˉtoken.Column;
                    State = 2u32;
                } else {
                    var Endsˉsection: bool = false;
                    if Current.Tokens == 2u32 {
                        if Tokenˉequalsˉtext(Input, First, "end") {
                            if Tokenˉequalsˉtext(Input, Lineˉtoken(Input, Current, 1u32), "section") {
                                Endsˉsection = true;
                            }
                        }
                    }
                    if !Endsˉsection {
                        return Structuralˉfailure(
                            Wvaˉsemanticˉstatus.Wva1002,
                            First,
                            Sectionˉcount,
                            Symbolˉcount,
                            Definitionˉcount,
                            Relocationˉcount,
                            Totalˉdata,
                            Totalˉmemory
                        );
                    }
                    if Sectionˉmemory > 16777216u32 - Totalˉmemory {
                        return Structuralˉfailure(
                            Wvaˉsemanticˉstatus.Wva1011,
                            First,
                            Sectionˉcount,
                            Symbolˉcount,
                            Definitionˉcount,
                            Relocationˉcount,
                            Totalˉdata,
                            Totalˉmemory
                        );
                    }
                    if Sectionˉdata > 4194304u32 - Totalˉdata {
                        return Structuralˉfailure(
                            Wvaˉsemanticˉstatus.Wva1011,
                            First,
                            Sectionˉcount,
                            Symbolˉcount,
                            Definitionˉcount,
                            Relocationˉcount,
                            Totalˉdata,
                            Totalˉmemory
                        );
                    }
                    Totalˉmemory = Totalˉmemory + Sectionˉmemory;
                    Totalˉdata = Totalˉdata + Sectionˉdata;
                    State = 0u32;
                }
            } else {
                var Endsˉdefinition: bool = false;
                if Current.Tokens == 2u32 {
                    if Tokenˉequalsˉtext(Input, First, "end") {
                        if Tokenˉequalsˉtext(Input, Lineˉtoken(Input, Current, 1u32), "define") {
                            Endsˉdefinition = true;
                        }
                    }
                }
                if Endsˉdefinition {
                    State = 1u32;
                } else {
                    let Statement: Wvaˉstatementˉcheck = Checkˉstatement(Input, Current, Currentˉsectionˉkind);
                    if Statement.Status != Wvaˉsemanticˉstatus.Valid {
                        return Wvaˉsemanticˉinspection(
                            Statement.Status,
                            Sectionˉcount,
                            Symbolˉcount,
                            Definitionˉcount,
                            Relocationˉcount,
                            Totalˉdata,
                            Totalˉmemory,
                            Statement.Failureˉoffset,
                            Statement.Failureˉline,
                            Statement.Failureˉcolumn
                        );
                    }
                    if Statement.Size > 16777216u32 - Sectionˉmemory {
                        return Structuralˉfailure(
                            Wvaˉsemanticˉstatus.Wva1011,
                            First,
                            Sectionˉcount,
                            Symbolˉcount,
                            Definitionˉcount,
                            Relocationˉcount,
                            Totalˉdata,
                            Totalˉmemory
                        );
                    }
                    Sectionˉmemory = Sectionˉmemory + Statement.Size;
                    if Currentˉsectionˉkind != 4u32 {
                        if Statement.Size > 4194304u32 - Sectionˉdata {
                            return Structuralˉfailure(
                                Wvaˉsemanticˉstatus.Wva1011,
                                First,
                                Sectionˉcount,
                                Symbolˉcount,
                                Definitionˉcount,
                                Relocationˉcount,
                                Totalˉdata,
                                Totalˉmemory
                            );
                        }
                        Sectionˉdata = Sectionˉdata + Statement.Size;
                    }
                    if Statement.Hasˉreference {
                        Relocationˉcount = Relocationˉcount + 1u32;
                        if Relocationˉcount > 65536u32 {
                            return Structuralˉfailure(
                                Wvaˉsemanticˉstatus.Wva1011,
                                First,
                                Sectionˉcount,
                                Symbolˉcount,
                                Definitionˉcount,
                                Relocationˉcount,
                                Totalˉdata,
                                Totalˉmemory
                            );
                        }
                    }
                }
            }
        }

        Current = Readˉmeaningfulˉline(
            Input,
            Current.Nextˉcursor,
            Current.Nextˉline,
            Current.Nextˉcolumn
        );
    }

    let Progress: Wvaˉsemanticˉinspection = Semanticˉprogress(
        Sectionˉcount,
        Symbolˉcount,
        Definitionˉcount,
        Relocationˉcount,
        Totalˉdata,
        Totalˉmemory,
        Bytesˉlength(Input),
        Current.Line,
        Current.Column
    );
    if State == 2u32 {
        return Semanticˉfailureˉat(
            Progress,
            Wvaˉsemanticˉstatus.Wva1010,
            Currentˉdefinitionˉoffset,
            Currentˉdefinitionˉline,
            Currentˉdefinitionˉcolumn
        );
    }
    if State == 1u32 {
        return Semanticˉfailureˉat(
            Progress,
            Wvaˉsemanticˉstatus.Wva1010,
            Currentˉsectionˉoffset,
            Currentˉsectionˉline,
            Currentˉsectionˉcolumn
        );
    }
    if Sectionˉcount == 0u32 {
        return Semanticˉfailureˉat(Progress, Wvaˉsemanticˉstatus.Wva1007, 0u32, 1u32, 1u32);
    }
    return Validateˉwvaˉsemantics(Input, Progress);
}

fn Validateˉwvaˉsemantics(
    Input: bytes,
    Base: Wvaˉsemanticˉinspection
) -> Wvaˉsemanticˉinspection {
    let Header: Wvaˉline = Readˉmeaningfulˉline(Input, 0u32, 1u32, 1u32);
    var Uniqueˉcurrent: Wvaˉline = Readˉmeaningfulˉline(
        Input,
        Header.Nextˉcursor,
        Header.Nextˉline,
        Header.Nextˉcolumn
    );
    while Uniqueˉcurrent.Present {
        let Uniqueˉfirst: Wvaˉtoken = Lineˉtoken(Input, Uniqueˉcurrent, 0u32);
        if Tokenˉequalsˉtext(Input, Uniqueˉfirst, "symbol") {
            let Uniqueˉsymbolˉname: Wvaˉtoken = Lineˉtoken(Input, Uniqueˉcurrent, 3u32);
            if Countˉsymbolˉdeclarations(Input, Uniqueˉsymbolˉname) > 1u32 {
                return Semanticˉfailure(Base, Wvaˉsemanticˉstatus.Wva1006, Uniqueˉsymbolˉname);
            }
        }
        if Tokenˉequalsˉtext(Input, Uniqueˉfirst, "section") {
            let Uniqueˉsectionˉname: Wvaˉtoken = Lineˉtoken(Input, Uniqueˉcurrent, 2u32);
            if Countˉsectionˉdeclarations(Input, Uniqueˉsectionˉname) > 1u32 {
                return Semanticˉfailure(Base, Wvaˉsemanticˉstatus.Wva1006, Uniqueˉsectionˉname);
            }
        }
        Uniqueˉcurrent = Readˉmeaningfulˉline(
            Input,
            Uniqueˉcurrent.Nextˉcursor,
            Uniqueˉcurrent.Nextˉline,
            Uniqueˉcurrent.Nextˉcolumn
        );
    }

    var Symbolˉcurrent: Wvaˉline = Readˉmeaningfulˉline(
        Input,
        Header.Nextˉcursor,
        Header.Nextˉline,
        Header.Nextˉcolumn
    );
    while Symbolˉcurrent.Present {
        let Symbolˉfirst: Wvaˉtoken = Lineˉtoken(Input, Symbolˉcurrent, 0u32);
        if Tokenˉequalsˉtext(Input, Symbolˉfirst, "section") {
            Symbolˉcurrent = Wvaˉline(
                false,
                Symbolˉcurrent.Firstˉoffset,
                Symbolˉcurrent.Line,
                Symbolˉcurrent.Column,
                0u32,
                Symbolˉcurrent.Nextˉcursor,
                Symbolˉcurrent.Nextˉline,
                Symbolˉcurrent.Nextˉcolumn
            );
        } else {
            let Symbolˉbindingˉvalue: u32 = Bindingˉtag(
                Input,
                Lineˉtoken(Input, Symbolˉcurrent, 1u32)
            );
            if Symbolˉbindingˉvalue != 3u32 {
                let Symbolˉkindˉvalue: u32 = Symbolˉkindˉtag(
                    Input,
                    Lineˉtoken(Input, Symbolˉcurrent, 2u32)
                );
                let Symbolˉnameˉvalue: Wvaˉtoken = Lineˉtoken(Input, Symbolˉcurrent, 3u32);
                let Symbolˉsectionˉvalue: Wvaˉtoken = Lineˉtoken(Input, Symbolˉcurrent, 5u32);
                let Declaredˉsection: Wvaˉsectionˉlookup = Findˉsection(
                    Input,
                    Symbolˉsectionˉvalue.Offset,
                    Symbolˉsectionˉvalue.Length
                );
                if !Declaredˉsection.Found {
                    return Semanticˉfailure(Base, Wvaˉsemanticˉstatus.Wva1007, Symbolˉnameˉvalue);
                }
                if Symbolˉkindˉvalue == 1u32 {
                    if Declaredˉsection.Kind != 1u32 {
                        return Semanticˉfailure(Base, Wvaˉsemanticˉstatus.Wva1007, Symbolˉnameˉvalue);
                    }
                } else {
                    if Declaredˉsection.Kind == 1u32 {
                        return Semanticˉfailure(Base, Wvaˉsemanticˉstatus.Wva1007, Symbolˉnameˉvalue);
                    }
                }
            }
            Symbolˉcurrent = Readˉmeaningfulˉline(
                Input,
                Symbolˉcurrent.Nextˉcursor,
                Symbolˉcurrent.Nextˉline,
                Symbolˉcurrent.Nextˉcolumn
            );
        }
    }

    var Bodyˉcurrent: Wvaˉline = Readˉmeaningfulˉline(
        Input,
        Header.Nextˉcursor,
        Header.Nextˉline,
        Header.Nextˉcolumn
    );
    var Bodyˉsectionˉoffset: u32 = 0u32;
    var Bodyˉsectionˉlength: u32 = 0u32;
    var Bodyˉsectionˉkind: u32 = 0u32;
    var Bodyˉdefinitionˉname: Wvaˉtoken = Lineˉtoken(Input, Header, 0u32);
    var Insideˉdefinition: bool = false;
    while Bodyˉcurrent.Present {
        let Bodyˉfirst: Wvaˉtoken = Lineˉtoken(Input, Bodyˉcurrent, 0u32);
        if Tokenˉequalsˉtext(Input, Bodyˉfirst, "section") {
            let Bodyˉsectionˉname: Wvaˉtoken = Lineˉtoken(Input, Bodyˉcurrent, 2u32);
            Bodyˉsectionˉoffset = Bodyˉsectionˉname.Offset;
            Bodyˉsectionˉlength = Bodyˉsectionˉname.Length;
            Bodyˉsectionˉkind = Sectionˉkindˉtag(Input, Lineˉtoken(Input, Bodyˉcurrent, 1u32));
        } else {
            if Tokenˉequalsˉtext(Input, Bodyˉfirst, "define") {
                let Currentˉdefinitionˉname: Wvaˉtoken = Lineˉtoken(Input, Bodyˉcurrent, 1u32);
                Bodyˉdefinitionˉname = Currentˉdefinitionˉname;
                let Definitionˉsymbol: Wvaˉsymbolˉlookup = Findˉsymbol(
                    Input,
                    Currentˉdefinitionˉname.Offset,
                    Currentˉdefinitionˉname.Length
                );
                if !Definitionˉsymbol.Found {
                    return Semanticˉfailure(Base, Wvaˉsemanticˉstatus.Wva1009, Currentˉdefinitionˉname);
                }
                if Definitionˉsymbol.Binding == 3u32 {
                    return Semanticˉfailure(Base, Wvaˉsemanticˉstatus.Wva1007, Currentˉdefinitionˉname);
                }
                if !Spansˉequal(
                    Input,
                    Definitionˉsymbol.Sectionˉoffset,
                    Definitionˉsymbol.Sectionˉlength,
                    Bodyˉsectionˉoffset,
                    Bodyˉsectionˉlength
                ) {
                    return Semanticˉfailure(Base, Wvaˉsemanticˉstatus.Wva1007, Currentˉdefinitionˉname);
                }
                if Definitionˉwasˉseen(Input, Currentˉdefinitionˉname, Bodyˉcurrent.Firstˉoffset) {
                    return Semanticˉfailure(Base, Wvaˉsemanticˉstatus.Wva1006, Currentˉdefinitionˉname);
                }
                Insideˉdefinition = true;
            } else {
                var Bodyˉendsˉdefinition: bool = false;
                if Bodyˉcurrent.Tokens == 2u32 {
                    if Tokenˉequalsˉtext(Input, Bodyˉfirst, "end") {
                        if Tokenˉequalsˉtext(Input, Lineˉtoken(Input, Bodyˉcurrent, 1u32), "define") {
                            Bodyˉendsˉdefinition = true;
                        }
                    }
                }
                if Bodyˉendsˉdefinition {
                    Insideˉdefinition = false;
                } else {
                    if Insideˉdefinition {
                        let Bodyˉstatement: Wvaˉstatementˉcheck = Checkˉstatement(
                            Input,
                            Bodyˉcurrent,
                            Bodyˉsectionˉkind
                        );
                        if Bodyˉstatement.Kind == 20u32 {
                            let Labelˉdefinition: Wvaˉlocalˉlabelˉlookup = Findˉlocalˉlabel(
                                Input,
                                Bodyˉdefinitionˉname,
                                Bodyˉstatement.Referenceˉoffset,
                                Bodyˉstatement.Referenceˉlength
                            );
                            if Labelˉdefinition.Count != 1u32 {
                                return Semanticˉfailure(Base, Wvaˉsemanticˉstatus.Wva1006, Bodyˉfirst);
                            }
                        }
                        if Bodyˉstatement.Kind == 21u32 {
                            let Jumpˉlabel: Wvaˉlocalˉlabelˉlookup = Findˉlocalˉlabel(
                                Input,
                                Bodyˉdefinitionˉname,
                                Bodyˉstatement.Referenceˉoffset,
                                Bodyˉstatement.Referenceˉlength
                            );
                            if Jumpˉlabel.Count != 1u32 {
                                return Semanticˉfailure(Base, Wvaˉsemanticˉstatus.Wva1009, Bodyˉfirst);
                            }
                        }
                        if Bodyˉstatement.Kind == 22u32 {
                            let Branchˉlabel: Wvaˉlocalˉlabelˉlookup = Findˉlocalˉlabel(
                                Input,
                                Bodyˉdefinitionˉname,
                                Bodyˉstatement.Referenceˉoffset,
                                Bodyˉstatement.Referenceˉlength
                            );
                            if Branchˉlabel.Count != 1u32 {
                                return Semanticˉfailure(Base, Wvaˉsemanticˉstatus.Wva1009, Bodyˉfirst);
                            }
                        }
                        if Bodyˉstatement.Hasˉreference {
                            let Referenceˉsymbol: Wvaˉsymbolˉlookup = Findˉsymbol(
                                Input,
                                Bodyˉstatement.Referenceˉoffset,
                                Bodyˉstatement.Referenceˉlength
                            );
                            if !Referenceˉsymbol.Found {
                                return Semanticˉfailure(Base, Wvaˉsemanticˉstatus.Wva1009, Bodyˉfirst);
                            }
                            if Bodyˉstatement.Kind == 4u32 {
                                if Referenceˉsymbol.Kind != 1u32 {
                                    return Semanticˉfailure(Base, Wvaˉsemanticˉstatus.Wva1009, Bodyˉfirst);
                                }
                            }
                            if Bodyˉstatement.Kind == 5u32 {
                                if Referenceˉsymbol.Kind != 1u32 {
                                    return Semanticˉfailure(Base, Wvaˉsemanticˉstatus.Wva1009, Bodyˉfirst);
                                }
                            }
                            if Bodyˉstatement.Kind >= 35u32 {
                                if Bodyˉstatement.Kind <= 38u32 {
                                    if Referenceˉsymbol.Kind != 2u32 {
                                        return Semanticˉfailure(Base, Wvaˉsemanticˉstatus.Wva1009, Bodyˉfirst);
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        Bodyˉcurrent = Readˉmeaningfulˉline(
            Input,
            Bodyˉcurrent.Nextˉcursor,
            Bodyˉcurrent.Nextˉline,
            Bodyˉcurrent.Nextˉcolumn
        );
    }

    var Missingˉcurrent: Wvaˉline = Readˉmeaningfulˉline(
        Input,
        Header.Nextˉcursor,
        Header.Nextˉline,
        Header.Nextˉcolumn
    );
    while Missingˉcurrent.Present {
        let Missingˉfirst: Wvaˉtoken = Lineˉtoken(Input, Missingˉcurrent, 0u32);
        if Tokenˉequalsˉtext(Input, Missingˉfirst, "section") {
            Missingˉcurrent = Wvaˉline(
                false,
                Missingˉcurrent.Firstˉoffset,
                Missingˉcurrent.Line,
                Missingˉcurrent.Column,
                0u32,
                Missingˉcurrent.Nextˉcursor,
                Missingˉcurrent.Nextˉline,
                Missingˉcurrent.Nextˉcolumn
            );
        } else {
            let Missingˉbinding: u32 = Bindingˉtag(Input, Lineˉtoken(Input, Missingˉcurrent, 1u32));
            if Missingˉbinding != 3u32 {
                let Missingˉname: Wvaˉtoken = Lineˉtoken(Input, Missingˉcurrent, 3u32);
                let Definitions: Wvaˉdefinitionˉlookup = Findˉdefinitions(Input, Missingˉname);
                if Definitions.Count == 0u32 {
                    return Semanticˉfailure(Base, Wvaˉsemanticˉstatus.Wva1009, Missingˉname);
                }
            }
            Missingˉcurrent = Readˉmeaningfulˉline(
                Input,
                Missingˉcurrent.Nextˉcursor,
                Missingˉcurrent.Nextˉline,
                Missingˉcurrent.Nextˉcolumn
            );
        }
    }
    return Base;
}

fn Appendˉbytes(Left: bytes, Right: bytes) -> bytes {
    return Bytesˉconcat(Left, Right);
}

fn Singleˉbyte(Value: u32) -> bytes {
    return Bytesˉslice(Byteˉvalues, Value, 1u32);
}

fn Lineˉisˉend(Input: bytes, Value: Wvaˉline, Expected: text) -> bool {
    if Value.Tokens != 2u32 { return false; }
    if !Tokenˉequalsˉtext(Input, Lineˉtoken(Input, Value, 0u32), "end") { return false; }
    return Tokenˉequalsˉtext(Input, Lineˉtoken(Input, Value, 1u32), Expected);
}

fn Measureˉwvo(Input: bytes, Semantics: Wvaˉsemanticˉinspection) -> Wvaˉobjectˉsize {
    var Total: u32 = 24u32 + Semantics.Relocations * 20u32;
    if Total > 4194304u32 {
        return Wvaˉobjectˉsize(false, Total, 0u32, 1u32, 1u32);
    }

    let Header: Wvaˉline = Readˉmeaningfulˉline(Input, 0u32, 1u32, 1u32);
    var Current: Wvaˉline = Readˉmeaningfulˉline(
        Input,
        Header.Nextˉcursor,
        Header.Nextˉline,
        Header.Nextˉcolumn
    );
    var Currentˉsectionˉkind: u32 = 0u32;
    var Insideˉdefinition: bool = false;
    while Current.Present {
        let First: Wvaˉtoken = Lineˉtoken(Input, Current, 0u32);
        var Amount: u32 = 0u32;
        if Tokenˉequalsˉtext(Input, First, "symbol") {
            let Symbolˉname: Wvaˉtoken = Lineˉtoken(Input, Current, 3u32);
            Amount = 20u32 + Symbolˉname.Length;
        } else {
            if Tokenˉequalsˉtext(Input, First, "section") {
                Currentˉsectionˉkind = Sectionˉkindˉtag(Input, Lineˉtoken(Input, Current, 1u32));
                let Sectionˉname: Wvaˉtoken = Lineˉtoken(Input, Current, 2u32);
                Amount = 20u32 + Sectionˉname.Length;
            } else {
                if Tokenˉequalsˉtext(Input, First, "define") {
                    Insideˉdefinition = true;
                } else {
                    if Lineˉisˉend(Input, Current, "define") {
                        Insideˉdefinition = false;
                    } else {
                        if Insideˉdefinition {
                            let Statement: Wvaˉstatementˉcheck = Checkˉstatement(
                                Input,
                                Current,
                                Currentˉsectionˉkind
                            );
                            if Currentˉsectionˉkind != 4u32 { Amount = Statement.Size; }
                        }
                    }
                }
            }
        }
        if Amount > 4194304u32 - Total {
            return Wvaˉobjectˉsize(false, Total, First.Offset, First.Line, First.Column);
        }
        Total = Total + Amount;
        Current = Readˉmeaningfulˉline(
            Input,
            Current.Nextˉcursor,
            Current.Nextˉline,
            Current.Nextˉcolumn
        );
    }
    return Wvaˉobjectˉsize(true, Total, Bytesˉlength(Input), Current.Line, Current.Column);
}

fn Encodeˉname(Input: bytes, Name: Wvaˉtoken) -> bytes {
    let Prefix: bytes = Bytesˉfromˉu32ˉlittle(Name.Length);
    return Appendˉbytes(Prefix, Bytesˉslice(Input, Name.Offset, Name.Length));
}

fn Encodeˉwvoˉheader(
    Sectionˉcount: u32,
    Symbolˉcount: u32,
    Relocationˉcount: u32
) -> bytes {
    var Result: bytes = Textˉtoˉutf8("WVO1");
    Result = Appendˉbytes(Result, Bytesˉfromˉu16ˉlittle(1u32));
    Result = Appendˉbytes(Result, Bytesˉfromˉu16ˉlittle(0u32));
    Result = Appendˉbytes(Result, Singleˉbyte(1u32));
    Result = Appendˉbytes(Result, Singleˉbyte(0u32));
    Result = Appendˉbytes(Result, Bytesˉfromˉu16ˉlittle(0u32));
    Result = Appendˉbytes(Result, Bytesˉfromˉu32ˉlittle(Sectionˉcount));
    Result = Appendˉbytes(Result, Bytesˉfromˉu32ˉlittle(Symbolˉcount));
    return Appendˉbytes(Result, Bytesˉfromˉu32ˉlittle(Relocationˉcount));
}

fn Registerˉindex(Input: bytes, Value: Wvaˉtoken) -> u32 {
    if Tokenˉequalsˉtext(Input, Value, "al") { return 0u32; }
    if Tokenˉequalsˉtext(Input, Value, "ax") { return 0u32; }
    if Tokenˉequalsˉtext(Input, Value, "eax") { return 0u32; }
    if Tokenˉequalsˉtext(Input, Value, "rax") { return 0u32; }
    if Tokenˉequalsˉtext(Input, Value, "cl") { return 1u32; }
    if Tokenˉequalsˉtext(Input, Value, "cx") { return 1u32; }
    if Tokenˉequalsˉtext(Input, Value, "ecx") { return 1u32; }
    if Tokenˉequalsˉtext(Input, Value, "rcx") { return 1u32; }
    if Tokenˉequalsˉtext(Input, Value, "dl") { return 2u32; }
    if Tokenˉequalsˉtext(Input, Value, "dx") { return 2u32; }
    if Tokenˉequalsˉtext(Input, Value, "edx") { return 2u32; }
    if Tokenˉequalsˉtext(Input, Value, "rdx") { return 2u32; }
    if Tokenˉequalsˉtext(Input, Value, "bl") { return 3u32; }
    if Tokenˉequalsˉtext(Input, Value, "bx") { return 3u32; }
    if Tokenˉequalsˉtext(Input, Value, "ebx") { return 3u32; }
    if Tokenˉequalsˉtext(Input, Value, "rbx") { return 3u32; }
    if Tokenˉequalsˉtext(Input, Value, "spl") { return 4u32; }
    if Tokenˉequalsˉtext(Input, Value, "sp") { return 4u32; }
    if Tokenˉequalsˉtext(Input, Value, "esp") { return 4u32; }
    if Tokenˉequalsˉtext(Input, Value, "rsp") { return 4u32; }
    if Tokenˉequalsˉtext(Input, Value, "bpl") { return 5u32; }
    if Tokenˉequalsˉtext(Input, Value, "bp") { return 5u32; }
    if Tokenˉequalsˉtext(Input, Value, "ebp") { return 5u32; }
    if Tokenˉequalsˉtext(Input, Value, "rbp") { return 5u32; }
    if Tokenˉequalsˉtext(Input, Value, "sil") { return 6u32; }
    if Tokenˉequalsˉtext(Input, Value, "si") { return 6u32; }
    if Tokenˉequalsˉtext(Input, Value, "esi") { return 6u32; }
    if Tokenˉequalsˉtext(Input, Value, "rsi") { return 6u32; }
    if Tokenˉequalsˉtext(Input, Value, "dil") { return 7u32; }
    if Tokenˉequalsˉtext(Input, Value, "di") { return 7u32; }
    if Tokenˉequalsˉtext(Input, Value, "edi") { return 7u32; }
    if Tokenˉequalsˉtext(Input, Value, "rdi") { return 7u32; }
    if Tokenˉequalsˉtext(Input, Value, "r8b") { return 8u32; }
    if Tokenˉequalsˉtext(Input, Value, "r8w") { return 8u32; }
    if Tokenˉequalsˉtext(Input, Value, "r8d") { return 8u32; }
    if Tokenˉequalsˉtext(Input, Value, "r8") { return 8u32; }
    if Tokenˉequalsˉtext(Input, Value, "r9b") { return 9u32; }
    if Tokenˉequalsˉtext(Input, Value, "r9w") { return 9u32; }
    if Tokenˉequalsˉtext(Input, Value, "r9d") { return 9u32; }
    if Tokenˉequalsˉtext(Input, Value, "r9") { return 9u32; }
    if Tokenˉequalsˉtext(Input, Value, "r10b") { return 10u32; }
    if Tokenˉequalsˉtext(Input, Value, "r10w") { return 10u32; }
    if Tokenˉequalsˉtext(Input, Value, "r10d") { return 10u32; }
    if Tokenˉequalsˉtext(Input, Value, "r10") { return 10u32; }
    if Tokenˉequalsˉtext(Input, Value, "r11b") { return 11u32; }
    if Tokenˉequalsˉtext(Input, Value, "r11w") { return 11u32; }
    if Tokenˉequalsˉtext(Input, Value, "r11d") { return 11u32; }
    if Tokenˉequalsˉtext(Input, Value, "r11") { return 11u32; }
    if Tokenˉequalsˉtext(Input, Value, "r12b") { return 12u32; }
    if Tokenˉequalsˉtext(Input, Value, "r12w") { return 12u32; }
    if Tokenˉequalsˉtext(Input, Value, "r12d") { return 12u32; }
    if Tokenˉequalsˉtext(Input, Value, "r12") { return 12u32; }
    if Tokenˉequalsˉtext(Input, Value, "r13b") { return 13u32; }
    if Tokenˉequalsˉtext(Input, Value, "r13w") { return 13u32; }
    if Tokenˉequalsˉtext(Input, Value, "r13d") { return 13u32; }
    if Tokenˉequalsˉtext(Input, Value, "r13") { return 13u32; }
    if Tokenˉequalsˉtext(Input, Value, "r14b") { return 14u32; }
    if Tokenˉequalsˉtext(Input, Value, "r14w") { return 14u32; }
    if Tokenˉequalsˉtext(Input, Value, "r14d") { return 14u32; }
    if Tokenˉequalsˉtext(Input, Value, "r14") { return 14u32; }
    return 15u32;
}

fn Registerˉlowˉindex(Value: u32) -> u32 {
    if Value >= 8u32 { return Value - 8u32; }
    return Value;
}

fn Encodeˉrex(Width: u32, Register: u32, Index: u32, Memory: u32) -> bytes {
    if Width != 64u32 {
        if Register < 8u32 {
            if Index < 8u32 {
                if Memory < 8u32 { return Emptyˉbytes; }
            }
        }
    }
    var Value: u32 = 64u32;
    if Width == 64u32 { Value = Value + 8u32; }
    if Register >= 8u32 { Value = Value + 4u32; }
    if Index >= 8u32 { Value = Value + 2u32; }
    if Memory >= 8u32 { Value = Value + 1u32; }
    return Singleˉbyte(Value);
}

fn Encodeˉrexˉforced(
    Width: u32,
    Register: u32,
    Index: u32,
    Memory: u32,
    Force: bool
) -> bytes {
    let Result: bytes = Encodeˉrex(Width, Register, Index, Memory);
    if !Force { return Result; }
    if Bytesˉlength(Result) != 0u32 { return Result; }
    return Singleˉbyte(64u32);
}

fn Encodeˉoperandˉprefix(Width: u32) -> bytes {
    if Width == 16u32 { return Singleˉbyte(102u32); }
    return Emptyˉbytes;
}

fn Bytesˉfromˉi8ˉlittle(Value: i32) -> bytes {
    return Bytesˉslice(Bytesˉfromˉi32ˉlittle(Value), 0u32, 1u32);
}

fn Bytesˉfromˉi16ˉlittle(Value: i32) -> bytes {
    return Bytesˉslice(Bytesˉfromˉi32ˉlittle(Value), 0u32, 2u32);
}

fn Encodeˉmodrm(Register: u32, Memory: u32) -> bytes {
    return Singleˉbyte(
        192u32 + Registerˉlowˉindex(Register) * 8u32 + Registerˉlowˉindex(Memory)
    );
}

fn Encodeˉripˉmodrm(Register: u32) -> bytes {
    return Singleˉbyte(Registerˉlowˉindex(Register) * 8u32 + 5u32);
}

fn Encodeˉmemoryˉmodrm(Register: u32) -> bytes {
    return Singleˉbyte(132u32 + Registerˉlowˉindex(Register) * 8u32);
}

fn Immediateˉgroup(Kind: u32) -> u32 {
    if Kind == 41u32 { return 0u32; }
    if Kind == 59u32 { return 0u32; }
    if Kind == 66u32 { return 0u32; }
    if Kind == 42u32 { return 5u32; }
    if Kind == 60u32 { return 5u32; }
    if Kind == 67u32 { return 5u32; }
    if Kind == 43u32 { return 4u32; }
    if Kind == 61u32 { return 4u32; }
    if Kind == 68u32 { return 4u32; }
    if Kind == 44u32 { return 1u32; }
    if Kind == 62u32 { return 1u32; }
    if Kind == 69u32 { return 1u32; }
    if Kind == 45u32 { return 6u32; }
    if Kind == 63u32 { return 6u32; }
    if Kind == 70u32 { return 6u32; }
    if Kind == 46u32 { return 7u32; }
    if Kind == 64u32 { return 7u32; }
    if Kind == 71u32 { return 7u32; }
    return 0u32;
}

fn Shiftˉgroup(Kind: u32) -> u32 {
    if Kind == 48u32 { return 0u32; }
    if Kind == 49u32 { return 1u32; }
    if Kind == 50u32 { return 4u32; }
    if Kind == 51u32 { return 5u32; }
    return 7u32;
}

fn Memoryˉscaleˉbits(Value: u32) -> u32 {
    if Value == 1u32 { return 0u32; }
    if Value == 2u32 { return 1u32; }
    if Value == 4u32 { return 2u32; }
    return 3u32;
}

fn Relativeˉi32ˉbits(Target: u32, Nextˉinstruction: u32) -> u32 {
    if Target >= Nextˉinstruction { return Target - Nextˉinstruction; }
    let Distance: u32 = Nextˉinstruction - Target;
    return 4294967295u32 - (Distance - 1u32);
}

fn Binaryˉopcode(Kind: u32) -> u32 {
    if Kind == 23u32 { return 137u32; }
    if Kind == 24u32 { return 1u32; }
    if Kind == 25u32 { return 41u32; }
    if Kind == 26u32 { return 33u32; }
    if Kind == 27u32 { return 9u32; }
    if Kind == 28u32 { return 49u32; }
    if Kind == 29u32 { return 57u32; }
    return 133u32;
}

fn Encodeˉstatement(
    Input: bytes,
    Line: Wvaˉline,
    Sectionˉkind: u32,
    Definition: Wvaˉtoken,
    Definitionˉoffset: u32
) -> bytes {
    let Statement: Wvaˉstatementˉcheck = Checkˉstatement(Input, Line, Sectionˉkind);
    if Statement.Kind == 88u32 {
        return Appendˉbytes(
            Singleˉbyte(15u32),
            Appendˉbytes(Singleˉbyte(1u32), Singleˉbyte(248u32))
        );
    }
    if Statement.Kind == 89u32 {
        return Appendˉbytes(Singleˉbyte(72u32), Singleˉbyte(207u32));
    }
    if Statement.Kind == 90u32 {
        return Appendˉbytes(Singleˉbyte(15u32), Singleˉbyte(162u32));
    }
    if Statement.Kind == 91u32 {
        return Appendˉbytes(Singleˉbyte(15u32), Singleˉbyte(49u32));
    }
    if Statement.Kind == 92u32 {
        return Appendˉbytes(Singleˉbyte(15u32), Singleˉbyte(50u32));
    }
    if Statement.Kind == 86u32 { return Singleˉbyte(236u32); }
    if Statement.Kind == 87u32 { return Singleˉbyte(238u32); }
    if Statement.Kind == 1u32 { return Singleˉbyte(144u32); }
    if Statement.Kind == 2u32 { return Singleˉbyte(195u32); }
    if Statement.Kind == 3u32 { return Singleˉbyte(204u32); }
    if Statement.Kind == 4u32 {
        return Appendˉbytes(Singleˉbyte(232u32), Bytesˉfromˉu32ˉlittle(0u32));
    }
    if Statement.Kind == 5u32 {
        return Appendˉbytes(Singleˉbyte(233u32), Bytesˉfromˉu32ˉlittle(0u32));
    }
    if Statement.Kind == 6u32 {
        let I32ˉregister: u32 = Registerˉindex(Input, Lineˉtoken(Input, Line, 1u32));
        let I32ˉnumber: Wvaˉi32ˉparse = Parseˉi32(Input, Lineˉtoken(Input, Line, 2u32));
        return Appendˉbytes(
            Encodeˉrex(32u32, 0u32, 0u32, I32ˉregister),
            Appendˉbytes(
                Singleˉbyte(184u32 + Registerˉlowˉindex(I32ˉregister)),
                Bytesˉfromˉi32ˉlittle(I32ˉnumber.Value)
            )
        );
    }
    if Statement.Kind == 7u32 {
        let U32ˉregister: u32 = Registerˉindex(Input, Lineˉtoken(Input, Line, 1u32));
        let Moveˉu32ˉnumber: Foundationˉu32ˉparse = Parseˉu32(
            Input,
            Lineˉtoken(Input, Line, 2u32)
        );
        return Appendˉbytes(
            Encodeˉrex(32u32, 0u32, 0u32, U32ˉregister),
            Appendˉbytes(
                Singleˉbyte(184u32 + Registerˉlowˉindex(U32ˉregister)),
                Bytesˉfromˉu32ˉlittle(Moveˉu32ˉnumber.Value)
            )
        );
    }
    if Statement.Kind == 8u32 {
        var Result: bytes = Emptyˉbytes;
        var Index: u32 = 1u32;
        while Index < Line.Tokens {
            let Byteˉnumber: Foundationˉu32ˉparse = Parseˉu32(Input, Lineˉtoken(Input, Line, Index));
            Result = Appendˉbytes(Result, Singleˉbyte(Byteˉnumber.Value));
            Index = Index + 1u32;
        }
        return Result;
    }
    if Statement.Kind == 9u32 {
        let Dataˉu32ˉnumber: Foundationˉu32ˉparse = Parseˉu32(Input, Lineˉtoken(Input, Line, 1u32));
        return Bytesˉfromˉu32ˉlittle(Dataˉu32ˉnumber.Value);
    }
    if Statement.Kind == 10u32 {
        let Dataˉi32ˉnumber: Wvaˉi32ˉparse = Parseˉi32(Input, Lineˉtoken(Input, Line, 1u32));
        return Bytesˉfromˉi32ˉlittle(Dataˉi32ˉnumber.Value);
    }
    if Statement.Kind == 11u32 { return Bytesˉfromˉu32ˉlittle(0u32); }
    if Statement.Kind == 13u32 { return Singleˉbyte(250u32); }
    if Statement.Kind == 14u32 { return Singleˉbyte(244u32); }
    if Statement.Kind == 15u32 {
        return Appendˉbytes(Singleˉbyte(102u32), Singleˉbyte(239u32));
    }
    if Statement.Kind == 16u32 {
        let Pushˉnumber: Wvaˉi32ˉparse = Parseˉi32(Input, Lineˉtoken(Input, Line, 1u32));
        return Appendˉbytes(Singleˉbyte(104u32), Bytesˉfromˉi32ˉlittle(Pushˉnumber.Value));
    }
    if Statement.Kind == 17u32 {
        var Protectionˉbytes: bytes = Appendˉbytes(Singleˉbyte(185u32), Bytesˉfromˉu32ˉlittle(3221225600u32));
        Protectionˉbytes = Appendˉbytes(Protectionˉbytes, Appendˉbytes(Singleˉbyte(15u32), Singleˉbyte(50u32)));
        Protectionˉbytes = Appendˉbytes(Protectionˉbytes, Appendˉbytes(Singleˉbyte(15u32), Singleˉbyte(186u32)));
        Protectionˉbytes = Appendˉbytes(Protectionˉbytes, Appendˉbytes(Singleˉbyte(232u32), Singleˉbyte(11u32)));
        Protectionˉbytes = Appendˉbytes(Protectionˉbytes, Appendˉbytes(Singleˉbyte(15u32), Singleˉbyte(48u32)));
        Protectionˉbytes = Appendˉbytes(Protectionˉbytes, Appendˉbytes(Singleˉbyte(15u32), Singleˉbyte(32u32)));
        Protectionˉbytes = Appendˉbytes(Protectionˉbytes, Singleˉbyte(192u32));
        Protectionˉbytes = Appendˉbytes(Protectionˉbytes, Appendˉbytes(Singleˉbyte(72u32), Singleˉbyte(15u32)));
        Protectionˉbytes = Appendˉbytes(Protectionˉbytes, Appendˉbytes(Singleˉbyte(186u32), Singleˉbyte(232u32)));
        Protectionˉbytes = Appendˉbytes(Protectionˉbytes, Appendˉbytes(Singleˉbyte(16u32), Singleˉbyte(15u32)));
        Protectionˉbytes = Appendˉbytes(Protectionˉbytes, Appendˉbytes(Singleˉbyte(34u32), Singleˉbyte(192u32)));
        return Protectionˉbytes;
    }
    if Statement.Kind == 18u32 {
        var Activationˉbytes: bytes = Appendˉbytes(Singleˉbyte(15u32), Singleˉbyte(34u32));
        Activationˉbytes = Appendˉbytes(Activationˉbytes, Appendˉbytes(Singleˉbyte(216u32), Singleˉbyte(15u32)));
        return Appendˉbytes(Activationˉbytes, Appendˉbytes(Singleˉbyte(32u32), Singleˉbyte(216u32)));
    }
    if Statement.Kind == 19u32 {
        return Appendˉbytes(Singleˉbyte(15u32), Singleˉbyte(5u32));
    }
    if Statement.Kind == 20u32 { return Emptyˉbytes; }
    if Statement.Kind == 21u32 {
        let Label: Wvaˉlocalˉlabelˉlookup = Findˉlocalˉlabel(
            Input,
            Definition,
            Statement.Referenceˉoffset,
            Statement.Referenceˉlength
        );
        let Displacement: u32 = Relativeˉi32ˉbits(
            Label.Offset,
            Definitionˉoffset
        );
        return Appendˉbytes(Singleˉbyte(233u32), Bytesˉfromˉu32ˉlittle(Displacement));
    }
    if Statement.Kind == 22u32 {
        let Branchˉlabel: Wvaˉlocalˉlabelˉlookup = Findˉlocalˉlabel(
            Input,
            Definition,
            Statement.Referenceˉoffset,
            Statement.Referenceˉlength
        );
        let Branchˉdisplacement: u32 = Relativeˉi32ˉbits(
            Branchˉlabel.Offset,
            Definitionˉoffset
        );
        let Condition: u32 = Conditionˉtag(Input, Lineˉtoken(Input, Line, 1u32));
        var Branchˉbytes: bytes = Appendˉbytes(Singleˉbyte(15u32), Singleˉbyte(128u32 + Condition));
        return Appendˉbytes(Branchˉbytes, Bytesˉfromˉu32ˉlittle(Branchˉdisplacement));
    }
    if Statement.Kind >= 23u32 {
        if Statement.Kind <= 30u32 {
            let Destination: Wvaˉtoken = Lineˉtoken(Input, Line, 1u32);
            let Source: Wvaˉtoken = Lineˉtoken(Input, Line, 2u32);
            let Destinationˉindex: u32 = Registerˉindex(Input, Destination);
            let Sourceˉindex: u32 = Registerˉindex(Input, Source);
            let Width: u32 = Typedˉregisterˉwidth(Input, Destination);
            var Binaryˉbytes: bytes = Encodeˉoperandˉprefix(Width);
            var Binaryˉforceˉrex: bool = Byteˉregisterˉrequiresˉrex(Input, Destination);
            if Byteˉregisterˉrequiresˉrex(Input, Source) { Binaryˉforceˉrex = true; }
            Binaryˉbytes = Appendˉbytes(
                Binaryˉbytes,
                Encodeˉrexˉforced(
                    Width,
                    Sourceˉindex,
                    0u32,
                    Destinationˉindex,
                    Binaryˉforceˉrex
                )
            );
            var Binaryˉoperation: u32 = Binaryˉopcode(Statement.Kind);
            if Width == 8u32 { Binaryˉoperation = Binaryˉoperation - 1u32; }
            Binaryˉbytes = Appendˉbytes(Binaryˉbytes, Singleˉbyte(Binaryˉoperation));
            return Appendˉbytes(Binaryˉbytes, Encodeˉmodrm(Sourceˉindex, Destinationˉindex));
        }
    }
    if Statement.Kind == 31u32 {
        let Pushˉregister: u32 = Registerˉindex(Input, Lineˉtoken(Input, Line, 1u32));
        return Appendˉbytes(
            Encodeˉrex(32u32, 0u32, 0u32, Pushˉregister),
            Singleˉbyte(80u32 + Registerˉlowˉindex(Pushˉregister))
        );
    }
    if Statement.Kind == 32u32 {
        let Popˉregister: u32 = Registerˉindex(Input, Lineˉtoken(Input, Line, 1u32));
        return Appendˉbytes(
            Encodeˉrex(32u32, 0u32, 0u32, Popˉregister),
            Singleˉbyte(88u32 + Registerˉlowˉindex(Popˉregister))
        );
    }
    if Statement.Kind == 33u32 {
        let Callˉregister: u32 = Registerˉindex(Input, Lineˉtoken(Input, Line, 1u32));
        var Callˉbytes: bytes = Encodeˉrex(32u32, 0u32, 0u32, Callˉregister);
        Callˉbytes = Appendˉbytes(Callˉbytes, Singleˉbyte(255u32));
        return Appendˉbytes(Callˉbytes, Singleˉbyte(208u32 + Registerˉlowˉindex(Callˉregister)));
    }
    if Statement.Kind == 34u32 {
        let Jumpˉregister: u32 = Registerˉindex(Input, Lineˉtoken(Input, Line, 1u32));
        var Jumpˉbytes: bytes = Encodeˉrex(32u32, 0u32, 0u32, Jumpˉregister);
        Jumpˉbytes = Appendˉbytes(Jumpˉbytes, Singleˉbyte(255u32));
        return Appendˉbytes(Jumpˉbytes, Singleˉbyte(224u32 + Registerˉlowˉindex(Jumpˉregister)));
    }
    if Statement.Kind >= 35u32 {
        if Statement.Kind <= 39u32 {
            var Ripˉregisterˉtoken: Wvaˉtoken = Lineˉtoken(Input, Line, 1u32);
            if Statement.Kind == 37u32 { Ripˉregisterˉtoken = Lineˉtoken(Input, Line, 2u32); }
            if Statement.Kind == 38u32 { Ripˉregisterˉtoken = Lineˉtoken(Input, Line, 2u32); }
            let Ripˉregister: u32 = Registerˉindex(Input, Ripˉregisterˉtoken);
            var Ripˉwidth: u32 = 32u32;
            if Statement.Kind == 36u32 { Ripˉwidth = 64u32; }
            if Statement.Kind == 38u32 { Ripˉwidth = 64u32; }
            if Statement.Kind == 39u32 { Ripˉwidth = 64u32; }
            var Ripˉbytes: bytes = Encodeˉrex(Ripˉwidth, Ripˉregister, 0u32, 0u32);
            var Ripˉopcode: u32 = 139u32;
            if Statement.Kind == 37u32 { Ripˉopcode = 137u32; }
            if Statement.Kind == 38u32 { Ripˉopcode = 137u32; }
            if Statement.Kind == 39u32 { Ripˉopcode = 141u32; }
            Ripˉbytes = Appendˉbytes(Ripˉbytes, Singleˉbyte(Ripˉopcode));
            Ripˉbytes = Appendˉbytes(Ripˉbytes, Encodeˉripˉmodrm(Ripˉregister));
            return Appendˉbytes(Ripˉbytes, Bytesˉfromˉu32ˉlittle(0u32));
        }
    }
    if Statement.Kind == 40u32 {
        let Multiplyˉdestinationˉtoken: Wvaˉtoken = Lineˉtoken(Input, Line, 1u32);
        let Multiplyˉsourceˉtoken: Wvaˉtoken = Lineˉtoken(Input, Line, 2u32);
        let Multiplyˉdestination: u32 = Registerˉindex(Input, Multiplyˉdestinationˉtoken);
        let Multiplyˉsource: u32 = Registerˉindex(Input, Multiplyˉsourceˉtoken);
        let Multiplyˉwidth: u32 = Typedˉregisterˉwidth(Input, Multiplyˉdestinationˉtoken);
        var Multiplyˉbytes: bytes = Encodeˉoperandˉprefix(Multiplyˉwidth);
        Multiplyˉbytes = Appendˉbytes(
            Multiplyˉbytes,
            Encodeˉrex(
                Multiplyˉwidth,
                Multiplyˉdestination,
                0u32,
                Multiplyˉsource
            )
        );
        Multiplyˉbytes = Appendˉbytes(Multiplyˉbytes, Singleˉbyte(15u32));
        Multiplyˉbytes = Appendˉbytes(Multiplyˉbytes, Singleˉbyte(175u32));
        return Appendˉbytes(
            Multiplyˉbytes,
            Encodeˉmodrm(Multiplyˉdestination, Multiplyˉsource)
        );
    }
    if Statement.Kind >= 41u32 {
        if Statement.Kind <= 47u32 {
            let Immediateˉregisterˉtoken: Wvaˉtoken = Lineˉtoken(Input, Line, 1u32);
            let Immediateˉregister: u32 = Registerˉindex(Input, Immediateˉregisterˉtoken);
            let Immediateˉwidth: u32 = Typedˉregisterˉwidth(Input, Immediateˉregisterˉtoken);
            let Immediateˉparsed: Wvaˉi32ˉparse = Parseˉi32(
                Input,
                Lineˉtoken(Input, Line, 2u32)
            );
            var Immediateˉbytes: bytes = Encodeˉrex(
                Immediateˉwidth,
                0u32,
                0u32,
                Immediateˉregister
            );
            var Immediateˉopcode: u32 = 129u32;
            if Statement.Kind == 47u32 { Immediateˉopcode = 247u32; }
            Immediateˉbytes = Appendˉbytes(Immediateˉbytes, Singleˉbyte(Immediateˉopcode));
            Immediateˉbytes = Appendˉbytes(
                Immediateˉbytes,
                Encodeˉmodrm(Immediateˉgroup(Statement.Kind), Immediateˉregister)
            );
            return Appendˉbytes(
                Immediateˉbytes,
                Bytesˉfromˉi32ˉlittle(Immediateˉparsed.Value)
            );
        }
    }
    if Statement.Kind >= 48u32 {
        if Statement.Kind <= 52u32 {
            let Shiftˉregisterˉtoken: Wvaˉtoken = Lineˉtoken(Input, Line, 1u32);
            let Shiftˉregister: u32 = Registerˉindex(Input, Shiftˉregisterˉtoken);
            let Shiftˉwidth: u32 = Typedˉregisterˉwidth(Input, Shiftˉregisterˉtoken);
            let Shiftˉparsed: Foundationˉu32ˉparse = Parseˉu32(
                Input,
                Lineˉtoken(Input, Line, 2u32)
            );
            var Shiftˉbytes: bytes = Encodeˉoperandˉprefix(Shiftˉwidth);
            Shiftˉbytes = Appendˉbytes(
                Shiftˉbytes,
                Encodeˉrexˉforced(
                    Shiftˉwidth,
                    0u32,
                    0u32,
                    Shiftˉregister,
                    Byteˉregisterˉrequiresˉrex(Input, Shiftˉregisterˉtoken)
                )
            );
            var Shiftˉopcode: u32 = 193u32;
            if Shiftˉwidth == 8u32 { Shiftˉopcode = 192u32; }
            Shiftˉbytes = Appendˉbytes(Shiftˉbytes, Singleˉbyte(Shiftˉopcode));
            Shiftˉbytes = Appendˉbytes(
                Shiftˉbytes,
                Encodeˉmodrm(Shiftˉgroup(Statement.Kind), Shiftˉregister)
            );
            return Appendˉbytes(Shiftˉbytes, Singleˉbyte(Shiftˉparsed.Value));
        }
    }
    if Statement.Kind == 57u32 {
        let Moveˉu8ˉregisterˉtoken: Wvaˉtoken = Lineˉtoken(Input, Line, 1u32);
        let Moveˉu8ˉregister: u32 = Registerˉindex(Input, Moveˉu8ˉregisterˉtoken);
        let Moveˉu8ˉvalue: Foundationˉu32ˉparse = Parseˉu32(
            Input,
            Lineˉtoken(Input, Line, 2u32)
        );
        var Moveˉu8ˉbytes: bytes = Encodeˉrexˉforced(
            8u32,
            0u32,
            0u32,
            Moveˉu8ˉregister,
            Byteˉregisterˉrequiresˉrex(Input, Moveˉu8ˉregisterˉtoken)
        );
        Moveˉu8ˉbytes = Appendˉbytes(
            Moveˉu8ˉbytes,
            Singleˉbyte(176u32 + Registerˉlowˉindex(Moveˉu8ˉregister))
        );
        return Appendˉbytes(Moveˉu8ˉbytes, Singleˉbyte(Moveˉu8ˉvalue.Value));
    }
    if Statement.Kind == 58u32 {
        let Moveˉu16ˉregister: u32 = Registerˉindex(Input, Lineˉtoken(Input, Line, 1u32));
        let Moveˉu16ˉvalue: Foundationˉu32ˉparse = Parseˉu32(
            Input,
            Lineˉtoken(Input, Line, 2u32)
        );
        var Moveˉu16ˉbytes: bytes = Singleˉbyte(102u32);
        Moveˉu16ˉbytes = Appendˉbytes(
            Moveˉu16ˉbytes,
            Encodeˉrex(16u32, 0u32, 0u32, Moveˉu16ˉregister)
        );
        Moveˉu16ˉbytes = Appendˉbytes(
            Moveˉu16ˉbytes,
            Singleˉbyte(184u32 + Registerˉlowˉindex(Moveˉu16ˉregister))
        );
        return Appendˉbytes(Moveˉu16ˉbytes, Bytesˉfromˉu16ˉlittle(Moveˉu16ˉvalue.Value));
    }
    if Statement.Kind >= 59u32 {
        if Statement.Kind <= 72u32 {
            let Narrowˉregisterˉtoken: Wvaˉtoken = Lineˉtoken(Input, Line, 1u32);
            let Narrowˉregister: u32 = Registerˉindex(Input, Narrowˉregisterˉtoken);
            var Narrowˉwidth: u32 = 8u32;
            if Statement.Kind >= 66u32 { Narrowˉwidth = 16u32; }
            let Narrowˉimmediate: Wvaˉi32ˉparse = Parseˉi32(
                Input,
                Lineˉtoken(Input, Line, 2u32)
            );
            var Narrowˉbytes: bytes = Encodeˉoperandˉprefix(Narrowˉwidth);
            Narrowˉbytes = Appendˉbytes(
                Narrowˉbytes,
                Encodeˉrexˉforced(
                    Narrowˉwidth,
                    0u32,
                    0u32,
                    Narrowˉregister,
                    Byteˉregisterˉrequiresˉrex(Input, Narrowˉregisterˉtoken)
                )
            );
            var Narrowˉopcode: u32 = 128u32;
            if Statement.Kind == 65u32 { Narrowˉopcode = 246u32; }
            if Narrowˉwidth == 16u32 {
                Narrowˉopcode = 129u32;
                if Statement.Kind == 72u32 { Narrowˉopcode = 247u32; }
            }
            Narrowˉbytes = Appendˉbytes(Narrowˉbytes, Singleˉbyte(Narrowˉopcode));
            Narrowˉbytes = Appendˉbytes(
                Narrowˉbytes,
                Encodeˉmodrm(Immediateˉgroup(Statement.Kind), Narrowˉregister)
            );
            if Narrowˉwidth == 8u32 {
                return Appendˉbytes(
                    Narrowˉbytes,
                    Bytesˉfromˉi8ˉlittle(Narrowˉimmediate.Value)
                );
            }
            return Appendˉbytes(
                Narrowˉbytes,
                Bytesˉfromˉi16ˉlittle(Narrowˉimmediate.Value)
            );
        }
    }
    if Statement.Kind >= 73u32 {
        if Statement.Kind <= 76u32 {
            var Narrowˉripˉregisterˉtoken: Wvaˉtoken = Lineˉtoken(Input, Line, 1u32);
            if Statement.Kind >= 75u32 {
                Narrowˉripˉregisterˉtoken = Lineˉtoken(Input, Line, 2u32);
            }
            let Narrowˉripˉregister: u32 = Registerˉindex(Input, Narrowˉripˉregisterˉtoken);
            var Narrowˉripˉwidth: u32 = 8u32;
            if Statement.Kind == 74u32 { Narrowˉripˉwidth = 16u32; }
            if Statement.Kind == 76u32 { Narrowˉripˉwidth = 16u32; }
            var Narrowˉripˉbytes: bytes = Encodeˉoperandˉprefix(Narrowˉripˉwidth);
            Narrowˉripˉbytes = Appendˉbytes(
                Narrowˉripˉbytes,
                Encodeˉrexˉforced(
                    Narrowˉripˉwidth,
                    Narrowˉripˉregister,
                    0u32,
                    0u32,
                    Byteˉregisterˉrequiresˉrex(Input, Narrowˉripˉregisterˉtoken)
                )
            );
            var Narrowˉripˉopcode: u32 = 138u32;
            if Statement.Kind == 74u32 { Narrowˉripˉopcode = 139u32; }
            if Statement.Kind == 75u32 { Narrowˉripˉopcode = 136u32; }
            if Statement.Kind == 76u32 { Narrowˉripˉopcode = 137u32; }
            Narrowˉripˉbytes = Appendˉbytes(
                Narrowˉripˉbytes,
                Singleˉbyte(Narrowˉripˉopcode)
            );
            Narrowˉripˉbytes = Appendˉbytes(
                Narrowˉripˉbytes,
                Encodeˉripˉmodrm(Narrowˉripˉregister)
            );
            return Appendˉbytes(Narrowˉripˉbytes, Bytesˉfromˉu32ˉlittle(0u32));
        }
    }
    if Statement.Kind == 81u32 {
        let Setˉregisterˉtoken: Wvaˉtoken = Lineˉtoken(Input, Line, 2u32);
        let Setˉregister: u32 = Registerˉindex(Input, Setˉregisterˉtoken);
        var Setˉbytes: bytes = Encodeˉrexˉforced(
            8u32,
            0u32,
            0u32,
            Setˉregister,
            Byteˉregisterˉrequiresˉrex(Input, Setˉregisterˉtoken)
        );
        Setˉbytes = Appendˉbytes(Setˉbytes, Singleˉbyte(15u32));
        Setˉbytes = Appendˉbytes(
            Setˉbytes,
            Singleˉbyte(144u32 + Conditionˉtag(Input, Lineˉtoken(Input, Line, 1u32)))
        );
        return Appendˉbytes(Setˉbytes, Encodeˉmodrm(0u32, Setˉregister));
    }
    if Statement.Kind >= 82u32 {
        if Statement.Kind <= 85u32 {
            let Extensionˉdestinationˉtoken: Wvaˉtoken = Lineˉtoken(Input, Line, 1u32);
            let Extensionˉsourceˉtoken: Wvaˉtoken = Lineˉtoken(Input, Line, 2u32);
            let Extensionˉdestination: u32 = Registerˉindex(Input, Extensionˉdestinationˉtoken);
            let Extensionˉsource: u32 = Registerˉindex(Input, Extensionˉsourceˉtoken);
            let Extensionˉwidth: u32 = Typedˉregisterˉwidth(Input, Extensionˉdestinationˉtoken);
            var Extensionˉbytes: bytes = Encodeˉrexˉforced(
                Extensionˉwidth,
                Extensionˉdestination,
                0u32,
                Extensionˉsource,
                Byteˉregisterˉrequiresˉrex(Input, Extensionˉsourceˉtoken)
            );
            Extensionˉbytes = Appendˉbytes(Extensionˉbytes, Singleˉbyte(15u32));
            var Extensionˉopcode: u32 = 182u32;
            if Statement.Kind == 83u32 { Extensionˉopcode = 183u32; }
            if Statement.Kind == 84u32 { Extensionˉopcode = 190u32; }
            if Statement.Kind == 85u32 { Extensionˉopcode = 191u32; }
            Extensionˉbytes = Appendˉbytes(
                Extensionˉbytes,
                Singleˉbyte(Extensionˉopcode)
            );
            return Appendˉbytes(
                Extensionˉbytes,
                Encodeˉmodrm(Extensionˉdestination, Extensionˉsource)
            );
        }
    }
    if Memoryˉstatementˉkind(Input, Lineˉtoken(Input, Line, 0u32)) != 0u32 {
            var Memoryˉvalueˉtoken: Wvaˉtoken = Lineˉtoken(Input, Line, 1u32);
            var Memoryˉbaseˉtoken: Wvaˉtoken = Lineˉtoken(Input, Line, 2u32);
            var Memoryˉindexˉtoken: Wvaˉtoken = Lineˉtoken(Input, Line, 3u32);
            var Memoryˉscaleˉtoken: Wvaˉtoken = Lineˉtoken(Input, Line, 4u32);
            var Memoryˉdisplacementˉtoken: Wvaˉtoken = Lineˉtoken(Input, Line, 5u32);
            if Memoryˉstatementˉisˉstore(Statement.Kind) {
                Memoryˉbaseˉtoken = Lineˉtoken(Input, Line, 1u32);
                Memoryˉindexˉtoken = Lineˉtoken(Input, Line, 2u32);
                Memoryˉscaleˉtoken = Lineˉtoken(Input, Line, 3u32);
                Memoryˉdisplacementˉtoken = Lineˉtoken(Input, Line, 4u32);
                Memoryˉvalueˉtoken = Lineˉtoken(Input, Line, 5u32);
            }
            let Memoryˉvalue: u32 = Registerˉindex(Input, Memoryˉvalueˉtoken);
            let Memoryˉbase: u32 = Registerˉindex(Input, Memoryˉbaseˉtoken);
            var Memoryˉindex: u32 = 4u32;
            var Memoryˉrexˉindex: u32 = 0u32;
            if !Tokenˉequalsˉtext(Input, Memoryˉindexˉtoken, "none") {
                Memoryˉindex = Registerˉindex(Input, Memoryˉindexˉtoken);
                Memoryˉrexˉindex = Memoryˉindex;
            }
            let Memoryˉwidth: u32 = Memoryˉstatementˉwidth(Statement.Kind);
            let Memoryˉscale: Foundationˉu32ˉparse = Parseˉu32(Input, Memoryˉscaleˉtoken);
            let Memoryˉdisplacement: Wvaˉi32ˉparse = Parseˉi32(
                Input,
                Memoryˉdisplacementˉtoken
            );
            var Memoryˉbytes: bytes = Encodeˉoperandˉprefix(Memoryˉwidth);
            Memoryˉbytes = Appendˉbytes(
                Memoryˉbytes,
                Encodeˉrexˉforced(
                    Memoryˉwidth,
                    Memoryˉvalue,
                    Memoryˉrexˉindex,
                    Memoryˉbase,
                    Byteˉregisterˉrequiresˉrex(Input, Memoryˉvalueˉtoken)
                )
            );
            var Memoryˉopcode: u32 = 139u32;
            if Memoryˉstatementˉisˉstore(Statement.Kind) { Memoryˉopcode = 137u32; }
            if Memoryˉwidth == 8u32 {
                if Memoryˉstatementˉisˉstore(Statement.Kind) { Memoryˉopcode = 136u32; }
                else { Memoryˉopcode = 138u32; }
            }
            Memoryˉbytes = Appendˉbytes(Memoryˉbytes, Singleˉbyte(Memoryˉopcode));
            Memoryˉbytes = Appendˉbytes(Memoryˉbytes, Encodeˉmemoryˉmodrm(Memoryˉvalue));
            Memoryˉbytes = Appendˉbytes(
                Memoryˉbytes,
                Singleˉbyte(
                    Memoryˉscaleˉbits(Memoryˉscale.Value) * 64u32 +
                    Registerˉlowˉindex(Memoryˉindex) * 8u32 +
                    Registerˉlowˉindex(Memoryˉbase)
                )
            );
            return Appendˉbytes(
                Memoryˉbytes,
                Bytesˉfromˉi32ˉlittle(Memoryˉdisplacement.Value)
            );
    }
    return Emptyˉbytes;
}

fn Encodeˉsectionˉrecord(
    Input: bytes,
    Name: Wvaˉtoken,
    Kind: u32,
    Alignment: u32,
    Memoryˉsize: u32,
    Contents: bytes
) -> bytes {
    var Result: bytes = Singleˉbyte(Kind);
    Result = Appendˉbytes(Result, Singleˉbyte(0u32));
    Result = Appendˉbytes(Result, Bytesˉfromˉu16ˉlittle(0u32));
    Result = Appendˉbytes(Result, Bytesˉfromˉu32ˉlittle(Alignment));
    Result = Appendˉbytes(Result, Bytesˉfromˉu32ˉlittle(Memoryˉsize));
    Result = Appendˉbytes(Result, Bytesˉfromˉu32ˉlittle(Bytesˉlength(Contents)));
    Result = Appendˉbytes(Result, Encodeˉname(Input, Name));
    return Appendˉbytes(Result, Contents);
}

fn Encodeˉsections(Input: bytes) -> bytes {
    let Header: Wvaˉline = Readˉmeaningfulˉline(Input, 0u32, 1u32, 1u32);
    var Current: Wvaˉline = Readˉmeaningfulˉline(
        Input,
        Header.Nextˉcursor,
        Header.Nextˉline,
        Header.Nextˉcolumn
    );
    var Result: bytes = Emptyˉbytes;
    var Sectionˉname: Wvaˉtoken = Lineˉtoken(Input, Header, 0u32);
    var Sectionˉkind: u32 = 0u32;
    var Sectionˉalignment: u32 = 0u32;
    var Sectionˉmemory: u32 = 0u32;
    var Sectionˉcontents: bytes = Emptyˉbytes;
    var Insideˉdefinition: bool = false;
    var Definitionˉname: Wvaˉtoken = Lineˉtoken(Input, Header, 0u32);
    var Definitionˉstart: u32 = 0u32;
    while Current.Present {
        let First: Wvaˉtoken = Lineˉtoken(Input, Current, 0u32);
        if Tokenˉequalsˉtext(Input, First, "section") {
            Sectionˉkind = Sectionˉkindˉtag(Input, Lineˉtoken(Input, Current, 1u32));
            Sectionˉname = Lineˉtoken(Input, Current, 2u32);
            let Parsedˉalignment: Foundationˉu32ˉparse = Parseˉu32(
                Input,
                Lineˉtoken(Input, Current, 4u32)
            );
            Sectionˉalignment = Parsedˉalignment.Value;
            Sectionˉmemory = 0u32;
            Sectionˉcontents = Emptyˉbytes;
        } else {
            if Tokenˉequalsˉtext(Input, First, "define") {
                Insideˉdefinition = true;
                Definitionˉname = Lineˉtoken(Input, Current, 1u32);
                Definitionˉstart = Sectionˉmemory;
            } else {
                if Lineˉisˉend(Input, Current, "define") {
                    Insideˉdefinition = false;
                } else {
                    if Lineˉisˉend(Input, Current, "section") {
                        Result = Appendˉbytes(
                            Result,
                            Encodeˉsectionˉrecord(
                                Input,
                                Sectionˉname,
                                Sectionˉkind,
                                Sectionˉalignment,
                                Sectionˉmemory,
                                Sectionˉcontents
                            )
                        );
                    } else {
                        if Insideˉdefinition {
                            let Statement: Wvaˉstatementˉcheck = Checkˉstatement(
                                Input,
                                Current,
                                Sectionˉkind
                            );
                            Sectionˉmemory = Sectionˉmemory + Statement.Size;
                            if Sectionˉkind != 4u32 {
                                Sectionˉcontents = Appendˉbytes(
                                    Sectionˉcontents,
                                    Encodeˉstatement(
                                        Input,
                                        Current,
                                        Sectionˉkind,
                                        Definitionˉname,
                                        Sectionˉmemory - Definitionˉstart
                                    )
                                );
                            }
                        }
                    }
                }
            }
        }
        Current = Readˉmeaningfulˉline(
            Input,
            Current.Nextˉcursor,
            Current.Nextˉline,
            Current.Nextˉcolumn
        );
    }
    return Result;
}

fn Findˉdefinitionˉrange(Input: bytes, Name: Wvaˉtoken) -> Wvaˉdefinitionˉrange {
    let Header: Wvaˉline = Readˉmeaningfulˉline(Input, 0u32, 1u32, 1u32);
    var Current: Wvaˉline = Readˉmeaningfulˉline(
        Input,
        Header.Nextˉcursor,
        Header.Nextˉline,
        Header.Nextˉcolumn
    );
    var Nextˉsectionˉindex: u32 = 0u32;
    var Currentˉsectionˉindex: u32 = 0u32;
    var Currentˉsectionˉkind: u32 = 0u32;
    var Currentˉoffset: u32 = 0u32;
    var Definitionˉoffset: u32 = 0u32;
    var Insideˉdefinition: bool = false;
    var Wantedˉdefinition: bool = false;
    while Current.Present {
        let First: Wvaˉtoken = Lineˉtoken(Input, Current, 0u32);
        if Tokenˉequalsˉtext(Input, First, "section") {
            Currentˉsectionˉindex = Nextˉsectionˉindex;
            Nextˉsectionˉindex = Nextˉsectionˉindex + 1u32;
            Currentˉsectionˉkind = Sectionˉkindˉtag(Input, Lineˉtoken(Input, Current, 1u32));
            Currentˉoffset = 0u32;
        } else {
            if Tokenˉequalsˉtext(Input, First, "define") {
                Insideˉdefinition = true;
                let Definitionˉname: Wvaˉtoken = Lineˉtoken(Input, Current, 1u32);
                Wantedˉdefinition = Spansˉequal(
                    Input,
                    Name.Offset,
                    Name.Length,
                    Definitionˉname.Offset,
                    Definitionˉname.Length
                );
                if Wantedˉdefinition { Definitionˉoffset = Currentˉoffset; }
            } else {
                if Lineˉisˉend(Input, Current, "define") {
                    if Wantedˉdefinition {
                        return Wvaˉdefinitionˉrange(
                            true,
                            Currentˉsectionˉindex,
                            Definitionˉoffset,
                            Currentˉoffset - Definitionˉoffset
                        );
                    }
                    Insideˉdefinition = false;
                    Wantedˉdefinition = false;
                } else {
                    if Insideˉdefinition {
                        let Statement: Wvaˉstatementˉcheck = Checkˉstatement(
                            Input,
                            Current,
                            Currentˉsectionˉkind
                        );
                        Currentˉoffset = Currentˉoffset + Statement.Size;
                    }
                }
            }
        }
        Current = Readˉmeaningfulˉline(
            Input,
            Current.Nextˉcursor,
            Current.Nextˉline,
            Current.Nextˉcolumn
        );
    }
    return Wvaˉdefinitionˉrange(false, 0u32, 0u32, 0u32);
}

fn Encodeˉsymbolˉrecord(
    Input: bytes,
    Name: Wvaˉtoken,
    Binding: u32,
    Kind: u32,
    Sectionˉindex: u32,
    Offset: u32,
    Size: u32
) -> bytes {
    var Result: bytes = Singleˉbyte(Binding);
    Result = Appendˉbytes(Result, Singleˉbyte(Kind));
    Result = Appendˉbytes(Result, Bytesˉfromˉu16ˉlittle(0u32));
    Result = Appendˉbytes(Result, Bytesˉfromˉu32ˉlittle(Sectionˉindex));
    Result = Appendˉbytes(Result, Bytesˉfromˉu32ˉlittle(Offset));
    Result = Appendˉbytes(Result, Bytesˉfromˉu32ˉlittle(Size));
    return Appendˉbytes(Result, Encodeˉname(Input, Name));
}

fn Encodeˉsymbols(Input: bytes) -> bytes {
    let Header: Wvaˉline = Readˉmeaningfulˉline(Input, 0u32, 1u32, 1u32);
    var Current: Wvaˉline = Readˉmeaningfulˉline(
        Input,
        Header.Nextˉcursor,
        Header.Nextˉline,
        Header.Nextˉcolumn
    );
    var Result: bytes = Emptyˉbytes;
    while Current.Present {
        let First: Wvaˉtoken = Lineˉtoken(Input, Current, 0u32);
        if Tokenˉequalsˉtext(Input, First, "section") { return Result; }
        let Binding: u32 = Bindingˉtag(Input, Lineˉtoken(Input, Current, 1u32));
        let Kind: u32 = Symbolˉkindˉtag(Input, Lineˉtoken(Input, Current, 2u32));
        let Name: Wvaˉtoken = Lineˉtoken(Input, Current, 3u32);
        var Sectionˉindex: u32 = 4294967295u32;
        var Offset: u32 = 0u32;
        var Size: u32 = 0u32;
        if Binding != 3u32 {
            let Range: Wvaˉdefinitionˉrange = Findˉdefinitionˉrange(Input, Name);
            Sectionˉindex = Range.Sectionˉindex;
            Offset = Range.Offset;
            Size = Range.Size;
        }
        Result = Appendˉbytes(
            Result,
            Encodeˉsymbolˉrecord(Input, Name, Binding, Kind, Sectionˉindex, Offset, Size)
        );
        Current = Readˉmeaningfulˉline(
            Input,
            Current.Nextˉcursor,
            Current.Nextˉline,
            Current.Nextˉcolumn
        );
    }
    return Result;
}

fn Findˉsymbolˉindex(Input: bytes, Nameˉoffset: u32, Nameˉlength: u32) -> u32 {
    let Header: Wvaˉline = Readˉmeaningfulˉline(Input, 0u32, 1u32, 1u32);
    var Current: Wvaˉline = Readˉmeaningfulˉline(
        Input,
        Header.Nextˉcursor,
        Header.Nextˉline,
        Header.Nextˉcolumn
    );
    var Index: u32 = 0u32;
    while Current.Present {
        let First: Wvaˉtoken = Lineˉtoken(Input, Current, 0u32);
        if Tokenˉequalsˉtext(Input, First, "section") { return 0u32; }
        let Name: Wvaˉtoken = Lineˉtoken(Input, Current, 3u32);
        if Spansˉequal(Input, Nameˉoffset, Nameˉlength, Name.Offset, Name.Length) {
            return Index;
        }
        Index = Index + 1u32;
        Current = Readˉmeaningfulˉline(
            Input,
            Current.Nextˉcursor,
            Current.Nextˉline,
            Current.Nextˉcolumn
        );
    }
    return 0u32;
}

fn Encodeˉrelocationˉrecord(
    Kind: u32,
    Sectionˉindex: u32,
    Offset: u32,
    Symbolˉindex: u32,
    Addend: i32
) -> bytes {
    var Result: bytes = Singleˉbyte(Kind);
    Result = Appendˉbytes(Result, Singleˉbyte(0u32));
    Result = Appendˉbytes(Result, Bytesˉfromˉu16ˉlittle(0u32));
    Result = Appendˉbytes(Result, Bytesˉfromˉu32ˉlittle(Sectionˉindex));
    Result = Appendˉbytes(Result, Bytesˉfromˉu32ˉlittle(Offset));
    Result = Appendˉbytes(Result, Bytesˉfromˉu32ˉlittle(Symbolˉindex));
    return Appendˉbytes(Result, Bytesˉfromˉi32ˉlittle(Addend));
}

fn Encodeˉrelocations(Input: bytes) -> bytes {
    let Header: Wvaˉline = Readˉmeaningfulˉline(Input, 0u32, 1u32, 1u32);
    var Current: Wvaˉline = Readˉmeaningfulˉline(
        Input,
        Header.Nextˉcursor,
        Header.Nextˉline,
        Header.Nextˉcolumn
    );
    var Result: bytes = Emptyˉbytes;
    var Nextˉsectionˉindex: u32 = 0u32;
    var Currentˉsectionˉindex: u32 = 0u32;
    var Currentˉsectionˉkind: u32 = 0u32;
    var Currentˉoffset: u32 = 0u32;
    var Insideˉdefinition: bool = false;
    while Current.Present {
        let First: Wvaˉtoken = Lineˉtoken(Input, Current, 0u32);
        if Tokenˉequalsˉtext(Input, First, "section") {
            Currentˉsectionˉindex = Nextˉsectionˉindex;
            Nextˉsectionˉindex = Nextˉsectionˉindex + 1u32;
            Currentˉsectionˉkind = Sectionˉkindˉtag(Input, Lineˉtoken(Input, Current, 1u32));
            Currentˉoffset = 0u32;
        } else {
            if Tokenˉequalsˉtext(Input, First, "define") {
                Insideˉdefinition = true;
            } else {
                if Lineˉisˉend(Input, Current, "define") {
                    Insideˉdefinition = false;
                } else {
                    if Insideˉdefinition {
                        let Statement: Wvaˉstatementˉcheck = Checkˉstatement(
                            Input,
                            Current,
                            Currentˉsectionˉkind
                        );
                        if Statement.Hasˉreference {
                            let Symbolˉindex: u32 = Findˉsymbolˉindex(
                                Input,
                                Statement.Referenceˉoffset,
                                Statement.Referenceˉlength
                            );
                            if Statement.Kind == 11u32 {
                                Result = Appendˉbytes(
                                    Result,
                                    Encodeˉrelocationˉrecord(
                                        1u32,
                                        Currentˉsectionˉindex,
                                        Currentˉoffset,
                                        Symbolˉindex,
                                        0
                                    )
                                );
                            } else {
                                var Relativeˉoffset: u32 = Currentˉoffset + 1u32;
                                if Statement.Kind >= 35u32 {
                                    Relativeˉoffset = Currentˉoffset + Statement.Size - 4u32;
                                }
                                Result = Appendˉbytes(
                                    Result,
                                    Encodeˉrelocationˉrecord(
                                        2u32,
                                        Currentˉsectionˉindex,
                                        Relativeˉoffset,
                                        Symbolˉindex,
                                        -4
                                    )
                                );
                            }
                        }
                        Currentˉoffset = Currentˉoffset + Statement.Size;
                    }
                }
            }
        }
        Current = Readˉmeaningfulˉline(
            Input,
            Current.Nextˉcursor,
            Current.Nextˉline,
            Current.Nextˉcolumn
        );
    }
    return Result;
}

fn Encodingˉfailure(
    Status: Wvaˉsemanticˉstatus,
    Semantics: Wvaˉsemanticˉinspection,
    Offset: u32,
    Line: u32,
    Column: u32
) -> Wvaˉobjectˉencoding {
    return Wvaˉobjectˉencoding(
        Status,
        Emptyˉbytes,
        0u32,
        Semantics.Sections,
        Semantics.Symbols,
        Semantics.Relocations,
        Offset,
        Line,
        Column
    );
}

fn Encodeˉwva(Input: bytes) -> Wvaˉobjectˉencoding {
    let Semantics: Wvaˉsemanticˉinspection = Inspectˉwvaˉsemantics(Input);
    if Semantics.Status != Wvaˉsemanticˉstatus.Valid {
        return Encodingˉfailure(
            Semantics.Status,
            Semantics,
            Semantics.Failureˉoffset,
            Semantics.Failureˉline,
            Semantics.Failureˉcolumn
        );
    }
    let Measured: Wvaˉobjectˉsize = Measureˉwvo(Input, Semantics);
    if !Measured.Valid {
        return Encodingˉfailure(
            Wvaˉsemanticˉstatus.Wva1011,
            Semantics,
            Measured.Failureˉoffset,
            Measured.Failureˉline,
            Measured.Failureˉcolumn
        );
    }

    var Result: bytes = Encodeˉwvoˉheader(
        Semantics.Sections,
        Semantics.Symbols,
        Semantics.Relocations
    );
    Result = Appendˉbytes(Result, Encodeˉsections(Input));
    Result = Appendˉbytes(Result, Encodeˉsymbols(Input));
    Result = Appendˉbytes(Result, Encodeˉrelocations(Input));
    if Bytesˉlength(Result) != Measured.Bytes {
        return Encodingˉfailure(
            Wvaˉsemanticˉstatus.Wva1011,
            Semantics,
            Bytesˉlength(Input),
            Semantics.Failureˉline,
            Semantics.Failureˉcolumn
        );
    }
    return Wvaˉobjectˉencoding(
        Wvaˉsemanticˉstatus.Valid,
        Result,
        Measured.Bytes,
        Semantics.Sections,
        Semantics.Symbols,
        Semantics.Relocations,
        Bytesˉlength(Input),
        Semantics.Failureˉline,
        Semantics.Failureˉcolumn
    );
}

fn Statusˉtext(Status: Wvaˉscanˉstatus) -> text {
    if Status == Wvaˉscanˉstatus.Valid { return "valid"; }
    if Status == Wvaˉscanˉstatus.Sourceˉtooˉlarge { return "source_too_large"; }
    if Status == Wvaˉscanˉstatus.Invalidˉutf8 { return "invalid_utf8"; }
    if Status == Wvaˉscanˉstatus.Lineˉtooˉlong { return "line_too_long"; }
    if Status == Wvaˉscanˉstatus.Missingˉheader { return "missing_header"; }
    return "bad_header";
}

fn Semanticˉstatusˉtext(Status: Wvaˉsemanticˉstatus) -> text {
    if Status == Wvaˉsemanticˉstatus.Valid { return "valid"; }
    if Status == Wvaˉsemanticˉstatus.Wva1001 { return "WVA1001"; }
    if Status == Wvaˉsemanticˉstatus.Wva1002 { return "WVA1002"; }
    if Status == Wvaˉsemanticˉstatus.Wva1003 { return "WVA1003"; }
    if Status == Wvaˉsemanticˉstatus.Wva1004 { return "WVA1004"; }
    if Status == Wvaˉsemanticˉstatus.Wva1005 { return "WVA1005"; }
    if Status == Wvaˉsemanticˉstatus.Wva1006 { return "WVA1006"; }
    if Status == Wvaˉsemanticˉstatus.Wva1007 { return "WVA1007"; }
    if Status == Wvaˉsemanticˉstatus.Wva1008 { return "WVA1008"; }
    if Status == Wvaˉsemanticˉstatus.Wva1009 { return "WVA1009"; }
    if Status == Wvaˉsemanticˉstatus.Wva1010 { return "WVA1010"; }
    return "WVA1011";
}

fn Describeˉscan(Result: Wvaˉscan) -> text {
    var Description: text = Textˉconcat("status=", Statusˉtext(Result.Status));
    Description = Textˉconcat(Description, Textˉconcat(" bytes=", U32ˉformat(Result.Sourceˉbytes)));
    Description = Textˉconcat(Description, Textˉconcat(" lines=", U32ˉformat(Result.Lines)));
    Description = Textˉconcat(
        Description,
        Textˉconcat(" meaningful-lines=", U32ˉformat(Result.Meaningfulˉlines))
    );
    Description = Textˉconcat(Description, Textˉconcat(" tokens=", U32ˉformat(Result.Tokens)));
    Description = Textˉconcat(Description, Textˉconcat(" offset=", U32ˉformat(Result.Failureˉoffset)));
    Description = Textˉconcat(Description, Textˉconcat(" line=", U32ˉformat(Result.Failureˉline)));
    return Textˉconcat(Description, Textˉconcat(" column=", U32ˉformat(Result.Failureˉcolumn)));
}

fn Describeˉsemantics(Result: Wvaˉsemanticˉinspection) -> text {
    var Description: text = Textˉconcat("semantics status=", Semanticˉstatusˉtext(Result.Status));
    Description = Textˉconcat(Description, Textˉconcat(" sections=", U32ˉformat(Result.Sections)));
    Description = Textˉconcat(Description, Textˉconcat(" symbols=", U32ˉformat(Result.Symbols)));
    Description = Textˉconcat(Description, Textˉconcat(" definitions=", U32ˉformat(Result.Definitions)));
    Description = Textˉconcat(Description, Textˉconcat(" relocations=", U32ˉformat(Result.Relocations)));
    Description = Textˉconcat(Description, Textˉconcat(" data-bytes=", U32ˉformat(Result.Dataˉbytes)));
    Description = Textˉconcat(Description, Textˉconcat(" memory-bytes=", U32ˉformat(Result.Memoryˉbytes)));
    Description = Textˉconcat(Description, Textˉconcat(" offset=", U32ˉformat(Result.Failureˉoffset)));
    Description = Textˉconcat(Description, Textˉconcat(" line=", U32ˉformat(Result.Failureˉline)));
    return Textˉconcat(Description, Textˉconcat(" column=", U32ˉformat(Result.Failureˉcolumn)));
}

fn Describeˉencoding(Result: Wvaˉobjectˉencoding) -> text {
    var Description: text = Textˉconcat("assembly status=", Semanticˉstatusˉtext(Result.Status));
    Description = Textˉconcat(Description, Textˉconcat(" object-bytes=", U32ˉformat(Result.Objectˉbytes)));
    Description = Textˉconcat(Description, Textˉconcat(" sections=", U32ˉformat(Result.Sections)));
    Description = Textˉconcat(Description, Textˉconcat(" symbols=", U32ˉformat(Result.Symbols)));
    Description = Textˉconcat(Description, Textˉconcat(" relocations=", U32ˉformat(Result.Relocations)));
    Description = Textˉconcat(Description, Textˉconcat(" offset=", U32ˉformat(Result.Failureˉoffset)));
    Description = Textˉconcat(Description, Textˉconcat(" line=", U32ˉformat(Result.Failureˉline)));
    return Textˉconcat(Description, Textˉconcat(" column=", U32ˉformat(Result.Failureˉcolumn)));
}

fn Repeatˉbytes(Count: u32) -> bytes {
    let Result: Foundationˉbytesˉresult = Foundationˉbytesˉrepeat(97u8, Count);
    return Result.Value;
}

fn Runˉselfˉtests() -> i32 {
    let Valid: Wvaˉscan = Scanˉwva(Textˉtoˉutf8(Validˉsource));
    if Valid.Status != Wvaˉscanˉstatus.Valid { return 11; }
    if Valid.Meaningfulˉlines != 8u32 { return 21; }
    if Valid.Tokens != 23u32 { return 31; }

    let Cr: Wvaˉscan = Scanˉwva(Textˉtoˉutf8(Crˉsource));
    if Cr.Status != Wvaˉscanˉstatus.Valid { return 12; }
    if Cr.Meaningfulˉlines != 7u32 { return 22; }

    let Bad: Wvaˉscan = Scanˉwva(Textˉtoˉutf8(Badˉheaderˉsource));
    if Bad.Status != Wvaˉscanˉstatus.Badˉheader { return 13; }
    if Bad.Failureˉline != 1u32 { return 23; }
    if Bad.Failureˉcolumn != 19u32 { return 33; }

    let Extra: Wvaˉscan = Scanˉwva(Textˉtoˉutf8(Extraˉheaderˉsource));
    if Extra.Status != Wvaˉscanˉstatus.Badˉheader { return 14; }
    if Extra.Failureˉcolumn != 21u32 { return 24; }

    let Missing: Wvaˉscan = Scanˉwva(Textˉtoˉutf8(Missingˉheaderˉsource));
    if Missing.Status != Wvaˉscanˉstatus.Missingˉheader { return 15; }

    let Invalid: Wvaˉscan = Scanˉwva(Invalidˉutf8ˉsource);
    if Invalid.Status != Wvaˉscanˉstatus.Invalidˉutf8 { return 16; }

    let Long: Wvaˉscan = Scanˉwva(Repeatˉbytes(4097u32));
    if Long.Status != Wvaˉscanˉstatus.Lineˉtooˉlong { return 17; }
    if Long.Failureˉoffset != 4096u32 { return 27; }
    if Long.Failureˉcolumn != 4097u32 { return 37; }

    let Semantic: Wvaˉsemanticˉinspection = Inspectˉwvaˉsemantics(Textˉtoˉutf8(Validˉsource));
    if Semantic.Status != Wvaˉsemanticˉstatus.Valid { return 41; }
    if Semantic.Sections != 1u32 { return 51; }
    if Semantic.Symbols != 1u32 { return 61; }
    if Semantic.Definitions != 1u32 { return 71; }
    if Semantic.Relocations != 0u32 { return 81; }
    if Semantic.Dataˉbytes != 6u32 { return 91; }
    if Semantic.Memoryˉbytes != 6u32 { return 101; }

    let Missingˉreference: Wvaˉsemanticˉinspection = Inspectˉwvaˉsemantics(
        Textˉtoˉutf8(Missingˉreferenceˉsource)
    );
    if Missingˉreference.Status != Wvaˉsemanticˉstatus.Wva1009 { return 42; }

    let Wrongˉcontext: Wvaˉsemanticˉinspection = Inspectˉwvaˉsemantics(
        Textˉtoˉutf8(Wrongˉcontextˉsource)
    );
    if Wrongˉcontext.Status != Wvaˉsemanticˉstatus.Wva1008 { return 43; }

    let Semanticˉheader: Wvaˉsemanticˉinspection = Inspectˉwvaˉsemantics(
        Textˉtoˉutf8(Badˉheaderˉsource)
    );
    if Semanticˉheader.Status != Wvaˉsemanticˉstatus.Wva1001 { return 44; }

    let Encoded: Wvaˉobjectˉencoding = Encodeˉwva(Textˉtoˉutf8(Validˉsource));
    if Encoded.Status != Wvaˉsemanticˉstatus.Valid { return 45; }
    if Encoded.Objectˉbytes != 79u32 { return 55; }
    if Bytesˉlength(Encoded.Contents) != 79u32 { return 65; }
    if Bytesˉreadˉu32ˉlittle(Encoded.Contents, 0u32) != 827283031u32 { return 75; }
    if Bytesˉreadˉu32ˉlittle(Encoded.Contents, 12u32) != 1u32 { return 85; }
    if Bytesˉreadˉu32ˉlittle(Encoded.Contents, 16u32) != 1u32 { return 95; }
    if Bytesˉreadˉu8(Encoded.Contents, 49u32) != 184u8 { return 105; }
    if Bytesˉreadˉi32ˉlittle(Encoded.Contents, 50u32) != 42 { return 115; }
    if Bytesˉreadˉu8(Encoded.Contents, 54u32) != 195u8 { return 125; }

    let Rejectedˉencoding: Wvaˉobjectˉencoding = Encodeˉwva(
        Textˉtoˉutf8(Missingˉreferenceˉsource)
    );
    if Rejectedˉencoding.Status != Wvaˉsemanticˉstatus.Wva1009 { return 46; }
    if Bytesˉlength(Rejectedˉencoding.Contents) != 0u32 { return 56; }

    Describeˉscan(Valid);
    Describeˉsemantics(Semantic);
    Describeˉencoding(Encoded);
    return 0;
}

fn Runˉfileˉassembly() -> i32 {
    if process.argument_count() != 2u32 {
        diagnostic.write_line("Usage: wvasm <source.wva> <output.wvo>");
        return 64;
    }

    let Input: bytes = file.read_bytes(process.argument(0u32));
    let Encoding: Wvaˉobjectˉencoding = Encodeˉwva(Input);
    let Description: text = Describeˉencoding(Encoding);
    if Encoding.Status != Wvaˉsemanticˉstatus.Valid {
        diagnostic.write_line(Description);
        return 2;
    }

    file.write_bytes(process.argument(1u32), Encoding.Contents);
    console.write_line("wvasm 1");
    console.write_line(Description);
    return 0;
}

export fn Main() -> i32 {
    if process.argument_count() == 0u32 {
        return Runˉselfˉtests();
    }
    return Runˉfileˉassembly();
}
