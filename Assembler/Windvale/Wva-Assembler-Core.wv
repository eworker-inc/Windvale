fn Memoryˉstatementˉkind(Input: bytes, Value: Wvaˉtoken) -> u32 {
    if Tokenˉequalsˉtext(Input, Value, "load_memory_u32") { return 53u32; }
    if Tokenˉequalsˉtext(Input, Value, "load_memory_u64") { return 54u32; }
