module Windvaleˉdatabaseˉdurableˉcommitˉrecord profile portable;

import Foundationˉsha256ˉstreaming as Sha256;

const DATABASE_COMMIT_MAGIC: u32 = 1380144727u32;
const DATABASE_COMMIT_VERSION: u32 = 1u32;
const DATABASE_COMMIT_BYTES: u32 = 256u32;
const DATABASE_COMMIT_BODY_BYTES: u32 = 224u32;
const DATABASE_COMMIT_RESERVED_OFFSET: u32 = 128u32;
const DATABASE_COMMIT_CHECKSUM_OFFSET: u32 = 224u32;
const DATABASE_COMMIT_CHECKSUM_BYTES: u32 = 32u32;
const DATABASE_COMMIT_SUPERBLOCK_REGION_BYTES: u64 = 512u64;
const DATABASE_COMMIT_NO_PAGE: u64 = 18446744073709551615u64;
const U64_MAXIMUM: u64 = 18446744073709551615u64;

export enum Databaseˉcommitˉrecordˉerror {
    Valid = 0;
    Invalidˉlength = 1;
    Invalidˉmagic = 2;
    Unsupportedˉversion = 3;
    Invalidˉdeclaredˉsize = 4;
    Unsupportedˉflags = 5;
    Invalidˉreserved = 6;
    Invalidˉchecksum = 7;
    Invalidˉdatabaseˉidentity = 8;
    Invalidˉgeneration = 9;
    Invalidˉsequence = 10;
    Invalidˉpreviousˉlog = 11;
    Invalidˉpageˉsize = 12;
    Invalidˉallocation = 13;
    Invalidˉpageˉcount = 14;
    Invalidˉrootˉpage = 15;
    Invalidˉlogˉpage = 16;
    Invalidˉrootˉdepth = 17;
    Arithmeticˉoverflow = 18;
    Invalidˉcommittedˉlength = 19;
}

export record Databaseˉcommitˉrecord {
    Databaseˉidentityˉhigh: u64;
    Databaseˉidentityˉlow: u64;
    Generation: u64;
    Committedˉsequence: u64;
    Previousˉgeneration: u64;
    Previousˉsequence: u64;
    Rootˉpage: u64;
    Previousˉlogˉpage: u64;
    Logˉpage: u64;
    Firstˉallocatedˉpage: u64;
    Allocatedˉpageˉcount: u64;
    Pageˉcount: u64;
    Committedˉlength: u64;
    Pageˉsize: u32;
    Rootˉdepth: u32;
}

export record Databaseˉcommitˉrecordˉresult {
    Error: Databaseˉcommitˉrecordˉerror;
    Databaseˉidentityˉhigh: u64;
    Databaseˉidentityˉlow: u64;
    Generation: u64;
    Committedˉsequence: u64;
    Previousˉgeneration: u64;
    Previousˉsequence: u64;
    Rootˉpage: u64;
    Previousˉlogˉpage: u64;
    Logˉpage: u64;
    Firstˉallocatedˉpage: u64;
    Allocatedˉpageˉcount: u64;
    Pageˉcount: u64;
    Committedˉlength: u64;
    Pageˉsize: u32;
    Rootˉdepth: u32;
    Bytes: bytes;
}

record Databaseˉcommitˉlength {
    Error: Databaseˉcommitˉrecordˉerror;
    Length: u64;
}

fn Databaseˉcommitˉemptyˉbytes() -> bytes {
    let Unit: bytes = Bytesˉfromˉu8(0u8);
    return Bytesˉslice(Unit, 0u32, 0u32);
}

fn Databaseˉcommitˉfailure(
    Error: Databaseˉcommitˉrecordˉerror
) -> Databaseˉcommitˉrecordˉresult {
    return Databaseˉcommitˉrecordˉresult(
        Error,
        0u64,
        0u64,
        0u64,
        0u64,
        0u64,
        0u64,
        0u64,
        DATABASE_COMMIT_NO_PAGE,
        DATABASE_COMMIT_NO_PAGE,
        0u64,
        0u64,
        0u64,
        0u64,
        0u32,
        0u32,
        Databaseˉcommitˉemptyˉbytes()
    );
}

fn Databaseˉcommitˉpageˉsizeˉisˉvalid(Pageˉsize: u32) -> bool {
    return Pageˉsize == 4096u32 ||
        Pageˉsize == 8192u32 ||
        Pageˉsize == 16384u32 ||
        Pageˉsize == 32768u32 ||
        Pageˉsize == 65536u32;
}

fn Databaseˉcommitˉexpectedˉlength(
    Pageˉsize: u32,
    Pageˉcount: u64
) -> Databaseˉcommitˉlength {
    let Pageˉbytes: u64 = U64ˉfromˉu32(Pageˉsize);
    if Pageˉcount >
        (U64_MAXIMUM - DATABASE_COMMIT_SUPERBLOCK_REGION_BYTES) / Pageˉbytes {
        return Databaseˉcommitˉlength(
            Databaseˉcommitˉrecordˉerror.Arithmeticˉoverflow,
            0u64
        );
    }
    return Databaseˉcommitˉlength(
        Databaseˉcommitˉrecordˉerror.Valid,
        DATABASE_COMMIT_SUPERBLOCK_REGION_BYTES + Pageˉcount * Pageˉbytes
    );
}

fn Databaseˉcommitˉvalidate(
    Value: Databaseˉcommitˉrecord
) -> Databaseˉcommitˉrecordˉerror {
    if Value.Databaseˉidentityˉhigh == 0u64 &&
        Value.Databaseˉidentityˉlow == 0u64 {
        return Databaseˉcommitˉrecordˉerror.Invalidˉdatabaseˉidentity;
    }
    if Value.Previousˉgeneration == 0u64 ||
        Value.Previousˉgeneration == U64_MAXIMUM ||
        Value.Generation != Value.Previousˉgeneration + 1u64 {
        return Databaseˉcommitˉrecordˉerror.Invalidˉgeneration;
    }
    if Value.Committedˉsequence <= Value.Previousˉsequence {
        return Databaseˉcommitˉrecordˉerror.Invalidˉsequence;
    }
    if Value.Previousˉsequence == 0u64 {
        if Value.Previousˉlogˉpage != DATABASE_COMMIT_NO_PAGE {
            return Databaseˉcommitˉrecordˉerror.Invalidˉpreviousˉlog;
        }
    } else if Value.Previousˉlogˉpage == DATABASE_COMMIT_NO_PAGE ||
        Value.Previousˉlogˉpage >= Value.Firstˉallocatedˉpage {
        return Databaseˉcommitˉrecordˉerror.Invalidˉpreviousˉlog;
    }
    if !Databaseˉcommitˉpageˉsizeˉisˉvalid(Value.Pageˉsize) {
        return Databaseˉcommitˉrecordˉerror.Invalidˉpageˉsize;
    }
    if Value.Firstˉallocatedˉpage == 0u64 ||
        Value.Allocatedˉpageˉcount < 2u64 {
        return Databaseˉcommitˉrecordˉerror.Invalidˉallocation;
    }
    if Value.Firstˉallocatedˉpage >
        U64_MAXIMUM - Value.Allocatedˉpageˉcount {
        return Databaseˉcommitˉrecordˉerror.Arithmeticˉoverflow;
    }
    if Value.Pageˉcount !=
        Value.Firstˉallocatedˉpage + Value.Allocatedˉpageˉcount {
        return Databaseˉcommitˉrecordˉerror.Invalidˉpageˉcount;
    }
    if Value.Rootˉpage < Value.Firstˉallocatedˉpage ||
        Value.Rootˉpage >= Value.Pageˉcount {
        return Databaseˉcommitˉrecordˉerror.Invalidˉrootˉpage;
    }
    if Value.Logˉpage < Value.Firstˉallocatedˉpage ||
        Value.Logˉpage >= Value.Pageˉcount ||
        Value.Logˉpage != Value.Pageˉcount - 1u64 ||
        Value.Logˉpage == Value.Rootˉpage {
        return Databaseˉcommitˉrecordˉerror.Invalidˉlogˉpage;
    }
    if Value.Rootˉdepth == 0u32 || Value.Rootˉdepth > 128u32 {
        return Databaseˉcommitˉrecordˉerror.Invalidˉrootˉdepth;
    }
    let Length: Databaseˉcommitˉlength = Databaseˉcommitˉexpectedˉlength(
        Value.Pageˉsize,
        Value.Pageˉcount
    );
    if Length.Error != Databaseˉcommitˉrecordˉerror.Valid {
        return Length.Error;
    }
    if Length.Length != Value.Committedˉlength {
        return Databaseˉcommitˉrecordˉerror.Invalidˉcommittedˉlength;
    }
    return Databaseˉcommitˉrecordˉerror.Valid;
}

fn Databaseˉcommitˉdigest(Value: bytes) -> bytes {
    var State: Sha256.Foundationˉsha256ˉstream =
        Sha256.Foundationˉsha256ˉbegin(Value);
    State = Sha256.Foundationˉsha256ˉupdate(State, Value);
    return Sha256.Foundationˉsha256ˉfinishˉraw(State);
}

fn Databaseˉcommitˉbytesˉequal(First: bytes, Second: bytes) -> bool {
    let Length: u32 = Bytesˉlength(First);
    if Length != Bytesˉlength(Second) { return false; }
    var Index: u32 = 0u32;
    while Index < Length {
        if Bytesˉreadˉu8(First, Index) != Bytesˉreadˉu8(Second, Index) {
            return false;
        }
        Index = Index + 1u32;
    }
    return true;
}

export fn Databaseˉcommitˉrecordˉencode(
    Value: Databaseˉcommitˉrecord
) -> Databaseˉcommitˉrecordˉresult {
    let Error: Databaseˉcommitˉrecordˉerror =
        Databaseˉcommitˉvalidate(Value);
    if Error != Databaseˉcommitˉrecordˉerror.Valid {
        return Databaseˉcommitˉfailure(Error);
    }
    var Body: bytes = Bytesˉfromˉu32ˉlittle(DATABASE_COMMIT_MAGIC);
    Body = Bytesˉconcat(Body, Bytesˉfromˉu32ˉlittle(DATABASE_COMMIT_VERSION));
    Body = Bytesˉconcat(Body, Bytesˉfromˉu32ˉlittle(DATABASE_COMMIT_BYTES));
    Body = Bytesˉconcat(Body, Bytesˉfromˉu32ˉlittle(0u32));
    Body = Bytesˉconcat(Body, Bytesˉfromˉu64ˉlittle(Value.Databaseˉidentityˉhigh));
    Body = Bytesˉconcat(Body, Bytesˉfromˉu64ˉlittle(Value.Databaseˉidentityˉlow));
    Body = Bytesˉconcat(Body, Bytesˉfromˉu64ˉlittle(Value.Generation));
    Body = Bytesˉconcat(Body, Bytesˉfromˉu64ˉlittle(Value.Committedˉsequence));
    Body = Bytesˉconcat(Body, Bytesˉfromˉu64ˉlittle(Value.Previousˉgeneration));
    Body = Bytesˉconcat(Body, Bytesˉfromˉu64ˉlittle(Value.Previousˉsequence));
    Body = Bytesˉconcat(Body, Bytesˉfromˉu64ˉlittle(Value.Rootˉpage));
    Body = Bytesˉconcat(Body, Bytesˉfromˉu64ˉlittle(Value.Previousˉlogˉpage));
    Body = Bytesˉconcat(Body, Bytesˉfromˉu64ˉlittle(Value.Logˉpage));
    Body = Bytesˉconcat(Body, Bytesˉfromˉu64ˉlittle(Value.Firstˉallocatedˉpage));
    Body = Bytesˉconcat(Body, Bytesˉfromˉu64ˉlittle(Value.Allocatedˉpageˉcount));
    Body = Bytesˉconcat(Body, Bytesˉfromˉu64ˉlittle(Value.Pageˉcount));
    Body = Bytesˉconcat(Body, Bytesˉfromˉu64ˉlittle(Value.Committedˉlength));
    Body = Bytesˉconcat(Body, Bytesˉfromˉu32ˉlittle(Value.Pageˉsize));
    Body = Bytesˉconcat(Body, Bytesˉfromˉu32ˉlittle(Value.Rootˉdepth));
    var Reservedˉoffset: u32 = DATABASE_COMMIT_RESERVED_OFFSET;
    while Reservedˉoffset < DATABASE_COMMIT_BODY_BYTES {
        Body = Bytesˉconcat(Body, Bytesˉfromˉu64ˉlittle(0u64));
        Reservedˉoffset = Reservedˉoffset + 8u32;
    }
    let Digest: bytes = Databaseˉcommitˉdigest(Body);
    if Bytesˉlength(Body) != DATABASE_COMMIT_BODY_BYTES ||
        Bytesˉlength(Digest) != DATABASE_COMMIT_CHECKSUM_BYTES {
        return Databaseˉcommitˉfailure(
            Databaseˉcommitˉrecordˉerror.Invalidˉchecksum
        );
    }
    return Databaseˉcommitˉrecordˉresult(
        Databaseˉcommitˉrecordˉerror.Valid,
        Value.Databaseˉidentityˉhigh,
        Value.Databaseˉidentityˉlow,
        Value.Generation,
        Value.Committedˉsequence,
        Value.Previousˉgeneration,
        Value.Previousˉsequence,
        Value.Rootˉpage,
        Value.Previousˉlogˉpage,
        Value.Logˉpage,
        Value.Firstˉallocatedˉpage,
        Value.Allocatedˉpageˉcount,
        Value.Pageˉcount,
        Value.Committedˉlength,
        Value.Pageˉsize,
        Value.Rootˉdepth,
        Bytesˉconcat(Body, Digest)
    );
}

export fn Databaseˉcommitˉrecordˉdecode(
    Input: bytes
) -> Databaseˉcommitˉrecordˉresult {
    if Bytesˉlength(Input) != DATABASE_COMMIT_BYTES {
        return Databaseˉcommitˉfailure(
            Databaseˉcommitˉrecordˉerror.Invalidˉlength
        );
    }
    if Bytesˉreadˉu32ˉlittle(Input, 0u32) != DATABASE_COMMIT_MAGIC {
        return Databaseˉcommitˉfailure(
            Databaseˉcommitˉrecordˉerror.Invalidˉmagic
        );
    }
    if Bytesˉreadˉu32ˉlittle(Input, 4u32) != DATABASE_COMMIT_VERSION {
        return Databaseˉcommitˉfailure(
            Databaseˉcommitˉrecordˉerror.Unsupportedˉversion
        );
    }
    if Bytesˉreadˉu32ˉlittle(Input, 8u32) != DATABASE_COMMIT_BYTES {
        return Databaseˉcommitˉfailure(
            Databaseˉcommitˉrecordˉerror.Invalidˉdeclaredˉsize
        );
    }
    if Bytesˉreadˉu32ˉlittle(Input, 12u32) != 0u32 {
        return Databaseˉcommitˉfailure(
            Databaseˉcommitˉrecordˉerror.Unsupportedˉflags
        );
    }
    var Reservedˉoffset: u32 = DATABASE_COMMIT_RESERVED_OFFSET;
    while Reservedˉoffset < DATABASE_COMMIT_CHECKSUM_OFFSET {
        if Bytesˉreadˉu8(Input, Reservedˉoffset) != 0u8 {
            return Databaseˉcommitˉfailure(
                Databaseˉcommitˉrecordˉerror.Invalidˉreserved
            );
        }
        Reservedˉoffset = Reservedˉoffset + 1u32;
    }
    let Body: bytes = Bytesˉslice(Input, 0u32, DATABASE_COMMIT_BODY_BYTES);
    let Storedˉchecksum: bytes = Bytesˉslice(
        Input,
        DATABASE_COMMIT_CHECKSUM_OFFSET,
        DATABASE_COMMIT_CHECKSUM_BYTES
    );
    if !Databaseˉcommitˉbytesˉequal(
        Storedˉchecksum,
        Databaseˉcommitˉdigest(Body)
    ) {
        return Databaseˉcommitˉfailure(
            Databaseˉcommitˉrecordˉerror.Invalidˉchecksum
        );
    }
    let Value: Databaseˉcommitˉrecord = Databaseˉcommitˉrecord(
        Bytesˉreadˉu64ˉlittle(Input, 16u32),
        Bytesˉreadˉu64ˉlittle(Input, 24u32),
        Bytesˉreadˉu64ˉlittle(Input, 32u32),
        Bytesˉreadˉu64ˉlittle(Input, 40u32),
        Bytesˉreadˉu64ˉlittle(Input, 48u32),
        Bytesˉreadˉu64ˉlittle(Input, 56u32),
        Bytesˉreadˉu64ˉlittle(Input, 64u32),
        Bytesˉreadˉu64ˉlittle(Input, 72u32),
        Bytesˉreadˉu64ˉlittle(Input, 80u32),
        Bytesˉreadˉu64ˉlittle(Input, 88u32),
        Bytesˉreadˉu64ˉlittle(Input, 96u32),
        Bytesˉreadˉu64ˉlittle(Input, 104u32),
        Bytesˉreadˉu64ˉlittle(Input, 112u32),
        Bytesˉreadˉu32ˉlittle(Input, 120u32),
        Bytesˉreadˉu32ˉlittle(Input, 124u32)
    );
    let Error: Databaseˉcommitˉrecordˉerror =
        Databaseˉcommitˉvalidate(Value);
    if Error != Databaseˉcommitˉrecordˉerror.Valid {
        return Databaseˉcommitˉfailure(Error);
    }
    return Databaseˉcommitˉrecordˉresult(
        Databaseˉcommitˉrecordˉerror.Valid,
        Value.Databaseˉidentityˉhigh,
        Value.Databaseˉidentityˉlow,
        Value.Generation,
        Value.Committedˉsequence,
        Value.Previousˉgeneration,
        Value.Previousˉsequence,
        Value.Rootˉpage,
        Value.Previousˉlogˉpage,
        Value.Logˉpage,
        Value.Firstˉallocatedˉpage,
        Value.Allocatedˉpageˉcount,
        Value.Pageˉcount,
        Value.Committedˉlength,
        Value.Pageˉsize,
        Value.Rootˉdepth,
        Input
    );
}
