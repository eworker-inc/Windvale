module Windvaleˉdatabaseˉtransactionˉrootˉgrowth profile portable;

import Foundationˉsha256ˉstreaming as Sha256;
import Windvaleˉdatabaseˉdurableˉpage as Page;
import Windvaleˉdatabaseˉdurableˉsuperblock as Superblock;
import Windvaleˉdatabaseˉtransactionˉbranchˉpartition as Partition;
import Windvaleˉdatabaseˉtransactionˉchildˉreplacements as Replacements;
import Windvaleˉdatabaseˉtreeˉnode as Tree;

const DATABASE_TRANSACTION_ROOT_GROWTH_MAGIC: u32 = 1196578391u32;
const DATABASE_TRANSACTION_ROOT_GROWTH_VERSION: u32 = 1u32;
const DATABASE_TRANSACTION_ROOT_GROWTH_HEADER_BYTES: u32 = 168u32;
const DATABASE_TRANSACTION_ROOT_GROWTH_MAXIMUM_REPLACEMENT_BYTES: u32 = 524288u32;
const DATABASE_TRANSACTION_ROOT_GROWTH_MAXIMUM_CHILDREN: u32 = 64u32;
const DATABASE_TRANSACTION_ROOT_GROWTH_MAXIMUM_ROUNDS: u32 = 6u32;
const DATABASE_TRANSACTION_ROOT_GROWTH_MAXIMUM_PAGES: u32 = 63u32;
const DATABASE_TRANSACTION_ROOT_GROWTH_NO_PAGE: u64 = 18446744073709551615u64;
const U64_MAXIMUM: u64 = 18446744073709551615u64;

export enum Databaseˉtransactionˉrootˉgrowthˉerror {
    Valid = 0;
    Invalidˉcurrent = 1;
    Invalidˉreplacements = 2;
    Inconsistentˉinput = 3;
    Depthˉexhausted = 4;
    Pageˉidentifierˉexhausted = 5;
    Partitionˉfailed = 6;
    Invalidˉpartition = 7;
    Replacementˉfailed = 8;
    Pageˉencodeˉfailed = 9;
    Tooˉmanyˉpages = 10;
    Invalidˉoutput = 11;
    Invalidˉlength = 12;
    Invalidˉmagic = 13;
    Unsupportedˉversion = 14;
    Invalidˉheader = 15;
    Invalidˉflags = 16;
    Invalidˉcount = 17;
    Invalidˉtotalˉlength = 18;
    Invalidˉdigest = 19;
    Invalidˉpage = 20;
}

export record Databaseˉtransactionˉrootˉgrowthˉresult {
    Error: Databaseˉtransactionˉrootˉgrowthˉerror;
    Failedˉround: u32;
    Pageˉsize: u32;
    Inputˉrootˉdepth: u32;
    Outputˉrootˉdepth: u32;
    Roundˉcount: u32;
    Pageˉcount: u32;
    Inputˉchildˉcount: u32;
    Targetˉgeneration: u64;
    Targetˉsequence: u64;
    Firstˉallocationˉpage: u64;
    Firstˉpage: u64;
    Nextˉpage: u64;
    Rootˉpage: u64;
    Replacements: bytes;
    Pages: bytes;
    Bytes: bytes;
}

fn Databaseˉtransactionˉrootˉgrowthˉempty() -> bytes {
    return Bytesˉslice(Bytesˉfromˉu8(0u8), 0u32, 0u32);
}

fn Databaseˉtransactionˉrootˉgrowthˉcopy(Input: bytes) -> bytes {
    let Total: u32 = Bytesˉlength(Input);
    if Total == 0u32 { return Databaseˉtransactionˉrootˉgrowthˉempty(); }
    return Bytesˉslice(Bytesˉconcat(Bytesˉfromˉu8(0u8), Input), 1u32, Total);
}

fn Databaseˉtransactionˉrootˉgrowthˉsame(Left: bytes, Right: bytes) -> bool {
    let Total: u32 = Bytesˉlength(Left);
    if Total != Bytesˉlength(Right) { return false; }
    var Index: u32 = 0u32;
    while Index < Total {
        if Bytesˉreadˉu8(Left, Index) != Bytesˉreadˉu8(Right, Index) {
            return false;
        }
        Index = Index + 1u32;
    }
    return true;
}

fn Databaseˉtransactionˉrootˉgrowthˉhash(Input: bytes) -> bytes {
    var State: Sha256.Foundationˉsha256ˉstream =
        Sha256.Foundationˉsha256ˉbegin(Input);
    State = Sha256.Foundationˉsha256ˉupdate(State, Input);
    return Sha256.Foundationˉsha256ˉfinishˉraw(State);
}

fn Databaseˉtransactionˉrootˉgrowthˉfailure(
    Error: Databaseˉtransactionˉrootˉgrowthˉerror,
    Failedˉround: u32
) -> Databaseˉtransactionˉrootˉgrowthˉresult {
    let Empty: bytes = Databaseˉtransactionˉrootˉgrowthˉempty();
    return Databaseˉtransactionˉrootˉgrowthˉresult(
        Error, Failedˉround, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32,
        0u64, 0u64, DATABASE_TRANSACTION_ROOT_GROWTH_NO_PAGE,
        DATABASE_TRANSACTION_ROOT_GROWTH_NO_PAGE,
        DATABASE_TRANSACTION_ROOT_GROWTH_NO_PAGE,
        DATABASE_TRANSACTION_ROOT_GROWTH_NO_PAGE,
        Empty, Empty, Empty
    );
}

fn Databaseˉtransactionˉrootˉgrowthˉsimpleˉfailure(
    Error: Databaseˉtransactionˉrootˉgrowthˉerror
) -> Databaseˉtransactionˉrootˉgrowthˉresult {
    return Databaseˉtransactionˉrootˉgrowthˉfailure(Error, 0u32);
}

fn Databaseˉtransactionˉrootˉgrowthˉencode(
    Pageˉsize: u32,
    Inputˉrootˉdepth: u32,
    Outputˉrootˉdepth: u32,
    Roundˉcount: u32,
    Pageˉcount: u32,
    Inputˉchildˉcount: u32,
    Targetˉgeneration: u64,
    Targetˉsequence: u64,
    Firstˉallocationˉpage: u64,
    Firstˉpage: u64,
    Nextˉpage: u64,
    Rootˉpage: u64,
    Replacements: bytes,
    Pages: bytes
) -> bytes {
    var Result: bytes = Bytesˉfromˉu32ˉlittle(
        DATABASE_TRANSACTION_ROOT_GROWTH_MAGIC
    );
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(
        DATABASE_TRANSACTION_ROOT_GROWTH_VERSION
    ));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(
        DATABASE_TRANSACTION_ROOT_GROWTH_HEADER_BYTES
    ));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(3u32));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Pageˉsize));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Inputˉrootˉdepth));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Outputˉrootˉdepth));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Roundˉcount));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Pageˉcount));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Inputˉchildˉcount));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Bytesˉlength(Replacements)));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Bytesˉlength(Pages)));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu64ˉlittle(Targetˉgeneration));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu64ˉlittle(Targetˉsequence));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu64ˉlittle(Firstˉallocationˉpage));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu64ˉlittle(Firstˉpage));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu64ˉlittle(Nextˉpage));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu64ˉlittle(Rootˉpage));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(
        DATABASE_TRANSACTION_ROOT_GROWTH_HEADER_BYTES
    ));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(0u32));
    Result = Bytesˉconcat(
        Result, Databaseˉtransactionˉrootˉgrowthˉhash(Replacements)
    );
    return Bytesˉconcat(
        Result, Databaseˉtransactionˉrootˉgrowthˉhash(Pages)
    );
}

fn Databaseˉtransactionˉrootˉgrowthˉwithˉcompanions(
    Value: Databaseˉtransactionˉrootˉgrowthˉresult,
    Replacements: bytes,
    Pages: bytes
) -> Databaseˉtransactionˉrootˉgrowthˉresult {
    return Databaseˉtransactionˉrootˉgrowthˉresult(
        Value.Error, Value.Failedˉround, Value.Pageˉsize,
        Value.Inputˉrootˉdepth, Value.Outputˉrootˉdepth,
        Value.Roundˉcount, Value.Pageˉcount, Value.Inputˉchildˉcount,
        Value.Targetˉgeneration, Value.Targetˉsequence,
        Value.Firstˉallocationˉpage, Value.Firstˉpage,
        Value.Nextˉpage, Value.Rootˉpage,
        Databaseˉtransactionˉrootˉgrowthˉcopy(Replacements),
        Databaseˉtransactionˉrootˉgrowthˉcopy(Pages), Value.Bytes
    );
}

export fn Databaseˉtransactionˉrootˉgrowthˉdecode(
    Input: bytes
) -> Databaseˉtransactionˉrootˉgrowthˉresult {
    let Total: u32 = Bytesˉlength(Input);
    if Total != DATABASE_TRANSACTION_ROOT_GROWTH_HEADER_BYTES {
        return Databaseˉtransactionˉrootˉgrowthˉsimpleˉfailure(
            Databaseˉtransactionˉrootˉgrowthˉerror.Invalidˉlength
        );
    }
    if Bytesˉreadˉu32ˉlittle(Input, 0u32) !=
            DATABASE_TRANSACTION_ROOT_GROWTH_MAGIC {
        return Databaseˉtransactionˉrootˉgrowthˉsimpleˉfailure(
            Databaseˉtransactionˉrootˉgrowthˉerror.Invalidˉmagic
        );
    }
    if Bytesˉreadˉu32ˉlittle(Input, 4u32) !=
            DATABASE_TRANSACTION_ROOT_GROWTH_VERSION {
        return Databaseˉtransactionˉrootˉgrowthˉsimpleˉfailure(
            Databaseˉtransactionˉrootˉgrowthˉerror.Unsupportedˉversion
        );
    }
    if Bytesˉreadˉu32ˉlittle(Input, 8u32) !=
            DATABASE_TRANSACTION_ROOT_GROWTH_HEADER_BYTES ||
        Bytesˉreadˉu32ˉlittle(Input, 100u32) != 0u32 {
        return Databaseˉtransactionˉrootˉgrowthˉsimpleˉfailure(
            Databaseˉtransactionˉrootˉgrowthˉerror.Invalidˉheader
        );
    }
    if Bytesˉreadˉu32ˉlittle(Input, 12u32) != 3u32 {
        return Databaseˉtransactionˉrootˉgrowthˉsimpleˉfailure(
            Databaseˉtransactionˉrootˉgrowthˉerror.Invalidˉflags
        );
    }
    let Pageˉsize: u32 = Bytesˉreadˉu32ˉlittle(Input, 16u32);
    let Inputˉdepth: u32 = Bytesˉreadˉu32ˉlittle(Input, 20u32);
    let Outputˉdepth: u32 = Bytesˉreadˉu32ˉlittle(Input, 24u32);
    let Rounds: u32 = Bytesˉreadˉu32ˉlittle(Input, 28u32);
    let Pageˉcount: u32 = Bytesˉreadˉu32ˉlittle(Input, 32u32);
    let Childˉcount: u32 = Bytesˉreadˉu32ˉlittle(Input, 36u32);
    let Replacementˉlength: u32 = Bytesˉreadˉu32ˉlittle(Input, 40u32);
    let Pagesˉlength: u32 = Bytesˉreadˉu32ˉlittle(Input, 44u32);
    let Generation: u64 = Bytesˉreadˉu64ˉlittle(Input, 48u32);
    let Sequence: u64 = Bytesˉreadˉu64ˉlittle(Input, 56u32);
    let Firstˉallocation: u64 = Bytesˉreadˉu64ˉlittle(Input, 64u32);
    let Firstˉpage: u64 = Bytesˉreadˉu64ˉlittle(Input, 72u32);
    let Nextˉpage: u64 = Bytesˉreadˉu64ˉlittle(Input, 80u32);
    let Rootˉpage: u64 = Bytesˉreadˉu64ˉlittle(Input, 88u32);
    if Bytesˉreadˉu32ˉlittle(Input, 96u32) != Total {
        return Databaseˉtransactionˉrootˉgrowthˉsimpleˉfailure(
            Databaseˉtransactionˉrootˉgrowthˉerror.Invalidˉtotalˉlength
        );
    }
    if Pageˉsize != 4096u32 && Pageˉsize != 8192u32 &&
        Pageˉsize != 16384u32 && Pageˉsize != 32768u32 &&
        Pageˉsize != 65536u32 ||
        Inputˉdepth < 2u32 || Inputˉdepth >= 8u32 ||
        Outputˉdepth <= Inputˉdepth || Outputˉdepth > 8u32 ||
        Rounds == 0u32 || Rounds > DATABASE_TRANSACTION_ROOT_GROWTH_MAXIMUM_ROUNDS ||
        Outputˉdepth != Inputˉdepth + Rounds ||
        Pageˉcount == 0u32 ||
        Pageˉcount > DATABASE_TRANSACTION_ROOT_GROWTH_MAXIMUM_PAGES ||
        Childˉcount < 2u32 ||
        Childˉcount > DATABASE_TRANSACTION_ROOT_GROWTH_MAXIMUM_CHILDREN ||
        Replacementˉlength < 40u32 ||
        Replacementˉlength > DATABASE_TRANSACTION_ROOT_GROWTH_MAXIMUM_REPLACEMENT_BYTES ||
        Pagesˉlength != Pageˉcount * Pageˉsize ||
        Generation == 0u64 ||
        Firstˉallocation == DATABASE_TRANSACTION_ROOT_GROWTH_NO_PAGE ||
        Firstˉpage < Firstˉallocation ||
        Firstˉpage == DATABASE_TRANSACTION_ROOT_GROWTH_NO_PAGE ||
        Firstˉpage > U64_MAXIMUM - U64ˉfromˉu32(Pageˉcount) ||
        Nextˉpage != Firstˉpage + U64ˉfromˉu32(Pageˉcount) ||
        Rootˉpage != Nextˉpage - 1u64 {
        return Databaseˉtransactionˉrootˉgrowthˉsimpleˉfailure(
            Databaseˉtransactionˉrootˉgrowthˉerror.Invalidˉcount
        );
    }
    let Empty: bytes = Databaseˉtransactionˉrootˉgrowthˉempty();
    return Databaseˉtransactionˉrootˉgrowthˉresult(
        Databaseˉtransactionˉrootˉgrowthˉerror.Valid, 0u32,
        Pageˉsize, Inputˉdepth, Outputˉdepth, Rounds, Pageˉcount,
        Childˉcount, Generation, Sequence, Firstˉallocation,
        Firstˉpage, Nextˉpage, Rootˉpage, Empty, Empty,
        Databaseˉtransactionˉrootˉgrowthˉcopy(Input)
    );
}

fn Databaseˉtransactionˉrootˉgrowthˉnextˉreplacements(
    Originalˉroot: u64,
    Firstˉpage: u64,
    Partitionˉbytes: bytes,
    Branchˉcount: u32
) -> Replacements.Databaseˉtransactionˉchildˉreplacementsˉresult {
    var Children: bytes = Databaseˉtransactionˉrootˉgrowthˉempty();
    var Index: u32 = 0u32;
    while Index < Branchˉcount {
        let Branch: Partition.Databaseˉtransactionˉbranchˉpartitionˉbranch =
            Partition.Databaseˉtransactionˉbranchˉpartitionˉread(
                Partitionˉbytes, Index
            );
        if Branch.Error != Partition.Databaseˉtransactionˉbranchˉpartitionˉerror.Valid {
            return Replacements.Databaseˉtransactionˉchildˉreplacementsˉdecode(
                Databaseˉtransactionˉrootˉgrowthˉempty()
            );
        }
        let Child: Replacements.Databaseˉtransactionˉchildˉreplacementˉcomponent =
            Replacements.Databaseˉtransactionˉchildˉreplacementˉchildˉencode(
                Firstˉpage + U64ˉfromˉu32(Index), Branch.Separator
            );
        if Child.Error !=
                Replacements.Databaseˉtransactionˉchildˉreplacementsˉerror.Valid {
            return Replacements.Databaseˉtransactionˉchildˉreplacementsˉdecode(
                Databaseˉtransactionˉrootˉgrowthˉempty()
            );
        }
        Children = Bytesˉconcat(Children, Child.Bytes);
        Index = Index + 1u32;
    }
    let Group: Replacements.Databaseˉtransactionˉchildˉreplacementˉcomponent =
        Replacements.Databaseˉtransactionˉchildˉreplacementˉgroupˉencode(
            Originalˉroot, Firstˉpage, Branchˉcount, Children
        );
    if Group.Error !=
            Replacements.Databaseˉtransactionˉchildˉreplacementsˉerror.Valid {
        return Replacements.Databaseˉtransactionˉchildˉreplacementsˉdecode(
            Databaseˉtransactionˉrootˉgrowthˉempty()
        );
    }
    return Replacements.Databaseˉtransactionˉchildˉreplacementsˉencode(
        1u32, Branchˉcount, Firstˉpage, Group.Bytes
    );
}

export fn Databaseˉtransactionˉrootˉgrowthˉvalidate(
    Manifestˉbytes: bytes,
    Replacementsˉbytes: bytes,
    Pageˉbytes: bytes
) -> Databaseˉtransactionˉrootˉgrowthˉresult {
    let Manifest: Databaseˉtransactionˉrootˉgrowthˉresult =
        Databaseˉtransactionˉrootˉgrowthˉdecode(Manifestˉbytes);
    if Manifest.Error != Databaseˉtransactionˉrootˉgrowthˉerror.Valid {
        return Manifest;
    }
    if Bytesˉlength(Replacementsˉbytes) !=
            Bytesˉreadˉu32ˉlittle(Manifest.Bytes, 40u32) ||
        Bytesˉlength(Pageˉbytes) !=
            Bytesˉreadˉu32ˉlittle(Manifest.Bytes, 44u32) ||
        !Databaseˉtransactionˉrootˉgrowthˉsame(
            Bytesˉslice(Manifest.Bytes, 104u32, 32u32),
            Databaseˉtransactionˉrootˉgrowthˉhash(Replacementsˉbytes)
        ) ||
        !Databaseˉtransactionˉrootˉgrowthˉsame(
            Bytesˉslice(Manifest.Bytes, 136u32, 32u32),
            Databaseˉtransactionˉrootˉgrowthˉhash(Pageˉbytes)
        ) {
        return Databaseˉtransactionˉrootˉgrowthˉsimpleˉfailure(
            Databaseˉtransactionˉrootˉgrowthˉerror.Invalidˉdigest
        );
    }
    let Initial: Replacements.Databaseˉtransactionˉchildˉreplacementsˉresult =
        Replacements.Databaseˉtransactionˉchildˉreplacementsˉdecode(
            Replacementsˉbytes
        );
    let Initialˉgroup: Replacements.Databaseˉtransactionˉchildˉreplacementˉgroup =
        Replacements.Databaseˉtransactionˉchildˉreplacementˉgroupˉread(
            Replacementsˉbytes, 0u32
        );
    if Initial.Error !=
            Replacements.Databaseˉtransactionˉchildˉreplacementsˉerror.Valid ||
        Initial.Groupˉcount != 1u32 ||
        Initial.Replacementˉcount != Manifest.Inputˉchildˉcount ||
        Initialˉgroup.Error !=
            Replacements.Databaseˉtransactionˉchildˉreplacementsˉerror.Valid ||
        Initialˉgroup.Originalˉchild >= Manifest.Firstˉallocationˉpage ||
        Initialˉgroup.Firstˉpage < Manifest.Firstˉallocationˉpage ||
        Initialˉgroup.Firstˉpage + U64ˉfromˉu32(Initialˉgroup.Replacementˉcount) !=
            Manifest.Firstˉpage {
        return Databaseˉtransactionˉrootˉgrowthˉsimpleˉfailure(
            Databaseˉtransactionˉrootˉgrowthˉerror.Inconsistentˉinput
        );
    }
    var Currentˉreplacements: bytes = Replacementsˉbytes;
    var Nextˉpage: u64 = Manifest.Firstˉpage;
    var Counted: u32 = 0u32;
    var Round: u32 = 0u32;
    var Rootˉpage: u64 = DATABASE_TRANSACTION_ROOT_GROWTH_NO_PAGE;
    while Rootˉpage == DATABASE_TRANSACTION_ROOT_GROWTH_NO_PAGE {
        if Round >= Manifest.Roundˉcount {
            return Databaseˉtransactionˉrootˉgrowthˉfailure(
                Databaseˉtransactionˉrootˉgrowthˉerror.Invalidˉcount, Round
            );
        }
        let Packed: Partition.Databaseˉtransactionˉbranchˉpartitionˉresult =
            Partition.Databaseˉtransactionˉbranchˉpartitionˉrootˉchildren(
                Currentˉreplacements, Manifest.Pageˉsize - 128u32
            );
        if Packed.Error != Partition.Databaseˉtransactionˉbranchˉpartitionˉerror.Valid {
            return Databaseˉtransactionˉrootˉgrowthˉfailure(
                Databaseˉtransactionˉrootˉgrowthˉerror.Partitionˉfailed, Round
            );
        }
        let Roundˉfirst: u64 = Nextˉpage;
        var Index: u32 = 0u32;
        while Index < Packed.Branchˉcount {
            if Counted >= Manifest.Pageˉcount {
                return Databaseˉtransactionˉrootˉgrowthˉfailure(
                    Databaseˉtransactionˉrootˉgrowthˉerror.Invalidˉcount, Round
                );
            }
            let Branch: Partition.Databaseˉtransactionˉbranchˉpartitionˉbranch =
                Partition.Databaseˉtransactionˉbranchˉpartitionˉread(
                    Packed.Bytes, Index
                );
            let Durable: Page.Databaseˉdurableˉpageˉresult =
                Page.Databaseˉdurableˉpageˉdecode(
                    Bytesˉslice(
                        Pageˉbytes, Counted * Manifest.Pageˉsize,
                        Manifest.Pageˉsize
                    )
                );
            var Kind: Page.Databaseˉdurableˉpageˉkind =
                Page.Databaseˉdurableˉpageˉkind.Branch;
            if Packed.Branchˉcount == 1u32 {
                Kind = Page.Databaseˉdurableˉpageˉkind.Root;
            }
            if Branch.Error != Partition.Databaseˉtransactionˉbranchˉpartitionˉerror.Valid ||
                Durable.Error != Page.Databaseˉdurableˉpageˉerror.Valid ||
                Durable.Kind != Kind || Durable.Pageˉidentifier != Nextˉpage ||
                Durable.Generation != Manifest.Targetˉgeneration ||
                Durable.Commitˉsequence != Manifest.Targetˉsequence ||
                Durable.Previousˉpage != DATABASE_TRANSACTION_ROOT_GROWTH_NO_PAGE ||
                Durable.Itemˉcount != Branch.Entryˉcount ||
                !Databaseˉtransactionˉrootˉgrowthˉsame(
                    Durable.Payload, Branch.Payload
                ) {
                return Databaseˉtransactionˉrootˉgrowthˉfailure(
                    Databaseˉtransactionˉrootˉgrowthˉerror.Invalidˉpage, Round
                );
            }
            Nextˉpage = Nextˉpage + 1u64;
            Counted = Counted + 1u32;
            Index = Index + 1u32;
        }
        Round = Round + 1u32;
        if Packed.Branchˉcount == 1u32 {
            Rootˉpage = Roundˉfirst;
        } else {
            let Nextˉreplacements: Replacements.Databaseˉtransactionˉchildˉreplacementsˉresult =
                Databaseˉtransactionˉrootˉgrowthˉnextˉreplacements(
                    Initialˉgroup.Originalˉchild, Roundˉfirst,
                    Packed.Bytes, Packed.Branchˉcount
                );
            if Nextˉreplacements.Error !=
                    Replacements.Databaseˉtransactionˉchildˉreplacementsˉerror.Valid {
                return Databaseˉtransactionˉrootˉgrowthˉfailure(
                    Databaseˉtransactionˉrootˉgrowthˉerror.Replacementˉfailed,
                    Round - 1u32
                );
            }
            Currentˉreplacements = Nextˉreplacements.Bytes;
        }
    }
    if Round != Manifest.Roundˉcount || Counted != Manifest.Pageˉcount ||
        Nextˉpage != Manifest.Nextˉpage || Rootˉpage != Manifest.Rootˉpage ||
        Manifest.Outputˉrootˉdepth != Manifest.Inputˉrootˉdepth + Round {
        return Databaseˉtransactionˉrootˉgrowthˉsimpleˉfailure(
            Databaseˉtransactionˉrootˉgrowthˉerror.Inconsistentˉinput
        );
    }
    return Databaseˉtransactionˉrootˉgrowthˉwithˉcompanions(
        Manifest, Replacementsˉbytes, Pageˉbytes
    );
}

export fn Databaseˉtransactionˉrootˉgrowthˉplan(
    Current: Superblock.Databaseˉsuperblockˉselection,
    Firstˉallocationˉpage: u64,
    Firstˉpage: u64,
    Targetˉgeneration: u64,
    Targetˉsequence: u64,
    Replacementsˉbytes: bytes
) -> Databaseˉtransactionˉrootˉgrowthˉresult {
    let Replacementˉplan: Replacements.Databaseˉtransactionˉchildˉreplacementsˉresult =
        Replacements.Databaseˉtransactionˉchildˉreplacementsˉdecode(
            Replacementsˉbytes
        );
    if Replacementˉplan.Error !=
            Replacements.Databaseˉtransactionˉchildˉreplacementsˉerror.Valid ||
        Replacementˉplan.Groupˉcount != 1u32 ||
        Replacementˉplan.Replacementˉcount < 2u32 ||
        Replacementˉplan.Replacementˉcount >
            DATABASE_TRANSACTION_ROOT_GROWTH_MAXIMUM_CHILDREN ||
        Bytesˉlength(Replacementsˉbytes) >
            DATABASE_TRANSACTION_ROOT_GROWTH_MAXIMUM_REPLACEMENT_BYTES {
        return Databaseˉtransactionˉrootˉgrowthˉsimpleˉfailure(
            Databaseˉtransactionˉrootˉgrowthˉerror.Invalidˉreplacements
        );
    }
    let Initialˉgroup: Replacements.Databaseˉtransactionˉchildˉreplacementˉgroup =
        Replacements.Databaseˉtransactionˉchildˉreplacementˉgroupˉread(
            Replacementsˉbytes, 0u32
        );
    if Current.Status != Superblock.Databaseˉsuperblockˉselectionˉstatus.Valid ||
        Current.Pageˉsize != 4096u32 && Current.Pageˉsize != 8192u32 &&
            Current.Pageˉsize != 16384u32 && Current.Pageˉsize != 32768u32 &&
            Current.Pageˉsize != 65536u32 ||
        Current.Rootˉdepth < 2u32 || Current.Rootˉdepth > 8u32 ||
        Current.Generation == U64_MAXIMUM ||
        Current.Committedˉsequence == U64_MAXIMUM {
        return Databaseˉtransactionˉrootˉgrowthˉsimpleˉfailure(
            Databaseˉtransactionˉrootˉgrowthˉerror.Invalidˉcurrent
        );
    }
    if Current.Rootˉdepth == 8u32 {
        return Databaseˉtransactionˉrootˉgrowthˉsimpleˉfailure(
            Databaseˉtransactionˉrootˉgrowthˉerror.Depthˉexhausted
        );
    }
    if Initialˉgroup.Error !=
            Replacements.Databaseˉtransactionˉchildˉreplacementsˉerror.Valid ||
        Initialˉgroup.Originalˉchild != Current.Rootˉpage ||
        Initialˉgroup.Firstˉpage < Firstˉallocationˉpage ||
        Initialˉgroup.Firstˉpage >
            U64_MAXIMUM - U64ˉfromˉu32(Initialˉgroup.Replacementˉcount) ||
        Initialˉgroup.Firstˉpage + U64ˉfromˉu32(Initialˉgroup.Replacementˉcount) !=
            Firstˉpage ||
        Firstˉallocationˉpage != Current.Pageˉcount ||
        Firstˉpage < Firstˉallocationˉpage ||
        Targetˉgeneration != Current.Generation + 1u64 ||
        Targetˉsequence != Current.Committedˉsequence + 1u64 {
        return Databaseˉtransactionˉrootˉgrowthˉsimpleˉfailure(
            Databaseˉtransactionˉrootˉgrowthˉerror.Inconsistentˉinput
        );
    }
    var Currentˉreplacements: bytes = Replacementsˉbytes;
    var Pages: bytes = Databaseˉtransactionˉrootˉgrowthˉempty();
    var Nextˉpage: u64 = Firstˉpage;
    var Pageˉcount: u32 = 0u32;
    var Round: u32 = 0u32;
    var Rootˉpage: u64 = DATABASE_TRANSACTION_ROOT_GROWTH_NO_PAGE;
    while Rootˉpage == DATABASE_TRANSACTION_ROOT_GROWTH_NO_PAGE {
        if Round >= DATABASE_TRANSACTION_ROOT_GROWTH_MAXIMUM_ROUNDS ||
            Current.Rootˉdepth + Round + 1u32 > 8u32 {
            return Databaseˉtransactionˉrootˉgrowthˉfailure(
                Databaseˉtransactionˉrootˉgrowthˉerror.Depthˉexhausted, Round
            );
        }
        let Packed: Partition.Databaseˉtransactionˉbranchˉpartitionˉresult =
            Partition.Databaseˉtransactionˉbranchˉpartitionˉrootˉchildren(
                Currentˉreplacements, Current.Pageˉsize - 128u32
            );
        if Packed.Error != Partition.Databaseˉtransactionˉbranchˉpartitionˉerror.Valid {
            return Databaseˉtransactionˉrootˉgrowthˉfailure(
                Databaseˉtransactionˉrootˉgrowthˉerror.Partitionˉfailed, Round
            );
        }
        if Packed.Branchˉcount >
                DATABASE_TRANSACTION_ROOT_GROWTH_MAXIMUM_PAGES - Pageˉcount {
            return Databaseˉtransactionˉrootˉgrowthˉfailure(
                Databaseˉtransactionˉrootˉgrowthˉerror.Tooˉmanyˉpages, Round
            );
        }
        if Nextˉpage == DATABASE_TRANSACTION_ROOT_GROWTH_NO_PAGE ||
            Nextˉpage > U64_MAXIMUM - U64ˉfromˉu32(Packed.Branchˉcount) {
            return Databaseˉtransactionˉrootˉgrowthˉfailure(
                Databaseˉtransactionˉrootˉgrowthˉerror.Pageˉidentifierˉexhausted,
                Round
            );
        }
        let Roundˉfirst: u64 = Nextˉpage;
        var Index: u32 = 0u32;
        while Index < Packed.Branchˉcount {
            let Branch: Partition.Databaseˉtransactionˉbranchˉpartitionˉbranch =
                Partition.Databaseˉtransactionˉbranchˉpartitionˉread(
                    Packed.Bytes, Index
                );
            if Branch.Error != Partition.Databaseˉtransactionˉbranchˉpartitionˉerror.Valid {
                return Databaseˉtransactionˉrootˉgrowthˉfailure(
                    Databaseˉtransactionˉrootˉgrowthˉerror.Invalidˉpartition,
                    Round
                );
            }
            var Kind: Page.Databaseˉdurableˉpageˉkind =
                Page.Databaseˉdurableˉpageˉkind.Branch;
            if Packed.Branchˉcount == 1u32 {
                Kind = Page.Databaseˉdurableˉpageˉkind.Root;
            }
            let Encodedˉpage: Page.Databaseˉdurableˉpageˉresult =
                Page.Databaseˉdurableˉpageˉencode(
                    Page.Databaseˉdurableˉpage(
                        Kind, Current.Pageˉsize, Nextˉpage,
                        Targetˉgeneration, Targetˉsequence,
                        DATABASE_TRANSACTION_ROOT_GROWTH_NO_PAGE,
                        Branch.Entryˉcount, Branch.Payload
                    )
                );
            if Encodedˉpage.Error != Page.Databaseˉdurableˉpageˉerror.Valid {
                return Databaseˉtransactionˉrootˉgrowthˉfailure(
                    Databaseˉtransactionˉrootˉgrowthˉerror.Pageˉencodeˉfailed,
                    Round
                );
            }
            Pages = Bytesˉconcat(Pages, Encodedˉpage.Bytes);
            Nextˉpage = Nextˉpage + 1u64;
            Pageˉcount = Pageˉcount + 1u32;
            Index = Index + 1u32;
        }
        Round = Round + 1u32;
        if Packed.Branchˉcount == 1u32 {
            Rootˉpage = Roundˉfirst;
        } else {
            let Nextˉreplacements: Replacements.Databaseˉtransactionˉchildˉreplacementsˉresult =
                Databaseˉtransactionˉrootˉgrowthˉnextˉreplacements(
                    Current.Rootˉpage, Roundˉfirst,
                    Packed.Bytes, Packed.Branchˉcount
                );
            if Nextˉreplacements.Error !=
                    Replacements.Databaseˉtransactionˉchildˉreplacementsˉerror.Valid {
                return Databaseˉtransactionˉrootˉgrowthˉfailure(
                    Databaseˉtransactionˉrootˉgrowthˉerror.Replacementˉfailed,
                    Round - 1u32
                );
            }
            Currentˉreplacements = Nextˉreplacements.Bytes;
        }
    }
    let Encoded: bytes = Databaseˉtransactionˉrootˉgrowthˉencode(
        Current.Pageˉsize, Current.Rootˉdepth, Current.Rootˉdepth + Round,
        Round, Pageˉcount, Replacementˉplan.Replacementˉcount,
        Targetˉgeneration, Targetˉsequence, Firstˉallocationˉpage,
        Firstˉpage, Nextˉpage, Rootˉpage, Replacementsˉbytes, Pages
    );
    let Checked: Databaseˉtransactionˉrootˉgrowthˉresult =
        Databaseˉtransactionˉrootˉgrowthˉvalidate(
            Encoded, Replacementsˉbytes, Pages
        );
    if Checked.Error != Databaseˉtransactionˉrootˉgrowthˉerror.Valid {
        return Databaseˉtransactionˉrootˉgrowthˉsimpleˉfailure(
            Databaseˉtransactionˉrootˉgrowthˉerror.Invalidˉoutput
        );
    }
    return Databaseˉtransactionˉrootˉgrowthˉwithˉcompanions(
        Checked, Replacementsˉbytes, Pages
    );
}
