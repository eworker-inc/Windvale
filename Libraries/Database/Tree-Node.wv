module Windvaleˉdatabaseˉtreeˉnode profile portable;

const DATABASE_TREE_NODE_MAGIC: u32 = 1314149975u32;
const DATABASE_TREE_NODE_VERSION: u32 = 1u32;
const DATABASE_TREE_NODE_HEADER_BYTES: u32 = 32u32;
const DATABASE_TREE_NODE_MAXIMUM_BYTES: u32 = 65408u32;
const DATABASE_TREE_NODE_MAXIMUM_ENTRIES: u32 = 4096u32;
const DATABASE_TREE_NODE_MAXIMUM_KEY_BYTES: u32 = 4096u32;
const DATABASE_TREE_NODE_MAXIMUM_VALUE_BYTES: u32 = 61440u32;
const DATABASE_TREE_NODE_NO_PAGE: u64 = 18446744073709551615u64;

export enum Databaseˉtreeˉnodeˉkind {
    Leaf = 1;
    Branch = 2;
}

export enum Databaseˉtreeˉkeyˉorder {
    Less = 0;
    Equal = 1;
    Greater = 2;
}

export enum Databaseˉtreeˉnodeˉerror {
    Valid = 0;
    Invalidˉlength = 1;
    Invalidˉmagic = 2;
    Unsupportedˉversion = 3;
    Invalidˉheaderˉsize = 4;
    Invalidˉkind = 5;
    Invalidˉcount = 6;
    Invalidˉusedˉlength = 7;
    Invalidˉrightmostˉchild = 8;
    Truncatedˉentry = 9;
    Invalidˉkeyˉlength = 10;
    Invalidˉvalueˉlength = 11;
    Invalidˉentryˉreserved = 12;
    Invalidˉchild = 13;
    Invalidˉorder = 14;
    Trailingˉbytes = 15;
    Invalidˉmaximumˉpayload = 16;
    Full = 17;
    Cannotˉsplit = 18;
    Invalidˉrange = 19;
}

export record Databaseˉtreeˉnodeˉresult {
    Error: Databaseˉtreeˉnodeˉerror;
    Kind: Databaseˉtreeˉnodeˉkind;
    Entryˉcount: u32;
    Rightmostˉchild: u64;
    Bytes: bytes;
}

export record Databaseˉtreeˉleafˉlookupˉresult {
    Error: Databaseˉtreeˉnodeˉerror;
    Found: bool;
    Value: bytes;
}

export record Databaseˉtreeˉleafˉupsertˉresult {
    Error: Databaseˉtreeˉnodeˉerror;
    Replaced: bool;
    Entryˉcount: u32;
    Bytes: bytes;
}

export record Databaseˉtreeˉleafˉdeleteˉresult {
    Error: Databaseˉtreeˉnodeˉerror;
    Found: bool;
    Entryˉcount: u32;
    Bytes: bytes;
}

export record Databaseˉtreeˉbranchˉrouteˉresult {
    Error: Databaseˉtreeˉnodeˉerror;
    Child: u64;
    Hasˉlower: bool;
    Lower: bytes;
    Hasˉupper: bool;
    Upper: bytes;
}

export record Databaseˉtreeˉnodeˉsplitˉresult {
    Error: Databaseˉtreeˉnodeˉerror;
    Replaced: bool;
    Leftˉentryˉcount: u32;
    Rightˉentryˉcount: u32;
    Separator: bytes;
    Left: bytes;
    Right: bytes;
}

export record Databaseˉtreeˉbranchˉupdateˉresult {
    Error: Databaseˉtreeˉnodeˉerror;
    Entryˉcount: u32;
    Bytes: bytes;
}

fn Databaseˉtreeˉempty() -> bytes {
    let Unit: bytes = Bytesˉfromˉu8(0u8);
    return Bytesˉslice(Unit, 0u32, 0u32);
}

fn Databaseˉtreeˉcopy(Input: bytes) -> bytes {
    let Length: u32 = Bytesˉlength(Input);
    if Length == 0u32 { return Databaseˉtreeˉempty(); }
    let Owned: bytes = Bytesˉconcat(Bytesˉfromˉu8(0u8), Input);
    return Bytesˉslice(Owned, 1u32, Length);
}

fn Databaseˉtreeˉnodeˉfailure(
    Error: Databaseˉtreeˉnodeˉerror
) -> Databaseˉtreeˉnodeˉresult {
    return Databaseˉtreeˉnodeˉresult(
        Error,
        Databaseˉtreeˉnodeˉkind.Leaf,
        0u32,
        DATABASE_TREE_NODE_NO_PAGE,
        Databaseˉtreeˉempty()
    );
}

fn Databaseˉtreeˉlookupˉfailure(
    Error: Databaseˉtreeˉnodeˉerror
) -> Databaseˉtreeˉleafˉlookupˉresult {
    return Databaseˉtreeˉleafˉlookupˉresult(
        Error,
        false,
        Databaseˉtreeˉempty()
    );
}

fn Databaseˉtreeˉupsertˉfailure(
    Error: Databaseˉtreeˉnodeˉerror
) -> Databaseˉtreeˉleafˉupsertˉresult {
    return Databaseˉtreeˉleafˉupsertˉresult(
        Error,
        false,
        0u32,
        Databaseˉtreeˉempty()
    );
}

fn Databaseˉtreeˉdeleteˉfailure(
    Error: Databaseˉtreeˉnodeˉerror
) -> Databaseˉtreeˉleafˉdeleteˉresult {
    return Databaseˉtreeˉleafˉdeleteˉresult(
        Error,
        false,
        0u32,
        Databaseˉtreeˉempty()
    );
}

fn Databaseˉtreeˉrouteˉfailure(
    Error: Databaseˉtreeˉnodeˉerror
) -> Databaseˉtreeˉbranchˉrouteˉresult {
    return Databaseˉtreeˉbranchˉrouteˉresult(
        Error,
        DATABASE_TREE_NODE_NO_PAGE,
        false,
        Databaseˉtreeˉempty(),
        false,
        Databaseˉtreeˉempty()
    );
}

fn Databaseˉtreeˉsplitˉfailure(
    Error: Databaseˉtreeˉnodeˉerror
) -> Databaseˉtreeˉnodeˉsplitˉresult {
    return Databaseˉtreeˉnodeˉsplitˉresult(
        Error,
        false,
        0u32,
        0u32,
        Databaseˉtreeˉempty(),
        Databaseˉtreeˉempty(),
        Databaseˉtreeˉempty()
    );
}

fn Databaseˉtreeˉbranchˉupdateˉfailure(
    Error: Databaseˉtreeˉnodeˉerror
) -> Databaseˉtreeˉbranchˉupdateˉresult {
    return Databaseˉtreeˉbranchˉupdateˉresult(
        Error,
        0u32,
        Databaseˉtreeˉempty()
    );
}

export fn Databaseˉtreeˉkeyˉcompare(
    Left: bytes,
    Right: bytes
) -> Databaseˉtreeˉkeyˉorder {
    let Leftˉlength: u32 = Bytesˉlength(Left);
    let Rightˉlength: u32 = Bytesˉlength(Right);
    var Limit: u32 = Leftˉlength;
    if Rightˉlength < Limit { Limit = Rightˉlength; }
    var Index: u32 = 0u32;
    while Index < Limit {
        let Leftˉbyte: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(Left, Index));
        let Rightˉbyte: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(Right, Index));
        if Leftˉbyte < Rightˉbyte {
            return Databaseˉtreeˉkeyˉorder.Less;
        }
        if Leftˉbyte > Rightˉbyte {
            return Databaseˉtreeˉkeyˉorder.Greater;
        }
        Index = Index + 1u32;
    }
    if Leftˉlength < Rightˉlength {
        return Databaseˉtreeˉkeyˉorder.Less;
    }
    if Leftˉlength > Rightˉlength {
        return Databaseˉtreeˉkeyˉorder.Greater;
    }
    return Databaseˉtreeˉkeyˉorder.Equal;
}

fn Databaseˉtreeˉnodeˉkindˉfromˉu32(
    Value: u32
) -> Databaseˉtreeˉnodeˉkind {
    if Value == 2u32 { return Databaseˉtreeˉnodeˉkind.Branch; }
    return Databaseˉtreeˉnodeˉkind.Leaf;
}

export fn Databaseˉtreeˉnodeˉdecode(
    Input: bytes
) -> Databaseˉtreeˉnodeˉresult {
    let Total: u32 = Bytesˉlength(Input);
    if Total < DATABASE_TREE_NODE_HEADER_BYTES ||
        Total > DATABASE_TREE_NODE_MAXIMUM_BYTES {
        return Databaseˉtreeˉnodeˉfailure(
            Databaseˉtreeˉnodeˉerror.Invalidˉlength
        );
    }
    if Bytesˉreadˉu32ˉlittle(Input, 0u32) != DATABASE_TREE_NODE_MAGIC {
        return Databaseˉtreeˉnodeˉfailure(
            Databaseˉtreeˉnodeˉerror.Invalidˉmagic
        );
    }
    if Bytesˉreadˉu32ˉlittle(Input, 4u32) != DATABASE_TREE_NODE_VERSION {
        return Databaseˉtreeˉnodeˉfailure(
            Databaseˉtreeˉnodeˉerror.Unsupportedˉversion
        );
    }
    if Bytesˉreadˉu32ˉlittle(Input, 8u32) !=
        DATABASE_TREE_NODE_HEADER_BYTES {
        return Databaseˉtreeˉnodeˉfailure(
            Databaseˉtreeˉnodeˉerror.Invalidˉheaderˉsize
        );
    }
    let Rawˉkind: u32 = Bytesˉreadˉu32ˉlittle(Input, 12u32);
    if Rawˉkind != 1u32 && Rawˉkind != 2u32 {
        return Databaseˉtreeˉnodeˉfailure(
            Databaseˉtreeˉnodeˉerror.Invalidˉkind
        );
    }
    let Entryˉcount: u32 = Bytesˉreadˉu32ˉlittle(Input, 16u32);
    if Entryˉcount > DATABASE_TREE_NODE_MAXIMUM_ENTRIES ||
        Rawˉkind == 2u32 && Entryˉcount == 0u32 {
        return Databaseˉtreeˉnodeˉfailure(
            Databaseˉtreeˉnodeˉerror.Invalidˉcount
        );
    }
    if Bytesˉreadˉu32ˉlittle(Input, 20u32) != Total {
        return Databaseˉtreeˉnodeˉfailure(
            Databaseˉtreeˉnodeˉerror.Invalidˉusedˉlength
        );
    }
    let Rightmostˉchild: u64 = Bytesˉreadˉu64ˉlittle(Input, 24u32);
    if Rawˉkind == 1u32 && Rightmostˉchild != DATABASE_TREE_NODE_NO_PAGE ||
        Rawˉkind == 2u32 && Rightmostˉchild == DATABASE_TREE_NODE_NO_PAGE {
        return Databaseˉtreeˉnodeˉfailure(
            Databaseˉtreeˉnodeˉerror.Invalidˉrightmostˉchild
        );
    }

    var Cursor: u32 = DATABASE_TREE_NODE_HEADER_BYTES;
    var Index: u32 = 0u32;
    var Previousˉkey: bytes = Databaseˉtreeˉempty();
    while Index < Entryˉcount {
        var Entryˉheader: u32 = 8u32;
        if Rawˉkind == 2u32 { Entryˉheader = 16u32; }
        if Cursor > Total - Entryˉheader {
            return Databaseˉtreeˉnodeˉfailure(
                Databaseˉtreeˉnodeˉerror.Truncatedˉentry
            );
        }
        let Keyˉlength: u32 = Bytesˉreadˉu32ˉlittle(Input, Cursor);
        if Keyˉlength == 0u32 ||
            Keyˉlength > DATABASE_TREE_NODE_MAXIMUM_KEY_BYTES {
            return Databaseˉtreeˉnodeˉfailure(
                Databaseˉtreeˉnodeˉerror.Invalidˉkeyˉlength
            );
        }
        var Valueˉlength: u32 = 0u32;
        if Rawˉkind == 1u32 {
            Valueˉlength = Bytesˉreadˉu32ˉlittle(Input, Cursor + 4u32);
            if Valueˉlength > DATABASE_TREE_NODE_MAXIMUM_VALUE_BYTES {
                return Databaseˉtreeˉnodeˉfailure(
                    Databaseˉtreeˉnodeˉerror.Invalidˉvalueˉlength
                );
            }
        } else {
            if Bytesˉreadˉu32ˉlittle(Input, Cursor + 4u32) != 0u32 {
                return Databaseˉtreeˉnodeˉfailure(
                    Databaseˉtreeˉnodeˉerror.Invalidˉentryˉreserved
                );
            }
            if Bytesˉreadˉu64ˉlittle(Input, Cursor + 8u32) ==
                DATABASE_TREE_NODE_NO_PAGE {
                return Databaseˉtreeˉnodeˉfailure(
                    Databaseˉtreeˉnodeˉerror.Invalidˉchild
                );
            }
        }
        let Contentˉoffset: u32 = Cursor + Entryˉheader;
        let Remaining: u32 = Total - Contentˉoffset;
        if Keyˉlength > Remaining ||
            Valueˉlength > Remaining - Keyˉlength {
            return Databaseˉtreeˉnodeˉfailure(
                Databaseˉtreeˉnodeˉerror.Truncatedˉentry
            );
        }
        let Key: bytes = Bytesˉslice(Input, Contentˉoffset, Keyˉlength);
        if Index > 0u32 && Databaseˉtreeˉkeyˉcompare(
            Previousˉkey,
            Key
        ) != Databaseˉtreeˉkeyˉorder.Less {
            return Databaseˉtreeˉnodeˉfailure(
                Databaseˉtreeˉnodeˉerror.Invalidˉorder
            );
        }
        Previousˉkey = Key;
        Cursor = Contentˉoffset + Keyˉlength + Valueˉlength;
        Index = Index + 1u32;
    }
    if Cursor != Total {
        return Databaseˉtreeˉnodeˉfailure(
            Databaseˉtreeˉnodeˉerror.Trailingˉbytes
        );
    }
    return Databaseˉtreeˉnodeˉresult(
        Databaseˉtreeˉnodeˉerror.Valid,
        Databaseˉtreeˉnodeˉkindˉfromˉu32(Rawˉkind),
        Entryˉcount,
        Rightmostˉchild,
        Input
    );
}

fn Databaseˉtreeˉleafˉentry(Key: bytes, Value: bytes) -> bytes {
    var Result: bytes = Bytesˉfromˉu32ˉlittle(Bytesˉlength(Key));
    Result = Bytesˉconcat(
        Result,
        Bytesˉfromˉu32ˉlittle(Bytesˉlength(Value))
    );
    Result = Bytesˉconcat(Result, Key);
    return Bytesˉconcat(Result, Value);
}

fn Databaseˉtreeˉleafˉbytes(Entryˉcount: u32, Body: bytes) -> bytes {
    let Usedˉlength: u32 = DATABASE_TREE_NODE_HEADER_BYTES +
        Bytesˉlength(Body);
    var Result: bytes = Bytesˉfromˉu32ˉlittle(DATABASE_TREE_NODE_MAGIC);
    Result = Bytesˉconcat(
        Result,
        Bytesˉfromˉu32ˉlittle(DATABASE_TREE_NODE_VERSION)
    );
    Result = Bytesˉconcat(
        Result,
        Bytesˉfromˉu32ˉlittle(DATABASE_TREE_NODE_HEADER_BYTES)
    );
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(1u32));
    Result = Bytesˉconcat(
        Result,
        Bytesˉfromˉu32ˉlittle(Entryˉcount)
    );
    Result = Bytesˉconcat(
        Result,
        Bytesˉfromˉu32ˉlittle(Usedˉlength)
    );
    Result = Bytesˉconcat(
        Result,
        Bytesˉfromˉu64ˉlittle(DATABASE_TREE_NODE_NO_PAGE)
    );
    return Bytesˉconcat(Result, Body);
}

fn Databaseˉtreeˉbranchˉbytes(
    Entryˉcount: u32,
    Rightmostˉchild: u64,
    Body: bytes
) -> bytes {
    let Usedˉlength: u32 = DATABASE_TREE_NODE_HEADER_BYTES +
        Bytesˉlength(Body);
    var Result: bytes = Bytesˉfromˉu32ˉlittle(DATABASE_TREE_NODE_MAGIC);
    Result = Bytesˉconcat(
        Result,
        Bytesˉfromˉu32ˉlittle(DATABASE_TREE_NODE_VERSION)
    );
    Result = Bytesˉconcat(
        Result,
        Bytesˉfromˉu32ˉlittle(DATABASE_TREE_NODE_HEADER_BYTES)
    );
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(2u32));
    Result = Bytesˉconcat(
        Result,
        Bytesˉfromˉu32ˉlittle(Entryˉcount)
    );
    Result = Bytesˉconcat(
        Result,
        Bytesˉfromˉu32ˉlittle(Usedˉlength)
    );
    Result = Bytesˉconcat(
        Result,
        Bytesˉfromˉu64ˉlittle(Rightmostˉchild)
    );
    return Bytesˉconcat(Result, Body);
}

fn Databaseˉtreeˉbranchˉentry(
    Separator: bytes,
    Child: u64
) -> bytes {
    var Result: bytes = Bytesˉfromˉu32ˉlittle(Bytesˉlength(Separator));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(0u32));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu64ˉlittle(Child));
    return Bytesˉconcat(Result, Separator);
}

export fn Databaseˉtreeˉbranchˉtwoˉchildren(
    Separator: bytes,
    Leftˉchild: u64,
    Rightˉchild: u64,
    Maximumˉpayload: u32
) -> Databaseˉtreeˉnodeˉresult {
    if Maximumˉpayload < DATABASE_TREE_NODE_HEADER_BYTES ||
        Maximumˉpayload > DATABASE_TREE_NODE_MAXIMUM_BYTES {
        return Databaseˉtreeˉnodeˉfailure(
            Databaseˉtreeˉnodeˉerror.Invalidˉmaximumˉpayload
        );
    }
    let Keyˉlength: u32 = Bytesˉlength(Separator);
    if Keyˉlength == 0u32 ||
        Keyˉlength > DATABASE_TREE_NODE_MAXIMUM_KEY_BYTES {
        return Databaseˉtreeˉnodeˉfailure(
            Databaseˉtreeˉnodeˉerror.Invalidˉkeyˉlength
        );
    }
    if Leftˉchild == DATABASE_TREE_NODE_NO_PAGE ||
        Rightˉchild == DATABASE_TREE_NODE_NO_PAGE ||
        Leftˉchild == Rightˉchild {
        return Databaseˉtreeˉnodeˉfailure(
            Databaseˉtreeˉnodeˉerror.Invalidˉchild
        );
    }
    var Body: bytes = Bytesˉfromˉu32ˉlittle(Keyˉlength);
    Body = Bytesˉconcat(Body, Bytesˉfromˉu32ˉlittle(0u32));
    Body = Bytesˉconcat(Body, Bytesˉfromˉu64ˉlittle(Leftˉchild));
    Body = Bytesˉconcat(Body, Separator);
    if Bytesˉlength(Body) >
        Maximumˉpayload - DATABASE_TREE_NODE_HEADER_BYTES {
        return Databaseˉtreeˉnodeˉfailure(
            Databaseˉtreeˉnodeˉerror.Full
        );
    }
    let Result: bytes = Databaseˉtreeˉbranchˉbytes(
        1u32,
        Rightˉchild,
        Body
    );
    let Validation: Databaseˉtreeˉnodeˉresult =
        Databaseˉtreeˉnodeˉdecode(Result);
    if Validation.Error != Databaseˉtreeˉnodeˉerror.Valid {
        return Databaseˉtreeˉnodeˉfailure(Validation.Error);
    }
    return Validation;
}

export fn Databaseˉtreeˉbranchˉreplaceˉchild(
    Input: bytes,
    Previousˉchild: u64,
    Replacementˉchild: u64,
    Maximumˉpayload: u32
) -> Databaseˉtreeˉbranchˉupdateˉresult {
    if Maximumˉpayload < DATABASE_TREE_NODE_HEADER_BYTES ||
        Maximumˉpayload > DATABASE_TREE_NODE_MAXIMUM_BYTES {
        return Databaseˉtreeˉbranchˉupdateˉfailure(
            Databaseˉtreeˉnodeˉerror.Invalidˉmaximumˉpayload
        );
    }
    if Previousˉchild == DATABASE_TREE_NODE_NO_PAGE ||
        Replacementˉchild == DATABASE_TREE_NODE_NO_PAGE ||
        Previousˉchild == Replacementˉchild {
        return Databaseˉtreeˉbranchˉupdateˉfailure(
            Databaseˉtreeˉnodeˉerror.Invalidˉchild
        );
    }
    let Node: Databaseˉtreeˉnodeˉresult =
        Databaseˉtreeˉnodeˉdecode(Input);
    if Node.Error != Databaseˉtreeˉnodeˉerror.Valid {
        return Databaseˉtreeˉbranchˉupdateˉfailure(Node.Error);
    }
    if Node.Kind != Databaseˉtreeˉnodeˉkind.Branch {
        return Databaseˉtreeˉbranchˉupdateˉfailure(
            Databaseˉtreeˉnodeˉerror.Invalidˉkind
        );
    }
    if Bytesˉlength(Input) > Maximumˉpayload {
        return Databaseˉtreeˉbranchˉupdateˉfailure(
            Databaseˉtreeˉnodeˉerror.Full
        );
    }

    var Cursor: u32 = DATABASE_TREE_NODE_HEADER_BYTES;
    var Index: u32 = 0u32;
    var Matches: u32 = 0u32;
    var Replacementˉpresent: bool = false;
    var Matchˉoffset: u32 = 0u32;
    while Index < Node.Entryˉcount {
        let Separatorˉlength: u32 = Bytesˉreadˉu32ˉlittle(Input, Cursor);
        let Child: u64 = Bytesˉreadˉu64ˉlittle(Input, Cursor + 8u32);
        if Child == Previousˉchild {
            Matches = Matches + 1u32;
            Matchˉoffset = Cursor + 8u32;
        }
        if Child == Replacementˉchild { Replacementˉpresent = true; }
        Cursor = Cursor + 16u32 + Separatorˉlength;
        Index = Index + 1u32;
    }
    var Replaceˉrightmost: bool = false;
    if Node.Rightmostˉchild == Previousˉchild {
        Matches = Matches + 1u32;
        Replaceˉrightmost = true;
    }
    if Node.Rightmostˉchild == Replacementˉchild {
        Replacementˉpresent = true;
    }
    if Matches != 1u32 || Replacementˉpresent {
        return Databaseˉtreeˉbranchˉupdateˉfailure(
            Databaseˉtreeˉnodeˉerror.Invalidˉchild
        );
    }

    var Resultˉbytes: bytes = Input;
    if Replaceˉrightmost {
        Resultˉbytes = Databaseˉtreeˉbranchˉbytes(
            Node.Entryˉcount,
            Replacementˉchild,
            Bytesˉslice(
                Input,
                DATABASE_TREE_NODE_HEADER_BYTES,
                Bytesˉlength(Input) - DATABASE_TREE_NODE_HEADER_BYTES
            )
        );
    } else {
        let Prefix: bytes = Bytesˉslice(Input, 0u32, Matchˉoffset);
        let Suffix: bytes = Bytesˉslice(
            Input,
            Matchˉoffset + 8u32,
            Bytesˉlength(Input) - Matchˉoffset - 8u32
        );
        Resultˉbytes = Bytesˉconcat(
            Bytesˉconcat(
                Prefix,
                Bytesˉfromˉu64ˉlittle(Replacementˉchild)
            ),
            Suffix
        );
    }
    let Validation: Databaseˉtreeˉnodeˉresult =
        Databaseˉtreeˉnodeˉdecode(Resultˉbytes);
    if Validation.Error != Databaseˉtreeˉnodeˉerror.Valid ||
        Validation.Kind != Databaseˉtreeˉnodeˉkind.Branch ||
        Validation.Entryˉcount != Node.Entryˉcount {
        return Databaseˉtreeˉbranchˉupdateˉfailure(
            Databaseˉtreeˉnodeˉerror.Invalidˉchild
        );
    }
    return Databaseˉtreeˉbranchˉupdateˉresult(
        Databaseˉtreeˉnodeˉerror.Valid,
        Validation.Entryˉcount,
        Validation.Bytes
    );
}

export fn Databaseˉtreeˉbranchˉsplitˉchild(
    Input: bytes,
    Previousˉchild: u64,
    Separator: bytes,
    Leftˉchild: u64,
    Rightˉchild: u64,
    Maximumˉpayload: u32
) -> Databaseˉtreeˉbranchˉupdateˉresult {
    if Maximumˉpayload < DATABASE_TREE_NODE_HEADER_BYTES ||
        Maximumˉpayload > DATABASE_TREE_NODE_MAXIMUM_BYTES {
        return Databaseˉtreeˉbranchˉupdateˉfailure(
            Databaseˉtreeˉnodeˉerror.Invalidˉmaximumˉpayload
        );
    }
    let Separatorˉlength: u32 = Bytesˉlength(Separator);
    if Separatorˉlength == 0u32 ||
        Separatorˉlength > DATABASE_TREE_NODE_MAXIMUM_KEY_BYTES {
        return Databaseˉtreeˉbranchˉupdateˉfailure(
            Databaseˉtreeˉnodeˉerror.Invalidˉkeyˉlength
        );
    }
    if Previousˉchild == DATABASE_TREE_NODE_NO_PAGE ||
        Leftˉchild == DATABASE_TREE_NODE_NO_PAGE ||
        Rightˉchild == DATABASE_TREE_NODE_NO_PAGE ||
        Previousˉchild == Leftˉchild ||
        Previousˉchild == Rightˉchild ||
        Leftˉchild == Rightˉchild {
        return Databaseˉtreeˉbranchˉupdateˉfailure(
            Databaseˉtreeˉnodeˉerror.Invalidˉchild
        );
    }
    let Node: Databaseˉtreeˉnodeˉresult =
        Databaseˉtreeˉnodeˉdecode(Input);
    if Node.Error != Databaseˉtreeˉnodeˉerror.Valid {
        return Databaseˉtreeˉbranchˉupdateˉfailure(Node.Error);
    }
    if Node.Kind != Databaseˉtreeˉnodeˉkind.Branch {
        return Databaseˉtreeˉbranchˉupdateˉfailure(
            Databaseˉtreeˉnodeˉerror.Invalidˉkind
        );
    }
    if Node.Entryˉcount == DATABASE_TREE_NODE_MAXIMUM_ENTRIES {
        return Databaseˉtreeˉbranchˉupdateˉfailure(
            Databaseˉtreeˉnodeˉerror.Full
        );
    }

    let Body: bytes = Bytesˉslice(
        Input,
        DATABASE_TREE_NODE_HEADER_BYTES,
        Bytesˉlength(Input) - DATABASE_TREE_NODE_HEADER_BYTES
    );
    var Cursor: u32 = 0u32;
    var Index: u32 = 0u32;
    var Matches: u32 = 0u32;
    var Newˉchildˉpresent: bool = false;
    var Matchˉoffset: u32 = 0u32;
    var Matchˉend: u32 = 0u32;
    var Hasˉlower: bool = false;
    var Lower: bytes = Databaseˉtreeˉempty();
    var Hasˉupper: bool = false;
    var Upper: bytes = Databaseˉtreeˉempty();
    var Previousˉseparator: bytes = Databaseˉtreeˉempty();
    while Index < Node.Entryˉcount {
        let Candidateˉlength: u32 = Bytesˉreadˉu32ˉlittle(Body, Cursor);
        let Candidateˉchild: u64 = Bytesˉreadˉu64ˉlittle(
            Body,
            Cursor + 8u32
        );
        let Candidate: bytes = Bytesˉslice(
            Body,
            Cursor + 16u32,
            Candidateˉlength
        );
        if Candidateˉchild == Previousˉchild {
            Matches = Matches + 1u32;
            Matchˉoffset = Cursor;
            Matchˉend = Cursor + 16u32 + Candidateˉlength;
            if Index > 0u32 {
                Hasˉlower = true;
                Lower = Databaseˉtreeˉcopy(Previousˉseparator);
            }
            Hasˉupper = true;
            Upper = Databaseˉtreeˉcopy(Candidate);
        }
        if Candidateˉchild == Leftˉchild ||
            Candidateˉchild == Rightˉchild {
            Newˉchildˉpresent = true;
        }
        Previousˉseparator = Candidate;
        Cursor = Cursor + 16u32 + Candidateˉlength;
        Index = Index + 1u32;
    }
    var Replaceˉrightmost: bool = false;
    if Node.Rightmostˉchild == Previousˉchild {
        Matches = Matches + 1u32;
        Replaceˉrightmost = true;
        Matchˉoffset = Bytesˉlength(Body);
        Matchˉend = Matchˉoffset;
        Hasˉlower = true;
        Lower = Databaseˉtreeˉcopy(Previousˉseparator);
        Hasˉupper = false;
    }
    if Node.Rightmostˉchild == Leftˉchild ||
        Node.Rightmostˉchild == Rightˉchild {
        Newˉchildˉpresent = true;
    }
    if Matches != 1u32 || Newˉchildˉpresent {
        return Databaseˉtreeˉbranchˉupdateˉfailure(
            Databaseˉtreeˉnodeˉerror.Invalidˉchild
        );
    }
    if Hasˉlower && Databaseˉtreeˉkeyˉcompare(
            Separator,
            Lower
        ) != Databaseˉtreeˉkeyˉorder.Greater ||
        Hasˉupper && Databaseˉtreeˉkeyˉcompare(
            Separator,
            Upper
        ) != Databaseˉtreeˉkeyˉorder.Less {
        return Databaseˉtreeˉbranchˉupdateˉfailure(
            Databaseˉtreeˉnodeˉerror.Invalidˉrange
        );
    }

    let Prefix: bytes = Bytesˉslice(Body, 0u32, Matchˉoffset);
    let Suffix: bytes = Bytesˉslice(
        Body,
        Matchˉend,
        Bytesˉlength(Body) - Matchˉend
    );
    let Leftˉentry: bytes = Databaseˉtreeˉbranchˉentry(
        Separator,
        Leftˉchild
    );
    var Replacement: bytes = Leftˉentry;
    var Resultˉrightmost: u64 = Node.Rightmostˉchild;
    if Replaceˉrightmost {
        Resultˉrightmost = Rightˉchild;
    } else {
        Replacement = Bytesˉconcat(
            Leftˉentry,
            Databaseˉtreeˉbranchˉentry(Upper, Rightˉchild)
        );
    }
    let Resultˉbody: bytes = Bytesˉconcat(
        Bytesˉconcat(Prefix, Replacement),
        Suffix
    );
    if Bytesˉlength(Resultˉbody) >
        Maximumˉpayload - DATABASE_TREE_NODE_HEADER_BYTES {
        return Databaseˉtreeˉbranchˉupdateˉfailure(
            Databaseˉtreeˉnodeˉerror.Full
        );
    }
    let Resultˉbytes: bytes = Databaseˉtreeˉbranchˉbytes(
        Node.Entryˉcount + 1u32,
        Resultˉrightmost,
        Resultˉbody
    );
    let Validation: Databaseˉtreeˉnodeˉresult =
        Databaseˉtreeˉnodeˉdecode(Resultˉbytes);
    if Validation.Error != Databaseˉtreeˉnodeˉerror.Valid ||
        Validation.Kind != Databaseˉtreeˉnodeˉkind.Branch ||
        Validation.Entryˉcount != Node.Entryˉcount + 1u32 {
        return Databaseˉtreeˉbranchˉupdateˉfailure(
            Databaseˉtreeˉnodeˉerror.Invalidˉchild
        );
    }
    return Databaseˉtreeˉbranchˉupdateˉresult(
        Databaseˉtreeˉnodeˉerror.Valid,
        Validation.Entryˉcount,
        Validation.Bytes
    );
}

export fn Databaseˉtreeˉleafˉlookup(
    Input: bytes,
    Key: bytes
) -> Databaseˉtreeˉleafˉlookupˉresult {
    let Keyˉlength: u32 = Bytesˉlength(Key);
    if Keyˉlength == 0u32 ||
        Keyˉlength > DATABASE_TREE_NODE_MAXIMUM_KEY_BYTES {
        return Databaseˉtreeˉlookupˉfailure(
            Databaseˉtreeˉnodeˉerror.Invalidˉkeyˉlength
        );
    }
    if Bytesˉlength(Input) == 0u32 {
        return Databaseˉtreeˉlookupˉfailure(
            Databaseˉtreeˉnodeˉerror.Invalidˉlength
        );
    }
    let Node: Databaseˉtreeˉnodeˉresult =
        Databaseˉtreeˉnodeˉdecode(Input);
    if Node.Error != Databaseˉtreeˉnodeˉerror.Valid {
        return Databaseˉtreeˉlookupˉfailure(Node.Error);
    }
    if Node.Kind != Databaseˉtreeˉnodeˉkind.Leaf {
        return Databaseˉtreeˉlookupˉfailure(
            Databaseˉtreeˉnodeˉerror.Invalidˉkind
        );
    }
    let Total: u32 = Bytesˉlength(Input);
    var Cursor: u32 = DATABASE_TREE_NODE_HEADER_BYTES;
    var Index: u32 = 0u32;
    while Index < Node.Entryˉcount {
        let Candidateˉkeyˉlength: u32 =
            Bytesˉreadˉu32ˉlittle(Input, Cursor);
        let Candidateˉvalueˉlength: u32 =
            Bytesˉreadˉu32ˉlittle(Input, Cursor + 4u32);
        let Candidateˉkey: bytes = Bytesˉslice(
            Input,
            Cursor + 8u32,
            Candidateˉkeyˉlength
        );
        let Order: Databaseˉtreeˉkeyˉorder =
            Databaseˉtreeˉkeyˉcompare(Key, Candidateˉkey);
        if Order == Databaseˉtreeˉkeyˉorder.Equal {
            return Databaseˉtreeˉleafˉlookupˉresult(
                Databaseˉtreeˉnodeˉerror.Valid,
                true,
                Bytesˉslice(
                    Input,
                    Cursor + 8u32 + Candidateˉkeyˉlength,
                    Candidateˉvalueˉlength
                )
            );
        }
        if Order == Databaseˉtreeˉkeyˉorder.Less {
            return Databaseˉtreeˉleafˉlookupˉresult(
                Databaseˉtreeˉnodeˉerror.Valid,
                false,
                Databaseˉtreeˉempty()
            );
        }
        Cursor = Cursor + 8u32 + Candidateˉkeyˉlength +
            Candidateˉvalueˉlength;
        Index = Index + 1u32;
    }
    if Cursor != Total {
        return Databaseˉtreeˉlookupˉfailure(
            Databaseˉtreeˉnodeˉerror.Trailingˉbytes
        );
    }
    return Databaseˉtreeˉleafˉlookupˉresult(
        Databaseˉtreeˉnodeˉerror.Valid,
        false,
        Databaseˉtreeˉempty()
    );
}

export fn Databaseˉtreeˉleafˉdelete(
    Input: bytes,
    Key: bytes,
    Maximumˉpayload: u32
) -> Databaseˉtreeˉleafˉdeleteˉresult {
    if Maximumˉpayload < DATABASE_TREE_NODE_HEADER_BYTES ||
        Maximumˉpayload > DATABASE_TREE_NODE_MAXIMUM_BYTES {
        return Databaseˉtreeˉdeleteˉfailure(
            Databaseˉtreeˉnodeˉerror.Invalidˉmaximumˉpayload
        );
    }
    let Keyˉlength: u32 = Bytesˉlength(Key);
    if Keyˉlength == 0u32 ||
        Keyˉlength > DATABASE_TREE_NODE_MAXIMUM_KEY_BYTES {
        return Databaseˉtreeˉdeleteˉfailure(
            Databaseˉtreeˉnodeˉerror.Invalidˉkeyˉlength
        );
    }
    if Bytesˉlength(Input) == 0u32 {
        return Databaseˉtreeˉleafˉdeleteˉresult(
            Databaseˉtreeˉnodeˉerror.Valid,
            false,
            0u32,
            Input
        );
    }
    let Node: Databaseˉtreeˉnodeˉresult =
        Databaseˉtreeˉnodeˉdecode(Input);
    if Node.Error != Databaseˉtreeˉnodeˉerror.Valid {
        return Databaseˉtreeˉdeleteˉfailure(Node.Error);
    }
    if Node.Kind != Databaseˉtreeˉnodeˉkind.Leaf {
        return Databaseˉtreeˉdeleteˉfailure(
            Databaseˉtreeˉnodeˉerror.Invalidˉkind
        );
    }
    if Bytesˉlength(Input) > Maximumˉpayload {
        return Databaseˉtreeˉdeleteˉfailure(
            Databaseˉtreeˉnodeˉerror.Full
        );
    }

    var Cursor: u32 = DATABASE_TREE_NODE_HEADER_BYTES;
    var Index: u32 = 0u32;
    var Found: bool = false;
    var Removeˉstart: u32 = Cursor;
    var Removeˉend: u32 = Cursor;
    while Index < Node.Entryˉcount {
        let Candidateˉkeyˉlength: u32 =
            Bytesˉreadˉu32ˉlittle(Input, Cursor);
        let Candidateˉvalueˉlength: u32 =
            Bytesˉreadˉu32ˉlittle(Input, Cursor + 4u32);
        let Candidateˉkey: bytes = Bytesˉslice(
            Input,
            Cursor + 8u32,
            Candidateˉkeyˉlength
        );
        let Order: Databaseˉtreeˉkeyˉorder =
            Databaseˉtreeˉkeyˉcompare(Key, Candidateˉkey);
        if Order == Databaseˉtreeˉkeyˉorder.Equal {
            Found = true;
            Removeˉstart = Cursor;
            Removeˉend = Cursor + 8u32 + Candidateˉkeyˉlength +
                Candidateˉvalueˉlength;
            Index = Node.Entryˉcount;
        } else if Order == Databaseˉtreeˉkeyˉorder.Less {
            Index = Node.Entryˉcount;
        } else {
            Cursor = Cursor + 8u32 + Candidateˉkeyˉlength +
                Candidateˉvalueˉlength;
            Index = Index + 1u32;
        }
    }
    if !Found {
        return Databaseˉtreeˉleafˉdeleteˉresult(
            Databaseˉtreeˉnodeˉerror.Valid,
            false,
            Node.Entryˉcount,
            Input
        );
    }
    let Prefix: bytes = Bytesˉslice(
        Input,
        DATABASE_TREE_NODE_HEADER_BYTES,
        Removeˉstart - DATABASE_TREE_NODE_HEADER_BYTES
    );
    let Suffix: bytes = Bytesˉslice(
        Input,
        Removeˉend,
        Bytesˉlength(Input) - Removeˉend
    );
    let Resultˉbytes: bytes = Databaseˉtreeˉleafˉbytes(
        Node.Entryˉcount - 1u32,
        Bytesˉconcat(Prefix, Suffix)
    );
    let Validation: Databaseˉtreeˉnodeˉresult =
        Databaseˉtreeˉnodeˉdecode(Resultˉbytes);
    if Validation.Error != Databaseˉtreeˉnodeˉerror.Valid ||
        Validation.Kind != Databaseˉtreeˉnodeˉkind.Leaf ||
        Validation.Entryˉcount != Node.Entryˉcount - 1u32 {
        return Databaseˉtreeˉdeleteˉfailure(
            Databaseˉtreeˉnodeˉerror.Invalidˉcount
        );
    }
    return Databaseˉtreeˉleafˉdeleteˉresult(
        Databaseˉtreeˉnodeˉerror.Valid,
        true,
        Validation.Entryˉcount,
        Validation.Bytes
    );
}

export fn Databaseˉtreeˉleafˉrangeˉvalidate(
    Input: bytes,
    Hasˉlower: bool,
    Lower: bytes,
    Hasˉupper: bool,
    Upper: bytes
) -> Databaseˉtreeˉnodeˉerror {
    if Hasˉlower && (Bytesˉlength(Lower) == 0u32 ||
            Bytesˉlength(Lower) > DATABASE_TREE_NODE_MAXIMUM_KEY_BYTES) ||
        Hasˉupper && (Bytesˉlength(Upper) == 0u32 ||
            Bytesˉlength(Upper) > DATABASE_TREE_NODE_MAXIMUM_KEY_BYTES) {
        return Databaseˉtreeˉnodeˉerror.Invalidˉrange;
    }
    if Hasˉlower && Hasˉupper && Databaseˉtreeˉkeyˉcompare(
        Lower,
        Upper
    ) != Databaseˉtreeˉkeyˉorder.Less {
        return Databaseˉtreeˉnodeˉerror.Invalidˉrange;
    }
    let Node: Databaseˉtreeˉnodeˉresult =
        Databaseˉtreeˉnodeˉdecode(Input);
    if Node.Error != Databaseˉtreeˉnodeˉerror.Valid { return Node.Error; }
    if Node.Kind != Databaseˉtreeˉnodeˉkind.Leaf {
        return Databaseˉtreeˉnodeˉerror.Invalidˉkind;
    }
    var Cursor: u32 = DATABASE_TREE_NODE_HEADER_BYTES;
    var Index: u32 = 0u32;
    while Index < Node.Entryˉcount {
        let Keyˉlength: u32 = Bytesˉreadˉu32ˉlittle(Input, Cursor);
        let Valueˉlength: u32 = Bytesˉreadˉu32ˉlittle(
            Input,
            Cursor + 4u32
        );
        let Key: bytes = Bytesˉslice(Input, Cursor + 8u32, Keyˉlength);
        if Hasˉlower && Databaseˉtreeˉkeyˉcompare(
                Key,
                Lower
            ) == Databaseˉtreeˉkeyˉorder.Less ||
            Hasˉupper && Databaseˉtreeˉkeyˉcompare(
                Key,
                Upper
            ) != Databaseˉtreeˉkeyˉorder.Less {
            return Databaseˉtreeˉnodeˉerror.Invalidˉrange;
        }
        Cursor = Cursor + 8u32 + Keyˉlength + Valueˉlength;
        Index = Index + 1u32;
    }
    return Databaseˉtreeˉnodeˉerror.Valid;
}

export fn Databaseˉtreeˉbranchˉroute(
    Input: bytes,
    Key: bytes,
    Hasˉlower: bool,
    Lower: bytes,
    Hasˉupper: bool,
    Upper: bytes
) -> Databaseˉtreeˉbranchˉrouteˉresult {
    let Keyˉlength: u32 = Bytesˉlength(Key);
    if Keyˉlength == 0u32 ||
        Keyˉlength > DATABASE_TREE_NODE_MAXIMUM_KEY_BYTES {
        return Databaseˉtreeˉrouteˉfailure(
            Databaseˉtreeˉnodeˉerror.Invalidˉkeyˉlength
        );
    }
    if Hasˉlower && (Bytesˉlength(Lower) == 0u32 ||
            Bytesˉlength(Lower) > DATABASE_TREE_NODE_MAXIMUM_KEY_BYTES) ||
        Hasˉupper && (Bytesˉlength(Upper) == 0u32 ||
            Bytesˉlength(Upper) > DATABASE_TREE_NODE_MAXIMUM_KEY_BYTES) {
        return Databaseˉtreeˉrouteˉfailure(
            Databaseˉtreeˉnodeˉerror.Invalidˉrange
        );
    }
    if Hasˉlower && Hasˉupper && Databaseˉtreeˉkeyˉcompare(
        Lower,
        Upper
    ) != Databaseˉtreeˉkeyˉorder.Less {
        return Databaseˉtreeˉrouteˉfailure(
            Databaseˉtreeˉnodeˉerror.Invalidˉrange
        );
    }
    let Node: Databaseˉtreeˉnodeˉresult =
        Databaseˉtreeˉnodeˉdecode(Input);
    if Node.Error != Databaseˉtreeˉnodeˉerror.Valid {
        return Databaseˉtreeˉrouteˉfailure(Node.Error);
    }
    if Node.Kind != Databaseˉtreeˉnodeˉkind.Branch {
        return Databaseˉtreeˉrouteˉfailure(
            Databaseˉtreeˉnodeˉerror.Invalidˉkind
        );
    }

    var Cursor: u32 = DATABASE_TREE_NODE_HEADER_BYTES;
    var Index: u32 = 0u32;
    var Previous: bytes = Databaseˉtreeˉempty();
    var Selected: bool = false;
    var Child: u64 = DATABASE_TREE_NODE_NO_PAGE;
    var Resultˉhasˉlower: bool = false;
    var Resultˉlower: bytes = Databaseˉtreeˉempty();
    var Resultˉhasˉupper: bool = false;
    var Resultˉupper: bytes = Databaseˉtreeˉempty();
    while Index < Node.Entryˉcount {
        let Separatorˉlength: u32 = Bytesˉreadˉu32ˉlittle(Input, Cursor);
        let Separator: bytes = Bytesˉslice(
            Input,
            Cursor + 16u32,
            Separatorˉlength
        );
        if Hasˉlower && Databaseˉtreeˉkeyˉcompare(
                Separator,
                Lower
            ) != Databaseˉtreeˉkeyˉorder.Greater ||
            Hasˉupper && Databaseˉtreeˉkeyˉcompare(
                Separator,
                Upper
            ) != Databaseˉtreeˉkeyˉorder.Less {
            return Databaseˉtreeˉrouteˉfailure(
                Databaseˉtreeˉnodeˉerror.Invalidˉrange
            );
        }
        if !Selected && Databaseˉtreeˉkeyˉcompare(
            Key,
            Separator
        ) == Databaseˉtreeˉkeyˉorder.Less {
            Selected = true;
            Child = Bytesˉreadˉu64ˉlittle(Input, Cursor + 8u32);
            if Index == 0u32 {
                Resultˉhasˉlower = Hasˉlower;
                if Hasˉlower {
                    Resultˉlower = Databaseˉtreeˉcopy(Lower);
                }
            } else {
                Resultˉhasˉlower = true;
                Resultˉlower = Databaseˉtreeˉcopy(Previous);
            }
            Resultˉhasˉupper = true;
            Resultˉupper = Databaseˉtreeˉcopy(Separator);
        }
        Previous = Separator;
        Cursor = Cursor + 16u32 + Separatorˉlength;
        Index = Index + 1u32;
    }
    if !Selected {
        Child = Node.Rightmostˉchild;
        Resultˉhasˉlower = true;
        Resultˉlower = Databaseˉtreeˉcopy(Previous);
        Resultˉhasˉupper = Hasˉupper;
        if Hasˉupper { Resultˉupper = Databaseˉtreeˉcopy(Upper); }
    }
    return Databaseˉtreeˉbranchˉrouteˉresult(
        Databaseˉtreeˉnodeˉerror.Valid,
        Child,
        Resultˉhasˉlower,
        Resultˉlower,
        Resultˉhasˉupper,
        Resultˉupper
    );
}

export fn Databaseˉtreeˉleafˉupsert(
    Input: bytes,
    Key: bytes,
    Value: bytes,
    Maximumˉpayload: u32
) -> Databaseˉtreeˉleafˉupsertˉresult {
    if Maximumˉpayload < DATABASE_TREE_NODE_HEADER_BYTES ||
        Maximumˉpayload > DATABASE_TREE_NODE_MAXIMUM_BYTES {
        return Databaseˉtreeˉupsertˉfailure(
            Databaseˉtreeˉnodeˉerror.Invalidˉmaximumˉpayload
        );
    }
    let Keyˉlength: u32 = Bytesˉlength(Key);
    if Keyˉlength == 0u32 ||
        Keyˉlength > DATABASE_TREE_NODE_MAXIMUM_KEY_BYTES {
        return Databaseˉtreeˉupsertˉfailure(
            Databaseˉtreeˉnodeˉerror.Invalidˉkeyˉlength
        );
    }
    if Bytesˉlength(Value) > DATABASE_TREE_NODE_MAXIMUM_VALUE_BYTES {
        return Databaseˉtreeˉupsertˉfailure(
            Databaseˉtreeˉnodeˉerror.Invalidˉvalueˉlength
        );
    }

    var Entryˉcount: u32 = 0u32;
    var Body: bytes = Databaseˉtreeˉempty();
    if Bytesˉlength(Input) != 0u32 {
        let Node: Databaseˉtreeˉnodeˉresult =
            Databaseˉtreeˉnodeˉdecode(Input);
        if Node.Error != Databaseˉtreeˉnodeˉerror.Valid {
            return Databaseˉtreeˉupsertˉfailure(Node.Error);
        }
        if Node.Kind != Databaseˉtreeˉnodeˉkind.Leaf {
            return Databaseˉtreeˉupsertˉfailure(
                Databaseˉtreeˉnodeˉerror.Invalidˉkind
            );
        }
        if Bytesˉlength(Input) > Maximumˉpayload {
            return Databaseˉtreeˉupsertˉfailure(
                Databaseˉtreeˉnodeˉerror.Full
            );
        }
        Entryˉcount = Node.Entryˉcount;
        Body = Bytesˉslice(
            Input,
            DATABASE_TREE_NODE_HEADER_BYTES,
            Bytesˉlength(Input) - DATABASE_TREE_NODE_HEADER_BYTES
        );
    }

    let Newˉentry: bytes = Databaseˉtreeˉleafˉentry(Key, Value);
    var Cursor: u32 = 0u32;
    var Index: u32 = 0u32;
    var Replaced: bool = false;
    var Insertˉoffset: u32 = Bytesˉlength(Body);
    var Oldˉend: u32 = Insertˉoffset;
    while Index < Entryˉcount {
        let Candidateˉkeyˉlength: u32 =
            Bytesˉreadˉu32ˉlittle(Body, Cursor);
        let Candidateˉvalueˉlength: u32 =
            Bytesˉreadˉu32ˉlittle(Body, Cursor + 4u32);
        let Candidateˉkey: bytes = Bytesˉslice(
            Body,
            Cursor + 8u32,
            Candidateˉkeyˉlength
        );
        let Order: Databaseˉtreeˉkeyˉorder =
            Databaseˉtreeˉkeyˉcompare(Key, Candidateˉkey);
        if Order == Databaseˉtreeˉkeyˉorder.Equal {
            Replaced = true;
            Insertˉoffset = Cursor;
            Oldˉend = Cursor + 8u32 + Candidateˉkeyˉlength +
                Candidateˉvalueˉlength;
            Index = Entryˉcount;
        } else if Order == Databaseˉtreeˉkeyˉorder.Less {
            Insertˉoffset = Cursor;
            Oldˉend = Cursor;
            Index = Entryˉcount;
        } else {
            Cursor = Cursor + 8u32 + Candidateˉkeyˉlength +
                Candidateˉvalueˉlength;
            Index = Index + 1u32;
        }
    }
    if !Replaced && Entryˉcount == DATABASE_TREE_NODE_MAXIMUM_ENTRIES {
        return Databaseˉtreeˉupsertˉfailure(
            Databaseˉtreeˉnodeˉerror.Full
        );
    }
    let Prefix: bytes = Bytesˉslice(Body, 0u32, Insertˉoffset);
    let Suffix: bytes = Bytesˉslice(
        Body,
        Oldˉend,
        Bytesˉlength(Body) - Oldˉend
    );
    let Newˉbody: bytes = Bytesˉconcat(
        Bytesˉconcat(Prefix, Newˉentry),
        Suffix
    );
    if Bytesˉlength(Newˉbody) >
        Maximumˉpayload - DATABASE_TREE_NODE_HEADER_BYTES {
        return Databaseˉtreeˉupsertˉfailure(
            Databaseˉtreeˉnodeˉerror.Full
        );
    }
    var Newˉcount: u32 = Entryˉcount;
    if !Replaced { Newˉcount = Newˉcount + 1u32; }
    let Resultˉbytes: bytes =
        Databaseˉtreeˉleafˉbytes(Newˉcount, Newˉbody);
    let Validation: Databaseˉtreeˉnodeˉresult =
        Databaseˉtreeˉnodeˉdecode(Resultˉbytes);
    if Validation.Error != Databaseˉtreeˉnodeˉerror.Valid {
        return Databaseˉtreeˉupsertˉfailure(Validation.Error);
    }
    if Validation.Entryˉcount != Newˉcount {
        return Databaseˉtreeˉupsertˉfailure(
            Databaseˉtreeˉnodeˉerror.Invalidˉcount
        );
    }
    return Databaseˉtreeˉleafˉupsertˉresult(
        Databaseˉtreeˉnodeˉerror.Valid,
        Replaced,
        Newˉcount,
        Resultˉbytes
    );
}

export fn Databaseˉtreeˉleafˉsplitˉupsert(
    Input: bytes,
    Key: bytes,
    Value: bytes,
    Maximumˉpayload: u32
) -> Databaseˉtreeˉnodeˉsplitˉresult {
    if Maximumˉpayload < DATABASE_TREE_NODE_HEADER_BYTES ||
        Maximumˉpayload > DATABASE_TREE_NODE_MAXIMUM_BYTES {
        return Databaseˉtreeˉsplitˉfailure(
            Databaseˉtreeˉnodeˉerror.Invalidˉmaximumˉpayload
        );
    }
    let Keyˉlength: u32 = Bytesˉlength(Key);
    if Keyˉlength == 0u32 ||
        Keyˉlength > DATABASE_TREE_NODE_MAXIMUM_KEY_BYTES {
        return Databaseˉtreeˉsplitˉfailure(
            Databaseˉtreeˉnodeˉerror.Invalidˉkeyˉlength
        );
    }
    if Bytesˉlength(Value) > DATABASE_TREE_NODE_MAXIMUM_VALUE_BYTES {
        return Databaseˉtreeˉsplitˉfailure(
            Databaseˉtreeˉnodeˉerror.Invalidˉvalueˉlength
        );
    }
    let Node: Databaseˉtreeˉnodeˉresult =
        Databaseˉtreeˉnodeˉdecode(Input);
    if Node.Error != Databaseˉtreeˉnodeˉerror.Valid {
        return Databaseˉtreeˉsplitˉfailure(Node.Error);
    }
    if Node.Kind != Databaseˉtreeˉnodeˉkind.Leaf {
        return Databaseˉtreeˉsplitˉfailure(
            Databaseˉtreeˉnodeˉerror.Invalidˉkind
        );
    }
    if Node.Entryˉcount == 0u32 {
        return Databaseˉtreeˉsplitˉfailure(
            Databaseˉtreeˉnodeˉerror.Cannotˉsplit
        );
    }
    if Bytesˉlength(Input) > Maximumˉpayload {
        return Databaseˉtreeˉsplitˉfailure(
            Databaseˉtreeˉnodeˉerror.Full
        );
    }

    let Body: bytes = Bytesˉslice(
        Input,
        DATABASE_TREE_NODE_HEADER_BYTES,
        Bytesˉlength(Input) - DATABASE_TREE_NODE_HEADER_BYTES
    );
    let Newˉentry: bytes = Databaseˉtreeˉleafˉentry(Key, Value);
    let Bodyˉcapacity: u32 =
        Maximumˉpayload - DATABASE_TREE_NODE_HEADER_BYTES;
    if Bytesˉlength(Newˉentry) > Bodyˉcapacity {
        return Databaseˉtreeˉsplitˉfailure(
            Databaseˉtreeˉnodeˉerror.Full
        );
    }
    var Cursor: u32 = 0u32;
    var Index: u32 = 0u32;
    var Replaced: bool = false;
    var Insertˉoffset: u32 = Bytesˉlength(Body);
    var Oldˉend: u32 = Insertˉoffset;
    while Index < Node.Entryˉcount {
        let Candidateˉkeyˉlength: u32 =
            Bytesˉreadˉu32ˉlittle(Body, Cursor);
        let Candidateˉvalueˉlength: u32 =
            Bytesˉreadˉu32ˉlittle(Body, Cursor + 4u32);
        let Candidateˉkey: bytes = Bytesˉslice(
            Body,
            Cursor + 8u32,
            Candidateˉkeyˉlength
        );
        let Order: Databaseˉtreeˉkeyˉorder =
            Databaseˉtreeˉkeyˉcompare(Key, Candidateˉkey);
        if Order == Databaseˉtreeˉkeyˉorder.Equal {
            Replaced = true;
            Insertˉoffset = Cursor;
            Oldˉend = Cursor + 8u32 + Candidateˉkeyˉlength +
                Candidateˉvalueˉlength;
            Index = Node.Entryˉcount;
        } else if Order == Databaseˉtreeˉkeyˉorder.Less {
            Insertˉoffset = Cursor;
            Oldˉend = Cursor;
            Index = Node.Entryˉcount;
        } else {
            Cursor = Cursor + 8u32 + Candidateˉkeyˉlength +
                Candidateˉvalueˉlength;
            Index = Index + 1u32;
        }
    }
    let Prefix: bytes = Bytesˉslice(Body, 0u32, Insertˉoffset);
    let Suffix: bytes = Bytesˉslice(
        Body,
        Oldˉend,
        Bytesˉlength(Body) - Oldˉend
    );
    let Combined: bytes = Bytesˉconcat(
        Bytesˉconcat(Prefix, Newˉentry),
        Suffix
    );
    var Entryˉcount: u32 = Node.Entryˉcount;
    if !Replaced { Entryˉcount = Entryˉcount + 1u32; }
    if Entryˉcount < 2u32 ||
        Bytesˉlength(Combined) > Bodyˉcapacity * 2u32 {
        return Databaseˉtreeˉsplitˉfailure(
            Databaseˉtreeˉnodeˉerror.Full
        );
    }

    Cursor = 0u32;
    Index = 0u32;
    var Found: bool = false;
    var Splitˉoffset: u32 = 0u32;
    var Leftˉcount: u32 = 0u32;
    var Bestˉdistance: u32 = 4294967295u32;
    while Index < Entryˉcount {
        let Scanˉkeyˉlength: u32 =
            Bytesˉreadˉu32ˉlittle(Combined, Cursor);
        let Scanˉvalueˉlength: u32 =
            Bytesˉreadˉu32ˉlittle(Combined, Cursor + 4u32);
        Cursor = Cursor + 8u32 + Scanˉkeyˉlength + Scanˉvalueˉlength;
        let Candidateˉleftˉcount: u32 = Index + 1u32;
        if Candidateˉleftˉcount < Entryˉcount {
            let Leftˉlength: u32 = Cursor;
            let Rightˉlength: u32 = Bytesˉlength(Combined) - Cursor;
            if Leftˉlength <= Bodyˉcapacity &&
                Rightˉlength <= Bodyˉcapacity {
                var Distance: u32 = 0u32;
                if Leftˉlength >= Rightˉlength {
                    Distance = Leftˉlength - Rightˉlength;
                } else {
                    Distance = Rightˉlength - Leftˉlength;
                }
                if !Found || Distance < Bestˉdistance {
                    Found = true;
                    Bestˉdistance = Distance;
                    Splitˉoffset = Cursor;
                    Leftˉcount = Candidateˉleftˉcount;
                }
            }
        }
        Index = Index + 1u32;
    }
    if !Found {
        return Databaseˉtreeˉsplitˉfailure(
            Databaseˉtreeˉnodeˉerror.Full
        );
    }
    let Rightˉcount: u32 = Entryˉcount - Leftˉcount;
    let Leftˉbytes: bytes = Databaseˉtreeˉleafˉbytes(
        Leftˉcount,
        Bytesˉslice(Combined, 0u32, Splitˉoffset)
    );
    let Rightˉbody: bytes = Bytesˉslice(
        Combined,
        Splitˉoffset,
        Bytesˉlength(Combined) - Splitˉoffset
    );
    let Rightˉbytes: bytes = Databaseˉtreeˉleafˉbytes(
        Rightˉcount,
        Rightˉbody
    );
    let Separatorˉlength: u32 = Bytesˉreadˉu32ˉlittle(Rightˉbody, 0u32);
    let Separator: bytes = Databaseˉtreeˉcopy(
        Bytesˉslice(Rightˉbody, 8u32, Separatorˉlength)
    );
    let Leftˉvalidation: Databaseˉtreeˉnodeˉerror =
        Databaseˉtreeˉleafˉrangeˉvalidate(
            Leftˉbytes,
            false,
            Databaseˉtreeˉempty(),
            true,
            Separator
        );
    if Leftˉvalidation != Databaseˉtreeˉnodeˉerror.Valid {
        return Databaseˉtreeˉsplitˉfailure(Leftˉvalidation);
    }
    let Rightˉvalidation: Databaseˉtreeˉnodeˉerror =
        Databaseˉtreeˉleafˉrangeˉvalidate(
            Rightˉbytes,
            true,
            Separator,
            false,
            Databaseˉtreeˉempty()
        );
    if Rightˉvalidation != Databaseˉtreeˉnodeˉerror.Valid {
        return Databaseˉtreeˉsplitˉfailure(Rightˉvalidation);
    }
    return Databaseˉtreeˉnodeˉsplitˉresult(
        Databaseˉtreeˉnodeˉerror.Valid,
        Replaced,
        Leftˉcount,
        Rightˉcount,
        Separator,
        Leftˉbytes,
        Rightˉbytes
    );
}
