#!wv/1 en@1
module Windvaleˉpackageˉresourceˉadmission;
profile core;
platform linux, windows, windvale;
authority library;

import Foundationˉmemory as Memory;
import Foundationˉcollections as Collections;
import Foundationˉoption as Option;
import Foundationˉresult as Result;
import Windvaleˉpackageˉlock as Lock;
import Windvaleˉpackageˉtext as Packageˉtext;

export enum Windvaleˉpackageˉresourceˉkind: i32 {
    Origin = 1;
    Manifest = 2;
    Compiler = 3;
    Project = 4;
    Part = 5;
    Output = 6;
}

export enum Windvaleˉpackageˉresourceˉstatus: i32 {
    Valid = 0;
    Invalidˉlock = 1301;
    Invalidˉindex = 1302;
    Pathˉmismatch = 1303;
    Byteˉcountˉmismatch = 1304;
    Digestˉmismatch = 1305;
    Allocationˉfailure = 1306;
}

export record Windvaleˉpackageˉresourceˉresult {
    Status: Windvaleˉpackageˉresourceˉstatus;
    Kind: Windvaleˉpackageˉresourceˉkind;
    Index: u32;
}

record Windvaleˉpackageˉlockedˉresource {
    Found: bool;
    Digestˉoffset: u32;
    Digestˉlength: u32;
    Bytes: u64;
    Pathˉoffset: u32;
    Pathˉlength: u32;
}

fn Admissionˉresult(
    Status: Windvaleˉpackageˉresourceˉstatus,
    Kind: Windvaleˉpackageˉresourceˉkind,
    Index: u32
) -> Windvaleˉpackageˉresourceˉresult {
    return Windvaleˉpackageˉresourceˉresult(Status, Kind, Index);
}

fn Missingˉresource() -> Windvaleˉpackageˉlockedˉresource {
    return Windvaleˉpackageˉlockedˉresource(
        false, 0u32, 0u32, 0u64, 0u32, 0u32
    );
}

fn Fixedˉresource(
    Digestˉoffset: u32,
    Digestˉlength: u32,
    Bytes: u64,
    Pathˉoffset: u32,
    Pathˉlength: u32
) -> Windvaleˉpackageˉlockedˉresource {
    return Windvaleˉpackageˉlockedˉresource(
        true, Digestˉoffset, Digestˉlength, Bytes, Pathˉoffset, Pathˉlength
    );
}

fn Selectˉresource(
    Scan: borrow Lock.Windvaleˉlockˉscan<Collections.Vector<Lock.Windvaleˉlockedˉpart> >,
    Kind: Windvaleˉpackageˉresourceˉkind,
    Index: u32
) -> Windvaleˉpackageˉlockedˉresource {
    if Kind == Windvaleˉpackageˉresourceˉkind.Part {
        let Part: Lock.Windvaleˉlockedˉpart =
            Lock.Windvaleˉlockedˉpartˉat(borrow Scan, Index);
        if !Part.Found { return Missingˉresource(); }
        return Fixedˉresource(
            Part.Digestˉoffset, Part.Digestˉlength, Part.Bytes,
            Part.Pathˉoffset, Part.Pathˉlength
        );
    }
    if Index != 0u32 { return Missingˉresource(); }
    if Kind == Windvaleˉpackageˉresourceˉkind.Origin {
        return Fixedˉresource(
            Scan.Originˉdigestˉoffset, Scan.Originˉdigestˉlength,
            Scan.Originˉbytes, Scan.Originˉpathˉoffset, Scan.Originˉpathˉlength
        );
    }
    if Kind == Windvaleˉpackageˉresourceˉkind.Manifest {
        return Fixedˉresource(
            Scan.Packageˉdigestˉoffset, Scan.Packageˉdigestˉlength,
            Scan.Packageˉbytes, Scan.Packageˉpathˉoffset, Scan.Packageˉpathˉlength
        );
    }
    if Kind == Windvaleˉpackageˉresourceˉkind.Compiler {
        return Fixedˉresource(
            Scan.Compilerˉdigestˉoffset, Scan.Compilerˉdigestˉlength,
            Scan.Compilerˉbytes, Scan.Compilerˉpathˉoffset, Scan.Compilerˉpathˉlength
        );
    }
    if Kind == Windvaleˉpackageˉresourceˉkind.Project {
        return Fixedˉresource(
            Scan.Projectˉdigestˉoffset, Scan.Projectˉdigestˉlength,
            Scan.Projectˉbytes, Scan.Projectˉpathˉoffset, Scan.Projectˉpathˉlength
        );
    }
    if Kind == Windvaleˉpackageˉresourceˉkind.Output {
        return Fixedˉresource(
            Scan.Outputˉdigestˉoffset, Scan.Outputˉdigestˉlength,
            Scan.Outputˉbytes, 0u32, 0u32
        );
    }
    return Missingˉresource();
}

export fn Windvaleˉpackageˉverifyˉscannedˉresource(
    Lockˉinput: bytes,
    Scan: borrow Lock.Windvaleˉlockˉscan<Collections.Vector<Lock.Windvaleˉlockedˉpart> >,
    Kind: Windvaleˉpackageˉresourceˉkind,
    Index: u32,
    Path: bytes,
    Resource: bytes
) -> Windvaleˉpackageˉresourceˉresult {
    let Expected: Windvaleˉpackageˉlockedˉresource =
        Selectˉresource(borrow Scan, Kind, Index);
    return Checkˉresource(Lockˉinput, Kind, Index, Path, Resource, Expected);
}

export fn Windvaleˉpackageˉverifyˉlockedˉresource(
    Lockˉinput: bytes,
    Kind: Windvaleˉpackageˉresourceˉkind,
    Index: u32,
    Path: bytes,
    Resource: bytes,
    Budget: Memory.Memoryˉbudget
) -> Windvaleˉpackageˉresourceˉresult {
    let Parsed: Result.Result<Lock.Windvaleˉlockˉscan<Collections.Vector<Lock.Windvaleˉlockedˉpart> >, Lock.Windvaleˉlockˉfailure> =
        Lock.Windvaleˉpackageˉscanˉlock(Lockˉinput, Budget);
    match Result.Borrowˉvalid(borrow Parsed) {
        case Option.Option.Present { Value: Scan } {
            return Windvaleˉpackageˉverifyˉscannedˉresource(
                Lockˉinput, borrow Scan, Kind, Index, Path, Resource
            );
        }
        case Option.Option.Absent {
            match Result.Borrowˉfailure(borrow Parsed) {
                case Option.Option.Present { Value: Error } {
                    match Error {
                        case Lock.Windvaleˉlockˉfailure.Invalid { Status: _, Line: _, Column: _ } {
                            return Admissionˉresult(Windvaleˉpackageˉresourceˉstatus.Invalidˉlock, Kind, Index);
                        }
                        case Lock.Windvaleˉlockˉfailure.Allocation { Error: _ } {
                            return Admissionˉresult(Windvaleˉpackageˉresourceˉstatus.Allocationˉfailure, Kind, Index);
                        }
                    }
                }
                case Option.Option.Absent {
                    return Admissionˉresult(Windvaleˉpackageˉresourceˉstatus.Invalidˉlock, Kind, Index);
                }
            }
        }
    }
}

fn Checkˉresource(
    Lockˉinput: bytes,
    Kind: Windvaleˉpackageˉresourceˉkind,
    Index: u32,
    Path: bytes,
    Resource: bytes,
    Expected: Windvaleˉpackageˉlockedˉresource
) -> Windvaleˉpackageˉresourceˉresult {
    if !Expected.Found {
        return Admissionˉresult(
            Windvaleˉpackageˉresourceˉstatus.Invalidˉindex, Kind, Index
        );
    }

    if Kind == Windvaleˉpackageˉresourceˉkind.Output {
        if Bytesˉlength(Path) != 0u32 {
            return Admissionˉresult(
                Windvaleˉpackageˉresourceˉstatus.Pathˉmismatch, Kind, Index
            );
        }
    } else {
        if !Packageˉtext.Windvaleˉpackageˉspansˉequal(
            Path,
            Packageˉtext.Windvaleˉpackageˉwholeˉspan(Path),
            Lockˉinput,
            Packageˉtext.Windvaleˉpackageˉspan(
                Expected.Pathˉoffset, Expected.Pathˉlength
            )
        ) {
            return Admissionˉresult(
                Windvaleˉpackageˉresourceˉstatus.Pathˉmismatch, Kind, Index
            );
        }
    }
    if U64ˉfromˉu32(Bytesˉlength(Resource)) != Expected.Bytes {
        return Admissionˉresult(
            Windvaleˉpackageˉresourceˉstatus.Byteˉcountˉmismatch, Kind, Index
        );
    }
    let Digest: bytes = Textˉtoˉutf8(Bytesˉsha256ˉhex(Resource));
    if !Packageˉtext.Windvaleˉpackageˉspansˉequal(
        Digest,
        Packageˉtext.Windvaleˉpackageˉwholeˉspan(Digest),
        Lockˉinput,
        Packageˉtext.Windvaleˉpackageˉspan(
            Expected.Digestˉoffset, Expected.Digestˉlength
        )
    ) {
        return Admissionˉresult(
            Windvaleˉpackageˉresourceˉstatus.Digestˉmismatch, Kind, Index
        );
    }
    return Admissionˉresult(
        Windvaleˉpackageˉresourceˉstatus.Valid, Kind, Index
    );
}

export fn Windvaleˉpackageˉresourceˉdiagnosticˉcode(
    Status: Windvaleˉpackageˉresourceˉstatus
) -> text {
    if Status == Windvaleˉpackageˉresourceˉstatus.Invalidˉlock { return "WVPK1301"; }
    if Status == Windvaleˉpackageˉresourceˉstatus.Invalidˉindex { return "WVPK1302"; }
    if Status == Windvaleˉpackageˉresourceˉstatus.Pathˉmismatch { return "WVPK1303"; }
    if Status == Windvaleˉpackageˉresourceˉstatus.Byteˉcountˉmismatch { return "WVPK1304"; }
    if Status == Windvaleˉpackageˉresourceˉstatus.Digestˉmismatch { return "WVPK1305"; }
    if Status == Windvaleˉpackageˉresourceˉstatus.Allocationˉfailure { return "WVPK1306"; }
    return "";
}
