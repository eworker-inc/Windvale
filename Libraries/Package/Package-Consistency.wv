#!wv/1 en@1
module Windvaleˉpackageˉconsistency;
profile core;
platform linux, windows, windvale;
authority library;

import Foundationˉmemory as Memory;
import Foundationˉcollections as Collections;
import Foundationˉresult as Result;
import Foundationˉoption as Option;
import Windvaleˉpackageˉlock as Lock;
import Windvaleˉpackageˉmanifest as Manifest;
import Windvaleˉpackageˉtext as Packageˉtext;

export enum Windvaleˉpackageˉconsistencyˉstatus: i32 {
    Valid = 0;
    Invalidˉmanifest = 1201;
    Invalidˉlock = 1202;
    Nameˉmismatch = 1203;
    Versionˉmismatch = 1204;
    Rootˉmismatch = 1205;
    Targetˉmismatch = 1206;
    Licenseˉmismatch = 1207;
    Projectˉmismatch = 1208;
    Packageˉidentityˉmismatch = 1209;
    Partˉcountˉmismatch = 1210;
    Partˉmismatch = 1211;
    Dependencyˉcountˉmismatch = 1212;
    Dependencyˉmismatch = 1213;
    Capabilityˉcountˉmismatch = 1214;
    Capabilityˉmismatch = 1215;
    Allocationˉfailure = 1216;
}

export record Windvaleˉpackageˉconsistencyˉresult {
    Status: Windvaleˉpackageˉconsistencyˉstatus;
    Index: u32;
}

fn Consistencyˉspan(
    Offset: u32,
    Length: u32
) -> Packageˉtext.Windvaleˉpackageˉspan {
    return Packageˉtext.Windvaleˉpackageˉspan(Offset, Length);
}

fn Consistencyˉequal(
    Manifestˉinput: bytes,
    Manifestˉoffset: u32,
    Manifestˉlength: u32,
    Lockˉinput: bytes,
    Lockˉoffset: u32,
    Lockˉlength: u32
) -> bool {
    return Packageˉtext.Windvaleˉpackageˉspansˉequal(
        Manifestˉinput,
        Consistencyˉspan(Manifestˉoffset, Manifestˉlength),
        Lockˉinput,
        Consistencyˉspan(Lockˉoffset, Lockˉlength)
    );
}

fn Consistencyˉresult(
    Status: Windvaleˉpackageˉconsistencyˉstatus,
    Index: u32
) -> Windvaleˉpackageˉconsistencyˉresult {
    return Windvaleˉpackageˉconsistencyˉresult(Status, Index);
}

fn Readˉlockedˉdependency(Directory: bytes, Count: u32, Index: u32) -> Lock.Windvaleˉlockedˉdependency {
    if Index >= Count { return Lock.Windvaleˉlockedˉdependency(false, 0u32, 0u32, 0u32, 0u32); }
    let Offset: u32 = Index * 16u32;
    if Offset > Bytesˉlength(Directory) || Bytesˉlength(Directory) - Offset < 16u32 {
        return Lock.Windvaleˉlockedˉdependency(false, 0u32, 0u32, 0u32, 0u32);
    }
    return Lock.Windvaleˉlockedˉdependency(
        true,
        Bytesˉreadˉu32ˉlittle(Directory, Offset),
        Bytesˉreadˉu32ˉlittle(Directory, Offset + 4u32),
        Bytesˉreadˉu32ˉlittle(Directory, Offset + 8u32),
        Bytesˉreadˉu32ˉlittle(Directory, Offset + 12u32)
    );
}

fn Readˉlockedˉcapability(Directory: bytes, Dependencies: u32, Count: u32, Index: u32) -> Lock.Windvaleˉlockedˉcapability {
    if Index >= Count { return Lock.Windvaleˉlockedˉcapability(false, 0u32, 0u32); }
    let Offset: u32 = Dependencies * 16u32 + Index * 8u32;
    if Offset > Bytesˉlength(Directory) || Bytesˉlength(Directory) - Offset < 8u32 {
        return Lock.Windvaleˉlockedˉcapability(false, 0u32, 0u32);
    }
    return Lock.Windvaleˉlockedˉcapability(
        true,
        Bytesˉreadˉu32ˉlittle(Directory, Offset),
        Bytesˉreadˉu32ˉlittle(Directory, Offset + 4u32)
    );
}

record Lockˉprecheck {
    Result: Windvaleˉpackageˉconsistencyˉresult;
    Directory: bytes;
    Dependencies: u32;
    Capabilities: u32;
}

fn Precheckˉfailure(Status: Windvaleˉpackageˉconsistencyˉstatus, Index: u32) -> Lockˉprecheck {
    return Lockˉprecheck(Consistencyˉresult(Status, Index), Textˉtoˉutf8(""), 0u32, 0u32);
}

fn Checkˉheaderˉandˉparts(
    Manifestˉinput: bytes,
    Lockˉinput: bytes,
    Manifestˉscan: Manifest.Windvaleˉpackageˉscan,
    Lockˉscan: borrow Lock.Windvaleˉlockˉscan<Collections.Vector<Lock.Windvaleˉlockedˉpart> >
) -> Lockˉprecheck {
    if !Consistencyˉequal(
        Manifestˉinput, Manifestˉscan.Nameˉoffset, Manifestˉscan.Nameˉlength,
        Lockˉinput, Lockˉscan.Nameˉoffset, Lockˉscan.Nameˉlength
    ) {
        return Precheckˉfailure(
            Windvaleˉpackageˉconsistencyˉstatus.Nameˉmismatch, 0u32
        );
    }
    if !Consistencyˉequal(
        Manifestˉinput, Manifestˉscan.Versionˉoffset, Manifestˉscan.Versionˉlength,
        Lockˉinput, Lockˉscan.Versionˉoffset, Lockˉscan.Versionˉlength
    ) {
        return Precheckˉfailure(
            Windvaleˉpackageˉconsistencyˉstatus.Versionˉmismatch, 0u32
        );
    }
    if !Consistencyˉequal(
        Manifestˉinput, Manifestˉscan.Rootˉoffset, Manifestˉscan.Rootˉlength,
        Lockˉinput, Lockˉscan.Rootˉoffset, Lockˉscan.Rootˉlength
    ) {
        return Precheckˉfailure(
            Windvaleˉpackageˉconsistencyˉstatus.Rootˉmismatch, 0u32
        );
    }
    if !Consistencyˉequal(
        Manifestˉinput, Manifestˉscan.Targetˉoffset, Manifestˉscan.Targetˉlength,
        Lockˉinput, Lockˉscan.Targetˉoffset, Lockˉscan.Targetˉlength
    ) {
        return Precheckˉfailure(
            Windvaleˉpackageˉconsistencyˉstatus.Targetˉmismatch, 0u32
        );
    }
    if !Consistencyˉequal(
        Manifestˉinput, Manifestˉscan.Licenseˉoffset, Manifestˉscan.Licenseˉlength,
        Lockˉinput, Lockˉscan.Licenseˉoffset, Lockˉscan.Licenseˉlength
    ) {
        return Precheckˉfailure(
            Windvaleˉpackageˉconsistencyˉstatus.Licenseˉmismatch, 0u32
        );
    }
    if !Consistencyˉequal(
        Manifestˉinput, Manifestˉscan.Projectˉoffset, Manifestˉscan.Projectˉlength,
        Lockˉinput, Lockˉscan.Projectˉpathˉoffset, Lockˉscan.Projectˉpathˉlength
    ) {
        return Precheckˉfailure(
            Windvaleˉpackageˉconsistencyˉstatus.Projectˉmismatch, 0u32
        );
    }

    if Lockˉscan.Packageˉbytes != U64ˉfromˉu32(Bytesˉlength(Manifestˉinput)) {
        return Precheckˉfailure(
            Windvaleˉpackageˉconsistencyˉstatus.Packageˉidentityˉmismatch, 0u32
        );
    }
    let Manifestˉdigest: bytes = Textˉtoˉutf8(Bytesˉsha256ˉhex(Manifestˉinput));
    if !Packageˉtext.Windvaleˉpackageˉspansˉequal(
        Manifestˉdigest,
        Packageˉtext.Windvaleˉpackageˉwholeˉspan(Manifestˉdigest),
        Lockˉinput,
        Consistencyˉspan(
            Lockˉscan.Packageˉdigestˉoffset,
            Lockˉscan.Packageˉdigestˉlength
        )
    ) {
        return Precheckˉfailure(
            Windvaleˉpackageˉconsistencyˉstatus.Packageˉidentityˉmismatch, 0u32
        );
    }

    if Manifestˉscan.Parts != Lockˉscan.Parts {
        return Precheckˉfailure(
            Windvaleˉpackageˉconsistencyˉstatus.Partˉcountˉmismatch, 0u32
        );
    }
    var Partˉindex: u32 = 0u32;
    while Partˉindex < Manifestˉscan.Parts {
        let Manifestˉpart: Manifest.Windvaleˉpackageˉpart =
            Manifest.Windvaleˉpackageˉpartˉat(Manifestˉscan, Partˉindex);
        let Lockedˉpart: Lock.Windvaleˉlockedˉpart =
            Lock.Windvaleˉlockedˉpartˉat(borrow Lockˉscan, Partˉindex);
        if !Manifestˉpart.Found || !Lockedˉpart.Found ||
            Manifestˉpart.Scope != Lockedˉpart.Scope {
            return Precheckˉfailure(
                Windvaleˉpackageˉconsistencyˉstatus.Partˉmismatch, Partˉindex
            );
        }
        if !Consistencyˉequal(
            Manifestˉinput, Manifestˉpart.Nameˉoffset, Manifestˉpart.Nameˉlength,
            Lockˉinput, Lockedˉpart.Nameˉoffset, Lockedˉpart.Nameˉlength
        ) || !Consistencyˉequal(
            Manifestˉinput, Manifestˉpart.Pathˉoffset, Manifestˉpart.Pathˉlength,
            Lockˉinput, Lockedˉpart.Pathˉoffset, Lockedˉpart.Pathˉlength
        ) {
            return Precheckˉfailure(
                Windvaleˉpackageˉconsistencyˉstatus.Partˉmismatch, Partˉindex
            );
        }
        Partˉindex = Partˉindex + 1u32;
    }

    return Lockˉprecheck(
        Consistencyˉresult(Windvaleˉpackageˉconsistencyˉstatus.Valid, 0u32),
        Lockˉscan.Directory, Lockˉscan.Dependencies, Lockˉscan.Capabilities
    );
}

export fn Windvaleˉpackageˉverifyˉscannedˉmanifestˉlock(
    Manifestˉinput: bytes,
    Lockˉinput: bytes,
    Manifestˉscan: Manifest.Windvaleˉpackageˉscan,
    Lockˉscan: borrow Lock.Windvaleˉlockˉscan<Collections.Vector<Lock.Windvaleˉlockedˉpart> >
) -> Windvaleˉpackageˉconsistencyˉresult {
    if Manifestˉscan.Status != Manifest.Windvaleˉpackageˉstatus.Valid {
        return Consistencyˉresult(
            Windvaleˉpackageˉconsistencyˉstatus.Invalidˉmanifest, 0u32
        );
    }
    let Prechecked: Lockˉprecheck =
        Checkˉheaderˉandˉparts(Manifestˉinput, Lockˉinput, Manifestˉscan, borrow Lockˉscan);
    if Prechecked.Result.Status != Windvaleˉpackageˉconsistencyˉstatus.Valid {
        return Prechecked.Result;
    }
    if Manifestˉscan.Dependencies != Prechecked.Dependencies {
        return Consistencyˉresult(
            Windvaleˉpackageˉconsistencyˉstatus.Dependencyˉcountˉmismatch, 0u32
        );
    }
    var Dependencyˉindex: u32 = 0u32;
    while Dependencyˉindex < Manifestˉscan.Dependencies {
        let Manifestˉdependency: Manifest.Windvaleˉpackageˉdependency =
            Manifest.Windvaleˉpackageˉdependencyˉat(Manifestˉscan, Dependencyˉindex);
        let Lockedˉdependency: Lock.Windvaleˉlockedˉdependency =
            Readˉlockedˉdependency(Prechecked.Directory, Prechecked.Dependencies, Dependencyˉindex);
        if !Manifestˉdependency.Found || !Lockedˉdependency.Found ||
            !Consistencyˉequal(
                Manifestˉinput,
                Manifestˉdependency.Importerˉoffset,
                Manifestˉdependency.Importerˉlength,
                Lockˉinput,
                Lockedˉdependency.Importerˉoffset,
                Lockedˉdependency.Importerˉlength
            ) || !Consistencyˉequal(
                Manifestˉinput,
                Manifestˉdependency.Requiredˉoffset,
                Manifestˉdependency.Requiredˉlength,
                Lockˉinput,
                Lockedˉdependency.Requiredˉoffset,
                Lockedˉdependency.Requiredˉlength
            ) {
            return Consistencyˉresult(
                Windvaleˉpackageˉconsistencyˉstatus.Dependencyˉmismatch,
                Dependencyˉindex
            );
        }
        Dependencyˉindex = Dependencyˉindex + 1u32;
    }

    if Manifestˉscan.Capabilities != Prechecked.Capabilities {
        return Consistencyˉresult(
            Windvaleˉpackageˉconsistencyˉstatus.Capabilityˉcountˉmismatch, 0u32
        );
    }
    var Capabilityˉindex: u32 = 0u32;
    while Capabilityˉindex < Manifestˉscan.Capabilities {
        let Manifestˉcapability: Manifest.Windvaleˉpackageˉcapability =
            Manifest.Windvaleˉpackageˉcapabilityˉat(Manifestˉscan, Capabilityˉindex);
        let Lockedˉcapability: Lock.Windvaleˉlockedˉcapability =
            Readˉlockedˉcapability(Prechecked.Directory, Prechecked.Dependencies, Prechecked.Capabilities, Capabilityˉindex);
        if !Manifestˉcapability.Found || !Lockedˉcapability.Found ||
            !Consistencyˉequal(
                Manifestˉinput,
                Manifestˉcapability.Nameˉoffset,
                Manifestˉcapability.Nameˉlength,
                Lockˉinput,
                Lockedˉcapability.Nameˉoffset,
                Lockedˉcapability.Nameˉlength
            ) {
            return Consistencyˉresult(
                Windvaleˉpackageˉconsistencyˉstatus.Capabilityˉmismatch,
                Capabilityˉindex
            );
        }
        Capabilityˉindex = Capabilityˉindex + 1u32;
    }
    return Consistencyˉresult(
        Windvaleˉpackageˉconsistencyˉstatus.Valid, 0u32
    );
}

export fn Windvaleˉpackageˉverifyˉmanifestˉlock(
    Manifestˉinput: bytes,
    Lockˉinput: bytes,
    Budget: Memory.Memoryˉbudget
) -> Windvaleˉpackageˉconsistencyˉresult {
    let Manifestˉscan: Manifest.Windvaleˉpackageˉscan =
        Manifest.Windvaleˉpackageˉscanˉmanifest(Manifestˉinput);
    if Manifestˉscan.Status != Manifest.Windvaleˉpackageˉstatus.Valid {
        return Consistencyˉresult(
            Windvaleˉpackageˉconsistencyˉstatus.Invalidˉmanifest, 0u32
        );
    }
    let Parsed: Result.Result<Lock.Windvaleˉlockˉscan<Collections.Vector<Lock.Windvaleˉlockedˉpart> >, Lock.Windvaleˉlockˉfailure> =
        Lock.Windvaleˉpackageˉscanˉlock(Lockˉinput, Budget);
    match Result.Borrowˉvalid(borrow Parsed) {
        case Option.Option.Present { Value: Lockˉscan } {
            return Windvaleˉpackageˉverifyˉscannedˉmanifestˉlock(
                Manifestˉinput, Lockˉinput, Manifestˉscan, borrow Lockˉscan
            );
        }
        case Option.Option.Absent {
            match Result.Borrowˉfailure(borrow Parsed) {
                case Option.Option.Present { Value: Error } {
                    match Error {
                        case Lock.Windvaleˉlockˉfailure.Invalid { Status: _, Line: _, Column: _ } {
                            return Consistencyˉresult(
                                Windvaleˉpackageˉconsistencyˉstatus.Invalidˉlock, 0u32
                            );
                        }
                        case Lock.Windvaleˉlockˉfailure.Allocation { Error: _ } {
                            return Consistencyˉresult(
                                Windvaleˉpackageˉconsistencyˉstatus.Allocationˉfailure, 0u32
                            );
                        }
                    }
                }
                case Option.Option.Absent {
                    return Consistencyˉresult(
                        Windvaleˉpackageˉconsistencyˉstatus.Invalidˉlock, 0u32
                    );
                }
            }
        }
    }
}

export fn Windvaleˉpackageˉconsistencyˉdiagnosticˉcode(
    Status: Windvaleˉpackageˉconsistencyˉstatus
) -> text {
    if Status == Windvaleˉpackageˉconsistencyˉstatus.Invalidˉmanifest { return "WVPK1201"; }
    if Status == Windvaleˉpackageˉconsistencyˉstatus.Invalidˉlock { return "WVPK1202"; }
    if Status == Windvaleˉpackageˉconsistencyˉstatus.Nameˉmismatch { return "WVPK1203"; }
    if Status == Windvaleˉpackageˉconsistencyˉstatus.Versionˉmismatch { return "WVPK1204"; }
    if Status == Windvaleˉpackageˉconsistencyˉstatus.Rootˉmismatch { return "WVPK1205"; }
    if Status == Windvaleˉpackageˉconsistencyˉstatus.Targetˉmismatch { return "WVPK1206"; }
    if Status == Windvaleˉpackageˉconsistencyˉstatus.Licenseˉmismatch { return "WVPK1207"; }
    if Status == Windvaleˉpackageˉconsistencyˉstatus.Projectˉmismatch { return "WVPK1208"; }
    if Status == Windvaleˉpackageˉconsistencyˉstatus.Packageˉidentityˉmismatch { return "WVPK1209"; }
    if Status == Windvaleˉpackageˉconsistencyˉstatus.Partˉcountˉmismatch { return "WVPK1210"; }
    if Status == Windvaleˉpackageˉconsistencyˉstatus.Partˉmismatch { return "WVPK1211"; }
    if Status == Windvaleˉpackageˉconsistencyˉstatus.Dependencyˉcountˉmismatch { return "WVPK1212"; }
    if Status == Windvaleˉpackageˉconsistencyˉstatus.Dependencyˉmismatch { return "WVPK1213"; }
    if Status == Windvaleˉpackageˉconsistencyˉstatus.Capabilityˉcountˉmismatch { return "WVPK1214"; }
    if Status == Windvaleˉpackageˉconsistencyˉstatus.Capabilityˉmismatch { return "WVPK1215"; }
    if Status == Windvaleˉpackageˉconsistencyˉstatus.Allocationˉfailure { return "WVPK1216"; }
    return "";
}
