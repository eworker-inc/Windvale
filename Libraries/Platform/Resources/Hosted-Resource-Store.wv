module Hostedˉresourceˉstore profile hosted;

import Resourceˉstore as Resourceˉstore;

capability file.read_bytes;

export fn Hostedˉresourceˉstoreˉlookup(
    Storeˉresource: text,
    Name: text
) -> Resourceˉstore.Resourceˉstoreˉresult {
    let Store: bytes = file.read_bytes(Storeˉresource);
    return Resourceˉstore.Resourceˉstoreˉlookup(Store, Name);
}
