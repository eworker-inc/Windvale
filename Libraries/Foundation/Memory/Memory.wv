#!wv/1 en@1
module Foundationˉmemory;
profile core;
platform linux, windows, windvale;
authority library;

// Memoryˉbudget is a compiler-supplied, representation-hidden, move-owned
// Foundation identity. Core source can receive it from an admitted launcher or
// parent domain but cannot construct one from ambient memory. Split has exact
// source, WVIR, and WVB identities. A bounded generation-safe allocation-lease
// accounting oracle now exists, while public Vector allocation and provider
// connection remain later migration checkpoints. This module does not publish
// forgeable record substitutes or the oracle's private token representation.

export enum Allocationˉreason: u8 {
    Budgetˉexhausted = 1u8;
    Targetˉunaddressable = 2u8;
    Providerˉunavailable = 3u8;
    Fragmented = 4u8;
}

export record Allocationˉfailure {
    Reason: Allocationˉreason;
    Requestedˉbytes: u64;
    Availableˉbytes: u64;
}
