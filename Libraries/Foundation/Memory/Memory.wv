#!wv/1 en@1
module Foundationˉmemory;
profile core;
platform linux, windows, windvale;
authority library;

// Memoryˉbudget is a compiler-supplied, representation-hidden, move-owned
// Foundation identity. Core source can receive it from an admitted launcher or
// parent domain but cannot construct one from ambient memory. Split has exact
// source, WVIR, and WVB identities. A bounded generation-safe allocation-lease
// accounting oracle now exists. Reserved Vector construction consumes one
// budget. Explicit Vector growth instead borrows a separately named mutable
// budget and publishes neither accounting nor capacity changes on refusal. A
// provider-backed budget may request rights-limited extension under current
// policy; fixed budgets refuse deterministically. This module does not publish
// forgeable record substitutes or private token/lease representations.

export enum Allocationˉreason: u8 {
    Budgetˉexhausted = 1u8;
    Targetˉunaddressable = 2u8;
    Providerˉunavailable = 3u8;
    Fragmented = 4u8;
}

export record Allocationˉfailure {
    Reason: Allocationˉreason;
    Requestedˉbytes: u64;
    Availableˉbytes: u64;
}
