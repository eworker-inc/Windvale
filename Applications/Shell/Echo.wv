module Windvaleˉecho;

platform linux, windows;
authority application;
requires capability console.write_line version 1;
requires capability process.argument version 1;
requires capability process.argument_count version 1;

enum Windvaleˉechoˉposition {
    First = 0;
    Following = 1;
}

export fn Main() -> i32 {
    let Count: u32 = process.argument_count();
    var Index: u32 = 0u32;
    var Output: text = "";
    var Position: Windvaleˉechoˉposition = Windvaleˉechoˉposition.First;
    while Index < Count {
        if Position == Windvaleˉechoˉposition.Following {
            Output = Textˉconcat(Output, " ");
        }
        Output = Textˉconcat(Output, process.argument(Index));
        Position = Windvaleˉechoˉposition.Following;
        Index = Index + 1u32;
    }
    console.write_line(Output);
    return 0;
}
