module Foundationˉsha256 profile portable;

fn Addˉwrapping(Left: u32, Right: u32) -> u32 {
    var Value: u32 = Left;
    var Carry: u32 = Right;
    while Carry != 0u32 {
        let Nextˉcarry: u32 = (Value & Carry) << 1u32;
        Value = Value ^ Carry;
        Carry = Nextˉcarry;
    }
    return Value;
}

fn Rotateˉright(Value: u32, Count: u32) -> u32 {
    return (Value >> Count) | (Value << (32u32 - Count));
}

fn Roundˉconstant(Index: u32) -> u32 {
    if Index == 0u32 { return 1116352408u32; }
    if Index == 1u32 { return 1899447441u32; }
    if Index == 2u32 { return 3049323471u32; }
    if Index == 3u32 { return 3921009573u32; }
    if Index == 4u32 { return 961987163u32; }
    if Index == 5u32 { return 1508970993u32; }
    if Index == 6u32 { return 2453635748u32; }
    if Index == 7u32 { return 2870763221u32; }
    if Index == 8u32 { return 3624381080u32; }
    if Index == 9u32 { return 310598401u32; }
    if Index == 10u32 { return 607225278u32; }
    if Index == 11u32 { return 1426881987u32; }
    if Index == 12u32 { return 1925078388u32; }
    if Index == 13u32 { return 2162078206u32; }
    if Index == 14u32 { return 2614888103u32; }
    if Index == 15u32 { return 3248222580u32; }
    if Index == 16u32 { return 3835390401u32; }
    if Index == 17u32 { return 4022224774u32; }
    if Index == 18u32 { return 264347078u32; }
    if Index == 19u32 { return 604807628u32; }
    if Index == 20u32 { return 770255983u32; }
    if Index == 21u32 { return 1249150122u32; }
    if Index == 22u32 { return 1555081692u32; }
    if Index == 23u32 { return 1996064986u32; }
    if Index == 24u32 { return 2554220882u32; }
    if Index == 25u32 { return 2821834349u32; }
    if Index == 26u32 { return 2952996808u32; }
    if Index == 27u32 { return 3210313671u32; }
    if Index == 28u32 { return 3336571891u32; }
    if Index == 29u32 { return 3584528711u32; }
    if Index == 30u32 { return 113926993u32; }
    if Index == 31u32 { return 338241895u32; }
    if Index == 32u32 { return 666307205u32; }
    if Index == 33u32 { return 773529912u32; }
    if Index == 34u32 { return 1294757372u32; }
    if Index == 35u32 { return 1396182291u32; }
    if Index == 36u32 { return 1695183700u32; }
    if Index == 37u32 { return 1986661051u32; }
    if Index == 38u32 { return 2177026350u32; }
    if Index == 39u32 { return 2456956037u32; }
    if Index == 40u32 { return 2730485921u32; }
    if Index == 41u32 { return 2820302411u32; }
    if Index == 42u32 { return 3259730800u32; }
    if Index == 43u32 { return 3345764771u32; }
    if Index == 44u32 { return 3516065817u32; }
    if Index == 45u32 { return 3600352804u32; }
    if Index == 46u32 { return 4094571909u32; }
    if Index == 47u32 { return 275423344u32; }
    if Index == 48u32 { return 430227734u32; }
    if Index == 49u32 { return 506948616u32; }
    if Index == 50u32 { return 659060556u32; }
    if Index == 51u32 { return 883997877u32; }
    if Index == 52u32 { return 958139571u32; }
    if Index == 53u32 { return 1322822218u32; }
    if Index == 54u32 { return 1537002063u32; }
    if Index == 55u32 { return 1747873779u32; }
    if Index == 56u32 { return 1955562222u32; }
    if Index == 57u32 { return 2024104815u32; }
    if Index == 58u32 { return 2227730452u32; }
    if Index == 59u32 { return 2361852424u32; }
    if Index == 60u32 { return 2428436474u32; }
    if Index == 61u32 { return 2756734187u32; }
    if Index == 62u32 { return 3204031479u32; }
    return 3329325298u32;
}

fn Messageˉbyte(Value: bytes, Length: u32, Position: u32, Paddedˉlength: u32) -> u32 {
    if Position < Length {
        return U32ˉfromˉu8(Bytesˉreadˉu8(Value, Position));
    }
    if Position == Length { return 128u32; }
    if Position < Paddedˉlength - 4u32 { return 0u32; }
    let Shift: u32 = (Paddedˉlength - 1u32 - Position) * 8u32;
    return ((Length << 3u32) >> Shift) & 255u32;
}

fn Messageˉword(Value: bytes, Length: u32, Position: u32, Paddedˉlength: u32) -> u32 {
    let First: u32 = Messageˉbyte(Value, Length, Position, Paddedˉlength) << 24u32;
    let Second: u32 = Messageˉbyte(Value, Length, Position + 1u32, Paddedˉlength) << 16u32;
    let Third: u32 = Messageˉbyte(Value, Length, Position + 2u32, Paddedˉlength) << 8u32;
    return First | Second | Third |
        Messageˉbyte(Value, Length, Position + 3u32, Paddedˉlength);
}

fn Smallˉsigmaˉzero(Value: u32) -> u32 {
    return Rotateˉright(Value, 7u32) ^ Rotateˉright(Value, 18u32) ^ (Value >> 3u32);
}

fn Smallˉsigmaˉone(Value: u32) -> u32 {
    return Rotateˉright(Value, 17u32) ^ Rotateˉright(Value, 19u32) ^ (Value >> 10u32);
}

fn Bigˉsigmaˉzero(Value: u32) -> u32 {
    return Rotateˉright(Value, 2u32) ^ Rotateˉright(Value, 13u32) ^
        Rotateˉright(Value, 22u32);
}

fn Bigˉsigmaˉone(Value: u32) -> u32 {
    return Rotateˉright(Value, 6u32) ^ Rotateˉright(Value, 11u32) ^
        Rotateˉright(Value, 25u32);
}

fn Choice(First: u32, Second: u32, Third: u32) -> u32 {
    return (First & Second) ^ (~First & Third);
}

fn Majority(First: u32, Second: u32, Third: u32) -> u32 {
    return (First & Second) ^ (First & Third) ^ (Second & Third);
}

fn Hexˉdigit(Value: u32) -> bytes {
    var Ascii: u32 = Value + 48u32;
    if Value > 9u32 { Ascii = Value + 87u32; }
    return Bytesˉslice(Bytesˉfromˉu32ˉlittle(Ascii), 0u32, 1u32);
}

fn Appendˉhexˉword(Output: bytes, Value: u32) -> bytes {
    var Result: bytes = Output;
    var Index: u32 = 0u32;
    while Index < 4u32 {
        let Shift: u32 = (3u32 - Index) * 8u32;
        let Byteˉvalue: u32 = (Value >> Shift) & 255u32;
        Result = Bytesˉconcat(Result, Hexˉdigit(Byteˉvalue >> 4u32));
        Result = Bytesˉconcat(Result, Hexˉdigit(Byteˉvalue & 15u32));
        Index = Index + 1u32;
    }
    return Result;
}

export fn Foundationˉsha256ˉhex(Value: bytes) -> text {
    let Length: u32 = Bytesˉlength(Value);
    let Paddedˉlength: u32 = (Length + 72u32) & 4294967232u32;
    var Hashˉzero: u32 = 1779033703u32;
    var Hashˉone: u32 = 3144134277u32;
    var Hashˉtwo: u32 = 1013904242u32;
    var Hashˉthree: u32 = 2773480762u32;
    var Hashˉfour: u32 = 1359893119u32;
    var Hashˉfive: u32 = 2600822924u32;
    var Hashˉsix: u32 = 528734635u32;
    var Hashˉseven: u32 = 1541459225u32;
    var Blockˉoffset: u32 = 0u32;

    while Blockˉoffset < Paddedˉlength {
        var Schedule: bytes = Bytesˉslice(Value, 0u32, 0u32);
        var Scheduleˉindex: u32 = 0u32;
        while Scheduleˉindex < 64u32 {
            var Word: u32 = 0u32;
            if Scheduleˉindex < 16u32 {
                Word = Messageˉword(
                    Value,
                    Length,
                    Blockˉoffset + Scheduleˉindex * 4u32,
                    Paddedˉlength
                );
            } else {
                Word = Addˉwrapping(
                    Addˉwrapping(
                        Bytesˉreadˉu32ˉlittle(
                            Schedule, (Scheduleˉindex - 16u32) * 4u32
                        ),
                        Smallˉsigmaˉzero(Bytesˉreadˉu32ˉlittle(
                            Schedule, (Scheduleˉindex - 15u32) * 4u32
                        ))
                    ),
                    Addˉwrapping(
                        Bytesˉreadˉu32ˉlittle(
                            Schedule, (Scheduleˉindex - 7u32) * 4u32
                        ),
                        Smallˉsigmaˉone(Bytesˉreadˉu32ˉlittle(
                            Schedule, (Scheduleˉindex - 2u32) * 4u32
                        ))
                    )
                );
            }
            Schedule = Bytesˉconcat(Schedule, Bytesˉfromˉu32ˉlittle(Word));
            Scheduleˉindex = Scheduleˉindex + 1u32;
        }

        var A: u32 = Hashˉzero;
        var B: u32 = Hashˉone;
        var C: u32 = Hashˉtwo;
        var D: u32 = Hashˉthree;
        var E: u32 = Hashˉfour;
        var F: u32 = Hashˉfive;
        var G: u32 = Hashˉsix;
        var H: u32 = Hashˉseven;
        var Round: u32 = 0u32;
        while Round < 64u32 {
            let Temporaryˉone: u32 = Addˉwrapping(
                Addˉwrapping(
                    Addˉwrapping(H, Bigˉsigmaˉone(E)),
                    Choice(E, F, G)
                ),
                Addˉwrapping(
                    Roundˉconstant(Round),
                    Bytesˉreadˉu32ˉlittle(Schedule, Round * 4u32)
                )
            );
            let Temporaryˉtwo: u32 = Addˉwrapping(
                Bigˉsigmaˉzero(A),
                Majority(A, B, C)
            );
            H = G;
            G = F;
            F = E;
            E = Addˉwrapping(D, Temporaryˉone);
            D = C;
            C = B;
            B = A;
            A = Addˉwrapping(Temporaryˉone, Temporaryˉtwo);
            Round = Round + 1u32;
        }

        Hashˉzero = Addˉwrapping(Hashˉzero, A);
        Hashˉone = Addˉwrapping(Hashˉone, B);
        Hashˉtwo = Addˉwrapping(Hashˉtwo, C);
        Hashˉthree = Addˉwrapping(Hashˉthree, D);
        Hashˉfour = Addˉwrapping(Hashˉfour, E);
        Hashˉfive = Addˉwrapping(Hashˉfive, F);
        Hashˉsix = Addˉwrapping(Hashˉsix, G);
        Hashˉseven = Addˉwrapping(Hashˉseven, H);
        Blockˉoffset = Blockˉoffset + 64u32;
    }

    var Output: bytes = Bytesˉslice(Value, 0u32, 0u32);
    Output = Appendˉhexˉword(Output, Hashˉzero);
    Output = Appendˉhexˉword(Output, Hashˉone);
    Output = Appendˉhexˉword(Output, Hashˉtwo);
    Output = Appendˉhexˉword(Output, Hashˉthree);
    Output = Appendˉhexˉword(Output, Hashˉfour);
    Output = Appendˉhexˉword(Output, Hashˉfive);
    Output = Appendˉhexˉword(Output, Hashˉsix);
    Output = Appendˉhexˉword(Output, Hashˉseven);
    return Textˉfromˉutf8(Output);
}
