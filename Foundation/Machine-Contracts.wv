module Foundationˉmachineˉcontracts profile portable;

export fn Foundationˉalignmentˉisˉvalid(Value: u32) -> bool {
    if Value == 1u32 { return true; }
    if Value == 2u32 { return true; }
    if Value == 4u32 { return true; }
    if Value == 8u32 { return true; }
    if Value == 16u32 { return true; }
    if Value == 32u32 { return true; }
    if Value == 64u32 { return true; }
    if Value == 128u32 { return true; }
    if Value == 256u32 { return true; }
    if Value == 512u32 { return true; }
    if Value == 1024u32 { return true; }
    if Value == 2048u32 { return true; }
    return Value == 4096u32;
}

export fn Foundationˉmachineˉnameˉisˉvalid(Input: bytes) -> bool {
    let Length: u32 = Bytesˉlength(Input);
    if Length == 0u32 { return false; }
    if Length > 255u32 { return false; }
    var Index: u32 = 0u32;
    while Index < Length {
        let Character: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(Input, Index));
        var Allowed: bool = false;
        if Character >= 65u32 {
            if Character <= 90u32 { Allowed = true; }
        }
        if Character >= 97u32 {
            if Character <= 122u32 { Allowed = true; }
        }
        if Character == 95u32 { Allowed = true; }
        if Character == 46u32 { Allowed = true; }
        if Character == 36u32 { Allowed = true; }
        if Index > 0u32 {
            if Character >= 48u32 {
                if Character <= 57u32 { Allowed = true; }
            }
        }
        if !Allowed { return false; }
        Index = Index + 1u32;
    }
    return true;
}
