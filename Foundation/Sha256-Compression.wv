module Foundationˉsha256ˉcompression profile portable;

export record Foundationˉsha256ˉhash {
    Valid: bool;
    Zero: u32;
    One: u32;
    Two: u32;
    Three: u32;
    Four: u32;
    Five: u32;
    Six: u32;
    Seven: u32;
}

export fn Foundationˉsha256ˉinitial() -> Foundationˉsha256ˉhash {
    return Foundationˉsha256ˉhash(
        true,
        1779033703u32,
        3144134277u32,
        1013904242u32,
        2773480762u32,
        1359893119u32,
        2600822924u32,
        528734635u32,
        1541459225u32
    );
}

fn Addˉwrap(Left: u32, Right: u32) -> u32 {
    let Low: u32 = (Left & 65535u32) + (Right & 65535u32);
    let High: u32 = (Left >> 16u32) + (Right >> 16u32) + (Low >> 16u32);
    return ((High & 65535u32) << 16u32) | (Low & 65535u32);
}

fn Addˉfour(Zero: u32, One: u32, Two: u32, Three: u32) -> u32 {
    return Addˉwrap(Addˉwrap(Addˉwrap(Zero, One), Two), Three);
}

fn Addˉfive(
    Zero: u32,
    One: u32,
    Two: u32,
    Three: u32,
    Four: u32
) -> u32 {
    return Addˉwrap(Addˉfour(Zero, One, Two, Three), Four);
}

fn Rotateˉright(Value: u32, Count: u32) -> u32 {
    return (Value >> Count) | (Value << (32u32 - Count));
}

fn Readˉbigˉu32(Value: bytes, Offset: u32) -> u32 {
    return
        (U32ˉfromˉu8(Bytesˉreadˉu8(Value, Offset)) << 24u32) |
        (U32ˉfromˉu8(Bytesˉreadˉu8(Value, Offset + 1u32)) << 16u32) |
        (U32ˉfromˉu8(Bytesˉreadˉu8(Value, Offset + 2u32)) << 8u32) |
        U32ˉfromˉu8(Bytesˉreadˉu8(Value, Offset + 3u32));
}

fn Roundˉconstant(Round: u32) -> u32 {
    if Round == 0u32 { return 1116352408u32; }
    if Round == 1u32 { return 1899447441u32; }
    if Round == 2u32 { return 3049323471u32; }
    if Round == 3u32 { return 3921009573u32; }
    if Round == 4u32 { return 961987163u32; }
    if Round == 5u32 { return 1508970993u32; }
    if Round == 6u32 { return 2453635748u32; }
    if Round == 7u32 { return 2870763221u32; }
    if Round == 8u32 { return 3624381080u32; }
    if Round == 9u32 { return 310598401u32; }
    if Round == 10u32 { return 607225278u32; }
    if Round == 11u32 { return 1426881987u32; }
    if Round == 12u32 { return 1925078388u32; }
    if Round == 13u32 { return 2162078206u32; }
    if Round == 14u32 { return 2614888103u32; }
    if Round == 15u32 { return 3248222580u32; }
    if Round == 16u32 { return 3835390401u32; }
    if Round == 17u32 { return 4022224774u32; }
    if Round == 18u32 { return 264347078u32; }
    if Round == 19u32 { return 604807628u32; }
    if Round == 20u32 { return 770255983u32; }
    if Round == 21u32 { return 1249150122u32; }
    if Round == 22u32 { return 1555081692u32; }
    if Round == 23u32 { return 1996064986u32; }
    if Round == 24u32 { return 2554220882u32; }
    if Round == 25u32 { return 2821834349u32; }
    if Round == 26u32 { return 2952996808u32; }
    if Round == 27u32 { return 3210313671u32; }
    if Round == 28u32 { return 3336571891u32; }
    if Round == 29u32 { return 3584528711u32; }
    if Round == 30u32 { return 113926993u32; }
    if Round == 31u32 { return 338241895u32; }
    if Round == 32u32 { return 666307205u32; }
    if Round == 33u32 { return 773529912u32; }
    if Round == 34u32 { return 1294757372u32; }
    if Round == 35u32 { return 1396182291u32; }
    if Round == 36u32 { return 1695183700u32; }
    if Round == 37u32 { return 1986661051u32; }
    if Round == 38u32 { return 2177026350u32; }
    if Round == 39u32 { return 2456956037u32; }
    if Round == 40u32 { return 2730485921u32; }
    if Round == 41u32 { return 2820302411u32; }
    if Round == 42u32 { return 3259730800u32; }
    if Round == 43u32 { return 3345764771u32; }
    if Round == 44u32 { return 3516065817u32; }
    if Round == 45u32 { return 3600352804u32; }
    if Round == 46u32 { return 4094571909u32; }
    if Round == 47u32 { return 275423344u32; }
    if Round == 48u32 { return 430227734u32; }
    if Round == 49u32 { return 506948616u32; }
    if Round == 50u32 { return 659060556u32; }
    if Round == 51u32 { return 883997877u32; }
    if Round == 52u32 { return 958139571u32; }
    if Round == 53u32 { return 1322822218u32; }
    if Round == 54u32 { return 1537002063u32; }
    if Round == 55u32 { return 1747873779u32; }
    if Round == 56u32 { return 1955562222u32; }
    if Round == 57u32 { return 2024104815u32; }
    if Round == 58u32 { return 2227730452u32; }
    if Round == 59u32 { return 2361852424u32; }
    if Round == 60u32 { return 2428436474u32; }
    if Round == 61u32 { return 2756734187u32; }
    if Round == 62u32 { return 3204031479u32; }
    return 3329325298u32;
}

export fn Foundationˉsha256ˉcompress(
    Hash: Foundationˉsha256ˉhash,
    Value: bytes,
    Offset: u32
) -> Foundationˉsha256ˉhash {
    let Length: u32 = Bytesˉlength(Value);
    if !Hash.Valid || Offset > Length || 64u32 > Length - Offset {
        return Foundationˉsha256ˉhash(
            false, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32
        );
    }
    var Schedule: bytes = Bytesˉslice(Value, 0u32, 0u32);
    var Scheduleˉindex: u32 = 0u32;
    while Scheduleˉindex < 16u32 {
        Schedule = Bytesˉconcat(
            Schedule,
            Bytesˉfromˉu32ˉlittle(
                Readˉbigˉu32(Value, Offset + Scheduleˉindex * 4u32)
            )
        );
        Scheduleˉindex = Scheduleˉindex + 1u32;
    }
    var A: u32 = Hash.Zero;
    var B: u32 = Hash.One;
    var C: u32 = Hash.Two;
    var D: u32 = Hash.Three;
    var E: u32 = Hash.Four;
    var F: u32 = Hash.Five;
    var G: u32 = Hash.Six;
    var H: u32 = Hash.Seven;
    var Round: u32 = 0u32;
    while Round < 64u32 {
        if Round >= 16u32 {
            let Minusˉfifteen: u32 = Bytesˉreadˉu32ˉlittle(
                Schedule, (Round - 15u32) * 4u32
            );
            let Minusˉtwo: u32 = Bytesˉreadˉu32ˉlittle(
                Schedule, (Round - 2u32) * 4u32
            );
            let Smallˉzero: u32 = Rotateˉright(Minusˉfifteen, 7u32) ^
                Rotateˉright(Minusˉfifteen, 18u32) ^
                (Minusˉfifteen >> 3u32);
            let Smallˉone: u32 = Rotateˉright(Minusˉtwo, 17u32) ^
                Rotateˉright(Minusˉtwo, 19u32) ^
                (Minusˉtwo >> 10u32);
            Schedule = Bytesˉconcat(
                Schedule,
                Bytesˉfromˉu32ˉlittle(Addˉfour(
                    Bytesˉreadˉu32ˉlittle(
                        Schedule, (Round - 16u32) * 4u32
                    ),
                    Smallˉzero,
                    Bytesˉreadˉu32ˉlittle(
                        Schedule, (Round - 7u32) * 4u32
                    ),
                    Smallˉone
                ))
            );
        }
        let Bigˉone: u32 = Rotateˉright(E, 6u32) ^
            Rotateˉright(E, 11u32) ^ Rotateˉright(E, 25u32);
        let Choice: u32 = (E & F) ^ (~E & G);
        let Temporaryˉone: u32 = Addˉfive(
            H,
            Bigˉone,
            Choice,
            Roundˉconstant(Round),
            Bytesˉreadˉu32ˉlittle(Schedule, Round * 4u32)
        );
        let Bigˉzero: u32 = Rotateˉright(A, 2u32) ^
            Rotateˉright(A, 13u32) ^ Rotateˉright(A, 22u32);
        let Majority: u32 = (A & B) ^ (A & C) ^ (B & C);
        let Temporaryˉtwo: u32 = Addˉwrap(Bigˉzero, Majority);
        H = G;
        G = F;
        F = E;
        E = Addˉwrap(D, Temporaryˉone);
        D = C;
        C = B;
        B = A;
        A = Addˉwrap(Temporaryˉone, Temporaryˉtwo);
        Round = Round + 1u32;
    }
    return Foundationˉsha256ˉhash(
        true,
        Addˉwrap(Hash.Zero, A),
        Addˉwrap(Hash.One, B),
        Addˉwrap(Hash.Two, C),
        Addˉwrap(Hash.Three, D),
        Addˉwrap(Hash.Four, E),
        Addˉwrap(Hash.Five, F),
        Addˉwrap(Hash.Six, G),
        Addˉwrap(Hash.Seven, H)
    );
}
