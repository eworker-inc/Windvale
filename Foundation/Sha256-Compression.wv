module Foundationˉsha256ˉcompression profile portable;

export record Foundationˉsha256ˉhash {
    Valid: bool;
    Zero: u32;
    One: u32;
    Two: u32;
    Three: u32;
    Four: u32;
    Five: u32;
    Six: u32;
    Seven: u32;
}

record Workingˉhash {
    A: u32;
    B: u32;
    C: u32;
    D: u32;
    E: u32;
    F: u32;
    G: u32;
    H: u32;
}

export fn Foundationˉsha256ˉinitial() -> Foundationˉsha256ˉhash {
    return Foundationˉsha256ˉhash(
        true,
        1779033703u32, 3144134277u32, 1013904242u32, 2773480762u32,
        1359893119u32, 2600822924u32, 528734635u32, 1541459225u32
    );
}

fn Addˉwrap(Left: u32, Right: u32) -> u32 {
    let Low: u32 = (Left & 65535u32) + (Right & 65535u32);
    let High: u32 = (Left >> 16u32) + (Right >> 16u32) + (Low >> 16u32);
    return ((High & 65535u32) << 16u32) | (Low & 65535u32);
}

fn Addˉfour(Zero: u32, One: u32, Two: u32, Three: u32) -> u32 {
    return Addˉwrap(Addˉwrap(Addˉwrap(Zero, One), Two), Three);
}

fn Addˉfive(
    Zero: u32, One: u32, Two: u32, Three: u32, Four: u32
) -> u32 {
    return Addˉwrap(Addˉfour(Zero, One, Two, Three), Four);
}

fn Rotateˉright(Value: u32, Count: u32) -> u32 {
    return (Value >> Count) | (Value << (32u32 - Count));
}

fn Readˉbigˉu32(Value: bytes, Offset: u32) -> u32 {
    return
        (U32ˉfromˉu8(Bytesˉreadˉu8(Value, Offset)) << 24u32) |
        (U32ˉfromˉu8(Bytesˉreadˉu8(Value, Offset + 1u32)) << 16u32) |
        (U32ˉfromˉu8(Bytesˉreadˉu8(Value, Offset + 2u32)) << 8u32) |
        U32ˉfromˉu8(Bytesˉreadˉu8(Value, Offset + 3u32));
}

fn Expand(
    Minusˉsixteen: u32, Minusˉfifteen: u32,
    Minusˉseven: u32, Minusˉtwo: u32
) -> u32 {
    let Smallˉzero: u32 = Rotateˉright(Minusˉfifteen, 7u32) ^
        Rotateˉright(Minusˉfifteen, 18u32) ^ (Minusˉfifteen >> 3u32);
    let Smallˉone: u32 = Rotateˉright(Minusˉtwo, 17u32) ^
        Rotateˉright(Minusˉtwo, 19u32) ^ (Minusˉtwo >> 10u32);
    return Addˉfour(Minusˉsixteen, Smallˉzero, Minusˉseven, Smallˉone);
}

fn Compressˉround(
    State: Workingˉhash, Constant: u32, Word: u32
) -> Workingˉhash {
    let Bigˉone: u32 = Rotateˉright(State.E, 6u32) ^
        Rotateˉright(State.E, 11u32) ^ Rotateˉright(State.E, 25u32);
    let Choice: u32 = (State.E & State.F) ^ (~State.E & State.G);
    let Temporaryˉone: u32 = Addˉfive(
        State.H, Bigˉone, Choice, Constant, Word
    );
    let Bigˉzero: u32 = Rotateˉright(State.A, 2u32) ^
        Rotateˉright(State.A, 13u32) ^ Rotateˉright(State.A, 22u32);
    let Majority: u32 =
        (State.A & State.B) ^ (State.A & State.C) ^ (State.B & State.C);
    let Temporaryˉtwo: u32 = Addˉwrap(Bigˉzero, Majority);
    return Workingˉhash(
        Addˉwrap(Temporaryˉone, Temporaryˉtwo),
        State.A, State.B, State.C,
        Addˉwrap(State.D, Temporaryˉone),
        State.E, State.F, State.G
    );
}

