fn Compressˉblock(
    Hash: Foundationˉsha256ˉhash,
    Value: bytes,
    Offset: u32
) -> Foundationˉsha256ˉhash {
    let Wordˉzero: u32 = Readˉbigˉu32(Value, Offset + 0u32);
    let Wordˉone: u32 = Readˉbigˉu32(Value, Offset + 4u32);
    let Wordˉtwo: u32 = Readˉbigˉu32(Value, Offset + 8u32);
    let Wordˉthree: u32 = Readˉbigˉu32(Value, Offset + 12u32);
    let Wordˉfour: u32 = Readˉbigˉu32(Value, Offset + 16u32);
    let Wordˉfive: u32 = Readˉbigˉu32(Value, Offset + 20u32);
    let Wordˉsix: u32 = Readˉbigˉu32(Value, Offset + 24u32);
    let Wordˉseven: u32 = Readˉbigˉu32(Value, Offset + 28u32);
    let Wordˉeight: u32 = Readˉbigˉu32(Value, Offset + 32u32);
    let Wordˉnine: u32 = Readˉbigˉu32(Value, Offset + 36u32);
    let Wordˉten: u32 = Readˉbigˉu32(Value, Offset + 40u32);
    let Wordˉeleven: u32 = Readˉbigˉu32(Value, Offset + 44u32);
    let Wordˉtwelve: u32 = Readˉbigˉu32(Value, Offset + 48u32);
    let Wordˉthirteen: u32 = Readˉbigˉu32(Value, Offset + 52u32);
    let Wordˉfourteen: u32 = Readˉbigˉu32(Value, Offset + 56u32);
    let Wordˉfifteen: u32 = Readˉbigˉu32(Value, Offset + 60u32);
    let Wordˉsixteen: u32 = Expand(Wordˉzero, Wordˉone, Wordˉnine, Wordˉfourteen);
    let Wordˉseventeen: u32 = Expand(Wordˉone, Wordˉtwo, Wordˉten, Wordˉfifteen);
    let Wordˉeighteen: u32 = Expand(Wordˉtwo, Wordˉthree, Wordˉeleven, Wordˉsixteen);
    let Wordˉnineteen: u32 = Expand(Wordˉthree, Wordˉfour, Wordˉtwelve, Wordˉseventeen);
    let Wordˉtwenty: u32 = Expand(Wordˉfour, Wordˉfive, Wordˉthirteen, Wordˉeighteen);
    let Wordˉtwentyˉone: u32 = Expand(Wordˉfive, Wordˉsix, Wordˉfourteen, Wordˉnineteen);
    let Wordˉtwentyˉtwo: u32 = Expand(Wordˉsix, Wordˉseven, Wordˉfifteen, Wordˉtwenty);
    let Wordˉtwentyˉthree: u32 = Expand(Wordˉseven, Wordˉeight, Wordˉsixteen, Wordˉtwentyˉone);
    let Wordˉtwentyˉfour: u32 = Expand(Wordˉeight, Wordˉnine, Wordˉseventeen, Wordˉtwentyˉtwo);
    let Wordˉtwentyˉfive: u32 = Expand(Wordˉnine, Wordˉten, Wordˉeighteen, Wordˉtwentyˉthree);
    let Wordˉtwentyˉsix: u32 = Expand(Wordˉten, Wordˉeleven, Wordˉnineteen, Wordˉtwentyˉfour);
    let Wordˉtwentyˉseven: u32 = Expand(Wordˉeleven, Wordˉtwelve, Wordˉtwenty, Wordˉtwentyˉfive);
    let Wordˉtwentyˉeight: u32 = Expand(Wordˉtwelve, Wordˉthirteen, Wordˉtwentyˉone, Wordˉtwentyˉsix);
    let Wordˉtwentyˉnine: u32 = Expand(Wordˉthirteen, Wordˉfourteen, Wordˉtwentyˉtwo, Wordˉtwentyˉseven);
    let Wordˉthirty: u32 = Expand(Wordˉfourteen, Wordˉfifteen, Wordˉtwentyˉthree, Wordˉtwentyˉeight);
    let Wordˉthirtyˉone: u32 = Expand(Wordˉfifteen, Wordˉsixteen, Wordˉtwentyˉfour, Wordˉtwentyˉnine);
    let Wordˉthirtyˉtwo: u32 = Expand(Wordˉsixteen, Wordˉseventeen, Wordˉtwentyˉfive, Wordˉthirty);
    let Wordˉthirtyˉthree: u32 = Expand(Wordˉseventeen, Wordˉeighteen, Wordˉtwentyˉsix, Wordˉthirtyˉone);
    let Wordˉthirtyˉfour: u32 = Expand(Wordˉeighteen, Wordˉnineteen, Wordˉtwentyˉseven, Wordˉthirtyˉtwo);
    let Wordˉthirtyˉfive: u32 = Expand(Wordˉnineteen, Wordˉtwenty, Wordˉtwentyˉeight, Wordˉthirtyˉthree);
    let Wordˉthirtyˉsix: u32 = Expand(Wordˉtwenty, Wordˉtwentyˉone, Wordˉtwentyˉnine, Wordˉthirtyˉfour);
    let Wordˉthirtyˉseven: u32 = Expand(Wordˉtwentyˉone, Wordˉtwentyˉtwo, Wordˉthirty, Wordˉthirtyˉfive);
    let Wordˉthirtyˉeight: u32 = Expand(Wordˉtwentyˉtwo, Wordˉtwentyˉthree, Wordˉthirtyˉone, Wordˉthirtyˉsix);
    let Wordˉthirtyˉnine: u32 = Expand(Wordˉtwentyˉthree, Wordˉtwentyˉfour, Wordˉthirtyˉtwo, Wordˉthirtyˉseven);
    let Wordˉforty: u32 = Expand(Wordˉtwentyˉfour, Wordˉtwentyˉfive, Wordˉthirtyˉthree, Wordˉthirtyˉeight);
    let Wordˉfortyˉone: u32 = Expand(Wordˉtwentyˉfive, Wordˉtwentyˉsix, Wordˉthirtyˉfour, Wordˉthirtyˉnine);
    let Wordˉfortyˉtwo: u32 = Expand(Wordˉtwentyˉsix, Wordˉtwentyˉseven, Wordˉthirtyˉfive, Wordˉforty);
    let Wordˉfortyˉthree: u32 = Expand(Wordˉtwentyˉseven, Wordˉtwentyˉeight, Wordˉthirtyˉsix, Wordˉfortyˉone);
    let Wordˉfortyˉfour: u32 = Expand(Wordˉtwentyˉeight, Wordˉtwentyˉnine, Wordˉthirtyˉseven, Wordˉfortyˉtwo);
    let Wordˉfortyˉfive: u32 = Expand(Wordˉtwentyˉnine, Wordˉthirty, Wordˉthirtyˉeight, Wordˉfortyˉthree);
    let Wordˉfortyˉsix: u32 = Expand(Wordˉthirty, Wordˉthirtyˉone, Wordˉthirtyˉnine, Wordˉfortyˉfour);
    let Wordˉfortyˉseven: u32 = Expand(Wordˉthirtyˉone, Wordˉthirtyˉtwo, Wordˉforty, Wordˉfortyˉfive);
    let Wordˉfortyˉeight: u32 = Expand(Wordˉthirtyˉtwo, Wordˉthirtyˉthree, Wordˉfortyˉone, Wordˉfortyˉsix);
    let Wordˉfortyˉnine: u32 = Expand(Wordˉthirtyˉthree, Wordˉthirtyˉfour, Wordˉfortyˉtwo, Wordˉfortyˉseven);
    let Wordˉfifty: u32 = Expand(Wordˉthirtyˉfour, Wordˉthirtyˉfive, Wordˉfortyˉthree, Wordˉfortyˉeight);
    let Wordˉfiftyˉone: u32 = Expand(Wordˉthirtyˉfive, Wordˉthirtyˉsix, Wordˉfortyˉfour, Wordˉfortyˉnine);
    let Wordˉfiftyˉtwo: u32 = Expand(Wordˉthirtyˉsix, Wordˉthirtyˉseven, Wordˉfortyˉfive, Wordˉfifty);
    let Wordˉfiftyˉthree: u32 = Expand(Wordˉthirtyˉseven, Wordˉthirtyˉeight, Wordˉfortyˉsix, Wordˉfiftyˉone);
    let Wordˉfiftyˉfour: u32 = Expand(Wordˉthirtyˉeight, Wordˉthirtyˉnine, Wordˉfortyˉseven, Wordˉfiftyˉtwo);
    let Wordˉfiftyˉfive: u32 = Expand(Wordˉthirtyˉnine, Wordˉforty, Wordˉfortyˉeight, Wordˉfiftyˉthree);
    let Wordˉfiftyˉsix: u32 = Expand(Wordˉforty, Wordˉfortyˉone, Wordˉfortyˉnine, Wordˉfiftyˉfour);
    let Wordˉfiftyˉseven: u32 = Expand(Wordˉfortyˉone, Wordˉfortyˉtwo, Wordˉfifty, Wordˉfiftyˉfive);
    let Wordˉfiftyˉeight: u32 = Expand(Wordˉfortyˉtwo, Wordˉfortyˉthree, Wordˉfiftyˉone, Wordˉfiftyˉsix);
    let Wordˉfiftyˉnine: u32 = Expand(Wordˉfortyˉthree, Wordˉfortyˉfour, Wordˉfiftyˉtwo, Wordˉfiftyˉseven);
    let Wordˉsixty: u32 = Expand(Wordˉfortyˉfour, Wordˉfortyˉfive, Wordˉfiftyˉthree, Wordˉfiftyˉeight);
    let Wordˉsixtyˉone: u32 = Expand(Wordˉfortyˉfive, Wordˉfortyˉsix, Wordˉfiftyˉfour, Wordˉfiftyˉnine);
    let Wordˉsixtyˉtwo: u32 = Expand(Wordˉfortyˉsix, Wordˉfortyˉseven, Wordˉfiftyˉfive, Wordˉsixty);
    let Wordˉsixtyˉthree: u32 = Expand(Wordˉfortyˉseven, Wordˉfortyˉeight, Wordˉfiftyˉsix, Wordˉsixtyˉone);
    var Working: Workingˉhash = Workingˉhash(
        Hash.Zero, Hash.One, Hash.Two, Hash.Three,
        Hash.Four, Hash.Five, Hash.Six, Hash.Seven
    );
    Working = Compressˉroundsˉzeroˉthroughˉfifteen(
        Working,
        Wordˉzero, Wordˉone, Wordˉtwo, Wordˉthree,
        Wordˉfour, Wordˉfive, Wordˉsix, Wordˉseven,
        Wordˉeight, Wordˉnine, Wordˉten, Wordˉeleven,
        Wordˉtwelve, Wordˉthirteen, Wordˉfourteen, Wordˉfifteen
    );
    Working = Compressˉroundsˉsixteenˉthroughˉthirtyˉone(
        Working,
        Wordˉsixteen, Wordˉseventeen, Wordˉeighteen, Wordˉnineteen,
        Wordˉtwenty, Wordˉtwentyˉone, Wordˉtwentyˉtwo, Wordˉtwentyˉthree,
        Wordˉtwentyˉfour, Wordˉtwentyˉfive, Wordˉtwentyˉsix, Wordˉtwentyˉseven,
        Wordˉtwentyˉeight, Wordˉtwentyˉnine, Wordˉthirty, Wordˉthirtyˉone
    );
    Working = Compressˉroundsˉthirtyˉtwoˉthroughˉfortyˉseven(
        Working,
        Wordˉthirtyˉtwo, Wordˉthirtyˉthree, Wordˉthirtyˉfour, Wordˉthirtyˉfive,
        Wordˉthirtyˉsix, Wordˉthirtyˉseven, Wordˉthirtyˉeight, Wordˉthirtyˉnine,
        Wordˉforty, Wordˉfortyˉone, Wordˉfortyˉtwo, Wordˉfortyˉthree,
        Wordˉfortyˉfour, Wordˉfortyˉfive, Wordˉfortyˉsix, Wordˉfortyˉseven
    );
    Working = Compressˉroundsˉfortyˉeightˉthroughˉsixtyˉthree(
        Working,
        Wordˉfortyˉeight, Wordˉfortyˉnine, Wordˉfifty, Wordˉfiftyˉone,
        Wordˉfiftyˉtwo, Wordˉfiftyˉthree, Wordˉfiftyˉfour, Wordˉfiftyˉfive,
        Wordˉfiftyˉsix, Wordˉfiftyˉseven, Wordˉfiftyˉeight, Wordˉfiftyˉnine,
        Wordˉsixty, Wordˉsixtyˉone, Wordˉsixtyˉtwo, Wordˉsixtyˉthree
    );
    return Foundationˉsha256ˉhash(
        true,
        Addˉwrap(Hash.Zero, Working.A),
        Addˉwrap(Hash.One, Working.B),
        Addˉwrap(Hash.Two, Working.C),
        Addˉwrap(Hash.Three, Working.D),
        Addˉwrap(Hash.Four, Working.E),
        Addˉwrap(Hash.Five, Working.F),
        Addˉwrap(Hash.Six, Working.G),
        Addˉwrap(Hash.Seven, Working.H)
    );
}

export fn Foundationˉsha256ˉcompressˉblocks(
    Hash: Foundationˉsha256ˉhash,
    Value: bytes,
    Offset: u32,
    Blockˉbytes: u32
) -> Foundationˉsha256ˉhash {
    let Length: u32 = Bytesˉlength(Value);
    if !Hash.Valid || Blockˉbytes == 0u32 || Blockˉbytes % 64u32 != 0u32 ||
        Offset > Length || Blockˉbytes > Length - Offset {
        return Foundationˉsha256ˉhash(
            false, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32
        );
    }
    var Result: Foundationˉsha256ˉhash = Hash;
    var Blockˉoffset: u32 = Offset;
    while Blockˉoffset < Offset + Blockˉbytes {
        Result = Compressˉblock(Result, Value, Blockˉoffset);
        Blockˉoffset = Blockˉoffset + 64u32;
    }
    return Result;
}

export fn Foundationˉsha256ˉcompress(
    Hash: Foundationˉsha256ˉhash,
    Value: bytes,
    Offset: u32
) -> Foundationˉsha256ˉhash {
    return Foundationˉsha256ˉcompressˉblocks(Hash, Value, Offset, 64u32);
}
