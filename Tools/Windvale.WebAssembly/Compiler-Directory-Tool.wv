module Compilerˉwebassemblyˉcompilerˉdirectoryˉtool profile hosted;

import Compilerˉwebassemblyˉfunctionˉdirectory as Directory;

capability console.write_line;
capability diagnostic.write_line;
capability file.read_bytes;
capability file.write_bytes;
capability process.argument;
capability process.argument_count;

fn Rangeˉisˉvalid(Total: u32, Offset: u32, Length: u32) -> bool {
    if Offset > Total { return false; }
    return Length <= Total - Offset;
}

fn Failure(Message: text) -> i32 {
    diagnostic.write_line(Textˉconcat("directory status=Invalid ", Message));
    return 1;
}

export fn Main() -> i32 {
    if process.argument_count() != 2u32 {
        diagnostic.write_line("Usage: wvwasm-directory <input.wvb> <directory.bin>");
        return 64;
    }
    let Input: bytes = file.read_bytes(process.argument(0u32));
    let Total: u32 = Bytesˉlength(Input);
    if Total < 12u32 { return Failure("envelope"); }

    var Envelope: u32 = 12u32;
    var Sectionˉkind: u32 = 1u32;
    var Functionsˉoffset: u32 = 0u32;
    var Functionsˉlength: u32 = 0u32;
    var Codeˉoffset: u32 = 0u32;
    var Codeˉlength: u32 = 0u32;
    var Typesˉoffset: u32 = 0u32;
    var Typesˉlength: u32 = 0u32;
    while Sectionˉkind <= 7u32 {
        if !Rangeˉisˉvalid(Total, Envelope, 8u32) {
            return Failure("section-envelope");
        }
        if U32ˉfromˉu8(Bytesˉreadˉu8(Input, Envelope)) != Sectionˉkind {
            return Failure("section-order");
        }
        let Payloadˉlength: u32 = Bytesˉreadˉu32ˉlittle(Input, Envelope + 4u32);
        let Payloadˉoffset: u32 = Envelope + 8u32;
        if !Rangeˉisˉvalid(Total, Payloadˉoffset, Payloadˉlength) {
            return Failure("section-payload");
        }
        if Sectionˉkind == 4u32 {
            Functionsˉoffset = Payloadˉoffset;
            Functionsˉlength = Payloadˉlength;
        }
        if Sectionˉkind == 5u32 {
            Codeˉoffset = Payloadˉoffset;
            Codeˉlength = Payloadˉlength;
        }
        if Sectionˉkind == 7u32 {
            Typesˉoffset = Payloadˉoffset;
            Typesˉlength = Payloadˉlength;
        }
        Envelope = Payloadˉoffset + Payloadˉlength;
        Sectionˉkind = Sectionˉkind + 1u32;
    }
    if Envelope != Total { return Failure("trailing-bytes"); }

    let Functionˉdirectory:
        Directory.Compilerˉwebassemblyˉfunctionˉdirectoryˉsummary =
        Directory.Compilerˉwebassemblyˉfunctionˉdirectoryˉbuild(
            Input,
            Functionsˉoffset,
            Functionsˉlength,
            Codeˉlength,
            Typesˉoffset,
            Typesˉlength
        );
    if !Functionˉdirectory.Valid { return Failure("function-inventory"); }
    let Calls: Directory.Compilerˉwebassemblyˉcallˉinventoryˉsummary =
        Directory.Compilerˉwebassemblyˉcallˉinventoryˉvalidate(
            Input,
            Codeˉoffset,
            Codeˉlength,
            Functionˉdirectory
        );
    if !Calls.Valid { return Failure("call-inventory"); }

    file.write_bytes(process.argument(1u32), Functionˉdirectory.Entries);
    var Report: text = "directory status=Valid functions=";
    Report = Textˉconcat(Report, U32ˉformat(Functionˉdirectory.Count));
    Report = Textˉconcat(Report, " entry-bytes=");
    Report = Textˉconcat(
        Report,
        U32ˉformat(Bytesˉlength(Functionˉdirectory.Entries))
    );
    Report = Textˉconcat(Report, " instructions=");
    Report = Textˉconcat(Report, U32ˉformat(Calls.Instructionˉcount));
    Report = Textˉconcat(Report, " calls=");
    console.write_line(Textˉconcat(Report, U32ˉformat(Calls.Callˉcount)));
    return 0;
}
