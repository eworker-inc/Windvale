    Input: bytes
) -> Control.Compilerˉwebassemblyˉcontrolˉflowˉsummary {
    return Control.Compilerˉwebassemblyˉcontrolˉflowˉsummary(
        false,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        0u32,
        Empty(Input),
        Empty(Input),
        Empty(Input),
        0u32,
        0u32,
        0u32
    );
}

export fn Compilerˉwebassemblyˉpackedˉcontrolˉflowˉbuild(
    Input: bytes,
    Codeˉoffset: u32,
    Codeˉlength: u32,
    Functionˉdirectory: Directory.Compilerˉwebassemblyˉfunctionˉdirectoryˉsummary,
    Graph: Executable.Compilerˉwebassemblyˉexecutableˉgraphˉsummary
) -> bytes {
    let Summary: Control.Compilerˉwebassemblyˉcontrolˉflowˉsummary =
        Control.Compilerˉwebassemblyˉcontrolˉflowˉbuild(
            Input,
            Codeˉoffset,
            Codeˉlength,
            Functionˉdirectory,
            Graph
        );
    if !Summary.Valid { return Empty(Input); }
    var Result: bytes = Appendˉu32(Empty(Input), 7u32);
    Result = Appendˉu32(Result, Summary.Reachableˉfunctionˉcount);
    Result = Appendˉu32(Result, Summary.Instructionˉcount);
    Result = Appendˉu32(Result, Summary.Blockˉcount);
    Result = Appendˉu32(Result, Summary.Jumpˉcount);
    Result = Appendˉu32(Result, Summary.Branchˉcount);
    Result = Appendˉu32(Result, Summary.Returnˉcount);
    Result = Appendˉu32(Result, Bytesˉlength(Summary.Functionˉentries));
    Result = Appendˉu32(Result, Bytesˉlength(Summary.Blockˉentries));
    Result = Appendˉu32(Result, Bytesˉlength(Summary.Opcodeˉset));
    Result = Appendˉu32(Result, Summary.Failureˉfunction);
    Result = Appendˉu32(Result, Summary.Failureˉoffset);
    Result = Appendˉu32(Result, Summary.Failureˉopcode);
    Result = Append(Result, Summary.Functionˉentries);
    Result = Append(Result, Summary.Blockˉentries);
    return Append(Result, Summary.Opcodeˉset);
}

export fn Compilerˉwebassemblyˉpackedˉcontrolˉflowˉread(
    Input: bytes
) -> Control.Compilerˉwebassemblyˉcontrolˉflowˉsummary {
    let Total: u32 = Bytesˉlength(Input);
    if Total < 52u32 || Bytesˉreadˉu32ˉlittle(Input, 0u32) != 7u32 {
        return Invalidˉcontrol(Input);
    }
    let Functionsˉlength: u32 = Bytesˉreadˉu32ˉlittle(Input, 28u32);
    let Blocksˉlength: u32 = Bytesˉreadˉu32ˉlittle(Input, 32u32);
    let Opcodesˉlength: u32 = Bytesˉreadˉu32ˉlittle(Input, 36u32);
    if !Exactˉthree(
        Total,
        52u32,
        Functionsˉlength,
        Blocksˉlength,
        Opcodesˉlength
    ) {
        return Invalidˉcontrol(Input);
    }
    let Blocksˉoffset: u32 = 52u32 + Functionsˉlength;
    let Opcodesˉoffset: u32 = Blocksˉoffset + Blocksˉlength;
    return Control.Compilerˉwebassemblyˉcontrolˉflowˉsummary(
        true,
        Bytesˉreadˉu32ˉlittle(Input, 4u32),
        Bytesˉreadˉu32ˉlittle(Input, 8u32),
        Bytesˉreadˉu32ˉlittle(Input, 12u32),
        Bytesˉreadˉu32ˉlittle(Input, 16u32),
        Bytesˉreadˉu32ˉlittle(Input, 20u32),
        Bytesˉreadˉu32ˉlittle(Input, 24u32),
        Bytesˉslice(Input, 52u32, Functionsˉlength),
        Bytesˉslice(Input, Blocksˉoffset, Blocksˉlength),
        Bytesˉslice(Input, Opcodesˉoffset, Opcodesˉlength),
        Bytesˉreadˉu32ˉlittle(Input, 40u32),
        Bytesˉreadˉu32ˉlittle(Input, 44u32),
        Bytesˉreadˉu32ˉlittle(Input, 48u32)
    );
}

fn Packedˉdispatcherˉemitˉmode(
    Input: bytes,
    Codeˉoffset: u32,
    Codeˉlength: u32,
    Functionˉdirectory: Directory.Compilerˉwebassemblyˉfunctionˉdirectoryˉsummary,
    Typeˉdirectory: Types.Compilerˉwebassemblyˉtypeˉdirectoryˉsummary,
    Graph: Executable.Compilerˉwebassemblyˉexecutableˉgraphˉsummary,
    Controlˉflow: Control.Compilerˉwebassemblyˉcontrolˉflowˉsummary,
    Enumˉsummary: Enums.Compilerˉwebassemblyˉenumˉsummary,
    Recordˉstorage: Records.Compilerˉwebassemblyˉrecordˉstorageˉsummary,
    Wideˉartifact: bool
) -> bytes {
    var Lowered: Dispatcher.Compilerˉwebassemblyˉscalarˉdispatcherˉsummary =
        Dispatcher.Compilerˉwebassemblyˉscalarˉdispatcherˉemit(
            Input,
            Codeˉoffset,
            Codeˉlength,
            Functionˉdirectory,
            Typeˉdirectory,
            Graph,
            Controlˉflow,
            Enumˉsummary,
            Recordˉstorage
        );
    if Wideˉartifact {
        Lowered =
            Dispatcher.Compilerˉwebassemblyˉscalarˉdispatcherˉemitˉwideˉartifact(
                Input,
                Codeˉoffset,
                Codeˉlength,
                Functionˉdirectory,
                Typeˉdirectory,
                Graph,
                Controlˉflow,
                Enumˉsummary,
                Recordˉstorage
            );
    }
    if !Lowered.Valid { return Empty(Input); }
    return Lowered.Webassembly;
}

export fn Compilerˉwebassemblyˉpackedˉdispatcherˉemit(
    Input: bytes,
    Codeˉoffset: u32,
    Codeˉlength: u32,
    Functionˉdirectory: Directory.Compilerˉwebassemblyˉfunctionˉdirectoryˉsummary,
    Typeˉdirectory: Types.Compilerˉwebassemblyˉtypeˉdirectoryˉsummary,
    Graph: Executable.Compilerˉwebassemblyˉexecutableˉgraphˉsummary,
    Controlˉflow: Control.Compilerˉwebassemblyˉcontrolˉflowˉsummary,
    Enumˉsummary: Enums.Compilerˉwebassemblyˉenumˉsummary,
    Recordˉstorage: Records.Compilerˉwebassemblyˉrecordˉstorageˉsummary
) -> bytes {
    return Packedˉdispatcherˉemitˉmode(
        Input,
        Codeˉoffset,
        Codeˉlength,
        Functionˉdirectory,
        Typeˉdirectory,
        Graph,
        Controlˉflow,
        Enumˉsummary,
        Recordˉstorage,
        false
    );
}

export fn Compilerˉwebassemblyˉpackedˉdispatcherˉemitˉwideˉartifact(
    Input: bytes,
    Codeˉoffset: u32,
    Codeˉlength: u32,
    Functionˉdirectory: Directory.Compilerˉwebassemblyˉfunctionˉdirectoryˉsummary,
    Typeˉdirectory: Types.Compilerˉwebassemblyˉtypeˉdirectoryˉsummary,
    Graph: Executable.Compilerˉwebassemblyˉexecutableˉgraphˉsummary,
    Controlˉflow: Control.Compilerˉwebassemblyˉcontrolˉflowˉsummary,
    Enumˉsummary: Enums.Compilerˉwebassemblyˉenumˉsummary,
    Recordˉstorage: Records.Compilerˉwebassemblyˉrecordˉstorageˉsummary
) -> bytes {
    return Packedˉdispatcherˉemitˉmode(
        Input,
        Codeˉoffset,
        Codeˉlength,
        Functionˉdirectory,
        Typeˉdirectory,
        Graph,
        Controlˉflow,
        Enumˉsummary,
        Recordˉstorage,
        true
    );
}

export fn Compilerˉwebassemblyˉpackedˉdispatcherˉemitˉsegmentedˉartifact(
    Input: bytes,
    Codeˉoffset: u32,
    Codeˉlength: u32,
    Functionˉdirectory: Directory.Compilerˉwebassemblyˉfunctionˉdirectoryˉsummary,
    Typeˉdirectory: Types.Compilerˉwebassemblyˉtypeˉdirectoryˉsummary,
    Graph: Executable.Compilerˉwebassemblyˉexecutableˉgraphˉsummary,
    Controlˉflow: Control.Compilerˉwebassemblyˉcontrolˉflowˉsummary,
    Enumˉsummary: Enums.Compilerˉwebassemblyˉenumˉsummary,
    Recordˉstorage: Records.Compilerˉwebassemblyˉrecordˉstorageˉsummary
) -> Compilerˉwebassemblyˉsegmentedˉartifact {
    let Lowered: Dispatcher.Compilerˉwebassemblyˉscalarˉdispatcherˉsummary =
        Dispatcher.Compilerˉwebassemblyˉscalarˉdispatcherˉemitˉsegmentedˉartifact(
            Input,
            Codeˉoffset,
            Codeˉlength,
            Functionˉdirectory,
            Typeˉdirectory,
            Graph,
            Controlˉflow,
            Enumˉsummary,
            Recordˉstorage
        );
    if !Lowered.Valid {
        return Invalidˉsegmented(Input);
    }
    let Totalˉlength: u32 =
        Bytesˉlength(Lowered.Webassembly) +
        Bytesˉlength(Lowered.Segment1) +
        Bytesˉlength(Lowered.Segment2) +
        Bytesˉlength(Lowered.Segment3) +
        Bytesˉlength(Lowered.Segment4) +
        Bytesˉlength(Lowered.Segment5) +
        Bytesˉlength(Lowered.Segment6) +
        Bytesˉlength(Lowered.Segment7) +
        Bytesˉlength(Lowered.Segment8) +
        Bytesˉlength(Lowered.Segment9) +
        Bytesˉlength(Lowered.Segment10) +
        Bytesˉlength(Lowered.Segment11) +
        Bytesˉlength(Lowered.Segment12) +
        Bytesˉlength(Lowered.Segment13) +
        Bytesˉlength(Lowered.Segment14) +
        Bytesˉlength(Lowered.Segment15) +
        Bytesˉlength(Lowered.Segment16) +
        Bytesˉlength(Lowered.Segment17) +
        Bytesˉlength(Lowered.Segment18) +
        Bytesˉlength(Lowered.Segment19) +
        Bytesˉlength(Lowered.Segment20) +
        Bytesˉlength(Lowered.Segment21) +
        Bytesˉlength(Lowered.Segment22) +
        Bytesˉlength(Lowered.Segment23) +
        Bytesˉlength(Lowered.Segment24) +
        Bytesˉlength(Lowered.Segment25) +
        Bytesˉlength(Lowered.Segment26) +
        Bytesˉlength(Lowered.Segment27) +
        Bytesˉlength(Lowered.Segment28) +
        Bytesˉlength(Lowered.Segment29) +
        Bytesˉlength(Lowered.Segment30) +
        Bytesˉlength(Lowered.Segment31) +
        Bytesˉlength(Lowered.Segment32) +
        Bytesˉlength(Lowered.Segment33);
    if Totalˉlength != Lowered.Totalˉlength {
        return Invalidˉsegmented(Input);
    }
    return Compilerˉwebassemblyˉsegmentedˉartifact(
        true,
        Totalˉlength,
        Lowered.Webassembly,
        Lowered.Segment1,
        Lowered.Segment2,
        Lowered.Segment3,
        Lowered.Segment4,
        Lowered.Segment5,
        Lowered.Segment6,
        Lowered.Segment7,
        Lowered.Segment8,
        Lowered.Segment9,
        Lowered.Segment10,
        Lowered.Segment11,
        Lowered.Segment12,
        Lowered.Segment13,
        Lowered.Segment14,
        Lowered.Segment15,
        Lowered.Segment16,
        Lowered.Segment17,
        Lowered.Segment18,
        Lowered.Segment19,
        Lowered.Segment20,
        Lowered.Segment21,
        Lowered.Segment22,
        Lowered.Segment23,
        Lowered.Segment24,
        Lowered.Segment25,
        Lowered.Segment26,
        Lowered.Segment27,
        Lowered.Segment28,
        Lowered.Segment29,
        Lowered.Segment30,
        Lowered.Segment31,
        Lowered.Segment32,
        Lowered.Segment33
    );
}
