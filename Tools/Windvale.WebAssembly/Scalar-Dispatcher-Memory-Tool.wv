module Compilerˉwebassemblyˉscalarˉdispatcherˉmemoryˉtool profile portable;

import Compilerˉwebassemblyˉfunctionˉdirectory as Directory;
import Compilerˉwebassemblyˉtypeˉdirectory as Types;
import Compilerˉwebassemblyˉtypedˉcalls as Typed;
import Compilerˉwebassemblyˉexecutableˉgraph as Executable;
import Compilerˉwebassemblyˉcontrolˉflow as Control;
import Compilerˉwebassemblyˉstaticˉdata as Staticˉdata;
import Compilerˉwebassemblyˉenumˉoperations as Enums;
import Compilerˉwebassemblyˉrecordˉstorage as Records;
import Compilerˉwebassemblyˉscalarˉdispatcherˉphaseˉadapter as Phases;

fn Empty(Input: bytes) -> bytes {
    return Bytesˉslice(Input, 0u32, 0u32);
}

fn Rangeˉisˉvalid(Total: u32, Offset: u32, Length: u32) -> bool {
    if Offset > Total { return false; }
    return Length <= Total - Offset;
}

fn Invalidˉartifact(
    Input: bytes
) -> Phases.Compilerˉwebassemblyˉsegmentedˉartifact {
    let Emptyˉsegment: bytes = Empty(Input);
    return Phases.Compilerˉwebassemblyˉsegmentedˉartifact(
        false,
        0u32,
        Emptyˉsegment,
        Emptyˉsegment,
        Emptyˉsegment,
        Emptyˉsegment,
        Emptyˉsegment,
        Emptyˉsegment,
        Emptyˉsegment,
        Emptyˉsegment,
        Emptyˉsegment,
        Emptyˉsegment,
        Emptyˉsegment,
        Emptyˉsegment,
        Emptyˉsegment,
        Emptyˉsegment,
        Emptyˉsegment,
        Emptyˉsegment,
        Emptyˉsegment,
        Emptyˉsegment,
        Emptyˉsegment,
        Emptyˉsegment,
        Emptyˉsegment,
        Emptyˉsegment,
        Emptyˉsegment,
        Emptyˉsegment,
        Emptyˉsegment,
        Emptyˉsegment,
        Emptyˉsegment,
        Emptyˉsegment,
        Emptyˉsegment,
        Emptyˉsegment,
        Emptyˉsegment,
        Emptyˉsegment,
        Emptyˉsegment,
        Emptyˉsegment
    );
}

fn Compile(
    Input: bytes
) -> Phases.Compilerˉwebassemblyˉsegmentedˉartifact {
    let Total: u32 = Bytesˉlength(Input);
    if Total < 12u32 { return Invalidˉartifact(Input); }
    var Envelope: u32 = 12u32;
    var Sectionˉkind: u32 = 1u32;
    var Functionsˉoffset: u32 = 0u32;
    var Functionsˉlength: u32 = 0u32;
    var Codeˉoffset: u32 = 0u32;
    var Codeˉlength: u32 = 0u32;
    var Typesˉoffset: u32 = 0u32;
    var Typesˉlength: u32 = 0u32;
    var Dataˉoffset: u32 = 0u32;
    var Dataˉlength: u32 = 0u32;
    while Sectionˉkind <= 7u32 {
        if !Rangeˉisˉvalid(Total, Envelope, 8u32) {
            return Invalidˉartifact(Input);
        }
        if U32ˉfromˉu8(Bytesˉreadˉu8(Input, Envelope)) != Sectionˉkind {
            return Invalidˉartifact(Input);
        }
        let Payloadˉlength: u32 = Bytesˉreadˉu32ˉlittle(
            Input,
            Envelope + 4u32
        );
        let Payloadˉoffset: u32 = Envelope + 8u32;
        if !Rangeˉisˉvalid(Total, Payloadˉoffset, Payloadˉlength) {
            return Invalidˉartifact(Input);
        }
        if Sectionˉkind == 4u32 {
            Functionsˉoffset = Payloadˉoffset;
            Functionsˉlength = Payloadˉlength;
        }
        if Sectionˉkind == 3u32 {
            Dataˉoffset = Payloadˉoffset;
            Dataˉlength = Payloadˉlength;
        }
        if Sectionˉkind == 5u32 {
            Codeˉoffset = Payloadˉoffset;
            Codeˉlength = Payloadˉlength;
        }
        if Sectionˉkind == 7u32 {
            Typesˉoffset = Payloadˉoffset;
            Typesˉlength = Payloadˉlength;
        }
        Envelope = Payloadˉoffset + Payloadˉlength;
        Sectionˉkind = Sectionˉkind + 1u32;
    }
    if Envelope != Total { return Invalidˉartifact(Input); }

    let Staticˉdataˉpacked: bytes =
        Phases.Compilerˉwebassemblyˉpackedˉstaticˉdataˉbuild(
            Input,
            Dataˉoffset,
            Dataˉlength
        );
    if Bytesˉlength(Staticˉdataˉpacked) == 0u32 {
        return Invalidˉartifact(Input);
    }
    let Staticˉdataˉsummary:
        Staticˉdata.Compilerˉwebassemblyˉstaticˉdataˉsummary =
        Phases.Compilerˉwebassemblyˉpackedˉstaticˉdataˉread(
            Staticˉdataˉpacked
        );
    if !Staticˉdataˉsummary.Valid { return Invalidˉartifact(Input); }

    let Functionˉdirectoryˉpacked: bytes =
        Phases.Compilerˉwebassemblyˉpackedˉfunctionˉdirectoryˉbuild(
            Input,
            Functionsˉoffset,
            Functionsˉlength,
            Codeˉlength,
            Typesˉoffset,
            Typesˉlength
        );
    if Bytesˉlength(Functionˉdirectoryˉpacked) == 0u32 {
        return Invalidˉartifact(Input);
    }
    let Functionˉdirectory:
        Directory.Compilerˉwebassemblyˉfunctionˉdirectoryˉsummary =
        Phases.Compilerˉwebassemblyˉpackedˉfunctionˉdirectoryˉread(
            Functionˉdirectoryˉpacked
        );
    if !Functionˉdirectory.Valid { return Invalidˉartifact(Input); }
    let Typeˉdirectoryˉpacked: bytes =
        Phases.Compilerˉwebassemblyˉpackedˉtypeˉdirectoryˉbuild(
            Input,
            Typesˉoffset,
            Typesˉlength
        );
    if Bytesˉlength(Typeˉdirectoryˉpacked) == 0u32 {
        return Invalidˉartifact(Input);
    }
    let Typeˉdirectory: Types.Compilerˉwebassemblyˉtypeˉdirectoryˉsummary =
        Phases.Compilerˉwebassemblyˉpackedˉtypeˉdirectoryˉread(
            Typeˉdirectoryˉpacked
        );
    if !Typeˉdirectory.Valid { return Invalidˉartifact(Input); }
    let Enumˉpacked: bytes =
        Phases.Compilerˉwebassemblyˉpackedˉenumˉbuild(
            Input,
            Typeˉdirectory,
            Staticˉdataˉsummary
        );
    if Bytesˉlength(Enumˉpacked) == 0u32 { return Invalidˉartifact(Input); }
    let Enumˉsummary: Enums.Compilerˉwebassemblyˉenumˉsummary =
        Phases.Compilerˉwebassemblyˉpackedˉenumˉread(Enumˉpacked);
    if !Enumˉsummary.Valid { return Invalidˉartifact(Input); }
    let Typedˉcalls: Typed.Compilerˉwebassemblyˉtypedˉcallˉsummary =
        Typed.Compilerˉwebassemblyˉtypedˉcallsˉvalidate(
            Input,
            Codeˉoffset,
            Codeˉlength,
            Functionˉdirectory,
            Typeˉdirectory
        );
    if !Typedˉcalls.Valid { return Invalidˉartifact(Input); }
    let Recordˉstorageˉpacked: bytes =
        Phases.Compilerˉwebassemblyˉpackedˉrecordˉstorageˉbuild(
            Input,
            Codeˉoffset,
            Codeˉlength,
            Functionˉdirectory,
            Typeˉdirectory
        );
    if Bytesˉlength(Recordˉstorageˉpacked) == 0u32 {
        return Invalidˉartifact(Input);
    }
    let Recordˉstorage:
        Records.Compilerˉwebassemblyˉrecordˉstorageˉsummary =
        Phases.Compilerˉwebassemblyˉpackedˉrecordˉstorageˉread(
            Recordˉstorageˉpacked
        );
    if !Recordˉstorage.Valid { return Invalidˉartifact(Input); }
    let Entry: Directory.Compilerˉwebassemblyˉfunctionˉlookupˉsummary =
        Directory.Compilerˉwebassemblyˉfunctionˉfind(
            Input,
            Functionˉdirectory,
            "Main"
        );
    if !Entry.Found { return Invalidˉartifact(Input); }
    let Graphˉpacked: bytes =
        Phases.Compilerˉwebassemblyˉpackedˉexecutableˉgraphˉbuild(
            Input,
            Codeˉoffset,
            Codeˉlength,
            Functionˉdirectory,
            Entry.Index
        );
    if Bytesˉlength(Graphˉpacked) == 0u32 {
        return Invalidˉartifact(Input);
    }
    let Graph: Executable.Compilerˉwebassemblyˉexecutableˉgraphˉsummary =
        Phases.Compilerˉwebassemblyˉpackedˉexecutableˉgraphˉread(
            Graphˉpacked
        );
    if !Graph.Valid { return Invalidˉartifact(Input); }
    let Controlˉflowˉpacked: bytes =
        Phases.Compilerˉwebassemblyˉpackedˉcontrolˉflowˉbuild(
            Input,
            Codeˉoffset,
            Codeˉlength,
            Functionˉdirectory,
            Graph
        );
    if Bytesˉlength(Controlˉflowˉpacked) == 0u32 {
        return Invalidˉartifact(Input);
    }
    let Controlˉflow: Control.Compilerˉwebassemblyˉcontrolˉflowˉsummary =
        Phases.Compilerˉwebassemblyˉpackedˉcontrolˉflowˉread(
            Controlˉflowˉpacked
        );
    if !Controlˉflow.Valid { return Invalidˉartifact(Input); }
    return Phases.Compilerˉwebassemblyˉpackedˉdispatcherˉemitˉsegmentedˉartifact(
        Input,
        Codeˉoffset,
        Codeˉlength,
        Functionˉdirectory,
        Typeˉdirectory,
        Graph,
        Controlˉflow,
        Enumˉsummary,
        Recordˉstorage
    );
}

fn Join(
    Input: bytes,
    Artifact: Phases.Compilerˉwebassemblyˉsegmentedˉartifact
) -> bytes {
    if !Artifact.Valid {
        return Empty(Input);
    }
    var Result: bytes = Empty(Input);
    var Segment: u32 = 0u32;
    while Segment < 34u32 {
        Result = Bytesˉconcat(
            Result,
            Phases.Compilerˉwebassemblyˉsegmentedˉartifactˉread(
                Artifact,
                Segment
            )
        );
        Segment = Segment + 1u32;
    }
    if Bytesˉlength(Result) != Artifact.Totalˉlength {
        return Empty(Input);
    }
    return Result;
}

export fn Main(Input: bytes) -> bytes {
    return Join(Input, Compile(Input));
}

export fn Segmentedˉartifact(
    Input: bytes
) -> Phases.Compilerˉwebassemblyˉsegmentedˉartifact {
    return Compile(Input);
}
