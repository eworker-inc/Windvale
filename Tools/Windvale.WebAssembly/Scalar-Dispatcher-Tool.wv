module Compilerˉwebassemblyˉscalarˉdispatcherˉtool profile hosted;

import Compilerˉwebassemblyˉscalarˉdispatcherˉmemoryˉtool as Memory;

capability console.write_line;
capability diagnostic.write_line;
capability file.read_bytes;
capability file.write_bytes;
capability process.argument;
capability process.argument_count;

export fn Main() -> i32 {
    if process.argument_count() != 2u32 {
        diagnostic.write_line(
            "Usage: wvwasm-dispatcher <input.wvb> <output.wasm>"
        );
        return 64;
    }
    let Result: bytes = Memory.Main(
        file.read_bytes(process.argument(0u32))
    );
    if Bytesˉlength(Result) == 0u32 {
        diagnostic.write_line("dispatcher status=Unsupported");
        return 1;
    }
    file.write_bytes(process.argument(1u32), Result);
    var Report: text = "dispatcher status=Valid module-bytes=";
    Report = Textˉconcat(Report, U32ˉformat(Bytesˉlength(Result)));
    console.write_line(Report);
    return 0;
}
