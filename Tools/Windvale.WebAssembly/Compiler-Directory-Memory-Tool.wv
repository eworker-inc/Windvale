module Compilerˉwebassemblyˉcompilerˉdirectoryˉmemoryˉtool profile portable;

import Compilerˉwebassemblyˉfunctionˉdirectory as Directory;
import Compilerˉwebassemblyˉtypeˉdirectory as Types;
import Compilerˉwebassemblyˉtypedˉcalls as Typed;
import Compilerˉwebassemblyˉexecutableˉgraph as Executable;

fn Rangeˉisˉvalid(Total: u32, Offset: u32, Length: u32) -> bool {
    if Offset > Total { return false; }
    return Length <= Total - Offset;
}

fn Failure(Message: text) -> bytes {
    return Textˉtoˉutf8(Textˉconcat("directory status=Invalid ", Message));
}

export fn Main(Input: bytes) -> bytes {
    let Total: u32 = Bytesˉlength(Input);
    if Total < 12u32 { return Failure("envelope"); }

    var Envelope: u32 = 12u32;
    var Sectionˉkind: u32 = 1u32;
    var Functionsˉoffset: u32 = 0u32;
    var Functionsˉlength: u32 = 0u32;
    var Codeˉoffset: u32 = 0u32;
    var Codeˉlength: u32 = 0u32;
    var Typesˉoffset: u32 = 0u32;
    var Typesˉlength: u32 = 0u32;
    while Sectionˉkind <= 7u32 {
        if !Rangeˉisˉvalid(Total, Envelope, 8u32) {
            return Failure("section-envelope");
        }
        if U32ˉfromˉu8(Bytesˉreadˉu8(Input, Envelope)) != Sectionˉkind {
            return Failure("section-order");
        }
        let Payloadˉlength: u32 = Bytesˉreadˉu32ˉlittle(
            Input,
            Envelope + 4u32
        );
        let Payloadˉoffset: u32 = Envelope + 8u32;
        if !Rangeˉisˉvalid(Total, Payloadˉoffset, Payloadˉlength) {
            return Failure("section-payload");
        }
        if Sectionˉkind == 4u32 {
            Functionsˉoffset = Payloadˉoffset;
            Functionsˉlength = Payloadˉlength;
        }
        if Sectionˉkind == 5u32 {
            Codeˉoffset = Payloadˉoffset;
            Codeˉlength = Payloadˉlength;
        }
        if Sectionˉkind == 7u32 {
            Typesˉoffset = Payloadˉoffset;
            Typesˉlength = Payloadˉlength;
        }
        Envelope = Payloadˉoffset + Payloadˉlength;
        Sectionˉkind = Sectionˉkind + 1u32;
    }
    if Envelope != Total { return Failure("trailing-bytes"); }

    let Functionˉdirectory:
        Directory.Compilerˉwebassemblyˉfunctionˉdirectoryˉsummary =
        Directory.Compilerˉwebassemblyˉfunctionˉdirectoryˉbuild(
            Input,
            Functionsˉoffset,
            Functionsˉlength,
            Codeˉlength,
            Typesˉoffset,
            Typesˉlength
        );
    if !Functionˉdirectory.Valid { return Failure("function-inventory"); }
    let Typeˉdirectory: Types.Compilerˉwebassemblyˉtypeˉdirectoryˉsummary =
        Types.Compilerˉwebassemblyˉtypeˉdirectoryˉbuild(
            Input,
            Typesˉoffset,
            Typesˉlength
        );
    if !Typeˉdirectory.Valid { return Failure("type-directory"); }
    let Calls: Directory.Compilerˉwebassemblyˉcallˉinventoryˉsummary =
        Directory.Compilerˉwebassemblyˉcallˉinventoryˉvalidate(
            Input,
            Codeˉoffset,
            Codeˉlength,
            Functionˉdirectory
        );
    if !Calls.Valid { return Failure("call-inventory"); }
    let Typedˉcalls: Typed.Compilerˉwebassemblyˉtypedˉcallˉsummary =
        Typed.Compilerˉwebassemblyˉtypedˉcallsˉvalidate(
            Input,
            Codeˉoffset,
            Codeˉlength,
            Functionˉdirectory,
            Typeˉdirectory
        );
    if !Typedˉcalls.Valid {
        var Diagnostic: text = "typed-calls function=";
        Diagnostic = Textˉconcat(
            Diagnostic,
            U32ˉformat(Typedˉcalls.Failureˉfunction)
        );
        Diagnostic = Textˉconcat(Diagnostic, " offset=");
        Diagnostic = Textˉconcat(
            Diagnostic,
            U32ˉformat(Typedˉcalls.Failureˉoffset)
        );
        Diagnostic = Textˉconcat(Diagnostic, " opcode=");
        return Failure(Textˉconcat(
            Diagnostic,
            U32ˉformat(Typedˉcalls.Failureˉopcode)
        ));
    }
    let Entry: Directory.Compilerˉwebassemblyˉfunctionˉlookupˉsummary =
        Directory.Compilerˉwebassemblyˉfunctionˉfind(
            Input,
            Functionˉdirectory,
            "Main"
        );
    if !Entry.Found { return Failure("entry-point"); }
    let Graph: Executable.Compilerˉwebassemblyˉexecutableˉgraphˉsummary =
        Executable.Compilerˉwebassemblyˉexecutableˉgraphˉbuild(
            Input,
            Codeˉoffset,
            Codeˉlength,
            Functionˉdirectory,
            Entry.Index
        );
    if !Graph.Valid { return Failure("executable-graph"); }

    var Report: text = "directory status=Valid functions=";
    Report = Textˉconcat(Report, U32ˉformat(Functionˉdirectory.Count));
    Report = Textˉconcat(Report, " entry-bytes=");
    Report = Textˉconcat(
        Report,
        U32ˉformat(Bytesˉlength(Functionˉdirectory.Entries))
    );
    Report = Textˉconcat(Report, " instructions=");
    Report = Textˉconcat(Report, U32ˉformat(Calls.Instructionˉcount));
    Report = Textˉconcat(Report, " calls=");
    Report = Textˉconcat(Report, U32ˉformat(Calls.Callˉcount));
    Report = Textˉconcat(Report, " types=");
    Report = Textˉconcat(Report, U32ˉformat(Typeˉdirectory.Count));
    Report = Textˉconcat(Report, " typed-calls=");
    Report = Textˉconcat(Report, U32ˉformat(Typedˉcalls.Callˉcount));
    Report = Textˉconcat(Report, " maximum-stack=");
    Report = Textˉconcat(
        Report,
        U32ˉformat(Typedˉcalls.Maximumˉstack)
    );
    Report = Textˉconcat(Report, " root=");
    Report = Textˉconcat(Report, U32ˉformat(Graph.Root));
    Report = Textˉconcat(Report, " reachable=");
    Report = Textˉconcat(Report, U32ˉformat(Graph.Reachableˉcount));
    Report = Textˉconcat(Report, " graph-entry-bytes=");
    Report = Textˉconcat(
        Report,
        U32ˉformat(Bytesˉlength(Graph.Functionˉentries))
    );
    Report = Textˉconcat(Report, " graph-target-bytes=");
    return Textˉtoˉutf8(Textˉconcat(
        Report,
        U32ˉformat(Bytesˉlength(Graph.Callˉtargets))
    ));
}
