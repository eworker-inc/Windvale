@page "/"
@using Microsoft.JSInterop
@inject IJSRuntime JavaScript
@implements IAsyncDisposable

<PageTitle>Windvale Playground</PageTitle>

<div class="playground-shell" @ref="Layoutˉelement">
    <header class="app-header">
        <a class="playground-brand" href="../" aria-label="Windvale home">
            <span class="brand-mark"><img src="assets/windvale-mark-transparent.png" alt="" /></span>
            <span>Windvale <b>Playground</b></span>
        </a>
        <nav class="header-actions" aria-label="Playground links">
            <a href="webassembly-compiler/">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m8 5 11 7-11 7z" /></svg>
                Pipeline details
            </a>
            <a href="../">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15.5 5-7 7 7 7" /></svg>
                Home
            </a>
            <button class="icon-button" type="button" @onclick="Toggleˉtheme" aria-label="Switch color theme" title="Switch color theme">
                @if (Theme == "dark")
                {
                    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
                }
                else
                {
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.2 15.2A8.5 8.5 0 0 1 8.8 3.8 8.5 8.5 0 1 0 20.2 15.2Z" /></svg>
                }
            </button>
        </nav>
    </header>

    <div class="ide-toolbar">
        <div class="toolbar-actions">
            <label class="example-picker">
                <span>Open example</span>
                <select value="@Selectedˉexample.Id"
                        @onchange="Selectˉexample"
                        disabled="@Isˉrunning"
                        aria-label="Open example">
                    @if (!Playgroundˉexamples.All.Any(Example => Example.Id == Selectedˉexample.Id))
                    {
                        <option value="@Selectedˉexample.Id">@Selectedˉexample.Title</option>
                    }
                    @foreach (var Example in Playgroundˉexamples.All)
                    {
                        <option value="@Example.Id">@Example.Title</option>
                    }
                </select>
            </label>
            <button class="run-button" type="button" @onclick="Runˉprogram" disabled="@Isˉrunning" title="Compile and run (Ctrl/Cmd+Enter)">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m8 5 11 7-11 7z" /></svg>
                <span>@(Isˉrunning ? "Running…" : "Compile + Run")</span>
                <kbd>⌘/Ctrl ↵</kbd>
            </button>
        </div>
    </div>

    <main class="ide-workspace">
        <div class="ide-top">
            <section class="editor-pane" aria-label="Source editor">
                <div class="editor-tab-strip" role="tablist" aria-label="Open Windvale examples">
                    @foreach (var Tab in Sourceˉtabs)
                    {
                        var Isˉactive = Tab.Id == Activeˉsourceˉtabˉid;
                        <div class="editor-tab @(Isˉactive ? "active" : null)" @key="Tab.Id">
                            <button class="editor-tab-select"
                                    type="button"
                                    role="tab"
                                    aria-selected="@Isˉactive"
                                    aria-controls="source-editor-panel"
                                    disabled="@Isˉrunning"
                                    title="Open @Tab.Fileˉname"
                                    @onclick="() => Selectˉsourceˉtab(Tab.Id)">
                                <b aria-hidden="true">WV</b>
                                <span>@Tab.Fileˉname</span>
                            </button>
                            @if (Sourceˉtabs.Count > 1)
                            {
                                <button class="editor-tab-close"
                                        type="button"
                                        disabled="@Isˉrunning"
                                        aria-label="Close @Tab.Fileˉname"
                                        title="Close @Tab.Fileˉname"
                                        @onclick="() => Closeˉsourceˉtab(Tab.Id)">
                                    <svg viewBox="0 0 16 16" aria-hidden="true"><path d="m4.5 4.5 7 7m0-7-7 7" /></svg>
                                </button>
                            }
                        </div>
                    }
                    <button class="editor-tab-add"
                            type="button"
                            disabled="@(Isˉrunning || Sourceˉtabs.Count >= MAXIMUM_SOURCE_TABS)"
                            aria-label="@Newˉsourceˉtabˉtitle"
                            title="@Newˉsourceˉtabˉtitle"
                            @onclick="Addˉsourceˉtab">
                        <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 3v10M3 8h10" /></svg>
                    </button>
                </div>
                <div id="source-editor-panel"
                     class="editor-stage"
                     role="tabpanel"
                     aria-label="Source for @Activeˉsourceˉtab.Fileˉname">
                    <label class="sr-only" for="fallback-source-editor">Windvale source</label>
                    <textarea id="fallback-source-editor"
                              class="fallback-editor"
                              @bind="Source"
                              @bind:event="oninput"
                              spellcheck="false"
                              autocapitalize="off"
                              autocomplete="off"></textarea>
                    <div class="monaco-host" @ref="Editorˉelement"></div>
                </div>
            </section>

            <div class="resize-handle vertical"
                 data-resize="vertical"
                 role="separator"
                 tabindex="0"
                 aria-label="Resize execution settings"
                 aria-orientation="vertical"
                 title="Drag to resize · double-click to reset">
                <span></span>
            </div>

            <aside class="authority-pane" aria-label="Execution settings">
                <div class="pane-title">
                    <span>Execution settings</span>
                    <span class="local-badge"><i></i> Local</span>
                </div>
                <div class="authority-content">
                    <p class="example-description">@Selectedˉexample.Description</p>

                    <fieldset class="capabilities">
                        <legend>Capabilities</legend>
                        <p>Grant only what this program may use.</p>
                        <label>
                            <input type="checkbox" @bind="Allowˉconsoleˉwrite" />
                            <span><strong>console.write</strong><small>Text without a newline</small></span>
                        </label>
                        <label>
                            <input type="checkbox" @bind="Allowˉconsoleˉwriteˉline" />
                            <span><strong>console.write_line</strong><small>One line of text</small></span>
                        </label>
                        <label>
                            <input type="checkbox" @bind="Allowˉdiagnosticˉwriteˉline" />
                            <span><strong>diagnostic.write_line</strong><small>Diagnostic channel output</small></span>
                        </label>
                    </fieldset>

                    <label class="budget-control" for="instruction-budget">
                        <span>Instruction budget</span>
                        <select id="instruction-budget" @bind="Instructionˉbudget">
                            <option value="10000">10,000 · quick check</option>
                            <option value="250000">250,000 · standard</option>
                            <option value="1000000">1,000,000 · maximum</option>
                        </select>
                    </label>

                    <div class="sandbox-note">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 5 6v5c0 4.6 2.8 8.1 7 10 4.2-1.9 7-5.4 7-10V6z" /><path d="m9 12 2 2 4-4" /></svg>
                        <p><strong>Browser sandbox</strong><span>No files, network, clock, or server upload.</span></p>
                    </div>
                </div>
            </aside>
        </div>

        <div class="resize-handle horizontal"
             data-resize="horizontal"
             role="separator"
             tabindex="0"
             aria-label="Resize results panel"
             aria-orientation="horizontal"
             title="Drag to resize · double-click to reset">
            <span></span>
        </div>

        <section class="results-pane" aria-label="Program results">
            <nav class="result-tabs" aria-label="Result views">
                @foreach (var Tab in Enum.GetValues<Resultˉtab>())
                {
                    <button class="@(Activeˉtab == Tab ? "active" : null)"
                            type="button"
                            @onclick="() => Activeˉtab = Tab"
                            aria-pressed="@(Activeˉtab == Tab)">
                        @Tabˉlabel(Tab)
                        @if (Tab == Resultˉtab.Diagnostics && Result is { Diagnostics.Length: > 0 })
                        {
                            <span class="tab-count">@Result.Diagnostics.Length</span>
                        }
                    </button>
                }
                @if (Result is not null)
                {
                    <span class="result-status @Statusˉclass(Result.Status)">@Statusˉlabel(Result.Status)</span>
                }
            </nav>

            <div class="result-body" aria-live="polite">
                @if (Result is null)
                {
                    <div class="empty-state">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m8 5 11 7-11 7z" /></svg>
                        <p>Run the program to see its output and compiler evidence.</p>
                    </div>
                }
                else if (Activeˉtab == Resultˉtab.Output)
                {
                    <div class="channel-heading"><span>Standard output</span><span>@Utf8ˉcount(Result.Standardˉoutput) bytes</span></div>
                    <pre class="console-output">@(string.IsNullOrEmpty(Result.Standardˉoutput) ? "[no standard output]" : Result.Standardˉoutput)</pre>
                    @if (!string.IsNullOrEmpty(Result.Diagnosticˉoutput))
                    {
                        <div class="channel-heading diagnostic"><span>Diagnostic output</span><span>@Utf8ˉcount(Result.Diagnosticˉoutput) bytes</span></div>
                        <pre class="console-output diagnostic">@Result.Diagnosticˉoutput</pre>
                    }
                }
                else if (Activeˉtab == Resultˉtab.Diagnostics)
                {
                    @if (Result.Diagnostics.IsEmpty)
                    {
                        <div class="empty-state success"><span aria-hidden="true">✓</span><p>No diagnostics. The module passed this pipeline.</p></div>
                    }
                    else
                    {
                        <ol class="diagnostic-list">
                            @foreach (var Diagnostic in Result.Diagnostics)
                            {
                                <li>
                                    <button type="button" @onclick="() => Revealˉdiagnostic(Diagnostic)" disabled="@(Diagnostic.Line is null)">
                                        <span><code>@Diagnostic.Code</code><small>@Diagnostic.Phase</small></span>
                                        <strong>@Diagnostic.Message</strong>
                                        @if (Diagnostic.Line is not null)
                                        {
                                            <em>@Activeˉsourceˉtab.Fileˉname:@Diagnostic.Line:@Diagnostic.Column</em>
                                        }
                                        else if (Diagnostic.Byteˉoffset is not null)
                                        {
                                            <em>WVB byte @Diagnostic.Byteˉoffset</em>
                                        }
                                    </button>
                                </li>
                            }
                        </ol>
                    }
                }
                else if (Activeˉtab == Resultˉtab.Bytecode)
                {
                    @if (Result.Bytecodeˉreport is null)
                    {
                        <div class="empty-state"><span aria-hidden="true">—</span><p>No WVB was produced.</p></div>
                    }
                    else
                    {
                        <div class="channel-heading"><span>Canonical WVB disassembly</span><span>@Result.Bytecodeˉbytes.Length.ToString("N0") bytes</span></div>
                        <pre class="bytecode-output">@Result.Bytecodeˉreport</pre>
                    }
                }
                else
                {
                    <div class="execution-layout">
                        <dl class="execution-grid">
                            <div><dt>Pipeline</dt><dd>@Statusˉlabel(Result.Status)</dd></div>
                            <div><dt>Module profile</dt><dd>@(Result.Profile?.ToString().ToLowerInvariant() ?? "—")</dd></div>
                            <div><dt>Exit code</dt><dd>@(Result.Exitˉcode?.ToString() ?? "—")</dd></div>
                            <div><dt>Instructions</dt><dd>@(Result.Executedˉinstructions?.ToString("N0") ?? "—")</dd></div>
                            <div><dt>WVB size</dt><dd>@Result.Bytecodeˉbytes.Length.ToString("N0") bytes</dd></div>
                            <div><dt>Budget</dt><dd>@Instructionˉbudget.ToString("N0")</dd></div>
                            <div><dt>Wasm worker</dt><dd>@Webassemblyˉworkerˉlabel</dd></div>
                            <div><dt>Wasm result</dt><dd>@Webassemblyˉresultˉlabel</dd></div>
                            <div><dt>Wasm instructions</dt><dd>@(Webassemblyˉexecution?.ExecutedInstructions?.ToString("N0") ?? "—")</dd></div>
                        </dl>
                        <div class="capability-evidence">
                            <h3>Required by module</h3>
                            @Capabilityˉlist(Result.Requiredˉcapabilities)
                            <h3>Authorized for run</h3>
                            @Capabilityˉlist(Result.Authorizedˉcapabilities)
                        </div>
                        <div class="digest">
                            <span>WVB SHA-256</span>
                            <code>@(Result.Moduleˉsha256 ?? "No module digest")</code>
                            @if (Webassemblyˉlowering?.Webassemblyˉsha256 is not null)
                            {
                                <span>Generated Wasm SHA-256</span>
                                <code>@Webassemblyˉlowering.Webassemblyˉsha256</code>
                                <span>Windvale backend WVB SHA-256</span>
                                <code>@Playgroundˉwebassemblyˉlowerer.BACKEND_WVB_SHA256</code>
                            }
                            @if (Webassemblyˉmessage is not null)
                            {
                                <p class="wasm-note">@Webassemblyˉmessage</p>
                            }
                        </div>
                    </div>
                }
            </div>
        </section>
    </main>

    <footer class="status-bar">
        <div>
            <span class="status-state @Runˉstatusˉclass"><i></i>@Runˉstatusˉlabel</span>
            <span class="status-item wide-only">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 5 6v5c0 4.6 2.8 8.1 7 10 4.2-1.9 7-5.4 7-10V6z" /></svg>
                Local browser
            </span>
        </div>
        <div>
            <span class="status-item" title="Diagnostics">
                <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 7v6m0 4h.01" /></svg>
                @(Result?.Diagnostics.Length ?? 0)
            </span>
            <span class="status-item wide-only" data-status-characters>@Source.Length.ToString("N0") chars</span>
            <span class="status-item" data-status-cursor>Ln 1, Col 1</span>
            <span class="status-item wide-only"
                  title="Keyboard shortcuts: run Ctrl+Enter; show completions Ctrl+Space; insert the Windvale separator Ctrl+M or Ctrl+Semicolon">
                Shortcuts: Ctrl+Enter run · Ctrl+Space complete · Ctrl+M / Ctrl+; ˉ
            </span>
        </div>
    </footer>
</div>

@code {
    private ElementReference Layoutˉelement;
    private ElementReference Editorˉelement;
    private IJSObjectReference? Editorˉmodule;
    private IJSObjectReference? Webassemblyˉmodule;
    private DotNetObjectReference<Home>? Selfˉreference;
    private readonly List<Playgroundˉsourceˉtab> Sourceˉtabs = [];
    private int Activeˉsourceˉtabˉid;
    private int Nextˉsourceˉtabˉid = 1;
    private int Nextˉscratchˉtabˉnumber = 1;
    private Playgroundˉexample Selectedˉexample = Playgroundˉexamples.All[0];
    private string Source = string.Empty;
    private string Theme = "light";
    private bool Allowˉconsoleˉwrite;
    private bool Allowˉconsoleˉwriteˉline = true;
    private bool Allowˉdiagnosticˉwriteˉline;
    private long Instructionˉbudget = Playgroundˉlimits.DEFAULT_MAXIMUM_INSTRUCTIONS;
    private bool Editorˉready;
    private bool Isˉrunning;
    private Playgroundˉresult? Result;
    private Playgroundˉwebassemblyˉloweringˉresult? Webassemblyˉlowering;
    private Browserˉwebassemblyˉresult? Webassemblyˉexecution;
    private Resultˉtab Activeˉtab = Resultˉtab.Output;

    private const int WEBASSEMBLY_WORKER_TIMEOUT_MILLISECONDS = 2_000;
    private const int MAXIMUM_SOURCE_TABS = 12;

    private Playgroundˉsourceˉtab Activeˉsourceˉtab =>
        Sourceˉtabs.First(Tab => Tab.Id == Activeˉsourceˉtabˉid);

    private string Newˉsourceˉtabˉtitle => Sourceˉtabs.Count >= MAXIMUM_SOURCE_TABS
        ? $"Maximum of {MAXIMUM_SOURCE_TABS} source tabs open"
        : "New scratch tab";

    private enum Resultˉtab
    {
        Output,
        Diagnostics,
        Bytecode,
        Execution,
    }

    protected override void OnInitialized()
    {
        var Initialˉtab = Playgroundˉsourceˉtab.Fromˉexample(Nextˉsourceˉtabˉid++, Playgroundˉexamples.All[0]);
        Sourceˉtabs.Add(Initialˉtab);
        Activeˉsourceˉtabˉid = Initialˉtab.Id;
        Restoreˉsourceˉtab(Initialˉtab);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            Editorˉmodule = await JavaScript.InvokeAsync<IJSObjectReference>("import", "./editor/playground-editor.js");
            Selfˉreference = DotNetObjectReference.Create(this);
            Theme = await Editorˉmodule.InvokeAsync<string>(
                "Initialize",
                Editorˉelement,
                Layoutˉelement,
                Source,
                Selfˉreference);
            Editorˉready = true;
            await InvokeAsync(StateHasChanged);
        }
        catch (JSException)
        {
            // The bound textarea remains available when the enhanced editor cannot load.
        }
    }

    private async Task Selectˉexample(ChangeEventArgs arguments)
    {
        var Id = arguments.Value?.ToString();
        var Example = Playgroundˉexamples.All.FirstOrDefault(Candidate => Candidate.Id == Id);
        if (Example is null || Isˉrunning)
        {
            return;
        }

        await Captureˉsourceˉtab();
        var Tab = Sourceˉtabs.FirstOrDefault(Candidate => Candidate.Example.Id == Example.Id);
        if (Tab is null)
        {
            Tab = Playgroundˉsourceˉtab.Fromˉexample(Nextˉsourceˉtabˉid++, Example);
            Sourceˉtabs.Add(Tab);
        }

        Activeˉsourceˉtabˉid = Tab.Id;
        Restoreˉsourceˉtab(Tab);
        Clearˉrunˉstate();

        if (Editorˉready && Editorˉmodule is not null)
        {
            await Editorˉmodule.InvokeVoidAsync("SetValue", Source);
        }
    }

    private async Task Addˉsourceˉtab()
    {
        if (Isˉrunning || Sourceˉtabs.Count >= MAXIMUM_SOURCE_TABS)
        {
            return;
        }

        await Captureˉsourceˉtab();
        var Tab = Playgroundˉsourceˉtab.Createˉscratch(
            Nextˉsourceˉtabˉid++,
            Nextˉscratchˉtabˉnumber++);
        Sourceˉtabs.Add(Tab);
        Activeˉsourceˉtabˉid = Tab.Id;
        Restoreˉsourceˉtab(Tab);
        Clearˉrunˉstate();

        if (Editorˉready && Editorˉmodule is not null)
        {
            await Editorˉmodule.InvokeVoidAsync("SetValue", Source);
        }
    }

    private async Task Selectˉsourceˉtab(int id)
    {
        if (id == Activeˉsourceˉtabˉid || Isˉrunning)
        {
            return;
        }

        var Tab = Sourceˉtabs.FirstOrDefault(Candidate => Candidate.Id == id);
        if (Tab is null)
        {
            return;
        }

        await Captureˉsourceˉtab();
        Activeˉsourceˉtabˉid = Tab.Id;
        Restoreˉsourceˉtab(Tab);
        Clearˉrunˉstate();

        if (Editorˉready && Editorˉmodule is not null)
        {
            await Editorˉmodule.InvokeVoidAsync("SetValue", Source);
        }
    }

    private async Task Closeˉsourceˉtab(int id)
    {
        if (Sourceˉtabs.Count <= 1 || Isˉrunning)
        {
            return;
        }

        var Index = Sourceˉtabs.FindIndex(Tab => Tab.Id == id);
        if (Index < 0)
        {
            return;
        }

        var Closingˉactiveˉtab = id == Activeˉsourceˉtabˉid;
        if (Closingˉactiveˉtab)
        {
            await Captureˉsourceˉtab();
        }

        Sourceˉtabs.RemoveAt(Index);
        if (!Closingˉactiveˉtab)
        {
            return;
        }

        var Tab = Sourceˉtabs[Math.Min(Index, Sourceˉtabs.Count - 1)];
        Activeˉsourceˉtabˉid = Tab.Id;
        Restoreˉsourceˉtab(Tab);
        Clearˉrunˉstate();

        if (Editorˉready && Editorˉmodule is not null)
        {
            await Editorˉmodule.InvokeVoidAsync("SetValue", Source);
        }
    }

    private async Task Captureˉsourceˉtab()
    {
        if (Editorˉready && Editorˉmodule is not null)
        {
            Source = await Editorˉmodule.InvokeAsync<string>("GetValue");
        }

        var Tab = Activeˉsourceˉtab;
        Tab.Source = Source;
        Tab.Allowˉconsoleˉwrite = Allowˉconsoleˉwrite;
        Tab.Allowˉconsoleˉwriteˉline = Allowˉconsoleˉwriteˉline;
        Tab.Allowˉdiagnosticˉwriteˉline = Allowˉdiagnosticˉwriteˉline;
        Tab.Instructionˉbudget = Instructionˉbudget;
    }

    private void Restoreˉsourceˉtab(Playgroundˉsourceˉtab tab)
    {
        Selectedˉexample = tab.Example;
        Source = tab.Source;
        Allowˉconsoleˉwrite = tab.Allowˉconsoleˉwrite;
        Allowˉconsoleˉwriteˉline = tab.Allowˉconsoleˉwriteˉline;
        Allowˉdiagnosticˉwriteˉline = tab.Allowˉdiagnosticˉwriteˉline;
        Instructionˉbudget = tab.Instructionˉbudget;
    }

    private void Clearˉrunˉstate()
    {
        Result = null;
        Webassemblyˉlowering = null;
        Webassemblyˉexecution = null;
        Activeˉtab = Resultˉtab.Output;
    }

    [JSInvokable("RunWindvaleProgram")]
    public Task RunWindvaleProgram() => Runˉprogram();

    private async Task Runˉprogram()
    {
        if (Isˉrunning)
        {
            return;
        }

        await Captureˉsourceˉtab();

        Isˉrunning = true;
        Result = null;
        Webassemblyˉlowering = null;
        Webassemblyˉexecution = null;
        await InvokeAsync(StateHasChanged);
        await Task.Yield();

        try
        {
            var Authorized = ImmutableHashSet.CreateBuilder<string>(StringComparer.Ordinal);
            if (Allowˉconsoleˉwrite)
            {
                Authorized.Add(Capabilityˉcatalog.CONSOLE_WRITE);
            }
            if (Allowˉconsoleˉwriteˉline)
            {
                Authorized.Add(Capabilityˉcatalog.CONSOLE_WRITE_LINE);
            }
            if (Allowˉdiagnosticˉwriteˉline)
            {
                Authorized.Add(Capabilityˉcatalog.DIAGNOSTIC_WRITE_LINE);
            }

            Result = Playgroundˉrunner.Run(new(Source, Authorized.ToImmutable(), Instructionˉbudget));
            Activeˉtab = Result.Status switch
            {
                Playgroundˉstatus.Compilationˉfailed or
                Playgroundˉstatus.Verificationˉfailed or
                Playgroundˉstatus.Rejected or
                Playgroundˉstatus.Runtimeˉfailed => Resultˉtab.Diagnostics,
                _ => Resultˉtab.Output,
            };

            if (Editorˉready && Editorˉmodule is not null)
            {
                var Markers = Result.Diagnostics
                    .Where(Diagnostic => Diagnostic.Line is not null)
                    .Select(Diagnostic => new
                    {
                        StartLineNumber = Diagnostic.Line!.Value,
                        StartColumn = Diagnostic.Column ?? 1,
                        Message = $"{Diagnostic.Code}: {Diagnostic.Message}",
                        Diagnostic.Code,
                        Diagnostic.Phase,
                    })
                    .ToArray();
                await Editorˉmodule.InvokeVoidAsync("SetDiagnostics", Markers);
            }

            await Runˉwebassemblyˉworker();
        }
        finally
        {
            Isˉrunning = false;
        }
    }

    private async Task Revealˉdiagnostic(Playgroundˉdiagnostic diagnostic)
    {
        if (Editorˉready && Editorˉmodule is not null && diagnostic.Line is not null)
        {
            await Editorˉmodule.InvokeVoidAsync("RevealPosition", diagnostic.Line.Value, diagnostic.Column ?? 1);
        }
    }

    private async Task Toggleˉtheme()
    {
        if (Editorˉmodule is not null)
        {
            Theme = await Editorˉmodule.InvokeAsync<string>("ToggleTheme");
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (Webassemblyˉmodule is not null)
        {
            try
            {
                await Webassemblyˉmodule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The browser has already navigated away.
            }
        }
        if (Editorˉmodule is not null)
        {
            try
            {
                await Editorˉmodule.InvokeVoidAsync("Dispose");
                await Editorˉmodule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The browser has already navigated away.
            }
        }
        Selfˉreference?.Dispose();
    }

    private string Runˉstatusˉlabel => Isˉrunning
        ? "Running"
        : Result is null
            ? "Ready"
            : Webassemblyˉfailed
                ? "WASM FAILED"
                : Statusˉlabel(Result.Status);

    private string Runˉstatusˉclass => Isˉrunning
        ? "running"
        : Result is null
            ? "idle"
            : Webassemblyˉfailed
                ? "failure"
                : Statusˉclass(Result.Status);

    private async Task Runˉwebassemblyˉworker()
    {
        if (Result is not
            {
                Status: Playgroundˉstatus.Completed,
                Profile: Moduleˉprofile.Portable,
                Requiredˉcapabilities.IsEmpty: true,
            })
        {
            return;
        }

        Webassemblyˉlowering = Playgroundˉwebassemblyˉlowerer.Lower(Result.Bytecodeˉbytes);
        if (Webassemblyˉlowering.Status != Playgroundˉwebassemblyˉloweringˉstatus.Lowered)
        {
            return;
        }

        try
        {
            Webassemblyˉmodule ??= await JavaScript.InvokeAsync<IJSObjectReference>(
                "import",
                "./js/windvale-wasm-host.js");
            Webassemblyˉexecution = await Webassemblyˉmodule.InvokeAsync<Browserˉwebassemblyˉresult>(
                "Execute",
                Webassemblyˉlowering.Webassemblyˉbytes.ToArray(),
                WEBASSEMBLY_WORKER_TIMEOUT_MILLISECONDS);
        }
        catch (JSException Exception)
        {
            Webassemblyˉexecution = Browserˉwebassemblyˉresult.Failure(Exception.Message);
        }

        Activeˉtab = Resultˉtab.Execution;
    }

    private bool Webassemblyˉmatched =>
        Result is not null &&
        Webassemblyˉexecution is { Succeeded: true, Status: 0 } Execution &&
        Execution.Result == Result.Exitˉcode &&
        (Execution.ExecutionAbi == 0 ||
            Execution.ExecutedInstructions == Result.Executedˉinstructions);

    private bool Webassemblyˉfailed =>
        Webassemblyˉlowering?.Status == Playgroundˉwebassemblyˉloweringˉstatus.Failed ||
        (Webassemblyˉlowering?.Status == Playgroundˉwebassemblyˉloweringˉstatus.Lowered &&
            Webassemblyˉexecution is not null &&
            !Webassemblyˉmatched);

    private string Webassemblyˉworkerˉlabel => Webassemblyˉlowering?.Status switch
    {
        null => "not selected",
        Playgroundˉwebassemblyˉloweringˉstatus.Unsupported =>
            $"subset: {Webassemblyˉlowering.Selectorˉstatus}",
        Playgroundˉwebassemblyˉloweringˉstatus.Failed => "lowering failed",
        Playgroundˉwebassemblyˉloweringˉstatus.Lowered when Webassemblyˉexecution is null =>
            "worker unavailable",
        Playgroundˉwebassemblyˉloweringˉstatus.Lowered when Webassemblyˉmatched =>
            $"matched · ABI {Webassemblyˉexecution!.ExecutionAbi}",
        _ => "mismatch",
    };

    private string Webassemblyˉresultˉlabel => Webassemblyˉexecution is
        { Succeeded: true, Status: not null, Result: not null } Execution
            ? $"status {Execution.Status}, result {Execution.Result}"
            : "—";

    private string? Webassemblyˉmessage => Webassemblyˉlowering?.Status switch
    {
        Playgroundˉwebassemblyˉloweringˉstatus.Unsupported =>
            "This valid program is outside the bounded direct-Wasm subset, so the .NET reference interpreter remains the execution path.",
        Playgroundˉwebassemblyˉloweringˉstatus.Failed => Webassemblyˉlowering.Failure,
        Playgroundˉwebassemblyˉloweringˉstatus.Lowered when
            Webassemblyˉexecution is { Succeeded: false } => Webassemblyˉexecution.Error,
        Playgroundˉwebassemblyˉloweringˉstatus.Lowered when
            Webassemblyˉexecution is { Succeeded: true } && !Webassemblyˉmatched =>
                "The disposable WebAssembly worker did not match the .NET reference result.",
        Playgroundˉwebassemblyˉloweringˉstatus.Lowered =>
            "A disposable worker validated and ran the Windvale-generated, import-free WebAssembly module; its result agrees with the .NET reference interpreter.",
        _ => null,
    };

    private static RenderFragment Capabilityˉlist(ImmutableArray<string> capabilities) => Builder =>
    {
        if (capabilities.IsEmpty)
        {
            Builder.OpenElement(0, "p");
            Builder.AddAttribute(1, "class", "none-label");
            Builder.AddContent(2, "none");
            Builder.CloseElement();
            return;
        }

        Builder.OpenElement(3, "ul");
        Builder.AddAttribute(4, "class", "inline-capabilities");
        var Sequence = 5;
        foreach (var Capability in capabilities)
        {
            Builder.OpenElement(Sequence++, "li");
            Builder.AddContent(Sequence++, Capability);
            Builder.CloseElement();
        }
        Builder.CloseElement();
    };

    private static int Utf8ˉcount(string value) => System.Text.Encoding.UTF8.GetByteCount(value);

    private static string Statusˉlabel(Playgroundˉstatus status) => status switch
    {
        Playgroundˉstatus.Rejected => "REJECTED",
        Playgroundˉstatus.Compilationˉfailed => "COMPILE FAILED",
        Playgroundˉstatus.Verificationˉfailed => "VERIFY FAILED",
        Playgroundˉstatus.Runtimeˉfailed => "RUN FAILED",
        Playgroundˉstatus.Completed => "COMPLETED",
        _ => status.ToString().ToUpperInvariant(),
    };

    private static string Statusˉclass(Playgroundˉstatus status) => status switch
    {
        Playgroundˉstatus.Completed => "success",
        _ => "failure",
    };

    private static string Tabˉlabel(Resultˉtab tab) => tab switch
    {
        Resultˉtab.Bytecode => "Bytecode",
        _ => tab.ToString(),
    };

    private sealed class Playgroundˉsourceˉtab
    {
        private Playgroundˉsourceˉtab(
            int id,
            Playgroundˉexample example,
            string source,
            bool allowˉconsoleˉwrite,
            bool allowˉconsoleˉwriteˉline,
            bool allowˉdiagnosticˉwriteˉline,
            long instructionˉbudget)
        {
            Id = id;
            Example = example;
            Source = source;
            Allowˉconsoleˉwrite = allowˉconsoleˉwrite;
            Allowˉconsoleˉwriteˉline = allowˉconsoleˉwriteˉline;
            Allowˉdiagnosticˉwriteˉline = allowˉdiagnosticˉwriteˉline;
            Instructionˉbudget = instructionˉbudget;
        }

        public int Id { get; }

        public Playgroundˉexample Example { get; }

        public string Fileˉname => $"{Example.Id}.wv";

        public string Source { get; set; }

        public bool Allowˉconsoleˉwrite { get; set; }

        public bool Allowˉconsoleˉwriteˉline { get; set; }

        public bool Allowˉdiagnosticˉwriteˉline { get; set; }

        public long Instructionˉbudget { get; set; }

        public static Playgroundˉsourceˉtab Fromˉexample(int id, Playgroundˉexample example) => new(
            id,
            example,
            example.Source,
            example.Recommendedˉcapabilities.Contains(Capabilityˉcatalog.CONSOLE_WRITE),
            example.Recommendedˉcapabilities.Contains(Capabilityˉcatalog.CONSOLE_WRITE_LINE),
            example.Recommendedˉcapabilities.Contains(Capabilityˉcatalog.DIAGNOSTIC_WRITE_LINE),
            Playgroundˉlimits.DEFAULT_MAXIMUM_INSTRUCTIONS);

        public static Playgroundˉsourceˉtab Createˉscratch(int id, int number)
        {
            var Example = new Playgroundˉexample(
                $"scratch-{number}",
                $"Scratch {number}",
                "An independent scratch program. Compile + Run uses this active tab only.",
                """
                module Scratch profile portable;

                export fn Main() -> i32 {
                    return 0;
                }
                """,
                ImmutableHashSet.Create<string>(StringComparer.Ordinal));
            return Fromˉexample(id, Example);
        }
    }

    private sealed class Browserˉwebassemblyˉresult
    {
        public bool Succeeded { get; set; }

        public int? ExecutionAbi { get; set; }

        public int? Status { get; set; }

        public int? Result { get; set; }

        public long? ExecutedInstructions { get; set; }

        public string? Error { get; set; }

        public static Browserˉwebassemblyˉresult Failure(string error) => new()
        {
            Error = error,
        };
    }
}
