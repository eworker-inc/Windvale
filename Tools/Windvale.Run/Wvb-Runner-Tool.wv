module Wvbˉrunnerˉtool profile hosted;

import WebAssemblyˉwvbˉscalarˉinterpreter as Interpreter;
import WebAssemblyˉwvbˉscalarˉinterpreterˉenvelope as Envelopeˉreader;
import WebAssemblyˉwvbˉscalarˉinterpreterˉformatting as Formatting;
import Windvaleˉcompilerˉwvbˉverifierˉmetadata as Metadataˉverifier;

capability console.write_line;
capability diagnostic.write_line;
capability file.read_bytes;
capability process.argument;
capability process.argument_count;

fn Moduleˉisˉadmitted(Module: bytes) -> bool {
    if Bytesˉlength(Module) < 8u32 ||
        Bytesˉreadˉu16ˉlittle(Module, 4u32) != 1u32 ||
        Bytesˉreadˉu16ˉlittle(Module, 6u32) != 36u32 {
        return true;
    }
    return Metadataˉverifier.Compilerˉwvbˉverifyˉmetadata(Module) == 0u32;
}

fn Reportˉcompilerˉverificationˉfailure() -> i32 {
    diagnostic.write_line(
        "wvb run status=Invalid phase=compiler-verification"
    );
    return 1;
}

fn Buildˉrequest(Module: bytes) -> bytes {
    var Request: bytes = Bytesˉfromˉu32ˉlittle(1230526039u32);
    Request = Bytesˉconcat(Request, Bytesˉfromˉu16ˉlittle(1u32));
    Request = Bytesˉconcat(Request, Bytesˉfromˉu16ˉlittle(0u32));
    Request = Bytesˉconcat(Request, Bytesˉfromˉu32ˉlittle(1000000u32));
    Request = Bytesˉconcat(Request, Bytesˉfromˉu32ˉlittle(8u32));
    return Bytesˉconcat(Request, Module);
}

fn Buildˉscriptˉrequest(Module: bytes, Arguments: u32) -> bytes {
    let Invalid: bytes = Bytesˉslice(Module, 0u32, 0u32);
    if Arguments < 2u32 || Arguments > 67u32 { return Invalid; }
    var Argumentˉpayload: bytes = Invalid;
    var Argumentˉutf8ˉbytes: u32 = 0u32;
    var Argumentˉindex: u32 = 2u32;
    while Argumentˉindex < Arguments {
        let Argumentˉbytes: bytes = Textˉtoˉutf8(
            process.argument(Argumentˉindex)
        );
        let Argumentˉlength: u32 = Bytesˉlength(Argumentˉbytes);
        if Argumentˉlength > 4096u32 { return Invalid; }
        if Argumentˉutf8ˉbytes > 65536u32 - Argumentˉlength {
            return Invalid;
        }
        Argumentˉutf8ˉbytes = Argumentˉutf8ˉbytes + Argumentˉlength;
        Argumentˉpayload = Bytesˉconcat(
            Argumentˉpayload,
            Bytesˉfromˉu32ˉlittle(Argumentˉlength)
        );
        Argumentˉpayload = Bytesˉconcat(Argumentˉpayload, Argumentˉbytes);
        Argumentˉindex = Argumentˉindex + 1u32;
    }

    var Request: bytes = Bytesˉfromˉu32ˉlittle(1230526039u32);
    Request = Bytesˉconcat(Request, Bytesˉfromˉu16ˉlittle(4u32));
    Request = Bytesˉconcat(Request, Bytesˉfromˉu16ˉlittle(0u32));
    Request = Bytesˉconcat(Request, Bytesˉfromˉu32ˉlittle(1000000u32));
    Request = Bytesˉconcat(Request, Bytesˉfromˉu32ˉlittle(8u32));
    Request = Bytesˉconcat(
        Request,
        Bytesˉfromˉu32ˉlittle(Bytesˉlength(Module))
    );
    Request = Bytesˉconcat(Request, Bytesˉfromˉu32ˉlittle(15u32));
    Request = Bytesˉconcat(Request, Bytesˉfromˉu32ˉlittle(65536u32));
    Request = Bytesˉconcat(Request, Bytesˉfromˉu32ˉlittle(65536u32));
    Request = Bytesˉconcat(
        Request,
        Bytesˉfromˉu32ˉlittle(Arguments - 2u32)
    );
    Request = Bytesˉconcat(
        Request,
        Bytesˉfromˉu32ˉlittle(Bytesˉlength(Argumentˉpayload))
    );
    Request = Bytesˉconcat(Request, Bytesˉfromˉu32ˉlittle(0u32));
    Request = Bytesˉconcat(Request, Module);
    return Bytesˉconcat(Request, Argumentˉpayload);
}

fn Buildˉsourceˉfileˉrequest(Module: bytes, Snapshot: bytes) -> bytes {
    let Snapshotˉlength: u32 = Bytesˉlength(Snapshot);
    let Providerˉgeneration: u32 = 1u32;
    var Request: bytes = Bytesˉfromˉu32ˉlittle(1230526039u32);
    Request = Bytesˉconcat(Request, Bytesˉfromˉu16ˉlittle(5u32));
    Request = Bytesˉconcat(Request, Bytesˉfromˉu16ˉlittle(0u32));
    Request = Bytesˉconcat(Request, Bytesˉfromˉu32ˉlittle(1000000u32));
    Request = Bytesˉconcat(Request, Bytesˉfromˉu32ˉlittle(8u32));
    Request = Bytesˉconcat(
        Request,
        Bytesˉfromˉu32ˉlittle(Bytesˉlength(Module))
    );
    Request = Bytesˉconcat(Request, Bytesˉfromˉu32ˉlittle(1u32));
    Request = Bytesˉconcat(
        Request,
        Bytesˉfromˉu32ˉlittle(Providerˉgeneration)
    );
    Request = Bytesˉconcat(
        Request,
        Bytesˉfromˉu32ˉlittle(Providerˉgeneration)
    );
    Request = Bytesˉconcat(
        Request,
        Bytesˉfromˉu32ˉlittle(Snapshotˉlength)
    );
    Request = Bytesˉconcat(Request, Bytesˉfromˉu32ˉlittle(0u32));
    Request = Bytesˉconcat(Request, Module);
    return Bytesˉconcat(Request, Snapshot);
}

record Decimalˉu64 {
    Valid: bool;
    Value: u64;
}

record Taskˉenvironment {
    Valid: bool;
    Contextˉgeneration: u32;
    Clockˉgeneration: u64;
    Deadline: u64;
    Expectedˉruntimeˉgeneration: u64;
    Admittedˉruntimeˉgeneration: u64;
    Observationˉtick: u64;
    Observedˉruntimeˉgeneration: u64;
}

fn Parseˉdecimalˉu64(Input: text) -> Decimalˉu64 {
    let Inputˉbytes: bytes = Textˉtoˉutf8(Input);
    let Length: u32 = Bytesˉlength(Inputˉbytes);
    if Length == 0u32 || (Length > 1u32 &&
        U32ˉfromˉu8(Bytesˉreadˉu8(Inputˉbytes, 0u32)) == 48u32) {
        return Decimalˉu64(false, 0u64);
    }
    var Value: u64 = 0u64;
    var Index: u32 = 0u32;
    while Index < Length {
        let Byte: u32 = U32ˉfromˉu8(
            Bytesˉreadˉu8(Inputˉbytes, Index)
        );
        if Byte < 48u32 || Byte > 57u32 {
            return Decimalˉu64(false, 0u64);
        }
        let Digit: u64 = U64ˉfromˉu32(Byte - 48u32);
        if Value > 1844674407370955161u64 ||
            (Value == 1844674407370955161u64 && Digit > 5u64) {
            return Decimalˉu64(false, 0u64);
        }
        Value = Value * 10u64 + Digit;
        Index = Index + 1u32;
    }
    return Decimalˉu64(true, Value);
}

fn Defaultˉtaskˉenvironment() -> Taskˉenvironment {
    return Taskˉenvironment(
        true,
        1u32,
        1u64,
        18446744073709551615u64,
        1u64,
        1u64,
        0u64,
        1u64
    );
}

fn Parseˉtaskˉenvironment() -> Taskˉenvironment {
    let Context: Decimalˉu64 = Parseˉdecimalˉu64(process.argument(2u32));
    let Clock: Decimalˉu64 = Parseˉdecimalˉu64(process.argument(3u32));
    let Deadline: Decimalˉu64 = Parseˉdecimalˉu64(process.argument(4u32));
    let Expected: Decimalˉu64 = Parseˉdecimalˉu64(process.argument(5u32));
    let Admitted: Decimalˉu64 = Parseˉdecimalˉu64(process.argument(6u32));
    let Tick: Decimalˉu64 = Parseˉdecimalˉu64(process.argument(7u32));
    let Observed: Decimalˉu64 = Parseˉdecimalˉu64(process.argument(8u32));
    if !Context.Valid || Context.Value == 0u64 ||
        Context.Value > 4294967295u64 || !Clock.Valid ||
        Clock.Value == 0u64 || !Deadline.Valid || !Expected.Valid ||
        Expected.Value == 0u64 || !Admitted.Valid || !Tick.Valid ||
        !Observed.Valid {
        return Taskˉenvironment(
            false, 0u32, 0u64, 0u64, 0u64, 0u64, 0u64, 0u64
        );
    }
    return Taskˉenvironment(
        true,
        Bytesˉreadˉu32ˉlittle(Bytesˉfromˉu64ˉlittle(Context.Value), 0u32),
        Clock.Value, Deadline.Value, Expected.Value, Admitted.Value,
        Tick.Value, Observed.Value
    );
}

fn Buildˉstructuredˉtaskˉrequest(
    Module: bytes,
    Environment: Taskˉenvironment,
    Includeˉoutput: bool
) -> bytes {
    let Invalid: bytes = Bytesˉslice(Module, 0u32, 0u32);
    if !Environment.Valid { return Invalid; }
    var Request: bytes = Bytesˉfromˉu32ˉlittle(1230526039u32);
    Request = Bytesˉconcat(Request, Bytesˉfromˉu16ˉlittle(6u32));
    var Requestˉminor: u32 = 1u32;
    if Includeˉoutput { Requestˉminor = 2u32; }
    Request = Bytesˉconcat(
        Request, Bytesˉfromˉu16ˉlittle(Requestˉminor)
    );
    Request = Bytesˉconcat(Request, Bytesˉfromˉu32ˉlittle(1000000u32));
    Request = Bytesˉconcat(Request, Bytesˉfromˉu32ˉlittle(8u32));
    Request = Bytesˉconcat(
        Request, Bytesˉfromˉu32ˉlittle(Bytesˉlength(Module))
    );
    Request = Bytesˉconcat(
        Request, Bytesˉfromˉu32ˉlittle(Environment.Contextˉgeneration)
    );
    Request = Bytesˉconcat(
        Request, Bytesˉfromˉu64ˉlittle(Environment.Clockˉgeneration)
    );
    Request = Bytesˉconcat(
        Request, Bytesˉfromˉu64ˉlittle(Environment.Deadline)
    );
    Request = Bytesˉconcat(
        Request,
        Bytesˉfromˉu64ˉlittle(Environment.Expectedˉruntimeˉgeneration)
    );
    Request = Bytesˉconcat(
        Request,
        Bytesˉfromˉu64ˉlittle(Environment.Admittedˉruntimeˉgeneration)
    );
    Request = Bytesˉconcat(
        Request, Bytesˉfromˉu64ˉlittle(Environment.Observationˉtick)
    );
    Request = Bytesˉconcat(
        Request,
        Bytesˉfromˉu64ˉlittle(Environment.Observedˉruntimeˉgeneration)
    );
    if Includeˉoutput {
        Request = Bytesˉconcat(Request, Bytesˉfromˉu32ˉlittle(1u32));
        Request = Bytesˉconcat(Request, Bytesˉfromˉu32ˉlittle(64u32));
        Request = Bytesˉconcat(Request, Bytesˉfromˉu32ˉlittle(0u32));
    }
    return Bytesˉconcat(Request, Module);
}

fn Reportˉfailure(Status: u32, Instructions: u32) -> void {
    var Report: text = Textˉconcat(
        "wvb run status=Failed code=",
        U32ˉformat(Status)
    );
    Report = Textˉconcat(Report, " instructions=");
    diagnostic.write_line(Textˉconcat(Report, U32ˉformat(Instructions)));
}

fn Isˉreportˉsteps(Input: text) -> bool {
    let Actual: bytes = Textˉtoˉutf8(Input);
    let Expected: bytes = Textˉtoˉutf8("--report-steps");
    let Length: u32 = Bytesˉlength(Actual);
    if Length != Bytesˉlength(Expected) { return false; }
    var Index: u32 = 0u32;
    while Index < Length {
        if Bytesˉreadˉu8(Actual, Index) != Bytesˉreadˉu8(Expected, Index) {
            return false;
        }
        Index = Index + 1u32;
    }
    return true;
}

fn Isˉscriptˉmode(Input: text) -> bool {
    let Actual: bytes = Textˉtoˉutf8(Input);
    let Expected: bytes = Textˉtoˉutf8("--script");
    let Length: u32 = Bytesˉlength(Actual);
    if Length != Bytesˉlength(Expected) { return false; }
    var Index: u32 = 0u32;
    while Index < Length {
        if Bytesˉreadˉu8(Actual, Index) != Bytesˉreadˉu8(Expected, Index) {
            return false;
        }
        Index = Index + 1u32;
    }
    return true;
}

fn Isˉsourceˉfileˉmode(Input: text) -> bool {
    let Actual: bytes = Textˉtoˉutf8(Input);
    let Expected: bytes = Textˉtoˉutf8("--source-file");
    let Length: u32 = Bytesˉlength(Actual);
    if Length != Bytesˉlength(Expected) { return false; }
    var Index: u32 = 0u32;
    while Index < Length {
        if Bytesˉreadˉu8(Actual, Index) != Bytesˉreadˉu8(Expected, Index) {
            return false;
        }
        Index = Index + 1u32;
    }
    return true;
}

fn Isˉtaskˉenvironmentˉmode(Input: text) -> bool {
    let Actual: bytes = Textˉtoˉutf8(Input);
    let Expected: bytes = Textˉtoˉutf8("--task-environment");
    let Length: u32 = Bytesˉlength(Actual);
    if Length != Bytesˉlength(Expected) { return false; }
    var Index: u32 = 0u32;
    while Index < Length {
        if Bytesˉreadˉu8(Actual, Index) != Bytesˉreadˉu8(Expected, Index) {
            return false;
        }
        Index = Index + 1u32;
    }
    return true;
}

fn Emitˉlines(Value: bytes, Diagnostic: bool) -> bool {
    var Lineˉoffset: u32 = 0u32;
    var Cursor: u32 = 0u32;
    let Length: u32 = Bytesˉlength(Value);
    while Cursor < Length {
        if U32ˉfromˉu8(Bytesˉreadˉu8(Value, Cursor)) == 10u32 {
            let Line: bytes = Bytesˉslice(
                Value,
                Lineˉoffset,
                Cursor - Lineˉoffset
            );
            if !Textˉutf8ˉisˉvalid(Line) { return false; }
            if Diagnostic {
                diagnostic.write_line(Textˉfromˉutf8(Line));
            } else {
                console.write_line(Textˉfromˉutf8(Line));
            }
            Lineˉoffset = Cursor + 1u32;
        }
        Cursor = Cursor + 1u32;
    }
    return Lineˉoffset == Length;
}

fn Runˉscript(Module: bytes, Arguments: u32) -> i32 {
    if !Moduleˉisˉadmitted(Module) {
        return Reportˉcompilerˉverificationˉfailure();
    }
    let Request: bytes = Buildˉscriptˉrequest(Module, Arguments);
    if Bytesˉlength(Request) == 0u32 {
        diagnostic.write_line(
            "wvb run status=Invalidˉargumentˉsnapshot"
        );
        return 64;
    }
    let Response: bytes = Interpreter.Main(Request);
    if Bytesˉlength(Response) < 28u32 {
        var Phase: text = "execution";
        if Bytesˉlength(Envelopeˉreader.Interpreterˉenvelope(Request))
            < 64u32 {
            Phase = "envelope";
        }
        diagnostic.write_line(Textˉconcat(
            "wvb run status=Unsupported profile=script-main-i32 phase=",
            Phase
        ));
        return 1;
    }
    if Bytesˉreadˉu32ˉlittle(Response, 0u32) != 1331189335u32 ||
        Bytesˉreadˉu16ˉlittle(Response, 4u32) != 4u32 ||
        Bytesˉreadˉu16ˉlittle(Response, 6u32) != 0u32 {
        diagnostic.write_line("wvb run status=Invalidˉresponse");
        return 1;
    }
    let Standardˉoutputˉlength: u32 = Bytesˉreadˉu32ˉlittle(
        Response,
        20u32
    );
    let Diagnosticˉoutputˉlength: u32 = Bytesˉreadˉu32ˉlittle(
        Response,
        24u32
    );
    if Standardˉoutputˉlength > Bytesˉlength(Response) - 28u32 {
        diagnostic.write_line("wvb run status=Invalidˉresponse");
        return 1;
    }
    if Diagnosticˉoutputˉlength
        != Bytesˉlength(Response) - 28u32 - Standardˉoutputˉlength {
        diagnostic.write_line("wvb run status=Invalidˉresponse");
        return 1;
    }
    if !Emitˉlines(
        Bytesˉslice(Response, 28u32, Standardˉoutputˉlength),
        false
    ) {
        diagnostic.write_line("wvb run status=Invalidˉresponse");
        return 1;
    }
    if !Emitˉlines(
        Bytesˉslice(
            Response,
            28u32 + Standardˉoutputˉlength,
            Diagnosticˉoutputˉlength
        ),
        true
    ) {
        diagnostic.write_line("wvb run status=Invalidˉresponse");
        return 1;
    }
    let Status: u32 = Bytesˉreadˉu32ˉlittle(Response, 8u32);
    if Status != 0u32 {
        Reportˉfailure(
            Status,
            Bytesˉreadˉu32ˉlittle(Response, 12u32)
        );
        return 1;
    }
    let Result: i32 = Bytesˉreadˉi32ˉlittle(Response, 16u32);
    if Result < 0 || Result > 255 {
        diagnostic.write_line("wvb run status=Invalidˉexitˉstatus");
        return 1;
    }
    return Result;
}

fn Runˉcontextˉentry(
    Request: bytes,
    Profile: text,
    Responseˉmajor: u32,
    Responseˉminor: u32,
    Reportˉresult: bool,
    Emitˉoutput: bool
) -> i32 {
    let Response: bytes = Interpreter.Main(Request);
    var Invalidˉlength: bool = Bytesˉlength(Response) != 20u32;
    if Emitˉoutput { Invalidˉlength = Bytesˉlength(Response) < 28u32; }
    if Invalidˉlength {
        var Phase: text = "execution";
        if Bytesˉlength(Envelopeˉreader.Interpreterˉenvelope(Request))
            < 64u32 {
            Phase = "envelope";
        }
        diagnostic.write_line(Textˉconcat(
            Textˉconcat("wvb run status=Unsupported profile=", Profile),
            Textˉconcat(" phase=", Phase)
        ));
        return 1;
    }
    if Bytesˉreadˉu32ˉlittle(Response, 0u32) != 1331189335u32 ||
        Bytesˉreadˉu16ˉlittle(Response, 4u32) != Responseˉmajor ||
        Bytesˉreadˉu16ˉlittle(Response, 6u32) != Responseˉminor {
        diagnostic.write_line("wvb run status=Invalidˉresponse");
        return 1;
    }
    if Emitˉoutput {
        let Standardˉoutputˉlength: u32 = Bytesˉreadˉu32ˉlittle(
            Response, 20u32
        );
        let Diagnosticˉoutputˉlength: u32 = Bytesˉreadˉu32ˉlittle(
            Response, 24u32
        );
        if Standardˉoutputˉlength > Bytesˉlength(Response) - 28u32 ||
            Diagnosticˉoutputˉlength != Bytesˉlength(Response) - 28u32
                - Standardˉoutputˉlength {
            diagnostic.write_line("wvb run status=Invalidˉresponse");
            return 1;
        }
        if !Emitˉlines(
                Bytesˉslice(Response, 28u32, Standardˉoutputˉlength),
                false
            ) ||
            !Emitˉlines(
                Bytesˉslice(
                    Response,
                    28u32 + Standardˉoutputˉlength,
                    Diagnosticˉoutputˉlength
                ),
                true
            ) {
            diagnostic.write_line("wvb run status=Invalidˉresponse");
            return 1;
        }
    }
    let Status: u32 = Bytesˉreadˉu32ˉlittle(Response, 8u32);
    if Status != 0u32 {
        Reportˉfailure(
            Status,
            Bytesˉreadˉu32ˉlittle(Response, 12u32)
        );
        return 1;
    }
    let Result: i32 = Bytesˉreadˉi32ˉlittle(Response, 16u32);
    if Result < 0 || Result > 255 {
        diagnostic.write_line("wvb run status=Invalidˉexitˉstatus");
        return 1;
    }
    if Reportˉresult {
        console.write_line(Textˉconcat(
            "Result: ",
            Textˉfromˉutf8(Formatting.Interpreterˉformatˉinteger(
                Bytesˉconcat(
                    Bytesˉfromˉu8(1u8),
                    Bytesˉconcat(
                        Bytesˉslice(Response, 16u32, 4u32),
                        Bytesˉfromˉu32ˉlittle(0u32)
                    )
                )
            ))
        ));
        return 0;
    }
    return Result;
}

fn Runˉsourceˉfile(Module: bytes, Snapshot: bytes) -> i32 {
    if !Moduleˉisˉadmitted(Module) {
        return Reportˉcompilerˉverificationˉfailure();
    }
    if Bytesˉlength(Snapshot) > 1048576u32 {
        diagnostic.write_line("wvb run status=Sourceˉsnapshotˉtooˉlarge");
        return 64;
    }
    return Runˉcontextˉentry(
        Buildˉsourceˉfileˉrequest(Module, Snapshot),
        "source-file-main-i32",
        5u32,
        0u32,
        false,
        false
    );
}

fn Runˉstructuredˉtask(
    Module: bytes,
    Environment: Taskˉenvironment
) -> i32 {
    if !Moduleˉisˉadmitted(Module) {
        return Reportˉcompilerˉverificationˉfailure();
    }
    let Includeˉoutput: bool = Isˉstructuredˉtaskˉoutputˉmodule(Module);
    if Includeˉoutput {
        return Runˉcontextˉentry(
            Buildˉstructuredˉtaskˉrequest(Module, Environment, true),
            "structured-task-main-i32",
            6u32,
            2u32,
            true,
            true
        );
    }
    return Runˉcontextˉentry(
        Buildˉstructuredˉtaskˉrequest(Module, Environment, false),
        "structured-task-main-i32",
        6u32,
        0u32,
        true,
        false
    );
}

fn Isˉstructuredˉtaskˉmodule(Module: bytes) -> bool {
    return Bytesˉlength(Module) >= 21u32 &&
        Bytesˉreadˉu16ˉlittle(Module, 4u32) == 1u32 &&
        Bytesˉreadˉu16ˉlittle(Module, 6u32) == 32u32 &&
        Bytesˉreadˉu32ˉlittle(Module, 8u32) == 7u32 &&
        Bytesˉreadˉu32ˉlittle(Module, 12u32) == 1u32 &&
        Bytesˉreadˉu32ˉlittle(Module, 16u32) >= 1u32 &&
        U32ˉfromˉu8(Bytesˉreadˉu8(Module, 20u32)) == 2u32;
}

fn Isˉstructuredˉtaskˉoutputˉmodule(Module: bytes) -> bool {
    if !Isˉstructuredˉtaskˉmodule(Module) || Bytesˉlength(Module) < 32u32 {
        return false;
    }
    let Firstˉpayloadˉlength: u32 = Bytesˉreadˉu32ˉlittle(Module, 16u32);
    if Firstˉpayloadˉlength > Bytesˉlength(Module) - 20u32 {
        return false;
    }
    let Capabilityˉheader: u32 = 20u32 + Firstˉpayloadˉlength;
    if Capabilityˉheader > Bytesˉlength(Module) - 12u32 {
        return false;
    }
    let Capabilityˉpayloadˉlength: u32 = Bytesˉreadˉu32ˉlittle(
        Module, Capabilityˉheader + 4u32
    );
    if Capabilityˉpayloadˉlength < 4u32 ||
        Capabilityˉpayloadˉlength > Bytesˉlength(Module)
            - Capabilityˉheader - 8u32 {
        return false;
    }
    return Bytesˉreadˉu32ˉlittle(Module, Capabilityˉheader + 8u32) != 0u32;
}

export fn Main() -> i32 {
    let Arguments: u32 = process.argument_count();
    if Arguments == 0u32 {
        diagnostic.write_line("Usage: wvrun <module.wvb> [--report-steps]");
        return 64;
    }
    if Isˉscriptˉmode(process.argument(0u32)) {
        if Arguments < 2u32 {
            diagnostic.write_line("Usage: wvrun --script <module.wvb> [argument ...]");
            return 64;
        }
        return Runˉscript(
            file.read_bytes(process.argument(1u32)),
            Arguments
        );
    }
    if Isˉsourceˉfileˉmode(process.argument(0u32)) {
        if Arguments != 3u32 {
            diagnostic.write_line(
                "Usage: wvrun --source-file <module.wvb> <snapshot-file>"
            );
            return 64;
        }
        return Runˉsourceˉfile(
            file.read_bytes(process.argument(1u32)),
            file.read_bytes(process.argument(2u32))
        );
    }
    if Isˉtaskˉenvironmentˉmode(process.argument(0u32)) {
        if Arguments != 9u32 {
            diagnostic.write_line(
                Textˉconcat(
                    "Usage: wvrun --task-environment <module.wvb> ",
                    Textˉconcat(
                        "<context-generation> <clock-generation> <deadline> ",
                        Textˉconcat(
                            "<expected-runtime-generation> ",
                            Textˉconcat(
                                "<admitted-runtime-generation> ",
                                Textˉconcat(
                                    "<observation-tick> ",
                                    "<observed-runtime-generation>"
                                )
                            )
                        )
                    )
                )
            );
            return 64;
        }
        let Environment: Taskˉenvironment = Parseˉtaskˉenvironment();
        if !Environment.Valid {
            diagnostic.write_line(
                "wvb run status=Invalidˉtaskˉenvironment"
            );
            return 64;
        }
        return Runˉstructuredˉtask(
            file.read_bytes(process.argument(1u32)),
            Environment
        );
    }
    if Arguments > 2u32 {
        diagnostic.write_line("Usage: wvrun <module.wvb> [--report-steps]");
        return 64;
    }
    var Reportˉsteps: bool = false;
    if Arguments == 2u32 {
        if !Isˉreportˉsteps(process.argument(1u32)) {
            diagnostic.write_line("Usage: wvrun <module.wvb> [--report-steps]");
            return 64;
        }
        Reportˉsteps = true;
    }

    let Module: bytes = file.read_bytes(process.argument(0u32));
    if Isˉstructuredˉtaskˉmodule(Module) {
        return Runˉstructuredˉtask(Module, Defaultˉtaskˉenvironment());
    }
    if !Moduleˉisˉadmitted(Module) {
        return Reportˉcompilerˉverificationˉfailure();
    }
    let Request: bytes = Buildˉrequest(Module);
    let Response: bytes = Interpreter.Main(Request);
    if Bytesˉlength(Response) != 20u32 {
        var Phase: text = "execution";
        if Bytesˉlength(Envelopeˉreader.Interpreterˉenvelope(Request)) < 64u32 {
            Phase = "envelope";
        }
        diagnostic.write_line(
            Textˉconcat(
                "wvb run status=Unsupported profile=portable-main-i32 phase=",
                Phase
            )
        );
        return 1;
    }
    if Bytesˉreadˉu32ˉlittle(Response, 0u32) != 1331189335u32 {
        diagnostic.write_line("wvb run status=Invalidˉresponse");
        return 1;
    }
    if Bytesˉreadˉu16ˉlittle(Response, 4u32) != 1u32 {
        diagnostic.write_line("wvb run status=Invalidˉresponse");
        return 1;
    }
    if Bytesˉreadˉu16ˉlittle(Response, 6u32) != 0u32 {
        diagnostic.write_line("wvb run status=Invalidˉresponse");
        return 1;
    }

    let Status: u32 = Bytesˉreadˉu32ˉlittle(Response, 8u32);
    let Instructions: u32 = Bytesˉreadˉu32ˉlittle(Response, 12u32);
    if Status != 0u32 {
        Reportˉfailure(Status, Instructions);
        return 1;
    }
    console.write_line(Textˉconcat(
        "Result: ",
        Textˉfromˉutf8(Formatting.Interpreterˉformatˉinteger(
            Bytesˉconcat(
                Bytesˉfromˉu8(1u8),
                Bytesˉconcat(
                    Bytesˉslice(Response, 16u32, 4u32),
                    Bytesˉfromˉu32ˉlittle(0u32)
                )
            )
        ))
    ));
    if Reportˉsteps {
        console.write_line(Textˉconcat(
            "Instructions: ",
            U32ˉformat(Instructions)
        ));
    }
    return 0;
}
