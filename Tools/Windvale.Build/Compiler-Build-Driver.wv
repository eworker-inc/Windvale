module Windvaleˉcompilerˉbuildˉdriver profile hosted;

import Compilerˉsourceˉwvb as Sourceˉwvb;
import Compilerˉsourceˉwir as Sourceˉwir;
import Compilerˉsourceˉsymbols as Sourceˉsymbols;
import Compilerˉsourceˉset as Sourceˉset;
import Windvaleˉcompilerˉwvbˉverifierˉsemantic as Semanticˉverifier;
import Windvaleˉproject as Project;

capability console.write_line;
capability diagnostic.write_line;
capability file.read_bytes;
capability file.write_bytes;
capability process.argument;
capability process.argument_count;

fn Compilerˉbuildˉdriverˉempty() -> bytes {
    return Textˉtoˉutf8("");
}

fn Compilerˉbuildˉdriverˉheader(Modules: u32) -> bytes {
    var Header: bytes = Textˉtoˉutf8("WVSS");
    Header = Bytesˉconcat(Header, Bytesˉfromˉu16ˉlittle(1u32));
    Header = Bytesˉconcat(Header, Bytesˉfromˉu16ˉlittle(0u32));
    Header = Bytesˉconcat(Header, Bytesˉfromˉu32ˉlittle(Modules));
    return Bytesˉconcat(Header, Bytesˉfromˉu32ˉlittle(Modules * 8u32));
}

fn Compilerˉbuildˉdriverˉexplicitˉinput(Modules: u32) -> bytes {
    let Headerˉbytes: u32 = 16u32 + Modules * 8u32;
    var Directory: bytes = Compilerˉbuildˉdriverˉempty();
    var Payload: bytes = Compilerˉbuildˉdriverˉempty();
    var Payloadˉbytes: u32 = 0u32;
    var Index: u32 = 0u32;
    while Index < Modules {
        let Source: bytes = file.read_bytes(process.argument(Index));
        let Length: u32 = Bytesˉlength(Source);
        if Length == 0u32 { return Compilerˉbuildˉdriverˉempty(); }
        if Payloadˉbytes > 4194304u32 - Headerˉbytes {
            return Compilerˉbuildˉdriverˉempty();
        }
        if Length > 4194304u32 - Headerˉbytes - Payloadˉbytes {
            return Compilerˉbuildˉdriverˉempty();
        }
        Directory = Bytesˉconcat(
            Directory, Bytesˉfromˉu32ˉlittle(Headerˉbytes + Payloadˉbytes)
        );
        Directory = Bytesˉconcat(Directory, Bytesˉfromˉu32ˉlittle(Length));
        Payload = Bytesˉconcat(Payload, Source);
        Payloadˉbytes = Payloadˉbytes + Length;
        Index = Index + 1u32;
    }
    return Bytesˉconcat(
        Bytesˉconcat(Compilerˉbuildˉdriverˉheader(Modules), Directory), Payload
    );
}

fn Compilerˉbuildˉdriverˉasciiˉfold(Value: u8) -> u32 {
    let Character: u32 = U32ˉfromˉu8(Value);
    if Character >= 65u32 {
        if Character <= 90u32 { return Character + 32u32; }
    }
    return Character;
}

fn Compilerˉbuildˉdriverˉresourceˉequals(First: bytes, Second: bytes) -> bool {
    let Length: u32 = Bytesˉlength(First);
    if Length != Bytesˉlength(Second) { return false; }
    var Index: u32 = 0u32;
    while Index < Length {
        if Compilerˉbuildˉdriverˉasciiˉfold(Bytesˉreadˉu8(First, Index)) !=
            Compilerˉbuildˉdriverˉasciiˉfold(Bytesˉreadˉu8(Second, Index)) {
            return false;
        }
        Index = Index + 1u32;
    }
    return true;
}

fn Compilerˉbuildˉdriverˉhasˉsuffix(Value: bytes, Suffix: text) -> bool {
    let Suffixˉbytes: bytes = Textˉtoˉutf8(Suffix);
    let Valueˉlength: u32 = Bytesˉlength(Value);
    let Suffixˉlength: u32 = Bytesˉlength(Suffixˉbytes);
    if Valueˉlength < Suffixˉlength { return false; }
    return Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(
        Value, Valueˉlength - Suffixˉlength, Suffixˉlength, Suffix
    );
}

fn Compilerˉbuildˉdriverˉresourceˉnameˉisˉvalid(Resourceˉname: bytes) -> bool {
    let Length: u32 = Bytesˉlength(Resourceˉname);
    var Index: u32 = 0u32;
    while Index < Length {
        if Bytesˉreadˉu8(Resourceˉname, Index) == 92u8 { return false; }
        Index = Index + 1u32;
    }
    return true;
}

fn Compilerˉbuildˉdriverˉderiveˉresourceˉprefix(Resourceˉname: bytes) -> bytes {
    let Length: u32 = Bytesˉlength(Resourceˉname);
    var Prefixˉbytes: u32 = 0u32;
    var Index: u32 = 0u32;
    while Index < Length {
        let Character: u8 = Bytesˉreadˉu8(Resourceˉname, Index);
        if Character == 47u8 { Prefixˉbytes = Index + 1u32; }
        Index = Index + 1u32;
    }
    return Bytesˉslice(Resourceˉname, 0u32, Prefixˉbytes);
}

fn Compilerˉbuildˉdriverˉprojectˉresource(
    Prefix: bytes,
    Path: Project.Windvaleˉprojectˉpath
) -> bytes {
    return Bytesˉconcat(Prefix, Path.Value);
}

fn Compilerˉbuildˉdriverˉcheckˉprojectˉpaths(
    Manifest: bytes,
    Scan: Project.Windvaleˉprojectˉscan,
    Prefix: bytes,
    Manifestˉname: bytes,
    Outputˉname: bytes
) -> bytes {
    if Compilerˉbuildˉdriverˉresourceˉequals(Manifestˉname, Outputˉname) {
        return Bytesˉfromˉu32ˉlittle(1u32);
    }
    var Index: u32 = 0u32;
    while Index < Scan.Modules {
        let Path: Project.Windvaleˉprojectˉpath = Project.Windvaleˉprojectˉpathˉat(
            Manifest, Scan, Index
        );
        if !Path.Found {
            var Missing: bytes = Bytesˉfromˉu32ˉlittle(2u32);
            Missing = Bytesˉconcat(Missing, Bytesˉfromˉu32ˉlittle(Path.Line));
            return Bytesˉconcat(Missing, Bytesˉfromˉu32ˉlittle(Path.Column));
        }
        let Resource: bytes = Compilerˉbuildˉdriverˉprojectˉresource(Prefix, Path);
        if Compilerˉbuildˉdriverˉresourceˉequals(Resource, Outputˉname) {
            return Bytesˉfromˉu32ˉlittle(1u32);
        }
        var Previousˉindex: u32 = 0u32;
        while Previousˉindex < Index {
            let Previousˉpath: Project.Windvaleˉprojectˉpath = Project.Windvaleˉprojectˉpathˉat(
                Manifest, Scan, Previousˉindex
            );
            let Previousˉresource: bytes = Compilerˉbuildˉdriverˉprojectˉresource(
                Prefix, Previousˉpath
            );
            if Compilerˉbuildˉdriverˉresourceˉequals(
                Resource, Previousˉresource
            ) {
                var Duplicate: bytes = Bytesˉfromˉu32ˉlittle(2u32);
                Duplicate = Bytesˉconcat(
                    Duplicate, Bytesˉfromˉu32ˉlittle(Path.Line)
                );
                return Bytesˉconcat(
                    Duplicate, Bytesˉfromˉu32ˉlittle(Path.Column)
                );
            }
            Previousˉindex = Previousˉindex + 1u32;
        }
        Index = Index + 1u32;
    }
    return Bytesˉfromˉu32ˉlittle(0u32);
}

fn Compilerˉbuildˉdriverˉprojectˉinput(
    Manifest: bytes,
    Scan: Project.Windvaleˉprojectˉscan,
    Prefix: bytes
) -> bytes {
    let Headerˉbytes: u32 = 16u32 + Scan.Modules * 8u32;
    var Directory: bytes = Compilerˉbuildˉdriverˉempty();
    var Payload: bytes = Compilerˉbuildˉdriverˉempty();
    var Payloadˉbytes: u32 = 0u32;
    var Index: u32 = 0u32;
    while Index < Scan.Modules {
        let Path: Project.Windvaleˉprojectˉpath = Project.Windvaleˉprojectˉpathˉat(
            Manifest, Scan, Index
        );
        let Resource: bytes = Compilerˉbuildˉdriverˉprojectˉresource(Prefix, Path);
        let Source: bytes = file.read_bytes(Textˉfromˉutf8(Resource));
        let Length: u32 = Bytesˉlength(Source);
        if Length == 0u32 { return Compilerˉbuildˉdriverˉempty(); }
        if Payloadˉbytes > 4194304u32 - Headerˉbytes {
            return Compilerˉbuildˉdriverˉempty();
        }
        if Length > 4194304u32 - Headerˉbytes - Payloadˉbytes {
            return Compilerˉbuildˉdriverˉempty();
        }
        Directory = Bytesˉconcat(
            Directory, Bytesˉfromˉu32ˉlittle(Headerˉbytes + Payloadˉbytes)
        );
        Directory = Bytesˉconcat(Directory, Bytesˉfromˉu32ˉlittle(Length));
        Payload = Bytesˉconcat(Payload, Source);
        Payloadˉbytes = Payloadˉbytes + Length;
        Index = Index + 1u32;
    }
    return Bytesˉconcat(
        Bytesˉconcat(Compilerˉbuildˉdriverˉheader(Scan.Modules), Directory), Payload
    );
}

fn Compilerˉbuildˉdriverˉprojectˉfailure(
    Status: Project.Windvaleˉprojectˉstatus,
    Line: u32,
    Column: u32
) -> text {
    var Report: text = "build status=Projectˉrejected code=";
    Report = Textˉconcat(Report, Project.Windvaleˉprojectˉdiagnosticˉcode(Status));
    Report = Textˉconcat(Report, " line=");
    Report = Textˉconcat(Report, U32ˉformat(Line));
    Report = Textˉconcat(Report, " column=");
    return Textˉconcat(Report, U32ˉformat(Column));
}

fn Compilerˉbuildˉdriverˉcompileˉfailure(
    Input: bytes,
    Summary: Sourceˉwvb.Compilerˉsourceˉwvbˉsummary
) -> text {
    let Sourceˉsetˉsummary: Sourceˉset.Compilerˉsourceˉsetˉsummary =
        Sourceˉset.Compilerˉvalidateˉsourceˉset(Input);
    let Wir: Sourceˉwir.Compilerˉsourceˉwirˉsummary =
        Sourceˉwir.Compilerˉvalidateˉsourceˉwir(Input);
    let Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary =
        Sourceˉsymbols.Compilerˉvalidateˉsourceˉsymbols(Input);
    var Report: text = "build status=Compileˉrejected source-status=";
    Report = Textˉconcat(Report, Enumˉname(Summary.Status));
    Report = Textˉconcat(Report, " wir-status=");
    Report = Textˉconcat(Report, Enumˉname(Summary.Wirˉstatus));
    Report = Textˉconcat(Report, " function=");
    Report = Textˉconcat(Report, U32ˉformat(Summary.Failureˉfunction));
    Report = Textˉconcat(Report, " operation=");
    Report = Textˉconcat(Report, U32ˉformat(Summary.Failureˉoperation));
    Report = Textˉconcat(Report, " binding-status=");
    Report = Textˉconcat(Report, Enumˉname(Wir.Bindingˉstatus));
    Report = Textˉconcat(Report, " symbol-status=");
    Report = Textˉconcat(Report, Enumˉname(Symbols.Status));
    Report = Textˉconcat(Report, " graph-status=");
    Report = Textˉconcat(Report, Enumˉname(Symbols.Graphˉstatus));
    Report = Textˉconcat(Report, " source-set-status=");
    Report = Textˉconcat(Report, Enumˉname(Sourceˉsetˉsummary.Status));
    Report = Textˉconcat(Report, " parse-status=");
    Report = Textˉconcat(Report, Enumˉname(Sourceˉsetˉsummary.Parseˉstatus));
    Report = Textˉconcat(Report, " body-status=");
    Report = Textˉconcat(Report, Enumˉname(Sourceˉsetˉsummary.Bodyˉstatus));
    Report = Textˉconcat(Report, " declaration=");
    Report = Textˉconcat(Report, Enumˉname(Symbols.Failureˉkind));
    Report = Textˉconcat(Report, " module=");
    Report = Textˉconcat(Report, U32ˉformat(Wir.Failureˉmodule));
    Report = Textˉconcat(Report, " related-module=");
    Report = Textˉconcat(Report, U32ˉformat(Wir.Failureˉrelatedˉmodule));
    Report = Textˉconcat(Report, " line=");
    Report = Textˉconcat(Report, U32ˉformat(Wir.Failureˉline));
    Report = Textˉconcat(Report, " column=");
    return Textˉconcat(Report, U32ˉformat(Wir.Failureˉcolumn));
}

fn Compilerˉbuildˉdriverˉsuccess(
    Summary: Sourceˉwvb.Compilerˉsourceˉwvbˉsummary
) -> text {
    var Report: text = "build status=Published verification=compiler-aligned functions=";
    Report = Textˉconcat(Report, U32ˉformat(Summary.Functions));
    Report = Textˉconcat(Report, " code-bytes=");
    Report = Textˉconcat(Report, U32ˉformat(Summary.Codeˉbytes));
    Report = Textˉconcat(Report, " module-bytes=");
    return Textˉconcat(Report, U32ˉformat(Bytesˉlength(Summary.Bytecode)));
}

fn Compilerˉbuildˉdriverˉpublish(Input: bytes, Outputˉpath: text) -> i32 {
    let Summary: Sourceˉwvb.Compilerˉsourceˉwvbˉsummary =
        Sourceˉwvb.Compilerˉcompileˉsourceˉwvb(Input);
    if Summary.Status != Sourceˉwvb.Compilerˉsourceˉwvbˉstatus.Valid {
        diagnostic.write_line(
            Compilerˉbuildˉdriverˉcompileˉfailure(Input, Summary)
        );
        return 1;
    }

    let Verification: u32 = Semanticˉverifier.Compilerˉwvbˉverify(Summary.Bytecode);
    if Verification != 0u32 {
        if Verification == 1u32 {
            diagnostic.write_line("build status=Verifierˉrejected phase=semantic");
        } else {
            if Verification == 2u32 {
                diagnostic.write_line("build status=Verifierˉrejected phase=typed-execution");
            } else {
                diagnostic.write_line("build status=Verifierˉrejected phase=control-reachability");
            }
        }
        return 1;
    }

    file.write_bytes(Outputˉpath, Summary.Bytecode);
    console.write_line(Compilerˉbuildˉdriverˉsuccess(Summary));
    return 0;
}

fn Compilerˉbuildˉdriverˉargumentˉequals(Value: text, Expected: text) -> bool {
    let Bytes: bytes = Textˉtoˉutf8(Value);
    return Sourceˉsymbols.Compilerˉsourceˉsymbolsˉnameˉequals(
        Bytes, 0u32, Bytesˉlength(Bytes), Expected
    );
}

fn Compilerˉbuildˉdriverˉrunˉproject(Arguments: u32) -> i32 {
    if Arguments != 5u32 {
        diagnostic.write_line(
            "Usage: wvbuild --workspace <workspace.wvws> --project <project.wvproj> <output.wvb>"
        );
        return 64;
    }
    if !Compilerˉbuildˉdriverˉargumentˉequals(
        process.argument(2u32), "--project"
    ) {
        diagnostic.write_line(
            "Usage: wvbuild --workspace <workspace.wvws> --project <project.wvproj> <output.wvb>"
        );
        return 64;
    }
    let Workspaceˉpath: text = process.argument(1u32);
    let Manifestˉpath: text = process.argument(3u32);
    let Outputˉpath: text = process.argument(4u32);
    let Workspaceˉname: bytes = Textˉtoˉutf8(Workspaceˉpath);
    let Manifestˉname: bytes = Textˉtoˉutf8(Manifestˉpath);
    let Outputˉname: bytes = Textˉtoˉutf8(Outputˉpath);
    if !Compilerˉbuildˉdriverˉhasˉsuffix(Workspaceˉname, ".wvws") {
        diagnostic.write_line(
            "build status=Invalidˉinvocation reason=workspace-extension"
        );
        return 64;
    }
    if !Compilerˉbuildˉdriverˉhasˉsuffix(Manifestˉname, ".wvproj") {
        diagnostic.write_line(
            "build status=Invalidˉinvocation reason=project-extension"
        );
        return 64;
    }
    if !Compilerˉbuildˉdriverˉhasˉsuffix(Outputˉname, ".wvb") {
        diagnostic.write_line(
            "build status=Invalidˉinvocation reason=output-extension"
        );
        return 64;
    }
    if Compilerˉbuildˉdriverˉresourceˉequals(Workspaceˉname, Outputˉname) {
        diagnostic.write_line(
            "build status=Invalidˉinvocation reason=output-is-input"
        );
        return 64;
    }
    if !Compilerˉbuildˉdriverˉresourceˉnameˉisˉvalid(Workspaceˉname) {
        diagnostic.write_line(
            "build status=Invalidˉinvocation reason=workspace-resource-name"
        );
        return 64;
    }
    let Prefix: bytes = Compilerˉbuildˉdriverˉderiveˉresourceˉprefix(
        Workspaceˉname
    );
    let Prefixˉlength: u32 = Bytesˉlength(Prefix);
    var Manifestˉinsideˉworkspace: bool =
        Bytesˉlength(Manifestˉname) > Prefixˉlength;
    if Manifestˉinsideˉworkspace {
        Manifestˉinsideˉworkspace = Compilerˉbuildˉdriverˉresourceˉequals(
            Bytesˉslice(Manifestˉname, 0u32, Prefixˉlength), Prefix
        );
    }
    if !Manifestˉinsideˉworkspace {
        diagnostic.write_line(
            "build status=Workspaceˉrejected code=WVW1003 line=1 column=1"
        );
        return 1;
    }

    let Workspaceˉmanifest: bytes = file.read_bytes(Workspaceˉpath);
    let Workspaceˉlength: u32 = Bytesˉlength(Workspaceˉmanifest);
    var Workspaceˉheaderˉvalid: bool = Workspaceˉlength >= 20u32;
    if Workspaceˉheaderˉvalid {
        Workspaceˉheaderˉvalid = Project.Windvaleˉprojectˉspanˉequalsˉtext(
            Workspaceˉmanifest, 0u32, 20u32, "windvale-workspace 1"
        );
    }
    if !Workspaceˉheaderˉvalid {
        diagnostic.write_line(
            "build status=Workspaceˉrejected code=WVW1001 line=1 column=1"
        );
        return 1;
    }
    var Workspaceˉtextˉvalid: bool = Workspaceˉlength == 20u32;
    if Workspaceˉlength == 21u32 {
        Workspaceˉtextˉvalid = Bytesˉreadˉu8(Workspaceˉmanifest, 20u32) == 10u8;
    }
    if Workspaceˉlength == 22u32 {
        Workspaceˉtextˉvalid =
            Bytesˉreadˉu8(Workspaceˉmanifest, 20u32) == 13u8 &&
            Bytesˉreadˉu8(Workspaceˉmanifest, 21u32) == 10u8;
    }
    if !Workspaceˉtextˉvalid {
        diagnostic.write_line(
            "build status=Workspaceˉrejected code=WVW1002 line=1 column=21"
        );
        return 1;
    }

    let Manifest: bytes = file.read_bytes(Manifestˉpath);
    let Scan: Project.Windvaleˉprojectˉscan =
        Project.Windvaleˉprojectˉscanˉmanifest(Manifest);
    if Scan.Status != Project.Windvaleˉprojectˉstatus.Valid {
        diagnostic.write_line(Compilerˉbuildˉdriverˉprojectˉfailure(
            Scan.Status, Scan.Failureˉline, Scan.Failureˉcolumn
        ));
        return 1;
    }
    if Scan.Modules > 63u32 {
        let Excess: Project.Windvaleˉprojectˉpath = Project.Windvaleˉprojectˉpathˉat(
            Manifest, Scan, 63u32
        );
        diagnostic.write_line(Compilerˉbuildˉdriverˉprojectˉfailure(
            Project.Windvaleˉprojectˉstatus.Sourceˉlimit, Excess.Line, Excess.Column
        ));
        return 1;
    }

    let Paths: bytes =
        Compilerˉbuildˉdriverˉcheckˉprojectˉpaths(
            Manifest,
            Scan,
            Prefix,
            Manifestˉname,
            Outputˉname
        );
    let Pathsˉstatus: u32 = Bytesˉreadˉu32ˉlittle(Paths, 0u32);
    if Pathsˉstatus != 0u32 {
        if Pathsˉstatus == 1u32 {
            diagnostic.write_line(
                "build status=Invalidˉinvocation reason=output-is-input"
            );
            return 64;
        }
        diagnostic.write_line(Compilerˉbuildˉdriverˉprojectˉfailure(
            Project.Windvaleˉprojectˉstatus.Duplicateˉpath,
            Bytesˉreadˉu32ˉlittle(Paths, 4u32),
            Bytesˉreadˉu32ˉlittle(Paths, 8u32)
        ));
        return 1;
    }

    return Compilerˉbuildˉdriverˉpublish(
        Compilerˉbuildˉdriverˉprojectˉinput(Manifest, Scan, Prefix),
        Outputˉpath
    );
}

fn Compilerˉbuildˉdriverˉrunˉexplicit(Arguments: u32) -> i32 {
    if Arguments < 2u32 {
        diagnostic.write_line(
            "Usage: wvbuild <root.wv> [dependency.wv ...] <output.wvb>"
        );
        return 64;
    }
    let Modules: u32 = Arguments - 1u32;
    if Modules > 64u32 {
        diagnostic.write_line("build status=Invalidˉinvocation reason=module-limit");
        return 64;
    }
    let Outputˉpath: text = process.argument(Modules);
    let Outputˉname: bytes = Textˉtoˉutf8(Outputˉpath);
    var Inputˉindex: u32 = 0u32;
    while Inputˉindex < Modules {
        let Inputˉname: bytes = Textˉtoˉutf8(process.argument(Inputˉindex));
        if Compilerˉbuildˉdriverˉresourceˉequals(Inputˉname, Outputˉname) {
            diagnostic.write_line(
                "build status=Invalidˉinvocation reason=output-is-input"
            );
            return 64;
        }
        Inputˉindex = Inputˉindex + 1u32;
    }
    return Compilerˉbuildˉdriverˉpublish(
        Compilerˉbuildˉdriverˉexplicitˉinput(Modules), Outputˉpath
    );
}

export fn Main() -> i32 {
    let Arguments: u32 = process.argument_count();
    if Arguments > 0u32 {
        if Compilerˉbuildˉdriverˉargumentˉequals(
            process.argument(0u32), "--workspace"
        ) {
            return Compilerˉbuildˉdriverˉrunˉproject(Arguments);
        }
    }
    return Compilerˉbuildˉdriverˉrunˉexplicit(Arguments);
}
