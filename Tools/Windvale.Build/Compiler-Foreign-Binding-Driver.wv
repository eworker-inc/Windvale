module Windvaleˉcompilerˉforeignˉbindingˉdriver profile hosted;

import Compilerˉsourceˉforeignˉloweringˉbuilder as Loweringˉbuilder;
import Compilerˉsourceˉforeignˉloweringˉpairing as Pairing;
import Compilerˉsourceˉsymbols as Symbols;

capability console.write_line;
capability diagnostic.write_line;
capability file.read_bytes;
capability file.write_bytes;
capability process.argument;
capability process.argument_count;

fn Argumentˉequals(Value: text, Expected: text) -> bool {
    let Left: bytes = Textˉtoˉutf8(Value);
    let Right: bytes = Textˉtoˉutf8(Expected);
    if Bytesˉlength(Left) != Bytesˉlength(Right) { return false; }
    var Index: u32 = 0u32;
    while Index < Bytesˉlength(Left) {
        if Bytesˉreadˉu8(Left, Index) != Bytesˉreadˉu8(Right, Index) {
            return false;
        }
        Index = Index + 1u32;
    }
    return true;
}

fn Argumentsˉareˉdistinct(First: u32, Count: u32) -> bool {
    var Left: u32 = 0u32;
    while Left < Count {
        var Right: u32 = Left + 1u32;
        while Right < Count {
            if Argumentˉequals(
                    process.argument(First + Left),
                    process.argument(First + Right)
                ) {
                return false;
            }
            Right = Right + 1u32;
        }
        Left = Left + 1u32;
    }
    return true;
}

fn Argumentˉisˉpairˉanalysis(Value: text) -> bool {
    let Bytes: bytes = Textˉtoˉutf8(Value);
    return Bytesˉlength(Bytes) == 24u32 &&
        Bytesˉreadˉu32ˉlittle(Bytes, 0u32) == 1852386605u32 &&
        Bytesˉreadˉu32ˉlittle(Bytes, 4u32) == 1852990836u32 &&
        Bytesˉreadˉu32ˉlittle(Bytes, 8u32) == 1882025057u32 &&
        Bytesˉreadˉu32ˉlittle(Bytes, 12u32) == 762472801u32 &&
        Bytesˉreadˉu32ˉlittle(Bytes, 16u32) == 1818324577u32 &&
        Bytesˉreadˉu32ˉlittle(Bytes, 20u32) == 1936290681u32;
}

fn Pairˉanalysis() -> i32 {
    if Argumentˉequals(process.argument(1u32), process.argument(2u32)) ||
        Argumentˉequals(process.argument(1u32), process.argument(3u32)) ||
        Argumentˉequals(process.argument(2u32), process.argument(3u32)) {
        diagnostic.write_line(
            "foreign binding status=Invalidˉinvocation reason=paths-not-distinct"
        );
        return 64;
    }
    let Sourceˉset: bytes = file.read_bytes(process.argument(1u32));
    let Paired: Pairing.Compilerˉsourceˉforeignˉloweringˉpairingˉresult =
        Pairing.Compilerˉvalidateˉsourceˉforeignˉloweringˉpairing(
            file.read_bytes(process.argument(2u32)),
            Symbols.Compilerˉvalidateˉsourceˉsymbols(Sourceˉset),
            file.read_bytes(process.argument(3u32))
        );
    if Paired.Status !=
            Pairing.Compilerˉsourceˉforeignˉloweringˉpairingˉstatus.Valid {
        diagnostic.write_line(
            Textˉconcat(
                "foreign pairing status=",
                Enumˉname(Paired.Status)
            )
        );
        return 1;
    }
    var Report: text = "foreign pairing status=Validated records=";
    Report = Textˉconcat(Report, U32ˉformat(Paired.Records));
    Report = Textˉconcat(Report, " calls=");
    console.write_line(Textˉconcat(Report, U32ˉformat(Paired.Calls)));
    return 0;
}

fn Failure(
    Bound: Loweringˉbuilder.Compilerˉsourceˉforeignˉbindingˉsummary
) -> text {
    var Report: text = "foreign binding status=";
    Report = Textˉconcat(Report, Enumˉname(Bound.Status));
    Report = Textˉconcat(Report, " correspondence-status=");
    Report = Textˉconcat(Report, U32ˉformat(Bound.Correspondenceˉstatus));
    Report = Textˉconcat(Report, " target-status=");
    Report = Textˉconcat(Report, U32ˉformat(Bound.Targetˉstatus));
    Report = Textˉconcat(Report, " symbol-status=");
    Report = Textˉconcat(Report, Enumˉname(Bound.Symbolˉstatus));
    Report = Textˉconcat(Report, " binding-status=");
    Report = Textˉconcat(Report, U32ˉformat(Bound.Bindingˉstatus));
    Report = Textˉconcat(Report, " foreign-count=");
    Report = Textˉconcat(Report, U32ˉformat(Bound.Foreignˉcount));
    Report = Textˉconcat(Report, " failure-module=");
    Report = Textˉconcat(Report, U32ˉformat(Bound.Failureˉmodule));
    Report = Textˉconcat(Report, " failure-declaration=");
    Report = Textˉconcat(Report, U32ˉformat(Bound.Failureˉdeclaration));
    Report = Textˉconcat(Report, " failure-directory-entry=");
    Report = Textˉconcat(
        Report, U32ˉformat(Bound.Failureˉdirectoryˉentry)
    );
    Report = Textˉconcat(Report, " failure-catalog-record=");
    Report = Textˉconcat(Report, U32ˉformat(Bound.Failureˉcatalogˉrecord));
    Report = Textˉconcat(Report, " offset=");
    return Textˉconcat(Report, U32ˉformat(Bound.Failureˉoffset));
}

fn Publish(
    Sourceˉset: bytes,
    Target: bytes,
    Catalog: bytes,
    Bound: Loweringˉbuilder.Compilerˉsourceˉforeignˉbindingˉsummary,
    Outputˉargument: u32
) -> i32 {
    file.write_bytes(
        process.argument(Outputˉargument), Bound.Loweringˉcarrier
    );

    var Report: text = "foreign binding status=Published source-bytes=";
    Report = Textˉconcat(Report, U32ˉformat(Bytesˉlength(Sourceˉset)));
    Report = Textˉconcat(Report, " source-sha256=");
    Report = Textˉconcat(Report, Bytesˉsha256ˉhex(Sourceˉset));
    Report = Textˉconcat(Report, " target-bytes=");
    Report = Textˉconcat(Report, U32ˉformat(Bytesˉlength(Target)));
    Report = Textˉconcat(Report, " target-sha256=");
    Report = Textˉconcat(Report, Bytesˉsha256ˉhex(Target));
    Report = Textˉconcat(Report, " catalog-bytes=");
    Report = Textˉconcat(Report, U32ˉformat(Bytesˉlength(Catalog)));
    Report = Textˉconcat(Report, " catalog-sha256=");
    Report = Textˉconcat(Report, Bytesˉsha256ˉhex(Catalog));
    Report = Textˉconcat(Report, " carrier-bytes=");
    Report = Textˉconcat(
        Report, U32ˉformat(Bytesˉlength(Bound.Loweringˉcarrier))
    );
    Report = Textˉconcat(Report, " carrier-sha256=");
    Report = Textˉconcat(
        Report, Bytesˉsha256ˉhex(Bound.Loweringˉcarrier)
    );
    Report = Textˉconcat(Report, " foreign-count=");
    console.write_line(
        Textˉconcat(Report, U32ˉformat(Bound.Foreignˉcount))
    );
    return 0;
}

fn Bindˉanalyzed() -> i32 {
    if process.argument_count() != 6u32 {
        diagnostic.write_line(
            "Usage: wvbind --internal-bind-analyzed <input.wvss> <input.wvtd> <input.wvfc> <input.wvir> <output.wvfb>"
        );
        return 64;
    }
    if !Argumentsˉareˉdistinct(1u32, 5u32) {
        diagnostic.write_line(
            "foreign binding status=Invalidˉinvocation reason=paths-not-distinct"
        );
        return 64;
    }

    let Sourceˉset: bytes = file.read_bytes(process.argument(1u32));
    let Target: bytes = file.read_bytes(process.argument(2u32));
    let Catalog: bytes = file.read_bytes(process.argument(3u32));
    let Bound: Loweringˉbuilder.Compilerˉsourceˉforeignˉbindingˉsummary =
        Loweringˉbuilder.Compilerˉbuildˉsourceˉforeignˉloweringˉcarrier(
            Sourceˉset, Target, Catalog
        );
    if Bound.Status !=
            Loweringˉbuilder.Compilerˉsourceˉforeignˉbindingˉstatus.Valid {
        diagnostic.write_line(Failure(Bound));
        return 1;
    }

    let Symbolsˉresult: Symbols.Compilerˉsourceˉsymbolˉsummary =
        Symbols.Compilerˉvalidateˉsourceˉsymbols(Sourceˉset);
    let Paired: Pairing.Compilerˉsourceˉforeignˉloweringˉpairingˉresult =
        Pairing.Compilerˉvalidateˉsourceˉforeignˉloweringˉpairing(
            Bound.Loweringˉcarrier,
            Symbolsˉresult,
            file.read_bytes(process.argument(4u32))
        );
    if Paired.Status !=
            Pairing.Compilerˉsourceˉforeignˉloweringˉpairingˉstatus.Valid {
        diagnostic.write_line(
            Textˉconcat(
                "foreign binding status=Invalidˉanalyzedˉwir pairing-status=",
                Enumˉname(Paired.Status)
            )
        );
        return 1;
    }
    return Publish(Sourceˉset, Target, Catalog, Bound, 5u32);
}

export fn Main() -> i32 {
    if process.argument_count() == 4u32 &&
        Argumentˉisˉpairˉanalysis(process.argument(0u32)) {
        return Pairˉanalysis();
    }
    if process.argument_count() > 0u32 && Argumentˉequals(
            process.argument(0u32), "--internal-bind-analyzed"
        ) {
        return Bindˉanalyzed();
    }
    diagnostic.write_line(
        "Usage: wvbind --internal-bind-analyzed <input.wvss> <input.wvtd> <input.wvfc> <input.wvir> <output.wvfb>"
    );
    return 64;
}
