module Windvaleˉcompilerˉanalysisˉdriver profile hosted;

import Compilerˉsourceˉanalysis as Analysis;
import Compilerˉsourceˉanalysisˉcontract as Analysisˉcontract;
import Compilerˉsourceˉdeclarationˉparser as Sourceˉdeclarations;
import Compilerˉsourceˉlexer as Sourceˉlexer;
import Compilerˉsourceˉset as Sourceˉsets;
import Compilerˉsourceˉsymbols as Sourceˉsymbols;
import Compilerˉsourceˉwir as Sourceˉwir;

capability console.write_line;
capability diagnostic.write_line;
capability file.read_bytes;
capability file.write_bytes;
capability process.argument;
capability process.argument_count;

fn Empty() -> bytes {
    return Textˉtoˉutf8("");
}

fn Header(Modules: u32) -> bytes {
    var Result: bytes = Textˉtoˉutf8("WVSS");
    Result = Bytesˉconcat(Result, Bytesˉfromˉu16ˉlittle(1u32));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu16ˉlittle(0u32));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Modules));
    return Bytesˉconcat(
        Result, Bytesˉfromˉu32ˉlittle(Modules * 8u32)
    );
}

fn Buildˉsourceˉset(Firstˉargument: u32, Modules: u32) -> bytes {
    let Headerˉbytes: u32 = 16u32 + Modules * 8u32;
    var Directory: bytes = Empty();
    var Payload: bytes = Empty();
    var Payloadˉbytes: u32 = 0u32;
    var Index: u32 = 0u32;
    while Index < Modules {
        let Source: bytes = file.read_bytes(
            process.argument(Firstˉargument + Index)
        );
        let Length: u32 = Bytesˉlength(Source);
        if Length == 0u32 ||
            Payloadˉbytes > 4194304u32 - Headerˉbytes ||
            Length > 4194304u32 - Headerˉbytes - Payloadˉbytes {
            return Empty();
        }
        Directory = Bytesˉconcat(
            Directory,
            Bytesˉfromˉu32ˉlittle(Headerˉbytes + Payloadˉbytes)
        );
        Directory = Bytesˉconcat(
            Directory, Bytesˉfromˉu32ˉlittle(Length)
        );
        Payload = Bytesˉconcat(Payload, Source);
        Payloadˉbytes = Payloadˉbytes + Length;
        Index = Index + 1u32;
    }
    return Bytesˉconcat(Bytesˉconcat(Header(Modules), Directory), Payload);
}

fn Failure(
    Sourceˉset: bytes,
    Prepared: Analysis.Compilerˉsourceˉanalysis
) -> text {
    var Report: text = "source analysis status=";
    Report = Textˉconcat(Report, Enumˉname(Prepared.Status));
    Report = Textˉconcat(Report, " symbol-status=");
    Report = Textˉconcat(Report, Enumˉname(Prepared.Symbolˉstatus));
    Report = Textˉconcat(Report, " binding-status=");
    Report = Textˉconcat(Report, Enumˉname(Prepared.Bindingˉstatus));
    Report = Textˉconcat(Report, " wir-status=");
    Report = Textˉconcat(Report, Enumˉname(Prepared.Wirˉstatus));
    if Prepared.Status ==
            Analysisˉcontract.Compilerˉsourceˉanalysisˉstatus.Sourceˉsymbols {
        let Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary =
            Sourceˉsymbols.Compilerˉvalidateˉsourceˉsymbols(Sourceˉset);
        Report = Textˉconcat(Report, " graph-status=");
        Report = Textˉconcat(Report, Enumˉname(Symbols.Graphˉstatus));
        Report = Textˉconcat(Report, " failure-module=");
        Report = Textˉconcat(Report, U32ˉformat(Symbols.Failureˉmodule));
        Report = Textˉconcat(Report, " related-module=");
        Report = Textˉconcat(
            Report, U32ˉformat(Symbols.Failureˉrelatedˉmodule)
        );
        Report = Textˉconcat(Report, " declaration-kind=");
        Report = Textˉconcat(Report, Enumˉname(Symbols.Failureˉkind));
        Report = Textˉconcat(Report, " offset=");
        Report = Textˉconcat(Report, U32ˉformat(Symbols.Failureˉoffset));
        Report = Textˉconcat(Report, " line=");
        Report = Textˉconcat(Report, U32ˉformat(Symbols.Failureˉline));
        Report = Textˉconcat(Report, " column=");
        Report = Textˉconcat(Report, U32ˉformat(Symbols.Failureˉcolumn));
    }
    if Prepared.Status ==
            Analysisˉcontract.Compilerˉsourceˉanalysisˉstatus.Sourceˉwir {
        let Wirˉsymbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary =
            Sourceˉsymbols.Compilerˉvalidateˉsourceˉsymbols(Sourceˉset);
        let Scan: Sourceˉsets.Compilerˉsourceˉsetˉscan =
            Sourceˉsets.Compilerˉscanˉsourceˉset(Sourceˉset);
        let Compilation: Sourceˉwir.Compilerˉsourceˉwirˉcompilation =
            Sourceˉwir.Compilerˉprepareˉsourceˉwirˉproductˉwithˉsymbols(
                Sourceˉset, Scan, Wirˉsymbols
            );
        let Wir: Sourceˉwir.Compilerˉsourceˉwirˉsummary =
            Sourceˉwir.Compilerˉsourceˉwirˉcompilationˉsummary(
                Compilation
            );
        Report = Textˉconcat(Report, " failure-module=");
        Report = Textˉconcat(Report, U32ˉformat(Wir.Failureˉmodule));
        Report = Textˉconcat(Report, " related-module=");
        Report = Textˉconcat(
            Report, U32ˉformat(Wir.Failureˉrelatedˉmodule)
        );
        Report = Textˉconcat(Report, " function=");
        Report = Textˉconcat(Report, U32ˉformat(Wir.Failureˉfunction));
        Report = Textˉconcat(Report, " offset=");
        Report = Textˉconcat(Report, U32ˉformat(Wir.Failureˉoffset));
        Report = Textˉconcat(Report, " line=");
        Report = Textˉconcat(Report, U32ˉformat(Wir.Failureˉline));
        Report = Textˉconcat(Report, " column=");
        Report = Textˉconcat(Report, U32ˉformat(Wir.Failureˉcolumn));
    }
    return Report;
}

fn Success(
    Sourceˉset: bytes,
    Prepared: Analysis.Compilerˉsourceˉanalysis
) -> text {
    var Report: text = "source analysis status=Published source-bytes=";
    Report = Textˉconcat(Report, U32ˉformat(Bytesˉlength(Sourceˉset)));
    Report = Textˉconcat(Report, " manifest-bytes=");
    Report = Textˉconcat(Report, U32ˉformat(Bytesˉlength(Prepared.Manifest)));
    Report = Textˉconcat(Report, " binding-bytes=");
    Report = Textˉconcat(Report, U32ˉformat(Bytesˉlength(Prepared.Bindings)));
    Report = Textˉconcat(Report, " wir-bytes=");
    return Textˉconcat(Report, U32ˉformat(Bytesˉlength(Prepared.Wir)));
}

fn Argumentˉequals(Value: text, Expected: text) -> bool {
    let Left: bytes = Textˉtoˉutf8(Value);
    let Right: bytes = Textˉtoˉutf8(Expected);
    if Bytesˉlength(Left) != Bytesˉlength(Right) { return false; }
    var Index: u32 = 0u32;
    while Index < Bytesˉlength(Left) {
        if Bytesˉreadˉu8(Left, Index) != Bytesˉreadˉu8(Right, Index) {
            return false;
        }
        Index = Index + 1u32;
    }
    return true;
}

fn Rawˉprecheck(Sourceˉset: bytes) -> u32 {
    let Scan: Sourceˉsets.Compilerˉsourceˉsetˉscan =
        Sourceˉsets.Compilerˉscanˉsourceˉset(Sourceˉset);
    if Scan.Status != Sourceˉsets.Compilerˉsourceˉsetˉstatus.Valid {
        return 0u32;
    }
    var Module: u32 = 0u32;
    while Module < Scan.Modules {
        let View: Sourceˉsets.Compilerˉsourceˉsetˉview =
            Sourceˉsets.Compilerˉsourceˉsetˉmodule(Sourceˉset, Scan, Module);
        if Bytesˉlength(View.Source) > 0u32 &&
            Bytesˉreadˉu8(View.Source, 0u32) == 35u8 {
            return 1u32;
        }
        if View.Status != Sourceˉsets.Compilerˉsourceˉsetˉstatus.Valid {
            return 0u32;
        }
        let Header: Sourceˉdeclarations.Compilerˉsourceˉheader =
            Sourceˉdeclarations.Compilerˉparseˉheader(View.Source);
        if Header.Status != Sourceˉdeclarations.Compilerˉparseˉstatus.Valid {
            return 0u32;
        }
        if Header.Profile == Sourceˉdeclarations.Compilerˉsourceˉprofile.System {
            return 2u32;
        }
        var Cursor: u32 = 0u32;
        var Line: u32 = 1u32;
        var Column: u32 = 1u32;
        var Reading: bool = true;
        while Reading {
            let Token: Sourceˉlexer.Compilerˉsourceˉtoken =
                Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                    View.Source, Cursor, Line, Column
                );
            if Token.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Platform {
                return 3u32;
            }
            if Token.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Foreign {
                return 4u32;
            }
            if Token.Kind == Sourceˉlexer.Compilerˉtokenˉkind.End {
                Reading = false;
            } else {
                Cursor = Token.Nextˉoffset;
                Line = Token.Nextˉline;
                Column = Token.Nextˉcolumn;
            }
        }
        Module = Module + 1u32;
    }
    return 0u32;
}

fn Containsˉforeign(Sourceˉset: bytes) -> bool {
    let Scan: Sourceˉsets.Compilerˉsourceˉsetˉscan =
        Sourceˉsets.Compilerˉscanˉsourceˉset(Sourceˉset);
    if Scan.Status != Sourceˉsets.Compilerˉsourceˉsetˉstatus.Valid {
        return false;
    }
    var Module: u32 = 0u32;
    while Module < Scan.Modules {
        let View: Sourceˉsets.Compilerˉsourceˉsetˉview =
            Sourceˉsets.Compilerˉsourceˉsetˉmodule(
                Sourceˉset, Scan, Module
            );
        if View.Status != Sourceˉsets.Compilerˉsourceˉsetˉstatus.Valid {
            return false;
        }
        var Cursor: u32 = 0u32;
        var Line: u32 = 1u32;
        var Column: u32 = 1u32;
        var Reading: bool = true;
        while Reading {
            let Token: Sourceˉlexer.Compilerˉsourceˉtoken =
                Sourceˉlexer.Compilerˉlexˉnextˉafterˉscan(
                    View.Source, Cursor, Line, Column
                );
            if Token.Kind == Sourceˉlexer.Compilerˉtokenˉkind.Foreign {
                return true;
            }
            if Token.Kind == Sourceˉlexer.Compilerˉtokenˉkind.End {
                Reading = false;
            } else {
                Cursor = Token.Nextˉoffset;
                Line = Token.Nextˉline;
                Column = Token.Nextˉcolumn;
            }
        }
        Module = Module + 1u32;
    }
    return false;
}

fn Analyze(Sourceˉset: bytes, Outputˉindex: u32) -> i32 {
    if Bytesˉlength(Sourceˉset) == 0u32 {
        diagnostic.write_line("source analysis status=Invalidˉinput");
        return 1;
    }
    let Prepared: Analysis.Compilerˉsourceˉanalysis =
        Analysis.Compilerˉprepareˉsourceˉanalysis(Sourceˉset);
    if Prepared.Status !=
        Analysisˉcontract.Compilerˉsourceˉanalysisˉstatus.Valid {
        diagnostic.write_line(Failure(Sourceˉset, Prepared));
        return 1;
    }
    file.write_bytes(process.argument(Outputˉindex), Sourceˉset);
    file.write_bytes(process.argument(Outputˉindex + 1u32), Prepared.Manifest);
    file.write_bytes(process.argument(Outputˉindex + 2u32), Prepared.Bindings);
    file.write_bytes(process.argument(Outputˉindex + 3u32), Prepared.Wir);
    console.write_line(Success(Sourceˉset, Prepared));
    return 0;
}

fn Analyzeˉfromˉsymbolˉcheckpoint(
    Sourceˉset: bytes,
    Symbolˉcheckpoint: bytes,
    Outputˉindex: u32
) -> i32 {
    if Bytesˉlength(Sourceˉset) == 0u32 ||
        Bytesˉlength(Symbolˉcheckpoint) == 0u32 {
        diagnostic.write_line("source analysis status=Invalidˉinput");
        return 1;
    }
    let Prepared: Analysis.Compilerˉsourceˉanalysis =
        Analysis.Compilerˉprepareˉsourceˉanalysisˉfromˉsymbolˉcheckpoint(
            Sourceˉset, Symbolˉcheckpoint
        );
    if Prepared.Status !=
        Analysisˉcontract.Compilerˉsourceˉanalysisˉstatus.Valid {
        diagnostic.write_line(Failure(Sourceˉset, Prepared));
        return 1;
    }
    file.write_bytes(process.argument(Outputˉindex), Prepared.Manifest);
    file.write_bytes(process.argument(Outputˉindex + 1u32), Prepared.Bindings);
    file.write_bytes(process.argument(Outputˉindex + 2u32), Prepared.Wir);
    console.write_line(Success(Sourceˉset, Prepared));
    return 0;
}

fn Publishˉsymbolˉcheckpoint(
    Sourceˉset: bytes,
    Sourceˉoutputˉindex: u32,
    Symbolˉoutputˉindex: u32
) -> i32 {
    if Bytesˉlength(Sourceˉset) == 0u32 {
        diagnostic.write_line("source analysis status=Invalidˉinput");
        return 1;
    }
    let Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary =
        Sourceˉsymbols.Compilerˉvalidateˉsourceˉsymbols(Sourceˉset);
    if Symbols.Status != Sourceˉsymbols.Compilerˉsourceˉsymbolˉstatus.Valid {
        let Failed: Analysis.Compilerˉsourceˉanalysis =
            Analysis.Compilerˉprepareˉsourceˉanalysisˉwithˉsymbols(
                Sourceˉset, Symbols
            );
        diagnostic.write_line(Failure(Sourceˉset, Failed));
        return 1;
    }
    let Checkpoint: bytes =
        Analysis.Compilerˉsourceˉanalysisˉsymbolˉcheckpoint(
            Sourceˉset, Symbols
        );
    if Bytesˉlength(Checkpoint) == 0u32 {
        diagnostic.write_line("source analysis status=Invalidˉinput");
        return 1;
    }
    file.write_bytes(process.argument(Sourceˉoutputˉindex), Sourceˉset);
    file.write_bytes(
        process.argument(Symbolˉoutputˉindex), Checkpoint
    );
    console.write_line("source analysis checkpoint=Symbols");
    return 0;
}

export fn Main() -> i32 {
    let Arguments: u32 = process.argument_count();
    if Arguments > 0u32 && Argumentˉequals(
            process.argument(0u32), "--admitted-source-set"
        ) {
        diagnostic.write_line(
            "source analysis status=Invalidˉinvocation reason=admitted-source-set-route-removed"
        );
        return 64;
    }
    if Arguments > 0u32 && Argumentˉequals(
            process.argument(0u32), "--internal-authenticated-admission"
        ) {
        diagnostic.write_line(
            "source analysis status=Invalidˉinvocation reason=authenticated-admission-route-removed"
        );
        return 64;
    }
    if Arguments > 0u32 && Argumentˉequals(
            process.argument(0u32), "--internal-symbol-checkpoint"
        ) {
        if Arguments < 4u32 {
            diagnostic.write_line("source analysis status=Invalidˉinput");
            return 64;
        }
        let Checkpointˉmodules: u32 = Arguments - 3u32;
        if Checkpointˉmodules > 64u32 {
            diagnostic.write_line("source analysis status=Moduleˉlimit");
            return 64;
        }
        let Checkpointˉsourceˉset: bytes = Buildˉsourceˉset(
            1u32, Checkpointˉmodules
        );
        let Checkpointˉprecheck: u32 = Rawˉprecheck(
            Checkpointˉsourceˉset
        );
        if Checkpointˉprecheck == 1u32 {
            diagnostic.write_line("source analysis status=Rawˉdescriptor");
            return 1;
        }
        if Checkpointˉprecheck == 2u32 {
            diagnostic.write_line("source analysis status=RawˉSystemˉprofile");
            return 1;
        }
        if Checkpointˉprecheck == 3u32 {
            diagnostic.write_line("source analysis status=Rawˉplatform");
            return 1;
        }
        if Checkpointˉprecheck == 4u32 {
            diagnostic.write_line("source analysis status=Rawˉforeign");
            return 1;
        }
        return Publishˉsymbolˉcheckpoint(
            Checkpointˉsourceˉset,
            1u32 + Checkpointˉmodules,
            2u32 + Checkpointˉmodules
        );
    }
    if Arguments > 0u32 && Argumentˉequals(
            process.argument(0u32), "--internal-analysis-checkpoint"
        ) {
        if Arguments != 6u32 {
            diagnostic.write_line("source analysis status=Invalidˉinput");
            return 64;
        }
        return Analyzeˉfromˉsymbolˉcheckpoint(
            file.read_bytes(process.argument(1u32)),
            file.read_bytes(process.argument(2u32)),
            3u32
        );
    }
    if Arguments > 0u32 && Argumentˉequals(
            process.argument(0u32), "--internal-source-set"
        ) {
        if Arguments != 6u32 {
            diagnostic.write_line(
                "Usage: wvanalyze --internal-source-set <input.wvss> <output.wvss> <output.wvca> <output.wvlb> <output.wvir>"
            );
            return 64;
        }
        let Internalˉsourceˉset: bytes =
            file.read_bytes(process.argument(1u32));
        if Containsˉforeign(Internalˉsourceˉset) {
            diagnostic.write_line(
                "source analysis status=Foreignˉrequiresˉauthenticatedˉbinding"
            );
            return 1;
        }
        return Analyze(Internalˉsourceˉset, 2u32);
    }
    if Arguments < 5u32 {
        diagnostic.write_line(
            "Usage: wvanalyze <root.wv> [dependency.wv ...] <output.wvss> <output.wvca> <output.wvlb> <output.wvir>"
        );
        return 64;
    }
    let Modules: u32 = Arguments - 4u32;
    if Modules > 64u32 {
        diagnostic.write_line("source analysis status=Moduleˉlimit");
        return 64;
    }
    let Sourceˉset: bytes = Buildˉsourceˉset(0u32, Modules);
    let Precheck: u32 = Rawˉprecheck(Sourceˉset);
    if Precheck == 1u32 {
        diagnostic.write_line("source analysis status=Rawˉdescriptor");
        return 1;
    }
    if Precheck == 2u32 {
        diagnostic.write_line("source analysis status=RawˉSystemˉprofile");
        return 1;
    }
    if Precheck == 3u32 {
        diagnostic.write_line("source analysis status=Rawˉplatform");
        return 1;
    }
    if Precheck == 4u32 {
        diagnostic.write_line("source analysis status=Rawˉforeign");
        return 1;
    }
    return Analyze(Sourceˉset, Modules);
}
