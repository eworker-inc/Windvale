            if Bytesˉreadˉu32ˉlittle(Input, Name + 8u32) != 1969713761u32 { Matches = false; }
            if Bytesˉreadˉu32ˉlittle(Input, Name + 12u32) != 1953391981u32 { Matches = false; }
            if Matches { Catalog = 4u32; }
            Matches = true;
            if Bytesˉreadˉu32ˉlittle(Input, Name) != 1701080941u32 { Matches = false; }
