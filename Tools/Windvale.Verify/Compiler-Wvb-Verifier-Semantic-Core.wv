                    Length = U32ˉfromˉu8(Bytesˉreadˉu8(Input, Payloadˉcursor));
                    if Length < 1u32 { return Invalid; }
                    if Length > 11u32 {
                        if !Bˉextendedˉshape(Minor, Length) { return Invalid; }
                    }
                    Payloadˉcursor = Payloadˉcursor + 1u32;
                    if Length == 7u32 || Length == 8u32 || Length == 11u32 ||
