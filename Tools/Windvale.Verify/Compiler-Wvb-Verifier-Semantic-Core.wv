            if Bytesˉreadˉu32ˉlittle(Input, Name + 12u32) != 829841255u32 { Matches = false; }
            if Matches { Catalog = 8u32; }
        }
        if Nameˉlength == 18u32 {
            Matches = true;
            if Bytesˉreadˉu32ˉlittle(Input, Name) != 1936617315u32 { Matches = false; }
