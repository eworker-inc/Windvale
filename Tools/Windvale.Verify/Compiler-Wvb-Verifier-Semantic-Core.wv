module Windvaleˉcompilerˉwvbˉverifierˉsemantic profile portable;

import Windvaleˉcompilerˉwvbˉverifierˉexecutable as Executableˉverifier;
import Windvaleˉcompilerˉwvbˉverifierˉtypedˉdirectories as Typedˉdirectories;

export fn Aˉidentifier(Input: bytes) -> bytes {
    let Invalid: bytes = Bytesˉslice(Input, 0u32, 0u32);
    let End: u32 = Bytesˉlength(Input);
    var Cursor: u32 = 0u32;
    var Wordˉstart: bool = true;
    var Current: u32 = 0u32;
    var Valid: bool = false;
    while Cursor < End {
        Current = U32ˉfromˉu8(Bytesˉreadˉu8(Input, Cursor));
        if Wordˉstart {
            Valid = false;
            if Current >= 65u32 {
                if Current <= 90u32 { Valid = true; }
            }
            if Current >= 97u32 {
                if Current <= 122u32 { Valid = true; }
            }
            if Current == 95u32 { Valid = true; }
            if Valid {
            } else {
                return Invalid;
            }
            Wordˉstart = false;
            Cursor = Cursor + 1u32;
        } else {
            Valid = false;
            if Current >= 65u32 {
                if Current <= 90u32 { Valid = true; }
            }
            if Current >= 97u32 {
                if Current <= 122u32 { Valid = true; }
            }
            if Current >= 48u32 {
                if Current <= 57u32 { Valid = true; }
            }
            if Current == 95u32 { Valid = true; }
            if Valid {
                Cursor = Cursor + 1u32;
            } else {
                if Current != 203u32 { return Invalid; }
                if Cursor + 1u32 >= End { return Invalid; }
                if U32ˉfromˉu8(Bytesˉreadˉu8(Input, Cursor + 1u32)) != 137u32 {
                    return Invalid;
                }
                Wordˉstart = true;
                Cursor = Cursor + 2u32;
            }
        }
    }
    if Wordˉstart { return Invalid; }
    return Input;
}

fn Bˉeffectiveˉminor(Input: bytes) -> u32 {
    let Declared: u32 = Bytesˉreadˉu16ˉlittle(Input, 6u32);
    if Declared == 38u32 || Declared == 39u32 { return 37u32; }
    return Declared;
}

fn Bˉborrowˉpayloadˉkind(Kind: u32) -> bool {
    return (Kind >= 1u32 && Kind <= 11u32) ||
        (Kind >= 14u32 && Kind <= 20u32) || Kind == 22u32 ||
        Kind == 24u32 || Kind == 35u32;
}

fn Bˉextendedˉshape(Minor: u32, Kind: u32) -> bool {
    if Kind >= 14u32 && Kind <= 16u32 {
        return Minor >= 12u32 && Minor <= 37u32;
    }
    if Kind == 17u32 { return Minor >= 13u32 && Minor <= 37u32; }
    if Kind == 18u32 || Kind == 19u32 {
        return Minor >= 14u32 && Minor <= 37u32;
    }
    if Kind == 20u32 || Kind == 21u32 {
        return Minor >= 15u32 && Minor <= 37u32;
    }
    if Kind == 22u32 { return Minor >= 17u32 && Minor <= 37u32; }
    if Kind == 23u32 || Kind == 24u32 {
        return Minor >= 18u32 && Minor <= 37u32;
    }
    if Kind == 25u32 {
        return (Minor >= 21u32 && Minor <= 28u32) || Minor == 32u32 ||
            Minor == 33u32 || Minor == 34u32 || Minor == 35u32 ||
            Minor == 36u32 || Minor == 37u32;
    }
    if Kind == 28u32 || Kind == 29u32 || Kind == 30u32 {
        return Minor >= 28u32 && Minor <= 37u32;
    }
    if Kind == 34u32 {
        return Minor >= 29u32 && Minor <= 37u32;
    }
    if Kind == 35u32 { return Minor >= 30u32 && Minor <= 37u32; }
    if Kind == 36u32 {
        return Minor == 34u32 || Minor == 35u32 || Minor == 36u32 ||
            Minor == 37u32;
    }
    return false;
}

fn Bˉshapeˉend(Input: bytes, Cursor: u32) -> u32 {
    var Kind: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(Input, Cursor));
    var End: u32 = Cursor + 1u32;
    if Kind == 37u32 {
        Kind = U32ˉfromˉu8(Bytesˉreadˉu8(Input, End));
        End = End + 1u32;
    }
    if Kind == 7u32 || Kind == 8u32 || Kind == 11u32 || Kind == 22u32 ||
        Kind == 23u32 || Kind == 24u32 || Kind == 26u32 || Kind == 27u32 ||
        Kind == 28u32 || Kind == 29u32 || Kind == 30u32 || Kind == 35u32 {
        End = End + 4u32;
    }
    return End;
}

fn Bˉfunctionˉshapesˉend(
    Input: bytes, Minor: u32, Declaredˉminor: u32,
    Cursor: u32, End: u32, Count: u32, Parameters: bool
) -> u32 {
    var Next: u32 = Cursor;
    var Index: u32 = 0u32;
    while Index < Count {
        if Next >= End { return 0u32; }
        var Raw: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(Input, Next));
        var Width: u32 = 1u32;
        if Raw == 37u32 {
            if Declaredˉminor != 39u32 || End - Next < 2u32 { return 0u32; }
            Raw = U32ˉfromˉu8(Bytesˉreadˉu8(Input, Next + 1u32));
            if !Bˉborrowˉpayloadˉkind(Raw) { return 0u32; }
            Width = 2u32;
        }
        if Raw < 1u32 { return 0u32; }
        if Raw > 11u32 {
            if Parameters && (Raw == 26u32 || Raw == 27u32) {
                if Minor < 26u32 { return 0u32; }
            } else if !Bˉextendedˉshape(Minor, Raw) { return 0u32; }
        }
        if Raw == 7u32 || Raw == 8u32 || Raw == 11u32 || Raw == 22u32 ||
            Raw == 23u32 || Raw == 24u32 || Raw == 26u32 || Raw == 27u32 ||
            Raw == 28u32 || Raw == 29u32 || Raw == 30u32 || Raw == 35u32 {
            Width = Width + 4u32;
        }
        if Width > End - Next { return 0u32; }
        Next = Next + Width;
        Index = Index + 1u32;
    }
    return Next;
}

fn Bˉvariantˉcaseˉend(Input: bytes, Cursor: u32) -> u32 {
    let Marker: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(Input, Cursor));
    var End: u32 = Cursor + 1u32;
    var Fields: u32 = 0u32;
    if Marker == 1u32 { Fields = 1u32; }
    if Marker == 2u32 {
        Fields = Bytesˉreadˉu32ˉlittle(Input, End);
        End = End + 4u32;
    }
    var Field: u32 = 0u32;
    while Field < Fields {
        let Nameˉlength: u32 = Bytesˉreadˉu32ˉlittle(Input, End);
        End = End + 4u32 + Nameˉlength;
        End = Bˉshapeˉend(Input, End);
        Field = Field + 1u32;
    }
    return End;
}

fn Bˉtypesˉend(
    Input: bytes,
    Minor: u32,
    Cursor: u32,
    End: u32
) -> u32 {
    if Cursor > End || 4u32 > End - Cursor { return 0u32; }
    let Typeˉcount: u32 = Bytesˉreadˉu32ˉlittle(Input, Cursor);
    if Typeˉcount > 1024u32 { return 0u32; }
    var Reading: u32 = Cursor + 4u32;
    var Index: u32 = 0u32;
    while Index < Typeˉcount {
        if Reading >= End { return 0u32; }
        let Raw: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(Input, Reading));
        if Raw < 1u32 || Raw > 8u32 { return 0u32; }
        Reading = Reading + 1u32;
        var Length: u32 = 0u32;
        if Raw == 8u32 {
            if (Minor < 30u32 || Minor > 37u32) || Reading >= End {
                return 0u32;
            }
            let Profile: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(Input, Reading));
            if Profile < 1u32 || Profile > 3u32 { return 0u32; }
            Reading = Reading + 1u32;
            if Reading >= End { return 0u32; }
            Length = U32ˉfromˉu8(Bytesˉreadˉu8(Input, Reading));
            if Length < 1u32 || Length == 21u32 || Length == 25u32 ||
                Length == 26u32 || Length == 27u32 || Length == 28u32 ||
                Length == 29u32 || Length == 30u32 || Length == 31u32 ||
                Length == 32u32 || Length == 33u32 || Length == 34u32 ||
                Length == 36u32 ||
                (Length > 11u32 && !Bˉextendedˉshape(Minor, Length)) {
                return 0u32;
            }
            Reading = Reading + 1u32;
            if Length == 7u32 || Length == 8u32 || Length == 11u32 ||
                Length == 22u32 || Length == 23u32 || Length == 24u32 ||
                Length == 35u32 {
                if 4u32 > End - Reading ||
                    Bytesˉreadˉu32ˉlittle(Input, Reading) >= Typeˉcount {
                    return 0u32;
                }
                Reading = Reading + 4u32;
            }
            if 4u32 > End - Reading { return 0u32; }
            let Parameterˉcount: u32 = Bytesˉreadˉu32ˉlittle(Input, Reading);
            if Parameterˉcount > 64u32 { return 0u32; }
            Reading = Reading + 4u32;
            var Parameter: u32 = 0u32;
            while Parameter < Parameterˉcount {
                if Reading >= End { return 0u32; }
                Length = U32ˉfromˉu8(Bytesˉreadˉu8(Input, Reading));
                if Length < 1u32 || Length == 21u32 || Length == 25u32 ||
                    Length == 26u32 || Length == 27u32 || Length == 28u32 ||
                    Length == 29u32 || Length == 30u32 || Length == 31u32 ||
                    Length == 32u32 || Length == 33u32 || Length == 34u32 ||
                    Length == 36u32 ||
                    (Length > 11u32 && !Bˉextendedˉshape(Minor, Length)) {
                    return 0u32;
                }
                Reading = Reading + 1u32;
                if Length == 7u32 || Length == 8u32 || Length == 11u32 ||
                    Length == 22u32 || Length == 23u32 || Length == 24u32 ||
                    Length == 35u32 {
                    if 4u32 > End - Reading ||
                        Bytesˉreadˉu32ˉlittle(Input, Reading) >= Typeˉcount {
                        return 0u32;
                    }
                    Reading = Reading + 4u32;
                }
                Parameter = Parameter + 1u32;
            }
            if Minor == 32u32 || Minor == 33u32 || Minor == 34u32 ||
                Minor == 35u32 || Minor == 36u32 || Minor == 37u32 {
                if Reading > End || 10u32 + Parameterˉcount > End - Reading {
                    return 0u32;
                }
                let Flags: u32 = U32ˉfromˉu8(
                    Bytesˉreadˉu8(Input, Reading)
                );
                let Resultˉmode: u32 = U32ˉfromˉu8(
                    Bytesˉreadˉu8(Input, Reading + 1u32)
                );
                if Flags > 3u32 || Resultˉmode > 2u32 { return 0u32; }
                Reading = Reading + 10u32;
                Parameter = 0u32;
                while Parameter < Parameterˉcount {
                    if U32ˉfromˉu8(Bytesˉreadˉu8(Input, Reading)) > 2u32 {
                        return 0u32;
                    }
                    Reading = Reading + 1u32;
                    Parameter = Parameter + 1u32;
                }
            }
            Index = Index + 1u32;
        } else {
        if 4u32 > End - Reading { return 0u32; }
        Length = Bytesˉreadˉu32ˉlittle(Input, Reading);
        if Length < 1u32 || Length > 255u32 { return 0u32; }
        Reading = Reading + 4u32;
        if Length > End - Reading { return 0u32; }
        Reading = Reading + Length;
        if Raw == 4u32 {
            if Minor < 17u32 || Minor > 37u32 || Reading >= End {
                return 0u32;
            }
            Length = U32ˉfromˉu8(Bytesˉreadˉu8(Input, Reading));
            if Length < 1u32 { return 0u32; }
            if Length > 11u32 {
                if !Bˉextendedˉshape(Minor, Length) { return 0u32; }
            }
            Reading = Reading + 1u32;
            if Length == 7u32 || Length == 8u32 || Length == 11u32 ||
                Length == 22u32 || Length == 23u32 || Length == 24u32 ||
                Length == 35u32 {
                if 4u32 > End - Reading { return 0u32; }
                Reading = Reading + 4u32;
            }
            if 4u32 > End - Reading { return 0u32; }
            let Arrayˉcount: u32 = Bytesˉreadˉu32ˉlittle(Input, Reading);
            if Arrayˉcount > 4095u32 { return 0u32; }
            Reading = Reading + 4u32;
        } else if Raw == 5u32 || Raw == 6u32 {
            if Minor < 18u32 || Minor > 37u32 || Reading >= End {
                return 0u32;
            }
            Length = U32ˉfromˉu8(Bytesˉreadˉu8(Input, Reading));
            if Length < 1u32 || Length == 21u32 { return 0u32; }
            if Length > 11u32 {
                if !Bˉextendedˉshape(Minor, Length) { return 0u32; }
            }
            Reading = Reading + 1u32;
            if Length == 7u32 || Length == 8u32 || Length == 11u32 ||
                Length == 22u32 || Length == 23u32 || Length == 24u32 ||
                Length == 35u32 {
                if 4u32 > End - Reading { return 0u32; }
                Reading = Reading + 4u32;
            }
        } else {
            if Raw == 7u32 {
                var Enumˉversion: bool = Minor == 22u32;
                if Minor == 23u32 || Minor == 24u32 || Minor == 25u32 ||
                    Minor == 26u32 || Minor == 27u32 || Minor == 28u32 ||
                    Minor == 29u32 || Minor == 30u32 || Minor == 31u32 ||
                    Minor == 32u32 || Minor == 33u32 || Minor == 34u32 ||
                    Minor == 35u32 || Minor == 36u32 || Minor == 37u32 {
                    Enumˉversion = true;
                }
                if !Enumˉversion || Reading >= End || U32ˉfromˉu8(
                    Bytesˉreadˉu8(Input, Reading)
                ) != 6u32 {
                    return 0u32;
                }
                Reading = Reading + 1u32;
            }
            if 4u32 > End - Reading { return 0u32; }
            let Count: u32 = Bytesˉreadˉu32ˉlittle(Input, Reading);
            if Count < 1u32 { return 0u32; }
            if Raw == 1u32 {
                if Count > 64u32 { return 0u32; }
            } else {
                if Count > 256u32 { return 0u32; }
            }
            Reading = Reading + 4u32;
            var Innerˉindex: u32 = 0u32;
            while Innerˉindex < Count {
                if Reading > End || 4u32 > End - Reading { return 0u32; }
                Length = Bytesˉreadˉu32ˉlittle(Input, Reading);
                if Length < 1u32 || Length > 255u32 { return 0u32; }
                Reading = Reading + 4u32;
                if Length > End - Reading { return 0u32; }
                Reading = Reading + Length;
                if Raw == 1u32 {
                    if Reading >= End { return 0u32; }
                    Length = U32ˉfromˉu8(Bytesˉreadˉu8(Input, Reading));
                    if Length < 1u32 { return 0u32; }
                    if Length > 11u32 {
                        if !Bˉextendedˉshape(Minor, Length) { return 0u32; }
                    }
                    Reading = Reading + 1u32;
                    if Length == 7u32 || Length == 8u32 ||
                        Length == 11u32 || Length == 22u32 ||
                        Length == 23u32 || Length == 24u32 ||
                        Length == 35u32 {
                        if 4u32 > End - Reading { return 0u32; }
                        Reading = Reading + 4u32;
                    }
                } else if Raw == 2u32 {
                    if 4u32 > End - Reading { return 0u32; }
                    Reading = Reading + 4u32;
                } else if Raw == 7u32 {
                    if Reading >= End { return 0u32; }
                    Reading = Reading + 1u32;
                } else {
                    if Reading >= End { return 0u32; }
                    let Payloadˉpresent: u32 = U32ˉfromˉu8(
                        Bytesˉreadˉu8(Input, Reading)
                    );
                    if Payloadˉpresent > 2u32 { return 0u32; }
                    Reading = Reading + 1u32;
                    var Payloadˉfields: u32 = 0u32;
                    if Payloadˉpresent == 1u32 { Payloadˉfields = 1u32; }
                    if Payloadˉpresent == 2u32 {
                        if Minor < 16u32 || Minor > 37u32 ||
                            4u32 > End - Reading {
                            return 0u32;
                        }
                        Payloadˉfields = Bytesˉreadˉu32ˉlittle(Input, Reading);
                        if Payloadˉfields < 2u32 || Payloadˉfields > 64u32 {
                            return 0u32;
                        }
                        Reading = Reading + 4u32;
                    }
                    var Payloadˉfield: u32 = 0u32;
                    while Payloadˉfield < Payloadˉfields {
                        if 4u32 > End - Reading { return 0u32; }
                        Length = Bytesˉreadˉu32ˉlittle(Input, Reading);
                        if Length < 1u32 || Length > 255u32 { return 0u32; }
                        Reading = Reading + 4u32;
                        if Length > End - Reading { return 0u32; }
                        Reading = Reading + Length;
                        if Reading >= End { return 0u32; }
                        Length = U32ˉfromˉu8(Bytesˉreadˉu8(Input, Reading));
                        if Length < 1u32 { return 0u32; }
                        if Length > 11u32 {
                            if !Bˉextendedˉshape(Minor, Length) { return 0u32; }
                        }
                        Reading = Reading + 1u32;
                        if Length == 7u32 || Length == 8u32 ||
                            Length == 11u32 || Length == 22u32 ||
                            Length == 23u32 || Length == 24u32 ||
                            Length == 35u32 {
                            if 4u32 > End - Reading { return 0u32; }
                            Reading = Reading + 4u32;
                        }
                        Payloadˉfield = Payloadˉfield + 1u32;
                    }
                }
                Innerˉindex = Innerˉindex + 1u32;
            }
        }
        Index = Index + 1u32;
        }
    }
    if Reading != End { return 0u32; }
    return Reading;
}

fn Bˉnextˉtype(Input: bytes, Cursor: u32) -> u32 {
    let Kind: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(Input, Cursor));
    var Next: u32 = Cursor + 1u32;
    if Kind == 8u32 {
        Next = Bˉshapeˉend(Input, Next + 1u32);
        let Parameters: u32 = Bytesˉreadˉu32ˉlittle(Input, Next);
        Next = Next + 4u32;
        var Parameter: u32 = 0u32;
        while Parameter < Parameters {
            Next = Bˉshapeˉend(Input, Next);
            Parameter = Parameter + 1u32;
        }
        let Minor: u32 = Bˉeffectiveˉminor(Input);
        if Minor >= 32u32 && Minor <= 37u32 {
            Next = Next + 10u32 + Parameters;
        }
        return Next;
    }
    let Nameˉlength: u32 = Bytesˉreadˉu32ˉlittle(Input, Next);
    Next = Next + 4u32 + Nameˉlength;
    if Kind == 7u32 { Next = Next + 1u32; }
    if Kind == 4u32 { return Bˉshapeˉend(Input, Next) + 4u32; }
    if Kind == 5u32 || Kind == 6u32 {
        return Bˉshapeˉend(Input, Next);
    }
    let Items: u32 = Bytesˉreadˉu32ˉlittle(Input, Next);
    Next = Next + 4u32;
    var Item: u32 = 0u32;
    while Item < Items {
        let Itemˉnameˉlength: u32 = Bytesˉreadˉu32ˉlittle(Input, Next);
        Next = Next + 4u32 + Itemˉnameˉlength;
        if Kind == 1u32 {
            Next = Bˉshapeˉend(Input, Next);
        } else if Kind == 2u32 {
            Next = Next + 4u32;
        } else if Kind == 7u32 {
            Next = Next + 1u32;
        } else {
            Next = Bˉvariantˉcaseˉend(Input, Next);
        }
        Item = Item + 1u32;
    }
    return Next;
}

fn Bˉtypeˉat(Input: bytes, Types: u32, Typeˉindex: u32) -> u32 {
    var Cursor: u32 = Types + 4u32;
    var Index: u32 = 0u32;
    while Index < Typeˉindex {
        Cursor = Bˉnextˉtype(Input, Cursor);
        Index = Index + 1u32;
    }
    return Cursor;
}

export fn Bˉstructure(Input: bytes) -> bytes {
    let Invalid: bytes = Bytesˉslice(Input, 0u32, 0u32);
    let Total: u32 = Bytesˉlength(Input);
    if Total < 12u32 { return Invalid; }
    if U32ˉfromˉu8(Bytesˉreadˉu8(Input, 0u32)) != 87u32 { return Invalid; }
    if U32ˉfromˉu8(Bytesˉreadˉu8(Input, 1u32)) != 86u32 { return Invalid; }
    if U32ˉfromˉu8(Bytesˉreadˉu8(Input, 2u32)) != 66u32 { return Invalid; }
    if U32ˉfromˉu8(Bytesˉreadˉu8(Input, 3u32)) != 49u32 { return Invalid; }
    if Bytesˉreadˉu16ˉlittle(Input, 4u32) != 1u32 { return Invalid; }
    let Declaredˉminor: u32 = Bytesˉreadˉu16ˉlittle(Input, 6u32);
    if Declaredˉminor != 11u32 && Declaredˉminor != 12u32 &&
        Declaredˉminor != 13u32 && Declaredˉminor != 14u32 &&
        Declaredˉminor != 15u32 && Declaredˉminor != 16u32 &&
        Declaredˉminor != 17u32 && Declaredˉminor != 18u32 &&
        Declaredˉminor != 19u32 && Declaredˉminor != 20u32 &&
        Declaredˉminor != 21u32 && Declaredˉminor != 22u32 &&
        Declaredˉminor != 23u32 && Declaredˉminor != 24u32 &&
        Declaredˉminor != 25u32 && Declaredˉminor != 26u32 &&
        Declaredˉminor != 27u32 && Declaredˉminor != 28u32 &&
        Declaredˉminor != 29u32 && Declaredˉminor != 30u32 &&
        Declaredˉminor != 31u32 && Declaredˉminor != 32u32 &&
        Declaredˉminor != 33u32 && Declaredˉminor != 34u32 &&
        Declaredˉminor != 35u32 && Declaredˉminor != 36u32 &&
        Declaredˉminor != 37u32 && Declaredˉminor != 38u32 &&
        Declaredˉminor != 39u32 {
        return Invalid;
    }
    let Minor: u32 = Bˉeffectiveˉminor(Input);
    if Bytesˉreadˉu32ˉlittle(Input, 8u32) != 7u32 { return Invalid; }

    var Cursor: u32 = 12u32;
    var Expectedˉkind: u32 = 1u32;
    var Payload: u32 = 0u32;
    var Payloadˉlength: u32 = 0u32;
    var Payloadˉend: u32 = 0u32;
    var Payloadˉcursor: u32 = 0u32;
    var Count: u32 = 0u32;
    var Index: u32 = 0u32;
    var Innerˉindex: u32 = 0u32;
    var Length: u32 = 0u32;
    var Raw: u32 = 0u32;
    var Width: u32 = 0u32;
    var Functionˉcount: u32 = 0u32;
    var Expectedˉcodeˉoffset: u32 = 0u32;

    while Expectedˉkind <= 7u32 {
        if Cursor > Total { return Invalid; }
        if 8u32 > Total - Cursor { return Invalid; }
        Payload = Cursor + 8u32;
        if U32ˉfromˉu8(Bytesˉreadˉu8(Input, Cursor)) != Expectedˉkind {
            return Invalid;
        }
        if U32ˉfromˉu8(Bytesˉreadˉu8(Input, Cursor + 1u32)) != 0u32 {
            return Invalid;
        }
        if Bytesˉreadˉu16ˉlittle(Input, Cursor + 2u32) != 0u32 {
            return Invalid;
        }
        Payloadˉlength = Bytesˉreadˉu32ˉlittle(Input, Cursor + 4u32);
        if Payloadˉlength > Total - Payload { return Invalid; }
        Payloadˉend = Payload + Payloadˉlength;
        Payloadˉcursor = Payload;

        if Expectedˉkind == 1u32 {
            if Payloadˉlength < 6u32 { return Invalid; }
            Raw = U32ˉfromˉu8(Bytesˉreadˉu8(Input, Payloadˉcursor));
            if Raw < 1u32 { return Invalid; }
            if Raw > 3u32 { return Invalid; }
            Payloadˉcursor = Payloadˉcursor + 1u32;
            Length = Bytesˉreadˉu32ˉlittle(Input, Payloadˉcursor);
            if Length < 1u32 { return Invalid; }
            if Length > 255u32 { return Invalid; }
            Payloadˉcursor = Payloadˉcursor + 4u32;
            if Length > Payloadˉend - Payloadˉcursor { return Invalid; }
            Payloadˉcursor = Payloadˉcursor + Length;
            if Payloadˉcursor >= Payloadˉend { return Invalid; }
            if U32ˉfromˉu8(Bytesˉreadˉu8(Input, Payloadˉcursor)) != 0u32 {
                return Invalid;
            }
            Payloadˉcursor = Payloadˉcursor + 1u32;
        }

        if Expectedˉkind == 2u32 {
            if Payloadˉlength < 4u32 { return Invalid; }
            Count = Bytesˉreadˉu32ˉlittle(Input, Payloadˉcursor);
            if Count > 32u32 { return Invalid; }
            Payloadˉcursor = Payloadˉcursor + 4u32;
            Index = 0u32;
            while Index < Count {
                if Payloadˉcursor > Payloadˉend { return Invalid; }
                if 4u32 > Payloadˉend - Payloadˉcursor { return Invalid; }
                Length = Bytesˉreadˉu32ˉlittle(Input, Payloadˉcursor);
                if Length < 1u32 { return Invalid; }
                if Length > 255u32 { return Invalid; }
                Payloadˉcursor = Payloadˉcursor + 4u32;
                if Length > Payloadˉend - Payloadˉcursor { return Invalid; }
