        }
        if Catalog == 0u32 { return Invalid; }

        Cursor = End;
        let Parameterˉcount: u32 = Bytesˉreadˉu32ˉlittle(Input, Cursor);
        Cursor = Cursor + 4u32;
        if Catalog == 1u32 {
            if Parameterˉcount != 1u32 { return Invalid; }
            if Bytesˉreadˉu8(Input, Cursor) != 3u8 { return Invalid; }
            if Bytesˉreadˉu8(Input, Cursor + 1u32) != 0u8 { return Invalid; }
        }
        if Catalog == 2u32 {
            if Parameterˉcount != 1u32 { return Invalid; }
            if Bytesˉreadˉu8(Input, Cursor) != 3u8 { return Invalid; }
            if Bytesˉreadˉu8(Input, Cursor + 1u32) != 6u8 { return Invalid; }
        }
        if Catalog == 3u32 {
            if Parameterˉcount != 2u32 { return Invalid; }
