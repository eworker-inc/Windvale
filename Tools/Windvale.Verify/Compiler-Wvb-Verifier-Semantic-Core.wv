            if Matches { Catalog = 1u32; }
            Matches = true;
            if Bytesˉreadˉu32ˉlittle(Input, Name) != 1701080941u32 { Matches = false; }
            if Bytesˉreadˉu32ˉlittle(Input, Name + 4u32) != 1852386924u32 { Matches = false; }
