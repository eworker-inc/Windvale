                    }
                    if 4u32 > Payloadˉend - Payloadˉcursor { return Invalid; }
                    Count = Bytesˉreadˉu32ˉlittle(Input, Payloadˉcursor);
                    if Count > 4095u32 { return Invalid; }
                    Payloadˉcursor = Payloadˉcursor + 4u32;
                } else {
                if 4u32 > Payloadˉend - Payloadˉcursor { return Invalid; }
                Count = Bytesˉreadˉu32ˉlittle(Input, Payloadˉcursor);
                if Count < 1u32 { return Invalid; }
                if Raw == 1u32 {
                    if Count > 64u32 { return Invalid; }
                } else {
                    if Count > 256u32 { return Invalid; }
                }
                Payloadˉcursor = Payloadˉcursor + 4u32;
                Innerˉindex = 0u32;
                while Innerˉindex < Count {
                    if Payloadˉcursor > Payloadˉend { return Invalid; }
                    if 4u32 > Payloadˉend - Payloadˉcursor { return Invalid; }
                    Length = Bytesˉreadˉu32ˉlittle(Input, Payloadˉcursor);
                    if Length < 1u32 { return Invalid; }
                    if Length > 255u32 { return Invalid; }
                    Payloadˉcursor = Payloadˉcursor + 4u32;
                    if Length > Payloadˉend - Payloadˉcursor { return Invalid; }
                    Payloadˉcursor = Payloadˉcursor + Length;
                    if Raw == 1u32 {
                        if Payloadˉcursor >= Payloadˉend { return Invalid; }
                        Length = U32ˉfromˉu8(Bytesˉreadˉu8(Input, Payloadˉcursor));
                        if Length < 1u32 { return Invalid; }
                        if Length > 11u32 {
                            if !Bˉextendedˉshape(Minor, Length) { return Invalid; }
                        }
                        Payloadˉcursor = Payloadˉcursor + 1u32;
                        if Length == 7u32 || Length == 8u32 ||
                            Length == 11u32 || Length == 22u32 {
                            if 4u32 > Payloadˉend - Payloadˉcursor { return Invalid; }
                            Payloadˉcursor = Payloadˉcursor + 4u32;
                        }
                    } else if Raw == 2u32 {
                        if 4u32 > Payloadˉend - Payloadˉcursor { return Invalid; }
                        Payloadˉcursor = Payloadˉcursor + 4u32;
                    } else {
                        if Payloadˉcursor >= Payloadˉend { return Invalid; }
                        let Payloadˉpresent: u32 = U32ˉfromˉu8(
                            Bytesˉreadˉu8(Input, Payloadˉcursor)
                        );
                        if Payloadˉpresent > 2u32 { return Invalid; }
                        Payloadˉcursor = Payloadˉcursor + 1u32;
                        Payloadˉfields = 0u32;
                        if Payloadˉpresent == 1u32 { Payloadˉfields = 1u32; }
                        if Payloadˉpresent == 2u32 {
                            if Minor < 16u32 || Minor > 17u32 { return Invalid; }
                            if 4u32 > Payloadˉend - Payloadˉcursor {
                                return Invalid;
                            }
                            Payloadˉfields = Bytesˉreadˉu32ˉlittle(
                                Input, Payloadˉcursor
                            );
                            if Payloadˉfields < 2u32 || Payloadˉfields > 64u32 {
                                return Invalid;
                            }
                            Payloadˉcursor = Payloadˉcursor + 4u32;
                        }
                        Payloadˉfield = 0u32;
                        while Payloadˉfield < Payloadˉfields {
                            if 4u32 > Payloadˉend - Payloadˉcursor { return Invalid; }
                            Length = Bytesˉreadˉu32ˉlittle(Input, Payloadˉcursor);
                            if Length < 1u32 || Length > 255u32 { return Invalid; }
                            Payloadˉcursor = Payloadˉcursor + 4u32;
                            if Length > Payloadˉend - Payloadˉcursor { return Invalid; }
                            Payloadˉcursor = Payloadˉcursor + Length;
                            if Payloadˉcursor >= Payloadˉend { return Invalid; }
                            Length = U32ˉfromˉu8(Bytesˉreadˉu8(Input, Payloadˉcursor));
                            if Length < 1u32 { return Invalid; }
                            if Length > 11u32 {
                                if !Bˉextendedˉshape(Minor, Length) { return Invalid; }
                            }
                            Payloadˉcursor = Payloadˉcursor + 1u32;
                            if Length == 7u32 || Length == 8u32 ||
                                Length == 11u32 || Length == 22u32 {
                                if 4u32 > Payloadˉend - Payloadˉcursor { return Invalid; }
                                Payloadˉcursor = Payloadˉcursor + 4u32;
                            }
                            Payloadˉfield = Payloadˉfield + 1u32;
                        }
                    }
                    Innerˉindex = Innerˉindex + 1u32;
                }
                }
                Index = Index + 1u32;
            }
        }

        if Payloadˉcursor != Payloadˉend { return Invalid; }
        Cursor = Payloadˉend;
        Expectedˉkind = Expectedˉkind + 1u32;
    }

    if Cursor != Total { return Invalid; }
    return Input;
}



export fn Cˉmoduleˉandˉcapabilities(Input: bytes) -> bytes {
    let Invalid: bytes = Bytesˉslice(Input, 0u32, 0u32);
    let Moduleˉpayload: u32 = 20u32;
    let Profile: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(Input, Moduleˉpayload));
    let Moduleˉnameˉlength: u32 =
        Bytesˉreadˉu32ˉlittle(Input, Moduleˉpayload + 1u32);
    let Moduleˉname: u32 = Moduleˉpayload + 5u32;

    let Moduleˉnameˉbytes: bytes =
        Bytesˉslice(Input, Moduleˉname, Moduleˉnameˉlength);
    if Bytesˉlength(Aˉidentifier(Moduleˉnameˉbytes)) == 0u32 {
        return Invalid;
    }
    var Cursor: u32 = 0u32;
    var End: u32 = 0u32;
    var Currentˉbyte: u32 = 0u32;
    var Validˉpart: bool = false;

    let Moduleˉpayloadˉlength: u32 =
        Bytesˉreadˉu32ˉlittle(Input, 16u32);
    let Capabilityˉheader: u32 = 20u32 + Moduleˉpayloadˉlength;
    let Capabilityˉpayload: u32 = Capabilityˉheader + 8u32;
    let Count: u32 = Bytesˉreadˉu32ˉlittle(Input, Capabilityˉpayload);
    if Profile == 1u32 {
        if Count != 0u32 { return Invalid; }
    }

    Cursor = Capabilityˉpayload + 4u32;
    var Index: u32 = 0u32;
    var Previousˉname: u32 = 0u32;
    var Previousˉlength: u32 = 0u32;
    var Segmentˉstart: bool = true;
    var Dotˉseen: bool = false;
