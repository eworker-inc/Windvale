                        }
                        Budgetˉfunction = Functionˉindex;
                    } else if Minor == 23u32 || Minor == 24u32 ||
                        Minor == 25u32 || Minor == 26u32 ||
                        Minor == 27u32 || Minor == 28u32 {
                        if Shapeˉstage == 0u32 {
                            if !Isˉmain || Parameterˉcount != 1u32 ||
                                Shapeˉindex != 0u32 ||
                                Budgetˉfunction != 4294967295u32 {
                                return Invalid;
                            }
                            Budgetˉfunction = Functionˉindex;
                        } else if Shapeˉstage != 2u32 ||
                            !Isˉmain ||
                            Budgetˉfunction != Functionˉindex {
                            return Invalid;
                        }
                    } else if Minor == 33u32 || Minor == 34u32 ||
                        Minor == 35u32 || Minor == 36u32 || Minor == 37u32 {
                        if Shapeˉstage == 1u32 { return Invalid; }
                    } else if Minor != 32u32 {
                        return Invalid;
                    }
                }
                if Shapeˉstage == 1u32 &&
                    Budgetˉfunction == Functionˉindex &&
                    Rawˉshape != 1u32 {
                    return Invalid;
                }
                if Shapeˉstage == 1u32 &&
                    Sourceˉfileˉfunction == Functionˉindex &&
                    Rawˉshape != 1u32 {
                    return Invalid;
                }
                if Rawˉshape == 21u32 && Shapeˉstage != 1u32 {
                    return Invalid;
                }
                if Rawˉshape == 7u32 || Rawˉshape == 8u32 ||
                    Rawˉshape == 11u32 || Rawˉshape == 22u32 ||
                    Rawˉshape == 23u32 || Rawˉshape == 24u32 ||
                    Rawˉshape == 26u32 || Rawˉshape == 27u32 ||
                    Rawˉshape == 28u32 || Rawˉshape == 29u32 ||
                    Rawˉshape == 30u32 || Rawˉshape == 35u32 {
                    Nominalˉindex = Bytesˉreadˉu32ˉlittle(Input, Cursor);
                    if Nominalˉindex >= Typeˉcount { return Invalid; }
                    Cursor = Cursor + 4u32;
                    Typeˉcursor = Bˉtypeˉat(
                        Input, Typesˉpayload, Nominalˉindex
                    );
                    Typeˉkind = U32ˉfromˉu8(
                        Bytesˉreadˉu8(Input, Typeˉcursor)
                    );
                    if Rawˉshape == 7u32 || Rawˉshape == 28u32 {
                        if Typeˉkind != 1u32 { return Invalid; }
                    } else if Rawˉshape == 8u32 {
                        if Typeˉkind != 2u32 && Typeˉkind != 7u32 {
                            return Invalid;
                        }
                    } else if Rawˉshape == 11u32 || Rawˉshape == 29u32 {
                        if Typeˉkind != 3u32 { return Invalid; }
                    } else if Rawˉshape == 22u32 || Rawˉshape == 30u32 {
                        if Typeˉkind != 4u32 { return Invalid; }
                    } else if Rawˉshape == 23u32 ||
                        Rawˉshape == 26u32 || Rawˉshape == 27u32 {
                        if Typeˉkind != 5u32 { return Invalid; }
                    } else if Rawˉshape == 24u32 {
                        if Typeˉkind != 6u32 { return Invalid; }
                    } else {
                        if Typeˉkind != 8u32 ||
                            (Minor != 30u32 && Minor != 31u32 &&
                                Minor != 32u32 && Minor != 33u32 &&
                                Minor != 34u32 && Minor != 35u32 &&
                                Minor != 36u32 && Minor != 37u32) {
                            return Invalid;
                        }
                    }
                    var Aggregateˉkind: u32 = Rawˉshape;
                    if Rawˉshape == 28u32 { Aggregateˉkind = 7u32; }
                    if Rawˉshape == 29u32 { Aggregateˉkind = 11u32; }
                    if Rawˉshape == 30u32 { Aggregateˉkind = 22u32; }
                    let Isˉownedˉaggregate: bool =
                        Executableˉverifier.Hˉownedˉaggregate(
                            Input, Typesˉpayload, Typeˉcount,
                            Aggregateˉkind, Nominalˉindex, Minor
                        );
                    if Rawˉshape == 28u32 || Rawˉshape == 29u32 ||
                        Rawˉshape == 30u32 {
                        var Foundationˉview: bool = false;
                        if Declaredˉminor == 39u32 && Rawˉshape == 29u32 &&
                            Shapeˉstage == 2u32 {
                            Foundationˉview = Bytesˉreadˉu8(
                                Foundationˉtypes, Nominalˉindex * 11u32) == 1u8;
                        }
                        if !Isˉownedˉaggregate && !Foundationˉview { return Invalid; }
                        if Shapeˉstage == 0u32 &&
                            (Rawˉshape != 28u32 ||
                                !Executableˉverifier.Hˉunsafeˉscratchˉisˉexact(
                                    Input, Typesˉpayload, Typeˉcount,
                                    Nominalˉindex
                                )) {
                            return Invalid;
                        }
                    }
                    if Isˉownedˉaggregate {
                        if Minor < 28u32 || Minor > 37u32 { return Invalid; }
                        Ownedˉaggregateˉshapes = Ownedˉaggregateˉshapes + 1u32;
                    }
                }
                Shapeˉindex = Shapeˉindex + 1u32;
            }
        }
        Cursor = Cursor + 12u32;
        Previousˉname = Name;
        Previousˉlength = Nameˉlength;
        Functionˉindex = Functionˉindex + 1u32;
    }
    if (Minor == 21u32 || Minor == 23u32 || Minor == 24u32 ||
        Minor == 25u32 || Minor == 26u32 || Minor == 27u32 ||
        Minor == 28u32) &&
        Budgetˉfunction == 4294967295u32 {
        return Invalid;
    }
    if Minor == 26u32 && Vectorˉparameters == 0u32 { return Invalid; }
    if Minor == 28u32 && Ownedˉaggregateˉshapes == 0u32 { return Invalid; }
    if Minor == 29u32 && Sourceˉfileˉfunction == 4294967295u32 {
        return Invalid;
    }
    if Minor == 34u32 && Borrowedˉbudgetˉparameters == 0u32 { return Invalid; }
    return Input;
}

fn Fˉentryˉparameterˉis(
    Input: bytes,
    Name: u32,
    Nameˉlength: u32,
    Parameterˉcount: u32,
    Parameter: u32,
    Shape: u32
) -> bool {
    return Nameˉlength == 4u32 && Parameterˉcount == 1u32 &&
        U32ˉfromˉu8(Bytesˉreadˉu8(Input, Name)) == 77u32 &&
        U32ˉfromˉu8(Bytesˉreadˉu8(Input, Name + 1u32)) == 97u32 &&
        U32ˉfromˉu8(Bytesˉreadˉu8(Input, Name + 2u32)) == 105u32 &&
        U32ˉfromˉu8(Bytesˉreadˉu8(Input, Name + 3u32)) == 110u32 &&
        U32ˉfromˉu8(Bytesˉreadˉu8(Input, Parameter)) == Shape;
}

fn Fˉvectorˉgrowˉinstructionˉisˉvalid(
    Input: bytes,
    Instruction: u32,
    Minor: u32,
    Budgetˉmain: bool,
    Localˉslots: u32,
    Firstˉvariant: u32,
    Typeˉcount: u32,
    Vectorˉlocal: u32,
    Budgetˉlocal: u32
) -> bool {
    if (Minor < 27u32 || Minor > 37u32) || !Budgetˉmain ||
        Vectorˉlocal >= Localˉslots ||
        Budgetˉlocal >= Localˉslots ||
        Vectorˉlocal == Budgetˉlocal {
        return false;
    }
    let Resultˉtype: u32 = Bytesˉreadˉu32ˉlittle(
        Input, Instruction + 9u32
    );
    return Resultˉtype >= Firstˉvariant && Resultˉtype < Typeˉcount;
}

fn Fˉtaskˉinstructionˉisˉvalid(
    Input: bytes,
    Instruction: u32,
    Minor: u32,
    Opcode: u32,
    Localˉslots: u32,
    Firstˉenum: u32,
    Firstˉvariant: u32,
    Typeˉcount: u32
) -> bool {
    if Minor != 32u32 && Minor != 33u32 && Minor != 34u32 &&
        Minor != 35u32 && Minor != 36u32 && Minor != 37u32 { return false; }
    let Operand: u32 = Bytesˉreadˉu32ˉlittle(Input, Instruction + 1u32);
    if Operand >= Localˉslots { return false; }
    let Secondˉoperand: u32 = Bytesˉreadˉu32ˉlittle(
        Input, Instruction + 5u32
    );
    if Opcode == 214u32 || Opcode == 216u32 || Opcode == 218u32 {
        if Secondˉoperand < Firstˉvariant ||
            Secondˉoperand >= Typeˉcount {
            return false;
        }
    }
    if Opcode == 215u32 && Secondˉoperand >= Firstˉenum { return false; }
    let Thirdˉoperand: u32 = Bytesˉreadˉu32ˉlittle(
        Input, Instruction + 9u32
    );
    if Opcode == 216u32 && Thirdˉoperand >= Firstˉenum { return false; }
    if Opcode == 217u32 {
        if Secondˉoperand >= Localˉslots || Secondˉoperand == Operand ||
            Thirdˉoperand < Firstˉvariant || Thirdˉoperand >= Typeˉcount {
            return false;
        }
    }
    if Opcode == 219u32 &&
        U32ˉfromˉu8(Bytesˉreadˉu8(Input, Instruction + 5u32)) > 2u32 {
        return false;
    }
    return true;
}

fn Fˉfunctionˉlocalˉshapeˉis(
    Input: bytes,
    Parameterˉtypes: u32,
    Parameterˉcount: u32,
    Localˉtypes: u32,
    Localˉcount: u32,
    Slot: u32,
    Expected: u32
) -> bool {
    if Slot >= Parameterˉcount + Localˉcount { return false; }
    var Cursor: u32 = Parameterˉtypes;
    var Index: u32 = Slot;
    if Slot >= Parameterˉcount {
        Cursor = Localˉtypes;
        Index = Slot - Parameterˉcount;
    }
    var Current: u32 = 0u32;
    while Current < Index {
        Cursor = Bˉshapeˉend(Input, Cursor);
        Current = Current + 1u32;
    }
    return U32ˉfromˉu8(Bytesˉreadˉu8(Input, Cursor)) == Expected;
}

fn Fˉfunctionˉlocalˉnominal(
    Input: bytes,
    Parameterˉtypes: u32,
    Parameterˉcount: u32,
    Localˉtypes: u32,
    Localˉcount: u32,
    Slot: u32,
    Expectedˉkind: u32
) -> u32 {
    if Slot >= Parameterˉcount + Localˉcount {
        return 4294967295u32;
    }
    var Cursor: u32 = Parameterˉtypes;
    var Index: u32 = Slot;
    if Slot >= Parameterˉcount {
        Cursor = Localˉtypes;
        Index = Slot - Parameterˉcount;
    }
    var Current: u32 = 0u32;
    while Current < Index {
        Cursor = Bˉshapeˉend(Input, Cursor);
        Current = Current + 1u32;
    }
    if U32ˉfromˉu8(Bytesˉreadˉu8(Input, Cursor)) != Expectedˉkind {
        return 4294967295u32;
    }
    return Bytesˉreadˉu32ˉlittle(Input, Cursor + 1u32);
}

fn Fˉunsafeˉscratchˉlocalˉnominal(
    Input: bytes,
    Parameterˉtypes: u32,
    Parameterˉcount: u32,
    Localˉtypes: u32,
    Localˉcount: u32,
    Slot: u32
) -> u32 {
    let Owned: u32 = Fˉfunctionˉlocalˉnominal(
        Input, Parameterˉtypes, Parameterˉcount,
        Localˉtypes, Localˉcount, Slot, 7u32
    );
    if Owned != 4294967295u32 { return Owned; }
    return Fˉfunctionˉlocalˉnominal(
        Input, Parameterˉtypes, Parameterˉcount,
        Localˉtypes, Localˉcount, Slot, 28u32
    );
}

fn Fˉunsafeˉscratchˉlengthˉinstructionˉisˉvalid(
    Input: bytes,
    Instruction: u32,
    Minor: u32,
    Parameterˉtypes: u32,
    Parameterˉcount: u32,
    Localˉtypes: u32,
    Localˉcount: u32,
    Types: u32,
    Typeˉcount: u32
) -> bool {
    if Minor != 35u32 && Minor != 36u32 && Minor != 37u32 { return false; }
    let Scratchˉlocal: u32 = Bytesˉreadˉu32ˉlittle(
        Input, Instruction + 1u32
    );
    let Abiˉtype: u32 = Bytesˉreadˉu32ˉlittle(
        Input, Instruction + 5u32
    );
    let Scratchˉtype: u32 = Fˉunsafeˉscratchˉlocalˉnominal(
        Input, Parameterˉtypes, Parameterˉcount,
        Localˉtypes, Localˉcount, Scratchˉlocal
    );
    if Scratchˉtype >= Typeˉcount || Abiˉtype >= Typeˉcount ||
        !Executableˉverifier.Hˉunsafeˉscratchˉisˉexact(
            Input, Types, Typeˉcount, Scratchˉtype
        ) {
        return false;
    }
    let Abiˉkind: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(
        Input, Bˉtypeˉat(Input, Types, Abiˉtype)
    ));
    return Abiˉkind == 2u32 || Abiˉkind == 7u32;
}

fn Fˉunsafeˉscratchˉlengthˉrelations(
    Input: bytes,
    Instruction: u32,
    Minor: u32,
    Parameterˉtypes: u32,
    Parameterˉcount: u32,
    Localˉtypes: u32,
    Localˉcount: u32,
    Types: u32,
    Typeˉcount: u32,
    Relations: bytes
) -> bytes {
    if !Fˉunsafeˉscratchˉlengthˉinstructionˉisˉvalid(
            Input, Instruction, Minor,
            Parameterˉtypes, Parameterˉcount,
            Localˉtypes, Localˉcount, Types, Typeˉcount
        ) {
        return Bytesˉslice(Input, 0u32, 1u32);
    }
    let Scratchˉlocal: u32 = Bytesˉreadˉu32ˉlittle(
        Input, Instruction + 1u32
    );
    let Scratchˉtype: u32 = Fˉunsafeˉscratchˉlocalˉnominal(
        Input, Parameterˉtypes, Parameterˉcount,
        Localˉtypes, Localˉcount, Scratchˉlocal
    );
    let Abiˉtype: u32 = Bytesˉreadˉu32ˉlittle(Input, Instruction + 5u32);
    var Relation: u32 = 0u32;
    while Relation < Bytesˉlength(Relations) {
        if Bytesˉreadˉu32ˉlittle(Relations, Relation) == Scratchˉtype &&
            Bytesˉreadˉu32ˉlittle(Relations, Relation + 4u32) == Abiˉtype {
            return Relations;
        }
        Relation = Relation + 8u32;
    }
    if Bytesˉlength(Relations) >= 2048u32 {
        return Bytesˉslice(Input, 0u32, 1u32);
    }
    return Bytesˉconcat(
        Relations,
        Bytesˉconcat(
            Bytesˉfromˉu32ˉlittle(Scratchˉtype),
            Bytesˉfromˉu32ˉlittle(Abiˉtype)
        )
    );
}

fn Fˉunsafeˉscratchˉinstructionˉisˉvalid(
    Input: bytes,
    Instruction: u32,
    Minor: u32,
    Parameterˉtypes: u32,
    Parameterˉcount: u32,
    Localˉtypes: u32,
    Localˉcount: u32,
    Types: u32,
    Typeˉcount: u32
) -> bool {
    if Minor != 33u32 && Minor != 34u32 && Minor != 35u32 &&
        Minor != 36u32 && Minor != 37u32 {
        return false;
    }
    let Budget: u32 = Bytesˉreadˉu32ˉlittle(Input, Instruction + 1u32);
    let Resultˉtype: u32 = Bytesˉreadˉu32ˉlittle(Input, Instruction + 5u32);
    let Abiˉtype: u32 = Bytesˉreadˉu32ˉlittle(Input, Instruction + 9u32);
    if !Fˉfunctionˉlocalˉshapeˉis(
            Input, Parameterˉtypes, Parameterˉcount,
            Localˉtypes, Localˉcount, Budget, 25u32
        ) || Resultˉtype >= Typeˉcount || Abiˉtype >= Typeˉcount ||
        !Executableˉverifier.Hˉunsafeˉscratchˉresultˉisˉexact(
            Input, Types, Typeˉcount, Resultˉtype
        ) {
        return false;
    }
    let Abiˉkind: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(
        Input, Bˉtypeˉat(Input, Types, Abiˉtype)
    ));
    return Abiˉkind == 2u32 || Abiˉkind == 7u32;
}

fn Fˉunsafeˉscratchˉabiˉrelations(
    Input: bytes,
    Instruction: u32,
    Minor: u32,
    Parameterˉtypes: u32,
    Parameterˉcount: u32,
    Localˉtypes: u32,
    Localˉcount: u32,
    Types: u32,
    Typeˉcount: u32,
    Relations: bytes
) -> bytes {
    if !Fˉunsafeˉscratchˉinstructionˉisˉvalid(
            Input, Instruction, Minor,
            Parameterˉtypes, Parameterˉcount,
            Localˉtypes, Localˉcount, Types, Typeˉcount
        ) {
        return Bytesˉslice(Input, 0u32, 1u32);
    }
    let Resultˉtype: u32 = Bytesˉreadˉu32ˉlittle(Input, Instruction + 5u32);
    let Scratchˉtype: u32 =
        Executableˉverifier.Hˉunsafeˉscratchˉresultˉvalueˉtype(
            Input, Types, Typeˉcount, Resultˉtype
        );
    let Abiˉtype: u32 = Bytesˉreadˉu32ˉlittle(Input, Instruction + 9u32);
    var Relation: u32 = 0u32;
    var Found: bool = false;
    while Relation < Bytesˉlength(Relations) {
        if Bytesˉreadˉu32ˉlittle(Relations, Relation) == Scratchˉtype {
            if Bytesˉreadˉu32ˉlittle(Relations, Relation + 4u32) != Abiˉtype {
                return Bytesˉslice(Input, 0u32, 1u32);
            }
            Found = true;
        }
        Relation = Relation + 8u32;
    }
    if Found { return Relations; }
    if Bytesˉlength(Relations) >= 2048u32 {
        return Bytesˉslice(Input, 0u32, 1u32);
    }
    return Bytesˉconcat(
        Relations,
        Bytesˉconcat(
            Bytesˉfromˉu32ˉlittle(Scratchˉtype),
            Bytesˉfromˉu32ˉlittle(Abiˉtype)
        )
    );
}

fn Fˉunsafeˉscratchˉrelationsˉareˉcovered(
    Constructorˉrelations: bytes,
    Lengthˉrelations: bytes
) -> bool {
    var Lengthˉrelation: u32 = 0u32;
    while Lengthˉrelation < Bytesˉlength(Lengthˉrelations) {
        var Scratchˉrelation: u32 = 0u32;
        var Relationˉfound: bool = false;
        while Scratchˉrelation < Bytesˉlength(Constructorˉrelations) {
            if Bytesˉreadˉu32ˉlittle(
                    Lengthˉrelations, Lengthˉrelation
                ) == Bytesˉreadˉu32ˉlittle(
                    Constructorˉrelations, Scratchˉrelation
                ) &&
                Bytesˉreadˉu32ˉlittle(
                    Lengthˉrelations, Lengthˉrelation + 4u32
                ) == Bytesˉreadˉu32ˉlittle(
                    Constructorˉrelations, Scratchˉrelation + 4u32
                ) {
                Relationˉfound = true;
            }
            Scratchˉrelation = Scratchˉrelation + 8u32;
        }
        if !Relationˉfound { return false; }
        Lengthˉrelation = Lengthˉrelation + 8u32;
    }
    return true;
}

fn Fˉunsafeˉwriteˉregionˉinstructionˉisˉvalid(
    Input: bytes,
    Instruction: u32,
    Minor: u32,
    Parameterˉtypes: u32,
    Parameterˉcount: u32,
    Localˉtypes: u32,
    Localˉcount: u32,
    Types: u32,
    Typeˉcount: u32
) -> bool {
    if Minor != 36u32 && Minor != 37u32 { return false; }
    let Scratchˉlocal: u32 = Bytesˉreadˉu32ˉlittle(
        Input, Instruction + 1u32
    );
    let Resultˉtype: u32 = Bytesˉreadˉu32ˉlittle(
        Input, Instruction + 5u32
    );
    let Abiˉtype: u32 = Bytesˉreadˉu32ˉlittle(
        Input, Instruction + 9u32
    );
    let Ownedˉscratch: bool = Fˉfunctionˉlocalˉshapeˉis(
        Input, Parameterˉtypes, Parameterˉcount,
        Localˉtypes, Localˉcount, Scratchˉlocal, 7u32
    );
    let Borrowedˉscratch: bool = Scratchˉlocal < Parameterˉcount &&
        Fˉfunctionˉlocalˉshapeˉis(
            Input, Parameterˉtypes, Parameterˉcount,
            Localˉtypes, Localˉcount, Scratchˉlocal, 28u32
        );
    let Scratchˉtype: u32 = Fˉunsafeˉscratchˉlocalˉnominal(
        Input, Parameterˉtypes, Parameterˉcount,
        Localˉtypes, Localˉcount, Scratchˉlocal
    );
    if (!Ownedˉscratch && !Borrowedˉscratch) ||
        Scratchˉtype >= Typeˉcount || Resultˉtype >= Typeˉcount ||
        Abiˉtype >= Typeˉcount ||
        !Executableˉverifier.Hˉunsafeˉscratchˉisˉexact(
            Input, Types, Typeˉcount, Scratchˉtype
        ) ||
        !Executableˉverifier.Hˉunsafeˉwriteˉregionˉresultˉisˉexact(
            Input, Types, Typeˉcount, Resultˉtype
        ) {
        return false;
    }
    let Regionˉtype: u32 =
        Executableˉverifier.Hˉunsafeˉwriteˉregionˉresultˉvalueˉtype(
            Input, Types, Typeˉcount, Resultˉtype
        );
    if Regionˉtype >= Typeˉcount || Regionˉtype == Scratchˉtype {
        return false;
    }
    let Abiˉkind: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(
        Input, Bˉtypeˉat(Input, Types, Abiˉtype)
    ));
    return Abiˉkind == 2u32 || Abiˉkind == 7u32;
}

fn Fˉunsafeˉwriteˉregionˉrelations(
    Input: bytes,
    Instruction: u32,
    Minor: u32,
    Parameterˉtypes: u32,
    Parameterˉcount: u32,
    Localˉtypes: u32,
    Localˉcount: u32,
    Types: u32,
    Typeˉcount: u32,
    Relations: bytes
) -> bytes {
    if !Fˉunsafeˉwriteˉregionˉinstructionˉisˉvalid(
            Input, Instruction, Minor,
            Parameterˉtypes, Parameterˉcount,
            Localˉtypes, Localˉcount, Types, Typeˉcount
        ) {
        return Bytesˉslice(Input, 0u32, 1u32);
    }
    let Scratchˉlocal: u32 = Bytesˉreadˉu32ˉlittle(
        Input, Instruction + 1u32
    );
    let Scratchˉtype: u32 = Fˉunsafeˉscratchˉlocalˉnominal(
        Input, Parameterˉtypes, Parameterˉcount,
        Localˉtypes, Localˉcount, Scratchˉlocal
    );
    let Resultˉtype: u32 = Bytesˉreadˉu32ˉlittle(
        Input, Instruction + 5u32
    );
    let Regionˉtype: u32 =
        Executableˉverifier.Hˉunsafeˉwriteˉregionˉresultˉvalueˉtype(
            Input, Types, Typeˉcount, Resultˉtype
        );
    let Abiˉtype: u32 = Bytesˉreadˉu32ˉlittle(
        Input, Instruction + 9u32
    );
    var Relation: u32 = 0u32;
    var Found: bool = false;
    while Relation < Bytesˉlength(Relations) {
        let Existingˉscratch: u32 = Bytesˉreadˉu32ˉlittle(
            Relations, Relation
        );
        let Existingˉregion: u32 = Bytesˉreadˉu32ˉlittle(
            Relations, Relation + 4u32
        );
        let Existingˉabi: u32 = Bytesˉreadˉu32ˉlittle(
            Relations, Relation + 8u32
        );
        if (Existingˉscratch == Scratchˉtype &&
                (Existingˉregion != Regionˉtype ||
                    Existingˉabi != Abiˉtype)) ||
            (Existingˉregion == Regionˉtype &&
                (Existingˉscratch != Scratchˉtype ||
                    Existingˉabi != Abiˉtype)) {
            return Bytesˉslice(Input, 0u32, 1u32);
        }
        if Existingˉscratch == Scratchˉtype &&
            Existingˉregion == Regionˉtype && Existingˉabi == Abiˉtype {
            Found = true;
        }
        Relation = Relation + 12u32;
    }
    if Found { return Relations; }
    if Bytesˉlength(Relations) >= 3072u32 {
        return Bytesˉslice(Input, 0u32, 1u32);
    }
    return Bytesˉconcat(
        Relations,
        Bytesˉconcat(
            Bytesˉfromˉu32ˉlittle(Scratchˉtype),
            Bytesˉconcat(
                Bytesˉfromˉu32ˉlittle(Regionˉtype),
                Bytesˉfromˉu32ˉlittle(Abiˉtype)
            )
        )
    );
}

fn Fˉunsafeˉwriteˉregionˉrelationsˉareˉconsistent(
    Scratchˉrelations: bytes,
    Regionˉrelations: bytes
) -> bool {
    var Regionˉrelation: u32 = 0u32;
    while Regionˉrelation < Bytesˉlength(Regionˉrelations) {
        var Scratchˉrelation: u32 = 0u32;
        while Scratchˉrelation < Bytesˉlength(Scratchˉrelations) {
            if Bytesˉreadˉu32ˉlittle(
                    Regionˉrelations, Regionˉrelation
                ) == Bytesˉreadˉu32ˉlittle(
                    Scratchˉrelations, Scratchˉrelation
                ) && Bytesˉreadˉu32ˉlittle(
                    Regionˉrelations, Regionˉrelation + 8u32
                ) != Bytesˉreadˉu32ˉlittle(
                    Scratchˉrelations, Scratchˉrelation + 4u32
                ) {
                return false;
            }
            Scratchˉrelation = Scratchˉrelation + 8u32;
        }
        Regionˉrelation = Regionˉrelation + 12u32;
    }
    return true;
}

fn Fˉunsafeˉwriteˉpointerˉinstructionˉisˉvalid(
    Input: bytes,
    Instruction: u32,
    Minor: u32,
    Parameterˉtypes: u32,
    Parameterˉcount: u32,
    Localˉtypes: u32,
    Localˉcount: u32,
    Types: u32,
    Typeˉcount: u32
) -> bool {
    if Minor != 37u32 { return false; }
    let Regionˉlocal: u32 = Bytesˉreadˉu32ˉlittle(
        Input, Instruction + 1u32
    );
    let Pointerˉtype: u32 = Bytesˉreadˉu32ˉlittle(
        Input, Instruction + 5u32
    );
    let Abiˉtype: u32 = Bytesˉreadˉu32ˉlittle(
        Input, Instruction + 9u32
    );
    if Regionˉlocal >= Parameterˉcount + Localˉcount ||
        Pointerˉtype >= Typeˉcount || Abiˉtype >= Typeˉcount ||
        (!Fˉfunctionˉlocalˉshapeˉis(
                Input, Parameterˉtypes, Parameterˉcount,
                Localˉtypes, Localˉcount, Regionˉlocal, 7u32
            ) && (Regionˉlocal >= Parameterˉcount ||
                !Fˉfunctionˉlocalˉshapeˉis(
                    Input, Parameterˉtypes, Parameterˉcount,
                    Localˉtypes, Localˉcount, Regionˉlocal, 28u32
                ))) {
        return false;
    }
    let Regionˉtype: u32 = Fˉunsafeˉscratchˉlocalˉnominal(
        Input, Parameterˉtypes, Parameterˉcount,
        Localˉtypes, Localˉcount, Regionˉlocal
    );
    if Regionˉtype >= Typeˉcount || Regionˉtype == Pointerˉtype ||
        !Executableˉverifier.Hˉunsafeˉscratchˉisˉexact(
            Input, Types, Typeˉcount, Regionˉtype
        ) || !Executableˉverifier.Hˉunsafeˉscratchˉisˉexact(
            Input, Types, Typeˉcount, Pointerˉtype
        ) {
        return false;
    }
    let Abiˉkind: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(
        Input, Bˉtypeˉat(Input, Types, Abiˉtype)
    ));
    return Abiˉkind == 2u32 || Abiˉkind == 7u32;
}

fn Fˉunsafeˉwriteˉpointerˉrelations(
    Input: bytes,
    Instruction: u32,
    Minor: u32,
    Parameterˉtypes: u32,
    Parameterˉcount: u32,
    Localˉtypes: u32,
    Localˉcount: u32,
    Types: u32,
    Typeˉcount: u32,
    Relations: bytes
) -> bytes {
    if !Fˉunsafeˉwriteˉpointerˉinstructionˉisˉvalid(
            Input, Instruction, Minor,
            Parameterˉtypes, Parameterˉcount,
            Localˉtypes, Localˉcount, Types, Typeˉcount
        ) {
        return Bytesˉslice(Input, 0u32, 1u32);
    }
    let Regionˉlocal: u32 = Bytesˉreadˉu32ˉlittle(
        Input, Instruction + 1u32
    );
    let Regionˉtype: u32 = Fˉunsafeˉscratchˉlocalˉnominal(
        Input, Parameterˉtypes, Parameterˉcount,
        Localˉtypes, Localˉcount, Regionˉlocal
    );
    let Pointerˉtype: u32 = Bytesˉreadˉu32ˉlittle(
        Input, Instruction + 5u32
    );
    let Abiˉtype: u32 = Bytesˉreadˉu32ˉlittle(
        Input, Instruction + 9u32
    );
    var Relation: u32 = 0u32;
    var Found: bool = false;
    while Relation < Bytesˉlength(Relations) {
        let Existingˉregion: u32 = Bytesˉreadˉu32ˉlittle(
            Relations, Relation
        );
        let Existingˉpointer: u32 = Bytesˉreadˉu32ˉlittle(
            Relations, Relation + 4u32
        );
        let Existingˉabi: u32 = Bytesˉreadˉu32ˉlittle(
            Relations, Relation + 8u32
        );
        if (Existingˉregion == Regionˉtype &&
                (Existingˉpointer != Pointerˉtype ||
                    Existingˉabi != Abiˉtype)) ||
            (Existingˉpointer == Pointerˉtype &&
                (Existingˉregion != Regionˉtype ||
                    Existingˉabi != Abiˉtype)) {
            return Bytesˉslice(Input, 0u32, 1u32);
        }
        if Existingˉregion == Regionˉtype &&
            Existingˉpointer == Pointerˉtype && Existingˉabi == Abiˉtype {
            Found = true;
        }
        Relation = Relation + 12u32;
    }
    if Found { return Relations; }
    if Bytesˉlength(Relations) >= 3072u32 {
        return Bytesˉslice(Input, 0u32, 1u32);
    }
    return Bytesˉconcat(
        Relations,
        Bytesˉconcat(
            Bytesˉfromˉu32ˉlittle(Regionˉtype),
            Bytesˉconcat(
                Bytesˉfromˉu32ˉlittle(Pointerˉtype),
                Bytesˉfromˉu32ˉlittle(Abiˉtype)
            )
        )
    );
}

fn Fˉunsafeˉwriteˉpointerˉrelationsˉareˉconsistent(
    Regionˉrelations: bytes,
    Pointerˉrelations: bytes
) -> bool {
    var Pointerˉrelation: u32 = 0u32;
    while Pointerˉrelation < Bytesˉlength(Pointerˉrelations) {
        let Pointerˉregion: u32 = Bytesˉreadˉu32ˉlittle(
            Pointerˉrelations, Pointerˉrelation
        );
        let Pointerˉtype: u32 = Bytesˉreadˉu32ˉlittle(
            Pointerˉrelations, Pointerˉrelation + 4u32
        );
        let Pointerˉabi: u32 = Bytesˉreadˉu32ˉlittle(
            Pointerˉrelations, Pointerˉrelation + 8u32
        );
        var Regionˉrelation: u32 = 0u32;
        while Regionˉrelation < Bytesˉlength(Regionˉrelations) {
            let Scratchˉtype: u32 = Bytesˉreadˉu32ˉlittle(
                Regionˉrelations, Regionˉrelation
            );
            let Regionˉtype: u32 = Bytesˉreadˉu32ˉlittle(
                Regionˉrelations, Regionˉrelation + 4u32
            );
            let Regionˉabi: u32 = Bytesˉreadˉu32ˉlittle(
                Regionˉrelations, Regionˉrelation + 8u32
            );
            if Pointerˉregion == Scratchˉtype ||
                Pointerˉtype == Scratchˉtype || Pointerˉtype == Regionˉtype {
                return false;
            }
            if Pointerˉregion == Regionˉtype && Pointerˉabi != Regionˉabi {
                return false;
            }
            Regionˉrelation = Regionˉrelation + 12u32;
        }
        Pointerˉrelation = Pointerˉrelation + 12u32;
    }
    return true;
}

fn Fˉforeignˉcallˉrelations(
    Input: bytes,
    Instruction: u32,
    Declaredˉminor: u32,
    Types: u32,
    Typeˉcount: u32,
    Relations: bytes
) -> bytes {
    let Binding: u32 = Bytesˉreadˉu32ˉlittle(Input, Instruction + 1u32);
    let Pointerˉtype: u32 = Bytesˉreadˉu32ˉlittle(
        Input, Instruction + 5u32
    );
    let Abiˉtype: u32 = Bytesˉreadˉu32ˉlittle(
        Input, Instruction + 9u32
    );
    if (Declaredˉminor != 38u32 && Declaredˉminor != 39u32) || Binding != 1u32 ||
        Pointerˉtype >= Typeˉcount || Abiˉtype >= Typeˉcount ||
        !Executableˉverifier.Hˉunsafeˉscratchˉisˉexact(
            Input, Types, Typeˉcount, Pointerˉtype
        ) {
        return Bytesˉslice(Input, 0u32, 1u32);
    }
    let Abiˉkind: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(
        Input, Bˉtypeˉat(Input, Types, Abiˉtype)
    ));
    if Abiˉkind != 2u32 && Abiˉkind != 7u32 {
        return Bytesˉslice(Input, 0u32, 1u32);
    }
    var Relation: u32 = 0u32;
    var Found: bool = false;
    while Relation < Bytesˉlength(Relations) {
        let Existingˉpointer: u32 = Bytesˉreadˉu32ˉlittle(
            Relations, Relation
        );
        let Existingˉabi: u32 = Bytesˉreadˉu32ˉlittle(
            Relations, Relation + 4u32
        );
        if (Existingˉpointer == Pointerˉtype && Existingˉabi != Abiˉtype) ||
            (Existingˉabi == Abiˉtype && Existingˉpointer != Pointerˉtype) {
            return Bytesˉslice(Input, 0u32, 1u32);
        }
        if Existingˉpointer == Pointerˉtype && Existingˉabi == Abiˉtype {
            Found = true;
        }
        Relation = Relation + 8u32;
    }
    if Found { return Relations; }
    if Bytesˉlength(Relations) >= 2048u32 {
        return Bytesˉslice(Input, 0u32, 1u32);
    }
    return Bytesˉconcat(
        Relations,
        Bytesˉconcat(
            Bytesˉfromˉu32ˉlittle(Pointerˉtype),
            Bytesˉfromˉu32ˉlittle(Abiˉtype)
        )
    );
}

fn Fˉforeignˉcallˉrelationsˉareˉconsistent(
    Pointerˉrelations: bytes,
    Foreignˉrelations: bytes
) -> bool {
    var Foreignˉrelation: u32 = 0u32;
    while Foreignˉrelation < Bytesˉlength(Foreignˉrelations) {
        let Foreignˉpointer: u32 = Bytesˉreadˉu32ˉlittle(
            Foreignˉrelations, Foreignˉrelation
        );
        let Foreignˉabi: u32 = Bytesˉreadˉu32ˉlittle(
            Foreignˉrelations, Foreignˉrelation + 4u32
        );
        var Pointerˉrelation: u32 = 0u32;
        while Pointerˉrelation < Bytesˉlength(Pointerˉrelations) {
            if Bytesˉreadˉu32ˉlittle(
                    Pointerˉrelations, Pointerˉrelation + 4u32
                ) == Foreignˉpointer && Bytesˉreadˉu32ˉlittle(
                    Pointerˉrelations, Pointerˉrelation + 8u32
                ) != Foreignˉabi {
                return false;
            }
            Pointerˉrelation = Pointerˉrelation + 12u32;
        }
        Foreignˉrelation = Foreignˉrelation + 8u32;
    }
    return true;
}

fn Fˉboundaryˉinstructionˉwidth(Opcode: u32) -> u32 {
    if Opcode == 2u32 || Opcode == 8u32 { return 2u32; }
    if Opcode == 1u32 || (Opcode >= 3u32 && Opcode <= 7u32) ||
        Opcode == 9u32 || Opcode == 10u32 || Opcode == 48u32 ||
        Opcode == 49u32 || Opcode == 64u32 || Opcode == 65u32 ||
        Opcode == 104u32 || Opcode == 105u32 || Opcode == 197u32 ||
        Opcode == 199u32 || Opcode == 200u32 ||
        (Opcode >= 202u32 && Opcode <= 205u32) || Opcode == 210u32 ||
        Opcode == 212u32 {
        return 5u32;
    }
    if Opcode == 106u32 || Opcode == 128u32 || Opcode == 129u32 ||
        (Opcode >= 151u32 && Opcode <= 154u32) || Opcode == 196u32 ||
        Opcode == 201u32 || Opcode == 206u32 || Opcode == 207u32 ||
        Opcode == 208u32 || Opcode == 211u32 || Opcode == 214u32 ||
        Opcode == 215u32 || Opcode == 218u32 {
        return 9u32;
    }
    if Opcode == 221u32 { return 9u32; }
    if Opcode == 209u32 || Opcode == 213u32 || Opcode == 216u32 ||
        Opcode == 217u32 || Opcode == 220u32 || Opcode == 222u32 ||
        Opcode == 223u32 || Opcode == 224u32 || Opcode == 225u32 {
        return 13u32;
    }
    if Opcode == 219u32 { return 6u32; }
    return 1u32;
}

fn Fˉsameˉshape(Input: bytes, Left: u32, Right: u32) -> bool {
    let Leftˉend: u32 = Bˉshapeˉend(Input, Left);
    let Rightˉend: u32 = Bˉshapeˉend(Input, Right);
    let Leftˉlength: u32 = Leftˉend - Left;
    let Rightˉlength: u32 = Rightˉend - Right;
    if Leftˉlength != Rightˉlength { return false; }
    var Index: u32 = 0u32;
    while Index < Leftˉlength {
        if U32ˉfromˉu8(Bytesˉreadˉu8(Input, Left + Index)) !=
            U32ˉfromˉu8(Bytesˉreadˉu8(Input, Right + Index)) {
            return false;
        }
        Index = Index + 1u32;
    }
    return true;
}

fn Fˉnextˉfunction(Input: bytes, Cursor: u32) -> u32 {
    let Nameˉlength: u32 = Bytesˉreadˉu32ˉlittle(Input, Cursor);
    var Next: u32 = Cursor + 4u32 + Nameˉlength;
    let Parameters: u32 = Bytesˉreadˉu32ˉlittle(Input, Next);
    Next = Next + 4u32;
    var Shape: u32 = 0u32;
    while Shape < Parameters + 1u32 {
        Next = Bˉshapeˉend(Input, Next);
        Shape = Shape + 1u32;
    }
    let Locals: u32 = Bytesˉreadˉu32ˉlittle(Input, Next);
    Next = Next + 4u32;
    Shape = 0u32;
    while Shape < Locals {
        Next = Bˉshapeˉend(Input, Next);
        Shape = Shape + 1u32;
    }
    return Next + 12u32;
}

fn Fˉcallableˉfunctionˉmatches(
    Input: bytes,
    Functions: u32,
    Functionˉcount: u32,
    Types: u32,
    Typeˉcount: u32,
    Targetˉindex: u32,
    Callableˉtype: u32
) -> bool {
    if Targetˉindex >= Functionˉcount || Callableˉtype >= Typeˉcount {
        return false;
    }
    let Descriptor: u32 = Bˉtypeˉat(Input, Types, Callableˉtype);
    if U32ˉfromˉu8(Bytesˉreadˉu8(Input, Descriptor)) != 8u32 {
        return false;
    }
    var Target: u32 = Functions + 4u32;
    var Functionˉindex: u32 = 0u32;
    while Functionˉindex < Targetˉindex {
        Target = Fˉnextˉfunction(Input, Target);
        Functionˉindex = Functionˉindex + 1u32;
    }
    let Nameˉlength: u32 = Bytesˉreadˉu32ˉlittle(Input, Target);
    Target = Target + 4u32 + Nameˉlength;
    let Parameters: u32 = Bytesˉreadˉu32ˉlittle(Input, Target);
    Target = Target + 4u32;
    var Descriptorˉshape: u32 = Descriptor + 2u32;
    let Descriptorˉreturn: u32 = Descriptorˉshape;
    Descriptorˉshape = Bˉshapeˉend(Input, Descriptorˉshape);
    let Descriptorˉparameters: u32 = Bytesˉreadˉu32ˉlittle(
        Input, Descriptorˉshape
    );
    Descriptorˉshape = Descriptorˉshape + 4u32;
    if Parameters != Descriptorˉparameters { return false; }
    var Parameter: u32 = 0u32;
    while Parameter < Parameters {
        if !Fˉsameˉshape(Input, Target, Descriptorˉshape) { return false; }
        Target = Bˉshapeˉend(Input, Target);
        Descriptorˉshape = Bˉshapeˉend(Input, Descriptorˉshape);
        Parameter = Parameter + 1u32;
    }
    return Fˉsameˉshape(Input, Target, Descriptorˉreturn);
}

fn Fˉclosureˉcaptureˉshapeˉisˉcopyable(
    Input: bytes,
    Shape: u32
) -> bool {
    let Kind: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(Input, Shape));
    return Kind == 1u32 || Kind == 2u32 || Kind == 4u32 ||
        Kind == 5u32 || Kind == 8u32 || Kind == 9u32 || Kind == 10u32 ||
        (Kind >= 14u32 && Kind <= 19u32);
}

fn Fˉclosureˉfunctionˉmatches(
    Input: bytes,
    Functions: u32,
    Functionˉcount: u32,
    Types: u32,
    Typeˉcount: u32,
    Targetˉindex: u32,
    Callableˉtype: u32,
    Captures: u32
) -> bool {
    if Captures < 1u32 || Captures > 64u32 ||
        Targetˉindex >= Functionˉcount || Callableˉtype >= Typeˉcount {
        return false;
    }
    let Descriptor: u32 = Bˉtypeˉat(Input, Types, Callableˉtype);
    if U32ˉfromˉu8(Bytesˉreadˉu8(Input, Descriptor)) != 8u32 {
        return false;
    }
    var Target: u32 = Functions + 4u32;
    var Functionˉindex: u32 = 0u32;
    while Functionˉindex < Targetˉindex {
        Target = Fˉnextˉfunction(Input, Target);
        Functionˉindex = Functionˉindex + 1u32;
    }
    let Nameˉlength: u32 = Bytesˉreadˉu32ˉlittle(Input, Target);
    Target = Target + 4u32 + Nameˉlength;
    let Parameters: u32 = Bytesˉreadˉu32ˉlittle(Input, Target);
    Target = Target + 4u32;
    var Descriptorˉshape: u32 = Descriptor + 2u32;
    let Descriptorˉreturn: u32 = Descriptorˉshape;
    Descriptorˉshape = Bˉshapeˉend(Input, Descriptorˉshape);
    let Descriptorˉparameters: u32 = Bytesˉreadˉu32ˉlittle(
        Input, Descriptorˉshape
    );
    Descriptorˉshape = Descriptorˉshape + 4u32;
    if Parameters != Captures + Descriptorˉparameters { return false; }
    var Capture: u32 = 0u32;
    while Capture < Captures {
        if !Fˉclosureˉcaptureˉshapeˉisˉcopyable(Input, Target) {
            return false;
        }
        Target = Bˉshapeˉend(Input, Target);
        Capture = Capture + 1u32;
    }
    var Parameter: u32 = 0u32;
    while Parameter < Descriptorˉparameters {
        if !Fˉsameˉshape(Input, Target, Descriptorˉshape) { return false; }
        Target = Bˉshapeˉend(Input, Target);
        Descriptorˉshape = Bˉshapeˉend(Input, Descriptorˉshape);
        Parameter = Parameter + 1u32;
    }
    return Fˉsameˉshape(Input, Target, Descriptorˉreturn);
}

fn Fˉexportsˉareˉvalid(
    Input: bytes,
    Minor: u32,
    Exportsˉpayload: u32,
    Functionsˉpayload: u32,
    Functionˉcount: u32,
    Budgetˉmainˉpresent: bool
) -> bool {
    let Exportˉcount: u32 = Bytesˉreadˉu32ˉlittle(Input, Exportsˉpayload);
    var Exportˉcursor: u32 = Exportsˉpayload + 4u32;
    var Exportˉindex: u32 = 0u32;
    var Previousˉexport: u32 = 0u32;
    var Previousˉexportˉlength: u32 = 0u32;
    var Budgetˉmainˉexported: bool = false;
    while Exportˉindex < Exportˉcount {
        let Exportˉnameˉlength: u32 = Bytesˉreadˉu32ˉlittle(
            Input, Exportˉcursor
        );
        let Exportˉname: u32 = Exportˉcursor + 4u32;
        if Exportˉindex > 0u32 {
            var Compare: u32 = 0u32;
            var Compareˉindex: u32 = 0u32;
            var Compareˉlength: u32 = Previousˉexportˉlength;
            if Exportˉnameˉlength < Compareˉlength {
                Compareˉlength = Exportˉnameˉlength;
            }
            while Compareˉindex < Compareˉlength {
                if Compare == 0u32 {
                    let Previousˉexportˉbyte: u32 = U32ˉfromˉu8(
                        Bytesˉreadˉu8(
                            Input,
                            Previousˉexport + Compareˉindex
                        )
                    );
                    let Currentˉexportˉbyte: u32 = U32ˉfromˉu8(
                        Bytesˉreadˉu8(Input, Exportˉname + Compareˉindex)
                    );
                    if Previousˉexportˉbyte < Currentˉexportˉbyte {
                        Compare = 1u32;
                    }
                    if Previousˉexportˉbyte > Currentˉexportˉbyte {
                        Compare = 2u32;
                    }
                }
                Compareˉindex = Compareˉindex + 1u32;
            }
            if Compare == 0u32 {
                if Previousˉexportˉlength < Exportˉnameˉlength {
                    Compare = 1u32;
                } else {
                    Compare = 2u32;
                }
            }
            if Compare != 1u32 { return false; }
        }
        Exportˉcursor = Exportˉname + Exportˉnameˉlength + 1u32;
        let Exportˉtarget: u32 = Bytesˉreadˉu32ˉlittle(
            Input, Exportˉcursor
        );
        if Exportˉtarget >= Functionˉcount { return false; }
        var Targetˉfunction: u32 = Functionsˉpayload + 4u32;
        var Targetˉfunctionˉindex: u32 = 0u32;
        while Targetˉfunctionˉindex < Exportˉtarget {
            Targetˉfunction = Fˉnextˉfunction(Input, Targetˉfunction);
            Targetˉfunctionˉindex = Targetˉfunctionˉindex + 1u32;
        }
        let Targetˉnameˉlength: u32 = Bytesˉreadˉu32ˉlittle(
            Input, Targetˉfunction
        );
        let Targetˉname: u32 = Targetˉfunction + 4u32;
        if Targetˉnameˉlength != Exportˉnameˉlength { return false; }
        var Nameˉindex: u32 = 0u32;
        while Nameˉindex < Exportˉnameˉlength {
            if Bytesˉreadˉu8(Input, Targetˉname + Nameˉindex) !=
                Bytesˉreadˉu8(Input, Exportˉname + Nameˉindex) {
                return false;
            }
            Nameˉindex = Nameˉindex + 1u32;
        }
        if Targetˉnameˉlength == 4u32 &&
            U32ˉfromˉu8(Bytesˉreadˉu8(Input, Targetˉname)) == 77u32 &&
            U32ˉfromˉu8(Bytesˉreadˉu8(Input, Targetˉname + 1u32)) == 97u32 &&
            U32ˉfromˉu8(Bytesˉreadˉu8(Input, Targetˉname + 2u32)) == 105u32 &&
            U32ˉfromˉu8(Bytesˉreadˉu8(Input, Targetˉname + 3u32)) == 110u32 {
            let Targetˉsignature: u32 = Targetˉname + Targetˉnameˉlength;
            if Bytesˉreadˉu32ˉlittle(Input, Targetˉsignature) == 1u32 &&
                U32ˉfromˉu8(Bytesˉreadˉu8(
                    Input, Targetˉsignature + 4u32
                )) == 25u32 {
                Budgetˉmainˉexported = true;
            }
        }
        Exportˉcursor = Exportˉcursor + 4u32;
        Previousˉexport = Exportˉname;
        Previousˉexportˉlength = Exportˉnameˉlength;
        Exportˉindex = Exportˉindex + 1u32;
    }
    if (Minor == 21u32 || Budgetˉmainˉpresent) &&
        !Budgetˉmainˉexported {
        return false;
    }
    return true;
}

export fn Fˉinstructionˉauthority(Declaredˉminor: u32, Profile: u8, Opcode: u32) -> bool {
    if Declaredˉminor != 39u32 { return true; }
    if Opcode >= 220u32 && Opcode <= 224u32 { return Profile == 3u8; }
    if Opcode == 210u32 || (Opcode >= 214u32 && Opcode <= 219u32) {
        return Profile == 2u8 || Profile == 3u8;
    }
    return Profile == 1u8 || Profile == 2u8 || Profile == 3u8;
}


export fn Fˉcodeˉandˉexports(Input: bytes) -> bytes {
    let Invalid: bytes = Bytesˉslice(Input, 0u32, 0u32);
    let Declaredˉminor: u32 = Bytesˉreadˉu16ˉlittle(Input, 6u32);
    let Minor: u32 = Bˉeffectiveˉminor(Input);
    var Header: u32 = 12u32;
    var Section: u32 = 1u32;
    var Capabilitiesˉpayload: u32 = 0u32;
    var Dataˉpayload: u32 = 0u32;
    var Functionsˉpayload: u32 = 0u32;
    var Codeˉpayload: u32 = 0u32;
    var Exportsˉpayload: u32 = 0u32;
    var Typesˉpayload: u32 = 0u32;
    while Section <= 7u32 {
        if Section == 2u32 { Capabilitiesˉpayload = Header + 8u32; }
        if Section == 3u32 { Dataˉpayload = Header + 8u32; }
        if Section == 4u32 { Functionsˉpayload = Header + 8u32; }
        if Section == 5u32 { Codeˉpayload = Header + 8u32; }
        if Section == 6u32 { Exportsˉpayload = Header + 8u32; }
        if Section == 7u32 { Typesˉpayload = Header + 8u32; }
        Header = Header + 8u32 + Bytesˉreadˉu32ˉlittle(Input, Header + 4u32);
        Section = Section + 1u32;
    }
    let Capabilityˉcount: u32 =
        Bytesˉreadˉu32ˉlittle(Input, Capabilitiesˉpayload);
    let Dataˉcount: u32 = Bytesˉreadˉu32ˉlittle(Input, Dataˉpayload);
    let Functionˉcount: u32 =
        Bytesˉreadˉu32ˉlittle(Input, Functionsˉpayload);
    let Typeˉcount: u32 = Bytesˉreadˉu32ˉlittle(Input, Typesˉpayload);

    var Foundationˉtypes: bytes = Invalid;
    if Declaredˉminor == 39u32 {
        Foundationˉtypes = Executableˉverifier.Hˉfoundationˉtypes(
            Input, Typesˉpayload, Typeˉcount);
        if Bytesˉlength(Foundationˉtypes) != Typeˉcount * 11u32 { return Invalid; }
    }
    var Typeˉcursor: u32 = Typesˉpayload + 4u32;
    var Typeˉindex: u32 = 0u32;
    var Typeˉkind: u32 = 0u32;
    var Typeˉnameˉlength: u32 = 0u32;
    var Typeˉitemˉcount: u32 = 0u32;
    var Typeˉitemˉindex: u32 = 0u32;
    var Typeˉitemˉlength: u32 = 0u32;
    var Typeˉshape: u32 = 0u32;
    var Firstˉenum: u32 = Typeˉcount;
    var Firstˉvariant: u32 = Typeˉcount;
    var Firstˉarray: u32 = Typeˉcount;
    var Firstˉvector: u32 = Typeˉcount;
