            if Bytesˉreadˉu32ˉlittle(Input, Name + 8u32) != 1650419060u32 { Matches = false; }
            if Bytesˉreadˉu32ˉlittle(Input, Name + 12u32) != 1936028793u32 { Matches = false; }
            if Matches { Catalog = 3u32; }
            Matches = true;
