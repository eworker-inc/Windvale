            if Bytesˉreadˉu32ˉlittle(Input, Name) != 1668248176u32 { Matches = false; }
            if Bytesˉreadˉu32ˉlittle(Input, Name + 4u32) != 779318117u32 { Matches = false; }
            if Bytesˉreadˉu32ˉlittle(Input, Name + 8u32) != 1969713761u32 { Matches = false; }
            if Bytesˉreadˉu32ˉlittle(Input, Name + 12u32) != 1953391981u32 { Matches = false; }
            if Bytesˉreadˉu32ˉlittle(Input, Name + 16u32) != 1970234207u32 { Matches = false; }
            if Bytesˉreadˉu16ˉlittle(Input, Name + 20u32) != 29806u32 { Matches = false; }
