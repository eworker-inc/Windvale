                if Rawˉshape == 36u32 {
                    if (Minor != 34u32 && Minor != 35u32 &&
                        Minor != 36u32 && Minor != 37u32) ||
                        Shapeˉstage == 1u32 {
                        return Invalid;
                    }
                    if Shapeˉstage == 0u32 {
                        Borrowedˉbudgetˉparameters =
                            Borrowedˉbudgetˉparameters + 1u32;
                    }
                }
                if Rawˉshape == 35u32 && Minor != 30u32 &&
                    Minor != 31u32 && Minor != 32u32 && Minor != 33u32 &&
                    Minor != 34u32 && Minor != 35u32 && Minor != 36u32 &&
                    Minor != 37u32 {
                    return Invalid;
                }
                if Rawˉshape == 34u32 {
