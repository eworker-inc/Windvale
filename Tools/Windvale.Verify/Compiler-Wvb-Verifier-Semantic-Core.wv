            if Bytesˉreadˉu32ˉlittle(Input, Name + 16u32) != 1852402783u32 { Matches = false; }
            if Bytesˉreadˉu8(Input, Name + 20u32) != 101u8 { Matches = false; }
            if Matches { Catalog = 1u32; }
        }
        if Nameˉlength == 22u32 {
            Matches = true;
            if Bytesˉreadˉu32ˉlittle(Input, Name) != 1668248176u32 { Matches = false; }
            if Bytesˉreadˉu32ˉlittle(Input, Name + 4u32) != 779318117u32 { Matches = false; }
            if Bytesˉreadˉu32ˉlittle(Input, Name + 8u32) != 1969713761u32 { Matches = false; }
            if Bytesˉreadˉu32ˉlittle(Input, Name + 12u32) != 1953391981u32 { Matches = false; }
            if Bytesˉreadˉu32ˉlittle(Input, Name + 16u32) != 1970234207u32 { Matches = false; }
            if Bytesˉreadˉu16ˉlittle(Input, Name + 20u32) != 29806u32 { Matches = false; }
            if Matches { Catalog = 5u32; }
        }
        if Nameˉlength == 24u32 {
            Matches = true;
            if Bytesˉreadˉu32ˉlittle(Input, Name) != 1919906931u32 { Matches = false; }
            if Bytesˉreadˉu32ˉlittle(Input, Name + 4u32) != 778397537u32 { Matches = false; }
            if Bytesˉreadˉu32ˉlittle(Input, Name + 8u32) != 1684955506u32 { Matches = false; }
            if Bytesˉreadˉu32ˉlittle(Input, Name + 12u32) != 1633643887u32 { Matches = false; }
            if Bytesˉreadˉu32ˉlittle(Input, Name + 16u32) != 1936024419u32 { Matches = false; }
            if Bytesˉreadˉu32ˉlittle(Input, Name + 20u32) != 829841267u32 { Matches = false; }
