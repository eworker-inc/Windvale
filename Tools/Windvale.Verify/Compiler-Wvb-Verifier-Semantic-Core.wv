            if Bytesˉreadˉu32ˉlittle(Input, Name + 20u32) != 829841253u32 { Matches = false; }
            if Matches { Catalog = 8u32; }
        }
        if Nameˉlength == 28u32 {
            Matches = true;
            if Bytesˉreadˉu32ˉlittle(Input, Name) != 1701603686u32 { Matches = false; }
            if Bytesˉreadˉu32ˉlittle(Input, Name + 4u32) != 1953724787u32 { Matches = false; }
            if Bytesˉreadˉu32ˉlittle(Input, Name + 8u32) != 1680764261u32 { Matches = false; }
            if Bytesˉreadˉu32ˉlittle(Input, Name + 12u32) != 1667592809u32 { Matches = false; }
            if Bytesˉreadˉu32ˉlittle(Input, Name + 16u32) != 2037542772u32 { Matches = false; }
            if Bytesˉreadˉu32ˉlittle(Input, Name + 20u32) != 1634038367u32 { Matches = false; }
            if Bytesˉreadˉu32ˉlittle(Input, Name + 24u32) != 829841252u32 { Matches = false; }
            if Matches { Catalog = 6u32; }
        }
        if Catalog == 0u32 { return Invalid; }

        Cursor = End;
        let Parameterˉcount: u32 = Bytesˉreadˉu32ˉlittle(Input, Cursor);
        Cursor = Cursor + 4u32;
        if Catalog == 1u32 {
            if Parameterˉcount != 1u32 { return Invalid; }
            if Bytesˉreadˉu8(Input, Cursor) != 3u8 { return Invalid; }
