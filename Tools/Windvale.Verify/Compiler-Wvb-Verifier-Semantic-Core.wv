        while Nameˉcursor < End {
            Currentˉbyte = U32ˉfromˉu8(Bytesˉreadˉu8(Input, Nameˉcursor));
            if Segmentˉstart {
                if Currentˉbyte < 97u32 { return Invalid; }
                if Currentˉbyte > 122u32 { return Invalid; }
                Segmentˉstart = false;
            } else {
                if Currentˉbyte == 46u32 {
                    Dotˉseen = true;
                    Segmentˉstart = true;
                } else {
                    Validˉpart = false;
                    if Currentˉbyte >= 97u32 {
                        if Currentˉbyte <= 122u32 { Validˉpart = true; }
                    }
                    if Currentˉbyte >= 48u32 {
                        if Currentˉbyte <= 57u32 { Validˉpart = true; }
                    }
                    if Currentˉbyte == 95u32 { Validˉpart = true; }
                    if Validˉpart {
                    } else {
                        return Invalid;
                    }
                }
            }
            Nameˉcursor = Nameˉcursor + 1u32;
        }
        if Segmentˉstart { return Invalid; }
        if Dotˉseen {
        } else {
            return Invalid;
        }

        if Index > 0u32 {
            Compare = 0u32;
            Compareˉindex = 0u32;
            Compareˉlength = Previousˉlength;
            if Nameˉlength < Compareˉlength { Compareˉlength = Nameˉlength; }
            while Compareˉindex < Compareˉlength {
                if Compare == 0u32 {
                    let Previousˉbyte: u32 = U32ˉfromˉu8(
                        Bytesˉreadˉu8(Input, Previousˉname + Compareˉindex)
                    );
                    let Orderedˉbyte: u32 = U32ˉfromˉu8(
                        Bytesˉreadˉu8(Input, Name + Compareˉindex)
                    );
                    if Previousˉbyte < Orderedˉbyte { Compare = 1u32; }
                    if Previousˉbyte > Orderedˉbyte { Compare = 2u32; }
                }
                Compareˉindex = Compareˉindex + 1u32;
            }
            if Compare == 0u32 {
                if Previousˉlength < Nameˉlength {
                    Compare = 1u32;
                } else {
                    Compare = 2u32;
                }
            }
            if Compare != 1u32 { return Invalid; }
        }

        Catalog = 0u32;
        if Nameˉlength == 13u32 {
            Matches = true;
            if Bytesˉreadˉu32ˉlittle(Input, Name) != 1936617315u32 { Matches = false; }
            if Bytesˉreadˉu32ˉlittle(Input, Name + 4u32) != 778398831u32 { Matches = false; }
            if Bytesˉreadˉu32ˉlittle(Input, Name + 8u32) != 1953067639u32 { Matches = false; }
