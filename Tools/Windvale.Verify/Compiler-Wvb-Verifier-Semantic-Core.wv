                Payloadˉcursor = Payloadˉcursor + 4u32;
                Innerˉindex = 0u32;
                while Innerˉindex < Count {
                    if Payloadˉcursor >= Payloadˉend { return Invalid; }
                    Raw = U32ˉfromˉu8(Bytesˉreadˉu8(Input, Payloadˉcursor));
                    if Raw < 1u32 { return Invalid; }
                    if Raw > 11u32 {
                        if !Bˉextendedˉshape(Minor, Raw) { return Invalid; }
                    }
                    Payloadˉcursor = Payloadˉcursor + 1u32;
                    if Raw == 7u32 || Raw == 8u32 || Raw == 11u32 ||
                        Raw == 22u32 {
                        if 4u32 > Payloadˉend - Payloadˉcursor { return Invalid; }
                        Payloadˉcursor = Payloadˉcursor + 4u32;
                    }
                    Innerˉindex = Innerˉindex + 1u32;
                }
                if Payloadˉcursor >= Payloadˉend { return Invalid; }
                Raw = U32ˉfromˉu8(Bytesˉreadˉu8(Input, Payloadˉcursor));
                if Raw > 11u32 {
                    if !Bˉextendedˉshape(Minor, Raw) { return Invalid; }
                }
                Payloadˉcursor = Payloadˉcursor + 1u32;
                if Raw == 7u32 || Raw == 8u32 || Raw == 11u32 ||
                    Raw == 22u32 {
                    if 4u32 > Payloadˉend - Payloadˉcursor { return Invalid; }
                    Payloadˉcursor = Payloadˉcursor + 4u32;
                }
                if 4u32 > Payloadˉend - Payloadˉcursor { return Invalid; }
                Count = Bytesˉreadˉu32ˉlittle(Input, Payloadˉcursor);
                if Count > 4096u32 { return Invalid; }
                Payloadˉcursor = Payloadˉcursor + 4u32;
                Innerˉindex = 0u32;
                while Innerˉindex < Count {
                    if Payloadˉcursor >= Payloadˉend { return Invalid; }
                    Raw = U32ˉfromˉu8(Bytesˉreadˉu8(Input, Payloadˉcursor));
                    if Raw < 1u32 { return Invalid; }
                    if Raw > 11u32 {
                        if !Bˉextendedˉshape(Minor, Raw) { return Invalid; }
                    }
                    Payloadˉcursor = Payloadˉcursor + 1u32;
                    if Raw == 7u32 || Raw == 8u32 || Raw == 11u32 ||
                        Raw == 22u32 {
                        if 4u32 > Payloadˉend - Payloadˉcursor { return Invalid; }
                        Payloadˉcursor = Payloadˉcursor + 4u32;
                    }
                    Innerˉindex = Innerˉindex + 1u32;
                }
                if 12u32 > Payloadˉend - Payloadˉcursor { return Invalid; }
                if Bytesˉreadˉu32ˉlittle(Input, Payloadˉcursor) != Expectedˉcodeˉoffset {
                    return Invalid;
                }
                Length = Bytesˉreadˉu32ˉlittle(Input, Payloadˉcursor + 4u32);
                if Length > 1048576u32 { return Invalid; }
                if Expectedˉcodeˉoffset > 4194304u32 { return Invalid; }
                if Length > 4194304u32 - Expectedˉcodeˉoffset { return Invalid; }
                Expectedˉcodeˉoffset = Expectedˉcodeˉoffset + Length;
                if Bytesˉreadˉu32ˉlittle(Input, Payloadˉcursor + 8u32) > 4096u32 {
                    return Invalid;
                }
                Payloadˉcursor = Payloadˉcursor + 12u32;
                Index = Index + 1u32;
            }
        }

        if Expectedˉkind == 5u32 {
            if Payloadˉlength != Expectedˉcodeˉoffset { return Invalid; }
            Index = 0u32;
            while Payloadˉcursor < Payloadˉend {
                Raw = U32ˉfromˉu8(Bytesˉreadˉu8(Input, Payloadˉcursor));
                Width = 0u32;
                if Raw == 1u32 { Width = 5u32; }
                if Raw == 2u32 { Width = 2u32; }
                if Raw >= 3u32 {
                    if Raw <= 7u32 { Width = 5u32; }
                }
                if Raw == 8u32 { Width = 2u32; }
                if Raw == 9u32 { Width = 5u32; }
                if Raw == 10u32 { Width = 5u32; }
                if Raw >= 11u32 {
                    if Raw <= 22u32 { Width = 1u32; }
                }
                if Raw >= 32u32 {
                    if Raw <= 40u32 { Width = 1u32; }
                }
                if Raw == 48u32 { Width = 5u32; }
                if Raw == 49u32 { Width = 5u32; }
                if Raw == 64u32 { Width = 5u32; }
                if Raw == 65u32 { Width = 5u32; }
                if Raw == 80u32 { Width = 1u32; }
                if Raw == 81u32 { Width = 1u32; }
                if Raw >= 96u32 {
                    if Raw <= 103u32 { Width = 1u32; }
                }
                if Raw == 104u32 { Width = 5u32; }
                if Raw == 105u32 { Width = 5u32; }
                if Raw == 106u32 { Width = 9u32; }
                if Raw >= 107u32 {
                    if Raw <= 125u32 { Width = 1u32; }
                }
                if Raw == 128u32 { Width = 9u32; }
                if Raw == 129u32 { Width = 9u32; }
                if Raw >= 130u32 {
                    if Raw <= 150u32 { Width = 1u32; }
                }
                if Raw >= 151u32 {
                    if Raw <= 154u32 { Width = 9u32; }
                }
                if Raw >= 155u32 {
                    if Raw <= 191u32 { Width = 1u32; }
                }
                if Raw == 192u32 {
                    if Minor < 12u32 || Minor > 17u32 { return Invalid; }
                    if 3u32 > Payloadˉend - Payloadˉcursor { return Invalid; }
                    let Fixedˉkind: u32 = U32ˉfromˉu8(
                        Bytesˉreadˉu8(Input, Payloadˉcursor + 1u32)
                    );
                    let Fixedˉoperation: u32 = U32ˉfromˉu8(
                        Bytesˉreadˉu8(Input, Payloadˉcursor + 2u32)
                    );
                    if Fixedˉkind < 14u32 || Fixedˉkind > 16u32 {
                        return Invalid;
                    }
                    if Fixedˉoperation > 18u32 { return Invalid; }
                    if Fixedˉoperation == 0u32 {
                        Width = 5u32;
                        if 5u32 > Payloadˉend - Payloadˉcursor { return Invalid; }
                        if Fixedˉkind == 14u32 &&
                            Bytesˉreadˉu8(Input, Payloadˉcursor + 4u32) != 0u8 {
                            return Invalid;
                        }
                    } else {
                        Width = 3u32;
                    }
                    if Fixedˉoperation == 6u32 && Fixedˉkind == 16u32 {
                        return Invalid;
                    }
                    if Fixedˉoperation >= 13u32 && Fixedˉkind != 16u32 {
                        return Invalid;
                    }
                }
                if Raw == 193u32 {
                    if Minor < 13u32 || Minor > 17u32 { return Invalid; }
                    if 2u32 > Payloadˉend - Payloadˉcursor { return Invalid; }
                    let Runeˉoperation: u32 = U32ˉfromˉu8(
                        Bytesˉreadˉu8(Input, Payloadˉcursor + 1u32)
                    );
                    if Runeˉoperation > 2u32 { return Invalid; }
                    Width = 2u32;
                    if Runeˉoperation == 0u32 {
                        Width = 6u32;
                        if 6u32 > Payloadˉend - Payloadˉcursor { return Invalid; }
                        let Runeˉscalar: u32 = Bytesˉreadˉu32ˉlittle(
                            Input, Payloadˉcursor + 2u32
                        );
                        if Runeˉscalar > 1114111u32 { return Invalid; }
                        if Runeˉscalar >= 55296u32 && Runeˉscalar <= 57343u32 {
                            return Invalid;
                        }
                    }
                }
                if Raw == 194u32 {
                    if Minor < 14u32 || Minor > 17u32 { return Invalid; }
                    if 3u32 > Payloadˉend - Payloadˉcursor { return Invalid; }
                    let Floatingˉkind: u32 = U32ˉfromˉu8(
                        Bytesˉreadˉu8(Input, Payloadˉcursor + 1u32)
                    );
                    let Floatingˉoperation: u32 = U32ˉfromˉu8(
                        Bytesˉreadˉu8(Input, Payloadˉcursor + 2u32)
                    );
                    if Floatingˉkind < 18u32 || Floatingˉkind > 19u32 ||
                        Floatingˉoperation > 11u32 {
                        return Invalid;
                    }
                    Width = 3u32;
                    if Floatingˉoperation == 0u32 {
                        Width = 7u32;
                        if Floatingˉkind == 19u32 { Width = 11u32; }
                    }
                }
                if Raw == 195u32 {
                    if Minor < 15u32 || Minor > 17u32 { return Invalid; }
                    Width = 1u32;
                }
                if Raw == 196u32 {
                    if Minor < 16u32 || Minor > 17u32 { return Invalid; }
                    Width = 9u32;
                }
                if Raw == 197u32 {
                    if Minor != 17u32 { return Invalid; }
                    Width = 5u32;
                }
                if Raw == 198u32 {
                    if Minor != 17u32 { return Invalid; }
                    Width = 1u32;
                }
                if Width == 0u32 { return Invalid; }
                if Width > Payloadˉend - Payloadˉcursor { return Invalid; }
                if Raw == 2u32 {
                    Length = U32ˉfromˉu8(Bytesˉreadˉu8(Input, Payloadˉcursor + 1u32));
                    if Length > 1u32 { return Invalid; }
                }
                Payloadˉcursor = Payloadˉcursor + Width;
                if Index >= 400000u32 { return Invalid; }
                Index = Index + 1u32;
            }
        }

        if Expectedˉkind == 6u32 {
            if Payloadˉlength < 4u32 { return Invalid; }
            Count = Bytesˉreadˉu32ˉlittle(Input, Payloadˉcursor);
            if Count > Functionˉcount { return Invalid; }
            Payloadˉcursor = Payloadˉcursor + 4u32;
            Index = 0u32;
            while Index < Count {
                if Payloadˉcursor > Payloadˉend { return Invalid; }
                if 4u32 > Payloadˉend - Payloadˉcursor { return Invalid; }
                Length = Bytesˉreadˉu32ˉlittle(Input, Payloadˉcursor);
