                if Popˉindex == 2u32 {
                    Popˉexpectedˉkind = Thirdˉkind;
                    Popˉexpectedˉnominal = Thirdˉnominal;
                }
                let Popˉactualˉoffset: u32 = Bytesˉlength(Stack) - 5u32;
                if U32ˉfromˉu8(Bytesˉreadˉu8(Stack, Popˉactualˉoffset)) != Popˉexpectedˉkind { return Invalid; }
                if Bytesˉreadˉu32ˉlittle(Stack, Popˉactualˉoffset + 1u32) != Popˉexpectedˉnominal { return Invalid; }
                Stack = Bytesˉslice(Stack, 0u32, Popˉactualˉoffset);
                Depth = Depth - 1u32;
                Popˉindex = Popˉindex + 1u32;
            }
            if Opcode == 49u32 {
                if Depth != 0u32 { return Invalid; }
            }

            if Hasˉpush {
                let Encodedˉshape: bytes = Hˉencodedˉshape(
                    Pushˉkind, Pushˉnominal
                );
                Stack = Bytesˉconcat(Stack, Encodedˉshape);
                Depth = Depth + 1u32;
                if Depth > 4096u32 { return Invalid; }
                if Depth > Maximum { Maximum = Depth; }
            }
            if Handled {
                Handled = true;
            } else {
                return Invalid;
            }

            Previousˉopcode = Opcode;
            Cursor = Cursor + Width;
        }
        if Previousˉopcode != 48u32 {
            if Previousˉopcode != 49u32 {
                if Previousˉopcode != 81u32 { return Invalid; }
            }
        }
        if Depth != 0u32 { return Invalid; }
        if Maximum != Declaredˉmaximum { return Invalid; }
        Functionˉindex = Functionˉindex + 1u32;
    }
    if Functionˉcursor != Functionsˉend { return Invalid; }
    if Typesˉend > Total { return Invalid; }
    return Input;
}

fn Iˉownedˉcontrolˉisˉvalid(
    Input: bytes,
    Minor: u32,
    Types: u32,
    Functionˉcode: u32,
    Functionˉcodeˉlength: u32,
    Localˉslots: u32,
    Parameterˉcount: u32,
    Localˉshapes: bytes
) -> bool {
    var Ownedˉvectorˉcount: u32 = 0u32;
    var Ownedˉavailableˉlow: u32 = 0u32;
    var Ownedˉavailableˉhigh: u32 = 0u32;
    var Ownedˉslot: u32 = 0u32;
    while Ownedˉslot < Localˉslots {
        if Iˉtrackedˉownedˉlocalˉshape(
            Input, Types, Bytesˉreadˉu32ˉlittle(Input, Types),
            Localˉshapes, Ownedˉslot, Minor
        ) {
            if Ownedˉvectorˉcount >= 64u32 { return false; }
            if Ownedˉslot < Parameterˉcount {
                if Ownedˉvectorˉcount < 32u32 {
                    Ownedˉavailableˉlow = Ownedˉavailableˉlow |
                        (1u32 << Ownedˉvectorˉcount);
                } else {
                    Ownedˉavailableˉhigh = Ownedˉavailableˉhigh |
                        (1u32 << (Ownedˉvectorˉcount - 32u32));
                }
            }
            Ownedˉvectorˉcount = Ownedˉvectorˉcount + 1u32;
        }
        Ownedˉslot = Ownedˉslot + 1u32;
    }

    var Ownedˉbranches: bytes = Bytesˉslice(Input, 0u32, 0u32);
    var Ownedˉentries: bytes = Bytesˉslice(Input, 0u32, 0u32);
    var Ownedˉcursor: u32 = 0u32;
    var Ownedˉreachable: bool = true;
    while Ownedˉcursor < Functionˉcodeˉlength {
        var Ownedˉbranch: u32 = 0u32;
        while Ownedˉbranch < Bytesˉlength(Ownedˉbranches) {
            if Bytesˉreadˉu32ˉlittle(
                Ownedˉbranches, Ownedˉbranch
            ) == Ownedˉcursor {
                let Ownedˉbranchˉlow: u32 = Bytesˉreadˉu32ˉlittle(
                    Ownedˉbranches, Ownedˉbranch + 4u32
                );
                let Ownedˉbranchˉhigh: u32 = Bytesˉreadˉu32ˉlittle(
                    Ownedˉbranches, Ownedˉbranch + 8u32
                );
                if Ownedˉreachable {
                    Ownedˉavailableˉlow = Ownedˉavailableˉlow &
                        Ownedˉbranchˉlow;
                    Ownedˉavailableˉhigh = Ownedˉavailableˉhigh &
                        Ownedˉbranchˉhigh;
                } else {
                    Ownedˉavailableˉlow = Ownedˉbranchˉlow;
                    Ownedˉavailableˉhigh = Ownedˉbranchˉhigh;
                    Ownedˉreachable = true;
                }
            }
            Ownedˉbranch = Ownedˉbranch + 12u32;
        }
        if !Ownedˉreachable { return false; }

        Ownedˉentries = Bytesˉconcat(
            Ownedˉentries,
            Bytesˉconcat(
                Bytesˉfromˉu32ˉlittle(Ownedˉcursor),
                Bytesˉconcat(
                    Bytesˉfromˉu32ˉlittle(Ownedˉavailableˉlow),
                    Bytesˉfromˉu32ˉlittle(Ownedˉavailableˉhigh)
                )
            )
        );

        let Ownedˉopcode: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(
            Input, Functionˉcode + Ownedˉcursor
        ));
        let Ownedˉwidth: u32 = Hˉinstructionˉwidth(
            Input, Functionˉcode, Ownedˉcursor, Ownedˉopcode
        );

        if Ownedˉopcode == 4u32 || Ownedˉopcode == 5u32 ||
            Ownedˉopcode == 205u32 {
            let Ownedˉlocal: u32 = Bytesˉreadˉu32ˉlittle(
                Input, Functionˉcode + Ownedˉcursor + 1u32
            );
            var Ownedˉrank: u32 = 4294967295u32;
            if Ownedˉlocal < Localˉslots && Iˉtrackedˉownedˉlocalˉshape(
                Input, Types, Bytesˉreadˉu32ˉlittle(Input, Types),
                Localˉshapes, Ownedˉlocal, Minor
            ) {
                Ownedˉrank = 0u32;
                var Ownedˉearlier: u32 = 0u32;
                while Ownedˉearlier < Ownedˉlocal {
                    if Iˉtrackedˉownedˉlocalˉshape(
                        Input, Types,
                        Bytesˉreadˉu32ˉlittle(Input, Types),
                        Localˉshapes, Ownedˉearlier, Minor
                    ) { Ownedˉrank = Ownedˉrank + 1u32; }
                    Ownedˉearlier = Ownedˉearlier + 1u32;
                }
            }
            if Ownedˉrank != 4294967295u32 {
                if Ownedˉopcode == 4u32 || Ownedˉopcode == 205u32 {
                    var Ownedˉavailable: bool = false;
                    if Ownedˉrank < 32u32 {
                        Ownedˉavailable = ((Ownedˉavailableˉlow >>
                            Ownedˉrank) & 1u32) == 1u32;
                    } else {
                        Ownedˉavailable = ((Ownedˉavailableˉhigh >>
                            (Ownedˉrank - 32u32)) & 1u32) == 1u32;
                    }
                    if !Ownedˉavailable { return false; }
                }
                if Ownedˉopcode == 5u32 {
                    let Ownedˉstoredˉkind: u32 = U32ˉfromˉu8(
                        Bytesˉreadˉu8(Localˉshapes, Ownedˉlocal * 5u32)
                    );
                    var Ownedˉalreadyˉavailable: bool = false;
                    if Ownedˉrank < 32u32 {
                        Ownedˉalreadyˉavailable =
                            ((Ownedˉavailableˉlow >> Ownedˉrank) & 1u32)
                                == 1u32;
                    } else {
                        Ownedˉalreadyˉavailable =
                            ((Ownedˉavailableˉhigh >>
                                (Ownedˉrank - 32u32)) & 1u32) == 1u32;
                    }
                    if Ownedˉstoredˉkind != 23u32 &&
                        Ownedˉalreadyˉavailable {
                        return false;
                    }
                    if Ownedˉrank < 32u32 {
                        Ownedˉavailableˉlow = Ownedˉavailableˉlow |
                            (1u32 << Ownedˉrank);
                    } else {
                        Ownedˉavailableˉhigh = Ownedˉavailableˉhigh |
                            (1u32 << (Ownedˉrank - 32u32));
                    }
                }
                if Ownedˉopcode == 205u32 {
                    if Ownedˉrank < 32u32 {
                        Ownedˉavailableˉlow = Ownedˉavailableˉlow &
                            ~(1u32 << Ownedˉrank);
                    } else {
                        Ownedˉavailableˉhigh = Ownedˉavailableˉhigh &
                            ~(1u32 << (Ownedˉrank - 32u32));
                    }
                }
            }
        }
        if Ownedˉopcode == 206u32 || Ownedˉopcode == 207u32 ||
            Ownedˉopcode == 208u32 || Ownedˉopcode == 209u32 {
            let Ownedˉparent: u32 = Bytesˉreadˉu32ˉlittle(
                Input, Functionˉcode + Ownedˉcursor + 1u32
            );
            var Ownedˉparentˉkind: u32 = 25u32;
            if Ownedˉopcode == 208u32 || Ownedˉopcode == 209u32 {
                Ownedˉparentˉkind = 23u32;
            }
            if Ownedˉparent >= Localˉslots ||
                !Iˉtrackedˉownedˉlocalˉshape(
                Input, Types, Bytesˉreadˉu32ˉlittle(Input, Types),
                Localˉshapes, Ownedˉparent, Minor
            ) || U32ˉfromˉu8(Bytesˉreadˉu8(
                Localˉshapes, Ownedˉparent * 5u32
            )) != Ownedˉparentˉkind { return false; }
            var Ownedˉparentˉrank: u32 = 0u32;
            var Ownedˉparentˉearlier: u32 = 0u32;
            while Ownedˉparentˉearlier < Ownedˉparent {
                if Iˉtrackedˉownedˉlocalˉshape(
                    Input, Types, Bytesˉreadˉu32ˉlittle(Input, Types),
                    Localˉshapes, Ownedˉparentˉearlier, Minor
                ) { Ownedˉparentˉrank = Ownedˉparentˉrank + 1u32; }
                Ownedˉparentˉearlier = Ownedˉparentˉearlier + 1u32;
            }
            var Ownedˉparentˉavailable: bool = false;
            if Ownedˉparentˉrank < 32u32 {
                Ownedˉparentˉavailable = ((Ownedˉavailableˉlow >>
                    Ownedˉparentˉrank) & 1u32) == 1u32;
            } else {
                Ownedˉparentˉavailable = ((Ownedˉavailableˉhigh >>
                    (Ownedˉparentˉrank - 32u32)) & 1u32) == 1u32;
            }
            if !Ownedˉparentˉavailable { return false; }
            if Ownedˉopcode == 207u32 {
                if Ownedˉparentˉrank < 32u32 {
                    Ownedˉavailableˉlow = Ownedˉavailableˉlow &
                        ~(1u32 << Ownedˉparentˉrank);
                } else {
                    Ownedˉavailableˉhigh = Ownedˉavailableˉhigh &
                        ~(1u32 << (Ownedˉparentˉrank - 32u32));
                }
            }
        }
        if Ownedˉopcode == 209u32 {
            let Ownedˉbudget: u32 = Bytesˉreadˉu32ˉlittle(
                Input, Functionˉcode + Ownedˉcursor + 5u32
            );
            if Ownedˉbudget >= Localˉslots || U32ˉfromˉu8(
                    Bytesˉreadˉu8(
                        Localˉshapes, Ownedˉbudget * 5u32
                    )
                ) != 25u32 {
                return false;
            }
            var Ownedˉbudgetˉrank: u32 = 0u32;
            var Ownedˉbudgetˉearlier: u32 = 0u32;
            while Ownedˉbudgetˉearlier < Ownedˉbudget {
                if Iˉtrackedˉownedˉlocalˉshape(
                    Input, Types, Bytesˉreadˉu32ˉlittle(Input, Types),
                    Localˉshapes, Ownedˉbudgetˉearlier, Minor
                ) {
                    Ownedˉbudgetˉrank = Ownedˉbudgetˉrank + 1u32;
                }
                Ownedˉbudgetˉearlier = Ownedˉbudgetˉearlier + 1u32;
            }
            var Ownedˉbudgetˉavailable: bool = false;
            if Ownedˉbudgetˉrank < 32u32 {
                Ownedˉbudgetˉavailable = ((Ownedˉavailableˉlow >>
                    Ownedˉbudgetˉrank) & 1u32) == 1u32;
            } else {
                Ownedˉbudgetˉavailable = ((Ownedˉavailableˉhigh >>
                    (Ownedˉbudgetˉrank - 32u32)) & 1u32) == 1u32;
            }
            if !Ownedˉbudgetˉavailable { return false; }
        }
        if Ownedˉopcode == 48u32 || Ownedˉopcode == 49u32 {
            let Ownedˉtarget: u32 = Bytesˉreadˉu32ˉlittle(
                Input, Functionˉcode + Ownedˉcursor + 1u32
            );
            if Ownedˉtarget > Ownedˉcursor {
                Ownedˉbranches = Bytesˉconcat(
                    Ownedˉbranches,
                    Bytesˉconcat(
                        Bytesˉfromˉu32ˉlittle(Ownedˉtarget),
                        Bytesˉconcat(
                            Bytesˉfromˉu32ˉlittle(
                                Ownedˉavailableˉlow
                            ),
                            Bytesˉfromˉu32ˉlittle(
                                Ownedˉavailableˉhigh
                            )
                        )
                    )
                );
            } else {
                var Ownedˉentry: u32 = 0u32;
                var Ownedˉentryˉfound: bool = false;
                while Ownedˉentry < Bytesˉlength(Ownedˉentries) {
                    if Bytesˉreadˉu32ˉlittle(
                        Ownedˉentries, Ownedˉentry
                    ) == Ownedˉtarget {
                        if Bytesˉreadˉu32ˉlittle(
                            Ownedˉentries, Ownedˉentry + 4u32
                        ) != Ownedˉavailableˉlow ||
                            Bytesˉreadˉu32ˉlittle(
                                Ownedˉentries, Ownedˉentry + 8u32
                            ) != Ownedˉavailableˉhigh {
                            return false;
                        }
                        Ownedˉentryˉfound = true;
                    }
                    Ownedˉentry = Ownedˉentry + 12u32;
                }
                if !Ownedˉentryˉfound { return false; }
            }
            if Ownedˉopcode == 48u32 { Ownedˉreachable = false; }
        }
        if Ownedˉopcode == 81u32 { Ownedˉreachable = false; }
        Ownedˉcursor = Ownedˉcursor + Ownedˉwidth;
    }
    return true;
}

export fn Iˉcontrol(Input: bytes) -> bytes {
    let Controlˉinvalid: bytes = Bytesˉslice(Input, 0u32, 0u32);
    let Controlˉtotal: u32 = Bytesˉlength(Input);
    let Minor: u32 = Bytesˉreadˉu16ˉlittle(Input, 6u32);
    var Controlˉenvelope: u32 = 12u32;
    var Controlˉsectionˉkind: u32 = 1u32;
    var Controlˉpayload: u32 = 0u32;
    var Controlˉpayloadˉlength: u32 = 0u32;
    var Controlˉfunctions: u32 = 0u32;
    var Controlˉfunctionsˉend: u32 = 0u32;
    var Controlˉcode: u32 = 0u32;
    var Controlˉcodeˉlength: u32 = 0u32;
    var Types: u32 = 0u32;
    while Controlˉsectionˉkind <= 7u32 {
        Controlˉpayload = Controlˉenvelope + 8u32;
        Controlˉpayloadˉlength = Bytesˉreadˉu32ˉlittle(
            Input,
            Controlˉenvelope + 4u32
        );
        if Controlˉsectionˉkind == 4u32 {
            Controlˉfunctions = Controlˉpayload;
            Controlˉfunctionsˉend = Controlˉpayload + Controlˉpayloadˉlength;
        }
        if Controlˉsectionˉkind == 5u32 {
            Controlˉcode = Controlˉpayload;
            Controlˉcodeˉlength = Controlˉpayloadˉlength;
        }
        if Controlˉsectionˉkind == 7u32 { Types = Controlˉpayload; }
        Controlˉenvelope = Controlˉpayload + Controlˉpayloadˉlength;
        Controlˉsectionˉkind = Controlˉsectionˉkind + 1u32;
    }

    let Controlˉfunctionˉcount: u32 = Bytesˉreadˉu32ˉlittle(
        Input,
        Controlˉfunctions
    );
    if Controlˉfunctionˉcount > 4096u32 { return Controlˉinvalid; }
    if Controlˉcodeˉlength > 4194304u32 { return Controlˉinvalid; }
    var Controlˉfunctionˉindex: u32 = 0u32;
    var Controlˉfunctionˉcursor: u32 = Controlˉfunctions + 4u32;
    var Controlˉaggregateˉinstructions: u32 = 0u32;
    while Controlˉfunctionˉindex < Controlˉfunctionˉcount {
        let Controlˉnameˉlength: u32 = Bytesˉreadˉu32ˉlittle(
            Input,
            Controlˉfunctionˉcursor
        );
        Controlˉfunctionˉcursor = Controlˉfunctionˉcursor
            + 4u32
            + Controlˉnameˉlength;
        let Controlˉparameterˉcount: u32 = Bytesˉreadˉu32ˉlittle(
            Input,
            Controlˉfunctionˉcursor
        );
        Controlˉfunctionˉcursor = Controlˉfunctionˉcursor + 4u32;
        let Controlˉparameterˉtypes: u32 = Controlˉfunctionˉcursor;
        var Controlˉshapeˉindex: u32 = 0u32;
        var Controlˉshapeˉkind: u32 = 0u32;
        while Controlˉshapeˉindex < Controlˉparameterˉcount {
            Controlˉshapeˉkind = U32ˉfromˉu8(Bytesˉreadˉu8(
                Input,
                Controlˉfunctionˉcursor
            ));
            Controlˉfunctionˉcursor = Controlˉfunctionˉcursor + 1u32;
            if Controlˉshapeˉkind == 7u32 || Controlˉshapeˉkind == 8u32 ||
                Controlˉshapeˉkind == 11u32 || Controlˉshapeˉkind == 22u32 ||
                Controlˉshapeˉkind == 23u32 || Controlˉshapeˉkind == 24u32 ||
                Controlˉshapeˉkind == 26u32 || Controlˉshapeˉkind == 27u32 ||
                Controlˉshapeˉkind == 28u32 || Controlˉshapeˉkind == 29u32 ||
                Controlˉshapeˉkind == 30u32 {
                Controlˉfunctionˉcursor = Controlˉfunctionˉcursor + 4u32;
            }
            Controlˉshapeˉindex = Controlˉshapeˉindex + 1u32;
        }
        Controlˉshapeˉkind = U32ˉfromˉu8(Bytesˉreadˉu8(
            Input,
            Controlˉfunctionˉcursor
        ));
        Controlˉfunctionˉcursor = Controlˉfunctionˉcursor + 1u32;
        if Controlˉshapeˉkind == 7u32 || Controlˉshapeˉkind == 8u32 ||
            Controlˉshapeˉkind == 11u32 || Controlˉshapeˉkind == 22u32 ||
            Controlˉshapeˉkind == 23u32 || Controlˉshapeˉkind == 24u32 {
            Controlˉfunctionˉcursor = Controlˉfunctionˉcursor + 4u32;
        }
        let Controlˉlocalˉcount: u32 = Bytesˉreadˉu32ˉlittle(
            Input,
            Controlˉfunctionˉcursor
        );
        Controlˉfunctionˉcursor = Controlˉfunctionˉcursor + 4u32;
        let Controlˉlocalˉtypes: u32 = Controlˉfunctionˉcursor;
        Controlˉshapeˉindex = 0u32;
        while Controlˉshapeˉindex < Controlˉlocalˉcount {
            Controlˉshapeˉkind = U32ˉfromˉu8(Bytesˉreadˉu8(
                Input,
                Controlˉfunctionˉcursor
            ));
            Controlˉfunctionˉcursor = Controlˉfunctionˉcursor + 1u32;
            if Controlˉshapeˉkind == 7u32 || Controlˉshapeˉkind == 8u32 ||
                Controlˉshapeˉkind == 11u32 || Controlˉshapeˉkind == 22u32 ||
                Controlˉshapeˉkind == 23u32 || Controlˉshapeˉkind == 24u32 ||
                Controlˉshapeˉkind == 28u32 ||
                Controlˉshapeˉkind == 29u32 ||
                Controlˉshapeˉkind == 30u32 {
                Controlˉfunctionˉcursor = Controlˉfunctionˉcursor + 4u32;
            }
            Controlˉshapeˉindex = Controlˉshapeˉindex + 1u32;
        }
        let Controlˉfunctionˉcodeˉoffset: u32 = Bytesˉreadˉu32ˉlittle(
            Input,
            Controlˉfunctionˉcursor
        );
        let Controlˉfunctionˉcodeˉlength: u32 = Bytesˉreadˉu32ˉlittle(
            Input,
            Controlˉfunctionˉcursor + 4u32
        );
        Controlˉfunctionˉcursor = Controlˉfunctionˉcursor + 12u32;

        let Controlˉfunctionˉcode: u32 = Controlˉcode
            + Controlˉfunctionˉcodeˉoffset;
        let Controlˉlocalˉslots: u32 = Controlˉparameterˉcount
            + Controlˉlocalˉcount;
        let Controlˉlocalˉshapes: bytes = Typedˉdirectories.Hˉlocalˉshapes(
            Input,
            Controlˉparameterˉtypes,
            Controlˉparameterˉcount,
            Controlˉlocalˉtypes,
            Controlˉlocalˉcount
        );
        let Controlˉdirectory: Typedˉdirectories.Hˉcontrolˉdirectory =
            Typedˉdirectories.Iˉcontrolˉdirectory(
                Input,
                Controlˉfunctionˉcode,
                Controlˉfunctionˉcodeˉlength
            );
        if !Controlˉdirectory.Valid { return Controlˉinvalid; }
        var Controlˉcursor: u32 = 0u32;
        var Controlˉpreviousˉopcode: u32 = 0u32;
        var Controlˉfunctionˉinstructions: u32 = 0u32;
        var Controlˉhasˉtake: bool = false;
        var Controlˉownedˉslot: u32 = 0u32;
        while Controlˉownedˉslot < Controlˉlocalˉslots {
            if Iˉtrackedˉownedˉlocalˉshape(
                Input, Types, Bytesˉreadˉu32ˉlittle(Input, Types),
                Controlˉlocalˉshapes, Controlˉownedˉslot, Minor
            ) { Controlˉhasˉtake = true; }
            Controlˉownedˉslot = Controlˉownedˉslot + 1u32;
        }
        while Controlˉcursor < Controlˉfunctionˉcodeˉlength {
            if Controlˉcursor > 0u32 {
                var Controlˉneedsˉpredecessor: bool = false;
                if Controlˉpreviousˉopcode == 48u32 {
                    Controlˉneedsˉpredecessor = true;
                }
                if Controlˉpreviousˉopcode == 81u32 {
                    Controlˉneedsˉpredecessor = true;
                }
                if Controlˉneedsˉpredecessor &&
                    !Typedˉdirectories.Iˉhasˉearlierˉpredecessor(
                        Controlˉdirectory.Branches,
                        Controlˉcursor
                    ) {
                    return Controlˉinvalid;
                }
            }

            let Controlˉopcode: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(
                Input,
                Controlˉfunctionˉcode + Controlˉcursor
            ));
            let Controlˉwidth: u32 = Hˉinstructionˉwidth(
                Input,
                Controlˉfunctionˉcode,
                Controlˉcursor,
                Controlˉopcode
            );
            Controlˉaggregateˉinstructions = Controlˉaggregateˉinstructions
                + 1u32;
            Controlˉfunctionˉinstructions =
                Controlˉfunctionˉinstructions + 1u32;
            if Controlˉopcode == 205u32 || Controlˉopcode == 206u32 ||
                Controlˉopcode == 207u32 {
                Controlˉhasˉtake = true;
            }
            if Controlˉaggregateˉinstructions > 400000u32 {
                return Controlˉinvalid;
            }

            var Controlˉhasˉtarget: bool = false;
            if Controlˉopcode == 48u32 { Controlˉhasˉtarget = true; }
            if Controlˉopcode == 49u32 { Controlˉhasˉtarget = true; }
            if Controlˉhasˉtarget {
                let Controlˉtarget: u32 = Bytesˉreadˉu32ˉlittle(
                    Input,
                    Controlˉfunctionˉcode + Controlˉcursor + 1u32
                );
                if Controlˉtarget >= Controlˉfunctionˉcodeˉlength {
                    return Controlˉinvalid;
                }
                if Controlˉtarget != 0u32 && Bytesˉreadˉu8(
                    Controlˉdirectory.Boundaries,
                    Controlˉtarget
                ) != 3u8 {
                    return Controlˉinvalid;
                }
            }

            Controlˉpreviousˉopcode = Controlˉopcode;
            Controlˉcursor = Controlˉcursor + Controlˉwidth;
        }
        if Controlˉpreviousˉopcode != 48u32 {
            if Controlˉpreviousˉopcode != 49u32 {
                if Controlˉpreviousˉopcode != 81u32 {
                    return Controlˉinvalid;
                }
            }
        }
        if Controlˉhasˉtake {
            if Controlˉfunctionˉinstructions > 4096u32 ||
                !Iˉownedˉcontrolˉisˉvalid(
                    Input,
                    Minor,
                    Types,
                    Controlˉfunctionˉcode,
                    Controlˉfunctionˉcodeˉlength,
                    Controlˉlocalˉslots,
                    Controlˉparameterˉcount,
                    Controlˉlocalˉshapes
                ) {
                return Controlˉinvalid;
            }
        }
        Controlˉfunctionˉindex = Controlˉfunctionˉindex + 1u32;
    }
    if Controlˉfunctionˉcursor != Controlˉfunctionsˉend {
        return Controlˉinvalid;
    }
    if Controlˉenvelope > Controlˉtotal { return Controlˉinvalid; }
    return Input;
}
