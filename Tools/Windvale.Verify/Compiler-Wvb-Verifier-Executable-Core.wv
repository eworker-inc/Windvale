                    Secondˉkind = Fixedˉkind;
                    Hasˉpush = true;
                    Pushˉkind = 2u32;
                }
                if Fixedˉoperation >= 13u32 && Fixedˉoperation <= 15u32 {
                    Popˉcount = 2u32;
                    Firstˉkind = 16u32;
                    Secondˉkind = 16u32;
                    Hasˉpush = true;
                    Pushˉkind = 16u32;
