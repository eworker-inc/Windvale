module Windvaleˉcompilerˉwvbˉverifierˉexecutable profile portable;

import Windvaleˉcompilerˉwvbˉverifierˉtypedˉdirectories as Typedˉdirectories;
import Windvaleˉcompilerˉwvbˉverifierˉfoundationˉownerˉflow as Foundationˉowners;

export record Hˉoperationˉstate {
    Valid: bool;
    Stack: bytes;
    Depth: u32;
    Hasˉpush: bool;
    Pushˉkind: u32;
    Pushˉnominal: u32;
}

export fn Hˉfoundationˉborrowˉisˉvalid(
    Shapes: bytes,
    Types: bytes,
    Owner: u32,
    Option: u32,
    Projection: u32
) -> bool {
    if Owner >= Bytesˉlength(Shapes) / 5u32 ||
        Option >= Bytesˉlength(Types) / 11u32 ||
        Projection < 1u32 || Projection > 3u32 ||
        Bytesˉreadˉu8(Shapes, Owner * 5u32) != 11u8 ||
        Bytesˉreadˉu8(Types, Option * 11u32) != 1u8 { return false; }
    let Ownerˉtype: u32 = Bytesˉreadˉu32ˉlittle(Shapes, Owner * 5u32 + 1u32);
    if Ownerˉtype >= Bytesˉlength(Types) / 11u32 { return false; }
    if Projection == 1u32 { return Ownerˉtype == Option; }
    if Bytesˉreadˉu8(Types, Ownerˉtype * 11u32) != 2u8 { return false; }
    var Payload: u32 = Ownerˉtype * 11u32 + 1u32;
    if Projection == 3u32 { Payload = Payload + 5u32; }
    var Byte: u32 = 0u32;
    while Byte < 5u32 {
        if Bytesˉreadˉu8(Types, Payload + Byte) !=
            Bytesˉreadˉu8(Types, Option * 11u32 + 1u32 + Byte) { return false; }
        Byte = Byte + 1u32;
    }
    return true;
}

record Hˉtaskˉsignatureˉstate {
    Valid: bool;
    Signatures: bytes;
}

record Hˉfunctionˉentry {
    Next: u32;
    Parameters: u32;
    Parameterˉtypes: u32;
    Returnˉtype: u32;
    Locals: u32;
    Localˉtypes: u32;
    Codeˉoffset: u32;
    Codeˉlength: u32;
    Maximum: u32;
}

fn Hˉborrowˉpayloadˉkind(Kind: u32) -> bool {
    return (Kind >= 1u32 && Kind <= 11u32) ||
        (Kind >= 14u32 && Kind <= 20u32) || Kind == 22u32 ||
        Kind == 24u32 || Kind == 35u32;
}

fn Hˉborrowedˉvalue(Kind: u32) -> bool {
    return Kind >= 64u32 && Hˉborrowˉpayloadˉkind(Kind - 64u32);
}

fn Hˉexactˉvalueˉmatches(Input: bytes, Types: u32, Expectedˉkind: u32,
    Expectedˉnominal: u32, Actualˉkind: u32, Actualˉnominal: u32) -> bool {
    if Expectedˉnominal != Actualˉnominal { return false; }
    return Hˉvalueˉmatches(Input, Types, Expectedˉkind, Actualˉkind, Expectedˉnominal);
}

fn Hˉeffectiveˉminor(Input: bytes) -> u32 {
    let Declared: u32 = Bytesˉreadˉu16ˉlittle(Input, 6u32);
    if Declared == 38u32 || Declared == 39u32 { return 37u32; }
    return Declared;
}

fn Hˉshapeˉwidth(Input: bytes, Cursor: u32) -> u32 {
    if Cursor >= Bytesˉlength(Input) { return 0u32; }
    let Kind: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(Input, Cursor));
    if Kind == 37u32 {
        if Cursor + 1u32 >= Bytesˉlength(Input) { return 0u32; }
        let Inner: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(Input, Cursor + 1u32));
        if !((Inner >= 1u32 && Inner <= 11u32) ||
            (Inner >= 14u32 && Inner <= 20u32) || Inner == 22u32 ||
            Inner == 24u32 || Inner == 35u32) { return 0u32; }
        if Inner == 7u32 || Inner == 8u32 || Inner == 11u32 ||
            Inner == 22u32 || Inner == 24u32 || Inner == 35u32 {
            if Bytesˉlength(Input) - Cursor < 6u32 { return 0u32; }
            return 6u32;
        }
        return 2u32;
    }
    if Kind == 7u32 || Kind == 8u32 || Kind == 11u32 || Kind == 22u32 ||
        Kind == 23u32 || Kind == 24u32 || Kind == 26u32 || Kind == 27u32 ||
        Kind == 28u32 || Kind == 29u32 || Kind == 30u32 || Kind == 35u32 {
        if Bytesˉlength(Input) - Cursor < 5u32 { return 0u32; }
        return 5u32;
    }
    return 1u32;
}

fn Hˉvariantˉcaseˉend(Input: bytes, Cursor: u32) -> u32 {
    let Marker: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(Input, Cursor));
    var Next: u32 = Cursor + 1u32;
    var Fields: u32 = 0u32;
    if Marker == 1u32 { Fields = 1u32; }
    if Marker == 2u32 {
        Fields = Bytesˉreadˉu32ˉlittle(Input, Next);
        Next = Next + 4u32;
    }
    var Field: u32 = 0u32;
    while Field < Fields {
        let Nameˉlength: u32 = Bytesˉreadˉu32ˉlittle(Input, Next);
        Next = Next + 4u32 + Nameˉlength;
        Next = Next + Hˉshapeˉwidth(Input, Next);
        Field = Field + 1u32;
    }
    return Next;
}

fn Hˉnextˉtype(Input: bytes, Cursor: u32) -> u32 {
    let Kind: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(Input, Cursor));
    var Next: u32 = Cursor + 1u32;
    if Kind == 8u32 {
        Next = Next + 1u32;
        Next = Next + Hˉshapeˉwidth(Input, Next);
        let Parameters: u32 = Bytesˉreadˉu32ˉlittle(Input, Next);
        Next = Next + 4u32;
        var Parameter: u32 = 0u32;
        while Parameter < Parameters {
            Next = Next + Hˉshapeˉwidth(Input, Next);
            Parameter = Parameter + 1u32;
        }
        let Minor: u32 = Hˉeffectiveˉminor(Input);
        if Minor == 32u32 || Minor == 33u32 || Minor == 34u32 ||
            Minor == 35u32 || Minor == 36u32 || Minor == 37u32 {
            Next = Next + 10u32 + Parameters;
        }
        return Next;
    }
    let Nameˉlength: u32 = Bytesˉreadˉu32ˉlittle(Input, Next);
    Next = Next + 4u32 + Nameˉlength;
    if Kind == 7u32 { Next = Next + 1u32; }
    if Kind == 4u32 {
        return Next + Hˉshapeˉwidth(Input, Next) + 4u32;
    }
    if Kind == 5u32 || Kind == 6u32 {
        return Next + Hˉshapeˉwidth(Input, Next);
    }
    let Itemˉcount: u32 = Bytesˉreadˉu32ˉlittle(Input, Next);
    Next = Next + 4u32;
    var Item: u32 = 0u32;
    while Item < Itemˉcount {
        let Itemˉnameˉlength: u32 = Bytesˉreadˉu32ˉlittle(Input, Next);
        Next = Next + 4u32 + Itemˉnameˉlength;
        if Kind == 1u32 {
            Next = Next + Hˉshapeˉwidth(Input, Next);
        } else if Kind == 2u32 {
            Next = Next + 4u32;
        } else if Kind == 7u32 {
            Next = Next + 1u32;
        } else {
            Next = Hˉvariantˉcaseˉend(Input, Next);
        }
        Item = Item + 1u32;
    }
    return Next;
}

fn Hˉtypeˉat(Input: bytes, Types: u32, Typeˉindex: u32) -> u32 {
    var Cursor: u32 = Types + 4u32;
    var Index: u32 = 0u32;
    while Index < Typeˉindex {
        Cursor = Hˉnextˉtype(Input, Cursor);
        Index = Index + 1u32;
    }
    return Cursor;
}

fn Hˉspanˉequalsˉtext(
    Input: bytes,
    Offset: u32,
    Length: u32,
    Expected: text
) -> bool {
    let Expectedˉbytes: bytes = Textˉtoˉutf8(Expected);
    if Length != Bytesˉlength(Expectedˉbytes) { return false; }
    var Index: u32 = 0u32;
    while Index < Length {
        if Bytesˉreadˉu8(Input, Offset + Index) !=
            Bytesˉreadˉu8(Expectedˉbytes, Index) {
            return false;
        }
        Index = Index + 1u32;
    }
    return true;
}

fn Hˉsynthesizedˉgenericˉname(
    Input: bytes,
    Types: u32,
    Typeˉindex: u32
) -> bool {
    return Hˉsynthesizedˉgenericˉnameˉat(
        Input, Hˉtypeˉat(Input, Types, Typeˉindex) + 1u32
    );
}

fn Hˉsynthesizedˉgenericˉnameˉat(Input: bytes, Cursor: u32) -> bool {
    if Bytesˉreadˉu32ˉlittle(Input, Cursor) != 9u32 ||
        !Hˉspanˉequalsˉtext(Input, Cursor + 4u32, 5u32, "__WvY") {
        return false;
    }
    var Digit: u32 = 0u32;
    while Digit < 4u32 {
        let Value: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(
            Input, Cursor + 9u32 + Digit
        ));
        if Value < 48u32 || Value > 57u32 { return false; }
        Digit = Digit + 1u32;
    }
    return true;
}

fn Hˉfoundationˉpayloadˉcell(Input: bytes, Cursor: u32) -> bytes {
    let Kind: u8 = Bytesˉreadˉu8(Input, Cursor);
    if Hˉshapeˉwidth(Input, Cursor) == 5u32 {
        return Bytesˉslice(Input, Cursor, 5u32);
    }
    return Bytesˉconcat(Bytesˉfromˉu8(Kind), Bytesˉfromˉu32ˉlittle(0u32));
}

fn Hˉfoundationˉtypeˉcell(Input: bytes, Descriptor: u32) -> bytes {
    let Zero: bytes = Bytesˉconcat(Bytesˉfromˉu8(0u8),
        Bytesˉconcat(Bytesˉfromˉu32ˉlittle(0u32), Bytesˉfromˉu32ˉlittle(0u32)));
    let Invalid: bytes = Bytesˉconcat(Zero,
        Bytesˉconcat(Bytesˉfromˉu8(0u8), Bytesˉfromˉu8(0u8)));
    if Bytesˉreadˉu8(Input, Descriptor) != 3u8 ||
        !Hˉsynthesizedˉgenericˉnameˉat(Input, Descriptor + 1u32) {
        return Invalid;
    }
    var Cursor: u32 = Hˉafterˉencodedˉstring(Input, Descriptor + 1u32);
    if Bytesˉreadˉu32ˉlittle(Input, Cursor) != 2u32 { return Invalid; }
    Cursor = Cursor + 4u32;
    let Firstˉlength: u32 = Bytesˉreadˉu32ˉlittle(Input, Cursor);
    var Kind: u8 = 0u8;
    if Hˉspanˉequalsˉtext(Input, Cursor + 4u32, Firstˉlength, "Present") {
        Kind = 1u8;
    }
    if Hˉspanˉequalsˉtext(Input, Cursor + 4u32, Firstˉlength, "Valid") {
        Kind = 2u8;
    }
    Cursor = Cursor + 4u32 + Firstˉlength;
    if Kind == 0u8 || Bytesˉreadˉu8(Input, Cursor) != 1u8 { return Invalid; }
    Cursor = Cursor + 1u32;
    let Valueˉlength: u32 = Bytesˉreadˉu32ˉlittle(Input, Cursor);
    if !Hˉspanˉequalsˉtext(Input, Cursor + 4u32, Valueˉlength, "Value") {
        return Invalid;
    }
    Cursor = Cursor + 4u32 + Valueˉlength;
    let Value: bytes = Hˉfoundationˉpayloadˉcell(Input, Cursor);
    Cursor = Cursor + Hˉshapeˉwidth(Input, Cursor);
    let Secondˉlength: u32 = Bytesˉreadˉu32ˉlittle(Input, Cursor);
    var Secondˉname: text = "Absent";
    if Kind == 2u8 { Secondˉname = "Failure"; }
    if !Hˉspanˉequalsˉtext(Input, Cursor + 4u32, Secondˉlength, Secondˉname) {
        return Invalid;
    }
    Cursor = Cursor + 4u32 + Secondˉlength;
    var Error: bytes = Bytesˉslice(Zero, 0u32, 5u32);
    if Kind == 1u8 {
        if Bytesˉreadˉu8(Input, Cursor) != 0u8 { return Invalid; }
    } else {
        if Bytesˉreadˉu8(Input, Cursor) != 1u8 { return Invalid; }
        Cursor = Cursor + 1u32;
        let Errorˉlength: u32 = Bytesˉreadˉu32ˉlittle(Input, Cursor);
        if !Hˉspanˉequalsˉtext(Input, Cursor + 4u32, Errorˉlength, "Error") {
            return Invalid;
        }
        Error = Hˉfoundationˉpayloadˉcell(Input, Cursor + 4u32 + Errorˉlength);
    }
    return Bytesˉconcat(Bytesˉfromˉu8(Kind), Bytesˉconcat(Value, Error));
}

// B-validated Types only. Each 11-byte cell is kind (0/Option/Result),
// exact Value shape, exact Error shape. Scan once; never rescan Types per E1.
export fn Hˉfoundationˉtypes(Input: bytes, Types: u32, Count: u32) -> bytes {
    let Empty: bytes = Bytesˉslice(Input, 0u32, 0u32);
    if Count > 1024u32 { return Empty; }
    var Result: bytes = Empty;
    var Chunk: bytes = Empty;
    var Cursor: u32 = Types + 4u32;
    var Index: u32 = 0u32;
    while Index < Count {
        Chunk = Bytesˉconcat(Chunk, Hˉfoundationˉtypeˉcell(Input, Cursor));
        if Bytesˉlength(Chunk) == 704u32 {
            Result = Bytesˉconcat(Result, Chunk);
            Chunk = Empty;
        }
        Cursor = Hˉnextˉtype(Input, Cursor);
        Index = Index + 1u32;
    }
    return Bytesˉconcat(Result, Chunk);
}

fn Hˉrecordˉhasˉoneˉu64ˉtoken(
    Input: bytes,
    Types: u32,
    Typeˉcount: u32,
    Typeˉindex: u32,
    Fieldˉidentity: text
) -> bool {
    if Typeˉindex >= Typeˉcount { return false; }
    var Cursor: u32 = Hˉtypeˉat(Input, Types, Typeˉindex);
    if U32ˉfromˉu8(Bytesˉreadˉu8(Input, Cursor)) != 1u32 {
        return false;
    }
    Cursor = Hˉafterˉencodedˉstring(Input, Cursor + 1u32);
    if Bytesˉreadˉu32ˉlittle(Input, Cursor) != 1u32 { return false; }
    Cursor = Cursor + 4u32;
    let Fieldˉlength: u32 = Bytesˉreadˉu32ˉlittle(Input, Cursor);
    if !Hˉspanˉequalsˉtext(
            Input, Cursor + 4u32, Fieldˉlength, Fieldˉidentity
        ) {
        return false;
    }
    Cursor = Cursor + 4u32 + Fieldˉlength;
    return U32ˉfromˉu8(Bytesˉreadˉu8(Input, Cursor)) == 10u32 &&
        (Typeˉindex + 1u32 == Typeˉcount || Cursor + 1u32 ==
            Hˉtypeˉat(Input, Types, Typeˉindex + 1u32));
}

fn Hˉtaskˉscopeˉisˉexact(
    Input: bytes,
    Types: u32,
    Typeˉcount: u32,
    Typeˉindex: u32
) -> bool {
    return Hˉrecordˉhasˉoneˉu64ˉtoken(
        Input, Types, Typeˉcount, Typeˉindex,
        "Scopeˉtokenˉidentity"
    );
}

fn Hˉtaskˉhandleˉisˉexact(
    Input: bytes,
    Types: u32,
    Typeˉcount: u32,
    Typeˉindex: u32
) -> bool {
    if !Hˉrecordˉhasˉoneˉu64ˉtoken(
            Input, Types, Typeˉcount, Typeˉindex,
            "Taskˉtokenˉidentity"
        ) {
        return false;
    }
    return Hˉsynthesizedˉgenericˉname(Input, Types, Typeˉindex);
}

export fn Hˉunsafeˉscratchˉisˉexact(
    Input: bytes,
    Types: u32,
    Typeˉcount: u32,
    Typeˉindex: u32
) -> bool {
    return Hˉrecordˉhasˉoneˉu64ˉtoken(
            Input, Types, Typeˉcount, Typeˉindex, "Opaqueˉidentity"
        ) && Hˉsynthesizedˉgenericˉname(Input, Types, Typeˉindex);
}

fn Hˉunsafeˉforeignˉpointerˉfailureˉcaseˉfields(
    Case: u32
) -> u32 {
    if Case == 1u32 || Case == 2u32 { return 3u32; }
    if Case == 3u32 { return 2u32; }
    return 0u32;
}

fn Hˉunsafeˉforeignˉpointerˉfailureˉisˉexact(
    Input: bytes,
    Types: u32,
    Typeˉcount: u32,
    Failureˉtype: u32
) -> bool {
    if Failureˉtype >= Typeˉcount { return false; }
    var Cursor: u32 = Hˉtypeˉat(Input, Types, Failureˉtype);
    if U32ˉfromˉu8(Bytesˉreadˉu8(Input, Cursor)) != 3u32 {
        return false;
    }
    Cursor = Hˉafterˉencodedˉstring(Input, Cursor + 1u32);
    if Bytesˉreadˉu32ˉlittle(Input, Cursor) != 7u32 { return false; }
    Cursor = Cursor + 4u32;

    var Case: u32 = 0u32;
    while Case < 7u32 {
        let Caseˉnameˉlength: u32 = Bytesˉreadˉu32ˉlittle(Input, Cursor);
        var Caseˉnameˉvalid: bool = false;
        if Case == 0u32 {
            Caseˉnameˉvalid = Hˉspanˉequalsˉtext(
                Input, Cursor + 4u32, Caseˉnameˉlength, "Null"
            );
        }
        if Case == 1u32 {
            Caseˉnameˉvalid = Hˉspanˉequalsˉtext(
                Input, Cursor + 4u32, Caseˉnameˉlength,
                "Addressˉoverflow"
            );
        }
        if Case == 2u32 {
            Caseˉnameˉvalid = Hˉspanˉequalsˉtext(
                Input, Cursor + 4u32, Caseˉnameˉlength,
                "Outˉofˉrange"
            );
        }
        if Case == 3u32 {
            Caseˉnameˉvalid = Hˉspanˉequalsˉtext(
                Input, Cursor + 4u32, Caseˉnameˉlength,
                "Misaligned"
            );
        }
        if Case == 4u32 {
            Caseˉnameˉvalid = Hˉspanˉequalsˉtext(
                Input, Cursor + 4u32, Caseˉnameˉlength, "Aliasing"
            );
        }
        if Case == 5u32 {
            Caseˉnameˉvalid = Hˉspanˉequalsˉtext(
                Input, Cursor + 4u32, Caseˉnameˉlength,
                "Lifetimeˉended"
            );
        }
        if Case == 6u32 {
            Caseˉnameˉvalid = Hˉspanˉequalsˉtext(
                Input, Cursor + 4u32, Caseˉnameˉlength,
                "Unsupportedˉabi"
            );
        }
        if !Caseˉnameˉvalid { return false; }
        Cursor = Cursor + 4u32 + Caseˉnameˉlength;

        let Marker: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(Input, Cursor));
        Cursor = Cursor + 1u32;
        var Fields: u32 = 0u32;
        if Marker == 1u32 { Fields = 1u32; }
        if Marker == 2u32 {
            Fields = Bytesˉreadˉu32ˉlittle(Input, Cursor);
            Cursor = Cursor + 4u32;
        }
        let Expectedˉfields: u32 =
            Hˉunsafeˉforeignˉpointerˉfailureˉcaseˉfields(Case);
        if Fields != Expectedˉfields ||
            (Expectedˉfields == 0u32 && Marker != 0u32) ||
            (Expectedˉfields > 1u32 && Marker != 2u32) {
            return false;
        }

        var Field: u32 = 0u32;
        while Field < Fields {
            let Fieldˉnameˉlength: u32 = Bytesˉreadˉu32ˉlittle(
                Input, Cursor
            );
            var Fieldˉnameˉvalid: bool = false;
            if (Case == 1u32 || Case == 2u32 || Case == 3u32) &&
                Field == 0u32 {
                Fieldˉnameˉvalid = Hˉspanˉequalsˉtext(
                    Input, Cursor + 4u32, Fieldˉnameˉlength, "Start"
                );
            }
            if (Case == 1u32 || Case == 2u32) && Field == 1u32 {
                Fieldˉnameˉvalid = Hˉspanˉequalsˉtext(
                    Input, Cursor + 4u32, Fieldˉnameˉlength, "Length"
                );
            }
            if Case == 1u32 && Field == 2u32 {
                Fieldˉnameˉvalid = Hˉspanˉequalsˉtext(
                    Input, Cursor + 4u32, Fieldˉnameˉlength,
                    "Addressˉbits"
                );
            }
            if Case == 2u32 && Field == 2u32 {
                Fieldˉnameˉvalid = Hˉspanˉequalsˉtext(
                    Input, Cursor + 4u32, Fieldˉnameˉlength,
                    "Ownerˉlength"
                );
            }
            if Case == 3u32 && Field == 1u32 {
                Fieldˉnameˉvalid = Hˉspanˉequalsˉtext(
                    Input, Cursor + 4u32, Fieldˉnameˉlength,
                    "Requiredˉalignment"
                );
            }
            if !Fieldˉnameˉvalid { return false; }
            Cursor = Cursor + 4u32 + Fieldˉnameˉlength;
            var Expectedˉkind: u32 = 10u32;
            if Case == 1u32 && Field == 2u32 {
                Expectedˉkind = 5u32;
            }
            if U32ˉfromˉu8(Bytesˉreadˉu8(Input, Cursor)) !=
                    Expectedˉkind {
                return false;
            }
            Cursor = Cursor + 1u32;
            Field = Field + 1u32;
        }
        Case = Case + 1u32;
    }
    return Failureˉtype + 1u32 == Typeˉcount || Cursor ==
        Hˉtypeˉat(Input, Types, Failureˉtype + 1u32);
}

fn Hˉtypeˉpathˉcontains(Path: bytes, Typeˉindex: u32) -> bool {
    var Cursor: u32 = 0u32;
    while Cursor < Bytesˉlength(Path) {
        if Bytesˉreadˉu32ˉlittle(Path, Cursor) == Typeˉindex {
            return true;
        }
        Cursor = Cursor + 4u32;
    }
    return false;
}

fn Hˉownedˉvector(
    Input: bytes,
    Types: u32,
    Typeˉcount: u32,
    Kind: u32,
    Nominal: u32
) -> bool {
    if Kind == 23u32 { return true; }
    if Kind != 7u32 && Kind != 11u32 && Kind != 22u32 {
        return false;
    }
    var Pending: bytes = Bytesˉslice(Input, 0u32, 0u32);
    Pending = Bytesˉconcat(Pending, Bytesˉfromˉu32ˉlittle(0u32));
    Pending = Bytesˉconcat(Pending, Bytesˉfromˉu32ˉlittle(Kind));
    Pending = Bytesˉconcat(Pending, Bytesˉfromˉu32ˉlittle(Nominal));
    var Frames: u32 = 1u32;
    var Path: bytes = Bytesˉslice(Input, 0u32, 0u32);
    var Steps: u32 = 0u32;
    while Frames > 0u32 {
        if Steps >= 8192u32 { return true; }
        let Frame: u32 = Bytesˉlength(Pending) - 12u32;
        let Isˉexit: u32 = Bytesˉreadˉu32ˉlittle(Pending, Frame);
        let Currentˉkind: u32 = Bytesˉreadˉu32ˉlittle(
            Pending, Frame + 4u32
        );
        let Currentˉnominal: u32 = Bytesˉreadˉu32ˉlittle(
            Pending, Frame + 8u32
        );
        Pending = Bytesˉslice(Pending, 0u32, Frame);
        Frames = Frames - 1u32;
        Steps = Steps + 1u32;
        if Isˉexit == 1u32 {
            if Bytesˉlength(Path) < 4u32 { return true; }
            Path = Bytesˉslice(Path, 0u32, Bytesˉlength(Path) - 4u32);
        } else if Currentˉkind == 23u32 {
            return true;
        } else if Currentˉkind == 7u32 || Currentˉkind == 11u32 ||
            Currentˉkind == 22u32 {
            if Currentˉnominal >= Typeˉcount { return false; }
            if Bytesˉlength(Path) >= 256u32 ||
                Hˉtypeˉpathˉcontains(Path, Currentˉnominal) {
                return true;
            }
            if Frames >= 4096u32 { return true; }
            Pending = Bytesˉconcat(
                Pending, Bytesˉfromˉu32ˉlittle(1u32)
            );
            Pending = Bytesˉconcat(
                Pending, Bytesˉfromˉu32ˉlittle(0u32)
            );
            Pending = Bytesˉconcat(
                Pending, Bytesˉfromˉu32ˉlittle(Currentˉnominal)
            );
            Frames = Frames + 1u32;
            Path = Bytesˉconcat(
                Path, Bytesˉfromˉu32ˉlittle(Currentˉnominal)
            );
            var Typeˉcursor: u32 = Hˉtypeˉat(
                Input, Types, Currentˉnominal
            );
            let Typeˉkind: u32 = U32ˉfromˉu8(
                Bytesˉreadˉu8(Input, Typeˉcursor)
            );
            if (Currentˉkind == 7u32 && Typeˉkind != 1u32) ||
                (Currentˉkind == 11u32 && Typeˉkind != 3u32) ||
                (Currentˉkind == 22u32 && Typeˉkind != 4u32) {
                return false;
            }
            if Currentˉkind == 7u32 &&
                (Hˉtaskˉscopeˉisˉexact(
                    Input, Types, Typeˉcount, Currentˉnominal
                ) || Hˉtaskˉhandleˉisˉexact(
                    Input, Types, Typeˉcount, Currentˉnominal
                )) {
                return true;
            }
            Typeˉcursor = Hˉafterˉencodedˉstring(
                Input, Typeˉcursor + 1u32
            );
            var Items: u32 = 1u32;
            if Typeˉkind != 4u32 {
                Items = Bytesˉreadˉu32ˉlittle(Input, Typeˉcursor);
                Typeˉcursor = Typeˉcursor + 4u32;
            }
            var Item: u32 = 0u32;
            while Item < Items {
                if Typeˉkind != 4u32 {
                    Typeˉcursor = Hˉafterˉencodedˉstring(
                        Input, Typeˉcursor
                    );
                }
                var Fields: u32 = 1u32;
                if Typeˉkind == 3u32 {
                    let Marker: u32 = U32ˉfromˉu8(
                        Bytesˉreadˉu8(Input, Typeˉcursor)
                    );
                    Typeˉcursor = Typeˉcursor + 1u32;
                    Fields = 0u32;
                    if Marker == 1u32 { Fields = 1u32; }
                    if Marker == 2u32 {
                        Fields = Bytesˉreadˉu32ˉlittle(Input, Typeˉcursor);
                        Typeˉcursor = Typeˉcursor + 4u32;
                    }
                }
                var Field: u32 = 0u32;
                while Field < Fields {
                    if Typeˉkind == 3u32 {
                        Typeˉcursor = Hˉafterˉencodedˉstring(
                            Input, Typeˉcursor
                        );
                    }
                    let Fieldˉkind: u32 = U32ˉfromˉu8(
                        Bytesˉreadˉu8(Input, Typeˉcursor)
                    );
                    var Fieldˉnominal: u32 = 0u32;
                    if Fieldˉkind == 7u32 || Fieldˉkind == 11u32 ||
                        Fieldˉkind == 22u32 || Fieldˉkind == 23u32 {
                        Fieldˉnominal = Bytesˉreadˉu32ˉlittle(
                            Input, Typeˉcursor + 1u32
                        );
                    }
                    if Frames >= 4096u32 { return true; }
                    Pending = Bytesˉconcat(
                        Pending, Bytesˉfromˉu32ˉlittle(0u32)
                    );
                    Pending = Bytesˉconcat(
                        Pending, Bytesˉfromˉu32ˉlittle(Fieldˉkind)
                    );
                    Pending = Bytesˉconcat(
                        Pending, Bytesˉfromˉu32ˉlittle(Fieldˉnominal)
                    );
                    Frames = Frames + 1u32;
                    Typeˉcursor = Typeˉcursor + Hˉshapeˉwidth(
                        Input, Typeˉcursor
                    );
                    Field = Field + 1u32;
                }
                Item = Item + 1u32;
            }
        }
    }
    return false;
}

export fn Hˉownedˉaggregate(
    Input: bytes,
    Types: u32,
    Typeˉcount: u32,
    Kind: u32,
    Nominal: u32,
    Minor: u32
) -> bool {
    if Minor < 28u32 || Minor > 37u32 || Kind == 23u32 { return false; }
    if (Minor == 33u32 || Minor == 34u32 || Minor == 35u32 ||
        Minor == 36u32 || Minor == 37u32) &&
        Kind == 7u32 &&
        Hˉunsafeˉscratchˉisˉexact(
        Input, Types, Typeˉcount, Nominal
    ) { return true; }
    if Kind == 11u32 && Hˉvectorˉresultˉisˉexact(
        Input, Types, Typeˉcount, Nominal
    ) { return false; }
    if Kind == 11u32 && Hˉtaskˉaffineˉresultˉisˉexact(
        Input, Types, Typeˉcount, Nominal
    ) { return false; }
    return Hˉownedˉvector(
        Input, Types, Typeˉcount, Kind, Nominal
    );
}

fn Hˉownedˉtransferˉkind(Kind: u32) -> u32 {
    if Kind == 7u32 { return 31u32; }
    if Kind == 11u32 { return 32u32; }
    if Kind == 22u32 { return 33u32; }
    return Kind;
}

fn Hˉaffineˉresultˉtransferˉkind(
    Input: bytes,
    Types: u32,
    Minor: u32,
    Kind: u32,
    Nominal: u32
) -> u32 {
    if Kind != 11u32 { return Kind; }
    let Typeˉcount: u32 = Bytesˉreadˉu32ˉlittle(Input, Types);
    if Minor >= 23u32 && Minor <= 37u32 &&
        Hˉmemoryˉbudgetˉresultˉisˉexact(
            Input, Types, Typeˉcount, Nominal
        ) {
        return 28u32;
    }
    if Minor >= 24u32 && Minor <= 37u32 &&
        Hˉvectorˉresultˉisˉexact(
            Input, Types, Typeˉcount, Nominal
        ) {
        return 29u32;
    }
    if (Minor == 32u32 || Minor == 33u32 || Minor == 34u32 ||
        Minor == 35u32 || Minor == 36u32 || Minor == 37u32) &&
        Hˉtaskˉaffineˉresultˉisˉexact(
        Input, Types, Typeˉcount, Nominal
    ) {
        return 32u32;
    }
    if (Minor == 33u32 || Minor == 34u32 || Minor == 35u32 ||
        Minor == 36u32 || Minor == 37u32) &&
        Hˉunsafeˉscratchˉresultˉisˉexact(
        Input, Types, Typeˉcount, Nominal
    ) {
        return 36u32;
    }
    if (Minor == 36u32 || Minor == 37u32) &&
        Hˉunsafeˉwriteˉregionˉresultˉisˉexact(
        Input, Types, Typeˉcount, Nominal
    ) {
        return 37u32;
    }
    return Kind;
}

fn Hˉafterˉencodedˉstring(Input: bytes, Cursor: u32) -> u32 {
    return Cursor + 4u32 + Bytesˉreadˉu32ˉlittle(Input, Cursor);
}

fn Hˉallocationˉfailureˉisˉexact(
    Input: bytes,
    Types: u32,
    Typeˉcount: u32,
    Failureˉtype: u32
) -> bool {
    if Failureˉtype >= Typeˉcount { return false; }
    var Cursor: u32 = Hˉtypeˉat(Input, Types, Failureˉtype);
    if U32ˉfromˉu8(Bytesˉreadˉu8(Input, Cursor)) != 1u32 {
        return false;
    }
    Cursor = Hˉafterˉencodedˉstring(Input, Cursor + 1u32);
    if Bytesˉreadˉu32ˉlittle(Input, Cursor) != 3u32 { return false; }
    Cursor = Cursor + 4u32;
    var Reasonˉtype: u32 = Typeˉcount;
    var Field: u32 = 0u32;
    while Field < 3u32 {
        let Fieldˉnameˉlength: u32 = Bytesˉreadˉu32ˉlittle(Input, Cursor);
        var Fieldˉnameˉvalid: bool = false;
        if Field == 0u32 {
            Fieldˉnameˉvalid = Hˉspanˉequalsˉtext(
                Input, Cursor + 4u32, Fieldˉnameˉlength, "Reason"
            );
        }
        if Field == 1u32 {
            Fieldˉnameˉvalid = Hˉspanˉequalsˉtext(
                Input, Cursor + 4u32, Fieldˉnameˉlength, "Requestedˉbytes"
            );
        }
        if Field == 2u32 {
            Fieldˉnameˉvalid = Hˉspanˉequalsˉtext(
                Input, Cursor + 4u32, Fieldˉnameˉlength, "Availableˉbytes"
            );
        }
        if !Fieldˉnameˉvalid { return false; }
        Cursor = Cursor + 4u32 + Fieldˉnameˉlength;
        let Fieldˉkind: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(Input, Cursor));
        if Field == 0u32 {
            if Fieldˉkind != 8u32 { return false; }
            Reasonˉtype = Bytesˉreadˉu32ˉlittle(Input, Cursor + 1u32);
            Cursor = Cursor + 5u32;
        } else {
            if Fieldˉkind != 10u32 { return false; }
            Cursor = Cursor + 1u32;
        }
        Field = Field + 1u32;
    }
    if Reasonˉtype >= Typeˉcount { return false; }
    if Failureˉtype + 1u32 < Typeˉcount && Cursor !=
        Hˉtypeˉat(Input, Types, Failureˉtype + 1u32) {
        return false;
    }

    Cursor = Hˉtypeˉat(Input, Types, Reasonˉtype);
    if U32ˉfromˉu8(Bytesˉreadˉu8(Input, Cursor)) != 7u32 {
        return false;
    }
    Cursor = Hˉafterˉencodedˉstring(Input, Cursor + 1u32);
    if U32ˉfromˉu8(Bytesˉreadˉu8(Input, Cursor)) != 6u32 {
        return false;
    }
    Cursor = Cursor + 1u32;
    if Bytesˉreadˉu32ˉlittle(Input, Cursor) != 4u32 { return false; }
    Cursor = Cursor + 4u32;
    var Member: u32 = 0u32;
    while Member < 4u32 {
        let Memberˉnameˉlength: u32 = Bytesˉreadˉu32ˉlittle(Input, Cursor);
        var Memberˉnameˉvalid: bool = false;
        if Member == 0u32 {
            Memberˉnameˉvalid = Hˉspanˉequalsˉtext(
                Input, Cursor + 4u32, Memberˉnameˉlength,
                "Budgetˉexhausted"
            );
        }
        if Member == 1u32 {
            Memberˉnameˉvalid = Hˉspanˉequalsˉtext(
                Input, Cursor + 4u32, Memberˉnameˉlength,
                "Targetˉunaddressable"
            );
        }
        if Member == 2u32 {
            Memberˉnameˉvalid = Hˉspanˉequalsˉtext(
                Input, Cursor + 4u32, Memberˉnameˉlength,
                "Providerˉunavailable"
            );
        }
        if Member == 3u32 {
            Memberˉnameˉvalid = Hˉspanˉequalsˉtext(
                Input, Cursor + 4u32, Memberˉnameˉlength, "Fragmented"
            );
        }
        if !Memberˉnameˉvalid { return false; }
        Cursor = Cursor + 4u32 + Memberˉnameˉlength;
        if U32ˉfromˉu8(Bytesˉreadˉu8(Input, Cursor)) != Member + 1u32 {
            return false;
        }
        Cursor = Cursor + 1u32;
        Member = Member + 1u32;
    }
    if Reasonˉtype + 1u32 < Typeˉcount && Cursor !=
        Hˉtypeˉat(Input, Types, Reasonˉtype + 1u32) {
        return false;
    }
    return true;
}

fn Hˉunsafeˉmemoryˉfailureˉisˉexact(
    Input: bytes,
    Types: u32,
    Typeˉcount: u32,
    Failureˉtype: u32
) -> bool {
    if Failureˉtype >= Typeˉcount { return false; }
    var Cursor: u32 = Hˉtypeˉat(Input, Types, Failureˉtype);
    if U32ˉfromˉu8(Bytesˉreadˉu8(Input, Cursor)) != 3u32 {
        return false;
    }
    Cursor = Hˉafterˉencodedˉstring(Input, Cursor + 1u32);
    if Bytesˉreadˉu32ˉlittle(Input, Cursor) != 4u32 { return false; }
    Cursor = Cursor + 4u32;

    var Case: u32 = 0u32;
    while Case < 4u32 {
        let Caseˉnameˉlength: u32 = Bytesˉreadˉu32ˉlittle(Input, Cursor);
        var Caseˉnameˉvalid: bool = false;
        if Case == 0u32 {
            Caseˉnameˉvalid = Hˉspanˉequalsˉtext(
                Input, Cursor + 4u32, Caseˉnameˉlength, "Invalidˉlength"
            );
        }
        if Case == 1u32 {
            Caseˉnameˉvalid = Hˉspanˉequalsˉtext(
                Input, Cursor + 4u32, Caseˉnameˉlength,
                "Invalidˉalignment"
            );
        }
        if Case == 2u32 {
            Caseˉnameˉvalid = Hˉspanˉequalsˉtext(
                Input, Cursor + 4u32, Caseˉnameˉlength, "Allocation"
            );
        }
        if Case == 3u32 {
            Caseˉnameˉvalid = Hˉspanˉequalsˉtext(
                Input, Cursor + 4u32, Caseˉnameˉlength,
                "Unsupportedˉabi"
            );
        }
        if !Caseˉnameˉvalid { return false; }
        Cursor = Cursor + 4u32 + Caseˉnameˉlength;

        let Marker: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(Input, Cursor));
        Cursor = Cursor + 1u32;
        var Fields: u32 = 0u32;
        if Marker == 1u32 { Fields = 1u32; }
        if Marker == 2u32 {
            Fields = Bytesˉreadˉu32ˉlittle(Input, Cursor);
            Cursor = Cursor + 4u32;
        }
        var Expectedˉfields: u32 = 0u32;
        if Case == 0u32 { Expectedˉfields = 2u32; }
        if Case == 1u32 || Case == 2u32 { Expectedˉfields = 1u32; }
        if Fields != Expectedˉfields { return false; }

        var Field: u32 = 0u32;
        while Field < Fields {
            let Fieldˉnameˉlength: u32 = Bytesˉreadˉu32ˉlittle(
                Input, Cursor
            );
            var Fieldˉnameˉvalid: bool = false;
            if Case == 0u32 && Field == 0u32 {
                Fieldˉnameˉvalid = Hˉspanˉequalsˉtext(
                    Input, Cursor + 4u32, Fieldˉnameˉlength, "Observed"
                );
            }
            if Case == 0u32 && Field == 1u32 {
                Fieldˉnameˉvalid = Hˉspanˉequalsˉtext(
                    Input, Cursor + 4u32, Fieldˉnameˉlength, "Maximum"
                );
            }
            if Case == 1u32 {
                Fieldˉnameˉvalid = Hˉspanˉequalsˉtext(
                    Input, Cursor + 4u32, Fieldˉnameˉlength, "Observed"
                );
            }
            if Case == 2u32 {
                Fieldˉnameˉvalid = Hˉspanˉequalsˉtext(
                    Input, Cursor + 4u32, Fieldˉnameˉlength, "Error"
                );
            }
            if !Fieldˉnameˉvalid { return false; }
            Cursor = Cursor + 4u32 + Fieldˉnameˉlength;
            let Fieldˉkind: u32 = U32ˉfromˉu8(
                Bytesˉreadˉu8(Input, Cursor)
            );
            if Case == 2u32 {
                if Fieldˉkind != 7u32 ||
                    !Hˉallocationˉfailureˉisˉexact(
                        Input, Types, Typeˉcount,
                        Bytesˉreadˉu32ˉlittle(Input, Cursor + 1u32)
                    ) {
                    return false;
                }
            } else if Fieldˉkind != 10u32 {
                return false;
            }
            Cursor = Cursor + Hˉshapeˉwidth(Input, Cursor);
            Field = Field + 1u32;
        }
        Case = Case + 1u32;
    }
    return Failureˉtype + 1u32 == Typeˉcount || Cursor ==
        Hˉtypeˉat(Input, Types, Failureˉtype + 1u32);
}

export fn Hˉunsafeˉscratchˉresultˉisˉexact(
    Input: bytes,
    Types: u32,
    Typeˉcount: u32,
    Resultˉtype: u32
) -> bool {
    if Resultˉtype >= Typeˉcount ||
        !Hˉsynthesizedˉgenericˉname(Input, Types, Resultˉtype) {
        return false;
    }
    var Cursor: u32 = Hˉtypeˉat(Input, Types, Resultˉtype);
    if U32ˉfromˉu8(Bytesˉreadˉu8(Input, Cursor)) != 3u32 {
        return false;
    }
    Cursor = Hˉafterˉencodedˉstring(Input, Cursor + 1u32);
    if Bytesˉreadˉu32ˉlittle(Input, Cursor) != 2u32 { return false; }
    Cursor = Cursor + 4u32;

    let Validˉnameˉlength: u32 = Bytesˉreadˉu32ˉlittle(Input, Cursor);
    if !Hˉspanˉequalsˉtext(
            Input, Cursor + 4u32, Validˉnameˉlength, "Valid"
        ) {
        return false;
    }
    Cursor = Cursor + 4u32 + Validˉnameˉlength;
    if U32ˉfromˉu8(Bytesˉreadˉu8(Input, Cursor)) != 1u32 {
        return false;
    }
    Cursor = Cursor + 1u32;
    let Valueˉnameˉlength: u32 = Bytesˉreadˉu32ˉlittle(Input, Cursor);
    if !Hˉspanˉequalsˉtext(
            Input, Cursor + 4u32, Valueˉnameˉlength, "Value"
        ) {
        return false;
    }
    Cursor = Cursor + 4u32 + Valueˉnameˉlength;
    if U32ˉfromˉu8(Bytesˉreadˉu8(Input, Cursor)) != 7u32 ||
        !Hˉunsafeˉscratchˉisˉexact(
            Input, Types, Typeˉcount,
            Bytesˉreadˉu32ˉlittle(Input, Cursor + 1u32)
        ) {
        return false;
    }
    Cursor = Cursor + 5u32;

    let Failureˉnameˉlength: u32 = Bytesˉreadˉu32ˉlittle(Input, Cursor);
    if !Hˉspanˉequalsˉtext(
            Input, Cursor + 4u32, Failureˉnameˉlength, "Failure"
        ) {
        return false;
    }
    Cursor = Cursor + 4u32 + Failureˉnameˉlength;
    if U32ˉfromˉu8(Bytesˉreadˉu8(Input, Cursor)) != 1u32 {
        return false;
    }
    Cursor = Cursor + 1u32;
    let Errorˉnameˉlength: u32 = Bytesˉreadˉu32ˉlittle(Input, Cursor);
    if !Hˉspanˉequalsˉtext(
            Input, Cursor + 4u32, Errorˉnameˉlength, "Error"
        ) {
        return false;
    }
    Cursor = Cursor + 4u32 + Errorˉnameˉlength;
    if U32ˉfromˉu8(Bytesˉreadˉu8(Input, Cursor)) != 11u32 ||
        !Hˉunsafeˉmemoryˉfailureˉisˉexact(
            Input, Types, Typeˉcount,
            Bytesˉreadˉu32ˉlittle(Input, Cursor + 1u32)
        ) {
        return false;
    }
    Cursor = Cursor + 5u32;
    return Resultˉtype + 1u32 == Typeˉcount || Cursor ==
        Hˉtypeˉat(Input, Types, Resultˉtype + 1u32);
}

export fn Hˉunsafeˉscratchˉresultˉvalueˉtype(
    Input: bytes,
    Types: u32,
    Typeˉcount: u32,
    Resultˉtype: u32
) -> u32 {
    if !Hˉunsafeˉscratchˉresultˉisˉexact(
            Input, Types, Typeˉcount, Resultˉtype
        ) {
        return 4294967295u32;
    }
    let Valid: bytes = Hˉvariantˉcaseˉat(
        Input, Types, Resultˉtype, 0u32
    );
    return Bytesˉreadˉu32ˉlittle(Valid, 5u32);
}

export fn Hˉunsafeˉwriteˉregionˉresultˉisˉexact(
    Input: bytes,
    Types: u32,
    Typeˉcount: u32,
    Resultˉtype: u32
) -> bool {
    if Resultˉtype >= Typeˉcount ||
        !Hˉsynthesizedˉgenericˉname(Input, Types, Resultˉtype) {
        return false;
    }
    var Cursor: u32 = Hˉtypeˉat(Input, Types, Resultˉtype);
    if U32ˉfromˉu8(Bytesˉreadˉu8(Input, Cursor)) != 3u32 {
        return false;
    }
    Cursor = Hˉafterˉencodedˉstring(Input, Cursor + 1u32);
    if Bytesˉreadˉu32ˉlittle(Input, Cursor) != 2u32 { return false; }
    Cursor = Cursor + 4u32;

    let Validˉnameˉlength: u32 = Bytesˉreadˉu32ˉlittle(Input, Cursor);
    if !Hˉspanˉequalsˉtext(
            Input, Cursor + 4u32, Validˉnameˉlength, "Valid"
        ) {
        return false;
    }
    Cursor = Cursor + 4u32 + Validˉnameˉlength;
    if U32ˉfromˉu8(Bytesˉreadˉu8(Input, Cursor)) != 1u32 {
        return false;
    }
    Cursor = Cursor + 1u32;
    let Valueˉnameˉlength: u32 = Bytesˉreadˉu32ˉlittle(Input, Cursor);
    if !Hˉspanˉequalsˉtext(
            Input, Cursor + 4u32, Valueˉnameˉlength, "Value"
        ) {
        return false;
    }
    Cursor = Cursor + 4u32 + Valueˉnameˉlength;
    if U32ˉfromˉu8(Bytesˉreadˉu8(Input, Cursor)) != 7u32 ||
        !Hˉunsafeˉscratchˉisˉexact(
            Input, Types, Typeˉcount,
            Bytesˉreadˉu32ˉlittle(Input, Cursor + 1u32)
        ) {
        return false;
    }
    Cursor = Cursor + 5u32;

    let Failureˉnameˉlength: u32 = Bytesˉreadˉu32ˉlittle(Input, Cursor);
    if !Hˉspanˉequalsˉtext(
            Input, Cursor + 4u32, Failureˉnameˉlength, "Failure"
        ) {
        return false;
    }
    Cursor = Cursor + 4u32 + Failureˉnameˉlength;
    if U32ˉfromˉu8(Bytesˉreadˉu8(Input, Cursor)) != 1u32 {
        return false;
    }
    Cursor = Cursor + 1u32;
    let Errorˉnameˉlength: u32 = Bytesˉreadˉu32ˉlittle(Input, Cursor);
    if !Hˉspanˉequalsˉtext(
            Input, Cursor + 4u32, Errorˉnameˉlength, "Error"
        ) {
        return false;
    }
    Cursor = Cursor + 4u32 + Errorˉnameˉlength;
    if U32ˉfromˉu8(Bytesˉreadˉu8(Input, Cursor)) != 11u32 ||
        !Hˉunsafeˉforeignˉpointerˉfailureˉisˉexact(
            Input, Types, Typeˉcount,
            Bytesˉreadˉu32ˉlittle(Input, Cursor + 1u32)
        ) {
        return false;
    }
    Cursor = Cursor + 5u32;
    return Resultˉtype + 1u32 == Typeˉcount || Cursor ==
        Hˉtypeˉat(Input, Types, Resultˉtype + 1u32);
}

export fn Hˉunsafeˉwriteˉregionˉresultˉvalueˉtype(
    Input: bytes,
    Types: u32,
    Typeˉcount: u32,
    Resultˉtype: u32
) -> u32 {
    if !Hˉunsafeˉwriteˉregionˉresultˉisˉexact(
            Input, Types, Typeˉcount, Resultˉtype
        ) {
        return 4294967295u32;
    }
    let Valid: bytes = Hˉvariantˉcaseˉat(
        Input, Types, Resultˉtype, 0u32
    );
    return Bytesˉreadˉu32ˉlittle(Valid, 5u32);
}

fn Hˉmemoryˉbudgetˉresultˉisˉexact(
    Input: bytes,
    Types: u32,
    Typeˉcount: u32,
    Resultˉtype: u32
) -> bool {
    if Resultˉtype >= Typeˉcount { return false; }
    let Resultˉcursor: u32 = Hˉtypeˉat(Input, Types, Resultˉtype);
    if U32ˉfromˉu8(Bytesˉreadˉu8(Input, Resultˉcursor)) != 3u32 {
        return false;
    }
    let Resultˉitems: u32 = Hˉafterˉencodedˉstring(
        Input, Resultˉcursor + 1u32
    );
    if Bytesˉreadˉu32ˉlittle(Input, Resultˉitems) != 2u32 { return false; }

    let Validˉcase: bytes = Hˉvariantˉcaseˉat(
        Input, Types, Resultˉtype, 0u32
    );
    let Failureˉcase: bytes = Hˉvariantˉcaseˉat(
        Input, Types, Resultˉtype, 1u32
    );
    if Bytesˉlength(Validˉcase) != 9u32 ||
        Bytesˉreadˉu32ˉlittle(Validˉcase, 0u32) != 1u32 ||
        U32ˉfromˉu8(Bytesˉreadˉu8(Validˉcase, 4u32)) != 25u32 ||
        Bytesˉreadˉu32ˉlittle(Validˉcase, 5u32) != 0u32 {
        return false;
    }
    if Bytesˉlength(Failureˉcase) != 9u32 ||
        Bytesˉreadˉu32ˉlittle(Failureˉcase, 0u32) != 1u32 ||
        U32ˉfromˉu8(Bytesˉreadˉu8(Failureˉcase, 4u32)) != 7u32 {
        return false;
    }
    let Failureˉtype: u32 = Bytesˉreadˉu32ˉlittle(
        Failureˉcase, 5u32
    );
    return Hˉallocationˉfailureˉisˉexact(
        Input, Types, Typeˉcount, Failureˉtype
    );
}

fn Hˉallocationˉunitˉresultˉisˉexact(
    Input: bytes,
    Types: u32,
    Typeˉcount: u32,
    Resultˉtype: u32
) -> bool {
    if Resultˉtype >= Typeˉcount { return false; }
    let Resultˉcursor: u32 = Hˉtypeˉat(Input, Types, Resultˉtype);
    if U32ˉfromˉu8(Bytesˉreadˉu8(Input, Resultˉcursor)) != 3u32 {
        return false;
    }
    let Resultˉitems: u32 = Hˉafterˉencodedˉstring(
        Input, Resultˉcursor + 1u32
    );
    if Bytesˉreadˉu32ˉlittle(Input, Resultˉitems) != 2u32 { return false; }
    let Validˉcase: bytes = Hˉvariantˉcaseˉat(
        Input, Types, Resultˉtype, 0u32
    );
    let Failureˉcase: bytes = Hˉvariantˉcaseˉat(
        Input, Types, Resultˉtype, 1u32
    );
    if Bytesˉlength(Validˉcase) != 9u32 ||
        Bytesˉreadˉu32ˉlittle(Validˉcase, 0u32) != 1u32 ||
        U32ˉfromˉu8(Bytesˉreadˉu8(Validˉcase, 4u32)) != 20u32 ||
        Bytesˉreadˉu32ˉlittle(Validˉcase, 5u32) != 0u32 {
        return false;
    }
    if Bytesˉlength(Failureˉcase) != 9u32 ||
        Bytesˉreadˉu32ˉlittle(Failureˉcase, 0u32) != 1u32 ||
        U32ˉfromˉu8(Bytesˉreadˉu8(Failureˉcase, 4u32)) != 7u32 {
        return false;
    }
    return Hˉallocationˉfailureˉisˉexact(
        Input, Types, Typeˉcount,
        Bytesˉreadˉu32ˉlittle(Failureˉcase, 5u32)
    );
}

fn Hˉvectorˉresultˉisˉexact(
    Input: bytes,
    Types: u32,
    Typeˉcount: u32,
    Resultˉtype: u32
) -> bool {
    if Resultˉtype >= Typeˉcount { return false; }
    let Resultˉcursor: u32 = Hˉtypeˉat(Input, Types, Resultˉtype);
    if U32ˉfromˉu8(Bytesˉreadˉu8(Input, Resultˉcursor)) != 3u32 {
        return false;
    }
    let Resultˉitems: u32 = Hˉafterˉencodedˉstring(
        Input, Resultˉcursor + 1u32
    );
    if Bytesˉreadˉu32ˉlittle(Input, Resultˉitems) != 2u32 { return false; }
    let Validˉcase: bytes = Hˉvariantˉcaseˉat(
        Input, Types, Resultˉtype, 0u32
    );
    let Failureˉcase: bytes = Hˉvariantˉcaseˉat(
        Input, Types, Resultˉtype, 1u32
    );
    if Bytesˉlength(Validˉcase) != 9u32 ||
        Bytesˉreadˉu32ˉlittle(Validˉcase, 0u32) != 1u32 ||
        U32ˉfromˉu8(Bytesˉreadˉu8(Validˉcase, 4u32)) != 23u32 {
        return false;
    }
    let Vectorˉtype: u32 = Bytesˉreadˉu32ˉlittle(Validˉcase, 5u32);
    if Vectorˉtype >= Typeˉcount || Bytesˉlength(
        Hˉcollectionˉdescriptor(Input, Types, Vectorˉtype, 5u32)
    ) != 5u32 {
        return false;
    }
    if !Hˉcollectionˉscalarˉelement(
        Hˉcollectionˉdescriptor(Input, Types, Vectorˉtype, 5u32)
    ) {
        return false;
    }
    if Bytesˉlength(Failureˉcase) != 9u32 ||
        Bytesˉreadˉu32ˉlittle(Failureˉcase, 0u32) != 1u32 ||
        U32ˉfromˉu8(Bytesˉreadˉu8(Failureˉcase, 4u32)) != 7u32 {
        return false;
    }
    return Hˉallocationˉfailureˉisˉexact(
        Input, Types, Typeˉcount,
        Bytesˉreadˉu32ˉlittle(Failureˉcase, 5u32)
    );
}

fn Hˉcollectionˉfailureˉcaseˉfields(Index: u32) -> u32 {
    if Index == 0u32 { return 4u32; }
    if Index == 3u32 || Index == 5u32 { return 0u32; }
    if Index == 6u32 || Index == 8u32 { return 2u32; }
    return 1u32;
}

fn Hˉcollectionˉfailureˉisˉexact(
    Input: bytes,
    Types: u32,
    Typeˉcount: u32,
    Failureˉtype: u32
) -> bool {
    if Failureˉtype >= Typeˉcount { return false; }
    let Failureˉcursor: u32 = Hˉtypeˉat(Input, Types, Failureˉtype);
    if U32ˉfromˉu8(Bytesˉreadˉu8(Input, Failureˉcursor)) != 3u32 {
        return false;
    }
    let Failureˉitems: u32 = Hˉafterˉencodedˉstring(
        Input, Failureˉcursor + 1u32
    );
    if Bytesˉreadˉu32ˉlittle(Input, Failureˉitems) != 10u32 {
        return false;
    }
    var Caseˉindex: u32 = 0u32;
    while Caseˉindex < 10u32 {
        let Caseˉfields: bytes = Hˉvariantˉcaseˉat(
            Input, Types, Failureˉtype, Caseˉindex
        );
        let Expectedˉfields: u32 =
            Hˉcollectionˉfailureˉcaseˉfields(Caseˉindex);
        if Bytesˉlength(Caseˉfields) != 4u32 + Expectedˉfields * 5u32 ||
            Bytesˉreadˉu32ˉlittle(Caseˉfields, 0u32) != Expectedˉfields {
            return false;
        }
        var Fieldˉindex: u32 = 0u32;
        while Fieldˉindex < Expectedˉfields {
            let Fieldˉoffset: u32 = 4u32 + Fieldˉindex * 5u32;
            let Fieldˉkind: u32 = U32ˉfromˉu8(
                Bytesˉreadˉu8(Caseˉfields, Fieldˉoffset)
            );
            if Caseˉindex == 1u32 {
                if Fieldˉkind != 7u32 ||
                    !Hˉallocationˉfailureˉisˉexact(
                        Input, Types, Typeˉcount,
                        Bytesˉreadˉu32ˉlittle(
                            Caseˉfields, Fieldˉoffset + 1u32
                        )
                    ) {
                    return false;
                }
            } else {
                var Expectedˉkind: u32 = 10u32;
                if Caseˉindex == 0u32 && Fieldˉindex == 0u32 {
                    Expectedˉkind = 5u32;
                }
                if Fieldˉkind != Expectedˉkind { return false; }
            }
            Fieldˉindex = Fieldˉindex + 1u32;
        }
        Caseˉindex = Caseˉindex + 1u32;
    }
    return true;
}

fn Hˉvectorˉappendˉfailureˉisˉexact(
    Input: bytes,
    Types: u32,
    Typeˉcount: u32,
    Appendˉfailureˉtype: u32,
    Element: bytes
) -> bool {
    if Appendˉfailureˉtype >= Typeˉcount || Bytesˉlength(Element) != 5u32 {
        return false;
    }
    var Cursor: u32 = Hˉtypeˉat(Input, Types, Appendˉfailureˉtype);
    if U32ˉfromˉu8(Bytesˉreadˉu8(Input, Cursor)) != 1u32 {
        return false;
    }
    Cursor = Hˉafterˉencodedˉstring(Input, Cursor + 1u32);
    if Bytesˉreadˉu32ˉlittle(Input, Cursor) != 2u32 { return false; }
    Cursor = Hˉafterˉencodedˉstring(Input, Cursor + 4u32);
    if U32ˉfromˉu8(Bytesˉreadˉu8(Input, Cursor)) != 11u32 {
        return false;
    }
    let Collectionˉfailureˉtype: u32 = Bytesˉreadˉu32ˉlittle(
        Input, Cursor + 1u32
    );
    Cursor = Hˉafterˉencodedˉstring(Input, Cursor + 5u32);
    if U32ˉfromˉu8(Bytesˉreadˉu8(Input, Cursor)) !=
            U32ˉfromˉu8(Bytesˉreadˉu8(Element, 0u32)) {
        return false;
    }
    var Valueˉnominal: u32 = 0u32;
    if Hˉshapeˉwidth(Input, Cursor) == 5u32 {
        Valueˉnominal = Bytesˉreadˉu32ˉlittle(Input, Cursor + 1u32);
    }
    if Valueˉnominal != Bytesˉreadˉu32ˉlittle(Element, 1u32) {
        return false;
    }
    Cursor = Cursor + Hˉshapeˉwidth(Input, Cursor);
    if Appendˉfailureˉtype + 1u32 < Typeˉcount && Cursor !=
        Hˉtypeˉat(Input, Types, Appendˉfailureˉtype + 1u32) {
        return false;
    }
    return Hˉcollectionˉfailureˉisˉexact(
        Input, Types, Typeˉcount, Collectionˉfailureˉtype
    );
}

fn Hˉvectorˉappendˉresultˉisˉexact(
    Input: bytes,
    Types: u32,
    Typeˉcount: u32,
    Resultˉtype: u32,
    Vectorˉtype: u32
) -> bool {
    if Resultˉtype >= Typeˉcount || Vectorˉtype >= Typeˉcount {
        return false;
    }
    let Element: bytes = Hˉcollectionˉdescriptor(
        Input, Types, Vectorˉtype, 5u32
    );
    if !Hˉcollectionˉscalarˉelement(Element) { return false; }
    let Resultˉcursor: u32 = Hˉtypeˉat(Input, Types, Resultˉtype);
    if U32ˉfromˉu8(Bytesˉreadˉu8(Input, Resultˉcursor)) != 3u32 {
        return false;
    }
    let Resultˉitems: u32 = Hˉafterˉencodedˉstring(
        Input, Resultˉcursor + 1u32
    );
    if Bytesˉreadˉu32ˉlittle(Input, Resultˉitems) != 2u32 { return false; }
    let Validˉcase: bytes = Hˉvariantˉcaseˉat(
        Input, Types, Resultˉtype, 0u32
    );
    let Failureˉcase: bytes = Hˉvariantˉcaseˉat(
        Input, Types, Resultˉtype, 1u32
    );
    if Bytesˉlength(Validˉcase) != 9u32 ||
        Bytesˉreadˉu32ˉlittle(Validˉcase, 0u32) != 1u32 ||
        U32ˉfromˉu8(Bytesˉreadˉu8(Validˉcase, 4u32)) != 20u32 ||
        Bytesˉreadˉu32ˉlittle(Validˉcase, 5u32) != 0u32 {
        return false;
    }
    if Bytesˉlength(Failureˉcase) != 9u32 ||
        Bytesˉreadˉu32ˉlittle(Failureˉcase, 0u32) != 1u32 ||
        U32ˉfromˉu8(Bytesˉreadˉu8(Failureˉcase, 4u32)) != 7u32 {
        return false;
    }
    return Hˉvectorˉappendˉfailureˉisˉexact(
        Input, Types, Typeˉcount,
        Bytesˉreadˉu32ˉlittle(Failureˉcase, 5u32), Element
    );
}

fn Hˉownedˉlocalˉshape(
    Input: bytes,
    Types: u32,
    Typeˉcount: u32,
    Localˉshapes: bytes,
    Slot: u32,
    Minor: u32
) -> bool {
    let Shape: u32 = Slot * 5u32;
    let Kind: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(Localˉshapes, Shape));
    if Kind == 23u32 { return true; }
    if Kind == 34u32 {
        return Minor == 29u32 || Minor == 30u32 || Minor == 31u32 ||
            Minor == 32u32 || Minor == 33u32 || Minor == 34u32 ||
            Minor == 35u32 || Minor == 36u32 || Minor == 37u32;
    }
    let Nominal: u32 = Bytesˉreadˉu32ˉlittle(
        Localˉshapes, Shape + 1u32
    );
    if Hˉownedˉaggregate(
        Input, Types, Typeˉcount, Kind, Nominal, Minor
    ) { return true; }
    if Minor < 23u32 || Minor > 37u32 { return false; }
    if Kind == 25u32 { return true; }
    if Kind != 11u32 { return false; }
    if Hˉmemoryˉbudgetˉresultˉisˉexact(
        Input, Types, Typeˉcount, Nominal
    ) { return true; }
    if (Minor == 32u32 || Minor == 33u32 || Minor == 34u32 ||
        Minor == 35u32 || Minor == 36u32 || Minor == 37u32) &&
        Hˉtaskˉaffineˉresultˉisˉexact(
        Input, Types, Typeˉcount, Nominal
    ) { return true; }
    if (Minor == 33u32 || Minor == 34u32 || Minor == 35u32 ||
        Minor == 36u32 || Minor == 37u32) &&
        Hˉunsafeˉscratchˉresultˉisˉexact(
        Input, Types, Typeˉcount, Nominal
    ) { return true; }
    if (Minor == 36u32 || Minor == 37u32) &&
        Hˉunsafeˉwriteˉregionˉresultˉisˉexact(
        Input, Types, Typeˉcount, Nominal
    ) { return true; }
    return Minor >= 24u32 && Minor <= 37u32 && Hˉvectorˉresultˉisˉexact(
        Input, Types, Typeˉcount, Nominal
    );
}

fn Iˉtrackedˉownedˉlocalˉshape(
    Input: bytes,
    Types: u32,
    Typeˉcount: u32,
    Localˉshapes: bytes,
    Slot: u32,
    Minor: u32,
    Pointerˉtypes: bytes
) -> bool {
    let Shape: u32 = Slot * 5u32;
    if Minor == 37u32 &&
        U32ˉfromˉu8(Bytesˉreadˉu8(Localˉshapes, Shape)) == 7u32 {
        let Nominal: u32 = Bytesˉreadˉu32ˉlittle(
            Localˉshapes, Shape + 1u32
        );
        var Pointer: u32 = 0u32;
        while Pointer < Bytesˉlength(Pointerˉtypes) {
            if Bytesˉreadˉu32ˉlittle(Pointerˉtypes, Pointer) == Nominal {
                return true;
            }
            Pointer = Pointer + 4u32;
        }
    }
    if (Minor == 36u32 || Minor == 37u32) &&
        U32ˉfromˉu8(Bytesˉreadˉu8(Localˉshapes, Shape)) == 28u32 &&
        Hˉunsafeˉscratchˉisˉexact(
            Input, Types, Typeˉcount,
            Bytesˉreadˉu32ˉlittle(Localˉshapes, Shape + 1u32)
        ) {
        return true;
    }
    return Hˉownedˉlocalˉshape(
        Input, Types, Typeˉcount, Localˉshapes, Slot, Minor
    );
}

fn Iˉownedˉlocalˉrank(
    Input: bytes,
    Types: u32,
    Typeˉcount: u32,
    Localˉshapes: bytes,
    Slot: u32,
    Minor: u32,
    Pointerˉtypes: bytes
) -> u32 {
    if Slot * 5u32 >= Bytesˉlength(Localˉshapes) ||
        !Iˉtrackedˉownedˉlocalˉshape(
            Input, Types, Typeˉcount, Localˉshapes, Slot, Minor,
            Pointerˉtypes
        ) {
        return 4294967295u32;
    }
    var Rank: u32 = 0u32;
    var Earlier: u32 = 0u32;
    while Earlier < Slot {
        if Iˉtrackedˉownedˉlocalˉshape(
            Input, Types, Typeˉcount, Localˉshapes, Earlier, Minor,
            Pointerˉtypes
        ) {
            Rank = Rank + 1u32;
        }
        Earlier = Earlier + 1u32;
    }
    return Rank;
}

fn Iˉownedˉrankˉisˉavailable(
    Low: u32,
    High: u32,
    Rank: u32
) -> bool {
    if Rank == 4294967295u32 { return false; }
    if Rank < 32u32 { return ((Low >> Rank) & 1u32) == 1u32; }
    return ((High >> (Rank - 32u32)) & 1u32) == 1u32;
}

fn Hˉvariantˉcaseˉat(
    Input: bytes,
    Types: u32,
    Typeˉindex: u32,
    Caseˉindex: u32
) -> bytes {
    let Invalid: bytes = Bytesˉslice(Input, 0u32, 0u32);
    var Cursor: u32 = Types + 4u32;
    var Currentˉtype: u32 = 0u32;
    while Currentˉtype < Typeˉindex {
        Cursor = Hˉnextˉtype(Input, Cursor);
        Currentˉtype = Currentˉtype + 1u32;
    }
    if U32ˉfromˉu8(Bytesˉreadˉu8(Input, Cursor)) != 3u32 {
        return Invalid;
    }
    Cursor = Cursor + 1u32;
    let Typeˉnameˉlength: u32 = Bytesˉreadˉu32ˉlittle(Input, Cursor);
    Cursor = Cursor + 4u32 + Typeˉnameˉlength;
    let Caseˉcount: u32 = Bytesˉreadˉu32ˉlittle(Input, Cursor);
    if Caseˉindex >= Caseˉcount {
        return Invalid;
    }
    Cursor = Cursor + 4u32;
    var Currentˉcase: u32 = 0u32;
    while Currentˉcase < Caseˉindex {
        let Skippedˉcaseˉnameˉlength: u32 = Bytesˉreadˉu32ˉlittle(Input, Cursor);
        Cursor = Cursor + 4u32 + Skippedˉcaseˉnameˉlength;
        Cursor = Hˉvariantˉcaseˉend(Input, Cursor);
        Currentˉcase = Currentˉcase + 1u32;
    }
    let Selectedˉcaseˉnameˉlength: u32 = Bytesˉreadˉu32ˉlittle(Input, Cursor);
    Cursor = Cursor + 4u32 + Selectedˉcaseˉnameˉlength;
    let Marker: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(Input, Cursor));
    Cursor = Cursor + 1u32;
    var Fields: u32 = 0u32;
    if Marker == 1u32 { Fields = 1u32; }
    if Marker == 2u32 {
        Fields = Bytesˉreadˉu32ˉlittle(Input, Cursor);
        Cursor = Cursor + 4u32;
    }
    var Result: bytes = Bytesˉfromˉu32ˉlittle(Fields);
    var Field: u32 = 0u32;
    while Field < Fields {
        let Selectedˉfieldˉnameˉlength: u32 =
            Bytesˉreadˉu32ˉlittle(Input, Cursor);
        Cursor = Cursor + 4u32 + Selectedˉfieldˉnameˉlength;
        let Fieldˉkind: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(Input, Cursor));
        var Fieldˉnominal: u32 = 0u32;
        if Hˉshapeˉwidth(Input, Cursor) == 5u32 {
            Fieldˉnominal = Bytesˉreadˉu32ˉlittle(Input, Cursor + 1u32);
        }
        Result = Bytesˉconcat(Result, Bytesˉslice(Input, Cursor, 1u32));
        Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Fieldˉnominal));
        Cursor = Cursor + Hˉshapeˉwidth(Input, Cursor);
        Field = Field + 1u32;
    }
    return Result;
}

fn Hˉvariantˉcaseˉcount(
    Input: bytes,
    Types: u32,
    Typeˉcount: u32,
    Typeˉindex: u32
) -> u32 {
    if Typeˉindex >= Typeˉcount { return 4294967295u32; }
    var Cursor: u32 = Hˉtypeˉat(Input, Types, Typeˉindex);
    if U32ˉfromˉu8(Bytesˉreadˉu8(Input, Cursor)) != 3u32 {
        return 4294967295u32;
    }
    Cursor = Hˉafterˉencodedˉstring(Input, Cursor + 1u32);
    return Bytesˉreadˉu32ˉlittle(Input, Cursor);
}

fn Hˉtaskˉaffineˉresultˉisˉexact(
    Input: bytes,
    Types: u32,
    Typeˉcount: u32,
    Resultˉtype: u32
) -> bool {
    if Hˉvariantˉcaseˉcount(
            Input, Types, Typeˉcount, Resultˉtype
        ) != 2u32 {
        return false;
    }
    let Valid: bytes = Hˉvariantˉcaseˉat(
        Input, Types, Resultˉtype, 0u32
    );
    if Bytesˉlength(Valid) != 9u32 ||
        Bytesˉreadˉu32ˉlittle(Valid, 0u32) != 1u32 ||
        U32ˉfromˉu8(Bytesˉreadˉu8(Valid, 4u32)) != 7u32 {
        return false;
    }
    let Valueˉtype: u32 = Bytesˉreadˉu32ˉlittle(Valid, 5u32);
    return Hˉtaskˉscopeˉisˉexact(
            Input, Types, Typeˉcount, Valueˉtype
        ) || Hˉtaskˉhandleˉisˉexact(
            Input, Types, Typeˉcount, Valueˉtype
        );
}

fn Hˉtaskˉlimitsˉisˉexact(
    Input: bytes,
    Types: u32,
    Typeˉcount: u32,
    Typeˉindex: u32
) -> bool {
    if Typeˉindex >= Typeˉcount { return false; }
    var Cursor: u32 = Hˉtypeˉat(Input, Types, Typeˉindex);
    if U32ˉfromˉu8(Bytesˉreadˉu8(Input, Cursor)) != 1u32 {
        return false;
    }
    Cursor = Hˉafterˉencodedˉstring(Input, Cursor + 1u32);
    if Bytesˉreadˉu32ˉlittle(Input, Cursor) != 8u32 { return false; }
    Cursor = Cursor + 4u32;
    var Field: u32 = 0u32;
    while Field < 8u32 {
        let Fieldˉlength: u32 = Bytesˉreadˉu32ˉlittle(Input, Cursor);
        var Nameˉvalid: bool = false;
        if Field == 0u32 {
            Nameˉvalid = Hˉspanˉequalsˉtext(
                Input, Cursor + 4u32, Fieldˉlength, "Maximumˉchildren"
            );
        }
        if Field == 1u32 {
            Nameˉvalid = Hˉspanˉequalsˉtext(
                Input, Cursor + 4u32, Fieldˉlength, "Maximumˉrunnable"
            );
        }
        if Field == 2u32 {
            Nameˉvalid = Hˉspanˉequalsˉtext(
                Input, Cursor + 4u32, Fieldˉlength, "Maximumˉcompleted"
            );
        }
        if Field == 3u32 {
            Nameˉvalid = Hˉspanˉequalsˉtext(
                Input, Cursor + 4u32, Fieldˉlength,
                "Maximumˉretainedˉbytes"
            );
        }
        if Field == 4u32 {
            Nameˉvalid = Hˉspanˉequalsˉtext(
                Input, Cursor + 4u32, Fieldˉlength, "Maximumˉworkˉunits"
            );
        }
        if Field == 5u32 {
            Nameˉvalid = Hˉspanˉequalsˉtext(
                Input, Cursor + 4u32, Fieldˉlength, "Maximumˉcallˉdepth"
            );
        }
        if Field == 6u32 {
            Nameˉvalid = Hˉspanˉequalsˉtext(
                Input, Cursor + 4u32, Fieldˉlength, "Maximumˉtimers"
            );
        }
        if Field == 7u32 {
            Nameˉvalid = Hˉspanˉequalsˉtext(
                Input, Cursor + 4u32, Fieldˉlength,
                "Maximumˉdiagnostics"
            );
        }
        if !Nameˉvalid { return false; }
        Cursor = Cursor + 4u32 + Fieldˉlength;
        let Kind: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(Input, Cursor));
        if ((Field <= 2u32 || Field >= 5u32) && Kind != 5u32) ||
            ((Field == 3u32 || Field == 4u32) && Kind != 10u32) {
            return false;
        }
        Cursor = Cursor + 1u32;
        Field = Field + 1u32;
    }
    return Typeˉindex + 1u32 == Typeˉcount || Cursor ==
        Hˉtypeˉat(Input, Types, Typeˉindex + 1u32);
}

fn Hˉoperationˉcontextˉisˉexact(
    Input: bytes,
    Types: u32,
    Typeˉcount: u32,
    Typeˉindex: u32
) -> bool {
    return Hˉrecordˉhasˉoneˉu64ˉtoken(
        Input, Types, Typeˉcount, Typeˉindex,
        "Contextˉtokenˉidentity"
    );
}

fn Hˉtaskˉoutcomeˉisˉexact(
    Input: bytes,
    Types: u32,
    Typeˉcount: u32,
    Typeˉindex: u32
) -> bool {
    if Hˉvariantˉcaseˉcount(
            Input, Types, Typeˉcount, Typeˉindex
        ) != 7u32 {
        return false;
    }
    var Case: u32 = 0u32;
    while Case < 7u32 {
        let Descriptor: bytes = Hˉvariantˉcaseˉat(
            Input, Types, Typeˉindex, Case
        );
        var Fields: u32 = 1u32;
        if Case == 2u32 || Case == 3u32 { Fields = 0u32; }
        if Case == 4u32 || Case == 5u32 { Fields = 2u32; }
        if Bytesˉlength(Descriptor) != 4u32 + Fields * 5u32 ||
            Bytesˉreadˉu32ˉlittle(Descriptor, 0u32) != Fields {
            return false;
        }
        if Case == 4u32 || Case == 5u32 {
            if U32ˉfromˉu8(Bytesˉreadˉu8(Descriptor, 4u32)) != 10u32 ||
                U32ˉfromˉu8(Bytesˉreadˉu8(Descriptor, 9u32)) != 10u32 {
                return false;
            }
        }
        if Case == 6u32 && U32ˉfromˉu8(
                Bytesˉreadˉu8(Descriptor, 4u32)
            ) != 5u32 {
            return false;
        }
        Case = Case + 1u32;
    }
    return true;
}

fn Hˉcancelˉoutcomeˉisˉexact(
    Input: bytes,
    Types: u32,
    Typeˉcount: u32,
    Typeˉindex: u32
) -> bool {
    if Hˉvariantˉcaseˉcount(
            Input, Types, Typeˉcount, Typeˉindex
        ) != 2u32 {
        return false;
    }
    var Case: u32 = 0u32;
    while Case < 2u32 {
        let Descriptor: bytes = Hˉvariantˉcaseˉat(
            Input, Types, Typeˉindex, Case
        );
        if Bytesˉlength(Descriptor) != 9u32 ||
            Bytesˉreadˉu32ˉlittle(Descriptor, 0u32) != 1u32 ||
            U32ˉfromˉu8(Bytesˉreadˉu8(Descriptor, 4u32)) != 5u32 {
            return false;
        }
        Case = Case + 1u32;
    }
    return true;
}

fn Hˉtaskˉoutcomeˉmatchesˉresult(
    Input: bytes,
    Types: u32,
    Typeˉcount: u32,
    Outcomeˉtype: u32,
    Resultˉtype: u32
) -> bool {
    if !Hˉtaskˉoutcomeˉisˉexact(
            Input, Types, Typeˉcount, Outcomeˉtype
        ) || Hˉvariantˉcaseˉcount(
            Input, Types, Typeˉcount, Resultˉtype
        ) != 2u32 {
        return false;
    }
    var Case: u32 = 0u32;
    while Case < 2u32 {
        let Outcome: bytes = Hˉvariantˉcaseˉat(
            Input, Types, Outcomeˉtype, Case
        );
        let Result: bytes = Hˉvariantˉcaseˉat(
            Input, Types, Resultˉtype, Case
        );
        if Bytesˉlength(Outcome) != 9u32 || Bytesˉlength(Result) != 9u32 ||
            Bytesˉreadˉu32ˉlittle(Outcome, 0u32) != 1u32 ||
            Bytesˉreadˉu32ˉlittle(Result, 0u32) != 1u32 ||
            Bytesˉreadˉu8(Outcome, 4u32) != Bytesˉreadˉu8(Result, 4u32) ||
            Bytesˉreadˉu32ˉlittle(Outcome, 5u32) !=
                Bytesˉreadˉu32ˉlittle(Result, 5u32) {
            return false;
        }
        Case = Case + 1u32;
    }
    return true;
}

fn Hˉtaskˉsignature(
    Input: bytes,
    Functionˉcode: u32,
    Cursor: u32,
    Types: u32,
    Localˉshapes: bytes,
    Localˉslots: u32,
    Stack: bytes,
    Depth: u32,
    Opcode: u32,
    Signatures: bytes
) -> Hˉtaskˉsignatureˉstate {
    var Updatedˉsignatures: bytes = Signatures;
    if Opcode == 216u32 {
        if Depth == 0u32 {
            return Hˉtaskˉsignatureˉstate(false, Signatures);
        }
        let Callableˉoffset: u32 = Bytesˉlength(Stack) - 5u32;
        if U32ˉfromˉu8(Bytesˉreadˉu8(Stack, Callableˉoffset)) != 35u32 {
            return Hˉtaskˉsignatureˉstate(false, Signatures);
        }
        let Callableˉtype: u32 = Bytesˉreadˉu32ˉlittle(
            Stack, Callableˉoffset + 1u32
        );
        let Typeˉcount: u32 = Bytesˉreadˉu32ˉlittle(Input, Types);
        if Callableˉtype >= Typeˉcount {
            return Hˉtaskˉsignatureˉstate(false, Signatures);
        }
        let Descriptor: u32 = Hˉtypeˉat(Input, Types, Callableˉtype);
        let Returnˉshape: u32 = Descriptor + 2u32;
        if U32ˉfromˉu8(Bytesˉreadˉu8(Input, Returnˉshape)) != 11u32 {
            return Hˉtaskˉsignatureˉstate(false, Signatures);
        }
        let Resultˉtype: u32 = Bytesˉreadˉu32ˉlittle(
            Input, Returnˉshape + 1u32
        );
        let Taskˉtype: u32 = Bytesˉreadˉu32ˉlittle(
            Input, Functionˉcode + Cursor + 9u32
        );
        var Signature: u32 = 0u32;
        var Found: bool = false;
        while Signature < Bytesˉlength(Updatedˉsignatures) {
            if Bytesˉreadˉu32ˉlittle(
                    Updatedˉsignatures, Signature
                ) == Taskˉtype {
                if Bytesˉreadˉu32ˉlittle(
                        Updatedˉsignatures, Signature + 4u32
                    ) !=
                    Resultˉtype {
                    return Hˉtaskˉsignatureˉstate(
                        false, Updatedˉsignatures
                    );
                }
                Found = true;
            }
            Signature = Signature + 8u32;
        }
        if !Found {
            Updatedˉsignatures = Bytesˉconcat(
                Updatedˉsignatures,
                Bytesˉconcat(
                    Bytesˉfromˉu32ˉlittle(Taskˉtype),
                    Bytesˉfromˉu32ˉlittle(Resultˉtype)
                )
            );
        }
    }
    if Opcode == 217u32 {
        let Handle: u32 = Bytesˉreadˉu32ˉlittle(
            Input, Functionˉcode + Cursor + 1u32
        );
        if Handle >= Localˉslots {
            return Hˉtaskˉsignatureˉstate(false, Signatures);
        }
        let Awaitˉtaskˉtype: u32 = Bytesˉreadˉu32ˉlittle(
            Localˉshapes, Handle * 5u32 + 1u32
        );
        let Outcomeˉtype: u32 = Bytesˉreadˉu32ˉlittle(
            Input, Functionˉcode + Cursor + 9u32
        );
        var Awaitˉsignature: u32 = 0u32;
        var Awaitˉfound: bool = false;
        while Awaitˉsignature < Bytesˉlength(Updatedˉsignatures) {
            if Bytesˉreadˉu32ˉlittle(
                    Updatedˉsignatures, Awaitˉsignature
                ) == Awaitˉtaskˉtype &&
                Hˉtaskˉoutcomeˉmatchesˉresult(
                    Input, Types, Bytesˉreadˉu32ˉlittle(Input, Types),
                    Outcomeˉtype,
                    Bytesˉreadˉu32ˉlittle(
                        Updatedˉsignatures, Awaitˉsignature + 4u32
                    )
                ) {
                Awaitˉfound = true;
            }
            Awaitˉsignature = Awaitˉsignature + 8u32;
        }
        if !Awaitˉfound {
            return Hˉtaskˉsignatureˉstate(false, Updatedˉsignatures);
        }
    }
    return Hˉtaskˉsignatureˉstate(true, Updatedˉsignatures);
}

export fn Hˉoperationˉfailure(Stack: bytes, Depth: u32) -> Hˉoperationˉstate {
    return Hˉoperationˉstate(false, Stack, Depth, false, 0u32, 0u32);
}

export fn Hˉvariant(
    Input: bytes,
    Minor: u32,
    Functionˉcode: u32,
    Cursor: u32,
    Types: u32,
    Stack: bytes,
    Depth: u32
) -> Hˉoperationˉstate {
    let Opcode: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(Input, Functionˉcode + Cursor));
    if Opcode < 151u32 || Opcode > 153u32 {
        return Hˉoperationˉfailure(Stack, Depth);
    }
    let Variantˉtype: u32 = Bytesˉreadˉu32ˉlittle(
        Input,
        Functionˉcode + Cursor + 1u32
    );
    let Variantˉcaseˉindex: u32 = Bytesˉreadˉu32ˉlittle(
        Input,
        Functionˉcode + Cursor + 5u32
    );
    let Variantˉcase: bytes = Hˉvariantˉcaseˉat(
        Input,
        Types,
        Variantˉtype,
        Variantˉcaseˉindex
    );
    if Bytesˉlength(Variantˉcase) < 4u32 {
        return Hˉoperationˉfailure(Stack, Depth);
    }
    let Fields: u32 = Bytesˉreadˉu32ˉlittle(Variantˉcase, 0u32);
    if Bytesˉlength(Variantˉcase) != 4u32 + Fields * 5u32 {
        return Hˉoperationˉfailure(Stack, Depth);
    }
    var Resultˉstack: bytes = Stack;
    var Resultˉdepth: u32 = Depth;
    if Opcode == 151u32 {
        var Remainingˉfields: u32 = Fields;
        while Remainingˉfields > 0u32 {
            if Resultˉdepth == 0u32 {
                return Hˉoperationˉfailure(Resultˉstack, Resultˉdepth);
            }
            let Fieldˉshape: u32 = 4u32 + (Remainingˉfields - 1u32) * 5u32;
            var Fieldˉkind: u32 = U32ˉfromˉu8(
                Bytesˉreadˉu8(Variantˉcase, Fieldˉshape)
            );
            let Fieldˉnominal: u32 = Bytesˉreadˉu32ˉlittle(
                Variantˉcase, Fieldˉshape + 1u32
            );
            if Fieldˉkind == 23u32 && Minor >= 20u32 {
                Fieldˉkind = 26u32;
            } else if Hˉownedˉaggregate(
                Input, Types, Bytesˉreadˉu32ˉlittle(Input, Types),
                Fieldˉkind, Fieldˉnominal, Minor
            ) {
                Fieldˉkind = Hˉownedˉtransferˉkind(Fieldˉkind);
            }
            let Payloadˉoffset: u32 = Bytesˉlength(Resultˉstack) - 5u32;
            if U32ˉfromˉu8(Bytesˉreadˉu8(Resultˉstack, Payloadˉoffset)) !=
                Fieldˉkind {
                return Hˉoperationˉfailure(Resultˉstack, Resultˉdepth);
            }
            if Bytesˉreadˉu32ˉlittle(Resultˉstack, Payloadˉoffset + 1u32) !=
                Fieldˉnominal {
                return Hˉoperationˉfailure(Resultˉstack, Resultˉdepth);
            }
            Resultˉstack = Bytesˉslice(Resultˉstack, 0u32, Payloadˉoffset);
            Resultˉdepth = Resultˉdepth - 1u32;
            Remainingˉfields = Remainingˉfields - 1u32;
        }
        var Createdˉkind: u32 = Hˉaffineˉresultˉtransferˉkind(
            Input, Types, Minor, 11u32, Variantˉtype
        );
        if Createdˉkind == 37u32 {
            return Hˉoperationˉfailure(Resultˉstack, Resultˉdepth);
        }
        if Createdˉkind == 11u32 && Hˉownedˉaggregate(
            Input, Types, Bytesˉreadˉu32ˉlittle(Input, Types),
            11u32, Variantˉtype, Minor
        ) {
            Createdˉkind = Hˉownedˉtransferˉkind(11u32);
        }
        return Hˉoperationˉstate(
            true,
            Resultˉstack,
            Resultˉdepth,
            true,
            Createdˉkind,
            Variantˉtype
        );
    }
    if Resultˉdepth == 0u32 {
        return Hˉoperationˉfailure(Resultˉstack, Resultˉdepth);
    }
    let Variantˉoffset: u32 = Bytesˉlength(Resultˉstack) - 5u32;
    let Variantˉkind: u32 = U32ˉfromˉu8(
        Bytesˉreadˉu8(Resultˉstack, Variantˉoffset)
    );
    let Borrowed: bool = Bytesˉreadˉu16ˉlittle(Input, 6u32) == 39u32 &&
        (Variantˉkind == 75u32 || Variantˉkind == 139u32);
    if Variantˉkind != 11u32 && Variantˉkind != 28u32 &&
        Variantˉkind != 29u32 && Variantˉkind != 32u32 &&
        Variantˉkind != 36u32 && Variantˉkind != 37u32 && !Borrowed {
        return Hˉoperationˉfailure(Resultˉstack, Resultˉdepth);
    }
    if Bytesˉreadˉu32ˉlittle(Resultˉstack, Variantˉoffset + 1u32) != Variantˉtype {
        return Hˉoperationˉfailure(Resultˉstack, Resultˉdepth);
    }
    Resultˉstack = Bytesˉslice(Resultˉstack, 0u32, Variantˉoffset);
    Resultˉdepth = Resultˉdepth - 1u32;
    if Opcode == 152u32 {
        return Hˉoperationˉstate(
            true,
            Resultˉstack,
            Resultˉdepth,
            true,
            2u32,
            0u32
        );
    }
    if Fields != 1u32 {
        return Hˉoperationˉfailure(Resultˉstack, Resultˉdepth);
    }
    var Payloadˉkind: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(Variantˉcase, 4u32));
    if Borrowed {
        if !Hˉborrowˉpayloadˉkind(Payloadˉkind) {
            return Hˉoperationˉfailure(Resultˉstack, Resultˉdepth);
        }
        return Hˉoperationˉstate(true, Resultˉstack, Resultˉdepth, true,
            Payloadˉkind + 64u32, Bytesˉreadˉu32ˉlittle(Variantˉcase, 5u32));
    }
    if Variantˉkind == 28u32 && Payloadˉkind == 25u32 {
        Payloadˉkind = 27u32;
    }
    if Variantˉkind == 29u32 && Payloadˉkind == 23u32 {
        Payloadˉkind = 26u32;
    }
    if (Variantˉkind == 32u32 || Variantˉkind == 36u32 ||
        Variantˉkind == 37u32) &&
        Hˉownedˉaggregate(
            Input, Types, Bytesˉreadˉu32ˉlittle(Input, Types),
            Payloadˉkind,
            Bytesˉreadˉu32ˉlittle(Variantˉcase, 5u32), Minor
        ) {
        Payloadˉkind = Hˉownedˉtransferˉkind(Payloadˉkind);
    }
    if Variantˉkind == 11u32 && Payloadˉkind == 23u32 &&
        Hˉownedˉaggregate(
            Input, Types, Bytesˉreadˉu32ˉlittle(Input, Types),
            11u32, Variantˉtype, Minor
        ) {
        Payloadˉkind = 26u32;
    }
    let Payloadˉnominal: u32 = Bytesˉreadˉu32ˉlittle(Variantˉcase, 5u32);
    return Hˉoperationˉstate(
        true,
        Resultˉstack,
        Resultˉdepth,
        true,
        Payloadˉkind,
        Payloadˉnominal
    );
}

fn Hˉvariantˉfield(
    Input: bytes,
    Minor: u32,
    Functionˉcode: u32,
    Cursor: u32,
    Types: u32,
    Stack: bytes,
    Depth: u32
) -> Hˉoperationˉstate {
    let Variantˉtype: u32 = Bytesˉreadˉu32ˉlittle(
        Input, Functionˉcode + Cursor + 1u32
    );
    let Selection: u32 = Bytesˉreadˉu32ˉlittle(
        Input, Functionˉcode + Cursor + 5u32
    );
    let Caseˉindex: u32 = Selection / 64u32;
    let Fieldˉindex: u32 = Selection % 64u32;
    let Variantˉcase: bytes = Hˉvariantˉcaseˉat(
        Input, Types, Variantˉtype, Caseˉindex
    );
    if Bytesˉlength(Variantˉcase) < 4u32 { return Hˉoperationˉfailure(Stack, Depth); }
    let Fields: u32 = Bytesˉreadˉu32ˉlittle(Variantˉcase, 0u32);
    if Fieldˉindex >= Fields || Depth == 0u32 {
        return Hˉoperationˉfailure(Stack, Depth);
    }
    let Variantˉoffset: u32 = Bytesˉlength(Stack) - 5u32;
    let Variantˉkind: u32 = U32ˉfromˉu8(
        Bytesˉreadˉu8(Stack, Variantˉoffset)
    );
    let Borrowed: bool = Bytesˉreadˉu16ˉlittle(Input, 6u32) == 39u32 &&
        (Variantˉkind == 75u32 || Variantˉkind == 139u32);
    if (Variantˉkind != 11u32 && Variantˉkind != 28u32 &&
        Variantˉkind != 29u32 && Variantˉkind != 32u32 &&
        Variantˉkind != 36u32 && Variantˉkind != 37u32 && !Borrowed) ||
        Bytesˉreadˉu32ˉlittle(Stack, Variantˉoffset + 1u32) != Variantˉtype {
        return Hˉoperationˉfailure(Stack, Depth);
    }
    let Fieldˉshape: u32 = 4u32 + Fieldˉindex * 5u32;
    var Producedˉkind: u32 = U32ˉfromˉu8(
        Bytesˉreadˉu8(Variantˉcase, Fieldˉshape)
    );
    let Producedˉnominal: u32 = Bytesˉreadˉu32ˉlittle(
        Variantˉcase, Fieldˉshape + 1u32
    );
    if Borrowed {
        if !Hˉborrowˉpayloadˉkind(Producedˉkind) { return Hˉoperationˉfailure(Stack, Depth); }
        return Hˉoperationˉstate(true, Bytesˉslice(Stack, 0u32, Variantˉoffset),
            Depth - 1u32, true, Producedˉkind + 64u32, Producedˉnominal);
    }
    if Variantˉkind == 28u32 && Producedˉkind == 25u32 {
        Producedˉkind = 27u32;
    }
    if Variantˉkind == 29u32 && Producedˉkind == 23u32 {
        Producedˉkind = 26u32;
    }
    if Variantˉkind == 11u32 && Producedˉkind == 23u32 &&
        Hˉownedˉaggregate(
            Input, Types, Bytesˉreadˉu32ˉlittle(Input, Types),
            11u32, Variantˉtype, Minor
    ) {
        Producedˉkind = 26u32;
    }
    if (Variantˉkind == 32u32 || Variantˉkind == 36u32 ||
        Variantˉkind == 37u32) &&
        Hˉownedˉaggregate(
        Input, Types, Bytesˉreadˉu32ˉlittle(Input, Types),
        Producedˉkind, Producedˉnominal, Minor
    ) {
        Producedˉkind = Hˉownedˉtransferˉkind(Producedˉkind);
    }
    return Hˉoperationˉstate(
        true,
        Bytesˉslice(Stack, 0u32, Variantˉoffset),
        Depth - 1u32,
        true,
        Producedˉkind,
        Producedˉnominal
    );
}

export fn Hˉrecord(
    Input: bytes,
    Functionˉcode: u32,
    Cursor: u32,
    Types: u32,
    Stack: bytes,
    Depth: u32
) -> Hˉoperationˉstate {
    let Opcode: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(Input, Functionˉcode + Cursor));
    let Minor: u32 = Hˉeffectiveˉminor(Input);
    if Opcode == 104u32 {
        let Typeˉindex: u32 = Bytesˉreadˉu32ˉlittle(
            Input,
            Functionˉcode + Cursor + 1u32
        );
        if (Minor == 32u32 || Minor == 33u32 || Minor == 34u32 ||
                Minor == 35u32 || Minor == 36u32 || Minor == 37u32) &&
            (Hˉtaskˉscopeˉisˉexact(
                Input, Types, Bytesˉreadˉu32ˉlittle(Input, Types), Typeˉindex
            ) || Hˉtaskˉhandleˉisˉexact(
                Input, Types, Bytesˉreadˉu32ˉlittle(Input, Types), Typeˉindex
            ) || Hˉoperationˉcontextˉisˉexact(
                Input, Types, Bytesˉreadˉu32ˉlittle(Input, Types), Typeˉindex
            ) || ((Minor == 33u32 || Minor == 34u32 || Minor == 35u32 ||
                    Minor == 36u32 || Minor == 37u32) &&
                Hˉunsafeˉscratchˉisˉexact(
                    Input, Types, Bytesˉreadˉu32ˉlittle(Input, Types),
                    Typeˉindex
                ))) {
            return Hˉoperationˉfailure(Stack, Depth);
        }
        var Typeˉcursor: u32 = Types + 4u32;
        var Currentˉtype: u32 = 0u32;
        while Currentˉtype < Typeˉindex {
            Typeˉcursor = Hˉnextˉtype(Input, Typeˉcursor);
            Currentˉtype = Currentˉtype + 1u32;
        }
        if U32ˉfromˉu8(Bytesˉreadˉu8(Input, Typeˉcursor)) != 1u32 {
            return Hˉoperationˉfailure(Stack, Depth);
        }
        Typeˉcursor = Typeˉcursor + 1u32;
        let Typeˉnameˉlength: u32 = Bytesˉreadˉu32ˉlittle(Input, Typeˉcursor);
        Typeˉcursor = Typeˉcursor + 4u32 + Typeˉnameˉlength;
        let Fieldˉcount: u32 = Bytesˉreadˉu32ˉlittle(Input, Typeˉcursor);
        Typeˉcursor = Typeˉcursor + 4u32;
        if Fieldˉcount > Depth { return Hˉoperationˉfailure(Stack, Depth); }
        var Resultˉstack: bytes = Stack;
        var Resultˉdepth: u32 = Depth;
        var Fieldˉpop: u32 = 0u32;
        while Fieldˉpop < Fieldˉcount {
            let Wantedˉfield: u32 = Fieldˉcount - Fieldˉpop - 1u32;
            var Fieldˉcursor: u32 = Typeˉcursor;
            var Fieldˉindex: u32 = 0u32;
            while Fieldˉindex < Wantedˉfield {
                let Skippedˉfieldˉnameˉlength: u32 = Bytesˉreadˉu32ˉlittle(
                    Input,
                    Fieldˉcursor
                );
                Fieldˉcursor = Fieldˉcursor + 4u32 + Skippedˉfieldˉnameˉlength;
                Fieldˉcursor = Fieldˉcursor + Hˉshapeˉwidth(Input, Fieldˉcursor);
                Fieldˉindex = Fieldˉindex + 1u32;
            }
            let Fieldˉnameˉlength: u32 = Bytesˉreadˉu32ˉlittle(Input, Fieldˉcursor);
            Fieldˉcursor = Fieldˉcursor + 4u32 + Fieldˉnameˉlength;
            var Expectedˉkind: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(Input, Fieldˉcursor));
            var Expectedˉnominal: u32 = 0u32;
            if Expectedˉkind == 7u32 || Expectedˉkind == 8u32 ||
                Expectedˉkind == 11u32 || Expectedˉkind == 22u32 ||
                Expectedˉkind == 23u32 || Expectedˉkind == 24u32 {
                Expectedˉnominal = Bytesˉreadˉu32ˉlittle(Input, Fieldˉcursor + 1u32);
            }
            if Expectedˉkind == 23u32 && Minor >= 20u32 {
                Expectedˉkind = 26u32;
            } else if Hˉownedˉaggregate(
                Input, Types, Bytesˉreadˉu32ˉlittle(Input, Types),
                Expectedˉkind, Expectedˉnominal,
                Minor
            ) {
                Expectedˉkind = Hˉownedˉtransferˉkind(Expectedˉkind);
            }
            let Actualˉoffset: u32 = Bytesˉlength(Resultˉstack) - 5u32;
            if !Hˉexactˉvalueˉmatches(Input, Types, Expectedˉkind, Expectedˉnominal,
                U32ˉfromˉu8(Bytesˉreadˉu8(Resultˉstack, Actualˉoffset)),
                Bytesˉreadˉu32ˉlittle(Resultˉstack, Actualˉoffset + 1u32)) {
                return Hˉoperationˉfailure(Resultˉstack, Resultˉdepth);
            }
            Resultˉstack = Bytesˉslice(Resultˉstack, 0u32, Actualˉoffset);
            Resultˉdepth = Resultˉdepth - 1u32;
            Fieldˉpop = Fieldˉpop + 1u32;
        }
        if Hˉownedˉaggregate(
            Input, Types, Bytesˉreadˉu32ˉlittle(Input, Types),
            7u32, Typeˉindex, Minor
        ) {
            return Hˉoperationˉstate(
                true, Resultˉstack, Resultˉdepth, true,
                Hˉownedˉtransferˉkind(7u32), Typeˉindex
            );
        }
        return Hˉoperationˉstate(
            true,
            Resultˉstack,
            Resultˉdepth,
            true,
            7u32,
            Typeˉindex
        );
    }
    if Opcode != 105u32 || Depth == 0u32 {
        return Hˉoperationˉfailure(Stack, Depth);
    }
    let Sourceˉoffset: u32 = Bytesˉlength(Stack) - 5u32;
    let Sourceˉkind: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(Stack, Sourceˉoffset));
    let Borrowed: bool = Bytesˉreadˉu16ˉlittle(Input, 6u32) == 39u32 && Sourceˉkind == 71u32;
    if Sourceˉkind != 7u32 && !Borrowed {
        return Hˉoperationˉfailure(Stack, Depth);
    }
    let Sourceˉtypeˉindex: u32 = Bytesˉreadˉu32ˉlittle(Stack, Sourceˉoffset + 1u32);
    if (Minor == 32u32 || Minor == 33u32 || Minor == 34u32 ||
            Minor == 35u32 || Minor == 36u32 || Minor == 37u32) &&
        (Hˉtaskˉscopeˉisˉexact(
            Input, Types, Bytesˉreadˉu32ˉlittle(Input, Types),
            Sourceˉtypeˉindex
        ) || Hˉtaskˉhandleˉisˉexact(
            Input, Types, Bytesˉreadˉu32ˉlittle(Input, Types),
            Sourceˉtypeˉindex
        ) || Hˉoperationˉcontextˉisˉexact(
            Input, Types, Bytesˉreadˉu32ˉlittle(Input, Types),
            Sourceˉtypeˉindex
        ) || ((Minor == 33u32 || Minor == 34u32 || Minor == 35u32 ||
                Minor == 36u32 || Minor == 37u32) &&
            Hˉunsafeˉscratchˉisˉexact(
                Input, Types, Bytesˉreadˉu32ˉlittle(Input, Types),
                Sourceˉtypeˉindex
            ))) {
        return Hˉoperationˉfailure(Stack, Depth);
    }
    let Sourceˉstack: bytes = Bytesˉslice(Stack, 0u32, Sourceˉoffset);
    let Sourceˉdepth: u32 = Depth - 1u32;
    var Sourceˉtype: u32 = Types + 4u32;
    var Sourceˉcurrentˉtype: u32 = 0u32;
    while Sourceˉcurrentˉtype < Sourceˉtypeˉindex {
        Sourceˉtype = Hˉnextˉtype(Input, Sourceˉtype);
        Sourceˉcurrentˉtype = Sourceˉcurrentˉtype + 1u32;
    }
    if U32ˉfromˉu8(Bytesˉreadˉu8(Input, Sourceˉtype)) != 1u32 {
        return Hˉoperationˉfailure(Sourceˉstack, Sourceˉdepth);
    }
    Sourceˉtype = Sourceˉtype + 1u32;
    let Sourceˉtypeˉnameˉlength: u32 = Bytesˉreadˉu32ˉlittle(Input, Sourceˉtype);
    Sourceˉtype = Sourceˉtype + 4u32 + Sourceˉtypeˉnameˉlength;
    let Sourceˉfieldˉcount: u32 = Bytesˉreadˉu32ˉlittle(Input, Sourceˉtype);
    Sourceˉtype = Sourceˉtype + 4u32;
    let Fieldˉoperand: u32 = Bytesˉreadˉu32ˉlittle(
        Input,
        Functionˉcode + Cursor + 1u32
    );
    if Fieldˉoperand >= Sourceˉfieldˉcount {
        return Hˉoperationˉfailure(Sourceˉstack, Sourceˉdepth);
    }
    var Sourceˉfieldˉindex: u32 = 0u32;
    while Sourceˉfieldˉindex < Fieldˉoperand {
        let Sourceˉfieldˉnameˉlength: u32 = Bytesˉreadˉu32ˉlittle(Input, Sourceˉtype);
        Sourceˉtype = Sourceˉtype + 4u32 + Sourceˉfieldˉnameˉlength;
        Sourceˉtype = Sourceˉtype + Hˉshapeˉwidth(Input, Sourceˉtype);
        Sourceˉfieldˉindex = Sourceˉfieldˉindex + 1u32;
    }
    let Selectedˉfieldˉnameˉlength: u32 = Bytesˉreadˉu32ˉlittle(Input, Sourceˉtype);
    Sourceˉtype = Sourceˉtype + 4u32 + Selectedˉfieldˉnameˉlength;
    var Pushˉkind: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(Input, Sourceˉtype));
    var Pushˉnominal: u32 = 0u32;
    if Pushˉkind == 7u32 || Pushˉkind == 8u32 || Pushˉkind == 11u32 ||
        Pushˉkind == 22u32 || Pushˉkind == 23u32 || Pushˉkind == 24u32 || Pushˉkind == 35u32 {
        Pushˉnominal = Bytesˉreadˉu32ˉlittle(Input, Sourceˉtype + 1u32);
    }
    if Borrowed {
        if !Hˉborrowˉpayloadˉkind(Pushˉkind) { return Hˉoperationˉfailure(Stack, Depth); }
        return Hˉoperationˉstate(true, Sourceˉstack, Sourceˉdepth, true,
            Pushˉkind + 64u32, Pushˉnominal);
    }
    if Minor >= 28u32 && Minor <= 37u32 &&
        Pushˉkind == 23u32 &&
        Hˉownedˉaggregate(
            Input, Types, Bytesˉreadˉu32ˉlittle(Input, Types),
            7u32, Sourceˉtypeˉindex,
            Minor
        ) {
        Pushˉkind = 26u32;
    }
    return Hˉoperationˉstate(
        true,
        Sourceˉstack,
        Sourceˉdepth,
        true,
        Pushˉkind,
        Pushˉnominal
    );
}

fn Hˉarrayˉdescriptor(Input: bytes, Types: u32, Typeˉindex: u32) -> bytes {
    let Invalid: bytes = Bytesˉslice(Input, 0u32, 0u32);
    var Typeˉcursor: u32 = Types + 4u32;
    var Currentˉtype: u32 = 0u32;
    while Currentˉtype < Typeˉindex {
        Typeˉcursor = Hˉnextˉtype(Input, Typeˉcursor);
        Currentˉtype = Currentˉtype + 1u32;
    }
    if U32ˉfromˉu8(Bytesˉreadˉu8(Input, Typeˉcursor)) != 4u32 {
        return Invalid;
    }
    Typeˉcursor = Typeˉcursor + 1u32;
    let Nameˉlength: u32 = Bytesˉreadˉu32ˉlittle(Input, Typeˉcursor);
    Typeˉcursor = Typeˉcursor + 4u32 + Nameˉlength;
    let Elementˉkind: u8 = Bytesˉreadˉu8(Input, Typeˉcursor);
    var Elementˉnominal: u32 = 0u32;
    if Hˉshapeˉwidth(Input, Typeˉcursor) == 5u32 {
        Elementˉnominal = Bytesˉreadˉu32ˉlittle(Input, Typeˉcursor + 1u32);
    }
    let Countˉcursor: u32 = Typeˉcursor + Hˉshapeˉwidth(Input, Typeˉcursor);
    var Result: bytes = Bytesˉfromˉu8(Elementˉkind);
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Elementˉnominal));
    return Bytesˉconcat(
        Result,
        Bytesˉfromˉu32ˉlittle(Bytesˉreadˉu32ˉlittle(Input, Countˉcursor))
    );
}

fn Hˉcollectionˉdescriptor(
    Input: bytes,
    Types: u32,
    Typeˉindex: u32,
    Expectedˉkind: u32
) -> bytes {
    let Invalid: bytes = Bytesˉslice(Input, 0u32, 0u32);
    var Typeˉcursor: u32 = Types + 4u32;
    var Currentˉtype: u32 = 0u32;
    while Currentˉtype < Typeˉindex {
        Typeˉcursor = Hˉnextˉtype(Input, Typeˉcursor);
        Currentˉtype = Currentˉtype + 1u32;
    }
    if U32ˉfromˉu8(Bytesˉreadˉu8(Input, Typeˉcursor)) != Expectedˉkind {
        return Invalid;
    }
    Typeˉcursor = Typeˉcursor + 1u32;
    let Nameˉlength: u32 = Bytesˉreadˉu32ˉlittle(Input, Typeˉcursor);
    Typeˉcursor = Typeˉcursor + 4u32 + Nameˉlength;
    let Elementˉkind: u32 = U32ˉfromˉu8(
        Bytesˉreadˉu8(Input, Typeˉcursor)
    );
    var Elementˉnominal: u32 = 0u32;
    if Hˉshapeˉwidth(Input, Typeˉcursor) == 5u32 {
        Elementˉnominal = Bytesˉreadˉu32ˉlittle(Input, Typeˉcursor + 1u32);
    }
    return Bytesˉconcat(
        Bytesˉfromˉu8(Bytesˉreadˉu8(Input, Typeˉcursor)),
        Bytesˉfromˉu32ˉlittle(Elementˉnominal)
    );
}

fn Hˉcollectionˉscalarˉelement(Element: bytes) -> bool {
    if Bytesˉlength(Element) != 5u32 { return false; }
    let Kind: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(Element, 0u32));
    if Kind == 1u32 || Kind == 2u32 || Kind == 4u32 || Kind == 5u32 ||
        Kind == 8u32 || Kind == 9u32 || Kind == 10u32 ||
        (Kind >= 14u32 && Kind <= 20u32) {
        return true;
    }
    return false;
}

fn Hˉcollection(
    Input: bytes,
    Functionˉcode: u32,
    Cursor: u32,
    Types: u32,
    Stack: bytes,
    Depth: u32
) -> Hˉoperationˉstate {
    let Opcode: u32 = U32ˉfromˉu8(
        Bytesˉreadˉu8(Input, Functionˉcode + Cursor)
    );
    let Firstˉtype: u32 = Bytesˉreadˉu32ˉlittle(
        Input, Functionˉcode + Cursor + 1u32
    );
    var Expectedˉkind: u32 = 5u32;
    if Opcode >= 203u32 { Expectedˉkind = 6u32; }
    let Element: bytes = Hˉcollectionˉdescriptor(
        Input, Types, Firstˉtype, Expectedˉkind
    );
    if !Hˉcollectionˉscalarˉelement(Element) {
        return Hˉoperationˉfailure(Stack, Depth);
    }

    if Opcode == 199u32 {
        if Depth < 1u32 { return Hˉoperationˉfailure(Stack, Depth); }
        let Maximumˉoffset: u32 = Bytesˉlength(Stack) - 5u32;
        if !Hˉexactˉvalueˉmatches(Input, Types, 10u32, 0u32,
            U32ˉfromˉu8(Bytesˉreadˉu8(Stack, Maximumˉoffset)),
            Bytesˉreadˉu32ˉlittle(Stack, Maximumˉoffset + 1u32)) {
            return Hˉoperationˉfailure(Stack, Depth);
        }
        return Hˉoperationˉstate(
            true,
            Bytesˉslice(Stack, 0u32, Maximumˉoffset),
            Depth - 1u32,
            true,
            26u32,
            Firstˉtype
        );
    }
    if Opcode == 200u32 {
        if Depth < 2u32 { return Hˉoperationˉfailure(Stack, Depth); }
        let Appendˉvalueˉoffset: u32 = Bytesˉlength(Stack) - 5u32;
        if !Hˉexactˉvalueˉmatches(Input, Types,
            U32ˉfromˉu8(Bytesˉreadˉu8(Element, 0u32)),
            Bytesˉreadˉu32ˉlittle(Element, 1u32),
            U32ˉfromˉu8(Bytesˉreadˉu8(Stack, Appendˉvalueˉoffset)),
            Bytesˉreadˉu32ˉlittle(Stack, Appendˉvalueˉoffset + 1u32)) {
            return Hˉoperationˉfailure(Stack, Depth);
        }
        let Appendˉvectorˉoffset: u32 = Appendˉvalueˉoffset - 5u32;
        if U32ˉfromˉu8(Bytesˉreadˉu8(Stack, Appendˉvectorˉoffset)) != 26u32 ||
            Bytesˉreadˉu32ˉlittle(Stack, Appendˉvectorˉoffset + 1u32) != Firstˉtype {
            return Hˉoperationˉfailure(Stack, Depth);
        }
        return Hˉoperationˉstate(
            true,
            Bytesˉslice(Stack, 0u32, Appendˉvectorˉoffset),
            Depth - 2u32,
            true,
            26u32,
            Firstˉtype
        );
    }
    if Opcode == 201u32 {
        if Depth < 1u32 { return Hˉoperationˉfailure(Stack, Depth); }
        let Sequenceˉtype: u32 = Bytesˉreadˉu32ˉlittle(
            Input, Functionˉcode + Cursor + 5u32
        );
        let Sequenceˉelement: bytes = Hˉcollectionˉdescriptor(
            Input, Types, Sequenceˉtype, 6u32
        );
        if Bytesˉlength(Sequenceˉelement) != Bytesˉlength(Element) ||
            Bytesˉreadˉu8(Sequenceˉelement, 0u32) !=
                Bytesˉreadˉu8(Element, 0u32) ||
            Bytesˉreadˉu32ˉlittle(Sequenceˉelement, 1u32) !=
                Bytesˉreadˉu32ˉlittle(Element, 1u32) {
            return Hˉoperationˉfailure(Stack, Depth);
        }
        let Freezeˉvectorˉoffset: u32 = Bytesˉlength(Stack) - 5u32;
        if U32ˉfromˉu8(Bytesˉreadˉu8(Stack, Freezeˉvectorˉoffset)) != 26u32 ||
            Bytesˉreadˉu32ˉlittle(Stack, Freezeˉvectorˉoffset + 1u32) != Firstˉtype {
            return Hˉoperationˉfailure(Stack, Depth);
        }
        return Hˉoperationˉstate(
            true,
            Bytesˉslice(Stack, 0u32, Freezeˉvectorˉoffset),
            Depth - 1u32,
            true,
            24u32,
            Sequenceˉtype
        );
    }
    if Opcode == 202u32 || Opcode == 203u32 {
        if Depth < 1u32 { return Hˉoperationˉfailure(Stack, Depth); }
        let Lengthˉvalueˉoffset: u32 = Bytesˉlength(Stack) - 5u32;
        var Valueˉkind: u32 = 26u32;
        if Opcode == 203u32 { Valueˉkind = 24u32; }
        if !Hˉexactˉvalueˉmatches(Input, Types, Valueˉkind, Firstˉtype,
            U32ˉfromˉu8(Bytesˉreadˉu8(Stack, Lengthˉvalueˉoffset)),
            Bytesˉreadˉu32ˉlittle(Stack, Lengthˉvalueˉoffset + 1u32)) {
            return Hˉoperationˉfailure(Stack, Depth);
        }
        return Hˉoperationˉstate(
            true,
            Stack,
            Depth,
            true,
            10u32,
            0u32
        );
    }
    if Opcode != 204u32 || Depth < 2u32 {
        return Hˉoperationˉfailure(Stack, Depth);
    }
    let Indexˉoffset: u32 = Bytesˉlength(Stack) - 5u32;
    if !Hˉexactˉvalueˉmatches(Input, Types, 10u32, 0u32,
        U32ˉfromˉu8(Bytesˉreadˉu8(Stack, Indexˉoffset)),
        Bytesˉreadˉu32ˉlittle(Stack, Indexˉoffset + 1u32)) {
        return Hˉoperationˉfailure(Stack, Depth);
    }
    let Sequenceˉoffset: u32 = Indexˉoffset - 5u32;
    if !Hˉexactˉvalueˉmatches(Input, Types, 24u32, Firstˉtype,
        U32ˉfromˉu8(Bytesˉreadˉu8(Stack, Sequenceˉoffset)),
        Bytesˉreadˉu32ˉlittle(Stack, Sequenceˉoffset + 1u32)) {
        return Hˉoperationˉfailure(Stack, Depth);
    }
    return Hˉoperationˉstate(
        true,
        Bytesˉslice(Stack, 0u32, Indexˉoffset),
        Depth - 1u32,
        true,
        U32ˉfromˉu8(Bytesˉreadˉu8(Element, 0u32)),
        Bytesˉreadˉu32ˉlittle(Element, 1u32)
    );
}

fn Hˉcollectionˉorˉarray(
    Input: bytes,
    Minor: u32,
    Functionˉcode: u32,
    Cursor: u32,
    Types: u32,
    Stack: bytes,
    Depth: u32
) -> Hˉoperationˉstate {
    let Opcode: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(Input, Functionˉcode + Cursor));
    if Opcode >= 199u32 && Opcode <= 204u32 {
        return Hˉcollection(Input, Functionˉcode, Cursor, Types, Stack, Depth);
    }
    if Opcode == 197u32 {
        let Createdˉtypeˉindex: u32 = Bytesˉreadˉu32ˉlittle(
            Input, Functionˉcode + Cursor + 1u32
        );
        let Createdˉdescriptor: bytes = Hˉarrayˉdescriptor(
            Input, Types, Createdˉtypeˉindex
        );
        if Bytesˉlength(Createdˉdescriptor) != 9u32 {
            return Hˉoperationˉfailure(Stack, Depth);
        }
        let Elementˉkind: u32 = U32ˉfromˉu8(
            Bytesˉreadˉu8(Createdˉdescriptor, 0u32)
        );
        let Elementˉnominal: u32 = Bytesˉreadˉu32ˉlittle(
            Createdˉdescriptor, 1u32
        );
        var Expectedˉelementˉkind: u32 = Elementˉkind;
        if Expectedˉelementˉkind == 23u32 && Minor >= 20u32 {
            Expectedˉelementˉkind = 26u32;
        } else if Hˉownedˉaggregate(
            Input, Types, Bytesˉreadˉu32ˉlittle(Input, Types),
            Expectedˉelementˉkind, Elementˉnominal, Minor
        ) {
            Expectedˉelementˉkind = Hˉownedˉtransferˉkind(
                Expectedˉelementˉkind
            );
        }
        let Count: u32 = Bytesˉreadˉu32ˉlittle(Createdˉdescriptor, 5u32);
        if Count > Depth { return Hˉoperationˉfailure(Stack, Depth); }
        var Resultˉstack: bytes = Stack;
        var Resultˉdepth: u32 = Depth;
        var Element: u32 = 0u32;
        while Element < Count {
            let Actualˉoffset: u32 = Bytesˉlength(Resultˉstack) - 5u32;
            if !Hˉexactˉvalueˉmatches(Input, Types, Expectedˉelementˉkind, Elementˉnominal,
                U32ˉfromˉu8(Bytesˉreadˉu8(Resultˉstack, Actualˉoffset)),
                Bytesˉreadˉu32ˉlittle(Resultˉstack, Actualˉoffset + 1u32)) {
                return Hˉoperationˉfailure(Resultˉstack, Resultˉdepth);
            }
            Resultˉstack = Bytesˉslice(Resultˉstack, 0u32, Actualˉoffset);
            Resultˉdepth = Resultˉdepth - 1u32;
            Element = Element + 1u32;
        }
        var Createdˉkind: u32 = 22u32;
        if Hˉownedˉaggregate(
            Input, Types, Bytesˉreadˉu32ˉlittle(Input, Types),
            22u32, Createdˉtypeˉindex, Minor
        ) {
            Createdˉkind = Hˉownedˉtransferˉkind(22u32);
        }
        return Hˉoperationˉstate(
            true, Resultˉstack, Resultˉdepth, true,
            Createdˉkind, Createdˉtypeˉindex
        );
    }
    if Opcode != 198u32 || Depth < 2u32 {
        return Hˉoperationˉfailure(Stack, Depth);
    }
    let Indexˉoffset: u32 = Bytesˉlength(Stack) - 5u32;
    if !Hˉexactˉvalueˉmatches(Input, Types, 10u32, 0u32,
        U32ˉfromˉu8(Bytesˉreadˉu8(Stack, Indexˉoffset)),
        Bytesˉreadˉu32ˉlittle(Stack, Indexˉoffset + 1u32)) {
        return Hˉoperationˉfailure(Stack, Depth);
    }
    let Arrayˉoffset: u32 = Indexˉoffset - 5u32;
    let Arrayˉkind: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(Stack, Arrayˉoffset));
    let Borrowed: bool = Bytesˉreadˉu16ˉlittle(Input, 6u32) == 39u32 && Arrayˉkind == 86u32;
    if Arrayˉkind != 22u32 && !Borrowed {
        return Hˉoperationˉfailure(Stack, Depth);
    }
    let Selectedˉtypeˉindex: u32 = Bytesˉreadˉu32ˉlittle(
        Stack, Arrayˉoffset + 1u32
    );
    let Selectedˉdescriptor: bytes = Hˉarrayˉdescriptor(
        Input, Types, Selectedˉtypeˉindex
    );
    if Bytesˉlength(Selectedˉdescriptor) != 9u32 {
        return Hˉoperationˉfailure(Stack, Depth);
    }
    var Selectedˉkind: u32 = U32ˉfromˉu8(
        Bytesˉreadˉu8(Selectedˉdescriptor, 0u32)
    );
    if Borrowed {
        if !Hˉborrowˉpayloadˉkind(Selectedˉkind) { return Hˉoperationˉfailure(Stack, Depth); }
        Selectedˉkind = Selectedˉkind + 64u32;
    } else if Selectedˉkind == 23u32 && Hˉownedˉaggregate(
        Input, Types, Bytesˉreadˉu32ˉlittle(Input, Types),
        22u32, Selectedˉtypeˉindex, Minor
    ) {
        Selectedˉkind = 26u32;
    }
    return Hˉoperationˉstate(
        true,
        Bytesˉslice(Stack, 0u32, Arrayˉoffset),
        Depth - 2u32,
        true,
        Selectedˉkind,
        Bytesˉreadˉu32ˉlittle(Selectedˉdescriptor, 1u32)
    );
}

fn Hˉreadˉthroughˉshape(Input: bytes, Types: u32, Kind: u32, Nominal: u32) -> bool {
    // Semantic verification already admitted the type directory. This local
    // proof bounds aggregate traversal; it does not replace that admission.
    let Typeˉcount: u32 = Bytesˉreadˉu32ˉlittle(Input, Types);
    var Pending: bytes = Bytesˉconcat(Bytesˉfromˉu32ˉlittle(Kind), Bytesˉfromˉu32ˉlittle(Nominal));
    var Path: bytes = Bytesˉslice(Input, 0u32, 0u32);
    var Steps: u32 = 0u32;
    while Bytesˉlength(Pending) > 0u32 {
        if Steps >= 8192u32 { return false; }
        Steps = Steps + 1u32;
        let Frame: u32 = Bytesˉlength(Pending) - 8u32;
        let Currentˉkind: u32 = Bytesˉreadˉu32ˉlittle(Pending, Frame);
        let Currentˉnominal: u32 = Bytesˉreadˉu32ˉlittle(Pending, Frame + 4u32);
        Pending = Bytesˉslice(Pending, 0u32, Frame);
        if Currentˉkind == 0u32 {
            if Bytesˉlength(Path) < 4u32 { return false; }
            Path = Bytesˉslice(Path, 0u32, Bytesˉlength(Path) - 4u32);
        } else if Currentˉkind == 1u32 || Currentˉkind == 2u32 ||
            (Currentˉkind >= 3u32 && Currentˉkind <= 6u32) ||
            Currentˉkind == 9u32 || Currentˉkind == 10u32 ||
            (Currentˉkind >= 14u32 && Currentˉkind <= 20u32) {
            // Primitive scalars are Copy; text and bytes are shared immutable.
            if Currentˉnominal != 0u32 { return false; }
        } else if Currentˉkind == 8u32 || Currentˉkind == 24u32 || Currentˉkind == 35u32 {
            if Currentˉnominal >= Typeˉcount { return false; }
            let Descriptor: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(Input,
                Hˉtypeˉat(Input, Types, Currentˉnominal)));
            if (Currentˉkind == 8u32 && Descriptor != 2u32 && Descriptor != 7u32) ||
                (Currentˉkind == 24u32 && Descriptor != 6u32) ||
                (Currentˉkind == 35u32 && Descriptor != 8u32) { return false; }
            // The admitted function-reference/plain-capture cell is Copy.
            // This does not admit a new capture class or callable descriptor.
        } else if Currentˉkind == 7u32 || Currentˉkind == 11u32 || Currentˉkind == 22u32 {
            if Currentˉnominal >= Typeˉcount || Bytesˉlength(Path) >= 256u32 ||
                Hˉtypeˉpathˉcontains(Path, Currentˉnominal) || Bytesˉlength(Pending) >= 32768u32 {
                return false;
            }
            if Currentˉkind == 7u32 && (Hˉtaskˉscopeˉisˉexact(Input, Types, Typeˉcount, Currentˉnominal) ||
                Hˉtaskˉhandleˉisˉexact(Input, Types, Typeˉcount, Currentˉnominal) ||
                Hˉunsafeˉscratchˉisˉexact(Input, Types, Typeˉcount, Currentˉnominal)) {
                return false;
            }
            var Typeˉcursor: u32 = Hˉtypeˉat(Input, Types, Currentˉnominal);
            let Typeˉkind: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(Input, Typeˉcursor));
            if (Currentˉkind == 7u32 && Typeˉkind != 1u32) ||
                (Currentˉkind == 11u32 && Typeˉkind != 3u32) ||
                (Currentˉkind == 22u32 && Typeˉkind != 4u32) { return false; }
            Pending = Bytesˉconcat(Pending, Bytesˉconcat(Bytesˉfromˉu32ˉlittle(0u32),
                Bytesˉfromˉu32ˉlittle(Currentˉnominal)));
            Path = Bytesˉconcat(Path, Bytesˉfromˉu32ˉlittle(Currentˉnominal));
            Typeˉcursor = Hˉafterˉencodedˉstring(Input, Typeˉcursor + 1u32);
            var Items: u32 = 1u32;
            if Typeˉkind != 4u32 {
                Items = Bytesˉreadˉu32ˉlittle(Input, Typeˉcursor);
                Typeˉcursor = Typeˉcursor + 4u32;
            }
            var Item: u32 = 0u32;
            while Item < Items {
                if Steps >= 8192u32 { return false; }
                Steps = Steps + 1u32;
                if Typeˉkind != 4u32 { Typeˉcursor = Hˉafterˉencodedˉstring(Input, Typeˉcursor); }
                var Fields: u32 = 1u32;
                if Typeˉkind == 3u32 {
                    let Marker: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(Input, Typeˉcursor));
                    Typeˉcursor = Typeˉcursor + 1u32;
                    Fields = Marker;
                    if Marker == 2u32 {
                        Fields = Bytesˉreadˉu32ˉlittle(Input, Typeˉcursor);
                        Typeˉcursor = Typeˉcursor + 4u32;
                    } else if Marker > 2u32 { return false; }
                }
                var Field: u32 = 0u32;
                while Field < Fields {
                    if Steps >= 8192u32 || Bytesˉlength(Pending) >= 32768u32 { return false; }
                    Steps = Steps + 1u32;
                    if Typeˉkind == 3u32 { Typeˉcursor = Hˉafterˉencodedˉstring(Input, Typeˉcursor); }
                    let Width: u32 = Hˉshapeˉwidth(Input, Typeˉcursor);
                    if Width == 0u32 { return false; }
                    let Fieldˉkind: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(Input, Typeˉcursor));
                    if Fieldˉkind == 0u32 { return false; }
                    var Fieldˉnominal: u32 = 0u32;
                    if Width == 5u32 { Fieldˉnominal = Bytesˉreadˉu32ˉlittle(Input, Typeˉcursor + 1u32); }
                    Pending = Bytesˉconcat(Pending, Bytesˉconcat(Bytesˉfromˉu32ˉlittle(Fieldˉkind),
                        Bytesˉfromˉu32ˉlittle(Fieldˉnominal)));
                    Typeˉcursor = Typeˉcursor + Width;
                    Field = Field + 1u32;
                }
                Item = Item + 1u32;
            }
        } else {
            // Owners, special views, and unproven callable value classes cannot
            // become owned results by reading through an immutable borrow.
            return false;
        }
    }
    return Bytesˉlength(Path) == 0u32;
}

fn Hˉvalueˉmatches(Input: bytes, Types: u32, Expected: u32, Actual: u32, Nominal: u32) -> bool {
    if Expected == Actual { return true; }
    if Bytesˉreadˉu16ˉlittle(Input, 6u32) != 39u32 || Expected >= 64u32 ||
        Actual != Expected + 64u32 { return false; }
    return Hˉreadˉthroughˉshape(Input, Types, Expected, Nominal);
}

export fn Hˉcall(
    Input: bytes,
    Minor: u32,
    Functionˉcode: u32,
    Cursor: u32,
    Functions: u32,
    Types: u32,
    Stack: bytes,
    Depth: u32
) -> Hˉoperationˉstate {
    let Total: u32 = Bytesˉlength(Input);
    if Total < 8u32 || Functionˉcode > Total || Cursor > Total - Functionˉcode ||
        Total - Functionˉcode - Cursor < 5u32 || Functions > Total ||
        Total - Functions < 4u32 || Types > Total || Total - Types < 4u32 ||
        Depth > 4096u32 || Bytesˉlength(Stack) != Depth * 5u32 {
        return Hˉoperationˉfailure(Stack, Depth);
    }
    let Targetˉindex: u32 = Bytesˉreadˉu32ˉlittle(Input, Functionˉcode + Cursor + 1u32);
    let Functionˉcount: u32 = Bytesˉreadˉu32ˉlittle(Input, Functions);
    if Functionˉcount > 4096u32 || Targetˉindex >= Functionˉcount {
        return Hˉoperationˉfailure(Stack, Depth);
    }
    var Targetˉcursor: u32 = Functions + 4u32;
    var Currentˉfunction: u32 = 0u32;
    var Targetˉparameters: u32 = 0u32;
    var Targetˉparameterˉtypes: u32 = 0u32;
    var Targetˉreturn: u32 = 0u32;
    while Currentˉfunction <= Targetˉindex {
        if Targetˉcursor > Total || Total - Targetˉcursor < 4u32 {
            return Hˉoperationˉfailure(Stack, Depth);
        }
        let Nameˉlength: u32 = Bytesˉreadˉu32ˉlittle(Input, Targetˉcursor);
        Targetˉcursor = Targetˉcursor + 4u32;
        if Nameˉlength > Total - Targetˉcursor { return Hˉoperationˉfailure(Stack, Depth); }
        Targetˉcursor = Targetˉcursor + Nameˉlength;
        if Total - Targetˉcursor < 4u32 { return Hˉoperationˉfailure(Stack, Depth); }
        Targetˉparameters = Bytesˉreadˉu32ˉlittle(Input, Targetˉcursor);
        Targetˉcursor = Targetˉcursor + 4u32;
        Targetˉparameterˉtypes = Targetˉcursor;
        if Targetˉparameters > 4096u32 { return Hˉoperationˉfailure(Stack, Depth); }
        var Shapeˉindex: u32 = 0u32;
        while Shapeˉindex < Targetˉparameters {
            let Parameterˉwidth: u32 = Hˉshapeˉwidth(Input, Targetˉcursor);
            if Parameterˉwidth == 0u32 { return Hˉoperationˉfailure(Stack, Depth); }
            Targetˉcursor = Targetˉcursor + Parameterˉwidth;
            Shapeˉindex = Shapeˉindex + 1u32;
        }
        Targetˉreturn = Targetˉcursor;
        let Returnˉwidth: u32 = Hˉshapeˉwidth(Input, Targetˉreturn);
        if Returnˉwidth == 0u32 { return Hˉoperationˉfailure(Stack, Depth); }
        Targetˉcursor = Targetˉcursor + Returnˉwidth;
        if Total - Targetˉcursor < 4u32 { return Hˉoperationˉfailure(Stack, Depth); }
        let Locals: u32 = Bytesˉreadˉu32ˉlittle(Input, Targetˉcursor);
        Targetˉcursor = Targetˉcursor + 4u32;
        if Locals > 4096u32 { return Hˉoperationˉfailure(Stack, Depth); }
        Shapeˉindex = 0u32;
        while Shapeˉindex < Locals {
            let Localˉwidth: u32 = Hˉshapeˉwidth(Input, Targetˉcursor);
            if Localˉwidth == 0u32 { return Hˉoperationˉfailure(Stack, Depth); }
            Targetˉcursor = Targetˉcursor + Localˉwidth;
            Shapeˉindex = Shapeˉindex + 1u32;
        }
        if Total - Targetˉcursor < 12u32 { return Hˉoperationˉfailure(Stack, Depth); }
        Targetˉcursor = Targetˉcursor + 12u32;
        Currentˉfunction = Currentˉfunction + 1u32;
    }
    if Targetˉparameters > Depth { return Hˉoperationˉfailure(Stack, Depth); }
    // Decode parameters once and index their fixed-width cells in reverse.
    // Neither argument lookup nor stack consumption copies a growing prefix.
    let Parameters: bytes = Typedˉdirectories.Hˉlocalˉshapes(
        Input, Targetˉparameterˉtypes, Targetˉparameters, Targetˉparameterˉtypes, 0u32
    );
    if Bytesˉlength(Parameters) != Targetˉparameters * 5u32 {
        return Hˉoperationˉfailure(Stack, Depth);
    }
    var Argument: u32 = 0u32;
    while Argument < Targetˉparameters {
        let Parameter: u32 = (Targetˉparameters - Argument - 1u32) * 5u32;
        let Declaredˉkind: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(Parameters, Parameter));
        let Expectedˉnominal: u32 = Bytesˉreadˉu32ˉlittle(Parameters, Parameter + 1u32);
        var Expectedˉkind: u32 = Declaredˉkind;
        if Declaredˉkind >= 64u32 {
            if Bytesˉreadˉu16ˉlittle(Input, 6u32) != 39u32 {
                return Hˉoperationˉfailure(Stack, Depth);
            }
        } else {
            if Minor >= 26u32 {
                if Declaredˉkind == 23u32 { Expectedˉkind = 26u32; }
                if Declaredˉkind == 26u32 || Declaredˉkind == 27u32 { Expectedˉkind = 23u32; }
            }
            if Minor >= 23u32 && Declaredˉkind == 25u32 { Expectedˉkind = 27u32; }
            if Minor >= 34u32 && Minor <= 37u32 && Declaredˉkind == 36u32 {
                Expectedˉkind = 25u32;
            }
            if Hˉownedˉaggregate(Input, Types, Bytesˉreadˉu32ˉlittle(Input, Types),
                Declaredˉkind, Expectedˉnominal, Minor) {
                Expectedˉkind = Hˉownedˉtransferˉkind(Declaredˉkind);
            }
            Expectedˉkind = Hˉaffineˉresultˉtransferˉkind(
                Input, Types, Minor, Expectedˉkind, Expectedˉnominal
            );
            if Expectedˉkind == 37u32 { return Hˉoperationˉfailure(Stack, Depth); }
        }
        let Actual: u32 = (Depth - Argument - 1u32) * 5u32;
        let Actualˉkind: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(Stack, Actual));
        if Bytesˉreadˉu32ˉlittle(Stack, Actual + 1u32) != Expectedˉnominal ||
            !Hˉvalueˉmatches(Input, Types, Expectedˉkind, Actualˉkind, Expectedˉnominal) {
            return Hˉoperationˉfailure(Stack, Depth);
        }
        Argument = Argument + 1u32;
    }
    var Pushˉkind: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(Input, Targetˉreturn));
    let Declaredˉpushˉkind: u32 = Pushˉkind;
    // The candidate encoding has no borrowed function-result shape.
    if Pushˉkind == 37u32 { return Hˉoperationˉfailure(Stack, Depth); }
    var Pushˉnominal: u32 = 0u32;
    if Hˉshapeˉwidth(Input, Targetˉreturn) == 5u32 {
        Pushˉnominal = Bytesˉreadˉu32ˉlittle(Input, Targetˉreturn + 1u32);
    }
    if Hˉownedˉaggregate(Input, Types, Bytesˉreadˉu32ˉlittle(Input, Types),
        Declaredˉpushˉkind, Pushˉnominal, Minor) {
        Pushˉkind = Hˉownedˉtransferˉkind(Declaredˉpushˉkind);
    }
    Pushˉkind = Hˉaffineˉresultˉtransferˉkind(Input, Types, Minor, Pushˉkind, Pushˉnominal);
    if Pushˉkind == 37u32 { return Hˉoperationˉfailure(Stack, Depth); }
    return Hˉoperationˉstate(true, Bytesˉslice(Stack, 0u32, (Depth - Targetˉparameters) * 5u32),
        Depth - Targetˉparameters, Pushˉkind != 0u32 && Pushˉkind != 21u32, Pushˉkind, Pushˉnominal);
}

fn Hˉindirectˉcall(
    Input: bytes,
    Minor: u32,
    Functionˉcode: u32,
    Cursor: u32,
    Types: u32,
    Stack: bytes,
    Depth: u32
) -> Hˉoperationˉstate {
    let Callableˉtype: u32 = Bytesˉreadˉu32ˉlittle(
        Input, Functionˉcode + Cursor + 1u32
    );
    let Descriptor: u32 = Hˉtypeˉat(Input, Types, Callableˉtype);
    if U32ˉfromˉu8(Bytesˉreadˉu8(Input, Descriptor)) != 8u32 {
        return Hˉoperationˉfailure(Stack, Depth);
    }
    let Returnˉshape: u32 = Descriptor + 2u32;
    let Parameterˉcountˉcursor: u32 = Returnˉshape +
        Hˉshapeˉwidth(Input, Returnˉshape);
    let Parameters: u32 = Bytesˉreadˉu32ˉlittle(
        Input, Parameterˉcountˉcursor
    );
    let Parameterˉtypes: u32 = Parameterˉcountˉcursor + 4u32;
    if Parameters + 1u32 > Depth {
        return Hˉoperationˉfailure(Stack, Depth);
    }
    var Resultˉstack: bytes = Stack;
    var Resultˉdepth: u32 = Depth;
    var Argument: u32 = 0u32;
    while Argument < Parameters {
        let Wanted: u32 = Parameters - Argument - 1u32;
        var Parameterˉcursor: u32 = Parameterˉtypes;
        var Skipped: u32 = 0u32;
        while Skipped < Wanted {
            Parameterˉcursor = Parameterˉcursor +
                Hˉshapeˉwidth(Input, Parameterˉcursor);
            Skipped = Skipped + 1u32;
        }
        let Declaredˉkind: u32 = U32ˉfromˉu8(
            Bytesˉreadˉu8(Input, Parameterˉcursor)
        );
        var Expectedˉkind: u32 = Declaredˉkind;
        if Minor >= 26u32 {
            if Declaredˉkind == 23u32 { Expectedˉkind = 26u32; }
            if Declaredˉkind == 26u32 || Declaredˉkind == 27u32 {
                Expectedˉkind = 23u32;
            }
        }
        var Expectedˉnominal: u32 = 0u32;
        if Hˉshapeˉwidth(Input, Parameterˉcursor) == 5u32 {
            Expectedˉnominal = Bytesˉreadˉu32ˉlittle(
                Input, Parameterˉcursor + 1u32
            );
        }
        if Hˉownedˉaggregate(
            Input, Types, Bytesˉreadˉu32ˉlittle(Input, Types),
            Declaredˉkind, Expectedˉnominal, Minor
        ) {
            Expectedˉkind = Hˉownedˉtransferˉkind(Declaredˉkind);
        }
        Expectedˉkind = Hˉaffineˉresultˉtransferˉkind(
            Input, Types, Minor, Expectedˉkind, Expectedˉnominal
        );
        if Expectedˉkind == 37u32 {
            return Hˉoperationˉfailure(Resultˉstack, Resultˉdepth);
        }
        let Actual: u32 = Bytesˉlength(Resultˉstack) - 5u32;
        if !Hˉexactˉvalueˉmatches(Input, Types, Expectedˉkind, Expectedˉnominal,
            U32ˉfromˉu8(Bytesˉreadˉu8(Resultˉstack, Actual)),
            Bytesˉreadˉu32ˉlittle(Resultˉstack, Actual + 1u32)) {
            return Hˉoperationˉfailure(Resultˉstack, Resultˉdepth);
        }
        Resultˉstack = Bytesˉslice(Resultˉstack, 0u32, Actual);
        Resultˉdepth = Resultˉdepth - 1u32;
        Argument = Argument + 1u32;
    }
    let Callableˉoffset: u32 = Bytesˉlength(Resultˉstack) - 5u32;
    if !Hˉexactˉvalueˉmatches(Input, Types, 35u32, Callableˉtype,
        U32ˉfromˉu8(Bytesˉreadˉu8(Resultˉstack, Callableˉoffset)),
        Bytesˉreadˉu32ˉlittle(Resultˉstack, Callableˉoffset + 1u32)) {
        return Hˉoperationˉfailure(Resultˉstack, Resultˉdepth);
    }
    Resultˉstack = Bytesˉslice(Resultˉstack, 0u32, Callableˉoffset);
    Resultˉdepth = Resultˉdepth - 1u32;
    var Pushˉkind: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(Input, Returnˉshape));
    let Declaredˉpushˉkind: u32 = Pushˉkind;
    var Pushˉnominal: u32 = 0u32;
    if Hˉshapeˉwidth(Input, Returnˉshape) == 5u32 {
        Pushˉnominal = Bytesˉreadˉu32ˉlittle(Input, Returnˉshape + 1u32);
    }
    if Hˉownedˉaggregate(
        Input, Types, Bytesˉreadˉu32ˉlittle(Input, Types),
        Declaredˉpushˉkind, Pushˉnominal, Minor
    ) {
        Pushˉkind = Hˉownedˉtransferˉkind(Declaredˉpushˉkind);
    }
    Pushˉkind = Hˉaffineˉresultˉtransferˉkind(
        Input, Types, Minor, Pushˉkind, Pushˉnominal
    );
    if Pushˉkind == 37u32 {
        return Hˉoperationˉfailure(Resultˉstack, Resultˉdepth);
    }
    return Hˉoperationˉstate(
        true, Resultˉstack, Resultˉdepth,
        Pushˉkind != 0u32 && Pushˉkind != 21u32,
        Pushˉkind, Pushˉnominal
    );
}

fn Hˉclosureˉcaptureˉshapeˉisˉcopyable(Kind: u32) -> bool {
    return Kind == 1u32 || Kind == 2u32 || Kind == 4u32 ||
        Kind == 5u32 || Kind == 8u32 || Kind == 9u32 || Kind == 10u32 ||
        (Kind >= 14u32 && Kind <= 19u32);
}

fn Hˉcallableˉcreate(
    Input: bytes,
    Functionˉcode: u32,
    Cursor: u32,
    Functions: u32,
    Types: u32,
    Stack: bytes,
    Depth: u32
) -> Hˉoperationˉstate {
    let Opcode: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(
        Input, Functionˉcode + Cursor
    ));
    let Callableˉtype: u32 = Bytesˉreadˉu32ˉlittle(
        Input, Functionˉcode + Cursor + 5u32
    );
    if Opcode == 211u32 {
        return Hˉoperationˉstate(
            true, Stack, Depth, true, 35u32, Callableˉtype
        );
    }
    let Targetˉindex: u32 = Bytesˉreadˉu32ˉlittle(
        Input, Functionˉcode + Cursor + 1u32
    );
    let Captures: u32 = Bytesˉreadˉu32ˉlittle(
        Input, Functionˉcode + Cursor + 9u32
    );
    if Captures < 1u32 || Captures > 64u32 || Captures > Depth {
        return Hˉoperationˉfailure(Stack, Depth);
    }
    var Target: u32 = Functions + 4u32;
    var Currentˉfunction: u32 = 0u32;
    while Currentˉfunction < Targetˉindex {
        let Skippedˉnameˉlength: u32 = Bytesˉreadˉu32ˉlittle(
            Input, Target
        );
        Target = Target + 4u32 + Skippedˉnameˉlength;
        let Skippedˉparameters: u32 = Bytesˉreadˉu32ˉlittle(
            Input, Target
        );
        Target = Target + 4u32;
        var Skippedˉshape: u32 = 0u32;
        while Skippedˉshape < Skippedˉparameters + 1u32 {
            Target = Target + Hˉshapeˉwidth(Input, Target);
            Skippedˉshape = Skippedˉshape + 1u32;
        }
        let Skippedˉlocals: u32 = Bytesˉreadˉu32ˉlittle(Input, Target);
        Target = Target + 4u32;
        Skippedˉshape = 0u32;
        while Skippedˉshape < Skippedˉlocals {
            Target = Target + Hˉshapeˉwidth(Input, Target);
            Skippedˉshape = Skippedˉshape + 1u32;
        }
        Target = Target + 12u32;
        Currentˉfunction = Currentˉfunction + 1u32;
    }
    let Targetˉnameˉlength: u32 = Bytesˉreadˉu32ˉlittle(Input, Target);
    Target = Target + 4u32 + Targetˉnameˉlength;
    let Targetˉparameters: u32 = Bytesˉreadˉu32ˉlittle(Input, Target);
    Target = Target + 4u32;
    if Targetˉparameters < Captures {
        return Hˉoperationˉfailure(Stack, Depth);
    }
    let Parameterˉtypes: u32 = Target;
    var Resultˉstack: bytes = Stack;
    var Resultˉdepth: u32 = Depth;
    var Capture: u32 = 0u32;
    while Capture < Captures {
        let Wanted: u32 = Captures - Capture - 1u32;
        var Parameter: u32 = Parameterˉtypes;
        var Skipped: u32 = 0u32;
        while Skipped < Wanted {
            Parameter = Parameter + Hˉshapeˉwidth(Input, Parameter);
            Skipped = Skipped + 1u32;
        }
        let Expectedˉkind: u32 = U32ˉfromˉu8(
            Bytesˉreadˉu8(Input, Parameter)
        );
        var Expectedˉnominal: u32 = 0u32;
        if Hˉshapeˉwidth(Input, Parameter) == 5u32 {
            Expectedˉnominal = Bytesˉreadˉu32ˉlittle(
                Input, Parameter + 1u32
            );
        }
        let Actual: u32 = Bytesˉlength(Resultˉstack) - 5u32;
        if !Hˉclosureˉcaptureˉshapeˉisˉcopyable(Expectedˉkind) ||
            !Hˉexactˉvalueˉmatches(Input, Types, Expectedˉkind, Expectedˉnominal,
                U32ˉfromˉu8(Bytesˉreadˉu8(Resultˉstack, Actual)),
                Bytesˉreadˉu32ˉlittle(Resultˉstack, Actual + 1u32)) {
            return Hˉoperationˉfailure(Resultˉstack, Resultˉdepth);
        }
        Resultˉstack = Bytesˉslice(Resultˉstack, 0u32, Actual);
        Resultˉdepth = Resultˉdepth - 1u32;
        Capture = Capture + 1u32;
    }
    return Hˉoperationˉstate(
        true, Resultˉstack, Resultˉdepth,
        true, 35u32, Callableˉtype
    );
}

fn Hˉcallableˉoperation(
    Input: bytes,
    Minor: u32,
    Functionˉcode: u32,
    Cursor: u32,
    Functions: u32,
    Types: u32,
    Stack: bytes,
    Depth: u32
) -> Hˉoperationˉstate {
    if U32ˉfromˉu8(Bytesˉreadˉu8(Input, Functionˉcode + Cursor)) ==
            212u32 {
        return Hˉindirectˉcall(
            Input, Minor, Functionˉcode, Cursor, Types, Stack, Depth
        );
    }
    return Hˉcallableˉcreate(
        Input, Functionˉcode, Cursor, Functions, Types, Stack, Depth
    );
}

fn Hˉtaskˉoperation(
    Input: bytes,
    Functionˉcode: u32,
    Cursor: u32,
    Types: u32,
    Localˉshapes: bytes,
    Localˉslots: u32,
    Stack: bytes,
    Depth: u32
) -> Hˉoperationˉstate {
    let Opcode: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(
        Input, Functionˉcode + Cursor
    ));
    let Typeˉcount: u32 = Bytesˉreadˉu32ˉlittle(Input, Types);
    let Local: u32 = Bytesˉreadˉu32ˉlittle(
        Input, Functionˉcode + Cursor + 1u32
    );
    if Opcode < 214u32 || Opcode > 219u32 || Local >= Localˉslots {
        return Hˉoperationˉfailure(Stack, Depth);
    }

    let Localˉkind: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(
        Localˉshapes, Local * 5u32
    ));
    let Localˉnominal: u32 = Bytesˉreadˉu32ˉlittle(
        Localˉshapes, Local * 5u32 + 1u32
    );
    if Opcode == 214u32 {
        let Resultˉtype: u32 = Bytesˉreadˉu32ˉlittle(
            Input, Functionˉcode + Cursor + 5u32
        );
        if Localˉkind != 25u32 || Depth < 2u32 ||
            !Hˉtaskˉaffineˉresultˉisˉexact(
                Input, Types, Typeˉcount, Resultˉtype
            ) {
            return Hˉoperationˉfailure(Stack, Depth);
        }
        let Scopeˉcase: bytes = Hˉvariantˉcaseˉat(
            Input, Types, Resultˉtype, 0u32
        );
        if !Hˉtaskˉscopeˉisˉexact(
                Input, Types, Typeˉcount,
                Bytesˉreadˉu32ˉlittle(Scopeˉcase, 5u32)
            ) {
            return Hˉoperationˉfailure(Stack, Depth);
        }
        let Contextˉoffset: u32 = Bytesˉlength(Stack) - 5u32;
        if !Hˉvalueˉmatches(Input, Types, 7u32,
            U32ˉfromˉu8(Bytesˉreadˉu8(Stack, Contextˉoffset)),
            Bytesˉreadˉu32ˉlittle(Stack, Contextˉoffset + 1u32)) ||
            !Hˉoperationˉcontextˉisˉexact(
                Input, Types, Typeˉcount,
                Bytesˉreadˉu32ˉlittle(Stack, Contextˉoffset + 1u32)
            ) {
            return Hˉoperationˉfailure(Stack, Depth);
        }
        let Limitsˉoffset: u32 = Contextˉoffset - 5u32;
        if !Hˉvalueˉmatches(Input, Types, 7u32,
            U32ˉfromˉu8(Bytesˉreadˉu8(Stack, Limitsˉoffset)),
            Bytesˉreadˉu32ˉlittle(Stack, Limitsˉoffset + 1u32)) ||
            !Hˉtaskˉlimitsˉisˉexact(
                Input, Types, Typeˉcount,
                Bytesˉreadˉu32ˉlittle(Stack, Limitsˉoffset + 1u32)
            ) {
            return Hˉoperationˉfailure(Stack, Depth);
        }
        return Hˉoperationˉstate(
            true, Bytesˉslice(Stack, 0u32, Limitsˉoffset), Depth - 2u32,
            true, 32u32, Resultˉtype
        );
    }

    if Opcode != 217u32 && (Localˉkind != 7u32 ||
        !Hˉtaskˉscopeˉisˉexact(
            Input, Types, Typeˉcount, Localˉnominal
        )) {
        return Hˉoperationˉfailure(Stack, Depth);
    }
    if Opcode == 215u32 {
        let Contextˉtype: u32 = Bytesˉreadˉu32ˉlittle(
            Input, Functionˉcode + Cursor + 5u32
        );
        if !Hˉoperationˉcontextˉisˉexact(
                Input, Types, Typeˉcount, Contextˉtype
            ) {
            return Hˉoperationˉfailure(Stack, Depth);
        }
        return Hˉoperationˉstate(
            true, Stack, Depth, true, 7u32, Contextˉtype
        );
    }
    if Opcode == 216u32 {
        let Spawnˉresult: u32 = Bytesˉreadˉu32ˉlittle(
            Input, Functionˉcode + Cursor + 5u32
        );
        let Taskˉtype: u32 = Bytesˉreadˉu32ˉlittle(
            Input, Functionˉcode + Cursor + 9u32
        );
        if Depth == 0u32 || !Hˉtaskˉhandleˉisˉexact(
                Input, Types, Typeˉcount, Taskˉtype
            ) || Hˉvariantˉcaseˉcount(
                Input, Types, Typeˉcount, Spawnˉresult
            ) != 2u32 {
            return Hˉoperationˉfailure(Stack, Depth);
        }
        let Valid: bytes = Hˉvariantˉcaseˉat(
            Input, Types, Spawnˉresult, 0u32
        );
        if Bytesˉlength(Valid) != 9u32 ||
            U32ˉfromˉu8(Bytesˉreadˉu8(Valid, 4u32)) != 7u32 ||
            Bytesˉreadˉu32ˉlittle(Valid, 5u32) != Taskˉtype {
            return Hˉoperationˉfailure(Stack, Depth);
        }
        let Callableˉoffset: u32 = Bytesˉlength(Stack) - 5u32;
        if U32ˉfromˉu8(Bytesˉreadˉu8(Stack, Callableˉoffset)) != 35u32 {
            return Hˉoperationˉfailure(Stack, Depth);
        }
        let Callableˉtype: u32 = Bytesˉreadˉu32ˉlittle(
            Stack, Callableˉoffset + 1u32
        );
        if Callableˉtype >= Typeˉcount {
            return Hˉoperationˉfailure(Stack, Depth);
        }
        let Descriptor: u32 = Hˉtypeˉat(Input, Types, Callableˉtype);
        if U32ˉfromˉu8(Bytesˉreadˉu8(Input, Descriptor)) != 8u32 {
            return Hˉoperationˉfailure(Stack, Depth);
        }
        let Returnˉshape: u32 = Descriptor + 2u32;
        let Parameterˉcount: u32 = Returnˉshape +
            Hˉshapeˉwidth(Input, Returnˉshape);
        if U32ˉfromˉu8(Bytesˉreadˉu8(Input, Returnˉshape)) != 11u32 ||
            Bytesˉreadˉu32ˉlittle(Input, Parameterˉcount) != 0u32 ||
            (U32ˉfromˉu8(Bytesˉreadˉu8(
                Input, Parameterˉcount + 4u32
            )) & 1u32) == 0u32 {
            return Hˉoperationˉfailure(Stack, Depth);
        }
        return Hˉoperationˉstate(
            true, Bytesˉslice(Stack, 0u32, Callableˉoffset), Depth - 1u32,
            true, 32u32, Spawnˉresult
        );
    }
    if Opcode == 217u32 {
        let Handle: u32 = Local;
        let Origin: u32 = Bytesˉreadˉu32ˉlittle(
            Input, Functionˉcode + Cursor + 5u32
        );
        let Outcomeˉtype: u32 = Bytesˉreadˉu32ˉlittle(
            Input, Functionˉcode + Cursor + 9u32
        );
        if !Hˉtaskˉhandleˉisˉexact(
                Input, Types, Typeˉcount, Localˉnominal
            ) || Origin >= Localˉslots || Origin == Handle ||
            U32ˉfromˉu8(Bytesˉreadˉu8(
                Localˉshapes, Origin * 5u32
            )) != 7u32 || !Hˉtaskˉscopeˉisˉexact(
                Input, Types, Typeˉcount,
                Bytesˉreadˉu32ˉlittle(
                    Localˉshapes, Origin * 5u32 + 1u32
                )
            ) || !Hˉtaskˉoutcomeˉisˉexact(
                Input, Types, Typeˉcount, Outcomeˉtype
            ) {
            return Hˉoperationˉfailure(Stack, Depth);
        }
        var Pushˉkind: u32 = 11u32;
        if Hˉownedˉaggregate(
                Input, Types, Typeˉcount, 11u32, Outcomeˉtype, 32u32
            ) {
            Pushˉkind = 32u32;
        }
        return Hˉoperationˉstate(
            true, Stack, Depth, true, Pushˉkind, Outcomeˉtype
        );
    }
    if Opcode == 218u32 {
        let Cancelˉoutcomeˉtype: u32 = Bytesˉreadˉu32ˉlittle(
            Input, Functionˉcode + Cursor + 5u32
        );
        if !Hˉcancelˉoutcomeˉisˉexact(
                Input, Types, Typeˉcount, Cancelˉoutcomeˉtype
            ) {
            return Hˉoperationˉfailure(Stack, Depth);
        }
        return Hˉoperationˉstate(
            true, Stack, Depth, true, 11u32, Cancelˉoutcomeˉtype
        );
    }
    if Opcode == 219u32 && U32ˉfromˉu8(Bytesˉreadˉu8(
            Input, Functionˉcode + Cursor + 5u32
        )) <= 2u32 {
        return Hˉoperationˉstate(
            true, Stack, Depth, false, 0u32, 0u32
        );
    }
    return Hˉoperationˉfailure(Stack, Depth);
}

fn Hˉunsafeˉscratchˉoperation(
    Input: bytes,
    Minor: u32,
    Functionˉcode: u32,
    Cursor: u32,
    Types: u32,
    Localˉshapes: bytes,
    Localˉslots: u32,
    Stack: bytes,
    Depth: u32
) -> Hˉoperationˉstate {
    let Budget: u32 = Bytesˉreadˉu32ˉlittle(
        Input, Functionˉcode + Cursor + 1u32
    );
    let Resultˉtype: u32 = Bytesˉreadˉu32ˉlittle(
        Input, Functionˉcode + Cursor + 5u32
    );
    let Abiˉtype: u32 = Bytesˉreadˉu32ˉlittle(
        Input, Functionˉcode + Cursor + 9u32
    );
    let Typeˉcount: u32 = Bytesˉreadˉu32ˉlittle(Input, Types);
    if (Minor != 33u32 && Minor != 34u32 && Minor != 35u32 &&
        Minor != 36u32 && Minor != 37u32) ||
        Budget >= Localˉslots ||
        Resultˉtype >= Typeˉcount ||
        Abiˉtype >= Typeˉcount || Depth < 2u32 || U32ˉfromˉu8(
            Bytesˉreadˉu8(Localˉshapes, Budget * 5u32)
        ) != 25u32 || !Hˉunsafeˉscratchˉresultˉisˉexact(
            Input, Types, Typeˉcount, Resultˉtype
        ) {
        return Hˉoperationˉfailure(Stack, Depth);
    }
    let Abiˉkind: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(
        Input, Hˉtypeˉat(Input, Types, Abiˉtype)
    ));
    if Abiˉkind != 2u32 && Abiˉkind != 7u32 {
        return Hˉoperationˉfailure(Stack, Depth);
    }
    let Alignment: u32 = Bytesˉlength(Stack) - 5u32;
    let Length: u32 = Alignment - 5u32;
    if !Hˉexactˉvalueˉmatches(Input, Types, 10u32, 0u32,
        U32ˉfromˉu8(Bytesˉreadˉu8(Stack, Alignment)),
        Bytesˉreadˉu32ˉlittle(Stack, Alignment + 1u32)) ||
        !Hˉexactˉvalueˉmatches(Input, Types, 10u32, 0u32,
        U32ˉfromˉu8(Bytesˉreadˉu8(Stack, Length)),
        Bytesˉreadˉu32ˉlittle(Stack, Length + 1u32)) {
        return Hˉoperationˉfailure(Stack, Depth);
    }
    return Hˉoperationˉstate(
        true, Bytesˉslice(Stack, 0u32, Length), Depth - 2u32,
        true, 36u32, Resultˉtype
    );
}

fn Hˉunsafeˉwriteˉregionˉoperation(
    Input: bytes,
    Minor: u32,
    Functionˉcode: u32,
    Cursor: u32,
    Types: u32,
    Localˉshapes: bytes,
    Localˉslots: u32,
    Parameterˉcount: u32,
    Stack: bytes,
    Depth: u32
) -> Hˉoperationˉstate {
    let Scratch: u32 = Bytesˉreadˉu32ˉlittle(
        Input, Functionˉcode + Cursor + 1u32
    );
    let Resultˉtype: u32 = Bytesˉreadˉu32ˉlittle(
        Input, Functionˉcode + Cursor + 5u32
    );
    let Abiˉtype: u32 = Bytesˉreadˉu32ˉlittle(
        Input, Functionˉcode + Cursor + 9u32
    );
    let Typeˉcount: u32 = Bytesˉreadˉu32ˉlittle(Input, Types);
    if (Minor != 36u32 && Minor != 37u32) || Scratch >= Localˉslots ||
        Resultˉtype >= Typeˉcount || Abiˉtype >= Typeˉcount ||
        Depth < 3u32 {
        return Hˉoperationˉfailure(Stack, Depth);
    }
    let Scratchˉshape: u32 = Scratch * 5u32;
    let Scratchˉkind: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(
        Localˉshapes, Scratchˉshape
    ));
    let Scratchˉtype: u32 = Bytesˉreadˉu32ˉlittle(
        Localˉshapes, Scratchˉshape + 1u32
    );
    if (Scratchˉkind != 7u32 &&
            (Scratchˉkind != 28u32 || Scratch >= Parameterˉcount)) ||
        Scratchˉtype >= Typeˉcount ||
        !Hˉunsafeˉscratchˉisˉexact(
            Input, Types, Typeˉcount, Scratchˉtype
        ) || !Hˉunsafeˉwriteˉregionˉresultˉisˉexact(
            Input, Types, Typeˉcount, Resultˉtype
        ) {
        return Hˉoperationˉfailure(Stack, Depth);
    }
    let Regionˉtype: u32 =
        Hˉunsafeˉwriteˉregionˉresultˉvalueˉtype(
            Input, Types, Typeˉcount, Resultˉtype
        );
    if Regionˉtype >= Typeˉcount || Regionˉtype == Scratchˉtype {
        return Hˉoperationˉfailure(Stack, Depth);
    }
    let Abiˉkind: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(
        Input, Hˉtypeˉat(Input, Types, Abiˉtype)
    ));
    if Abiˉkind != 2u32 && Abiˉkind != 7u32 {
        return Hˉoperationˉfailure(Stack, Depth);
    }
    let Alignment: u32 = Bytesˉlength(Stack) - 5u32;
    let Length: u32 = Alignment - 5u32;
    let Start: u32 = Length - 5u32;
    if !Hˉexactˉvalueˉmatches(Input, Types, 10u32, 0u32,
        U32ˉfromˉu8(Bytesˉreadˉu8(Stack, Alignment)),
        Bytesˉreadˉu32ˉlittle(Stack, Alignment + 1u32)) ||
        !Hˉexactˉvalueˉmatches(Input, Types, 10u32, 0u32,
        U32ˉfromˉu8(Bytesˉreadˉu8(Stack, Length)),
        Bytesˉreadˉu32ˉlittle(Stack, Length + 1u32)) ||
        !Hˉexactˉvalueˉmatches(Input, Types, 10u32, 0u32,
        U32ˉfromˉu8(Bytesˉreadˉu8(Stack, Start)),
        Bytesˉreadˉu32ˉlittle(Stack, Start + 1u32)) {
        return Hˉoperationˉfailure(Stack, Depth);
    }
    return Hˉoperationˉstate(
        true, Bytesˉslice(Stack, 0u32, Start), Depth - 3u32,
        true, 37u32, Resultˉtype
    );
}

fn Hˉunsafeˉwriteˉpointerˉoperation(
    Input: bytes,
    Minor: u32,
    Functionˉcode: u32,
    Cursor: u32,
    Types: u32,
    Localˉshapes: bytes,
    Localˉslots: u32,
    Parameterˉcount: u32,
    Stack: bytes,
    Depth: u32
) -> Hˉoperationˉstate {
    let Region: u32 = Bytesˉreadˉu32ˉlittle(
        Input, Functionˉcode + Cursor + 1u32
    );
    let Pointerˉtype: u32 = Bytesˉreadˉu32ˉlittle(
        Input, Functionˉcode + Cursor + 5u32
    );
    let Abiˉtype: u32 = Bytesˉreadˉu32ˉlittle(
        Input, Functionˉcode + Cursor + 9u32
    );
    let Typeˉcount: u32 = Bytesˉreadˉu32ˉlittle(Input, Types);
    if Minor != 37u32 || Region >= Localˉslots ||
        Pointerˉtype >= Typeˉcount || Abiˉtype >= Typeˉcount {
        return Hˉoperationˉfailure(Stack, Depth);
    }
    let Regionˉshape: u32 = Region * 5u32;
    let Regionˉkind: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(
        Localˉshapes, Regionˉshape
    ));
    let Regionˉtype: u32 = Bytesˉreadˉu32ˉlittle(
        Localˉshapes, Regionˉshape + 1u32
    );
    if (Regionˉkind != 7u32 &&
            (Regionˉkind != 28u32 || Region >= Parameterˉcount)) ||
        Regionˉtype >= Typeˉcount || Regionˉtype == Pointerˉtype ||
        !Hˉunsafeˉscratchˉisˉexact(
            Input, Types, Typeˉcount, Regionˉtype
        ) || !Hˉunsafeˉscratchˉisˉexact(
            Input, Types, Typeˉcount, Pointerˉtype
        ) {
        return Hˉoperationˉfailure(Stack, Depth);
    }
    let Abiˉkind: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(
        Input, Hˉtypeˉat(Input, Types, Abiˉtype)
    ));
    if Abiˉkind != 2u32 && Abiˉkind != 7u32 {
        return Hˉoperationˉfailure(Stack, Depth);
    }
    return Hˉoperationˉstate(
        true, Stack, Depth, true, 38u32, Pointerˉtype
    );
}

fn Hˉforeignˉcallˉoperation(
    Input: bytes,
    Functionˉcode: u32,
    Cursor: u32,
    Types: u32,
    Stack: bytes,
    Depth: u32
) -> Hˉoperationˉstate {
    let Binding: u32 = Bytesˉreadˉu32ˉlittle(
        Input, Functionˉcode + Cursor + 1u32
    );
    let Pointerˉtype: u32 = Bytesˉreadˉu32ˉlittle(
        Input, Functionˉcode + Cursor + 5u32
    );
    let Abiˉtype: u32 = Bytesˉreadˉu32ˉlittle(
        Input, Functionˉcode + Cursor + 9u32
    );
    let Typeˉcount: u32 = Bytesˉreadˉu32ˉlittle(Input, Types);
    let Declaredˉminor: u32 = Bytesˉreadˉu16ˉlittle(Input, 6u32);
    if (Declaredˉminor != 38u32 && Declaredˉminor != 39u32) || Binding != 1u32 ||
        Pointerˉtype >= Typeˉcount || Abiˉtype >= Typeˉcount || Depth < 3u32 ||
        !Hˉunsafeˉscratchˉisˉexact(
            Input, Types, Typeˉcount, Pointerˉtype
        ) {
        return Hˉoperationˉfailure(Stack, Depth);
    }
    let Abiˉkind: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(
        Input, Hˉtypeˉat(Input, Types, Abiˉtype)
    ));
    if Abiˉkind != 2u32 && Abiˉkind != 7u32 {
        return Hˉoperationˉfailure(Stack, Depth);
    }
    let Generation: u32 = Bytesˉlength(Stack) - 5u32;
    let Capacity: u32 = Generation - 5u32;
    let Pointer: u32 = Capacity - 5u32;
    if !Hˉexactˉvalueˉmatches(Input, Types, 10u32, 0u32,
        U32ˉfromˉu8(Bytesˉreadˉu8(Stack, Generation)),
        Bytesˉreadˉu32ˉlittle(Stack, Generation + 1u32)) ||
        !Hˉexactˉvalueˉmatches(Input, Types, 10u32, 0u32,
        U32ˉfromˉu8(Bytesˉreadˉu8(Stack, Capacity)),
        Bytesˉreadˉu32ˉlittle(Stack, Capacity + 1u32)) ||
        U32ˉfromˉu8(Bytesˉreadˉu8(Stack, Pointer)) != 38u32 ||
        Bytesˉreadˉu32ˉlittle(Stack, Pointer + 1u32) != Pointerˉtype {
        return Hˉoperationˉfailure(Stack, Depth);
    }
    return Hˉoperationˉstate(
        true, Bytesˉslice(Stack, 0u32, Pointer), Depth - 3u32,
        true, 9u32, 0u32
    );
}

fn Hˉsystemˉoperation(
    Input: bytes,
    Minor: u32,
    Functionˉcode: u32,
    Cursor: u32,
    Types: u32,
    Localˉshapes: bytes,
    Localˉslots: u32,
    Parameterˉcount: u32,
    Stack: bytes,
    Depth: u32,
    Opcode: u32
) -> Hˉoperationˉstate {
    if Opcode == 220u32 {
        return Hˉunsafeˉscratchˉoperation(
            Input, Minor, Functionˉcode, Cursor, Types,
            Localˉshapes, Localˉslots, Stack, Depth
        );
    }
    if Opcode == 222u32 {
        return Hˉunsafeˉwriteˉregionˉoperation(
            Input, Minor, Functionˉcode, Cursor, Types,
            Localˉshapes, Localˉslots, Parameterˉcount, Stack, Depth
        );
    }
    if Opcode == 223u32 {
        return Hˉunsafeˉwriteˉpointerˉoperation(
            Input, Minor, Functionˉcode, Cursor, Types,
            Localˉshapes, Localˉslots, Parameterˉcount, Stack, Depth
        );
    }
    if Opcode == 224u32 {
        return Hˉforeignˉcallˉoperation(
            Input, Functionˉcode, Cursor, Types, Stack, Depth
        );
    }
    return Hˉoperationˉfailure(Stack, Depth);
}

export fn Hˉcapability(
    Input: bytes,
    Functionˉcode: u32,
    Cursor: u32,
    Capabilities: u32,
    Types: u32,
    Stack: bytes,
    Depth: u32
) -> Hˉoperationˉstate {
    let Capabilityˉindex: u32 = Bytesˉreadˉu32ˉlittle(
        Input,
        Functionˉcode + Cursor + 1u32
    );
    var Capabilityˉcursor: u32 = Capabilities + 4u32;
    var Currentˉcapability: u32 = 0u32;
    var Nameˉlength: u32 = 0u32;
    while Currentˉcapability < Capabilityˉindex {
        Nameˉlength = Bytesˉreadˉu32ˉlittle(Input, Capabilityˉcursor);
        Capabilityˉcursor = Capabilityˉcursor + 4u32 + Nameˉlength;
        let Skippedˉparameters: u32 = Bytesˉreadˉu32ˉlittle(Input, Capabilityˉcursor);
        Capabilityˉcursor = Capabilityˉcursor + 4u32 + Skippedˉparameters + 1u32;
        Currentˉcapability = Currentˉcapability + 1u32;
    }
    Nameˉlength = Bytesˉreadˉu32ˉlittle(Input, Capabilityˉcursor);
    Capabilityˉcursor = Capabilityˉcursor + 4u32 + Nameˉlength;
    let Capabilityˉparameters: u32 = Bytesˉreadˉu32ˉlittle(Input, Capabilityˉcursor);
    Capabilityˉcursor = Capabilityˉcursor + 4u32;
    if Capabilityˉparameters > Depth { return Hˉoperationˉfailure(Stack, Depth); }

    var Resultˉstack: bytes = Stack;
    var Resultˉdepth: u32 = Depth;
    var Argument: u32 = 0u32;
    while Argument < Capabilityˉparameters {
        let Expectedˉkind: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(
            Input,
            Capabilityˉcursor + Capabilityˉparameters - Argument - 1u32
        ));
        let Actualˉoffset: u32 = Bytesˉlength(Resultˉstack) - 5u32;
        if !Hˉexactˉvalueˉmatches(Input, Types, Expectedˉkind, 0u32,
            U32ˉfromˉu8(Bytesˉreadˉu8(Resultˉstack, Actualˉoffset)),
            Bytesˉreadˉu32ˉlittle(Resultˉstack, Actualˉoffset + 1u32)) {
            return Hˉoperationˉfailure(Resultˉstack, Resultˉdepth);
        }
        Resultˉstack = Bytesˉslice(Resultˉstack, 0u32, Actualˉoffset);
        Resultˉdepth = Resultˉdepth - 1u32;
        Argument = Argument + 1u32;
    }

    let Pushˉkind: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(
        Input,
        Capabilityˉcursor + Capabilityˉparameters
    ));
    return Hˉoperationˉstate(
        true,
        Resultˉstack,
        Resultˉdepth,
        Pushˉkind != 0u32,
        Pushˉkind,
        0u32
    );
}

fn Hˉencodedˉshape(Kind: u32, Nominal: u32) -> bytes {
    // 64 + payload kind retains shape-37 identity; 139 is the E1 Option view.
    // These cannot collide with affine transfer kinds 26 through 38.
    if Hˉborrowedˉvalue(Kind) || Kind == 139u32 {
        return Bytesˉconcat(Bytesˉslice(Bytesˉfromˉu32ˉlittle(Kind), 0u32, 1u32),
            Bytesˉfromˉu32ˉlittle(Nominal));
    }
    var Encodedˉkind: bytes = Bytesˉfromˉu8(0u8);
    if Kind == 1u32 { Encodedˉkind = Bytesˉfromˉu8(1u8); }
    if Kind == 2u32 { Encodedˉkind = Bytesˉfromˉu8(2u8); }
    if Kind == 3u32 { Encodedˉkind = Bytesˉfromˉu8(3u8); }
    if Kind == 4u32 { Encodedˉkind = Bytesˉfromˉu8(4u8); }
    if Kind == 5u32 { Encodedˉkind = Bytesˉfromˉu8(5u8); }
    if Kind == 6u32 { Encodedˉkind = Bytesˉfromˉu8(6u8); }
    if Kind == 7u32 { Encodedˉkind = Bytesˉfromˉu8(7u8); }
    if Kind == 8u32 { Encodedˉkind = Bytesˉfromˉu8(8u8); }
    if Kind == 9u32 { Encodedˉkind = Bytesˉfromˉu8(9u8); }
    if Kind == 10u32 { Encodedˉkind = Bytesˉfromˉu8(10u8); }
    if Kind == 11u32 { Encodedˉkind = Bytesˉfromˉu8(11u8); }
    if Kind == 14u32 { Encodedˉkind = Bytesˉfromˉu8(14u8); }
    if Kind == 15u32 { Encodedˉkind = Bytesˉfromˉu8(15u8); }
    if Kind == 16u32 { Encodedˉkind = Bytesˉfromˉu8(16u8); }
    if Kind == 17u32 { Encodedˉkind = Bytesˉfromˉu8(17u8); }
    if Kind == 18u32 { Encodedˉkind = Bytesˉfromˉu8(18u8); }
    if Kind == 19u32 { Encodedˉkind = Bytesˉfromˉu8(19u8); }
    if Kind == 20u32 { Encodedˉkind = Bytesˉfromˉu8(20u8); }
    if Kind == 22u32 { Encodedˉkind = Bytesˉfromˉu8(22u8); }
    if Kind == 23u32 { Encodedˉkind = Bytesˉfromˉu8(23u8); }
    if Kind == 24u32 { Encodedˉkind = Bytesˉfromˉu8(24u8); }
    if Kind == 25u32 { Encodedˉkind = Bytesˉfromˉu8(25u8); }
    if Kind == 26u32 { Encodedˉkind = Bytesˉfromˉu8(26u8); }
    if Kind == 27u32 { Encodedˉkind = Bytesˉfromˉu8(27u8); }
    if Kind == 28u32 { Encodedˉkind = Bytesˉfromˉu8(28u8); }
    if Kind == 29u32 { Encodedˉkind = Bytesˉfromˉu8(29u8); }
    if Kind == 30u32 { Encodedˉkind = Bytesˉfromˉu8(30u8); }
    if Kind == 31u32 { Encodedˉkind = Bytesˉfromˉu8(31u8); }
    if Kind == 32u32 { Encodedˉkind = Bytesˉfromˉu8(32u8); }
    if Kind == 33u32 { Encodedˉkind = Bytesˉfromˉu8(33u8); }
    if Kind == 34u32 { Encodedˉkind = Bytesˉfromˉu8(34u8); }
    if Kind == 35u32 { Encodedˉkind = Bytesˉfromˉu8(35u8); }
    if Kind == 36u32 { Encodedˉkind = Bytesˉfromˉu8(36u8); }
    if Kind == 37u32 { Encodedˉkind = Bytesˉfromˉu8(37u8); }
    if Kind == 38u32 { Encodedˉkind = Bytesˉfromˉu8(38u8); }
    return Bytesˉconcat(Encodedˉkind, Bytesˉfromˉu32ˉlittle(Nominal));
}

fn Hˉwriteˉpointerˉtypeˉisˉcontained(
    Pointerˉtypes: bytes,
    Nominal: u32
) -> bool {
    var Cursor: u32 = 0u32;
    while Cursor < Bytesˉlength(Pointerˉtypes) {
        if Bytesˉreadˉu32ˉlittle(Pointerˉtypes, Cursor) == Nominal {
            return true;
        }
        Cursor = Cursor + 4u32;
    }
    return false;
}

fn Hˉborrowedˉbudgetˉcallˉfollows(
    Input: bytes,
    Functionˉcode: u32,
    Functionˉcodeˉlength: u32,
    Start: u32
) -> bool {
    var Cursor: u32 = Start;
    var Loads: u32 = 0u32;
    while Cursor < Functionˉcodeˉlength {
        if Loads > 64u32 { return false; }
        let Opcode: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(
            Input, Functionˉcode + Cursor
        ));
        if Opcode == 64u32 { return true; }
        if Opcode != 4u32 || Cursor + 5u32 > Functionˉcodeˉlength {
            return false;
        }
        Cursor = Cursor + 5u32;
        Loads = Loads + 1u32;
    }
    return false;
}

fn Hˉwriteˉpointerˉforeignˉcallˉfollows(
    Input: bytes,
    Functionˉcode: u32,
    Functionˉcodeˉlength: u32,
    Start: u32,
    Pointerˉtype: u32
) -> bool {
    var Cursor: u32 = Start;
    var Loads: u32 = 0u32;
    while Cursor < Functionˉcodeˉlength {
        let Opcode: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(
            Input, Functionˉcode + Cursor
        ));
        if Opcode == 224u32 {
            return Loads == 2u32 && Cursor + 13u32 <= Functionˉcodeˉlength &&
                Bytesˉreadˉu32ˉlittle(
                    Input, Functionˉcode + Cursor + 5u32
                ) == Pointerˉtype;
        }
        if Loads >= 2u32 || Opcode != 4u32 ||
            Cursor + 5u32 > Functionˉcodeˉlength {
            return false;
        }
        Cursor = Cursor + 5u32;
        Loads = Loads + 1u32;
    }
    return false;
}

fn Hˉwriteˉpointerˉlocalˉoperation(
    Input: bytes,
    Functionˉcode: u32,
    Functionˉcodeˉlength: u32,
    Cursor: u32,
    Localˉshapes: bytes,
    Parameterˉcount: u32,
    Localˉcount: u32,
    Localˉindex: u32,
    Localˉnominal: u32,
    Stack: bytes,
    Depth: u32
) -> Hˉoperationˉstate {
    let Opcode: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(
        Input, Functionˉcode + Cursor
    ));
    if Opcode == 4u32 {
        if Cursor + 10u32 <= Functionˉcodeˉlength &&
            U32ˉfromˉu8(Bytesˉreadˉu8(
                Input, Functionˉcode + Cursor + 5u32
            )) == 5u32 {
            let Moveˉtarget: u32 = Bytesˉreadˉu32ˉlittle(
                Input, Functionˉcode + Cursor + 6u32
            );
            if Moveˉtarget >= Parameterˉcount + Localˉcount ||
                U32ˉfromˉu8(Bytesˉreadˉu8(
                    Localˉshapes, Moveˉtarget * 5u32
                )) != 7u32 || Bytesˉreadˉu32ˉlittle(
                    Localˉshapes, Moveˉtarget * 5u32 + 1u32
                ) != Localˉnominal {
                return Hˉoperationˉfailure(Stack, Depth);
            }
            return Hˉoperationˉstate(
                true, Stack, Depth, true, 38u32, Localˉnominal
            );
        }
        if Hˉwriteˉpointerˉforeignˉcallˉfollows(
                Input, Functionˉcode, Functionˉcodeˉlength,
                Cursor + 5u32, Localˉnominal
            ) {
            return Hˉoperationˉstate(
                true, Stack, Depth, true, 38u32, Localˉnominal
            );
        }
        return Hˉoperationˉfailure(Stack, Depth);
    }
    if Opcode != 5u32 || Localˉindex < Parameterˉcount || Depth == 0u32 {
        return Hˉoperationˉfailure(Stack, Depth);
    }
    let Actual: u32 = Bytesˉlength(Stack) - 5u32;
    if U32ˉfromˉu8(Bytesˉreadˉu8(Stack, Actual)) != 38u32 ||
        Bytesˉreadˉu32ˉlittle(Stack, Actual + 1u32) != Localˉnominal {
        return Hˉoperationˉfailure(Stack, Depth);
    }
    return Hˉoperationˉstate(
        true, Bytesˉslice(Stack, 0u32, Actual), Depth - 1u32,
        false, 0u32, 0u32
    );
}

fn Hˉlocalˉoperation(
    Input: bytes,
    Minor: u32,
    Functionˉcode: u32,
    Functionˉcodeˉlength: u32,
    Cursor: u32,
    Previousˉopcode: u32,
    Types: u32,
    Localˉshapes: bytes,
    Parameterˉcount: u32,
    Localˉcount: u32,
    Stack: bytes,
    Depth: u32
) -> Hˉoperationˉstate {
    let Opcode: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(
        Input, Functionˉcode + Cursor
    ));
    let Localˉindex: u32 = Bytesˉreadˉu32ˉlittle(
        Input, Functionˉcode + Cursor + 1u32
    );
    if Localˉindex >= Parameterˉcount + Localˉcount {
        return Hˉoperationˉfailure(Stack, Depth);
    }
    let Localˉshape: u32 = Localˉindex * 5u32;
    let Declaredˉlocalˉkind: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(
        Localˉshapes, Localˉshape
    ));
    let Localˉisˉborrowedˉaggregate: bool = Minor >= 28u32 && Minor <= 37u32 &&
        (Declaredˉlocalˉkind == 28u32 || Declaredˉlocalˉkind == 29u32 ||
            Declaredˉlocalˉkind == 30u32);
    var Borrowedˉaggregateˉisˉcall: bool = false;
    let Localˉisˉborrowedˉbudgetˉview: bool =
        (Minor == 34u32 || Minor == 35u32 || Minor == 36u32 ||
            Minor == 37u32) &&
        Declaredˉlocalˉkind == 36u32;
    var Localˉkind: u32 = Declaredˉlocalˉkind;
    if Declaredˉlocalˉkind == 28u32 { Localˉkind = 7u32; }
    if Declaredˉlocalˉkind == 29u32 { Localˉkind = 11u32; }
    if Declaredˉlocalˉkind == 30u32 { Localˉkind = 22u32; }
    let Localˉnominal: u32 = Bytesˉreadˉu32ˉlittle(
        Localˉshapes, Localˉshape + 1u32
    );
    let Typeˉcount: u32 = Bytesˉreadˉu32ˉlittle(Input, Types);
    if Opcode == 4u32 {
        if (Minor == 32u32 || Minor == 33u32 || Minor == 34u32 ||
            Minor == 35u32 || Minor == 36u32 || Minor == 37u32) &&
            Localˉkind == 7u32 &&
            (Hˉtaskˉscopeˉisˉexact(
                Input, Types, Typeˉcount, Localˉnominal
            ) || Hˉtaskˉhandleˉisˉexact(
                Input, Types, Typeˉcount, Localˉnominal
            )) {
            return Hˉoperationˉfailure(Stack, Depth);
        }
        if Localˉkind == 34u32 {
            return Hˉoperationˉfailure(Stack, Depth);
        }
        if Localˉkind == 25u32 {
            if (Minor != 34u32 && Minor != 35u32 && Minor != 36u32 &&
                Minor != 37u32) ||
                Cursor + 10u32 > Functionˉcodeˉlength ||
                U32ˉfromˉu8(Bytesˉreadˉu8(
                    Input, Functionˉcode + Cursor + 5u32
                )) != 5u32 {
                return Hˉoperationˉfailure(Stack, Depth);
            }
            let Viewˉlocal: u32 = Bytesˉreadˉu32ˉlittle(
                Input, Functionˉcode + Cursor + 6u32
            );
            if Viewˉlocal < Parameterˉcount ||
                Viewˉlocal >= Parameterˉcount + Localˉcount ||
                U32ˉfromˉu8(Bytesˉreadˉu8(
                    Localˉshapes, Viewˉlocal * 5u32
                )) != 36u32 {
                return Hˉoperationˉfailure(Stack, Depth);
            }
        }
        let Isˉownedˉaggregate: bool = !Localˉisˉborrowedˉaggregate &&
            Hˉownedˉaggregate(
            Input, Types, Typeˉcount,
            Localˉkind, Localˉnominal, Minor
        );
        if Isˉownedˉaggregate {
            if Cursor + 10u32 > Functionˉcodeˉlength ||
                U32ˉfromˉu8(Bytesˉreadˉu8(
                    Input, Functionˉcode + Cursor + 5u32
                )) != 5u32 {
                return Hˉoperationˉfailure(Stack, Depth);
            }
            let Borrowˉtarget: u32 = Bytesˉreadˉu32ˉlittle(
                Input, Functionˉcode + Cursor + 6u32
            );
            if Borrowˉtarget >= Parameterˉcount + Localˉcount {
                return Hˉoperationˉfailure(Stack, Depth);
            }
            let Borrowˉshape: u32 = Borrowˉtarget * 5u32;
            let Borrowˉkind: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(
                Localˉshapes, Borrowˉshape
            ));
            var Expectedˉborrowˉkind: u32 = 28u32;
            if Localˉkind == 11u32 { Expectedˉborrowˉkind = 29u32; }
            if Localˉkind == 22u32 { Expectedˉborrowˉkind = 30u32; }
            if Bytesˉreadˉu16ˉlittle(Input, 6u32) == 39u32 &&
                Borrowˉkind == Localˉkind + 64u32 {
                Expectedˉborrowˉkind = Borrowˉkind;
            }
            if Borrowˉtarget < Parameterˉcount ||
                Borrowˉkind != Expectedˉborrowˉkind ||
                Bytesˉreadˉu32ˉlittle(Localˉshapes, Borrowˉshape + 1u32) !=
                    Localˉnominal {
                return Hˉoperationˉfailure(Stack, Depth);
            }
        }
        if Localˉisˉborrowedˉaggregate {
            if Cursor < 5u32 || Previousˉopcode != 5u32 ||
                Bytesˉreadˉu32ˉlittle(
                    Input, Functionˉcode + Cursor - 4u32
                ) != Localˉindex || Cursor + 5u32 >= Functionˉcodeˉlength {
                return Hˉoperationˉfailure(Stack, Depth);
            }
            let Observer: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(
                Input, Functionˉcode + Cursor + 5u32
            ));
            Borrowedˉaggregateˉisˉcall = Observer == 64u32 &&
                Declaredˉlocalˉkind == 28u32 &&
                Hˉunsafeˉscratchˉisˉexact(
                    Input, Types, Typeˉcount, Localˉnominal
                );
            if !Borrowedˉaggregateˉisˉcall &&
                ((Localˉkind == 7u32 && Observer != 105u32) ||
                (Localˉkind == 11u32 && Observer != 152u32 &&
                    Observer != 196u32) ||
                (Localˉkind == 22u32 && Observer != 198u32)) {
                return Hˉoperationˉfailure(Stack, Depth);
            }
        }
        if Localˉisˉborrowedˉbudgetˉview {
            if Localˉindex < Parameterˉcount || Cursor < 5u32 ||
                Previousˉopcode != 5u32 || Bytesˉreadˉu32ˉlittle(
                    Input, Functionˉcode + Cursor - 4u32
                ) != Localˉindex || !Hˉborrowedˉbudgetˉcallˉfollows(
                    Input, Functionˉcode, Functionˉcodeˉlength, Cursor + 5u32
                ) {
                return Hˉoperationˉfailure(Stack, Depth);
            }
        }
        let Isˉaffineˉresult: bool = Localˉkind == 11u32 &&
            Hˉaffineˉresultˉtransferˉkind(
                Input, Types, Minor, Localˉkind, Localˉnominal
            ) != Localˉkind;
        if Isˉaffineˉresult {
            if Cursor + 5u32 >= Functionˉcodeˉlength ||
                U32ˉfromˉu8(Bytesˉreadˉu8(
                    Input, Functionˉcode + Cursor + 5u32
                )) != 152u32 {
                return Hˉoperationˉfailure(Stack, Depth);
            }
        }
        var Loadedˉkind: u32 = Localˉkind;
        if Borrowedˉaggregateˉisˉcall {
            Loadedˉkind = Declaredˉlocalˉkind;
        } else if Localˉkind == 26u32 || Localˉkind == 27u32 {
            Loadedˉkind = 23u32;
        } else if Localˉisˉborrowedˉbudgetˉview {
            Loadedˉkind = 25u32;
        } else if Minor >= 26u32 && Localˉkind == 23u32 &&
            Cursor + 5u32 < Functionˉcodeˉlength &&
            U32ˉfromˉu8(Bytesˉreadˉu8(
                Input, Functionˉcode + Cursor + 5u32
            )) == 5u32 {
            Loadedˉkind = 26u32;
        }
        return Hˉoperationˉstate(
            true, Stack, Depth, true, Loadedˉkind, Localˉnominal
        );
    }

    if Opcode == 205u32 {
        let Isˉtaskˉowner: bool = (Minor == 32u32 || Minor == 33u32 ||
            Minor == 34u32 || Minor == 35u32 || Minor == 36u32 ||
            Minor == 37u32) &&
            Localˉkind == 7u32 &&
            (Hˉtaskˉscopeˉisˉexact(
                Input, Types, Typeˉcount, Localˉnominal
            ) || Hˉtaskˉhandleˉisˉexact(
                Input, Types, Typeˉcount, Localˉnominal
            ));
        let Isˉsplitˉresult: bool = Minor >= 23u32 && Minor <= 37u32 &&
            Localˉkind == 11u32 && Hˉmemoryˉbudgetˉresultˉisˉexact(
                Input, Types, Typeˉcount, Localˉnominal
            );
        let Isˉvectorˉresult: bool = Minor >= 24u32 && Minor <= 37u32 &&
            Localˉkind == 11u32 && Hˉvectorˉresultˉisˉexact(
                Input, Types, Typeˉcount, Localˉnominal
            );
        let Isˉtaskˉresult: bool = (Minor == 32u32 || Minor == 33u32 ||
            Minor == 34u32 || Minor == 35u32 || Minor == 36u32 ||
            Minor == 37u32) &&
            Localˉkind == 11u32 && Hˉtaskˉaffineˉresultˉisˉexact(
                Input, Types, Typeˉcount, Localˉnominal
            );
        let Isˉunsafeˉscratchˉresult: bool =
            (Minor == 33u32 || Minor == 34u32 || Minor == 35u32 ||
                Minor == 36u32 || Minor == 37u32) &&
            Localˉkind == 11u32 && Hˉunsafeˉscratchˉresultˉisˉexact(
                Input, Types, Typeˉcount, Localˉnominal
            );
        let Isˉunsafeˉwriteˉregionˉresult: bool =
            (Minor == 36u32 || Minor == 37u32) &&
            Localˉkind == 11u32 &&
            Hˉunsafeˉwriteˉregionˉresultˉisˉexact(
                Input, Types, Typeˉcount, Localˉnominal
            );
        let Takeˉisˉownedˉaggregate: bool =
            !Localˉisˉborrowedˉaggregate && Hˉownedˉaggregate(
            Input, Types, Typeˉcount,
            Localˉkind, Localˉnominal, Minor
        );
        if Localˉkind != 23u32 && Localˉkind != 25u32 &&
            Localˉkind != 34u32 &&
            !Isˉsplitˉresult && !Isˉvectorˉresult && !Isˉtaskˉresult &&
            !Isˉunsafeˉscratchˉresult &&
            !Isˉunsafeˉwriteˉregionˉresult &&
            !Isˉtaskˉowner &&
            !Takeˉisˉownedˉaggregate {
            return Hˉoperationˉfailure(Stack, Depth);
        }
        if Localˉindex < Parameterˉcount && Localˉkind == 23u32 &&
            Minor < 26u32 {
            return Hˉoperationˉfailure(Stack, Depth);
        }
        var Takenˉpushˉkind: u32 = 26u32;
        if Localˉkind == 25u32 { Takenˉpushˉkind = 27u32; }
        if Localˉkind == 34u32 { Takenˉpushˉkind = 34u32; }
        if Isˉsplitˉresult { Takenˉpushˉkind = 28u32; }
        if Isˉvectorˉresult { Takenˉpushˉkind = 29u32; }
        if Isˉtaskˉresult { Takenˉpushˉkind = 32u32; }
        if Isˉunsafeˉscratchˉresult { Takenˉpushˉkind = 36u32; }
        if Isˉunsafeˉwriteˉregionˉresult {
            Takenˉpushˉkind = 37u32;
        }
        if Isˉtaskˉowner { Takenˉpushˉkind = 31u32; }
        if Takeˉisˉownedˉaggregate {
            Takenˉpushˉkind = Hˉownedˉtransferˉkind(Localˉkind);
        }
        return Hˉoperationˉstate(
            true, Stack, Depth, true, Takenˉpushˉkind, Localˉnominal
        );
    }

    if Opcode == 210u32 {
        if (Minor != 29u32 && Minor != 30u32 && Minor != 31u32 &&
                Minor != 32u32 && Minor != 33u32 && Minor != 34u32 &&
                Minor != 35u32 && Minor != 36u32 && Minor != 37u32) ||
            Localˉindex < Parameterˉcount ||
            Localˉkind != 34u32 {
            return Hˉoperationˉfailure(Stack, Depth);
        }
        return Hˉoperationˉstate(
            true, Stack, Depth, true, 10u32, 0u32
        );
    }

    if Opcode == 221u32 {
        let Abiˉtype: u32 = Bytesˉreadˉu32ˉlittle(
            Input, Functionˉcode + Cursor + 5u32
        );
        if (Minor != 35u32 && Minor != 36u32 && Minor != 37u32) ||
            Localˉkind != 7u32 ||
            Localˉnominal >= Typeˉcount || Abiˉtype >= Typeˉcount ||
            !Hˉunsafeˉscratchˉisˉexact(
                Input, Types, Typeˉcount, Localˉnominal
            ) {
            return Hˉoperationˉfailure(Stack, Depth);
        }
        let Abiˉkind: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(
            Input, Hˉtypeˉat(Input, Types, Abiˉtype)
        ));
        if Abiˉkind != 2u32 && Abiˉkind != 7u32 {
            return Hˉoperationˉfailure(Stack, Depth);
        }
        return Hˉoperationˉstate(
            true, Stack, Depth, true, 10u32, 0u32
        );
    }

    var Popˉcount: u32 = 1u32;
    var Firstˉkind: u32 = Localˉkind;
    var Firstˉnominal: u32 = Localˉnominal;
    var Secondˉkind: u32 = 0u32;
    var Pushˉresult: bool = false;
    var Pushˉkind: u32 = 0u32;
    var Pushˉnominal: u32 = 0u32;
    if Opcode == 5u32 {
        if Localˉindex < Parameterˉcount &&
            (Localˉkind == 26u32 || Localˉkind == 27u32 ||
                Localˉkind == 36u32) {
            return Hˉoperationˉfailure(Stack, Depth);
        }
        if Firstˉkind == 23u32 && Minor >= 20u32 { Firstˉkind = 26u32; }
        if Minor >= 23u32 && Minor <= 37u32 && Firstˉkind == 25u32 {
            Firstˉkind = 27u32;
        }
        if Minor >= 23u32 && Minor <= 37u32 && Firstˉkind == 11u32 &&
            Hˉmemoryˉbudgetˉresultˉisˉexact(
                Input, Types, Typeˉcount, Firstˉnominal
            ) { Firstˉkind = 28u32; }
        if Minor >= 24u32 && Minor <= 37u32 && Firstˉkind == 11u32 &&
            Hˉvectorˉresultˉisˉexact(
                Input, Types, Typeˉcount, Firstˉnominal
            ) { Firstˉkind = 29u32; }
        if (Minor == 32u32 || Minor == 33u32 || Minor == 34u32 ||
            Minor == 35u32 || Minor == 36u32 || Minor == 37u32) &&
            Firstˉkind == 11u32 &&
            Hˉtaskˉaffineˉresultˉisˉexact(
                Input, Types, Typeˉcount, Firstˉnominal
            ) { Firstˉkind = 32u32; }
        if (Minor == 33u32 || Minor == 34u32 || Minor == 35u32 ||
            Minor == 36u32 || Minor == 37u32) &&
            Firstˉkind == 11u32 &&
            Hˉunsafeˉscratchˉresultˉisˉexact(
                Input, Types, Typeˉcount, Firstˉnominal
            ) { Firstˉkind = 36u32; }
        if (Minor == 36u32 || Minor == 37u32) && Firstˉkind == 11u32 &&
            Hˉunsafeˉwriteˉregionˉresultˉisˉexact(
                Input, Types, Typeˉcount, Firstˉnominal
            ) { Firstˉkind = 37u32; }
        if !Localˉisˉborrowedˉaggregate && Hˉownedˉaggregate(
            Input, Types, Typeˉcount,
            Localˉkind, Localˉnominal, Minor
        ) {
            Firstˉkind = Hˉownedˉtransferˉkind(Localˉkind);
        }
        if Localˉisˉborrowedˉaggregate {
            if Cursor + 10u32 > Functionˉcodeˉlength ||
                U32ˉfromˉu8(Bytesˉreadˉu8(
                    Input, Functionˉcode + Cursor + 5u32
                )) != 4u32 || Bytesˉreadˉu32ˉlittle(
                    Input, Functionˉcode + Cursor + 6u32
                ) != Localˉindex {
                return Hˉoperationˉfailure(Stack, Depth);
            }
        }
        if Localˉisˉborrowedˉbudgetˉview {
            if Cursor < 5u32 || Previousˉopcode != 4u32 ||
                Cursor + 10u32 > Functionˉcodeˉlength ||
                U32ˉfromˉu8(Bytesˉreadˉu8(
                    Input, Functionˉcode + Cursor + 5u32
                )) != 4u32 || Bytesˉreadˉu32ˉlittle(
                    Input, Functionˉcode + Cursor + 6u32
                ) != Localˉindex {
                return Hˉoperationˉfailure(Stack, Depth);
            }
            let Borrowedˉowner: u32 = Bytesˉreadˉu32ˉlittle(
                Input, Functionˉcode + Cursor - 4u32
            );
            if Borrowedˉowner >= Parameterˉcount + Localˉcount ||
                U32ˉfromˉu8(Bytesˉreadˉu8(
                    Localˉshapes, Borrowedˉowner * 5u32
                )) != 25u32 {
                return Hˉoperationˉfailure(Stack, Depth);
            }
            Firstˉkind = 25u32;
        }
    } else if Opcode == 206u32 {
        let Resultˉtype: u32 = Bytesˉreadˉu32ˉlittle(
            Input, Functionˉcode + Cursor + 5u32
        );
        if (Minor < 23u32 || Minor > 37u32) || Localˉkind != 25u32 ||
            !Hˉmemoryˉbudgetˉresultˉisˉexact(
                Input, Types, Typeˉcount, Resultˉtype
            ) {
            return Hˉoperationˉfailure(Stack, Depth);
        }
        Popˉcount = 2u32;
        Firstˉkind = 5u32;
        Firstˉnominal = 0u32;
        Secondˉkind = 10u32;
        Pushˉresult = true;
        Pushˉkind = 28u32;
        Pushˉnominal = Resultˉtype;
    } else if Opcode == 207u32 {
        let Vectorˉresultˉtype: u32 = Bytesˉreadˉu32ˉlittle(
            Input, Functionˉcode + Cursor + 5u32
        );
        if (Minor < 24u32 || Minor > 37u32) || Localˉkind != 25u32 ||
            !Hˉvectorˉresultˉisˉexact(
                Input, Types, Typeˉcount, Vectorˉresultˉtype
            ) {
            return Hˉoperationˉfailure(Stack, Depth);
        }
        Popˉcount = 1u32;
        Firstˉkind = 10u32;
        Firstˉnominal = 0u32;
        Pushˉresult = true;
        Pushˉkind = 29u32;
        Pushˉnominal = Vectorˉresultˉtype;
    } else if Opcode == 208u32 {
        let Appendˉresultˉtype: u32 = Bytesˉreadˉu32ˉlittle(
            Input, Functionˉcode + Cursor + 5u32
        );
        if (Minor < 25u32 || Minor > 37u32) ||
            Localˉindex < Parameterˉcount ||
            Localˉkind != 23u32 ||
            !Hˉvectorˉappendˉresultˉisˉexact(
                Input, Types, Typeˉcount,
                Appendˉresultˉtype, Localˉnominal
            ) {
            return Hˉoperationˉfailure(Stack, Depth);
        }
        let Appendˉelement: bytes = Hˉcollectionˉdescriptor(
            Input, Types, Localˉnominal, 5u32
        );
        Popˉcount = 1u32;
        Firstˉkind = U32ˉfromˉu8(Bytesˉreadˉu8(Appendˉelement, 0u32));
        Firstˉnominal = Bytesˉreadˉu32ˉlittle(Appendˉelement, 1u32);
        Pushˉresult = true;
        Pushˉkind = 11u32;
        Pushˉnominal = Appendˉresultˉtype;
    } else if Opcode == 209u32 {
        let Growˉbudgetˉlocal: u32 = Bytesˉreadˉu32ˉlittle(
            Input, Functionˉcode + Cursor + 5u32
        );
        let Growˉresultˉtype: u32 = Bytesˉreadˉu32ˉlittle(
            Input, Functionˉcode + Cursor + 9u32
        );
        if (Minor < 27u32 || Minor > 37u32) ||
            Localˉindex < Parameterˉcount ||
            Localˉkind != 23u32 || Growˉbudgetˉlocal >=
                Parameterˉcount + Localˉcount ||
            Growˉbudgetˉlocal == Localˉindex || U32ˉfromˉu8(
                Bytesˉreadˉu8(
                    Localˉshapes, Growˉbudgetˉlocal * 5u32
                )
            ) != 25u32 ||
            !Hˉallocationˉunitˉresultˉisˉexact(
                Input, Types, Typeˉcount, Growˉresultˉtype
            ) {
            return Hˉoperationˉfailure(Stack, Depth);
        }
        Popˉcount = 1u32;
        Firstˉkind = 10u32;
        Firstˉnominal = 0u32;
        Pushˉresult = true;
        Pushˉkind = 11u32;
        Pushˉnominal = Growˉresultˉtype;
    } else {
        return Hˉoperationˉfailure(Stack, Depth);
    }

    var Resultˉstack: bytes = Stack;
    var Resultˉdepth: u32 = Depth;
    var Pop: u32 = 0u32;
    while Pop < Popˉcount {
        if Resultˉdepth == 0u32 {
            return Hˉoperationˉfailure(Resultˉstack, Resultˉdepth);
        }
        var Expectedˉkind: u32 = Firstˉkind;
        var Expectedˉnominal: u32 = Firstˉnominal;
        if Pop == 1u32 {
            Expectedˉkind = Secondˉkind;
            Expectedˉnominal = 0u32;
        }
        let Actual: u32 = Bytesˉlength(Resultˉstack) - 5u32;
        if !Hˉexactˉvalueˉmatches(Input, Types, Expectedˉkind, Expectedˉnominal,
            U32ˉfromˉu8(Bytesˉreadˉu8(Resultˉstack, Actual)),
            Bytesˉreadˉu32ˉlittle(Resultˉstack, Actual + 1u32)) {
            return Hˉoperationˉfailure(Resultˉstack, Resultˉdepth);
        }
        Resultˉstack = Bytesˉslice(Resultˉstack, 0u32, Actual);
        Resultˉdepth = Resultˉdepth - 1u32;
        Pop = Pop + 1u32;
    }
    return Hˉoperationˉstate(
        true,
        Resultˉstack,
        Resultˉdepth,
        Pushˉresult,
        Pushˉkind,
        Pushˉnominal
    );
}

fn Hˉfoundationˉlocal(Input: bytes, Types: u32, Functionˉcode: u32, Cursor: u32,
    Previousˉopcode: u32, Shapes: bytes, Parameters: u32, Slot: u32,
    Kind: u32, Nominal: u32, Stack: bytes, Depth: u32) -> Hˉoperationˉstate {
    let Opcode: u8 = Bytesˉreadˉu8(Input, Functionˉcode + Cursor);
    var Expected: u32 = Kind;
    if Kind == 29u32 { Expected = 139u32; }
    if Opcode == 4u8 {
        return Hˉoperationˉstate(true, Stack, Depth, true, Expected, Nominal);
    }
    if Opcode != 5u8 || Slot < Parameters || Depth == 0u32 {
        return Hˉoperationˉfailure(Stack, Depth);
    }
    let Top: u32 = Bytesˉlength(Stack) - 5u32;
    let Actual: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(Stack, Top));
    if Bytesˉreadˉu32ˉlittle(Stack, Top + 1u32) != Nominal {
        return Hˉoperationˉfailure(Stack, Depth);
    }
    if Actual != Expected {
        // A new local loan has a named source, not a constructed stack value.
        // Origin lifetime and writes between later uses belong to the loan pass.
        var Ownerˉmatches: bool = Actual + 64u32 == Expected;
        if Kind == 29u32 {
            // Shape 29 retains the older exact owned-Option view sequence.
            // Copy/shared Option views still require E1, not an ordinary load.
            Ownerˉmatches = Actual == 11u32 && Hˉownedˉaggregate(
                Input, Types, Bytesˉreadˉu32ˉlittle(Input, Types), 11u32, Nominal, 37u32);
        }
        if !Ownerˉmatches || Cursor < 5u32 ||
            Previousˉopcode != 4u32 { return Hˉoperationˉfailure(Stack, Depth); }
        let Owner: u32 = Bytesˉreadˉu32ˉlittle(Input, Functionˉcode + Cursor - 4u32);
        if Owner >= Bytesˉlength(Shapes) / 5u32 ||
            U32ˉfromˉu8(Bytesˉreadˉu8(Shapes, Owner * 5u32)) != Actual ||
            Bytesˉreadˉu32ˉlittle(Shapes, Owner * 5u32 + 1u32) != Nominal {
            return Hˉoperationˉfailure(Stack, Depth);
        }
    }
    return Hˉoperationˉstate(true, Bytesˉslice(Stack, 0u32, Top),
        Depth - 1u32, false, 0u32, 0u32);
}

fn Hˉlocalˉoperationˉdispatch(
    Input: bytes,
    Minor: u32,
    Functionˉcode: u32,
    Functionˉcodeˉlength: u32,
    Cursor: u32,
    Previousˉopcode: u32,
    Types: u32,
    Localˉshapes: bytes,
    Parameterˉcount: u32,
    Localˉcount: u32,
    Pointerˉtypes: bytes,
    Foundationˉtypes: bytes,
    Stack: bytes,
    Depth: u32
) -> Hˉoperationˉstate {
    let Localˉindex: u32 = Bytesˉreadˉu32ˉlittle(
        Input, Functionˉcode + Cursor + 1u32
    );
    if Bytesˉreadˉu16ˉlittle(Input, 6u32) == 39u32 &&
        Localˉindex < Parameterˉcount + Localˉcount {
        let Kind: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(Localˉshapes, Localˉindex * 5u32));
        let Nominal: u32 = Bytesˉreadˉu32ˉlittle(Localˉshapes, Localˉindex * 5u32 + 1u32);
        let Opcode: u8 = Bytesˉreadˉu8(Input, Functionˉcode + Cursor);
        if Opcode == 225u8 {
            let Option: u32 = Bytesˉreadˉu32ˉlittle(Input, Functionˉcode + Cursor + 5u32);
            if !Hˉfoundationˉborrowˉisˉvalid(Localˉshapes, Foundationˉtypes,
                Localˉindex, Option, Bytesˉreadˉu32ˉlittle(Input, Functionˉcode + Cursor + 9u32)) {
                return Hˉoperationˉfailure(Stack, Depth);
            }
            return Hˉoperationˉstate(true, Stack, Depth, true, 139u32, Option);
        }
        var View: bool = false;
        if Kind == 29u32 && Nominal < Bytesˉlength(Foundationˉtypes) / 11u32 {
            View = Bytesˉreadˉu8(Foundationˉtypes, Nominal * 11u32) == 1u8;
        }
        if Hˉborrowedˉvalue(Kind) || View {
            return Hˉfoundationˉlocal(Input, Types, Functionˉcode, Cursor,
                Previousˉopcode, Localˉshapes, Parameterˉcount, Localˉindex,
                Kind, Nominal, Stack, Depth);
        }
    }
    if Minor == 37u32 && Localˉindex < Parameterˉcount + Localˉcount &&
        U32ˉfromˉu8(Bytesˉreadˉu8(
            Localˉshapes, Localˉindex * 5u32
        )) == 7u32 {
        let Localˉnominal: u32 = Bytesˉreadˉu32ˉlittle(
            Localˉshapes, Localˉindex * 5u32 + 1u32
        );
        if Hˉwriteˉpointerˉtypeˉisˉcontained(
                Pointerˉtypes, Localˉnominal
            ) {
            return Hˉwriteˉpointerˉlocalˉoperation(
                Input, Functionˉcode, Functionˉcodeˉlength, Cursor,
                Localˉshapes, Parameterˉcount, Localˉcount,
                Localˉindex, Localˉnominal, Stack, Depth
            );
        }
    }
    return Hˉlocalˉoperation(
        Input, Minor, Functionˉcode, Functionˉcodeˉlength, Cursor,
        Previousˉopcode, Types, Localˉshapes,
        Parameterˉcount, Localˉcount, Stack, Depth
    );
}

fn Hˉfixedˉinstructionˉwidth(Opcode: u32) -> u32 {
    if Opcode == 2u32 || Opcode == 8u32 { return 2u32; }
    if Opcode == 1u32 || (Opcode >= 3u32 && Opcode <= 7u32) ||
        Opcode == 9u32 || Opcode == 10u32 ||
        Opcode == 48u32 || Opcode == 49u32 ||
        Opcode == 64u32 || Opcode == 65u32 ||
        Opcode == 104u32 || Opcode == 105u32 || Opcode == 197u32 ||
        Opcode == 199u32 || Opcode == 200u32 ||
        (Opcode >= 202u32 && Opcode <= 205u32) || Opcode == 210u32 ||
        Opcode == 212u32 {
        return 5u32;
    }
    if Opcode == 106u32 || Opcode == 128u32 || Opcode == 129u32 ||
        (Opcode >= 151u32 && Opcode <= 153u32) || Opcode == 196u32 ||
        Opcode == 201u32 || Opcode == 206u32 || Opcode == 207u32 ||
        Opcode == 208u32 || Opcode == 211u32 || Opcode == 221u32 {
        return 9u32;
    }
    if Opcode == 209u32 || Opcode == 213u32 || Opcode == 216u32 ||
        Opcode == 217u32 || Opcode == 220u32 || Opcode == 222u32 ||
        Opcode == 223u32 || Opcode == 224u32 || Opcode == 225u32 {
        return 13u32;
    }
    if Opcode == 214u32 || Opcode == 215u32 || Opcode == 218u32 {
        return 9u32;
    }
    if Opcode == 219u32 { return 6u32; }
    return 1u32;
}

fn Hˉinstructionˉwidth(
    Input: bytes,
    Functionˉcode: u32,
    Cursor: u32,
    Opcode: u32
) -> u32 {
    var Width: u32 = Hˉfixedˉinstructionˉwidth(Opcode);
    if Opcode == 192u32 {
        Width = 3u32;
        if U32ˉfromˉu8(Bytesˉreadˉu8(
            Input, Functionˉcode + Cursor + 2u32
        )) == 0u32 { Width = 5u32; }
    }
    if Opcode == 193u32 {
        Width = 2u32;
        if U32ˉfromˉu8(Bytesˉreadˉu8(
            Input, Functionˉcode + Cursor + 1u32
        )) == 0u32 { Width = 6u32; }
    }
    if Opcode == 194u32 {
        Width = 3u32;
        if U32ˉfromˉu8(Bytesˉreadˉu8(
            Input, Functionˉcode + Cursor + 2u32
        )) == 0u32 {
            Width = 7u32;
            if U32ˉfromˉu8(Bytesˉreadˉu8(
                Input, Functionˉcode + Cursor + 1u32
            )) == 19u32 { Width = 11u32; }
        }
    }
    return Width;
}

fn Hˉfunctionˉwriteˉpointerˉtypes(
    Input: bytes,
    Functionˉcode: u32,
    Functionˉcodeˉlength: u32
) -> bytes {
    var Types: bytes = Bytesˉslice(Input, 0u32, 0u32);
    var Cursor: u32 = 0u32;
    while Cursor < Functionˉcodeˉlength {
        let Opcode: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(
            Input, Functionˉcode + Cursor
        ));
        let Width: u32 = Hˉinstructionˉwidth(
            Input, Functionˉcode, Cursor, Opcode
        );
        if Width == 0u32 || Width > Functionˉcodeˉlength - Cursor {
            return Bytesˉslice(Input, 0u32, 1u32);
        }
        if Opcode == 223u32 || Opcode == 224u32 {
            let Pointerˉtype: u32 = Bytesˉreadˉu32ˉlittle(
                Input, Functionˉcode + Cursor + 5u32
            );
            if !Hˉwriteˉpointerˉtypeˉisˉcontained(
                    Types, Pointerˉtype
                ) {
                if Bytesˉlength(Types) >= 1024u32 {
                    return Bytesˉslice(Input, 0u32, 1u32);
                }
                Types = Bytesˉconcat(
                    Types, Bytesˉfromˉu32ˉlittle(Pointerˉtype)
                );
            }
        }
        Cursor = Cursor + Width;
    }
    return Types;
}

fn Hˉreturnˉoperation(
    Input: bytes,
    Types: u32,
    Minor: u32,
    Returnˉtype: u32,
    Stack: bytes,
    Depth: u32
) -> Hˉoperationˉstate {
    var Resultˉstack: bytes = Stack;
    var Resultˉdepth: u32 = Depth;
    var Expectedˉkind: u32 = U32ˉfromˉu8(
        Bytesˉreadˉu8(Input, Returnˉtype)
    );
    if Expectedˉkind == 21u32 {
        return Hˉoperationˉfailure(Resultˉstack, Resultˉdepth);
    }
    var Expectedˉnominal: u32 = 0u32;
    if Expectedˉkind == 7u32 || Expectedˉkind == 8u32 ||
        Expectedˉkind == 11u32 || Expectedˉkind == 22u32 ||
        Expectedˉkind == 23u32 || Expectedˉkind == 24u32 || Expectedˉkind == 35u32 {
        Expectedˉnominal = Bytesˉreadˉu32ˉlittle(Input, Returnˉtype + 1u32);
    }
    if Minor >= 20u32 && Expectedˉkind == 23u32 {
        Expectedˉkind = 26u32;
    }
    Expectedˉkind = Hˉaffineˉresultˉtransferˉkind(
        Input, Types, Minor, Expectedˉkind, Expectedˉnominal
    );
    if Expectedˉkind == 37u32 {
        return Hˉoperationˉfailure(Resultˉstack, Resultˉdepth);
    }
    if Hˉownedˉaggregate(
        Input, Types, Bytesˉreadˉu32ˉlittle(Input, Types),
        Expectedˉkind, Expectedˉnominal, Minor
    ) {
        Expectedˉkind = Hˉownedˉtransferˉkind(Expectedˉkind);
    }
    if Expectedˉkind != 0u32 {
        if Resultˉdepth == 0u32 {
            return Hˉoperationˉfailure(Resultˉstack, Resultˉdepth);
        }
        let Actualˉoffset: u32 = Bytesˉlength(Resultˉstack) - 5u32;
        if !Hˉexactˉvalueˉmatches(Input, Types, Expectedˉkind, Expectedˉnominal,
            U32ˉfromˉu8(Bytesˉreadˉu8(Resultˉstack, Actualˉoffset)),
            Bytesˉreadˉu32ˉlittle(Resultˉstack, Actualˉoffset + 1u32)) {
            return Hˉoperationˉfailure(Resultˉstack, Resultˉdepth);
        }
        Resultˉstack = Bytesˉslice(Resultˉstack, 0u32, Actualˉoffset);
        Resultˉdepth = Resultˉdepth - 1u32;
    }
    if Resultˉdepth != 0u32 {
        return Hˉoperationˉfailure(Resultˉstack, Resultˉdepth);
    }
    return Hˉoperationˉstate(
        true, Resultˉstack, Resultˉdepth, false, 0u32, 0u32
    );
}

fn Hˉfunctionˉentryˉread(Input: bytes, Start: u32, Limit: u32,
    Types: u32, Minor: u32) -> Hˉfunctionˉentry {
    let Invalid: Hˉfunctionˉentry = Hˉfunctionˉentry(
        0u32, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32);
    if Limit > Bytesˉlength(Input) || Start > Limit || Limit - Start < 4u32 {
        return Invalid;
    }
    let Nameˉlength: u32 = Bytesˉreadˉu32ˉlittle(Input, Start);
    var Cursor: u32 = Start + 4u32;
    if Nameˉlength > Limit - Cursor { return Invalid; }
    Cursor = Cursor + Nameˉlength;
    if Limit - Cursor < 4u32 { return Invalid; }
    let Parameters: u32 = Bytesˉreadˉu32ˉlittle(Input, Cursor);
    if Parameters > 4096u32 { return Invalid; }
    Cursor = Cursor + 4u32;
    let Parameterˉtypes: u32 = Cursor;
    var Returnˉtype: u32 = 0u32;
    var Locals: u32 = 0u32;
    var Localˉtypes: u32 = 0u32;
    var Stage: u32 = 0u32;
    var Count: u32 = Parameters;
    while Stage < 3u32 {
        var Index: u32 = 0u32;
        while Index < Count {
            if Cursor >= Limit { return Invalid; }
            let Width: u32 = Hˉshapeˉwidth(Input, Cursor);
            if Width == 0u32 || Width > Limit - Cursor { return Invalid; }
            let Kind: u8 = Bytesˉreadˉu8(Input, Cursor);
            if Stage < 2u32 && (Minor == 36u32 || Minor == 37u32) &&
                Kind == 11u8 && Hˉunsafeˉwriteˉregionˉresultˉisˉexact(
                    Input, Types, Bytesˉreadˉu32ˉlittle(Input, Types),
                    Bytesˉreadˉu32ˉlittle(Input, Cursor + 1u32)) { return Invalid; }
            if Stage == 1u32 && Kind == 37u8 { return Invalid; }
            Cursor = Cursor + Width;
            Index = Index + 1u32;
        }
        Stage = Stage + 1u32;
        if Stage == 1u32 { Returnˉtype = Cursor; Count = 1u32; }
        if Stage == 2u32 {
            if Limit - Cursor < 4u32 { return Invalid; }
            Locals = Bytesˉreadˉu32ˉlittle(Input, Cursor);
            if Locals > 4096u32 { return Invalid; }
            Cursor = Cursor + 4u32;
            Localˉtypes = Cursor;
            Count = Locals;
        }
    }
    if Limit - Cursor < 12u32 { return Invalid; }
    return Hˉfunctionˉentry(Cursor + 12u32, Parameters, Parameterˉtypes,
        Returnˉtype, Locals, Localˉtypes, Bytesˉreadˉu32ˉlittle(Input, Cursor),
        Bytesˉreadˉu32ˉlittle(Input, Cursor + 4u32),
        Bytesˉreadˉu32ˉlittle(Input, Cursor + 8u32));
}

fn Hˉneedsˉloanˉflow(Input: bytes, Code: u32, Length: u32, Shapes: bytes) -> bool {
    if Bytesˉreadˉu16ˉlittle(Input, 6u32) != 39u32 { return false; }
    var Slot: u32 = 0u32;
    while Slot < Bytesˉlength(Shapes) / 5u32 {
        let Kind: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(Shapes, Slot * 5u32));
        if Kind >= 64u32 || Kind == 29u32 { return true; }
        Slot = Slot + 1u32;
    }
    var Cursor: u32 = 0u32;
    while Cursor < Length {
        let Opcode: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(Input, Code + Cursor));
        if Opcode == 225u32 { return true; }
        let Width: u32 = Hˉinstructionˉwidth(Input, Code, Cursor, Opcode);
        if Width == 0u32 || Width > Length - Cursor { return true; }
        Cursor = Cursor + Width;
    }
    return false;
}

export fn Hˉexecutable(Input: bytes) -> bytes {
    let Invalid: bytes = Bytesˉslice(Input, 0u32, 0u32);
    let Total: u32 = Bytesˉlength(Input);
    let Minor: u32 = Hˉeffectiveˉminor(Input);
    var Envelope: u32 = 12u32;
    var Sectionˉkind: u32 = 1u32;
    var Payload: u32 = 0u32;
    var Payloadˉlength: u32 = 0u32;
    var Capabilities: u32 = 0u32;
    var Functions: u32 = 0u32;
    var Functionsˉend: u32 = 0u32;
    var Code: u32 = 0u32;
    var Codeˉlength: u32 = 0u32;
    var Types: u32 = 0u32;
    var Typesˉend: u32 = 0u32;
    while Sectionˉkind <= 7u32 {
        Payload = Envelope + 8u32;
        Payloadˉlength = Bytesˉreadˉu32ˉlittle(Input, Envelope + 4u32);
        if Sectionˉkind == 2u32 { Capabilities = Payload; }
        if Sectionˉkind == 4u32 {
            Functions = Payload;
            Functionsˉend = Payload + Payloadˉlength;
        }
        if Sectionˉkind == 5u32 {
            Code = Payload;
            Codeˉlength = Payloadˉlength;
        }
        if Sectionˉkind == 7u32 {
            Types = Payload;
            Typesˉend = Payload + Payloadˉlength;
        }
        Envelope = Payload + Payloadˉlength;
        Sectionˉkind = Sectionˉkind + 1u32;
    }

    let Functionˉcount: u32 = Bytesˉreadˉu32ˉlittle(Input, Functions);
    if Functionˉcount > 4096u32 { return Invalid; }
    if Codeˉlength > 4194304u32 { return Invalid; }
    var Foundationˉtypes: bytes = Invalid;
    if Bytesˉreadˉu16ˉlittle(Input, 6u32) == 39u32 {
        Foundationˉtypes = Hˉfoundationˉtypes(Input, Types, Bytesˉreadˉu32ˉlittle(Input, Types));
    }
    var Functionˉindex: u32 = 0u32;
    var Functionˉcursor: u32 = Functions + 4u32;
    var Aggregateˉinstructions: u32 = 0u32;
    var Loanˉwork: u32 = 16777216u32;
    while Functionˉindex < Functionˉcount {
        let Entry: Hˉfunctionˉentry = Hˉfunctionˉentryˉread(
            Input, Functionˉcursor, Functionsˉend, Types, Minor);
        if Entry.Next == 0u32 { return Invalid; }
        let Parameterˉcount: u32 = Entry.Parameters;
        let Parameterˉtypes: u32 = Entry.Parameterˉtypes;
        let Returnˉtype: u32 = Entry.Returnˉtype;
        let Localˉcount: u32 = Entry.Locals;
        let Localˉtypes: u32 = Entry.Localˉtypes;
        let Functionˉcodeˉoffset: u32 = Entry.Codeˉoffset;
        let Functionˉcodeˉlength: u32 = Entry.Codeˉlength;
        let Declaredˉmaximum: u32 = Entry.Maximum;
        Functionˉcursor = Entry.Next;
        if Declaredˉmaximum > 4096u32 { return Invalid; }

        let Localˉshapes: bytes = Typedˉdirectories.Hˉlocalˉshapes(
            Input,
            Parameterˉtypes,
            Parameterˉcount,
            Localˉtypes,
            Localˉcount
        );
        if Bytesˉlength(Localˉshapes) !=
            (Parameterˉcount + Localˉcount) * 5u32 {
            return Invalid;
        }

        let Functionˉcode: u32 = Code + Functionˉcodeˉoffset;
        let Pointerˉtypes: bytes = Hˉfunctionˉwriteˉpointerˉtypes(
            Input, Functionˉcode, Functionˉcodeˉlength
        );
        if Bytesˉlength(Pointerˉtypes) % 4u32 != 0u32 {
            return Invalid;
        }
        var Cursor: u32 = 0u32;
        var Previousˉopcode: u32 = 0u32;
        var Stack: bytes = Bytesˉslice(Input, 0u32, 0u32);
        var Taskˉsignatures: bytes = Bytesˉslice(Input, 0u32, 0u32);
        var Depth: u32 = 0u32;
        var Maximum: u32 = 0u32;
        let Trackˉloans: bool = Hˉneedsˉloanˉflow(Input, Functionˉcode,
            Functionˉcodeˉlength, Localˉshapes);
        var Loans: Foundationˉowners.Loanˉtrace = Foundationˉowners.Loanˉbegin(
            Invalid, 0u32, 0u32, Loanˉwork);
        if Trackˉloans {
            Loans = Foundationˉowners.Loanˉbegin(Localˉshapes,
                Parameterˉcount, Declaredˉmaximum, Loanˉwork);
            if !Loans.Valid { return Invalid; }
        }
        while Cursor < Functionˉcodeˉlength {
            let Beforeˉstack: bytes = Stack;
            let Opcode: u32 = U32ˉfromˉu8(
                Bytesˉreadˉu8(Input, Functionˉcode + Cursor)
            );
            let Width: u32 = Hˉinstructionˉwidth(
                Input, Functionˉcode, Cursor, Opcode
            );
            Aggregateˉinstructions = Aggregateˉinstructions + 1u32;
            if Aggregateˉinstructions > 400000u32 { return Invalid; }

            var Popˉcount: u32 = 0u32;
            var Firstˉkind: u32 = 0u32;
            var Firstˉnominal: u32 = 0u32;
            var Secondˉkind: u32 = 0u32;
            var Secondˉnominal: u32 = 0u32;
            var Thirdˉkind: u32 = 0u32;
            var Thirdˉnominal: u32 = 0u32;
            var Hasˉpush: bool = false;
            var Pushˉkind: u32 = 0u32;
            var Pushˉnominal: u32 = 0u32;
            var Handled: bool = false;

            if Opcode == 1u32 { Hasˉpush = true; Pushˉkind = 1u32; Handled = true; }
            if Opcode == 2u32 { Hasˉpush = true; Pushˉkind = 2u32; Handled = true; }
            if Opcode == 3u32 { Hasˉpush = true; Pushˉkind = 3u32; Handled = true; }
            if Opcode == 6u32 { Hasˉpush = true; Pushˉkind = 1u32; Handled = true; }
            if Opcode == 8u32 { Hasˉpush = true; Pushˉkind = 4u32; Handled = true; }
            if Opcode == 9u32 { Hasˉpush = true; Pushˉkind = 5u32; Handled = true; }
            if Opcode == 10u32 { Hasˉpush = true; Pushˉkind = 6u32; Handled = true; }
            if Opcode == 128u32 { Hasˉpush = true; Pushˉkind = 9u32; Handled = true; }
            if Opcode == 129u32 { Hasˉpush = true; Pushˉkind = 10u32; Handled = true; }
            if Opcode == 192u32 {
                let Fixedˉkind: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(
                    Input, Functionˉcode + Cursor + 1u32
                ));
                let Fixedˉoperation: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(
                    Input, Functionˉcode + Cursor + 2u32
                ));
                if Fixedˉoperation == 0u32 {
                    Hasˉpush = true;
                    Pushˉkind = Fixedˉkind;
                }
                if Fixedˉoperation >= 1u32 && Fixedˉoperation <= 5u32 {
                    Popˉcount = 2u32;
                    Firstˉkind = Fixedˉkind;
                    Secondˉkind = Fixedˉkind;
                    Hasˉpush = true;
                    Pushˉkind = Fixedˉkind;
                }
                if Fixedˉoperation == 6u32 {
                    Popˉcount = 1u32;
                    Firstˉkind = Fixedˉkind;
                    Hasˉpush = true;
                    Pushˉkind = Fixedˉkind;
                }
                if Fixedˉoperation >= 7u32 && Fixedˉoperation <= 12u32 {
                    Popˉcount = 2u32;
                    Firstˉkind = Fixedˉkind;
                    Secondˉkind = Fixedˉkind;
                    Hasˉpush = true;
                    Pushˉkind = 2u32;
                }
                if Fixedˉoperation >= 13u32 && Fixedˉoperation <= 15u32 {
                    Popˉcount = 2u32;
                    Firstˉkind = 16u32;
                    Secondˉkind = 16u32;
                    Hasˉpush = true;
                    Pushˉkind = 16u32;
                }
                if Fixedˉoperation == 16u32 {
                    Popˉcount = 1u32;
                    Firstˉkind = 16u32;
                    Hasˉpush = true;
                    Pushˉkind = 16u32;
                }
                if Fixedˉoperation == 17u32 || Fixedˉoperation == 18u32 {
                    Popˉcount = 2u32;
                    Firstˉkind = 5u32;
                    Secondˉkind = 16u32;
                    Hasˉpush = true;
                    Pushˉkind = 16u32;
                }
                Handled = true;
            }
            if Opcode == 195u32 {
                Hasˉpush = true;
                Pushˉkind = 20u32;
                Handled = true;
            }
            if Opcode == 193u32 {
                let Runeˉoperation: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(
                    Input, Functionˉcode + Cursor + 1u32
                ));
                if Runeˉoperation == 0u32 {
                    Hasˉpush = true;
                    Pushˉkind = 17u32;
                } else {
                    Popˉcount = 2u32;
                    Firstˉkind = 17u32;
                    Secondˉkind = 17u32;
                    Hasˉpush = true;
                    Pushˉkind = 2u32;
                }
                Handled = true;
            }
            if Opcode == 194u32 {
                let Floatingˉkind: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(
                    Input, Functionˉcode + Cursor + 1u32
                ));
                let Floatingˉoperation: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(
                    Input, Functionˉcode + Cursor + 2u32
                ));
                if Floatingˉoperation == 0u32 {
                    Hasˉpush = true;
                    Pushˉkind = Floatingˉkind;
                }
                if Floatingˉoperation >= 1u32 &&
                    Floatingˉoperation <= 4u32 {
                    Popˉcount = 2u32;
                    Firstˉkind = Floatingˉkind;
                    Secondˉkind = Floatingˉkind;
                    Hasˉpush = true;
                    Pushˉkind = Floatingˉkind;
                }
                if Floatingˉoperation == 5u32 {
                    Popˉcount = 1u32;
                    Firstˉkind = Floatingˉkind;
                    Hasˉpush = true;
                    Pushˉkind = Floatingˉkind;
                }
                if Floatingˉoperation >= 6u32 {
                    Popˉcount = 2u32;
                    Firstˉkind = Floatingˉkind;
                    Secondˉkind = Floatingˉkind;
                    Hasˉpush = true;
                    Pushˉkind = 2u32;
                }
                Handled = true;
            }

            if Opcode == 4u32 || Opcode == 5u32 ||
                Opcode == 205u32 || Opcode == 206u32 || Opcode == 207u32 ||
                Opcode == 208u32 || Opcode == 209u32 || Opcode == 210u32 ||
                Opcode == 221u32 || Opcode == 225u32 {
                let Localˉstate: Hˉoperationˉstate =
                    Hˉlocalˉoperationˉdispatch(
                    Input,
                    Minor,
                    Functionˉcode,
                    Functionˉcodeˉlength,
                    Cursor,
                    Previousˉopcode,
                    Types,
                    Localˉshapes,
                    Parameterˉcount,
                    Localˉcount,
                    Pointerˉtypes,
                    Foundationˉtypes,
                    Stack,
                    Depth
                );
                if !Localˉstate.Valid { return Invalid; }
                Stack = Localˉstate.Stack;
                Depth = Localˉstate.Depth;
                Hasˉpush = Localˉstate.Hasˉpush;
                Pushˉkind = Localˉstate.Pushˉkind;
                Pushˉnominal = Localˉstate.Pushˉnominal;
                Handled = true;
            }
            if Opcode == 7u32 { Popˉcount = 1u32; Firstˉkind = 1u32; Hasˉpush = true; Pushˉkind = 1u32; Handled = true; }
            if Opcode == 11u32 { Popˉcount = 1u32; Firstˉkind = 6u32; Hasˉpush = true; Pushˉkind = 5u32; Handled = true; }
            if Opcode == 12u32 { Popˉcount = 3u32; Firstˉkind = 5u32; Secondˉkind = 5u32; Thirdˉkind = 6u32; Hasˉpush = true; Pushˉkind = 6u32; Handled = true; }
            if Opcode == 13u32 { Popˉcount = 2u32; Firstˉkind = 5u32; Secondˉkind = 6u32; Hasˉpush = true; Pushˉkind = 4u32; Handled = true; }
            if Opcode == 14u32 { Popˉcount = 2u32; Firstˉkind = 5u32; Secondˉkind = 6u32; Hasˉpush = true; Pushˉkind = 5u32; Handled = true; }
            if Opcode == 15u32 { Popˉcount = 2u32; Firstˉkind = 5u32; Secondˉkind = 6u32; Hasˉpush = true; Pushˉkind = 5u32; Handled = true; }
            if Opcode == 114u32 { Popˉcount = 2u32; Firstˉkind = 5u32; Secondˉkind = 6u32; Hasˉpush = true; Pushˉkind = 1u32; Handled = true; }

            if Opcode >= 16u32 {
                if Opcode <= 18u32 { Popˉcount = 2u32; Firstˉkind = 1u32; Secondˉkind = 1u32; Hasˉpush = true; Pushˉkind = 1u32; Handled = true; }
            }
            if Opcode == 19u32 { Popˉcount = 1u32; Firstˉkind = 1u32; Hasˉpush = true; Pushˉkind = 1u32; Handled = true; }
            if Opcode >= 20u32 {
                if Opcode <= 22u32 { Popˉcount = 2u32; Firstˉkind = 5u32; Secondˉkind = 5u32; Hasˉpush = true; Pushˉkind = 5u32; Handled = true; }
            }
            if Opcode >= 159u32 {
                if Opcode <= 160u32 { Popˉcount = 2u32; Firstˉkind = 1u32; Secondˉkind = 1u32; Hasˉpush = true; Pushˉkind = 1u32; Handled = true; }
            }
            if Opcode >= 161u32 {
                if Opcode <= 162u32 { Popˉcount = 2u32; Firstˉkind = 5u32; Secondˉkind = 5u32; Hasˉpush = true; Pushˉkind = 5u32; Handled = true; }
            }
            if Opcode >= 163u32 {
                if Opcode <= 164u32 { Popˉcount = 2u32; Firstˉkind = 9u32; Secondˉkind = 9u32; Hasˉpush = true; Pushˉkind = 9u32; Handled = true; }
            }
            if Opcode >= 165u32 {
                if Opcode <= 166u32 { Popˉcount = 2u32; Firstˉkind = 10u32; Secondˉkind = 10u32; Hasˉpush = true; Pushˉkind = 10u32; Handled = true; }
            }
            if Opcode >= 167u32 {
                if Opcode <= 169u32 { Popˉcount = 2u32; Firstˉkind = 4u32; Secondˉkind = 4u32; Hasˉpush = true; Pushˉkind = 4u32; Handled = true; }
            }
            if Opcode == 170u32 { Popˉcount = 1u32; Firstˉkind = 4u32; Hasˉpush = true; Pushˉkind = 4u32; Handled = true; }
            if Opcode == 171u32 || Opcode == 172u32 { Popˉcount = 2u32; Firstˉkind = 5u32; Secondˉkind = 4u32; Hasˉpush = true; Pushˉkind = 4u32; Handled = true; }
            if Opcode >= 173u32 {
                if Opcode <= 175u32 { Popˉcount = 2u32; Firstˉkind = 5u32; Secondˉkind = 5u32; Hasˉpush = true; Pushˉkind = 5u32; Handled = true; }
            }
            if Opcode == 176u32 { Popˉcount = 1u32; Firstˉkind = 5u32; Hasˉpush = true; Pushˉkind = 5u32; Handled = true; }
            if Opcode >= 177u32 {
                if Opcode <= 178u32 { Popˉcount = 2u32; Firstˉkind = 5u32; Secondˉkind = 5u32; Hasˉpush = true; Pushˉkind = 5u32; Handled = true; }
            }
            if Opcode >= 179u32 {
                if Opcode <= 181u32 { Popˉcount = 2u32; Firstˉkind = 10u32; Secondˉkind = 10u32; Hasˉpush = true; Pushˉkind = 10u32; Handled = true; }
            }
            if Opcode == 182u32 { Popˉcount = 1u32; Firstˉkind = 10u32; Hasˉpush = true; Pushˉkind = 10u32; Handled = true; }
            if Opcode == 183u32 || Opcode == 184u32 { Popˉcount = 2u32; Firstˉkind = 5u32; Secondˉkind = 10u32; Hasˉpush = true; Pushˉkind = 10u32; Handled = true; }
            if Opcode == 185u32 || Opcode == 186u32 { Popˉcount = 2u32; Firstˉkind = 3u32; Secondˉkind = 3u32; Hasˉpush = true; Pushˉkind = 2u32; Handled = true; }
            if Opcode == 187u32 || Opcode == 188u32 { Popˉcount = 2u32; Firstˉkind = 6u32; Secondˉkind = 6u32; Hasˉpush = true; Pushˉkind = 2u32; Handled = true; }
            if Opcode == 189u32 { Popˉcount = 2u32; Firstˉkind = 5u32; Secondˉkind = 6u32; Hasˉpush = true; Pushˉkind = 10u32; Handled = true; }
            if Opcode == 190u32 { Popˉcount = 1u32; Firstˉkind = 10u32; Hasˉpush = true; Pushˉkind = 6u32; Handled = true; }
            if Opcode == 191u32 { Popˉcount = 1u32; Firstˉkind = 5u32; Hasˉpush = true; Pushˉkind = 10u32; Handled = true; }
            if Opcode >= 32u32 {
                if Opcode <= 37u32 { Popˉcount = 2u32; Firstˉkind = 1u32; Secondˉkind = 1u32; Hasˉpush = true; Pushˉkind = 2u32; Handled = true; }
            }
            if Opcode >= 38u32 {
                if Opcode <= 39u32 { Popˉcount = 2u32; Firstˉkind = 2u32; Secondˉkind = 2u32; Hasˉpush = true; Pushˉkind = 2u32; Handled = true; }
            }
            if Opcode == 40u32 { Popˉcount = 1u32; Firstˉkind = 2u32; Hasˉpush = true; Pushˉkind = 2u32; Handled = true; }
            if Opcode >= 96u32 {
                if Opcode <= 101u32 { Popˉcount = 2u32; Firstˉkind = 5u32; Secondˉkind = 5u32; Hasˉpush = true; Pushˉkind = 2u32; Handled = true; }
            }
            if Opcode >= 102u32 {
                if Opcode <= 103u32 { Popˉcount = 2u32; Firstˉkind = 4u32; Secondˉkind = 4u32; Hasˉpush = true; Pushˉkind = 2u32; Handled = true; }
            }
            if Opcode >= 130u32 {
                if Opcode <= 132u32 { Popˉcount = 2u32; Firstˉkind = 9u32; Secondˉkind = 9u32; Hasˉpush = true; Pushˉkind = 9u32; Handled = true; }
            }
            if Opcode == 133u32 { Popˉcount = 1u32; Firstˉkind = 9u32; Hasˉpush = true; Pushˉkind = 9u32; Handled = true; }
            if Opcode >= 134u32 {
                if Opcode <= 136u32 { Popˉcount = 2u32; Firstˉkind = 10u32; Secondˉkind = 10u32; Hasˉpush = true; Pushˉkind = 10u32; Handled = true; }
            }
            if Opcode >= 137u32 {
                if Opcode <= 142u32 { Popˉcount = 2u32; Firstˉkind = 9u32; Secondˉkind = 9u32; Hasˉpush = true; Pushˉkind = 2u32; Handled = true; }
            }
            if Opcode >= 143u32 {
                if Opcode <= 148u32 { Popˉcount = 2u32; Firstˉkind = 10u32; Secondˉkind = 10u32; Hasˉpush = true; Pushˉkind = 2u32; Handled = true; }
            }

            if Opcode == 110u32 { Popˉcount = 1u32; Firstˉkind = 1u32; Hasˉpush = true; Pushˉkind = 3u32; Handled = true; }
            if Opcode == 111u32 { Popˉcount = 1u32; Firstˉkind = 4u32; Hasˉpush = true; Pushˉkind = 3u32; Handled = true; }
            if Opcode == 112u32 { Popˉcount = 1u32; Firstˉkind = 5u32; Hasˉpush = true; Pushˉkind = 3u32; Handled = true; }
            if Opcode == 113u32 { Popˉcount = 2u32; Firstˉkind = 3u32; Secondˉkind = 3u32; Hasˉpush = true; Pushˉkind = 3u32; Handled = true; }
            if Opcode == 115u32 { Popˉcount = 1u32; Firstˉkind = 6u32; Hasˉpush = true; Pushˉkind = 2u32; Handled = true; }
            if Opcode == 116u32 { Popˉcount = 1u32; Firstˉkind = 6u32; Hasˉpush = true; Pushˉkind = 3u32; Handled = true; }
            if Opcode == 117u32 { Popˉcount = 1u32; Firstˉkind = 3u32; Hasˉpush = true; Pushˉkind = 3u32; Handled = true; }
            if Opcode == 118u32 { Popˉcount = 1u32; Firstˉkind = 4u32; Hasˉpush = true; Pushˉkind = 5u32; Handled = true; }
            if Opcode == 119u32 { Popˉcount = 2u32; Firstˉkind = 6u32; Secondˉkind = 6u32; Hasˉpush = true; Pushˉkind = 6u32; Handled = true; }
            if Opcode == 120u32 { Popˉcount = 1u32; Firstˉkind = 4u32; Hasˉpush = true; Pushˉkind = 6u32; Handled = true; }
            if Opcode == 121u32 { Popˉcount = 1u32; Firstˉkind = 5u32; Hasˉpush = true; Pushˉkind = 6u32; Handled = true; }
            if Opcode == 122u32 { Popˉcount = 1u32; Firstˉkind = 5u32; Hasˉpush = true; Pushˉkind = 6u32; Handled = true; }
            if Opcode == 123u32 { Popˉcount = 1u32; Firstˉkind = 1u32; Hasˉpush = true; Pushˉkind = 6u32; Handled = true; }
            if Opcode == 124u32 { Popˉcount = 1u32; Firstˉkind = 3u32; Hasˉpush = true; Pushˉkind = 6u32; Handled = true; }
            if Opcode == 125u32 { Popˉcount = 1u32; Firstˉkind = 6u32; Hasˉpush = true; Pushˉkind = 3u32; Handled = true; }
            if Opcode == 149u32 { Popˉcount = 1u32; Firstˉkind = 9u32; Hasˉpush = true; Pushˉkind = 3u32; Handled = true; }
            if Opcode == 150u32 { Popˉcount = 1u32; Firstˉkind = 10u32; Hasˉpush = true; Pushˉkind = 3u32; Handled = true; }

            if Opcode == 106u32 {
                Pushˉkind = 8u32;
                Pushˉnominal = Bytesˉreadˉu32ˉlittle(
                    Input,
                    Functionˉcode + Cursor + 1u32
                );
                Hasˉpush = true;
                Handled = true;
            }
            if Opcode == 107u32 {
                if Depth < 2u32 { return Invalid; }
                let Rightˉoffset: u32 = Bytesˉlength(Stack) - 5u32;
                let Rightˉkind: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(Stack, Rightˉoffset));
                let Rightˉnominal: u32 = Bytesˉreadˉu32ˉlittle(Stack, Rightˉoffset + 1u32);
                if !Hˉvalueˉmatches(Input, Types, 8u32, Rightˉkind, Rightˉnominal) { return Invalid; }
                Stack = Bytesˉslice(Stack, 0u32, Rightˉoffset);
                Depth = Depth - 1u32;
                let Leftˉoffset: u32 = Bytesˉlength(Stack) - 5u32;
                if !Hˉexactˉvalueˉmatches(Input, Types, 8u32, Rightˉnominal,
                    U32ˉfromˉu8(Bytesˉreadˉu8(Stack, Leftˉoffset)),
                    Bytesˉreadˉu32ˉlittle(Stack, Leftˉoffset + 1u32)) { return Invalid; }
                Stack = Bytesˉslice(Stack, 0u32, Leftˉoffset);
                Depth = Depth - 1u32;
                Hasˉpush = true;
                Pushˉkind = 2u32;
                Handled = true;
            }
            if Opcode == 108u32 {
                if Depth < 2u32 { return Invalid; }
                let Unequalˉrightˉoffset: u32 = Bytesˉlength(Stack) - 5u32;
                let Unequalˉrightˉkind: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(Stack, Unequalˉrightˉoffset));
                let Unequalˉrightˉnominal: u32 = Bytesˉreadˉu32ˉlittle(Stack, Unequalˉrightˉoffset + 1u32);
                if !Hˉvalueˉmatches(Input, Types, 8u32, Unequalˉrightˉkind, Unequalˉrightˉnominal) { return Invalid; }
                Stack = Bytesˉslice(Stack, 0u32, Unequalˉrightˉoffset);
                Depth = Depth - 1u32;
                let Unequalˉleftˉoffset: u32 = Bytesˉlength(Stack) - 5u32;
                if !Hˉexactˉvalueˉmatches(Input, Types, 8u32, Unequalˉrightˉnominal,
                    U32ˉfromˉu8(Bytesˉreadˉu8(Stack, Unequalˉleftˉoffset)),
                    Bytesˉreadˉu32ˉlittle(Stack, Unequalˉleftˉoffset + 1u32)) { return Invalid; }
                Stack = Bytesˉslice(Stack, 0u32, Unequalˉleftˉoffset);
                Depth = Depth - 1u32;
                Hasˉpush = true;
                Pushˉkind = 2u32;
                Handled = true;
            }
            if Opcode == 109u32 {
                if Depth == 0u32 { return Invalid; }
                let Sourceˉoffset: u32 = Bytesˉlength(Stack) - 5u32;
                if !Hˉvalueˉmatches(Input, Types, 8u32,
                    U32ˉfromˉu8(Bytesˉreadˉu8(Stack, Sourceˉoffset)),
                    Bytesˉreadˉu32ˉlittle(Stack, Sourceˉoffset + 1u32)) { return Invalid; }
                Stack = Bytesˉslice(Stack, 0u32, Sourceˉoffset);
                Depth = Depth - 1u32;
                Hasˉpush = true;
                Pushˉkind = 3u32;
                Handled = true;
            }

            if Opcode >= 151u32 && Opcode <= 153u32 {
                let Variantˉstate: Hˉoperationˉstate = Hˉvariant(
                    Input,
                    Minor,
                    Functionˉcode,
                    Cursor,
                    Types,
                    Stack,
                    Depth
                );
                if !Variantˉstate.Valid { return Invalid; }
                Stack = Variantˉstate.Stack;
                Depth = Variantˉstate.Depth;
                Hasˉpush = Variantˉstate.Hasˉpush;
                Pushˉkind = Variantˉstate.Pushˉkind;
                Pushˉnominal = Variantˉstate.Pushˉnominal;
                Handled = true;
            }
            if Opcode == 196u32 {
                let Variantˉfieldˉstate: Hˉoperationˉstate = Hˉvariantˉfield(
                    Input,
                    Minor,
                    Functionˉcode,
                    Cursor,
                    Types,
                    Stack,
                    Depth
                );
                if !Variantˉfieldˉstate.Valid { return Invalid; }
                Stack = Variantˉfieldˉstate.Stack;
                Depth = Variantˉfieldˉstate.Depth;
                Hasˉpush = Variantˉfieldˉstate.Hasˉpush;
                Pushˉkind = Variantˉfieldˉstate.Pushˉkind;
                Pushˉnominal = Variantˉfieldˉstate.Pushˉnominal;
                Handled = true;
            }
            if Opcode >= 197u32 && Opcode <= 204u32 {
                let Arrayˉstate: Hˉoperationˉstate = Hˉcollectionˉorˉarray(
                    Input,
                    Minor,
                    Functionˉcode,
                    Cursor,
                    Types,
                    Stack,
                    Depth
                );
                if !Arrayˉstate.Valid { return Invalid; }
                Stack = Arrayˉstate.Stack;
                Depth = Arrayˉstate.Depth;
                Hasˉpush = Arrayˉstate.Hasˉpush;
                Pushˉkind = Arrayˉstate.Pushˉkind;
                Pushˉnominal = Arrayˉstate.Pushˉnominal;
                Handled = true;
            }

            if Opcode == 104u32 || Opcode == 105u32 {
                let Recordˉstate: Hˉoperationˉstate = Hˉrecord(
                    Input,
                    Functionˉcode,
                    Cursor,
                    Types,
                    Stack,
                    Depth
                );
                if !Recordˉstate.Valid { return Invalid; }
                Stack = Recordˉstate.Stack;
                Depth = Recordˉstate.Depth;
                Hasˉpush = Recordˉstate.Hasˉpush;
                Pushˉkind = Recordˉstate.Pushˉkind;
                Pushˉnominal = Recordˉstate.Pushˉnominal;
                Handled = true;
            }

            if Opcode == 211u32 {
                Hasˉpush = true;
                Pushˉkind = 35u32;
                Pushˉnominal = Bytesˉreadˉu32ˉlittle(
                    Input, Functionˉcode + Cursor + 5u32
                );
                Handled = true;
            }

            if Opcode == 212u32 || Opcode == 213u32 {
                let Indirectˉstate: Hˉoperationˉstate = Hˉcallableˉoperation(
                    Input, Minor, Functionˉcode, Cursor, Functions, Types,
                    Stack, Depth
                );
                if !Indirectˉstate.Valid { return Invalid; }
                Stack = Indirectˉstate.Stack;
                Depth = Indirectˉstate.Depth;
                Hasˉpush = Indirectˉstate.Hasˉpush;
                Pushˉkind = Indirectˉstate.Pushˉkind;
                Pushˉnominal = Indirectˉstate.Pushˉnominal;
                Handled = true;
            }

            if Opcode >= 214u32 && Opcode <= 219u32 {
                let Signatureˉstate: Hˉtaskˉsignatureˉstate =
                    Hˉtaskˉsignature(
                        Input, Functionˉcode, Cursor, Types, Localˉshapes,
                        Parameterˉcount + Localˉcount, Stack, Depth, Opcode,
                        Taskˉsignatures
                    );
                if !Signatureˉstate.Valid { return Invalid; }
                Taskˉsignatures = Signatureˉstate.Signatures;
                let Taskˉstate: Hˉoperationˉstate = Hˉtaskˉoperation(
                    Input, Functionˉcode, Cursor, Types, Localˉshapes,
                    Parameterˉcount + Localˉcount, Stack, Depth
                );
                if !Taskˉstate.Valid { return Invalid; }
                Stack = Taskˉstate.Stack;
                Depth = Taskˉstate.Depth;
                Hasˉpush = Taskˉstate.Hasˉpush;
                Pushˉkind = Taskˉstate.Pushˉkind;
                Pushˉnominal = Taskˉstate.Pushˉnominal;
                Handled = true;
            }

            if Opcode == 220u32 ||
                (Opcode >= 222u32 && Opcode <= 224u32) {
                let Systemˉstate: Hˉoperationˉstate = Hˉsystemˉoperation(
                    Input, Minor, Functionˉcode, Cursor, Types,
                    Localˉshapes, Parameterˉcount + Localˉcount,
                    Parameterˉcount, Stack, Depth, Opcode
                );
                if !Systemˉstate.Valid { return Invalid; }
                Stack = Systemˉstate.Stack;
                Depth = Systemˉstate.Depth;
                Hasˉpush = Systemˉstate.Hasˉpush;
                Pushˉkind = Systemˉstate.Pushˉkind;
                Pushˉnominal = Systemˉstate.Pushˉnominal;
                Handled = true;
            }

            if Opcode == 64u32 {
                let Callˉstate: Hˉoperationˉstate = Hˉcall(
                    Input,
                    Minor,
                    Functionˉcode,
                    Cursor,
                    Functions,
                    Types,
                    Stack,
                    Depth
                );
                if !Callˉstate.Valid { return Invalid; }
                Stack = Callˉstate.Stack;
                Depth = Callˉstate.Depth;
                Hasˉpush = Callˉstate.Hasˉpush;
                Pushˉkind = Callˉstate.Pushˉkind;
                Pushˉnominal = Callˉstate.Pushˉnominal;
                if Minor >= 20u32 && Pushˉkind == 23u32 {
                    Pushˉkind = 26u32;
                }
                Handled = true;
            }

            if Opcode == 65u32 {
                let Capabilityˉstate: Hˉoperationˉstate = Hˉcapability(
                    Input,
                    Functionˉcode,
                    Cursor,
                    Capabilities,
                    Types,
                    Stack,
                    Depth
                );
                if !Capabilityˉstate.Valid { return Invalid; }
                Stack = Capabilityˉstate.Stack;
                Depth = Capabilityˉstate.Depth;
                Hasˉpush = Capabilityˉstate.Hasˉpush;
                Pushˉkind = Capabilityˉstate.Pushˉkind;
                Pushˉnominal = Capabilityˉstate.Pushˉnominal;
                Handled = true;
            }

            if Opcode == 48u32 {
                if Depth != 0u32 { return Invalid; }
                Handled = true;
            }
            if Opcode == 49u32 {
                Popˉcount = 1u32;
                Firstˉkind = 2u32;
                Handled = true;
            }
            if Opcode == 80u32 {
                if Depth == 0u32 { return Invalid; }
                Stack = Bytesˉslice(Stack, 0u32, Bytesˉlength(Stack) - 5u32);
                Depth = Depth - 1u32;
                Handled = true;
            }
            if Opcode == 81u32 {
                let Returnˉstate: Hˉoperationˉstate = Hˉreturnˉoperation(
                    Input, Types, Minor, Returnˉtype, Stack, Depth
                );
                if !Returnˉstate.Valid { return Invalid; }
                Stack = Returnˉstate.Stack;
                Depth = Returnˉstate.Depth;
                Handled = true;
            }

            var Popˉindex: u32 = 0u32;
            while Popˉindex < Popˉcount {
                if Depth == 0u32 { return Invalid; }
                var Popˉexpectedˉkind: u32 = Firstˉkind;
                var Popˉexpectedˉnominal: u32 = Firstˉnominal;
                if Popˉindex == 1u32 {
                    Popˉexpectedˉkind = Secondˉkind;
                    Popˉexpectedˉnominal = Secondˉnominal;
                }
                if Popˉindex == 2u32 {
                    Popˉexpectedˉkind = Thirdˉkind;
                    Popˉexpectedˉnominal = Thirdˉnominal;
                }
                let Popˉactualˉoffset: u32 = Bytesˉlength(Stack) - 5u32;
                if !Hˉexactˉvalueˉmatches(Input, Types, Popˉexpectedˉkind, Popˉexpectedˉnominal,
                    U32ˉfromˉu8(Bytesˉreadˉu8(Stack, Popˉactualˉoffset)),
                    Bytesˉreadˉu32ˉlittle(Stack, Popˉactualˉoffset + 1u32)) { return Invalid; }
                Stack = Bytesˉslice(Stack, 0u32, Popˉactualˉoffset);
                Depth = Depth - 1u32;
                Popˉindex = Popˉindex + 1u32;
            }
            if Opcode == 49u32 {
                if Depth != 0u32 { return Invalid; }
            }

            if Trackˉloans {
                Loans = Foundationˉowners.Loanˉobserve(Loans, Input,
                    Functionˉcode, Cursor, Previousˉopcode, Beforeˉstack,
                    Depth, Hasˉpush, Pushˉkind);
                if !Loans.Valid { return Invalid; }
            }
            if Hasˉpush {
                let Encodedˉshape: bytes = Hˉencodedˉshape(
                    Pushˉkind, Pushˉnominal
                );
                Stack = Bytesˉconcat(Stack, Encodedˉshape);
                Depth = Depth + 1u32;
                if Depth > 4096u32 { return Invalid; }
                if Depth > Maximum { Maximum = Depth; }
            }
            if Handled {
                Handled = true;
            } else {
                return Invalid;
            }

            Previousˉopcode = Opcode;
            Cursor = Cursor + Width;
        }
        if Previousˉopcode != 48u32 {
            if Previousˉopcode != 49u32 {
                if Previousˉopcode != 81u32 { return Invalid; }
            }
        }
        if Depth != 0u32 { return Invalid; }
        if Maximum != Declaredˉmaximum { return Invalid; }
        if Trackˉloans {
            let Loanˉcontrol: Typedˉdirectories.Hˉcontrolˉdirectory =
                Typedˉdirectories.Iˉcontrolˉdirectory(Input,
                    Functionˉcode, Functionˉcodeˉlength);
            let Lifetime: Foundationˉowners.Flowˉresult = Foundationˉowners.Loanˉcheck(
                Input, Functionˉcode, Functionˉcodeˉlength, Parameterˉcount,
                Loanˉcontrol, Loans);
            if !Lifetime.Valid { return Invalid; }
            Loanˉwork = Loanˉwork - Lifetime.Work;
        }
        Functionˉindex = Functionˉindex + 1u32;
    }
    if Functionˉcursor != Functionsˉend { return Invalid; }
    if Typesˉend > Total { return Invalid; }
    return Input;
}

fn Iˉownedˉcontrolˉisˉvalid(
    Input: bytes,
    Minor: u32,
    Types: u32,
    Functionˉcode: u32,
    Functionˉcodeˉlength: u32,
    Localˉslots: u32,
    Parameterˉcount: u32,
    Localˉshapes: bytes
) -> bool {
    let Pointerˉtypes: bytes = Hˉfunctionˉwriteˉpointerˉtypes(
        Input, Functionˉcode, Functionˉcodeˉlength
    );
    if Bytesˉlength(Pointerˉtypes) % 4u32 != 0u32 { return false; }
    var Ownedˉvectorˉcount: u32 = 0u32;
    var Ownedˉavailableˉlow: u32 = 0u32;
    var Ownedˉavailableˉhigh: u32 = 0u32;
    var Ownedˉslot: u32 = 0u32;
    while Ownedˉslot < Localˉslots {
        if Iˉtrackedˉownedˉlocalˉshape(
            Input, Types, Bytesˉreadˉu32ˉlittle(Input, Types),
            Localˉshapes, Ownedˉslot, Minor, Pointerˉtypes
        ) {
            if Ownedˉvectorˉcount >= 64u32 { return false; }
            if (Minor == 32u32 || Minor == 33u32 || Minor == 34u32 ||
                Minor == 35u32 || Minor == 36u32 || Minor == 37u32) &&
                Ownedˉslot < Parameterˉcount {
                let Parameterˉkind: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(
                    Localˉshapes, Ownedˉslot * 5u32
                ));
                let Parameterˉnominal: u32 = Bytesˉreadˉu32ˉlittle(
                    Localˉshapes, Ownedˉslot * 5u32 + 1u32
                );
                if (Parameterˉkind == 7u32 &&
                        (Hˉtaskˉscopeˉisˉexact(
                            Input, Types,
                            Bytesˉreadˉu32ˉlittle(Input, Types),
                            Parameterˉnominal
                        ) || Hˉtaskˉhandleˉisˉexact(
                            Input, Types,
                            Bytesˉreadˉu32ˉlittle(Input, Types),
                            Parameterˉnominal
                        ))) || (Parameterˉkind == 11u32 &&
                        Hˉtaskˉaffineˉresultˉisˉexact(
                            Input, Types,
                            Bytesˉreadˉu32ˉlittle(Input, Types),
                            Parameterˉnominal
                        )) {
                    return false;
                }
            }
            if Ownedˉslot < Parameterˉcount {
                if Ownedˉvectorˉcount < 32u32 {
                    Ownedˉavailableˉlow = Ownedˉavailableˉlow |
                        (1u32 << Ownedˉvectorˉcount);
                } else {
                    Ownedˉavailableˉhigh = Ownedˉavailableˉhigh |
                        (1u32 << (Ownedˉvectorˉcount - 32u32));
                }
            }
            Ownedˉvectorˉcount = Ownedˉvectorˉcount + 1u32;
        }
        Ownedˉslot = Ownedˉslot + 1u32;
    }

    var Ownedˉbranches: bytes = Bytesˉslice(Input, 0u32, 0u32);
    var Ownedˉentries: bytes = Bytesˉslice(Input, 0u32, 0u32);
    var Ownedˉcursor: u32 = 0u32;
    var Ownedˉreachable: bool = true;
    while Ownedˉcursor < Functionˉcodeˉlength {
        var Ownedˉbranch: u32 = 0u32;
        while Ownedˉbranch < Bytesˉlength(Ownedˉbranches) {
            if Bytesˉreadˉu32ˉlittle(
                Ownedˉbranches, Ownedˉbranch
            ) == Ownedˉcursor {
                let Ownedˉbranchˉlow: u32 = Bytesˉreadˉu32ˉlittle(
                    Ownedˉbranches, Ownedˉbranch + 4u32
                );
                let Ownedˉbranchˉhigh: u32 = Bytesˉreadˉu32ˉlittle(
                    Ownedˉbranches, Ownedˉbranch + 8u32
                );
                if Ownedˉreachable {
                    Ownedˉavailableˉlow = Ownedˉavailableˉlow &
                        Ownedˉbranchˉlow;
                    Ownedˉavailableˉhigh = Ownedˉavailableˉhigh &
                        Ownedˉbranchˉhigh;
                } else {
                    Ownedˉavailableˉlow = Ownedˉbranchˉlow;
                    Ownedˉavailableˉhigh = Ownedˉbranchˉhigh;
                    Ownedˉreachable = true;
                }
            }
            Ownedˉbranch = Ownedˉbranch + 12u32;
        }
        if !Ownedˉreachable { return false; }

        Ownedˉentries = Bytesˉconcat(
            Ownedˉentries,
            Bytesˉconcat(
                Bytesˉfromˉu32ˉlittle(Ownedˉcursor),
                Bytesˉconcat(
                    Bytesˉfromˉu32ˉlittle(Ownedˉavailableˉlow),
                    Bytesˉfromˉu32ˉlittle(Ownedˉavailableˉhigh)
                )
            )
        );

        let Ownedˉopcode: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(
            Input, Functionˉcode + Ownedˉcursor
        ));
        let Ownedˉwidth: u32 = Hˉinstructionˉwidth(
            Input, Functionˉcode, Ownedˉcursor, Ownedˉopcode
        );

        if Ownedˉopcode == 4u32 || Ownedˉopcode == 5u32 ||
            Ownedˉopcode == 205u32 || Ownedˉopcode == 210u32 ||
            Ownedˉopcode == 221u32 || Ownedˉopcode == 222u32 ||
            Ownedˉopcode == 223u32 {
            let Ownedˉlocal: u32 = Bytesˉreadˉu32ˉlittle(
                Input, Functionˉcode + Ownedˉcursor + 1u32
            );
            var Ownedˉrank: u32 = 4294967295u32;
            if Ownedˉlocal < Localˉslots && Iˉtrackedˉownedˉlocalˉshape(
                Input, Types, Bytesˉreadˉu32ˉlittle(Input, Types),
                Localˉshapes, Ownedˉlocal, Minor, Pointerˉtypes
            ) {
                Ownedˉrank = 0u32;
                var Ownedˉearlier: u32 = 0u32;
                while Ownedˉearlier < Ownedˉlocal {
                    if Iˉtrackedˉownedˉlocalˉshape(
                        Input, Types,
                        Bytesˉreadˉu32ˉlittle(Input, Types),
                        Localˉshapes, Ownedˉearlier, Minor, Pointerˉtypes
                    ) { Ownedˉrank = Ownedˉrank + 1u32; }
                    Ownedˉearlier = Ownedˉearlier + 1u32;
                }
            }
            if Ownedˉrank != 4294967295u32 {
                if Ownedˉopcode == 4u32 || Ownedˉopcode == 205u32 ||
                    Ownedˉopcode == 210u32 || Ownedˉopcode == 221u32 ||
                    Ownedˉopcode == 222u32 || Ownedˉopcode == 223u32 {
                    var Ownedˉavailable: bool = false;
                    if Ownedˉrank < 32u32 {
                        Ownedˉavailable = ((Ownedˉavailableˉlow >>
                            Ownedˉrank) & 1u32) == 1u32;
                    } else {
                        Ownedˉavailable = ((Ownedˉavailableˉhigh >>
                            (Ownedˉrank - 32u32)) & 1u32) == 1u32;
                    }
                    if !Ownedˉavailable { return false; }
                }
                if Ownedˉopcode == 5u32 {
                    let Ownedˉstoredˉkind: u32 = U32ˉfromˉu8(
                        Bytesˉreadˉu8(Localˉshapes, Ownedˉlocal * 5u32)
                    );
                    var Ownedˉalreadyˉavailable: bool = false;
                    if Ownedˉrank < 32u32 {
                        Ownedˉalreadyˉavailable =
                            ((Ownedˉavailableˉlow >> Ownedˉrank) & 1u32)
                                == 1u32;
                    } else {
                        Ownedˉalreadyˉavailable =
                            ((Ownedˉavailableˉhigh >>
                                (Ownedˉrank - 32u32)) & 1u32) == 1u32;
                    }
                    if Ownedˉstoredˉkind != 23u32 &&
                        Ownedˉalreadyˉavailable {
                        return false;
                    }
                    if Ownedˉrank < 32u32 {
                        Ownedˉavailableˉlow = Ownedˉavailableˉlow |
                            (1u32 << Ownedˉrank);
                    } else {
                        Ownedˉavailableˉhigh = Ownedˉavailableˉhigh |
                            (1u32 << (Ownedˉrank - 32u32));
                    }
                }
                if Ownedˉopcode == 205u32 || Ownedˉopcode == 222u32 {
                    if Ownedˉrank < 32u32 {
                        Ownedˉavailableˉlow = Ownedˉavailableˉlow &
                            ~(1u32 << Ownedˉrank);
                    } else {
                        Ownedˉavailableˉhigh = Ownedˉavailableˉhigh &
                            ~(1u32 << (Ownedˉrank - 32u32));
                    }
                }
                if Ownedˉopcode == 4u32 &&
                    Hˉwriteˉpointerˉtypeˉisˉcontained(
                        Pointerˉtypes,
                        Bytesˉreadˉu32ˉlittle(
                            Localˉshapes, Ownedˉlocal * 5u32 + 1u32
                        )
                    ) {
                    if Ownedˉrank < 32u32 {
                        Ownedˉavailableˉlow = Ownedˉavailableˉlow &
                            ~(1u32 << Ownedˉrank);
                    } else {
                        Ownedˉavailableˉhigh = Ownedˉavailableˉhigh &
                            ~(1u32 << (Ownedˉrank - 32u32));
                    }
                }
            }
        }
        if Ownedˉopcode == 206u32 || Ownedˉopcode == 207u32 ||
            Ownedˉopcode == 208u32 || Ownedˉopcode == 209u32 {
            let Ownedˉparent: u32 = Bytesˉreadˉu32ˉlittle(
                Input, Functionˉcode + Ownedˉcursor + 1u32
            );
            var Ownedˉparentˉkind: u32 = 25u32;
            if Ownedˉopcode == 208u32 || Ownedˉopcode == 209u32 {
                Ownedˉparentˉkind = 23u32;
            }
            if Ownedˉparent >= Localˉslots ||
                !Iˉtrackedˉownedˉlocalˉshape(
                Input, Types, Bytesˉreadˉu32ˉlittle(Input, Types),
                Localˉshapes, Ownedˉparent, Minor, Pointerˉtypes
            ) || U32ˉfromˉu8(Bytesˉreadˉu8(
                Localˉshapes, Ownedˉparent * 5u32
            )) != Ownedˉparentˉkind { return false; }
            var Ownedˉparentˉrank: u32 = 0u32;
            var Ownedˉparentˉearlier: u32 = 0u32;
            while Ownedˉparentˉearlier < Ownedˉparent {
                if Iˉtrackedˉownedˉlocalˉshape(
                    Input, Types, Bytesˉreadˉu32ˉlittle(Input, Types),
                    Localˉshapes, Ownedˉparentˉearlier, Minor,
                    Pointerˉtypes
                ) { Ownedˉparentˉrank = Ownedˉparentˉrank + 1u32; }
                Ownedˉparentˉearlier = Ownedˉparentˉearlier + 1u32;
            }
            var Ownedˉparentˉavailable: bool = false;
            if Ownedˉparentˉrank < 32u32 {
                Ownedˉparentˉavailable = ((Ownedˉavailableˉlow >>
                    Ownedˉparentˉrank) & 1u32) == 1u32;
            } else {
                Ownedˉparentˉavailable = ((Ownedˉavailableˉhigh >>
                    (Ownedˉparentˉrank - 32u32)) & 1u32) == 1u32;
            }
            if !Ownedˉparentˉavailable { return false; }
            if Ownedˉopcode == 207u32 {
                if Ownedˉparentˉrank < 32u32 {
                    Ownedˉavailableˉlow = Ownedˉavailableˉlow &
                        ~(1u32 << Ownedˉparentˉrank);
                } else {
                    Ownedˉavailableˉhigh = Ownedˉavailableˉhigh &
                        ~(1u32 << (Ownedˉparentˉrank - 32u32));
                }
            }
        }
        if Ownedˉopcode == 209u32 {
            let Ownedˉbudget: u32 = Bytesˉreadˉu32ˉlittle(
                Input, Functionˉcode + Ownedˉcursor + 5u32
            );
            if Ownedˉbudget >= Localˉslots || U32ˉfromˉu8(
                    Bytesˉreadˉu8(
                        Localˉshapes, Ownedˉbudget * 5u32
                    )
                ) != 25u32 {
                return false;
            }
            var Ownedˉbudgetˉrank: u32 = 0u32;
            var Ownedˉbudgetˉearlier: u32 = 0u32;
            while Ownedˉbudgetˉearlier < Ownedˉbudget {
                if Iˉtrackedˉownedˉlocalˉshape(
                    Input, Types, Bytesˉreadˉu32ˉlittle(Input, Types),
                    Localˉshapes, Ownedˉbudgetˉearlier, Minor,
                    Pointerˉtypes
                ) {
                    Ownedˉbudgetˉrank = Ownedˉbudgetˉrank + 1u32;
                }
                Ownedˉbudgetˉearlier = Ownedˉbudgetˉearlier + 1u32;
            }
            var Ownedˉbudgetˉavailable: bool = false;
            if Ownedˉbudgetˉrank < 32u32 {
                Ownedˉbudgetˉavailable = ((Ownedˉavailableˉlow >>
                    Ownedˉbudgetˉrank) & 1u32) == 1u32;
            } else {
                Ownedˉbudgetˉavailable = ((Ownedˉavailableˉhigh >>
                    (Ownedˉbudgetˉrank - 32u32)) & 1u32) == 1u32;
            }
            if !Ownedˉbudgetˉavailable { return false; }
        }
        if Ownedˉopcode == 220u32 {
            let Ownedˉscratchˉbudget: u32 = Bytesˉreadˉu32ˉlittle(
                Input, Functionˉcode + Ownedˉcursor + 1u32
            );
            if Ownedˉscratchˉbudget >= Localˉslots || U32ˉfromˉu8(
                    Bytesˉreadˉu8(
                        Localˉshapes, Ownedˉscratchˉbudget * 5u32
                    )
                ) != 25u32 {
                return false;
            }
            let Ownedˉscratchˉbudgetˉrank: u32 = Iˉownedˉlocalˉrank(
                Input, Types, Bytesˉreadˉu32ˉlittle(Input, Types),
                Localˉshapes, Ownedˉscratchˉbudget, Minor, Pointerˉtypes
            );
            if !Iˉownedˉrankˉisˉavailable(
                    Ownedˉavailableˉlow, Ownedˉavailableˉhigh,
                    Ownedˉscratchˉbudgetˉrank
                ) {
                return false;
            }
            if Ownedˉscratchˉbudgetˉrank < 32u32 {
                Ownedˉavailableˉlow = Ownedˉavailableˉlow &
                    ~(1u32 << Ownedˉscratchˉbudgetˉrank);
            } else {
                Ownedˉavailableˉhigh = Ownedˉavailableˉhigh &
                    ~(1u32 << (Ownedˉscratchˉbudgetˉrank - 32u32));
            }
        }
        if Ownedˉopcode >= 214u32 && Ownedˉopcode <= 219u32 {
            let Typeˉcount: u32 = Bytesˉreadˉu32ˉlittle(Input, Types);
            let Primary: u32 = Bytesˉreadˉu32ˉlittle(
                Input, Functionˉcode + Ownedˉcursor + 1u32
            );
            let Primaryˉrank: u32 = Iˉownedˉlocalˉrank(
                Input, Types, Typeˉcount, Localˉshapes, Primary, Minor,
                Pointerˉtypes
            );
            if !Iˉownedˉrankˉisˉavailable(
                    Ownedˉavailableˉlow, Ownedˉavailableˉhigh,
                    Primaryˉrank
                ) {
                return false;
            }
            if Ownedˉopcode == 214u32 {
                if U32ˉfromˉu8(Bytesˉreadˉu8(
                        Localˉshapes, Primary * 5u32
                    )) != 25u32 {
                    return false;
                }
            } else if Ownedˉopcode == 217u32 {
                let Primaryˉnominal: u32 = Bytesˉreadˉu32ˉlittle(
                    Localˉshapes, Primary * 5u32 + 1u32
                );
                if U32ˉfromˉu8(Bytesˉreadˉu8(
                        Localˉshapes, Primary * 5u32
                    )) != 7u32 || !Hˉtaskˉhandleˉisˉexact(
                        Input, Types, Typeˉcount, Primaryˉnominal
                    ) {
                    return false;
                }
                let Origin: u32 = Bytesˉreadˉu32ˉlittle(
                    Input, Functionˉcode + Ownedˉcursor + 5u32
                );
                let Originˉrank: u32 = Iˉownedˉlocalˉrank(
                    Input, Types, Typeˉcount,
                    Localˉshapes, Origin, Minor, Pointerˉtypes
                );
                if !Iˉownedˉrankˉisˉavailable(
                        Ownedˉavailableˉlow, Ownedˉavailableˉhigh,
                        Originˉrank
                    ) || U32ˉfromˉu8(Bytesˉreadˉu8(
                        Localˉshapes, Origin * 5u32
                    )) != 7u32 || !Hˉtaskˉscopeˉisˉexact(
                        Input, Types, Typeˉcount,
                        Bytesˉreadˉu32ˉlittle(
                            Localˉshapes, Origin * 5u32 + 1u32
                        )
                    ) {
                    return false;
                }
            } else {
                if U32ˉfromˉu8(Bytesˉreadˉu8(
                        Localˉshapes, Primary * 5u32
                    )) != 7u32 || !Hˉtaskˉscopeˉisˉexact(
                        Input, Types, Typeˉcount,
                        Bytesˉreadˉu32ˉlittle(
                            Localˉshapes, Primary * 5u32 + 1u32
                        )
                    ) {
                    return false;
                }
            }
            if Ownedˉopcode == 214u32 || Ownedˉopcode == 217u32 ||
                Ownedˉopcode == 219u32 {
                if Primaryˉrank < 32u32 {
                    Ownedˉavailableˉlow = Ownedˉavailableˉlow &
                        ~(1u32 << Primaryˉrank);
                } else {
                    Ownedˉavailableˉhigh = Ownedˉavailableˉhigh &
                        ~(1u32 << (Primaryˉrank - 32u32));
                }
            }
        }
        if Ownedˉopcode == 48u32 || Ownedˉopcode == 49u32 {
            let Ownedˉtarget: u32 = Bytesˉreadˉu32ˉlittle(
                Input, Functionˉcode + Ownedˉcursor + 1u32
            );
            if Ownedˉtarget > Ownedˉcursor {
                Ownedˉbranches = Bytesˉconcat(
                    Ownedˉbranches,
                    Bytesˉconcat(
                        Bytesˉfromˉu32ˉlittle(Ownedˉtarget),
                        Bytesˉconcat(
                            Bytesˉfromˉu32ˉlittle(
                                Ownedˉavailableˉlow
                            ),
                            Bytesˉfromˉu32ˉlittle(
                                Ownedˉavailableˉhigh
                            )
                        )
                    )
                );
            } else {
                var Ownedˉentry: u32 = 0u32;
                var Ownedˉentryˉfound: bool = false;
                while Ownedˉentry < Bytesˉlength(Ownedˉentries) {
                    if Bytesˉreadˉu32ˉlittle(
                        Ownedˉentries, Ownedˉentry
                    ) == Ownedˉtarget {
                        if Bytesˉreadˉu32ˉlittle(
                            Ownedˉentries, Ownedˉentry + 4u32
                        ) != Ownedˉavailableˉlow ||
                            Bytesˉreadˉu32ˉlittle(
                                Ownedˉentries, Ownedˉentry + 8u32
                            ) != Ownedˉavailableˉhigh {
                            return false;
                        }
                        Ownedˉentryˉfound = true;
                    }
                    Ownedˉentry = Ownedˉentry + 12u32;
                }
                if !Ownedˉentryˉfound { return false; }
            }
            if Ownedˉopcode == 48u32 { Ownedˉreachable = false; }
        }
        if Ownedˉopcode == 81u32 { Ownedˉreachable = false; }
        Ownedˉcursor = Ownedˉcursor + Ownedˉwidth;
    }
    return true;
}

export fn Iˉcontrol(Input: bytes) -> bytes {
    let Controlˉinvalid: bytes = Bytesˉslice(Input, 0u32, 0u32);
    let Controlˉtotal: u32 = Bytesˉlength(Input);
    let Minor: u32 = Hˉeffectiveˉminor(Input);
    var Controlˉenvelope: u32 = 12u32;
    var Controlˉsectionˉkind: u32 = 1u32;
    var Controlˉpayload: u32 = 0u32;
    var Controlˉpayloadˉlength: u32 = 0u32;
    var Controlˉfunctions: u32 = 0u32;
    var Controlˉfunctionsˉend: u32 = 0u32;
    var Controlˉcode: u32 = 0u32;
    var Controlˉcodeˉlength: u32 = 0u32;
    var Types: u32 = 0u32;
    while Controlˉsectionˉkind <= 7u32 {
        Controlˉpayload = Controlˉenvelope + 8u32;
        Controlˉpayloadˉlength = Bytesˉreadˉu32ˉlittle(
            Input,
            Controlˉenvelope + 4u32
        );
        if Controlˉsectionˉkind == 4u32 {
            Controlˉfunctions = Controlˉpayload;
            Controlˉfunctionsˉend = Controlˉpayload + Controlˉpayloadˉlength;
        }
        if Controlˉsectionˉkind == 5u32 {
            Controlˉcode = Controlˉpayload;
            Controlˉcodeˉlength = Controlˉpayloadˉlength;
        }
        if Controlˉsectionˉkind == 7u32 { Types = Controlˉpayload; }
        Controlˉenvelope = Controlˉpayload + Controlˉpayloadˉlength;
        Controlˉsectionˉkind = Controlˉsectionˉkind + 1u32;
    }

    let Controlˉfunctionˉcount: u32 = Bytesˉreadˉu32ˉlittle(
        Input,
        Controlˉfunctions
    );
    if Controlˉfunctionˉcount > 4096u32 { return Controlˉinvalid; }
    if Controlˉcodeˉlength > 4194304u32 { return Controlˉinvalid; }
    var Controlˉfunctionˉindex: u32 = 0u32;
    var Controlˉfunctionˉcursor: u32 = Controlˉfunctions + 4u32;
    var Controlˉaggregateˉinstructions: u32 = 0u32;
    var Foundationˉremainingˉwork: u32 = 16777216u32;
    while Controlˉfunctionˉindex < Controlˉfunctionˉcount {
        let Controlˉentry: Hˉfunctionˉentry = Hˉfunctionˉentryˉread(
            Input, Controlˉfunctionˉcursor, Controlˉfunctionsˉend, Types, Minor);
        if Controlˉentry.Next == 0u32 { return Controlˉinvalid; }
        let Controlˉparameterˉcount: u32 = Controlˉentry.Parameters;
        let Controlˉparameterˉtypes: u32 = Controlˉentry.Parameterˉtypes;
        let Controlˉlocalˉcount: u32 = Controlˉentry.Locals;
        let Controlˉlocalˉtypes: u32 = Controlˉentry.Localˉtypes;
        let Controlˉfunctionˉcodeˉoffset: u32 = Controlˉentry.Codeˉoffset;
        let Controlˉfunctionˉcodeˉlength: u32 = Controlˉentry.Codeˉlength;
        Controlˉfunctionˉcursor = Controlˉentry.Next;

        let Controlˉfunctionˉcode: u32 = Controlˉcode
            + Controlˉfunctionˉcodeˉoffset;
        let Controlˉlocalˉslots: u32 = Controlˉparameterˉcount
            + Controlˉlocalˉcount;
        let Controlˉlocalˉshapes: bytes = Typedˉdirectories.Hˉlocalˉshapes(
            Input,
            Controlˉparameterˉtypes,
            Controlˉparameterˉcount,
            Controlˉlocalˉtypes,
            Controlˉlocalˉcount
        );
        let Controlˉpointerˉtypes: bytes = Hˉfunctionˉwriteˉpointerˉtypes(
            Input, Controlˉfunctionˉcode,
            Controlˉfunctionˉcodeˉlength
        );
        if Bytesˉlength(Controlˉpointerˉtypes) % 4u32 != 0u32 {
            return Controlˉinvalid;
        }
        let Controlˉdirectory: Typedˉdirectories.Hˉcontrolˉdirectory =
            Typedˉdirectories.Iˉcontrolˉdirectory(
                Input,
                Controlˉfunctionˉcode,
                Controlˉfunctionˉcodeˉlength
            );
        if !Controlˉdirectory.Valid { return Controlˉinvalid; }
        var Controlˉcursor: u32 = 0u32;
        var Controlˉpreviousˉopcode: u32 = 0u32;
        var Controlˉfunctionˉinstructions: u32 = 0u32;
        var Controlˉhasˉtake: bool = false;
        var Controlˉhasˉfoundationˉborrow: bool = false;
        var Controlˉownedˉslot: u32 = 0u32;
        while Controlˉownedˉslot < Controlˉlocalˉslots {
            if Iˉtrackedˉownedˉlocalˉshape(
                Input, Types, Bytesˉreadˉu32ˉlittle(Input, Types),
                Controlˉlocalˉshapes, Controlˉownedˉslot, Minor,
                Controlˉpointerˉtypes
            ) { Controlˉhasˉtake = true; }
            Controlˉownedˉslot = Controlˉownedˉslot + 1u32;
        }
        while Controlˉcursor < Controlˉfunctionˉcodeˉlength {
            if Controlˉcursor > 0u32 {
                var Controlˉneedsˉpredecessor: bool = false;
                if Controlˉpreviousˉopcode == 48u32 {
                    Controlˉneedsˉpredecessor = true;
                }
                if Controlˉpreviousˉopcode == 81u32 {
                    Controlˉneedsˉpredecessor = true;
                }
                if Controlˉneedsˉpredecessor &&
                    !Typedˉdirectories.Iˉhasˉearlierˉpredecessor(
                        Controlˉdirectory.Branches,
                        Controlˉcursor
                    ) {
                    return Controlˉinvalid;
                }
            }

            let Controlˉopcode: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(
                Input,
                Controlˉfunctionˉcode + Controlˉcursor
            ));
            let Controlˉwidth: u32 = Hˉinstructionˉwidth(
                Input,
                Controlˉfunctionˉcode,
                Controlˉcursor,
                Controlˉopcode
            );
            if Controlˉopcode == 225u32 { Controlˉhasˉfoundationˉborrow = true; }
            Controlˉaggregateˉinstructions = Controlˉaggregateˉinstructions
                + 1u32;
            Controlˉfunctionˉinstructions =
                Controlˉfunctionˉinstructions + 1u32;
            if Controlˉopcode == 205u32 || Controlˉopcode == 206u32 ||
                Controlˉopcode == 207u32 {
                Controlˉhasˉtake = true;
            }
            if Controlˉaggregateˉinstructions > 400000u32 {
                return Controlˉinvalid;
            }

            var Controlˉhasˉtarget: bool = false;
            if Controlˉopcode == 48u32 { Controlˉhasˉtarget = true; }
            if Controlˉopcode == 49u32 { Controlˉhasˉtarget = true; }
            if Controlˉhasˉtarget {
                let Controlˉtarget: u32 = Bytesˉreadˉu32ˉlittle(
                    Input,
                    Controlˉfunctionˉcode + Controlˉcursor + 1u32
                );
                if Controlˉtarget >= Controlˉfunctionˉcodeˉlength {
                    return Controlˉinvalid;
                }
                if Controlˉtarget != 0u32 && Bytesˉreadˉu8(
                    Controlˉdirectory.Boundaries,
                    Controlˉtarget
                ) != 3u8 {
                    return Controlˉinvalid;
                }
            }

            Controlˉpreviousˉopcode = Controlˉopcode;
            Controlˉcursor = Controlˉcursor + Controlˉwidth;
        }
        if Controlˉpreviousˉopcode != 48u32 {
            if Controlˉpreviousˉopcode != 49u32 {
                if Controlˉpreviousˉopcode != 81u32 {
                    return Controlˉinvalid;
                }
            }
        }
        if Controlˉhasˉfoundationˉborrow {
            if Bytesˉreadˉu16ˉlittle(Input, 6u32) != 39u32 { return Controlˉinvalid; }
            let Foundationˉflow: Foundationˉowners.Flowˉresult = Foundationˉowners.Check(
                Input, Controlˉfunctionˉcode, Controlˉfunctionˉcodeˉlength,
                Controlˉlocalˉshapes, Controlˉparameterˉcount,
                Controlˉdirectory, Foundationˉremainingˉwork
            );
            if !Foundationˉflow.Valid { return Controlˉinvalid; }
            Foundationˉremainingˉwork = Foundationˉremainingˉwork - Foundationˉflow.Work;
        }
        if Controlˉhasˉtake {
            if Controlˉfunctionˉinstructions > 4096u32 ||
                !Iˉownedˉcontrolˉisˉvalid(
                    Input,
                    Minor,
                    Types,
                    Controlˉfunctionˉcode,
                    Controlˉfunctionˉcodeˉlength,
                    Controlˉlocalˉslots,
                    Controlˉparameterˉcount,
                    Controlˉlocalˉshapes
                ) {
                return Controlˉinvalid;
            }
        }
        Controlˉfunctionˉindex = Controlˉfunctionˉindex + 1u32;
    }
    if Controlˉfunctionˉcursor != Controlˉfunctionsˉend {
        return Controlˉinvalid;
    }
    if Controlˉenvelope > Controlˉtotal { return Controlˉinvalid; }
    return Input;
}
