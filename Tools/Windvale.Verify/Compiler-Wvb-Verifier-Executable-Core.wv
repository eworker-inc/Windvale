            if Opcode == 183u32 || Opcode == 184u32 { Popˉcount = 2u32; Firstˉkind = 5u32; Secondˉkind = 10u32; Hasˉpush = true; Pushˉkind = 10u32; Handled = true; }
            if Opcode == 185u32 || Opcode == 186u32 { Popˉcount = 2u32; Firstˉkind = 3u32; Secondˉkind = 3u32; Hasˉpush = true; Pushˉkind = 2u32; Handled = true; }
            if Opcode == 187u32 || Opcode == 188u32 { Popˉcount = 2u32; Firstˉkind = 6u32; Secondˉkind = 6u32; Hasˉpush = true; Pushˉkind = 2u32; Handled = true; }
            if Opcode == 189u32 { Popˉcount = 2u32; Firstˉkind = 5u32; Secondˉkind = 6u32; Hasˉpush = true; Pushˉkind = 10u32; Handled = true; }
