            if Opcode == 49u32 { Width = 5u32; }
            if Opcode == 64u32 { Width = 5u32; }
            if Opcode == 65u32 { Width = 5u32; }
            if Opcode == 104u32 { Width = 5u32; }
            if Opcode == 105u32 { Width = 5u32; }
            if Opcode == 106u32 { Width = 9u32; }
            if Opcode == 128u32 { Width = 9u32; }
            if Opcode == 129u32 { Width = 9u32; }
            if Opcode >= 151u32 && Opcode <= 153u32 { Width = 9u32; }
            if Opcode == 192u32 {
                Width = 3u32;
                if U32ˉfromˉu8(Bytesˉreadˉu8(
                    Input, Functionˉcode + Cursor + 2u32
                )) == 0u32 {
                    Width = 5u32;
                }
            }
            if Opcode == 193u32 {
                Width = 2u32;
                if U32ˉfromˉu8(Bytesˉreadˉu8(
                    Input, Functionˉcode + Cursor + 1u32
                )) == 0u32 {
                    Width = 6u32;
                }
            }
            if Opcode == 194u32 {
                Width = 3u32;
                if U32ˉfromˉu8(Bytesˉreadˉu8(
                    Input, Functionˉcode + Cursor + 2u32
                )) == 0u32 {
                    Width = 7u32;
                    if U32ˉfromˉu8(Bytesˉreadˉu8(
                        Input, Functionˉcode + Cursor + 1u32
                    )) == 19u32 {
                        Width = 11u32;
                    }
                }
            }
            Aggregateˉinstructions = Aggregateˉinstructions + 1u32;
            if Aggregateˉinstructions > 400000u32 { return Invalid; }

            var Popˉcount: u32 = 0u32;
            var Firstˉkind: u32 = 0u32;
            var Firstˉnominal: u32 = 0u32;
            var Secondˉkind: u32 = 0u32;
