                );
                Firstˉnominal = Bytesˉreadˉu32ˉlittle(
                    Localˉshapes,
                    Storedˉshape + 1u32
                );
                Popˉcount = 1u32;
                Handled = true;
            }

            if Opcode == 7u32 { Popˉcount = 1u32; Firstˉkind = 1u32; Hasˉpush = true; Pushˉkind = 1u32; Handled = true; }
            if Opcode == 11u32 { Popˉcount = 1u32; Firstˉkind = 6u32; Hasˉpush = true; Pushˉkind = 5u32; Handled = true; }
            if Opcode == 12u32 { Popˉcount = 3u32; Firstˉkind = 5u32; Secondˉkind = 5u32; Thirdˉkind = 6u32; Hasˉpush = true; Pushˉkind = 6u32; Handled = true; }
            if Opcode == 13u32 { Popˉcount = 2u32; Firstˉkind = 5u32; Secondˉkind = 6u32; Hasˉpush = true; Pushˉkind = 4u32; Handled = true; }
            if Opcode == 14u32 { Popˉcount = 2u32; Firstˉkind = 5u32; Secondˉkind = 6u32; Hasˉpush = true; Pushˉkind = 5u32; Handled = true; }
