module Windvaleˉcompilerˉwvbˉverifierˉtypedˉdirectories profile portable;

export record Hˉcontrolˉdirectory {
    Valid: bool;
    Boundaries: bytes;
    Branches: bytes;
}

fn Hˉnominalˉshape(Kind: u32) -> bool {
    return Kind == 7u32 || Kind == 8u32 || Kind == 11u32 ||
        Kind == 22u32 || Kind == 23u32 || Kind == 24u32 ||
        Kind == 26u32 || Kind == 27u32 || Kind == 28u32 ||
        Kind == 29u32 || Kind == 30u32 || Kind == 35u32;
}

export fn Hˉlocalˉshapes(
    Input: bytes,
    Parameterˉtypes: u32,
    Parameterˉcount: u32,
    Localˉtypes: u32,
    Localˉcount: u32
) -> bytes {
    let Empty: bytes = Bytesˉslice(Input, 0u32, 0u32);
    let Length: u32 = Bytesˉlength(Input);
    if Parameterˉcount > 8192u32 || Localˉcount > 8192u32 - Parameterˉcount ||
        Parameterˉtypes > Length || Localˉtypes > Length {
        return Empty;
    }
    var Result: bytes = Empty;
    var Chunk: bytes = Empty;
    var Stage: u32 = 0u32;
    while Stage < 2u32 {
        var Cursor: u32 = Parameterˉtypes;
        var Count: u32 = Parameterˉcount;
        if Stage == 1u32 {
            Cursor = Localˉtypes;
            Count = Localˉcount;
        }
        if Count > Length - Cursor { return Empty; }
        var Index: u32 = 0u32;
        while Index < Count {
            if Cursor >= Length { return Empty; }
            var Kind: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(Input, Cursor));
            Cursor = Cursor + 1u32;
            var Borrowed: bool = false;
            if Kind == 37u32 {
                if Cursor >= Length { return Empty; }
                Borrowed = true;
                Kind = U32ˉfromˉu8(Bytesˉreadˉu8(Input, Cursor));
                Cursor = Cursor + 1u32;
                // Decode ordinary payloads only; nested and special-owner views
                // retain their separate contracts. This is not module admission.
                if !((Kind >= 1u32 && Kind <= 11u32) ||
                    (Kind >= 14u32 && Kind <= 20u32) ||
                    Kind == 22u32 || Kind == 24u32 || Kind == 35u32) {
                    return Empty;
                }
            } else {
                if !((Kind >= 1u32 && Kind <= 11u32) ||
                    (Kind >= 14u32 && Kind <= 20u32) ||
                    (Kind >= 22u32 && Kind <= 30u32) ||
                    (Kind >= 34u32 && Kind <= 36u32)) {
                    return Empty;
                }
                if Stage == 1u32 && (Kind == 26u32 || Kind == 27u32) {
                    return Empty;
                }
            }
            var Nominal: u32 = 0u32;
            if Hˉnominalˉshape(Kind) {
                if Length - Cursor < 4u32 { return Empty; }
                Nominal = Bytesˉreadˉu32ˉlittle(Input, Cursor);
                Cursor = Cursor + 4u32;
            }
            // Five-byte internal cells use 64 + payload kind for shape 37.
            // Keep the full nominal u32; stack transfer kinds 26..38 are distinct.
            if Borrowed { Kind = Kind + 64u32; }
            let Cell: bytes = Bytesˉconcat(
                Bytesˉslice(Bytesˉfromˉu32ˉlittle(Kind), 0u32, 1u32),
                Bytesˉfromˉu32ˉlittle(Nominal)
            );
            Chunk = Bytesˉconcat(Chunk, Cell);
            // At most 128 bounded chunks for 8,192 slots, avoiding one growing
            // whole-directory copy for every five-byte cell.
            if Bytesˉlength(Chunk) == 320u32 {
                Result = Bytesˉconcat(Result, Chunk);
                Chunk = Empty;
            }
            Index = Index + 1u32;
        }
        Stage = Stage + 1u32;
    }
    if Bytesˉlength(Chunk) > 0u32 { Result = Bytesˉconcat(Result, Chunk); }
    return Result;
}

export fn Iˉcontrolˉdirectory(
    Input: bytes,
    Functionˉcode: u32,
    Codeˉlength: u32
) -> Hˉcontrolˉdirectory {
    let Empty: bytes = Bytesˉslice(Input, 0u32, 0u32);
    if Functionˉcode > Bytesˉlength(Input) ||
        Codeˉlength > Bytesˉlength(Input) - Functionˉcode {
        return Hˉcontrolˉdirectory(false, Empty, Empty);
    }
    var Boundaries: bytes = Empty;
    var Branches: bytes = Empty;
    var Cursor: u32 = 0u32;
    var Previousˉopcode: u32 = 0u32;
    while Cursor < Codeˉlength {
        let Opcode: u32 = U32ˉfromˉu8(
            Bytesˉreadˉu8(Input, Functionˉcode + Cursor)
        );
        var Width: u32 = 1u32;
        if Opcode == 2u32 || Opcode == 8u32 { Width = 2u32; }
        if Opcode == 1u32 || (Opcode >= 3u32 && Opcode <= 7u32) ||
            Opcode == 9u32 || Opcode == 10u32 || Opcode == 48u32 ||
            Opcode == 49u32 || Opcode == 64u32 || Opcode == 65u32 ||
            Opcode == 104u32 || Opcode == 105u32 || Opcode == 197u32 ||
            Opcode == 199u32 || Opcode == 200u32 ||
            (Opcode >= 202u32 && Opcode <= 205u32) || Opcode == 210u32 ||
            Opcode == 212u32 {
            Width = 5u32;
        }
        if Opcode == 106u32 || Opcode == 128u32 || Opcode == 129u32 ||
            (Opcode >= 151u32 && Opcode <= 153u32) || Opcode == 196u32 ||
            Opcode == 201u32 || Opcode == 206u32 || Opcode == 207u32 ||
            Opcode == 208u32 || Opcode == 211u32 || Opcode == 221u32 {
            Width = 9u32;
        }
        if Opcode == 209u32 || Opcode == 213u32 || Opcode == 216u32 ||
            Opcode == 217u32 || Opcode == 220u32 || Opcode == 222u32 ||
            Opcode == 223u32 || Opcode == 224u32 || Opcode == 225u32 {
            Width = 13u32;
        }
        if Opcode == 214u32 || Opcode == 215u32 || Opcode == 218u32 {
            Width = 9u32;
        }
        if Opcode == 219u32 { Width = 6u32; }
        if Opcode == 192u32 {
            if Codeˉlength - Cursor < 3u32 {
                return Hˉcontrolˉdirectory(false, Empty, Empty);
            }
            Width = 3u32;
            if U32ˉfromˉu8(Bytesˉreadˉu8(
                Input, Functionˉcode + Cursor + 2u32
            )) == 0u32 {
                Width = 5u32;
            }
        }
        if Opcode == 193u32 {
            if Codeˉlength - Cursor < 2u32 {
                return Hˉcontrolˉdirectory(false, Empty, Empty);
            }
            Width = 2u32;
            if U32ˉfromˉu8(Bytesˉreadˉu8(
                Input, Functionˉcode + Cursor + 1u32
            )) == 0u32 {
                Width = 6u32;
            }
        }
        if Opcode == 194u32 {
            if Codeˉlength - Cursor < 3u32 {
                return Hˉcontrolˉdirectory(false, Empty, Empty);
            }
            Width = 3u32;
            if U32ˉfromˉu8(Bytesˉreadˉu8(
                Input, Functionˉcode + Cursor + 2u32
            )) == 0u32 {
                Width = 7u32;
                if U32ˉfromˉu8(Bytesˉreadˉu8(
                    Input, Functionˉcode + Cursor + 1u32
                )) == 19u32 {
                    Width = 11u32;
                }
            }
        }
        if Width > Codeˉlength - Cursor {
            return Hˉcontrolˉdirectory(false, Empty, Empty);
        }

        var Boundary: u8 = 1u8;
        if Cursor > 0u32 && (Previousˉopcode == 48u32 ||
            Previousˉopcode == 49u32 || Previousˉopcode == 81u32) {
            Boundary = 3u8;
        }
        var Chunk: bytes = Bytesˉfromˉu8(Boundary);
        if Width == 2u32 {
            Chunk = Bytesˉconcat(Chunk, Bytesˉfromˉu8(0u8));
        }
        if Width == 3u32 {
            Chunk = Bytesˉconcat(Chunk, Bytesˉfromˉu16ˉlittle(0u32));
        }
        if Width == 5u32 {
            Chunk = Bytesˉconcat(Chunk, Bytesˉfromˉu32ˉlittle(0u32));
        }
        if Width == 6u32 {
            Chunk = Bytesˉconcat(
                Chunk,
                Bytesˉconcat(
                    Bytesˉfromˉu32ˉlittle(0u32),
                    Bytesˉfromˉu8(0u8)
                )
            );
        }
        if Width == 7u32 {
            Chunk = Bytesˉconcat(
                Chunk,
                Bytesˉconcat(
                    Bytesˉfromˉu32ˉlittle(0u32),
                    Bytesˉfromˉu16ˉlittle(0u32)
                )
            );
        }
        if Width == 9u32 {
            Chunk = Bytesˉconcat(
                Chunk,
                Bytesˉconcat(
                    Bytesˉfromˉu32ˉlittle(0u32),
                    Bytesˉfromˉu32ˉlittle(0u32)
                )
            );
        }
        if Width == 11u32 {
            Chunk = Bytesˉconcat(
                Chunk,
                Bytesˉconcat(
                    Bytesˉfromˉu32ˉlittle(0u32),
                    Bytesˉconcat(
                        Bytesˉfromˉu32ˉlittle(0u32),
                        Bytesˉfromˉu16ˉlittle(0u32)
                    )
                )
            );
        }
        if Width == 13u32 {
            Chunk = Bytesˉconcat(
                Chunk,
                Bytesˉconcat(
                    Bytesˉfromˉu32ˉlittle(0u32),
                    Bytesˉconcat(
                        Bytesˉfromˉu32ˉlittle(0u32),
                        Bytesˉfromˉu32ˉlittle(0u32)
                    )
                )
            );
        }
        Boundaries = Bytesˉconcat(Boundaries, Chunk);

        if Opcode == 48u32 || Opcode == 49u32 {
            Branches = Bytesˉconcat(
                Branches,
                Bytesˉconcat(
                    Bytesˉfromˉu32ˉlittle(Cursor),
                    Bytesˉfromˉu32ˉlittle(Bytesˉreadˉu32ˉlittle(
                        Input,
                        Functionˉcode + Cursor + 1u32
                    ))
                )
            );
        }
        Previousˉopcode = Opcode;
        Cursor = Cursor + Width;
    }
    if Cursor != Codeˉlength {
        return Hˉcontrolˉdirectory(false, Empty, Empty);
    }
    if Bytesˉlength(Boundaries) != Codeˉlength {
        return Hˉcontrolˉdirectory(false, Empty, Empty);
    }
    return Hˉcontrolˉdirectory(true, Boundaries, Branches);
}

export fn Iˉhasˉearlierˉpredecessor(Branches: bytes, Target: u32) -> bool {
    if Bytesˉlength(Branches) % 8u32 != 0u32 { return false; }
    var Cursor: u32 = 0u32;
    while Cursor < Bytesˉlength(Branches) {
        let Source: u32 = Bytesˉreadˉu32ˉlittle(Branches, Cursor);
        let Branchˉtarget: u32 = Bytesˉreadˉu32ˉlittle(Branches, Cursor + 4u32);
        if Source < Target && Branchˉtarget == Target { return true; }
        Cursor = Cursor + 8u32;
    }
    return false;
}
