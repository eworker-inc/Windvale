{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Windvale",
  "scopeName": "source.windvale",
  "fileTypes": [
    "wv"
  ],
  "patterns": [
    {
      "include": "#source-descriptor"
    },
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#declaration-keywords"
    },
    {
      "include": "#control-keywords"
    },
    {
      "include": "#storage-keywords"
    },
    {
      "include": "#profile-keywords"
    },
    {
      "include": "#type-keywords"
    },
    {
      "include": "#boolean-literals"
    },
    {
      "include": "#built-in-functions"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#named-record-literals"
    },
    {
      "include": "#calls"
    },
    {
      "include": "#members"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "source-descriptor": {
      "patterns": [
        {
          "name": "meta.preprocessor.source-descriptor.windvale",
          "match": "\\A#!wv/1 [A-Za-z][A-Za-z0-9]*(?:-[A-Za-z][A-Za-z0-9]*)*(?:\\.[A-Za-z][A-Za-z0-9]*(?:-[A-Za-z][A-Za-z0-9]*)*)*@[1-9][0-9]*(?=\\r?$)"
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.line.documentation.windvale",
          "match": "///.*$"
        },
        {
          "name": "comment.line.double-slash.windvale",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.other.raw.byte.windvale",
          "begin": "(?<![\\p{L}\\p{Nl}\\p{Mn}\\p{Mc}\\p{Nd}\\p{Pc}_ˉ])br(#{0,8})\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.windvale"
            }
          },
          "end": "\"\\1",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.windvale"
            }
          }
        },
        {
          "name": "string.quoted.other.raw.windvale",
          "begin": "(?<![\\p{L}\\p{Nl}\\p{Mn}\\p{Mc}\\p{Nd}\\p{Pc}_ˉ])r(#{0,8})\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.windvale"
            }
          },
          "end": "\"\\1",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.windvale"
            }
          }
        },
        {
          "name": "string.quoted.triple.byte.windvale",
          "begin": "(?<![\\p{L}\\p{Nl}\\p{Mn}\\p{Mc}\\p{Nd}\\p{Pc}_ˉ])b\"\"\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.windvale"
            }
          },
          "end": "\"\"\"",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.windvale"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.windvale",
              "match": "\\\\(?:[\\\\'\"nrt0{}]|x[0-9A-Fa-f]{2})"
            },
            {
              "name": "invalid.illegal.escape.windvale",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.triple.windvale",
          "begin": "\"\"\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.windvale"
            }
          },
          "end": "\"\"\"",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.windvale"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.windvale",
              "match": "\\\\(?:[\\\\'\"nrt0{}]|u\\{[0-9A-Fa-f]{1,6}\\})"
            },
            {
              "name": "invalid.illegal.escape.windvale",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.double.byte.windvale",
          "begin": "(?<![\\p{L}\\p{Nl}\\p{Mn}\\p{Mc}\\p{Nd}\\p{Pc}_ˉ])b\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.windvale"
            }
          },
          "end": "\"|$",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.windvale"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.windvale",
              "match": "\\\\(?:[\\\\'\"nrt0{}]|x[0-9A-Fa-f]{2})"
            },
            {
              "name": "invalid.illegal.escape.windvale",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.double.windvale",
          "begin": "\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.windvale"
            }
          },
          "end": "\"|$",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.windvale"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.windvale",
              "match": "\\\\(?:[\\\\'\"nrt0{}]|u\\{[0-9A-Fa-f]{1,6}\\})"
            },
            {
              "name": "invalid.illegal.escape.windvale",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.rune.windvale",
          "begin": "'",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.windvale"
            }
          },
          "end": "'|$",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.windvale"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.windvale",
              "match": "\\\\(?:[\\\\'\"nrt0{}]|u\\{[0-9A-Fa-f]{1,6}\\})"
            },
            {
              "name": "invalid.illegal.escape.windvale",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "(?<![\\p{L}\\p{Nl}\\p{Mn}\\p{Mc}\\p{Nd}\\p{Pc}_ˉ])(module|import)\\s+([\\p{L}\\p{Nl}_][\\p{L}\\p{Nl}\\p{Mn}\\p{Mc}\\p{Nd}\\p{Pc}_]*(?:ˉ[\\p{L}\\p{Nl}_][\\p{L}\\p{Nl}\\p{Mn}\\p{Mc}\\p{Nd}\\p{Pc}_]*)*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.module.windvale"
            },
            "2": {
              "name": "entity.name.namespace.windvale"
            }
          }
        },
        {
          "match": "(?<![\\p{L}\\p{Nl}\\p{Mn}\\p{Mc}\\p{Nd}\\p{Pc}_ˉ])(capability)\\s+([a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+)",
          "captures": {
            "1": {
              "name": "keyword.declaration.capability.windvale"
            },
            "2": {
              "name": "entity.name.function.capability.windvale"
            }
          }
        },
        {
          "match": "(?<![\\p{L}\\p{Nl}\\p{Mn}\\p{Mc}\\p{Nd}\\p{Pc}_ˉ])(record|enum|variant|protocol)\\s+([\\p{L}\\p{Nl}_][\\p{L}\\p{Nl}\\p{Mn}\\p{Mc}\\p{Nd}\\p{Pc}_]*(?:ˉ[\\p{L}\\p{Nl}_][\\p{L}\\p{Nl}\\p{Mn}\\p{Mc}\\p{Nd}\\p{Pc}_]*)*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.type.windvale"
            },
            "2": {
              "name": "entity.name.type.windvale"
            }
          }
        },
        {
          "match": "(?<![\\p{L}\\p{Nl}\\p{Mn}\\p{Mc}\\p{Nd}\\p{Pc}_ˉ])(data)\\s+([\\p{L}\\p{Nl}_][\\p{L}\\p{Nl}\\p{Mn}\\p{Mc}\\p{Nd}\\p{Pc}_]*(?:ˉ[\\p{L}\\p{Nl}_][\\p{L}\\p{Nl}\\p{Mn}\\p{Mc}\\p{Nd}\\p{Pc}_]*)*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.data.windvale"
            },
            "2": {
              "name": "variable.other.constant.windvale"
            }
          }
        },
        {
          "match": "(?<![\\p{L}\\p{Nl}\\p{Mn}\\p{Mc}\\p{Nd}\\p{Pc}_ˉ])(const)\\s+([A-Z_][A-Z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.constant.windvale"
            },
            "2": {
              "name": "variable.other.constant.windvale"
            }
          }
        },
        {
          "match": "(?<![\\p{L}\\p{Nl}\\p{Mn}\\p{Mc}\\p{Nd}\\p{Pc}_ˉ])(fn)\\s+([\\p{L}\\p{Nl}_][\\p{L}\\p{Nl}\\p{Mn}\\p{Mc}\\p{Nd}\\p{Pc}_]*(?:ˉ[\\p{L}\\p{Nl}_][\\p{L}\\p{Nl}\\p{Mn}\\p{Mc}\\p{Nd}\\p{Pc}_]*)*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.function.windvale"
            },
            "2": {
              "name": "entity.name.function.windvale"
            }
          }
        },
        {
          "match": "(?<![\\p{L}\\p{Nl}\\p{Mn}\\p{Mc}\\p{Nd}\\p{Pc}_ˉ])(let|var)\\s+([\\p{L}\\p{Nl}_][\\p{L}\\p{Nl}\\p{Mn}\\p{Mc}\\p{Nd}\\p{Pc}_]*(?:ˉ[\\p{L}\\p{Nl}_][\\p{L}\\p{Nl}\\p{Mn}\\p{Mc}\\p{Nd}\\p{Pc}_]*)*)",
          "captures": {
            "1": {
              "name": "storage.modifier.windvale"
            },
            "2": {
              "name": "variable.other.definition.windvale"
            }
          }
        },
        {
          "name": "variable.other.definition.windvale",
          "match": "(?<![\\p{L}\\p{Nl}\\p{Mn}\\p{Mc}\\p{Nd}\\p{Pc}_ˉ])([\\p{L}\\p{Nl}_][\\p{L}\\p{Nl}\\p{Mn}\\p{Mc}\\p{Nd}\\p{Pc}_]*(?:ˉ[\\p{L}\\p{Nl}_][\\p{L}\\p{Nl}\\p{Mn}\\p{Mc}\\p{Nd}\\p{Pc}_]*)*)(?=\\s*:)"
        }
      ]
    },
    "declaration-keywords": {
      "patterns": [
        {
          "name": "keyword.declaration.windvale",
          "match": "(?<![\\p{L}\\p{Nl}\\p{Mn}\\p{Mc}\\p{Nd}\\p{Pc}_ˉ])(?:module|profile|platform|authority|import|as|requires|optional|capability|version|data|const|record|enum|variant|protocol|implement|derive|package|foreign|export|fn|where|maximum)(?![\\p{L}\\p{Nl}\\p{Mn}\\p{Mc}\\p{Nd}\\p{Pc}_ˉ])"
        }
      ]
    },
    "control-keywords": {
      "patterns": [
        {
          "name": "keyword.control.flow.windvale",
          "match": "(?<![\\p{L}\\p{Nl}\\p{Mn}\\p{Mc}\\p{Nd}\\p{Pc}_ˉ])(?:if|else|while|for|in|match|case|try|await|using|task|scope|policy|join|cancel_join|fail_join|break|continue|return)(?![\\p{L}\\p{Nl}\\p{Mn}\\p{Mc}\\p{Nd}\\p{Pc}_ˉ])"
        }
      ]
    },
    "storage-keywords": {
      "patterns": [
        {
          "name": "storage.modifier.windvale",
          "match": "(?<![\\p{L}\\p{Nl}\\p{Mn}\\p{Mc}\\p{Nd}\\p{Pc}_ˉ])(?:let|var|borrow|mut|copy|move|base|unsafe|async|effects|freeze|push)(?![\\p{L}\\p{Nl}\\p{Mn}\\p{Mc}\\p{Nd}\\p{Pc}_ˉ])"
        }
      ]
    },
    "profile-keywords": {
      "patterns": [
        {
          "name": "storage.modifier.profile.windvale",
          "match": "(?<![\\p{L}\\p{Nl}\\p{Mn}\\p{Mc}\\p{Nd}\\p{Pc}_ˉ])(?:core|portable|hosted|system|application|library|service)(?![\\p{L}\\p{Nl}\\p{Mn}\\p{Mc}\\p{Nd}\\p{Pc}_ˉ])"
        }
      ]
    },
    "type-keywords": {
      "patterns": [
        {
          "name": "storage.type.windvale",
          "match": "(?<![\\p{L}\\p{Nl}\\p{Mn}\\p{Mc}\\p{Nd}\\p{Pc}_ˉ])(?:i8|i16|i32|i64|u8|u16|u32|u64|f32|f64|rune|bool|text|bytes|unit|never|sequence|builder|void)(?![\\p{L}\\p{Nl}\\p{Mn}\\p{Mc}\\p{Nd}\\p{Pc}_ˉ])"
        }
      ]
    },
    "boolean-literals": {
      "patterns": [
        {
          "name": "constant.language.boolean.windvale",
          "match": "(?<![\\p{L}\\p{Nl}\\p{Mn}\\p{Mc}\\p{Nd}\\p{Pc}_ˉ])(?:true|false)(?![\\p{L}\\p{Nl}\\p{Mn}\\p{Mc}\\p{Nd}\\p{Pc}_ˉ])"
        }
      ]
    },
    "built-in-functions": {
      "patterns": [
        {
          "name": "support.function.builtin.windvale",
          "match": "(?<![\\p{L}\\p{Nl}\\p{Mn}\\p{Mc}\\p{Nd}\\p{Pc}_ˉ])length(?![\\p{L}\\p{Nl}\\p{Mn}\\p{Mc}\\p{Nd}\\p{Pc}_ˉ])"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "match": "(?<![\\p{L}\\p{Nl}\\p{Mn}\\p{Mc}\\p{Nd}\\p{Pc}_ˉ])((?:[0-9](?:_?[0-9])*\\.[0-9](?:_?[0-9])*(?:[eE][+-]?[0-9](?:_?[0-9])*)?|[0-9](?:_?[0-9])*[eE][+-]?[0-9](?:_?[0-9])*|0x[0-9A-Fa-f](?:_?[0-9A-Fa-f])*(?:\\.[0-9A-Fa-f](?:_?[0-9A-Fa-f])*)?[pP][+-]?[0-9](?:_?[0-9])*))(f32|f64)?(?![\\p{L}\\p{Nl}\\p{Mn}\\p{Mc}\\p{Nd}\\p{Pc}_ˉ])",
          "captures": {
            "1": {
              "name": "constant.numeric.float.hexadecimal.windvale"
            },
            "2": {
              "name": "storage.type.numeric.suffix.windvale"
            }
          }
        },
        {
          "match": "(?<![\\p{L}\\p{Nl}\\p{Mn}\\p{Mc}\\p{Nd}\\p{Pc}_ˉ])((?:0x[0-9A-Fa-f](?:_?[0-9A-Fa-f])*|0b[01](?:_?[01])*|[0-9](?:_?[0-9])*))(i8|i16|i32|i64|u8|u16|u32|u64)?(?![\\p{L}\\p{Nl}\\p{Mn}\\p{Mc}\\p{Nd}\\p{Pc}_ˉ])",
          "captures": {
            "1": {
              "name": "constant.numeric.integer.decimal.windvale"
            },
            "2": {
              "name": "storage.type.numeric.suffix.windvale"
            }
          }
        }
      ]
    },
    "named-record-literals": {
      "patterns": [
        {
          "name": "entity.name.type.windvale",
          "match": "(?<![\\p{L}\\p{Nl}\\p{Mn}\\p{Mc}\\p{Nd}\\p{Pc}_ˉ])([\\p{L}\\p{Nl}_][\\p{L}\\p{Nl}\\p{Mn}\\p{Mc}\\p{Nd}\\p{Pc}_]*(?:ˉ[\\p{L}\\p{Nl}_][\\p{L}\\p{Nl}\\p{Mn}\\p{Mc}\\p{Nd}\\p{Pc}_]*)*)(?=\\s*\\{\\s*[\\p{L}\\p{Nl}_][\\p{L}\\p{Nl}\\p{Mn}\\p{Mc}\\p{Nd}\\p{Pc}_]*(?:ˉ[\\p{L}\\p{Nl}_][\\p{L}\\p{Nl}\\p{Mn}\\p{Mc}\\p{Nd}\\p{Pc}_]*)*\\s*:)"
        }
      ]
    },
    "calls": {
      "patterns": [
        {
          "name": "entity.name.function.capability.windvale",
          "match": "(?<![A-Za-z0-9_ˉ])([a-z_][a-z0-9_]*(?:\\.[a-z_][a-z0-9_]*)+)(?=\\s*\\()"
        },
        {
          "name": "entity.name.function.call.windvale",
          "match": "(?<![\\p{L}\\p{Nl}\\p{Mn}\\p{Mc}\\p{Nd}\\p{Pc}_ˉ])([\\p{L}\\p{Nl}_][\\p{L}\\p{Nl}\\p{Mn}\\p{Mc}\\p{Nd}\\p{Pc}_]*(?:ˉ[\\p{L}\\p{Nl}_][\\p{L}\\p{Nl}\\p{Mn}\\p{Mc}\\p{Nd}\\p{Pc}_]*)*)(?=\\s*\\()"
        }
      ]
    },
    "members": {
      "patterns": [
        {
          "match": "(\\.)([\\p{L}\\p{Nl}_][\\p{L}\\p{Nl}\\p{Mn}\\p{Mc}\\p{Nd}\\p{Pc}_]*(?:ˉ[\\p{L}\\p{Nl}_][\\p{L}\\p{Nl}\\p{Mn}\\p{Mc}\\p{Nd}\\p{Pc}_]*)*)",
          "captures": {
            "1": {
              "name": "punctuation.accessor.windvale"
            },
            "2": {
              "name": "variable.other.member.windvale"
            }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.windvale",
          "match": "->|&&|\\|\\||<<|>>|==|!=|<=|>=|\\+=|-=|\\*=|/=|%=|[+\\-*/%&|^~!<>=]"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.section.group.windvale",
          "match": "[(){}\\[\\]]"
        },
        {
          "name": "punctuation.separator.windvale",
          "match": "[;:,]"
        }
      ]
    }
  }
}
