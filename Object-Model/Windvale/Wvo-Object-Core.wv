module Wvoˉobjectˉcore profile hosted;

import Foundationˉsha256ˉstreaming as Sha256;
import Wvoˉobjectˉverification as Verification;

capability console.write_line;
capability diagnostic.write_line;
capability file.read_bytes;
capability process.argument;
capability process.argument_count;

data Emptyˉbytes: bytes = [];
data Textˉcontents: bytes = [232, 0, 0, 0, 0, 195];
data Messageˉcontents: bytes = [72, 105, 10];

enum Wvoˉsectionˉkind {
    Invalid = 0;
    Code = 1;
    Readˉonlyˉdata = 2;
    Writableˉdata = 3;
    Zeroˉfill = 4;
}

enum Wvoˉsymbolˉbinding {
    Invalid = 0;
    Local = 1;
    Export = 2;
    Import = 3;
}

enum Wvoˉsymbolˉkind {
    Invalid = 0;
    Function = 1;
    Data = 2;
}

enum Wvoˉrelocationˉkind {
    Invalid = 0;
    Absoluteˉu32 = 1;
    Relativeˉi32 = 2;
}

record Wvoˉsection {
    Name: text;
    Kind: Wvoˉsectionˉkind;
    Alignment: u32;
    Memoryˉsize: u32;
    Contents: bytes;
}

record Wvoˉsymbol {
    Name: text;
    Binding: Wvoˉsymbolˉbinding;
    Kind: Wvoˉsymbolˉkind;
    Sectionˉindex: u32;
    Offset: u32;
    Size: u32;
}

record Wvoˉrelocation {
    Kind: Wvoˉrelocationˉkind;
    Sectionˉindex: u32;
    Offset: u32;
    Symbolˉindex: u32;
    Addend: i32;
}

fn Sectionˉkindˉtag(Value: Wvoˉsectionˉkind) -> u8 {
    if Value == Wvoˉsectionˉkind.Code { return 1u8; }
    if Value == Wvoˉsectionˉkind.Readˉonlyˉdata { return 2u8; }
    if Value == Wvoˉsectionˉkind.Writableˉdata { return 3u8; }
    return 4u8;
}

fn Symbolˉbindingˉtag(Value: Wvoˉsymbolˉbinding) -> u8 {
    if Value == Wvoˉsymbolˉbinding.Local { return 1u8; }
    if Value == Wvoˉsymbolˉbinding.Export { return 2u8; }
    return 3u8;
}

fn Symbolˉkindˉtag(Value: Wvoˉsymbolˉkind) -> u8 {
    if Value == Wvoˉsymbolˉkind.Function { return 1u8; }
    return 2u8;
}

fn Relocationˉkindˉtag(Value: Wvoˉrelocationˉkind) -> u8 {
    if Value == Wvoˉrelocationˉkind.Absoluteˉu32 { return 1u8; }
    return 2u8;
}

fn Append(Left: bytes, Right: bytes) -> bytes {
    return Bytesˉconcat(Left, Right);
}

fn Encodeˉstring(Value: text) -> bytes {
    let Encoded: bytes = Textˉtoˉutf8(Value);
    return Append(Bytesˉfromˉu32ˉlittle(Bytesˉlength(Encoded)), Encoded);
}

fn Encodeˉheader(Sectionˉcount: u32, Symbolˉcount: u32, Relocationˉcount: u32) -> bytes {
    var Result: bytes = Textˉtoˉutf8("WVO1");
    Result = Append(Result, Bytesˉfromˉu16ˉlittle(1u32));
    Result = Append(Result, Bytesˉfromˉu16ˉlittle(0u32));
    Result = Append(Result, Bytesˉfromˉu8(1u8));
    Result = Append(Result, Bytesˉfromˉu8(0u8));
    Result = Append(Result, Bytesˉfromˉu16ˉlittle(0u32));
    Result = Append(Result, Bytesˉfromˉu32ˉlittle(Sectionˉcount));
    Result = Append(Result, Bytesˉfromˉu32ˉlittle(Symbolˉcount));
    return Append(Result, Bytesˉfromˉu32ˉlittle(Relocationˉcount));
}

fn Encodeˉsection(Value: Wvoˉsection) -> bytes {
    var Result: bytes = Bytesˉfromˉu8(Sectionˉkindˉtag(Value.Kind));
    Result = Append(Result, Bytesˉfromˉu8(0u8));
    Result = Append(Result, Bytesˉfromˉu16ˉlittle(0u32));
    Result = Append(Result, Bytesˉfromˉu32ˉlittle(Value.Alignment));
    Result = Append(Result, Bytesˉfromˉu32ˉlittle(Value.Memoryˉsize));
    Result = Append(Result, Bytesˉfromˉu32ˉlittle(Bytesˉlength(Value.Contents)));
    Result = Append(Result, Encodeˉstring(Value.Name));
    return Append(Result, Value.Contents);
}

fn Encodeˉsymbol(Value: Wvoˉsymbol) -> bytes {
    var Result: bytes = Bytesˉfromˉu8(Symbolˉbindingˉtag(Value.Binding));
    Result = Append(Result, Bytesˉfromˉu8(Symbolˉkindˉtag(Value.Kind)));
    Result = Append(Result, Bytesˉfromˉu16ˉlittle(0u32));
    Result = Append(Result, Bytesˉfromˉu32ˉlittle(Value.Sectionˉindex));
    Result = Append(Result, Bytesˉfromˉu32ˉlittle(Value.Offset));
    Result = Append(Result, Bytesˉfromˉu32ˉlittle(Value.Size));
    return Append(Result, Encodeˉstring(Value.Name));
}

fn Encodeˉrelocation(Value: Wvoˉrelocation) -> bytes {
    var Result: bytes = Bytesˉfromˉu8(Relocationˉkindˉtag(Value.Kind));
    Result = Append(Result, Bytesˉfromˉu8(0u8));
    Result = Append(Result, Bytesˉfromˉu16ˉlittle(0u32));
    Result = Append(Result, Bytesˉfromˉu32ˉlittle(Value.Sectionˉindex));
    Result = Append(Result, Bytesˉfromˉu32ˉlittle(Value.Offset));
    Result = Append(Result, Bytesˉfromˉu32ˉlittle(Value.Symbolˉindex));
    return Append(Result, Bytesˉfromˉi32ˉlittle(Value.Addend));
}

fn Buildˉsampleˉobject() -> bytes {
    let Textˉsection: Wvoˉsection = Wvoˉsection(
        ".text", Wvoˉsectionˉkind.Code, 16u32, 6u32, Textˉcontents
    );
    let Messageˉsection: Wvoˉsection = Wvoˉsection(
        ".rodata", Wvoˉsectionˉkind.Readˉonlyˉdata, 1u32, 3u32, Messageˉcontents
    );
    let Messageˉsymbol: Wvoˉsymbol = Wvoˉsymbol(
        "Message", Wvoˉsymbolˉbinding.Local, Wvoˉsymbolˉkind.Data, 1u32, 0u32, 3u32
    );
    let Mainˉsymbol: Wvoˉsymbol = Wvoˉsymbol(
        "Main", Wvoˉsymbolˉbinding.Export, Wvoˉsymbolˉkind.Function, 0u32, 0u32, 6u32
    );
    let Consoleˉsymbol: Wvoˉsymbol = Wvoˉsymbol(
        "Console_write",
        Wvoˉsymbolˉbinding.Import,
        Wvoˉsymbolˉkind.Function,
        4294967295u32,
        0u32,
        0u32
    );
    let Callˉrelocation: Wvoˉrelocation = Wvoˉrelocation(
        Wvoˉrelocationˉkind.Relativeˉi32, 0u32, 1u32, 2u32, -4
    );

    var Result: bytes = Encodeˉheader(2u32, 3u32, 1u32);
    Result = Append(Result, Encodeˉsection(Textˉsection));
    Result = Append(Result, Encodeˉsection(Messageˉsection));
    Result = Append(Result, Encodeˉsymbol(Messageˉsymbol));
    Result = Append(Result, Encodeˉsymbol(Mainˉsymbol));
    Result = Append(Result, Encodeˉsymbol(Consoleˉsymbol));
    return Append(Result, Encodeˉrelocation(Callˉrelocation));
}

fn Describeˉinspection(Result: Verification.Wvoˉinspection) -> text {
    var Description: text = Enumˉname(Result.Status);
    Description = Textˉconcat(Description, Textˉconcat(" sections=", U32ˉformat(Result.Sectionsˉseen)));
    Description = Textˉconcat(Description, Textˉconcat(" symbols=", U32ˉformat(Result.Symbolsˉseen)));
    Description = Textˉconcat(Description, Textˉconcat(" relocations=", U32ˉformat(Result.Relocationsˉseen)));
    return Textˉconcat(Description, Textˉconcat(" offset=", U32ˉformat(Result.Failureˉoffset)));
}

fn Runˉselfˉtests() -> i32 {
    let Object: bytes = Buildˉsampleˉobject();
    if Bytesˉlength(Object) != 189u32 { return 11; }
    if Bytesˉreadˉu32ˉlittle(Object, 12u32) != 2u32 { return 12; }
    if Bytesˉreadˉu32ˉlittle(Object, 16u32) != 3u32 { return 13; }
    if Bytesˉreadˉu32ˉlittle(Object, 20u32) != 1u32 { return 14; }
    if Bytesˉreadˉi32ˉlittle(Object, 185u32) != -4 { return 15; }

    let Inspection: Verification.Wvoˉinspection = Verification.Inspectˉobject(Object);
    if Inspection.Status != Verification.Wvoˉstatus.Valid { return 16; }
    if Inspection.Sectionsˉseen != 2u32 { return 17; }
    if Inspection.Symbolsˉseen != 3u32 { return 18; }
    if Inspection.Relocationsˉseen != 1u32 { return 19; }
    if Inspection.Failureˉoffset != 189u32 { return 20; }
    let Quoted: bytes = Textˉtoˉutf8(Textˉquote("WVO"));
    if Bytesˉlength(Quoted) != 5u32 { return 21; }
    if Bytesˉreadˉu8(Quoted, 0u32) != 34u8 { return 22; }
    if Bytesˉreadˉu8(Quoted, 4u32) != 34u8 { return 23; }
    Describeˉinspection(Inspection);
    return 0;
}

fn Byteˉvaluesˉareˉequal(Left: bytes, Right: bytes) -> bool {
    let Length: u32 = Bytesˉlength(Left);
    if Length != Bytesˉlength(Right) { return false; }
    var Index: u32 = 0u32;
    while Index < Length {
        if Bytesˉreadˉu8(Left, Index) != Bytesˉreadˉu8(Right, Index) { return false; }
        Index = Index + 1u32;
    }
    return true;
}

fn Textˉfromˉspan(Input: bytes, Offset: u32, Length: u32) -> text {
    return Textˉfromˉutf8(Bytesˉslice(Input, Offset, Length));
}

fn Sectionˉkindˉname(Value: u32) -> text {
    if Value == 1u32 { return "Code"; }
    if Value == 2u32 { return "Readˉonlyˉdata"; }
    if Value == 3u32 { return "Writableˉdata"; }
    return "Zeroˉfill";
}

fn Symbolˉbindingˉname(Value: u32) -> text {
    if Value == 1u32 { return "Local"; }
    if Value == 2u32 { return "Export"; }
    return "Import";
}

fn Symbolˉkindˉname(Value: u32) -> text {
    if Value == 1u32 { return "Function"; }
    return "Data";
}

fn Relocationˉkindˉname(Value: u32) -> text {
    if Value == 1u32 { return "Absoluteˉu32"; }
    return "Relativeˉi32";
}

fn Objectˉsha256(Input: bytes) -> text {
    var State: Sha256.Foundationˉsha256ˉstream =
        Sha256.Foundationˉsha256ˉbegin(Input);
    State = Sha256.Foundationˉsha256ˉupdate(State, Input);
    let Digest: bytes = Sha256.Foundationˉsha256ˉfinishˉraw(State);
    if Bytesˉlength(Digest) != 32u32 { return ""; }

    var Output: bytes = Bytesˉslice(Digest, 0u32, 0u32);
    var Index: u32 = 0u32;
    while Index < 32u32 {
        let Value: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(Digest, Index));
        var High: u32 = Value >> 4u32;
        var Low: u32 = Value & 15u32;
        if High < 10u32 { High = High + 48u32; }
        else { High = High + 87u32; }
        if Low < 10u32 { Low = Low + 48u32; }
        else { Low = Low + 87u32; }
        Output = Bytesˉconcat(
            Output,
            Bytesˉslice(Bytesˉfromˉu32ˉlittle(High), 0u32, 1u32)
        );
        Output = Bytesˉconcat(
            Output,
            Bytesˉslice(Bytesˉfromˉu32ˉlittle(Low), 0u32, 1u32)
        );
        Index = Index + 1u32;
    }
    return Textˉfromˉutf8(Output);
}

fn Reportˉverifiedˉobject(Input: bytes) -> i32 {
    console.write_line("Verified object: X86ˉ64");
    console.write_line(Textˉconcat("SHA-256: ", Objectˉsha256(Input)));
    return 0;
}

fn Reportˉobjectˉinspection(Input: bytes) -> i32 {
    let Sectionˉcount: u32 = Bytesˉreadˉu32ˉlittle(Input, 12u32);
    let Symbolˉcount: u32 = Bytesˉreadˉu32ˉlittle(Input, 16u32);
    let Relocationˉcount: u32 = Bytesˉreadˉu32ˉlittle(Input, 20u32);
    let Sectionˉstart: u32 = 24u32;
    let Symbolˉstart: u32 = Verification.Sectionˉrecordsˉend(Input, Sectionˉcount);
    let Relocationˉstart: u32 = Verification.Symbolˉrecordsˉend(Input, Symbolˉstart, Symbolˉcount);

    console.write_line("Windvale object 1.0");
    console.write_line("Architecture: X86ˉ64");
    console.write_line(Textˉconcat("SHA-256: ", Objectˉsha256(Input)));
    console.write_line(Textˉconcat("Sections (", Textˉconcat(U32ˉformat(Sectionˉcount), ")")));
    var Sectionˉindex: u32 = 0u32;
    while Sectionˉindex < Sectionˉcount {
        let Section: Verification.Wvoˉsectionˉview = Verification.Findˉsection(
            Input,
            Sectionˉstart,
            Sectionˉcount,
            Sectionˉindex
        );
        var Sectionˉline: text = Textˉconcat("  [", U32ˉformat(Sectionˉindex));
        Sectionˉline = Textˉconcat(Sectionˉline, Textˉconcat("] ", Textˉfromˉspan(Input, Section.Nameˉoffset, Section.Nameˉlength)));
        Sectionˉline = Textˉconcat(Sectionˉline, Textˉconcat(" kind=", Sectionˉkindˉname(Section.Kind)));
        Sectionˉline = Textˉconcat(Sectionˉline, Textˉconcat(" align=", U32ˉformat(Section.Alignment)));
        Sectionˉline = Textˉconcat(Sectionˉline, Textˉconcat(" memory=", U32ˉformat(Section.Memoryˉsize)));
        Sectionˉline = Textˉconcat(Sectionˉline, Textˉconcat(" data=", U32ˉformat(Section.Dataˉlength)));
        console.write_line(Sectionˉline);
        Sectionˉindex = Sectionˉindex + 1u32;
    }

    console.write_line(Textˉconcat("Symbols (", Textˉconcat(U32ˉformat(Symbolˉcount), ")")));
    var Symbolˉindex: u32 = 0u32;
    while Symbolˉindex < Symbolˉcount {
        let Symbol: Verification.Wvoˉsymbolˉview = Verification.Findˉsymbol(
            Input, Symbolˉstart, Symbolˉcount, Symbolˉindex
        );
        var Symbolˉline: text = Textˉconcat("  [", U32ˉformat(Symbolˉindex));
        Symbolˉline = Textˉconcat(Symbolˉline, Textˉconcat("] ", Textˉfromˉspan(Input, Symbol.Nameˉoffset, Symbol.Nameˉlength)));
        Symbolˉline = Textˉconcat(Symbolˉline, Textˉconcat(" binding=", Symbolˉbindingˉname(Symbol.Binding)));
        Symbolˉline = Textˉconcat(Symbolˉline, Textˉconcat(" kind=", Symbolˉkindˉname(Symbol.Kind)));
        if Symbol.Sectionˉindex == 4294967295u32 {
            Symbolˉline = Textˉconcat(Symbolˉline, " section=undefined");
        } else {
            Symbolˉline = Textˉconcat(Symbolˉline, Textˉconcat(" section=", U32ˉformat(Symbol.Sectionˉindex)));
        }
        Symbolˉline = Textˉconcat(Symbolˉline, Textˉconcat(" offset=", U32ˉformat(Symbol.Offset)));
        Symbolˉline = Textˉconcat(Symbolˉline, Textˉconcat(" size=", U32ˉformat(Symbol.Size)));
        console.write_line(Symbolˉline);
        Symbolˉindex = Symbolˉindex + 1u32;
    }

    console.write_line(Textˉconcat("Relocations (", Textˉconcat(U32ˉformat(Relocationˉcount), ")")));
    var Relocationˉindex: u32 = 0u32;
    while Relocationˉindex < Relocationˉcount {
        let Relocation: Verification.Wvoˉrelocationˉview = Verification.Findˉrelocation(
            Input,
            Relocationˉstart,
            Relocationˉindex
        );
        var Relocationˉline: text = Textˉconcat("  [", U32ˉformat(Relocationˉindex));
        Relocationˉline = Textˉconcat(Relocationˉline, Textˉconcat("] kind=", Relocationˉkindˉname(Relocation.Kind)));
        Relocationˉline = Textˉconcat(Relocationˉline, Textˉconcat(" section=", U32ˉformat(Relocation.Sectionˉindex)));
        Relocationˉline = Textˉconcat(Relocationˉline, Textˉconcat(" offset=", U32ˉformat(Relocation.Offset)));
        Relocationˉline = Textˉconcat(Relocationˉline, Textˉconcat(" symbol=", U32ˉformat(Relocation.Symbolˉindex)));
        Relocationˉline = Textˉconcat(Relocationˉline, Textˉconcat(" addend=", I32ˉformat(Relocation.Addend)));
        console.write_line(Relocationˉline);
        Relocationˉindex = Relocationˉindex + 1u32;
    }
    return 0;
}

fn Runˉobjectˉcommand() -> i32 {
    if process.argument_count() != 2u32 {
        diagnostic.write_line("Usage: wvo-object-core <check|verify|inspect> <object.wvo>");
        return 64;
    }
    let Command: bytes = Textˉtoˉutf8(process.argument(0u32));
    let Check: bool = Byteˉvaluesˉareˉequal(Command, Textˉtoˉutf8("check"));
    let Verify: bool = Byteˉvaluesˉareˉequal(Command, Textˉtoˉutf8("verify"));
    let Inspect: bool = Byteˉvaluesˉareˉequal(Command, Textˉtoˉutf8("inspect"));
    if !Check && !Verify && !Inspect {
        diagnostic.write_line("Usage: wvo-object-core <check|verify|inspect> <object.wvo>");
        return 64;
    }
    let Input: bytes = file.read_bytes(process.argument(1u32));
    let Result: Verification.Wvoˉinspection = Verification.Inspectˉobject(Input);
    if Result.Status != Verification.Wvoˉstatus.Valid {
        diagnostic.write_line(Textˉconcat("object status=", Describeˉinspection(Result)));
        return 2;
    }
    if Check { return 0; }
    if Verify {
        return Reportˉverifiedˉobject(Input);
    }
    return Reportˉobjectˉinspection(Input);
}

export fn Main() -> i32 {
    if process.argument_count() == 0u32 { return Runˉselfˉtests(); }
    return Runˉobjectˉcommand();
}
