module Sourceˉwvbˉtextˉbytesˉinterpreter profile portable;

data Values: [i32] = [-3, 5, 8];
data Blob: bytes = [1, 2, 3, 4, 255];

fn Echoˉbytes(Value: bytes) -> bytes {
    return Bytesˉconcat(Bytesˉslice(Value, 0u32, 0u32), Value);
}

fn Joinˉtext(Left: text, Right: text) -> text {
    return Textˉconcat(Left, Right);
}

export fn Main() -> i32 {
    let Label: text = Joinˉtext("Hi \u03A9\u20AC\uD83D\uDE00", "!");
    let Labelˉbytes: bytes = Textˉtoˉutf8(Label);
    let Roundˉtrip: text = Textˉfromˉutf8(Labelˉbytes);
    let Built: bytes = Bytesˉconcat(
        Bytesˉconcat(
            Bytesˉfromˉu8(127u8),
            Bytesˉfromˉu16ˉlittle(4660u32)
        ),
        Bytesˉconcat(
            Bytesˉfromˉu32ˉlittle(2309737967u32),
            Bytesˉfromˉi32ˉlittle(-2)
        )
    );
    let Echoed: bytes = Echoˉbytes(Built);
    let Prefix: bytes = Bytesˉslice(Blob, 1u32, 3u32);
    let Invalid: bytes = Bytesˉfromˉu8(255u8);

    if length(Values) != 3 { return 1; }
    if Values[2] != 8 { return 2; }
    if Bytesˉlength(Labelˉbytes) != 13u32 { return 3; }
    if Bytesˉlength(Textˉtoˉutf8(Roundˉtrip)) != 13u32 { return 4; }
    if !Textˉutf8ˉisˉvalid(Labelˉbytes) { return 5; }
    if Bytesˉlength(Echoed) != 11u32 { return 6; }
    if Bytesˉreadˉu8(Echoed, 0u32) != 127u8 { return 7; }
    if Bytesˉreadˉu16ˉlittle(Echoed, 1u32) != 4660u32 { return 8; }
    if Bytesˉreadˉu32ˉlittle(Echoed, 3u32) != 2309737967u32 { return 9; }
    if Bytesˉreadˉi32ˉlittle(Echoed, 7u32) != -2 { return 10; }
    if Bytesˉreadˉu8(Prefix, 2u32) != 4u8 { return 11; }
    if Textˉutf8ˉisˉvalid(Invalid) { return 12; }
    return 42;
}
