module Matchˉfallthroughˉoracle profile portable;

enum State {
    Ready = 0;
    Running = 1;
    Done = 2;
}

fn Score(Value: State) -> i32 {
    var Result: i32 = 0;
    match Value {
        case State.Running { Result = 2; }
        case State.Ready { Result = 1; }
        case State.Done { Result = 3; }
    }
    return Result;
}

export fn Main() -> i32 {
    return Score(State.Done);
}
