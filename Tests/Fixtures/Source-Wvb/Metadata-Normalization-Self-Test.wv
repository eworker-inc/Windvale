fn Replaceˉu8(Input: bytes, Offset: u32, Value: u8) -> bytes {
    var Result: bytes = Bytesˉslice(Input, 0u32, Offset);
    Result = Bytesˉconcat(Result, Bytesˉfromˉu8(Value));
    return Bytesˉconcat(
        Result,
        Bytesˉslice(Input, Offset + 1u32, Bytesˉlength(Input) - Offset - 1u32)
    );
}

fn Bytesˉequal(Left: bytes, Right: bytes) -> bool {
    if Bytesˉlength(Left) != Bytesˉlength(Right) { return false; }
    var Index: u32 = 0u32;
    while Index < Bytesˉlength(Left) {
        if Bytesˉreadˉu8(Left, Index) != Bytesˉreadˉu8(Right, Index) {
            return false;
        }
        Index = Index + 1u32;
    }
    return true;
}

export fn Main() -> i32 {
    let Normalized: bytes =
        Metadata.Windvaleˉwvbˉmetadataˉnormalize(Metadataˉmodule);
    if Bytesˉlength(Normalized) != 282u32 { return 1; }
    let Repeated: bytes =
        Metadata.Windvaleˉwvbˉmetadataˉnormalize(Normalized);
    if !Bytesˉequal(Normalized, Repeated) { return 2; }

    let Badˉversion: bytes = Replaceˉu8(Metadataˉmodule, 48u32, 2u8);
    if Bytesˉlength(
        Metadata.Windvaleˉwvbˉmetadataˉnormalize(Badˉversion)
    ) != 0u32 { return 3; }

    let Requiredˉmismatch: bytes =
        Replaceˉu8(Metadataˉmodule, 151u32, 102u8);
    if Bytesˉlength(
        Metadata.Windvaleˉwvbˉmetadataˉnormalize(Requiredˉmismatch)
    ) != 0u32 { return 4; }
    return 0;
}
