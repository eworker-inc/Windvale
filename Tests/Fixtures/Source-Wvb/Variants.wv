module Variantˉoracle profile portable;

variant Outcome {
    Success(Value: i32);
    Failure(Value: u8);
    Empty;
}

fn Score(Value: Outcome) -> i32
{
    match Value {
        case Outcome.Success(Result) {
            return Result;
        }
        case Outcome.Failure(Result) {
            return 2;
        }
        case Outcome.Empty {
            return 3;
        }
    }
}

export fn Main() -> i32
{
    let Complete = Outcome.Success(42);
    let Empty = Outcome.Empty();
    return Score(Complete) + Score(Empty);
}
