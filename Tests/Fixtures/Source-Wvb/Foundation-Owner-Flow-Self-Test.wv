fn Operation(Opcode: u8, Slot: u32) -> bytes {
    return Bytesˉconcat(Bytesˉfromˉu8(Opcode), Bytesˉfromˉu32ˉlittle(Slot));
}

fn Borrow(Slot: u32) -> bytes {
    return Bytesˉconcat(Operation(225u8, Slot), Bytesˉconcat(
        Bytesˉfromˉu32ˉlittle(0u32), Bytesˉfromˉu32ˉlittle(1u32)));
}

fn Flow(Code: bytes, Shapes: bytes, Parameters: u32, Work: u32) -> Owners.Flowˉresult {
    let Control: Directories.Hˉcontrolˉdirectory =
        Directories.Iˉcontrolˉdirectory(Code, 0u32, Bytesˉlength(Code));
    return Owners.Check(Code, 0u32, Bytesˉlength(Code), Shapes, Parameters, Control, Work);
}

fn Rule(Code: bytes, Shapes: bytes, Parameters: u32) -> u32 {
    let Result: Owners.Flowˉresult = Flow(Code, Shapes, Parameters, 16777216u32);
    return Result.Rule;
}

// Synthetic streams isolate owner-state transfer, not operand-stack validity.
// The final cases use the actual compiler-published candidate module instead.
export fn Main() -> i32 {
    let Shape: bytes = Operation(11u8, 0u32);
    let Return: bytes = Bytesˉfromˉu8(81u8);
    let Store: bytes = Operation(5u8, 0u32);
    let Take: bytes = Operation(205u8, 0u32);
    let Loan: bytes = Borrow(0u32);
    let Valid: bytes = Bytesˉconcat(Store, Bytesˉconcat(Loan, Return));
    if Rule(Valid, Shape, 0u32) != 0u32 { return 1; }
    if Rule(Bytesˉconcat(Loan, Return), Shape, 1u32) != 0u32 { return 2; }
    if Rule(Bytesˉconcat(Loan, Return), Shape, 0u32) != 3u32 { return 3; }
    if Rule(Bytesˉconcat(Store, Bytesˉconcat(Take, Bytesˉconcat(Loan, Return))), Shape, 0u32) != 3u32 {
        return 4;
    }
    if Rule(Bytesˉconcat(Store, Bytesˉconcat(Loan, Bytesˉconcat(Store, Return))), Shape, 0u32) != 4u32 ||
        Rule(Bytesˉconcat(Store, Bytesˉconcat(Loan, Bytesˉconcat(Take, Return))), Shape, 0u32) != 4u32 {
        return 5;
    }
    if Rule(Bytesˉconcat(Store, Bytesˉconcat(Loan, Bytesˉconcat(Loan, Return))), Shape, 0u32) != 0u32 {
        return 6;
    }
    let Bothˉinitialized: bytes = Bytesˉconcat(Operation(49u8, 15u32), Bytesˉconcat(
        Store, Bytesˉconcat(Operation(48u8, 25u32), Bytesˉconcat(Store,
            Bytesˉconcat(Operation(48u8, 25u32), Bytesˉconcat(Loan, Return))))));
    if Rule(Bothˉinitialized, Shape, 0u32) != 0u32 { return 7; }
    let Oneˉinitialized: bytes = Bytesˉconcat(Operation(49u8, 15u32), Bytesˉconcat(
        Store, Bytesˉconcat(Operation(48u8, 20u32), Bytesˉconcat(
            Operation(48u8, 20u32), Bytesˉconcat(Loan, Return)))));
    if Rule(Oneˉinitialized, Shape, 0u32) != 3u32 { return 8; }
    let Oneˉfrozen: bytes = Bytesˉconcat(Operation(49u8, 23u32), Bytesˉconcat(
        Loan, Bytesˉconcat(Operation(48u8, 28u32), Bytesˉconcat(Operation(48u8, 28u32),
            Bytesˉconcat(Store, Return)))));
    if Rule(Oneˉfrozen, Shape, 1u32) != 4u32 { return 9; }
    let Loop: bytes = Bytesˉconcat(Store, Bytesˉconcat(Operation(48u8, 10u32),
        Bytesˉconcat(Loan, Operation(48u8, 10u32))));
    if Rule(Loop, Shape, 0u32) != 0u32 { return 10; }
    let Loopˉwrite: bytes = Bytesˉconcat(Store, Bytesˉconcat(Operation(48u8, 10u32),
        Bytesˉconcat(Store, Bytesˉconcat(Loan, Operation(48u8, 10u32)))));
    if Rule(Loopˉwrite, Shape, 0u32) != 4u32 { return 11; }
    let Other: bytes = Bytesˉconcat(Shape, Shape);
    if Rule(Bytesˉconcat(Loan, Bytesˉconcat(Operation(5u8, 1u32), Return)), Other, 1u32) != 0u32 {
        return 12;
    }
    let Twoˉowners: bytes = Bytesˉconcat(Loan, Bytesˉconcat(Borrow(1u32), Return));
    if Rule(Twoˉowners, Other, 2u32) != 0u32 ||
        Rule(Twoˉowners, Other, 1u32) != 3u32 { return 12; }
    if Rule(Bytesˉconcat(Loan, Return), Operation(75u8, 0u32), 1u32) != 6u32 ||
        Rule(Bytesˉconcat(Borrow(1u32), Return), Shape, 1u32) != 6u32 { return 13; }
    let Limited: Owners.Flowˉresult = Flow(Valid, Shape, 0u32, 1u32);
    let Badˉlimit: Owners.Flowˉresult = Flow(Valid, Shape, 0u32, 16777217u32);
    if Limited.Valid || Limited.Rule != 5u32 || Limited.Work > 1u32 ||
        Badˉlimit.Valid || Badˉlimit.Rule != 1u32 { return 14; }
    if Rule(Valid, Bytesˉfromˉu8(11u8), 0u32) != 1u32 ||
        Rule(Valid, Shape, 2u32) != 1u32 ||
        Rule(Bytesˉslice(Loan, 0u32, 12u32), Shape, 1u32) != 1u32 { return 14; }
    if Rule(Bytesˉconcat(Loan, Operation(48u8, 1u32)), Shape, 1u32) != 2u32 ||
        Rule(Bytesˉconcat(Loan, Operation(49u8, 0u32)), Shape, 1u32) != 2u32 { return 15; }
    var Chain: bytes = Bytesˉslice(Return, 0u32, 0u32);
    var Index: u32 = 0u32;
    while Index < 127u32 {
        Chain = Bytesˉconcat(Chain, Operation(48u8, (Index + 1u32) * 5u32));
        Index = Index + 1u32;
    }
    if Rule(Bytesˉconcat(Chain, Bytesˉconcat(Loan, Return)), Shape, 1u32) != 0u32 ||
        Rule(Bytesˉconcat(Chain, Bytesˉconcat(Operation(48u8, 640u32),
            Bytesˉconcat(Loan, Return))), Shape, 1u32) != 5u32 ||
        Rule(Bytesˉconcat(Chain, Bytesˉconcat(Operation(48u8, 640u32), Return)), Shape, 1u32) != 0u32 {
