module Sourceˉwvbˉfixture profile portable;

const START_INDEX: u32 = 0u32;
const ITERATIONS: u32 = 1u32 + 2u32;
const STEP: i32 = 1 + 1;
const THRESHOLD: i32 = STEP * 3;
const MAXIMUM_BYTE: u8 = 255u8;
const ENABLED: bool = true;

fn Add(
    Left: i32,
    Right: i32,
) -> i32 {
    return Left + Right;
}

export fn Main() -> i32 {
    var Index = START_INDEX;
    var Total = 0;
    while Index < ITERATIONS {
        Total = Add(
            Total,
            STEP,
        );
        Index = Index + 1u32;
    }
    if Probe(MAXIMUM_BYTE, ENABLED) {
        return Select(Total);
    }
    return 1;
}

fn Probe(
    Byte: u8,
    Enabled: bool,
) -> bool {
    if Byte == 255u8 {
        return !(!Enabled);
    }
    return false;
}

fn Select(Value: i32) -> i32 {
    if Value >= THRESHOLD {
        return Value;
    }
    return 0;
}
