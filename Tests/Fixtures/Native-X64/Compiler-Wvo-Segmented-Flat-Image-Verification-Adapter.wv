module Linkerˉcompilerˉwvoˉsegmentedˉflatˉimageˉverificationˉtest profile portable;

import Linkerˉcompilerˉwvoˉsegmentedˉflatˉimageˉverification as Verification;

fn Empty(Input: bytes) -> bytes {
    return Bytesˉslice(Input, 0u32, 0u32);
}

fn Appendˉu32(Output: bytes, Value: u32) -> bytes {
    return Bytesˉconcat(Output, Bytesˉfromˉu32ˉlittle(Value));
}

fn Statusˉvalue(
    Status:
        Verification.Linkerˉcompilerˉwvoˉsegmentedˉverificationˉstatus
) -> u32 {
    if Status ==
        Verification.Linkerˉcompilerˉwvoˉsegmentedˉverificationˉstatus.Active {
        return 0u32;
    }
    if Status ==
        Verification.Linkerˉcompilerˉwvoˉsegmentedˉverificationˉstatus.Complete {
        return 1u32;
    }
    if Status ==
        Verification.Linkerˉcompilerˉwvoˉsegmentedˉverificationˉstatus.Manifest {
        return 2u32;
    }
    if Status ==
        Verification.Linkerˉcompilerˉwvoˉsegmentedˉverificationˉstatus.Envelope {
        return 3u32;
    }
    if Status ==
        Verification.Linkerˉcompilerˉwvoˉsegmentedˉverificationˉstatus.Symbols {
        return 4u32;
    }
    if Status ==
        Verification.Linkerˉcompilerˉwvoˉsegmentedˉverificationˉstatus.Relocations {
        return 5u32;
    }
    if Status ==
        Verification.Linkerˉcompilerˉwvoˉsegmentedˉverificationˉstatus.Invalidˉcursor {
        return 6u32;
    }
    if Status ==
        Verification.Linkerˉcompilerˉwvoˉsegmentedˉverificationˉstatus.Chunkˉlength {
        return 7u32;
    }
    if Status ==
        Verification.Linkerˉcompilerˉwvoˉsegmentedˉverificationˉstatus.Chunkˉrange {
        return 8u32;
    }
    if Status ==
        Verification.Linkerˉcompilerˉwvoˉsegmentedˉverificationˉstatus.Source {
        return 9u32;
    }
    if Status ==
        Verification.Linkerˉcompilerˉwvoˉsegmentedˉverificationˉstatus.Candidateˉposition {
        return 10u32;
    }
    if Status ==
        Verification.Linkerˉcompilerˉwvoˉsegmentedˉverificationˉstatus.Candidateˉlength {
        return 11u32;
    }
    return 12u32;
}

fn Appendˉcursor(
    Output: bytes,
    Cursor:
        Verification.Linkerˉcompilerˉwvoˉsegmentedˉverificationˉcursor
) -> bytes {
    var Result: bytes = Appendˉu32(Output, Statusˉvalue(Cursor.Status));
    Result = Appendˉu32(Result, Cursor.Chunks);
    Result = Appendˉu32(Result, Cursor.Nextˉchunk);
    Result = Appendˉu32(Result, Cursor.Imageˉposition);
    return Appendˉu32(Result, Cursor.Imageˉbytes);
}

export fn Main(Input: bytes) -> bytes {
    let Length: u32 = Bytesˉlength(Input);
    if Length < 32u32 { return Empty(Input); }
    let Manifestˉbytes: u32 = Bytesˉreadˉu32ˉlittle(Input, 0u32);
    let Prefixˉbytes: u32 = Bytesˉreadˉu32ˉlittle(Input, 4u32);
    let Readˉonlyˉheaderˉbytes: u32 =
        Bytesˉreadˉu32ˉlittle(Input, 8u32);
    let Symbolˉbytes: u32 = Bytesˉreadˉu32ˉlittle(Input, 12u32);
    let Relocationˉbytes: u32 = Bytesˉreadˉu32ˉlittle(Input, 16u32);
    let Candidateˉposition: u32 = Bytesˉreadˉu32ˉlittle(Input, 20u32);
    let Sourceˉbytes: u32 = Bytesˉreadˉu32ˉlittle(Input, 24u32);
    let Candidateˉbytes: u32 = Bytesˉreadˉu32ˉlittle(Input, 28u32);
    if Manifestˉbytes > Length - 32u32 { return Empty(Input); }
    let Afterˉmanifest: u32 = 32u32 + Manifestˉbytes;
    if Prefixˉbytes > Length - Afterˉmanifest { return Empty(Input); }
    let Afterˉprefix: u32 = Afterˉmanifest + Prefixˉbytes;
    if Readˉonlyˉheaderˉbytes > Length - Afterˉprefix {
        return Empty(Input);
    }
    let Afterˉreadˉonlyˉheader: u32 =
        Afterˉprefix + Readˉonlyˉheaderˉbytes;
    if Symbolˉbytes > Length - Afterˉreadˉonlyˉheader {
        return Empty(Input);
    }
    let Afterˉsymbols: u32 = Afterˉreadˉonlyˉheader + Symbolˉbytes;
    if Relocationˉbytes > Length - Afterˉsymbols { return Empty(Input); }
    let Afterˉrelocations: u32 = Afterˉsymbols + Relocationˉbytes;
    if Sourceˉbytes > Length - Afterˉrelocations { return Empty(Input); }
    let Afterˉsource: u32 = Afterˉrelocations + Sourceˉbytes;
    if Candidateˉbytes != Length - Afterˉsource { return Empty(Input); }

    let Stagingˉmanifest: bytes =
        Bytesˉslice(Input, 32u32, Manifestˉbytes);
    let Prefix: bytes =
        Bytesˉslice(Input, Afterˉmanifest, Prefixˉbytes);
    let Readˉonlyˉheader: bytes = Bytesˉslice(
        Input,
        Afterˉprefix,
        Readˉonlyˉheaderˉbytes
    );
    let Symbolˉchunk: bytes = Bytesˉslice(
        Input,
        Afterˉreadˉonlyˉheader,
        Symbolˉbytes
    );
    let Relocationˉchunk: bytes = Bytesˉslice(
        Input,
        Afterˉsymbols,
        Relocationˉbytes
    );
    let Sourceˉchunk: bytes = Bytesˉslice(
        Input,
        Afterˉrelocations,
        Sourceˉbytes
    );
    let Candidateˉchunk: bytes = Bytesˉslice(
        Input,
        Afterˉsource,
        Candidateˉbytes
    );

    let Begin:
        Verification.Linkerˉcompilerˉwvoˉsegmentedˉverificationˉcursor =
        Verification.Linkerˉcompilerˉwvoˉsegmentedˉverificationˉbegin(
            Stagingˉmanifest,
            Prefix,
            Readˉonlyˉheader,
            Symbolˉchunk,
            Relocationˉchunk
        );
    let Emptyˉcandidate: bytes = Empty(Input);
    let Afterˉprefixˉcursor:
        Verification.Linkerˉcompilerˉwvoˉsegmentedˉverificationˉcursor =
        Verification.Linkerˉcompilerˉwvoˉsegmentedˉverificationˉnext(
            Stagingˉmanifest,
            Prefix,
            Readˉonlyˉheader,
            Symbolˉchunk,
            Relocationˉchunk,
            Begin,
            Prefix,
            0u32,
            Emptyˉcandidate
        );
    let Next:
        Verification.Linkerˉcompilerˉwvoˉsegmentedˉverificationˉcursor =
        Verification.Linkerˉcompilerˉwvoˉsegmentedˉverificationˉnext(
            Stagingˉmanifest,
            Prefix,
            Readˉonlyˉheader,
            Symbolˉchunk,
            Relocationˉchunk,
            Afterˉprefixˉcursor,
            Sourceˉchunk,
            Candidateˉposition,
            Candidateˉchunk
        );
    return Appendˉcursor(
        Appendˉcursor(Textˉtoˉutf8("WVVF"), Begin),
        Next
    );
}
