module Wvbˉtoˉwvoˉfileˉreadˉbytes profile hosted;

capability file.read_bytes;
capability process.argument;

export fn Main() -> i32 {
    let Value: bytes = file.read_bytes(process.argument(0u32));
    if Bytesˉlength(Value) != 1u32 { return 1; }
    if Bytesˉreadˉu8(Value, 0u32) == 65u8 { return 42; }
    return 2;
}
