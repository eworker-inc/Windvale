module Nativeˉrecordˉstorageˉpackedˉresult profile portable;

import Compilerˉnativeˉx64ˉloweringˉrecordˉstorage as Storage;

fn Empty() -> bytes {
    let Value: bytes = Textˉtoˉutf8("");
    return Bytesˉslice(Value, 0u32, 0u32);
}

fn Header(
    Magic: u32,
    Version: u32,
    Persistentˉfields: u32,
    Scratchˉfields: u32,
    Recordˉvalues: u32,
    Persistentˉbytes: u32,
    Scratchˉbytes: u32,
    Scratchˉblockˉbytes: u32
) -> bytes {
    var Result: bytes = Bytesˉfromˉu32ˉlittle(Magic);
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Version));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Persistentˉfields));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Scratchˉfields));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Recordˉvalues));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Persistentˉbytes));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Scratchˉbytes));
    return Bytesˉconcat(
        Result,
        Bytesˉfromˉu32ˉlittle(Scratchˉblockˉbytes)
    );
}

fn Decodesˉvalid(Input: bytes) -> bool {
    let Decoded: Storage.Compilerˉnativeˉx64ˉrecordˉstorage =
        Storage.Compilerˉnativeˉx64ˉrecordˉstorageˉdecode(Input);
    return Decoded.Valid;
}

export fn Main() -> i32 {
    if Decodesˉvalid(Empty()) {
        return 1;
    }
    var Encoded: bytes = Header(
        1381193303u32,
        2u32,
        3u32,
        5u32,
        2u32,
        4u32,
        4u32,
        4u32
    );
    Encoded = Bytesˉconcat(Encoded, Bytesˉfromˉu32ˉlittle(7u32));
    Encoded = Bytesˉconcat(Encoded, Bytesˉfromˉu32ˉlittle(9u32));
    Encoded = Bytesˉconcat(Encoded, Bytesˉfromˉu32ˉlittle(0u32));
    let Decoded: Storage.Compilerˉnativeˉx64ˉrecordˉstorage =
        Storage.Compilerˉnativeˉx64ˉrecordˉstorageˉdecode(Encoded);
    if !Decoded.Valid || Decoded.Persistentˉfields != 3u32 ||
        Decoded.Scratchˉfields != 5u32 || Decoded.Recordˉvalues != 2u32 {
        return 2;
    }
    if Bytesˉlength(Decoded.Persistentˉoffsets) != 4u32 ||
        Bytesˉreadˉu32ˉlittle(Decoded.Persistentˉoffsets, 0u32) != 7u32 {
        return 3;
    }
    if Bytesˉlength(Decoded.Scratchˉoffsets) != 4u32 ||
        Bytesˉreadˉu32ˉlittle(Decoded.Scratchˉoffsets, 0u32) != 9u32 {
        return 4;
    }
    if Bytesˉlength(Decoded.Scratchˉblockˉoffsets) != 4u32 ||
        Bytesˉreadˉu32ˉlittle(
            Decoded.Scratchˉblockˉoffsets,
            0u32
        ) != 0u32 {
        return 5;
    }
    if Decodesˉvalid(
        Header(0u32, 2u32, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32)
    ) { return 6; }
    if Decodesˉvalid(
        Header(1381193303u32, 3u32, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32)
    ) { return 7; }
    if Decodesˉvalid(
        Header(1381193303u32, 2u32, 0u32, 0u32, 0u32, 1u32, 0u32, 0u32)
    ) { return 8; }
    if Decodesˉvalid(
        Header(1381193303u32, 2u32, 0u32, 0u32, 0u32, 4u32, 4u32, 0u32)
    ) { return 9; }
    if Decodesˉvalid(
        Header(1381193303u32, 2u32, 0u32, 0u32, 257u32, 0u32, 0u32, 0u32)
    ) { return 10; }
    return 42;
}
