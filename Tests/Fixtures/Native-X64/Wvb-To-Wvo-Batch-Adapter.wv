module Compilerˉnativeˉx64ˉloweringˉbatchˉtest profile portable;

import Compilerˉnativeˉx64ˉlowering as Nativeˉx64;
import Compilerˉnativeˉx64ˉloweringˉpublication as Publication;

fn Appendˉu32(Output: bytes, Value: u32) -> bytes {
    return Bytesˉconcat(Output, Bytesˉfromˉu32ˉlittle(Value));
}

export fn Main(Input: bytes) -> bytes {
    let Plan: Nativeˉx64.Compilerˉnativeˉx64ˉplan =
        Nativeˉx64.Compilerˉnativeˉx64ˉplanˉbuild(Input);
    if Plan.Status != Nativeˉx64.Compilerˉnativeˉx64ˉstatus.Valid {
        return Bytesˉslice(Input, 0u32, 0u32);
    }
    var Evidence: bytes = Bytesˉslice(Input, 0u32, 0u32);
    var Firstˉfunction: u32 = 0u32;
    while Firstˉfunction < Plan.Functionˉcount {
        let Batch: Nativeˉx64.Compilerˉnativeˉx64ˉfunctionˉbatch =
            Nativeˉx64.Compilerˉnativeˉx64ˉfunctionˉbatchˉemit(
                Input,
                Plan,
                Firstˉfunction,
                1024u32
            );
        if Batch.Status != Nativeˉx64.Compilerˉnativeˉx64ˉstatus.Valid ||
            Batch.Functionˉcount == 0u32 ||
            Batch.Nextˉfunction <= Firstˉfunction {
            return Bytesˉslice(Input, 0u32, 0u32);
        }
        Evidence = Appendˉu32(Evidence, Batch.Firstˉfunction);
        Evidence = Appendˉu32(Evidence, Batch.Functionˉcount);
        Evidence = Appendˉu32(Evidence, Batch.Nextˉfunction);
        Evidence = Appendˉu32(Evidence, Bytesˉlength(Batch.Artifacts));
        Evidence = Appendˉu32(
            Evidence,
            Bytesˉreadˉu32ˉlittle(Batch.Artifacts, 8u32)
        );
        Evidence = Appendˉu32(
            Evidence,
            Bytesˉreadˉu32ˉlittle(Batch.Artifacts, 12u32)
        );
        Firstˉfunction = Batch.Nextˉfunction;
    }

    let Regions: Publication.Compilerˉnativeˉx64ˉpublicationˉregions =
        Publication.Compilerˉnativeˉx64ˉpublicationˉregionsˉbuild(
            Input,
            Plan,
            1024u32
        );
    if !Regions.Valid { return Bytesˉslice(Input, 0u32, 0u32); }
    var Cursor: Publication.Compilerˉnativeˉx64ˉpublicationˉcursor =
        Publication.Compilerˉnativeˉx64ˉpublicationˉbegin(Regions);
    if !Cursor.Valid { return Bytesˉslice(Input, 0u32, 0u32); }
    let Wrongˉcursor: Publication.Compilerˉnativeˉx64ˉpublicationˉcursor =
        Publication.Compilerˉnativeˉx64ˉpublicationˉcursor(
            true,
            Publication.Compilerˉnativeˉx64ˉpublicationˉkind.Prefix,
            0u32,
            1u32
        );
    let Cursorˉrejection: Publication.Compilerˉnativeˉx64ˉpublicationˉstep =
        Publication.Compilerˉnativeˉx64ˉpublicationˉnext(
            Input,
            Plan,
            Regions,
            Wrongˉcursor,
            1024u32
        );
    if Cursorˉrejection.Status !=
        Publication.Compilerˉnativeˉx64ˉpublicationˉstatus.Invalidˉcursor {
        return Bytesˉslice(Input, 0u32, 0u32);
    }
    var Object: bytes = Bytesˉslice(Input, 0u32, 0u32);
    var Steps: u32 = 0u32;
    while Cursor.Kind !=
        Publication.Compilerˉnativeˉx64ˉpublicationˉkind.Complete {
        let Step: Publication.Compilerˉnativeˉx64ˉpublicationˉstep =
            Publication.Compilerˉnativeˉx64ˉpublicationˉnext(
                Input,
                Plan,
                Regions,
                Cursor,
                1024u32
            );
        if Step.Status !=
                Publication.Compilerˉnativeˉx64ˉpublicationˉstatus.Valid ||
            !Step.Nextˉvalid || Step.Position != Bytesˉlength(Object) {
            return Bytesˉslice(Input, 0u32, 0u32);
        }
        Object = Bytesˉconcat(Object, Step.Value);
        Cursor = Publication.Compilerˉnativeˉx64ˉpublicationˉcursor(
            Step.Nextˉvalid,
            Step.Nextˉkind,
            Step.Nextˉfunction,
            Step.Nextˉposition
        );
        Steps = Steps + 1u32;
        if Steps > Plan.Functionˉcount + 7u32 {
            return Bytesˉslice(Input, 0u32, 0u32);
        }
    }
    let Complete: Publication.Compilerˉnativeˉx64ˉpublicationˉstep =
        Publication.Compilerˉnativeˉx64ˉpublicationˉnext(
            Input,
            Plan,
            Regions,
            Cursor,
            1024u32
        );
    if Complete.Status !=
            Publication.Compilerˉnativeˉx64ˉpublicationˉstatus.Complete ||
        Bytesˉlength(Object) != Regions.Objectˉbytes {
        return Bytesˉslice(Input, 0u32, 0u32);
    }
    var Output: bytes = Textˉtoˉutf8("WVPE");
    Output = Appendˉu32(Output, Bytesˉlength(Evidence));
    Output = Appendˉu32(Output, Steps);
    Output = Appendˉu32(Output, Bytesˉlength(Object));
    return Bytesˉconcat(Bytesˉconcat(Output, Evidence), Object);
}
