module Compilerˉnativeˉx64ˉstagingˉwvoˉrelocationsˉtest profile portable;

import Compilerˉnativeˉx64ˉloweringˉstagingˉwvoˉrelocationsˉnativeˉbridge as Bridge;

fn Empty(Input: bytes) -> bytes {
    return Bytesˉslice(Input, 0u32, 0u32);
}

fn Appendˉu32(Output: bytes, Value: u32) -> bytes {
    return Bytesˉconcat(Output, Bytesˉfromˉu32ˉlittle(Value));
}

export fn Main(Input: bytes) -> bytes {
    let Length: u32 = Bytesˉlength(Input);
    if Length < 28u32 { return Empty(Input); }
    let Manifestˉbytes: u32 = Bytesˉreadˉu32ˉlittle(Input, 0u32);
    let Prefixˉbytes: u32 = Bytesˉreadˉu32ˉlittle(Input, 4u32);
    let Readˉonlyˉheaderˉbytes: u32 =
        Bytesˉreadˉu32ˉlittle(Input, 8u32);
    let Symbolˉbytes: u32 = Bytesˉreadˉu32ˉlittle(Input, 12u32);
    let Relocationˉbytes: u32 = Bytesˉreadˉu32ˉlittle(Input, 16u32);
    let Chunkˉindex: u32 = Bytesˉreadˉu32ˉlittle(Input, 20u32);
    let Chunkˉbytes: u32 = Bytesˉreadˉu32ˉlittle(Input, 24u32);
    if Manifestˉbytes > Length - 28u32 { return Empty(Input); }
    let Afterˉmanifest: u32 = 28u32 + Manifestˉbytes;
    if Prefixˉbytes > Length - Afterˉmanifest { return Empty(Input); }
    let Afterˉprefix: u32 = Afterˉmanifest + Prefixˉbytes;
    if Readˉonlyˉheaderˉbytes > Length - Afterˉprefix {
        return Empty(Input);
    }
    let Afterˉreadˉonlyˉheader: u32 =
        Afterˉprefix + Readˉonlyˉheaderˉbytes;
    if Symbolˉbytes > Length - Afterˉreadˉonlyˉheader {
        return Empty(Input);
    }
    let Afterˉsymbols: u32 = Afterˉreadˉonlyˉheader + Symbolˉbytes;
    if Relocationˉbytes > Length - Afterˉsymbols { return Empty(Input); }
    let Afterˉrelocations: u32 = Afterˉsymbols + Relocationˉbytes;
    if Chunkˉbytes != Length - Afterˉrelocations { return Empty(Input); }

    let Stagingˉmanifest: bytes =
        Bytesˉslice(Input, 28u32, Manifestˉbytes);
    let Prefix: bytes =
        Bytesˉslice(Input, Afterˉmanifest, Prefixˉbytes);
    let Readˉonlyˉheader: bytes = Bytesˉslice(
        Input,
        Afterˉprefix,
        Readˉonlyˉheaderˉbytes
    );
    let Symbolˉchunk: bytes = Bytesˉslice(
        Input,
        Afterˉreadˉonlyˉheader,
        Symbolˉbytes
    );
    let Relocationˉchunk: bytes = Bytesˉslice(
        Input,
        Afterˉsymbols,
        Relocationˉbytes
    );
    let Chunk: bytes = Bytesˉslice(
        Input,
        Afterˉrelocations,
        Chunkˉbytes
    );

    var Output: bytes = Textˉtoˉutf8("WVRS");
    Output = Appendˉu32(
        Output,
        Bridge.Compilerˉnativeˉx64ˉstagingˉwvoˉrelocationsˉnativeˉvalidate(
            Stagingˉmanifest,
            Prefix,
            Readˉonlyˉheader,
            Symbolˉchunk,
            Relocationˉchunk
        )
    );
    Output = Appendˉu32(
        Output,
        Bridge.Compilerˉnativeˉx64ˉstagingˉwvoˉrelocationsˉnativeˉcodeˉbytes(
            Stagingˉmanifest,
            Prefix,
            Readˉonlyˉheader,
            Symbolˉchunk,
            Relocationˉchunk
        )
    );
    Output = Appendˉu32(
        Output,
        Bridge.Compilerˉnativeˉx64ˉstagingˉwvoˉrelocationsˉnativeˉtextˉchunks(
            Stagingˉmanifest,
            Prefix,
            Readˉonlyˉheader,
            Symbolˉchunk,
            Relocationˉchunk
        )
    );
    Output = Appendˉu32(
        Output,
        Bridge.Compilerˉnativeˉx64ˉstagingˉwvoˉrelocationsˉnativeˉcount(
            Stagingˉmanifest,
            Prefix,
            Readˉonlyˉheader,
            Symbolˉchunk,
            Relocationˉchunk
        )
    );
    return Appendˉu32(
        Output,
        Bridge.Compilerˉnativeˉx64ˉstagingˉwvoˉrelocationsˉnativeˉtextˉchunk(
            Stagingˉmanifest,
            Prefix,
            Readˉonlyˉheader,
            Symbolˉchunk,
            Relocationˉchunk,
            Chunkˉindex,
            Chunk
        )
    );
}
