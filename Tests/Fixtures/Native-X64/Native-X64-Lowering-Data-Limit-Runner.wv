#!wv/1 en@1
module Nativeˉx64ˉloweringˉdataˉlimitˉrunner;
profile core;
platform linux, windows, windvale;
authority application;

import Nativeˉx64ˉloweringˉdataˉlimitˉselfˉtest as Tests;

export fn Main() -> i32 {
    let Result: i32 = Tests.Main();
    if Result == 42 { return 42; }
    // Keep assertion groups distinct from the native runtime's trap statuses.
    return 100 + Result;
}
