module Wvbˉtoˉwvoˉu32ˉarithmetic profile portable;

fn Calculate(Left: u32, Right: u32) -> u32 {
    let Product = Left * Right;
    let Reduced = Product - 17u32;
    return Reduced + 17u32;
}

export fn Main() -> i32 {
    if Calculate(65535u32, 65535u32) != 4294836225u32 { return 1; }
    return 42;
}
