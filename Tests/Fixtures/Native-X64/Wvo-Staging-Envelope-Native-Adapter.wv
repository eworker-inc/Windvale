module Compilerˉnativeˉx64ˉstagingˉwvoˉenvelopeˉnativeˉtest profile portable;

import Compilerˉnativeˉx64ˉloweringˉstagingˉwvoˉnativeˉbridge as Bridge;

data Stagingˉmanifest: bytes = [
    87, 86, 79, 80, 1, 0, 0, 0,
    84, 0, 0, 0, 160, 0, 0, 0,
    5, 0, 0, 0, 0, 0, 64, 0,
    0, 0, 0, 0, 0, 0, 0, 0, 49, 0, 0, 0,
    1, 0, 0, 0, 49, 0, 0, 0, 10, 0, 0, 0,
    2, 0, 0, 0, 59, 0, 0, 0, 27, 0, 0, 0,
    3, 0, 0, 0, 86, 0, 0, 0, 5, 0, 0, 0,
    4, 0, 0, 0, 91, 0, 0, 0, 69, 0, 0, 0,
];

data Prefix: bytes = [
    87, 86, 79, 49, 1, 0, 0, 0,
    1, 0, 0, 0, 2, 0, 0, 0,
    2, 0, 0, 0, 1, 0, 0, 0,
    1, 0, 0, 0, 16, 0, 0, 0,
    10, 0, 0, 0, 10, 0, 0, 0,
    5, 0, 0, 0, 46, 116, 101, 120, 116,
];

data Invalidˉprefix: bytes = [
    88, 86, 79, 49, 1, 0, 0, 0,
    1, 0, 0, 0, 2, 0, 0, 0,
    2, 0, 0, 0, 1, 0, 0, 0,
    1, 0, 0, 0, 16, 0, 0, 0,
    10, 0, 0, 0, 10, 0, 0, 0,
    5, 0, 0, 0, 46, 116, 101, 120, 116,
];

data Readˉonlyˉheader: bytes = [
    2, 0, 0, 0, 16, 0, 0, 0,
    5, 0, 0, 0, 5, 0, 0, 0,
    7, 0, 0, 0, 46, 114, 111, 100, 97, 116, 97,
];

export fn Main() -> i32 {
    if Bridge.Compilerˉnativeˉx64ˉstagingˉwvoˉnativeˉvalidate(
        Stagingˉmanifest,
        Prefix,
        Readˉonlyˉheader
    ) != 0u32 { return 1; }
    if Bridge.Compilerˉnativeˉx64ˉstagingˉwvoˉnativeˉobjectˉbytes(
        Stagingˉmanifest,
        Prefix,
        Readˉonlyˉheader
    ) != 160u32 { return 2; }
    if Bridge.Compilerˉnativeˉx64ˉstagingˉwvoˉnativeˉsections(
        Stagingˉmanifest,
        Prefix,
        Readˉonlyˉheader
    ) != 2u32 { return 3; }
    if Bridge.Compilerˉnativeˉx64ˉstagingˉwvoˉnativeˉsymbols(
        Stagingˉmanifest,
        Prefix,
        Readˉonlyˉheader
    ) != 2u32 { return 4; }
    if Bridge.Compilerˉnativeˉx64ˉstagingˉwvoˉnativeˉrelocations(
        Stagingˉmanifest,
        Prefix,
        Readˉonlyˉheader
    ) != 1u32 { return 5; }
    if Bridge.Compilerˉnativeˉx64ˉstagingˉwvoˉnativeˉtextˉbytes(
        Stagingˉmanifest,
        Prefix,
        Readˉonlyˉheader
    ) != 10u32 { return 6; }
    if Bridge.Compilerˉnativeˉx64ˉstagingˉwvoˉnativeˉreadˉonlyˉbytes(
        Stagingˉmanifest,
        Prefix,
        Readˉonlyˉheader
    ) != 5u32 { return 7; }
    if Bridge.Compilerˉnativeˉx64ˉstagingˉwvoˉnativeˉsymbolˉposition(
        Stagingˉmanifest,
        Prefix,
        Readˉonlyˉheader
    ) != 91u32 { return 8; }
    if Bridge.Compilerˉnativeˉx64ˉstagingˉwvoˉnativeˉvalidate(
        Stagingˉmanifest,
        Invalidˉprefix,
        Readˉonlyˉheader
    ) != 4u32 { return 9; }
    if Bridge.Compilerˉnativeˉx64ˉstagingˉwvoˉnativeˉobjectˉbytes(
        Stagingˉmanifest,
        Invalidˉprefix,
        Readˉonlyˉheader
    ) != 0u32 { return 10; }
    return 42;
}
