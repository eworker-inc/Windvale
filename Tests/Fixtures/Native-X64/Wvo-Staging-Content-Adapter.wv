module Compilerˉnativeˉx64ˉstagingˉcontentˉtest profile portable;

import Compilerˉnativeˉx64ˉlowering as Nativeˉx64;
import Compilerˉnativeˉx64ˉloweringˉpublication as Publication;
import Compilerˉnativeˉx64ˉloweringˉstagingˉcontent as Content;

fn Empty(Input: bytes) -> bytes {
    return Bytesˉslice(Input, 0u32, 0u32);
}

fn Appendˉu32(Output: bytes, Value: u32) -> bytes {
    return Bytesˉconcat(Output, Bytesˉfromˉu32ˉlittle(Value));
}

fn Statusˉvalue(
    Status: Content.Compilerˉnativeˉx64ˉstagingˉcontentˉstatus
) -> u32 {
    if Status ==
        Content.Compilerˉnativeˉx64ˉstagingˉcontentˉstatus.Active {
        return 0u32;
    }
    if Status ==
        Content.Compilerˉnativeˉx64ˉstagingˉcontentˉstatus.Complete {
        return 1u32;
    }
    if Status ==
        Content.Compilerˉnativeˉx64ˉstagingˉcontentˉstatus.Invalidˉplan {
        return 2u32;
    }
    if Status ==
        Content.Compilerˉnativeˉx64ˉstagingˉcontentˉstatus.Invalidˉmanifest {
        return 3u32;
    }
    if Status ==
        Content.Compilerˉnativeˉx64ˉstagingˉcontentˉstatus.Invalidˉcursor {
        return 4u32;
    }
    if Status ==
        Content.Compilerˉnativeˉx64ˉstagingˉcontentˉstatus.Publication {
        return 5u32;
    }
    if Status ==
        Content.Compilerˉnativeˉx64ˉstagingˉcontentˉstatus.Manifestˉentry {
        return 6u32;
    }
    if Status ==
        Content.Compilerˉnativeˉx64ˉstagingˉcontentˉstatus.Chunkˉlength {
        return 7u32;
    }
    return 8u32;
}

fn Report(
    Beginˉstatus: Content.Compilerˉnativeˉx64ˉstagingˉcontentˉstatus,
    Stepˉstatus: Content.Compilerˉnativeˉx64ˉstagingˉcontentˉstatus,
    Finishˉstatus: Content.Compilerˉnativeˉx64ˉstagingˉcontentˉstatus,
    Processed: u32,
    Chunks: u32
) -> bytes {
    var Output: bytes = Textˉtoˉutf8("WVCE");
    Output = Appendˉu32(Output, Statusˉvalue(Beginˉstatus));
    Output = Appendˉu32(Output, Statusˉvalue(Stepˉstatus));
    Output = Appendˉu32(Output, Statusˉvalue(Finishˉstatus));
    Output = Appendˉu32(Output, Processed);
    return Appendˉu32(Output, Chunks);
}

fn Verifyˉchunks(
    Input: bytes,
    Wvb: bytes,
    Stagingˉmanifest: bytes,
    Suppliedˉchunks: u32,
    Chunksˉoffset: u32
) -> bytes {
    let Length: u32 = Bytesˉlength(Input);
    let Plan: Nativeˉx64.Compilerˉnativeˉx64ˉplan =
        Nativeˉx64.Compilerˉnativeˉx64ˉplanˉbuild(Wvb);
    let Regions: Publication.Compilerˉnativeˉx64ˉpublicationˉregions =
        Publication.Compilerˉnativeˉx64ˉpublicationˉregionsˉbuild(
            Wvb,
            Plan,
            4194304u32
        );
    var Cursor: Content.Compilerˉnativeˉx64ˉstagingˉcontentˉcursor =
        Content.Compilerˉnativeˉx64ˉstagingˉcontentˉbegin(
            Stagingˉmanifest,
            Plan,
            Regions
        );
    let Beginˉstatus: Content.Compilerˉnativeˉx64ˉstagingˉcontentˉstatus =
        Cursor.Status;
    var Stepˉstatus: Content.Compilerˉnativeˉx64ˉstagingˉcontentˉstatus =
        Cursor.Status;
    var Finishˉstatus: Content.Compilerˉnativeˉx64ˉstagingˉcontentˉstatus =
        Cursor.Status;
    var Processed: u32 = 0u32;
    var Chunkˉoffset: u32 = Chunksˉoffset;
    if Cursor.Status ==
        Content.Compilerˉnativeˉx64ˉstagingˉcontentˉstatus.Active {
        if Cursor.Chunks != Suppliedˉchunks {
            Stepˉstatus = Content.Compilerˉnativeˉx64ˉstagingˉcontentˉstatus
                .Manifestˉentry;
            Finishˉstatus = Stepˉstatus;
        }
    }
    var Continue: bool = true;
    while Continue {
        if Processed >= Suppliedˉchunks {
            Continue = false;
        } else if Stepˉstatus !=
            Content.Compilerˉnativeˉx64ˉstagingˉcontentˉstatus.Active {
            Continue = false;
        } else {
            let Actualˉlength: u32 = Bytesˉreadˉu32ˉlittle(
                Input,
                12u32 + Processed * 4u32
            );
            if Chunkˉoffset > Length {
                return Empty(Input);
            }
            if Actualˉlength > Length - Chunkˉoffset {
                return Empty(Input);
            }
            let Chunk: bytes = Bytesˉslice(
                Input,
                Chunkˉoffset,
                Actualˉlength
            );
            let Next: Content.Compilerˉnativeˉx64ˉstagingˉcontentˉcursor =
                Content.Compilerˉnativeˉx64ˉstagingˉcontentˉnext(
                    Wvb,
                    Plan,
                    Regions,
                    Stagingˉmanifest,
                    Cursor,
                    Chunk
                );
            Stepˉstatus = Next.Status;
            if Stepˉstatus ==
                Content.Compilerˉnativeˉx64ˉstagingˉcontentˉstatus.Active {
                Cursor = Next;
                Processed = Processed + 1u32;
                Chunkˉoffset = Chunkˉoffset + Actualˉlength;
            }
        }
    }
    if Stepˉstatus !=
        Content.Compilerˉnativeˉx64ˉstagingˉcontentˉstatus.Active {
        Finishˉstatus = Stepˉstatus;
    }
    if Stepˉstatus ==
        Content.Compilerˉnativeˉx64ˉstagingˉcontentˉstatus.Active {
        if Chunkˉoffset != Length {
            Stepˉstatus =
                Content.Compilerˉnativeˉx64ˉstagingˉcontentˉstatus.Content;
            Finishˉstatus = Stepˉstatus;
        } else {
            let Finished: Content.Compilerˉnativeˉx64ˉstagingˉcontentˉcursor =
                Content.Compilerˉnativeˉx64ˉstagingˉcontentˉfinish(
                    Wvb,
                    Plan,
                    Regions,
                    Stagingˉmanifest,
                    Cursor
                );
            Finishˉstatus = Finished.Status;
        }
    }
    return Report(
        Beginˉstatus,
        Stepˉstatus,
        Finishˉstatus,
        Processed,
        Cursor.Chunks
    );
}

export fn Main(Input: bytes) -> bytes {
    let Length: u32 = Bytesˉlength(Input);
    if Length < 12u32 { return Empty(Input); }
    let Wvbˉbytes: u32 = Bytesˉreadˉu32ˉlittle(Input, 0u32);
    let Manifestˉbytes: u32 = Bytesˉreadˉu32ˉlittle(Input, 4u32);
    let Suppliedˉchunks: u32 = Bytesˉreadˉu32ˉlittle(Input, 8u32);
    if Suppliedˉchunks > 518u32 { return Empty(Input); }
    let Directoryˉbytes: u32 = Suppliedˉchunks * 4u32;
    let Payloadˉoffset: u32 = 12u32 + Directoryˉbytes;
    if Payloadˉoffset > Length { return Empty(Input); }
    if Wvbˉbytes > Length - Payloadˉoffset { return Empty(Input); }
    let Manifestˉoffset: u32 = Payloadˉoffset + Wvbˉbytes;
    if Manifestˉbytes > Length - Manifestˉoffset { return Empty(Input); }
    let Chunksˉoffset: u32 = Manifestˉoffset + Manifestˉbytes;
    let Wvb: bytes = Bytesˉslice(Input, Payloadˉoffset, Wvbˉbytes);
    let Stagingˉmanifest: bytes = Bytesˉslice(
        Input,
        Manifestˉoffset,
        Manifestˉbytes
    );
    return Verifyˉchunks(
        Input,
        Wvb,
        Stagingˉmanifest,
        Suppliedˉchunks,
        Chunksˉoffset
    );
}
