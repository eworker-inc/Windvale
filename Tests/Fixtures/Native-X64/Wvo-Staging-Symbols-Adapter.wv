module Compilerˉnativeˉx64ˉstagingˉwvoˉsymbolsˉtest profile portable;

import Compilerˉnativeˉx64ˉloweringˉstagingˉwvoˉsymbolsˉnativeˉbridge as Bridge;

fn Empty(Input: bytes) -> bytes {
    return Bytesˉslice(Input, 0u32, 0u32);
}

fn Appendˉu32(Output: bytes, Value: u32) -> bytes {
    return Bytesˉconcat(Output, Bytesˉfromˉu32ˉlittle(Value));
}

export fn Main(Input: bytes) -> bytes {
    let Length: u32 = Bytesˉlength(Input);
    if Length < 16u32 { return Empty(Input); }
    let Manifestˉbytes: u32 = Bytesˉreadˉu32ˉlittle(Input, 0u32);
    let Prefixˉbytes: u32 = Bytesˉreadˉu32ˉlittle(Input, 4u32);
    let Readˉonlyˉheaderˉbytes: u32 =
        Bytesˉreadˉu32ˉlittle(Input, 8u32);
    let Symbolˉbytes: u32 = Bytesˉreadˉu32ˉlittle(Input, 12u32);
    if Manifestˉbytes > Length - 16u32 { return Empty(Input); }
    let Afterˉmanifest: u32 = 16u32 + Manifestˉbytes;
    if Prefixˉbytes > Length - Afterˉmanifest { return Empty(Input); }
    let Afterˉprefix: u32 = Afterˉmanifest + Prefixˉbytes;
    if Readˉonlyˉheaderˉbytes > Length - Afterˉprefix {
        return Empty(Input);
    }
    let Afterˉreadˉonlyˉheader: u32 =
        Afterˉprefix + Readˉonlyˉheaderˉbytes;
    if Symbolˉbytes != Length - Afterˉreadˉonlyˉheader {
        return Empty(Input);
    }
    let Stagingˉmanifest: bytes =
        Bytesˉslice(Input, 16u32, Manifestˉbytes);
    let Prefix: bytes =
        Bytesˉslice(Input, Afterˉmanifest, Prefixˉbytes);
    let Readˉonlyˉheader: bytes = Bytesˉslice(
        Input,
        Afterˉprefix,
        Readˉonlyˉheaderˉbytes
    );
    let Symbolˉchunk: bytes = Bytesˉslice(
        Input,
        Afterˉreadˉonlyˉheader,
        Symbolˉbytes
    );

    var Output: bytes = Textˉtoˉutf8("WVSS");
    Output = Appendˉu32(
        Output,
        Bridge.Compilerˉnativeˉx64ˉstagingˉwvoˉsymbolsˉnativeˉvalidate(
            Stagingˉmanifest,
            Prefix,
            Readˉonlyˉheader,
            Symbolˉchunk
        )
    );
    Output = Appendˉu32(
        Output,
        Bridge.Compilerˉnativeˉx64ˉstagingˉwvoˉsymbolsˉnativeˉdataˉsymbols(
            Stagingˉmanifest,
            Prefix,
            Readˉonlyˉheader,
            Symbolˉchunk
        )
    );
    Output = Appendˉu32(
        Output,
        Bridge.Compilerˉnativeˉx64ˉstagingˉwvoˉsymbolsˉnativeˉfunctions(
            Stagingˉmanifest,
            Prefix,
            Readˉonlyˉheader,
            Symbolˉchunk
        )
    );
    Output = Appendˉu32(
        Output,
        Bridge.Compilerˉnativeˉx64ˉstagingˉwvoˉsymbolsˉnativeˉrelocationˉposition(
            Stagingˉmanifest,
            Prefix,
            Readˉonlyˉheader,
            Symbolˉchunk
        )
    );
    return Appendˉu32(
        Output,
        Bridge.Compilerˉnativeˉx64ˉstagingˉwvoˉsymbolsˉnativeˉrelocationˉbytes(
            Stagingˉmanifest,
            Prefix,
            Readˉonlyˉheader,
            Symbolˉchunk
        )
    );
}
