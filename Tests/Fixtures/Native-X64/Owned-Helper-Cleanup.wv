#!wv/1 en@1
module Nativeˉownedˉhelperˉcleanup;
profile core;
platform linux, windows, windvale;
authority application;

import Foundationˉcollections as Collections;
import Foundationˉmemory as Memory;
import Foundationˉresult as Results;

fn Construct(Budget: Memory.Memoryˉbudget) -> Results.Result<Collections.Vector<i32>, Memory.Allocationˉfailure> {
    var Parent: Memory.Memoryˉbudget = Budget;
    let Child: Results.Result<Memory.Memoryˉbudget, Memory.Allocationˉfailure> =
        Memory.Split(borrow mut Parent, 48u64, 0u32);
    match Child {
        case Results.Result.Failure { Error: Refused } {
            // A different capacity makes unexpected split refusal observable.
            return Collections.Vectorˉconstructˉreserved::<i32>(Parent, 1u64);
        }
        case Results.Result.Valid { Value: Reserved } {
            return Collections.Vectorˉconstructˉreserved::<i32>(Reserved, 2u64);
        }
    }
}

fn Discardˉbudget(Budget: Memory.Memoryˉbudget) -> i32 { return 42; }

fn Discardˉsplit(Budget: Memory.Memoryˉbudget) -> i32 {
    var Parent: Memory.Memoryˉbudget = Budget;
    let Child: Results.Result<Memory.Memoryˉbudget, Memory.Allocationˉfailure> =
        Memory.Split(borrow mut Parent, 48u64, 0u32);
    return 42;
}

fn Discardˉvector(Values: Collections.Vector<i32>) -> i32 { return 42; }

fn Discardˉresult(Outcome: Results.Result<Collections.Vector<i32>, Memory.Allocationˉfailure>) -> i32 {
    return 42;
}

export fn Main(Budget: Memory.Memoryˉbudget) -> i32 {
    var Parent: Memory.Memoryˉbudget = Budget;
    var Count: i32 = 0;
    while Count < 1000 {
        let Child: Results.Result<Memory.Memoryˉbudget, Memory.Allocationˉfailure> =
            Memory.Split(borrow mut Parent, 48u64, 1u32);
        let Value: i32 = match Child {
            case Results.Result.Failure { Error: Refused } { 1 }
            case Results.Result.Valid { Value: Reserved } {
                if Count < 500 { Discardˉbudget(Reserved) }
                else {
                    if Count < 600 { Discardˉsplit(Reserved) }
                    else {
                        let Outcome: Results.Result<Collections.Vector<i32>, Memory.Allocationˉfailure> = Construct(Reserved);
                        if Count < 750 { Discardˉresult(Outcome) }
                        else {
                            match Outcome {
                                case Results.Result.Failure { Error: Vectorˉfailure } { 42 }
                                case Results.Result.Valid { Value: Values } { Discardˉvector(Values) }
                            }
                        }
                    }
                }
            }
        };
        if Value != 42 { return Value; }
        Count = Count + 1;
    }
    return 42;
}
