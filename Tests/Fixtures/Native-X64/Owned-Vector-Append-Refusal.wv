#!wv/1 en@1
module Nativeˉownedˉvectorˉappendˉrefusal;
profile core;
platform linux, windows, windvale;
authority application;

import Foundationˉcollections as Collections;
import Foundationˉmemory as Memory;
import Foundationˉresult as Results;

export fn Main(Budget: Memory.Memoryˉbudget) -> i32 {
    let Created: Results.Result<Collections.Vector<i32>, Memory.Allocationˉfailure> = Collections.Vectorˉconstructˉreserved::<i32>(Budget, 1u64);
    match Created {
        case Results.Result.Failure { Error: Createˉfailure } { return 1; }
        case Results.Result.Valid { Value: Initial } {
            var Values: Collections.Vector<i32> = Initial;
            let First: Results.Result<unit, Collections.Vectorˉappendˉfailure<i32> > = Collections.Vectorˉappend::<i32>(borrow mut Values, 7);
            match First {
                case Results.Result.Failure { Error: Firstˉfailure } { return 2; }
                case Results.Result.Valid { Value: Firstˉaccepted } {
                    let Second: Results.Result<unit, Collections.Vectorˉappendˉfailure<i32> > = Collections.Vectorˉappend::<i32>(borrow mut Values, 35);
                    match Second {
                        case Results.Result.Valid { Value: Unexpected } { return 3; }
                        case Results.Result.Failure { Error: Refused } {
                            if Collections.Vectorˉlength(borrow Values) != 1u64 { return 4; }
                            let Sum: i32 = Refused.Value + Collections.Vectorˉborrowˉat::<i32>(borrow Values, 0u64);
                            return Sum;
                        }
                    }
                }
            }
        }
    }
}
