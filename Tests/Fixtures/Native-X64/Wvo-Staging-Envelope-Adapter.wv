module Compilerˉnativeˉx64ˉstagingˉwvoˉenvelopeˉtest profile portable;

import Compilerˉnativeˉx64ˉloweringˉstagingˉwvoˉnativeˉbridge as Bridge;

fn Empty(Input: bytes) -> bytes {
    return Bytesˉslice(Input, 0u32, 0u32);
}

fn Appendˉu32(Output: bytes, Value: u32) -> bytes {
    return Bytesˉconcat(Output, Bytesˉfromˉu32ˉlittle(Value));
}

export fn Main(Input: bytes) -> bytes {
    let Length: u32 = Bytesˉlength(Input);
    if Length < 12u32 { return Empty(Input); }
    let Manifestˉbytes: u32 = Bytesˉreadˉu32ˉlittle(Input, 0u32);
    let Prefixˉbytes: u32 = Bytesˉreadˉu32ˉlittle(Input, 4u32);
    let Readˉonlyˉheaderˉbytes: u32 =
        Bytesˉreadˉu32ˉlittle(Input, 8u32);
    if Manifestˉbytes > Length - 12u32 {
        return Empty(Input);
    }
    let Afterˉmanifest: u32 = 12u32 + Manifestˉbytes;
    if Prefixˉbytes > Length - Afterˉmanifest {
        return Empty(Input);
    }
    let Afterˉprefix: u32 = Afterˉmanifest + Prefixˉbytes;
    if Readˉonlyˉheaderˉbytes != Length - Afterˉprefix {
        return Empty(Input);
    }
    let Stagingˉmanifest: bytes =
        Bytesˉslice(Input, 12u32, Manifestˉbytes);
    let Prefix: bytes =
        Bytesˉslice(Input, Afterˉmanifest, Prefixˉbytes);
    let Readˉonlyˉheader: bytes = Bytesˉslice(
        Input,
        Afterˉprefix,
        Readˉonlyˉheaderˉbytes
    );

    var Output: bytes = Textˉtoˉutf8("WVSE");
    Output = Appendˉu32(
        Output,
        Bridge.Compilerˉnativeˉx64ˉstagingˉwvoˉnativeˉvalidate(
            Stagingˉmanifest,
            Prefix,
            Readˉonlyˉheader
        )
    );
    Output = Appendˉu32(
        Output,
        Bridge.Compilerˉnativeˉx64ˉstagingˉwvoˉnativeˉobjectˉbytes(
            Stagingˉmanifest,
            Prefix,
            Readˉonlyˉheader
        )
    );
    Output = Appendˉu32(
        Output,
        Bridge.Compilerˉnativeˉx64ˉstagingˉwvoˉnativeˉsections(
            Stagingˉmanifest,
            Prefix,
            Readˉonlyˉheader
        )
    );
    Output = Appendˉu32(
        Output,
        Bridge.Compilerˉnativeˉx64ˉstagingˉwvoˉnativeˉsymbols(
            Stagingˉmanifest,
            Prefix,
            Readˉonlyˉheader
        )
    );
    Output = Appendˉu32(
        Output,
        Bridge.Compilerˉnativeˉx64ˉstagingˉwvoˉnativeˉrelocations(
            Stagingˉmanifest,
            Prefix,
            Readˉonlyˉheader
        )
    );
    Output = Appendˉu32(
        Output,
        Bridge.Compilerˉnativeˉx64ˉstagingˉwvoˉnativeˉtextˉbytes(
            Stagingˉmanifest,
            Prefix,
            Readˉonlyˉheader
        )
    );
    Output = Appendˉu32(
        Output,
        Bridge.Compilerˉnativeˉx64ˉstagingˉwvoˉnativeˉreadˉonlyˉbytes(
            Stagingˉmanifest,
            Prefix,
            Readˉonlyˉheader
        )
    );
    return Appendˉu32(
        Output,
        Bridge.Compilerˉnativeˉx64ˉstagingˉwvoˉnativeˉsymbolˉposition(
            Stagingˉmanifest,
            Prefix,
            Readˉonlyˉheader
        )
    );
}
