module Wvbˉtoˉwvoˉrecordˉcapability profile hosted;

capability process.argument_count;

record Summary {
    Count: u32;
}

export fn Main() -> i32 {
    let Value = Summary {
        Count: process.argument_count(),
    };
    let Adjusted: u32 = (Value.Count - 1u32) * 1u32 + 1u32;
    let Formatted: text = U32ˉformat(Adjusted);
    if Bytesˉreadˉu8(Textˉtoˉutf8(Formatted), 0u32) != 50u8 { return 1; }
    if Adjusted == 2u32 { return 42; }
    return 2;
}
