#!wv/1 en@1
module Nativeˉownedˉvectorˉscope;
profile core;
platform linux, windows, windvale;
authority application;

import Foundationˉcollections as Collections;
import Foundationˉmemory as Memory;
import Foundationˉresult as Results;

export fn Main(Budget: Memory.Memoryˉbudget) -> i32 {
    var Parent: Memory.Memoryˉbudget = Budget;
    var Count: i32 = 0;
    while Count < 1000 {
        let Child: Results.Result<Memory.Memoryˉbudget, Memory.Allocationˉfailure> =
            Memory.Split(borrow mut Parent, 48u64, 0u32);
        let Value: i32 = match Child {
            case Results.Result.Valid { Value: Reservation } {
                let Outcome: Results.Result<Collections.Vector<i32>, Memory.Allocationˉfailure> =
                    Collections.Vectorˉconstructˉreserved::<i32>(Reservation, 1u64);
                match Outcome {
                    case Results.Result.Valid { Value: Values } {
                        using Resource = Values { }
                        42
                    }
                    case Results.Result.Failure { Error: Failure } { 1 }
                }
            }
            case Results.Result.Failure { Error: Splitˉfailure } { 2 }
        };
        if Value != 42 { return Value; }
        Count = Count + 1;
    }
    return 42;
}
