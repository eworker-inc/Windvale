#!wv/1 en@1
module Nativeˉownedˉvectorˉhelpers;
profile core;
platform linux, windows, windvale;
authority application;

import Foundationˉcollections as Collections;
import Foundationˉmemory as Memory;
import Foundationˉresult as Results;

fn Borrow(First: i32, Second: i32, Values: borrow Collections.Vector<i32>, Index: u64) -> i32 {
    if First + Second != 42 { return 4; }
    return Borrowˉvalue(borrow Values, Index);
}

fn Borrowˉvalue(Values: borrow Collections.Vector<i32>, Index: u64) -> i32 {
    return Collections.Vectorˉborrowˉat::<i32>(borrow Values, Index);
}

fn Construct(Budget: Memory.Memoryˉbudget) -> Results.Result<Collections.Vector<i32>, Memory.Allocationˉfailure> {
    return Collections.Vectorˉconstructˉreserved::<i32>(Budget, 1u64);
}

fn Forward(First: i32, Second: i32, Values: Collections.Vector<i32>, Remaining: u32) -> Collections.Vector<i32> {
    if Remaining == 0u32 {
        return Values;
    }
    return Forward(First, Second, Values, Remaining - 1u32);
}

fn Consume(First: i32, Second: i32, Values: Collections.Vector<i32>) -> i32 {
    var Owned: Collections.Vector<i32> = Values;
    let Appended: Results.Result<unit, Collections.Vectorˉappendˉfailure<i32> > =
        Collections.Vectorˉappend::<i32>(borrow mut Owned, First + Second);
    var Observed: i32 = match Appended {
        case Results.Result.Valid { Value: Accepted } { 42 }
        case Results.Result.Failure { Error: Failure } { 3 }
    };
    if Observed == 42 { Observed = Borrow(First, Second, borrow Owned, 0u64); }
    using Resource = Owned { }
    return Observed;
}

export fn Main(Budget: Memory.Memoryˉbudget) -> i32 {
    var Parent: Memory.Memoryˉbudget = Budget;
    var Count: i32 = 0;
    while Count < 1000 {
        let Child: Results.Result<Memory.Memoryˉbudget, Memory.Allocationˉfailure> = Memory.Split(borrow mut Parent, 48u64, 0u32);
        let Value: i32 = match Child {
            case Results.Result.Failure { Error: Splitˉfailure } { 1 }
            case Results.Result.Valid { Value: Reservation } {
                let Outcome: Results.Result<Collections.Vector<i32>, Memory.Allocationˉfailure> = Construct(Reservation);
                match Outcome {
                    case Results.Result.Failure { Error: Failure } { 2 }
                    case Results.Result.Valid { Value: Values } { Consume(7, 35, Forward(7, 35, Values, 3u32)) }
                }
            }
        };
        if Value != 42 { return Value; }
        Count = Count + 1;
    }
    return 42;
}
