module Compilerˉnativeˉx64ˉstagingˉmanifestˉtest profile portable;

import Compilerˉnativeˉx64ˉloweringˉstagingˉnativeˉbridge as Bridge;

fn Appendˉu32(Output: bytes, Value: u32) -> bytes {
    return Bytesˉconcat(Output, Bytesˉfromˉu32ˉlittle(Value));
}

export fn Main(Input: bytes) -> bytes {
    var Output: bytes = Textˉtoˉutf8("WVME");
    Output = Appendˉu32(
        Output,
        Bridge.Compilerˉnativeˉx64ˉstagingˉmanifestˉnativeˉvalidate(Input)
    );
    Output = Appendˉu32(
        Output,
        Bridge.Compilerˉnativeˉx64ˉstagingˉmanifestˉnativeˉobjectˉbytes(Input)
    );
    Output = Appendˉu32(
        Output,
        Bridge.Compilerˉnativeˉx64ˉstagingˉmanifestˉnativeˉchunks(Input)
    );
    Output = Appendˉu32(
        Output,
        Bridge.Compilerˉnativeˉx64ˉstagingˉmanifestˉnativeˉchunkˉposition(
            Input,
            0u32
        )
    );
    return Appendˉu32(
        Output,
        Bridge.Compilerˉnativeˉx64ˉstagingˉmanifestˉnativeˉchunkˉlength(
            Input,
            0u32
        )
    );
}
