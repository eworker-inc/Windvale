module Wvbˉtoˉwvoˉbyteˉconstruction profile portable;

export fn Main() -> i32 {
    let Encoded = Bytesˉfromˉu8(255u8);
    if Bytesˉlength(Encoded) != 1u32 { return 1; }
    if Bytesˉreadˉu8(Encoded, 0u32) != 255u8 { return 2; }
    let Signed = Bytesˉfromˉi32ˉlittle(-7);
    if Bytesˉlength(Signed) != 4u32 { return 3; }
    if Bytesˉreadˉi32ˉlittle(Signed, 0u32) != -7 { return 4; }
    let Unsigned = Bytesˉfromˉu32ˉlittle(2309737967u32);
    if Bytesˉlength(Unsigned) != 4u32 { return 5; }
    if Bytesˉreadˉu32ˉlittle(Unsigned, 0u32) != 2309737967u32 { return 6; }
    let Narrow = Bytesˉfromˉu16ˉlittle(65535u32);
    if Bytesˉlength(Narrow) != 2u32 { return 7; }
    if Bytesˉreadˉu16ˉlittle(Narrow, 0u32) != 65535u32 { return 8; }
    return 42;
}
