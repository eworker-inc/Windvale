module Wvbˉtoˉwvoˉu32ˉdivision profile portable;

record Divisionˉvalue {
    Quotient: u32;
    Remainder: u32;
}

export fn Main() -> i32 {
    let Value = Divisionˉvalue {
        Quotient: 4294967295u32 / 97u32,
        Remainder: 4294967295u32 % 97u32,
    };
    if Value.Quotient != 44278013u32 { return 1; }
    if Value.Remainder != 34u32 { return 2; }
    return 42;
}
