            let Prior: u8 = MutateˉU8(borrow mut Owned, 255u8, 0u8);
            var Result: i32 = 42;
            if Prior != 255u8 { Result = 2; }
            if ReadˉU8(borrow Owned) != 0u8 { Result = 3; }
            if Collections.Vectorˉlength(borrow Owned) != 1u64 { Result = 4; }
            using Resource = Owned { }
            Result
        }
    };
}

