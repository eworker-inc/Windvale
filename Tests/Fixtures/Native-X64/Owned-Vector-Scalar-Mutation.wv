export fn Main(Budget: Memory.Memoryˉbudget) -> i32 {
    var Parent: Memory.Memoryˉbudget = Budget;
    var Index: u32 = 0u32;
    while Index < 6u32 {
        let Child: Results.Result<Memory.Memoryˉbudget, Memory.Allocationˉfailure> =
            Memory.Split(borrow mut Parent, 32u64, 0u32);
        let Observed: i32 = match Child {
            case Results.Result.Failure { Error: Refused } { 5 }
            case Results.Result.Valid { Value: Reservation } {
                if Index == 0u32 {
                    CheckˉI32(Reservation)
                } else if Index == 1u32 {
                    CheckˉU8(Reservation)
                } else if Index == 2u32 {
                    CheckˉU32(Reservation)
                } else if Index == 3u32 {
                    CheckˉBool(Reservation)
                } else if Index == 4u32 {
                    CheckˉI64(Reservation)
                } else {
                    CheckˉU64(Reservation)
                }
            }
        };
        if Observed != 42 { return Observed; }
        Index = Index + 1u32;
    }
    return 42;
}
