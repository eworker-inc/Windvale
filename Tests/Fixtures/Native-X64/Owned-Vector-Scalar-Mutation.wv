            var Owned: Collections.Vector<u64> = Values;
            let Prior: u64 = MutateˉU64(borrow mut Owned, 18446744073709551615u64, 9223372036854775809u64);
            var Result: i32 = 42;
            if Prior != 18446744073709551615u64 { Result = 2; }
            if ReadˉU64(borrow Owned) != 9223372036854775809u64 { Result = 3; }
