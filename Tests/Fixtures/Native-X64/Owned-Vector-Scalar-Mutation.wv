#!wv/1 en@1
module Nativeˉownedˉvectorˉscalarˉmutation;
profile core;
platform linux, windows, windvale;
authority application;

import Foundationˉcollections as Collections;
import Foundationˉmemory as Memory;
import Foundationˉresult as Results;

fn MutateˉI32(Values: borrow mut Collections.Vector<i32>, Initial: i32, Replacement: i32) -> i32 {
    let Appended: Results.Result<unit, Collections.Vectorˉappendˉfailure<i32> > =
        Collections.Vectorˉappend::<i32>(borrow mut Values, Initial);
    return match Appended {
        case Results.Result.Valid { Value: Accepted } {
            Collections.Vectorˉreplace::<i32>(borrow mut Values, 0u64, Replacement)
        }
        case Results.Result.Failure { Error: Refused } { Refused.Value }
    };
}

fn ReadˉI32(Values: borrow Collections.Vector<i32>) -> i32 {
    return Collections.Vectorˉborrowˉat::<i32>(borrow Values, 0u64);
}

fn CheckˉI32(Budget: Memory.Memoryˉbudget) -> i32 {
    let Outcome: Results.Result<Collections.Vector<i32>, Memory.Allocationˉfailure> =
        Collections.Vectorˉconstructˉreserved::<i32>(Budget, 1u64);
    return match Outcome {
        case Results.Result.Failure { Error: Refused } { 1 }
        case Results.Result.Valid { Value: Values } {
            var Owned: Collections.Vector<i32> = Values;
            let Prior: i32 = MutateˉI32(borrow mut Owned, -2147483647, 2147483647);
            var Result: i32 = 42;
            if Prior != -2147483647 { Result = 2; }
            if ReadˉI32(borrow Owned) != 2147483647 { Result = 3; }
            if Collections.Vectorˉlength(borrow Owned) != 1u64 { Result = 4; }
            using Resource = Owned { }
            Result
        }
    };
}

