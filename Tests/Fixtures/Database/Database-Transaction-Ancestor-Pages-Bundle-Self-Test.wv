#!wv/1 en@1
module Windvaleˉnativeˉtestˉdatabaseˉtransactionˉancestorˉpagesˉbundle;
profile core;
platform linux, windows, windvale;
authority application;


import Windvaleˉnativeˉtestˉdatabaseˉtransactionˉancestorˉpages as Pages;
import Windvaleˉnativeˉtestˉdatabaseˉtransactionˉancestorˉpagesˉintermediate as Intermediate;

export fn Main() -> i32 {
    if Pages.Main() != 0 { return 1; }
    if Intermediate.Main() != 0 { return 2; }
    return 0;
}
