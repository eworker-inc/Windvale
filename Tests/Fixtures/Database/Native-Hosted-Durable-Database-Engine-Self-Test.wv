module Nativeˉhostedˉdurableˉdatabaseˉengineˉselfˉtest profile hosted;

import Randomˉaccessˉstorage as Storage;
import Durableˉdatabaseˉbootstrap as Bootstrap;
import Durableˉdatabaseˉengine as Engine;
import Durableˉdatabaseˉlifecycle as Lifecycle;
import Windvaleˉdatabaseˉdurableˉsuperblock as Superblock;
import Windvaleˉdatabaseˉstorageˉrecovery as Recovery;

capability storage.random_access_v1;

const COMMITTED_LENGTH: u64 = 20992u64;
const INITIAL_LENGTH: u64 = 4608u64;
const PAGE_SIZE: u32 = 4096u32;

fn Maximumˉactions(Storageˉlength: u64) -> u32 {
    if Storageˉlength == 20993u64 { return 0u32; }
    if Storageˉlength == 20994u64 { return 1u32; }
    return 2u32;
}

fn Validateˉcurrent(
    Current: Superblock.Databaseˉsuperblockˉselection
) -> bool {
    return Current.Status ==
            Superblock.Databaseˉsuperblockˉselectionˉstatus.Valid &&
        Current.Generation == 2u64 && Current.Committedˉsequence == 1u64 &&
        Current.Rootˉpage == 3u64 && Current.Commitˉlogˉhead == 4u64 &&
        Current.Pageˉcount == 5u64 &&
        Current.Committedˉlength == COMMITTED_LENGTH &&
        Current.Pageˉsize == 4096u32 && Current.Rootˉdepth == 2u32 &&
        Current.Tailˉbytes == 0u64;
}

fn Validateˉinitial(
    Current: Superblock.Databaseˉsuperblockˉselection
) -> bool {
    return Current.Status ==
            Superblock.Databaseˉsuperblockˉselectionˉstatus.Valid &&
        Current.Databaseˉidentityˉhigh == 1u64 &&
        Current.Databaseˉidentityˉlow == 2u64 &&
        Current.Generation == 1u64 && Current.Committedˉsequence == 0u64 &&
        Current.Rootˉpage == 0u64 &&
        Current.Commitˉlogˉhead == 18446744073709551615u64 &&
        Current.Pageˉcount == 1u64 &&
        Current.Committedˉlength == INITIAL_LENGTH &&
        Current.Pageˉsize == PAGE_SIZE && Current.Rootˉdepth == 1u32 &&
        Current.Tailˉbytes == 0u64;
}

export fn Main() -> i32 {
    let Before: Storage.Storageˉresult = Storage.Storageˉdescribe();
    if Before.Status != Storage.Storageˉstatus.Valid ||
        Before.Generation == 0u64 {
        return 1;
    }
    let Invalid: Lifecycle.Databaseˉdurableˉlifecycle =
        Lifecycle.Databaseˉdurableˉlifecycleˉcreateˉorˉopen(
            0u64,
            0u64,
            PAGE_SIZE,
            4u32,
            0u32
        );
    if Invalid.Status !=
            Lifecycle.Databaseˉdurableˉlifecycleˉstatus.Invalidˉrequest ||
        Invalid.Engineˉattempted {
        return 3;
    }
    if Before.Storageˉlength == 0u64 {
        let Deferred: Lifecycle.Databaseˉdurableˉlifecycle =
            Lifecycle.Databaseˉdurableˉlifecycleˉcreateˉorˉopen(
                1u64,
                2u64,
                PAGE_SIZE,
                0u32,
                0u32
            );
        if Deferred.Status !=
                Lifecycle.Databaseˉdurableˉlifecycleˉstatus.Creationˉactive ||
            Deferred.Engineˉattempted ||
            Deferred.Bootstrap.Status !=
                Bootstrap.Databaseˉdurableˉbootstrapˉstatus.Active ||
            Deferred.Bootstrap.Actions != 0u32 ||
            Deferred.Bootstrap.Storageˉlength != 0u64 {
            return 60;
        }
        let Created: Lifecycle.Databaseˉdurableˉlifecycle =
            Lifecycle.Databaseˉdurableˉlifecycleˉcreateˉorˉopen(
                1u64,
                2u64,
                PAGE_SIZE,
                4u32,
                0u32
            );
        if Created.Status !=
                Lifecycle.Databaseˉdurableˉlifecycleˉstatus.Created ||
            !Created.Engineˉattempted ||
            Created.Bootstrap.Status !=
                Bootstrap.Databaseˉdurableˉbootstrapˉstatus.Created ||
            Created.Bootstrap.Actions != 4u32 ||
            Created.Engine.Status != Engine.Databaseˉengineˉstatus.Ready ||
            !Validateˉinitial(Created.Engine.Current) {
            return 61;
        }
        return 70;
    }
    if Before.Storageˉlength == INITIAL_LENGTH {
        let Resumed: Lifecycle.Databaseˉdurableˉlifecycle =
            Lifecycle.Databaseˉdurableˉlifecycleˉcreateˉorˉopen(
                1u64,
                2u64,
                PAGE_SIZE,
                4u32,
                0u32
            );
        if Resumed.Status !=
                Lifecycle.Databaseˉdurableˉlifecycleˉstatus.Resumed ||
            !Resumed.Engineˉattempted ||
            Resumed.Bootstrap.Status !=
                Bootstrap.Databaseˉdurableˉbootstrapˉstatus.Resumed ||
            Resumed.Bootstrap.Actions != 1u32 ||
            Resumed.Engine.Status != Engine.Databaseˉengineˉstatus.Ready ||
            !Validateˉinitial(Resumed.Engine.Current) {
            return 62;
        }
        return 71;
    }
    let Actions: u32 = Maximumˉactions(Before.Storageˉlength);
    let Lifecycleˉresult: Lifecycle.Databaseˉdurableˉlifecycle =
        Lifecycle.Databaseˉdurableˉlifecycleˉcreateˉorˉopen(
            1u64,
            2u64,
            PAGE_SIZE,
            4u32,
            Actions
        );
    let Opened: Engine.Databaseˉengine = Lifecycleˉresult.Engine;
    if Before.Storageˉlength < 512u64 {
        if Lifecycleˉresult.Status !=
                Lifecycle.Databaseˉdurableˉlifecycleˉstatus.Notˉdatabase ||
            Opened.Status != Engine.Databaseˉengineˉstatus.Headerˉfailure ||
            Opened.Recoveryˉactions != 0u32 {
            return 90;
        }
        return 91;
    }
    if Before.Storageˉlength == 20993u64 {
        if Lifecycleˉresult.Status !=
                Lifecycle.Databaseˉdurableˉlifecycleˉstatus.Recoveryˉactive ||
            Opened.Status != Engine.Databaseˉengineˉstatus.Recoveryˉactive ||
            Opened.Recoveryˉstage !=
                Recovery.Databaseˉstorageˉrecoveryˉstage.Resizeˉtail ||
            Opened.Recoveryˉactions != 0u32 ||
            Opened.Current.Tailˉbytes != 1u64 {
            return 30;
        }
        return 100;
    }
    if Before.Storageˉlength == 20994u64 {
        if Lifecycleˉresult.Status !=
                Lifecycle.Databaseˉdurableˉlifecycleˉstatus.Recoveryˉactive ||
            Opened.Status != Engine.Databaseˉengineˉstatus.Recoveryˉactive ||
            Opened.Recoveryˉstage !=
                Recovery.Databaseˉstorageˉrecoveryˉstage.Flushˉtail ||
            Opened.Recoveryˉactions != 1u32 ||
            Opened.Storageˉlength != COMMITTED_LENGTH {
            return 31;
        }
        return 101;
    }
    if Before.Storageˉlength > COMMITTED_LENGTH {
        if Lifecycleˉresult.Status !=
                Lifecycle.Databaseˉdurableˉlifecycleˉstatus.Recovered ||
            Opened.Status != Engine.Databaseˉengineˉstatus.Recovered ||
            Opened.Recoveryˉstage !=
                Recovery.Databaseˉstorageˉrecoveryˉstage.Ready ||
            Opened.Recoveryˉerror !=
                Recovery.Databaseˉstorageˉrecoveryˉerror.None ||
            Opened.Recoveryˉactions != 2u32 ||
            Opened.Storageˉlength != COMMITTED_LENGTH ||
            !Validateˉcurrent(Opened.Current) {
            return 32;
        }
        return 0;
    }
    if Lifecycleˉresult.Status !=
            Lifecycle.Databaseˉdurableˉlifecycleˉstatus.Opened ||
        Opened.Status != Engine.Databaseˉengineˉstatus.Ready ||
        Opened.Recoveryˉactions != 0u32 ||
        Opened.Storageˉlength != COMMITTED_LENGTH ||
        !Validateˉcurrent(Opened.Current) {
        return 2;
    }
    let Wrongˉidentity: Lifecycle.Databaseˉdurableˉlifecycle =
        Lifecycle.Databaseˉdurableˉlifecycleˉcreateˉorˉopen(
            9u64,
            2u64,
            PAGE_SIZE,
            4u32,
            0u32
        );
    let Wrongˉpage: Lifecycle.Databaseˉdurableˉlifecycle =
        Lifecycle.Databaseˉdurableˉlifecycleˉcreateˉorˉopen(
            1u64,
            2u64,
            8192u32,
            4u32,
            0u32
        );
    if Wrongˉidentity.Status !=
            Lifecycle.Databaseˉdurableˉlifecycleˉstatus.Identityˉmismatch ||
        Wrongˉidentity.Engine.Status != Engine.Databaseˉengineˉstatus.Ready ||
        Wrongˉpage.Status !=
            Lifecycle.Databaseˉdurableˉlifecycleˉstatus.Pageˉsizeˉmismatch ||
        Wrongˉpage.Engine.Status != Engine.Databaseˉengineˉstatus.Ready {
        return 4;
    }
    return 0;
}
