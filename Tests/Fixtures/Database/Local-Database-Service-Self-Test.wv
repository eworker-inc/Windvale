module Localˉdatabaseˉserviceˉselfˉtest profile portable;

import Windvaleˉdatabaseˉdurableˉsuperblock as Superblock;
import Windvaleˉdatabaseˉlocalˉcontracts as Contracts;
import Windvaleˉdatabaseˉlocalˉcontrol as Control;
import Windvaleˉdatabaseˉlocalˉget as Get;
import Windvaleˉdatabaseˉlocalˉput as Put;
import Windvaleˉdatabaseˉlocalˉsession as Session;
import Windvaleˉdatabaseˉlogicalˉrecord as Logical;

fn Empty() -> bytes {
    let Unit: bytes = Bytesˉfromˉu8(0u8);
    return Bytesˉslice(Unit, 0u32, 0u32);
}

fn Bytesˉequal(First: bytes, Second: bytes) -> bool {
    let Length: u32 = Bytesˉlength(First);
    if Length != Bytesˉlength(Second) { return false; }
    var Index: u32 = 0u32;
    while Index < Length {
        if Bytesˉreadˉu8(First, Index) !=
            Bytesˉreadˉu8(Second, Index) {
            return false;
        }
        Index = Index + 1u32;
    }
    return true;
}

fn Current(
    Identityˉhigh: u64,
    Identityˉlow: u64,
    Generation: u64,
    Sequence: u64,
    Rootˉpage: u64,
    Pageˉcount: u64,
    Length: u64
) -> Superblock.Databaseˉsuperblockˉselection {
    var Commitˉlog: u64 = 18446744073709551615u64;
    if Sequence != 0u64 { Commitˉlog = Pageˉcount - 1u64; }
    let Encoded: Superblock.Databaseˉsuperblockˉresult =
        Superblock.Databaseˉsuperblockˉencode(
            Superblock.Databaseˉsuperblock(
                Identityˉhigh,
                Identityˉlow,
                Generation,
                Sequence,
                Rootˉpage,
                Commitˉlog,
                Sequence,
                Pageˉcount,
                Length,
                4096u32,
                1u32
            )
        );
    return Superblock.Databaseˉsuperblockˉselect(
        Encoded.Bytes,
        Empty(),
        Length
    );
}

fn Expectˉready(
    Session: Contracts.Databaseˉlocalˉsession,
    Next: u64
) -> bool {
    return Session.Status == Contracts.Databaseˉlocalˉsessionˉstatus.Ready &&
        Session.Nextˉrequest == Next && Session.Activeˉrequest == 0u64;
}

export fn Main() -> i32 {
    let First: Superblock.Databaseˉsuperblockˉselection =
        Current(1u64, 2u64, 1u64, 0u64, 0u64, 1u64, 4608u64);
    let Invalid: Contracts.Databaseˉlocalˉresult =
        Session.Databaseˉlocalˉsessionˉopen(
            9u64,
            2u64,
            4096u32,
            First
        );
    let Invalidˉsession: Contracts.Databaseˉlocalˉsession = Invalid.Session;
    if Invalid.Status !=
            Contracts.Databaseˉlocalˉserviceˉstatus.Invalidˉsession ||
        Invalidˉsession.Status !=
            Contracts.Databaseˉlocalˉsessionˉstatus.Closed {
        return 1;
    }
    let Opened: Contracts.Databaseˉlocalˉresult =
        Session.Databaseˉlocalˉsessionˉopen(
            1u64,
            2u64,
            4096u32,
            First
        );
    if Opened.Status != Contracts.Databaseˉlocalˉserviceˉstatus.Opened ||
        !Expectˉready(Opened.Session, 1u64) {
        return 2;
    }
    let Uncertainˉget: Contracts.Databaseˉlocalˉrequest =
        Get.Databaseˉlocalˉgetˉprepare(
            Opened.Session,
            1u64,
            3u64,
            Textˉtoˉutf8("record")
        );
    let Uncertain: Contracts.Databaseˉlocalˉresult =
        Get.Databaseˉlocalˉgetˉcomplete(
            Uncertainˉget,
            Contracts.Databaseˉlocalˉcompletion.Reopenˉrequired,
            Empty()
        );
    let Uncertainˉsession: Contracts.Databaseˉlocalˉsession =
        Uncertain.Session;
    if Uncertain.Status !=
            Contracts.Databaseˉlocalˉserviceˉstatus.Reopenˉrequired ||
        Uncertainˉsession.Reopenˉmustˉadvance {
        return 19;
    }
    let Uncertainˉreopened: Contracts.Databaseˉlocalˉresult =
        Session.Databaseˉlocalˉsessionˉreopen(Uncertain.Session, First);
    if Uncertainˉreopened.Status !=
            Contracts.Databaseˉlocalˉserviceˉstatus.Reopened ||
        !Expectˉready(Uncertainˉreopened.Session, 2u64) {
        return 20;
    }
    let Wrongˉrequest: Contracts.Databaseˉlocalˉrequest =
        Get.Databaseˉlocalˉgetˉprepare(
            Opened.Session,
            2u64,
            3u64,
            Textˉtoˉutf8("record")
        );
    if Wrongˉrequest.Status !=
            Contracts.Databaseˉlocalˉserviceˉstatus.Invalidˉrequest ||
        !Expectˉready(Wrongˉrequest.Session, 1u64) {
        return 3;
    }
    let Badˉcollection: Contracts.Databaseˉlocalˉrequest =
        Get.Databaseˉlocalˉgetˉprepare(
            Opened.Session,
            1u64,
            0u64,
            Textˉtoˉutf8("record")
        );
    if Badˉcollection.Status !=
            Contracts.Databaseˉlocalˉserviceˉstatus.Encodingˉfailure ||
        Badˉcollection.Logicalˉerror !=
            Logical.Databaseˉlogicalˉerror.Invalidˉcollection ||
        !Expectˉready(Badˉcollection.Session, 1u64) {
        return 4;
    }
    let Getˉone: Contracts.Databaseˉlocalˉrequest =
        Get.Databaseˉlocalˉgetˉprepare(
            Opened.Session,
            1u64,
            3u64,
            Textˉtoˉutf8("record")
        );
    let Getˉoneˉsession: Contracts.Databaseˉlocalˉsession = Getˉone.Session;
    if Getˉone.Status !=
            Contracts.Databaseˉlocalˉserviceˉstatus.Getˉprepared ||
        Getˉoneˉsession.Status !=
            Contracts.Databaseˉlocalˉsessionˉstatus.Busyˉget ||
        Bytesˉlength(Getˉone.Key) == 0u32 {
        return 5;
    }
    let Concurrent: Contracts.Databaseˉlocalˉrequest =
        Put.Databaseˉlocalˉputˉprepare(
            Getˉone.Session,
            1u64,
            3u64,
            Textˉtoˉutf8("record"),
            7u64,
            Textˉtoˉutf8("value")
        );
    if Concurrent.Status !=
        Contracts.Databaseˉlocalˉserviceˉstatus.Invalidˉrequest {
        return 6;
    }
    let Wrongˉcancel: Contracts.Databaseˉlocalˉresult =
        Control.Databaseˉlocalˉcancel(Getˉone.Session, 2u64);
    if Wrongˉcancel.Status !=
        Contracts.Databaseˉlocalˉserviceˉstatus.Invalidˉrequest {
        return 7;
    }
    let Cancelled: Contracts.Databaseˉlocalˉresult =
        Control.Databaseˉlocalˉcancel(Getˉone.Session, 1u64);
    if Cancelled.Status !=
            Contracts.Databaseˉlocalˉserviceˉstatus.Cancelled ||
        !Expectˉready(Cancelled.Session, 2u64) {
        return 8;
    }
    let Put: Contracts.Databaseˉlocalˉrequest =
        Put.Databaseˉlocalˉputˉprepare(
            Cancelled.Session,
            2u64,
            3u64,
            Textˉtoˉutf8("record"),
            7u64,
            Textˉtoˉutf8("value")
        );
    let Putˉsession: Contracts.Databaseˉlocalˉsession = Put.Session;
    if Put.Status != Contracts.Databaseˉlocalˉserviceˉstatus.Putˉprepared ||
        Putˉsession.Status !=
            Contracts.Databaseˉlocalˉsessionˉstatus.Busyˉput ||
        Bytesˉlength(Put.Key) == 0u32 || Bytesˉlength(Put.Value) == 0u32 {
        return 9;
    }
    let Prematureˉclose: Contracts.Databaseˉlocalˉresult =
        Session.Databaseˉlocalˉsessionˉclose(Put.Session);
    if Prematureˉclose.Status !=
        Contracts.Databaseˉlocalˉserviceˉstatus.Invalidˉsession {
        return 10;
    }
    let Committed: Contracts.Databaseˉlocalˉresult =
        Put.Databaseˉlocalˉputˉcomplete(
            Put,
            Contracts.Databaseˉlocalˉcompletion.Putˉcommitted
        );
    let Committedˉsession: Contracts.Databaseˉlocalˉsession =
        Committed.Session;
    if Committed.Status !=
            Contracts.Databaseˉlocalˉserviceˉstatus.Putˉcommitted ||
        Committedˉsession.Status !=
            Contracts.Databaseˉlocalˉsessionˉstatus.Reopenˉrequired ||
        Committedˉsession.Nextˉrequest != 3u64 ||
        !Committedˉsession.Reopenˉmustˉadvance {
        return 11;
    }
    let Whileˉreopen: Contracts.Databaseˉlocalˉrequest =
        Get.Databaseˉlocalˉgetˉprepare(
            Committed.Session,
            3u64,
            3u64,
            Textˉtoˉutf8("record")
        );
    if Whileˉreopen.Status !=
        Contracts.Databaseˉlocalˉserviceˉstatus.Invalidˉrequest {
        return 12;
    }
    let Sameˉreopen: Contracts.Databaseˉlocalˉresult =
        Session.Databaseˉlocalˉsessionˉreopen(Committed.Session, First);
    if Sameˉreopen.Status !=
        Contracts.Databaseˉlocalˉserviceˉstatus.Invalidˉsession {
        return 21;
    }
    let Wrongˉcurrent: Superblock.Databaseˉsuperblockˉselection =
        Current(9u64, 2u64, 2u64, 1u64, 1u64, 3u64, 12800u64);
    let Wrongˉreopen: Contracts.Databaseˉlocalˉresult =
        Session.Databaseˉlocalˉsessionˉreopen(
            Committed.Session,
            Wrongˉcurrent
        );
    if Wrongˉreopen.Status !=
        Contracts.Databaseˉlocalˉserviceˉstatus.Invalidˉsession {
        return 13;
    }
    let Second: Superblock.Databaseˉsuperblockˉselection =
        Current(1u64, 2u64, 2u64, 1u64, 1u64, 3u64, 12800u64);
    let Reopened: Contracts.Databaseˉlocalˉresult =
        Session.Databaseˉlocalˉsessionˉreopen(Committed.Session, Second);
    if Reopened.Status !=
            Contracts.Databaseˉlocalˉserviceˉstatus.Reopened ||
        !Expectˉready(Reopened.Session, 3u64) {
        return 14;
    }
    let Getˉfound: Contracts.Databaseˉlocalˉrequest =
        Get.Databaseˉlocalˉgetˉprepare(
            Reopened.Session,
            3u64,
            3u64,
            Textˉtoˉutf8("record")
        );
    let Encoded: Logical.Databaseˉlogicalˉrecordˉresult =
        Logical.Databaseˉlogicalˉrecordˉencode(
            7u64,
            Textˉtoˉutf8("value")
        );
    let Found: Contracts.Databaseˉlocalˉresult =
        Get.Databaseˉlocalˉgetˉcomplete(
            Getˉfound,
            Contracts.Databaseˉlocalˉcompletion.Found,
            Encoded.Bytes
        );
    if Found.Status != Contracts.Databaseˉlocalˉserviceˉstatus.Found ||
        Found.Schema != 7u64 ||
        !Bytesˉequal(Found.Payload, Textˉtoˉutf8("value")) ||
        !Expectˉready(Found.Session, 4u64) {
        return 15;
    }
    let Getˉmissing: Contracts.Databaseˉlocalˉrequest =
        Get.Databaseˉlocalˉgetˉprepare(
            Found.Session,
            4u64,
            3u64,
            Textˉtoˉutf8("missing")
        );
    let Missing: Contracts.Databaseˉlocalˉresult =
        Get.Databaseˉlocalˉgetˉcomplete(
            Getˉmissing,
            Contracts.Databaseˉlocalˉcompletion.Missing,
            Empty()
        );
    if Missing.Status != Contracts.Databaseˉlocalˉserviceˉstatus.Missing ||
        !Expectˉready(Missing.Session, 5u64) {
        return 16;
    }
    let Getˉinvalid: Contracts.Databaseˉlocalˉrequest =
        Get.Databaseˉlocalˉgetˉprepare(
            Missing.Session,
            5u64,
            3u64,
            Textˉtoˉutf8("invalid")
        );
    let Invalidˉvalue: Contracts.Databaseˉlocalˉresult =
        Get.Databaseˉlocalˉgetˉcomplete(
            Getˉinvalid,
            Contracts.Databaseˉlocalˉcompletion.Found,
            Textˉtoˉutf8("bad")
        );
    let Invalidˉvalueˉsession: Contracts.Databaseˉlocalˉsession =
        Invalidˉvalue.Session;
    if Invalidˉvalue.Status !=
            Contracts.Databaseˉlocalˉserviceˉstatus.Invalidˉvalue ||
        Invalidˉvalueˉsession.Status !=
            Contracts.Databaseˉlocalˉsessionˉstatus.Failed ||
        Invalidˉvalueˉsession.Nextˉrequest != 6u64 {
        return 17;
    }
    let Closed: Contracts.Databaseˉlocalˉresult =
        Session.Databaseˉlocalˉsessionˉclose(Invalidˉvalue.Session);
    let Closedˉsession: Contracts.Databaseˉlocalˉsession = Closed.Session;
    if Closed.Status != Contracts.Databaseˉlocalˉserviceˉstatus.Closed ||
        Closedˉsession.Status !=
            Contracts.Databaseˉlocalˉsessionˉstatus.Closed {
        return 18;
    }
    return 0;
}
