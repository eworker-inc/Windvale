module Wvdbˉsnapshotˉadapter profile hosted;

import Readˉonlyˉwvdb as Snapshot;

capability filesystem.directory_read_v1;

fn Wvdbˉsnapshotˉstorageˉexit(
    Status: Snapshot.Wvdbˉsnapshotˉstorageˉstatus
) -> i32 {
    match Status {
        case Snapshot.Wvdbˉsnapshotˉstorageˉstatus.Notˉfound { return -3; }
        case Snapshot.Wvdbˉsnapshotˉstorageˉstatus.Notˉfile { return -5; }
        case Snapshot.Wvdbˉsnapshotˉstorageˉstatus.Permissionˉdenied { return -5; }
        case Snapshot.Wvdbˉsnapshotˉstorageˉstatus.Unavailable { return -5; }
        case Snapshot.Wvdbˉsnapshotˉstorageˉstatus.Revoked { return -5; }
        case Snapshot.Wvdbˉsnapshotˉstorageˉstatus.Stale { return -5; }
        case Snapshot.Wvdbˉsnapshotˉstorageˉstatus.Peerˉexited { return -5; }
        case Snapshot.Wvdbˉsnapshotˉstorageˉstatus.Invalidˉoffset { return -5; }
        case Snapshot.Wvdbˉsnapshotˉstorageˉstatus.Invalidˉname { return -5; }
        case Snapshot.Wvdbˉsnapshotˉstorageˉstatus.Invalidˉlimit { return -5; }
        case Snapshot.Wvdbˉsnapshotˉstorageˉstatus.Invalidˉresponse { return -4; }
        case Snapshot.Wvdbˉsnapshotˉstorageˉstatus.Tooˉlarge { return -2; }
    }
}

export fn Main() -> i32 {
    let Lookup: Snapshot.Wvdbˉsnapshotˉlookupˉresult = Snapshot.Wvdbˉsnapshotˉlookup(
        "Catalog.wvdb",
        30u32
    );
    match Lookup {
        case Snapshot.Wvdbˉsnapshotˉlookupˉresult.Found(Value) { return Value; }
        case Snapshot.Wvdbˉsnapshotˉlookupˉresult.Missing { return -1; }
        case Snapshot.Wvdbˉsnapshotˉlookupˉresult.Storageˉfailure(Failure) {
            return Wvdbˉsnapshotˉstorageˉexit(Failure.Status);
        }
        case Snapshot.Wvdbˉsnapshotˉlookupˉresult.Databaseˉfailure(Failure) {
            return -6;
        }
    }
}
