module Nativeˉhostedˉdurableˉlogicalˉtreeˉwriterˉselfˉtest profile hosted;

import Randomˉaccessˉstorage as Storage;
import Durableˉlogicalˉtreeˉwriter as Logicalˉwriter;
import Durableˉtreeˉwriter as Writer;
import Windvaleˉdatabaseˉdurableˉsuperblock as Superblock;
import Windvaleˉdatabaseˉlogicalˉrecordˉwrite as Logical;

capability storage.random_access_v1;

fn Invalidˉcurrent() -> Superblock.Databaseˉsuperblockˉselection {
    let Empty: bytes = Bytesˉslice(Bytesˉfromˉu8(0u8), 0u32, 0u32);
    return Superblock.Databaseˉsuperblockˉselect(Empty, Empty, 0u64);
}

fn Selectˉcurrent(
    Description: Storage.Storageˉresult
) -> Superblock.Databaseˉsuperblockˉselection {
    let Header: Storage.Storageˉresult = Storage.Storageˉreadˉat(
        Description.Generation,
        0u64,
        512u32
    );
    if Header.Status != Storage.Storageˉstatus.Valid ||
        Header.Generation != Description.Generation ||
        Header.Storageˉlength != Description.Storageˉlength ||
        Bytesˉlength(Header.Value) != 512u32 {
        return Invalidˉcurrent();
    }
    return Superblock.Databaseˉsuperblockˉselect(
        Bytesˉslice(Header.Value, 0u32, 256u32),
        Bytesˉslice(Header.Value, 256u32, 256u32),
        Description.Storageˉlength
    );
}

export fn Main() -> i32 {
    let Description: Storage.Storageˉresult = Storage.Storageˉdescribe();
    if Description.Status != Storage.Storageˉstatus.Valid ||
        Description.Generation == 0u64 {
        return 1;
    }
    let Current: Superblock.Databaseˉsuperblockˉselection =
        Selectˉcurrent(Description);
    if Current.Status !=
            Superblock.Databaseˉsuperblockˉselectionˉstatus.Valid ||
        Current.Rootˉdepth != 2u32 {
        return 2;
    }
    let Result: Logicalˉwriter.Databaseˉdurableˉlogicalˉtreeˉupsertˉresult =
        Logicalˉwriter.Databaseˉdurableˉlogicalˉtreeˉupsert(
            Current,
            7u64,
            Textˉtoˉutf8("customer-1"),
            3u64,
            Textˉtoˉutf8("stored-through-logical-tree-writer"),
            4u32
        );
    if Result.Logicalˉerror !=
            Logical.Databaseˉlogicalˉwriteˉerror.Valid ||
        Result.Writer.Status !=
            Writer.Databaseˉdurableˉtreeˉupsertˉstatus.Committed ||
        Result.Writer.Pathˉpages != 2u32 || Result.Writer.Actions != 4u32 ||
        Result.Writer.Replaced || Result.Writer.Splitˉlevels != 0u32 ||
        Result.Writer.Rootˉsplit || Result.Writer.Rootˉpage != 6u64 ||
        Result.Writer.Rootˉdepth != 2u32 ||
        Result.Writer.Dataˉpageˉcount != 2u32 ||
        Result.Writer.Publicationˉstate.Publication.Targetˉgeneration != 3u64 ||
        Result.Writer.Publicationˉstate.Publication.Targetˉsequence != 2u64 ||
        Result.Writer.Publicationˉstate.Publication.Targetˉlength != 33280u64 {
        return 3;
    }
    return 0;
}
