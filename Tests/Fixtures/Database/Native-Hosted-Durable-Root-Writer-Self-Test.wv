module Nativeˉhostedˉdurableˉrootˉwriterˉselfˉtest profile hosted;

import Randomˉaccessˉstorage as Storage;
import Durableˉrootˉwriter as Writer;
import Durableˉstorageˉexecutor as Executor;
import Windvaleˉdatabaseˉdurableˉpage as Page;
import Windvaleˉdatabaseˉdurableˉsuperblock as Superblock;
import Windvaleˉdatabaseˉstorageˉpublication as Publication;
import Windvaleˉdatabaseˉstorageˉrecovery as Recovery;
import Windvaleˉdatabaseˉtreeˉnode as Tree;

capability storage.random_access_v1;

const INITIAL_LENGTH: u64 = 4608u64;
const COMMITTED_LENGTH: u64 = 12800u64;
const PAGE_SIZE: u32 = 4096u32;

fn Emptyˉbytes() -> bytes {
    let Unit: bytes = Bytesˉfromˉu8(0u8);
    return Bytesˉslice(Unit, 0u32, 0u32);
}

fn Key() -> bytes {
    return Textˉtoˉutf8("first-record");
}

fn Value() -> bytes {
    return Textˉtoˉutf8("survives-restart");
}

fn Bytesˉequal(First: bytes, Second: bytes) -> bool {
    let Length: u32 = Bytesˉlength(First);
    if Length != Bytesˉlength(Second) { return false; }
    var Index: u32 = 0u32;
    while Index < Length {
        if Bytesˉreadˉu8(First, Index) !=
            Bytesˉreadˉu8(Second, Index) {
            return false;
        }
        Index = Index + 1u32;
    }
    return true;
}

fn Selectˉcurrent(
    Description: Storage.Storageˉresult
) -> Superblock.Databaseˉsuperblockˉselection {
    let Header: Storage.Storageˉresult = Storage.Storageˉreadˉat(
        Description.Generation,
        0u64,
        512u32
    );
    if Header.Status != Storage.Storageˉstatus.Valid ||
        Bytesˉlength(Header.Value) != 512u32 {
        return Superblock.Databaseˉsuperblockˉselect(
            Emptyˉbytes(),
            Emptyˉbytes(),
            Description.Storageˉlength
        );
    }
    return Superblock.Databaseˉsuperblockˉselect(
        Bytesˉslice(Header.Value, 0u32, 256u32),
        Bytesˉslice(Header.Value, 256u32, 256u32),
        Description.Storageˉlength
    );
}

fn Recoverˉtail(
    Description: Storage.Storageˉresult,
    Current: Superblock.Databaseˉsuperblockˉselection
) -> i32 {
    let Initial: Recovery.Databaseˉstorageˉrecovery =
        Recovery.Databaseˉstorageˉrecoveryˉbegin(
            Current,
            Description.Generation,
            Description.Storageˉlength
        );
    if Initial.Error != Recovery.Databaseˉstorageˉrecoveryˉerror.None {
        return 30;
    }
    let Execution: Executor.Databaseˉstorageˉrecoveryˉexecution =
        Executor.Databaseˉstorageˉrecoveryˉexecute(Initial, 2u32);
    if Execution.State.Stage !=
            Recovery.Databaseˉstorageˉrecoveryˉstage.Ready ||
        Execution.State.Error != Recovery.Databaseˉstorageˉrecoveryˉerror.None {
        return 31;
    }
    return 0;
}

fn Markerˉactions(Storageˉlength: u64) -> u32 {
    if Storageˉlength == 4609u64 { return 0u32; }
    if Storageˉlength == 4610u64 { return 1u32; }
    if Storageˉlength == 4611u64 { return 2u32; }
    if Storageˉlength == 4612u64 { return 3u32; }
    return 4u32;
}

fn Interruptionˉresult(Actions: u32) -> i32 {
    if Actions == 0u32 { return 100; }
    if Actions == 1u32 { return 101; }
    if Actions == 2u32 { return 102; }
    if Actions == 3u32 { return 103; }
    return 104;
}

fn Publishˉfirst(
    Current: Superblock.Databaseˉsuperblockˉselection,
    Maximumˉactions: u32
) -> i32 {
    let Result: Writer.Databaseˉdurableˉrootˉupsertˉresult =
        Writer.Databaseˉdurableˉrootˉupsert(
            Current,
            Key(),
            Value(),
            Maximumˉactions
        );
    if Result.Pageˉvisits != 1u32 ||
        Result.Actions != Maximumˉactions || Result.Replaced ||
        Result.Entryˉcount != 1u32 || Result.Rootˉpage != 1u64 ||
        Result.Targetˉgeneration != 2u64 ||
        Result.Targetˉsequence != 1u64 ||
        Result.Targetˉlength != COMMITTED_LENGTH ||
        Result.Publicationˉerror !=
            Publication.Databaseˉstorageˉpublicationˉerror.None {
        return 40;
    }
    if Maximumˉactions < 4u32 {
        if Result.Status !=
                Writer.Databaseˉdurableˉrootˉupsertˉstatus.Active ||
            Result.Publicationˉstate.Status !=
                Publication.Databaseˉstorageˉpublicationˉstatus.Active {
            return 41;
        }
    } else if Result.Status !=
            Writer.Databaseˉdurableˉrootˉupsertˉstatus.Committed ||
        Result.Publicationˉstate.Status !=
            Publication.Databaseˉstorageˉpublicationˉstatus.Committed {
        return 42;
    }
    return 0;
}

fn Validateˉcommitted(
    Description: Storage.Storageˉresult,
    Current: Superblock.Databaseˉsuperblockˉselection
) -> i32 {
    if Description.Storageˉlength != COMMITTED_LENGTH ||
        Current.Status !=
            Superblock.Databaseˉsuperblockˉselectionˉstatus.Valid ||
        Current.Generation != 2u64 || Current.Committedˉsequence != 1u64 ||
        Current.Rootˉpage != 1u64 || Current.Commitˉlogˉhead != 2u64 ||
        Current.Pageˉcount != 3u64 ||
        Current.Committedˉlength != COMMITTED_LENGTH ||
        Current.Rootˉdepth != 1u32 || Current.Tailˉbytes != 0u64 {
        return 50;
    }
    let Read: Storage.Storageˉresult = Storage.Storageˉreadˉat(
        Description.Generation,
        512u64 + U64ˉfromˉu32(PAGE_SIZE),
        PAGE_SIZE
    );
    if Read.Status != Storage.Storageˉstatus.Valid ||
        Bytesˉlength(Read.Value) != PAGE_SIZE {
        return 51;
    }
    let Root: Page.Databaseˉdurableˉpageˉresult =
        Page.Databaseˉdurableˉpageˉdecode(Read.Value);
    if Root.Error != Page.Databaseˉdurableˉpageˉerror.Valid ||
        Root.Kind != Page.Databaseˉdurableˉpageˉkind.Root ||
        Root.Pageˉidentifier != 1u64 || Root.Previousˉpage != 0u64 ||
        Root.Itemˉcount != 1u32 {
        return 52;
    }
    let Lookup: Tree.Databaseˉtreeˉleafˉlookupˉresult =
        Tree.Databaseˉtreeˉleafˉlookup(Root.Payload, Key());
    if Lookup.Error != Tree.Databaseˉtreeˉnodeˉerror.Valid ||
        !Lookup.Found || !Bytesˉequal(Lookup.Value, Value()) {
        return 53;
    }
    return 0;
}

export fn Main() -> i32 {
    var Description: Storage.Storageˉresult = Storage.Storageˉdescribe();
    if Description.Status != Storage.Storageˉstatus.Valid ||
        Description.Generation == 0u64 {
        return 1;
    }
    var Current: Superblock.Databaseˉsuperblockˉselection =
        Selectˉcurrent(Description);
    if Current.Status !=
        Superblock.Databaseˉsuperblockˉselectionˉstatus.Valid {
        return 2;
    }
    if Description.Storageˉlength >= 4609u64 &&
        Description.Storageˉlength <= 4613u64 {
        let Maximumˉactions: u32 = Markerˉactions(
            Description.Storageˉlength
        );
        let Recovered: i32 = Recoverˉtail(Description, Current);
        if Recovered != 0 { return Recovered; }
        Description = Storage.Storageˉdescribe();
        Current = Selectˉcurrent(Description);
        if Description.Storageˉlength != INITIAL_LENGTH ||
            Current.Status !=
                Superblock.Databaseˉsuperblockˉselectionˉstatus.Valid {
            return 3;
        }
        let Interrupted: i32 = Publishˉfirst(Current, Maximumˉactions);
        if Interrupted != 0 { return Interrupted; }
        return Interruptionˉresult(Maximumˉactions);
    }
    if Current.Tailˉbytes != 0u64 {
        let Tailˉrecovered: i32 = Recoverˉtail(Description, Current);
        if Tailˉrecovered != 0 { return Tailˉrecovered; }
        Description = Storage.Storageˉdescribe();
        Current = Selectˉcurrent(Description);
    }
    if Description.Storageˉlength == INITIAL_LENGTH {
        if Current.Generation != 1u64 ||
            Current.Committedˉsequence != 0u64 ||
            Current.Rootˉpage != 0u64 || Current.Pageˉcount != 1u64 ||
            Current.Rootˉdepth != 1u32 || Current.Tailˉbytes != 0u64 {
            return 4;
        }
        let Invalid: Writer.Databaseˉdurableˉrootˉupsertˉresult =
            Writer.Databaseˉdurableˉrootˉupsert(
                Current,
                Emptyˉbytes(),
                Value(),
                4u32
            );
        if Invalid.Status !=
                Writer.Databaseˉdurableˉrootˉupsertˉstatus.Invalidˉkey ||
            Invalid.Pageˉvisits != 0u32 || Invalid.Actions != 0u32 {
            return 5;
        }
        let Published: i32 = Publishˉfirst(Current, 4u32);
        if Published != 0 { return Published; }
        Description = Storage.Storageˉdescribe();
        Current = Selectˉcurrent(Description);
    }
    return Validateˉcommitted(Description, Current);
}
