module Windvaleˉnativeˉtestˉdatabaseˉtransactionˉtreeˉcompletion profile portable;

import Windvaleˉdatabaseˉdurableˉpage as Page;
import Windvaleˉdatabaseˉdurableˉsuperblock as Superblock;
import Windvaleˉdatabaseˉtransactionˉmutations as Transaction;
import Windvaleˉdatabaseˉtransactionˉtreeˉcompletion as Completion;
import Windvaleˉdatabaseˉtreeˉnode as Tree;

const PAGE_SIZE: u32 = 4096u32;
const MAXIMUM_PAYLOAD: u32 = 3968u32;
const NO_PAGE: u64 = 18446744073709551615u64;

fn Empty() -> bytes {
    return Bytesˉslice(Bytesˉfromˉu8(0u8), 0u32, 0u32);
}

fn Replace(Input: bytes, Offset: u32, Count: u32, Value: bytes) -> bytes {
    return Bytesˉconcat(
        Bytesˉconcat(Bytesˉslice(Input, 0u32, Offset), Value),
        Bytesˉslice(
            Input, Offset + Count,
            Bytesˉlength(Input) - Offset - Count
        )
    );
}

fn Current() -> Superblock.Databaseˉsuperblockˉselection {
    return Superblock.Databaseˉsuperblockˉselection(
        Superblock.Databaseˉsuperblockˉselectionˉstatus.Valid,
        Superblock.Databaseˉsuperblockˉslot.Second,
        Superblock.Databaseˉsuperblockˉerror.Valid,
        Superblock.Databaseˉsuperblockˉerror.Valid,
        0u64, 1u64, 4u64, 3u64, 2u64, 20u64, 19u64, 1u64, 21u64,
        86528u64, PAGE_SIZE, 4u32
    );
}

fn Leaf(First: u8, Second: u8) -> bytes {
    let One: Tree.Databaseˉtreeˉleafˉupsertˉresult =
        Tree.Databaseˉtreeˉleafˉupsert(
            Empty(), Bytesˉfromˉu8(First), Bytesˉfromˉu8(First), MAXIMUM_PAYLOAD
        );
    let Two: Tree.Databaseˉtreeˉleafˉupsertˉresult =
        Tree.Databaseˉtreeˉleafˉupsert(
            One.Bytes, Bytesˉfromˉu8(Second), Bytesˉfromˉu8(Second), MAXIMUM_PAYLOAD
        );
    return Two.Bytes;
}

fn Branch(Separator: u8, Left: u64, Right: u64) -> bytes {
    let Result: Tree.Databaseˉtreeˉnodeˉresult =
        Tree.Databaseˉtreeˉbranchˉtwoˉchildren(
            Bytesˉfromˉu8(Separator), Left, Right, MAXIMUM_PAYLOAD
        );
    return Result.Bytes;
}

fn Durable(
    Kind: Page.Databaseˉdurableˉpageˉkind,
    Identifier: u64,
    Payload: bytes
) -> bytes {
    let Node: Tree.Databaseˉtreeˉnodeˉresult =
        Tree.Databaseˉtreeˉnodeˉdecode(Payload);
    let Result: Page.Databaseˉdurableˉpageˉresult =
        Page.Databaseˉdurableˉpageˉencode(
            Page.Databaseˉdurableˉpage(
                Kind, PAGE_SIZE, Identifier, 3u64, 2u64, NO_PAGE,
                Node.Entryˉcount, Payload
            )
        );
    return Result.Bytes;
}

fn Root() -> bytes {
    return Durable(
        Page.Databaseˉdurableˉpageˉkind.Root, 20u64,
        Branch(5u8, 18u64, 19u64)
    );
}

fn Grandparent(Pageˉidentifier: u64, Separator: u8, Left: u64, Right: u64) -> bytes {
    return Durable(
        Page.Databaseˉdurableˉpageˉkind.Branch, Pageˉidentifier,
        Branch(Separator, Left, Right)
    );
}

fn Parent(Pageˉidentifier: u64, Separator: u8, Left: u64, Right: u64) -> bytes {
    return Durable(
        Page.Databaseˉdurableˉpageˉkind.Branch, Pageˉidentifier,
        Branch(Separator, Left, Right)
    );
}

fn Leafˉpage(Identifier: u64, First: u8, Second: u8) -> bytes {
    return Durable(
        Page.Databaseˉdurableˉpageˉkind.Leaf, Identifier, Leaf(First, Second)
    );
}

fn Paths() -> bytes {
    let Left: bytes = Bytesˉconcat(
        Bytesˉconcat(
            Bytesˉconcat(Root(), Grandparent(18u64, 3u8, 10u64, 11u64)),
            Parent(10u64, 2u8, 8u64, 9u64)
        ),
        Leafˉpage(8u64, 0u8, 1u8)
    );
    let Right: bytes = Bytesˉconcat(
        Bytesˉconcat(
            Bytesˉconcat(Root(), Grandparent(19u64, 8u8, 12u64, 13u64)),
            Parent(13u64, 9u8, 6u64, 7u64)
        ),
        Leafˉpage(7u64, 9u8, 10u8)
    );
    return Bytesˉconcat(Left, Right);
}

fn Put(Key: u8, Value: u8) -> bytes {
    let Result: Transaction.Databaseˉtransactionˉmutationˉcomponent =
        Transaction.Databaseˉtransactionˉmutationˉput(
            Bytesˉfromˉu8(Key), Bytesˉfromˉu8(Value)
        );
    return Result.Bytes;
}

fn Mutations(Left: u8, Right: u8) -> bytes {
    let Result: Transaction.Databaseˉtransactionˉmutationsˉresult =
        Transaction.Databaseˉtransactionˉmutationsˉencode(
            2u32, Bytesˉconcat(Put(1u8, Left), Put(9u8, Right))
        );
    return Result.Bytes;
}

fn Pageˉat(Pages: bytes, Index: u32) -> Page.Databaseˉdurableˉpageˉresult {
    return Page.Databaseˉdurableˉpageˉdecode(
        Bytesˉslice(Pages, Index * PAGE_SIZE, PAGE_SIZE)
    );
}

export fn Main() -> i32 {
    let Mutationsˉbytes: bytes = Mutations(11u8, 99u8);
    let Pathsˉbytes: bytes = Paths();
    let First: Completion.Databaseˉtransactionˉtreeˉcompletionˉresult =
        Completion.Databaseˉtransactionˉtreeˉcompletionˉplan(
            Current(), Mutationsˉbytes, Pathsˉbytes
        );
    let Second: Completion.Databaseˉtransactionˉtreeˉcompletionˉresult =
        Completion.Databaseˉtransactionˉtreeˉcompletionˉplan(
            Current(), Mutationsˉbytes, Pathsˉbytes
        );
    let Validated: Completion.Databaseˉtransactionˉtreeˉcompletionˉresult =
        Completion.Databaseˉtransactionˉtreeˉcompletionˉvalidate(
            Current(), Mutationsˉbytes, Pathsˉbytes, First.Bytes, First.Pages
        );
    if First.Error != Completion.Databaseˉtransactionˉtreeˉcompletionˉerror.Valid ||
        Second.Error != Completion.Databaseˉtransactionˉtreeˉcompletionˉerror.Valid ||
        Validated.Error != Completion.Databaseˉtransactionˉtreeˉcompletionˉerror.Valid ||
        !First.Changed || First.Rootˉgrown || First.Pageˉsize != PAGE_SIZE ||
        First.Inputˉrootˉdepth != 4u32 || First.Outputˉrootˉdepth != 4u32 ||
        First.Ancestorˉroundˉcount != 2u32 || First.Leafˉpageˉcount != 2u32 ||
        First.Branchˉpageˉcount != 2u32 || First.Ancestorˉpageˉcount != 3u32 ||
        First.Rootˉpageˉcount != 0u32 || First.Pageˉcount != 7u32 ||
        First.Targetˉgeneration != 4u64 || First.Targetˉsequence != 3u64 ||
        First.Firstˉpage != 21u64 || First.Nextˉpage != 28u64 ||
        First.Rootˉpage != 27u64 ||
        Bytesˉlength(First.Pages) != 7u32 * PAGE_SIZE ||
        Bytesˉlength(First.Bytes) != 208u32 ||
        Bytesˉlength(First.Bytes) != Bytesˉlength(Second.Bytes) ||
        Bytesˉlength(First.Pages) != Bytesˉlength(Second.Pages) {
        return 1;
    }
    let Lowˉleaf: Page.Databaseˉdurableˉpageˉresult = Pageˉat(First.Pages, 0u32);
    let Highˉleaf: Page.Databaseˉdurableˉpageˉresult = Pageˉat(First.Pages, 1u32);
    let Lowˉparent: Page.Databaseˉdurableˉpageˉresult = Pageˉat(First.Pages, 2u32);
    let Highˉparent: Page.Databaseˉdurableˉpageˉresult = Pageˉat(First.Pages, 3u32);
    let Lowˉgrandparent: Page.Databaseˉdurableˉpageˉresult = Pageˉat(First.Pages, 4u32);
    let Highˉgrandparent: Page.Databaseˉdurableˉpageˉresult = Pageˉat(First.Pages, 5u32);
    let Rootˉpage: Page.Databaseˉdurableˉpageˉresult = Pageˉat(First.Pages, 6u32);
    let Rootˉlow: Tree.Databaseˉtreeˉbranchˉrouteˉresult =
        Tree.Databaseˉtreeˉbranchˉroute(
            Rootˉpage.Payload, Bytesˉfromˉu8(1u8),
            false, Empty(), false, Empty()
        );
    let Rootˉhigh: Tree.Databaseˉtreeˉbranchˉrouteˉresult =
        Tree.Databaseˉtreeˉbranchˉroute(
            Rootˉpage.Payload, Bytesˉfromˉu8(9u8),
            false, Empty(), false, Empty()
        );
    if Lowˉleaf.Pageˉidentifier != 21u64 || Highˉleaf.Pageˉidentifier != 22u64 ||
        Lowˉparent.Pageˉidentifier != 23u64 || Highˉparent.Pageˉidentifier != 24u64 ||
        Lowˉgrandparent.Pageˉidentifier != 25u64 ||
        Highˉgrandparent.Pageˉidentifier != 26u64 ||
        Rootˉpage.Pageˉidentifier != 27u64 ||
        Rootˉpage.Kind != Page.Databaseˉdurableˉpageˉkind.Root ||
        Rootˉpage.Previousˉpage != 20u64 ||
        Rootˉlow.Child != 25u64 || Rootˉhigh.Child != 26u64 {
        return 2;
    }
    let Unchangedˉmutations: bytes = Mutations(1u8, 9u8);
    let Unchanged: Completion.Databaseˉtransactionˉtreeˉcompletionˉresult =
        Completion.Databaseˉtransactionˉtreeˉcompletionˉplan(
            Current(), Unchangedˉmutations, Pathsˉbytes
        );
    let Truncated: Completion.Databaseˉtransactionˉtreeˉcompletionˉresult =
        Completion.Databaseˉtransactionˉtreeˉcompletionˉdecode(
            Bytesˉslice(First.Bytes, 0u32, Bytesˉlength(First.Bytes) - 1u32)
        );
    let Badˉmagic: Completion.Databaseˉtransactionˉtreeˉcompletionˉresult =
        Completion.Databaseˉtransactionˉtreeˉcompletionˉdecode(
            Replace(First.Bytes, 0u32, 4u32, Bytesˉfromˉu32ˉlittle(0u32))
        );
    let Badˉpages: bytes = Replace(
        First.Pages, 0u32, 1u32, Bytesˉfromˉu8(0u8)
    );
    let Digestˉmismatch: Completion.Databaseˉtransactionˉtreeˉcompletionˉresult =
        Completion.Databaseˉtransactionˉtreeˉcompletionˉvalidate(
            Current(), Mutationsˉbytes, Pathsˉbytes, First.Bytes, Badˉpages
        );
    if Unchanged.Error !=
            Completion.Databaseˉtransactionˉtreeˉcompletionˉerror.Valid ||
        Unchanged.Changed || Unchanged.Pageˉcount != 0u32 ||
        Unchanged.Rootˉpage != 20u64 ||
        Truncated.Error !=
            Completion.Databaseˉtransactionˉtreeˉcompletionˉerror.Invalidˉlength ||
        Badˉmagic.Error !=
            Completion.Databaseˉtransactionˉtreeˉcompletionˉerror.Invalidˉmagic ||
        Digestˉmismatch.Error !=
            Completion.Databaseˉtransactionˉtreeˉcompletionˉerror.Invalidˉdigest {
        return 3;
    }
    return 0;
}
