module Databaseˉstorageˉgeometryˉadapter profile portable;

import Windvaleˉdatabaseˉstorageˉgeometry as Geometry;

fn Databaseˉstorageˉgeometryˉerror(
    Error: Geometry.Databaseˉpageˉrangeˉerror
) -> u32 {
    match Error {
        case Geometry.Databaseˉpageˉrangeˉerror.Invalidˉpageˉsize { return 1u32; }
        case Geometry.Databaseˉpageˉrangeˉerror.Arithmeticˉoverflow { return 2u32; }
        case Geometry.Databaseˉpageˉrangeˉerror.Outsideˉstorage { return 3u32; }
    }
}

export fn Main(Input: bytes) -> bytes {
    if Bytesˉlength(Input) != 28u32 {
        return Bytesˉfromˉu32ˉlittle(4u32);
    }

    let Result: Geometry.Databaseˉpageˉrangeˉresult =
        Geometry.Databaseˉstorageˉpageˉrange(
            Bytesˉreadˉu64ˉlittle(Input, 0u32),
            Bytesˉreadˉu32ˉlittle(Input, 8u32),
            Bytesˉreadˉu64ˉlittle(Input, 12u32),
            Bytesˉreadˉu64ˉlittle(Input, 20u32)
        );
    match Result {
        case Geometry.Databaseˉpageˉrangeˉresult.Valid(Value) {
            var Output: bytes = Bytesˉfromˉu32ˉlittle(0u32);
            Output = Bytesˉconcat(Output, Bytesˉfromˉu64ˉlittle(Value.Pageˉidentifier));
            Output = Bytesˉconcat(Output, Bytesˉfromˉu64ˉlittle(Value.Offset));
            Output = Bytesˉconcat(Output, Bytesˉfromˉu64ˉlittle(Value.Length));
            return Bytesˉconcat(
                Output,
                Bytesˉfromˉu64ˉlittle(Value.Endˉexclusive)
            );
        }
        case Geometry.Databaseˉpageˉrangeˉresult.Failure(Error) {
            return Bytesˉfromˉu32ˉlittle(Databaseˉstorageˉgeometryˉerror(Error));
        }
    }
}
