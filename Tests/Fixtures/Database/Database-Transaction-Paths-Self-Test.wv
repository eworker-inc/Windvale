module Windvaleˉnativeˉtestˉdatabaseˉtransactionˉpaths profile portable;

import Windvaleˉdatabaseˉdurableˉpage as Page;
import Windvaleˉdatabaseˉdurableˉsuperblock as Superblock;
import Windvaleˉdatabaseˉtransactionˉmutations as Transaction;
import Windvaleˉdatabaseˉtransactionˉpaths as Paths;
import Windvaleˉdatabaseˉtreeˉnode as Tree;

const PAGE_SIZE: u32 = 4096u32;
const MAXIMUM_PAYLOAD: u32 = 3968u32;
const NO_PAGE: u64 = 18446744073709551615u64;

fn Empty() -> bytes {
    return Bytesˉslice(Bytesˉfromˉu8(0u8), 0u32, 0u32);
}

fn Currentˉcontract(
    Pageˉsize: u32,
    Rootˉpage: u64,
    Rootˉdepth: u32
) -> Superblock.Databaseˉsuperblockˉselection {
    return Superblock.Databaseˉsuperblockˉselection(
        Superblock.Databaseˉsuperblockˉselectionˉstatus.Valid,
        Superblock.Databaseˉsuperblockˉslot.Second,
        Superblock.Databaseˉsuperblockˉerror.Valid,
        Superblock.Databaseˉsuperblockˉerror.Valid,
        0u64,
        1u64,
        2u64,
        3u64,
        2u64,
        Rootˉpage,
        11u64,
        1u64,
        12u64,
        49664u64,
        Pageˉsize,
        Rootˉdepth
    );
}

fn Currentˉsize(Pageˉsize: u32) -> Superblock.Databaseˉsuperblockˉselection {
    return Currentˉcontract(Pageˉsize, 10u64, 2u32);
}

fn Current() -> Superblock.Databaseˉsuperblockˉselection {
    return Currentˉsize(PAGE_SIZE);
}

fn Leaf(First: u8, Second: u8) -> bytes {
    let One: Tree.Databaseˉtreeˉleafˉupsertˉresult =
        Tree.Databaseˉtreeˉleafˉupsert(
            Empty(),
            Bytesˉfromˉu8(First),
            Bytesˉfromˉu8(First),
            MAXIMUM_PAYLOAD
        );
    let Two: Tree.Databaseˉtreeˉleafˉupsertˉresult =
        Tree.Databaseˉtreeˉleafˉupsert(
            One.Bytes,
            Bytesˉfromˉu8(Second),
            Bytesˉfromˉu8(Second),
            MAXIMUM_PAYLOAD
        );
    return Two.Bytes;
}

fn Branch(Separator: u8) -> bytes {
    let Result: Tree.Databaseˉtreeˉnodeˉresult =
        Tree.Databaseˉtreeˉbranchˉtwoˉchildren(
            Bytesˉfromˉu8(Separator),
            8u64,
            9u64,
            MAXIMUM_PAYLOAD
        );
    return Result.Bytes;
}

fn Durable(
    Kind: Page.Databaseˉdurableˉpageˉkind,
    Identifier: u64,
    Payload: bytes
) -> bytes {
    let Node: Tree.Databaseˉtreeˉnodeˉresult =
        Tree.Databaseˉtreeˉnodeˉdecode(Payload);
    let Result: Page.Databaseˉdurableˉpageˉresult =
        Page.Databaseˉdurableˉpageˉencode(
            Page.Databaseˉdurableˉpage(
                Kind,
                PAGE_SIZE,
                Identifier,
                3u64,
                2u64,
                NO_PAGE,
                Node.Entryˉcount,
                Payload
            )
        );
    return Result.Bytes;
}

fn Root() -> bytes {
    return Durable(Page.Databaseˉdurableˉpageˉkind.Root, 10u64, Branch(5u8));
}

fn Left() -> bytes {
    return Durable(Page.Databaseˉdurableˉpageˉkind.Leaf, 8u64, Leaf(1u8, 2u8));
}

fn Right() -> bytes {
    return Durable(Page.Databaseˉdurableˉpageˉkind.Leaf, 9u64, Leaf(6u8, 7u8));
}

fn Put(Key: u8, Value: u8) -> bytes {
    let Result: Transaction.Databaseˉtransactionˉmutationˉcomponent =
        Transaction.Databaseˉtransactionˉmutationˉput(
            Bytesˉfromˉu8(Key),
            Bytesˉfromˉu8(Value)
        );
    return Result.Bytes;
}

fn Delete(Key: u8) -> bytes {
    let Result: Transaction.Databaseˉtransactionˉmutationˉcomponent =
        Transaction.Databaseˉtransactionˉmutationˉdelete(Bytesˉfromˉu8(Key));
    return Result.Bytes;
}

fn Mutationˉset(First: bytes, Second: bytes) -> bytes {
    let Result: Transaction.Databaseˉtransactionˉmutationsˉresult =
        Transaction.Databaseˉtransactionˉmutationsˉencode(
            2u32,
            Bytesˉconcat(First, Second)
        );
    return Result.Bytes;
}

fn Twoˉleafˉcontract() -> i32 {
    let Mutations: bytes = Mutationˉset(Put(2u8, 20u8), Delete(6u8));
    let Input: bytes = Bytesˉconcat(
        Bytesˉconcat(Root(), Left()),
        Bytesˉconcat(Root(), Right())
    );
    let Result: Paths.Databaseˉtransactionˉpathsˉresult =
        Paths.Databaseˉtransactionˉpathsˉvalidate(Current(), Mutations, Input);
    if Result.Error != Paths.Databaseˉtransactionˉpathsˉerror.Valid ||
        Result.Pathˉcount != 2u32 || Result.Uniqueˉleafˉcount != 2u32 ||
        Bytesˉlength(Result.Bytes) != PAGE_SIZE * 4u32 {
        return 1;
    }
    return 0;
}

fn Sharedˉleafˉcontract() -> i32 {
    let Mutations: bytes = Mutationˉset(Put(1u8, 10u8), Delete(2u8));
    let Path: bytes = Bytesˉconcat(Root(), Left());
    let Result: Paths.Databaseˉtransactionˉpathsˉresult =
        Paths.Databaseˉtransactionˉpathsˉvalidate(
            Current(),
            Mutations,
            Bytesˉconcat(Path, Path)
        );
    if Result.Error != Paths.Databaseˉtransactionˉpathsˉerror.Valid ||
        Result.Uniqueˉleafˉcount != 1u32 {
        return 1;
    }
    return 0;
}

fn Depthˉoneˉcontract() -> i32 {
    let Mutations: bytes = Mutationˉset(Put(1u8, 10u8), Delete(2u8));
    let Rootˉleaf: bytes = Durable(
        Page.Databaseˉdurableˉpageˉkind.Root,
        8u64,
        Leaf(1u8, 2u8)
    );
    let Result: Paths.Databaseˉtransactionˉpathsˉresult =
        Paths.Databaseˉtransactionˉpathsˉvalidate(
            Currentˉcontract(PAGE_SIZE, 8u64, 1u32),
            Mutations,
            Bytesˉconcat(Rootˉleaf, Rootˉleaf)
        );
    if Result.Error != Paths.Databaseˉtransactionˉpathsˉerror.Valid ||
        Result.Pathˉcount != 2u32 || Result.Uniqueˉleafˉcount != 1u32 {
        return 1;
    }
    return 0;
}

fn Rejections() -> i32 {
    let Mutations: bytes = Mutationˉset(Put(2u8, 20u8), Delete(6u8));
    let Valid: bytes = Bytesˉconcat(
        Bytesˉconcat(Root(), Left()),
        Bytesˉconcat(Root(), Right())
    );
    let Short: Paths.Databaseˉtransactionˉpathsˉresult =
        Paths.Databaseˉtransactionˉpathsˉvalidate(
            Current(),
            Mutations,
            Bytesˉslice(Valid, 0u32, Bytesˉlength(Valid) - 1u32)
        );
    if Short.Error != Paths.Databaseˉtransactionˉpathsˉerror.Invalidˉlength {
        return 1;
    }
    let Wrongˉleaf: bytes = Bytesˉconcat(
        Bytesˉconcat(Root(), Right()),
        Bytesˉconcat(Root(), Right())
    );
    let Mismatch: Paths.Databaseˉtransactionˉpathsˉresult =
        Paths.Databaseˉtransactionˉpathsˉvalidate(Current(), Mutations, Wrongˉleaf);
    if Mismatch.Error != Paths.Databaseˉtransactionˉpathsˉerror.Pathˉmismatch ||
        Mismatch.Failedˉpath != 0u32 || Mismatch.Failedˉlevel != 1u32 {
        return 2;
    }
    let Differentˉroot: bytes = Durable(
        Page.Databaseˉdurableˉpageˉkind.Root,
        10u64,
        Branch(4u8)
    );
    let Inconsistentˉpaths: bytes = Bytesˉconcat(
        Bytesˉconcat(Root(), Left()),
        Bytesˉconcat(Differentˉroot, Right())
    );
    let Inconsistent: Paths.Databaseˉtransactionˉpathsˉresult =
        Paths.Databaseˉtransactionˉpathsˉvalidate(
            Current(),
            Mutations,
            Inconsistentˉpaths
        );
    if Inconsistent.Error != Paths.Databaseˉtransactionˉpathsˉerror.Inconsistentˉsharedˉpage ||
        Inconsistent.Failedˉpath != 1u32 || Inconsistent.Failedˉlevel != 0u32 {
        return 3;
    }
    let Invalidˉmutations: Paths.Databaseˉtransactionˉpathsˉresult =
        Paths.Databaseˉtransactionˉpathsˉvalidate(Current(), Empty(), Empty());
    if Invalidˉmutations.Error != Paths.Databaseˉtransactionˉpathsˉerror.Invalidˉmutations {
        return 4;
    }
    let Invalidˉcurrent: Paths.Databaseˉtransactionˉpathsˉresult =
        Paths.Databaseˉtransactionˉpathsˉvalidate(Currentˉsize(1u32), Mutations, Valid);
    if Invalidˉcurrent.Error != Paths.Databaseˉtransactionˉpathsˉerror.Invalidˉcurrent {
        return 5;
    }
    let Unsupported: Paths.Databaseˉtransactionˉpathsˉresult =
        Paths.Databaseˉtransactionˉpathsˉvalidate(
            Currentˉcontract(PAGE_SIZE, 10u64, 9u32),
            Mutations,
            Valid
        );
    if Unsupported.Error != Paths.Databaseˉtransactionˉpathsˉerror.Unsupportedˉdepth {
        return 6;
    }
    let Corrupt: bytes = Bytesˉconcat(
        Bytesˉfromˉu8(0u8),
        Bytesˉslice(Valid, 1u32, Bytesˉlength(Valid) - 1u32)
    );
    let Invalidˉpage: Paths.Databaseˉtransactionˉpathsˉresult =
        Paths.Databaseˉtransactionˉpathsˉvalidate(Current(), Mutations, Corrupt);
    if Invalidˉpage.Error != Paths.Databaseˉtransactionˉpathsˉerror.Invalidˉpage ||
        Invalidˉpage.Failedˉpath != 0u32 || Invalidˉpage.Failedˉlevel != 0u32 {
        return 7;
    }
    return 0;
}

export fn Main() -> i32 {
    let Two: i32 = Twoˉleafˉcontract();
    if Two != 0 { return 100 + Two; }
    let Shared: i32 = Sharedˉleafˉcontract();
    if Shared != 0 { return 200 + Shared; }
    let Depthˉone: i32 = Depthˉoneˉcontract();
    if Depthˉone != 0 { return 250 + Depthˉone; }
    let Rejected: i32 = Rejections();
    if Rejected != 0 { return 300 + Rejected; }
    return 0;
}
