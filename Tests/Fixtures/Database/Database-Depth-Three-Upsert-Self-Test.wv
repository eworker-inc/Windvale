        }
        if Result.Error ==
                Upsert.Databaseˉdepthˉthreeˉupsertˉerror.Invalidˉleftˉleaf {
            return 14;
        }
        if Result.Error ==
                Upsert.Databaseˉdepthˉthreeˉupsertˉerror.Invalidˉrightˉleaf {
            return 15;
        }
        if Result.Error ==
                Upsert.Databaseˉdepthˉthreeˉupsertˉerror.Invalidˉleftˉbranch {
            return 16;
        }
        if Result.Error ==
                Upsert.Databaseˉdepthˉthreeˉupsertˉerror.Invalidˉrightˉbranch {
            return 17;
        }
        if Result.Error ==
                Upsert.Databaseˉdepthˉthreeˉupsertˉerror.Invalidˉleftˉroot {
            return 18;
        }
        if Result.Error ==
                Upsert.Databaseˉdepthˉthreeˉupsertˉerror.Invalidˉrightˉroot {
            return 19;
        }
        if Result.Error ==
                Upsert.Databaseˉdepthˉthreeˉupsertˉerror.Invalidˉnewˉroot {
            return 20;
        }
        if Result.Error ==
                Upsert.Databaseˉdepthˉthreeˉupsertˉerror.Invalidˉcommit {
            return 21;
        }
        if Result.Error ==
                Upsert.Databaseˉdepthˉthreeˉupsertˉerror.Invalidˉrootˉpage {
            return 22;
        }
        if Result.Error == Upsert.Databaseˉdepthˉthreeˉupsertˉerror.Rootˉmismatch {
            return 23;
        }
        if Result.Error ==
                Upsert.Databaseˉdepthˉthreeˉupsertˉerror.Invalidˉrootˉnode {
            return 24;
        }
        if Result.Error ==
                Upsert.Databaseˉdepthˉthreeˉupsertˉerror.Invalidˉrootˉroute {
            return 25;
        }
        if Result.Error ==
                Upsert.Databaseˉdepthˉthreeˉupsertˉerror.Invalidˉbranchˉpage {
            return 26;
        }
        if Result.Error == Upsert.Databaseˉdepthˉthreeˉupsertˉerror.Branchˉmismatch {
            return 27;
        }
        if Result.Error ==
                Upsert.Databaseˉdepthˉthreeˉupsertˉerror.Invalidˉbranchˉnode {
            return 28;
        }
        if Result.Error ==
                Upsert.Databaseˉdepthˉthreeˉupsertˉerror.Invalidˉbranchˉroute {
            return 29;
        }
        if Result.Error ==
                Upsert.Databaseˉdepthˉthreeˉupsertˉerror.Invalidˉleafˉpage {
            return 30;
        }
        if Result.Error == Upsert.Databaseˉdepthˉthreeˉupsertˉerror.Leafˉmismatch {
            return 31;
        }
        if Result.Error ==
                Upsert.Databaseˉdepthˉthreeˉupsertˉerror.Invalidˉleafˉnode {
            return 32;
        }
        if Result.Error ==
                Upsert.Databaseˉdepthˉthreeˉupsertˉerror.Invalidˉupsert {
            return 33;
        }
        if Result.Error ==
                Upsert.Databaseˉdepthˉthreeˉupsertˉerror.Generationˉexhausted {
            return 34;
        }
        if Result.Error ==
                Upsert.Databaseˉdepthˉthreeˉupsertˉerror.Sequenceˉexhausted {
            return 35;
        }
        if Result.Error ==
                Upsert.Databaseˉdepthˉthreeˉupsertˉerror.Pageˉidentifierˉexhausted {
            return 36;
        }
        return 13;
    }
    if !Result.Leafˉsplit || !Result.Branchˉsplit ||
        Result.Rootˉsplit || Result.Rootˉdepth != 3u32 ||
        Result.Leftˉleafˉpage != 12u64 ||
        Result.Rightˉleafˉpage != 13u64 ||
        Result.Leftˉbranchˉpage != 14u64 ||
        Result.Rightˉbranchˉpage != 15u64 || Result.Rootˉpage != 16u64 ||
        Result.Commit.Logˉpage != 17u64 ||
        Bytesˉlength(Result.Commit.Pages) != PAGE_SIZE * 6u32 {
        return 1;
    }
    let Rightˉleaf: Page.Databaseˉdurableˉpageˉresult =
        Page.Databaseˉdurableˉpageˉdecode(
            Bytesˉslice(Result.Commit.Pages, PAGE_SIZE, PAGE_SIZE)
        );
    let Leftˉbranch: Page.Databaseˉdurableˉpageˉresult =
        Page.Databaseˉdurableˉpageˉdecode(
            Bytesˉslice(Result.Commit.Pages, PAGE_SIZE * 2u32, PAGE_SIZE)
        );
    let Rightˉbranch: Page.Databaseˉdurableˉpageˉresult =
        Page.Databaseˉdurableˉpageˉdecode(
            Bytesˉslice(Result.Commit.Pages, PAGE_SIZE * 3u32, PAGE_SIZE)
        );
    let Newˉroot: Page.Databaseˉdurableˉpageˉresult =
        Page.Databaseˉdurableˉpageˉdecode(
            Bytesˉslice(Result.Commit.Pages, PAGE_SIZE * 4u32, PAGE_SIZE)
        );
    if Leftˉbranch.Previousˉpage != 9u64 ||
        Rightˉbranch.Previousˉpage != NO_PAGE ||
        Newˉroot.Previousˉpage != 10u64 {
        return 2;
    }
    let Rootˉroute: Tree.Databaseˉtreeˉbranchˉrouteˉresult =
        Tree.Databaseˉtreeˉbranchˉroute(
            Newˉroot.Payload,
            Wideˉkey(10u8),
            false,
            Emptyˉbytes(),
            false,
            Emptyˉbytes()
        );
    let Branchˉroute: Tree.Databaseˉtreeˉbranchˉrouteˉresult =
        Tree.Databaseˉtreeˉbranchˉroute(
            Rightˉbranch.Payload,
            Wideˉkey(10u8),
            true,
            Wideˉkey(7u8),
            false,
            Emptyˉbytes()
        );
    let Lookup: Tree.Databaseˉtreeˉleafˉlookupˉresult =
        Tree.Databaseˉtreeˉleafˉlookup(Rightˉleaf.Payload, Wideˉkey(10u8));
    if Rootˉroute.Child != 15u64 { return 3; }
    if Branchˉroute.Child != 13u64 { return 4; }
    if !Lookup.Found { return 5; }
    return 0;
}

fn Rootˉsplit() -> i32 {
    let Root: Page.Databaseˉdurableˉpageˉresult = Durableˉpage(
        Page.Databaseˉdurableˉpageˉkind.Root,
        14u64,
        Branchˉfour(
            Wideˉkey(3u8),
            Wideˉkey(5u8),
            Wideˉkey(7u8),
            8u64,
            9u64,
            10u64,
            12u64,
            13u64,
            11u64
        )
    );
    let Branch: Page.Databaseˉdurableˉpageˉresult = Durableˉpage(
        Page.Databaseˉdurableˉpageˉkind.Branch,
        11u64,
        Branchˉfour(
            Wideˉkey(8u8),
            Wideˉkey(9u8),
            Wideˉkey(10u8),
            1u64,
            2u64,
            3u64,
            4u64,
            6u64,
            7u64
        )
    );
    let Leaf: Page.Databaseˉdurableˉpageˉresult = Durableˉpage(
        Page.Databaseˉdurableˉpageˉkind.Leaf,
        7u64,
        Leafˉtwo(Wideˉkey(11u8), Wideˉkey(13u8), 500u32)
    );
    let Result: Upsert.Databaseˉdepthˉthreeˉupsert =
        Upsert.Databaseˉdepthˉthreeˉupsertˉbegin(
            Current(14u64, 16u64, 66048u64, 3u32),
            Root,
            Branch,
            Leaf,
            Wideˉkey(12u8),
            Zeroes(500u32)
        );
    if Result.Error != Upsert.Databaseˉdepthˉthreeˉupsertˉerror.Valid ||
        !Result.Leafˉsplit || !Result.Branchˉsplit ||
        !Result.Rootˉsplit || Result.Rootˉdepth != 4u32 ||
        Result.Leftˉleafˉpage != 16u64 ||
        Result.Rightˉleafˉpage != 17u64 ||
        Result.Leftˉbranchˉpage != 18u64 ||
        Result.Rightˉbranchˉpage != 19u64 ||
        Result.Leftˉrootˉpage != 20u64 ||
        Result.Rightˉrootˉpage != 21u64 || Result.Rootˉpage != 22u64 ||
        Result.Commit.Logˉpage != 23u64 ||
        Result.Commit.Targetˉlength != 98816u64 ||
        Bytesˉlength(Result.Commit.Pages) != PAGE_SIZE * 8u32 {
        return 1;
    }
    let Rightˉleaf: Page.Databaseˉdurableˉpageˉresult =
        Page.Databaseˉdurableˉpageˉdecode(
            Bytesˉslice(Result.Commit.Pages, PAGE_SIZE, PAGE_SIZE)
        );
    let Rightˉbranch: Page.Databaseˉdurableˉpageˉresult =
        Page.Databaseˉdurableˉpageˉdecode(
            Bytesˉslice(Result.Commit.Pages, PAGE_SIZE * 3u32, PAGE_SIZE)
        );
    let Leftˉroot: Page.Databaseˉdurableˉpageˉresult =
        Page.Databaseˉdurableˉpageˉdecode(
            Bytesˉslice(Result.Commit.Pages, PAGE_SIZE * 4u32, PAGE_SIZE)
        );
    let Rightˉroot: Page.Databaseˉdurableˉpageˉresult =
        Page.Databaseˉdurableˉpageˉdecode(
            Bytesˉslice(Result.Commit.Pages, PAGE_SIZE * 5u32, PAGE_SIZE)
        );
    let Newˉroot: Page.Databaseˉdurableˉpageˉresult =
        Page.Databaseˉdurableˉpageˉdecode(
            Bytesˉslice(Result.Commit.Pages, PAGE_SIZE * 6u32, PAGE_SIZE)
        );
    if Leftˉroot.Previousˉpage != 14u64 ||
        Rightˉroot.Previousˉpage != NO_PAGE ||
        Newˉroot.Previousˉpage != NO_PAGE ||
        Newˉroot.Kind != Page.Databaseˉdurableˉpageˉkind.Root {
        return 2;
    }
    let Rootˉroute: Tree.Databaseˉtreeˉbranchˉrouteˉresult =
        Tree.Databaseˉtreeˉbranchˉroute(
            Newˉroot.Payload,
            Wideˉkey(12u8),
            false,
            Emptyˉbytes(),
            false,
            Emptyˉbytes()
        );
    if Rootˉroute.Child != 21u64 { return 3; }
    let Rootˉchildˉroute: Tree.Databaseˉtreeˉbranchˉrouteˉresult =
        Tree.Databaseˉtreeˉbranchˉroute(
            Rightˉroot.Payload,
            Wideˉkey(12u8),
            true,
            Wideˉkey(5u8),
            false,
            Emptyˉbytes()
        );
    if Rootˉchildˉroute.Child != 19u64 { return 4; }
    let Branchˉroute: Tree.Databaseˉtreeˉbranchˉrouteˉresult =
        Tree.Databaseˉtreeˉbranchˉroute(
            Rightˉbranch.Payload,
            Wideˉkey(12u8),
            true,
            Wideˉkey(9u8),
            false,
            Emptyˉbytes()
        );
    let Lookup: Tree.Databaseˉtreeˉleafˉlookupˉresult =
        Tree.Databaseˉtreeˉleafˉlookup(Rightˉleaf.Payload, Wideˉkey(12u8));
    if Branchˉroute.Child != 17u64 || !Lookup.Found { return 5; }
    return 0;
}

fn Rejections() -> i32 {
    let Existingˉbranch: Page.Databaseˉdurableˉpageˉresult = Ordinaryˉbranch();
    let Existingˉleaf: Page.Databaseˉdurableˉpageˉresult = Ordinaryˉleaf();
    let Wrongˉdepth: Upsert.Databaseˉdepthˉthreeˉupsert =
        Upsert.Databaseˉdepthˉthreeˉupsertˉbegin(
            Current(10u64, 12u64, 49664u64, 2u32),
            Ordinaryˉroot(),
            Ordinaryˉbranch(),
            Ordinaryˉleaf(),
            Shortˉkey(8u8),
            Smallˉvalue(1u8)
        );
    if Wrongˉdepth.Error !=
            Upsert.Databaseˉdepthˉthreeˉupsertˉerror.Invalidˉcurrent {
        return 1;
    }
    let Wrongˉbranch: Upsert.Databaseˉdepthˉthreeˉupsert =
        Upsert.Databaseˉdepthˉthreeˉupsertˉbegin(
            Current(10u64, 12u64, 49664u64, 3u32),
            Ordinaryˉroot(),
            Durableˉpage(
                Page.Databaseˉdurableˉpageˉkind.Branch,
                8u64,
                Existingˉbranch.Payload
            ),
            Ordinaryˉleaf(),
            Shortˉkey(8u8),
            Smallˉvalue(1u8)
        );
    if Wrongˉbranch.Error !=
            Upsert.Databaseˉdepthˉthreeˉupsertˉerror.Branchˉmismatch {
        return 2;
    }
    let Wrongˉleaf: Upsert.Databaseˉdepthˉthreeˉupsert =
        Upsert.Databaseˉdepthˉthreeˉupsertˉbegin(
            Current(10u64, 12u64, 49664u64, 3u32),
            Ordinaryˉroot(),
            Ordinaryˉbranch(),
            Durableˉpage(
                Page.Databaseˉdurableˉpageˉkind.Leaf,
                4u64,
                Existingˉleaf.Payload
            ),
            Shortˉkey(8u8),
            Smallˉvalue(1u8)
        );
    if Wrongˉleaf.Error !=
            Upsert.Databaseˉdepthˉthreeˉupsertˉerror.Leafˉmismatch {
        return 3;
    }
    let Badˉrange: Upsert.Databaseˉdepthˉthreeˉupsert =
        Upsert.Databaseˉdepthˉthreeˉupsertˉbegin(
            Current(10u64, 12u64, 49664u64, 3u32),
            Ordinaryˉroot(),
            Ordinaryˉbranch(),
            Durableˉpage(
                Page.Databaseˉdurableˉpageˉkind.Leaf,
                5u64,
                Leafˉtwo(Shortˉkey(6u8), Shortˉkey(8u8), 1u32)
            ),
            Shortˉkey(8u8),
            Smallˉvalue(1u8)
        );
    if Badˉrange.Error !=
            Upsert.Databaseˉdepthˉthreeˉupsertˉerror.Invalidˉrange {
        return 4;
    }
    let Malformedˉroot: Upsert.Databaseˉdepthˉthreeˉupsert =
        Upsert.Databaseˉdepthˉthreeˉupsertˉbegin(
            Current(10u64, 12u64, 49664u64, 3u32),
            Page.Databaseˉdurableˉpageˉdecode(Emptyˉbytes()),
            Ordinaryˉbranch(),
            Ordinaryˉleaf(),
            Shortˉkey(8u8),
            Smallˉvalue(1u8)
        );
    if Malformedˉroot.Error !=
            Upsert.Databaseˉdepthˉthreeˉupsertˉerror.Invalidˉrootˉpage {
        return 5;
    }
    return 0;
}

export fn Main() -> i32 {
    let Ordinary: i32 = Ordinaryˉupdate();
    if Ordinary != 0 { return 10 + Ordinary; }
    let Publicationˉmodel: i32 = Publicationˉboundaries();
    if Publicationˉmodel != 0 { return 20 + Publicationˉmodel; }
    let Leaf: i32 = Leafˉsplit();
    if Leaf != 0 { return 30 + Leaf; }
    let Branch: i32 = Branchˉsplit();
    if Branch != 0 { return 50 + Branch; }
    let Root: i32 = Rootˉsplit();
    if Root != 0 { return 70 + Root; }
    let Invalid: i32 = Rejections();
    if Invalid != 0 { return 90 + Invalid; }
    return 0;
}
