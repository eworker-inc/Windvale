module Databaseˉdepthˉthreeˉupsertˉselfˉtest profile portable;

import Windvaleˉdatabaseˉcommitˉbatch as Batch;
import Windvaleˉdatabaseˉcommitˉpublication as Publication;
import Windvaleˉdatabaseˉdepthˉthreeˉupsert as Upsert;
import Windvaleˉdatabaseˉdurableˉcommitˉrecord as Record;
import Windvaleˉdatabaseˉdurableˉpage as Page;
import Windvaleˉdatabaseˉdurableˉsuperblock as Superblock;
import Windvaleˉdatabaseˉtreeˉnode as Tree;

const PAGE_SIZE: u32 = 4096u32;
const MAXIMUM_PAYLOAD: u32 = 3968u32;
const NO_PAGE: u64 = 18446744073709551615u64;

fn Emptyˉbytes() -> bytes {
    let Unit: bytes = Bytesˉfromˉu8(0u8);
    return Bytesˉslice(Unit, 0u32, 0u32);
}

fn Zeroes(Length: u32) -> bytes {
    if Length == 0u32 { return Emptyˉbytes(); }
    var Result: bytes = Bytesˉfromˉu8(0u8);
    while Bytesˉlength(Result) < Length {
        let Remaining: u32 = Length - Bytesˉlength(Result);
        if Bytesˉlength(Result) <= Remaining {
            Result = Bytesˉconcat(Result, Result);
        } else {
            Result = Bytesˉconcat(
                Result,
                Bytesˉslice(Result, 0u32, Remaining)
            );
        }
    }
    return Result;
}

fn Bytesˉequal(First: bytes, Second: bytes) -> bool {
    let Length: u32 = Bytesˉlength(First);
    if Length != Bytesˉlength(Second) { return false; }
    var Index: u32 = 0u32;
    while Index < Length {
        if Bytesˉreadˉu8(First, Index) != Bytesˉreadˉu8(Second, Index) {
            return false;
        }
        Index = Index + 1u32;
    }
    return true;
}

fn Shortˉkey(Value: u8) -> bytes {
    return Bytesˉfromˉu8(Value);
}

fn Wideˉkey(Value: u8) -> bytes {
    return Bytesˉconcat(Bytesˉfromˉu8(Value), Zeroes(1000u32));
}

fn Smallˉvalue(Value: u8) -> bytes {
    return Bytesˉfromˉu8(Value);
}

fn Current(
    Rootˉpage: u64,
    Pageˉcount: u64,
    Committedˉlength: u64,
    Rootˉdepth: u32
) -> Superblock.Databaseˉsuperblockˉselection {
    return Superblock.Databaseˉsuperblockˉselection(
        Superblock.Databaseˉsuperblockˉselectionˉstatus.Valid,
        Superblock.Databaseˉsuperblockˉslot.Second,
        Superblock.Databaseˉsuperblockˉerror.Valid,
        Superblock.Databaseˉsuperblockˉerror.Valid,
        0u64,
        1u64,
        2u64,
        3u64,
        2u64,
        Rootˉpage,
        Pageˉcount - 1u64,
        1u64,
        Pageˉcount,
        Committedˉlength,
        PAGE_SIZE,
        Rootˉdepth
    );
}

fn Branchˉtwo(
    Separator: bytes,
    Left: u64,
    Right: u64
) -> bytes {
    let Result: Tree.Databaseˉtreeˉnodeˉresult =
        Tree.Databaseˉtreeˉbranchˉtwoˉchildren(
            Separator,
            Left,
            Right,
            MAXIMUM_PAYLOAD
        );
    return Result.Bytes;
}

fn Branchˉfour(
    First: bytes,
    Second: bytes,
    Third: bytes,
    Initialˉleft: u64,
    Initialˉright: u64,
    Secondˉleft: u64,
    Secondˉright: u64,
    Thirdˉleft: u64,
    Thirdˉright: u64
) -> bytes {
    let One: Tree.Databaseˉtreeˉnodeˉresult =
        Tree.Databaseˉtreeˉbranchˉtwoˉchildren(
            First,
            Initialˉleft,
            Initialˉright,
            MAXIMUM_PAYLOAD
        );
    let Two: Tree.Databaseˉtreeˉbranchˉupdateˉresult =
        Tree.Databaseˉtreeˉbranchˉsplitˉchild(
            One.Bytes,
            Initialˉright,
            Second,
            Secondˉleft,
            Secondˉright,
            MAXIMUM_PAYLOAD
        );
    let Three: Tree.Databaseˉtreeˉbranchˉupdateˉresult =
        Tree.Databaseˉtreeˉbranchˉsplitˉchild(
            Two.Bytes,
            Secondˉright,
            Third,
            Thirdˉleft,
            Thirdˉright,
            MAXIMUM_PAYLOAD
        );
    return Three.Bytes;
}

fn Leafˉtwo(
    Firstˉkey: bytes,
    Secondˉkey: bytes,
    Valueˉlength: u32
) -> bytes {
    let Value: bytes = Zeroes(Valueˉlength);
    let First: Tree.Databaseˉtreeˉleafˉupsertˉresult =
        Tree.Databaseˉtreeˉleafˉupsert(
            Emptyˉbytes(),
            Firstˉkey,
            Value,
            MAXIMUM_PAYLOAD
        );
    let Second: Tree.Databaseˉtreeˉleafˉupsertˉresult =
        Tree.Databaseˉtreeˉleafˉupsert(
            First.Bytes,
            Secondˉkey,
            Value,
            MAXIMUM_PAYLOAD
        );
    return Second.Bytes;
}

fn Durableˉpage(
    Kind: Page.Databaseˉdurableˉpageˉkind,
    Pageˉidentifier: u64,
    Payload: bytes
) -> Page.Databaseˉdurableˉpageˉresult {
    let Node: Tree.Databaseˉtreeˉnodeˉresult =
        Tree.Databaseˉtreeˉnodeˉdecode(Payload);
    return Page.Databaseˉdurableˉpageˉencode(
        Page.Databaseˉdurableˉpage(
            Kind,
            PAGE_SIZE,
            Pageˉidentifier,
            3u64,
            2u64,
            NO_PAGE,
            Node.Entryˉcount,
            Payload
        )
    );
}

fn Ordinaryˉroot() -> Page.Databaseˉdurableˉpageˉresult {
    return Durableˉpage(
        Page.Databaseˉdurableˉpageˉkind.Root,
        10u64,
        Branchˉtwo(Shortˉkey(5u8), 8u64, 9u64)
    );
}

fn Ordinaryˉbranch() -> Page.Databaseˉdurableˉpageˉresult {
    return Durableˉpage(
        Page.Databaseˉdurableˉpageˉkind.Branch,
        9u64,
        Branchˉtwo(Shortˉkey(7u8), 4u64, 5u64)
    );
}

fn Ordinaryˉleaf() -> Page.Databaseˉdurableˉpageˉresult {
    return Durableˉpage(
        Page.Databaseˉdurableˉpageˉkind.Leaf,
        5u64,
        Leafˉtwo(Shortˉkey(8u8), Shortˉkey(9u8), 1u32)
    );
}

fn Ordinaryˉupdate() -> i32 {
    let Result: Upsert.Databaseˉdepthˉthreeˉupsert =
        Upsert.Databaseˉdepthˉthreeˉupsertˉbegin(
            Current(10u64, 12u64, 49664u64, 3u32),
            Ordinaryˉroot(),
            Ordinaryˉbranch(),
            Ordinaryˉleaf(),
            Shortˉkey(8u8),
            Smallˉvalue(99u8)
        );
    if Result.Error != Upsert.Databaseˉdepthˉthreeˉupsertˉerror.Valid ||
        !Result.Replaced || Result.Leafˉsplit || Result.Branchˉsplit ||
        Result.Rootˉsplit || Result.Rootˉdepth != 3u32 ||
        Result.Leftˉleafˉpage != 12u64 ||
        Result.Rightˉleafˉpage != NO_PAGE ||
        Result.Leftˉbranchˉpage != 13u64 ||
        Result.Rightˉbranchˉpage != NO_PAGE ||
        Result.Leftˉrootˉpage != NO_PAGE ||
        Result.Rightˉrootˉpage != NO_PAGE || Result.Rootˉpage != 14u64 ||
        Result.Obsoleteˉpageˉcount != 3u32 ||
        Result.Obsoleteˉrootˉpage != 10u64 ||
        Result.Obsoleteˉbranchˉpage != 9u64 ||
        Result.Obsoleteˉleafˉpage != 5u64 ||
        Result.Commit.Error != Batch.Databaseˉcommitˉbatchˉerror.Valid {
        return 1;
    }
    if Result.Commit.Logˉpage != 15u64 ||
        Result.Commit.Targetˉgeneration != 4u64 ||
        Result.Commit.Targetˉsequence != 3u64 ||
        Result.Commit.Targetˉlength != 66048u64 ||
        Bytesˉlength(Result.Commit.Pages) != PAGE_SIZE * 4u32 {
        return 2;
    }
    let Leaf: Page.Databaseˉdurableˉpageˉresult =
        Page.Databaseˉdurableˉpageˉdecode(
            Bytesˉslice(Result.Commit.Pages, 0u32, PAGE_SIZE)
        );
    let Branch: Page.Databaseˉdurableˉpageˉresult =
        Page.Databaseˉdurableˉpageˉdecode(
            Bytesˉslice(Result.Commit.Pages, PAGE_SIZE, PAGE_SIZE)
        );
    let Root: Page.Databaseˉdurableˉpageˉresult =
        Page.Databaseˉdurableˉpageˉdecode(
            Bytesˉslice(Result.Commit.Pages, PAGE_SIZE * 2u32, PAGE_SIZE)
        );
    let Log: Page.Databaseˉdurableˉpageˉresult =
        Page.Databaseˉdurableˉpageˉdecode(
            Bytesˉslice(Result.Commit.Pages, PAGE_SIZE * 3u32, PAGE_SIZE)
        );
    if Leaf.Previousˉpage != 5u64 || Branch.Previousˉpage != 9u64 ||
        Root.Kind != Page.Databaseˉdurableˉpageˉkind.Root ||
        Root.Previousˉpage != 10u64 ||
        Log.Kind != Page.Databaseˉdurableˉpageˉkind.Commitˉlog {
        return 3;
    }
    let Rootˉroute: Tree.Databaseˉtreeˉbranchˉrouteˉresult =
        Tree.Databaseˉtreeˉbranchˉroute(
            Root.Payload,
            Shortˉkey(8u8),
            false,
            Emptyˉbytes(),
            false,
            Emptyˉbytes()
        );
    let Branchˉroute: Tree.Databaseˉtreeˉbranchˉrouteˉresult =
        Tree.Databaseˉtreeˉbranchˉroute(
            Branch.Payload,
            Shortˉkey(8u8),
            true,
            Shortˉkey(5u8),
            false,
            Emptyˉbytes()
        );
    let Lookup: Tree.Databaseˉtreeˉleafˉlookupˉresult =
        Tree.Databaseˉtreeˉleafˉlookup(Leaf.Payload, Shortˉkey(8u8));
    if Rootˉroute.Child != 13u64 || Branchˉroute.Child != 12u64 ||
        !Lookup.Found || Bytesˉlength(Lookup.Value) != 1u32 ||
        Bytesˉreadˉu8(Lookup.Value, 0u32) != 99u8 {
        return 4;
    }
    let Commitˉrecord: Record.Databaseˉcommitˉrecordˉresult =
        Record.Databaseˉcommitˉrecordˉdecode(Log.Payload);
    if Commitˉrecord.Error != Record.Databaseˉcommitˉrecordˉerror.Valid ||
        Commitˉrecord.Firstˉallocatedˉpage != 12u64 ||
        Commitˉrecord.Allocatedˉpageˉcount != 4u64 ||
        Commitˉrecord.Rootˉpage != 14u64 ||
        Commitˉrecord.Rootˉdepth != 3u32 {
        return 5;
    }
    let Repeat: Upsert.Databaseˉdepthˉthreeˉupsert =
        Upsert.Databaseˉdepthˉthreeˉupsertˉbegin(
            Current(10u64, 12u64, 49664u64, 3u32),
            Ordinaryˉroot(),
            Ordinaryˉbranch(),
            Ordinaryˉleaf(),
            Shortˉkey(8u8),
            Smallˉvalue(99u8)
        );
    if !Bytesˉequal(Result.Commit.Pages, Repeat.Commit.Pages) ||
        !Bytesˉequal(Result.Commit.Superblock, Repeat.Commit.Superblock) {
        return 6;
    }
    return 0;
}

fn Publicationˉboundaries() -> i32 {
    let Result: Upsert.Databaseˉdepthˉthreeˉupsert =
        Upsert.Databaseˉdepthˉthreeˉupsertˉbegin(
            Current(10u64, 12u64, 49664u64, 3u32),
            Ordinaryˉroot(),
            Ordinaryˉbranch(),
            Ordinaryˉleaf(),
            Shortˉkey(8u8),
            Smallˉvalue(99u8)
        );
    var State: Publication.Databaseˉcommitˉpublication =
        Result.Commit.Publication;
    if Result.Error != Upsert.Databaseˉdepthˉthreeˉupsertˉerror.Valid ||
        State.Stage !=
            Publication.Databaseˉcommitˉpublicationˉstage.Writeˉpages ||
        State.Position != 49664u64 || State.Length != 16384u64 ||
        State.Targetˉlength != 66048u64 {
        return 1;
    }
    let Interrupted: Publication.Databaseˉcommitˉpublication =
        Publication.Databaseˉcommitˉpublicationˉadvance(
            State,
            Publication.Databaseˉcommitˉpublicationˉobservation.Indeterminate,
            0u64
        );
    if Interrupted.Stage !=
            Publication.Databaseˉcommitˉpublicationˉstage.Recover {
        return 2;
    }
    State = Publication.Databaseˉcommitˉpublicationˉadvance(
        State,
        Publication.Databaseˉcommitˉpublicationˉobservation.Completed,
        16384u64
    );
    if State.Stage != Publication.Databaseˉcommitˉpublicationˉstage.Flushˉpages ||
        State.Flushˉscope !=
            Publication.Databaseˉcommitˉpublicationˉflushˉscope.Contentˉandˉlength {
        return 3;
    }
    State = Publication.Databaseˉcommitˉpublicationˉadvance(
        State,
        Publication.Databaseˉcommitˉpublicationˉobservation.Completed,
        0u64
    );
    if State.Stage !=
            Publication.Databaseˉcommitˉpublicationˉstage.Writeˉsuperblock ||
        State.Position != 0u64 || State.Length != 256u64 {
        return 4;
    }
    State = Publication.Databaseˉcommitˉpublicationˉadvance(
        State,
        Publication.Databaseˉcommitˉpublicationˉobservation.Completed,
        256u64
    );
    if State.Stage !=
            Publication.Databaseˉcommitˉpublicationˉstage.Flushˉsuperblock ||
        State.Flushˉscope !=
            Publication.Databaseˉcommitˉpublicationˉflushˉscope.Content {
        return 5;
    }
    let Finalˉinterruption: Publication.Databaseˉcommitˉpublication =
        Publication.Databaseˉcommitˉpublicationˉadvance(
            State,
            Publication.Databaseˉcommitˉpublicationˉobservation.Rejected,
            0u64
        );
    if Finalˉinterruption.Stage !=
            Publication.Databaseˉcommitˉpublicationˉstage.Recover {
        return 6;
    }
    State = Publication.Databaseˉcommitˉpublicationˉadvance(
        State,
        Publication.Databaseˉcommitˉpublicationˉobservation.Completed,
        0u64
    );
    if State.Stage != Publication.Databaseˉcommitˉpublicationˉstage.Committed {
        return 7;
    }
    return 0;
}

fn Leafˉsplit() -> i32 {
    let Root: Page.Databaseˉdurableˉpageˉresult = Durableˉpage(
        Page.Databaseˉdurableˉpageˉkind.Root,
        10u64,
        Branchˉtwo(Wideˉkey(5u8), 8u64, 9u64)
    );
    let Branch: Page.Databaseˉdurableˉpageˉresult = Durableˉpage(
        Page.Databaseˉdurableˉpageˉkind.Branch,
        9u64,
        Branchˉtwo(Wideˉkey(7u8), 4u64, 5u64)
    );
    let Leaf: Page.Databaseˉdurableˉpageˉresult = Durableˉpage(
        Page.Databaseˉdurableˉpageˉkind.Leaf,
        5u64,
        Leafˉtwo(Wideˉkey(8u8), Wideˉkey(10u8), 500u32)
    );
    let Result: Upsert.Databaseˉdepthˉthreeˉupsert =
        Upsert.Databaseˉdepthˉthreeˉupsertˉbegin(
            Current(10u64, 12u64, 49664u64, 3u32),
            Root,
            Branch,
            Leaf,
            Wideˉkey(9u8),
            Zeroes(500u32)
        );
    if Result.Error != Upsert.Databaseˉdepthˉthreeˉupsertˉerror.Valid ||
        Result.Replaced || !Result.Leafˉsplit || Result.Branchˉsplit ||
        Result.Rootˉsplit || Result.Leftˉleafˉpage != 12u64 ||
        Result.Rightˉleafˉpage != 13u64 ||
        Result.Leftˉbranchˉpage != 14u64 || Result.Rootˉpage != 15u64 ||
        Result.Commit.Logˉpage != 16u64 ||
        Result.Commit.Targetˉlength != 70144u64 ||
        Bytesˉlength(Result.Commit.Pages) != PAGE_SIZE * 5u32 {
        return 1;
    }
    let Left: Page.Databaseˉdurableˉpageˉresult =
        Page.Databaseˉdurableˉpageˉdecode(
            Bytesˉslice(Result.Commit.Pages, 0u32, PAGE_SIZE)
        );
    let Right: Page.Databaseˉdurableˉpageˉresult =
        Page.Databaseˉdurableˉpageˉdecode(
            Bytesˉslice(Result.Commit.Pages, PAGE_SIZE, PAGE_SIZE)
        );
    let Replacementˉbranch: Page.Databaseˉdurableˉpageˉresult =
        Page.Databaseˉdurableˉpageˉdecode(
            Bytesˉslice(Result.Commit.Pages, PAGE_SIZE * 2u32, PAGE_SIZE)
        );
    let Replacementˉroot: Page.Databaseˉdurableˉpageˉresult =
        Page.Databaseˉdurableˉpageˉdecode(
            Bytesˉslice(Result.Commit.Pages, PAGE_SIZE * 3u32, PAGE_SIZE)
        );
    if Left.Previousˉpage != 5u64 || Right.Previousˉpage != NO_PAGE ||
        Replacementˉbranch.Previousˉpage != 9u64 ||
        Replacementˉroot.Previousˉpage != 10u64 {
        return 2;
    }
    let Nine: Tree.Databaseˉtreeˉleafˉlookupˉresult =
        Tree.Databaseˉtreeˉleafˉlookup(Right.Payload, Wideˉkey(9u8));
    if !Nine.Found { return 3; }
    return 0;
}

fn Branchˉsplit() -> i32 {
    let Root: Page.Databaseˉdurableˉpageˉresult = Durableˉpage(
        Page.Databaseˉdurableˉpageˉkind.Root,
        10u64,
        Branchˉtwo(Wideˉkey(5u8), 8u64, 9u64)
    );
    let Branch: Page.Databaseˉdurableˉpageˉresult = Durableˉpage(
        Page.Databaseˉdurableˉpageˉkind.Branch,
        9u64,
        Branchˉfour(
            Wideˉkey(6u8),
            Wideˉkey(7u8),
            Wideˉkey(8u8),
            1u64,
            2u64,
            3u64,
            4u64,
            6u64,
            7u64
        )
    );
    let Leaf: Page.Databaseˉdurableˉpageˉresult = Durableˉpage(
        Page.Databaseˉdurableˉpageˉkind.Leaf,
