    if Result.Error != Upsert.Databaseˉdepthˉthreeˉupsertˉerror.Valid {
        if Result.Error ==
                Upsert.Databaseˉdepthˉthreeˉupsertˉerror.Invalidˉrange {
            return 10;
        }
        if Result.Error ==
                Upsert.Databaseˉdepthˉthreeˉupsertˉerror.Invalidˉbranchˉupdate {
