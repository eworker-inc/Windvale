module Windvaleˉnativeˉtestˉdatabaseˉtransactionˉparentˉgroups profile portable;

import Windvaleˉdatabaseˉdurableˉpage as Page;
import Windvaleˉdatabaseˉdurableˉsuperblock as Superblock;
import Windvaleˉdatabaseˉtransactionˉbranchˉpartition as BranchPartition;
import Windvaleˉdatabaseˉtransactionˉleafˉpages as LeafPages;
import Windvaleˉdatabaseˉtransactionˉmutations as Transaction;
import Windvaleˉdatabaseˉtransactionˉparentˉgroups as Parents;
import Windvaleˉdatabaseˉtransactionˉpaths as Paths;
import Windvaleˉdatabaseˉtreeˉnode as Tree;

const PAGE_SIZE: u32 = 4096u32;
const MAXIMUM_PAYLOAD: u32 = 3968u32;
const NO_PAGE: u64 = 18446744073709551615u64;

fn Empty() -> bytes {
    return Bytesˉslice(Bytesˉfromˉu8(0u8), 0u32, 0u32);
}

fn Same(Left: bytes, Right: bytes) -> bool {
    let Total: u32 = Bytesˉlength(Left);
    if Total != Bytesˉlength(Right) { return false; }
    var Index: u32 = 0u32;
    while Index < Total {
        if Bytesˉreadˉu8(Left, Index) != Bytesˉreadˉu8(Right, Index) {
            return false;
        }
        Index = Index + 1u32;
    }
    return true;
}

fn Withˉu32(Input: bytes, Offset: u32, Value: u32) -> bytes {
    return Bytesˉconcat(
        Bytesˉconcat(
            Bytesˉslice(Input, 0u32, Offset),
            Bytesˉfromˉu32ˉlittle(Value)
        ),
        Bytesˉslice(Input, Offset + 4u32, Bytesˉlength(Input) - Offset - 4u32)
    );
}

fn Powerˉbytes(Exponent: u32) -> bytes {
    var Result: bytes = Bytesˉfromˉu8(0u8);
    var Index: u32 = 0u32;
    while Index < Exponent {
        Result = Bytesˉconcat(Result, Result);
        Index = Index + 1u32;
    }
    return Result;
}

fn Currentˉtwo() -> Superblock.Databaseˉsuperblockˉselection {
    return Superblock.Databaseˉsuperblockˉselection(
        Superblock.Databaseˉsuperblockˉselectionˉstatus.Valid,
        Superblock.Databaseˉsuperblockˉslot.Second,
        Superblock.Databaseˉsuperblockˉerror.Valid,
        Superblock.Databaseˉsuperblockˉerror.Valid,
        0u64, 1u64, 2u64, 3u64, 2u64, 10u64, 11u64, 1u64, 12u64,
        49664u64, PAGE_SIZE, 2u32
    );
}

fn Currentˉthree() -> Superblock.Databaseˉsuperblockˉselection {
    return Superblock.Databaseˉsuperblockˉselection(
        Superblock.Databaseˉsuperblockˉselectionˉstatus.Valid,
        Superblock.Databaseˉsuperblockˉslot.Second,
        Superblock.Databaseˉsuperblockˉerror.Valid,
        Superblock.Databaseˉsuperblockˉerror.Valid,
        0u64, 1u64, 3u64, 3u64, 2u64, 12u64, 11u64, 1u64, 13u64,
        53760u64, PAGE_SIZE, 3u32
    );
}

fn Currentˉone() -> Superblock.Databaseˉsuperblockˉselection {
    return Superblock.Databaseˉsuperblockˉselection(
        Superblock.Databaseˉsuperblockˉselectionˉstatus.Valid,
        Superblock.Databaseˉsuperblockˉslot.Second,
        Superblock.Databaseˉsuperblockˉerror.Valid,
        Superblock.Databaseˉsuperblockˉerror.Valid,
        0u64, 1u64, 2u64, 3u64, 2u64, 8u64, 11u64, 1u64, 9u64,
        37376u64, PAGE_SIZE, 1u32
    );
}

fn Leaf(First: u8, Second: u8) -> bytes {
    let One: Tree.Databaseˉtreeˉleafˉupsertˉresult =
        Tree.Databaseˉtreeˉleafˉupsert(
            Empty(), Bytesˉfromˉu8(First), Bytesˉfromˉu8(First), MAXIMUM_PAYLOAD
        );
    let Two: Tree.Databaseˉtreeˉleafˉupsertˉresult =
        Tree.Databaseˉtreeˉleafˉupsert(
            One.Bytes, Bytesˉfromˉu8(Second), Bytesˉfromˉu8(Second), MAXIMUM_PAYLOAD
        );
    return Two.Bytes;
}

fn Branch(Separator: u8, Left: u64, Right: u64) -> bytes {
    let Result: Tree.Databaseˉtreeˉnodeˉresult =
        Tree.Databaseˉtreeˉbranchˉtwoˉchildren(
            Bytesˉfromˉu8(Separator), Left, Right, MAXIMUM_PAYLOAD
        );
    return Result.Bytes;
}

fn Durable(
    Kind: Page.Databaseˉdurableˉpageˉkind,
    Identifier: u64,
    Generation: u64,
    Sequence: u64,
    Payload: bytes
) -> bytes {
    let Node: Tree.Databaseˉtreeˉnodeˉresult =
        Tree.Databaseˉtreeˉnodeˉdecode(Payload);
    let Result: Page.Databaseˉdurableˉpageˉresult =
        Page.Databaseˉdurableˉpageˉencode(
            Page.Databaseˉdurableˉpage(
                Kind, PAGE_SIZE, Identifier, Generation, Sequence, NO_PAGE,
                Node.Entryˉcount, Payload
            )
        );
    return Result.Bytes;
}

fn Rootˉtwo() -> bytes {
    return Durable(Page.Databaseˉdurableˉpageˉkind.Root, 10u64, 3u64, 2u64, Branch(5u8, 9u64, 8u64));
}

fn Leftˉtwo() -> bytes {
    return Durable(Page.Databaseˉdurableˉpageˉkind.Leaf, 9u64, 3u64, 2u64, Leaf(1u8, 2u8));
}

fn Rightˉtwo() -> bytes {
    return Durable(Page.Databaseˉdurableˉpageˉkind.Leaf, 8u64, 3u64, 2u64, Leaf(6u8, 7u8));
}

fn Leftˉpathˉtwo() -> bytes { return Bytesˉconcat(Rootˉtwo(), Leftˉtwo()); }
fn Rightˉpathˉtwo() -> bytes { return Bytesˉconcat(Rootˉtwo(), Rightˉtwo()); }

fn Rootˉthree() -> bytes {
    return Durable(Page.Databaseˉdurableˉpageˉkind.Root, 12u64, 3u64, 2u64, Branch(5u8, 10u64, 11u64));
}

fn Leftˉparent() -> bytes {
    return Durable(Page.Databaseˉdurableˉpageˉkind.Branch, 10u64, 3u64, 2u64, Branch(3u8, 8u64, 9u64));
}

fn Rightˉparent() -> bytes {
    return Durable(Page.Databaseˉdurableˉpageˉkind.Branch, 11u64, 3u64, 2u64, Branch(8u8, 6u64, 7u64));
}

fn Leafˉpage(Identifier: u64, First: u8, Second: u8) -> bytes {
    return Durable(Page.Databaseˉdurableˉpageˉkind.Leaf, Identifier, 3u64, 2u64, Leaf(First, Second));
}

fn Pathˉleftˉleft() -> bytes {
    return Bytesˉconcat(Bytesˉconcat(Rootˉthree(), Leftˉparent()), Leafˉpage(8u64, 1u8, 2u8));
}

fn Pathˉrightˉright() -> bytes {
    return Bytesˉconcat(Bytesˉconcat(Rootˉthree(), Rightˉparent()), Leafˉpage(7u64, 8u8, 9u8));
}

fn Put(Key: u8, Value: u8) -> bytes {
    let Result: Transaction.Databaseˉtransactionˉmutationˉcomponent =
        Transaction.Databaseˉtransactionˉmutationˉput(
            Bytesˉfromˉu8(Key), Bytesˉfromˉu8(Value)
        );
    return Result.Bytes;
}

fn Delete(Key: u8) -> bytes {
    let Result: Transaction.Databaseˉtransactionˉmutationˉcomponent =
        Transaction.Databaseˉtransactionˉmutationˉdelete(Bytesˉfromˉu8(Key));
    return Result.Bytes;
}

fn Mutations(Count: u32, Body: bytes) -> bytes {
    let Result: Transaction.Databaseˉtransactionˉmutationsˉresult =
        Transaction.Databaseˉtransactionˉmutationsˉencode(Count, Body);
    return Result.Bytes;
}

fn Parentˉrecord(Value: Parents.Databaseˉtransactionˉparentˉgroup) -> bytes {
    var Result: bytes = Bytesˉfromˉu64ˉlittle(Value.Parentˉpage);
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Value.Replacementˉgroupˉcount));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Value.Replacementˉchildˉcount));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Value.Outputˉbranchˉcount));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Value.Entryˉcount));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Bytesˉlength(Value.Payload)));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(0u32));
    return Bytesˉconcat(Result, Value.Payload);
}

fn Parentˉgroups(
    Parentˉcount: u32,
    Outputˉcount: u32,
    Leafˉpageˉcount: u32,
    Rootˉdepth: u32,
    Body: bytes
) -> bytes {
    var Result: bytes = Bytesˉfromˉu32ˉlittle(1347442263u32);
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(1u32));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(40u32));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(1u32));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Parentˉcount));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Outputˉcount));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Leafˉpageˉcount));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Rootˉdepth));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(40u32 + Bytesˉlength(Body)));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(0u32));
    return Bytesˉconcat(Result, Body);
}

fn Sharedˉparentˉcontract() -> i32 {
    let Mutationˉbytes: bytes = Mutations(
        2u32, Bytesˉconcat(Put(1u8, 10u8), Put(6u8, 60u8))
    );
    let Pathˉbytes: bytes = Bytesˉconcat(Leftˉpathˉtwo(), Rightˉpathˉtwo());
    let First: Parents.Databaseˉtransactionˉparentˉgroupsˉresult =
        Parents.Databaseˉtransactionˉparentˉgroupsˉplan(
            Currentˉtwo(), Mutationˉbytes, Pathˉbytes
        );
    let Second: Parents.Databaseˉtransactionˉparentˉgroupsˉresult =
        Parents.Databaseˉtransactionˉparentˉgroupsˉplan(
            Currentˉtwo(), Mutationˉbytes, Pathˉbytes
        );
    let Parent: Parents.Databaseˉtransactionˉparentˉgroup =
        Parents.Databaseˉtransactionˉparentˉgroupˉread(First.Bytes, 0u32);
    let Branch: BranchPartition.Databaseˉtransactionˉbranchˉpartitionˉbranch =
        BranchPartition.Databaseˉtransactionˉbranchˉpartitionˉread(Parent.Payload, 0u32);
    let Low: Tree.Databaseˉtreeˉbranchˉrouteˉresult =
        Tree.Databaseˉtreeˉbranchˉroute(
            Branch.Payload, Bytesˉfromˉu8(1u8), false, Empty(), false, Empty()
        );
    let High: Tree.Databaseˉtreeˉbranchˉrouteˉresult =
        Tree.Databaseˉtreeˉbranchˉroute(
            Branch.Payload, Bytesˉfromˉu8(6u8), false, Empty(), false, Empty()
        );
    let Leafˉplan: LeafPages.Databaseˉtransactionˉleafˉpagesˉresult =
        LeafPages.Databaseˉtransactionˉleafˉpagesˉdecode(First.Leafˉpages);
    if First.Error != Parents.Databaseˉtransactionˉparentˉgroupsˉerror.Valid ||
        !First.Changed || First.Parentˉgroupˉcount != 1u32 ||
        First.Outputˉbranchˉcount != 1u32 || First.Leafˉdataˉpageˉcount != 2u32 ||
        First.Rootˉdepth != 2u32 || !Same(First.Bytes, Second.Bytes) ||
        !Same(First.Leafˉpages, Second.Leafˉpages) ||
        Leafˉplan.Error != LeafPages.Databaseˉtransactionˉleafˉpagesˉerror.Valid ||
        Parent.Parentˉpage != 10u64 || Parent.Replacementˉgroupˉcount != 2u32 ||
        Parent.Replacementˉchildˉcount != 2u32 || Parent.Outputˉbranchˉcount != 1u32 ||
        Low.Child != 12u64 || High.Child != 13u64 {
        return 1;
    }
    return 0;
}

fn Twoˉparentˉcontract() -> i32 {
    let Mutationˉbytes: bytes = Mutations(
        2u32, Bytesˉconcat(Put(1u8, 10u8), Put(8u8, 80u8))
    );
    let Pathˉbytes: bytes = Bytesˉconcat(Pathˉleftˉleft(), Pathˉrightˉright());
    let Pathˉcheck: Paths.Databaseˉtransactionˉpathsˉresult =
        Paths.Databaseˉtransactionˉpathsˉvalidate(
            Currentˉthree(), Mutationˉbytes, Pathˉbytes
        );
    let Result: Parents.Databaseˉtransactionˉparentˉgroupsˉresult =
        Parents.Databaseˉtransactionˉparentˉgroupsˉplan(
            Currentˉthree(), Mutationˉbytes, Pathˉbytes
        );
    let Left: Parents.Databaseˉtransactionˉparentˉgroup =
        Parents.Databaseˉtransactionˉparentˉgroupˉread(Result.Bytes, 0u32);
    let Right: Parents.Databaseˉtransactionˉparentˉgroup =
        Parents.Databaseˉtransactionˉparentˉgroupˉread(Result.Bytes, 1u32);
    let Leftˉbranch: BranchPartition.Databaseˉtransactionˉbranchˉpartitionˉbranch =
        BranchPartition.Databaseˉtransactionˉbranchˉpartitionˉread(Left.Payload, 0u32);
    let Rightˉbranch: BranchPartition.Databaseˉtransactionˉbranchˉpartitionˉbranch =
        BranchPartition.Databaseˉtransactionˉbranchˉpartitionˉread(Right.Payload, 0u32);
    let Leftˉroute: Tree.Databaseˉtreeˉbranchˉrouteˉresult =
        Tree.Databaseˉtreeˉbranchˉroute(
            Leftˉbranch.Payload, Bytesˉfromˉu8(1u8), false, Empty(), true, Bytesˉfromˉu8(5u8)
        );
    let Rightˉroute: Tree.Databaseˉtreeˉbranchˉrouteˉresult =
        Tree.Databaseˉtreeˉbranchˉroute(
            Rightˉbranch.Payload, Bytesˉfromˉu8(8u8), true, Bytesˉfromˉu8(5u8), false, Empty()
        );
    if Pathˉcheck.Error == Paths.Databaseˉtransactionˉpathsˉerror.Invalidˉcurrent { return 11; }
    if Pathˉcheck.Error == Paths.Databaseˉtransactionˉpathsˉerror.Invalidˉpage { return 12; }
    if Pathˉcheck.Error == Paths.Databaseˉtransactionˉpathsˉerror.Pathˉmismatch { return 13; }
    if Pathˉcheck.Error == Paths.Databaseˉtransactionˉpathsˉerror.Inconsistentˉsharedˉpage { return 14; }
    if Pathˉcheck.Error == Paths.Databaseˉtransactionˉpathsˉerror.Invalidˉnode { return 15; }
    if Pathˉcheck.Error == Paths.Databaseˉtransactionˉpathsˉerror.Invalidˉroute { return 16; }
    if Pathˉcheck.Error == Paths.Databaseˉtransactionˉpathsˉerror.Invalidˉrange { return 17; }
    if Pathˉcheck.Error != Paths.Databaseˉtransactionˉpathsˉerror.Valid { return 18; }
    if Result.Error == Parents.Databaseˉtransactionˉparentˉgroupsˉerror.Leafˉpagesˉfailed { return 1; }
    if Result.Error == Parents.Databaseˉtransactionˉparentˉgroupsˉerror.Parentˉnotˉfound { return 2; }
    if Result.Error == Parents.Databaseˉtransactionˉparentˉgroupsˉerror.Partitionˉfailed { return 3; }
    if Result.Error != Parents.Databaseˉtransactionˉparentˉgroupsˉerror.Valid { return 4; }
    if Result.Parentˉgroupˉcount != 2u32 || Result.Outputˉbranchˉcount != 2u32 ||
        Result.Leafˉdataˉpageˉcount != 2u32 || Result.Rootˉdepth != 3u32 {
        return 5;
    }
    if
        Left.Parentˉpage != 10u64 || Left.Replacementˉgroupˉcount != 1u32 ||
        Right.Parentˉpage != 11u64 || Right.Replacementˉgroupˉcount != 1u32 {
        return 6;
    }
    if
        Leftˉroute.Child != 13u64 || Rightˉroute.Child != 14u64 {
        return 7;
    }
    return 0;
}

fn Rejectionˉcontract() -> i32 {
    let Missingˉmutation: bytes = Mutations(1u32, Delete(0u8));
    let Unchanged: Parents.Databaseˉtransactionˉparentˉgroupsˉresult =
        Parents.Databaseˉtransactionˉparentˉgroupsˉplan(
            Currentˉtwo(), Missingˉmutation, Leftˉpathˉtwo()
        );
    let Invalidˉdepth: Parents.Databaseˉtransactionˉparentˉgroupsˉresult =
        Parents.Databaseˉtransactionˉparentˉgroupsˉplan(
            Currentˉone(), Missingˉmutation, Leftˉtwo()
        );
    let Short: bytes = Bytesˉslice(
        Leftˉpathˉtwo(), 0u32, Bytesˉlength(Leftˉpathˉtwo()) - 1u32
    );
    let Invalidˉpath: Parents.Databaseˉtransactionˉparentˉgroupsˉresult =
        Parents.Databaseˉtransactionˉparentˉgroupsˉplan(
            Currentˉtwo(), Mutations(1u32, Put(1u8, 10u8)), Short
        );
    let Valid: Parents.Databaseˉtransactionˉparentˉgroupsˉresult =
        Parents.Databaseˉtransactionˉparentˉgroupsˉplan(
            Currentˉtwo(), Mutations(1u32, Put(1u8, 10u8)), Leftˉpathˉtwo()
        );
    let Trailing: Parents.Databaseˉtransactionˉparentˉgroupsˉresult =
        Parents.Databaseˉtransactionˉparentˉgroupsˉdecode(
            Bytesˉconcat(Valid.Bytes, Bytesˉfromˉu8(0u8))
        );
    let Truncated: Parents.Databaseˉtransactionˉparentˉgroupsˉresult =
        Parents.Databaseˉtransactionˉparentˉgroupsˉdecode(
            Bytesˉslice(Valid.Bytes, 0u32, Bytesˉlength(Valid.Bytes) - 1u32)
        );
    let Oversized: Parents.Databaseˉtransactionˉparentˉgroupsˉresult =
        Parents.Databaseˉtransactionˉparentˉgroupsˉdecode(
            Bytesˉconcat(
                Bytesˉconcat(Powerˉbytes(21u32), Powerˉbytes(20u32)),
                Bytesˉfromˉu8(0u8)
            )
        );
    let Badˉmagic: Parents.Databaseˉtransactionˉparentˉgroupsˉresult =
        Parents.Databaseˉtransactionˉparentˉgroupsˉdecode(
            Withˉu32(Valid.Bytes, 0u32, 0u32)
        );
    let Badˉversion: Parents.Databaseˉtransactionˉparentˉgroupsˉresult =
        Parents.Databaseˉtransactionˉparentˉgroupsˉdecode(
            Withˉu32(Valid.Bytes, 4u32, 2u32)
        );
    let Inconsistent: Parents.Databaseˉtransactionˉparentˉgroupsˉresult =
        Parents.Databaseˉtransactionˉparentˉgroupsˉdecode(
            Withˉu32(Valid.Bytes, 20u32, 2u32)
        );
    let Invalidˉindex: Parents.Databaseˉtransactionˉparentˉgroup =
        Parents.Databaseˉtransactionˉparentˉgroupˉread(Valid.Bytes, 1u32);
    let Separate: Parents.Databaseˉtransactionˉparentˉgroupsˉresult =
        Parents.Databaseˉtransactionˉparentˉgroupsˉplan(
            Currentˉthree(),
            Mutations(2u32, Bytesˉconcat(Put(1u8, 10u8), Put(8u8, 80u8))),
            Bytesˉconcat(Pathˉleftˉleft(), Pathˉrightˉright())
        );
    let Firstˉparent: Parents.Databaseˉtransactionˉparentˉgroup =
        Parents.Databaseˉtransactionˉparentˉgroupˉread(Separate.Bytes, 0u32);
    let Secondˉparent: Parents.Databaseˉtransactionˉparentˉgroup =
        Parents.Databaseˉtransactionˉparentˉgroupˉread(Separate.Bytes, 1u32);
    let Duplicateˉbody: bytes = Bytesˉconcat(
        Bytesˉconcat(Parentˉrecord(Firstˉparent), Parentˉrecord(Secondˉparent)),
        Parentˉrecord(Firstˉparent)
    );
    let Duplicate: Parents.Databaseˉtransactionˉparentˉgroupsˉresult =
        Parents.Databaseˉtransactionˉparentˉgroupsˉdecode(
            Parentˉgroups(
                3u32,
                Firstˉparent.Outputˉbranchˉcount + Secondˉparent.Outputˉbranchˉcount +
                    Firstˉparent.Outputˉbranchˉcount,
                2u32, 3u32, Duplicateˉbody
            )
        );
    if Unchanged.Error != Parents.Databaseˉtransactionˉparentˉgroupsˉerror.Valid ||
        Unchanged.Changed || Unchanged.Parentˉgroupˉcount != 0u32 ||
        Bytesˉlength(Unchanged.Bytes) != 40u32 { return 1; }
    if Invalidˉdepth.Error !=
        Parents.Databaseˉtransactionˉparentˉgroupsˉerror.Invalidˉdepth { return 2; }
    if Invalidˉpath.Error !=
        Parents.Databaseˉtransactionˉparentˉgroupsˉerror.Leafˉpagesˉfailed { return 3; }
    if Invalidˉpath.Leafˉpagesˉerror !=
        LeafPages.Databaseˉtransactionˉleafˉpagesˉerror.Groupsˉfailed { return 4; }
    if Trailing.Error !=
        Parents.Databaseˉtransactionˉparentˉgroupsˉerror.Invalidˉtotalˉlength { return 5; }
    if Truncated.Error !=
        Parents.Databaseˉtransactionˉparentˉgroupsˉerror.Invalidˉtotalˉlength { return 6; }
    if Oversized.Error !=
        Parents.Databaseˉtransactionˉparentˉgroupsˉerror.Invalidˉlength { return 7; }
    if Badˉmagic.Error !=
        Parents.Databaseˉtransactionˉparentˉgroupsˉerror.Invalidˉmagic { return 8; }
    if Badˉversion.Error !=
        Parents.Databaseˉtransactionˉparentˉgroupsˉerror.Unsupportedˉversion { return 9; }
    if Inconsistent.Error !=
        Parents.Databaseˉtransactionˉparentˉgroupsˉerror.Invalidˉgroup { return 10; }
    if Invalidˉindex.Error !=
        Parents.Databaseˉtransactionˉparentˉgroupsˉerror.Invalidˉindex { return 11; }
    if Duplicate.Error !=
        Parents.Databaseˉtransactionˉparentˉgroupsˉerror.Invalidˉgroup { return 12; }
    return 0;
}

export fn Main() -> i32 {
    let Shared: i32 = Sharedˉparentˉcontract();
    if Shared != 0 { return 100 + Shared; }
    let Separate: i32 = Twoˉparentˉcontract();
    if Separate != 0 { return 200 + Separate; }
    let Rejection: i32 = Rejectionˉcontract();
    if Rejection != 0 { return 300 + Rejection; }
    return 0;
}
