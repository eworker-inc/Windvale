module Windvaleˉnativeˉtestˉdatabaseˉtransactionˉcommit profile portable;

import Windvaleˉdatabaseˉcommitˉbatch as Batch;
import Windvaleˉdatabaseˉcommitˉpublication as Publication;
import Windvaleˉdatabaseˉdurableˉcommitˉrecord as CommitRecord;
import Windvaleˉdatabaseˉdurableˉpage as Page;
import Windvaleˉdatabaseˉdurableˉsuperblock as Superblock;
import Windvaleˉdatabaseˉtransactionˉcommit as Commit;
import Windvaleˉdatabaseˉtransactionˉmutations as Transaction;
import Windvaleˉdatabaseˉtreeˉnode as Tree;

const PAGE_SIZE: u32 = 4096u32;
const MAXIMUM_PAYLOAD: u32 = 3968u32;
const NO_PAGE: u64 = 18446744073709551615u64;

fn Empty() -> bytes {
    return Bytesˉslice(Bytesˉfromˉu8(0u8), 0u32, 0u32);
}

fn Current() -> Superblock.Databaseˉsuperblockˉselection {
    return Superblock.Databaseˉsuperblockˉselection(
        Superblock.Databaseˉsuperblockˉselectionˉstatus.Valid,
        Superblock.Databaseˉsuperblockˉslot.Second,
        Superblock.Databaseˉsuperblockˉerror.Valid,
        Superblock.Databaseˉsuperblockˉerror.Valid,
        0u64, 1u64, 4u64, 3u64, 2u64, 20u64, 19u64, 1u64, 21u64,
        86528u64, PAGE_SIZE, 4u32
    );
}

fn Leaf(First: u8, Second: u8) -> bytes {
    let One: Tree.Databaseˉtreeˉleafˉupsertˉresult =
        Tree.Databaseˉtreeˉleafˉupsert(
            Empty(), Bytesˉfromˉu8(First), Bytesˉfromˉu8(First),
            MAXIMUM_PAYLOAD
        );
    let Two: Tree.Databaseˉtreeˉleafˉupsertˉresult =
        Tree.Databaseˉtreeˉleafˉupsert(
            One.Bytes, Bytesˉfromˉu8(Second), Bytesˉfromˉu8(Second),
            MAXIMUM_PAYLOAD
        );
    return Two.Bytes;
}

fn Branch(Separator: u8, Left: u64, Right: u64) -> bytes {
    let Result: Tree.Databaseˉtreeˉnodeˉresult =
        Tree.Databaseˉtreeˉbranchˉtwoˉchildren(
            Bytesˉfromˉu8(Separator), Left, Right, MAXIMUM_PAYLOAD
        );
    return Result.Bytes;
}

fn Durable(
    Kind: Page.Databaseˉdurableˉpageˉkind,
    Identifier: u64,
    Payload: bytes
) -> bytes {
    let Node: Tree.Databaseˉtreeˉnodeˉresult =
        Tree.Databaseˉtreeˉnodeˉdecode(Payload);
    let Result: Page.Databaseˉdurableˉpageˉresult =
        Page.Databaseˉdurableˉpageˉencode(
            Page.Databaseˉdurableˉpage(
                Kind, PAGE_SIZE, Identifier, 3u64, 2u64, NO_PAGE,
                Node.Entryˉcount, Payload
            )
        );
    return Result.Bytes;
}

fn Root() -> bytes {
    return Durable(
        Page.Databaseˉdurableˉpageˉkind.Root, 20u64,
        Branch(5u8, 18u64, 19u64)
    );
}

fn Parent(
    Identifier: u64,
    Separator: u8,
    Left: u64,
    Right: u64
) -> bytes {
    return Durable(
        Page.Databaseˉdurableˉpageˉkind.Branch, Identifier,
        Branch(Separator, Left, Right)
    );
}

fn Leafˉpage(Identifier: u64, First: u8, Second: u8) -> bytes {
    return Durable(
        Page.Databaseˉdurableˉpageˉkind.Leaf, Identifier,
        Leaf(First, Second)
    );
}

fn Paths() -> bytes {
    let Left: bytes = Bytesˉconcat(
        Bytesˉconcat(
            Bytesˉconcat(Root(), Parent(18u64, 3u8, 10u64, 11u64)),
            Parent(10u64, 2u8, 8u64, 9u64)
        ),
        Leafˉpage(8u64, 0u8, 1u8)
    );
    let Right: bytes = Bytesˉconcat(
        Bytesˉconcat(
            Bytesˉconcat(Root(), Parent(19u64, 8u8, 12u64, 13u64)),
            Parent(13u64, 9u8, 6u64, 7u64)
        ),
        Leafˉpage(7u64, 9u8, 10u8)
    );
    return Bytesˉconcat(Left, Right);
}

fn Put(Key: u8, Value: u8) -> bytes {
    let Result: Transaction.Databaseˉtransactionˉmutationˉcomponent =
        Transaction.Databaseˉtransactionˉmutationˉput(
            Bytesˉfromˉu8(Key), Bytesˉfromˉu8(Value)
        );
    return Result.Bytes;
}

fn Mutations(Left: u8, Right: u8) -> bytes {
    let Result: Transaction.Databaseˉtransactionˉmutationsˉresult =
        Transaction.Databaseˉtransactionˉmutationsˉencode(
            2u32, Bytesˉconcat(Put(1u8, Left), Put(9u8, Right))
        );
    return Result.Bytes;
}

export fn Main() -> i32 {
    let Mutationsˉbytes: bytes = Mutations(11u8, 99u8);
    let Pathsˉbytes: bytes = Paths();
    let First: Commit.Databaseˉtransactionˉcommitˉresult =
        Commit.Databaseˉtransactionˉcommitˉplan(
            Current(), Mutationsˉbytes, Pathsˉbytes
        );
    let Second: Commit.Databaseˉtransactionˉcommitˉresult =
        Commit.Databaseˉtransactionˉcommitˉplan(
            Current(), Mutationsˉbytes, Pathsˉbytes
        );
    let Validated: Commit.Databaseˉtransactionˉcommitˉresult =
        Commit.Databaseˉtransactionˉcommitˉvalidate(
            Current(), Mutationsˉbytes, Pathsˉbytes, First
        );
    if First.Error != Commit.Databaseˉtransactionˉcommitˉerror.Valid ||
        Second.Error != Commit.Databaseˉtransactionˉcommitˉerror.Valid ||
        Validated.Error != Commit.Databaseˉtransactionˉcommitˉerror.Valid ||
        !First.Changed || !First.Publicationˉready ||
        First.Completion.Pageˉcount != 7u32 ||
        First.Completion.Rootˉpage != 27u64 ||
        First.Completion.Outputˉrootˉdepth != 4u32 ||
        First.Commit.Error != Batch.Databaseˉcommitˉbatchˉerror.Valid ||
        First.Commit.Rootˉpage != 27u64 || First.Commit.Logˉpage != 28u64 ||
        First.Commit.Targetˉgeneration != 4u64 ||
        First.Commit.Targetˉsequence != 3u64 ||
        First.Commit.Targetˉlength != 119296u64 ||
        Bytesˉlength(First.Commit.Pages) != 8u32 * PAGE_SIZE ||
        First.Commit.Publication.Stage !=
            Publication.Databaseˉcommitˉpublicationˉstage.Writeˉpages ||
        First.Commit.Publication.Targetˉslot !=
            Superblock.Databaseˉsuperblockˉslot.First ||
        First.Commit.Publication.Position != 86528u64 ||
        First.Commit.Publication.Length != 32768u64 {
        return 1;
    }

    let Target: Superblock.Databaseˉsuperblockˉresult =
        Superblock.Databaseˉsuperblockˉdecode(First.Commit.Superblock);
    let Log: Page.Databaseˉdurableˉpageˉresult =
        Page.Databaseˉdurableˉpageˉdecode(
            Bytesˉslice(First.Commit.Pages, 7u32 * PAGE_SIZE, PAGE_SIZE)
        );
    let Record: CommitRecord.Databaseˉcommitˉrecordˉresult =
        CommitRecord.Databaseˉcommitˉrecordˉdecode(Log.Payload);
    if Target.Error != Superblock.Databaseˉsuperblockˉerror.Valid ||
        Target.Generation != 4u64 || Target.Committedˉsequence != 3u64 ||
        Target.Rootˉpage != 27u64 || Target.Commitˉlogˉhead != 28u64 ||
        Target.Pageˉcount != 29u64 || Target.Committedˉlength != 119296u64 ||
        Target.Rootˉdepth != 4u32 ||
        Log.Error != Page.Databaseˉdurableˉpageˉerror.Valid ||
        Log.Kind != Page.Databaseˉdurableˉpageˉkind.Commitˉlog ||
        Log.Pageˉidentifier != 28u64 || Log.Previousˉpage != 19u64 ||
        Record.Error != CommitRecord.Databaseˉcommitˉrecordˉerror.Valid ||
        Record.Rootˉpage != 27u64 || Record.Logˉpage != 28u64 ||
        Record.Firstˉallocatedˉpage != 21u64 ||
        Record.Allocatedˉpageˉcount != 8u64 ||
        Record.Pageˉcount != 29u64 || Record.Rootˉdepth != 4u32 {
        return 2;
    }

    let Unchangedˉmutations: bytes = Mutations(1u8, 9u8);
    let Unchanged: Commit.Databaseˉtransactionˉcommitˉresult =
        Commit.Databaseˉtransactionˉcommitˉplan(
            Current(), Unchangedˉmutations, Pathsˉbytes
        );
    let Mismatched: Commit.Databaseˉtransactionˉcommitˉresult =
        Commit.Databaseˉtransactionˉcommitˉvalidate(
            Current(), Mutationsˉbytes, Pathsˉbytes, Unchanged
        );
    if Unchanged.Error != Commit.Databaseˉtransactionˉcommitˉerror.Valid ||
        Unchanged.Changed || Unchanged.Publicationˉready ||
        Unchanged.Completion.Rootˉpage != 20u64 ||
        Unchanged.Commit.Error !=
            Batch.Databaseˉcommitˉbatchˉerror.Invalidˉcurrent ||
        Mismatched.Error !=
            Commit.Databaseˉtransactionˉcommitˉerror.Inconsistentˉresult {
        return 3;
    }
    return 0;
}
