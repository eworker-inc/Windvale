module Databaseˉtreeˉpathˉdeleteˉselfˉtest profile portable;

import Windvaleˉdatabaseˉdurableˉpage as Page;
import Windvaleˉdatabaseˉdurableˉsuperblock as Superblock;
import Windvaleˉdatabaseˉtreeˉnode as Tree;
import Windvaleˉdatabaseˉtreeˉpathˉdelete as Delete;

const PAGE_SIZE: u32 = 4096u32;
const MAXIMUM_PAYLOAD: u32 = 3968u32;
const NO_PAGE: u64 = 18446744073709551615u64;

fn Emptyˉbytes() -> bytes {
    let Unit: bytes = Bytesˉfromˉu8(0u8);
    return Bytesˉslice(Unit, 0u32, 0u32);
}

fn Zeroes(Length: u32) -> bytes {
    if Length == 0u32 { return Emptyˉbytes(); }
    var Result: bytes = Bytesˉfromˉu8(0u8);
    while Bytesˉlength(Result) < Length {
        let Remaining: u32 = Length - Bytesˉlength(Result);
        if Bytesˉlength(Result) <= Remaining {
            Result = Bytesˉconcat(Result, Result);
        } else {
            Result = Bytesˉconcat(
                Result,
                Bytesˉslice(Result, 0u32, Remaining)
            );
        }
    }
    return Result;
}

fn Bytesˉequal(First: bytes, Second: bytes) -> bool {
    let Length: u32 = Bytesˉlength(First);
    if Length != Bytesˉlength(Second) { return false; }
    var Index: u32 = 0u32;
    while Index < Length {
        if Bytesˉreadˉu8(First, Index) != Bytesˉreadˉu8(Second, Index) {
            return false;
        }
        Index = Index + 1u32;
    }
    return true;
}

fn Shortˉkey(Value: u8) -> bytes {
    return Bytesˉfromˉu8(Value);
}

fn Wideˉkey(Value: u8) -> bytes {
    return Bytesˉconcat(Bytesˉfromˉu8(Value), Zeroes(1000u32));
}

fn Current(
    Rootˉpage: u64,
    Pageˉcount: u64,
    Rootˉdepth: u32
) -> Superblock.Databaseˉsuperblockˉselection {
    return Superblock.Databaseˉsuperblockˉselection(
        Superblock.Databaseˉsuperblockˉselectionˉstatus.Valid,
        Superblock.Databaseˉsuperblockˉslot.Second,
        Superblock.Databaseˉsuperblockˉerror.Valid,
        Superblock.Databaseˉsuperblockˉerror.Valid,
        0u64,
        1u64,
        2u64,
        3u64,
        2u64,
        Rootˉpage,
        Pageˉcount - 1u64,
        1u64,
        Pageˉcount,
        512u64 + Pageˉcount * 4096u64,
        PAGE_SIZE,
        Rootˉdepth
    );
}

fn Branchˉtwo(
    Separator: bytes,
    Left: u64,
    Right: u64
) -> bytes {
    let Result: Tree.Databaseˉtreeˉnodeˉresult =
        Tree.Databaseˉtreeˉbranchˉtwoˉchildren(
            Separator,
            Left,
            Right,
            MAXIMUM_PAYLOAD
        );
    return Result.Bytes;
}

fn Branchˉfour(
    First: bytes,
    Second: bytes,
    Third: bytes,
    Initialˉleft: u64,
    Initialˉright: u64,
    Secondˉleft: u64,
    Secondˉright: u64,
    Thirdˉleft: u64,
    Thirdˉright: u64
) -> bytes {
    let One: Tree.Databaseˉtreeˉnodeˉresult =
        Tree.Databaseˉtreeˉbranchˉtwoˉchildren(
            First,
            Initialˉleft,
            Initialˉright,
            MAXIMUM_PAYLOAD
        );
    let Two: Tree.Databaseˉtreeˉbranchˉupdateˉresult =
        Tree.Databaseˉtreeˉbranchˉsplitˉchild(
            One.Bytes,
            Initialˉright,
            Second,
            Secondˉleft,
            Secondˉright,
            MAXIMUM_PAYLOAD
        );
    let Three: Tree.Databaseˉtreeˉbranchˉupdateˉresult =
        Tree.Databaseˉtreeˉbranchˉsplitˉchild(
            Two.Bytes,
            Secondˉright,
            Third,
            Thirdˉleft,
            Thirdˉright,
            MAXIMUM_PAYLOAD
        );
    return Three.Bytes;
}

fn Leafˉtwo(
    Firstˉkey: bytes,
    Secondˉkey: bytes,
    Valueˉlength: u32
) -> bytes {
    let Value: bytes = Zeroes(Valueˉlength);
    let First: Tree.Databaseˉtreeˉleafˉupsertˉresult =
        Tree.Databaseˉtreeˉleafˉupsert(
            Emptyˉbytes(),
            Firstˉkey,
            Value,
            MAXIMUM_PAYLOAD
        );
    let Second: Tree.Databaseˉtreeˉleafˉupsertˉresult =
        Tree.Databaseˉtreeˉleafˉupsert(
            First.Bytes,
            Secondˉkey,
            Value,
            MAXIMUM_PAYLOAD
        );
    return Second.Bytes;
}

fn Leafˉone(Key: bytes) -> bytes {
    let Result: Tree.Databaseˉtreeˉleafˉupsertˉresult =
        Tree.Databaseˉtreeˉleafˉupsert(
            Emptyˉbytes(),
            Key,
            Bytesˉfromˉu8(1u8),
            MAXIMUM_PAYLOAD
        );
    return Result.Bytes;
}

fn Durableˉpage(
    Kind: Page.Databaseˉdurableˉpageˉkind,
    Pageˉidentifier: u64,
    Payload: bytes
) -> Page.Databaseˉdurableˉpageˉresult {
    let Node: Tree.Databaseˉtreeˉnodeˉresult =
        Tree.Databaseˉtreeˉnodeˉdecode(Payload);
    return Page.Databaseˉdurableˉpageˉencode(
        Page.Databaseˉdurableˉpage(
            Kind,
            PAGE_SIZE,
            Pageˉidentifier,
            3u64,
            2u64,
            NO_PAGE,
            Node.Entryˉcount,
            Payload
        )
    );
}

fn Pathˉthree(
    Root: Page.Databaseˉdurableˉpageˉresult,
    Branch: Page.Databaseˉdurableˉpageˉresult,
    Leaf: Page.Databaseˉdurableˉpageˉresult
) -> bytes {
    return Bytesˉconcat(Bytesˉconcat(Root.Bytes, Branch.Bytes), Leaf.Bytes);
}

fn Pathˉfour(
    Root: Page.Databaseˉdurableˉpageˉresult,
    Firstˉbranch: Page.Databaseˉdurableˉpageˉresult,
    Secondˉbranch: Page.Databaseˉdurableˉpageˉresult,
    Leaf: Page.Databaseˉdurableˉpageˉresult
) -> bytes {
    var Result: bytes = Bytesˉconcat(Root.Bytes, Firstˉbranch.Bytes);
    Result = Bytesˉconcat(Result, Secondˉbranch.Bytes);
    return Bytesˉconcat(Result, Leaf.Bytes);
}

fn Deleteˉpath() -> i32 {
    let Root: Page.Databaseˉdurableˉpageˉresult = Durableˉpage(
        Page.Databaseˉdurableˉpageˉkind.Root,
        10u64,
        Branchˉtwo(Shortˉkey(5u8), 8u64, 9u64)
    );
    let Branch: Page.Databaseˉdurableˉpageˉresult = Durableˉpage(
        Page.Databaseˉdurableˉpageˉkind.Branch,
        9u64,
        Branchˉtwo(Shortˉkey(7u8), 4u64, 5u64)
    );
    let Leaf: Page.Databaseˉdurableˉpageˉresult = Durableˉpage(
        Page.Databaseˉdurableˉpageˉkind.Leaf,
        5u64,
        Leafˉtwo(Shortˉkey(8u8), Shortˉkey(9u8), 1u32)
    );
    let Path: bytes = Pathˉthree(Root, Branch, Leaf);
    let Deleted: Delete.Databaseˉtreeˉpathˉdelete =
        Delete.Databaseˉtreeˉpathˉdeleteˉbegin(
            Current(10u64, 12u64, 3u32),
            Path,
            Shortˉkey(8u8)
        );
    if Deleted.Error != Delete.Databaseˉtreeˉpathˉdeleteˉerror.Valid ||
        !Deleted.Found || !Deleted.Hasˉcommit ||
        Deleted.Inputˉdepth != 3u32 || Deleted.Rootˉdepth != 3u32 ||
        Deleted.Dataˉpageˉcount != 3u32 ||
        Deleted.Firstˉpage != 12u64 || Deleted.Rootˉpage != 14u64 ||
        Deleted.Commit.Logˉpage != 15u64 ||
        Deleted.Obsoleteˉpageˉcount != 3u32 ||
        Bytesˉreadˉu64ˉlittle(Deleted.Obsoleteˉpages, 0u32) != 5u64 ||
        Bytesˉreadˉu64ˉlittle(Deleted.Obsoleteˉpages, 8u32) != 9u64 ||
        Bytesˉreadˉu64ˉlittle(Deleted.Obsoleteˉpages, 16u32) != 10u64 {
        return 1;
    }
    let Newˉleaf: Page.Databaseˉdurableˉpageˉresult =
        Page.Databaseˉdurableˉpageˉdecode(
            Bytesˉslice(Deleted.Commit.Pages, 0u32, PAGE_SIZE)
        );
    let Newˉbranch: Page.Databaseˉdurableˉpageˉresult =
        Page.Databaseˉdurableˉpageˉdecode(
            Bytesˉslice(Deleted.Commit.Pages, PAGE_SIZE, PAGE_SIZE)
        );
    let Newˉroot: Page.Databaseˉdurableˉpageˉresult =
        Page.Databaseˉdurableˉpageˉdecode(
            Bytesˉslice(Deleted.Commit.Pages, PAGE_SIZE * 2u32, PAGE_SIZE)
        );
    let Removed: Tree.Databaseˉtreeˉleafˉlookupˉresult =
        Tree.Databaseˉtreeˉleafˉlookup(Newˉleaf.Payload, Shortˉkey(8u8));
    let Retained: Tree.Databaseˉtreeˉleafˉlookupˉresult =
        Tree.Databaseˉtreeˉleafˉlookup(Newˉleaf.Payload, Shortˉkey(9u8));
    let Branchˉroute: Tree.Databaseˉtreeˉbranchˉrouteˉresult =
        Tree.Databaseˉtreeˉbranchˉroute(
            Newˉbranch.Payload,
            Shortˉkey(8u8),
            true,
            Shortˉkey(5u8),
            false,
            Emptyˉbytes()
        );
    let Rootˉroute: Tree.Databaseˉtreeˉbranchˉrouteˉresult =
        Tree.Databaseˉtreeˉbranchˉroute(
            Newˉroot.Payload,
            Shortˉkey(8u8),
            false,
            Emptyˉbytes(),
            false,
            Emptyˉbytes()
        );
    if Newˉleaf.Previousˉpage != 5u64 || Newˉleaf.Itemˉcount != 1u32 ||
        Newˉbranch.Previousˉpage != 9u64 ||
        Newˉroot.Previousˉpage != 10u64 ||
        Newˉroot.Kind != Page.Databaseˉdurableˉpageˉkind.Root ||
        Removed.Found || !Retained.Found || Branchˉroute.Child != 12u64 ||
        Rootˉroute.Child != 13u64 {
        return 2;
    }
    let Repeat: Delete.Databaseˉtreeˉpathˉdelete =
        Delete.Databaseˉtreeˉpathˉdeleteˉbegin(
            Current(10u64, 12u64, 3u32),
            Path,
            Shortˉkey(8u8)
        );
    if !Bytesˉequal(Deleted.Commit.Pages, Repeat.Commit.Pages) ||
        !Bytesˉequal(Deleted.Commit.Superblock, Repeat.Commit.Superblock) {
        return 3;
    }
    let Missing: Delete.Databaseˉtreeˉpathˉdelete =
        Delete.Databaseˉtreeˉpathˉdeleteˉbegin(
            Current(10u64, 12u64, 3u32),
            Path,
            Shortˉkey(10u8)
        );
    if Missing.Error != Delete.Databaseˉtreeˉpathˉdeleteˉerror.Valid ||
        Missing.Found || Missing.Hasˉcommit ||
        Missing.Dataˉpageˉcount != 0u32 || Missing.Rootˉpage != 10u64 ||
        Missing.Obsoleteˉpageˉcount != 0u32 {
        return 4;
    }

    let Soleˉleaf: bytes = Leafˉone(Shortˉkey(8u8));
    let Sole: Page.Databaseˉdurableˉpageˉresult = Durableˉpage(
        Page.Databaseˉdurableˉpageˉkind.Leaf,
        5u64,
        Soleˉleaf
    );
    let Soleˉpath: bytes = Pathˉthree(Root, Branch, Sole);
    let Final: Delete.Databaseˉtreeˉpathˉdelete =
        Delete.Databaseˉtreeˉpathˉdeleteˉbegin(
            Current(10u64, 12u64, 3u32),
            Soleˉpath,
            Shortˉkey(8u8)
        );
    if Final.Error != Delete.Databaseˉtreeˉpathˉdeleteˉerror.Valid {
        return 51;
    }
    if !Final.Found { return 52; }
    if !Final.Hasˉcommit { return 53; }
    let Emptyˉleaf: Page.Databaseˉdurableˉpageˉresult =
        Page.Databaseˉdurableˉpageˉdecode(
            Bytesˉslice(Final.Commit.Pages, 0u32, PAGE_SIZE)
        );
    if Emptyˉleaf.Error != Page.Databaseˉdurableˉpageˉerror.Valid ||
        Emptyˉleaf.Itemˉcount != 0u32 ||
        Bytesˉlength(Emptyˉleaf.Payload) != 32u32 {
        return 5;
    }
    return 0;
}

export fn Main() -> i32 {
    return Deleteˉpath();
}
