#!wv/1 en@1
module Nativeˉhostedˉdurableˉlocalˉputˉselfˉtest;
profile hosted;
platform linux, windows;
authority application;
requires capability storage.random_access_v1 version 1;

import Durableˉlocalˉrootˉput as Put;
import Windvaleˉdatabaseˉlocalˉcontracts as Contracts;


export fn Main() -> i32 {
    let Written: Put.Databaseˉdurableˉlocalˉputˉresult =
        Put.Databaseˉdurableˉlocalˉrootˉputˉopen(
            7u64,
            Textˉtoˉutf8("customer-1"),
            3u64,
            Textˉtoˉutf8("stored-through-local-service"),
            4u32
        );
    if Written.Status != Put.Databaseˉdurableˉlocalˉputˉstatus.Committed ||
        Written.Service.Status !=
            Contracts.Databaseˉlocalˉserviceˉstatus.Putˉcommitted ||
        Written.Service.Session.Status !=
            Contracts.Databaseˉlocalˉsessionˉstatus.Reopenˉrequired ||
        Written.Actions != 4u32 || Written.Targetˉgeneration != 2u64 ||
        Written.Targetˉsequence != 1u64 || Written.Targetˉlength != 12800u64 {
        return 1;
    }
    return 0;
}
