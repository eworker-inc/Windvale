module Databaseˉtreeˉnodeˉselfˉtest profile portable;

import Windvaleˉdatabaseˉtreeˉnode as Tree;
import Windvaleˉdatabaseˉtreeˉleafˉscan as Scan;

const NO_PAGE: u64 = 18446744073709551615u64;

fn Emptyˉbytes() -> bytes {
    let Unit: bytes = Bytesˉfromˉu8(0u8);
    return Bytesˉslice(Unit, 0u32, 0u32);
}

fn Zeroes(Length: u32) -> bytes {
    if Length == 0u32 { return Emptyˉbytes(); }
    var Result: bytes = Bytesˉfromˉu8(0u8);
    while Bytesˉlength(Result) < Length {
        let Remaining: u32 = Length - Bytesˉlength(Result);
        if Bytesˉlength(Result) <= Remaining {
            Result = Bytesˉconcat(Result, Result);
        } else {
            Result = Bytesˉconcat(
                Result,
                Bytesˉslice(Result, 0u32, Remaining)
            );
        }
    }
    return Result;
}

fn Bytesˉequal(First: bytes, Second: bytes) -> bool {
    let Length: u32 = Bytesˉlength(First);
    if Length != Bytesˉlength(Second) { return false; }
    var Index: u32 = 0u32;
    while Index < Length {
        if Bytesˉreadˉu8(First, Index) != Bytesˉreadˉu8(Second, Index) {
            return false;
        }
        Index = Index + 1u32;
    }
    return true;
}

fn Withˉu8(Input: bytes, Offset: u32, Value: u8) -> bytes {
    let Prefix: bytes = Bytesˉslice(Input, 0u32, Offset);
    let Suffixˉoffset: u32 = Offset + 1u32;
    return Bytesˉconcat(
        Bytesˉconcat(Prefix, Bytesˉfromˉu8(Value)),
        Bytesˉslice(
            Input,
            Suffixˉoffset,
            Bytesˉlength(Input) - Suffixˉoffset
        )
    );
}

fn Withˉu32(Input: bytes, Offset: u32, Value: u32) -> bytes {
    let Prefix: bytes = Bytesˉslice(Input, 0u32, Offset);
    let Suffixˉoffset: u32 = Offset + 4u32;
    return Bytesˉconcat(
        Bytesˉconcat(Prefix, Bytesˉfromˉu32ˉlittle(Value)),
        Bytesˉslice(
            Input,
            Suffixˉoffset,
            Bytesˉlength(Input) - Suffixˉoffset
        )
    );
}

fn Withˉu64(Input: bytes, Offset: u32, Value: u64) -> bytes {
    let Prefix: bytes = Bytesˉslice(Input, 0u32, Offset);
    let Suffixˉoffset: u32 = Offset + 8u32;
    return Bytesˉconcat(
        Bytesˉconcat(Prefix, Bytesˉfromˉu64ˉlittle(Value)),
        Bytesˉslice(
            Input,
            Suffixˉoffset,
            Bytesˉlength(Input) - Suffixˉoffset
        )
    );
}

fn Key(Value: u8) -> bytes {
    return Bytesˉfromˉu8(Value);
}

fn Value(Value: i32) -> bytes {
    return Bytesˉfromˉi32ˉlittle(Value);
}

fn Validˉleafˉbytes() -> bytes {
    let First: Tree.Databaseˉtreeˉleafˉupsertˉresult =
        Tree.Databaseˉtreeˉleafˉupsert(
            Emptyˉbytes(),
            Key(2u8),
            Value(20),
            3968u32
        );
    if First.Error != Tree.Databaseˉtreeˉnodeˉerror.Valid {
        return Emptyˉbytes();
    }
    let Second: Tree.Databaseˉtreeˉleafˉupsertˉresult =
        Tree.Databaseˉtreeˉleafˉupsert(
            First.Bytes,
            Key(1u8),
            Value(10),
            3968u32
        );
    if Second.Error != Tree.Databaseˉtreeˉnodeˉerror.Valid {
        return Emptyˉbytes();
    }
    let Third: Tree.Databaseˉtreeˉleafˉupsertˉresult =
        Tree.Databaseˉtreeˉleafˉupsert(
            Second.Bytes,
            Key(3u8),
            Emptyˉbytes(),
            3968u32
        );
    return Third.Bytes;
}

fn Decodeˉerror(Input: bytes) -> Tree.Databaseˉtreeˉnodeˉerror {
    let Result: Tree.Databaseˉtreeˉnodeˉresult =
        Tree.Databaseˉtreeˉnodeˉdecode(Input);
    return Result.Error;
}

fn Upsertˉerror(
    Input: bytes,
    Keyˉbytes: bytes,
    Valueˉbytes: bytes,
    Maximumˉpayload: u32
) -> Tree.Databaseˉtreeˉnodeˉerror {
    let Result: Tree.Databaseˉtreeˉleafˉupsertˉresult =
        Tree.Databaseˉtreeˉleafˉupsert(
            Input,
            Keyˉbytes,
            Valueˉbytes,
            Maximumˉpayload
        );
    return Result.Error;
}

fn Keyˉordering() -> i32 {
    let One: bytes = Key(1u8);
    let Oneˉzero: bytes = Bytesˉconcat(One, Key(0u8));
    let Oneˉtwo: bytes = Bytesˉconcat(One, Key(2u8));
    let Oneˉmaximum: bytes = Bytesˉconcat(One, Key(255u8));
    if Tree.Databaseˉtreeˉkeyˉcompare(One, One) !=
            Tree.Databaseˉtreeˉkeyˉorder.Equal ||
        Tree.Databaseˉtreeˉkeyˉcompare(One, Oneˉzero) !=
            Tree.Databaseˉtreeˉkeyˉorder.Less ||
        Tree.Databaseˉtreeˉkeyˉcompare(Oneˉzero, One) !=
            Tree.Databaseˉtreeˉkeyˉorder.Greater ||
        Tree.Databaseˉtreeˉkeyˉcompare(Oneˉtwo, Oneˉmaximum) !=
            Tree.Databaseˉtreeˉkeyˉorder.Less {
        return 1;
    }
    return 0;
}

fn Leafˉoperations() -> i32 {
    let Bytes: bytes = Validˉleafˉbytes();
    let Node: Tree.Databaseˉtreeˉnodeˉresult =
        Tree.Databaseˉtreeˉnodeˉdecode(Bytes);
    if Node.Error != Tree.Databaseˉtreeˉnodeˉerror.Valid ||
        Node.Kind != Tree.Databaseˉtreeˉnodeˉkind.Leaf ||
        Node.Entryˉcount != 3u32 ||
        Bytesˉlength(Bytes) != 67u32 {
        return 1;
    }
    let First: Tree.Databaseˉtreeˉleafˉlookupˉresult =
        Tree.Databaseˉtreeˉleafˉlookup(Bytes, Key(1u8));
    let Second: Tree.Databaseˉtreeˉleafˉlookupˉresult =
        Tree.Databaseˉtreeˉleafˉlookup(Bytes, Key(2u8));
    let Third: Tree.Databaseˉtreeˉleafˉlookupˉresult =
        Tree.Databaseˉtreeˉleafˉlookup(Bytes, Key(3u8));
    let Missing: Tree.Databaseˉtreeˉleafˉlookupˉresult =
        Tree.Databaseˉtreeˉleafˉlookup(Bytes, Key(4u8));
    if First.Error != Tree.Databaseˉtreeˉnodeˉerror.Valid ||
        !First.Found || !Bytesˉequal(First.Value, Value(10)) ||
        Second.Error != Tree.Databaseˉtreeˉnodeˉerror.Valid ||
        !Second.Found || !Bytesˉequal(Second.Value, Value(20)) ||
        Third.Error != Tree.Databaseˉtreeˉnodeˉerror.Valid ||
        !Third.Found || Bytesˉlength(Third.Value) != 0u32 ||
        Missing.Error != Tree.Databaseˉtreeˉnodeˉerror.Valid ||
        Missing.Found {
        return 2;
    }
    let Replacement: Tree.Databaseˉtreeˉleafˉupsertˉresult =
        Tree.Databaseˉtreeˉleafˉupsert(
            Bytes,
            Key(2u8),
            Value(21),
            3968u32
        );
    if Replacement.Error != Tree.Databaseˉtreeˉnodeˉerror.Valid ||
        !Replacement.Replaced || Replacement.Entryˉcount != 3u32 {
        return 3;
    }
    let Replaced: Tree.Databaseˉtreeˉleafˉlookupˉresult =
        Tree.Databaseˉtreeˉleafˉlookup(
            Replacement.Bytes,
            Key(2u8)
        );
    if !Replaced.Found || !Bytesˉequal(Replaced.Value, Value(21)) {
        return 4;
    }
    let Deterministic: Tree.Databaseˉtreeˉleafˉupsertˉresult =
        Tree.Databaseˉtreeˉleafˉupsert(
            Bytes,
            Key(2u8),
            Value(21),
            3968u32
        );
    if !Bytesˉequal(Replacement.Bytes, Deterministic.Bytes) {
        return 5;
    }
    return 0;
}

fn Leafˉdelete() -> i32 {
    let Bytes: bytes = Validˉleafˉbytes();
    let Missing: Tree.Databaseˉtreeˉleafˉdeleteˉresult =
        Tree.Databaseˉtreeˉleafˉdelete(Bytes, Key(4u8), 3968u32);
    if Missing.Error != Tree.Databaseˉtreeˉnodeˉerror.Valid ||
        Missing.Found || Missing.Entryˉcount != 3u32 ||
        !Bytesˉequal(Missing.Bytes, Bytes) {
        return 1;
    }
    let Middle: Tree.Databaseˉtreeˉleafˉdeleteˉresult =
        Tree.Databaseˉtreeˉleafˉdelete(Bytes, Key(2u8), 3968u32);
    if Middle.Error != Tree.Databaseˉtreeˉnodeˉerror.Valid ||
        !Middle.Found || Middle.Entryˉcount != 2u32 {
        return 2;
    }
    let Removed: Tree.Databaseˉtreeˉleafˉlookupˉresult =
        Tree.Databaseˉtreeˉleafˉlookup(Middle.Bytes, Key(2u8));
    let Retainedˉfirst: Tree.Databaseˉtreeˉleafˉlookupˉresult =
        Tree.Databaseˉtreeˉleafˉlookup(Middle.Bytes, Key(1u8));
    let Retainedˉlast: Tree.Databaseˉtreeˉleafˉlookupˉresult =
        Tree.Databaseˉtreeˉleafˉlookup(Middle.Bytes, Key(3u8));
    if Removed.Found || !Retainedˉfirst.Found ||
        !Bytesˉequal(Retainedˉfirst.Value, Value(10)) ||
        !Retainedˉlast.Found || Bytesˉlength(Retainedˉlast.Value) != 0u32 {
        return 3;
    }
    let Repeated: Tree.Databaseˉtreeˉleafˉdeleteˉresult =
        Tree.Databaseˉtreeˉleafˉdelete(Bytes, Key(2u8), 3968u32);
    if !Bytesˉequal(Middle.Bytes, Repeated.Bytes) { return 4; }
    let First: Tree.Databaseˉtreeˉleafˉdeleteˉresult =
        Tree.Databaseˉtreeˉleafˉdelete(Middle.Bytes, Key(1u8), 3968u32);
    let Last: Tree.Databaseˉtreeˉleafˉdeleteˉresult =
        Tree.Databaseˉtreeˉleafˉdelete(First.Bytes, Key(3u8), 3968u32);
    let Emptyˉnode: Tree.Databaseˉtreeˉnodeˉresult =
        Tree.Databaseˉtreeˉnodeˉdecode(Last.Bytes);
    if !First.Found || First.Entryˉcount != 1u32 || !Last.Found ||
        Last.Entryˉcount != 0u32 || Bytesˉlength(Last.Bytes) != 32u32 ||
        Emptyˉnode.Error != Tree.Databaseˉtreeˉnodeˉerror.Valid ||
        Emptyˉnode.Entryˉcount != 0u32 {
        return 5;
    }
    let Emptyˉroot: Tree.Databaseˉtreeˉleafˉdeleteˉresult =
        Tree.Databaseˉtreeˉleafˉdelete(
            Emptyˉbytes(), Key(1u8), 3968u32);
    if Emptyˉroot.Error != Tree.Databaseˉtreeˉnodeˉerror.Valid ||
        Emptyˉroot.Found || Emptyˉroot.Entryˉcount != 0u32 ||
        Bytesˉlength(Emptyˉroot.Bytes) != 0u32 {
        return 6;
    }
    let Badˉkey: Tree.Databaseˉtreeˉleafˉdeleteˉresult =
        Tree.Databaseˉtreeˉleafˉdelete(Bytes, Emptyˉbytes(), 3968u32);
    let Badˉmaximum: Tree.Databaseˉtreeˉleafˉdeleteˉresult =
        Tree.Databaseˉtreeˉleafˉdelete(Bytes, Key(1u8), 31u32);
    let Tooˉsmall: Tree.Databaseˉtreeˉleafˉdeleteˉresult =
        Tree.Databaseˉtreeˉleafˉdelete(Bytes, Key(1u8), 60u32);
    let Badˉkind: Tree.Databaseˉtreeˉleafˉdeleteˉresult =
        Tree.Databaseˉtreeˉleafˉdelete(Branchˉbytes(), Key(1u8), 3968u32);
    let Malformed: Tree.Databaseˉtreeˉleafˉdeleteˉresult =
        Tree.Databaseˉtreeˉleafˉdelete(
            Withˉu32(Bytes, 0u32, 0u32), Key(1u8), 3968u32);
    if Badˉkey.Error != Tree.Databaseˉtreeˉnodeˉerror.Invalidˉkeyˉlength ||
        Badˉmaximum.Error !=
            Tree.Databaseˉtreeˉnodeˉerror.Invalidˉmaximumˉpayload ||
        Tooˉsmall.Error != Tree.Databaseˉtreeˉnodeˉerror.Full ||
        Badˉkind.Error != Tree.Databaseˉtreeˉnodeˉerror.Invalidˉkind ||
        Malformed.Error != Tree.Databaseˉtreeˉnodeˉerror.Invalidˉmagic {
        return 7;
    }
    return 0;
}

fn Leafˉscan() -> i32 {
    let Bytes: bytes = Validˉleafˉbytes();
    let All: Scan.Databaseˉtreeˉleafˉscanˉresult =
        Scan.Databaseˉtreeˉleafˉscan(
            Bytes,
            false, Emptyˉbytes(), false,
            false, Emptyˉbytes(), false,
            500u32
        );
    if All.Error != Scan.Databaseˉtreeˉleafˉscanˉerror.Valid ||
        All.Nodeˉerror != Tree.Databaseˉtreeˉnodeˉerror.Valid ||
        All.Count != 3u32 || All.Examined != 3u32 || All.Hasˉmore ||
        Bytesˉlength(All.Entries) != 35u32 ||
        !Bytesˉequal(All.Lastˉkey, Key(3u8)) ||
        Bytesˉreadˉu8(All.Entries, 8u32) != 1u8 {
        return 1;
    }
    let Bounded: Scan.Databaseˉtreeˉleafˉscanˉresult =
        Scan.Databaseˉtreeˉleafˉscan(
            Bytes,
            true, Key(1u8), false,
            true, Key(3u8), true,
            500u32
        );
    if Bounded.Error != Scan.Databaseˉtreeˉleafˉscanˉerror.Valid ||
        Bounded.Count != 2u32 || Bounded.Hasˉmore ||
        Bytesˉreadˉu8(Bounded.Entries, 8u32) != 2u8 ||
        !Bytesˉequal(Bounded.Lastˉkey, Key(3u8)) {
        return 2;
    }
    let Equal: Scan.Databaseˉtreeˉleafˉscanˉresult =
        Scan.Databaseˉtreeˉleafˉscan(
            Bytes,
            true, Key(2u8), true,
            true, Key(2u8), true,
            1u32
        );
    let Emptyˉequal: Scan.Databaseˉtreeˉleafˉscanˉresult =
        Scan.Databaseˉtreeˉleafˉscan(
            Bytes,
            true, Key(2u8), false,
            true, Key(2u8), true,
            1u32
        );
    if Equal.Count != 1u32 || !Bytesˉequal(Equal.Lastˉkey, Key(2u8)) ||
        Emptyˉequal.Count != 0u32 || Emptyˉequal.Hasˉmore {
        return 3;
    }
    let Limited: Scan.Databaseˉtreeˉleafˉscanˉresult =
        Scan.Databaseˉtreeˉleafˉscan(
            Bytes,
            false, Emptyˉbytes(), false,
            false, Emptyˉbytes(), false,
            2u32
        );
    let Resumed: Scan.Databaseˉtreeˉleafˉscanˉresult =
        Scan.Databaseˉtreeˉleafˉscan(
            Bytes,
            true, Limited.Lastˉkey, false,
            false, Emptyˉbytes(), false,
            2u32
        );
    if Limited.Count != 2u32 || Limited.Examined != 3u32 ||
        !Limited.Hasˉmore || !Bytesˉequal(Limited.Lastˉkey, Key(2u8)) ||
        Resumed.Count != 1u32 || Resumed.Hasˉmore ||
        !Bytesˉequal(Resumed.Lastˉkey, Key(3u8)) {
        return 4;
    }
    let Emptyˉroot: Scan.Databaseˉtreeˉleafˉscanˉresult =
        Scan.Databaseˉtreeˉleafˉscan(
            Emptyˉbytes(),
            false, Emptyˉbytes(), false,
            false, Emptyˉbytes(), false,
            1u32
        );
    let Emptyˉfirst: Tree.Databaseˉtreeˉleafˉdeleteˉresult =
        Tree.Databaseˉtreeˉleafˉdelete(Bytes, Key(1u8), 3968u32);
    let Emptyˉsecond: Tree.Databaseˉtreeˉleafˉdeleteˉresult =
        Tree.Databaseˉtreeˉleafˉdelete(
            Emptyˉfirst.Bytes, Key(2u8), 3968u32);
    let Emptyˉthird: Tree.Databaseˉtreeˉleafˉdeleteˉresult =
        Tree.Databaseˉtreeˉleafˉdelete(
            Emptyˉsecond.Bytes, Key(3u8), 3968u32);
    let Emptyˉleaf: Scan.Databaseˉtreeˉleafˉscanˉresult =
        Scan.Databaseˉtreeˉleafˉscan(
            Emptyˉthird.Bytes,
            false, Emptyˉbytes(), false,
            false, Emptyˉbytes(), false,
            1u32
        );
    if Emptyˉroot.Count != 0u32 || Emptyˉroot.Examined != 0u32 ||
        Emptyˉleaf.Count != 0u32 || Emptyˉleaf.Examined != 0u32 {
        return 5;
    }
    let Invalidˉlimit: Scan.Databaseˉtreeˉleafˉscanˉresult =
        Scan.Databaseˉtreeˉleafˉscan(
            Bytes, false, Emptyˉbytes(), false,
            false, Emptyˉbytes(), false, 0u32);
    let Excessiveˉlimit: Scan.Databaseˉtreeˉleafˉscanˉresult =
        Scan.Databaseˉtreeˉleafˉscan(
            Bytes, false, Emptyˉbytes(), false,
            false, Emptyˉbytes(), false, 501u32);
    let Invalidˉstart: Scan.Databaseˉtreeˉleafˉscanˉresult =
        Scan.Databaseˉtreeˉleafˉscan(
            Bytes, false, Key(1u8), false,
            false, Emptyˉbytes(), false, 1u32);
    let Emptyˉstart: Scan.Databaseˉtreeˉleafˉscanˉresult =
        Scan.Databaseˉtreeˉleafˉscan(
            Bytes, true, Emptyˉbytes(), true,
            false, Emptyˉbytes(), false, 1u32);
    let Invalidˉend: Scan.Databaseˉtreeˉleafˉscanˉresult =
        Scan.Databaseˉtreeˉleafˉscan(
            Bytes, false, Emptyˉbytes(), false,
            false, Emptyˉbytes(), true, 1u32);
    let Invalidˉrange: Scan.Databaseˉtreeˉleafˉscanˉresult =
        Scan.Databaseˉtreeˉleafˉscan(
            Bytes, true, Key(3u8), true,
            true, Key(1u8), true, 1u32);
    let Invalidˉnode: Scan.Databaseˉtreeˉleafˉscanˉresult =
        Scan.Databaseˉtreeˉleafˉscan(
            Branchˉbytes(), false, Emptyˉbytes(), false,
            false, Emptyˉbytes(), false, 1u32);
    let Malformedˉnode: Scan.Databaseˉtreeˉleafˉscanˉresult =
        Scan.Databaseˉtreeˉleafˉscan(
            Withˉu32(Bytes, 0u32, 0u32),
            false, Emptyˉbytes(), false,
            false, Emptyˉbytes(), false, 1u32);
    if Invalidˉlimit.Error !=
            Scan.Databaseˉtreeˉleafˉscanˉerror.Invalidˉlimit ||
        Excessiveˉlimit.Error !=
            Scan.Databaseˉtreeˉleafˉscanˉerror.Invalidˉlimit ||
        Invalidˉstart.Error !=
            Scan.Databaseˉtreeˉleafˉscanˉerror.Invalidˉstart ||
        Emptyˉstart.Error !=
            Scan.Databaseˉtreeˉleafˉscanˉerror.Invalidˉstart ||
        Invalidˉend.Error !=
            Scan.Databaseˉtreeˉleafˉscanˉerror.Invalidˉend ||
        Invalidˉrange.Error !=
            Scan.Databaseˉtreeˉleafˉscanˉerror.Invalidˉrange ||
        Invalidˉnode.Error !=
            Scan.Databaseˉtreeˉleafˉscanˉerror.Nodeˉrejected ||
        Invalidˉnode.Nodeˉerror != Tree.Databaseˉtreeˉnodeˉerror.Invalidˉkind {
        return 6;
    }
    if Malformedˉnode.Error !=
            Scan.Databaseˉtreeˉleafˉscanˉerror.Nodeˉrejected ||
        Malformedˉnode.Nodeˉerror !=
            Tree.Databaseˉtreeˉnodeˉerror.Invalidˉmagic {
        return 6;
    }
    return 0;
}

fn Branchˉbytes() -> bytes {
    var Result: bytes = Bytesˉfromˉu32ˉlittle(1314149975u32);
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(1u32));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(32u32));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(2u32));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(1u32));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(49u32));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu64ˉlittle(2u64));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(1u32));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(0u32));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu64ˉlittle(1u64));
    return Bytesˉconcat(Result, Key(5u8));
}

fn Branchˉvalidation() -> i32 {
    let Bytes: bytes = Branchˉbytes();
    let Node: Tree.Databaseˉtreeˉnodeˉresult =
        Tree.Databaseˉtreeˉnodeˉdecode(Bytes);
    if Node.Error != Tree.Databaseˉtreeˉnodeˉerror.Valid ||
        Node.Kind != Tree.Databaseˉtreeˉnodeˉkind.Branch ||
        Node.Entryˉcount != 1u32 || Node.Rightmostˉchild != 2u64 {
        return 1;
    }
    let Encoded: Tree.Databaseˉtreeˉnodeˉresult =
        Tree.Databaseˉtreeˉbranchˉtwoˉchildren(
            Key(5u8),
            1u64,
            2u64,
            3968u32
        );
    if Encoded.Error != Tree.Databaseˉtreeˉnodeˉerror.Valid ||
        !Bytesˉequal(Encoded.Bytes, Bytes) {
        return 2;
    }
    let Reserved: Tree.Databaseˉtreeˉnodeˉresult =
        Tree.Databaseˉtreeˉnodeˉdecode(Withˉu32(Bytes, 36u32, 1u32));
    if Reserved.Error !=
        Tree.Databaseˉtreeˉnodeˉerror.Invalidˉentryˉreserved {
        return 3;
    }
    let Child: Tree.Databaseˉtreeˉnodeˉresult =
        Tree.Databaseˉtreeˉnodeˉdecode(Withˉu64(Bytes, 40u32, NO_PAGE));
    if Child.Error != Tree.Databaseˉtreeˉnodeˉerror.Invalidˉchild {
        return 4;
    }
    let Rightmost: Tree.Databaseˉtreeˉnodeˉresult =
        Tree.Databaseˉtreeˉnodeˉdecode(Withˉu64(Bytes, 24u32, NO_PAGE));
    if Rightmost.Error !=
        Tree.Databaseˉtreeˉnodeˉerror.Invalidˉrightmostˉchild {
        return 5;
    }
    return 0;
}

fn Splitˉandˉroute() -> i32 {
    let First: Tree.Databaseˉtreeˉleafˉupsertˉresult =
        Tree.Databaseˉtreeˉleafˉupsert(
            Emptyˉbytes(),
            Key(1u8),
            Value(10),
            60u32
        );
    let Third: Tree.Databaseˉtreeˉleafˉupsertˉresult =
        Tree.Databaseˉtreeˉleafˉupsert(
            First.Bytes,
            Key(3u8),
            Value(30),
            60u32
        );
    let Full: Tree.Databaseˉtreeˉleafˉupsertˉresult =
        Tree.Databaseˉtreeˉleafˉupsert(
            Third.Bytes,
            Key(2u8),
            Value(20),
            60u32
        );
    if First.Error != Tree.Databaseˉtreeˉnodeˉerror.Valid ||
        Third.Error != Tree.Databaseˉtreeˉnodeˉerror.Valid ||
        Full.Error != Tree.Databaseˉtreeˉnodeˉerror.Full {
        return 1;
    }
    let Split: Tree.Databaseˉtreeˉnodeˉsplitˉresult =
        Tree.Databaseˉtreeˉleafˉsplitˉupsert(
            Third.Bytes,
            Key(2u8),
            Value(20),
            60u32
        );
    if Split.Error != Tree.Databaseˉtreeˉnodeˉerror.Valid ||
        Split.Replaced || Split.Leftˉentryˉcount != 1u32 ||
        Split.Rightˉentryˉcount != 2u32 ||
        !Bytesˉequal(Split.Separator, Key(2u8)) ||
        Bytesˉlength(Split.Left) > 60u32 ||
        Bytesˉlength(Split.Right) > 60u32 {
        return 2;
    }
    let Leftˉlookup: Tree.Databaseˉtreeˉleafˉlookupˉresult =
        Tree.Databaseˉtreeˉleafˉlookup(Split.Left, Key(1u8));
    let Rightˉlookup: Tree.Databaseˉtreeˉleafˉlookupˉresult =
        Tree.Databaseˉtreeˉleafˉlookup(Split.Right, Key(3u8));
    if !Leftˉlookup.Found ||
        !Bytesˉequal(Leftˉlookup.Value, Value(10)) ||
        !Rightˉlookup.Found ||
        !Bytesˉequal(Rightˉlookup.Value, Value(30)) {
        return 3;
    }
    let Branch: Tree.Databaseˉtreeˉnodeˉresult =
        Tree.Databaseˉtreeˉbranchˉtwoˉchildren(
            Split.Separator,
            10u64,
            11u64,
            60u32
        );
    let Leftˉroute: Tree.Databaseˉtreeˉbranchˉrouteˉresult =
        Tree.Databaseˉtreeˉbranchˉroute(
            Branch.Bytes,
            Key(1u8),
            false,
            Emptyˉbytes(),
            false,
            Emptyˉbytes()
        );
    let Equalˉroute: Tree.Databaseˉtreeˉbranchˉrouteˉresult =
        Tree.Databaseˉtreeˉbranchˉroute(
            Branch.Bytes,
            Key(2u8),
            false,
            Emptyˉbytes(),
            false,
            Emptyˉbytes()
        );
    if Leftˉroute.Error != Tree.Databaseˉtreeˉnodeˉerror.Valid ||
        Leftˉroute.Child != 10u64 || Leftˉroute.Hasˉlower ||
        !Leftˉroute.Hasˉupper ||
        !Bytesˉequal(Leftˉroute.Upper, Key(2u8)) ||
        Equalˉroute.Error != Tree.Databaseˉtreeˉnodeˉerror.Valid ||
        Equalˉroute.Child != 11u64 || !Equalˉroute.Hasˉlower ||
        Equalˉroute.Hasˉupper ||
        !Bytesˉequal(Equalˉroute.Lower, Key(2u8)) {
        return 4;
    }
    if Tree.Databaseˉtreeˉleafˉrangeˉvalidate(
            Split.Left,
            false,
            Emptyˉbytes(),
            true,
            Split.Separator
        ) != Tree.Databaseˉtreeˉnodeˉerror.Valid ||
        Tree.Databaseˉtreeˉleafˉrangeˉvalidate(
            Split.Right,
            true,
            Split.Separator,
            false,
            Emptyˉbytes()
        ) != Tree.Databaseˉtreeˉnodeˉerror.Valid {
        return 5;
    }
    let Invalidˉroute: Tree.Databaseˉtreeˉbranchˉrouteˉresult =
        Tree.Databaseˉtreeˉbranchˉroute(
            Branch.Bytes,
            Key(1u8),
            true,
            Key(2u8),
            false,
            Emptyˉbytes()
        );
    if Invalidˉroute.Error != Tree.Databaseˉtreeˉnodeˉerror.Invalidˉrange ||
        Tree.Databaseˉtreeˉleafˉrangeˉvalidate(
            Split.Left,
            true,
            Key(2u8),
            false,
            Emptyˉbytes()
        ) != Tree.Databaseˉtreeˉnodeˉerror.Invalidˉrange {
        return 6;
    }
    let Deterministic: Tree.Databaseˉtreeˉnodeˉsplitˉresult =
        Tree.Databaseˉtreeˉleafˉsplitˉupsert(
            Third.Bytes,
            Key(2u8),
            Value(20),
            60u32
        );
    if !Bytesˉequal(Split.Left, Deterministic.Left) ||
        !Bytesˉequal(Split.Right, Deterministic.Right) ||
        !Bytesˉequal(Split.Separator, Deterministic.Separator) {
        return 7;
    }
    let Oversized: Tree.Databaseˉtreeˉnodeˉsplitˉresult =
        Tree.Databaseˉtreeˉleafˉsplitˉupsert(
            First.Bytes,
            Key(1u8),
            Zeroes(53u32),
            60u32
        );
    if Oversized.Error != Tree.Databaseˉtreeˉnodeˉerror.Full {
        return 8;
    }
    return 0;
}

fn Malformedˉheader() -> i32 {
    let Bytes: bytes = Validˉleafˉbytes();
    if Decodeˉerror(Emptyˉbytes()) !=
            Tree.Databaseˉtreeˉnodeˉerror.Invalidˉlength ||
        Decodeˉerror(Withˉu32(Bytes, 0u32, 0u32)) !=
            Tree.Databaseˉtreeˉnodeˉerror.Invalidˉmagic ||
        Decodeˉerror(Withˉu32(Bytes, 4u32, 2u32)) !=
            Tree.Databaseˉtreeˉnodeˉerror.Unsupportedˉversion ||
        Decodeˉerror(Withˉu32(Bytes, 8u32, 31u32)) !=
            Tree.Databaseˉtreeˉnodeˉerror.Invalidˉheaderˉsize ||
        Decodeˉerror(Withˉu32(Bytes, 12u32, 3u32)) !=
            Tree.Databaseˉtreeˉnodeˉerror.Invalidˉkind ||
        Decodeˉerror(Withˉu32(Bytes, 16u32, 4097u32)) !=
            Tree.Databaseˉtreeˉnodeˉerror.Invalidˉcount ||
        Decodeˉerror(Withˉu32(Bytes, 20u32, 61u32)) !=
            Tree.Databaseˉtreeˉnodeˉerror.Invalidˉusedˉlength ||
        Decodeˉerror(Withˉu64(Bytes, 24u32, 0u64)) !=
            Tree.Databaseˉtreeˉnodeˉerror.Invalidˉrightmostˉchild {
        return 1;
    }
    return 0;
}

fn Malformedˉentries() -> i32 {
    let Bytes: bytes = Validˉleafˉbytes();
    if Decodeˉerror(Withˉu32(Bytes, 32u32, 0u32)) !=
            Tree.Databaseˉtreeˉnodeˉerror.Invalidˉkeyˉlength ||
        Decodeˉerror(Withˉu32(Bytes, 36u32, 61441u32)) !=
            Tree.Databaseˉtreeˉnodeˉerror.Invalidˉvalueˉlength ||
        Decodeˉerror(Withˉu8(Bytes, 53u32, 1u8)) !=
            Tree.Databaseˉtreeˉnodeˉerror.Invalidˉorder {
        return 1;
    }
    let Short: bytes = Bytesˉslice(
        Bytes,
        0u32,
        Bytesˉlength(Bytes) - 1u32
    );
    if Decodeˉerror(
        Withˉu32(Short, 20u32, Bytesˉlength(Short))
    ) != Tree.Databaseˉtreeˉnodeˉerror.Truncatedˉentry {
        return 2;
    }
    let Extended: bytes = Bytesˉconcat(Bytes, Key(0u8));
    if Decodeˉerror(
        Withˉu32(Extended, 20u32, Bytesˉlength(Extended))
    ) != Tree.Databaseˉtreeˉnodeˉerror.Trailingˉbytes {
        return 3;
    }
    return 0;
}

fn Limits() -> i32 {
    let Emptyˉlookup: Tree.Databaseˉtreeˉleafˉlookupˉresult =
        Tree.Databaseˉtreeˉleafˉlookup(Emptyˉbytes(), Key(1u8));
    if Emptyˉlookup.Error != Tree.Databaseˉtreeˉnodeˉerror.Invalidˉlength ||
        Upsertˉerror(
            Emptyˉbytes(), Emptyˉbytes(), Key(1u8), 3968u32
        ) != Tree.Databaseˉtreeˉnodeˉerror.Invalidˉkeyˉlength ||
        Upsertˉerror(
            Emptyˉbytes(), Zeroes(4097u32), Key(1u8), 3968u32
        ) != Tree.Databaseˉtreeˉnodeˉerror.Invalidˉkeyˉlength ||
        Upsertˉerror(
            Emptyˉbytes(), Key(1u8), Zeroes(61441u32), 65408u32
        ) != Tree.Databaseˉtreeˉnodeˉerror.Invalidˉvalueˉlength ||
        Upsertˉerror(
            Emptyˉbytes(), Key(1u8), Key(1u8), 31u32
        ) !=
            Tree.Databaseˉtreeˉnodeˉerror.Invalidˉmaximumˉpayload ||
        Upsertˉerror(
            Emptyˉbytes(), Key(1u8), Key(1u8), 65409u32
        ) !=
            Tree.Databaseˉtreeˉnodeˉerror.Invalidˉmaximumˉpayload ||
        Upsertˉerror(
            Emptyˉbytes(), Key(1u8), Key(1u8), 41u32
        ) != Tree.Databaseˉtreeˉnodeˉerror.Full {
        return 1;
    }
    return 0;
}

export fn Main() -> i32 {
    let Ordering: i32 = Keyˉordering();
    if Ordering != 0 { return 10 + Ordering; }
    let Leafˉresult: i32 = Leafˉoperations();
    if Leafˉresult != 0 { return 20 + Leafˉresult; }
    let Branch: i32 = Branchˉvalidation();
    if Branch != 0 { return 30 + Branch; }
    let Header: i32 = Malformedˉheader();
    if Header != 0 { return 40 + Header; }
    let Entries: i32 = Malformedˉentries();
    if Entries != 0 { return 50 + Entries; }
    let Limitˉresult: i32 = Limits();
    if Limitˉresult != 0 { return 60 + Limitˉresult; }
    let Splitˉresult: i32 = Splitˉandˉroute();
    if Splitˉresult != 0 { return 70 + Splitˉresult; }
    let Deleteˉresult: i32 = Leafˉdelete();
    if Deleteˉresult != 0 { return 80 + Deleteˉresult; }
    let Scanˉresult: i32 = Leafˉscan();
    if Scanˉresult != 0 { return 90 + Scanˉresult; }
    return 0;
}
