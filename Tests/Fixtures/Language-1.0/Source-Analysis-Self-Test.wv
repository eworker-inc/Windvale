#!wv/1 en@1
module Languageˉoneˉsourceˉanalysisˉselfˉtest;
profile hosted;
platform linux, windows;
authority application;
requires capability file.write_bytes version 1;
requires capability process.argument version 1;
requires capability process.argument_count version 1;


import Compilerˉsourceˉanalysis as Analysis;
import Compilerˉsourceˉanalysisˉcontract as Analysisˉcontract;
import Compilerˉsourceˉdeclarationˉparser as Sourceˉdeclarations;
import Compilerˉsourceˉgraph as Sourceˉgraph;
import Compilerˉsourceˉsymbols as Sourceˉsymbols;
import Compilerˉsourceˉwir as Sourceˉwir;

fn One(Source: text) -> bytes {
    let Body: bytes = Textˉtoˉutf8(Source);
    var Result: bytes = Textˉtoˉutf8("WVSS");
    Result = Bytesˉconcat(Result, Bytesˉfromˉu16ˉlittle(1u32));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu16ˉlittle(0u32));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(1u32));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(8u32));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(24u32));
    Result = Bytesˉconcat(
        Result, Bytesˉfromˉu32ˉlittle(Bytesˉlength(Body))
    );
    return Bytesˉconcat(Result, Body);
}

fn Bytesˉequal(Left: bytes, Right: bytes) -> bool {
    let Length: u32 = Bytesˉlength(Left);
    if Length != Bytesˉlength(Right) { return false; }
    var Index: u32 = 0u32;
    while Index < Length {
        if Bytesˉreadˉu8(Left, Index) != Bytesˉreadˉu8(Right, Index) {
            return false;
        }
        Index = Index + 1u32;
    }
    return true;
}

fn Failureˉevidence() -> i32 {
    let Prefix: text = "module Failureˉfixture profile portable; ";
    let First: text = "fn Same() -> i32 { return 0; } ";
    let Beforeˉduplicate: text = Textˉconcat(Prefix, First);
    let Duplicate: Analysis.Compilerˉsourceˉanalysis =
        Analysis.Compilerˉprepareˉsourceˉanalysis(One(Textˉconcat(
            Beforeˉduplicate, "fn Same() -> i32 { return 1; }"
        )));
    if Duplicate.Status !=
            Analysisˉcontract.Compilerˉsourceˉanalysisˉstatus.Sourceˉsymbols ||
        Duplicate.Symbolˉstatus !=
            Sourceˉsymbols.Compilerˉsourceˉsymbolˉstatus.Duplicateˉfunction ||
        Duplicate.Failureˉgraphˉstatus !=
            Sourceˉgraph.Compilerˉsourceˉgraphˉstatus.Valid ||
        Duplicate.Failureˉkind !=
            Sourceˉdeclarations.Compilerˉsourceˉdeclarationˉkind.Function ||
        Duplicate.Failureˉmodule != 0u32 ||
        Duplicate.Failureˉrelatedˉmodule != 0u32 ||
        Duplicate.Failureˉfunction != 4294967295u32 ||
        Duplicate.Failureˉoffset !=
            Bytesˉlength(Textˉtoˉutf8(Beforeˉduplicate)) + 3u32 ||
        Duplicate.Failureˉline != 1u32 || Duplicate.Failureˉcolumn == 0u32 ||
        Duplicate.Failureˉwirˉfunctions != 0u32 ||
        Duplicate.Failureˉwirˉblocks != 0u32 ||
        Duplicate.Failureˉwirˉoperations != 0u32 ||
        Duplicate.Failureˉwirˉtemporaries != 0u32 ||
        Duplicate.Failureˉwirˉoperands != 0u32 ||
        Bytesˉlength(Duplicate.Manifest) != 0u32 ||
        Bytesˉlength(Duplicate.Bindings) != 0u32 ||
        Bytesˉlength(Duplicate.Wir) != 0u32 {
        return 13;
    }
    let Beforeˉreturn: text = Textˉconcat(
        Prefix, "export fn Main() -> i32 { "
    );
    let Invalidˉreturn: Analysis.Compilerˉsourceˉanalysis =
        Analysis.Compilerˉprepareˉsourceˉanalysis(One(Textˉconcat(
            Beforeˉreturn, "return; }"
        )));
    if Invalidˉreturn.Status !=
            Analysisˉcontract.Compilerˉsourceˉanalysisˉstatus.Sourceˉwir ||
        Invalidˉreturn.Wirˉstatus !=
            Sourceˉwir.Compilerˉsourceˉwirˉstatus.Invalidˉreturn ||
        Invalidˉreturn.Failureˉmodule != 0u32 ||
        Invalidˉreturn.Failureˉrelatedˉmodule != 0u32 ||
        Invalidˉreturn.Failureˉfunction != 0u32 ||
        Invalidˉreturn.Failureˉoffset !=
            Bytesˉlength(Textˉtoˉutf8(Beforeˉreturn)) ||
        Invalidˉreturn.Failureˉline != 1u32 ||
        Invalidˉreturn.Failureˉcolumn == 0u32 ||
        Bytesˉlength(Invalidˉreturn.Manifest) != 0u32 ||
        Bytesˉlength(Invalidˉreturn.Bindings) != 0u32 ||
        Bytesˉlength(Invalidˉreturn.Wir) != 0u32 {
        return 14;
    }
    return 0;
}

export fn Main() -> i32 {
    if process.argument_count() != 4u32 { return 64; }
    let Input: bytes = One(Textˉconcat(
        "module Analysisˉfixture profile portable; ",
        "export fn Main() -> i32 { return 7; }"
    ));
    let Prepared: Analysis.Compilerˉsourceˉanalysis =
        Analysis.Compilerˉprepareˉsourceˉanalysis(Input);
    if Prepared.Status !=
        Analysisˉcontract.Compilerˉsourceˉanalysisˉstatus.Valid {
        return 1;
    }
    if Bytesˉlength(Prepared.Manifest) != 104u32 ||
        Bytesˉlength(Prepared.Bindings) <= 24u32 ||
        Bytesˉlength(Prepared.Wir) <= 48u32 {
        return 2;
    }
    let Repeated: Analysis.Compilerˉsourceˉanalysis =
        Analysis.Compilerˉprepareˉsourceˉanalysis(Input);
    if !Bytesˉequal(Prepared.Manifest, Repeated.Manifest) ||
        !Bytesˉequal(Prepared.Bindings, Repeated.Bindings) ||
        !Bytesˉequal(Prepared.Wir, Repeated.Wir) {
        return 3;
    }
    if Prepared.Failureˉmodule != 4294967295u32 ||
        Prepared.Failureˉrelatedˉmodule != 4294967295u32 ||
        Prepared.Failureˉfunction != 4294967295u32 ||
        Prepared.Failureˉoffset != 0u32 ||
        Prepared.Failureˉline != 0u32 || Prepared.Failureˉcolumn != 0u32 ||
        Prepared.Failureˉwirˉfunctions != 0u32 ||
        Prepared.Failureˉwirˉblocks != 0u32 ||
        Prepared.Failureˉwirˉoperations != 0u32 ||
        Prepared.Failureˉwirˉtemporaries != 0u32 ||
        Prepared.Failureˉwirˉoperands != 0u32 {
        return 15;
    }
    let Failed: i32 = Failureˉevidence();
    if Failed != 0 { return Failed; }
    file.write_bytes(process.argument(0u32), Input);
    file.write_bytes(process.argument(1u32), Prepared.Manifest);
    file.write_bytes(process.argument(2u32), Prepared.Bindings);
    file.write_bytes(process.argument(3u32), Prepared.Wir);
    return 0;
}
