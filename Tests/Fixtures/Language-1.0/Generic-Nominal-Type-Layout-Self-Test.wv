module Languageˉoneˉgenericˉnominalˉtypeˉlayoutˉselfˉtest profile portable;

import Compilerˉsourceˉgenericˉlowering as Generics;
import Compilerˉsourceˉgenericˉtypeˉbinding as Genericˉbinding;
import Compilerˉsourceˉgenericˉtypeˉlayout as Genericˉlayout;
import Compilerˉsourceˉgenericˉtypeˉlowering as Genericˉtypes;
import Compilerˉsourceˉset as Sourceˉset;
import Compilerˉsourceˉsymbols as Sourceˉsymbols;
import Foundationˉbyteˉconstruction as Byteˉconstruction;

data Sourceˉsymbolsˉmagic: bytes = [87, 86, 83, 83];
data Readˉclasses: bytes = [1, 2, 2, 0, 2, 2, 1, 1, 1, 1, 1];

fn Sourceˉsymbolsˉone(Source: text) -> bytes {
    let Sourceˉbytes: bytes = Textˉtoˉutf8(Source);
    var Header: bytes = Sourceˉsymbolsˉmagic;
    Header = Bytesˉconcat(Header, Bytesˉfromˉu16ˉlittle(1u32));
    Header = Bytesˉconcat(Header, Bytesˉfromˉu16ˉlittle(0u32));
    Header = Bytesˉconcat(Header, Bytesˉfromˉu32ˉlittle(1u32));
    Header = Bytesˉconcat(Header, Bytesˉfromˉu32ˉlittle(8u32));
    var Directory: bytes = Bytesˉfromˉu32ˉlittle(24u32);
    Directory = Bytesˉconcat(
        Directory, Bytesˉfromˉu32ˉlittle(Bytesˉlength(Sourceˉbytes))
    );
    return Bytesˉconcat(Bytesˉconcat(Header, Directory), Sourceˉbytes);
}

fn Markerˉoffset(Source: bytes, Marker: text) -> u32 {
    let Markerˉbytes: bytes = Textˉtoˉutf8(Marker);
    let Sourceˉlength: u32 = Bytesˉlength(Source);
    let Markerˉlength: u32 = Bytesˉlength(Markerˉbytes);
    if Markerˉlength == 0u32 || Markerˉlength > Sourceˉlength {
        return 4294967295u32;
    }
    var Offset: u32 = 0u32;
    while Offset <= Sourceˉlength - Markerˉlength {
        var Equal: bool = true;
        var Index: u32 = 0u32;
        while Index < Markerˉlength {
            if Bytesˉreadˉu8(Source, Offset + Index) !=
                Bytesˉreadˉu8(Markerˉbytes, Index) {
                Equal = false;
            }
            Index = Index + 1u32;
        }
        if Equal { return Offset + Markerˉlength; }
        Offset = Offset + 1u32;
    }
    return 4294967295u32;
}

fn Bind(
    Input: bytes,
    Scan: Sourceˉset.Compilerˉsourceˉsetˉscan,
    Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary,
    Source: bytes,
    Marker: text,
    Catalog: Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog
) -> Genericˉbinding.Compilerˉsourceˉgenericˉtypeˉbinding {
    return Genericˉbinding.Compilerˉsourceˉgenericˉtypeˉbind(
        Input, Scan, Symbols, 0u32, Source,
        Markerˉoffset(Source, Marker), 1u32, 1u32,
        0u32, 0u32, 0u32, 0u32, Catalog
    );
}

fn Bindingˉcatalog(
    Binding: Genericˉbinding.Compilerˉsourceˉgenericˉtypeˉbinding
) -> Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog {
    return Genericˉbinding.Compilerˉsourceˉgenericˉtypeˉbindingˉcatalog(
        Binding
    );
}

fn Nameˉis(
    Source: bytes,
    Offset: u32,
    Length: u32,
    Expected: text
) -> bool {
    let Expectedˉbytes: bytes = Textˉtoˉutf8(Expected);
    return Length == Bytesˉlength(Expectedˉbytes) &&
        Sourceˉset.Compilerˉsourceˉspansˉequal(
            Source, Offset, Length,
            Expectedˉbytes, 0u32, Bytesˉlength(Expectedˉbytes)
        );
}

export fn Main() -> i32 {
    var Source: text = "module Genericˉtypeˉlayout profile portable;\n";
    Source = Textˉconcat(Source, "record Box<T> { Value: T; }\n");
    Source = Textˉconcat(
        Source,
        "record Packet<T, E> { Value: T; Error: E; Ready: bool; }\n"
    );
    Source = Textˉconcat(
        Source,
        "variant Choice<T, E> { Empty; Left(Value: T); Right(Error: E); Both(Value: T, Error: E,); }\n"
    );
    Source = Textˉconcat(
        Source,
        "variant DirectInner { Value(Value: i32); }\n"
    );
    Source = Textˉconcat(
        Source,
        "variant DirectOuter { Value(Value: DirectInner); }\n"
    );
    Source = Textˉconcat(Source, "record Slot<T> { Value: T; }\n");
    Source = Textˉconcat(
        Source, "record ConstantBox<const Maximum: u32> { Value: i32; }\n"
    );
    Source = Textˉconcat(Source, "record Inner<T> { Value: T; }\n");
    Source = Textˉconcat(
        Source, "record Outer<T> { Value: Inner<T>; }\n"
    );
    Source = Textˉconcat(
        Source,
        "variant Envelope<T> { Packed(Value: Outer<T>); }\n"
    );
    Source = Textˉconcat(
        Source,
        "record Sized<T, const Maximum: u32> { Value: T; }\n"
    );
    Source = Textˉconcat(
        Source,
        "record SizedOuter<T, const Maximum: u32> { Value: Sized<T, Maximum>; }\n"
    );
    Source = Textˉconcat(Source, "fn Root() -> i32 { return 0; }\n");
    Source = Textˉconcat(Source, "// useˉbox Box<i32>\n");
    Source = Textˉconcat(
        Source, "// useˉpacket Packet<Box<i32>, text>\n"
    );
    Source = Textˉconcat(
        Source, "// useˉchoice Choice<Box<i32>, text>\n"
    );
    Source = Textˉconcat(
        Source, "// useˉbuilder Slot<builder<i32, 8u32>>\n"
    );
    Source = Textˉconcat(
        Source, "// useˉvariant Choice<Choice<i32, text>, text>\n"
    );
    Source = Textˉconcat(
        Source, "// useˉdependency Envelope<i32>\n"
    );
    Source = Textˉconcat(
        Source, "// useˉconstantˉdependency SizedOuter<i32, 8u32>\n"
    );
    let Input: bytes = Sourceˉsymbolsˉone(Source);
    let Scan: Sourceˉset.Compilerˉsourceˉsetˉscan =
        Sourceˉset.Compilerˉscanˉsourceˉset(Input);
    let Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary =
        Sourceˉsymbols.Compilerˉvalidateˉsourceˉsymbols(Input);
    let View: Sourceˉset.Compilerˉsourceˉsetˉview =
        Sourceˉset.Compilerˉsourceˉsetˉmodule(Input, Scan, 0u32);
    if Scan.Status != Sourceˉset.Compilerˉsourceˉsetˉstatus.Valid ||
        Symbols.Status !=
            Sourceˉsymbols.Compilerˉsourceˉsymbolˉstatus.Valid {
        return 1;
    }

    var Catalog: Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog =
        Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalogˉempty();
    var Binding: Genericˉbinding.Compilerˉsourceˉgenericˉtypeˉbinding =
        Bind(Input, Scan, Symbols, View.Source, "useˉbox ", Catalog);
    Catalog = Bindingˉcatalog(Binding);
    Binding = Bind(
        Input, Scan, Symbols, View.Source, "useˉpacket ", Catalog
    );
    Catalog = Bindingˉcatalog(Binding);
    Binding = Bind(
        Input, Scan, Symbols, View.Source, "useˉchoice ", Catalog
    );
    Catalog = Bindingˉcatalog(Binding);
    Binding = Bind(
        Input, Scan, Symbols, View.Source, "useˉbuilder ", Catalog
    );
    Catalog = Bindingˉcatalog(Binding);
    Binding = Bind(
        Input, Scan, Symbols, View.Source, "useˉvariant ", Catalog
    );
    Catalog = Bindingˉcatalog(Binding);
    Binding = Bind(
        Input, Scan, Symbols, View.Source, "useˉdependency ", Catalog
    );
    Catalog = Bindingˉcatalog(Binding);
    Binding = Bind(
        Input, Scan, Symbols, View.Source,
        "useˉconstantˉdependency ", Catalog
    );
    Catalog = Bindingˉcatalog(Binding);
    if Binding.Status !=
            Sourceˉsymbols.Compilerˉsourceˉsymbolˉstatus.Valid ||
        Binding.Genericˉstatus !=
            Generics.Compilerˉsourceˉgenericˉstatus.Valid ||
        Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalogˉinstances(
            Catalog
        ) != 11u32 {
        return 2;
    }

    let Box: Genericˉlayout.Compilerˉsourceˉgenericˉtypeˉlayout =
        Genericˉlayout.Compilerˉsourceˉgenericˉtypeˉlayoutˉcreate(
            Input, Scan, Symbols, Catalog, 0u32
        );
    if Box.Genericˉstatus !=
            Generics.Compilerˉsourceˉgenericˉstatus.Valid ||
        Box.Symbolˉstatus !=
            Sourceˉsymbols.Compilerˉsourceˉsymbolˉstatus.Valid ||
        Box.Items != 1u32 || Box.Fields != 1u32 ||
        Bytesˉlength(Box.Itemˉevidence) != 0u32 ||
        Bytesˉlength(Box.Fieldˉevidence) != 16u32 ||
        !Genericˉlayout.Compilerˉsourceˉgenericˉtypeˉlayoutˉisˉvalid(
            Input, Scan, Symbols, Box
        ) {
        return 3;
    }
    let Boxˉfield:
        Genericˉlayout.Compilerˉsourceˉgenericˉtypeˉfield =
        Genericˉlayout.Compilerˉsourceˉgenericˉtypeˉlayoutˉrecordˉfield(
            Input, Scan, Symbols, Box, 0u32
        );
    if !Boxˉfield.Found || Boxˉfield.Shape != 1u32 ||
        !Nameˉis(
            View.Source, Boxˉfield.Nameˉoffset,
            Boxˉfield.Nameˉlength, "Value"
        ) {
        return 4;
    }

    let Packet: Genericˉlayout.Compilerˉsourceˉgenericˉtypeˉlayout =
        Genericˉlayout.Compilerˉsourceˉgenericˉtypeˉlayoutˉcreate(
            Input, Scan, Symbols, Catalog, 1u32
        );
    if Packet.Items != 3u32 || Packet.Fields != 3u32 ||
        Bytesˉlength(Packet.Itemˉevidence) != 0u32 ||
        Bytesˉlength(Packet.Fieldˉevidence) != 48u32 ||
        Packet.Shape !=
            Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉshape(1u32) {
        return 5;
    }
    let Packetˉvalue:
        Genericˉlayout.Compilerˉsourceˉgenericˉtypeˉfield =
        Genericˉlayout.Compilerˉsourceˉgenericˉtypeˉlayoutˉrecordˉfield(
            Input, Scan, Symbols, Packet, 0u32
        );
    let Packetˉerror:
        Genericˉlayout.Compilerˉsourceˉgenericˉtypeˉfield =
        Genericˉlayout.Compilerˉsourceˉgenericˉtypeˉlayoutˉrecordˉfield(
            Input, Scan, Symbols, Packet, 1u32
        );
    let Packetˉready:
        Genericˉlayout.Compilerˉsourceˉgenericˉtypeˉfield =
        Genericˉlayout.Compilerˉsourceˉgenericˉtypeˉlayoutˉrecordˉfield(
            Input, Scan, Symbols, Packet, 2u32
        );
    if Packetˉvalue.Shape !=
        Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉshape(0u32) { return 119; }
    if Packetˉvalue.Nominalˉkind !=
        Sourceˉsymbols.Compilerˉsourceˉsymbolsˉdeclarationˉkind(4u32) { return 116; }
    if Packetˉerror.Shape != 5u32 { return 117; }
    if Packetˉready.Shape != 4u32 { return 118; }

    let Choice: Genericˉlayout.Compilerˉsourceˉgenericˉtypeˉlayout =
        Genericˉlayout.Compilerˉsourceˉgenericˉtypeˉlayoutˉcreate(
            Input, Scan, Symbols, Catalog, 2u32
        );
    if Choice.Items != 4u32 || Choice.Fields != 4u32 ||
        Bytesˉlength(Choice.Itemˉevidence) != 64u32 ||
        Bytesˉlength(Choice.Fieldˉevidence) != 64u32 ||
        Choice.Symbolˉstatus !=
            Sourceˉsymbols.Compilerˉsourceˉsymbolˉstatus.Valid {
        return 7;
    }
    let Empty: Genericˉlayout.Compilerˉsourceˉgenericˉtypeˉcase =
        Genericˉlayout.Compilerˉsourceˉgenericˉtypeˉlayoutˉvariantˉcase(
            Input, Scan, Symbols, Choice, 0u32
        );
    let Both: Genericˉlayout.Compilerˉsourceˉgenericˉtypeˉcase =
        Genericˉlayout.Compilerˉsourceˉgenericˉtypeˉlayoutˉvariantˉcase(
            Input, Scan, Symbols, Choice, 3u32
        );
    if !Empty.Found || Empty.Fields != 0u32 || !Both.Found ||
        Both.Fields != 2u32 ||
        !Nameˉis(View.Source, Empty.Nameˉoffset, Empty.Nameˉlength, "Empty") ||
        !Nameˉis(View.Source, Both.Nameˉoffset, Both.Nameˉlength, "Both") {
        return 8;
    }
    let Leftˉvalue:
        Genericˉlayout.Compilerˉsourceˉgenericˉtypeˉfield =
        Genericˉlayout.Compilerˉsourceˉgenericˉtypeˉlayoutˉvariantˉfield(
            Input, Scan, Symbols, Choice, 1u32, 0u32
        );
    let Bothˉerror:
        Genericˉlayout.Compilerˉsourceˉgenericˉtypeˉfield =
        Genericˉlayout.Compilerˉsourceˉgenericˉtypeˉlayoutˉvariantˉfield(
            Input, Scan, Symbols, Choice, 3u32, 1u32
        );
    if Leftˉvalue.Shape !=
            Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉshape(0u32) ||
        Bothˉerror.Shape != 5u32 ||
        !Nameˉis(
            View.Source, Bothˉerror.Nameˉoffset,
            Bothˉerror.Nameˉlength, "Error"
        ) {
        return 9;
    }

    let Missingˉrecord:
        Genericˉlayout.Compilerˉsourceˉgenericˉtypeˉfield =
        Genericˉlayout.Compilerˉsourceˉgenericˉtypeˉlayoutˉrecordˉfield(
            Input, Scan, Symbols, Packet, 3u32
        );
    let Missingˉcase:
        Genericˉlayout.Compilerˉsourceˉgenericˉtypeˉcase =
        Genericˉlayout.Compilerˉsourceˉgenericˉtypeˉlayoutˉvariantˉcase(
            Input, Scan, Symbols, Choice, 4u32
        );
    if Missingˉrecord.Found || Missingˉcase.Found {
        return 10;
    }

    let Builder: Genericˉlayout.Compilerˉsourceˉgenericˉtypeˉlayout =
        Genericˉlayout.Compilerˉsourceˉgenericˉtypeˉlayoutˉcreate(
            Input, Scan, Symbols, Catalog, 3u32
        );
    if Builder.Symbolˉstatus !=
        Sourceˉsymbols.Compilerˉsourceˉsymbolˉstatus.Invalidˉfieldˉtype {
        return 11;
    }
    let Innerˉvariant:
        Genericˉlayout.Compilerˉsourceˉgenericˉtypeˉlayout =
        Genericˉlayout.Compilerˉsourceˉgenericˉtypeˉlayoutˉcreate(
            Input, Scan, Symbols, Catalog, 4u32
        );
    if Innerˉvariant.Symbolˉstatus !=
        Sourceˉsymbols.Compilerˉsourceˉsymbolˉstatus.Valid {
        return 12;
    }
    let Outerˉvariant:
        Genericˉlayout.Compilerˉsourceˉgenericˉtypeˉlayout =
        Genericˉlayout.Compilerˉsourceˉgenericˉtypeˉlayoutˉcreate(
            Input, Scan, Symbols, Catalog, 5u32
        );
    let Outerˉvariantˉvalue:
        Genericˉlayout.Compilerˉsourceˉgenericˉtypeˉfield =
        Genericˉlayout.Compilerˉsourceˉgenericˉtypeˉlayoutˉvariantˉfield(
            Input, Scan, Symbols, Outerˉvariant, 1u32, 0u32
        );
    if Outerˉvariant.Symbolˉstatus !=
            Sourceˉsymbols.Compilerˉsourceˉsymbolˉstatus.Valid ||
        !Genericˉlayout.Compilerˉsourceˉgenericˉtypeˉlayoutˉisˉvalid(
            Input, Scan, Symbols, Outerˉvariant
        ) ||
        !Outerˉvariantˉvalue.Found ||
        Outerˉvariantˉvalue.Shape !=
            Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉshape(4u32) ||
        Outerˉvariantˉvalue.Nominalˉkind !=
            Sourceˉsymbols.Compilerˉsourceˉsymbolsˉdeclarationˉkind(8u32) {
        return 13;
    }

    let Innerˉdependency:
        Genericˉlayout.Compilerˉsourceˉgenericˉtypeˉlayout =
        Genericˉlayout.Compilerˉsourceˉgenericˉtypeˉlayoutˉcreate(
            Input, Scan, Symbols, Catalog, 6u32
        );
    let Outerˉdependency:
        Genericˉlayout.Compilerˉsourceˉgenericˉtypeˉlayout =
        Genericˉlayout.Compilerˉsourceˉgenericˉtypeˉlayoutˉcreate(
            Input, Scan, Symbols, Catalog, 7u32
        );
    let Envelopeˉdependency:
        Genericˉlayout.Compilerˉsourceˉgenericˉtypeˉlayout =
        Genericˉlayout.Compilerˉsourceˉgenericˉtypeˉlayoutˉcreate(
            Input, Scan, Symbols, Catalog, 8u32
        );
    if Innerˉdependency.Symbolˉstatus !=
            Sourceˉsymbols.Compilerˉsourceˉsymbolˉstatus.Valid ||
        Outerˉdependency.Symbolˉstatus !=
            Sourceˉsymbols.Compilerˉsourceˉsymbolˉstatus.Valid ||
        Envelopeˉdependency.Symbolˉstatus !=
            Sourceˉsymbols.Compilerˉsourceˉsymbolˉstatus.Valid {
        return 19;
    }
    let Outerˉdependencyˉfield:
        Genericˉlayout.Compilerˉsourceˉgenericˉtypeˉfield =
        Genericˉlayout.Compilerˉsourceˉgenericˉtypeˉlayoutˉrecordˉfield(
            Input, Scan, Symbols, Outerˉdependency, 0u32
        );
    let Envelopeˉdependencyˉfield:
        Genericˉlayout.Compilerˉsourceˉgenericˉtypeˉfield =
        Genericˉlayout.Compilerˉsourceˉgenericˉtypeˉlayoutˉvariantˉfield(
            Input, Scan, Symbols, Envelopeˉdependency, 0u32, 0u32
        );
    if !Outerˉdependencyˉfield.Found ||
        Outerˉdependencyˉfield.Shape !=
            Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉshape(6u32) ||
        !Envelopeˉdependencyˉfield.Found ||
        Envelopeˉdependencyˉfield.Shape !=
            Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉshape(7u32) {
        return 20;
    }
    let Sizedˉdependency:
        Genericˉlayout.Compilerˉsourceˉgenericˉtypeˉlayout =
        Genericˉlayout.Compilerˉsourceˉgenericˉtypeˉlayoutˉcreate(
            Input, Scan, Symbols, Catalog, 9u32
        );
    let Sizedˉouterˉdependency:
        Genericˉlayout.Compilerˉsourceˉgenericˉtypeˉlayout =
        Genericˉlayout.Compilerˉsourceˉgenericˉtypeˉlayoutˉcreate(
            Input, Scan, Symbols, Catalog, 10u32
        );
    let Sizedˉouterˉfield:
        Genericˉlayout.Compilerˉsourceˉgenericˉtypeˉfield =
        Genericˉlayout.Compilerˉsourceˉgenericˉtypeˉlayoutˉrecordˉfield(
            Input, Scan, Symbols, Sizedˉouterˉdependency, 0u32
        );
    let Sizedˉouterˉconstant:
        Generics.Compilerˉsourceˉgenericˉargument =
        Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalogˉargument(
            Catalog, 10u32, 1u32
        );
    if Sizedˉdependency.Symbolˉstatus !=
            Sourceˉsymbols.Compilerˉsourceˉsymbolˉstatus.Valid ||
        Sizedˉouterˉdependency.Symbolˉstatus !=
            Sourceˉsymbols.Compilerˉsourceˉsymbolˉstatus.Valid ||
        Sizedˉouterˉfield.Shape !=
            Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉshape(9u32) ||
        !Sizedˉouterˉconstant.Valid || Sizedˉouterˉconstant.Kind != 2u32 ||
        Sizedˉouterˉconstant.Shape != 3u32 ||
        Sizedˉouterˉconstant.Low != 8u32 ||
        Sizedˉouterˉconstant.High != 0u32 {
        return 21;
    }

    let Mismatchˉresult: Byteˉconstruction.Foundationˉbytesˉresult =
        Byteˉconstruction.Foundationˉbytesˉreplace(
            Catalog.Evidence, 24u32, 4u32, Bytesˉfromˉu32ˉlittle(4u32)
        );
    let Mismatchˉcatalog:
        Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog =
        Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog(
            Generics.Compilerˉsourceˉgenericˉstatus.Valid,
            Mismatchˉresult.Value
        );
    let Mismatchˉlayout:
        Genericˉlayout.Compilerˉsourceˉgenericˉtypeˉlayout =
        Genericˉlayout.Compilerˉsourceˉgenericˉtypeˉlayoutˉcreate(
            Input, Scan, Symbols, Mismatchˉcatalog, 0u32
        );
    if !Mismatchˉresult.Valid ||
        Mismatchˉlayout.Genericˉstatus !=
            Generics.Compilerˉsourceˉgenericˉstatus.Invalidˉevidence {
        return 14;
    }
    let Missingˉresult: Byteˉconstruction.Foundationˉbytesˉresult =
        Byteˉconstruction.Foundationˉbytesˉreplace(
            Catalog.Evidence, 24u32, 4u32, Bytesˉfromˉu32ˉlittle(999u32)
        );
    let Missingˉcatalog:
        Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog =
        Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog(
            Generics.Compilerˉsourceˉgenericˉstatus.Valid,
            Missingˉresult.Value
        );
    let Missingˉlayout:
        Genericˉlayout.Compilerˉsourceˉgenericˉtypeˉlayout =
        Genericˉlayout.Compilerˉsourceˉgenericˉtypeˉlayoutˉcreate(
            Input, Scan, Symbols, Missingˉcatalog, 0u32
        );
    if !Missingˉresult.Valid ||
        Missingˉlayout.Genericˉstatus !=
            Generics.Compilerˉsourceˉgenericˉstatus.Invalidˉevidence {
        return 15;
    }

    let Tampered: Genericˉlayout.Compilerˉsourceˉgenericˉtypeˉlayout =
        Genericˉlayout.Compilerˉsourceˉgenericˉtypeˉlayout(
            Packet.Genericˉstatus, Packet.Symbolˉstatus,
            Packet.Instance, Packet.Shape, Packet.Kind,
            Packet.Declaration, Packet.Module, Packet.Items,
            Packet.Fields + 1u32,
            Packet.Itemˉevidence, Packet.Fieldˉevidence,
            Packet.Catalogˉstatus,
            Packet.Catalogˉevidence, Packet.Failureˉoffset,
            Packet.Failureˉline, Packet.Failureˉcolumn
        );
    if Genericˉlayout.Compilerˉsourceˉgenericˉtypeˉlayoutˉisˉvalid(
            Input, Scan, Symbols, Tampered
        ) {
        return 16;
    }
    let Invalidˉinstance:
        Genericˉlayout.Compilerˉsourceˉgenericˉtypeˉlayout =
        Genericˉlayout.Compilerˉsourceˉgenericˉtypeˉlayoutˉcreate(
            Input, Scan, Symbols, Catalog, 11u32
        );
    if Invalidˉinstance.Genericˉstatus !=
        Generics.Compilerˉsourceˉgenericˉstatus.Invalidˉevidence {
        return 17;
    }
    let Badˉcatalog: Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog =
        Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog(
            Generics.Compilerˉsourceˉgenericˉstatus.Invalidˉevidence,
            Bytesˉslice(Input, 0u32, 0u32)
        );
    let Badˉlayout: Genericˉlayout.Compilerˉsourceˉgenericˉtypeˉlayout =
        Genericˉlayout.Compilerˉsourceˉgenericˉtypeˉlayoutˉcreate(
            Input, Scan, Symbols, Badˉcatalog, 0u32
        );
    if Badˉlayout.Catalogˉstatus !=
        Generics.Compilerˉsourceˉgenericˉstatus.Invalidˉevidence {
        return 18;
    }
    var Primitive: u32 = 1u32;
    while Primitive <= 16u32 {
        var Expected: u32 = 1u32;
        if Primitive == 5u32 || Primitive == 6u32 { Expected = 2u32; }
        if Genericˉlayout.Compilerˉsourceˉgenericˉtypeˉreadˉclass(
            Input, Scan, Symbols, Catalog, Primitive
        ) != Expected { return 22; }
        Primitive = Primitive + 1u32;
    }
    var Aggregate: u32 = 0u32;
    while Aggregate < Bytesˉlength(Readˉclasses) {
        if Genericˉlayout.Compilerˉsourceˉgenericˉtypeˉreadˉclass(
            Input, Scan, Symbols, Catalog,
            Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉshape(Aggregate)
        ) != U32ˉfromˉu8(Bytesˉreadˉu8(Readˉclasses, Aggregate)) {
            return 23;
        }
        Aggregate = Aggregate + 1u32;
    }
    if Genericˉlayout.Compilerˉsourceˉgenericˉtypeˉreadˉclass(
        Input, Scan, Symbols, Catalog, 0u32
    ) != 0u32 || Genericˉlayout.Compilerˉsourceˉgenericˉtypeˉreadˉclass(
        Input, Scan, Symbols, Catalog, 65536u32
    ) != 0u32 { return 24; }
    if Genericˉlayout.Compilerˉsourceˉgenericˉtypeˉreadˉclass(
        Input, Scan, Symbols, Catalog,
        Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉshape(11u32)
    ) != 0u32 { return 25; }
    var Prefix: u32 = 0u32;
    while Prefix < 24u32 {
        let Truncated: Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog =
            Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalog(
                Generics.Compilerˉsourceˉgenericˉstatus.Valid,
                Bytesˉslice(Catalog.Evidence, 0u32, Prefix)
            );
        if Genericˉlayout.Compilerˉsourceˉgenericˉtypeˉreadˉclass(
            Input, Scan, Symbols, Truncated, Box.Shape
        ) != 0u32 { return 26; }
        Prefix = Prefix + 1u32;
    }
    if Genericˉlayout.Compilerˉsourceˉgenericˉtypeˉreadˉclass(
        Input, Scan, Symbols, Mismatchˉcatalog, Box.Shape
    ) != 0u32 { return 27; }
    if Genericˉlayout.Compilerˉsourceˉgenericˉtypeˉreadˉclass(
        Input, Scan, Symbols, Missingˉcatalog, Box.Shape
    ) != 0u32 || Genericˉlayout.Compilerˉsourceˉgenericˉtypeˉreadˉclass(
        Input, Scan, Symbols, Badˉcatalog, Box.Shape
    ) != 0u32 { return 28; }
    if Opaqueˉclasses() != 0 { return 29; }
    let Collections: i32 = Collectionˉclasses();
    if Collections != 0 { return Collections; }
    let Nominals: i32 = Nominalˉclasses();
    if Nominals != 0 { return Nominals; }
    if !Repeatedˉclass("u32", 1u32) { return 114; }
    if !Repeatedˉclass("text", 2u32) { return 115; }
    return 42;
}

fn Opaqueˉclasses() -> i32 {
    let Body: text = "record Foreignˉscratch<T> { Opaqueˉidentity: u64; }\nrecord Foreignˉwriteˉregion<T> { Opaqueˉidentity: u64; }\nrecord Foreignˉpointer<T, E> { Opaqueˉidentity: u64; }\nrecord Nullableˉforeignˉpointer<T, E> { Opaqueˉidentity: u64; }\nrecord Task<T, E> { Taskˉtokenˉidentity: u64; }\nrecord Box<T> { Value: T; }\n// use Box<Foreignˉscratch<u32>>\n// region Box<Foreignˉwriteˉregion<u32>>\n// pointer Box<Foreignˉpointer<u32, u32>>\n// nullable Box<Nullableˉforeignˉpointer<u32, u32>>\n// task Box<Task<u32, u32>>\n";
    var Case: u32 = 0u32;
    while Case < 6u32 {
        var Header: text = "module Foundationˉunsafe profile system;\n";
        var Marker: text = "// use ";
        if Case == 1u32 { Marker = "// region "; }
        if Case == 2u32 { Marker = "// pointer "; }
        if Case == 3u32 { Marker = "// nullable "; }
        if Case == 4u32 {
            Header = "module Foundationˉtask profile hosted;\n";
            Marker = "// task ";
        }
        if Case == 5u32 { Header = "module Userˉtypes profile portable;\n"; }
        let Input: bytes = Sourceˉsymbolsˉone(Textˉconcat(Header, Body));
        let Scan: Sourceˉset.Compilerˉsourceˉsetˉscan =
            Sourceˉset.Compilerˉscanˉsourceˉset(Input);
        let Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary =
            Sourceˉsymbols.Compilerˉvalidateˉsourceˉsymbols(Input);
        if Scan.Status != Sourceˉset.Compilerˉsourceˉsetˉstatus.Valid ||
            Symbols.Status != Sourceˉsymbols.Compilerˉsourceˉsymbolˉstatus.Valid {
            return 120;
        }
        let View: Sourceˉset.Compilerˉsourceˉsetˉview =
            Sourceˉset.Compilerˉsourceˉsetˉmodule(Input, Scan, 0u32);
        let Binding: Genericˉbinding.Compilerˉsourceˉgenericˉtypeˉbinding =
            Bind(Input, Scan, Symbols, View.Source, Marker,
                Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalogˉempty());
        var Expected: u32 = 3u32;
        if Case == 5u32 { Expected = 1u32; }
        if Binding.Status != Sourceˉsymbols.Compilerˉsourceˉsymbolˉstatus.Valid ||
            Genericˉlayout.Compilerˉsourceˉgenericˉtypeˉreadˉclass(
                Input, Scan, Symbols, Bindingˉcatalog(Binding), Binding.Shape
            ) != Expected { return 1; }
        Case = Case + 1u32;
    }
    return 0;
}

fn Collectionˉclasses() -> i32 {
    let Source: text = "\nmodule Readˉclasses;\nprofile core;\nplatform linux, windows, windvale;\nauthority application;\nimport Foundationˉcollections as Collections;\nrecord Box<T> { Value: T; }\n// scalar Collections.Array<u32, 4095u64>\n// shared Collections.Array<text, 2u64>\n// owned Collections.Array<Collections.Vector<u32>, 0u64>\n// nested Collections.Array<Collections.Array<bytes, 2u64>, 3u64>\n// vector Box<Collections.Vector<u32>>\n// sequence Box<Collections.Sequence<u32>>\n// emptyˉcopy Collections.Array<u32, 0u64>\n// emptyˉshared Collections.Array<Box<text>, 0u64>\n";
    let Sourceˉbytes: bytes = Textˉtoˉutf8(Source);
    let Foundation: bytes = Textˉtoˉutf8("\nmodule Foundationˉcollections;\nprofile core;\nplatform linux, windows, windvale;\nauthority library;\n");
    var Input: bytes = Bytesˉconcat(Sourceˉsymbolsˉmagic, Bytesˉfromˉu16ˉlittle(2u32));
    Input = Bytesˉconcat(Input, Bytesˉfromˉu16ˉlittle(0u32));
    Input = Bytesˉconcat(Input, Bytesˉfromˉu32ˉlittle(2u32));
    Input = Bytesˉconcat(Input, Bytesˉfromˉu32ˉlittle(40u32));
    Input = Bytesˉconcat(Input, Bytesˉfromˉu32ˉlittle(56u32));
    Input = Bytesˉconcat(Input, Bytesˉfromˉu32ˉlittle(Bytesˉlength(Sourceˉbytes)));
    Input = Bytesˉconcat(Input, Bytesˉfromˉu32ˉlittle(1u32));
    Input = Bytesˉconcat(Input, Bytesˉfromˉu32ˉlittle(1u32));
    Input = Bytesˉconcat(Input, Bytesˉfromˉu32ˉlittle(12u32));
    Input = Bytesˉconcat(Input, Bytesˉfromˉu32ˉlittle(56u32 + Bytesˉlength(Sourceˉbytes)));
    Input = Bytesˉconcat(Input, Bytesˉfromˉu32ˉlittle(Bytesˉlength(Foundation)));
    Input = Bytesˉconcat(Input, Bytesˉfromˉu32ˉlittle(1u32));
    Input = Bytesˉconcat(Input, Bytesˉfromˉu32ˉlittle(1u32));
    Input = Bytesˉconcat(Input, Bytesˉfromˉu32ˉlittle(12u32));
    Input = Bytesˉconcat(Input, Sourceˉbytes);
    Input = Bytesˉconcat(Input, Foundation);
    let Scan: Sourceˉset.Compilerˉsourceˉsetˉscan =
        Sourceˉset.Compilerˉscanˉsourceˉset(Input);
    let Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary =
        Sourceˉsymbols.Compilerˉvalidateˉsourceˉsymbols(Input);
    if Scan.Status != Sourceˉset.Compilerˉsourceˉsetˉstatus.Valid ||
        Symbols.Status != Sourceˉsymbols.Compilerˉsourceˉsymbolˉstatus.Valid {
        return 121;
    }
    var Case: u32 = 0u32;
    while Case < 8u32 {
        var Marker: text = "scalar ";
        var Expected: u32 = 1u32;
        if Case == 1u32 { Marker = "shared "; Expected = 2u32; }
        if Case == 2u32 { Marker = "owned "; Expected = 3u32; }
        if Case == 3u32 { Marker = "nested "; Expected = 2u32; }
        if Case == 4u32 { Marker = "vector "; Expected = 3u32; }
        if Case == 5u32 { Marker = "sequence "; Expected = 2u32; }
        if Case == 6u32 { Marker = "emptyˉcopy "; Expected = 1u32; }
        if Case == 7u32 { Marker = "emptyˉshared "; Expected = 2u32; }
        let Binding: Genericˉbinding.Compilerˉsourceˉgenericˉtypeˉbinding =
            Bind(Input, Scan, Symbols, Sourceˉbytes, Marker,
                Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalogˉempty());
        if Binding.Status != Sourceˉsymbols.Compilerˉsourceˉsymbolˉstatus.Valid ||
            Genericˉlayout.Compilerˉsourceˉgenericˉtypeˉreadˉclass(
                Input, Scan, Symbols, Bindingˉcatalog(Binding), Binding.Shape
            ) != Expected {
            if Case == 0u32 { return 30; }
            if Case == 1u32 { return 31; }
            if Case == 2u32 { return 32; }
            if Case == 3u32 { return 33; }
            if Case == 4u32 { return 34; }
            if Case == 5u32 { return 35; }
            if Case == 6u32 { return 112; }
            return 113;
        }
        Case = Case + 1u32;
    }
    return 0;
}

fn Sourceˉclassˉis(Source: text, Expected: u32) -> bool {
    let Input: bytes = Sourceˉsymbolsˉone(Source);
    let Scan: Sourceˉset.Compilerˉsourceˉsetˉscan =
        Sourceˉset.Compilerˉscanˉsourceˉset(Input);
    let Symbols: Sourceˉsymbols.Compilerˉsourceˉsymbolˉsummary =
        Sourceˉsymbols.Compilerˉvalidateˉsourceˉsymbols(Input);
    if Scan.Status != Sourceˉset.Compilerˉsourceˉsetˉstatus.Valid ||
        Symbols.Status != Sourceˉsymbols.Compilerˉsourceˉsymbolˉstatus.Valid {
        return false;
    }
    let View: Sourceˉset.Compilerˉsourceˉsetˉview =
        Sourceˉset.Compilerˉsourceˉsetˉmodule(Input, Scan, 0u32);
    let Binding: Genericˉbinding.Compilerˉsourceˉgenericˉtypeˉbinding =
        Bind(Input, Scan, Symbols, View.Source, "// read ",
            Genericˉtypes.Compilerˉsourceˉgenericˉtypeˉcatalogˉempty());
    return Binding.Status == Sourceˉsymbols.Compilerˉsourceˉsymbolˉstatus.Valid &&
        Binding.Genericˉstatus == Generics.Compilerˉsourceˉgenericˉstatus.Valid &&
        Genericˉlayout.Compilerˉsourceˉgenericˉtypeˉreadˉclass(
            Input, Scan, Symbols, Bindingˉcatalog(Binding), Binding.Shape
        ) == Expected;
}

fn Repeatedˉclass(Leaf: text, Expected: u32) -> bool {
    var Type: text = Leaf;
    var Depth: u32 = 0u32;
    while Depth < 12u32 {
        Type = Textˉconcat(Textˉconcat("Pair<", Type), ">");
        Depth = Depth + 1u32;
    }
    return Sourceˉclassˉis(Textˉconcat(
        "module Readˉrepeated profile portable;\nrecord Pair<T> { Left: T; Right: T; }\n// read ",
        Textˉconcat(Type, "\n")
    ), Expected);
}

fn Nominalˉclasses() -> i32 {
    let Header: text = "module Readˉnominals profile portable;\n";
    let Body: text = "record Plain { Value: u32; }\nrecord Shared { Value: Plain; Text: text; }\nrecord Box<T> { Value: T; }\nrecord Wrapped { Value: Choice; }\nvariant Tag { First; Second; }\nvariant Choice { Empty; Both(Value: Shared, Number: u32); }\nenum Flag { First = 0; Second = 1; }\nrecord Tagged { Value: Flag; }\n";
    var Case: u32 = 0u32;
    var Failure: i32 = 100;
    while Case < 12u32 {
        var Source: text = Textˉconcat(Header, Body);
        var Expected: u32 = 1u32;
        if Case == 0u32 { Source = Textˉconcat(Source, "// read Plain\n"); }
        if Case == 1u32 { Source = Textˉconcat(Source, "// read Shared\n"); Expected = 2u32; }
        if Case == 2u32 { Source = Textˉconcat(Source, "// read Tag\n"); }
        if Case == 3u32 { Source = Textˉconcat(Source, "// read Box<Shared>\n"); Expected = 2u32; }
        if Case == 4u32 { Source = Textˉconcat(Source, "// read Wrapped\n"); Expected = 2u32; }
        if Case == 5u32 { Source = Textˉconcat(Source, "// read Choice\n"); Expected = 2u32; }
        if Case == 6u32 { Source = Textˉconcat(Source, "// read Tagged\n"); }
        if Case == 7u32 {
            Source = Textˉconcat(Header, "record Self { Value: Self; }\n// read Self\n");
            Expected = 0u32;
        }
        if Case == 8u32 {
            Source = Textˉconcat(Header, "record Left { Value: Right; }\nrecord Right { Value: Left; }\n// read Left\n");
            Expected = 0u32;
        }
        if Case == 9u32 {
            Source = "module Foundationˉtask profile hosted;\nrecord Taskˉscope { Scopeˉtokenˉidentity: u64; }\nrecord Wrapped { Value: Taskˉscope; }\n// read Wrapped\n";
            Expected = 3u32;
        }
        if Case == 10u32 {
            Source = "module Foundationˉtask profile hosted;\nrecord Operationˉcontext { Contextˉtokenˉidentity: u64; }\n// read Operationˉcontext\n";
        }
        if Case == 11u32 {
            Source = Textˉconcat(Header, "record Taskˉscope { Scopeˉtokenˉidentity: u64; }\n// read Taskˉscope\n");
        }
        if !Sourceˉclassˉis(Source, Expected) { return Failure; }
        Case = Case + 1u32;
        Failure = Failure + 1;
    }
    return 0;
}
