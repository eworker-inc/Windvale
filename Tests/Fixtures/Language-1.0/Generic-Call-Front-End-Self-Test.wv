module Languageˉoneˉgenericˉcallˉfrontˉendˉselfˉtest profile portable;

import Compilerˉsourceˉbodyˉparser as Bodies;

export fn Main() -> i32 {
    let Source: bytes = Textˉtoˉutf8(
        "Collections.Build::<u32, 8u32>(1u32)"
    );
    let Expression: Bodies.Compilerˉsourceˉexpression =
        Bodies.Compilerˉbodyˉparseˉprimary(
            Source, 0u32, 1u32, 1u32, Bytesˉlength(Source), 0u32
        );
    if Expression.Status != Bodies.Compilerˉbodyˉparseˉstatus.Valid ||
        Expression.Kind != Bodies.Compilerˉsourceˉexpressionˉkind.Explicitˉgenericˉcall ||
        Expression.Valueˉlength != 17u32 ||
        Expression.Numericˉvalue != 2u32 || Expression.Items != 1u32 ||
        Expression.Nextˉoffset != Bytesˉlength(Source) {
        return 1;
    }
    return 42;
}
