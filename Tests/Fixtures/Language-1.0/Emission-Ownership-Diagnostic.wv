import Foundationˉoption as Option;

fn Observe() -> i32 {
    let Owner: Option.Option<i32> = Option.Option.Present<i32> { Value: 42 };
    match Option.Borrow(borrow Owner) {
        case Option.Option.Present { Value: Value } { return Value; }
        case Option.Option.Absent { return 0; }
    }
}

// Repeated constructors amplify the existing bounded ownership scan.
// The records are acyclic and Copy-only; emission currently rejects this
// reduced Package-Lock pattern. Declaration order deliberately differs from
// canonical name order so diagnostics must resolve type indices correctly.
record Span { Value: i32; }
record Lockˉstate { First: Span; Second: Span; }
record Lockˉstep { State: Lockˉstate; }

