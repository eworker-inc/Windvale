#!wv/1 en@1
module Emissionˉunusedˉborrow;
profile core;
platform linux, windows, windvale;
authority application;

import Foundationˉcollections as Collections;
import Foundationˉmemory as Memory;
import Foundationˉoption as Option;
import Foundationˉresult as Result;

record Payload<T> { Values: T; Marker: i32; }

// Pruning this reader must not disable its declared immutable borrow.
fn Unused(Value: borrow Payload<Collections.Vector<i32> >) -> i32 {
    return Value.Marker;
}

export fn Main(Budget: Memory.Memoryˉbudget) -> i32 {
    let Created: Result.Result<Collections.Vector<i32>, Memory.Allocationˉfailure> =
        Collections.Vectorˉconstructˉreserved::<i32>(Budget, 1u64);
    match Created {
        case Result.Result.Valid { Value: Values } {
            let Owner: Option.Option<Payload<Collections.Vector<i32> > > =
                Option.Option.Present<Payload<Collections.Vector<i32> > > {
                    Value: Payload<Collections.Vector<i32> > { Values: Values, Marker: 42 }
                };
            match Option.Borrow(borrow Owner) {
                case Option.Option.Present { Value: Item } { return Item.Marker; }
                case Option.Option.Absent { return 1; }
            }
        }
        case Result.Result.Failure { Error: Failure } { return 2; }
    }
}
