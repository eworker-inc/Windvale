#!wv/1 en@1
module Foundationˉvalueˉborrowˉplanˉselfˉtest;
profile core;
platform linux, windows, windvale;
authority application;


import Compilerˉsourceˉwvbˉfoundationˉborrows as Borrows;

fn Operation(Kind: u32, Result: u32, Target: u32, First: u32, Count: u32) -> bytes {
    var Bytes: bytes = Bytesˉfromˉu32ˉlittle(0u32);
    Bytes = Bytesˉconcat(Bytes, Bytesˉfromˉu16ˉlittle(Kind));
    Bytes = Bytesˉconcat(Bytes, Bytesˉfromˉu16ˉlittle(Count));
    Bytes = Bytesˉconcat(Bytes, Bytesˉfromˉu32ˉlittle(0u32));
    Bytes = Bytesˉconcat(Bytes, Bytesˉfromˉu32ˉlittle(Result));
    Bytes = Bytesˉconcat(Bytes, Bytesˉfromˉu32ˉlittle(First));
    Bytes = Bytesˉconcat(Bytes, Bytesˉfromˉu32ˉlittle(Target));
    return Bytesˉconcat(Bytes, Bytesˉfromˉu32ˉlittle(0u32));
}

fn Plan(
    Operations: bytes, Operands: bytes, Temporaries: u32, Slots: u32,
    Parameters: bytes, Calls: bytes
) -> Borrows.Borrowˉplan {
    return Borrows.Build(
        Bytesˉconcat(Operations, Operands), 0u32, Bytesˉlength(Operations),
        0u32, Bytesˉlength(Operations) / 28u32, Temporaries, Slots, Parameters, Calls,
        Borrows.Zeroes(Temporaries)
    );
}

fn Isˉvalid(Value: Borrows.Borrowˉplan) -> bool { return Value.Valid; }
fn Ownerˉisˉvalid(Value: Borrows.Ownerˉplan) -> bool { return Value.Valid; }

export fn Main() -> i32 {
    let Empty: bytes = Borrows.Zeroes(0u32);
    let Zero: bytes = Bytesˉfromˉu8(0u8);
    let One: bytes = Bytesˉfromˉu8(1u8);
    let Two: bytes = Bytesˉfromˉu8(2u8);
    let Operandˉzero: bytes = Bytesˉfromˉu32ˉlittle(0u32);
    let Plain: Borrows.Borrowˉplan = Plan(Empty, Empty, 2u32, 2u32, Empty, Borrows.Zeroes(2u32));
    if !Plain.Valid || Plain.Hasˉborrow ||
        Bytesˉlength(Plain.Temporaryˉstate) != 2u32 || Bytesˉlength(Plain.Slotˉstate) != 2u32 {
        return 1;
    }
    let Parameter: Borrows.Borrowˉplan = Plan(
        Operation(7u32, 0u32, 0u32, 0u32, 0u32), Empty, 1u32, 1u32, One, Zero
    );
    if !Parameter.Valid || !Parameter.Hasˉborrow ||
        Bytesˉreadˉu8(Parameter.Temporaryˉstate, 0u32) != 2u8 ||
        Bytesˉreadˉu8(Parameter.Slotˉstate, 0u32) != 1u8 { return 2; }
    let Call: Borrows.Borrowˉplan = Plan(Empty, Empty, 1u32, 1u32, Empty, Two);
    if !Call.Valid || !Call.Hasˉborrow ||
        Bytesˉreadˉu8(Call.Temporaryˉstate, 0u32) != 2u8 ||
        Bytesˉreadˉu8(Call.Frozenˉslots, 0u32) != 0u8 { return 3; }
    let Borrow: bytes = Operation(191u32, 0u32, 1u32, 0u32, 0u32);
    let Owner: Borrows.Borrowˉplan = Plan(Borrow, Empty, 1u32, 2u32, Empty, Zero);
    if !Owner.Valid || Bytesˉreadˉu8(Owner.Temporaryˉstate, 0u32) != 1u8 ||
        Bytesˉreadˉu8(Owner.Frozenˉslots, 1u32) != 1u8 ||
        Bytesˉreadˉu8(Owner.Slotˉstate, 1u32) != 0u8 { return 4; }
    var Chain: bytes = Bytesˉconcat(Borrow, Operation(164u32, 1u32, 0u32, 0u32, 1u32));
    Chain = Bytesˉconcat(Chain, Operation(8u32, 4294967295u32, 2u32, 1u32, 1u32));
    Chain = Bytesˉconcat(Chain, Operation(7u32, 2u32, 2u32, 0u32, 0u32));
    let Operands: bytes = Bytesˉconcat(Operandˉzero, Bytesˉfromˉu32ˉlittle(1u32));
    let Forward: Borrows.Borrowˉplan = Plan(Chain, Operands, 3u32, 3u32, Empty, Borrows.Zeroes(3u32));
    if !Forward.Valid || Bytesˉreadˉu8(Forward.Temporaryˉstate, 1u32) != 3u8 ||
        Bytesˉreadˉu8(Forward.Temporaryˉstate, 2u32) != 2u8 ||
        Bytesˉreadˉu8(Forward.Slotˉstate, 2u32) != 1u8 { return 5; }
    let Field: Borrows.Borrowˉplan = Plan(
        Operation(18u32, 1u32, 0u32, 0u32, 1u32), Operandˉzero,
        2u32, 0u32, Empty, Bytesˉconcat(Two, Zero)
    );
    if !Field.Valid || Bytesˉreadˉu8(Field.Temporaryˉstate, 1u32) != 2u8 { return 6; }
    let Mixed: Borrows.Borrowˉplan = Plan(
        Operation(7u32, 0u32, 1u32, 0u32, 0u32), Empty, 1u32, 2u32, One, Zero
    );
    if !Mixed.Valid || Bytesˉreadˉu8(Mixed.Temporaryˉstate, 0u32) != 0u8 { return 7; }
    let Frozen: Borrows.Borrowˉplan = Plan(
        Bytesˉconcat(Operation(7u32, 1u32, 1u32, 0u32, 0u32), Borrow),
        Empty, 2u32, 2u32, Empty, Borrows.Zeroes(2u32)
    );
    if !Frozen.Valid || Bytesˉreadˉu8(Frozen.Temporaryˉstate, 1u32) != 2u8 { return 8; }
    let Stored: Borrows.Borrowˉplan = Plan(
        Operation(8u32, 4294967295u32, 0u32, 0u32, 1u32), Operandˉzero,
        1u32, 1u32, Empty, Two
    );
    if !Stored.Valid || Bytesˉreadˉu8(Stored.Slotˉstate, 0u32) != 1u8 ||
        Bytesˉreadˉu8(Stored.Temporaryˉstate, 0u32) != 3u8 { return 9; }
    let Maximum: Borrows.Borrowˉplan = Plan(
        Empty, Empty, 4096u32, 4096u32, Empty, Borrows.Zeroes(4096u32)
    );
    if !Maximum.Valid || Bytesˉlength(Maximum.Frozenˉslots) != 4096u32 ||
        Bytesˉreadˉu8(Maximum.Slotˉstate, 4095u32) != 0u8 ||
        Bytesˉlength(Borrows.Zeroes(4097u32)) != 0u32 { return 10; }
    if Isˉvalid(Plan(Empty, Empty, 4097u32, 0u32, Empty, Empty)) ||
        Isˉvalid(Plan(Empty, Empty, 0u32, 4097u32, Empty, Empty)) ||
        Isˉvalid(Plan(Empty, Empty, 0u32, 0u32, One, Empty)) ||
        Isˉvalid(Plan(Empty, Empty, 1u32, 0u32, Empty, Empty)) ||
        Isˉvalid(Plan(Empty, Empty, 0u32, 1u32, Two, Empty)) ||
        Isˉvalid(Plan(Empty, Empty, 1u32, 0u32, Empty, One)) { return 11; }
    if Isˉvalid(Borrows.Build(Borrows.Zeroes(27u32), 0u32, 0u32, 0u32, 1u32, 0u32, 0u32, Empty, Empty, Empty)) {
        return 12;
    }
    if Isˉvalid(Borrows.Build(Empty, 1u32, 0u32, 0u32, 0u32, 0u32, 0u32, Empty, Empty, Empty)) ||
        Isˉvalid(Borrows.Build(Empty, 0u32, 1u32, 0u32, 0u32, 0u32, 0u32, Empty, Empty, Empty)) ||
        Isˉvalid(Borrows.Build(Empty, 0u32, 0u32, 4294967295u32, 0u32, 0u32, 0u32, Empty, Empty, Empty)) {
        return 13;
    }
    if Isˉvalid(Plan(Borrow, Empty, 1u32, 1u32, Empty, Zero)) ||
        Isˉvalid(Plan(Borrow, Empty, 0u32, 2u32, Empty, Empty)) { return 14; }
    if Isˉvalid(Plan(Operation(18u32, 0u32, 0u32, 0u32, 1u32), Bytesˉfromˉu32ˉlittle(1u32),
        1u32, 0u32, Empty, Two)) ||
        Isˉvalid(Plan(Operation(8u32, 4294967295u32, 1u32, 0u32, 1u32), Operandˉzero,
        1u32, 1u32, Empty, Two)) { return 15; }
    if Isˉvalid(Plan(Operation(18u32, 0u32, 0u32, 4294967295u32, 1u32), Operandˉzero,
        1u32, 0u32, Empty, Two)) { return 16; }
    let Readˉmask: bytes = Bytesˉconcat(Bytesˉconcat(Zero, One), Zero);
    let Readˉchain: Borrows.Borrowˉplan = Borrows.Build(
        Bytesˉconcat(Chain, Operands), 0u32, Bytesˉlength(Chain), 0u32,
        4u32, 3u32, 3u32, Empty, Borrows.Zeroes(3u32), Readˉmask
    );
    if !Readˉchain.Valid || !Readˉchain.Hasˉborrow ||
        Bytesˉreadˉu8(Readˉchain.Temporaryˉstate, 1u32) != 0u8 ||
        Bytesˉreadˉu8(Readˉchain.Temporaryˉstate, 2u32) != 0u8 ||
        Bytesˉreadˉu8(Readˉchain.Slotˉstate, 2u32) != 0u8 ||
        Bytesˉreadˉu8(Readˉchain.Frozenˉslots, 1u32) != 1u8 { return 17; }
    let Readˉcall: Borrows.Borrowˉplan = Borrows.Build(
        Bytesˉconcat(Chain, Operands), 0u32, Bytesˉlength(Chain), 0u32,
        4u32, 3u32, 3u32, Empty, Bytesˉconcat(Borrows.Zeroes(2u32), Two), Readˉmask
    );
    if !Readˉcall.Valid || Bytesˉreadˉu8(Readˉcall.Slotˉstate, 2u32) != 0u8 ||
        Bytesˉreadˉu8(Readˉcall.Temporaryˉstate, 2u32) != 2u8 { return 18; }
    if Isˉvalid(Borrows.Build(Empty, 0u32, 0u32, 0u32, 0u32, 1u32, 0u32,
            Empty, Zero, Empty)) ||
        Isˉvalid(Borrows.Build(Empty, 0u32, 0u32, 0u32, 0u32, 1u32, 0u32,
            Empty, Zero, Bytesˉconcat(Zero, Zero))) { return 19; }
    if Isˉvalid(Borrows.Build(Empty, 0u32, 0u32, 0u32, 0u32, 1u32, 0u32,
            Empty, Zero, Two)) { return 20; }
    let Indexed: bytes = Operation(192u32, 1u32, 0u32, 0u32, 1u32);
    let Element: Borrows.Borrowˉplan = Plan(
        Indexed, Operandˉzero, 2u32, 1u32, Empty, Borrows.Zeroes(2u32)
    );
    if !Element.Valid || !Element.Hasˉborrow ||
        Bytesˉreadˉu8(Element.Frozenˉslots, 0u32) != 1u8 ||
        Bytesˉreadˉu8(Element.Temporaryˉstate, 1u32) != 2u8 ||
        Bytesˉreadˉu8(Element.Slotˉstate, 0u32) != 0u8 { return 21; }
    let Indexedˉchain: bytes = Bytesˉconcat(
        Bytesˉconcat(Indexed, Operation(8u32, 4294967295u32, 1u32, 1u32, 1u32)),
        Operation(7u32, 2u32, 1u32, 0u32, 0u32)
    );
    let Elementˉlocal: Borrows.Borrowˉplan = Plan(
        Indexedˉchain, Operands, 3u32, 2u32, Empty, Borrows.Zeroes(3u32)
    );
    if !Elementˉlocal.Valid ||
        Bytesˉreadˉu8(Elementˉlocal.Slotˉstate, 1u32) != 1u8 ||
        Bytesˉreadˉu8(Elementˉlocal.Temporaryˉstate, 1u32) != 3u8 ||
        Bytesˉreadˉu8(Elementˉlocal.Temporaryˉstate, 2u32) != 2u8 { return 22; }
    if Isˉvalid(Plan(Indexed, Empty, 2u32, 1u32, Empty, Borrows.Zeroes(2u32))) ||
        Isˉvalid(Plan(Indexed, Operandˉzero, 2u32, 0u32, Empty, Borrows.Zeroes(2u32))) ||
        Isˉvalid(Plan(Indexed, Operandˉzero, 1u32, 1u32, Empty, Zero)) ||
        Isˉvalid(Plan(Indexed, Bytesˉfromˉu32ˉlittle(2u32), 2u32, 1u32, Empty, Borrows.Zeroes(2u32))) {
        return 23;
    }
    if Isˉvalid(Plan(Operation(192u32, 1u32, 0u32, 0u32, 0u32),
            Operandˉzero, 2u32, 1u32, Empty, Borrows.Zeroes(2u32))) ||
        Isˉvalid(Plan(Operation(192u32, 1u32, 0u32, 0u32, 2u32),
            Operands, 2u32, 1u32, Empty, Borrows.Zeroes(2u32))) ||
        Isˉvalid(Plan(Operation(192u32, 1u32, 0u32, 4294967295u32, 1u32),
            Operandˉzero, 2u32, 1u32, Empty, Borrows.Zeroes(2u32))) { return 24; }
    let Copiedˉelement: Borrows.Borrowˉplan = Borrows.Build(
        Bytesˉconcat(Indexedˉchain, Operands), 0u32, Bytesˉlength(Indexedˉchain),
        0u32, 3u32, 3u32, 2u32, Empty, Borrows.Zeroes(3u32), Readˉmask
    );
    if !Copiedˉelement.Valid || !Copiedˉelement.Hasˉborrow ||
        Bytesˉreadˉu8(Copiedˉelement.Temporaryˉstate, 1u32) != 0u8 ||
        Bytesˉreadˉu8(Copiedˉelement.Temporaryˉstate, 2u32) != 0u8 ||
        Bytesˉreadˉu8(Copiedˉelement.Slotˉstate, 1u32) != 0u8 ||
        Bytesˉreadˉu8(Copiedˉelement.Frozenˉslots, 0u32) != 1u8 { return 25; }
    let Orderedˉoperations: bytes = Bytesˉconcat(
        Bytesˉconcat(Operation(7u32, 0u32, 0u32, 0u32, 0u32), Indexed),
        Operation(7u32, 2u32, 0u32, 0u32, 0u32)
    );
    let Ordered: Borrows.Borrowˉplan = Plan(
        Orderedˉoperations, Operandˉzero, 3u32, 1u32, Empty, Borrows.Zeroes(3u32)
    );
    if !Ordered.Valid || Bytesˉreadˉu8(Ordered.Temporaryˉstate, 0u32) != 0u8 ||
        Bytesˉreadˉu8(Ordered.Temporaryˉstate, 1u32) != 2u8 ||
        Bytesˉreadˉu8(Ordered.Temporaryˉstate, 2u32) != 0u8 ||
        Bytesˉreadˉu8(Ordered.Frozenˉslots, 0u32) != 1u8 { return 26; }
    let Borrowedˉelement: Borrows.Borrowˉplan = Borrows.Build(
        Bytesˉconcat(Indexed, Operandˉzero), 0u32, Bytesˉlength(Indexed),
        0u32, 1u32, 2u32, 1u32, Empty, Bytesˉconcat(Zero, Two), Bytesˉconcat(Zero, One)
    );
    if !Borrowedˉelement.Valid ||
        Bytesˉreadˉu8(Borrowedˉelement.Temporaryˉstate, 1u32) != 2u8 ||
        Bytesˉreadˉu8(Borrowedˉelement.Frozenˉslots, 0u32) != 1u8 { return 27; }
    var Expressions: bytes = Operation(18u32, 1u32, 0u32, 0u32, 1u32);
    Expressions = Bytesˉconcat(Expressions, Operation(2u32, 2u32, 0u32, 0u32, 0u32));
    Expressions = Bytesˉconcat(Expressions, Operation(62u32, 3u32, 0u32, 0u32, 0u32));
    let Expressionˉwir: bytes = Bytesˉconcat(Expressions, Operandˉzero);
    let Expressionˉstates: bytes = Bytesˉconcat(Zero, Bytesˉconcat(Two, Bytesˉconcat(Two, Two)));
    let Expressionˉplan: Borrows.Borrowˉplan = Plan(
        Expressions, Operandˉzero, 4u32, 0u32, Empty, Expressionˉstates);
    let Expressionˉowners: Borrows.Ownerˉplan = Borrows.Buildˉowners(
        Expressionˉwir, 0u32, Bytesˉlength(Expressions), 0u32, 3u32, 4u32,
        Expressionˉplan, Borrows.Zeroes(4u32), Bytesˉconcat(Zero, Bytesˉconcat(One, Bytesˉconcat(One, One))));
    if !Expressionˉowners.Valid || Expressionˉowners.Count != 3u32 ||
        Borrows.Ownerˉslot(Expressionˉowners, 0u32) != 0u32 ||
        Borrows.Ownerˉslot(Expressionˉowners, 1u32) != 1u32 ||
        Borrows.Ownerˉslot(Expressionˉowners, 2u32) != 2u32 ||
        Borrows.Ownerˉslot(Expressionˉowners, 3u32) != 3u32 ||
        Borrows.Ownerˉslot(Expressionˉowners, 4u32) != 0u32 ||
        Bytesˉreadˉu32ˉlittle(Expressionˉowners.Temporaries, 0u32) != 1u32 ||
        Bytesˉreadˉu32ˉlittle(Expressionˉowners.Temporaries, 8u32) != 3u32 { return 28; }
    let Namedˉwir: bytes = Operation(7u32, 0u32, 0u32, 0u32, 0u32);
    let Namedˉowners: Borrows.Ownerˉplan = Borrows.Buildˉowners(
        Namedˉwir, 0u32, Bytesˉlength(Namedˉwir), 0u32, 1u32, 1u32,
        Plan(Namedˉwir, Empty, 1u32, 1u32, Empty, Two), Zero, One);
    let Fieldˉwir: bytes = Bytesˉconcat(
        Bytesˉconcat(Namedˉwir, Operation(18u32, 1u32, 0u32, 0u32, 1u32)), Operandˉzero);
    let Fieldˉowners: Borrows.Ownerˉplan = Borrows.Buildˉowners(
        Fieldˉwir, 0u32, 56u32, 0u32, 2u32, 2u32,
        Borrows.Borrowˉplan(true, true, Bytesˉconcat(Two, Two), One, Zero),
        Borrows.Zeroes(2u32), Bytesˉconcat(One, One));
    if !Namedˉowners.Valid || Namedˉowners.Count != 0u32 ||
        !Fieldˉowners.Valid || Fieldˉowners.Count != 0u32 { return 29; }
    let Returnedˉwir: bytes = Operation(62u32, 0u32, 0u32, 0u32, 0u32);
    let Returnedˉowners: Borrows.Ownerˉplan = Borrows.Buildˉowners(
        Returnedˉwir, 0u32, 28u32, 0u32, 1u32, 1u32,
        Borrows.Borrowˉplan(true, true, Two, Empty, Empty), One, Zero);
    if !Returnedˉowners.Valid || Returnedˉowners.Count != 0u32 ||
        Ownerˉisˉvalid(Borrows.Buildˉowners(Returnedˉwir, 0u32, 28u32, 0u32, 1u32, 1u32,
            Borrows.Borrowˉplan(true, true, Two, Empty, Empty), Zero, Zero)) { return 30; }
    let Lastˉwir: bytes = Operation(2u32, 4095u32, 0u32, 0u32, 0u32);
    let Lastˉowners: Borrows.Ownerˉplan = Borrows.Buildˉowners(
        Lastˉwir, 0u32, 28u32, 0u32, 1u32, 4096u32,
        Borrows.Borrowˉplan(true, true, Borrows.Setˉstate(Borrows.Zeroes(4096u32), 4095u32, 2u8), Empty, Empty),
        Borrows.Zeroes(4096u32), Borrows.Setˉstate(Borrows.Zeroes(4096u32), 4095u32, 1u8));
    if !Lastˉowners.Valid || Lastˉowners.Count != 1u32 ||
        Bytesˉlength(Lastˉowners.Mapping) != 16384u32 ||
        Borrows.Ownerˉslot(Lastˉowners, 4094u32) != 0u32 ||
        Borrows.Ownerˉslot(Lastˉowners, 4095u32) != 1u32 ||
        Bytesˉreadˉu32ˉlittle(Lastˉowners.Temporaries, 0u32) != 4095u32 { return 31; }
    if Ownerˉisˉvalid(Borrows.Buildˉowners(Expressionˉwir, 0u32, Bytesˉlength(Expressions), 0u32, 3u32, 4097u32,
            Expressionˉplan, Empty, Empty)) ||
        Ownerˉisˉvalid(Borrows.Buildˉowners(Returnedˉwir, 0u32, 28u32, 0u32, 1u32, 1u32,
            Borrows.Borrowˉplan(true, true, Two, Empty, Empty), Empty, One)) ||
        Ownerˉisˉvalid(Borrows.Buildˉowners(Returnedˉwir, 0u32, 28u32, 0u32, 1u32, 1u32,
            Borrows.Borrowˉplan(true, true, Two, Empty, Empty), Zero, Two)) ||
        Ownerˉisˉvalid(Borrows.Buildˉowners(Returnedˉwir, 0u32, 28u32, 1u32, 1u32, 1u32,
            Borrows.Borrowˉplan(true, true, Two, Empty, Empty), Zero, One)) { return 32; }
    return 42;
}
