module Languageˉoneˉvectorˉfreezeˉwrongˉborrow;
profile core;
platform linux, windows, windvale;
authority application;

import Foundationˉcollections as Collections;

fn Acquire() -> Collections.Vector<i32> {
    return Acquire();
}

export fn Freeze() -> Collections.Sequence<i32> {
    let Values: Collections.Vector<i32> = Acquire();
    return Collections.Vectorˉfreeze(borrow Values);
}

export fn Main() -> i32 {
    return 42;
