module Languageˉoneˉgenericˉnominalˉmainˉpipeline profile portable;

record Point {
    X: i32;
}

record Box<T> {
    Value: T;
}

fn Identity(Value: Box<Point>) -> Box<Point> {
    return Value;
}

export fn Main() -> i32 {
    let Wrapped: Box<Point> = Identity(Box<Point> {
        Value: Point { X: 42 },
    });
    return Wrapped.Value.X;
}
