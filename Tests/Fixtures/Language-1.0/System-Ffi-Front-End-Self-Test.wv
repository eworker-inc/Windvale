}

fn Caseˉwvtdˉreserved() -> bool {
    let Canonical: bytes = Wvtdˉcanonicalˉbytes();
    let Value: bytes = Wvtdˉreplaceˉu32(Canonical, 60u32, 1u32);
    let Rejected: Target.Compilerˉsourceˉtargetˉwvtdˉresult =
        Target.Compilerˉsourceˉtargetˉwvtdˉvalidate(Value);
    return Rejected.Status == Target.COMPILER_SOURCE_TARGET_STATUS_WVTD_INVALID_RESERVED &&
