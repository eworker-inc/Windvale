    let Canonical: bytes = Wvtdˉcanonicalˉbytes();
    let Value: bytes = Wvtdˉreplaceˉu32(Canonical, 44u32, 33u32);
    let Rejected: Target.Compilerˉsourceˉtargetˉwvtdˉresult =
        Target.Compilerˉsourceˉtargetˉwvtdˉvalidate(Value);
    return Rejected.Status == Target.COMPILER_SOURCE_TARGET_STATUS_WVTD_INVALID_COUNT &&
        Rejected.Failureˉoffset == 44u32;
}

fn Caseˉwvtdˉextensionˉoffset() -> bool {
    var Value: bytes = Wvtdˉcanonicalˉbytes();
    Value = Wvtdˉreplaceˉu32(Value, 8u32, 68u32);
    Value = Wvtdˉreplaceˉu32(Value, 40u32, 1u32);
    Value = Wvtdˉreplaceˉu32(Value, 48u32, 64u32);
    Value = Wvtdˉappendˉu32(Value, 1u32);
    Value = Wvtdˉreplaceˉu32(Value, 48u32, 68u32);
    let Rejected: Target.Compilerˉsourceˉtargetˉwvtdˉresult =
        Target.Compilerˉsourceˉtargetˉwvtdˉvalidate(Value);
    return Rejected.Status == Target.COMPILER_SOURCE_TARGET_STATUS_WVTD_INVALID_OFFSET &&
        Rejected.Failureˉoffset == 48u32;
}

fn Caseˉwvtdˉinterfaceˉoffset() -> bool {
    var Value: bytes = Wvtdˉcanonicalˉbytes();
    Value = Wvtdˉreplaceˉu32(Value, 8u32, 68u32);
    Value = Wvtdˉreplaceˉu32(Value, 44u32, 1u32);
    Value = Wvtdˉreplaceˉu32(Value, 52u32, 64u32);
    Value = Wvtdˉappendˉu32(Value, 1u32);
    Value = Wvtdˉreplaceˉu32(Value, 52u32, 68u32);
    let Rejected: Target.Compilerˉsourceˉtargetˉwvtdˉresult =
        Target.Compilerˉsourceˉtargetˉwvtdˉvalidate(Value);
    return Rejected.Status == Target.COMPILER_SOURCE_TARGET_STATUS_WVTD_INVALID_OFFSET &&
        Rejected.Failureˉoffset == 52u32;
}

fn Caseˉwvtdˉdirectoryˉorder() -> bool {
    var Value: bytes = Wvtdˉcanonicalˉbytes();
    Value = Wvtdˉreplaceˉu32(Value, 8u32, 72u32);
    Value = Wvtdˉreplaceˉu32(Value, 40u32, 2u32);
    Value = Wvtdˉreplaceˉu32(Value, 48u32, 64u32);
    Value = Wvtdˉappendˉu32(Value, 1u32);
    Value = Wvtdˉappendˉu32(Value, 1u32);
    let Rejected: Target.Compilerˉsourceˉtargetˉwvtdˉresult =
        Target.Compilerˉsourceˉtargetˉwvtdˉvalidate(Value);
    return Rejected.Status == Target.COMPILER_SOURCE_TARGET_STATUS_WVTD_INVALID_ORDER &&
        Rejected.Failureˉoffset == 68u32;
}

fn Caseˉwvtdˉboundary() -> bool {
    var Value: bytes = Wvtdˉcanonicalˉbytes();
    Value = Wvtdˉreplaceˉu32(Value, 8u32, 320u32);
    Value = Wvtdˉreplaceˉu32(Value, 40u32, 32u32);
    Value = Wvtdˉreplaceˉu32(Value, 44u32, 32u32);
    Value = Wvtdˉreplaceˉu32(Value, 48u32, 64u32);
    Value = Wvtdˉreplaceˉu32(Value, 52u32, 192u32);
    Value = Bytesˉconcat(Value, Wvtdˉdirectory(32u32));
    Value = Bytesˉconcat(Value, Wvtdˉdirectory(32u32));
    let Structure: Target.Compilerˉsourceˉtargetˉwvtdˉresult =
        Target.Compilerˉsourceˉtargetˉwvtdˉvalidateˉstructure(Value);
    let Semantic: Target.Compilerˉsourceˉtargetˉwvtdˉresult =
        Target.Compilerˉsourceˉtargetˉwvtdˉvalidate(Value);
    return Bytesˉlength(Value) == 320u32 &&
        Structure.Status == Target.COMPILER_SOURCE_TARGET_STATUS_VALID &&
        Bytesˉequal(Structure.Value, Value) &&
        Semantic.Status == Target.COMPILER_SOURCE_TARGET_STATUS_WVTD_UNKNOWN_IDENTITY &&
        Semantic.Failureˉoffset == 64u32;
}

fn Caseˉwvtdˉunknownˉtarget() -> bool {
    let Canonical: bytes = Wvtdˉcanonicalˉbytes();
    let Value: bytes = Wvtdˉreplaceˉu32(Canonical, 12u32, 99u32);
    let Rejected: Target.Compilerˉsourceˉtargetˉwvtdˉresult =
        Target.Compilerˉsourceˉtargetˉwvtdˉvalidate(Value);
    return Rejected.Status == Target.COMPILER_SOURCE_TARGET_STATUS_WVTD_UNKNOWN_IDENTITY &&
        Rejected.Failureˉoffset == 12u32;
}

fn Caseˉwvtdˉunknownˉextension() -> bool {
    var Value: bytes = Wvtdˉcanonicalˉbytes();
    Value = Wvtdˉreplaceˉu32(Value, 8u32, 68u32);
    Value = Wvtdˉreplaceˉu32(Value, 40u32, 1u32);
    Value = Wvtdˉreplaceˉu32(Value, 48u32, 64u32);
    Value = Wvtdˉappendˉu32(Value, 1u32);
    let Rejected: Target.Compilerˉsourceˉtargetˉwvtdˉresult =
        Target.Compilerˉsourceˉtargetˉwvtdˉvalidate(Value);
    return Rejected.Status == Target.COMPILER_SOURCE_TARGET_STATUS_WVTD_UNKNOWN_IDENTITY &&
        Rejected.Failureˉoffset == 64u32;
}

fn Caseˉwvtdˉtargetˉmismatch() -> bool {
    let Canonical: bytes = Wvtdˉcanonicalˉbytes();
    let Value: bytes = Wvtdˉreplaceˉu32(
        Canonical,
        16u32,
        Target.COMPILER_SOURCE_TARGET_ENVIRONMENT_WINDOWS
    );
    let Rejected: Target.Compilerˉsourceˉtargetˉwvtdˉresult =
        Target.Compilerˉsourceˉtargetˉwvtdˉvalidate(Value);
    return Rejected.Status == Target.COMPILER_SOURCE_TARGET_STATUS_WVTD_TARGET_MISMATCH &&
        Rejected.Failureˉoffset == 12u32;
