fn Caseˉtargetˉforgedˉsourceˉslice() -> bool {
    let Source: bytes = Targetˉsystemˉsource(
        "linux.x86_64.sysv_amd64_c_v1"
    );
    let Header: Declarations.Compilerˉsourceˉheader =
        Declarations.Compilerˉparseˉheaderˉvalidated(Source);
    let Platforms: Target.Compilerˉsourceˉtargetˉplatformˉsetˉevidence =
        Targetˉplatforms(8u32, 1u32, 0u32, 47u32, 28u32);
    let Forgedˉvalid: bool = Platforms.Concreteˉsourceˉlength == 28u32 &&
        Platforms.Concreteˉsourceˉoffset <= Header.Nextˉoffset &&
        Platforms.Concreteˉsourceˉlength <=
            Header.Nextˉoffset - Platforms.Concreteˉsourceˉoffset &&
        Lexer.Compilerˉsourceˉspanˉequalsˉtext(
            Source,
            Platforms.Concreteˉsourceˉoffset,
            Platforms.Concreteˉsourceˉlength,
            "linux.x86_64.sysv_amd64_c_v1"
        );
    let Exactˉvalid: bool = Lexer.Compilerˉsourceˉspanˉequalsˉtext(
        Source, 46u32, 28u32, "linux.x86_64.sysv_amd64_c_v1"
    );
    return Exactˉvalid && !Forgedˉvalid;
}

fn Bytesˉequal(Left: bytes, Right: bytes) -> bool {
    if Bytesˉlength(Left) != Bytesˉlength(Right) { return false; }
    var Index: u32 = 0u32;
    while Index < Bytesˉlength(Left) {
        if Bytesˉreadˉu8(Left, Index) != Bytesˉreadˉu8(Right, Index) {
            return false;
        }
        Index = Index + 1u32;
    }
    return true;
}

fn Wvtdˉempty() -> bytes {
    return Textˉtoˉutf8("");
}

fn Wvtdˉreplaceˉu16(Input: bytes, Offset: u32, Value: u32) -> bytes {
    var Output: bytes = Bytesˉslice(Input, 0u32, Offset);
    Output = Bytesˉconcat(Output, Bytesˉfromˉu16ˉlittle(Value));
    return Bytesˉconcat(
        Output,
        Bytesˉslice(Input, Offset + 2u32, Bytesˉlength(Input) - Offset - 2u32)
    );
}

fn Wvtdˉreplaceˉu32(Input: bytes, Offset: u32, Value: u32) -> bytes {
    var Output: bytes = Bytesˉslice(Input, 0u32, Offset);
    Output = Bytesˉconcat(Output, Bytesˉfromˉu32ˉlittle(Value));
    return Bytesˉconcat(
        Output,
        Bytesˉslice(Input, Offset + 4u32, Bytesˉlength(Input) - Offset - 4u32)
    );
}

fn Wvtdˉappendˉu32(Input: bytes, Value: u32) -> bytes {
    return Bytesˉconcat(Input, Bytesˉfromˉu32ˉlittle(Value));
}

fn Wvtdˉappendˉzeroˉbytes(Input: bytes, Count: u32) -> bytes {
    let Zero: bytes = Bytesˉslice(Bytesˉfromˉu32ˉlittle(0u32), 0u32, 1u32);
    var Output: bytes = Input;
    var Index: u32 = 0u32;
    while Index < Count {
        Output = Bytesˉconcat(Output, Zero);
        Index = Index + 1u32;
    }
    return Output;
}

fn Wvtdˉdirectory(Count: u32) -> bytes {
    var Output: bytes = Wvtdˉempty();
    var Identity: u32 = 1u32;
    while Identity <= Count {
        Output = Wvtdˉappendˉu32(Output, Identity);
        Identity = Identity + 1u32;
    }
    return Output;
}

fn Wvtdˉcanonical() -> Target.Compilerˉsourceˉtargetˉwvtdˉresult {
    return Target.Compilerˉsourceˉtargetˉwvtdˉconstruct(
        Target.Compilerˉsourceˉtargetˉlinuxˉx86_64ˉsysvˉamd64ˉcˉv1(),
        Wvtdˉempty(),
        Wvtdˉempty()
    );
}

fn Wvtdˉcanonicalˉbytes() -> bytes {
    let Result: Target.Compilerˉsourceˉtargetˉwvtdˉresult = Wvtdˉcanonical();
    return Result.Value;
}

fn Caseˉwvtdˉregistry() -> bool {
    return Target.COMPILER_SOURCE_TARGET_BUILD_WINDOWS_X86_64_NONE_V1 == 1u32 &&
        Target.COMPILER_SOURCE_TARGET_BUILD_LINUX_X86_64_NONE_V1 == 2u32 &&
        Target.COMPILER_SOURCE_TARGET_BUILD_WINDVALE_X86_64_NONE_V1 == 3u32 &&
        Target.COMPILER_SOURCE_TARGET_BUILD_LINUX_X86_64_SYSV_AMD64_C_V1 == 4u32 &&
        Target.COMPILER_SOURCE_TARGET_ENVIRONMENT_WINDOWS == 1u32 &&
        Target.COMPILER_SOURCE_TARGET_ENVIRONMENT_LINUX == 2u32 &&
        Target.COMPILER_SOURCE_TARGET_ENVIRONMENT_WINDVALE == 3u32 &&
        Target.COMPILER_SOURCE_TARGET_ARCHITECTURE_X86_64 == 1u32 &&
        Target.COMPILER_SOURCE_TARGET_ARCHITECTURE_AARCH64 == 2u32 &&
        Target.COMPILER_SOURCE_TARGET_ABI_NONE == 1u32 &&
        Target.COMPILER_SOURCE_TARGET_ABI_SYSV_AMD64_C_V1 == 2u32 &&
        Target.COMPILER_SOURCE_TARGET_BYTE_ORDER_LITTLE == 1u32 &&
        Target.COMPILER_SOURCE_TARGET_BYTE_ORDER_BIG == 2u32 &&
        Target.COMPILER_SOURCE_TARGET_PLATFORM_PREDICATE_WINDOWS == 1u32 &&
        Target.COMPILER_SOURCE_TARGET_PLATFORM_PREDICATE_LINUX == 2u32 &&
        Target.COMPILER_SOURCE_TARGET_PLATFORM_PREDICATE_WINDVALE == 3u32 &&
        Target.COMPILER_SOURCE_TARGET_PLATFORM_PREDICATE_LINUX_X86_64_SYSV_AMD64_C_V1 == 4u32 &&
        Target.COMPILER_SOURCE_TARGET_PLATFORM_MASK_WINDOWS == 1u32 &&
        Target.COMPILER_SOURCE_TARGET_PLATFORM_MASK_LINUX == 2u32 &&
        Target.COMPILER_SOURCE_TARGET_PLATFORM_MASK_WINDVALE == 4u32 &&
        Target.COMPILER_SOURCE_TARGET_PLATFORM_MASK_LINUX_X86_64_SYSV_AMD64_C_V1 == 8u32;
}

fn Caseˉwvtdˉcanonical() -> bool {
    let Constructed: Target.Compilerˉsourceˉtargetˉwvtdˉresult = Wvtdˉcanonical();
    let Structure: Target.Compilerˉsourceˉtargetˉwvtdˉresult =
        Target.Compilerˉsourceˉtargetˉwvtdˉvalidateˉstructure(Constructed.Value);
    let Validated: Target.Compilerˉsourceˉtargetˉwvtdˉresult =
        Target.Compilerˉsourceˉtargetˉwvtdˉvalidate(Constructed.Value);
    return Constructed.Status == Target.COMPILER_SOURCE_TARGET_STATUS_VALID &&
        Bytesˉlength(Constructed.Value) == 64u32 &&
        Bytesˉreadˉu32ˉlittle(Constructed.Value, 0u32) == 1146377815u32 &&
        Bytesˉreadˉu16ˉlittle(Constructed.Value, 4u32) == 1u32 &&
        Bytesˉreadˉu16ˉlittle(Constructed.Value, 6u32) == 0u32 &&
        Structure.Status == Target.COMPILER_SOURCE_TARGET_STATUS_VALID &&
        Validated.Status == Target.COMPILER_SOURCE_TARGET_STATUS_VALID &&
        Bytesˉequal(Structure.Value, Constructed.Value) &&
        Bytesˉequal(Validated.Value, Constructed.Value);
}

fn Wvtdˉtargetˉconstructs(
    Descriptor: Target.Compilerˉsourceˉtargetˉdescriptor
) -> bool {
    let Constructed: Target.Compilerˉsourceˉtargetˉwvtdˉresult =
        Target.Compilerˉsourceˉtargetˉwvtdˉconstruct(
            Descriptor, Wvtdˉempty(), Wvtdˉempty()
        );
    let Validated: Target.Compilerˉsourceˉtargetˉwvtdˉresult =
        Target.Compilerˉsourceˉtargetˉwvtdˉvalidate(Constructed.Value);
    return Constructed.Status == Target.COMPILER_SOURCE_TARGET_STATUS_VALID &&
        Validated.Status == Target.COMPILER_SOURCE_TARGET_STATUS_VALID;
}

fn Caseˉwvtdˉsupportedˉtargets() -> bool {
    return Wvtdˉtargetˉconstructs(
            Target.Compilerˉsourceˉtargetˉwindowsˉx86_64ˉnoneˉv1()
        ) &&
        Wvtdˉtargetˉconstructs(
            Target.Compilerˉsourceˉtargetˉlinuxˉx86_64ˉnoneˉv1()
        ) &&
        Wvtdˉtargetˉconstructs(
            Target.Compilerˉsourceˉtargetˉwindvaleˉx86_64ˉnoneˉv1()
        ) &&
        Wvtdˉtargetˉconstructs(
            Target.Compilerˉsourceˉtargetˉlinuxˉx86_64ˉsysvˉamd64ˉcˉv1()
        );
}

fn Caseˉwvtdˉtruncated() -> bool {
    let Canonical: bytes = Wvtdˉcanonicalˉbytes();
    let Value: bytes = Bytesˉslice(Canonical, 0u32, 63u32);
    let Rejected: Target.Compilerˉsourceˉtargetˉwvtdˉresult =
        Target.Compilerˉsourceˉtargetˉwvtdˉvalidate(Value);
    return Rejected.Status == Target.COMPILER_SOURCE_TARGET_STATUS_WVTD_INVALID_SIZE &&
        Rejected.Failureˉoffset == 8u32 && Bytesˉlength(Rejected.Value) == 0u32;
}

fn Caseˉwvtdˉoversized() -> bool {
    let Canonical: bytes = Wvtdˉcanonicalˉbytes();
    let Value: bytes = Wvtdˉappendˉzeroˉbytes(Canonical, 257u32);
    let Rejected: Target.Compilerˉsourceˉtargetˉwvtdˉresult =
        Target.Compilerˉsourceˉtargetˉwvtdˉvalidate(Value);
    return Rejected.Status == Target.COMPILER_SOURCE_TARGET_STATUS_WVTD_INVALID_SIZE &&
        Rejected.Failureˉoffset == 8u32;
}

fn Caseˉwvtdˉtrailing() -> bool {
    let Canonical: bytes = Wvtdˉcanonicalˉbytes();
    let Value: bytes = Wvtdˉappendˉzeroˉbytes(Canonical, 1u32);
    let Rejected: Target.Compilerˉsourceˉtargetˉwvtdˉresult =
        Target.Compilerˉsourceˉtargetˉwvtdˉvalidate(Value);
    return Rejected.Status == Target.COMPILER_SOURCE_TARGET_STATUS_WVTD_INVALID_SIZE &&
        Rejected.Failureˉoffset == 8u32;
}

fn Caseˉwvtdˉmagic() -> bool {
    let Canonical: bytes = Wvtdˉcanonicalˉbytes();
    let Value: bytes = Wvtdˉreplaceˉu32(Canonical, 0u32, 0u32);
    let Rejected: Target.Compilerˉsourceˉtargetˉwvtdˉresult =
        Target.Compilerˉsourceˉtargetˉwvtdˉvalidate(Value);
    return Rejected.Status == Target.COMPILER_SOURCE_TARGET_STATUS_WVTD_INVALID_MAGIC &&
        Rejected.Failureˉoffset == 0u32;
}

