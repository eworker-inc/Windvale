fn Caseˉwvtdˉextensionˉcount() -> bool {
    let Canonical: bytes = Wvtdˉcanonicalˉbytes();
    let Value: bytes = Wvtdˉreplaceˉu32(Canonical, 40u32, 33u32);
    let Rejected: Target.Compilerˉsourceˉtargetˉwvtdˉresult =
