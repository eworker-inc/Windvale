fn Caseˉtargetˉgenericˉforeign() -> bool {
    let Descriptor: Target.Compilerˉsourceˉtargetˉdescriptor =
        Target.Compilerˉsourceˉtargetˉlinuxˉx86_64ˉsysvˉamd64ˉcˉv1();
    let Platforms: Target.Compilerˉsourceˉtargetˉplatformˉsetˉevidence =
        Targetˉplatforms(2u32, 1u32, 0u32, 0u32, 0u32);
    let Admission: u32 =
        Target.Compilerˉsourceˉtargetˉadmitˉforeignˉtarget(
            Descriptor.Environment, Descriptor.Architecture, Descriptor.Abi,
            Descriptor.Addressˉbits, Descriptor.Littleˉendian,
            Descriptor.Noˉunwindˉcˉscalarˉpointerˉmajor,
            Descriptor.Extensionˉidentities, Descriptor.Targetˉinterfaceˉidentities,
            Platforms.Scopeˉmask, Platforms.Declaredˉscopes, Platforms.Unknownˉscopes
        );
    return Admission ==
        Target.COMPILER_SOURCE_TARGET_STATUS_FOREIGN_REQUIRES_CONCRETE_PLATFORM;
}

fn Caseˉtargetˉunknownˉplatform() -> bool {
    let Admission: u32 =
        Target.Compilerˉsourceˉtargetˉadmitˉplatforms(
            Target.Compilerˉsourceˉtargetˉlinuxˉx86_64ˉsysvˉamd64ˉcˉv1(),
            Targetˉplatforms(8u32, 2u32, 1u32, 0u32, 0u32)
        );
    return Admission == Target.COMPILER_SOURCE_TARGET_STATUS_UNKNOWN_PLATFORM;
}

fn Caseˉtargetˉplatformˉcount() -> bool {
    let Admission: u32 =
        Target.Compilerˉsourceˉtargetˉadmitˉplatforms(
            Target.Compilerˉsourceˉtargetˉlinuxˉx86_64ˉsysvˉamd64ˉcˉv1(),
            Targetˉplatforms(2u32, 2u32, 0u32, 0u32, 0u32)
        );
    return Admission ==
        Target.COMPILER_SOURCE_TARGET_STATUS_INVALID_PLATFORM_EVIDENCE;
}

fn Caseˉtargetˉforgedˉsourceˉslice() -> bool {
    let Source: bytes = Targetˉsystemˉsource(
        "linux.x86_64.sysv_amd64_c_v1"
    );
    let Header: Declarations.Compilerˉsourceˉheader =
        Declarations.Compilerˉparseˉheaderˉvalidated(Source);
    let Platforms: Target.Compilerˉsourceˉtargetˉplatformˉsetˉevidence =
        Targetˉplatforms(8u32, 1u32, 0u32, 47u32, 28u32);
    let Forgedˉvalid: bool = Platforms.Concreteˉsourceˉlength == 28u32 &&
        Platforms.Concreteˉsourceˉoffset <= Header.Nextˉoffset &&
        Platforms.Concreteˉsourceˉlength <=
            Header.Nextˉoffset - Platforms.Concreteˉsourceˉoffset &&
        Lexer.Compilerˉsourceˉspanˉequalsˉtext(
            Source,
            Platforms.Concreteˉsourceˉoffset,
            Platforms.Concreteˉsourceˉlength,
            "linux.x86_64.sysv_amd64_c_v1"
        );
    let Exactˉvalid: bool = Lexer.Compilerˉsourceˉspanˉequalsˉtext(
        Source, 46u32, 28u32, "linux.x86_64.sysv_amd64_c_v1"
    );
    return Exactˉvalid && !Forgedˉvalid;
}

fn Selectedˉcase() -> u32 {
    if process.argument_count() != 1u32 { return 0u32; }
    let Argument: bytes = Textˉtoˉutf8(process.argument(0u32));
    if Bytesˉlength(Argument) != 1u32 { return 0u32; }
    return U32ˉfromˉu8(Bytesˉreadˉu8(Argument, 0u32));
}

export fn Main() -> i32 {
    let Selected: u32 = Selectedˉcase();
    if Selected == 97u32 && Caseˉkeyword() { return 42; }
    if Selected == 98u32 && Caseˉcanonical() { return 42; }
    if Selected == 99u32 && Caseˉevidence() { return 42; }
    if Selected == 100u32 && Caseˉmissingˉunsafe() { return 42; }
    if Selected == 101u32 && Caseˉwrongˉabi() { return 42; }
    if Selected == 102u32 && Caseˉescapedˉabi() { return 42; }
    if Selected == 103u32 && Caseˉwrongˉpointer() { return 42; }
    if Selected == 104u32 && Caseˉwrongˉeffect() { return 42; }
    if Selected == 105u32 && Caseˉwrongˉsymbol() { return 42; }
    if Selected == 106u32 && Caseˉmissingˉsemicolon() { return 42; }
    if Selected == 107u32 && Caseˉprofiles() { return 42; }
    if Selected == 108u32 && Caseˉsystem() { return 42; }
    if Selected == 109u32 && Caseˉtargetˉexact() { return 42; }
    if Selected == 110u32 && Caseˉtargetˉportableˉselection() { return 42; }
    if Selected == 111u32 && Caseˉtargetˉwindowsˉmismatch() { return 42; }
    if Selected == 112u32 && Caseˉtargetˉarchitectureˉmismatch() { return 42; }
    if Selected == 113u32 && Caseˉtargetˉabiˉmismatch() { return 42; }
    if Selected == 114u32 && Caseˉtargetˉaddressˉwidth() { return 42; }
    if Selected == 115u32 && Caseˉtargetˉbyteˉorder() { return 42; }
    if Selected == 116u32 && Caseˉtargetˉnoˉunwindˉcontract() { return 42; }
    if Selected == 117u32 && Caseˉtargetˉgenericˉforeign() { return 42; }
    if Selected == 118u32 && Caseˉtargetˉunknownˉplatform() { return 42; }
    if Selected == 119u32 && Caseˉtargetˉplatformˉcount() { return 42; }
    if Selected == 120u32 && Caseˉtargetˉforgedˉsourceˉslice() { return 42; }
    return 1;
}
