fn Caseˉwvtdˉunknownˉinterface() -> bool {
    var Value: bytes = Wvtdˉcanonicalˉbytes();
    Value = Wvtdˉreplaceˉu32(Value, 8u32, 68u32);
    Value = Wvtdˉreplaceˉu32(Value, 44u32, 1u32);
    Value = Wvtdˉreplaceˉu32(Value, 52u32, 64u32);
    Value = Wvtdˉappendˉu32(Value, 1u32);
    let Rejected: Target.Compilerˉsourceˉtargetˉwvtdˉresult =
        Target.Compilerˉsourceˉtargetˉwvtdˉvalidate(Value);
    return Rejected.Status == Target.COMPILER_SOURCE_TARGET_STATUS_WVTD_UNKNOWN_IDENTITY &&
        Rejected.Failureˉoffset == 64u32;
