#!wv/1 en@1
module ValueˉMatchˉNever;
profile core;
platform linux, windows, windvale;
authority application;

enum Selection {
    Chosen = 0;
    Stopped = 1;
}

fn Stop() -> never {
    while true {
    }
}

export fn Main() -> i32 {
    return match Selection.Chosen {
        case Selection.Chosen { 42 }
        case Selection.Stopped { Stop() }
    };
}
