#!wv/1 en@1
module Languageˉoneˉstructuredˉtaskˉcompletionˉorderˉexecutable;
profile hosted;
platform linux, windows, windvale;
authority application;
requires capability console.write_line version 1;

import Foundationˉmemory as Memory;
import Foundationˉoperation as Operation;
import Foundationˉresult as Result;
import Foundationˉtask as Task;

fn Constructˉscope(
    Budget: Memory.Memoryˉbudget,
    Limits: Task.Taskˉlimits,
    Parentˉcontext: borrow Operation.Operationˉcontext,
) -> Result.Result<Task.Taskˉscope, Task.Taskˉscopeˉfailure>
    effects(memory.allocate, resource.acquire) {
    return Task.Construct(
        Budget: Budget,
        Limits: Limits,
        Parentˉcontext: borrow Parentˉcontext,
    );
}

fn Outcomeˉvalue(Outcome: Task.Taskˉoutcome<i32, u32>) -> i32 {
    return match Outcome {
        case Task.Taskˉoutcome.Valid { Value: Resultˉvalue } { Resultˉvalue }
        case Task.Taskˉoutcome.Failure { Error: _ } { -1 }
        case Task.Taskˉoutcome.Cancelled { -2 }
        case Task.Taskˉoutcome.Deadlineˉreached { -3 }
        case Task.Taskˉoutcome.Runtimeˉlost {
            Expectedˉgeneration: _,
            Observedˉgeneration: _,
        } { -4 }
        case Task.Taskˉoutcome.Runtimeˉrestarted {
            Expectedˉgeneration: _,
            Observedˉgeneration: _,
        } { -5 }
        case Task.Taskˉoutcome.Trapped { Identity: _ } { -6 }
    };
}

fn Completionˉresult(
    First: i32,
    Second: i32,
    Third: i32,
    Fourth: i32,
) -> Result.Result<i32, Task.Taskˉscopeˉfailure> {
    if First == 0 && Second == 1 && Third == 2 && Fourth == 3 {
        return Result.Result.Valid<i32, Task.Taskˉscopeˉfailure> { Value: 42 };
    }
    return Result.Result.Valid<i32, Task.Taskˉscopeˉfailure> { Value: -20 };
}

async fn Run(
    Budget: Memory.Memoryˉbudget,
    Parentˉcontext: borrow Operation.Operationˉcontext,
) -> Result.Result<i32, Task.Taskˉscopeˉfailure> effects(
    console.write_line,
    memory.allocate,
    resource.acquire,
    resource.release,
    task.spawn,
    task.suspend,
) {
    let Limits = Task.Taskˉlimits {
        Maximumˉchildren: 4u32,
        Maximumˉrunnable: 4u32,
        Maximumˉcompleted: 4u32,
        Maximumˉretainedˉbytes: 16384u64,
        Maximumˉworkˉunits: 1024u64,
        Maximumˉcallˉdepth: 16u32,
        Maximumˉtimers: 1u32,
        Maximumˉdiagnostics: 16u32,
    };
    task scope Scope = try Constructˉscope(
        Budget: Budget,
        Limits: Limits,
        Parentˉcontext: borrow Parentˉcontext,
    ) policy cancel_join {
        let Firstˉchildˉvalue: i32 = 0;
        let Firstˉwork: async fn () -> Result.Result<i32, u32> effects(
            console.write_line,
            task.suspend
        ) = async fn [copy Firstˉchildˉvalue] ()
            -> Result.Result<i32, u32> effects(
            console.write_line,
            task.suspend
        ) {
            console.write_line("0");
            return Result.Result.Valid<i32, u32> {
                Value: Firstˉchildˉvalue,
            };
        };
        let Firstˉspawned: Result.Result<
            Task.Task<i32, u32>,
            Task.Spawnˉfailure<
                async fn () -> Result.Result<i32, u32> effects(
                    console.write_line,
                    task.suspend
                )
            >
        > = Task.Spawn(
            Scope: borrow mut Scope,
            Work: Firstˉwork,
        );
        return match Firstˉspawned {
            case Result.Result.Valid { Value: First } {
                let Secondˉchildˉvalue: i32 = 1;
                let Secondˉwork: async fn () -> Result.Result<i32, u32>
                    effects(console.write_line, task.suspend) =
                    async fn [copy Secondˉchildˉvalue] ()
                        -> Result.Result<i32, u32>
                        effects(console.write_line, task.suspend) {
                    console.write_line("1");
                    return Result.Result.Valid<i32, u32> {
                        Value: Secondˉchildˉvalue,
                    };
                };
                let Secondˉspawned: Result.Result<
                    Task.Task<i32, u32>,
                    Task.Spawnˉfailure<
                        async fn () -> Result.Result<i32, u32> effects(
                            console.write_line,
                            task.suspend
                        )
                    >
                > = Task.Spawn(
                    Scope: borrow mut Scope,
                    Work: Secondˉwork,
                );
                match Secondˉspawned {
                    case Result.Result.Valid { Value: Second } {
                        let Thirdˉchildˉvalue: i32 = 2;
                        let Thirdˉwork: async fn ()
                            -> Result.Result<i32, u32>
                            effects(console.write_line, task.suspend) =
                            async fn [copy Thirdˉchildˉvalue] ()
                                -> Result.Result<i32, u32>
                                effects(console.write_line, task.suspend) {
                            console.write_line("2");
                            return Result.Result.Valid<i32, u32> {
                                Value: Thirdˉchildˉvalue,
                            };
                        };
                        let Thirdˉspawned: Result.Result<
                            Task.Task<i32, u32>,
                            Task.Spawnˉfailure<
                                async fn () -> Result.Result<i32, u32> effects(
                                    console.write_line,
                                    task.suspend
                                )
                            >
                        > = Task.Spawn(
                            Scope: borrow mut Scope,
                            Work: Thirdˉwork,
                        );
                        match Thirdˉspawned {
                            case Result.Result.Valid { Value: Third } {
                                let Fourthˉchildˉvalue: i32 = 3;
                                let Fourthˉwork: async fn ()
                                    -> Result.Result<i32, u32>
                                    effects(
                                        console.write_line,
                                        task.suspend
                                    ) = async fn [copy Fourthˉchildˉvalue] ()
                                        -> Result.Result<i32, u32>
                                        effects(
                                            console.write_line,
                                            task.suspend
                                        ) {
                                    console.write_line("3");
                                    return Result.Result.Valid<i32, u32> {
                                        Value: Fourthˉchildˉvalue,
                                    };
                                };
                                let Fourthˉspawned: Result.Result<
                                    Task.Task<i32, u32>,
                                    Task.Spawnˉfailure<
                                        async fn () -> Result.Result<i32, u32>
                                            effects(
                                                console.write_line,
                                                task.suspend
                                            )
                                    >
                                > = Task.Spawn(
                                    Scope: borrow mut Scope,
                                    Work: Fourthˉwork,
                                );
                                match Fourthˉspawned {
                                    case Result.Result.Valid {
                                        Value: Fourth,
                                    } {
                                        let Firstˉvalue = Outcomeˉvalue(
                                            Outcome: await Task.Await(
                                                Handle: First,
                                            ),
                                        );
                                        let Secondˉvalue = Outcomeˉvalue(
                                            Outcome: await Task.Await(
                                                Handle: Second,
                                            ),
                                        );
                                        let Thirdˉvalue = Outcomeˉvalue(
                                            Outcome: await Task.Await(
                                                Handle: Third,
                                            ),
                                        );
                                        let Fourthˉvalue = Outcomeˉvalue(
                                            Outcome: await Task.Await(
                                                Handle: Fourth,
                                            ),
                                        );
                                        Completionˉresult(
                                            First: Firstˉvalue,
                                            Second: Secondˉvalue,
                                            Third: Thirdˉvalue,
                                            Fourth: Fourthˉvalue,
                                        )
                                    }
                                    case Result.Result.Failure {
                                        Error: Fourthˉerror,
                                    } {
                                        match Fourthˉerror {
                                            case Task.Spawnˉfailure.Scopeˉclosing {
                                                Work: _,
                                            } { }
                                            case Task.Spawnˉfailure.Taskˉlimit {
                                                Work: _,
                                            } { }
                                            case Task.Spawnˉfailure.Queueˉlimit {
                                                Work: _,
                                            } { }
                                            case Task.Spawnˉfailure.Memoryˉfailure {
                                                Error: _,
                                                Work: _,
                                            } { }
                                        }
                                        Result.Result.Valid<
                                            i32,
                                            Task.Taskˉscopeˉfailure
                                        > { Value: -13 }
                                    }
                                }
                            }
                            case Result.Result.Failure { Error: Thirdˉerror } {
                                match Thirdˉerror {
                                    case Task.Spawnˉfailure.Scopeˉclosing {
                                        Work: _,
                                    } { }
                                    case Task.Spawnˉfailure.Taskˉlimit {
                                        Work: _,
                                    } { }
                                    case Task.Spawnˉfailure.Queueˉlimit {
                                        Work: _,
                                    } { }
                                    case Task.Spawnˉfailure.Memoryˉfailure {
                                        Error: _,
                                        Work: _,
                                    } { }
                                }
                                Result.Result.Valid<
                                    i32,
                                    Task.Taskˉscopeˉfailure
                                > { Value: -12 }
                            }
                        }
                    }
                    case Result.Result.Failure { Error: Secondˉerror } {
                        match Secondˉerror {
                            case Task.Spawnˉfailure.Scopeˉclosing {
                                Work: _,
                            } { }
                            case Task.Spawnˉfailure.Taskˉlimit {
                                Work: _,
                            } { }
                            case Task.Spawnˉfailure.Queueˉlimit {
                                Work: _,
                            } { }
                            case Task.Spawnˉfailure.Memoryˉfailure {
                                Error: _,
                                Work: _,
                            } { }
                        }
                        Result.Result.Valid<i32, Task.Taskˉscopeˉfailure> {
                            Value: -11,
                        }
                    }
                }
            }
            case Result.Result.Failure { Error: Firstˉerror } {
                match Firstˉerror {
                    case Task.Spawnˉfailure.Scopeˉclosing { Work: _ } { }
                    case Task.Spawnˉfailure.Taskˉlimit { Work: _ } { }
                    case Task.Spawnˉfailure.Queueˉlimit { Work: _ } { }
                    case Task.Spawnˉfailure.Memoryˉfailure {
                        Error: _,
                        Work: _,
                    } { }
                }
                Result.Result.Valid<i32, Task.Taskˉscopeˉfailure> {
                    Value: -10,
                }
            }
        };
    }
}

export async fn Main(
    Budget: Memory.Memoryˉbudget,
    Parentˉcontext: borrow Operation.Operationˉcontext,
) -> i32 effects(
    console.write_line,
    memory.allocate,
    resource.acquire,
    resource.release,
    task.spawn,
    task.suspend,
) {
    return match await Run(
        Budget: Budget,
        Parentˉcontext: borrow Parentˉcontext,
    ) {
        case Result.Result.Valid { Value: Value } { Value }
        case Result.Result.Failure { Error: _ } { -1 }
    };
}
