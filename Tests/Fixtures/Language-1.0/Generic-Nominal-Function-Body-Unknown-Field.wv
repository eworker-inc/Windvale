module Languageˉoneˉgenericˉnominalˉfunctionˉbodyˉunknownˉfield profile portable;

record Point {
    X: i32;
}

record Box<T> {
    Value: T;
}

fn Read<T>(Value: Box<T>) -> T {
    return Value.Missing;
}

export fn Main() -> i32 {
    let Wrapped: Box<Point> = Box<Point> { Value: Point { X: 42 } };
    let Value: Point = Read(Wrapped);
    return Value.X;
}
