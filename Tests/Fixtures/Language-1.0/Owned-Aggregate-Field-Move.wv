#!wv/1 en@1
module Languageˉoneˉownedˉaggregateˉfieldˉmove;
profile core;
platform linux, windows, windvale;
authority application;

import Foundationˉcollections as Collections;
import Foundationˉmemory as Memory;
import Foundationˉresult as Resultˉvalues;

record Workˉqueue<T> {
    Values: T;
    Marker: i32;
}

fn Consume<T>(Value: T) -> i32 { return 42; }

fn Exercise<T>(Values: T) -> i32 {
    let State: Workˉqueue<T> = Workˉqueue<T> {
        Values: Values, Marker: 41
    };
    return Consume(State.Values);
}

export fn Main(Budget: Memory.Memoryˉbudget) -> i32 {
    let Outcome: Resultˉvalues.Result<
        Collections.Vector<i32>,
        Memory.Allocationˉfailure
    > = Collections.Vectorˉconstructˉreserved::<i32>(Budget, 1u64);
    return match Outcome {
        case Resultˉvalues.Result.Valid { Value: Values } {
            Exercise(Values)
        }
        case Resultˉvalues.Result.Failure { Error: Failure } { 4 }
    };
}
