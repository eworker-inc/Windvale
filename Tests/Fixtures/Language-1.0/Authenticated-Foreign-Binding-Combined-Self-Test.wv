#!wv/1 en@1
module Languageˉoneˉauthenticatedˉforeignˉbindingˉcombinedˉselfˉtest;
profile hosted;
platform linux, windows;
authority application;
requires capability process.argument version 1;
requires capability process.argument_count version 1;

import Languageˉoneˉauthenticatedˉforeignˉbindingˉselfˉtest as Core;
import Languageˉoneˉforeignˉloweringˉpairingˉselfˉtest as Pairing;
import Languageˉoneˉauthenticatedˉforeignˉbindingˉportableˉselfˉtest as Portable;
import Languageˉoneˉtypedˉforeignˉcallˉwirˉvalidationˉselfˉtest as Validation;


fn Selectedˉcase() -> u32 {
    if process.argument_count() != 1u32 { return 0u32; }
    let Argument: bytes = Textˉtoˉutf8(process.argument(0u32));
    if Bytesˉlength(Argument) != 1u32 { return 0u32; }
    return U32ˉfromˉu8(Bytesˉreadˉu8(Argument, 0u32));
}

export fn Main() -> i32 {
    let Selected: u32 = Selectedˉcase();
    if Selected == 65u32 { return Pairing.Main(); }
    if Selected == 122u32 {
        return Validation.Languageˉoneˉtypedˉforeignˉcallˉwirˉvalidationˉcase();
    }
    if Core.Languageˉoneˉauthenticatedˉforeignˉbindingˉcase(Selected) ||
        Portable.Languageˉoneˉauthenticatedˉforeignˉbindingˉportableˉcase(
            Selected
        ) {
        return 42;
    }
    return 1;
}
