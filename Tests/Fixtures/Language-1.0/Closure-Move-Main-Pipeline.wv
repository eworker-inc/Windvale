#!wv/1 en@1
module Languageˉoneˉclosureˉmoveˉmainˉpipeline;
profile core;
platform linux, windows, windvale;
authority application;

export fn Main() -> i32 effects() {
    let Local: i32 = 40;
    let Callback = fn [move Local] (Delta: i32) -> i32 effects() {
        return Local + Delta;
    };
    return Callback(2);
}
