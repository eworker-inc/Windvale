export fn Main() -> i32 {
    let Selected: u32 = Selectedˉcase();
    if Selected == 97u32 {
        let Wvssˉcoverage: i32 = Wvssˉstructureˉcoverage();
        if Wvssˉcoverage != 0 { return Wvssˉcoverage; }
    }
    let Wvssˉstructure: Admissionˉsourceˉset.Compilerˉadmissionˉsourceˉsetˉresult =
        Admissionˉsourceˉset.Compilerˉvalidateˉadmittedˉsourceˉsetˉstructure(Wvss());
    if Wvssˉstructure.Status !=
        Admissionˉsourceˉset.Compilerˉadmissionˉsourceˉsetˉstatus.Valid ||
        Wvssˉstructure.Modules != 1u32 ||
        Wvssˉstructure.Failureˉoffset != 0u32 ||
        !Bytesˉequal(Wvssˉstructure.Value, Wvss()) {
        return 45;
    }
    let Noncanonicalˉwvss: Admissionˉsourceˉset.Compilerˉadmissionˉsourceˉsetˉresult =
        Admissionˉsourceˉset.Compilerˉvalidateˉadmittedˉsourceˉsetˉstructure(
            Patchˉu32(Wvss(), 16u32, 37u32)
        );
    if Noncanonicalˉwvss.Status !=
        Admissionˉsourceˉset.Compilerˉadmissionˉsourceˉsetˉstatus.Noncanonicalˉlayout ||
        Noncanonicalˉwvss.Failureˉoffset != 16u32 ||
        Bytesˉlength(Noncanonicalˉwvss.Value) != 0u32 {
        return 46;
    }
    if !Evidence.Compilerˉadmissionˉevidenceˉretainedˉtotalˉisˉbounded(
        224u32, 4194304u32, 320u32, 4194304u32, 1048576u32, 65536u32
    ) || Evidence.Compilerˉadmissionˉevidenceˉretainedˉtotalˉisˉbounded(
        225u32, 4194304u32, 320u32, 4194304u32, 1048576u32, 65536u32
    ) {
        return 49;
    }
    if !Evidence.Compilerˉadmissionˉevidenceˉretainedˉadditionˉisˉbounded(
        5308960u32, 4194304u32
    ) || Evidence.Compilerˉadmissionˉevidenceˉretainedˉadditionˉisˉbounded(
        5308961u32, 4194304u32
    ) {
        return 50;
    }
    let Constructed: Evidence.Compilerˉadmissionˉevidenceˉresult = Construct();
    if Constructed.Status != Evidence.Compilerˉadmissionˉevidenceˉstatus.Valid ||
        Bytesˉlength(Constructed.Value) != 224u32 {
        return 1;
    }
    var Result: i32 = Shapeˉcases(Selected, Constructed.Value);
    if Result != 0 { return Result; }
    Result = Fieldˉcases(Selected, Constructed.Value);
    if Result != 0 { return Result; }
    Result = Digestˉcases(Selected, Constructed.Value);
    if Result != 0 { return Result; }
    Result = Constructionˉcases(Selected, Constructed.Value);
    if Result != 0 { return Result; }
    Result = Geometryˉcasesˉfirst(Selected);
    if Result != 0 { return Result; }
    Result = Geometryˉcasesˉsecond(Selected, Constructed.Value);
    if Result != 0 { return Result; }
    return 64;
}
