module Languageˉoneˉadmissionˉevidenceˉselfˉtest profile hosted;

import Compilerˉadmissionˉevidence as Evidence;
import Compilerˉadmissionˉevidenceˉvalidator as Validator;
import Compilerˉadmissionˉsourceˉset as Admissionˉsourceˉset;
import Compilerˉsourceˉdescriptor as Sourceˉdescriptor;
import Compilerˉsourceˉforeignˉcatalog as Foreignˉcatalog;
import Compilerˉsourceˉtarget as Target;

capability process.argument;
capability process.argument_count;

fn Empty(Input: bytes) -> bytes {
    return Bytesˉslice(Input, 0u32, 0u32);
}

fn Bytesˉequal(Left: bytes, Right: bytes) -> bool {
    let Length: u32 = Bytesˉlength(Left);
    if Length != Bytesˉlength(Right) { return false; }
    var Index: u32 = 0u32;
    while Index < Length {
        if Bytesˉreadˉu8(Left, Index) != Bytesˉreadˉu8(Right, Index) {
            return false;
        }
        Index = Index + 1u32;
    }
    return true;
}

fn Patch(Input: bytes, Offset: u32, Replacement: bytes) -> bytes {
    return Bytesˉconcat(
        Bytesˉconcat(Bytesˉslice(Input, 0u32, Offset), Replacement),
        Bytesˉslice(
            Input,
            Offset + Bytesˉlength(Replacement),
            Bytesˉlength(Input) - Offset - Bytesˉlength(Replacement)
        )
    );
}

fn Patchˉu32(Input: bytes, Offset: u32, Value: u32) -> bytes {
    return Patch(Input, Offset, Bytesˉfromˉu32ˉlittle(Value));
}

fn Corruptˉbyte(Input: bytes, Offset: u32) -> bytes {
    var Value: u8 = 0u8;
    if Bytesˉreadˉu8(Input, Offset) == 0u8 { Value = 1u8; }
    return Patch(Input, Offset, Bytesˉfromˉu8(Value));
}

fn Wvss() -> bytes {
    var Value: bytes = Textˉtoˉutf8("WVSS");
    Value = Bytesˉconcat(Value, Bytesˉfromˉu16ˉlittle(2u32));
    Value = Bytesˉconcat(Value, Bytesˉfromˉu16ˉlittle(0u32));
    Value = Bytesˉconcat(Value, Bytesˉfromˉu32ˉlittle(1u32));
    Value = Bytesˉconcat(Value, Bytesˉfromˉu32ˉlittle(20u32));
    Value = Bytesˉconcat(Value, Bytesˉfromˉu32ˉlittle(36u32));
    Value = Bytesˉconcat(Value, Bytesˉfromˉu32ˉlittle(1u32));
    Value = Bytesˉconcat(Value, Bytesˉfromˉu32ˉlittle(1u32));
    Value = Bytesˉconcat(Value, Bytesˉfromˉu32ˉlittle(1u32));
    Value = Bytesˉconcat(Value, Bytesˉfromˉu32ˉlittle(1u32));
    return Bytesˉconcat(Value, Bytesˉfromˉu8(10u8));
}

fn Wvssˉminimumˉboundary() -> bytes {
    var Value: bytes = Textˉtoˉutf8("WVSS");
    Value = Bytesˉconcat(Value, Bytesˉfromˉu16ˉlittle(2u32));
    Value = Bytesˉconcat(Value, Bytesˉfromˉu16ˉlittle(0u32));
    Value = Bytesˉconcat(Value, Bytesˉfromˉu32ˉlittle(64u32));
    Value = Bytesˉconcat(Value, Bytesˉfromˉu32ˉlittle(1280u32));
    var Index: u32 = 0u32;
    while Index < 64u32 {
        Value = Bytesˉconcat(
            Value, Bytesˉfromˉu32ˉlittle(1296u32 + Index)
        );
        Value = Bytesˉconcat(Value, Bytesˉfromˉu32ˉlittle(1u32));
        Value = Bytesˉconcat(Value, Bytesˉfromˉu32ˉlittle(1u32));
        Value = Bytesˉconcat(Value, Bytesˉfromˉu32ˉlittle(1u32));
        Value = Bytesˉconcat(Value, Bytesˉfromˉu32ˉlittle(1u32));
        Index = Index + 1u32;
    }
    Index = 0u32;
    while Index < 64u32 {
        Value = Bytesˉconcat(Value, Bytesˉfromˉu8(10u8));
        Index = Index + 1u32;
    }
    return Value;
}

fn Wvtd() -> bytes {
    var Value: bytes = Textˉtoˉutf8("WVTD");
    Value = Bytesˉconcat(Value, Bytesˉfromˉu16ˉlittle(1u32));
    Value = Bytesˉconcat(Value, Bytesˉfromˉu16ˉlittle(0u32));
    Value = Bytesˉconcat(Value, Bytesˉfromˉu32ˉlittle(64u32));
    var Field: u32 = 0u32;
    while Field < 13u32 {
        Value = Bytesˉconcat(Value, Bytesˉfromˉu32ˉlittle(0u32));
        Field = Field + 1u32;
    }
    return Value;
}

fn Wvfc() -> bytes {
    var Value: bytes = Textˉtoˉutf8("WVFC");
    Value = Bytesˉconcat(Value, Bytesˉfromˉu16ˉlittle(1u32));
    Value = Bytesˉconcat(Value, Bytesˉfromˉu16ˉlittle(0u32));
    Value = Bytesˉconcat(Value, Bytesˉfromˉu32ˉlittle(48u32));
    Value = Bytesˉconcat(Value, Bytesˉfromˉu32ˉlittle(0u32));
    Value = Bytesˉconcat(Value, Bytesˉfromˉu32ˉlittle(96u32));
    Value = Bytesˉconcat(Value, Bytesˉfromˉu32ˉlittle(48u32));
    Value = Bytesˉconcat(Value, Bytesˉfromˉu32ˉlittle(1u32));
    var Field: u32 = 0u32;
    while Field < 5u32 {
        Value = Bytesˉconcat(Value, Bytesˉfromˉu32ˉlittle(0u32));
        Field = Field + 1u32;
    }
    return Value;
}

fn Lock() -> bytes { return Textˉtoˉutf8("lock\n"); }

fn Profile() -> bytes { return Textˉtoˉutf8("profile\n"); }

fn Construct() -> Evidence.Compilerˉadmissionˉevidenceˉresult {
    return Evidence.Compilerˉconstructˉadmissionˉevidence(
        Wvss(),
        Wvtd(),
        Wvfc(),
        Lock(),
        Profile(),
        1u32,
        0u32,
        Sourceˉdescriptor.Compilerˉsourceˉprofileˉbinding.English
    );
}

fn Authenticate(
    Input: bytes
) -> Evidence.Compilerˉadmissionˉevidenceˉresult {
    return Evidence.Compilerˉauthenticateˉadmissionˉevidence(
        Input,
        Wvss(),
        Wvtd(),
        Wvfc(),
        Lock(),
        Profile(),
        1u32,
        0u32,
        Sourceˉdescriptor.Compilerˉsourceˉprofileˉbinding.English
    );
}

fn Failureˉis(
    Result: Evidence.Compilerˉadmissionˉevidenceˉresult,
    Status: Evidence.Compilerˉadmissionˉevidenceˉstatus,
    Offset: u32
) -> bool {
    return Result.Status == Status && Result.Failureˉoffset == Offset &&
        Bytesˉlength(Result.Value) == 0u32;
}

fn Wvssˉfailureˉis(
    Result: Admissionˉsourceˉset.Compilerˉadmissionˉsourceˉsetˉresult,
    Status: Admissionˉsourceˉset.Compilerˉadmissionˉsourceˉsetˉstatus,
    Offset: u32
) -> bool {
    return Result.Status == Status && Result.Failureˉoffset == Offset &&
        Bytesˉlength(Result.Value) == 0u32;
}

fn Validatorˉinputˉfailureˉis(
    Result: Validator.Compilerˉadmissionˉevidenceˉvalidationˉresult,
    Status: Evidence.Compilerˉadmissionˉevidenceˉstatus,
    Offset: u32
) -> bool {
    return Result.Phase ==
        Validator.Compilerˉadmissionˉevidenceˉvalidationˉphase.Input &&
        Result.Evidenceˉstatus == Status &&
        Result.Wvssˉstatus ==
            Admissionˉsourceˉset.Compilerˉadmissionˉsourceˉsetˉstatus.Valid &&
        Result.Structureˉstatus == 0u32 &&
        Result.Failureˉoffset == Offset &&
        Bytesˉlength(Result.Value) == 0u32;
}

fn Validatorˉinputˉcoverage(Valid: bytes) -> bool {
    if !Validatorˉinputˉfailureˉis(
        Validator.Compilerˉvalidateˉadmissionˉevidenceˉsnapshots(
            Bytesˉslice(Valid, 0u32, 223u32),
            Wvss(), Wvtd(), Wvfc(), Lock(), Profile()
        ),
        Evidence.Compilerˉadmissionˉevidenceˉstatus.Invalidˉlength,
        223u32
    ) { return false; }
    if !Validatorˉinputˉfailureˉis(
        Validator.Compilerˉvalidateˉadmissionˉevidenceˉsnapshots(
            Valid, Empty(Wvss()), Wvtd(), Wvfc(), Lock(), Profile()
        ),
        Evidence.Compilerˉadmissionˉevidenceˉstatus.Invalidˉwvssˉlength,
        20u32
    ) { return false; }
    if !Validatorˉinputˉfailureˉis(
        Validator.Compilerˉvalidateˉadmissionˉevidenceˉsnapshots(
            Valid, Wvss(), Empty(Wvtd()), Wvfc(), Lock(), Profile()
        ),
        Evidence.Compilerˉadmissionˉevidenceˉstatus.Invalidˉwvtdˉlength,
        24u32
    ) { return false; }
    if !Validatorˉinputˉfailureˉis(
        Validator.Compilerˉvalidateˉadmissionˉevidenceˉsnapshots(
            Valid, Wvss(), Wvtd(), Empty(Wvfc()), Lock(), Profile()
        ),
        Evidence.Compilerˉadmissionˉevidenceˉstatus.Invalidˉwvfcˉlength,
        28u32
    ) { return false; }
    if !Validatorˉinputˉfailureˉis(
        Validator.Compilerˉvalidateˉadmissionˉevidenceˉsnapshots(
            Valid, Wvss(), Wvtd(), Wvfc(), Empty(Lock()), Profile()
        ),
        Evidence.Compilerˉadmissionˉevidenceˉstatus.Invalidˉlockˉlength,
        160u32
    ) { return false; }
    return Validatorˉinputˉfailureˉis(
        Validator.Compilerˉvalidateˉadmissionˉevidenceˉsnapshots(
            Valid, Wvss(), Wvtd(), Wvfc(), Lock(), Empty(Profile())
        ),
        Evidence.Compilerˉadmissionˉevidenceˉstatus.Invalidˉprofileˉlength,
        192u32
    );
}

fn Wvssˉstructureˉcoverage() -> i32 {
    if !Wvssˉfailureˉis(
        Admissionˉsourceˉset.Compilerˉvalidateˉadmittedˉsourceˉsetˉstructure(
            Empty(Wvss())
        ),
        Admissionˉsourceˉset.Compilerˉadmissionˉsourceˉsetˉstatus.Tooˉshort,
        0u32
    ) { return 51; }
    if !Wvssˉfailureˉis(
        Admissionˉsourceˉset.Compilerˉvalidateˉadmittedˉsourceˉsetˉstructure(
            Bytesˉslice(Wvss(), 0u32, 15u32)
        ),
        Admissionˉsourceˉset.Compilerˉadmissionˉsourceˉsetˉstatus.Tooˉshort,
        15u32
    ) { return 52; }
    if !Wvssˉfailureˉis(
        Admissionˉsourceˉset.Compilerˉvalidateˉadmittedˉsourceˉsetˉstructure(
            Patch(Wvss(), 0u32, Bytesˉfromˉu8(0u8))
        ),
        Admissionˉsourceˉset.Compilerˉadmissionˉsourceˉsetˉstatus.Invalidˉmagic,
        0u32
    ) { return 53; }
    if !Wvssˉfailureˉis(
        Admissionˉsourceˉset.Compilerˉvalidateˉadmittedˉsourceˉsetˉstructure(
            Patch(Wvss(), 4u32, Bytesˉfromˉu16ˉlittle(1u32))
        ),
        Admissionˉsourceˉset.Compilerˉadmissionˉsourceˉsetˉstatus.Unsupportedˉversion,
        4u32
    ) { return 54; }
    if !Wvssˉfailureˉis(
        Admissionˉsourceˉset.Compilerˉvalidateˉadmittedˉsourceˉsetˉstructure(
            Patchˉu32(Wvss(), 8u32, 0u32)
        ),
        Admissionˉsourceˉset.Compilerˉadmissionˉsourceˉsetˉstatus.Invalidˉcount,
        8u32
    ) { return 55; }
    if !Wvssˉfailureˉis(
        Admissionˉsourceˉset.Compilerˉvalidateˉadmittedˉsourceˉsetˉstructure(
            Patchˉu32(Wvss(), 8u32, 65u32)
        ),
        Admissionˉsourceˉset.Compilerˉadmissionˉsourceˉsetˉstatus.Invalidˉcount,
        8u32
    ) { return 56; }
    if !Wvssˉfailureˉis(
        Admissionˉsourceˉset.Compilerˉvalidateˉadmittedˉsourceˉsetˉstructure(
            Patchˉu32(Wvss(), 12u32, 19u32)
        ),
        Admissionˉsourceˉset.Compilerˉadmissionˉsourceˉsetˉstatus.Invalidˉdirectory,
        12u32
    ) { return 57; }
    if !Wvssˉfailureˉis(
        Admissionˉsourceˉset.Compilerˉvalidateˉadmittedˉsourceˉsetˉstructure(
            Patchˉu32(Wvss(), 24u32, 2u32)
        ),
        Admissionˉsourceˉset.Compilerˉadmissionˉsourceˉsetˉstatus.Invalidˉedition,
        24u32
    ) { return 58; }
    if !Wvssˉfailureˉis(
        Admissionˉsourceˉset.Compilerˉvalidateˉadmittedˉsourceˉsetˉstructure(
            Patchˉu32(Wvss(), 28u32, 0u32)
        ),
        Admissionˉsourceˉset.Compilerˉadmissionˉsourceˉsetˉstatus.Invalidˉbinding,
        28u32
    ) { return 59; }
    if !Wvssˉfailureˉis(
        Admissionˉsourceˉset.Compilerˉvalidateˉadmittedˉsourceˉsetˉstructure(
            Patchˉu32(Wvss(), 32u32, 0u32)
        ),
        Admissionˉsourceˉset.Compilerˉadmissionˉsourceˉsetˉstatus.Invalidˉorigin,
        32u32
    ) { return 60; }
    if !Wvssˉfailureˉis(
        Admissionˉsourceˉset.Compilerˉvalidateˉadmittedˉsourceˉsetˉstructure(
            Patchˉu32(Wvss(), 32u32, 130u32)
        ),
        Admissionˉsourceˉset.Compilerˉadmissionˉsourceˉsetˉstatus.Invalidˉorigin,
        32u32
    ) { return 61; }
    if !Wvssˉfailureˉis(
        Admissionˉsourceˉset.Compilerˉvalidateˉadmittedˉsourceˉsetˉstructure(
            Patchˉu32(Wvss(), 20u32, 0u32)
        ),
        Admissionˉsourceˉset.Compilerˉadmissionˉsourceˉsetˉstatus.Invalidˉentry,
        20u32
    ) { return 62; }
    if !Wvssˉfailureˉis(
        Admissionˉsourceˉset.Compilerˉvalidateˉadmittedˉsourceˉsetˉstructure(
            Patchˉu32(Wvss(), 20u32, 2u32)
        ),
        Admissionˉsourceˉset.Compilerˉadmissionˉsourceˉsetˉstatus.Invalidˉentry,
        20u32
    ) { return 63; }
    if !Wvssˉfailureˉis(
        Admissionˉsourceˉset.Compilerˉvalidateˉadmittedˉsourceˉsetˉstructure(
            Bytesˉconcat(Wvss(), Bytesˉfromˉu8(0u8))
        ),
        Admissionˉsourceˉset.Compilerˉadmissionˉsourceˉsetˉstatus.Noncanonicalˉlayout,
        37u32
    ) { return 64; }
    let Boundary: Admissionˉsourceˉset.Compilerˉadmissionˉsourceˉsetˉresult =
        Admissionˉsourceˉset.Compilerˉvalidateˉadmittedˉsourceˉsetˉstructure(
            Wvssˉminimumˉboundary()
        );
    if Boundary.Status !=
        Admissionˉsourceˉset.Compilerˉadmissionˉsourceˉsetˉstatus.Valid ||
        Boundary.Modules != 64u32 || Bytesˉlength(Boundary.Value) != 1360u32 {
        return 65;
    }
    return 0;
}

fn Selectedˉcase() -> u32 {
    if process.argument_count() != 1u32 { return 0u32; }
    let Argument: bytes = Textˉtoˉutf8(process.argument(0u32));
    if Bytesˉlength(Argument) != 1u32 { return 0u32; }
    let Character: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(Argument, 0u32));
    if Character >= 65u32 && Character <= 82u32 {
        return Character - 65u32 + 123u32;
    }
    return Character;
}

fn Shapeˉcases(Selected: u32, Valid: bytes) -> i32 {
    if Selected == 97u32 {
        let Shape: Evidence.Compilerˉadmissionˉevidenceˉresult =
            Evidence.Compilerˉvalidateˉadmissionˉevidenceˉshape(Valid);
        if Shape.Status != Evidence.Compilerˉadmissionˉevidenceˉstatus.Valid ||
            !Bytesˉequal(Shape.Value, Valid) {
            return 1;
        }
        return 42;
    }
    if Selected == 98u32 {
        if !Failureˉis(
            Evidence.Compilerˉvalidateˉadmissionˉevidenceˉshape(Empty(Valid)),
            Evidence.Compilerˉadmissionˉevidenceˉstatus.Invalidˉlength,
            0u32
        ) { return 2; }
        return 42;
    }
    if Selected == 99u32 {
        if !Failureˉis(
            Evidence.Compilerˉvalidateˉadmissionˉevidenceˉshape(
                Bytesˉslice(Valid, 0u32, 223u32)
            ),
            Evidence.Compilerˉadmissionˉevidenceˉstatus.Invalidˉlength,
            223u32
        ) { return 3; }
        return 42;
    }
    if Selected == 100u32 {
        if !Failureˉis(
            Evidence.Compilerˉvalidateˉadmissionˉevidenceˉshape(
                Bytesˉconcat(Valid, Bytesˉfromˉu8(0u8))
            ),
            Evidence.Compilerˉadmissionˉevidenceˉstatus.Invalidˉlength,
            224u32
        ) { return 4; }
        return 42;
    }
    if Selected == 101u32 {
        if !Failureˉis(
            Evidence.Compilerˉvalidateˉadmissionˉevidenceˉshape(
                Patch(Valid, 2u32, Bytesˉfromˉu8(0u8))
            ),
            Evidence.Compilerˉadmissionˉevidenceˉstatus.Invalidˉmagic,
            2u32
        ) { return 5; }
        return 42;
    }
    if Selected == 102u32 {
        if !Failureˉis(
            Evidence.Compilerˉvalidateˉadmissionˉevidenceˉshape(
                Patch(Valid, 4u32, Bytesˉfromˉu16ˉlittle(2u32))
            ),
            Evidence.Compilerˉadmissionˉevidenceˉstatus.Unsupportedˉversion,
            4u32
        ) { return 6; }
        return 42;
    }
    if Selected == 103u32 {
        if !Failureˉis(
            Evidence.Compilerˉvalidateˉadmissionˉevidenceˉshape(
                Patch(Valid, 6u32, Bytesˉfromˉu16ˉlittle(1u32))
            ),
            Evidence.Compilerˉadmissionˉevidenceˉstatus.Unsupportedˉversion,
            6u32
        ) { return 7; }
        return 42;
    }
    if Selected == 104u32 {
        if !Failureˉis(
            Evidence.Compilerˉvalidateˉadmissionˉevidenceˉshape(
                Patchˉu32(Valid, 8u32, 223u32)
            ),
            Evidence.Compilerˉadmissionˉevidenceˉstatus.Invalidˉstructureˉlength,
            8u32
        ) { return 8; }
        return 42;
    }
    if Selected == 105u32 {
        if !Failureˉis(
            Evidence.Compilerˉvalidateˉadmissionˉevidenceˉshape(
                Patchˉu32(Valid, 12u32, 2u32)
            ),
            Evidence.Compilerˉadmissionˉevidenceˉstatus.Unsupportedˉhash,
            12u32
        ) { return 9; }
        return 42;
    }
    if Selected == 106u32 {
        if !Failureˉis(
            Evidence.Compilerˉvalidateˉadmissionˉevidenceˉshape(
                Patchˉu32(Valid, 16u32, 1u32)
            ),
            Evidence.Compilerˉadmissionˉevidenceˉstatus.Invalidˉflags,
            16u32
        ) { return 10; }
        return 42;
    }
    return 0;
}

