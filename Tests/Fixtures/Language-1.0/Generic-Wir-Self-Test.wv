module Languageˉoneˉgenericˉwirˉselfˉtest profile portable;

import Compilerˉsourceˉbindings as Sourceˉbindings;
import Compilerˉsourceˉwir as Sourceˉwir;
import Compilerˉsourceˉwirˉchecked as Sourceˉwirˉchecked;

fn Appendˉu32(Input: bytes, Value: u32) -> bytes {
    return Bytesˉconcat(Input, Bytesˉfromˉu32ˉlittle(Value));
}

fn Sourceˉset(Source: text) -> bytes {
    let Sourceˉbytes: bytes = Textˉtoˉutf8(Source);
    var Header: bytes = Textˉtoˉutf8("WVSS");
    Header = Bytesˉconcat(Header, Bytesˉfromˉu16ˉlittle(1u32));
    Header = Bytesˉconcat(Header, Bytesˉfromˉu16ˉlittle(0u32));
    Header = Bytesˉconcat(Header, Bytesˉfromˉu32ˉlittle(1u32));
    Header = Bytesˉconcat(Header, Bytesˉfromˉu32ˉlittle(8u32));
    Header = Bytesˉconcat(Header, Bytesˉfromˉu32ˉlittle(24u32));
    Header = Bytesˉconcat(
        Header, Bytesˉfromˉu32ˉlittle(Bytesˉlength(Sourceˉbytes))
    );
    return Bytesˉconcat(Header, Sourceˉbytes);
}

fn Sourceˉsetˉtwo(First: text, Second: text) -> bytes {
    let Firstˉbytes: bytes = Textˉtoˉutf8(First);
    let Secondˉbytes: bytes = Textˉtoˉutf8(Second);
    var Header: bytes = Textˉtoˉutf8("WVSS");
    Header = Bytesˉconcat(Header, Bytesˉfromˉu16ˉlittle(1u32));
    Header = Bytesˉconcat(Header, Bytesˉfromˉu16ˉlittle(0u32));
    Header = Appendˉu32(Header, 2u32);
    Header = Appendˉu32(Header, 16u32);
    Header = Appendˉu32(Header, 32u32);
    Header = Appendˉu32(Header, Bytesˉlength(Firstˉbytes));
    Header = Appendˉu32(
        Header, 32u32 + Bytesˉlength(Firstˉbytes)
    );
    Header = Appendˉu32(Header, Bytesˉlength(Secondˉbytes));
    return Bytesˉconcat(
        Bytesˉconcat(Header, Firstˉbytes), Secondˉbytes
    );
}

fn Sourceˉsetˉthree(First: text, Second: text, Third: text) -> bytes {
    let Firstˉbytes: bytes = Textˉtoˉutf8(First);
    let Secondˉbytes: bytes = Textˉtoˉutf8(Second);
    let Thirdˉbytes: bytes = Textˉtoˉutf8(Third);
    var Header: bytes = Textˉtoˉutf8("WVSS");
    Header = Bytesˉconcat(Header, Bytesˉfromˉu16ˉlittle(1u32));
    Header = Bytesˉconcat(Header, Bytesˉfromˉu16ˉlittle(0u32));
    Header = Appendˉu32(Header, 3u32);
    Header = Appendˉu32(Header, 24u32);
    Header = Appendˉu32(Header, 40u32);
    Header = Appendˉu32(Header, Bytesˉlength(Firstˉbytes));
    Header = Appendˉu32(
        Header, 40u32 + Bytesˉlength(Firstˉbytes)
    );
    Header = Appendˉu32(Header, Bytesˉlength(Secondˉbytes));
    Header = Appendˉu32(
        Header,
        40u32 + Bytesˉlength(Firstˉbytes) + Bytesˉlength(Secondˉbytes)
    );
    Header = Appendˉu32(Header, Bytesˉlength(Thirdˉbytes));
    return Bytesˉconcat(
        Bytesˉconcat(
            Bytesˉconcat(Header, Firstˉbytes), Secondˉbytes
        ),
        Thirdˉbytes
    );
}

fn Optionˉsource() -> text {
    return "#!wv/1 en@1\nmodule Foundationˉoption; profile core; platform linux, windows, windvale; authority library; export variant Option<T> { Present(Value: T); Absent; }";
}

fn Resultˉsource() -> text {
    return "#!wv/1 en@1\nmodule Foundationˉresult; profile core; platform linux, windows, windvale; authority library; export variant Result<T, E> { Valid(Value: T); Failure(Error: E); }";
}

fn Foundationˉvalueˉpredicates() -> i32 {
    let Root: text = "#!wv/1 en@1\nmodule Foundationˉvalueˉpredicateˉtest; profile core; platform linux, windows, windvale; authority application; import Foundationˉoption as Option; import Foundationˉresult as Result; export fn Main() -> i32 { let Present: Option.Option<u32> = Option.Option.Present<u32> { Value: 42u32 }; let Absent: Option.Option<u32> = Option.Option.Absent<u32> {}; let Valid: Result.Result<i32, u8> = Result.Result.Valid<i32, u8> { Value: 42 }; let Failure: Result.Result<i32, u8> = Result.Result.Failure<i32, u8> { Error: 7u8 }; if !Option.Isˉpresent(borrow Present) { return 1; } if Option.Isˉpresent(borrow Absent) { return 2; } if !Result.Isˉvalid(borrow Valid) { return 3; } if Result.Isˉfailure(borrow Valid) { return 4; } if Result.Isˉvalid(borrow Failure) { return 5; } if !Result.Isˉfailure(borrow Failure) { return 6; } return 42; }";
    let Summary: Sourceˉwir.Compilerˉsourceˉwirˉsummary =
        Sourceˉwirˉchecked.Compilerˉvalidateˉsourceˉwir(
            Sourceˉsetˉthree(Root, Optionˉsource(), Resultˉsource())
        );
    if Summary.Status != Sourceˉwir.Compilerˉsourceˉwirˉstatus.Valid {
        return 10;
    }
    let Blocksˉoffset: u32 = 56u32 + Summary.Functions * 48u32;
    let Operationsˉoffset: u32 = Blocksˉoffset + Summary.Blocks * 28u32;
    var Presentˉchecks: u32 = 0u32;
    var Failureˉchecks: u32 = 0u32;
    var Operation: u32 = 0u32;
    while Operation < Summary.Operations {
        let Entry: u32 = Operationsˉoffset + Operation * 28u32;
        if Bytesˉreadˉu16ˉlittle(
                Summary.Directory, Entry + 4u32
            ) == 66u32 {
            if Bytesˉreadˉu16ˉlittle(
                    Summary.Directory, Entry + 6u32
                ) != 1u32 ||
                Bytesˉreadˉu32ˉlittle(
                    Summary.Directory, Entry + 8u32
                ) != 4u32 ||
                Bytesˉreadˉu32ˉlittle(
                    Summary.Directory, Entry + 20u32
                ) == 4294967295u32 {
                return 11;
            }
            let Case: u32 = Bytesˉreadˉu32ˉlittle(
                Summary.Directory, Entry + 24u32
            );
            if Case == 0u32 {
                Presentˉchecks = Presentˉchecks + 1u32;
            } else if Case == 1u32 {
                Failureˉchecks = Failureˉchecks + 1u32;
            } else {
                return 12;
            }
        }
        Operation = Operation + 1u32;
    }
    if Presentˉchecks != 4u32 || Failureˉchecks != 2u32 { return 13; }
    return 42;
}

fn Foundationˉvalueˉlookalikeˉrejection() -> bool {
    let Root: text = "#!wv/1 en@1\nmodule Foundationˉvalueˉlookalikeˉtest; profile core; platform linux, windows, windvale; authority application; import Lookalikeˉoption as Option; export fn Main() -> i32 { let Value: Option.Option<u32> = Option.Option.Absent<u32> {}; if Option.Isˉpresent(borrow Value) { return 1; } return 42; }";
    let Lookalike: text = "#!wv/1 en@1\nmodule Lookalikeˉoption; profile core; platform linux, windows, windvale; authority library; export variant Option<T> { Present(Value: T); Absent; }";
    let Summary: Sourceˉwir.Compilerˉsourceˉwirˉsummary =
        Sourceˉwirˉchecked.Compilerˉvalidateˉsourceˉwir(
            Sourceˉsetˉtwo(Root, Lookalike)
        );
    return Summary.Status ==
            Sourceˉwir.Compilerˉsourceˉwirˉstatus.Sourceˉbindings &&
        Summary.Bindingˉstatus ==
            Sourceˉbindings.Compilerˉsourceˉbindingˉstatus.Unknownˉcall;
}

fn Foundationˉvalueˉfamilyˉrejection() -> bool {
    let Root: text = "#!wv/1 en@1\nmodule Foundationˉvalueˉfamilyˉtest; profile core; platform linux, windows, windvale; authority application; import Foundationˉoption as Option; import Foundationˉresult as Result; export fn Main() -> i32 { let Value: Option.Option<u32> = Option.Option.Absent<u32> {}; if Result.Isˉvalid(borrow Value) { return 1; } return 42; }";
    let Summary: Sourceˉwir.Compilerˉsourceˉwirˉsummary =
        Sourceˉwirˉchecked.Compilerˉvalidateˉsourceˉwir(
            Sourceˉsetˉthree(Root, Optionˉsource(), Resultˉsource())
        );
    return Summary.Status ==
        Sourceˉwir.Compilerˉsourceˉwirˉstatus.Invalidˉargument;
}

fn Foundationˉvalueˉborrowˉrejection() -> bool {
    let Root: text = "#!wv/1 en@1\nmodule Foundationˉvalueˉborrowˉtest; profile core; platform linux, windows, windvale; authority application; import Foundationˉoption as Option; export fn Main() -> i32 { let Value: Option.Option<u32> = Option.Option.Absent<u32> {}; if Option.Isˉpresent(Value) { return 1; } return 42; }";
    let Summary: Sourceˉwir.Compilerˉsourceˉwirˉsummary =
        Sourceˉwirˉchecked.Compilerˉvalidateˉsourceˉwir(
            Sourceˉsetˉtwo(Root, Optionˉsource())
        );
    return Summary.Status ==
        Sourceˉwir.Compilerˉsourceˉwirˉstatus.Invalidˉborrow;
}

fn Foundationˉvalueˉpayloadˉborrows() -> i32 {
    let Root: text = "#!wv/1 en@1\nmodule Foundationˉvalueˉpayloadˉborrowˉtest; profile core; platform linux, windows, windvale; authority application; import Foundationˉoption as Option; import Foundationˉresult as Result; record Payload { Code: u32; } fn Readˉpayload(Value: borrow Payload) -> u32 { return Value.Code; } fn Readˉu32(Value: borrow u32) -> u32 { return Value; } export fn Main() -> i32 { let Maybe: Option.Option<Payload> = Option.Option.Present<Payload> { Value: Payload { Code: 30u32 } }; let Valid: Result.Result<Payload, u32> = Result.Result.Valid<Payload, u32> { Value: Payload { Code: 7u32 } }; let Failure: Result.Result<Payload, u32> = Result.Result.Failure<Payload, u32> { Error: 5u32 }; var Total: u32 = 0u32; match Option.Borrow(borrow Maybe) { case Option.Option.Present { Value: Item } { Total = Total + Readˉpayload(borrow Item); } case Option.Option.Absent { } } match Result.Borrowˉvalid(borrow Valid) { case Option.Option.Present { Value: Item } { Total = Total + Readˉpayload(borrow Item); } case Option.Option.Absent { } } match Result.Borrowˉfailure(borrow Failure) { case Option.Option.Present { Value: Error } { Total = Total + Readˉu32(borrow Error); } case Option.Option.Absent { } } if Total != 42u32 { return 1; } return 42; }";
    let Summary: Sourceˉwir.Compilerˉsourceˉwirˉsummary =
        Sourceˉwirˉchecked.Compilerˉvalidateˉsourceˉwir(
            Sourceˉsetˉthree(Root, Optionˉsource(), Resultˉsource())
        );
    if Summary.Status != Sourceˉwir.Compilerˉsourceˉwirˉstatus.Valid {
        return 10;
    }
    if Bytesˉreadˉu16ˉlittle(Summary.Directory, 6u32) != 33u32 ||
        Bytesˉreadˉu32ˉlittle(Summary.Directory, 48u32) != 0u32 ||
        Bytesˉreadˉu32ˉlittle(Summary.Directory, 52u32) != 1u32 {
        return 11;
    }
    let Blocksˉoffset: u32 = 56u32 + Summary.Functions * 48u32;
    let Operationsˉoffset: u32 = Blocksˉoffset + Summary.Blocks * 28u32;
    var Borrowˉkinds: u32 = 1u32;
    var Operation: u32 = 0u32;
    while Operation < Summary.Operations {
        let Entry: u32 = Operationsˉoffset + Operation * 28u32;
        if Bytesˉreadˉu16ˉlittle(Summary.Directory, Entry + 4u32) == 191u32 {
            if Bytesˉreadˉu16ˉlittle(Summary.Directory, Entry + 6u32) != 0u32 {
                return 12;
            }
            let Shape: u32 = Bytesˉreadˉu32ˉlittle(
                Summary.Directory, Entry + 8u32
            );
            if Shape < 2147484160u32 || Shape >= 2147484416u32 {
                return 13;
            }
            let Kind: u32 = Bytesˉreadˉu32ˉlittle(
                Summary.Directory, Entry + 24u32
            );
            if Kind < 1u32 || Kind > 3u32 {
                return 14;
            }
            let Marker: u32 = 1u32 + Kind * 8u32;
            if Borrowˉkinds / Marker * Marker == Borrowˉkinds { return 14; }
            Borrowˉkinds = Borrowˉkinds * Marker;
        }
        Operation = Operation + 1u32;
    }
    if Borrowˉkinds != 3825u32 { return 15; }
    return 42;
}

fn Foundationˉvalueˉpayloadˉborrowˉlookalikeˉrejection() -> bool {
    let Root: text = "#!wv/1 en@1\nmodule Foundationˉvalueˉpayloadˉlookalikeˉtest; profile core; platform linux, windows, windvale; authority application; import Lookalikeˉoption as Option; export fn Main() -> i32 { let Value: Option.Option<u32> = Option.Option.Absent<u32> {}; match Option.Borrow(borrow Value) { case Option.Option.Present { Value: Item } { return 1; } case Option.Option.Absent { return 42; } } }";
    let Lookalike: text = "#!wv/1 en@1\nmodule Lookalikeˉoption; profile core; platform linux, windows, windvale; authority library; export variant Option<T> { Present(Value: T); Absent; }";
    let Summary: Sourceˉwir.Compilerˉsourceˉwirˉsummary =
        Sourceˉwirˉchecked.Compilerˉvalidateˉsourceˉwir(
            Sourceˉsetˉtwo(Root, Lookalike)
        );
    return Summary.Status ==
            Sourceˉwir.Compilerˉsourceˉwirˉstatus.Sourceˉbindings &&
        Summary.Bindingˉstatus ==
            Sourceˉbindings.Compilerˉsourceˉbindingˉstatus.Unknownˉcall;
}

fn Foundationˉvalueˉpayloadˉborrowˉmodeˉrejection() -> bool {
    let Root: text = "#!wv/1 en@1\nmodule Foundationˉvalueˉpayloadˉmodeˉtest; profile core; platform linux, windows, windvale; authority application; import Foundationˉoption as Option; export fn Main() -> i32 { let Value: Option.Option<u32> = Option.Option.Absent<u32> {}; match Option.Borrow(Value) { case Option.Option.Present { Value: Item } { return 1; } case Option.Option.Absent { return 42; } } }";
    let Summary: Sourceˉwir.Compilerˉsourceˉwirˉsummary =
