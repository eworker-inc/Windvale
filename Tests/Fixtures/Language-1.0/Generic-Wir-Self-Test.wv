fn Foundationˉvalueˉpayloadˉescapeˉrejection() -> bool {
    let Root: text = "#!wv/1 en@1\nmodule Foundationˉvalueˉpayloadˉescapeˉtest; profile core; platform linux, windows, windvale; authority application; import Foundationˉoption as Option; record Payload { Code: u32; } fn Escape(Value: borrow Option.Option<Payload>) -> Payload { return match Option.Borrow(borrow Value) { case Option.Option.Present { Value: Item } { Item } case Option.Option.Absent { Payload { Code: 0u32 } } }; } export fn Main() -> i32 { let Value: Option.Option<Payload> = Option.Option.Absent<Payload> {}; let Escaped: Payload = Escape(borrow Value); if Escaped.Code != 0u32 { return 1; } return 42; }";
    let Summary: Sourceˉwir.Compilerˉsourceˉwirˉsummary =
        Sourceˉwirˉchecked.Compilerˉvalidateˉsourceˉwir(
            Sourceˉsetˉtwo(Root, Optionˉsource())
        );
    return Summary.Status ==
        Sourceˉwir.Compilerˉsourceˉwirˉstatus.Invalidˉdirectory;
}

fn Foundationˉvalueˉpayloadˉownerˉmutationˉrejection() -> bool {
    let Root: text = "#!wv/1 en@1\nmodule Foundationˉvalueˉpayloadˉmutationˉtest; profile core; platform linux, windows, windvale; authority application; import Foundationˉoption as Option; export fn Main() -> i32 { var Value: Option.Option<u32> = Option.Option.Present<u32> { Value: 42u32 }; match Option.Borrow(borrow Value) { case Option.Option.Present { Value: _ } { } case Option.Option.Absent { return 2; } } Value = Option.Option.Absent<u32> {}; return 42; }";
    let Summary: Sourceˉwir.Compilerˉsourceˉwirˉsummary =
        Sourceˉwirˉchecked.Compilerˉvalidateˉsourceˉwir(
            Sourceˉsetˉtwo(Root, Optionˉsource())
        );
    return Summary.Status ==
        Sourceˉwir.Compilerˉsourceˉwirˉstatus.Invalidˉdirectory;
}

export fn Main() -> i32 {
    let Input: bytes = Sourceˉset(
        "module Genericˉidentity profile portable; fn Identity<Type>(Value: Type) -> Type { return Value; } export fn Main() -> i32 { let Initial: i32 = 42; let Inferred: i32 = Identity(Initial); return Identity::<i32>(Inferred); }"
    );
    let Summary: Sourceˉwir.Compilerˉsourceˉwirˉsummary =
        Sourceˉwirˉchecked.Compilerˉvalidateˉsourceˉwir(Input);
    if Summary.Status != Sourceˉwir.Compilerˉsourceˉwirˉstatus.Valid {
        return 1;
    }
    if Summary.Functions != 3u32 ||
        Bytesˉreadˉu16ˉlittle(Summary.Directory, 6u32) != 2u32 ||
        Bytesˉreadˉu32ˉlittle(Summary.Directory, 48u32) != 1u32 {
        return 2;
    }
    if Summary.Blocks == 0u32 || Summary.Operations == 0u32 {
        return 3;
    }
    if Foundationˉvalueˉpredicates() != 42 { return 4; }
    if !Foundationˉvalueˉlookalikeˉrejection() { return 5; }
    if !Foundationˉvalueˉfamilyˉrejection() { return 6; }
    if !Foundationˉvalueˉborrowˉrejection() { return 7; }
    if Foundationˉvalueˉpayloadˉborrows() != 42 { return 8; }
    if !Foundationˉvalueˉpayloadˉborrowˉlookalikeˉrejection() {
        return 9;
    }
    if !Foundationˉvalueˉpayloadˉborrowˉmodeˉrejection() { return 10; }
    if !Foundationˉvalueˉborrowˉviewˉstorageˉrejection() { return 11; }
    if !Foundationˉvalueˉpayloadˉescapeˉrejection() { return 12; }
    if !Foundationˉvalueˉpayloadˉownerˉmutationˉrejection() { return 13; }
    return 42;
}
