fn Foundationˉvalueˉborrowˉviewˉstorageˉrejection() -> bool {
    let Root: text = "#!wv/1 en@1\nmodule Foundationˉvalueˉborrowˉviewˉstorageˉtest; profile core; platform linux, windows, windvale; authority application; import Foundationˉoption as Option; export fn Main() -> i32 { let Value: Option.Option<u32> = Option.Option.Absent<u32> {}; let Borrowed = Option.Borrow(borrow Value); match Borrowed { case Option.Option.Present { Value: Item } { return 1; } case Option.Option.Absent { return 42; } } }";
    let Summary: Sourceˉwir.Compilerˉsourceˉwirˉsummary =
