#!wv/1 en@1
module Languageˉoneˉownedˉvectorˉloopˉinvariant;
profile core;
platform linux, windows, windvale;
authority application;

import Foundationˉcollections as Collections;
import Foundationˉmemory as Memory;
import Foundationˉresult as Resultˉvalues;

fn Observe(Value: borrow Collections.Vector<i32>) -> unit {
    return;
}

fn Preserveˉthroughˉcontinue(
    Value: Collections.Vector<i32>,
    Repeat: bool
) -> Collections.Vector<i32> {
    while Repeat {
        Observe(borrow Value);
        continue;
    }
    return Value;
}

fn Preserveˉthroughˉbreak(
    Value: Collections.Vector<i32>,
    Enter: bool
) -> Collections.Vector<i32> {
    while Enter {
        Observe(borrow Value);
        break;
    }
    return Value;
}

fn Release(Value: Collections.Vector<i32>) -> unit {
    return;
}

export fn Main(Budget: Memory.Memoryˉbudget) -> i32 {
    let Outcome: Resultˉvalues.Result<
        Collections.Vector<i32>,
        Memory.Allocationˉfailure
    > = Collections.Vectorˉconstructˉreserved::<i32>(Budget, 4u64);
    return match Outcome {
        case Resultˉvalues.Result.Valid { Value: Values } {
            let Continued: Collections.Vector<i32> =
                Preserveˉthroughˉcontinue(Values, false);
            let Broken: Collections.Vector<i32> =
                Preserveˉthroughˉbreak(Continued, true);
            Release(Broken);
            42
        }
        case Resultˉvalues.Result.Failure { Error: Failure } { 1 }
    };
}
