#!wv/1 en@1
module ValueˉMatchˉTrailingˉSemicolon;
profile core;
platform linux, windows, windvale;
authority application;

enum Selection {
    Chosen = 0;
    Rejected = 1;
}

export fn Main() -> i32 {
    return match Selection.Chosen {
        case Selection.Chosen { 42; }
        case Selection.Rejected { 0 }
    };
}
