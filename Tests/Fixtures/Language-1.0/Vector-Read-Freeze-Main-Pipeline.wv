#!wv/1 en@1
module Languageˉoneˉvectorˉreadˉfreeze;
profile core;
platform linux, windows, windvale;
authority application;

import Foundationˉcollections as Collections;

fn Acquire() -> Collections.Vector<i32> {
    return Acquire();
}

fn Acquireˉsequence() -> Collections.Sequence<i32> {
    return Acquireˉsequence();
}

fn Consume(Value: Collections.Sequence<i32>) -> u64 {
    return Collections.Sequenceˉlength(borrow Value);
}

export fn Readˉlength() -> u64 {
    let Values: Collections.Vector<i32> = Acquire();
    return Collections.Vectorˉlength(borrow Values);
}

export fn Freeze() -> Collections.Sequence<i32> {
    let Values: Collections.Vector<i32> = Acquire();
    return Collections.Vectorˉfreeze(Values);
}

export fn Freezeˉlocal() -> u64 {
    let Values: Collections.Vector<i32> = Acquire();
    let Frozen: Collections.Sequence<i32> =
        Collections.Vectorˉfreeze(Values);
    return Collections.Sequenceˉlength(borrow Frozen);
}

export fn Freezeˉassignment() -> u64 {
    var Frozen: Collections.Sequence<i32> = Acquireˉsequence();
    let Values: Collections.Vector<i32> = Acquire();
    Frozen = Collections.Vectorˉfreeze(Values);
    return Collections.Sequenceˉlength(borrow Frozen);
}

export fn Freezeˉargument() -> u64 {
    let Values: Collections.Vector<i32> = Acquire();
    return Consume(Collections.Vectorˉfreeze(Values));
}

export fn Main() -> i32 {
    return 42;
}
