#!wv/1 en@1
module Foundationˉvectorˉpayloadˉborrowˉexecutable;
profile core;
platform linux, windows;
authority application;

import Foundationˉcollections as Collections;
import Foundationˉmemory as Memory;
import Foundationˉoption as Option;
import Foundationˉresult as Result;

fn Read(Marker: u32, Value: borrow Collections.Vector<i32>) -> u64 {
    if Marker != 7u32 { return 999u64; }
    return Collections.Vectorˉlength(borrow Value);
}

fn Forward(Value: borrow Collections.Vector<i32>, Marker: u32) -> u64 {
    return Read(Marker, borrow Value);
}

fn Marker(Value: u64, Expected: u64) -> u32 {
    if Value != Expected { return 0u32; }
    return 7u32;
}

fn Pair(Left: borrow Collections.Vector<i32>, Right: borrow Collections.Vector<i32>) -> u64 {
    return Forward(borrow Left, 7u32) + Forward(borrow Right, 7u32);
}

// A second exact Vector nominal is a malformed-call control in the owner.
export fn Otherˉtype(Value: borrow Collections.Vector<u32>) -> u64 { return 0u64; }

fn Observe(Values: Collections.Vector<i32>, Expected: u64) -> i32 {
    let Owner: Option.Option<Collections.Vector<i32> > =
        Option.Option.Present<Collections.Vector<i32> > { Value: Values };
    match Option.Borrow(borrow Owner) {
        case Option.Option.Present { Value: Item } {
            var Iteration: u32 = 0u32;
            while Iteration < 1u32 {
                if Forward(borrow Item, 7u32) != Expected { return 11; }
                if Pair(borrow Item, borrow Item) != Expected + Expected { return 12; }
                if Forward(borrow Item, Marker(Forward(borrow Item, 7u32), Expected)) != Expected { return 13; }
                if Read(Value: borrow Item, Marker: Marker(Forward(borrow Item, 7u32), Expected)) != Expected { return 14; }
                Iteration = Iteration + 1u32;
            }
            return 42;
        }
        case Option.Option.Absent { return 15; }
    }
}

export fn Main(Budget: Memory.Memoryˉbudget) -> i32 {
    var Parent: Memory.Memoryˉbudget = Budget;
    var Iteration: u32 = 0u32;
    // Retaining a payload owner or its lease exhausts the parent before 128 trips.
    while Iteration < 128u32 {
        let Split: Result.Result<Memory.Memoryˉbudget, Memory.Allocationˉfailure> =
            Memory.Split(borrow mut Parent, 8192u64, 0u32);
        let Observed: i32 = match Split {
            case Result.Result.Valid { Value: Child } {
                let Created: Result.Result<Collections.Vector<i32>, Memory.Allocationˉfailure> =
                    Collections.Vectorˉconstructˉreserved::<i32>(Child, 4u64);
                match Created {
                    case Result.Result.Valid { Value: Initial } {
                        var Values: Collections.Vector<i32> = Initial;
                        var Code: i32 = 0;
                        if Iteration % 2u32 == 0u32 {
                            Code = Observe(Values, 0u64);
                        } else {
                            let Appended: Result.Result<unit, Collections.Vectorˉappendˉfailure<i32> > =
                                Collections.Vectorˉappend::<i32>(borrow mut Values, 7);
                            match Appended {
                                case Result.Result.Valid { Value: Accepted } {
                                    Code = Observe(Values, 1u64);
                                }
                                case Result.Result.Failure { Error: Appendˉfailure } { return 2; }
                            }
                        }
                        Code
                    }
                    case Result.Result.Failure { Error: Allocationˉfailure } { 1 }
                }
            }
            case Result.Result.Failure { Error: Splitˉfailure } { 3 }
        };
        if Observed != 42 { return Observed; }
        Iteration = Iteration + 1u32;
    }
    return 42;
}
