            Owner.State.Scratchˉalignment, Owner.State.Scratchˉgeneration,
            Owner.State.Regionˉlive, Owner.State.Regionˉstart,
            Owner.State.Regionˉlength, Owner.State.Regionˉalignment,
            Owner.State.Regionˉgeneration, Owner.State.Pointerˉlive,
            Owner.State.Pointerˉgeneration,
            Foreign.COMPILER_SOURCE_FOREIGN_SEMANTICS_MAXIMUM_EVIDENCE_BYTES - 63u32,
            Owner.State.Sliceˉlive, Owner.State.Sliceˉgeneration
        );
    let Result: Foreign.Compilerˉsourceˉforeignˉsemanticˉresult =
        Foreign.Compilerˉsourceˉforeignˉborrowˉwriteˉregion(
            Buildˉtarget(), Operationˉcontext(1u32, 128u32), Full,
            1u32, 0u64, 64u64, 8u64
        );
    let Exactˉroom: Foreign.Compilerˉsourceˉforeignˉmemoryˉstate =
        Foreign.Compilerˉsourceˉforeignˉmemoryˉstate(
            Owner.State.Valid, Owner.State.Abiˉcontract, Owner.State.Baseˉaddress,
            Owner.State.Budgetˉremaining, Owner.State.Allocationˉcount,
            Owner.State.Regionˉcount, Owner.State.Pointerˉcount,
            Owner.State.Callˉcount, Owner.State.Scratchˉlive,
            Owner.State.Scratchˉzeroˉinitialized, Owner.State.Scratchˉlength,
            Owner.State.Scratchˉalignment, Owner.State.Scratchˉgeneration,
            Owner.State.Regionˉlive, Owner.State.Regionˉstart,
            Owner.State.Regionˉlength, Owner.State.Regionˉalignment,
            Owner.State.Regionˉgeneration, Owner.State.Pointerˉlive,
            Owner.State.Pointerˉgeneration,
            Foreign.COMPILER_SOURCE_FOREIGN_SEMANTICS_MAXIMUM_EVIDENCE_BYTES - 64u32,
            Owner.State.Sliceˉlive, Owner.State.Sliceˉgeneration
        );
    let Exactˉtransition: Foreign.Compilerˉsourceˉforeignˉsemanticˉresult =
        Foreign.Compilerˉsourceˉforeignˉborrowˉwriteˉregion(
            Buildˉtarget(), Operationˉcontext(1u32, 128u32), Exactˉroom,
            1u32, 0u64, 64u64, 8u64
        );
    let Empty: Foreign.Compilerˉsourceˉforeignˉmemoryˉstate =
        Foreign.Compilerˉsourceˉforeignˉmemoryˉempty(1u32, 4096u64, 64u64);
    let Constructionˉfull: Foreign.Compilerˉsourceˉforeignˉmemoryˉstate =
        Foreign.Compilerˉsourceˉforeignˉmemoryˉstate(
            Empty.Valid, Empty.Abiˉcontract, Empty.Baseˉaddress,
            Empty.Budgetˉremaining, Empty.Allocationˉcount,
            Empty.Regionˉcount, Empty.Pointerˉcount, Empty.Callˉcount,
            Empty.Scratchˉlive, Empty.Scratchˉzeroˉinitialized,
            Empty.Scratchˉlength, Empty.Scratchˉalignment,
            Empty.Scratchˉgeneration, Empty.Regionˉlive,
            Empty.Regionˉstart, Empty.Regionˉlength,
            Empty.Regionˉalignment, Empty.Regionˉgeneration,
            Empty.Pointerˉlive, Empty.Pointerˉgeneration,
            Foreign.COMPILER_SOURCE_FOREIGN_SEMANTICS_MAXIMUM_EVIDENCE_BYTES - 32u32,
            Empty.Sliceˉlive, Empty.Sliceˉgeneration
        );
    let Construction: Foreign.Compilerˉsourceˉforeignˉsemanticˉresult =
        Foreign.Compilerˉsourceˉforeignˉconstructˉscratch(
            Buildˉtarget(), Operationˉcontext(0u32, 1u32),
            Constructionˉfull, 64u64, 8u64, 3u32
        );
    return Foreign.Compilerˉsourceˉforeignˉmemoryˉstateˉisˉvalid(Full) &&
        Result.Status == Foreign.Compilerˉsourceˉforeignˉsemanticˉstatus.Resourceˉlimit &&
        Exactˉtransition.Status ==
            Foreign.Compilerˉsourceˉforeignˉsemanticˉstatus.Valid &&
        Exactˉtransition.State.Evidenceˉbytes ==
            Foreign.COMPILER_SOURCE_FOREIGN_SEMANTICS_MAXIMUM_EVIDENCE_BYTES &&
        Foreign.Compilerˉsourceˉforeignˉmemoryˉstateˉisˉvalid(Constructionˉfull) &&
        Construction.Status ==
            Foreign.Compilerˉsourceˉforeignˉsemanticˉstatus.Resourceˉlimit &&
        Construction.State.Allocationˉcount == 0u32 &&
        Construction.State.Budgetˉremaining == 64u64 &&
        Callˉevidenceˉheadroomˉisˉenforced();
}

fn Caseˉproviderˉalignment() -> bool {
    let Misaligned: Foreign.Compilerˉsourceˉforeignˉsemanticˉresult =
        Scratchˉwith(4097u64, 64u64, 64u64, 8u64, 0u32);
    let Nullˉbase: Foreign.Compilerˉsourceˉforeignˉsemanticˉresult =
        Scratchˉwith(0u64, 64u64, 64u64, 8u64, 0u32);
    let Wrapping: Foreign.Compilerˉsourceˉforeignˉsemanticˉresult =
        Scratchˉwith(18446744073709551608u64, 64u64, 64u64, 8u64, 0u32);
    return Misaligned.Status ==
            Foreign.Compilerˉsourceˉforeignˉsemanticˉstatus.Allocationˉfailure &&
        Misaligned.Third == U64ˉfromˉu32(
            Foreign.COMPILER_SOURCE_FOREIGN_SEMANTICS_TARGET_UNADDRESSABLE_REASON
        ) && !Misaligned.State.Scratchˉlive &&
        Nullˉbase.Status ==
            Foreign.Compilerˉsourceˉforeignˉsemanticˉstatus.Allocationˉfailure &&
        Nullˉbase.Third == Misaligned.Third && !Nullˉbase.State.Scratchˉlive &&
        Wrapping.Status ==
            Foreign.Compilerˉsourceˉforeignˉsemanticˉstatus.Allocationˉfailure &&
        Wrapping.Third == Misaligned.Third && !Wrapping.State.Scratchˉlive;
}

fn Caseˉfailureˉordering() -> bool {
    let State: Foreign.Compilerˉsourceˉforeignˉmemoryˉstate =
        Foreign.Compilerˉsourceˉforeignˉmemoryˉempty(0u32, 4097u64, 0u64);
    let Construct: Foreign.Compilerˉsourceˉforeignˉsemanticˉresult =
        Foreign.Compilerˉsourceˉforeignˉconstructˉscratch(
            Buildˉtarget(), Foreign.Compilerˉsourceˉforeignˉoperationˉcontext(
                2u32, 0u32, 0u32
            ),
            State, 0u64, 3u64, 5u32
        );
    let Pointerˉvalue: Foreign.Compilerˉsourceˉforeignˉsemanticˉresult = Pointer(4096u64);
    let Exact: Foreign.Compilerˉsourceˉforeignˉauthenticatedˉcallable =
        Exactˉcallable();
    let Invalid: Foreign.Compilerˉsourceˉforeignˉauthenticatedˉcallable =
        Foreign.Compilerˉsourceˉforeignˉauthenticatedˉcallable(
            Exact.Abiˉcontract, 0u32, 0u32, true, Exact.Profile,
            Exact.Languageˉeffects, Exact.Destination, Exact.Capacity,
            Exact.Expectedˉgeneration, Exact.Return, true, true
        );
    let Call: Foreign.Compilerˉsourceˉforeignˉsemanticˉresult = Foreignˉcall(
        Invalid, Callˉcontext(0u32, 0u32, 1u64, false, false),
        Pointerˉvalue.State
    );
    return Construct.Status ==
            Foreign.Compilerˉsourceˉforeignˉsemanticˉstatus.Systemˉprofileˉrequired &&
        Call.Status ==
            Foreign.Compilerˉsourceˉforeignˉsemanticˉstatus.Unsafeˉcontextˉrequired;
}

fn Underreportedˉhistoryˉevidenceˉisˉrejected() -> bool {
    let Value: Foreign.Compilerˉsourceˉforeignˉsemanticˉresult = Pointer(4096u64);
    let Forged: Foreign.Compilerˉsourceˉforeignˉmemoryˉstate =
        Foreign.Compilerˉsourceˉforeignˉmemoryˉstate(
            Value.State.Valid, Value.State.Abiˉcontract,
            Value.State.Baseˉaddress, Value.State.Budgetˉremaining,
            Value.State.Allocationˉcount, Value.State.Regionˉcount,
            Value.State.Pointerˉcount, Value.State.Callˉcount,
            Value.State.Scratchˉlive, Value.State.Scratchˉzeroˉinitialized,
            Value.State.Scratchˉlength, Value.State.Scratchˉalignment,
            Value.State.Scratchˉgeneration, Value.State.Regionˉlive,
            Value.State.Regionˉstart, Value.State.Regionˉlength,
            Value.State.Regionˉalignment, Value.State.Regionˉgeneration,
            Value.State.Pointerˉlive, Value.State.Pointerˉgeneration,
            128u32, Value.State.Sliceˉlive, Value.State.Sliceˉgeneration
        );
    return !Foreign.Compilerˉsourceˉforeignˉmemoryˉstateˉisˉvalid(Forged);
}

fn Caseˉcontractˉbounds() -> bool {
    let Empty: Foreign.Compilerˉsourceˉforeignˉmemoryˉstate =
        Foreign.Compilerˉsourceˉforeignˉmemoryˉempty(1u32, 4096u64, 64u64);
    let Forgedˉdead: Foreign.Compilerˉsourceˉforeignˉmemoryˉstate =
        Foreign.Compilerˉsourceˉforeignˉmemoryˉstate(
            Empty.Valid, Empty.Abiˉcontract, Empty.Baseˉaddress,
            Empty.Budgetˉremaining, Empty.Allocationˉcount,
            Empty.Regionˉcount, Empty.Pointerˉcount, Empty.Callˉcount,
            false, false, 8u64, 0u64, Empty.Scratchˉgeneration,
            false, 1u64, 0u64, 0u64, Empty.Regionˉgeneration,
            false, Empty.Pointerˉgeneration, Empty.Evidenceˉbytes,
            false, 0u32
        );
    let Value: Foreign.Compilerˉsourceˉforeignˉsemanticˉresult = Pointer(4096u64);
    let Capacity: Foreign.Compilerˉsourceˉforeignˉsemanticˉresult = Foreignˉcall(
        Exactˉcallable(), Callˉcontext(1u32, 256u32, 63u64, false, false),
        Value.State
    );
    let Oversized: Foreign.Compilerˉsourceˉforeignˉsemanticˉresult = Foreignˉcall(
        Exactˉcallable(), Callˉcontext(1u32, 256u32, 65u64, false, false),
        Value.State
    );
    let Forgedˉuncalledˉdeadˉpointer:
        Foreign.Compilerˉsourceˉforeignˉmemoryˉstate =
        Foreign.Compilerˉsourceˉforeignˉmemoryˉstate(
            Value.State.Valid, Value.State.Abiˉcontract,
            Value.State.Baseˉaddress, Value.State.Budgetˉremaining,
            Value.State.Allocationˉcount, Value.State.Regionˉcount,
            Value.State.Pointerˉcount, 0u32, Value.State.Scratchˉlive,
            Value.State.Scratchˉzeroˉinitialized,
            Value.State.Scratchˉlength, Value.State.Scratchˉalignment,
            Value.State.Scratchˉgeneration, Value.State.Regionˉlive,
            Value.State.Regionˉstart, Value.State.Regionˉlength,
            Value.State.Regionˉalignment, Value.State.Regionˉgeneration,
            false, Value.State.Pointerˉgeneration, Value.State.Evidenceˉbytes,
            Value.State.Sliceˉlive, Value.State.Sliceˉgeneration
        );
    let Forgedˉcallˉwithoutˉpointer:
        Foreign.Compilerˉsourceˉforeignˉmemoryˉstate =
        Foreign.Compilerˉsourceˉforeignˉmemoryˉstate(
            Empty.Valid, Empty.Abiˉcontract, Empty.Baseˉaddress,
            Empty.Budgetˉremaining, 0u32, 0u32, 0u32, 1u32,
            false, false, 0u64, 0u64, 0u32,
            false, 0u64, 0u64, 0u64, 0u32,
            false, 0u32, Empty.Evidenceˉbytes, false, 0u32
        );
    let Forgedˉcalledˉliveˉpointer:
        Foreign.Compilerˉsourceˉforeignˉmemoryˉstate =
        Foreign.Compilerˉsourceˉforeignˉmemoryˉstate(
            Value.State.Valid, Value.State.Abiˉcontract,
            Value.State.Baseˉaddress, Value.State.Budgetˉremaining,
            Value.State.Allocationˉcount, Value.State.Regionˉcount,
            Value.State.Pointerˉcount, 1u32, Value.State.Scratchˉlive,
            Value.State.Scratchˉzeroˉinitialized,
            Value.State.Scratchˉlength, Value.State.Scratchˉalignment,
            Value.State.Scratchˉgeneration, Value.State.Regionˉlive,
            Value.State.Regionˉstart, Value.State.Regionˉlength,
            Value.State.Regionˉalignment, Value.State.Regionˉgeneration,
            true, Value.State.Pointerˉgeneration, Value.State.Evidenceˉbytes,
            Value.State.Sliceˉlive, Value.State.Sliceˉgeneration
        );
    return !Foreign.Compilerˉsourceˉforeignˉmemoryˉstateˉisˉvalid(Forgedˉdead) &&
        !Foreign.Compilerˉsourceˉforeignˉmemoryˉstateˉisˉvalid(
            Forgedˉuncalledˉdeadˉpointer
        ) &&
        !Foreign.Compilerˉsourceˉforeignˉmemoryˉstateˉisˉvalid(
            Forgedˉcallˉwithoutˉpointer
        ) &&
        !Foreign.Compilerˉsourceˉforeignˉmemoryˉstateˉisˉvalid(
            Forgedˉcalledˉliveˉpointer
        ) &&
        Underreportedˉhistoryˉevidenceˉisˉrejected() &&
        Capacity.Status ==
            Foreign.Compilerˉsourceˉforeignˉsemanticˉstatus.Invalidˉcallˉcontract &&
        Capacity.Failureˉdomain ==
            Foreign.COMPILER_SOURCE_FOREIGN_FAILURE_DOMAIN_ADMISSION &&
        Capacity.Failureˉkind == 0u32 &&
        Capacity.First == 63u64 && Capacity.Second == 64u64 &&
        Capacity.Third == 64u64 && Capacity.State.Pointerˉlive &&
        Oversized.Status ==
            Foreign.Compilerˉsourceˉforeignˉsemanticˉstatus.Outˉofˉrange &&
        Oversized.Failureˉdomain ==
            Foreign.COMPILER_SOURCE_FOREIGN_FAILURE_DOMAIN_POINTER &&
        Oversized.Failureˉkind ==
            Foreign.COMPILER_SOURCE_FOREIGN_POINTER_FAILURE_OUT_OF_RANGE &&
        Oversized.First == 0u64 && Oversized.Second == 65u64 &&
        Oversized.Third == 64u64 && Oversized.State.Pointerˉlive &&
        Foreign.COMPILER_SOURCE_FOREIGN_SEMANTICS_ABI_MAXIMUM_BYTES == 64u64 &&
        Foreign.COMPILER_SOURCE_FOREIGN_SEMANTICS_ABI_MAXIMUM_ALIGNMENT == 8u64 &&
        Foreign.COMPILER_SOURCE_FOREIGN_SEMANTICS_MAXIMUM_ALLOCATIONS == 1u32 &&
        Foreign.COMPILER_SOURCE_FOREIGN_SEMANTICS_MAXIMUM_REGIONS == 1u32 &&
        Foreign.COMPILER_SOURCE_FOREIGN_SEMANTICS_MAXIMUM_POINTERS == 1u32 &&
        Foreign.COMPILER_SOURCE_FOREIGN_SEMANTICS_MAXIMUM_CALLS == 1u32 &&
        Foreign.COMPILER_SOURCE_FOREIGN_SEMANTICS_MAXIMUM_DIAGNOSTICS == 16u32 &&
        Foreign.COMPILER_SOURCE_FOREIGN_SEMANTICS_MAXIMUM_EVIDENCE_BYTES == 524288u32 &&
        Foreign.COMPILER_SOURCE_FOREIGN_SEMANTICS_MEMORY_ALLOCATE_EFFECT == 1u32 &&
        Foreign.COMPILER_SOURCE_FOREIGN_SEMANTICS_UNSAFE_ADDRESS_EFFECT == 128u32 &&
        Foreign.COMPILER_SOURCE_FOREIGN_SEMANTICS_FFI_CALL_EFFECT == 256u32;
}

fn Selectedˉcase() -> u32 {
    if process.argument_count() != 1u32 { return 0u32; }
    let Value: bytes = Textˉtoˉutf8(process.argument(0u32));
    if Bytesˉlength(Value) != 1u32 { return 0u32; }
    return U32ˉfromˉu8(Bytesˉreadˉu8(Value, 0u32));
}

export fn Main() -> i32 {
    let Selected: u32 = Selectedˉcase();
    if Selected == 97u32 && Caseˉopaqueˉidentities() { return 42; }
    if Selected == 98u32 && Caseˉmemoryˉeffect() { return 42; }
    if Selected == 99u32 && Caseˉunsafeˉaddressˉeffect() { return 42; }
    if Selected == 100u32 && Caseˉforeignˉoutsideˉunsafe() { return 42; }
    if Selected == 101u32 && Caseˉsafeˉimplicitˉunsafe() { return 42; }
    if Selected == 103u32 && Caseˉforbiddenˉbyˉvalue() { return 42; }
    if Selected == 104u32 && Caseˉzeroˉscratch() { return 42; }
    if Selected == 105u32 && Caseˉscratchˉmaximum() { return 42; }
    if Selected == 106u32 && Caseˉscratchˉalignment() { return 42; }
    if Selected == 107u32 && Caseˉallocationˉfailure() { return 42; }
    if Selected == 108u32 && Caseˉunsupportedˉabi() { return 42; }
    if Selected == 109u32 && Caseˉrelativeˉoverflow() { return 42; }
    if Selected == 110u32 && Caseˉnativeˉoverflow() { return 42; }
    if Selected == 111u32 && Caseˉoutˉofˉrange() { return 42; }
    if Selected == 112u32 && Caseˉmisaligned() { return 42; }
    if Selected == 113u32 && Caseˉoverlap() { return 42; }
    if Selected == 114u32 && Caseˉsliceˉalias() { return 42; }
    if Selected == 115u32 && Caseˉpointerˉescape() { return 42; }
    if Selected == 116u32 && Caseˉnoˉretain() { return 42; }
    if Selected == 117u32 && Caseˉpointerˉconversion() { return 42; }
    if Selected == 118u32 && Caseˉnullableˉnull() { return 42; }
    if Selected == 119u32 && Caseˉdereferenceˉproofs() { return 42; }
    if Selected == 120u32 && Caseˉnoˉunwind() { return 42; }
    if Selected == 121u32 && Caseˉlifecycle() { return 42; }
    if Selected == 122u32 && Caseˉstrictˉbounds() { return 42; }
    if Selected == 65u32 && Caseˉevidenceˉbound() { return 42; }
    if Selected == 66u32 && Caseˉproviderˉalignment() { return 42; }
    if Selected == 67u32 && Caseˉfailureˉordering() { return 42; }
    if Selected == 68u32 && Caseˉcontractˉbounds() { return 42; }
    return 1;
}
