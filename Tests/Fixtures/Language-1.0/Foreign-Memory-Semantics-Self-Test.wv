module Languageˉoneˉforeignˉmemoryˉsemanticsˉselfˉtest profile hosted;

import Compilerˉsourceˉforeignˉcatalog as Catalog;
import Compilerˉsourceˉforeignˉsemantics as Foreign;
import Compilerˉsourceˉtarget as Target;

capability process.argument;
capability process.argument_count;

fn Buildˉtarget() -> Target.Compilerˉsourceˉtargetˉdescriptor {
    return Target.Compilerˉsourceˉtargetˉdescriptor(
        Target.COMPILER_SOURCE_TARGET_BUILD_LINUX_X86_64_SYSV_AMD64_C_V1,
        Target.COMPILER_SOURCE_TARGET_ENVIRONMENT_LINUX,
        Target.COMPILER_SOURCE_TARGET_ARCHITECTURE_X86_64,
        Target.COMPILER_SOURCE_TARGET_ABI_SYSV_AMD64_C_V1,
        64u32,
        Target.COMPILER_SOURCE_TARGET_BYTE_ORDER_LITTLE,
        1u32
    );
}

fn Unsupportedˉtarget() -> Target.Compilerˉsourceˉtargetˉdescriptor {
    return Target.Compilerˉsourceˉtargetˉwindowsˉx86_64ˉnoneˉv1();
}

fn Operationˉcontext(
    Unsafeˉdepth: u32,
    Effects: u32
) -> Foreign.Compilerˉsourceˉforeignˉoperationˉcontext {
    return Foreign.Compilerˉsourceˉforeignˉoperationˉcontext(
        Foreign.COMPILER_SOURCE_FOREIGN_SEMANTICS_PROFILE_SYSTEM,
        Unsafeˉdepth,
        Effects
    );
}

fn Callˉcontext(
    Unsafeˉdepth: u32,
    Effects: u32,
    Capacity: u64,
    Retain: bool,
    Unwind: bool
) -> Foreign.Compilerˉsourceˉforeignˉcallˉcontext {
    return Foreign.Compilerˉsourceˉforeignˉcallˉcontext(
        Foreign.COMPILER_SOURCE_FOREIGN_SEMANTICS_PROFILE_SYSTEM,
        Unsafeˉdepth, Effects, Capacity, Retain, Unwind
    );
}

fn Dereferenceˉevidence(
    Pointerˉgeneration: u32,
    Ownerˉgeneration: u32,
    Offset: u64,
    Length: u64,
    Alignment: u64
) -> Foreign.Compilerˉsourceˉforeignˉdereferenceˉevidence {
    return Foreign.Compilerˉsourceˉforeignˉdereferenceˉevidence(
        Pointerˉgeneration, Ownerˉgeneration, Offset, Length, Alignment
    );
}

fn Exactˉcallable() -> Foreign.Compilerˉsourceˉforeignˉauthenticatedˉcallable {
    let Pointer: Foreign.Compilerˉsourceˉforeignˉtypeˉidentity =
        Foreign.Compilerˉsourceˉforeignˉtype(
            Foreign.Compilerˉsourceˉforeignˉtypeˉkind.Foreignˉpointer,
            Foreign.Compilerˉsourceˉforeignˉtypeˉkind.U8,
            Catalog.COMPILER_SOURCE_FOREIGN_ABI_CONTRACT_BUFFER_SYSV_AMD64_C_V1
        );
    let U64ˉtype: Foreign.Compilerˉsourceˉforeignˉtypeˉidentity =
        Foreign.Compilerˉsourceˉforeignˉscalarˉtype(
            Foreign.Compilerˉsourceˉforeignˉtypeˉkind.U64
        );
    let I64ˉtype: Foreign.Compilerˉsourceˉforeignˉtypeˉidentity =
        Foreign.Compilerˉsourceˉforeignˉscalarˉtype(
            Foreign.Compilerˉsourceˉforeignˉtypeˉkind.I64
        );
    return Foreign.Compilerˉsourceˉforeignˉauthenticatedˉcallable(
        Catalog.COMPILER_SOURCE_FOREIGN_ABI_CONTRACT_BUFFER_SYSV_AMD64_C_V1,
        Foreign.COMPILER_SOURCE_FOREIGN_SEMANTICS_SOURCE_NAME_BUFFER_READ,
        Foreign.COMPILER_SOURCE_FOREIGN_SEMANTICS_EXTERNAL_SYMBOL_BUFFER_READ,
        true,
        Foreign.COMPILER_SOURCE_FOREIGN_SEMANTICS_PROFILE_SYSTEM,
        Foreign.COMPILER_SOURCE_FOREIGN_SEMANTICS_FFI_CALL_EFFECT,
        Pointer, U64ˉtype, U64ˉtype, I64ˉtype, true, true
    );
}

fn Scratchˉwith(
    Base: u64,
    Budget: u64,
    Length: u64,
    Alignment: u64,
    Allocationˉreason: u32
) -> Foreign.Compilerˉsourceˉforeignˉsemanticˉresult {
    let State: Foreign.Compilerˉsourceˉforeignˉmemoryˉstate =
        Foreign.Compilerˉsourceˉforeignˉmemoryˉempty(
            Catalog.COMPILER_SOURCE_FOREIGN_ABI_CONTRACT_BUFFER_SYSV_AMD64_C_V1,
            Base, Budget
        );
    return Foreign.Compilerˉsourceˉforeignˉconstructˉscratch(
        Buildˉtarget(),
        Operationˉcontext(
            0u32,
            Foreign.COMPILER_SOURCE_FOREIGN_SEMANTICS_MEMORY_ALLOCATE_EFFECT
        ),
        State, Length, Alignment, Allocationˉreason
    );
}

fn Scratch(Base: u64) -> Foreign.Compilerˉsourceˉforeignˉsemanticˉresult {
    return Scratchˉwith(Base, 64u64, 64u64, 8u64, 0u32);
}

fn Region(Base: u64) -> Foreign.Compilerˉsourceˉforeignˉsemanticˉresult {
    let Owner: Foreign.Compilerˉsourceˉforeignˉsemanticˉresult = Scratch(Base);
    if Owner.Status != Foreign.Compilerˉsourceˉforeignˉsemanticˉstatus.Valid {
        return Owner;
    }
    return Foreign.Compilerˉsourceˉforeignˉborrowˉwriteˉregion(
        Buildˉtarget(),
        Operationˉcontext(
            1u32,
            Foreign.COMPILER_SOURCE_FOREIGN_SEMANTICS_UNSAFE_ADDRESS_EFFECT
        ),
        Owner.State, 1u32, 0u64, 64u64, 8u64
    );
}

fn Pointer(Base: u64) -> Foreign.Compilerˉsourceˉforeignˉsemanticˉresult {
    let Borrowed: Foreign.Compilerˉsourceˉforeignˉsemanticˉresult = Region(Base);
    if Borrowed.Status != Foreign.Compilerˉsourceˉforeignˉsemanticˉstatus.Valid {
        return Borrowed;
    }
    return Foreign.Compilerˉsourceˉforeignˉwriteˉpointer(
        Operationˉcontext(
            1u32,
            Foreign.COMPILER_SOURCE_FOREIGN_SEMANTICS_UNSAFE_ADDRESS_EFFECT
        ),
        Borrowed.State
    );
}

fn Foreignˉcall(
    Callable: Foreign.Compilerˉsourceˉforeignˉauthenticatedˉcallable,
    Context: Foreign.Compilerˉsourceˉforeignˉcallˉcontext,
    State: Foreign.Compilerˉsourceˉforeignˉmemoryˉstate
) -> Foreign.Compilerˉsourceˉforeignˉsemanticˉresult {
    return Foreign.Compilerˉsourceˉforeignˉadmitˉcall(
        Buildˉtarget(), Callable, Context, State
    );
}

fn Callableˉstatus(
    Callable: Foreign.Compilerˉsourceˉforeignˉauthenticatedˉcallable,
    State: Foreign.Compilerˉsourceˉforeignˉmemoryˉstate
) -> Foreign.Compilerˉsourceˉforeignˉsemanticˉstatus {
    let Result: Foreign.Compilerˉsourceˉforeignˉsemanticˉresult = Foreignˉcall(
        Callable, Callˉcontext(1u32, 256u32, 64u64, false, false), State
    );
    return Result.Status;
}

fn Forgedˉinvalidˉstate() -> Foreign.Compilerˉsourceˉforeignˉmemoryˉstate {
    return Foreign.Compilerˉsourceˉforeignˉmemoryˉstate(
        false,
        Catalog.COMPILER_SOURCE_FOREIGN_ABI_CONTRACT_BUFFER_SYSV_AMD64_C_V1,
        4096u64, 64u64, 0u32, 0u32, 0u32, 0u32,
        false, false, 0u64, 0u64, 0u32,
        false, 0u64, 0u64, 0u64, 0u32,
        false, 0u32, 0u32, false, 0u32
    );
}

fn Caseˉopaqueˉidentities() -> bool {
    let Pointerˉtype: Foreign.Compilerˉsourceˉforeignˉtypeˉidentity =
        Foreign.Compilerˉsourceˉforeignˉtype(
            Foreign.Compilerˉsourceˉforeignˉtypeˉkind.Foreignˉpointer,
            Foreign.Compilerˉsourceˉforeignˉtypeˉkind.U8, 1u32
        );
    let Nullableˉtype: Foreign.Compilerˉsourceˉforeignˉtypeˉidentity =
        Foreign.Compilerˉsourceˉforeignˉtype(
            Foreign.Compilerˉsourceˉforeignˉtypeˉkind.Nullableˉforeignˉpointer,
            Foreign.Compilerˉsourceˉforeignˉtypeˉkind.U8, 1u32
        );
    let Scratchˉtype: Foreign.Compilerˉsourceˉforeignˉtypeˉidentity =
        Foreign.Compilerˉsourceˉforeignˉtype(
            Foreign.Compilerˉsourceˉforeignˉtypeˉkind.Foreignˉscratch,
            Foreign.Compilerˉsourceˉforeignˉtypeˉkind.Unknown, 1u32
        );
    let Regionˉtype: Foreign.Compilerˉsourceˉforeignˉtypeˉidentity =
        Foreign.Compilerˉsourceˉforeignˉtype(
            Foreign.Compilerˉsourceˉforeignˉtypeˉkind.Foreignˉwriteˉregion,
            Foreign.Compilerˉsourceˉforeignˉtypeˉkind.Unknown, 1u32
        );
    return Pointerˉtype.Kind != Nullableˉtype.Kind &&
        Nullableˉtype.Kind != Scratchˉtype.Kind &&
        Scratchˉtype.Kind != Regionˉtype.Kind &&
        Foreign.Compilerˉsourceˉforeignˉtypeˉisˉopaque(Pointerˉtype) &&
        Foreign.Compilerˉsourceˉforeignˉtypeˉisˉopaque(Nullableˉtype) &&
        Foreign.Compilerˉsourceˉforeignˉtypeˉisˉopaque(Scratchˉtype) &&
        Foreign.Compilerˉsourceˉforeignˉtypeˉisˉopaque(Regionˉtype) &&
        Foreign.Compilerˉsourceˉforeignˉtypeˉisˉwellˉformed(Pointerˉtype) &&
        Foreign.Compilerˉsourceˉforeignˉtypeˉisˉwellˉformed(Nullableˉtype);
}

fn Caseˉmemoryˉeffect() -> bool {
    let State: Foreign.Compilerˉsourceˉforeignˉmemoryˉstate =
        Foreign.Compilerˉsourceˉforeignˉmemoryˉempty(1u32, 4096u64, 64u64);
    let Result: Foreign.Compilerˉsourceˉforeignˉsemanticˉresult =
        Foreign.Compilerˉsourceˉforeignˉconstructˉscratch(
            Buildˉtarget(), Operationˉcontext(0u32, 128u32 | 256u32),
            State, 64u64, 8u64, 0u32
        );
    return Result.Status ==
        Foreign.Compilerˉsourceˉforeignˉsemanticˉstatus.Memoryˉallocateˉeffectˉrequired;
}

fn Caseˉunsafeˉaddressˉeffect() -> bool {
    let Owner: Foreign.Compilerˉsourceˉforeignˉsemanticˉresult = Scratch(4096u64);
    let Missingˉcontext: Foreign.Compilerˉsourceˉforeignˉsemanticˉresult =
        Foreign.Compilerˉsourceˉforeignˉborrowˉwriteˉregion(
            Buildˉtarget(), Operationˉcontext(0u32, 128u32),
            Owner.State, 1u32, 0u64, 64u64, 8u64
        );
    let Missingˉeffect: Foreign.Compilerˉsourceˉforeignˉsemanticˉresult =
        Foreign.Compilerˉsourceˉforeignˉborrowˉwriteˉregion(
            Buildˉtarget(), Operationˉcontext(1u32, 256u32),
            Owner.State, 1u32, 0u64, 64u64, 8u64
        );
    return Missingˉcontext.Status ==
            Foreign.Compilerˉsourceˉforeignˉsemanticˉstatus.Unsafeˉcontextˉrequired &&
        Missingˉeffect.Status ==
            Foreign.Compilerˉsourceˉforeignˉsemanticˉstatus.Unsafeˉaddressˉeffectˉrequired;
}

fn Caseˉforeignˉoutsideˉunsafe() -> bool {
    let Value: Foreign.Compilerˉsourceˉforeignˉsemanticˉresult = Pointer(4096u64);
    let Result: Foreign.Compilerˉsourceˉforeignˉsemanticˉresult = Foreignˉcall(
        Exactˉcallable(), Callˉcontext(0u32, 256u32, 64u64, false, false),
        Value.State
    );
    let Missingˉeffect: Foreign.Compilerˉsourceˉforeignˉsemanticˉresult =
        Foreignˉcall(
            Exactˉcallable(), Callˉcontext(1u32, 128u32, 64u64, false, false),
            Value.State
        );
    return Result.Status ==
            Foreign.Compilerˉsourceˉforeignˉsemanticˉstatus.Unsafeˉcontextˉrequired &&
        Missingˉeffect.Status ==
            Foreign.Compilerˉsourceˉforeignˉsemanticˉstatus.Ffiˉeffectˉrequired;
}

fn Caseˉsafeˉimplicitˉunsafe() -> bool {
    let State: Foreign.Compilerˉsourceˉforeignˉmemoryˉstate =
        Foreign.Compilerˉsourceˉforeignˉmemoryˉempty(1u32, 4096u64, 64u64);
    let Result: Foreign.Compilerˉsourceˉforeignˉsemanticˉresult =
        Foreign.Compilerˉsourceˉforeignˉadmitˉunsafeˉinvocation(
            Operationˉcontext(0u32, 0u32), true, State
        );
    let Forged: Foreign.Compilerˉsourceˉforeignˉsemanticˉresult =
        Foreign.Compilerˉsourceˉforeignˉadmitˉunsafeˉinvocation(
            Operationˉcontext(1u32, 0u32), true, Forgedˉinvalidˉstate()
        );
    return Result.Status ==
            Foreign.Compilerˉsourceˉforeignˉsemanticˉstatus.Unsafeˉcontextˉrequired &&
        Forged.Status ==
            Foreign.Compilerˉsourceˉforeignˉsemanticˉstatus.Invalidˉevidence;
}

fn Callableˉtailˉmutationsˉareˉrejected() -> bool {
    let Exact: Foreign.Compilerˉsourceˉforeignˉauthenticatedˉcallable =
        Exactˉcallable();
    let Wrongˉscalar: Foreign.Compilerˉsourceˉforeignˉtypeˉidentity =
        Foreign.Compilerˉsourceˉforeignˉscalarˉtype(
            Foreign.Compilerˉsourceˉforeignˉtypeˉkind.Bool
        );
    let Value: Foreign.Compilerˉsourceˉforeignˉsemanticˉresult = Pointer(4096u64);
    let Wrongˉgeneration: Foreign.Compilerˉsourceˉforeignˉauthenticatedˉcallable =
        Foreign.Compilerˉsourceˉforeignˉauthenticatedˉcallable(
            Exact.Abiˉcontract, Exact.Sourceˉname, Exact.Externalˉsymbol,
            Exact.Unsafe, Exact.Profile, Exact.Languageˉeffects,
            Exact.Destination, Exact.Capacity, Wrongˉscalar,
            Exact.Return, true, true
        );
    let Wrongˉreturn: Foreign.Compilerˉsourceˉforeignˉauthenticatedˉcallable =
        Foreign.Compilerˉsourceˉforeignˉauthenticatedˉcallable(
            Exact.Abiˉcontract, Exact.Sourceˉname, Exact.Externalˉsymbol,
            Exact.Unsafe, Exact.Profile, Exact.Languageˉeffects,
            Exact.Destination, Exact.Capacity, Exact.Expectedˉgeneration,
            Wrongˉscalar, true, true
        );
    let Wrongˉabi: Foreign.Compilerˉsourceˉforeignˉauthenticatedˉcallable =
        Foreign.Compilerˉsourceˉforeignˉauthenticatedˉcallable(
            0u32, Exact.Sourceˉname, Exact.Externalˉsymbol, Exact.Unsafe,
            Exact.Profile, Exact.Languageˉeffects, Exact.Destination,
            Exact.Capacity, Exact.Expectedˉgeneration, Exact.Return, true, true
        );
    let Wrongˉprofile: Foreign.Compilerˉsourceˉforeignˉauthenticatedˉcallable =
        Foreign.Compilerˉsourceˉforeignˉauthenticatedˉcallable(
            Exact.Abiˉcontract, Exact.Sourceˉname, Exact.Externalˉsymbol,
            Exact.Unsafe, 2u32, Exact.Languageˉeffects, Exact.Destination,
            Exact.Capacity, Exact.Expectedˉgeneration, Exact.Return, true, true
        );
    let Safeˉflag: Foreign.Compilerˉsourceˉforeignˉauthenticatedˉcallable =
        Foreign.Compilerˉsourceˉforeignˉauthenticatedˉcallable(
            Exact.Abiˉcontract, Exact.Sourceˉname, Exact.Externalˉsymbol,
            false, Exact.Profile, Exact.Languageˉeffects, Exact.Destination,
            Exact.Capacity, Exact.Expectedˉgeneration, Exact.Return, true, true
        );
    let Retaining: Foreign.Compilerˉsourceˉforeignˉauthenticatedˉcallable =
        Foreign.Compilerˉsourceˉforeignˉauthenticatedˉcallable(
            Exact.Abiˉcontract, Exact.Sourceˉname, Exact.Externalˉsymbol,
            Exact.Unsafe, Exact.Profile, Exact.Languageˉeffects,
            Exact.Destination, Exact.Capacity, Exact.Expectedˉgeneration,
            Exact.Return, false, true
        );
    let Unwinding: Foreign.Compilerˉsourceˉforeignˉauthenticatedˉcallable =
        Foreign.Compilerˉsourceˉforeignˉauthenticatedˉcallable(
            Exact.Abiˉcontract, Exact.Sourceˉname, Exact.Externalˉsymbol,
            Exact.Unsafe, Exact.Profile, Exact.Languageˉeffects,
            Exact.Destination, Exact.Capacity, Exact.Expectedˉgeneration,
            Exact.Return, true, false
        );
    let Invalidˉsignature: Foreign.Compilerˉsourceˉforeignˉsemanticˉstatus =
        Foreign.Compilerˉsourceˉforeignˉsemanticˉstatus.Invalidˉforeignˉsignature;
    return Callableˉstatus(Wrongˉgeneration, Value.State) == Invalidˉsignature &&
        Callableˉstatus(Wrongˉreturn, Value.State) == Invalidˉsignature &&
        Callableˉstatus(Wrongˉabi, Value.State) ==
            Foreign.Compilerˉsourceˉforeignˉsemanticˉstatus.Unsupportedˉabi &&
        Callableˉstatus(Wrongˉprofile, Value.State) ==
            Foreign.Compilerˉsourceˉforeignˉsemanticˉstatus.Systemˉprofileˉrequired &&
        Callableˉstatus(Safeˉflag, Value.State) ==
            Foreign.Compilerˉsourceˉforeignˉsemanticˉstatus.Unsafeˉcontextˉrequired &&
        Callableˉstatus(Retaining, Value.State) ==
            Foreign.Compilerˉsourceˉforeignˉsemanticˉstatus.Noˉretainˉrequired &&
        Callableˉstatus(Unwinding, Value.State) ==
            Foreign.Compilerˉsourceˉforeignˉsemanticˉstatus.Noˉunwindˉrequired;
}

fn Caseˉforbiddenˉbyˉvalue() -> bool {
    let Exact: Foreign.Compilerˉsourceˉforeignˉauthenticatedˉcallable =
        Exactˉcallable();
    let Wrongˉdestination: Foreign.Compilerˉsourceˉforeignˉauthenticatedˉcallable =
        Foreign.Compilerˉsourceˉforeignˉauthenticatedˉcallable(
            Exact.Abiˉcontract, Exact.Sourceˉname, Exact.Externalˉsymbol,
            Exact.Unsafe, Exact.Profile, Exact.Languageˉeffects,
            Foreign.Compilerˉsourceˉforeignˉscalarˉtype(
                Foreign.Compilerˉsourceˉforeignˉtypeˉkind.Bool
            ),
            Exact.Capacity, Exact.Expectedˉgeneration, Exact.Return,
            true, true
        );
    let Wrongˉscalar: Foreign.Compilerˉsourceˉforeignˉtypeˉidentity =
        Foreign.Compilerˉsourceˉforeignˉscalarˉtype(
            Foreign.Compilerˉsourceˉforeignˉtypeˉkind.Bool
        );
    let Value: Foreign.Compilerˉsourceˉforeignˉsemanticˉresult = Pointer(4096u64);
    let Wrongˉsource: Foreign.Compilerˉsourceˉforeignˉauthenticatedˉcallable =
        Foreign.Compilerˉsourceˉforeignˉauthenticatedˉcallable(
            Exact.Abiˉcontract, 0u32, Exact.Externalˉsymbol, Exact.Unsafe,
            Exact.Profile, Exact.Languageˉeffects, Exact.Destination,
            Exact.Capacity, Exact.Expectedˉgeneration, Exact.Return, true, true
        );
    let Wrongˉsymbol: Foreign.Compilerˉsourceˉforeignˉauthenticatedˉcallable =
        Foreign.Compilerˉsourceˉforeignˉauthenticatedˉcallable(
            Exact.Abiˉcontract, Exact.Sourceˉname, 0u32, Exact.Unsafe,
            Exact.Profile, Exact.Languageˉeffects, Exact.Destination,
            Exact.Capacity, Exact.Expectedˉgeneration, Exact.Return, true, true
        );
    let Wrongˉeffect: Foreign.Compilerˉsourceˉforeignˉauthenticatedˉcallable =
        Foreign.Compilerˉsourceˉforeignˉauthenticatedˉcallable(
            Exact.Abiˉcontract, Exact.Sourceˉname, Exact.Externalˉsymbol,
            Exact.Unsafe, Exact.Profile, 0u32, Exact.Destination,
            Exact.Capacity, Exact.Expectedˉgeneration, Exact.Return, true, true
        );
    let Wrongˉcapacity: Foreign.Compilerˉsourceˉforeignˉauthenticatedˉcallable =
        Foreign.Compilerˉsourceˉforeignˉauthenticatedˉcallable(
            Exact.Abiˉcontract, Exact.Sourceˉname, Exact.Externalˉsymbol,
            Exact.Unsafe, Exact.Profile, Exact.Languageˉeffects,
            Exact.Destination, Wrongˉscalar, Exact.Expectedˉgeneration,
            Exact.Return, true, true
        );
    let Invalidˉsignature: Foreign.Compilerˉsourceˉforeignˉsemanticˉstatus =
        Foreign.Compilerˉsourceˉforeignˉsemanticˉstatus.Invalidˉforeignˉsignature;
    return Callableˉstatus(Wrongˉdestination, Value.State) == Invalidˉsignature &&
        Callableˉstatus(Wrongˉsource, Value.State) == Invalidˉsignature &&
        Callableˉstatus(Wrongˉsymbol, Value.State) == Invalidˉsignature &&
        Callableˉstatus(Wrongˉeffect, Value.State) == Invalidˉsignature &&
        Callableˉstatus(Wrongˉcapacity, Value.State) == Invalidˉsignature &&
        Callableˉtailˉmutationsˉareˉrejected();
}

fn Caseˉzeroˉscratch() -> bool {
    let Result: Foreign.Compilerˉsourceˉforeignˉsemanticˉresult =
        Scratchˉwith(4096u64, 64u64, 0u64, 8u64, 0u32);
    return Result.Status == Foreign.Compilerˉsourceˉforeignˉsemanticˉstatus.Invalidˉlength &&
        Result.Failureˉdomain == Foreign.COMPILER_SOURCE_FOREIGN_FAILURE_DOMAIN_MEMORY &&
        Result.Failureˉkind == Foreign.COMPILER_SOURCE_FOREIGN_MEMORY_FAILURE_INVALID_LENGTH &&
        Result.First == 0u64 && Result.Second == 64u64 &&
        Result.State.Allocationˉcount == 0u32;
}

fn Caseˉscratchˉmaximum() -> bool {
    let Large: Foreign.Compilerˉsourceˉforeignˉsemanticˉresult =
        Scratchˉwith(4096u64, 128u64, 65u64, 8u64, 0u32);
    let Budget: Foreign.Compilerˉsourceˉforeignˉsemanticˉresult =
        Scratchˉwith(4096u64, 63u64, 64u64, 8u64, 0u32);
    return Large.Status == Foreign.Compilerˉsourceˉforeignˉsemanticˉstatus.Invalidˉlength &&
        Budget.Status == Foreign.Compilerˉsourceˉforeignˉsemanticˉstatus.Allocationˉfailure &&
        Budget.Third == 1u64;
}

fn Caseˉscratchˉalignment() -> bool {
    let Zero: Foreign.Compilerˉsourceˉforeignˉsemanticˉresult =
        Scratchˉwith(4096u64, 64u64, 64u64, 0u64, 0u32);
    let Three: Foreign.Compilerˉsourceˉforeignˉsemanticˉresult =
        Scratchˉwith(4096u64, 64u64, 64u64, 3u64, 0u32);
    let Large: Foreign.Compilerˉsourceˉforeignˉsemanticˉresult =
        Scratchˉwith(4096u64, 64u64, 64u64, 16u64, 0u32);
    return Zero.Status == Foreign.Compilerˉsourceˉforeignˉsemanticˉstatus.Invalidˉalignment &&
        Three.Status == Foreign.Compilerˉsourceˉforeignˉsemanticˉstatus.Invalidˉalignment &&
        Large.Status == Foreign.Compilerˉsourceˉforeignˉsemanticˉstatus.Invalidˉalignment;
}

fn Caseˉallocationˉfailure() -> bool {
    let Result: Foreign.Compilerˉsourceˉforeignˉsemanticˉresult =
        Scratchˉwith(4096u64, 64u64, 64u64, 8u64, 3u32);
    return Result.Status == Foreign.Compilerˉsourceˉforeignˉsemanticˉstatus.Allocationˉfailure &&
        Result.Failureˉkind == Foreign.COMPILER_SOURCE_FOREIGN_MEMORY_FAILURE_ALLOCATION &&
        Result.Third == 3u64 && Result.State.Allocationˉcount == 0u32;
}

fn Caseˉunsupportedˉabi() -> bool {
    let State: Foreign.Compilerˉsourceˉforeignˉmemoryˉstate =
        Foreign.Compilerˉsourceˉforeignˉmemoryˉempty(0u32, 4096u64, 64u64);
    let Result: Foreign.Compilerˉsourceˉforeignˉsemanticˉresult =
        Foreign.Compilerˉsourceˉforeignˉconstructˉscratch(
            Buildˉtarget(), Operationˉcontext(0u32, 1u32),
            State, 64u64, 8u64, 0u32
        );
    let Exactˉstate: Foreign.Compilerˉsourceˉforeignˉmemoryˉstate =
        Foreign.Compilerˉsourceˉforeignˉmemoryˉempty(1u32, 4096u64, 64u64);
    let Targetˉresult: Foreign.Compilerˉsourceˉforeignˉsemanticˉresult =
        Foreign.Compilerˉsourceˉforeignˉconstructˉscratch(
            Unsupportedˉtarget(), Operationˉcontext(0u32, 1u32),
            Exactˉstate, 64u64, 8u64, 0u32
        );
    return Result.Status == Foreign.Compilerˉsourceˉforeignˉsemanticˉstatus.Unsupportedˉabi &&
        Result.Failureˉkind ==
            Foreign.COMPILER_SOURCE_FOREIGN_MEMORY_FAILURE_UNSUPPORTED_ABI &&
        Targetˉresult.Status ==
            Foreign.Compilerˉsourceˉforeignˉsemanticˉstatus.Unsupportedˉtarget;
}

fn Caseˉrelativeˉoverflow() -> bool {
    let Owner: Foreign.Compilerˉsourceˉforeignˉsemanticˉresult = Scratch(4096u64);
    let Result: Foreign.Compilerˉsourceˉforeignˉsemanticˉresult =
        Foreign.Compilerˉsourceˉforeignˉborrowˉwriteˉregion(
            Buildˉtarget(), Operationˉcontext(1u32, 128u32), Owner.State,
            1u32, 18446744073709551615u64, 2u64, 8u64
        );
    return Result.Status == Foreign.Compilerˉsourceˉforeignˉsemanticˉstatus.Addressˉoverflow &&
        Result.First == 18446744073709551615u64 && Result.Second == 2u64;
}

fn Caseˉnativeˉoverflow() -> bool {
    let Owner: Foreign.Compilerˉsourceˉforeignˉsemanticˉresult =
        Scratch(18446744073709551552u64);
    let Result: Foreign.Compilerˉsourceˉforeignˉsemanticˉresult =
        Foreign.Compilerˉsourceˉforeignˉborrowˉwriteˉregion(
            Buildˉtarget(), Operationˉcontext(1u32, 128u32), Owner.State,
            1u32, 0u64, 64u64, 8u64
