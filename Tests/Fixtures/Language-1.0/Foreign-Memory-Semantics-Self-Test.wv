    let Releasedˉscratch: Foreign.Compilerˉsourceˉforeignˉsemanticˉresult =
        Foreign.Compilerˉsourceˉforeignˉreleaseˉscratch(Releasedˉslice.State);
    return Called.Status == Foreign.Compilerˉsourceˉforeignˉsemanticˉstatus.Valid &&
        !Called.State.Pointerˉlive && Called.State.Callˉcount == 1u32 &&
        Stale.Status == Foreign.Compilerˉsourceˉforeignˉsemanticˉstatus.Lifetimeˉended &&
