#!wv/1 en@1
module Languageˉoneˉusingˉvectorˉtryˉpropagation;
profile core;
platform linux, windows, windvale;
authority application;

import Foundationˉcollections as Collections;
import Foundationˉmemory as Memory;
import Foundationˉresult as Resultˉvalues;

export fn Exercise(
    Value: Collections.Vector<i32>,
    Outcome: Resultˉvalues.Result<i32, Memory.Allocationˉfailure>
) -> Resultˉvalues.Result<i32, Memory.Allocationˉfailure> {
    using Resource = Value {
        let Number: i32 = try Outcome;
        return Resultˉvalues.Result.Valid<i32, Memory.Allocationˉfailure> {
            Value: Number
        };
    }
}

export fn Main(Budget: Memory.Memoryˉbudget) -> i32 {
    return 42;
}
