#!wv/1 en@1
module Languageˉoneˉvectorˉappendˉexecutable;
profile core;
platform linux, windows, windvale;
authority application;

import Foundationˉcollections as Collections;
import Foundationˉmemory as Memory;
import Foundationˉresult as Resultˉvalues;

fn Verifyˉcapacityˉrefusal(
    Failure: Collections.Vectorˉappendˉfailure<i32>
) -> i32 {
    if Failure.Value != 9 { return 2; }
    return match Failure.Error {
        case Collections.Collectionˉfailure.Invalidˉlimit {
            Field: Field,
            Observed: Observed,
            Minimum: Minimum,
            Maximum: Invalidˉmaximum,
        } { 3 }
        case Collections.Collectionˉfailure.Allocation { Error: Error } { 4 }
        case Collections.Collectionˉfailure.Capacityˉexhausted {
            Maximum: Maximum,
        } {
            if Maximum == 1u64 { 42 } else { 5 }
        }
        case Collections.Collectionˉfailure.Duplicate { 6 }
        case Collections.Collectionˉfailure.Comparisonˉlimit {
            Maximum: Comparisonˉmaximum,
        } { 7 }
        case Collections.Collectionˉfailure.Wrongˉarena { 8 }
        case Collections.Collectionˉfailure.Slotˉoutˉofˉrange {
            Slot: Slot,
            Maximum: Slotˉmaximum,
        } { 9 }
        case Collections.Collectionˉfailure.Vacant { Slot: Vacantˉslot } { 10 }
        case Collections.Collectionˉfailure.Staleˉgeneration {
            Expected: Expected,
            Observed: Staleˉobserved,
        } { 11 }
        case Collections.Collectionˉfailure.Retired { Slot: Retiredˉslot } { 12 }
    };
}

export fn Main(Budget: Memory.Memoryˉbudget) -> i32 {
    let Outcome: Resultˉvalues.Result<
        Collections.Vector<i32>,
        Memory.Allocationˉfailure
    > = Collections.Vectorˉconstructˉreserved::<i32>(Budget, 1u64);
    return match Outcome {
        case Resultˉvalues.Result.Valid { Value: Constructedˉvalues } {
            var Values: Collections.Vector<i32> = Constructedˉvalues;
            let First: Resultˉvalues.Result<
                unit,
                Collections.Vectorˉappendˉfailure<i32>
            > = Collections.Vectorˉappend::<i32>(borrow mut Values, 7);
            match First {
                case Resultˉvalues.Result.Valid { Value: Accepted } {
                    let Second: Resultˉvalues.Result<
                        unit,
                        Collections.Vectorˉappendˉfailure<i32>
                    > = Collections.Vectorˉappend::<i32>(
                        borrow mut Values,
                        9
                    );
                    match Second {
                        case Resultˉvalues.Result.Valid {
                            Value: Unexpected,
                        } { 13 }
                        case Resultˉvalues.Result.Failure {
                            Error: Appendˉfailure,
                        } {
                            Verifyˉcapacityˉrefusal(Appendˉfailure)
                        }
                    }
                }
                case Resultˉvalues.Result.Failure {
                    Error: Firstˉfailure,
                } { 14 }
            }
        }
        case Resultˉvalues.Result.Failure { Error: Failure } { 15 }
    };
}
