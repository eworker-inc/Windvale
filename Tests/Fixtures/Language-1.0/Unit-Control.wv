#!wv/1 en@1
module UnitˉControl;
profile core;
platform linux, windows, windvale;
authority application;

record Unitˉbox {
    Marker: unit;
    Value: i32;
}

fn Explicitˉunit() -> unit {
    return ();
}

fn Forwardˉunit() -> unit {
    return Explicitˉunit();
}

fn Implicitˉunit() -> unit {
    Forwardˉunit();
}

fn Copyˉunit(Value: unit) -> unit {
    let Copy: unit = Value;
    var Mutable: unit = Copy;
    Mutable = ();
    return Mutable;
}

export fn Main() -> i32 {
    Explicitˉunit();
    Forwardˉunit();
    Implicitˉunit();
    let Box: Unitˉbox = Unitˉbox {
        Marker: Copyˉunit(()),
        Value: 42,
    };
    let Marker: unit = Box.Marker;
    Copyˉunit(Marker);
    return Box.Value;
}
