#!wv/1 en@1
module ValueˉControl;
profile core;
platform linux, windows, windvale;
authority application;

export fn Main() -> i32 {
    let Enabled: bool = true;
    let Value: i32 = if Enabled {
        var Base: i32 = 40;
        let Increment: i32 = 1;
        Base += Increment;
        Base += 1;
        Base
    } else if false {
        1
    } else {
        0
    };
    return Value;
}
