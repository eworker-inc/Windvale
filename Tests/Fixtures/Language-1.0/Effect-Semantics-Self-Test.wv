}

fn Ffiˉcallˉorderˉandˉduplicateˉprobe() -> i32 {
    let First: Effects.Compilerˉsourceˉeffectˉset = Resolveˉclause(
        Program(
            "Effectˉffiˉcallˉorderˉfirst",
            "export fn Main() -> i32 effects(ffi.call, memory.allocate) { return 42; }"
        ),
        0u32
    );
    let Second: Effects.Compilerˉsourceˉeffectˉset = Resolveˉclause(
        Program(
            "Effectˉffiˉcallˉorderˉsecond",
            "export fn Main() -> i32 effects(memory.allocate, ffi.call) { return 42; }"
        ),
        0u32
    );
    let Duplicate: Effects.Compilerˉsourceˉeffectˉset = Resolveˉclause(
        Program(
            "Effectˉffiˉcallˉduplicate",
            "export fn Main() -> i32 effects(ffi.call, ffi.call) { return 42; }"
        ),
        0u32
    );
    if First.Status != Effects.Compilerˉsourceˉeffectˉstatus.Valid ||
        Second.Status != Effects.Compilerˉsourceˉeffectˉstatus.Valid ||
        First.Language != 257u32 || Second.Language != 257u32 ||
        First.Capabilities != 0u32 || Second.Capabilities != 0u32 ||
        First.Count != 2u32 || Second.Count != 2u32 ||
        Duplicate.Status !=
            Effects.Compilerˉsourceˉeffectˉstatus.Duplicateˉidentity {
        return 40;
    }
    return 42;
}

