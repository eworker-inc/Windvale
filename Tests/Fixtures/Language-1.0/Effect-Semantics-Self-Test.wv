        Wirˉfunction(0u32, 0u32, 1u32),
        1u32, Wirˉoperation(171u32, 0u32)
    );
    if Prepared.Status != Effects.Compilerˉsourceˉeffectˉstatus.Valid ||
        Effects.Compilerˉsourceˉeffectsˉfunctionˉlanguage(
            Prepared.Directory, 0u32
