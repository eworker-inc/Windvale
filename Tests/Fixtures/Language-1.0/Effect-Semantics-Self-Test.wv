module Languageˉoneˉeffectˉsemanticsˉselfˉtest profile hosted;

import Compilerˉsourceˉbindings as Bindings;
import Compilerˉsourceˉdeclarationˉparser as Declarations;
import Compilerˉsourceˉeffects as Effects;
import Compilerˉsourceˉset as Sourceˉset;
import Compilerˉsourceˉsymbols as Symbols;
import Foundationˉbyteˉconstruction as Byteˉconstruction;

capability process.argument;
capability process.argument_count;

fn Selectedˉcase() -> u32 {
    if process.argument_count() != 1u32 { return 0u32; }
    let Argument: bytes = Textˉtoˉutf8(process.argument(0u32));
    if Bytesˉlength(Argument) != 1u32 { return 0u32; }
    return U32ˉfromˉu8(Bytesˉreadˉu8(Argument, 0u32));
}

fn Sourceˉsetˉfrom(Source: text) -> bytes {
    let Body: bytes = Textˉtoˉutf8(Source);
    var Result: bytes = Textˉtoˉutf8("WVSS");
    Result = Bytesˉconcat(Result, Bytesˉfromˉu16ˉlittle(2u32));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu16ˉlittle(0u32));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(1u32));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(20u32));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(36u32));
    Result = Bytesˉconcat(
        Result, Bytesˉfromˉu32ˉlittle(Bytesˉlength(Body))
    );
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(1u32));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(1u32));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(12u32));
    return Bytesˉconcat(Result, Body);
}

fn Zeroes(Count: u32) -> bytes {
    let Repeated: Byteˉconstruction.Foundationˉbytesˉresult =
        Byteˉconstruction.Foundationˉbytesˉrepeat(0u8, Count);
    return Repeated.Value;
}

fn Bindingˉsummary(
    Input: bytes,
    Symbolsˉvalue: Symbols.Compilerˉsourceˉsymbolˉsummary,
    Functions: u32
) -> Bindings.Compilerˉsourceˉbindingˉsummary {
    let Directory: bytes = Bytesˉconcat(
        Bindings.Compilerˉsourceˉbindingsˉheader(0u32, Functions),
        Zeroes(Functions * 8u32)
    );
    return Bindings.Compilerˉsourceˉbindingˉsummary(
        Bindings.Compilerˉsourceˉbindingˉstatus.Valid,
        Symbols.Compilerˉsourceˉsymbolˉstatus.Valid,
        1u32, Functions,
        0u32, 0u32, 0u32, 0u32, 0u32,
        Directory,
        1u32, 1u32, Functions, Bytesˉlength(Input), 0u32, 0u32
    );
}

fn Wirˉfunction(
    Firstˉblock: u32,
    Firstˉoperation: u32,
    Operations: u32
) -> bytes {
    var Entry: bytes = Bytesˉfromˉu32ˉlittle(0u32);
    Entry = Bytesˉconcat(Entry, Bytesˉfromˉu32ˉlittle(Firstˉblock));
    Entry = Bytesˉconcat(Entry, Bytesˉfromˉu32ˉlittle(1u32));
    Entry = Bytesˉconcat(Entry, Bytesˉfromˉu32ˉlittle(Firstˉoperation));
    Entry = Bytesˉconcat(Entry, Bytesˉfromˉu32ˉlittle(Operations));
    return Bytesˉconcat(Entry, Zeroes(28u32));
}

fn Wirˉoperation(Kind: u32, Target: u32) -> bytes {
    var Entry: bytes = Bytesˉfromˉu32ˉlittle(0u32);
    Entry = Bytesˉconcat(Entry, Bytesˉfromˉu16ˉlittle(Kind));
    Entry = Bytesˉconcat(Entry, Bytesˉfromˉu16ˉlittle(0u32));
    Entry = Bytesˉconcat(Entry, Zeroes(12u32));
    Entry = Bytesˉconcat(Entry, Bytesˉfromˉu32ˉlittle(Target));
    return Bytesˉconcat(Entry, Bytesˉfromˉu32ˉlittle(0u32));
}

fn Wirˉdirectory(
    Functionˉentries: bytes,
    Blocks: u32,
    Operationˉentries: bytes
) -> bytes {
    let Functions: u32 = Bytesˉlength(Functionˉentries) / 48u32;
    let Operations: u32 = Bytesˉlength(Operationˉentries) / 28u32;
    var Header: bytes = Textˉtoˉutf8("WVIR");
    Header = Bytesˉconcat(Header, Bytesˉfromˉu16ˉlittle(1u32));
    Header = Bytesˉconcat(Header, Bytesˉfromˉu16ˉlittle(9u32));
    Header = Bytesˉconcat(Header, Bytesˉfromˉu32ˉlittle(Functions));
    Header = Bytesˉconcat(Header, Bytesˉfromˉu32ˉlittle(48u32));
    Header = Bytesˉconcat(Header, Bytesˉfromˉu32ˉlittle(Blocks));
    Header = Bytesˉconcat(Header, Bytesˉfromˉu32ˉlittle(28u32));
    Header = Bytesˉconcat(Header, Bytesˉfromˉu32ˉlittle(Operations));
    Header = Bytesˉconcat(Header, Bytesˉfromˉu32ˉlittle(28u32));
    Header = Bytesˉconcat(Header, Bytesˉfromˉu32ˉlittle(0u32));
    Header = Bytesˉconcat(Header, Bytesˉfromˉu32ˉlittle(4u32));
    Header = Bytesˉconcat(Header, Bytesˉfromˉu32ˉlittle(0u32));
    Header = Bytesˉconcat(Header, Bytesˉfromˉu32ˉlittle(4u32));
    return Bytesˉconcat(
        Header,
        Bytesˉconcat(
            Functionˉentries,
            Bytesˉconcat(Zeroes(Blocks * 28u32), Operationˉentries)
        )
    );
}

fn Program(Name: text, Body: text) -> text {
    return Textˉconcat(
        Textˉconcat(
            Textˉconcat(
                Textˉconcat("module ", Name),
                "; profile core; platform linux, windows, windvale; authority application; "
            ),
            Body
        ),
        ""
    );
}

fn Pureˉinput(Name: text) -> bytes {
    return Sourceˉsetˉfrom(
        Program(
            Name,
            "export fn Main() -> i32 effects() { return 42; }"
        )
    );
}

fn Resolveˉclause(
    Source: text,
    Declarationˉindex: u32
) -> Effects.Compilerˉsourceˉeffectˉset {
    let Sourceˉbytes: bytes = Textˉtoˉutf8(Source);
    let Input: bytes = Sourceˉsetˉfrom(Source);
    let Scan: Sourceˉset.Compilerˉsourceˉsetˉscan =
        Sourceˉset.Compilerˉscanˉsourceˉset(Input);
    let Symbolˉsummary: Symbols.Compilerˉsourceˉsymbolˉsummary =
        Symbols.Compilerˉvalidateˉsourceˉsymbols(Input);
    let Declaration: Declarations.Compilerˉsourceˉdeclaration =
        Declarations.Compilerˉparseˉdeclarationˉat(
            Sourceˉbytes, Declarationˉindex
        );
    return Effects.Compilerˉsourceˉeffectsˉresolveˉclause(
        Input, Scan, Symbolˉsummary, Sourceˉbytes,
        Declaration.Hasˉeffectˉclause,
        Declaration.Effectˉclauseˉoffset,
        1u32, 1u32, Declaration.Nameˉoffset
    );
}

fn Analyze(
    Source: text,
    Functionˉentries: bytes,
    Blocks: u32,
    Operationˉentries: bytes
) -> Effects.Compilerˉsourceˉeffectˉsummary {
    let Input: bytes = Sourceˉsetˉfrom(Source);
    let Symbolˉsummary: Symbols.Compilerˉsourceˉsymbolˉsummary =
        Symbols.Compilerˉvalidateˉsourceˉsymbols(Input);
    let Scan: Sourceˉset.Compilerˉsourceˉsetˉscan =
        Sourceˉset.Compilerˉscanˉsourceˉset(Input);
    let Bindingˉvalue: Bindings.Compilerˉsourceˉbindingˉsummary =
        Bindings.Compilerˉsourceˉbindingsˉfromˉsymbols(
            Input, Scan, Symbolˉsummary
        );
    return Effects.Compilerˉanalyzeˉpreparedˉsourceˉeffects(
        Input, Scan, Symbolˉsummary, Bindingˉvalue,
        Wirˉdirectory(Functionˉentries, Blocks, Operationˉentries)
    );
}

fn Realˉbindingsˉprobe() -> i32 {
    let Input: bytes = Pureˉinput("Effectˉbindingˉprobe");
    let Symbolˉsummary: Symbols.Compilerˉsourceˉsymbolˉsummary =
        Symbols.Compilerˉvalidateˉsourceˉsymbols(Input);
    let Scan: Sourceˉset.Compilerˉsourceˉsetˉscan =
        Sourceˉset.Compilerˉscanˉsourceˉset(Input);
    if Symbolˉsummary.Status !=
            Symbols.Compilerˉsourceˉsymbolˉstatus.Valid {
        return 31;
    }
    let Bindingˉvalue: Bindings.Compilerˉsourceˉbindingˉsummary =
        Bindings.Compilerˉsourceˉbindingsˉfromˉsymbols(
            Input, Scan, Symbolˉsummary
        );
    if Bindingˉvalue.Status !=
            Bindings.Compilerˉsourceˉbindingˉstatus.Valid ||
        Bindings.Compilerˉsourceˉbindingsˉrangesˉcount(
            Bindingˉvalue.Directory
        ) != 1u32 {
        return 21;
    }
    return 42;
}

fn Handcraftedˉeffectˉprobe() -> i32 {
    let Input: bytes = Pureˉinput("Effectˉhandcraftedˉprobe");
    let Symbolˉsummary: Symbols.Compilerˉsourceˉsymbolˉsummary =
        Symbols.Compilerˉvalidateˉsourceˉsymbols(Input);
    let Scan: Sourceˉset.Compilerˉsourceˉsetˉscan =
        Sourceˉset.Compilerˉscanˉsourceˉset(Input);
    let Prepared: Effects.Compilerˉsourceˉeffectˉsummary =
        Effects.Compilerˉanalyzeˉpreparedˉsourceˉeffects(
            Input, Scan, Symbolˉsummary,
            Bindingˉsummary(Input, Symbolˉsummary, 1u32),
            Wirˉdirectory(
                Wirˉfunction(0u32, 0u32, 0u32),
                1u32, Zeroes(0u32)
            )
        );
    if Prepared.Status == Effects.Compilerˉsourceˉeffectˉstatus.Sourceˉsymbols {
        return 32;
    }
    if Prepared.Status == Effects.Compilerˉsourceˉeffectˉstatus.Sourceˉwir {
        return 33;
    }
    if Prepared.Status != Effects.Compilerˉsourceˉeffectˉstatus.Valid { return 34; }
    return 42;
}

fn Realˉeffectˉprobe() -> i32 {
    let Input: bytes = Pureˉinput("Effectˉrealˉprobe");
    let Symbolˉsummary: Symbols.Compilerˉsourceˉsymbolˉsummary =
        Symbols.Compilerˉvalidateˉsourceˉsymbols(Input);
    let Scan: Sourceˉset.Compilerˉsourceˉsetˉscan =
        Sourceˉset.Compilerˉscanˉsourceˉset(Input);
    if Symbolˉsummary.Status !=
            Symbols.Compilerˉsourceˉsymbolˉstatus.Valid {
        return 35;
    }
    let Bindingˉvalue: Bindings.Compilerˉsourceˉbindingˉsummary =
        Bindings.Compilerˉsourceˉbindingsˉfromˉsymbols(
            Input, Scan, Symbolˉsummary
        );
    let Prepared: Effects.Compilerˉsourceˉeffectˉsummary =
        Effects.Compilerˉanalyzeˉpreparedˉsourceˉeffects(
            Input, Scan, Symbolˉsummary, Bindingˉvalue,
            Wirˉdirectory(
                Wirˉfunction(0u32, 0u32, 0u32),
                1u32, Zeroes(0u32)
            )
        );
    if Prepared.Status != Effects.Compilerˉsourceˉeffectˉstatus.Valid {
        return 23;
    }
    return 42;
}

