fn Ffiˉdirectoryˉmaskˉprobe() -> i32 {
    var Header: bytes = Textˉtoˉutf8("WVEF");
    Header = Bytesˉconcat(Header, Bytesˉfromˉu16ˉlittle(1u32));
    Header = Bytesˉconcat(Header, Bytesˉfromˉu16ˉlittle(0u32));
    Header = Bytesˉconcat(Header, Bytesˉfromˉu32ˉlittle(1u32));
    Header = Bytesˉconcat(Header, Bytesˉfromˉu32ˉlittle(12u32));
    Header = Bytesˉconcat(Header, Bytesˉfromˉu32ˉlittle(0u32));
    Header = Bytesˉconcat(Header, Bytesˉfromˉu32ˉlittle(4u32));
    Header = Bytesˉconcat(Header, Bytesˉfromˉu32ˉlittle(32u32));
    Header = Bytesˉconcat(Header, Bytesˉfromˉu32ˉlittle(44u32));
    let Valid: bytes = Bytesˉconcat(
        Header,
        Bytesˉconcat(
            Bytesˉfromˉu32ˉlittle(3u32),
            Bytesˉconcat(
                Bytesˉfromˉu32ˉlittle(256u32),
                Bytesˉfromˉu32ˉlittle(0u32)
            )
        )
    );
    let Invalid: Byteˉconstruction.Foundationˉbytesˉresult =
        Byteˉconstruction.Foundationˉbytesˉreplace(
            Valid, 36u32, 4u32, Bytesˉfromˉu32ˉlittle(512u32)
        );
    if !Effects.Compilerˉsourceˉeffectsˉdirectoryˉisˉvalid(
            Valid, 1u32, 0u32
        ) || Effects.Compilerˉsourceˉeffectsˉdirectoryˉisˉvalid(
            Invalid.Value, 1u32, 0u32
        ) {
        return 43;
    }
    return 42;
}

fn Recursiveˉinferenceˉprobe() -> i32 {
    let Prepared: Effects.Compilerˉsourceˉeffectˉsummary = Analyze(
        Program(
            "Effectˉrecursiveˉinference",
            "fn Alpha() -> i32 { return Beta(); } fn Beta() -> i32 { if true { return Alpha(); } return 42; } export fn Main() -> i32 effects(memory.allocate) { return Alpha(); }"
        ),
        Bytesˉconcat(
            Wirˉfunction(0u32, 0u32, 1u32),
            Bytesˉconcat(
                Wirˉfunction(1u32, 1u32, 2u32),
                Wirˉfunction(2u32, 3u32, 1u32)
            )
        ),
        3u32,
        Bytesˉconcat(
            Wirˉoperation(62u32, 1u32),
            Bytesˉconcat(
                Wirˉoperation(171u32, 0u32),
                Bytesˉconcat(
                    Wirˉoperation(62u32, 0u32),
                    Wirˉoperation(62u32, 0u32)
                )
            )
        )
    );
    if Prepared.Status != Effects.Compilerˉsourceˉeffectˉstatus.Valid ||
        Effects.Compilerˉsourceˉeffectsˉfunctionˉlanguage(
            Prepared.Directory, 0u32
        ) != 1u32 ||
        Effects.Compilerˉsourceˉeffectsˉfunctionˉlanguage(
            Prepared.Directory, 1u32
        ) != 1u32 ||
        Effects.Compilerˉsourceˉeffectsˉfunctionˉlanguage(
            Prepared.Directory, 2u32
        ) != 1u32 {
        return 37;
    }
    return 42;
}

fn Directoryˉboundsˉprobe() -> i32 {
    var Directory: bytes = Textˉtoˉutf8("WVEF");
    Directory = Bytesˉconcat(Directory, Bytesˉfromˉu16ˉlittle(1u32));
    Directory = Bytesˉconcat(Directory, Bytesˉfromˉu16ˉlittle(0u32));
    Directory = Bytesˉconcat(Directory, Bytesˉfromˉu32ˉlittle(0u32));
    Directory = Bytesˉconcat(Directory, Bytesˉfromˉu32ˉlittle(12u32));
    Directory = Bytesˉconcat(Directory, Bytesˉfromˉu32ˉlittle(0u32));
    Directory = Bytesˉconcat(Directory, Bytesˉfromˉu32ˉlittle(4u32));
    Directory = Bytesˉconcat(Directory, Bytesˉfromˉu32ˉlittle(32u32));
    Directory = Bytesˉconcat(Directory, Bytesˉfromˉu32ˉlittle(32u32));
    if !Effects.Compilerˉsourceˉeffectsˉdirectoryˉisˉvalid(
            Directory, 0u32, 0u32
        ) ||
        Effects.Compilerˉsourceˉeffectsˉdirectoryˉisˉvalid(
            Directory, 4294967295u32, 0u32
        ) ||
        Effects.Compilerˉsourceˉeffectsˉdirectoryˉisˉvalid(
            Directory, 0u32, 33u32
        ) {
        return 38;
    }
    return 42;
}

export fn Main() -> i32 {
    let Selected: u32 = Selectedˉcase();
    if Selected == 97u32 { return Realˉbindingsˉprobe(); }
    if Selected == 98u32 { return Handcraftedˉeffectˉprobe(); }
    if Selected == 99u32 { return Realˉeffectˉprobe(); }
    if Selected == 100u32 { return Allocationˉexactˉprobe(); }
    if Selected == 101u32 { return Allocationˉmissingˉprobe(); }
    if Selected == 102u32 { return Allocationˉextraˉprobe(); }
    if Selected == 103u32 { return Localˉinferenceˉprobe(); }
    if Selected == 104u32 { return Transitiveˉmissingˉprobe(); }
    if Selected == 105u32 { return Exportedˉmissingˉprobe(); }
    if Selected == 106u32 { return Duplicateˉidentityˉprobe(); }
    if Selected == 107u32 { return Unknownˉidentityˉprobe(); }
    if Selected == 108u32 { return Recursiveˉinferenceˉprobe(); }
    if Selected == 109u32 { return Directoryˉboundsˉprobe(); }
    if Selected == 110u32 { return Ffiˉcallˉidentityˉprobe(); }
    if Selected == 111u32 {
        return Ffiˉcallˉorderˉandˉduplicateˉprobe();
    }
    if Selected == 112u32 { return Ffiˉnamespaceˉisˉreservedˉprobe(); }
    if Selected == 113u32 { return Ffiˉdirectoryˉmaskˉprobe(); }
    return 64;
}
