#!wv/1 en@1
module Languageˉoneˉsyncˉcallerˉawaitsˉasync;
profile hosted;
platform linux, windows, windvale;
authority application;

async fn Run(Value: i32) -> i32 effects(task.suspend) {
    return Value;
}

export fn Main(Value: i32) -> i32 effects(task.suspend) {
    return await Run(Value: Value);
}
