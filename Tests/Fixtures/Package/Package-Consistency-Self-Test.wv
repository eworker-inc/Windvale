#!wv/1 en@1
module Windvaleˉpackageˉconsistencyˉselfˉtest;
profile hosted;
platform linux, windows, windvale;
authority application;
requires capability file.read_bytes version 1;
requires capability process.argument version 1;
requires capability process.argument_count version 1;

import Foundationˉmemory as Memory;
import Foundationˉresult as Result;
import Windvaleˉpackageˉconsistency as Consistency;

fn Digest() -> text {
    return "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef";
}

fn Manifestˉvalue() -> text {
    return "windvale-package 1\nname windvale.example\nversion 1\nlicense MIT\nroot a\ntarget hosted-wvb-v1\nproject Projects/Example.wvproj\npart a hosted Applications/A.wv\ncapability console.write_line\n";
}

fn Part(Name: text, Scope: text, Path: text) -> text {
    var Value: text = Textˉconcat("part ", Name);
    Value = Textˉconcat(Value, " ");
    Value = Textˉconcat(Value, Scope);
    Value = Textˉconcat(Value, " ");
    Value = Textˉconcat(Value, Digest());
    Value = Textˉconcat(Value, " 1 ");
    Value = Textˉconcat(Value, Path);
    return Textˉconcat(Value, "\n");
}

fn Lockˉvalue(
    Name: text,
    Version: text,
    Root: text,
    License: text,
    Project: text,
    Packageˉdigest: text,
    Packageˉbytes: text,
    Parts: text,
    Dependencies: text,
    Capabilities: text
) -> text {
    var Value: text = "windvale-lock 1\nresolver local-source-1\nroot ";
    Value = Textˉconcat(Value, Name);
    Value = Textˉconcat(Value, " ");
    Value = Textˉconcat(Value, Version);
    Value = Textˉconcat(Value, " ");
    Value = Textˉconcat(Value, Root);
    Value = Textˉconcat(Value, "\ntarget hosted-wvb-v1\nlicense ");
    Value = Textˉconcat(Value, License);
    Value = Textˉconcat(Value, "\norigin workspace ");
    Value = Textˉconcat(Value, Digest());
    Value = Textˉconcat(Value, " 1 Windvale.wvws\npackage ");
    Value = Textˉconcat(Value, Packageˉdigest);
    Value = Textˉconcat(Value, " ");
    Value = Textˉconcat(Value, Packageˉbytes);
    Value = Textˉconcat(Value, " Distribution/Example.wvpack\ncompiler ");
    Value = Textˉconcat(Value, Digest());
    Value = Textˉconcat(Value, " 1 Artifacts/Compiler.wvb\nproject ");
    Value = Textˉconcat(Value, Digest());
    Value = Textˉconcat(Value, " 1 ");
    Value = Textˉconcat(Value, Project);
    Value = Textˉconcat(Value, "\n");
    Value = Textˉconcat(Value, Parts);
    Value = Textˉconcat(Value, Dependencies);
    Value = Textˉconcat(Value, Capabilities);
    Value = Textˉconcat(Value, "output ");
    Value = Textˉconcat(Value, Digest());
    return Textˉconcat(Value, " 1\n");
}

fn Verify(
    Manifestˉtext: text,
    Lockˉtext: text,
    Split: Result.Result<Memory.Memoryˉbudget, Memory.Allocationˉfailure>
) -> Consistency.Windvaleˉpackageˉconsistencyˉresult {
    match Split {
        case Result.Result.Valid { Value: Child } {
            return Consistency.Windvaleˉpackageˉverifyˉmanifestˉlock(
                Textˉtoˉutf8(Manifestˉtext), Textˉtoˉutf8(Lockˉtext), Child
            );
        }
        case Result.Result.Failure { Error: _ } {
            return Consistency.Windvaleˉpackageˉconsistencyˉresult(
                Consistency.Windvaleˉpackageˉconsistencyˉstatus.Allocationˉfailure,
                0u32
            );
        }
    }
}

fn Statusˉis(
    Manifestˉtext: text,
    Lockˉtext: text,
    Expected: Consistency.Windvaleˉpackageˉconsistencyˉstatus,
    Split: Result.Result<Memory.Memoryˉbudget, Memory.Allocationˉfailure>
) -> bool {
    let Result: Consistency.Windvaleˉpackageˉconsistencyˉresult =
        Verify(Manifestˉtext, Lockˉtext, Split);
    return Result.Status == Expected;
}

fn Validˉlock() -> text {
    return Lockˉvalue(
        "windvale.example", "1", "a", "MIT", "Projects/Example.wvproj",
        "37edb8f8aeb913f4fb378a07160b3598d89868387dbbf66eaf8078efa71279f4",
        "185", Part("a", "hosted", "Applications/A.wv"), "",
        "capability console.write_line\n"
    );
}

fn Actualˉcase(Budget: Memory.Memoryˉbudget) -> bool {
    if process.argument_count() != 2u32 { return false; }
    let Manifestˉinput: bytes = file.read_bytes(process.argument(0u32));
    let Lockˉinput: bytes = file.read_bytes(process.argument(1u32));
    let Result: Consistency.Windvaleˉpackageˉconsistencyˉresult =
        Consistency.Windvaleˉpackageˉverifyˉmanifestˉlock(
            Manifestˉinput, Lockˉinput, Budget
        );
    return Result.Status == Consistency.Windvaleˉpackageˉconsistencyˉstatus.Valid;
}

fn Rejectionˉcases(Budget: Memory.Memoryˉbudget) -> bool {
    var Parent: Memory.Memoryˉbudget = Budget;
    let Manifest: text = Manifestˉvalue();
    let Partˉa: text = Part("a", "hosted", "Applications/A.wv");
    let Capability: text = "capability console.write_line\n";
    let Manifestˉdigest: text =
        "37edb8f8aeb913f4fb378a07160b3598d89868387dbbf66eaf8078efa71279f4";

    if !Statusˉis(
        "", Validˉlock(),
        Consistency.Windvaleˉpackageˉconsistencyˉstatus.Invalidˉmanifest,
        Memory.Split(borrow mut Parent, 8192u64, 64u32)
    ) { return false; }
    if !Statusˉis(
        Manifest, "",
        Consistency.Windvaleˉpackageˉconsistencyˉstatus.Invalidˉlock,
        Memory.Split(borrow mut Parent, 8192u64, 64u32)
    ) { return false; }
    if !Statusˉis(
        Manifest,
        Lockˉvalue(
            "windvale.other", "1", "a", "MIT", "Projects/Example.wvproj",
            Manifestˉdigest, "185", Partˉa, "", Capability
        ),
        Consistency.Windvaleˉpackageˉconsistencyˉstatus.Nameˉmismatch,
        Memory.Split(borrow mut Parent, 8192u64, 64u32)
    ) { return false; }
    if !Statusˉis(
        Manifest,
        Lockˉvalue(
            "windvale.example", "2", "a", "MIT", "Projects/Example.wvproj",
            Manifestˉdigest, "185", Partˉa, "", Capability
        ),
        Consistency.Windvaleˉpackageˉconsistencyˉstatus.Versionˉmismatch,
        Memory.Split(borrow mut Parent, 8192u64, 64u32)
    ) { return false; }
    let Twoˉparts: text = Textˉconcat(
        Partˉa, Part("b", "hosted", "Applications/B.wv")
    );
    if !Statusˉis(
        Manifest,
        Lockˉvalue(
            "windvale.example", "1", "b", "MIT", "Projects/Example.wvproj",
            Manifestˉdigest, "185", Twoˉparts, "", Capability
        ),
        Consistency.Windvaleˉpackageˉconsistencyˉstatus.Rootˉmismatch,
        Memory.Split(borrow mut Parent, 8192u64, 64u32)
    ) { return false; }
    if !Statusˉis(
        Manifest,
        Lockˉvalue(
            "windvale.example", "1", "a", "Apache-2.0", "Projects/Example.wvproj",
            Manifestˉdigest, "185", Partˉa, "", Capability
        ),
        Consistency.Windvaleˉpackageˉconsistencyˉstatus.Licenseˉmismatch,
        Memory.Split(borrow mut Parent, 8192u64, 64u32)
    ) { return false; }
    if !Statusˉis(
        Manifest,
        Lockˉvalue(
            "windvale.example", "1", "a", "MIT", "Projects/Other.wvproj",
            Manifestˉdigest, "185", Partˉa, "", Capability
        ),
        Consistency.Windvaleˉpackageˉconsistencyˉstatus.Projectˉmismatch,
        Memory.Split(borrow mut Parent, 8192u64, 64u32)
    ) { return false; }
    if !Statusˉis(
        Manifest,
        Lockˉvalue(
            "windvale.example", "1", "a", "MIT", "Projects/Example.wvproj",
            Digest(), "185", Partˉa, "", Capability
        ),
        Consistency.Windvaleˉpackageˉconsistencyˉstatus.Packageˉidentityˉmismatch,
        Memory.Split(borrow mut Parent, 8192u64, 64u32)
    ) { return false; }
    if !Statusˉis(
        Manifest,
        Lockˉvalue(
            "windvale.example", "1", "a", "MIT", "Projects/Example.wvproj",
            Manifestˉdigest, "184", Partˉa, "", Capability
        ),
        Consistency.Windvaleˉpackageˉconsistencyˉstatus.Packageˉidentityˉmismatch,
        Memory.Split(borrow mut Parent, 8192u64, 64u32)
    ) { return false; }
    if !Statusˉis(
        Manifest,
        Lockˉvalue(
            "windvale.example", "1", "a", "MIT", "Projects/Example.wvproj",
            Manifestˉdigest, "185", Twoˉparts, "", Capability
        ),
        Consistency.Windvaleˉpackageˉconsistencyˉstatus.Partˉcountˉmismatch,
        Memory.Split(borrow mut Parent, 8192u64, 64u32)
    ) { return false; }
    let Pathˉmismatch: Consistency.Windvaleˉpackageˉconsistencyˉresult = Verify(
        Manifest,
        Lockˉvalue(
            "windvale.example", "1", "a", "MIT", "Projects/Example.wvproj",
            Manifestˉdigest, "185", Part("a", "hosted", "Applications/B.wv"),
            "", Capability
        ),
        Memory.Split(borrow mut Parent, 8192u64, 64u32)
    );
    if Pathˉmismatch.Status !=
        Consistency.Windvaleˉpackageˉconsistencyˉstatus.Partˉmismatch ||
        Pathˉmismatch.Index != 0u32 { return false; }
    if !Statusˉis(
        Manifest,
        Lockˉvalue(
            "windvale.example", "1", "a", "MIT", "Projects/Example.wvproj",
            Manifestˉdigest, "185", Partˉa, "dependency a a\n", Capability
        ),
        Consistency.Windvaleˉpackageˉconsistencyˉstatus.Dependencyˉcountˉmismatch,
        Memory.Split(borrow mut Parent, 8192u64, 64u32)
    ) { return false; }
    if !Statusˉis(
        Manifest,
        Lockˉvalue(
            "windvale.example", "1", "a", "MIT", "Projects/Example.wvproj",
            Manifestˉdigest, "185", Partˉa, "", ""
        ),
        Consistency.Windvaleˉpackageˉconsistencyˉstatus.Capabilityˉcountˉmismatch,
        Memory.Split(borrow mut Parent, 8192u64, 64u32)
    ) { return false; }
    return Statusˉis(
        Manifest,
        Lockˉvalue(
            "windvale.example", "1", "a", "MIT", "Projects/Example.wvproj",
            Manifestˉdigest, "185", Partˉa, "",
            "capability diagnostic.write_line\n"
        ),
        Consistency.Windvaleˉpackageˉconsistencyˉstatus.Capabilityˉmismatch,
        Memory.Split(borrow mut Parent, 8192u64, 64u32)
    );
}

export fn Main(Budget: Memory.Memoryˉbudget) -> i32 {
    var Parent: Memory.Memoryˉbudget = Budget;
    let Actualˉsplit: Result.Result<Memory.Memoryˉbudget, Memory.Allocationˉfailure> =
        Memory.Split(borrow mut Parent, 16384u64, 64u32);
    match Actualˉsplit {
        case Result.Result.Valid { Value: Actualˉchild } {
            if !Actualˉcase(Actualˉchild) { return 1; }
        }
        case Result.Result.Failure { Error: _ } { return 1; }
    }
    if !Statusˉis(
        Manifestˉvalue(), Validˉlock(),
        Consistency.Windvaleˉpackageˉconsistencyˉstatus.Valid,
        Memory.Split(borrow mut Parent, 16384u64, 64u32)
    ) { return 2; }
    let Rejectionˉsplit: Result.Result<Memory.Memoryˉbudget, Memory.Allocationˉfailure> =
        Memory.Split(borrow mut Parent, 114688u64, 896u32);
    match Rejectionˉsplit {
        case Result.Result.Valid { Value: Rejectionˉchild } {
            if !Rejectionˉcases(Rejectionˉchild) { return 3; }
        }
        case Result.Result.Failure { Error: _ } { return 3; }
    }
    return 42;
}
