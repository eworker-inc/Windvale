module Osˉx64ˉprocessˉgenerationˉtwoˉdirectoryˉrequestˉdeliveryˉemissionˉselfˉtest profile portable;

import Generationˉtwoˉdirectoryˉrequestˉemission as Delivery;

export fn Main() -> i32 {
    let Code: bytes =
        Delivery.Generationˉtwoˉdirectoryˉrequestˉbytes();
    let Fields: bytes =
        Delivery.Generationˉtwoˉdirectoryˉrequestˉinternalˉfields();
    let Displacements: bytes =
        Delivery.Generationˉtwoˉdirectoryˉrequestˉinternalˉdisplacements();
    if Bytesˉlength(Code) != 331u32 || Bytesˉlength(Fields) != 56u32 ||
        Bytesˉlength(Displacements) != 56u32 ||
        Delivery.Generationˉtwoˉdirectoryˉrequestˉexternalˉfield() !=
            225u32 ||
        Delivery.Generationˉtwoˉdirectoryˉrequestˉexternalˉsymbol() !=
            17u32 ||
        Delivery.Generationˉtwoˉdirectoryˉrequestˉfixtureˉoffset() !=
            28137u32 ||
        Delivery.Generationˉtwoˉdirectoryˉrequestˉfixtureˉend() !=
            28468u32 {
        return 1;
    }
    if Bytesˉreadˉu8(Code, 112u32) != 2u8 ||
        Bytesˉreadˉu32ˉlittle(Code, 225u32) != 0u32 ||
        Bytesˉreadˉu32ˉlittle(Displacements, 32u32) != 4294939022u32 {
        return 2;
    }
    var Index: u32 = 0u32;
    while Index < 14u32 {
        let Field: u32 = Bytesˉreadˉu32ˉlittle(Fields, Index * 4u32);
        if Bytesˉreadˉu32ˉlittle(Code, Field) != 0u32 { return 3; }
        if Index != 8u32 {
            let Displacement: u32 =
                Bytesˉreadˉu32ˉlittle(Displacements, Index * 4u32);
            var Expected: u32 = 33826u32;
            if Index == 13u32 { Expected = 28468u32; }
            if 28137u32 + Field + 4u32 + Displacement != Expected {
                return 4;
            }
        }
        Index = Index + 1u32;
    }
    var Hashˉzero: u32 = 0u32;
    var Hashˉone: u32 = 0u32;
    var Hashˉtwo: u32 = 0u32;
    var Hashˉthree: u32 = 0u32;
    Index = 0u32;
    while Index < 331u32 {
        let Value: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(Code, Index));
        Hashˉzero = (Hashˉzero * 251u32 + Value) % 65521u32;
        Hashˉone = (Hashˉone * 257u32 + Value) % 65521u32;
        Hashˉtwo = (Hashˉtwo * 263u32 + Value) % 65521u32;
        Hashˉthree = (Hashˉthree * 269u32 + Value) % 65521u32;
        Index = Index + 1u32;
    }
    if Hashˉzero != 29835u32 || Hashˉone != 14054u32 ||
        Hashˉtwo != 18337u32 || Hashˉthree != 25641u32 {
        return 5;
    }
    return 100;
}
