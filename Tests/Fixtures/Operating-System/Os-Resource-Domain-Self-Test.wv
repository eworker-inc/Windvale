module Osˉresourceˉdomainˉselfˉtest profile portable;
import Resourceˉdomainˉpolicy as Domain;
import Resourceˉdomainˉrecord as Record;

fn Replaceˉu32(Input: bytes, Offset: u32, Value: u32) -> bytes {
    return Bytesˉconcat(
        Bytesˉslice(Input, 0u32, Offset),
        Bytesˉconcat(
            Bytesˉfromˉu32ˉlittle(Value),
            Bytesˉslice(Input, Offset + 4u32, Bytesˉlength(Input) - Offset - 4u32)
        )
    );
}

export fn Main() -> i32 {
    let Filesystemˉrecord: bytes = Record.Filesystemˉresourceˉdomainˉrecord();
    if Record.Filesystemˉresourceˉdomainˉrecordˉstatus(Filesystemˉrecord) !=
        Record.Resourceˉdomainˉrecordˉstatus.Valid ||
        Bytesˉlength(Filesystemˉrecord) != 64u32 {
        return 18;
    }
    let Truncated: bytes = Bytesˉslice(Filesystemˉrecord, 0u32, 63u32);
    if Record.Filesystemˉresourceˉdomainˉrecordˉstatus(Truncated) !=
        Record.Resourceˉdomainˉrecordˉstatus.Invalidˉsize {
        return 19;
    }
    let Wrongˉmagic: bytes = Bytesˉconcat(
        Bytesˉfromˉu32ˉlittle(0u32),
        Bytesˉslice(Filesystemˉrecord, 4u32, 60u32)
    );
    if Record.Filesystemˉresourceˉdomainˉrecordˉstatus(Wrongˉmagic) !=
        Record.Resourceˉdomainˉrecordˉstatus.Invalidˉmagic {
        return 20;
    }
    let Oversized: bytes = Bytesˉconcat(
        Filesystemˉrecord, Bytesˉfromˉu32ˉlittle(0u32)
    );
    if Record.Filesystemˉresourceˉdomainˉrecordˉstatus(Oversized) !=
        Record.Resourceˉdomainˉrecordˉstatus.Invalidˉsize {
        return 21;
    }
    if Record.Filesystemˉresourceˉdomainˉrecordˉstatus(
        Replaceˉu32(Filesystemˉrecord, 8u32, 2u32)
    ) != Record.Resourceˉdomainˉrecordˉstatus.Invalidˉversion {
        return 22;
    }
    if Record.Filesystemˉresourceˉdomainˉrecordˉstatus(
        Replaceˉu32(Filesystemˉrecord, 16u32, 1u32)
    ) != Record.Resourceˉdomainˉrecordˉstatus.Invalidˉheader {
        return 23;
    }
    if Record.Filesystemˉresourceˉdomainˉrecordˉstatus(
        Replaceˉu32(Filesystemˉrecord, 20u32, 0u32)
    ) != Record.Resourceˉdomainˉrecordˉstatus.Invalidˉidentity {
        return 24;
    }
    if Record.Filesystemˉresourceˉdomainˉrecordˉstatus(
        Replaceˉu32(Filesystemˉrecord, 32u32, 80u32)
    ) != Record.Resourceˉdomainˉrecordˉstatus.Invalidˉlimits {
        return 25;
    }
    if Record.Filesystemˉresourceˉdomainˉrecordˉstatus(
        Replaceˉu32(Filesystemˉrecord, 52u32, 1u32)
    ) != Record.Resourceˉdomainˉrecordˉstatus.Invalidˉreservation {
        return 26;
    }
    if Record.Filesystemˉresourceˉdomainˉrecordˉstatus(
        Replaceˉu32(Filesystemˉrecord, 44u32, 80u32)
    ) != Record.Resourceˉdomainˉrecordˉstatus.Invalidˉcommit {
        return 27;
    }
    let Invalid: Domain.Resourceˉdomainˉtransition = Domain.Resourceˉdomainˉcreate(0u32, 1u32, 3u32, 144u32, 2u32);
    if Invalid.Status != Domain.Resourceˉdomainˉstatus.Invalidˉdomain { return 1; }
    let Created: Domain.Resourceˉdomainˉtransition = Domain.Resourceˉdomainˉcreate(1u32, 1u32, 3u32, 144u32, 2u32);
    let Tooˉlarge: Domain.Resourceˉdomainˉtransition = Domain.Resourceˉdomainˉreserve(Created, 4u32, 144u32, 2u32);
    if Tooˉlarge.Status != Domain.Resourceˉdomainˉstatus.Limitˉexceeded { return 2; }
    if Tooˉlarge.Committedˉprocesses != 0u32 { return 3; }
    let Reserved: Domain.Resourceˉdomainˉtransition = Domain.Resourceˉdomainˉreserve(Created, 3u32, 144u32, 2u32);
    if Reserved.Status != Domain.Resourceˉdomainˉstatus.Success { return 4; }
    let Busy: Domain.Resourceˉdomainˉtransition = Domain.Resourceˉdomainˉreserve(Reserved, 0u32, 1u32, 0u32);
    if Busy.Status != Domain.Resourceˉdomainˉstatus.Reservationˉbusy { return 5; }
    let Wrong: Domain.Resourceˉdomainˉtransition = Domain.Resourceˉdomainˉcommit(Reserved, 3u32, 143u32, 2u32);
    if Wrong.Status != Domain.Resourceˉdomainˉstatus.Reservationˉmismatch { return 6; }
    if Wrong.Reservedˉpages != 144u32 { return 7; }
    let Committed: Domain.Resourceˉdomainˉtransition = Domain.Resourceˉdomainˉcommit(Reserved, 3u32, 144u32, 2u32);
    if Committed.Committedˉpages != 144u32 { return 8; }
    if Committed.Peakˉpages != 144u32 { return 9; }
    let Stopping: Domain.Resourceˉdomainˉtransition = Domain.Resourceˉdomainˉstop(Committed, 9u32);
    let Repeated: Domain.Resourceˉdomainˉtransition = Domain.Resourceˉdomainˉstop(Stopping, 10u32);
    if Repeated.Stopˉreason != 9u32 { return 10; }
    let Rejected: Domain.Resourceˉdomainˉtransition = Domain.Resourceˉdomainˉreserve(Repeated, 1u32, 1u32, 1u32);
    if Rejected.Status != Domain.Resourceˉdomainˉstatus.Notˉalive { return 15; }
    if Rejected.Committedˉpages != 144u32 { return 16; }
    let Live: Domain.Resourceˉdomainˉtransition = Domain.Resourceˉdomainˉfinishˉstop(Repeated);
    if Live.Status != Domain.Resourceˉdomainˉstatus.Resourcesˉlive { return 11; }
    let Released: Domain.Resourceˉdomainˉtransition = Domain.Resourceˉdomainˉrelease(Repeated, 3u32, 144u32, 2u32);
    if Released.Peakˉpages != 144u32 { return 12; }
    let Finished: Domain.Resourceˉdomainˉtransition = Domain.Resourceˉdomainˉfinishˉstop(Released);
    if Finished.State != Domain.Resourceˉdomainˉstate.Dead { return 13; }
    let Finalˉstate: Domain.Resourceˉdomainˉtransition = Domain.Resourceˉdomainˉstop(Finished, 11u32);
    if Finalˉstate.Stopˉreason != 9u32 { return 14; }
    let Finishedˉagain: Domain.Resourceˉdomainˉtransition = Domain.Resourceˉdomainˉfinishˉstop(Finalˉstate);
    if Finishedˉagain.State != Domain.Resourceˉdomainˉstate.Dead { return 17; }
    if Finishedˉagain.Committedˉpages != 0u32 { return 18; }
    return 42;
}
