module Osˉx64ˉprocessˉdirectoryˉallocationˉemissionˉselfˉtest profile portable;

import X64ˉprocessˉdirectoryˉallocationˉemission as Allocation;

export fn Main() -> i32 {
    if !Allocation.X64ˉprocessˉdirectoryˉallocationˉisˉvalid() { return 1; }
    let Code: bytes = Allocation.X64ˉprocessˉdirectoryˉallocationˉbytes();
    let Fields: bytes = Allocation.X64ˉprocessˉdirectoryˉallocationˉfailureˉfields();
    let Displacements: bytes =
        Allocation.X64ˉprocessˉdirectoryˉallocationˉfailureˉdisplacements();
    if Bytesˉlength(Code) != 107u32 || Bytesˉlength(Fields) != 16u32 ||
        Bytesˉlength(Displacements) != 16u32 ||
        Allocation.X64ˉprocessˉdirectoryˉallocationˉfixtureˉoffset() != 3216u32 ||
        Allocation.X64ˉprocessˉdirectoryˉallocationˉfixtureˉend() != 3323u32 ||
        Allocation.X64ˉprocessˉdirectoryˉallocationˉcallˉfield() != 32u32 ||
        Allocation.X64ˉprocessˉdirectoryˉallocationˉsymbolˉindex() != 13u32 ||
        Allocation.X64ˉprocessˉdirectoryˉallocationˉrelocationˉaddend() != -4 {
        return 2;
    }
    var Index: u32 = 0u32;
    while Index < 16u32 {
        let Field: u32 = Bytesˉreadˉu32ˉlittle(Fields, Index);
        let Displacement: u32 = Bytesˉreadˉu32ˉlittle(Displacements, Index);
        if Bytesˉreadˉu32ˉlittle(Code, Field) != 0u32 ||
            3216u32 + Field + 4u32 + Displacement != 33826u32 {
            return 3;
        }
        Index = Index + 4u32;
    }
    if Bytesˉreadˉu32ˉlittle(Code, 32u32) != 0u32 { return 4; }

    var Hashˉzero: u32 = 0u32;
    var Hashˉone: u32 = 0u32;
    var Hashˉtwo: u32 = 0u32;
    var Hashˉthree: u32 = 0u32;
    Index = 0u32;
    while Index < 107u32 {
        let Value: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(Code, Index));
        Hashˉzero = (Hashˉzero * 251u32 + Value) % 65521u32;
        Hashˉone = (Hashˉone * 257u32 + Value) % 65521u32;
        Hashˉtwo = (Hashˉtwo * 263u32 + Value) % 65521u32;
        Hashˉthree = (Hashˉthree * 269u32 + Value) % 65521u32;
        Index = Index + 1u32;
    }
    if Hashˉzero != 50528u32 || Hashˉone != 53378u32 ||
        Hashˉtwo != 41636u32 || Hashˉthree != 64978u32 {
        return 5;
    }
    return 59;
}
