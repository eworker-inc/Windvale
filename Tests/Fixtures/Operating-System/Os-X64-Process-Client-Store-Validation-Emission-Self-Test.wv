module Osˉx64ˉprocessˉclientˉstoreˉvalidationˉemissionˉselfˉtest profile portable;

import X64ˉprocessˉclientˉstoreˉvalidationˉemission as Validation;

export fn Main() -> i32 {
    let Code: bytes = Validation.X64ˉprocessˉclientˉstoreˉvalidationˉbytes();
    let Fields: bytes =
        Validation.X64ˉprocessˉclientˉstoreˉvalidationˉfailureˉfields();
    let Displacements: bytes =
        Validation.X64ˉprocessˉclientˉstoreˉvalidationˉfailureˉdisplacements();
    if Bytesˉlength(Code) != 394u32 || Bytesˉlength(Fields) != 88u32 ||
        Bytesˉlength(Displacements) != 88u32 ||
        Validation.X64ˉprocessˉclientˉstoreˉvalidationˉfixtureˉoffset()
            != 10638u32 ||
        Validation.X64ˉprocessˉclientˉstoreˉvalidationˉfixtureˉend()
            != 11032u32 { return 1; }
    var Index: u32 = 0u32;
    while Index < 22u32 {
        let Field: u32 = Bytesˉreadˉu32ˉlittle(Fields, Index * 4u32);
        let Displacement: u32 =
            Bytesˉreadˉu32ˉlittle(Displacements, Index * 4u32);
        if Bytesˉreadˉu32ˉlittle(Code, Field) != 0u32 ||
            10638u32 + Field + 4u32 + Displacement != 33826u32 {
            return 2;
        }
        Index = Index + 1u32;
    }
    var Hashˉzero: u32 = 0u32;
    var Hashˉone: u32 = 0u32;
    var Hashˉtwo: u32 = 0u32;
    var Hashˉthree: u32 = 0u32;
    Index = 0u32;
    while Index < 394u32 {
        let Value: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(Code, Index));
        Hashˉzero = (Hashˉzero * 251u32 + Value) % 65521u32;
        Hashˉone = (Hashˉone * 257u32 + Value) % 65521u32;
        Hashˉtwo = (Hashˉtwo * 263u32 + Value) % 65521u32;
        Hashˉthree = (Hashˉthree * 269u32 + Value) % 65521u32;
        Index = Index + 1u32;
    }
    if Hashˉzero != 39031u32 || Hashˉone != 2600u32 ||
        Hashˉtwo != 61043u32 || Hashˉthree != 7682u32 { return 3; }
    return 70;
}
