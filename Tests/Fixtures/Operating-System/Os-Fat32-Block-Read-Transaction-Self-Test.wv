module Osˉfat32ˉblockˉreadˉtransactionˉselfˉtest profile portable;

import Fat32ˉblockˉreadˉtransaction as Block;
import Fat32ˉblockˉproviderˉprotocol as Protocol;
import Fat32ˉblockˉexchangeˉstate as State;

data Empty: bytes = [];

fn Payload(Length: u32) -> bytes {
    var Result: bytes = Empty;
    var Index: u32 = 0u32;
    while Index < Length {
        Result = Bytesˉconcat(Result, Bytesˉfromˉu8(90u8));
        Index = Index + 1u32;
    }
    return Result;
}

fn Capabilityˉstatus(
    Deviceˉsectors: u64,
    Firstˉsector: u64,
    Sectorˉcount: u64,
    Generation: u32,
    Canˉread: bool
) -> Block.Fat32ˉblockˉcapabilityˉstatus {
    let Capability: Block.Fat32ˉblockˉcapability =
        Block.Fat32ˉblockˉcapabilityˉadmit(
            Deviceˉsectors, Firstˉsector, Sectorˉcount,
            Generation, Canˉread
        );
    return Capability.Status;
}

fn Planˉstatus(
    Capability: Block.Fat32ˉblockˉcapability,
    Generation: u32,
    Sequence: u32,
    Expected: u32,
    Sector: u64,
    Count: u32
) -> Block.Fat32ˉblockˉplanˉstatus {
    let Plan: Block.Fat32ˉblockˉreadˉplan =
        Block.Fat32ˉblockˉreadˉplanˉadmit(
            Capability, Generation, Sequence, Expected, Sector, Count
        );
    return Plan.Status;
}

fn Resultˉstatus(
    Plan: Block.Fat32ˉblockˉreadˉplan,
    Generation: u32,
    Provider: Block.Fat32ˉblockˉproviderˉstatus,
    Value: bytes
) -> Block.Fat32ˉblockˉresultˉstatus {
    let Result: Block.Fat32ˉblockˉreadˉresult =
        Block.Fat32ˉblockˉreadˉcomplete(
            Plan, Generation, Provider, Value
        );
    return Result.Status;
}

fn Appendˉu32(Value: bytes, Field: u32) -> bytes {
    return Bytesˉconcat(Value, Bytesˉfromˉu32ˉlittle(Field));
}

fn Appendˉu64(Value: bytes, Field: u64) -> bytes {
    return Bytesˉconcat(Value, Bytesˉfromˉu64ˉlittle(Field));
}

fn Response(
    Plan: Block.Fat32ˉblockˉreadˉplan,
    Reference: u64,
    Status: u32,
    Value: bytes
) -> bytes {
    var Result: bytes = Bytesˉfromˉu32ˉlittle(1346524759u32);
    Result = Appendˉu32(Result, 1u32);
    Result = Appendˉu32(Result, 48u32 + Bytesˉlength(Value));
    Result = Appendˉu32(Result, Plan.Generation);
    Result = Appendˉu32(Result, Plan.Sequence);
    Result = Appendˉu32(Result, Status);
    Result = Appendˉu64(Result, Plan.Deviceˉsector);
    Result = Appendˉu32(Result, Plan.Sectorˉcount);
    Result = Appendˉu32(Result, Plan.Byteˉcount);
    Result = Appendˉu64(Result, Reference);
    return Bytesˉconcat(Result, Value);
}

fn Exchangeˉplan(
    Exchange: State.Fat32ˉblockˉexchange
) -> Block.Fat32ˉblockˉreadˉplan {
    return Block.Fat32ˉblockˉreadˉplan(
        Block.Fat32ˉblockˉplanˉstatus.Valid,
        Exchange.Planˉgeneration, Exchange.Planˉsequence,
        Exchange.Planˉnextˉsequence, Exchange.Deviceˉsector,
        Exchange.Sectorˉcount, Exchange.Byteˉcount
    );
}

export fn Main() -> i32 {
    let Capability: Block.Fat32ˉblockˉcapability =
        Block.Fat32ˉblockˉcapabilityˉadmit(
            70000u64, 32u64, 539u64, 7u32, true
        );
    if Capability.Status != Block.Fat32ˉblockˉcapabilityˉstatus.Valid {
        return 2;
    }
    let Plan: Block.Fat32ˉblockˉreadˉplan =
        Block.Fat32ˉblockˉreadˉplanˉadmit(
            Capability, 7u32, 9u32, 9u32, 1u64, 2u32
        );
    if Plan.Status != Block.Fat32ˉblockˉplanˉstatus.Valid ||
        Plan.Deviceˉsector != 33u64 || Plan.Byteˉcount != 1024u32 ||
        Plan.Nextˉsequence != 10u32 { return 3; }
    let Complete: Block.Fat32ˉblockˉreadˉresult =
        Block.Fat32ˉblockˉreadˉcomplete(
            Plan, 7u32, Block.Fat32ˉblockˉproviderˉstatus.Complete,
            Payload(1024u32)
        );
    if Complete.Status != Block.Fat32ˉblockˉresultˉstatus.Complete ||
        Bytesˉlength(Complete.Payload) != 1024u32 { return 4; }
    if Capabilityˉstatus(
        0u64, 0u64, 1u64, 1u32, true
    ) != Block.Fat32ˉblockˉcapabilityˉstatus.Invalidˉdevice { return 5; }
    if Capabilityˉstatus(
        10u64, 9u64, 2u64, 1u32, true
    ) != Block.Fat32ˉblockˉcapabilityˉstatus.Invalidˉrange { return 6; }
    let Denied: Block.Fat32ˉblockˉcapability =
        Block.Fat32ˉblockˉcapabilityˉadmit(
            70000u64, 32u64, 539u64, 7u32, false
        );
    if Planˉstatus(
        Denied, 7u32, 9u32, 9u32, 0u64, 1u32
    ) != Block.Fat32ˉblockˉplanˉstatus.Denied { return 7; }
    if Planˉstatus(
        Capability, 6u32, 9u32, 9u32, 0u64, 1u32
    ) != Block.Fat32ˉblockˉplanˉstatus.Stale { return 8; }
    if Planˉstatus(
        Capability, 7u32, 8u32, 9u32, 0u64, 1u32
    ) != Block.Fat32ˉblockˉplanˉstatus.Invalidˉsequence { return 9; }
    if Planˉstatus(
        Capability, 7u32, 9u32, 9u32, 0u64, 9u32
    ) != Block.Fat32ˉblockˉplanˉstatus.Invalidˉlimit { return 10; }
    if Planˉstatus(
        Capability, 7u32, 9u32, 9u32, 538u64, 2u32
    ) != Block.Fat32ˉblockˉplanˉstatus.Outsideˉgrant { return 11; }
    if Resultˉstatus(
        Plan, 8u32, Block.Fat32ˉblockˉproviderˉstatus.Complete,
        Payload(1024u32)
    ) != Block.Fat32ˉblockˉresultˉstatus.Stale { return 12; }
    if Resultˉstatus(
        Plan, 7u32, Block.Fat32ˉblockˉproviderˉstatus.Unavailable, Empty
    ) != Block.Fat32ˉblockˉresultˉstatus.Unavailable { return 13; }
    if Resultˉstatus(
        Plan, 7u32, Block.Fat32ˉblockˉproviderˉstatus.Providerˉlost, Empty
    ) != Block.Fat32ˉblockˉresultˉstatus.Providerˉlost { return 14; }
    if Resultˉstatus(
        Plan, 7u32, Block.Fat32ˉblockˉproviderˉstatus.Complete,
        Payload(512u32)
    ) != Block.Fat32ˉblockˉresultˉstatus.Invalidˉpayload { return 15; }
    let Request: bytes = Protocol.Fat32ˉblockˉproviderˉrequest(Plan, 55u64);
    if Bytesˉlength(Request) != 48u32 ||
        Bytesˉreadˉu32ˉlittle(Request, 0u32) != 1380079191u32 ||
        Bytesˉreadˉu32ˉlittle(Request, 16u32) != 9u32 ||
        Bytesˉreadˉu64ˉlittle(Request, 24u32) != 33u64 ||
        Bytesˉreadˉu64ˉlittle(Request, 40u32) != 55u64 { return 16; }
    if Bytesˉlength(
        Protocol.Fat32ˉblockˉproviderˉrequest(Plan, 0u64)
    ) != 0u32 { return 17; }
    let Completeˉresponse: bytes = Response(
        Plan, 55u64, 0u32, Payload(1024u32)
    );
    if !Protocol.Fat32ˉblockˉproviderˉresponseˉisˉvalid(
        Plan, 55u64, Completeˉresponse
    ) { return 18; }
    let Exchange: Block.Fat32ˉblockˉreadˉresult =
        Protocol.Fat32ˉblockˉproviderˉfinish(
            Plan, 55u64, 7u32, Completeˉresponse
        );
    if Exchange.Status != Block.Fat32ˉblockˉresultˉstatus.Complete ||
        Bytesˉlength(Exchange.Payload) != 1024u32 { return 19; }
    if Protocol.Fat32ˉblockˉproviderˉresponseˉisˉvalid(
        Plan, 56u64, Completeˉresponse
    ) { return 20; }
    let Unavailable: Block.Fat32ˉblockˉreadˉresult =
        Protocol.Fat32ˉblockˉproviderˉfinish(
            Plan, 55u64, 7u32, Response(Plan, 55u64, 1u32, Empty)
        );
    if Unavailable.Status !=
        Block.Fat32ˉblockˉresultˉstatus.Unavailable { return 21; }
    let Lost: Block.Fat32ˉblockˉreadˉresult =
        Protocol.Fat32ˉblockˉproviderˉfinish(
            Plan, 55u64, 7u32, Response(Plan, 55u64, 2u32, Empty)
        );
    if Lost.Status != Block.Fat32ˉblockˉresultˉstatus.Providerˉlost {
        return 22;
    }
    if Protocol.Fat32ˉblockˉproviderˉresponseˉisˉvalid(
        Plan, 55u64, Response(Plan, 55u64, 1u32, Payload(1u32))
    ) { return 23; }

    let Bound: State.Fat32ˉblockˉexchange =
        State.Fat32ˉblockˉexchangeˉbind(Capability, 77u64, 55u64);
    if Bound.Status != State.Fat32ˉblockˉexchangeˉstatus.Success ||
        Bound.Phase != State.Fat32ˉblockˉexchangeˉphase.Ready ||
        Bound.Nextˉsequence != 1u32 { return 24; }
    let Invalidˉbinding: State.Fat32ˉblockˉexchange =
        State.Fat32ˉblockˉexchangeˉbind(Capability, 0u64, 55u64);
    if Invalidˉbinding.Status !=
        State.Fat32ˉblockˉexchangeˉstatus.Invalidˉbinding ||
        Invalidˉbinding.Phase != State.Fat32ˉblockˉexchangeˉphase.Dead {
        return 25;
    }
    let Begun: State.Fat32ˉblockˉexchange =
        State.Fat32ˉblockˉexchangeˉbegin(Bound, 7u32, 1u64, 2u32);
    if Begun.Phase != State.Fat32ˉblockˉexchangeˉphase.Awaiting ||
        Begun.Planˉsequence != 1u32 || Bytesˉlength(Begun.Request) != 48u32 ||
        Begun.Dispatched { return 26; }
    let Busy: State.Fat32ˉblockˉexchange =
        State.Fat32ˉblockˉexchangeˉbegin(Begun, 7u32, 2u64, 1u32);
    if Busy.Status != State.Fat32ˉblockˉexchangeˉstatus.Busy ||
        Busy.Planˉsequence != 1u32 { return 27; }
    let Early: State.Fat32ˉblockˉexchange =
        State.Fat32ˉblockˉexchangeˉcomplete(
            Begun, 77u64, 7u32,
            Response(Exchangeˉplan(Begun), 55u64, 0u32, Payload(1024u32))
        );
    if Early.Status != State.Fat32ˉblockˉexchangeˉstatus.Notˉdispatched ||
        Early.Phase != State.Fat32ˉblockˉexchangeˉphase.Awaiting {
        return 28;
    }
    let Wrongˉendpoint: State.Fat32ˉblockˉexchange =
        State.Fat32ˉblockˉexchangeˉdispatch(Begun, 78u64);
    if Wrongˉendpoint.Status != State.Fat32ˉblockˉexchangeˉstatus.Stale ||
        Wrongˉendpoint.Dispatched { return 29; }
    let Dispatched: State.Fat32ˉblockˉexchange =
        State.Fat32ˉblockˉexchangeˉdispatch(Begun, 77u64);
    if Dispatched.Status != State.Fat32ˉblockˉexchangeˉstatus.Success ||
        !Dispatched.Dispatched { return 30; }
    let Cancelled: State.Fat32ˉblockˉexchange =
        State.Fat32ˉblockˉexchangeˉcancel(Dispatched, 77u64);
    if Cancelled.Status != State.Fat32ˉblockˉexchangeˉstatus.Cancelled ||
        Cancelled.Phase != State.Fat32ˉblockˉexchangeˉphase.Stopping ||
        Cancelled.Nextˉsequence != 2u32 { return 31; }
    let Pending: State.Fat32ˉblockˉexchange =
        State.Fat32ˉblockˉexchangeˉfinishˉteardown(Cancelled, false);
    if Pending.Status !=
        State.Fat32ˉblockˉexchangeˉstatus.Teardownˉpending { return 32; }
    let Dead: State.Fat32ˉblockˉexchange =
        State.Fat32ˉblockˉexchangeˉfinishˉteardown(Cancelled, true);
    if Dead.Phase != State.Fat32ˉblockˉexchangeˉphase.Dead ||
        Dead.Endpointˉreference != 0u64 || Dead.Blockˉreference != 0u64 {
        return 33;
    }

    let Begunˉagain: State.Fat32ˉblockˉexchange =
        State.Fat32ˉblockˉexchangeˉbegin(Bound, 7u32, 1u64, 2u32);
    let Cancelledˉearly: State.Fat32ˉblockˉexchange =
        State.Fat32ˉblockˉexchangeˉcancel(Begunˉagain, 77u64);
    if Cancelledˉearly.Phase != State.Fat32ˉblockˉexchangeˉphase.Ready ||
        Cancelledˉearly.Nextˉsequence != 1u32 { return 34; }
    let Begunˉcomplete: State.Fat32ˉblockˉexchange =
        State.Fat32ˉblockˉexchangeˉbegin(
            Cancelledˉearly, 7u32, 1u64, 2u32
        );
    let Sentˉcomplete: State.Fat32ˉblockˉexchange =
        State.Fat32ˉblockˉexchangeˉdispatch(Begunˉcomplete, 77u64);
    let Finished: State.Fat32ˉblockˉexchange =
        State.Fat32ˉblockˉexchangeˉcomplete(
            Sentˉcomplete, 77u64, 7u32,
            Response(
                Exchangeˉplan(Sentˉcomplete), 55u64, 0u32,
                Payload(1024u32)
            )
        );
    if Finished.Status != State.Fat32ˉblockˉexchangeˉstatus.Success ||
        Finished.Phase != State.Fat32ˉblockˉexchangeˉphase.Ready ||
        Finished.Nextˉsequence != 2u32 ||
        Finished.Resultˉstatus !=
            State.Fat32ˉblockˉexchangeˉresultˉstatus.Complete {
        return 35;
    }
    let Duplicate: State.Fat32ˉblockˉexchange =
        State.Fat32ˉblockˉexchangeˉcomplete(
            Finished, 77u64, 7u32,
            Response(
                Exchangeˉplan(Sentˉcomplete), 55u64, 0u32,
                Payload(1024u32)
            )
        );
    if Duplicate.Status != State.Fat32ˉblockˉexchangeˉstatus.Wrongˉphase ||
        Duplicate.Nextˉsequence != 2u32 { return 36; }
    let Begunˉmalformed: State.Fat32ˉblockˉexchange =
        State.Fat32ˉblockˉexchangeˉbegin(Finished, 7u32, 3u64, 1u32);
    let Sentˉmalformed: State.Fat32ˉblockˉexchange =
        State.Fat32ˉblockˉexchangeˉdispatch(Begunˉmalformed, 77u64);
    let Malformed: State.Fat32ˉblockˉexchange =
        State.Fat32ˉblockˉexchangeˉcomplete(
            Sentˉmalformed, 77u64, 7u32, Empty
        );
    if Malformed.Phase != State.Fat32ˉblockˉexchangeˉphase.Ready ||
        Malformed.Nextˉsequence != 3u32 ||
        Malformed.Resultˉstatus !=
            State.Fat32ˉblockˉexchangeˉresultˉstatus.Invalidˉpayload {
        return 37;
    }
    let Begunˉlost: State.Fat32ˉblockˉexchange =
        State.Fat32ˉblockˉexchangeˉbegin(Malformed, 7u32, 4u64, 1u32);
    let Sentˉlost: State.Fat32ˉblockˉexchange =
        State.Fat32ˉblockˉexchangeˉdispatch(Begunˉlost, 77u64);
    let Peerˉlost: State.Fat32ˉblockˉexchange =
        State.Fat32ˉblockˉexchangeˉpeerˉexit(Sentˉlost, 77u64);
    if Peerˉlost.Status !=
            State.Fat32ˉblockˉexchangeˉstatus.Providerˉlost ||
        Peerˉlost.Phase != State.Fat32ˉblockˉexchangeˉphase.Stopping ||
        Peerˉlost.Nextˉsequence != 4u32 ||
        Peerˉlost.Resultˉstatus !=
            State.Fat32ˉblockˉexchangeˉresultˉstatus.Providerˉlost {
        return 38;
    }
    return 47;
}
