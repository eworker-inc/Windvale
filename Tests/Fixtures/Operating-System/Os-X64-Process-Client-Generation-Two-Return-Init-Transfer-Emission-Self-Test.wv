module Osˉx64ˉprocessˉclientˉgenerationˉtwoˉreturnˉinitˉtransferˉemissionˉselfˉtest profile portable;

import X64ˉprocessˉclientˉgenerationˉtwoˉreturnˉinitˉtransferˉemission as Transfer;

export fn Main() -> i32 {
    let Code: bytes =
        Transfer.X64ˉprocessˉclientˉgenerationˉtwoˉreturnˉinitˉtransferˉbytes();
    let Fields: bytes =
        Transfer.X64ˉprocessˉclientˉgenerationˉtwoˉreturnˉinitˉtransferˉinternalˉfields();
    let Displacements: bytes =
        Transfer.X64ˉprocessˉclientˉgenerationˉtwoˉreturnˉinitˉtransferˉinternalˉdisplacements();
    if Bytesˉlength(Code) != 331u32 || Bytesˉlength(Fields) != 56u32 ||
        Bytesˉlength(Displacements) != 56u32 ||
        Transfer.X64ˉprocessˉclientˉgenerationˉtwoˉreturnˉinitˉtransferˉexternalˉfield() !=
            225u32 ||
        Transfer.X64ˉprocessˉclientˉgenerationˉtwoˉreturnˉinitˉtransferˉexternalˉsymbol() !=
            17u32 ||
        Transfer.X64ˉprocessˉclientˉgenerationˉtwoˉreturnˉinitˉtransferˉfixtureˉoffset() !=
            27139u32 ||
        Transfer.X64ˉprocessˉclientˉgenerationˉtwoˉreturnˉinitˉtransferˉfixtureˉend() !=
            27470u32 {
        return 1;
    }
    if Bytesˉreadˉu8(Code, 112u32) != 2u8 ||
        Bytesˉreadˉu32ˉlittle(Code, 225u32) != 0u32 ||
        Bytesˉreadˉu32ˉlittle(Displacements, 32u32) != 4294940020u32 {
        return 2;
    }
    var Index: u32 = 0u32;
    while Index < 14u32 {
        let Field: u32 = Bytesˉreadˉu32ˉlittle(Fields, Index * 4u32);
        if Bytesˉreadˉu32ˉlittle(Code, Field) != 0u32 { return 3; }
        if Index != 8u32 {
            let Displacement: u32 =
                Bytesˉreadˉu32ˉlittle(Displacements, Index * 4u32);
            var Expected: u32 = 33826u32;
            if Index == 13u32 { Expected = 27470u32; }
            if 27139u32 + Field + 4u32 + Displacement != Expected {
                return 4;
            }
        }
        Index = Index + 1u32;
    }
    var Hashˉzero: u32 = 0u32;
    var Hashˉone: u32 = 0u32;
    var Hashˉtwo: u32 = 0u32;
    var Hashˉthree: u32 = 0u32;
    Index = 0u32;
    while Index < 331u32 {
        let Value: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(Code, Index));
        Hashˉzero = (Hashˉzero * 251u32 + Value) % 65521u32;
        Hashˉone = (Hashˉone * 257u32 + Value) % 65521u32;
        Hashˉtwo = (Hashˉtwo * 263u32 + Value) % 65521u32;
        Hashˉthree = (Hashˉthree * 269u32 + Value) % 65521u32;
        Index = Index + 1u32;
    }
    if Hashˉzero != 27013u32 || Hashˉone != 47000u32 ||
        Hashˉtwo != 13057u32 || Hashˉthree != 15316u32 {
        return 5;
    }
    return 97;
}
