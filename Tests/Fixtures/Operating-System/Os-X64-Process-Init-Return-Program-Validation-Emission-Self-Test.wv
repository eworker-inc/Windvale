module Osˉx64ˉprocessˉinitˉreturnˉprogramˉvalidationˉemissionˉselfˉtest profile portable;

import X64ˉprocessˉinitˉreturnˉprogramˉvalidationˉemission as Validation;

export fn Main() -> i32 {
    let Code: bytes =
        Validation.X64ˉprocessˉinitˉreturnˉprogramˉvalidationˉbytes();
    let Fields: bytes =
        Validation.X64ˉprocessˉinitˉreturnˉprogramˉvalidationˉinternalˉfields();
    let Displacements: bytes =
        Validation.X64ˉprocessˉinitˉreturnˉprogramˉvalidationˉinternalˉdisplacements();
    if Bytesˉlength(Code) != 339u32 || Bytesˉlength(Fields) != 84u32 ||
        Bytesˉlength(Displacements) != 84u32 ||
        Validation.X64ˉprocessˉinitˉreturnˉprogramˉvalidationˉfixtureˉoffset() !=
            13448u32 ||
        Validation.X64ˉprocessˉinitˉreturnˉprogramˉvalidationˉfixtureˉend() !=
            13787u32 {
        return 1;
    }
    var Index: u32 = 0u32;
    while Index < 21u32 {
        let Field: u32 = Bytesˉreadˉu32ˉlittle(Fields, Index * 4u32);
        let Displacement: u32 =
            Bytesˉreadˉu32ˉlittle(Displacements, Index * 4u32);
        if Bytesˉreadˉu32ˉlittle(Code, Field) != 0u32 { return 2; }
        if 13448u32 + Field + 4u32 + Displacement != 33826u32 { return 3; }
        Index = Index + 1u32;
    }
    var Hashˉzero: u32 = 0u32;
    var Hashˉone: u32 = 0u32;
    var Hashˉtwo: u32 = 0u32;
    var Hashˉthree: u32 = 0u32;
    Index = 0u32;
    while Index < 339u32 {
        let Value: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(Code, Index));
        Hashˉzero = (Hashˉzero * 251u32 + Value) % 65521u32;
        Hashˉone = (Hashˉone * 257u32 + Value) % 65521u32;
        Hashˉtwo = (Hashˉtwo * 263u32 + Value) % 65521u32;
        Hashˉthree = (Hashˉthree * 269u32 + Value) % 65521u32;
        Index = Index + 1u32;
    }
    if Hashˉzero != 749u32 || Hashˉone != 60600u32 ||
        Hashˉtwo != 26901u32 || Hashˉthree != 1855u32 { return 4; }
    return 77;
}
