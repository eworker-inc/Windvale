module Osˉx64ˉprocessˉendpointˉemissionˉselfˉtest profile portable;

import X64ˉprocessˉendpointˉemission as Endpoint;

export fn Main() -> i32 {
    if !Endpoint.X64ˉprocessˉchannelsˉandˉendpointsˉareˉvalid() {
        return 1;
    }
    let Code: bytes = Endpoint.X64ˉprocessˉchannelsˉandˉendpointsˉbytes();
    if Bytesˉlength(Code) != 444u32 ||
        Endpoint.X64ˉprocessˉchannelsˉandˉendpointsˉfixtureˉoffset() != 1428u32 ||
        Endpoint.X64ˉprocessˉchannelsˉandˉendpointsˉfixtureˉend() != 1872u32 {
        return 2;
    }
    var Hashˉzero: u32 = 0u32;
    var Hashˉone: u32 = 0u32;
    var Hashˉtwo: u32 = 0u32;
    var Hashˉthree: u32 = 0u32;
