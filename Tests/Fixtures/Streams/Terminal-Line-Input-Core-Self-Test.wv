module Terminalˉlineˉinputˉcoreˉselfˉtest profile portable;

import Windvaleˉterminalˉlineˉinputˉcore as Core;

fn Build(Status: u32, Generation: u64, Content: bytes) -> bytes {
    var Value: bytes = Bytesˉfromˉu32ˉlittle(1229739607u32);
    Value = Bytesˉconcat(Value, Bytesˉfromˉu32ˉlittle(1u32));
    Value = Bytesˉconcat(Value, Bytesˉfromˉu32ˉlittle(32u32 + Bytesˉlength(Content)));
    Value = Bytesˉconcat(Value, Bytesˉfromˉu32ˉlittle(Status));
    Value = Bytesˉconcat(Value, Bytesˉfromˉu32ˉlittle(Bytesˉlength(Content)));
    Value = Bytesˉconcat(Value, Bytesˉfromˉu32ˉlittle(0u32));
    Value = Bytesˉconcat(Value, Bytesˉfromˉu64ˉlittle(Generation));
    return Bytesˉconcat(Value, Content);
}

fn Rejects(Value: bytes, Maximum: u32) -> bool {
    let Result: Core.Terminalˉlineˉresponse =
        Core.Terminalˉlineˉresponseˉread(Value, Maximum);
    return !Result.Valid;
}

fn Requestˉcases() -> i32 {
    let Request: Core.Terminalˉlineˉrequest = Core.Terminalˉlineˉrequestˉcreate(3072u32);
    let Decoded: Core.Terminalˉlineˉrequest =
        Core.Terminalˉlineˉrequestˉread(Request.Bytes);
    if !Request.Valid || Bytesˉlength(Request.Bytes) != 32u32 ||
        !Decoded.Valid { return 1; }
    let Zero: Core.Terminalˉlineˉrequest = Core.Terminalˉlineˉrequestˉcreate(0u32);
    let Large: Core.Terminalˉlineˉrequest = Core.Terminalˉlineˉrequestˉcreate(3073u32);
    if Zero.Valid || Large.Valid { return 2; }
    var Bad: bytes = Bytesˉconcat(Bytesˉslice(Request.Bytes, 0u32, 16u32), Bytesˉfromˉu32ˉlittle(1u32));
    Bad = Bytesˉconcat(Bad, Bytesˉslice(Request.Bytes, 20u32, 12u32));
    let Rejected: Core.Terminalˉlineˉrequest = Core.Terminalˉlineˉrequestˉread(Bad);
    if Rejected.Valid { return 3; }
    return 0;
}

fn Validˉcases() -> i32 {
    let Hello: bytes = Textˉtoˉutf8("hello");
    let Completed: bytes = Build(0u32, 1u64, Hello);
    let Result: Core.Terminalˉlineˉresponse =
        Core.Terminalˉlineˉresponseˉread(Completed, 5u32);
    if !Result.Valid { return 4; }
    if Result.Status != Core.Terminalˉlineˉstatus.Completed { return 4; }
    return 0;
}

fn Statusˉcases() -> i32 {
    let Empty: bytes = Textˉtoˉutf8("");
    let End: bytes = Build(1u32, 1u64, Empty);
    if Rejects(End, 5u32) { return 6; }
    let Interrupted: bytes = Build(2u32, 1u64, Empty);
    if Rejects(Interrupted, 5u32) { return 7; }
    let Stale: bytes = Build(5u32, 2u64, Empty);
    if Rejects(Stale, 5u32) { return 8; }
    let Revoked: bytes = Build(6u32, 2u64, Empty);
    if Rejects(Revoked, 5u32) { return 9; }
    return 0;
}

fn Invalidˉcases() -> i32 {
    let Hello: bytes = Textˉtoˉutf8("hello");
    let Empty: bytes = Bytesˉslice(Hello, 0u32, 0u32);
    if !Rejects(Build(7u32, 1u64, Empty), 5u32) { return 10; }
    if !Rejects(Build(0u32, 1u64, Hello), 4u32) { return 11; }
    if !Rejects(Build(1u32, 1u64, Hello), 5u32) { return 12; }
    if !Rejects(Build(5u32, 1u64, Empty), 5u32) { return 13; }
    if !Rejects(Build(0u32, 2u64, Hello), 5u32) { return 14; }
    if !Rejects(Build(0u32, 1u64, Textˉtoˉutf8("a\nb")), 5u32) { return 15; }
    if !Rejects(Build(0u32, 1u64, Bytesˉfromˉu8(255u8)), 5u32) { return 16; }
    let End: bytes = Build(1u32, 1u64, Empty);
    let Badˉmagic: bytes = Bytesˉconcat(Bytesˉfromˉu32ˉlittle(0u32), Bytesˉslice(End, 4u32, 28u32));
    if !Rejects(Badˉmagic, 5u32) { return 17; }
    var Badˉreserved: bytes = Bytesˉconcat(Bytesˉslice(End, 0u32, 20u32), Bytesˉfromˉu32ˉlittle(1u32));
    Badˉreserved = Bytesˉconcat(Badˉreserved, Bytesˉslice(End, 24u32, 8u32));
    if !Rejects(Badˉreserved, 5u32) { return 18; }
    if !Rejects(Empty, 5u32) || !Rejects(Build(1u32, 1u64, Empty), 0u32) { return 19; }
    return 0;
}

export fn Main() -> i32 {
    let Request: i32 = Requestˉcases();
    if Request != 0 { return Request; }
    let Valid: i32 = Validˉcases();
    if Valid != 0 { return Valid; }
    let Status: i32 = Statusˉcases();
    if Status != 0 { return Status; }
    let Invalid: i32 = Invalidˉcases();
    if Invalid != 0 { return Invalid; }
    return 42;
}
