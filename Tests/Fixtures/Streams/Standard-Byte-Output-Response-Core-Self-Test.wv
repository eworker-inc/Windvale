module Standardˉbyteˉoutputˉresponseˉcoreˉselfˉtest profile portable;

import Windvaleˉstandardˉbyteˉoutputˉresponseˉcore as Response;

fn Testˉresponse(
    Magic: u32,
    Version: u32,
    Size: u32,
    Status: u32,
    Progress: u32,
    Reserved: u32,
    Generation: u64
) -> bytes {
    var Value: bytes = Bytesˉfromˉu32ˉlittle(Magic);
    Value = Bytesˉconcat(Value, Bytesˉfromˉu32ˉlittle(Version));
    Value = Bytesˉconcat(Value, Bytesˉfromˉu32ˉlittle(Size));
    Value = Bytesˉconcat(Value, Bytesˉfromˉu32ˉlittle(Status));
    Value = Bytesˉconcat(Value, Bytesˉfromˉu32ˉlittle(Progress));
    Value = Bytesˉconcat(Value, Bytesˉfromˉu32ˉlittle(Reserved));
    return Bytesˉconcat(Value, Bytesˉfromˉu64ˉlittle(Generation));
}

fn Testˉstandardˉresponse(
    Status: u32,
    Progress: u32,
    Generation: u64
) -> bytes {
    return Testˉresponse(
        1464817239u32, 1u32, 32u32, Status, Progress, 0u32, Generation
    );
}

fn Testˉaccepts(
    Value: bytes,
    Requested: u32,
    Status: Response.Standardˉoutputˉproviderˉstatus,
    Progress: u32,
    Generation: u64
) -> bool {
    let Result: Response.Standardˉoutputˉresponse =
        Response.Standardˉoutputˉresponseˉread(Value, Requested);
    return Result.Valid && Result.Status == Status &&
        Result.Progress == Progress && Result.Providerˉgeneration == Generation;
}

fn Testˉrejects(Value: bytes, Requested: u32) -> bool {
    let Result: Response.Standardˉoutputˉresponse =
        Response.Standardˉoutputˉresponseˉread(Value, Requested);
    return !Result.Valid;
}

export fn Main() -> i32 {
    if !Testˉaccepts(
        Testˉstandardˉresponse(0u32, 3u32, 1u64), 3u32,
        Response.Standardˉoutputˉproviderˉstatus.Completed, 3u32, 1u64
    ) { return 1; }
    if !Testˉaccepts(
        Testˉstandardˉresponse(1u32, 0u32, 1u64), 3u32,
        Response.Standardˉoutputˉproviderˉstatus.Rejected, 0u32, 1u64
    ) { return 2; }
    if !Testˉaccepts(
        Testˉstandardˉresponse(2u32, 2u32, 1u64), 3u32,
        Response.Standardˉoutputˉproviderˉstatus.Peerˉclosed, 2u32, 1u64
    ) { return 3; }
    if !Testˉaccepts(
        Testˉstandardˉresponse(3u32, 1u32, 1u64), 3u32,
        Response.Standardˉoutputˉproviderˉstatus.Providerˉlost, 1u32, 1u64
    ) { return 4; }
    if !Testˉaccepts(
        Testˉstandardˉresponse(4u32, 0u32, 2u64), 3u32,
        Response.Standardˉoutputˉproviderˉstatus.Stale, 0u32, 2u64
    ) { return 5; }
    if !Testˉaccepts(
        Testˉstandardˉresponse(5u32, 0u32, 2u64), 3u32,
        Response.Standardˉoutputˉproviderˉstatus.Revoked, 0u32, 2u64
    ) { return 6; }
    if !Testˉaccepts(
        Testˉstandardˉresponse(6u32, 2u32, 1u64), 3u32,
        Response.Standardˉoutputˉproviderˉstatus.Indeterminate, 2u32, 1u64
    ) { return 7; }
    if !Testˉrejects(Textˉtoˉutf8(""), 3u32) { return 8; }
    if !Testˉrejects(
        Testˉresponse(0u32, 1u32, 32u32, 0u32, 3u32, 0u32, 1u64), 3u32
    ) { return 9; }
    if !Testˉrejects(
        Testˉresponse(1464817239u32, 2u32, 32u32, 0u32, 3u32, 0u32, 1u64), 3u32
    ) { return 10; }
    if !Testˉrejects(
        Testˉresponse(1464817239u32, 1u32, 31u32, 0u32, 3u32, 0u32, 1u64), 3u32
    ) { return 11; }
    if !Testˉrejects(Testˉstandardˉresponse(7u32, 0u32, 1u64), 3u32) {
        return 12;
    }
    if !Testˉrejects(Testˉstandardˉresponse(6u32, 4u32, 1u64), 3u32) {
        return 13;
    }
    if !Testˉrejects(
        Testˉresponse(1464817239u32, 1u32, 32u32, 0u32, 3u32, 1u32, 1u64), 3u32
    ) { return 14; }
    if !Testˉrejects(Testˉstandardˉresponse(0u32, 3u32, 0u64), 3u32) {
        return 15;
    }
    if !Testˉrejects(Testˉstandardˉresponse(0u32, 2u32, 1u64), 3u32) {
        return 16;
    }
    if !Testˉrejects(Testˉstandardˉresponse(0u32, 3u32, 2u64), 3u32) {
        return 17;
    }
    if !Testˉrejects(Testˉstandardˉresponse(1u32, 1u32, 1u64), 3u32) {
        return 18;
    }
    if !Testˉrejects(Testˉstandardˉresponse(4u32, 0u32, 1u64), 3u32) {
        return 19;
    }
    if !Testˉrejects(Testˉstandardˉresponse(2u32, 1u32, 2u64), 3u32) {
        return 20;
    }
    return 42;
}
