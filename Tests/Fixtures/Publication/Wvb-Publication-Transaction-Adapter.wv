module Wvbˉpublicationˉtransactionˉadapter profile portable;

import Windvaleˉwvbˉpublicationˉtransaction as Publication;
import Windvaleˉwvbˉpublicationˉnativeˉbridge as Nativeˉbridge;

fn Apply(
    Current: Publication.Wvbˉpublicationˉresult,
    Action: Publication.Wvbˉpublicationˉaction
) -> Publication.Wvbˉpublicationˉresult {
    return Publication.Wvbˉpublicationˉapply(Current, Action);
}

fn Isˉrejected(
    Result: Publication.Wvbˉpublicationˉresult
) -> bool {
    if Result.State != Publication.Wvbˉpublicationˉstate.Rejectedˉunchanged {
        return false;
    }
    if Result.Outcome != Publication.Wvbˉpublicationˉoutcome.Rejectedˉunchanged {
        return false;
    }
    if Result.Scratchˉowned { return false; }
    if Result.Destinationˉmayˉdiffer { return false; }
    return true;
}

fn Cleanupˉafter(
    Current: Publication.Wvbˉpublicationˉresult
) -> bool {
    let Failed: Publication.Wvbˉpublicationˉresult = Apply(
        Current,
        Publication.Wvbˉpublicationˉaction.Fail
    );
    if Failed.State != Publication.Wvbˉpublicationˉstate.Cleanupˉrequired {
        return false;
    }
    if Failed.Outcome != Publication.Wvbˉpublicationˉoutcome.Cleanupˉrequired {
        return false;
    }
    if !Failed.Scratchˉowned { return false; }
    if Failed.Destinationˉmayˉdiffer { return false; }
    return Isˉrejected(Apply(
        Failed,
        Publication.Wvbˉpublicationˉaction.Cleanˉsibling
    ));
}

export fn Main() -> i32 {
    var Token: u32 = Nativeˉbridge.Wvbˉpublicationˉnativeˉbegin();
    if Token != 0u32 { return 15; }
    Token = Nativeˉbridge.Wvbˉpublicationˉnativeˉapply(Token, 0u32);
    if Token != 129u32 { return 16; }
    Token = Nativeˉbridge.Wvbˉpublicationˉnativeˉapply(Token, 1u32);
    if Token != 130u32 { return 17; }
    Token = Nativeˉbridge.Wvbˉpublicationˉnativeˉapply(Token, 2u32);
    if Token != 131u32 { return 18; }
    Token = Nativeˉbridge.Wvbˉpublicationˉnativeˉapply(Token, 3u32);
    if Token != 260u32 { return 19; }
    Token = Nativeˉbridge.Wvbˉpublicationˉnativeˉapply(Token, 4u32);
    if Token != 311u32 { return 20; }
    if Nativeˉbridge.Wvbˉpublicationˉnativeˉapply(0u32, 7u32) != 4294967295u32 {
        return 21;
    }
    if Nativeˉbridge.Wvbˉpublicationˉnativeˉapply(311u32, 5u32) != 4294967295u32 {
        return 22;
    }

    let Begun: Publication.Wvbˉpublicationˉresult =
        Publication.Wvbˉpublicationˉbegin();
    if !Isˉrejected(Apply(Begun, Publication.Wvbˉpublicationˉaction.Fail)) {
        return 1;
    }

    let Owned: Publication.Wvbˉpublicationˉresult = Apply(
        Begun,
        Publication.Wvbˉpublicationˉaction.Createˉsibling
    );
    if !Cleanupˉafter(Owned) { return 2; }

    let Durable: Publication.Wvbˉpublicationˉresult = Apply(
        Owned,
        Publication.Wvbˉpublicationˉaction.Flushˉsibling
    );
    if !Cleanupˉafter(Durable) { return 3; }

    let Verified: Publication.Wvbˉpublicationˉresult = Apply(
        Durable,
        Publication.Wvbˉpublicationˉaction.Verifyˉsibling
    );
    if !Cleanupˉafter(Verified) { return 4; }

    let Replaced: Publication.Wvbˉpublicationˉresult = Apply(
        Verified,
        Publication.Wvbˉpublicationˉaction.Replaceˉdestination
    );
    let Uncertain: Publication.Wvbˉpublicationˉresult = Apply(
        Replaced,
        Publication.Wvbˉpublicationˉaction.Fail
    );
    if Uncertain.State != Publication.Wvbˉpublicationˉstate.Indeterminate {
        return 5;
    }
    if Uncertain.Outcome != Publication.Wvbˉpublicationˉoutcome.Indeterminate {
        return 6;
    }
    if Uncertain.Scratchˉowned || !Uncertain.Destinationˉmayˉdiffer {
        return 7;
    }

    let Complete: Publication.Wvbˉpublicationˉresult = Apply(
        Replaced,
        Publication.Wvbˉpublicationˉaction.Flushˉdirectory
    );
    if Complete.State != Publication.Wvbˉpublicationˉstate.Complete {
        return 8;
    }
    if Complete.Outcome != Publication.Wvbˉpublicationˉoutcome.Complete {
        return 9;
    }
    if Complete.Scratchˉowned || !Complete.Destinationˉmayˉdiffer {
        return 10;
    }

    let Invalid: Publication.Wvbˉpublicationˉresult = Apply(
        Begun,
        Publication.Wvbˉpublicationˉaction.Flushˉdirectory
    );
    if Invalid.State != Publication.Wvbˉpublicationˉstate.Candidateˉadmitted {
        return 11;
    }
    if Invalid.Outcome != Publication.Wvbˉpublicationˉoutcome.Invalidˉtransition {
        return 12;
    }
    if Invalid.Scratchˉowned || Invalid.Destinationˉmayˉdiffer {
        return 13;
    }
    let Stillˉinvalid: Publication.Wvbˉpublicationˉresult = Apply(
        Invalid,
        Publication.Wvbˉpublicationˉaction.Fail
    );
    if Stillˉinvalid.Outcome !=
        Publication.Wvbˉpublicationˉoutcome.Invalidˉtransition {
        return 14;
    }
    return 0;
}
