#!wv/1 en@1
module WebAssemblyˉwvbˉscalarˉinterpreterˉcollectionˉcore;
profile core;
platform linux, windows, windvale;
authority library;

export record Collectionˉreplacementˉstate {
    Valid: bool;
    Status: u32;
    Heap: bytes;
    Stack: bytes;
}

export record Collectionˉaccessˉstate {
    Valid: bool;
    Status: u32;
    Stack: bytes;
    Kind: u32;
}

export fn Collectionˉelementˉshape(
    Module: bytes,
    Typeˉoffsets: bytes,
    Typeˉcount: u32,
    Type: u32,
    Expectedˉkind: u32
) -> u32 {
    if Type >= Typeˉcount || Typeˉcount > 2097151u32 ||
        Bytesˉlength(Typeˉoffsets) != Typeˉcount * 4u32 {
        return 4294967295u32;
    }
    let Typeˉoffset: u32 = Bytesˉreadˉu32ˉlittle(
        Typeˉoffsets, Type * 4u32
    );
    if Typeˉoffset > Bytesˉlength(Module) ||
        Bytesˉlength(Module) - Typeˉoffset < 6u32 {
        return 4294967295u32;
    }
    if U32ˉfromˉu8(Bytesˉreadˉu8(Module, Typeˉoffset)) != Expectedˉkind {
        return 4294967295u32;
    }
    let Nameˉoffset: u32 = Typeˉoffset + 1u32;
    let Nameˉlength: u32 = Bytesˉreadˉu32ˉlittle(Module, Nameˉoffset);
    if Nameˉlength >= Bytesˉlength(Module) - Nameˉoffset - 4u32 {
        return 4294967295u32;
    }
    let Shape: u32 = Nameˉoffset + 4u32 + Nameˉlength;
    let Kind: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(Module, Shape));
    if (Kind == 7u32 || Kind == 8u32) &&
        Bytesˉlength(Module) - Shape < 5u32 {
        return 4294967295u32;
    }
    return Shape;
}

export fn Collectionˉscalarˉelement(Module: bytes, Shape: u32) -> bool {
    if Shape >= Bytesˉlength(Module) { return false; }
    let Kind: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(Module, Shape));
    if Kind == 1u32 || Kind == 2u32 || Kind == 4u32 || Kind == 5u32 ||
        Kind == 8u32 || Kind == 9u32 || Kind == 10u32 ||
        (Kind >= 14u32 && Kind <= 20u32) {
        return true;
    }
    return false;
}

// The complete verifier proves recursive Copy membership before execution.
// Runtime admission still preserves the version and exact live handle checks.
export fn Collectionˉexecutableˉelement(Module: bytes, Shape: u32) -> bool {
    if Collectionˉscalarˉelement(Module, Shape) { return true; }
    return Bytesˉlength(Module) >= 8u32 && Shape < Bytesˉlength(Module) &&
        Bytesˉlength(Module) - Shape >= 5u32 &&
        (Bytesˉreadˉu16ˉlittle(Module, 6u32) == 42u32 || Bytesˉreadˉu16ˉlittle(Module, 6u32) == 43u32) &&
        Bytesˉreadˉu8(Module, Shape) == 7u8;
}

export fn Collectionˉelementˉvalueˉvalid(
    Module: bytes,
    Shape: u32,
    Typeˉoffsets: bytes,
    Typeˉcount: u32,
    Recordˉmetadata: bytes,
    Value: bytes
) -> bool {
    if Bytesˉlength(Value) != 8u32 || !Collectionˉexecutableˉelement(Module, Shape) {
        return false;
    }
    if Bytesˉreadˉu8(Module, Shape) != 7u8 { return true; }
    if Bytesˉlength(Recordˉmetadata) != 6144u32 { return false; }
    let Type: u32 = Bytesˉreadˉu32ˉlittle(Module, Shape + 1u32);
    let Slot: u32 = Bytesˉreadˉu32ˉlittle(Value, 0u32);
    let Fields: u32 = Collectionˉrecordˉfieldˉcount(Module, Typeˉoffsets, Typeˉcount, Type);
    if Fields == 4294967295u32 || Bytesˉreadˉu32ˉlittle(Value, 4u32) != Type + 1u32 {
        return false;
    }
    if Fields == 0u32 { return Slot == 4294967295u32; }
    if Slot >= 768u32 || Fields > 768u32 - Slot { return false; }
    return Bytesˉreadˉu32ˉlittle(Value, 4u32) == Type + 1u32 &&
        Bytesˉreadˉu32ˉlittle(Recordˉmetadata, Slot * 8u32) == Type + 1u32 &&
        Bytesˉreadˉu32ˉlittle(Recordˉmetadata, Slot * 8u32 + 4u32) == Fields;
}

fn Collectionˉrecordˉfieldˉcount(
    Module: bytes, Typeˉoffsets: bytes, Typeˉcount: u32, Type: u32
) -> u32 {
    let Invalid: u32 = 4294967295u32;
    let Total: u32 = Bytesˉlength(Module);
    if Typeˉcount > 4096u32 || Type >= Typeˉcount ||
        Bytesˉlength(Typeˉoffsets) != Typeˉcount * 4u32 { return Invalid; }
    let Offset: u32 = Bytesˉreadˉu32ˉlittle(Typeˉoffsets, Type * 4u32);
    if Offset > Total || Total - Offset < 9u32 ||
        Bytesˉreadˉu8(Module, Offset) != 1u8 { return Invalid; }
    let Nameˉlength: u32 = Bytesˉreadˉu32ˉlittle(Module, Offset + 1u32);
    if Nameˉlength > Total - Offset - 9u32 { return Invalid; }
    let Fields: u32 = Bytesˉreadˉu32ˉlittle(Module, Offset + 5u32 + Nameˉlength);
    if Fields > 768u32 { return Invalid; }
    return Fields;
}

export fn Collectionˉemptyˉbacking(
    Maximum: u32,
    Type: u32,
    Zeroˉcell: bytes
) -> bytes {
    let Empty: bytes = Bytesˉslice(Zeroˉcell, 0u32, 0u32);
    if Maximum == 0u32 || Maximum > 2047u32 ||
        Type >= 2097151u32 ||
        Bytesˉlength(Zeroˉcell) != 8u32 {
        return Empty;
    }
    let Requiredˉcellˉbytes: u32 = Maximum * 8u32;
    var Cells: bytes = Zeroˉcell;
    while Bytesˉlength(Cells) < Requiredˉcellˉbytes {
        let Remaining: u32 = Requiredˉcellˉbytes - Bytesˉlength(Cells);
        var Addition: bytes = Cells;
        if Bytesˉlength(Addition) > Remaining {
            Addition = Bytesˉslice(Addition, 0u32, Remaining);
        }
        Cells = Bytesˉconcat(Cells, Addition);
    }
    return Bytesˉconcat(
        Bytesˉconcat(
            Bytesˉfromˉu32ˉlittle(0u32),
            Bytesˉfromˉu32ˉlittle(((Type + 1u32) << 11u32) | Maximum)
        ),
        Cells
    );
}

export fn Collectionˉtype(Heap: bytes, Value: bytes) -> u32 {
    let Offset: u32 = Bytesˉreadˉu32ˉlittle(Value, 0u32);
    return (Bytesˉreadˉu32ˉlittle(Heap, Offset + 4u32) >> 11u32) - 1u32;
}

export fn Collectionˉmaximum(Heap: bytes, Value: bytes) -> u32 {
    let Offset: u32 = Bytesˉreadˉu32ˉlittle(Value, 0u32);
    return Bytesˉreadˉu32ˉlittle(Heap, Offset + 4u32) & 2047u32;
}

export fn Collectionˉbackingˉvalid(
    Heap: bytes,
    Allocations: bytes,
    Allocationˉcount: u32,
    Value: bytes
) -> bool {
    if Bytesˉlength(Value) != 8u32 || Allocationˉcount > 4096u32 ||
        Bytesˉlength(Allocations) != Allocationˉcount * 12u32 ||
        Bytesˉlength(Heap) > 65536u32 {
        return false;
    }
    let Offset: u32 = Bytesˉreadˉu32ˉlittle(Value, 0u32);
    let Length: u32 = Bytesˉreadˉu32ˉlittle(Value, 4u32);
    if Length < 16u32 || Length > 16384u32 || Length % 8u32 != 0u32 ||
        Offset > Bytesˉlength(Heap) || Length > Bytesˉlength(Heap) - Offset {
        return false;
    }
    let Header: u32 = Bytesˉreadˉu32ˉlittle(Heap, Offset + 4u32);
    let Maximum: u32 = Header & 2047u32;
    let Count: u32 = Bytesˉreadˉu32ˉlittle(Heap, Offset);
    if (Header >> 11u32) == 0u32 || Maximum == 0u32 ||
        Length != (Maximum + 1u32) * 8u32 || Count > Maximum {
        return false;
    }
    var Found: bool = false;
    var Index: u32 = 0u32;
    while Index < Allocationˉcount {
        let Entry: u32 = Index * 12u32;
        if Bytesˉreadˉu32ˉlittle(Allocations, Entry + 8u32) > 0u32 &&
            Bytesˉreadˉu32ˉlittle(Allocations, Entry) == Offset &&
            Bytesˉreadˉu32ˉlittle(Allocations, Entry + 4u32) == Length {
            Found = true;
        }
        Index = Index + 1u32;
    }
    return Found;
}

export fn Collectionˉlength(Heap: bytes, Value: bytes) -> u32 {
    return Bytesˉreadˉu32ˉlittle(
        Heap,
        Bytesˉreadˉu32ˉlittle(Value, 0u32)
    );
}

export fn Collectionˉlengthˉchecked(
    Heap: bytes, Allocations: bytes, Allocationˉcount: u32,
    Value: bytes, Vectorˉtype: u32, Stack: bytes
) -> Collectionˉaccessˉstate {
    if !Collectionˉbackingˉvalid(Heap, Allocations, Allocationˉcount, Value) ||
        Collectionˉtype(Heap, Value) != Vectorˉtype {
        return Collectionˉaccessˉstate(false, 0u32, Stack, 0u32);
    }
    let Length: bytes = Bytesˉconcat(
        Bytesˉfromˉu32ˉlittle(Collectionˉlength(Heap, Value)), Bytesˉfromˉu32ˉlittle(0u32));
    return Collectionˉaccessˉstate(true, 0u32, Bytesˉconcat(Stack, Length), 0u32);
}

export fn Collectionˉborrowˉchecked(
    Module: bytes, Typeˉoffsets: bytes, Typeˉcount: u32, Recordˉmetadata: bytes,
    Heap: bytes, Allocations: bytes, Allocationˉcount: u32,
    Value: bytes, Vectorˉtype: u32, Stack: bytes
) -> Collectionˉaccessˉstate {
    let Invalid: Collectionˉaccessˉstate = Collectionˉaccessˉstate(false, 0u32, Stack, 0u32);
    if Bytesˉlength(Stack) < 8u32 { return Invalid; }
    let Shape: u32 = Collectionˉelementˉshape(Module, Typeˉoffsets, Typeˉcount, Vectorˉtype, 5u32);
    if !Collectionˉexecutableˉelement(Module, Shape) ||
        !Collectionˉbackingˉvalid(Heap, Allocations, Allocationˉcount, Value) ||
        Collectionˉtype(Heap, Value) != Vectorˉtype { return Invalid; }
    let Length: u32 = Bytesˉlength(Stack);
    let Index: u32 = Bytesˉreadˉu32ˉlittle(Stack, Length - 8u32);
    let High: u32 = Bytesˉreadˉu32ˉlittle(Stack, Length - 4u32);
    let Remaining: bytes = Bytesˉslice(Stack, 0u32, Length - 8u32);
    if High != 0u32 || Index >= Collectionˉlength(Heap, Value) {
        return Collectionˉaccessˉstate(true, 3008u32, Remaining, 0u32);
    }
    let Selected: bytes = Collectionˉelement(Heap, Value, Index);
    if !Collectionˉelementˉvalueˉvalid(
        Module, Shape, Typeˉoffsets, Typeˉcount, Recordˉmetadata, Selected
    ) { return Invalid; }
    var Kind: u32 = 0u32;
    if Bytesˉreadˉu8(Module, Shape) == 7u8 { Kind = 2u32; }
    return Collectionˉaccessˉstate(true, 0u32, Bytesˉconcat(Remaining, Selected), Kind);
}

export fn Collectionˉappend(
    Heap: bytes,
    Value: bytes,
    Element: bytes
) -> bytes {
    let Empty: bytes = Bytesˉslice(Heap, 0u32, 0u32);
    if Bytesˉlength(Element) != 8u32 { return Empty; }
    let Offset: u32 = Bytesˉreadˉu32ˉlittle(Value, 0u32);
    let Count: u32 = Bytesˉreadˉu32ˉlittle(Heap, Offset);
    let Header: u32 = Bytesˉreadˉu32ˉlittle(Heap, Offset + 4u32);
    let Maximum: u32 = Header & 2047u32;
    if Count >= Maximum { return Empty; }
    let Elementˉoffset: u32 = Offset + 8u32 + Count * 8u32;
    var Result: bytes = Bytesˉconcat(
        Bytesˉslice(Heap, 0u32, Offset),
        Bytesˉconcat(
            Bytesˉfromˉu32ˉlittle(Count + 1u32),
            Bytesˉfromˉu32ˉlittle(Header)
        )
    );
    Result = Bytesˉconcat(
        Result,
        Bytesˉslice(Heap, Offset + 8u32, Count * 8u32)
    );
    Result = Bytesˉconcat(Result, Element);
    let Suffix: u32 = Elementˉoffset + 8u32;
    if Suffix < Bytesˉlength(Heap) {
        Result = Bytesˉconcat(
            Result,
            Bytesˉslice(Heap, Suffix, Bytesˉlength(Heap) - Suffix)
        );
    }
    return Result;
}

export fn Collectionˉreplace(
    Heap: bytes, Value: bytes, Index: u32, Element: bytes
) -> bytes {
    let Empty: bytes = Bytesˉslice(Heap, 0u32, 0u32);
    if Bytesˉlength(Element) != 8u32 || Bytesˉlength(Value) != 8u32 { return Empty; }
    let Offset: u32 = Bytesˉreadˉu32ˉlittle(Value, 0u32);
    let Length: u32 = Bytesˉreadˉu32ˉlittle(Value, 4u32);
    if Offset > Bytesˉlength(Heap) || Length > Bytesˉlength(Heap) - Offset ||
        Length < 8u32 || Index >= Bytesˉreadˉu32ˉlittle(Heap, Offset) ||
        Index >= (Length - 8u32) / 8u32 { return Empty; }
    let Cell: u32 = Offset + 8u32 + Index * 8u32;
    let Suffix: u32 = Cell + 8u32;
    return Bytesˉconcat(Bytesˉconcat(Bytesˉslice(Heap, 0u32, Cell), Element),
        Bytesˉslice(Heap, Suffix, Bytesˉlength(Heap) - Suffix));
}

export fn Collectionˉreplaceˉchecked(
    Module: bytes, Typeˉoffsets: bytes, Typeˉcount: u32, Recordˉmetadata: bytes,
    Heap: bytes, Allocations: bytes, Allocationˉcount: u32,
    Value: bytes, Vectorˉtype: u32, Stack: bytes
) -> Collectionˉreplacementˉstate {
    let Invalid: Collectionˉreplacementˉstate = Collectionˉreplacementˉstate(false, 0u32, Heap, Stack);
    if Bytesˉlength(Stack) < 16u32 { return Invalid; }
    let Elementˉshape: u32 = Collectionˉelementˉshape(Module, Typeˉoffsets, Typeˉcount, Vectorˉtype, 5u32);
    if Elementˉshape >= Bytesˉlength(Module) { return Invalid; }
    let Kind: u8 = Bytesˉreadˉu8(Module, Elementˉshape);
    if Kind != 1u8 && Kind != 2u8 && Kind != 4u8 &&
        Kind != 5u8 && Kind != 9u8 && Kind != 10u8 { return Invalid; }
    if !Collectionˉbackingˉvalid(Heap, Allocations, Allocationˉcount, Value) ||
        Collectionˉtype(Heap, Value) != Vectorˉtype { return Invalid; }
    let Length: u32 = Bytesˉlength(Stack);
    let Index: u32 = Bytesˉreadˉu32ˉlittle(Stack, Length - 16u32);
    let Indexˉhigh: u32 = Bytesˉreadˉu32ˉlittle(Stack, Length - 12u32);
    let Replacement: bytes = Bytesˉslice(Stack, Length - 8u32, 8u32);
    if !Collectionˉelementˉvalueˉvalid(
        Module, Elementˉshape, Typeˉoffsets, Typeˉcount, Recordˉmetadata, Replacement
    ) { return Invalid; }
    let Remaining: bytes = Bytesˉslice(Stack, 0u32, Length - 16u32);
    if Indexˉhigh != 0u32 || Index >= Collectionˉlength(Heap, Value) {
        return Collectionˉreplacementˉstate(true, 3008u32, Heap, Remaining);
    }
    let Prior: bytes = Collectionˉelement(Heap, Value, Index);
    let Replaced: bytes = Collectionˉreplace(Heap, Value, Index, Replacement);
    if Bytesˉlength(Replaced) != Bytesˉlength(Heap) || !Collectionˉelementˉvalueˉvalid(
        Module, Elementˉshape, Typeˉoffsets, Typeˉcount, Recordˉmetadata, Prior
    ) { return Invalid; }
    return Collectionˉreplacementˉstate(true, 0u32, Replaced, Bytesˉconcat(Remaining, Prior));
}

export fn Collectionˉgrownˉbacking(
    Heap: bytes,
    Value: bytes,
    Newˉmaximum: u32,
    Zeroˉcell: bytes
) -> bytes {
    let Empty: bytes = Bytesˉslice(Heap, 0u32, 0u32);
    if Bytesˉlength(Value) != 8u32 || Bytesˉlength(Zeroˉcell) != 8u32 ||
        Newˉmaximum == 0u32 || Newˉmaximum > 2047u32 {
        return Empty;
    }
    let Offset: u32 = Bytesˉreadˉu32ˉlittle(Value, 0u32);
    let Length: u32 = Bytesˉreadˉu32ˉlittle(Value, 4u32);
    if Offset > Bytesˉlength(Heap) || Length > Bytesˉlength(Heap) - Offset ||
        Length < 16u32 || Length % 8u32 != 0u32 {
        return Empty;
    }
    let Count: u32 = Bytesˉreadˉu32ˉlittle(Heap, Offset);
    let Header: u32 = Bytesˉreadˉu32ˉlittle(Heap, Offset + 4u32);
    let Maximum: u32 = Header & 2047u32;
    if Maximum == 0u32 || Maximum > 2047u32 || Count > Maximum ||
        Newˉmaximum <= Maximum || Length != (Maximum + 1u32) * 8u32 {
        return Empty;
    }
    var Cells: bytes = Bytesˉslice(
        Heap, Offset + 8u32, Count * 8u32
    );
    let Requiredˉcellˉbytes: u32 = Newˉmaximum * 8u32;
    while Bytesˉlength(Cells) < Requiredˉcellˉbytes {
        let Remaining: u32 = Requiredˉcellˉbytes - Bytesˉlength(Cells);
        var Addition: bytes = Cells;
        if Bytesˉlength(Addition) == 0u32 { Addition = Zeroˉcell; }
        if Bytesˉlength(Addition) > Remaining {
            Addition = Bytesˉslice(Addition, 0u32, Remaining);
        }
        Cells = Bytesˉconcat(Cells, Addition);
    }
    return Bytesˉconcat(
        Bytesˉconcat(
            Bytesˉfromˉu32ˉlittle(Count),
            Bytesˉfromˉu32ˉlittle(Header - Maximum + Newˉmaximum)
        ),
        Cells
    );
}

export fn Collectionˉelement(
    Heap: bytes,
    Value: bytes,
    Index: u32
) -> bytes {
    let Empty: bytes = Bytesˉslice(Heap, 0u32, 0u32);
    let Offset: u32 = Bytesˉreadˉu32ˉlittle(Value, 0u32);
    let Count: u32 = Bytesˉreadˉu32ˉlittle(Heap, Offset);
    if Index >= Count { return Empty; }
    return Bytesˉslice(Heap, Offset + 8u32 + Index * 8u32, 8u32);
}

export record Collectionˉrecordˉroots {
    Valid: bool;
    Allocationˉindex: u32;
    Roots: bytes;
}

export fn Collectionˉrecordˉelementˉroots(
    Module: bytes,
    Typeˉoffsets: bytes,
    Typeˉcount: u32,
    Heap: bytes,
    Allocations: bytes,
    Allocationˉcount: u32,
    Recordˉmetadata: bytes,
    Value: bytes
) -> Collectionˉrecordˉroots {
    let Empty: bytes = Bytesˉslice(Value, 0u32, 0u32);
    let Invalid: Collectionˉrecordˉroots = Collectionˉrecordˉroots(
        false, 4294967295u32, Empty
    );
    if Allocationˉcount > 4096u32 ||
        Bytesˉlength(Allocations) != Allocationˉcount * 12u32 ||
        Bytesˉlength(Heap) > 65536u32 ||
        Bytesˉlength(Recordˉmetadata) != 6144u32 ||
        !Collectionˉbackingˉvalid(
            Heap, Allocations, Allocationˉcount, Value
        ) {
        return Invalid;
    }
    let Type: u32 = Collectionˉtype(Heap, Value);
    if Type >= Typeˉcount { return Invalid; }
    var Shape: u32 = Collectionˉelementˉshape(
        Module, Typeˉoffsets, Typeˉcount, Type, 5u32
    );
    if Shape == 4294967295u32 {
        Shape = Collectionˉelementˉshape(
            Module, Typeˉoffsets, Typeˉcount, Type, 6u32
        );
    }
    if Shape == 4294967295u32 { return Invalid; }
    let Offset: u32 = Bytesˉreadˉu32ˉlittle(Value, 0u32);
    let Length: u32 = Bytesˉreadˉu32ˉlittle(Value, 4u32);
    var Allocationˉindex: u32 = 4294967295u32;
    var Index: u32 = 0u32;
    while Index < Allocationˉcount {
        let Entry: u32 = Index * 12u32;
        if Bytesˉreadˉu32ˉlittle(Allocations, Entry) == Offset &&
            Bytesˉreadˉu32ˉlittle(Allocations, Entry + 4u32) == Length &&
            Bytesˉreadˉu32ˉlittle(Allocations, Entry + 8u32) > 0u32 {
            Allocationˉindex = Index;
        }
        Index = Index + 1u32;
    }
    if Allocationˉindex == 4294967295u32 { return Invalid; }
    if Collectionˉscalarˉelement(Module, Shape) {
        return Collectionˉrecordˉroots(true, Allocationˉindex, Empty);
    }
    if U32ˉfromˉu8(Bytesˉreadˉu8(Module, Shape)) != 7u32 {
        return Invalid;
    }
    let Recordˉtype: u32 = Bytesˉreadˉu32ˉlittle(Module, Shape + 1u32);
    if Recordˉtype >= Typeˉcount { return Invalid; }
    let Recordˉfields: u32 = Collectionˉrecordˉfieldˉcount(
        Module, Typeˉoffsets, Typeˉcount, Recordˉtype);
    if Recordˉfields == 4294967295u32 { return Invalid; }
    let Expectedˉowner: u32 = Recordˉtype + 1u32;
    let Count: u32 = Bytesˉreadˉu32ˉlittle(Heap, Offset);
    var Roots: bytes = Empty;
    var Cell: u32 = 0u32;
    while Cell < Count {
        let Handle: bytes = Bytesˉslice(
            Heap, Offset + 8u32 + Cell * 8u32, 8u32
        );
        let Slot: u32 = Bytesˉreadˉu32ˉlittle(Handle, 0u32);
        if Recordˉfields == 0u32 {
            if Slot != 4294967295u32 || Bytesˉreadˉu32ˉlittle(Handle, 4u32) != Expectedˉowner {
                return Invalid;
            }
        } else {
            if Slot >= 768u32 || Recordˉfields > 768u32 - Slot ||
                Bytesˉreadˉu32ˉlittle(Handle, 4u32) != Expectedˉowner ||
                Bytesˉreadˉu32ˉlittle(Recordˉmetadata, Slot * 8u32) !=
                    Expectedˉowner ||
                Bytesˉreadˉu32ˉlittle(Recordˉmetadata, Slot * 8u32 + 4u32) !=
                    Recordˉfields {
                return Invalid;
            }
            Roots = Bytesˉconcat(Roots, Handle);
        }
        Cell = Cell + 1u32;
    }
    return Collectionˉrecordˉroots(true, Allocationˉindex, Roots);
}
