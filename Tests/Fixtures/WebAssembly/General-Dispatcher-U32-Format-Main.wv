module Webassemblyˉgeneralˉdispatcherˉu32ˉformat profile portable;

fn Checkˉsingle(Value: u32, Expected: u8) -> bool {
    let Encoded: bytes = Textˉtoˉutf8(U32ˉformat(Value));
    if Bytesˉlength(Encoded) != 1u32 { return false; }
    return Bytesˉreadˉu8(Encoded, 0u32) == Expected;
}

export fn Main() -> i32 {
    if !Checkˉsingle(0u32, 48u8) { return 1; }
    if !Checkˉsingle(9u32, 57u8) { return 2; }

    let Ten: bytes = Textˉtoˉutf8(U32ˉformat(10u32));
    if Bytesˉlength(Ten) != 2u32 { return 3; }
    if Bytesˉreadˉu16ˉlittle(Ten, 0u32) != 12337u32 { return 4; }

    let Maximum: bytes = Textˉtoˉutf8(U32ˉformat(4294967295u32));
    if Bytesˉlength(Maximum) != 10u32 { return 5; }
    if Bytesˉreadˉu32ˉlittle(Maximum, 0u32) != 876163636u32 { return 6; }
    if Bytesˉreadˉu32ˉlittle(Maximum, 4u32) != 842479161u32 { return 7; }
    if Bytesˉreadˉu16ˉlittle(Maximum, 8u32) != 13625u32 { return 8; }
    return 42;
}
