module Webassemblyˉgeneralˉdispatcherˉdynamicˉdescriptors profile portable;

record Packet {
    Payload: bytes;
    Label: text;
    Width: u32;
}

fn Make() -> Packet {
    let First: bytes = Bytesˉfromˉu8(42u8);
    let Second: bytes = Bytesˉfromˉu16ˉlittle(4660u32);
    let Third: bytes = Bytesˉfromˉu32ˉlittle(2309737967u32);
    let Fourth: bytes = Bytesˉfromˉi32ˉlittle(-1);
    let Left: bytes = Bytesˉconcat(First, Second);
    let Right: bytes = Bytesˉconcat(Third, Fourth);
    let Payload: bytes = Bytesˉconcat(Left, Right);
    let Label: text = Textˉconcat("Wind", "vale");
    return Packet(Payload, Label, Bytesˉlength(Payload));
}

fn Forward(Value: Packet) -> Packet {
    return Value;
}

fn Stress() -> u32 {
    var Index: u32 = 0u32;
    var Total: u32 = 0u32;
    while Index < 24u32 {
        let Value: Packet = Make();
        let Payload: bytes = Value.Payload;
        let Slice: bytes = Bytesˉslice(Payload, 1u32, 4u32);
        Total = Total + Bytesˉlength(Slice);
        Index = Index + 1u32;
    }
    return Total;
}

export fn Main() -> i32 {
    let Original: Packet = Make();
    let Routed: Packet = Forward(Original);
    let Payload: bytes = Routed.Payload;
    let Label: text = Original.Label;
    let Encoded: bytes = Textˉtoˉutf8(Label);
    let Slice: bytes = Bytesˉslice(Payload, 1u32, 6u32);

    if Bytesˉlength(Payload) != 11u32 { return 1; }
    if Bytesˉreadˉu8(Payload, 0u32) != 42u8 { return 2; }
    if Bytesˉreadˉu16ˉlittle(Payload, 1u32) != 4660u32 { return 3; }
    if Bytesˉreadˉu32ˉlittle(Slice, 2u32) != 2309737967u32 { return 4; }
    if Bytesˉreadˉi32ˉlittle(Payload, 7u32) != -1 { return 5; }
    if Bytesˉlength(Encoded) != 8u32 { return 6; }
    if Stress() != 96u32 { return 7; }
    if !Textˉutf8ˉisˉvalid(Encoded) { return 8; }
    let Decoded: text = Textˉfromˉutf8(Encoded);
    let Roundˉtrip: bytes = Textˉtoˉutf8(Decoded);
    if Bytesˉlength(Roundˉtrip) != 8u32 { return 9; }
    if Bytesˉreadˉu32ˉlittle(Roundˉtrip, 0u32) != 1684957527u32 {
        return 10;
    }

    Make();
    return 42;
}
