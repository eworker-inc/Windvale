module WebAssemblyˉwvbˉscalarˉinterpreterˉfixedˉintegerˉcore profile portable;

import WebAssemblyˉwvbˉscalarˉinterpreterˉruneˉcore as Runes;
import WebAssemblyˉwvbˉscalarˉinterpreterˉfloatingˉcore as Floating;

fn Result(Status: u32, Value: u32) -> bytes {
    return Bytesˉconcat(
        Bytesˉfromˉu32ˉlittle(Status),
        Bytesˉfromˉu32ˉlittle(Value)
    );
}

export fn Scanˉfixedˉinteger(
    Module: bytes,
    Offset: u32,
    Remaining: u32,
    Minor: u32
) -> u32 {
    if Minor < 12u32 || Minor > 29u32 || Remaining < 3u32 { return 0u32; }
    let Kind: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(Module, Offset + 1u32));
    let Operation: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(Module, Offset + 2u32));
    if Kind < 14u32 || Kind > 16u32 || Operation > 18u32 { return 0u32; }
    var Width: u32 = 3u32;
    if Operation == 0u32 {
        Width = 5u32;
        if Remaining < Width { return 0u32; }
        if Kind == 14u32 && Bytesˉreadˉu8(Module, Offset + 4u32) != 0u8 {
            return 0u32;
        }
    }
    if Operation == 6u32 && Kind == 16u32 { return 0u32; }
    if Operation >= 13u32 && Kind != 16u32 { return 0u32; }
    return Width;
}

export fn Shapeˉisˉsupported(Kind: u32, Minor: u32) -> bool {
    if Kind >= 1u32 && Kind <= 10u32 { return true; }
    if Minor >= 11u32 && Minor <= 29u32 && Kind == 11u32 { return true; }
    if Minor >= 12u32 && Minor <= 29u32 && Kind >= 14u32 && Kind <= 16u32 {
        return true;
    }
    if Minor >= 13u32 && Minor <= 29u32 && Kind == 17u32 { return true; }
    if Minor >= 14u32 && Minor <= 29u32 && Kind >= 18u32 && Kind <= 19u32 {
        return true;
    }
    if Minor >= 15u32 && Minor <= 29u32 && Kind >= 20u32 && Kind <= 21u32 {
        return true;
    }
    if Minor >= 17u32 && Minor <= 29u32 && Kind == 22u32 { return true; }
    if Minor >= 18u32 && Minor <= 29u32 &&
        (Kind == 23u32 || Kind == 24u32) {
        return true;
    }
    if Minor >= 26u32 && (Kind == 26u32 || Kind == 27u32) { return true; }
    if Minor >= 28u32 && Minor <= 29u32 &&
        Kind >= 28u32 && Kind <= 30u32 { return true; }
    if Minor == 29u32 && Kind == 34u32 { return true; }
    return Minor >= 21u32 && Minor <= 29u32 && Kind == 25u32;
}

export fn Scanˉfunction(
    Module: bytes,
    Offset: u32,
    Length: u32,
    Minor: u32,
    Requestˉmajor: u32
) -> u32 {
    var Cursor: u32 = 0u32;
    var Instructions: u32 = 0u32;
    while Cursor < Length {
        let Opcode: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(
            Module, Offset + Cursor
        ));
        var Width: u32 = 1u32;
        var Supported: bool = false;
        if Opcode == 1u32 { Width = 5u32; Supported = true; }
        if Opcode == 2u32 { Width = 2u32; Supported = true; }
        if Opcode >= 3u32 && Opcode <= 7u32 {
            Width = 5u32;
            Supported = true;
        }
        if Opcode == 8u32 { Width = 2u32; Supported = true; }
        if Opcode == 9u32 || Opcode == 10u32 {
            Width = 5u32;
            Supported = true;
        }
        if Opcode >= 11u32 && Opcode <= 15u32 { Supported = true; }
        if Opcode >= 16u32 && Opcode <= 22u32 { Supported = true; }
        if Opcode >= 32u32 && Opcode <= 40u32 { Supported = true; }
        if Opcode == 48u32 || Opcode == 49u32 || Opcode == 64u32 {
            Width = 5u32;
            Supported = true;
        }
        if Opcode == 65u32 && Requestˉmajor >= 3u32 {
            Width = 5u32;
            Supported = true;
        }
        if Opcode == 80u32 || Opcode == 81u32 { Supported = true; }
        if Opcode >= 96u32 && Opcode <= 103u32 { Supported = true; }
        if Opcode == 104u32 || Opcode == 105u32 {
            Width = 5u32;
            Supported = true;
        }
        if Opcode == 106u32 { Width = 9u32; Supported = true; }
        if Opcode >= 107u32 && Opcode <= 125u32 { Supported = true; }
        if Opcode == 129u32 {
            Width = 9u32;
            Supported = true;
        }
        if Opcode >= 134u32 && Opcode <= 136u32 { Supported = true; }
        if Opcode >= 143u32 && Opcode <= 148u32 { Supported = true; }
        if Opcode >= 151u32 && Opcode <= 153u32 {
            Width = 9u32;
            Supported = true;
        }
        if Opcode == 161u32 || Opcode == 162u32 { Supported = true; }
        if Opcode >= 173u32 && Opcode <= 178u32 { Supported = true; }
        if Opcode >= 179u32 && Opcode <= 184u32 { Supported = true; }
        if Opcode == 190u32 || Opcode == 191u32 { Supported = true; }
        if Opcode == 192u32 {
            Width = Scanˉfixedˉinteger(
                Module, Offset + Cursor, Length - Cursor, Minor
            );
            if Width == 0u32 { return 0u32; }
            Supported = true;
        }
        if Opcode == 193u32 {
            Width = Runes.Scanˉrune(
                Module, Offset + Cursor, Length - Cursor, Minor
            );
            if Width == 0u32 { return 0u32; }
            Supported = true;
        }
        if Opcode == 194u32 {
            Width = Floating.Scanˉfloating(
                Module, Offset + Cursor, Length - Cursor, Minor
            );
            if Width == 0u32 { return 0u32; }
            Supported = true;
        }
        if Opcode == 195u32 {
            if Minor < 15u32 || Minor > 29u32 { return 0u32; }
            Supported = true;
        }
        if Opcode == 196u32 {
            if Minor < 16u32 || Minor > 29u32 { return 0u32; }
            Width = 9u32;
            Supported = true;
        }
        if Opcode == 197u32 {
            if Minor < 17u32 || Minor > 29u32 { return 0u32; }
            Width = 5u32;
            Supported = true;
        }
        if Opcode == 198u32 {
            if Minor < 17u32 || Minor > 29u32 { return 0u32; }
            Supported = true;
        }
        if Opcode == 199u32 || Opcode == 200u32 ||
            (Opcode >= 202u32 && Opcode <= 204u32) {
            if Minor < 19u32 || Minor > 29u32 { return 0u32; }
            Width = 5u32;
            Supported = true;
        }
        if Opcode == 201u32 {
            if Minor < 19u32 || Minor > 29u32 { return 0u32; }
            Width = 9u32;
            Supported = true;
        }
        if Opcode == 205u32 {
            if Minor < 20u32 || Minor > 29u32 {
                return 0u32;
            }
            Width = 5u32;
            Supported = true;
        }
        if Opcode == 206u32 {
            if Minor < 23u32 || Minor > 29u32 { return 0u32; }
            Width = 9u32;
            Supported = true;
        }
        if Opcode == 207u32 {
            if Minor < 24u32 || Minor > 29u32 { return 0u32; }
            Width = 9u32;
            Supported = true;
        }
        if Opcode == 208u32 {
            if Minor < 25u32 || Minor > 29u32 { return 0u32; }
            Width = 9u32;
            Supported = true;
        }
        if Opcode == 209u32 {
            if Minor < 27u32 || Minor > 29u32 { return 0u32; }
            Width = 13u32;
            Supported = true;
        }
        if Opcode == 210u32 {
            if Minor != 29u32 { return 0u32; }
            Width = 5u32;
            Supported = true;
        }
        if !Supported || Width > Length - Cursor { return 0u32; }
        Cursor = Cursor + Width;
        Instructions = Instructions + 1u32;
        if Instructions > 400000u32 { return 0u32; }
    }
    return Instructions;
}

export fn Evaluateˉfixedˉinteger(
    Kind: u32,
    Operation: u32,
    Left: u32,
    Right: u32
) -> bytes {
    if Kind == 16u32 {
        var Unsignedˉvalue: u32 = 0u32;
        if Operation == 1u32 { Unsignedˉvalue = Left + Right; }
        if Operation == 2u32 {
            if Left < Right { return Result(3007u32, 0u32); }
            Unsignedˉvalue = Left - Right;
        }
        if Operation == 3u32 { Unsignedˉvalue = Left * Right; }
        if Operation == 4u32 || Operation == 5u32 {
            if Right == 0u32 { return Result(3032u32, 0u32); }
            if Operation == 4u32 { Unsignedˉvalue = Left / Right; }
            if Operation == 5u32 { Unsignedˉvalue = Left % Right; }
        }
        var Unsignedˉmatches: bool = false;
        if Operation == 7u32 { Unsignedˉmatches = Left == Right; }
        if Operation == 8u32 { Unsignedˉmatches = Left != Right; }
        if Operation == 9u32 { Unsignedˉmatches = Left < Right; }
        if Operation == 10u32 { Unsignedˉmatches = Left <= Right; }
        if Operation == 11u32 { Unsignedˉmatches = Left > Right; }
        if Operation == 12u32 { Unsignedˉmatches = Left >= Right; }
        if Operation >= 7u32 && Operation <= 12u32 {
            if Unsignedˉmatches { Unsignedˉvalue = 1u32; }
            return Result(0u32, Unsignedˉvalue);
        }
        if Operation == 13u32 { Unsignedˉvalue = Left & Right; }
        if Operation == 14u32 { Unsignedˉvalue = Left | Right; }
        if Operation == 15u32 { Unsignedˉvalue = Left ^ Right; }
        if Operation == 16u32 { Unsignedˉvalue = (~Left) & 65535u32; }
        if Operation == 17u32 || Operation == 18u32 {
            if Right >= 16u32 { return Result(3033u32, 0u32); }
            if Operation == 17u32 {
                Unsignedˉvalue = (Left << Right) & 65535u32;
            }
            if Operation == 18u32 { Unsignedˉvalue = Left >> Right; }
        }
        if Unsignedˉvalue > 65535u32 { return Result(3007u32, 0u32); }
        return Result(0u32, Unsignedˉvalue);
    }

    let Signedˉleft: i32 = Bytesˉreadˉi32ˉlittle(
        Bytesˉfromˉu32ˉlittle(Left), 0u32
    );
    let Signedˉright: i32 = Bytesˉreadˉi32ˉlittle(
        Bytesˉfromˉu32ˉlittle(Right), 0u32
    );
    var Signedˉminimum: i32 = -128;
    var Signedˉmaximum: i32 = 127;
    if Kind == 15u32 {
        Signedˉminimum = -32768;
        Signedˉmaximum = 32767;
    }
    var Signedˉvalue: i32 = 0;
    if Operation == 1u32 { Signedˉvalue = Signedˉleft + Signedˉright; }
    if Operation == 2u32 { Signedˉvalue = Signedˉleft - Signedˉright; }
    if Operation == 3u32 { Signedˉvalue = Signedˉleft * Signedˉright; }
    if Operation == 4u32 || Operation == 5u32 {
        if Signedˉright == 0 { return Result(3032u32, 0u32); }
        let Leftˉnegative: bool = Signedˉleft < 0;
        let Rightˉnegative: bool = Signedˉright < 0;
        var Leftˉmagnitude: u32 = Left;
        var Rightˉmagnitude: u32 = Right;
        if Leftˉnegative {
            Leftˉmagnitude = 4294967295u32 - Left + 1u32;
        }
        if Rightˉnegative {
            Rightˉmagnitude = 4294967295u32 - Right + 1u32;
        }
        var Signedˉmagnitude: u32 =
            Leftˉmagnitude / Rightˉmagnitude;
        var Resultˉnegative: bool = Leftˉnegative != Rightˉnegative;
        if Operation == 5u32 {
            Signedˉmagnitude = Leftˉmagnitude % Rightˉmagnitude;
            Resultˉnegative = Leftˉnegative;
        }
        var Signedˉraw: u32 = Signedˉmagnitude;
        if Resultˉnegative && Signedˉmagnitude != 0u32 {
            Signedˉraw = 4294967295u32 - Signedˉmagnitude + 1u32;
        }
        Signedˉvalue = Bytesˉreadˉi32ˉlittle(
            Bytesˉfromˉu32ˉlittle(Signedˉraw), 0u32
        );
    }
    if Operation == 6u32 { Signedˉvalue = -Signedˉleft; }
    var Signedˉmatches: bool = false;
    if Operation == 7u32 { Signedˉmatches = Signedˉleft == Signedˉright; }
    if Operation == 8u32 { Signedˉmatches = Signedˉleft != Signedˉright; }
    if Operation == 9u32 { Signedˉmatches = Signedˉleft < Signedˉright; }
    if Operation == 10u32 { Signedˉmatches = Signedˉleft <= Signedˉright; }
    if Operation == 11u32 { Signedˉmatches = Signedˉleft > Signedˉright; }
    if Operation == 12u32 { Signedˉmatches = Signedˉleft >= Signedˉright; }
    if Operation >= 7u32 && Operation <= 12u32 {
        var Signedˉflag: u32 = 0u32;
        if Signedˉmatches { Signedˉflag = 1u32; }
        return Result(0u32, Signedˉflag);
    }
    if Signedˉvalue < Signedˉminimum || Signedˉvalue > Signedˉmaximum {
        return Result(3007u32, 0u32);
    }
    return Result(
        0u32,
        Bytesˉreadˉu32ˉlittle(Bytesˉfromˉi32ˉlittle(Signedˉvalue), 0u32)
    );
}

fn Execution(Metadata: u8, Status: u32, Stack: bytes) -> bytes {
    return Bytesˉconcat(
        Bytesˉfromˉu8(Metadata),
        Bytesˉconcat(Bytesˉfromˉu32ˉlittle(Status), Stack)
    );
}

export fn Executeˉfixedˉinteger(
    Module: bytes,
    Offset: u32,
    Stack: bytes,
    Stackˉdescriptorˉcount: u32,
    Zeroˉvalue: bytes
) -> bytes {
    let Kind: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(Module, Offset + 1u32));
    let Operation: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(Module, Offset + 2u32));
    if Operation == 0u32 {
        let Raw: u32 = Bytesˉreadˉu16ˉlittle(Module, Offset + 3u32);
        var Constant: u32 = Raw;
        if Kind == 14u32 && Raw >= 128u32 {
            Constant = 4294967040u32 + Raw;
        }
        if Kind == 15u32 && Raw >= 32768u32 {
            Constant = 4294901760u32 + Raw;
        }
        return Execution(
            20u8,
            0u32,
            Bytesˉconcat(
                Stack,
                Bytesˉconcat(Bytesˉfromˉu32ˉlittle(Constant), Zeroˉvalue)
            )
        );
    }

    var Operands: u32 = 2u32;
    if Operation == 6u32 || Operation == 16u32 { Operands = 1u32; }
    if Stackˉdescriptorˉcount < Operands {
        return Bytesˉslice(Stack, 0u32, 0u32);
    }
    var Remainingˉstack: bytes = Stack;
    var Stackˉlength: u32 = Bytesˉlength(Remainingˉstack);
    var Right: u32 = 0u32;
    var Left: u32 = Bytesˉreadˉu32ˉlittle(
        Remainingˉstack, Stackˉlength - 8u32
    );
    Remainingˉstack = Bytesˉslice(
        Remainingˉstack, 0u32, Stackˉlength - 8u32
    );
    if Operands == 2u32 {
        Right = Left;
        Stackˉlength = Bytesˉlength(Remainingˉstack);
        Left = Bytesˉreadˉu32ˉlittle(
            Remainingˉstack, Stackˉlength - 8u32
        );
        Remainingˉstack = Bytesˉslice(
            Remainingˉstack, 0u32, Stackˉlength - 8u32
        );
    }
    let Evaluated: bytes = Evaluateˉfixedˉinteger(
        Kind, Operation, Left, Right
    );
    let Status: u32 = Bytesˉreadˉu32ˉlittle(Evaluated, 0u32);
    if Status == 0u32 {
        Remainingˉstack = Bytesˉconcat(
            Remainingˉstack,
            Bytesˉconcat(Bytesˉslice(Evaluated, 4u32, 4u32), Zeroˉvalue)
        );
    }
    var Metadata: u8 = 14u8;
    if Operands == 1u32 { Metadata = 13u8; }
    return Execution(Metadata, Status, Remainingˉstack);
}

export fn Executeˉscalar(
    Module: bytes,
    Offset: u32,
    Stack: bytes,
    Stackˉdescriptorˉcount: u32,
    Zeroˉvalue: bytes
) -> bytes {
    let Opcode: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(Module, Offset));
    if Opcode == 195u32 {
        return Execution(
            4u8,
            0u32,
            Bytesˉconcat(Stack, Bytesˉconcat(Zeroˉvalue, Zeroˉvalue))
        );
    }
    if Opcode == 129u32 ||
        (Opcode >= 134u32 && Opcode <= 136u32) ||
        (Opcode >= 143u32 && Opcode <= 148u32) ||
        (Opcode >= 179u32 && Opcode <= 184u32) ||
        Opcode == 191u32 {
        if Opcode == 129u32 {
            return Execution(
                36u8, 0u32,
                Bytesˉconcat(
                    Stack,
                    Bytesˉslice(Module, Offset + 1u32, 8u32)
                )
            );
        }
        if Stackˉdescriptorˉcount < 1u32 {
            return Bytesˉslice(Stack, 0u32, 0u32);
        }
        let Stackˉlength: u32 = Bytesˉlength(Stack);
        if Opcode == 191u32 {
            return Execution(
                5u8, 0u32,
                Bytesˉconcat(
                    Bytesˉslice(Stack, 0u32, Stackˉlength - 8u32),
                    Bytesˉfromˉu64ˉlittle(U64ˉfromˉu32(
                        Bytesˉreadˉu32ˉlittle(Stack, Stackˉlength - 8u32)
                    ))
                )
            );
        }
        var Operands: u32 = 2u32;
        if Opcode == 182u32 { Operands = 1u32; }
        if Stackˉdescriptorˉcount < Operands {
            return Bytesˉslice(Stack, 0u32, 0u32);
        }
        var Right: u64 = 0u64;
        var Left: u64 = Bytesˉreadˉu64ˉlittle(
            Stack, Stackˉlength - 8u32
        );
        var Remainingˉstack: bytes = Bytesˉslice(
            Stack, 0u32, Stackˉlength - 8u32
        );
        if Operands == 2u32 {
            Right = Left;
            Left = Bytesˉreadˉu64ˉlittle(
                Remainingˉstack,
                Bytesˉlength(Remainingˉstack) - 8u32
            );
            Remainingˉstack = Bytesˉslice(
                Remainingˉstack,
                0u32,
                Bytesˉlength(Remainingˉstack) - 8u32
            );
        }
        var Value: u64 = 0u64;
        if Opcode == 134u32 { Value = Left + Right; }
        if Opcode == 135u32 { Value = Left - Right; }
        if Opcode == 136u32 { Value = Left * Right; }
        if Opcode == 143u32 && Left == Right { Value = 1u64; }
        if Opcode == 144u32 && Left != Right { Value = 1u64; }
        if Opcode == 145u32 && Left < Right { Value = 1u64; }
        if Opcode == 146u32 && Left <= Right { Value = 1u64; }
        if Opcode == 147u32 && Left > Right { Value = 1u64; }
        if Opcode == 148u32 && Left >= Right { Value = 1u64; }
        if Opcode == 179u32 { Value = Left & Right; }
        if Opcode == 180u32 { Value = Left | Right; }
        if Opcode == 181u32 { Value = Left ^ Right; }
        if Opcode == 182u32 { Value = ~Left; }
        if Opcode == 183u32 || Opcode == 184u32 {
            let Shift: u32 = Bytesˉreadˉu32ˉlittle(
                Stack, Stackˉlength - 8u32
            );
            if Shift >= 64u32 { return Execution(6u8, 3033u32, Remainingˉstack); }
            if Opcode == 183u32 { Value = Left << Shift; }
            if Opcode == 184u32 { Value = Left >> Shift; }
        }
        var Metadata: u8 = 6u8;
        if Operands == 1u32 { Metadata = 5u8; }
        return Execution(
            Metadata, 0u32,
            Bytesˉconcat(Remainingˉstack, Bytesˉfromˉu64ˉlittle(Value))
        );
    }
    if Opcode == 192u32 {
        return Executeˉfixedˉinteger(
            Module, Offset, Stack, Stackˉdescriptorˉcount, Zeroˉvalue
        );
    }
    if Opcode == 193u32 {
        return Runes.Executeˉrune(
            Module, Offset, Stack, Stackˉdescriptorˉcount, Zeroˉvalue
        );
    }
    return Floating.Executeˉfloating(
        Module, Offset, Stack, Stackˉdescriptorˉcount, Zeroˉvalue
    );
}
