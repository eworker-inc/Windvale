                    );
                }
            }
        }
        if Sectionˉkind == 0u32 {
            if Stackˉconsumed > Stackˉdescriptorˉcount {
                return Invalid;
            }
            let Stackˉremainingˉcount: u32 =
                Stackˉdescriptorˉcount - Stackˉconsumed;
            if Stackˉremainingˉcount < 32u32 {
