module WebAssemblyˉwvbˉscalarˉinterpreter profile portable;

import Foundationˉsha256 as Sha256;
import WebAssemblyˉwvbˉscalarˉinterpreterˉstackˉeffect as Stackˉeffect;

export fn Main(Request: bytes) -> bytes {
    let Invalid: bytes = Bytesˉslice(Request, 0u32, 0u32);
    let Requestˉlength: u32 = Bytesˉlength(Request);
    if Requestˉlength < 17u32 { return Invalid; }
    if Bytesˉreadˉu32ˉlittle(Request, 0u32) != 1230526039u32 {
        return Invalid;
    }
    let Requestˉmajor: u32 = Bytesˉreadˉu16ˉlittle(Request, 4u32);
    if Requestˉmajor < 1u32 { return Invalid; }
    if Requestˉmajor > 2u32 { return Invalid; }
    if Bytesˉreadˉu16ˉlittle(Request, 6u32) != 0u32 { return Invalid; }
    let Maximumˉinstructions: u32 = Bytesˉreadˉu32ˉlittle(Request, 8u32);
    let Maximumˉcallˉdepth: u32 = Bytesˉreadˉu32ˉlittle(Request, 12u32);
    if Maximumˉinstructions < 1u32 { return Invalid; }
    if Maximumˉinstructions > 20000000u32 { return Invalid; }
    if Maximumˉcallˉdepth < 1u32 { return Invalid; }
    if Maximumˉcallˉdepth > 64u32 { return Invalid; }

    var Module: bytes = Invalid;
    var Guestˉinput: bytes = Invalid;
    if Requestˉmajor == 2u32 {
        if Requestˉlength < 24u32 { return Invalid; }
        let Moduleˉlength: u32 = Bytesˉreadˉu32ˉlittle(Request, 16u32);
        let Guestˉinputˉlength: u32 = Bytesˉreadˉu32ˉlittle(Request, 20u32);
        if Moduleˉlength > Requestˉlength - 24u32 { return Invalid; }
        if Guestˉinputˉlength != Requestˉlength - 24u32 - Moduleˉlength {
            return Invalid;
        }
        if Guestˉinputˉlength > 16384u32 { return Invalid; }
        Module = Bytesˉslice(Request, 24u32, Moduleˉlength);
        Guestˉinput = Bytesˉslice(
            Request,
            24u32 + Moduleˉlength,
            Guestˉinputˉlength
        );
    } else {
        Module = Bytesˉslice(Request, 16u32, Requestˉlength - 16u32);
    }
    let Total: u32 = Bytesˉlength(Module);
    if Total < 12u32 { return Invalid; }
    if U32ˉfromˉu8(Bytesˉreadˉu8(Module, 0u32)) != 87u32 { return Invalid; }
    if U32ˉfromˉu8(Bytesˉreadˉu8(Module, 1u32)) != 86u32 { return Invalid; }
    if U32ˉfromˉu8(Bytesˉreadˉu8(Module, 2u32)) != 66u32 { return Invalid; }
    if U32ˉfromˉu8(Bytesˉreadˉu8(Module, 3u32)) != 49u32 { return Invalid; }
    if Bytesˉreadˉu16ˉlittle(Module, 4u32) != 1u32 { return Invalid; }
    if Bytesˉreadˉu16ˉlittle(Module, 6u32) != 11u32 { return Invalid; }
    if Bytesˉreadˉu32ˉlittle(Module, 8u32) != 7u32 { return Invalid; }

    var Envelope: u32 = 12u32;
    var Sectionˉkind: u32 = 1u32;
    var Payload: u32 = 0u32;
    var Payloadˉlength: u32 = 0u32;
    var Capabilities: u32 = 0u32;
    var Data: u32 = 0u32;
    var Functions: u32 = 0u32;
    var Functionsˉend: u32 = 0u32;
    var Code: u32 = 0u32;
    var Exports: u32 = 0u32;
    var Types: u32 = 0u32;
    while Sectionˉkind <= 7u32 {
        Payload = Envelope + 8u32;
        Payloadˉlength = Bytesˉreadˉu32ˉlittle(Module, Envelope + 4u32);
        if Sectionˉkind == 2u32 { Capabilities = Payload; }
        if Sectionˉkind == 3u32 { Data = Payload; }
        if Sectionˉkind == 4u32 {
            Functions = Payload;
            Functionsˉend = Payload + Payloadˉlength;
        }
        if Sectionˉkind == 5u32 { Code = Payload; }
        if Sectionˉkind == 6u32 { Exports = Payload; }
        if Sectionˉkind == 7u32 { Types = Payload; }
        Envelope = Payload + Payloadˉlength;
        Sectionˉkind = Sectionˉkind + 1u32;
    }
    if Envelope != Total { return Invalid; }
    if U32ˉfromˉu8(Bytesˉreadˉu8(Module, 20u32)) != 1u32 {
        return Invalid;
    }
    if Bytesˉreadˉu32ˉlittle(Module, Capabilities) != 0u32 {
        return Invalid;
    }

    let Zeroˉvalue: bytes = Bytesˉfromˉu32ˉlittle(0u32);
    let Zeroˉcell: bytes = Bytesˉconcat(Zeroˉvalue, Zeroˉvalue);

    let Typeˉcount: u32 = Bytesˉreadˉu32ˉlittle(Module, Types);
    if Typeˉcount > 1024u32 { return Invalid; }
    var Typeˉoffsets: bytes = Invalid;
    var Typeˉindex: u32 = 0u32;
    var Typeˉcursor: u32 = Types + 4u32;
    while Typeˉindex < Typeˉcount {
        Typeˉoffsets = Bytesˉconcat(
            Typeˉoffsets,
            Bytesˉfromˉu32ˉlittle(Typeˉcursor)
        );
        let Typeˉkind: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(Module, Typeˉcursor));
        if Typeˉkind != 1u32 {
            if Typeˉkind != 2u32 { return Invalid; }
        }
        Typeˉcursor = Typeˉcursor + 1u32;
        Typeˉcursor = Typeˉcursor + 4u32
            + Bytesˉreadˉu32ˉlittle(Module, Typeˉcursor);
        let Typeˉmemberˉcount: u32 = Bytesˉreadˉu32ˉlittle(
            Module,
            Typeˉcursor
        );
        Typeˉcursor = Typeˉcursor + 4u32;
        if Typeˉmemberˉcount < 1u32 { return Invalid; }
        if Typeˉkind == 1u32 {
            if Typeˉmemberˉcount > 64u32 { return Invalid; }
        } else {
            if Typeˉmemberˉcount > 256u32 { return Invalid; }
        }
        var Typeˉmemberˉindex: u32 = 0u32;
        while Typeˉmemberˉindex < Typeˉmemberˉcount {
            Typeˉcursor = Typeˉcursor + 4u32
                + Bytesˉreadˉu32ˉlittle(Module, Typeˉcursor);
            if Typeˉkind == 1u32 {
                let Fieldˉshapeˉkind: u32 = U32ˉfromˉu8(
                    Bytesˉreadˉu8(Module, Typeˉcursor)
                );
                if Fieldˉshapeˉkind < 1u32 { return Invalid; }
                if Fieldˉshapeˉkind > 10u32 { return Invalid; }
                Typeˉcursor = Typeˉcursor + 1u32;
                if Fieldˉshapeˉkind == 7u32 {
                    if Bytesˉreadˉu32ˉlittle(Module, Typeˉcursor) >= Typeˉcount {
                        return Invalid;
                    }
                    Typeˉcursor = Typeˉcursor + 4u32;
                }
                if Fieldˉshapeˉkind == 8u32 {
                    if Bytesˉreadˉu32ˉlittle(Module, Typeˉcursor) >= Typeˉcount {
                        return Invalid;
                    }
                    Typeˉcursor = Typeˉcursor + 4u32;
                }
            } else {
                Typeˉcursor = Typeˉcursor + 4u32;
            }
            Typeˉmemberˉindex = Typeˉmemberˉindex + 1u32;
        }
        Typeˉindex = Typeˉindex + 1u32;
    }

    let Functionˉcount: u32 = Bytesˉreadˉu32ˉlittle(Module, Functions);
    if Functionˉcount < 1u32 { return Invalid; }
    if Functionˉcount > 4096u32 { return Invalid; }

    var Mainˉfound: bool = false;
    var Mainˉindex: u32 = 0u32;
    let Exportˉcount: u32 = Bytesˉreadˉu32ˉlittle(Module, Exports);
    var Exportˉindex: u32 = 0u32;
    var Exportˉcursor: u32 = Exports + 4u32;
    while Exportˉindex < Exportˉcount {
        let Exportˉnameˉlength: u32 = Bytesˉreadˉu32ˉlittle(
            Module,
            Exportˉcursor
        );
        Exportˉcursor = Exportˉcursor + 4u32;
        var Isˉmain: bool = false;
        if Exportˉnameˉlength == 4u32 {
            Isˉmain = true;
            if U32ˉfromˉu8(Bytesˉreadˉu8(Module, Exportˉcursor)) != 77u32 {
                Isˉmain = false;
            }
            if U32ˉfromˉu8(
                Bytesˉreadˉu8(Module, Exportˉcursor + 1u32)
            ) != 97u32 {
                Isˉmain = false;
            }
            if U32ˉfromˉu8(
                Bytesˉreadˉu8(Module, Exportˉcursor + 2u32)
            ) != 105u32 {
                Isˉmain = false;
            }
            if U32ˉfromˉu8(
                Bytesˉreadˉu8(Module, Exportˉcursor + 3u32)
            ) != 110u32 {
                Isˉmain = false;
            }
        }
        Exportˉcursor = Exportˉcursor + Exportˉnameˉlength;
        if Isˉmain {
            if Mainˉfound { return Invalid; }
            if U32ˉfromˉu8(Bytesˉreadˉu8(Module, Exportˉcursor)) != 1u32 {
                return Invalid;
            }
            Mainˉfound = true;
            Mainˉindex = Bytesˉreadˉu32ˉlittle(Module, Exportˉcursor + 1u32);
        }
        Exportˉcursor = Exportˉcursor + 5u32;
        Exportˉindex = Exportˉindex + 1u32;
    }
    if Mainˉfound {
        Mainˉfound = true;
    } else {
        return Invalid;
    }
    Exportˉindex = 128u32;

    var Functionˉindex: u32 = 0u32;
    var Functionˉcursor: u32 = Functions + 4u32;
    var Aggregateˉinstructions: u32 = 0u32;
    var Mainˉcodeˉoffset: u32 = 0u32;
    var Mainˉcodeˉlength: u32 = 0u32;
    var Functionˉoffsets: bytes = Invalid;
    var Functionˉframeˉmetadata: bytes = Invalid;
    var Functionˉcodeˉoffsets: bytes = Invalid;
    var Functionˉcodeˉlengths: bytes = Invalid;
    var Functionˉshapeˉoffsets: bytes = Invalid;
    var Localˉshapes: bytes = Invalid;
    while Functionˉindex < Functionˉcount {
        Functionˉoffsets = Bytesˉconcat(
            Functionˉoffsets,
            Bytesˉfromˉu32ˉlittle(Functionˉcursor)
        );
        Functionˉcursor = Functionˉcursor + 4u32
            + Bytesˉreadˉu32ˉlittle(Module, Functionˉcursor);
        let Parameterˉcount: u32 = Bytesˉreadˉu32ˉlittle(
            Module,
            Functionˉcursor
        );
        if Parameterˉcount > 64u32 { return Invalid; }
        Functionˉframeˉmetadata = Bytesˉconcat(
            Functionˉframeˉmetadata,
            Bytesˉfromˉu32ˉlittle(Parameterˉcount)
        );
        Functionˉshapeˉoffsets = Bytesˉconcat(
            Functionˉshapeˉoffsets,
            Bytesˉfromˉu32ˉlittle(Bytesˉlength(Localˉshapes))
        );
        Functionˉcursor = Functionˉcursor + 4u32;
        var Shapeˉindex: u32 = 0u32;
        var Shapeˉkind: u32 = 0u32;
        var Parameterˉnominalˉtoken: u32 = 0u32;
        while Shapeˉindex < Parameterˉcount {
            Shapeˉkind = U32ˉfromˉu8(Bytesˉreadˉu8(Module, Functionˉcursor));
            if Functionˉindex == Mainˉindex {
                if Requestˉmajor == 2u32 {
                    if Shapeˉindex == 0u32 {
                        if Shapeˉkind != 6u32 { return Invalid; }
                    }
                }
            }
            if Shapeˉkind < 1u32 { return Invalid; }
            if Shapeˉkind > 10u32 { return Invalid; }
            Parameterˉnominalˉtoken = 0u32;
            Functionˉcursor = Functionˉcursor + 1u32;
            if Shapeˉkind == 7u32 {
                Parameterˉnominalˉtoken = Bytesˉreadˉu32ˉlittle(
                    Module,
                    Functionˉcursor
                );
                if Parameterˉnominalˉtoken >= Typeˉcount {
                    return Invalid;
                }
                Parameterˉnominalˉtoken = Parameterˉnominalˉtoken + 1u32;
                Functionˉcursor = Functionˉcursor + 4u32;
            }
            if Shapeˉkind == 8u32 {
                Parameterˉnominalˉtoken = Bytesˉreadˉu32ˉlittle(
                    Module,
                    Functionˉcursor
                );
                if Parameterˉnominalˉtoken >= Typeˉcount {
                    return Invalid;
                }
                Parameterˉnominalˉtoken = Parameterˉnominalˉtoken + 1u32;
                Functionˉcursor = Functionˉcursor + 4u32;
            }
            Localˉshapes = Bytesˉconcat(
                Localˉshapes,
                Bytesˉconcat(
                    Bytesˉfromˉu32ˉlittle(Shapeˉkind),
                    Bytesˉfromˉu32ˉlittle(Parameterˉnominalˉtoken)
                )
            );
            Shapeˉindex = Shapeˉindex + 1u32;
        }
        let Returnˉkind: u32 = U32ˉfromˉu8(
            Bytesˉreadˉu8(Module, Functionˉcursor)
        );
        if Returnˉkind < 1u32 { return Invalid; }
        if Returnˉkind > 10u32 { return Invalid; }
        Functionˉcursor = Functionˉcursor + 1u32;
        if Returnˉkind == 7u32 {
            if Bytesˉreadˉu32ˉlittle(Module, Functionˉcursor) >= Typeˉcount {
                return Invalid;
            }
            Functionˉcursor = Functionˉcursor + 4u32;
        }
        if Returnˉkind == 8u32 {
            if Bytesˉreadˉu32ˉlittle(Module, Functionˉcursor) >= Typeˉcount {
                return Invalid;
            }
            Functionˉcursor = Functionˉcursor + 4u32;
        }
        let Localˉcount: u32 = Bytesˉreadˉu32ˉlittle(
            Module,
            Functionˉcursor
        );
        if Localˉcount > 2048u32 - Parameterˉcount { return Invalid; }
        if Parameterˉcount + Localˉcount > Exportˉindex {
            Exportˉindex = Parameterˉcount + Localˉcount;
        }
        Functionˉcursor = Functionˉcursor + 4u32;
        Shapeˉindex = 0u32;
        var Localˉnominalˉtoken: u32 = 0u32;
        while Shapeˉindex < Localˉcount {
            Shapeˉkind = U32ˉfromˉu8(Bytesˉreadˉu8(Module, Functionˉcursor));
            if Shapeˉkind < 1u32 { return Invalid; }
            if Shapeˉkind > 10u32 { return Invalid; }
            Localˉnominalˉtoken = 0u32;
            Functionˉcursor = Functionˉcursor + 1u32;
            if Shapeˉkind == 7u32 {
                Localˉnominalˉtoken = Bytesˉreadˉu32ˉlittle(
                    Module,
                    Functionˉcursor
                );
                if Localˉnominalˉtoken >= Typeˉcount {
                    return Invalid;
                }
                Localˉnominalˉtoken = Localˉnominalˉtoken + 1u32;
                Functionˉcursor = Functionˉcursor + 4u32;
            }
            if Shapeˉkind == 8u32 {
                Localˉnominalˉtoken = Bytesˉreadˉu32ˉlittle(
                    Module,
                    Functionˉcursor
                );
                if Localˉnominalˉtoken >= Typeˉcount {
                    return Invalid;
                }
                Localˉnominalˉtoken = Localˉnominalˉtoken + 1u32;
                Functionˉcursor = Functionˉcursor + 4u32;
            }
            Localˉshapes = Bytesˉconcat(
                Localˉshapes,
                Bytesˉconcat(
                    Bytesˉfromˉu32ˉlittle(Shapeˉkind),
                    Bytesˉfromˉu32ˉlittle(Localˉnominalˉtoken)
                )
            );
            Shapeˉindex = Shapeˉindex + 1u32;
        }
        Functionˉframeˉmetadata = Bytesˉconcat(
            Functionˉframeˉmetadata,
            Bytesˉfromˉu32ˉlittle(
                (Parameterˉcount + Localˉcount) * 8u32
            )
        );
        let Functionˉcodeˉoffset: u32 = Bytesˉreadˉu32ˉlittle(
            Module,
            Functionˉcursor
        );
        let Functionˉcodeˉlength: u32 = Bytesˉreadˉu32ˉlittle(
            Module,
            Functionˉcursor + 4u32
        );
        if Bytesˉreadˉu32ˉlittle(Module, Functionˉcursor + 8u32) > 64u32 {
            return Invalid;
        }
        Functionˉcursor = Functionˉcursor + 12u32;
        Functionˉcodeˉoffsets = Bytesˉconcat(
            Functionˉcodeˉoffsets,
            Bytesˉfromˉu32ˉlittle(Functionˉcodeˉoffset)
        );
        Functionˉcodeˉlengths = Bytesˉconcat(
            Functionˉcodeˉlengths,
            Bytesˉfromˉu32ˉlittle(Functionˉcodeˉlength)
        );
        if Functionˉindex == Mainˉindex {
            if Requestˉmajor == 1u32 {
                if Parameterˉcount != 0u32 { return Invalid; }
                if Returnˉkind != 1u32 { return Invalid; }
            } else {
                if Parameterˉcount != 1u32 { return Invalid; }
                if Returnˉkind != 6u32 { return Invalid; }
            }
            Mainˉcodeˉoffset = Functionˉcodeˉoffset;
            Mainˉcodeˉlength = Functionˉcodeˉlength;
        }

        var Scan: u32 = 0u32;
        while Scan < Functionˉcodeˉlength {
            let Scanˉopcode: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(
                Module,
                Code + Functionˉcodeˉoffset + Scan
            ));
            var Width: u32 = 1u32;
            var Supported: bool = false;
            if Scanˉopcode == 1u32 { Width = 5u32; Supported = true; }
            if Scanˉopcode == 2u32 { Width = 2u32; Supported = true; }
            if Scanˉopcode == 3u32 { Width = 5u32; Supported = true; }
            if Scanˉopcode == 4u32 { Width = 5u32; Supported = true; }
            if Scanˉopcode == 5u32 { Width = 5u32; Supported = true; }
            if Scanˉopcode == 6u32 { Width = 5u32; Supported = true; }
            if Scanˉopcode == 7u32 { Width = 5u32; Supported = true; }
            if Scanˉopcode == 8u32 { Width = 2u32; Supported = true; }
            if Scanˉopcode == 9u32 { Width = 5u32; Supported = true; }
            if Scanˉopcode == 10u32 { Width = 5u32; Supported = true; }
            if Scanˉopcode >= 11u32 {
                if Scanˉopcode <= 15u32 { Supported = true; }
            }
            if Scanˉopcode >= 16u32 {
                if Scanˉopcode <= 22u32 { Supported = true; }
            }
            if Scanˉopcode >= 32u32 {
                if Scanˉopcode <= 40u32 { Supported = true; }
            }
            if Scanˉopcode == 48u32 { Width = 5u32; Supported = true; }
            if Scanˉopcode == 49u32 { Width = 5u32; Supported = true; }
            if Scanˉopcode == 64u32 { Width = 5u32; Supported = true; }
            if Scanˉopcode == 80u32 { Supported = true; }
            if Scanˉopcode == 81u32 { Supported = true; }
            if Scanˉopcode >= 96u32 {
                if Scanˉopcode <= 103u32 { Supported = true; }
            }
            if Scanˉopcode == 104u32 { Width = 5u32; Supported = true; }
            if Scanˉopcode == 105u32 { Width = 5u32; Supported = true; }
            if Scanˉopcode == 106u32 { Width = 9u32; Supported = true; }
            if Scanˉopcode >= 107u32 {
                if Scanˉopcode <= 109u32 { Supported = true; }
            }
            if Scanˉopcode >= 110u32 {
                if Scanˉopcode <= 112u32 { Supported = true; }
            }
            if Scanˉopcode >= 113u32 {
                if Scanˉopcode <= 116u32 { Supported = true; }
            }
            if Scanˉopcode == 117u32 { Supported = true; }
            if Scanˉopcode == 118u32 { Supported = true; }
            if Scanˉopcode >= 119u32 {
                if Scanˉopcode <= 125u32 { Supported = true; }
            }
            if Scanˉopcode == 161u32 { Supported = true; }
            if Scanˉopcode == 162u32 { Supported = true; }
            if Scanˉopcode >= 173u32 {
                if Scanˉopcode <= 178u32 { Supported = true; }
            }
            if Supported {
                Supported = true;
            } else {
                return Invalid;
            }
            Scan = Scan + Width;
            Aggregateˉinstructions = Aggregateˉinstructions + 1u32;
            if Aggregateˉinstructions > 400000u32 { return Invalid; }
        }
        Functionˉindex = Functionˉindex + 1u32;
    }
    if Functionˉcursor != Functionsˉend { return Invalid; }

    var Zeroˉlocals: bytes = Zeroˉcell;
    Functionˉindex = 1u32;
    while Functionˉindex < Exportˉindex {
        Zeroˉlocals = Bytesˉconcat(Zeroˉlocals, Zeroˉlocals);
        Functionˉindex = Functionˉindex * 2u32;
    }
    Functionˉcursor = Bytesˉreadˉu32ˉlittle(
        Functionˉframeˉmetadata,
        Mainˉindex * 8u32 + 4u32
    );

    Functionˉindex = Mainˉindex;
    Aggregateˉinstructions = 0u32;
    var Locals: bytes = Bytesˉslice(
        Zeroˉlocals,
        0u32,
        Functionˉcursor
    );
    var Stack: bytes = Invalid;
    // Keep descriptor identity separate from cell bits so pop never treats a
    // scalar with an offset/length-like value as heap ownership.
    var Stackˉdescriptorˉflagsˉlow: u32 = 0u32;
    var Stackˉdescriptorˉflagsˉhigh: u32 = 0u32;
    var Frames: bytes = Invalid;
    var Heap: bytes = Invalid;
    var Heapˉallocations: bytes = Invalid;
    var Heapˉallocationˉcount: u32 = 0u32;
    var Guestˉinputˉheapˉoffset: u32 = 0u32;
    if Requestˉmajor == 2u32 {
        let Executionˉguestˉinputˉlength: u32 = Bytesˉlength(Guestˉinput);
        if Executionˉguestˉinputˉlength > 0u32 {
            Heap = Guestˉinput;
            Heapˉallocations = Bytesˉconcat(
                Zeroˉvalue,
                Bytesˉconcat(
                    Bytesˉfromˉu32ˉlittle(Executionˉguestˉinputˉlength),
                    Bytesˉfromˉu32ˉlittle(1u32)
                )
            );
            Heapˉallocationˉcount = 1u32;
        }
        Locals = Bytesˉconcat(
            Bytesˉconcat(
                Bytesˉfromˉu32ˉlittle(Guestˉinputˉheapˉoffset),
                Bytesˉfromˉu32ˉlittle(Bytesˉlength(Guestˉinput))
            ),
            Bytesˉslice(Zeroˉlocals, 8u32, Functionˉcursor - 8u32)
        );
    }
    var Recordˉzeroˉslots: bytes = Zeroˉcell;
    var Recordˉzeroˉslotsˉlength: u32 = 8u32;
    while Recordˉzeroˉslotsˉlength < 4096u32 {
        Recordˉzeroˉslots = Bytesˉconcat(
            Recordˉzeroˉslots,
            Recordˉzeroˉslots
        );
        Recordˉzeroˉslotsˉlength = Recordˉzeroˉslotsˉlength * 2u32;
    }
    var Recordˉmetadata: bytes = Recordˉzeroˉslots;
    var Records: bytes = Invalid;
    // Reuse completed-preflight slots as execution state: Functionˉindex is the
    // current function, Aggregateˉinstructions is PC, Exportˉindex is depth,
    // Envelope is executed count, Sectionˉkind is guest status, Payload is the
    // instruction, Payloadˉlength is opcode, and Mainˉfound is handled state.
    Exportˉindex = 1u32;
    Envelope = 0u32;
    Sectionˉkind = 0u32;
    var Running: bool = true;
    while Running {
        if Envelope >= Maximumˉinstructions {
            Sectionˉkind = 3011u32;
        } else {
        Envelope = Envelope + 1u32;
        Payload = Code + Mainˉcodeˉoffset + Aggregateˉinstructions;
        Payloadˉlength = U32ˉfromˉu8(Bytesˉreadˉu8(Module, Payload));
        Mainˉfound = false;
        let Stackˉdescriptorˉcount: u32 = Bytesˉlength(Stack) / 8u32;
        let Stackˉeffectˉresult: bytes = Stackˉeffect.Interpreterˉstackˉeffect(
            Bytesˉfromˉu32ˉlittle(Payloadˉlength)
        );
        var Stackˉconsumed: u32 = Bytesˉreadˉu32ˉlittle(
            Stackˉeffectˉresult, 0u32
        );
        let Stackˉeffectˉflags: u32 = Bytesˉreadˉu32ˉlittle(
            Stackˉeffectˉresult, 4u32
        );
        var Stackˉproduced: bool = Stackˉeffectˉflags == 1u32 ||
            Stackˉeffectˉflags == 3u32;
        var Stackˉproducedˉdescriptor: bool = Stackˉeffectˉflags == 3u32;
        var Releasedˉdescriptors: bytes = Invalid;
        var Heapˉallocationˉrequested: bool = false;
        var Heapˉallocationˉvalue: bytes = Invalid;

        if Payloadˉlength <= 22u32 {
        if Payloadˉlength == 1u32 {
            Stack = Bytesˉconcat(
                Stack,
                Bytesˉconcat(
                    Bytesˉslice(Module, Payload + 1u32, 4u32),
                    Zeroˉvalue
                )
            );
            Aggregateˉinstructions = Aggregateˉinstructions + 5u32;
            Mainˉfound = true;
        }
        if Payloadˉlength == 2u32 {
            Stack = Bytesˉconcat(
                Stack,
