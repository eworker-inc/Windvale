            let Descriptorˉconcatˉleftˉlength: u32 = Bytesˉreadˉu32ˉlittle(
                Stack,
                Descriptorˉconcatˉstack - 4u32
            );
            Stack = Bytesˉslice(Stack, 0u32, Descriptorˉconcatˉstack - 8u32);
            let Descriptorˉconcatˉlength: u32 =
                Descriptorˉconcatˉleftˉlength + Descriptorˉconcatˉrightˉlength;
            let Descriptorˉconcatˉoffset: u32 = Bytesˉlength(Heap);
            if Descriptorˉconcatˉlength > 16384u32 {
                Guestˉstatus = 3015u32;
                Running = false;
            } else {
                if Descriptorˉconcatˉoffset > 65536u32 - Descriptorˉconcatˉlength {
                    Guestˉstatus = 3018u32;
                    Running = false;
                } else {
                    let Descriptorˉconcatˉvalue: bytes = Bytesˉconcat(
                        Bytesˉslice(
                            Heap,
                            Descriptorˉconcatˉleftˉoffset,
                            Descriptorˉconcatˉleftˉlength
                        ),
                        Bytesˉslice(
                            Heap,
                            Descriptorˉconcatˉrightˉoffset,
                            Descriptorˉconcatˉrightˉlength
                        )
                    );
                    Heap = Bytesˉconcat(Heap, Descriptorˉconcatˉvalue);
                    Stack = Bytesˉconcat(
                        Stack,
                        Bytesˉconcat(
                            Bytesˉfromˉu32ˉlittle(Descriptorˉconcatˉoffset),
                            Bytesˉfromˉu32ˉlittle(Descriptorˉconcatˉlength)
                        )
                    );
                }
            }
            Pc = Pc + 1u32;
            Handled = true;
        }

        if Opcode == 114u32 {
            var Bytesˉreadˉi32ˉstack: u32 = Bytesˉlength(Stack);
            let Bytesˉreadˉi32ˉoffset: u32 = Bytesˉreadˉu32ˉlittle(
                Stack,
                Bytesˉreadˉi32ˉstack - 8u32
            );
            Stack = Bytesˉslice(Stack, 0u32, Bytesˉreadˉi32ˉstack - 8u32);
            Bytesˉreadˉi32ˉstack = Bytesˉlength(Stack);
            let Bytesˉreadˉi32ˉsourceˉoffset: u32 = Bytesˉreadˉu32ˉlittle(
                Stack,
                Bytesˉreadˉi32ˉstack - 8u32
            );
            let Bytesˉreadˉi32ˉsourceˉlength: u32 = Bytesˉreadˉu32ˉlittle(
                Stack,
                Bytesˉreadˉi32ˉstack - 4u32
            );
            Stack = Bytesˉslice(Stack, 0u32, Bytesˉreadˉi32ˉstack - 8u32);
            var Bytesˉreadˉi32ˉvalid: bool = true;
            if Bytesˉreadˉi32ˉoffset > Bytesˉreadˉi32ˉsourceˉlength {
                Bytesˉreadˉi32ˉvalid = false;
            } else {
                if 4u32 > Bytesˉreadˉi32ˉsourceˉlength - Bytesˉreadˉi32ˉoffset {
                    Bytesˉreadˉi32ˉvalid = false;
                }
            }
            if Bytesˉreadˉi32ˉvalid {
                Stack = Bytesˉconcat(
                    Stack,
                    Bytesˉconcat(
                        Bytesˉfromˉi32ˉlittle(Bytesˉreadˉi32ˉlittle(
                            Heap,
                            Bytesˉreadˉi32ˉsourceˉoffset + Bytesˉreadˉi32ˉoffset
                        )),
                        Zeroˉvalue
                    )
                );
            } else {
                Guestˉstatus = 3008u32;
                Running = false;
            }
            Pc = Pc + 1u32;
            Handled = true;
        }

        var Isˉutf8ˉinstruction: bool = false;
        if Opcode == 115u32 { Isˉutf8ˉinstruction = true; }
        if Opcode == 116u32 { Isˉutf8ˉinstruction = true; }
        if Isˉutf8ˉinstruction {
            let Utf8ˉstack: u32 = Bytesˉlength(Stack);
            let Utf8ˉsourceˉoffset: u32 = Bytesˉreadˉu32ˉlittle(
                Stack,
                Utf8ˉstack - 8u32
            );
            let Utf8ˉsourceˉlength: u32 = Bytesˉreadˉu32ˉlittle(
                Stack,
                Utf8ˉstack - 4u32
            );
            var Utf8ˉvalid: bool = true;
            var Utf8ˉcursor: u32 = 0u32;
            while Utf8ˉcursor < Utf8ˉsourceˉlength {
                let Utf8ˉfirst: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(
                    Heap,
                    Utf8ˉsourceˉoffset + Utf8ˉcursor
                ));
                let Utf8ˉremaining: u32 = Utf8ˉsourceˉlength - Utf8ˉcursor;
                var Utf8ˉwidth: u32 = 0u32;
                var Utf8ˉsecond: u32 = 0u32;
                var Utf8ˉthird: u32 = 0u32;
                var Utf8ˉfourth: u32 = 0u32;
                var Utf8ˉsecondˉcontinuation: bool = false;
                var Utf8ˉthirdˉcontinuation: bool = false;
                var Utf8ˉfourthˉcontinuation: bool = false;
                if Utf8ˉfirst <= 127u32 { Utf8ˉwidth = 1u32; }
                if Utf8ˉremaining >= 2u32 {
                    Utf8ˉsecond = U32ˉfromˉu8(Bytesˉreadˉu8(
                        Heap,
                        Utf8ˉsourceˉoffset + Utf8ˉcursor + 1u32
                    ));
                    if Utf8ˉsecond >= 128u32 {
                        if Utf8ˉsecond <= 191u32 {
                            Utf8ˉsecondˉcontinuation = true;
                        }
                    }
                }
                if Utf8ˉremaining >= 3u32 {
                    Utf8ˉthird = U32ˉfromˉu8(Bytesˉreadˉu8(
                        Heap,
                        Utf8ˉsourceˉoffset + Utf8ˉcursor + 2u32
                    ));
                    if Utf8ˉthird >= 128u32 {
                        if Utf8ˉthird <= 191u32 {
                            Utf8ˉthirdˉcontinuation = true;
                        }
                    }
                }
                if Utf8ˉremaining >= 4u32 {
                    Utf8ˉfourth = U32ˉfromˉu8(Bytesˉreadˉu8(
                        Heap,
                        Utf8ˉsourceˉoffset + Utf8ˉcursor + 3u32
                    ));
                    if Utf8ˉfourth >= 128u32 {
                        if Utf8ˉfourth <= 191u32 {
                            Utf8ˉfourthˉcontinuation = true;
                        }
                    }
                }
                if Utf8ˉfirst >= 194u32 {
                    if Utf8ˉfirst <= 223u32 {
                        if Utf8ˉsecondˉcontinuation { Utf8ˉwidth = 2u32; }
                    }
                }
                if Utf8ˉfirst == 224u32 {
                    if Utf8ˉsecond >= 160u32 {
                        if Utf8ˉsecond <= 191u32 {
                            if Utf8ˉthirdˉcontinuation { Utf8ˉwidth = 3u32; }
                        }
                    }
                }
                if Utf8ˉfirst >= 225u32 {
                    if Utf8ˉfirst <= 236u32 {
                        if Utf8ˉsecondˉcontinuation {
                            if Utf8ˉthirdˉcontinuation { Utf8ˉwidth = 3u32; }
                        }
                    }
                }
                if Utf8ˉfirst == 237u32 {
                    if Utf8ˉsecond >= 128u32 {
                        if Utf8ˉsecond <= 159u32 {
                            if Utf8ˉthirdˉcontinuation { Utf8ˉwidth = 3u32; }
                        }
                    }
                }
                if Utf8ˉfirst >= 238u32 {
                    if Utf8ˉfirst <= 239u32 {
                        if Utf8ˉsecondˉcontinuation {
                            if Utf8ˉthirdˉcontinuation { Utf8ˉwidth = 3u32; }
                        }
                    }
                }
                if Utf8ˉfirst == 240u32 {
                    if Utf8ˉsecond >= 144u32 {
                        if Utf8ˉsecond <= 191u32 {
                            if Utf8ˉthirdˉcontinuation {
                                if Utf8ˉfourthˉcontinuation { Utf8ˉwidth = 4u32; }
                            }
                        }
                    }
                }
                if Utf8ˉfirst >= 241u32 {
                    if Utf8ˉfirst <= 243u32 {
                        if Utf8ˉsecondˉcontinuation {
                            if Utf8ˉthirdˉcontinuation {
                                if Utf8ˉfourthˉcontinuation { Utf8ˉwidth = 4u32; }
                            }
                        }
                    }
                }
                if Utf8ˉfirst == 244u32 {
                    if Utf8ˉsecond >= 128u32 {
                        if Utf8ˉsecond <= 143u32 {
                            if Utf8ˉthirdˉcontinuation {
                                if Utf8ˉfourthˉcontinuation { Utf8ˉwidth = 4u32; }
                            }
                        }
                    }
                }
                if Utf8ˉwidth == 0u32 {
                    Utf8ˉvalid = false;
                    Utf8ˉcursor = Utf8ˉsourceˉlength;
                } else {
                    Utf8ˉcursor = Utf8ˉcursor + Utf8ˉwidth;
                }
            }
            if Opcode == 115u32 {
                Stack = Bytesˉslice(Stack, 0u32, Utf8ˉstack - 8u32);
                var Utf8ˉvalidˉflag: u32 = 0u32;
                if Utf8ˉvalid { Utf8ˉvalidˉflag = 1u32; }
                Stack = Bytesˉconcat(
                    Stack,
                    Bytesˉconcat(
                        Bytesˉfromˉu32ˉlittle(Utf8ˉvalidˉflag),
                        Zeroˉvalue
                    )
                );
            }
            if Opcode == 116u32 {
                if Utf8ˉvalid {
                    Stack = Stack;
                } else {
                    Stack = Bytesˉslice(Stack, 0u32, Utf8ˉstack - 8u32);
                    Guestˉstatus = 3014u32;
                    Running = false;
                }
            }
            Pc = Pc + 1u32;
            Handled = true;
        }

        if Opcode >= 120u32 {
            if Opcode <= 123u32 {
                let Constructorˉstack: u32 = Bytesˉlength(Stack);
                var Constructorˉvalid: bool = true;
                let Constructorˉu32: u32 = Bytesˉreadˉu32ˉlittle(
                    Stack,
                    Constructorˉstack - 8u32
                );
                if Opcode == 121u32 {
                    if Constructorˉu32 > 65535u32 {
                        Constructorˉvalid = false;
                        Guestˉstatus = 3016u32;
                        Running = false;
                    }
                }
                var Constructorˉvalue: bytes = Bytesˉslice(Heap, 0u32, 0u32);
                if Constructorˉvalid {
                    if Opcode == 120u32 {
                        Constructorˉvalue = Bytesˉfromˉu8(Bytesˉreadˉu8(
                            Stack,
                            Constructorˉstack - 8u32
                        ));
                    }
                    if Opcode == 121u32 {
                        Constructorˉvalue = Bytesˉfromˉu16ˉlittle(
                            Constructorˉu32
                        );
                    }
                    if Opcode == 122u32 {
                        Constructorˉvalue = Bytesˉfromˉu32ˉlittle(
                            Constructorˉu32
                        );
                    }
                    if Opcode == 123u32 {
                        Constructorˉvalue = Bytesˉfromˉi32ˉlittle(
                            Bytesˉreadˉi32ˉlittle(
                                Stack,
                                Constructorˉstack - 8u32
                            )
                        );
                    }
                }
                Stack = Bytesˉslice(Stack, 0u32, Constructorˉstack - 8u32);
                if Constructorˉvalid {
                    let Constructorˉlength: u32 = Bytesˉlength(Constructorˉvalue);
                    let Constructorˉoffset: u32 = Bytesˉlength(Heap);
                    if Constructorˉoffset > 65536u32 - Constructorˉlength {
                        Guestˉstatus = 3018u32;
                        Running = false;
                    } else {
                        Heap = Bytesˉconcat(Heap, Constructorˉvalue);
                        Stack = Bytesˉconcat(
                            Stack,
                            Bytesˉconcat(
                                Bytesˉfromˉu32ˉlittle(Constructorˉoffset),
                                Bytesˉfromˉu32ˉlittle(Constructorˉlength)
                            )
                        );
                    }
                }
                Pc = Pc + 1u32;
                Handled = true;
            }
        }
        if Opcode == 124u32 {
            Pc = Pc + 1u32;
            Handled = true;
        }
        if Opcode == 125u32 {
            let Sha256ˉstackˉlength: u32 = Bytesˉlength(Stack);
            let Sha256ˉsourceˉoffset: u32 = Bytesˉreadˉu32ˉlittle(
                Stack,
                Sha256ˉstackˉlength - 8u32
            );
            let Sha256ˉsourceˉlength: u32 = Bytesˉreadˉu32ˉlittle(
                Stack,
                Sha256ˉstackˉlength - 4u32
            );
            Stack = Bytesˉslice(Stack, 0u32, Sha256ˉstackˉlength - 8u32);
            let Sha256ˉvalue: bytes = Textˉtoˉutf8(Bytesˉsha256ˉhex(
                Bytesˉslice(Heap, Sha256ˉsourceˉoffset, Sha256ˉsourceˉlength)
            ));
            let Sha256ˉoffset: u32 = Bytesˉlength(Heap);
            if Sha256ˉoffset > 65536u32 - 64u32 {
                Guestˉstatus = 3018u32;
                Running = false;
            } else {
                Heap = Bytesˉconcat(Heap, Sha256ˉvalue);
                Stack = Bytesˉconcat(
                    Stack,
                    Bytesˉconcat(
                        Bytesˉfromˉu32ˉlittle(Sha256ˉoffset),
                        Bytesˉfromˉu32ˉlittle(64u32)
                    )
                );
            }
            Pc = Pc + 1u32;
            Handled = true;
        }
        if Opcode == 118u32 {
            Pc = Pc + 1u32;
            Handled = true;
        }

        if Opcode == 48u32 {
            Pc = Bytesˉreadˉu32ˉlittle(Module, Instruction + 1u32);
            Handled = true;
        }
        if Opcode == 49u32 {
            let Branchˉstackˉlength: u32 = Bytesˉlength(Stack);
            let Condition: u32 = Bytesˉreadˉu32ˉlittle(
                Stack,
                Branchˉstackˉlength - 8u32
            );
            Stack = Bytesˉslice(
                Stack,
                0u32,
                Branchˉstackˉlength - 8u32
            );
            if Condition == 0u32 {
                Pc = Bytesˉreadˉu32ˉlittle(Module, Instruction + 1u32);
            } else {
                Pc = Pc + 5u32;
            }
            Handled = true;
        }

        if Opcode == 64u32 {
            if Callˉdepth >= Maximumˉcallˉdepth {
                Guestˉstatus = 3004u32;
                Running = false;
                Handled = true;
            } else {
            let Target: u32 = Bytesˉreadˉu32ˉlittle(
                Module,
                Instruction + 1u32
            );
            let Targetˉparameterˉcount: u32 = Bytesˉreadˉu32ˉlittle(
                Functionˉparameterˉcounts,
                Target * 4u32
            );
            let Targetˉcodeˉoffset: u32 = Bytesˉreadˉu32ˉlittle(
                Functionˉcodeˉoffsets,
                Target * 4u32
            );
            let Targetˉcodeˉlength: u32 = Bytesˉreadˉu32ˉlittle(
                Functionˉcodeˉlengths,
                Target * 4u32
            );

            var Nextˉlocals: bytes = Zeroˉlocals;
            var Argumentˉindex: u32 = Targetˉparameterˉcount;
            while Argumentˉindex > 0u32 {
                Argumentˉindex = Argumentˉindex - 1u32;
                let Argumentˉstackˉlength: u32 = Bytesˉlength(Stack);
                let Argumentˉvalue: bytes = Bytesˉslice(
                    Stack,
                    Argumentˉstackˉlength - 8u32,
                    8u32
                );
                Stack = Bytesˉslice(
                    Stack,
                    0u32,
                    Argumentˉstackˉlength - 8u32
                );
                let Argumentˉlocalˉoffset: u32 = Argumentˉindex * 8u32;
                let Argumentˉprefix: bytes = Bytesˉslice(
                    Nextˉlocals,
                    0u32,
                    Argumentˉlocalˉoffset
                );
                let Argumentˉsuffix: bytes = Bytesˉslice(
                    Nextˉlocals,
                    Argumentˉlocalˉoffset + 8u32,
                    1016u32 - Argumentˉlocalˉoffset
                );
                Nextˉlocals = Bytesˉconcat(
                    Bytesˉconcat(Argumentˉprefix, Argumentˉvalue),
                    Argumentˉsuffix
                );
            }

            var Frame: bytes = Bytesˉfromˉu32ˉlittle(Currentˉfunction);
            Frame = Bytesˉconcat(
                Frame,
                Bytesˉfromˉu32ˉlittle(Pc + 5u32)
            );
            Frame = Bytesˉconcat(
                Frame,
                Bytesˉfromˉu32ˉlittle(Currentˉcodeˉoffset)
            );
            Frame = Bytesˉconcat(
                Frame,
                Bytesˉfromˉu32ˉlittle(Currentˉcodeˉlength)
            );
            Frame = Bytesˉconcat(Frame, Locals);
            Frames = Bytesˉconcat(Frames, Frame);
            Currentˉfunction = Target;
            Currentˉcodeˉoffset = Targetˉcodeˉoffset;
            Currentˉcodeˉlength = Targetˉcodeˉlength;
            Pc = 0u32;
            Locals = Nextˉlocals;
            Callˉdepth = Callˉdepth + 1u32;
            Handled = true;
            }
        }

        if Opcode == 80u32 {
            let Popˉstackˉlength: u32 = Bytesˉlength(Stack);
            Stack = Bytesˉslice(Stack, 0u32, Popˉstackˉlength - 8u32);
            Pc = Pc + 1u32;
            Handled = true;
        }
        if Opcode == 81u32 {
            let Returnˉstackˉlength: u32 = Bytesˉlength(Stack);
            var Returnˉresult: bytes = Bytesˉslice(
                Stack,
                Returnˉstackˉlength - 8u32,
                8u32
            );
            Stack = Bytesˉslice(
                Stack,
                0u32,
                Returnˉstackˉlength - 8u32
            );
            var Framesˉlength: u32 = Bytesˉlength(Frames);
            if Framesˉlength == 0u32 {
                if Requestˉmajor == 2u32 {
                    Framesˉlength = Bytesˉlength(Heap);
                    Currentˉcodeˉoffset = Bytesˉreadˉu32ˉlittle(
                        Returnˉresult,
                        0u32
                    );
                    Currentˉcodeˉlength = Bytesˉreadˉu32ˉlittle(
                        Returnˉresult,
                        4u32
                    );
                    if Currentˉcodeˉoffset > Framesˉlength { return Invalid; }
                    if Currentˉcodeˉlength > Framesˉlength - Currentˉcodeˉoffset {
                        return Invalid;
                    }
                    Returnˉresult = Bytesˉfromˉu32ˉlittle(Currentˉcodeˉlength);
                    Stack = Bytesˉslice(
                        Heap,
                        Currentˉcodeˉoffset,
                        Currentˉcodeˉlength
                    );
                }
                var Success: bytes = Bytesˉfromˉu32ˉlittle(1331189335u32);
                Success = Bytesˉconcat(
                    Success,
                    Bytesˉfromˉu16ˉlittle(Requestˉmajor)
                );
                Success = Bytesˉconcat(
                    Success,
                    Bytesˉfromˉu16ˉlittle(0u32)
                );
                Success = Bytesˉconcat(
                    Success,
                    Bytesˉfromˉu32ˉlittle(0u32)
                );
                Success = Bytesˉconcat(
                    Success,
                    Bytesˉfromˉu32ˉlittle(Executed)
                );
                Success = Bytesˉconcat(
                    Success,
                    Bytesˉslice(Returnˉresult, 0u32, 4u32)
                );
                if Requestˉmajor == 2u32 {
                    return Bytesˉconcat(Success, Stack);
                }
                return Success;
            }
            let Frameˉoffset: u32 = Framesˉlength - 1040u32;
            Currentˉfunction = Bytesˉreadˉu32ˉlittle(
                Frames,
                Frameˉoffset
            );
            Pc = Bytesˉreadˉu32ˉlittle(Frames, Frameˉoffset + 4u32);
            Currentˉcodeˉoffset = Bytesˉreadˉu32ˉlittle(
                Frames,
                Frameˉoffset + 8u32
            );
            Currentˉcodeˉlength = Bytesˉreadˉu32ˉlittle(
                Frames,
                Frameˉoffset + 12u32
            );
            Locals = Bytesˉslice(Frames, Frameˉoffset + 16u32, 1024u32);
            Frames = Bytesˉslice(Frames, 0u32, Frameˉoffset);
            Stack = Bytesˉconcat(Stack, Returnˉresult);
            Callˉdepth = Callˉdepth - 1u32;
            Handled = true;
        }

        if Handled {
            Handled = true;
        } else {
            return Invalid;
        }
        if Running {
            if Pc > Currentˉcodeˉlength { return Invalid; }
        }
        }
    }
    if Guestˉstatus != 0u32 {
        var Guestˉfailure: bytes = Bytesˉfromˉu32ˉlittle(1331189335u32);
        Guestˉfailure = Bytesˉconcat(
            Guestˉfailure,
            Bytesˉfromˉu16ˉlittle(Requestˉmajor)
        );
        Guestˉfailure = Bytesˉconcat(
            Guestˉfailure,
            Bytesˉfromˉu16ˉlittle(0u32)
        );
        Guestˉfailure = Bytesˉconcat(
            Guestˉfailure,
            Bytesˉfromˉu32ˉlittle(Guestˉstatus)
        );
        Guestˉfailure = Bytesˉconcat(
            Guestˉfailure,
            Bytesˉfromˉu32ˉlittle(Executed)
        );
        Guestˉfailure = Bytesˉconcat(Guestˉfailure, Zeroˉvalue);
        return Guestˉfailure;
    }
    return Invalid;
}
