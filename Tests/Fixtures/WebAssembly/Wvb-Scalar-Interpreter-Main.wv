                        Returnˉresult,
                        4u32
                    );
                    if Mainˉcodeˉoffset > Framesˉlength { return Invalid; }
                    if Mainˉcodeˉlength > Framesˉlength - Mainˉcodeˉoffset {
                        return Invalid;
                    }
                    Returnˉresult = Bytesˉfromˉu32ˉlittle(Mainˉcodeˉlength);
                    Stack = Bytesˉslice(
                        Heap,
                        Mainˉcodeˉoffset,
                        Mainˉcodeˉlength
                    );
                }
                var Success: bytes = Bytesˉfromˉu32ˉlittle(1331189335u32);
                Success = Bytesˉconcat(
                    Success,
                    Bytesˉfromˉu16ˉlittle(Requestˉmajor)
                );
                Success = Bytesˉconcat(
                    Success,
                    Bytesˉfromˉu16ˉlittle(0u32)
                );
                Success = Bytesˉconcat(
                    Success,
                    Bytesˉfromˉu32ˉlittle(0u32)
                );
                Success = Bytesˉconcat(
                    Success,
                    Bytesˉfromˉu32ˉlittle(Envelope)
                );
                Success = Bytesˉconcat(
                    Success,
                    Bytesˉslice(Returnˉresult, 0u32, 4u32)
                );
                if Requestˉmajor == 2u32 {
                    return Bytesˉconcat(Success, Stack);
                }
                return Success;
            }
            let Returningˉshapeˉoffset: u32 = Bytesˉreadˉu32ˉlittle(
                Functionˉshapeˉoffsets,
                Functionˉindex * 4u32
            );
            var Returningˉlocalˉoffset: u32 = 0u32;
            while Returningˉlocalˉoffset < Functionˉcursor {
                let Returningˉlocalˉkind: u32 = Bytesˉreadˉu32ˉlittle(
                    Localˉshapes,
                    Returningˉshapeˉoffset + Returningˉlocalˉoffset
                );
                if Returningˉlocalˉkind == 5u32
                    || Returningˉlocalˉkind == 6u32 {
                    Releasedˉdescriptors = Bytesˉconcat(
                        Releasedˉdescriptors,
                        Bytesˉslice(Locals, Returningˉlocalˉoffset, 8u32)
                    );
                }
                Returningˉlocalˉoffset = Returningˉlocalˉoffset + 8u32;
            }
            Functionˉindex = Bytesˉreadˉu32ˉlittle(
                Frames,
                Framesˉlength - 4u32
            );
            Functionˉcursor = Bytesˉreadˉu32ˉlittle(
                Functionˉframeˉmetadata,
                Functionˉindex * 8u32 + 4u32
            );
            let Frameˉoffset: u32 = Framesˉlength - 8u32 - Functionˉcursor;
            Aggregateˉinstructions = Bytesˉreadˉu32ˉlittle(Frames, Frameˉoffset);
            Mainˉcodeˉoffset = Bytesˉreadˉu32ˉlittle(
                Functionˉcodeˉoffsets,
                Functionˉindex * 4u32
            );
            Mainˉcodeˉlength = Bytesˉreadˉu32ˉlittle(
                Functionˉcodeˉlengths,
                Functionˉindex * 4u32
            );
            Locals = Bytesˉslice(
                Frames,
                Frameˉoffset + 4u32,
                Functionˉcursor
            );
            Frames = Bytesˉslice(Frames, 0u32, Frameˉoffset);
            Stack = Bytesˉconcat(Stack, Returnˉresult);
            Exportˉindex = Exportˉindex - 1u32;
            Mainˉfound = true;
        }

        if Mainˉfound {
            Mainˉfound = true;
        } else {
            return Invalid;
        }
        // Copy operation results first, release consumed owners second, and
        // only then reuse a free span for the pending immutable result.
        if Sectionˉkind == 0u32 {
            var Releasedˉcursor: u32 = 0u32;
            while Releasedˉcursor < Bytesˉlength(Releasedˉdescriptors) {
                let Releasedˉoffset: u32 = Bytesˉreadˉu32ˉlittle(
                    Releasedˉdescriptors,
                    Releasedˉcursor
                );
                let Releasedˉlength: u32 = Bytesˉreadˉu32ˉlittle(
                    Releasedˉdescriptors,
                    Releasedˉcursor + 4u32
                );
                if Releasedˉlength > 0u32 {
                    var Releasedˉallocationˉindex: u32 = 4294967295u32;
                    var Releasedˉallocationˉscan: u32 = 0u32;
                    while Releasedˉallocationˉscan
                        < Heapˉallocationˉcount {
                        let Releasedˉscanˉentry: u32 =
                            Releasedˉallocationˉscan * 12u32;
                        let Releasedˉscanˉreferences: u32 =
                            Bytesˉreadˉu32ˉlittle(
                                Heapˉallocations,
                                Releasedˉscanˉentry + 8u32
                            );
                        let Releasedˉscanˉoffset: u32 =
                            Bytesˉreadˉu32ˉlittle(
                                Heapˉallocations,
                                Releasedˉscanˉentry
                            );
                        let Releasedˉscanˉlength: u32 =
                            Bytesˉreadˉu32ˉlittle(
                                Heapˉallocations,
                                Releasedˉscanˉentry + 4u32
                            );
                        if Releasedˉscanˉreferences > 0u32 {
                            if Releasedˉoffset >= Releasedˉscanˉoffset {
                                if Releasedˉoffset - Releasedˉscanˉoffset
                                    <= Releasedˉscanˉlength {
                                    if Releasedˉlength
                                        <= Releasedˉscanˉlength
                                            - (Releasedˉoffset
                                                - Releasedˉscanˉoffset) {
                                        Releasedˉallocationˉindex =
                                            Releasedˉallocationˉscan;
                                        Releasedˉallocationˉscan =
                                            Heapˉallocationˉcount;
                                    }
                                }
                            }
                        }
                        Releasedˉallocationˉscan =
                            Releasedˉallocationˉscan + 1u32;
                    }
                    if Releasedˉallocationˉindex == 4294967295u32 {
                        return Invalid;
                    }
                    let Releasedˉallocationˉentry: u32 =
                        Releasedˉallocationˉindex * 12u32;
                    let Releasedˉreferences: u32 = Bytesˉreadˉu32ˉlittle(
                        Heapˉallocations,
                        Releasedˉallocationˉentry + 8u32
                    );
                    if Releasedˉreferences == 0u32 { return Invalid; }
                    Heapˉallocations = Bytesˉconcat(
                        Bytesˉconcat(
                            Bytesˉslice(
                                Heapˉallocations,
                                0u32,
                                Releasedˉallocationˉentry
                            ),
                            Bytesˉconcat(
                                Bytesˉslice(
                                    Heapˉallocations,
                                    Releasedˉallocationˉentry,
                                    8u32
                                ),
                                Bytesˉfromˉu32ˉlittle(
                                    Releasedˉreferences - 1u32
                                )
                            )
                        ),
                        Bytesˉslice(
                            Heapˉallocations,
                            Releasedˉallocationˉentry + 12u32,
                            Bytesˉlength(Heapˉallocations)
                                - Releasedˉallocationˉentry - 12u32
                        )
                    );
                }
                Releasedˉcursor = Releasedˉcursor + 8u32;
            }

            if Heapˉallocationˉrequested {
                let Allocatedˉlength: u32 = Bytesˉlength(
                    Heapˉallocationˉvalue
                );
                var Allocatedˉoffset: u32 = 0u32;
                if Allocatedˉlength > 0u32 {
                    var Allocatedˉspaceˉsearching: bool = true;
                    while Allocatedˉspaceˉsearching {
                        var Allocatedˉnearestˉoffset: u32 = 65536u32;
                        var Allocatedˉnearestˉlength: u32 = 0u32;
                        var Allocatedˉspaceˉscan: u32 = 0u32;
                        while Allocatedˉspaceˉscan < Heapˉallocationˉcount {
                            let Allocatedˉspaceˉentry: u32 =
                                Allocatedˉspaceˉscan * 12u32;
                            let Allocatedˉspaceˉreferences: u32 =
                                Bytesˉreadˉu32ˉlittle(
                                    Heapˉallocations,
                                    Allocatedˉspaceˉentry + 8u32
                                );
                            if Allocatedˉspaceˉreferences > 0u32 {
                                let Allocatedˉspaceˉoffset: u32 =
                                    Bytesˉreadˉu32ˉlittle(
                                        Heapˉallocations,
                                        Allocatedˉspaceˉentry
                                    );
                                if Allocatedˉspaceˉoffset >= Allocatedˉoffset {
                                    if Allocatedˉspaceˉoffset
                                        < Allocatedˉnearestˉoffset {
                                        Allocatedˉnearestˉoffset =
                                            Allocatedˉspaceˉoffset;
                                        Allocatedˉnearestˉlength =
                                            Bytesˉreadˉu32ˉlittle(
                                                Heapˉallocations,
                                                Allocatedˉspaceˉentry + 4u32
                                            );
                                    }
                                }
                            }
                            Allocatedˉspaceˉscan =
                                Allocatedˉspaceˉscan + 1u32;
                        }
                        if Allocatedˉlength <= Allocatedˉnearestˉoffset
                            - Allocatedˉoffset {
                            Allocatedˉspaceˉsearching = false;
                        } else {
                            if Allocatedˉnearestˉoffset == 65536u32 {
                                Allocatedˉoffset = 4294967295u32;
                                Allocatedˉspaceˉsearching = false;
                            } else {
                                Allocatedˉoffset = Allocatedˉnearestˉoffset
                                    + Allocatedˉnearestˉlength;
                                if Allocatedˉoffset > 65536u32
                                    - Allocatedˉlength {
                                    Allocatedˉoffset = 4294967295u32;
                                    Allocatedˉspaceˉsearching = false;
                                }
                            }
                        }
                    }
                    if Allocatedˉoffset == 4294967295u32 {
                        Sectionˉkind = 3018u32;
                    } else {
                        let Allocatedˉend: u32 =
                            Allocatedˉoffset + Allocatedˉlength;
                        let Allocatedˉheapˉlength: u32 = Bytesˉlength(Heap);
                        var Allocatedˉnextˉheap: bytes = Bytesˉconcat(
                            Bytesˉslice(Heap, 0u32, Allocatedˉoffset),
                            Heapˉallocationˉvalue
                        );
                        if Allocatedˉend < Allocatedˉheapˉlength {
                            Allocatedˉnextˉheap = Bytesˉconcat(
                                Allocatedˉnextˉheap,
                                Bytesˉslice(
                                    Heap,
                                    Allocatedˉend,
                                    Allocatedˉheapˉlength - Allocatedˉend
                                )
                            );
                        }
                        Heap = Allocatedˉnextˉheap;

                        var Allocatedˉmetadataˉindex: u32 =
                            Heapˉallocationˉcount;
                        var Allocatedˉmetadataˉscan: u32 = 0u32;
                        while Allocatedˉmetadataˉscan
                            < Heapˉallocationˉcount {
                            if Bytesˉreadˉu32ˉlittle(
                                Heapˉallocations,
                                Allocatedˉmetadataˉscan * 12u32 + 8u32
                            ) == 0u32 {
                                Allocatedˉmetadataˉindex =
                                    Allocatedˉmetadataˉscan;
                                Allocatedˉmetadataˉscan =
                                    Heapˉallocationˉcount;
                            }
                            Allocatedˉmetadataˉscan =
                                Allocatedˉmetadataˉscan + 1u32;
                        }
                        let Allocatedˉmetadataˉvalue: bytes = Bytesˉconcat(
                            Bytesˉfromˉu32ˉlittle(Allocatedˉoffset),
                            Bytesˉconcat(
                                Bytesˉfromˉu32ˉlittle(Allocatedˉlength),
                                Bytesˉfromˉu32ˉlittle(1u32)
                            )
                        );
                        if Allocatedˉmetadataˉindex
                            == Heapˉallocationˉcount {
                            Heapˉallocations = Bytesˉconcat(
                                Heapˉallocations,
                                Allocatedˉmetadataˉvalue
                            );
                            Heapˉallocationˉcount =
                                Heapˉallocationˉcount + 1u32;
                        } else {
                            let Allocatedˉmetadataˉentry: u32 =
                                Allocatedˉmetadataˉindex * 12u32;
                            Heapˉallocations = Bytesˉconcat(
                                Bytesˉconcat(
                                    Bytesˉslice(
                                        Heapˉallocations,
                                        0u32,
                                        Allocatedˉmetadataˉentry
                                    ),
                                    Allocatedˉmetadataˉvalue
                                ),
                                Bytesˉslice(
                                    Heapˉallocations,
                                    Allocatedˉmetadataˉentry + 12u32,
                                    Bytesˉlength(Heapˉallocations)
                                        - Allocatedˉmetadataˉentry - 12u32
                                )
                            );
                        }
                    }
                }
                if Sectionˉkind == 0u32 {
                    Stack = Bytesˉconcat(
                        Stack,
                        Bytesˉconcat(
                            Bytesˉfromˉu32ˉlittle(Allocatedˉoffset),
                            Bytesˉfromˉu32ˉlittle(Allocatedˉlength)
                        )
                    );
                }
            }
        }
        if Sectionˉkind == 0u32 {
            if Stackˉconsumed > Stackˉdescriptorˉcount { return Invalid; }
            let Stackˉremainingˉcount: u32 =
                Stackˉdescriptorˉcount - Stackˉconsumed;
            if Stackˉremainingˉcount < 32u32 {
                var Stackˉdescriptorˉmask: u32 = 0u32;
                if Stackˉremainingˉcount > 0u32 {
                    Stackˉdescriptorˉmask =
                        (1u32 << Stackˉremainingˉcount) - 1u32;
                }
                Stackˉdescriptorˉflagsˉlow =
                    Stackˉdescriptorˉflagsˉlow & Stackˉdescriptorˉmask;
                Stackˉdescriptorˉflagsˉhigh = 0u32;
            }
            if Stackˉremainingˉcount == 32u32 {
                Stackˉdescriptorˉflagsˉhigh = 0u32;
            }
            if Stackˉremainingˉcount > 32u32 {
                let Stackˉhighˉcount: u32 =
                    Stackˉremainingˉcount - 32u32;
                var Stackˉdescriptorˉhighˉmask: u32 = 4294967295u32;
                if Stackˉhighˉcount < 32u32 {
                    Stackˉdescriptorˉhighˉmask =
                        (1u32 << Stackˉhighˉcount) - 1u32;
                }
                Stackˉdescriptorˉflagsˉhigh =
                    Stackˉdescriptorˉflagsˉhigh
                        & Stackˉdescriptorˉhighˉmask;
            }
            if Stackˉproduced {
                if Stackˉproducedˉdescriptor {
                    if Stackˉremainingˉcount < 32u32 {
                        Stackˉdescriptorˉflagsˉlow =
                            Stackˉdescriptorˉflagsˉlow
                                | (1u32 << Stackˉremainingˉcount);
                    } else {
                        if Stackˉremainingˉcount >= 64u32 { return Invalid; }
                        Stackˉdescriptorˉflagsˉhigh =
                            Stackˉdescriptorˉflagsˉhigh
                                | (1u32 << (Stackˉremainingˉcount - 32u32));
                    }
                }
            }
            var Stackˉexpectedˉcount: u32 = Stackˉremainingˉcount;
            if Stackˉproduced {
                Stackˉexpectedˉcount = Stackˉexpectedˉcount + 1u32;
            }
            if Bytesˉlength(Stack) != Stackˉexpectedˉcount * 8u32 {
                return Invalid;
            }
        }
        if Sectionˉkind == 0u32 {
            if Aggregateˉinstructions > Mainˉcodeˉlength { return Invalid; }
        }
        }
        Running = Sectionˉkind == 0u32;
    }
    if Sectionˉkind != 0u32 {
        var Guestˉfailure: bytes = Bytesˉfromˉu32ˉlittle(1331189335u32);
        Guestˉfailure = Bytesˉconcat(
            Guestˉfailure,
            Bytesˉfromˉu16ˉlittle(Requestˉmajor)
        );
        Guestˉfailure = Bytesˉconcat(
            Guestˉfailure,
            Bytesˉfromˉu16ˉlittle(0u32)
        );
        Guestˉfailure = Bytesˉconcat(
            Guestˉfailure,
            Bytesˉfromˉu32ˉlittle(Sectionˉkind)
        );
        Guestˉfailure = Bytesˉconcat(
            Guestˉfailure,
            Bytesˉfromˉu32ˉlittle(Envelope)
        );
        Guestˉfailure = Bytesˉconcat(Guestˉfailure, Zeroˉvalue);
        return Guestˉfailure;
    }
    return Invalid;
}
