module WebAssemblyˉwvbˉscalarˉinterpreter profile portable;

export fn Main(Request: bytes) -> bytes {
    let Invalid: bytes = Bytesˉslice(Request, 0u32, 0u32);
    let Requestˉlength: u32 = Bytesˉlength(Request);
    if Requestˉlength < 17u32 { return Invalid; }
    if Bytesˉreadˉu32ˉlittle(Request, 0u32) != 1230526039u32 {
        return Invalid;
    }
    if Bytesˉreadˉu16ˉlittle(Request, 4u32) != 1u32 { return Invalid; }
    if Bytesˉreadˉu16ˉlittle(Request, 6u32) != 0u32 { return Invalid; }
    let Maximumˉinstructions: u32 = Bytesˉreadˉu32ˉlittle(Request, 8u32);
    let Maximumˉcallˉdepth: u32 = Bytesˉreadˉu32ˉlittle(Request, 12u32);
    if Maximumˉinstructions < 1u32 { return Invalid; }
    if Maximumˉinstructions > 4096u32 { return Invalid; }
    if Maximumˉcallˉdepth < 1u32 { return Invalid; }
    if Maximumˉcallˉdepth > 8u32 { return Invalid; }

    let Module: bytes = Bytesˉslice(
        Request,
        16u32,
        Requestˉlength - 16u32
    );
    let Total: u32 = Bytesˉlength(Module);
    if Total < 12u32 { return Invalid; }

    var Envelope: u32 = 12u32;
    var Sectionˉkind: u32 = 1u32;
    var Payload: u32 = 0u32;
    var Payloadˉlength: u32 = 0u32;
    var Capabilities: u32 = 0u32;
    var Data: u32 = 0u32;
    var Functions: u32 = 0u32;
    var Functionsˉend: u32 = 0u32;
    var Code: u32 = 0u32;
    var Exports: u32 = 0u32;
    var Types: u32 = 0u32;
    while Sectionˉkind <= 7u32 {
        Payload = Envelope + 8u32;
        Payloadˉlength = Bytesˉreadˉu32ˉlittle(Module, Envelope + 4u32);
        if Sectionˉkind == 2u32 { Capabilities = Payload; }
        if Sectionˉkind == 3u32 { Data = Payload; }
        if Sectionˉkind == 4u32 {
            Functions = Payload;
            Functionsˉend = Payload + Payloadˉlength;
        }
        if Sectionˉkind == 5u32 { Code = Payload; }
        if Sectionˉkind == 6u32 { Exports = Payload; }
        if Sectionˉkind == 7u32 { Types = Payload; }
        Envelope = Payload + Payloadˉlength;
        Sectionˉkind = Sectionˉkind + 1u32;
    }
    if Envelope != Total { return Invalid; }
    if U32ˉfromˉu8(Bytesˉreadˉu8(Module, 20u32)) != 1u32 {
        return Invalid;
    }
    if Bytesˉreadˉu32ˉlittle(Module, Capabilities) != 0u32 {
        return Invalid;
    }
    if Bytesˉreadˉu32ˉlittle(Module, Types) != 0u32 { return Invalid; }

    let Functionˉcount: u32 = Bytesˉreadˉu32ˉlittle(Module, Functions);
    if Functionˉcount < 1u32 { return Invalid; }
    if Functionˉcount > 16u32 { return Invalid; }

    var Mainˉfound: bool = false;
    var Mainˉindex: u32 = 0u32;
    let Exportˉcount: u32 = Bytesˉreadˉu32ˉlittle(Module, Exports);
    var Exportˉindex: u32 = 0u32;
    var Exportˉcursor: u32 = Exports + 4u32;
    while Exportˉindex < Exportˉcount {
        let Exportˉnameˉlength: u32 = Bytesˉreadˉu32ˉlittle(
            Module,
            Exportˉcursor
        );
        Exportˉcursor = Exportˉcursor + 4u32;
        var Isˉmain: bool = false;
        if Exportˉnameˉlength == 4u32 {
            Isˉmain = true;
            if U32ˉfromˉu8(Bytesˉreadˉu8(Module, Exportˉcursor)) != 77u32 {
                Isˉmain = false;
            }
            if U32ˉfromˉu8(
                Bytesˉreadˉu8(Module, Exportˉcursor + 1u32)
            ) != 97u32 {
                Isˉmain = false;
            }
            if U32ˉfromˉu8(
                Bytesˉreadˉu8(Module, Exportˉcursor + 2u32)
            ) != 105u32 {
                Isˉmain = false;
            }
            if U32ˉfromˉu8(
                Bytesˉreadˉu8(Module, Exportˉcursor + 3u32)
            ) != 110u32 {
                Isˉmain = false;
            }
        }
        Exportˉcursor = Exportˉcursor + Exportˉnameˉlength;
        let Exportˉkind: u32 = U32ˉfromˉu8(
            Bytesˉreadˉu8(Module, Exportˉcursor)
        );
        let Exportˉtarget: u32 = Bytesˉreadˉu32ˉlittle(
            Module,
            Exportˉcursor + 1u32
        );
        Exportˉcursor = Exportˉcursor + 5u32;
        if Isˉmain {
            if Mainˉfound { return Invalid; }
            if Exportˉkind != 1u32 { return Invalid; }
            Mainˉfound = true;
            Mainˉindex = Exportˉtarget;
        }
        Exportˉindex = Exportˉindex + 1u32;
    }
    if Mainˉfound {
        Mainˉfound = true;
    } else {
        return Invalid;
    }

    var Functionˉindex: u32 = 0u32;
    var Functionˉcursor: u32 = Functions + 4u32;
    var Aggregateˉinstructions: u32 = 0u32;
    var Mainˉcodeˉoffset: u32 = 0u32;
    var Mainˉcodeˉlength: u32 = 0u32;
    while Functionˉindex < Functionˉcount {
        let Nameˉlength: u32 = Bytesˉreadˉu32ˉlittle(
            Module,
            Functionˉcursor
        );
        Functionˉcursor = Functionˉcursor + 4u32 + Nameˉlength;
        let Parameterˉcount: u32 = Bytesˉreadˉu32ˉlittle(
            Module,
            Functionˉcursor
        );
        if Parameterˉcount > 8u32 { return Invalid; }
        Functionˉcursor = Functionˉcursor + 4u32;
        var Shapeˉindex: u32 = 0u32;
        var Shapeˉkind: u32 = 0u32;
        while Shapeˉindex < Parameterˉcount {
            Shapeˉkind = U32ˉfromˉu8(Bytesˉreadˉu8(Module, Functionˉcursor));
            if Shapeˉkind != 1u32 {
                if Shapeˉkind != 2u32 {
                    if Shapeˉkind != 3u32 {
                        if Shapeˉkind != 4u32 {
                            if Shapeˉkind != 5u32 {
                                if Shapeˉkind != 6u32 { return Invalid; }
                            }
                        }
                    }
                }
            }
            Functionˉcursor = Functionˉcursor + 1u32;
            Shapeˉindex = Shapeˉindex + 1u32;
        }
        let Returnˉkind: u32 = U32ˉfromˉu8(
            Bytesˉreadˉu8(Module, Functionˉcursor)
        );
        if Returnˉkind != 1u32 {
            if Returnˉkind != 2u32 {
                if Returnˉkind != 3u32 {
                    if Returnˉkind != 4u32 {
                        if Returnˉkind != 5u32 {
                            if Returnˉkind != 6u32 { return Invalid; }
                        }
                    }
                }
            }
        }
        Functionˉcursor = Functionˉcursor + 1u32;
        let Localˉcount: u32 = Bytesˉreadˉu32ˉlittle(
            Module,
            Functionˉcursor
        );
        if Localˉcount > 128u32 - Parameterˉcount { return Invalid; }
        Functionˉcursor = Functionˉcursor + 4u32;
        Shapeˉindex = 0u32;
        while Shapeˉindex < Localˉcount {
            Shapeˉkind = U32ˉfromˉu8(Bytesˉreadˉu8(Module, Functionˉcursor));
            if Shapeˉkind != 1u32 {
                if Shapeˉkind != 2u32 {
                    if Shapeˉkind != 3u32 {
                        if Shapeˉkind != 4u32 {
                            if Shapeˉkind != 5u32 {
                                if Shapeˉkind != 6u32 { return Invalid; }
                            }
                        }
                    }
                }
            }
            Functionˉcursor = Functionˉcursor + 1u32;
            Shapeˉindex = Shapeˉindex + 1u32;
        }
        let Functionˉcodeˉoffset: u32 = Bytesˉreadˉu32ˉlittle(
            Module,
            Functionˉcursor
        );
        let Functionˉcodeˉlength: u32 = Bytesˉreadˉu32ˉlittle(
            Module,
            Functionˉcursor + 4u32
        );
        let Maximumˉstack: u32 = Bytesˉreadˉu32ˉlittle(
            Module,
            Functionˉcursor + 8u32
        );
        Functionˉcursor = Functionˉcursor + 12u32;
        if Maximumˉstack > 16u32 { return Invalid; }
        if Functionˉindex == Mainˉindex {
            if Parameterˉcount != 0u32 { return Invalid; }
            if Returnˉkind != 1u32 { return Invalid; }
            Mainˉcodeˉoffset = Functionˉcodeˉoffset;
            Mainˉcodeˉlength = Functionˉcodeˉlength;
        }

        var Scan: u32 = 0u32;
        while Scan < Functionˉcodeˉlength {
            let Scanˉopcode: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(
                Module,
                Code + Functionˉcodeˉoffset + Scan
            ));
            var Width: u32 = 1u32;
            var Supported: bool = false;
            if Scanˉopcode == 1u32 { Width = 5u32; Supported = true; }
            if Scanˉopcode == 2u32 { Width = 2u32; Supported = true; }
            if Scanˉopcode == 3u32 { Width = 5u32; Supported = true; }
            if Scanˉopcode == 4u32 { Width = 5u32; Supported = true; }
            if Scanˉopcode == 5u32 { Width = 5u32; Supported = true; }
            if Scanˉopcode == 6u32 { Width = 5u32; Supported = true; }
            if Scanˉopcode == 7u32 { Width = 5u32; Supported = true; }
            if Scanˉopcode == 8u32 { Width = 2u32; Supported = true; }
            if Scanˉopcode == 9u32 { Width = 5u32; Supported = true; }
            if Scanˉopcode == 10u32 { Width = 5u32; Supported = true; }
            if Scanˉopcode >= 11u32 {
                if Scanˉopcode <= 15u32 { Supported = true; }
            }
            if Scanˉopcode >= 16u32 {
                if Scanˉopcode <= 22u32 { Supported = true; }
            }
            if Scanˉopcode >= 32u32 {
                if Scanˉopcode <= 40u32 { Supported = true; }
            }
            if Scanˉopcode == 48u32 { Width = 5u32; Supported = true; }
            if Scanˉopcode == 49u32 { Width = 5u32; Supported = true; }
            if Scanˉopcode == 64u32 { Width = 5u32; Supported = true; }
            if Scanˉopcode == 80u32 { Supported = true; }
            if Scanˉopcode == 81u32 { Supported = true; }
            if Scanˉopcode >= 96u32 {
                if Scanˉopcode <= 103u32 { Supported = true; }
            }
            if Scanˉopcode >= 110u32 {
                if Scanˉopcode <= 112u32 { Supported = true; }
            }
            if Scanˉopcode >= 113u32 {
                if Scanˉopcode <= 116u32 { Supported = true; }
            }
            if Scanˉopcode == 117u32 { Supported = true; }
            if Scanˉopcode == 118u32 { Supported = true; }
            if Scanˉopcode >= 119u32 {
                if Scanˉopcode <= 124u32 { Supported = true; }
            }
            if Supported {
                Supported = true;
            } else {
                return Invalid;
            }
            Scan = Scan + Width;
            Aggregateˉinstructions = Aggregateˉinstructions + 1u32;
            if Aggregateˉinstructions > 4096u32 { return Invalid; }
        }
        Functionˉindex = Functionˉindex + 1u32;
    }
    if Functionˉcursor != Functionsˉend { return Invalid; }

    let Zeroˉvalue: bytes = Bytesˉfromˉu32ˉlittle(0u32);
    let Zeroˉcell: bytes = Bytesˉconcat(Zeroˉvalue, Zeroˉvalue);
    var Zeroˉlocals: bytes = Invalid;
    var Zeroˉindex: u32 = 0u32;
    while Zeroˉindex < 128u32 {
        Zeroˉlocals = Bytesˉconcat(Zeroˉlocals, Zeroˉcell);
        Zeroˉindex = Zeroˉindex + 1u32;
    }

    var Currentˉfunction: u32 = Mainˉindex;
    var Currentˉcodeˉoffset: u32 = Mainˉcodeˉoffset;
    var Currentˉcodeˉlength: u32 = Mainˉcodeˉlength;
    var Pc: u32 = 0u32;
    var Locals: bytes = Zeroˉlocals;
    var Stack: bytes = Invalid;
    var Frames: bytes = Invalid;
    var Heap: bytes = Invalid;
    var Callˉdepth: u32 = 1u32;
    var Executed: u32 = 0u32;
    var Guestˉstatus: u32 = 0u32;
    var Running: bool = true;
    while Running {
        if Executed >= Maximumˉinstructions {
            var Exhausted: bytes = Bytesˉfromˉu32ˉlittle(1331189335u32);
            Exhausted = Bytesˉconcat(
                Exhausted,
                Bytesˉfromˉu16ˉlittle(1u32)
            );
            Exhausted = Bytesˉconcat(
                Exhausted,
                Bytesˉfromˉu16ˉlittle(0u32)
            );
            Exhausted = Bytesˉconcat(
                Exhausted,
                Bytesˉfromˉu32ˉlittle(3011u32)
            );
            Exhausted = Bytesˉconcat(
                Exhausted,
                Bytesˉfromˉu32ˉlittle(Executed)
            );
            Exhausted = Bytesˉconcat(Exhausted, Zeroˉvalue);
            return Exhausted;
        }
        Executed = Executed + 1u32;
        let Instruction: u32 = Code + Currentˉcodeˉoffset + Pc;
        let Opcode: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(Module, Instruction));
        var Handled: bool = false;

        if Opcode == 1u32 {
            Stack = Bytesˉconcat(
                Stack,
                Bytesˉconcat(
                    Bytesˉslice(Module, Instruction + 1u32, 4u32),
                    Zeroˉvalue
                )
            );
            Pc = Pc + 5u32;
            Handled = true;
        }
        if Opcode == 2u32 {
            let Boolˉconstant: u32 = U32ˉfromˉu8(
                Bytesˉreadˉu8(Module, Instruction + 1u32)
            );
            Stack = Bytesˉconcat(
                Stack,
                Bytesˉconcat(
                    Bytesˉfromˉu32ˉlittle(Boolˉconstant),
                    Zeroˉvalue
                )
            );
            Pc = Pc + 2u32;
            Handled = true;
        }
        if Opcode == 8u32 {
            let U8ˉconstant: u32 = U32ˉfromˉu8(
                Bytesˉreadˉu8(Module, Instruction + 1u32)
            );
            Stack = Bytesˉconcat(
                Stack,
                Bytesˉconcat(
                    Bytesˉfromˉu32ˉlittle(U8ˉconstant),
                    Zeroˉvalue
                )
            );
            Pc = Pc + 2u32;
            Handled = true;
        }
        if Opcode == 9u32 {
            Stack = Bytesˉconcat(
                Stack,
                Bytesˉconcat(
                    Bytesˉslice(Module, Instruction + 1u32, 4u32),
                    Zeroˉvalue
                )
            );
            Pc = Pc + 5u32;
            Handled = true;
        }

        var Isˉdataˉinstruction: bool = false;
        if Opcode == 3u32 { Isˉdataˉinstruction = true; }
        if Opcode == 6u32 { Isˉdataˉinstruction = true; }
        if Opcode == 7u32 { Isˉdataˉinstruction = true; }
        if Opcode == 10u32 { Isˉdataˉinstruction = true; }
        if Isˉdataˉinstruction {
            let Dataˉindex: u32 = Bytesˉreadˉu32ˉlittle(
                Module,
                Instruction + 1u32
            );
            var Dataˉcursor: u32 = Data + 4u32;
            var Currentˉdata: u32 = 0u32;
            var Selectedˉdataˉkind: u32 = 0u32;
            var Selectedˉdataˉoffset: u32 = 0u32;
            var Selectedˉdataˉlength: u32 = 0u32;
            while Currentˉdata <= Dataˉindex {
                let Dataˉnameˉlength: u32 = Bytesˉreadˉu32ˉlittle(
                    Module,
                    Dataˉcursor
                );
                Dataˉcursor = Dataˉcursor + 4u32 + Dataˉnameˉlength;
                let Dataˉkind: u32 = U32ˉfromˉu8(
                    Bytesˉreadˉu8(Module, Dataˉcursor)
                );
                Dataˉcursor = Dataˉcursor + 1u32;
                let Dataˉlength: u32 = Bytesˉreadˉu32ˉlittle(
                    Module,
                    Dataˉcursor
                );
                Dataˉcursor = Dataˉcursor + 4u32;
                if Currentˉdata == Dataˉindex {
                    Selectedˉdataˉkind = Dataˉkind;
                    Selectedˉdataˉoffset = Dataˉcursor;
                    Selectedˉdataˉlength = Dataˉlength;
                }
                if Dataˉkind == 4u32 {
                    Dataˉcursor = Dataˉcursor + Dataˉlength * 4u32;
                } else {
                    Dataˉcursor = Dataˉcursor + Dataˉlength;
                }
                Currentˉdata = Currentˉdata + 1u32;
            }

            if Opcode == 3u32 {
                if Selectedˉdataˉkind != 3u32 { return Invalid; }
            }
            if Opcode == 6u32 {
                if Selectedˉdataˉkind != 4u32 { return Invalid; }
            }
            if Opcode == 7u32 {
                if Selectedˉdataˉkind != 4u32 { return Invalid; }
            }
            if Opcode == 10u32 {
                if Selectedˉdataˉkind != 5u32 { return Invalid; }
            }

            if Opcode == 3u32 {
                let Textˉstaticˉheapˉoffset: u32 = Bytesˉlength(Heap);
                if Selectedˉdataˉlength > 16384u32 {
                    Guestˉstatus = 3015u32;
                    Running = false;
                } else {
                    if Textˉstaticˉheapˉoffset > 65536u32 - Selectedˉdataˉlength {
                        Guestˉstatus = 3018u32;
                        Running = false;
                    } else {
                        Heap = Bytesˉconcat(
                            Heap,
                            Bytesˉslice(
                                Module,
                                Selectedˉdataˉoffset,
                                Selectedˉdataˉlength
                            )
                        );
                        Stack = Bytesˉconcat(
                            Stack,
                            Bytesˉconcat(
                                Bytesˉfromˉu32ˉlittle(Textˉstaticˉheapˉoffset),
                                Bytesˉfromˉu32ˉlittle(Selectedˉdataˉlength)
                            )
                        );
                    }
                }
            }
            if Opcode == 6u32 {
                Stack = Bytesˉconcat(
                    Stack,
                    Bytesˉconcat(
                        Bytesˉfromˉu32ˉlittle(Selectedˉdataˉlength),
                        Zeroˉvalue
                    )
                );
            }
            if Opcode == 7u32 {
                let Dataˉloadˉstackˉlength: u32 = Bytesˉlength(Stack);
                let Dataˉloadˉsignedˉindex: i32 = Bytesˉreadˉi32ˉlittle(
                    Stack,
                    Dataˉloadˉstackˉlength - 8u32
                );
                let Dataˉloadˉindex: u32 = Bytesˉreadˉu32ˉlittle(
                    Stack,
                    Dataˉloadˉstackˉlength - 8u32
                );
                Stack = Bytesˉslice(
                    Stack,
                    0u32,
                    Dataˉloadˉstackˉlength - 8u32
                );
                if Dataˉloadˉsignedˉindex < 0 {
                    Guestˉstatus = 3008u32;
                    Running = false;
                } else {
                    if Dataˉloadˉindex >= Selectedˉdataˉlength {
                        Guestˉstatus = 3008u32;
                        Running = false;
                    } else {
                        Stack = Bytesˉconcat(
                            Stack,
                            Bytesˉconcat(
                                Bytesˉslice(
                                    Module,
                                    Selectedˉdataˉoffset + Dataˉloadˉindex * 4u32,
                                    4u32
                                ),
                                Zeroˉvalue
                            )
                        );
                    }
                }
            }
            if Opcode == 10u32 {
                let Bytesˉstaticˉheapˉoffset: u32 = Bytesˉlength(Heap);
                if Selectedˉdataˉlength > 16384u32 {
                    Guestˉstatus = 3015u32;
                    Running = false;
                } else {
                    if Bytesˉstaticˉheapˉoffset > 65536u32 - Selectedˉdataˉlength {
                        Guestˉstatus = 3018u32;
                        Running = false;
                    } else {
                        Heap = Bytesˉconcat(
                            Heap,
                            Bytesˉslice(
                                Module,
                                Selectedˉdataˉoffset,
                                Selectedˉdataˉlength
                            )
                        );
                        Stack = Bytesˉconcat(
                            Stack,
                            Bytesˉconcat(
                                Bytesˉfromˉu32ˉlittle(Bytesˉstaticˉheapˉoffset),
                                Bytesˉfromˉu32ˉlittle(Selectedˉdataˉlength)
                            )
                        );
                    }
                }
            }
            Pc = Pc + 5u32;
            Handled = true;
        }

        if Opcode == 4u32 {
            let Loadedˉlocalˉindex: u32 = Bytesˉreadˉu32ˉlittle(
                Module,
                Instruction + 1u32
            );
            Stack = Bytesˉconcat(
                Stack,
                Bytesˉslice(Locals, Loadedˉlocalˉindex * 8u32, 8u32)
            );
            Pc = Pc + 5u32;
            Handled = true;
        }
        if Opcode == 5u32 {
            let Storedˉlocalˉindex: u32 = Bytesˉreadˉu32ˉlittle(
                Module,
                Instruction + 1u32
            );
            let Storeˉstackˉlength: u32 = Bytesˉlength(Stack);
            let Storedˉvalue: bytes = Bytesˉslice(
                Stack,
                Storeˉstackˉlength - 8u32,
                8u32
            );
            Stack = Bytesˉslice(Stack, 0u32, Storeˉstackˉlength - 8u32);
            let Storedˉlocalˉoffset: u32 = Storedˉlocalˉindex * 8u32;
            let Storedˉprefix: bytes = Bytesˉslice(
                Locals,
                0u32,
                Storedˉlocalˉoffset
            );
            let Storedˉsuffix: bytes = Bytesˉslice(
                Locals,
                Storedˉlocalˉoffset + 8u32,
                1016u32 - Storedˉlocalˉoffset
            );
            Locals = Bytesˉconcat(
                Bytesˉconcat(Storedˉprefix, Storedˉvalue),
                Storedˉsuffix
            );
            Pc = Pc + 5u32;
            Handled = true;
        }

        if Opcode == 11u32 {
            let Bytesˉlengthˉstack: u32 = Bytesˉlength(Stack);
            let Bytesˉvalueˉlength: u32 = Bytesˉreadˉu32ˉlittle(
                Stack,
                Bytesˉlengthˉstack - 4u32
            );
            Stack = Bytesˉslice(Stack, 0u32, Bytesˉlengthˉstack - 8u32);
            Stack = Bytesˉconcat(
                Stack,
                Bytesˉconcat(
                    Bytesˉfromˉu32ˉlittle(Bytesˉvalueˉlength),
                    Zeroˉvalue
                )
            );
            Pc = Pc + 1u32;
            Handled = true;
        }
        if Opcode == 12u32 {
            var Bytesˉsliceˉstack: u32 = Bytesˉlength(Stack);
            let Bytesˉsliceˉlength: u32 = Bytesˉreadˉu32ˉlittle(
                Stack,
                Bytesˉsliceˉstack - 8u32
            );
            Stack = Bytesˉslice(Stack, 0u32, Bytesˉsliceˉstack - 8u32);
            Bytesˉsliceˉstack = Bytesˉlength(Stack);
            let Bytesˉsliceˉoffset: u32 = Bytesˉreadˉu32ˉlittle(
                Stack,
                Bytesˉsliceˉstack - 8u32
            );
            Stack = Bytesˉslice(Stack, 0u32, Bytesˉsliceˉstack - 8u32);
            Bytesˉsliceˉstack = Bytesˉlength(Stack);
            let Bytesˉsliceˉsourceˉoffset: u32 = Bytesˉreadˉu32ˉlittle(
                Stack,
                Bytesˉsliceˉstack - 8u32
            );
            let Bytesˉsliceˉsourceˉlength: u32 = Bytesˉreadˉu32ˉlittle(
                Stack,
                Bytesˉsliceˉstack - 4u32
            );
            Stack = Bytesˉslice(Stack, 0u32, Bytesˉsliceˉstack - 8u32);
            if Bytesˉsliceˉoffset > Bytesˉsliceˉsourceˉlength {
                Guestˉstatus = 3008u32;
                Running = false;
            } else {
                if Bytesˉsliceˉlength
                    > Bytesˉsliceˉsourceˉlength - Bytesˉsliceˉoffset {
                    Guestˉstatus = 3008u32;
                    Running = false;
                } else {
                    Stack = Bytesˉconcat(
                        Stack,
                        Bytesˉconcat(
                            Bytesˉfromˉu32ˉlittle(
                                Bytesˉsliceˉsourceˉoffset + Bytesˉsliceˉoffset
                            ),
                            Bytesˉfromˉu32ˉlittle(Bytesˉsliceˉlength)
                        )
                    );
                }
            }
            Pc = Pc + 1u32;
            Handled = true;
        }
        if Opcode >= 13u32 {
            if Opcode <= 15u32 {
                var Bytesˉreadˉstack: u32 = Bytesˉlength(Stack);
                let Bytesˉreadˉoffset: u32 = Bytesˉreadˉu32ˉlittle(
                    Stack,
                    Bytesˉreadˉstack - 8u32
                );
                Stack = Bytesˉslice(Stack, 0u32, Bytesˉreadˉstack - 8u32);
