            Stack = Bytesˉslice(Stack, 0u32, Bytesˉlengthˉstack - 8u32);
            Stack = Bytesˉconcat(
                Stack,
                Bytesˉconcat(
                    Bytesˉfromˉu32ˉlittle(Bytesˉvalueˉlength),
                    Zeroˉvalue
                )
            );
            Aggregateˉinstructions = Aggregateˉinstructions + 1u32;
            Mainˉfound = true;
        }
        if Payloadˉlength == 12u32 {
            var Bytesˉsliceˉstack: u32 = Bytesˉlength(Stack);
            let Bytesˉsliceˉlength: u32 = Bytesˉreadˉu32ˉlittle(
                Stack,
                Bytesˉsliceˉstack - 8u32
            );
            Stack = Bytesˉslice(Stack, 0u32, Bytesˉsliceˉstack - 8u32);
            Bytesˉsliceˉstack = Bytesˉlength(Stack);
            let Bytesˉsliceˉoffset: u32 = Bytesˉreadˉu32ˉlittle(
                Stack,
                Bytesˉsliceˉstack - 8u32
            );
            Stack = Bytesˉslice(Stack, 0u32, Bytesˉsliceˉstack - 8u32);
            Bytesˉsliceˉstack = Bytesˉlength(Stack);
            let Bytesˉsliceˉsourceˉoffset: u32 = Bytesˉreadˉu32ˉlittle(
                Stack,
                Bytesˉsliceˉstack - 8u32
            );
            let Bytesˉsliceˉsourceˉlength: u32 = Bytesˉreadˉu32ˉlittle(
                Stack,
                Bytesˉsliceˉstack - 4u32
            );
            Stack = Bytesˉslice(Stack, 0u32, Bytesˉsliceˉstack - 8u32);
            if Bytesˉsliceˉoffset > Bytesˉsliceˉsourceˉlength {
                Sectionˉkind = 3008u32;
            } else {
                if Bytesˉsliceˉlength
                    > Bytesˉsliceˉsourceˉlength - Bytesˉsliceˉoffset {
                    Sectionˉkind = 3008u32;
                } else {
                    if Bytesˉsliceˉlength == 0u32 {
                        Releasedˉdescriptors = Bytesˉconcat(
                            Releasedˉdescriptors,
                            Bytesˉconcat(
                                Bytesˉfromˉu32ˉlittle(
                                    Bytesˉsliceˉsourceˉoffset
                                ),
                                Bytesˉfromˉu32ˉlittle(
                                    Bytesˉsliceˉsourceˉlength
                                )
                            )
                        );
                    }
                    Stack = Bytesˉconcat(
                        Stack,
                        Bytesˉconcat(
                            Bytesˉfromˉu32ˉlittle(
                                Bytesˉsliceˉsourceˉoffset + Bytesˉsliceˉoffset
                            ),
                            Bytesˉfromˉu32ˉlittle(Bytesˉsliceˉlength)
                        )
                    );
                }
            }
            Aggregateˉinstructions = Aggregateˉinstructions + 1u32;
            Mainˉfound = true;
        }
        if Payloadˉlength >= 13u32 {
            if Payloadˉlength <= 15u32 {
                var Bytesˉreadˉstack: u32 = Bytesˉlength(Stack);
                let Bytesˉreadˉoffset: u32 = Bytesˉreadˉu32ˉlittle(
                    Stack,
                    Bytesˉreadˉstack - 8u32
                );
                Stack = Bytesˉslice(Stack, 0u32, Bytesˉreadˉstack - 8u32);
                Bytesˉreadˉstack = Bytesˉlength(Stack);
                let Bytesˉreadˉsourceˉoffset: u32 = Bytesˉreadˉu32ˉlittle(
                    Stack,
                    Bytesˉreadˉstack - 8u32
                );
                let Bytesˉreadˉsourceˉlength: u32 = Bytesˉreadˉu32ˉlittle(
                    Stack,
                    Bytesˉreadˉstack - 4u32
                );
                Stack = Bytesˉslice(Stack, 0u32, Bytesˉreadˉstack - 8u32);
                Releasedˉdescriptors = Bytesˉconcat(
                    Releasedˉdescriptors,
                    Bytesˉconcat(
                        Bytesˉfromˉu32ˉlittle(Bytesˉreadˉsourceˉoffset),
                        Bytesˉfromˉu32ˉlittle(Bytesˉreadˉsourceˉlength)
                    )
                );
                let Bytesˉreadˉevaluation: bytes = Evaluateˉbytesˉread(
                    Heap,
                    Payloadˉlength,
                    Bytesˉreadˉsourceˉoffset,
                    Bytesˉreadˉsourceˉlength,
                    Bytesˉreadˉoffset
                );
                Sectionˉkind = Bytesˉreadˉu32ˉlittle(
                    Bytesˉreadˉevaluation, 0u32
                );
