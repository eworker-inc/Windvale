            }
        }
        if Sectionˉkind == 0u32 {
            if Aggregateˉinstructions > Mainˉcodeˉlength {
                return Invalid;
            }
        }
        }
        Running = Sectionˉkind == 0u32;
    }
    if Sectionˉkind != 0u32 {
        if Requestˉmajor >= 3u32 {
            var Streamˉfailure: bytes = Bytesˉfromˉu32ˉlittle(
                1331189335u32
            );
            Streamˉfailure = Bytesˉconcat(
                Streamˉfailure,
                Bytesˉfromˉu16ˉlittle(Requestˉmajor)
