            var Returningˉlocalˉoffset: u32 = 0u32;
            while Returningˉlocalˉoffset < Functionˉcursor {
                let Returningˉlocalˉkind: u32 = Bytesˉreadˉu32ˉlittle(
                    Localˉshapes,
                    Returningˉshapeˉoffset + Returningˉlocalˉoffset
                );
                if Returningˉlocalˉkind == 3u32 ||
                    Returningˉlocalˉkind == 6u32 ||
                    Returningˉlocalˉkind == 23u32 ||
                    Returningˉlocalˉkind == 24u32 {
                    Releasedˉdescriptors = Bytesˉconcat(
                        Releasedˉdescriptors,
                        Bytesˉslice(Locals, Returningˉlocalˉoffset, 8u32)
                    );
                }
                Returningˉlocalˉoffset = Returningˉlocalˉoffset + 8u32;
            }
            Functionˉindex = Bytesˉreadˉu32ˉlittle(
                Frames,
                Framesˉlength - 4u32
            );
            Functionˉcursor = Bytesˉreadˉu32ˉlittle(
                Functionˉframeˉmetadata,
                Functionˉindex * 8u32 + 4u32
            );
            let Frameˉoffset: u32 = Framesˉlength - 8u32 - Functionˉcursor;
            Aggregateˉinstructions = Bytesˉreadˉu32ˉlittle(Frames, Frameˉoffset);
            Mainˉcodeˉoffset = Bytesˉreadˉu32ˉlittle(
                Functionˉcodeˉoffsets,
                Functionˉindex * 4u32
            );
            Mainˉcodeˉlength = Bytesˉreadˉu32ˉlittle(
                Functionˉcodeˉlengths,
                Functionˉindex * 4u32
            );
            Locals = Bytesˉslice(
                Frames,
                Frameˉoffset + 4u32,
                Functionˉcursor
            );
            Frames = Bytesˉslice(Frames, 0u32, Frameˉoffset);
            Stack = Bytesˉconcat(Stack, Returnˉresult);
            Exportˉindex = Exportˉindex - 1u32;
            Mainˉfound = true;
        }

        }
        if Mainˉfound {
            Mainˉfound = true;
        } else {
            return Invalid;
        }
        // Copy operation results first, release consumed owners second, and
        // only then reuse a free span for the pending immutable result.
        if Sectionˉkind == 0u32 {
            var Releasedˉcursor: u32 = 0u32;
            while Releasedˉcursor < Bytesˉlength(Releasedˉdescriptors) {
                let Releasedˉvalue: bytes = Bytesˉslice(
                    Releasedˉdescriptors,
                    Releasedˉcursor,
                    8u32
                );
                let Releasedˉlength: u32 = Bytesˉreadˉu32ˉlittle(
                    Releasedˉvalue,
                    4u32
                );
                if Releasedˉlength > 0u32 {
                    let Releasedˉallocations: bytes = Releaseˉdescriptor(
                        Heapˉallocations,
                        Heapˉallocationˉcount,
                        Releasedˉvalue
                    );
                    if Bytesˉlength(Releasedˉallocations) == 0u32 {
                        return Invalid;
                    }
                    if Bytesˉlength(Releasedˉallocations)
                        != Bytesˉlength(Heapˉallocations) {
                        return Invalid;
                    }
                    Heapˉallocations = Releasedˉallocations;
                }
                Releasedˉcursor = Releasedˉcursor + 8u32;
            }

            if Heapˉallocationˉrequested {
                let Allocatedˉlength: u32 = Bytesˉlength(
                    Heapˉallocationˉvalue
                );
                var Allocatedˉoffset: u32 = 0u32;
                if Allocatedˉlength > 0u32 {
                    var Allocatedˉspaceˉsearching: bool = true;
                    while Allocatedˉspaceˉsearching {
                        var Allocatedˉnearestˉoffset: u32 = 65536u32;
                        var Allocatedˉnearestˉlength: u32 = 0u32;
                        var Allocatedˉspaceˉscan: u32 = 0u32;
                        while Allocatedˉspaceˉscan < Heapˉallocationˉcount {
                            let Allocatedˉspaceˉentry: u32 =
                                Allocatedˉspaceˉscan * 12u32;
                            let Allocatedˉspaceˉreferences: u32 =
                                Bytesˉreadˉu32ˉlittle(
                                    Heapˉallocations,
                                    Allocatedˉspaceˉentry + 8u32
                                );
                            if Allocatedˉspaceˉreferences > 0u32 {
                                let Allocatedˉspaceˉoffset: u32 =
                                    Bytesˉreadˉu32ˉlittle(
                                        Heapˉallocations,
                                        Allocatedˉspaceˉentry
                                    );
                                if Allocatedˉspaceˉoffset >= Allocatedˉoffset {
                                    if Allocatedˉspaceˉoffset
                                        < Allocatedˉnearestˉoffset {
                                        Allocatedˉnearestˉoffset =
                                            Allocatedˉspaceˉoffset;
                                        Allocatedˉnearestˉlength =
                                            Bytesˉreadˉu32ˉlittle(
                                                Heapˉallocations,
                                                Allocatedˉspaceˉentry + 4u32
                                            );
                                    }
                                }
                            }
                            Allocatedˉspaceˉscan =
                                Allocatedˉspaceˉscan + 1u32;
                        }
                        if Allocatedˉlength <= Allocatedˉnearestˉoffset
                            - Allocatedˉoffset {
                            Allocatedˉspaceˉsearching = false;
                        } else {
                            if Allocatedˉnearestˉoffset == 65536u32 {
                                Allocatedˉoffset = 4294967295u32;
                                Allocatedˉspaceˉsearching = false;
                            } else {
                                Allocatedˉoffset = Allocatedˉnearestˉoffset
                                    + Allocatedˉnearestˉlength;
                                if Allocatedˉoffset > 65536u32
                                    - Allocatedˉlength {
                                    Allocatedˉoffset = 4294967295u32;
                                    Allocatedˉspaceˉsearching = false;
                                }
                            }
                        }
                    }
                    if Allocatedˉoffset == 4294967295u32 {
