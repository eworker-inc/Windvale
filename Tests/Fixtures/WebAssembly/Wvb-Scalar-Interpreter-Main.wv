                        Stack,
                        Bytesˉconcat(
                            Bytesˉslice(Bytesˉreadˉevaluation, 4u32, 4u32),
                            Zeroˉvalue
                        )
                    );
                }
                Aggregateˉinstructions = Aggregateˉinstructions + 1u32;
                Mainˉfound = true;
            }
        }

        if Isˉbaseˉnumeric(Payloadˉlength) {
            let Baseˉnumericˉresult: bytes = Executeˉbaseˉnumeric(
                Payloadˉlength, Stack, Zeroˉvalue
            );
            if Bytesˉlength(Baseˉnumericˉresult) < 4u32 { return Invalid; }
            Sectionˉkind = Bytesˉreadˉu32ˉlittle(
                Baseˉnumericˉresult, 0u32
            );
            Stack = Bytesˉslice(
                Baseˉnumericˉresult,
                4u32,
                Bytesˉlength(Baseˉnumericˉresult) - 4u32
            );
            Aggregateˉinstructions = Aggregateˉinstructions + 1u32;
            Mainˉfound = true;
        }
        }

        else {
        if Payloadˉlength >= 32u32 && Payloadˉlength <= 40u32 {
            Stack = Executeˉbaseˉcomparison(
                Payloadˉlength, Stack, Zeroˉvalue
            );
            if Bytesˉlength(Stack) == 0u32 { return Invalid; }
            Aggregateˉinstructions = Aggregateˉinstructions + 1u32;
            Mainˉfound = true;
        }

        if Payloadˉlength >= 96u32 {
        if Payloadˉlength <= 125u32 ||
            (Payloadˉlength >= 151u32 && Payloadˉlength <= 153u32) ||
            Payloadˉlength == 196u32 || Payloadˉlength == 197u32 ||
            Payloadˉlength == 198u32 ||
            (Payloadˉlength >= 199u32 && Payloadˉlength <= 205u32) {
        if Payloadˉlength <= 103u32 {
            Stack = Executeˉbaseˉcomparison(
                Payloadˉlength, Stack, Zeroˉvalue
            );
            if Bytesˉlength(Stack) == 0u32 { return Invalid; }
            Aggregateˉinstructions = Aggregateˉinstructions + 1u32;
            Mainˉfound = true;
        }

        if Payloadˉlength == 104u32 || Payloadˉlength == 151u32 ||
            Payloadˉlength == 197u32 {
            let Recordˉcreation: bytes = Aggregateˉcreation(
                Module,
                Typeˉoffsets,
                Payloadˉlength,
                Payload
            );
            if Bytesˉlength(Recordˉcreation) != 12u32 { return Invalid; }
            let Recordˉowner: u32 = Bytesˉreadˉu32ˉlittle(
                Recordˉcreation,
                0u32
            );
            let Recordˉfieldˉcount: u32 = Bytesˉreadˉu32ˉlittle(
                Recordˉcreation,
                4u32
            );
            let Recordˉtypeˉcursor: u32 = Bytesˉreadˉu32ˉlittle(
                Recordˉcreation,
                8u32
            ) - 4u32;
            Stackˉconsumed = Recordˉfieldˉcount;
            Stackˉproduced = true;
            Stackˉproducedˉkind = 2u32;
            let Recordˉfieldˉbytes: u32 = Recordˉfieldˉcount * 8u32;
            let Recordˉstackˉlength: u32 = Bytesˉlength(Stack);
            let Recordˉfields: bytes = Bytesˉslice(
                Stack,
                Recordˉstackˉlength - Recordˉfieldˉbytes,
                Recordˉfieldˉbytes
            );
            Stack = Bytesˉslice(
                Stack,
                0u32,
                Recordˉstackˉlength - Recordˉfieldˉbytes
            );

            var Recordˉslot: u32 = Recordˉcapacity;
            if Recordˉfieldˉcount == 0u32 {
                Recordˉslot = 4294967295u32;
