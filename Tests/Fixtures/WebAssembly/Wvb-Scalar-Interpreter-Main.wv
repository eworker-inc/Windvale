                    Streamˉsuccess = Bytesˉconcat(
                        Streamˉsuccess,
                        Bytesˉfromˉu32ˉlittle(0u32)
                    );
                    Streamˉsuccess = Bytesˉconcat(
                        Streamˉsuccess,
                        Bytesˉfromˉu32ˉlittle(Envelope)
                    );
                    Streamˉsuccess = Bytesˉconcat(
                        Streamˉsuccess,
                        Bytesˉslice(Returnˉresult, 0u32, 4u32)
