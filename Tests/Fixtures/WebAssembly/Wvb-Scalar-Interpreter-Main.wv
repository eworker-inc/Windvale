fn Executeˉvectorˉgrowˉreserved(
    Module: bytes,
    Typeˉoffsets: bytes,
    Typeˉcount: u32,
    Payload: u32,
    Initialˉstack: bytes,
    Initialˉlocals: bytes,
    Initialˉstate: bytes,
    Initialˉmetadata: bytes,
    Initialˉrecords: bytes,
    Initialˉheap: bytes,
    Initialˉheapˉallocations: bytes,
    Initialˉheapˉallocationˉcount: u32,
    Initialˉallocationˉleases: bytes,
    Zeroˉcell: bytes
) -> Vectorˉgrowˉexecution {
    let Empty: bytes = Bytesˉslice(Module, 0u32, 0u32);
    let Invalid: Vectorˉgrowˉexecution = Vectorˉgrowˉexecution(
        false, 0u32, Empty, Initialˉlocals, Initialˉstate,
        Initialˉmetadata, Initialˉrecords, Initialˉheap,
        Initialˉheapˉallocations, Initialˉheapˉallocationˉcount,
        Initialˉallocationˉleases
    );
    let Stackˉlength: u32 = Bytesˉlength(Initialˉstack);
    if Stackˉlength < 8u32 || Bytesˉlength(Initialˉallocationˉleases) !=
        Initialˉheapˉallocationˉcount * 28u32 {
        return Invalid;
    }
    let Vectorˉlocal: u32 = Bytesˉreadˉu32ˉlittle(
        Module, Payload + 1u32
    );
    let Budgetˉlocal: u32 = Bytesˉreadˉu32ˉlittle(
        Module, Payload + 5u32
    );
    let Resultˉtype: u32 = Bytesˉreadˉu32ˉlittle(
        Module, Payload + 9u32
    );
    let Localˉslots: u32 = Bytesˉlength(Initialˉlocals) / 8u32;
    if Vectorˉlocal >= Localˉslots || Budgetˉlocal >= Localˉslots ||
        Vectorˉlocal == Budgetˉlocal || Resultˉtype >= Typeˉcount {
        return Invalid;
    }
    let Vector: bytes = Bytesˉslice(
        Initialˉlocals, Vectorˉlocal * 8u32, 8u32
    );
    if !Collections.Collectionˉbackingˉvalid(
        Initialˉheap, Initialˉheapˉallocations,
        Initialˉheapˉallocationˉcount, Vector
    ) {
        return Invalid;
    }
    let Vectorˉallocation: u32 = Descriptorˉallocationˉindex(
        Initialˉheapˉallocations,
        Initialˉheapˉallocationˉcount,
        Vector
    );
    if Vectorˉallocation == 4294967295u32 || Bytesˉreadˉu32ˉlittle(
            Initialˉheapˉallocations,
            Vectorˉallocation * 12u32 + 8u32
        ) != 1u32 {
        return Invalid;
    }
    let Vectorˉoffset: u32 = Bytesˉreadˉu32ˉlittle(Vector, 0u32);
    let Oldˉmaximum: u32 = Bytesˉreadˉu32ˉlittle(
        Initialˉheap, Vectorˉoffset + 4u32
    );
    let Newˉmaximum: u64 = Bytesˉreadˉu64ˉlittle(
        Initialˉstack, Stackˉlength - 8u32
    );
    if Newˉmaximum <= U64ˉfromˉu32(Oldˉmaximum) {
        return Vectorˉgrowˉexecution(
            true, 3008u32,
            Bytesˉslice(Initialˉstack, 0u32, Stackˉlength - 8u32),
            Initialˉlocals, Initialˉstate, Initialˉmetadata,
            Initialˉrecords, Initialˉheap, Initialˉheapˉallocations,
            Initialˉheapˉallocationˉcount, Initialˉallocationˉleases
        );
    }

    var Requestedˉbytes: u64 = 18446744073709551615u64;
    if Newˉmaximum <= 2305843009213693950u64 {
        Requestedˉbytes = Newˉmaximum * 8u64 + 8u64;
    }
    var Locals: bytes = Initialˉlocals;
    var State: bytes = Initialˉstate;
    var Metadata: bytes = Initialˉmetadata;
    var Records: bytes = Initialˉrecords;
    var Heap: bytes = Initialˉheap;
    var Heapˉallocations: bytes = Initialˉheapˉallocations;
    var Heapˉallocationˉcount: u32 = Initialˉheapˉallocationˉcount;
    var Allocationˉleases: bytes = Initialˉallocationˉleases;
    var Resultˉcase: u32 = 0u32;
    var Resultˉfields: bytes = Zeroˉcell;
    var Failureˉreason: u8 = 0u8;
    var Failureˉavailable: u64 = 0u64;

    if Newˉmaximum > 2047u64 {
        Failureˉreason = 2u8;
    } else {
        let Budgetˉtoken: bytes = Bytesˉslice(
            Initialˉlocals, Budgetˉlocal * 8u32, 8u32
        );
        let Lease: Budgets.Allocationˉleaseˉresult =
            Budgets.Constructˉchildˉallocationˉlease(
                Initialˉstate, Budgetˉtoken, Requestedˉbytes,
                Requestedˉbytes, 8u32
            );
        if !Lease.Valid { return Invalid; }
        if !Lease.Succeeded {
            Failureˉreason = Lease.Reason;
            Failureˉavailable = Lease.Availableˉbytes;
        } else {
            let Backing: bytes = Collections.Collectionˉgrownˉbacking(
                Initialˉheap, Vector,
                Bytesˉreadˉu32ˉlittle(
                    Initialˉstack, Stackˉlength - 8u32
                ),
                Zeroˉcell
            );
            if Bytesˉlength(Backing) !=
                    (Bytesˉreadˉu32ˉlittle(
                        Initialˉstack, Stackˉlength - 8u32
                    ) + 1u32) * 8u32 {
                return Invalid;
            }
            let Allocation: Heapˉallocationˉresult = Allocateˉheapˉvalue(
                Initialˉheap, Initialˉheapˉallocations,
                Initialˉheapˉallocationˉcount, Backing
            );
            if !Allocation.Valid { return Invalid; }
            if !Allocation.Succeeded {
                Failureˉreason = 4u8;
            } else {
                var Candidateˉleases: bytes = Initialˉallocationˉleases;
                if Allocation.Count > Initialˉheapˉallocationˉcount {
                    var Leaseˉpadding: bytes = Zeroˉcell;
                    Leaseˉpadding = Bytesˉconcat(Leaseˉpadding, Zeroˉcell);
                    Leaseˉpadding = Bytesˉconcat(Leaseˉpadding, Zeroˉcell);
                    Leaseˉpadding = Bytesˉconcat(
                        Leaseˉpadding, Bytesˉfromˉu32ˉlittle(0u32)
                    );
                    Candidateˉleases = Bytesˉconcat(
                        Candidateˉleases, Leaseˉpadding
                    );
                }
                Candidateˉleases = Replaceˉallocationˉlease(
                    Candidateˉleases, Allocation.Count,
                    Allocation.Index, Lease.Token
                );
                if Bytesˉlength(Candidateˉleases) != Allocation.Count * 28u32 {
                    return Invalid;
                }
                var Zeroˉlease: bytes = Zeroˉcell;
                Zeroˉlease = Bytesˉconcat(Zeroˉlease, Zeroˉcell);
                Zeroˉlease = Bytesˉconcat(Zeroˉlease, Zeroˉcell);
                Zeroˉlease = Bytesˉconcat(
                    Zeroˉlease, Bytesˉfromˉu32ˉlittle(0u32)
                );
                let Released: Descriptorˉreleaseˉexecution =
                    Releaseˉdescriptorˉandˉlease(
                        Lease.State, Allocation.Allocations,
                        Allocation.Count, Candidateˉleases,
                        Vector, Zeroˉlease
                    );
                if !Released.Valid { return Invalid; }
                State = Released.State;
                Heap = Allocation.Heap;
                Heapˉallocations = Released.Allocations;
                Heapˉallocationˉcount = Allocation.Count;
                Allocationˉleases = Released.Leases;
                let Localˉoffset: u32 = Vectorˉlocal * 8u32;
                Locals = Bytesˉconcat(
                    Bytesˉconcat(
                        Bytesˉslice(Initialˉlocals, 0u32, Localˉoffset),
                        Allocation.Descriptor
                    ),
                    Bytesˉslice(
                        Initialˉlocals, Localˉoffset + 8u32,
                        Bytesˉlength(Initialˉlocals) - Localˉoffset - 8u32
                    )
                );
            }
        }
    }

    if Failureˉreason != 0u8 {
        Resultˉcase = 1u32;
        let Failureˉallocation: Aggregateˉallocation =
            Allocateˉallocationˉfailure(
                Module, Typeˉoffsets, Resultˉtype, Failureˉreason,
                Requestedˉbytes, Failureˉavailable,
                Initialˉmetadata, Initialˉrecords, Zeroˉcell
            );
        if !Failureˉallocation.Valid { return Invalid; }
        Resultˉfields = Failureˉallocation.Handle;
        Metadata = Failureˉallocation.Metadata;
        Records = Failureˉallocation.Values;
    }
    let Resultˉowner: u32 = 2147483648u32 +
        (Resultˉtype + 1u32) * 256u32 + Resultˉcase;
    let Resultˉallocation: Aggregateˉallocation =
        Allocateˉaggregateˉwithoutˉcollection(
            Resultˉowner, Resultˉfields, Metadata, Records, Zeroˉcell
        );
    if !Resultˉallocation.Valid { return Invalid; }
    return Vectorˉgrowˉexecution(
        true, 0u32,
        Bytesˉconcat(
            Bytesˉslice(Initialˉstack, 0u32, Stackˉlength - 8u32),
            Resultˉallocation.Handle
        ),
        Locals, State, Resultˉallocation.Metadata,
        Resultˉallocation.Values, Heap, Heapˉallocations,
        Heapˉallocationˉcount, Allocationˉleases
    );
}

fn Executeˉvectorˉappend(
    Module: bytes,
    Typeˉoffsets: bytes,
    Typeˉcount: u32,
    Payload: u32,
    Initialˉstack: bytes,
    Locals: bytes,
    Initialˉmetadata: bytes,
    Initialˉrecords: bytes,
    Initialˉheap: bytes,
    Heapˉallocations: bytes,
    Heapˉallocationˉcount: u32,
    Zeroˉcell: bytes
) -> Vectorˉappendˉexecution {
    let Empty: bytes = Bytesˉslice(Module, 0u32, 0u32);
    let Invalid: Vectorˉappendˉexecution = Vectorˉappendˉexecution(
        false, Empty, Initialˉmetadata, Initialˉrecords, Initialˉheap
    );
    let Stackˉlength: u32 = Bytesˉlength(Initialˉstack);
    if Stackˉlength < 8u32 { return Invalid; }
    let Vectorˉlocal: u32 = Bytesˉreadˉu32ˉlittle(Module, Payload + 1u32);
    let Resultˉtype: u32 = Bytesˉreadˉu32ˉlittle(Module, Payload + 5u32);
    if Vectorˉlocal >= Bytesˉlength(Locals) / 8u32 ||
        Resultˉtype >= Typeˉcount {
        return Invalid;
    }
    let Vector: bytes = Bytesˉslice(Locals, Vectorˉlocal * 8u32, 8u32);
    if !Collections.Collectionˉbackingˉvalid(
        Initialˉheap, Heapˉallocations, Heapˉallocationˉcount, Vector
    ) {
        return Invalid;
    }
    let Value: bytes = Bytesˉslice(
        Initialˉstack, Stackˉlength - 8u32, 8u32
    );
    let Vectorˉoffset: u32 = Bytesˉreadˉu32ˉlittle(Vector, 0u32);
    let Vectorˉcount: u32 = Bytesˉreadˉu32ˉlittle(
        Initialˉheap, Vectorˉoffset
    );
    let Vectorˉmaximum: u32 = Bytesˉreadˉu32ˉlittle(
        Initialˉheap, Vectorˉoffset + 4u32
    );
    var Metadata: bytes = Initialˉmetadata;
    var Records: bytes = Initialˉrecords;
    var Heap: bytes = Initialˉheap;
    var Resultˉcase: u32 = 0u32;
    var Resultˉfields: bytes = Zeroˉcell;

    if Vectorˉcount < Vectorˉmaximum {
        Heap = Collections.Collectionˉappend(
            Initialˉheap, Vector, Value
        );
        if Bytesˉlength(Heap) == 0u32 { return Invalid; }
    } else {
        Resultˉcase = 1u32;
        let Resultˉfailureˉcase: bytes = Variantˉcaseˉfields(
            Module, Typeˉoffsets, Resultˉtype, 1u32
        );
        if Bytesˉlength(Resultˉfailureˉcase) != 8u32 ||
            Bytesˉreadˉu32ˉlittle(Resultˉfailureˉcase, 0u32) != 1u32 {
            return Invalid;
        }
        let Appendˉfailureˉshape: u32 = Fieldˉshapeˉat(
            Module,
            Bytesˉreadˉu32ˉlittle(Resultˉfailureˉcase, 4u32),
            0u32
        );
        if U32ˉfromˉu8(Bytesˉreadˉu8(Module, Appendˉfailureˉshape)) !=
            7u32 {
            return Invalid;
        }
        let Appendˉfailureˉtype: u32 = Bytesˉreadˉu32ˉlittle(
            Module, Appendˉfailureˉshape + 1u32
        );
        let Appendˉfailureˉowner: u32 = Appendˉfailureˉtype + 1u32;
        let Appendˉfailureˉdirectory: bytes = Aggregateˉfieldˉdirectory(
            Module, Typeˉoffsets, Appendˉfailureˉowner
        );
        if Bytesˉlength(Appendˉfailureˉdirectory) != 8u32 ||
            Bytesˉreadˉu32ˉlittle(
                Appendˉfailureˉdirectory, 0u32
            ) != 2u32 {
            return Invalid;
        }
        let Collectionˉfailureˉshape: u32 = Fieldˉshapeˉat(
            Module,
            Bytesˉreadˉu32ˉlittle(Appendˉfailureˉdirectory, 4u32),
            0u32
        );
        if U32ˉfromˉu8(Bytesˉreadˉu8(Module, Collectionˉfailureˉshape)) !=
            11u32 {
            return Invalid;
        }
        let Collectionˉfailureˉtype: u32 = Bytesˉreadˉu32ˉlittle(
            Module, Collectionˉfailureˉshape + 1u32
        );
        let Collectionˉfailureˉowner: u32 = 2147483648u32 +
            (Collectionˉfailureˉtype + 1u32) * 256u32 + 2u32;
        let Collectionˉfailureˉallocation: Aggregateˉallocation =
            Allocateˉaggregateˉwithoutˉcollection(
                Collectionˉfailureˉowner,
                Bytesˉfromˉu64ˉlittle(U64ˉfromˉu32(Vectorˉmaximum)),
                Metadata, Records, Zeroˉcell
            );
        if !Collectionˉfailureˉallocation.Valid { return Invalid; }
        let Appendˉfailureˉallocation: Aggregateˉallocation =
            Allocateˉaggregateˉwithoutˉcollection(
                Appendˉfailureˉowner,
                Bytesˉconcat(Collectionˉfailureˉallocation.Handle, Value),
                Collectionˉfailureˉallocation.Metadata,
                Collectionˉfailureˉallocation.Values,
                Zeroˉcell
            );
        if !Appendˉfailureˉallocation.Valid { return Invalid; }
        Resultˉfields = Appendˉfailureˉallocation.Handle;
        Metadata = Appendˉfailureˉallocation.Metadata;
        Records = Appendˉfailureˉallocation.Values;
    }

    let Resultˉowner: u32 = 2147483648u32 +
        (Resultˉtype + 1u32) * 256u32 + Resultˉcase;
    let Resultˉallocation: Aggregateˉallocation =
        Allocateˉaggregateˉwithoutˉcollection(
            Resultˉowner, Resultˉfields, Metadata, Records, Zeroˉcell
        );
    if !Resultˉallocation.Valid { return Invalid; }
    return Vectorˉappendˉexecution(
        true,
        Bytesˉconcat(
            Bytesˉslice(Initialˉstack, 0u32, Stackˉlength - 8u32),
            Resultˉallocation.Handle
        ),
        Resultˉallocation.Metadata,
        Resultˉallocation.Values,
        Heap
    );
}

fn Fieldˉshapeˉat(
    Module: bytes,
    Fields: u32,
    Field: u32
) -> u32 {
    var Cursor: u32 = Fields;
    var Index: u32 = 0u32;
    while Index < Field {
        Cursor = Cursor + 4u32 + Bytesˉreadˉu32ˉlittle(Module, Cursor);
        let Kind: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(Module, Cursor));
        Cursor = Cursor + Shapeˉwidthˉat(Module, Cursor);
        Index = Index + 1u32;
    }
    return Cursor + 4u32 + Bytesˉreadˉu32ˉlittle(Module, Cursor);
}

fn Variantˉfieldˉselection(
    Module: bytes,
    Typeˉoffsets: bytes,
    Opcode: u32,
    Instruction: u32
) -> bytes {
    let Invalid: bytes = Bytesˉslice(Module, 0u32, 0u32);
    let Type: u32 = Bytesˉreadˉu32ˉlittle(Module, Instruction + 1u32);
    var Case: u32 = Bytesˉreadˉu32ˉlittle(Module, Instruction + 5u32);
    var Field: u32 = 0u32;
    if Opcode == 196u32 {
        Field = Case % 64u32;
        Case = Case / 64u32;
    }
    let Directory: bytes = Variantˉcaseˉfields(
        Module,
        Typeˉoffsets,
        Type,
        Case
    );
    if Bytesˉlength(Directory) != 8u32 ||
        Field >= Bytesˉreadˉu32ˉlittle(Directory, 0u32) {
        return Invalid;
    }
    let Shape: u32 = Fieldˉshapeˉat(
        Module,
        Bytesˉreadˉu32ˉlittle(Directory, 4u32),
        Field
    );
    let Token: u32 = 2147483648u32
        + (Type + 1u32) * 256u32
        + Case;
    return Bytesˉconcat(
        Bytesˉfromˉu32ˉlittle(Token),
        Bytesˉconcat(
            Bytesˉfromˉu32ˉlittle(Field),
            Bytesˉfromˉu32ˉlittle(Shape)
        )
    );
}

fn Variantˉcaseˉtest(
    Module: bytes,
    Instruction: u32,
    Stack: bytes,
    Zeroˉvalue: bytes
) -> bytes {
    let Invalid: bytes = Bytesˉslice(Stack, 0u32, 0u32);
    let Stackˉlength: u32 = Bytesˉlength(Stack);
    if Stackˉlength < 8u32 { return Invalid; }
    let Type: u32 = Bytesˉreadˉu32ˉlittle(Module, Instruction + 1u32);
    let Case: u32 = Bytesˉreadˉu32ˉlittle(Module, Instruction + 5u32);
    let Token: u32 = Bytesˉreadˉu32ˉlittle(Stack, Stackˉlength - 4u32);
    var Result: u32 = 0u32;
    if Token == 2147483648u32 + (Type + 1u32) * 256u32 + Case {
        Result = 1u32;
    }
    return Bytesˉconcat(
        Bytesˉslice(Stack, 0u32, Stackˉlength - 8u32),
        Bytesˉconcat(Bytesˉfromˉu32ˉlittle(Result), Zeroˉvalue)
    );
}

fn Defaultˉfieldˉvalue(
    Module: bytes,
    Typeˉoffsets: bytes,
    Shape: u32,
    Zeroˉcell: bytes
) -> bytes {
    let Kind: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(Module, Shape));
    if Kind == 7u32 {
        let Type: u32 = Bytesˉreadˉu32ˉlittle(Module, Shape + 1u32);
        return Bytesˉconcat(
            Bytesˉfromˉu32ˉlittle(4294967295u32),
            Bytesˉfromˉu32ˉlittle(Type + 1u32)
        );
    }
    if Kind == 8u32 {
        let Enumˉtype: u32 = Bytesˉreadˉu32ˉlittle(Module, Shape + 1u32);
        var Cursor: u32 = Bytesˉreadˉu32ˉlittle(
            Typeˉoffsets,
            Enumˉtype * 4u32
        ) + 1u32;
        Cursor = Cursor + 4u32 + Bytesˉreadˉu32ˉlittle(Module, Cursor) + 4u32;
        Cursor = Cursor + 4u32 + Bytesˉreadˉu32ˉlittle(Module, Cursor);
        return Bytesˉconcat(
            Bytesˉslice(Module, Cursor, 4u32),
            Bytesˉfromˉu32ˉlittle(Enumˉtype + 1u32)
        );
    }
    if Kind == 11u32 {
        let Variantˉtype: u32 = Bytesˉreadˉu32ˉlittle(Module, Shape + 1u32);
        return Bytesˉconcat(
            Bytesˉfromˉu32ˉlittle(4294967295u32),
            Bytesˉfromˉu32ˉlittle(
                2147483648u32 + (Variantˉtype + 1u32) * 256u32
            )
        );
    }
    if Kind == 22u32 {
        let Arrayˉtype: u32 = Bytesˉreadˉu32ˉlittle(Module, Shape + 1u32);
        return Bytesˉconcat(
            Bytesˉfromˉu32ˉlittle(4294967295u32),
            Bytesˉfromˉu32ˉlittle(Arrayˉtype + 1u32)
        );
    }
    return Zeroˉcell;
}

fn Retainˉdescriptor(
    Allocations: bytes,
    Allocationˉcount: u32,
    Value: bytes
) -> bytes {
    let Invalid: bytes = Bytesˉslice(Allocations, 0u32, 0u32);
    let Length: u32 = Bytesˉreadˉu32ˉlittle(Value, 4u32);
    if Length == 0u32 { return Allocations; }
    var Allocationˉindex: u32 = 4294967295u32;
    var Scan: u32 = 0u32;
    while Scan < Allocationˉcount {
        let Entry: u32 = Scan * 12u32;
        let References: u32 = Bytesˉreadˉu32ˉlittle(
            Allocations,
            Entry + 8u32
        );
        let Offset: u32 = Bytesˉreadˉu32ˉlittle(Allocations, Entry);
        let Allocationˉlength: u32 = Bytesˉreadˉu32ˉlittle(
            Allocations,
            Entry + 4u32
        );
        let Valueˉoffset: u32 = Bytesˉreadˉu32ˉlittle(Value, 0u32);
        if References > 0u32 && Valueˉoffset >= Offset {
            if Valueˉoffset - Offset <= Allocationˉlength {
                if Length <= Allocationˉlength - (Valueˉoffset - Offset) {
                    Allocationˉindex = Scan;
                    Scan = Allocationˉcount;
                }
            }
        }
        Scan = Scan + 1u32;
    }
    if Allocationˉindex == 4294967295u32 { return Invalid; }
    let Selectedˉentry: u32 = Allocationˉindex * 12u32;
    let Selectedˉreferences: u32 = Bytesˉreadˉu32ˉlittle(
        Allocations,
        Selectedˉentry + 8u32
    );
    if Selectedˉreferences == 4294967295u32 { return Invalid; }
    return Bytesˉconcat(
        Bytesˉconcat(
            Bytesˉslice(Allocations, 0u32, Selectedˉentry),
            Bytesˉconcat(
                Bytesˉslice(Allocations, Selectedˉentry, 8u32),
                Bytesˉfromˉu32ˉlittle(Selectedˉreferences + 1u32)
            )
        ),
        Bytesˉslice(
            Allocations,
            Selectedˉentry + 12u32,
            Bytesˉlength(Allocations) - Selectedˉentry - 12u32
        )
    );
}

fn Releaseˉdescriptor(
    Allocations: bytes,
    Allocationˉcount: u32,
    Value: bytes
) -> bytes {
    let Invalid: bytes = Bytesˉslice(Allocations, 0u32, 0u32);
    let Length: u32 = Bytesˉreadˉu32ˉlittle(Value, 4u32);
    if Length == 0u32 { return Allocations; }
    var Allocationˉindex: u32 = 4294967295u32;
    var Scan: u32 = 0u32;
    while Scan < Allocationˉcount {
        let Entry: u32 = Scan * 12u32;
        let References: u32 = Bytesˉreadˉu32ˉlittle(
            Allocations,
            Entry + 8u32
        );
        let Offset: u32 = Bytesˉreadˉu32ˉlittle(Allocations, Entry);
        let Allocationˉlength: u32 = Bytesˉreadˉu32ˉlittle(
            Allocations,
            Entry + 4u32
        );
        let Valueˉoffset: u32 = Bytesˉreadˉu32ˉlittle(Value, 0u32);
        if References > 0u32 && Valueˉoffset >= Offset {
            if Valueˉoffset - Offset <= Allocationˉlength {
                if Length <= Allocationˉlength - (Valueˉoffset - Offset) {
                    Allocationˉindex = Scan;
                    Scan = Allocationˉcount;
                }
            }
        }
        Scan = Scan + 1u32;
    }
    if Allocationˉindex == 4294967295u32 { return Invalid; }
    let Selectedˉentry: u32 = Allocationˉindex * 12u32;
    let Selectedˉreferences: u32 = Bytesˉreadˉu32ˉlittle(
        Allocations,
        Selectedˉentry + 8u32
    );
    if Selectedˉreferences == 0u32 { return Invalid; }
    return Bytesˉconcat(
        Bytesˉconcat(
            Bytesˉslice(Allocations, 0u32, Selectedˉentry),
            Bytesˉconcat(
                Bytesˉslice(Allocations, Selectedˉentry, 8u32),
                Bytesˉfromˉu32ˉlittle(Selectedˉreferences - 1u32)
            )
        ),
        Bytesˉslice(
            Allocations,
            Selectedˉentry + 12u32,
            Bytesˉlength(Allocations) - Selectedˉentry - 12u32
        )
    );
}

fn Descriptorˉallocationˉindex(
    Allocations: bytes,
    Allocationˉcount: u32,
    Value: bytes
) -> u32 {
    let Length: u32 = Bytesˉreadˉu32ˉlittle(Value, 4u32);
    if Length == 0u32 { return 4294967295u32; }
    let Valueˉoffset: u32 = Bytesˉreadˉu32ˉlittle(Value, 0u32);
    var Scan: u32 = 0u32;
    while Scan < Allocationˉcount {
        let Entry: u32 = Scan * 12u32;
        let References: u32 = Bytesˉreadˉu32ˉlittle(
            Allocations, Entry + 8u32
        );
        let Offset: u32 = Bytesˉreadˉu32ˉlittle(Allocations, Entry);
        let Allocationˉlength: u32 = Bytesˉreadˉu32ˉlittle(
            Allocations, Entry + 4u32
        );
        if References > 0u32 && Valueˉoffset >= Offset &&
            Valueˉoffset - Offset <= Allocationˉlength &&
            Length <= Allocationˉlength - (Valueˉoffset - Offset) {
            return Scan;
        }
        Scan = Scan + 1u32;
    }
    return 4294967295u32;
}

fn Replaceˉallocationˉlease(
    Leases: bytes,
    Allocationˉcount: u32,
    Index: u32,
    Lease: bytes
) -> bytes {
    let Invalid: bytes = Bytesˉslice(Leases, 0u32, 0u32);
    if Index >= Allocationˉcount || Bytesˉlength(Lease) != 28u32 ||
        Bytesˉlength(Leases) != Allocationˉcount * 28u32 {
        return Invalid;
    }
    let Offset: u32 = Index * 28u32;
    return Bytesˉconcat(
        Bytesˉconcat(Bytesˉslice(Leases, 0u32, Offset), Lease),
        Bytesˉslice(
            Leases, Offset + 28u32,
            Bytesˉlength(Leases) - Offset - 28u32
        )
    );
}

fn Zeroˉallocationˉleases(Count: u32, Zeroˉlease: bytes) -> bytes {
    let Empty: bytes = Bytesˉslice(Zeroˉlease, 0u32, 0u32);
    if Count > 4096u32 || Bytesˉlength(Zeroˉlease) != 28u32 {
        return Empty;
    }
    var Leases: bytes = Empty;
    var Slot: u32 = 0u32;
    while Slot < Count {
        Leases = Bytesˉconcat(Leases, Zeroˉlease);
        Slot = Slot + 1u32;
    }
    return Leases;
}

record Descriptorˉreleaseˉexecution {
    Valid: bool;
    State: bytes;
    Allocations: bytes;
    Leases: bytes;
}

fn Releaseˉdescriptorˉandˉlease(
    Initialˉstate: bytes,
    Initialˉallocations: bytes,
    Allocationˉcount: u32,
    Initialˉleases: bytes,
    Value: bytes,
    Zeroˉlease: bytes
) -> Descriptorˉreleaseˉexecution {
    let Invalid: Descriptorˉreleaseˉexecution =
        Descriptorˉreleaseˉexecution(
            false, Initialˉstate, Initialˉallocations, Initialˉleases
        );
    if Bytesˉlength(Value) != 8u32 ||
        Bytesˉlength(Initialˉallocations) != Allocationˉcount * 12u32 ||
        Bytesˉlength(Initialˉleases) != Allocationˉcount * 28u32 ||
        Bytesˉlength(Zeroˉlease) != 28u32 {
        return Invalid;
    }
    if Bytesˉreadˉu32ˉlittle(Value, 4u32) == 0u32 {
        return Descriptorˉreleaseˉexecution(
            true, Initialˉstate, Initialˉallocations, Initialˉleases
        );
    }
    let Index: u32 = Descriptorˉallocationˉindex(
        Initialˉallocations, Allocationˉcount, Value
    );
    if Index == 4294967295u32 { return Invalid; }
    let References: u32 = Bytesˉreadˉu32ˉlittle(
        Initialˉallocations, Index * 12u32 + 8u32
    );
    let Allocations: bytes = Releaseˉdescriptor(
        Initialˉallocations, Allocationˉcount, Value
    );
    if Bytesˉlength(Allocations) != Bytesˉlength(Initialˉallocations) {
        return Invalid;
    }
    var State: bytes = Initialˉstate;
    var Leases: bytes = Initialˉleases;
    if References == 1u32 {
        let Lease: bytes = Bytesˉslice(Leases, Index * 28u32, 28u32);
        if Bytesˉreadˉu32ˉlittle(Lease, 0u32) != 0u32 {
            let Released: Budgets.Memoryˉbudgetˉreleaseˉresult =
                Budgets.Releaseˉallocationˉlease(
                    State,
                    Lease,
                    Bytesˉreadˉu64ˉlittle(Lease, 8u32),
                    Bytesˉreadˉu64ˉlittle(Lease, 16u32),
                    Bytesˉreadˉu32ˉlittle(Lease, 24u32)
                );
            if !Released.Valid { return Invalid; }
            State = Released.State;
            Leases = Replaceˉallocationˉlease(
                Leases, Allocationˉcount, Index, Zeroˉlease
            );
            if Bytesˉlength(Leases) != Allocationˉcount * 28u32 {
                return Invalid;
            }
        }
    }
    return Descriptorˉreleaseˉexecution(
        true, State, Allocations, Leases
    );
}

fn Releaseˉdescriptorsˉandˉleases(
    Initialˉstate: bytes,
    Initialˉallocations: bytes,
    Allocationˉcount: u32,
    Initialˉleases: bytes,
    Values: bytes,
    Zeroˉlease: bytes
) -> Descriptorˉreleaseˉexecution {
    let Invalid: Descriptorˉreleaseˉexecution =
        Descriptorˉreleaseˉexecution(
            false, Initialˉstate, Initialˉallocations, Initialˉleases
        );
    if Bytesˉlength(Values) % 8u32 != 0u32 { return Invalid; }
    var State: bytes = Initialˉstate;
    var Allocations: bytes = Initialˉallocations;
    var Leases: bytes = Initialˉleases;
    var Cursor: u32 = 0u32;
    while Cursor < Bytesˉlength(Values) {
        let Released: Descriptorˉreleaseˉexecution =
            Releaseˉdescriptorˉandˉlease(
                State,
                Allocations,
                Allocationˉcount,
                Leases,
                Bytesˉslice(Values, Cursor, 8u32),
                Zeroˉlease
            );
        if !Released.Valid { return Invalid; }
        State = Released.State;
        Allocations = Released.Allocations;
        Leases = Released.Leases;
        Cursor = Cursor + 8u32;
    }
    return Descriptorˉreleaseˉexecution(
        true, State, Allocations, Leases
    );
}

fn Leasedˉdescriptorˉfromˉrecord(
    Records: bytes,
    Allocations: bytes,
    Allocationˉcount: u32,
    Leases: bytes,
    Handle: bytes
) -> bytes {
    let Empty: bytes = Bytesˉslice(Handle, 0u32, 0u32);
    let Slot: u32 = Bytesˉreadˉu32ˉlittle(Handle, 0u32);
    let Owner: u32 = Bytesˉreadˉu32ˉlittle(Handle, 4u32);
    if Slot == 4294967295u32 || Owner < 2147483648u32 ||
        (Owner & 255u32) != 0u32 || Slot >= Bytesˉlength(Records) / 8u32 ||
        Bytesˉlength(Leases) != Allocationˉcount * 28u32 {
        return Empty;
    }
    let Candidate: bytes = Bytesˉslice(Records, Slot * 8u32, 8u32);
    let Index: u32 = Descriptorˉallocationˉindex(
        Allocations, Allocationˉcount, Candidate
    );
    if Index == 4294967295u32 || Bytesˉreadˉu32ˉlittle(
        Leases, Index * 28u32
    ) == 0u32 {
        return Empty;
    }
    return Candidate;
}

record Heapˉallocationˉresult {
    Valid: bool;
    Succeeded: bool;
    Descriptor: bytes;
    Heap: bytes;
    Allocations: bytes;
    Count: u32;
    Index: u32;
}

fn Allocateˉheapˉvalue(
    Initialˉheap: bytes,
    Initialˉallocations: bytes,
    Initialˉcount: u32,
    Value: bytes
) -> Heapˉallocationˉresult {
    let Empty: bytes = Bytesˉslice(Initialˉheap, 0u32, 0u32);
    let Invalid: Heapˉallocationˉresult = Heapˉallocationˉresult(
        false, false, Empty, Initialˉheap, Initialˉallocations,
        Initialˉcount, 4294967295u32
    );
    if Bytesˉlength(Initialˉallocations) != Initialˉcount * 12u32 {
        return Invalid;
    }
    let Length: u32 = Bytesˉlength(Value);
    if Length == 0u32 || Length > 65536u32 {
        return Invalid;
    }
    var Offset: u32 = 0u32;
    var Searching: bool = true;
    while Searching {
        var Nearestˉoffset: u32 = 65536u32;
        var Nearestˉlength: u32 = 0u32;
        var Spaceˉscan: u32 = 0u32;
        while Spaceˉscan < Initialˉcount {
            let Spaceˉentry: u32 = Spaceˉscan * 12u32;
            if Bytesˉreadˉu32ˉlittle(
                Initialˉallocations, Spaceˉentry + 8u32
            ) > 0u32 {
                let Candidateˉoffset: u32 = Bytesˉreadˉu32ˉlittle(
                    Initialˉallocations, Spaceˉentry
                );
                if Candidateˉoffset >= Offset &&
                    Candidateˉoffset < Nearestˉoffset {
                    Nearestˉoffset = Candidateˉoffset;
                    Nearestˉlength = Bytesˉreadˉu32ˉlittle(
                        Initialˉallocations, Spaceˉentry + 4u32
                    );
                }
            }
            Spaceˉscan = Spaceˉscan + 1u32;
        }
        if Length <= Nearestˉoffset - Offset {
            Searching = false;
        } else if Nearestˉoffset == 65536u32 {
            return Heapˉallocationˉresult(
                true, false, Empty, Initialˉheap, Initialˉallocations,
                Initialˉcount, 4294967295u32
            );
        } else {
            Offset = Nearestˉoffset + Nearestˉlength;
            if Offset > 65536u32 - Length {
                return Heapˉallocationˉresult(
                    true, false, Empty, Initialˉheap, Initialˉallocations,
                    Initialˉcount, 4294967295u32
                );
            }
        }
    }

    let End: u32 = Offset + Length;
    let Heapˉlength: u32 = Bytesˉlength(Initialˉheap);
    var Heap: bytes = Bytesˉconcat(
        Bytesˉslice(Initialˉheap, 0u32, Offset), Value
    );
    if End < Heapˉlength {
        Heap = Bytesˉconcat(
            Heap, Bytesˉslice(Initialˉheap, End, Heapˉlength - End)
        );
    }
    var Index: u32 = Initialˉcount;
    var Metadataˉscan: u32 = 0u32;
    while Metadataˉscan < Initialˉcount {
        if Bytesˉreadˉu32ˉlittle(
            Initialˉallocations, Metadataˉscan * 12u32 + 8u32
        ) == 0u32 {
            Index = Metadataˉscan;
            Metadataˉscan = Initialˉcount;
        }
        Metadataˉscan = Metadataˉscan + 1u32;
    }
    let Entryˉvalue: bytes = Bytesˉconcat(
        Bytesˉfromˉu32ˉlittle(Offset),
        Bytesˉconcat(
            Bytesˉfromˉu32ˉlittle(Length),
            Bytesˉfromˉu32ˉlittle(1u32)
        )
    );
    var Allocations: bytes = Initialˉallocations;
    var Count: u32 = Initialˉcount;
    if Index == Initialˉcount {
        if Initialˉcount >= 4096u32 { return Invalid; }
        Allocations = Bytesˉconcat(Allocations, Entryˉvalue);
        Count = Count + 1u32;
    } else {
        let Metadataˉentry: u32 = Index * 12u32;
        Allocations = Bytesˉconcat(
            Bytesˉconcat(
                Bytesˉslice(Allocations, 0u32, Metadataˉentry), Entryˉvalue
            ),
            Bytesˉslice(
                Allocations, Metadataˉentry + 12u32,
                Bytesˉlength(Allocations) - Metadataˉentry - 12u32
            )
        );
    }
    return Heapˉallocationˉresult(
        true, true,
        Bytesˉconcat(
            Bytesˉfromˉu32ˉlittle(Offset),
            Bytesˉfromˉu32ˉlittle(Length)
        ),
        Heap, Allocations, Count, Index
    );
}

fn Evaluateˉi32ˉbasic(Opcode: u32, Left: i32, Right: i32) -> i32 {
    if Opcode == 16u32 { return Left + Right; }
    if Opcode == 17u32 { return Left - Right; }
    return Left * Right;
}

fn Evaluateˉu32ˉbasic(Opcode: u32, Left: u32, Right: u32) -> u32 {
    if Opcode == 20u32 { return Left + Right; }
    if Opcode == 21u32 { return Left - Right; }
    return Left * Right;
}

fn Evaluateˉbytesˉread(
    Heap: bytes,
    Opcode: u32,
    Sourceˉoffset: u32,
    Sourceˉlength: u32,
    Offset: u32
) -> bytes {
    var Width: u32 = 1u32;
    if Opcode == 14u32 { Width = 2u32; }
    if Opcode == 15u32 { Width = 4u32; }
    if Offset > Sourceˉlength || Width > Sourceˉlength - Offset {
        return Bytesˉconcat(
            Bytesˉfromˉu32ˉlittle(3008u32),
            Bytesˉfromˉu32ˉlittle(0u32)
        );
    }
    var Value: u32 = 0u32;
    if Opcode == 13u32 {
        Value = U32ˉfromˉu8(Bytesˉreadˉu8(Heap, Sourceˉoffset + Offset));
    }
    if Opcode == 14u32 {
        Value = Bytesˉreadˉu16ˉlittle(Heap, Sourceˉoffset + Offset);
    }
    if Opcode == 15u32 {
        Value = Bytesˉreadˉu32ˉlittle(Heap, Sourceˉoffset + Offset);
    }
    return Bytesˉconcat(
        Bytesˉfromˉu32ˉlittle(0u32),
        Bytesˉfromˉu32ˉlittle(Value)
    );
}

fn Evaluateˉu32ˉextended(
    Opcode: u32,
    Left: u32,
    Right: u32
) -> bytes {
    if (Opcode == 161u32 || Opcode == 162u32) && Right == 0u32 {
        return Bytesˉconcat(
            Bytesˉfromˉu32ˉlittle(3032u32),
            Bytesˉfromˉu32ˉlittle(0u32)
        );
    }
    if (Opcode == 177u32 || Opcode == 178u32) && Right >= 32u32 {
        return Bytesˉconcat(
            Bytesˉfromˉu32ˉlittle(3033u32),
            Bytesˉfromˉu32ˉlittle(0u32)
        );
    }
    var Value: u32 = 0u32;
    if Opcode == 161u32 { Value = Left / Right; }
    if Opcode == 162u32 { Value = Left % Right; }
    if Opcode == 173u32 { Value = Left & Right; }
    if Opcode == 174u32 { Value = Left | Right; }
    if Opcode == 175u32 { Value = Left ^ Right; }
    if Opcode == 177u32 { Value = Left << Right; }
    if Opcode == 178u32 { Value = Left >> Right; }
    return Bytesˉconcat(
        Bytesˉfromˉu32ˉlittle(0u32),
        Bytesˉfromˉu32ˉlittle(Value)
    );
}

fn Evaluateˉi32ˉdivision(Left: u32, Right: u32) -> bytes {
    if Right == 0u32 ||
        (Left == 2147483648u32 && Right == 4294967295u32) {
        return Bytesˉconcat(
            Bytesˉfromˉu32ˉlittle(3007u32),
            Bytesˉconcat(
                Bytesˉfromˉu32ˉlittle(0u32),
                Bytesˉfromˉu32ˉlittle(0u32)
            )
        );
    }
    let Leftˉnegative: bool = Left >= 2147483648u32;
    let Rightˉnegative: bool = Right >= 2147483648u32;
    var Dividend: u32 = Left;
    var Divisor: u32 = Right;
    if Leftˉnegative { Dividend = (~Left) + 1u32; }
    if Rightˉnegative { Divisor = (~Right) + 1u32; }
    var Quotient: u32 = Dividend / Divisor;
    var Remainder: u32 = Dividend % Divisor;
    if Leftˉnegative != Rightˉnegative && Quotient != 0u32 {
        Quotient = (~Quotient) + 1u32;
    }
    if Leftˉnegative && Remainder != 0u32 {
        Remainder = (~Remainder) + 1u32;
    }
    return Bytesˉconcat(
        Bytesˉfromˉu32ˉlittle(0u32),
        Bytesˉconcat(
            Bytesˉfromˉu32ˉlittle(Quotient),
            Bytesˉfromˉu32ˉlittle(Remainder)
        )
    );
}

fn Isˉbaseˉnumeric(Opcode: u32) -> bool {
    if Opcode >= 16u32 && Opcode <= 22u32 { return true; }
    if Opcode >= 159u32 && Opcode <= 162u32 { return true; }
    return Opcode >= 173u32 && Opcode <= 178u32;
}

fn Executeˉbaseˉnumeric(
    Opcode: u32,
    Inputˉstack: bytes,
    Zeroˉvalue: bytes
) -> bytes {
    var Operands: u32 = 2u32;
    if Opcode == 19u32 || Opcode == 176u32 { Operands = 1u32; }
    if Bytesˉlength(Inputˉstack) < Operands * 8u32 {
        return Bytesˉslice(Inputˉstack, 0u32, 0u32);
    }
    var Stack: bytes = Inputˉstack;
    var Stackˉlength: u32 = Bytesˉlength(Stack);
    let Rightˉraw: u32 = Bytesˉreadˉu32ˉlittle(
        Stack, Stackˉlength - 8u32
    );
    Stack = Bytesˉslice(Stack, 0u32, Stackˉlength - 8u32);
    var Leftˉraw: u32 = Rightˉraw;
    if Operands == 2u32 {
        Stackˉlength = Bytesˉlength(Stack);
        Leftˉraw = Bytesˉreadˉu32ˉlittle(Stack, Stackˉlength - 8u32);
        Stack = Bytesˉslice(Stack, 0u32, Stackˉlength - 8u32);
    }
    var Status: u32 = 0u32;
    var Value: u32 = 0u32;
    if Opcode >= 16u32 && Opcode <= 18u32 {
        let Leftˉsigned: i32 = Bytesˉreadˉi32ˉlittle(
            Bytesˉfromˉu32ˉlittle(Leftˉraw), 0u32
        );
        let Rightˉsigned: i32 = Bytesˉreadˉi32ˉlittle(
            Bytesˉfromˉu32ˉlittle(Rightˉraw), 0u32
        );
        Value = Bytesˉreadˉu32ˉlittle(
            Bytesˉfromˉi32ˉlittle(Evaluateˉi32ˉbasic(
                Opcode, Leftˉsigned, Rightˉsigned
            )),
            0u32
        );
    }
    if Opcode == 19u32 {
        let Negatedˉsigned: i32 = Bytesˉreadˉi32ˉlittle(
            Bytesˉfromˉu32ˉlittle(Leftˉraw), 0u32
        );
        Value = Bytesˉreadˉu32ˉlittle(
            Bytesˉfromˉi32ˉlittle(-Negatedˉsigned), 0u32
        );
    }
    if Opcode >= 20u32 && Opcode <= 22u32 {
        Value = Evaluateˉu32ˉbasic(Opcode, Leftˉraw, Rightˉraw);
    }
    if Opcode == 159u32 || Opcode == 160u32 {
        let Division: bytes = Evaluateˉi32ˉdivision(
            Leftˉraw, Rightˉraw
        );
        Status = Bytesˉreadˉu32ˉlittle(Division, 0u32);
        Value = Bytesˉreadˉu32ˉlittle(Division, 4u32);
        if Opcode == 160u32 {
            Value = Bytesˉreadˉu32ˉlittle(Division, 8u32);
        }
    }
    if Opcode == 161u32 || Opcode == 162u32 ||
        (Opcode >= 173u32 && Opcode <= 175u32) ||
        Opcode == 177u32 || Opcode == 178u32 {
        let Extended: bytes = Evaluateˉu32ˉextended(
            Opcode, Leftˉraw, Rightˉraw
        );
        Status = Bytesˉreadˉu32ˉlittle(Extended, 0u32);
        Value = Bytesˉreadˉu32ˉlittle(Extended, 4u32);
    }
    if Opcode == 176u32 { Value = ~Leftˉraw; }
    if Status == 0u32 {
        Stack = Bytesˉconcat(
            Stack,
            Bytesˉconcat(Bytesˉfromˉu32ˉlittle(Value), Zeroˉvalue)
        );
    }
    return Bytesˉconcat(Bytesˉfromˉu32ˉlittle(Status), Stack);
}

record Numericˉinstructionˉexecution {
    Valid: bool;
    Handled: bool;
    Status: u32;
    Stack: bytes;
}

fn Executeˉhighˉnumericˉinstruction(
    Opcode: u32,
    Inputˉstack: bytes,
    Zeroˉvalue: bytes
) -> Numericˉinstructionˉexecution {
    let Handled: bool = Isˉbaseˉnumeric(Opcode);
    if !Handled {
        return Numericˉinstructionˉexecution(
            true, false, 0u32, Inputˉstack
        );
    }
    let Result: bytes = Executeˉbaseˉnumeric(
        Opcode, Inputˉstack, Zeroˉvalue
    );
    if Bytesˉlength(Result) < 4u32 {
        return Numericˉinstructionˉexecution(
            false, true, 0u32, Inputˉstack
        );
    }
    return Numericˉinstructionˉexecution(
        true,
        true,
        Bytesˉreadˉu32ˉlittle(Result, 0u32),
        Bytesˉslice(Result, 4u32, Bytesˉlength(Result) - 4u32)
    );
}

fn Executeˉbaseˉcomparison(
    Opcode: u32,
    Inputˉstack: bytes,
    Zeroˉvalue: bytes
) -> bytes {
    var Operands: u32 = 2u32;
    if Opcode == 40u32 { Operands = 1u32; }
    if Bytesˉlength(Inputˉstack) < Operands * 8u32 {
        return Bytesˉslice(Inputˉstack, 0u32, 0u32);
    }
    var Stack: bytes = Inputˉstack;
    var Stackˉlength: u32 = Bytesˉlength(Stack);
    let Rightˉraw: u32 = Bytesˉreadˉu32ˉlittle(
        Stack, Stackˉlength - 8u32
    );
    Stack = Bytesˉslice(Stack, 0u32, Stackˉlength - 8u32);
    var Leftˉraw: u32 = Rightˉraw;
    if Operands == 2u32 {
        Stackˉlength = Bytesˉlength(Stack);
        Leftˉraw = Bytesˉreadˉu32ˉlittle(Stack, Stackˉlength - 8u32);
        Stack = Bytesˉslice(Stack, 0u32, Stackˉlength - 8u32);
    }
    var Matches: bool = false;
    if Opcode >= 32u32 && Opcode <= 37u32 {
        let Leftˉsigned: i32 = Bytesˉreadˉi32ˉlittle(
            Bytesˉfromˉu32ˉlittle(Leftˉraw), 0u32
        );
        let Rightˉsigned: i32 = Bytesˉreadˉi32ˉlittle(
            Bytesˉfromˉu32ˉlittle(Rightˉraw), 0u32
        );
        if Opcode == 32u32 { Matches = Leftˉsigned == Rightˉsigned; }
        if Opcode == 33u32 { Matches = Leftˉsigned != Rightˉsigned; }
        if Opcode == 34u32 { Matches = Leftˉsigned < Rightˉsigned; }
        if Opcode == 35u32 { Matches = Leftˉsigned <= Rightˉsigned; }
        if Opcode == 36u32 { Matches = Leftˉsigned > Rightˉsigned; }
        if Opcode == 37u32 { Matches = Leftˉsigned >= Rightˉsigned; }
    }
    if Opcode == 38u32 || Opcode == 96u32 || Opcode == 102u32 {
        Matches = Leftˉraw == Rightˉraw;
    }
    if Opcode == 39u32 || Opcode == 97u32 || Opcode == 103u32 {
        Matches = Leftˉraw != Rightˉraw;
    }
    if Opcode == 40u32 { Matches = Leftˉraw == 0u32; }
    if Opcode == 98u32 { Matches = Leftˉraw < Rightˉraw; }
    if Opcode == 99u32 { Matches = Leftˉraw <= Rightˉraw; }
    if Opcode == 100u32 { Matches = Leftˉraw > Rightˉraw; }
    if Opcode == 101u32 { Matches = Leftˉraw >= Rightˉraw; }
    var Value: u32 = 0u32;
    if Matches { Value = 1u32; }
    return Bytesˉconcat(
        Stack,
        Bytesˉconcat(Bytesˉfromˉu32ˉlittle(Value), Zeroˉvalue)
    );
}

record Executionˉrequest {
    Valid: bool;
    Major: u32;
    Maximumˉinstructions: u32;
    Maximumˉcallˉdepth: u32;
    Module: bytes;
    Moduleˉminor: u32;
    Guestˉinput: bytes;
    Data: u32;
    Functions: u32;
    Functionsˉend: u32;
    Code: u32;
    Typeˉcount: u32;
    Functionˉcount: u32;
    Mainˉindex: u32;
    Typeˉoffsets: bytes;
    Capabilities: u32;
    Capabilityˉgrants: u32;
    Standardˉoutputˉlimit: u32;
    Diagnosticˉoutputˉlimit: u32;
    Argumentˉcount: u32;
    Argumentˉoffsets: bytes;
    Declaredˉcapabilities: u32;
    Capabilityˉkinds: bytes;
    Sourceˉgeneration: u32;
    Taskˉcontextˉgeneration: u32;
    Taskˉclockˉgeneration: u64;
    Taskˉdeadline: u64;
    Taskˉexpectedˉruntimeˉgeneration: u64;
    Taskˉadmittedˉruntimeˉgeneration: u64;
    Taskˉobservationˉtick: u64;
    Taskˉobservedˉruntimeˉgeneration: u64;
    Requestˉminor: u32;
}

fn Invalidˉexecutionˉrequest(Request: bytes) -> Executionˉrequest {
    let Empty: bytes = Bytesˉslice(Request, 0u32, 0u32);
    return Executionˉrequest(
        false, 0u32, 0u32, 0u32, Empty, 0u32, Empty,
        0u32, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32, Empty,
        0u32, 0u32, 0u32, 0u32, 0u32, Empty, 0u32, Empty,
        0u32, 0u32, 0u64, 0u64, 0u64, 0u64, 0u64, 0u64, 0u32
    );
}

fn Readˉexecutionˉrequest(Request: bytes) -> Executionˉrequest {
    let Preflight: bytes = Envelopeˉreader.Interpreterˉenvelope(Request);
    if Bytesˉlength(Preflight) < 64u32 {
        return Invalidˉexecutionˉrequest(Request);
    }
    let Major: u32 = Bytesˉreadˉu32ˉlittle(Preflight, 0u32);
    let Maximumˉinstructions: u32 = Bytesˉreadˉu32ˉlittle(Preflight, 4u32);
    let Maximumˉcallˉdepth: u32 = Bytesˉreadˉu32ˉlittle(Preflight, 8u32);
    let Module: bytes = Bytesˉslice(
        Request,
        Bytesˉreadˉu32ˉlittle(Preflight, 12u32),
        Bytesˉreadˉu32ˉlittle(Preflight, 16u32)
    );
    let Moduleˉminor: u32 = Bytesˉreadˉu16ˉlittle(Module, 6u32);
    let Guestˉinput: bytes = Bytesˉslice(
        Request,
        Bytesˉreadˉu32ˉlittle(Preflight, 20u32),
        Bytesˉreadˉu32ˉlittle(Preflight, 24u32)
    );
    let Data: u32 = Bytesˉreadˉu32ˉlittle(Preflight, 28u32);
    let Functions: u32 = Bytesˉreadˉu32ˉlittle(Preflight, 32u32);
    let Functionsˉend: u32 = Bytesˉreadˉu32ˉlittle(Preflight, 36u32);
    let Code: u32 = Bytesˉreadˉu32ˉlittle(Preflight, 40u32);
    let Typeˉcount: u32 = Bytesˉreadˉu32ˉlittle(Preflight, 48u32);
    let Functionˉcount: u32 = Bytesˉreadˉu32ˉlittle(Preflight, 52u32);
    let Mainˉindex: u32 = Bytesˉreadˉu32ˉlittle(Preflight, 56u32);
    let Typeˉoffsetsˉlength: u32 = Bytesˉreadˉu32ˉlittle(Preflight, 60u32);
    if Typeˉoffsetsˉlength != Typeˉcount * 4u32 {
        return Invalidˉexecutionˉrequest(Request);
    }
    let Empty: bytes = Bytesˉslice(Request, 0u32, 0u32);
    var Capabilities: u32 = 0u32;
    var Capabilityˉgrants: u32 = 0u32;
    var Standardˉoutputˉlimit: u32 = 0u32;
    var Diagnosticˉoutputˉlimit: u32 = 0u32;
    var Argumentˉcount: u32 = 0u32;
    var Argumentˉoffsets: bytes = Empty;
    var Declaredˉcapabilities: u32 = 0u32;
    var Capabilityˉkinds: bytes = Empty;
    var Sourceˉrights: u32 = 0u32;
    var Sourceˉgeneration: u32 = 0u32;
    var Sourceˉresourceˉgeneration: u32 = 0u32;
    var Taskˉcontextˉgeneration: u32 = 0u32;
    var Taskˉclockˉgeneration: u64 = 0u64;
    var Taskˉdeadline: u64 = 0u64;
    var Taskˉexpectedˉruntimeˉgeneration: u64 = 0u64;
    var Taskˉadmittedˉruntimeˉgeneration: u64 = 0u64;
    var Taskˉobservationˉtick: u64 = 0u64;
    var Taskˉobservedˉruntimeˉgeneration: u64 = 0u64;
    var Requestˉminor: u32 = 0u32;
    var Typeˉoffsetsˉoffset: u32 = 64u32;
    if Major == 3u32 {
        if Bytesˉlength(Preflight) < 84u32 {
            return Invalidˉexecutionˉrequest(Request);
        }
        Capabilities = Bytesˉreadˉu32ˉlittle(Preflight, 64u32);
        Capabilityˉgrants = Bytesˉreadˉu32ˉlittle(Preflight, 68u32);
        Standardˉoutputˉlimit = Bytesˉreadˉu32ˉlittle(Preflight, 72u32);
        Declaredˉcapabilities = Bytesˉreadˉu32ˉlittle(Preflight, 76u32);
        let Capabilityˉkindsˉlength: u32 = Bytesˉreadˉu32ˉlittle(
            Preflight, 80u32
        );
        Typeˉoffsetsˉoffset = 84u32 + Capabilityˉkindsˉlength;
        if Bytesˉlength(Preflight)
            != Typeˉoffsetsˉoffset + Typeˉoffsetsˉlength {
            return Invalidˉexecutionˉrequest(Request);
        }
        Capabilityˉkinds = Bytesˉslice(
            Preflight, 84u32, Capabilityˉkindsˉlength
        );
    } else if Major == 4u32 {
        if Bytesˉlength(Preflight) < 92u32 {
            return Invalidˉexecutionˉrequest(Request);
        }
        Capabilities = Bytesˉreadˉu32ˉlittle(Preflight, 64u32);
        Capabilityˉgrants = Bytesˉreadˉu32ˉlittle(Preflight, 68u32);
        Standardˉoutputˉlimit = Bytesˉreadˉu32ˉlittle(Preflight, 72u32);
        Diagnosticˉoutputˉlimit = Bytesˉreadˉu32ˉlittle(Preflight, 76u32);
        Argumentˉcount = Bytesˉreadˉu32ˉlittle(Preflight, 80u32);
        Declaredˉcapabilities = Bytesˉreadˉu32ˉlittle(Preflight, 84u32);
        let Scriptˉcapabilityˉkindsˉlength: u32 = Bytesˉreadˉu32ˉlittle(
            Preflight, 88u32
        );
        Typeˉoffsetsˉoffset = 92u32 + Scriptˉcapabilityˉkindsˉlength
            + Argumentˉcount * 4u32;
        if Bytesˉlength(Preflight)
            != Typeˉoffsetsˉoffset + Typeˉoffsetsˉlength {
            return Invalidˉexecutionˉrequest(Request);
        }
        Capabilityˉkinds = Bytesˉslice(
            Preflight, 92u32, Scriptˉcapabilityˉkindsˉlength
        );
        Argumentˉoffsets = Bytesˉslice(
            Preflight,
            92u32 + Scriptˉcapabilityˉkindsˉlength,
            Argumentˉcount * 4u32
        );
    } else if Major == 5u32 {
        Typeˉoffsetsˉoffset = 76u32;
        if Bytesˉlength(Preflight)
            != Typeˉoffsetsˉoffset + Typeˉoffsetsˉlength {
            return Invalidˉexecutionˉrequest(Request);
        }
        Sourceˉrights = Bytesˉreadˉu32ˉlittle(Preflight, 64u32);
        Sourceˉgeneration = Bytesˉreadˉu32ˉlittle(
            Preflight, 68u32
        );
        Sourceˉresourceˉgeneration = Bytesˉreadˉu32ˉlittle(
            Preflight, 72u32
        );
        if Sourceˉrights != 1u32 || Sourceˉgeneration == 0u32 ||
            Sourceˉresourceˉgeneration != Sourceˉgeneration {
            return Invalidˉexecutionˉrequest(Request);
        }
    } else if Major == 6u32 {
        if Bytesˉlength(Preflight) < 124u32 ||
            Bytesˉreadˉu32ˉlittle(Preflight, 68u32) != 0u32 {
            return Invalidˉexecutionˉrequest(Request);
        }
        Taskˉcontextˉgeneration = Bytesˉreadˉu32ˉlittle(
            Preflight, 64u32
        );
        Taskˉclockˉgeneration = Bytesˉreadˉu64ˉlittle(Preflight, 72u32);
        Taskˉdeadline = Bytesˉreadˉu64ˉlittle(Preflight, 80u32);
        Taskˉexpectedˉruntimeˉgeneration = Bytesˉreadˉu64ˉlittle(
            Preflight, 88u32
        );
        Taskˉadmittedˉruntimeˉgeneration = Bytesˉreadˉu64ˉlittle(
            Preflight, 96u32
        );
        Taskˉobservationˉtick = Bytesˉreadˉu64ˉlittle(
            Preflight, 104u32
        );
        Taskˉobservedˉruntimeˉgeneration = Bytesˉreadˉu64ˉlittle(
            Preflight, 112u32
        );
        Requestˉminor = Bytesˉreadˉu32ˉlittle(Preflight, 120u32);
        if Requestˉminor == 1u32 {
            Typeˉoffsetsˉoffset = 124u32;
        } else if Requestˉminor == 2u32 {
            if Bytesˉlength(Preflight) < 144u32 {
                return Invalidˉexecutionˉrequest(Request);
            }
            Capabilities = Bytesˉreadˉu32ˉlittle(Preflight, 124u32);
            Capabilityˉgrants = Bytesˉreadˉu32ˉlittle(Preflight, 128u32);
            Standardˉoutputˉlimit = Bytesˉreadˉu32ˉlittle(
                Preflight, 132u32
            );
            Declaredˉcapabilities = Bytesˉreadˉu32ˉlittle(
                Preflight, 136u32
            );
            let Taskˉcapabilityˉkindsˉlength: u32 =
                Bytesˉreadˉu32ˉlittle(Preflight, 140u32);
            Typeˉoffsetsˉoffset = 144u32 + Taskˉcapabilityˉkindsˉlength;
            if Taskˉcapabilityˉkindsˉlength != 1u32 ||
                Typeˉoffsetsˉoffset > Bytesˉlength(Preflight) {
                return Invalidˉexecutionˉrequest(Request);
            }
            Capabilityˉkinds = Bytesˉslice(
                Preflight, 144u32, Taskˉcapabilityˉkindsˉlength
            );
        } else {
            return Invalidˉexecutionˉrequest(Request);
        }
        if Bytesˉlength(Preflight)
            != Typeˉoffsetsˉoffset + Typeˉoffsetsˉlength {
            return Invalidˉexecutionˉrequest(Request);
        }
        if Taskˉcontextˉgeneration == 0u32 ||
            Taskˉclockˉgeneration == 0u64 ||
            Taskˉexpectedˉruntimeˉgeneration == 0u64 {
            return Invalidˉexecutionˉrequest(Request);
        }
    } else if Bytesˉlength(Preflight) != 64u32 + Typeˉoffsetsˉlength {
        return Invalidˉexecutionˉrequest(Request);
    }
    let Typeˉoffsets: bytes = Bytesˉslice(
        Preflight, Typeˉoffsetsˉoffset, Typeˉoffsetsˉlength
    );
    return Executionˉrequest(
        true, Major, Maximumˉinstructions, Maximumˉcallˉdepth,
        Module, Moduleˉminor, Guestˉinput, Data, Functions, Functionsˉend,
        Code, Typeˉcount, Functionˉcount, Mainˉindex, Typeˉoffsets,
        Capabilities, Capabilityˉgrants, Standardˉoutputˉlimit,
        Diagnosticˉoutputˉlimit, Argumentˉcount, Argumentˉoffsets,
        Declaredˉcapabilities, Capabilityˉkinds, Sourceˉgeneration,
        Taskˉcontextˉgeneration, Taskˉclockˉgeneration, Taskˉdeadline,
        Taskˉexpectedˉruntimeˉgeneration,
        Taskˉadmittedˉruntimeˉgeneration, Taskˉobservationˉtick,
        Taskˉobservedˉruntimeˉgeneration, Requestˉminor
    );
}

fn Capabilityˉdeniedˉresponse(Major: u32, Minor: u32) -> bytes {
    let Zero: bytes = Bytesˉfromˉu32ˉlittle(0u32);
    var Response: bytes = Bytesˉfromˉu32ˉlittle(1331189335u32);
    Response = Bytesˉconcat(Response, Bytesˉfromˉu16ˉlittle(Major));
    Response = Bytesˉconcat(Response, Bytesˉfromˉu16ˉlittle(Minor));
    Response = Bytesˉconcat(Response, Bytesˉfromˉu32ˉlittle(3010u32));
    Response = Bytesˉconcat(Response, Zero);
    Response = Bytesˉconcat(Response, Zero);
    Response = Bytesˉconcat(Response, Zero);
    Response = Bytesˉconcat(Response, Zero);
    return Response;
}

fn Failureˉresponse(
    Major: u32,
    Minor: u32,
    Status: u32,
    Executed: u32,
    Standardˉoutput: bytes,
    Diagnosticˉoutput: bytes
) -> bytes {
    let Zero: bytes = Bytesˉfromˉu32ˉlittle(0u32);
    var Response: bytes = Bytesˉfromˉu32ˉlittle(1331189335u32);
    Response = Bytesˉconcat(Response, Bytesˉfromˉu16ˉlittle(Major));
    Response = Bytesˉconcat(Response, Bytesˉfromˉu16ˉlittle(Minor));
    Response = Bytesˉconcat(Response, Bytesˉfromˉu32ˉlittle(Status));
    Response = Bytesˉconcat(Response, Bytesˉfromˉu32ˉlittle(Executed));
    Response = Bytesˉconcat(Response, Zero);
    if Major == 3u32 || Major == 4u32 ||
        (Major == 6u32 && Minor == 2u32) {
        Response = Bytesˉconcat(
            Response,
            Bytesˉfromˉu32ˉlittle(Bytesˉlength(Standardˉoutput))
        );
        Response = Bytesˉconcat(
            Response,
            Bytesˉfromˉu32ˉlittle(Bytesˉlength(Diagnosticˉoutput))
        );
        Response = Bytesˉconcat(Response, Standardˉoutput);
        Response = Bytesˉconcat(Response, Diagnosticˉoutput);
    }
    return Response;
}

record Stackˉtracking {
    Valid: bool;
    Descriptorˉlow: u32;
    Descriptorˉhigh: u32;
    Recordˉlow: u32;
    Recordˉhigh: u32;
    Collectionˉlow: u32;
    Collectionˉhigh: u32;
    Vectorˉlow: u32;
    Vectorˉhigh: u32;
}

fn Updateˉstackˉtracking(
    Consumed: u32,
    Descriptorˉcount: u32,
    Produced: bool,
    Producedˉkind: u32,
    Stackˉlength: u32,
    Initialˉdescriptorˉlow: u32,
    Initialˉdescriptorˉhigh: u32,
    Initialˉrecordˉlow: u32,
    Initialˉrecordˉhigh: u32,
    Initialˉcollectionˉlow: u32,
    Initialˉcollectionˉhigh: u32,
    Initialˉvectorˉlow: u32,
    Initialˉvectorˉhigh: u32
) -> Stackˉtracking {
    var Descriptorˉlow: u32 = Initialˉdescriptorˉlow;
    var Descriptorˉhigh: u32 = Initialˉdescriptorˉhigh;
    var Recordˉlow: u32 = Initialˉrecordˉlow;
    var Recordˉhigh: u32 = Initialˉrecordˉhigh;
    var Collectionˉlow: u32 = Initialˉcollectionˉlow;
    var Collectionˉhigh: u32 = Initialˉcollectionˉhigh;
    var Vectorˉlow: u32 = Initialˉvectorˉlow;
    var Vectorˉhigh: u32 = Initialˉvectorˉhigh;
    if Consumed > Descriptorˉcount {
        return Stackˉtracking(
            false, Descriptorˉlow, Descriptorˉhigh,
            Recordˉlow, Recordˉhigh, Collectionˉlow, Collectionˉhigh,
            Vectorˉlow, Vectorˉhigh
        );
    }
    let Remaining: u32 = Descriptorˉcount - Consumed;
    if Remaining < 32u32 {
        var Mask: u32 = 0u32;
        if Remaining > 0u32 { Mask = (1u32 << Remaining) - 1u32; }
        Descriptorˉlow = Descriptorˉlow & Mask;
        Descriptorˉhigh = 0u32;
        Recordˉlow = Recordˉlow & Mask;
        Recordˉhigh = 0u32;
        Collectionˉlow = Collectionˉlow & Mask;
        Collectionˉhigh = 0u32;
        Vectorˉlow = Vectorˉlow & Mask;
        Vectorˉhigh = 0u32;
    }
    if Remaining == 32u32 {
        Descriptorˉhigh = 0u32;
        Recordˉhigh = 0u32;
        Collectionˉhigh = 0u32;
        Vectorˉhigh = 0u32;
    }
    if Remaining > 32u32 {
        let Highˉcount: u32 = Remaining - 32u32;
        var Highˉmask: u32 = 4294967295u32;
        if Highˉcount < 32u32 {
            Highˉmask = (1u32 << Highˉcount) - 1u32;
        }
        Descriptorˉhigh = Descriptorˉhigh & Highˉmask;
        Recordˉhigh = Recordˉhigh & Highˉmask;
        Collectionˉhigh = Collectionˉhigh & Highˉmask;
        Vectorˉhigh = Vectorˉhigh & Highˉmask;
    }
    if Produced {
        if Producedˉkind == 1u32 || Producedˉkind == 3u32 ||
            Producedˉkind == 4u32 {
            if Remaining < 32u32 {
                Descriptorˉlow = Descriptorˉlow | (1u32 << Remaining);
            } else {
                if Remaining >= 64u32 {
                    return Stackˉtracking(
                        false, Descriptorˉlow, Descriptorˉhigh,
                        Recordˉlow, Recordˉhigh,
                        Collectionˉlow, Collectionˉhigh,
                        Vectorˉlow, Vectorˉhigh
                    );
                }
                Descriptorˉhigh = Descriptorˉhigh
                    | (1u32 << (Remaining - 32u32));
            }
        }
        if Producedˉkind == 2u32 {
            if Remaining < 32u32 {
                Recordˉlow = Recordˉlow | (1u32 << Remaining);
            } else {
                if Remaining >= 64u32 {
                    return Stackˉtracking(
                        false, Descriptorˉlow, Descriptorˉhigh,
                        Recordˉlow, Recordˉhigh,
                        Collectionˉlow, Collectionˉhigh,
                        Vectorˉlow, Vectorˉhigh
                    );
                }
                Recordˉhigh = Recordˉhigh
                    | (1u32 << (Remaining - 32u32));
            }
        }
        if Producedˉkind == 3u32 || Producedˉkind == 4u32 {
            if Remaining < 32u32 {
                Collectionˉlow = Collectionˉlow | (1u32 << Remaining);
            } else {
                if Remaining >= 64u32 {
                    return Stackˉtracking(
                        false, Descriptorˉlow, Descriptorˉhigh,
                        Recordˉlow, Recordˉhigh,
                        Collectionˉlow, Collectionˉhigh,
                        Vectorˉlow, Vectorˉhigh
                    );
                }
                Collectionˉhigh = Collectionˉhigh
                    | (1u32 << (Remaining - 32u32));
            }
        }
        if Producedˉkind == 3u32 {
            if Remaining < 32u32 {
                Vectorˉlow = Vectorˉlow | (1u32 << Remaining);
            } else {
                if Remaining >= 64u32 {
                    return Stackˉtracking(
                        false, Descriptorˉlow, Descriptorˉhigh,
                        Recordˉlow, Recordˉhigh,
                        Collectionˉlow, Collectionˉhigh,
                        Vectorˉlow, Vectorˉhigh
                    );
                }
                Vectorˉhigh = Vectorˉhigh
                    | (1u32 << (Remaining - 32u32));
            }
        }
    }
    var Expectedˉcount: u32 = Remaining;
    if Produced { Expectedˉcount = Expectedˉcount + 1u32; }
    if Stackˉlength != Expectedˉcount * 8u32 {
        return Stackˉtracking(
            false, Descriptorˉlow, Descriptorˉhigh,
            Recordˉlow, Recordˉhigh, Collectionˉlow, Collectionˉhigh,
            Vectorˉlow, Vectorˉhigh
        );
    }
    return Stackˉtracking(
        true, Descriptorˉlow, Descriptorˉhigh,
        Recordˉlow, Recordˉhigh, Collectionˉlow, Collectionˉhigh,
        Vectorˉlow, Vectorˉhigh
    );
}

record Dataˉexecution {
    Valid: bool;
    Handled: bool;
    Stack: bytes;
    Status: u32;
    Allocationˉrequested: bool;
    Allocationˉvalue: bytes;
}

fn Executeˉdata(
    Module: bytes,
    Data: u32,
    Payload: u32,
    Opcode: u32,
    Initialˉstack: bytes
) -> Dataˉexecution {
    let Empty: bytes = Bytesˉslice(Module, 0u32, 0u32);
    let Isˉdata: bool = Opcode == 3u32 || Opcode == 6u32 ||
        Opcode == 7u32 || Opcode == 10u32;
    if !Isˉdata {
        return Dataˉexecution(
            true, false, Initialˉstack, 0u32, false, Empty
        );
    }
    let Dataˉindex: u32 = Bytesˉreadˉu32ˉlittle(Module, Payload + 1u32);
    var Dataˉcursor: u32 = Data + 4u32;
    var Currentˉdata: u32 = 0u32;
    var Selectedˉkind: u32 = 0u32;
    var Selectedˉoffset: u32 = 0u32;
    var Selectedˉlength: u32 = 0u32;
    while Currentˉdata <= Dataˉindex {
        Dataˉcursor = Dataˉcursor + 4u32
            + Bytesˉreadˉu32ˉlittle(Module, Dataˉcursor);
        let Dataˉkind: u32 = U32ˉfromˉu8(
            Bytesˉreadˉu8(Module, Dataˉcursor)
        );
        Dataˉcursor = Dataˉcursor + 1u32;
        let Dataˉlength: u32 = Bytesˉreadˉu32ˉlittle(Module, Dataˉcursor);
        Dataˉcursor = Dataˉcursor + 4u32;
        if Currentˉdata == Dataˉindex {
            Selectedˉkind = Dataˉkind;
            Selectedˉoffset = Dataˉcursor;
            Selectedˉlength = Dataˉlength;
        }
        if Dataˉkind == 4u32 {
            Dataˉcursor = Dataˉcursor + Dataˉlength * 4u32;
        } else {
            Dataˉcursor = Dataˉcursor + Dataˉlength;
        }
        Currentˉdata = Currentˉdata + 1u32;
    }
    if Opcode == 3u32 && Selectedˉkind != 3u32 {
        return Dataˉexecution(false, true, Empty, 0u32, false, Empty);
    }
    if (Opcode == 6u32 || Opcode == 7u32) && Selectedˉkind != 4u32 {
        return Dataˉexecution(false, true, Empty, 0u32, false, Empty);
    }
    if Opcode == 10u32 && Selectedˉkind != 5u32 {
        return Dataˉexecution(false, true, Empty, 0u32, false, Empty);
    }
    var Stack: bytes = Initialˉstack;
    var Status: u32 = 0u32;
    var Allocationˉrequested: bool = false;
    var Allocationˉvalue: bytes = Empty;
    if Opcode == 3u32 || Opcode == 10u32 {
        if Selectedˉlength > 16384u32 {
            Status = 3015u32;
        } else {
            Allocationˉrequested = true;
            Allocationˉvalue = Bytesˉslice(
                Module, Selectedˉoffset, Selectedˉlength
            );
        }
    }
    if Opcode == 6u32 {
        Stack = Bytesˉconcat(
            Stack,
            Bytesˉconcat(
                Bytesˉfromˉu32ˉlittle(Selectedˉlength),
                Bytesˉfromˉu32ˉlittle(0u32)
            )
        );
    }
    if Opcode == 7u32 {
        let Stackˉlength: u32 = Bytesˉlength(Stack);
        let Index: u32 = Bytesˉreadˉu32ˉlittle(
            Stack, Stackˉlength - 8u32
        );
        Stack = Bytesˉslice(Stack, 0u32, Stackˉlength - 8u32);
        if Index >= 2147483648u32 || Index >= Selectedˉlength {
            Status = 3008u32;
        } else {
            Stack = Bytesˉconcat(
                Stack,
                Bytesˉconcat(
                    Bytesˉslice(
                        Module, Selectedˉoffset + Index * 4u32, 4u32
                    ),
                    Bytesˉfromˉu32ˉlittle(0u32)
                )
            );
        }
    }
    return Dataˉexecution(
        true, true, Stack, Status, Allocationˉrequested, Allocationˉvalue
    );
}

record Localˉexecution {
    Valid: bool;
    Handled: bool;
    Stack: bytes;
    Locals: bytes;
    Heapˉallocations: bytes;
    Releasedˉdescriptors: bytes;
    Producedˉkind: u32;
}

fn Executeˉlocal(
    Module: bytes,
    Payload: u32,
    Opcode: u32,
    Functionˉshapeˉoffsets: bytes,
    Functionˉindex: u32,
    Localˉshapes: bytes,
    Typeˉoffsets: bytes,
    Initialˉstack: bytes,
    Initialˉlocals: bytes,
    Localˉframeˉlength: u32,
    Initialˉheapˉallocations: bytes,
    Heapˉallocationˉcount: u32,
    Initialˉproducedˉkind: u32
) -> Localˉexecution {
    let Empty: bytes = Bytesˉslice(Module, 0u32, 0u32);
    if Opcode != 4u32 && Opcode != 5u32 {
        return Localˉexecution(
            true, false, Initialˉstack, Initialˉlocals,
            Initialˉheapˉallocations, Empty, Initialˉproducedˉkind
        );
    }
    var Stack: bytes = Initialˉstack;
    var Locals: bytes = Initialˉlocals;
    var Heapˉallocations: bytes = Initialˉheapˉallocations;
    var Producedˉkind: u32 = Initialˉproducedˉkind;
    if Opcode == 4u32 {
        let Localˉindex: u32 = Bytesˉreadˉu32ˉlittle(
            Module, Payload + 1u32
        );
        let Shapeˉoffset: u32 = Bytesˉreadˉu32ˉlittle(
            Functionˉshapeˉoffsets, Functionˉindex * 4u32
        ) + Localˉindex * 8u32;
        let Shapeˉkind: u32 = Bytesˉreadˉu32ˉlittle(
            Localˉshapes, Shapeˉoffset
        );
        if Shapeˉkind == 25u32 {
            return Localˉexecution(
                false, true, Empty, Empty, Empty, Empty, Producedˉkind
            );
        }
        var Value: bytes = Bytesˉslice(Locals, Localˉindex * 8u32, 8u32);
        if Shapeˉkind == 7u32 || Shapeˉkind == 8u32 ||
            Shapeˉkind == 11u32 || Shapeˉkind == 22u32 ||
            Shapeˉkind == 23u32 || Shapeˉkind == 24u32 ||
            Shapeˉkind == 28u32 || Shapeˉkind == 29u32 ||
            Shapeˉkind == 30u32 {
            let Nominalˉtoken: u32 = Bytesˉreadˉu32ˉlittle(
                Localˉshapes, Shapeˉoffset + 4u32
            );
            if Bytesˉreadˉu32ˉlittle(Value, 0u32) == 0u32 &&
                Bytesˉreadˉu32ˉlittle(Value, 4u32) == 0u32 {
                if Shapeˉkind == 7u32 || Shapeˉkind == 28u32 {
                    Value = Bytesˉconcat(
                        Bytesˉfromˉu32ˉlittle(4294967295u32),
                        Bytesˉfromˉu32ˉlittle(Nominalˉtoken)
                    );
                }
                if Shapeˉkind == 8u32 {
                    Value = Bytesˉconcat(
                        Enumˉmemberˉvalue(
                            Module,
                            Typeˉoffsets,
                            Nominalˉtoken - 1u32,
                            0u32
                        ),
                        Bytesˉfromˉu32ˉlittle(Nominalˉtoken)
                    );
                }
                if Shapeˉkind == 11u32 || Shapeˉkind == 29u32 {
                    Value = Bytesˉconcat(
                        Bytesˉfromˉu32ˉlittle(4294967295u32),
                        Bytesˉfromˉu32ˉlittle(
                            2147483648u32 + Nominalˉtoken * 256u32
                        )
                    );
                }
                if Shapeˉkind == 22u32 || Shapeˉkind == 30u32 {
                    Value = Bytesˉconcat(
                        Bytesˉfromˉu32ˉlittle(4294967295u32),
                        Bytesˉfromˉu32ˉlittle(Nominalˉtoken)
                    );
                }
            }
        }
        if Shapeˉkind == 3u32 || Shapeˉkind == 6u32 ||
            Shapeˉkind == 23u32 || Shapeˉkind == 24u32 {
            Producedˉkind = 1u32;
            if Shapeˉkind == 24u32 { Producedˉkind = 4u32; }
            let Retained: bytes = Retainˉdescriptor(
                Heapˉallocations, Heapˉallocationˉcount, Value
            );
            if Bytesˉreadˉu32ˉlittle(Value, 4u32) > 0u32 &&
                Bytesˉlength(Retained) == 0u32 {
                return Localˉexecution(
                    false, true, Empty, Empty, Empty, Empty, Producedˉkind
                );
            }
            if Bytesˉlength(Retained) != Bytesˉlength(Heapˉallocations) {
                return Localˉexecution(
                    false, true, Empty, Empty, Empty, Empty, Producedˉkind
                );
            }
            Heapˉallocations = Retained;
        }
        if Shapeˉkind == 7u32 || Shapeˉkind == 11u32 ||
            Shapeˉkind == 22u32 || Shapeˉkind == 28u32 ||
            Shapeˉkind == 29u32 || Shapeˉkind == 30u32 {
            Producedˉkind = 2u32;
        }
        Stack = Bytesˉconcat(Stack, Value);
    } else {
        var Releasedˉdescriptors: bytes = Empty;
        let Storedˉlocalˉindex: u32 = Bytesˉreadˉu32ˉlittle(
            Module, Payload + 1u32
        );
        let Storeˉstackˉlength: u32 = Bytesˉlength(Stack);
        let Storedˉvalue: bytes = Bytesˉslice(
            Stack, Storeˉstackˉlength - 8u32, 8u32
        );
        Stack = Bytesˉslice(Stack, 0u32, Storeˉstackˉlength - 8u32);
        let Storedˉlocalˉoffset: u32 = Storedˉlocalˉindex * 8u32;
        let Storedˉshapeˉoffset: u32 = Bytesˉreadˉu32ˉlittle(
            Functionˉshapeˉoffsets, Functionˉindex * 4u32
        ) + Storedˉlocalˉoffset;
        let Storedˉshapeˉkind: u32 = Bytesˉreadˉu32ˉlittle(
            Localˉshapes, Storedˉshapeˉoffset
        );
        if Storedˉshapeˉkind == 3u32 || Storedˉshapeˉkind == 6u32 ||
            Storedˉshapeˉkind == 23u32 || Storedˉshapeˉkind == 24u32 {
            let Previous: bytes = Bytesˉslice(
                Locals, Storedˉlocalˉoffset, 8u32
            );
            if Bytesˉreadˉu32ˉlittle(Previous, 4u32) > 0u32 {
                Releasedˉdescriptors = Previous;
            }
        }
        Locals = Bytesˉconcat(
            Bytesˉconcat(
                Bytesˉslice(Locals, 0u32, Storedˉlocalˉoffset),
                Storedˉvalue
            ),
            Bytesˉslice(
                Locals,
                Storedˉlocalˉoffset + 8u32,
                Localˉframeˉlength - 8u32 - Storedˉlocalˉoffset
            )
        );
        return Localˉexecution(
            true, true, Stack, Locals, Heapˉallocations,
            Releasedˉdescriptors, Producedˉkind
        );
    }
    return Localˉexecution(
        true, true, Stack, Locals, Heapˉallocations, Empty, Producedˉkind
    );
}

record Bytesˉexecution {
    Handled: bool;
    Stack: bytes;
    Status: u32;
    Releasedˉdescriptors: bytes;
}

fn Executeˉbytes(
    Heap: bytes,
    Opcode: u32,
    Initialˉstack: bytes
) -> Bytesˉexecution {
    let Empty: bytes = Bytesˉslice(Initialˉstack, 0u32, 0u32);
    let Zero: bytes = Bytesˉfromˉu32ˉlittle(0u32);
    if Opcode < 11u32 || Opcode > 15u32 {
        return Bytesˉexecution(false, Initialˉstack, 0u32, Empty);
    }
    var Stack: bytes = Initialˉstack;
    var Status: u32 = 0u32;
    var Released: bytes = Empty;
    if Opcode == 11u32 {
        let Stackˉlength: u32 = Bytesˉlength(Stack);
        let Source: bytes = Bytesˉslice(Stack, Stackˉlength - 8u32, 8u32);
        Released = Bytesˉconcat(Released, Source);
        Stack = Bytesˉslice(Stack, 0u32, Stackˉlength - 8u32);
        Stack = Bytesˉconcat(
            Stack,
            Bytesˉconcat(
                Bytesˉfromˉu32ˉlittle(
                    Bytesˉreadˉu32ˉlittle(Source, 4u32)
                ),
                Zero
            )
        );
    }
    if Opcode == 12u32 {
        var Stackˉcursor: u32 = Bytesˉlength(Stack);
        let Sliceˉlength: u32 = Bytesˉreadˉu32ˉlittle(
            Stack, Stackˉcursor - 8u32
        );
        Stack = Bytesˉslice(Stack, 0u32, Stackˉcursor - 8u32);
        Stackˉcursor = Bytesˉlength(Stack);
        let Sliceˉoffset: u32 = Bytesˉreadˉu32ˉlittle(
            Stack, Stackˉcursor - 8u32
        );
        Stack = Bytesˉslice(Stack, 0u32, Stackˉcursor - 8u32);
        Stackˉcursor = Bytesˉlength(Stack);
        let Sourceˉoffset: u32 = Bytesˉreadˉu32ˉlittle(
            Stack, Stackˉcursor - 8u32
        );
        let Sourceˉlength: u32 = Bytesˉreadˉu32ˉlittle(
            Stack, Stackˉcursor - 4u32
        );
        Stack = Bytesˉslice(Stack, 0u32, Stackˉcursor - 8u32);
        if Sliceˉoffset > Sourceˉlength ||
            Sliceˉlength > Sourceˉlength - Sliceˉoffset {
            Status = 3008u32;
        } else {
            if Sliceˉlength == 0u32 {
                Released = Bytesˉconcat(
                    Released,
                    Bytesˉconcat(
                        Bytesˉfromˉu32ˉlittle(Sourceˉoffset),
                        Bytesˉfromˉu32ˉlittle(Sourceˉlength)
                    )
                );
            }
            Stack = Bytesˉconcat(
                Stack,
                Bytesˉconcat(
                    Bytesˉfromˉu32ˉlittle(Sourceˉoffset + Sliceˉoffset),
                    Bytesˉfromˉu32ˉlittle(Sliceˉlength)
                )
            );
        }
    }
    if Opcode >= 13u32 {
        var Readˉstackˉcursor: u32 = Bytesˉlength(Stack);
        let Readˉoffset: u32 = Bytesˉreadˉu32ˉlittle(
            Stack, Readˉstackˉcursor - 8u32
        );
        Stack = Bytesˉslice(Stack, 0u32, Readˉstackˉcursor - 8u32);
        Readˉstackˉcursor = Bytesˉlength(Stack);
        let Readˉsourceˉoffset: u32 = Bytesˉreadˉu32ˉlittle(
            Stack, Readˉstackˉcursor - 8u32
        );
        let Readˉsourceˉlength: u32 = Bytesˉreadˉu32ˉlittle(
            Stack, Readˉstackˉcursor - 4u32
        );
        Stack = Bytesˉslice(Stack, 0u32, Readˉstackˉcursor - 8u32);
        Released = Bytesˉconcat(
            Released,
            Bytesˉconcat(
                Bytesˉfromˉu32ˉlittle(Readˉsourceˉoffset),
                Bytesˉfromˉu32ˉlittle(Readˉsourceˉlength)
            )
        );
        let Evaluation: bytes = Evaluateˉbytesˉread(
            Heap,
            Opcode,
            Readˉsourceˉoffset,
            Readˉsourceˉlength,
            Readˉoffset
        );
        Status = Bytesˉreadˉu32ˉlittle(Evaluation, 0u32);
        if Status == 0u32 {
            Stack = Bytesˉconcat(
                Stack,
                Bytesˉconcat(Bytesˉslice(Evaluation, 4u32, 4u32), Zero)
            );
        }
    }
    return Bytesˉexecution(true, Stack, Status, Released);
}

fn Quoteˉutf8(Heap: bytes, Sourceˉoffset: u32, Sourceˉlength: u32) -> bytes {
    let Empty: bytes = Bytesˉslice(Heap, 0u32, 0u32);
    var Quoted: bytes = Bytesˉfromˉu8(34u8);
    var Cursor: u32 = 0u32;
    while Cursor < Sourceˉlength {
        let First: u32 = U32ˉfromˉu8(
            Bytesˉreadˉu8(Heap, Sourceˉoffset + Cursor)
        );
        var Width: u32 = 1u32;
        var Piece: bytes = Empty;
        var Pieceˉset: bool = false;
        var Firstˉunit: u32 = 0u32;
        var Secondˉunit: u32 = 0u32;
        var Unitˉcount: u32 = 0u32;
        if First <= 127u32 {
            if First == 34u32 {
                Piece = Bytesˉconcat(
                    Bytesˉfromˉu8(92u8), Bytesˉfromˉu8(34u8)
                );
                Pieceˉset = true;
            }
            if First == 92u32 {
                Piece = Bytesˉconcat(
                    Bytesˉfromˉu8(92u8), Bytesˉfromˉu8(92u8)
                );
                Pieceˉset = true;
            }
            if First == 8u32 {
                Piece = Bytesˉconcat(
                    Bytesˉfromˉu8(92u8), Bytesˉfromˉu8(98u8)
                );
                Pieceˉset = true;
            }
            if First == 12u32 {
                Piece = Bytesˉconcat(
                    Bytesˉfromˉu8(92u8), Bytesˉfromˉu8(102u8)
                );
                Pieceˉset = true;
            }
            if First == 10u32 {
                Piece = Bytesˉconcat(
                    Bytesˉfromˉu8(92u8), Bytesˉfromˉu8(110u8)
                );
                Pieceˉset = true;
            }
            if First == 13u32 {
                Piece = Bytesˉconcat(
                    Bytesˉfromˉu8(92u8), Bytesˉfromˉu8(114u8)
                );
                Pieceˉset = true;
            }
            if First == 9u32 {
                Piece = Bytesˉconcat(
                    Bytesˉfromˉu8(92u8), Bytesˉfromˉu8(116u8)
                );
                Pieceˉset = true;
            }
            if Pieceˉset {
                Pieceˉset = true;
            } else if First >= 32u32 && First <= 126u32 {
                Piece = Bytesˉslice(
                    Bytesˉfromˉu32ˉlittle(First), 0u32, 1u32
                );
                Pieceˉset = true;
            }
            if Pieceˉset {
                Quoted = Bytesˉconcat(Quoted, Piece);
            } else {
                Firstˉunit = First;
                Unitˉcount = 1u32;
            }
        } else {
            let Second: u32 = U32ˉfromˉu8(
                Bytesˉreadˉu8(Heap, Sourceˉoffset + Cursor + 1u32)
            );
            if First <= 223u32 {
                Width = 2u32;
                Firstˉunit = (First - 192u32) * 64u32 + Second - 128u32;
                Unitˉcount = 1u32;
            } else {
                let Third: u32 = U32ˉfromˉu8(
                    Bytesˉreadˉu8(Heap, Sourceˉoffset + Cursor + 2u32)
                );
                if First <= 239u32 {
                    Width = 3u32;
                    Firstˉunit = (First - 224u32) * 4096u32
                        + (Second - 128u32) * 64u32 + Third - 128u32;
                    Unitˉcount = 1u32;
                } else {
                    let Fourth: u32 = U32ˉfromˉu8(
                        Bytesˉreadˉu8(
                            Heap, Sourceˉoffset + Cursor + 3u32
                        )
                    );
                    Width = 4u32;
                    var Thirdˉpart: u32 = Third - 128u32;
                    var Surrogateˉquotient: u32 =
                        (First - 240u32) * 256u32
                        + (Second - 128u32) * 4u32;
                    if Thirdˉpart >= 48u32 {
                        Thirdˉpart = Thirdˉpart - 48u32;
                        Surrogateˉquotient = Surrogateˉquotient + 3u32;
                    } else if Thirdˉpart >= 32u32 {
                        Thirdˉpart = Thirdˉpart - 32u32;
                        Surrogateˉquotient = Surrogateˉquotient + 2u32;
                    } else if Thirdˉpart >= 16u32 {
                        Thirdˉpart = Thirdˉpart - 16u32;
                        Surrogateˉquotient = Surrogateˉquotient + 1u32;
                    }
                    Surrogateˉquotient = Surrogateˉquotient - 64u32;
                    let Surrogateˉremainder: u32 =
                        Thirdˉpart * 64u32 + Fourth - 128u32;
                    Firstˉunit = 55296u32 + Surrogateˉquotient;
                    Secondˉunit = 56320u32 + Surrogateˉremainder;
                    Unitˉcount = 2u32;
                }
            }
        }
        var Unitˉindex: u32 = 0u32;
        while Unitˉindex < Unitˉcount {
            var Unit: u32 = Firstˉunit;
            if Unitˉindex == 1u32 { Unit = Secondˉunit; }
            Quoted = Bytesˉconcat(
                Quoted,
                Bytesˉconcat(Bytesˉfromˉu8(92u8), Bytesˉfromˉu8(117u8))
            );
            var Hexˉplace: u32 = 4096u32;
            var Hexˉindex: u32 = 0u32;
            while Hexˉindex < 4u32 {
                var Hexˉdigit: u32 = 0u32;
                while Unit >= Hexˉplace {
                    Unit = Unit - Hexˉplace;
                    Hexˉdigit = Hexˉdigit + 1u32;
                }
                var Hexˉascii: u32 = 48u32 + Hexˉdigit;
                if Hexˉdigit >= 10u32 {
                    Hexˉascii = 65u32 + Hexˉdigit - 10u32;
                }
                Quoted = Bytesˉconcat(
                    Quoted,
                    Bytesˉslice(
                        Bytesˉfromˉu32ˉlittle(Hexˉascii), 0u32, 1u32
                    )
                );
                Hexˉindex = Hexˉindex + 1u32;
                if Hexˉindex == 1u32 { Hexˉplace = 256u32; }
                if Hexˉindex == 2u32 { Hexˉplace = 16u32; }
                if Hexˉindex == 3u32 { Hexˉplace = 1u32; }
            }
            Unitˉindex = Unitˉindex + 1u32;
        }
        Cursor = Cursor + Width;
    }
    return Bytesˉconcat(Quoted, Bytesˉfromˉu8(34u8));
}

fn Utf8ˉisˉvalid(Heap: bytes, Sourceˉoffset: u32, Sourceˉlength: u32) -> bool {
    var Cursor: u32 = 0u32;
    while Cursor < Sourceˉlength {
        let First: u32 = U32ˉfromˉu8(
            Bytesˉreadˉu8(Heap, Sourceˉoffset + Cursor)
        );
        let Remaining: u32 = Sourceˉlength - Cursor;
        var Width: u32 = 0u32;
        var Second: u32 = 0u32;
        var Third: u32 = 0u32;
        var Fourth: u32 = 0u32;
        var Secondˉcontinuation: bool = false;
        var Thirdˉcontinuation: bool = false;
        var Fourthˉcontinuation: bool = false;
        if First <= 127u32 { Width = 1u32; }
        if Remaining >= 2u32 {
            Second = U32ˉfromˉu8(
                Bytesˉreadˉu8(Heap, Sourceˉoffset + Cursor + 1u32)
            );
            if Second >= 128u32 && Second <= 191u32 {
                Secondˉcontinuation = true;
            }
        }
        if Remaining >= 3u32 {
            Third = U32ˉfromˉu8(
                Bytesˉreadˉu8(Heap, Sourceˉoffset + Cursor + 2u32)
            );
            if Third >= 128u32 && Third <= 191u32 {
                Thirdˉcontinuation = true;
            }
        }
        if Remaining >= 4u32 {
            Fourth = U32ˉfromˉu8(
                Bytesˉreadˉu8(Heap, Sourceˉoffset + Cursor + 3u32)
            );
            if Fourth >= 128u32 && Fourth <= 191u32 {
                Fourthˉcontinuation = true;
            }
        }
        if First >= 194u32 && First <= 223u32 &&
            Secondˉcontinuation {
            Width = 2u32;
        }
        if First == 224u32 && Second >= 160u32 && Second <= 191u32 &&
            Thirdˉcontinuation {
            Width = 3u32;
        }
        if First >= 225u32 && First <= 236u32 &&
            Secondˉcontinuation && Thirdˉcontinuation {
            Width = 3u32;
        }
        if First == 237u32 && Second >= 128u32 && Second <= 159u32 &&
            Thirdˉcontinuation {
            Width = 3u32;
        }
        if First >= 238u32 && First <= 239u32 &&
            Secondˉcontinuation && Thirdˉcontinuation {
            Width = 3u32;
        }
        if First == 240u32 && Second >= 144u32 && Second <= 191u32 &&
            Thirdˉcontinuation && Fourthˉcontinuation {
            Width = 4u32;
        }
        if First >= 241u32 && First <= 243u32 &&
            Secondˉcontinuation && Thirdˉcontinuation &&
            Fourthˉcontinuation {
            Width = 4u32;
        }
        if First == 244u32 && Second >= 128u32 && Second <= 143u32 &&
            Thirdˉcontinuation && Fourthˉcontinuation {
            Width = 4u32;
        }
        if Width == 0u32 { return false; }
        Cursor = Cursor + Width;
    }
    return true;
}

record Extendedˉexecution {
    Valid: bool;
    Handled: bool;
    Stack: bytes;
    Status: u32;
    Releasedˉdescriptors: bytes;
    Allocationˉrequested: bool;
    Allocationˉvalue: bytes;
    Heap: bytes;
    Recordˉmetadata: bytes;
    Records: bytes;
    Heapˉallocations: bytes;
    Memoryˉbudgetˉstate: bytes;
    Heapˉallocationˉcount: u32;
    Allocationˉleases: bytes;
    Locals: bytes;
    Consumed: u32;
    Produced: bool;
    Producedˉkind: u32;
    Instructions: u32;
}

record Collectionˉexecution {
    Valid: bool;
    Handled: bool;
    Stack: bytes;
    Status: u32;
    Allocationˉrequested: bool;
    Allocationˉvalue: bytes;
    Heap: bytes;
    Heapˉallocations: bytes;
    Locals: bytes;
    Consumed: u32;
    Produced: bool;
    Producedˉkind: u32;
    Instructions: u32;
}

fn Executeˉcollection(
    Module: bytes,
    Typeˉoffsets: bytes,
    Typeˉcount: u32,
    Payload: u32,
    Payloadˉlength: u32,
    Initialˉstack: bytes,
    Initialˉconsumed: u32,
    Initialˉproduced: bool,
    Initialˉproducedˉkind: u32,
    Zeroˉvalue: bytes,
    Zeroˉcell: bytes,
    Initialˉheap: bytes,
    Initialˉheapˉallocations: bytes,
    Heapˉallocationˉcount: u32,
    Stackˉdescriptorˉflagsˉlow: u32,
    Stackˉdescriptorˉflagsˉhigh: u32,
    Stackˉcollectionˉflagsˉlow: u32,
    Stackˉcollectionˉflagsˉhigh: u32,
    Stackˉvectorˉflagsˉlow: u32,
    Stackˉvectorˉflagsˉhigh: u32,
    Functionˉshapeˉoffsets: bytes,
    Functionˉparameterˉmodeˉoffsets: bytes,
    Functionˉparameterˉmodes: bytes,
    Functionˉindex: u32,
    Initialˉlocals: bytes,
    Localˉshapes: bytes,
    Functionˉcursor: u32,
    Functionˉframeˉmetadata: bytes
) -> Collectionˉexecution {
    let Empty: bytes = Bytesˉslice(Module, 0u32, 0u32);
    let Invalid: Collectionˉexecution = Collectionˉexecution(
        false, false, Empty, 0u32, false, Empty, Empty, Empty,
        Empty, 0u32, false, 0u32, 0u32
    );
    let Stackˉdescriptorˉcount: u32 = Bytesˉlength(Initialˉstack) / 8u32;
    var Stack: bytes = Initialˉstack;
    var Sectionˉkind: u32 = 0u32;
    var Heapˉallocationˉrequested: bool = false;
    var Heapˉallocationˉvalue: bytes = Empty;
    var Heap: bytes = Initialˉheap;
    var Heapˉallocations: bytes = Initialˉheapˉallocations;
    var Locals: bytes = Initialˉlocals;
    var Stackˉconsumed: u32 = Initialˉconsumed;
    var Stackˉproduced: bool = Initialˉproduced;
    var Stackˉproducedˉkind: u32 = Initialˉproducedˉkind;
    var Aggregateˉinstructions: u32 = 0u32;
    var Mainˉfound: bool = false;

    if Payloadˉlength >= 199u32 && Payloadˉlength <= 204u32 {
        let Collectionˉtype: u32 = Bytesˉreadˉu32ˉlittle(
            Module, Payload + 1u32
        );
        var Collectionˉexpectedˉkind: u32 = 5u32;
        if Payloadˉlength >= 203u32 {
            Collectionˉexpectedˉkind = 6u32;
        }
        let Collectionˉelementˉshape: u32 =
            Collections.Collectionˉelementˉshape(
                Module,
                Typeˉoffsets,
                Typeˉcount,
                Collectionˉtype,
                Collectionˉexpectedˉkind
            );
        if !Collections.Collectionˉscalarˉelement(
            Module, Collectionˉelementˉshape
        ) {
            return Invalid;
        }

        if Payloadˉlength == 199u32 {
            let Collectionˉcreateˉstack: u32 = Bytesˉlength(Stack);
            if Collectionˉcreateˉstack < 8u32 { return Invalid; }
            let Collectionˉmaximum: u32 = Bytesˉreadˉu32ˉlittle(
                Stack, Collectionˉcreateˉstack - 8u32
            );
            let Collectionˉmaximumˉhigh: u32 = Bytesˉreadˉu32ˉlittle(
                Stack, Collectionˉcreateˉstack - 4u32
            );
            if Collectionˉmaximumˉhigh != 0u32 ||
                Collectionˉmaximum == 0u32 ||
                Collectionˉmaximum > 2047u32 {
                Sectionˉkind = 3015u32;
            } else {
                Heapˉallocationˉvalue =
                    Collections.Collectionˉemptyˉbacking(
                        Collectionˉmaximum, Zeroˉcell
                    );
                if Bytesˉlength(Heapˉallocationˉvalue) == 0u32 {
                    return Invalid;
                }
                Heapˉallocationˉrequested = true;
                Stack = Bytesˉslice(
                    Stack, 0u32, Collectionˉcreateˉstack - 8u32
                );
                Stackˉconsumed = 1u32;
                Stackˉproduced = true;
                Stackˉproducedˉkind = 3u32;
            }
            Aggregateˉinstructions = Aggregateˉinstructions + 5u32;
            Mainˉfound = true;
        }

        if Payloadˉlength == 200u32 {
            let Collectionˉappendˉstack: u32 = Bytesˉlength(Stack);
            if Collectionˉappendˉstack < 16u32 { return Invalid; }
            let Collectionˉappendˉvector: bytes = Bytesˉslice(
                Stack, Collectionˉappendˉstack - 16u32, 8u32
            );
            let Collectionˉappendˉvalue: bytes = Bytesˉslice(
                Stack, Collectionˉappendˉstack - 8u32, 8u32
            );
            let Collectionˉappendˉslot: u32 =
                Stackˉdescriptorˉcount - 2u32;
            if !Stackˉflagˉset(
                Stackˉdescriptorˉflagsˉlow,
                Stackˉdescriptorˉflagsˉhigh,
                Collectionˉappendˉslot
            ) || !Stackˉflagˉset(
                Stackˉvectorˉflagsˉlow,
                Stackˉvectorˉflagsˉhigh,
                Collectionˉappendˉslot
            ) || !Stackˉflagˉset(
                Stackˉcollectionˉflagsˉlow,
                Stackˉcollectionˉflagsˉhigh,
                Collectionˉappendˉslot
            ) {
                return Invalid;
            }
            if !Collections.Collectionˉbackingˉvalid(
                Heap,
                Heapˉallocations,
                Heapˉallocationˉcount,
                Collectionˉappendˉvector
            ) {
                return Invalid;
            }
            let Collectionˉnextˉheap: bytes =
                Collections.Collectionˉappend(
                    Heap,
                    Collectionˉappendˉvector,
                    Collectionˉappendˉvalue
                );
            if Bytesˉlength(Collectionˉnextˉheap) == 0u32 {
                Sectionˉkind = 3008u32;
            } else {
                Heap = Collectionˉnextˉheap;
                Stack = Bytesˉconcat(
                    Bytesˉslice(
                        Stack, 0u32, Collectionˉappendˉstack - 16u32
                    ),
                    Collectionˉappendˉvector
                );
                Stackˉconsumed = 2u32;
                Stackˉproduced = true;
                Stackˉproducedˉkind = 3u32;
            }
            Aggregateˉinstructions = Aggregateˉinstructions + 5u32;
            Mainˉfound = true;
        }

        if Payloadˉlength == 201u32 {
            let Collectionˉsequenceˉtype: u32 =
                Bytesˉreadˉu32ˉlittle(Module, Payload + 5u32);
            let Collectionˉsequenceˉelement: u32 =
                Collections.Collectionˉelementˉshape(
                    Module,
                    Typeˉoffsets,
                    Typeˉcount,
                    Collectionˉsequenceˉtype,
                    6u32
                );
            if Collectionˉsequenceˉelement == 4294967295u32 ||
                Bytesˉreadˉu8(Module, Collectionˉsequenceˉelement) !=
                    Bytesˉreadˉu8(Module, Collectionˉelementˉshape) {
                return Invalid;
            }
            let Collectionˉfreezeˉelementˉkind: u32 = U32ˉfromˉu8(
                Bytesˉreadˉu8(Module, Collectionˉelementˉshape)
            );
            if Collectionˉfreezeˉelementˉkind == 8u32 &&
                Bytesˉreadˉu32ˉlittle(
                    Module, Collectionˉsequenceˉelement + 1u32
                ) != Bytesˉreadˉu32ˉlittle(
                    Module, Collectionˉelementˉshape + 1u32
                ) {
                return Invalid;
            }
            let Collectionˉfreezeˉstack: u32 = Bytesˉlength(Stack);
            if Collectionˉfreezeˉstack < 8u32 { return Invalid; }
            let Collectionˉfreezeˉvalue: bytes = Bytesˉslice(
                Stack, Collectionˉfreezeˉstack - 8u32, 8u32
            );
            let Collectionˉfreezeˉslot: u32 =
                Stackˉdescriptorˉcount - 1u32;
            if !Stackˉflagˉset(
                Stackˉdescriptorˉflagsˉlow,
                Stackˉdescriptorˉflagsˉhigh,
                Collectionˉfreezeˉslot
            ) || !Stackˉflagˉset(
                Stackˉvectorˉflagsˉlow,
                Stackˉvectorˉflagsˉhigh,
                Collectionˉfreezeˉslot
            ) || !Stackˉflagˉset(
                Stackˉcollectionˉflagsˉlow,
                Stackˉcollectionˉflagsˉhigh,
                Collectionˉfreezeˉslot
            ) {
                return Invalid;
            }
            if !Collections.Collectionˉbackingˉvalid(
                Heap,
                Heapˉallocations,
                Heapˉallocationˉcount,
                Collectionˉfreezeˉvalue
            ) {
                return Invalid;
            }
            Stackˉconsumed = 1u32;
            Stackˉproduced = true;
            Stackˉproducedˉkind = 4u32;
            Aggregateˉinstructions = Aggregateˉinstructions + 9u32;
            Mainˉfound = true;
        }

        if Payloadˉlength == 202u32 || Payloadˉlength == 203u32 {
            let Collectionˉlengthˉstack: u32 = Bytesˉlength(Stack);
            if Collectionˉlengthˉstack < 8u32 { return Invalid; }
            let Collectionˉlengthˉvalue: bytes = Bytesˉslice(
                Stack, Collectionˉlengthˉstack - 8u32, 8u32
            );
            let Collectionˉlengthˉslot: u32 =
                Stackˉdescriptorˉcount - 1u32;
            let Collectionˉlengthˉvector: bool = Stackˉflagˉset(
                Stackˉvectorˉflagsˉlow,
                Stackˉvectorˉflagsˉhigh,
                Collectionˉlengthˉslot
            );
            if !Stackˉflagˉset(
                Stackˉdescriptorˉflagsˉlow,
                Stackˉdescriptorˉflagsˉhigh,
                Collectionˉlengthˉslot
            ) || !Stackˉflagˉset(
                Stackˉcollectionˉflagsˉlow,
                Stackˉcollectionˉflagsˉhigh,
                Collectionˉlengthˉslot
            ) || (Payloadˉlength == 202u32 &&
                !Collectionˉlengthˉvector) ||
                (Payloadˉlength == 203u32 &&
                    Collectionˉlengthˉvector) {
                return Invalid;
            }
            if !Collections.Collectionˉbackingˉvalid(
                Heap,
                Heapˉallocations,
                Heapˉallocationˉcount,
                Collectionˉlengthˉvalue
            ) {
                return Invalid;
            }
            Stack = Bytesˉconcat(
                Stack,
                Bytesˉconcat(
                    Bytesˉfromˉu32ˉlittle(
                        Collections.Collectionˉlength(
                            Heap, Collectionˉlengthˉvalue
                        )
                    ),
                    Zeroˉvalue
                )
            );
            Stackˉconsumed = 0u32;
            Stackˉproduced = true;
            Stackˉproducedˉkind = 0u32;
            Aggregateˉinstructions = Aggregateˉinstructions + 5u32;
            Mainˉfound = true;
        }

        if Payloadˉlength == 204u32 {
            let Collectionˉelementˉstack: u32 = Bytesˉlength(Stack);
            if Collectionˉelementˉstack < 16u32 { return Invalid; }
            let Collectionˉsequenceˉvalue: bytes = Bytesˉslice(
                Stack, Collectionˉelementˉstack - 16u32, 8u32
            );
            let Collectionˉsequenceˉslot: u32 =
                Stackˉdescriptorˉcount - 2u32;
            if !Stackˉflagˉset(
                Stackˉdescriptorˉflagsˉlow,
                Stackˉdescriptorˉflagsˉhigh,
                Collectionˉsequenceˉslot
            ) || Stackˉflagˉset(
                Stackˉvectorˉflagsˉlow,
                Stackˉvectorˉflagsˉhigh,
                Collectionˉsequenceˉslot
            ) || !Stackˉflagˉset(
                Stackˉcollectionˉflagsˉlow,
                Stackˉcollectionˉflagsˉhigh,
                Collectionˉsequenceˉslot
            ) {
                return Invalid;
            }
            let Collectionˉindex: u32 = Bytesˉreadˉu32ˉlittle(
                Stack, Collectionˉelementˉstack - 8u32
            );
            let Collectionˉindexˉhigh: u32 = Bytesˉreadˉu32ˉlittle(
                Stack, Collectionˉelementˉstack - 4u32
            );
            if !Collections.Collectionˉbackingˉvalid(
                Heap,
                Heapˉallocations,
                Heapˉallocationˉcount,
                Collectionˉsequenceˉvalue
            ) {
                return Invalid;
            }
            let Collectionˉselected: bytes =
                Collections.Collectionˉelement(
                    Heap, Collectionˉsequenceˉvalue, Collectionˉindex
                );
            if Collectionˉindexˉhigh != 0u32 ||
                Bytesˉlength(Collectionˉselected) != 8u32 {
                Sectionˉkind = 3008u32;
            } else {
                Stack = Bytesˉconcat(
                    Bytesˉslice(
                        Stack, 0u32, Collectionˉelementˉstack - 8u32
                    ),
                    Collectionˉselected
                );
                Stackˉconsumed = 1u32;
                Stackˉproduced = true;
                Stackˉproducedˉkind = 0u32;
            }
            Aggregateˉinstructions = Aggregateˉinstructions + 5u32;
            Mainˉfound = true;
        }
    }
    if Payloadˉlength == 205u32 {
        let Takenˉlocalˉindex: u32 = Bytesˉreadˉu32ˉlittle(
            Module, Payload + 1u32
        );
        if Takenˉlocalˉindex >= Functionˉcursor / 8u32 {
            return Invalid;
        }
        let Takenˉlocalˉoffset: u32 = Takenˉlocalˉindex * 8u32;
        let Takenˉshapeˉoffset: u32 = Bytesˉreadˉu32ˉlittle(
            Functionˉshapeˉoffsets,
            Functionˉindex * 4u32
        ) + Takenˉlocalˉoffset;
        let Takenˉshapeˉkind: u32 = Bytesˉreadˉu32ˉlittle(
            Localˉshapes, Takenˉshapeˉoffset
        );
        let Takenˉparameterˉcount: u32 = Bytesˉreadˉu32ˉlittle(
            Functionˉframeˉmetadata, Functionˉindex * 8u32
        );
        let Takenˉminor: u32 = Bytesˉreadˉu16ˉlittle(Module, 6u32);
        let Takenˉisˉaggregate: bool = Takenˉminor >= 28u32 &&
            (Takenˉshapeˉkind == 7u32 || Takenˉshapeˉkind == 11u32 ||
                Takenˉshapeˉkind == 22u32);
        let Takenˉisˉsourceˉfile: bool = Takenˉminor >= 29u32 &&
            Takenˉshapeˉkind == 34u32;
        if Takenˉshapeˉkind != 23u32 && !Takenˉisˉaggregate &&
            !Takenˉisˉsourceˉfile &&
            (Bytesˉreadˉu16ˉlittle(Module, 6u32) < 23u32 ||
                (Takenˉshapeˉkind != 25u32 &&
                    Takenˉshapeˉkind != 11u32)) {
            return Invalid;
        }
        if Takenˉlocalˉindex < Takenˉparameterˉcount &&
            Takenˉshapeˉkind != 25u32 && !Takenˉisˉaggregate &&
            !Takenˉisˉsourceˉfile {
            if Takenˉshapeˉkind != 23u32 ||
                Bytesˉreadˉu16ˉlittle(Module, 6u32) < 26u32 ||
                U32ˉfromˉu8(Bytesˉreadˉu8(
                    Functionˉparameterˉmodes,
                    Bytesˉreadˉu32ˉlittle(
                        Functionˉparameterˉmodeˉoffsets,
                        Functionˉindex * 4u32
                    ) + Takenˉlocalˉindex
                )) != 0u32 {
                return Invalid;
            }
        }
        let Takenˉvalue: bytes = Bytesˉslice(
            Locals, Takenˉlocalˉoffset, 8u32
        );
        if Takenˉshapeˉkind == 23u32 {
            if !Collections.Collectionˉbackingˉvalid(
                Heap,
                Heapˉallocations,
                Heapˉallocationˉcount,
                Takenˉvalue
            ) {
                return Invalid;
            }
        }
        Locals = Bytesˉconcat(
            Bytesˉconcat(
                Bytesˉslice(Locals, 0u32, Takenˉlocalˉoffset),
                Zeroˉcell
            ),
            Bytesˉslice(
                Locals,
                Takenˉlocalˉoffset + 8u32,
                Functionˉcursor - 8u32 - Takenˉlocalˉoffset
            )
        );
        Stack = Bytesˉconcat(Stack, Takenˉvalue);
        Stackˉconsumed = 0u32;
        Stackˉproduced = true;
        Stackˉproducedˉkind = 0u32;
        if Takenˉshapeˉkind == 7u32 || Takenˉshapeˉkind == 11u32 ||
            Takenˉshapeˉkind == 22u32 {
            Stackˉproducedˉkind = 2u32;
        }
        if Takenˉshapeˉkind == 23u32 { Stackˉproducedˉkind = 3u32; }
        Aggregateˉinstructions = Aggregateˉinstructions + 5u32;
        Mainˉfound = true;
    }

    return Collectionˉexecution(
        true, Mainˉfound, Stack, Sectionˉkind,
        Heapˉallocationˉrequested, Heapˉallocationˉvalue,
        Heap, Heapˉallocations, Locals,
        Stackˉconsumed, Stackˉproduced, Stackˉproducedˉkind,
        Aggregateˉinstructions
    );
}

fn Executeˉaggregate(
    Module: bytes,
    Typeˉoffsets: bytes,
    Typeˉcount: u32,
    Payload: u32,
    Payloadˉlength: u32,
    Initialˉstack: bytes,
    Initialˉconsumed: u32,
    Initialˉproduced: bool,
    Initialˉproducedˉkind: u32,
    Zeroˉvalue: bytes,
    Zeroˉcell: bytes,
    Initialˉheap: bytes,
    Initialˉheapˉallocations: bytes,
    Heapˉallocationˉcount: u32,
    Initialˉrecordˉmetadata: bytes,
    Initialˉrecords: bytes,
    Taskˉstate: bytes,
    Stackˉdescriptorˉflagsˉlow: u32,
    Stackˉdescriptorˉflagsˉhigh: u32,
    Stackˉrecordˉflagsˉlow: u32,
    Stackˉrecordˉflagsˉhigh: u32,
    Stackˉcollectionˉflagsˉlow: u32,
    Stackˉcollectionˉflagsˉhigh: u32,
    Stackˉvectorˉflagsˉlow: u32,
    Stackˉvectorˉflagsˉhigh: u32,
    Functionˉshapeˉoffsets: bytes,
    Functionˉparameterˉmodeˉoffsets: bytes,
    Functionˉparameterˉmodes: bytes,
    Functionˉindex: u32,
    Initialˉlocals: bytes,
    Localˉshapes: bytes,
    Functionˉcursor: u32,
    Frames: bytes,
    Functionˉcount: u32,
    Functionˉframeˉmetadata: bytes
) -> Extendedˉexecution {
    let Empty: bytes = Bytesˉslice(Module, 0u32, 0u32);
    let Invalid: Extendedˉexecution = Extendedˉexecution(
        false, false, Empty, 0u32, Empty, false, Empty,
        Empty, Empty, Empty, Empty, Empty, 0u32, Empty, Empty,
        0u32, false, 0u32, 0u32
    );
    let Recordˉcapacity: u32 = 768u32;
    let Recordˉmetadataˉlength: u32 = Recordˉcapacity * 8u32;
    let Recordˉzeroˉslots: bytes = Bytesˉslice(
        Initialˉrecordˉmetadata, 0u32, Recordˉcapacity
    );
    let Stackˉdescriptorˉcount: u32 = Bytesˉlength(Initialˉstack) / 8u32;
    var Stack: bytes = Initialˉstack;
    var Sectionˉkind: u32 = 0u32;
    var Releasedˉdescriptors: bytes = Empty;
    var Heapˉallocationˉrequested: bool = false;
    var Heapˉallocationˉvalue: bytes = Empty;
    var Heap: bytes = Initialˉheap;
    var Recordˉmetadata: bytes = Initialˉrecordˉmetadata;
    var Records: bytes = Initialˉrecords;
    var Heapˉallocations: bytes = Initialˉheapˉallocations;
    var Locals: bytes = Initialˉlocals;
    var Stackˉconsumed: u32 = Initialˉconsumed;
    var Stackˉproduced: bool = Initialˉproduced;
    var Stackˉproducedˉkind: u32 = Initialˉproducedˉkind;
    var Aggregateˉinstructions: u32 = 0u32;
    var Mainˉfound: bool = false;

    if Payloadˉlength <= 103u32 {
        Stack = Executeˉbaseˉcomparison(
            Payloadˉlength, Stack, Zeroˉvalue
        );
        if Bytesˉlength(Stack) == 0u32 { return Invalid; }
        Aggregateˉinstructions = Aggregateˉinstructions + 1u32;
        Mainˉfound = true;
    }

    if Payloadˉlength == 104u32 || Payloadˉlength == 151u32 ||
        Payloadˉlength == 197u32 {
        let Recordˉcreation: bytes = Aggregateˉcreation(
            Module,
            Typeˉoffsets,
            Payloadˉlength,
            Payload
        );
        if Bytesˉlength(Recordˉcreation) != 12u32 { return Invalid; }
        let Recordˉowner: u32 = Bytesˉreadˉu32ˉlittle(
            Recordˉcreation,
            0u32
        );
        let Recordˉfieldˉcount: u32 = Bytesˉreadˉu32ˉlittle(
            Recordˉcreation,
            4u32
        );
        let Recordˉtypeˉcursor: u32 = Bytesˉreadˉu32ˉlittle(
            Recordˉcreation,
            8u32
        ) - 4u32;
        Stackˉconsumed = Recordˉfieldˉcount;
        Stackˉproduced = true;
        Stackˉproducedˉkind = 2u32;
        let Recordˉfieldˉbytes: u32 = Recordˉfieldˉcount * 8u32;
        let Recordˉstackˉlength: u32 = Bytesˉlength(Stack);
        let Recordˉfields: bytes = Bytesˉslice(
            Stack,
            Recordˉstackˉlength - Recordˉfieldˉbytes,
            Recordˉfieldˉbytes
        );
        Stack = Bytesˉslice(
            Stack,
            0u32,
            Recordˉstackˉlength - Recordˉfieldˉbytes
        );

        var Recordˉslot: u32 = Recordˉcapacity;
        if Recordˉfieldˉcount == 0u32 {
            Recordˉslot = 4294967295u32;
        } else {
            var Recordˉallocationˉpass: u32 = 0u32;
            while Recordˉallocationˉpass < 2u32 {
                if Recordˉslot == Recordˉcapacity {
                    var Recordˉcandidateˉslot: u32 = 0u32;
                    var Recordˉscanˉslot: u32 = 0u32;
                    while Recordˉscanˉslot < Recordˉcapacity {
                        let Recordˉstoredˉsize: u32 =
                            Bytesˉreadˉu32ˉlittle(
                                Recordˉmetadata,
                                Recordˉscanˉslot * 8u32 + 4u32
                            );
                        if Recordˉstoredˉsize == 0u32 {
                            Recordˉscanˉslot = Recordˉscanˉslot + 1u32;
                        } else {
                            if Recordˉslot == Recordˉcapacity {
                                if Recordˉcandidateˉslot
                                    <= Recordˉscanˉslot {
                                    if Recordˉfieldˉcount
                                        <= Recordˉscanˉslot
                                            - Recordˉcandidateˉslot {
                                        Recordˉslot =
                                            Recordˉcandidateˉslot;
                                    }
                                }
                            }
                            Recordˉcandidateˉslot = Recordˉscanˉslot
                                + Recordˉstoredˉsize;
                            Recordˉscanˉslot = Recordˉcandidateˉslot;
                        }
                    }
                    if Recordˉslot == Recordˉcapacity {
                        if Recordˉcandidateˉslot <= Recordˉcapacity {
                            if Recordˉfieldˉcount
                                <= Recordˉcapacity - Recordˉcandidateˉslot {
                                Recordˉslot = Recordˉcandidateˉslot;
                            }
                        }
                    }

                    if Recordˉslot == Recordˉcapacity {
                        if Recordˉallocationˉpass == 0u32 {
                            var Recordˉmarks: bytes = Bytesˉslice(
                                Recordˉzeroˉslots,
                                0u32,
                                Recordˉcapacity
                            );
                            // Dynamic stack flags and verified static shapes
                            // admit only actual record cells as roots.
                            var Recordˉreachableˉvalues: bytes =
                                Stackˉaggregateˉroots(
                                    Stack,
                                    Stackˉrecordˉflagsˉlow,
                                    Stackˉrecordˉflagsˉhigh
                                );
                            Recordˉreachableˉvalues = Bytesˉconcat(
                                Recordˉreachableˉvalues,
                                Aggregateˉselectedˉownerˉvalues(
                                    Module,
                                    Typeˉoffsets,
                                    Recordˉowner,
                                    Recordˉfieldˉcount,
                                    Recordˉfields,
                                    0u32,
                                    false
                                )
                            );
                            let Recordˉactiveˉshapeˉoffset: u32 =
                                Bytesˉreadˉu32ˉlittle(
                                    Functionˉshapeˉoffsets,
                                    Functionˉindex * 4u32
                                );
                            Recordˉreachableˉvalues = Bytesˉconcat(
                                Recordˉreachableˉvalues,
                                Localˉaggregateˉroots(
                                    Locals,
                                    0u32,
                                    Localˉshapes,
                                    Recordˉactiveˉshapeˉoffset,
                                    Functionˉcursor
                                )
                            );
                            let Recordˉframeˉroots: bytes =
                                Frameˉaggregateˉroots(
                                    Frames,
                                    Functionˉcount,
                                    Functionˉframeˉmetadata,
                                    Functionˉshapeˉoffsets,
                                    Localˉshapes
                                );
                            if Bytesˉlength(Recordˉframeˉroots) == 0u32 {
                                return Invalid;
                            }
                            Recordˉreachableˉvalues = Bytesˉconcat(
                                Recordˉreachableˉvalues,
                                Bytesˉslice(
                                    Recordˉframeˉroots,
                                    1u32,
                                    Bytesˉlength(Recordˉframeˉroots) - 1u32
                                )
                            );
                            Recordˉreachableˉvalues = Bytesˉconcat(
                                Recordˉreachableˉvalues,
                                Tasks.Retainedˉroots(Taskˉstate)
                            );
                            let Recordˉmarkˉscan: bytes =
                                Markˉaggregateˉroots(
                                    Module,
                                    Typeˉoffsets,
                                    Records,
                                    Recordˉmetadata,
                                    Recordˉcapacity,
                                    Recordˉmarks,
                                    Recordˉreachableˉvalues
                                );
                            if Bytesˉlength(Recordˉmarkˉscan)
                                != Recordˉcapacity {
                                return Invalid;
                            }
                            Recordˉmarks = Recordˉmarkˉscan;

                            let Recordˉsweep: bytes =
                                Sweepˉaggregates(
                                    Module,
                                    Typeˉoffsets,
                                    Records,
                                    Recordˉmetadata,
                                    Recordˉmarks,
                                    Recordˉcapacity,
                                    Zeroˉcell
                                );
                            if Bytesˉlength(Recordˉsweep)
                                < Recordˉmetadataˉlength {
                                return Invalid;
                            }
                            Recordˉmetadata = Bytesˉslice(
                                Recordˉsweep,
                                0u32,
                                Recordˉmetadataˉlength
                            );
                            Releasedˉdescriptors = Bytesˉconcat(
                                Releasedˉdescriptors,
                                Bytesˉslice(
                                    Recordˉsweep,
                                    Recordˉmetadataˉlength,
                                    Bytesˉlength(Recordˉsweep)
                                        - Recordˉmetadataˉlength
                                )
                            );
                        }
                    }
                }
                Recordˉallocationˉpass =
                    Recordˉallocationˉpass + 1u32;
            }
        }

        if Recordˉslot == Recordˉcapacity {
            Sectionˉkind = 3017u32;
        } else {
            if Recordˉfieldˉcount > 0u32 {
                let Recordˉmetadataˉoffset: u32 =
                    Recordˉslot * 8u32;
                let Recordˉmetadataˉprefix: bytes = Bytesˉslice(
                    Recordˉmetadata,
                    0u32,
                    Recordˉmetadataˉoffset
                );
                let Recordˉmetadataˉsuffix: bytes = Bytesˉslice(
                    Recordˉmetadata,
                    Recordˉmetadataˉoffset + 8u32,
                    Recordˉmetadataˉlength
                        - 8u32
                        - Recordˉmetadataˉoffset
                );
                let Recordˉmetadataˉallocation: bytes = Bytesˉconcat(
                    Bytesˉfromˉu32ˉlittle(Recordˉowner),
                    Bytesˉfromˉu32ˉlittle(Recordˉfieldˉcount)
                );
                Recordˉmetadata = Bytesˉconcat(
                    Bytesˉconcat(
                        Recordˉmetadataˉprefix,
                        Recordˉmetadataˉallocation
                    ),
                    Recordˉmetadataˉsuffix
                );

                let Recordˉbyteˉoffset: u32 = Recordˉslot * 8u32;
                let Recordˉbyteˉend: u32 = Recordˉbyteˉoffset
                    + Recordˉfieldˉbytes;
                if Recordˉbyteˉend > Bytesˉlength(Records) {
                    if Recordˉbyteˉoffset > Bytesˉlength(Records) {
                        return Invalid;
                    }
                    Records = Bytesˉconcat(
                        Bytesˉslice(Records, 0u32, Recordˉbyteˉoffset),
                        Recordˉfields
                    );
                } else {
                    let Recordˉprefix: bytes = Bytesˉslice(
                        Records,
                        0u32,
                        Recordˉbyteˉoffset
                    );
                    let Recordˉsuffix: bytes = Bytesˉslice(
                        Records,
                        Recordˉbyteˉend,
                        Bytesˉlength(Records) - Recordˉbyteˉend
                    );
                    Records = Bytesˉconcat(
                        Bytesˉconcat(Recordˉprefix, Recordˉfields),
                        Recordˉsuffix
                    );
                }
            }
            Stack = Bytesˉconcat(
                Stack,
                Bytesˉconcat(
                    Bytesˉfromˉu32ˉlittle(Recordˉslot),
                    Bytesˉfromˉu32ˉlittle(Recordˉowner)
                )
            );
        }
        if Payloadˉlength == 104u32 || Payloadˉlength == 197u32 {
            Aggregateˉinstructions = Aggregateˉinstructions + 5u32;
        } else {
            Aggregateˉinstructions = Aggregateˉinstructions + 9u32;
        }
        Mainˉfound = true;
    }
    if Payloadˉlength == 152u32 {
        let Variantˉtestedˉstack: bytes = Variantˉcaseˉtest(
            Module,
            Payload,
            Stack,
            Zeroˉvalue
        );
        if Bytesˉlength(Variantˉtestedˉstack) != Bytesˉlength(Stack) {
            return Invalid;
        }
        Stack = Variantˉtestedˉstack;
        Stackˉconsumed = 1u32;
        Stackˉproduced = true;
        Stackˉproducedˉkind = 0u32;
        Aggregateˉinstructions = Aggregateˉinstructions + 9u32;
        Mainˉfound = true;
    }
    if Payloadˉlength == 105u32 || Payloadˉlength == 153u32 ||
        Payloadˉlength == 196u32 {
        var Fieldˉindex: u32 = Bytesˉreadˉu32ˉlittle(
            Module,
            Payload + 1u32
        );
        let Fieldˉstackˉlength: u32 = Bytesˉlength(Stack);
        let Fieldˉrecordˉslot: u32 = Bytesˉreadˉu32ˉlittle(
            Stack,
            Fieldˉstackˉlength - 8u32
        );
        let Fieldˉrecordˉtoken: u32 = Bytesˉreadˉu32ˉlittle(
            Stack,
            Fieldˉstackˉlength - 4u32
        );
        Stack = Bytesˉslice(Stack, 0u32, Fieldˉstackˉlength - 8u32);
        var Selectedˉfieldˉcursor: u32 = 0u32;
        if Payloadˉlength == 105u32 {
            let Fieldˉrecordˉdirectory: bytes =
                Aggregateˉfieldˉdirectory(
                    Module,
                    Typeˉoffsets,
                    Fieldˉrecordˉtoken
                );
            if Bytesˉlength(Fieldˉrecordˉdirectory) != 8u32 {
                return Invalid;
            }
            Selectedˉfieldˉcursor = Fieldˉshapeˉat(
                Module,
                Bytesˉreadˉu32ˉlittle(Fieldˉrecordˉdirectory, 4u32),
                Fieldˉindex
            );
        } else {
            let Fieldˉvariantˉselection: bytes = Variantˉfieldˉselection(
                Module,
                Typeˉoffsets,
                Payloadˉlength,
                Payload
            );
            if Bytesˉlength(Fieldˉvariantˉselection) != 12u32 {
                return Invalid;
            }
            Fieldˉindex = Bytesˉreadˉu32ˉlittle(
                Fieldˉvariantˉselection,
                4u32
            );
            Selectedˉfieldˉcursor = Bytesˉreadˉu32ˉlittle(
                Fieldˉvariantˉselection,
                8u32
            );
            if Fieldˉrecordˉtoken != Bytesˉreadˉu32ˉlittle(
                Fieldˉvariantˉselection,
                0u32
            ) {
                Sectionˉkind = 3017u32;
            }
        }
        var Fieldˉvalue: bytes = Zeroˉcell;
        if Sectionˉkind == 0u32 {
            if Fieldˉrecordˉslot == 4294967295u32 {
                Fieldˉvalue = Defaultˉfieldˉvalue(
                    Module,
                    Typeˉoffsets,
                    Selectedˉfieldˉcursor,
                    Zeroˉcell
                );
            } else {
                Fieldˉvalue = Bytesˉslice(
                    Records,
                    Fieldˉrecordˉslot * 8u32 + Fieldˉindex * 8u32,
                    8u32
                );
            }
        }
        let Selectedˉfieldˉkind: u32 = U32ˉfromˉu8(
            Bytesˉreadˉu8(Module, Selectedˉfieldˉcursor)
        );
        Stackˉconsumed = 1u32;
        Stackˉproduced = true;
        let Fieldˉrequiresˉretain: bool =
            Selectedˉfieldˉkind == 3u32 || Selectedˉfieldˉkind == 6u32 ||
            (Bytesˉreadˉu16ˉlittle(Module, 6u32) >= 28u32 &&
                Selectedˉfieldˉkind == 23u32 &&
                Payloadˉlength != 153u32);
        if Fieldˉrequiresˉretain {
            Stackˉproducedˉkind = 1u32;
        }
        if Selectedˉfieldˉkind == 7u32 || Selectedˉfieldˉkind == 11u32 ||
            Selectedˉfieldˉkind == 22u32 {
            Stackˉproducedˉkind = 2u32;
        }
        if Selectedˉfieldˉkind == 23u32 {
            Stackˉproducedˉkind = 3u32;
        }
        if Fieldˉrequiresˉretain {
            let Retainedˉallocations: bytes = Retainˉdescriptor(
                Heapˉallocations,
                Heapˉallocationˉcount,
                Fieldˉvalue
            );
            if Bytesˉreadˉu32ˉlittle(Fieldˉvalue, 4u32) > 0u32 {
                if Bytesˉlength(Retainedˉallocations) == 0u32 {
                    return Invalid;
                }
            }
            if Bytesˉlength(Retainedˉallocations)
                != Bytesˉlength(Heapˉallocations) {
                return Invalid;
            }
            Heapˉallocations = Retainedˉallocations;
        }
        Stack = Bytesˉconcat(Stack, Fieldˉvalue);
        if Payloadˉlength == 105u32 {
            Aggregateˉinstructions = Aggregateˉinstructions + 5u32;
        } else {
            Aggregateˉinstructions = Aggregateˉinstructions + 9u32;
        }
        Mainˉfound = true;
    }
    if Payloadˉlength == 198u32 {
        let Arrayˉelementˉstackˉlength: u32 = Bytesˉlength(Stack);
        if Arrayˉelementˉstackˉlength < 16u32 { return Invalid; }
        let Arrayˉelementˉindexˉlow: u32 = Bytesˉreadˉu32ˉlittle(
            Stack, Arrayˉelementˉstackˉlength - 8u32
        );
        let Arrayˉelementˉindexˉhigh: u32 = Bytesˉreadˉu32ˉlittle(
            Stack, Arrayˉelementˉstackˉlength - 4u32
        );
        let Arrayˉelementˉslot: u32 = Bytesˉreadˉu32ˉlittle(
            Stack, Arrayˉelementˉstackˉlength - 16u32
        );
        let Arrayˉelementˉowner: u32 = Bytesˉreadˉu32ˉlittle(
            Stack, Arrayˉelementˉstackˉlength - 12u32
        );
        Stack = Bytesˉslice(
            Stack, 0u32, Arrayˉelementˉstackˉlength - 16u32
        );
        if Arrayˉelementˉowner == 0u32 ||
            Arrayˉelementˉowner >= 2147483648u32 {
            return Invalid;
        }
        let Arrayˉelementˉdirectory: bytes = Aggregateˉfieldˉdirectory(
            Module, Typeˉoffsets, Arrayˉelementˉowner
        );
        if Bytesˉlength(Arrayˉelementˉdirectory) != 8u32 {
            return Invalid;
        }
        let Arrayˉelementˉcount: u32 = Bytesˉreadˉu32ˉlittle(
            Arrayˉelementˉdirectory, 0u32
        );
        let Arrayˉelementˉshape: u32 = Bytesˉreadˉu32ˉlittle(
            Arrayˉelementˉdirectory, 4u32
        );
        if Arrayˉelementˉindexˉhigh != 0u32 ||
            Arrayˉelementˉindexˉlow >= Arrayˉelementˉcount {
            Sectionˉkind = 3008u32;
        }
        var Arrayˉelementˉvalue: bytes = Zeroˉcell;
        if Sectionˉkind == 0u32 {
            if Arrayˉelementˉslot == 4294967295u32 {
                Arrayˉelementˉvalue = Defaultˉfieldˉvalue(
                    Module,
                    Typeˉoffsets,
                    Arrayˉelementˉshape,
                    Zeroˉcell
                );
            } else {
                Arrayˉelementˉvalue = Bytesˉslice(
                    Records,
                    (Arrayˉelementˉslot + Arrayˉelementˉindexˉlow) * 8u32,
                    8u32
                );
            }
        }
        let Arrayˉelementˉkind: u32 = U32ˉfromˉu8(
            Bytesˉreadˉu8(Module, Arrayˉelementˉshape)
        );
        Stackˉconsumed = 2u32;
        Stackˉproduced = true;
        if Arrayˉelementˉkind == 3u32 || Arrayˉelementˉkind == 6u32 {
            Stackˉproducedˉkind = 1u32;
        }
        if Arrayˉelementˉkind == 7u32 || Arrayˉelementˉkind == 11u32 ||
            Arrayˉelementˉkind == 22u32 {
            Stackˉproducedˉkind = 2u32;
        }
        if Arrayˉelementˉkind == 23u32 {
            Stackˉproducedˉkind = 3u32;
        }
        if Sectionˉkind == 0u32 {
            if Arrayˉelementˉkind == 3u32 || Arrayˉelementˉkind == 6u32 ||
                (Bytesˉreadˉu16ˉlittle(Module, 6u32) >= 28u32 &&
                    Arrayˉelementˉkind == 23u32) {
                let Arrayˉelementˉretainedˉallocations: bytes =
                    Retainˉdescriptor(
                        Heapˉallocations,
                        Heapˉallocationˉcount,
                        Arrayˉelementˉvalue
                    );
                if Bytesˉreadˉu32ˉlittle(Arrayˉelementˉvalue, 4u32) > 0u32 &&
                    Bytesˉlength(Arrayˉelementˉretainedˉallocations) == 0u32 {
                    return Invalid;
                }
                if Bytesˉlength(Arrayˉelementˉretainedˉallocations) !=
                    Bytesˉlength(Heapˉallocations) {
                    return Invalid;
                }
                Heapˉallocations = Arrayˉelementˉretainedˉallocations;
            }
            Stack = Bytesˉconcat(Stack, Arrayˉelementˉvalue);
        }
        Aggregateˉinstructions = Aggregateˉinstructions + 1u32;
        Mainˉfound = true;
    }
    let Collection: Collectionˉexecution = Executeˉcollection(
        Module,
        Typeˉoffsets,
        Typeˉcount,
        Payload,
        Payloadˉlength,
        Stack,
        Stackˉconsumed,
        Stackˉproduced,
        Stackˉproducedˉkind,
        Zeroˉvalue,
        Zeroˉcell,
        Heap,
        Heapˉallocations,
        Heapˉallocationˉcount,
        Stackˉdescriptorˉflagsˉlow,
        Stackˉdescriptorˉflagsˉhigh,
        Stackˉcollectionˉflagsˉlow,
        Stackˉcollectionˉflagsˉhigh,
        Stackˉvectorˉflagsˉlow,
        Stackˉvectorˉflagsˉhigh,
        Functionˉshapeˉoffsets,
        Functionˉparameterˉmodeˉoffsets,
        Functionˉparameterˉmodes,
        Functionˉindex,
        Locals,
        Localˉshapes,
        Functionˉcursor,
        Functionˉframeˉmetadata
    );
    if !Collection.Valid { return Invalid; }
    if Collection.Handled {
        Stack = Collection.Stack;
        Sectionˉkind = Collection.Status;
        Heapˉallocationˉrequested = Collection.Allocationˉrequested;
        Heapˉallocationˉvalue = Collection.Allocationˉvalue;
        Heap = Collection.Heap;
        Heapˉallocations = Collection.Heapˉallocations;
        Locals = Collection.Locals;
        Stackˉconsumed = Collection.Consumed;
        Stackˉproduced = Collection.Produced;
        Stackˉproducedˉkind = Collection.Producedˉkind;
        Aggregateˉinstructions =
            Aggregateˉinstructions + Collection.Instructions;
        Mainˉfound = true;
    }

    return Extendedˉexecution(
        true, Mainˉfound, Stack, Sectionˉkind, Releasedˉdescriptors,
        Heapˉallocationˉrequested, Heapˉallocationˉvalue, Heap,
        Recordˉmetadata, Records, Heapˉallocations, Empty, 0u32, Empty,
        Locals,
        Stackˉconsumed, Stackˉproduced, Stackˉproducedˉkind,
        Aggregateˉinstructions
    );
}

fn Executeˉextended(
    Module: bytes,
    Typeˉoffsets: bytes,
    Typeˉcount: u32,
    Payload: u32,
    Payloadˉlength: u32,
    Initialˉstack: bytes,
    Initialˉconsumed: u32,
    Initialˉproduced: bool,
    Initialˉproducedˉkind: u32,
    Zeroˉvalue: bytes,
    Zeroˉcell: bytes,
    Initialˉheap: bytes,
    Initialˉheapˉallocations: bytes,
    Initialˉheapˉallocationˉcount: u32,
    Initialˉmemoryˉbudgetˉstate: bytes,
    Initialˉallocationˉleases: bytes,
    Initialˉrecordˉmetadata: bytes,
    Initialˉrecords: bytes,
    Initialˉtaskˉstate: bytes,
    Stackˉdescriptorˉflagsˉlow: u32,
    Stackˉdescriptorˉflagsˉhigh: u32,
    Stackˉrecordˉflagsˉlow: u32,
    Stackˉrecordˉflagsˉhigh: u32,
    Stackˉcollectionˉflagsˉlow: u32,
    Stackˉcollectionˉflagsˉhigh: u32,
    Stackˉvectorˉflagsˉlow: u32,
    Stackˉvectorˉflagsˉhigh: u32,
    Functionˉshapeˉoffsets: bytes,
    Functionˉparameterˉmodeˉoffsets: bytes,
    Functionˉparameterˉmodes: bytes,
    Functionˉindex: u32,
    Mainˉindex: u32,
    Mainˉhasˉmemoryˉbudget: bool,
    Mainˉhasˉsourceˉfile: bool,
    Sourceˉproviderˉgeneration: u32,
    Initialˉlocals: bytes,
    Localˉshapes: bytes,
    Functionˉcursor: u32,
    Frames: bytes,
    Functionˉcount: u32,
    Functionˉframeˉmetadata: bytes
) -> Extendedˉexecution {
    let Empty: bytes = Bytesˉslice(Module, 0u32, 0u32);
    let Invalid: Extendedˉexecution = Extendedˉexecution(
        false, false, Empty, 0u32, Empty, false, Empty,
        Empty, Empty, Empty, Empty, Empty, 0u32, Empty, Empty,
        0u32, false, 0u32, 0u32
    );
    let Recordˉcapacity: u32 = 768u32;
    let Recordˉmetadataˉlength: u32 = Recordˉcapacity * 8u32;
    let Recordˉzeroˉslots: bytes = Bytesˉslice(
        Initialˉrecordˉmetadata, 0u32, Recordˉcapacity
    );
    let Stackˉdescriptorˉcount: u32 = Bytesˉlength(Initialˉstack) / 8u32;
    var Stack: bytes = Initialˉstack;
    var Sectionˉkind: u32 = 0u32;
    var Releasedˉdescriptors: bytes = Empty;
    var Heapˉallocationˉrequested: bool = false;
    var Heapˉallocationˉvalue: bytes = Empty;
    var Heap: bytes = Initialˉheap;
    var Recordˉmetadata: bytes = Initialˉrecordˉmetadata;
    var Records: bytes = Initialˉrecords;
    var Heapˉallocations: bytes = Initialˉheapˉallocations;
    var Memoryˉbudgetˉstate: bytes = Initialˉmemoryˉbudgetˉstate;
    var Heapˉallocationˉcount: u32 = Initialˉheapˉallocationˉcount;
    var Allocationˉleases: bytes = Initialˉallocationˉleases;
    var Locals: bytes = Initialˉlocals;
    var Stackˉconsumed: u32 = Initialˉconsumed;
    var Stackˉproduced: bool = Initialˉproduced;
    var Stackˉproducedˉkind: u32 = Initialˉproducedˉkind;
    var Aggregateˉinstructions: u32 = 0u32;
    var Mainˉfound: bool = false;

    if Payloadˉlength == 210u32 {
        if Bytesˉreadˉu16ˉlittle(Module, 6u32) < 29u32 ||
            !Mainˉhasˉsourceˉfile || Functionˉindex != Mainˉindex ||
            Sourceˉproviderˉgeneration == 0u32 {
            return Invalid;
        }
        let Sourceˉlocalˉindex: u32 = Bytesˉreadˉu32ˉlittle(
            Module, Payload + 1u32
        );
        let Sourceˉparameterˉcount: u32 = Bytesˉreadˉu32ˉlittle(
            Functionˉframeˉmetadata, Functionˉindex * 8u32
        );
        if Sourceˉlocalˉindex < Sourceˉparameterˉcount ||
            Sourceˉlocalˉindex >= Functionˉcursor / 8u32 {
            return Invalid;
        }
        let Sourceˉlocalˉoffset: u32 = Sourceˉlocalˉindex * 8u32;
        let Sourceˉshapeˉoffset: u32 = Bytesˉreadˉu32ˉlittle(
            Functionˉshapeˉoffsets, Functionˉindex * 4u32
        ) + Sourceˉlocalˉoffset;
        if Bytesˉreadˉu32ˉlittle(
            Localˉshapes, Sourceˉshapeˉoffset
        ) != 34u32 {
            return Invalid;
        }
        let Sourceˉlength: u32 = Bytesˉreadˉu32ˉlittle(
            Locals, Sourceˉlocalˉoffset
        );
        let Sourceˉgeneration: u32 = Bytesˉreadˉu32ˉlittle(
            Locals, Sourceˉlocalˉoffset + 4u32
        );
        if Sourceˉlength > 1048576u32 ||
            Sourceˉgeneration != Sourceˉproviderˉgeneration {
            return Invalid;
        }
        Stack = Bytesˉconcat(
            Stack,
            Bytesˉconcat(
                Bytesˉfromˉu32ˉlittle(Sourceˉlength),
                Bytesˉfromˉu32ˉlittle(0u32)
            )
        );
        Stackˉconsumed = 0u32;
        Stackˉproduced = true;
        Stackˉproducedˉkind = 0u32;
        Aggregateˉinstructions = Aggregateˉinstructions + 5u32;
        Mainˉfound = true;
    }

    if Payloadˉlength == 206u32 {
        if !Mainˉhasˉmemoryˉbudget || Functionˉindex != Mainˉindex {
            return Invalid;
        }
        let Budgetˉresult: Memoryˉbudgetˉexecution =
            Executeˉmemoryˉbudgetˉsplit(
                Module,
                Typeˉoffsets,
                Payload,
                Stack,
                Locals,
                Memoryˉbudgetˉstate,
                Recordˉmetadata,
                Records,
                Zeroˉcell
            );
        if !Budgetˉresult.Valid { return Invalid; }
        Stack = Budgetˉresult.Stack;
        Memoryˉbudgetˉstate = Budgetˉresult.State;
        Recordˉmetadata = Budgetˉresult.Metadata;
        Records = Budgetˉresult.Records;
        Stackˉconsumed = 2u32;
        Stackˉproduced = true;
        Stackˉproducedˉkind = 2u32;
        Aggregateˉinstructions = Aggregateˉinstructions + 9u32;
        Mainˉfound = true;
    }

    if Payloadˉlength == 207u32 {
        let Vectorˉmoduleˉminor: u32 = Bytesˉreadˉu16ˉlittle(Module, 6u32);
        if (Vectorˉmoduleˉminor < 24u32 || Vectorˉmoduleˉminor > 28u32) ||
            !Mainˉhasˉmemoryˉbudget || Functionˉindex != Mainˉindex {
            return Invalid;
        }
        let Vectorˉresult: Vectorˉconstructˉexecution =
            Executeˉvectorˉconstructˉreserved(
                Module, Typeˉoffsets, Typeˉcount, Payload, Stack,
                Locals, Memoryˉbudgetˉstate, Recordˉmetadata, Records,
                Heap, Heapˉallocations, Heapˉallocationˉcount,
                Allocationˉleases, Zeroˉcell
            );
        if !Vectorˉresult.Valid { return Invalid; }
        Sectionˉkind = Vectorˉresult.Status;
        Stack = Vectorˉresult.Stack;
        Locals = Vectorˉresult.Locals;
        Memoryˉbudgetˉstate = Vectorˉresult.State;
        Recordˉmetadata = Vectorˉresult.Metadata;
        Records = Vectorˉresult.Records;
        Heap = Vectorˉresult.Heap;
        Heapˉallocations = Vectorˉresult.Heapˉallocations;
        Heapˉallocationˉcount = Vectorˉresult.Heapˉallocationˉcount;
        Allocationˉleases = Vectorˉresult.Allocationˉleases;
        Stackˉconsumed = 1u32;
        Stackˉproduced = Sectionˉkind == 0u32;
        Stackˉproducedˉkind = 2u32;
        Aggregateˉinstructions = Aggregateˉinstructions + 9u32;
        Mainˉfound = true;
    }

    if Payloadˉlength == 208u32 {
        if (Bytesˉreadˉu16ˉlittle(Module, 6u32) < 25u32 ||
            Bytesˉreadˉu16ˉlittle(Module, 6u32) > 28u32) ||
            !Mainˉhasˉmemoryˉbudget || Functionˉindex != Mainˉindex {
            return Invalid;
        }
        let Appendˉresult: Vectorˉappendˉexecution =
            Executeˉvectorˉappend(
                Module, Typeˉoffsets, Typeˉcount, Payload, Stack, Locals,
                Recordˉmetadata, Records, Heap, Heapˉallocations,
                Heapˉallocationˉcount, Zeroˉcell
            );
        if !Appendˉresult.Valid { return Invalid; }
        Stack = Appendˉresult.Stack;
        Recordˉmetadata = Appendˉresult.Metadata;
        Records = Appendˉresult.Records;
        Heap = Appendˉresult.Heap;
        Stackˉconsumed = 1u32;
        Stackˉproduced = true;
        Stackˉproducedˉkind = 2u32;
        Aggregateˉinstructions = Aggregateˉinstructions + 9u32;
        Mainˉfound = true;
    }

    if Payloadˉlength == 209u32 {
        if (Bytesˉreadˉu16ˉlittle(Module, 6u32) < 27u32 ||
                Bytesˉreadˉu16ˉlittle(Module, 6u32) > 28u32) ||
            !Mainˉhasˉmemoryˉbudget || Functionˉindex != Mainˉindex {
            return Invalid;
        }
        let Growˉresult: Vectorˉgrowˉexecution =
            Executeˉvectorˉgrowˉreserved(
                Module, Typeˉoffsets, Typeˉcount, Payload, Stack, Locals,
                Memoryˉbudgetˉstate, Recordˉmetadata, Records,
                Heap, Heapˉallocations, Heapˉallocationˉcount,
                Allocationˉleases, Zeroˉcell
            );
        if !Growˉresult.Valid { return Invalid; }
        Sectionˉkind = Growˉresult.Status;
        Stack = Growˉresult.Stack;
        Locals = Growˉresult.Locals;
        Memoryˉbudgetˉstate = Growˉresult.State;
        Recordˉmetadata = Growˉresult.Metadata;
        Records = Growˉresult.Records;
        Heap = Growˉresult.Heap;
        Heapˉallocations = Growˉresult.Heapˉallocations;
        Heapˉallocationˉcount = Growˉresult.Heapˉallocationˉcount;
        Allocationˉleases = Growˉresult.Allocationˉleases;
        Stackˉconsumed = 1u32;
        Stackˉproduced = Sectionˉkind == 0u32;
        Stackˉproducedˉkind = 2u32;
        Aggregateˉinstructions = Aggregateˉinstructions + 13u32;
        Mainˉfound = true;
    }

    if Payloadˉlength == 80u32 {
        let Popˉstackˉlength: u32 = Bytesˉlength(Stack);
        if Stackˉdescriptorˉcount == 0u32 { return Invalid; }
        var Popˉisˉdescriptor: bool = false;
        if Stackˉdescriptorˉcount <= 32u32 {
            Popˉisˉdescriptor = ((Stackˉdescriptorˉflagsˉlow
                >> (Stackˉdescriptorˉcount - 1u32)) & 1u32) != 0u32;
        } else {
            Popˉisˉdescriptor = ((Stackˉdescriptorˉflagsˉhigh
                >> (Stackˉdescriptorˉcount - 33u32)) & 1u32) != 0u32;
        }
        let Popped: bytes = Bytesˉslice(
            Stack, Popˉstackˉlength - 8u32, 8u32
        );
        if Popˉisˉdescriptor {
            Releasedˉdescriptors = Bytesˉconcat(
                Releasedˉdescriptors, Popped
            );
        }
        if Stackˉflagˉset(
            Stackˉrecordˉflagsˉlow,
            Stackˉrecordˉflagsˉhigh,
            Stackˉdescriptorˉcount - 1u32
        ) {
            Releasedˉdescriptors = Bytesˉconcat(
                Releasedˉdescriptors,
                Leasedˉdescriptorˉfromˉrecord(
                    Records, Heapˉallocations, Heapˉallocationˉcount,
                    Allocationˉleases, Popped
                )
            );
        }
        Stack = Bytesˉslice(Stack, 0u32, Popˉstackˉlength - 8u32);
        Aggregateˉinstructions = Aggregateˉinstructions + 1u32;
        Mainˉfound = true;
    }

    if Payloadˉlength >= 96u32 {
    if Payloadˉlength <= 125u32 ||
        (Payloadˉlength >= 151u32 && Payloadˉlength <= 153u32) ||
        Payloadˉlength == 196u32 || Payloadˉlength == 197u32 ||
        Payloadˉlength == 198u32 ||
        (Payloadˉlength >= 199u32 && Payloadˉlength <= 205u32) {
    let Aggregate: Extendedˉexecution = Executeˉaggregate(
        Module,
        Typeˉoffsets,
        Typeˉcount,
        Payload,
        Payloadˉlength,
        Stack,
        Stackˉconsumed,
        Stackˉproduced,
        Stackˉproducedˉkind,
        Zeroˉvalue,
        Zeroˉcell,
        Heap,
        Heapˉallocations,
        Heapˉallocationˉcount,
        Recordˉmetadata,
        Records,
        Initialˉtaskˉstate,
        Stackˉdescriptorˉflagsˉlow,
        Stackˉdescriptorˉflagsˉhigh,
        Stackˉrecordˉflagsˉlow,
        Stackˉrecordˉflagsˉhigh,
        Stackˉcollectionˉflagsˉlow,
        Stackˉcollectionˉflagsˉhigh,
        Stackˉvectorˉflagsˉlow,
        Stackˉvectorˉflagsˉhigh,
        Functionˉshapeˉoffsets,
        Functionˉparameterˉmodeˉoffsets,
        Functionˉparameterˉmodes,
        Functionˉindex,
        Locals,
        Localˉshapes,
        Functionˉcursor,
        Frames,
        Functionˉcount,
        Functionˉframeˉmetadata
    );
    if !Aggregate.Valid { return Invalid; }
    if Aggregate.Handled {
        Stack = Aggregate.Stack;
        Sectionˉkind = Aggregate.Status;
        Releasedˉdescriptors = Bytesˉconcat(
            Releasedˉdescriptors, Aggregate.Releasedˉdescriptors
        );
        Heapˉallocationˉrequested = Aggregate.Allocationˉrequested;
        Heapˉallocationˉvalue = Aggregate.Allocationˉvalue;
        Heap = Aggregate.Heap;
        Recordˉmetadata = Aggregate.Recordˉmetadata;
        Records = Aggregate.Records;
        Heapˉallocations = Aggregate.Heapˉallocations;
        Locals = Aggregate.Locals;
        Stackˉconsumed = Aggregate.Consumed;
        Stackˉproduced = Aggregate.Produced;
        Stackˉproducedˉkind = Aggregate.Producedˉkind;
        Aggregateˉinstructions =
            Aggregateˉinstructions + Aggregate.Instructions;
        Mainˉfound = true;
    }

    if Payloadˉlength >= 106u32 && Payloadˉlength <= 109u32 {
        let Enumˉstate: Enumˉexecution = Executeˉenum(
            Module, Typeˉoffsets, Payload, Payloadˉlength, Stack
        );
        if Enumˉstate.Recognized {
            if !Enumˉstate.Valid { return Invalid; }
            Stack = Enumˉstate.Stack;
            if Enumˉstate.Allocationˉrequested {
                Heapˉallocationˉrequested = true;
                Heapˉallocationˉvalue = Enumˉstate.Allocationˉvalue;
            }
            Aggregateˉinstructions =
                Aggregateˉinstructions + Enumˉstate.Instructions;
            Mainˉfound = true;
        }
    }

    var Isˉintegerˉformat: bool = false;
    if Payloadˉlength == 110u32 { Isˉintegerˉformat = true; }
    if Payloadˉlength == 111u32 { Isˉintegerˉformat = true; }
    if Payloadˉlength == 112u32 { Isˉintegerˉformat = true; }
    if Isˉintegerˉformat {
        let Formatˉstackˉlength: u32 = Bytesˉlength(Stack);
        var Formatˉmode: u8 = 0u8;
        if Payloadˉlength == 110u32 { Formatˉmode = 1u8; }
        let Formattedˉvalue: bytes = Formatting.Interpreterˉformatˉinteger(
            Bytesˉconcat(
                Bytesˉfromˉu8(Formatˉmode),
                Bytesˉslice(Stack, Formatˉstackˉlength - 8u32, 8u32)
            )
        );
        if Bytesˉlength(Formattedˉvalue) == 0u32 { return Invalid; }
        Stack = Bytesˉslice(Stack, 0u32, Formatˉstackˉlength - 8u32);
        Heapˉallocationˉrequested = true;
        Heapˉallocationˉvalue = Formattedˉvalue;
        Aggregateˉinstructions = Aggregateˉinstructions + 1u32;
        Mainˉfound = true;
    }

    if Payloadˉlength == 117u32 {
        let Quoteˉstackˉlength: u32 = Bytesˉlength(Stack);
        let Quoteˉsourceˉoffset: u32 = Bytesˉreadˉu32ˉlittle(
            Stack,
            Quoteˉstackˉlength - 8u32
        );
        let Quoteˉsourceˉlength: u32 = Bytesˉreadˉu32ˉlittle(
            Stack,
            Quoteˉstackˉlength - 4u32
        );
        Stack = Bytesˉslice(Stack, 0u32, Quoteˉstackˉlength - 8u32);
        Releasedˉdescriptors = Bytesˉconcat(
            Releasedˉdescriptors,
            Bytesˉconcat(
                Bytesˉfromˉu32ˉlittle(Quoteˉsourceˉoffset),
                Bytesˉfromˉu32ˉlittle(Quoteˉsourceˉlength)
            )
        );
        let Quotedˉvalue: bytes = Quoteˉutf8(
            Heap,
            Quoteˉsourceˉoffset,
            Quoteˉsourceˉlength
        );
        let Quotedˉlength: u32 = Bytesˉlength(Quotedˉvalue);
        if Quotedˉlength > 16384u32 {
            Sectionˉkind = 3015u32;
        } else {
            Heapˉallocationˉrequested = true;
            Heapˉallocationˉvalue = Quotedˉvalue;
        }
        Aggregateˉinstructions = Aggregateˉinstructions + 1u32;
        Mainˉfound = true;
    }

    var Isˉdescriptorˉconcat: bool = false;
    if Payloadˉlength == 113u32 { Isˉdescriptorˉconcat = true; }
    if Payloadˉlength == 119u32 { Isˉdescriptorˉconcat = true; }
    if Isˉdescriptorˉconcat {
        var Descriptorˉconcatˉstack: u32 = Bytesˉlength(Stack);
        let Descriptorˉconcatˉrightˉoffset: u32 = Bytesˉreadˉu32ˉlittle(
            Stack,
            Descriptorˉconcatˉstack - 8u32
        );
        let Descriptorˉconcatˉrightˉlength: u32 = Bytesˉreadˉu32ˉlittle(
            Stack,
            Descriptorˉconcatˉstack - 4u32
        );
        Stack = Bytesˉslice(Stack, 0u32, Descriptorˉconcatˉstack - 8u32);
        Descriptorˉconcatˉstack = Bytesˉlength(Stack);
        let Descriptorˉconcatˉleftˉoffset: u32 = Bytesˉreadˉu32ˉlittle(
            Stack,
            Descriptorˉconcatˉstack - 8u32
        );
        let Descriptorˉconcatˉleftˉlength: u32 = Bytesˉreadˉu32ˉlittle(
            Stack,
            Descriptorˉconcatˉstack - 4u32
        );
        Stack = Bytesˉslice(Stack, 0u32, Descriptorˉconcatˉstack - 8u32);
        Releasedˉdescriptors = Bytesˉconcat(
            Releasedˉdescriptors,
            Bytesˉconcat(
                Bytesˉfromˉu32ˉlittle(Descriptorˉconcatˉleftˉoffset),
                Bytesˉfromˉu32ˉlittle(Descriptorˉconcatˉleftˉlength)
            )
        );
        Releasedˉdescriptors = Bytesˉconcat(
            Releasedˉdescriptors,
            Bytesˉconcat(
                Bytesˉfromˉu32ˉlittle(Descriptorˉconcatˉrightˉoffset),
                Bytesˉfromˉu32ˉlittle(Descriptorˉconcatˉrightˉlength)
            )
        );
        let Descriptorˉconcatˉlength: u32 =
            Descriptorˉconcatˉleftˉlength + Descriptorˉconcatˉrightˉlength;
        if Descriptorˉconcatˉlength > 16384u32 {
            Sectionˉkind = 3015u32;
        } else {
            Heapˉallocationˉrequested = true;
            Heapˉallocationˉvalue = Bytesˉconcat(
                Bytesˉslice(
                    Heap,
                    Descriptorˉconcatˉleftˉoffset,
                    Descriptorˉconcatˉleftˉlength
                ),
                Bytesˉslice(
                    Heap,
                    Descriptorˉconcatˉrightˉoffset,
                    Descriptorˉconcatˉrightˉlength
                )
            );
        }
        Aggregateˉinstructions = Aggregateˉinstructions + 1u32;
        Mainˉfound = true;
    }

    if Payloadˉlength == 114u32 {
        var Bytesˉreadˉi32ˉstack: u32 = Bytesˉlength(Stack);
        let Bytesˉreadˉi32ˉoffset: u32 = Bytesˉreadˉu32ˉlittle(
            Stack,
            Bytesˉreadˉi32ˉstack - 8u32
        );
        Stack = Bytesˉslice(Stack, 0u32, Bytesˉreadˉi32ˉstack - 8u32);
        Bytesˉreadˉi32ˉstack = Bytesˉlength(Stack);
        let Bytesˉreadˉi32ˉsourceˉoffset: u32 = Bytesˉreadˉu32ˉlittle(
            Stack,
            Bytesˉreadˉi32ˉstack - 8u32
        );
        let Bytesˉreadˉi32ˉsourceˉlength: u32 = Bytesˉreadˉu32ˉlittle(
            Stack,
            Bytesˉreadˉi32ˉstack - 4u32
        );
        Stack = Bytesˉslice(Stack, 0u32, Bytesˉreadˉi32ˉstack - 8u32);
        Releasedˉdescriptors = Bytesˉconcat(
            Releasedˉdescriptors,
            Bytesˉconcat(
                Bytesˉfromˉu32ˉlittle(Bytesˉreadˉi32ˉsourceˉoffset),
                Bytesˉfromˉu32ˉlittle(Bytesˉreadˉi32ˉsourceˉlength)
            )
        );
        var Bytesˉreadˉi32ˉvalid: bool = true;
        if Bytesˉreadˉi32ˉoffset > Bytesˉreadˉi32ˉsourceˉlength {
            Bytesˉreadˉi32ˉvalid = false;
        } else {
            if 4u32 > Bytesˉreadˉi32ˉsourceˉlength - Bytesˉreadˉi32ˉoffset {
                Bytesˉreadˉi32ˉvalid = false;
            }
        }
        if Bytesˉreadˉi32ˉvalid {
            Stack = Bytesˉconcat(
                Stack,
                Bytesˉconcat(
                    Bytesˉfromˉi32ˉlittle(Bytesˉreadˉi32ˉlittle(
                        Heap,
                        Bytesˉreadˉi32ˉsourceˉoffset + Bytesˉreadˉi32ˉoffset
                    )),
                    Zeroˉvalue
                )
            );
        } else {
            Sectionˉkind = 3008u32;
        }
        Aggregateˉinstructions = Aggregateˉinstructions + 1u32;
        Mainˉfound = true;
    }

    var Isˉutf8ˉinstruction: bool = false;
    if Payloadˉlength == 115u32 { Isˉutf8ˉinstruction = true; }
    if Payloadˉlength == 116u32 { Isˉutf8ˉinstruction = true; }
    if Isˉutf8ˉinstruction {
        let Utf8ˉstack: u32 = Bytesˉlength(Stack);
        let Utf8ˉsourceˉoffset: u32 = Bytesˉreadˉu32ˉlittle(
            Stack,
            Utf8ˉstack - 8u32
        );
        let Utf8ˉsourceˉlength: u32 = Bytesˉreadˉu32ˉlittle(
            Stack,
            Utf8ˉstack - 4u32
        );
        let Utf8ˉvalid: bool = Utf8ˉisˉvalid(
            Heap,
            Utf8ˉsourceˉoffset,
            Utf8ˉsourceˉlength
        );
        if Payloadˉlength == 115u32 {
            Stack = Bytesˉslice(Stack, 0u32, Utf8ˉstack - 8u32);
            Releasedˉdescriptors = Bytesˉconcat(
                Releasedˉdescriptors,
                Bytesˉconcat(
                    Bytesˉfromˉu32ˉlittle(Utf8ˉsourceˉoffset),
                    Bytesˉfromˉu32ˉlittle(Utf8ˉsourceˉlength)
                )
            );
            var Utf8ˉvalidˉflag: u32 = 0u32;
            if Utf8ˉvalid { Utf8ˉvalidˉflag = 1u32; }
            Stack = Bytesˉconcat(
                Stack,
                Bytesˉconcat(
                    Bytesˉfromˉu32ˉlittle(Utf8ˉvalidˉflag),
                    Zeroˉvalue
                )
            );
        }
        if Payloadˉlength == 116u32 {
            if Utf8ˉvalid {
                Stack = Stack;
            } else {
                Stack = Bytesˉslice(Stack, 0u32, Utf8ˉstack - 8u32);
                Sectionˉkind = 3014u32;
            }
        }
        Aggregateˉinstructions = Aggregateˉinstructions + 1u32;
        Mainˉfound = true;
    }

    if Payloadˉlength >= 120u32 {
        if Payloadˉlength <= 123u32 {
            let Constructorˉstack: u32 = Bytesˉlength(Stack);
            var Constructorˉvalid: bool = true;
            let Constructorˉu32: u32 = Bytesˉreadˉu32ˉlittle(
                Stack,
                Constructorˉstack - 8u32
            );
            if Payloadˉlength == 121u32 {
                if Constructorˉu32 > 65535u32 {
                    Constructorˉvalid = false;
                    Sectionˉkind = 3016u32;
                }
            }
            var Constructorˉvalue: bytes = Bytesˉslice(Heap, 0u32, 0u32);
            if Constructorˉvalid {
                if Payloadˉlength == 120u32 {
                    Constructorˉvalue = Bytesˉfromˉu8(Bytesˉreadˉu8(
                        Stack,
                        Constructorˉstack - 8u32
                    ));
                }
                if Payloadˉlength == 121u32 {
                    Constructorˉvalue = Bytesˉfromˉu16ˉlittle(
                        Constructorˉu32
                    );
                }
                if Payloadˉlength == 122u32 {
                    Constructorˉvalue = Bytesˉfromˉu32ˉlittle(
                        Constructorˉu32
                    );
                }
                if Payloadˉlength == 123u32 {
                    Constructorˉvalue = Bytesˉfromˉi32ˉlittle(
                        Bytesˉreadˉi32ˉlittle(
                            Stack,
                            Constructorˉstack - 8u32
                        )
                    );
                }
            }
            Stack = Bytesˉslice(Stack, 0u32, Constructorˉstack - 8u32);
            if Constructorˉvalid {
                Heapˉallocationˉrequested = true;
                Heapˉallocationˉvalue = Constructorˉvalue;
            }
            Aggregateˉinstructions = Aggregateˉinstructions + 1u32;
            Mainˉfound = true;
        }
    }
    if Payloadˉlength == 124u32 {
        Aggregateˉinstructions = Aggregateˉinstructions + 1u32;
        Mainˉfound = true;
    }
    if Payloadˉlength == 125u32 {
        let Sha256ˉstackˉlength: u32 = Bytesˉlength(Stack);
        let Sha256ˉsourceˉoffset: u32 = Bytesˉreadˉu32ˉlittle(
            Stack,
            Sha256ˉstackˉlength - 8u32
        );
        let Sha256ˉsourceˉlength: u32 = Bytesˉreadˉu32ˉlittle(
            Stack,
            Sha256ˉstackˉlength - 4u32
        );
        Stack = Bytesˉslice(Stack, 0u32, Sha256ˉstackˉlength - 8u32);
        Releasedˉdescriptors = Bytesˉconcat(
            Releasedˉdescriptors,
            Bytesˉconcat(
                Bytesˉfromˉu32ˉlittle(Sha256ˉsourceˉoffset),
                Bytesˉfromˉu32ˉlittle(Sha256ˉsourceˉlength)
            )
        );
        Heapˉallocationˉrequested = true;
        Heapˉallocationˉvalue =
            Sha256.Foundationˉsha256ˉhex(Bytesˉslice(
                Heap,
                Sha256ˉsourceˉoffset,
                Sha256ˉsourceˉlength
            ));
        Aggregateˉinstructions = Aggregateˉinstructions + 1u32;
        Mainˉfound = true;
    }
    if Payloadˉlength == 118u32 {
        Aggregateˉinstructions = Aggregateˉinstructions + 1u32;
        Mainˉfound = true;
    }
    }
    }

    return Extendedˉexecution(
        true,
        Mainˉfound,
        Stack,
        Sectionˉkind,
        Releasedˉdescriptors,
        Heapˉallocationˉrequested,
        Heapˉallocationˉvalue,
        Heap,
        Recordˉmetadata,
        Records,
        Heapˉallocations,
        Memoryˉbudgetˉstate,
        Heapˉallocationˉcount,
        Allocationˉleases,
        Locals,
        Stackˉconsumed,
        Stackˉproduced,
        Stackˉproducedˉkind,
        Aggregateˉinstructions
    );
}

fn Returningˉlocalˉdescriptors(
    Moduleˉminor: u32,
    Functionˉindex: u32,
    Functionˉcursor: u32,
    Functionˉshapeˉoffsets: bytes,
    Localˉshapes: bytes,
    Locals: bytes,
    Records: bytes,
    Heapˉallocations: bytes,
    Heapˉallocationˉcount: u32,
    Allocationˉleases: bytes
) -> bytes {
    var Released: bytes = Bytesˉslice(Locals, 0u32, 0u32);
    let Shapeˉoffset: u32 = Bytesˉreadˉu32ˉlittle(
        Functionˉshapeˉoffsets, Functionˉindex * 4u32
    );
    var Localˉoffset: u32 = Functionˉcursor;
    while Localˉoffset > 0u32 {
        Localˉoffset = Localˉoffset - 8u32;
        let Kind: u32 = Bytesˉreadˉu32ˉlittle(
            Localˉshapes, Shapeˉoffset + Localˉoffset
        );
        if Kind == 3u32 || Kind == 6u32 || Kind == 23u32 || Kind == 24u32 {
            Released = Bytesˉconcat(
                Released, Bytesˉslice(Locals, Localˉoffset, 8u32)
            );
        }
        if Kind == 11u32 && Moduleˉminor < 28u32 {
            Released = Bytesˉconcat(
                Released,
                Leasedˉdescriptorˉfromˉrecord(
                    Records, Heapˉallocations, Heapˉallocationˉcount,
                    Allocationˉleases,
                    Bytesˉslice(Locals, Localˉoffset, 8u32)
                )
            );
        }
    }
    return Released;
}

fn Returningˉaggregateˉcollection(
    Module: bytes,
    Typeˉoffsets: bytes,
    Records: bytes,
    Recordˉmetadata: bytes,
    Stack: bytes,
    Stackˉrecordˉflagsˉlow: u32,
    Stackˉrecordˉflagsˉhigh: u32,
    Returnˉisˉrecord: bool,
    Returnˉresult: bytes,
    Frames: bytes,
    Functionˉcount: u32,
    Functionˉframeˉmetadata: bytes,
    Functionˉshapeˉoffsets: bytes,
    Localˉshapes: bytes,
    Taskˉstate: bytes,
    Zeroˉcell: bytes
) -> Aggregateˉcollection {
    var Roots: bytes = Stackˉaggregateˉroots(
        Stack, Stackˉrecordˉflagsˉlow, Stackˉrecordˉflagsˉhigh
    );
    if Returnˉisˉrecord { Roots = Bytesˉconcat(Roots, Returnˉresult); }
    let Frameˉroots: bytes = Frameˉaggregateˉroots(
        Frames, Functionˉcount, Functionˉframeˉmetadata,
        Functionˉshapeˉoffsets, Localˉshapes
    );
    if Bytesˉlength(Frameˉroots) == 0u32 {
        return Aggregateˉcollection(
            false, Recordˉmetadata, Bytesˉslice(Module, 0u32, 0u32)
        );
    }
    Roots = Bytesˉconcat(
        Roots,
        Bytesˉslice(Frameˉroots, 1u32, Bytesˉlength(Frameˉroots) - 1u32)
    );
    Roots = Bytesˉconcat(Roots, Tasks.Retainedˉroots(Taskˉstate));
    return Collectˉunreachableˉaggregates(
        Module, Typeˉoffsets, Records, Recordˉmetadata, Roots, Zeroˉcell
    );
}

fn Initializeˉsourceˉfileˉlocals(
    Requestˉmajor: u32,
    Hasˉsourceˉfile: bool,
    Generation: u32,
    Guestˉinput: bytes,
    Locals: bytes,
    Functionˉcursor: u32
) -> bytes {
    if !Hasˉsourceˉfile { return Locals; }
    if Requestˉmajor != 5u32 || Functionˉcursor < 8u32 ||
        Generation == 0u32 ||
        Bytesˉlength(Guestˉinput) > 1048576u32 {
        return Bytesˉslice(Locals, 0u32, 0u32);
    }
    return Bytesˉconcat(
        Bytesˉconcat(
            Bytesˉfromˉu32ˉlittle(Bytesˉlength(Guestˉinput)),
            Bytesˉfromˉu32ˉlittle(Generation)
        ),
        Bytesˉslice(Locals, 8u32, Functionˉcursor - 8u32)
    );
}

record Closureˉcreation {
    Valid: bool;
    Stack: bytes;
    Consumed: u32;
    Environments: bytes;
}

fn Executeˉclosureˉcreation(
    Module: bytes,
    Typeˉoffsets: bytes,
    Typeˉcount: u32,
    Functionˉcount: u32,
    Payload: u32,
    Initialˉstack: bytes,
    Initialˉenvironments: bytes,
    Createdˉenvironments: u32,
    Functionˉframeˉmetadata: bytes
) -> Closureˉcreation {
    let Empty: bytes = Bytesˉslice(Module, 0u32, 0u32);
    let Invalid: Closureˉcreation = Closureˉcreation(
        false, Empty, 0u32, Empty
    );
    let Target: u32 = Bytesˉreadˉu32ˉlittle(Module, Payload + 1u32);
    let Callableˉtype: u32 = Bytesˉreadˉu32ˉlittle(
        Module, Payload + 5u32
    );
    let Captures: u32 = Bytesˉreadˉu32ˉlittle(Module, Payload + 9u32);
    if Target >= Functionˉcount || Callableˉtype >= Typeˉcount ||
        Createdˉenvironments >= 1024u32 ||
        Captures < 1u32 || Captures > 64u32 ||
        Bytesˉlength(Initialˉstack) / 8u32 < Captures {
        return Invalid;
    }
    let Descriptor: u32 = Bytesˉreadˉu32ˉlittle(
        Typeˉoffsets, Callableˉtype * 4u32
    );
    if U32ˉfromˉu8(Bytesˉreadˉu8(Module, Descriptor)) != 8u32 {
        return Invalid;
    }
    var Descriptorˉcursor: u32 = Descriptor + 2u32;
    Descriptorˉcursor = Descriptorˉcursor +
        Shapeˉwidthˉat(Module, Descriptorˉcursor);
    let Publicˉparameters: u32 = Bytesˉreadˉu32ˉlittle(
        Module, Descriptorˉcursor
    );
    if Bytesˉreadˉu32ˉlittle(
            Functionˉframeˉmetadata, Target * 8u32
        ) != Captures + Publicˉparameters {
        return Invalid;
    }
    let Environmentˉbytes: u32 = 12u32 + Captures * 8u32;
    if Bytesˉlength(Initialˉenvironments) >
            536576u32 - Environmentˉbytes {
        return Invalid;
    }
    let Environmentˉoffset: u32 = Bytesˉlength(Initialˉenvironments);
    let Captureˉoffset: u32 = Bytesˉlength(Initialˉstack) - Captures * 8u32;
    var Environment: bytes = Bytesˉconcat(
        Bytesˉfromˉu32ˉlittle(Target),
        Bytesˉfromˉu32ˉlittle(Callableˉtype)
    );
    Environment = Bytesˉconcat(
        Environment, Bytesˉfromˉu32ˉlittle(Captures)
    );
    Environment = Bytesˉconcat(
        Environment,
        Bytesˉslice(Initialˉstack, Captureˉoffset, Captures * 8u32)
    );
    let Environments: bytes = Bytesˉconcat(
        Initialˉenvironments, Environment
    );
    let Stack: bytes = Bytesˉconcat(
        Bytesˉslice(Initialˉstack, 0u32, Captureˉoffset),
        Bytesˉconcat(
            Bytesˉfromˉu32ˉlittle(2147483648u32 + Environmentˉoffset),
            Bytesˉfromˉu32ˉlittle(Callableˉtype + 1u32)
        )
    );
    return Closureˉcreation(true, Stack, Captures, Environments);
}

record Callˉexecution {
    Valid: bool;
    Handled: bool;
    Stack: bytes;
    Consumed: u32;
    Produced: bool;
    Producedˉkind: u32;
    Instructions: u32;
    Functionˉindex: u32;
    Functionˉcursor: u32;
    Codeˉoffset: u32;
    Codeˉlength: u32;
    Locals: bytes;
    Frames: bytes;
    Depth: u32;
    Status: u32;
}

fn Executeˉcall(
    Module: bytes,
    Typeˉoffsets: bytes,
    Typeˉcount: u32,
    Functionˉcount: u32,
    Payload: u32,
    Opcode: u32,
    Initialˉstack: bytes,
    Initialˉenvironments: bytes,
    Functionˉframeˉmetadata: bytes,
    Functionˉcodeˉoffsets: bytes,
    Functionˉcodeˉlengths: bytes,
    Instructions: u32,
    Initialˉfunction: u32,
    Initialˉlocals: bytes,
    Initialˉframes: bytes,
    Zeroˉlocals: bytes,
    Depth: u32,
    Maximumˉdepth: u32
) -> Callˉexecution {
    let Empty: bytes = Bytesˉslice(Module, 0u32, 0u32);
    let Invalid: Callˉexecution = Callˉexecution(
        false, false, Empty, 0u32, false, 0u32, 0u32, 0u32, 0u32,
        0u32, 0u32, Empty, Empty, 0u32, 0u32
    );
    if Opcode == 211u32 {
        let Declaredˉtarget: u32 = Bytesˉreadˉu32ˉlittle(
            Module, Payload + 1u32
        );
        let Declaredˉcallableˉtype: u32 = Bytesˉreadˉu32ˉlittle(
            Module, Payload + 5u32
        );
        if Declaredˉtarget >= Functionˉcount ||
            Declaredˉcallableˉtype >= Typeˉcount {
            return Invalid;
        }
        let Declaredˉdescriptor: u32 = Bytesˉreadˉu32ˉlittle(
            Typeˉoffsets, Declaredˉcallableˉtype * 4u32
        );
        if U32ˉfromˉu8(
            Bytesˉreadˉu8(Module, Declaredˉdescriptor)
        ) != 8u32 {
            return Invalid;
        }
        let Declaredˉstack: bytes = Bytesˉconcat(
            Initialˉstack,
            Bytesˉconcat(
                Bytesˉfromˉu32ˉlittle(Declaredˉtarget),
                Bytesˉfromˉu32ˉlittle(
                    Declaredˉcallableˉtype + 1u32
                )
            )
        );
        return Callˉexecution(
            true, true, Declaredˉstack, 0u32, true, 0u32,
            Instructions + 9u32,
            Initialˉfunction, 0u32, 0u32, 0u32,
            Initialˉlocals, Initialˉframes, Depth, 0u32
        );
    }
    if Opcode != 64u32 && Opcode != 212u32 && Opcode != 216u32 {
        return Callˉexecution(
            true, false, Initialˉstack, 0u32, false, 0u32, Instructions,
            Initialˉfunction, 0u32, 0u32, 0u32,
            Initialˉlocals, Initialˉframes, Depth, 0u32
        );
    }
    if Depth >= Maximumˉdepth {
        return Callˉexecution(
            true, true, Initialˉstack, 0u32, false, 0u32, Instructions,
            Initialˉfunction, 0u32, 0u32, 0u32,
            Initialˉlocals, Initialˉframes, Depth, 3004u32
        );
    }
    var Target: u32 = 0u32;
    var Parameters: u32 = 0u32;
    var Prefixˉlength: u32 = 0u32;
    var Consumed: u32 = 0u32;
    var Capturedˉparameters: u32 = 0u32;
    var Environmentˉcaptures: u32 = 0u32;
    if Opcode == 64u32 {
        Target = Bytesˉreadˉu32ˉlittle(Module, Payload + 1u32);
        if Target >= Functionˉcount { return Invalid; }
        Parameters = Bytesˉreadˉu32ˉlittle(
            Functionˉframeˉmetadata, Target * 8u32
        );
        if Bytesˉlength(Initialˉstack) / 8u32 < Parameters {
            return Invalid;
        }
        Prefixˉlength = Bytesˉlength(Initialˉstack) -
            Parameters * 8u32;
        Consumed = Parameters;
    }
    if Opcode == 212u32 || Opcode == 216u32 {
        var Callableˉtype: u32 = 0u32;
        if Opcode == 212u32 {
            Callableˉtype = Bytesˉreadˉu32ˉlittle(
                Module, Payload + 1u32
            );
        } else {
            if Bytesˉlength(Initialˉstack) < 8u32 { return Invalid; }
            let Encodedˉcallableˉtype: u32 = Bytesˉreadˉu32ˉlittle(
                Initialˉstack, Bytesˉlength(Initialˉstack) - 4u32
            );
            if Encodedˉcallableˉtype == 0u32 { return Invalid; }
            Callableˉtype = Encodedˉcallableˉtype - 1u32;
        }
        if Callableˉtype >= Typeˉcount { return Invalid; }
        let Descriptor: u32 = Bytesˉreadˉu32ˉlittle(
            Typeˉoffsets, Callableˉtype * 4u32
        );
        if U32ˉfromˉu8(
            Bytesˉreadˉu8(Module, Descriptor)
        ) != 8u32 {
            return Invalid;
        }
        var Descriptorˉcursor: u32 = Descriptor + 2u32;
        Descriptorˉcursor = Descriptorˉcursor +
            Shapeˉwidthˉat(Module, Descriptorˉcursor);
        Parameters = Bytesˉreadˉu32ˉlittle(
            Module, Descriptorˉcursor
        );
        if Opcode == 216u32 && Parameters != 0u32 { return Invalid; }
        if Bytesˉlength(Initialˉstack) / 8u32 < Parameters + 1u32 {
            return Invalid;
        }
        Prefixˉlength = Bytesˉlength(Initialˉstack) -
            (Parameters + 1u32) * 8u32;
        let Callableˉvalue: u32 = Bytesˉreadˉu32ˉlittle(
            Initialˉstack, Prefixˉlength
        );
        if Bytesˉreadˉu32ˉlittle(
                Initialˉstack, Prefixˉlength + 4u32
            ) != Callableˉtype + 1u32 {
            return Invalid;
        }
        if Callableˉvalue >= 2147483648u32 {
            let Environmentˉoffset: u32 =
                Callableˉvalue - 2147483648u32;
            if Environmentˉoffset > Bytesˉlength(Initialˉenvironments) ||
                Bytesˉlength(Initialˉenvironments) - Environmentˉoffset < 12u32 {
                return Invalid;
            }
            Target = Bytesˉreadˉu32ˉlittle(
                Initialˉenvironments, Environmentˉoffset
            );
            if Bytesˉreadˉu32ˉlittle(
                    Initialˉenvironments, Environmentˉoffset + 4u32
                ) != Callableˉtype {
                return Invalid;
            }
            Capturedˉparameters = Bytesˉreadˉu32ˉlittle(
                Initialˉenvironments, Environmentˉoffset + 8u32
            );
            if Capturedˉparameters < 1u32 || Capturedˉparameters > 64u32 ||
                Bytesˉlength(Initialˉenvironments) - Environmentˉoffset - 12u32 <
                    Capturedˉparameters * 8u32 {
                return Invalid;
            }
            Environmentˉcaptures = Environmentˉoffset + 12u32;
        } else {
            Target = Callableˉvalue;
        }
        if Target >= Functionˉcount || Bytesˉreadˉu32ˉlittle(
                Functionˉframeˉmetadata, Target * 8u32
            ) != Parameters + Capturedˉparameters {
            return Invalid;
        }
        Consumed = Parameters + 1u32;
    }
    var Resumeˉwidth: u32 = 5u32;
    if Opcode == 216u32 { Resumeˉwidth = 13u32; }
    var Frame: bytes = Bytesˉfromˉu32ˉlittle(
        Instructions + Resumeˉwidth
    );
    Frame = Bytesˉconcat(Frame, Initialˉlocals);
    Frame = Bytesˉconcat(
        Frame, Bytesˉfromˉu32ˉlittle(Initialˉfunction)
    );
    let Frames: bytes = Bytesˉconcat(Initialˉframes, Frame);
    let Functionˉcursor: u32 = Bytesˉreadˉu32ˉlittle(
        Functionˉframeˉmetadata, Target * 8u32 + 4u32
    );
    var Locals: bytes = Bytesˉslice(Zeroˉlocals, 0u32, Functionˉcursor);
    var Stack: bytes = Initialˉstack;
    var Argument: u32 = Parameters;
    while Argument > 0u32 {
        Argument = Argument - 1u32;
        let Stackˉlength: u32 = Bytesˉlength(Stack);
        let Value: bytes = Bytesˉslice(Stack, Stackˉlength - 8u32, 8u32);
        Stack = Bytesˉslice(Stack, 0u32, Stackˉlength - 8u32);
        let Localˉoffset: u32 = (Capturedˉparameters + Argument) * 8u32;
        Locals = Bytesˉconcat(
            Bytesˉconcat(
                Bytesˉslice(Locals, 0u32, Localˉoffset), Value
            ),
            Bytesˉslice(
                Locals, Localˉoffset + 8u32,
                Functionˉcursor - 8u32 - Localˉoffset
            )
        );
    }
    var Capture: u32 = 0u32;
    while Capture < Capturedˉparameters {
        let Captureˉlocalˉoffset: u32 = Capture * 8u32;
        let Captureˉvalue: bytes = Bytesˉslice(
            Initialˉenvironments,
            Environmentˉcaptures + Capture * 8u32,
            8u32
        );
        Locals = Bytesˉconcat(
            Bytesˉconcat(
                Bytesˉslice(Locals, 0u32, Captureˉlocalˉoffset),
                Captureˉvalue
            ),
            Bytesˉslice(
                Locals, Captureˉlocalˉoffset + 8u32,
                Functionˉcursor - 8u32 - Captureˉlocalˉoffset
            )
        );
        Capture = Capture + 1u32;
    }
    if (Opcode == 212u32 || Opcode == 216u32) &&
        (Bytesˉlength(Stack) < 8u32 ||
        Bytesˉlength(Stack) - 8u32 != Prefixˉlength) {
        return Invalid;
    }
    if Opcode == 212u32 || Opcode == 216u32 {
        Stack = Bytesˉslice(Stack, 0u32, Prefixˉlength);
    }
    if Opcode == 64u32 && Bytesˉlength(Stack) != Prefixˉlength {
        return Invalid;
    }
    return Callˉexecution(
        true, true, Stack, Consumed, false, 0u32, 0u32,
        Target, Functionˉcursor,
        Bytesˉreadˉu32ˉlittle(Functionˉcodeˉoffsets, Target * 4u32),
        Bytesˉreadˉu32ˉlittle(Functionˉcodeˉlengths, Target * 4u32),
        Locals, Frames, Depth + 1u32, 0u32
    );
}

record Taskˉvalueˉallocation {
    Valid: bool;
    Value: bytes;
    Metadata: bytes;
    Records: bytes;
}

fn Taskˉrecordˉfields(
    Value: bytes,
    Expectedˉowner: u32,
    Expectedˉfields: u32,
    Metadata: bytes,
    Records: bytes
) -> bytes {
    let Empty: bytes = Bytesˉslice(Value, 0u32, 0u32);
    if Bytesˉlength(Value) != 8u32 { return Empty; }
    let Slot: u32 = Bytesˉreadˉu32ˉlittle(Value, 0u32);
    let Owner: u32 = Bytesˉreadˉu32ˉlittle(Value, 4u32);
    if Slot == 4294967295u32 || Owner != Expectedˉowner ||
        Slot >= 768u32 || Expectedˉfields == 0u32 ||
        Expectedˉfields > 768u32 - Slot ||
        Bytesˉreadˉu32ˉlittle(Metadata, Slot * 8u32) != Owner ||
        Bytesˉreadˉu32ˉlittle(Metadata, Slot * 8u32 + 4u32) !=
            Expectedˉfields ||
        Slot * 8u32 > Bytesˉlength(Records) ||
        Expectedˉfields * 8u32 > Bytesˉlength(Records) - Slot * 8u32 {
        return Empty;
    }
    return Bytesˉslice(Records, Slot * 8u32, Expectedˉfields * 8u32);
}

fn Taskˉvariantˉfieldˉnominalˉat(
    Module: bytes,
    Typeˉoffsets: bytes,
    Type: u32,
    Case: u32,
    Field: u32,
    Expectedˉfields: u32
) -> u32 {
    let Directory: bytes = Variantˉcaseˉfields(
        Module, Typeˉoffsets, Type, Case
    );
    if Bytesˉlength(Directory) != 8u32 ||
        Bytesˉreadˉu32ˉlittle(Directory, 0u32) != Expectedˉfields ||
        Field >= Expectedˉfields {
        return 4294967295u32;
    }
    let Shape: u32 = Fieldˉshapeˉat(
        Module, Bytesˉreadˉu32ˉlittle(Directory, 4u32), Field
    );
    let Kind: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(Module, Shape));
    if Kind != 7u32 && Kind != 11u32 { return 4294967295u32; }
    return Bytesˉreadˉu32ˉlittle(Module, Shape + 1u32);
}

fn Taskˉvariantˉfieldˉnominal(
    Module: bytes,
    Typeˉoffsets: bytes,
    Type: u32,
    Case: u32
) -> u32 {
    return Taskˉvariantˉfieldˉnominalˉat(
        Module, Typeˉoffsets, Type, Case, 0u32, 1u32
    );
}

fn Allocateˉtaskˉvalue(
    Owner: u32,
    Fields: bytes,
    Metadata: bytes,
    Records: bytes,
    Zeroˉcell: bytes
) -> Taskˉvalueˉallocation {
    let Allocated: Aggregateˉallocation =
        Allocateˉaggregateˉwithoutˉcollection(
            Owner, Fields, Metadata, Records, Zeroˉcell
        );
    return Taskˉvalueˉallocation(
        Allocated.Valid, Allocated.Handle, Allocated.Metadata, Allocated.Values
    );
}

fn Taskˉtokenˉfromˉvalue(
    Value: bytes,
    Expectedˉowner: u32,
    Metadata: bytes,
    Records: bytes
) -> bytes {
    return Taskˉrecordˉfields(
        Value, Expectedˉowner, 1u32, Metadata, Records
    );
}

record Taskˉoperation {
    Valid: bool;
    Handled: bool;
    Stack: bytes;
    Locals: bytes;
    Taskˉstate: bytes;
    Memoryˉbudgetˉstate: bytes;
    Metadata: bytes;
    Records: bytes;
    Consumed: u32;
    Produced: bool;
    Producedˉkind: u32;
    Instructions: u32;
}

fn Executeˉtaskˉawait(
    Module: bytes,
    Payload: u32,
    Initialˉstack: bytes,
    Initialˉlocals: bytes,
    Functionˉcursor: u32,
    Initialˉtaskˉstate: bytes,
    Initialˉmemoryˉbudgetˉstate: bytes,
    Initialˉmetadata: bytes,
    Records: bytes,
    Zeroˉcell: bytes
) -> Taskˉoperation {
    let Empty: bytes = Bytesˉslice(Module, 0u32, 0u32);
    let Invalid: Taskˉoperation = Taskˉoperation(
        false, false, Empty, Empty, Empty, Empty, Empty, Empty,
        0u32, false, 0u32, 0u32
    );
    let Local: u32 = Bytesˉreadˉu32ˉlittle(Module, Payload + 1u32);
    let Origin: u32 = Bytesˉreadˉu32ˉlittle(Module, Payload + 5u32);
    if Local * 8u32 >= Functionˉcursor || Origin * 8u32 >= Functionˉcursor {
        return Invalid;
    }
    let Handleˉvalue: bytes = Bytesˉslice(
        Initialˉlocals, Local * 8u32, 8u32
    );
    let Scopeˉvalue: bytes = Bytesˉslice(
        Initialˉlocals, Origin * 8u32, 8u32
    );
    let Handleˉtoken: bytes = Taskˉtokenˉfromˉvalue(
        Handleˉvalue, Bytesˉreadˉu32ˉlittle(Handleˉvalue, 4u32),
        Initialˉmetadata, Records
    );
    let Scopeˉtoken: bytes = Taskˉtokenˉfromˉvalue(
        Scopeˉvalue, Bytesˉreadˉu32ˉlittle(Scopeˉvalue, 4u32),
        Initialˉmetadata, Records
    );
    if Bytesˉlength(Handleˉtoken) != 8u32 ||
        Bytesˉlength(Scopeˉtoken) != 8u32 {
        return Invalid;
    }
    let Awaited: Tasks.Awaitˉresult = Tasks.Awaitˉtask(
        Initialˉtaskˉstate, Handleˉtoken, Scopeˉtoken
    );
    if !Awaited.Valid || !Awaited.Found { return Invalid; }
    let Outcomeˉtype: u32 = Bytesˉreadˉu32ˉlittle(Module, Payload + 9u32);
    var Metadata: bytes = Initialˉmetadata;
    var Updatedˉrecords: bytes = Records;
    var Outcomeˉvalue: bytes = Empty;
    if Awaited.Terminalˉkind == 0u32 {
        let Resultˉslot: u32 = Bytesˉreadˉu32ˉlittle(
            Awaited.Result, 0u32
        );
        let Resultˉowner: u32 = Bytesˉreadˉu32ˉlittle(
            Awaited.Result, 4u32
        );
        if Resultˉslot == 4294967295u32 ||
            Resultˉowner < 2147483648u32 {
            return Invalid;
        }
        let Resultˉcase: u32 =
            (Resultˉowner - 2147483648u32) % 256u32;
        if Resultˉcase > 1u32 { return Invalid; }
        let Resultˉoutcomeˉowner: u32 = 2147483648u32 +
            (Outcomeˉtype + 1u32) * 256u32 + Resultˉcase;
        Metadata = Bytesˉconcat(
            Bytesˉconcat(
                Bytesˉslice(Metadata, 0u32, Resultˉslot * 8u32),
                Bytesˉfromˉu32ˉlittle(Resultˉoutcomeˉowner)
            ),
            Bytesˉslice(
                Metadata, Resultˉslot * 8u32 + 4u32,
                Bytesˉlength(Metadata) - Resultˉslot * 8u32 - 4u32
            )
        );
        Outcomeˉvalue = Bytesˉconcat(
            Bytesˉfromˉu32ˉlittle(Resultˉslot),
            Bytesˉfromˉu32ˉlittle(Resultˉoutcomeˉowner)
        );
    } else {
        let Outcomeˉcase: u32 = Awaited.Terminalˉkind + 1u32;
        let Terminalˉoutcomeˉowner: u32 = 2147483648u32 +
            (Outcomeˉtype + 1u32) * 256u32 + Outcomeˉcase;
        if Awaited.Terminalˉkind <= 2u32 {
            Outcomeˉvalue = Bytesˉconcat(
                Bytesˉfromˉu32ˉlittle(4294967295u32),
                Bytesˉfromˉu32ˉlittle(Terminalˉoutcomeˉowner)
            );
        } else {
            var Outcomeˉfields: bytes = Bytesˉfromˉu64ˉlittle(
                Awaited.Firstˉevidence
            );
            if Awaited.Terminalˉkind < 5u32 {
                Outcomeˉfields = Bytesˉconcat(
                    Outcomeˉfields,
                    Bytesˉfromˉu64ˉlittle(Awaited.Secondˉevidence)
                );
            }
            let Outcomeˉallocation: Taskˉvalueˉallocation =
                Allocateˉtaskˉvalue(
                    Terminalˉoutcomeˉowner, Outcomeˉfields,
                    Metadata, Updatedˉrecords, Zeroˉcell
                );
            if !Outcomeˉallocation.Valid { return Invalid; }
            Outcomeˉvalue = Outcomeˉallocation.Value;
            Metadata = Outcomeˉallocation.Metadata;
            Updatedˉrecords = Outcomeˉallocation.Records;
        }
    }
    let Stack: bytes = Bytesˉconcat(Initialˉstack, Outcomeˉvalue);
    let Locals: bytes = Bytesˉconcat(
        Bytesˉconcat(
            Bytesˉslice(Initialˉlocals, 0u32, Local * 8u32), Zeroˉcell
        ),
        Bytesˉslice(
            Initialˉlocals, Local * 8u32 + 8u32,
            Functionˉcursor - Local * 8u32 - 8u32
        )
    );
    return Taskˉoperation(
        true, true, Stack, Locals, Awaited.State,
        Initialˉmemoryˉbudgetˉstate, Metadata, Updatedˉrecords,
        0u32, true, 2u32, 13u32
    );
}

fn Executeˉtaskˉoperation(
    Module: bytes,
    Typeˉoffsets: bytes,
    Payload: u32,
    Opcode: u32,
    Initialˉstack: bytes,
    Initialˉlocals: bytes,
    Functionˉcursor: u32,
    Initialˉtaskˉstate: bytes,
    Initialˉmemoryˉbudgetˉstate: bytes,
    Initialˉmetadata: bytes,
    Initialˉrecords: bytes,
    Zeroˉcell: bytes
) -> Taskˉoperation {
    let Empty: bytes = Bytesˉslice(Module, 0u32, 0u32);
    let Invalid: Taskˉoperation = Taskˉoperation(
        false, false, Empty, Empty, Empty, Empty, Empty, Empty,
        0u32, false, 0u32, 0u32
    );
    if Opcode < 214u32 || Opcode > 219u32 || Opcode == 216u32 {
        return Taskˉoperation(
            true, false, Initialˉstack, Initialˉlocals,
            Initialˉtaskˉstate, Initialˉmemoryˉbudgetˉstate,
            Initialˉmetadata, Initialˉrecords,
            0u32, false, 0u32, 0u32
        );
    }
    if Opcode == 217u32 {
        return Executeˉtaskˉawait(
            Module, Payload, Initialˉstack, Initialˉlocals,
            Functionˉcursor, Initialˉtaskˉstate,
            Initialˉmemoryˉbudgetˉstate, Initialˉmetadata,
            Initialˉrecords, Zeroˉcell
        );
    }
    let Local: u32 = Bytesˉreadˉu32ˉlittle(Module, Payload + 1u32);
    if Local * 8u32 >= Functionˉcursor { return Invalid; }
    var Stack: bytes = Initialˉstack;
    var Locals: bytes = Initialˉlocals;
    var Taskˉstate: bytes = Initialˉtaskˉstate;
    var Memoryˉbudgetˉstate: bytes = Initialˉmemoryˉbudgetˉstate;
    var Metadata: bytes = Initialˉmetadata;
    var Records: bytes = Initialˉrecords;
    var Consumed: u32 = 0u32;
    var Produced: bool = false;
    var Producedˉkind: u32 = 0u32;
    var Instructions: u32 = 0u32;

    if Opcode == 214u32 {
        if Bytesˉlength(Stack) < 16u32 { return Invalid; }
        let Stackˉlength: u32 = Bytesˉlength(Stack);
        let Limitsˉvalue: bytes = Bytesˉslice(Stack, Stackˉlength - 16u32, 8u32);
        let Contextˉvalue: bytes = Bytesˉslice(Stack, Stackˉlength - 8u32, 8u32);
        let Limitsˉowner: u32 = Bytesˉreadˉu32ˉlittle(Limitsˉvalue, 4u32);
        let Contextˉowner: u32 = Bytesˉreadˉu32ˉlittle(Contextˉvalue, 4u32);
        let Limits: bytes = Taskˉrecordˉfields(
            Limitsˉvalue, Limitsˉowner, 8u32, Metadata, Records
        );
        let Context: bytes = Taskˉtokenˉfromˉvalue(
            Contextˉvalue, Contextˉowner, Metadata, Records
        );
        if Bytesˉlength(Limits) != 64u32 || Bytesˉlength(Context) != 8u32 {
            return Invalid;
        }
        let Budget: bytes = Bytesˉslice(Locals, Local * 8u32, 8u32);
        let Constructed: Tasks.Scopeˉconstruction = Tasks.Constructˉscope(
            Taskˉstate, Budget, Limits, Context
        );
        if !Constructed.Valid { return Invalid; }
        Taskˉstate = Constructed.State;
        let Resultˉtype: u32 = Bytesˉreadˉu32ˉlittle(Module, Payload + 5u32);
        var Resultˉcase: u32 = 0u32;
        var Resultˉfield: bytes = Empty;
        if Constructed.Accepted {
            let Scopeˉtype: u32 = Taskˉvariantˉfieldˉnominal(
                Module, Typeˉoffsets, Resultˉtype, 0u32
            );
            if Scopeˉtype == 4294967295u32 { return Invalid; }
            let Scopeˉallocation: Taskˉvalueˉallocation =
                Allocateˉtaskˉvalue(
                    Scopeˉtype + 1u32, Constructed.Token,
                    Metadata, Records, Zeroˉcell
                );
            if !Scopeˉallocation.Valid { return Invalid; }
            Resultˉfield = Scopeˉallocation.Value;
            Metadata = Scopeˉallocation.Metadata;
            Records = Scopeˉallocation.Records;
        } else {
            Resultˉcase = 1u32;
            let Failureˉtype: u32 = Taskˉvariantˉfieldˉnominal(
                Module, Typeˉoffsets, Resultˉtype, 1u32
            );
            if Failureˉtype == 4294967295u32 ||
                Constructed.Failure > 3u32 {
                return Invalid;
            }
            var Failureˉfields: bytes = Empty;
            var Failureˉmetadata: bytes = Metadata;
            var Failureˉrecords: bytes = Records;
            if Constructed.Failure == 0u32 {
                Failureˉfields = Bytesˉconcat(
                    Bytesˉfromˉu32ˉlittle(Constructed.Field),
                    Bytesˉfromˉu32ˉlittle(0u32)
                );
                Failureˉfields = Bytesˉconcat(
                    Failureˉfields,
                    Bytesˉfromˉu64ˉlittle(Constructed.Observed)
                );
                Failureˉfields = Bytesˉconcat(
                    Failureˉfields,
                    Bytesˉfromˉu64ˉlittle(Constructed.Minimum)
                );
                Failureˉfields = Bytesˉconcat(
                    Failureˉfields,
                    Bytesˉfromˉu64ˉlittle(Constructed.Maximum)
                );
            } else if Constructed.Failure == 1u32 {
                let Allocationˉfailureˉtype: u32 =
                    Taskˉvariantˉfieldˉnominalˉat(
                        Module, Typeˉoffsets, Failureˉtype,
                        1u32, 0u32, 1u32
                    );
                if Allocationˉfailureˉtype == 4294967295u32 {
                    return Invalid;
                }
                let Allocationˉfailure: Aggregateˉallocation =
                    Allocateˉexactˉallocationˉfailure(
                        Module, Typeˉoffsets, Allocationˉfailureˉtype,
                        1u8,
                        Constructed.Observed, Constructed.Minimum,
                        Metadata, Records, Zeroˉcell
                    );
                if !Allocationˉfailure.Valid { return Invalid; }
                Failureˉfields = Allocationˉfailure.Handle;
                Failureˉmetadata = Allocationˉfailure.Metadata;
                Failureˉrecords = Allocationˉfailure.Values;
            } else {
                Failureˉfields = Bytesˉconcat(
                    Bytesˉfromˉu64ˉlittle(Constructed.Minimum),
                    Bytesˉfromˉu64ˉlittle(Constructed.Observed)
                );
            }
            let Failureˉowner: u32 = 2147483648u32 +
                (Failureˉtype + 1u32) * 256u32 + Constructed.Failure;
            let Failureˉallocation: Taskˉvalueˉallocation =
                Allocateˉtaskˉvalue(
                    Failureˉowner, Failureˉfields,
                    Failureˉmetadata, Failureˉrecords, Zeroˉcell
                );
            if !Failureˉallocation.Valid { return Invalid; }
            Resultˉfield = Failureˉallocation.Value;
            Metadata = Failureˉallocation.Metadata;
            Records = Failureˉallocation.Records;
            let Released: Budgets.Memoryˉbudgetˉreleaseˉresult =
                Budgets.Releaseˉmemoryˉbudget(Memoryˉbudgetˉstate, Budget);
            if !Released.Valid { return Invalid; }
            Memoryˉbudgetˉstate = Released.State;
        }
        let Resultˉowner: u32 = 2147483648u32 +
            (Resultˉtype + 1u32) * 256u32 + Resultˉcase;
        let Resultˉallocation: Taskˉvalueˉallocation =
            Allocateˉtaskˉvalue(
                Resultˉowner, Resultˉfield, Metadata, Records, Zeroˉcell
            );
        if !Resultˉallocation.Valid { return Invalid; }
        Metadata = Resultˉallocation.Metadata;
        Records = Resultˉallocation.Records;
        Stack = Bytesˉconcat(
            Bytesˉslice(Stack, 0u32, Stackˉlength - 16u32),
            Resultˉallocation.Value
        );
        Locals = Bytesˉconcat(
            Bytesˉconcat(
                Bytesˉslice(Locals, 0u32, Local * 8u32), Zeroˉcell
            ),
            Bytesˉslice(
                Locals, Local * 8u32 + 8u32,
                Functionˉcursor - Local * 8u32 - 8u32
            )
        );
        Consumed = 2u32;
        Produced = true;
        Producedˉkind = 2u32;
        Instructions = 9u32;
    }

    if Opcode == 215u32 {
        let Contextˉscopeˉvalue: bytes = Bytesˉslice(
            Locals, Local * 8u32, 8u32
        );
        let Scopeˉowner: u32 = Bytesˉreadˉu32ˉlittle(
            Contextˉscopeˉvalue, 4u32
        );
        let Contextˉscopeˉtoken: bytes = Taskˉtokenˉfromˉvalue(
            Contextˉscopeˉvalue, Scopeˉowner, Metadata, Records
        );
        if Bytesˉlength(Contextˉscopeˉtoken) != 8u32 { return Invalid; }
        let Contextˉtype: u32 = Bytesˉreadˉu32ˉlittle(Module, Payload + 5u32);
        let Derivedˉcontext: Taskˉvalueˉallocation = Allocateˉtaskˉvalue(
            Contextˉtype + 1u32, Contextˉscopeˉtoken,
            Metadata, Records, Zeroˉcell
        );
        if !Derivedˉcontext.Valid { return Invalid; }
        Stack = Bytesˉconcat(Stack, Derivedˉcontext.Value);
        Metadata = Derivedˉcontext.Metadata;
        Records = Derivedˉcontext.Records;
        Produced = true;
        Producedˉkind = 2u32;
        Instructions = 9u32;
    }

    if Opcode == 218u32 {
        let Cancelˉscopeˉvalue: bytes = Bytesˉslice(
            Locals, Local * 8u32, 8u32
        );
        let Cancelˉscopeˉtoken: bytes = Taskˉtokenˉfromˉvalue(
            Cancelˉscopeˉvalue,
            Bytesˉreadˉu32ˉlittle(Cancelˉscopeˉvalue, 4u32),
            Metadata, Records
        );
        if Bytesˉlength(Cancelˉscopeˉtoken) != 8u32 { return Invalid; }
        let Cancelled: Tasks.Cancelˉresult = Tasks.Requestˉcancel(
            Taskˉstate, Cancelˉscopeˉtoken
        );
        if !Cancelled.Valid { return Invalid; }
        Taskˉstate = Cancelled.State;
        let Cancelˉtype: u32 = Bytesˉreadˉu32ˉlittle(Module, Payload + 5u32);
        var Case: u32 = 0u32;
        if Cancelled.Alreadyˉrequested { Case = 1u32; }
        let Cancelˉowner: u32 = 2147483648u32 +
            (Cancelˉtype + 1u32) * 256u32 + Case;
        let Cancelˉfields: bytes = Bytesˉconcat(
            Bytesˉfromˉu32ˉlittle(Cancelled.Liveˉchildren),
            Bytesˉfromˉu32ˉlittle(0u32)
        );
        let Cancelˉallocation: Taskˉvalueˉallocation =
            Allocateˉtaskˉvalue(
                Cancelˉowner, Cancelˉfields,
                Metadata, Records, Zeroˉcell
            );
        if !Cancelˉallocation.Valid { return Invalid; }
        Stack = Bytesˉconcat(Stack, Cancelˉallocation.Value);
        Metadata = Cancelˉallocation.Metadata;
        Records = Cancelˉallocation.Records;
        Produced = true;
        Producedˉkind = 2u32;
        Instructions = 9u32;
    }

    if Opcode == 219u32 {
        let Exitˉscopeˉvalue: bytes = Bytesˉslice(
            Locals, Local * 8u32, 8u32
        );
        let Exitˉscopeˉtoken: bytes = Taskˉtokenˉfromˉvalue(
            Exitˉscopeˉvalue,
            Bytesˉreadˉu32ˉlittle(Exitˉscopeˉvalue, 4u32),
            Metadata, Records
        );
        if Bytesˉlength(Exitˉscopeˉtoken) != 8u32 { return Invalid; }
        let Exited: Tasks.Scopeˉexit = Tasks.Exitˉscope(
            Taskˉstate, Exitˉscopeˉtoken,
            U32ˉfromˉu8(Bytesˉreadˉu8(Module, Payload + 5u32))
        );
        if !Exited.Valid { return Invalid; }
        let Exitˉbudgetˉrelease: Budgets.Memoryˉbudgetˉreleaseˉresult =
            Budgets.Releaseˉmemoryˉbudget(
                Memoryˉbudgetˉstate, Exited.Budget
            );
        if !Exitˉbudgetˉrelease.Valid { return Invalid; }
        Taskˉstate = Exited.State;
        Memoryˉbudgetˉstate = Exitˉbudgetˉrelease.State;
        Locals = Bytesˉconcat(
            Bytesˉconcat(
                Bytesˉslice(Locals, 0u32, Local * 8u32), Zeroˉcell
            ),
            Bytesˉslice(
                Locals, Local * 8u32 + 8u32,
                Functionˉcursor - Local * 8u32 - 8u32
            )
        );
        Instructions = 6u32;
    }
    return Taskˉoperation(
        true, true, Stack, Locals, Taskˉstate, Memoryˉbudgetˉstate,
        Metadata, Records, Consumed, Produced, Producedˉkind, Instructions
    );
}

record Taskˉqueueˉselection {
    Valid: bool;
    Found: bool;
    Record: bytes;
    Remaining: bytes;
}

fn Taskˉqueueˉrank(Ordinal: u32) -> u32 {
    let Lane: u32 = Ordinal % 4u32;
    if Lane == 3u32 { return 0u32; }
    if Lane == 1u32 { return 1u32; }
    if Lane == 0u32 { return 2u32; }
    return 3u32;
}

fn Selectˉqueuedˉtask(
    Queue: bytes,
    Scope: bytes
) -> Taskˉqueueˉselection {
    let Empty: bytes = Bytesˉslice(Queue, 0u32, 0u32);
    let Length: u32 = Bytesˉlength(Queue);
    if Length > TASK_QUEUE_MAXIMUM_BYTES || Bytesˉlength(Scope) != 8u32 {
        return Taskˉqueueˉselection(false, false, Empty, Queue);
    }
    var Offset: u32 = 0u32;
    var Selectedˉoffset: u32 = 0u32;
    var Selectedˉlength: u32 = 0u32;
    var Selectedˉgroup: u32 = 0u32;
    var Selectedˉrank: u32 = 0u32;
    var Found: bool = false;
    while Offset < Length {
        if Length - Offset < TASK_QUEUE_HEADER_BYTES {
            return Taskˉqueueˉselection(false, false, Empty, Queue);
        }
        let Localsˉlength: u32 = Bytesˉreadˉu32ˉlittle(
            Queue, Offset + 32u32
        );
        if Localsˉlength == 0u32 || Localsˉlength % 8u32 != 0u32 ||
            Localsˉlength > 4096u32 ||
            Localsˉlength > Length - Offset - TASK_QUEUE_HEADER_BYTES {
            return Taskˉqueueˉselection(false, false, Empty, Queue);
        }
        let Recordˉlength: u32 = TASK_QUEUE_HEADER_BYTES + Localsˉlength;
        if Bytesˉreadˉu32ˉlittle(Queue, Offset + 8u32) ==
                Bytesˉreadˉu32ˉlittle(Scope, 0u32) &&
            Bytesˉreadˉu32ˉlittle(Queue, Offset + 12u32) ==
                Bytesˉreadˉu32ˉlittle(Scope, 4u32) {
            let Ordinal: u32 = Bytesˉreadˉu32ˉlittle(
                Queue, Offset + 52u32
            );
            let Group: u32 = Ordinal / 4u32;
            let Rank: u32 = Taskˉqueueˉrank(Ordinal);
            if !Found || Group < Selectedˉgroup ||
                (Group == Selectedˉgroup && Rank < Selectedˉrank) {
                Found = true;
                Selectedˉoffset = Offset;
                Selectedˉlength = Recordˉlength;
                Selectedˉgroup = Group;
                Selectedˉrank = Rank;
            }
        }
        Offset = Offset + Recordˉlength;
    }
    if !Found {
        return Taskˉqueueˉselection(true, false, Empty, Queue);
    }
    return Taskˉqueueˉselection(
        true,
        true,
        Bytesˉslice(Queue, Selectedˉoffset, Selectedˉlength),
        Bytesˉconcat(
            Bytesˉslice(Queue, 0u32, Selectedˉoffset),
            Bytesˉslice(
                Queue,
                Selectedˉoffset + Selectedˉlength,
                Length - Selectedˉoffset - Selectedˉlength
            )
        )
    );
}

record Taskˉspawnˉexecution {
    Valid: bool;
    Stack: bytes;
    Locals: bytes;
    Taskˉstate: bytes;
    Metadata: bytes;
    Records: bytes;
    Consumed: u32;
    Produced: bool;
    Producedˉkind: u32;
    Instructions: u32;
    Functionˉindex: u32;
    Functionˉcursor: u32;
    Codeˉoffset: u32;
    Codeˉlength: u32;
    Frames: bytes;
    Depth: u32;
    Pending: bytes;
    Queue: bytes;
}

record Taskˉworkˉobservation {
    Valid: bool;
    Exhausted: bool;
    Terminal: bool;
    Terminalˉkind: u32;
    Firstˉevidence: u64;
    Secondˉevidence: u64;
}

fn Inspectˉpendingˉtaskˉenvironment(
    Pending: bytes,
    State: bytes,
    Request: Executionˉrequest
) -> Tasks.Taskˉobservation {
    let Length: u32 = Bytesˉlength(Pending);
    if Length == 0u32 {
        return Tasks.Taskˉobservation(
            true, false, 0u32, 0u64, 0u64, State
        );
    }
    if Length % TASK_PENDING_BYTES != 0u32 {
        return Tasks.Taskˉobservation(
            false, false, 0u32, 0u64, 0u64, State
        );
    }
    return Tasks.Inspectˉtaskˉenvironment(
        State,
        Bytesˉslice(Pending, Length - TASK_PENDING_BYTES + 4u32, 8u32),
        Request.Taskˉobservationˉtick,
        Request.Taskˉclockˉgeneration,
        Request.Taskˉobservedˉruntimeˉgeneration
    );
}

fn Observeˉtaskˉwork(
    Pending: bytes,
    Executed: u32,
    State: bytes,
    Request: Executionˉrequest
) -> Taskˉworkˉobservation {
    let Environment: Tasks.Taskˉobservation =
        Inspectˉpendingˉtaskˉenvironment(Pending, State, Request);
    if !Environment.Valid {
        return Taskˉworkˉobservation(
            false, false, false, 0u32, 0u64, 0u64
        );
    }
    let Length: u32 = Bytesˉlength(Pending);
    if Length == 0u32 {
        return Taskˉworkˉobservation(
            true, false, Environment.Terminal,
            Environment.Terminalˉkind, Environment.Firstˉevidence,
            Environment.Secondˉevidence
        );
    }
    if Length % TASK_PENDING_BYTES != 0u32 {
        return Taskˉworkˉobservation(
            false, false, false, 0u32, 0u64, 0u64
        );
    }
    let Offset: u32 = Length - TASK_PENDING_BYTES;
    let Started: u32 = Bytesˉreadˉu32ˉlittle(Pending, Offset + 24u32);
    let Maximum: u64 = Bytesˉreadˉu64ˉlittle(Pending, Offset + 28u32);
    if Started > Executed || Maximum == 0u64 || Maximum > 1000000u64 {
        return Taskˉworkˉobservation(
            false, false, false, 0u32, 0u64, 0u64
        );
    }
    return Taskˉworkˉobservation(
        true, U64ˉfromˉu32(Executed - Started) >= Maximum,
        Environment.Terminal, Environment.Terminalˉkind,
        Environment.Firstˉevidence, Environment.Secondˉevidence
    );
}

fn Effectiveˉtaskˉcallˉdepth(Pending: bytes, Maximum: u32) -> u32 {
    let Length: u32 = Bytesˉlength(Pending);
    if Length == 0u32 { return Maximum; }
    if Length % TASK_PENDING_BYTES != 0u32 { return 0u32; }
    let Offset: u32 = Length - TASK_PENDING_BYTES;
    let Rootˉdepth: u32 = Bytesˉreadˉu32ˉlittle(Pending, Offset);
    let Taskˉmaximum: u32 = Bytesˉreadˉu32ˉlittle(
        Pending, Offset + 36u32
    );
    if Rootˉdepth == 0u32 || Taskˉmaximum == 0u32 ||
        Rootˉdepth > 64u32 || Taskˉmaximum > 64u32 {
        return 0u32;
    }
    let Taskˉabsoluteˉmaximum: u32 = Rootˉdepth + Taskˉmaximum - 1u32;
    if Taskˉabsoluteˉmaximum < Maximum { return Taskˉabsoluteˉmaximum; }
    return Maximum;
}

fn Executeˉtaskˉspawn(
    Module: bytes,
    Typeˉoffsets: bytes,
    Typeˉcount: u32,
    Functionˉcount: u32,
    Payload: u32,
    Initialˉstack: bytes,
    Initialˉlocals: bytes,
    Functionˉcursor: u32,
    Initialˉtaskˉstate: bytes,
    Initialˉmetadata: bytes,
    Initialˉrecords: bytes,
    Zeroˉcell: bytes,
    Closureˉenvironments: bytes,
    Functionˉframeˉmetadata: bytes,
    Functionˉcodeˉoffsets: bytes,
    Functionˉcodeˉlengths: bytes,
    Instructions: u32,
    Executed: u32,
    Functionˉindex: u32,
    Initialˉframes: bytes,
    Zeroˉlocals: bytes,
    Depth: u32,
    Maximumˉdepth: u32,
    Initialˉpending: bytes,
    Initialˉqueue: bytes
) -> Taskˉspawnˉexecution {
    let Empty: bytes = Bytesˉslice(Module, 0u32, 0u32);
    let Invalid: Taskˉspawnˉexecution = Taskˉspawnˉexecution(
        false, Empty, Empty, Empty, Empty, Empty,
        0u32, false, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32,
        Empty, 0u32, Empty, Empty
    );
    let Scopeˉlocal: u32 = Bytesˉreadˉu32ˉlittle(
        Module, Payload + 1u32
    );
    if Scopeˉlocal * 8u32 >= Functionˉcursor ||
        Bytesˉlength(Initialˉstack) < 8u32 {
        return Invalid;
    }
    let Scopeˉvalue: bytes = Bytesˉslice(
        Initialˉlocals, Scopeˉlocal * 8u32, 8u32
    );
    let Scope: bytes = Taskˉtokenˉfromˉvalue(
        Scopeˉvalue,
        Bytesˉreadˉu32ˉlittle(Scopeˉvalue, 4u32),
        Initialˉmetadata, Initialˉrecords
    );
    if Bytesˉlength(Scope) != 8u32 { return Invalid; }
    let Call: Callˉexecution = Executeˉcall(
        Module, Typeˉoffsets, Typeˉcount, Functionˉcount,
        Payload, 216u32, Initialˉstack, Closureˉenvironments,
        Functionˉframeˉmetadata, Functionˉcodeˉoffsets,
        Functionˉcodeˉlengths, Instructions, Functionˉindex,
        Initialˉlocals, Initialˉframes, Zeroˉlocals,
        Depth, Maximumˉdepth
    );
    if !Call.Valid || Call.Status != 0u32 || !Call.Handled ||
        Bytesˉlength(Call.Frames) < Bytesˉlength(Initialˉframes) {
        return Invalid;
    }
    let Retainedˉbytes: u64 = U64ˉfromˉu32(TASK_QUEUE_HEADER_BYTES) +
        U64ˉfromˉu32(Bytesˉlength(Call.Locals)) +
        U64ˉfromˉu32(
            Bytesˉlength(Call.Frames) - Bytesˉlength(Initialˉframes)
        );
    if Bytesˉlength(Call.Locals) >
            TASK_QUEUE_MAXIMUM_BYTES - TASK_QUEUE_HEADER_BYTES ||
        Bytesˉlength(Initialˉqueue) >
            TASK_QUEUE_MAXIMUM_BYTES - TASK_QUEUE_HEADER_BYTES -
                Bytesˉlength(Call.Locals) {
        return Invalid;
    }
    let Begun: Tasks.Spawnˉbegin = Tasks.Beginˉspawn(
        Initialˉtaskˉstate, Scope, Retainedˉbytes
    );
    if !Begun.Valid { return Invalid; }
    let Spawnˉresultˉtype: u32 = Bytesˉreadˉu32ˉlittle(
        Module, Payload + 5u32
    );
    if Begun.Accepted {
        let Taskˉtype: u32 = Bytesˉreadˉu32ˉlittle(
            Module, Payload + 9u32
        );
        let Handle: Taskˉvalueˉallocation = Allocateˉtaskˉvalue(
            Taskˉtype + 1u32, Begun.Token,
            Initialˉmetadata, Initialˉrecords, Zeroˉcell
        );
        if !Handle.Valid { return Invalid; }
        let Spawnˉowner: u32 = 2147483648u32 +
            (Spawnˉresultˉtype + 1u32) * 256u32;
        let Spawned: Taskˉvalueˉallocation = Allocateˉtaskˉvalue(
            Spawnˉowner, Handle.Value,
            Handle.Metadata, Handle.Records, Zeroˉcell
        );
        if !Spawned.Valid { return Invalid; }
        var Queued: bytes = Begun.Token;
        Queued = Bytesˉconcat(Queued, Scope);
        Queued = Bytesˉconcat(
            Queued, Bytesˉfromˉu32ˉlittle(Call.Functionˉindex)
        );
        Queued = Bytesˉconcat(
            Queued, Bytesˉfromˉu32ˉlittle(Call.Functionˉcursor)
        );
        Queued = Bytesˉconcat(
            Queued, Bytesˉfromˉu32ˉlittle(Call.Codeˉoffset)
        );
        Queued = Bytesˉconcat(
            Queued, Bytesˉfromˉu32ˉlittle(Call.Codeˉlength)
        );
        Queued = Bytesˉconcat(
            Queued, Bytesˉfromˉu32ˉlittle(Bytesˉlength(Call.Locals))
        );
        Queued = Bytesˉconcat(
            Queued, Bytesˉfromˉu64ˉlittle(Begun.Remainingˉwork)
        );
        Queued = Bytesˉconcat(
            Queued, Bytesˉfromˉu32ˉlittle(Begun.Maximumˉcallˉdepth)
        );
        Queued = Bytesˉconcat(
            Queued, Bytesˉfromˉu32ˉlittle(Depth)
        );
        Queued = Bytesˉconcat(
            Queued,
            Bytesˉfromˉu32ˉlittle(
                Bytesˉreadˉu32ˉlittle(Begun.Token, 0u32) - 1u32
            )
        );
        Queued = Bytesˉconcat(Queued, Call.Locals);
        return Taskˉspawnˉexecution(
            true,
            Bytesˉconcat(Call.Stack, Spawned.Value),
            Initialˉlocals, Begun.State,
            Spawned.Metadata, Spawned.Records,
            1u32, true, 2u32, Instructions + 13u32,
            Functionˉindex, Functionˉcursor,
            0u32, 0u32, Initialˉframes, Depth,
            Initialˉpending, Bytesˉconcat(Initialˉqueue, Queued)
        );
    }
    let Failureˉtype: u32 = Taskˉvariantˉfieldˉnominal(
        Module, Typeˉoffsets, Spawnˉresultˉtype, 1u32
    );
    if Failureˉtype == 4294967295u32 || Begun.Reason > 3u32 {
        return Invalid;
    }
    let Workˉoffset: u32 = Bytesˉlength(Initialˉstack) - 8u32;
    let Work: bytes = Bytesˉslice(Initialˉstack, Workˉoffset, 8u32);
    var Metadata: bytes = Initialˉmetadata;
    var Records: bytes = Initialˉrecords;
    var Failureˉfields: bytes = Work;
    if Begun.Reason == 3u32 {
        let Allocationˉfailureˉtype: u32 =
            Taskˉvariantˉfieldˉnominalˉat(
                Module, Typeˉoffsets, Failureˉtype, 3u32, 0u32, 2u32
            );
        if Allocationˉfailureˉtype == 4294967295u32 { return Invalid; }
        let Allocationˉfailure: Aggregateˉallocation =
            Allocateˉexactˉallocationˉfailure(
                Module, Typeˉoffsets, Allocationˉfailureˉtype,
                1u8, Begun.Requestedˉbytes, Begun.Availableˉbytes,
                Metadata, Records, Zeroˉcell
            );
        if !Allocationˉfailure.Valid { return Invalid; }
        Failureˉfields = Bytesˉconcat(Allocationˉfailure.Handle, Work);
        Metadata = Allocationˉfailure.Metadata;
        Records = Allocationˉfailure.Values;
    }
    let Failureˉowner: u32 = 2147483648u32 +
        (Failureˉtype + 1u32) * 256u32 + Begun.Reason;
    let Failure: Taskˉvalueˉallocation = Allocateˉtaskˉvalue(
        Failureˉowner, Failureˉfields, Metadata, Records, Zeroˉcell
    );
    if !Failure.Valid { return Invalid; }
    let Resultˉowner: u32 = 2147483648u32 +
        (Spawnˉresultˉtype + 1u32) * 256u32 + 1u32;
    let Result: Taskˉvalueˉallocation = Allocateˉtaskˉvalue(
        Resultˉowner, Failure.Value, Failure.Metadata, Failure.Records, Zeroˉcell
    );
    if !Result.Valid { return Invalid; }
    return Taskˉspawnˉexecution(
        true,
        Bytesˉconcat(
            Bytesˉslice(Initialˉstack, 0u32, Workˉoffset), Result.Value
        ),
        Initialˉlocals, Begun.State, Result.Metadata, Result.Records,
        1u32, true, 2u32, Instructions + 13u32,
        Functionˉindex, Functionˉcursor,
        0u32, 0u32, Initialˉframes, Depth, Initialˉpending,
        Initialˉqueue
    );
}

record Taskˉscheduleˉexecution {
    Valid: bool;
    Scheduled: bool;
    Stack: bytes;
    Locals: bytes;
    Functionˉindex: u32;
    Functionˉcursor: u32;
    Codeˉoffset: u32;
    Codeˉlength: u32;
    Frames: bytes;
    Depth: u32;
    Pending: bytes;
    Queue: bytes;
}

fn Scheduleˉqueuedˉtask(
    Module: bytes,
    Payload: u32,
    Initialˉstack: bytes,
    Initialˉlocals: bytes,
    Functionˉcursor: u32,
    Initialˉtaskˉstate: bytes,
    Initialˉmetadata: bytes,
    Initialˉrecords: bytes,
    Functionˉcount: u32,
    Functionˉframeˉmetadata: bytes,
    Functionˉcodeˉoffsets: bytes,
    Functionˉcodeˉlengths: bytes,
    Instructions: u32,
    Executed: u32,
    Functionˉindex: u32,
    Initialˉframes: bytes,
    Depth: u32,
    Maximumˉdepth: u32,
    Initialˉpending: bytes,
    Initialˉqueue: bytes
) -> Taskˉscheduleˉexecution {
    let Empty: bytes = Bytesˉslice(Module, 0u32, 0u32);
    let Invalid: Taskˉscheduleˉexecution = Taskˉscheduleˉexecution(
        false, false, Empty, Empty, 0u32, 0u32, 0u32, 0u32,
        Empty, 0u32, Empty, Empty
    );
    let Local: u32 = Bytesˉreadˉu32ˉlittle(Module, Payload + 1u32);
    let Origin: u32 = Bytesˉreadˉu32ˉlittle(Module, Payload + 5u32);
    if Local * 8u32 >= Functionˉcursor ||
        Origin * 8u32 >= Functionˉcursor || Depth >= Maximumˉdepth {
        return Invalid;
    }
    let Handleˉvalue: bytes = Bytesˉslice(
        Initialˉlocals, Local * 8u32, 8u32
    );
    let Scopeˉvalue: bytes = Bytesˉslice(
        Initialˉlocals, Origin * 8u32, 8u32
    );
    let Handleˉtoken: bytes = Taskˉtokenˉfromˉvalue(
        Handleˉvalue, Bytesˉreadˉu32ˉlittle(Handleˉvalue, 4u32),
        Initialˉmetadata, Initialˉrecords
    );
    let Scopeˉtoken: bytes = Taskˉtokenˉfromˉvalue(
        Scopeˉvalue, Bytesˉreadˉu32ˉlittle(Scopeˉvalue, 4u32),
        Initialˉmetadata, Initialˉrecords
    );
    if Bytesˉlength(Handleˉtoken) != 8u32 ||
        Bytesˉlength(Scopeˉtoken) != 8u32 {
        return Invalid;
    }
    let Status: Tasks.Taskˉstatus = Tasks.Inspectˉtaskˉstatus(
        Initialˉtaskˉstate, Handleˉtoken, Scopeˉtoken
    );
    if !Status.Valid { return Invalid; }
    if Status.Status == 2u32 {
        return Taskˉscheduleˉexecution(
            true, false, Initialˉstack, Initialˉlocals,
            Functionˉindex, Functionˉcursor, 0u32, 0u32,
            Initialˉframes, Depth, Initialˉpending, Initialˉqueue
        );
    }
    let Selected: Taskˉqueueˉselection = Selectˉqueuedˉtask(
        Initialˉqueue, Scopeˉtoken
    );
    if !Selected.Valid || !Selected.Found ||
        Bytesˉlength(Selected.Record) < TASK_QUEUE_HEADER_BYTES {
        return Invalid;
    }
    let Taskˉtoken: bytes = Bytesˉslice(Selected.Record, 0u32, 8u32);
    let Selectedˉstatus: Tasks.Taskˉstatus = Tasks.Inspectˉtaskˉstatus(
        Initialˉtaskˉstate, Taskˉtoken, Scopeˉtoken
    );
    let Childˉfunction: u32 = Bytesˉreadˉu32ˉlittle(
        Selected.Record, 16u32
    );
    let Childˉcursor: u32 = Bytesˉreadˉu32ˉlittle(
        Selected.Record, 20u32
    );
    let Childˉcodeˉoffset: u32 = Bytesˉreadˉu32ˉlittle(
        Selected.Record, 24u32
    );
    let Childˉcodeˉlength: u32 = Bytesˉreadˉu32ˉlittle(
        Selected.Record, 28u32
    );
    let Childˉlocalsˉlength: u32 = Bytesˉreadˉu32ˉlittle(
        Selected.Record, 32u32
    );
    let Childˉmaximumˉwork: u64 = Bytesˉreadˉu64ˉlittle(
        Selected.Record, 36u32
    );
    let Childˉmaximumˉcallˉdepth: u32 = Bytesˉreadˉu32ˉlittle(
        Selected.Record, 44u32
    );
    let Parentˉdepth: u32 = Bytesˉreadˉu32ˉlittle(
        Selected.Record, 48u32
    );
    if !Selectedˉstatus.Valid || Selectedˉstatus.Status != 1u32 ||
        Childˉfunction >= Functionˉcount ||
        Childˉcursor != Childˉlocalsˉlength ||
        Childˉcursor != Bytesˉreadˉu32ˉlittle(
            Functionˉframeˉmetadata, Childˉfunction * 8u32 + 4u32
        ) ||
        Childˉcodeˉoffset != Bytesˉreadˉu32ˉlittle(
            Functionˉcodeˉoffsets, Childˉfunction * 4u32
        ) ||
        Childˉcodeˉlength != Bytesˉreadˉu32ˉlittle(
            Functionˉcodeˉlengths, Childˉfunction * 4u32
        ) ||
        Childˉmaximumˉwork == 0u64 ||
        Childˉmaximumˉwork > 1000000u64 ||
        Childˉmaximumˉcallˉdepth == 0u32 ||
        Childˉmaximumˉcallˉdepth > 64u32 ||
        Parentˉdepth != Depth ||
        Bytesˉlength(Selected.Record) !=
            TASK_QUEUE_HEADER_BYTES + Childˉlocalsˉlength {
        return Invalid;
    }
    var Parentˉframe: bytes = Bytesˉfromˉu32ˉlittle(Instructions);
    Parentˉframe = Bytesˉconcat(Parentˉframe, Initialˉlocals);
    Parentˉframe = Bytesˉconcat(
        Parentˉframe, Bytesˉfromˉu32ˉlittle(Functionˉindex)
    );
    var Pending: bytes = Bytesˉfromˉu32ˉlittle(Depth + 1u32);
    Pending = Bytesˉconcat(Pending, Taskˉtoken);
    Pending = Bytesˉconcat(Pending, Bytesˉfromˉu64ˉlittle(0u64));
    Pending = Bytesˉconcat(
        Pending, Bytesˉfromˉu32ˉlittle(Bytesˉlength(Initialˉstack) / 8u32)
    );
    Pending = Bytesˉconcat(Pending, Bytesˉfromˉu32ˉlittle(Executed));
    Pending = Bytesˉconcat(
        Pending, Bytesˉfromˉu64ˉlittle(Childˉmaximumˉwork)
    );
    Pending = Bytesˉconcat(
        Pending, Bytesˉfromˉu32ˉlittle(Childˉmaximumˉcallˉdepth)
    );
    return Taskˉscheduleˉexecution(
        true, true, Initialˉstack,
        Bytesˉslice(
            Selected.Record, TASK_QUEUE_HEADER_BYTES, Childˉlocalsˉlength
        ),
        Childˉfunction, Childˉcursor,
        Childˉcodeˉoffset, Childˉcodeˉlength,
        Bytesˉconcat(Initialˉframes, Parentˉframe), Depth + 1u32,
        Bytesˉconcat(Initialˉpending, Pending), Selected.Remaining
    );
}

record Taskˉreturnˉcompletion {
    Valid: bool;
    Handled: bool;
    Result: bytes;
    Taskˉstate: bytes;
    Metadata: bytes;
    Records: bytes;
    Pending: bytes;
    Parentˉstackˉcells: u32;
}

fn Completeˉspawnedˉtask(
    Taskˉpending: bytes,
    Depth: u32,
    Executed: u32,
    Initialˉtaskˉstate: bytes,
    Initialˉresult: bytes,
    Initialˉmetadata: bytes,
    Initialˉrecords: bytes,
    Zeroˉcell: bytes,
    Terminalˉkind: u32,
    Firstˉevidence: u64,
    Secondˉevidence: u64
) -> Taskˉreturnˉcompletion {
    let Length: u32 = Bytesˉlength(Taskˉpending);
    if Length < TASK_PENDING_BYTES || Length % TASK_PENDING_BYTES != 0u32 ||
        Bytesˉreadˉu32ˉlittle(
            Taskˉpending, Length - TASK_PENDING_BYTES
        ) != Depth {
        return Taskˉreturnˉcompletion(
            true, false, Initialˉresult, Initialˉtaskˉstate,
            Initialˉmetadata, Initialˉrecords, Taskˉpending, 0u32
        );
    }
    let Pendingˉoffset: u32 = Length - TASK_PENDING_BYTES;
    let Taskˉtoken: bytes = Bytesˉslice(
        Taskˉpending, Pendingˉoffset + 4u32, 8u32
    );
    let Parentˉstackˉcells: u32 = Bytesˉreadˉu32ˉlittle(
        Taskˉpending, Pendingˉoffset + 20u32
    );
    let Started: u32 = Bytesˉreadˉu32ˉlittle(
        Taskˉpending, Pendingˉoffset + 24u32
    );
    if Executed < Started {
        return Taskˉreturnˉcompletion(
            false, false, Initialˉresult, Initialˉtaskˉstate,
            Initialˉmetadata, Initialˉrecords, Taskˉpending, 0u32
        );
    }
    let Charged: Tasks.Workˉcharge = Tasks.Chargeˉwork(
        Initialˉtaskˉstate, Taskˉtoken, Executed - Started
    );
    if !Charged.Valid {
        return Taskˉreturnˉcompletion(
            false, false, Initialˉresult, Initialˉtaskˉstate,
            Initialˉmetadata, Initialˉrecords, Taskˉpending, 0u32
        );
    }
    var Completed: Tasks.Taskˉcompletion = Tasks.Completeˉtask(
        Charged.State, Taskˉtoken, Initialˉresult
    );
    if Terminalˉkind != 0u32 {
        Completed = Tasks.Completeˉterminal(
            Charged.State, Taskˉtoken, Terminalˉkind,
            Firstˉevidence, Secondˉevidence
        );
    }
    if !Completed.Valid {
        return Taskˉreturnˉcompletion(
            false, false, Initialˉresult, Initialˉtaskˉstate,
            Initialˉmetadata, Initialˉrecords, Taskˉpending, 0u32
        );
    }
    return Taskˉreturnˉcompletion(
        true, true, Bytesˉslice(Initialˉresult, 0u32, 0u32),
        Completed.State, Initialˉmetadata, Initialˉrecords,
        Bytesˉslice(Taskˉpending, 0u32, Pendingˉoffset),
        Parentˉstackˉcells
    );
}

record Taskˉtrapˉexecution {
    Valid: bool;
    Handled: bool;
    Stack: bytes;
    Locals: bytes;
    Taskˉstate: bytes;
    Metadata: bytes;
    Records: bytes;
    Frames: bytes;
    Pending: bytes;
    Releasedˉdescriptors: bytes;
    Functionˉindex: u32;
    Functionˉcursor: u32;
    Codeˉoffset: u32;
    Codeˉlength: u32;
    Instructions: u32;
    Depth: u32;
}

fn Executeˉspawnedˉterminal(
    Moduleˉminor: u32,
    Trapˉidentity: u32,
    Environment: Taskˉworkˉobservation,
    Initialˉstack: bytes,
    Stackˉdescriptorˉcount: u32,
    Stackˉdescriptorˉflagsˉlow: u32,
    Stackˉdescriptorˉflagsˉhigh: u32,
    Initialˉlocals: bytes,
    Initialˉtaskˉstate: bytes,
    Initialˉmetadata: bytes,
    Initialˉrecords: bytes,
    Initialˉframes: bytes,
    Initialˉpending: bytes,
    Initialˉreleasedˉdescriptors: bytes,
    Functionˉshapeˉoffsets: bytes,
    Localˉshapes: bytes,
    Heapˉallocations: bytes,
    Heapˉallocationˉcount: u32,
    Allocationˉleases: bytes,
    Functionˉcount: u32,
    Functionˉframeˉmetadata: bytes,
    Functionˉcodeˉoffsets: bytes,
    Functionˉcodeˉlengths: bytes,
    Initialˉfunctionˉindex: u32,
    Initialˉfunctionˉcursor: u32,
    Initialˉcodeˉoffset: u32,
    Initialˉcodeˉlength: u32,
    Initialˉinstructions: u32,
    Initialˉexecuted: u32,
    Initialˉdepth: u32,
    Zeroˉcell: bytes
) -> Taskˉtrapˉexecution {
    var Terminalˉkind: u32 = 5u32;
    var Firstˉevidence: u64 = U64ˉfromˉu32(Trapˉidentity);
    var Secondˉevidence: u64 = 0u64;
    if Environment.Terminal {
        Terminalˉkind = Environment.Terminalˉkind;
        Firstˉevidence = Environment.Firstˉevidence;
        Secondˉevidence = Environment.Secondˉevidence;
    }
    let Completion: Taskˉreturnˉcompletion = Completeˉspawnedˉtask(
        Initialˉpending, Initialˉdepth, Initialˉexecuted,
        Initialˉtaskˉstate,
        Zeroˉcell, Initialˉmetadata, Initialˉrecords, Zeroˉcell,
        Terminalˉkind, Firstˉevidence, Secondˉevidence
    );
    if !Completion.Valid || (Completion.Handled &&
        (Completion.Parentˉstackˉcells > Stackˉdescriptorˉcount ||
        Completion.Parentˉstackˉcells * 8u32 > Bytesˉlength(Initialˉstack))) {
        return Taskˉtrapˉexecution(
            false, false, Initialˉstack, Initialˉlocals,
            Initialˉtaskˉstate, Initialˉmetadata, Initialˉrecords,
            Initialˉframes, Initialˉpending, Initialˉreleasedˉdescriptors,
            Initialˉfunctionˉindex, Initialˉfunctionˉcursor,
            Initialˉcodeˉoffset, Initialˉcodeˉlength,
            Initialˉinstructions, Initialˉdepth
        );
    }
    if !Completion.Handled {
        return Taskˉtrapˉexecution(
            true, false, Initialˉstack, Initialˉlocals,
            Initialˉtaskˉstate, Initialˉmetadata, Initialˉrecords,
            Initialˉframes, Initialˉpending, Initialˉreleasedˉdescriptors,
            Initialˉfunctionˉindex, Initialˉfunctionˉcursor,
            Initialˉcodeˉoffset, Initialˉcodeˉlength,
            Initialˉinstructions, Initialˉdepth
        );
    }
    var Released: bytes = Bytesˉconcat(
        Initialˉreleasedˉdescriptors,
        Returningˉlocalˉdescriptors(
            Moduleˉminor, Initialˉfunctionˉindex,
            Initialˉfunctionˉcursor, Functionˉshapeˉoffsets,
            Localˉshapes, Initialˉlocals, Initialˉrecords,
            Heapˉallocations, Heapˉallocationˉcount, Allocationˉleases
        )
    );
    Released = Bytesˉconcat(
        Released,
        Stackˉdescriptorˉrootsˉafter(
            Initialˉstack, Stackˉdescriptorˉflagsˉlow,
            Stackˉdescriptorˉflagsˉhigh,
            Completion.Parentˉstackˉcells
        )
    );
    let Framesˉlength: u32 = Bytesˉlength(Initialˉframes);
    if Framesˉlength < 8u32 { return Taskˉtrapˉexecution(
        false, false, Initialˉstack, Initialˉlocals,
        Initialˉtaskˉstate, Initialˉmetadata, Initialˉrecords,
        Initialˉframes, Initialˉpending, Released,
        Initialˉfunctionˉindex, Initialˉfunctionˉcursor,
        Initialˉcodeˉoffset, Initialˉcodeˉlength,
        Initialˉinstructions, Initialˉdepth
    ); }
    let Parentˉfunction: u32 = Bytesˉreadˉu32ˉlittle(
        Initialˉframes, Framesˉlength - 4u32
    );
    if Parentˉfunction >= Functionˉcount { return Taskˉtrapˉexecution(
        false, false, Initialˉstack, Initialˉlocals,
        Initialˉtaskˉstate, Initialˉmetadata, Initialˉrecords,
        Initialˉframes, Initialˉpending, Released,
        Initialˉfunctionˉindex, Initialˉfunctionˉcursor,
        Initialˉcodeˉoffset, Initialˉcodeˉlength,
        Initialˉinstructions, Initialˉdepth
    ); }
    let Parentˉcursor: u32 = Bytesˉreadˉu32ˉlittle(
        Functionˉframeˉmetadata, Parentˉfunction * 8u32 + 4u32
    );
    if Parentˉcursor > Framesˉlength - 8u32 {
        return Taskˉtrapˉexecution(
            false, false, Initialˉstack, Initialˉlocals,
            Initialˉtaskˉstate, Initialˉmetadata, Initialˉrecords,
            Initialˉframes, Initialˉpending, Released,
            Initialˉfunctionˉindex, Initialˉfunctionˉcursor,
            Initialˉcodeˉoffset, Initialˉcodeˉlength,
            Initialˉinstructions, Initialˉdepth
        );
    }
    let Frameˉoffset: u32 = Framesˉlength - 8u32 - Parentˉcursor;
    return Taskˉtrapˉexecution(
        true, true,
        Bytesˉconcat(
            Bytesˉslice(
                Initialˉstack, 0u32, Completion.Parentˉstackˉcells * 8u32
            ),
            Completion.Result
        ),
        Bytesˉslice(Initialˉframes, Frameˉoffset + 4u32, Parentˉcursor),
        Completion.Taskˉstate, Completion.Metadata, Completion.Records,
        Bytesˉslice(Initialˉframes, 0u32, Frameˉoffset),
        Completion.Pending, Released, Parentˉfunction, Parentˉcursor,
        Bytesˉreadˉu32ˉlittle(
            Functionˉcodeˉoffsets, Parentˉfunction * 4u32
        ),
        Bytesˉreadˉu32ˉlittle(
            Functionˉcodeˉlengths, Parentˉfunction * 4u32
        ),
        Bytesˉreadˉu32ˉlittle(Initialˉframes, Frameˉoffset),
        Initialˉdepth - 1u32
    );
}

record Taskˉruntimeˉinitialization {
    Valid: bool;
    Locals: bytes;
    State: bytes;
    Metadata: bytes;
    Records: bytes;
}

fn Initializeˉtaskˉruntime(
    Hasˉoperationˉcontext: bool,
    Hasˉmemoryˉbudget: bool,
    Request: Executionˉrequest,
    Functionˉcursor: u32,
    Functionˉshapeˉoffsets: bytes,
    Mainˉindex: u32,
    Localˉshapes: bytes,
    Initialˉlocals: bytes,
    Initialˉmetadata: bytes,
    Initialˉrecords: bytes,
    Zeroˉcell: bytes
) -> Taskˉruntimeˉinitialization {
    let Empty: bytes = Bytesˉslice(Initialˉlocals, 0u32, 0u32);
    var State: bytes = Tasks.Constructˉstate(Empty);
    if Hasˉoperationˉcontext {
        State = Tasks.Constructˉstateˉwithˉenvironment(
            Empty, Request.Taskˉcontextˉgeneration,
            Request.Taskˉclockˉgeneration, Request.Taskˉdeadline,
            Request.Taskˉexpectedˉruntimeˉgeneration,
            Request.Taskˉadmittedˉruntimeˉgeneration
        );
    }
    if Bytesˉlength(State) == 0u32 {
        return Taskˉruntimeˉinitialization(
            false, Empty, Empty, Empty, Empty
        );
    }
    if !Hasˉoperationˉcontext {
        return Taskˉruntimeˉinitialization(
            true, Initialˉlocals, State, Initialˉmetadata, Initialˉrecords
        );
    }
    if !Hasˉmemoryˉbudget || Functionˉcursor < 16u32 {
        return Taskˉruntimeˉinitialization(
            false, Empty, Empty, Empty, Empty
        );
    }
    let Shapeˉoffset: u32 = Bytesˉreadˉu32ˉlittle(
        Functionˉshapeˉoffsets, Mainˉindex * 4u32
    );
    let Contextˉowner: u32 = Bytesˉreadˉu32ˉlittle(
        Localˉshapes, Shapeˉoffset + 12u32
    );
    if Contextˉowner == 0u32 {
        return Taskˉruntimeˉinitialization(
            false, Empty, Empty, Empty, Empty
        );
    }
    let Rootˉcontextˉtoken: bytes = Bytesˉconcat(
        Bytesˉfromˉu32ˉlittle(4294967295u32),
        Bytesˉfromˉu32ˉlittle(Request.Taskˉcontextˉgeneration)
    );
    let Rootˉcontext: Taskˉvalueˉallocation = Allocateˉtaskˉvalue(
        Contextˉowner, Rootˉcontextˉtoken,
        Initialˉmetadata, Initialˉrecords, Zeroˉcell
    );
    if !Rootˉcontext.Valid {
        return Taskˉruntimeˉinitialization(
            false, Empty, Empty, Empty, Empty
        );
    }
    let Locals: bytes = Bytesˉconcat(
        Bytesˉconcat(
            Bytesˉslice(Initialˉlocals, 0u32, 8u32), Rootˉcontext.Value
        ),
        Bytesˉslice(Initialˉlocals, 16u32, Functionˉcursor - 16u32)
    );
    return Taskˉruntimeˉinitialization(
        true, Locals, State, Rootˉcontext.Metadata, Rootˉcontext.Records
    );
}

record Taskˉinstructionˉexecution {
    Valid: bool;
    Handled: bool;
    Enteredˉcall: bool;
    Stack: bytes;
    Locals: bytes;
    Taskˉstate: bytes;
    Memoryˉbudgetˉstate: bytes;
    Metadata: bytes;
    Records: bytes;
    Consumed: u32;
    Produced: bool;
    Producedˉkind: u32;
    Instructions: u32;
    Functionˉindex: u32;
    Functionˉcursor: u32;
    Codeˉoffset: u32;
    Codeˉlength: u32;
    Frames: bytes;
    Depth: u32;
    Pending: bytes;
    Queue: bytes;
}

fn Executeˉtaskˉinstruction(
    Module: bytes,
    Typeˉoffsets: bytes,
    Typeˉcount: u32,
    Functionˉcount: u32,
    Payload: u32,
    Opcode: u32,
    Initialˉstack: bytes,
    Initialˉlocals: bytes,
    Functionˉcursor: u32,
    Initialˉtaskˉstate: bytes,
    Initialˉmemoryˉbudgetˉstate: bytes,
    Initialˉmetadata: bytes,
    Initialˉrecords: bytes,
    Zeroˉcell: bytes,
    Closureˉenvironments: bytes,
    Functionˉframeˉmetadata: bytes,
    Functionˉcodeˉoffsets: bytes,
    Functionˉcodeˉlengths: bytes,
    Instructions: u32,
    Executed: u32,
    Functionˉindex: u32,
    Initialˉframes: bytes,
    Zeroˉlocals: bytes,
    Depth: u32,
    Maximumˉdepth: u32,
    Initialˉpending: bytes,
    Initialˉqueue: bytes
) -> Taskˉinstructionˉexecution {
    if Opcode == 216u32 {
        let Spawned: Taskˉspawnˉexecution = Executeˉtaskˉspawn(
            Module, Typeˉoffsets, Typeˉcount, Functionˉcount,
            Payload, Initialˉstack, Initialˉlocals, Functionˉcursor,
            Initialˉtaskˉstate, Initialˉmetadata, Initialˉrecords,
            Zeroˉcell, Closureˉenvironments, Functionˉframeˉmetadata,
            Functionˉcodeˉoffsets, Functionˉcodeˉlengths,
            Instructions, Executed, Functionˉindex,
            Initialˉframes, Zeroˉlocals,
            Depth, Maximumˉdepth, Initialˉpending,
            Initialˉqueue
        );
        return Taskˉinstructionˉexecution(
            Spawned.Valid, Spawned.Valid, Spawned.Depth != Depth,
            Spawned.Stack, Spawned.Locals, Spawned.Taskˉstate,
            Initialˉmemoryˉbudgetˉstate, Spawned.Metadata,
            Spawned.Records, Spawned.Consumed, Spawned.Produced,
            Spawned.Producedˉkind, Spawned.Instructions,
            Spawned.Functionˉindex, Spawned.Functionˉcursor,
            Spawned.Codeˉoffset, Spawned.Codeˉlength, Spawned.Frames,
            Spawned.Depth, Spawned.Pending, Spawned.Queue
        );
    }
    if Opcode == 217u32 {
        let Scheduled: Taskˉscheduleˉexecution = Scheduleˉqueuedˉtask(
            Module, Payload, Initialˉstack, Initialˉlocals,
            Functionˉcursor, Initialˉtaskˉstate,
            Initialˉmetadata, Initialˉrecords, Functionˉcount,
            Functionˉframeˉmetadata, Functionˉcodeˉoffsets,
            Functionˉcodeˉlengths, Instructions, Executed,
            Functionˉindex, Initialˉframes, Depth, Maximumˉdepth,
            Initialˉpending, Initialˉqueue
        );
        if !Scheduled.Valid {
            return Taskˉinstructionˉexecution(
                false, false, false,
                Initialˉstack, Initialˉlocals, Initialˉtaskˉstate,
                Initialˉmemoryˉbudgetˉstate, Initialˉmetadata,
                Initialˉrecords, 0u32, false, 0u32, Instructions,
                Functionˉindex, Functionˉcursor, 0u32, 0u32,
                Initialˉframes, Depth, Initialˉpending,
                Initialˉqueue
            );
        }
        if Scheduled.Scheduled {
            return Taskˉinstructionˉexecution(
                true, true, true,
                Scheduled.Stack, Scheduled.Locals, Initialˉtaskˉstate,
                Initialˉmemoryˉbudgetˉstate, Initialˉmetadata,
                Initialˉrecords, 0u32, false, 0u32, 0u32,
                Scheduled.Functionˉindex, Scheduled.Functionˉcursor,
                Scheduled.Codeˉoffset, Scheduled.Codeˉlength,
                Scheduled.Frames, Scheduled.Depth, Scheduled.Pending,
                Scheduled.Queue
            );
        }
    }
    let Operation: Taskˉoperation = Executeˉtaskˉoperation(
        Module, Typeˉoffsets, Payload, Opcode, Initialˉstack,
        Initialˉlocals, Functionˉcursor, Initialˉtaskˉstate,
        Initialˉmemoryˉbudgetˉstate, Initialˉmetadata,
        Initialˉrecords, Zeroˉcell
    );
    return Taskˉinstructionˉexecution(
        Operation.Valid, Operation.Handled, false,
        Operation.Stack, Operation.Locals, Operation.Taskˉstate,
        Operation.Memoryˉbudgetˉstate, Operation.Metadata,
        Operation.Records, Operation.Consumed, Operation.Produced,
        Operation.Producedˉkind, Instructions + Operation.Instructions,
        Functionˉindex, Functionˉcursor, 0u32, 0u32,
        Initialˉframes, Depth, Initialˉpending,
        Initialˉqueue
    );
}

fn Successfulˉexecutionˉresponse(
    Requestˉmajor: u32,
    Responseˉminor: u32,
    Executed: u32,
    Returnˉresult: bytes,
    Stack: bytes,
    Standardˉoutput: bytes,
    Diagnosticˉoutput: bytes
) -> bytes {
    var Success: bytes = Bytesˉfromˉu32ˉlittle(1331189335u32);
    Success = Bytesˉconcat(
        Success, Bytesˉfromˉu16ˉlittle(Requestˉmajor)
    );
    Success = Bytesˉconcat(
        Success, Bytesˉfromˉu16ˉlittle(Responseˉminor)
    );
    Success = Bytesˉconcat(Success, Bytesˉfromˉu32ˉlittle(0u32));
    Success = Bytesˉconcat(Success, Bytesˉfromˉu32ˉlittle(Executed));
    Success = Bytesˉconcat(
        Success, Bytesˉslice(Returnˉresult, 0u32, 4u32)
    );
    if Requestˉmajor == 3u32 || Requestˉmajor == 4u32 ||
        (Requestˉmajor == 6u32 && Responseˉminor == 2u32) {
        var Streamˉsuccess: bytes = Success;
        Streamˉsuccess = Bytesˉconcat(
            Streamˉsuccess,
            Bytesˉfromˉu32ˉlittle(Bytesˉlength(Standardˉoutput))
        );
        Streamˉsuccess = Bytesˉconcat(
            Streamˉsuccess,
            Bytesˉfromˉu32ˉlittle(Bytesˉlength(Diagnosticˉoutput))
        );
        Streamˉsuccess = Bytesˉconcat(Streamˉsuccess, Standardˉoutput);
        return Bytesˉconcat(Streamˉsuccess, Diagnosticˉoutput);
    }
    if Requestˉmajor == 2u32 {
        return Bytesˉconcat(Success, Stack);
    }
    return Success;
}

export fn Main(Request: bytes) -> bytes {
    let Invalid: bytes = Bytesˉslice(Request, 0u32, 0u32);
    let Parsed: Executionˉrequest = Readˉexecutionˉrequest(Request);
    if !Parsed.Valid { return Invalid; }
    let Requestˉmajor: u32 = Parsed.Major;
    var Responseˉminor: u32 = 0u32;
    if Requestˉmajor == 6u32 && Parsed.Requestˉminor == 2u32 {
        Responseˉminor = 2u32;
    }
    let Maximumˉinstructions: u32 = Parsed.Maximumˉinstructions;
    let Maximumˉcallˉdepth: u32 = Parsed.Maximumˉcallˉdepth;
    let Module: bytes = Parsed.Module;
    let Moduleˉminor: u32 = Parsed.Moduleˉminor;
    let Guestˉinput: bytes = Parsed.Guestˉinput;
    let Data: u32 = Parsed.Data;
    let Functions: u32 = Parsed.Functions;
    let Functionsˉend: u32 = Parsed.Functionsˉend;
    let Code: u32 = Parsed.Code;
    let Typeˉcount: u32 = Parsed.Typeˉcount;
    let Functionˉcount: u32 = Parsed.Functionˉcount;
    let Mainˉindex: u32 = Parsed.Mainˉindex;
    let Typeˉoffsets: bytes = Parsed.Typeˉoffsets;
    let Capabilities: u32 = Parsed.Capabilities;
    let Capabilityˉgrants: u32 = Parsed.Capabilityˉgrants;
    let Standardˉoutputˉlimit: u32 = Parsed.Standardˉoutputˉlimit;
    let Diagnosticˉoutputˉlimit: u32 = Parsed.Diagnosticˉoutputˉlimit;
    let Argumentˉcount: u32 = Parsed.Argumentˉcount;
    let Argumentˉoffsets: bytes = Parsed.Argumentˉoffsets;
    let Declaredˉcapabilities: u32 = Parsed.Declaredˉcapabilities;
    let Capabilityˉkinds: bytes = Parsed.Capabilityˉkinds;
    let Sourceˉproviderˉgeneration: u32 =
        Parsed.Sourceˉgeneration;
    var Envelope: u32 = 0u32;
    var Sectionˉkind: u32 = 0u32;
    var Payload: u32 = 0u32;
    var Payloadˉlength: u32 = 0u32;

    let Zeroˉvalue: bytes = Bytesˉfromˉu32ˉlittle(0u32);
    let Zeroˉcell: bytes = Bytesˉconcat(Zeroˉvalue, Zeroˉvalue);
    var Standardˉoutput: bytes = Invalid;
    var Diagnosticˉoutput: bytes = Invalid;
    if Requestˉmajor >= 3u32 &&
        (Capabilityˉgrants & Declaredˉcapabilities)
            != Declaredˉcapabilities {
        return Capabilityˉdeniedˉresponse(Requestˉmajor, Responseˉminor);
    }

    let Directory: Functionˉdirectory = Readˉfunctionˉdirectory(
        Module,
        Functions,
        Functionsˉend,
        Code,
        Typeˉcount,
        Functionˉcount,
        Mainˉindex,
        Moduleˉminor,
        Requestˉmajor
    );
    if !Directory.Valid { return Invalid; }

    var Mainˉfound: bool = false;
    var Exportˉindex: u32 = Directory.Maximumˉslots;
    var Functionˉindex: u32 = 1u32;
    var Functionˉcursor: u32 = 0u32;
    var Aggregateˉinstructions: u32 = 0u32;
    var Mainˉcodeˉoffset: u32 = Directory.Mainˉcodeˉoffset;
    var Mainˉcodeˉlength: u32 = Directory.Mainˉcodeˉlength;
    let Functionˉframeˉmetadata: bytes = Directory.Frameˉmetadata;
    let Functionˉcodeˉoffsets: bytes = Directory.Codeˉoffsets;
    let Functionˉcodeˉlengths: bytes = Directory.Codeˉlengths;
    let Functionˉshapeˉoffsets: bytes = Directory.Shapeˉoffsets;
    let Localˉshapes: bytes = Directory.Localˉshapes;
    let Functionˉparameterˉmodeˉoffsets: bytes =
        Directory.Parameterˉmodeˉoffsets;
    let Functionˉparameterˉmodes: bytes = Directory.Parameterˉmodes;
    let Mainˉhasˉmemoryˉbudget: bool =
        Directory.Mainˉhasˉmemoryˉbudget;
    let Mainˉhasˉsourceˉfile: bool =
        Directory.Mainˉhasˉsourceˉfile;
    let Mainˉhasˉoperationˉcontext: bool =
        Directory.Mainˉhasˉoperationˉcontext;

    var Zeroˉlocals: bytes = Zeroˉcell;
    Functionˉindex = 1u32;
    while Functionˉindex < Exportˉindex {
        Zeroˉlocals = Bytesˉconcat(Zeroˉlocals, Zeroˉlocals);
        Functionˉindex = Functionˉindex * 2u32;
    }
    Functionˉcursor = Bytesˉreadˉu32ˉlittle(
        Functionˉframeˉmetadata,
        Mainˉindex * 8u32 + 4u32
    );

    Functionˉindex = Mainˉindex;
    Aggregateˉinstructions = 0u32;
    var Locals: bytes = Bytesˉslice(
        Zeroˉlocals,
        0u32,
        Functionˉcursor
    );
    var Memoryˉbudgetˉstate: bytes = Invalid;
    if Mainˉhasˉmemoryˉbudget {
        if Functionˉcursor < 8u32 { return Invalid; }
        Memoryˉbudgetˉstate = Budgets.Constructˉrootˉmemoryˉbudget(
            PORTABLE_ROOT_MEMORY_BUDGET_BYTES,
            PORTABLE_ROOT_MEMORY_BUDGET_CHILDREN
        );
        let Rootˉmemoryˉbudget: bytes =
            Budgets.Rootˉmemoryˉbudgetˉtoken(Memoryˉbudgetˉstate);
        if Bytesˉlength(Rootˉmemoryˉbudget) != 8u32 { return Invalid; }
        Locals = Bytesˉconcat(
            Rootˉmemoryˉbudget,
            Bytesˉslice(Locals, 8u32, Functionˉcursor - 8u32)
        );
    }
    Locals = Initializeˉsourceˉfileˉlocals(
        Requestˉmajor, Mainˉhasˉsourceˉfile,
        Sourceˉproviderˉgeneration, Guestˉinput, Locals, Functionˉcursor
    );
    if Mainˉhasˉsourceˉfile && Bytesˉlength(Locals) == 0u32 {
        return Invalid;
    }
    var Stack: bytes = Invalid;
    var Closureˉenvironments: bytes = Invalid;
    var Closureˉenvironmentˉcount: u32 = 0u32;
    // Keep descriptor identity separate from cell bits so pop never treats a
    // scalar with an offset/length-like value as heap ownership.
    var Stackˉdescriptorˉflagsˉlow: u32 = 0u32;
    var Stackˉdescriptorˉflagsˉhigh: u32 = 0u32;
    var Stackˉrecordˉflagsˉlow: u32 = 0u32;
    var Stackˉrecordˉflagsˉhigh: u32 = 0u32;
    var Stackˉcollectionˉflagsˉlow: u32 = 0u32;
    var Stackˉcollectionˉflagsˉhigh: u32 = 0u32;
    var Stackˉvectorˉflagsˉlow: u32 = 0u32;
    var Stackˉvectorˉflagsˉhigh: u32 = 0u32;
    var Frames: bytes = Invalid;
    var Heap: bytes = Invalid;
    var Heapˉallocations: bytes = Invalid;
    var Heapˉallocationˉcount: u32 = 0u32;
    var Guestˉinputˉheapˉoffset: u32 = 0u32;
    if Requestˉmajor == 2u32 {
        let Executionˉguestˉinputˉlength: u32 = Bytesˉlength(Guestˉinput);
        if Executionˉguestˉinputˉlength > 0u32 {
            Heap = Guestˉinput;
            Heapˉallocations = Bytesˉconcat(
                Zeroˉvalue,
                Bytesˉconcat(
                    Bytesˉfromˉu32ˉlittle(Executionˉguestˉinputˉlength),
                    Bytesˉfromˉu32ˉlittle(1u32)
                )
            );
            Heapˉallocationˉcount = 1u32;
        }
        Locals = Bytesˉconcat(
            Bytesˉconcat(
                Bytesˉfromˉu32ˉlittle(Guestˉinputˉheapˉoffset),
                Bytesˉfromˉu32ˉlittle(Bytesˉlength(Guestˉinput))
            ),
            Bytesˉslice(Zeroˉlocals, 8u32, Functionˉcursor - 8u32)
        );
    }
    var Zeroˉlease: bytes = Zeroˉcell;
    Zeroˉlease = Bytesˉconcat(Zeroˉlease, Zeroˉcell);
    Zeroˉlease = Bytesˉconcat(Zeroˉlease, Zeroˉcell);
    Zeroˉlease = Bytesˉconcat(Zeroˉlease, Zeroˉvalue);
    var Allocationˉleases: bytes = Zeroˉallocationˉleases(
        Heapˉallocationˉcount, Zeroˉlease
    );
    if Bytesˉlength(Allocationˉleases) !=
        Heapˉallocationˉcount * 28u32 {
        return Invalid;
    }
    let Recordˉcapacity: u32 = 768u32;
    let Recordˉmetadataˉlength: u32 = Recordˉcapacity * 8u32;
    var Recordˉmetadata: bytes =
        Envelopeˉreader.Interpreterˉrecordˉmetadata(Request);
    if Bytesˉlength(Recordˉmetadata) != Recordˉmetadataˉlength {
        return Invalid;
    }
    let Recordˉzeroˉslots: bytes = Bytesˉslice(
        Recordˉmetadata,
        0u32,
        Recordˉcapacity
    );
    var Records: bytes = Invalid;
    let Taskˉruntime: Taskˉruntimeˉinitialization =
        Initializeˉtaskˉruntime(
            Mainˉhasˉoperationˉcontext, Mainˉhasˉmemoryˉbudget,
            Parsed,
            Functionˉcursor, Functionˉshapeˉoffsets, Mainˉindex,
            Localˉshapes, Locals, Recordˉmetadata, Records, Zeroˉcell
        );
    if !Taskˉruntime.Valid { return Invalid; }
    Locals = Taskˉruntime.Locals;
    var Taskˉstate: bytes = Taskˉruntime.State;
    Recordˉmetadata = Taskˉruntime.Metadata;
    Records = Taskˉruntime.Records;
    var Taskˉpending: bytes = Invalid;
    var Taskˉqueue: bytes = Invalid;
    // Reuse completed-preflight slots as execution state: Functionˉindex is the
    // current function, Aggregateˉinstructions is PC, Exportˉindex is depth,
    // Envelope is executed count, Sectionˉkind is guest status, Payload is the
    // instruction, Payloadˉlength is opcode, and Mainˉfound is handled state.
    Exportˉindex = 1u32;
    Envelope = 0u32;
    Sectionˉkind = 0u32;
    var Running: bool = true;
    while Running {
        let Taskˉwork: Taskˉworkˉobservation = Observeˉtaskˉwork(
            Taskˉpending, Envelope, Taskˉstate, Parsed
        );
        if !Taskˉwork.Valid { return Invalid; }
        if Envelope >= Maximumˉinstructions {
            Sectionˉkind = 3011u32;
        } else {
        let Stackˉdescriptorˉcount: u32 = Bytesˉlength(Stack) / 8u32;
        var Stackˉconsumed: u32 = 0u32;
        var Stackˉproduced: bool = false;
        var Stackˉproducedˉkind: u32 = 0u32;
        var Releasedˉdescriptors: bytes = Invalid;
        var Heapˉallocationˉrequested: bool = false;
        var Heapˉallocationˉvalue: bytes = Invalid;
        if Taskˉwork.Terminal {
            Sectionˉkind = 1u32;
            Mainˉfound = true;
        } else if Taskˉwork.Exhausted {
            Sectionˉkind = 3011u32;
            Mainˉfound = true;
        } else {
        Envelope = Envelope + 1u32;
        Payload = Code + Mainˉcodeˉoffset + Aggregateˉinstructions;
        Payloadˉlength = U32ˉfromˉu8(Bytesˉreadˉu8(Module, Payload));
        Mainˉfound = false;
        let Effectiveˉcallˉdepth: u32 = Effectiveˉtaskˉcallˉdepth(
            Taskˉpending, Maximumˉcallˉdepth
        );
        if Effectiveˉcallˉdepth == 0u32 { return Invalid; }
        let Stackˉeffect: u32 = U32ˉfromˉu8(
            Bytesˉreadˉu8(Stackˉeffects, Payloadˉlength)
        );
        Stackˉconsumed = Stackˉeffect & 3u32;
        Stackˉproduced = (Stackˉeffect & 4u32) != 0u32;
        Stackˉproducedˉkind = (Stackˉeffect >> 3u32) & 1u32;

        if Payloadˉlength <= 22u32 {
        if Payloadˉlength == 1u32 || Payloadˉlength == 9u32 {
            Stack = Bytesˉconcat(
                Stack,
                Bytesˉconcat(
                    Bytesˉslice(Module, Payload + 1u32, 4u32),
                    Zeroˉvalue
                )
            );
            Aggregateˉinstructions = Aggregateˉinstructions + 5u32;
            Mainˉfound = true;
        }
        if Payloadˉlength == 2u32 || Payloadˉlength == 8u32 {
            Stack = Bytesˉconcat(
                Stack,
                Bytesˉconcat(
                    Bytesˉfromˉu32ˉlittle(U32ˉfromˉu8(
                        Bytesˉreadˉu8(Module, Payload + 1u32)
                    )),
                    Zeroˉvalue
                )
            );
            Aggregateˉinstructions = Aggregateˉinstructions + 2u32;
            Mainˉfound = true;
        }

        let Dataˉresult: Dataˉexecution = Executeˉdata(
            Module,
            Data,
            Payload,
            Payloadˉlength,
            Stack
        );
        if !Dataˉresult.Valid { return Invalid; }
        if Dataˉresult.Handled {
            Stack = Dataˉresult.Stack;
            Sectionˉkind = Dataˉresult.Status;
            Heapˉallocationˉrequested = Dataˉresult.Allocationˉrequested;
            Heapˉallocationˉvalue = Dataˉresult.Allocationˉvalue;
            Aggregateˉinstructions = Aggregateˉinstructions + 5u32;
            Mainˉfound = true;
        }

        let Localˉresult: Localˉexecution = Executeˉlocal(
            Module,
            Payload,
            Payloadˉlength,
            Functionˉshapeˉoffsets,
            Functionˉindex,
            Localˉshapes,
            Typeˉoffsets,
            Stack,
            Locals,
            Functionˉcursor,
            Heapˉallocations,
            Heapˉallocationˉcount,
            Stackˉproducedˉkind
        );
        if !Localˉresult.Valid { return Invalid; }
        if Localˉresult.Handled {
            Stack = Localˉresult.Stack;
            Locals = Localˉresult.Locals;
            Heapˉallocations = Localˉresult.Heapˉallocations;
            Releasedˉdescriptors = Bytesˉconcat(
                Releasedˉdescriptors, Localˉresult.Releasedˉdescriptors
            );
            Stackˉproducedˉkind = Localˉresult.Producedˉkind;
            Aggregateˉinstructions = Aggregateˉinstructions + 5u32;
            Mainˉfound = true;
        }

        let Bytesˉresult: Bytesˉexecution = Executeˉbytes(
            Heap,
            Payloadˉlength,
            Stack
        );
        if Bytesˉresult.Handled {
            Stack = Bytesˉresult.Stack;
            Sectionˉkind = Bytesˉresult.Status;
            Releasedˉdescriptors = Bytesˉconcat(
                Releasedˉdescriptors,
                Bytesˉresult.Releasedˉdescriptors
            );
            Aggregateˉinstructions = Aggregateˉinstructions + 1u32;
            Mainˉfound = true;
        }

        if Isˉbaseˉnumeric(Payloadˉlength) {
            let Baseˉnumericˉresult: bytes = Executeˉbaseˉnumeric(
                Payloadˉlength, Stack, Zeroˉvalue
            );
            if Bytesˉlength(Baseˉnumericˉresult) < 4u32 { return Invalid; }
            Sectionˉkind = Bytesˉreadˉu32ˉlittle(
                Baseˉnumericˉresult, 0u32
            );
            Stack = Bytesˉslice(
                Baseˉnumericˉresult,
                4u32,
                Bytesˉlength(Baseˉnumericˉresult) - 4u32
            );
            Aggregateˉinstructions = Aggregateˉinstructions + 1u32;
            Mainˉfound = true;
        }
        }

        else {
        let Highˉnumeric: Numericˉinstructionˉexecution =
            Executeˉhighˉnumericˉinstruction(
                Payloadˉlength, Stack, Zeroˉvalue
            );
        if !Highˉnumeric.Valid { return Invalid; }
        if Highˉnumeric.Handled {
            Sectionˉkind = Highˉnumeric.Status;
            Stack = Highˉnumeric.Stack;
            Aggregateˉinstructions = Aggregateˉinstructions + 1u32;
            Mainˉfound = true;
        }

        if Payloadˉlength >= 32u32 && Payloadˉlength <= 40u32 {
            Stack = Executeˉbaseˉcomparison(
                Payloadˉlength, Stack, Zeroˉvalue
            );
            if Bytesˉlength(Stack) == 0u32 { return Invalid; }
            Aggregateˉinstructions = Aggregateˉinstructions + 1u32;
            Mainˉfound = true;
        }

        let Extended: Extendedˉexecution = Executeˉextended(
            Module,
            Typeˉoffsets,
            Typeˉcount,
            Payload,
            Payloadˉlength,
            Stack,
            Stackˉconsumed,
            Stackˉproduced,
            Stackˉproducedˉkind,
            Zeroˉvalue,
            Zeroˉcell,
            Heap,
            Heapˉallocations,
            Heapˉallocationˉcount,
            Memoryˉbudgetˉstate,
            Allocationˉleases,
            Recordˉmetadata,
            Records,
            Taskˉstate,
            Stackˉdescriptorˉflagsˉlow,
            Stackˉdescriptorˉflagsˉhigh,
            Stackˉrecordˉflagsˉlow,
            Stackˉrecordˉflagsˉhigh,
            Stackˉcollectionˉflagsˉlow,
            Stackˉcollectionˉflagsˉhigh,
            Stackˉvectorˉflagsˉlow,
            Stackˉvectorˉflagsˉhigh,
            Functionˉshapeˉoffsets,
            Functionˉparameterˉmodeˉoffsets,
            Functionˉparameterˉmodes,
            Functionˉindex,
            Mainˉindex,
            Mainˉhasˉmemoryˉbudget,
            Mainˉhasˉsourceˉfile,
            Sourceˉproviderˉgeneration,
            Locals,
            Localˉshapes,
            Functionˉcursor,
            Frames,
            Functionˉcount,
            Functionˉframeˉmetadata
        );
        if !Extended.Valid { return Invalid; }
        if Extended.Handled {
            Stack = Extended.Stack;
            Sectionˉkind = Extended.Status;
            Releasedˉdescriptors = Bytesˉconcat(
                Releasedˉdescriptors,
                Extended.Releasedˉdescriptors
            );
            Heapˉallocationˉrequested = Extended.Allocationˉrequested;
            Heapˉallocationˉvalue = Extended.Allocationˉvalue;
            Heap = Extended.Heap;
            Recordˉmetadata = Extended.Recordˉmetadata;
            Records = Extended.Records;
            Heapˉallocations = Extended.Heapˉallocations;
            Memoryˉbudgetˉstate = Extended.Memoryˉbudgetˉstate;
            Heapˉallocationˉcount = Extended.Heapˉallocationˉcount;
            Allocationˉleases = Extended.Allocationˉleases;
            Locals = Extended.Locals;
            Stackˉconsumed = Extended.Consumed;
            Stackˉproduced = Extended.Produced;
            Stackˉproducedˉkind = Extended.Producedˉkind;
            Aggregateˉinstructions =
                Aggregateˉinstructions + Extended.Instructions;
            Mainˉfound = true;
        }

        let Taskˉinstruction: Taskˉinstructionˉexecution =
            Executeˉtaskˉinstruction(
                Module, Typeˉoffsets, Typeˉcount, Functionˉcount,
                Payload, Payloadˉlength, Stack, Locals, Functionˉcursor,
                Taskˉstate, Memoryˉbudgetˉstate, Recordˉmetadata,
                Records, Zeroˉcell, Closureˉenvironments,
                Functionˉframeˉmetadata, Functionˉcodeˉoffsets,
                Functionˉcodeˉlengths, Aggregateˉinstructions,
                Envelope, Functionˉindex, Frames, Zeroˉlocals,
                Exportˉindex, Effectiveˉcallˉdepth, Taskˉpending,
                Taskˉqueue
            );
        if !Taskˉinstruction.Valid { return Invalid; }
        if Taskˉinstruction.Handled {
            Stack = Taskˉinstruction.Stack;
            Locals = Taskˉinstruction.Locals;
            Taskˉstate = Taskˉinstruction.Taskˉstate;
            Memoryˉbudgetˉstate = Taskˉinstruction.Memoryˉbudgetˉstate;
            Recordˉmetadata = Taskˉinstruction.Metadata;
            Records = Taskˉinstruction.Records;
            Stackˉconsumed = Taskˉinstruction.Consumed;
            Stackˉproduced = Taskˉinstruction.Produced;
            Stackˉproducedˉkind = Taskˉinstruction.Producedˉkind;
            Aggregateˉinstructions = Taskˉinstruction.Instructions;
            Frames = Taskˉinstruction.Frames;
            Taskˉpending = Taskˉinstruction.Pending;
            Taskˉqueue = Taskˉinstruction.Queue;
            if Taskˉinstruction.Enteredˉcall {
                Functionˉindex = Taskˉinstruction.Functionˉindex;
                Functionˉcursor = Taskˉinstruction.Functionˉcursor;
                Mainˉcodeˉoffset = Taskˉinstruction.Codeˉoffset;
                Mainˉcodeˉlength = Taskˉinstruction.Codeˉlength;
                Exportˉindex = Taskˉinstruction.Depth;
            }
            Mainˉfound = true;
        }

        if Payloadˉlength == 48u32 {
            Aggregateˉinstructions = Bytesˉreadˉu32ˉlittle(Module, Payload + 1u32);
            Mainˉfound = true;
        }
        if Payloadˉlength == 49u32 {
            let Branchˉstackˉlength: u32 = Bytesˉlength(Stack);
            let Condition: u32 = Bytesˉreadˉu32ˉlittle(
                Stack,
                Branchˉstackˉlength - 8u32
            );
            Stack = Bytesˉslice(
                Stack,
                0u32,
                Branchˉstackˉlength - 8u32
            );
            if Condition == 0u32 {
                Aggregateˉinstructions = Bytesˉreadˉu32ˉlittle(Module, Payload + 1u32);
            } else {
                Aggregateˉinstructions = Aggregateˉinstructions + 5u32;
            }
            Mainˉfound = true;
        }

        if Payloadˉlength >= 192u32 && Payloadˉlength <= 195u32 {
            let Scalarˉexecutionˉresult: bytes = Fixed.Executeˉscalar(
                Module,
                Payload,
                Stack,
                Stackˉdescriptorˉcount,
                Zeroˉvalue
            );
            if Bytesˉlength(Scalarˉexecutionˉresult) < 5u32 {
                return Invalid;
            }
            let Scalarˉmetadata: u32 = U32ˉfromˉu8(
                Bytesˉreadˉu8(Scalarˉexecutionˉresult, 0u32)
            );
            Sectionˉkind = Bytesˉreadˉu32ˉlittle(
                Scalarˉexecutionˉresult,
                1u32
            );
            Stack = Bytesˉslice(
                Scalarˉexecutionˉresult,
                5u32,
                Bytesˉlength(Scalarˉexecutionˉresult) - 5u32
            );
            Stackˉconsumed = Scalarˉmetadata & 3u32;
            Aggregateˉinstructions = Aggregateˉinstructions +
                (Scalarˉmetadata >> 2u32);
            Mainˉfound = true;
        }

        var Isˉu64ˉinstruction: bool = Payloadˉlength == 129u32;
