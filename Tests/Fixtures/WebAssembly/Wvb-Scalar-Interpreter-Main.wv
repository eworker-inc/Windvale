            Isˉu64ˉinstruction = true;
        }
        if Payloadˉlength >= 143u32 && Payloadˉlength <= 148u32 {
            Isˉu64ˉinstruction = true;
        }
        if Payloadˉlength >= 179u32 && Payloadˉlength <= 184u32 {
