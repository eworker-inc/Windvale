module Webassemblyˉgeneralˉdispatcherˉdescriptors profile portable;

data Greeting: text = "Windvale";
data Raw: bytes = [1, 2, 3, 4, 255, 255, 255, 255];

export fn Main() -> i32 {
    let Encoded: bytes = Textˉtoˉutf8(Greeting);
    let Tail: bytes = Bytesˉslice(Raw, 1u32, 4u32);
    if Bytesˉlength(Encoded) != 8u32 { return 1; }
    if Bytesˉreadˉu8(Tail, 0u32) != 2u8 { return 2; }
    if Bytesˉreadˉu16ˉlittle(Tail, 0u32) != 770u32 { return 3; }
    if Bytesˉreadˉu32ˉlittle(Raw, 0u32) != 67305985u32 { return 4; }
    if Bytesˉreadˉi32ˉlittle(Raw, 4u32) != -1 { return 5; }
    return 42;
}
