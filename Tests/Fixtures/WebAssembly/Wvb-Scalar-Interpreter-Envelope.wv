module WebAssemblyˉwvbˉscalarˉinterpreterˉenvelope profile portable;

fn Callableˉshapeˉend(
    Module: bytes,
    Cursor: u32,
    Typeˉcount: u32
) -> u32 {
    let Kind: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(Module, Cursor));
    if Kind < 1u32 || Kind == 12u32 || Kind == 13u32 || Kind == 21u32 ||
        Kind == 25u32 || Kind == 26u32 || Kind == 27u32 || Kind == 28u32 ||
        Kind == 29u32 || Kind == 30u32 || Kind == 31u32 || Kind == 32u32 ||
        Kind == 33u32 || Kind == 34u32 || Kind > 35u32 {
        return 0u32;
    }
    var End: u32 = Cursor + 1u32;
    if Kind == 7u32 || Kind == 8u32 || Kind == 11u32 || Kind == 22u32 ||
        Kind == 23u32 || Kind == 24u32 || Kind == 35u32 {
        if Bytesˉreadˉu32ˉlittle(Module, End) >= Typeˉcount { return 0u32; }
        End = End + 4u32;
    }
    return End;
}

fn Capabilityˉnameˉequals(
    Module: bytes,
    Offset: u32,
    Length: u32,
    Expected: text
) -> bool {
    let Expectedˉbytes: bytes = Textˉtoˉutf8(Expected);
    if Length != Bytesˉlength(Expectedˉbytes) { return false; }
    var Index: u32 = 0u32;
    while Index < Length {
        if Bytesˉreadˉu8(Module, Offset + Index)
            != Bytesˉreadˉu8(Expectedˉbytes, Index) {
            return false;
        }
        Index = Index + 1u32;
    }
    return true;
}

export fn Interpreterˉenvelope(Request: bytes) -> bytes {
    let Invalid: bytes = Bytesˉslice(Request, 0u32, 0u32);
    let Requestˉlength: u32 = Bytesˉlength(Request);
    if Requestˉlength < 17u32 { return Invalid; }
    if Bytesˉreadˉu32ˉlittle(Request, 0u32) != 1230526039u32 {
        return Invalid;
    }
    let Requestˉmajor: u32 = Bytesˉreadˉu16ˉlittle(Request, 4u32);
    if Requestˉmajor < 1u32 { return Invalid; }
    if Requestˉmajor > 6u32 { return Invalid; }
    let Requestˉminor: u32 = Bytesˉreadˉu16ˉlittle(Request, 6u32);
    if (Requestˉmajor == 6u32 && Requestˉminor != 1u32 &&
            Requestˉminor != 2u32) ||
        (Requestˉmajor != 6u32 && Requestˉminor != 0u32) {
        return Invalid;
    }
    let Maximumˉinstructions: u32 = Bytesˉreadˉu32ˉlittle(Request, 8u32);
    let Maximumˉcallˉdepth: u32 = Bytesˉreadˉu32ˉlittle(Request, 12u32);
    if Maximumˉinstructions < 1u32 { return Invalid; }
    if Maximumˉinstructions > 20000000u32 { return Invalid; }
    if Maximumˉcallˉdepth < 1u32 { return Invalid; }
    if Maximumˉcallˉdepth > 64u32 { return Invalid; }

    var Moduleˉoffset: u32 = 16u32;
    var Moduleˉlength: u32 = Requestˉlength - 16u32;
    var Guestˉinputˉoffset: u32 = Requestˉlength;
    var Guestˉinputˉlength: u32 = 0u32;
    var Capabilityˉgrants: u32 = 0u32;
    var Standardˉoutputˉlimit: u32 = 0u32;
    var Diagnosticˉoutputˉlimit: u32 = 0u32;
    var Argumentˉcount: u32 = 0u32;
    var Argumentˉoffsets: bytes = Invalid;
    var Sourceˉrights: u32 = 0u32;
    var Sourceˉproviderˉgeneration: u32 = 0u32;
    var Sourceˉresourceˉgeneration: u32 = 0u32;
    var Taskˉcontextˉgeneration: u32 = 0u32;
    var Taskˉclockˉgeneration: u64 = 0u64;
    var Taskˉdeadline: u64 = 0u64;
    var Taskˉexpectedˉruntimeˉgeneration: u64 = 0u64;
    var Taskˉadmittedˉruntimeˉgeneration: u64 = 0u64;
    var Taskˉobservationˉtick: u64 = 0u64;
    var Taskˉobservedˉruntimeˉgeneration: u64 = 0u64;
    if Requestˉmajor == 2u32 {
        if Requestˉlength < 24u32 { return Invalid; }
        Moduleˉoffset = 24u32;
        Moduleˉlength = Bytesˉreadˉu32ˉlittle(Request, 16u32);
        Guestˉinputˉlength = Bytesˉreadˉu32ˉlittle(Request, 20u32);
        if Moduleˉlength > Requestˉlength - 24u32 { return Invalid; }
        if Guestˉinputˉlength != Requestˉlength - 24u32 - Moduleˉlength {
            return Invalid;
        }
        if Guestˉinputˉlength > 16384u32 { return Invalid; }
        Guestˉinputˉoffset = 24u32 + Moduleˉlength;
    }
    if Requestˉmajor == 3u32 {
        if Requestˉlength < 32u32 { return Invalid; }
        Moduleˉoffset = 32u32;
        Moduleˉlength = Bytesˉreadˉu32ˉlittle(Request, 16u32);
        Capabilityˉgrants = Bytesˉreadˉu32ˉlittle(Request, 20u32);
        Standardˉoutputˉlimit = Bytesˉreadˉu32ˉlittle(Request, 24u32);
        if Bytesˉreadˉu32ˉlittle(Request, 28u32) != 0u32 {
            return Invalid;
        }
        if Capabilityˉgrants > 1u32 { return Invalid; }
        if Standardˉoutputˉlimit > 65536u32 { return Invalid; }
        if Moduleˉlength != Requestˉlength - 32u32 { return Invalid; }
    }
    if Requestˉmajor == 4u32 {
        if Requestˉlength < 44u32 { return Invalid; }
        Moduleˉoffset = 44u32;
        Moduleˉlength = Bytesˉreadˉu32ˉlittle(Request, 16u32);
        Capabilityˉgrants = Bytesˉreadˉu32ˉlittle(Request, 20u32);
        Standardˉoutputˉlimit = Bytesˉreadˉu32ˉlittle(Request, 24u32);
        Diagnosticˉoutputˉlimit = Bytesˉreadˉu32ˉlittle(Request, 28u32);
        Argumentˉcount = Bytesˉreadˉu32ˉlittle(Request, 32u32);
        Guestˉinputˉlength = Bytesˉreadˉu32ˉlittle(Request, 36u32);
        if Bytesˉreadˉu32ˉlittle(Request, 40u32) != 0u32 {
            return Invalid;
        }
        if Capabilityˉgrants > 15u32 { return Invalid; }
        if Standardˉoutputˉlimit > 65536u32 { return Invalid; }
        if Diagnosticˉoutputˉlimit > 65536u32 { return Invalid; }
        if Argumentˉcount > 65u32 { return Invalid; }
        if Moduleˉlength > Requestˉlength - 44u32 { return Invalid; }
        if Guestˉinputˉlength
            != Requestˉlength - 44u32 - Moduleˉlength {
            return Invalid;
        }
        Guestˉinputˉoffset = 44u32 + Moduleˉlength;
        var Argumentˉcursor: u32 = Guestˉinputˉoffset;
        var Argumentˉindex: u32 = 0u32;
        var Argumentˉutf8ˉbytes: u32 = 0u32;
        while Argumentˉindex < Argumentˉcount {
            if Argumentˉcursor > Requestˉlength - 4u32 { return Invalid; }
            Argumentˉoffsets = Bytesˉconcat(
                Argumentˉoffsets,
                Bytesˉfromˉu32ˉlittle(
                    Argumentˉcursor - Guestˉinputˉoffset
                )
            );
            let Argumentˉlength: u32 = Bytesˉreadˉu32ˉlittle(
                Request,
                Argumentˉcursor
            );
            Argumentˉcursor = Argumentˉcursor + 4u32;
            if Argumentˉlength > 4096u32 { return Invalid; }
            if Argumentˉlength > Requestˉlength - Argumentˉcursor {
                return Invalid;
            }
            if Argumentˉutf8ˉbytes > 65536u32 - Argumentˉlength {
                return Invalid;
            }
            Argumentˉutf8ˉbytes = Argumentˉutf8ˉbytes + Argumentˉlength;
            Argumentˉcursor = Argumentˉcursor + Argumentˉlength;
            Argumentˉindex = Argumentˉindex + 1u32;
        }
        if Argumentˉcursor != Requestˉlength { return Invalid; }
    }
    if Requestˉmajor == 5u32 {
        if Requestˉlength < 40u32 { return Invalid; }
        Moduleˉoffset = 40u32;
        Moduleˉlength = Bytesˉreadˉu32ˉlittle(Request, 16u32);
        Sourceˉrights = Bytesˉreadˉu32ˉlittle(Request, 20u32);
        Sourceˉproviderˉgeneration = Bytesˉreadˉu32ˉlittle(Request, 24u32);
        Sourceˉresourceˉgeneration = Bytesˉreadˉu32ˉlittle(Request, 28u32);
        Guestˉinputˉlength = Bytesˉreadˉu32ˉlittle(Request, 32u32);
        if Bytesˉreadˉu32ˉlittle(Request, 36u32) != 0u32 {
            return Invalid;
        }
        if Sourceˉrights != 1u32 || Sourceˉproviderˉgeneration == 0u32 ||
            Sourceˉresourceˉgeneration != Sourceˉproviderˉgeneration ||
            Guestˉinputˉlength > 1048576u32 ||
            Moduleˉlength > Requestˉlength - 40u32 ||
            Guestˉinputˉlength != Requestˉlength - 40u32 - Moduleˉlength {
            return Invalid;
        }
        Guestˉinputˉoffset = 40u32 + Moduleˉlength;
    }
    if Requestˉmajor == 6u32 {
        if Requestˉminor == 1u32 {
            if Requestˉlength < 84u32 { return Invalid; }
            Moduleˉoffset = 72u32;
        } else {
            if Requestˉlength < 96u32 { return Invalid; }
            Moduleˉoffset = 84u32;
            Capabilityˉgrants = Bytesˉreadˉu32ˉlittle(Request, 72u32);
            Standardˉoutputˉlimit = Bytesˉreadˉu32ˉlittle(Request, 76u32);
            if Bytesˉreadˉu32ˉlittle(Request, 80u32) != 0u32 ||
                Capabilityˉgrants > 1u32 ||
                Standardˉoutputˉlimit > 65536u32 {
                return Invalid;
            }
        }
        Moduleˉlength = Bytesˉreadˉu32ˉlittle(Request, 16u32);
        Taskˉcontextˉgeneration = Bytesˉreadˉu32ˉlittle(Request, 20u32);
        Taskˉclockˉgeneration = Bytesˉreadˉu64ˉlittle(Request, 24u32);
        Taskˉdeadline = Bytesˉreadˉu64ˉlittle(Request, 32u32);
        Taskˉexpectedˉruntimeˉgeneration = Bytesˉreadˉu64ˉlittle(
            Request, 40u32
        );
        Taskˉadmittedˉruntimeˉgeneration = Bytesˉreadˉu64ˉlittle(
            Request, 48u32
        );
        Taskˉobservationˉtick = Bytesˉreadˉu64ˉlittle(Request, 56u32);
        Taskˉobservedˉruntimeˉgeneration = Bytesˉreadˉu64ˉlittle(
            Request, 64u32
        );
        if Taskˉcontextˉgeneration == 0u32 ||
            Taskˉclockˉgeneration == 0u64 ||
            Taskˉexpectedˉruntimeˉgeneration == 0u64 ||
            Moduleˉlength != Requestˉlength - Moduleˉoffset {
            return Invalid;
        }
    }

    let Module: bytes = Bytesˉslice(Request, Moduleˉoffset, Moduleˉlength);
    if Moduleˉlength < 12u32 { return Invalid; }
    if U32ˉfromˉu8(Bytesˉreadˉu8(Module, 0u32)) != 87u32 { return Invalid; }
    if U32ˉfromˉu8(Bytesˉreadˉu8(Module, 1u32)) != 86u32 { return Invalid; }
    if U32ˉfromˉu8(Bytesˉreadˉu8(Module, 2u32)) != 66u32 { return Invalid; }
    if U32ˉfromˉu8(Bytesˉreadˉu8(Module, 3u32)) != 49u32 { return Invalid; }
    if Bytesˉreadˉu16ˉlittle(Module, 4u32) != 1u32 { return Invalid; }
    let Moduleˉminor: u32 = Bytesˉreadˉu16ˉlittle(Module, 6u32);
    if Moduleˉminor < 11u32 || Moduleˉminor > 37u32 { return Invalid; }
    if Bytesˉreadˉu32ˉlittle(Module, 8u32) != 7u32 { return Invalid; }

    var Cursor: u32 = 12u32;
    var Sectionˉkind: u32 = 1u32;
    var Payload: u32 = 0u32;
    var Payloadˉlength: u32 = 0u32;
    var Capabilities: u32 = 0u32;
    var Data: u32 = 0u32;
    var Functions: u32 = 0u32;
    var Functionsˉend: u32 = 0u32;
    var Code: u32 = 0u32;
    var Exports: u32 = 0u32;
    var Types: u32 = 0u32;
    while Sectionˉkind <= 7u32 {
        Payload = Cursor + 8u32;
        Payloadˉlength = Bytesˉreadˉu32ˉlittle(Module, Cursor + 4u32);
        if Sectionˉkind == 2u32 { Capabilities = Payload; }
        if Sectionˉkind == 3u32 { Data = Payload; }
        if Sectionˉkind == 4u32 {
            Functions = Payload;
            Functionsˉend = Payload + Payloadˉlength;
        }
        if Sectionˉkind == 5u32 { Code = Payload; }
        if Sectionˉkind == 6u32 { Exports = Payload; }
        if Sectionˉkind == 7u32 { Types = Payload; }
        Cursor = Payload + Payloadˉlength;
        Sectionˉkind = Sectionˉkind + 1u32;
    }
    if Cursor != Moduleˉlength { return Invalid; }
    let Moduleˉprofile: u32 = U32ˉfromˉu8(
        Bytesˉreadˉu8(Module, 20u32)
    );
    var Capabilityˉkinds: bytes = Invalid;
    var Declaredˉcapabilities: u32 = 0u32;
    let Capabilityˉcount: u32 = Bytesˉreadˉu32ˉlittle(
        Module,
        Capabilities
    );
    if Requestˉmajor == 3u32 {
        if Moduleˉprofile == 1u32 {
            if Capabilityˉcount != 0u32 { return Invalid; }
        } else {
            if Moduleˉprofile != 2u32 { return Invalid; }
            if Capabilityˉcount != 1u32 { return Invalid; }
            var Capabilityˉcursor: u32 = Capabilities + 4u32;
            let Capabilityˉnameˉlength: u32 = Bytesˉreadˉu32ˉlittle(
                Module,
                Capabilityˉcursor
            );
            Capabilityˉcursor = Capabilityˉcursor + 4u32;
            var Browserˉconsoleˉcapability: bool =
                Capabilityˉnameˉlength == 18u32;
            if Browserˉconsoleˉcapability {
                if Bytesˉreadˉu32ˉlittle(Module, Capabilityˉcursor)
                    != 1936617315u32 {
                    Browserˉconsoleˉcapability = false;
                }
                if Bytesˉreadˉu32ˉlittle(Module, Capabilityˉcursor + 4u32)
                    != 778398831u32 {
                    Browserˉconsoleˉcapability = false;
                }
                if Bytesˉreadˉu32ˉlittle(Module, Capabilityˉcursor + 8u32)
                    != 1953067639u32 {
                    Browserˉconsoleˉcapability = false;
                }
                if Bytesˉreadˉu32ˉlittle(Module, Capabilityˉcursor + 12u32)
                    != 1768709989u32 {
                    Browserˉconsoleˉcapability = false;
                }
                if Bytesˉreadˉu16ˉlittle(Module, Capabilityˉcursor + 16u32)
                    != 25966u32 {
                    Browserˉconsoleˉcapability = false;
                }
            }
            if Browserˉconsoleˉcapability {
                Browserˉconsoleˉcapability = true;
            } else {
                return Invalid;
            }
            Capabilityˉcursor = Capabilityˉcursor
                + Capabilityˉnameˉlength;
            if Bytesˉreadˉu32ˉlittle(Module, Capabilityˉcursor) != 1u32 {
                return Invalid;
            }
            Capabilityˉcursor = Capabilityˉcursor + 4u32;
            if U32ˉfromˉu8(Bytesˉreadˉu8(Module, Capabilityˉcursor))
                != 3u32 {
                return Invalid;
            }
            Capabilityˉcursor = Capabilityˉcursor + 1u32;
            if U32ˉfromˉu8(Bytesˉreadˉu8(Module, Capabilityˉcursor))
                != 0u32 {
                return Invalid;
            }
            Capabilityˉkinds = Bytesˉfromˉu8(1u8);
            Declaredˉcapabilities = 1u32;
        }
    } else if Requestˉmajor == 4u32 {
        if Moduleˉprofile == 1u32 {
            if Capabilityˉcount != 0u32 { return Invalid; }
        } else {
            if Moduleˉprofile != 2u32 { return Invalid; }
            if Capabilityˉcount > 4u32 { return Invalid; }
            var Scriptˉcapabilityˉcursor: u32 = Capabilities + 4u32;
            var Scriptˉcapabilityˉindex: u32 = 0u32;
            while Scriptˉcapabilityˉindex < Capabilityˉcount {
                let Scriptˉcapabilityˉnameˉlength: u32 = Bytesˉreadˉu32ˉlittle(
                    Module,
                    Scriptˉcapabilityˉcursor
                );
                Scriptˉcapabilityˉcursor = Scriptˉcapabilityˉcursor + 4u32;
                var Capabilityˉkind: u32 = 0u32;
                if Capabilityˉnameˉequals(
                    Module, Scriptˉcapabilityˉcursor,
                    Scriptˉcapabilityˉnameˉlength, "console.write_line"
                ) { Capabilityˉkind = 1u32; }
                if Capabilityˉnameˉequals(
                    Module, Scriptˉcapabilityˉcursor,
                    Scriptˉcapabilityˉnameˉlength, "diagnostic.write_line"
                ) { Capabilityˉkind = 2u32; }
                if Capabilityˉnameˉequals(
                    Module, Scriptˉcapabilityˉcursor,
                    Scriptˉcapabilityˉnameˉlength, "process.argument"
                ) { Capabilityˉkind = 3u32; }
                if Capabilityˉnameˉequals(
                    Module, Scriptˉcapabilityˉcursor,
                    Scriptˉcapabilityˉnameˉlength, "process.argument_count"
                ) { Capabilityˉkind = 4u32; }
                if Capabilityˉkind == 0u32 { return Invalid; }
                let Capabilityˉbit: u32 = 1u32 << (Capabilityˉkind - 1u32);
                if (Declaredˉcapabilities & Capabilityˉbit) != 0u32 {
                    return Invalid;
                }
                Declaredˉcapabilities = Declaredˉcapabilities | Capabilityˉbit;
                Capabilityˉkinds = Bytesˉconcat(
                    Capabilityˉkinds,
                    Bytesˉslice(
                        Bytesˉfromˉu32ˉlittle(67305985u32),
                        Capabilityˉkind - 1u32,
                        1u32
                    )
                );
                Scriptˉcapabilityˉcursor = Scriptˉcapabilityˉcursor
                    + Scriptˉcapabilityˉnameˉlength;
                let Scriptˉparameterˉcount: u32 = Bytesˉreadˉu32ˉlittle(
                    Module,
                    Scriptˉcapabilityˉcursor
                );
                Scriptˉcapabilityˉcursor = Scriptˉcapabilityˉcursor + 4u32;
                if Capabilityˉkind <= 2u32 {
                    if Scriptˉparameterˉcount != 1u32 { return Invalid; }
                    if U32ˉfromˉu8(Bytesˉreadˉu8(Module, Scriptˉcapabilityˉcursor))
                        != 3u32 { return Invalid; }
                    Scriptˉcapabilityˉcursor = Scriptˉcapabilityˉcursor + 1u32;
                    if U32ˉfromˉu8(Bytesˉreadˉu8(Module, Scriptˉcapabilityˉcursor))
                        != 0u32 { return Invalid; }
                } else if Capabilityˉkind == 3u32 {
                    if Scriptˉparameterˉcount != 1u32 { return Invalid; }
                    if U32ˉfromˉu8(Bytesˉreadˉu8(Module, Scriptˉcapabilityˉcursor))
                        != 5u32 { return Invalid; }
                    Scriptˉcapabilityˉcursor = Scriptˉcapabilityˉcursor + 1u32;
                    if U32ˉfromˉu8(Bytesˉreadˉu8(Module, Scriptˉcapabilityˉcursor))
                        != 3u32 { return Invalid; }
                } else {
                    if Scriptˉparameterˉcount != 0u32 { return Invalid; }
                    if U32ˉfromˉu8(Bytesˉreadˉu8(Module, Scriptˉcapabilityˉcursor))
                        != 5u32 { return Invalid; }
                }
                Scriptˉcapabilityˉcursor = Scriptˉcapabilityˉcursor + 1u32;
                Scriptˉcapabilityˉindex = Scriptˉcapabilityˉindex + 1u32;
            }
        }
    } else if Requestˉmajor == 6u32 && Requestˉminor == 2u32 {
        if Moduleˉprofile != 2u32 || Capabilityˉcount != 1u32 {
            return Invalid;
        }
        var Taskˉcapabilityˉcursor: u32 = Capabilities + 4u32;
        let Taskˉcapabilityˉnameˉlength: u32 = Bytesˉreadˉu32ˉlittle(
            Module, Taskˉcapabilityˉcursor
        );
        Taskˉcapabilityˉcursor = Taskˉcapabilityˉcursor + 4u32;
        if !Capabilityˉnameˉequals(
                Module, Taskˉcapabilityˉcursor,
                Taskˉcapabilityˉnameˉlength, "console.write_line"
            ) {
            return Invalid;
        }
        Taskˉcapabilityˉcursor = Taskˉcapabilityˉcursor
            + Taskˉcapabilityˉnameˉlength;
        if Bytesˉreadˉu32ˉlittle(Module, Taskˉcapabilityˉcursor) != 1u32 {
            return Invalid;
        }
        Taskˉcapabilityˉcursor = Taskˉcapabilityˉcursor + 4u32;
        if U32ˉfromˉu8(Bytesˉreadˉu8(Module, Taskˉcapabilityˉcursor))
                != 3u32 ||
            U32ˉfromˉu8(Bytesˉreadˉu8(
                Module, Taskˉcapabilityˉcursor + 1u32
            )) != 0u32 {
            return Invalid;
        }
        Capabilityˉkinds = Bytesˉfromˉu8(1u8);
        Declaredˉcapabilities = 1u32;
    } else if Requestˉmajor == 5u32 || Requestˉmajor == 6u32 {
        if Moduleˉprofile != 2u32 || Capabilityˉcount != 0u32 {
            return Invalid;
        }
    } else {
        if Moduleˉprofile != 1u32 &&
            (Requestˉmajor != 1u32 ||
                (Moduleˉminor != 33u32 && Moduleˉminor != 34u32 &&
                    Moduleˉminor != 35u32 && Moduleˉminor != 36u32 &&
                    Moduleˉminor != 37u32) ||
                Moduleˉprofile != 3u32) {
            return Invalid;
        }
        if Capabilityˉcount != 0u32 { return Invalid; }
    }

    let Typeˉcount: u32 = Bytesˉreadˉu32ˉlittle(Module, Types);
    if Typeˉcount > 1024u32 { return Invalid; }
    let Functionˉcount: u32 = Bytesˉreadˉu32ˉlittle(Module, Functions);
    if Functionˉcount < 1u32 { return Invalid; }
    if Functionˉcount > 4096u32 { return Invalid; }

    var Typeˉoffsets: bytes = Invalid;
    var Typeˉindex: u32 = 0u32;
    var Typeˉcursor: u32 = Types + 4u32;
    while Typeˉindex < Typeˉcount {
        Typeˉoffsets = Bytesˉconcat(
            Typeˉoffsets,
            Bytesˉfromˉu32ˉlittle(Typeˉcursor)
        );
        let Typeˉkind: u32 = U32ˉfromˉu8(Bytesˉreadˉu8(Module, Typeˉcursor));
        if Typeˉkind < 1u32 || Typeˉkind > 8u32 { return Invalid; }
        Typeˉcursor = Typeˉcursor + 1u32;
        if Typeˉkind == 8u32 {
            if Moduleˉminor < 30u32 { return Invalid; }
            let Callableˉprofile: u32 = U32ˉfromˉu8(
                Bytesˉreadˉu8(Module, Typeˉcursor)
            );
            if Callableˉprofile < 1u32 || Callableˉprofile > 3u32 {
                return Invalid;
            }
            Typeˉcursor = Typeˉcursor + 1u32;
            Typeˉcursor = Callableˉshapeˉend(
                Module, Typeˉcursor, Typeˉcount
            );
            if Typeˉcursor == 0u32 { return Invalid; }
            let Callableˉparameters: u32 = Bytesˉreadˉu32ˉlittle(
                Module, Typeˉcursor
            );
            if Callableˉparameters > 64u32 { return Invalid; }
            Typeˉcursor = Typeˉcursor + 4u32;
            var Callableˉparameter: u32 = 0u32;
            while Callableˉparameter < Callableˉparameters {
                Typeˉcursor = Callableˉshapeˉend(
                    Module, Typeˉcursor, Typeˉcount
                );
                if Typeˉcursor == 0u32 { return Invalid; }
                Callableˉparameter = Callableˉparameter + 1u32;
            }
        } else {
        Typeˉcursor = Typeˉcursor + 4u32
            + Bytesˉreadˉu32ˉlittle(Module, Typeˉcursor);
        if Typeˉkind == 4u32 || Typeˉkind == 5u32 || Typeˉkind == 6u32 {
            if Typeˉkind == 4u32 &&
                Moduleˉminor < 17u32 {
                return Invalid;
            }
            if (Typeˉkind == 5u32 || Typeˉkind == 6u32) &&
                Moduleˉminor < 18u32 {
                return Invalid;
            }
            let Typeˉelementˉshape: u32 = U32ˉfromˉu8(
                Bytesˉreadˉu8(Module, Typeˉcursor)
            );
            if Typeˉelementˉshape < 1u32 || Typeˉelementˉshape == 21u32 ||
                Typeˉelementˉshape > 24u32 {
                return Invalid;
            }
            Typeˉcursor = Typeˉcursor + 1u32;
            if Typeˉelementˉshape == 7u32 || Typeˉelementˉshape == 8u32 ||
                Typeˉelementˉshape == 11u32 ||
                Typeˉelementˉshape == 22u32 ||
                Typeˉelementˉshape == 23u32 ||
                Typeˉelementˉshape == 24u32 {
                if Bytesˉreadˉu32ˉlittle(Module, Typeˉcursor) >= Typeˉcount {
                    return Invalid;
                }
                Typeˉcursor = Typeˉcursor + 4u32;
            }
            if Typeˉkind == 4u32 {
                if Bytesˉreadˉu32ˉlittle(Module, Typeˉcursor) > 4095u32 {
                    return Invalid;
                }
                Typeˉcursor = Typeˉcursor + 4u32;
            }
        } else {
        if Typeˉkind == 7u32 {
            if Moduleˉminor < 22u32 ||
                U32ˉfromˉu8(Bytesˉreadˉu8(Module, Typeˉcursor)) != 6u32 {
                return Invalid;
            }
            Typeˉcursor = Typeˉcursor + 1u32;
        }
        let Typeˉmemberˉcount: u32 = Bytesˉreadˉu32ˉlittle(
            Module,
            Typeˉcursor
        );
        Typeˉcursor = Typeˉcursor + 4u32;
        if Typeˉmemberˉcount < 1u32 { return Invalid; }
        if Typeˉkind == 1u32 {
            if Typeˉmemberˉcount > 64u32 { return Invalid; }
        } else {
            if Typeˉmemberˉcount > 256u32 { return Invalid; }
        }
        var Typeˉmemberˉindex: u32 = 0u32;
        while Typeˉmemberˉindex < Typeˉmemberˉcount {
            Typeˉcursor = Typeˉcursor + 4u32
                + Bytesˉreadˉu32ˉlittle(Module, Typeˉcursor);
            if Typeˉkind == 1u32 {
                let Fieldˉshapeˉkind: u32 = U32ˉfromˉu8(
                    Bytesˉreadˉu8(Module, Typeˉcursor)
                );
                if Fieldˉshapeˉkind < 1u32 { return Invalid; }
                if Fieldˉshapeˉkind > 10u32 {
                    var Extendedˉfieldˉshape: bool = Fieldˉshapeˉkind == 11u32;
                    if Moduleˉminor >= 12u32 &&
                        Fieldˉshapeˉkind >= 14u32 &&
                        Fieldˉshapeˉkind <= 16u32 {
                        Extendedˉfieldˉshape = true;
                    }
                    if Moduleˉminor >= 13u32 &&
                        Fieldˉshapeˉkind == 17u32 {
                        Extendedˉfieldˉshape = true;
                    }
                    if Moduleˉminor >= 14u32 &&
                        Fieldˉshapeˉkind >= 18u32 &&
                        Fieldˉshapeˉkind <= 19u32 {
                        Extendedˉfieldˉshape = true;
                    }
                    if Moduleˉminor >= 15u32 &&
                        Fieldˉshapeˉkind == 20u32 {
                        Extendedˉfieldˉshape = true;
                    }
                    if Moduleˉminor >= 17u32 &&
                        Fieldˉshapeˉkind == 22u32 {
                        Extendedˉfieldˉshape = true;
                    }
                    if Moduleˉminor >= 18u32 &&
                        (Fieldˉshapeˉkind == 23u32 ||
                            Fieldˉshapeˉkind == 24u32) {
                        Extendedˉfieldˉshape = true;
                    }
                    if Moduleˉminor >= 30u32 &&
                        Fieldˉshapeˉkind == 35u32 {
                        Extendedˉfieldˉshape = true;
                    }
                    if !Extendedˉfieldˉshape {
                        return Invalid;
                    }
                }
                Typeˉcursor = Typeˉcursor + 1u32;
                if Fieldˉshapeˉkind == 7u32 || Fieldˉshapeˉkind == 8u32 ||
                    Fieldˉshapeˉkind == 11u32 || Fieldˉshapeˉkind == 22u32 ||
                    Fieldˉshapeˉkind == 23u32 || Fieldˉshapeˉkind == 24u32 ||
                    Fieldˉshapeˉkind == 35u32 {
                    if Bytesˉreadˉu32ˉlittle(Module, Typeˉcursor) >= Typeˉcount {
                        return Invalid;
                    }
                    Typeˉcursor = Typeˉcursor + 4u32;
                }
            } else if Typeˉkind == 2u32 {
                Typeˉcursor = Typeˉcursor + 4u32;
            } else if Typeˉkind == 7u32 {
                Typeˉcursor = Typeˉcursor + 1u32;
            } else {
                let Variantˉfieldˉmarker: u32 = U32ˉfromˉu8(
                    Bytesˉreadˉu8(Module, Typeˉcursor)
                );
                Typeˉcursor = Typeˉcursor + 1u32;
                var Variantˉfieldˉcount: u32 = 0u32;
                if Variantˉfieldˉmarker == 1u32 {
                    Variantˉfieldˉcount = 1u32;
                } else if Variantˉfieldˉmarker == 2u32 {
                    if Moduleˉminor < 16u32 {
                        return Invalid;
                    }
                    Variantˉfieldˉcount = Bytesˉreadˉu32ˉlittle(
                        Module,
                        Typeˉcursor
                    );
                    Typeˉcursor = Typeˉcursor + 4u32;
                    if Variantˉfieldˉcount < 2u32 ||
                        Variantˉfieldˉcount > 64u32 {
                        return Invalid;
                    }
                } else if Variantˉfieldˉmarker != 0u32 {
                    return Invalid;
                }
                var Variantˉfieldˉindex: u32 = 0u32;
                while Variantˉfieldˉindex < Variantˉfieldˉcount {
                    Typeˉcursor = Typeˉcursor + 4u32
                        + Bytesˉreadˉu32ˉlittle(Module, Typeˉcursor);
                    let Variantˉfieldˉshape: u32 = U32ˉfromˉu8(
                        Bytesˉreadˉu8(Module, Typeˉcursor)
                    );
                    if Variantˉfieldˉshape < 1u32 { return Invalid; }
                    if Variantˉfieldˉshape > 10u32 {
                        var Extendedˉvariantˉshape: bool =
                            Variantˉfieldˉshape == 11u32;
                        if Moduleˉminor >= 12u32 &&
                            Variantˉfieldˉshape >= 14u32 &&
                            Variantˉfieldˉshape <= 16u32 {
                            Extendedˉvariantˉshape = true;
                        }
                        if Moduleˉminor >= 13u32 &&
                            Variantˉfieldˉshape == 17u32 {
                            Extendedˉvariantˉshape = true;
                        }
                        if Moduleˉminor >= 14u32 &&
                            Variantˉfieldˉshape >= 18u32 &&
                            Variantˉfieldˉshape <= 19u32 {
                            Extendedˉvariantˉshape = true;
                        }
                        if Moduleˉminor >= 15u32 &&
                            Variantˉfieldˉshape == 20u32 {
                            Extendedˉvariantˉshape = true;
                        }
                        if Moduleˉminor >= 17u32 &&
                            Variantˉfieldˉshape == 22u32 {
                            Extendedˉvariantˉshape = true;
                        }
                        if Moduleˉminor >= 18u32 &&
                            (Variantˉfieldˉshape == 23u32 ||
                                Variantˉfieldˉshape == 24u32) {
                            Extendedˉvariantˉshape = true;
                        }
                        if (Moduleˉminor == 23u32 || Moduleˉminor == 24u32 ||
                            Moduleˉminor == 25u32 ||
                            Moduleˉminor == 26u32 ||
                            Moduleˉminor == 27u32 ||
                            Moduleˉminor == 33u32 ||
                            Moduleˉminor == 34u32 ||
                            Moduleˉminor == 35u32 ||
                            Moduleˉminor == 36u32 ||
                            Moduleˉminor == 37u32) &&
                            Variantˉfieldˉshape == 25u32 {
                            Extendedˉvariantˉshape = true;
                        }
                        if Moduleˉminor >= 30u32 &&
                            Variantˉfieldˉshape == 35u32 {
                            Extendedˉvariantˉshape = true;
                        }
                        if !Extendedˉvariantˉshape { return Invalid; }
                    }
                    Typeˉcursor = Typeˉcursor + 1u32;
                    if Variantˉfieldˉshape == 7u32 ||
                        Variantˉfieldˉshape == 8u32 ||
                        Variantˉfieldˉshape == 11u32 ||
                        Variantˉfieldˉshape == 22u32 ||
                        Variantˉfieldˉshape == 23u32 ||
                        Variantˉfieldˉshape == 24u32 ||
                        Variantˉfieldˉshape == 35u32 {
                        if Bytesˉreadˉu32ˉlittle(Module, Typeˉcursor)
                            >= Typeˉcount {
                            return Invalid;
                        }
                        Typeˉcursor = Typeˉcursor + 4u32;
                    }
                    Variantˉfieldˉindex = Variantˉfieldˉindex + 1u32;
                }
            }
            Typeˉmemberˉindex = Typeˉmemberˉindex + 1u32;
        }
        }
        }
        Typeˉindex = Typeˉindex + 1u32;
    }

    var Mainˉfound: bool = false;
    var Mainˉindex: u32 = 0u32;
    let Exportˉcount: u32 = Bytesˉreadˉu32ˉlittle(Module, Exports);
    var Exportˉindex: u32 = 0u32;
    var Exportˉcursor: u32 = Exports + 4u32;
    while Exportˉindex < Exportˉcount {
        let Exportˉnameˉlength: u32 = Bytesˉreadˉu32ˉlittle(
            Module, Exportˉcursor
        );
        Exportˉcursor = Exportˉcursor + 4u32;
        var Isˉmain: bool = false;
        if Exportˉnameˉlength == 4u32 {
            Isˉmain = true;
            if U32ˉfromˉu8(Bytesˉreadˉu8(Module, Exportˉcursor)) != 77u32 {
                Isˉmain = false;
            }
            if U32ˉfromˉu8(
                Bytesˉreadˉu8(Module, Exportˉcursor + 1u32)
            ) != 97u32 {
                Isˉmain = false;
            }
            if U32ˉfromˉu8(
                Bytesˉreadˉu8(Module, Exportˉcursor + 2u32)
            ) != 105u32 {
                Isˉmain = false;
            }
            if U32ˉfromˉu8(
                Bytesˉreadˉu8(Module, Exportˉcursor + 3u32)
            ) != 110u32 {
                Isˉmain = false;
            }
        }
        Exportˉcursor = Exportˉcursor + Exportˉnameˉlength;
        if Isˉmain {
            if Mainˉfound { return Invalid; }
            if U32ˉfromˉu8(Bytesˉreadˉu8(Module, Exportˉcursor)) != 1u32 {
                return Invalid;
            }
            Mainˉfound = true;
            Mainˉindex = Bytesˉreadˉu32ˉlittle(Module, Exportˉcursor + 1u32);
        }
        Exportˉcursor = Exportˉcursor + 5u32;
        Exportˉindex = Exportˉindex + 1u32;
    }
    if Mainˉfound {
        Mainˉfound = true;
    } else {
        return Invalid;
    }

    var Result: bytes = Bytesˉfromˉu32ˉlittle(Requestˉmajor);
    Result = Bytesˉconcat(
        Result, Bytesˉfromˉu32ˉlittle(Maximumˉinstructions)
    );
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Maximumˉcallˉdepth));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Moduleˉoffset));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Moduleˉlength));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Guestˉinputˉoffset));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Guestˉinputˉlength));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Data));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Functions));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Functionsˉend));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Code));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Types));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Typeˉcount));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Functionˉcount));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Mainˉindex));
    Result = Bytesˉconcat(
        Result,
        Bytesˉfromˉu32ˉlittle(Bytesˉlength(Typeˉoffsets))
    );
    if Requestˉmajor == 3u32 {
        Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Capabilities));
        Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Capabilityˉgrants));
        Result = Bytesˉconcat(
            Result,
            Bytesˉfromˉu32ˉlittle(Standardˉoutputˉlimit)
        );
        Result = Bytesˉconcat(
            Result,
            Bytesˉfromˉu32ˉlittle(Declaredˉcapabilities)
        );
        Result = Bytesˉconcat(
            Result,
            Bytesˉfromˉu32ˉlittle(Bytesˉlength(Capabilityˉkinds))
        );
        Result = Bytesˉconcat(Result, Capabilityˉkinds);
    }
    if Requestˉmajor == 4u32 {
        Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Capabilities));
        Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Capabilityˉgrants));
        Result = Bytesˉconcat(
            Result,
            Bytesˉfromˉu32ˉlittle(Standardˉoutputˉlimit)
        );
        Result = Bytesˉconcat(
            Result,
            Bytesˉfromˉu32ˉlittle(Diagnosticˉoutputˉlimit)
        );
        Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Argumentˉcount));
        Result = Bytesˉconcat(
            Result,
            Bytesˉfromˉu32ˉlittle(Declaredˉcapabilities)
        );
        Result = Bytesˉconcat(
            Result,
            Bytesˉfromˉu32ˉlittle(Bytesˉlength(Capabilityˉkinds))
        );
        Result = Bytesˉconcat(Result, Capabilityˉkinds);
        Result = Bytesˉconcat(Result, Argumentˉoffsets);
    }
    if Requestˉmajor == 5u32 {
        Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Sourceˉrights));
        Result = Bytesˉconcat(
            Result, Bytesˉfromˉu32ˉlittle(Sourceˉproviderˉgeneration)
        );
        Result = Bytesˉconcat(
            Result, Bytesˉfromˉu32ˉlittle(Sourceˉresourceˉgeneration)
        );
    }
    if Requestˉmajor == 6u32 {
        Result = Bytesˉconcat(
            Result, Bytesˉfromˉu32ˉlittle(Taskˉcontextˉgeneration)
        );
        Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(0u32));
        Result = Bytesˉconcat(
            Result, Bytesˉfromˉu64ˉlittle(Taskˉclockˉgeneration)
        );
        Result = Bytesˉconcat(
            Result, Bytesˉfromˉu64ˉlittle(Taskˉdeadline)
        );
        Result = Bytesˉconcat(
            Result,
            Bytesˉfromˉu64ˉlittle(Taskˉexpectedˉruntimeˉgeneration)
        );
        Result = Bytesˉconcat(
            Result,
            Bytesˉfromˉu64ˉlittle(Taskˉadmittedˉruntimeˉgeneration)
        );
        Result = Bytesˉconcat(
            Result, Bytesˉfromˉu64ˉlittle(Taskˉobservationˉtick)
        );
        Result = Bytesˉconcat(
            Result,
            Bytesˉfromˉu64ˉlittle(Taskˉobservedˉruntimeˉgeneration)
        );
        Result = Bytesˉconcat(
            Result, Bytesˉfromˉu32ˉlittle(Requestˉminor)
        );
        if Requestˉminor == 2u32 {
            Result = Bytesˉconcat(
                Result, Bytesˉfromˉu32ˉlittle(Capabilities)
            );
            Result = Bytesˉconcat(
                Result, Bytesˉfromˉu32ˉlittle(Capabilityˉgrants)
            );
            Result = Bytesˉconcat(
                Result, Bytesˉfromˉu32ˉlittle(Standardˉoutputˉlimit)
            );
            Result = Bytesˉconcat(
                Result, Bytesˉfromˉu32ˉlittle(Declaredˉcapabilities)
            );
            Result = Bytesˉconcat(
                Result,
                Bytesˉfromˉu32ˉlittle(Bytesˉlength(Capabilityˉkinds))
            );
            Result = Bytesˉconcat(Result, Capabilityˉkinds);
        }
    }
    return Bytesˉconcat(Result, Typeˉoffsets);
}

export fn Interpreterˉrecordˉmetadata(Request: bytes) -> bytes {
    let Empty: bytes = Bytesˉslice(Request, 0u32, 0u32);
    let Zeroˉvalue: bytes = Bytesˉconcat(
        Empty,
        Bytesˉfromˉu32ˉlittle(0u32)
    );
    var Result: bytes = Bytesˉconcat(Zeroˉvalue, Zeroˉvalue);
    var Resultˉlength: u32 = 8u32;
    while Resultˉlength < 6144u32 {
        Result = Bytesˉconcat(Result, Result);
        Resultˉlength = Resultˉlength * 2u32;
    }
    return Bytesˉslice(Result, 0u32, 6144u32);
}
