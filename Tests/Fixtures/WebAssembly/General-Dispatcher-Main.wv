module Webassemblyˉgeneralˉdispatcher profile portable;

fn Signedˉanswer(Value: i32) -> i32 {
    return -(-((Value + 2) - 1) * 1);
}

fn Unsignedˉanswer(Value: u32) -> u32 {
    let Arithmetic: u32 = ((Value + 2u32) - 1u32) * 2u32;
    let Divided: u32 = Arithmetic / 2u32;
    let Remainder: u32 = Divided % 40u32;
    let Masked: u32 = ((Divided & 63u32) | 0u32) ^ 0u32;
    let Complemented: u32 = ~(~Masked);
    let Shifted: u32 = (Complemented << 1u32) >> 1u32;
    return (Shifted + Remainder) - 1u32;
}

export fn Main() -> i32 {
    var Again: bool = true;
    var Result: i32 = 40;

    while Again {
        Again = false;
        if Result == 40 {
            Result = 40;
        }
    }

    if Unsignedˉanswer(40u32) == 41u32 {
        return Signedˉanswer(Result) + 1;
    }
    return 0;
}
