module WebAssemblyˉruntimeˉcallsˉreclaim profile portable;

fn Aˉcopy(Input: bytes) -> bytes {
    return Bytesˉconcat(Input, Bytesˉslice(Input, 0u32, 0u32));
}

export fn Main(Input: bytes) -> bytes {
    var Value: bytes = Input;
    var Index: u32 = 0u32;
    while Index < 8192u32 {
        Value = Aˉcopy(Value);
        Index = Index + 1u32;
    }
    return Value;
}
