module X64ˉprocessˉclientˉimageˉemission profile portable;

import X64ˉcodeˉemission as X64;

data Loadˉripˉrelativeˉrsi: bytes = [72, 141, 53];
data Loadˉextentˉrdi: bytes = [73, 141, 190];
data Moveˉecx: bytes = [185];
data Clearˉdirectionˉcopyˉbytes: bytes = [252, 243, 164];
data Moveˉrax: bytes = [72, 184];
data Storeˉcontextˉheaderˉandˉbudget: bytes = [
    72, 137, 7, 72, 199, 71, 8
];
data Storeˉcontextˉdepth: bytes = [72, 199, 71, 16];
data Loadˉcontextˉtextˉrax: bytes = [72, 141, 135];
data Storeˉcontextˉtextˉrax: bytes = [72, 137, 71, 32];
data Storeˉcontextˉtextˉcapacity: bytes = [199, 71, 40];

fn Emptyˉbytes() -> bytes {
    return Bytesˉslice(Bytesˉfromˉu32ˉlittle(0u32), 0u32, 0u32);
}

fn Hasˉvalidˉgeometry(Interpreterˉbytes: u32) -> bool {
    return Interpreterˉbytes != 0u32 && Interpreterˉbytes <= 450560u32;
}

fn Buildˉclientˉimage(Interpreterˉbytes: u32) -> X64.X64ˉemission {
    var State: X64.X64ˉemission = X64.X64ˉemissionˉempty();
    State = X64.X64ˉemit(State, Loadˉripˉrelativeˉrsi);
    State = X64.X64ˉemitˉu32(State, 0u32);
    State = X64.X64ˉemit(State, Loadˉextentˉrdi);
    State = X64.X64ˉemitˉu32(State, 16384u32);
    State = X64.X64ˉemit(State, Moveˉecx);
    State = X64.X64ˉemitˉu32(State, Interpreterˉbytes);
    State = X64.X64ˉemit(State, Clearˉdirectionˉcopyˉbytes);
    State = X64.X64ˉemit(State, Loadˉextentˉrdi);
    State = X64.X64ˉemitˉu32(State, 491520u32);
    State = X64.X64ˉemit(State, Moveˉrax);
    State = X64.X64ˉemitˉu64(State, 481036337159u64);
    State = X64.X64ˉemit(State, Storeˉcontextˉheaderˉandˉbudget);
    State = X64.X64ˉemitˉu32(State, 189137u32);
    State = X64.X64ˉemit(State, Storeˉcontextˉdepth);
    State = X64.X64ˉemitˉu32(State, 5u32);
    State = X64.X64ˉemit(State, Loadˉcontextˉtextˉrax);
    State = X64.X64ˉemitˉu32(State, 512u32);
    State = X64.X64ˉemit(State, Storeˉcontextˉtextˉrax);
    State = X64.X64ˉemit(State, Storeˉcontextˉtextˉcapacity);
    return X64.X64ˉemitˉu32(State, 1024u32);
}

export fn X64ˉprocessˉclientˉimageˉisˉvalid(
    Interpreterˉbytes: u32
) -> bool {
    if !Hasˉvalidˉgeometry(Interpreterˉbytes) { return false; }
    let State: X64.X64ˉemission = Buildˉclientˉimage(Interpreterˉbytes);
    return State.Status == X64.X64ˉemissionˉstatus.Ready &&
        Bytesˉlength(State.Code) == 76u32;
}

export fn X64ˉprocessˉclientˉimageˉbytes(
    Interpreterˉbytes: u32
) -> bytes {
    if !Hasˉvalidˉgeometry(Interpreterˉbytes) { return Emptyˉbytes(); }
    let State: X64.X64ˉemission = Buildˉclientˉimage(Interpreterˉbytes);
    return State.Code;
}

export fn X64ˉprocessˉclientˉimageˉrelocationˉcount() -> u32 { return 1u32; }
export fn X64ˉprocessˉclientˉimageˉrelocationˉfield() -> u32 { return 3u32; }
export fn X64ˉprocessˉclientˉimageˉrelocationˉsymbol() -> u32 { return 1u32; }
export fn X64ˉprocessˉclientˉimageˉrelocationˉaddend() -> u32 {
    return 4294967292u32;
}

export fn X64ˉprocessˉclientˉimageˉfixtureˉoffset() -> u32 { return 9607u32; }
export fn X64ˉprocessˉclientˉimageˉfixtureˉend() -> u32 { return 9683u32; }
