module X64ˉprocessˉclientˉgenerationˉtwoˉreturnˉinitˉtransferˉemission profile portable;

import X64ˉprocessˉclientˉreturnˉinitˉtransferˉemission as Base;

data Internalˉdisplacements: bytes = [
    13, 26, 0, 0, 251, 25, 0, 0, 233, 25, 0, 0, 215, 25, 0, 0,
    193, 25, 0, 0, 179, 25, 0, 0, 165, 25, 0, 0, 151, 25, 0, 0,
    116, 149, 255, 255, 104, 25, 0, 0, 87, 25, 0, 0, 70, 25, 0, 0,
    45, 25, 0, 0, 65, 0, 0, 0
