export fn Generationˉtwoˉdirectoryˉrequestˉbytes()
    -> bytes {
    let Original: bytes =
        Base.X64ˉprocessˉclientˉdirectoryˉrequestˉdeliveryˉbytes();
    let Generation: bytes = Bytesˉslice(Bytesˉfromˉu32ˉlittle(2u32), 0u32, 1u32);
    return Bytesˉconcat(
        Bytesˉslice(Original, 0u32, 112u32),
        Bytesˉconcat(Generation, Bytesˉslice(Original, 113u32, 218u32))
