export fn X64ˉprocessˉclientˉgenerationˉtwoˉinitˉreplyˉpublishˉresumeˉbytes()
    -> bytes {
    let Original: bytes = Base.X64ˉprocessˉinitˉreplyˉpublishˉresumeˉbytes();
    let Operation: bytes = Bytesˉslice(Bytesˉfromˉu32ˉlittle(7u32), 0u32, 1u32);
    let Generation: bytes = Bytesˉslice(Bytesˉfromˉu32ˉlittle(2u32), 0u32, 1u32);
    var Result: bytes = Bytesˉconcat(
        Bytesˉslice(Original, 0u32, 44u32),
        Bytesˉconcat(Operation, Bytesˉslice(Original, 45u32, 67u32))
