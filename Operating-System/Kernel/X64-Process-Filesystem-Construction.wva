define Windvale_kernel_x64_process_filesystem_construct
# R12 is the validated WVKMEM17 state after generation-two client completion.
# The leaf releases reference 0x00020002, first-fit allocates generation three
# as 0x00030002, constructs its image/page tables/record, then atomically
