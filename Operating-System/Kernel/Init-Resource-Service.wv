module Initˉresourceˉservice profile portable;

// The first user-space resource owner selects one fixed immutable boot object.
// Its WVA seam grants a read-only borrow, waits for the interpreter result, and
// exits with that received value.
export fn Main() -> i32 {
    let Resourceˉid: u32 = 1u32;
    if Resourceˉid != 1u32 { return 0; }
    return 1;
}
