call Windvale_user_bytecode_interpreter_main

# The transport copies all 37 bytes without interpreting WVDQ. Its declared
# total length is deliberately 36, so the Windvale/WVA service rejects and
# traps. The kernel must translate that peer fault into the exact -1 sentinel.
load_address r8 Windvale_malformed_directory_read_request
move_u32 r9d 37
move r10 rbx
add_i32 r10 4096
move_u32 edi 4096
move_u32 ebx 6
move_u32 esi 65536
syscall
compare_i32 eax -1
branch not_equal service_failure
move_u32 eax 6
move_u32 ebx 3
syscall

label service_failure
trap
