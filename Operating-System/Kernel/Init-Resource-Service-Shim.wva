windvale-assembly 1
symbol export function Windvale_init_resource_user_entry in .text
symbol import function Windvale_init_resource_service_main

section code .text align 16
define Windvale_init_resource_user_entry
call Windvale_init_resource_service_main
# EAX carries Windvale's canonical ordered resource-set token unchanged.
move_u32 ebx 4
move_u32 esi 65536
syscall
move_u32 ebx 2
move_u32 esi 65536
syscall
# The coordinator reclaims and rebuilds the terminal client before resuming
# this service. Regrant the same ordered set to generation 2, wait for its
# independently interpreted result, and only then exit.
move_u32 eax 131073
move_u32 ebx 4
move_u32 esi 65536
syscall
move_u32 ebx 2
move_u32 esi 65536
syscall
move_u32 ebx 3
syscall
trap
end define
end section
