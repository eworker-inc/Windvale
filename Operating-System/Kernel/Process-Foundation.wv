module Processˉfoundation profile portable;

// Exact SHA-256 identities of the CPL3 interpreter, admitted WVB, execution
// budget, Windvale resource owner, Windvale directory owner, package-resource
// store, and directory snapshot. All seven match before pages are published.
data Interpreterˉdigest: bytes = [54, 105, 233, 77, 113, 43, 213, 167, 143, 0, 97, 226, 157, 128, 84, 237, 59, 84, 182, 135, 239, 201, 80, 129, 20, 247, 155, 183, 138, 168, 131, 47];
data Expectedˉinterpreterˉdigest: bytes = [54, 105, 233, 77, 113, 43, 213, 167, 143, 0, 97, 226, 157, 128, 84, 237, 59, 84, 182, 135, 239, 201, 80, 129, 20, 247, 155, 183, 138, 168, 131, 47];
data Programˉdigest: bytes = [156, 207, 237, 5, 9, 232, 75, 252, 99, 151, 156, 109, 193, 49, 112, 193, 71, 98, 239, 189, 170, 68, 139, 76, 88, 148, 50, 95, 49, 170, 119, 97];
data Expectedˉprogramˉdigest: bytes = [156, 207, 237, 5, 9, 232, 75, 252, 99, 151, 156, 109, 193, 49, 112, 193, 71, 98, 239, 189, 170, 68, 139, 76, 88, 148, 50, 95, 49, 170, 119, 97];
data Budgetˉdigest: bytes = [173, 215, 242, 164, 132, 63, 140, 81, 44, 14, 40, 117, 84, 101, 129, 219, 17, 185, 186, 34, 126, 224, 8, 181, 247, 25, 223, 172, 177, 37, 222, 118];
data Expectedˉbudgetˉdigest: bytes = [173, 215, 242, 164, 132, 63, 140, 81, 44, 14, 40, 117, 84, 101, 129, 219, 17, 185, 186, 34, 126, 224, 8, 181, 247, 25, 223, 172, 177, 37, 222, 118];
data Serviceˉdigest: bytes = [5, 84, 216, 3, 64, 68, 11, 248, 137, 95, 11, 240, 102, 211, 85, 218, 131, 51, 119, 145, 245, 64, 79, 43, 114, 202, 109, 162, 20, 102, 68, 103];
data Expectedˉserviceˉdigest: bytes = [5, 84, 216, 3, 64, 68, 11, 248, 137, 95, 11, 240, 102, 211, 85, 218, 131, 51, 119, 145, 245, 64, 79, 43, 114, 202, 109, 162, 20, 102, 68, 103];
data Directoryˉserviceˉdigest: bytes = [51, 176, 228, 37, 189, 110, 42, 28, 214, 174, 143, 149, 212, 100, 87, 72, 166, 3, 27, 147, 104, 74, 155, 26, 196, 208, 229, 110, 132, 8, 190, 247];
data Expectedˉdirectoryˉserviceˉdigest: bytes = [51, 176, 228, 37, 189, 110, 42, 28, 214, 174, 143, 149, 212, 100, 87, 72, 166, 3, 27, 147, 104, 74, 155, 26, 196, 208, 229, 110, 132, 8, 190, 247];
data Storeˉdigest: bytes = [224, 108, 184, 139, 201, 124, 138, 140, 132, 19, 196, 118, 196, 30, 200, 110, 175, 184, 209, 238, 63, 171, 13, 174, 232, 227, 181, 14, 120, 128, 35, 184];
data Expectedˉstoreˉdigest: bytes = [224, 108, 184, 139, 201, 124, 138, 140, 132, 19, 196, 118, 196, 30, 200, 110, 175, 184, 209, 238, 63, 171, 13, 174, 232, 227, 181, 14, 120, 128, 35, 184];
data Directoryˉsnapshotˉdigest: bytes = [15, 121, 58, 65, 167, 1, 36, 11, 156, 244, 17, 121, 218, 250, 37, 35, 132, 180, 60, 210, 50, 20, 100, 111, 240, 33, 210, 69, 101, 124, 35, 90];
data Expectedˉdirectoryˉsnapshotˉdigest: bytes = [15, 121, 58, 65, 167, 1, 36, 11, 156, 244, 17, 121, 218, 250, 37, 35, 132, 180, 60, 210, 50, 20, 100, 111, 240, 33, 210, 69, 101, 124, 35, 90];

fn Hasˉidentity(Input: bytes, Expected: bytes) -> bool {
    if Bytesˉlength(Input) != 32u32 { return false; }
    if Bytesˉlength(Expected) != 32u32 { return false; }
    var Offset: u32 = 0u32;
    while Offset < 32u32 {
        if Bytesˉreadˉu8(Input, Offset) != Bytesˉreadˉu8(Expected, Offset) { return false; }
        Offset = Offset + 1u32;
    }
    return true;
}

fn Hasˉserviceˉendpoint(
    Slot: u32,
    Generation: u32,
    Rights: u32,
    Expectedˉrights: u32,
    Participantˉreference: u32,
    Expectedˉparticipantˉreference: u32,
    Expectedˉslot: u32
) -> bool {
    if Slot != Expectedˉslot { return false; }
    if Generation != 1u32 { return false; }
    if Rights != Expectedˉrights { return false; }
    if Participantˉreference != Expectedˉparticipantˉreference { return false; }
    return true;
}

fn Hasˉendpointˉlifecycleˉcontract() -> bool {
    let Resourceˉendpointˉreference: u32 = 65536u32;
    let Directoryˉendpointˉreference: u32 = 65537u32;
    let Endpointˉkind: u32 = 1u32;
    let Endpointˉcapacity: u32 = 1u32;
    let Resourceˉproviderˉreference: u32 = 65537u32;
    let Directoryˉproviderˉreference: u32 = 65539u32;
    var Clientˉreference: u32 = 65538u32;
    var Endpointˉstate: u32 = 1u32;
    var Resourceˉresolutions: u32 = 0u32;
    var Directoryˉresolutions: u32 = 0u32;
    var Resourceˉcloseˉcount: u32 = 0u32;
    var Directoryˉcloseˉcount: u32 = 0u32;

    if Resourceˉendpointˉreference != 65536u32 { return false; }
    if Directoryˉendpointˉreference != 65537u32 { return false; }
    if Endpointˉkind != 1u32 { return false; }
    if Endpointˉcapacity != 1u32 { return false; }
    if Resourceˉproviderˉreference != 65537u32 { return false; }
    if Directoryˉproviderˉreference != 65539u32 { return false; }
    if Clientˉreference != 65538u32 { return false; }
    if Endpointˉstate != 1u32 { return false; }

    // One resource generation performs six endpoint resolutions; one
    // directory generation performs three. Rebinding changes only the client
    // process reference while both endpoint identities and providers persist.
    Resourceˉresolutions = 6u32;
    Directoryˉresolutions = 3u32;
    Clientˉreference = 131074u32;
    if Resourceˉresolutions != 6u32 { return false; }
    if Directoryˉresolutions != 3u32 { return false; }
    if Clientˉreference != 131074u32 { return false; }

    Resourceˉresolutions = 12u32;
    Directoryˉresolutions = 6u32;
    Endpointˉstate = 2u32;
    Resourceˉcloseˉcount = Resourceˉcloseˉcount + 1u32;
    Directoryˉcloseˉcount = Directoryˉcloseˉcount + 1u32;
    if Resourceˉresolutions != 12u32 { return false; }
    if Directoryˉresolutions != 6u32 { return false; }
    if Endpointˉstate != 2u32 { return false; }
    if Resourceˉcloseˉcount != 1u32 { return false; }
    if Directoryˉcloseˉcount != 1u32 { return false; }
    return true;
}

fn Isˉrunnable(Processˉstate: u32, Threadˉstate: u32) -> bool {
    if Processˉstate != 1u32 {
        if Processˉstate != 2u32 { return false; }
    }
    return Threadˉstate == 1u32;
}

fn Selectˉnextˉrunnable(
    Initˉprocess: u32,
    Initˉthread: u32,
    Clientˉprocess: u32,
    Clientˉthread: u32,
    Directoryˉprocess: u32,
    Directoryˉthread: u32,
    Cursor: u32
) -> u32 {
    if Cursor > 2u32 { return 0u32; }
    if Cursor == 0u32 {
        if Isˉrunnable(Initˉprocess, Initˉthread) { return 1u32; }
        if Isˉrunnable(Clientˉprocess, Clientˉthread) { return 2u32; }
        if Isˉrunnable(Directoryˉprocess, Directoryˉthread) { return 3u32; }
    }
    if Cursor == 1u32 {
        if Isˉrunnable(Clientˉprocess, Clientˉthread) { return 2u32; }
        if Isˉrunnable(Directoryˉprocess, Directoryˉthread) { return 3u32; }
        if Isˉrunnable(Initˉprocess, Initˉthread) { return 1u32; }
    }
    if Cursor == 2u32 {
        if Isˉrunnable(Directoryˉprocess, Directoryˉthread) { return 3u32; }
        if Isˉrunnable(Initˉprocess, Initˉthread) { return 1u32; }
        if Isˉrunnable(Clientˉprocess, Clientˉthread) { return 2u32; }
    }
    return 0u32;
}

fn Hasˉresourceˉgeneration(
    Generation: u32,
    Historicalˉgrants: u32,
    Expectedˉborrower: u32
) -> bool {
    let Clientˉprocessˉid: u32 = 2u32;
    let Borrower: u32 = Generation * 65536u32 + Clientˉprocessˉid;
    var State: u32 = 1u32;
    var Mappings: u32 = 0u32;
    if Generation < 1u32 { return false; }
    if Generation > 2u32 { return false; }
    if Borrower != Expectedˉborrower { return false; }
    if Historicalˉgrants + 1u32 != Generation { return false; }
    State = 2u32;
    Mappings = Mappings + 1u32;
    if State != 2u32 { return false; }
    if Mappings != 1u32 { return false; }
    State = 1u32;
    Mappings = Mappings - 1u32;
    if State != 1u32 { return false; }
    if Mappings != 0u32 { return false; }
    return true;
}

fn Hasˉexecutionˉgeneration(Generation: u32) -> bool {
    var Channelˉstate: u32 = 0u32;
    var Resourceˉrequestˉbytes: u32 = 0u32;
    var Resourceˉreplyˉbytes: u32 = 0u32;
    var Directoryˉrequestˉbytes: u32 = 0u32;
    var Directoryˉreplyˉbytes: u32 = 0u32;
    var Message: i32 = 0;

    if Generation < 1u32 { return false; }
    if Generation > 2u32 { return false; }
    if Channelˉstate != 0u32 { return false; }
    Resourceˉrequestˉbytes = 55u32;
    Channelˉstate = 2u32;
    if Resourceˉrequestˉbytes != 55u32 { return false; }
    if Channelˉstate != 2u32 { return false; }
    Resourceˉreplyˉbytes = 116u32;
    Channelˉstate = 0u32;
    if Resourceˉreplyˉbytes != 116u32 { return false; }
    if Channelˉstate != 0u32 { return false; }
    Directoryˉrequestˉbytes = 37u32;
    Channelˉstate = 2u32;
    if Directoryˉrequestˉbytes != 37u32 { return false; }
    if Channelˉstate != 2u32 { return false; }
    Directoryˉreplyˉbytes = 3096u32;
    Channelˉstate = 0u32;
    if Directoryˉreplyˉbytes != 3096u32 { return false; }
    if Channelˉstate != 0u32 { return false; }
    Message = 6;
    Channelˉstate = 1u32;
    if Channelˉstate != 1u32 { return false; }
    if Message != 6 { return false; }
    Channelˉstate = 0u32;
    if Channelˉstate != 0u32 { return false; }
    return true;
}

fn Hasˉserviceˉfailureˉcontract() -> bool {
    var Endpointˉstate: u32 = 1u32;
    var Endpointˉresolutions: u32 = 0u32;
    var Endpointˉcloseˉcount: u32 = 0u32;
    var Endpointˉproviderˉstatus: u32 = 0u32;
    var Channelˉstate: u32 = 0u32;
    var Channelˉwaiter: u32 = 1u32;
    var Retainedˉrequestˉbytes: u32 = 0u32;
    var Retainedˉserviceˉdestination: u32 = 1u32;
    var Retainedˉclientˉdestination: u32 = 0u32;
    var Serviceˉprocessˉstate: u32 = 2u32;
    var Serviceˉthreadˉstate: u32 = 5u32;
    var Serviceˉfaultˉvector: u32 = 0u32;
    var Peerˉstatus: u32 = 0u32;
    var Peerˉprocess: u32 = 0u32;
    var Closeˉcount: u32 = 0u32;
    var Wakeˉresult: i32 = 0;
    var Clientˉprocessˉstate: u32 = 2u32;
    var Clientˉsyscalls: u32 = 1u32;

    // The first resource call succeeds. The next exact 37-byte request has a
    // deliberately inconsistent WVDQ total length and remains opaque to the
    // channel. The service rejects it and traps while the client is waiting.
    if Channelˉstate != 0u32 { return false; }
    if Channelˉwaiter != 1u32 { return false; }
    Retainedˉrequestˉbytes = 37u32;
    Retainedˉclientˉdestination = 1u32;
    Channelˉstate = 2u32;
    Channelˉwaiter = 2u32;
    Clientˉsyscalls = Clientˉsyscalls + 1u32;
    Serviceˉprocessˉstate = 4u32;
    Serviceˉthreadˉstate = 4u32;
    Serviceˉfaultˉvector = 13u32;
    if Channelˉstate != 2u32 { return false; }
    if Channelˉwaiter != 2u32 { return false; }
    if Retainedˉrequestˉbytes != 37u32 { return false; }
    if Serviceˉprocessˉstate != 4u32 { return false; }
    if Serviceˉthreadˉstate != 4u32 { return false; }
    if Serviceˉfaultˉvector != 13u32 { return false; }

    // The directory provider receive and client call resolve through the
    // still-open directory endpoint before that provider traps.
    Endpointˉresolutions = 2u32;
    if Endpointˉstate != 1u32 { return false; }
    if Endpointˉresolutions != 2u32 { return false; }

    // Closing the failed service peer clears every transient field before the
    // waiting client is resumed with the transport-level peer-fault sentinel.
    Channelˉstate = 0u32;
    Channelˉwaiter = 0u32;
    Retainedˉrequestˉbytes = 0u32;
    Retainedˉserviceˉdestination = 0u32;
    Retainedˉclientˉdestination = 0u32;
    Peerˉstatus = 2u32;
    Peerˉprocess = 3u32;
    Closeˉcount = Closeˉcount + 1u32;
    Endpointˉstate = 2u32;
    Endpointˉcloseˉcount = Endpointˉcloseˉcount + 1u32;
    Endpointˉproviderˉstatus = 2u32;
    Wakeˉresult = -1;
    if Channelˉstate != 0u32 { return false; }
    if Channelˉwaiter != 0u32 { return false; }
    if Retainedˉrequestˉbytes != 0u32 { return false; }
    if Retainedˉserviceˉdestination != 0u32 { return false; }
    if Retainedˉclientˉdestination != 0u32 { return false; }
    if Peerˉstatus != 2u32 { return false; }
    if Peerˉprocess != 3u32 { return false; }
    if Closeˉcount != 1u32 { return false; }
    if Endpointˉstate != 2u32 { return false; }
    if Endpointˉcloseˉcount != 1u32 { return false; }
    if Endpointˉproviderˉstatus != 2u32 { return false; }
    if Wakeˉresult != -1 { return false; }

    Clientˉsyscalls = Clientˉsyscalls + 1u32;
    Clientˉprocessˉstate = 3u32;
    if Clientˉsyscalls != 3u32 { return false; }
    if Clientˉprocessˉstate != 3u32 { return false; }
    return true;
}

fn Hasˉreuseˉcontract() -> bool {
    var Clientˉgeneration: u32 = 1u32;
    var Clientˉextentˉstate: u32 = 1u32;
    var Clientˉreuseˉcount: u32 = 0u32;

    if Clientˉextentˉstate != 1u32 { return false; }
    Clientˉextentˉstate = 2u32;
    if Clientˉextentˉstate != 2u32 { return false; }
    Clientˉgeneration = 2u32;
    Clientˉextentˉstate = 1u32;
    Clientˉreuseˉcount = Clientˉreuseˉcount + 1u32;
    if Clientˉgeneration != 2u32 { return false; }
    if Clientˉextentˉstate != 1u32 { return false; }
    if Clientˉreuseˉcount != 1u32 { return false; }
    return true;
}

export fn Main() -> i32 {
    if !Hasˉidentity(Interpreterˉdigest, Expectedˉinterpreterˉdigest) { return 0; }
    if !Hasˉidentity(Programˉdigest, Expectedˉprogramˉdigest) { return 0; }
    if !Hasˉidentity(Budgetˉdigest, Expectedˉbudgetˉdigest) { return 0; }
    if !Hasˉidentity(Serviceˉdigest, Expectedˉserviceˉdigest) { return 0; }
    if !Hasˉidentity(
        Directoryˉserviceˉdigest,
        Expectedˉdirectoryˉserviceˉdigest
    ) { return 0; }
    if !Hasˉidentity(Storeˉdigest, Expectedˉstoreˉdigest) { return 0; }
    if !Hasˉidentity(
        Directoryˉsnapshotˉdigest,
        Expectedˉdirectoryˉsnapshotˉdigest
    ) { return 0; }

    // Three address spaces and threads use two kernel-owned, format-blind,
    // capacity-one service endpoints. Init owns the resource channel and one
    // exact atomic two-resource grant; directory owns the snapshot channel.
    let Initˉprocessˉid: u32 = 1u32;
    let Clientˉprocessˉid: u32 = 2u32;
    let Directoryˉprocessˉid: u32 = 3u32;
    let Initˉmemoryˉpages: u32 = 8u32;
    let Directoryˉmemoryˉpages: u32 = 6u32;
    let Interpreterˉmemoryˉpages: u32 = 120u32;
    let Initˉinstructionˉbudget: u32 = 64u32;
    let Interpreterˉinstructionˉbudget: u32 = 189114u32;
    let Interpreterˉcallˉdepth: u32 = 5u32;
    let Initˉprofile: u32 = 2u32;
    let Interpreterˉprofile: u32 = 7u32;
    let Providerˉhandleˉbudget: u32 = 1u32;
    let Clientˉhandleˉbudget: u32 = 2u32;
    let Initˉsyscallˉbudget: u32 = 9u32;
    let Directoryˉsyscallˉbudget: u32 = 5u32;
    let Interpreterˉsyscallˉbudget: u32 = 4u32;
    if Initˉprocessˉid != 1u32 { return 0; }
    if Clientˉprocessˉid != 2u32 { return 0; }
    if Directoryˉprocessˉid != 3u32 { return 0; }
    if Initˉmemoryˉpages != 8u32 { return 0; }
    if Directoryˉmemoryˉpages != 6u32 { return 0; }
    if Interpreterˉmemoryˉpages != 120u32 { return 0; }
    if Initˉinstructionˉbudget != 64u32 { return 0; }
    if Interpreterˉinstructionˉbudget != 189114u32 { return 0; }
    if Interpreterˉcallˉdepth != 5u32 { return 0; }
    if Initˉprofile != 2u32 { return 0; }
    if Interpreterˉprofile != 7u32 { return 0; }
    if Providerˉhandleˉbudget != 1u32 { return 0; }
    if Clientˉhandleˉbudget != 2u32 { return 0; }
    if Initˉsyscallˉbudget != 9u32 { return 0; }
    if Directoryˉsyscallˉbudget != 5u32 { return 0; }
    if Interpreterˉsyscallˉbudget != 4u32 { return 0; }
    if !Hasˉserviceˉendpoint(0u32, 1u32, 46u32, 46u32, 65537u32, 65537u32, 0u32) { return 0; }
    if !Hasˉserviceˉendpoint(1u32, 1u32, 46u32, 46u32, 65539u32, 65539u32, 1u32) { return 0; }
    if !Hasˉserviceˉendpoint(0u32, 1u32, 17u32, 17u32, 65538u32, 65538u32, 0u32) { return 0; }
    if !Hasˉserviceˉendpoint(1u32, 1u32, 17u32, 17u32, 65538u32, 65538u32, 1u32) { return 0; }
    if !Hasˉendpointˉlifecycleˉcontract() { return 0; }
    if Selectˉnextˉrunnable(1u32, 1u32, 1u32, 1u32, 1u32, 1u32, 2u32) != 3u32 { return 0; }
    if Selectˉnextˉrunnable(2u32, 5u32, 1u32, 1u32, 2u32, 5u32, 0u32) != 2u32 { return 0; }
    if Selectˉnextˉrunnable(2u32, 5u32, 2u32, 5u32, 2u32, 1u32, 0u32) != 3u32 { return 0; }
    if Selectˉnextˉrunnable(3u32, 3u32, 4u32, 4u32, 2u32, 5u32, 0u32) != 0u32 { return 0; }

    let Resourceˉsetˉtoken: u32 = 131073u32;
    let Moduleˉresourceˉid: u32 = 1u32;
    let Moduleˉresourceˉkind: u32 = 1u32;
    let Budgetˉresourceˉid: u32 = 2u32;
    let Budgetˉresourceˉkind: u32 = 2u32;
    let Executionˉbudget: u32 = 199u32;

    if Resourceˉsetˉtoken != 131073u32 { return 0; }
    if Moduleˉresourceˉid != 1u32 { return 0; }
    if Moduleˉresourceˉkind != 1u32 { return 0; }
    if Budgetˉresourceˉid != 2u32 { return 0; }
    if Budgetˉresourceˉkind != 2u32 { return 0; }
    if Executionˉbudget != 199u32 { return 0; }
    // The machine proof enforces the same transition against live records:
    // generation 1 grants, runs, revokes, releases its exact tail extent, and
    // generation 2 reuses that physical root without inheriting its identity.
    if !Hasˉresourceˉgeneration(1u32, 0u32, 65538u32) { return 0; }
    if !Hasˉexecutionˉgeneration(1u32) { return 0; }
    if !Hasˉreuseˉcontract() { return 0; }
    if !Hasˉresourceˉgeneration(2u32, 1u32, 131074u32) { return 0; }
    if !Hasˉexecutionˉgeneration(2u32) { return 0; }
    // The same measured image also admits a bounded failure scenario: a
    // malformed directory request faults the directory provider, closes only
    // its endpoint, wakes its one waiting client with -1, and contains init.
    if !Hasˉserviceˉfailureˉcontract() { return 0; }
    // Init performs two grants, two request receives, two replies, two result
    // receives, and one exit. Directory performs two request receives, two
    // replies, and one exit. Each normal client performs two calls, one result
    // send, and one exit.
    if 2u32 + 2u32 + 2u32 + 2u32 + 1u32 != Initˉsyscallˉbudget { return 0; }
    if 2u32 + 2u32 + 1u32 != Directoryˉsyscallˉbudget { return 0; }
    if 2u32 + 1u32 + 1u32 != Interpreterˉsyscallˉbudget { return 0; }
    return 97;
}
