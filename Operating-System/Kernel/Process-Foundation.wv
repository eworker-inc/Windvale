module Processˉfoundation profile portable;

// SHA-256 of the exact WVB admitted by Wvb-Admission.wv. The first process
// contract binds its authority and budgets to this immutable program identity.
data Moduleˉdigest: bytes = [127, 8, 239, 187, 32, 198, 204, 105, 193, 0, 240, 116, 7, 247, 89, 98, 91, 56, 192, 42, 63, 5, 187, 78, 141, 171, 204, 123, 221, 16, 196, 226];
data Expectedˉdigest: bytes = [127, 8, 239, 187, 32, 198, 204, 105, 193, 0, 240, 116, 7, 247, 89, 98, 91, 56, 192, 42, 63, 5, 187, 78, 141, 171, 204, 123, 221, 16, 196, 226];

fn Hasˉidentity(Input: bytes, Expected: bytes) -> bool {
    if Bytesˉlength(Input) != 32u32 { return false; }
    if Bytesˉlength(Expected) != 32u32 { return false; }
    var Offset: u32 = 0u32;
    while Offset < 32u32 {
        if Bytesˉreadˉu8(Input, Offset) != Bytesˉreadˉu8(Expected, Offset) { return false; }
        Offset = Offset + 1u32;
    }
    return true;
}

fn Hasˉchannelˉcapability(Slot: u32, Generation: u32, Rights: u32) -> bool {
    if Slot != 0u32 { return false; }
    if Generation != 1u32 { return false; }
    if Rights != 3u32 { return false; }
    return true;
}

export fn Main() -> i32 {
    if !Hasˉidentity(Moduleˉdigest, Expectedˉdigest) { return 0; }

    // One address space, thread, capability, and capacity-one channel. These
    // values are mirrored by the independently verified Stage 0 machine seam.
    let Processˉid: u32 = 1u32;
    let Threadˉid: u32 = 1u32;
    let Memoryˉpages: u32 = 3u32;
    let Instructionˉbudget: u32 = 4u32;
    let Handleˉbudget: u32 = 1u32;
    let Syscallˉbudget: u32 = 3u32;
    if Processˉid != 1u32 { return 0; }
    if Threadˉid != 1u32 { return 0; }
    if Memoryˉpages != 3u32 { return 0; }
    if Instructionˉbudget != 4u32 { return 0; }
    if Handleˉbudget != 1u32 { return 0; }
    if Syscallˉbudget != 3u32 { return 0; }
    if !Hasˉchannelˉcapability(0u32, 1u32, 3u32) { return 0; }

    var Processˉstate: u32 = 1u32;
    var Threadˉstate: u32 = 1u32;
    var Channelˉstate: u32 = 0u32;
    var Message: i32 = 0;
    var Syscalls: u32 = 0u32;

    Processˉstate = 2u32;
    Threadˉstate = 2u32;
    // send(29), receive() -> 29, exit(29)
    if Channelˉstate != 0u32 { return 0; }
    Message = 29;
    Channelˉstate = 1u32;
    Syscalls = Syscalls + 1u32;
    if Channelˉstate != 1u32 { return 0; }
    if Message != 29 { return 0; }
    Channelˉstate = 0u32;
    Syscalls = Syscalls + 1u32;
    if Channelˉstate != 0u32 { return 0; }
    Syscalls = Syscalls + 1u32;
    if Syscalls != Syscallˉbudget { return 0; }
    Threadˉstate = 3u32;
    Processˉstate = 3u32;
    if Threadˉstate != 3u32 { return 0; }
    if Processˉstate != 3u32 { return 0; }
    return 91;
}
