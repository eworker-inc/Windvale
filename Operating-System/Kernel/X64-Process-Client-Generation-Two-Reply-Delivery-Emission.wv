export fn X64ˉprocessˉclientˉgenerationˉtwoˉreplyˉdeliveryˉbytes()
    -> bytes {
    let Original: bytes = Base.X64ˉprocessˉclientˉreplyˉdeliveryˉbytes();
    let Operation: bytes = Bytesˉslice(Bytesˉfromˉu32ˉlittle(8u32), 0u32, 1u32);
    let Generation: bytes = Bytesˉslice(Bytesˉfromˉu32ˉlittle(2u32), 0u32, 1u32);
    var Result: bytes = Bytesˉconcat(
        Bytesˉslice(Original, 0u32, 44u32),
        Bytesˉconcat(Operation, Bytesˉslice(Original, 45u32, 67u32))
    );
    Result = Bytesˉconcat(
        Result,
        Bytesˉconcat(Generation, Bytesˉslice(Original, 113u32, 13u32))
    );
    Result = Bytesˉconcat(
        Result,
        Bytesˉconcat(Generation, Bytesˉslice(Original, 127u32, 80u32))
    );
    return Bytesˉconcat(
        Result,
        Bytesˉconcat(Generation, Bytesˉslice(Original, 208u32, 123u32))
    );
}

