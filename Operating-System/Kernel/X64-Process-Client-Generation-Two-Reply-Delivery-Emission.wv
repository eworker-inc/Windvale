module X64ˉprocessˉclientˉgenerationˉtwoˉreplyˉdeliveryˉemission profile portable;

import X64ˉprocessˉclientˉreplyˉdeliveryˉemission as Base;

data Internalˉdisplacements: bytes = [
    114, 23, 0, 0, 96, 23, 0, 0, 78, 23, 0, 0, 60, 23, 0, 0,
    38, 23, 0, 0, 24, 23, 0, 0, 10, 23, 0, 0, 252, 22, 0, 0,
