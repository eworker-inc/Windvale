    // envelopes of the cross-compiler function-only fixture.
    if !Hasˉsection(Input, 12u32, 1u32, 26u32) { return 0; }
    if !Hasˉsection(Input, 46u32, 2u32, 4u32) { return 0; }
    if !Hasˉsection(Input, 58u32, 3u32, 4u32) { return 0; }
    if !Hasˉsection(Input, 70u32, 4u32, 161u32) { return 0; }
    if !Hasˉsection(Input, 239u32, 5u32, 532u32) { return 0; }
    if !Hasˉsection(Input, 779u32, 6u32, 17u32) { return 0; }
    if !Hasˉsection(Input, 804u32, 7u32, 4u32) { return 0; }

    if !Hasˉcanonicalˉidentity(Input, Expected) { return 0; }
    return 73;
}
