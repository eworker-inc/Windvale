fn Hasˉsection(Input: bytes, Offset: u32, Kind: u32, Payloadˉbytes: u32) -> bool {
    if Bytesˉreadˉu32ˉlittle(Input, Offset) != Kind { return false; }
    if Bytesˉreadˉu32ˉlittle(Input, Offset + 4u32) != Payloadˉbytes { return false; }
    return true;
}

fn Hasˉcanonicalˉidentity(Input: bytes, Expected: bytes) -> bool {
    var Offset: u32 = 0u32;
    while Offset < Bytesˉlength(Expected) {
        if Bytesˉreadˉu8(Input, Offset) != Bytesˉreadˉu8(Expected, Offset) { return false; }
        Offset = Offset + 1u32;
    }
    return true;
}

export fn Main() -> i32 {
    let Input: bytes = Embeddedˉmodule;
    let Expected: bytes = Expectedˉmodule;

    if Bytesˉlength(Input) != 493u32 { return 0; }
    if Bytesˉlength(Expected) != 493u32 { return 0; }
    if Bytesˉreadˉu32ˉlittle(Input, 0u32) != 826431063u32 { return 0; }
    if Bytesˉreadˉu16ˉlittle(Input, 4u32) != 1u32 { return 0; }
    if Bytesˉreadˉu16ˉlittle(Input, 6u32) != 6u32 { return 0; }
    if Bytesˉreadˉu32ˉlittle(Input, 8u32) != 7u32 { return 0; }

    // Admission profile 3 accepts exactly the seven canonical section
    // envelopes of the shared Sum-Data module.
    if !Hasˉsection(Input, 12u32, 1u32, 14u32) { return 0; }
    if !Hasˉsection(Input, 34u32, 2u32, 4u32) { return 0; }
    if !Hasˉsection(Input, 46u32, 3u32, 35u32) { return 0; }
    if !Hasˉsection(Input, 89u32, 4u32, 81u32) { return 0; }
    if !Hasˉsection(Input, 178u32, 5u32, 270u32) { return 0; }
    if !Hasˉsection(Input, 456u32, 6u32, 17u32) { return 0; }
    if !Hasˉsection(Input, 481u32, 7u32, 4u32) { return 0; }

    if !Hasˉcanonicalˉidentity(Input, Expected) { return 0; }
    return 73;
}
