module Helloˉwindvale profile system;

capability console.write_line;

data Greeting: text = "Hello from Windvale";
data Memoryˉmarker: text = "memory-owned=pass";
data Allocatorˉmarker: text = "allocator=pass";
data Stackˉmarker: text = "kernel-stack=pass";
data Pagingˉmarker: text = "paging=owned";
data Admissionˉmarker: text = "wvb-admission=pass";
data Processˉmarker: text = "processes=isolated";
data Endpointˉmarker: text = "service-endpoint=bound";
data Resourceˉgrantˉmarker: text = "resource-grant=pass";
data Typedˉresourcesˉmarker: text = "typed-resources=pass";
data Resourceˉrevokedˉmarker: text = "resource-revoked=pass";
data Processˉreuseˉmarker: text = "process-reuse=pass";
data Runtimeˉmarker: text = "wvb-runtime=interpreted";
data Initˉserviceˉmarker: text = "init-service=pass";
data Directoryˉserviceˉmarker: text = "directory-service=pass";
data Ipcˉmarker: text = "ipc=resource-and-directory";

export fn Main() -> i32 {
    console.write_line(Memoryˉmarker);
    console.write_line(Allocatorˉmarker);
    console.write_line(Stackˉmarker);
    console.write_line(Pagingˉmarker);
    console.write_line(Admissionˉmarker);
    console.write_line(Processˉmarker);
    console.write_line(Endpointˉmarker);
    console.write_line(Resourceˉgrantˉmarker);
    console.write_line(Typedˉresourcesˉmarker);
    console.write_line(Resourceˉrevokedˉmarker);
    console.write_line(Processˉreuseˉmarker);
    console.write_line(Runtimeˉmarker);
    console.write_line(Initˉserviceˉmarker);
    console.write_line(Directoryˉserviceˉmarker);
    console.write_line(Ipcˉmarker);
    console.write_line(Greeting);
    return 0;
}
