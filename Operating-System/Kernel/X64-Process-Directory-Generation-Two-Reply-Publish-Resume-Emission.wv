export fn Generationˉtwoˉdirectoryˉreplyˉbytes() -> bytes {
    let Original: bytes = Base.X64ˉprocessˉdirectoryˉreplyˉpublishˉresumeˉbytes();
    let Operation: bytes = Bytesˉslice(Bytesˉfromˉu32ˉlittle(4u32), 0u32, 1u32);
    let Generation: bytes = Bytesˉslice(Bytesˉfromˉu32ˉlittle(2u32), 0u32, 1u32);
