module X64ˉprocessˉfilesystemˉimageˉemission profile portable;

import X64ˉcodeˉemission as X64;

data Empty: bytes = [];
data Loadˉripˉrelativeˉrsi: bytes = [72, 141, 53];
data Loadˉextentˉrdi: bytes = [73, 141, 190];
data Moveˉecx: bytes = [185];
data Clearˉdirectionˉcopyˉbytes: bytes = [252, 243, 164];
data Moveˉrax: bytes = [72, 184];
data Storeˉcontextˉheaderˉandˉbudget: bytes = [
    72, 137, 7, 72, 199, 71, 8
];
data Storeˉcontextˉdepth: bytes = [72, 199, 71, 16];

fn Buildˉimage(Imageˉbytes: u32) -> X64.X64ˉemission {
    var State: X64.X64ˉemission = X64.X64ˉemissionˉempty();
    State = X64.X64ˉemit(State, Loadˉripˉrelativeˉrsi);
    State = X64.X64ˉemitˉu32(State, 0u32);
    State = X64.X64ˉemit(State, Loadˉextentˉrdi);
    State = X64.X64ˉemitˉu32(State, 16384u32);
    State = X64.X64ˉemit(State, Moveˉecx);
    State = X64.X64ˉemitˉu32(State, Imageˉbytes);
    State = X64.X64ˉemit(State, Clearˉdirectionˉcopyˉbytes);
    State = X64.X64ˉemit(State, Loadˉextentˉrdi);
    State = X64.X64ˉemitˉu32(State, 212992u32);
    State = X64.X64ˉemit(State, Moveˉrax);
    State = X64.X64ˉemitˉu64(State, 481036337159u64);
    State = X64.X64ˉemit(State, Storeˉcontextˉheaderˉandˉbudget);
    State = X64.X64ˉemitˉu32(State, 262144u32);
    State = X64.X64ˉemit(State, Storeˉcontextˉdepth);
    return X64.X64ˉemitˉu32(State, 16u32);
}

export fn X64ˉprocessˉfilesystemˉimageˉisˉvalid(Imageˉbytes: u32) -> bool {
    if Imageˉbytes == 0u32 || Imageˉbytes > 196608u32 { return false; }
    let State: X64.X64ˉemission = Buildˉimage(Imageˉbytes);
    return State.Status == X64.X64ˉemissionˉstatus.Ready &&
        Bytesˉlength(State.Code) == 58u32;
}

export fn X64ˉprocessˉfilesystemˉimageˉbytes(Imageˉbytes: u32) -> bytes {
    if Imageˉbytes == 0u32 || Imageˉbytes > 196608u32 { return Empty; }
    let State: X64.X64ˉemission = Buildˉimage(Imageˉbytes);
    return State.Code;
}

export fn X64ˉprocessˉfilesystemˉimageˉrelocationˉfield() -> u32 {
    return 3u32;
}

export fn X64ˉprocessˉfilesystemˉimageˉrelocationˉsymbol() -> u32 {
    return 7u32;
}

export fn X64ˉprocessˉfilesystemˉimageˉrelocationˉaddend() -> u32 {
    return 4294967292u32;
}
