module Nativeˉwvbˉprobe profile portable;

data Values: [i32] = [3, 5, 8, 13];
data Header: bytes = [0, 5, 0, 0, 0, 255];

fn Add(Left: i32, Right: i32) -> i32 {
    return Left + Right;
}

fn Readˉheader(Input: bytes) -> u32 {
    let Payload: bytes = Bytesˉslice(Input, 1u32, 4u32);
    return Bytesˉreadˉu32ˉlittle(Payload, 0u32);
}

export fn Main() -> i32 {
    var Index: i32 = 0;
    var Total: i32 = 0;

    while Index < length(Values) {
        Total = Add(Total, Values[Index]);
        Index = Index + 1;
    }

    if Bytesˉlength(Header) == 6u32 {
        if Bytesˉreadˉu8(Header, 5u32) == 255u8 {
            if Readˉheader(Header) == 5u32 {
                return Total;
            }
        }
    }
    return 0;
}
