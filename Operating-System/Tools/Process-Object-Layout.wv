module Processˉobjectˉlayout profile portable;

fn Append(Left: bytes, Right: bytes) -> bytes {
    return Bytesˉconcat(Left, Right);
}

fn Encodeˉstring(Value: text) -> bytes {
    let Encoded: bytes = Textˉtoˉutf8(Value);
    return Append(Bytesˉfromˉu32ˉlittle(Bytesˉlength(Encoded)), Encoded);
}

fn Encodeˉsection(
    Name: text,
    Kind: u8,
    Alignment: u32,
    Memoryˉsize: u32,
    Contents: bytes
) -> bytes {
    var Result: bytes = Bytesˉfromˉu8(Kind);
    Result = Append(Result, Bytesˉfromˉu8(0u8));
    Result = Append(Result, Bytesˉfromˉu16ˉlittle(0u32));
    Result = Append(Result, Bytesˉfromˉu32ˉlittle(Alignment));
    Result = Append(Result, Bytesˉfromˉu32ˉlittle(Memoryˉsize));
    Result = Append(Result, Bytesˉfromˉu32ˉlittle(Bytesˉlength(Contents)));
    Result = Append(Result, Encodeˉstring(Name));
    return Append(Result, Contents);
}

fn Encodeˉsymbol(
    Name: text,
    Binding: u8,
    Kind: u8,
    Section: u32,
    Offset: u32,
    Size: u32
) -> bytes {
    var Result: bytes = Bytesˉfromˉu8(Binding);
    Result = Append(Result, Bytesˉfromˉu8(Kind));
    Result = Append(Result, Bytesˉfromˉu16ˉlittle(0u32));
    Result = Append(Result, Bytesˉfromˉu32ˉlittle(Section));
    Result = Append(Result, Bytesˉfromˉu32ˉlittle(Offset));
    Result = Append(Result, Bytesˉfromˉu32ˉlittle(Size));
    return Append(Result, Encodeˉstring(Name));
}

fn Dataˉsymbol(Name: text, Section: u32, Size: u32) -> bytes {
    return Encodeˉsymbol(Name, 1u8, 2u8, Section, 0u32, Size);
}

fn Importˉfunction(Name: text) -> bytes {
    return Encodeˉsymbol(
        Name, 3u8, 1u8, 4294967295u32, 0u32, 0u32
    );
}

export fn Buildˉfirstˉsections(
    Code: bytes,
    Handlerˉbytes: bytes,
    Filesystemˉimageˉconstructor: bytes,
    Filesystemˉpagingˉconstructor: bytes,
    Filesystemˉrecordˉconstructor: bytes,
    Init: bytes,
    Client: bytes,
    Program: bytes
) -> bytes {
    var Result: bytes = Encodeˉsection(
        ".text.process", 1u8, 16u32, 46678u32, Code
    );
    Result = Append(Result, Encodeˉsection(
        ".text.process.application_start",
        1u8, 16u32, 262u32, Handlerˉbytes
    ));
    Result = Append(Result, Encodeˉsection(
        ".text.process.filesystem.image",
        1u8, 16u32, 59u32, Filesystemˉimageˉconstructor
    ));
    Result = Append(Result, Encodeˉsection(
        ".text.process.filesystem.paging",
        1u8, 16u32, 3343u32, Filesystemˉpagingˉconstructor
    ));
    Result = Append(Result, Encodeˉsection(
        ".text.process.filesystem.record",
        1u8, 16u32, 463u32, Filesystemˉrecordˉconstructor
    ));
    Result = Append(Result, Encodeˉsection(
        ".rodata.ainit", 2u8, 16u32, 5159u32, Init
    ));
    Result = Append(Result, Encodeˉsection(
        ".rodata.bclient", 2u8, 16u32, 449261u32, Client
    ));
    Result = Append(Result, Encodeˉsection(
        ".rodata.cresource", 2u8, 16u32, 816u32, Program
    ));
    return Result;
}

export fn Buildˉfinalˉsections(
    Store: bytes,
    Snapshot: bytes,
    Directory: bytes,
    Filesystem: bytes,
    Network: bytes
) -> bytes {
    var Result: bytes = Encodeˉsection(
        ".rodata.dbudget", 2u8, 4u32, 4u32,
        Bytesˉfromˉu32ˉlittle(199u32)
    );
    Result = Append(Result, Encodeˉsection(
        ".rodata.ewvrs", 2u8, 16u32, 1196u32, Store
    ));
    Result = Append(Result, Encodeˉsection(
        ".rodata.fwvds", 2u8, 16u32, 3184u32, Snapshot
    ));
    Result = Append(Result, Encodeˉsection(
        ".rodata.gdirectory", 2u8, 16u32, 3911u32, Directory
    ));
    Result = Append(Result, Encodeˉsection(
        ".rodata.hfilesystem", 2u8, 16u32, 195657u32, Filesystem
    ));
    return Append(Result, Encodeˉsection(
        ".rodata.inetwork", 2u8, 16u32, 242571u32, Network
    ));
}

export fn Buildˉsymbols() -> bytes {
    var Result: bytes = Dataˉsymbol(
        "Windvale_init_resource_user_image", 5u32, 5159u32
    );
    Result = Append(Result, Dataˉsymbol(
        "Windvale_process_client_image", 6u32, 449261u32
    ));
    Result = Append(Result, Dataˉsymbol(
        "Windvale_resource_init_boot", 7u32, 816u32
    ));
    Result = Append(Result, Dataˉsymbol(
        "Windvale_resource_init_budget", 8u32, 4u32
    ));
    Result = Append(Result, Dataˉsymbol(
        "Windvale_resource_init_directory", 10u32, 3184u32
    ));
    Result = Append(Result, Dataˉsymbol(
        "Windvale_resource_init_store", 9u32, 1196u32
    ));
    Result = Append(Result, Dataˉsymbol(
        "Windvale_service_directory_user_image", 11u32, 3911u32
    ));
    Result = Append(Result, Dataˉsymbol(
        "Windvale_service_filesystem_user_image", 12u32, 195657u32
    ));
    Result = Append(Result, Dataˉsymbol(
        "Windvale_service_network_user_image", 13u32, 242571u32
    ));
    Result = Append(Result, Encodeˉsymbol(
        "Windvale_kernel_x64_application_start_syscall_handler",
        2u8, 1u8, 1u32, 0u32, 262u32
    ));
    Result = Append(Result, Encodeˉsymbol(
        "Windvale_kernel_x64_process_enter",
        2u8, 1u8, 0u32, 0u32, 33851u32
    ));
    Result = Append(Result, Encodeˉsymbol(
        "Windvale_kernel_x64_process_exception",
        2u8, 1u8, 0u32, 33856u32, 269u32
    ));
    Result = Append(Result, Encodeˉsymbol(
        "Windvale_kernel_x64_process_filesystem_image",
        2u8, 1u8, 2u32, 0u32, 59u32
    ));
    Result = Append(Result, Encodeˉsymbol(
        "Windvale_kernel_x64_process_filesystem_paging",
        2u8, 1u8, 3u32, 0u32, 3343u32
    ));
    Result = Append(Result, Encodeˉsymbol(
        "Windvale_kernel_x64_process_filesystem_record",
        2u8, 1u8, 4u32, 0u32, 463u32
    ));
    Result = Append(Result, Encodeˉsymbol(
        "Windvale_kernel_x64_process_syscall",
        2u8, 1u8, 0u32, 34128u32, 5495u32
    ));
    Result = Append(Result, Encodeˉsymbol(
        "Windvale_kernel_x64_timer_interrupt",
        2u8, 1u8, 0u32, 39632u32, 7046u32
    ));
    Result = Append(Result, Importˉfunction(
        "Windvale_kernel_allocate_memory_object"
    ));
    Result = Append(Result, Importˉfunction(
        "Windvale_kernel_process_policy"
    ));
    Result = Append(Result, Importˉfunction(
        "Windvale_kernel_release_memory_object"
    ));
    Result = Append(Result, Importˉfunction(
        "Windvale_kernel_x64_application_start_publication"
    ));
    Result = Append(Result, Importˉfunction(
        "Windvale_kernel_x64_application_start_syscall_context"
    ));
    Result = Append(Result, Importˉfunction(
        "Windvale_kernel_x64_exception_terminal"
    ));
    Result = Append(Result, Importˉfunction(
        "Windvale_kernel_x64_page_table_activate"
    ));
    Result = Append(Result, Importˉfunction(
        "Windvale_kernel_x64_process_exception_13_entry"
    ));
    Result = Append(Result, Importˉfunction(
        "Windvale_kernel_x64_process_exception_14_entry"
    ));
    Result = Append(Result, Importˉfunction(
        "Windvale_kernel_x64_process_exception_6_entry"
    ));
    Result = Append(Result, Importˉfunction(
        "Windvale_kernel_x64_process_filesystem_construct"
    ));
    Result = Append(Result, Importˉfunction(
        "Windvale_kernel_x64_timer_arm"
    ));
    Result = Append(Result, Importˉfunction(
        "Windvale_kernel_x64_timer_irq0_entry"
    ));
    Result = Append(Result, Importˉfunction(
        "Windvale_kernel_x64_timer_read_clock"
    ));
    Result = Append(Result, Importˉfunction(
        "Windvale_kernel_x64_timer_rearm"
    ));
    Result = Append(Result, Importˉfunction(
        "Windvale_kernel_x64_timer_resume"
    ));
    return Append(Result, Importˉfunction(
        "Windvale_kernel_x64_timer_stop"
    ));
}
