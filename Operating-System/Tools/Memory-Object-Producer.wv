module Probeˉmemoryˉobjectˉproducer profile hosted;

import Wvoˉobjectˉconstruction as Construction;

capability diagnostic.write_line;
capability file.read_bytes;
capability file.write_bytes;
capability process.argument;
capability process.argument_count;

data Memoryˉselector: bytes = [109, 101, 109, 111, 114, 121];
data Invalidˉopcodeˉselector: bytes = [
    109, 101, 109, 111, 114, 121, 45, 105, 110, 118, 97, 108, 105, 100, 45,
    111, 112, 99, 111, 100, 101
];
data Generalˉprotectionˉselector: bytes = [
    109, 101, 109, 111, 114, 121, 45, 103, 101, 110, 101, 114, 97, 108, 45,
    112, 114, 111, 116, 101, 99, 116, 105, 111, 110
];

fn Bytesˉequal(Left: bytes, Right: bytes) -> bool {
    let Length: u32 = Bytesˉlength(Left);
    if Length != Bytesˉlength(Right) { return false; }
    var Index: u32 = 0u32;
    while Index < Length {
        if Bytesˉreadˉu8(Left, Index) != Bytesˉreadˉu8(Right, Index) {
            return false;
        }
        Index = Index + 1u32;
    }
    return true;
}

fn Buildˉmemoryˉobject(
    Code: bytes,
    Enterˉbytes: u32,
    Allocatorˉoffset: u32
) -> bytes {
    let Section: bytes = Construction.Encodeˉsection(
        ".text", 1u8, 16u32, Bytesˉlength(Code), Code
    );
    var Symbols: bytes = Construction.Encodeˉsymbol(
        "Windvale_kernel_allocate_pages",
        2u8, 1u8, 0u32, Allocatorˉoffset, 257u32
    );
    Symbols = Bytesˉconcat(Symbols, Construction.Encodeˉsymbol(
        "Windvale_kernel_memory_enter",
        2u8, 1u8, 0u32, 0u32, Enterˉbytes
    ));
    Symbols = Bytesˉconcat(Symbols, Construction.Encodeˉsymbol(
        "Windvale_kernel_allocate_memory_object",
        3u8, 1u8, 4294967295u32, 0u32, 0u32
    ));
    Symbols = Bytesˉconcat(Symbols, Construction.Encodeˉsymbol(
        "Windvale_kernel_wva_main",
        3u8, 1u8, 4294967295u32, 0u32, 0u32
    ));
    Symbols = Bytesˉconcat(Symbols, Construction.Encodeˉsymbol(
        "Windvale_kernel_x64_exception_install",
        3u8, 1u8, 4294967295u32, 0u32, 0u32
    ));
    Symbols = Bytesˉconcat(Symbols, Construction.Encodeˉsymbol(
        "Windvale_kernel_x64_paging_install",
        3u8, 1u8, 4294967295u32, 0u32, 0u32
    ));
    var Relocations: bytes = Construction.Encodeˉrelocation(
        2u8, 0u32, 698u32, 0u32, -4
    );
    Relocations = Bytesˉconcat(Relocations, Construction.Encodeˉrelocation(
        2u8, 0u32, 731u32, 4u32, -4
    ));
    Relocations = Bytesˉconcat(Relocations, Construction.Encodeˉrelocation(
        2u8, 0u32, 748u32, 5u32, -4
    ));
    Relocations = Bytesˉconcat(Relocations, Construction.Encodeˉrelocation(
        2u8, 0u32, 766u32, 3u32, -4
    ));
    return Construction.Constructˉobject(
        1u32, 6u32, 4u32, Section, Symbols, Relocations
    );
}

fn Publish(
    Code: bytes,
    Codeˉbytes: u32,
    Enterˉbytes: u32,
    Allocatorˉoffset: u32,
    Objectˉbytes: u32
) -> i32 {
    if Bytesˉlength(Code) != Codeˉbytes {
        diagnostic.write_line("probe memory object status=Rejected");
        return 1;
    }
    let Result: bytes = Buildˉmemoryˉobject(
        Code, Enterˉbytes, Allocatorˉoffset
    );
    if Bytesˉlength(Result) != Objectˉbytes {
        diagnostic.write_line("probe memory object status=Rejected");
        return 1;
    }
    file.write_bytes(process.argument(2u32), Result);
    return 0;
}

export fn Main() -> i32 {
    if process.argument_count() != 3u32 {
        diagnostic.write_line(
            "Usage: probe-memory-object <memory|memory-invalid-opcode|memory-general-protection> <code.bin> <output.wvo>"
        );
        return 64;
    }
    let Selector: bytes = Textˉtoˉutf8(process.argument(0u32));
    let Code: bytes = file.read_bytes(process.argument(1u32));
    if Bytesˉequal(Selector, Memoryˉselector) {
        return Publish(Code, 1089u32, 826u32, 832u32, 1529u32);
    }
    if Bytesˉequal(Selector, Invalidˉopcodeˉselector) {
        return Publish(Code, 1105u32, 834u32, 848u32, 1545u32);
    }
    if Bytesˉequal(Selector, Generalˉprotectionˉselector) {
        return Publish(Code, 1105u32, 844u32, 848u32, 1545u32);
    }
    diagnostic.write_line("probe memory object status=Unsupported");
    return 64;
}
