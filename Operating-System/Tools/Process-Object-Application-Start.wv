fn Equalˉbytes(Left: bytes, Right: bytes) -> bool {
    let Length: u32 = Bytesˉlength(Left);
    if Length != Bytesˉlength(Right) { return false; }
    var Index: u32 = 0u32;
    while Index < Length {
        if Bytesˉreadˉu8(Left, Index) != Bytesˉreadˉu8(Right, Index) {
            return false;
        }
        Index = Index + 1u32;
    }
    return true;
}

export fn Patch(Code: bytes) -> bytes {
    if Bytesˉlength(Code) != 46678u32 ||
        Bytesˉlength(Retainedˉdispatch) != 68u32 ||
        Bytesˉlength(Applicationˉstartˉdispatch) != 68u32 ||
        !Equalˉbytes(
            Bytesˉslice(Code, 34167u32, 68u32), Retainedˉdispatch
        ) {
        return Bytesˉslice(Code, 0u32, 0u32);
    }
    return Bytesˉconcat(
        Bytesˉslice(Code, 0u32, 34167u32),
        Bytesˉconcat(
            Applicationˉstartˉdispatch,
            Bytesˉslice(Code, 34235u32, 12443u32)
        )
    );
}

export fn Handler() -> bytes {
    if Bytesˉlength(Applicationˉstartˉextension) != 9u32 ||
        Bytesˉlength(Applicationˉstartˉhandler) != 183u32 {
        return Bytesˉslice(Applicationˉstartˉhandler, 0u32, 0u32);
    }
    return Bytesˉconcat(
        Applicationˉstartˉextension, Applicationˉstartˉhandler
    );
}
