module Processˉobjectˉtool profile hosted;

import Processˉobjectˉlayout as Layout;
import Processˉobjectˉrelocations as Relocations;

capability diagnostic.write_line;
capability file.read_bytes;
capability file.write_bytes;
capability process.argument;
capability process.argument_count;

enum Toolˉstatus {
    Ready = 0;
    Rejected = 1;
}

fn Buildˉobject(Sections: bytes, Symbols: bytes, Relocationˉbytes: bytes) -> bytes {
    var Header: bytes = Textˉtoˉutf8("WVO1");
    Header = Bytesˉconcat(Header, Bytesˉfromˉu16ˉlittle(1u32));
    Header = Bytesˉconcat(Header, Bytesˉfromˉu16ˉlittle(0u32));
    Header = Bytesˉconcat(Header, Bytesˉfromˉu8(1u8));
    Header = Bytesˉconcat(Header, Bytesˉfromˉu8(0u8));
    Header = Bytesˉconcat(Header, Bytesˉfromˉu16ˉlittle(0u32));
    Header = Bytesˉconcat(Header, Bytesˉfromˉu32ˉlittle(8u32));
    Header = Bytesˉconcat(Header, Bytesˉfromˉu32ˉlittle(25u32));
    Header = Bytesˉconcat(Header, Bytesˉfromˉu32ˉlittle(55u32));
    return Bytesˉconcat(
        Bytesˉconcat(Header, Sections),
        Bytesˉconcat(Symbols, Relocationˉbytes)
    );
}

export fn Main() -> i32 {
    if process.argument_count() != 8u32 {
        diagnostic.write_line(
            "Usage: process-object <code.bin> <init.bin> <client.bin> <program.wvb> <resources.wvrs> <directory.wvds> <directory.bin> <output.wvo>"
        );
        return 64;
    }
    let Code: bytes = file.read_bytes(process.argument(0u32));
    let Init: bytes = file.read_bytes(process.argument(1u32));
    let Client: bytes = file.read_bytes(process.argument(2u32));
    let Program: bytes = file.read_bytes(process.argument(3u32));
    let Store: bytes = file.read_bytes(process.argument(4u32));
    let Snapshot: bytes = file.read_bytes(process.argument(5u32));
    let Directory: bytes = file.read_bytes(process.argument(6u32));
    if Bytesˉlength(Code) != 46678u32 ||
        Bytesˉlength(Init) != 5159u32 ||
        Bytesˉlength(Client) != 449261u32 ||
        Bytesˉlength(Program) != 816u32 ||
        Bytesˉlength(Store) != 1196u32 ||
        Bytesˉlength(Snapshot) != 3184u32 ||
        Bytesˉlength(Directory) != 3911u32 {
        diagnostic.write_line("process object status=Rejected");
        return 1;
    }
    let Sections: bytes = Bytesˉconcat(
        Layout.Buildˉfirstˉsections(Code, Init, Client, Program),
        Layout.Buildˉfinalˉsections(Store, Snapshot, Directory)
    );
    let Symbols: bytes = Layout.Buildˉsymbols();
    let Relocationˉbytes: bytes = Relocations.Buildˉrelocations();
    if Bytesˉlength(Sections) != 510486u32 ||
        Bytesˉlength(Symbols) != 1368u32 ||
        Bytesˉlength(Relocationˉbytes) != 1100u32 {
        diagnostic.write_line("process object status=Rejected");
        return 1;
    }
    let Result: bytes = Buildˉobject(Sections, Symbols, Relocationˉbytes);
    if Bytesˉlength(Result) != 512978u32 {
        diagnostic.write_line("process object status=Rejected");
        return 1;
    }
    file.write_bytes(process.argument(7u32), Result);
    return 0;
}
