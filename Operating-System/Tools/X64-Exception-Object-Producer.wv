module X64ˉexceptionˉobjectˉproducer profile hosted;

import Wvoˉobjectˉconstruction as Construction;

capability diagnostic.write_line;
capability file.write_bytes;
capability process.argument;
capability process.argument_count;

data Installerˉbeforeˉinvalidˉopcode: bytes = [
    87, 72, 133, 201, 15, 132, 205, 0, 0, 0, 72, 247, 193, 255, 15, 0,
    0, 15, 133, 192, 0, 0, 0, 73, 137, 200, 72, 137, 207, 49, 192, 185,
    0, 2, 0, 0, 252, 243, 72, 171, 49, 192, 140, 200, 133, 192, 15, 132,
    163, 0, 0, 0, 168, 3, 15, 133, 155, 0, 0, 0, 72, 141, 21
];
data Installerˉbetweenˉentries: bytes = [
    102, 65, 137, 80, 96, 102, 65, 137, 64, 98, 65, 198, 64, 100, 0, 65,
    198, 64, 101, 142, 72, 193, 234, 16, 102, 65, 137, 80, 102, 72, 193, 234,
    16, 65, 137, 80, 104, 65, 199, 64, 108, 0, 0, 0, 0, 72, 141, 21
];
data Installerˉafterˉgeneralˉprotection: bytes = [
    102, 65, 137, 144, 208, 0, 0, 0, 102, 65, 137, 128, 210, 0, 0, 0,
    65, 198, 128, 212, 0, 0, 0, 0, 65, 198, 128, 213, 0, 0, 0, 142,
    72, 193, 234, 16, 102, 65, 137, 144, 214, 0, 0, 0, 72, 193, 234, 16,
    65, 137, 144, 216, 0, 0, 0, 65, 199, 128, 220, 0, 0, 0, 0, 0,
    0, 0, 102, 65, 199, 128, 224, 0, 0, 0, 223, 0, 77, 137, 128, 226,
    0, 0, 0, 250, 65, 15, 1, 152, 224, 0, 0, 0, 49, 192, 95, 195,
    184, 1, 0, 0, 0, 95, 195
];
fn Buildˉcode() -> bytes {
    let Emptyˉpatch: bytes = Bytesˉfromˉu32ˉlittle(0u32);
    return Bytesˉconcat(
        Bytesˉconcat(
            Bytesˉconcat(Installerˉbeforeˉinvalidˉopcode, Emptyˉpatch),
            Installerˉbetweenˉentries
        ),
        Bytesˉconcat(Emptyˉpatch, Installerˉafterˉgeneralˉprotection)
    );
}

fn Buildˉobject() -> bytes {
    let Code: bytes = Buildˉcode();
    let Section: bytes = Construction.Encodeˉsection(
        ".text", 1u8, 16u32, Bytesˉlength(Code), Code
    );
    var Symbols: bytes = Construction.Encodeˉsymbol(
        "Windvale_kernel_x64_exception_install",
        2u8, 1u8, 0u32, 0u32, Bytesˉlength(Code)
    );
    Symbols = Bytesˉconcat(Symbols, Construction.Encodeˉsymbol(
        "Windvale_kernel_x64_exception_13_entry",
        3u8, 1u8, 4294967295u32, 0u32, 0u32
    ));
    Symbols = Bytesˉconcat(Symbols, Construction.Encodeˉsymbol(
        "Windvale_kernel_x64_exception_6_entry",
        3u8, 1u8, 4294967295u32, 0u32, 0u32
    ));
    var Relocations: bytes = Construction.Encodeˉrelocation(
        2u8, 0u32, 63u32, 2u32, -4
    );
    Relocations = Bytesˉconcat(Relocations, Construction.Encodeˉrelocation(
        2u8, 0u32, 115u32, 1u32, -4
    ));
    return Construction.Constructˉobject(
        1u32, 3u32, 2u32, Section, Symbols, Relocations
    );
}

export fn Main() -> i32 {
    if process.argument_count() != 1u32 {
        diagnostic.write_line("Usage: x64-exception-object <output.wvo>");
        return 64;
    }
    let Result: bytes = Buildˉobject();
    if Bytesˉlength(Result) != 483u32 {
        diagnostic.write_line("exception object status=Rejected");
        return 1;
    }
    file.write_bytes(process.argument(0u32), Result);
    return 0;
}
