data Admissionˉcode: bytes = [
    72, 131, 236, 120, 72, 137, 12, 36, 72, 184, 7, 0, 0, 0, 112, 0,
    0, 0, 72, 137, 68, 36, 8, 184, 80, 155, 0, 0, 72, 137, 68, 36,
    16, 184, 2, 0, 0, 0, 72, 137, 68, 36, 24, 49, 192, 72, 137, 68,
