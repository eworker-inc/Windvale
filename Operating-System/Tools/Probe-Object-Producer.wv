];

fn Bytesˉequal(Left: bytes, Right: bytes) -> bool {
    let Length: u32 = Bytesˉlength(Left);
    if Length != Bytesˉlength(Right) { return false; }
    var Index: u32 = 0u32;
    while Index < Length {
        if Bytesˉreadˉu8(Left, Index) != Bytesˉreadˉu8(Right, Index) {
            return false;
        }
        Index = Index + 1u32;
    }
    return true;
}

fn Buildˉexceptionˉobject() -> bytes {
    let Emptyˉpatch: bytes = Bytesˉfromˉu32ˉlittle(0u32);
    let Code: bytes = Bytesˉconcat(
        Bytesˉconcat(
            Bytesˉconcat(Exceptionˉbeforeˉinvalidˉopcode, Emptyˉpatch),
            Exceptionˉbetweenˉentries
        ),
        Bytesˉconcat(Emptyˉpatch, Exceptionˉafterˉgeneralˉprotection)
    );
    let Section: bytes = Construction.Encodeˉsection(
        ".text", 1u8, 16u32, Bytesˉlength(Code), Code
    );
    var Symbols: bytes = Construction.Encodeˉsymbol(
        "Windvale_kernel_x64_exception_install",
        2u8, 1u8, 0u32, 0u32, Bytesˉlength(Code)
    );
    Symbols = Bytesˉconcat(Symbols, Construction.Encodeˉsymbol(
        "Windvale_kernel_x64_exception_13_entry",
        3u8, 1u8, 4294967295u32, 0u32, 0u32
    ));
    Symbols = Bytesˉconcat(Symbols, Construction.Encodeˉsymbol(
        "Windvale_kernel_x64_exception_6_entry",
        3u8, 1u8, 4294967295u32, 0u32, 0u32
    ));
    var Relocations: bytes = Construction.Encodeˉrelocation(
        2u8, 0u32, 63u32, 2u32, -4
    );
    Relocations = Bytesˉconcat(Relocations, Construction.Encodeˉrelocation(
        2u8, 0u32, 115u32, 1u32, -4
    ));
    return Construction.Constructˉobject(
        1u32, 3u32, 2u32, Section, Symbols, Relocations
    );
}

fn Buildˉadmissionˉbridgeˉobject() -> bytes {
    let Section: bytes = Construction.Encodeˉsection(
        ".text.admission", 1u8, 16u32,
        Bytesˉlength(Admissionˉcode), Admissionˉcode
    );
    var Symbols: bytes = Construction.Encodeˉsymbol(
        "Windvale_kernel_x64_wvb_admission",
        2u8, 1u8, 0u32, 0u32, Bytesˉlength(Admissionˉcode)
    );
    Symbols = Bytesˉconcat(Symbols, Construction.Encodeˉsymbol(
        "Windvale_kernel_wvb_admit",
        3u8, 1u8, 4294967295u32, 0u32, 0u32
    ));
    Symbols = Bytesˉconcat(Symbols, Construction.Encodeˉsymbol(
        "Windvale_kernel_x64_native_probe",
        3u8, 1u8, 4294967295u32, 0u32, 0u32
    ));
    Symbols = Bytesˉconcat(Symbols, Construction.Encodeˉsymbol(
        "Windvale_kernel_x64_process_enter",
        3u8, 1u8, 4294967295u32, 0u32, 0u32
    ));
    var Relocations: bytes = Construction.Encodeˉrelocation(
        2u8, 0u32, 106u32, 1u32, -4
    );
    Relocations = Bytesˉconcat(Relocations, Construction.Encodeˉrelocation(
        2u8, 0u32, 125u32, 3u32, -4
    ));
    Relocations = Bytesˉconcat(Relocations, Construction.Encodeˉrelocation(
        2u8, 0u32, 148u32, 2u32, -4
    ));
    return Construction.Constructˉobject(
        1u32, 4u32, 3u32, Section, Symbols, Relocations
    );
}

fn Buildˉnativeˉbridgeˉobject() -> bytes {
    var Sections: bytes = Construction.Encodeˉsection(
        ".text.native", 1u8, 16u32,
        Bytesˉlength(Nativeˉbridgeˉcode), Nativeˉbridgeˉcode
    );
    Sections = Bytesˉconcat(Sections, Construction.Encodeˉsection(
        ".text.support", 1u8, 16u32,
        Bytesˉlength(Writeˉbyteˉcode), Writeˉbyteˉcode
    ));
    var Symbols: bytes = Construction.Encodeˉsymbol(
        "Windvale_kernel_x64_native_probe",
        2u8, 1u8, 0u32, 0u32, Bytesˉlength(Nativeˉbridgeˉcode)
    );
    Symbols = Bytesˉconcat(Symbols, Construction.Encodeˉsymbol(
        "Windvale_kernel_x64_write_byte",
        2u8, 1u8, 1u32, 0u32, Bytesˉlength(Writeˉbyteˉcode)
    ));
    Symbols = Bytesˉconcat(Symbols, Construction.Encodeˉsymbol(
        "Main", 3u8, 1u8, 4294967295u32, 0u32, 0u32
    ));
    Symbols = Bytesˉconcat(Symbols, Construction.Encodeˉsymbol(
        "Windvale_kernel_main",
        3u8, 1u8, 4294967295u32, 0u32, 0u32
    ));
    var Relocations: bytes = Construction.Encodeˉrelocation(
        2u8, 0u32, 106u32, 2u32, -4
    );
    Relocations = Bytesˉconcat(Relocations, Construction.Encodeˉrelocation(
        2u8, 0u32, 129u32, 3u32, -4
    ));
    return Construction.Constructˉobject(
        2u32, 4u32, 2u32, Sections, Symbols, Relocations
    );
}

export fn Main() -> i32 {
    if process.argument_count() != 2u32 {
        diagnostic.write_line("Usage: probe-object <kind> <output.wvo>");
        return 64;
    }
    let Selector: bytes = Textˉtoˉutf8(process.argument(0u32));
    var Result: bytes = Bytesˉslice(Selector, 0u32, 0u32);
    var Expectedˉlength: u32 = 0u32;
    if Bytesˉequal(Selector, Exceptionsˉselector) {
        Result = Buildˉexceptionˉobject();
        Expectedˉlength = 483u32;
    } else {
        if Bytesˉequal(Selector, Admissionˉselector) {
            Result = Buildˉadmissionˉbridgeˉobject();
            Expectedˉlength = 484u32;
        } else {
            if !Bytesˉequal(Selector, Nativeˉbridgeˉselector) {
                diagnostic.write_line("probe object status=Unsupported");
                return 64;
            }
            Result = Buildˉnativeˉbridgeˉobject();
            Expectedˉlength = 461u32;
        }
    }
    if Bytesˉlength(Result) != Expectedˉlength {
        diagnostic.write_line("probe object status=Rejected");
        return 1;
    }
    file.write_bytes(process.argument(1u32), Result);
    return 0;
}
