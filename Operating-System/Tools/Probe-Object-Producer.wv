data Admissionˉselector: bytes = [119, 118, 98, 45, 97, 100, 109, 105, 115, 115, 105, 111, 110, 45, 98, 114, 105, 100, 103, 101];
data Nativeˉbridgeˉselector: bytes = [110, 97, 116, 105, 118, 101, 45, 98, 114, 105, 100, 103, 101, 45, 97, 110, 100, 45, 115, 117, 112, 112, 111, 114, 116];

