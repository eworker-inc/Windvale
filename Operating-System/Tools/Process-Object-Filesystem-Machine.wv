module Processˉobjectˉfilesystemˉmachine profile portable;

import X64ˉprocessˉfilesystemˉimageˉemission as Imageˉemission;
import X64ˉprocessˉfilesystemˉpagingˉemission as Pagingˉemission;
import X64ˉprocessˉfilesystemˉrecordˉemission as Recordˉemission;

data Serviceˉdigest: bytes = [
    87, 247, 158, 40, 58, 51, 199, 232,
    116, 118, 26, 156, 55, 19, 174, 117,
    55, 54, 115, 29, 108, 191, 71, 124,
    144, 253, 124, 170, 194, 49, 200, 214
];

data Launchˉconfigurationˉdigest: bytes = [
    14, 52, 164, 109, 213, 104, 253, 249,
    127, 183, 44, 0, 93, 17, 188, 98,
    110, 156, 41, 80, 183, 6, 254, 199,
    60, 177, 102, 82, 28, 207, 236, 244
];

data Return: bytes = [195];

export fn Isˉvalid() -> bool {
    return Recordˉemission.X64ˉprocessˉfilesystemˉrecordˉisˉvalid(
        Serviceˉdigest, Launchˉconfigurationˉdigest
    ) && Pagingˉemission.X64ˉprocessˉfilesystemˉpagingˉisˉvalid() &&
        Imageˉemission.X64ˉprocessˉfilesystemˉimageˉisˉvalid(195657u32);
}

export fn Image() -> bytes {
    return Bytesˉconcat(
        Imageˉemission.X64ˉprocessˉfilesystemˉimageˉbytes(195657u32),
        Return
    );
}

export fn Paging() -> bytes {
    return Bytesˉconcat(
        Pagingˉemission.X64ˉprocessˉfilesystemˉpagingˉbytes(), Return
    );
}

export fn Record() -> bytes {
    return Bytesˉconcat(
        Recordˉemission.X64ˉprocessˉfilesystemˉrecordˉbytes(
            Serviceˉdigest, Launchˉconfigurationˉdigest
        ),
        Return
    );
}
