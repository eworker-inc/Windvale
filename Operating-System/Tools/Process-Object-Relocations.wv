module Processˉobjectˉrelocations profile portable;

fn Encodeˉrelocation(Section: u32, Offset: u32, Symbol: u32) -> bytes {
    var Result: bytes = Bytesˉfromˉu8(2u8);
    Result = Bytesˉconcat(Result, Bytesˉfromˉu8(0u8));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu16ˉlittle(0u32));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Section));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Offset));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Symbol));
    return Bytesˉconcat(Result, Bytesˉfromˉi32ˉlittle(-4));
}

fn Encodeˉrelocationˉaddend(
    Section: u32, Offset: u32, Symbol: u32, Addend: i32
) -> bytes {
    var Result: bytes = Bytesˉfromˉu8(2u8);
    Result = Bytesˉconcat(Result, Bytesˉfromˉu8(0u8));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu16ˉlittle(0u32));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Section));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Offset));
    Result = Bytesˉconcat(Result, Bytesˉfromˉu32ˉlittle(Symbol));
    return Bytesˉconcat(Result, Bytesˉfromˉi32ˉlittle(Addend));
}

fn Add(Result: bytes, Offset: u32, Symbol: u32) -> bytes {
    return Bytesˉconcat(Result, Encodeˉrelocation(0u32, Offset, Symbol));
}

