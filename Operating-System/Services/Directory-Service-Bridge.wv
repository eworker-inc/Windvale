module Directoryˉserviceˉbridge profile hosted;

import Directoryˉservice;

capability file.read_bytes;
capability filesystem.directory_read_v1;

data Requestˉname: text = "ipc:directory-read.wvdq";

export fn Main() -> bytes {
    let Requestˉbytes: bytes = file.read_bytes(Requestˉname);
    let Request: Directoryˉserviceˉrequest =
        Directoryˉserviceˉparseˉrequest(Requestˉbytes);
    if !Directoryˉserviceˉshouldˉinvokeˉprovider(Request) {
        return Directoryˉserviceˉhandleˉresponse(
            Requestˉbytes,
            Directoryˉserviceˉempty(Requestˉbytes)
        );
    }
    let Providerˉresponse: bytes = filesystem.directory_read_v1(
        Request.Name,
        Request.Offset,
        Request.Maximumˉbytes
    );
    return Directoryˉserviceˉhandleˉresponse(Requestˉbytes, Providerˉresponse);
}
