module Directoryˉserviceˉbridge profile hosted;

import Directoryˉservice as Directoryˉservice;

capability file.read_bytes;
capability filesystem.directory_read_v1;

data Requestˉname: text = "ipc:directory-read.wvdq";

export fn Main() -> bytes {
    let Requestˉbytes: bytes = file.read_bytes(Requestˉname);
    let Request: Directoryˉservice.Directoryˉserviceˉrequest =
        Directoryˉservice.Directoryˉserviceˉparseˉrequest(Requestˉbytes);
    if !Directoryˉservice.Directoryˉserviceˉshouldˉinvokeˉprovider(Request) {
        return Directoryˉservice.Directoryˉserviceˉhandleˉresponse(
            Requestˉbytes,
            Directoryˉservice.Directoryˉserviceˉempty(Requestˉbytes)
        );
    }
    let Providerˉresponse: bytes = filesystem.directory_read_v1(
        Request.Name,
        Request.Offset,
        Request.Maximumˉbytes
    );
    return Directoryˉservice.Directoryˉserviceˉhandleˉresponse(Requestˉbytes, Providerˉresponse);
}
