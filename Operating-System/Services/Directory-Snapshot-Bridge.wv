module Directoryˉsnapshotˉbridge profile hosted;

import Directoryˉsnapshotˉservice;

capability file.read_bytes;

data Snapshotˉname: text = "boot:directory.wvds";
data Requestˉname: text = "ipc:directory-read.wvdq";

export fn Main() -> bytes {
    let Snapshot: bytes = file.read_bytes(Snapshotˉname);
    let Request: bytes = file.read_bytes(Requestˉname);
    return Directoryˉsnapshotˉserviceˉhandle(Snapshot, Request);
}
