module Directoryˉsnapshotˉservice profile portable;

import Directoryˉservice as Directoryˉservice;
import Directoryˉsnapshot as Directoryˉsnapshot;

export fn Directoryˉsnapshotˉserviceˉhandle(
    Snapshot: bytes,
    Requestˉbytes: bytes
) -> bytes {
    let Request: Directoryˉservice.Directoryˉserviceˉrequest =
        Directoryˉservice.Directoryˉserviceˉparseˉrequest(Requestˉbytes);
    if Request.Status != Directoryˉservice.Directoryˉserviceˉrequestˉstatus.Valid {
        return Directoryˉservice.Directoryˉserviceˉhandleˉresponse(
            Requestˉbytes,
            Directoryˉservice.Directoryˉserviceˉempty(Requestˉbytes)
        );
    }
    let Providerˉresponse: bytes = Directoryˉsnapshot.Directoryˉsnapshotˉread(
        Snapshot,
        Request.Name,
        Request.Offset,
        Request.Maximumˉbytes
    );
    return Directoryˉservice.Directoryˉserviceˉhandleˉresponse(Requestˉbytes, Providerˉresponse);
}
