module Directoryˉsnapshotˉservice profile portable;

import Directoryˉservice;
import Directoryˉsnapshot;

export fn Directoryˉsnapshotˉserviceˉhandle(
    Snapshot: bytes,
    Requestˉbytes: bytes
) -> bytes {
    let Request: Directoryˉserviceˉrequest =
        Directoryˉserviceˉparseˉrequest(Requestˉbytes);
    if Request.Status != Directoryˉserviceˉrequestˉstatus.Valid {
        return Directoryˉserviceˉhandleˉresponse(
            Requestˉbytes,
            Directoryˉserviceˉempty(Requestˉbytes)
        );
    }
    let Providerˉresponse: bytes = Directoryˉsnapshotˉread(
        Snapshot,
        Request.Name,
        Request.Offset,
        Request.Maximumˉbytes
    );
    return Directoryˉserviceˉhandleˉresponse(Requestˉbytes, Providerˉresponse);
}
