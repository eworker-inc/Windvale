windvale-assembly 1

# ABI-16 file.read_bytes leaf for the single immutable Windvale OS boot
# resource. R8/R9D carry the opaque name, RCX the verified result descriptor,
# and R15 the native execution context. The OS-private table is reached through
# context offset 96. This leaf preserves R10, R11, and R15.
