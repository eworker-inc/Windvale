                    let Loadˉindex: u32 = Bytesˉreadˉu32ˉlittle(Input, Cursor + 1u32);
                    if Loadˉindex >= 19u32 { return Executionˉresult(-24, 0, Remainingˉbudget); }
                    var Loaded: i32 = 0;
                    if Loadˉindex < 10u32 {
