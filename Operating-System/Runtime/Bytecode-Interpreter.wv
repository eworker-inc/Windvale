                                                    if Stackˉdepth != 1u32 {
                                                        return Executionˉresult(-38, 0, Remainingˉbudget);
                                                    }
                                                    Called = Executeˉselect(Input, Stackˉzero, Remainingˉbudget);
                                                }
                                            }
                                            if Called.Status != 0 { return Called; }
                                            Remainingˉbudget = Called.Remainingˉbudget;
                                            Stackˉzero = Called.Value;
                                            Stackˉdepth = 1u32;
                                            Cursor = Cursor + 5u32;
                                        } else {
                                            if Operation != 81u8 { return Executionˉresult(-40, 0, Remainingˉbudget); }
                                            if Stackˉdepth != 1u32 { return Executionˉresult(-31, 0, Remainingˉbudget); }
                                            return Executionˉresult(0, Stackˉzero, Remainingˉbudget);
                                        }
                                    }
                                }
                            }
                        }
                    }
                } }
            } }
        }
    }
    return Executionˉresult(-41, 0, Remainingˉbudget);
}

export fn Main() -> i32 {
    let Admittedˉmodule: bytes = file.read_bytes(Runtimeˉinputˉname);
    let Budgetˉbytes: bytes = file.read_bytes(Runtimeˉbudgetˉname);
    if Bytesˉlength(Budgetˉbytes) != 4u32 { return -16; }
    let Executionˉbudget: u32 = Bytesˉreadˉu32ˉlittle(Budgetˉbytes, 0u32);
    if Executionˉbudget == 0u32 { return -17; }
    if Executionˉbudget > 256u32 { return -17; }
    var Status: i32 = Validateˉenvelope(Admittedˉmodule);
    if Status != 0 { return Status; }
    Status = Validateˉmodule(Admittedˉmodule);
    if Status != 0 { return Status; }
    Status = Validateˉemptyˉsection(Admittedˉmodule, 1u32, -11);
    if Status != 0 { return Status; }
    Status = Validateˉemptyˉsection(Admittedˉmodule, 2u32, -12);
    if Status != 0 { return Status; }
    Status = Validateˉfunctions(Admittedˉmodule);
    if Status != 0 { return Status; }
    Status = Validateˉexport(Admittedˉmodule);
    if Status != 0 { return Status; }
    Status = Validateˉemptyˉsection(Admittedˉmodule, 6u32, -18);
    if Status != 0 { return Status; }
    var Functionˉindex: u32 = 0u32;
    while Functionˉindex < 4u32 {
        Status = Validateˉcode(Admittedˉmodule, Functionˉindex);
        if Status != 0 { return Status; }
        Functionˉindex = Functionˉindex + 1u32;
    }
    let Result: Executionˉresult = Executeˉmain(Admittedˉmodule, Executionˉbudget);
    if Result.Status != 0 { return Result.Status; }
    return Result.Value;
}
