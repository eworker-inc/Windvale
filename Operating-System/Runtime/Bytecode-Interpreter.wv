                                        else { if Condition == 1 { Cursor = Cursor + 5u32; }
                                        else { return Executionˉresult(-36, 0, Remainingˉbudget); } }
                                    } else {
                                        if Operation == 64u8 {
                                            let Targetˉfunction: u32 = Bytesˉreadˉu32ˉlittle(Input, Cursor + 1u32);
                                            var Called: Executionˉresult = Executionˉresult(-38, 0, Remainingˉbudget);
                                            if Targetˉfunction == 0u32 {
                                                if Stackˉdepth != 2u32 { return Executionˉresult(-31, 0, Remainingˉbudget); }
                                                Called = Executeˉadd(Input, Stackˉzero, Stackˉone, Remainingˉbudget);
                                            } else {
                                                if Targetˉfunction == 2u32 {
